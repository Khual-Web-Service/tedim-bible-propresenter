<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EXO" style="id">Sunglat</book>
  <para style="h">Sunglat</para>
  <para style="toc1">Sunglat</para>
  <para style="toc2">Sunglat</para>
  <para style="mt">Sunglat</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />He rhoek he Egypt la aka kun Israel ca a ming ni. Te vaengah Jakob neh a imkhui kah hlang neh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Reuben, Simeon, Levi neh Judah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Issakhar, Zebulun neh Benjamin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Dan, Naphtali, Gad neh Asher te ha pawk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Jacob hlit lamkah aka thoeng hinglu boeih he hinglu sawmrhih lo coeng tih Joseph khaw Egypt ah om coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Joseph neh a manuca boeih neh te kah cadilcahma tah boeih duek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Israel ca rhoek tah pungtai uh tih luem uh , ping uh tih yet uh. Te dongah amih te khohmuen ah mawk mawk bae uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Egypt ah manghai a thai phoe tih te long te Joseph ming pawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah a pilnam te, 'Pilnam he, Israel ca rhoek he mamih lakah muep pilnu coeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih te cueih pae pawn sih ping aih ve. Caemtloek ha thoeng tih anih neh koei uh koinih mamih m'hmuhuet ni. Te vaengah mamih m'vathoh thil vetih khohmuen lamloh cet hae ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah amih bitloh neh phaep sak ham saldong mangpa a khueh thil uh. Te vaengah Pharaoh kah rhuengim khopuei la Pithom neh Raamses te a thoh pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih a phaep uh vanbangla ping van tih pungtai van. Te dongah Israel ca rhoek kah mikhmuh ah a mueipuel uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Egypt loh Israel ca rhoek te mangkhak la a thohtat sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih kah hingnah te amlai dong neh laiboeng dongah thohtatnah nen khaw, lohma kah thohtatnah cungkuem nen khaw, mat a phaep uh. Amih kah thohtatnah cungkuem dongah Israel ca te mangkhak la a thohtat sakuh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Egypt manghai loh Hebrew ca-om rhoi, a ming la pakhat ah Shiphrah neh a pabae ah a ming la Puah te a uen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah, “Hebrew nu te na om sak vaengah a omnah te so rhoi. tongpa atah ngawn rhoi lamtah huta atah hing saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae ca-om rhoi loh Pathen te a rhih rhoi. Te dongah Egypt manghai loh amih rhoi taengkah a thui bangla saii rhoi pawt tih camoe te a hing sak rhoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Egypt manghai loh ca-om rhoek te a khue tih amamih taengah, “Balae tih he kah hno he na saii uh tih camoe na hing sak uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah ca-om rhoek loh Pharaoh te, “Hebrew nu he Egypt nu bang moenih. Amih tah rhaang uh tih amih taengla ca-om a pawk hlan ah khaw om uh coeng, ” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Pathen loh ca-om rhoek te a voelphoeng sak tih pilnam a ping dongah muep rhoeng uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ca-om rhoek loh Pathen te a rhih uh dongah amih ham im khaw a thoh pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Pharaoh loh a pilnam boeih te a uen tih, “tongpa la aka thaang boeih tah sokko la voei uh kuekluek lamtah huta tah boeih hing sak uh,” a ti nah.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah Levi imkhui lamkah tongpa pakhat te cet tih Levi nu te a loh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A yuu te vawn tih capa a cun hatah anih te a then la a sawt tih hla thum a thuh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih te koep thuh ham a coeng pawt vaengah tah anih ham talik lawng a loh pah tih lungpaat kunhnai neh a hluk. Te phoeiah a khuiah camoe te a khueh tih sokko tuikaeng kah carhaek ding ah a khueh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih taengah metla a om khaw ming hamla a ngannu loh a hla lamkah a pai thil.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Pharaoh canu te tui hlu la sokko ah cet tih a hula puei neh sokko lihmoi ah pongpa uh. Tedae carhaek ding kah lawng te a hmuh vaengah a salnu te a tueih tih a loh pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A ong vaengah camoe te a hmuh tih camoe khaw tarha ana rhap. Te dongah anih ham a thinphat tih, “Hebrew camoe la he,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah a ngannu loh Pharaoh canu te, “Ka cet vetih nang ham Hebrew nu te, cakhoem la ka khue eh. Te daengah ni nang ham camoe hang khoem eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih te Pharaoh canu loh , “Cet saw,” a ti nah dongah hula te cet tih camoe manu te a khue pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pharaoh canu loh anih te, “Camoe he caeh puei lamtah kai ham han cun, kamah loh na thapang kam paek bitni,” a ti nah. Te dongah manu loh camoe te a khuen tih a cun.
  </para>
  <para style="p">
    <verse number="10" style="v" />Camoe te a pantai phoeiah Pharaoh canu taengla a khuen. Te vaengah a capa la om tih a ming te Moses a sui tih, “Anih he tui dong lamlong ni ka doek,” a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />A khohnin loh a pha tih Moses khaw pantai coeng. Te dongah a manuca rhoek taengla pawk tih amih kah bitloh te a hmuh. Te vaengah a manuca Hebrew hlang mai Egypt hlang loh a ngawn pah te a hmuh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae heben hebang la a mael akhaw hlang te hmu pawh. Te dongah Egypt te a ngawn tih laivin khuiah a up.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hnin bae dongkah a mop vaengah tah Hebrew hlang rhoi te tarha ana hnuei uh rhoi. Te dongah aka halang te, “Balae tih na hui na ngawn?” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah, “Hlang khaw, Kaimih sokah mangpa neh laitloek la ulong nang ng'khueh, Egypt na ngawn bangla kai ngawn ham na cai nama?” a ti nah. Te dongah Moses loh a rhih coeng tih, “Dumlai khaw phoe taktak coeng,” a ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te ol te Pharaoh loh a yaak vaengah Moses te ngawn ham a mae. Tedae Moses tah Pharaoh mikhmuh lamloh yong tih Midian khohmuen ah kho a sak. Te vaengah tuito ah ngol hatah,
  </para>
  <para style="p">
    <verse number="16" style="v" />Midian khosoih kah a canu parhih te ha pawk uh tih tui a dueh uh. Te phoeiah a napa kah boiva te tul ham tuisoi dongah a loei uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah boiva aka dawn rhoek te ha pawk uh tih huta rhoek te a haek uh. Tedae Moses te thoo tih huta rhoek a rhun tih a boiva te tui a tul pah.
  </para>
  <para style="p">
    <verse number="18" style="v" />A napa Reuel taengla a pawk uh vaengah, “Tihnin ah tah balae tih yue na pawk uh ,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah, “Egypt hlang loh kaimih he boiva aka dawn rhoek kut lamloh n'huul. Te phoeiah tui pataeng kaimih ham han dueh han dueh tih boiva te a tul,” a ti nauh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah a ca rhoek te, “Melae anih? Balae tih hlang te na hnoo uh? Anih te khue uh lamtah buh ca dae saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlang neh khosak ham khaw Moses loh a ueh van coeng dongah a canu Zipporah te Moses taengah a paek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah capa a cun pah hatah kholong kho ah yinlai la ka om a ti tih a ming te Gershom a sui.
  </para>
  <para style="p">
    <verse number="23" style="v" />A tue muep a khum phoeiah tah Egypt manghai khaw duek. Te vaengah Israel ca rhoek te thohtatnah khui lamloh huei uh tih pang uh. Thohtatnah lamloh a pang uh te Pathen taengla cet.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae Pathen loh amih kah nguekcoinah te a yaak tih Abraham taengkah, Isaak taengkah, Jakob taengkah a paipi te Pathen loh a poek.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Pathen loh Israel ca rhoek te a hmuh tih amih te Pathen loh a ming.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses tah a masae, Midian khosoih Jethro kah boiva aka luem puei la om. Te vaengah boiva te khosoek hael la a hmaithawn hatah Pathen kah tlang Horeb la pawk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah BOEIPA kah puencawn te anih taengah tangpuem khui lamkah hmairhong hmai neh a phoe pah. A sawt vaengah tangpuem te hmai loh a dom dae tangpuem te tlum pawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Moses loh , “Ka nong vetih a hmuethma tanglue he ka hmu lah eh. Balae tih tangpuem ke a ung pawh,” a ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmuh hamla a nong te BOEIPA loh a hmuh. Te dongah Pathen loh anih te tangpuem khui lamkah a khue tih, “Moses, Moses,” a ti nah hatah, “Kai ni he ue ,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah, “Hela ha mop boeh. Na khokhom te na kho dong lamloh dul dae, a soah na pai thil hmuen he hmuencim khohmuen ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah, “Kai tah na pa Pathen, Abraham Pathen, Isaak Pathen neh Jakob kah Pathen ni,” a ti nah. Te vaengah Moses loh a maelhmai a thuh tih Pathen te paelki ham khaw a rhih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah BOEIPA loh , “Egypt ah ka pilnam kah phacipphabaem te ka hmuh rhoe ka hmuh coeng tih anih aka tueihno mikhmuh kah a pangngawlnah te ka yaak. Te phoeiah a nganboh te ka ming coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Egypt kut lamloh anih huul ham neh te khohmuen lamloh khohmuen then neh hubung khuila, suktui neh khoitui aka long khohmuen la, Kanaan neh Khitti, Amori neh Perizzi, Khivee neh Jebusi hmuen la thak ham ka suntla coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel ca rhoek pangngawlnah loh kai taengla ha pawk coeng tih amih aka nen Egypt kah nennah khaw ka hmuh coeng he.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pharaoh taengla nang kan tueih coeng dongah cet lamtah ka pilnam Israel ca rhoek te Egypt lamloh khuen laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Moses loh Pathen te, “Pharaoh taengla ka caeh ham neh Egypt lamloh Israel ca rhoek khuen ham khaw kai tah unim?” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah, “Nang taengah rhep ka om vetih he he nang ham miknoek coeng ni. Kai loh nang kan tueih coeng tih pilnam te Egypt lamloh na khuen vaengah he tlang ah Pathen te thothueng thil uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Moses loh Pathen taengah, “Israel ca rhoek taengla ka pawk tih amih te, 'Na pa rhoek kah Pathen loh nangmih taengla kai n'tueih,’ ka ti nah vaengah kai te, 'A ming ta?' ti uh koinih amih taengah balae ka thui eh? ' a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathen loh Moses taengah, “Ka om bangla ka om coeng,” a ti nah. Te phoeiah, “He Israel ca rhoek te, 'Aka om long ni nangmih taengla kai n'tueih,’ ti nah,” a ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Pathen loh Moses te, “He he Israel ca rhoek taengah, 'Na pa rhoek kah Pathen, Abraham kah Pathen, Isaak Pathen, Jakob Pathen BOEIPA loh kai he nangmih taengla n'tueih,’ ti nah. He tah kumhal kah kai ming ham neh Cadilcahma kah cadilcahma taengah kai poekkoepnah ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cet lamtah Israel kah patong rhoek te coi laeh. Te phoeiah amih te, “Na pa rhoek kah Pathen BOEIPA te kai taengah phoe coeng. Abraham, Isaak neh Jakob kah Pathen loh , 'Nangmih neh nangmih taengah Egypt kah a saii te ka hip rhoe ka hip coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah ni nangmih te Egypt kah phacipphabaem lamloh Kanaan neh Khitti, Amori neh Perizzi, Khivee neh Jebusi khohmuen la, suktui neh khoitui aka long khohmuen la kang khuen eh ka ti coeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah na ol te a hnatun uh bitni. Namah neh Israel kah a hamca rhoek te Egypt manghai taengla cet uh. Te phoeiah anih te, 'Hebrew kah Pathen BOEIPA loh kaimih he m'mah coeng. Te dongah hnin thum long caeh kah khosoek ah BOEIPA ka Pathen te ka nawn mai pawn eh?,’ ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae a tlungluen kut nen pawt atah na caeh ham khaw Egypt manghai loh nangmih m'pae mahpawh tila ka ming.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah ka kut he ka hlah vetih Egypt te ka ngawn ni. Kamah kah khobaerhambae cungkuem neh a khui ah ka saii daengah ni nangmih te n'tueih pueng eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pilnam he Egypt mikhmuh ah mikdaithen la ka khueh vetih na caeh uh vaengah khaw kuttling la na cet uh mahpawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah huta loh a imben taeng neh a im kah aka bakuep taengah ngun hnopai neh sui hnopai khaw, himbai khaw hoe saeh. Te phoeiah tah na capa rhoek so neh na canu rhoek pum dongla khueh uh lamtah Egypt kah te huul pa uh,’ ti nah,” a ti nah.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Moses loh a doo tih, “Kai he n'tangnah uh pawt koinih kai ol he hnatun pawt vetih, 'Nang taengah BOEIPA a phoe moenih,’ a ti uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah amah te BOEIPA loh , “Na kut dongkah te balae?” a ti nah hatah, “Conghol,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah, “Te te diklai la voei lah,” a ti nah tih diklai la a voeih. Te vaengah rhul la a poeh pah dongah Moses khaw a taeng lamloh rhaelrham.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae BOEIPA loh Moses te, “Na kut yueng lamtah a mai ah tu,” a ti nah. A kut a yueng tangloeng tih a tuuk vaengah tah a kut dongah conghol la poeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah a napa rhoek kah Pathen BOEIPA, Abraham Pathen, Isaak Pathen, Jakob Pathen tah nang taengah phoe tila a tangnah uh bitni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah BOEIPA loh anih te, “Na kut te na rhang ah puei bal dae,” a ti nah. A kut te a rhang ah a puei tangloeng tih a yueh vaengah tah a kut te vuelsong bangla a pahuk pah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah, “Na kut te na rhang ah koep puei lah,” a ti nah. A kut te a rhang ah a puei tangloeng tih a rhang lamloh a yueh vaengah tah a saa thim la tarha a om pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang te n'tangnah uh pawt akhaw ana om ngawn saeh. Lamhma kah miknoek ol te a yaak pawt atah a pabae kah miknoek ol te tangnah uh saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae miknoek rhoi dongkah he khaw tangnah uh pawt tih na ol te a yaak uh pawt akhaw ana om saeh. Sokko lamkah tui te lo lamtah laiphuei te bueih pah. Sokko lamkah na loh tui te poehlip vetih laikoeng dongah thii la poeh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Moses loh BOEIPA te, “Aw ka Boeipa, hlaem ah khaw, hlaemvai ah khaw na sal taengah na thui vaeng lamlong mah kai he olka dongah ka hlang voel moenih. Te dongah ka ka tonga tih ka ol khol,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae BOEIPA loh amah te, “Hlang ham ka aka khueh pah te unim? Olmueh neh hnapang, miktueng neh mikdael aka khueh te unim? BOEIPA kamah moenih a?
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah cet laeh lamtah nang kah hmuilai dongah kamah ka om vetih na thui ham te kan thuinuet bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae, “Aw ka Boeipa, na tueih akhaw kuttoem mah tueih laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah BOEIPA kah thintoek te Moses taengah sai tih, “Na manuca Aron te Levi moenih a? Ka ming ta, thui ham koi te anih loh a thui ta. Te dongah anih khaw nang doe ham ha lo coeng. Te vaengah nang m'hmuh vetih a lungbuei ah a kohoe bitni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih te voek tangloeng lamtah olka he a hmuilai ah khueh pah. Kai he nang kah hmuilai dongah khaw anih kah hmuilai dongah khaw ka om vetih na saii ham te nang kan thuinuet bitni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah anih te pilnam taengah nang yueng la cal saeh lamtah nang kah hmuilai la om rhoe om saeh. Nang ngawn tah anih taengah Pathen bangla na om ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae he conghol he na kut dongah pom lamtah te nen te miknoek saii,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te daengah Moses te cet tih a masae Jether taengla mael. Te phoeiah a masae taengah, “Ka cet pawn saeh lamtah Egypt kah ka manuca rhoek taengah ka mael mai eh. Amih kah hingnah khaw ka hmuh pueng khaming,” a ti nah. Te vaengah Jethro loh Moses te, “Sading la cet ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah BOEIPA loh Midian kah Moses te, “Cet lamtah Egypt la mael laeh, nang kah hinglu aka mae hlang khaw boeih duek uh coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Moses loh a yuu neh a ca rhoek te a loh tih laak dongah a ngol sak. Tedae Egypt kho la a mael vaengah Moses loh Pathen kah conghol ni a kut dongah a pom.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah BOEIPA loh Moses te, “Na caeh vaengah Egypt la mael. Na kut dongah kopoekrhai cungkuem kam paek te tueng. Te te Pharaoh mikhmuh ah saii pah. Tedae kai loh a lungbuei ka moem vetih pilnam te hlah mahpawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Pharaoh te thui pah. BOEIPA loh he ni a. thui. Israel tah ka capa neh ka caming ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah namah taengah khaw ka thui coeng. Ka ca te tueih lamtah kai ham thothueng saeh. Tedae anih hlah ham na aal atah kai loh na capa khuikah na caming te ka ngawn ne,” a ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />Longpuei kah rhaehim ah a om vaengah anih te BOEIPA neh hum uh tih ngawn la cai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah Zipporah loh hmailung a loh tih a capa kah hmuicue te a hlueng pah. Te phoeiah a kho ah a net tih, “Nang tah kai ham thii dongkah yulokung ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te daengah BOEIPA te Moses taeng lamloh nong. Te vaengah hmuicuerhetnah te ni thii dongkah yulokung la a thui.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah BOEIPA loh Aron taengah, “Khosoek la cet lamtah Moses te doe laeh,” a ti nah. A caeh tangloeng vaengah tah amah neh Pathen kah tlang ah hum uh tih a mok.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Moses loh amah tueih tih miknoek cungkuem neh amah a uen bangla BOEIPA ol boeih boeih te Aaron hma te a thui pah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Moses neh Aaron te cet tih Israel ca a ham boeih te a coi rhoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah BOEIPA loh Moses taengkah a thui ol boeih te Aaron loh a thui pah tih pilnam mikhmuh ah miknoek khaw a tueng sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pilnam loh a tangnah vaengah tah BOEIPA loh Israel ca a hip tih, amih kah phacipphabaem a hmuh pah te khaw a yaak uh dongah buluk uh tih a bawk uh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Moses neh Aaron te cet rhoi tih Pharaoh te, “Israel Pathen BOEIPA loh , 'Ka pilnam he hlah lamtah khosoek kah kamah taengah lam uh saeh,’ a ti,” a ti nah rhoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae Pharaoh loh , “U BOEIPA nim a ol te ngai vetih Israel te ka hlah eh? BOEIPA te ka ming pawt dongah Israel te ka hlah mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah, “Hebrew rhoek kah Pathen loh kaimih te n'doe. Longpuei hnin thum caeh kah khosoek ah ka cet uh mai eh. BOEIPA ka Pathen te ka nawn uh pawn eh. Kaimih he duektahaw neh, cunghang neh n'cuuk tarha ve,” a ti nah rhoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Egypt manghai loh amih rhoi te, “Moses neh Aaron, balae tih pilnam te a bitat na hlahpham sak, namah bi la cet,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Pharaoh loh , “Khohmuen pilnam loh yet coeng tih amamih khaw a bitloh lamkah na kangkuen sak ke,” a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te khohnin ah tah Pharaoh loh pilnam sokah aka tueihno rhoek neh a rhoiboei rhoek te a uen.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Hlaem hlaemvai kah bangla laiboeng aka saii pilnam te cangkong paek ham vaengah koei pa uh boeh. Amamih cet uh saeh lamtah amamih ham cangkong te coi uh saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae laiboeng kah a lan a tang tah amih taengah hlaem hlaemvai kah, a saii bangla khueh uh lamtah yueh pah boeh. A duem uh ham tangloeng ni pang uh tangkhuet tih, 'Ka Pathen te nawn ham ka cet ni, ' a ti uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang rhoek ham thohtatnah loh a nan daengah ni te te a saii uh vetih laithae ol taengla a mang uh pawt eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah pilnam aka tueihno neh a rhoiboei rhoek te cet uh tih pilnam te a voek uh. Te vaengah, “Pharaoh loh , “Nangmih te cangkong kam pae mahpawh,’ a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Namamih cet uh lamtah me lamkah a hmuh uh akhaw cangkong te namamih loh vawthaih uh. Tedae ol vanbangla na thohtatnah te hnop boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah pilnam te cangkong yueng la divawt coi ham Egypt kho tom ah taekyak uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah aka tueihno rhoek loh a tanolh uh tih, “Cangkong a om vaengkah bangla hnin at kah na bi tueng hno te amah khohnin ah coeng uh,” a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih sokah a khueh Pharaoh kah a tueihno rhoek loh Israel ca rhoek kah rhoiboei te a ngawn uh tih, “Hlaem hlavai kah bangla saii ham khaw hlaem neh tihnin kah khaw balae tih na oltlueh te na coeng uh pawh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah Israel ca rhoek kah rhoiboei rhoek te cet uh tih Pharaoh taengah pang uh tih, “Balae tih na sal rhoek taengah he he na saii.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na sal rhoek he cangkong m'paek pawt ah kaimih taengah laiboeng saii ham a thui uh. Na pilnam a tholh akhaw na sal rhoek ni n'ngawn uh coeng he,” a ti na uh .
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae, “Nangmih aka duem la aka duem rhoek, nangmih loh BOEIPA taengah hmueih nawn la caeh ham na thui tangkhuet.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah lcet uh lamtah thotat uh laeh. Nangmih te cangkong m'paek pawt akhaw laiboeng tah a rhimong hil pae uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Amah khohnin ah hnin at kah olka bangla na laiboeng te hnop boeh,” a ti coeng dongah amih loh a yoethae a puei te Israel ca kah rhoiboei rhoek loh a hmuh uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pharaoh taeng lamloh a nong vaengah amih rhoi doe ham aka pai rhoek te Moses neh Aaron te a doo uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah amih rhoi te, “BOEIPA loh nangmih te m'hmu lamtah laitloek nawn saeh. Mamih kah hmuehmuei te Pharaoh mik ah bo a rhim sak tih a sal rhoek mikhmuh ah mamih ngawn ham a kut ah cunghang a paek,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Moses te BOEIPA taengla mael tih, “Ka Boeipa aw, balae tih pilnam soah thae na huet? Balae tih he la kai nan tueih?
  </para>
  <para style="p">
    <verse number="23" style="v" />Na ming neh thui ham Pharaoh taengla ka pawk lamkah te pilnam he ni thae a huet thil tih na pilnam te na huul khaw na huul hae moenih,” a ti nah.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te, “Pharaoh taengah ka saii ham te na hmuh pawn ni. Tlungluen kut he amih taengah a tueih vetih tlungluen kut loh amih te a khohmuen lamloh a haek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen loh Moses te a voek bal tih a taengah, “Kai tah Yahweh ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham taengah, Isaak taeng neh Jakob taengah Tlungthang Pathen la ka phoe coeng dae ka ming te amih taengah Yahweh la ka ming sak moenih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Kanaan khohmuen te amih taengah paek hamla amih taengah ka paipi te ka thoh bal. A khuiah ana bakuep nah te a lampahnah khohmuen ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai loh Israel ca rhoek kah nguekcoinah te khaw ka yaak coeng. Egypt loh amih thohtat sak cakhaw ka paipi te ka poek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Israel ca rhoek te thui pah. Kai BOEIPA loh nangmih te Egypt bitloh hmui lamkah kan loh vetih amih kah thohtatnah lamloh nangmih te kang huul ni. Nangmih te ban ka yueng vetih tholhphu tanglue neh kan tlan ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangmih te kamah taengah pilnam la kan loh vetih nangmih taengah Pathen la ka om ni. Te vaengah Egypt bitloh hmui lamloh nangmih aka khuen BOEIPA na Pathen kamah he nan ming uh bitni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangmih khaw te khohmuen la kang khuen ni. Te te paek ham ni ka kut he Abraham taeng neh Isaak taeng neh Jakob taengah ka thueng. Te dongah te te BOEIPA kamah loh khoh la nangmih taengah kam paek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moses loh Israel loh ca rhoek taengah a thui dae mangkhak la thohtatnah neh mueihla kobawtnah dongah Moses ol te hnatun uh pawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="11" style="v" />Paan lamtah Egypt manghai Pharaoh te thui, Israel ca rhoek te a khohmuen lamloh hlah laeh saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae Moses loh BOEIPA mikhmuh ah rhep a thui tih, “Israel ca rhoek long pataeng kai ol he a hnatun uh moenih he. Te dongah kai tah ka hmuilai aka ngun he Pharaoh loh metlam kai ol a hnatun eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah BOEIPA loh Moses neh Aaron te a voek tih Israel ca kawng neh Egypt manghai Pharaoh kawng khaw, Egypt khohmuen lamloh Israel ca rhoek a khuen ham te khaw a uen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel kah caming Reuben koca kah a napa imkhui kah a lu rhoek la Enok neh Khetsron Pallu neh Karmee tih, te rhoek te Reuben huiko la om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Simeon koca ah Jemuel neh Jamin, Ohad neh Jakhin, Zohar neh Kanaan nu kah a capa Saul khaw om. He rhoek he Simeon kah huiko la om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah rhuirhong dongah Levi koca rhoek a ming tah Gershon, Kohath neh Merari om. Levi kah a hingnah kum he kum ya sawmthum kum rhih lo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gershon koca ah Libni neh Shimei he amah huiko la om van.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath koca ah Amram, Izhar, Hebron neh Uzziel om. Kohath kah a hingnah kum he kum ya sawmthum kum thum lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari koca rhoek la Mahli neh Mushi om tih Amah rhuirhong ah tah te rhoi khaw Levi kah huiko la om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amram loh a napi Jokhebed te a yuu la a loh tih Aaron neh Moses a cun pah. Amram a hingnah kum he kum ya sawmthum kum rhih lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izhar koca ah Korah, Nepheg neh Zikhri.
  </para>
  <para style="p">
    <verse number="22" style="v" />Uzziel koca Mishael, Elizaphan neh Sithri.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aaron loh Amminadab canu, Nahshon ngannu Elisheba te a yuu la a loh tih Nadab, Abihu, Eleazar neh Ithamar a sak pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Korah kah koca ah Assir, Elkanah neh Abiasaph tih, te rhoek te Korah kah cako la om uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aaron capa Eleazar loh Putiel nu te a yuu la a loh tih Phinekha te a sak. Te rhoek te amah huiko ah Levi napa kah patuel la om.
  </para>
  <para style="p">
    <verse number="26" style="v" />BOEIPA loh Aaron neh Moses te, “Israel ca rhoek te Egypt kho lamloh a caempuei la khuen laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israel ca te Egypt lamloh khuen ham Egypt manghai Pharaoh taengah aka thui khaw amih rhoi Moses neh Aaron ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />BOEIPA loh Moses a voek hnin ah Egypt kho ah om coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah BOEIPA loh Moses te a voek tih, “Kai tah Yahweh ni, kai loh nang taengah ka thui boeih te Egypt manghai Pharaoh taengah thui pah,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae Moses loh BOEIPA mikhmuh ah, “Kai hmuilai aka ngun he Pharaoh loh kai ol te metlam a hnatun pai eh?,” a ti.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te, “So lah, nang te Pharaoh taengah Pathen la kang khueh tih na maya Aaron te nang kah tonghma la om coeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang kang uen boeih te namah loh thui lamtah na maya Aaron loh Pharaoh taengah thui saeh. Te vaengah Israel ca rhoek te a khohmuen lamloh a hlah bitni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae kai loh Pharaoh kah lungbuei te ka mangkhak sak vetih ka miknoek neh kai kah kopoekrhai he Egypt khohmuen ah ka ping sak ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te lalah nang ol te Pharaoh loh hnatun pawt cakhaw ka kut he Egypt soah ka hlah ni. Te vaengah tholhphu tanglue a paek rhangneh ka pilnam Israel ca Egypt khohmuen lamloh ka caempuei la ka khuen ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Egypt te ka kut ka hlah thil tih Israel ca te amih khui lamloh ka khuen vaengah Egypt loh kai he BOEIPA la a ming uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A saii vaengah khaw BOEIPA kah a uen banglam ni Moses neh Aaron loh amih taengah a saii rhoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pharaoh taengah a voek rhoi vaengah he Moses te kum sawmrhet lo ca tih Aaron te kum sawmrhet kum thum lo ca coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />BOEIPA loh Moses neh Aaron te a voek tih,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Pharaoh loh nangmih te m'voek tih, 'Nangmih kah kopoekrhai tueng sak,’ a ti. Te vaengah Aaron te,’ Na conghol te khuen laeh. Te phoeiah Pharaoh mikhmuh ah tloeng lamtah tuihnam la poeh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah Moses neh Aaron te Pharaoh taengah cet rhoi tih BOEIPA loh a uen vanbangla a saii rhoi. Te vaengah Aaron loh a conghol te Pharaoh mikhmuh neh a sal rhoek mikhmuh ah a voeih pah tih tuihnam la poeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharaoh long khaw hlangcueih neh hlangbi rhoek te a khue. Amih Egypt hmayuep rhoek long khaw amamih kah hmaitak neh phek a saii uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang loh a conghol tah a voeih uh tih tuihnam la poeh ngawn dae Aaron kah conghol loh amih kah conghol te a dolh pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Pharaoh kah lungbuei tah mangkhak pueng tih BOEIPA kah a thui bangla amih rhoi ol te hnatun pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah BOEIPA loh Moses te, “Pharaoh kah lungbuei tah thah tih pilnam te hlah ham a aal.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharaoh te mincang ah a paan rhoi. Tui taengla a pawk vaengah sokko soktaeng ah anih tong ham ana pai rhoi ne. Te vaengah rhul la aka poeh conghol te na kut dongah khuen rhoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah anih te , 'Hebrew kah Pathen Yahweh loh nang taengah kai he n'tueih tih, 'Ka pilnam te tueih lamtah khosoek ah kai ham thothueng uh saeh,’ a ti. Tedae tahae duela na hnatun moenih ko he.
  </para>
  <para style="p">
    <verse number="17" style="v" />BOEIPA loh he ni a thui. He nen ni kai he BOEIPA la na ming eh. Ka kut dongkah conghol neh sokko kah tui te ka boh vetih thii la poeh pawn ni he.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sokko kah nga te duek vetih sokko te rhim ni. Sokko lamkah tui a ok ham vaengah Egypt rhoek te khobing uh ni,’ ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />BOEIPA loh Moses taengah, “Aaron te, 'Na conghol khuen lamtah Egypt tui so neh a tuiva soah, a sokko so neh a tuibap ah, a tui tungnah boeih soah na kut thueng pah. Te vaengah thii la poeh vetih Egypt khohmuen tom ah thing khuikah neh lungto khuikah khaw thii la poeh ni, 'ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Moses neh Aaron loh BOEIPA kah a uen bangla a saii rhoi. Conghol te a thueng tih Pharaoh mikhmuh neh a sal rhoek mikhmuh ah sokko kah tui te a boh. Te vaengah sokko kah tui boeih te thii la poeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah sokko kah nga khaw duek tih sokko te rhim coeng. Te dongah Egypt rhoek loh sokko lamkah tui ok ham coeng voel pawh. Egypt khohmuen tom ah thii om.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Egypt hmayuep rhoek long khaw a tuisiduei neh a saii uh van. Te dongah Pharaoh kah lungbuei mangkhak tih BOEIPA kah a thui bangla amih rhoi ol te hnatun pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pharaoh te mael tih amah im la a pawk phoeiah tah he he a lungbuei ah dueh pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sokko tui te ok ham a coeng pawt dongah, ok ham tui te Egypt pum loh sokko kaepvai ah a too.
  </para>
  <para style="p">
    <verse number="25" style="v" />BOEIPA loh sokko a ngawn te ahnukah hnin rhih a cup sak.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah BOEIPA loh Moses te, “Pharaoh taengah cet lamtah anih te, 'BOEIPA loh ka pilnam te hlah lamtah kai taengah thothueng saeh,’ a ti.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae hlah ham na aal atah na khorhi boeih ah bukak kan yok sak coeng ne.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bukak te sokko ah kah vetih ha luei ni. Te vaengah na im khui neh imhman kah na thingkong dongah, na baiphaih dongah, na sal im khui neh na pilnam soah, na tapkhuel khui neh na vaidambael khuila kun ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Namah so neh na pilnam soah khaw na sal boeih soah khaw bukak luei ni, 'ti nah,” a ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah BOEIPA loh Moses te, “Aaron te na kut thueng lamtah na conghol neh tuiva soah khaw, sokko soah khaw, tuibap soah khi laeh,'ti nah. Te vaengah bukak te Egypt khohmuen ah ha luei saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Aaron loh a kut te Egypt tui soah a thueng. Te vaengah bukak ha luei tih Egypt khohmuen te a khuk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae hmayuep loh a tuisiduei neh phek a saii uh tih bukak te Egypt kho la luei van.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Pharaoh loh Moses neh Aaron te a khue tih, “BOEIPA taengah thangthui lamtah bukak he kai lamkah neh ka pilnam taeng lamlong khaw nong sak saeh. Te vaengah pilnam te ka tueih vetih BOEIPA taengah hmueih a nawn uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Moses loh Pharaoh te, “Kai ham mah hoep dae. Nang ham neh na sal rhoek ham, na pilnam ham khaw, bukak te namah neh na im lamloh a hnawt tih sokko ah dawk a om ham me vaengah lae thangthui eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Thangvuen ah,” a ti nah dongah, “Na ol bangla kaimih kah Pathen Yahweh bang a om pawt khaw na ming van bitni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah bukak te nang lamkah neh na im lamlong khaw, na sal rhoek taeng lamkah neh na pilnam taeng lamloh nong vetih sokko ah ni dawk a om eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Moses neh Aaron te Pharaoh taeng lamloh nong tih Pharaoh sokah a khueh olka, bukak kawng te Moses loh BOEIPA taengah a pang pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Moses kah ol bangla BOEIPA loh a saii dongah bukak te im ah khaw, vongup ah khaw, lohma ah khaw duek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te te a hlom a hlom la a hmoek uh tih khohmuen tom ah rhim.
  </para>
  <para style="p">
    <verse number="15" style="v" />A hmuh daengah Pharaoh te hilhoemnah a om pah. Tedae a lungbuei a thangpom tih BOEIPA kah a thui bangla amih rhoi ol te hnatun pawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah BOEIPA loh Moses taengah, “Aaron te, 'Na conghol thueng lamtah diklai kah laipi te taam. Te vaengah Egypt khohmuen boeih ah pilhlip la om ni, 'ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />A saii rhoi tangloeng tih Aaron loh a kut te a thueng. A conghol neh diklai dongkah laipi te a taam vaengah pilhlip te hlang pum dong neh rhamsa dongah om. Diklai laipi boeih te Egypt kho tom ah pilhlip la poeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae hmayuep rhoek long khaw pilhlip om sak ham a thaai neh a saii uh van tangloeng. Tedae pilhlip te hlang dong neh rhamsa dongah khaw om thai pawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah ah hmayuep rhoek loh Pharaoh taengah, “Pathen kah kutdawn la he,” a ti uh. Tedae Pharaoh lungbuei tah ning tih BOEIPA kah a thui bangla amih rhoi ol te hnatun pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah BOEIPA loh Moses te, “Mincang ah thoo lamtah Pharaoh mikhmuh ah pai pah. Tui taengla a pawk vaengah amah te, 'BOEIPA loh , 'Ka pilnam he hlah lamtah kai ham thothueng uh saeh,’ a ti coeng he.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae ka pilnam te nan hlah pawt atah namah so neh na sal rhoek soah khaw, na pilnam so neh na im ah khaw pil ka tueih coeng ne. Te dongah pil te Egypt imkhui neh amih kah a diklai dongah khaw bae ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae te khohnin ah Goshen khohmuen kah ka pilnam te ka hoep vetih a khuikah aka om te pil om pah mahpawh. Te daegah ni diklai hman ah kai he BOEIPA la nan ming eh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka pilnam laklo neh na pilnam laklo ah tlannah ka khueh vetih miknoek he thangvuen ah thoeng bitni,’ ti nah,” a ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />BOEIPA loh a saii tangkhuet tih Pharaoh im khui neh a sal im neh Egypt khohmuen boeih ah pil tlung ha pawk. Pil dongah mah khohmuen khaw poci.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah Pharaoh loh Moses neh Aaron te a khue tih, “Cet uh lamtah khohmuen ah na Pathen te nawn uh laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae Moses loh , “Egypt kah tueilaehkoi dongah he he saii ham a thuem moenih. Kaimih kah Pathen BOEIPA ham ka nawn uh vaengah Egypt lamkah tueilaehkoi te ka nawn uh koinih amih mikhmuh ah kaimih n'dae uh mahpawt nim?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaimih n'uen bangla hnin thum long caeh kah khosoek ah kaimih kah Pathen BOEIPA te ka nawn uh eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Pharaoh loh , “Kai loh nangmih kan hlah bitni , khosoek ah na Pathen BOEIPA te nawn tangloeng. Tedae a hla, hla la cet uh boel lamtah kai ham khaw thangthui uh,” a ti nah.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te, “Pharaoh taengah cet lamtah anih te thui pah. Hebrew kah Pathen Yahweh loh he ni a. thui. Ka pilnam te hlah lamtah kai ham thothueng uh saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae hlah ham na aal tih amih te na yuengyet pueng atah,
  </para>
  <para style="p">
    <verse number="3" style="v" />BOEIPA kut te lohma kah na boiva soah, marhang soah, laak soah, kalauk soah, saelhung soah tla vetih boiva dongah duektahaw la muep tlung ne.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae BOEIPA loh Israel kah boiva laklo neh Egypt kah boiva laklo ah a hoep vetih Israel ca rhoek kah boeih tah ol nen pataeng duek pah mahpawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA loh thangvuen ah thui hamla khoning a khueh coeng. He kah hno he BOEIPA loh khohmuen ah a saii ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tekah BOEIPA loh ol te a vuen ah a thoeng sak. Te dongah Egypt kah boiva tah boeih duek. Tedae Israel ca rhoek kah boiva tah pakhat khaw duek pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah Pharaoh loh hlang a tueih akhaw Israel kah boiva tah pakhat pataeng a duek moenih ne. Tedae Pharaoh lungbuei te a thangpom pueng tih pilnam te hlah pawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah BOEIPA loh Moses neh Aaron te, “Hmailing khangvai te namamih rhoi ham na kutnarhum a bae lo rhoi lamtah Moses loh Pharaoh mikhmuh ah vaan la haeh saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah Egypt kho tom ah laipi la poeh vetih, Egypt khohmuen boeih kah hlang so neh rhamsa dongah buhlut la om a hnai neh phuem ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah hmailing khangvai te a loh rhoi tih Pharaoh mikhmuh ah pai rhoi. Te te Moses loh vaan la a haeh tih buhlut la poeh tih hlang pum dong neh rhamsa dongah a hnai a coe pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah hmayuep rhoek tah buhlut dongah Moses mikhmuh la pai ham noeng uh pawh. Buhlut te hmayuep rhoek so neh Egypt pum soah a om pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae BOEIPA loh Pharaoh kah lungbuei te a moem pah dongah BOEIPA loh Moses taengah a thui bangla amih rhoi ol te hnatun pawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah BOEIPA loh Moses taengah, “Mincang ah thoo lamtah Pharaoh mikhmuh ah pai pah. Te vaengah anih te thui pah. Hebrew kah Pathen Yahweh loh he ni a. thui. Ka pilnam he hlah lamtah kai ham thothueng saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tahae voei khat la kai kah lucik cungkuem te na lungbuei neh na sal rhoek taengah, na pilnam taengah kan tueih. Te nen ni diklai pum ah kamah bang a om pawt te na ming eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka kut he ka hlah tih namah neh na pilnam te duektahaw neh kang ngawn coeng dongah diklai lamloh na pat pawn ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />He kong dongah ka thadueng na phoe ham ni nang kam pai sak. Te dongah ka ming he diklai pum ah thui ham om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amih hlah pawt ham te ka pilnam taengah na picai uh pueng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thangvuen a tue vai khat tah rhael muep kan tlan sak khungdaeng pueng ni he. Te bang te a suen khohnin lamloh tahae hil khaw Egypt ah a om moenih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah tueih lamtah na boiva neh na taengkah boeih te khaw, khohmuen kah hlang boeih neh lohma kah a hmuh rhamsa khaw bakuep sak laeh. Im la a coi pawt te rhael loh a tlak thil vetih duek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pharaoh sal rhoek khuikah BOEIPA ol aka rhih long tah a sal rhoek neh a boiva khaw im la a rhaelrham puei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae BOEIPA ol te a lungbuei ah aka khueh pawt long tah a sal neh a boiva te lohma ah a hnoo.
  </para>
  <para style="p">
    <verse number="22" style="v" />BOEIPA loh Moses taengah, “Na kut te vaan la thueng lamtah Egypt khohmuen boeih ah hlang so neh rhamsa soah khaw, Egypt diklai kah khohmuen baelhing boeih soah rhael tla bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Moses loh a conghol te vaan la a thueng tangloeng vaengah BOEIPA loh a ol neh rhael neh a tueih tih hmai khaw diklai la cet. Te vaengah BOEIPA loh Egypt khohmuen ah rhael a tlan sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rhael a tlak vaengah rhael lakli ah hmai khaw muep hli khungdaeng. Namtom taengah aka om parhi te Egypt khohmuen tom ah te bang a om noek moenih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Egypt kho tom ah rhael loh lohma kah boeih, hlang lamloh rhamsa hil khaw a ngawn. Khohmuen baelhing boeih te rhael loh a ngawn tih khohmuen thingkung boeih a khong.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel ca rhoek kah Goshen khohmuen bueng ah ni rhael a tlak pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah Pharaoh loh ol a tah tih Moses neh Aaron te a khue. Te phoeiah amih rhoi te, “Ka tholh bal coeng, BOEIPA he dueng ngawn dae kamah neh ka pilnam ni aka halang coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />BOEIPA taengah thangthui rhoi laeh. Pathen kah ol neh rhael a tlak khaw yet coeng. Nangmih te kan tueih daengah nan pai thil ham te na khoep pawt eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah Moses loh anih te, “Khopuei he ka nong tak tih BOEIPA taengah ka kut ka phuel ni. Ol khaw paa tih rhael koep a bo pawt daengah ni diklai he BOEIPA ham ni tila na ming eh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae namah neh na sal rhoek loh BOEIPA Pathen mikhmuh ah na rhih uh hlan tila ka ming.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thut neh cangtun neh khaw cangtun vueilue neh thut muem khaw a ngawn coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae cang neh cangkuem tah a hnong pueng dongah ngawn pawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Moses loh Pharaoh taeng lamkah khopuei a nong tak tih BOEIPA taengah a kut a phuel. Te daengah rhaek ol neh rhael khaw paa tih khotlan loh khohmuen ah bo pawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khotlan neh rhael neh ol paa coeng tila Pharaoh loh a hmuh van neh tholh te a khoep tih amah neh a sal rhoek loh a lungbuei a thangpom.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah Pharaoh lungbuei tah ning tih BOEIPA loh Moses kut ah a uen bangla Israel ca hlah pawh.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te, “Pharaoh te paan laeh, a khui ah ka miknoek ka khueh ham dongah ni amah lungbuei neh a sal rhoek kah lungbuei khaw ka thangpom sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te daengah ni na ca rhoek neh na ca kah a ca hna dongah Egypt te ka poelyoe tih amih taengah ka miknoek ka khueh te na tae uh vetih tite kai he Yahweh la nan ming uh eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Moses neh Aaron te Pharaoh taengah cet tih anih te, “Hebrew kah Pathen BOEIPA loh he ni a. thui. Me hil nim ka mikhmuh ah yalh ham na aal ve, ka pilnam te hlah lamtah kai ham thothueng uh saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae ka pilnam te hlah ham na aal atah na khorhi la thangvuen ah kaisih kang khuen ni ne.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah diklai hman he a thing vetih lai he tueng thai mahpawh. Rhael lamloh nangmih taengah aka sueng rhalyong hlangrhuel han caak vetih khohmuen ah nangmih ham aka duei thingkung boeih khaw a caak ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Namah im neh na sal boeih kah im ah khaw, Egypt pum kah im ah khaw bae ni. Diklai ah a om uh hnin lamloh tahae khohnin duela na pa rhoek neh na pa kah a napa rhoek loh a hmuh uh noek moenih,” a ti nah rhoi. Te phoeiah mael rhoi tih Pharaoh taeng lamloh nong rhoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah Pharaoh kah sal rhoek loh a taengah, “Me hil nim mamih taengah hlaeh la a om ve he. tongpa rhoek te tueih mai lamtah a Pathen Yaweh taengah thothueng uh saeh, Egypt a rhawp coeng he na ming hlan nim?” a ti uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Moses neh Aaron te Pharaoh taengla a mael puei uh tih amih rhoi te, “Cet uh lamtah na Pathen Yahweh taengah thothueng uh. Tedae ubang ubang lae a caeh eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Moses loh , “Camoe neh patong khaw ka cet uh vetih, ka capa neh ka canu khaw, ka boiva neh ka saelhung neh ka BOEIPA kah khotue te ka paan uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah amih rhoi te, “BOEIPA te nangmih taengah om tangloeng saeh. Nangmih neh na camoe rhoek te kan hlah sitoe cakhaw na maelhmai ah boethae phaeng tueng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te tlam moenih. Te te na hoe uh dongah tongpa rhoek te cet uh lamtah BOEIPA taengah thothueng uh laeh,” a ti nah tih amih rhoi te Pharaoh mikhmuh lamloh a haek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah BOEIPA loh Moses te, “Kaisih ham te Egypt khohmuen ah na kut thueng laeh. Te vaengah Egypt Khohmuen ah pongpa vetih rhael loh a hlun boeih neh khohmuen baelhing boeih te a caak bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Moses loh a conghol te Egypt khohmuen la a thueng. Te vaengah BOEIPA loh khothoeng yilh te khohmuen sola khohnin yung neh khoyin puet ah a thawn pah. Mincang a pha vaengah kanghawn yilh loh kaisih a khuen pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaisih khaw Egypt khohmuen tom ah van tih Egypt khorhi boeih ah bop. A mikhmuh ah tlung khungdaeng coeng tih te bang kaisih te ana om noek pawt tih te hnukah khaw om bal mahpawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Diklai hman te boeih a thing tih diklai khaw hmuep. Diklai baelhing boeih neh rhael loh a hlun thing thaih boeih te a caak. Te dongah thing hing neh lohma baelhing boeih tah Egypt khohmuen tom ah sueng voel pawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah Pharaoh tah Moses neh Aaron te khue hamla tokthuet tih, “Na Pathen Yahweh teang neh nangmih taengah ka tholh coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah ka tholhnah he phuei mai laeh. Na Pathen BOEIPA taengah vai mah thangthui rhoi lamtah dueknah he khaw kai taeng lamloh nong sak saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Pharaoh taeng lamloh nong rhoi tih BOEIPA taengah a thangthui pah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah BOEIPA loh khotlak yilh te bahoeng a tlungluen la a maelh tih kaisih te a khuen. Carhaek tuipuei la a yawn tih Egypt khorhi tom ah kaisih pakhat khaw hlun pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae BOEIPA loh Pharaoh lungbuei te te a moem pah dongah Israel ca rhoek te hlah pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah BOEIPA loh Moses te, “Vaan la na kut thueng lamtah a hmuep loh Egypt khohmuen a tlak thil vaengah a hmuep te phatuem saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Moses loh a kut te vaan la a thueng tih Egypt khohmuen boeih te khohmuep hmaisuep loh hnin thum a khuk.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hlang loh a manuca khaw hmu pawt tih hlang he amah lamloh hnin thum khuiah thoo uh voel pawh. Tedae Israel ca boeih ham tah a tolrhum ah vangnah om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Pharaoh loh Moses te a khue tih, “Cet uh lamtah BOEIPA taengah thothueng uh. Tedae na boiva neh na saelhung te khueh lamtah na ca rhoek khaw namamih neh cet uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Moses loh , “Namah long khaw kaimih kut ah hmueih neh hmueihhlutnah te nam paek uh daengah man ka Pathen Yahweh te ka nawn uh thai ve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah ka boiva khaw kamamih neh ka puei uh vetih a khomae pataeng hlun mahpawh. Kaimih kah Pathen Yahweh taengah thothueng ham vaengah te khui lamkah ni ka loh uh eh. Tedae te la ka pawk uh hlan atah BOEIPA taengah metla thothueng ham khaw ka ming uh moenih,” a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />BOEIPA loh Pharaoh lungbuei te a moem pah dongah amih te hlah ham huem pawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah anih te Pharaoh loh , “Kai taeng lamloh nong laeh, nang te ngaithuen, ka maelhmai hmuh ham koei voel boeh, ka maelhmai na hmuh hnin ah na duek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Moses loh , “Na thui bangla na maelhmai hmuh ham koep ka khoep mahpawh,” a ti nah.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te, “Pharaoh so neh Egypt soah tloh pakhat ka khuen pueng ni. Te phoeiah nangmih te he lamloh n'hlah vetih n'tueih vaengah khaw a boeih hil nangmih te he lamloh m'haek rhoe n'haek ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilnam hna ah thui pah laeh. Te daengah ni ngun hnopai neh sui hnopai he tongpa loh a hui taengah, huta long khaw amah hui taengah a hoe thai eh.
  </para>
  <para style="p">
    <verse number="3" style="v" />BOEIPA loh pilnam te Egypt mikhmuh ah mikdaithen la a khueh. Moses khaw Egypt kho kah Pharaoh sal mikhmuh neh pilnam mikhmuh ah hlang tanglue la bahoeng a poek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Moses loh, “BOEIPA loh he ni a. thui. Khoyin pathung ah Egypt khui la ka pawk ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Egypt Egypt kho kah caming boeih tah, a ngolkhoel dongah aka ngol Pharaoh caming lamloh kuelhsum taengah aka ngol salnu caming neh rhamsa caming boeih te duek ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Egypt kho tom ah pangngawlnah bahoeng om ni. Te bang te om vai pawt tih te bang te koep khoep mahpawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Israel ca boeih taengah tah ui long pataeng hlang neh rhamsa te a ol neh naak mahpawh. Te daengah ni BOEIPA loh Egypt laklo neh Israel laklo ah a hoep tila na ming uh eh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na sal rhoek boeih he kai taengah ha suntla uh vetih, 'Namah neh na kho kung kah pilnam boeih te khuen,” aka ti ham ka taengah a bakop uh daengah ni ka nong eh?,” a ti nah tih Pharaoh taeng lamloh thintoek thinling neh nong.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah BOEIPA loh Moses te, “Egypt kho ah kai kah kopoekrhai te ping sak ham ni Pharaoh loh nangmih rhoi ol a hnatun pawt eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Moses neh Aaron loh kopoekrhai cungkuem he Pharaoh mikhmuh ah a saii rhoi tangloeng dae Pharaoh lungbuei te BOEIPA loh a moem pah pueng dongah Israel ca te a khohmuen lamloh hlah pawh.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses neh Aaron te Egypt kho ah a voek.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Tahae hla he nangmih ham hla kungpuei neh kum dongkah hla khuiah khaw nangmih ham lamhma la om ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel rhaengpuei boeih taengah thui lamtah, 'Tahae kah hla rha dongah tah hlang long he a napa im ham tu pakhat, te pawt atah im pakhat ham tu pakhat tah amamih taengla lo uh saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tu aka om lakah imkhui a vaitah atah a im neh aka yoei a imben taengah lo saeh. Hlang kah hinglu tarhing neh aka ca tarhing ah tu te boesoep pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Boiva te a tal a hmabuet, kum khat aka lo ca te tah tuca khaw maae khaw namamih taengla lo uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah tahae hla hnin hlai li hil tuemkoi la nangmih taengah om vetih kholaeh ah Israel rhaengpuei hlangping boeih loh te te ngawn uh saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah a thii te lo uh saeh lamtah rhungsut so rhoi neh im kah danglo dongah pae uh saeh. A pum te a khuiah ca uh saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Maeh te khoyin ah hmai dongkah maehkaeh la ca uh saeh lamtah vaidamding neh ankhaa caak thil uh saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A haeng lam khaw, tui neh a thong tih a hmin te lamkhaw ca uh boeh. Tedae a lu neh a kho, a kotak khaw hmai a kaeh ni na caak eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te te mincang hil paih boeh, mincang hil aka coih pueng te tah hmai neh hoeh uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te te he tlam he ca uh. Na cinghen yen uh lamtah na khokhom te na kho dongah buenuh. Na conghol te na kut dongah pomuh. BOEIPA kah Yoom he thintawn la ca uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te khoyin ah Egypt khohmuen long ka pah vetih, Egypt kho kah caming boeih tah hlang lamloh rhamsa hil pataeng ka ngawn ni. Te vaengah BOEIPA kamah loh Egypt pathen boeih soah tholhphu ka thung ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thii he nangmih ham im dongah miknoek la om ni. Nangmih taengah thii te ka hmuh vaengah nangmih te kang kang vetih Egypt khohmuen ka ngawn vaengah khaw kutcaihnah tlohthae te nangmih ah om mahpawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah he khohnin he nangmih ham poekkoepnah la om saeh. Te vaengah BOEIPA taengah khotue neh lam uh. Na lam uh te na cadilcahma ham kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnin rhih khuiah vaidamding ca uh. A cuek hnin ah tolrhu te na im lamloh toeng uh. Tolrhu aka ca boeih tah a hinglu te a cuek hnin lamloh a rhih hnin due Israel lamloh khoe saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />A cuek khohnin kah a cim tingtunnah neh a rhih hnin kah a cim tingtunnah te nangmih ham om ni. Te vaengah bitat boeih he saii boel saeh. Tedae nangmih khuikah hinglu boeih loh a caak nawn te amah loh saii mai saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te khohnin kuelhuelh ah nangmih caempuei te Egypt kho lamloh kang khuen dongah vaidamding te ngaithuen. Te dongah na cadilcahma kah kumhal khosing dongah khaw he khohnin he ngaithuen uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lamhma ah hla sae hnin hlai li hlaem vaeng lamloh tekah hla hnin kul hnin khat hlaem duela vaidamding mah ca uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hnin rhih hil na im ah tolrhu hmu boel saeh. tolrhu aka ca boeih tah yinlai khaw, khohmuen mupoe khaw Israel rhaengpuei lamloh hinglu hnawt pah saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tolrhu aka nuen boeih tah ca uh boel lamtah na tolrhum boeih ah vaidamding mah ca uh ,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Moses loh Israel kah a hamca boeih te a khue tih amih te dangrhoek uh laeh, namah huiko ham boiva te namamih loh lo uh lamtah Yoom maeh te ngawn uh laeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah pumpiding bong at lo uh lamtah baeldung dongkah thii khuiah nuem uh. Baeldung khuikah thii te danglo so neh rhungsut rhoi dongah hluk uh. Nangmih te hlang pakhat khaw mincang hil a im thohka lamloh moe uh boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Egypt vuek ham BOEIPA loh a pah vaengah danglo dongkah neh rhungsut rhoi dongkah thii te a hmuh vetih a kan ni. Aka vuek te na im thohka la kun ham khaw BOEIPA loh nang te kutcaihnah la n'khueh mahpawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />He ol he namah ham neh na ca ham khaw kumhal kah oltlueh la ngaithuen laeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih taengah a thui vanbangla BOEIPA loh m'paek ham khohmuen la na pawk uh tue om bitni. Te vaengah he kah thothuengnah he ngaithuen uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na ca rhoek loh nangmih taengah, “Nangmih kah he mebang thothuengnah nim? aka ti khaw om ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah, “He tah BOEIPA kah Yoom hmueih ni. Amah loh Egypt kah Israel ca imkhui te a kan dongah Egypt te a vuek tih mamih imkhui te n'huul,’ ti nah,” a ti nah. Te phoeiah pilnam te buluk tih a bawk uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A caeh uh phoeiah khaw BOEIPA loh Moses neh Aaron a uen a saii rhoi vanbangla Israel ca rhoek long khaw a saii uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah khoyin boengli a pha vaengah BOEIPA loh a ngolkhoel dongah aka ngol Pharaoh caming lamloh tangrhom im kah tamna caming neh rhamsa caming boeih, Egypt khohmuen kah caming boeih te a ngawn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Pharaoh amah neh a sal boeih neh Egypt boeih tah khoyin ah thoo uh. Te vaengah aka duek pawh imkhui a om pawt dongah Egypt ah pangngawlnah muep om.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah khoyin ah Moses neh Aaron te a khue tih, “Thoo lamtah ka pilnam lakli lamloh namah neh Israel ca rhoek khaw nong uh laeh. Na thui bangla cet uh lamtah Yahweh te thothueng uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na boiva khaw, na saelhung khaw na thui uh bangla khuen uh. Cet uh lamtah kai khaw yoethen m'pae uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Egypt loh , “Kaimih boeih ka duek uh coeng, ” a ti uh. Te dongah amih te khohmuen lamloh tueih paitok ham te pilnam te a cahawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah pilnam loh a vaidambael dongkah tol a phul hlan a vaidamtlam te a himbai neh a boep uh tih a laengpang dongah a koh uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Israel ca rhoek long khaw Moses ol bangla a saii tih Egypt rhoek taengah cak hnopai neh sui hnopai neh himbai te a hoe uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />BOEIPA loh pilnam te Egypt mikhmuh ah mikdaithen la a khueh coeng dongah a hoe uh bangla Egypt kah te a huul pauh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah Sukkoth Raamses lamloh Israel ca rhoek aka cet te camoe a hoep phoeiah tongpa rhalkap thawng ya rhuk tluk louh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Namcom khaw amih taengah muep cet uh tih boiva neh saelhung boiva neh bahoeng yet uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Egypt lamloh a khuen vaidamtlam te tol a phul pawt dongah vaidamding buh la a kaeng uh. Egypt lamloh a haek uh vaengah uelh ham a coeng pawt dongah amamih ham lampu khaw a saii uh moenih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Israel ca rhoek loh a tolrhum nah tih Egypt ah kho a sak uh te kum ya li neh kum sawmthum lo coeng.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kum ya li neh kum sawmthum a bawtnah te a pha coeng. Te khohnin kuelhuelh te a pha vaengah tah BOEIPA kah caempuei boeih te Egypt kho lamloh khoe uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tekah haknah hlaem ah BOEIPA loh amih te Egypt kho lamkah a khuen. He khoyin he Israel ca boeih a cadilcahma ham BOEIPA taengkah haknah la om.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te phoeiah BOEIPA loh Moses neh Aaron te, “Yoom kah khosing he tah, kholong ca boeih long tah te te ca boel saeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tedae sal boeih khaw tangka neh a lai hlang te na rhet pah coeng atah tah te te ca saeh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Lampah neh kutloh long khaw te te ca boel saeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Im pakhat ah ca saeh. Maeh te imkhui lamloh tol la khuen boel saeh. A rhuh khaw a khuiah paep sak boeh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel rhaengpuei boeih loh te te saii saeh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Na taengah yinlai bakuep tih BOEIPA taengkah Yoom ka saii eh a ti atah tongpa boeih te rhet pah saeh. Te daengah ni te te a saii vaengah nuen van vetih khohmuen mupoe bangla a om eh. Tedae pumdul boeih tah te te ca boel saeh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Olkhueng he mupoe taeng neh nangmih lakli kah aka bakuep yinlai taengah pakhat la om saeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te dongah BOEIPA loh a uen tih Moses neh Aaron loh a saii bangla Israel ca rhoek loh boeih a saii uh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te khohnin kuelhuelh ah ni BOEIPA loh Israel ca rhoek te Egypt kho lamloh a caempuei neh a khuen.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel ca bung boeih kah cacuek caming boeih tah kamah ham ciim laeh. Hlang dongkah khaw, rhamsa dongkah khaw cacuek he kamah ham ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Moses loh pilnam te, “Egypt lamkah na coe khohnin he poek ham om. Sal imkhui lamkah nangmih te BOEIPA kut thaa neh n'doek coeng dongah tolrhu ca uh boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tihnin Abib hla ah na khoe uh coeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA loh nang te Kanaan neh Khitti, Amori neh Khivee neh Jebusi khohmuen la n'thak. Suktui neh khoitui aka long khohmuen he nang taengah paek ham khaw na pa rhoek taengah a toemngam coeng. Te dongah tahae hla dongah he thothuengnah neh thothueng uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnin rhih khuiah vaidamding ca lamtah a hnin rhih dongah tah BOEIPA kah khotue la om saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vaidamding te hnin rhih ca saeh lamtah na khuiah tolrhu hmu boel saeh. Na khui neh na khorhi boeih ah tol hmu boel saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te hnin ah tah na ca taengah puen lamtah, “Egypt lamkah ka thoh vaengah BOEIPA loh kai ham he he a saii dongah ni, “ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang ham Na kut dongah miknoek la, na mik laklo ah poekkoepnah la om ni. A tlungluen kut neh BOEIPA loh nang Egypt lamloh n'khuen coeng dongah BOEIPA kah olkhueng he na ka dongah om saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A khohnin lamloh a khohnin patoeng duela amah khoning vaengah he khosing he tuem uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kanaan khohmuen hil nang aka khuen la BOEIPA ha om bitni. Namah taeng neh na pa rhoek taengah a caeng bangla te te nang taengah m'paek coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bung dongkah cacuek boeih te BOEIPA taengla paan puei. Rhamsa saelca cacuek boeih neh na taengkah tongpa rhoek te BOEIPA kah ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae laak cacuek boeih te tu neh koep lat. Na lat pawt atah pahoi at laeh. Na ca rhoek khuiah tongpa caming boeih na lat ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na ca loh nang n'dawt tih, “Balae he?” aka ti khaw om ni. Te vaengah anih te, “BOEIPA loh Egypt sal im lamkah Mamih he a ban thaa neh n'khuen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mamih hlah ham te Pharaoh mangkhak la a om vaengah Egypt khohmuen kah caming boeih tah hlang caming lamloh rhamsa caming hil khaw BOEIPA loh a ngawn. Te dongah ni bung dongkah cacuek a tal boeih tah BOEIPA ham boeih ka nawn tih ka ca caming boeih tah ka lat,’ ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />BOEIPA loh mamih he Egypt lamloh a ban thaa neh n'khuen coeng dongah na kut dongah miknoek la, na mik laklo samtoelrhui la om ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pharaoh loh pilnam te a hlah coeng dae Pathen loh , “Pilnam he caemtloeknah a hmuh vaengah hal vetih Egypt la mael ve,” a ti. Te dongah amih te Pathen loh Philisti kho kah longpuei longah pat mawt pawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Pathen loh pilnam te carhaek tuili kah khosoek longpuei a lan puei tih Israel ca rhoek te Egypt kho lamloh caem la khong uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah Israel ca rhoek te a caeng, a caeng tih, “Na Pathen loh a hip khaw n'hip bitni. Te vaengah ka rhuh he, he lamloh namamih neh puei uh ,” a ti nah vanbangla Moses loh Joseph rhuh te amah taengla a loh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sukkoth lamloh cet uh tangloeng tih khosoek hmatoeng kah Etham ah rhaeh uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />BOEIPA te amih hmai ah cet. Khoyin khothaih a caeh ham vaengah tah amih longpuei mawt ham khothaih ah cingmai tung la, khoyin ah amih te tue ham hmai tung la a caeh pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khothaih kah cingmai tung neh khoyin kah hmai tung he pilnam mikhmuh lamloh nong sak pawh.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel ca rhoek te thui pah lamtah mael uh saeh. Te dongah Pihahiroth dan kah Migdol laklo neh Baalzephon dan kah tuipuei laklo ah rhaeh uh saeh. Te kah a dan tuipuei taengah khaw rhaeh uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Pharaoh loh , “Israel ca rhoek tah khohmuen ah amamih a lukil uh tih khosoek ah a det,” ti saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Pharaoh lungbuei te ka moem pah vetih amih te a hloem ni. Tedae Pharaoh neh a thadueng cungkuem rhangneh kamah ka thangpom vetih Egypt rhoek loh kai he Yahweh la a ming uh ni,” a ti nah tih a saii uh tangloeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae pilnam yong te Egypt manghai taengla a puen pah vaengah tah Pharaoh neh a sal rhoek loh pilnam taengah thinko a maelh uh tih, “Israel he mamih ham a thotat khui lamloh n'hlah coeng dongah balae n'saii uh he,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah a leng te a khih tih amah pilnam te amah taengla a loh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah leng a coelh ya rhuk neh Egypt leng boeih a boeilu boeih te khaw a loh.
  </para>
  <para style="p">
    <verse number="8" style="v" />BOEIPA loh Egypt manghai Pharaoh kah lungbuei te a moem pah dongah Israel ca rhoek te a hloem. Tedae Israel ca rhoek kut thoh nen ni a khong uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amih hnuk te Egypt rhoek loh a hloem uh tangloeng tih tuipuei taengah a rhaeh vaengah amih te a kae uh. Pharaoh kah marhang leng boeih neh a marhang caem khaw, anih kah caem khaw, Baalzephon dan kah Pihahiroth la pawk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pharaoh loh a paan vaengah Israel ca rhoek loh a mik te a huel uh. Egypt rhoek te a hnukah tarha a caeh pah vaengah tah bahoeng a rhih dongah Israel ca rhoek te BOEIPA taengah pang uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moses taengah khaw, “Egypt ah phuel om voel pawt tih nim khosoek ah duek sak ham kaimih nang khuen, Egypt lamloh kaimih nang khuen neh kaimih ham banim na saii he?
  </para>
  <para style="p">
    <verse number="12" style="v" />Egypt ah nang hma kan thui uh te ol pawt nim. Kaimih he tamah laeh saeh ka ti. Egypt taengah thotat palueng sih, khosoek kah duek lakah Egypt taengah thohtat he kaimih ham then ngai,” a ti uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Moses loh pilnam te, “Rhih uh boeh, pai uh lamtah hmu uh. BOEIPA kah khangnah nangmih ham tihnin ah a saii bitni. Tihnin kah na hmuh Egypt rhoek he koep hmuh ham kumhal duela na khoep uh voel mahpawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />BOEIPA loh nangmih ham a vathoh bitni, nangmih duem om uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah BOEIPA loh Moses te, “Balae tih kai taengah na pang, Israel ca rhoek te thui pah lamtah ana cet uh saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang te na conghol thoh lamtah tuipuei soah na kut thueng laeh. Tuipuei te a phih daengah ni Israel ca te tuipuei khui kah laiphuei dongah a caeh uh eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai kamah long ni Egypt lungbuei te ka moem pah. Amih te a hloem vaengah ni Pharaoh so neh a caem boeih so lamloh, a leng so neh a marhang caem so lamloh kamah ka thangpom uh eh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pharaoh so neh a leng soah a marhang caem soah kamah ka thangpom uh vaengah kai Yahweh he Egypt loh a ming bitni ,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Israel lambong hmai ah aka cet Pathen puencawn khoe uh tih amih hnuk la cet. Cingmai tung khaw amih hmai lamloh thoeih tih amih hnuk ah pai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Egypt lambong laklo neh Israel lambong laklo la pawk. Cingmai khaw a hmuep la om dae khoyin ah sae. Te dongah khoyin khing a taengla pha thai pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah Moses loh a kut te tuipuei soah a thueng tih BOEIPA loh tuipuei te khoyin puet khothoeng yilh tlung neh a yah pah. Te dongah tuipuei te lanhak la poeh tih tui te phik uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah Israel ca rhoek te tuipuei laklung kah laiphuei dongah cet uh tih tui khaw amih ham a banvoei neh a bantang ah vongtung la a om pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Egypt rhoek a hloem uh vaengah Pharaoh kah marhang leng boeih neh a marhang caem khaw amih hnukah tuipuei tuilung la kun uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mincang khopo a pha vaengah BOEIPA loh hmai tung neh cingmai dong lamloh Egypt lambong te a dan tih Egypt lambong te a khawkkhek.
  </para>
  <para style="p">
    <verse number="25" style="v" />A leng dongkah lengkho te a tling pah tih hnorhih la a hmaithawn. Te dongah Egypt loh , “Israel mikhmuh lamloh rhaelrham pawn sih, BOEIPA loh amih ham Egypt a vathoh thil,” a ti.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah BOEIPA loh Moses te, “Tuipuei soah na kut te thueng lamtah tui loh Egypt neh a leng neh a marhang caem soah et saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Moses loh a kut te tuipuei soah a thueng tangloeng tih mincang vikvak ah tuipuei khaw amah thim la mael. Te long te amah coeng dongah Egypt rhoek khaw rhaelrham uh dae BOEIPA loh Egypt rhoek te tuipuei khui la a khoek.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tui a mael vaengah leng neh marhang caem te a et pah. Amih hnuk ah tuipuei la aka pawk Pharaoh caem boeih te pakhat pataeng sueng pawh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Israel ca rhoek tah tuipuei tuilung kah laiphuei dongah cet uh tih tui te amih kah a banvoei, a bantang ah vongtung la pah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tekah khohnin ah BOEIPA loh Israel te Egypt kut lamkah a khang tangloeng tih Israel loh tuipuei tuikaeng ah Egypt a duek te a hmuh.
  </para>
  <para style="p">
    <verse number="31" style="v" />BOEIPA tanglue kut neh Egypt soah a saii te Israel loh a hmuh. Te daengah pilnam loh BOEIPA te a rhih tih BOEIPA neh a sal Moses te a tangnah uh.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses neh Israel ca rhoek loh BOEIPA taengah he laa he a sak uh. Te vaengah,” A phul la aka phul marhang neh a soah aka ngol khaw tuipuei khuila a phok coeng dongah BOEIPA te ka hlai eh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Pathen he kai ham ka sarhi neh BOEIPA laa neh khangnah la om. A pa Pathen amah te ka uem vetih amah te ka pomsang ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />BOEIPA tah caemtloek hlang coeng tih, a ming tah Yahweh ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pharaoh kah leng neh a caem te tuipuei la a dong pah tih a boeilu hlangrhoei te carhaek tuipuei ah a buek sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuidung loh amih te a thing tih a laedil ah lungto bangla suntla.
  </para>
  <para style="p">
    <verse number="6" style="v" />BOEIPA nang kah bantang kut tah thadueng neh thangpom uh tih, BOEIPA nang kah bantang kut loh thunkha khaw a noi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na hoemdamnah cangpai lamloh nang aka thoh thil khaw, na koengloeng tih na thinsa na tueih vaengah, amih te divawt bangla a hlawp.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na hnarhong dongkah yilh lamloh tui hol uh tih, tuipuei tuilung ah tuidung aka dok uh tuisih khaw som bangla pai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thunkha long tah ka hloem vetih ka kae vaengah ka hinglu a cung hil amih te kutbuem la ka tael ni. Ka cunghang te ka yueh vetih ka kut loh amih a pang bitni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na hil neh na hmuh tih tuipuei loh amih a khuk vaengah tah tui khuet khuiah kawnlawk bangla buek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Namah bangla pathen rhoek lakli ah unim aka om?BOEIPA aw, namah bangla hmuencim ah unim a thangpom? Khobaerhambae a saii bangla koehnah khaw rhih om pai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na bantang kut na thueng vaengah amih te diklai loh a dolh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilnam na tlan te na sitlohnah neh na mawt vetih na tolkhoeng cim la na sahri neh na khool ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pilnam loh a yaak vetih tlai uh ni. Philistia khosa rhoek te bungtloh loh a kawlek ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Edom khoboei rhoek te let uh vetih Moab ngalhatung rhoek te thuennah loh a tuuk ni. Kanaan khosa rhoek khaw boeih paci uh ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na ban tanglue lamloh amih soah mueirhih neh birhihnah khaw tla ni. BOEIPA namah kah pilnam a khum hil, na lai pilnam a khum hil lungto bangla kuemsuem uh bitni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amih te na khuen vetih na rho tlang dongah na phung ni. BOEIPA aw te hmuen ah khosak ham na saii tih ka Boeipa kah rhokso khaw namah kut long ni a saii.
  </para>
  <para style="p">
    <verse number="18" style="v" />BOEIPA ni kumhal ham a manghai yoeyah eh?,” a ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah Pharaoh kah marhang tah amah kah leng neh a marhang caem te khaw tuili khuila kun uh. Te dongah BOEIPA loh amih soah tuipuei tui te a mael sak. Tedae Israel ca rhoek tah tuipuei tuilung kah laiphuei dongah cet uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Aaron ngannu, tonghmanu Miriam loh a kut dongah kamrhing a muk. A hnukah manu boeih khaw kamrhing neh lamnah neh ha pawk uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah amih te Miriam loh , “Marhang te phul la phul cakhaw a sokah aka ngol te tuili khuila a phok coeng dongah lah BOEIPA te hlai uh pai,” tila a doo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah Moses loh Israel te carhaek tuipuei lamloh a khuen tih Shur khosoek la pawk uh. Tedae hnin thum caeh kah khosoek ah tah tui hmu uh voel pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Marah la a pawk vaengah khaw Marah tui te khahing tih ok la lo pawh. Te dongah a ming khaw Marah a sui uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah pilnam te Moses taengah nul uh tih, “Balae n'ok eh?” a ti uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae BOEIPA taengah pang tih BOEIPA loh a thuinuet thing te tui khuila a voeih daengah tui khaw tui. Anih ham oltlueh neh laitloeknah ni pahoi a khueh pah tih pahoi a noemcai coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah, “BOEIPA na Pathen ol te na yaak rhoe na yaak tih a mikhmuh ah a thuem la na saii atah a olpaek te hnakaeng lamtah a oltlueh te boeih tuem. Nang aka hoeih sak he BOEIPA kamah. Te dongah Egypt soah tlohtat cungkuem ka khuen te nang soah ka khueh mahpawh,” a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Elim la pawk uh tih tuiphuet tui hlai nit neh rhophoe sawmrhih ana om. Te dongah tui taengah pahoi rhaeh uh.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Elim lamloh cet uh tih Israel ca rhaengpuei boeih tah Sin khosoek la pawk uh. Elim laklo neh Sinai laklo te Egypt kho lamloh a thoh uh phoeikah a hla bae hnin hlai nga dongah a phauh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Israel ca rhaengpuei boeih te khosoek kah Moses taeng neh Aaron taengah nul khaw nul uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel ca rhoek loh amih rhoi te, “BOEIPA kut ah kaimih duek sak ham n'khueh pawt nim ca? Egypt kho ah maeh am dongah mamih n'ngol uh tih kodam la buh ka caak uh vaengah hlangping boeih he khokha neh duek sak ham maco he khosoek la kaimih nang khuen,” a ti uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah BOEIPA loh Moses te, “Kai loh nangmih ham vaan lamkah buh kan tlan sak ne. Pilnam te cet saeh lamtah hnin at ka a rhoeh te amah khohnin ah yoep uh saeh. Ka olkhueng dongah a pongpa neh a pongpa pawt khaw amah ka noem dae eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A rhuk hnin dongla a pha vaengah hang khuen te soepsoei uh saeh. Te vaengah tah a hnin, hnin kah a yoep lakah rhaepnit lo saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Moses neh Aaron loh Israel ca boeih te, “BOEIPA loh nangmih Egypt kho lamkah n'khuen te hlaemhmah vaengah na ming uh bitni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mincang ah BOEIPA kah thangpomnah te na hmuh uh bal bitni. BOEIPA soah nangmih kah kohuetnah te amah loh a yaak. Tedae kaimih rhoi taengah na nul la na nul uh te kaimih rhoi tah ulae?” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Moses loh , “BOEIPA loh nangmih he hlaem kah caak ham maeh neh mincang ah buh kodam la m'paek ham vaengah na kohuetnah neh amah taengah na nul te BOEIPA loh a yaak coeng. Te dongah kaimih rhoi he ulae? Nangmih kah kohuetnah te kaimih rhoi taengah pawt tih BOEIPA taengah ni na kohuet uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Moses loh Aaron taengah, “Israel ca rhaengpuei boeih te, 'Nangmih kah kohuetnah te a yaak coeng dongah BOEIPA mikhmuh la na tawn uh laeh,’ ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aaron loh Israel ca rhaengpuei boeih te a voek vaengah khosoek la a mael uh hatah BOEIPA thangpomnah te cingmai khuiah tarha tueng uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel ca rhoek kah kohuetnah te ka yaak. Amih te thui pah. 'Hlaem ah maeh na caak uh tih, mincang ah buh na hah uh ni,’ ti nah. Te vaengah kai Yahweh he na Pathen la nan ming uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hlaem a pha tangloeng vaengah tah tanghuem ha pawk tih rhaehhmuen te a thing. Mincang ah rhaehhmuen kaepvai kah buemtui te a khaan a om pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae buemtui kah a khaan a cing nen tah khosoek cirhong ah a kueluek a tham aka yit tarha om tih diklai ah vueltling bangla om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah Israel ca rhoek loh a hmuh uh. Te dongah hlang loh a manuca taengah,” Manna la he,” a ti uh. Te te balae ti a ming uh pawt dongah Moses loh amih te, “He kah buh he BOEIPA loh nangmih taengah cakkoi la m'paek coeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />He ham he BOEIPA loh ol n'uen coeng. Hlang loh amah caak rhoeh ah rhut saeh. Na hinglu tarhing ah hlangmi pakhat ham kosai pakhat van saeh. Hlang he amah dap ah aka om tarhing ah khuen sak uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te te Israel ca rhoek loh a ngai uh van tih baeko baepet lam khaw a rhuh uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kosai dongah a loeng uh tih baepet hoei pawt tih baeko lam khaw vaitah pawh. Hlang loh amah caak rhoeh ah a coi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Moses loh amih te, “Hlang khat long khaw te te mincang hil la paih boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Moses ol te hnatun uh pawt tih hlang rhoek loh te te mincang hil a paih uh. Te vaengah a rhiit a poem pah tih a rhim dongah amih taengah Moses a thintoek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah tah mincang, mincang bueng ah te te a rhuh uh. Hlang takuem loh amah caak rhoeh ah a rhuh dae khomik a bae vaengah a yut pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hnin rhuk a lo vaengah tah buh te hlang pakhat ham kosai panit a rhaep la a rhuh uh. Te dongah rhaengpuei khoboei boeih tah cet uh tih Moses taengah puen uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah amih te, “He he BOEIPA loh a thui coeng. Thangvuen tah BOEIPA ham koiyaeh Sabbath cim la om. Te dongah hai koi te hai uh lamtah thong koi te thong uh. A coih boeih te namamih ham rhoe uh lamtah mincang hil tuemkoi la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Moses loh a uen bangla mincang hil a rhoe uh tangloeng vaengah rhim pawt tih a khuiah a rhit khaw om pawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah Moses loh , “Tihnin ah te te ca uh, Sabbath he BOEIPA kah khohnin ni. Tihnin ah ngawn tah diklai ah te te na hmu uh mahpawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hnin rhuk khuiah ni te te na rhuh uh eh. Tedae a rhih hnin tah Sabbath coeng tih te vaengah om mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah a rhih hnin a pha vaengah rhuh hamla pilnam te mop uh dae hmu uh pawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah BOEIPA loh Moses te, “Ka olpaek neh ka olkhueng tuem ham he me hil nim na aal ve?
  </para>
  <para style="p">
    <verse number="29" style="v" />BOEIPA loh nangmih taengah Sabbath m'paek te hmu uh. Te dongah a rhuk hnin ah nangmih te hnin hnih caak te m'paek. A rhih hnin ah tah hlang he amah hmuen ah khosa saeh lamtah hlang pakhat khaw amah hmuen lamloh cet boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah pilnam khaw a rhih hnin ah duem van.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te kah ming te Israel imkhui loh manna la a khue. Te te sungsin tii bangla bok tih a tuihlim tah khoitui buhrhawm bangla om.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah Moses loh , “He ol he BOEIPA long ni n'uen. Te te kosai a bae la na cadilcahma ham tuemkoi la om saeh. Te daengah ni Egypt kho lamloh nangmih kang khuen vaengkah khosoek ah nangmih buh kan cah te a hmu uh eh,” a ti.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah Moses loh Aaron te, “Am pakhat lo lamtah manna kosai a bae la pahoi sang. Te te na cadilcahma duela tuemkoi la BOEIPA mikhmuh ah tawn pah,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />BOEIPA loh Moses taengah a uen bangla tuemkoi ham Aaron te laipainah hmai ah a khueh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Khosak nah khohmuen la a pawk uh hil kum sawmli khuiah Israel ca rhoek manna te a caak uh. Kanaan khohmuen a bawtnah la a pawk uh hil manna te a caak uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kosai parha te cangnoek khat lo ni.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Israel ca rhaengpuei boeih tah BOEIPA olka bangla a longpueng kah Sin khosoek lamloh hlah uh tih Rephidim ah rhaeh uh. Te vaengah pilnam kah a ok ham tui om pawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah pilnam te Moses neh toh uh thae tih, “Kaimih he tui m'pae lamtah ka o pawn eh,” a ti uh. Te vaengah amih te Moses loh , “Balae tih kai te nan toe uh?Balae tih BOEIPA na noemcai? a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae pilnam tah tui hal oeh. Te dongah pilnam te Moses taengah nul uh tih, “Balae tih Egypt lamloh kaimih nang khuen. Kamah neh ka ca rhoek neh ka tuihalh neh duek sak ham maco,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Moses te BOEIPA taengah pang tih, “Pilnam ham he balae ka saii eh ? Bet ca koinih kai n'dae uh hloe,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah BOEIPA loh Moses te, “Pilnam hmai ah lamhma lamtah Israel kah a ham rhoek te namah neh puei uh. Sokko na boh nah na conghol te na kut dongah pom lamtah cet.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamah he na mikhmuh kah Horeb lungpang soah ka pai ne. Lungpang te taam lamtah te lamloh tui ha phuet vaengah pilnam loh o saeh,” a ti nah. Te te Moses loh Israel a ham rhoek mikhmuh ah a saii pah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah Israel ca rhoek kah tuituknah neh BOEIPA te a noemcai uh tih, “BOEIPA he mamih lakli ah om nim, om pawt nim?” a ti uh dongah a hmuen ming te Massah neh Meribah a sui.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Rephidim ah tah Amalek ha pawk tih Israel a vathoh thil.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Moses loh Joshua taengah, “Mamih ham hlang coelh laeh, khuen lamtah Amalek te tloek laeh. Thangvuen ah kai he som lu ah ka pai ni, ka kut ah Pathen kah conghol om ngawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amalek te vathoh thil ham Moses loh amah a ti nah bangla Joshua loh a saii tangloeng. Moses, Aaron neh Hur tah tlang som lu la luei uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moses loh a kut a thoh rhuet vaengah tah Israel loh a na dae a kut a hlak rhuet vaengah tah Amalek a na.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae Moses kut a kha vaengah tah lungto a loh uh tih a dangah a phaih pauh. Te phoeiah a soah ngol tih a kut te Aaron neh Hur loh khatben ah pakhat, khatben ah pakhat loh a moem pah. Te daengah a kut rhoi te khomik a tlak hil khuek om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Joshua loh Amalek neh a pilnam te cunghang ha neh a rhaa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah BOEIPA loh Moses te, “Poekkoepnah he cabu dongah daek lamtah Joshua hna ah dueh pah. Amalek poekkoepnah te vaan hmui lamloh ka khoe rhoe ka khoe ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah Moses loh hmueihtuk a suem tih a ming te BOEIPA tah ka rholik la a khue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah, “Caemtloek BOEIPA kah ngolkhoel dongah kut ka phuel dongah BOEIPA loh Amalek te cadilcahma lamloh cadilcahma duela vathoh thil saeh,” a ti.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen loh Moses ham neh a pilnam Israel ham a cungkuem a saii pah tih BOEIPA loh Israel Egypt lamkah a khuen te Moses masae, Midian khosoih Jethro loh a yaak.
  </para>
  <para style="p">
    <verse number="2" style="v" />A maan hnukah Moses yuu Zipporah loh Moses masae Jethro te a doe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah a ca rhoi te a khuen tih, kholong kho ah yinlai la ka om a ti dongah pakhat te a ming Gershom a sui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pakhat te tah a pa Pathen he kai bomkung la om tih Pharaoh cunghang lamloh kai n'huul a ti tih a ming Eliezer a sui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Moses yuu, ca rhoek te a masae Jethro neh Pathen kah tlang khosoek ah aka rhaeh Moses taengla ha pawk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Moses te, “Na masae kai Jethro he nang taengla na yuu neh a taengkah a ca rhoi khaw, kam pawk puei coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moses te a masae doe ham cet tih bakop tih a mok. Te vaengah hlang te a hui neh sadingnah khaw a dawt uh rhoi phoeiah dap khuila kun uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Israel kongmai dongah BOEIPA loh Pharaoh taeng neh Egypt taengah a saii boeih, longpueng ah amih aka mah bongboepnah cungkuem neh BOEIPA loh amih a huul te khaw Moses loh a masae taengah a thui pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Egypt kut lamloh a huul vaengah BOEIPA loh Israel ham a then boeih a saii pah dongah Jethro a kohoe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah Jethro loh , “Egypt kut lamkah neh Pharaoh kut lamloh nangmih aka huul tih Egypt kut hmui lamloh pilnam aka huul BOEIPA tah a yoethen pai saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amih taengah ol a lokhak pah coeng dongah pathen boeih lakah BOEIPA he tanglue tila ka ming coeng,” a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Moses masae Jethro loh hmueihhlutnah neh hmueih te Pathen taengah a khuen. Te vaengah Aaron neh Israel kah a hamca boeih tah Pathen mikhmuh ah Moses masae neh buh ca la ha pawk.
  </para>
  <para style="p">
    <verse number="13" style="v" />A vuen ah pilnam te laitloek ham Moses ngol tih pilnam te Moses taengah mincang lamloh kholaeh hil pai uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pilnam ham a saii boeih te Moses masae loh a hmuh tih, “Pilnam ham na saii hno he mebang lae?Nang namah bueng na ngol vaengah pilnam pum he balae tih na taengah mincang lamloh kholaeh hil a pai,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah Moses loh a masae te, “Pathen dawtlet ham ni pilnam loh kai taengla ha pawk.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amih taengah te olka a om vaengah kai taengah ha pawk. Te vaengah hlang pakhat neh a hui laklo ah lai ka tloek tih Pathen kah oltlueh neh a olkhueng te ka ming sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah a masae loh Moses te, “Hno na saii te then pawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Namah neh na taengkah pilnam he khaw na tawn la na tawn uh coeng. Namah ham rhih aih tih dumlai khaw namah bueng loh na rhoe thai moenih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka ol he ngai laeh, nang kang uen lah eh. Pathen he nang taengah om saeh. Namah te Pathen hmai ah pilnam yueng om lamtah olka te namah loh Pathen taengla khuen saw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah amih te oltlueh neh olkhueng khaw thuituen lamtah a pongpa ham longpuei neh a saii ham bibi te amih tueng saw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah namah loh pilnam pum khui lamloh Pathen aka rhih tatthai hlang, mueluemnah aka thiinah oltak kah hlang rhoek te so. Amih te thawng khat kah mangpa, yakhat kah mangpa, sawmnga kah mangpa neh parha kah mangpa la khueh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A tue boeih dongah pilnam te laitloek pah saeh. Dumlai aka om boeih khaw a puei mah nang taengla ham pawk puei saeh. Olka a phoeng boeih tah amih loh laitloek pah saeh. Te vaengah nang ham yanghoep saeh lamtah nang te n'yingyawn uh saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ol he na ngai daengah ni Pathen loh nang uen bangla na pai thai vetih pilnam boeih he khaw a hmuen te ngaimong la a paan eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Moses loh a masae ol te a hnatun tih a thui te boeih a saii.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Moses loh Israel boeih khuiah hlang tatthai rhoek te a coelh tih amih te pilnam soah a lu, thawngkhat kah mangpa, yakhat kah mangpa, sawmnga mangpa neh parha kah mangpa te a paek.
  </para>
  <para style="p">
    <verse number="26" style="v" />A tue boeih ah pilnam te a lai a tloek uh tih dumlai aka kuel te Moses taengla a khuen uh. Ol phoeng boeih tah amih loh lai a tloek uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Moses loh a masae te a phih tih anih te amah kho la voei.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel ca rhoek Egypt kho lamloh a nong phoeikah hla thum dongah a om khohnin ah Sinai khosoek la pawk uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Rephidim lamloh hlah uh tih Sinai khosoek la pawk uh. Khosoek kah a rhaeh uh vaengah Israel tah tlang dan ah pahoi rhaeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Moses tah Pathen taengla cet. Te dongah BOEIPA loh anih te tlang lamloh a khue tih, “He he Jakob imkhui te thui pah lamtah Israel ca taengah puen pah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Egypt taengah ka saii te na hmuh uh coeng. Nangmih te atha phae dongah kam phueih tih kamah taengla nangmih kang khuen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah ka ol he na ngai rhoe na ngai tih ka paipi na tuem atah pilnam cungkuem khui lamloh kamah taengah lungthen la na om uh ni. Diklai pum khaw kamah kah ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah nangmih te kamah taengah khosoih ram neh hlangcim namtu la na om uh ni. He ol he Israel ca taengah thui pah,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Moses te mael tih pilnam kah a hamca rhoek te a khue. Te vaengah BOEIPA loh amah ol a uen boeih te amih mikhmuh ah a phoe pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah pilnam pum loh huek a doo tih, “BOEIPA kah a thui te boeih ka saii uh ni,” a ti uh. Te dongah Moses loh pilnam kah ol te BOEIPA taengla a mael puei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah BOEIPA loh Moses taengah, “Kai tah nangmih taengah cingmai khomai neh ka pawk coeng he. He kong nen ni kai neh nang m'voek uh vaengah pilnam loh a yaak eh. Te vaengah nang soah khaw kumhal duela n'tangnah uh bitni,” a ti nah. Te vaengah Moses loh pilnam kah ol te BOEIPA taengla a puen pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah BOEIPA loh Moses te, “Pilnam taengah cet lamtah tihnin neh thangvuen ah amih te ciim lamtah a himbai te til uh saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A thum khohnin ah tah sikim la om uh saeh. A thum hnin ah BOEIPA tah pilnam pum mikhmuh ah Sinai tlang la ha rhum ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pilnam te a kaepvai ah rhi suem pah lamtah, “Nangmih te tlang la luei neh a rhi te ben ham khaw ngaithuen uh, tlang aka ben boeih tah duek rhoe duek ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />A soah kut loh taek boel saeh. Tedae dae la dae saeh lamtah kap khaw kap saeh. Jubilee la a sol vaengah tlang la aka cet te tah rhamsa khaw hlang khaw hing boel saeh,’ ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Moses te tlang lamloh pilnam taengla suntla tih pilnam te a ciim phoeiah a himbai te a til uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah pilnam te, “A thum hnin ah sikim la om uh lamtah huta taengla mop uh boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />A thum hnin kah mincang a pha tangloeng vaengah rhaek ol neh cingmai a thah loh tlang soah om. Te vaengah tuki ol te bahoeng tlungluen tih rhaehhmuen kah pilnam khaw boeih lakueng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathen doe ham Moses loh pilnam te rhaehhmuen lamkah a khuen tih tlang yung ah pai uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />BOEIPA te hmai neh a rhum dongah Sinai tlang khaw a pum la khuu. A hmaikhu te hmailing hmaikhu bangla luei tih tlang a pum la muep lakueng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuki ol khaw ha thoeih tih bahoeng len. Moses loh a voek vaengah Pathen loh a ol neh a doo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah BOEIPA tah Sinai tlang kah tlang soi la ha rhum. Te phoeiah BOEIPA loh Moses te tlang soi la a khue tih Moses khaw cet hang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae BOEIPA loh Moses te, “Suntla lamtah pilnam te rhalrhing sak, BOEIPA hmuh ham koengloeng uh vetih amih te cungku uh khungdaeng ve.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khosoih rhoek pataeng khaw BOEIPA taengla aka mop rhoek ciim uh saeh. Amih taengah BOEIPA pung ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah Moses loh BOEIPA taengah, “Namah loh kai he na rhalrhing sak tih, 'Tlang te suem lamtah ciim laeh,” na ti coeng dongah Sinai tlang la pilnam a yoeng ham a coeng moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah BOEIPA loh amah te, “Cet laeh, suntla lamtah namah khaw Aaron khaw namah neh ha puei uh. Tedae khosoih rhoek neh pilnam tah BOEIPA taengla caeh ham koengloeng uh boel saeh. Amih taengah pung ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Moses te pilnam taengla suntla tangloeng tih amih te a thui pah.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen loh ol cungkuem he a thui tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai na Pathen Yahweh loh nang te Egypt kho kah sal im lamloh kang khuen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka mikhmuh ah a tloe pathen te nang ham om boel saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Namah ham mueithuk neh vaan so lamkah khaw, diklai hman neh a dang lamkah khaw, tui khui neh a dang lamkah muei cungkuem te diklai ah saii boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te rhoek taengah bakop boel lamtah amih taengah thothueng boeh. Kai Yahweh, nang kah Pathen, thatlai Pathen loh kai aka hmuhuet taengah tah, pa rhoek kathaesainah te ca rhoek soah khongthum neh khongli hil ka cawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai aka lungnah tih ka olpaek aka tuem taengah tah a thawng thawng la sitlohnah tueng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na Pathen Yahweh ming te a poeyoek la muk boeh. A ming a poeyoek la aka muk te BOEIPA loh a hmil moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sabbath hnin te ciim hamla poek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hnin rhuk thotat lamtah na bitat te boeih saii.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae a rhih hnin tah na BOEIPA Pathen ham Sabbath ni. Na bitat cungkuem dongah, na capa khaw, na canu khaw, na salpa khaw, na salnu khaw, na rhamsa khaw, na vongka kah yinlai khaw tueih boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />BOEIPA loh vaan neh diklai, tuitunli neh a cungkuem he hnin rhuk ah a saii dae a rhih hnin ah duem. Te dongah BOEIPA loh Sabbath hnin te yoethen a paek tih a ciim.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na nu neh na pa te thangpom. Te daengah ni na Pathen Yahweh loh nang taengah m'paek diklai ah na hinglung a vang eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hlang ngawn boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Samphaih boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huen boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na hui te laithae laipai neh doo boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na hui kah im te nai boeh. Na hui kah a yuu, a sal neh a salnu khaw, a vaito neh a laak khaw, na hui kah boeih te nai boeh,” a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah pilnam boeih loh olthang neh hmaithoi, tuki ol neh tlang kah a khuu te a hmuh uh. Pilnam loh a hmuh vaegah hinghuen uh tih a hla la pai uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Moses taengah, “Namah loh kaimih taengah thui lamtah ka hnatun uh bitni. Pathen loh kaimih taengah thui boel saeh, ka duek uh ve,” a ti uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Moses loh pilnam te, “Nangmih noemcai ham Pathen ha pawk kong ah rhih uh boeh. Te kong nen ni na maelhmai ah amah hinyahnah om vetih na tholh uh pawt eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah pilnam a hla la pai tih Moses tah Pathen om nah yinnah taengla thoeih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah BOEIPA loh Moses te, “He he Israel ca rhoek taengah thui pah, vaan lamloh nangmih taengah ka thui te na hmuh uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai neh thuidoek ham te saii uh boeh. Cakben pathen neh sui pathen khaw namamih ham saii uh boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kai hamla diklai hmueihtuk saii lamtah a soah na hmueihhlutnah neh na rhoepnah khaw, na boiva neh na saelhung khaw nawn uh. Hmuen cungkuem ah ka ming ka thoelh vaengah nang taengla ka pawk vetih nang yoethen kam paek ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kai hamla lungto hmueihtuk na saii atah a soah lungrhaih khoeng boeh. A soah na cunghang na hnonah koinih hmueihtuk ni na poeih eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka hmueihtuk kah tangtlaeng soah yoeng boeh. A soah na yah te poelyoe boeh.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah laitloeknah he amih mikhmuh ah khueh pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hebrew sal te na lai atah kum rhuk thotat saeh lamtah kum rhih hlang dongah tah sayalh la cet yungyi saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah bueng hoengpoek la ha pawk atah amah bueng hoengpoek la cet saeh. A yuu a va a om atah a yuu khaw amah neh cet saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />A boei loh anih te yuu a paek tih anih ham canu capa a sak atah a yuu neh a ca tah a boei kah ni. Tedae amah te amah bueng hoengpoek la cet saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae sal loh , “Ka boei ka lungnah tih ka yuu neh ka ca he sayalh la ka coe tak mahpawh a ti khaw a ti khaming.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah anih te a boei loh Pathen mikhmuh la khuen saeh lamtah thohkhaih taeng neh rhungsut taengla thoeih saeh. Te vaengah a boei loh a hna te ciphuem neh vueh pah saeh kumhal ham anih taengah thotat saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah hlang loh a canu te sal la a yoih atah, sal tongpa a caeh bangla cet mahpawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A boei mik ah a thae atah anih te amah ham tuentah saeh lamtah lat saeh. Salnu taengah a hnukpoh coeng dongah salnu te kholong pilnam taengla yoih ham taemrhai boel saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Salnu te a capa ham a tuentah coeng atah anih te amah canu kah hamsum bangla saii pah saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah ham te a tloe a loh atah, salnu kah a maeh, a himbai neh a hutakoe te hnop pah boel saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />He pathum he anih ham a saii pah pawt atah, tangka mueh la cet yungyi pawn saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang a boh tih a duek atah amah khaw duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih loh rhaem ngawn pawt dae Pathen loh anih kut ah a rhul sak oeh atah nang ham hmuen ka khueh vetih te lam te rhaelrham bitni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae hlang loh a hui te ngawn ham taengnah neh a lokhak atah anih te ka hmueihtuk dong lamloh khuen lamtah duek saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A manu a napa aka taam khaw duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlang aka huen neh te te a yoih vaengah a kut ah a hmuh pah khaw duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A manu a napa aka tap khaw duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hlang rhoi te oelh uh rhoi tih hlang pakhat loh a hui te lungto neh, kuthluem neh a thuk dae duek pawt tih thingkong dongah a yalh atah,
  </para>
  <para style="p">
    <verse number="19" style="v" />thoo tih poeng ah a conghol neh a pongpa atah anih aka ngawn te hmil mai saeh. A bipoei phu tah pae saeh lamtah hoeih rhoe hoeih sak saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang loh a salpa neh a salnu te conghol neh a taam tih a kut hmuiah a duek atah a phuloh ham te a phulo kuekluek saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae hnin hnih hnin at neh a thoh atah anih te amah tangka coeng dongah phulo boel saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang a hnueih vaengah huta bungvawn te a si tih a ca te thoeng mai ni. Tedae yoethae puei pawt cakhaw huta kah a va amah lamloh a hoe te tah sah rhoe sah saeh. Tedae rhokhan tarhing la pae saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae yoethae a puei atah hinglu ham te hinglu na paek van ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mik yueng mik, no yueng no, kut yueng kut, kho yueng ah kho,
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmai-ung yueng hmai-ung, tloh yueng tloh, boengha yueng boengha van saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hlang loh a salpa mik a salnu mik te a ngawn pah tih a rhawp sak atah a mik yueng te sayalh la hlah saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A salpa no neh a salnu no te a hom sak atah a no yueng anih te sayalh la hlah saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vaito loh tongpa khaw, huta khaw a thoeh tih a duek atah vaito te dae rhoe dae saeh lamtah a saa te ca boel saeh. Tedae vaito kungmah tah ommongsitoe ngawn saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae vaito te hlaem hlavai ah khaw a toh noek dongah a kungmah te a rhalrhing sak lalah ngaithuen pawt tih tongpa khaw huta khaw a duek sak atah vaito te dae saeh lamtah a kungmah khaw duek saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih taengah tlansum a suk atah te lamloh a hoe boeih te a hinglu kah tlansum pae van saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Capa a thoeh akhaw canu khaw a thoeh akhaw hekah laitloeknah bangla a taengah saii saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vaito loh salpa khaw, sal huta khaw a thoeh atah a boei te tangka shekel sawmthum pae saeh lamtah vaito te dae saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hlang loh tangrhom khaw a ong tih hlang loh rhom khaw a vueh vaengah te te muek pawt tih vaito khaw laak khaw a cungku atah,
  </para>
  <para style="p">
    <verse number="34" style="v" />Tangrhom kungmah loh thuung saeh lamtah a boei te tangka la mael saeh. Tedae aka duek te anih hut la om saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hlang pakhat kah vaito loh a hui kah vaito te a si tih a duek atah vaito hing te yoi rhoi saeh lamtah a tangka te tael uh rhoi saeh. Te phoeiah aka duek te khaw tael uh rhoi saeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae hlaem hlavai ah khaw vaito kah a toh noek te a ming lalah a kungmah loh te te a khoem pawt atah vaito yueng te vaito neh thuung rhoe thuung saeh lamtah aka duek te anih hut la om saeh.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlang loh vaito khaw, tu khaw a huen tih a ngawn akhaw, a yoih akhaw vaito ham te saelhung panga neh tu ham boiva pumli neh thuung saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Umlawt ah hlanghuen a hmuh tih a boh vaengah a duek atah a taengah thii kap boel saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khomik a thoeng atah a soah thii kap saeh lamtah aka huen loh sah rhoe sah saeh. A khueh pawt atah a huen dongah amah khaw yoi uh saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />A huen te a kut dongah a hmuh la a hmuh atah vaito khaw, laak khaw, tu khaw a hing neh rhaepnit la sah saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hlang loh lohma neh misurdum a laem sak vaengah a rhamsa te a hlah tih a rhamsa loh a tloe lohma li te a laem pa atah a khohmuen lamkah a then, a misurdum kah aka then neh thuung saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmai puek tih hling a dom vaengah canghlom neh canghli khaw, lohma khaw, a hlawp atah hmai aka hlong loh sah rhoe sah saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang loh a hui te tangka khaw hnopai khaw khoembael sak ham a paek. Tedae im lamkah te hlang loh a huen tih hlanghuen te a hmuh atah a rhaep la thuung saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlanghuen te a hmuh pawt atah a hui kah hno dongah a kut hlah pawt cakhaw im kung te Pathen taengla kun saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Boekoeknah olka cungkuem dongah vaito khaw, laak khaw, tu khaw, himbai khaw, he hnohma ni a ti boeih tah a panit la Pathen mikhmuh ah ol hang khuen saeh. Pathen kah a boe sak long te tah a hui te a rhaep la sah saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlang loh a hui taengah laak neh vaito, tu neh rhamsa cungkuem khaw dawn ham a paek dae, duek mai tih tlawt mai ni, a hmuh pawt vaengah khaw a mawt pah khaming.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah a hui kah hnopai soah a kut hlah pawt ham amih rhoi laklo aBOEIPA kah olhlo om saeh. A kungmah long khaw doe saeh lamtah sah boel saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae anih taeng lamloh a huen la a huen atah a kungmah te sah saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te te a ngaeh rhoe a ngaeh tila laipai hang khuen atah saha te sah boel saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang loh a hui taeng lamkah a vat dae a taengah a kungmah a om pawt vaengah a khaem sak tih a duek atah sah rhoe sah saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A kungmah te a taengah a om atah sah boel saeh. Te te a kutloh coeng atah a thapang neh mael saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />tongpa loh oila a bae mueh te a yoek tih a taengah a yalh atah a yuu la oei rhoe oei saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A napa loh hula te anih taengah paek ham a aal la a aal atah oila kah maan bangla tangka thuek pah saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hlangbi khaw hing sak boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rhamsa taengkah aka yalh boeih tah duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yahweh amah bueng taeng pawt ah pathen tloe rhoek taengah aka nawn tah thup saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yinlai khaw vuelvaek boeh, Egypt kho ah yinlai la na om uh coeng dongah nen boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nuhmai neh cadah boeih tah phaep boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na phaep la na phaep tih kai taengah a pang la a pang atah a pangngawlnah te ka hnatun rhoe ka hnatun pah ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah ka thintoek sai vetih nangmih te cunghang neh kang ngawn ni. Na yuu rhoek te nuhmai la, na ca rhoek khaw cadah la om uh ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih taengkah ka pilnam mangdaeng te tangka na hlah pah atah a taengah puhlah bangla om boeh. Anih te a casai khueh pah boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na hui kah himbai te na laikoi la na laikoi atah khomik a khum hlan ah amah taengla mael laeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A himbai khaw te kah himbai bueng ni a vin sokah a himbai dongah metlam a yalh eh? Ka lungvatnah oeh dongah ka taengla a pang vaengah ka hnatun pah ni ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathen te thaephoei boeh, na pilnam sokah khoboei khaw thaephoei thil boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na thaihhmin neh na tuihuem khaw hloh thil boeh, na ca caming khaw kamah taengla m'pae.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na vaito taeng neh na boiva taengah khaw saii tangloeng. Hnin rhih khuiah a manu neh om saeh lamtah hnin rhet dongah tah kamah taengla m'pae.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />A poeyoek kah olthang khuen boeh. Kuthlahnah kah laipai la om ham halang neh na kut hlaengtang boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Boethae dongah tah hlangping hnuk khaw om boeh. Kaengyai taengah hlangping neh kaengyai ham tuituknah dongah doo boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tattloel long khaw a tuituknah dongah n'hiin boel saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na thunkha kah vaito khaw, a laak khaw a kho a hmaang te na hmuh atah amah taengla mael rhoe mael puei.
  </para>
  <para style="p">
    <verse number="5" style="v" />A taengah na tlo-oeng la na tlo-oeng mai cakhaw na lunguet kah laak te a hnorhih dangah a kol te na hmuh atah anih taengah na tlo-oenng te khaw toeng laeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na taengkah khodaeng te a tuituknah dongah a laitloeknah phaelh pah boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A honghi olka lamloh lakhla lamtah halang he ka tang sak pawt dongah ommongsitoe neh aka dueng khaw ngawn boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kapbaih khaw lo boeh, kapbaih loh miktueng khaw a dael sak tih a dueng ol khaw a paimaelh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yinlai khaw nen boeh, Egypt kho ah yinlai la na om van dongah yinlai kah hinglu te namah dongah ming puei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na khohmuen te kum rhuk tawn lamtah a vueithaih khaw coi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae a kum rhih te hmil lamtah haai sak. Te daengah ni na pilnam khodaeng loh a caak vetih a noi te khohmuen mulhing loh a caak. Na misurdum ham na olive ham khaw te te saii.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hnin rhuk khuiah na bibi te saii lamtah a rhih hnin ah duem dae. Na vaito neh na laak khaw duem vetih na salnu kah a ca neh yinlai khaw a thasai ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangmih taengah a cungkuem la ka thui te ngaithuen uh. Pathen tloe rhoek ming khaw phoei uh boeh, Na ka dongah ya uh boel saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kum khat ah kai ham khotue voei thum lam uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang kan uen bangla vaidamding khotue te tuem uh lamtah hnin rhih khuiah vaidamding ca uh. Egypt lamloh na hlah uh vaengkah Abib hla te khoning la om vetih ka mikhmuh ah kuttling la ha phoe boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khohmuen na tawn te na bibi dongkah thaihcuek, cangah khotue neh kum boeih kah khohmuen lamloh na bibi na khoem vaengah cangyom khotue om ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na khuikah tongpaca boeih tah kum khat ah voei thum Boeipa Yahovah mikhmuh ah phoe saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai kah hmueih thii te tolrhu neh nawn boeh. Ka khotue kah maehtha khaw mincang duela rhaeh boel saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na khohmuen kah thaihcuek tanglue te na BOEIPA Pathen kah im la khuen. Ma-ae ca te a manu suktui neh thong boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Longpuei ah nang aka ngaithuen ham neh ka hmoel hmuen hil nang aka khuen ham na mikhmuh ah puencawn kan tueih coeng ne.
  </para>
  <para style="p">
    <verse number="21" style="v" />A mikhmuh ah ngaithuen lamtah a ol te hnatun. Anih te veet boeh, kai ming he a khui ah om coeng tih nangmih kah boekoeknah te duen mahpawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ol te na hnatun rhoela na hnatun tih ka thui te boeih na ngai atah na thunkha te ka thunkha nah vetih nang aka daengdaeh te ka dum van ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka puencawn he nang hmai ah pongpa vetih nang te Amori neh Khitti taengla, Perizzi neh Kanaan taengla, Khivee neh Jebusi taengla n'thak vetih amih te ka thup ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amih kah pathen taengah bakop boel lamtah amih taengah thothueng boeh. Amih kah khoboe bangla saii boeh. Te rhoek te koengloeng rhoe koengloeng lamtah a kaam te phaek la phaek pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />BOEIPA na Pathen taengah tho na thueng daengah ni na buh neh na tui khaw a yoethen vetih na khui lamkah tlohtat te kang khoe eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na khohmuen ah thangyah neh caya khaw om pawt vetih na khohnin kah a tarhing te ka cup sak ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kai taengkah mueirhih te na hmai ah ka tueih vetih a taengla na thoeng thil pilnam boeih te ka khawkkhek ni. Na thunkha boeih te nang taengah a rhawn ka duen sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nang mikhmuh ah khoingal te ka tueih vetih Khivee, Kanaan neh Khitti te na mikhmuh lamloh ka haek ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kum khat nen tah na mikhmuh lamloh anih te ka haek mahpawh. Khohmuen te khopong la om vetih na taengah kohong mulhing pung aih ve.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na pungtai hil na mikhmuh lamloh bet bet ka haek daengah ni khohmuen te na pang eh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na khorhi te carhaek tuipuei lamloh Philisti tuipuei duela, khosoek lamloh tuiva duela kan suem bitni. Khohmuen kah khosa rhoek te na kut ah kam paek vetih amih te na mikhmuh lamloh ka haek ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amih taeng neh amih kah pathen taengah paipi saii boeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na khohmuen ah khosa uh boel saeh, kai taengah na tholh ve. A pathen taengah tho na thueng atah na taengah hlaeh la poeh van ni.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses taengah, “Namah neh Aaron, Nadab, Abihu neh Israel khuikah a ham rhoek sawmrhih te BOEIPA taengah ha mop lamtah lakhla la bakop uh saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae Moses amah bueng te BOEIPA taengah mop saeh. Amih te mop uh boel saeh lamtah pilnam khaw a taengla cet uh boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Moses te cet tih BOEIPA ol boeih neh laitloeknah boeih te pilnam taengah a thui pah. Pilnam pum loh ol pakhat la a doo uh tih, “BOEIPA loh a thui ol te boeih ngai uh sih,” a ti uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moses loh BOEIPA ol te boeih a daek. Mincang ah thoo tih tlang hmuiah hmueihtuk neh Israel koca hlai nit kah kaam hlai nit a suem.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Israel ca cadong te a tueih tih hmueihhlutnah te a khuen uh. Te vaengah BOEIPA taengah rhoepnah hmueih la vaito a nawn uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moses loh thii rhakthuem te a loh tih baeldung dongah a khueh tih thii rhakthuem te hmueihtuk a haeh thil.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah paipi cabu a loh tih pilnam kah hna ah a tae. Te dongah, “BOEIPA kah a thui boeih te ka saii uh vetih ka hnatun uh bitni,” a ti uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Moses loh thii te a loh tih pilnam a haeh thil. Te vaengah, “Paipi thii he BOEIPA loh he ol cungkuem neh nangmih taengah a saii coeng ne,” a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Moses neh Aaron, Nadab neh Abihu neh Israel kah a hamca sawmrhih rhoek te koep cet uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Israel Pathen kah a kho hmui te minhum laiboeng kutngo bangla, vaan khocil phek la a hmuh uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Israel ca hlangcong rhoek te a kut thueng thil pawh. Te dongah Pathen a hmuh uh lalah a caak uh tih a ok uh bal pueng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah BOEIPA loh Moses te, “Tlang soah kamah taengla ha luei lamtah pahoi om laeh. Amih thuinuet ham olkhueng neh olpaek ka daek thil lungto cabael te nang taengah kam pae eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Moses neh a taengah aka thotat Joshua tah thoo tih Moses te Pathen kah tlang dongla luei.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hamca rhoek te khaw, “Nangmih taengla ka mael hil he ah he kai n'rhing uh. Aaron neh Hur khaw nangmih taengah om ngawn he ne. U khaw Olka dongah laikung long tah amih rhoi taengla mop saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Moses te tlang la a luei van neh cingmai loh tlang te a thing.
  </para>
  <para style="p">
    <verse number="16" style="v" />BOEIPA kah thangpomnah tah Sinai tlang ah pai tih cingmai loh hnin rhuk a dah. A hnin rhih dongah tah Moses te cingmai khui lamloh a khue.
  </para>
  <para style="p">
    <verse number="17" style="v" />BOEIPA thangpomnah mueimae khaw Israel ca rhoek kah mik ah tah tlang som aka hlawp hmai bangla tueng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah Moses te cingmai khui la kun tih tlang la luei. Moses te tlang ah khothaih sawmli neh khoyin sawmli om.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel ca rhoek te thui pah lamtah hlang boeih lamkah khosaa te kai taengla hang khuen uh saeh. A lungbuei kah a puhlu bangla kai kah khosaa te doe pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khosaa he amih taeng lamkah sui neh cak neh rhohum khaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hlampai a thim, daidi, a lingdik khaw, hnitang neh maae mul khaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />Tutal pho thimyum neh saham pho khaw rhining thing khaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />Botui hmaivang ham neh koelhnah situi ham neh botui bo-ul ham situi khaw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hnisui neh rhangpho dongkah ham oitha lung neh saboi lung khaw coi laeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah kai ham rhokso saii uh lamtah a khui ah ka om eh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai loh nang boeih kan tueng vanbangla dungtlungim muei neh a hnopai boeih kah muei te khaw saii tangloeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rhining thing te thingkawng a yun dong nit neh tintan, a daang dong khat neh a tintan, a sang dong khat neh tintan ah saii uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah a khui ah sui cilh ben lamtah a hman ah khaw ben. A sokah a kong te a kaep ah sui neh saii pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah sui te a kutcaeng pali la hlawn lamtah a kho pali te buen pah. Te vaengah khat ben kah a vae dongah kutcaeng panit, pabae kah a vae dongah kutcaeng panit buen pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah rhining thing te a cung la saii lamtah sui ben thil.
  </para>
  <para style="p">
    <verse number="14" style="v" />A cung te thingkawng vae kah a kutcaeng khuila rholh lamtah te nen te thingkawng kawt saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thingkawng kutcaeng dongah a cung om saeh lamtah te lamloh dul boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah nang taengah kam paek ham laipainah te thingkawng khuiah khueh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A tlaeng khaw sui cilh neh a yun dong nit tintan neh a daang dong khat tintan ah saii.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sui cakhli te cherubim rhoi la saii bal lamtah te rhoi te thingkawng tlaeng kah a hmoi rhoi ah khueh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cherub pakhat te he kah a hmoi ah, cherub pakhat tekhat ben kah a hmoi ah khueh lamtah a tlaeng te a hmoi rhoi ah cherubim te saii pah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cherubim aka om rhoi loh a phae te a so la phuel saeh lamah a phae neh thingkawng tlaeng soah khu rhoi saeh. Te vaengah pakhat loh a manuca taengah a maelhmai hmaitoh saeh lamtah cherubim maelhmai te tingkawng tlaeng taengah mael saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tlaeng te thingkawng soah a so la tloeng lamtah nang taengah olphong kam paek te thingkawng khuiah khueh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Teah te nang kan tuentah vetih Israel ca rhoek ham nang kang uen olphong cungkuem te thingkawng tlaeng so lamkah cherubim rhoi laklo lamloh nang taengah kan thui ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rhining thing te caboei a yun dong nit, a daang dong khat, a sang dong khat tintan la saii.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te te sui cilh neh ben thil lamtah te ham te a kaepvai kah a kong te sui neh saii pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kae ham te a kaep ah kutsom pakhat khueh lamtah a kae dongkah a kaep ah a kong te sui neh saii.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te ham te sui kutcaeng pali saii lamtah kutcaeng te a kho pali dongkah a kil pali ah bang pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kutcaeng rhoek te a kae voeivang ah caboei aka kawt ham a cung rholhnah la om saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A cung te rhining thing saii bal lamtah sui ben thil. Te nen te caboei kawt saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bael neh yakbu neh tui-um neh tuisi-am khaw saii. Sui cilh neh te rhoek te saii lamtah te rhoek nen te tuisi doeng saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka mikhmuh kah a hmai buh te caboei soah khueh yoeyah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hmaitung te sui cilh cakben neh saii bal. Hmaitung kah a hlit neh, a kong, a bunang, a paimuem khaw saii pah lamtah te lamloh a rhaiphuelh te om saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hmaitung te a kaep lamloh a kong parhuk cawn saeh. A vae khat lamloh hmaitung kong pathum neh a vae pabae lamloh hmaitung a kong pathum cawn saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />A kong pakhat dongah rhaimuem rhaiphuelh neh noepai bunang pathum, a kong pakhat dongah khaw rhaimuem rhaiphuelh neh noepai bunang pathum om saeh lamtah hmaitung lamkah aka cawn aka kong parhuk dongah khaw om tangloeng saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah hmaitung dongkah rhaimuem rhaiphuelh neh noepai bunang he pali lo saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hmaitung lamloh a kong parhu a thoeng dongah te lamkah a kong rhoi hmuiah rhaimuem pakhat, a kong panit hmui bal ah rhaimuem pakhat, a kong panit hmuiah khaw rhaimuem pakhat om bal saeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te lamkah a rhaimuem neh a kong te a pum la sui cilh cakben neh pakhat la om saeh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hmaithoi parhih saii bal lamtah hmaithoi te tok pah. Te vaengah a hmai rhalvang ah khaw tue saeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />A paitaeh neh a baelphaih khaw sui cilh saeh.
  </para>
  <para style="p">
    <verse number="39" style="v" />He hnopai boeih he amah sui cilh talent khat he saii saeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tedae so lamtah tlang ah nang a muei kan tueng bangla saii,” a ti nah.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah dungtlungim te hlampai lingdik, daidi neh a thim neh a tah hnitang himbaiyan yung rha neh saii. Bibi te moeh lamtah cherubim te saii.
  </para>
  <para style="p">
    <verse number="2" style="v" />Himbaiyan pakhat a yun te dong kul dong rhet saeh lamtah a daang dong li saeh. Himbaiyan boeih ham himbaiyan pakhat kah cungnueh pakhat dongah om saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himbaiyan panga te khat neh khat cong uh saeh lamtah, himbaiyan panga bal khat neh khat cong uh saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himbaiyan pakhat kah buenyang a bawt hil te a hmoi ah rhuikawl a thim la vaeh pah. A pabae rhui at dongkah himbaiyan a hmoi dongah khaw a bawt hil te tlam te saii bal.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himbaiyan pakhat dongah rhuikawl sawmnga saii lamtah a pabae rhui at dongkah himbaiyan hmoi ah pumpi sawmnga khaw saii pah. Rhuikawl te khat loh khat te doe saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah sui rhuithu sawmnga saii lamtah himbaiyan pakhat te pakhat dongla rhuithu neh phaai sak. Te dongah dungtlungim te pakhat la om saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dungtlungim sokah tamkui ham te maae mul himbaiyan saii. Himbaiyan te hlai khat ah saii.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himbaiyan pakhat te a yun dong sawmthum neh a daang te dong li lo ni. Himbaiyan hlai khat ham te himbaiyan pakhat kah cungnueh pakhat dongah om saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himbaiyan panga te amah ah cong lamtah himbaiyan parhuk te amah ah cong bal. Te phoeiah a parhuk kah himbaiyan te dap hmai kah imdan ah rhaep pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himbaiyan pakhat kah a hmoi ah buenyang a bawt hil rhuikawl sawmnga saii lamtah a pabae kah himbaiyan a hmoi ah buenyang te rhuikawl sawmnga khueh pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah rhohum rhuithu sawmnga saii lamtah rhuithu te rhuikawl neh ban pah. Dap te phaai uh saeh lamtah pakhat la om saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dap kah himbaiyan lamloh a hoei saa la aka hoei himbaiyan ngancawn te dungtlungim kah imthael ah dingkoei saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah dap kah himbaiyan a yun aka hoei te he ben ah dong khat neh ke ben ah dong khat tah dungtlungim kah a vae ah a hup om saeh lamtah khat ben ah khaw khat ben ah khaw khuk saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah dap kah imphu te tutal pho thimyum neh a so kah imphu la saham pho te saii thil.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dungtlungim kah a longlaeng la rhining thing aka pai te saii.
  </para>
  <para style="p">
    <verse number="16" style="v" />A yun kah a longlaeng te dong rha neh a daang kah a longlaeng pakhat he dong khat tintan lo saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A longlaeng dongkah dangkam rhoi khaw pakhat te a pakhat dongah kiba uh saeh. Dungtlungim a longlaeng boeih ham khaw te tlam te saii tangloeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dungtlungim ham a longlaeng te tuithim ben la tuithim kah a ngong ham tah a longlaeng pakul saii.
  </para>
  <para style="p">
    <verse number="19" style="v" />A longlaeng pakul dangah cak buenhol sawmli saii pah. A longlaeng pakhat ka a lo panit ham a dangah buenhol panit om vetih a longlaeng pakhat a lo rhoi ham a dangah buenhol panit om ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dungtlungim kah impalai ham khaw a pabae la tlangpuei saa ah a longlaeng pakul om saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A buenhol sawmli te khaw cak la om saeh. A longlaeng pakhat dangah buenhol panit, a longlaeng pakhat dang van ah khaw buenhol panit om van saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dungtlungim kah a bawtnah ham te tuipuei ben ah a longlaeng parhuk caeh sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Imthael ben ah dungtlungim kah a hmuidong ham a longlaeng panit khueh pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah a dang lamloh tungbok la om saeh. Tedae a soi ah hmabuet la rhen om saeh lamtah kutcaeng pakhat khuila kun saeh. Te rhoi kah a om bangla imki rhoi dongah khaw om saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah a longlaeng parhet neh a buenhol te cak buenhol la hlai rhuk lo ni. A tlonglaeng pakhat kah dongah buenhol panit, a longlaeng pakhat van donngah khaw buenhol panit tlip om ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dungtlungim kah impalai pakhat dongkah a longlaeng ham thohkalh la rhining thing panga khueh pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dungtlungim pabae ben impalai kah a longlaeng ham thohkalh panga, khotlak imthael ah khaw dungtlungim kaep a longlaeng ham khaw thohkalh panga lo saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A longlaeng laklung kah thohkalh tah a hmoi khat lamloh a hmoi hil a bangli ah rholh saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />A longlaeng te khaw sui ben thil. Thohkalh rholhnah a kutcaeng te khaw sui neh saii. Te phoeiah thohkalh rhoek te sui ben thil.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tlang ah a rhimong n'tueng bangla dungtlungim te thoh pah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hniyan khaw hlampai a thim, daidi neh a lingdik neh loeih pah. Hnitang na tah khaw bibi te moeh lamtah cherubim te saii pah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te te ngun buenhol pali sokah sui a ben thil rhining tung pali dongkah sui voei dongah pae.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hniyan te rhuithu dangah na ban phoeiah tah hniyan khui ah olphong thingkawng te pahoi kun puei . Te vaengah hniyan loh nangmih ham te hmuencim laklo neh hmuencim kah hmuencim koek laklo te phih saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />A tlaeng te khaw hmuencim lakah hmuencim kah olphong thingkawng soah khueh pah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hniyan kah kawtpoeng ah caboei te hol pah. Dungtlungim kaep tuithim kah caboei danah hmaitung om saeh lamtah tlangpuei ben ah caboei te khueh bal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dap Thohka ham himbaiyan khaw hlampai a thim, daidi, a lingdik neh tak lamtah hnitang na tah khaw na kutci neh en thil.
  </para>
  <para style="p">
    <verse number="37" style="v" />Himbaiyan ham rhining tung panga ah saii lamtah te te sui ben thil. Te sui voei ham khaw rhohum buenhol panga hlawn pah.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rhining thing hmueihtuk a yun dong nga neh a daang dong nga ah saii. Hmueihtuk te hniboeng la om saeh lamtah a sang te dong thum lo saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah a ki te a kil pali ah saii pah. Te lamkah a ki aka om khaw rhohum ben thil.
  </para>
  <para style="p">
    <verse number="3" style="v" />A duen ham a am neh a hmaisoh khaw, a baelcak neh a ciksum khaw, a baelphaih khaw saii, a hnopai boeih te rhohum mah saii.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rhohum vairhuek dongkah kutngo la pahak saii lamtah vairhuek dongkah a hmoi pali ah rhohum kutcaeng pali saii pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te te hmueihtuk kong dangah a laedil la khueh lamtah vairhuek te hmueihtuk boengli hil om saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah rhining thing thingpang te hmueihtuk ham a cung la saii lamtah te te rhohum ben thil.
  </para>
  <para style="p">
    <verse number="7" style="v" />A cung te kutcaeng khuila rholh lamtah hmueihtuk a koh vaengah a cung a vae rhoi ah om saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te te thingphael aka khui neh saii lamtah tlang ah nang n'tueng bangla saii tangloeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuithim ben ah dungtlungim vongup ham tuithim thoh te thung pah. Te vaengah vongtung hamla hnitang te a yun dong yakhat ah a hmoi pakhat la rhuih tah pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tung pakul neh a buenhol pakul te rhohum saeh lamtah tung dongkah voei neh a yaeltlang te ngun saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tlangpuei ben ah khaw thoh te a yun la a yun yakhat lo van saeh. A tung bal khaw a tung pakul neh a buenhol pakul tah rhohum vetih tung dongkah voei neh a yaeltlang te ngun saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khotlak ben kah vongtung la thoh a daang dong sawmnga lo saeh. A tung parha neh a buenhol khaw parha lo saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vongtung kah a daang te khocuk khothoeng ben ah dong sawmnga lo saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hlaep kah thoh te dong hlai nga vetih a tung pathum neh a buenhol khaw pathum saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pabae a hlaep ah khaw thoh dong hlai nga neh a tung pathum, a buenhol pathum om saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vongtung vongka kah himbaiyan ham te dong kul ah a thim, daidi neh hlampai lingdik neh hnitang la tah pah. Kutci neh en thil lamtah a tung pali neh a buenhol pali lo saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vongup kaepvai kah tung boeih te cak neh cen saeh. A voei khaw cak saeh lamtah a buenhol te rhohum saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vongtung kah a yun te dong yakhat vetih a daang dong sawmnga, sawmnga lo ni. Te vaengah a sang dong nga ah hnitang la tak saeh lamtah a buenhol tah rhohum saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dungtlungim kah hnopai boeih neh a thothuengnah boeih dongkah khaw, a ciphuem boeih neh vongtung hlingcong boeih te rhohum saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Namah loh Israel ca rhoek te uen lamtah hmaithoi dongah hmaivang la phat tok ham olive situi cil a sui te nang taengla hang khuen uh saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Laipainah hmai, hniyan vongvoel kah tingtunnah dap ah te Aaron neh anih koca rhoek loh BOEIPA mikhmuh ah hlaem lamloh mincang hil te te tael uh saeh. He he Israel ca taengkah a cadilcahma ham kumhal kah khosing ni.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Namah loh Israel ca rhoek khui lamkah na maya Aaron neh a taengkah anih ca rhoek te namah taengah khueh laeh. Aaron amah neh Aaron ca rhoek Nadab, Abihu, Eleazar neh Ithamar tah kamah taengah khosoih saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na maya Aaron ham himbai cim te thangpomnah neh boeimangnah la khueh pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Namah loh cueihnah mueihla ka cung sak tih lungbuei kah aka cueih boeih te thui pah. Te vaengah kai taengkah khosoih la aka ciim uh Aaron kah himbai te hui uh saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te himbai dongah rhangpho neh hnisui, hnikul neh kutthun angkidung, lupong neh lamko te saii uh saeh. Te vaengah kai taengah aka khosoih ham na manuca Aaron ham neh anih koca rhoek ham himbai cim saii uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amih loh sui neh a thim neh, daidi neh hlampai a lingdik neh hnitang khaw doe uh saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnisui te sui, a thim neh daidi, hlampai a lingdik neh kutci la a moeh tih a tah hnitang neh saii uh saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongkah a hmoi rhoi ah aka om te holhnam rhoi ah hlin saeh lamtah phaai uh saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pholip dongah cihin khaw a kutngo bangla amah dongah om saeh lamtah sui, a thim, daidi, hlampai a lingdik neh hnitang la tak saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah oitha lung panit te lo lamtah a soah Israel ca ming tarhit pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />A ming parhuk te lungto pakhat dongah ming parhuk vetih aka coih te lungto pabae dongah amamih kah rhuirhong bangla tarhit pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kutthai kutnaep, thingthuk lung kah kutbuen bangla lungto rhoi te tarhit. Te te Israel ca ming neh vael lamtah sui oibom dongah hol.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lungto rhoi te hnisui dongkah holhnam dongla Israel ca rhoek kah poekkoepnah lungto la hulh pah. Te vaengah Aaron loh amih ming te BOEIPA mikhmuh kah poekkoepnah la a laengpang rhoi ah vah saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah sui oibom saii.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sui cilh neh cangtui-rhaica te rhuinit hulh lamtah te te kutci neh rhuivaeh la khueh. Te phoeiah rhuivaeh cangtui-rhaica te oibom dongah khit.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnisui dongkah kutngo bangla laitloeknah rhangpho na saii khaw bibi la moeh. Te te sui neh hlampai, thim, daidi, a lingdik neh saii. Te phoeiah hnitang a tah neh te te saii thil.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te te yaep lamtah a yun khap at neh a daang khap at ah hniboeng la om saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te soah lungto hulhnah te a than pali la dueh. Than cuek te lungling, vaya neh tamkuei he lungto than at vetih,
  </para>
  <para style="p">
    <verse number="18" style="v" />A than bae dongah khocillung, minhum neh lungmik.
  </para>
  <para style="p">
    <verse number="19" style="v" />A than thum dongah oithii, khopang lung neh kemden,
  </para>
  <para style="p">
    <verse number="20" style="v" />A than li dongah timsuih, oitha neh maihae te sui cueh thil lamtah a hulhnah neh om saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lungto rhoek khaw Israel ca hlai nit ming la sum uh saeh. Kutbuen thingthuk dongkah a ming bangla hlang boeih he koca hlai nit dongah amah ming neh om uh saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rhangpho soah cangtui-rhaica cuehnah te sui cilh rhuivaeh neh kutnaep la saii.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rhangpho dongkah sui kutcaeng panit saii lamtah rhangpho kah a hmoi rhoi ah kutcaeng nit la buen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sui rhuivaeh rhoi te rhangpho hmoi kah kutcaeng rhoi dongla khih pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah rhuivaeh rhoi kah a hmoi rhoi te oibom rhoi dongla hlin lamtah a maelhmai hmai a hnisui dongah holhnam dongla khih pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah sui kutcaeng panit saii lamtah te te rhangpho kah a hmoi rhoi la khit. A hmuidong te hnisui saa dongah a khui la det.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah sui kutcaeng panit saii lamtah te te a hmai kah a dang, hnisui cihin sokah a rhui voeivang ah hnisui dongkah holhnam rhoi dongla khih pah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Rhangpho kah a kutcaeng lamloh hnisui kah kutcaeng duela a kutcaeng te pin saeh lamtah hnisui kah cihin duela hamnak thim neh om saeh. Te daengah ni hnisui dong lamkah rhangpho te khaw a hawl pawt eh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Aaron Israel ca ming te a lungbuei dongkah laitloeknah rhangpho dongah vah saeh lamtah hmuencim la a kun vaengah BOEIPA mikhmuh kah poekkoepnah la om yoeyah saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Laitloeknah rhangpho khuiah Urim neh Thummim khueh pah lamtah BOEIPA mikhmuh la a kun vaengah Aaron kah lungbuei ah om. Te vaengah Aaron loh Israel ca kah laitloeknah te BOEIPA mikhmuh ah a lungbuei ah phuei yoeyah saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hnisui hnikul te a thim la boeih saii.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hmoi a laklung ah a lu ham a rhai om saeh. A rhai kaepvai te rhawnmoep rhai a om bangla kutnaep la a yen neh om saeh. Te daengah ni a. pawn pawt eh.
  </para>
  <para style="p">
    <verse number="33" style="v" />A hnihmoi ah tale a thim, daidi neh hlampai a lingdik neh saii. A hmoi kaepvai te a laklo ah sui hling neh pin thalh saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hnikul kah hnihmoi dongah sui hling neh tale thaih, sui hling neh tale thaih pin bang pah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aaron soah thohtat ham om tih BOEIPA mikhmuh kah hmuencim la a kun vaengah a ol pa saeh. Te daengah ni a vuenva vaengah a duek pawt eh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah sui cilh tamlaep te saii lamtah a sokah kutbuen thingthuk te, “BOEIPA ham Cim,” tila thuk pah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te te hamrhui thim dongah khih pah lamtah lupong dongah om saeh. Lupong hmai ah ah om saeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah Aaron tal ah om vetih cimcaihnah dongah a ciim Israel ca rhoek kathaesainah te amih kah cimcaihnah kutdoe boeih te Aaron loh phuei saeh. Te daengah ni amih ham khaw a tal dongah BOEIPA mikhmuh kah kolonah la phat a om eh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hnitang angkidung te cueh lamtah hnitang lupong khaw saii. Te phoeiah lamko saii lamtah kutnaep la en.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aaron koca rhoek ham khaw angkidung khueh pah lamtah amih ham lamko saii pah. Samkhuem khaw amih thangpomnah ham neh boeimangnah ham saii pah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te te na maya Aaron neh a taengkah anih koca rhoek te bai sak lamtah amih te koelh. Amih kut te cung sak lamtah amih te ciim. Te phoeiah kai taengla khosoih uh saeh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amih ham a yah saa aka dah la takhlawk hnii saii pah lamtah a chinghen lamloh a phai duela dah saeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aaron neh anih koca loh tingtunnah dap khuila a kun uh vaengah khaw, hmuencim ah thohtat ham hmueihtuk la a mop uh vaengah puei uh saeh. Te daengah ni thaesainah a phueih vaengah a duek uh pawt eh. He he anih ham neh anih phoeikah a tiingan ham kumhal kah khosing coeng ni.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kamah taengah khosoih sak ham a ciim uh vaengah amih taengah he ol bangla saii. Te vaengah saelhung ca khuikah vaito pakhat neh tutal panit a hmabuet te khuen pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah vaidamding buh, situi neh a nom vaidamding laep, situi neh a koelh vaidamding rhawm te cangtang vaidam neh saii.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te rhoek te kodawn pakhat dongah sang lamtah kodawn khaw, vaito khaw, tutal rhoi khaw rhen khuen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah Aaron neh anih koca rhoek te tingtunnah dap thohka la khuen lamtah amih te tui neh sil.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah himbai te lo lamtah Aaron te angkidung neh hnisui hnikul khaw, hnisui neh rhangpho te bai sak lamtah hnisui dongkah cihin neh a pum dongah nan pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lu soah lupong muei sak lamtah lupong te cimcaihnah rhuisam khuem sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah koelhnah situi lo lamtah a lu ah suep lamtah anih te koelh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih koca rhoek te khaw hang kuen lamtah angkidung bai sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aaron neh a ca rhoek te lamko vah sak lamtah amih te samkhuem khuem sak. Te te khosoihbi dongah kumhal khosing la om saeh lamtah Aaron kut neh anih koca kah kut te cung sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vaitotal te tingtunnah dap hmai la khuen lamtah Aaron neh anih koca rhoek loh a kut te vaitotal lu soah tloeng saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah vaitotal te tingtunnah dap thohka kah BOEIPA mikhmuh ah ngawn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaito thii te lo lamtah na kutdawn neh hmueihtuk ki dongah pae. Te phoeikah thii boeih te hmueihtuk kah khoengim taengah hawk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah a kotak aka thing a tha boeih neh, a thin dongkah a thinhnun khaw, a kuel rhoi neh te dongkah a tha khaw lo lamtah hmueihtuk ah phum.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae vaito saa neh a pho khaw, a aek khaw, boirhaem rhaehhmuen voel ah hmai neh hoeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tutal pakhat te khuen bal lamtah Aaron neh anih koca rhoek loh a kut te tutal lu soah tloeng uh saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tutal te na ngawn phoeiah a thii te lo lamtah hmueihtuk kaepvai ah haeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah tu te maehpoel la sah. Tedae a kotak neh a kho te sil lamtah maehpoel neh a lu te khueh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tu a pum te hmueihtuk soah BOEIPA kah hmueihhlutnah la phum. Te te BOEIPA taengah hmuehmuei botui hmaihlutnah la om saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A pabae kah tutal te khuen bal lamtah Aaron neh anih koca rhoek loh a kut te tutal kah a lu soah tloeng saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tu te na ngawn phoeiah a thii te lo lamtah Aaron hna kah hnapae so neh a ca rhoek hna kah a bantang hnapae dongah khaw, kut kah bantang kutnu dongah khaw, a bantang kho kah khopuei dongah pae. Te phoeiah a thii te hmueihtuk kaepvai ah haeh thil.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah hmueihtuk sokah thii neh koelhnah situi te lo lamtah Aaron so neh a himbai soah khaw, amah taengkah anih koca rhoek so neh anih koca kah himbai soah khaw haeh pah. Te vaengah amah neh a himbai khaw, a taengkah amah koca rhoek neh anih koca rhoek kah himbai te ciim saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah tu tha neh a kawl, a kotak aka dah a tha neh a thin dongkah thinhnun khaw, a kuel rhoi neh te rhoi dongkah a tha khaw, bantang laeng he khaw tutal dongkah saboi la lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kodawn lamkah buh hluem at neh buh tha laep khat neh vaidamrhawm pakhat te BOEIPA mikhmuh ah vaidamding la om saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A cungkuem te Aaron kut dong neh anih koca rhoek kut ah tloeng lamtah te te BOEIPA mikhmuh ah thueng hmueih la thueng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah amih kut lamkah te lo lamtah BOEIPA mikhmuh kah hmueihtuk ah hmueihhlutnah neh hmuehmuei botui la phum. Te tah BOEIPA taengah hmaihlutnah la om saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Saboi tu kah a rhang te Aaron ham loh pah lamtah BOEIPA mikhmuh ah thueng hmueih la thueng pah. Te phoeiah nang ham maehvae la om saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thueng hmueih kah a rhang te a ciim phoeiah tah khosaa kah a laeng te thueng pah. Te te Aaron ham neh anih koca rhoek ham ni saboi tu lamloh a ludoeng pah.
  </para>
  <para style="p">
    <verse number="28" style="v" />He tah Israel ca rhoek taeng lamloh Aaron ham neh anih koca rhoek ham kumhal khosaa kah oltlueh la om saeh. Te khosaa tah Israel ca rhoek lamloh BOEIPA taengah amih kah khosaa la a nawn rhoepnah hmueih la om saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aaron kah cimcaihnah himbai khaw anih phoeikah amah koca rhoek ham om pah saeh. Te dongah amih te koelh saeh lamtah amih kut te khaw amamih ah cung saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />A ca rhoek khui lamloh anih yueng hmuencim ah thotat ham tingtunnah dap khuila aka kun khosoih loh hnin rhih khuiah te te bai saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Saboi tu te lo lamtah a saa te hmuen cim ah thong.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aaron neh anih koca rhoek loh tingtunnah dap thohka kah tu saa neh kodawn dongkah kah buh te ca saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah te te amih a dawth tangtae tih ciim hamla a kut aka cung long tah ca saeh. Tedae te te a cim dongah kholong loh ca boel saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae saboi maeh neh buh te mincang duela a coih atah a coih te hmai neh hoeh laeh. Te tah a cim dongah ca uh boel saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah nang kang uen boeih te Aaron ham neh anih koca rhoek ham saii lamtah amih kut te hnin rhih khuiah cung sak laeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dawthnah ham hnin at ham boirhaem vaito nawn lamtah te ham na dawth nen te hmueihtuk dongah ciim sak. Te phoeiah hmueihtuk te ciim hamla koelh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hmueihtuk ham hnin rhih khuiah dawth pah lamtah ciim. Te daengah hmueihtuk te a cim kah a cim koek la om vetih hmueihtuk neh aka ben uh boeih khaw a ciim eh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hmueihtuk soah na nawn te tah kum khat tu ca vetih hnin at ham pumnit yoeyah saeh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuca pakhat te mincang ah nawn lamtah tuca pabae te kholaeh ah nawn.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bunang pali la a sui situi neh a thoek vaidam doh, misurtui bunang pali neh tuca pakhat te tuisi la doeng.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuca pabae te tah kholaeh ah mincang khosaa neh tuisi la nawn. Te nen te BOEIPA taengah hmuehmuei botui hmaihlutnah la saii.
  </para>
  <para style="p">
    <verse number="42" style="v" />Na cadilcahma ham khaw tingtunnah dap thohka kah BOEIPA mikhmuh ah hmueihhlutnah la om yoeyah saeh. Te ah nang te pahoi voek ham namah pahoi kan tuentah bitni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Israel ca te khaw pahoi ka tuentah bal vetih ka thangpomnah loh a ciim ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tingtunnah dap neh hmueihtuk te ka ciim tangloeng vetih Aaron neh anih koca rhoek te kamah taengah khosoih sak ham ka ciim ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Israel ca rhoek lakli ah kho ka sak vetih amih taengah Pathen la ka om ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te vaengah Egypt kho lamloh amih aka khuen, amih kah Pathen Yahweh kamah he a ming uh bitni. Amih lakli ah kai Yahweh ni amih kah Pathen la ka om eh.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bo-ul hlupnah hmueihtuk na saii vaengah rhining thing mah saii.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmueihtuk te a yun dong khat neh a daang dong khat saeh lamtah hniboeng la om saeh. Amah lamloh a ki hil a sang dong nit lo saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te te a imphu khaw, a pangbueng neh a ki khaw, sui cilh neh pin ben thil. Te te a khopnah khaw sui neh pin saii.
  </para>
  <para style="p">
    <verse number="4" style="v" />A vae rhoi kah a khopnah hmui ah sui kutcaeng panit saii pah. A vae rhoi kah na saii phoeiah tah te kah te hmueihtuk aka kawt ham thingpang rholhnah la om saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thingpang te rhining thing saii lamtah sui neh ben thil.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmueihtuk te olphong sokah a tlaeng hmai, olphong thingkawng taengkah hniyan hmai ah khueh. Te ah ni nang te pahoi kan tuentah eh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah te Aaron loh mincang, mincang ah bo-ul botui phum saeh. Te te a rhoekbah vaengah khaw hmaithoi te tok saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aaron loh hlaemhmah kah hmaithoi a vang vaengah khaw bo-ul te phum saeh. Te te na cadilcahma ham khaw BOEIPA mikhmuh ah saii yoeyah saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te soah te kholong kah bo-ul neh hmueihhlutnah khaw khocang khaw khuen boeh. Te soah tuisi khaw doeng boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aaron loh kum khat ah vai tah hmueihtuk ki dongah boirhaem thii neh dawth saeh. Kum khat ah vai tah hmueihtuk dongah na cadilcahma ham dawthnah neh dawth pah saeh. Te tah BOEIPA ham a cim kah a cim koek ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel ca rhoek kah hlangmi te tae lamtah amih te soep. Te vaengah hlang boeih loh a hinglu kah tlansum te BOEIPA taengah pae uh saeh. Amih te ming a soep daengah ni a soep vanbangla tlohthae loh amih soah a om pawt eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ming soep ham aka paan boeih loh gerah pakul neh aka tluk hmuencim shekel te shekel ngancawn ah pae uh saeh. Shekel khat dong shekel rhakthuem he BOEIPA kah khosaa ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ming soep ham aka paan kum kul ca neh a so boeih long tah BOEIPA taengah khosaa pae saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na hinglu dawth ham BOEIPA kah khosaa na khueh te shekel pakhat kah rhakthuem lakah hlanglen long khaw pueh boel saeh lamtah tattloel long khaw hnop boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel ca rhoek taeng lamkah dawthnah tangka na doe te tingtunnah dap ah thothuengnah ham pae. Na hinglu aka dawth ham te BOEIPA mikhmuh ah Israel ca rhoek kah poekkoepnah la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="18" style="v" />Silh vaengkah ham rhohum baeldung khaw saii lamtah a kho khaw rhohum saeh. Te te tingtunnah dap laklo neh hmueihtuk laklo ah hol lamtah tui pahoi tawn thil.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te lamlong te Aaron neh anih koca rhoek loh a kut, a kho sil uh saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tingtunnah dap im khuila a kun uh vaengah tui hlu uh saeh. Te daengah ni BOEIPA taengah hmaihlutnah phum ham neh thohtat ham hmueihtuk la a thoeih vaengah a duek uh pawt eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kut a kho te a silh uh daengah ni a. duek uh pawt eh. Te dongah amah ham neh a tiingan ham khaw, a cadilcahma ham khaw kumhal kah oltlueh la amih taengah om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />BOEIPA loh Moses te a voek bal tih,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Namah bal loh namah ham boeilu botui murrah pi ya nga, thingsa botui yahnih sawmnga ngancawn, canhnam botui yahnih sawmnga,
  </para>
  <para style="p">
    <verse number="24" style="v" />valaeng khaw hmuencim kah shekel dongah ya nga neh olive situi bunang khat ah lo laeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah aka thungnom bibi kah yuhnah si bangla hmuencim koelhnah situi he saii lamtah hmuencim kah koelhnah situi la om saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te nen te tingtunnah dap neh olphong thingkawng khaw,
  </para>
  <para style="p">
    <verse number="27" style="v" />caboei neh a tubael boeih khaw, hmaitung neh a tubael khaw, bo-ul hmueihtuk khaw,
  </para>
  <para style="p">
    <verse number="28" style="v" />hmueihhlutnah hmueihtuk neh a hnopai boeih khaw, baeldung neh a kho te koelh pah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te rhoek te na ciim tangloeng daengah ni a. cim kah a cim la a om tih te te aka ben boeih khaw a cimcaih eh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aaron neh anih koca rhoek khaw koelh lamtah kamah taengah khosoih sak ham amih te ciim laeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Israel ca te khaw thui pah lamtah , “Hmuencim kah koelhnah situi he tah na cadilcahma duela kamah taengah om saeh,”ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hlang pum dongah yuh nah boel saeh lamtah te kah a lantang neh te bang te saii boeh. Te kah a cim te nangmih taengah khaw a cim la om saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te bang aka thungnom tih kholong taengah te aka pae hlang te tah a pilnam lamloh hnawt saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te phoeiah BOEIPA loh Moses te, “Namah ham botui aangpi neh khawphlawp khaw, botui tlangsungsing neh hmueihtui cil lo lamtah amah, amah om saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te te thungnom kutci loh cilrhik la a thoek, yuhnah bo-ul cim la saii.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te te a tip la neet lamtah tingtunnah dap khuikah olphong hmai ah khueh. Te ah te nang kan tuentah vetih nangmih ham hmuencim kah hmuencim koek la om ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te bo-ul na saii vaengkah a lan a tang neh namah ham saii boeh. BOEIPA ham namah taengah a cim om.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te te him ham te bang aka saii hlang te a pilnam lamloh hnawt saeh,” a ti nah.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Judah koca lamloh Hur capa Uri kah a ca, a ming ah Bezalel la ka khue he hmu ne.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih te Pathen mueihla lamloh cueihnah neh, lungcuei neh, mingnah neh bitat cungkuem ka kum sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sui neh ngun neh rhohum neh a saii te kopoek neh moeh saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lungto kutthaibibi neh cung sak ham neh thing kutthaibibi dongah khaw bitat cungkuem dongah saii ham ka khue.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai loh anih neh Dan koca kah Ahisamak capa Oholiab ka tuek coeng he ne. A lungbuei ah lungbuei kah a cueih cungkuem te cueihnah la ka paek tih nang kang uen te boeih saii uh saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tingtunnah dap neh olphong thingkawng khaw, a sokah a tlaeng neh dap dongkah hnopai boeih,
  </para>
  <para style="p">
    <verse number="8" style="v" />Caboei neh a tubael khaw, hmaitung tang neh a tubael boeih neh bo-ul hmueihtuk,
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmueihhlutnah hmueihtuk neh a tubael boeih, baeldung neh a kho khaw,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnithun himbai neh khosoih Aaron kah hmuencim himbai khaw, aka khosoih ham a ca rhoek himbai khaw,
  </para>
  <para style="p">
    <verse number="11" style="v" />koelhnah situi neh hmuencim kah bo-ul botui khaw nang kang uen bangla boeih a saii uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Namah loh Israel ca rhoek te voek lamtah, 'Ka Sabbath he kai laklo neh nang laklo kah miknoek la tuem. Na cadilcahma ham khaw nangmih aka ciim tah Yahweh kamah ni tila aka ming sak la om saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangmih ham a cim dongah Sabbath te tuem uh. Te te aka poeih tah duek rhoe duek saeh. Te vaengah bitat aka saii boeih khaw a hinglu te a pilnam khui lamloh hnawt pah saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnin rhuk khuiah bitat te saii saeh. Tedae hnin rhih dongkah koiyaeh Sabbath tah BOEIPA ham khaw cim saeh. Sabbath hnin ah bitat aka saii boeih tah duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Israel ca rhoek loh Sabbath te tuem saeh. Sabbath a saii te a cadilcahma ham khaw kumhal kah paipi la om saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai laklo neh Israel ca rhoek laklo ah kumhal kah miknoek la om ni. BOEIPA loh hnin rhuk ah vaan neh diklai a saii. Tedae hnin rhih dongah a toeng tih tha a sai sak ta,'ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih taengah a thui te a khah nen tah Sinai tlang ah Pathen kah kutdawn loh lungto cabael a daek tih olphong cabael panit la Moses taengah a paek.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pilnam loh tlang lamkah Moses a suntlak ham yak coeng tila a hmuh. Te dongah pilnam te Aaron taengla tingtun uh tih a taengah, “Thoo lamtah kaimih ham pathen saii laeh. Te te mamih hmai ah cet saeh. Egypt kho lamloh mamih aka khuen Moses he, hlang khaw a taengah mebang a om khaw m'ming uh moenih,” a ti uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Aaron loh amih te, “Na yuu rhoek, na canu, na capa hna dongkah sui hnaii te dul uh lamtah kai taengah hang khuen uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilnam pumloh a hna dongkah sui hnaii te a dul uh tih Aaron taengla a khuen uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amih kut lamkah a loh phoeiah tah te te cacung neh a dum tih vaito mueihlawn la a saii. Te phoeiah, “Israel nang kah pathen la he, he long ni Egypt kho lamloh nang ng'khuen he,” a ti uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aaron loh a hmuh vaengah a hmai ah hmueihtuk a suem. Te phoeiah Aaron loh a hoe tih, “Thangvuen ah BOEIPA taengah khotue om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A vuen ah thoo uh tih hmueihhlutnah a khuen uh. Rhoepnah a tawn phoeiah tah pilnam te ngol tih a caak a ok neh thoo uh tih nuei uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah BOEIPA loh Moses te, “Egypt kho lamkah na khuen na pilnam he a poci coeng dongah cet lamtah suntla laeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amih ka uen longpuei lamloh vilvak taengphael uh tih amamih ham mueihlawn vaito a saii uh. Te te a bawk uh tih te te a nawn uh. Te phoeiah, “Namah pathen long ni Israel khaw Egypt kho lamloh na khuen,” a ti uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah BOEIPA loh Moses te, “Pilnam he ka hmuh vaengah pilnam kah a rhawn khaw mangkhak rhoe he.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah kai he n'rhoe laeh. Ka thintoek he amih taengah sai vetih amih ka khap lah ve. Tedae nang te namtom taengah pilnu la kang khueh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Moses tah a Pathen BOEIPA neh a maelhmai te thae coeng. Tedae, “BOEIPA aw balae tih Egypt kho lamloh tanglue thadueng neh, tlungluen kut neh na khuen na pilnam taengah na thintoek khaw a sai eh?
  </para>
  <para style="p">
    <verse number="12" style="v" />Balae tih Egypt rhoek loh a thui mai eh? A thae la, “Amih te tlang ah ngawn ham neh amih te diklai hman lamloh khah ham ni amih a khuen,” ti ve. Na thintoek thinsa lamloh mael lamtah na pilnam sokah boethae khaw kohlawt mai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham te khaw, Isaak te khaw, na sal Israel te khaw poek mai. Namah loh amih taengah na toemngam tih amih te, 'Na tiingan te vaan aisi bangla, ka ping sak vetih khohmuen pum he na tiingan taengah ka paek vetih kumhal ham a pang uh ni,’ ka ti nah,” na ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah a pilnam soah boethae saii ham a thui tangtae te BOEIPA loh ko a hlawt.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te daengah Moses te mael tih a kut dongkah olphong cabael panit neh tlang lamloh suntla thuk. Cabael rhoi te a vae rhoi ah a daek pah tih khatben ah khaw khatben ah khaw a daek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te rhoi tah Pathen kah kutngo cabael coeng tih, Pathen kah a cadaek a cadaek te amah loh cabael dongah a daek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pilnam kah a o ol te Joshua loh a yaak van vaengah Moses te, “Rhaehhmuen kah caemtloek ol te,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae, “Thayung thamal aka doo ham ol pawt tih yawknah aka doo kah ol bal moenih. A doo ol ka yaak ngawn dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rhaehhmuen la a moe vaengah vaitoca neh a lam te a hmuh. Te dongah Moses kah thintoek te sai tih a kut te a voeih. Te dongah a kut lamkah cabael rhoi khaw tlang yung ah bok rhek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah vaitoca a saii uh te a loh tih hmai neh a hoeh. A tip la a neet phoeiah tui soah a phul tih Israel ca rhoek te a tul.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Moses loh Aaron te, “A taengah tholh len na khuen pah ham he pilnam loh nang taengah balae a saii?” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah Aaron loh , “Ka boeipa kah thintoek khaw sai boel mai dae saeh. Pilnam a thae aih khaw namah loh na ming.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai taengah, “Kaimih ham pathen saii lamtah te te mamih hmai ah cet bitni. Egypt kho lamloh mamih aka mawt hlang, Moses he a taengah metla a om khaw m'ming moenih,” a ti uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah amih te, “U khaw sui aka tah dul uh,” ka ti nah. Te vaengah kamah taengla m'paek uh tih hmai dongah ka pup hatah he vaitoca la poeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah pilnam te a hlahpham coeng tila Moses loh a hmuh. Amih aka tlai thil taengah Aaron loh nueih thaboep la a hlahpham dong ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah Moses tah rhaehhmuen vongka ah pai tih, “BOEIPA kah te tah kai taengla,” a ti nah hatah Levi koca boeih te anih taengla tingtun uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah amih te, “Israel Pathen BOEIPA loh he ni a. thui. Hlang loh a cunghang te a phai ah kaelh saeh. Cet saeh lamtah vongka lamloh vongka patoeng hil rhaehhmuen te hil saeh. Te vaengah a manuca hlang te khaw, a hui kah hlang khaw, a hmaiben hlang khaw ngawn saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah Moses ol bangla Levi koca rhoek loh a saii uh tih te hnin ah pilnam khuikah hlang thawng thum tluk cungku.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te daengah Moses loh , “Tihnin ah BOEIPA ham na kut han cung sak coeng. Hlang he a ca taengah khaw a manuca taengah khaw, tihnin ah nangmih te yoethennah m'paek pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />A vuen ah tah Moses loh pilnam te, “Nangmih he tholh len neh na tholh uh coeng dae BOEIPA taengah ka cet pawn vetih nangmih kah tholhnah ham ka dawth thai khaming,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Moses te BOEIPA taengla mael tih, “Pilnam he aw, amamih ham sui pathen a saii uh dongah tholh len neh tholh coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae amih kah tholhnah phuei mai laeh. Te pawt atah kai he na daek tangtae na cabu lamloh n'khoe mai laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae BOEIPA loh Moses taengah, “Kai taengah aka tholh te unim? Anih te ka cabu lamloh ka khoe bitni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah cet lamtah nang taengah kan thui bangla pilnam te mawt laeh. Ka puencawn loh na hmai ah cet bitni ne. Ka cawh khohnin ah ngawn tah amamih kah tholhnah bangla amamih soah ka cawh van bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aaron kah a saii bangla vaitoca te a saii uh dongah BOEIPA loh pilnam te a vuek.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses taengah, “He lamloh namah cet lamtah nong laeh. Egypt khohmuen lamkah na khuen pilnam te khohmuen la khuen laeh. Te te Abraham taengah, Isaak taeng neh Jakob taengah ka toemngam tih, “Na tiingan taengah ka paek ni,” ka ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang mikhmuh ah puencawn kan tueih vetih Kanaan neh Amori khaw, Khitti neh Perizzi, Khivee neh Jebusi khaw ka haek bitni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Suktui neh khoitui aka long khohmuen lam khaw na khui ah ka pongpa mahpawh. Pilnam he na rhawn mangkhak aih tih longpueng ah nang kang khap lah ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilnam loh ol thae he a yaak vaengah nguekcoi uh tih hlang loh a pum dongkah a cangen khaw oi uh pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah BOEIPA loh Moses taengah, “Israel ca rhoek te thui pah. Nangmih he rhawn thah pilnam ni. Na khui ah mikhaptok ah vai ka pongpa vetih nang kan thup ve. Na cangen khaw na pum dong lamloh pit laeh. Na taengah mebang ka saii ham khaw ka ming ngawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Israel ca rhoek loh a cangen te Horeb tlang ah a dul uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moses loh dap te a puen tih rhaehhmuen lamkah a lakhla la rhaehhmuen vongvoel ah amah la a tuk. Te te tingtunnah dap la a khue tih BOEIPA aka dawt boeih loh rhaehhmuen vongvoel kah tingtunnah dap te a paan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moses te dap la a caeh vaengah pilnam pum khaw thoo uh tih hlang he amah kah dap thohka ah pai uh. Te vaengah dap khuila a kun hil Moses hnuk te a paelki uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dap khuila Moses a kun van neh cingmai tung ha suntla. Te vaengah dap thohka ah pai tih Moses te a voek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dap thohka kah aka pai cingmai tung te pilnam loh boeih a hmuh. Te dongah pilnam te boeih thoo tih hlang he amah kah dap thohka ah ni a bakop uh coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah hlang loh a hui a voek bangla BOEIPA loh Moses te a hmai, hmai ah a voek. Te phoeiah rhaehhmuen la mael. Tedae anih kah tueihyoeih Nun capa cadong Joshua tah dap khui lamloh nong pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Moses loh BOEIPA te, “Namah loh kai taengah pilnam he khuen laeh,” na ti ne. Tedae kai taengah nan tueih ham te khaw kai nan ming sak moenih. Te vaengah namah loh , 'Na ming neh kan ming tih ka mik dongkah mikdaithen khaw na hmuh,’ na ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na mikhmuh ah mikdaithen ka hmuh van coeng atah na longpuei te kai m'ming sak laeh. Namah kan ming daengah man na mikhmuh ah mikdaithen khaw ka hmuh ve. Namtom he na pilnam la hmuh mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae, “Ka mikhmuh kah he a caeh uh daengah ni nang te kan duem sak eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah amah te, “Na mikhmuh kah te a caeh pawt atah he lamloh kaimih nan khuen pawt mako.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai neh na pilnam loh na mikhmuh ah mikdaithen ka hmuh te me nen nim a ming eh. Kaimih taengkah na pongpa nen pawt nim kai neh na pilnam tah diklai hman kah pilnam cungkuem lamloh ka hoep uh tangloeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah BOEIPA loh Moses te, “Ka mikhmuh ah mikdaithen na hmuh tih na ming neh kam ming dongah ol he na thui bangla ka saii bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah, “Na thangpomnah te kai m'hmuh sak laem,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah BOEIPA loh , “Ka thennah boeih he na mikhmuh ah ka phoe vetih na mikhmuh ah Yahweh ming he ka doek ni. Ka rhen tueng ni ka rhen vetih ka haidam tueng ni ka haidam eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae, “Ka maelhmai hmuh ham na coeng moenih, hlang loh kai m'hmu mai cakhaw a hing hae moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah BOEIPA loh , “Kamah taengkah hmuen ah he lungpang soah khaw pai mai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae ka thangpomnah loh a pah phai vaengah lungpang rhaep ah nang kang khueh ni. Te vaengah ka khum hil nang soah ka kut kang khuk bitni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka kut ka khoe van neh ka nam na hmuh ni. Tedae ka maelhmai tah tueng mahpawh,” a ti nah.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses taengah, “Namah loh lamhma kah bangla lungto cabael panit saek lamtah te cabael dongah lamhma kah aka rhek cabael dongah aka om ol te ka daek eh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mincang ah sikim la om lamtah mincang neh Sinai tlang la ha luei. Te phoeiah tlang lu ah kamah taengla pahoi pai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae na taengah hlang ha luei boel saeh lamtah hlang pakhat pataeng tlang tom ah phoe boel saeh. Boiva neh saelhung khaw tlang dan ah he luem uh boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah lungto cabael rhoi te lamhma kah bangla a saek. Mincang ah Moses te thoo tih BOEIPA loh amah a uen bangla Sinai tlang ah yoeng. Te vaengah lungto cabael rhoi te a kut dongah a pom.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah BOEIPA te cingmai neh ha rhum tih a taengah pahoi pai. Te vaengah BOEIPA ming neh a doek.
  </para>
  <para style="p">
    <verse number="6" style="v" />BOEIPA te a hmai ah a pah pah vaengah tah, “Yahweh, Yahweh, thinphoei neh lungvatnah Pathen, thintoek a ueh tih sitlohnah neh oltak dongah boeiping coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sitlohnah he thawngkhat ham khaw a kueinah dongathaesainah, boekoeknah neh dumlai khaw a phueih pah. Tedae pa rhoek kathaesainah a cawh pah te ca rhoek so neh ca kah ca rhoek soah khongthum khongli hil a hmil rhoe a hmil moenih,” tila tamhoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Moses tah diklai la koe buluk tih bakop.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae Moses loh, “Ka Boeipa aw na mik dongah mikdaithen la ka tueng mai khaming. Ka Boeipa kaimih khui ah pongpa laeh. Pilnam he a rhawn mangkhak sitoe cakhaw kaimih kathaesainah neh kaimih kah tholhnah te khodawkngai lamtah kaimih he m'pang mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Boeipa loh, “Kai loh na pilnam pum hmai ah paipi ka saii ne. Diklai pum neh namtom boeih taengah a suen pawh khobaerhambae te ka saii ni. Te vaengah a khui kah na pilnam boeih loh BOEIPA kah khoboe te hmuh saeh. Nang taengah ka saii te rhih pai saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tihnin ah nang kang uen te namah ham ngaithuen. Na mikhmuh lamloh, Amori neh Kanaan khaw, Khitti neh Perizzi khaw, Khivee neh Jebusi ka haek ne.
  </para>
  <para style="p">
    <verse number="12" style="v" />Namah khaw ngaithuen, khohmuen khosa rhoek neh paipi na saii ve ne. Namah khaw a khuila na kun vetih namah khui ah hlaeh la poeh ve.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hmueihtuk te palet pah lamtah a kaam te phaek pah. Anih kah Asherah khaw vung pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ming mah thatlai Yahweh coeng tih Pathen tah a thatlai thai dongah pathen tloe taengah bakop boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pathen taengkah a cukhalh neh a pathen te a nawn uh dongah a hmueih te caak ham nang n'khue akhaw khohmuen kah khosa taengah moi na bop ve.
  </para>
  <para style="p">
    <verse number="16" style="v" />A canu te na capa ham na lo cakhaw a canu khaw a pathen hnukah cukhalh uh. Te dongah na ca rhoek te amih kah pathen taengah cukhalh hae ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mueihlawn pathen khaw namah ham saii boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang kang uen bangla vaidamding khotue te hnin rhih yaeh lamtah vaidamding mah ca. Egypt lamloh Abib hla dongah na thoh dongah Abib hla ah tingtunnah om saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bung lamkah cacuek boeih, na boiva dongkah vaito neh tu cacuek a tal boeih he kamah kah ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae laak cacuek tah tu neh lat. Na lat pawt bal atah pahoi at laeh. Na capa caming boeih tah lat lamtah ka mikhmuh ah kuttling la phoe boel saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hnin rhuk khuiah thotat lamtah hnin rhih dongah tah lophoh vaengah khaw duem lamtah cangah vaengah khaw nduem.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cang dongkah cangah vaengkah thaihcuek khotue yalh neh kum thoknah cangyom khotue te namah ham saii.
  </para>
  <para style="p">
    <verse number="23" style="v" />Namah khuikah tongpaca boeih tah kum khat ah voei thum Israel Pathen, Boeipa Yahovah mikhmuh ah phoe saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Namtom te na mikhmuh lamloh ka haek vetih na khorhi khaw kang aeh ni. BOEIPA na Pathen mikhmuh la kum khat ah voei thum phoe ham na caeh daengah ni na khohmuen te hlang loh ham veet pawt eh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kai kah hmueih thii te tolrhu neh ngawn boeh. Yoom khotue kah hmueih loh mincang duela rhaeh boel saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na khohmuen kah tanglue thaihcuek te BOEIPA na Pathen im la khuen. Maae ca te a manu suktui neh thong boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah BOEIPA loh Moses te, “He ol he namah ham daek laeh. Kamah ka dongkah ol nen he nang taeng neh Israel taengah paipi ka saii,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />BOEIPA neh a om vaengah khothaih hni sawmli, khoyin hnin sawmli buh khaw ca pawh, tui khaw o pawh. Te vaengah paipi ol te cabael rhoi dongah ol lung rha la a daek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Moses te Sinai tlang lamloh a suntlak vaengah Moses kut dongah olphong cabael rhoi khaw om. Tlang lamloh a suntlak neh amah te a voek pueng dongah a maelhmai vin a phii te khaw Moses loh ming pawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aaron neh Israel ca boeih loh Moses te a hmuh uh vaengah a maelhmai vin tarha a phii coeng dongah a taengla mop ham a rhih uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae Moses loh amih te a khue dongah Aaron neh rhaengpuei kah khoboei boeih tah anih taengla mael uh tih Moses loh amih te a voek.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah Israel ca rhoek boeih te mop uh. Te vaengah Sinai tlang ah BOEIPA anih taengkah a thui boeih te amih a uen.
  </para>
  <para style="p">
    <verse number="33" style="v" />Moses loh amih taengah a thui te a khah van neh a maelhmai te a lumuekhni neh a dah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae BOEIPA amah te voek ham a mikhmuh la kun tih amah ha pawk daengah lumuekhni a lim pueng. Ha pawk phoeiah tah amah a uen te Israel ca rhoek ham a thui pah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Israel ca rhoek loh Moses maelhmai te a hmuh vaengah Moses kah maelhmai vin a phii pah. Tedae Boeipa amah te voek ham a kun hil Moses loh lumuekhni neh a maelhmai te a dah.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Moses loh Israel ca rhaengpuei te boeih a tingtun tih amih ham ol he a thui pah. Te te amih saii sak ham ni BOEIPA loh a uen.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hnin rhuk khuiah bitat saii saeh lamtah hnin rhih dongah tah nang ham Sabbath cim neh BOEIPA ham koiyaeh la om saeh. Te vaengah bitat aka saii boeih tah duek saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sabbath hnin ah tah na tolrhum tom ah hmai toih uh boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moses loh Israel ca rhaengpuei boeih te, “He ol he thui hamla BOEIPA loh n'uen coeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangmih taeng lamloh BOEIPA ham khosaa khuen uh. A lungbuei aka hlangcong boeih loh BOEIPA kah khosaa te sui neh cak neh rhohum khaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />a thim neh daidi neh hlampai a lingdik neh hnitang neh maae,
  </para>
  <para style="p">
    <verse number="7" style="v" />tutal pho a thimyum neh saham pho khaw, rhining thing khaw,
  </para>
  <para style="p">
    <verse number="8" style="v" />hmaivang ham situi neh koelhnah situi botui khaw, botui bo-ul ham khaw,
  </para>
  <para style="p">
    <verse number="9" style="v" />Hnisui neh rhangpho dongkah ham oitha lung neh saboi lung khaw khuen saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmih ah lungbuei aka cueih boeih khaw ha pawk uh saeh lamtah BOEIPA kah a uen boeih te,
  </para>
  <para style="p">
    <verse number="11" style="v" />A dap kah dungtlungim neh a imphu te khaw, a rhuithu neh a longlaeng khaw, a thohkalh, a tung neh a buenhol,
  </para>
  <para style="p">
    <verse number="12" style="v" />thingkawng neh a thingpang, thingkawng tlaeng neh himbaiyan dongkah hniyan,
  </para>
  <para style="p">
    <verse number="13" style="v" />caboei neh a longlaeng khaw, a hnopai boeih neh a mikhmuh kah buh khaw,
  </para>
  <para style="p">
    <verse number="14" style="v" />hmaivang ham hmaitung neh a hnopai, a hmaithoi neh hmaivang situi khaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />bo-ul hmueihtuk neh a thingpang, koelhnah situi neh botui bo-ul, dungtlungim thohka kah thohka himbaiyan,
  </para>
  <para style="p">
    <verse number="16" style="v" />hmueihhlutnah hmueihtuk neh rhohum pahak ham khaw, a thingpang neh a hnopai boeih, baeldung neh a kho khaw,
  </para>
  <para style="p">
    <verse number="17" style="v" />vongtung imbang khaw, a tung neh a buenhol khaw, vongtung vongka kah himbaiyai,
  </para>
  <para style="p">
    <verse number="18" style="v" />dungtlungim hlingcong neh vongtung hlingcong, a liva khaw,
  </para>
  <para style="p">
    <verse number="19" style="v" />hmuencim kah aka thotat ham hnithun himbai, khosoih Aaron ham hmuencim himbai neh aka khosoih ham koi anih koca rhoek kah himbai khaw saii uh saeh,’ a ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah Israel ca rhaengpuei boeih te Moses mikhmuh lamloh khoe uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah a lungbuei aka tueng hlang boeih neh a mueihla aka puhlu boeih loh tingtunnah dap kah bitat ham neh a thothuengnah cungkuem ham khaw hmuencim himbai ham khaw BOEIPA kah khosaa te a khuen uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungbuei ah aka hlangcong boeih tah a yuu a va la kun uh tih tlaeloh neh hnaii khaw, kutcaeng neh oilung khaw, sui hnopai boeih a khuen uh tih hlang boeih loh BOEIPA taengah sui thueng hmueih la a thueng uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hlang boeih loh te te a hmuh vaengah a thim neh daidi khaw, hlampai a lingdik neh hnitang khaw, maea neh tutal pho a thimyum khaw saham pho khaw a khuen uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khosaa aka ludoeng boeih loh cak neh rhohum te BOEIPA kah khosaa la a khuen uh. Te te aka hmu boeih loh rhining thing te thothuengnah bitat cungkuem ham a khuen uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lungbuei aka cueih nu boeih loh a kut neh a hnuh uh tih hnitah te a thim neh daidi, hlampai a lingdik neh hnitang la a khuen uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amih a lungbuei a cahoeh pah nu boeih loh cueihnah neh a hnuh maae mul khaw a khuenuh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khoboei rhoek loh oitha lungto neh hnisui rhangpho ham saboi lungto a khuen uh bal.
  </para>
  <para style="p">
    <verse number="28" style="v" />Botui neh hmaivang ham situi khaw, koelhnah situi ham neh botui bo-ul khaw,
  </para>
  <para style="p">
    <verse number="29" style="v" />Huta tongpa a lungbuei aka puhlu boeih, te rhoek te BOEIPA kah a uen bangla bitat cungkuem ham a khuen uh. Moses kut neh saii ham Israel ca rhoek loh BOEIPA taengah kothoh a khuen uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah Moses loh Israel ca rhoek te, “So lah BOEIPA loh Judah koca lamkah Hur capa Uri kah a ca, a ming ah Bezalel te a khue coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih te Pathen kah mueihla neh, cueihnah neh, lungcuei neh, mingnah neh, bitat cungkuem neh cung.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah sui neh ngun dongah khaw, rhohum dongah khaw kopoek neh a moeh tih a saii.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lungto kutthaibibi nen khaw a cung sak tih thing kutthaibibi dongah khaw kopoek kah bitat boeih neh a saii ham,
  </para>
  <para style="p">
    <verse number="34" style="v" />amah a lungbuei kah te thuinuet ham Dan koca lamkah Ahisamak capa Oholiab te a paek.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amih te kutthai kah bitat cungkuem khaw moehnah neh saii ham lungbuei kah cueihnah a cung sak. Te dongah a thim neh, daidi neh hlampai a lingdik neh hnitang dongah a en. Te phoeiah hni aka tak long khaw kopoek kah bitat moehnah cungkuem neh a saii.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah Bezalel, Oholiab neh lungbuei aka cueih hlang boeih loh saii saeh. Amih taengah BOEIPA kah a uen boeih tah hmuencim kah thothuengnah bitat cungkuem te ming sak ham neh saii sak ham BOEIPA loh cueihnah neh lungcuei la a khueh,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Moses loh Bazelel, Oholiab neh lungbuei aka cueih hlang boeih te a khue. Te rhoek te BOEIPA loh a lungbuei ah cueihnah paek tih amih boeih tah bitat la caeh ham neh saii ham khaw a lungbuei a cahoeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah hmuencim thothuengnah bitat la saii ham Israel ca rhoek loh a khuen khosaa cungkuem te Moses mikhmuh lamloh a doe uh. Amih loh te te mincang, mincang ah moeihoeihnah a khuen uh pueng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah hmuencim kah bitat boeih aka saii hlang cueih boeih neh hlang boeih khaw amah kah bitat a saii lamloh ha pawkuh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Moses te a voek uh tih, “Te bitat te saii ham BOEIPA loh a uen coeng dongah thothuengnah kah a ngoe lakah pilnam loh a khuen he yet,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Moses loh a uen bangla rhaehhmuen ah ol a thak uh tih, “Huta khaw tongpa khaw hmuencim kah khosaa ham bitat saii voel boel saeh,” a ti uh. Te dongah pilnam loh hno a khuen te paa uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bitat ham a rhoeh la a om phoeiah bitat cungkuem dongah te te hnonah ham khaw coih coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bitat aka saii khuiah lungbuei aka cueih boeih loh dungtlungim te a saii uh. Himbaiyan yungrha te hnitang la a tah tih a thim, daidi neh hlampai a lingdik la a en. Cherubim dongkah bibi khaw moehnah neh a saii.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himbaiyan pakhat kah a yun he dong kul dong rhet, a daang dong li lo tih himbaiyan boeih ham te himbaiyan pakhat neh cungnueh pakhat la cet.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himbaiyan yung nga te pakhat neh pakhat a cong tih himbaiyan yung nga te khaw khat neh khat cong uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himbaiyan pakhat kah a hmoi phai ah rhuikawl a thim te rhui at a bawt hil a buen pah. Te tlam te a tloe himbaiyan hmoi kah rhui at a bawt hil a saii.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himbaiyan yung khat dongah rhuikawl sawmnga a saii tih himbaiyan a pabae khaw rhui at la a hmoi ah rhuikawl sawmnga a saii. Te dongah khat neh khat rhuikawl neh a doe sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah sui rhuithu sawmnga a saii tih rhuithu lamloh himbaiyan khat neh khat te a hlinghlui dongah dungtlungim khaw pakhat la om.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dungtlungim kah dap ham himbaiyan te maae mul neh a saii tih himbaiyan yung hlai khat a saii.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himbaiyan yungat te a yun dong sawmthum, a daang dong li lo tih himbaiyan hlai khat ham te himbaiyan pakhat cungnueh dongah pakhat la cet.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himbaiyan yung nga te hloep a cong tih himbaiyan yung rhuk te pakhat la a cong.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himbaiyan pakhat kah a hmoi ah a bawt due rhuikawl sawmnga te rhui at la a saii tih a pabae himbaiyan kah a hmoi ah rhuikawl sawmnga ham buenyang a saii.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah rhohum rhuithu sawmnga a saii dap te a hlinghlui tih pakhat la a om sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dap imphu te tutal pho a thimyum neh a sokah imphu la saham pho neh a saii.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah dungtlungim ham a longlaeng te rhining thing aka pai te a saii.
  </para>
  <para style="p">
    <verse number="21" style="v" />A longlaeng pakhat te a yun dong rha neh a daang dong khat phoeiah dong kaek lo tih a longlaeng te rhip vaiuh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A longlaeng pakhat dongah dangkam rhoi khaw khat neh khat kiba uh. Te tlam te dungtlungim kah a longlaeng te boeih a saii.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dungtlungim kah a longlaeng te tuithim ah tuithim saa kah a longlaeng te yung kul a saii.
  </para>
  <para style="p">
    <verse number="24" style="v" />A longlaeng pakhat dangah dangkam rhoi ham buenhol panit neh a longlaeng yung kul ham cakben buenhol sawmli a saii. Te dongah a longlaeng pakhat dangah buenhol panit neh dangkam panit om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dungtlungim khat ben tlangpuei saa ah a longlaeng pakul a khueh.
  </para>
  <para style="p">
    <verse number="26" style="v" />A longlaeng pakhat dangah buenhol panit, a longlaeng pakhat dangkah buenhol panit neh cakben buenhol sawmli te a saii.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dungtlungim kah imthael khotlak sa ham tah a longlaeng yung rhuk a saii.
  </para>
  <para style="p">
    <verse number="28" style="v" />Imthael ah dungtlungim kah a ngong ham khaw a longlaeng panit a khueh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te te a hmui lamloh tungbok la om vetih a soi ah tah kutcaeng pakhat khuiah pakhat la rhenten ben uh. Te rhoi dongkah bangla imki rhoi kah ham khaw a saii.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah a longlaeng parhet vaengah a longlaeng pakhat hmuikah buenhol panit, panit neh buenhol he cakben buenhol hlai rhuk om.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dungtlungim impalai kah a longlaeng pakhat ham thohkalh panga te rhining thing a saii.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dungtlungim khat ben impalai kah a longlaeng dongah khaw thohkalh panga tih dungtlungim khotlak imthael kah a longlaeng dongkah ham thohkalh panga om.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae a bangli kah thohkalh a saii long tah a longlaeng te a hmoi lamloh a bawt hil a bangli ah yong phai.
  </para>
  <para style="p">
    <verse number="34" style="v" />A longlaeng te khaw sui a ben thil tih thohkalh rholhnah ham a kutcaeng te sui ni a. saii. Thohkalh te khaw sui a ben thil.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah hniyan te a thim, daidi, hlampai a lingdik neh a saii. Bibi moehnah neh hnitang la a tah tih cherubim khaw a saii.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te ham te rhining tung pali a saii tih sui a ben thil. A voei te sui tih te dongkah buenhol pali ham te cak a hlawn.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dap thohka kah himbaiyan te a saii vaengah a thim, daidi, hlampai a lingdik neh hnitang la a tah tih kutnaep la a en.
  </para>
  <para style="p">
    <verse number="38" style="v" />A tung panga neh a voei rhoek te khaw a soi ah a ben pah tih a yaeltlang te sui, a buenhol panga te rhohum a saii.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bezalel loh rhining thing te thingkawng a yun dong nit ngancawn, a daang dong khat neh tintan, a sang dong khat neh tintan la a saii.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah a khui a hman ah sui cilh a ben thil tih a kaep, a kong khaw, sui neh a saii.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kho pali dongah sui kutcaeng pali a hlawn. A vae khat ben ah kutcaeng panit, a vae khat ben ah kutcaeng panit om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rhining thing thingpang la a suih tih sui a ben thil.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thingpang te thingkawng aka kawt ham thingkawng vae kah kutcaeng dongah a rholh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tlaeng te sui cilh neh a yun dong nit tintan neh a daang dong at tintan la a saii.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sui cakben cherubim panit te a saii tih te rhoi te a tlaeng kah a hmoi rhoi ah a ben.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thingkawng tlaeng lamloh khat ben a hmoi ah cherubim pakhat neh khat ben a hmoi ah cherubim pakhat tih cherubim te a hmoi ah a hmuicue panit a saii.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cherubim aka om rhoi loh a phae a phuel hang rhoi tih a phae neh thingkawng tlaeng te a khu rhoi. A maelhmai rhoi khaw pakhat loh a manuca taengla mael. Te dongah cherubim kah maelhmai te thingkawng tlaeng soah hum uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah rhining thing te caboei a yun dong nit neh a daang dong khat, a sang dong khat tintan la a saii.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te te sui cilh a ben thil tih a kaep kah a khopnah khaw sui ni a. saii.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te ham te a kae a kaep ah kutsom pakhat a khueh tih a kae soah a khopnah te sui neh pin a saii.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te ham te sui kutcaeng pali a hlawn tih kutcaeng te a kho pali kah a kil pali ah a buen.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kae kah voeivang ah caboei aka kawt ham thingpang rholhnah kutcaeng om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Caboei aka kawt ham thingpang te rhining thing a suih tih sui a ben thil.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah caboei dongkah hnopai la a bael neh a yakbu khaw, tuisi a doeng vaengah kah a tuisi-am neh tui-um khaw sui cilh lamloh a saii.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmaitung la sui cilh cakben neh a saii tih hmaitung kah a kho neh a bunang kong khaw a saii. Te lamloh a paimuem neh a rhaiphuelh om.
  </para>
  <para style="p">
    <verse number="18" style="v" />A vae khat ben lamloh hmaitung kah a kong pathum, a vae khat hmaitung kah a kong pathum neh a kaep lamloh a kong parhuk cawn.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kong pakhat dongah rhaimuem rhaiphuelh neh noepai bunang pathum, a kong pakhat dongah khaw rhaimuem rhaiphuelh neh noepai bunang pathum a saii. Hmaitung lamkah aka cawn a kong parhuk dongah te tlam te a saii.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmaitung dongah noepai bunang pali khaw rhaimuem rhaiphuelh neh a khueh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kong panit hmuiah rhaimuem pakhat neh, a kong panit hmuiah rhaimuem pakhat tih a kong parhuk a cawn dongah a kong panit hmui ah rhaimuem pakhat om bal.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te lamkah a rhaimuem neh a kong te sui cilh a boh neh pakhat la boeih om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmaithoi parhih neh a paitaeh khaw a baelphaih khaw sui cilh ni a. saii.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te hmaithoi a hnopai boeih te sui cilh talent khat neh a saii.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah rhining thing te bo-ul hmueihtuk a yun dong khat, a daang dong khat neh hniboeng la om tih a sang dong nit a ki khaw om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te te sui cilh neh a imphu khaw, a pangbueng phai khaw, a ki khaw a ben thil tih a kaep kah a khopnah te sui a saii.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te ham te a khopnah hmui ah sui kutcaeng panit a saii. Te te hmueihtuk aka kawt ham thingpang rholhnah la a vae rhoi ah a buen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Rhining thing te thingpang la a suih tih sui a ben thil.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hmuencim kah koelhnah situi neh aka thungnom kutci bangla botui bo-ul cil khaw a saii.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rhining thing te hmueihhlutnah hmueihtuk, a yun dong nga neh a daang dong nga ah hniboeng la om tih a sang te dong thum la a saii.
  </para>
  <para style="p">
    <verse number="2" style="v" />A kil pali ah a ki a saii pah tih a ki aka om rhoek te rhohum a ben thil.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah hmueihtuk dongkah hnopai cungkuem, am neh hmaisoh khaw, baelcak ciksum neh baelphaih khaw a saii. A hnopai boeih te rhohum ni a. saii.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmueihtuk ham a loengboeng hmui lamloh a kong hmui hil rhohum vairhuek dongkah bibi bangla pahak a saii.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thingpang rholhnah ham rhohum pahak kah a hmuicue pali ah kutcaeng pali a hlawn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rhining thing te thingpang la a suih tih rhohum a ben thil.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te aka kawt ham te hmueihtuk vae kah kutcaeng khuiah thingpang a rholh tih hmueihtuk te thingphael aka khui rhoi neh a khop.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aka thotat nu kah mangthuinah lamloh rhohum baeldung neh rhohum kho khaw a saii. Amih te tingtunnah dap thohka ah thotat uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuithim ben kah ah vongtung a saii tih, vongtung imbang te hnitang dong yakhat a tah thil.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tung pakul neh a buenhol pakul te rhohum tih tung dongkah voei neh a yaeltlang tah cak a saii.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tlangpuei saa kah dong yakhat ham khaw tung pakul neh a buenhol pakul te rhohum tih, tung dongkah voei neh a yaeltlang tah cak a saii.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khotlak ben kah imbang khaw dong sawmnga lo. A tung parha neh a buenhol parha lo. Tung dongkah voei neh a yaeltlang te cak a ben.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khothoeng ben ah khaw dong sawmnga lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kaep kah imbang te dong hlai nga lo. A tung pathum neh a buenhol pathum om.
  </para>
  <para style="p">
    <verse number="15" style="v" />A Vongup vongka hlaep kah imbang pabae te he ben ah khaw ke ben ah khaw dong hlai nga lo. A tung pathum neh a buenhol khaw pathum om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vongup kaepvai kah imbang boeih te hnitang a tah thil.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah tung dongkah buenhol tah rhohum tih tung dongkah voei neh a yaeltlang tah cak neh a saii. Te dongah vongup kah tung boeih te a soi kah cak ben phoeiah cak neh a cen uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vongup vongka kah himbaiyan khaw kutci neh a thim, daidi, hlampai a lingdik la a en tih hnitang la a tah. Te vaengah vongup kah imbang voeivang kah bangla a yun dong kul neh a daang a sang tah dong nga lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />A tung pali neh a buenhol pali tah rhohum a saii. A voei tah cak tih a soi neh a yaeltlang khaw cak ben la om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dungtlungim ham neh a kaepvai vongtung ham khaw rhohum hlingcong boeih a saii.
  </para>
  <para style="p">
    <verse number="21" style="v" />He dungtlungim la a hlum he khosoih Aaron koca Ithamar kut dongkah Levi thohtatnah, Moses ol bangla olphong kah dungtlungim la a soep.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah BOEIPA loh Moses a uen vabangla Judah koca lamkah Hur capa Uri kah a ca Bezalel loh a cungkuem te a saii.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae a taengah moehnah neh a thim la, daidi la, hlampai a lingdik neh hnitang la aka en kutthai, Dan koca lamkah Ahisamak capa Oholiab khaw om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmuencim bitat cungkuem dongah sui khaw bitat la boeih a saii. Te vaengah thueng hmueih dongkah sui mah hmuencim kah shekel ah talent pakul pako phoeiah shekel ya rhih sawmthum om coeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rhaengpuei kah a soep cak he khaw talent yakhat neh hmuencim kah shekel ah shekel thawngkhat ya rhih sawmrhih panga lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hlangmi pakhat dongah beka pakhat, hmuencim shekel ah shekel rhakthuem a paek. Soep hamla aka kat boeih te kum kul ca lamloh a so hang te thawng ya rhuk thawng thum neh ya nga sawmnga lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah hmuencim buenhol neh hniyan buenhol la a hlawn ham cak te talent yakhat lo coeng. Buenhol pakhat dongah talent khat van tih talent yakhat lamloh buenhol yakhat rhoeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah thawngkhat ya rhih neh sawmrhih panga te tung dongkah voei la a saii. Te phoeiah a soi ah a ben tih a cen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah thueng hmueih rhohum talent sawmrhih neh shekel thawng nit ya li lo.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te nen te tingtunnah dap thohka kah buenhol neh rhohum dapim hmueihtuk khaw, rhohum pahak khaw hmueihtuk kah hnopai cungkuem khaw,
  </para>
  <para style="p">
    <verse number="31" style="v" />vongtung phai kah buenhol khaw, vongtung vongka kah buenhol khaw, dungtlungim kah hlingcong boeih neh, vongtung phai kah hlingcong boeih a saii.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmuencim ah aka thotat kah hnithun himbai khaw a thim, daidi, hlampai a lingdik neh a saii. Te phoeiah BOEIPA loh Moses a uen vanbangla Aaron ham khaw hmuencim himbai a hui uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah sui hnisui te a thim, daidi, hlampai a lingdik la a en tih hnitang la a tah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sui phaldaep te a daep tih hamrhui khaw a thim la, daidi la, hlampai a lingdik la, bibi moehnah neh hnitang la saii ham a ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Holhnam te a hmuicue rhoi ah hlinghlui ham a saii uh tih a hmoi te a hlinghlui.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pholip dongkah cihin khaw a bibi bangla a soah sui, a thim, daidi, hlampai a lingdik neh BOEIPA loh Moses a uen vanbangla hnitang la a tah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sui oibom dongkah a det oitha lungto te a saii tih kutbuen thingthuk te Israel ca rhoek kah ming la a thuk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te te BOEIPA loh Moses a uen vanbangla Israel ca rhoek ham poekkoepnah lungto la hnisui kah holhnam dongah a bang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rhangpho te khaw sui hnisui dongkah kutngo bangla bibi moehnah neh a thim, daidi, hlampai a lingdik a en tih hnitang la a tah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rhangpho a saii te hniboeng la om tih a yaep, a yun khap at neh a daang khap at la a yaep.
  </para>
  <para style="p">
    <verse number="10" style="v" />A soah lungto a than, than li a hulh tih a than cuek te lungling, vaya neh tamkuei,
  </para>
  <para style="p">
    <verse number="11" style="v" />A than bae dongah ah khocillung, minhum neh lungmik,
  </para>
  <para style="p">
    <verse number="12" style="v" />a than thum dongah tamsenlung, khopang lung neh kemden,
  </para>
  <para style="p">
    <verse number="13" style="v" />A than li dongah timsuih, oitha, maihae te a hulhnah neh sui oibom dongah a bom.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lungto te khaw Israel ca hlai nit ming neh a khueh. Lungto ming tarhing ah koca hlai nit ham khaw a ming te kutbuen thingthuk la rhip a khueh pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rhangpho dongkah cuehnah cangtui-rhaica khaw sui cilh rhuivaeh dongkah kutngo la a saii.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sui oibom panit neh sui kutcaeng panit a saii tih kutcaeng rhoi te rhangpho kah a hmoi rhoi ah a bang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sui rhuivaeh rhoi te rhangpho hmoi kah kutcaeng rhoi dongah a khih uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rhuivaeh rhoi kah a hmoi rhoi te oibom rhoi dongla a hlinghlui. Te rhoek te a hmai kah hnisui holhnam dongla a khih uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah sui kutcaeng panit te a saii uh tih hnisui a khui, a hmai a hmoi dongah rhangpho hmoi rhoi dongah a khih uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sui kutcaeng rhoi a saii uh tih te rhoi te hnisui cihin sokah a rhui voeivang taeng, a hmai ah a dang kah hnisui holhnam rhoi dongla a hlin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rhangpho dongkah a kutcaeng rhoi neh te hnisui dongkah kutcaeng rhoi te hamrhui a thim neh a pin. BOEIPA loh Moses a uen bangla hnisui kah cihin soah a om daengah ni rhangpho hnisui dong lamloh a hawl pawt eh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah hnikul te hnisui dongkah kutngo bangla a saii tih a thim la boeih a tah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hnikul kah a rhai te a laklung ah rhawnmoep kah a rhai bangla om tih a rhai ham a kongnah khaw pin a om dongah pawn mahpawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hnikul dongkah hnihmoi ah tale thaih a saii tih a thim, daidi, hlampai a lingdik neh a tah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sui cilh te hling la a saii tih hling te hnikul hnihmoi kah tale laklo, tale laklo ah pin a bang.
  </para>
  <para style="p">
    <verse number="26" style="v" />BOEIPA loh Moses a uen vanbangla aka thotat ham kah hnikul hmoi ah te hling neh tale thaih, hling neh tale thaih tila pin a bang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Aaron ham neh anih koca rhoek ham hnitang kutngo a tah angkidung te a hui uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hnitang lupong neh lukhuem khaw, hnitang samkhuem neh takhlawk hnii khaw hnitang la a tah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lamko te khaw hnitang la a tah tih BOEIPA loh Moses a uen vanbangla a kutngo te a thim, daidi, hlampai a lingdik neh a en.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rhuisam tamlaep cim te khaw sui cilh neh a saii tih a soah kutbuen dongkah thingthuk cadaek te BOEIPA ham Cim tila a daek.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah BOEIPA loh Moses a uen bangla te te a so ah lupong dongah khih ham hamrhui a thim neh a hlinghlui.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tingtunnah dap ah dungtlungim kah thothuengnah boeih a coeng tangloeng coeng. Israel ca rhoek loh a saii uh vaengah a cungkuem dongah BOEIPA loh Moses a uen te ni a. saii uh van.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah dungtlungim te Moses taengah dap neh a hnopai boeih, a rhuithu neh a longlaeng a thohkalh khaw, a thohkalh neh a tung a buenhol khaw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Imphu, tutal pho a thimyum neh imphu, saham pho te khaw himbaiyan hniyan khaw,
  </para>
  <para style="p">
    <verse number="35" style="v" />Olphong thingkawng neh a thingpang khaw a tlaeng khaw,
  </para>
  <para style="p">
    <verse number="36" style="v" />Caboei neh a hnopai boeih neh a hmai kah buh,
  </para>
  <para style="p">
    <verse number="37" style="v" />A hmaithoi cim kah hmaitung neh hmaithoi bong khaw, a hnopai cungkuem neh hmaivang situi khaw,
  </para>
  <para style="p">
    <verse number="38" style="v" />Sui hmueihtuk neh koelhnah situi khaw, botui bo-ul neh dap thohka kah himbaiyan khaw,
  </para>
  <para style="p">
    <verse number="39" style="v" />rhohum hmueihtuk neh rhohum pahak khaw, a thingpang neh a hnopai boeih, baeldung neh a kho khaw,
  </para>
  <para style="p">
    <verse number="40" style="v" />vongtung imbang kah a tung neh a buenhol khaw, vongup vongka dongkah himbaiyan khaw, a liva neh te a hlingcong khaw, dungtlungim kah thothuengnah hnopai cungkuem neh tingtunnah dap ham khaw,
  </para>
  <para style="p">
    <verse number="41" style="v" />Hmuencim ah aka thotat ham hnithun himbai te khaw, khosoih Aaron kah hmuencim himbai neh aka khosoih ham koi anih koca rhoek kah himbai te khaw a khuen uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />BOEIPA loh Moses taengah boeih a uen vanbangla Israel ca rhoek loh thothuengnah cungkuem te a saii uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Moses loh bitat cungkuem te a hmuh vaengah BOEIPA kah a uen bangla buelh a saii uh. A saii tangloeng dongah amih te Moses loh a uem.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hla lamhmacuek kah hlasae lamhmacuek khohnin ah tingtunnah dap kah dungtlungim te thoh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah olphong thingkawng te pahoi khueh lamtah thingkawng soah hniyan neh khuk thil.
  </para>
  <para style="p">
    <verse number="4" style="v" />Caboei te khaw khuen lamtah a phu te tael pah. Hmaitung te khuen bal lamtah a hmaithoi te tok pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Olphong thingkawng hmai ah bo-ul ham sui hmueihtuk te hol lamtah dungtlungim ham thohka kah himbaiyan te yan pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah hmueihhlutnah hmueihtuk te tingtunnah dap kah dungtlungim thohka hmai ah hol.
  </para>
  <para style="p">
    <verse number="7" style="v" />Baeldung te tingtunnah dap laklo neh hmueihtuk laklo ah hol lamtah tui pahoi loei pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vongtung te pin thoh lamtah vongtung vongka kah himbaiyan te yan pah vetih, akhui la kun nah thohka ah himbai te yanuh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Koelhnah situi te lo lamtah dungtlungim neh a khuikah a cungkuem te koelh. Te neh a hnopai cungkuem te na ciim daengah ni a. cim la a om eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah hmueihhlutnah hmueihtuk neh a hnopai boeih te koelh. Hmueihtuk te ciim lamtah hmueihtuk te a cim a cim koek la om saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Baeldung neh a kho te khaw koelh lamtah ciim.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Aaron neh anih koca rhoek te tingtunnah dap thohka la khuen lamtah amih te tui hluk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aaron te a cim himbai bai sak lamtah koelh. Anih te ciim lamtah kamah taengah khosoih saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ca rhoek te khaw khuen lamtah amih te angkidung puei sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />A napa na koelh bangla amih te koelh lamtah kamah taengah khosoih saeh. Khosoihbi he a cadilcahma ham kumhal due amih koelhnah la om rhoe om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />BOEIPA loh anih saii sak ham a uen boeih te Moses loh a saii.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah a kum bae dongkah lamhma cuek hla a pha neh hlasae dongkah lamhma cuek hnin ah dungtlungim te a pai sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Moses loh dungtlungim te a thoh vaengah a buenhol a buen tih a longlaeng te a paek. A thohkalh te a rholh tih a tung te khaw a ling.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dungtlungim sokah dap te a dih tih BOEIPA loh Moses a uen bangla dap imphu te a so, so lamloh a khueh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah olphong te a khuen tih thingkawng khuiah a khueh. Thingpang te thingkawng dongah a rholh phoeiah tah a tlaeng te thingkawng soah a so lamloh a tloeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah thingkawng te dungtlungim khuila a khuen tih himbaiyan dongkah hniyan te a yan thil. Te vaengah BOEIPA loh Moses a uen vanbangla olphong thingkawng te a khuk.
  </para>
  <para style="p">
    <verse number="22" style="v" />Caboei te tah tingtunnah dap khuikah dungtlungim kaep, tlangpuei hniyan kah kawtpoeng ah a khueh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A soah BOEIPA hmai kah buh te, BOEIPA loh Moses a uen bangla buelh a tawn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmaitung te tah tingtunnah dap khuikah caboei dan, dungtlungim kaep kah tuithim ah a khueh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmaithoi te BOEIPA loh Moses a uen vanbangla BOEIPA mikhmuh ah a tok.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sui hmueihtuk te tingtunnah dap khuikah hniyan hmai ah a khueh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A soah BOEIPA loh Moses a uen vanbangla botui bo-ul khaw a phum.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah dungtlungim thohka kah himbaiyan te a bang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hmueihhlutnah hmueihtuk te tingtunnah dap kah dungtlungim thohka ah a khueh tih te soah te hmueihhlutnah neh khocang khaw BOEIPA loh Moses a uen vanbangla a nawn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Baeldung te tingtunnah dap laklo neh hmueihtuk laklo ah a hol tih hluk ham tui khaw pahoi a khueh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te nen te Moses neh Aaron neh anih koca rhoek loh a kut a kho a silh uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tingtunnah dap khuila a kun ham vaengah khaw, hmueihtuk la a caeh uh vaengah khaw BOEIPA loh Moses a uen vanbangla a silh uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dungtlungim ham neh hmueihtuk ham vongtung pin a tung tih vongup vongka kah himbaiyan a yan daengah Moses loh bitat a coeng.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah tingtunnah dap te cingmai loh a thing tih BOEIPA thangpomnah loh dungtlungim ah bae.
  </para>
  <para style="p">
    <verse number="35" style="v" />A soah cingmai yaal tih BOEIPA kah thangpomnah loh dungtlungim ah a bae dongah Moses loh tingtunnah dap khuila kun ham coeng pah pawh.
  </para>
  <para style="p">
    <verse number="36" style="v" />A longpueng khing ah dungtlungim dong lamloh cingmai a caeh van vaengah ni Israel ca rhoek khaw a caeh uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae cingmai a caeh pawt atah a caeh hnin duela cet uh van pawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />A longpueng khing Israel imkhui pum kah mikhmuh ah tah khothaih ah dungtlungim sokah BOEIPA cingmai neh khoyin ah hmai a om pah.
  </para>
</usx>
