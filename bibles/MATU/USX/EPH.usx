<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EPH" style="id">Ephesa</book>
  <para style="h">Ephesa</para>
  <para style="toc1">Ephesa</para>
  <para style="toc2">Ephesa</para>
  <para style="mt">Ephesa</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen kah kongaih neh Jesuh Khrih kah caeltueih Paul loh Ephisa kah aka om hlang cim rhoek neh Jesuh Khrih ah uepom kan yaak sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Boeipa Jesuh Khrih neh a pa Pathen taengkah lungvatnah neh ngaimongnah tah nangmih taengah om saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen neh mamih kah Boeipa Jesuh Khrih kah a napa tah uemom la om pai saeh. Amah loh Khrih ah vaan kah mueihla yoethennah cungkuem neh mamih n'uem coeng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mamih he Lungnah neh amah hmuh ah cimcaih tih cuemthuek la om ham Diklai a tong hlanah amah dongah mamih n'tuek pataeng coeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah kah kongaih, kolonah vanbangla amah ham Jesuh Khrih lamloh cacah la mamih n'nuen coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lungvatnah dongkah thangpomnah he koehnah la om pai. Te nen ni lungnah dongah mamih n'lungvat.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thii lamloh amah dongah tlannah n'dang uh. A lungvatnah dongkah khuehtawn vanbangla tholhdalhnah dongkah khodawkngainah te khaw n'danguh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tekah te mamih ah cueihnah cungkuem, lungcueinah neh a baetawt sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kongaih kah olhuep te mamih taengah phoe coeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kolonah bangla amah khuiah a hmoel te a tuetang a soepnah dongah hnokhoemnah la om coeng. A cungkuem he vaan kah neh diklai kah khaw, Khrih amah dongah cuii sak ham om.
  </para>
  <para style="p">
    <verse number="11" style="v" />A kongaih kah mangtaengnah bangla boeih pongthoo tih, a mangtaengnah vanbangla a nuen rhoek long tah amah dongkah te m'pang uh van coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah amah kah thangpomnah Khrih ah koehnah la mamih n'om ham n'ngaiuep.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangmih khaw amah dongah ni namamih kah khangnah olthangthen oltak olka te na yaak uh. Amah aka tangnah tah olkhueh dongkah Mueihla Cim neh kutnoek n'daeng thil coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te tah dangnah dongah tlannah duela a thangpomnah dongkah koehnah te mamih kah rho cungah la om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah Boeipa Jesuh dongah tangnah neh hlangcim rhoek boeih taengah lungnah te nangmih taeng lamloh ka yaak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah nangmih ham toeng kolla aka uem loh ka thangthuinah dongah poekkoepnah ka khueh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te daengah ni mamih Boeipa Jesuh Khrih kah Pathen, thangpomnah a pa loh amah mingnah dongah pumphoenah neh cueihnah mueihla te nangmih m'paek eh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah kah khuenah dongah ngaiuepnah aka om te na ming hamla nangmih thinko mik tueng uh. Amah rho dongkah thangpomnah khuehtawn te tah hlangcim rhoek soah om.
  </para>
  <para style="p">
    <verse number="19" style="v" />A thaomnah, a lennah aka baekhawk te tah a thadueng kah thaomnah bibi bangla aka tangnah mamih taengah om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te tah duek lamkah aka thoo Khrih amah khuiah a tueng sak. Te dongah vaan ah khaw a bantang ah ngol coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Boeilu neh saithainah khaw, thaomnah neh taemrhainah khaw, ming khue boeih te ta kumhal bueng kah pawt tih hmailong kah khaw boeih a poe.
  </para>
  <para style="p">
    <verse number="22" style="v" />A cungkuem la a kho hmuiah boe a ngai sak tih amah te hlangboel taengah cungkuem soah a lu la a khueh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te tah amah pum la om tih cungkuem kah a soepnah tah cungkuem taengah soep.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangmih khaw tholhdalhnah neh na tholhnah ah aka duek la na om uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hnukbuet ah khaw ta kumhal kah Diklai khosing neh yilh dongkah saithainah boei banglam ni te dongah te na pongpa uh. Althanah kah a ca rhoek te a khuiah mueihla a tueng pah coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hnukbuet ah mamih boeih khaw pumsa hoehhamnah neh amih taengah kho n'sak uh. Pumsa neh kopoek kah kongaih te n'saii uh dongah a tloe rhoek kah a coengnah bangla kosi kah ca rhoek la n'om uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae rhennah neh kuirhang la aka om Pathen tah a lungnah a cungkuem dongah ni mamih n'lungnah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mamih he tholhdalhnah ah duek la aka om rhoek pataeng Khrih neh n'thoh sak tih lungvatnah lamloh khang la na om uh coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amah neh n'thoh tih Khrih Jesuh rhangneh vaan ah n'ngoltun sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te daengah ni Khrih Jesuh lamloh mamih taengah rhennah neh aka thoeng ham a lungvatnah khuehtawn te a baetawt la kumhal ah a tueng eh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungvatnah neh tangnah lamloh khang la na om uh coeng. Te te namamih kah moenih Pathen kah kutdoe ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khoboe kah moenih. Te dongah pakhat khaw hoemdam boel saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mamih tah Jesuh Khrih ah a suen a kutngo la n'om uh. Tekah khoboe then te Pathen loh a hmoel pai tih ni a soah m'pongpa pai eh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah pumsa ah nangmih namtom loh hnukbuet kah te poek uh. Pumdul la a khue rhoek tah pumsa neh kutsai lamloh yahvinrhetnah te ni a thui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaeng tue ah Khrih mueh la na om uh te ta. Israel kah khokung khomah te na hai uh tih olkhueh kah paipi te na kholong tak uh. Ngaiuepnah om pawt bangla Diklai ah na dalrha uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae nangmih hnukbuet kah Khrih Jesuh ah lakhla la aka om te Khrih thii dong lamloh rhep na om uh coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amah tah mamih kah rhoepnah la om. Panit pakhat la aka saii amah loh a pumsa dongkah thunkha la aka om vongtung pangbueng te khaw a phil coeng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Oltloek dongkah olpaek kah olkhueng te a hmil coeng. Te daengah ni panit te amah ah hlang thai pakhat la a suen vetih rhoepnah khaw a saii pai eh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te daengah ni thunkha te thinglam lamloh a ngawn vetih panit te Pathen taengah pum pakhat la a moeithen sak eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ha pawk vaengah lakhla kah nangmih taengah khaw rhoepnah, a yoei rhoek taengah khaw rhoepnah a phong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah lamloh pa taengah mueihla thikat neh boktlap la kunnah te n'dang uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah kholong neh yinlai la na om uh voel tangloeng pawh. Tedae hlangcim rhoek kah pilnam neh Pathen kah imkhuikho la na om uh coeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Caeltueih rhoek neh tonghma rhoek kah khoengim te a tlingtlawn thil uh coeng tih Khrih Jesuh amah he imkil la om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah dongah im pum te kiba tih Boeipa ah bawkim cim la rhoeng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmih khaw Mueihla ah Khrih amah dongah Pathen kah khosaknah hmuen la n'dun.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah kai Paul tah nangmih namtom rhoek ham Jesuh Khrih kah thongtla ka om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmih ham Pathen kah lungvatnah dongkah hnokhoemnah he kai m'paek te na yaak uh mak atah.
  </para>
  <para style="p">
    <verse number="3" style="v" />A toi la ka daek noek vanbangla tekah olhuep tah pumphoenah neh kai taengah phoe coeng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te cadaek bangla tae rhangneh Khrih kah olhuep soah kai kah yakmingnah te na yakming uh thai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te tah Mueihla lamloh a caeltueih rhoek neh tonghma hlangcim taengah a pumphoe coeng bangla hlang ca rhoek taengah rhuirhong a tloe lam khaw ana phoe moenih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Olthangthen lamloh namtom khaw Khrih Jesuh dongah olkhueh te pumkhat la cut hmaih tih rho aka pang hamla om coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thaomnah kah bibi vanbangla Pathen kah lungvatnah kutdoe te kai m'paek coeng dongah te olthangthen kah tueihyoeih la ka om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlangcim rhoek boeih khuiah a yit cadih koek kai taengah he lungvatnah he m'paek coeng. Khrih kah a khuehtawn toeklek toekna mueh te namtom rhoek taengah aka thui ham ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cungkuem aka suen Pathen dongah yan lamkah a thuh olhuep kah hnokhoemnah te hlang boeih tueng ham ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te daengah ni Pathen kah cueihnah a comluem te hlangboel lamloh vaan kah boeilu rhoek neh saithainah dongah a phoe eh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te tah kumhal kah mangtaeng vanbangla mamih Boeipa Khrih Jesuh ah a saii coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah dongah sayalhnah n'dang uh tih amah kah tangnah lamloh pangtungnah neh kunnah n'danguh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah nangmih ham kai kah phacip phabaem dongah thathae pawt ham kan hloep. Te tah nangmih kah thangpomnah ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />He dongah ni a pa taengah ka khuklu ka cungkueng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amah lamloh vaan neh diklai hman kah nurhui parhui boeih a khue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te daengah ni amah kah mueihla lamloh hlang ko khuiah rhaang sak ham a thaomnah dongkah thangpomnah khuehtawn te a tarhing la nangmih m'paek eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tangnah lamloh nangmih thinko ah Khrih loh kho a sak. Lungnah dongah m'pael tih n'sut.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te daengah ni hlagcim boeih taengkah lungnah a daang neh a yun, a sang neh a dung te tuuk ham na noeng uh eh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mingnah aka baetawt Khrih kah lungnah khaw ming ham om. Te daengah ni Pathen kah a soepnah te a cungkuem la na cung uh eh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amah tah a puehdaih la a saii ham boeih coeng thai hlai coeng. M'bih neh n'yakming te mamih ah thaomnah la tueng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah thangpomnah tah hlangboel so neh Khrih Jesuh dong lamloh cadil cahma boeih taengah kumhal kah kumhal ah om saeh. Amen.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedongah Boeipa ah thongtla kai loh nangmih aka khue kah khuenah neh a tingtawk la pongthoh ham kan hloep.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tlayaenah neh muelhtuetnah cungkuem neh, thinsennah neh lungnah dongah khat neh khat yaknaem uh thae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rhoepnah kah pinyennah dongah Mueihla kah kodoknah te khoem ham haam uh lah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangmih kah khuenah te ngaiuepnah pakhat dongah n'khue uh vanbangla pum pakhat neh mueihla pakhat ni a om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Boeipa pakhat, tangnah pakhat, baptisma pakhat ni a om.
  </para>
  <para style="p">
    <verse number="6" style="v" />A cungkuem kah Pathen neh Pa tah pakhat ni. Te tah cungkuem soah cungkuem lamloh cungkuem dongah om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Khrih kah kutdoe tarhing la mamih khat rhip taengah lungvatnah m'paek coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah, “Hmuen sang la a luei vaengah tamna te a mawt tih hlang rhoek taengah kutdoe a paek,” a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />A luei nen te dawk om pawt tih diklai hmuen te a laedil duela suntla bal.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah te suntla tih a cungkuem te soep sak ham vaan boeih kah a soah aka luei la om bal.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah amah loh a ngen te caeltueih rhoek, a ngen te tonghma rhoek, a ngen te olthangthen aka thui la, a ngen tah, tudawn neh saya la a khueh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bibi dongkah bitat dongah hlangcim rhoek kah hamsoepnah ham, Khrih pum dongkah hlinsainah ham a khueh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tangnah dongkah kodoknah dongah, Pathen capa kah mingnah dongah, lungcuei hlang pakhat la, Khrih a soepnah pumrho dongkah cungnueh dongla boeih m'pha uh duela a khueh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te daengah ni cahmang la n'om uh pawt eh. Rhaithinah neh tholhhiknah lungpoek dongla aka mawt hlang kah thailatnah loh thuituennah khohli neh a vikvawk tih boeih a yawn lah ko.
  </para>
  <para style="p">
    <verse number="15" style="v" />Oltak thui uh sih lamtah lungnah neh amah dongah boeih rhoeng uh sih. Khrih amah te a lu la om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah lamloh pum he boeih kiba tih cului uh. Rhuhcong boeih lamloh pakhat rhip kah cungnueh neh a bibi tarhing ah bomnah neh a cungvang khaw pum pakhat kah rhoengnah dongah lungnah neh amah kah hlinsainah te a khueh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Boeipa ah ni ka thui tih ka laipai. Namtom rhoek loh a lungbuei kah a honghi neh a pongpa uh bangla nangmih te pongpa uh boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A kopoek te a hmuep la a om pah tih Pathen kah hingnah te a hai coeng. A khuikah kotalhnah neh a thinko kah thinthahnah khaw om pai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amih yahdaeng rhoek loh halhkanah cungkuem neh rhongingnah bibi ham te omthenbawn dongla amah voei uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae nangmih tah tetlam te om uh boeh Khrih te mah awt uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah te na yaak uh tangloeng atah Jesuh ah oltak a om vanbangla amah dongah ni n'thuituen uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmilhmaknah kah hoehhamnah dongah aka poeih uh lamhma kah hlang rhuem omih te nangmih loh duul uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah nangmih kah lungbuei te mueihla neh thai sakuh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathen loh duengnah neh oltak kah cimcaihnah dongah n'suen vanbangla hlang thai te bai uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah laithae te duul uh sih lamtah khat rhip loh a imben taengah oltak thui uh sih. Khat neh khat pumrho lam ni n'om uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kosi na hong uh akhaw tholh puei uh boeh. Khomik loh nangmih kah thintoeknah te tlak thil boel saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Rhaithae te hmuen pae boeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aka huen loh huen voel boel saeh. Tedae amah kut neh a then saii ham thakthae lat saeh. Te daengah ni aka ngoe te aka doedan la a om eh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ol rhong ol ing boeih te nangmih kah ka lamloh thoeng boel saeh. Tedae a then pakhat a om atah a ngoe vaengkah hlinsainah la om saeh. Te daengah ni aka ya rhoek te lungvatnah a paek eh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah Pathen kah Mueihla Cim te kothet sak boeh. Amah loh tlannah khohnin ham kutnoek n'daeng coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Olkhaa cuengkuem neh thinsanah khaw, kosi neh rhungrhah khaw, soehsalnah neh phayoenah boeih khaw nangmih lamloh khoe uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah khat neh khat taengah sitloh thimhalh neh kodam la om uh. Khrih ah Pathen loh nangmih rhen bangla khat neh khat khodawkngai uh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah thintlo a ca rhoek vanbangla Pathen kah mueiloh la om uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khrih loh mamih n'lungnah dongah mamih yueng la nawnnah neh Pathen taengah hmueih botui kah a bova la amah a tloeng uh bangla lungnah dongah pongpa uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hlangcim rhoek neh a tingtawk vanbangla nangmih taengah Cukhalnah neh rhongingnah boeih khaw, halhkanah khaw phoei boel saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yahrhai neh anglat ol khaw saipaat ol te khaw a koihhilh moenih. Tedae uemonah tah lat khuehuh.
  </para>
  <para style="p">
    <verse number="5" style="v" />He aka ming long tah hlanghalh, hlang thae neh halhka te khaw boeih na hmat uh. Amah mueibawk neh aka om loh Khrih neh Pathen kah ram ah rho a khueh moenih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangmih te a hong ol neh m'hmilhmak boel saeh. He rhoek kongah Pathen kah kosi loh althanah kah a ca rhoek te a thoeng thil coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah amih taengah aka cut la om uh boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hnukbuet ah yinnah neh na om uh. Tedae Boeipa dongkah vangnah dongah vangnah kah ca rhoek bangla pongpa laeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vangnah kah a thaih tah a cungkuem dongah boethennah, duengnah neh oltak la poeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Boeipa kah kolo la aka om te khaw soepsoei uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yinnah khuikah a tlongtlai bibi dongah thum uh boeh. Tedae lat ah toeltham pa uh pataeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amih loh a huephael ah a saii te thui ham pataeng rhaidaeng la om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae vangnah loh a toeltham boeih tah phoe coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka phoe boeih tah vangnah ni. Te dongah, “Aka ip te haeng lamtah aka duek rhoek taeng lamloh thoo laeh. Te daengah ni Khrih loh nangmih n'tue eh?,” a ti pai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah na pongpa uh te khaw khaeh khaeh dawn uh. Hlangang banglam pawt tih hlangcueih la omuh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khohnin tah a thae la a om dongah a tue te tlan uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah hlang ang la om uh boeh. Tedae Boeipa kah kongaih te tah hmuhming uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah a khuiah cungpoehnah aka om misurtui te rhui uh boeh. Tedae Mueihla neh baetawt uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khat neh khat tingtoeng lung, bawknah laa, mueihla laa neh toidal uh. Boeipa te na thinko kah laa sak neh hlai uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A cungkuem dongah mamih kah Boeipa Jesuh Khrih ming neh apa Pathen te uem taitu uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khrih rhihnah dongah khat neh khat boengai uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huta rhoek aw, Boeipa taengkah bangla a va rhoek taengah boengai saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khrih tah hlangboel kah lu la om tih amah te pum kah khangkung la a om van bangla va he yuu kah a lu la om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae hlangboel loh Khrih taengah boe a ngai bangla yuu rhoek te khaw a cungkuem ah va rhoek taengla boengai van saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />tongpa rhoek , Khrih loh hlangboel te a lungnah tih anih ham amah a voeih uh van bangla yuu rhoek te lungnah uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te daengah ni ol neh tui dongkah silhnah dongah aka ciim uh te khaw a cimcaih eh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te daengah ni hlangboel te amah loh a taengah rhuepom la a pai sak eh. A tihnai neh mikmuelhnah neh te bang te pakhat khaw khueh boel saeh. Tedae a cim neh cuemthuek la om saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah tongpa rhoek long khaw a yuu rhoek te amah kah pum bangla a lungnah ham a kuek. Amah aka lungnah loh a yuu te a lungnah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amah pumsa aka hmuhuet he a om noek moenih. Tedae Khrih loh hlangboel ham a saii van bangla amah pum te a cuncah tih a yuhyam.
  </para>
  <para style="p">
    <verse number="30" style="v" />A pum dongkah a pumrho la n'om uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah tongpa loh a manu neh a napa te a imphael tak ni. Te vaengah a yuu taengah kap vetih panit te pumsa khat la om ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />He olhuep tah olpuei la om. Tedae kai loh Khrih neh hlangboel taengkah bangla ka thui.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae nangmih khaw khat rhip loh amah yuu te amah bangla lungnah van saeh. Huta long khaw a va te hinyah saeh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ca rhoek , Boeipa ah na manu na napa te olngai pah. He tah a ol dueng ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na nu neh na pa te hinyah lah. Te tah olkhueh neh olpaek lamhma la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te daengah ni nang taengah a then la ha om vetih diklai ah hingsennah na dang eh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pa rhoek long khaw na ca rhoek te a thintoek sak boeh tedae amih te Boeipa kah hlinsainah neh rhalrhingnah dongah cuncah uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sal rhoek, pumsa kah na boei rhoek taengah rhihnah neh olngai uh. Na thinko moeihoeihnah neh thuennah neh Khrih taengkah bangla omuh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mikhmuh dongkah kolopatai rhoek banglam pawt tih hinglu lamloh Pathen kah kongaih aka saii Khrih kah sal rhoek la omuh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang taengah pawt tih boeipa taengkah bangla lunghoihnah neh salbi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A then khat khat a saii te rhip ming saeh. Sal long khaw, aka loeih long khaw Boeipa taeng lamloh amah la a dang bitni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Boei rhoek nang khaw amah te te amih taengah saii uh. Amih na hihamnah te hlawt laeh. Amih rhoek neh nangmih kah boeipa tah vaan ah om tih a taengah maelhmai sawtnah khueh pawh tite ming uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tloihsoi ah boeipa neh a thadueng kah thaomnah dongah thaphoh uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rhaithae kah a lungpoek te na mah thai ham atah Pathen kah lungpok haica te bai uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thii neh pumsa kah hnueihnah te mamih taengah a om moenih. Tedae boeilu rhoek, saithainah, he yinnah khuikah diklai thaomnah, vaan ah halangnah mueihla ni m'pai thil uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Pathen kah lungpok haica te muk uh tangloeng laeh. Te daengah ni khohnin thae vaengah khaw na tungaep thai vetih aka thoeng boeih te na pai thil thai eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pai uh lamtah oltak neh na pumpu te yen uh. Te phoeiah duengnah rhangpho te bai uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rhoepnah olthangthen dongkah sikimnah neh na kho te khom uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah tangnah photling te muk uh. Te nen ni rhaithae kah thaltang a rhoh te boeih na thih uh thai eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah khangnah lumuek neh mueihla cunghang te doe thiluh. Te tah Pathen kah olthui ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thangthuinah cungkuem neh rhenbihnah dongah a tue takuem ah Mueihla neh thangthui uh. He ham he khuituknah cungkuem nen khaw, hlangcim boeih ham rhenbihnah nen khaw hak uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kai ham khaw thangthuiuh. Te daengah ni ka ka ongnah neh kai taengah olka m'paek vetih olthangthen kah olhuep te sayalh la ka phong thai eh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te yueng la thirhui neh ka laipai. Te daengah ni a khuiah ka thui a kuek te tah ka sayalh van eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te daengah ni kai kawng he na ming uh van pueng eh. Ka saii boeih te thintlo manuca neh Boeipa dongah uepom tueihyoeih Tukhiko loh nangmih taengla ham phoe puei bitni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amah te ham ni nangmih taengla anih kan tueih. Te daengah ni kaimih kawng te na ming vetih nangmih kah thinko te han hloep eh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pa Pathen neh Boeipa Jesuh Khrih lamkah rhoepnah, tangnah neh lungnah tah manuca rhoek taengah om saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lungvatnah tah mamih kah boeipa Jesuh Khrih te a cak la aka lungnah rhoek boeih soah om saeh.
  </para>
</usx>
