<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MRK" style="id">Marku</book>
  <para style="h">Marku</para>
  <para style="toc1">Marku</para>
  <para style="toc2">Marku</para>
  <para style="mt">Marku</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen Capa Jesuh Khrih kah olthangthen a tongnah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tonghma Isaiah dongah a daek tangtae bangla, “Nang hmai ah kamah kah puencawn kan tueih ne, anih loh na longpuei te a rhoekbah ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khosoek ah pang ol loh , “Boeipa kah longpuei te rhoekbah uh'a caehlong te a dueng la saii uh ,” a ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan tah khosoek ah aka nuem la om tih tholh khodawkngainah dongah yutnah baptisma a kawng thui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Judah kho boeih neh Jerusalem pum loh anih taengla khong uh. Te vaengah a tholhnah te a phong uh tih Jordan tuiva ah Johan loh a nuem.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah aka om Johan loh kalauk mul a bai tih, a pumpu ah maehpho cihin a naak tih tangboeng neh kohong khoitui te a caak.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hoe vaengah, “Kai lakah aka len tah kai hnukah ha pawk. A taengah ka buluk tih a khokhom rhui hlam ham pataeng ka koih pawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai loh nangmih te tui ah kan nuem, dae anih long tah nangmih te Mueihla Cim ah n'nuem ni,” a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tekah khohnin a pha vaengah Jesuh khaw Galilee kah Nazareth lamkah halo tih, Jordan ah Johan loh a nuem.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tui khui lamkah koe a thoh vaengah vaan te ong uh tih Mueihla te vahu bangla a soah a rhum te a hmuh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah vaan lamkah ol ha thoeng tih, “Nang tah Capa ka thintlo la na om, nang taengah ka lungtlun,” a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah anih te Mueihla loh khosoek la thaeng a khuen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khosoek ah khohnin sawmli a om vaengah Satan loh a cuek. Te vaengah satlung taengah khaw om dae anih te puencawn rhoek loh a khut uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Johan te a voeih uh phoeiah Jesuh tah Galilee la pawk. Te vaengah Pathen kah olthangthen te a hoe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah, “A tue te soep coeng tih Pathen ram tah yoei coeng, yut uh lamtah olthangthen te tangnah uh laeh,” a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Galilee tuili kaengah a caeh vaengah, Simon neh Simon mana Andrew tah tuihoi la om rhoi tih tuili ah lawk ana voeih rhoi te a hmuh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Jesuh loh amih rhoi te , “Kai hnukah bang rhoi lamtah nangmih rhoi te hlang aka tu tuihoi la om ham kang khueh eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah lawk na te pak a hlah rhoi tih Jesuh te a vai rhoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae hawt a caeh vaengah Zebedee capa James neh a mana Johan te a hmuh. Te vaengah amih rhoi te lawng khuiah lawk a bo rhoi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah amih rhoi te pahoi a khue hatah a napa Zebedee neh lawng khuiah a kutloh rhoek te pak a hlah tih amah hnukah cet rhoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kapernaum la a kun uh vaengkah Sabbath ah tah tunim la tlek kun tih a thuituen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah anih kah thuituennah soah let uh. Amih a thuituen te saithainah aka khueh la om tih cadaek rhoek bangla om pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amih kah tunim ah hlang pakhat tah mueihla thae neh lawt om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah pang tih, “Nazareth Jesuh kaimih neh nang te mebang tloe lae? Kaimih he poci sak ham nim na pawk ? Nang unim ti khaw kam ming ta, Pathen kah hlangcim la,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Jesuh loh anih te a ho tih, “Paa lamtah anih lamloh cet laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah mueihla thae loh anih te a suvaih sak. Te phoeiah ol a len la pang tih anih lamloh coe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah boeih a ngaihmang uh. Te dongah amamih te oelh uh thae tih, “Metlam nim he? Saithainah neh thuituennah a thai loh , mueihla thae rhoek pataeng a tueih vaengah a ol a ngai uh ,” a ti uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah a olthang tah Galilee pingpang khotomrhali boeih ah cet khonghak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah tunim lamloh tlek cet uh tih James neh Johan khaw, Simon neh Andrew im la pawk uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae Simon masae tah tlo tih yalh. Te dongah anih ham te Jesuh taengah tlek a thui uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah a paan tih a kut te a tuuk pah. Anih te a thoh vaengah anih te satloh loh a hlah tih amih te a kok.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hlaem a pha tih khomik a tlak vaengah tloh aka khueh rhoek neh rhaithae aka kaem boeih te Jesuh taengla a khuen uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah kho pum ah aka om te thohka ah tingtun uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te phoeiah tlohtat soeprhep aka khueh hlangtlo muep a hoeih sak. Rhaithae khaw muep a haek. Tedae amah te aming uh dongah rhaithae rhoek te cal sak pawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae khohmuep aih. ah yueya thoo tih aka nong te khosoek hmuen la cet tih thangthui.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah Simon neh a taengkah rhoek loh Jesuh hnuk a dawn uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae Jesuh te a hmuh uh vaengah a taengah, “Nang te boeih n'toem,” a ti na uh .
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah amih te, “Kho om nah takuem ah cet uh sih lamtah, teah khawka hoeeh. Te hamni ka lo rhoe,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah Galilee pum ah cet tih amih kah tunim ah olthangthen a hoe phoeiah rhaithae te a vai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah, hmaibae pakhat tah anih taengah pawk tih a hloep phoeiah a cungkueng thil. Te phoeiah Jesuh te , “Boeipa na ngaih koinih kai he nan cim sak thai ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te vaengah a thinphat tih a kut te a yueng. Anih te a taek tih, “ Ka ngaih ta, cim saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te vaengah hmaibae tah anih lamloh pahoi nong tih cim.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te phoeiah thanueih ah anih te tlek a tueih.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tedae anih te, “Na thui loeng loeng pawt ham ngaithuen. Namah cet lamtah khosoih na tueng phoeiah na cimcaihnah dongah Moses loh a uen te tah nawn pah. Te tew amih taengah paipueinah la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tedae a caeh neh a tong tih pung a hoe dongah ol te yilhcet. Te dongah Jesuh tah kho khuiah loloh kun thai voel pawh. Te phoeiah tah khosoek hmuen ah vawl om dae anih te a taengvai lamloh a paan uh.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khohnin a di phoeiah Kapernaum la koep kun tih im ah om tila a yaak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah muep tingtun uh tih thohka pataeng te hoeng pawh. Te vaengah amih ham ol a thui pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah aka khawn te pali loh Jesuh taengla khuen ham a koh uh tih ha pawk uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae hlangping kongah a taengla a khuen thai pawt dongah a om nah tueng kah imphu te a hlih uh. Te phoeiah a ong uh tih aka khawn te phakdoeng dongah a yalh doela a hlak uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesuh loh amih kah tangnah te a hmuh vaengah aka khawn te, “ Ka ca, tholhnah loh nang n'hlah coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae cadaek khuikah hlangvang aka om rhoek tah pahoi ngol uh tih a thinko khuikah,
  </para>
  <para style="p">
    <verse number="7" style="v" />“ Balae tih anih hetla a cal, a soehsal coeng he ta. Pathen pakhat long pawt atah tholhnah aka hlah thai te unim? ” tila a poek uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A khuiah te tla a poek uh te Jesuh loh a mueihla neh tlek a ming. Te dongah amih te, “Balae tih na thinko ah he he na poek uh?”
  </para>
  <para style="p">
    <verse number="9" style="v" />Aka khawn te, ‘Tholhnah loh nang n'hlah coeng , ‘ti nah ham neh, ‘Thoo lamtah na phakdoeng te kawt lamtah cet, ‘ti nah ham te melae yoeikoekla aka om?
  </para>
  <para style="p">
    <verse number="10" style="v" />Te daengah ni, Hlang capa loh diklai hmanah tholhnah te hlah ham saithainah a khueh te na ming uh eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka khawn te, “Namahtaengah kan thui, thoo, na phakdoeng te kawt lamtah namah im la cet laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah thoo tih hlang boeih hmaiah phakdoeng te pahoi a loh tih cet. Te dongah boeih limlum uh tih Pathen te thangpom ham, “He tlam he m'hmuh noek moenih,” a ti uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuili kaengah koep a caeh vaengah hlangping loh a taengla boeih ha pawh uh tih amih te a thuituen.
  </para>
  <para style="p">
    <verse number="14" style="v" />A khum phai vaengah, mangmu doenah ah aka ngol Alphaeus capa Levi te a hmuh tih, “ Kai m'vai lah,” a ti nah. Te dongah thoo tih Jesuh hnuk a vai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Levi im ah om tih buh a vael. Te vaengah mangmucoi rhoek neh hlangtholh rhoek tah Jesuh neh a hnukbang rhoek taengah muep ngol uh. Te phoeiah anih aka vai rhoek khaw muep om uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />hlangtholh rhoek neh mangmucoi rhoek taengah a caak te Pharisee rhoek kah cadaek rhoek loh a hmuh uh vaengah a hnukbang rhoek taengah, “Mangmucoi rhoek neh hlangtholh rhoek taengah khaw a caak mai ke,” a ti na uh .
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesuh loh a yaak vaengah amih te, “Sading loh siboei ngoe pawt tih, tloh aka khueh long ni a ngoe. Aka dueng rhoek khue ham pawt tih hlangtholh rhoek ham ni ka pawk,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Johan kah hnukbang rhoek neh caak aka yaeh Pharisee rhoek tah ha pawk uh. Te vaengah cet uh tih Jesuh taengah, “Balae tih Johan kah hnukbang rhoek neh Pharisee rhoek kah hnukbang rhoek tah a yaeh uh tih na hnukbang rhoek tah a yaeh uh pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesuh loh amih te, “Yulueihmuen kah paca boeina a om vaengah tah coeng mahpawh. Yulokung loh amih taengah a om vaengah a yaeh aya? Amih te yulokung neh a om uh tue khuiah yaeh uh thai mahpawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae khohnin a pai vaengah yulokung tah amih taeng lamkah loh a khue vetih te vaeng khohnin ah a yaeh uh bitni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hni pen a cuemsok te himbai rhuem soah a hui moenih. Te pawt koinih a bonah rhuem te a thai loh a sol tih a pawnnah te a thae om.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah misurtui noe te tuitang rhuem khuiah a than uh moenih. Te pawt koinih misurtui loh tuitang te a va vetih, misurtui khaw, tuitang khaw poci ni. Te dongah misurtui noe te tuitang a thai khuiah ni a khueh,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sabbath a pha vaengah Jesuh te canghli longah van. Te vaengah a hnukbang rhoek loh longpuei ah cangvuei koe a yun uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah Pharisee rhoek loh Jesuh taengah, “Sabbath ah saii tueng pawt te balae tih a saii ke,” a ti na uh .
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah amih te, “David loh a saii te na tae uh mahnim? Amah neh a taengkah rhoek loh a ngoe tih a bungpong uh vaengkah te.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khosoihham Abiathar tue vaengah Pathen im la kun tih rhungkung buh a caak te ta. Te te khosoih pawt atah a caak tueng moenih. Tedae a taengah aka om rhoek pataeng a paek pueng,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah amih te, “Sabbath tah hlang ham a ni a saii, tedae hlang tah Sabbath ham moenih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah Hlang Capa tah Sabbath boeipa la om pataeng,” a ti nah.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah tunim la koep a kun hatah, kut a koh la aka om hlang pakhat tapkhoeh om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah anih te Sabbath ah a hoeih sak atah paelnaeh hamla Jesuh te a dawn uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Jesuh loh kut a koh la aka om hlang te, “ A laklung ah pai lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah amih te, “Sabbath ah hno then saii ham pawt atah thae ham, hinglu hlawt ham pawt atah ngawn ham a? a ngaih?” a ti nah. Tedae amih loh a hil a phahuh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah amih te thintoek neh a sawt. Amih thinko kah thinthahnah soah a kothae. Tekah hlang te, “ Na kut te yueng lah,” a ti nah. A yueng tangloeng tih a kut khaw hoeih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Pharisee rhoek tah Herod kah hlang rhoek taengla tlek cet uh tih Jesuh poci ham dawtletnah a khueh thil uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesuh tah a hnukbang rhoek neh tuili la a caeh uh hatah Galilee rhaengpuei loh muep a vai uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Judea lamkah, Jerusalem kah, Idumea kah, Jordan rhalvangan, Tyre taengvai neh Sidon lamkah rhaengpuei boeih nehabisaii boeih te aka ya rhoek loh a taeng la ha pawk uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae a hnukbang rhoek te, “ Amah ham lawng mah khuituk, hlangping te a khuiah thet pawt nim,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah hlang muep a hoeih sak dongah tloh aka khueh boeih loh Jesuh te taek sak ham amah te a nan uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rhalawt mueihla loh anih a hmuh uh vaengah a bakop thil uh tih a pang doela, “Nang tah Pathen Capa ni,” a ti uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae amah te kawng te mingpha la ng'khue pawt ham amih te khak a uen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Jesuh tlang la luei hang tih a ngaih rhoek te a khue dongah a taengla cet uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah hlainit a tuek tih amih te caeltueih la a khue bal. Te daengah ni amah taengah om uh vetih olthangthen aka hoe la,
  </para>
  <para style="p">
    <verse number="15" style="v" />saithainah aka khueh la, rhaithae aka haek la amih te a tueih pai eh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengkah Simon la ming aka pae Peter,
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebedee kah capa James neh James kah manuca Johan amih rhoi te Boanerges ming a paek. Te tah rhaek capa rhoi ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Andrew, Philip, Bartholomew, Matthai, Thomas, Alphaeus capa James, Taddaeus, neh Kanaan Simon,
  </para>
  <para style="p">
    <verse number="19" style="v" />amah aka voei Judah Iskariot tila hlainit te a tuek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah im khuila a caeh hatah hlangping loh koep a tingtun pah. Te dongah amamih khaw coeng thai pawt tih buh ca uh pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A taengkah rhoek loh a yaak uh vaengah, “Limlum coeng,” a ti uh tih amah te tuuk hamla cet uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah cadaek rhoek tah Jerusalem lamloh suntla u tih, “Beezebul a khueh dongah ni rhaithae boei rhangneh rhaithae te a haek,” a ti uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae amih te a khue tih nuettahnah neh amih taengah, “Satan loh Satan te a haek ham coeng thai aya te?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ram pakhat tah amah te a paekboe coeng atah tekah ram te a pai thai moenih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah im khaw amah a paekboe koinih tekah im te pai thai mahpawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Satan loh amah te pai thil tih paekboe koinih pai thai pawt vetih a palthamnah la om ni ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae Hlang tlung te lamhma la a pin pawt atah hlang tlung kah im ah hnopai te muk ham a kun thai loeng loeng moenih. A pin phoei daengah ni a im te a muk pa eh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih taengah rhep kan thui, tholhsainah neh soehsalnah neh aka soehsal uh hlang ca rhoek te tah boeih a hlah ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Mueihla Cim taengah aka soehsal te tah kumhal duela khodawkngainah om mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae, “Rhalawt mueihla a kaem,” a ti uh dongah dungyan tholhsainah om kuekluek coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah a manu neh a mana rhoek te ha pawk uh. Tedae poengben ah pai uh tih Jesuh aka khue ham te a tueih uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah a taengkah kah aka ngol hlangping loh , “Na nu, na mana rhoek neh na ngannu rhoek loh poengben ah nang n'toem uh ke,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae amih te a doo tih, “Kai manu neh kai manuca rhoek te unim? unim manuca rhoek la aka om?” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te phoeiah a taengvai ah aka ngol rhoek te a sawt tih, “Ka manu neh ka manuca rhoek la he,
  </para>
  <para style="p">
    <verse number="35" style="v" />Pathen kah kongaih aka saii rhoek te tah ka manuca, ka ngannu neh ka manu la om,” a ti nah.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuili kaengah khaw thuituen ham koep a tong tih hlangping loh a taengah a kumngai a tingtun pah. Te dongah amah te tuili kah lawng khuiah ngol hamla kun. Te vaengah hlangping tah tuili taengkah lan soah boeih om uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah amih te nuettahnah neh muep a thuituen tih a thuituennah dongah amih te,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Hnatun uh lah, cangti aka tuh tah cangti tuh ham cet ne.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tuh la a om vaengah a ngen tah long ah tla. Te dongah vaa loh a paan tih a kueh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah a tloe tah laimen muep aka om pawh lungrhong soah tla tih laimen a dung la a om pawt dongah tlek poe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae khomik a thoeng vaengah a kaeng atah a yung a om pawt dongah koh
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah a tloe tah hling khuiah tla. Hling te a rhoeng vaengah cangti te a thing tih a thaih thaii pawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah, a tloe rhoek tah lai then dongah tla. Te dongah a poe vaengah rhoeng tih a thaih thaii tih a ngen thumkip, a ngen sawmrhuk, a ngen yakhat lo,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah, “ Yaak nah hna aka khueh loh ya saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah amah bueng a om vaengah, a taengvai rhoek neh hlainit rhoek loh nuettahnah te a dawt uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah amih te, “Pathen ram kah olhuep te nangmih m'paek coeng. Tedae poengben kah rhoek ham tah soeprhep boeih te nuettahnah la a om pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te daengah ni a hmuh tah a hmuh uh sui dae a hmat uh pawt eh, a yaak tah a yaak uh sui dae a hmuhming uh pawt eh. Ha mael uh vetih amih te vik hlah ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah amih te, “Hekah nuettahnah he na ming uh pawt atah nuettahnah boeih te metlam na ming uh eh?
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka tuh loh olthangthen ni a tuh.
  </para>
  <para style="p">
    <verse number="15" style="v" />He tah longpuei kaep kah a soem ol te ni. A yaak vaengah Satan tlek cet tih amih khuiah a soem ol a loh pah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah he rhoek tah lungrhong sokah a haeh rhoek ni. Te rhoek loh ol te a yaak uh vaengah omngaihnah neh tlek a doe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae a khuiah a yung om uh pawt tih kolkalh bueng omuh. Te phoeiah olka kongah phacipphabaem neh hnaemtaeknah a om atah voeng a khah uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A tloe rhoek hling lakli ah a tuh khaw om. Te rhoek khaw ol aka ya rhoek ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae diklai kah mawntangnah, khuehtawn kah hmilhmaknah neh a tloe boeih ham hoehhamnah ha pawk vaengah ol te a thing tih a tlongtlai la poeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae lai then ah tuh la aka om rhoek tah ol te a yaak uh vaengah a doe uh tih a ngen tah thumkip, a ngen tah sawmrhuk, a ngen tah yakhat la thaihtak,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah amih te, “Hmaiim te voh hmui neh thingkong hmuiah khueh ham a hang khuen? Hmaitung soah a khueh ham moenih a?
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah a huephael akhaw a phoe mueh la a om moenih. A huep te a thoeng mueh moenih. Te van daengah ni mingpha la a om eh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yaak nah hna aka khueh long te tah ya saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah amih te, “Na yaak uh te poek uh, na nueh nah cungnueh nen te nangmih n'nueh van vetih nangmih taengah han thap ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aka khueh te tah a paek thil vetih aka khueh pawt te a khueh duen te anih taeng lamloh a lat pah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah, “ Pathen ram tah diklai dongah cangtii aka haeh hlang bangla om tangloeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae khoyin khothaih ip vaeng thoo vaeng cakhaw cangtii daih tih a rhoeng te a ming moenih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Diklai amah loh a thaihtak sak tih lamhma la cangkung, te phoeiah cangvuei, cangvuei khuiah cangyen a bae sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae cangvuei loh hmin tih cangah a pha atah vin tlek a pom,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah Jesuh loh, “Pathen ram he metlam n'thuidoek vetih mebang nuettahnah nen n'nueh lah ve?
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen ramtah mukang mu bangla om. Te te diklai dongah a haeh vaengah tah diklai hmankah a tii boeih lakah a yit koek la om.
  </para>
  <para style="p">
    <verse number="32" style="v" />A haeh phoeiah rhoeng tih toian boeih lakah a tanglue la coeng, a hlaeng khaw a len la cawn. Te dongah vaan kah vaa khaw a hlipkhup ah bu a tuk thai,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />A yaak thai la hebang nuettahnah neh amih taengah ol muep a thui pah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nuettahnah pawt atah amih taengah a thui moenih. Tedae a hnukbang rhoek ham bueng ni boeih a thuicaih pah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te khohnin hlaem a pha vaengah amih te, “Rhlavangan la lan uh sih,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah hlangping te a hlah uh tih lawng khuiah aka om Jesuh te pahoi a khuen uh. Lawng tloe rhoek khaw Jesuh taengah om uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah khohli aka tlo hlipuei te hli. Te dongah tuiphu loh lawng te a boh dongah lawng dalh buek.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae Jesuh tah a maicaem ah om tih luhoe dongah ip. Te vaengah amah te a thoh uh tih, “Saya, m'poci coeng he, na ngaihuet moenih a?” a ti na uh .
  </para>
  <para style="p">
    <verse number="39" style="v" />A haeng vaengah khohli te a ho tih tuili te, “ Paa lamtah duem laeh,” a ti nah. Te dongah khohli te paa tih suepduem la boeih om.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te phoeiah amih te, “Balae tih rhalyawp la na om uh? Tangnah na khueh uh hlana?” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tedae a rhih uh tih a rhihnah uh khaw khosava. Te dongah khat neh khat, “Unim he, tuili neh khohli long pataeng boe a ngai pah he?” a ti uh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah tuili rhalvangan Gerasenes kho la pawk uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lawng lamkah loh a suntlak vaengah hlan lamkah rhalawt mueihla neh hlang pakhat loh Jesuh te tlek a doe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih tah a khosaknah te phuel ah a khueh tih thirhui neh pin ham khaw anih aka noeng te a om loengloeng voel moenih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih te hloong, thirhui neh a pin uh taitu dae thirhui te a thuek tih hloong te a tlawt sak dongah anih te sim uh thai pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khoyin khothaih phuel ah khaw, tlang ah khaw vawpvawp pang yoeyah tih amah te lungto neh huet uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesuh te a hla lamloh a hmuh vaengah yong tih a bawk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah ol ue la pang tih, “Khohni Pathen Capa Jesuh, nang neh kai balae benbo benpang? Pathen rhangneh nang taengah ol ka hlo, kai he n'phaep mai boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah anih te, “Mueihla thae aw, hlang taeng lamkah loh coe laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah anih te, “Ulae na ming nah,” a ti nah hata, “Muep ka om uh dongah, kai ming tah caempuei caempa ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah amih te ram lamkah loh voelh tueih pawt ham Jesuh taengah khak a bih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae a yoei la tlang tapkhoeh om tih ok hui muep luem.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Jesuh te a hloep uh tih, “Kaimih he ok rhoek khuila n'tueih mai lamtah te rhoek khuiah ka kun uh mai eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah amih te a caeh sak. Tedae mueihla thae rhoek tah cet uh tih, ok khuiah kun uh. Te dongah ok hui tah laengpoeng ah tuili khuila cu uh tih thawnghnih tluk tah tuili ah buek uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ok aka luempuei rhoek khaw rhaelrham tih khopuei khui neh lohma ah khaw puen uh. Te dongah aka thoeng hno te metla a om khaw hmuh hamla cet uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesuh taengla a pawk uh vaengah rhaithae aka kaem a ngol te a hmuh uh. Anih te yol uh tih muet uh. Anih te caempuei caempa a khueh dongah a rhih uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah rhaithae aka kaem taengah aka thoeng hno neh ok kawng te aka hmu rhoek loh amih taengah a thui pauh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah amih vaang lamloh nong hamla Jesuh te a hloep uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lawng khuiah a kun vaengah rhaithae aka kaem loh a taengah om ham a bih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah anih te a hlah pak moenih. Tedae amah te, “Namah im la cet lamtah nahuiko rhoek taengah Boeipa loh nang ham a saii tih nang ng'rhen boeih te amih taengah puen pah,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah cet tih, Jesuh loh anih ham a saii boeih te Decapolis ah a tong tih a hoe hatah hlang boeih loh a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesuh te lawng neh rhalvangan la koep a hlaikan hatah a taengah hlangping hut a tingtun pa tih tuili kaengah vik om.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah tamtaeng pakhat, a ming ah Jairus te ha pawk tih Jesuh te a hmuh neh a kho taengah bakop.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesuh te tlal a hloep tih, “Ka canu tah duekhlong coeng. Na lo vetih anih te kut na tloeng thil daengah ni daem vetih a hing eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah anih taengla a caeh vaengah hlangping loh muep a vai tih Jesuh khaw a nen uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah kum hlainit khuiah thii aka buk huta pakhat om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Siboei tom taengah khaw muep patang coeng tih a taengkah khaw boeih vak coeng. Tedae hoeikhang pawt tih a thae la lat a om pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesuh kah a thang te a yaak vaengah hlangping lakli la cet tih a hnuk lamloh Jesuh kah himbai te a taek.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amah long tah, “A himbai mah ka taek koinih ka hoeih ni,” a ti.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah a thii tuisih bang te khaw pahoi a khaam pah tih a pum khaw nganboh lamloh hoeih coeng tila a ming.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amah pum lamkah thaomnah a coe te Jesuh amah loh tlek a ming vaengah hlangping taengla mael tih, “Ulae kai himbai aka taek?,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah a hnukbang rhoek loh a taengah, “Hlangping loh nang n'nen te na hmuh lalah, 'Ulae kai aka taek,’ na ti,” a ti na uh .
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae te aka saii te hmuh ham a sawt.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huta long khaw a taengah aka thoeng te a ming dongah a rhih neh birhih coeng. Te dongah a paan tih bakop doela Jesuh taengah oltak te boeih a thui pah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah anih te, “Ka canu, na tangnah loh nang ng' khang coeng, ngaimong la cet lamtah na tlohtat lamkah loh sading la om laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />A thui li vaengah, tamtaeng im lamkah aka pawk rhoek loh , “Na canu te duek coeng, baham nim saya te khing na toeh na oeih,” a ti na uh .
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae a thui ol soah Jesuh tah altha tih tamtaeng te, “ Rhih boeh, dawk tangnah,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah Peter neh James, James mana Johan pawt atah ukhaw a hnuk bang sak pawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te phoeiah tamtaeng im la pawk uh. Te vaengah olpungnah khaw, a rhah neh vangvang a kii uh khaw a hmuh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah kun tih amih te, “Balae tih sarhingrhup la na rhah uh? Camoe he a duek moenih, aka ip ni he,” a ti nah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah Jesuh te a nueih thiluh. Tedae Jesuh loh amih te boeih a haek. Te phoeiah camoe kah a manu napa neh a taengkah rhoek te a khuen tih camoe a om nah la kun.
  </para>
  <para style="p">
    <verse number="41" style="v" />Camoe kah kut te a tuuk tih, “ Talitha kumi (Te tah hula ni a thuingaih), nang 'Thoo'ka ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te vaengah hula te koe thoo tih cet. Anih te kum hlainit lo coeng. Te dongah mueimang bangla sut limlum uh pahoi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tedae te te hlang ming sak pawt hamla amih te rhep ol a paek phoeiah, “A caak koi pae lah,” a ti nah.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te lamloh thoo tih amah tolrhum la a caeh vaengah a hnukbang rhoek loh a vai uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sabbath a pha neh tunim ah thuituen ham te a tong. Te vaengah aka ya rhoek boeih loh let uh tih, “Anih loh hebang he mekah lae a hmuh? Mekah cueihnah nim anih a paek tih a kut neh hebang thaomnah he a tueng sak?
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih he Mary capa, James, Joses, Judah neh Simon kah a manuca, lettama la a om moenih a? A ngannu rhoek khaw mamih taengah a om uh moenih a he? ” a ti uh. Te dongah anih kongah te amih te a khah uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Jesuh loh amih te, “Tonghma he a tolrhum ah, a hui rhoek lakli neh a im khuikah pawt atah sawtsit ti om pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae hlang tlo a yool kut a tloeng tih hoeih sak pawt koinih te ah te a thaomnah pakhat khaw tueng thai mahpawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amih kah hnalvalnah kongah a ngaihmang. Tedae kho kah a taengvai te a hil tih a thuituen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlainit te a khue phoeiah rhalawt mueihla soah saithainah te amih taengah a paek tih amih te panit panit ah a tueih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah amih te longpueng ah conghol bueng pawt atah buhcun, sungsa, cihin khuiah rhohum khaw khuen pawt ham a uen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae khokhom a khom tih angki yung nit puei sak pawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah amih te, “Im na kun thil uh coeng te tah te lamkah loh na voei hlan khuiah pahoi naeh thil.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih aka doe pawt tih nangmih kah ol aka hnatun pawt hmuen te tah, te lamkah loh na nong uh vaengah na kho hmuikah tangdik te khoek uh lamtah amih taengah laipai la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te daengah cet uh tih tholh yut ham a hoe uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rhaithae khaw Gmuep a haek uh. Aka tlo khaw situi neh a hluk uh tih muep hoeih uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesuh ming tah mingpha coeng tih Herod manghai loh a yaak vaengah, “Tui aka nuem Johan tah duek lamkah thoo coeng. Te dongah a khuikah thaomnah loh a tueng pah,” a ti uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae a tloe rhoek loh , “Elijah ni,” a ti uh. A tloe rhoek bal loh , “Tonghma rhoek khuikah tonghma pakhat van coini,” a ti uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Herod loh a yaak vaengah, “Kai loh ka rhaih Johan te ni aka thoo coeng,” a ti
  </para>
  <para style="p">
    <verse number="17" style="v" />Herod amah rhoe loh a tah tih Johan te a tuuk. Te vaengah anih te a manuca Philip yuu, Herodias kawng neh thongim ah a khoh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih te a yunah dongah Johan loh Herod te, “Na maya yuu te na loh tueng moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah Herodias loh Johan te a hmuhuet tih ngawn ham a ngaih dae ngawn thai pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Herod loh Johan te aka dueng neh aka cim hlang ni tila a ming dongah a rhih tih a tuem. Johan ol a yaak vaengah muep ingang dae liplip a hnatun.
  </para>
  <para style="p">
    <verse number="21" style="v" />Herod loh cunnah khohnin tapkhoeh a pha vaengah a hlanglen rhoek, rhalboeipa rhoek, Galilee kah a congkhang rhoek ham te hlaembuh a saii pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah Herodias canu te kun tih a lam hatah Herod neh aka ngol rhoek te a ko a hoe sak. Manghai loh hula te, “Na ngaih te tah kai taengah ham bih lamtah nang kan pae eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah anih taengah rhep a toemngam tih, “Kai taengah na bih te tah ka ram rhakthuem hil khaw nang kan paek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae cet tih a manu taengah, “Balae ka bih eh?” a ti nah hatah a manu loh, “Tuinuem Johan kah a lu te,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah manghai taengah thahluenah neh thaeng kun tih, “Baelpuei dongah tuinuem Johan kah a lu te kai nan paek pahoi hamla ka ngaih,” a ti nah tih a bih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Manghai loh ngang a yaak dae a olhlo neh aka ngol rhoek kongah te aal hamla ngaih pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae manghai loh rhalkap koe a tueih tih a lu te hang khuen ham ol a paek. Te dongah cet tih Johan te thongim khuiah a rhaih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Johan kah lu te baelpuei dongah han khuen tih hula te a paek. Hula long khaw a manu te a paek.
  </para>
  <para style="p">
    <verse number="29" style="v" />A yaak uh vaengah Johan kah hnukbang rhoek tah ha pawk uh tih a rhok te a khuen uh tih phuel ah a khueh uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah caeltueih rhoek te Jesuh taengah tingtun uh tih a saii neh a thuituen uh boeih te a taengah puen uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah amih te, “Nangmih tah namamih bueng mah khosoek hmuen la halo uh lamtah rhaih duem uh dae,” a ti nah. Aka voei rhoek neh aka bal rhoek te muep a om vaengah buh caak ham pataeng hoeng uh pawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah amamih bueng khosoek hmuen la lawng neh cet uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amih a caeh uh te a hmuh uh tih muep a ming uh vaengah kho tom lamloh kho neh capit uh tih ana lamhma uh coeng.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae a caeh vaengah hlangping te muep a hmuh. Te vaengah tudawn aka om pawh tu rhoek bangla a om uh dongah amih soah a thinphat tih amih rhoek te muep pahoi a thuituen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kholaeh tue a pha coeng atah a hnukbang rhoek loh amah te a paan tih, “Khosoek hmuen la om tih a tue khaw kholaeh coeng.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amih he n'tueih daengah ni a taengvai kah lohma neh vangca la cet uh vetih amamih caak te khaw a lai uh eh,” a ti nauh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae Jesuh loh amih te a doo tih, “Amih te caak koi nangmih loh pae uh,” a ti nah. Te vaengah amah taengah, “Ka cet uh vetih denari yahnih phu vaidam ka lai uh mako, te phoeiah amih caak te ka paek uh mako,” a ti uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah Jesuh loh amih te, “Vaidam meyet na khueh uh? Cet uh lamtah so uh lah,” a ti nah. Te daengah a ming uh tih, “Vaidam hluem nga neh nga lung nit om,” a ti na uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te phoeiah amih te, khopol hing soah a boel boel la boeih ngolhlung sak ham a tueih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah sawmnga ah yakhat ah hloep hloep ngol uh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te vaengah vaidam hluem nga neh nga lung nit te a doe. Vaan la oeloe tih a uem phoeiah vaidam te a aeh tih hlangping paek ham a hnukbang rhoek te a paek. Nga rhoi te khaw boeih a rhek.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te vaengah boeih a caak uh tih hah uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te phoeiah nga neh vaidam kah a nueipil te voh hlainit dongah a bae la a phueih uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te vaengah vaidam aka ca rhoek te tongpa thawngnga lo uh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te Phoeiah hlangping te a tueih hlan ah a hnukbang rhoek te lawng khuiah a kun sak tih rhalvangan kah Bethsaida la lamhma phai ham tlek a tanolh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Amih te a phih phoeiah thangthui ham tlang la cet.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hlaem a pha vaengah lawng te tuili kah laklung ah om tih amah bueng lan ah om.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hnukbang rhoek tah khohli loh a kingkalh la a mang dongah lawng a kaih loh a ngawn uh tea hmuh. Khoyin khonoek pali vaengah tuili soah cet tih amih taengla pawk. Tedae amih khum tak hamla a ngaih.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tedae tuili soah a caeh te a hmuh uh vaengah mueihla ni tila a poek uh tih pang uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Amah te boeih a hmuh uh vaengah thuen uh. Tedae amih te tlek a voek tih, “Ngaimong sak uh, Kai ni, rhih uh boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te phoeiah amih taengah lawng dongla luei tih khohli khaw paa. Te dongah amamih khuiah a nah la mat limlum uh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Vaidam kawng pataeng hmuhming uh pawt dae a thin te a ning sak uh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Lan la hlaikan uh tih Gennesaret a pha uh vaengah duem uh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Lawng dong lamkah loh a suntlak uh vaengah Jesuh te kawl a hmat uh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Kho tom a hil uh dongah tloh aka khueh rhoek te, Jesuh om tila a yaak nah la phakdoeng dongah koe a koh uh.
  </para>
  <para style="p">
    <verse number="56" style="v" />Amah a kun nah te tah vangca ah khaw, khopuei ah khaw, lohma ah khaw, hnoyoih hmuen ah khaw tattloel rhoek te a tloeng pauh. Te vaengah a himbai dongkah salaw te taek ham pataeng anih te a hloep uh. Te dongah anih aka taek rhoek boeih tah daem uh.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Pharisee rhoek neh cadaek rhoek hlangvang te Jerusalem lamkah ha pawk uh tih Jesuh taengah tingtun uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah a hnukbang rhoek hlangvang te a kut kutmuen neh tanghnong tangaih la buh a caak uh te a hmuh uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Patong rhoek kah singyoe aka pom Pharisee rhoek neh Judah rhoek boeih loh kut te hlaengtangnah pawt atah caak a caak moenih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hnoyoih hmuen lamkah a bal uh vaengah khaw tui a hluk uh pawt atah caak ca uh pawh. Te phoeiah a tloe boengloeng, tui-um, tuidueh neh thingkong te silh ham duela a loh uh tih aka pom te muep om uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Pharisee rhoek neh cadaek rhoek loh, “Balae tih patong rhoek kah singyoe bangla na hnukbang rhoek a caeh uh pawt tih kut tanghnong neh buh a caak uh?” a ti na uh .
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah amih taengah, “Pilnam long he a hmui neh kai hinyah dae a thinko tah kai lamloh voelh nong, “tila a daek tangtae bangla nangmih hlangthai palat ham Isaiah loh a phong te thuem coeng”.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang olpaek dongkah thuituennah bangla a thuituen uh tih a poeyoek la kai m'bawk uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen kah olpaek aka hlahpham rhoek loh hlang kah singyoe te na muk uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah amih te, “Namamih kah singyoe te thoh ham dongah Pathen kah olpaek te na hnawt uh pai he.
  </para>
  <para style="p">
    <verse number="10" style="v" />Moses loh, 'Na nu neh na pa te hinyah. Tedae nu neh pa aka thet tah dueknah neh duek saeh,’ a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae nangmih tah hlang loh a manu neh a napa te, 'Kai lamkah na hoeikhangnah koi te Korban Te tah kutdoe la om ni,’ a ti atah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah a manu a napa taengah a saii ham te pakhat khaw anih taengah na hlah pah uh moenih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangmih kah singyoe na pang uh te Pathen kah olka tah a hmil tih amah boeiloeih te muep na saii uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlangping te khaw koep a khue tih, “Hlang boeih loh kai taengah hnatun uh lamtah hmuhming uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlang kah a hmanhu ah om tih a khuila aka kun loh anih te a poeih thai moenih. Tedae hlang lamkah aka thoeng tah hlang aka poeih la om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yaak nah hamla hna aka khueh loh ya saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah hlangping taeng lamloh im khuila a kun vaengah Jesuh te a hnukbang rhoek loh nuettahnah a dawt uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah amih te, “Nangmih khaw lungmongkotalh la na om tangloeng. A hmanhu kah boeih tah hlang khuila a kun akhaw anih te poeih thai pawh tila na yakming uh pawt nim?
  </para>
  <para style="p">
    <verse number="19" style="v" />Te te thinko khuiah pawt tih a bungpuei khui lam ni a kun tih naat khui ni a pha. Te dongah cakok he boeih cimcaih,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah, “ Hlang lamkah aka thoeng loh hlang a poeih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlang thinko khui lamkah tah a thae poeknah, Cukhalnah, huencannah, ngawnnah,
  </para>
  <para style="p">
    <verse number="22" style="v" />samphaihnah, halhkanah, halangnah, tuengkhuepnah, omthenbawnnah, mikmuelh kholaeh, soehsalnah, kohangnah, anglatnah khaw thoeng coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hekah a thae boeih tah a khui lamkah ha thoeng dongah hlang a poeih,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te lamkah thoo tih Tyre vaang la cet. Te vaengah im pakhat ah a kun te ming sak ham ngaih pawt dae phah thai pawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae a kawng te huta pakhat loh tlek a yaak. Anih te a canu tah mueihla thae loh a kaem pah dongah cet tih Jesuh kho khugah bakop.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tahae kah huta tah Syrophoenician kah Greek hoel la om dae a canu kah rhaithae te haek sak ham Jesuh a hloep.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah anih te, “Camoe rhoek te lamhma la hah sak dae saeh. Ca kah buh rhawt pah tih ui taengah lun pah ham tah hnothen la a om moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae huta loh a doo tih Jesuh te, “Boeipa, camoe kah buhdik te caboei hmuikah uica rhoek loh a caak uh van ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah anih te, “Hekah ol dongah cet laeh, rhaithae te na canu taeng lamkah cet coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amah im la a caeh vaengah thingkong soah aka yalh camoe te a hmuh. Te vaengah rhaithae khaw ana suntla coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Tyre vaang lamkah koep nong tih Sidon longah Decapolis vaang khui kah Galilee tuili la pawk.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah hnapang olmueh te a khuen uh tih anih te kut tloeng thil ham Jesuh a hloep uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah anih te hlangping taeng lamloh amah bueng a hoep tih a hna khuila kutdawn a puei. Te phoeiah a timthoeih tih a lai te a taek pah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Vaan la oeloe tih a huei phoeiah anih te, “Ephphatha (khui saeh tila om),” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah a hnavue te tlek khui tih a lai aka khom te yaih tih balh cal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah hlang taengah thui pawt ham amih te ol a paek. Amih te muep ol a paek dae amih loh a nah la muep a hoe uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah let uh khungdaeng tih, “Cungkuem la balh a saii dongah hnapang te a yaak ham a saii tih olmueh te a cal sak,” a ti uh.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te khohnin ah hlangping te hut koep om tih caak koi ba khaw khueh uh pawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hnukbang rhoek te a khue tih, “Kai taengah hnin thum rhaeh uh coeng tih caak bakhaw a khueh uh voel pawt dongah he hlangping ham ka thinphat.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah a im ah buhmueh rhathih la amih ka tueih koinih longpueng ah tawnba uh ni. Amih khuikah hlangvang tah khohla lamkah ha pawk uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />A hnukbang rhoek long khaw, “He rhoek he kohong ah me lamkah buh nim hlang loh a cah thai eh he?” a ti uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah amih te, “Vaidam meyet na khueh uh?,” a ti nah hatah, “Parhih,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah hlangping te diklai ah ngol ham a uen. Te phoeiah vaidam parhih te a loh tih a uem tih a aeh. Te daengah hlangping taengah tael hamla a hnukbang rhoek te a paek tih a tael uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah ngadik a yool a khueh uh te khaw a uem tih amih te, “He khaw tael uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />A caak uh tih a hah uh phoeiah a nueipil aka coih te voh rhih la a phueih uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah thawngli tluk om uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amih a hlah phoeiah tah lawng khuila tlek kun tih a hnukbang rhoek neh Dalmanutha paengpang la pawk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Pharisee rhoek te cet uh tih Jesuh te koe a oelh uh. Vaan lamkah miknoek te anih taengah a toem uh tih a noemcai uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae a lungbuei ah huei tih, “Balae hekah cadil loh miknoek a toem. Nangmih taengah rhep ka thui, Hekah cadil he miknoek tueng ham moenih,” a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah amih te a toeng phoeiah koep kun tih rhalvangan la kat.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah buh khuen ham a hmaai uh dongah lawng khuikah amih taengah vaidam pakhat bueng pawt atah atloe khueh uh pawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah amih te ol a paek tih, “Ngaithuen uh, Pharisee rhoek kah tolrhu neh Herod kah tolrhu te hmat uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah vaidam a khueh uh pawt te amamih khuiah dawtlet uh thae.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae a ming dongah amih te, “Balae tih vaidam na khueh uh pawt te na thuiuh. Na yakming uh pawt tih, na hmuhming uh thlan a? Na thinko te mangkhak la vawk khueh uh ne.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mik aka khueh rhoek loh na hmuh uh voel pawt tih hna aka khueh rhoek loh na yaak uh pawt dongah na poek uh moenih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thawngnga ham vaidam panga ka aeh vaengah a nueipil na phueih uh te voh meyet a bae?” a ti nah hatah Jesuh taengah, “Hlainit,” a ti na uh .
  </para>
  <para style="p">
    <verse number="20" style="v" />“Thawngli ham parhih vaengah a nueipil na phueih uh te voh meyet a bae?” a ti nah hatah Jesuh taengah, “Parhih,” a ti na uh .
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah amih te, “Na hmuhming uh hlan a?,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bethsaida la a caeh uh vaengah mikdael te Jesuh taengla a khuen uh tih anih te taek sak ham a bih uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah mikdael kah kut te a tuuk tih kho voella a khuen tih a mik ah a timthoeih. A kut te a tloeng thil phoeiah, “Khat khat khaw na hmuh maia?” tila a dawt.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah oeloe tih, “Hlang rhoek te ka sawt dae thingkung aka cet bangla ka hmuh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae a mik te a kut koep a tloeng pah thil daengah a cil pah tih a hoeih pah tih phaeng boeih a hmuh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae anih a im la a tueih vaengah tah, “Vangca la kun boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesuh neh a hnukbang rhoek tah Kaisarea Philip kah kho la a caeh uh vaengah longpueng ah a hnukbang rhoek te a dawt tih, “Kai he hlang loh ulae a ti uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah amah te, “Pakhat loh tuinuem Johan, pakhat loh Elijah, tedae pakhat loh tonghma rhoek khuikah pakhat khat a ti uh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesuh loh amih te, “Nangmih ta kai he ulae na ti uh?” tila a dawt. Peter loh a doo tih, “Nang tah Khrih ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah amah kawng te thui pawt ham amih te a uen.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah amih taengah hlang capa te muep a patang ham neh patong rhoek loh a hnawt ham khaw, khosoihham rhoek neh cadaek rhoek loh a ngawn phoeikah hnin thum ah a thoh ham khaw a kuek te koe a thuituen.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah ol te sayalh la a thui dongah Peter loh Jesuh te a khue tih koe a toel.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae Jesuh loh mael tih a hnukbang rhoek te a sawt doeah Peter te a tluung tih, “ Satan, Pathen te na poek pawt tih hlang te na poek dongah ka hnuk la nong,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te phoeiah a hnukbang rhoek neh hlangping te a khue tih, “Khat khat loh kai hnukah vai ham a ngaih atah amah a huek uh phoeiah a thinglam te kawt saeh lamtah kai m'vai saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amah khaw a hinglu te khang ham aka ngaih tah a hlong ni. Tedae amah khaw kai neh olthangthen ham a hinglu aka hlong tah daem ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hlang pakhat te Diklai pum a dang dae a hinglu te a hlong atah balae a hoeikhang?
  </para>
  <para style="p">
    <verse number="37" style="v" />Hlang loh a hinglu ham balae tlansum la a phai eh?
  </para>
  <para style="p">
    <verse number="38" style="v" />He suentae lakliah kamah neh ka ol aka yah puei te tah samphaih neh hlangtholh la om coeng. Hlang capa loh a napa kah thangpomnah dongah hlangcim rhoek kah puencawn rhoek neh ha pawk vaengah anih te a yah puei van ni,” a ti nah.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah amih te, “Nangmih taengah rhep ka thui, hekah aka pai khuiah hlangvang loh thaomnah neh aka pai Pathen ram te a hmuh hlan atah dueknah ten mueh mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hnin rhuk phoeiah tah Jesuh loh Peter, James neh Johan te a khue tih amamih bueng tlang sang la hloep a caeh puei hatah amih hmaiah thohai uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A himbai te khaw bok kathik la om tih phaeng aa. Diklai hmankah mebang hnosuk long khaw te tlam te bok sak thai pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amih taengah Elijah neh Moses khaw phoe tih Jesuh neh cal uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Peter loh Jesuh te a doo tih, “Rhabbi, heah he mamih om ham then tih, dap pathum saii uh sih lamtah, nang ham pakhat, Moses ham pakhat, Elijah ham pakhat saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae lakuengngaiha la a om uh dongah metla a doo khaw ming pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah khomai aka thoeng loh amih a dah tih khomai khui lamkah, “Anih tah ka ca thintlo ni, anih ol hnatun uh,” tila ol ha thoeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae koe a sawt uh vaengah ukhaw om pawt tih amih taengah Jesuh bueng te a hmuh uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlang lamkah a suntlak uh phoeiah a hmuh uh te duek khui lamkah loh hlang capa a thoh hlan atah thui pawt ham amih te ol a paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah olka te a kuem uh tih, “Aka duek rhoek taeng lamkah loh a thoh ham te metlam a om eh?” tila amamih te oelh uh thae.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah amah te a dawt uh tih, “Balae tih cadaek rhoek loh, 'Elijah te ha pawk lamhma ham a kuek,’ a ti uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Jesuh loh amih te, “Elijah he lamhma la ha pawk coeng tih boeih a thoh coeng ngawn. Tedae hlang capa muep a patang phoeiah a voeih ham te metlam a daek?
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae nangmih taengah ka thui tah Elijah khaw ha pawk coeng tih anih ham a daek pah vanbangla anih te a ngaih bangla boeih a saii uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hnukbang rhoek taengla aka pawk rhoek loh amih taengkah hlangping neh cadaek rhoek neh muep a oelh uh te a hmuh uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlangping boeih loh Jesuh te lawt a hmuh uh hatah a ngaihmang uh. Te dongah anih te a cuk thil uh tih a doe uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah amih te, “Amih neh balae na oelh uh thae,” tila a dawt.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah hlangping lamkah pakhat loh saya, “Mueihla olmueh aka kaem ka capa te nang taengla kang khuen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih he a tuuk vaengah tah bung tih a hom phoeiah no a rhueng tih koh. Te te haek ham na hnukbang rhoek te khaw ka dawt dae noeng uh pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah Jesuh loh amih te a doo tih, “Aw aka tangnahmueh kah cadil, nangmih taengah meyet nim ka om ve, nangmih taengah mevaeng hil nim kan yaknaem ve? Anih te ka taengla hang khuen uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te daengah camoe te Jesuh taengla a khuen uh. Tedae Mueihla loh camoe te koe a doek te a hmuh. Te vaengah diklai la bung tih a hom neh bol.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah a napa te, “ Anih taengah aka thoeng he kum meyet lamkah lae a om coeng?” tila a dawt.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah a napa loh, “A cahni lamkah coeng tih anih poci sak ham hmai khuiah khaw tui khuiah khaw a voeih taitu. Tedae pakhat khaw na saii thai khaming, kaimih soah thinphat la kaimih m'bom mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Jesuh loh anih te, “Na saii thai atah e te! Aka tangnah ham boeih coeng thai ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Camoe kah a napa te tlek pang tih, “ Ka tangnah, ka hnalvalnah te m'bom mai ,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesuh loh hlangping a khong te a hmuh vaengah, mueihla thae te a ho tih, “Olmueh neh hnapang mueihla Kai loh nang kan tueih. Anih taeng lamkah loh cet lamtah anih khuiah kun voel boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah pang tih muep a suvaih phoeiah cet. Tedae camoe te aka duek bangla a om dongah, “Duek coeng, “tila muep a thui uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae Jesuh loh a kut te a tuuk tih a thoh hatah koe thoo hang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Im khuila a kun phoeiah tah a hnukbang rhoek loh, “Kaimih loh balae tih tih anih te ka haek uh thai pawh,” tila amah bueng hloep a dawt uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah amih te, “He bang he thangthuinah nen pawt atah haek thai mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te lamkah loh thoo uh tih Galilee longah van uh dae pakhat khaw ming sak ham ngaih pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A hnukbang rhoek a thuituen vaengah khaw, “ Hlang Capa tah hlang kut ah a voeih vetih a ngawn uh ni. Tedae a ngawn uh phoeikah hnin thum ah thoo ni,” a ti nah coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amih loh olthui te a mangvawt uh dae amah dawt ham khaw a rhih uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kapernaum te a pha uh tih im ah a om vaengah, “Longpueng ah balae na thui uh?,” tila amih te a dawt.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae long ah khat neh khat te ulae tanglue tila a thuingong uh dongah a hil a phah uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah Ngol tih hlainit te a khue. Amih te khaw, “ Khat khat loh lamhma la om ham a ngaih atah hnukkhoem koek neh tueihyoeih koek la om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah camoe te a khue tih amih lakli ah a pai sak tih a poem.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amih te khaw, “Kai ming neh hebang camoe pakhat khaw aka doe long tah kai ni n' doe. Tedae kai aka doe long tah kai bueng kolla ka tueih te khaw a doe,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Johan loh Jesuh taengah, “Boeipa, na ming neh rhaithae aka haek hlang khat te ka hmuh uh. Tedae mamih hnuk ham vai pawt dongah anih te ka paa sak uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae Jesuh loh , “Anih te paa sak uh boeh. Ka ming neh thaomnah aka tueng sak te a om pawt vaengah koeloe la kai n'thet ve.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah mamih neh kingkalh la aka om pawt te tah mamih ham ni a om.
  </para>
  <para style="p">
    <verse number="41" style="v" />Khrih kah hut la na om uh dongah ka ming neh tui boengloeng khat nangmih aka tul te tah a thapang te poci loengloeng mahpawh tila nangmih taengah rhep ka thui.
  </para>
  <para style="p">
    <verse number="42" style="v" />U long khaw kai aka tangnah camoe rhoek he pakhat khaw a khah atah a rhawn ah laak phaklung a oi tih tuili ah voei koinih anih ham hnothen la lat om coeng.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nang khaw na kut loh n'khah atah hlueng mai. Kut panit om tih hmai aka duek pawh hell la caeh lakah hingnah khuiah a ngun la kun te nang ham hnothen la om.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na kho long khaw nang n'khah atah hlueng mai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kho rhoi om tih hell khuila m'voeih lakah a ngun neh hingnah khuila kun te nang hnothen la om.
  </para>
  <para style="p">
    <verse number="46" style="v" />Na mik long khaw nang n'khah atah koeih mai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mik panit om tih hell la m'voeih lakah mikvang neh Pathen ram khuiah kun te nang ham hnothen la om.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te ah tah amih kah a rhiit khaw duek pawt tih hmai khaw thi pawh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Rhoepsaep boeih te hmai dongah a baek ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />Lungkaeh tah then, tedae lungkaeh te a duu la om koinih ba nen lae na hlihlim sak eh. Namamih khuiah lungkaeh khueh uh lamtah khat neh khat taengah rhoep uh thae,” a ti nah.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te lamloh thoo tih Judea vaang neh Jordan rhalvangan la cet. Te vaengah a taengah hlangping rhoek koep ha puei uh tih a sainoek bangla amih te koep a thuituen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae Pharisee rhoek loh a paan tih, “Te koinih tongpa te yuu a hlak sak a? tila a dawt uh tih Jesuh te a noemcai uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae amih te a doo tih, “Moses loh nangmih balae n' uen,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah amih loh, “Moses loh yuhlaknah cayol te a daek sak phoeiah a tueih sak,” a ti uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae Jesuh loh amih te, “Nangmih kah thinthahnah kongah hekah olpaek he nangmih ham a daek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Suentae cuek lamkah tongpa neh huta ni a saii.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah tongpa loh a manu neh a napa te a toeng vetih a yuu taengah kap ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Panit te pumsa khat la om ni. Te dongah panit voel pawt tih pumsa khat la om coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Pathen loh a samtom te hlang loh maa sak boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Im ah khaw hekah a kawng he hnukbang rhoek loh koep a dawt uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah amih te, “A yuu te a hlak tih a tloe aka yunah te tah a yuu soah samphaih coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huta long khaw a va te a maa tih va tloe a sak atah samphaih coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah camoe rhoek te taek sak ham a taengla a khuen uh. Tedae hnukbang rhoek loh amih te a ho uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hmuh vaengah Jesuh loh a yakdam tih amih te, “Hlah uh laeh camoe rhoek te kamah taengah ha lo uh saeh. Amih te kang uh boeh. Pathen kah ram tah amih kah coeng ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmih taengah rhep ka thui, camoe bangla Pathen kah ram te aka doe pawt te atah ram khuiah kun loengloeng mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah amih te a poem tih a uem dongah kut a tloeng thil.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah Jesuh te longpueng ah a caeh li vaengah hlang pakhat loh pak ha cu tih a cungkueng pah. Te phoeiah, “Saya then dungyan hingnah ka pang ham balae ka saii eh?,” tila a dawt.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesuh loh anih te, “Balae tih kai he a then na ti? Pathen pakhat bueng pawt atah aka then he om pawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Olpaek te na ming coeng hlang ngawn boeh, samphaih boeh, huencan boeh, laithae boeh, hmuiyoi boeh, na nu na pa te hinyah,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah anih loh, “Saya, te rhoek te ka camoe lamkah boeih ka tuem coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae Jesuh loh anih te a sawt vaengah a lungnah tih, “ Nang pakhat na phavawt pueng, cet lamtah, na khueh boeih te yoi lamtah khodeng rhoek pae. Te daengah ni vaan ah khohrhang na dang eh. Te phoeiah halo lamtah kai m'vai,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae hnopai muep aka khueh la a om dongah tekah olka loh moelh a khaih tih kothae doela vik cet.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah Jesuh loh taengvai a sawt tih a hnukbang rhoek te, “ Tangka aka om tah Pathen ram ah kun ham bahoeng kuel mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Jesuh olka dongah hnukbang rhoek tah a ngaihmang uh. Tedae Jesuh loh amih te koep a doo tih, “Camoe rhoek aih khaw, Pathen kah ram la kun ham te kuel kahlak la om ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuirhang te Pathen kah ram ah a kun lakah kalauk te phamet khui ah a kun ham phoeng ngai,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae te rhoek tah let uh khungdaeng tih amamih te, “Unim aka daem thai ve,” a ti uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesuh loh amih te a sawt tih, “Hlang ham a tloelnah dae Pathen ham tah a tloelnah moenih Pathen taengah tah boeih yoeikoek mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peter loh a tong tih, “Kaimih loh boeih ka toeng uh tih nang kam vai uh coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesuh loh, “ Nangmih taengah rhep kan thui, kai ham neh olthangthen ham im khaw, manuca rhoek khaw, ngannu khaw, manu khaw, napa khaw, ca khaw lohmuen khaw aka toeng te om pawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tahae tue kah hnaemtaeknah khuiah pataeng im khaw, manuca khaw, ngannu khaw, manu khaw, ca khaw, lohmuen khaw a pueh yakhat la dang het pawt nim? Aka lo ham tue ah dungyan hingnah khaw om pueng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah lamhma te lamhnuk la, lamhnuk te khaw lamhma la muep om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jerusalem la a caeh uh kah longpueng ah a om uh vaengah Jesuh tah amih taengah a lamhma ana om pah. Te dongah a ngaihmang uh tih aka vai rhoek long khaw a rhih uh. Tedae hlainit te koep a khuen tih amah taengah aka thoeng ham te amih taengah thui ham a tong.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Jerusalem la n'caeh uh he hlang capa tah khosoihham neh cadaek rhoek taengah a paek vetih a duek ham a boe sak uh phoeiah namtom rhoek taengah a thak uh ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Anih te a tamdaeng uh phoeiah a timthoeih uh ni, a boh uh vetih a ngawn uh ni. Tedae hnin thum phoeiah koep thoo ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah Zebedee capa rhoi James neh Johan loh a paan rhoi tih, “Saya namah taengah kan bih uh te tah kaimih ham nan saii koinih ka ngaih rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah Jesuh loh amih rhoi te, “Nangmih ham kai balae saii sak na ngaih rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te rhoi long khaw amah te, “Kaimih rhoi he namah kah bantang lamloh pakhat, banvoei lamloh pakhat te m'pae lamtah na thangpomnah dongah ka ngol rhoi eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesuh loh amih rhoi taengah, “Na bih te na ming rhoi moenih. Ka ok boengloeng te ok ham neh kai aka nuem baptisma dongah nuem ham na noeng aya?,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te vaengah te rhoi loh amah te, “Ka noeng ngawn,” a ti nah rhoi. Tedae Jesuh loh amih rhoi taengah, “Ka ok boengloeng te na ok rhoi vetih ka nuem baptisma te na nuem rhoi ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tedae kai kah banvoei bantang ah ngol ham te kai loh paek ham om pawt tih a hmoel tangtae rhoek ham ni a om,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Parha rhoek loh a yaak uh vaengah James neh Johan taengah koe thatlai uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te dongah Jesuh loh amih te a khue tih, “Namtom rhoek aka mawt tah amamih aka vueinan tih amamih khuikah aka len loh amih aka huttet la a ngai uh te na ming uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nangmih ah te tlam te om boel saeh. Tedae nangmih ah a len la om aka ngaih long tah nangmih kah tueihyoeih la om saeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te phoeiah nangmih ah lamhma la om ham aka ngaih long tah hlang boeih kah sal la om saeh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hlang capa tah hlang thotat sak ham pawt tih sak ham pah ham neh a hinglu te ping kah tlansum la paek ham ni halo,” a ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te phoeiah Jerikho la pawk uh tih Jerikho lamkah a hnukbang rhoek khaw, hlangping khaw huhut khong uh. Te vaengah Timaeus capa Bartimaeus buhbih mikdael te long taengah ngol.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nazareth Jesuh om tila a yaak vaengah koe pang tih, “David capa Jesuh kai n'rhen lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te dongah anih te hilphah sak ham muep a sim uh. Tedae te long khaw anah la lat pang tih, “David capa, kai n'rhen lah,” a ti.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te dongah Jesuh te pai tih, “Anih ke khue uh,” a ti nah. Te dongah mikdael te a khue uh tih, “Thoo, na ngaimong sak, nang n'khue coeng,” a ti na uh .
  </para>
  <para style="p">
    <verse number="50" style="v" />Te long khaw a himbai te a voeih tih a cungpet doela Jesuh taengah pawk.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te phoeiah Jesuh loh anih te a doo tih, “Na ngaih te kan saii pawn eh,” a ti nah. Te dongah mikdael loh Jesuh taengah, “Rhabboni, ka hmuh van lah mako,” a ti nah.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te vaengah Jesuh loh anih te, “Cet laeh, namah kah tangnah loh nang n'khang coeng,” a ti nah. Te vaengah tlek a hmuh tih longpueng ah Jeusuh pahoi a vai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem, Olive tlang kah Bethphage neh Bethany a pha tom uh vaengah a hnukbang rhoek khuiah panit te a tueih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah amih rhoi te, “Na rhaldan kah vangca la cet rhoi lamtah a khuiah tlek na kun neh laak ca a pael te na hmuh rhoi ni. Te soah ah te hlang a ngol noek moenih. Te te hlam lamtah han khuen rhoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah khat khat loh nangmih rhoi taengah, “Balae na saii te,’ a ti atah Boeipa loh a ngoe. Tedae he la tlek kan thak koep bitni, 'ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah a caeh rhoi hatah thohka voel kah longrhak ah laak ca a pael te a hmuh rhoi tih a hlam rhoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah tekah aka pai hlangvang loh , “laak ca na hlam rhoi te balae na saii rhoi,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te rhoi loh amih taengah Jesuh kah a thui bangla a thui rhoi daengah amih rhoi te a hlah uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah laak ca te Jesuh taengla a khuen rhoi tih amamih kah himbai neh a khuk thil uh phoeiah a soah Jesuh te ngol.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah hlang a yet loh a himbai te long ah a phaih uh. Tedae a tloe rhoek loh lohma kah thingbu te a hlaek pauh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah lamhma rhoek neh hnukvai rhoek loh, “Hosanna, Boeipa ming neh aka pawk tah a yoethen pai.
  </para>
  <para style="p">
    <verse number="10" style="v" />A pa David kah ram aka pai tah a yoethen pai, a sangkoek ah hosanna,” tila pang uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah Jerusalem bawkim la kun tih boeih a sawt. A tue te khaw hlaem la om coeng tih hlainit neh Bethany la cet uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A vuen ah Bethany lamloh a caeh uh vaengah a bungpong.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah thaibu a hnah aka om te a hla lamloh a hmuh. Te dongah a kung ah pakhat khat khaw a hmuh mai atah tila a paan. Thaibu tue la a om pawt dongah a taeng a pha vaengah tah a hnah pawt atah a tloe hmu pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah a voek tih, “Nang kah a thaih te kumhal duela ca uh boel saeh,” a ti nah te a hnukbang rhoek long khaw a yaak uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Jerusalem la ha lo uh tih bawkim la a kun vaengah bawkim kah hnoyoi neh hnolai rhoek te koe a vai. Tangkathung rhoek kah caboei neh vahu aka yoi rhoek kah ngoltlang te a palet pah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah hnopai te bawkim longah pakhat khaw puen sak pawh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah amih te a thuituen tih, “ Kai im tah namtom boeih ham thangthuinah im la a khue ni tila a daek moenih a? Tedae nangmih loh dingca rhoek kah khuirhung la na saii uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khosoihham neh cadaek rhoek loh a yaak uh vaengah Jesuh te poci sak ham a mae uh. Tedae anih kah thuituennah soah hlangping khaw boeih let uh tih loei a rhih uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kholaeh a pha vaengah kho voella cet uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeikah yueya a van uh hatah thaibu tah a yung lamloh a koh te a hmuh uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah Peter loh a thoelh tih Jesuh taengah, “Rhabbi thaibu thae na phoei thil te koh coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Jesuh loh amih te a doo tih, “Pathen taengah tangnah te khueh uh lah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangmih taengah rhep ka thui, hekah tlang he, 'Phil saeh lamtah tuili la voei saeh, ' aka ti nah long tah a thinko ah boelhkhoeh boel saeh lamtah a thui te thoeng coeng tila tangnah saeh a thoeng pah bitni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah nangmih taengah ka thui, thangthui neh na bih uh boeih te ka dang coeng tila tangnah uh lamtah nangmih ham ha thoeng bitni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thangthui la na pai uh vaengah khaw khat khat taengah ngaihlih bet na khueh atah hlah pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te daengah ni vaan kah na pa long khaw nangmih kah tholhdalhnah te a hlah eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Jerusalem la koep pawk uh tih Bawkim ah a pongpa vaengah khosoihham rhoek khaw, cadaek rhoek khaw, patong rhoek khaw, a taengla ha pawk uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Jesuh te, “Mebang saithainah nen lae hekah he na saii? tih hekah he saii ham saithainah he ulong nang m'paek,” a ti na uh .
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Jesuh loh amih taengah, “Olka pakhat nangmih kan dawt phoeiah kai n'doouh. Te vaengah mebang saithainah neh ka saii khaw nangmih ham kan thui bitni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Johan kah baptisma te vaan lamkah a? Hlang lamkah a aka om a? Kai n'doo uh lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah amamih te dawtlet uh thae tih, “Vaan lamkah n'ti uh, “koinih, “ Balae tih anih na tangnah uh pawh,” a ti veh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hlang lamkah n'ti uh cakhaw hlang boeih loh Johan te, “Tonghma rhep ni,” a ti uh dongah hlangping te a rhih uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah Jesuh te a doo uh tih, “Ka ming uh pawh,” a ti uh. Jesuh long khaw amih te, “Hekah he mebang saithainah neh ka saii khaw nangmih taengah ka thui mahpawh,” a ti nah.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah amih taengah nuettahnah neh thui ham a tong tih, “Hlang pakhat loh misur a tue tih vongtung a tung, rhom a too, imsang a sak. Te phoeiah lotawn rhoek te a phaam sak tih vik yiin.
  </para>
  <para style="p">
    <verse number="2" style="v" />A tue vaengah lotawn taengkah misur thaih coi ham sal pakhat te lotawn rhoek taengla a tueih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae anih te a tuuk uh phoeiah a boh uh tih a tlongtlai la a tueih uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah sal a tloe te amih taengla koep a tueih hatah anih te khaw a vuek uh tih yah a bai uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah a tloe te a tueih dae te khaw a ngawn uh tih a tloe rhoek muep a tueih te, a ngen a boh uh tih a ngawn uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Capa thintlo pakhat a khueh pueng tih, “Ka capa te a yahnah uh ni,” a ti dongah a capa te amih taengla a hnukkhueng ah a tueih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae lotawn rhoek loh amamih te, “Anih tah rhopangkung ni. Halo anih he ngawn uh sih. Te daengah ni mamih kah rho la a om eh?,” a ti uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih te a tuuk uh tih a ngawn uh phoeiah misurdum lamkah loh vawl a voeih uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te koinih misurdum kungmah loh balae a saii eh? A paan vetih lotawn rhoek te a poci sak phoeiah misurdum te a tloe rhoek taengah a paek ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cacim he na tae uh pawt nim? Im sa rhoek loh a hnawt lungto te imkil kah a lu la poeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hekah he Boeipa lamkah ha thoeng tih mamih mik ah aka khuet la om?” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nuettahnah a thui te amih ni tila a ming uh dongah amah tuuk ham a mae uh. Tedae hlangping te a rhih uh dongah anih te a toeng uh tih cet uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah olka neh tuengkhuep ham Jesuh taengla Pharisee rhoek neh Herod hlang rhoek kah hlangvang rhoek te a tueih uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pha uh vaengah Jesuh te, “Boeipa, a thuem la na om tih hlang maelhmai te na sawt pawt dongah u taengah khaw na birhih pawh. Pathen kah oltak longpuei te ni na thuituen tila ka ming uh. Te dongah Kaisar taengah mangmu paek ham a ngaih a?, a ngaih moenih a? Pae sih a? Pae boel sih a?” a ti uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae amih kah thailatnah te a hmuh tih amih te, “Balae kai nan noemcai uh? Kai taengla denari hang khuen lamtah ka so lah eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah a khuen uh hatah amih taengah, “A muei neh a ming he u kah nim he?” a ti nah vaengah, “Kaisar kah,” a ti uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesuh long khaw amih te, “Kaisar kah te Kaisar taengah, Pathen kah te Pathen taengah thuung uh,” a ti nah tih a taengah a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah Sadducee rhoek loh a taengla a paan uh. Te rhoek loh , “Thohkoepnah om mahpawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah anih te a dawt uh tih, “Saya, Moses loh kaimih ham, “Khat khat kah a manuca tah duek tih a yuu te camoe khueh kolla a caehtak atah, a manuca patoeng loh a yuu te pang saeh lamtah a manuca kah a tiingan te thoh saeh tila a daek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Boeinaphung parhih om uh tih lamhma te yuu a loh dae duek tih a tiingan khueh pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A pabae long khaw anih a pang dae duek tih a tiingan caehtak bal pawh. A pathum long khaw amah boeiloeih la om.
  </para>
  <para style="p">
    <verse number="22" style="v" />A parhih long khaw a tiingan khueh pawh. A hnukkhueng ah huta te khaw duek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih te parhih loh a yuu la a khueh uh dongah thohkoepnah khuiah a thoh uh vaengah amih khuiah u yuu lamlae a om eh?” a ti uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesuh loh amih taengah, “Cacim neh Pathen kah saithainah aka ming pawt loh n'rhaithi uh dongah moenih a he?
  </para>
  <para style="p">
    <verse number="25" style="v" />Duek lamkah a thoh uh vaengah yuloh vasak om mahpawh, rhaihlan khaw om mahpawh, vaan puencawn rhoek bangla om uh coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae aka duek rhoek a thoh uh te Moses cabu khuiah na tae uh pawt nim? Pathen loh tangpuem khuiah anih a voek vaengah, 'Kai tah Abraham kah Pathen, Isaak kah Pathen neh Jakob kah Pathen ni,’ a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathen tah aka duek rhoek kah pawt tih aka hing rhoek kah ni. Bahoeng n'rhaithi uh coeng la he,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah amih a oelh uh thae te cadaek pakhat loh a yaak dongah a paan. Tedae amih a voek te thuem tila a hmuh. Te dongah Jesuh te, “Olpaek boeih khuiah melae tanglue la aka om,” tila a dawt.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesuh loh, “ Aw Israel hnatun lah, mamih kah Boeipa, Boeipa Pathen pakhat ni a om.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah na Boeipa Pathen te na thinko boeih, na hinglu boeih, na kopoek boeih, na thadueng boeih neh lungnah ' a ti te lamhma la om.
  </para>
  <para style="p">
    <verse number="31" style="v" />A pabae ah na imben te namah bangla lungnah. He rhoi lakah aka tanglue olpaek a tloe om pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah cadaek loh Jesuh te, “Thuem, saya, pakhat bueng om tih amah phoeiah a tloe om pawh tila oltak te na thui coeng.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathen te thinko boeih neh, yakmingnah boeih neh, thadueng boeih neh, lungnah tih imben te amah bangla lungnah ham te hmaihlutnah neh hmueih boeih lakah olpuei la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Anih loh cat a doo te Jesuh loh a hmuh vaengah anih te, “Pathen kah ram lamloh lakhla la na om ngawn pawh,” a ti nah. Te phoeiah tah Jesuh te dawt ham ngaingaih uh voel pawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesuh loh bawkim ah a thuituen tih a doo vaengah, “Cadaek rhoek loh metlam, 'Khrih tah David capa ni,’ tila a thui?
  </para>
  <para style="p">
    <verse number="36" style="v" />David amah loh Mueihla Cim rhangneh, 'Boeipa loh ka Boeipa te 'Na rhal rhoek te na kho hmuiah ka khueh hlan atah kai kah bantang ah ngol dae ' a ti nah,’ a ti.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih te David amah long pataeng Boeipa la a khue atah metlamlae a capa la a om eh?,” a ti nah. Te vaengah hlangping te yet loh liplip a hnatun.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te phoeiah amah kah thuituennah khuiah, “ Hnikul neh pongpa tih hnoyoih hmuen ah toidalnah ham,
  </para>
  <para style="p">
    <verse number="39" style="v" />tunim ah ngolhmuen then neh buhkung ah hmuensang aka ngaih cadaek rhoek te dawn uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te rhoek loh nuhmai rhoek kah im a yoop uh tih mueituengnah ham khing thangthuiuh. Amih tah laitloeknah a yook uh khungdaeng bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah tangkabu hmaiah ngol tih hlangping loh tangkabu khuiah rhohum a sang vaengah a kumngai kuirhang rhoek loh muep a sang uh te a hmuh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te vaengah nuhmai khodeng pakhat ha pawk tih mucih panit a sang. Te tah pekhat lo ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah a hnukbang rhoek te a khue tih, “Nangmih taengah rhep ka thui, tangkabu khuila aka sang rhoek boeih lakah hekah nuhmai khodaeng loh a sang ngai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hlang boeih loh amamih taengkah a coih te a sang uh dae anih tah a vawtthoek khui lamkah a khuehtawn boeih a khosaknah boeih te bitbit a sang coeng,” a ti nah.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawkim lamkah a caeh vaengah a hnukbang rhoek khuikah pakhat loh a taengah, “Saya, mebang lungto neh mebang imsak nim he,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Jesuh loh anih te, “Hekah imsak a len te na hmuh nama? Lungto sokah lungto he hmaai loengloeng het mahpawt a? Te tah phil loengloeng het mahpawt a?,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Bawkim rhaldan kah Olive tlang ah amah te ngol tih, Peter, James, Johan neh Andrew loh ,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Hekah he me vaengah lae a om khaw kaimih taengah thui lah. He he boeih a soep tom vaengkah miknoek tah mebang lae? tila Jesuh amah bueng te a dawt uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Jesuh loh amih te, “Ngaithuen uh khat khat loh nangmih n'rhaithi ve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai ni, 'tila aka thui khaw kai ming neh muep ha pawk uh vetih muep rhaithi uh ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah caem neh caem kah olthang na yaak uh vaengah let uh boeh. A om ham khaw a kuek pai dae a bawtnah tah pha hlan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Namtu loh namtu, ram loh ram a thoh thil ni. Hmuen takuem ah lingluei hinghuen vetih khokha khaw pai ni. Te tah bungtloh a tongnah coeng ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah nangmih tah namamih te hmat uh thae. Nangmih te khoboei rhoek taengla n'thak uh vetih tunim ah m'boh uh ni. Te phoeiah khoboei rhoek neh manghai rhoek hmaiah khaw, amih taengah khaw kai ham laipai la na pai uh ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Namtom boeih taengah khaw lamhma la olthangthen te hoe ham a kuek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah nangmih n'khuen uh tih n' tloeng uh vaengah na thui uh ham te ngaisa uh boeh. Tedae amah tekah a tue vaengah nangmih m'paek te tah thui uh pai. Nangmih tah aka thui la na om pawt tih Mueihla Cim ni aka om.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah manuca loh manuca, a napa loh ca te duek sak ham a voeih ni. Camoe rhoek long khaw a manu napa te a tingtoeh vetih a duek sak ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai ming kongah hlang boeih loh m'hmuhuet uh ni. Tedae a bawt due aka ueh te tah daem ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae na hmuh uh vaengah mitmoengnah tueilaehnah a pai te a kuek moenih. Aka tae loh yakming saeh. Te vaengah Judea kah rhoek te tlang la rhaelrham uh saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Imphu kah aka om long khaw rhum boel saeh. A im kah khat khat loh ham khaw kun boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lohma kah long khaw a himbai loh ham a hnuk la bal boel saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anunae tekah khohnin ah bungvawn la aka om rhoek neh cacun rhoek aih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae sikca ah a om pawt ham thangthui uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Suentae kah a tongcuek lamloh aka om pawh tebang phacipphabaem khohnin te ha pai ni. Te tah Pathen loh a suen parhii te tahae due khaw om loeng loeng hlan.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Boeipa loh khohnin te a biim pawt atah pumsa he boeih daem thai mahpawh. Tedae a tuek tih a coelh tangtae ham te khohnin te a biim pah ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah pakhat loh nangmih taengah, 'Hela Khrih he, kela ke,’ a ti atah tangnah uh boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Laithae khrih rhoek neh laithae tonghma rhoek phoe vetih a coengthai atah coelh tangtae rhoek te phael sak ham miknoek neh khobae rhambae a tueng sak uh ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah nangmih taengah ka thui boeih te nangmih loh ana noek uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae phacip phabaem phoeikah tekah khohnin ah khomik loh hmuep vetih hla loh a aa pae mahpawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aisi rhoek khaw vaan lamloh tla ni. Vaan kah thaomnah khaw hinghuen uh ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah Hlang Capa te thaomnah tanglue, thangpomnah neh, khomai dongah ha pawk te a hmuh uh ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah, puencawn rhoek te a tueih vetih diklai a soi lamloh vaan a soi duela khohli pali dongkah a coelh rhoek te a coi ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah thaibu lamkah nuettahnah te canguh. A hlaeng te suepluep la om tih a hnah te a boe coeng atah khohal yoei coeng tila na ming uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah nangmih khaw hekah aka om he na hmuh uh vaengah thohka taengah rhet om coeng tila ming uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangmih taengah rhep ka thui, he rhoek loh boeih a thoeng hlan atah tahae kah cadil loh khum loengloeng mahpawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vaan neh diklai tah khum ni, tedae kai kah ol tah khum loengloeng mahpawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae tekah a tue khohnin kawng te a ming uh moenih, vaan kah puencawn rhoek long khaw ming pawh, pa long pawt atah capa long khaw a ming moenih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hlang pakhat loh a im te yiin la a hlah uh vaengah a sal rhoek te saithainah, neh a bibi rhip a paek phoeiah imtawt te hueltue la om ham a uen.
  </para>
  <para style="p">
    <verse number="34" style="v" />Me vaengah lae a tue te a omeh tite na ming uh pawt dongah hak uh lamtah ana noek uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah im kung te kholaeh ah khaw, ihdulh ah khaw, aikhong ah khaw, mincang ah khaw, me vaengah ha pawk ham khaw na ming uh pawt dongah ana hak uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Buengrhuet ha pawk vetih na ih uh te hmu ve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah nangmih ham ka thui te hlang boeih ham khaw ka thui, hak uh lah,” pahoi a ti nah.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahae lamkah hnin nit phoeiah Yoom neh vaidamding om pawn ni. Te vaengah khosoihham rhoek neh cadaek rhoek loh Jesuh te mebang tuengkhuepnah nen khaw tuuk tih ngawn ham a mae uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />“ Tedae khotue vaengah boel saeh, pilnam kah olpung kacan la om ve,” a ti uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Jesuh te Bethany ah aka om hmaibae Simon im ah yalh. Anih te huta pakhat loh a paan tih botui lungbok a khuen pah. Te bang nardo cilh tah te a phutlo. Lungbok te a boh tih a lu te a suep pah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae amih khuiah te aka yakdam hlangvang om.Te dongah , “Baham nim botui he pocinah a khueh he?
  </para>
  <para style="p">
    <verse number="5" style="v" />He botui he denari yathum hlai la a yoih vetih khodaeng te a paek mako tila anih te a thanueih thil uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Jesuh loh, “ Anih te hlah uh, balae tih anih te thakthaenah neh na toehuh. Kai dongah bibi then a saii.
  </para>
  <para style="p">
    <verse number="7" style="v" />khodaeng rhoek te nangmih taengah om uh taitu tih na ngaih uh vaengah amih ham a then na saii uh thai. Tedae kai ka om taitu moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />A khueh duen te a saii coeng. Rhokhlaknah dongah ka pumsa he hluk hamla a sawn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah nangmih taengah rhep kan thui, Diklai pum kah olthangthen a hoe nah takuem ah anih loh a saii te khaw a kutmuei la a thui ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah hlainit khuikah pakhat Judah Iskariot loh Jesuh te amih khosoihham rhoek taengah yoih hamla cet.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te rhoek loh a yaak uh vaengah a uem uh tih anih te tangka paek ham a caeng uh. Te dongah anih voeih ham te a hoenghoep a dawn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaidamding kah lamhmacuek hnin kah yoom a ngawn uh vaengah a hnukbang rhoek loh amah taengah, “Melam na ngaih dae, ka cet uh saeh lamtah , yoom caak ham ka tarhoek uh eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah a hnukbang panit te a tueih. Te vaengah amih rhoi te , “ Khopuei khuila cet rhoi lamtah tuitang dongah tui aka phuei hlang loh nangmih rhoi n'doe ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih te vai rhoi lamtah a kun nah imkung te, 'Saya loh, 'Kai impahnah te melam a om, te rhoek ah ka hnukbang rhoek neh yoom ka ca uh mai eh,’ a ti, ti nah rhoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah anih loh, “Imhman len a sikim la a rhoekbah te nangmih rhoi n'tueng bitni. Te vaengah mamih ham pahoi rhuengphong rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hnukbang rhoi te cet rhoi tih kho khuila a kun rhoi vaengah amih rhoi a uen bangla a hmuh rhoi tih yoom te a rhuengphong rhoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hlaem a pha vaengah hnukbang hlainit neh ha pawk.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah a vael uh tih a caak uh vaengah Jesuh loh, “ Nangmih taengah rhep ka thui. Nangmih khuikah pakhat, kai taengah aka ca loh kai m'voeih ni te,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vik a kothae uh tih, pakhat phoeiah pakhat loh Jesuh te , “Kai mai khaming,” a ti nauh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Jesuh loh amih te, “Hlainit khuikah pakhat, kai taengah baeldung khuila aka puei te.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlang capa tah a kawng a daek tangtae bangla a caeh te thuem. Tedae anih hlang pakhat loh hlang capa a voeih te anunae. Tekah hlang te thaang pawt koinih anih ham then ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />A caak uh vaengah, vaidam te a loh tih yoethen a paek . A aeh phoeiah amih te a doe tih, “He he kamah pum ni lo uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Boengloeng te khaw a loh tih a uem phoeiah amih te a paek tih rhip a ok uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah amih taengah, “He tah ka thii neh cungkuem ham ka long sak paipi ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih taengah rhep ka thui, Pathen kah ram ah a thai la ka ok nah khohnin duela misur thaih ka o voel loengloeng mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah a hlai doeah olives tlang la cet uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Jesuh loh amih te, “Boeih n'khah uh ni. 'Tudawn te ka tam vetih tu rhoek te pam ni, ' tila a daek coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae kai ka thoh phoeiah Galilee la nangmih hmaiah ka lamhma ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Peter loh Jesuh taengah, “Boeih a khah uh mai akhaw, kai van moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah Jesuh loh anih te, “Namah taengah rhep kan thui, tihnin hlaem ah he ai hnavoei a khong hlanah nang loh kai he voeithum nan huek uh tak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae, “Nang hamla kai ka duek te a kuek cakhaw nang kan huek uh tak loengloeng mahpawh,” khak a ti nah. Te vanbangla a tloe boeih long khaw a ti uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah Gethsemene aka ming nah hmuen la cet uh tih a hnukbang rhoek te, “Ka thangthui rhuetah tah heah he ana ngol uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah Peter, James neh Johan te amah taengla a khuen. Te vaengah ngaihmang neh khobing te a tong coeng .
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah amih te, “Ka hinglu loh kothae a ming tih vat duek. Heah he naeh uh lamtah ana hak uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae hawt lamhma tih lai ah bakop. Te vaengah coeng thai la a om atah a tue loh anih a khum tak ham ni a thangthui coeng .
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah, “ Abba, a pa, nang ham tah boeih yoeikoek mai, hekah boengloeng he kai lamkah loh khoe mai. Tedae kai ngaih boel saeh lamtah namah ngaih mai saeh,” a ti.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ha pawk vaengah amih a ih te a hmuh tih, Peter taengah, “Simon, na ip nama? Khonoek pakhat pataeng na hak thai mahnim?
  </para>
  <para style="p">
    <verse number="38" style="v" />Hak uh lamtah thangthuiuh. Te daengah ni cuekhalhnah khuiah na pha pawt eh. Mueihla loh a yakvawt ngawn dae pumsa loh tattloel,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te phoeiah koep cet tih amah a thui tangtae ol neh thangthui.
  </para>
  <para style="p">
    <verse number="40" style="v" />Koep ha pawk vaengah tah amih a ih a hmuh. Aka om rhoek te a mik loh a nan uh. Te dongah Jesuh a doo uh ham te ming uh pawh.
  </para>
  <para style="p">
    <verse number="41" style="v" />A pathum kah ha pawk vaengah amih te, “Yulh na ip uh tih caih laeh Tamah saeh. A tue ha pawk coeng. Hlang Capa tah hlangtholh rhoek kut ah a voeih coeng he.
  </para>
  <para style="p">
    <verse number="42" style="v" />Thoo uh, cet uh pawn sih, kai aka voei tah, ha yoei coeng ke,” a ti nah.
  </para>
  <para style="p">
    <verse number="43" style="v" />A thui li vaengah, hlainit khuikah pakhat Judah te pakcak ha pawk. Te vaengah anih te khosoihham neh, cadaek rhoek neh, patong rhoek kah a tueih hlangping loh cunghang neh thingboeng neh a pueiuh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te vaengah anih aka voei loh amih mikhip a paek tih, “ Ka mok te tah anih ni. Anih te tuu uh lamtah rhep khuen uh ,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te dongah ha pawk neh Jesuh te koe a paan tih, “Rhabbi,” a ti nah phoeiah a mok.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te rhoek loh kut a hlah thil uh tih Jesuh te a tuuk uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tedae aka pai khuikah pakhat loh cunghang te a yueh tih khosoihham kah sal te a boeng hatah a hna a pat pah.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te dongah Jesuh loh amih te a doo tih, “Dingca bangla, cunghang neh thingboeng neh kai tuuk ham nan suntlak thil uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Khohnin takuem nangmih taengah ka om tih bawkim ah ka thuituen vaengah kai na tuu uh pawh. Tedae he nen ni cacim tah a soep eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te vaengah Jesuh te a hlah uh tih boeih rhaelrham uh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tedae amah taengah aka bang cadong pakhat loh Jesuh pumtling te himbai neh a khuk hatah anih te khaw a tuuk uh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te long khaw himbai te a hnoo tih pumtling la rhaelrham van.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesuh te khosoihham taengla a khuen uh hatah khosoihham rhoek, patong rhoek neh cadaek rhoek loh boeih a khoong thil uh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Peter long tah a hla lamloh khosoihham kah vongup khui duela a vai. Te phoeiah tueihyoeih rhoek taengah ngol tih hmaivang te rhet a om.
  </para>
  <para style="p">
    <verse number="55" style="v" />Te vaengah khosoihham rhoek neh khoboei pum loh Jesuh te duek sak ham laipai a toem uh dae hmu uh pawh.
  </para>
  <para style="p">
    <verse number="56" style="v" />Jesuh te muep a pael uh dae laipai rhoek te cikngae la om uh pawh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Angen loh pai tih anih a pael nah la,
  </para>
  <para style="p">
    <verse number="58" style="v" />” Hekah kutsai bawkim he kai loh ka phae vetih hnin thum phoeiah a tloe kutsai mueh te ka sak ni, 'a ti te ka yaak uh coeng, ” a ti uh.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amih kah olthui te khaw cikngae la om bal pawh.
  </para>
  <para style="p">
    <verse number="60" style="v" />Te dongah khosoihham tah a laklung ah pai tih Jesuh te a dawt tih, “Khat khaw na doo mahpawt a? Amih loh nang m'pael uh te,” a ti nah.
  </para>
  <para style="p">
    <verse number="61" style="v" />Tedae hil a phah tih pakhat khaw doo pawh. Khosoihham loh Jesuh te koep a dawt tih, “Nang he, uemom Capa Khrih a?” a ti nah.
  </para>
  <para style="p">
    <verse number="62" style="v" />Te dongah Jesuh loh, “ Kai ni, hlang capa te thaomnah bantang ah ngol vetih vaan khomai neh ha pawk te na hmuh uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="63" style="v" />Te vaengah khosoihham loh a angki te a phen tih, “Laipai n'ngoe uh pueng a te?
  </para>
  <para style="p">
    <verse number="64" style="v" />soehsalnah te na yaak uh coeng. Metlam na poek uh ,” a ti nah. Amih loh anih te dueknah yook sak kuekluek hamla boeih a boe sakuh.
  </para>
  <para style="p">
    <verse number="65" style="v" />Te dongah hlangvang loh Jesuh te koe a timthoeih uh phoeiah, a maelhmai te a thing pa uh tih a thoek uh. Te phoeiah Jesuh te, “Olphong lah!” a ti na uh . Tueihyoeih rhoek kah kutcaihnah te khaw a duen pah.
  </para>
  <para style="p">
    <verse number="66" style="v" />Peter te vongtung hmui ah a om vaengah khosoihham kah salnu pakhat te ha pawk.
  </para>
  <para style="p">
    <verse number="67" style="v" />Hmai aka om Peter te a hmuh vaengah amah te a sawt tih, “Nang khaw Nazareth Jesuh taengah na om van,” a ti nah.
  </para>
  <para style="p">
    <verse number="68" style="v" />Tedae a aal tih, “Ka ming moenih, na thui te ka hmat moenih,” a ti nah. Tedae thohkaeng la voelh a caeh vaengah ai khong.
  </para>
  <para style="p">
    <verse number="69" style="v" />Te phoeiah Peter te salnu loh koep a hmuh tih aka pai rhoek taengah, “Anih he amih kah hlang ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="70" style="v" />Tedae koep a aal bal. Rhaih a om phoeiah aka pai rhoek loh Peter te, “Amih kah hlang rhep ni, Galilee hoel van ni,” a ti na uh .
  </para>
  <para style="p">
    <verse number="71" style="v" />Te dongah pahoi thae a phoei tih, “Hekah hlang na thui uh he ka ming moenih, “tila a toemngam.
  </para>
  <para style="p">
    <verse number="72" style="v" />Ai a pabae la pahoi khong tih Jesuh loh anih taengah, “Ai hnavoei a khong tom ah kai voeithum nan huek uh tak ni,” a ti nah ol te Peter loh a poek tih hlut rhap.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khosoihham rhoek, patong rhoek, cadaek rhoek neh khoboei pum loh dawtletnah yueya tlek a saii uh. Jesuh te a khih uh phoeiah a khuen uh tih Pilat taengah a thak uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Pilat loh Jesuh te, “Judah rhoek kah manghai la na om a? tila a dawt. Tedae Jesuh loh anih te a doo tih, “Namah long ni na ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khosoihham rhoek long khaw Jesuh te tholh muep a paelnaeh uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Pilat loh Jesuh te koep a dawt tih, “Nang muep m'paelnaeh uh ke khat khaw na doo mahpawt nim? a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae Jesuh loh a doo voel pawt dongah Pilat te a ngaihmang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengkah khotue takuem ah thongtla pakhat te a hoep tih ana hlah pah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah rhalthoh rhoek neh a khoh Barabbas a ti te om. Anih loh olpungnah dongah ngawnnah a saii.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlangping te khaw cet uh tih a saii noek la amamih ham koe a bih uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae Pilat loh amih te a doo tih, “Na ngaih uh nim, Judah manghai he nangmih ham kan hlah mako?” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uethnetnah dongah khosoihham rhoek loh anih taengla a voeih uh te a ming.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae khosoihham rhoek loh hlangping te a hueh tih Barabbas te amih ham lat a hlah sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Pilat loh amih te a doo tih, “Te koinih Judah manghai la na khue uh te metla ka saii ham lae na ngaih uh?” koep a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te rhoek loh, “Anih te tai laeh,” tila koep pang uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Pilat loh amih taengah, “Mebang boethae nim a saii?” a ti nah. Amih long khaw, “Anih te tai laeh,” tila bung pang uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilat loh hlangping kolo la saii a ngaih dongah amih ham Barabbas te a hlah pah. Tedae Jesuh te a tam tih tai ham a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah rhalkap rhoek loh Jesuh te khoboeiyung a om nah vongup khuila a khuen uh tih caem te a pum la a hueh uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah Jesuh te daidi neh a khuk uh tih hling rhuisam a vaeh uh te a khuem sakuh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah, “Judah rhoek kah manghai na sading saeh,” tila Jesuh te kut koe a tuukuh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah a lu te capu neh a boh uh tih a timthoeih uh. Khuklu te khaw cungkueng uh tih Jesuh te a bawk uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesuh te a tamdaeng uh phoeiah daidi te a pit pauh. Te phoeiah a himbai te a bai sak uh tih tai hamla a khuen uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah Kurena hlang Alexander neh Rufus kah a napa Simon lohma lamkah ha pawk tih pal khum rhoi dae Jesuh kah thinglam te koh sak ham khak a tanolh uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah Jesuh te Golgotha hmuen la a khuen uh. Tekah te lurhuh hmuen ni a thuingaih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah myrrh misurtui te Jesuh a paek uh dae doe pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesuh te a tai uh phoeiah a himbai te a phen pa uh tih amamih khat khat loh a khuen ham te hmulung a naan uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khonoek pathum a lo vaengah Jesuh te a tai uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah a paelnaehnah ming te a daek tih,” Judah Manghai,” la a khueh pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih neh dingca panit te khaw bantang ah pakhat banvoei ah pakhat a tai uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aka van paitai loh anih te a soehsal uh tih a lu a hinghuen uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah, “Aw bawkim te aka phae tih hnin thum ah aka sa,
  </para>
  <para style="p">
    <verse number="30" style="v" />Namah te khang uh lamtah thinglam lamkah rhum lah,” a ti na uh .
  </para>
  <para style="p">
    <verse number="31" style="v" />Khosoihham rhoek neh cadaek rhoek van long khaw a tamdaeng uh tih khat khat taengah, “A tloe rhoek te a khang dae amah aka khang uh thai pawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel manghai Khrih thinglam lamkah rhum laeh, te daengah ni kan hmuh uh vetih kan tangnah u eh,” a ti nauh. A taengkah a tai uh long khaw Jesuh te a thuithet.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khonoek parhuk a pha neh diklai pum ah yinnah loh khonoek pako duela a thing.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khovang khonoek pako vaengah Jesuh tah, “ Eloi, Eloi lama sabakhthani?” tila a ol a len la pang. Te tah, “Ka Pathen, Ka Pathen, balae tih kai nan phap,” te ni a thuingaih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah a taengkah aka pai khuikah a ngen loh a yaak uh tih, “Elijah a khue ke,” a ti uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hlang pakhat aka yong loh caethum te yuthui neh a sul tih cungkui dongah a kaek. Te phoeiah Jesuh te a tul tih, “Hlah uh lamtah so uh lah sih, anih aka hla la Elijah ha pawk venim,” a ti.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te phoeiah Jesuh loh ol a len la a huel tih pat.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah bawkim kah hniyan te a soi lamloh a hmui due panit la pawn.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih hmai ah aka pai rhalboei long khaw a pat te a hmuh vaengah, “Hekah hlang tah Pathen Capa rhep ni,” a ti.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah a hla lamkah aka dan huta rhoek khaw om uh. Amih khuiah Magadala Mary, a noe James neh Joses manu Mary neh Salome khaw om.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amih tah Galilee ah a om vaeng lamkah loh Jesuh te a vai uh tih a khut uh. Te phoeiah a tloe, amah neh Jerusalem la aka luei rhoek khaw muep omuh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te phoeiah hlaem a pha coeng tih rhuengphongnah om. Te dongah te tah huetnah la om.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te vaengah Arimathea lamkah khoboei hlangcong Joseph te ha pawk. Anih tah amah long khaw Pathen kah ram te aka lamtawn la om. Pilat taengah ngaingaih la cet tih Jesuh kah rhok te a bih.
  </para>
  <para style="p">
    <verse number="44" style="v" />Jesuh a duek tarha te Pilat khaw a ngaihmang. Te dongah rhalboei te a khue tih, “Duek dingrhae pawn nim ca,” tila a dawt.
  </para>
  <para style="p">
    <verse number="45" style="v" />Rhalboei lamkah te a mingpha daengah rhok te Joseph a paek.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te vaengah a himbai lai neh a hlak. Himbai te a yen phoeiah anih te hlan ah a khueh. Te tah lungpang dongah a thuk tangtae la om. Te phoeiah tah hlan rhai te lungto a paluet thil.
  </para>
  <para style="p">
    <verse number="47" style="v" />Magadala Mary neh Joses manu Mary long khaw a khueh nah te a hmuh.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath poeng phoeiah Magadala Mary neh James manu Mary neh Salome loh bo-ul a lai tih boeipa te hluk ham la cet rhoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sabbath phoeikah lamhmacuek vaengah yueya aih. pueng dae phuel la a pawk vaengah tah khomik thoeng coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah amamih te, “Hlan rhai kah lungto te ulong nim mamih ham a paluet ve?” a ti uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae a sawt uh vaengah, lungto vik a paluet uh te a hmuh uh. Te te bahoeng a len la om dae ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Phuel khuila a kun uh vaengah hnikul a bok aka bai cadong pakhat tah bantang ben ah ana ngol te a hmuh uh tih a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae anih loh amih taengah, “ Na ngaihmang uh boeh. A tai uh tangtae Nazareth Jesuh te na toem uh. Heah a om moenih thoo coeng . Anih a khueh nah hmuen so uh lah he.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae, cet uh lamtah a hnukbang rhoek neh Peter taengah, 'Nangmih taengah a thui bangla Galilee la nangmih hmaiah lamhma coeng, teah te Jesuh na hmuh uh bitni, 'tila thui pa uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah amih te thuennah neh, ngaihmang bangla a om uh dongah phuel lamkah cet tih rhaelrham uh. A rhih uh dongah u taengah khaw thui uh pawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A thoh phoeikah Sabbath yarh lamhma cuek mincang ah tah Magadala Mary taengah lamhma la a phoe pah. Rhaithae parhih te anih lamkah ni a. haek pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih te cet tih Jesuh taengah aka om tih a nguek neh aka rhap rhoek taengah puen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesuh hing tih a hmuh te a yaak uh dae a hnalval takuh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah amih khuikah hlang panit te a kho la cet rhoi tih a pongpa rhoi vaengah mueimae a hloeh la a phoe pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amih rhoi te cet tih a tloe rhoek taengah puen rhoi dae te rhoi te tangnah uh pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae hnuktloih la aka vael hlaikhat rhoek taengah a phoe pa tih amih kah hnalvalnah neh thinthahnah te a toel. Jesuh thoo coeng tih a hmuh uh lalah tangnah uh pawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah amih te, “Diklai pum ah cet uh lamtah suentae boeih taengah olthangthen te hoe uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aka tangnah tih aka tuinuem tah daem vetih aka hnalval rhoek tah boe ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah miknoek tah aka tangnah rhoek loh a thuep ni. Ka ming neh rhaithae a haek uh ni. Ol thai te a thui uh ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />A kut neh rhul a tuuk uh ni. Sue khat khat a ok uh mai akhaw amih te tloh sak mahpawh. Aka tlo soah kut a tloeng uh vetih sading la om uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Boeipa Jesuh loh amih a uen phoeiah, vaan la a loh tih Pathen kah bantang ah ngol.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tekah rhoek te khaw khotomrhali la cet uh tih a hoe uh. Boeipa loh a bongyong dongah olka te miknoek neh a rhoih uh tih a cak sakuh.
  </para>
</usx>
