<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Suencuek</book>
  <para style="h">Suencuek</para>
  <para style="toc1">Suencuek</para>
  <para style="toc2">Suencuek</para>
  <para style="mt">Suencuek</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />A cuekca vaengah Pathen loh vaan neh diklai a suen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah diklai te a hinghong la om tih hoeng. Tuidung hman khaw a hmuep loh a dah. Te vaengah Pathen Mueihla tah tui hman ah lam.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae Pathen loh , “Vangnah om saeh,” a ti dongah vangnah om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Pathen loh vangnah te then tila a hmuh. Te dongah Pathen loh vangnah neh a hmuep te a laklo ah a phih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Pathen loh vangnah te khothaih la a khue tih a hmuep te khoyin la a khue. Te vaengah hlaem neh mincang om tih khohnin lamhmacuek la om.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Pathen loh tui laklo ah bangyai om saeh lamtah tui neh tui laklo ah phih la om saeh a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah Pathen loh bangyai te a saii tih, bangyai hmui lamkah tui neh bangyai hman kah tui te a laklo ah aka phih la om tangloeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen loh bangyai te vaan la a khue. Te vaengah hlaem neh mincang om tih khohnin pabae la om.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Pathen loh vaan hmui kah tui rhoek te hmuen pakhat la tingtun uh saeh lamtah laiphuei tueng saeh,” a ti. Te dongah om tangloeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen loh laiphuei te lan la a khue tih, tui rhoek a tungnah te tuitunli la a khue. Te dongah Pathen loh then tila a hmuh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah Pathen loh , “Diklai loh toian, baelhing, a muu aka om ham a thaih te amah hui la a thaih aka saii thing te poe sak saeh. Diklai ah a tii te om saeh,” a ti.Te dongah om tangloeng coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah amah hui la a tii a muu aka om toian, baelhing khaw, amah hui vanbangla amah ah a muu a thaih aka saii thing khaw diklai loh a poe sak. Te dongah Pathen loh then tila a hmuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah hlaem neh mincang om tih a thum khohnin la om.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah Pathen loh , “Khothaih neh khoyin te a laklo ah phih ham neh khoning ham khaw, khohnin ham khaw, kum tue ham khaw miknoek la om sak ham vaan bangyai ah vangnah om saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vaan bangyai ah khaw, diklai hman aka tue ham khaw, vangnah om saeh,” a ti. Te dongah om tangloeng coeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah Pathen loh vangnah a len panit te, khothaih kah khohung la vangnah a len pakhat neh khoyin kah khohung la vangnah a yit neh aisi rhoek te khaw a saii.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah Pathen loh khothaih neh khoyin aka taemrhai khaw, vangnah neh a hmuep te aka phih ham khaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />Diklai hman aka tue ham khaw, vaan bangyai ah amih te a khueh vaengah Pathen loh then tila a hmuh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah hlaem neh mincang om tih a li khohnin la om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah Pathen loh, “Rhulcai mulhing hinglu te tui loh luem puei saeh lamtah diklai hman boeih vaan bangyai hmai ah vaa ding saeh,” a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah Pathen loh , tuihnam a len rhoek neh aka colh aka tat mulhing, hinglu boeih khaw, a suen. Te te amah hui la tui loh a luem sak tih phae aka khueh vaa cungkuem khaw amah hui la om. Te dongah Pathen loh then tila a hmuh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amih khaw Pathen loh yoethen a paek tih, “Pungtai uh lamtah ping uh. Tuitunli kah tui dongah khaw baetawt uh. Vaa long khaw diklai ah pungtai saeh,” a ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah hlaem neh mincang aka om te a nga khohnin la om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Pathen loh , “Diklai loh mulhing hinglu te amah hui la, rhamsa khaw, rhulcai khaw, diklai mulhing khaw amah hui la thoeng sak saeh,” a ti. Te dongah thoeng tangloeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Pathen loh diklai mulhing te amah hui la, rhamsa te khaw amah hui la, diklai rhulcai boeih khaw amah hui la a saii. Te te Pathen loh a then la a hmuh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah Pathen loh , “Mamih mueiloh la mamih muei neh hlang saii uh sih lamtah tuitunli kah nga soah khaw, vaan kah vaa soah khaw, rhamsa soah khaw, diklai kah a cungkuem soah khaw, diklai ah aka colh rhulcai cungkuem soah khaw, taemrhai uh saeh,” a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah Pathen loh , amah muei la hlang a suen. Pathen kah muei la tongpa khaw a suen tih huta khaw a suen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Pathen loh amih rhoi te yoethen a paek tih Pathen loh amih rhoi taengah, “Pungtai uh lamtah ping uh. Diklai khaw khulae uh lamtah tuitunli kah nga khaw, vaan kah vaa khaw, diklai kah aka yuel mulhing boeih khaw, khoem rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah Pathen loh , “Diklai hman boeih kah a tii aka om baelhing boeih neh a thaih ah a muu aka om thing neh, thing boeih khaw nangmih ham ka khueh coeng ne, nangmih ham cakok la om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah, “Diklai kah mulhing boeih khaw, vaan kah vaa boeih khaw, diklai ah aka tat tih amah dongah hingnah hinglu aka khueh boeih khaw, baelhing hingsuep boeih te cakok la om saeh,” a ti nah. Te dongah om tangloeng coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathen loh a saii boeih te a sawt vaengah bahoeng then coeng ne. Te vaengah hlaem neh mincang om tih a rhuk hnin la om.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te tlam te vaan rhoek khaw, diklai khaw, amih kah caempuei boeih khaw a coeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen loh amah kah a bi saii te hnin rhih neh a coeng tih a hnin rhih vaengah a bibi saii boeih te a duem tak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Pathen loh a rhih khohnin te yoethen a paek tih te te a ciim. Te vaengah Pathen tah saii ham a suen a bibi boeih lamloh duem.
  </para>
  <para style="p">
    <verse number="4" style="v" />He tah BOEIPA Pathen loh diklai neh vaan a saii tue ah a suen vaan neh diklai kah a rhuirhong ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah BOEIPA Pathen loh diklai la kho a tlan sak hlan dongah kohong kah tangpuem boeih khaw diklai ah poe hlan. Te dongah lohma kah baelhing boeih daih hlan tih lo tawn ham hlang ana om pawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae diklai lamkah tuihu ha thoeng tih diklai hman boeih a suep.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah BOEIPA Pathen loh diklai lamkah laipi te hlang la a hlinsai. Te phoeiah hingnah hiil te a hnarhong ah a ueng pah tih aka hing tongpa hinglu la coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah BOEIPA Pathen loh khothoeng kah Eden ah dum a hlo tih a hlang saii te a khueh.
  </para>
  <para style="p">
    <verse number="9" style="v" />BOEIPA Pathen loh diklai lamkah thing mueimae then neh caak then boeih te a poe sak tih dum kah laklung ah hingnah thing neh a thae a then mingnah thing om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah dum aka suep ham Eden lamkah tuiva long tih te lamkah a phih uh vaengah tuisae pali la coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lamhma kah a ming tah Pishon tih sui aka om Havilah khohmuen tom la a ken.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te khohmuen kah sui tah then tih thingpi neh oitha lungto khaw pahoi om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah tuiva pabae kah a ming tah Khusah khohmuen boeih aka hil Gihon ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah tuiva a pathum kah ming tah khothoeng Assyria la aka long Khiddekel ni. Tuiva a pali nah tetah Perath ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah BOEIPA Pathen loh hlang te a loh tih Eden dum ah thotat ham neh dum aka hung ham a khueh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah BOEIPA Pathen loh hlang taengah a uen tih, “Dum kah thingkung boeih te caak la ca.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae a then neh a thae mingnah thingkung lamkah te ca boeh. Te te na caak hnin vaeng lamloh na duek rhoe na duek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah BOEIPA Pathen loh , “Hlang he amah bueng tah om ham then pawh anih ham amah neh a naii uh la bomkung ka saii ni,” a ti.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah BOEIPA Pathen loh diklai lamkah, a hlin a sai kohong mulhing boeih neh vaan kah vaa boeih soah metla a khue te hmuh ham khaw, hlang loh a khue boeih te tah mulhing hinglu ming la om sak ham khaw, hlang taengla a khuen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah hlang loh rhamsa boeih khaw, vaan kah vaa te khaw, kohong kah mulhing khaw, ming a paek dae Adam neh aka tiing la bomkung hmu pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah BOEIPA Pathen loh tongpa te muelh a ih sak. A ih vaengah a vaerhuh pakhat te a loh pah phoeiah a pumsa kah a hma te tloep a saibawn sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah BOEIPA Pathen loh tongpa lamkah a loh vaerhuh te huta la a saii tih tongpa taengla a khuen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah tongpa loh , “Tahae kah he ka rhuh lamkah ka rhuh, ka saa lamkah ka saa ni. Anih he tongpa lamkah a loh dongah huta tila ka khue ni,” a ti
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah tongpa loh a napa neh a manu te a toeng ni. Te phoeiah a yuu taengla khoem uh vetih pumsa pakhat la om rhoi ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah tongpa neh a yuu tah pumtling la om rhoi dae yak rhoi pawh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah BOEIPA Pathen loh a saii kohong mulhing boeih lakah rhul te tah thaai tih, huta taengah, “Pathen loh , ‘Dum kah thingkung te khat khaw na ca rhoi mahpawh,’ a ti tatak ngawn a?” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah huta loh rhul taengah, “Dum thing thaih te ka caak rhoi thai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae Pathen loh , 'Dum laklung kah thing thaih te ca rhoi boeh, taek rhoi boeh, te dongah na duek rhoi ve,’ a ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae rhul loh huta taengah, “Na duek rhoe na duek rhoi mahpawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te te na caak rhoi khohnin ah na mik khaw tueng vetih a thae a then ming nah khaw Pathen bangla na om rhoi ni tila Pathen loh a ming dongah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huta long khaw caak ham koi thing then la, mik ham khaw hoehhamnah koi la a hmuh. Te vaengah a lungming la om ham thing te a nai. Te dongah a thaih te a loh tih a caak. Te phoeiah a taengkah a va te khaw a paek tih a caak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah amih rhoi kah mik te bok tueng tih pumtling la a om rhoi te a ming rhoi. Te dongah thaibu hawn te a hui rhoi tih amamih rhoi ham hni la a saii rhoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />BOEIPA Pathen kah ol tah te khohnin kah khohli neh dum khuiah a caeh te a yaak rhoi. Te dongah Adam neh a yuu tah BOEIPA Pathen mikhmuh kah, dum lamloh thingkung lakli ah thuh uh rhoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae BOEIPA Pathen loh hlang tongpa te a khue tih a taengah, “Melam na om,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tongpa loh, “Dum ah na ol ka yaak dae kai pumtling dongah ni ka rhih tih ka thuh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah Boeipa loh , “Nang pumtling ni tila nang taengah ulae aka puen? Caak ham moenih tila nang kan uen thingkung te na caak nama?” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah tongpa loh , “Huta te kai taengah nan paek coeng ta, anih loh thing te kai taengah m'paek dongah ni ka caak,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah BOEIPA Pathen loh huta te, “Hekah he metlam na saii,” a ti nah hatah huta loh , “Rhul loh kai n'rhaithi tih ka caak,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah BOEIPA Pathen loh rhul taengah, “Hetla na saii dongah nang tah rhamsa boeih lakah khaw, kohong kah mulhing boeih lakah khaw, thaephoei thil la na om coeng. Na bung neh na colh vetih na hing tue khuiah laipi na caak ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang laklo neh huta laklo ah khaw, nang kah tiingan laklo neh anih kah tiingan laklo ah khaw, thunkha thunhling ka khueh vetih anih loh na lu ham phop ni. Nang long khaw anih kah khomik te na tuk pah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathen loh huta taengah, “Na thatlohnah neh na rhumpum te ka pungtai rhoela ka pungtai sak ni. Patangnah neh camoe na cun ni. Na lungdueknah te na va ham vetih anih loh nang soah n'taemrhai ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Adam te khaw, “Na yuu ol te na hnatang nah. Te dongah, 'Ca boeh ka ti, ' tih nang kan uen lalah, thingkung lamkah te na caak. Te dongah diklai he nang kong ah thae ka phoei thil coeng. Na hing tue khuiah thatlohnah nen ni buh na caak eh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hling neh lota khaw nang ham daih vetih kohong kah baelhing te na caak ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na talung kah hlantui loh diklai la na bo sak daengah ni buh na caak eh. Laipi lamkah nang n'loh dongah laipi la na bal van ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah Adam yuu te aka hing boeih kah a manu la a om ham dongah a ming te Eve tila a sui.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te daengah BOEIPA Pathen loh Adam ham neh a yuu ham maehpho angkidung te a saii pah tih amih rhoi te a bai sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah BOEIPA Pathen loh , “Hlang he a then khaw a thae khaw ming ham mamih khuikah pakhat phek la ha om coeng he. Tahae ah a kut a yueng tih hingnah thing khaw a loh dongah kumhal hing ham ca lah ve,” a ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah BOEIPA Pathen loh anih te Eden dum lamkah a tueih. Te lamkah ni khohmuen aka tawn ham a loh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlang te khaw a haek coeng tih hingnah thingkung longpuei aka hung ham cherubim neh hmaitak cunghang aka tinghil te Eden dum kah khothoeng ah a khueh.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Adam loh a yuu Eve te a ming. A yuu khaw vawn tih Kain te a cun hatah, “BOEIPA taengkah hlang ka dang coeng,” a ti.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Kain kah a mana Abel te pahoi a cun. Te vaengah Abel tah boiva aka dawn la om tih Kain tah lo tawn la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />A bawtnah khohnin ah BOEIPA taengah khosaa la diklai kah a thaih te Kain loh a khuen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Abel long tah amah kah boiva cacuek neh aka tha te a Khuen van. Te dongah BOEIPA loh Abel so neh anih kah khosaa te a uem pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae Kain neh anih kah khosaa te a uem pah pawt dongah Kain te mat sai tih a maelhmai khaw tal.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah BOEIPA loh Kain taengah “Nang te balae tih na sai? Te phoeiah balae tih na maelhmai a tal?
  </para>
  <para style="p">
    <verse number="7" style="v" />Doe hamla a then mai moenih a? Na then pawt dongah ni thohka ah tholhnah a kol mai. Tedae a lungdueknah te nang ham om mai cakhaw namah loh a soah taemrhai saw ,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Kain loh a mana Abel te kohong la a khue tih a om rhoi vaengah Kain loh a mana Abel te a hnueih tih a ngawn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah BOEIPA loh Kain taengah, “Na mana Abel ta? ” a ti nah hatah Kain loh , “Ka ming pawh. Kai loh ka mana ka dawn a?” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah BOEIPA loh , “Balae na saii? na mana thii ol loh diklai lamkah kai taengla ha pang coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah nang kut lamkah na manuca kah thii aka duen ham a ka aka ang diklai lamloh nang tah thae m'phoei thil coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khohmuen te na tawn vaengah nang taengah a thadueng paek ham koei mahpawh. Diklai ah aka hinghuen tih aka rhaehba la na om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Kain loh BOEIPA taengah, “Kai kathaesainah te phueih ham lakah len aih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tihnin ah kai he diklai hman neh namah hmuh lamkah nan haek dongah ka thuh uh ni. Tedae aka poeng aka doe ka om phoeiah diklai ah ka pamdah cakhaw kai aka hmu boeih loh kai n'ngawn pawn ni he,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae BOEIPA loh anih taengah, “Kain aka ngawn boeih te tah voei rhih due phulo saeh,” a ti nah. Te dongah anih aka hmu boeih loh anih te ngawn pawt ham Kain soah BOEIPA loh miknoek a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Kain tah BOEIPA mikhmuh lamkah cet tih Eden kah khothoeng ben Nodi khohmuen ah kho a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Kain loh a yuu te a ming. Te dongah pumrhih tih Enok te a cun. Te vaengkah khopuei a thoong tih khopuei ming te a capa ming Enok kho la a khue.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah Enok loh Irad a sak tih Irad loh Mahujael a sak. Mahujael loh Methusael te a sak. Methusael loh Lamek te a sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Lamek loh amah ham yuu panit a loh tih pakhat kah a ming tah Adah tih a pabae kah a ming tah Zillah ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Adah loh Jabal te a cun tih anih te dap ah kho aka sa tih boiva aka toi rhoek kah pa la om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae a mana, a ming tah Jubal tih anih te rhotoeng neh phavi aka tum boeih kah a napa la om.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zillah long khaw rhohum neh thi tubael boeih aka hnaa Tubalkain neh Tubalkain kah a ngannu Naamah te khaw a cun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah Lamek loh a yuu rhoi Adah neh Zillah taengah, “Lamek yuu rhoi, kai ol he ya rhoi lamtah kai kah olthui he hnakaeng rhoi lah. Kai tloh kong neh ka boengha kongah camoe, hlang pakhat ka ngawn coeng.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kain ham voei rhih la phu a loh atah Lamek ham khaw voei sawmrhih neh parhih la phuloh pah saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah Adam loh a yuu te koep a ming tih, capa a cun hatah Abel te Kain loh a ngawn coeng dae a yueng la Pathen loh tiingan a tloe kai ham a khueh coeng' a ti dongah anih ming te Seth la a khue.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah Seth long khaw capa a sak tih a ming te Enosh a sui. Te vaengah Yahweh ming te phoei ham a tong.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hekah he Pathen loh hlang a suen tue vaengkah Pathen amah mueiloh la a saii Adam kah rhuirhong cabu ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />tongpa neh huta a suen phoeiah amih rhoi te yoethen a paek tih amih rhoi a suen khohnin ah amih kah ming te hlang a sui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Adam tah kum yakhat phoeiah sawmthum hing. Te vaengah amah muei la amah mueiloh la te a sak tih a ming te Seth a sui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Seth te a sak phoeiah Adam kah a tue khaw kum ya rhet lo coeng dae ca tongpa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Adam kah a hing tue te a pum la kum ya ko neh kum sawmthum a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Seth khaw kum ya neh kum nga a lo vaengah Enosh te a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Enosh te a sak phoeiah Seth khaw kum ya rhet neh kum rhih hing tih a canu a capa rhoek te a sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Seth tah a khohnin boeih kum ya ko neh kum hlai nit a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Enosh khaw kum sawmko a lo vaengah Kenan te a sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Enosh khaw Kenan te a sak phoeiah kum ya rhet neh kum hlai nga hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah Enosh kah a tue boeih he kum ya ko neh kum nga a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kenan kum sawmrhih a lo vaengah Mahalalel te a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kenan loh Mahalalel te a sak tih kum ya rhet neh kum likip a lo phoeiah capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Kenan kah a tue boeih he kum ya ko neh kum rha a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahalalel kum sawmrhuk neh kum nga a lo vaengah Jared te a sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mahalalel loh Jared a sak phoeikah kum ya rhet neh kum sawmthum a lo vaengah canu rhoek neh capa rhoek te a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Mahalalel kah a hing tue boeih tah kum ya rhet neh kum sawmko panga a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jared te kum ya neh kum sawmrhuk neh kum hnih a lo vaengah Enok te a sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jared loh Enok a sak phoeikah kum ya rhet a lo vaengah canu rhoek neh capa rhoek te a sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Jared kah khohnin tah a pum boeih la kum ya ko neh kum sawmruk neh kum hnih a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Enok te kum sawmrhuk neh kum nga a lo vaengah Methuselah te a sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Enok loh Methuselah te a sak phoeiah Pathen neh kum ya thum hmaih a pongpa rhoi phoeiah capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Enok kah khohnin tah a pum boeih la kum ya thum neh kum sawmruk neh kum nga lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Enok tah Pathen neh a pongpa dongah Pathen loh a loh tih vik om pawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Methuselah kum ya neh kum sawmrhet kum rhih a lo vaengah Lamek te a sak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Methuselah loh Lamek a sak phoeikah kum ya rhih neh kum sawmrhet kum nit a lo vaengah capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah Methuselah kah khohnin tah a pum la kum ya ko neh kum sawmruk neh kum ko a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lamek khaw kum ya neh kum sawmrhet neh kum nit a lo vaengah capa pakhat a sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih ming te Noah la a khue. Anih he tah BOEIPA loh thae a phoei thil diklai ah mamih kut kah thatlohnah neh bibi dongah mamih aka hloep ham ni,” a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lamek khaw Noah a sak phoeikah kum ya nga neh kum sawmko kum nga a lo vaengah capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah Lamek kah khohnin he a pum la kum ya rhih neh kum sawmrhih neh kum rhih a lo phoeiah duek.
  </para>
  <para style="p">
    <verse number="32" style="v" />A capa Noah khaw kum ya nga a lo vaengah, Noah loh Shem, Hem, neh Japheth te a sak.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengkah hlang loh diklai hman ah pungtai pahoi tih amamih ham canu a cun uh hatah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen capa rhoek loh hlang canu rhoek te then tila a hmuh uh. Te dongah amih te amamih yuu la boeih a coelh tih a loh uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah BOEIPA loh , “Hlang ngawn tah pumsa la om tih kai kah mueihla loh hlang taengah kumhal ah ka naep eh a ti pawt dongah hlang kah khohnin he kum ya neh kum kul mah om saeh,” a ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaeng tue ah Nephilim rhoek tah diklai ah om uh. A hnukah khaw Pathen capa rhoek te hlang canu rhoek taengah kun uh tih amih ham ca a cun pa uh. Amih te khosuen kah hlangrhalh la ming aka om hlang rhoek ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA loh diklai hmanah hlang kah boethae he yet tih a lungbuei kopoek neh benbonah loh boeih khaw hnin takuem a thae bueng ni tila a hmuh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah BOEIPA loh diklai hmankah hlang a saii te hal coeng tih a lungbuei te tlo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah BOEIPA loh , “Ka suen hlang te diklai hman lamkah ka khoe pawn ni. Hlang khaw, rhamsa khaw, rhulcai khaw, vaan kah vaa khaw amih ka saii dongah te ka hal coeng,” a ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Noah tah BOEIPA mik ah mikdaithen la om.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hekah he tah Noah kah rhuirhong ni. Noah he amah kah thawnpuei khuiah hlang duengneh a cuemthuek la om. Pathen nen khaw Noah tah pongpa hmaih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Noah loh capa pathum Shem, Ham neh Japheth te a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah diklai te Pathen mikhmuh ah poci tih diklai te kuthlahnah loh a khulae.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Pathen loh a sawt vaengah diklai hmanah pumsa boeih tah a longpuei te poci tih diklai khaw poci coeng ne.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Pathen loh Noah taengah, “Pumsa boeih kah a bawtnah tah ka mikhmuh ah pai coeng. Amih mikhmuh lamkah kuthlahnah te diklai hah. Te dongah ni diklai neh amih te ka phae ne.
  </para>
  <para style="p">
    <verse number="14" style="v" />Namah ham gopher thing neh lawng te saii lamtah lawng te a bu saii pah. Te phoeiah a khui ah khaw, poeng ah khaw aang neh hnil.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tekah lawng te metlam na saii eh tikoinih, lawng kah a yun te dong ya thum, a daang dong sawmnga, a sang dong thukip lo ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lawng te imphu na saii vetih tlungyun te tah dong khat cup sak. Te phoeiah lawng kah a kaep ah thohka khueh lamtah a cuek, pabae neh pathum la saii.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai khaw kamah loh pumsa boeih te phae hamla diklai ah tuilii tui kang khuen coeng ne. A khuiah vaan hmui lamkah hingnah mueihla khaw, diklai dongkah a cungkuem he pal ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae nang taengah kai kah paipi te ka thoh vetih nang khaw, na ca rhoek khaw, na yuu khaw, na langa rhoek khaw, namah neh lawng khuila na khuen ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah mulhing boeih lamkah khaw, pumsa boeih lamkah khaw a hluei neh a la te panit ah khueh lamtah namah taengah hing sak ham lawng te boeih paan puei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vaa te khaw amah hui la, rhamsa lamkah khaw amah hui la, diklai ah rhulcai boeih lamkah amah hui la, boeih khuikah panit tah hlun ham nang taengah ham paan saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah na caak ham buh boeih te namah taengah khuen lamtah namah ham tung. Namah ham neh amih ham cakok la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Noah loh a saii tih Pathen loh anih a uen boeih te a saii van.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah BOEIPA loh Noah taengah, tahae kah thawnpuei khuiah nang he kai hmai ah hlang dueng la kan hmuh coeng dongah namah neh na imkhui boeih loh lawng khui la kun laeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aka caih rhamsa boeih lamkah a tal neh a la parhih, parhih neh aka caih mueh rhamsa khuikah te tongpa neh a yal panit ah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Vaan kah vaa khaw diklai hman boeih ah a tii la hlun ham a hluei neh a la panit, panit ah namah taengla lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tahae lamkah hnin rhih phoeiah tah diklai ah khothaih hnin likip neh khoyin hnin likip te kho ka tlan sak vetih diklai hman kah ka saii mulhing boeih te ka khoe ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah BOEIPA loh anih a uen vanbangla a cungkuem te Noah loh a saii.
  </para>
  <para style="p">
    <verse number="6" style="v" />Diklai ah tuilii tui halo vaengah Noah tah kum ya rhuk lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuilii tui kongah Noah loh a ca rhoek khaw, a yuu khaw, a langa rhoek khaw, amah taengah aka om rhoek khaw, lawng khuila a khuen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aka caih rhamsa lamkah khaw, aka caih pawh rhamsa lamkah khaw, vaa khaw, diklai ah aka yuel boeih khaw,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathen loh Noah a uen vanbangla a hluei neh a la panit panit loh Noah taengkah lawng te a paan uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnin rhih a om phoeiah tuilii tui te khaw diklai ah halo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noah kah a hingnah te kum ya rhuk kum, a hla bae, hla kah hnin hlai rhih khohnin ah tuisih laedil puei boeih te phuet tih vaan rhoek kah bangbuet khaw ong uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah khonal te diklai ah khothaih hnin likip neh khoyin hnin likip ah tlan.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amah tekah khohnin van vaengah Noah neh Noah kah a ca rhoek Shem, Ham, Japheth neh Noah yuu neh a langa pathum tah amah neh lawng khuila kun uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih neh mulhing boeih khaw amah hui la, rhamsa boeih khaw amah hui la, diklai ah aka yuel rhulcai boeih khaw amah hui la, vaa boeih khaw amah hui la, vathawt boeih neh phae aka khueh boeih khaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />pumsa ah hingnah hil aka om boeih khuikah loh a bok bok la Noah taengkah lawng khuila kun uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Pathen kah a uen vanbangla pumsa boeih khuikah a hluei neh a la loh ham paan uh tih a kun uh phoeiah BOEIPA loh lawng te a khaih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuilii te khaw diklai ah khohnin likip lo tih tui khaw yet. Te dongah lawng te a phoh hang tih diklai dong lamloh a pom.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tui khaw len khungdaeng tih diklai ah muep a yet dongah lawng te tui hman soah cet.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah tui te diklai ah bahoeng len tih vaan hmui boeih kah tlang sang rhoek boeih te a khuk.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tui te a so ben la dong hlai nga a sang dongah tlang rhoek te boeih a khuk.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah diklai ah aka yuel saa boeih neh vaa boeih, rhamsa khaw, mulhing khaw, diklai dongkah aka luem rhulcai boeih khaw, hlang khaw boeih pal.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hnarhong khuiah hingnah mueihla hiil aka khueh boeih te khaw, lanhak ah aka om boeih te khaw duek uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah diklai hman kah mulhing boeih, hlang lamloh rhamsa due, rhulcai neh vaan kah vaa due, a khoe dongah diklai ah hmata uh. Tedae Noah neh lawng khuiah amah neh aka om rhoek bueng te sueng.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tui te khaw diklai ah khohnin ya neh sawmnga khuiah len.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Pathen loh Noah khaw, mulhing boeih khaw, amah neh lawng khuikah aka om hmaih rhamsa boeih khaw a ngaidam. Te dongah Pathen loh diklai ah khohli a tueih tih tui khaw hnop uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah tuisih laedil neh vaan bangbuet a biing tih vaan lamkah khonal te a paa sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Diklai hman kah tui te khaw rhaeng. Tui te tla tih, rhaeng tih, khohnin ya sawmnga a boeih vaengah kak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeikah a hla rhih hla hnin hlai rhih vaengah lawng te Ararat tlang ah duem.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tui aka om rhoek te khaw hla rha khuiah voehvoeh kak tih a hla rha vaengkah lamhmacuek khohnin ah tlang som rhoek te tueng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah om tih hnin likip a boeih vaengah Noah loh lawng kah bangbuet a saii te a ong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah vangak te a tueih hatah diklai ah tui a haang due dong, cet tih voei bal.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah diklai hman kah tui kak te aka so ham amah taengkah vahui te a tueih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae diklai hman boeih te tui loh a khuk dongah vahui kho kah a khopha ham ngolbuel hmu pawt tih Noah taengah lawng khuila bal. Te vaengah a kut a yueng pah tih vahu te a loh phoeiah lawng khuila a khuen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah hnin rhih koep a rhing tih lawng khui lamkah vahui te koep a tueih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hlaem vaengah vahui te amah taengla ham paan hatah a hmui dongah olive hnah thingsuep pueng ne. Te dongah diklai kah tui kak coeng tila Noah loh a ming.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah hnin rhih a rhing bal tih vahui te a tueih dae anih taengla koep bal voel pawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kum ya rhuk neh kum khat, hla lamhmacuek, lamhmacuek khohnin ah diklai hmankah tui te kak. Te dongah Noah loh lawng kah imphu te a khoe tih a sawt vaengah diklai hman te phueihuet la a hmuh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah a hla bae hnin kul neh hnin rhih nen tah diklai phuei coeng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Pathen loh Noah te a voek tih,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Namah khaw, na yuu khaw, na ca rhoek khaw, namah taengkah na langa rhoek khaw, lawng khui lamkah halo laeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pumsa boeih khuiah namah taengkah aka om mulhing boeih neh vaa boeih khaw, rhamsa neh diklai ah rhuicai aka yuel boeih khaw diklai ah luem tih a pungtai vaengah diklai ah ping sak ham namah taengah khuen rhoe khuen,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Noah neh a ca rhoek khaw, a yuu neh a langa rhoek khaw, hmaih halo uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />mulhing boeih neh rhulcai boeih khaw, vaa boeih neh diklai ah aka colh boeih lawng dong lamloh amah huiko neh pawk uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah Noah loh BOEIPA taengah hmueihtuk a suem. Rhamsa boeih khuikah aka caih neh vaa boeih khuikah aka caih te a loh tih hmueihtuk dongah hmueihhlutnah la a nawn.
  </para>
  <para style="p">
    <verse number="21" style="v" />BOEIPA loh a hmuehmuei te a huep vaengah a botui. Te dongah BOEIPA loh a lungbuei ah, “Hlang kah lungbuei benbonah he a camoe lamkah thae cakhaw hlang kong ah diklai te thaephoei thil ham ka khoep voel mahpawh. Te dongah mulhing boeih ka saii vanbangla ngawn ham ka khoep voel mahpawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Diklai a tue boeih a om khuiah cangti tue neh cangah tue khaw, khosik neh khobae khaw, khohal neh sikca khaw, khoyin neh khothaih khaw paa uh mahpawh,” a ti.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah Pathen loh Noah neh a ca rhoek te yoethen a paek tih amih taengah, “Pungtai uh lamtah na ping uh vaengah diklai te khulae uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmih kah rhimomnah neh na paepnah tah diklai mulhing boeih so neh vaan kah vaa boeih soah, diklai ah aka colh boeih soah, tuitunli kah nga boeih soah om ni. Nangmih kut ah kam paek coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />A cungkuem he nangmih taengah kan paek tih mulhing rhulcai boeih khaw baelhing hingsuep bangla nangmih ham cakok la om ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae maeh kah a hinglu a thii te na ca uh mahpawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah nangmih kah hinglu ham nangmih kah thii te hmantang la ka suk ni. Mulhing boeih kah kut lamkah khaw ka suk vetih Hlang kut lamkah khaw, a manuca kut lamkah khaw, hlang kah hinglu te ka suk ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang he Pathen kah muei la a saii dongah hlang kah thii aka long sak hlang tetah amah thii long van ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae nangmih tah pungtai uh lamtah ping uh. Diklai hmanah luem uh lamtah ping uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Pathen loh Noah neh amah taengkah a ca rhoek te a voek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah, “Kamah loh ka paipi he, nang taeng neh nang phoeikah na tiingan taengah,
  </para>
  <para style="p">
    <verse number="10" style="v" />nang taengkah aka hing hinglu boeih taengah, vaa taengah, rhamsa taengah khaw, diklai mulhing boeih taengah khaw, nangmih taeng neh lawng khui lamkah aka lo boeih taengah khaw, diklai mulhing boeih taengah khaw, ka cak sak coeng ne.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih taengah ka paipi te ka ling coeng dongah pumsa boeih te tuilii tui neh koep ka huih voel mahpawh. Diklai he phae ham tuilii khaw koep om voel mahpawh he,” a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Pathen loh , “Kai loh kamah laklo neh nang laklo ah, khaw aka hing hinglu boeih laklo neh kumhal ham nangmih kah thawnpuei taengah ka paek paipi kah miknoek tah he ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai kah pampacung te cingmai dongah ka khueh vetih kai laklo neh diklai laklo ah paipi kah miknoek la om ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Diklai hmanah cingmai ka om sak vaengah pampacung te khaw cingmai dongah tueng ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah pumsa boeih phae ham tuilii tui koep halo voel boel saeh tila kai laklo neh nangmih laklo ah khaw, aka hing hinglu boeih neh pumsa boeih taengah ka khueh ka paipi te ka poek ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cingmai dongah pampacung te a om vaengah ka sawt vetih Pathen laklo neh diklai hmankah aka hing hinglu boeih, pumsa boeih neh ka khueh dungyan paipi te ka poek ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Pathen loh Noah taengah, “Hekah he tah kai laklo neh diklai hmanah pumsa boeih laklo ah ka ling paipi kah miknoek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lawng khui lamkah halo uh vaengah Noah ca rhoek Shem, Ham, Japheth, om uh tih Ham tah Kanaan kah a napa la om.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amih pathum tah Noah kah a ca rhoek tih amih lamkah ni diklai pum ah a hae uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Noah te lo tawn hlang la om tih misur a tue.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah misurtui te a ok tih a rhuihmil dongah a dap khui ah rha uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kanaan napa Ham loh a napa kah a yah te a hmuh vaengah kawtpoeng kah a maya rhoi taengah puen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae Shem neh Japheth long tah himbai te a loh rhoi tih amamih rhoi kah a nam ah a khueh rhoi. Te phoeiah a hnuk long caehnawt rhoi tih a napa kah a yah te a khuk pah rhoi. Tedae a hmai khoep a hoi rhoi dongah a napa kah a yah te hmu rhoi pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noah te misurtui a lamloh a haenghang vaengah a capa a noi loh anih soah a saii te a ming.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Kanaan taengah thae a phoei tih, “A maya rhoi taengah sal rhoek khuikah sal la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah, “Shem kah BOEIPA Pathen te a yoethen saeh lamtah anih ham sal la Kanaan om saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathen loh Japheth te yoek saeh lamtah Shem kah dap khuiah rhaehrhong saeh. Kanaan tah anih ham sal la om saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuilii phoei lamkah Noah te kum ya thum neh kum sawmnga hing coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Noah kah khohnin he a pum la kum ya ko neh kum sawmnga a lo phoeiah duek.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah hekah he tah Noah ca rhoek Shem, Ham, neh Japheth neh tuilii phoeiah amih loh a sak a ca rhoek kah rhuirhong ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japheth ca rhoek la Gomer, Magog, Madai, Javan, Tubal, Meshek, neh Tiras om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Gomer ca rhoek la Ashkenaz, Riphath neh Togarmah om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah Javan ca rhoek la Elishah, Tarshish, Kittim, neh Dodanim om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amih lamkah ni sanglak kah namtom loh amah khohmuen la amah ol neh amah huiko loh amah namtu khuiah rhip a caeh uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Ham ca rhoek la Khusah, Mizraim, Put neh Kanaan om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Kusah ca rhoek la Seba, Havilah, Sabtah, Raamah neh Sabteka om tih Raamah ca rhoi la Sheba neh Dedan om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Kusah loh Nimrod te a sak tih anih te diklai hmankah hlangrhalh lamhmacuek la om.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih te BOEIPA mikhmuh ah sayuep hlangrhalh la a om van dongah, “BOEIPA hmai ah sayuep hlangrhalh Nimrod van ni,” a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah anih kah khohmuen a tongnah tah Babylon, Erek, Akkad neh Shinar ram Kalneh ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te khohmuen lamkah Assyria la cet tih Nineveh, Rehobothir, neh Kalah te a thoh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Nineveh laklo neh Kalah laklo kah Resen te tah khopuei len la om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Mizraim loh Ludim khaw, Anamim khaw, Lehabim neh Naptuhim khaw,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrusim neh Philisti lamkah aka lo Kasluhim neh Kapthorim khaw a sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kanaan loh a caming la Sidon phoeiah Kheth,
  </para>
  <para style="p">
    <verse number="16" style="v" />Jebusi, Amori, Girhashi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Khivee, Arkit, Sinih,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvadi, Zemari, neh Hamathiti te a sak tih a hnukah Kanaan koca la taekyak uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Kanaani kah khorhi aka om te Sidon lamkah Gerar benkah Gaza due na cet ni. Sodom taengkah Gomorrah, Admah, Zeboim neh Lasha due na cet ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hekah he amah khohmuen ah amah namtu kah ol, amah huiko neh aka om Ham ca rhoek ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ham Japheth mana, Eber ca rhoek boeih kah a napa Shem long khaw, ca a sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem koca ah Elam neh Assyria, Arpaxad, Lud neh Aram om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aram ca rhoek la Uz, Huul, Gether neh Mash om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arphashad long khaw Shelah a sak tih Shelah loh Eber te a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber te ca panit a sak dae anih tue vaengah khohmuen a tael dongah pakhat kah a ming te Palak la om tih a mana ming te Yoktawn la om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yoktawn loh Almodad, Sheleph, Hazarmaveth, Jerah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="28" style="v" />Obal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophir, Havilah, neh Jobab a sak. Te rhoek te Yawktawn kah a ca boeih ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Mesha lamkah Sephar khothoeng tlang due na caeh vaengah amih kah tolrhum la om.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hekah rhoek he amah namtu neh amah khorhi ah amah ol la amah huiko neh aka om Shem ca rhoek ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />He tah amah namtu ah amamih kah rhuirhong la aka om Noah ca rhoek kah a huiko rhoek ni. Te dongah tuilii phoeiah he lamkah ni namtom rhoek loh diklai hmanah a yaal uh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah diklai pum ah ol pakhat neh olka thikat laom.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae amih te khothoeng la a puen uh hatah Shinar khohmuen ah kolbawn a hmuh uh tih teah te kho a sak uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah hlang loh a hui taengah, “Halo, laiboeng sai uh sih lamtah hmai neh tik uh sih,” a ti uh. Te dongah lungto yueng la laiboeng te a khueh tih taplai yueng la lungpaat a khueh uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah, “Lo lah, mamih ham khopuei neh rhaltoengim khaw, a soi te vaan duela sa uh sih. Te dongah mamih ham ming khueh sih, diklai pum kah mikhmuh ah vik n'taekyak uh ve,” a ti uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae khopuei te hmuh ham BOEIPA ha pawk vaengah hlang ca rhoek loh rhaltoengim te ana sak uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />BOEIPA loh amih he pilnam pakhat neh ol pakhat la boeih a om uh dongah saii ham a mangtaeng uh khaw saii ham a tong uh hatah amih ham lol tlaih pawt la he!
  </para>
  <para style="p">
    <verse number="7" style="v" />Ceh, suntla uh sih lamtah amih ol te thoek pah sih. Te daengah ni hlang loh a hui kah hmuilai te a yaak pawt eh?,” a ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah BOEIPA loh amih te diklai hman boeih ah a taekyak tih khopuei thoh ham khaw a toeng uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />He kongah BOEIPA loh diklai pum kah ol he pahoi a thoek pah tih a ming te Babylon a sui. Te lamlong tah BOEIPA loh amih te diklai hman boeih ah a taekyak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hekah he Shem kah rhuirhong ni. Shem te kum yakhat lo ca coeng tih tuilii kum phoeiah Arpaxad te a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arpaxad te a sak phoeiah Shem khaw kum ya nga hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arpaxad khaw kum sawmthum neh kum nga a lo vaengah Shelah te a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shelah te a sak phoeiah Arpaxad khaw kum ya li neh kum thum hing tih a capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shelah khaw kum sawmthum a lo vaengah Eber te a sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Eber te a sak phoeiah Shelah khaw kum ya li neh kum thum hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Eber khaw kum sawmthum neh kum li a lo vaengah Palak te a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Palak te a sak phoeiah Eber khaw kum ya li neh kum sawmthum hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palak khaw kum sawmthum a lo vaengah Reu te a sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Reu te a sak phoeiah Palak khaw kum yahnih neh kum ko hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reu khaw kum sawmthum neh kum nit a lo vaengah Seruk te a sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Seruk te a sak phoeiah Reu khaw kum ya neh kum rhih hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seruk khaw kum sawmthum a lo vaengah Nakhaw te a sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nakhaw te a sak phoeiah Seruk khaw kum yahnih hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nakhaw khaw kum kul neh kum ko a lo vaengah Terah te a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Terah te a sak phoeiah Nakhaw khaw kum ya neh kum hlai ko hing tih capa rhoek neh canu rhoek te a sak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Terah khaw kum sawmrhih a lo vaengah Abram, Nakhaw, neh Haran te a sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah hekah he Terah kah rhuirhong ni. Terah loh Abram, Nakhaw neh Haran te a sak tih Haran loh Lot te a sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae Haran te a napa Terah mikhmuh ah a pacaboeina khohmuen Khalden kho Ur ah duek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah Abram neh Nakhaw loh yuu a loh rhoi. Abram yuu ming tah Sarai tih Nakhaw yuu ming tah Haran canu Milkah ni. Haran tah Milkah neh Iskah kah a napa ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah Sarai te yaa la om tih camoe khueh pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae Terah loh a capa Abram neh a capa Haran kah capa Lot khaw, a capa Abram yuu a langa Sarai khaw, a khuen tih Khalden kho Ur lamkah Kanaan khohmuen la caeh ham tun hlah uh dae Haran te a pha uh vaengah teah te kho vik a sak uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Terah kah a tue khohnin he kum yahnih neh kum nga lo. Terah khaw Haran ah duek.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh Abram taengah, “Nang te na khohmuen taeng lamloh, na pacaboeina taeng lamloh, na pa im lamloh cet laeh. Te khohmuen te nang kan tueng bitni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae nang te pilnu la kan saii vetih nang yoethen kan paek ni. Na ming ka rhoeng sak vetih yoethennah om ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah nang yoe aka then sak rhoek te a yoe ka then sak vetih nang aka kosinah te khaw thae ka phoei ni. Nang kong ah diklai huiko boeih a yoethen uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah BOEIPA loh anih taengah a thui bangla Abram a caeh hatah Lot khaw anih taengah cet van. Tedae Abram Haran lamkah a caeh vaengah kum sawmrhih neh kum nga lo ca coeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram loh a yuu Sarai te khaw, a maya capa Lot te khaw, khuehtawn a dang uh boeih te khaw, Haran ah a dang hinglu te khaw a khuen. Te phoeiah Kanaan khohmuen la caeh ham hlah uh tih Kanaan khohmuen te a paan uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Abram te khohmuen kah Shekhem hmuen Moreh thingnu due a pha. Tedae te vaengah Kanaan te khohmuen ah ana om uh coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Abram taengah BOEIPA a phoe pah tih, “Hekah khohmuen he na tiingan taengah ka paek ni,” a ti nah. Te dongah amah taengah aka phoe BOEIPA ham hmueihtuk pahoi a suem pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah te lamkah khothoeng tlang Bethel la puen uh tih tuitunli benkah Bethel neh Ai khothoeng laklo ah amah kah dap a tuk. Te phoeiah BOEIPA ham hmueihtuk a suem tih BOEIPA ming te a phoei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Abram te aka puen uh ham cet tih Negev la puen uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae khohmuen ah khokha a om dongah Abram te Egypt la cet. Te la a bakuep akhaw khohmuen ah khokha te a nah dongah ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Egypt la kun ham a yoei vaengah a yuu Sarai taengah, “Na mueimae sakthen nu tila ka ming coeng ne.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Egypt rhoek loh nang te m'hmuh uh vaengah, 'Anih yuu ni he,’ a ti uh ni. Te vaengah kai n'ngawn uh vetih nang te n'hing sak uh ni he.
  </para>
  <para style="p">
    <verse number="13" style="v" />Namah te kai ngannu la thui mai. Te daengah ni nang kong neh kai ham khaw thuem vetih nang kong ah ka hinglu khaw a hing eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abram Egypt la kun tih Egypt loh a hmuh uh vaengah a yuu te a sakthen tangkik.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharaoh kah mangpa rhoek loh anih te a hmuh uh vaengah Pharaoh ham anih te a thangthen uh. Te dongah huta te Pharaoh im la a khuen uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih rhang neh Abram ham khaw then tih tu khaw saelhung khaw, laak khaw, salpa khaw, salnu khaw, laak tal khaw, kalauk khaw Abram taengla boeih kun.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Abram yuu Sarai kah dumlai kongah Pharaoh neh anih imkhui te BOEIPA loh a nah la lucik neh a vuek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Pharaoh loh Abram te a khue tih, “Hekah he ba ham lae kai taengah na saii. Balae tih anih he namah yuu tila kai taengah na puen pawh?
  </para>
  <para style="p">
    <verse number="19" style="v" />Balae tih, anih he ka ngannu na ti. Te dongah ni anih he ka yuu la kamah taengah ka loh. Tedae na yuu he lo lamtah cet laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah anih ham Pharaoh loh a hlang rhoek te a uen tih, Abram khaw, a yuu khaw, a taengkah aka om boeih te khaw a tueih uh.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah Abram loh a yuu khaw, anih taengah aka om boeih te khaw, amah taengkah Lot khaw Egypt lamkah Negev la a khuen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te daengah te Abram loh boiva neh, ngun neh, sui nen khaw lutlut boei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Negev lamkah a longpueng vaengah amah kah dap a om nah hmuen Bethel la cet. A moecuek vaengah anih kah dap te Bethel neh Ai laklo ah om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lamhma ah hmueihtuk hmuen la pahoi a khueh coeng dongah Abram loh BOEIPA ming pahoi a phoei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Lot khaw Abram neh puei uh tih boiva saelhung khaw, dap khaw, rhen a puen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae tun khosak ham te khohmuen amih te noeng voel pawh. Amih rhoi kah khuehtawn khaw muep lo coeng tih tun khosak ham coeng pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah Abram kah boiva aka dawn rhoek neh Lot kah boiva aka dawn rhoek laklo ah khaw, te vaengah khohmuen kah kho aka sa Kanaan rhoek, Perizzi rhoek nen khaw tuituknah vik om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Abram loh Lot te, “Kai laklo neh nang laklo ah, ka boiva aka dawn laklo neh na boiva aka dawn laklo ah khaw tohhaemnah om mai boel saeh. Mamih boeina he tongpa rhoi ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na hmai ah khohmuen a pum la a om pawt moenih a? Kai taeng lamloh hoep uh laeh. Banvoei te na loh atah bantang la ka cet vetih bantang te na loh atah ka banvoei bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae Lot loh a mik te a huel vaengah Jordan vannaem boeih te tuisuep tangtae bangla boeih a om pah. Yahovah loh a phae hlankah Sodom neh Gomorrah khaw BOEIPA dum bangla, Zoar la a caeh vaengkah Egypt kho bangla a hmuh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah Lot loh amah ham te Jordan vannaem boeih te a tuek. Te dongah Lot te khothoeng la puen uh tih a manuca taeng lakah khat neh khat paek uh rhoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram tah Kanaan kho ah kho a sak dae Lot tah vannaem kah khopuei rhoek ah kho a sak tih Sodom la puen uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Sodom hlang rhoek tah thae uh tih BOEIPA taengah hlangtholh koek la om uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Lot a nong phoeiah BOEIPA loh Abram te, “Na mik huel lamtah na hmuen lamkah tlangpuei neh tuithim khaw, khothoeng neh tuitunli khaw so laeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tekah khohmuen na hmuh boeih te kumhal duela nang taeng neh na tiingan taengah kam paek ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah na tiingan te diklai kah laipi bangla ka khueh ni. Diklai laipi te hlang loh tae ham a noeng atah nang kah tiingan te a tae thai van ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khohmuen te nang kan paek ham coeng dongah thoo lamtah khohmuen te a yun long khaw, a daang long khaw, hil lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Abram te puen uh tih a caeh vaengah Mamre thingnu ah kho a sak. Tekah thingnu te Hebron ah om tih tekah Hebron ah BOEIPA ham hmueihtuk a suem.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaeng tue kah aka om Shinar manghai Amraphel, Ellasar manghai Ariyawk, Elam manghai Kedorlaomer neh Goiim manghai Tidal loh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Sodom manghai Bera, Gomorrah manghai Birsha, Admah manghai Shinab, Zeboiim manghai Shemeber neh Zoar manghai Bela taengah caemtloeknah a saii uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te rhoek boeih te Lungkaeh tuitunli kah Siddim kol ah cingcui uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kedorlaomer taengah kum hlai nit thotat uh dae kum a hlai thum vaengah a tloelh uh coeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kum hlai li vaengah Kedorlaomer khaw amah taengkah manghai rhoek neh cet tih Ashterothkarnaim kah Rephaim neh Ham kah Zuzim khaw, Shaveh Kiriathaim kah Emim khaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />Seir tlang kah Khori neh khosoek taengkah Elparan duela a tloek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah bal uh tih Kadesh kah Enmishpat te a paan uh vaengah Amalek khohmuen boeih neh Hazezontamar ah kho aka sa Amori te khaw a tloek uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Sodom manghai khaw, Gomorrah manghai khaw, Admah manghai khaw, Zeboiim kah manghai Zeboiin khaw, Zoar manghai Bela khaw, amih neh aka thoo hmaih Siddim kol kah caemtloeknah te khaw,
  </para>
  <para style="p">
    <verse number="9" style="v" />Elam manghai Kedorlaomer khaw, Goiim manghai Tidal khaw, Shinar manghai Amraphel khaw, Ellasar manghai Aryawk khaw manghai rhoek pali panga te a muk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Sodom neh Gomorrah manghai te rhaelrham uh dae Siddim kol kah aka om tuito, lungpaat tuito ah cungku rhoi tih aka sueng rhoek te tlang la rhaelrham uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah Sodom neh Gomorrah kah khuehtawn boeih khaw cakok boeih a loh uh tih cet uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah Abram maya capa Lot khaw Sodom ah kho a sak van dongah amah neh a khuehtawn te rhen a khuen uh tih a caeh puei uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah hlangyong te Mamre thingnu rhoek taengah aka cu Amori hoel Eshkol neh Aner kah a manuca tah halo tih Hebrew hoel Abram taengah puen. Amih te Abram kah a tai kung ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />A manuca a sol pah te Abram loh a yaak van neh amah kah a hlangphaep neh a im kah a cahlah ya thum neh hlai rhet te a hui tih Dan duela a hloem.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae khoyin ah amah loh a sal rhoek te hloephloep a tael tih caem a tloek. Te phoeiah amih te Damasku kah banvoei ben Hobah duela a hloem.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah khuehtawn boeih neh a manuca Lot khaw a lat tih anih kah khuehtawn khaw huta rhoek khaw pilnam khaw ham bal puei bal.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Kedorlaomer neh anih taengkah manghai rhoek te a tloek phoei lamkah Abram a bal vaengah anih aka doe ham Sodom manghai loh Shaveh kol manghai tuikol la cet.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah Pathen Pathen taengkah khosoih, Salem manghai Melkhizedek loh vaidam neh misurtui a khuen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Abram te yoethen a paek tih, “Vaan neh diklai aka men Pathen Pathen loh Abram yoe a then sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na rhal rhoek te nang kut ah aka tloeng Pathen Pathen khaw a yoethen pai,” a ti nah. Te dongah Abram loh a cungkuem khui lamkah parha pakhat te anih taengla a paek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae Sodom manghai long tah Abram taengah, “Hinglu te kai ham khueh lamtah khuehtawn te namah ham khuen,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Abram loh Sodom manghai taengah, “Vaan neh diklai aka men Khohni Pathen Yahweh taengah ka kut ka phuel coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang taengkah boeih tah rhuihet neh khokhom rhui pataeng ka doe mahpawh. Te daengah ni, 'Kai loh Abram ka boei sak,’ na ti pawt eh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kai te rhaemaih. Tedae camoe rhoek kah a caak neh Aner Eshkol neh Mamre ah kamah taengla aka lo hlang rhoek kah hamsum te tah amamih kah hamsum la lo uh saeh,” a ti nah.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hekah olka phoeiah tah BOEIPA kah olka te mikhlam ah Abram taengla thoeng tih, “Abram rhih boeh. Kai he nang kah photling la ka om, na thapang bahoeng yet ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae Abram loh , “Ka Boeipa Yahovah aw, kai ham balae na khueh? Kai loh cakol la ka van tih kamah im kah Damasaku hoel Eliezer ni ca la ka pang “a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Abram loh , “Kai taengah tiingan nan paek moenih he. Te dongah ka im kah camoe ni ka pang coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah BOEIPA kah olka loh Abram la, “Anih na pang pawt vetih namah ko khui lamkah aka thoeng te tloep na pang eh ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Abram te poeng la a khuen tih, “Vaan ke paelki lamtah aisi ke tae mai lah. Amih te na tae thai atah a thui vanbangla nang kah tiingan la om van ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te daengah BOEIPA te a tangnah tih anih kah tangnah te duengnah la a nawt pah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah ni anih taengah, “Hekah khohmuen he nang taengah paek ham neh pang sak ham Khalden Ur lamkah nang aka khuen te BOEIPA kamah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae anih loh, “Ka Boeipa Yahovah aw, anih ka pang ni tila metlamlae ka ming eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Abram la, “Kai taengah vaitola kum thum neh maae a la kum thum, tutal kum thum, vahu, vahuica hang khuen,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te rhoek boeih te a taengla a khuen pah phoeiah a laklung ah a saek. Te phoeiah a kaekvang te a hui taengah a hmaitoh sak tih a tloeng pah. Tedae vathawt te tah saek pawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah vatlung loh maehrhok te a cuk thil tih Abram loh a hawt.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae khomik tla tih Abram khaw ih ham a yalh thuk vaengah a soah mueirhih tamyin loh khuk a tlak thil tarha.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Abram te, “Na tiingan loh amah khohmuen mueh ah yinlai la om ni. Te vaengah amih te thotat uh vetih kum ya li a phaep uh ni tila ming rhoe ming laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae a thotat pah namtom te khaw kai loh lai ka tloek vetih a hnukah nang kah tiingan tah khuehtawn a yet neh ha pawk uh ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah nang tah a then la na sampok neh na pa rhoek taengah na cet vetih sading la n'up uh ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae tahae due Amori kathaesainah a rhoeh pawt dongah tahae lamkah a khong li vaengah ha bal uh ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khomik tla tih a hmuep a pha vaengah hmaipom hmaikhu neh hmaithoi hmai te maehpoel laklo ah a pak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tekah khohnin ah BOEIPA loh Abram taengah moi a boh tih, “Tahae kah khohmuen he Egypt tuiva lamkah tuiva puei Perath tuiva duela,
  </para>
  <para style="p">
    <verse number="19" style="v" />Keni te khaw, Kenizzi te khaw, Kadmoni khaw,
  </para>
  <para style="p">
    <verse number="20" style="v" />Khitti khaw, Perizzi khaw, Rapha khaw,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amori khaw, Kanaani khaw, Girgashi khaw, Jebusi khaw, nang kah tiingan taengah ka paek coeng,” a ti nah.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram yuu Sarai loh anih ham ca cun pah pawh. Tedae amah taengah salnu, a ming ah Hagar, Egypt nu om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Sarai loh Abram la, “Ca cun ham khaw BOEIPA loh kai n'khaih coeng he. Ka salnu taengla kun mai lamtah, anih lamloh ka thoh khaming,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Sarai ol te Abram loh a ngai. Te dongah Kanaan kho ah Abram loh kho a sak te kum kumrha a thok vaengah Abram yuu Sarai loh a sal Egypt nu Hagar te a loh tih a va Abram taengah a yuu la a paek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah Hagar te a kun thil hatah pahoi pumrhih. Tedae a pumrhih te a ming vaengah a mik neh a boeinu te hnaep.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Sarai loh Abram taengah, “Kai sokah kuthlahnah te nang pum dongah tla saeh. Kai loh na rhang dongah ka salnu kam paek dae a pumrhih te a hmuh vaengah a mik neh n'hnaep he kai laklo neh nang laklo ah BOEIPA loh laitloek mai saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Abram loh Sarai la, “Na salnu te namah kut ah om ne. Na mikhmuh ah then ti bangla anih te saii saw,” a ti nah. Te dongah anih te Sarai loh a phaep tih anih khaw Sarai mikhmuh lamloh yong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Shur long taengkah tuiphuet kaep, khosoek tuiphuet tui taengah BOEIPA kah puencawn a hmuh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah, “Sarai kah salnu Hagar me lamkah lae na lo tih melam na caeh eh?” a ti nah. Te dongah Hagar loh, “Ka boeinu Sarai hmuh lamloh ka yong coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae BOEIPA kah puencawn loh , “Na boeinu taengah mael lamtah anih kut hmuiah yalh mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah BOEIPA kah puencawn loh Hagar taengah, “Nang kah tiingan te pungtai rhoela ka pungtai sak vetih a khawk uet ah n'tae lek mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah BOEIPA kah puencawn loh anih te, “Nang kah phacipphabaem te BOEIPA loh a yaak coeng dongah nang na vawn tih camoe a om vaengah a ming te Ishmael la na khue ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae anih he hlang kah kohong marhang la om ni. A kut loh hlang tom a veet vetih hlang boeih kah kut loh anih veet cakhaw a manuca boeih kah mikhmuh ah kho a sak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah, “Kai aka hmu kah a hnuk te hela koep ka hmuh,” a ti dongah anih taengah aka cal BOEIPA ming te, “Nang tah Mueihmuh Pathen,” tila a khue.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Kadesh laklo neh Bered laklo kah tuito ke Beerlahairoi a sui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Hagar loh Abram ham capa a cun pah. Hagar loh a cun a capa te Abram loh a ming Ishmael tila a sui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hagar loh Abram ham Ishmael a cun pah vaengah Abram khaw kum sawmrhet kum rhuk lo ca pueng.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram kum sawmko neh kum ko a lo ca vaengah Abram taengla BOEIPA phoe tih, “Kai tah Tlungthang Pathen ni. Kai mikhmuh ah pongpa lamtah cuemthuek la om lah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka paipi he kamah laklo neh nang laklo ah ka khueh vetih nang te muep muep kam ping sak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Abram loh a hmai la a bakop hatah Pathen loh ,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Kai khaw he, nang taengah ka paipi a om vanbangla namtom hlangping kah a napa la na om ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang he namtom hlangping kah a napa la kan khueh coeng dongah na ming khaw Abram la n'khue voel mahpawh. Tedae nang ming te Abraham la om pawn ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang te muep muep kan pungtai sak vetih namtom rhoek la kan khueh ni. Te vaengah nang taeng lamkah manghai rhoek ha thoeng ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah ka paipi he kamah laklo neh nang laklo ah khaw, nang phoeikah na tiingan, amih kah cadilcahma laklo ah kumhal paipi la ka thoh ni. Nang ham neh nang phoeikah na tiingan ham Pathen la ka om ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah na lampahnah khohmuen Kanaan kho pum te kumhal khohut la nang neh nang phoeikah na tiingan taengah kam paek vetih amih taengah Pathen la ka om ni “a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Pathen loh Abraham taengah, “Te dongah ka paipi he nang namah ham khaw, nang phoeikah na tiingan ham khaw, amih kah cadilcahma ham khaw ngaithuen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka paipi he kamah laklo neh nang laklo ah khaw, nang phoeikah na tiingan laklo ah ngaithuen vetih nangmih khuikah tongpa boeih te yahhmui rhet pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah yahhmui na rhet vaengkah na yahhmui saa te kai laklo neh nang laklo kah paipi miknoek la om ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah nangmih khuikah neh na cadilcahma, im kah cahlah, neh namah tiingan lamkah pawt tih tangka neh na lai kholong ca boeih khuikah tongpa boeih loh hnin rhet a lo ca vaengah yahhmui rhet saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na im kah cahlah long khaw, na tangka neh na lai long khaw, yahhmui a rhet rhoela a rhet daengah ni ka paipi loh na pumsa dongah kumhal paipi la a om eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae amah kah yahhmui saa aka rhet mueh tongpa pumdul te tah ka paipi a kak sak dongah a pilnam khui lamkah tekah hinglu te khoe saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Pathen loh Abraham taengah, “Na yuu Sarai amah ming neh na khue mahpawh. Anih ming Sarah te Sarai yuengla om coeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih khaw yoethen ka paek vetih anih rhang neh nang ham capa khaw kan paek ni. Anih yoethen ka paek vetih namtom la coeng ni. Pilnam rhoek kah manghai rhoek khaw anih khui lamkah ha thoeng uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Abraham tah a maelhmai neh bakop tih a nueih doela a lungbuei khuiah , “Kum yakhat pa loh a sak vetih kum sawmko nu Sarah loh ca a cun koinih? ” a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Abraham loh Pathen taengah, “Na hmai ah Ishmael mah hing mai koinih,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Pathen loh , “Thuem ngawn dae na yuu Sarah loh nang ham capa han cun vetih a ming te Isaak na sui ni. Ka paipi khaw anih neh anih phoeikah a tiingan ham dungyan paipi la ka thoh ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Ishmael ham khaw ka yaak ngawn ne. Anih khaw yoethen ka paek vetih ka pungtai sak ni. Muep muep ka ping sak phoeiah khoboei hlai nit a sak vetih pilnu la ka khueh ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae ka paipi he Isaak taengah ni ka thoh eh. Anih te hmai kum kah tahae khoning vaengah Sarah loh nang hamla a cun ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih taengah thui ham te a khah van neh Pathen khaw Abraham taeng lamkah nong.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Abraham loh a capa Ishmael khaw, a im kah cahlah boeih khaw, Abraham imkhui tongpa rhoek khuikah a tangka neh a lai tongpa boeih te a khuen tih Pathen loh a thui bangla amah khohnin van ah amih kah yahhmui saa te a rhet pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Abraham loh a yahhmui saa a rhet vaengah kum sawmko neh kum ko lo ca coeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />A capa Ishmael khaw kum hlai thum a lo ca vaengah a yahhmui saa te a rhet pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tekah khohnin van ah Abraham neh a capa Ishmael te yahhmui rhet pah la om.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah a im kah hlang boeih, im kah cahlah neh kholong ca tangka neh a lai te khaw amah neh yahhmui a rhet uh.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham te khothaih khobae vaengah Mamre thingnu rhoek kaepkah dap thohka ah ngol dae anih taengla BOEIPA a phoe pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah a mik a huel tih a sawt hatah a taengah hlang pathum a pai te lawt a hmuh. Te dongah amih te doe ham dap thohka lamkah yong tih diklai la bakop.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah, “Ka Boeipa na mikhmuh ah mikdaithen ni ka dang mai atah na sal taeng lamkah he khumpael mai boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tui bet han khuen mai saeh lamtah na kho silh uh mai. Te dongah thing hmuiah ana hangdang uh mai dae.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae na sal taengah na pawk rhoi to vaengah buh kamat khaw ka loh dae vetih na lungbuei a duel phoeiah na cet rhoi mako,” a ti nah. Te vaengah, “Na thui bangla na saii pai,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Abraham te Sarah taengah dap khuila koe kun tih, “Vaidam buh sum thum te a loe la nook lamtah buh thong laeh” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Abraham te saelhung taengla yong tih vaito ca a mongkawt neh a then te a loh. Te phoeiah cadong taengah a paek tih a loe la a saii sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah suknaeng neh suktui khaw, vaito ca a hmoel te khaw han khuen tih amih hmai ah a tawn pah. Tedae a caak uh vaengah amah te amih taengkah thing hmuiah pai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah, “Na yuu Sarah ta?,” a ti na uh hatah, “Dap khuiah om ke,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah, “Lomai tue ah nang taengla ka lo rhoe ka lo ni. Te vaengah na yuu Sarah te camoe om pawn ni te,” a ti nah. Te vaengah dap thohka kah anih hnukah aka om Sarah loh a hnatun van.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Abraham neh Sarah kah a kum patong la om rhoi coeng. Huta vanbangla Sarah taengkah khosing om ham khaw bawt coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Sarah loh amah ko khuiah, “Kai taengah omthennah a om ham ka hal tih ka boeipa khaw patong coeng,” a ti tih nuei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae BOEIPA loh Abraham taengah, “Balae tih Sarah loh , 'Kai patong khaw ca ka cun tang venim,’ a ti tih, a nueih he.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hno pakhat he BOEIPA ham rhaisang a? Lomai tue kah khoning vaengah nang taengla ka mael ni. Te vaengah Sarah taengah capa om ni?” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae Sarah loh a rhih dongah, “Ka nuei pawh,” a ti tih a basa dae, “Pawh na nueih lalah,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te daengah hlang rhoek loh thoo uh tih Sodom ben la a dan uh hatah amih aka thak ham Abraham khaw amih taengah cet.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae BOEIPA loh , “Kai loh ka saii te Abraham taengah ka phah a?,” a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham khaw namtu len neh pilnu la om rhoe om ni. Anih lamloh diklai namtom boeih a yoethen ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih ka ming daengah ni anih phoeikah a ca rhoek neh a imkhui te a uen vetih duengnah neh tiktamnah saii ham BOEIPA kah longpuei a ngaithuen uh eh. Te daengah ni BOEIPA loh Abraham ham a taengah a thui pah te a thoeng eh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae BOEIPA loh Sodom neh Gomorrah a doek vaengah amih kah tholhnah khaw pungtai tih bahoeng nah coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka suntla laeh vetih a pangngawlnah te ka hmuh mako. Kai taengla aka pawk te boeih a saii uh neh a saii uh pawt khaw ka ming mako,” a ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah hlang rhoek loh te lamkah hooi uh tih Sodom la a caeh uh vaengah Abraham tah BOEIPA hmai kah pai pueng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah Abraham te thoeih tih, “Hlang dueng neh halang te na khoengvoep sak tang aya?
  </para>
  <para style="p">
    <verse number="24" style="v" />Kho khui ah aka dueng sawmnga om khaming, na khoengvoep kuekluek aya? Amih khui kah hlang dueng sawmnga ham hmuen te na hlun mahpawt a?
  </para>
  <para style="p">
    <verse number="25" style="v" />Halang taengah aka dueng duek sak ham hno he saii ham tah nang lamloh savisava. A dueng la, halang la a om khaw, nang lamloh savisava saeh. Diklai pum lai aka tloek loh tiktamnah saii mahpawt nim?,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae BOEIPA loh , “Sodom ah sawmnga ka hmuh tih khopuei khui ah hlang dueng om koinih amih kong ah hmuen takuem la ka khuen ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae Abraham loh a doo tih, “Kai he laipi neh hmaiphu la ka om dae Boeipa taengah cal ham ka mulmet coeng he.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aka dueng sawmnga te panga loh a vaitah khaming, panga kongah khopuei pum te na phae aya?” a ti nah hatah, “Sawmli panga te ka hmuh koinih ka phae mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae anih te voek hamla koep a koei tih, “Likip te a hmuh uh khaming,” a ti nah vaengah, “Likip kong ah ka saii mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah, “Boeipa, saii boel mai lamtah ka thui mai eh. Sawmthum khaw a hmuh uh khaming,” a ti nah. Tedae, “Sawmthum te ka hmu koinih ka saii mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae Abaraham loh, “Boeipa taengah cal ham ka mulmet coeng he. Teah te pakul khaw a hmuh uh khaming,” a ti nah vaengah pakul kong ah ka phae mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah khaw, “Sai boel mai dae Boeipa vai bueng mah ka thui mai eh. Hlang rha khaw a hmu uh khaming,” a ti nah vaengah, “Hlang rha kong ah ka phae mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />BOEIPA loh Abraham neh cal ham te a khah van neh vik nong tih Abraham khaw amah hmuen la bal.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlaem pakhat vaengah puencawn rhoi loh Sodom a pha rhoi. Te vaengah Lot te Sodom vongka ah ngol. Lot loh a hmuh vaengah amih rhoi doe ham thoo tih a mikhmai neh lai la bakop thuk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah, “Ka boei aw, na sal im la ha phael mai dae ne. Rhaeh lamtah na kho sil rhoi dae. Na thoo vetih na longpuei ah na cet dam bitni,” a ti nah. Tedae, “Pawh, toltung ah ka rhaeh rhoi bitni,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae amih rhoi te tlal a hloep dongah anih taengla hoii uh tih a im ah kun uh. Amih rhoi ham buhkoknah a saii vaengah vaidamding te a kaeng pah tih a caak uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae a yalh uh hlan ah khopuei hlang Sodom rhoek ca neh camoe patong la pilnam boeih loh a dik a noi duela im a vael uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Lot te a khue uh tih, “Khoyin ah nang taengla aka lo hlang rhoi te ta? Amih rhoi te ka ming uh van ham kaimih taengla han khuen,” a ti na uh .
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Lot te thohka la cet tih a hnukkah thohkhaih te a khaih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah, “Ka manuca rhoek thaehuet uh boel mai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka taengah canu panit om pueng he, te rhoi loh tongpa a ming rhoi moenih. Amih rhoi te nangmih taengla kang khuen pawn eh. Te vaengah amih rhoi te na mik loh then a ti bangla saii uh. Tedae hekah hlang rhoi taengah tah hno saii uh boeh. Ka tungpum hlipkhup la ha kun dongah he,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae, “Thoeih lah,” a ti uh. Te phoeiah, “Bakuep hamla hlang pakhat te halo tih lai a tloek tarha aya? Amih rhoi lakah namah te kan talh uh ve ne,” a ti uh. Te vaengah hlang te khaw, Lot te khaw khak a aep uh tih thohkhaih te boh ham thoeih uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah im khuikah hlang rhoi loh kut a yueng uh tih Lot te amih taeng lamkah im khuila a doek rhoi phoeiah thohkhaih te tlup a khaih rhoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah im thohka kah hlang rhoek te tanoe kangham due mikdael neh a ngawn tih thohka hmuh ham khaw khobing uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah hlang rhoi loh Lot taengah, “Nang taengah ulae aka om pueng? Na cava neh na capa rhoek khaw, na canu rhoek neh khopuei khuikah namah hut boeih te he hmuen lamkah khuen laeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />BOEIPA mikhmuh ah amih kah pangngawlnah loh rhoeng coeng tih hekah hmuen he phae ham BOEIPA loh kaimih n'tueih dongah khopuei he ka phae rhoi pawn ni,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Lot te cet tih a canu rhoek kah a loh a cava rhoek taengah a thui pah vaengah, “Khopuei he BOEIPA loh a phae dongah hekah hmuen lamkah thoo uh lamtah cet uh laeh,” a ti nah. Tedae a cava rhoek kah mikhmuh ah nueihbu bangla a om pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae mincang a pha vaengah puencawn rhoi loh Lot te a tanolh rhoi tih, “Thoo lamtah na yuu khaw, na canu aka om rhoi he khuen laeh. Khopuei kathaesainah dongah na khoengvoep ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah uelh tih hlang rhoek te amah kut, a yuu kut neh a canu rhoi kah kut khaw a hlaengtang uh. BOEIPA kah thinphatnah he anih soah a om dongah anih te a khuen tih khopuei vongvoel ah duem uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amih te poeng la a khuen neh amih taengah, “Na hinglu te yong puei laeh. Na hnuk paelki boeh. Vannaem takuem ah pai boeh, tlang la yong laeh, na khoengvoep ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae Lot loh amih rhoi taengah, “Pawh ka Boeipa bet ca mah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na sal he na mikhmuh ah mikdaithen ka dang tih na sitlohnah te na rhoengsak dongah ka hinglu hing sak ham kai taengah nan saii coeng. Tedae kai he tlang daengla yong ham tah ka coeng oeh pawh. Yoethae loh kai m'puei vetih ka duek ve.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahae ah ke kah khopuei la rhaelrham ham yoei ta ke. Te dongah anih ke yiit cakhaw pahoi ka yong mai eh. Anih te ka hinglu aka hing sak ham yiit pawt maco?,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah anih te, “Hekah olka ham khaw na mikhmuh ah kan paek vetih na thui khopuei te ka palet mahpawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A loe la yong pahoi laeh, ke la na pawk hil pakhat khaw saii ham ka coeng thai moenih,” a ti nah. Te dongah khopuei ming khaw Zoar a sui.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lot loh Zoar a pha vaengah khomik loh khohmuen ah thoeng coeng.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah BOEIPA loh BOEIPA taengkah kat hmai te Sodom neh Gomorrah ah vaan lamkah a tlan sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah tekah khopuei rhoek neh vannaem boeih khaw, khopuei kah khosa kho boeih neh diklai toian khaw a palet.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae Lot yuu loh a hnuk a paelki dongah lungkaeh tung la poeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham tah mincang ah BOEIPA mikhmuh kah a pai nah hmuen la pahoi hlah uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sodom neh Gomorrah ben kah, vannaem khohmuen phai boeih te a dan thuk vaengah hmailing hmaikhu bangla diklai hmaikhu a thoeng te lawt a hmuh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Pathen loh vannaem kah khopuei a phae vaengah Pathen loh Abraham te a poek. Te dongah Lot te a paletnah khui lamloh a khuen. Te phoeiah Lot loh kho a sak nah khopuei te a palet.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Lot te Zoar lamkah nong tih tlang ah kho a sak. Te vaengah a canu panit te khaw amah taengah om. Zoar ah khosak ham a rhih dongah a canu rhoi khaw lungko khuiah om uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah a caming loh canoi la, “A pa he patong coeng tih diklai pum kah khosing la mamih rhoi taengah aka kun ham hlang khaw diklai ah om voelpawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Halo, a pa ke misurtui tul sih lamtah a taengah yalh sih. Te phoeiah a pa neh tiingan hing sak sih,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah a napa te amah tekah khoyin ah misurtui a tul rhoi. Te vaengah a caming kun tih a napa taengah yalh dae me vaengah yalh tih me vaengah a thoh khaw ming pawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tekah a vuen ah khaw caming loh canoi taengah, “Hlaemyin ah a pa taengla ka yalh coeng. Tihnin hlaem ah misurtui tul bal sih. Paan lamtah a taengah yalh van. A pa neh tiingan khaw hing sak sih,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amah tekah hlaem ah khaw a napa te misurtui koep a tul rhoi tih canoi loh a kun thil. A taengah yalh dae me vaengah yalh tih me vaengah a thoh khaw ming pawh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah Lot canu rhoi te a napa loh a vawn sak.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te phoeiah caming loh capa a cun tih a ming te Moab a sui dongah tihnin due Moab rhoek kah a napa la om.
  </para>
  <para style="p">
    <verse number="38" style="v" />Canoi long khaw capa a cun van tih a ming te Benammi a sui dongah tihnin due Ammon ca rhoek kah a napa la om.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Abraham loh Negev kho la puen uh tih Kadesh neh Shur laklo ah kho a sak vaengkah Gerar ah bakuep.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Abraham loh a yuu Sarah te ka ngannu ni a. ti dongah Gerar manghai Abimelek a tah tih Sarah te a loh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae Abimelek te khoyin a mang ah Pathen loh a paan tih a taengah, “Rhukom tangtae hlang yuu te na rhawt dongah na duek coeng ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Abimelek loh anih te ben pawh. Tedae, “Boeipa namtom loh dueng cakhaw na ngawn aya?
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah loh kai taengah, 'Anih ka ngannu a ti tih he long khaw ka nganpa ni, ' a ti moenih a? Ka thinko thincaknah neh, ka kut cimcaihnah nen ni he khaw ka saii,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah anih te a mang ah Pathen loh , “Ue hekah he nang loh thinko thincaknah neh na saii tila ka ming. Tedae anih taek sak ham nang kam paek pawt dongah kai taengah tholh khui lamloh nang te kan tuem kan soem.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahae ah hlang yuu te mael laeh. Anih te tonghma tih nang ham a thangthui daengah ni na hing eh. Na mael pawt atah na taengkah boeih neh namah khaw na duek rhoe na duek ni tila ming laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Abimelek te mincang ah thoo tih a sal boeih te a khue. Te phoeiah hekah olka boeih he amih hna ah a thui hatah hlang boeih loh a rhih uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abimelek loh Abraham te a khue tih, “Kaimih ham balae na saii, nang taengah metlam ka tholh tih kamah so neh ka ram ah tholh muep nan khuen. Kai taengah na saii bibi te a saii uh noek moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah Abimelek loh Abraham te, “Hekah dumlai he na saii vaengah balae na hmuh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Abraham loh , “Hekah hmuen ah Pathen hinyahnah om pawt tih ka yuu kah olka ah kai n'ngawn uh ve ka ti dongah ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae anih te a pa canu ka ngannu rhep ni. A nu canu pawt dae ka yuu lam khaw om ngawn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah a pa im lamkah Pathen loh kai kho m'hmang sak vaengah anih taengah, 'Nang kah sitlohnah he kai taengah na saii ham atah mekah hmuen boeih ah m'pha cakhaw, 'Anih he ka nganpa ni, 'ti ne tila kamah loh pahoi ka ti nah coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah Abimelek loh tu neh saelhung khaw, sal tongpa neh salnu khaw a loh tih Abraham te a paek. A yuu Sarah te khaw amah taengah a mael.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Abimelek loh , “Na mikhmuh kah ka khohmuen aka om he namah mik ah then na ti bangla khosa ngawn ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sarah taengah khaw, “Na nganpa taengah tangka thawngkhat nang ham hmaithennah ka paek coeng tih namah taengkah aka om boeih neh hlang boeih hmaiah na tang uh coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Abraham te Pathen taengah thangthui. Pathen loh Abimelek khaw, a yuu khaw, a salnu rhoek khaw a hoeih sak dongah ca a sak uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham yuu Sarah kah lai ah Abimelek im kah hlang bung boeih te BOEIPA loh a khaih rhoela a khaih pah.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA loh a ti bangla Sarah te a hip tih a thui bangla Sarah ham BOEIPA loh a saii.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen loh anih a uen bangla Sarah te vawn tih khoning vaengah tah a patong soi ah Abraham ham capa a cun pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah anih ham Sarah loh a sak pah amah ca sak, a capa ming te Abraham loh Isaak sui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen kah a uen vanbangla Abraham loh a capa Isaak te hnin rhet a lo ca vaengah yahhmui a rhet pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Abraham kum ya a lo ca vaengah a capa Isaak te amah taengah a cun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Sarah loh , “Pathen loh kai taengah nueihcil han saii he aka ya boeih loh kai taengah nuei van ni,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah, “Sarah loh camoe a khut ni tila Abraham taengah unim aka thui tih a patong daengah capa ka cun he,” a ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Camoe te khaw puel tih suk a kan coeng dongah Abraham loh Isaak kah sukkan khohnin ah buhkoknah muep a saii.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae Abraham ham Egypt nu Hagar loh a cun a capa loh a nueih thil te Sarah loh a hmuh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah Abraham taengah, “Salnu kah capa he ka capa Isaak taengah rho a pang thai pawt dongah salnu neh a capa te haek laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae a capa kongmai dongah olka he, Abraham mik ah bahoeng lolh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae Pathen loh Abraham taengah, “Camoe ham neh na salnu ham te na mik dongah lolh sak boeh. Isaak rhang neh nang ham tiingan thuep ham coeng dongah Sarah loh nang taengah a thui bangla, anih ol boeih hnatangnah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae salnu capa te khaw na tiingan coeng dongah anih te namtom la ka khueh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Abraham loh mincang ah thoo tih buh neh tuitang tui te a loh. Te phoeiah Hagar a paek tih a laengpang ah a vah. Te phoeiah camoe neh a tueih tih a caeh vaengah Beersheba khosoek ah kho a hmang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae tuitang khuikah tui te a khawk vaengah camoe te tangpuem pakhat hmuiah sut a voeih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Camoe kah dueknah te ka hmuh boel mai eh a ti dongah Cet tih li thikat kah tluk a lakhla la amah te ngol. Tedae a yoei la koep ngol tih a ol a huel doeah rhap.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Pathen loh camoe kah a rhah ol te a yaak. Te dongah Pathen kah puencawn loh Hagar te vaan lamkah a khue tih, “Hagar, nang taengkah te balae? Ke lamkah camoe ol te Pathen loh a yaak coeng dongah rhih boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thoo, camoe te poeh lamtah anih te namah kut neh talong lah. Anih pilnu la ka khueh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah Pathen loh a mik a tueng sak tih tuito tui a hmuh. Te dongah cet tih tuitang dongah tui a than phoeiah camoe te a tul.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae camoe taengah Pathen a om dongah pantai tih khosoek ah kho a sak hatah liva aka kap la coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Paran khosoek ah kho a sak vaengah a yuu te a manu loh Egypt kho lamkah a loh pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengkah tue ah aka om olka te tah Abimelek neh amah kah caempuei mangpa Phikhol loh Abraham te, “Nang kah na saii boeih dongah nang taengah Pathen om taktak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah na bakuep nah khohmuen ah nang ham sitlohnah ka saii vanbangla kai taengah na saii van tih, kamah neh ka ca taengah, ka cadil taengah khaw rhilat pawt ham Pathen hmaiah kai hamla toemngam laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Abraham loh , “Kamah loh ka toemngam coeng,” a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Abimelek kah sal rhoek loh tuito tui a rhawth pa kongmai dongah Abimelek te Abraham loh a tluung.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae Abimelek loh , “Hekah dumlai he u loh a saii khaw ka ming pawt tih nang long khaw kai taengah na puen pawt dongah kai khaw tihnin due ka yaak moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah Abraham loh boiva neh saelhung a khuen tih Abimelek te a paek phoeiah amamih rhoi kah moi a boh rhoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Abraham loh boiva khuikah tumanu pumrhih te a pai sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Abimelek loh Abraham te, “Hekah tumanu pumrhih he metlae amamih bueng na hoep,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae Abraham loh, “Ka kut lamkah tumanu pumrhih he na doe coeng atah tahae kah tuito ka too dongah kai ham laipai la rhep na om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tekah hmuen te amih rhoi loh a toemngam rhoi dongah Beersheba tila a sui.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah Beersheba ah moi a boh uh phoeiah Abimelek neh amah kah caempuei mangpa Phikhol khaw thoo uh tih Philisti kho la voei uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Beersheba ah kolanhlaeng a phung tih kumhal Pathen BOEIPA ming te pahoi a khue.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah Abraham he Philisti kho ah kum a yet bakuep.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hekah olka a om phoeiah Pathen loh Abraham te a noemcai tih, “Abraham,” a ti nah hatah “Kai ni he ue,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah, “Tahae ah na capa, na oingaih cangloeng, na lungnah Isaak te khuen lamtah Moriah khohmuen la namah cet laeh. Te phoeiah nang taengah ka thui bangla, tlang pakhat ah hmueihhlutnah la anih te pahoi nawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Abraham te mincang ah thoo tih laak te a khih. Amah taengkah cadong panit neh a capa Isaak te a khuen tih hmueihhlutnah thing te a aeh. Te phoeiah thoo tih Pathen loh anih taengah a thuinuet nah hmuen la cet.
  </para>
  <para style="p">
    <verse number="4" style="v" />A hnin thum dongah Abraham loh a mik a huel hatah khohla kah hmuen te a hmuh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Abraham loh cadong rhoi taengah, “Hiah laak neh namah poekah ana om uh dae . Kai neh camoe he kela ka cet rhoi vetih tho ka thueng rhoi phoeiah nangmih taengla ka bal rhoi ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah Abraham loh hmueihhlutnah thing te a loh tih a capa Isaak a koh sak. Te phoeiah a kut dongah hmai neh tumcaca a khuen tih amamih rhoi te hmaih cet rhoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah Isaak loh a napa Abraham te a voek tih, “A pa,” a ti nah. Te vaengah, “Ka ca kai ka om he,” a ti nah hatah, hmai neh thing om dae hmueihhlutnah ham tu ta he,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Abraham loh , “Ka ca hmueihhlutnah ham tu te Pathen amah loh a hmuh bitni,” a ti nah tih amamih rhoi tah hmaih cet rhoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Pathen loh anih taengah a uen nah hmuen te a pha rhoi. Te dongah Abraham loh hmueihtuk pahoi a suem tih thing a hong thil phoeiah a capa Isaak te a pin tih hmueihtuk sokah thing so ah a tloeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah a capa te ngawn ham Abraham loh a kut a yueng tih tumcaca a yueh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae vaan lamkah BOEIPA puencawn loh anih te a khue tih, “Abraham, Abraham,” a ti nah vaengah “Kai ni he,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah, “Kai taeng lamkah na capa na oingaih cangloeng te na hloh pawt dongah na Pathen na rhih tila ka ming coeng. Te dongah camoe soah na kut hlah boel lamtah anih taengah ba khaw saii boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Abraham loh a mik a huel hatah a hnukkah kocak khuiah tutal a ki aka man te lawt a hmuh. Te dongah Abraham khaw cet tih tutal te a loh phoeiah a capa yueng ah hmueihhlutnah la a nawn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Abraham loh a hmuen ming te, “BOEIPA phoe,” tila a sui. “Tihnin ah BOEIPA loh tlang ah a phoe sak bitni,” a ti rhoe pai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah BOEIPA kah puencawn loh Abraham te vaan lamkah a pabae la a khue tih,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Hekah hno na saii vaengah na capa, na oingaih cangloeng te na hloh pawt dongah,
  </para>
  <para style="p">
    <verse number="17" style="v" />nang yoethen khuikah yoethen rhep kan paek tih na tiingan te vaan kah aisi neh tuitunli palang laivin bangla ka pungtai rhoe ka pungtai sak ni. Te vaengah na tiingan loh a thunkha vongka te a pang ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah kai ol te na ngai dongah nang kah tiingan rhang neh diklai namtom boeih loh a yoethen uh ni tila BOEIPA olphong neh kamah loh ka toemngam coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae cadong rhoi taengla Abraham a bal phoeikah aka thoo uh te Beersheba la tun a pawk uh dongah Abraham loh Beersheba ah kho a sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahae kah olka a om phoeiah Abraham taengah,” Na manuca Nakhaw ham Milkah loh ca tongpa,
  </para>
  <para style="p">
    <verse number="21" style="v" />A caming la Uz tih a mana Buz neh Aram napa Kemuel khaw,
  </para>
  <para style="p">
    <verse number="22" style="v" />Kesed khaw, Hazo khaw, Pildash khaw, Jidlap neh Bethuel te khaw a sak van ne,” a ti nah uh tih a thui pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Milkah loh Abraham kah a manuca Nakhaw ham tongpa parhet a sak pah. Rebekah he Bethuel loh a sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah a yula, a ming ah Reumah loh Tebah, Gaham, Tahash neh Maakah a sak pah bal.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sarah kah a hingnah khaw kum ya kum kul kum rhih lo. Sarah kah a hingnah kum tah amah he coeng ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sarah te Kanaan kho Hebron kah Kiriatharba ah duek. Te dongah Sarah rhaengsae ham Abraham cet tih a rhah thil.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Abraham te duek kung lamkah thoo tih Kheth ca rhoek te a voek tih,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Kai tah nangmih taengah yinlai neh lampah ni, nangmih kah khohut phuel te kai taengah m'pae mai, ka mikhmuh lamkah ka hlang duek ka up thai ham khaw,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae Kheth ca rhoek loh Abraham a doo uh tih amah taengah,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ka boeipa kaimih ol he hnatun lah . Kaimih khui ah namah ni Pathen khoboei. Kaimih kah phuel saelh khuiah na rhok te up ngawn . Na duek vaengah up ham tah kaimih kah hlang loh a phuel te nang taengah hloh mahpawh,” a ti nauh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah Abraham te thoo tih tolrhum kah pilnam hmai neh Kheth ca rhoek hmaiah bakop.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amih te koep a voek tih, “Ka mikhmuh kah aka duek he up ham nangmih hinglu ah ni a om atah kai ol hnatang uh lamtah kai yueng la Zohar capa Ephron te hloep uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih kah lohma bawt ah aka om amah hut Makpelah kah lungko te kai taengah m'pae mai saeh. Tangka a ting yet la m'pae saeh lamtah nang lakli ah kamah kah phuel khohut la om saeh ,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Kheth ca rhoek lakli ah Ephron ngol. Te dongah Khitti hoel Ephron loh khopuei vongka la aka lo Kheth ca rhoek boeih kah a hna ah Abraham te a doo tih,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Pawh, ka boeipa, kai ol hnatun lah, khohmuen te nang kan paek coeng dongah a khuikah lungko khaw ka pilnam koca rhoek kah mikhmuh ah nang kan paek vanbangla nang kan paek phuel ah na rhok khaw up,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Abraham te tolrhum pilnam hmai ah bakop tih,
  </para>
  <para style="p">
    <verse number="13" style="v" />tolrhum pilnam kah hna yaak ah Ephron te, “Nang khaw kai ol he hnatun mai. Kai lamkah khohmuen phu tangka kan paek vetih na doe koinih ka rhok khaw pahoi ka up sue,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Ephron loh Abraham te a doo tih amah taengah,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Ka boeipa, kai ol hnatun lah . Khohmuen phu tangka shekel ya li te kai neh nang laklo ah bahamnim ca?Tahae ah khaw na rhok te up ngawn ,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham loh Ephron te a rhoi. Te dongah thimpom taengkah vanbangla tangka shekel ya li te Kheth ca rhoek kah hna yaak ah a tae tih Abraham loh Ephron ham tangka a thuek pah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Mamre khohmuen kaep, Makpelah kah Ephron lo neh a khuikah lungko te khaw, lohma li neh a kaepvai rhi boeih kah thing boeih khaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />khopuei vongka la aka lo boeih hmai neh Kheth ca rhoek kah mikhmuh ah Abraham kah kho lai la a saii.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoei daengah Kanaan kho Hebron Mamre kaep, Makpelah lo kah lungko ah a yuu Sarah te Abraham loh a up.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah lohma neh a khuikah lungko te Kheth ca rhoek taeng lamkah Abraham phuel khohut la a hlaih.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham khaw a tue loh patong ben a paan coeng dae a cungkuem dongah BOEIPA loh Abraham te yoethen a paek .
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Abraham loh a im kah a koe boeih aka taem sal a ham taengah, “Na kut te ka phai hmuiah tloeng laeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai loh amih lakli ah kho ka sak dae Kanaan nu rhoek te ka capa kah a yuu la lo boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae ka khohmuen neh ka pacaboeina taengah cet lamtah ka ca Isaak ham yuu loh pah tila vaan Pathen, diklai Pathen BOEIPA ming neh nang kan toemngam sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah a sal loh Abraham te , “Hekah khohmuen la kai hnukah vai ham huta loh a huem pawt khaming, na poenah kho la na capa te ka bal khaw ka bal puei aya? ” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Abraham loh anih taengah, “Nang te ngaithuen, ka capa te ke la na khuen ve ne.
  </para>
  <para style="p">
    <verse number="7" style="v" />A pa im neh ka pacaboeina khohmuen lamkah kai aka khuen tih ka taengah a thui vaengah, 'Hekah khohmuen he nang tiingan ham ka khueh ni, ' tila aka toemngam, vaan kah Pathen BOEIPA loh nang hmai ah amah kah puencawn te a tueih vetih ka capa ham a yuu te ke lamkah nan loh pah bitni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae huta loh nang taengah lo ham a huem pawt atah ka olhlo dong lamloh m'hmil saeh. Tedae ka capa te ke la khuen boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah salpa loh a kut te a boei Abraham kah a phai hmuiah a khueh tih hekah olka ham amah taengah a toem a ngam .
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah salpa loh a boei kah kalauk pumrha a loh tih a kut ah a boei kah thennah cungkuem neh cet. Te vaengah thoo tih Nakhaw kah khopuei Aramnaharaim la cet.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae hlaem tue vaengkah tuithan rhoek a caeh tue vaengah kalauk te khopuei voel kah tuito tui taengah a kol sak tih,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Ka boei Abraham kah BOEIPA Pathen aw, ka boei Abraham taengah sitlohnah han saii lamtah tihnin ah kai he m'phu sak laeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuiphuet tui kah ka pai vaengah tui than la khopuei hlang kah tanu aka lo rhoek khuikah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Hula aka om te, 'Na amrhaeng hal dae lamtah tui ka o eh?,’ ka ti nah vaengah, 'O lamtah na kalauk rhoek khaw tui kan tul eh?,’ aka ti te na sal Isaak ham na hmoel pah. Anih dongah ka boei taengah sitlohnah nan saii tila ka ming ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae a thui te a khah hlanah Abraham kah a manuca Nakhaw yuu Milkah capa Bethuel loh a sak Rebekah te a laengpang ah amrhaeng neh pakcak ha pawk.
  </para>
  <para style="p">
    <verse number="16" style="v" />A mueimae bahoeng aka then huta oila la om tih anih te tongpa loh ming hlan. Tuiphuet la suntla tih amrhaeng te a than tih yoeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah anih doe ham salpa te yong. Te phoeiah, “Nang kah amrhaeng tui bet n'coih ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah, “Ka boeipa o mai saw,” a ti nah tih a kut kah a amrhaeng te khaw koe a hal pah. Te phoeiah anih te a tul.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih te bawt a tul phoeiah, “Na kalauk rhoek ham khaw a ok rhoeh hil kan than dae eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah a amrhaeng te tuisoi dongah koe a kingling tih tui than hamla tuito la koep yong. Te phoeiah a kalauk boeih ham tui a than.
  </para>
  <para style="p">
    <verse number="21" style="v" />BOEIPA loh a longpuei a thaihtak sak neh a thaihtak sak pawt khaw ming hamla tongpa loh huta te duem a boelh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah kalauk loh bawt a ok nen tah tongpa loh sui hnaii a khiing beka khat neh a kut dongkah ham sui khungpak panit, a khiing parha te a loh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah, “Nang ukah canu lae?Kai taengah thui lah. Na pa im ah pah ham a hmuen kaimih ham om aya? ,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah anih taengah, “Kai tah Milkah loh Nakhaw ham a cun a capa Bethuel canu ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah anih te, “Kaimih taengah cangkong khaw, kamvuelh khaw, coih tih rhaeh hmuen khaw om,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah tekah hlang te buluk tih BOEIPA te a bawk.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah, “Ka boei Abraham kah Pathen BOEIPA tah a yoethen pai. A sitlohnah neh uepomnah loh ka boei te hnoo pawh. Kai khaw ka boei kah a manuca im duela longpuei ah BOEIPA loh m'mawt coeng,” a ti.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hula te khaw yong tih hekah olka te a manu cako ham a thui pah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah Rebekah te a nganpa, a ming ah Laban khaw om. Te dongah Laban te tollong la yong tih tuiphuet kah hlang taengla cet.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae hnaii neh a ngannu kut kah khungpak te lawt a hmuh tih a ngannu Rebekah loh , “Tekah hlang loh kai taengah a thui,” a ti nah, ol a yaak. Hlang te a paan vaengah tah, tuiphuet kah kalauk taengah sut ana pai pah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah, “BOEIPA kah yoethen a paek tah halo pai. Balae tih vongvoel ah na pai? Kai khaw im neh kalauk ham hmuen ka rhoekbah coeng ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te daengah tekah hlang loh im la cet tih kalauk te a hlam. Te phoeiah kalauk ham cangkong neh kamvuelh khaw, anih kho neh a taengkah hlang rhoek kho silh nah hamla tui khaw a paek.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah caak te amih hmai ah a tawn pah hatah, “Kamah kah olka ka thui hlanah ka ca mahpawh,” a ti nah. Te dongah, “Thui,” a ti nah hatah,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Kai tah Abraham kah sal ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tahae ah BOEIPA loh ka boeipa te yoethen muep a paek dongah boei coeng. Te phoeiah anih te boiva khaw, saelhung khaw, cak neh sui khaw, salpa neh salnu khaw, kalauk neh laak khaw a paek.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka boeipa kah a yuu Sarah khaw a patong soiah ka boeipa ham ca a sak pah tih a taengkah koe boeih te anih ham a khueh pah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae ka boeipa loh kai te, 'Ka capa yuu ham tah kai loh kho ka sak thil khohmuen kah Kanaan nu te loh pah boeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae a pa im la lat cet lamtah kamah huiko te ka ca yuu la loh pah,’ a ti tih a toem a ngam .
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae ka boeipa te, 'Kai hnukah huta te halo pawt khaming,’ ka ti nah hatah,
  </para>
  <para style="p">
    <verse number="40" style="v" />'BOEIPA amah mikhmuh ah ni kai ka caeh. Nang taengah amah kah puencawn te han tueih vetih na longpuei a thaihtak sak vaengah ka capa yuu khaw kamah huiko neh a pa im lamkah te na loh thai ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kamah huiko taengla na pawk mak atah kai kah thaephoeinah lamkah m'hmil bitni. Nang taengah a canu te m'paek uh pawt akhaw kai kah thaephoeinah lamkah ommongsitoe la na om ngawn ni, ' a ti.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tedae tihnin ah tuiphuet te kam pha tih, 'Ka boei Abraham kah Pathen BOEIPA aw, namah na om atah he la ka pongpa vaengah ka longpuei han thaihtak sak laeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kai loh tuiphuet kah tui taengah he ka pai vaengah tuithan la aka lo hula te om mai tih anih te, “Na amrhaeng dongkah tui te kai bet n'tul laem,’ ka ti nah vetih,
  </para>
  <para style="p">
    <verse number="44" style="v" />Te vaengah kai taengah, 'Namah o ngawn lamtah na kalauk rhoek ham khaw kan than eh?,’ ti saeh. Tekah huta te ka boeipa kah a capa ham BOEIPA loh hmoel saeh,” ka ti.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kai loh ka lungbuei ah ka thangthui te ka khah hlanah mah Rebekah loh a laengpang sokah amrhaeng neh tarha ha pawk tih tuiphuet la suntla thuk. Tui a than phoeiah anih te, 'Kai n' tul laem,’ ka ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te vaengah amah pum dongkah amrhaeng te koe a hal tih, 'O lamtah na kalauk rhoek khaw ka tul eh?,” a ti. Te dongah ka ok tih kalauk rhoek te khaw tui a tul.
  </para>
  <para style="p">
    <verse number="47" style="v" />Te phoeiah anih te ka dawt tih, 'Nang u canu lae?' ka ti nah vaengah Milkah loh Nakhaw ham a sak pah a capa Bethuel canu ni, ' a ti. Te dongah a hnarhong ah hnaii ka bang pah tih a kut ah khungpak ka buen sak.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te phoeiah ka buluk tih BOEIPA te ka bawk vaengah, “Ka boei kah a manuca canu te a capa ham aka lo la oltak longpuei ah kai aka mawt ka boei Abraham kah BOEIPA Pathen te ka uem.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tedae tahae ah ka boeipa ham sitlohnah neh uepomnah tueng ham na huem atah kai taengah thui lah. Kai taengah na thui uh pawt bal atah banvoei bantang la ka mael mai eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te dongah Laban neh Bethuel loh a doo tih, “BOEIPA lamkah olka aka thoeng te a thae then khaw nang taengah ka thui rhoi thai pawh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Na mikhmuh ah Rebekah aka om he lo lamtah caeh puei . BOEIPA kah a thui vanbangla na boeipa capa kah a yuu la om saeh,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Amih rhoi kah olka te Abraham kah sal loh a yaak vaengah BOEIPA taengah diklai la bakop tih a bawk.
  </para>
  <para style="p">
    <verse number="53" style="v" />Te phoeiah salpa loh cak hnopai neh sui hnopai khaw, himbai khaw a sat tih Rebekah te a paek. A nganpa neh a manu te khaw kawnthen a paek pah.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te daengah amah neh amah taengkah hlang rhoek khaw a caak a ok uh tih rhaeh uh. Mincang a thoh uh vaengah, “Ka boeipa taengah kai n'tueih mai laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tedae a nganpa neh a manu loh , “Hula he kaimih taengah khohnin hninrha tluk om dae vetih na cet mako,” a ti nah.
  </para>
  <para style="p">
    <verse number="56" style="v" />Te dongah Abraham kah salpa loh amih taengah, “BOEIPA loh ka longpuei han thaihtak sak vanbangla kai he n'hloh uh boel mai. Ka boeipa taengah n'tueih mai lamtah kai ka cet mai eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="57" style="v" />Te dongah, “Hula te khue uh sih lamtah amah olthui te dawt uh dae sih,” a ti uh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Rebekah te a khue uh phoeiah, “Hekah hlang taengah na cet aya? ” a ti nah uh vaengah, “Ka cet ni ta,” a ti.
  </para>
  <para style="p">
    <verse number="59" style="v" />Te dongah a ngannu Rebekah neh anih kah cakhoem te khaw, Abraham kah sal neh a hlang rhoek te khaw a tueih uh.
  </para>
  <para style="p">
    <verse number="60" style="v" />Te vaengah Rebekah te yoethen a paek uh tih amah taengah, “Ka ngannu nang tah a thawng thawngrha la coeng lamtah, na tiingan loh a lunguet kah vongka te huul saeh,” a ti nahuh.
  </para>
  <para style="p">
    <verse number="61" style="v" />Te phoeiah Rebekah neh hula rhoek te thoo uh tih kalauk soah ngol uh. tongpa hnukah a caeh uh ham coeng dongah Rebekah te Abraham kah sal loh a loh tih a caeh puei .
  </para>
  <para style="p">
    <verse number="62" style="v" />Te vaengah Negev kho ah khosak ham Beerlahairoi lamkah aka lo Isaak khaw ha pawk.
  </para>
  <para style="p">
    <verse number="63" style="v" />Hlaem a pha vaengah Isaak te lohma la cet tih kho a poek . Te vaengah a mik a huel tih a sawt hatah kalauk tarha ha khong pah.
  </para>
  <para style="p">
    <verse number="64" style="v" />Rebekah long khaw a mik a huel hatah Isaak te a hmuh tih kalauk so lamloh rhum thuk.
  </para>
  <para style="p">
    <verse number="65" style="v" />Te phoeiah salpa taengah, “Mamih doe ham lohma li ah tongpa aka lo ke ulae? ,” a ti nah vaengah a salpa loh , “Ka boeipa ni,” a ti nah dongah hnii te a loh tih a yil.
  </para>
  <para style="p">
    <verse number="66" style="v" />Te phoeiah salpa loh a saii hno boeih te Isaak taengah a thui.
  </para>
  <para style="p">
    <verse number="67" style="v" />Isaak loh hula te dap khuikah a manu Sarah taengla akhuen. Te phoeiah Rebekah te a loh tih anih yuu la coeng. Te dongah anih te a lungnah tih a manu hnukah Isaak khaw hal van.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Abraham loh yuu koep a loh tih anih ming tah Keturah ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham ham Zimran neh Jokshan khaw, Medan khaw, Midian khaw, Ishbak khaw, Shuah khaw a sak pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jokshan loh Sheba neh Dedan te a sak tih Dedan ca rhoek la Asshurim, Lethushim neh Leummim om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Midian ca rhoek la Ephah khaw, Epher khaw, Hanok khaw, Abidah neh Eldaah khaw om tih amih boeih he Keturah ko rhoek ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham loh amah kah a cungkuem te Isaak taengah a paek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Abraham yula rhoek kah a ca rhoek te Abraham loh amah a hing vaengah kutdoe a paek tih a capa Isaak taeng lamkah khothoeng ben khothoeng kho la vik a tueih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah Abraham kah a hingnah kum tue he kum ya neh kum sawmrhih kum nga hing.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Abraham he pal tih a duek vaengah khaw patong sampok then neh ngaikhuek la a pilnam taengah khoem uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah anih te a ca rhoi Isaak neh Ishmael loh Mamre kaep Khitti hoel Zohar capa Ephron lo kah Makpelah lungko ah a up rhoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tekah lo te Abraham loh Kheth ca rhoek taeng lamkah a lai dongah, Abraham loh a yuu Sarah te pahoi khaw a up.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Abraham a dueknah hnutah aka om tah, a capa Isaak te Pathen loh yoethen a paek. Te dongah Isaak loh Beerlahairoi taengah kho a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah hekah he Abraham capa Ishmael, Abraham taengah Sarah loh a paek a sal Egypt nu Hagar loh a cun kah rhuirhong ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />He tah amamih ming bangla Ishmael ca rhoek kah a ming ni. Amih kah rhuirhong dongah Ishmael kah caming tah Nebaioth tih Kedar neh Adbeel, Mibsam,
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Dumah, Massa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadad, Tema, Jetur, Naphish, Kedemah om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amih Ishmael ca rhoek he khaw amah ming, amah vongtung, amah lumim neh amah namtu kah khoboei he hlai nit omuh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Ishmael kah a hingnah kum he kum ya neh kum sawmthum kum rhih a lo vaengah pal tih a duek dongah a pilnam taengla khoem uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih khaw Havilah lamkah Assyria la aka pawk Egypt khorhi Shur duela kho a sak uh tih a manuca rhoek boeih kah imdan ah pakuep uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah hekah he Abraham capa Isaak kah a rhuirhong ni. Abraham loh Isaak a sak tih,
  </para>
  <para style="p">
    <verse number="20" style="v" />Isaak kum sawmli a lo ca vaengah a yuu te Paddanaram kah Arammi Bethuel canu, Arammi Laban ngannu, Rebekah te a loh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae anih te a yaa dongah Isaak loh BOEIPA taengah a yuu yueng la thangthui. Te dongah anih te BOEIPA loh a rhoi tih a yuu Rebekah pahoi pumrhih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae a ko khuikah camoe rhoi te phop uh rhoi. Te dongah, “Balae tih hetla ka om mai,” a ti. Te dongah BOEIPA te dawt ham cet.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah BOEIPA loh anih taengah, “Nang bung khuiah namtu neh namtu om rhoi tih na ko lamkah namtu te panit la paek uh rhoi ni. Te vaengah namtu pakhat te namtu pakhat lakah te tlung vetih a ham loh a noe taengah thotat ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae a tue a tuemtuen vaengah a bung ah caphae la tarha a cun.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah aka thoeng lamhma te a pum boeih lingphung tih a mul khaw himbai bangla a om dongah anih ming te Esau a sui.
  </para>
  <para style="p">
    <verse number="26" style="v" />A hnukah a mana om tih a kut neh Esau kah khodil te a tuuk. Te dongah a ming te Jakob a sui. Amih rhoi a sak vaengah Isaak khaw kum sawmrhuk lo ca coeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae camoe rhoi te a pantai vaengah Esau te pongcet hlang, sakap thai la hlang coeng tih Jakob he dap ah duem aka om hlang la coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah Esau kah sakah te a ka dongah a tui pah dongah Isaak loh a lungnah dae Rebekah long tah Jakob a lungnah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Jakob loh andam a thong vaengah Esau buhmueh rhathih la pong lamkah ha pawk.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Esau loh Jakob la, “Kai he bumueh rhathih la ka om dongah tekah a thim a thim te kai n'cah mai,” a ti nah. Te dongah anih ming te Edom a sui.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae Jakob loh , “Tihnin ah nang kah caminghamsum te kai taengah han yoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah Esau loh , “Hekah caminghamsum khaw kai ham te balam nim. Kai duek ham ka cet coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae Jakob loh , “Tihnin ah kai ham toemngam laeh,” a ti nah vaengah a toemngam tih a caminghamsum te Jakob taengla a yoih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te daengah Jakob loh buh neh rhacik andam te Esau a paek. Tedae a caak a ok phoeiah thoo tih vik cet. Te dongah Esau loh caminghamsum te a sawtsit coeng.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham tue vaengkah aka om khokha lamhma bangla khohmuen ah khokha hlawt a om dongah Gerar kah Philisti manghai Abimelek taengla Isaak cet.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah anih taengah BOEIPA phoe tih, “Egypt la cet boeh. Nang taengah kan thui khohmuen ah rhaehrhong mai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hekah kho ah na bakuep cakhaw, 'Hekah khohmuen pum he nang neh nang kah tiingan taengah ka paek ni, ' tila na pa Abraham taengah ka toemngam sut olhlo te ka thoh ham coeng dongah nang taengah ka om vetih nang yoethen kan paek ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na tiingan khaw vaan aisi bangla ka pungtai sak vetih na tiingan taengah hekah khohmuen boeih ka paek vaengah nang kah tiingan rhang neh diklai namtom boeih a yoethen uh ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah ni Abraham loh ka ol a hnatun tih ka kueknah, ka olpaek, ka khosing neh ka olkhueng te a ngaithuen,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Isaak loh Gerar ah kho a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah te hmuen kah hlang loh a yuu kawng a dawt uh. Te vaengah, “Rebekah he a mueimae then tih anih kongah te hmuen kah hlang rhoek loh kai n'ngawn uh ve,” a ti. “Ka yuu ni,” ti ham a rhih tih, “Ka ngannu ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Teah te kum a sen a om phoeiah Philisti manghai Abimelek loh bangbuet lamkah a dan hatah Isaak loh a yuu Rebekah a law te lawt a hmuh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Abimelek loh Isaak te a khue tih, “Anih he na yuu taktak a? Tedae bahamlae, 'Anih he ka ngannu ni, ' na ti,” a ti nah. Te dongah Isaak loh , “Anih kongah ka duek ve,” ka ti dongah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah Abimelek loh , “Kaimih taengah balae na saii he? Pilnam khuikah pakhat loh na yuu taengah yalh koinih kaimih soah tholhnah nan pup hloe mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah Abimelek loh pilnam boeih te a uen tih, “Hekah hlang neh a yuu te aka ben tah duek rhoe duek saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Isaak loh khohmuen a tawn tih BOEIPA loh yoethen a paek dongah amah kum ah a pueh yakhat a dang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tekah hlang khaw pantai tih thoeih la thoeih coeng. Te dongah a khawk nah hil boeilen tih rhoeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah anih kah tuping boiva neh saelhung boiva khaw, imkhut khaw muep a khueh. Te dongah Philisti rhoek te anih taengah thatlai uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah a napa Abraham tue vaengah a napa kah sal rhoek loh a too uh tuito boeih te Philisti rhoek loh a toeng sak uh tih laipi neh a et pa uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Abimelek loh Isaak te, “Nang he kaimih lakah bahoeng na tahoeng dongah kaimih taeng lamloh nong laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Isaak loh te lamkah nong phoeiah Gerar soklong ah rhaeh tih pahoi kho a sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah a napa Abraham tue vaengah a too uh dae Abraham a duek phoeiah Philisti rhoek loh a toeng sak tuito tui te Isaak loh koep a too. Te dongah tuito ming te a napa kah ming sui phek la a sui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Isaak kah sal rhoek loh soklong ah a too uh hatah hingnah tui tuito te a hmuh uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Gerar kah boiva aka dawn rhoek neh Isaak kah boiva aka dawn rhoek toh uh thae tih, “Kaimih kah tui ni,” a ti uh. Te dongah amih neh a tukvat uh thae vanbangla Esek tuito tila a ming a sui.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah tuito a tloe a too uh hatah te dongah khaw toh uh thae bal tih a ming te Sitnah a sui.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te lamloh puen uh tih tuito a tloe a too vaengah toh uh thae voel pawh. Te dongah, “BOEIPA loh mamih ham hmuen han saelh tih khohmuen ah m'pungtai uh ni he,” a ti. Te phoeiah a ming te Rehoboth a sui.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah te lamloh Beersheba la cet.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae tekah hlaem ah anih taengla BOEIPA phoe tih, “Kai he na pa Abraham kah Pathen ni. Nang taengah ka om tih ka sal Abraham kong ah nang yoethen kan paek phoeiah na tiingan te ka ping sak ham dongah rhih boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah hmueihtuk pahoi a suem tih BOEIPA ming te a phoei. Te phoeiah amah kah dap khaw pahoi a tuk tih Isaak kah sal rhoek loh tuito pahoi a vueh uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah Gerar lamkah Abimelek neh amah kah baerhoep Ahuzzath khaw, amah kah caempuei mangpa Phikol te Isaak taengla halo uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah Isaak loh amih te, “Nangmih loh kai nan hmuhuet uh tih na taeng lamkah kai na haek uh phoeiah kai taengla balae nan loh uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah amih loh, “BOEIPA tah nang taengah om tila ka hmuh rhoe ka hmuh uh coeng. Te dongah kaimih laklo ah khaw, kaimih laklo neh nang laklo ah olcaeng om saeh lamtah nang taengah moi bop sih ka ti uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang te kam ben uh pawt tih nang taengah a then bueng ni ka saii uh. Te dongah nang khaw sading la kan tueih uh. BOEIPA loh yoethen m'paek vanbangla kaimih taengah a thae na saii pawt mako,” a ti uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah amih ham buhkoknah a saii tih a caak a ok uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah mincang ah thoo uh tih hlang khat neh khat te toemngam uh rhoi tih amih te a tueih phoeiah Isaak khaw ngaimong la voei.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae tekah khohnin ah Isaak kah sal rhoek halo uh tih a taengah a too uh tuito kongmai kawng te puen uh. Te vaengah a taengah, “Tui ka hmuh uh coeng, ” a ti nauh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah tekah hmuen te Sheba a sui dongah khopuei ming khaw tahae khohnin due Beersheba la om.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau khaw kum sawmli a lo ca vaengah a yuu te Khitti Beeri canu Judith neh Khitti Elon canu Basemath te a loh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah Isaak neh Rebekah taengah mueihla khahingnah om.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Isaak te a patong vaengah a mik hmang tih tueng pa pawh. Te vaengah a capa a ham Esau te a khue tih, “Ka capa,” a ti nah hatah a taengah, “Kai ni he,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah, “Ka patong coeng tih ka dueknah khohnin khaw ka ming moenih he.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah na hnopai, na liva neh na lii te lo laeh. Te phoeiah pong ah cet lamtah kai ham lampu sakah han yuep laeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah ka ngaih vanbangla kai ham antui saii lamtah ka taengla han khuen. Ka ca saeh lamtah ka hinglu loh ka duek hlan ah nang te yoethen kan pae eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isaak loh a capa Esau taengah a thui vaengah Rebekah loh a yaak. Te dongah Esau tah pong ah maeh loh ham saa yuep la cet.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah Rebekah loh a capa Jakob te a uen tih, “Na pa loh na maya Esau te a voek coeng ne.
  </para>
  <para style="p">
    <verse number="7" style="v" />'Sakah te kai taengah han khuen lamtah kai ham antui saii laeh. Te phoeiah ka ca saeh lamtah ka duek hlan ah BOEIPA hmuh ah nang yoethen kan pae eh,’ a ti nah te ka yaak coeng he.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah ka ca, kai loh nang kan uen bangla ka ol he ngai laeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Boiva taengla cet lamtah maae ca a then panit te kamah taengla han khuen laeh. Te phoeiah na pa ham a ngaih bangla antui ka saii eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah na pa taengla khuen lamtah ca saeh. Te nen te a duek hlan ah nang te yoethen m'pae saeh ,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Jakob loh a manu Rebekah taengah, “Ka maya Esau tah mulsui hlang tih kai tah sahnal hlang ni he.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pa loh kai te m'phatuem khaming, a mik ah laithae la ka om vetih kai soah rhunkhuennah thoeng koinih yoethennah moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae a manu loh anih taengah, “Ka capa nang sokah rhunkhuennah te kai soah tla saeh. Kai ol he duem ngai laeh. Te dongah cet lamtah kamah taengla hang khuen,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah cet tih a loh phoeiah a manu taengla a khuen. Te vaengah a manu loh a napa kah a ngaih bangla antui a saii pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Rebekah loh a capa a ham Esau kah himbai then te, im ah a loh tih a ca noe Jakob te a bai sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah maae ca kah a vin te a kut neh a rhawn kah a sahnal soah a dah pah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah antui neh buh a saii te a capa Jakob kut ah a doe.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah a napa taengla cet tih, “A pa,” a ti nah hatah, “Kai ni he, ka ca nang he unim?” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Jakob loh a napa taengah, “Kai he na caming Esau ni. Kai taengah nan thui bangla ka saii coeng. Thoo lamtah, ngol laeh. Ka sakah he ca lamtah na hinglu loh kai he yoethen paek saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Isaak loh a capa te, “Ka ca metlam lae hekah he koe na hmuh lah,” a ti nah. Te dongah, “Na Pathen BOEIPA loh kai ham a thoeng sak dongah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah Isaak loh Jakob te, “Bet ha thoeih lamtah ka ca nang te, ka ca Esau taktak neh taktak pawt a khaw kan yam lah eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Jakob loh a napa Isaak taengla thoeih tih a phatuem vaengah, “Ol tah Jakob ol dae a kut tah Esau kut,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae a kut te a maya Esau kut phek, mulsui la a om dongah anih te hmat pawt tih yoethen a paek.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah, “Nang he ka ca Esau taktak a?” a ti nah hatah, “Kai ni ue,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah, “Kai taengla han thoeih lamtah ka ca kah sakah te ka ca eh. Ka hinglu loh nang yoethen m'pae saeh,” a ti nah. Te phoeiah a taengla a thoeih pah. Te vaengah a caak phoeiah misurtui khaw a khuen pah tih a ok.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah a napa Isaak loh anih te, “Ka ca bet ha thoeih lamtah kai m'mok,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah thoeih tih a mok. Te vaengah a himbai bo te a him pah tih yoethen a paek. Te phoeiah, “So lah, ka capa bo he, BOEIPA loh yoethen a paek khohmuen bo bangla om.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah Pathen loh nang taengah vaan lamkah buemtui khaw, diklai khuehtawn khaw, cangpai cungkuem neh misur thai khaw m'pae saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pilnam rhoek loh nang taengah thotat uh saeh lamtah, namtu loh nang taengah bakuep khaw bakuep saeh. Na pacaboeina rhoek taengah boei la om lamtah na manu ca rhoek loh nang taengah bakop uh saeh. Nang thae aka phoei thil tah thaephoei thil saeh. Nang yoethen aka pae te yoethen pae saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae Isaak loh Jakob yoethen a paek te a khah van neh Jakob tah a napa Isaak mikhmuh lamloh nong tih vawl cet. Te phoeiah a maya Esau te a sakah nah lamkah tloep pai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih long khaw antui a saii van tih a napa taengla a khuen. Te phoeiah a napa te, “A pa thoo lamtah na capa kah sakah he ca laeh. Na hinglu loh kai yoethen m'pae saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae anih te a napa Isaak loh , “Nang ulae?” a ti nah hatah, “Kai, na capa na caming Esau ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah Isaak tah thuennah neh a nah la mat lakueng tih, “Saa a yuep phoeiah kai taengla aka khuen te ulae? Na lo hlan ah boeih ka caak tih anih te yoethen ka paek dongah a yoethen ngawn coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau loh a napa kah olka te a yaak tih a len la pangngawlnah neh hluthlut mat pang. A napa taengah, “A pa, kai khaw yoethen m'pae,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae, “Na mana te thailatnah neh halo tih nang kah yoethennah a loh coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah Esau loh, “A ming khaw Jakob la a khue pai. Te dongah ni a. pabae la kai n'rhim tih kai kah caminghamsum te a loh. Te phoeiah kai kah yoethennah a loh coeng he,” a ti. Te phoeiah, “Kai ham tah yoethennah na paih pawt nim?,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae Isaak loh Esau te a doo tih, “Anih te nang soah boei la ka khueh coeng ne. Te dongah a pacaboeina boeih te a taengah sal la ka paek. Te phoeiah cangpai neh misur thai khaw anih ka pang sak coeng. Te dongah ka ca nang ham balae ka saii bal eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae Esau loh a napa taengah, “a pa na taengkah yoethennah te pakhat khaw ta? Kai khaw yoethen m'pae van saw a pa,” a ti nah. Te vaengah Esau loh a ol te a huel tih rhap.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah a napa Isaak loh anih te a doo tih, “Diklai kah khuehtawn neh vaan dong sosang lamkah buemtui loh namah tolrhum ah om bitni ne.
  </para>
  <para style="p">
    <verse number="40" style="v" />Na cunghang neh na hing vetih na mana taengah na thotat ni. Tedae na van van neh na rhawn dongkah a hnamkun te na bawt bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tedae a napa kah yoethennah te anih te yoethen a paek dongah Esau loh Jakob taengah a konaeh. Te dongah Esau loh a lungbuei khuiah,” A pa kah nguekcoinah tue yoei, ka mana Jakob te ka ngawn ni,” a ti.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tedae a capa a ham Esau kah olka te Rebekah taengah a puen pah. Te dongah a capa a noe Jakob te a tah tih a khue sak. Te phoeiah amah taengah, “Na maya Esau loh nang ngawn daengah ni. nang ham dam a ti eh ne.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah ka ca, kai ol he ngai laeh. Thoo lamtah Haran ah ka nganpa Laban taengla namah yong laeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na maya kah kosi a mael hil hnin at khaw anih taengla khosa mai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na maya loh nang taengkah thintoek te mael tih anih taengah na saii te a hnilh phoeiah kan tah vetih te lamkah nang kan loh bitni. Balae tih nangmih rhoi khaw hnin at ah kan hlong eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te dongah Rebekah loh Isaak taengah, “Kheth nu mikhmuh ah ka hingnah loh a mueipuel. Amih Kheth nu bang tolrhum kah huta te Jakob loh a yuu la lo koinih kai kah hingnah he metlam a om eh?,” a ti nah.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah Isaak loh Jakob te a khue phoeiah yoethen a paek tih a uen vaengah, “Kanaan nu te na yuu la lo boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thoo, Padanaram kah na nu kah a napa Bethuel im la cet lamtah na nupu Laban canu te na yuu la lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathen Tlungthang loh nang te yoethen m'paek vetih na pungtai uh phoeiah na ping uh vaengah pilnam hlangping la na om bitni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Pathen loh Abraham taengah a paek tangtae Abraham kah yoethennah, na lampahnah kho he nang neh na tiingan loh na pang ham m'pae saeh” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Isaak loh Jakob te a tueih tih Jakob neh Esau kah a manu Rebekah kah nganpa Laban, Paddanaram Arammi Bethuel capa taengla cet.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Isaak loh Jakob yoethen a paek tih a yuu aka lo ham Paddanaram la a tueih te khaw, Jakob te yoethen a paek vaengah Kanaan nu te na yuu la lo boeh a ti nah tih a uen te khaw Esau loh a hmuh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob long khaw a napa neh a manu ol a ngai tih Paddanaram la cet.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau long khaw a napa Isaak kah mik ah Kanaan nu te thae tila a hmuh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Esau loh Ishmael taengla cet tih a yuu rhoek hmanah Abraham capa Ishmael canu Mahalath, Nebaioth ngannu te a yuu la a loh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Jakob loh Beersheba lamloh cet tih Haran la pawk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae hmuen pakhat te a pha vaengah khomik vik tla tih pahoi rhaeh. Te vaengah te hmuen kah lungto a loh tih a lu a tloeng. Te phoeiah tekah hmuen ah yalh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah mang a man hatah diklai ah kuihlak tarha doh uh tih a soi loh vaan duela a pha. A soah Pathen kah puencawn rhoek te tarha luei uh tih suntla uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah anih taengah BOEIPA te lawt pai tih, “Kai na pa Abraham kah BOEIPA Pathen neh Isaak kah Pathen loh na yalh nah diklai he nang neh nang kah tiingan taengah kan paek ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang kah tiingan tah diklai laipi bangla om vetih khothoeng tuitunli neh tuithim tlangpuei la na pungtai uh phoeiah nang neh nang tiingan rhang neh diklai huiko boeih loh a yoethen uh ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai he nang taengah ka om tih na caeh nah boeih ah nang kan ngaithuen. Te dongah nang te he khohmuen la kam mael puei bitni. Nang taengah ka thui te ka saii hlan vaengah nang kan hnoo mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Jakob loh a ih lamkah a haenghang vaengah, “Hekah hmuen ah BOEIPA loh rhep om dae kai loh ka ming pawh “a ti.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae a rhih tih, “Hekah hmuen he rhih ham om tih Pathen kah im neh vaan vongka pawt atah a tloe moenih he “a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob loh mincang a thoh vaengah a lu kah a khueh lungto te a loh tih kaam a ling phoeiah a so ah situi a bueih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah tekah khopuei ming te lamhma ah Luz la om dae hatah tekah hmuen ming te Bethel la a khue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah Jakob loh olcaeng neh a caeng tih, “Pathen loh kai taengah om tih he longpuei ah ka caeh vanbangla, kai n'dawndah phoeiah caak ham buh neh bai ham himbai te kai m'paek bal tih,
  </para>
  <para style="p">
    <verse number="21" style="v" />a pa im ah sading la ka bal atah BOEIPA te kai kah Pathen la om ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah hekah lungto kaam la ka ling he Pathen kah im la poeh vetih kai nan paek boeih te namah ham parha pakhat la kan paek ni,” a ti.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Jakob loh a kho a kan tih khothoeng ca rhoek kah khohmuen la cet.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah a sawt hatah lohma kah tuito khaw, tekah tuito lamkah tui te tuping a tul dongah tuping loh a kaep ah pathum la a kol uh khaw, tuito kah a rhai kah lungrhang te khaw lawt a hmuh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te la tuping boeih a tingtun vaengah tuito rhai kah lungto te a paluet uh tih boiva te a tul uh. Te phoeiah lungto te tuito kah a rhai ah amah hmuen la a khueh uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Jakob loh amih te, “Ka manuca rhoek nangmih he me lamkah rhoek lae,” a ti nah hatah, “Kaimih he Haran lamkah ni,” a ti uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah amih te, “Nakhaw capa Laban te na ming uh a? a ti nah hatah, “Ka ming uh ta,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Jakob loh amih taengah, “Anih te a sading ngawn a? a ti nah hatah, “A sading tih a canu Rakhel khaw boiva neh halo ke,” a ti na uh .
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah, “Kho muep om pueng ta he, boiva a tingtun tue moenih. Boiva te tuitul, te phoeiah hlah lamtah luem sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae amih loh, “Tuping rhoek boeih tingtun tih tuito rhai lamkah lungto te ka paluet uh daengah ni boiva khaw tui ka tuluh. Ka paluet thai uh pawt atah ka tul uh thai pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amih te a voek li vaengah Rakhel loh a napa kah tu dawn ham tu neh ha puei uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae Jakob loh a nupu Laban canu Rakhel te khaw, a nupu Laban kah boiva te khaw a hmuh vanbangla Jakob te thoeih tih tuito rhai lamkah lungto te a paluet. Te phoeiah a nupu Laban kah boiva te tui a tul pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah Jakob loh Rakhel te a mok dae a ol a huel tih rhap.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae Jakob loh Rakhel taengah amah te a napa kah huiko neh Rebekah capa ni tila a puen dongah Rakhel te yong tih a napa taengah puen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Laban long khaw a ngannu capa Jakob kah olthang te a yaak van neh anih doe ham yong tih a kop phoeiah a mok tih amah im la a khuen vaengah hekah olka boeih te Laban taengah a tae pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Laban loh Jakob taengah, “Nang tah kamah rhuh neh saa pai ni,” a ti nah. Tedae anih taengah a khohnin hla la puet kho a sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah Laban loh Jakob taengah, “Nang he kamah huiko la na om dongah a hoeihae lam a kai taengah na thohtat eh? Kai taengah na thapang te thui,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengkah Laban canu rhoi tah, a ham ming te Leah tih, a noe ming te Rakhel la om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Leah kah a mik te mongkawt dae Rakhel tah a suisak sakthen neh mueimae sakthen la om.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae Jakob loh Rakhel te a lungnah dongah, “Na canu a noe Rakhel ham nang taengah kum rhih ka tho ka tat ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah Laban loh , “Hlang tloe te ka paek lakah nang taengah anih kan paek te then ngai tih kamah taengah khosa mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Jakob loh Rakhel ham kum rhih thotat dae anih te a lungnah dongah a mik ah hnin at bangla om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Jakob loh Laban te, “Ka khohnin khaw cup coeng tih ka yuu te m'pae lamtah anih taengah ka yalh pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Laban loh te hmuen kah hlang boeih te a coi tih buhkoknah a saii.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae hlaem a pha vaengah tah a canu Leah te a khuen tih a paek dongah anih taengah Jakob yalh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Laban loh a canu Leah taengah amah kah taengom Zilpah te taengom la a paek.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae mincang ah tah Leah te tarha a om pah. Te dongah Laban te, “Kai taengah balae na saii he? Rakhel ham nang taengah ka thoh ka tat moenih a? Tedae balae tih kai nan phok,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah Laban loh , “Kaimih kho ah caming hlanah a noe a paek ham te a saii noek moenih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahae yalh he a boeih phoeiah kai ham kum rhih koep na thohtat atah tekah thohtatnah yuengla anih te nang taengah kan paek bal ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah Jakob loh a saii van tih tekah yalh a boeih phoeiah a canu Rakhel te anih yuu la amah taengah a paek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah Laban loh a canu Rakhel taengah amah kah taengom Bilhah te taengom la a paek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah Rakhel taengah a yalh bal hatah Rakhel te Leah lakah a lungnah ngai dongah anih ham kum rhih koep thotat.
  </para>
  <para style="p">
    <verse number="31" style="v" />Leah te a hnoel te BOEIPA loh a hmuh dongah a bung tah a ong. Tedae Rakhel te a yaa sak.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah Leah te pumrhih tih capa a cun hatah, “BOEIPA loh kai kah phacipphabaem te a hmuh tih ka va loh kai n'lungnah taktak pawn ni,” a ti. Te dongah a ming te Reuben a sui.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah koep pumrhih tih capa a cun hatah, “Kai n'hnoel te BOEIPA loh a yaak dongah he khaw kai m'paek,” a ti. Te dongah anih ming te Simeon a sui.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te phoeiah koep pumrhih tih capa a cun hatah, “Anih ham capa voei thum ka cun pah dongah ka va loh kai taengah naep pawn ni,” a ti. Te dongah anih ming te Levi a sui.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah koep pumrhih tih capa a cun hatah, “BOEIPA te voei vai khaw ka uem eh?,” a ti. Te dongah anih ming te Judah a sui. Te phoeiah a ca cun te duem.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Rakhel loh Jakob ham ca cun pawh tila a hmuh vaengah Rakhel te a maya taengah thatlai. Te dongah Jakob la, “Kai he capa m'pae lah, te pawt koinih ka duek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Jakob kah a thintoek te Rakhel taengah sai tih, “Kai he nang bung kah a thaih aka hloh Pathen yueng la ka om a?,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae, “Ka taengom Bilhah taengah kun mai saw he. Te daengah ni ka khuklu ah ca han sak vetih anih lamloh kai khaw ka thoh eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah a taengom Bilhah te a yuu la a paek tih Jakob loh anih taengah ip.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bilhah khaw pumrhih tih Jakob ham ca a cun pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah Rakhel loh , “Pathen loh kai n'yan cakhaw ka ol te a yaak bal tih kai he ca tongpa m'paek coeng,” a ti. Te dongah anih ming te Dan a sui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah koep pumrhih tih Rakhel kah taengom Bilhah loh Jakob ham capa pabae te a cun pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Rakhel loh , “Pathen kah rhaknah dongah ka maya te ka hnueih tih ka na coeng,” a ti. Te dongah anih ming te Naphtali a sui.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae Leah loh ca cun ham bawt coeng tila a hmuh dongah a taengom Zilpah te a khuen tih Jakob taengah a yuu la a paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah Leah kah taengom Zilpah loh Jakob ham capa a cun pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Leah loh , “Yoekam loh a loh,” a ti dongah anih ming te Gad a sui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Leah kah taengom Zilpah loh Jakob ham capa pabae a cun pah hatah,
  </para>
  <para style="p">
    <verse number="13" style="v" />Leah loh , “Kai bahoeng ka omngaih, te dongah tanu rhoek loh kai he n'uem uh ni,” a ti tih anih ming te Asher a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cang ah tue vaengah Reuben te a caeh hantah lohma ah hloih a hmuh tih a manu Leah taengla a khuen. Te vaengah Rakhel loh Leah taengah, “Na capa kah hloih te kai hamla khueh mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae Leah loh anih la, “Ka va te nan rhawt tih rhoeh dae ka ca kah hloih te khaw na lo a ya? a ti nah hatah Rakhel loh , “Then, na capa kah hloih yueng la khoyin ah nang taengla yalh saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah pong lamkah Jakob halo hlaem ah anih aka doe la Leah te cet tih, “Ka capa kah hloih neh nang a paang la kan paang coeng dongah kai taengah na ip ni,” a ti nah. Te dongah tekah khoyin ah anih taengla yalh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Pathen loh Leah te a yaak dongah pumrhih tih Jakob ham a panga nah capa a cun pah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah Leah loh , “Ka va taengah kamah taengom ka paek dongah kai khaw Pathen loh thapang m'paek,” a ti tih anih ming te Issakhar a sui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah Leah te koep pumrhih tih Jakob ham parhuk nah capa a cun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Leah loh , “Pathen loh kai he kutdoe then koep m'paek tih anih ham capa parhuk ka cun pah. Te dongah ka va loh kai n'hmaiben pawn ni,” a ti tih a ming te Zebulun a sui.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah a hnuk la canu a cun tih a ming te Dinah a sui.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Pathen loh Rakhel te a poek. Te dongah Pathen loh anih ol te a hnatun tih a bung te a ong pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah pumrhih tih capa a cun hatah, “Kai kah kokhahnah he Pathen loh a coi sak,” a ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />“BOEIPA loh kai ham capa a tloe han thap saeh,” a ti tih anih ming te Joseph a sui.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Rakhel loh Joseph a sak phoeiah tah Jakob loh Laban taengah, “Kai he kamah hmuen la, kamah khohmuen ah pongpa ham n'tueih laeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka yuu rhoek neh ka ca rhoek te m'pae. Amih ham nang taengah ka thotat tih ka thohtatnah khaw nang ham ni ka thohtat tila na ming coeng dongah ka cet pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae anih te Laban loh , “Nang kong ah BOEIPA loh ka yoe han then sak tila ka hmuhming. Nang mikhmuh ah mikdaithen la ka om atah bet om mai dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah, “Kai taengkah na thapang te mingpha sak lamtah kan paek bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Jakob loh Laban te, “Nang taengah ka thohtat te khaw, na boiva loh kai taengah a om te khaw na ming.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka mikhmuh ah nang kah a yol ni a om dae a cungkuem te pungtai coeng. Te dongah BOEIPA loh nang te ka kho kung ah yoethen m'paek. Tedae me vaengah lae kai loh ka imkhui ham khaw ka saii coeng? ,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah, “Nang te balae kan paek eh?,” a ti nah. Jakob loh , “Kai he pakhat khaw m'pae boeh, he ol he kai hamla nan khueh atah, ka mael neh na boiva te ka luem puei vetih ka dawn mai bitni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tihnin ah nang kah boiva boeih taengla ka cet eh. Te lamkah tu boeih te rhikrhak neh a tairhi khaw, tuca khuikah tu pol boeih khaw, maae khuiah a tairhi neh rhikrhak khaw ka khoe saeh lamtah ka thapang la om saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na mikhmuh ah maae khui lamkah a rhikrhak neh a tairhi pawt boeih, tu khui lamkah a pol pawt te ka taengla a huen khaw, thangvuen khohnin kah ka thapang dongah na pai vaengah, kai yueng la ka duengnah thui nawn saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah Laban loh , “Namah olka bangla a om saeh ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah amah khohnin ah maaetal a rhangcam neh a tairhi te khaw, maae nu rhikrhak neh a tairhi boeih te khaw, a soah aka bok boeih neh tuca khuikah aka pol boeih te a khoe tih a capa kut ah a tloeng pah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah hnin thum longcaeh te amah neh Jakob laklo ah hnalak a khueh. Te daengah Jakob loh Laban kah boiva la aka sueng rhoek te a luem sak.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae Jakob loh amah ham khabok neh yungkha neh hlimbok kah a hlaeng te thingsup la a loh. Te phoeiah a dakda aka bok te a hlih tih cungkui dongah a bok la a tai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te phoeiah thing hlaeng a baeh te tuilong ah khaw, tuisoi tui taengah khaw, tui ok hamla boiva a kun nah ah khaw, boiva hmai ah khaw a khueh pah. Te dongah tui o la a caeh uh vaengah a pacu uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Boiva te cungkui taengah a pacu tih boiva khaw a rhangcam, rhikrhak la thang tih a tairhi pah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah Jakob loh tuca rhoek te a hoep tih Laban kah boiva khuikah a rhangcam neh aka pol boeih taengla boiva kah a hmai a khueh. Te phoeiah amah loh amah kah tuping te amah la hloep a khueh. Tedae te rhoek te Laban kah boiva taengah khueh pawh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah om tih boiva loh a pa a cuk takuem vaengah a tanglue te tah cungkui taengah a pa a cuk sak ham Jakob loh cungkui te tuilong kah boiva hmuh ah a khueh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tedae boiva te a rhae ngai atah a khueh pah pawt dongah a rhae rhoek te Laban ham om tih a tanglue te Jakob ham vik om.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah tekah hlang tah lut lut boei tih anih taengah boiva khaw, taengom neh sal khaw, kalauk neh laak khaw muep om.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Laban ca rhoek kah olka la, “Jakob loh a pa koe te boeih a loh dongah hekah thangpomnah boeih he khaw a pa koe ni hlawp a bawn,” a ti uh te a yaak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Laban kah maelhmai te Jakob loh a hmuh vaengah hlaem hlaemvai kah bangla anih taengah om pawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae BOEIPA loh Jakob te, “Na pa rhoek kah khohmuen neh na pacaboeina taengla bal ngawn lamtah nang taengah ka om bit ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Jakob loh Rakhel neh Leah te a tah tih kohong kah a boiva te a khue.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah amih te, “Na pa maelhmai te ka hmuh vaengah, hlaem hlaemvai vaengkah bangla kai taengah anih om pawt cakhaw a pa kah Pathen loh kai taengah om.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahae ah ka thadueng boeih neh na pa taengah ka thohtat te na ming uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na pa khaw kai taengah omsaa tih ka thapang te voei rha la a hoilae. Tedae kai he thae sak ham tah Pathen loh anih a paek moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rhikrhak te nang kah thapang la om saeh a ti van hatah boiva te khaw rhikrhak la boeih thang tih a rhangcam te nang kah thapang la om saeh a ti van hatah boiva te a rhangcam la boeih thang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae na pa kah boiva te Pathen long ni a lat tih kai taengah m'paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Boiva te a pa a cuk tue a pha coeng tih ka mik te ka huel. Mueimang ah ka hmuh tih kikong loh a caeh thil boiva tah rhangcam, rhikrhak neh dikdek la om he.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah Pathen kah puencawn loh kai te ka mang ah, 'Jakob,” a ti tih, “Kai ni he,” ka ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah, “Na mik huel lamtah tahae kah boiva a rhangcam, rhikrhak neh dikdek taengah aka cu kikong rhoek boeih ke so lah. Laban loh nang taengah a saii boeih te ka hmuh coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai tah kaam te na koelh tih kai taengah olcaeng neh na caeng vaengkah te Bethel Pathen ni. Hekah khohmuen lamloh thoo laeh, cet lamtah na pacaboeina kah khohmuen la mael laeh,’ a ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Rakhel neh Leah loh a doo vaengah, “A pa im kah hamsum neh rho te mamih ham om voel a?
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loh kholong hlang la m'poek uh dongah mamih he n'yoih phoeiah mamih kah tangka te a caak khaw a caak moenih a?
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmantang ah Pathen loh a pa taengkah a lat khuehtawn boeih te mah koe neh n'ca rhoek kah ni. Te dongah Pathen loh nang taengah a thui boeih te tah saii laeh,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Jakob loh thoo tih a ca rhoek neh a yuu rhoek te kalauk rhoek dongla a ngol sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah a napa Isaak kah khohmuen Kanaan la caeh ham a boiva neh a kawn a dang boeih te khaw, Paddanaram ah a dang amah kah hnopai, boiva te khaw baat a thawn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Laban loh amah kah tu te a mul vok pah ham a caeh vaengah Rakhel loh a napa kah sithui te a huen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih a yong te a puen mueh la Jakob loh Arammi Laban kah lungbuei te a namnah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih a yong dongah a taengkah boeih te khaw a thoh puei tih, tuiva a poeng phoeikah Gilead tlang dan la a hooi puei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Jakob a yong te a hnin thum daengah Laban taengah a puen pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Laban loh amah manuca rhoek te a khuen tih hnin rhih longcaeh due anih hnuk te a hloem phoeiah Jakob te Gilead tlang ah a tuuk.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae Arammi hoel Laban te Khoyin a mang ah Pathen loh a paan tih, “Namah te ngaithuen, Jakob taengah a then khaw a thae la na thui ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Laban loh Jakob a tuuk vaengah Jakob loh amah kah dap te tlang ah a tuk coeng dongah Laban neh a manuca rhoek long khaw Gilead tlang ah rhaeh uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah Laban loh Jakob la, “Balae na saii he. Ka thinko he na liim tih ka tanu rhoek te cunghang kah a sol bangla na hmaithawn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yong ham te balae tih na phah, kai taengah na puen mueh la kai nan liim. Nang te kohoenah neh, laa neh, kamrhing neh, rhotoeng nen khaw kan tueih van mako.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka ca rhoek so neh ka canu rhoek soah te mok ham kai nan paek pawt khaw na pavai coeng tih ni na saii.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangmih te a thae la saii ham ka thaa om ngawn dae hlaem yin ah na pa kah Pathen loh kai m'voek tih, 'Jakob te a thae neh a then khaw thui te namah ngaithuen,’ a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae na pa im te ngaidam la na ngaidam coeng dongah na cet khaw na cet mai ni. Balae tih kai kah pathen na huen,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae Jakob loh a doo tih Laban te, “Na canu rhoek he kai taeng lamloh na doek ve ka ti tih ka rhih dongah ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />A taengah na khohni na hmuh te tah kaimih kah pacaboeina hmaiah hing boel saeh. Kai taengkah he namah loh hmat lamtah namah kah atah lo,” a ti nah. Tedae Rakhel loh a huen te Jakob loh ming pawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah Laban loh Jakob kah dap khaw, Leah kah dap neh taengom rhoi kah dap khuila cet dae a hmuh pawt dongah Leah kah dap lamkah halo tih Rakhel kah dap khuila kun.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae Rakhel loh sithui te a loh tih kalauk kah ngoldoelh khuiah a khueh tih a ngol thil dongah dap te Laban loh boeih a phatuem dae hmu pawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah Rakhel loh a napa taengah, “Ka boeipa mik ah sai boel mai. Kai taengah huta kah khosing om tih nang hmuh ah thoh ham ka coeng moenih,” a ti nah. Te dongah a sat akhaw sithui te hmu pawh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae Jakob te sai tih Laban te a ho. Te vaengah Jakob loh Laban te a doo tih, “Kai kah mebang dumlai neh mebang tholhnah dongah lae kai hnukah nan hlak.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tahae ah kai kah hnopai boeih te na phatuem tih na im kah hnopai khat khaw na hmuh te kai kah pacaboeina neh nang kah paca boeina hmuh ah n'rha phoeiah man mamih rhoi laklo ah n'tluung uh rhoi sue.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kum kul khuiah he nang taengah ka om coeng dae na tumanu neh na maae rhoek loh thangyah vai pawt tih na boiva khuikah a tal rhoek khaw ka ca vai pawh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Saha te na taengla kan khuen pawh. Khoyin loh a huen khaw, khothaih loh a huen khaw nan suk dongah kai loh kamah kut lamkah neh ka kawn.
  </para>
  <para style="p">
    <verse number="40" style="v" />Khothaih ah kholing loh n'do tih khoyin ah rhaelnu loh m'boh phoeiah ka mik loh ih ham a hlavawt tih ka om.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tahae ah kai loh nang im ah kum kul ka om khuiah na canu rhoi ham kum hlai li neh na boiva ham kum rhuk te nang taengah ka tho ka tat dae ka thapang te voei rha la na hoi na lae.
  </para>
  <para style="p">
    <verse number="42" style="v" />A pa kah Pathen, Abraham kah Pathen neh Isaak kah birhihnah te kai taengah om pawt koinih kuttling la kai nan tueih tarha mai veh. Kai kah phacip phabaem neh ka kut kah a thatloh te Pathen loh a hmuh dongah ni hlaem yin ah a tluung,” a ti nah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Laban long khaw Jakob te a doo vaengah, “Huta rhoek te kai canu rhoek tih tongpa rhoek te khaw kai ca rhoek ni. Boiva te khaw kai kah boiva tih namah loh na hmuh boeih te kai koe ni. Tedae tihnin ah ka canu rhoek, amih ham neh amih loh a sak camoe rhoek ham balae ka saii thai voel.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te dongah halo laeh! Kai neh nang paipi sai sih lamtah kai laklo nang laklo ah laipai la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te dongah Jakob loh lungto a rhuh tih kaam la a ling.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te phoeiah Jakob loh amah kah paca boeina rhoek la, “Lungto rhut uh,” a ti nah. Lungto te a rhuh uh tih lungkuk la a saii uh phoeiah tah lungkuk taengah buh pahoi a caak uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Te dongah tekah lungkuk te Laban loh Jegarsahdutha a sui tih Jakob loh Galeed la a khue.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te phoeiah Laban loh , “Tihnin ah hekah lungkuk loh kai laklo neh nang laklo ah laipai la om coeng,” a ti dongah a ming te Galeed a sui.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te phoeiah, “Hlang hui taeng lamloh n'thuh vaengah kai laklo neh nang laklo ah BOEIPA loh n'tawt saeh,” a ti dongah Mizpah a sui.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ka ca huta rhoek te khoem na phaep tih ka ca rhoek hmanah yuu na loh atah mamih taengah hlang om pawt dae kai neh nang laklo kah laipai tah Pathen ni tila hmu sih.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te phoeiah Laban loh Jakob te, “Lungkuk he khaw kaam he khaw ne, te ni kai laklo neh nang laklo ah kan thuinuet.
  </para>
  <para style="p">
    <verse number="52" style="v" />Boethae ham khaw hekah lungkuk neh kaam he tah kai loh nang taengla hekah lungkuk kan poeng pawt ham neh nang khaw kai taengla na poe pawt ham hekah lungkuk neh kaam he laipai la om saeh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham kah Pathen neh Nakhaw kah Pathen, a napa kah Pathen loh mamih laklo ah laitloek uh saeh,” a ti nah. Te phoeiah Jakob loh a napa Isaak kah birhihnah neh a toemngam.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te dongah Jakob loh tlang ah hmueih a nawn phoeiah buh ca la amah huiko te a khue. Buh a caak uh phoeiah tlang ah rhaeh uh.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Jakob loh amah longpuei ah a caeh hatah anih te Pathen kah puencawn rhoek a doe uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae Jakob loh amih te a hmuh vaengah, “Hekah he Pathen kah rhaehhmuen ni,” a ti tih tekah hmuen ming te Mahanaim a sui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Jakob loh Edom kho, Seir khohmuen la a maya Esau taengah a hmai la puencawn rhoek te a tueih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah amih te a uen tih, “Ka boei Esau taengah he he thui pah. Na sal Jakob tah Laban taengah ka bakuep tih tahae duela ka uelh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah kai taengah vaito neh laak boiva khaw, sal neh salnu khaw om. Na mikhmuh ah mikdaithen dang hamla ka boeipa taengah aka puen la kai n'tueih,’ ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae puencawn rhoek te Jakob taengla mael uh tih, “Na maya Esau taengla ka cet uh coeng, te nang te doe ham a taengkah hlang ya li neh halo coeng,” a ti na uh .
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah Jakob loh bahoeng a rhih tih amah te a te daengdaeh uh. Te dongah a taengkah pilnam te khaw, boiva khaw, saelhung khaw, kalauk rhoek khaw rhoi nit la a tael.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te khaw Esau loh rhoi at te a paan tih a ngawn atah rhoi at aka om te khaw rhalyong la om saeh a ti dongah ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Jakob loh , “Kai taengah namah khohmuen neh na pacaboeina taengla bal lamtah nang te kan hoeikhang sak ni,” aka ti a pa Abraham kah Pathen neh a pa Isaak kah BOEIPA Pathen,
  </para>
  <para style="p">
    <verse number="10" style="v" />Sitlohnah cungkuem neh uepomnah cungkuem te na salpa taengah nan saii ham tah rhaidaeng. Ka cunghol neh Jordan he ka kat ngawn dae rhoi nit la ka lo coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka maya kut lamloh, Esau kut lamkah kai n'huul mai dae. Anih te ka rhih, halo vetih camoe rhoek neh a manu rhoek khaw, kamah khaw n'ngawn ve.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae namah loh , 'Hoeikhang ham khaw nang te kan hoeikhang sak vetih nang kah tiingan te tuitunli kah laivin bangla ka khueh vetih tae thai mahpawh,’ na ti,” tila thangthui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah teah te khoyin puet rhaeh. A kut ah a khuen te khaw a maya Esau ham khosaa la,
  </para>
  <para style="p">
    <verse number="14" style="v" />Maae a la yahnih neh maaetal pumkul, tumanu yahnih neh tutal pumkul.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kalauk cacun te a ca rhoek hmaihneh thumkip, vaito a la likip neh vaitotal pumrha, laak a la pumkul neh laaktal pumrha,” a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah tuping, tuping te amah loh a sal rhoek kut ah a tloeng tih a sal rhoek te,” Kai hmai ah cet lamtah tuping laklo neh tuping laklo te hnalak khueh uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah lamhma taengah, “Ka maya Esau te na hum uh tih, 'Nang ulae? Melam na caeh eh? Na hmaikah rhoek he u kah lae a ti tih n'dawt vaengah,
  </para>
  <para style="p">
    <verse number="18" style="v" />'Na sal Jakob kah ni. Hekah he ka boeipa Esau taengah khosaa la ham pat tih amah khaw kaimih hnukkah halo ke,’ ti nah,” a ti tih a uen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah a pabae te khaw, a pathum te khaw, tuping hnukah aka cet boeih te khaw, “Nangmih khaw Esau neh na hum uh vaengah hekah olka he thikat la thui uh lamtah,
  </para>
  <para style="p">
    <verse number="20" style="v" />nang kah sal Jakob khaw kaimih hnukah om ke,’ na ti uh ni,” a ti tih a uen. Ba dongah tikoinih ka mikhmuh kah aka pongpa khosaa neh a hmai ka saak pah vetih, te phoeiah tah a maelhmai ka hmuh vaengah kai maelhmai khaw a hlam khaming a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah khosaa te a hmai la a caeh sak. Tedae amah tah rhaehhmuen ah hlaem at rhaeh pueng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae tekah khoyin ah thoo tih a yuu rhoi neh a salnu rhoi khaw, a ca rhoek hlai at te khaw a loh tih Jabbok lamkai ah a kat puei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amih te khaw a khuen tih a thak phoeiah amah taengah aka om rhoek te khaw soklong la a tueih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah Jakob te amah bueng la a cul coeng dongah anih te hlang pakhat loh khothaih tom due a hnueih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae anih te ka na pawh tila a hmuh vaengah Jakob kah a hlit te a koi pah tih anih te a hnueih pangthuem Jakob kah a hlit te voeng nong.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah, “Khothaih loh n'kae coeng tih kai n'hlah laeh,” a ti nah hatah Jakob loh, “Kai he yoethen nan paek hlan atah nang khaw kan hlah mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah amah la, “Nang ming te balae,” a ti nah hatah, “Jakob,” a ti nah dae,
  </para>
  <para style="p">
    <verse number="28" style="v" />“Na ming te Jakob ti voel boel lamtah Pathen neh hlang rhoek te na hnueih tih na na coeng dongah Israel ti laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah Jakob loh a dawt tih, “Na ming te thui lah,” a ti nah hatah, “Ka ming he ba ham lae nan dawt,” a ti nah tih anih te yoethen pahoi a paek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Jakob loh , “Pathen maelhmai te a hmai lamloh hmuh coeng dae ka hinglu huul uh,” a ti dongah tekah hmuen ming te Peniel a sui.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae Penuel te a poeng vanneh a soah khomik thoeng. Anih khaw a hlit dongah cungdo phai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah Israel ca rhoek loh a hlit dongkah tharhui thanal te tihnin due ca uh pawh. Jakob kah tharhui thanal ah aka om a hlit te a koi pah coeng.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah Jakob loh a mik huel tih a sawt hatah Esau neh a taengkah hlang ya li te tarha a pawk pah. Te dongah camoe rhoek te Leah taengah khaw, Rakhel taengah khaw, a imom rhoi taengah a rhek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah salnu rhoek neh amih kah a ca rhoek a lamhma sak tih Leah neh a rhoek loh a hmaithawn. Rakhel neh Joseph te lamhnuk la a khueh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah amah te amih hmai la cet tih a maya taeng a pha due diklai la voei rhih bakop.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae anih te doe ham Esau yong tih a rhawn ah a kop uh rhoi, mok uh rhoi tih rhap rhoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah a dan hatah huta rhoek neh camoe rhoek te a hmuh tih, “Nang taengkah rhoek he u rhoek lae?” a ti nah dae, “Pathen loh na sal taengah n'rhen nah camoe rhoek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah a salnu rhoek neh a ca rhoek te thoeih uh tih bakop uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Leah neh a ca rhoek khaw thoeih uh tih a bakop uh vaengah Joseph neh Rakhel khaw thoeih tih bakop rhoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Esau loh, “Lambong boeih ka hum he, metlam na om te,” a ti nah. Te dongah, “Ka boeipa mik ah mikdaithen dang ham ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae Esau loh , “Ka mana, kamah taengah muep om ta; namah taengkah te namah ham om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob loh , “Pawh, na mikhmuh ah mikdaithen la ka tueng mai khaming. Na maelhmai he Pathen maelhmai a hmuh bangla kam hmuh. Kai nan moeithen banghui la ka kut lamkah ka khosaa he lo mai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen loh kai n'rhen tih kai ham a cungkuem a khueh dongah kai kah yoethennah nang taengla kang khuen te doe mai,” a ti nah tih amh te a hloep daengah a doe pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah, “Ceh, cet uh pawn sih lamtah nang hnuk ah ka lo eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Jakob loh, “Ka boeipa camoe rhoek te mongkawt uh pueng tih ka taengah boiva neh saelhung cacun khaw om tila na ming. Amih te hnin at ah rhenten kam vai koinih boiva loh boeih duek uh ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka boeipa te a sal hmai ah ana cet mai saeh. Kai tah ka mikhmuh kah bitat dongkah khokan neh, camoe rhoek kah khokan neh, vawlhvawlh kang khool vetih Seir kah ka boeipa taeng hil ka lo eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah Esau loh , “Ka pilnam he nang taengah ka khueh mai eh ne,” a ti nah. Tedae, “Balae tih, ka boeipa kah mikhmuh ah mikdaithen ka dang mai mako,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Esau khaw amah tekah khohnin ah amah longpuei ah Seir la bal.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Jakob loh Sukkoth la cet tih amah ham im a sak phoeiah a boiva ham pohlip a saii. Te dongah te hmuen ming te Sukkoth la a khue.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah Jakob loh Paddanaram lamloh hlah uh. Kanaan diklai Shekhem khopuei te sading la a pha tih khopuei imdan ah rhaeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah a dap tuk hmuen te Shekhem napa Hamor ca rhoek kut lamkah khamyai rhoek te tangka yakhat neh a lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah hmueihtuk pahoi a suem tih El Elohim Israel a sui.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leah canu Dinah, Jakob ham a cun pah te tolrhum kah tanu rhoek te sawt hamla cet.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae khohmuen kah khoboei Khivee Hamor capa Shekhem loh anih te a hmuh dongah a loh tih a yalh puei phoeiah a tholh puei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Jakob canu Dinah taengah a hinglu tlun tih hula te a lungnah dongah hula kah lungbuei te doelh a voek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Shekhem loh a napa Hamor la, “Hekah hutaca he kai ham ka yuu la han lo,” a ti nah tih a thui pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />A canu Dinah a poeih pah te Jakob loh a yaak dae kohong ah a ca rhoek neh boiva te a om pueng dongah amih halo uh due Jakob loh hil a phah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jakob te voekhlak ham Shekhem napa Hamor te cet.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob ca rhoek khaw pong lamkah a pai uh vaengah a yaak uh. Tongpa tongpa rhoek te a kothae uh tih amih te muep sai uh. Jakob canu taengah a yalh te Israel taengah boethaehalang ni a. saii. Tedae he he a saii tueng moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Hamor loh amih taengah, “Ka capa Shekhem loh nang canu soah a hinglu loh a ven oeh tih a yuu la m'pae mai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah nangmih nu te kaimih taengah vasak sak ham kaimih m'pae lamtah namamih ham kaimih nu na loh uh mako.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaimih taengah khosa uh mai. Na mikhmuh ah khohmuen om coeng. Khosa uh lamtah thimpom neh a khuikah te bawn uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Shekhem loh Dinah kah a napa neh a nganpa rhoek taengah, “Nangmih mikhmuh ah mikdaithen ka dang atah kai taengah na kuek uh vanbangla kan paek uh bitni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kai soah maan neh kutdoe muep na kuek uh akhaw kai taengah na kuek uh te tah kan paek bitni. Tedae hula te ka yuu la kai taengah paek uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae a ngannu Dinah te a poeih pah dongah Jakob ca rhoek loh Shekhem neh a napa Hamor te a doo uh vaengah thailatnah neh a voek uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih rhoi te, “Hlang yanghli taengah ka ngannu paek ham hno saii he kaimih ham kokhahnah la om tih coeng pawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmih taengkah tongpa boeih te yahhmui a rhet tih kaimih bangla na om uh atah he nen bueng ni nangmih te kan rhoi uh eh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te daengah ni kaimih nu rhoek te nangmih kan paek uh phoeiah kamamih ham nangmih nu rhoek te ka loh uh vetih nangmih taengah kho ka sak uh vaengah pilnam pakhat la n'coeng uh eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae yahhmui rhet ham kaimih neh nan rhoi uh pawt atah ka canu he ka loh uh vetih ka bal uh ni,” a ti uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah amih kah olka te Hamor mikhmuh ah khaw, Harmor capa Shekhem mikhmuh ah khaw then.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae cadong loh Jakob canu te a ngaih coeng dongah hno saii ham te uelh pawh. Te dongah anih te a napa imkhui boeih soah a thangpom.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Hamor neh a capa Shekhem loh amah khopuei vongka la cet tih amah khopuei kah hlang rhoek taengah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hekah hlang rhoek he mamih neh baerhoep la tolrhum ah khaw khosa uh saeh. Te phoeiah amih kah nongcen rhoeh la khotuk khaw amih ham a dang ka mungkung mai. Mamih kah yuu la amih nu rhoek te lo sih lamtah mah nu te amih pae uh sih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae tongpa boeih loh yahvin a rhet uh vanbangla mamih ah pilnam pakhat la om ham atah ning taengkah aka om tongpa rhoek kah yahhmui a rhet nen bueng he ni mamih te n'rhoi uh eh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amih kah boiva neh hnopai, rhamsa boeih khaw mamih ham moenih a? Te dongah amih te rhoi uh mai sih lamtah mamih taengah khosa uh saeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah a khopuei kah vongka ah aka cet boeih loh Hamor neh a capa Shekhem te a ngai uh tih tongpa boeih khukah a khopuei vongka aka pha boeih loh yahhmui a rhet uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae hnin thum a lo vaengah amih te a tloh pah . Te dongah Dinah nganpa Simeon neh Levi, Jakob ca rhoi loh cunghang rhirha a muk rhoi tih ngaikhuek la khopuei te a paan rhoi. Te vaengah tongpa boeih te a ngawn rhoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hamor neh a capa Shekhem te cunghang ha neh a ngawn rhoi. Dinah te khaw Shekhem im lamloh a lat rhoi tih bal rhoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A ngannu a poeih pa uh dongah Jakob ca rhoek loh rhok te a paan uh tih khopuei te a poelyoe uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amih kah boiva neh saelhung khaw, laak khaw, khopuei khui neh lohma kah te a mawt pa uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amih kah tatthai boeih neh a yuu, a ca boeih te a sol pa uh tih im kah aka om boeih te khaw a poelyoe uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Jakob loh Simeon neh Levi taengah, “Khohmuen kah kho aka sa Kanaan neh Perizzi rhoek taengah ka bo nan rhim sak rhoi tih kai nan lawn rhoi coeng. Tahae ah kai hlang sii taengah tingtun uh tih kai he n'ngawn uh koinih kamah neh ka imko loh ka mit uh ni ta he,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae, “Ka ngannu te pumyoi bangla a saii ham om a?” a ti uh.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae Pathen loh Jakob la, “Thoo, Bethel la cet lamtah pahoi khosa. Te phoeiah na maya Esau mikhmuh lamkah na yong vaengah nang taengah aka phoe Pathen ham hmueihtuk khaw pahoi saii,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Jakob loh amah imkhuikho neh a taengkah aka om boeih taengah, “Nangmih lakli kah kholong pathen rhoek te voei uh. Te phoeiah caihcil uh lamtah na himbai te tho uh laeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thoo uh sih lamtah Bethel la cet uh sih. Ka citcai tue vaengah kai aka doo tih ka caeh long ah kai taengah aka om Pathen ham hmueihtuk pahoi ka saii ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah amih kut kah kholong pathen rhoek boeih neh a hna dongkah hnaii te Jakob taengah a paek uh tih Jakob loh Shekhem taengkah rhokael hmuiah a up.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae a caeh uh neh Pathen kah mueirhih loh khopuei kaepvai ah yaal tih Jakob ca te hloem uh pawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Jakob neh amah taengkah a pilnam boeih loh Kanaan kho kah Luz Bethel te a pha uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah hmueihtuk pahoi a suem tih a hmuen te El Bethel a sui. A maya mikhmuh lamloh a yong vaengah khaw te rhoek ah ni anih ham Pathen a phoe pah dongah ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rebekah kah cakhoem Deborah a duek vaengah khaw Bethel kungdak kah thingnu hmuiah a up tih a ming te Allon Bakuth la a khue.
  </para>
  <para style="p">
    <verse number="9" style="v" />Paddanaram lamkah koep a mael vaengah khaw Jakob taengah Pathen a phoe pah tih yoethen a paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Pathen loh anih te, “Na ming he Jakob dae na ming te Jakob la n'khue voel pawt vetih Israel ni nang ming la aka om eh?,” a ti nah. Te dongah a ming te Israel la a khue bal.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah anih te Pathen loh , “Kai he Pathen Tlungthang ni. Pungtai lamtah namtom ah ping uh. Namtom hlangping khaw nang lamkah ha thoeng vetih na pumpu lamloh manghai thoeng uh ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham neh Isaak taengah ka paek hmuen te nang taengah kan paek vetih nang phoeikah na tiingan taengah khaw khohmuen te ka paek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tekah hmuen ah Jakob neh a cal rhoi pangthuem Pathen te anih taeng lamloh vik cet.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah amah neh a voek nah hmuen ah Jakob loh kaam a ling tih kaam lung te tuisi a suep tih situi a bueih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Pathen loh amah a voek nah hmuen ming te Jakob loh Bethel la pahoi a khue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah Bethel lamkah puen uh tih Epharath la caeh ham kho te a lak om pueng dae Rakhel te camoe om tih a ca om bahoeng kuel.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae a ca om a a tloh vaengah anih te ca aka om sak loh, “Tahae kah khaw nang ham tongpa la koep a om dongah rhih boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />A duek tom kah a hinglu a pat thuk vaengah camoe ming te Benoni la a khue. Tedae a napa long tah anih te Benjamin la a khue.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah Rakhel duek tih Epharath Bethlehem long ah te a up.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rakhel kah hlan soah Jakob loh kaam a ling te tihnin due Rakhel phuel kah kaam la om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Israel te cet tih Mikdaleder kah a voel ah dap a tuk.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae tekah kho ah khosa la Israel a om vaengah Reuben te cet tih a napa kah yula Bilhah taengah a yalh te Israel loh a yaak. Te vaengah Jakob ca rhoek hlang hlai nit om uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leah ca rhoek ah Reuben te Jakob caming la om tih Simeon, Levi, Judah, Issakhar neh Zebulun omuh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rakhel ca rhoi la Joseph neh Benjamin om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rakhel imom Bilhah ca rhoi la Dan neh Naphtali om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leah salnu Zilpah ca la Gad neh Asher he om tih Paddanaram ah Jakob ca tongpa la a cun pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Jakob loh Mamre Kiriatharba Hebron kah a napa Isaak taengla a pha. Teah te Abraham khaw Isaak khaw bakuep.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah Isaak kah khohnin loh kum ya neh kum sawmrhet lo coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Isaak khaw pal tih a duek vaengah patong kum soep la a pilnam taengah khoem uh coeng. Anih te a ca rhoi Esau neh Jakob loh a up.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahae kah he Esau Edom te kah rhuirhong rhoek ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esau loh Kanaan nu khuikah, Khitti Elon canu Adah neh Khivee hoel Zibeon kah a ca Anah canu Oholibamah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ishmael nu Basemath, Nebaioth ngannu te a yuu la a loh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Esau ham Adah loh Eliphaz a sak pah tih Basemath loh Reuel te a sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Oholibamah long khaw Jeush, Jalam, neh Korah te a sak. Amih he tah Kanaan kho ah a cun Esau ca rhoek ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Esau loh a yuu rhoek khaw, a ca tongpa rhoek khaw, a ca huta rhoek khaw, a im kah hinglu boeih neh boiva khaw, rhamsa boeih khaw, Kanaan kho ah a dang hnopai boeih khaw a khuen tih a mana Jakob mikhmuh lamloh kho tloe la cet.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amih kah khuehtawn aka om te a yet hang atah tun khosak ham khaw, a lampahnah khohmuen loh amih kah boiva hman ah amih te khuut ham a noeng moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Esau loh Seir tlang ah kho a sak. Esau te tah Edom ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahae kah rhoek he Seir tlang kah Edom napa Esau kah rhuirhong rhoek ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Esau ca rhoek kah a ming he, a yuu Adah capa te Eliphaz, a yuu Basemath capa te Reuel tih,
  </para>
  <para style="p">
    <verse number="11" style="v" />Eliphaz ca rhoek la Teman, Omar, Zepho, Gatam neh Kenaz tila om uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Timna khaw Esau capa Eliphaz kah a yula la om tih Eliphaz ham Amalek a sak pah. Amih te Esau yuu Adah koca rhoek ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Reuel ca rhoek he Nahath, Zerah, Shammah, Mizzah om tih, amih he Esau yuu Basemath ko la om uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Esau yuu, Zibeon nu Anah canu Oholibamah ca rhoek he khaw om uh tih, Esau ham Jeush, Jalam, Korah a sak pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esau cadil khuikah khoboei rhoek he tah, Esau caming Eliphaz koca ah khoboei Teman, khoboei Omar, khoboei Zepho, khoboei Kenaz,
  </para>
  <para style="p">
    <verse number="16" style="v" />khoboei Korah, khoboei Gatam, khoboei Amalek om tih amih te tah Edom kho kah Eliphaz khoboei, Adah ko rhoek ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Esau capa Reuel koca rhoek he khaw, khoboei Nahath, khoboei Zerah, khoboei Shammah, khoboei Mizzah om tih amih he Edom kho kah Esau yuu Basemath ko Reuel khoboei rhoek ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Esau yuu Oholibamah kah ca rhoek khaw khoboei Jeush, khoboei Jalam, khoboei Korah om tih amih he Esau yuu, Anah nu, Oholibamah ko kah khoboei rhoek ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />He rhoek he tah Esau Edom ca rhoek neh amamih kah khoboei rhoek ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hekah rhoek he tah Lotan, Shobal, Zibeon, Anah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Dishon, Ezer, Dishan paengpang kah kho aka sa Khori hoel Seir ca rhoek tih Edom kho kah Seir koca, Khori khoboei rhoek ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lotan ca rhoi khaw Khori neh Hemam om tih Timna he Lotan ngannu ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shobal ca rhoek he khaw Alvan, Manahath, Ebal, Shepho, Onam om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zibeon ca rhoek khaw Aiah neh Anah om tih Anah loh he a napa Zibeon kah laak a luem vaengah khosoek ah tuibae sih a hmuh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anah ca rhoek khaw Dishon neh Anah canu Oholibamah te om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah Dishon koca rhoek he Hemdan, Eshban, Ithran neh Keran om.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezer koca rhoek he Bilhan, Zaavan neh Akan om.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishan koca he Uz neh Aran.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khori khoboei rhoek la khoboei Lotan, khoboei Shobal, khoboei Zibeon, khoboei Anah.
  </para>
  <para style="p">
    <verse number="30" style="v" />khoboei Dishon, khoboei Ezer, khoboei Dishan om tih amih he tah Seir kho ah khoboei la aka om Khori khoboei rhoek ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae phoeiah Israel ca khuikah manghai la pakhat khaw a manghai uh hlanah Edom kho ah manghai la aka ngol manghai rhoek te tah Esau ko rhoek ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beor capa Bela loh Edom ah a manghai vaengkah a khopuei ming te tah Dinnabah ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bela a duek phoeiah anih hnukthoi la Bozrah kah Zerah capa Jobab te pahoi manghai van.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jobab a duek phoeiah a yuengla Temani kho kah Husham te manghai la om.
  </para>
  <para style="p">
    <verse number="35" style="v" />Husham a duek phoeiah anih yuengla Moab kho kah Midian aka tloek Bedad capa Hadad te manghai la om. Te vaengkah a khopuei ming te Avith ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hadad a duek phoeiah anih yuengla Masrekah lamkah Samlah te manghai la om.
  </para>
  <para style="p">
    <verse number="37" style="v" />Samlah a duek phoeiah anih yuengla tuiva kaeng, Rehoboth lamkah Saul loh manghai a bi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Saul a duek phoeiah anih yuengla Akbor capa Baalhanan loh manghai a bi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akbor capa Baalhanan a duek phoeiah anih yuengla Hadad te manghai. Te vaengkah a khopuei ming te Pau ni. Te phoeiah a yuu ming te tah Mehetebel, Mezahab nu Matred canu ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te phoeiah amah hmuen ah amah huiko, amah ming neh aka boei Esau ko kah khoboei rhoek ming te tah, khoboei Timna, khoboei Alva, khoboei Jetheth,
  </para>
  <para style="p">
    <verse number="41" style="v" />khoboei Oholibamah, khoboei Elah, khoboei Pinon,
  </para>
  <para style="p">
    <verse number="42" style="v" />khoboei Kenaz, khoboei Teman, khoboei Mibzar,
  </para>
  <para style="p">
    <verse number="43" style="v" />khoboei Magdiel, khoboei Iram om. Amih he amamih kah a khohut khohmuen kah a tolrhum ah aka boei Edom khoboei rhoek ni. Esau he Edom kah a napa ni.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob ngawn tah a napa kah lampahnah khohmuen Kanaan kho ah kho a sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob kah a rhuirhong he tah, Joseph kum hlai rhih a lo ca vaengah a maya rhoek taengah boiva a luem puei. Te vaengah anih te a napa yuu Bilhah ca rhoek nen khaw, Zilpah ca rhoek nen khaw cadong hmaih van. Tedae Joseph loh amih kah theetnah te a napa taengah a thae la a puen pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae Joseph te tah a patong soi kah a ca van oeh dongah a ca rhoek boeih lakah anih te Israel loh a lungnah tih pendum angkidung khaw a saii pah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae a maya rhoek boeih lakah a napa loh anih a lungnah te a maya rhoek loh a hmuh uh vaengah amah a hmuhuet uh. Te dongah anih rhoepnah neh voek ham khaw coeng uh pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Joseph loh mang a man tih a maya rhoek taengla a puen hatah a maya rhoek kah a hmuhuet uh te koep a khoep.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah a maya rhoek la, “Hnatun uh laeh, he tlam he mang ka man.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lohma li kah cangpa te mamih loh n'tum uh hatah kai kah cangpa te thoo tih pai. Te vaengah nangmih kah cangpa loh a vael uh tih kai kah cangpa taengah bakop uh,” a ti nah
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah anih te a maya rhoek loh , “Kaimih soah manghai la na manghai vetih kaimih soah na boei khaw na boei tang venim?,” a ti na uh . Anih a hmuhuet uh te a mang, a olka neh koep a khoep.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah mang a tloe koep a man tih a maya rhoek taengah, “Mang koep ka man hatah khomik neh hla neh aisi hlai at loh kai taengah tarha bakop uh,” a ti nah tih a doek.
  </para>
  <para style="p">
    <verse number="10" style="v" />A napa neh a maya rhoek taengah a doek bal dongah amah vik te a napa loh , “Mang na man te ba ham lae? Nang hmaiah diklai la bakop ham kai neh na nu neh na maya rhoek loh ka lo khaw ka lo uh a ya?,” a ti nah tih a ho.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah anih te a maya rhoek thatlai uh. Tedae a napa long tah olka te a kuem.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae a maya rhoek tah Shekhem ah a napa kah boiva luem sak ham a caeh cet.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah Israel loh Joseph la, “Na maya rhoek, te Shekhem ah luem uh pawt nim? Halo lamtah nang man amih taengla kan tueih pawn ve,” a ti nah. Te dongah amah te, “Ka om ngawn he,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Joseph la,” Tahae ah cet lamtah, na maya rhoek kah sading sathal neh boiva kah sading sathal khaw na hmuh phoeiah kai taengah ol koep ham voei,” a ti nah. Te phoeiah Hebron kol lamkah Shekhem la a tueih tih Joseph khaw cet van.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah lohma ah aka khohmang hlang te lawt a hmuh hatah tekah hlang loh , “Balae na tlap dae? a ti nah tih a dawt.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah Joseph loh, “Ka maya rhoek ni ka tlap. Mela a luem uh khaw han thui lah saw,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah tekah hlang long te, “He lamloh puen uh, “Dothan la cet sih,” a ti uh khaw ka yaak ta,” a ti nah. Te dongah Joseph loh a maya rhoek hnukah cet tih amih te Dothan ah a hmuh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae anih te a hla lamkah a hmuh uh tih amih taeng a pha hlan ah mah ngawn ham anih te a rhaithi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah a maya rhoek loh khat neh khat taengah, “Mang boei halo ke!
  </para>
  <para style="p">
    <verse number="20" style="v" />Halo uh laeh, anih ke ngawn uh sih lamtah tangrhom pakhat khuila voei uh sih. 'Boethae mulhing loh a ngaeh coeng,’ ti na uh sih. A mang te metlam nim a om ve so uh sih,” a ti uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae Reuben loh a yaak vaengah amih kut lamkah Joseph te a huul tih, “A kah hinglu he ngawn uh boel sih,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Reuben loh amih taengah, “Anih te thii long sak boeh, khosoek kah tangrhom khuila voei uh mai, anih soah kut hlah uh boel mai,” a ti nah. Te vaengah anih te amih kut lamloh huul ham neh a napa taengla mael puei ham a ngaih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Joseph loh a maya rhoek taengla apha vaengah Joseph kah angkidung neh a pum dongkah pendum angkidung te a pit pauh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Joseph te a khuen uh tih tangrhom khuiah a voeih uh. Tangrhom te khaw hoeng tih tui om pawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae buh ca la a ngol uh vaengah a dan uh hatah Gilead lamkah Ishmael lambong aka lo te lawt a hmuh uh. Te vaengah Ishmael rhoek loh Egypt la suntlak puei ham kalauk dongah anhoi, thingpi neh myrrh a phueih uh tih cet uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae Judah loh a manuca rhoek la, “Mah manuca te mueluemnah neh n'ngawn uh mai cakhaw a thii loh m'bueih ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Halo uh, anih he Ishmael taengah yoi uh sih. Ning kah a saa, manuca oeh dongah anih soah kut hlah thil boel sih,” a ti nah hatah a manuca rhoek long khaw a rhoi uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah Median hlang, thimpom rhoek halo neh Joseph te a doek uh tih tangrhom lamloh a khuen uh. Te phoeiah Joseph te Ishmael taengah tangka baelthong la a yoih uh. Te dongah Joseph te Egypt la a khuen uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Reuben loh tangrhom taengla a bal vaengah tangrhom khuikah Joseph te hah a sawt dongah a himbai te a phen.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah a manuca rhoek te a paan tih, “Camoe te a om pawt dongah kai melam ka mael eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Joseph kah angkidung te a loh uh. Maae tal a ngawn uh kah thii dongah angkidung te a nuem uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pendum angkidung te khaw a loh uh tih a napa taengla a khuen uh phoeiah, “Hekah angkidung ka hmuh uh he na capa kah himbai neh himbai pawt khaw hmat lah,” a ti na uh .
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah himbai te a hmat tih, “Ka capa kah angkidung la he, Joseph te mulhing boethae loh pat pat a ngaeh coini,” a ti.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jakob loh a himbai te a phen, a cinghen ah tlamhni a naak tih a capa ham hnin takuem puet nguekcoi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah anih aka hloep la a ca tongpa rhoek boeih neh a ca huta rhoek boeih khaw halo uh dae a hloep ham khaw a aal. “Ka capa taengah saelkhui la rhahdoe cangpoem neh ka suntla ni,” a ti nah tih Joseph kah a napa te rhap.
  </para>
  <para style="p">
    <verse number="36" style="v" />Median hoel long khaw Joseph te Egypt kah imtawt mangpa Pharaoh imkhoem Potiphar taengla a yoih uh.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hnin at vaengah tah Judah te a manuca rhoek taeng lamkah suntla tih Adullami hlang, a ming te Hirah taengah pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Judah loh Kanaan hoel nu, a ming ah Shua a hmuh hatah pahoi a loh tih a ih puei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah pumrhih tih capa a cun vaengah a ming te Er a sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah koep pumrhih tih ca a cun hatah a ming te Onan a sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah a rhaep bal tih capa a cun hatah a ming te Shelah a sak. Tedae Shelah a cun vaengah Kezib ah om.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Judah loh a caming Er ham yuu a loh pah tih anih ming tahTamar ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Judah kah a caming Er tah BOEIPA kah mikhmuh ah boethae la a om dongah anih te BOEIPA loh a duek sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Judah loh Onan la, “Na maya yuu taengah kun lamtah anih te yucanah. Te phoeiah na maya ham a tii a ngan thoh pah,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae a tii a ngan te amah ham om hae mahpawh tila Onan loh a ming dongah, a maya yurho taengah a ih vaengah khaw diklai ah vik a san tih a maya ham tiingan khueh pah pawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih kah a saii te BOEIPA mikhmuh ah a lolh bal dongah anih khaw BOEIPA loh a duek sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Shelah khaw a maya rhoi bangla duek ve a ti. Te dongah Judah loh a langa Tamar la, “Ka capa Shelah a pantai hil tah na pa im ah nuhmai la khosa mai ,” a ti nah. Te dongah Tamar khaw cet tih a napa im ah kho a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae kum a yet phoeiah tah Judah yuu Shua nu te duek. Te dongah Judah khaw hal tih a tu mul aka vo neh a hui Adullami Hirah taengah Timnah la cet.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah, “Tu mul vok ham Timnah la na marhang cet hang ke,” a ti na tih Tamar taengla a puen pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah Shelah khaw ham coeng dae anih yuu la n'khueh moenih tila Tamar loh a hmuh dongah amah dongkah nuhmai himbai te a dul. Te phoeiah hnii a yil, muei a thuh tih Timnah long kah Enaim thohka ah ngol.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae anih te Judah loh a hmuh vaengah a hmai a dah dongah pumyoi ni tila a poek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih te amah langa la a ming pawt dongah long taengla anih taengah pah tih, “Halo, nang taengah ka ip ni ne,” a ti nah hatah, “Kai taengah na kun te kai ham balae na khueh eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Judah loh, “Kamah loh boiva khuikah maae ca kan pat bit ni,” a ti nah. Tedae Tamar loh, “Nan pat hlanah hnohol han khueh dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah, “Hnohol te balae nang taengah kan paek eh?,” a ti nah. Te vaengah, “Na kutbuen mai khaw, hamnak khaw, na kut kah conghol mai te khaw,” a ti nah. Te dongah anih te a paek tih a kun thil dongah Judah loh Tamar a vawn sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah thoo tih, cet tih a pum dongkah hnii te a dul phoeiah nuhmai himbai tloep a bai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah huta kut kah hnohol te tlan ham Judah loh a hui Adullami hoel kut ah maae ca te a pat van hatah rhawp hmu pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah te hmuen kah hlang rhoek te a dawt “Enaim long taengkah hlanghalh te melae?,” a ti nah vaengah he rhoek ah hlanghalh om pawh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah Judah taengla koep bal tih, “Anih te ka hmuh moenih. Te phoeiah he hmuen kah hlang rhoek long khaw, 'He rhoek ah hlanghalh a om moenih,’ a ti uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Judah loh , “Amah neh amah te khoem uh saeh, nueihbu la n'om uh ve. Maae ca n'thak he khaw anih te na hmuh voel pawt tih he,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae hla thum tluk a lo vaengah Judah taengah,” Nang langa Tamar te cukhalh tih pumyoihnah neh vawn lah ko te,” a ti nah tih a puen pa uh hatah Judah loh , “Anih te khuen uh lamtah hoeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih te a mawt uh van hatah, “He rhoek he u hlang kah nim. Kai khaw tekah hlang hut la ka vawn dongah hekah kutnoek, hamnak neh conghol, ukah nim tila hmat lah saeh,” a ti nah tih a marhang taengla Tamar loh a pat.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae Judah loh a hmat vaengah, “Ka capa Shelah te anih ka paek pawt dongah te kai lakah anih tang coeng,” a ti. Te dongah anih ming ham koep khoep voel pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae ca-om tue vaengah tah a bung khuiah caphae rhoi la tarha om.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah camoe a om vaengah kut pakhat te han thawt dongah ca-om loh a tuuk tih, a kut dongah a lingdik a cin pah tih, “Lamhma la om coeng he,” a ti.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae a kut vik a yueh tih a mana lat ha thoeng dongah, “Namah loh a puut Metlamlae nam va,” a ti nah dongah a ming te Perez a sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah a kut dongah a lingdik aka om a maya te ha pawk tih a ming te Zerah a sak.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph te Egypt la a suntlak puei ngawn dae, anih aka suntlak puei Ishmael kut lamkah te Egypt hlang, imtawt mangpa, Pharaoh imkhoem, Potiphar loh pahoi a lai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae BOEIPA te Joseph taengah a om dongah hlang thaihtak la coeng tih a boei Egypt hoel kah im ah om.
  </para>
  <para style="p">
    <verse number="3" style="v" />A boei long khaw, BOEIPA te Joseph taengah tih a saii boeih te a kut dongah BOEIPA loh a thaihtak sak tila a hmuh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joseph te a mikhmuh ah mikdaithen la a hmuh tih a taengah thotat. Te vaengah Potiphar loh a im te Joseph pum dongah a hlah pah. Te phoeiah a koe boeih te a kut ah a tloeng pah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae a im neh a koe boeih te a hlah pah vaeng lamloh om tih, Joseph kong ah Egypt cako te BOEIPA loh yoethen a paek. BOEIPA kah yoethennah te a koe neh im, lo boeih dongla cet.
  </para>
  <para style="p">
    <verse number="6" style="v" />A koe boeih te Joseph kut ah a hnoo pah van neh Egypt hoel loh buh caak bueng te a ming tih ba khaw amah loh ming pawh. Joseph ngawn tah a suisak sakthen tih mueimae sakthen la om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae hekah olka he a om phoeiah a boei kah a yuu loh a dan vaengah Joseph te a mik neh a nai tih, “Kai taengah yalh mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae a boei yuu te a aal tih, “Ka boeipa loh im kah aka om te kai taengah ngaiyak mueh la a khuehtawn boeih te ka kut ah a tloeng coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hekah im ah kai lakah aka len a om moenih. Tedae nang tah a yuu la na om dongah nang mueh atah ba khaw kai ham a hloh moenih. Te dongah metlam lae boethae aka len he ka saii vetih Pathen taengah ka tholh sui dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Joseph taengah, khohnin khohnin a thui pah van dae a taengah yalh ham neh om hmaih ham te Joseph lohngaiyaknah pawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae hnin at ah Joseph te amah kah bi saii ham im khuila a caeh van hatah, tekah im ah im om hlang te khat khaw om pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Potiphar yuu loh Joseph te a himbai ah a tuuk tih, “Kai taengah yalh mai,” a ti nah. Tedae Joseph loh a himbai te anih kut ah a caehtak phoeiah rhaelrham tih poeng la cet.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae a kut dongah a himbai a caehtak pa tih poeng la a rhaelrham vaengah te boeinu loh a hmu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah a im kah tongpa rhoek te a khue tih, “So uh lah, mamih aka lawn la Hebrew hlang te mamih taengla han khuen. Kai taengah yalh ham kamah taengla m'paan dongah ol ue neh ka pang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae ka ol ka huel tih ka pang te a yaak hatah kai taegah a himbai a caehtak phoeiah rhaelrham tih poeng la cet,” a ti nah tih a thui pah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah a boei loh a im a paan duela a kah himbai te amah taengah a khoem.
  </para>
  <para style="p">
    <verse number="17" style="v" />A taengah hekah olka bangla a thui pah tih, “Kai aka lawn ham ning taengah na det Hebrew sal loh ka taengah m'paan.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah ka ol ka huel tih ka pang hatah a himbai te kai taengah a hnoo tih poeng la rhaelrham,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Na sal loh kai hekah hno he a saii,” a ti nah tih a taengah a thui a yuu kah olka te a boei loh a yaak vaengah ngawn tah a thintoek ah pahoi sai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah Joseph te a boei loh a khuen tih manghai loh a khoh thongtla rhoek kah a hmuen, thong im ah a khueh dongah thong im ah pahoi om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae BOEIPA loh Joseph a om puei tih sitlohnah a tueng sak dongah thong im kah mangpa mikhmuh ah anih te mikdaithen la a khueh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah thong im kah mangpa loh thong im kah thongtla boeih te Joseph kut ah a paek tih saii ham koi boeih te aka saii la Joseph khaw pahoi om.
  </para>
  <para style="p">
    <verse number="23" style="v" />BOEIPA tah anih taengah om tih a saii te BOEIPA loh a thaihtak sak. Te dongah thong im mangpa a om pawt akhaw a kut hmuikah tah pakhat hilah boeih a sawt.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hekah olka a om phoeiah Egypt manghai kah tuitul neh buh thong loh a boei Egypt manghai taengah lai a hmuh rhoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Pharaoh tah a imkhoem tuitul rhoi kah mangpa neh buh thong rhoek kah mangpa taengah a thintoek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah amih rhoi te imtawt mangpa im kah thongim ah a khueh. Te im kah thong hmuen ah Joseph te a khoh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah imtawt mangpa loh thongtla rhoek taengah Joseph te a hlah tih amih taengah thotat. Te tlam te thongim ah vuenhlaem om uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae Egypt manghai loh thong im kah a khoh tuitul boei neh buh thong boei loh khoyin pakhat ah mang a man rhoi. A mang rhoi te khaw, a mang thuingaihnah khaw bok om.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mincang ah amih taengla Joseph kun tih amih rhoi te a sawt hatah a hmai vik tal rhoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah a boei im kah thongim ah amah neh aka om Pharaoh imkhoem te a dawt tih, “Tihnin atah balae tih na hmai a thae rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Joseph la mang ka man rhoi van dae aka thuicaih om pawh,” a ti nah rhoi. Te dongah Joseph loh amih rhoi te, “Thuingaihnah he Pathen hut moenih a? Kai taengah thui rhoi mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah tuitul rhoek kah mangpa loh a mang te Joseph taengah a thui tih, “Ka mang ah misur kung te ka hmai ah lawt om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Misur dongah a baek pathum neh a muem, a pai khaw cuen, misur kah a su khaw hmin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Pharaoh kah boengloeng te ka kut ah om. Te phoeiah misur thaih te ka loh tih Pharaoh boengloeng dongah ka sui phoeiah boengloeng te Pharaoh kut ah ka paek,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph loh anih te, “A thuingaihnah he, misur baek pathum te khohnin hnin thum ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hnin thum khuiah Pharaoh loh na lu te a dangrhoek vetih nang te namah hmuen la m'mael sak ni. Hnukbuet ah a tuitul la na om vaengkah khosing bangla Pharaoh te a kut dongah boengloeng na doe ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae namah taengkah kai nan poek mai atah namah ham a voelphoeng vaengah kai taengah sitlohnah tueng sak mai. Pharaoh taengah kai n'thoelh lamtah kai he, he im lamloh n'khuen ne.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hebrew kho lamkah a huen la n'huen phoeiah hiah khaw ba ka saii pawt maiah tangrhom la kai n'hlak uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />A then la a thuicaih te buh thong rhoek kah mangpa long khaw a hmuh vaengah Joseph la, “Kai khaw ka mang vaengah vaidam te kodawn pathum neh ka lu ah ka doeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Pharaoh kah cakok ka thong boeih te a so kah kodawn dongah om. Tedae ka lu sokah kodawn te vaa loh a caak,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Joseph loh a doo tih, “A thuingaihnah he tah kodawn pathum khohnin hnin thum ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hnin thum khuiah Pharaoh loh na lu te na pumdong lamkah a phil vetih thing dongla n'kuiok sak phoeiah na saa te vaa loh a caak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeikah a thum khohnin dongah Pharaoh cun nah khohnin om tih a sal boeih ham buhkoknah a saii. Te vaengah tuitul rhoek kah mangpa lu neh buh thong rhoek kah mangpa lu te a sal lakli ah a dangrhoek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah tuitul rhoek kah mangpa te amah kah tuitul la koep a khueh tih Pharaoh kut ah boengloeng a doe.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae buh thong mangpa te tah Joseph kah a thuicaih van bangla a kuiok sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae tuitul mangpa loh Joseph te a poek mueh la a hnilh
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah om tih kum a thok tue vaengah Pharaoh loh mang a man tih sokko taengah ana pai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah vaito pumrhih, a mueimae sakthen neh a pum aka toitup te sokko lamkah lawt halo tih capu ding ah luem uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amih hnukah a mueimae thae tih a pum aka cangkhawk vaito pumrhih te khaw sokko lamkah lawt ha thoeng bal tih sokko kaeng kah vaito kaepah pai uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae a mueimae thae tih a pum aka cangkhawk vaito pumrhih loh a mueimae sakthen neh aka toitup vaito te a caak uh, vaengah Pharaoh haenghang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah ip tih a pabae la mang a man hatah cangvuei thamkom neh aka then parhih te a cangkong pakhat dongah tarha vuei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah aka om cangvuei thamyit parhih te tah a hnukah kanghawn loh a yah tih a hum sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae cangvuei thamyit parhih loh cangvuei thamkom neh cangtak te a yoop vaengah Pharaoh haenghang hatah a mang la pawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah mincang a pha vaengah tah a mueihla a cahoeh. Egypt hmayuep boeih neh aka cueih boeih te khaw a tah tih a khue. Tedae Pharaoh loh amih taengah a mang te a thui hatah Pharaoh ham aka thuicaih thai om pawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te daengah tuitul mangpa loh Pharaoh taengah, “Tihnin ah ni kamah tholh te ka poek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pharaoh loh a sal rhoek taengah a thintoek tih kai neh buh thong mangpa te imtawt mangpa kah im thongim la n'khoh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae hlaem pakhat ah kai khaw anih khaw mang ka man rhoi hatah mang thuingaihnah te rhirha aka om te ka man rhoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah imtawt mangpa kah sal, Hebrew cadong te kaimih taengah om. Te dongah anih ham ka thui pah rhoi dongah kaimih rhoi kah mang te kaimih rhoi ham a thuicaih. Hlang kah a mang khaw a thuicaih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaimih rhoi taengah a thuicaih vanbangla om tih a thoeng dongah kai he ka hmuen koep han khueh vaengah anih te a kuiok sak,” a ti nah tih a thui pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Pharaoh loh Joseph te a tah tih khue sak vanbangla anih te tangrhom khui lamkah koe a doek uh tih sam a vok, himbai a tho phoeiah Pharaoh taengla cet.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah Pharaoh loh Joseph la, “Mang ka man tih aka thuicaih a om pawt vaengah aka thuicaih ham nang loh mang na yakming a ti tih nang kawng te ka yaak,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Joseph loh Pharaoh te a doo tih, “Kai moenih, Pharaoh te Pathen loh ngaimongnah neh doo bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Pharaoh loh Joseph te, “Ka mang ah sokko kaeng la ka pai. dae,
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae vaito a pumsa aka toitup tih a suisak sakthen pumrhih te sokko lamkah lawt halo tih capu ding ah luem uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amih hnukah vaito a tloe pumrhih halo bal dae tattloel la a suisak khaw bahoeng thae tih a pum pim. Tetla thaenah tah Egypt kho tom ah ka hmu pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah vaito aka pim neh a thae pumrhih loh lamhma kah vaito aka tha rhoek te a caak uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae amih ko khuila a kun uh thuk lalah a moecuek vaengkah bangla a mueimae a thae dongah amih ko khuila a kun uh te thui la a hut pawt vaengah ka haenghang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeikah ka mang ah khaw cangvuei thamkom neh a then thamrhih te a cangkong pakhat dongah ha thoeng te lawt ka hmuh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amih hnukkah cangvuei parih thamyit neh aka rhae, kanghawn loh a yah tih aka hum te tarha halo van.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah cangvuei aka yit rhoek loh cangvuei a then thamrhih te a dolh dongah hmayuep rhoek ham ka thui pah dae kai taengah aka puen om pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Joseph loh Pharaoh la, “Pharaoh kah a mang he pakhat ni. Pathen loh a saii te Pharaoh taengah a phoe coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vaito aka then pumrhih khaw kum rhih la om tih cangvuei a then parhih kum rih la om tih a mang te pakhat ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amih hnukah aka thoeng vaito pumrhih aka pim tih aka thae te khaw kum rhih la om tih, cangvuei aka hi tih kanghawn loh a hum sak parhih te khokha kum rhih ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pharaoh taengah kan thui vanbangla Pathen loh a saii hno he Pharaoh a tueng coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aka lo ham kum rhih te Egypt kho tom ah khobuh khungdaeng ni te.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae a hnukah khokha kum rhih pai vetih Egypt kho kah khobuh te boeih a hnilh. Te vaengah khohmuen khaw khokha loh a khah ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah a hnuk lamtah khokha bahoeng nah tih khobuh te vang khui loh ming mahpawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pharaoh taengah a pabalae la mang a rhaep he khaw Pathen taeng lamloh olka a cikngae sak dongah Pathen loh tlek a saii ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah Pharaoh loh , aka yakming tih aka cueih hlang te so lamtah anih te Egypt kho ah khueh laeh saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khohmuen ah hlangtawt rhoek te Pharaoh loh tuek saeh lamtah khobuh kum kumrhih khuiah Egypt kho kah panga pakhat aka coi la om saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te daengah ni kum then a pai vaengkah caak boeih te a coi uh eh. Te phoeiah Pharaoh kut hmuiah cangpai a tung uh vetih khopuei ah caak khaw a cuem eh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kho kah hnokhueh dongah caak a om daengah ni khokha loh Egypt khokhui la kum kumrhih a om halo vaengah khohmuen te khokha loh a tulnoi pawt eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tekah olka ngawn tah Pharaoh mik neh a sal rhoek boeih kah mik ah a thuem sak.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te dongah Pharaoh loh a sal rhoek la, “Hekah hlang bangla a khuiah Pathen mueihla aka om te m'hmuh noek nim?,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah Pharaoh loh Joseph la, “Hekah boeih he Pathen loh nang m'ming sak dongah nang bangla aka thuep neh aka cueih he om pawh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kai im ah nang om lamtah nang kah olpaek te ka pilnam boeih loh ngai saeh. Ka ngolkhoel bueng nen mah nang lakah ka ham mai eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah Pharaoh loh Joseph la, “So lah, Egypt kho pum kah a soah nang ni kan hut sak coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Pharaoh loh a kut dongkah a kutcaeng te a dul tih Joseph kah kut ah a buen pah. Hnitang himbai neh a khuk phoeiah a rhawn ah sui oi a oi sak.
  </para>
  <para style="p">
    <verse number="43" style="v" />Leng dongah khaw a hnukthoi la a ngol sak tih, “Anih hmai ah cungkueng uh,” hlo a phoek uh tih Egypt kho boeih kah a soah Joseph te a khueh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te phoeiah Pharaoh loh Joseph la, “Kai he Pharaoh coeng dae nang muehah hlang loh a kut khaw a kho khaw Egypt kho tom ah thueng boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Joseph ming khaw Pharaoh loh Zephenathpaneah la a khue tih a yuu la Oni khosoih Potiphera canu Asenath te a paek. Te phoeiah Joseph loh Egypt kho tom a hil.
  </para>
  <para style="p">
    <verse number="46" style="v" />Egypt manghai Pharaoh taengla a kun vaengah Joseph te kum sawmthum lo ca pueng. Tedae Pharaoh mikhmuh lamloh Joseph nong tih Egypt kho tom boeih a hil.
  </para>
  <para style="p">
    <verse number="47" style="v" />Te phoeiah khobuhnah kum rhih khuiah tah khohmuen te kutvang long khaw a thaih sak.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te dongah Egypt kho kah aka thoeng kho kum rhih kah caak boeih te a coi tih khopuei boeih ah caak a tung. Khopuei kaepvai kah khohmuen cang khaw a khui ah a khueh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Joseph loh cang a tung vaengah tuitunli kah laivin bangla muep a yet dongah a loeng tloel tih a tae ham khaw a toeng.
  </para>
  <para style="p">
    <verse number="50" style="v" />Khokha kum halo hlanah Oni khosoih Potiphera canu Asenath loh ca a cun pah tih Joseph loh capa panit a sak.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te vaengah Joseph loh , “Ka thakthaenah boeih neh a pa cako boeih te Pathen loh kai n'hnilh sak,” a ti dongah a caming te a ming Manasseh a sui.
  </para>
  <para style="p">
    <verse number="52" style="v" />A ca pabae ming te khaw, “Kai kah phacip phabaem kho ah Pathen loh kai m'pungtai sak,” a ti dongah Ephraim a sui.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tedae Egypt kho ah khobuh kum rhih aka om te bawt.
  </para>
  <para style="p">
    <verse number="54" style="v" />Joseph loh a thui vanbangla aka lo ham khokha kum rhih a tong dongah paeng tom ah khokha om coeng dae Egypt kho pum ah caak om pueng.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tedae Egypt kho kho boeih loh a lamlum van vaengah tah pilnam loh caak ham ham te Pharaoh taengla pang uh. Te dongah Pharaoh loh Egypt rhoek boeih te, “Joseph taengla cet uh lamtah nangmih taengah a thui bangla saii uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="56" style="v" />Khokha loh diklai hman boeih te a pha vaengah a kho khuikah aka om cangpai boeih te Joseph loh a hlah tih Egypt rhoek ham a yoih pah dongah Egypt kho kah khokha te a noeng.
  </para>
  <para style="p">
    <verse number="57" style="v" />Paeng tom long khaw koivawn ham Egypt kah Joseph te a paan uh dongah paeng tom kah khokha khaw a talong.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Egypt ah cangtham a om te Jakob loh a hmuh vaengah a ca rhoek te Jakob loh , “Ba dongah lae sut na sawt uh thae? a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />phoeiah, “Egypt ah cangtham om tila ka yaak dongah he, n'duek uh pawt tih n'hing uh mak atah te lam khaw cet uh lamtah mah hamla koivawn uh saw,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Joseph kah a maya hlang rha rhoek loh Egypt kah cang lai ham suntla uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Joseph mana Benjamin te tah nganboh yook ve a ti dongah a maya rhoek taengah Jakob loh tueih pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kanaan kho te khokha a om dongah koivawn ham aka cet rhoek lakli ah Israel ca rhoek khaw cet uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah Joseph tah a kho kah boei neh diklai pilnam boeih ham cang a yoih. Te dongah Joseph kah a maya rhoek te a caeh uh vaengah anih taengah a maelhmai neh diklai la bakop uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hmuh vaengah Joseph loh a maya rhoek te a hmat ngawn dae amih taengah muet uh tih rhaprhap a voek phoeiah, “Me lamkah lae na lo uh,” a ti nah hatah, “Caak lai ham Kanaan kho lamkah ka lo,” a ti na uh .
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph loh a maya rhoek te a hmat ngawn dae amih loh Joseph te hmat uh pawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah Joseph loh amih kawng a man vaengkah mueimang te a poek. Te dongah amih te, “Nangmih he rhalyuep ni, khohmuen kah a yah te sawt ham ni na lo uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae amah taengah “Pawh, ka boeipa, na salpa rhoek halo he caak lai ham ngawn ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kaimih he hlang pakhat kah a ca rhoek boeih ni. Kaimih hmantang rhoek ni, na sal kaimih ah he longyam a om moenih,” a ti uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae amih te Joseph loh khohmuen kah a yah dongah sawt ham na lo uh pawt het nim,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na sal rhoek kaimih boeinaphung he hlang pakhat kah a ca rhoek la Kanaan kho ah hlai nit ka lo uh tih a poeih tah tahae ah a pa neh om rhoi dae pakhat te om voelpawh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae amih te Joseph loh , “Nangmih taengah ka thui bangla nangmih he longyam ni ka ti,
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharaoh kah a hingnah vanbangla he nen he kan noem ni. Na mana a poeih te he la halo pawt atah he lamloh na voei uh mahpawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmih khuikah pakhat te tueih uh lamtah na mana te lo saeh. Nangmih ngawntah kang khoh uh vetih nangmih kah olka te na khuikah oltak la a om atah kan nuemnai pueng ni. Te pawt koinih Pharaoh kah a hingnah vanbangla nangmih he longyam ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah amih te thongim ah hnin thum a khoh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae a thum khohnin ah Joseph loh a maya rhoek la he tlam he ka saii dae, kai khaw aka hing Pathen te ka rhih van.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na thuem uh atah na manuca khat te im kah thongim khuiah khoh saeh. Te vaengah nangmih te cet uh lamtah na im kah aka lamlum ham cang khuen pauh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae na mana a poeih te kai taengah nan khuen uh vaengah nangmih kah olka te khaw cak vetih na duek uh van mahpawh,” a ti nah dongah te tlam te a rhoi uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah amah boeinaphung te khat khat ah, “Manuca a hinglu kah citcai te hmuh uh tih mamih taengah calcal a pang lalah n'yaak pah uh pawt dongah tekah citcai loh m'mah taengla ha thoeng tih mamih he rheprhep n'rhaem coeng,” a ti uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah Reuben loh amih te a doo tih, “Nangmih taengah ka thui moenih a? Camoe te veet uh boeh ka ti lalah na ya uh pawt tih a thii han suk coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae amih laklo ah oldoe a om dongah Joseph loh a yakming te amih loh ming uh pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Joseph loh amih taeng lamkah mael tih a rhah phoeiah amih taengla koep halo. Tedae amih te a voek phoeiah amih khui kah Simeon te a loh tih amamih kah mikhmuh ah a khoh pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Joseph loh a uen coeng dongah amih kah hnopai te cang a sang thiluh. Te vaengah a tangka te khaw a tolkhui khuiah rhip a khueh ham khaw, amih ham te longpueng kah lampu khaw paek ham khaw, a saii pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah amamih kah cang te laak dongla a pom hang uh tih pahoi cet uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae rhaehim ah tah pakhat loh laak rhamcak loh ham a tolkhui te a hlam hatah a tangka te sungkoi kah a rhai ah lawt a hmuh tarha.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah a manuca rhoek taengah, “Kai kah sungkoi dongah kamah kah tangka koep ham mael bal he,” a ti nah hatah amih lungbuei khaw mawt sut dongah lakueng uh tih a boeinaphung khat rhip loh, “Pathen loh mamih ham balae a saii he,” a ti uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Kanaan kho kah a napa Jakob taengla a pha uh vaengah amih taengah aka thoeng boeih te amah taengah puen uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tekah hlang, a kho kah boei te kaimih taengah rhaprhap cal tih kaimih te a kho kah longyam bangla n'khueh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae anih taengah, 'hmantang ah kaimih he longyam la ka om moenih.
  </para>
  <para style="p">
    <verse number="32" style="v" />A pa kah a ca rhoek la ka boeinaphung ah hlai nit ka lo uh dae pakhat om voelpawt tih a poeih ngawn tah tihnin ah khaw a pa neh Kanaan kho ah hmaih om,’ ka ti na uh .
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae tekah hlang, a kho kah boei loh kaimih te, 'boeinaphung kah pakhat te kai taengah na caehtak uh tih te nen te nangmih na thuem ka ming phoeiah na im kah aka lamlum ham caak khuen uh lamtah cet uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae na mana a poeih te kai taengah han khuen uh. Te daengah ni nangmih te longyam rhoek pawt tih na hmantang tila ka ming eh. Na manuca te nangmih taengla kan paek vetih khohmuen ah na thenpom uh bitni,’ a ti,” a ti uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah amamih kah tolkhui te a kong uh hatah a tangka cun te tolkhui dongah rhip tarha om tih tangka cun a hmuh uh vaengah amamih long khaw a napa long khaw a rhih uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah a napa Jakob loh amih te, “Kai taengah, Joseph na hlong uh tih om voelpawh. Simeon khaw om voelpawh. Tahae ah Benjamin bal atah kai taengkah aka om boeih te lo loh ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah Reuben loh a napa taengah, “Anih te namah taengla kan khuen pawt atah kai ca rhoi khaw ngawn mai. Ka kut dongah han tloeng lamtah kamah loh nang taengla kang khuen bit ni,” a ti nah tih a thui pah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae anih loh, “Ka ca te a maya duek tih amah bueng a sueng dongah nangmih taengla ha suntla boel saeh. Longpueng na caeh uh vaengah yoethae puei vetih kai sampok he saelkhui ah kothae la nan hla uh ve,” a ti nah.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae diklai ah khokha a nah pueng dongah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Egypt lamkah a khuen cang te khaw bawt a khawk uh. Te dongah a napa Jakob loh a ca rhoek la, “Cet lamtah mah caak ham bet vawn uh dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Judah loh a napa te, “Hlang loh kaimih taengah, 'Na mana te namah neh na pawk pawt atah kai maelhmai na hmuh uh mahpawh,’ a ti tih n'hih la n'hih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka mana te nan tueih mai koinih ka cet uh vetih namah ham man caak ka lai uh ve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nan tueih van pawt atah hlang loh kaimih taengah, 'Na mana te namah neh na pawk pawt atah kai maelhmai hmu uh mahpawh,’ a ti oeh dongah ka cet uh mahpawh, a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah Israel loh , “Na mana khat te khaw ba ham lae hlang taengla na puen uh tih kai he nan talh uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah a ca rhoek loh, “Hlang loh mamih kawng neh pacaboeina kawng te n'dawt n'dawt tih, 'Na pa hing pueng a? Na mana om a? a ti dongah a ka dongkah olka te ni ka doo uh dae, 'Na mana han khuen,’ a ti ni tila ka ming khaw ka ming uh huek a,” a ti na uh .
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Judah loh a napa Israel la, “Camoe te kamah neh n'tueih lamtah caeh hamla ka hlah uh pawn ni. Te daengah ni n'hing uh vetih kaimih khaw, namah khaw, camoe rhoek khaw n'duek pawt eh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih te kamah loh ka kaem. Nang taengla kam bal puei tih kamah kut lamkah nang hmai ah kan khueh pawt atah han suk. Khohnin takuem nang taengah tholh ka phueih bit ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae ka uelh uh pawt koinih he la koep ka voei uh pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te daengah a napa Israel loh , “He tlam he saii laeh, tolrhum kah thaihthen, thingpi khaw, khoitui khaw, anhoi khaw, myrrh khaw yungkha mu khaw, noepai mu khaw, a yol a yol tah na hno dongah rhip sang uh lamtah hlang ham te khosaa la khuen uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na kut dongah tangka rhaepnit la khuen uh lamtah na sungkoi so kah tangka te khaw mael puei uh. Na kut dongah na loh tholh khaming.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na mana khaw khuen uh. Hlah uh lamtah hlang taengla ha cet uh laeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang hmai ah khaw Pathen Tlungthang loh nangmih taengah haidamnah han khueh saeh lamtah na mana neh Benjamin te han hlah saeh. Ka loh cakol khaw ka cakol mai eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah tekah hlang rhoek loh khosaa te a khuen uh. Te phoeiah a kut dongkah tangka te rhaepnit la a khuen uh tih aka thoo uh te Benjamin khaw Egypt la a suntlak puei uh tih Joseph hmai ah pai uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph loh amih neh Benjamin te a hmuh vaengah a im aka khut taengah, “Hlang rhoek te im la khuen. Te phoeiah maeh ngawn lamtah kamah neh khothun buh caak ham sai,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tekah hlang long khaw Joseph kah a thui bangla a saii van tih hlang rhoek te Joseph im la a khuen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae Joseph im la a khuen uh vaengah hlang rhoek loh a rhih uh. Te dongah, “A moecuek ah mamih kah sungkoi khuiah koep a khueh tangka kawng dongah mamih palet ham neh mamih aka cungku sak ham ni. Te dongah mamih khaw laak rhoek khaw sal la tuuk ham n'khuen coeng,” a ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah Joseph im kah hlang taengla thoeih uh tih im kah thohka ah a voek uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah, “Ka boeipa aw, a moecuek vaengah ni caak lai ham ka suntlak khaw ka suntlak uh coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae rhaehim ka pha uh vaengah kamamih kah sungkoi te ka hlam uh hatah sungkoi kah a rhai ah tangka te rhip a om tarha dongah amah tarhing la ka kut dongah ka tangka te kan khuen uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah caak lai ham te ka kut dongah tangka a hloeh la kang khuen uh ngawn. Unim kaimih kah sungkoi dongah tangka a khueh dae ka ming uh pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae Joseph im om loh, “Nangmih taengah rhoepnah om saeh, rhih uh boeh. Na Pathen neh na pa kah Pathen loh na sungkoi dongah nangmih ham kawn a khueh tih na tangka loh kai taeng ham pha coeng,” a ti nah tih Simeon te amih taengla a mawt pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tekah hlang loh hlang rhoek te Joseph im la a khuen. Tui a paek tih a kho a yuh phoeiah laak ham rhamcak khaw a tloeng pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae khothun buh caak pahoi ham Joseph ha pawk ni tila a yaak uh dongah a khosaa te a soepboe uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah im la Joseph halo van neh a kut dongkah khosaa te im khuila a khuen uh tih a hmaiah diklai la bakop uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah amih te sading kawng a dawt tih, “Na pa patong na ti uh te sading la hing pueng a?,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah, “Na sal rhoek khaw ka sading uh tih a pa khaw hing pueng,” a ti nah uh phoeiah buluk uh tih a bawk la a bawk uh coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah a mik a huel hatah a manu ca, a mana Benjamin te a hmuh tih, “Na mana a poeih na ti uh te anih a?,” a ti nah tih, “Ka ca Pathen loh nang n'rhen saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae Joseph loh a manuca rhoek taengah a haidamnah pahoi tloo tih a rhah thaa la huut. Te dongah imkhui la cet tih pahoi rhap.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae a hmai a hlak phoeiah halo tih thiim uh. Te phoeiah, “Buh poep laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah Joseph khaw amah loh, a manuca te khaw amah amah loh, Joseph taengkah aka ca Egypt rhoek long khaw amah amah loh a poep uh. Te Egypt ham tueilaehkoi la a om dongah Hebrew taengah buh caak ham Egypt ham tah coeng pawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah caming tah amah caminghamsum bangla, a capoeih khaw a capoeih hamsum bangla a mikhmuh ah ngol uh. Te dongah hlang rhoek tah pakhat loh a hui taengah a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah Joseph loh amah hmai kah buham te amih ham a poep pa thil hatah Benjamin kah buham ngawtah amih boeih kah buham lakah a pueh panga la yet. A ok uh tih a taengah rhuihmil uh.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah a im kah te a uen tih, “Hlang rhoek kah sungkoi te cang a phueih rhoeh ah sang pa lamtah tangka te sungkoi kah a rhai ah rhip khueh pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae kai kah bunang khuikah ngun bunang te a poeih kah sungkoi khui ah khueh pah lamtah amah kah cang neh tangka khaw hmaih sang pah,” a ti nah dongah Joseph kah ol a thui bangla a saii van.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mincang khothaih nen tah hlang rhoek te amamih kah laak neh khaw vawl a tueih uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amih loh khopuei te a hla lamkah hawt a khum vaengah Joseph loh a im om te, “Thoo, hlang rhoek te a hnukah hloem lamtah na kae vaengah amih te, 'Balae tih a then te boethae neh na thuung uh?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka boeipa kah a tui ok te he moenih a? Te lamkah la anih a hma khaw a hma dae. Anih taengkah na saii uh te na lolh uh coeng, 'ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah amih te a kae vanneh hekah olka he a thui pah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae amih loh, “Ka boeipa tebang olka te ba ham lae a thui. Na sal rhoek loh tebang hno a saii ham khaw savisava la.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaimih loh sungkoi so kah tangka ka hmuh uh te Kanaan kho lamkah nang taengla kam bal puei uh atah metlamlae na boei im kah ngun neh sui te tarha ka huen uh eh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na sal rhoek khuiah u taeng mai ah khaw a om atah duek saeh lamtah kaimih khaw ka boeipa taengah sal la ka om uh eh,” a ti uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah Joseph im om loh, “Then, nangmih kah olthui vanbangla u khaw a taengah aka om hlang van te tah kai taengah sal la om saeh lamtah nangmih te ommongsitoe la na om uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah sungkoi te a loe la diklai ah rhip a hal uh tih rhip a ong uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah a ham taeng lamkah a tong tih a tlap te a poeih taengla a khah vaengah bunang te Benjamin kah sungkoi dongah a hmuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah a himbai te a phen uh tih laak dongah hno rhip a tloeng uh tih khopuei la koep bal uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Judah neh amah boeinaphung loh im a pha vaengah Joseph khaw a om pueng dongah a hmai ah diklai la bakop uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah Joseph loh ba bibi lae na saii uh he. Kai bang hlang he hma khaw hma tila, na ming uh moenih a?,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah Judah loh , “Ka boeipa taengah mebang ka thui tih metla ka cal vaengah lae ka tang uh eh. Na sal rhoek kathaesainah khaw Pathen loh a yan oeh coeng dongah kaimih khaw, a kut dongkah bunang a hmuh pah hlang nen te ka boeipa taengah sal ka bi uh van mai pawn ni ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Joseph loh, “Hekah he kai loh ka saii ham te savisava, a kut dongah bunang a hmuh hlang te kai taengah sal la om ngawn saeh lamtah nangmih te na pa taengah ngaimong la bal uh ngawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae Judah te anih taengla thoeih tih, “Aw ka boeipa kai aih he, na salpa khaw ka boeipa kah hna kaep ah olka bet ka thui dae ni. Tedae nang tah Pharaoh banghui la na om dongah na salpa taengah na thintoek te sai sak boel mai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka boeipa loh a sal rhoek he, 'Na pa neh na mana om a?,” a ti tih n'dawt.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah, “Ka boeipa la a pa khaw patong coeng tih a patong soi kah a cun capa a poeih te om. Tedae a manu pakhat kah a cun hmaih khuiah a maya te duek tih anih amah bueng la te a cul dongah a napa loh a lungnah,’ ka ti uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah na sal rhoek he, 'Anih te ka mik ah ka khueh van ham khaw kai taengla han khuen thuk,’ na ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah ka boeipa la, 'Camoe loh a napa a caehtak ham tah coeng pawh. Caehtak koinih a napa te duek ni, ' ka ti uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae na sal rhoek la, 'Na mana a poeih te nan suntlak puei pawt atah kai maelhmai hmuh ham khoep uh boeh,’ na ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah na sal rhoek he a pa taengla ka pawk uh vanneh ka boeipa kah olka te anih taengla ka puen uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah a pa loh , 'Mah ham khaw caak bet vawn uh bal dae,’ a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah, “Kaimih taengah ka mana a poeih om pawt koinih hlang maelhmai hmuh ham a coeng pawt dongah, 'Ka mana a poeih loh kaimih taengah a om pawt mai ah ka caeh uh ham coeng pawh tedae halo atah ka cet uh ni,’ ka ti uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah na sal rhoek he a pa loh , 'Ka yuu loh kai ham panit han sak te nangmih long khaw na ming uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae pakhat he kai taeng lamloh cet coeng. Te dongah, 'A ngaeh ngawn a ngaeh tang coeng,’ ka ti. Te dongah ni tahae due anih te ka hmu pawh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih he khaw ka mikhmuh lamkah na khuen uh tih anih loh yoethae puei bal koinih kai sampok he saelkhui ah a thae la nan hla uh ve,’ a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah na sal kai loh a pa taeng ka pha tih kaimih taengah camoe amah te om pawt koinih a hinglu neh a hinglu te a hlaengtang uh rhoi dongah,
  </para>
  <para style="p">
    <verse number="31" style="v" />camoe te hah a sawt vaengah duek koinih na sal rhoek loh a pa sampok na sal te saelkhui ah kothae la ka hlak uh la vik poeh ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na salpa loh camoe te a pa taengah rhi ka khang tih, 'Anih he nang taengla kam pawk puei pawt atah a pa taengah hnin takuem ka tholh ka phueih bitni,’ ka ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah na salpa he camoe yueng ah ka boeipa kah sal la ka om mai saeh lamtah camoe te a maya rhoek neh bal sak mai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Camoe kamah nen pawt koinih a pa taengah metlam caeh eh? A pa taengah yoethae a hmuh man ka hmuh lah ve,” a ti nah.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph long khaw amah taengkah aka pai boeih taengah thiim uh ham a coeng voelpawt vaengah, “Hlang boeih loh kai taeng lamkah nong uh,” tila pang. Te dongah a taengkah hlang tloe aka pai te a om pawt vaengah Joseph loh a manuca rhoek taengah amah kawng te a phoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah rhahnah neh a ol a huel. Te dongah Egypt rhoek loh a yaak uh tih Pharaoh im long khaw a yaak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Joseph loh a manuca rhoek la, “Kai he Joseph ni. A pa hing pueng a?,” a ti nah. Tedae anih hmuh ah a manuca rhoek te let uh tih doo uh thai pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Joseph loh a manuca rhoek la, “Kai taengla bet ha thoeih uh lah,” a ti nah tih a thoeih uh hatah, “Kai Joseph he na manuca ni. Kai he Egypt la nan yoih uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae hinglu hlawtnah ham Pathen loh nangmih hmai ah kai n'tueih coeng dongah kai nan yoih uh te namamih kah mik dongah na ngaihlih sak uh boel lamtah sai boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahae lamkah khokha kum loh kho khui ah om vetih kum nga ngawn tah lotawn cangah mueh la om pueng ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae diklai ah a meet la nangmih te n'hoep phoeiah loeihnah tanglue neh nangmih te hing sak ham ni nangmih hmai ah Pathen loh kai n'tueih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah nangmih loh hela kai nan tueih uh moenih. Tedae Pathen loh kai he Pharaoh napa lam khaw, amah im pum kah boei lam khaw, Egypt kho tom aka taemrhai ham khaw, n'khueh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A pa taengah a loe la cet uh lamtah, 'Na capa Joseph te Pathen loh Egypt pum kah boei la a khueh coeng,'. Uelh mueh la kai taengah na suntla uh tih,
  </para>
  <para style="p">
    <verse number="10" style="v" />kamah neh a yoei la om ham Goshen kho ah a pa namah khaw, na ca rhoek khaw, na ca rhoek kah a ca rhoek patoeng khaw, na boiva khaw, na saelhung neh na taengkah aka om boeih te khaw kho na sak uh bitni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khokha he kum nga a om pueng dongah nangmih te kan cangbam bitni. Namah khaw, na im khaw na taengkah aka om boeih khaw tal ve,’ a ti,’ ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tahae ah kamah ka neh nangmih taengah ka thui he nangmih mik neh ka mana Benjamin mik loh rhep a hmuh he.
  </para>
  <para style="p">
    <verse number="13" style="v" />Egypt ah kai, thangpomnah cungkuem neh nan hmuh uh boeih te a pa taengah puen uh lamtah a pa te pahoi tlek han khuen uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah a mana Benjamin te a rhawn ah a kop tih rhap. Benjamin long khaw a rhawn ah a kop tih rhap van.
  </para>
  <para style="p">
    <verse number="15" style="v" />A manuca rhoek te rhip a mok tih a rhah thil. Te phoei daengah a manuca rhoek loh anih taengah cal uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Joseph kah a manuca rhoek halo uh a ti te Pharaoh im loh olthang a yaak vaengah Pharaoh mik ah khaw, a sal rhoek mik ah khaw cop.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Pharaoh loh Joseph taengah, “He tlam he saii mai. Na manuca rhoek la, 'Na rhamsa neh sawn uh lamtah Kanaan kho la bal uh ngawn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na pa te khaw, na imkhui khaw, lo uh lamtah kai taengla han khuen uh. Nangmih te Egypt khohmuen kah a thennah kam paek vetih lai men te na caak uh bitni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah namah loh uen lamtah saii. Na ca rhoek ham khaw, na yuu rhoek ham khaw, na pa te khaw lo uh. Te phoeiah na bal uh vaengkah ham leng te Egypt kho lamloh namah neh puei uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Egypt khohmuen kah a thennah boeih he nangmih ham coeng dongah na hnopai khaw na mik dongah rhen boeh,’ ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah Isreal ca rhoek loh a saii uh tih Pharaoh kah olpaek vanbangla amih te Joseph loh leng a paek. Te phoeiah amih te longpueng ham lampu khaw a paek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amih ham thovaelnah himbai te khat khat rhip a paek tih Benjamin te tah tangka ya thum neh himbai thovaelnah ham yung nga a paek.
  </para>
  <para style="p">
    <verse number="23" style="v" />A napa ham khaw Egypt kah a thennah aka phuei laak pumrha, cang, caak neh a napa ham longpueng kah lampu aka phuei laaknu pumrha te a pat pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae a manuca rhoek te a tueih tih a hlah uh vaengah amih te, “Longpueng ah tlai uh boeh ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah Egypt lamkah Kanaan kho la cet uh tih a napa Jakob te a paan uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah Jakob taengah, “Joseph hing pueng tih anih loh Egypt kho boeih a taem a rhai,” tila a puen pauh. Tedae a lungbuei a lungmit coeng tih amih te tangnah pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae Joseph loh amih taengah a thui olka boeih te Jakob taengah a thui pa uh tih amah aka phuei ham Joseph kah a pat leng te a hmuh vaengah a napa Jakob kah a mueihla koep hing.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te daengah Israel loh , “Rhoek saeh, ka ca Joseph a hing pueng te ka duek hlanah ka cet vetih a muei ka hmu dae ni,” a ti.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah Israel loh a taengkah aka om boeih neh cet uh tih Beersheba a pha vaengah a napa Isaak kah Pathen ham hmueih a ngawn pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah amah tekah khoyin ah Isreal te Pathen loh mangthuinah neh a voek tih, “Jakob, Jakob,” a ti nah hatah, “Kai ka om he,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah kai Pathen he, na pa kah Pathen ni. Egypt la na suntlak thuk te rhih boeh. Nang te pilnu la pahoi kan khueh bitni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Egypt lam khaw nang taengah kan suntlak puei vetih nang te koep kam bal puei bal ni. Joseph long khaw na mik dongah a kut a tloeng ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Beersheba lamkah Jakob koep a thoh vaengah Israel ca rhoek loh a napa Jakob neh a ca rhoek khaw, a yuu rhoek khaw, anih aka phuei ham Pharaoh loh a pat leng nen te a khuen uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah amamih kah boiva neh Kanaan kho kah a dang uh khuehtawn te khaw a khuen uh tih Jakob neh amah taengkah a tiingan boeih loh Egypt la cet uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A ca tongpa rhoek neh a ca kah ca rhoek, amah taengkah a canu rhoek neh a ca rhoek kah canu rhoek khaw, a tiingan boeih te amah neh Egypt la a khuen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jakob neh a ca rhoek loh Egypt la a caeh uh vaengkah Israel ca rhoek kah a ming tah, Jakob kah a caming Reuben,
  </para>
  <para style="p">
    <verse number="9" style="v" />Reuben ca rhoek la Enok, Pallu, Khetsron neh, Karmee
  </para>
  <para style="p">
    <verse number="10" style="v" />Simeon ca rhoek la Jemuel, Jamin, Ohad, Jakhin, Zohar neh Kanaan nu kah a capa Saul,
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi ca rhoek la Gershon, Kohath neh, Merari
  </para>
  <para style="p">
    <verse number="12" style="v" />Judah koca rhoek la Er, Onan, Shelah, Perez, Zerah om daea Er neh Onan te Kanaan kho ah duek tih Perez ca rhoi la Khetsron neh Hamul om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Issakhar ca rhoek la Tola, Puvah, Jashub neh Shimron,
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun ca rhoek la Sered, Elon neh Jaheel,
  </para>
  <para style="p">
    <verse number="15" style="v" />Paddanaram ah Jakob ham a sak pah Leah koca rhoek te a canu Dinah nen tah a pum la huta tongpa hinglu thumkip pathum lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad ca rhoek la Ziphion, Hakki, Shuni, Ezbon, Eri, Arodi neh Areli,
  </para>
  <para style="p">
    <verse number="17" style="v" />Asher ca rhoek la Imnah, Ishua, Ishee, Beriah neh a ngannu Serah om tih Beriah ca la Heber neh Malkhiel om.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih he Laban loh a canu Leah taengah a paek Zilpah koca rhoek ni. Te dongah anih loh Jakob ham a sak pah he hinglu la hlai rhuk lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob yuu Rakhel ca rhoi la Joseph neh Benjamin om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joseph loh Egypt kho ah a om vaengkah a ca sak la Oni khosoih Potiphera canu Asenath loh Manasseh neh Ephraim a sak pah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin ca rhoek khaw Bela, Bekher, Ashbel Gera, Naaman Ehi, Rosh Muppin, Huppim neh Ard om.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jakob ham a sak pah Rakhel koca rhoek kah hinglu boeih he hlai li lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan ca la Hushim om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali ca rhoek la Jahzeel, Guni, Jezer neh Shillem om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laban loh a canu Rakhel a paek tih Jakob ham ca aka sak pah Bilhah koca kah hinglu boeih te parhih lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah Jakob ca rhoek kah a yuu rhoek te a hoep phoeiah Jakob amah pum dongkah aka poe tih Egypt la a caeh puei hinglu boeih he hinglu sawmrhuk parhuk boeih louh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Joseph loh Egypt kah a cun a ca rhoi hinglu panit nen ngawn tah a pum boeih la Egypt aka paan Jakob imkhui he hinglu sawmrhih lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah Judah te Goshen hil a hmai ah thuinuet ham Joseph taengah a hmai la a tueih tih Goshen khohmuen te a pha uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Joseph khaw amah kah leng te a khih tih a napa Israel doe ham Goshen la cet. Te dongah a napa te a hmuh neh a rhawn ah a kop tih a rhawn dongah puet rhap.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah Israel loh Joseph la, “Na hing pueng tih na maelhmai ka hmuh coeng dongah ka duek thai pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Joseph loh a manuca rhoek taeng neh a napa cako taengah, “Pharaoh yaak sak ham ka cet vetih, 'Kanaan kho kah ka manuca rhoek neh a pa cako te kai taengla ha pawk uh coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae tekah hlang rhoek te boiva aka dawn hlang la om uh oeh tih boiva khaw a dawn uh dongah amamih kah boiva neh saelhung a khueh uh boeih te han khuen uh,’ ka ti nah ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah Pharaoh loh nangmih n'uen tih, 'Na bibi balae,’ a ti ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah, 'Na sal rhoek ngawn tah, a pa rhoek khaw, kamamih khaw ka camoe uh lamkah tahae due boiva hlang la om uh. Te dongah boiva aka dawn boeih he Egypt rhoek kah tueilaehkoi la a coeng dongah Goshen kho ah kho nan sak sak mai mako,'ti na uh,” a ti nah.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Joseph cet tih Pharaoh taengah, “A pa neh ka manuca rhoek khaw, a boiva khaw, a saelhung khaw, amah taengkah aka om boeih te Kanaan kho lamkah halo uh tih Goshen kho ah om uh ke,” a ti nah tih a puen pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah a manuca khui kah hlang panga a khuen tih Pharaoh hmai ah a khueh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Pharaoh loh Joseph kah a manuca rhoek te, “Nangmih kah bibi te balae,” a ti nah hatah amih loh Pharaoh la, “Na sal rhoek he kamamih khaw, a pa rhoek long khaw boiva ni ka dawn uh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah Pharaoh la, “Kanaan kho ah khokha tlung tih na sal rhoek kah boiva ham a luemnah a om pawt dongah hekah khohmuen ah bakuep ham ka lo uh. Te dongah na sal rhoek he Goshen kho ah kho n'sak sak uh mai,” a ti na uh .
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Pharaoh loh Joseph la, “Na pa neh na manuca rhoek nang taengah aka lo rhoek te,
  </para>
  <para style="p">
    <verse number="6" style="v" />'Na hmai kah Egypt kho khuikah khohmuen then Goshen kho ah na pa neh na manuca rhoek te khosak sak. Te phoeiah amih khuikah tatthai hlang rhoek te na ming atah amih te kai kah boiva mangpa la khueh,” a ti nah tih a uen.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Joseph loh a napa Jakob te a khuen tih Pharaoh hmai ah a pai sak hatah Jakob loh Pharaoh te yoethen a paek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah Pharaoh loh Jakob la, “Nang kah hingnah a kum khohnin loh meyet a lo van coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Jakob loh Pharaoh la, “Ka lampahnah kum khohnin he kum pasoi neh thumkip vel a pha coeng. Tedae ka hingnah kum khohnin he yoethae yoehu la om tih a pa rhoek a lampahnah tue vaengkah a hingnah kum khohnin te a pha moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah Jakob loh Pharaoh te yoethen a paek tih Pharaoh taeng lamkah pahoi nong.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah Pharaoh kah a uen vanbangla Joseph loh a napa neh a manuca rhoek te Egypt kho ah khohut pakhat a paek tih khohmuen then Raameses kho ah kho a sak sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Joseph loh a napa neh a manuca rhoek khaw, a napa imkhui boeih neh camoe ka dongkah caak ham khaw a cangbam pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae khokha bahoeng tlung tih Egypt kho neh Kanaan kho te khokha loh a khah dongah kho takuem ah caak om pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah Joseph loh Egypt khohmuen neh Kanaan kho ah cangtham a lai ham rhoek kah tangka a hmuh te boeih a coi. Te phoeiah Joseph loh tangka te Pharaoh im la a khuen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae Egypt kho neh Kanaan kho kah tangka te a khawk uh vaengah Egypt rhoek loh Joseph te boeih a paan uh tih, “Kaimih he caak m'pae laeh. Tangka ka khawk uh cakhaw ba ham lae nang hmaiah ka duek uh eh?,” a ti uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Joseph loh , “Tangka a boeih oeh atah na boiva te m'pae uh lamtah nangmih kah boiva te kan khueh mako,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah amamih kah boiva te Joseph taengla a khuen uh tih Joseph loh marhang khaw, boiva tuping khaw, saelhung boiva khaw, laak ham khaw caak a paek pah tih tekah kum ah ngawn tah amih kah boiva boeih te khaw caak neh a khool.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae tekah kum thok tih a kum bae atah Egypt rhoek loh Joseph taengla halo uh tih, “Ka boeipa taengah ka phah uh moenih. Tangka khaw boeih coeng tih boiva neh rhamsa loh ka boeipa taeng a pha coeng dongah kaimih pum neh ka khohmuen pawt atah ka boeipa hmai ah a paih om voelpawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />ba ham lae nang mikhmuh ah ka duek uh eh. Kaimih he khaw, ka khohmuen he khaw n'lai uh. Kaimih khaw ka khohmuen khaw caak neh ka thung coeng atah kamamih neh ka khohmuen loh Pharaoh sal la ka om uh bitni. Tedae cangti nan paek tih ka hing uh daengah man ka duek uh pawt sui tih tolrhum loh a pong pawt sue,” a ti uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae khokha te amih taengah a tlung pah vaengah Egypt rhoek loh a khohmuen rhip a yoih uh tih Egypt kho pum te Pharaoh ham Joseph loh a lai pah coeng dongah Pharaoh kah khohmuen la poeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah Egypt khorhi a bawt neh a khat ben lamkah pilnam te amah loh khopuei khuila a puen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae khosoih rhoek kah khohmuen ngawn tah Pharaoh loh khosoih rhoek ham a paek khotlueh la a om dongah lai van pawh. Te vaengah khosoih rhoek loh Pharaoh kah a paek khotlueh te a caak uh tih a khohmuen te yoi uh pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah Joseph loh a pilnam la, “Tihnin ah namamih khaw, na khohmuen khaw Pharaoh ham ka lai coeng he. Tedae cangti he namamih ham lo uh lamtah khohmuen te tawn uh ngawn.
  </para>
  <para style="p">
    <verse number="24" style="v" />A vuei a thaih a om vaengah panga te Pharaoh taengah pae uh lamtah pali te namamih ham neh lohma kah cangti la, namah cako a caak ham neh na ca rhoek loh a caak ham khaw om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah, “Ka boeipa kah mikhmuh ah mikdaithen la m'hmuh uh tih mamih n'hlun atah Pharaoh taengah sal la ka om uh bitni,” a ti uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah Joseph loh a khueh oltlueh vanbangla tahae khohnin duela Egypt kho ah hlopnga te Pharaoh hut la om. Khosoih rhoek kah khohmuen bueng te amamih loh a hutnah tih Pharaoh hut la om pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah Israel loh Egypt kho kah Goshen khohmuen ah kho a sak tih a kawt la a kawt dongah pungtai uh tih muep ping uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jakob khaw Egypt kho ah kum hlai rhih hing tih Jakob kah a hingnah kum khohnin long khaw kum pasoi likip neh kum rhih lo coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah Isreal kah a duek ham khohnin loh a yoei coeng dongah a capa Joseph te a khue tih, “Nang mikhmuh ah mikdaithen ni ka dang atah ka phai hmuiah na kut tloeng laeh. Sitlohnah neh uepomnah khaw Kai ham na saii atah kai he Egypt kho n'up boel mai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah a pa rhoek taengah ka yalh atah kai he Egypt lamkah nan khuen vetih amih kah phuel ah nan up ni,” a ti nah hatah, “Na ol bangla kamah loh ka saii bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah, “Kamah taengah toemngam dae,” a ti nah hatah a toemngam tih Israel te baiphaih dongkah a lu taengah bakop.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tedae hekah olka a om phoeiah Joseph la, “Na pa te nue coeng ne,” a ti na uh hatah a ca rhoi Manasseh neh Ephraim te a caeh puei .
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Jakob la, “Na capa Joseph nang taengla ha pawk ke,” a ti nah tih a puen pah vaengah Isreal khaw thaa a huel tih baiphaih dongah ngol.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Jakob loh Joseph la, “Pathen Tlungthang loh Kanaan kho kah Luz ah kai taengla ha phoe tih kai yoethen m'paek vaengah,
  </para>
  <para style="p">
    <verse number="4" style="v" />kai taengah, “Kamah loh nang kam pungtai sak vetih kam ping sak vaengah pilnam hlangping la kan khueh ni. Khohmuen he khaw nang hnukah na tiingan taengah kumhal khohut la ka paek ni, ' a ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah nang taengah Egypt la ka pawk hlankah, nang loh Egypt kho kah na cun, na ca rhoi te, kai kah ni. Ephraim neh Manasseh khaw Reuben neh Simeon bangla kamah ca boeiloeih ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae amih rhoi phoeikah na sak na pacaboeina te tah namah ham om saeh lamtah a maya rhoi kah a ming neh a rho te thui thil saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai khaw Paddan lamkah ka bal vaengah kamah taengkah Rakhel loh Kanaan kho kah longpueng ah duek. Te vaengah Epharath la caeh ham khaw kho te a lak om pueng. Te dongah anih te Bethlehem Epharath long ah pahoi ka up,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Israel loh Joseph ca rhoi te a sawt tih, “Amih rhoi he ulae?,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Joseph loh a napa te, “Amih rhoi he Pathen loh he rhoek ah kai ham a khueh ka ca rhoi ni,” a ti nah. Te dongah, “Kai taengla han khuen rhoi lamtah yoethen ka pae rhoi pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel mik khaw kum loh a talh tih a hmuh hamla noeng voel pawh. Te dongah camoe rhoi te a taengla a thoeih pah. Te vaengah amih rhoi te a mok tih a kop.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Israel loh Joseph te, “Nang kah maelhmai hmuh ham pataeng ka thangthui voel pawt dae na ca rhoek khaw Pathen loh kai n'tueng coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah Joseph loh a napa khuklu dong kah a ca rhoi te a loh tih a tal neh diklai la bakop.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Joseph loh camoe rhoi te a khuen. Isreal kah banvoei benla khueh ham amah kah bantang kut dongah Ephraim, Isreal kah bantang benla a banvoei kut dongah Manasseh a mawt tih thoeih phai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Israel taengah a pha vaengah a noe Ephraim kah a lu vik te bantang kut a tloeng thil. Manasseh te a caming daeta a kut a cungvaeh tih Manasseh kah lu dongah banvoei kut a tloeng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Joseph te yoethen a paek tih, “A pa rhoek Abraham neh Isaak hmai ah aka caeh puei Pathen, tahae khohnin due ka hingnah boeih neh kai aka dawn Pathen,
  </para>
  <para style="p">
    <verse number="16" style="v" />Yoethaenah cungkuem lamkah kai aka tlan puencawn loh camoe rhoi he yoethenpae saeh lamtah, kai ming khaw, a pa Abraham neh Isaak ming khaw amih rhoi dongah phuk thil saeh. Diklai hman ah pungtai rhoi saeh lamtah ping rhoi saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Ephraim kah a lu ah a napa loh bantang kut a tloeng te Joseph loh a hmuh vaengah a mik lolh tih Ephraim lu dong lamkah Manasseh kah lu dong la thoeih ham a napa kut te a doek pah tih,
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph loh a napa la, “A pa tlam moenih, anih caming kah a lu dongah na bantang kut tloeng saw ,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae a napa loh a aal tih, “Ka ca ka ming, anih he pilnam la a om khaw ka ming. Te dongah anih khaw rhoeng ni. Tedae a mana a noe he anih lakah rhoeng vetih a tiingan te namtom hlangping la om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tekah khohnin ah amih rhoi te yoethen a paek hatah, “Nang rhang neh Pathen loh Isreal te a yoethen sak saeh, nang he Ephraim neh Manasseh bangla khueh saeh,” a ti nah tih Manasseh hmai ah Ephraim a khueh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Israel loh Joseph la, “Kai ka duek cakhaw nang taengah Pathen om vetih na pa kho la nang n'khuen bit ni ne.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah kamah loh Amori kut lamkah cunghang palaa neh ka lat khokong pakhat te na manuca rhoek kah a soah nang kan paek thil,” a ti nah.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Jakob loh a ca rhoek te a khue tih, “Tun ngol uh lamtah, vuenvai ah nangmih taengah aka thoeng ham te nangmih taengah ka puen pawn ni,
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob ca rhoek loh a yaak uh tih a coi uh thae vaengah, “Na pa Israel kah ol te ya uh van lah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reuben nang he ka caming tih, ka thadueng neh, ka thahuem cuek, hlangrhuel boeimang, hlangtlung hlangrhuel la na om dae,
  </para>
  <para style="p">
    <verse number="4" style="v" />Na pa kah tih thingkong sola na yoeng tih, ka rhaenghmuen te na poeih phoeiah, tui bangla na soetaenah dongah caknoi khaw na khueh mahpawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon neh Levi boeina, amih rhoi kah tubael tah kuthlahnah tumca ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amih rhoi kah tingtunnah dongah ka hinglu naepkhap pawh. Amah rhoi kah thintoek dongah hlang a ngawn rhoi tih vaito kaprhui haih ham te amih rhoi kah kolonah la a om dongah, kai kah thangpomnah loh amih rhoi a hlangping te bulbo boel saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amih rhoi kah a thinpom khaw a tlung dongah a thintoek te thae a phoei thil. Te dongah a mangkhak te Jakob taengah ka tael vetih Israel taengah khaw ka taekyak ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah nang he na manuca rhoek loh nang n'uem uh ni. Na kut te na thunkha a rhawn dongla cu ni. Na pacaboeina te nang taengah bakop uh ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah he sathueng ca ni. Ka ca loh maeh kung lamkah na bal phoeiah, sathueng neh sathuengnu bangla aka yuel tih, aka kol te ulong anih a haeng eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Judah lamkah mancai tah nong boel lamtah, a kho laklo lamloh taem saeh. Shiloh a pha duela anih taengah, pilnam kah boengainah om saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A laaktal, laaktal te misur dongah, a laak ca te cangsawt misur dongah pael saeh. A pueinak te misurtui dongah, a hnipup, hnipup te misur thii dongah til saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na mik khaw musurtui lakah ling vetih, na no te suktui lakah bok ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebulun he tuitunli kah langkaeng ah khosa saeh lamtah, langkaeng kah sangpho rhoek bangla a bawtnah loh Sidon due pha saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Issakhar he laak songrhuh bangla saelvong laklo ah na kol.
  </para>
  <para style="p">
    <verse number="15" style="v" />Duemnah then neh khohmuen hlahmae te khaw a hmuh dae, phueih te a laengpang ah a thueng tih aka thotat saldong la om ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan he Israel koca pakhat vanbangla a pilnam kah lai a thui pah ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan he long taengkah rhul neh marhang dongkah aka ngol te a hnuk la bung saeh tila marhang khomik aka maeng tih, caehlong rhulthae bangla om ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />BOEIPA nang kah khangnah ham ni ka lamtawn he.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gad he caem loh tloek cakhaw anih loh a khomik a tloek pah ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asher ham caak bae vetih, manghai buhmong a tael ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naphtali tah sayukrhuinu bangla khocaeh dangka vetih, ol then a thui ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph tah a ca loh thaihsu tih, a ca loh tuiphuet taengkah pungtai. Ngannu ngankhong loh pangbueng dongla luei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thaltang boei rhoek a konaeh uh dongah, a phaep uh tih a kah uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae Jakob kah samrhang kut rhang neh, Israel aka dawn lungnu rhang neh,
  </para>
  <para style="p">
    <verse number="25" style="v" />Na pa kah Pathen loh nang m'bom tih Tlungthang loh nang te vaan a sosang kah yoethennah, a laedil kah aka kol yoethennah nen khaw, a rhangsuk dongkah yoethennah nen khaw, a bung khuikah nen khaw yoethen m'paek dongah, a li khaw tangkuek la om tih, a kut bantha khaw caang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na pa kah yoethennah he kai aka yom kah yoethennah lakah len. Khosuen som ah a saelongnah hil Joseph lu so neh a manuca hlangcoelh luki soah om saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamin, uithang laihat loh , mincang ah maeh a ngaeh, hlaem ah kutbuem a tael,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />A pum boeih la Israel koca he hlai nit dongah a napa loh amih taengah a thui vaengah amah kah yoethennah neh amih te yoethen rhip a paek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah amih te a uen tih, “Kai he ka pilnam taengla ka khum atah a pa rhoek neh Khitti Ephron lo kah lungko ah n'up uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kanaan kho Mamre hmai, Makpelah lo kah lungko te phuel khohut la Khitti Ephron taeng lamkah Abraham loh a lai khohmuen ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ti ah te Abraham neh a yuu Sarah a up uh tih Isaak neh a yuu Rebekah te pahoi a up uh coeng. Leah khaw pahoi ka up coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah Kheth ca rhoek taeng lamkah te khohmuen boiva neh a khuikah lungko te,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jakob loh a ca rhoek a uen te a khah phoeiah baiphaih dongla a kho a yueh. Te phoeiah pal tih a pilnam taengla khoem uh.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah Joseph loh a napa maelhmai a bakop thil tih a soah a rhah neh a mok.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Joseph loh a napa te sihluk ham a sal siboei rhoek te a uen tih siboei rhoek loh Isreal te si a hlukuh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sihluknah khohnin te khohnin lipkip a di ham a om dongah khohnin a soep vanneh rhok te Egypt rhoek loh khohnin sawmrhih a rhah uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rhahnah khohnin a poeng vaengah Joseph loh Pharaoh im la, “Na mikhmuh ah mikdaithen ni ka dang atah Pharaoh kah hna kaep ah bet ka thui mai eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pa loh , 'Ka duek atah Kanaan kho ah kamah ham ka vueh tangtae phuel ah pahoi nan up ni, ' a ti tih kai he n'toemngam sak oeh dongah bet ka cet saeh lamtah a pa te ka up phoeiah ka bal mai eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pharaoh long khaw, “Na toemngam vanbangla cet lamtah na pa te up dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah Joseph te a napa up ham a caeh hatah Pharaoh kah sal boeih neh a im kah a hamca rhoek long khaw, Egypt kho kah a hamca boeih long khaw,
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph cako boeih neh a manuca rhoek long khaw, a napa cako long khaw a thak puei uh. Camoe neh a boiva, saelhung bueng te Goshen kho ah a caehtak uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah anih taengah aka cet te leng khaw, marhang caem khaw lambong yet la muep om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae Jordan rhalvangan kah Atad te a pha uh vaengah rhaengsaelung neh bungbung mat a rhaengsae uh tih a napa ham nguekcoinah te hnin rhih a yaeh uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Atad ah a nguekcoinah te Kanaan kho kah khosa rhoek loh a hmuh uh vaengah, “Hekah he Egypt rhoek loh mat a nguekcoinah ni,” a ti uh dongah Jordan rhalvangan kah a ming te Abelmizaim la a khue.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah a uen vanbangla Isreal ham a ca rhoek loh a saii uh tih,
  </para>
  <para style="p">
    <verse number="13" style="v" />Kanaan kho la a khuen uh. Te phoeiah Abraham loh phuel khohut la Khitti Ephron kah khohmuen Mamre ah a lai Makpelah lo kah lungko ah a up uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph neh a manuca rhoek khaw, a napa up ham anih taengah aka cet boeih long khaw a napa te aup phoeiah Egypt la bal uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae a napa a duek coeng dongah Joseph te a manuca rhoek loh a hmuh uh vaengah, “Joseph he mamih taengah a konaeh koinih anih taengah boethae n'saii uh boeih te n'thuung rhoe n'thuung ni,” a ti uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Joseph taengla ol a uen uh tih, “Na pa loh a duek hlan ah,
  </para>
  <para style="p">
    <verse number="17" style="v" />'Joseph te, 'Na manuca rhoek kah dumlai khaw, nang a thae la n'saii uh vaengakah tholhnah te khaw phueih mai ti nah,’ a ti tih n'uen dongah na pa Pathen sal rhoek kah boekoeknah te phuei mai,” a ti nah uh tih a thui uh vaengah Joseph rhap.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah a manuca rhoek khaw cet uh tih a hmai ah bakop uh tih kaimih he nang kah sal ni he a ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Joseph loh , “kai he Pathen hnukthoi a? Rhih uh boeh saw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangmih loh kai taengah boethae la nan taeng uh cakhaw Pathen loh tahae khohnin kah bangla pilnam muep hing sak ham te a then la a moeh coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah rhih uh boeh. Nangmih khaw, na ca rhoek khaw kan cangbam bitni,” a ti nah tih amih lungbuei te hloep ol a thui pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph khaw Egypt ah a napa kah a cako neh kho a sak. Te vaengah Joseph te kum pasoi neh kum rha hing.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Joseph loh Ephraim ca rhoek a khongthum duela a hmuh. Manasseh capa Makir ca rhoek khaw Joseph khuklu dongah a cun uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah Joseph loh a manuca rhoek la, “Kai ka duek cakhaw Pathen loh nangmih n'hip khaw n'hip vetih nangmih te tahae kah kho lamkah Abraham, Isaak neh Jakob ham a toemngam tangtae khohmuen la khuen bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Joseph loh Israel ca rhoek te a toemngam sak tih, “Nangmih te Pathen loh n'hip rhoe la n'hip vaengah he lamkah ka rhuh na khuen uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joseph he kum pasoi neh a lang a lo ca vaengah duek tih a rhok te si a hluk uh phoeiah Egypt kah thingkawng dongah a khueh uh.
  </para>
</usx>
