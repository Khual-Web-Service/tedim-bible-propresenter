<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="HEB" style="id">Hebrew</book>
  <para style="h">Hebrew</para>
  <para style="toc1">Hebrew</para>
  <para style="toc2">Hebrew</para>
  <para style="mt">Hebrew</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathen loh a pa rhoek te tonghma rhoek lamloh a hnukhmai la puet a voek dingrhae coeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae tahae kah hnukkhueng khohnin ah capa lamloh mamih taengah a thui. Anih te cungkuem aka pangkung la a hmoel tih lunglai te khaw anih rhangneh a saii.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih tah thangpomnah khosaeng neh a ngaikhueknah kah mueimae la om. A thaomnah olka neh a cungkuem a khoem. Tholh cimcaihnah a saii tih hmuen sang kah Boeilennah bantang ah ngol.
  </para>
  <para style="p">
    <verse number="4" style="v" />Heyet a then la aka om puencawn boeih lakah amih loh poekhloep la a ming a pang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mebang puencawn rhoek khaw, “Nang tah kamah ca ni. Kai loh tihnin ah nang kan sak, kai tah a napa la ka om vetih anih khaw ka ca la om ni,” a ti nah noek nim?
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah lunglai la camingomthang koep han khuen vaengah, “Pathen kah puencawn rhoek loh amah te boeih bawk uh saeh,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae puencawn rhoek ngawn tah, “Amah kah puencawn rhoek te khohli la, amah kah bibikung rhoek te hmai hmaitak la a saii,” a ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae capa te tah, “Aw Pathen, na ngolkhoel tah kumhal kah kumhal la cak tih na ram kah conghol tah duengnah conghol la om.
  </para>
  <para style="p">
    <verse number="9" style="v" />Duengnah te na lungnah tih olaeknah te na hmuhuet. Te dongah Pathen loh nang n'koelh. Na Pathen loh na pueipo lakah kohoenah situi n'koelh pai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah, a cuekca vaengah Boeipa nang loh diklai na tong tih vaan te namah kah kutngo ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amih tah poci vetih himbai bangla boeih rhuem ni. Tedae nang tah na nguel ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amih te hni bangla na yol vetih himbai bangla thovael uh bal ni. Tedae nang tah amah la na om tih na kum khaw bawt mahpawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah mebang puencawn rhoek taengah nim, “Na rhal rhoek te na kho kah khotloeng la ka khueh hlan atah kai kah bantang ah ngol,” a ti nah noek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khangnah te pang hamla aka cai rhoek te bibinah dongah a tueih, mueihla thothueng la boeih a om moenih a?
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah mamih loh n'yaak uh te taoe hnatung ham om. Vik n'hloo ve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Puencawn rhoek lamloh a thui olka tah khangmai la a om dongah boekoeknah neh althanah loh a taphu a yook te thuem.
  </para>
  <para style="p">
    <verse number="3" style="v" />Metla mamih loh te tluk aih la khangnah n'sawtrhoel te n'poenghal aya? Boeipa dong lamloh a thui bangla a tongcuek kah a dang khaw te loella. Aka ya rhoek long khaw mamih ham a cak sak coeng ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen kah miknoek nen khaw, khobae rhambae nen khaw, thaomnah cungkuem nen khaw, amah kah kongaih bangla a rhekrha Mueihla Cim nen khaw a phong coeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aka lo ham lunglai te puencawn rhoek taengah boengai sak mahnim. Te ni n'thui uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae pakhat loh hmuen pakhat ah laipai tih, “Hlang he metlam a om tih anih te na poek, hlang capa te khaw metlam a om tih anih te na hip.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih te puencawn rhoek lakah vel na hlak coeng dae thangpomnah neh hinyahnah te anih na khuem sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />A cungkuem te a kho hmuiah boe na ngai sak,” a ti. Te dongah a cungkuem te a taengah boe a ngai sak vaengah anih ham a hloh pah tih a paih om pawh. Tedae a cungkuem te anih taengah boe a ngai te tahae ah m'hmu uh hlan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae puencawn rhoek lakah tangat vel a hlak vaengah dueknah dongkah patangnah lamloh thangpomnah neh hinyahnah Jesuh a khuem sak te m'hmuh uh. Te daengah ni Pathen kah lungvatnah lamloh a cungkuem yuengla dueknah te a ten eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te tah amah ham tueng coeng.A cungkuem tah amah ham neh a cungkuem te amah lamloh om coeng. Patangnah lamloh amih kah khangnah rhuihnun te soep sak ham thangpomnah khuila ca rhoek te muep a khuen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka ciim sak neh aka ciim rhoek tah pakhat kah boeih ni. Te paelnaehnah nen tah amih te manuca rhoek la khue ham yak pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah, “Na ming te ka manuca rhoek taengah ka puen vetih, hlangboel lakli ah nang kan hlai ni,” a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah, “Kai loh amah te ka pangtung ni,” koep a ti. Te phoeiah, “Kai neh Pathen loh kai m'paek camoe rhoek he,” a ti bal.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah camoe rhoek loh thii neh pumsa a boek uh coeng. Amah long khaw amih bangla a cabol coeng. Te daengah ni thaomnah aka khueh dueknah te dueknah lamloh a hmil eh. Te dueknah tah rhaithae ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah ni a hing khui sal aka bi kuekluek ham rhoek te dueknah rhihnah lamloh boeih a hlah eh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Puencawn rhoek te rhep tu pawt tih Abraham kah tiingan ni a. tuuk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah manuca rhoek te boeih thuidoek ham a kuek. Te daengah ni pilnam kah tholhnah dawth pah hamla Pathen taengah rhen koi neh uepom khosoihham la a om eh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah loh patang khaw amah la a noemcai coeng dongah a noemcai rhoek te a bom thai coeng.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah vaan kah khuenah neh pueipo, a cim manuca rhoek, mamih olphoei dongkah caeltueih neh khosoihham Jesuh te hmat uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih te Moses bangla a im pum ah uepom neh aka om la a khueh van.
  </para>
  <para style="p">
    <verse number="3" style="v" />Im aka rhoekbah loh hinyahnah cungkuem a khueh ngai bangla anih tah Moses lakah thangpomnah muep a tueng pah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Im boeih he khat khat loh a rhoekbah dae Pathen loh a cungkuem te a rhoekbah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae a im pum kah uepom Moses tah laipainah ham te tueihyoeih bangla a thui uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Khrih tah amah im ah capa bangla om tih mamih khaw sayalh la ngaiuep thangpomnah te rhep n'tuuk uh atah a im kah la n'om uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah Mueihla Cim loh a thui vanbangla, Tihnin ah a ol te na yaak uh atah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Khosoek ah noemcainah khohnin kah koeknah bangla na thinko te ning sak uh boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te ah te na pa rhoek loh noemcainah neh a n'noemcai uh dongah kum sawmli khuiah kai kah khoboe te a hmuh uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah tekah cadil rhoek te ka noih tih, 'Amih loh thinko a taengphaelh uh taitu dongah ka longpuei te ming uh pawh,’ ka ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka kosi neh ka toemngam vanbangla kai kah duemnah khuiah kun uh mahpawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manuca rhoek, ngaithuen uh. Aka hing Pathen taeng lamkah aka nong sak hnalvalnah thinko thae te nangmih ah khat long khaw khueh ve ne.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae tihnin ah n'khue vanbangla hnin takuem amah la hloep uh thae. Te daengah ni tholhnah dongkah hmilhmaknah dongah nangmih khuikah pakhat long khaw a ning pawt eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Khrih kah a pueipo la n'om uh daengah ni ngaikhueknah kah a tongnah te a bawt due a khangmai la n'tuuk uh eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A thui bangla tihnin ah a ol te na yaak uh atah koeknah vaengkah bangla nangmih kah thinko te ning sak uh boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />A yaak uh lalah aka koek te unim? Tedae Moses loh Egypt lamkah a caeh puei rhoek boeih moenih a?
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah kum sawmli a noih te unim? Aka tholh rhoek taengah moenih a? Amih kah a pum tah khosoek ah la a yalh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah ol aek rhoek pawt koinih amah kah duemnah khuila kun pawt ham a toemngam te unim?
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah hnalvalnah neh kun ham tah coeng uh mahpawh tila m'hmuh uh.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah amah kah duemnah khuiah kun ham olkhueh a paih te nangmih khuiah khat khat loh a hlavawt la a poek khaming tila birhih uh sih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amih bangla olthangthen aka phong lam ni n'om uh ngawn. Tedae a yaak rhoek te tangnah neh a rhoih uh pawt dongah a hnavue kah olka tah phu voel pawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ti bangla aka tangnah rhoek tah duemnah khuila n'kun uh. Ka kosi neh ka toemngam vanbangla kai duemnah khuiah kun venim. Te cakhaw Diklai a tongnah lamloh a bibi te ana om coeng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah pakhat ah hninrhih ham a thui tangloeng. Te vaengah Pathen tah a bibi boeih lamkah hnin rhih vaengah duem.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah amah hmuen la, “Ka duemnah khuiah kun uh mahpawh,” koep a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah a khuila kun ham hlangvang a khueh tangloeng pueng. Tedae hnukbuet kah aka phong rhoek tah althanah dongah kun uh pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah khohnin pakhat te “Tihnin “la a hoep tih kum heyet phoeiah ni David loh a thui. A thui bangla tihnin ah a ol te na yaak uh atah nangmih kah thinko te ning sak uh boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Joshua loh amih te a duem sak atah hekah khohnin phoeiah a tloe ham tah thui mahpawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah duemhnin tah Pathen kah pilnam ham ni a. om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah amah kah duemnah khuiah aka kun tah Pathen loh amah bibi lamkah a duem vanbangla anih khaw amah bibi lamkah duem.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah tekah duemnah khuiah kun hamla haam uh sih. Te daengah ni althanah moeiboe dongah pakhat khaw amah la a bung pawt eh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Pathen kah olka tah hing tih khuekcet. cunghang boeih lakah voeivang la haat tih hinglu neh mueihla, rhuhcong neh hliing, duela a thun tih a sah. Thinko poeknah neh hmuhnah khaw khocueh rhamvueh la a khueh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amah hmaikah a thuhphah suentae a om moenih. Tedae a cungkuem he a tlingyal neh a mikhmuh ah rha uh coeng. Anih taengah mamih ol te a paek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khosoihham koek, vaan aka hil la Pathen Capa Jesuh n'khueh uh te olphoei la pom uh sih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mamih kah vawtthoeknah aka rhen thai mueh khosoihham n'khueh uh moenih. A cungkuem dongah mamih mueiloh la a noemcai coeng dae tholhnah a khueh moenih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah lungvatnah ngolkhoel taengah sayalh la paan uh sih. Te daengah ni rhennah n'dang vetih bomnah he tapkhoeh la lungvatnah neh m'hmuh eh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlang lamkah a tuek khosoihham boeih tah Pathen taengah hlang yuengla a tuek. Te daengah ni nawnnah neh tholh yuengla hmueih khaw a hlut.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mangvawt rhoek neh taengphael rhoek te a rhen thai dongah amah khaw vawtthoeknah neh vueinan uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah tholh kongah nawn ham te pilnam ham neh amah ham khaw a kuek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah khat khat loh a thangpomnah te a loh moenih. Tedae Aaron bangla Pathen long ni a. khue van.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khrih khaw khosoihham la om ham amah neh amah a thangpom tangloeng moenih. Tedae anih te, “Nang tah ka ca la na om tih tihnin ah kai loh nang kan sak coeng,” aka ti long ni a thangpom.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vanbangla a tloe ah khaw, “Nang tah Melkhizedek kah aitlaeng bangla kumhal due na khosoih coeng,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amah loh a pumsa la a om tue vaengah, rhenbihnah neh bihnah khaw, duek lamkah anih aka khang thai taengah, mikphi neh rhungrhahnah neh a tloh la a nawn daengah ni hinyahnah neh a hnatun pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />A capa la om dae a patang neh olngainah te a cang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah dungyan khangnah a hnun la a ol aka ngai rhoek boeih taengah rhuemtuet la a om pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Melkhizedek kah aitlaeng bangla Pathen loh khosoihham la a khue coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih kah olka tah mamih taengah cung coeng dae hnavue te kolhnaw la a om dongah ka thuicaih tloel.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tue loh saya la om ham a kuek coeng dae Pathen kah olrhuh a tongnah kah a niing te pakhat loh nangmih koep n'thuituen na ngoe uh. Te dongah buh hap mueh la suktui aka ngoe la na om uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Suktui aka cabol boeih tah cahmang la om tih, duengnah olka dongah cakongcahai la om.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae lungcuei tah buh hap a om pah coeng. Te rhoek kah hmuhtoeihnah rhangneh yaknganah te a hlinsai uh dongah a thae neh a then khaw boelhkhoehnah khueh uh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah Khrih kawng tongnah olka te khueh uh sih. A soepnah la thoeih uh sih. Aka duek bibi lamkah yutnah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen taengah tangnah, baptisma kawng thuituennah, kut tloengnah, aka duek thohkoepnah neh dungyan laitloeknah, khoengim te koep tloeng uh boel sih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hekah he Pathen loh ham hmoel atah n'saii uh bitni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vai khaw kho aka hmuh tih vaan kutdoe khaw aka ten, Mueihla Cim kah pueipo la aka om tangtae neh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen kah olka then neh aka lo ham tue kah thaomnah a ten phoeiah,
  </para>
  <para style="p">
    <verse number="6" style="v" />aka bung tah Pathen capa te amah la koep a tai tih a yan dongah a thai la koep yutnah ham coeng thai pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Diklai loh a soah rhotui aka tla takuem te a ok dae amih aka tawn ham aka hoeikhang toi an a thoeng sak atah Pathen taengah yoethennah a dang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae hling neh lota a thoeng sak atah lolhmaih tih rhunkhuennah yoei coeng. A hnukkhueng ah tah a hoehnah hamla om coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae thintlo rhoek, nangmih ham n'thui uh tangloeng ngawn koinih khangnah neh aka then ngai hno te om tila n'ngaitang uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathen tah nangmih kah bibi neh amah ming ham lungnah na tueng sak uh te khaw, hlangcim rhoek te na bongyong uh coeng tih na bongyong uh li te hmaai ham a halang moenih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae nangmih khat rhip te a bawt duela na ngaiuepnah dongkah ngaikhueknah dongla thahluenah neh amah la na phoe uh hamla ka ngaih uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te daengah ni kolhnaw la na om uh pawt vetih tangnah, thinsennah rhangneh olkhueh aka pang rhoek kah mueiloh la na om uh eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathen loh Abraham te a caeng vaengah toemngam ham a tanglue a khueh pawt dongah amah neh amah te toemngam uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah, “Nang te kang uem rhoela rhep kang uem vetih nang te kam ping rhoela kan ping sak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah olkhueh te thinsen neh a dang tangloeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlang loh a tanglue la a toemngam dae olhlo a caksaknah ham a bawt ah pakainah la boeih om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te khuiah Pathen loh olkhueh dongkah rhopangkung taengah amah kah mangtaengnah olhlo neh khangmai la rhi a khang te muep tueng a ngaih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te daengah ni hno panit loh a khangmai sak. Te khuiah Pathen te laithae thai pawt dongah ni ngaiuepnah a tawn te tuuk ham aka yong rhoek loh khangmai la thaphohnah n'khueh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te ni hinglu dongkah cumkai la n'khueh uh tih hniyan khui ah khangmai la rhep kun rhenten coeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te ah mamih yueng puencoe la Jesuh kun tih Melkhizedek kah aitlaeng bangla kumhal ah khosoihham la om coeng.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khohni Pathen kah khosoih, Salem manghai Melkhizedek loh, manghai rhoek tloeknah lamkah aka bal Abraham te a doe tih a uem.
  </para>
  <para style="p">
    <verse number="2" style="v" />A cungkuem lamkah parha ah pakhat te khaw Abraham loh anih a boe. Khatben ah lamhma la, duengnah manghai neh Salem manghai khaw a thuingaih coeng. Te tah ngaimongnah manghai ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pamueh numueh, rhuirhong mueh, a khohnin a tongnah om pawt tih hingnah a bawtnah khaw khueh pawh. Tedae Pathen capa la om tih kumhal ah khosoih la naeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Patuel Abraham long pataeng a kutbuem khuikah parha pakhat a paek atah anih khaw bahoeng len tila hmu uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Levi ca rhoek long tah a khuikah khosoih te a dang. Olkhueng vanbangla pilnam taengah parha pakhat coi nah olpaek khaw a khueh uh. Tedae Abraham pumpu lamloh ha thoeng boeiloeih tih a manuca la om.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae amih kah rhuirhong mueh loh Abraham taengkah parha pakhat a doe tih olkhueh aka dang te a uem.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah a then loh mathoe a uem te boeih pakainah moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah hlang duek loh parha pakhat te a dang dae hing tila pahoi a phong pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah olka a thui vanbangla Abraham lamlong ni Levi long khaw a doe parha pakhat te a dang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Melkhizedek loh anih a doe vaengah Levi he a napa kah a pumpu ah ni a. om pueng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi khosoih lamloh hmakhahnah a om tangloeng atah pilnam loh amah soah ol a rhi coeng. Melkhizedek kah aitlaeng bangla a tloe khosoih aka phoe taengah banim a ngoe pueng? Aron kah aitlaeng bangla khue pawt nim?
  </para>
  <para style="p">
    <verse number="12" style="v" />Khosoih bi te a thovael vaengah olkhueng kah thovaelnah khaw a kueknah om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amah kawng a thui uh he khaw a tloe koca taengah cabol coeng. Te lamkah te tah hmueihtuk aka ngaithuen moenih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah mamih kah Boeipa te Judah lamkah ha thoeng te lohaa coeng. Tekah koca ham khosoih bi te Moses loh ana thui moenih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah a cimphan la muep om pueng. Melkhizedek kah mueiloh bangla khosoih a tloe a phoe mak atah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih tah pumsa olpaek kah olkhueng dongah om pawt tih aka nguel hingnah kah thaomnah dongah ni a om.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Nang tah Melkhizedek kah aitlaeng bangla kumhal ah na khosoih coeng,” tila a phong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Olpaek lamhma he tattloel tih a hloo dongah a hnawt a khoe la poeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Olkhueng loh soep sak pawt dae ngaiuepnah then ham rhoekbahnah la om. Te nen ni Pathen taengla n'yoei uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te tlam khaw olhlonah tal aih pawt dae, amih tah olhlonah om muehla khosoih a bi uh ngawn ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae te lamloh olhlonah neh amah te, “Boeipa loh a toemngam coeng dongah yut pawt tih kumhal duela na khosoih coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Heyet lamlong tah Jesuh he paipi then kah rhi aka khang la om coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah aka nguel ham te duek loh a kanghalh dongah khosoih la aka om rhoek khaw muep lo uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae kumhal duela aka naeh tih a cak la aka om khosoih khaw amah ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah anih lamloh Pathen aka paan rhoek khuek a khang thai bal. A yoeyah la hing ham te amih yueng la huithui coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tebang hlangcim, ommongsitoe, aka cuem, hlangtholh taeng lamloh aka hoep uh, vaan sang la aka om tah mamih kah khosoihham lam khaw rhoep tloe pai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih tah khosoihham rhoek bangla a kueknah te hnin takuem a khueh moenih. Lamhma kah long tah amah kah tholhnah ham hmueih nawn. Te phoeikah rhoek ni pilnam ham pueng. Hekah long tah amah te bangtlang saii uh tih a nawn.
  </para>
  <para style="p">
    <verse number="28" style="v" />Olkhueng loh vawtthoeknah aka om hlang te khosoihham la a tuek. Tedae olkhueng hnukah olhlonah ol loh capa te kumhal duela a soep sak coeng.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tebang khosoihham ng'khueh uh te a cuinah la n'thui coeng. Anih tah vaan kah Boeilennah ngolkhoel bantang ah ngol.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmuencim neh dap tang kah bibikung la om. Te te hlang long pawt tih Boeipa long ni a. tuk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khosoihham boeih te kutdoe neh hmueih nawn ham a tuek. Pakhat khaw a khueh tangkik coeng dongah tekah te khaw nawn saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Diklai ah om tangloeng ngawn koinih khosoih la ka om eh a ti moenih. Olkhueng dongah kutdoe aka nawn rhoek lam ni a om uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amih loh vaan kah moeiboe neh mueihlip te a bawk uh. Moses loh dap a coeng tom a mangthui pah. A hmuh dongah, “Tlang dongkah nang kan tueng bangla a mueimae boeih saii,” a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae thothueng tanglue a dang coeng. Paipi dongah rhikhangkung aka then lam khaw muep om. Te long te a then la olkhueh ol a rhi thil.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lamhma te cuemthuek la om koinih a hmuen pabae tlap mahpawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae amih te a coel dongah, “Khohnin ha pawk coeng ke,” a ti. Boeipa loh , “Israel imkhui ah khaw, Judah imkhui ah khaw paipi thai ka thoh ni,” a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amih kut te ka tuuk tih Egypt kho lamloh amih ka doek hnin vaengkah a napa rhoek taengah ka saii paipi bang te moenih. Amih tah kai kah paipi dongah a ngol pai uh pawt dongah kai long khaw amih te ka sawtrhoel. Boeipa loh a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hekah paipi tah te khohnin phoeiah ni Israel imkhui ah ka saii eh. Boeipa long ni a thui. Ka olkhueng he a kopoek ah ka paek vetih amih thinko ah ka daek pah ni. Te vaengah amih taengah Pathen la ka om vetih amih khaw ka pilnam la om uh ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah pakhat rhip loh a pilnam te khaw, pakhat rhip loh a manuca te khaw, “Boeipa te ming lah,” a ti nah vetih thuituen uh loengloeng mahpawh. Amih tanoe lamkah kangham duela kai boeih m'ming uh ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amih kah boethae te poekpoei rhola la ka om pah vetih amih kah tholhnah te ka poek khuep voel mahpawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A thai a thui rhang neh paipi lamhma te a rhuem sak. Te dongah a rhuemrho neh a rhuemrho tah khum tom coeng.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lamhma loh thothuengnah rhilam neh diklai hmuencim khaw rhep om tangloeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dap ana rhoekbah tih a khuiah lamhma la hmaitung, caboei, a hmai vaidam te om. Te te hmuencim a ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dap khuikah hniyan pabae phoeikah te tah hmuencim boeih kah hmuencim ana ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sui rhokso neh a kaeng boeih sui neh a khuk Paipi thingkawng te om tih a khuiah manna aka om sui am, Aaron kah conghol aka muem, paipi lungphaih te om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te soah thangpomnah cherubim loh dawthnah te a khu. Te te a cungvang la tahae ah thui ham om pawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae te kah te a rhoekbah tangloeng coeng. Khosoih rhoek tah dap lamhma khuila vawp vawp ana kun uh yoeyah daengah thothuengnah te ana coeng uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae a pabae khuiah tah khosoihham bueng loh kum khat ah vai a kun te thii nen voel moenih. Te nen te amah neh pilnam kah mangvawtnah yuengla a nawn.
  </para>
  <para style="p">
    <verse number="8" style="v" />He he Mueihla Cim loh a thuicaih ta. Olpungnah dap lamhma te a om pueng atah hmuencim kah longpuei te a khui moenih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te tah a tue ham nuettahnah la ha pai coeng. Te vanbangla kutdoe neh hmueih a khuen loh tho aka thueng te mingcimnah a soep sak thai moenih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Caak ham neh ook ham, cilpoenah soeprhaep sokah pumsa kah rhilam te thovaelnah tue hil tah lalh pueng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Khrih tah kut neh saii mueh, aka soep neh tanglue dap Tekah te hekah suentae khuikah moenih ah hno then la aka thoeng kah khosoihham la ha pawk coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Maae neh vaito thii nen pawt tih amah thii neh dungyan tlannah dang ham hmuencim ah kun bangtlang coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maae, vaito thii neh vaitola kah a hloi te aka poeih uh rhoek loh pumsa kah cimcaihnah ham a phul uh tih a ciim atah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Khrih kah thii tah bahoeng voel a. Amah tah Mueihla rhangneh Pathen taengah cuemthuek la dungyan amah nawn uh coeng. Te aka hing Pathen taengah thothueng ham khoboe aka duek lamloh mamih kah mingcimnah he a cilpoe pawn ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah paipi thai kah rhikhangkung la om tangloeng. Te daengah ni dueknah he boekoeknah paipi lamhma hmuiah tlannah la thoeng vetih olkhueh te dungyan rho la a khue rhoek loh a dang eh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Paipi te tah aka tael kah a dueknah te tueng sak ham a kueknah om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Paipi tah a duek thil daengah ni a khangmai. Akai saii te a hing vaengah tah khangmai pawt mai khaming.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah lamhma kah paipi he thii muehla a cak sak moenih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Olpaek boeih te olkhueng dongkah bangla Moses lamloh pilnam boeih taengah a thui coeng. Vaito neh maae thii, tui neh tumul a nukyum, pumpiding te a khuen tih cayol khaw pilnam boeih te khaw a haek thil.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah, “He tah Pathen loh nangmih taengah n'uen paipi dongkah thii ni,” a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah dap te khaw, thothueng kah tubael boeih khaw thii neh a haek thil bal.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah olkhueng vanbangla thii loh a cungkuem a cim sak banghui tih thiilongnah pawt atah khodawkngainah om pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Moeiboe te vaan kah nen he cilpoe ham a kueknah om tangloeng. Tedae amih vaan kah rhoek te tah tahae kah hmueih lakah aka then neh a cimcaih sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khrih tah oltak kah mueimae kutsai hmuencim la a kun moenih. Tedae amah te vaan kah Pathen mikhmuh ah mamih yueng la phoe coeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te daengah ni khosoihham loh kum takuem hmuencim ah hlanglang thii neh a kun bangla amah pum a nawn taitu pawt eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te koinih Diklai a tongnah lamloh khing a patang ham a kuek ni. Tedae tahae ah tah amah kah hmueih lamloh tholh khoe ham kumhal kah a bawtnah dongah rhenten phoe coeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hlang he vai a duek phoeiah laitloeknah khaw a tong vanbangla,
  </para>
  <para style="p">
    <verse number="28" style="v" />Khrih long khaw a yet kah tholh te phueih ham vaikhat la a nawn coeng.Te dongah a pabae ah tah tholh om muehla amah aka lamtawn rhoek taengah khangnah khuen ham phoe ni.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Olkhueng tah aka lo ham hno then kah mueihlip la om tih anih te hno taktak kah muei moenih. Kum takuem ah hmueih te amah la a nawn uh dae a soep la phat paan sak thai pawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te koinih hmueih a nawn te bawt tlaih mahpawh. Te dongah vaikhat thothueng neh a cim sak te tholhnah dongah mingcimnah khueh voel mahpawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae kum takuem tholh poekkoepnah amih ah aka om te,
  </para>
  <para style="p">
    <verse number="4" style="v" />vaito neh maae thii loh tholh a khoe tloel dongah ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Diklai la aka kun loh , “Hmueih neh nawnnah na ngaih moenih. Tedae namah pum te kai ham na hmoel.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tholh dongah hmaihlutnah khaw na lungtlun uh pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah, 'Ka pawk coeng ne, Pathen na kongaih saii hamla kai kawng te cayol awn dongah a daek,’ ka ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />A sokah hmueih khaw nawnnah hmaihlutnah khaw tholh kongah na ngaih pawt tih na lungtlun pawh tila ka thui. Te te olkhueng bangla a nawn rhoek ni,” a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah, “Namah kongaih saii ham ka pawk coeng he,” a ti. Lamhma te a thup daengah ni a. pabae te a thoh pai eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kongaih loh Jesuh Khrih kah pum te a nawn bangtlang dongah a ciim la n'om uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah khosoih boeih loh hnin takuem pai tih tho a thueng vaengah amah la hmueih a nawn taitu dae te long te tholh a khoe thai moenih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae amah loh tholhnah yueng vaikhat la hmueih a nawn tih Pathen kah bantang ah kumhal la ngol coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te lamkah a tloihsoi ah a rhal te a kho kah khotloeng la a khueh duela a rhing.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vaikhat la nawnnah lamloh te rhoek te kumhal due rhuemtuet la a ciim sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah Mueihla Cim long khaw mamih taengah a phong.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah, “He paipi tah te khohnin phoeiah ni amih taengah ka hal eh?,” a ti. Boeipa loh , “Ka olkhueng he amih thinko ah ka paek coeng tih amih kopoek ah ka daek ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah amih kah tholh neh olaeknah te ka poek khuep voel mahpawh,” a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih kah khodawkngainah tah melae? Tholh ham hmueih a om pawt ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah, manuca rhoek , Jesuh thii rhang neh hmuencim ah kunnah ham sayalh la om coeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tekah hniyan lamloh mamih ham aka hing longpuei thai a ong coeng. Te tah amah pum ni a. thui.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Pathen im kah khosoih puei n'khueh uh coeng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tangnah kah ngaikhueknah dongah thinko oltak neh paan uh sih. A thae la mingcimnah thinko te haek uh sih lamtah pum te tui cil neh tuihlu uh sih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ol aka caeng kung te a uepom dongah aka cak ngaiuepnah dongkah olphoei mah pom uh sih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah lungnah, bibi then dongah umyanah ham khat neh khat hmat uh thae sih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mamih kah humtunnah he pakhat kah khosing bangla phap uh boel lamtah hloep uh thae. Heyet khaw khohnin a yoei te boeih na hmuh ngai coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Oltak kah mingnah te n'dang phoeiah mamih he kalthalh la n'tholh he tholh hlah ham hmueih a om moenih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae laitloeknah mueirhih neh aka kingkalh te dolh ham aka cai kosi hmai pakhat ni a. lamtawnnah coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khat khat loh Moses kah olkhueng te a aal vaengah sitlohnah om kolla panit pathum kah laipai neh duek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathen capa aka suntlae rhoek loh tholhphu a thae la muep a yook ham te na poek uh nim. Te nen la a ciim dae, paipi dongah thii te rhalawt la a poek dongah lungvatnah Mueihla ni a hnael.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Kutthungnah he kai kah, ka sah bitni,” a ti khaw m'ming. Te phoeiah Boeipa loh a pilnam te lai a tloek pueng ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aka hing Pathen kut ah cungku te mueirhih la om.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah hnukbuet kah a tue te thoelh uh. Te vaengkah loehlangnah muep aka hmuh loh patangnah te ueh uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />A ngen vaengah hnaelcoenah neh phacip phabaem neh a yan uh. A ngen vaengah tebang khosa rhoek kah pueipo la na om uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thongtla rhoek te khaw na rhen uh. Nangmih kah khuehtawn te halhkanah neh aka rhawt khaw omngaihnah neh na doe uh. Khuehtawn then neh aka kuei amah a om te na ming uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah na sayalhnah te voei uh boeh. Te long te taphu a len a khueh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Uehnah uh ham he a ngoe. Te daengah ni Pathen kah kongaih aka saii loh olkhueh te na dang uh eh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kolkalh pueng ah aka pawk long tah boeih boeih ha pawk vetih koe mahpawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae ka hlang dueng tah tangnah neh hing ni. Te vaengah tonga koinih anih soah ka hinglu loh a lungtlun mahpawh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mamih tah pocinah ham tonganah pawt tih hinglu dangnah ham tangnah n'khueh uh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hmuethma hmuh pawt hno dongah ngaikhueknah neh n'ngaiuep he ni tangnah la aka om coeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />He nen ni a. ham rhoek long khaw a phong uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmuh mueh lamkah hmuh koi la coeng sak ham Pathen kah olka loh lunglai a tarhoek tila tangnah neh n'yakming uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tangnah neh Abel loh Kain lakah Pathen taengah hmueih muep a nawn. Te lamlong tah hlang dueng ni tila ana oep. Pathen kah a kutdoe te ana oep dongah aka duek long khaw tangnah neh a thui pueng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tangnah rhangneh dueknah te hmuh pawt ham Enok tah a thovael sak. Tedae Pathen loh a tholvael dongah anih te hmu voel pawh. Thovaelnah a om hlanah mah Pathen taengkah kolo neh ana oep coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae tangnah mueh la kolo n'tong thai pawh. Pathen aka paan loh amah tah om tih amah aka tlap rhoek te taphu om tila a tangnah a kuek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Noah loh a hmuh pawt te a mangthui vaengah a hinyah tih tangnah neh amah cako khangnah ham sangpho te a rhoekbah. Te nen te Diklai a boe sak tih tangnah neh duengnah rhopangkung la coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tangnah neh a khue vaengah rho la pang aka cai hmuen te paan ham Abraham loh a ngai. Te vaengah mela a caeh khaw a ming mueh lam ni a caeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tangnah neh hlanglang la olkhueh ram ah kuepkol. Olkhueh, amah hmuen aka pang Isaak neh Jakob khaw dap ah kho hmaih a sakuh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah khoengim a khueh tangtae khopuei te ni a. lamtawn. Pathen tah te khopuei kah kutthai neh rhaengpuei ham bibikung la om.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cayaa Sarah amah long khaw a pumrho neh a tuetang kah a voelah a tiingan a tongnah ham thaomnah te tangnah neh a dang. Te khaw aka caeng te uepom la a poek dongah ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah pakhat lamlong khaw muep thaang coeng.Aka duek he khaw vaan kah aisi yet la, tuili kaeng kah laivin bangla n'taetloel coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amih rhoek boeih loh tangnah neh duek uh. Olkhueh te dang uh pawt dae a hla lamkah a dan uh tih a doe uh. Te phoeiah diklai ah yinlai neh lampah ni tila a phong uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tebang aka thui rhoek loh a tolrhum a ngaidam uh te a phoe uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae te lamkah ha suntlak uh te poek uh ngawn koinih a voei uh tue khaw a khueh uh suidae.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae vaan ah a then ngai aka om te a ngaidam uh coeng. Te dongah amih loh Pathen te amamih kah Pathen la khue ham yak uh pawh. Amih ham kho pakhat a rhoekbah pah coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham te a noemcai vaengah tangnah neh Isaak te a nawn tih khueh duen aka nawn la olkhueh te a dang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih ham te, “Nang kah tiingan te Isaak dongah a khue,” tila a thui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathen loh aka duek rhoek lamkah pataeng a thoh thai tila ana poek coeng. Te lamkah ni anih te nuettahnah lam khaw a dang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangnah nen ni lo ham aka cai Jakob neh Esau kawng khaw Isaak loh a uem.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tangnah neh Jakob loh a duek tom vaengah Joseph ca rhoek te rhip a uem tih a conghol soi ah a bawk.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tangnah nen ni Joseph loh a duek tom ah Israel ca rhoek kah sunglatnah kawng te a poek tih a rhuh kawng te a uen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tangnah nen ni Moses te a napa loh a thaang neh hla thum ana thuh. Camoe te sakthen la a hmuh uh vaengah manghai kah oltloek te rhih uh pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tangnah nen ni Moses loh lungcuei la a om vaengah Pharaoh canu kah a capa a ti nah te a aal.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kolkalh ham tholhnah neh omngaihbawnnah khueh lakah Pathen kah pilnam te patang puei ham lat a tuek.
  </para>
  <para style="p">
    <verse number="26" style="v" />Taphu te a lamso dongah Khrih kah hnaelcoenah te Egypt kah khohrhang lakah khuehtawn tanglue la a poek.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tangnah neh Egypt a hnoo tih manghai kah thinsanah te rhih pawh. Hmuhmueh hmuh bangla a ueh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tangnah neh yoom neh thii haek te a saii. Te daengah ni camingomthang aka ngawn loh amih te a ben pawt pai eh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tangnah neh Tuili Sen te lan long bangla phueihuet la a hlaikan uh. Te te dang ham aka cai Egypt rhoek tah buek uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tangnah neh Jerikho pangbueng te hnin rhih khuiah a vael uh vaengah tim.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tangnah neh hlanghalh Rahab loh rhalyuep rhoek te ngaimong la a doe dongah ol aek rhoek taengah poci pawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te phoeiah balae ka thui pueng eh? Gideon, Barak, Samson, Jephthah, David neh Samuel neh tonghma rhoek tue kah a kawng thui ham ka hlavawt pueng.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amih loh tangnah neh ram khaw a na, duengnah te a saii, olkhueh a pang, sathueng ka a buem uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hmai kah thaomnah a thih, cunghang ha khaw a rhaelrham tak, thahnoeng lamkah a thaphoh, caem vaengah hlang tlung la coeng, hlanglang caem khaw a thup uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thohkoepnah neh huta rhoek loh amamih kah aka duek tangtae te a dang uh. Tedae a ngen loh aka then ngai thohkoepnah dang ham tlannah te doe mueh la phaep uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />A ngen tah tamdaengnah neh noemcainah nganboh a yook uh bueng kolla hloong neh thongim khaw a yookuh.
  </para>
  <para style="p">
    <verse number="37" style="v" />A dae uh, a ah uh, cunghang kah ngawnnah neh duek uh. A vawtthoek, patang palai la a hnaep uh. Tupho, maae pho neh poengdoe uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Diklai tah amih neh a tiing la a om moenih. kohong ah, tlang ah, lungko ah, diklai khui ah poengdoe uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae amih tangnah neh aka phong boeih loh olkhueh te a dang uh moenih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Pathen kah a rhan te pakhat khaw mamih ham a then, daengah ni mamih pawt atah a rhuemtuet uh pawt eh.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah mamih khawm ta, laipainah khomai tah mamih aka thing la heyet ana om coeng ta. Hnorhih neh tomban tholhnah te boeih khoe uh. Mamih he thingthuelnah ah n'tawn vanbangla uehnah neh yong uh sih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tangnah hmapaikung neh hmakhapkung Jesuh te hmaitang uh sih. Anih loh omngaihnah a tawn coeng dongah yahpohnah thinglam te a hnaep tih a ueh phoeiah Pathen kah ngolkhoel bantang ah ngol.
  </para>
  <para style="p">
    <verse number="3" style="v" />hlangtholh rhoek lamloh amah a pakainah thil a ueh te poek uh. Te daengah ni na hinglu te tawnba neh na ko a bawt pawt eh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tholhnah aka hnuei rhoek te a thii hil na oel uh hlan.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka ca rhoek bangla nangmih m'voek tih, 'Ka ca,’ tila thaphohnah te na hnilh uh. Boeipa kah hlinsainah te hnoelrhoeng boeh. Amah loh n'toeltham vaengah yawk boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Boeipa loh a lungnah te a toel tih ca la a doe boeih te a boh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathen loh nangmih te ca la n'bawnhlak bangla hlinsainah khaw ueh uh. Ca aka toel pawh napa te unim?
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae tekah hlinsainah na khueh uh pawt atah halhca la boeih om tih ca la na om uh pawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah ngawn tah pa rhoek te mamih pumsa hlinsaikung la n'khueh uh tih n'yahnah uh. Te dongah mueihla kah pa taengah taoe boengai neh taoe hing boel sih a?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amih long tah khohnin kolkalh ham a poek uh tarhing ah n'toel uh. Tedae Amah long tah amah kah cimcaihnah te dang sak ham ni mamih n'rhoeikhang sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah hlinsainah a om vaengah ngawn tah omngaihnah pawt tih kothaenah ni tila boeih a poek. Tedae hnukkhueng ah tekah a hlinsai rhangneh duengnah thaihtak te ngaimong la n'thuung.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah kut aka kha neh khuklu aka hlinghlawk te duel uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na kho te caehlong a dueng la saii pah. Te daengah ni aka khaem loh mael pawt vetih lat a hoeih eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A cungkuem taengah rhoepnah, cimnah neh huul uh. Te nen pawt atah Boeipa te hmu mahpawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khat khaw Pathen kah lungvatnah lamloh talae pawt ham hiphoel uh. Pakhat khaw olkhaa yung aka poe hang loh tulnoi tih te long te muep m'boi sak boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pakhat long khaw hlanghalh neh Esau bangla rhonging boel saeh. Anih long te caak kamat la amah kah caming te a thuung.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yoethennah a hnawt te a tloihsoi ah pang a ngaih te khaw na ming uh. Te dongah te te mikphi neh tlap cakhaw yutnah hmuen a hmuh moenih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmaitak hmai, khomu, khohmuep, rhonu tlanthim, olueng olhum neh olthang ol te phathuep ham na paan uh moenih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te kah te aka ya rhoek loh amih taengah olka a thap pawt ham a bih uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Olpaek te a ueh uh pawt dongah suva long pataeng tlang te a ben atah mat a dae.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengkah mikhmuh ah mueirhih te om tangloeng tih Moses loh , “Lakueng ngaiha la ka om tih ka thuen,” a ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Zion tlang, aka hing Pathen kah kho, vaan Jerusalem, puencawn rhoek a thawng a sang a tingtunnah,
  </para>
  <para style="p">
    <verse number="23" style="v" />vaan ah minghlum tangtae hlangboel camingomthang neh, a cungkuem kah laitloekkung Pathen taengah, rhuemtuet la aka dueng mueihla taengah,
  </para>
  <para style="p">
    <verse number="24" style="v" />paipi thai kah rhikhangkung Jesuh taengah khaw, Abel lakah khaw a then a thui tih a haeh thii te na paan uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih taengah aka thui te na hnawt uh pawt ham ngaithuen uh. Amih loh diklai ah a mangthui te a poenghal pawt atah vaan lamkah te mamih loh m'phaelh tak he muep nah ngai ni ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />A ol loh diklai a hinghoek vaengah ni ana caeng coeng tih, “Diklai bueng pawt tih vaan khaw vai ka hinghuen pueng ni,” a ti coeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te long te a hinghoek rhoek kah thovaelnah a saii ham te rhenten a thuicaih koep coeng. Te daengah ni aka hinghoek pawt rhoek loh a naeh uh eh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah cakrhuet ram n'dang uh tih lungvatnah te khueh uh sih. Tekah nen te Pathen kah kolo la yahyongnah, hinyahnah neh bawk uh sih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mamih kah Pathen tah hmai la rhong taktak coeng.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manuca lungnah tah naeh saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yinlailungnah te hmaai uh boeh. Te nen te a ngen long tah puencawn rhoek khaw buengrhuet a pah sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thongtla rhoek te thongtla hmaih bangla poek uh. Amih te a hnaephnap uh vanbangla pum ah nangmih khaw na om uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yulueinah te hlang boeih loh kueinah saeh lamtah ihnah te cuem saeh. Tedae hlanghalh rhoek neh samphaih rhoek te Pathen loh lai a tloek bitni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Omih dongah tangka moo boel saeh. Aka om duen neh rhaemhal saeh. Amah loh , “Nang te kan hlong loengloeng mahpawh, nang te kan phap loengloeng tlaih mahpawh,” a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah mamih loh , “Boeipa tah kai aka bomkung la om tih hlang loh ka soah a saii te ka rhih pawh,” ti ham khaw n'sayalh uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangmih aka kholcui rhoek te poek uh. Amih long ninangmih taengah Pathen kah olka te a thui. Amih kah caehlong te thuep uh lamtah tangnah dongah a omih te awt uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesuh Khrih tah hlaem neh tihnin kumhal due khaw amah la om.
  </para>
  <para style="p">
    <verse number="9" style="v" />A cungkuem la aka lang thuituennah te khaw khuentoeng uh boeh. Cakok neh pawt tih lungvatnah neh thinko a cak he then. Tekah cakok neh aka pongpa rhoek tah a hoeikhang moenih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmueihtuk pakhat n'khueh uh coeng. Te lamkah te caak hamla dap khuikah thothueng rhoek loh saithainah a khueh uh moenih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tholhnah kongah khosoihham loh rhamsa thii te hmuencim la a khuen tih a pum te vong voelah a hoeh uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesuh khaw a thii lamloh pilnam te ciim ham vongka kah a voelah patang tangloeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah amah taengah rhalkapim voella cet uh sih lamtah amah kah hnaelcoenah te phuei uh sih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khopuei aka nguel he n'khueh uh pawt dongah tih aka lo ham te n'toem uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amah lamloh Pathen taengah a cungkuem dongkah thangthennah hmueih te nawn uh tangloeng sih. Te tah a ming aka phong hmuilai kah a thaih coeng ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae boethen neh doedannah te hmaai uh boeh. Tebang hmueih ni Pathen loh a uem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmih aka kholcui rhoek te pangtung uh lamtah boengai uh. Amih loh olka a thuung uh vanbangla nangmih hinglu ham hak uh. Te daenngah ni he kah omngaihnah neh a saii uh vetih a huei uh pawt eh. Te te nangmih ham a sungdaeh la om ve.
  </para>
  <para style="p">
    <verse number="18" style="v" />A cungkuem ah a buelhmaih la khosak ham ka ngaih uh tih a then la mingcimnah ka khueh uh tila ka ngaitang uh dongah kaimih ham thangthui uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />He he saii ham muep kan hloep daengah ni nangmih taengla koe kam pha eh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahae ah ngaimongnah Pathen loh, duek khui lamloh dungyan paipi thii neh, tu rhoek kah tudawn tanglue, mamih kah Boeipa Jesuh aka mawt loh,
  </para>
  <para style="p">
    <verse number="21" style="v" />A kongaih saii sak ham te hnothen cungkuem neh nangmih n'tarhoek saeh. A hmaikah a kolo te Jesuh Khrih rhangneh mamih ah a saii coeng. Thangpomnah tah kumhal kah kumhal duela amah kah ni. Amen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmih kan hloep coeng, manuca rhoek, thaphohnah ol te yaknaem uh. Nangmih ham a toi lam ni kam pat ngawn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mamih kah manuca Timothy ha loeih te na ming uh coeng. Anih te yueya ha pawk atah nangmih te kang hip bitni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangmih aka kholcui rhoek boeih neh hlangcim rhoek boeih te toidal uh. Italy lamkah rhoek long khaw nangmih n'toidal uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lungvatnah tah nangmih boeih taengah om saeh.
  </para>
</usx>
