<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Olcueih</book>
  <para style="h">Olcueih</para>
  <para style="toc1">Olcueih</para>
  <para style="toc2">Olcueih</para>
  <para style="mt">Olcueih</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel manghai David capa Solomon kah he,
  </para>
  <para style="p">
    <verse number="2" style="v" />cueihnah ming sak ham neh ol yakmingnah te yakming sak ham thuituennah la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thuituennah la loh ham neh duengnah, tiktamnah neh vanatnah te aka cangbam sak la om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Camoe hlangyoe taengah mingnah neh thuepnah, khinglangnah aka pae la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aka cueih loh hnatun saeh lamtah rhingtuknah la thap thil saeh, aka yakming loh a niing la hol saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aka cueih rhoek kah, nuettahnah olka neh amih kah olkael aka yakming sak la om.
  </para>
  <para style="p">
    <verse number="7" style="v" />BOEIPA hinyahnah tah cueihnah, mingnah a tongnah la om tih aka ang loh thuituennah a hnoelrhoeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka ca aw na pa kah thuituennah he hnatun lamtah na nu kah olkhueng khaw tloeng sut boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te te na lu ham mikdaithen kah lukhueng neh na rhawn ham oi la om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka ca nang te hlangtholh rhoek loh n'hloih cakhaw rhoih boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Kaimih taengah pongpa lamtah hlang thii te rhongngol thil sih, ommongsitoe te a tloengtlaih la dawn sih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amih te saelkhui bangla a hing la dolh sih lamtah tangrhom ah a pum la a cungpung bangla om saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A boei a rhaeng boeih neh a phu aka tlo te n'dang uh vetih mamih im he kutbuem neh m'baetawt sak mako.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na hmulung te kaimih lakli ah naan lamtah mamih boeih ham sungsa pakhat la om saeh,” a ti uh atah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka ca aw, amih kah longpuei ah cet boel lamtah na kho te amih kah a hawn lamloh hoi lah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amih kah a kho tah boethae hamla cungpoeh uh tih thii long sak ham loe uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vaa phae boeih kah a hmaiah a tloengtlaih la lawk a tung uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih loh amamih kah a thii te a rhongngol thil uh tih a hinglu te a mae uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mueluemnah dongah aka mueluem boeih kah a khosing te tah a boei kah a hinglu ni a. rhawt pah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cueihnah tah vongvoel ah tamhoe tih toltung ah a ol a huel.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thohka ah aka kawk rhoek kah a lu ah a pang pah tih khopuei vongka ah ol a thui.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlangyoe nang loh mevaeng hil nim hlangyoe na lungnah ve, hmuiyoi rhoek tah amamih kah saipaat dongah naep uh tih, aka ang rhoek loh mingnah te a hmuhuet uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka toelthamnah he mael thil lah, ka mueihla he nang hamla kan thaa saeh lamtah ka ol he khaw nang kam ming sak eh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kang khue vaengah na aal uh tih ka kut kan cavaih vaengah nim te hnatung uh pawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kai kah cilsuep boeih te na dul uh tih, kai kah toelthamnah khaw na ngaih uh pawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kai khaw nangmih kah rhainah te ka nueih thil vetih nangmih ah birhihnah a thoeng vaengah kan tamdaeng ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangmih kah birhihnah tah khohli rhamrhael bangla ha pawk vetih na rhainah loh cangpalam bangla halo vaengah, citcai neh khobing loh nangmih te m'paan vaengah,
  </para>
  <para style="p">
    <verse number="28" style="v" />Kai ng'khue uh cakhaw ka doo mahpawh, kai n'toem uh cakhaw m'hmu uh bal mahpawh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te yueng te mingnah a hmuhuet uh tih BOEIPA kah hinyahnah te tuek uh pawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai cilsuep dongah naep uh pawt tih, kai kah toelthamnah khaw boeih a tlaitlaek uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A khosing kah a thaih te a caak uh vetih a cilkhih loh a lawn uh bitni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hlangyoe hnuknong loh amih te a ngawn vetih aka ang kah ommongnah loh amih te a milh sak ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae kai taengah aka hnatun long tah ngaikhuek la kho a sak vetih yoethae kah birhihnah khuiah khaw rhalthal van ni.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka ca, ka ol na doe tih ka olpaek he na khuiah na khoem atah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Cueihnah te na hna neh hnatung lamtah na lungbuei te lungcuei taengla maelh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yakmingnah ham te khue tih lungcuei ham na ol na huel atah,
  </para>
  <para style="p">
    <verse number="4" style="v" />Te te cak bangla na moeh tih kawn bangla na thaih atah,
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA hinyahnah te yakming lamtah Pathen kah mingnah te dang van.
  </para>
  <para style="p">
    <verse number="6" style="v" />BOEIPA long tah a ka dong lamkah cueihnah ni mingnah neh lungcuei la a paek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka thuem ham tah lungming cueihnah khaw a khoem a khoem pah tih thincaknah neh aka cet ham photling la om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tiktamnah kah caehlong te a kueinah tih a hlangcim, hlangcim kah longpuei tah a ngaithuen pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te daengah ni duengnah, tiktamnah, vanat la namtlak then boeih te na yakming eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cueihnah te na lungbuei khuila ha kun vaengah mingnah loh na hinglu te a hmae sak ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thuepnah loh nang te n'ngaithuen vetih lungcuei loh nang n'kueinah ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Boethae longpuei lamkah khaw, calaak ol aka thui hlang taeng lamkah khaw nang ng'huul ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmaisuep longpuei ah pongpa hamla, a dueng caehlong a toeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Boethae saii ham ko aka hoe loh boethae calaak dongah omngaih uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A caehlong aka paihaeh sak rhoek loh a namtlak ah kho a hmang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kholong hlanglak nu taeng lamkah neh anih kah hoem ol khui lamloh nang aka huul ham ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />A camoe kah a boeihlum te a hnoo tih a Pathen kah paipi te a hnilh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A imkhui khaw duek hamla aka a namtlak khaw sairhai taengla ngooi coeng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih taengla aka pawk boeih tah ha mael uh voel pawt dae hingnah caehlong khaw kae uh hae pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te daengah ni hlang then longpuei ah na pongpa vetih hlang dueng kah caehlong khaw na ngaithuen eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aka thuem rhoek long tah khohmuen te kho a sak uh thil vetih a khuiah kodam la sueng uh ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae halang rhoek tah khohmuen lamloh a hnawt uh vetih hnukpoh rhoek khaw a khui lamkah a phuk uh ni.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka ca, kai kah olkhueng he hnilh boel lamtah ka olpaek he na lungbuei loh kueinah saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na hingnah khohnin neh kum a sen vaengah nang hamla ngaimongnah han thap uh bitni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sitlohnah neh uepomnah loh nang te n'hnoo boel saeh. Te te na rhawn dongah hlaengtang lamtah na lungbuei cabael dongah daek lah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te tlam te Pathen neh hlang mikhmuh ah mikdaithen neh lungmingnah then te dang van lah.
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA dongah na lungbuei boeih neh pangtung lamtah namah kah yakmingnah dongah hangdang boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na longpuei boeih ah amah te ming lamtah amah loh na caehlong a dueng sak bitni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na mikhmuh dawk neh aka cueih la om boeh, BOEIPA te rhih lamtah boethae te nong tak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na tharhui ham sadingnah neh na rhuh ham a hliing la om ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />BOEIPA te na boeirhaeng neh, na cangvuei boeih khuikah a tanglue neh thangpom lah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te daengah ni na khai te khobuh neh baetawt vetih misur thai khaw na va-am dongah puh ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />BOEIPA kah thuituennah he ka ca nang loh sawtsit boel lamtah amah kah toelthamnah te na mueipuel sak boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />BOEIPA loh a lungnah te tah a tluung dae pa bangla capa te a moeithen.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cueihnah aka hmu hlang neh lungcuei aka dang hlang tah a yoethen pai.
  </para>
  <para style="p">
    <verse number="14" style="v" />A thenpom te tangka thenpom lakah, a cangvuei khaw sui lakah then.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te tah lungvang lakah kuel ngai tih na ngaihnah boeih long khaw pha uh mahpawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />A bantang ah hinglung vang nah, a banvoei ah khuehtawn neh thangpomnah om.
  </para>
  <para style="p">
    <verse number="17" style="v" />A longpuei te omthennah longpuei la om tih a hawn te ngaimongnah la boeih om.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hingnah thingkung cueihnah aka kop ham neh aka tu ham tah a uem om pai.
  </para>
  <para style="p">
    <verse number="19" style="v" />BOEIPA loh cueihnah neh diklai a suen tih a lungcuei neh vaan a soepboe.
  </para>
  <para style="p">
    <verse number="20" style="v" />A mingnah rhangneh a dung khaw ueth tih khomong khaw buemtui la pha.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka ca na mik te khohmang boel saeh, lungming cueihnah neh thuepnah te kueinah ne.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na hinglu ham hingnah neh na rhawn ham mikdaithen la om ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah na longpuei te ngaikhuek la na cet vetih na kho tongtah mahpawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na yalh vaengah na rhih voel pawt vetih na yalh thuk neh na ih khaw tui ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Birhihnah aka pai buengrhuet neh halang rhoek aka muk khohli rhamrhael te khaw rhih boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />BOEIPA tah nang ham uepnah la om vetih na kho te doong dong lamloh hang hoep bitni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A kungmah lamkah hnothen te hloh boeh. Na kut loh a saii ham vaengah na kut te Pathen dongah om saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Namah taengah a om lalah na hui te, “Na hui taengah cet dae, thangvuen ah ha mael lamtah kam paek bitni,” ti nah boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Namah taengah ngaikhuek la kho aka sa na hui te boethae neh phoh thil boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Boethae la nang aka saii pawt hlang te lungli lungla la oelh rhoe oelh boeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kuthlahnah hlang taengah thatlai boeh, anih kah longpuei te pakhat khaw tuek boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />BOEIPA kah a tueilaehkoi loh kho a hmang dae aka thuem taengah a baecenol om.
  </para>
  <para style="p">
    <verse number="33" style="v" />Halang im ah BOEIPA kah tapvoepnah om dae hlang dueng tolkhoeng tah yoe a then sak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hmuiyoi rhoek ngawn tah amah loh a hnael vetih mangdaeng neh kodo te mikdaithen la a khueh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thangpomnah tah aka cueih rhoek loh a pang uh tih aka ang loh yah a ludoeng.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pa kah thuituennah te ca rhoek loh hnatun saeh lamtah yakmingnah dang hamla hnatung saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmih taengah aka then rhingtuknah kam paek coeng dongah ka olkhueng he hnoo boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka camoe vaengah a pa taengah mongkawt la, a nu mikhmuh ah oingaih cangloeng la ka om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah kai n'thuinuet tih kamah taengah, “Ka ol he na lungbuei ah dueh lamtah ka olpaek ngaithuen neh hing puei .
  </para>
  <para style="p">
    <verse number="5" style="v" />Cueihnah te lai lamtah yakmingnah khaw lai lah. Ka ka dong lamkah olthui he hnilh boeh, phaelh boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cueihnah te hnoo boeh, na lungnah daengah ni namah te n'ngaithuen vetih nang te n'kueinah eh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cueihnah he ni tanglue, cueihnah he lai lamtah na hnopai boeih nen khaw yakmingnah he lai lah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cueihnah te picai lamtah namah te n'pomsang bitni. Namah te n'thangpom atah amah te kop van.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na lu dongah mikdaithen kah lukhueng la om vetih nang taengah boeimang rhuisam han tloeng ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka ca ka hnatun lamtah ka olthui he doe lah. Te daengah ni na hingnah ah kum loh nang hamla a puh eh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cueihnah longpuei neh nang te ka thuinuet vetih namtlak then ah nang te kan cuuk sak ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na caeh vaengah na khokan loh puenca pawt vetih na yong vaengah tongtah mahpawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuituennah te tu lamtah hlong boeh, na hingnah hamla kueinah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Halang kah caehlong ah pongpa boeh, boethae rhoek kah longpuei dongah uem puei boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te te dul laeh, a taengla paan boeh. A taeng lamloh taengphael lamtah khum tak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thaehuet pawt atah ip uh tloel dae a ih loh a hmil atah hlang paloe sak ham te paloe sak uh thai pawh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Halangnah buh te a ang uh tih kuthlahnah misurtui tul uh thae.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khothaih kah koshae a cikngae vanbangla aka dueng kah caehlong khaw khosae kah a aa bangla a thoeng pah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Halang rhoek kah longpuei tah khohmuep bangla om tih mebang neh a tongtah khaw ming uh pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka ca, ka ol he hnatung lamtah ka olthui he na hna kaeng lah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na mik long khaw khohmang boel saeh lamtah na thinko khui ah te te ngaithuen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te te aka hmuh rhoek ham tah amamih kah hingnah neh a pumsa boeih ham khaw hoeihnah la om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na lungbuei te kueinah khingrhing lah hingnah kah a dawn tah te lamkah ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka dongkah olhmaang te na taeng lamloh thaek lamtah hmuilai dongkah olrhong oling khaw namah lamloh lakhla sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na mik loh phek paelki saeh lamtah na mikkhu loh namah hmaiah buelh dueng saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na kho ham namtlak te saelh pah saeh lamtah na longpuei khaw boeih cikngae saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Banvoei bantang la phael boeh, na kho te a thae dong lamloh hoeptlang lah.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka ca aw, ka cueihnah he hnatung lamtah ka lungcuei dongla na hna kaeng lah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thuepnah neh mingnah te ngaithuen hamla na hmuilai long khaw tuem uh saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rhalawt nu kah a hmuilai ah khoilitui cip tih a lai khaw situi lakah hnal.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae hmailong ah tah anih te pantong bangla khahing tih cunghang paihat bangla haat.
  </para>
  <para style="p">
    <verse number="5" style="v" />A kho te dueknah khuila suntla tih a khokan loh saelkhui la a doek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hingnah caehlong lakah a ming pawh a namtlak likloek te saelh ve ne.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah ka ca rhoek kai ol he hnatun uh laeh, ka ka dongkah olthui te nong tak boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na longpuei te anih neh lakhla sak lamtah a im thohka lam khaw mop boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na mueithennah te a tloe taengla ham pae vetih na kum muenying muenyang la hang khueh ve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na thadueng te rhalawt rhoek cung uh vetih na patangnah phu te kholong imkhui la pawk ve.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na hmailong ah na nguek vetih na pum na saa khaw hmawn hae ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah, “Thuituennah te ka hmuhuet tih toelthamnah khaw ka lungbuei loh a tlaitlaek pai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka saya ol te ka hnatun pawh kai aka cang puei taengah khaw ka hna ka kaeng pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlangping neh rhaengpuei lakli kah boethae sumsiit te vat ka pha,” na ti hae ni
  </para>
  <para style="p">
    <verse number="15" style="v" />Na tuitung dongkah tui neh na tuito lamtah aka sih te o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tuisih te kawtpoeng ah, sokca tui te toltung ah phuet saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang namah bueng hamla om saeh lamtah na taengkah kholong ham boel saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na thunsih te yoethen la om saeh lamtah na camoe kah na yuu dongah kohoe sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih tah sayuk rhuinu lunguem bangla, a sukbam te sakhi rhuinu mikdaithen bangla a tuetang boeih ah nang te m'hmilhmal sak saeh lamtah a lungnah loh m'palang sak yoeyah saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ba ham lae ka ca loh rhalawt la na palang vetih kholong kah a rhang te na kop eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlang kah longpuei neh a namtlak boeih a saelh te khaw BOEIPA mikhmuh ah om.
  </para>
  <para style="p">
    <verse number="22" style="v" />Halang te amah kathaesainah loh amah te a tuuk tih a tholhnah rhui loh a ban.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih thuituennah a om pawt dongah duek vetih a anglat aih dongah palang ni.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka ca, na hui ham rhi na khang tih kholong ham na kut na tum atah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Na ka dongkah olthui loh n'hlaeh coeng tih na ka dongkah olthui loh n'khaih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te te na saii dongah ka ca aw, na huul uh cakhaw na hui kah kut ah ni na pha hae. Te dongah cet, mawn lamtah na hui hloep laeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mik te ih sak boeh, na mikkhu te ngam boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kut dongkah kirhang bangla sayuep kut dongkah vaa bangla namah huul uh laeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kolhnaw aw lunghi taengla cet lah, anih kah khosing ke hmu lamtah cueih van lah.
  </para>
  <para style="p">
    <verse number="7" style="v" />A taengah rhalboei khaw, rhoiboei khaw, aka taemrhai ham khaw om mai pawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khohal ah a buh te a soepsoei tih cangah ah a caak te a yoep.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kolhnaw aw me hil nim na yalh vetih na ih lamloh me vaengah nim na thoh ve?
  </para>
  <para style="p">
    <verse number="10" style="v" />Bet ih, bet ngam, kut poem bet neh na yalh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah na khodaeng te aka cet paitai bangla, na tloelnah loh photling aka bai hlang bangla ha pawk ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aka muen hlang neh boethae hlang tah a ka dongkah olhmaang nen ni a pongpa.
  </para>
  <para style="p">
    <verse number="13" style="v" />A mik neh a mikhip, a kho neh a thui, a kutdawn neh a thuinuet.
  </para>
  <para style="p">
    <verse number="14" style="v" />A lungbuei kah a calaak neh a tuetang takuem ah boethae bueng a paem tih, tingtoehnah neh hohmuhnah a khuen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah amah kah rhainah loh buengrhuet a thoeng thil vetih hoeihnah om kolla khaem pahoi ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />He parhuk he BOEIPA loh a thinah tih a hinglu dongah tueilaehkoi khuikah tueilaehkoi parhih tah.
  </para>
  <para style="p">
    <verse number="17" style="v" />A honghi lai aka ludoeng kah a mik, ommongsitoe kah thii aka long sak kah a kut,
  </para>
  <para style="p">
    <verse number="18" style="v" />Boethae kopoek aka paem lungbuei, boethae dongla aka yong paitok kho,
  </para>
  <para style="p">
    <verse number="19" style="v" />A hong kah laipai loh laithae ol a sat tih pacaboeina lakli ah tingtoehnah la a khuen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka ca, na pa kah olpaek te kueinah lamtah na nu kah olkhueng phap sut boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lungbuei ah rhawp hlaengtang lamtah na rhawn ah rhawp laikoeinah lah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na caeh vaengah nang m'mawt vetih na yalh vaengah nang te n'tawt ni, na haenghang vaengah nang n'lolmang puei ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Olpaek tah hmaithoi ni, olkhueng khaw vangnah ni, thuituennah dongkah toelthamnah khaw hingnah longpuei ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huta thae taeng lamkah neh kholong nu ol hnal lamloh nang aka ngaithuen ham ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />A sakthen te na thinko nen khaw nai boeh, a mikkhu neh nang te n'hloih boel saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pumyoi nu tah buh hluem ham ni, tedae hlang yuu loh hinglu phutlo khaw a hoem.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hlang kah a rhang dongah hmai a poep lalah a himbai te hoeh mahpawt a?
  </para>
  <para style="p">
    <verse number="28" style="v" />Hlang pakhat te hmai-alh dongah a caeh lalah a kho te duih mahpawt a?
  </para>
  <para style="p">
    <verse number="29" style="v" />A hui kah yuu te aka kun thil tih aka ben tah pakhat khaw hmil tangloeng mahpawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />A hinglu kah a lamlum dip sak hamla a huen atah hlanghuen te hlang loh hnoelrhoeng mahpawt a?
  </para>
  <para style="p">
    <verse number="31" style="v" />A hmuh uh atah a pueh parhih la a sah saeh lamtah a im kah a boei a rhaeng te boeih a phai saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lungbuei aka talh huta tah samphaih, a hinglu aka phae long ni te te a saii.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tlohtat neh yah a dong vetih anih kokhahnah te hmata mahpawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Phulohnah khohnin ah a va kah kosi neh thatlainah dongah lungma ti mahpawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />A mikhmuh kah tlansum pakhat khaw khuen pah pawt vetih kapbaih yet cakhaw huem pah mahpawh.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka ca ka olthui he ngaithuen lamtah ka olpaek he na taengah khoem ne.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka olpaek he ngaithuen lamtah hing puei. Ka olkhueng he na mikhmuh ah thenhnaih la om saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te te na kutdawn dongah hlaengtang lamtah na lungbuei cabael dongah daek lah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cueihnah te, “Ka ngannu nang tah,” ti nah lamtah yakmingnah te pacaboeina la khue.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rhalawt nu taeng lamkah khaw, kholong nu kah hoem ol lamkah khaw namah aka ngaithuen ham ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka im bangbuet kah thohhuel long ka dan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah hlangyoe rhoek te ka hmuh tih cadong ca rhoek khuiah a lungbuei aka talh khaw ka yakming.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huta imdak kah bangkil te a paan tih huta im kah longpuei la luei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlaemhmah ah, khothun kholaeh ah, khoyin yinthuem neh khohmuep ah khaw, cet.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih aka doe ham huta ngawn tah pumyoi hnisui neh a lungbuei a uep coeng ke.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tekah huta tah hue a sak tih a im ah khaw a thinthah. A khopha khaw duem pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tahae nawn ah imkawt ah, tahae ah toltung neh bangkil takuem ah rhongngol coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tekah cadong te a sol tih a mok, a maelhmai khaw a cadong ham a tanglue pah tih cadong te,
  </para>
  <para style="p">
    <verse number="14" style="v" />Kamah taengkah rhoepnah hmueih neh tihnin ah tah ka olcaeng te ka thuung coeng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah nang doe ham neh na mikhmuh ah toem hamla ka mop tih nang kam hmuh tangloeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka soengca te Egypt hnitang, cenlang, hniphaih neh ka phaih coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka thingkong dongah murrah, thingul, thingsa ka khueh thil coeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Halo lah a hlo neh mincang duela hmilhmal sih lamtah, pumnai neh yoka sih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tongpa loh a im ah om pawt tih khohla ah yiin la cet coeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />A kut dongah tangka cun a khuen tih hlalum hnin ah ni a im la ha pawk eh?,” a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih te a rhingtuknah cungkuem neh a yoek tih a hmuilai kah hamsum neh a heh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah huta hnukah maeh la aka poeh vaito bangla, aka ang thuituennah dongkah khocin rhui bangla cet.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vaa loh pael khuila a kun paitok bangla a thin te thaltang loh a khoh pah duela a hinglu te ming pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah ca rhoek loh kai ol he hnatun uh lamtah ka ka dongkah olthui he hnatung uh laeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih kah longpuei la mael boeh, na lungbuei te anih kah a hawn la khohmang sak boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih loh hmalaem la muep a cungku sak tih aka tlung rhoek khaw boeih a ngawn coeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />A im khaw saelkhui longpuei ah om tih dueknah imkhui la suntla pai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cueihnah loh n'khue moenih a? Lungcuei loh a ol a huel dae ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Longpuei taengkah hmuensang som ah a im kah a hawn ah khaw pai ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vangpuei la a kun phai kah vongka hmoi ah khaw thohka kah a rhai ah khaw tamhoe ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw hlang rhoek, nangmih te kang khue tih ka olthang he khaw hlang capa ham ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hlangyoe rhoek loh khinglangnah yakming lamtah aka ang rhoek loh lungbuei te yakming lah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnatun uh, rhaengsang la ka thui dongah ka hmuilai ka ongnah he vanat la om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka ka loh oltak a thuep tih halangnah te ka hmuilai kah a tueilaehkoi ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka ka dongkah duengnah olthui boeih he a hloo vilvak moenih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aka yakming ham tah boeih langya tih mingnah aka dang ham tah thuem ngawn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka thuituennah tangka nen pawt tih, mingnah he sui a coelh lakah khaw lo lah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cueihnah tah lungvang lakah then tih ngaihnah sarhui khaw te nen te vanat sak thai pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kamah tah cueihnah, khinglangnah neh kho ka sak tih thuepnah dongkah mingnah te ka hmuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />BOEIPA hinyahnah dongah a thae la koevoeinah te thiinah ham ni hoemdamnah neh a thae longpuei khaw, calaak ol khaw ka hmuhuet.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cilsuep neh lungming cueihnah tah kamah taengah, ka yakmingnah neh, kamah ham thayung thamal la om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai rhangneh manghai rhoek loh manghai tih boeica rhoek loh duengnah neh a taem uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai rhangneh mangpa rhoek khaw boei uh tih hlangcong boeih loh duengnah lai a tloek uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai aka lung, aka lungnah te ka lungnah tih kai aka toem rhoek loh kai m'hmuh uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khuehtawn neh thangpomnah khaw, aka nguel boeirhaeng neh duengnah khaw kamah taengah om.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sui neh suicilh lakah ka thaih then tih ka cangvuei khaw cak lakah cae.
  </para>
  <para style="p">
    <verse number="20" style="v" />Duengnah caehlong ah tiktamnah a hawn khui la ka pongpa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai aka lungnah tah ka koe ka pang sak tih a thakvoh te ka koei pah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Daengrhae daengkhoi lamkah a bibi, hlamat kah a longpuei a tongcuek ah BOEIPA loh kai n'lai coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khosuen lamloh, a lu lamloh, diklai khothoeng lamloh kai n'hloe.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kai ka poe vaengah tuidung khaw ana om pawh, tuisih tui ana phul pawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tlang a buek hlan ah som a tueng hlan ah ka cuen coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah diklai khaw, tollong khaw, lunglai dongkah laipi lamhma khaw ana saii moenih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vaan a soepsoei ham vaengkah, tuidung hman kah a kueluek te a tarhit ham vaengkah khaw kamah ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />A sang hmuen kah khomong thah sak ham khaw, tuidung tuiphuet tanglue sak ham vaengah khaw,
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuitunli te a rhi suem pah ham vaengah khaw ka om coeng. Te dongah tui loh BOEIPA ol te poe pawh. Diklai kah a yung te a tarhit ham vaengah ka om coeng.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amah taengah bibi thai la ka om tih hnin bal hnin bal hlahmaenah neh ka om. A tue boeih dongah amah mikhmuh ah ka luem.
  </para>
  <para style="p">
    <verse number="31" style="v" />A khohmuen kah lunglai dongah aka luem loh hlang ca te khaw ka hlahmaenah coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah ca rhoek loh kamah taengah hnatun uh lamtah kamah kah yoethen longpuei ngaithuen uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thuituennah he hnatun lamtah cueih lamtah hlahpham boeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kamah taengah aka hnatun Ka thohkhaih taengah a hnin a hnin ah aka hak, ka thohka kah rhungsut aka ngaithuen hlang tah a yoethen pai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai aka hmu long tah hingnah te a hmuh rhoe a hmuh tih, BOEIPA taengkah kolonah a dang.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae kai aka hmaang long tah a hinglu a huet, kai aka thiinah boeih loh dueknah te a lungnah.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cueihnah loh a im a sak tih a tung parhih a vueh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A maeh te a ngawn tih misurtui neh a thoek tih a caboei te a tawn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah kah hula rhoek te a tueih tih, vangpuei hmuensang dangdoe lamkah a khue.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah, “Unim hlangyoe, anih te lungbuei a talh khaw pahoi nong tak saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Halo, ka buh he ang uh lamtah misur ka thoek he o uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlangyoe te hnoo lamtah hing uh, yakmingnah longpuei te uem uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmuiyoi aka toel tah amah loh yah a poh tih, halang aka tluung tah amah loh nganboh a yook.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmuiyoi te tluung boeh namah m'hmuhuet ve. Aka cueih tah na tluung cakhaw nang n'lungnah ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aka cueih te pae lah taoe cueih ni, aka dueng te na tukkil atah rhingtuknah a thap ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />BOEIPA hinyahnah tah cueihnah lamhma la om tih aka cim mingnah he yakmingnah la om.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai rhangneh na khohnin te puh vetih nang hamla hingnah kum khaw a thap ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na cueih la na cueih mak atah namah ham ngawn ni. Hmui na yoih atah nang namah long ni na phueih eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angvawk nu loh a poeyoek la kawk tih bang khaw ming pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae a im thohka neh vangpuei hmuensang kah ngolkhoel dongah ngol.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah a caehlong a dueng la longpuei ah aka pongpa rhoek te a khue.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Hlangyoe neh lungbuei aka talh tah pahoi ha pah saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A tui huen aka tui sak tih yinhnuk buh neh aka hmae,” a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae saelkhui laedil ah sairhai pahoi a khue pah te ming pawh.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solomon kah, Ca aka cueih loh a napa ko a hoe sak tih ca aka ang tah a manu a pha-ueknah la om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Halangnah kah thakvoh khaw hoeikhang tloe pawt tih, duengnah long tah dueknah lamloh a huul.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aka dueng kah hinglu tah BOEIPA loh a lamlum sak moenih, tedae halang kah a talnah te a thaek pah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Palyal kut loh a saii tah vawtthoek tih, kut aka haam tah boei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khohal ah aka yoep capa long tah a cangbam tih, cangah vaengah aka ip capa loh yah a bai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aka dueng kah a lu dongah yoethennah om dae, halang kah a ka long tah kuthlahnah khaw a phah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka dueng poekkoepnah tah yoethennah la om dae, halang tah a ming pawn ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungbuei aka cueih loh olpaek te a doe tih, aka ang tah a hmui a lai a caehdoelh pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thincaknah neh aka pongpa tah ngaikhuek la cet dae, a longpuei aka kawn sak khaw amah ming uh bitni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mik neh aka mikhip loh nganboh a paek tih, aka ang tah a hmui a lai a caehdoelh pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka dueng kah a ka tah hingnah thunsih la om tih, halang kah a ka loh kuthlahnah te a uep.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmuhuetnah loh tingtoehnah a huek. Tedae lungnah long tah dumlai boeih a dah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmuilai dongah aka yakming loh cueihnah a dang tih, lungbuei aka talh kah a nam ham rhuiboeng om.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka cueih rhoek loh mingnah a khoem uh tih aka ang kah a ka tah a porhaknah yoei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khorha khuikah, hlanglen kah a boei a rhaeng tah amah kah a sarhi la om tih, a khodaeng te tattloel rhoek kah porhaknah la om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aka dueng kah thaphu tah hingnah la om tih halang kah cangah tah tholhnah la poeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thuituennah aka ngaithuen tah hingnah caehlong la pawk tih toelthamnah aka hnawt tah kho a hmang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmuhuetnah aka phah kah a hmuilai khaw a honghi la om tih, theetnah aka haeh khaw ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Olka a yet vaengah dumlai khaw a mueh moenih, tedae a hmuilai aka tuem ni lungming la a om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aka dueng kah ol tah cak a coelh bangla om tih halang kah a lungbuei tah vilvel mai ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aka dueng kah hmuilai loh muep a kok tih aka ang tah a lungbuei a talh dongah duek.
  </para>
  <para style="p">
    <verse number="22" style="v" />BOEIPA kah yoethennah tah boei tih, te te patangpnah a koei thil moenih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aka ang ham tah nueihbu te khonuen rhamtat la a saii dae, cueihnah long tah hlang taengah lungcuei la om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Halang kah rhihnahkoi tah amah taengla a pawk pah tih aka dueng kah a ngaihlihnah khaw a doo pah ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cangpalam loh a paan vaengah halang tah pai thai pawt vetih aka dueng kah khoengim tah kumhal ah pai ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kolhnaw tah a tueih rhoek hamla a no dongah a thuui bangla, a mik dongah hmaikhu bangla a om pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />BOEIPA hinyahnah loh khohnin a thap tih halang kah a kum tah a rhaem pah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aka dueng rhoek kah ngaiuepnah tah kohoenah la om tih halang rhoek kah ngaiuepnah tah paltham.
  </para>
  <para style="p">
    <verse number="29" style="v" />BOEIPA kah longpuei he thincaknah ham tah lunghim la om tih boethae aka saii ham porhaknah la om.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aka dueng tah kumhal duela tuen pawt dae halang rhoek tah diklai ah khosa mahpawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aka dueng kah a ka ah cueihnah cuen tih calaak rhoek kah a lai tah a yueh pah ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aka dueng kah hmuilai tah kolonah la a ming dae halang rhoek kah a ka tah calaak yoeyah.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlangthai palat kah cooi te BOEIPA kah tueilaehkoi tih, coilung a thuem te a kolonah la om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Althanah ha pawk vaengah yah khaw thoeng, tedae cueihnah tah kodo nen ni ha pawk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aka thuem rhoek kah muelhtuetnah loh amamih te a mawt tih, hnukpoh rhoek kah a saveknah loh amamih te a rhoelrhak la a rhoelrhak sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />A thinpom khohnin ah tah a boeirhaeng nen khaw hoeikhang pawt vetih, duengnah long ni dueknah lamloh a huul eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Duengnah long tah a longpuei te cuemthuek la a dueng sak tih, halang te a a halangnah loh a cungku sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aka dueng rhoek tah duengnah loh a huul tih, hnukpoh rhoek tah talnah loh a tuuk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Halang hlang kah dueknah dongah ngaiuepnah khaw moelh tih, thahuem kah ngaiuepnah khaw tahah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aka dueng tah citcai lamkah khaw pumcum tih anih yueng la halang taengla a pawk pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lailak kah a ka loh a hui a phae tih aka dueng kah mingnah rhangneh pumcum uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aka dueng kah thennah dongah ni khorha loh sundaep thil tih halang a milh vaengah tamlung a lohuh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka thuem rhoek kah yoethennah loh vangpuei a pomsang tih, halang kah a ka longtah a koengloeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lungbuei aka talh loh a hui te a hnoel a rhoeng dae lungcuei hlang long tah hil a phah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Caemtuh a caeh vaengah baecenol te a hliphen tih mueihla ah tangnah koila aka om long tah olka a tuem.
  </para>
  <para style="p">
    <verse number="14" style="v" />A niing a tal dongah pilnam cungku tih, uentonah a yet nen ni loeihnah a om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kholong loh rhi a khang atah boethae loh thae a huet ni, Tedae kutyuh aka hnoel tah a pangtung uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huta mikdaithen loh thangpomnah te a moem tih, hlanghaeng loh khuehtawn a koi ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sitlohnah aka khueh hlang loh a hinglu khaw a phai dae muenying muenyang loh a pumsa a lawn khoeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Halang loh a honghi khaw thaphu la a saii tih, duengnah cangti aka tuh longtah oltak kutphu te a doe.
  </para>
  <para style="p">
    <verse number="19" style="v" />Duengnah tah hingnah la pawk tih, boethae aka hloem khaw a dueknah ham ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungbuei a voeldak tah BOEIPA kah a tueilaehkoi tih, cuemthuek longpuei tah a kolonah la om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kut sokah kut pataeng boethae a hmil moenih, tedae aka dueng kah tiingan tah loeih ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sakthen nu khaw omih aka phaelh tah ok hnarhong dongkah sui hnaii banghui ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aka dueng rhoek long tah a then ngaiuepnah bueng ni a. ngaihlihnah tih halang rhoek long tah thinpom a khueh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A khueh duen te a tael tih koep a koei pah, hloh malcal khaw tloelnah la om sumsoek.
  </para>
  <para style="p">
    <verse number="25" style="v" />yoethennah hinglu loh a doedan vetih, a tulcah dongah amah te khaw a suep van ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cangpai aka hloh te namtu loh a tap tih aka hlah te tah a lu ah yoethennah loh a vuei.
  </para>
  <para style="p">
    <verse number="27" style="v" />A then aka toem loh kolonah a tlap tih, boethae aka tlap tah amah a thoeng thil.
  </para>
  <para style="p">
    <verse number="28" style="v" />A khuehtawn dongah aka pangtung tah cungku vetih aka dueng rhoek tah thinghnah bangla boe ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />A imkhui aka lawn tah khohli a pang vetih, aka ang khaw lungbuei aka cueih taengah sal la om ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aka dueng kah a thaih tah hingnah thingkung la om tih, hinglu aka tuek ni aka cueih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aka dueng pataeng diklai dongah a thuung atah halang neh laihmu aisat te a thuung ni ta.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thuituennah aka lungnah loh mingnah khaw a lungnah tih, toelthamnah aka hmuhuet tah a kotalh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlang then loh BOEIPA taengkah kolonah a dang tih, tangkhuepnah aka khueh hlang tah a poehlip sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Halangnah lamloh hlang cikngae pawt tih, aka dueng kah a yung tah a tuen sak moenih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tatthai nu tah a boei kah rhuisam la om, tedae yah aka bai tah a rhuh khuiah keet la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aka dueng tah kopoek tiktam tih, halang kah a niing tah thailatnah la poeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Halang rhoek kah olka loh thii a rhongngol tih, aka thuem kah a ka loh hlang a huul.
  </para>
  <para style="p">
    <verse number="7" style="v" />Halang rhoek te a palet nen tah om uh voel pawh, tedae aka dueng rhoek kah im tah pai yoeyah.
  </para>
  <para style="p">
    <verse number="8" style="v" />A lungmingnah olka dongah hlang loh a thangthen tih, lungbuei aka paihaeh tah nueihbu la poeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rhaidaeng mai cakhaw a taengah sal aka khueh tah, thangpom uh tih caak aka nai lakah then.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aka dueng long tah a rhamsa kah a hinglu te a ming dae, halang kah haidamnah tah muenying muenyang la om.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah khohmuen aka tawn loh buh a cung sak tih, a lungbuei aka talh long tah a hoenghoep te a hloem.
  </para>
  <para style="p">
    <verse number="12" style="v" />Boethae rhoek kah tluum te halang loh a nai dae, aka dueng rhoek kah a yung tah cuen yoeyah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmuilai kah boekoek dongah boethae kah hlaeh om dae, aka dueng tah citcai lamloh loeih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang kah lai thaih loh hnothen a cung sak tih, hlang kut neh a tiing la amah taengah a mael rhoe, a mael pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aka ang kah longpuei tah a mikhmuh ah thuem dae, aka cueih kah cilsuep te ni a. hnatun.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aka ang loh khothaih ah a konoinah te a phoe dae, aka thaai loh yah koi te a dah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Uepomnah aka sat loh duengnah a thui tih, a honghi kah laipai tah hlangthai palat ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />cunghang kah tingtoehnah bangla aka cal buengrhuet khaw om dae, aka cueih kah a lai tah hoeihnah la om.
  </para>
  <para style="p">
    <verse number="19" style="v" />Oltak kah hmuilai tah a yoeyah la cikngae tih, a honghi ol cat ka paa sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlangthai palat loh a lungbuei khuikah boethae te a uep tih, rhoepnah ham aka uen loh kohoenah a dang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aka dueng te boethae pakhat long khaw a cuhu thil moenih. Tedae halang rhoek tah boethae neh baetawt uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A honghi kah hmuilai tah BOEIPA kah a tueilaehkoi tih uepomnah aka saii te a kolonah la a khueh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aka thaai hlang long tah mingnah te a tuem tih, aka ang kah lungbuei long tah a anglat te a yan.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aka haam kah kut loh a taemrhai vetih palyal te saldong la a om sak ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lungbuei kah mawnnah loh hlang a bungkawn tih, ol then loh ko a hoe sak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aka dueng long tah a hui te a tlap tih, halang rhoek kah longpuei tah amamih te kho a hmang puei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Palyal loh a sakah pataeng a kaeh moenih, tedae hlang haam kah a boeirhaeng tah a phu tlo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Duengnah caehlong ah hingnah om tih, a hawn longpuei khaw dueknah moenih.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ca aka cueih loh pa kah thuituennah a hnatun tih, hmuiyoi long tah tluungnah pataeng hnatun pawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlang lai thaih lamloh a then khaw a cah dae, hnukpoh kah hinglu tah kuthlahnah la poeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A hinglu aka ngaithuen long tah a ka a tuem, a ka aka ang soeh khaw amah ham porhaknah la om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kolhnaw loh a ngaidam dae a hinglu a thum moenih. Tedae aka haam kah a hinglu tah hah ngaikhoek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aka dueng loh a hong ol te a hmuhuet. Halang tah a borhim tih a hmai tal.
  </para>
  <para style="p">
    <verse number="6" style="v" />Duengnah loh thincaknah longpuei te a kueinah tih, halangnah loh tholhnah a paimaelh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Boei tih ba aka khueh pawt khaw om, vawtthoek dae a boei a rhaeng aka coih khaw om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khuehtawn he hlang kah hinglu tlansum ni. Tedae khodaeng loh tluungnah a yaak moenih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aka dueng kah khosae tah a kohoe tih, halang kah hmaithoi tah a thih pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Althanah loh olpungnah a paek tih, uentonah dongah cueihnah om.
  </para>
  <para style="p">
    <verse number="11" style="v" />A honghi lamkah boeirhaeng khaw yip muei tih, amah kut neh aka coi long tah a ping sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngaiuepnah loh lungbuei aka nue a dangrhoek tih, hingnah thingkung loh ngaihlihnah a cung sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Olka aka hnoelrhoeng loh amah ham lai a koi vetih, olpaek aka rhih te anih loh a rhong ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka cueih kah olkhueng tah hingnah thunsih la om tih, dueknah hlaeh lamloh aka nong sak la om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lungmingnah then tah mikdaithen la a khueh tih, hnukpoh kah longpuei tah mueng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aka thaai loh mingnah neh boeih a saii tih, aka ang loh a anglat te a yaal.
  </para>
  <para style="p">
    <verse number="17" style="v" />Halang puencawn tah yoethae ah cungku tih, oltak kah laipai tah hoeihnah la om.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khodaeng neh yah loh thuituennah a hlahpham tih, toelthamnah aka tuem tah a thangpom.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngaihlihnah a dip te hinglu ham khaw tui dae, aka ang long tah boethae lamloh nong ham te tueilaehkoi la a om pah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang cueih taengah aka cet la aka cet tah cueih rhoela cueih tih, hlang ang neh aka luem tah lolh coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlangtholh rhoek te yoethae loh a hloem dae, aka dueng te hnothen neh a thuung.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang then long tah a ca kah a ca khaw a phaeng dae, laihmu kah a thadueng tah hlang dueng hamla a khoem pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khodaeng kah khohai cang tah thawt tangloeng dae, tiktamnah a om pawt dongah a khoengvoep.
  </para>
  <para style="p">
    <verse number="24" style="v" />A ca aka thiinah loh a cungcik a hnaih, tedae aka lungnah tah thuituennah neh a toem.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hlang dueng loh a hinglu dongah kodam la a caak dae, halang tah a bung a vaitah.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlang cueih nu loh a im a sak dae, anglat long tah a kut neh a koengloeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />BOEIPA aka rhih tah a dueng la cet dae, a longpuei kho aka hmang loh BOEIPA a hnaep.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hlang ang kah a ka ah hoemnah kuhci om tih, aka cueih rhoek kah hmuilai loh amamih te a ngaithuen sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Saelhung a om pawt vaengah kongduk khaw caih dae, vaito thadueng lamkah canghum cangpai thoeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Oltak rhoek kah laipai tah a laithae moenih. Tedae a honghi kah laipai long tah laithae ni a. sat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmuiyoi loh cueihnah a tlap dae a hong ni, mingnah he aka yakming ham tah yoeikoek mai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang ang te a hmai lamloh caeh tak, mingnah olka te na ming pawt ve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aka thaai kah cueihnah long tah a longpuei te a yakming dae, aka ang kah a anglat tah thailatnah ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aka ang loh hmaithennah te a hnael dae, aka thuem long tah a laklo ah kolonah a saii.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hinglu khahingnah loh lungbuei a ming. Te dongah a kohoenah dongah rhalawt loh boi thil pawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Halang rhoek kah im tah a phae pah vetih aka thuem kah dap tah rhoeng ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Longpuei he hlang kah mikhmuh ah thuem dae a hmailong ah dueknah longpuei la om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nueihbu dongah lungbuei loh thak a khoeih tih, a tloihsoi ah kohoenah khaw pha-ueknah la poeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lungbuei aka balkhong khaw, hlang then khaw a khosing te amah hah bitni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlangyoe long tah olka boeih te a tangnah dae, aka thaai long tah a khokan te a yakming.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aka cueih long tah a rhih tih boethae te a nong tak. Tedae aka ang long tah a paan tih a omtoem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thintoek bangkek loh a anglat a phoe tih, tangkhuepnah aka khueh hlang khaw a hmuhuet uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hlangyoe loh anglat a pang tih, aka thaai rhoek loh mingnah te a muei uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hlang thae rhoek te hlang then rhoek kah mikhmuh ah, halang rhoek te hlang dueng kah vongka ah ngam uh ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khodaeng te a hui long khaw a hmuhuet tih, hlanglen tah muep a lungnah.
  </para>
  <para style="p">
    <verse number="21" style="v" />A hui taengah aka hnoelrhoeng uh tah tholh tih, mangdaeng kodo aka rhen tah a yoethen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Boethae aka uep rhoek te kho a hmang uh moenih a? Tedae sitlohnah neh uepomnah long tah hnothen ni a. caai thil.
  </para>
  <para style="p">
    <verse number="23" style="v" />Patangnah cungkuem loh kumkonah a om sak. Tedae hmuilai dongkah ol bueng ngawn tah tloelnah la poeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khuehtawn he aka cueih rhoek kah a rhuisam la om tih, aka ang rhoek tah anglat la anglat coeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Oltak kah laipai loh hinglu a huul tih, hlangthai palat loh laithae a sat.
  </para>
  <para style="p">
    <verse number="26" style="v" />BOEIPA hinyahnah dongah pangtungnah sarhi khaw om, te dongah a ca rhoek ham hlipyingnah la om.
  </para>
  <para style="p">
    <verse number="27" style="v" />BOEIPA hinyahnah tah hingnah thunsih neh, dueknah hlaeh lamloh aka phaelh sak la om.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pilnam kah cangpai dongah ni manghai kah rhuepomnah khaw a om, namtu a om pawt vaengah mangpa kah porhaknah la om.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thintoek aka ueh tah bahoeng a lungcuei tih, mueihla bangkek loh anglat ni a. pomsang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lungbuei hoeihnah tah pumsa kah hingnah la om tih, thatlainah khaw rhuh keet la poeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tattloel aka hnaemtaek loh amah aka saii ni a. veet, BOEIPA aka thangpom long tah khodaeng a rhen.
  </para>
  <para style="p">
    <verse number="32" style="v" />Halang tah a boethae ah bung tih, aka dueng tah a dueknah rhangneh ying.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aka yakming kah lungbuei ah cueihnah khaw rhaehrhong tih, hlang ang lakli ah khaw ming uh coeng.
  </para>
  <para style="p">
    <verse number="34" style="v" />Duengnah loh namtom a pomsang tih, tholhnah loh namtu te rhaidaeng la a khueh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Manghai kah kolonah loh sal te a cangbam tih, a thinpom loh yah a bai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mongkawt la hlatnah loh kosi khaw a hlam tih, patangnah ol loh thintoek khaw a soeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aka cueih kah a ol loh mingnah te a hloeihhlam tih, aka ang rhoek a ka loh a anglat te a thaa.
  </para>
  <para style="p">
    <verse number="3" style="v" />BOEIPA kah a mik loh hmuen ta kuem kah a thae a then te a tawt.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ol dongah hoeihnah aka om tah hingnah thingkung la om tih, a khuiah saveknah khaw mueihla pocinah ham ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aka ang loh a napa kah thuituennah te a tlaitlaek tih, toelthamnah aka ngaithuen tah muet uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang dueng kah im ah khohrhang khaw khawk, tedae halang kah a cangthaih long tah hlang a lawn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang cueih rhoek long tah mingnah te a haeh dae, aka ang kah lungbuei tah te tlam moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Halang kah hmueih te BOEIPA kah a tueilaehkoi tih, aka thuem kah thangthuinah te a kolonah la a khueh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Halang kah longpuei tah BOEIPA kah tueilaehkoi tih, duengnah aka hloem tah a lungnah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thuituennah caehlong aka hnoo ham tah thae tih, toelthamnah aka hmuhuet tah duek ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Saelkhui neh Abaddon pataeng BOEIPA hmaiah a phoe atah, hlang ca rhoek kah lungbuei aisat te.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah a toel ham te hmuiyoi loh a lungnah pawt dongah, aka cueih te khaw paan laklo pawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungbuei, ko aka hoe tah a maelhmai hlampan tih, lungbuei kah nganboh loh mueihla a rhawp sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka yakming kah lungbuei long tah mingnah khaw mikhmuh khaw a tlap, tedae aka ang kah a ka loh anglat a luem puei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mangdaeng rhoek kah a khohnin tah boeih thae, tedae lungbuei aka then tah buhkoknah toei toei om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thakvoh len tih a khuiah soekloeknah a om lakah BOEIPA hinyahnah dongkah tah a yol khaw then.
  </para>
  <para style="p">
    <verse number="17" style="v" />Buhkak ansam khaw lungnah n'caak atah, hmuhuetnah neh n'caak vaito thapaduek lakah then.
  </para>
  <para style="p">
    <verse number="18" style="v" />Olpungkacan aka huek hlang he sue la om tih, thintoek aka ueh loh tuituknah khaw a duem sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kolhnaw kah longpuei tah hling a buk banghui la om tih, aka thuem kah caehlong tah a picai pah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ca aka cueih loh a napa ko a hoe sak tih, tongpa aka ang loh a manu a hnaep.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lungbuei aka talh ham tah a anglat te a kohoenah tih, hlang lungcuei tah a caeh dueng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Baecenol pawt atah kopoek bing tih, a cungkuem taengah aka uen tah pai.
  </para>
  <para style="p">
    <verse number="23" style="v" />A ka dongkah hlatnah loh hlang ham kohoenah la om tih, olka khaw amah tuetang vaengah tah then tloe pai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlang aka cangbam ham tah saelkhui laedil lamloh hoeptlang hamla hingnah caehlong om hang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thinthah im tah BOEIPA loh a phil pah tih, nuhmai kah rhi te a suem pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kopoek thae he BOEIPA kah a tueilaehkoi tih, ol then te a omthennah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mueluemnah dongkah aka mueluem loh a imkhui a lawn tih, kutdoe aka thiinah tah hing ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hlang dueng kah lungbuei loh ol doo ham khaw a thuep tih, halang kah a ka loh boethae a thaa.
  </para>
  <para style="p">
    <verse number="29" style="v" />BOEIPA loh halang te a lakhla tak tih, aka dueng kah thangthuinah te a hnatun pah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mik kah vangnah loh lungbuei ko a hoe sak tih, olthang then loh rhuhrhong a cang sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hna dongah toelthamnah aka hnatun tah hingnah la om tih, hlang cueih lakli ah rhaehrhong ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thuituennah aka hlahpham loh a hinglu a hnawt tih, toelthamnah aka hnatun tah lungbuei a lai.
  </para>
  <para style="p">
    <verse number="33" style="v" />BOEIPA hinyahnah he cueihnah neh thuituennah la om tih kodonah tah thangpomnah mikhmuh ah a lamhma pah.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlang taengah lungbuei kah rhoekbahnah om dae olka hlatnah he BOEIPA lamkah ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlang kah a longpuei boeih he amah mikhmuh ah khui dae, BOEIPA long tah a mueihla ni a. khiinglang pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na bibi te BOEIPA taengah hal lamtah, na kopoek cikngae bitni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Soeprhaep boeih he amah kah a hlatnah ham BOEIPA loh a saii. Te dongah halang pataeng yoethae hnin kah ham a hlun.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kut neh kut hlaengtang tih lungbuei aka oek boeih BOEIPA kah a tueilaehkoi la a om dongah hmil mahpawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sitlohnah neh oltak loh thaesainah a dawth tih, BOEIPA hinyahnah loh boethae lamkah a nong sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang kah khosing te BOEIPA loh a moeithen vaengah a thunkha rhoek pataeng amah taengah a rhong sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Duengnah neh yol mai cakhaw, a tiktam mueh canghum cangpai lakah then.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang kah lungbuei loh amah longpuei te a moeh tih, BOEIPA loh a khokan a cikngae sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Manghai ka dongkah bihma tah laitloeknah ham ni, te dongah a ka vikvawk boel saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tiktamnah cooi neh coilung tah BOEIPA taeng lamkah ni, sungsa coilung boeih khaw amah kah a bibi ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Duengnah loh ngolkhoel a cikngae sak dongah, manghai rhoek loh halangnah a saii ham tah tueilaehkoi la om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Duengnah hmuilai tah manghai rhoek kah kolonah om tih, a thuem aka thui te a lungnah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manghai kah kosi tah dueknah puencawn ni. Te dongah hlang cueih long ni kosi a daeh sak thai eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Manghai kah maelhmai khosae dongah hingnah tih, a kolonah tah tlankhol vaengkah khomai banghui ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cueihnah lai he sui lakah bahoeng then tih, yakmingnah lai he khaw tangka n'tuek lakah then.
  </para>
  <para style="p">
    <verse number="17" style="v" />Boethae lamloh aka nong hamla a thuem longpuei om tih, a hinglu aka ngaithuen loh a longpuei a kueinah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pocinah kah a hmaiah hoemdamnah om tih, cungkunah kah a hmaiah ah mueihla oeknah a lamhma pah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thinthah neh kutbuem n'tael lakah kodo mangdaeng neh mueihla kunyun te then.
  </para>
  <para style="p">
    <verse number="20" style="v" />Olka neh aka cangbam long tah hnothen a dang tih, BOEIPA dongah aka pangtung tah a yoethen pai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lungbuei aka cueih te aka yakming la a khue uh tih, hmuilai dongkah olding loh rhingtuknah a thap.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungmingnah te a kungmah la aka khueh long tah hingnah thunsih la om tih, aka ang rhoek kah thuituennah tah anglat la poeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aka cueih kah lungbuei tah a ka a cangbam tih, a hmuilai dongah rhingtuknah a thap.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ol then tah, hinglu ham khoitui khoitak bangla didip tih, rhuh hamla hoeihnah la om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hlang mikhmuh ah longpuei te thuem dae a hmailong ah dueknah longpuei la om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thakthaekung kah a hinglu loh amah hamla thakthae tih a ka te a kamcah sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hlang muen loh boethae a vueh tih, a hmuilai dongah hmai bangla rhangto.
  </para>
  <para style="p">
    <verse number="28" style="v" />Calaak hlang loh olpungkacan a haeh tih, hlang aka thet loh boeihlum a pamhma sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kuthlahnah hlang loh a hui a hloeh tih, longpuei a then pawt la a caeh puei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Calaak te moeh hamla a mik aka him tih, a hmui saibaeh loh boethae a cung sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sampok he boeimang rhuisam la om tih, duengnah longpuei kah aka om loh a dang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thintoek aka ueh tah hlangrhalh lakah, a mueihla aka taem khaw khopuei aka ta lakah then.
  </para>
  <para style="p">
    <verse number="33" style="v" />A rhang dongah hmulung khoh cakhaw a laitloeknah boeih tah BOEIPA lamkah ni a om.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuituknah hmueih im dongkah a bae lakah a ommongnah buhkak kamat te then.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlang aka cangbam sal loh hlang yah aka bai capa te a taemrhai vetih, pacaboeina taengah rho a tael ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cak hamla cak am, sui hamla hmai-ulh om, tedae BOEIPA long tah lungbuei ni a. noem.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thae aka huet loh boethae hmuilai kah a honghi te a hnatung tih, talnah ol te hna a kaeng thil.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khodaeng aka tamdaeng tah amah aka saii kung ni a veet, rhainah soah ko aka hoe khaw hmil mahpawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ca rhoek kah a ca rhoek tah patong rhoek kah rhuisam la om tih a napa rhoek te khaw ca rhoek kah a boei a mang la om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlangrhuel hmuilai he a ang ham a rhoeprhui moenih. A honghi kah hmuilai khaw hlangcong hamla koih loeng loeng van pawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kapbaih he a kungmah kah mik ah lungto mikdaithen bangla boeih a hoilae tih a cangbam.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang kah dumlai aka dah loh lungnah a toem dae, olka dongah aka thovael loh a boeihlum khaw a paekboe sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aka ang voei yakhat n'ngawn lakah aka yakming ham tah tluungnah mah a tlaeh pah coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Boekoek loh boethae bueng a tlap dae, anih taengah puencawn muenying muenyang ni a. tueih pa eh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang kah a dueidah a laemhong sak vom neh ka hum uh palueng eh, aka ang kah a anglat nen tah ka hum uh boel eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A then te thae la aka thuung tah a im lamkah a thae te nong rhoe nong mahpawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Olpungkacan a tongnah tah tui a cae sak. Te dongah tuituknah a puek hlanah huu laeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Halang aka tang sak neh hlang dueng aka boe sak, amih rhoi bang te BOEIPA kah a tueilaehkoi ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cueihnah lai ham hlang ang kut dongkah a phu te ba ham lae, a lungbuei neh a om hae moenih.
  </para>
  <para style="p">
    <verse number="17" style="v" />A tue boeih dongah a hui aka lungnah loh, citcai vaengkah ham manuca a cun.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungbuei aka talh hlang loh kut a yuh tih, a hui mikhmuh ah mingphanah rhi a khang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Boekoek aka lungnah loh olpungnah te a lungnah, a thohka te a sang sak tih pocinah a tlap.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungbuei aka voeldak loh hnothen hmu pawt tih, a ol neh hlang aka maelh khaw yoethae ah cungku.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah kah a pha-ueknah ham hlang ang te a cun, te dongah hlang ang kah a napa tah a ko a hoe moenih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungbuei kohoe he si la a hoeih sak tih, mueihla a rhawp vaengah songrhuh khaw a koh sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Laitloeknah a caehlong te phaelh sak ham, halang loh a huep ah kapbaih a loh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cueihnah he aka yakming ham tah amah mikhmuh ah a om pah tih, aka ang kah a mik ah tah diklai khobawt la a om pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Capa aka ang tah a napa ham konoinah la om tih, anih aka cun khaw hmuetphawtnah ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hlang dueng te lai a sah sak khaw, a dueng dongah hlangcong taam ham then pawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A ol aka tuem tah mingnah te aka ming la om tih, mueihla phu tlo aka dingsuek tah hlang lungcuei ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hlang ang pataeng a hil a phah atah aka cueih la, a ka a buem atah aka yakming la a ngai coeng.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hoehhamnah aka tlap loh hlang a paekboe sak tih, lungming cueihnah khaw boeih a thaih thil.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lungcuei taengah hlang ang naep pawh, tedae amah kah lungbuei hliphen ham ni lat a om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Halang ha pawk vaengah nueihbu neh, yah neh kokhahnah la pai bal.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hlang ka lamkah olka tah tui dung bangla, soklong ah aka phuet cueihnah thunsih la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Halang kah a hmai khueh khaw then pawh, laitloeknah aka dueng te aka phaelh ham rhung ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang ang kah hmuilai tah tuituknah ham ha pawk uh tih, a bohnah te a ka loh a khue.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang ang kah a ka tah amah kah porhaknah neh a hmuilai te a hinglu ham hlaeh la om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thet ol he didii bangla om tih, a bung khui la tluektluek kun.
  </para>
  <para style="p">
    <verse number="9" style="v" />A bibi dongah aka uelh khaw kutpo boei kah a manuca la om.
  </para>
  <para style="p">
    <verse number="10" style="v" />BOEIPA ming tah sarhi ham rhaltoengim ni, hlang dueng tah a taengla yong tih a hoep a tlang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hlanglen kah a boeirhaeng tah amah ham sarhi aka tak khorha la om tih, a ngaihlih vaengah vongtung tluk a sang sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang he lungbuei aka sang taengah pocinah a lamhma pah tih, kodonah taengah thangpomnah a lamhma pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hnatun hlan ah ol aka thuung tah anglat ni. Amah khaw te nen te mingthae a phueih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang he a tlohtat vaengah a mueihla loh a cangbam dae, mueihla a rhawp te u long a khoeng eh?
  </para>
  <para style="p">
    <verse number="15" style="v" />Aka yakming kah lungbuei loh mingnah a lai tih aka cueih kah a hna loh mingnah a tlap.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlang kah kutdoe he amah ham long a khui sak pah tih, amah te tanglue kah mikhmuh ah a mawt.
  </para>
  <para style="p">
    <verse number="17" style="v" />A hui te ha pawk la ha pawk hlan tih amah a khe hlan atah, amah kah tuituknah dongah lamhma la aka dueng khaw om.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hohmuhnah te hmolunh loh a paa sak tih, aka tlung rhoi khaw rhak a phih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Boekoek boeina tah sarhi aka tak khorha lakah olpungkacan la om tih, hohmuhnah khaw impuei thohkalh bangla om.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang tah a laithaih lamloh a bung hah tih, a hmuilai kah a vueithaih khaw kum.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lai kut dongah dueknah neh hingnah om tih, amah aka lungnah long ni a thaih te a caak eh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yuu aka lo long tah hnothen a dang tih, BOEIPA taengkah kolonah a dang bal.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khodaeng loh huithuinah neh a voek dae, hlanglen loh a tlung neh a doo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlang he a hui rhoek loh thaehuet thil cakhaw, a manuca lakah a lungnah tih aka ben khaw om van.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hmuilai voeldak neh aka ang lakah amah kah thincaknah neh aka cet khodaeng he then ngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mingnah aka om pawh hinglu khaw then pawh, kho neh aka tanolh long khaw a hmaang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hlang kah a anglat loh amah kah longpuei te a paimaelh pah hatah a lungbuei tah BOEIPA taengah a hmaital.
  </para>
  <para style="p">
    <verse number="4" style="v" />Boeirhaeng tah paya khaw muep a thap pah dae, tattloel tah a baerhoep long pataeng te a nong tak.
  </para>
  <para style="p">
    <verse number="5" style="v" />A honghi kah laipai te hmil pawt vetih, laithae aka sat long khaw poenghal mahpawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlangcong kah maelhmai tah muep a thae sak uh tih, hlang te hlang boeih loh kutdoe neh a paya nahuh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Manuca pataeng aka khodaeng te boeih a hmuhuet uh atah, a baerhoep aisat te a taeng lamloh a lakhla tak ta. A hloem bal akhaw amih te ol a om moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hinglu aka lungnah long tah a lungbuei ah a lai tih, lungcuei long tah hnothen dang hamla a ngaithuen.
  </para>
  <para style="p">
    <verse number="9" style="v" />A honghi kah laipai te hmil pawt vetih, laithae aka sat khaw milh ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Omthenbawnnah he hlang ang ham a rhoeprhui moenih, sal loh mangpa a taemrhai te bahoeng voel moenih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hlang kah a lungming loh a thintoek khaw a hlawt pah dongah, boekoek te a boei a mang neh a poe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manghai kah thinkoeh he sathueng bangla kawk dae, a kolonah he baelhing dongkah buemtui bangla om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Capa a anglat te a napa ham talnah la om tih, a yuu kah hohmuhnah khaw tuicip bangla puh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Im neh boeirhaeng he napa kah rho la om cakhaw, hlang aka cangbam yuu he tah BOEIPA taeng lamkah ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngaknah he ih dongah moo tih, palyal khaw hinglu lamlum.
  </para>
  <para style="p">
    <verse number="16" style="v" />Olpaek aka tuem loh a hinglu a ngaithuen tih, BOEIPA kah longpuei aka hnoel tah duek rhoe duek ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />BOEIPA kah puhlah long tah tattloel te a rhen tih, a thaphu te amah taengla a thuung ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngaiuepnah a om vaengah na ca te toel lah, anih duek sak ham tah na hinglu te thak boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kosi len kah hmulung te tholhphu la a phueih atah na huul cakhaw koep na koei hae ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />cilsuep he hnatun lamtah thuituennah he doe lah. Te daengah ni na hmailong ah na cueih eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlang kah lungbuei ah kopoek muep om cakhaw, BOEIPA kah cilsuep long ni a thoh sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang kah ngaihlihnah tah amah kah sitlohnah he ni. Tedae khodaeng he hlang laithae lakah then ngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />BOEIPA hinyahnah he tah hingnah la om tih, ngaikhuek la a rhaeh sak coeng dongah yoethae loh cawh voel pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kolhnaw long tah bael dongla a kut a puei nawn pataeng a ka khuila a khuen moenih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmuiyoi te na boh daengah ni hlangyoe bangla a muet uh eh. A yakming la na tluung daengah ni. mingnah te a phatuem pueng eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />A napa aka rhoelrhak tih, a manu aka yong sak capa tah yah a poh tih, a khosak khaw tal.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka ca, mingnah olka lamloh palang ham a, thuituennah hnatun ham he na toeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hlang muen kah laipai loh tiktamnah te a hnael tih, halang kah a ka loh boethae a dolh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hmuiyoi rhoek ham tholhphu neh anglat kah a nam ham bohnah a tawn uh coeng.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Misurtui tah hmuiyoi la om tih yu long khaw hue a sak. Te dongah anih loh a palang sak hlang boeih tah cueih voel pawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Manghai kah a mueirhih tah sathueng kah a kawk bangla om tih, anih aka paan ngawn tah a hinglu ni a. phai coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuituknah lamloh aka hoep uh hlang ham thangpomnah la om tih, aka ang boeih long tah tohhaemnah a puek sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kolhnaw loh sikca ah pataeng caai voel pawh. Te dongah cangah ah a dawt tah a dawt dae dang voel pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hlang lungbuei kah cilsuep tah tui aka dung bangla om tih, hlang lungcuei loh a dueh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang pilnu amah kah sitlohnah te boeih a doek dae, oltak hlang te u long a hmuh?
  </para>
  <para style="p">
    <verse number="7" style="v" />A thincaknah neh aka cet hlang dueng tah amah hnukah a ca rhoek khaw a yoethen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Manghai tah laitloeknah ngolkhoel dongah ngol tih, boethae boeih te a mik neh a thaek.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ka lungbuei ka saelh tih ka tholh lamloh ka caihcil,” tila ulong a ti thai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lungto neh lungto khaw, cangnoek neh cangnoek khaw BOEIPA ham a boktlap la tueilaehkoi ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />A khoboe dongah camoe pataeng khaw loha coeng. A bisai loh cil tih a thuem atah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hna loh yaak tih mik loh a hmuh he khaw a boktlap la BOEIPA long ni a saii.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ih he lungnah boeh na khodaeng na pang ve. Na mik a tueng daengah ni. buh na cung eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hno aka lai loh a thae, a thae la a thui tih amah a khawk vaengah tah lat thangthen bal.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sui neh lungvang he khawk mai dae, mingnah hmuilai he tah umponah hnopai bangla kuel.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kholong ham rhi a khang pah vaengkah a himbai neh kholong nu, kholong nu ham a laikoi pah te khaw lo laeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Laithae buh he hlang hamla tui dae, a hnukah a ka dongah lungcang muep baetawt.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kopoek he cilsuep neh cikngae sak lamtah, caemtloek khaw a niing khueh lah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Baecenol he caemtuh loh a hliphen tih a caeh puei. Te dongah a ka neh aka hloih te rhikhang pah boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A manu neh a napa aka hnaep tah a hmaithoi a thih pah vetih, yinthuem kah yinthuem ah hmaisuep la om ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rho he khaw a lamhma lah banlak a kawt dae, a hmailong ah a yoethen mahpawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A thae te, “Ka thuung van ni,” ti nah boeh. BOEIPA mah lamtawn lamtah namah te ng'khang bitni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Coilung neh coilung khaw BOEIPA kah a tueilaehkoi ni. Te dongah hlangthai palat kah cooi tah a then moenih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlang kah a khokan he BOEIPA taeng lamkah ni. Te dongah hlang loh a longpuei te metlam a yakming eh?
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmuencim te a cukhat thil tih olcaeng hnukah a hnukdawn te hlang ham hlaeh la om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Manghai aka cueih loh halang rhoek te a thaek tih, amih te lengkho neh a paluet thil.
  </para>
  <para style="p">
    <verse number="27" style="v" />BOEIPA kah hmaithoi long tah hlang kah a hiil neh a bungko kah a khui khaw boeih a thaih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sitlohnah neh oltak loh manghai te a kueinah tih, sitlohnah loh a ngolkhoel a duel pah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tongpang rhoek kah a thadueng tah amamih kah a boei a mang la om tih, sampok he khaw patong rhoek kah rhuepomnah ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tloh kah a hma a met vanbangla, bungko khui kah hmasoe loh a thae a cing sak.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manghai kah a lungbuei tah sokca tui bangla BOEIPA kut dongah om tih, a ngaih bangla boeih a hoihaeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Longpuei boeih he hlang loh amah mikhmuh nen tah a thuem sak. Tedae BOEIPA long tah lungbuei ni a. khiing a lang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Duengnah neh tiktamnah saii ham te BOEIPA loh hmueih lakah a ngaih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mik dongkah buhuengpomnah neh lungbuei a mungkung he halang rhoek kah tholhnah hmaithoi ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bi haam kah kopoek tah kumkonah la om yoeyah tih, aka cukhat boeih khaw tloelnah la om yoeyah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hong ol lamkah bisai neh thakvoh tah ahonghi la huu tih, dueknah ni kang a toem coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Halang loh a tiktam la saii ham a aal dongah, amamih kah a rhoelrhanah loh amamih a hmuh bitni.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ko aka boi hlang kah longpuei tah kawn dae, aka cil tah a bisai a thuem pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hohmuhnah la aka om yuu neh hoilh aka khueh kah im lakah tah, imphu bangkil ah khosak te then ngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Halang kah a hinglu long tah boethae a ngaidam tih, a mikhmuh kah a hui te khaw rhen pawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmuiyoi loh lai a sah vaengah hlangyoe khaw cueih tih, a cueih hamla a cangbam vaengah mingnah khaw a dang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang dueng long tah halang imkhui khaw a cangbam mai dae, halang rhoek long tah a thae la a paimaelh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tattloel kah a doek te a hna aka buem thil tah, amah a pang van vaengah doo uh mahpawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A huephael kah kutdoe loh thintoek, a rhang dongkah kapbaih loh kosi aka tlung te a daeh sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlang dueng hamtah tah a tiktamnah a saii te kohoenah la om tih, boethae aka saii rhoek ham tah porhaknah la om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlang aka cangbam kah longpuei lamloh kho aka hmang hlang tah, sairhai kah hlangping lakli ah duem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kohoenah aka lungnah aih khaw hlang kah a tloelnah la poeh tih, misurtui neh situi aka lungnah khaw boei mahpawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Halang te hlang dueng ham, hnukpoh te aka thuem ham tlansum la om.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hohmuhnah, konoinah neh yuu taengah olpungkacan la om lakah tah, khosoek khohmuen ah khosak he then ngai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang cueih tolkhoeng kah thakvoh neh situi tah a naikap dae, hlang ang long tah te te a yoop.
  </para>
  <para style="p">
    <verse number="21" style="v" />Duengnah neh sitlohnah aka hloem long tah, duengnah neh thangpomnah dongkah hingnah te a dang ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlangrhalh rhoek kah khopuei te hlang cueih pakhat long ni a paan tih, a sarhi la a pangtungnah uh khaw a phil pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />A ol a ka aka tuem long tah, a hinglu te citcai khui lamkah a hoep a tlang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thinlen, moemlal, a ming ah hmuiyoi long tah, thinpom althanah neh a saii.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kut loh a saii ham a aal dongah kolhnaw kah hoehhamnah loh amah a duek sak ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hnin takuem ah hoehhamnah te a ngaidam dae, aka dueng long tah a paek phoeiah khaw a hnaih moneih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Halang kah hmueih he tueilaehkoi ti bal vaengah, khonuen rhamtat la a khuen bal pueng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Laithae kah laipai tah paltham vetih, aka hnatun hlang long ni a thui yoeyah eh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Halang loh a mikhmuh dawk neh hlang a tanglue sak. Tedae aka thuem long tah a long, long ah a rhuep tih a yakming.
  </para>
  <para style="p">
    <verse number="30" style="v" />BOEIPA aka tlai thil thai cueihnah khaw om pawh, lungcuei khaw om pawh, cilsuep khaw om thai pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Marhang khaw caemtloek hnin kah ham a tawn coeng dae, BOEIPA daengah ni loeihnah a dang.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khuehtawn a yet lakah ming then tuek lah. Tangka lakah, sui lakah, mikdaithen ni aka then.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlanglen neh khodaeng khaw humcuiuh. Amih boeih te khaw BOEIPA long ni a saii.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aka thaai long tah a thae a hmuh vaengah thuh la thuh uh. Tedae hlangyoe long tah a paan dongah lai a sah van.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kodonah neh BOEIPA hinyahnah kah thapang tah, khuehtawn, thangpomnah neh hingnah la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Voeldak kah longpuei ah pael phoh neh a hling a hang om. A hinglu aka ngaithuen long tah te te a lakhla tak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Camoe te a long rhai ah nawn laeh. Te daengah ni a. patong vaengah te lamkah te a nong pawt eh ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlanglen loh khodaeng a ngol thil tih cangpu aka rhong khaw cangpu aka hlah hlang kah sal la om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dumlai aka soem loh boethae te a ah rhoela a ah. Tedae amah kah thinpom caitueng loh a khah bitni.
  </para>
  <para style="p">
    <verse number="9" style="v" />A mik aka then loh a buh te tattloel taengah a tael pah tih a yoethen bitni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmuiyoi te haek lamtah olpungkacan te phuei saeh. Te vaengah dumlai neh a yah neh kangkuen saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lungbuei cim aka lungnah hlang tah a hmuilai khaw mikdaithen la om tih, manghai kah a paya la poeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />BOEIPA kah mik loh mingnah te a kueinah tih, hnukpoh kah olka te a paimaelh pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kolhnaw long tah, “Kawtpoeng neh toltung lakli kah sathueng loh ng'ngawn ni ta,” a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kholong nu kah a ka ngawn tah vaam a dung la om. BOEIPA kah kosi a sah thil te tah pahoi cungku rhoe cungku ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Camoe kah lungbuei ah anglat a hlaengtang pah. Thuituennah caitueng loh a taeng lamkah a lakhla sak bitni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah kah rhoeng sak ham tattloel aka hnaemtaek, hlanglen taengla aka pae khaw, a tloelnah la rhep poeh ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na hna kaeng lamtah aka cueih rhoek kah olka te hnatun, kai kah mingnah he na lungbuei ah dueh lah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te te na ngaithuen atah na bung khuiah khaw dingsuek vetih, na hmuilai dongah khaw boeih cikngae ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tihnin ah namah khaw, na pangtungnah te BOEIPA dongah khueh sak ham ni, nang kan kam ming sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlavai kah cilkhih neh mingnah sawmthum te nang hamla kan daek moenih a?
  </para>
  <para style="p">
    <verse number="21" style="v" />Oltak ol te a tiktam la nang ming sak ham, oltak ol neh na thuung ham neh na tueih ham dae ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tattloel tah a tattloel oeh dongah rheth boeh. Mangdaeng te khaw vongka ah phop boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />BOEIPA loh amih kah tuituknah te a rhoe pah vetih, amih aka mom rhoek te a hinglu a mom pah ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thintoek hlang te luem puei boeh. Sue la aka om hlang taengah khaw mop boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih kah caehlong, caehlong ah na cang vetih, na hinglu te hlaeh dongah na man sak ve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kut yut rhoek lakli ah, laiba dongah rhi aka khang rhoek lakli ah khaw, om boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A thuung ham na khueh pawt atah, balae tih, namah yueng la na thingkong te khuen saeh ne.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khosuen kah khorhi, na pa rhoek loh a suem te rhawt boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hlang ke na hmuh vaengah a bisai thai nen ni manghai rhoek kah mikhmuh ah a pai eh. Hlang mailai tah a mikhmuh ah pai mahpawh.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aka taemrhai taengah buh ang ham na ngol vaengah, na mikhmuh kah aka om te tah, na yakming rhoe na yakming ham om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hinglu neh na boei atah na olrhong ni tumca neh na nuen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Laithae buh la a om dongah amih kah antui te ngaidam boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Boei ham khaw kohnue boeh, na yakmingnah nen khaw toeng dae.
  </para>
  <para style="p">
    <verse number="5" style="v" />A taengah na mik na hoih la na hoih nama? Tedae om hae mahpawh. A phae cawn, cawn vetih, atha bangla vaan ah a ding lamni a ding eh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moeithae kah buh te caak pah boeh. Anih kah antui te khaw ngaidam rhoela ngaidam boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hinglu neh aka nainong bangla amah loh nang taengah, “Ca van, o van,” a ti tangloeng. Tedae, a lungbuei tah nang taengah a khueh moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Namah kah kamat ca na caak te na lok hae vetih, na ol ding ni na poeih rhung eh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang ang hna ah thui pah boeh. Na olthui dongkah lungmingnah te a hnoelrhoeng hae ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khosuen kah rhi te rhawt boeh, cadah kah khohmuen te khaw cuk thil boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah, amih aka tlan tah tlungluen tih, amih kah tuituknah te nang taengah ni han suk eh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thuituennah he na lungbuei ah, mingnah ol he na hna ah dueh lah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuituennah dongah camoe te hloh boeh. Cungcik neh anih na boh akhaw duek aih mahpawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang loh caitueng neh na taam cakhaw, a hinglu ni saelkhui lamkah na huul pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka ca, na lungbuei ni a. cueih atah, kai khaw ka lungbuei a kohoe van ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka kuel pataeng sundaep ngawn ni ta, na hmuilai loh vanat la a thui vaengah te.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hlangtholh rhoek taengah na lungbuei te thatlai boel saeh. Tedae BOEIPA mah hnin takuem ah hinyahnah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khohmai he a om pueng oeh dongah na ngaiuepnah khaw muei mahpawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka ca nang loh hnatun lamtah cueih lah. Te vaengah na lungbuei kah a longpuei khaw uem van saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amih yumii taengah, maehkai taengah om boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yumii neh carhut long tah khodaeng a pang vetih, ihdut long khaw hnipen ni a. bai eh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang aka cun na pa ol te hnatun lamtah, na nu khaw a patong vaengah hnoelrhoeng boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Oltak he vawtthaih lamtah cueihnah, thuituennah, yakmingnah khaw yoi boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Omngaih coeng, omngaih coeng, hlang dueng aka cun a napa tah omngaih rhoela omngaih coeng. Hlang cueih aka cun khaw a soah a kohoe coeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na nu neh na pa te a kohoe saeh lamtah nang aka cun khaw omngaih saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka ca na lungbuei te kamah taengla m'pae. Na mik loh ka longpuei he a ngaingaih la khueinah saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pumyoi he vaam a dung, kholong nu khaw tangrhom caek la om.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anih khaw dingca bangla rhongngol tih, hlang rhoek taengah hnukpoh la a thap pah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anunae, unim ca te, ngaisahueng la unim ca te, unimca olpungkacan neh hohmuhnah, kohuetnah aka khueh te unim ca? Lungli lungla la tloh aka yook te unim, a mik aka lingduk te unim.
  </para>
  <para style="p">
    <verse number="30" style="v" />Misurtui dongah aka bol, yu hoem hamla aka pong dae ni te.
  </para>
  <para style="p">
    <verse number="31" style="v" />Misurtui te sungsa dongah a thimyum la a lang vaengah, a mikhmuh boengloeng khuiah vanat la a caeh vaengah khaw so boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hmailong ah rhul kah a tuk bangla, rhulthae kah a phuh bangla om ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na mik loh a lang la a hmuh vetih, na lungbuei long khaw calaak ol ni a thui eh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tuitun tuilung kah aka yalh bangla, cungkui soi ah aka yalh bangla na om ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai he n'taam uh dae a tloh moenih, kai n'thoek uh dae ka yaak moenih. Me vaengah nim ka haenghang vetih a tloe neh ka khoep ham ka hmuh ve,” na ti hae ni.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlang thae rhoek taengah thatlai boeh. Amih taengah om hamla nai rhoe nai boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amih kah lungbuei loh rhoelrhanah te a taeng tih, a hmuilai loh thakthaenah ni a. thui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cueihnah neh im a sak tih a lungcuei neh a thoh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mingnah loh boeirhaeng neh a kuel a ka, a naep a noi boeih khaw imkhui ah a khawk sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cueih he tah hlang kah sarhi la om tih, mingnah loh hlang kah thadueng a cong pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Caemtloek vaengah nang hamla a niing hang hol vetih, uentonah cungkuem neh loeihnah hang khueh ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cueihnah he aka ang ham tah sang aih. Vongka ah a ka a ong pah moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thaehuet ham aka moeh tah, “Tangkhuepnah boei,” la a khue uh ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anglat kah a tholh khaw khonuen rhamtat, hmuiyoi hlang khaw tueilaehkoi ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Citcai tue vaengah na tahah tih, na thadueng khaw tla.
  </para>
  <para style="p">
    <verse number="11" style="v" />Duek sak ham a khuen uh te huul uh laeh, ngawnnah la aka yalh te khaw hloh uh laeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Ka ming uh moenih ko he,” na ti cakhaw, amah loh lungbuei a khiinglang tih yakming mahpawt a? Na hinglu aka kueinah loh a ming ta. Te dongah hlang he amah kah bisai bangla a thuung ni ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka ca, khoitui tah then tih ca lah. Khoilitui tah na ka dongah didip ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cueihnah te na hinglu ham ming van lah. Na hmuh atah na hmailong khui vetih, na ngaiuepnah khaw yoe mahpawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Halang aw, hlang dueng tolkhoeng ke rhongngol thil boeh, a kolhmuen te khaw rhoelrhak pah boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aka dueng tah voei rhih a cungku akhaw koep thoo dae, halang rhoek tah yoethae nen ni a. tongtah uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na thunkha, na thunkha te a cungku vaengah kokhahnah boeh, a paloe vaengah khaw na lungbuei omngaih sak boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />BOEIPA loh a hmuh vaengah a mik lolh vetih, anih taengkah a thintoek te vik lat ve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thaehuet dongah sai boeh. Halang rhoek taengah khaw thatlai boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Boethae ham a hmailong a khui pah moenih, halang kah hmaithoi khaw a thih pah ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka ca, BOEIPA khaw, manghai khaw rhih lah. Aka thovael neh pitpom boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amih te rhainah loh buengrhuet a pai thil vetih, amih rhoi kah yoethaenah te ulong a ming?
  </para>
  <para style="p">
    <verse number="23" style="v" />He rhoek khaw hlang cueih kah a hut ni. Laitloeknah dongah maelhmai loha sak khaw then pawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Halang te, “Na dueng,” aka ti nah tah, amah te pilnam loh a tap vetih, namtu loh kosi a sah thil ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae amih aka tluung rhoek te hoel ti vetih, a soah yoethennah hnothen loh a thoeng pah ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Langya la olka aka mael tah, a hmuilai te a mok pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na bibi te vongvoel ah khaw cikngae sak. Anih te a hnukah na lo ah a sikim phoeiah na im te thoh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na hui te ahong mai neh laipai la om thil boeh. Namah kah hmuilai neh na hloih a?
  </para>
  <para style="p">
    <verse number="29" style="v" />“Kai taengah a saii bangla amah te ka saii van ni, hlang te amah kah bisai bangla ka thuung ni,” ti boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kolhnaw hlang kah lohma longah khaw, lungbuei aka talh hlang kah misur taengah khaw ka cet coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lo pum ah dohui daih tih, canghli ah lota loh a thing. A vongtung dongkah lungto khaw a koengloeng coeng ke.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka hmuh vaengah kai long tah, ka lungbuei ah ka khueh tih, ka sawt vaengah thuituennah la ka loh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bet ip, bet ngam, kut bet a poem neh yalh pahoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah na khodaeng loh aka cetpaitai bangla, na tloelnah loh photling aka bai hlang bangla ha pawk.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tahae Solomon kah rhoek he Judah manghai Hezekiah kah hlang rhoek loh a puen uh bal.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathen kah thangpomnah loh olka te a thuh tih, manghai kah thangpomnah long tah olka te a khe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Buhuengpomnah he vaan ah, a laedil bal khaw diklai ah. Te dongah manghai rhoek kah lungbuei he khenah om pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngun te a aek met pah. Te daengah ni hnopai aka saii ham khaw a poeh pa eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Halang khaw manghai mikhmuh lamkah loh haek uh. Te daengah ni a ngolkhoel loh duengnah dongah a ngol eh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Manghai mikhmuh ah namah pom uh boeh, a hmuen tuenglue ah khaw pai boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na mik loh a hmuh vanbangla, hlangcong mikhmuh ah na kunyun lakah, “Nang pahoi yoeng dae,” a ti te then ngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe koeloe ham khaw khuen boeh. Meltam khaw, na hui neh na hmai a thae vaengah a bawtnah ah na saii ve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Namah lamkah oelhtaihnah te na hui neh tuituk uh rhoi. Tedae baecenol he tah a tloe la puek sak boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uepom loh nang n'ya vetih nang taengah theetnah loh paa tlaih pawt ve.
  </para>
  <para style="p">
    <verse number="11" style="v" />A buelhmaih la a thui olka tah cak ben dongkah sui thaihthawn la om.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang cueih a tluung vaengah aka hnatun kah a hna dongah sui hnaii, sui himbai la a om pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cangah tue vaengkah vuelsong a dingsuek bangla, uepom laipai long tah amah aka tueih kung taeng neh a boei te khaw a hinglu a caih sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khomai neh khohli khaw om dae khonal a om pawt bangla, aka yan uh hlang kah kutdoe khaw a honghi ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thinsen rhangneh rhalboei a hloih thai tih, mongkawt ol loh songrhuh a khaem thai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khoitui na hmuh te a rhoeh ah na caak mako, n'lawt vetih na lok ve.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na kho te na hui im ah a rhoeh la hawn sak aih, nang n'hnuenah vetih namah te m'hmuhuet ve.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hui taengah a hong laipai la aka phoe hlang tah caemboh, cunghang neh thaltang aka haat bangla om.
  </para>
  <para style="p">
    <verse number="19" style="v" />Citcai tue vaengah hnukpoh pangtungnah ngawn tah, no hom, kho aka haeh banghui pawn ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Boethae lungbuei te laa neh aka hlai khaw, khosik tue vaengah himbai aka pit, a thuui dongah lunghuem bangla om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lunguet khaw a pongnaeng atah buh cah lamtah, a halh bal atah tui tul.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah ni nang kah hmai-alh te a lu dongla poep uh coeng tih, BOEIPA loh nang yueng la a thuung ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tlangpuei yilh loh khonal hang khuen. A huephael kah olka loh a mikhmuh ah kosi a sah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Imkhui ah huta kah olpungkacan neh hohmuhnah hloih dongkah lakah tah, imphu kah yael ah khosak he then ngai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khohla bangsang kho lamkah olthang then khaw buhmueh rhathih vaengkah hinglu ham tui ding bangla om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuisih loh rhong tih thunsih loh a nu banghui la, aka dueng loh halang mikhmuh ah a yalh pah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khoitui muep caak ham neh, thangpomnah loh a thangpomnah neh khenah he then pawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vongtung aka tal khopuei neh, a mueihla kah tungaepnah aka tal hlang tah sut rhawp.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khohal kah vuelsong neh cangah vaengkah khotlan baghui la, thangpomnah khaw hlang ang neh rhoeprhui tangloeng pawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vaa a rhaehba bangla, pumpil a ding bangla, rhunkhuennah he lunglilungla la a thoeng moenih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Marhang ham rhuihet, laak ham kamrhui, aka ang rhoek kah a nam ham cungcik om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hlang ang kah a anglat te doo boeh, namah khaw anih bangla na om ve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hlang ang te a anglat bangla a doo dae, a mikhmuh ah hlang cueih la om hae mahpawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang ang kut ah ol aka pat tah a kho a kuet tih kuthlahnah aka mam la om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka khaem kah a kho sut a bat banghui la, hlang ang rhoek ka kah thuidoeknah he khaw om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlang ang taengah thangpomnah paek he, payai dongah lungto mop banghui la om tangloeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang ang ka kah thuidoeknah he khaw yurhui kut dongah aka pha mutlo hling bangla om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlang ang aka paang boeih khaw aka cetpaitai a paang tih lithen a poeih banghui la om.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ui loh a lok a paan banghui la hlang ang loh a anglat te a khoep.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang he amah mikhmuh ah tah aka cueih la na hmuh. Anih lakah hlang ang ham ngaiuepnah om ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kolhnaw loh, “Longpuei ah sathueng ca, toltung ah sathueng om,” a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />thohkhaih loh thohrhui dongah a tinghil bangla, kolhnaw khaw amah thingkong dongah suvaih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kolhnaw loh bael dongah a kut a puei te, a ka dongla koep a khuen ham pataeng a ngak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kolhnaw he amah mikhmuh ah tah, omih neh aka thuung hlang parhih lakah aka cueih la ngaiuh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amah hut pawt ah tuituknah khuiah aka kun khaw, aka cetpaitai loh ui hna a doek banghui la om.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thaltang neh dueknah hmaipom aka dong loh hlang a khah bangla,
  </para>
  <para style="p">
    <verse number="19" style="v" />A hui aka phok hlang van loh, “Ka luem mailai moenih a?,” a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing a tlum atah hmai a thi bangla a thet pawt daengah ni olpungkacan a paa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hmai-alh dongah hmaisa-aek, hmai dongah thing a pup vanbangla, hohmuhnah neh olpungkacan aka saii hlang loh tuituknah a puek sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thet ol he didii tih bungko khui la suntla.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lungbuei thae neh a lai hmai la aka alh tah, paikaek dongkah cakhli a ben banghui ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />A hmuilai dongkah a hmuhuet te a ka dongah loha coeng dae, a khui kah hlangthai palat te a thuh bal pueng.
  </para>
  <para style="p">
    <verse number="25" style="v" />A ol tah rhen koemboei la om dae, anih te tangnah boeh. A lungbuei ah tueilaehkoi parhih om.
  </para>
  <para style="p">
    <verse number="26" style="v" />hmuhuetnah te thailainah neh dah cakhaw, hlangping taengah a boethae ni a. yan eh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vaam aka vuet khaw amah loh a cungku thil vetih, lungto aka palet khaw amah soah koep mael ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Laithae ol loh amah aka hnaep aka hnap te a hmuhuet tih, a ka aka hnal khaw a ponah ni a. saii.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thangvuen khohnin ham te yan boeh, khohnin pakhat loh mebang hang khuen ham khaw na ming moenih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlanglak loh nang n'thangthen saeh lamtah, namah kah ka long boel saeh. Kholong long saeh lamtah, namah kah hmuilai long boel saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lungto kah a rhih neh laivin kah a khiing khaw om. Te rhoi lakkah hlang ang kah konoinah tah rhih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kosi kah a muennah neh thintoek lungpook khaw tho coeng dae, thatlainah hmai ah ulae aka pai thai?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmantang kah toelthamnah he, aka thuh uh lungnah lakah then.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lungnah dongah hlang loh n'tloh sak tah tangnah ham om dae, lunguet kah moknah tah rhoekoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka hah kah hinglu loh khoilitui pataeng a suntlae dae, aka pongnaeng kah hinglu long tah khahing khaw boeih a didip sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hmuen lamkah aka poeng hlang khaw, a bu dong lamkah aka coe vaa bangla om.
  </para>
  <para style="p">
    <verse number="9" style="v" />Situi neh bo-ul loh lungbuei ko a hoe sak. Hinglu dongkah cilsuep loh a hui taengah olding la om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Namah hui neh olrhoep khaw na pa kah a hui khaw hnoo boeh. Rhainah hnin ah na manuca kah im te na cet pawt ve ne. A hla kah manuca lakah a yoei kah na imben te then ngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka ca nang cueih lamtah ka lungbuei a kohoe saeh. Te daengah ni kai aka veet te ol ka thuung thai eh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aka thaai long tah boethae a hmuh vaengah a thuh tak, hlangyoe rhoek long tah a paan uh dongah lai a sah uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hlanglak kah rhi a khang pah vaengah a himbai mah lo saeh, kholong nu ham atah a laikoi pa akhaw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mincang a thoh neh ol ue la a hui yoethen aka pae khaw, anih te rhunkhuennah lamni a nawt eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hohmuhnah neh olpungkacan nu khaw, tlanbuk hnin vaengkah tuicip a puh neh vai uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih aka khoem te khohli aka khoem bangla, a bantang kut bueng neh situi aka paco bangla om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thi te thi loh a haat sak bangla, hlang khaw a hui kah mikhmuh long ni a haat sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thaibu aka kueinah loh a thaih a caak vetih, a boei kah bitat aka ngaithuen te a thangpom ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui sokah maelhmai neh a maelhmai a loh uh bangla, hlang kah lungbuei he hlang taeng long ni a tueng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Saelkhui neh Abaddon, Abaddon long tah hah rhoi tlaih pawh. Hlang kah a mik he khaw hah tlaih pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cak hamla cak am, sui hamla hmai-ulh om dae, hlang tah a ka dongkah a hoemnah minguh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang ang te sum khuikah canghum lakli ah sumkhal neh na daeng cakhaw a khui lamkah a anglat te coe mahpawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na boiva kah a hmuethma te ming rhoe ming lah, tuping taengla na lungbuei te khueh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khohrhang he kumhal ham moenih, rhuisam khaw cadilcahma kah cadilcahma, tekah cadilcahma patoeng duela nguel mahpawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sulrham khaw tlaai, toian khaw poe dae tlang kah baelhing bangla a coi uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuca rhoek te na pueinak la, kikong te khohmuen phu la om.
  </para>
  <para style="p">
    <verse number="27" style="v" />Maae suktui carhil ngawn tah na buh la om. na imkhui ham khaw buh la, na hula ham khaw hingnah la coeng.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Halang tah a hloem pawt akhaw rhaelrham khing. Tedae aka dueng tah sathueng bangla amah pangtung uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khohmuen kah boekoek dongah mangpa la yet dae, aka yakming hlang long tah a ming dongah a ram a pai sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hlang he khodaeng loh tattloel patoeng a hnaemtaek he khaw, khotlan loh bet a kawt tih buh a om pawt bangla om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Olkhueng aka hnoo rhoek loh halang te a thangthen uh. Tedae olkhueng aka tuem long tah amih te a huek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hlang thae rhoek loh tiktamnah te yakming uh pawt dae, BOEIPA aka tlap rhoek loh boeih a yakming uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thincaknah neh aka pongpa khodaeng he, longpuei kawnvoi dongkah hlanglen lakah then.
  </para>
  <para style="p">
    <verse number="7" style="v" />Olkhueng aka kueinah capa long tah a yakming dae, carhut neh aka luem loh a napa kah hmai a thae sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />A casai a puehkan neh a boeirhaeng aka tom long khaw, tattloel aka rhen ham ni a. puehkan la a coi pah coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Olkhueng a yaak lalah a hna tlap tlap aka khong tah, a thangthuinah khaw tueilaehkoi la om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aka thuem te longpuei thae la aka palang sak tah cakhom ah amah lah cungku ni. Tedae cuemthuek rhoek long tah hnothen a pang uh ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hlanglen pa he a mikhmuh ah amah aka cueih koek la ngai uh dae, tattloel long khaw aka yakming long tah anih te a khe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aka dueng rhoek a sundaep vaengah muep boeimang tangloeng dae, halang rhoek a thoh vaengah tah hlang loh a thuh tak.
  </para>
  <para style="p">
    <verse number="13" style="v" />A boekoek aka phah he a thaihtak moenih. Tedae aka phoe tih aka hnoo tah a haidam.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka rhih yoeyah hlang tah a yoethen dae, a lungbuei aka mangkhak loh boethae khuila cungku.
  </para>
  <para style="p">
    <verse number="15" style="v" />Halang loh a taemrhai vaengah pilnam tattloel te sathueng bangla a nguel thil tih vom bangla cu.
  </para>
  <para style="p">
    <verse number="16" style="v" />A lungcuei aka talh rhaengsang tah tlungalnah yet. Mueluemnah aka hmuhuet la aka hmuhuet tah a hinglung vang ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinglu kah thii neh hlang aka hnaemtaek hlang tah vaam khuila rhaelrham cakhaw, anih te duel mahpawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cuemthuek la aka pongpa tah daem tih, longpuei aka kawn sak tah vaikhat lam ni a. cungku eh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah khohmuen aka tawn tah caak khaw kum ni. Tedae a hoenghoep bueng aka hloem tah khodaeng la hah ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uepomnah hlang kah yoethennah tah yet. Tedae boei hamla aka tanolh khaw hmil mahpawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Maelhmai a loha khaw then pawh. Tedae buh kamat dongah ni hlang loh boe a koek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang moeithae loh boeirhaeng dongah ngawn tah hlawt let dae, vaitahnah loh anih a thoeng thil te ming pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hlang aka tluung he a hnukah tah a lai aka hnal lakah, mikdaithen la om.
  </para>
  <para style="p">
    <verse number="24" style="v" />A manu neh a napa a rheth lalah boekoek pawt la aka thui tah, kut aka yook ham hlang kah a pueipo la om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mungkung kah hinglu long tah olpungkacan a huek. Tedae BOEIPA dongah aka pangtung ni a. hoeikhang eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amah kah lungbuei dongah aka pangtung tah amah te ang coeng. Tedae cueihnah dongah aka pongpa tah amah khaw hlawt uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khodaeng taengah aka pae tah a tloelnah om pawh. Tedae a mik aka him tah tapvoepnah muep kum.
  </para>
  <para style="p">
    <verse number="28" style="v" />Halang rhoek a thoh vaengah hlang loh a thuh tak. Tedae a milh vaengah aka dueng rhoek khaw pul.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Toelthamnah a om lalah a rhawn aka mangkhak sak hlang tah hoeihnah om kolla pahoi khaem ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlang dueng a pul vaengah pilnam a kohoe. Tedae halang loh a taemrhai vaengah pilnam huei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cueihnah aka lungnah hlang loh a napa ko a hoe sak. Tedae pumyoi neh aka luem loh boeirhaeng khaw a milh sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tiktamnah dongah ni manghai loh khohmuen a pai sak. Tedae kapbaih aka ca hlang loh khohmuen a koengloeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />A hui taengah aka hoem hlang khaw amah khokan dongah ni lawk a tung coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang boethae loh boekoeknah neh hlaeh a tung. Tedae aka dueng tah tamhoe tih a kohoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka dueng long tah tattloel kah dumlai a ming pah. Halang long tah mingnah pataeng a yakming moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Saipaat hlang rhoek loh khorha a sat. Tedae hlang cueih rhoek long tah thintoek pataeng a dolh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang cueih loh hlang ang taengah lai a thui. Tedae a tlai phoeiah tah luem puei cakhaw mongnah om mahpawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thii aka hal hlang rhoek loh cuemthuek te a hmuhuet uh. Tedae aka thuem rhoek long tah a hinglu a toem pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka ang loh a mueihla khaw boeih a poh. Tedae aka cueih long tah a hnuk ah domyok a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hong ol aka hnatung loh a taemrhai vaengah, a bibi rhoek khaw boeih halang uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khodaeng neh hlang kah a hnaephnapnah a humcui rhoi vaengah, BOEIPA loh a boktlap la mik a tueng sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ngolkhoel cikngae yoeyah sak ham atah, tattloel ham khaw manghai loh oltak neh lai a tloek pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cungcik neh toelthamnah loh cueihnah a paek. Tedae a hlahpham camoe loh a manu yah a bai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Halang rhoek a pul vaengah boekoek khaw pul. Tedae aka dueng long tah amih a cungkunah lam ni a. hmuh eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na capa te toel lamtah na duem bitni. Na hinglu ham khaw buhmong m'paek ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mangthui a om pawt atah pilnam khaw pam. Tedae olkhueng aka ngaithuen tah a yoethen pai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ol bueng neh sal a toel thai moenih. Yakming cakhaw hlat hae mahpawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A ol neh aka cahawt hlang khaw na hmuh coeng. Anih lakah hlang ang taengah ngaiuepnah om ngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />A sal te a camoe lamloh aka dom tah, a hmailong ah khoemtloel la a coeng pah ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thintoek hlang loh olpungkacan a huek tih, kosi boei khaw boekoek la muep om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hlang kah a hoemnah loh amah a kunyun sak. Te dongah a mueihla tlarhoel tah thangpomnah loh a moem.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlanghuen taengah boe aka soep tah, a hinglu ni a. hmuhuet coeng. Thaephoeinah ya cakhaw, thui thai mahpawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hlang kah thuennah loh hlaeh ni a. tung eh. Tedae BOEIPA dongah aka pangtung tah sueng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aka taemrhai kah maelhmai khaw muep a tlap uh. Tedae hlang taengkah laitloeknah tah BOEIPA hut ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hlang dueng long tah dumlai te tueilaehkoi a ti. Tedae halang long tah longpuei aka thuem te tueilaehkoi a ti van.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakeh capa Agur kah ol he, Ithiel hlang, Ithiel neh Ukal taengah olphong olrhuh la om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai he hlang lakah ka kotalh ngawn cakhaw, hlang loh kai taengah yakmingnah khueh pawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cueihnah ka cang pawt dae, a cim mingnah te ka ming.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ulae vaan la aka luei tih aka rhum? A kutnarhum dongah khohli aka buem te ulae? Himbai dongah tui aka cun te ulae? Diklai khobawt boeih aka thoh te ulae? A ming ta melae, a capa ming ta balae? na ming atah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen kah olthui boeih tah cilpoe la om. Amah dongah aka ying rhoek ham tah photling la a om pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A ol te thap boeh, namah te n'tluung vetih na laithae phoe ve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namah taeng lamkah te panit ni kam bih. Ka duek hlanah kai taengah hloh boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A poeyoek neh laithae ol tah kai taeng lamloh hla saeh. Kai taengah he khodaeng khaw, khuehtawn khaw m'pae boeh. Ka buhvae dongkah buhham mah kai n'cah mai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka kum vaengah tah ka basa vetih, “BOEIPA te unim,” vik ka ti tholh ve. Ka khawk vaengah ka huen vetih ka Pathen ming te ka pha tholh ve.
  </para>
  <para style="p">
    <verse number="10" style="v" />A boei taeng, a boei taengah sal te thet pah boeh. Namah te thae m'phoei thil vetih, na boe ve.
  </para>
  <para style="p">
    <verse number="11" style="v" />A napa kah cadilcahma aka tap loh a manu te khaw a uem noek moenih.
  </para>
  <para style="p">
    <verse number="12" style="v" />A khawt te sil pawt dae, amah mikhmuh neh aka cim cadilcahma,
  </para>
  <para style="p">
    <verse number="13" style="v" />A mik neh mat pomsang uh tih, a mikkhu aka huel cadilcahma,
  </para>
  <para style="p">
    <verse number="14" style="v" />A no te cunghang bangla, a pumcu te tumcaca bangla, diklai mangdaeng neh khodaeng hlang aka yoop cadilcahma,
  </para>
  <para style="p">
    <verse number="15" style="v" />Vawt canu rhoi loh, “M'pae, m'pae,” a ti. Pathum khaw cung rhoi pawh. Pali khaw, “Rhoeh coeng,” ti rhoi pawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Saelkhui neh caya kah a bung, tui aka hah pawh diklai, rhoeh aka ti tlaih pawh hmai pawn ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />A napa aka tamdaeng tih, a manu kah boengainah dongah aka hnoelrhoeng kah a mik tah, soklong vangak loh a koeih vetih atha ca loh a caak ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih pathum mah kai ham tah khobaerhambae coeng dae, a pili phoeikah amih pali he khaw ka ming thai moenih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vaan ah atha kah longpuei, lungpang dongah rhul kah longpuei, tuitun tuilung kah sangpho longpuei, hula taengkah tongpa longpuei he ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Samphaih nu kah a khosing tah, a caak neh a ka a huih tih, “boethae ka saii pawh,” a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Diklai aka tlai sak pathum neh diklai loh a phueih thai pawh pali tah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Sal te tloep a manghai vaengah, aka ang te buh a hah vaengah,
  </para>
  <para style="p">
    <verse number="23" style="v" />Rhukom te tloep a hmuhuet vaengah, imom loh a boeinu a pang vaengah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Amih pali he diklai hmankah a yit koek la om dae cueih rhoela cueih uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lunghi he a pilnam khaw tlung pawt dae, khohal ah amamih caak te a soepsoei coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Saphih khaw a pilnam te pilnu pawt dae, thaelpang khuiah a im a khueh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaisih te manghai tal dae a pum la huek khong uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Imrhai loh kut neh na tuuk mai tih, amah tah manghai kah bawkim ah na om van bal.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khokan aka yanghoep pathum neh a caeh aka thuem pali tah amih ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sathueng tah Rhamsa boeih lakah tlung tih, a mikhmuh kah boeih tah mael tak pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A cinghen aka caplawh maaetal neh manghai amah taengah aka bop rhoek.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dangrhoek ham vaengah na tahah tih na mangtaeng akhaw na ka te na kut neh buem.
  </para>
  <para style="p">
    <verse number="33" style="v" />Suktui a ken vaengah suknaeng la poeh. Hnarhong a pai vaengah thii long. Thintoek a phul vaengah tuituknah la coeng.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manghai Lemuel kah olka olrhuh. He nen ni amah khaw a manu loh a toel.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ca me tlam lae? Ka bungko lamkah ka capa me tlam lae? Ka olcaeng dong lamkah ka capa me tlam lae?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na thadueng te huta pum dongah pae tarha boeh, na longpuei te manghai rhoek aka khoe ham ni te.
  </para>
  <para style="p">
    <verse number="4" style="v" />Manghai Lemuel ham bueng moenih. Manghai rhoek loh misurtui a ok ham moenih. Boeica rhoek long khaw yu a tuep ham moenih.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ok tih a taem te a hnilh atah, phacip phabaem ca boeih kah dumlai te talh ve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yu te aka milh taengah, misur te a hinglu aka khahing taengah pae uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />O saeh lamtah a khodaeng te hnilh saeh. A thakthaenah khaw koep poek boel saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Olmueh ham khaw, cadah cadum ca boeih kah dumlai ham khaw na ka te ong pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na ka te ong lamtah duengnah neh laitloek pah. Mangdaeng neh khodaeng te khaw tang sak lah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tatthai nu he unim aka hmu? Lungvang lakah a phu khaw kuel.
  </para>
  <para style="p">
    <verse number="11" style="v" />A boei kah lungbuei khaw anih dongah pangtung tih, kutbuem khaw vaitah pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A boei te hnothen neh a thuung tih, a hing tue khuiah boethae om pawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tumul neh hlamik a tlap tih a kut naep la a saii.
  </para>
  <para style="p">
    <verse number="14" style="v" />thimpom sangpho bangla om tih, amah caak khaw khohla bangsang lamkah hang khuen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khoyin ah thoo tih a imkhui ham maeh, a tanu rhoek ham hma a taeng pah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khohmuen te a mangtaeng tih, amah kutci neh a lai. Misur khaw a tue rhoe la a tue coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />A cinghen te sarhi neh a yen tih, a bantha khaw a huel.
  </para>
  <para style="p">
    <verse number="18" style="v" />A thenpom kah a then te a ten tih, khoyin, khoyin ah a hmaithoi khaw thi tlaih pawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cunghmui te a kut a yueng thil tih, a kutbom neh tahcap a cap.
  </para>
  <para style="p">
    <verse number="20" style="v" />A kutpha loh mangdaeng a koihlawm tih, a kut te khodaeng hamla a yueng pah.
  </para>
  <para style="p">
    <verse number="21" style="v" />A imkhui boeih loh pueinak a lingdik neh a om dongah, vuel tue ah khaw, a imkhui ham rhih voel pawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hniphaih te amah ham a tah tih, a hnitang neh daidi pueinak khaw om.
  </para>
  <para style="p">
    <verse number="23" style="v" />A boei te vongka ah a ming uh tih, khohmuen kah a ham rhoek taengah a ngol sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hni a tah te a yoih tih, lamko te Kanaan taengah a thak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sarhi neh rhuepomnah te a pueinak nah tih, hmailong khohnin ah cupcup nuei.
  </para>
  <para style="p">
    <verse number="26" style="v" />A ka te cueihnah neh a ang tih, a lai dongah sitlohnah olkhueng om.
  </para>
  <para style="p">
    <verse number="27" style="v" />A imkhui ah rhoilaeng khaw a pai tih, thangak buh khaw ca pawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A ca rhoek loh a thoh hang neh anih te a uem uh tih, a boei long khaw anih te a thangthen bal.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huta rhoek loh tatthai la muep a saii uh. Tedae nang long tah amih te a sola boeih na poe coeng.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mikdaithen khaw a honghi ni. Sakthen nu khaw a honghi la om. BOEIPA a rhih dongah ni anih te a thangthen.
  </para>
  <para style="p">
    <verse number="31" style="v" />A kutci te amah taengah pae uh. A bibi dongah amah te vongka ah thangthen uh saeh.
  </para>
</usx>
