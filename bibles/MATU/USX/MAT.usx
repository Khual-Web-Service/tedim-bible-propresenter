<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MAT" style="id">Matthai</book>
  <para style="h">Matthai</para>
  <para style="toc1">Matthai</para>
  <para style="toc2">Matthai</para>
  <para style="mt">Matthai</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />He tah Abraham kah cadil, David kah cadil, Jesuh Khrih kah rhuirhong cabu ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham loh Isaak a sak tih, Isaak loh Jakob a sak, Jakob loh Judah boeinaphung a sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah neh Tamar loh Perez neh Zerah a sak tih, Perez loh Herezon a sak, Hezron loh Aram a sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aram loh Amminadab a sak tih, Aminadab loh Nahshon a sak. Nahshon loh Salmon a sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Salmon neh Rahab loh Boaz a sak rhoi, Boaz neh Ruth loh Obed a sak, Obed loh Jesse a sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesse loh manghai David a sak tih, David neh Uriah kah yurho loh Solomon a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Solomon loh Rehoboam a sak tih, Rehoboam loh Abijah a sak, Abijah loh Asa a sak
  </para>
  <para style="p">
    <verse number="8" style="v" />Asa loh Jehoshaphat a sak tih, Jehoshaphat loh Joram a sak, Joram loh Uzziah a sak
  </para>
  <para style="p">
    <verse number="9" style="v" />Uzziah loh Jotham a sak tih, Jotham loh Ahaz a sak, Ahaz loh Hezekiah a sak,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hezekiah loh Manasseh a sak tih, Manasseh loh Amos a sak, Amos loh Josiah a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Josiah he Babylon la a puennah kungah Jekhoniah neh a manuca rhoek te a sak
  </para>
  <para style="p">
    <verse number="12" style="v" />Babylon la a puennah hnukah, Jekhoniah loh Shealtiel a sak, Shealtiel loh Zerubbabel a sak,
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerubbabel loh Abiud a sak tih, Abiud loh Eliakim a sak, Eliakim loh Azor a sak,
  </para>
  <para style="p">
    <verse number="14" style="v" />Azor loh Zadok a sak tih, Zadok loh Achim a sak, Achim loh Eliud a sak,
  </para>
  <para style="p">
    <verse number="15" style="v" />Eliud loh Eleazar a sak tih, Eleazar loh Matthan a sak, Matthan loh Jakob a sak,
  </para>
  <para style="p">
    <verse number="16" style="v" />Jakob loh Mary kah a va Joseph a sak. Anih lamloh Khrih la a khue Jesuh a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Abraham lamloh David duela a khong la khong hlaili tih, David lamloh Babylon la a puennah duela khong hlaili, Babylon la a puennah lamloh Khrih duela boeih ah khong hlaili lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesuh Khrih kah rhuirhong khaw ana om tangloeng. A manu Mary he Joseph hamla a bae dae a om rhoi hlan ah Mueihla Cim loh bungvawn la a om sak te a ming.
  </para>
  <para style="p">
    <verse number="19" style="v" />A va Joseph tah aka dueng la om tih anih te yan ham a ngaih pawt dongah toeng hamla duem cai.
  </para>
  <para style="p">
    <verse number="20" style="v" />He a poek vaengah, boeipa kah puencawn loh anih taengla a mang ah pakcak a phoe pah tih, “David capa Joseph Mary te na yuu la loh ham rhih boeh, anih a vawn he Mueihla Cim rhangnen ni,” .
  </para>
  <para style="p">
    <verse number="21" style="v" />Capa a cun vaengah a ming te Jesuh na sui ni. Anih long tah a pilnam te a tholh khui lamloh a khang ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Boeipa kah a thui te soep sak hamla he he boeih thoeng coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tonghma lamlong khaw, “Oila te bungvawn la om vetih capa a cun ni, a ming tah Emmanuel la a khue uh ni he. Te tah mamih taengah aka om Pathen ni a thuingaih,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joseph tah a ih kung lamkah a thoh vaengah Boeipa kah puencawn loh anih a uen bangla a ngai tih a yuu te a loh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae capa a cun hil Mary te ming pawh. A ming te khaw Jesuh a sui.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manghai Herod tue vaengah Jesuh tah Judah ram Bethlehem ah thang, te vaengah khothoeng ben lamkah kholo hlangcueih rhoek Jerusalem la ha pawk uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Judah manghai aka thaang te melam a om? Anih kah aisi te khothoeng ben ah ka hmuh uh tih, anih bawk hamla ka pawk uh coeng,” a ti uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Manghai Herod loh a yaak vaengah amah khaw, Jerusalem khaw boeih a hinghuen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khosoihham rhoek neh pilnam khuikah cadaek rhoek te boeih a coi tih me kah Khrih nim aka thaang,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Judea Bethlehem ah,” tila tonghma rhoek loh a daek te a a thui pa uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Judah ram kah Bethlehem nang ngawn tah Judah khoboei rhoek khuiah a yit la na om moenih. Nang lamloh hlang aka mawt ha thoeng ni. Anih loh ka pilnam Israel te a dawndah ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Herod loh kholo hlangcueih rhoek te a huep la a khue tih aisi a phoe tue te amih taengah a cae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Bethlehem la a tueih tih, “Cet uh lamtah camoe kawng te khaeh khaeh dawt uh, na hmuh uh vaengah kai taengla, ha puen uh, te daengah ni ka lo vetih anih te ka bawk eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Manghai ol te a yaak uh nen tah vik cet uh. Te daengah khothoeng ah aisi te lawt a hmuh uh. Te dongah amih te camoe om nah a pha hil a lamhma pah tih a soah a pai pah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aisi te a hmuh uh vaengah omngaihnah neha nah la bahoeng omngaih uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Im la a pha uh vaengah camoe neh a manu Mary te a hmuh uh dongah bakop doe ah a bawk uh. Te phoeiah a khohrhang te a ong uh tih a kutdoe la sui, hmueihtui neh myrrh te a paek uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae Herod taengah bal pawt ham a mang ah a mangthui pa tih a kho la a tloe longpuei longah bal uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amih a caeh uh phoeiah Boeipa kah puencawn loh Joseph mang ah pakcak phoe tih, “Thoo, camoe neh a manu te lo, Egypt la rhaelrham laeh, nang taengah kan thui hlan duela pahoi om laeh. Herod loh camoe te poci sak hamla cai tih a toem coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah thoo tih camoe neh a manu te khoyin ah a loh tih, Egypt la cet.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah Herod kah a dueknah rhi hil pahoi om. Te nen ni BOEIPA kah tonghma lamloh a thui tih, “Ka capa te Egypt lamkah ka khue,” a ti te a soep.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah Herod loh kholo hlangcueih kah a tamdaeng te a ming tih bahoeng a thinhul. A tue te kholo hlangcueih taeng lamloh a cae vanbangla Bethlehem khui neh a vaang pum khuikah hlang a tueih tih camoe kum nit hmui te boeih a ngawn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah tonghma Jeremiah lamloh a thui tih,
  </para>
  <para style="p">
    <verse number="18" style="v" />Rhama ah ol a yaak. Rhahnah neh nguekcoinah loh yet. Rakhel loh a ca rhoek te a rhah. Tedae a om uh voel pawt dongah a hloep te ngaih pawh,” a ti te soep.
  </para>
  <para style="p">
    <verse number="19" style="v" />Herod a duek phoeiah, Boeipa kah puencawn tah Egypt kah Joseph mang ah pakcak phoe tih,
  </para>
  <para style="p">
    <verse number="20" style="v" />“Thoo, camoe neh a manu te lo lamtah Israel kho la cet laeh, camoe kah hinglu aka mae rhoek tah duek uh coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah thoo tih camoe neh a manu te a khuen tih, Israel kho la a kun puei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Arkhelas loh a napa Herod yueng la Judea te a uk tila a yaak tih tela caeh ham a rhih. Te cakhaw mang ah a mangthui pah bangla Galilee pingpang la cet.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah Nazareth la a khue khopuei la cet tih kho a sak. Te tlam ni tonghma rhoek lamloh, “Nazaren la a khue ni,” a ti te a soep eh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaeng tue ah tuinuem Johan ha pawk tih, Judea khosoek ah a hoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vaan ram a yoei coeng dongah yut uh laeh, “tila a thui.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih tah, khosoek kah pang ol loh , “Boeipa kah longpuei saelh uh lamtah a caehlong boeih te a dueng la saii uh, tila tonghma Isaiah loh a thui a phong te ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan loh kalauk kah a mul himbai te a bai tih, a pumpu ah maehpho cihin a naak. Tangboeng neh kohong khoitui te a buh la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah Jerusalem, Judah ram boeih neh Jordan pingpang boeih tah anih taengah cet.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amih kah tholhnah te a phong uh dongah Johan loh Jordan tuiva ah a nuem uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pharisee rhoek neh Sadducee rhoek khaw anih kah baptisma dang ham muep ha pawk uh te a hmuh. Te vaengah amih te, “Rhulthae cadil rhoek aka tawn uh kosi te rhaelrham tak ham unim nangmih aka tueng.”
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah yutnah neh a tiing la a thaih te saii uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A pa Abraham om tila nangmih khui thui ham poek uh boeh. Pathen loh hekah lungto rhoek lamloh Abraham kah ca rhoek a thoh sak thai te nangmih taengah kan thui.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thing kah a yung ah hai te a khueh oepsoep coeng tih thaih then aka thaii mueh thingkung te boeih a vung vetih hmai khuila a voeih ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yutnah ham ni kai loh nangmih tui dongah kan nuem. Tedae Kai hnuk ah aka pawk te tah kai lakah tlung. A khokhom dul ham pataeng ka koih pawh. Anih loh nangmih te Mueihla Cim neh hmai neh n'nuem ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loh a kut dongkah rha neh amah kah canghlom te a yah vetih , a cang te khai khuila a khoem ni. Canghi te tah aka duek pawh hmai neh a tih ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah Jesuh tah Johan mah loh nuem sak ham te Galilee lamloh Jordan la ha pawk.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Johan loh anih te a mah tih, “Nang loh nan nuem ham te ka ngoe, dae nang te kai taengah lat na pawk,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae Jesuh loh a doo tih, “Ng 'rhoi laeh, duengnah cungkuem loh mamih taengah a soep la a om ham tueng tangloeng coeng ,” a ti nah daengah anih te a rhoi pueng.
  </para>
  <para style="p">
    <verse number="16" style="v" />A nuem nen tah Jesuh khaw tui lamloh pahoi cet. Te vaengah anih hamla vaan te tarha ong uh tih Pathen kah Mueihla tah vahu bangla anih soah a thoeng pah te a hmuh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah vaan lamkah ol loh , “Hetah ka capa thintlo ni, anih dongah ka lungtlun, “pahoi a ti.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh te rhaithae kah a noemcai hamla mueihla loh khosoek la a mawt.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khothaih hnin sawmli, neh khoyin sawmli a yaeh bawt ah, a bungpong.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah noemcai kung loh anih te a paan tih, “Pathen capa la na om atah hekah lungto he voek lamtah buh la poeh saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Jesuh loh a doo tih, “Hlang he vaidam bueng nen pawt tih, Pathen ka lamkah aka thoeng ol boeih nen mah hing saeh tila a daek coeng ,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah anih te rhaithae loh khopuei cim la a khuen tih, bawkim kah tlungsoi ah a pai sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah amah te, “Pathen capa la na om atah namah cungpung thuk lah, a daek coeng ta, a puencawn rhoek te nang ham a uen vetih, amih kut neh n'dom bitni, na kho khaw lungto neh na tongtah mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesuh loh , “Boeipa na Pathen te noemcai boeh tila a daek van,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah rhaithae loh tlang bahoeng a sang la a khuen tih, “Diklai ram boeih neh a thangpomnah te a tueng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rhaithae loh, “Na bakop tih kai nan bawk atah he rhoek he nang boeih kam paek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesuh loh , “Satan cet, Boeipa na Pathen bueng mah bawk lamtah thothueng tila a daek coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te daengah rhaithae loh a hlah. Te phoeiah puencawn rhoek loh pahoi a paan uh tih Jesuh te a khut uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Johan a voeih uh te a yaak vaengah Galilee la khoe uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nazareth te a hnoo tih, Zebulun neh Naphtali vaang khuikah Kapernaum tuikaeng la pawk tih kho a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te daengah ni tonghma Isaiah loh a thui te a soep eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Zebulun peng neh Naphtali peng, tuipuei kah longpuei, Jordan rhalvangan, namtom rhoek kah Galilee,
  </para>
  <para style="p">
    <verse number="16" style="v" />Yinnah khuikah ngol sut pilnam loh vangnah a len koek a hmuh tih, dueknah hlipkhup kho ah aka ngol rhoek soah vangnah ha thoeng coeng,” a ti.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaeng lamkah ni Jesuh loh , “Vaan ram te a yoei coengdongah yut uh laeh,” tila hoe ham neh thui ham te a tong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Galilee tuipuei kaeng ah a pongpa vaengah, Simon la a khue Peter neh a manuca Andrew te boeina panit a hmuh. Tuihoi la om rhoi tih tuili ah lawk a voeih rhoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah amih rhoi te, “Nangmih rhoi he kai hnukah hlang aka tu tuihoi la kan saii ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah lawk te pahoi hnoo tih anih te a vai rhoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te lamloh a caeh vaengah a tloe kah boeina rhoi panit, Zebedee kah capa James neh a mana Johan tah lawng dongkah a napa Zebedee neh lawk a bo uh te a hmuh tih amih rhoi te khaw a khue.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te rhoi loh lawng neh a napa te pak a hlah rhoi tih bang rhoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesuh loh Galilee kho tom ah cet tih, amih kah tunim ah a thuituen, ram kah olthangthen khaw a hoe, tlohtat boeih neh pilnam khuikah tlohnat boeih te a hoeih sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah a olthang te Syria tom la cet tih, tlohtat a soeprhaep neh tloh aka khueh boeih, nganboh aka yook, rhaithae aka kaem rhoek, rhaihum neh aka khawn rhoek te a taengla a khuen uh tih amih te a hoeih sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Galilee, Decaplois, Jerusalem, Judea neh Jordan rhalvangan lamkah hlangping yetnu loh a vai uh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hmuh neh hlangping taengah tlang la luei tih a ngol vaengah anih te a hnukbang rhoek loh a paan uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah a ka a ong tih amih a thuituen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mueihla khodaeng rhoek tah a yoethen uh, vaan ram te amih kah la om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aka nguek rhoek tah a yoethen uh, amih te a hloep uh ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Muelhtuet rhoek tah a yoethen uh, amih long ni diklai a pang eh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Duengnah te aka hal tih aka pong rhoek tah a yoethen uh, amih tah hah uh ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlang aka rhen rhoek tah a yoethen uh, amih te a rhen uh ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />thinko aka caih rhoek tah a yoethen uh, amih long ni Pathen te a hmuh eh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rhoepnah la aka om rhoek tah a yoethen uh, amih ni Pathen kah ca rhoek la a khue uh eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Duengnah kongah a hnaemtaek rhoek tah a yoethen uh, vaan ram te amih kah ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai kongah nangmih te thuithet tih, hnaemtaek tih laithaethui rhoek loh nangmih soah a thae la boeih n' thui uh vaengah na yoethenuh.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Omngaih uh lamtah hlampan uh. Vaan ah nangmih kah thapang muep om. Nangmih hlankah tonghma rhoek khaw a hnaemtaek uh rhoe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangmih tah diklai lungkaeh la na om uh. Tedae lungkaeh he a dap atah, ba nen lae a al sak eh? Phawn a voeih tih hlang loh a taelh pawt atah coeng voel pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangmih tah Diklai vangnah la na om uh. Tlang soah a thoong khopuei tah khuup thai tlaih pawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hmaiim te a tok uh tih voh hmuiah a khueh uh moenih. Hmaitung soah ni a khueh tih im khuikah rhoek te boeih a tue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmih kah vangnah khaw hlang hmaiah sae tangloeng saeh. Te daengah ni nangmih kah khoboe then te a hmuh uh vetih, vaan kah na pa te a thangpom uh eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Olkhueng neh tonghma rhoek ol he phae hamla ka lo tila poek uh boeh, phae ham pawt tih soep sak ham ni ka lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangmih taengah rhep kan thui, diklai neh vaan a khum hlan khuiah, olkhueng te boeih a soep hlan khuiah, catham khat neh a dek khat pataeng hmata mahpawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah he rhoek kah olpaek rhoek a diknoi khat ca khaw a phae tangkhuet tih hlang aka thuituen te tah vaan ram ah a dikhnawn la a khue ni. Tedae olpaek bangla a saii tih aka thuituen te tah vaan ram ah tanglue la a khue ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangmih taengah kan thui, cadaek rhoek neh Pharisee rhoek kah a voel ah duengnah loh nangmih te m'pueh pawt atah, vaan ram ah na kun kolla na om uh mahpawt nim.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khosuen kah a thui te na yaak uh coeng. Hlang ngawn boeh, aka ngawn te tah laitloeknah om kuekluek saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae nangmih taengah kan thui, a manuca taengah kosi aka hong boeih tah laitloeknah om kuekluek saeh, a manuca te hlangyoe aka ti nah te khaw khoboei taengla pha kuekluek saeh. Hlang ang la aka thui te khaw hell hmai la pha kuekluek saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah hmueihtuk la na kutdoe na khuen vaengah, na manuca loh nang soah khat khat ngaihlih a om te na poek atah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Na kutdoe te hmueihtuk hmai ah pak hlah. Na manuca taengah cet lamhma lamtah moeithen dae, te phoeiah cet lamtah na kutdoe te pae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Longpueng ah amah neh na om li vaengah a loe la na kocaelh te ko a hlawt ham saii laeh. Namah te kocaelh loh laitloekkung taengla n'thak ve. Te vaengah laitloekkung loh tueihyoeih taengla n'thak vetih thongim la n'hla ve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmih taengah rhep kan thui, a hnukkhueng pekhat hil na thuung hlan atah te lamkah na loeih mahpawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Samphaih boeh a ti te na yaak uh coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae nangmih taengah ka thui. Huta te a hue neh aka dan boeih tah, a thinko ah a samphaih puei oepsoeh coeng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na bantang mik loh nang n' khah atah te te koeih lamtah namah lamloh voei. Na pumrho dongkah pakhat a poci akhaw na pum boeih hell la a voeih pawt te nang hamla rhoei bet.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na bantang kut loh nang n' khah atah te te tloek lamtah namah lamloh voei. Na pumrho dongkah pakhat a poci te nang hamla then ngai. Te daengah ni na pum boeih tah hell la a caeh pawt eh.
  </para>
  <para style="p">
    <verse number="31" style="v" />“A yuu aka hla loh yuhlaknah te a yuu taengah pae saeh,” a ti.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae nangmih taengah kan thui coeng. Cukhalnah olka voel ah a yuu aka hla boeih loh a yuu te samphaih sak ham a saii. Te dongah a hlak tangtae aka yunah te khaw samphaih van.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khosuen kah a thui te koep na yaak coeng, basa boeh saw. Tedae na olhlo te boeipa taengah na thuung ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae nangmih taengah toemngam loengloeng boeh ka ti. Vaan nen khaw toemngam boeh. Te tah Pathen kah ngolkhoel ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Diklai nen khaw toemngam boeh. Te tah amah kah kho kah khotloeng ni. Jerusalem nen khaw toemngam boeh, te tah manghai boei kah khopuei ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Na lu nen khaw toemngam boeh. Sam pakhat pataeng a bok neh a muem la na saii thai moenih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah nangmih ol te ue atah ue, pawh atah pawh la om saeh. Tedae he rhoek kah a pueh tah a thae hno lamkah aka thoeng hno ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Mik ham te mik, no ham te no,” a ti te na yaak uh coeng.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nangmih taengah kan thui, a thae te kamkaih boeh, tedae bantang kah na kamrhuh aka bael te pakhat ben khaw a taengla hooi pah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang toe ham neh na angki loh aka ngaih te himbai khaw hlah pah thil.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nang meng khat aka tanolh te, amah te meng nit khaw caeh puei.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nang taengah aka bih te pae. Nang taengah puu hamla aka ngaih te khaw bal sak boeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />“Na imben te lungnah, na rhal te thiinah,” a ti te na yaak uh coeng.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tedae kai loh nangmih taengah kan thui, na rhal rhoek te lungnah lamtah, nangmih aka hnaemtaek rhoek ham thangthui pauh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te daengah ni vaan ah na Pa kah a ca rhoek la na om uh eh. Amah kah khomik te a thae neh a then boeih soah a thoeng sak tih, aka dueng khaw, halang khaw rhotui neh a sul thil.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nangmih aka lungnah te na lungnah uh atah balae thapang na dang eh? Mangmucoi rhoek long pataeng te te a saii uh van moenih a?
  </para>
  <para style="p">
    <verse number="47" style="v" />Na manuca bueng na toidal uh koinih balae a pueh na saii uh tloe, namtom rhoek long khaw te te a saii uh moenih a?
  </para>
  <para style="p">
    <verse number="48" style="v" />Te dongah vaan kah na Pa loh lungcuei la a om bangla nangmih khaw lungcuei la om uh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah nangmih kah duengnah te ngaithuen uh. Te hmuh sak ham hlang hmai ah saii boeh. Te pawt koinih vaan ah na pa taengkah thapang na dang uh mahpawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah doedannah na khueh vaengah, hlang loh a thangpom ham hlangthai palat rhoek lohtunim neh imhlai laklo ah a saii bangla na hmaiah ueng boeh. Nangmih taengah rhep kan thui, a thapang vik a bawt uh coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae doedannah na khueh khaw, na bantang kah a saii te na banvoei loh ming boel saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah na doedannah te a huep la om mai saeh. Te daengah ni a huep a hael kah aka hmu na Pa loh nangmih te n'thuung eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na thangthui uh vaengah hlangthaipalat la om uh boeh. Hlang kah a hmuh ah thangthui ham tunim neh toltung kah a kil ah a pai te a lungnah uh. Nangmih taengah rhep kan thui, a thapang te vik a bawt uh coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na thangthui vaengah na imkhui la kun lamtah na thohka te na khaih phoeiah a huep kah aka om na Pa taengah thangthui. Te daengah ni a huep kah aka hmu na Pa loh nang n'thuung eh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thangthui vaengah namtom rhoek bangla tlawk boeh. A caitawtnah te a hnatun ni tila a poek uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah amih neh na vai uh moenih. Na pa loh na bih hlanah na ngoe te a ming coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah nangmih tah he tlamhe thangthui uh. Vaan kah kaimih napa namah ming tah ciim rhoe pai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na ram tah ha pai saeh. Na kongaih tah vaan kah bangla diklai ah khaw soep saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khohnin rhamhnin kah ham kaimih kah buh he tihnin ah kaimih m'pae lah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaimih sokah laikung rhoek te ka hlah uh bangla, kaimih kah laiba dongah kaimih n'hlah lah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cuekhalhnah khuila kaimih ng'khuen boel lamtah, a thae khui lamkah loh kaimih n'hlawt lah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang te a tholhdalhnah na hlah pah atah, vaan kah na Pa loh nang khaw n'hlah ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlang te tholh na hlah pah pawt atah na pa loh nangmih kah tholhdalhnah te han hlah mahpawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na yaeh uh vaengah hlangthai palat, hmueprhutla rhoek bangla om uh boeh. A yaeh uh te hlang taengah phoe sak ham a maelhmai te a buenglueng uh. Nangmih taengah rhep kan thui, a thapang te vik a bawt uh coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae na yaeh vaengah na maelhmai te sil lamtah, na lu khaw hluk.
  </para>
  <para style="p">
    <verse number="18" style="v" />N'yaeh he hlang taengah pawt tih a huep ah aka om na Pa taengah lat tueng sak. Te daengah ni a huep ah aka hmu na Pa loh nang n'thuung eh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Diklai hmanah namamih ham khohrhang khoem uh boeh. Te ah te keet neh thi-aek loh a caak, hlanghuen loh a muk tih a huen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vaan ah na khohrhang te khoem uh. Te ah te keet om pawh thi-aek long khaw a caak moenih, hlanghuen long khaw muk pawt tih huen pawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na khohrhang a om nah ah ni na thinko khaw a om eh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mik he pum kah hmaiim la om. Te dongah na mik loh cilrhik la a om atah na pum boeih cilping la om ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae na mik te a thae la aom atah na pum tom ah a hmuep la om ni. Te dongah nang kah vangnah te yinnah la a poeh atah te yinnah te nah coeng.
  </para>
  <para style="p">
    <verse number="24" style="v" />Boei panit taengah sal a bi thai moenih. Te dongah Pakhat te a hmuhuet vetih a tloe te a lungnah ni. Pakhat te a talong vetih a tloe te a hnoel ni. Pathen neh laikhuehtawn taengah sal na bi rhenten thai moenih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih taengah kan thui, mebang khaw na caak vetih, mebang na ok ham akhaw, na pum te mebang na bai sak pawt akhaw na hinglu te mawn sak boeh. Hinglu tah buh lakah, pum he khaw himbai lakah olpuei la om pawt nim?
  </para>
  <para style="p">
    <verse number="26" style="v" />Vaan kah vaa rhoek ke so uh lah. Amih loh tuh uh pawt tih at uh pawh, khai ah khaw a sang uh moenih. Tedae vaan kah na pa loh amih te a khut. Amih lakah na tanglue uh moenih a?
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah nangmih khuikah unim aka mawn tih a hinglung te dong khat ham a tom thai?
  </para>
  <para style="p">
    <verse number="28" style="v" />Balae tih himbai ham te na mawn uh? Lohma kah rhaipai ke metla a rhoeng khaw poek lah. Thakthae uh pawh, cunghmui khaw hnuk uh pawh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae nangmih taengah kan thui, Solomon pataeng a thangpomnah boeih neh he kah rhaipai pakhat bangla a bai sak moenih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tihnin ah om tih thangvuen ah hmailing dongla phum hamkoi lohma kah khopol pataeng khaw Pathen loh a phuekhlaak tangloeng atah uepvawt rhoek aw nangmih te muep n'thoeihcam ngai mahpawt nim?
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah, banim ka caak uh vetih banim ka ok uh ve? Banim ka bai uh ve? ti nen khaw mawn uh boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />He rhoek boeih he namtom rhoek long ni a vawtthaih uh. Vaan kah na pa loh na kuek uh boeih te a ming.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae Pathen kah ram neh a duengnah te lamhma la toem uh lah. Te daengah ni he rhoek boeih he nangmih taengah han thap eh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah thangvuen ham mawn uh boeh. Thangvuen amah te mawn bitni. Hnin at kah a phayoenah he amah ah rhoeh coeng.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlang te laitloek thil uh boeh, te daengah ni namamih lai n'tloek thil pawt eh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Laitloeknah neh lai na tloek bangla namamih soah lai han tloek ni. Cungnueh neh na nueh uh te namamih taengah khaw han nueh ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Balae tih na manuca mik dongkah mikdaeng te na hmuh tih na mik kah thingboeng tah na hmat pawh?
  </para>
  <para style="p">
    <verse number="4" style="v" />Na manuca te balae tih, “Na mik kah mikdaeng ng'koeih sak, “na ti eh. Na mik ah thingboeng om ta te.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hlangthai palat aw na mik khuikah thingboeng te lamhma la koeih dae. Te daengah ni na manuca mik kah mikdaeng koeih ham te phaeng na hmuh eh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A cim te ui pae uh boeh, na laitha te ok hmaiah voei boeh. A kho neh a taelh uh phoeiah aka mael loh namamih vik a pawnsoem la ng'khueh ve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bih uh lamtah nangmih te m'paek bitni. Toem uh lamtah na hmuh uh bitni. Khoek uh lamtah nangmih ham ong uh bitni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aka bih rhoek boeih loh a dang tih aka toem rhoek loh a hmuh, aka khoek rhoek khaw a ong pah ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangmih taengah mebang hlang nim aka om. A ca loh buh a hoe vaengah anih te lungto pae tang mahpawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nga a hoe vaengah anih te rhul pae mahpawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih a thae la aka om long pataeng, na ca rhoek te kutdoe then paek ham na ming uh atah, vaan kah na pa loh a taengah aka bih rhoek te hno then muep a paek ngai ni ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah hlang loh nangmih taengah saii sak ham na ngaih uh sarhui boeih te tah namamih long khaw amih ham saii pah van. Hetah olkhueng neh tonghma rhoek ol ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vongka caek longah kun uh. Pocinah la aka khuen vongka tah ka tih longpuei khaw tampahyal mai. Te dongah te longah aka kun rhoek khaw muep om uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hingnah la aka khuen vongka tah caek tih longpuei khaw thet. Te dongah te te aka hmu khaw a yool ni a om.
  </para>
  <para style="p">
    <verse number="15" style="v" />Laithae tonghma rhoek te ngaithuen uh. Amih loh nangmih taengah tu pho neh ha pai uh. Tedae a khuiah kutveet aka khueh uithang la om uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amih te a thaih dongah kangna ming uh bitni. Hling lamloh misur, lota lamloh thaibu thaih a bit uh mai khaming.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah thing then boeih loh a thaih a then la thaii, tedae thing thae tah a thaih a thae la thaii.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thing then dongah a thaih thae cuen thai pawt tih, thing thae dongah a thaih then cuen bal pawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A thaih then aka thaii pawh thingkung boeih te a vung tih hmai khuila a voeih uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah amih te a thaih ah na ming uh mako.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Kai taengah ‘Boeipa, Boeipa,’ aka ti boeih loh, vaan ram khuiah kun mahpawh. Tedae vaan kah a Pa kongaih aka saii rhoek ni a kun eh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tekah khohnin atah kai taengah, 'Boeipa, Boeipa,’ na ming neh ka phong uh, na ming neh rhaithae ka haek uh moenih a? Na ming neh thaomnah khaw muep ka tak sak moenih a?, 'a ti uh ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah amih te, 'Nangmih kan ming pawh, olaeknah aka saii rhoek te kai taeng lamloh mael uh,’ tila ka phong ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Te dongah kai ol he a yaak tih aka saii boeih te tah hlang cueih la a thuidoek ni. Anih tah a im te lungpang soah a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rhotui bo tih tuiva ha lo, khohli te hli tih tekah im te a palet. Tedae lungpang soah a sut dongah bung pawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka ol a yaak dae aka saii pawt boeih tah hlang ang nen ni a vai uh eh. Amih long tah laivin soah ni a im a sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Rhotui bo tih tuili ha lo, hlipuei ha hli vaengah tekah im a daeng tih bung. Tekah a bungnah te tah a tloh la om coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesuh loh ol a khah vaengah a thuituennah soah hlangping tah let uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amih te amamih kah cadaek rhoek banglam pawt tih saithainah aka khueh kah bangla a thuituen.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tlang lamkah a suntlak vaengah anih te hlangping loh muep a vai uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah hmaibae aka khueh loh tarha ham paan. Te vaengah a bawk doela, “Boeipa na ngaih atah, kai nan cim sak thai,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah kut a yueng tih a taek phoeiah, “Ka ngaih, cimcaih pai saeh,” a ti nah tih hmaibae te pahoi cing.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Jesuh loh , “Na thui pawt ham ngaithuen, tedae namah te cet lamtah khosoih taengah tueng. Amih taengah laipainah ham tah Moses loh a uen kutdoe te nawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Kapernaum la a kun hatah, rhalboei loh a taengla a paan.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesuh te a hloep tih, “Boeipa ka ca aka khawn he mat tlo tih im ah yalh,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah anih te, “Kamah ka lo vetih anih te ka hoeih sak bitni ,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rhalboei loh a doo tih, “Boeipa ka imphu hmuiah na kun khaw koihvaih la ka om moenih, na ol neh dawk thui mai, ka ca te hoeih bitni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai khaw saithainah hmuikah hlang ni, kai hmuiah khaw rhalkap rhoek om van. Te dongah pakhat te, “Cet,” ka ti nah atah cet mai. A tloe te khaw, “Lo lah,” ka ti nah vaengah ha lo mai. Ka sal te khaw he he saii ka ti nah atah a saii ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesuh loh a yaak vaengah a ngaihmang tih aka vai rhoek te, “Nangmih taengah rhep kan thui Israel khuiah ka hmuh vaengah tangnah heyet a om moenih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah ni, 'Khocuk neh khotlak lamkah loh muep a paan uh vetih, Abraham, Isaak, Jakob neh vaan ram ah ngolhlung uh ni, 'tila nangmih taengah kan thui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae ram kah a ca tah poengben kah yinnah khuila a haek uh ni. Te ah te rhah neh no rhuengnah om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Jesuh loh rhalboei te, “Cet, Na tangnah bangla nang soah om saeh,” a ti nah. Te vaeng tue ah a ca te khaw hoeih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesuh tah Peter im la pawk. Te vaengah Peter masae te tlo tih a yalh te a hmuh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah a kut te a taek pah hatah anih te satloh loh a hlah. Te dongah thoo tih Jesuh te a doedan.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlaem a pha vaengah, rhaithae aka kaem rhoek te Jesuh taengla muep a khuen uh. Te vaengah mueihla te ol neh a haek tih tloh aka khueh rhoek te boeih a hoeih sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tonghma Isaiah loh a thui tih, “Mamih kah vawtthoeknah he a loh tih tlohtat khaw a phueih coeng,” a ti te soep tangloeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesuh loh a taengvai kah hlangping te a hmuh vaengah rhalvangan la caeh ham ol a paek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah cadaek pakhat loh ham paan tih, “Saya, mela na caeh akhaw, kam vai ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae anih te Jesuh loh, “Metang rhoek tah a khui a khueh uh tih vaan kah vaa rhoek khaw a bu a khueh. Tedae hlang capa tah a lu a tloeng nah te khueh pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tloe a hnukbang loh a taengah, “Boeipa kai tah lamhma la n' caeh sak lamtah a pa te ka vuei dae eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Jesuh loh , “Kai m'vai laeh, amamih aka duek puei vuei ham tah aka duek puei taengah hlah pah nawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesuh te lawng khuila a kun vaengah a hnukbang rhoek loh a vai uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah hlipuei loh tuili soah tarha hli tih, tuiphu loh lawng te dalhdalh a khup. Te vaengah Jesuh tah ip.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah amah te a paan uh phoeiah a thoh uh tih, “Boeipa n'khang lah m'poci uh coeng he,” a ti nahuh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae amih te, “Uepvawt rhoek Balae tih rhalyawp la na om uh?,” a ti nah. Te phoeiah, thoo tih khohli neh tuipuei te a ho hatah suepduem la boeih om.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hlang rhoek khaw a ngaihmang uh tih, “Anih he metlam nim a om? Khohli neh tuipuei long pataeng a ol a ngai pah,” a ti uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesuh te rhalvangan kah Gadarenes kho la pawk. Te vaengah rhaithae aka kaem rhoi tah anih doe hamla phuel khui lamkah loh ha moe rhoi. Rhai thakbat tih te kah longpuei ah pakhat khaw khumpael thai pawh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah tah tarha pang rhoi tih, “Pathen Capa, kaimih rhoi taeng neh nang taengah balae aka om? A tuetang hlanah kaimih rhoi phaep ham nim hela na pawk dae? a ti rhoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amih taeng lamloh a lakhla la om tih ok hui muep luem.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah rhaithae rhoek loh Jesuh te a hloep uh tih, “Kaimih he nan haek atah, ok hui kah a khuila kaimih n'tueih mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah amih te, “Cet uh,” a ti nah. Te dongah te rhoek te ok khuila kun uh. Te vaengah ok hui boeih tah laengpoeng lamloh tuili la voek cu tih tui khuiah duek uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ok vuelh rhoek te yong uh tih khopuei khuila kun uh. Rhaithae aka kaem rhoi kah a kawng te khaw a sikim la puen uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah kho pum loh Jesuh doenah la pawk cet uh. Amah te a hmuh uh vaengah amih vaang lamloh thoeih ham a hloep uh.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah lawng khuila kun tih, a hlaikan daengah amah kho la pawk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah khawn tih thingkong dongah aka yalh te a taengla tarha a khuen pauh. Amih kah tangnah te Jesuh loh a hmuh coeng dongah aka khawn te, “Ngaimong sak, ka ca, tholhnah loh nang n'hlah coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah cadaek rhoek khuikah hlangvang long tah amamih khuiah, “Anih loh a soehsal coeng,” tarha a ti uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesuh loh amih kah poeknah te a hmuh tih, “Balae tih na thinko khui ah a thae na poek uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Na tholh loh n'hlah coeng, 'ti ham neh, 'thoo lamtah cet,’ ti ham he, melae yoeikoek la aka om?
  </para>
  <para style="p">
    <verse number="6" style="v" />Te daengah ni diklai hmankah tholh hlah ham he hlang capa loh saithainah a khueh te na ming uh eh,” a ti nah. Te phoeiah aka khawn te, “Thoo, na phak te khuen lamtah na im la cet,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah thoo tih a im la koe cet.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlangping loh a hmuh vaengah a rhih uh tih, hlang taengah hebang saithainah aka pae Pathen te a thangpom uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesuh te lamkah a khum vaengah, Matthai la a khue hlang pakhat tah mangmu doenah ah a ngol te a hmuh tih, “Kai m'vai lah,” a ti nah. Te dongah thoo tih Jesuh taengah bang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Im khuiah a om vaengah caboei te a vael. Te vaengah mangmucoi rhoek neh hlangtholh rhoek muep tarha ha pawk uh tih Jesuh neh a hnukbang rhoek taengah a vael uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharisee rhoek loh a hmuh uh vaengah a hnukbang rhoek taengah, “Balae tih nangmih kah saya tah mangmucoi rhoek neh hlangtholh rhoek taengah a caak,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae a yaak vaengah, “Sading rhoek loh siboei a ngoe moenih, tedae tloh aka khueh rhoek long tah a ngoe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cet uh lamtah metla a om khaw cang uh saw. Ka ngaih he tah rhennah ni hmueih te moenih. Aka dueng rhoek khue ham pawt tih aka tholh rhoek ham ni ka pawk,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah Johan kah hnukbang loh a a paan uh tih, “Balae tih kaimih neh Pharisee rhoek long tah vawpvawp ka yaeh uh. Tedae na hnukbang rhoek loh a yaeh uh moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesuh loh amih te, “Pacaboeina loh yulueihmuen te a nguek thil thai moenih. Amih a om khuiah tah yulokung loh a om puei ta. Tedae yulokung te amih taeng lamkah loh a khue tue ha pawk vaengah a yaeh uh van bitni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hni pen a cuemsok te himbai rhuem soah a bo moenih. A bawtnah ah te long te himbai ni a dueng tih a pawnnah te a thae la a om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Misurtui a noe te tuitang rhuem khuiah a than moenih. Te pawt koinih tuitang te paeng tih misurtui khaw cae. Te vaengah tuitang khaw poci. Tedae misurtui noe te tuitang a thai dongah a than uh atah bok sueng,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />He rhoek he amih ham a thui vaengah boei pakhat te pakcak cet tih anih te a bawk. Te phoeiah, “Ka canu he paekca ah duek dae na lo tih na kut na tloeng thil koinih hing ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah Jesuh tah thoo tih anih te a hnukbang rhoek neh a vai phai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah kum hlainit khuiah aka thii nu loh a hnuk ah a paan tih a himbai dongkah salaw te a taek pah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah long tah, “Jesuh kah himbai mah ka taek koinih ka hoeih ni,” a ti dongah ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesuh te mael tih huta te a hmuh vaengah, “Ka canu na ngaimong sak, na tangnah loh nang n'khang coeng,” a ti nah. Te vaeng tue lamloh huta tah daem.
  </para>
  <para style="p">
    <verse number="23" style="v" />Boei im la Jesuh a pawk vaengah phavi tum neh hlangping te a sarhingrhup la hmuh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah, “Khoe uh lah, hula he a duek moenih, aka ip ni,” a ti nah. Te vaengah Jesuh te a nueih thiluh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae hlangping te a haek phoeiah kun tih a kut a tuuk pah vaengah hula te thoo.
  </para>
  <para style="p">
    <verse number="26" style="v" />He olthang loh tekah kho boeih te a pha.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te lamloh Jesuh a khum vaengah mikdael panit loh a vai rhoi. Te vaengah pang rhoi tih, “David Capa kaimih rhoi n'rhen lah,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Im la a pawk vaengah Jesuh te mikdael rhoi loh a paan rhoi. Te vaengah Jesuh loh amih rhoi te, “He he ka saii thai tila na tangnah rhoi a?” a ti nah hatah, “Ue, Boeipa,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah amih rhoi kah mik te a taek pah tih, “Nangmih rhoi kah tangnah bangla nangmih taengah om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah a mik a tueng pah. Tedae Jesuh tah thanueih tih amih rhoi te, “Ngaithuen, hlang loh ming boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae cet rhoi tih Jesuh kawng te kho tom ah a doek rhoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amih rhoi a caeh neh rhaithae aka kaem hlang pakhat hnapang te a taengla tarha a khuen uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rhaithae te haek pah tih olmueh te koep cal. Te dongah hlangping tah a ngaihmang uh tih, “Israel khuiah om noek tangloeng pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae Pharisee rhoek loh, “Rhaithae boei rhang nen ni rhaithae a haek,” a ti uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah Jesuh tah khopuei boeih neh vangca tom la cet tih amih kah tunim ah a thuituen. Ram kah olthangthen te khaw a hoe tih tlohtat boeih neh tlohnat boeih te a hoeih sak.
  </para>
  <para style="p">
    <verse number="36" style="v" />A hmuh vaengah amih hlangping ham te a thinphat. Tawnba la a om uh lalah tudawn aka om pawh tu bangla a voeih uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah a hnukbang rhoek te, “Cangah hamla yet ngawn dae bibikung rhoek tah yolca.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te dongah cangah boeipa taengah na thangthui uh daengah ni a cangat la bibikung han tueih eh,” a ti nah.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hnukbang hlainit te a khue tih amih te, rhalawt mueihla, haek sak ham, tlohtat boeih neh tlohnat boeih te hoeih sak ham saithainah a paek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah caeltueih hlainit kah a ming tah he rhoek he ni. Lamhma ah, Peter la a khue Simon neh a mana Andrew, Zebedee capa James neh a mana Johan,
  </para>
  <para style="p">
    <verse number="3" style="v" />Philip neh Bartholomew, Thomas neh mangmucoi Matthai, Alphaeus capa James neh Taddaeus,
  </para>
  <para style="p">
    <verse number="4" style="v" />Kanaan Simon neh amah aka voei Judah Iskariot.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesuh loh hlainit rhoek te a tueih ham a uen vaengah, “Namtom rhoek kah longpuei ah pongpa uh boeh, Samaria khopuei khuila kun uh boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Israel imkhui kah tu aka poci rhoek taengah mah cet uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka cet rhoek loh, 'Vaan ram yoei coeng, 'tila thui lamtah hoe uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tattloel rhoek te hoeih sak uh, aka duek thoh uh, hmaibae cing sak uh, rhaithae te haek uh, a yoe la na dang uh te a yoe la pae uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na cihin khuiah sui, ngun, rhohum te kaelh uh boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Longpueng hamla sungsa, angki yungnit, khokhom conghol khuen uh boeh. Bibikung tah amah caak te a om pah tueng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mebang khopuei neh vangca khuiah na kun uh vaengah, “Te khuikah a tueng la aka om te toem uh lamtah na voei hlan duela naeh uh dae.
  </para>
  <para style="p">
    <verse number="12" style="v" />Im khuila na kun vaengah toidal uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aka koih imkhui ni a om van atah nangmih kah ngaimongnah loh thoeng thil saeh. Tedae a tueng la a om pawt atah nangmih kah ngaimongnah te nangmih taengah ha bal saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangmih te n'doe pawt tih nangmih kah ol a hnatun pawt te tah, te imkhui khaw, khopuei khaw voelh na caeh vaengah na kho kah tangdik te khoek pah uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmih taengah rhep kan thui, “Laitloeknah khohnin ah Sodom neh Gomorrah kho pataeng tekah khopuei lakah phoeng pueng ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Uithang lakli ah tu bangla kai loh nangmih kan tueih ne. Te dongah rhul bangla cueih khueh lamtah vahu bangla caepakyik la om uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hlang rhoek te ngaithuen uh, nangmih te khoboei rhoek taengla n'thak uh ni. Te vaengah nangmih te tunim ah m'bohuh ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai kongah khoboei rhoek neh manghai rhoek hmailah n'khuen uh ni. Amih taeng neh namtom rhoek taengah laipai la na om uh ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae nangmih te n'thak uh vaengah balae, metlam lae na thui eh ti mawn uh boeh. Amah a tue vaengah na thui uh koi nangmih taengah m'paek bitni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te rhoek aka voek la na om uh moenih. Tedae Na Pa kah Mueihla loh nangmih khuiah a thui bitni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Manuca loh manuca, a napa loh a ca te dueknah dongah a voeih ni. Ca rhoek long khaw a manu napa te a tingtoeh vetih a duek sak ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai ming dongah hlang boeih kah a hmuhuet la na om uh ni. Tedae a bawtnah duela aka ueh tah daem ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />He kah kho ah ni nangmih te n'hnaemtaek uh atah a tloe la rhaelrham uh. Nangmih taengah rhep ka thui, hlang capa ha pawk hlan atah Israel khopuei rhoek te na tluek uh mueh mahpawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hnukbang he saya soah a om moenih, sal khaw a boei soah a om moenih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hnukbang te a saya bangla, sal loh a boei bangla a om mah rhoeh coeng. Imkung te Beelzeboul a phoei thil uh atah a imko ngawn tah bahoeng nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah amih te rhih uh boeh. Muekdah la aka om te pumphoe mueh pawt tih a huephael te a ming mueh moenih.
  </para>
  <para style="p">
    <verse number="27" style="v" />A hmuep ah kan thui te vangnah khuiah thui. Na hna ah na yaak te imphu soah hoe uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pum aka ngawn rhoek te rhih uh boeh. Tedae hinglu a ngawn thai moenih. Pum neh hinglu boktlap la hell ah aka poci sak thai te mah rhih uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Vahnup phiknit te pe la a yoih moenih a? Tedae na Pa pawt koinih te rhoek khuikah pakhat pataeng lai ah tla mahpawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangmih lu kah sam pataeng boeih a tae la om coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah rhih uh boeh. Nangmih tah vahnup lakah muep na tiing uh ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah hlangping hmaiah kai aka ming hlang boeih tah vaan kah a Pa hmaiah anih te ka ming van ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae hlang hmaiah kai aka hnawt te tah vaan kah a pa hmaiah anih te ka hnawt van ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Diklai ah ngaimongnah khuen hamla ka pawk tila poek uh boeh. Ngaimongnah ham pawt tih cunghang muk ham ni ka pawk coeng.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai tah hlang pakhat neh a napa, a canu neh a manu, a langa neh a mani phihrha ham ni ka pawk.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hlang kah rhal tah a imkhui ah om ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kai lakah a manu neh a napa aka lungnah te tah kai neh aka tiing la om pawh. Kai lakah a capa neh a canu aka lungnah te khaw kai neh aka tiing la a om moenih.
  </para>
  <para style="p">
    <verse number="38" style="v" />A thinglam a koh kolla ka hnukah aka bang te tah kai neh aka tiing la a om moenih.
  </para>
  <para style="p">
    <verse number="39" style="v" />Amah kah hinglu aka hmutah poci vetih, kai kongah a hinglu aka poci loh te te a hmuh ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nangmih aka doe tah kai ni n'doe. Kai aka doe long khaw kai aka tueih te a doe.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tonghma ming neh tonghma aka doe tah tonghma kah thapang te a dang ni. Hlang dueng ming neh hlang dueng aka doe tah hlang dueng kah thapang te a dang van ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hnukbang ming neh tuiding boengloeng khat ca he kah a yit khuiah pakhat aka tul te tah, nangmih taengah rhep kan thui coeng, a thapang te yoe loengloeng mahpawh,” a ti nah.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh loh a hnukbang rhoek hlainit a uen te a khah vaengah, amamih kah khopuei rhoek ah thuituen ham neh hoe ham te te lamloh thoeih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Khrih kah bibi boeih te Johan loh thongim khui ah a yaak tih a hnukbang rhoek te a tueih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah, “Namah ah naka pawk, a tloe a ka lamso eh?,” patoeng a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesuh loh amih te a doo tih, “Cet uh lamtah na hmuh neh na yaak te Johan taengla puen pa uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mikdael loh a hmuh tih aka khaem loh cet coeng. Hmaibae loh cing coeng, hnapang hnalol loh a yaak coeng. Aka duek khaw thoo tih khodaeng taengah olthangthen a phong coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />U khaw kai kongah a khah pawt atah yoethen la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amih boeih a caeh uh phoeiah Jesuh loh hlangping taengah Johan kawng te a tong tih, “Ba sawt ham nim khosoek khuila na caeh uh? Yilh loh a hlinghloek capu a?
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae ba sawt ham nim na caeh uh? a hnal la aka phuekhlaak hlang te nim? Himbai hnal aka bai ke manghai im ah om uh ke.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ba sawt ham nim na caeh uh? Tonghma a? Thuem, nangmih taengah kan thui, anih tah tonghma lakah olpuei ngai ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />‘Nangmih hmai ah kamah kah puencawn ka tueih ke. Anih loh nangmih hmaiah na longpuei a rhoekbah ni,’ tila anih kawng ni ana daek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih taengah rhep kan thui. Huta kah a cun khuiah tuinuem Johan lakah aka tanglue phoe pawh, tedae vaan ram kah a yit koek pataeng anih lakah a tanglue la om.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuinuem Johan tue lamloh tahae duela vaan ram te a ael thil tih, aka aelkung rhoek loh a poelyoe uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Johan duela tonghma rhoek neh olkhueng loh boeih a phong coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae doe hamla na ngaih uh koinih, halo hamla aka cai Elijah tah Johan coeng ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hna aka khueh loh ya saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae hekah cadil he ba nen lae ka thuidoek lah eh? Hnoyoih hmuen ah ngol uh tih hlang tloe aka khue, aka thui camoe rhoek phek la om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmih hamla phavi ka tum uh akhaw na lam uh pawh. Hlo ka hlai akhaw na rhaengsae uh pawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Johan ha pawk tih a caak a ok pawt hatah, ‘Rhaithae a kaem,’ ati uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hlang capa ha pawk tih a caak a ok hatah, 'Carhut neh yumi hlang la ke, mangmucoi rhoek neh hlangtholh rhoek kah a puei a po,’ a ti uh. Tedae cueihnah khaw a khoboe long ni a tang sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah a thaomnah a kumngai a tueng sak kho rhoek te a yut uh pawt dongah ol a tong tih,
  </para>
  <para style="p">
    <verse number="21" style="v" />Anunae Khorazim nang te. Anunae Bethsaida nang te, Nangmih taeng ah ka thaomnah ka tueng sak he Tyre neh Sidon ah ka tueng sak koinih tlamhni, hmaiphu neh yut uh dingrhae pawn ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae nangmih taengah kan thui. Laitloeknah khohnin ah Tyre neh Sidon tah nangmih lakah a phoeng la om ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kapernaum nang khaw, vaan duela na pomsang uh pawt nim? Saelkhui duela na suntla bitni. Nangmih taengah ka thaomnah ka tueng sak he Sodom ah tueng sak koinih, tihnin duela te om suidae.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae nangmih taengah kan thui. Laitloeknah khohnin ah Sodom kho tah nang lakah a phoeng la om ni,” tila a toel.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tevaeng tue ah Jesuh loh a doo tih, “A pa, vaan neh diklai kah Boeipa nang kan uem tangkik, he rhoek he hlangcueih neh lungming taeng lamkah loh na thuh tih cahmang rhoek taengah na pumphoe coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ue apa na hmaiah kolonah la a om tangloeng dongah ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A pa loh kai he a cungkuem la m'paek coeng. Te dongah pa pawt koinih capa te a ming moenih. Capa pawt koinih pakhat long khaw pa te a ming moenih. Tedae u khaw a ngaih atah capa loh a pumphoe pah coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hnorhih rhoek neh thakthae rhoek boeih te kai taengla halo lah, kai loh nangmih te kan duem sak ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka hnamkun he na pum dongah phuei uh lamtah kamah taeng lamkah he cang uh. Muelhtuet neh thinko tlayae la ka om dongah na hinglu ham duemnah na hmuh uh ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai kah hnamkun tah kodam coeng tih ka hnophueih loh a yanghoep la om,” a ti.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaeng tue kah Sabbath ah Jesuh tah lohma longah cet. A hnukbang rhoek tah a bungpong uh tih cangvuei a yun uh tih koe a kueh a uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae Pharisee rhoek loh a hmuh uh vaengah Jesuh te, “Sabbath ah saii ham a paek pawt te na hnukbang rhoek loh a saii uh ke,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae Jesuh loh , “David neh a taengkah rhoek loh a bung a pong vaengah balae a saii, na tae uh moenih a?
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen im khuila kun tih a hmai kah buh a caak te ta. Te te anih kah a caak tueng la a om moenih, khosoih rhoek bueng pawt atah a taengkah rhoek ham khaw a om moenih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sabbath ah bawkim kah khosoih rhoek loh Sabbath te a poeih dae ommongsitoe la a om uh te olkhueng khuiah na tae uh moenih a?
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae nangmih taengah kan thui, bawkim lakah aka tanglue ngai tah he ah om ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae metla a om khaw na ming uh koinih, rhennah ni ka ngaih hmueih moenih,’ a ti dongah ommongsitoe te na boe sak uh pawt sue.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlang capa tah Sabbath boeipa la om,” a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te lamloh thoeih tih amamih kah tunim la pawk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah kut khaem hlang pakhat khoem om. Te dongah anih a paelnaeh ham te a dawt uh tih, “Sabbath ah hoeih sak ham tueng a?” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae amih te, “Nangmih khuikah tu pakhat mai khaw aka khueh hlang om a te? Te te Sabbath ah rhom khuila cungku koinih lo pawt vetih doek mahpawt a?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang he tu lakah muep tanglue ta. Te dongah Sabbath ah a then saii he tueng ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah tekah hlang te, “Na kut te yueng lah,” a ti nah tih koe a yueng. Te vaengah khat ben kah bangla a then la a hoeih pah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Pharisee rhoek tah cet uh tih anih te poci sak hamla dawtletnah a khueh uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesuh loh a ming vaengah te lamloh khoe uh. Te vaengah anih te hlangping loh muep a vai. Te dongah amih te boeih a hoeih sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae amah te mingpha la saii pawt ham amih te a uen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te daengah ni tonghma Isaiah loh a thui tih,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka sal he ne, anih ni ka coelh. Anih soah ka thintlo ka hinglu loh a lungtlun. A pum dongah ka mueihla ka khueh vetih, namtom taengah tiktamnah a thui ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih long tah oelhtaih mahpawh, hohaem mahpawh. A ol te toltung ah pakhat long khaw ya mahpawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tiktamnah te voelphoengnah la a khuen hlan atah capu aka paep te khaem pawt vetih thut aka nap khaw thih mahpawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ming te khaw namtom rhoek loh a ngaiuep ni,” a ti te a soep eh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah rhaithae a kaem olmueh mikdael te a taengla a khuen uh tih anih te a hoeih sak. Te daengah olmueh te cal thai tih kho a hmuh thai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah hlangping khaw boeih limlum uh tih, “Anih he David capa la om mai khaming,” a ti uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae Pharisee rhoek loh a yaak uh vaengah , “Anih tah rhaithae rhoek kah boei Belzebul nen pawt koinih rhaithae he haek mahpawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amih kah poeknah te a hmuh vaengah, “Amamih aka paekboe ram tah boeih poci tih, amamih aka paekboe khopuei neh im boeih tah cak mahpawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Satan loh Satan te haek koinih amah neh amamih paekboe uh ni ta. Te vaengah a ram loh metlam a pai eh?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kai loh Beezebul rhangneh rhaithae ka haek koinih, na ca rhoek tah u rhangnen lae a haek uh. He dongah amih tah nangmih kah laitloekkung la om uh ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae Pathen Mueihla rhangneh kai loh rhaithae ka haek atah nangmih taengah Pathen kah ram ha pai coeng dongah ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aka tlung te lamhma la a pin pawt atah metlam lae aka tlung kah im khuila a kun vetih hnopai te a poelyoe pah thai eh? a pin phoei daengah ni im te a muk eh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai taengah aka om pawt tah kai neh hlihloeh la om tih, kai taengah aka cut pawt loh a thaek.
  </para>
  <para style="p">
    <verse number="31" style="v" />He dongah nangmih taengah kan thui, tholhnah neh soehsalnah cungkuem dongah hlang he dongah hlah pah ni, tedae, Mueihla ben kah soehsalnah tah tholh hlah mahpawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hlang capa te ol aka tha thil te khaw dongah hlah pueng ni. Tedae Mueihla Cim te aka cal thil te tah tahae tue neh aka lo ham dongah khaw anih te tholh hlah pah mahpawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thing then loh a thaih a then sak tih thing thae loh a thaih a thae sak. Te dongah thing he a thaih loh a mingpha sak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rhulthae rhoek kah casak rhoek, a thae la na om uh lalah metlamlae a then te na thui uh thai eh. Thinko kah a baecoih te na ka loh a thui.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hlang then loh khohrhang then khuikah a then a sat tih, hlang thae loh khohrhang thae khuikah a thae a sat.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae nangmih taengah kan thui, palyal olka aka thui rhoek boeih te laitloeknah khohnin ah hlang loh te ham te olka a thuung uh ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na ol loh n'tang sak vetih na ol loh n'boe sak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te phoeiah cadaek rhoek hlangvang neh Pharisee rhoek loh Jesuh te a doo uh tih, “Saya nang taengkah miknoek hmuh ham ka ngaih uh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae amih te a doo tih, “Boethae neh samphaih cadil rhoek loh miknoek tlap cakhaw, tonghma Jonah kah miknoek pawt atah miknoek m'pae mahpawh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jonah tah nga bung khuiah khothaih hnin thum neh khoyin hnin thum a om bangla hlang capa tah diklai ko khuiah khothaih hnin thum neh khoyin hnin thum om van ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Laitloeknah hnin ah Nineveh hlang rhoek tah hekah cadil taengah pai uh vetih a boe sak ni. Jonah kah olhoe dongah amih yut uh. Tedae hekah aka om he Jonah lakah len dae ta he.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tuithim boeinu tah Solomon kah cueihnah hnatun hamla diklai bawt lamkah loh ha pawk dongah tahae kah cadil he laitloeknah ah a pai thil vetih a boe sak ni. Tedae heah he Solomon lakah aka len om dae ta he.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mueihla thae loh hlang lamkah a coe phoeiah tuihang hmuen boeih ah cet tih duemnah a toem dae hmu pawh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te vaengah ka caeh tangtae te ka im la ka bal ni a ti. Te dongah, a pawk vaengah hoeng, nawt tangtae neh, khoem tangtae, la a hmuh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te phoeiah cet tih amah lakah aka thae mueihla a tloe parhih te amah taengla a khuen. Te phoeiah te rhoek ah kun uh tih kho a sak. Te dongah te hlang te lamhma kah lakah a hnukkhueng kah a om te thae. Tahae kah cadil he khaw rhaithae lam ni a om tangkhuet eh,” a ti. p
  </para>
  <para style="p">
    <verse number="46" style="v" />Hlangping te a voek li vaengah a manu neh a mana rhoek loh anih te voek ham a toem uh tih poeng ah pakcak pai uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Te dongah pakhat loh , “Na nu neh na mana rhoek loh nang voek ham n'toem tih poeng ah pai uh ke,” a ti nah.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te dongah amah aka voek te, “Unim kai manu? U rhoek nim kai mana rhoek?” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te phoeiah a hnukbang rhoek taengla a kut a yueng tih, “Kai manu neh kai mana rhoek la he.
  </para>
  <para style="p">
    <verse number="50" style="v" />Vaan kah a Pa kongaih aka saii te tah ka manuca neh ngannu nganca neh manu la om,” a ti nah.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te hnin ah Jesuh tah im lamloh cet tih tuili kaengah ngol.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah hlangping rhoek tah anih taengah muep tingtun uh. Te dongah amah tah lawng khuiah ngol hamla kun. Tedae hlangping tah tuikaeng ah boeih pai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah amih taengah nuettahnah neh muep a thui tih, “Cangti aka haeh tah cangti haeh la cet ne,
  </para>
  <para style="p">
    <verse number="4" style="v" />Cangti a haeh vaengah a ngen te longpuei ah tla. Te dongah vaa loh a paan tih a kueh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angen tah lungrhong dongah tla tih, laimen muep a om pawt dongah tlek poe. Tedae laimen a dung la aom moenih.
  </para>
  <para style="p">
    <verse number="6" style="v" />A yung a om pawt dongah khomik ha thoeng vaengah tah a kaeng tih koh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angen tah hling khuiah tla tih hling te a rhoeng vaengah tah cang te a huep.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae a ngen tah lai then dongah tla tih a thaih, a ngen yakhat, a ngen sawmrhuk, a ngen tah sawmthum la thaii.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hna aka khueh loh ya saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah hnukbang rhoek loh a paan uh tih, “Balae tih nuettahnah neh amih na voek?,” a ti na uh .
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesuh loh amih te a doo tih, “Vaan ram kah olhuep ming sak ham nangmih taengah m'paek coeng dae te rhoek taengah a paek moenih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aka khueh te tah a paek thil vetih a coih pah ni. Tedae aka khueh pawt te a khueh duen pataeng te a taeng lamkah loh a lat pah ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah ni amih taengah nuettahnah neh ka thui pah. A hmuh uh dae hmat uh pawh. A hnatun uh dae ya uh pawt tih hmuhming uh pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah Isaiah kah tonghma ol te amih taengah,' Hnavue neh na yaak uh vetih na hmuhming uh loengloeng mahpawh. Na hmuh tah na hmuh uh vetih na hmat uh loengloeng mahpawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilnam kah thinko he tah a talh pah coeng. Te dongah hna neh a hnatun uh tloel tih a mik khaw a him uh. A mik neh a hmuh uh tih, hna neh a yaak uh, a thinko neh hmuhming uh tih ha bal uh koinih amih te ka hoeih sak ni,” a ti te soep coeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae nangmih kah mik loh a hmuh tih na hna loh a yaak dongah a yoethen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rhep kan thui, tonghma rhoek boeih neh hlang dueng rhoek loh na hmuh uh te hmuh a hue uh dae hmu uh pawh, na yaak uh te yaak ham akhaw a yaak uh moenih.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Te dongah nangmih loh cangti aka tuh kah nuettahnah he hnatun uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ram kah olka te a yaak dae aka hmuhming pawt boeih tah, rhaithae loh ha pawk atah a thinko ah tuh tangtae a poel a yoe pah. Te tah longpuei kah a haeh coeng te ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungrhong sokah a haeh te tah ol te a yaak vaengah omngaihnah neh tlek aka doe ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae a khuiah a yung a khueh pawt dongah kolkalh ni a om. Tedae olka kongah hnaemtaeknah neh phacipphabaem a om vaengah voeng a khah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hling laklikah a tuh tah ol te aka ya la om dae dilai kah mawntangnah neh khuehtawn kah hmilhmaknah loh ol te a thing tih a tlongtlai la poeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae lai then sokah a tuh tah ol te a yaak tih aka hmuhming la om. Anih tah a ngen yakhat, a ngen sawmrhuk, a ngen thumkip la vuei tih thaihtak,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />A tloe nuettahnah te amih a paek tih, “Vaan ram tah amah lo ah cangti then aka tuh hlang neh vai uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae hlang a ih vaengah a rhal ha pawk tih, cang lak ah paitaang a haeh phoeiah vik cet.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khopol te muem tih a vuei a thaih vaengah tah paitaang te khaw phoe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah a sal rhoek loh a kungmah te a paan uh tih, “Boeipa, na lo ah cangti then na haeh moenih a? Tedae paitaang aka om he me lamkah lae?” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah amih te, “He tah rhal hlang loh a saii,” a ti nah. Te dongah sal rhoek loh a taengah, “Ka cet uh vetih te te yoep sak ham na ngaih a?” a ti na uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae amah loh, 'Pawh, paitaang te na yoep uh vaenngah cang neh rhenten na phu uh ve?
  </para>
  <para style="p">
    <verse number="30" style="v" />Cangah duela bok rhoeng sak mai. Cangah tue ah cangat rhoek te, 'Paitaang te lamhma la yoep uh lamtah hoeh hamla a pok la pok uh, tedae cang te tah kai kah khai khuila khoem uh, 'ka ti nah bitni,’ a ti nah,” te a thui pah.
  </para>
  <para style="p">
    <verse number="31" style="v" />A tloe nuettahnah amih a paek tih, “Vaan ram tah mukang mu phek la om, te te hlang loh a loh tih a lo ah a tue.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te te a mu aka om boeih lakah yiit. Tedae a rhoeng vaengah toian aka om boeih lakah tanglue tih thing la poeh. Te daengah ni vaan kah vaa loh ha pawk uh tih a hlaeng dongah bu a tuk,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />A tloe nuettahnah neh amih te, “Vaan ram tah tolrhu phek la om. Te te huta loh a loh tih vaidam khoi thum khuiah a hlum vaengah boeih a rhoi sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesuh loh he rhoek boeih he nuettahnah neh hlangping taengah a thui. Nuettahnah pawt atah amih taengah ol a thui moenih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te daengah ni tonghma loh a phong, “Nuettahnah neh ka ka ka ong vetih Diklai a tongnah lamloh a thuhphah te ka phoe ni,” a ti te a soep eh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hlangping te a tueih phoeiah im khuila kun. Te vaengah a hnukbang rhoek loh a taengla a paan uh tih, “Lo kah paitaang nuettahnah te kaimih ham thuicaih lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah Jesuh loh a doo tih, “Cangti then aka tuh tah hlang capa ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Lohma tah Diklai ni. Te phoeiah cangti then tah ram kah a ca rhoek ni. Tedae paitaang tah rhaithae kah a ca rhoek ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te te aka haeh rhal te tah rhaithae ni. Cangah tue tah lunglai tue a bawtnah ni. Cangat rhoek tah puencawn rhoek ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah paitaang a yoep uh tih hmai neh a hoeh bangla kumhal kah a bawtnah dongah om van ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hlang capa loh a puencawn rhoek te a tueih ni. Te vaengah thangkui neh olaeknah aka saii rhoek boeih te a ram lamloh a bit uh ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te phoeiah amih te hmai alh khuila a phum uh ni. Te rhoek ah rhah neh, no rhuengnah nen ni a om eh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te vaengah aka dueng rhoek tah Pa kah ram ah khomik bangla sae uh ni. Hna aka khueh loh ya saeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Vaan ram tah lohma ah a thuh sut khohrhang phek la om. Te te hlang loh a hmuh vaengah a thuh tih a omngaihnah neh cet. Te phoeiah a khueh boeih te a yoih tih te kah lohmuen te a lai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te phoeiah vaan ram tah laitha then aka toem hnoyoi hlang phek la om.
  </para>
  <para style="p">
    <verse number="46" style="v" />Laitha a phu aka tlo pakhat la a hmuh dongah, a caeh neh a khueh boeih te a yoih tih a lai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Vaan ram tah tuili khuila lawk aka voei bangla om bal tih namtu cungkuem lamkah khaw a coi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te te a bae vaengah lihmoi la a kawt uh. Te phoeiah ngol uh tih a then te busui khuila a sang uh. Tedae a thae te tah phawn a voeih uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kumhal kah a bawtnah dongah om van ni. Puencawn rhoek loh cet uh vetih aka dueng lakli kah boethae rhoek te a hoep ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te phoeiah amih te hmai alh khuila a voeih uh ni. Te hmuen ah rhah neh no rhuengnah ni aka om eh.,” a ti nah.
  </para>
  <para style="p">
    <verse number="51" style="v" />“He rhoek boeih he na hmuhming uh a?” a ti nah. Amah taengah, “Ue,” a ti uh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te dongah amih taengah, “Vaan ram kah aka bang cadaek boeih tah a khohrhang khuikah a rhuem neh a thai aka pok hlang imkung phek la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesuh loh nuettahnah he bawt a khah tih te lamloh vik nong.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te phoeiah amah tolrhum la pawk tih amamih kah tunim ah amih te a thuituen hatah let uh tih, “Anih kah cueihnah neh a thaomnah he me lamkah nim?
  </para>
  <para style="p">
    <verse number="55" style="v" />“Anih he kutthai capa la aom moenih a? A manu tah Mary la a khue uh moenih a? A mana rhoek khaw James, Josephb, Simon, Judah ta.
  </para>
  <para style="p">
    <verse number="56" style="v" />A ngannu rhoek khaw mamih taengah boeih a om uh moenih a? Te dongah anih taengkah boeih he me lamkah nim?” a ti uh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tedae anih kongah amamih te a khah uh. Te dongah Jesuh loh amih te, “Tonghma he amah im neh amah kah tolrhum pawt atah sawtsit ti om pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tedae amih kah hnalvalnah kongah a thaomnah muep tueng sak pawh.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tevaeng tue ah Jesuh kah olthang te khoboei Herod loh a yaak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah a taengom rhoek taengah, “Anih te tuinuem Johan coeng ni. Anih ni duek lamloh aka thoo coeng. Te dongah ni thaomnah loh anih pum dongah a tueng coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Herod a loh a maya Philip kah yuu rho Herodias kongah Johan te a tuuk, a khih tih thongim ah a khueh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan loh anih te, “Herodias namah ham na khueh tueng pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Johan te ngawn a ngaih dae Johan te tonghma la a khueh uh dongah hlangping te a rhih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Herod kah cunnah a pha vaengah, Herodias canu tah amih lakli ah lam tih Herod te a kohoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah huta kah a bih te tah paek ham olhlo neh a phong.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae a manu kah caemtuh dongah, “Tuinuem Johan kah a lu te baelpuei dongah kai m'pae,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Manghai loh a kothae dae a olhlo neh, aka ngol rhoek kongah paek hamla ol a paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah hlang a tueih tih Johan te thongim khuiah a rhaih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah a lu te baelpuei dongah han khuen tih hula te a paek. Te phoeiah a manu taengla a khuen.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah a hnukbang rhoek loh a paan uh tih rhok te a khuen uh. A up uh phoeiah tah Jesuh taengla pawk uh tih puen uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesuh loh a yaak vaengah, te lamloh amah bueng khosoek hmuen la lawng neh cet. Tedae hlangping loh a yaak vaengah khopuei tom lamloh kho neh a vai uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A caeh vaengah hlangping muep a hmuh hatah amih ham a thinphat tih amih kah tloh te a hoeih sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlaem a pha vaengah a hnukbang rhoek loh a taengla a paan uh tih, “He hmuen he khosoek la om tih a tue khaw khum coeng. Hlangping rhoek he ka tueih uh mai eh, te daengah ni kho khuila cet uh vetih amamih ham caak a lai uh eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Jesuh loh , “Amih caeh ham a ngoe pawh. Namamih loh amih kah a caak ham te pae uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae te rhoek loh , “Vaidam panga neh nga lungnit pawt koinih a tloe ka khueh uh moenih he,” a ti uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae, “Te rhoek te kai taengla han khuen uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah hlangping rhoek te khopol dongah ngolhlung ham ol a paek. Vaidam panga neh nga panit te a loh. Vaan la oeloe tih a uem phoeiah vaidam te a aeh tih hnukbang rhoek a paek. Te phoeiah hnukbang rhoek loh hlangping te a paek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang boeih loh a caak uh tih hah uh. Te phoeiah a coih, a nuei a pil te voh hlainit dongah a bae la a phueih uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huta rhoek neh camoe rhoek thui kolla aka ca rhoek he tongpa thawngnga tluk lo uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlangping te phang a tueih hlanah hnukbang rhoek te lawng khuila kun ham tlek a tanolh tih rhalvangan la a lamhma sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae hlangping te a hlah phoeiah amah bueng thangthui hamla tlang la luei. Hlaem a pha vaengah amah bueng pahoi om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lawng tah lan lamloh phalong muep a pha coeng. Te vaengah hli oel om tih tuiphu loh a hinghuen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesuh tah khoyin bangli ah, tui soah cet tih amih taengla pawk.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amah tuili soah a caeh te a hnukbang rhoek loh a hmuh uh vaengah thuen uh tih, “Mueihla ni,” a ti uh tih rhihnah neh pang uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesuh loh amih te tlek a voek tih, “Na ngaimong sak uh, kai ni, rhih uh boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peter loh a doo tih, “Boeipa nang na om atah, nang taengla tui so longah ka pawk na ham kai he ol m'pae lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah, “Ha lo,” a ti nah. Peter tah lawng khui lamloh rhum tih tui soah a caeh daengah Jesuh taengla a pha.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae khohli a tloh te a hmuh vaengah a rhih tih dalh buek. Te vaengah pang tih, “Boeipa kai n'khang lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesuh loh a kut tlek a yueng tih a tuuk phoeiah Peter te, “Uepvawt aw, balae tih na uepvawt?” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lawng dongah amih rhoi a yoeng rhoi vaengah khohli te dip.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah lawng dongkah rhoek loh Jesuh te a bawk uh tih, “Pathen Capa la na om tangtang,” a ti na uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />A hlaikan uh vaengah Gennesaret kho la pawk uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te hmuen kah hlang rhoek loh amah te a hmat uh dongah te rhoek pingpang tom ah a tueih uh. Te dongah tloh aka kaem boeih te anih taengla a khuen uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah a himbai dongkah salaw taek dawk ham te anih a hloep uh. Te dongah aka taek rhoek tah boeih hoeih uh.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Pharisee rhoek neh cadaek rhoek tah Jerusalem lamloh Jesuh te a paan uh tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Balae tih na hnukbang rhoek loh a ham rhoek kah singyoe te a aek uh? Buh a caak uh vaengah a kut sil uh pawh,” a ti na uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae amih te a doo tih, “Namamih kah singyoe kongah Pathen kah olpaek te balae tih na aek uh van?
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen loh, ‘Na nu neh na pa te hinyah lah. Tedae manu napa aka thet tah dueknah neh duek saeh,’ a ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae nangmih loh, 'Hoeikhang vaengah tah, 'Manu napa khaw, te te kamah lamkah hmueih ni,’ a ti coeng atah,
  </para>
  <para style="p">
    <verse number="6" style="v" />A napa a hinyah pawt moenih,” na ti uh. Te dongah Pathen kah ol te namamih kah singyoe neh na hmil uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hlangthai palat rhoek, Isaiah loh nangmih kawng te phek a phong tih,
  </para>
  <para style="p">
    <verse number="8" style="v" />Pilnam long he a hmui neh kan n'hinyah uh. Tedae a thinko tah kai lamloh voelh hla coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />A poeyoek la kai m'bawk uh tih hlang kah olpaek lamkah thuituennah neh a thuituen uh,’ a ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah hlangping te a khue tih, “Hnatun lamtah hmuhming uh lah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka khuila aka kun loh hlang a poeih moenih. Tedae ka lamkah aka thoeng loh hlang a poeih,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah hnukbang rhoek loh amah a paan uh tih, “Ol he a yaak vaengah Pharisee rhoek a khah te na ming nama?” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae amah loh a doo tih, “A pa loh a ling mueh thingling boeih te vaan loh a phuk ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih te hlah uh, mikdael rhoek tah mikdael rhoek kah longtuengkung ni. Mikdael loh mikdael te longtueng koinih rhom ah bok cungku ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Peter loh a doo tih, “Kekah nuettahnah he kaimih ham thuicaih lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Jesuh loh, “Nangmih khaw lungmong kotalh la na om uh pueng a?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka khuila aka kun boeih te bungpuei la cet tih naat la a pha te na yakming uh pawt nim?
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae ka lamkah aka thoeng tah thinko lamkah ha thoeng dongah hlang a poeih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Poeknah a thae, ngawnnah, samphaihnah, Cukhalnah, huencannah, a honghi neh soehsalnah he thinko lamkah ni ha thoeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hekah rhoek long ni hlang a poeih. Tedae kut muen a la aka ca loh hlang a poeih moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te lamloh a caeh phoeiah Jesuh tah Tyre neh Sidon pingpang la khoe uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah te rhoek vaang lamkah Kanaan nu pakcak ha thoeng tih a pang doela, “Kai he n'rhen lah, Boeipa, David capa, ka canu tah rhaithae a kaem khuengrhueng,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae anih te ol lan pawh. Te dongah a hnukbang rhoek loh a paan uh. Amah te a dawt uh tih, “Anih ke kaimih hnukah pang coeng tih tueih laeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae Jesuh loh a doo tih, “Israel imkhui kah tu aka poci ham pawt koinih n'tueih mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huta te ha pawk vaengah anih te a bawk tih, “Boeipa, kai m'bom dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae a doo vaengah tah, “Ca kah buh te rhawt tih ui ham a tloeng tah a then moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae te long khaw, “Ue ta, Boeipa, ui pataeng a boei rhoek kah caboei lamkah aka bo buhdik te a caak ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah Jesuh loh a doo tih, “Aw huta, nang kah tangnah tah len pai, nang ham tah na ngaih bangla om pai saeh,” a ti nah. Tekah a tue lamloh a canu te hoeih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te lamloh a thoeih vaengah Jesuh tah Galilee tuili la pawk. Te phoeiah tlang la luei tih pahoi ngol.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah hlangping loh amah te muep a paan uh tih, aka khaem rhoek, mikdael rhoek, aka khawn rhoek, olmueh rhoek neh a tloe boeih te amamih neh a khuen uh. Amih te Jesuh kho kungla pak a voeih uh dongah amih te a hoeih sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Olmueh khaw cal, aka khawn khaw a sading, aka khaem khaw cet, mikdael loh a hmuh, te hlangping loh a hmuh vaengah a ngaihmang uh tih, Israel Pathen te a thangpom uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesuh loh a hnukbang rhoek te a khue tih, “Hlangping hamla ka thinphat, kai taengah hnin thum rhaeh uh coeng tih, a caak ham ba khaw khueh uh pawh. Te dongah amih he buhmueh rhathih la tueih ka ngaih pawh. Longpueng ah tawnba uh ve,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae amah taengah hnukbang rhoek loh , “Vaidam heyet he kohong ah me lamkah nim mamih ham a om eh? Heyet hlangping a hah ham akhaw,” a ti uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah Jesuh loh amih te, “Vaidam meyet na khueh uh,” a ti nah. Te vaengah, “Vaidam parhih neh ngadik a yool ni,” a ti na uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah hlangping te lai ah ngol hamla ol a uen tih,
  </para>
  <para style="p">
    <verse number="36" style="v" />Vaidam hluem rhih neh nga te a loh tih, a uem, a aeh tih hnukbang rhoek te a paek tih hnukbang rhoek loh hlangping te a doe.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hlang boeih loh a caak uh tih hah uh. Te phoeiah a coih a nueipil te voh parhih a bae la a phueih uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aka ca rhoek tah huta neh camoe tae kolla tongpa thawngli lo uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hlangping te a tueih phoeiah lawng khuila kun tih Magadan vaang la pawk.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaengah Pharisee rhoek neh Sadducees rhoek loh a paan uh tih, “Vaan lamkah miknoek te amih tueng ham a dawt uh tih a loepdak uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae amih te a doo tih, “Hlaem a pha vaengah vaan ke khopang a ling dongah Khothen ni na ti uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vaan ke Mincang ah hmuep tih a ling dongah, Tihnin ah khonal ni na ti uh. Vaan kah a hmuethma ngawn tah boelhkhoeh ham na ming uh dae a tuetang kah miknoek tah na ming uh thai moenih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Boethae neh samphaih cadil loh miknoek a kuek, tedae Jonah kah miknoek pawt atah miknoek m'pae mahpawh,” a ti nah. Te phoeiah amih te a hnoo tih vik cet.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae rhalvangan la a caeh uh vaengah hnukbang rhoek loh buh khuen ham a hnilh uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah Jesuh loh amih te, “Pharisee rhoek neh Sadducee rhoek kah tolrhu ke hmat uh lamtah ngaithuen uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae amih tah amamih khuiah thui uh thae tih, “Buh n'khuen uh pawt tih,” a ti uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Jesuh loh a ming vaengah, “Uepvawt rhoek aw, balae tih buh na khueh uh pawt te namamih khuiah na thuingong uh?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na yakming uh hlan a? Vaidam panga te thawngnga cung tih voh dongah muep na phueih te na poek uh moenih a?
  </para>
  <para style="p">
    <verse number="10" style="v" />Vaidam parhih te thawngli loh cung uh tih voh dongah muep na khuen uh moenih a?
  </para>
  <para style="p">
    <verse number="11" style="v" />Balae tih na yakming uh pawh, Nangmih taengah buh kawng te ka thui moenih. Tedae Pharisee rhoek neh Sadducee rhoek kah tolrhu mah ngaithuen uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaidam khuikah tolrhu ngaithuen ham a thui moenih, Pharisee rhoek neh Sadducee rhoek kah thuituennah ni tila a hmuhming uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesuh tah Kaisarea Philipi pingpang la a pawk vaengah a hnukbang rhoek te a dawt tih, “Hlang rhoek loh Hlang Capa he ulae a ti uh?” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah amih loh, “A ngen loh tuinuem Johan, pakhat loh Elijah, a tloe rhoek loh Jeremiah neh tonghma khat khat a ti uh,” a ti na uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amih te khaw, “Tedae nangmih loh, kai he ulae na ti uh?” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Simon Peter loh a doo tih, “Nang tah aka hing Pathen Capa Khrih ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah Jesuh loh anih te a doo tih “Simon Barjonah tah, yoethen la na om coeng. Pumsa neh thii nen pawt tih vaan kah a Pa loh nang taengah a phoe coeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah kai loh nang te, “Nang tah Peter ni. Te dongah hekah lungpang soah hlangboel te ka thoh vetih saelkhui vongka loh noeng mahpawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vaan ram kah cabi te nang taengah kan paek ni. Te dongah diklai ah na pin te tah vaan ah pin la om ni. Tedae diklai ah na hlam te tah vaan ah hlam la om ni,’ ka ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah, 'Jesuh tah Khrih ni,’ tila thui pawt ham hnukbang te ol a paek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaeng lamloh Jesuh tah Jerusalem la cet tih a ham rhoek , khosoihham rhoek , cadaek rhoek kah nganboh muep yook ham neh, a ngawn phoeikah hnin thum ah a thoh ham a kuek te a hnukbang rhoek taengah koe a thuicaih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah Peter loh a sim doela koe a mawt tih, “Boeipa nang te poekpoei rhola a ti mai mako, he tah nang taengah om loengloeng boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae Peter te a mael thil tih, “Satan, kai hnukla nong, kai ham thangkui la na om. Na poek te Pathen kah hno pawt tih hlang kah hno ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Jesuh loh a hnukbang rhoek te,, “Khat khat long ni ka hnukah lo ham a ngaih atah, amah te huek uh saeh lamtah a thinglam a koh doeah kai m'vai saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />A hinglu te khang ham aka ngaih tah poci ni. Tedae kai kongah a hinglu aka hlong tah te te a dang ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hlang loh Diklai he boeih a pang dae a hinglu a hlong atah balae a hoeikhang eh? Hlang loh amah kah hinglu ham balae tlansum la a phai eh?
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah Hlang Capa loh a napa kah thangpomnah neh, amah kah puencawn rhoek ham pawk puei vaengah hlang te a khoboe bangla rhip a thuung van ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah amih te “Nangmih taengah rhep kan thui hekah aka pai khuiah hlangvang om. Amih loh thaomnah neh aka pai Pathen ram te a ming uh hlan atah dueknah he ten uh mueh mahpawh,” a ti nah.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khohnin hnin rhuk phoeiah Jesuh loh Peter, James neh a mana Johan te a khuen tih amih te tlang sang sola hloep a khuen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Jesuh tah amih kah hmaiah thohai uh tih, a maelhmai te khomik bangla sae. A himbai tah hmaivang bangla a bok la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Moses neh Elijah te amih taengah pakcak ha thoeng tih Boeipa nehhmaih cal uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Peter loh Jesuh te a doo tih, “Boeipa heah he mamih om ham then tih, na ngaih atah dap pathum ah pahoi ka saii eh?, nang ham pakhat, Moses ham pakhat, Elijah ham pakhat saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Peter a cal li vaengah aka phaa khomai loh amih te a dah. Te vaengah khomai khui lamkah ol loh , “He tah ka capa thintlo ni, a soah ka lungtlun, a ol hnatun pa uh, “tarha a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnukbang rhoek loh a yaak vaengah a maelhmai a buenglueng uh tih bahoeng a rhih uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Jesuh loh amih te a paan tih a taek phoeiah, “Thoo uh rhih uh boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mik a huel uh daengah Jesuh amah bueng pawt atah uh khaw hmu uh pawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlang lamloh a suntlak uh vaengah amih te Jesuh loh a uen tih, “Mangthui he Hlang Capa duek lamloh a thoh hlan atah thui boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah hnukbang rhoek loh Jesuh te a dawt uh tih, “Balae tih cadaek rhoek loh, 'Elijah he ha pawk lamhma ham a kuek,’ a ti uh?” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Jesuh loh a doo tih, “Elijah tah ha pawk ngawn coeng tih boeih a thoh pawn ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae nangmih taengah kan thui, Elijah tah ha pawk oepsoeh dae anih te hmat uh pawt tih a ngaih uh sarhui neh Johan te a saii uh. Tangkhuet la hlang capa loh amih kah nganboh a yok tom coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te daengah amih ham tuinuem Johan kawng ni a. thui pah te hnukbang rhoek loh a hmuhming uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlangping taengla a pawk uh vaengah anih te hlang pakhat loh a paan.
  </para>
  <para style="p">
    <verse number="15" style="v" />A taengah cungkueng tih, “Boeipa ka ca he rhen mai, rhaihum dongah bahoeng patang coeng, tui khuila, hmai khuila cungku taitu coeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih he na hnukbang rhoek taengla ka khuen dae a hoeih sak uh thai moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesuh loh a doo tih, “Aka tangnahmueh kah cadil neh aka pamdah aw, nangmih taengah meyet nim ka om eh? Nangmih te meyet nim kan yaknaem ve, anih te kamah taengla pahoi hang khuen,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah Jesuh loh rhaithae te a ho tih rhaithae loh camoe te a nong tak. Te dongah te vaeng tue lamloh camoe te hoeih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah hnukbang rhoek loh Jesuh te hloep a paan uh tih, “Balae tih anih te ka haek uh thai pawh,” a ti na uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah, “Nangmih kah hnalvalnah kongah ni. Nangmih taengah rhep ka thui, mukang mu bang mah tangnah na khueh koinih, hekah tlang he kela thoeih na ti vaengah thoeih vetih na tloel tlaih mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae, thangthuinah neh yaehnah nen pawt koinih hebang he poengla coe thai mahpawh
  </para>
  <para style="p">
    <verse number="22" style="v" />Galilee ah a sisuk uh vaengah Jesuh loh amih te, “Hlang capa tah hlang kut ah a voeih tom coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih te a ngawn uh vetih a thum hnin ah thoo ni,” a ti nah tih mat a khothae uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kapernaum la a pawk uh vaengah cawn aka doe rhoek loh Peter te a paan uh tih, “Na saya loh cawn a paek moenih?” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Peter loh, “Ue,” a ti nah. Im la a pawk uh vaengah Jesuh loh a khal tih,, “Simon, nang balae na poek? Diklai manghai rhoek loh u taengkah lamkhong neh mangmu lae a loh? Amih ca rhoek lamkah a? hlanglang lamkah a?” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Hlanglang taengkah,” a ti nah hatah Jesuh loh, “Te dongah a ca ni aka loeih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te cakhaw amih te n'khah ham om pawh. Tuili la cet lamtah ngavaih te voei uh. Te vaengah nga aka loe lamhma te lo uh. Tedae a ka a ang vaengah tangka na hmuh ni. Te te lo lamtah nang neh kai ham amih te pae,” a ti nah.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te vaeng tue ah hnukbang rhoek loh Jesuh te a paan uh tih, “Vaan ram ah ulae tanglue la aka om,” a ti na uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah camoe pakhat te a khue tih amih lakli ah a pai sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah, “Nangmih taengah rhep kan thui, camoe rhoek bangla na mael uh tih na om uh pawt atah vaan ram khuila na kun uh tlaih mahpawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah hekah camoe bangla amah tlarhoel hlang te tah vaan ram ah tanglue la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah kai kah ming neh hebang camoe pakhat aka doe te tah kai ni n'doe.
  </para>
  <para style="p">
    <verse number="6" style="v" />U long khaw kai aka tangnah camoe rhoek he pakhat khaw a khah atah, a rhawn ah laak phaklung a hoei tih tuili dung ah a buek te anih ham rhoei ngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anunae thangkui kongah Diklai aih he. Thangkui te a om ham a kueknah om. Tedae anunae anih lamloh thangkui aka tung hlang aih te.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah na kut neh na kho loh nang n'khah atah te te tloek lamtah namah lamloh voei. Kut panit kho panit om tih dungyan hmai khuila m'voeih lakah a ngun a khaem la hingnah khuiah kun te nang ham hnothen la om.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah na mik loh nang n'khah atah te te koeih lamtah namah lamloh voei. Mik vang neh hingnah khuila kun te nang ham hnothen la om. Mik panit om tih hell hmai khuila voeih lakah tah.
  </para>
  <para style="p">
    <verse number="10" style="v" />He camoe rhoek khuikah pakhat khaw na hnaep uh pawt ham ngaithuen uh. Nangmih ham kan thui, vaan ah amih kah puencawn rhoek loh vaan kah a pa maelhmai te a hmuh uh taitu lah ko.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hlang capa tah aka hma rhoek khang ham ni ha pawk.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmih tah metlam na poek? Hlang pakhat te tu yakhat om coeng dae te khuikah pakhat loh poengdoe koinih sawmko pako te tlang ah a hlah vetih aka poeng te toem hamla cet mahpawt nim?
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah a hmuh hamla om coeng koinih ta, nangmih taengah rhep kan thui, aka poeng mueh sawmko pako lakah aka hma soah omngaih ngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah vaan kah na Pa hmaiah tah camoe rhoek pakhat khaw poci ham te a ngaih moenih.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Na manuca loh nang taengah a tholh atah cet lamtah namah neh anih laklo bueng ah mah anih te toeltham. Nang ol a yaak atah na manuca te na na coeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae a hnatun pawt atah pakhat khaw panit khaw namah taengah khuen. Te daengah ni laipai rhoek panit pathum kah a ka loh olka te boeih a pai puei eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae amih loh a altha atah hlangboel taengah thui. Te vaengah Hlangboel kah ol pataeng a altha atah nangmih taengah namtom neh mangmucoi bangla om sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangmih taengah rhep ka thui, diklai hmanah na pin uh te tah vaan ah a pin ni. Tedae diklai ah na hlam uh te tah vaan ah a hlam ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah nangmih taengah rhep kan thui, panit loh na kotluep tih diklai hmanah hno boeih te bih uh koinih, amih ham te vaan kah a pa loh a saii pah ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Panit pathum aka om te khaw kai ming neh a hum uh atah amih lakli ah pahoi ka om coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah amah te Peter loh a paan tih, “Boeipa, ka manuca loh kai soah a tholh vaengah ka hlah vawptawp a ya?, voei rhih due a?” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesuh loh , “Nang taengah voei rhih due pawt tih, sawmrhih parhih due ni ka ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah vaan ram tah a sal rhoek taengah bitat soepsoei ham aka ngaih hlang manghai neh vai uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Soepsoei ham a tong vaengah talen thawngrha dongkah laikung pakhat te a taengla a khuen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae anih loh thuung ham khaw kawn khueh pawh. Te dongah anih te a boeipa loh a yuu neh a ca rhoek, a khueh boeih te a yoih tih thuung ham ol a paek.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah sal te bakop tih manghai te a bawk. Te phoeiah, “Kai soah na thinsen sak mai lamtah nang te boeih kan thuung bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah boei loh a thinphat tih tekah sal te a loeih sak. Te phoeiah a laiba khaw a hlah pah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae tekah sal tah cet tih a sal puei pakhat a hmuh. Te long te anih taengah denarii yakhat a ba. Te vaengah anih te a tuuk tih a khak phoeiah, “Pakhat na ba akhaw n'thuung laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah a sal puei loh a yalh doela a hloep, “Kai soah na thinsen mai dae, nang te kan thuung bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae ngaih pawt tih laiba te a thuung duela thongim khuiah a hlak tih a caeh tak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aka om hno te a sal puei rhoek loh a hmuh dongah mat a khothae uh. Te dongah a boei taengla a pawk uh vaengah aka om hno te boeih a thui uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah a boei loh anih te a khue tih, 'Sal thae aw, kai nan hloep dongah na docanah boeih te kan hlah,
  </para>
  <para style="p">
    <verse number="33" style="v" />kai loh nang kang rhen bangla na sal puei te na rhen ham a kuek van moenih a? 'a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />A boeipa loh kosi a hong tih anih te laiba boeih a thuung hlan atah phaepkung rhoek taengah a thak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah khat rhip loh a manuca te na thinko neh na hlah uh pawt koinih vaan kah a pa loh namamih taengah te tlam ni a saii van eh,” a ti nah.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh loh he rhoek kah ol boeih he bawt a khah phoeiah Galilee lamloh nong tih Jordan rhalvangan Judea vaang la pawk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Jesuh te hlangping loh muep a vai uh tih amih rhoek te pahoi a hoeih sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Pharisee rhoek loh Jesuh te a paan uh tih a noemcai uh. Te vaengah, “Paelnaehnah khat khat dongah a yuu hla koinih tongpa ham tueng aya? a ti na uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Jesuh loh a doo tih, “A tongcuek lamkah aka suen loh amih rhoi tongpa neh huta bueng a saii te na tae uh moenih a?
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae he kongah ni, 'tongpa loh a manu neh a napa te a imphael tak ni. Te vaengah a yuu taengah kap vetih panit te pumsa pakhat la om ni,’ a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah panit lo pawt tih pumsa khat coeng ni. Te dongah Pathen loh a yingyawn sak te hlang loh maa sak boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Jesuh te, “Balae tih yuuhlaknah cayol te paek tih tueih ham Moses loh a uen,” a ti na uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amih te, “Nangmih kah thinthahnah kongah ni na yuu te hlak ham te Moses loh nangmih m'paek. Tedae a tongcuek lamloh te te a om moenih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae nangmih taengah kan thui, Cukhalnah kawng pawt ah a yuu a hlak tih a tloe aka lo te tah samphaih coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hnukbang rhoek loh amah taengah, “A yuu taengah a va kah paelnaehnah om tangloeng koinih vasak te rhoei mahpawh,” a ti na uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae Jesuh loh amih te, “Hekah ol he hlang boeih loh a khingmong thai moenih. Tedae a paek rhoek long ni a khingmong thai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manu bung lamloh hlueikhu la aka thaang te khaw om van. Hlang lamloh a hlueikhu sak hlueikhu te om. Vaan ram kongah amah aka hlueikhu, hlueikhu te khaw om. Aka khingmong thai loh khingmong saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah amih kut tloeng tih thangthui sak ham camoe rhoek te a taengla a khuen uh. Tedae amih te hnukbang rhoek loh a ho uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Jesuh loh, “Camoe rhoek te hlah uh lamtah kai taengla ha pawk ham atah amih te kanghalh uh boeh, vaan ram tah amih ham ni a om,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amih soah kut a tloeng tih te lamloh vik cet.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah hlang pakhat loh Jesuh taengla pakcak a paan tih, “Saya, dungyan hingnah ka khueh ham mebang hno then nim ka saii eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Jesuh loh anih te, “Balae tih kai he a then kawng nan dawt? A then pakhat ni a. om. Tedae hingnah khuila kun na ngaih atah olpaek te tuem,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesuh te, “Mebang nim,” a ti nah. Te dongah Jesuh loh, “Hlang ngawn boeh, samphaih boeh, huencan boeh, laithae boeh
  </para>
  <para style="p">
    <verse number="19" style="v" />Na nu neh na pa hinyah lamtah na imben te namah bangla lungnah,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cadong loh, “He rhoek he boeih ka tuem coeng, balae ka phavawt bal pueng?” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesuh loh anih te, “Lungcuei la om na ngaih atah cet lamtah na khuehtawn te yoi. Te phoeiah khodaeng te pae. Te daengah ni vaan ah khohrhang na khueh eh. Te phoeiah kai pahoi m'vai,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae cadong tah hnopai muep aka khueh la a om dongah ol te a yaak vaengah kothae doeah cet.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah Jesuh loh a hnukbang rhoek te, “Nangmih taengah rhep ka thui, kuirhang tah vaan ram ah kun tloel ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah nangmih taengah koep kan thui, kuirhang te Pathen ram khuiah a kun lakah kalauk te phamet khui longah a ael ke yoeikoek la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hnukbang rhoek loh a yaak uh vaengah let uh dahlawt tih, “Te koinih ulae khang la aka om eh?” a ti uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae Jesuh loh amih te a sawt tih, “He he hlang taengah a tloel la om, tedae Pathen taengah boeih coeng thai,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah Peter loh a doo tih, “Kaimih tah rhoepsaep boeih ka toeng uh tih, namah kam vai uh coeng he. Te koinih kaimih ham balae aka om eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah Jesuh loh, “Nangmih taengah rhep ka thui, nangmih loh kai nam vai uh coeng. Hlang capa tah koepcunnah dongah a thangpomnah ngolkhoel sola ngol ni. Nangmih khaw ngolkhoel hlainit soah na ngol uh vetih Israel koca hlainit te lai na tloek uh ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kai ming kongah a im a lo boeih, manuca rhoek, ngannu rhoek, a manu napa, a ca rhoek, aka toeng boeih te tah a pueh yakhat a dang vetih dungyan hingnah a pang ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae lamhma khaw hnukkhueng la, hnukkhueng khaw lamhma la muep om uh ni.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vaan ram tah imkung hlang pakhat phek la om. Anih tah a misurdum kah bibikung coep ham yue cet.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah bibikung rhoek neh hnin at ham denarii pakhat neh a kotluep tih amih te a misurdum la a tueih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khonoek pathum tlukah a caeh hatah hnoyoih hmuen ah pai uh tih aka palyal rhoek te a hmuh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah te rhoek te, “Nangmih khaw misurdum la cet uh lamtah a dueng la aka om te tah nangmih te kam paek bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah te rhoek khaw cet uh. Te phoeiah khonoek parhuk neh pako tluk ah khaw cet tih koep a tlap bal.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlaikhat tluk kah a caeh vaengah a tloe rhoek sut aka pai rhoek te a hmuh. Te dongah amih te, “Balae tih sut na pai uh tih khohnin yung ah na palyal uh he?” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah amah te, “Kaimih he n'coep uh moenih,” a ti nahuh. Te dongah amih te, “Nangmih khaw misurdum la cet uh saw,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlaem ben a pha vaengah misurdum boei loh a dumtawt taengah, “Bibikung rhoek te khue lamtah lamhnuk rhoek lamkah tong lamtah lamhma duela amih te thapang thuung laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khonoek hlaikhat tluk kah aka pawk rhoek khaw denarii pakhat rhip a dang uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lamhma la aka pawk rhoek loh muep a dang uh ni tila a poek uh. Tedae amih khaw denari pakhat ni rhip a dang uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te tla aka dang rhoek loh imkung taengah kohuet uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah “He rhoek a lamhnuk rhoek tah khonoek pakhat ni a bi uh dae, hnin at puet kholing hnorhih aka ueh kaimih neh amih te vanat la na khueh,” a ti na uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae amih te pakhat la a doo tih, 'Pueivan aw nang kan thae nah moenih, kai neh denarii pakhat ham kotluep a om moenih a?
  </para>
  <para style="p">
    <verse number="14" style="v" />Namah kah te lo lamtah cet laeh. Nang bangla lamhnuk te khaw paek ka ngaih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kamah koe nen te ka ngaih bangla ka saii tueng moenih a? Kai a then la ka om te nang kah mik loh a lolh la a om sak a? 'a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah lamhnuk te lamhma vetih lamhma te lamhnuk la om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesuh loh hnukbang hlainit rhoek te hloep a khue tih Jerusalem la cet.
  </para>
  <para style="p">
    <verse number="18" style="v" />A longpueng uh vaengah amih te, “Jerusalem la cet uh pawn sih. Hlang capa tah khosoihham rhoek neh cadaek rhoek taengla a voeih uh vetih anih te dueknah neh a boe sak uh ni he.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah tamdaeng ham neh boh tih tai hamla namtom rhoek taengah a voeih uh ni. Tedae a thum hnin ah koep thoo ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah Zebedee ca rhoek kah a manu loh a ca rhoek te Jesuh a paan puei tih a bawk. Tedae a taengkah hno pakhat a bih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesuh loh anih te, “Balae na ngaih,” a ti nah. Te vaengah, “Ka ca rhoi he na ram ah tah na bantang ah pakhat na banvoei ah pakhat ngol rhoi saeh ti mai laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Jesuh loh a doo tih, “Mebang na bih uh khaw na ming uh moenih. Kai loh ka ok ham ka cai thil boengloeng te ok hamla na coeng uh thai aya? a ti nah. Te vaengah Jesuh te, “Coeng thai ngawn,” a ti na uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesuh loh amih te, “Kai kah boengloeng he na ok uh ngawn ni. Tedae kai kah bantang neh banvoei ah ngol ham tah kai hut la om pawh. Tedae a pa loh a hmoel rhoek ni tekah te a paek eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Parha rhoek loh a yaak uh vaengah te rhoi boeina kawng te a yakdam uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae Jesuh loh amih te a khue tih, “Namtom rhoek kah boei rhoek tah amamih vueinan uh tih a len rhoek loh amamih a huttet uh thae te na ming.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmih khuiah tetlam te om uh boeh. Tedae, Nangmih khuiah a len la om aka ngaih te tah nangmih kah tueihyoeih la om ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah nangmih khuiah lamhma la om ham aka ngaih te tah nangmih kah sal la om ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hlang Capa tah hlang thohtat sak ham pawt tih thohtat pah ham neh a hinglu te ping kah tlansum la paek ham ni halo,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amih te Jerikho lamloh a khong uh vaengah Jesuh te hlangping loh muep a vai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah mikdael panit long taengah ngol rhoi. Jesuh kah a khum te a yaak rhoi vaengah pang rhoi tih, “Boeipa, David Capa, kaimih rhoi he n'rhen lah,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae hlangping loh amih rhoi te a ho tih a paa sak. Te vaengah te rhoi te taoe pang rhoi tih, “Boeipa, David Capa kaimih rhoi he n'rhen lah,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah Jesuh tah pai tih amih rhoi te a khue. Te phoeiah, “Nangmih rhoi ham balae saii sak na ngaih rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah, “Boeipa, kaimih rhoi mik tah tueng lah saeh,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesuh tah a thinphat tih amih rhoi mik te a taek pah. Te vaengah tlek a hmuh rhoi tih Jesuh hnuk a vai rhoi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem taengla a yoei uh vaengah Olives tlang kah Bethphage la pawk uh. Te vaengah Jesuh loh a hnukbang panit te a tueih tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Na rhaldan kah kho la cet rhoi lamtah muli-marhang neh a taengah a ca a pael te kawl na hmuh rhoi ni. Hlam rhoi lamtah kai taengla hang khuen rhoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khat khat loh nangmih rhoi te khoem n'thui sak atah, 'Boeipa loh a ngoe,’ ti nah. Te vaengah koe han hlah bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />He he a om daengah ni tonghma loh a thui te a soep eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Zion nu te thui pah, na manghai tah nang taengla ha pawk coeng te, muli-marhang so neh laak tal ca soah khaw muelhtuet la ngol,” a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnukbang rhoi te cet rhoi tih Jesuh kah a thuinuet bangla a saii rhoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Muli-marhang neh a ca te a khuen rhoi tih himbai a tloeng uh thil phoeiah a ngoldoelh thil.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah hlangping a kumngai loh longpuei ah a himbai te a phaih uh. A tloe rhoek loh thing kah a hlaeng te a hlaek uh tih longpuei ah a phaih uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah a hmaila aka lamhma neh a hnuk kah aka vai hlangping loh pang uh tih, “David capa tah Hosanna, Boeipa ming neh aka pawk tah a yoethen pai, sangkoek ah Hosanna,” a ti uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jerusalem la a kun vaengah khopuei boeih hinghuen tih, “Anih he unim,” a ti uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah hlangping loh, “Anih he Galilee Nazareth lamkah tonghma Jesuh ni,” a ti uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesuh te bawkim khuila kun tih bawkim kah hno yoi rhoek neh hno lai rhoek te boeih a haek, tangkathung rhoek kah caboei neh vahu aka yoi rhoek kah ngoltlang te a palet pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah amih te, “Ka im tah, 'Thangthuinah im la khue saeh,’ tila a daek coeng. Tedae nangmih loh dingca rhoek kah a khuirhung la na khueh uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah amah te mikdael rhoek neh aka khaem rhoek loh Bawkim ah a paan uh tih amih te a hoeih sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae khobae rhambae la a saii neh camoe rhoek loh bawkim ah pang tih, “David Capa tah Hosanna,” a ti uh khosoihham rhoek neh cadaek rhoek loh a hmuh uh vaengah a yakdam uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah Jesuh te, “He rhoek loh a thui te na yaak a?” a ti nah. Te vaengah Jesuh loh amih te, “Ue, na tae uh mahnim? “'Cahmang neh cacun rhoek kah ka lamkah loh thangthennah na rhoekbah coeng,’ a ti ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah amih te a hnoo phoeiah khopuei lamkah loh Bethany la cet tih pahoi rhaeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khopuei la yueya a bal vaengah tah a bungpong.
  </para>
  <para style="p">
    <verse number="19" style="v" />Long ah thaibu kung pakhat a hmuh tih a taengla a paan. Tedae a hnah bueng mueh atah a kung dongah bang khaw hmu pawh. Te dongah, “Dungyan duela nang kah a thaih om boel saeh,” a ti nah tih thaibu kung tah pahoi koh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hnukbang rhoek loh a hmuh uh vaengah a ngaihmang uh tih, “Metlamlae thaibu kung tlek a koh ca,” a ti uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesuh loh amih te a doo tih, “Nangmih taengah rhep kan thui, tangnah na khueh uh tih na boelhkhoeh pawt atah, thaibu kung bueng te na saii uh pawt vetih hekah tlang he phoek tih tuili khuila hlak ham pataeng na ti nah uh koinih coeng tangloeng ngawn ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah thangthuinah neh vawpvawp na bih uh te tah tangnah neh na dang uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawkim khuila Jesuh pawk tih a thuituen vaengah khosoihham rhoek neh pilnam kah a ham rhoek loh anih te a paan uh. Te phoeiah, “Mebang saithainah nen lae saii he? Te phoeiah hekah saithainah he u long nang m'paek?” a ti na uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesuh loh amih te a doo tih, “Nangmih te ol pakhat kan dawt eh. Te te kai taengah nan thui uh atah he rhoek he mebang saithainah neh ka saii khaw nangmih taengah kan thui bitni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Baptisma Johan tah me lamkah lae ana om? Vaan lamkah a? Hlang lamkah a?” a ti nah. Te vaengah te rhoek loh amamih khuiah a poek uh tih, “'Vaan lamkah,’ n'ti uh koinih mamih te, 'Balae tih anih te na tangnah uh pawh,’ a ti veh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae hlang lamkah n'ti uh koinih hlangping he koek n'rhih uh. Hlang boeih loh Johan te tonghma la a khueh uh,” a ti uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah Jesuh te a doo uh tih, “Ka ming uh pawh,” a ti uh. Tedae Jesuh loh amih te, “Mebang saithainah neh ka saii he khaw nangmih taengah ka thui mahpawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih ta metlam na poek? Hlang pakhat loh a ca panit a khueh. A cuek te a paan tih, “Ka ca tihnin ah dum ah cet lamtah saii ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah te long te a doo tih, 'Ka ngaih pawh,’ a ti nah. Tedae a hnukkhueng ah yut tih koep cet.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pakhat te a paan tih lamhma kah banngla a ti nah. Te long tah a doo tih, 'Ka cet ni boeipa,’ a ti nah dae cet pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te rhoi panit khuiah ulae a napa kah kongaih aka saii,” a ti nah. Te vaengah, “Lamhma loh,” a ti na uh. Jesuh loh amih te, “Nangmih taengah rhep ka thui, mangmucoi neh hlanghalh rhoek tah Pathen ram khuila nangmih lakah lamhma uh ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Johan loh duengnah longpuei neh nangmih taengla ha pawk dae anih te na tangnah uh moenih. Tedae mangmucoi rhoek neh hlanghalh rhoek loh anih te a tangnah. Nangmih loh na hmuh uh coeng dae anih te tangnah ham a tloihsoi ah khaw na yut uh moenih.
  </para>
  <para style="p">
    <verse number="33" style="v" />A tloe nuettahnah he hnatun uh lah. Lokung hlang pakhat om tih anih loh dum a tue. Te te vongtung a tung tih a khuiah misurrhom a too, imsang khaw a sak. Te phoeiah lotawn rhoek a phaam sak tih vik yiin.
  </para>
  <para style="p">
    <verse number="34" style="v" />A thaih tue a yoei vaengah a sal rhoek te a thaih doe sak ham lotawn rhoek taengla a tueih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah lotawn rhoek loh lokung kah sal rhoek te a tuuk uh tih, pakhat te a boh uh, pakhat te a ngawn uh, pakhat te a dae uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah sal tloe te lamhma kah lakah muep a tueih dae amih te khaw a saii uh tangkhuet.
  </para>
  <para style="p">
    <verse number="37" style="v" />A hnukkhueng ah a capa te amih taengla a tueih tih, “Ka capa tah a yahnah uh bitni,” a ti.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae lotawn rhoek loh a capa te a hmuh uh vaengah amamih te, “Anih tah rhopangkung la om, Halo, anih he ngawn uh sih lamtah a rho he rhawt pa uh sih,” a ti uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah anih te a tuuk uh phoeiah misurdum lamkah loh voelh a haek uh tih a ngawn uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah misurdum kah boeipa te a pawk vaengah lotawn rhoek te metlam a saii eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te vaengah, “Amih boethae duet rhoek te a poci sak vetih misurdum te a tloe kah lotawn rhoek a phaam sak ni. Te rhoek long tah a thaih te amah tue vaengah a taengla a thuung ni,” a ti uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesuh loh amih te, “Cacim khuiah na tae uh mahnim? Im sa rhoek loh a hnawt uh lungto te imkil lu la poeh. He tah Boeipa lamkah loh poeh tih mamih mikhmuh ah a khuet la om ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah nangmih taengah kan thui, “Pathen kah ram tah nangmih taeng lamkah loh a khuen vetih a thaih aka saii namtom taengah a paek ni
  </para>
  <para style="p">
    <verse number="44" style="v" />Te dongah hekah lungto soah aka tla tah tlawt vetih, lungto loh a tlak thil te khaw amah ni aka tip eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tedae khosoihham rhoek neh Pharisee rhoek loh a yaak uh vaengah, anih kah nuettahnah te amih kawng ni a. thui tila a ming uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te dongah anih te tuuk hamla a mae uh dae Jesuh te tonghma la a khueh uh dongah hlangping te a rhih uh.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Jesuh loh amih te a doo tih nuettahnah neh koep a thui pah.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Vaan ram tah a manghai pa neh vai uh. Te loh a capa ham yulueinah a saii pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah yulueinah la a khue rhoek te khue hamla a sal rhoek te a tueih dae lo ham ngaih uh pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sal a tloe rhoek te koep a tueih tih, 'A khue rhoek te thui pa uh, kai kah buhkoknah ka tawn coeng he, ka vaito neh a toitup khaw a ngawn coengw, a cungkuem he a sikim coeng dongah yulueinah ah halo uh saeh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae amih loh a sawtrhoel uh tih a ngen tah amah kah lo la, a tloe te a hnoyoihnah la cet uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah a tloe rhoek loh manghai kah sal rhoek te a tuuk uh, a neet uh tih a ngawn uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah manghai tah kosi a hong tih a rhalkap rhoek te a tueih. Te vaengah hlang aka ngawn rhoek te a poci sak tih a khopuei te a hlup pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah a sal rhoek taengah, 'Yulueinah tah sikim la om coeng dae a khue rhoek te a koihhilh la a om uh moenih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah longpuei caehtung ah cet uh lamtah na hmuh uh sarhui te yulueinah ah khue uh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah sal rhoek tah longpuei ah cet uh tih a hmuh uh sarhui te a thae neh a then khaw a coi uh. Te dongah yulueinah tah aka bul rhoek neh bae uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah manghai te kun tih aka bul rhoek te a sawt hatah, yulueinah himbai aka bai pawh hlang pakhat te kawl a hmuh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah anih te, “Pueivan aw, metlae yulueinah himbai om kolla hela na kun?” a ti nah. Tedae te long te hil a phah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah manghai loh a tueihyoeih rhoek taengah, “Anih he a kut neh a kho pin uh lamtah poengben kah a yinnah khuila haek uh. Rhah neh no rhuengnah la om saeh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah, “A khue rhoek tah muep om dae a coelh rhoek tah yool,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Pharisee rhoek tah koe uh Jesuh te a ol neh hlaeh ham dawtletnah a khueh uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah a hnukbang rhoek te Herod kah hlang neh Jesuh taengla a tueih uh. Te vaengah, “Saya, a thuem la na om tih Pathen kah longpuei te oltak neh na thuituen te ka ming uh. U taengah khaw na tangyah pawt tih hlang maelhmai te na sawt moenih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Kaisar taengah mangmu paek ham tueng neh a tueng pawt khaw nang loh me tlam lae na poek, kaimih taengah thui lah?” a ti na uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae Jesuh loh amih kah halangnah te a ming tih, “Hlangthai palat rhoek balae tih kai nan noemcai uh?
  </para>
  <para style="p">
    <verse number="19" style="v" />Mangmu ham tangka te kai n'tueng uh lah,” a ti nah. Te dongah a taengla denarii pakhat a khuen uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah amih te, “U kah mueimae neh ming nim he?” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah taengah, “Kaisar kah,” a ti uh. Te vaengah amih te, “Te dongah Kaisar kah tah Kaisar taengah, Pathen kah te Pathen taengah mael uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />A yaak uh vaengah let uh. Te dongah Jesuh te a toeng uh tih cet uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te khohnin ah thohkoepnah om mahpawh aka ti Sadducee rhoek loh Jesuh te a paan uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Jesuh te a dawt uh tih, “Saya, Moses loh , 'Khat khat tah ca a om kolla a duek atah anih yuu te a mana loh yunah saeh lamtah a maya ham a tiingan thoh pah saeh,' a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae kaimih taengah boeinaphung parhih om uh. Lamhma loh yuu a loh hata vik duek tih ca om kolla a yuu te a mana ham a hlah pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />A pabae neh a pathum neh parhih duela khaw amahboeiloeih la om.
  </para>
  <para style="p">
    <verse number="27" style="v" />A tloihsoi ah huta te khaw boeih duek uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anih te boeih a hutnah uh oeh coeng dongah thohkoepnah dongah tah parhih khuikah u yuu lamlae a om eh?” a ti na uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesuh loh amih te a doo tih, “Cacim neh Pathen kah thaomnah aka ming pawt loh n'rhaithi uh coeng.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thohkoepnah dongah yuloh vasak neh rhaihlan ti a om moenih. Tedae vaan ah tah puencawn bangla om uh coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae aka duek rhoek kah thohkoepnah te nangmih ham Pathen loh a thui te na tae uh moenih a?
  </para>
  <para style="p">
    <verse number="32" style="v" />'Kai tah Abraham kah Pathen, Isaak kah Pathen, Jakob kah Pathen ni. Aka duek rhoek kah pawt tih aka hing rhoek kah Pathen ni,’ a ti ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengkah aka ya hlangping tah Jesuh kah thuituennah soah let uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae Sadducee rhoek a paa sak te Pharisee rhoek loh a yaak uh vaengah thikat la tingtun uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah amih khuikah olming pakhat loh ,
  </para>
  <para style="p">
    <verse number="36" style="v" />“Saya, olkhueng khuiah mebang olpaek lae aka len?” tila a dawt tih a noemcai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah Jesuh loh, “Boeipa na Pathen te na thinko boeih neh na hinglu boeih neh, na kopoek boeih neh lungnah.
  </para>
  <para style="p">
    <verse number="38" style="v" />He tah aka len neh aka lamhma olpaek ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />A pabae khaw lamhma kah phek la om tih, “Na imben te namah bangla lungnah.
  </para>
  <para style="p">
    <verse number="40" style="v" />He kah olpaek panit dongah olkhueng neh tonghma rhoek tah boeih cui,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Pharisee rhoek te a tingtun uh vaengah Jesuh loh amih te a dawt tih,
  </para>
  <para style="p">
    <verse number="42" style="v" />“Khrih kawng te metlam na poek uh? U ca lamlae a om?” a ti nah. Te vaengah, “David kah capa,” a ti uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah amih te, “Te koinih David loh Khrih te Mueihla ah Boeipa la a khue tih,
  </para>
  <para style="p">
    <verse number="44" style="v" />Boeipa loh ka Boeipa te, 'Na rhal rhoek te ka kho hmuiah ka khueh hlan duela kai kah bantang ah ngol,’ a ti nah te metlam a thui?
  </para>
  <para style="p">
    <verse number="45" style="v" />Te dongah David loh anih te boeipa la a khue atah metlamlae David kah capa la a om eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te vaengah a ol lan uh thai pawh. Te khohnin lamkah tah anih dawt ham te khat long khaw ngaingaih voel pawh.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Jesuh loh hlangping rhoek neh a hnukbang rhoek te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Cadaek rhoek neh Pharisee rhoek tah Moses kah ngoltlang dongah ngol uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah nangmih taengah a thui uh sarhui te boeih vai uh lamtah tuem uh. Tedae amih kah khoboe bangla saii uh boeh, a thui uh tih a vai uh haew moenih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah hno te a rhih la a boep uh tih phueihtloel la hlang kah laengpang dongah a tloeng uh dae amamih tah a kutdawn nen khaw tat sak ham ngaih uh pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A khoboe te khaw hlang kah a hmuh la boeih a saii uh. A cacimbu te a kaa uh tih salaw te oep uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Buhkung ah hmuensang, tunim ah ngolhmuen then neh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hnoyoih hmuen kah toidalnah uh neh hlang loh Rhabbi la a khue te a lungnah uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae nangmih tah Rhabbi la n'khue boel saeh. Nangmih kah saya tah pakhat ni aka om tih nangmih boeih te boeinaphung la na om uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah diklai hmankah he pa la na khue uh mahpawh, vaan kah pa pakhat ni nangmih ham a om.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mawtkung la n'khue uh boel saeh, Khrih tah nangmih mawtkung la rhenten om coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih khuikah aka tanglue tah nangmih kah tueihyoeih la om ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae amah aka pomsang te tah tlarhoel vetih amah aka tlarhoel te tah a pomsang ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anunae nangmih cadaek rhoek neh Pharisee hlangthai palat rhoek, hlang kah hmaiah vaan ram te na khaih uh tih, namamih khaw na kun uh pawh, aka kun rhoek te khaw kun ham na hlah pa uh pawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nuhmai kah imlo te na yoop uh phoeiah a hmanhu ah puet na thangthui uh. Te dongah nangmih kah laitloekkung la om uh ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anunae nangmih cadaek rhoek neh Pharisee hlangthai palat rhoek, pakhat te poehlip sak ham tuili neh rhamrhae na hil uh. Tedae a om tanglai vaengah tah anih te namamih laklah rhaepnit la hell kah a ca la na poeh sak uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anunae nangmih mawtkung mikdael rhoek, 'Bawkim neh aka toemngam te tah a toemngam phu om pawh, tedae bawkim kah sui neh a toemngam te man a kuek nah mako,’ aka ti rhoek
  </para>
  <para style="p">
    <verse number="17" style="v" />Mikdael neh hlang ang rhoek, melae tanglue la aka om? Sui a? Sui aka ciim bawkim a?
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah, 'Hmueihtuk neh aka toemngam te tah a phu om pawh, tedae hmueihtuk dongkah hmueih neh aka toemngam te aaitlaeng nah mako aka ti, rhoek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mikdael rhoek aw melae a tanglue? Kutdoe a? Kutdoe aka ciim hmueihtuk a?
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah hmueihtuk neh aka toemngam tah hmueihtuk neh a sokah boeih boeih neh a toemngam coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah Bawkim neh aka toemngam tah Bawkim neh a tolvael te a toemngam coeng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah vaan neh aka toemngam tah Pathen kah ngolkhoel neh te dongah aka ngol neh a toemngam coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anunae nangmih cadaek rhoek neh Pharisee hlangthai palat rhoek aw, sungii, sungsing neh sungkueng te na paek uh. Tedae olkhueng khuikah olpuei la aka om tiktamnah, rhennah, tangnah te na hlahpham uh. Tedae he rhoek he saii ham a kuek atah te rhoek khaw hlahpham boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mawtkung mikdael rhoek, pildik pataeng na soih u dae kalauk na dolh uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anunae nangmih cadaek rhoek neh Pharisee hlangthai palat rhoek, boengloeng neh baelphaih te a hmanhu ah na silh uh dae a khuikah halhkanah dongah khoeihveetnah neh na bae uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pharisee mikdael rhoek boengloeng kah a khui te lamhma la cilpoe dae. Te daengah ni poeng ben khaw a caih la a om eh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anunae nangmih cadaek rhoek neh Pharisee hlangthai palat rhoek, hlan a bok neh na loo uh. Te te ahmanhu ah sawtthen la tueng dae aka duek kah a rhuh neh rhongingnah boeih neh bae.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih khaw a hmanhu ah tah hlang dueng la na phoe uh tangloeng ngawn, tedae a khuiah thailatnah neh olaeknah a bae la om.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anunae nangmih cadaek rhoek neh Pharisee hlangthai palat rhoek, tonghma rhoek kah hlan te na saii uh tih hlang dueng rhoek kah phuel te na thoeihcam uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah, 'A pa rhoek kah a tue vaengah ng'om uh koinih tonghma rhoek kah a thii dongah amih kah pueipo la ng'om pawt sue,’ na ti uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah tonghma rhoek aka ngawn kah a ca rhoek la na om uh te na oep uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangmih long khaw na pa rhoek kah a hmatoeng ni na koei uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rhul rhoek, rhulthae cadil rhoek, laitloeknah hell lamkah metlam na rhaelrham uh eh?
  </para>
  <para style="p">
    <verse number="34" style="v" />He dongah ni kai loh tonghma rhoek, hlangcueih rhoek neh cadaek rhoek te nangmih taengah kan tueih he. Amih te na ngawn uh vetih na tai uh bal veh. Amih te namamih kah tunim ah na boh uh vetih khopuei lamkah khopuei la na hnaemtaek uh veh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah hlang dueng Abel kah thii lamloh bawkim neh hmueihtuk lakloah na ngawn uh Berikhiah kah capa Zekhriah kah thii duela, diklai hmanah hlang dueng rhoek kah thii a hawk te nangmih soah boeih thoeng.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nangmih taengah rhep kan thui, he rhoek tah tahae kah cadil soah boeih thoeng ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Jerusalem, Jerusalem, tonghma rhoek aka ngawn neh a taengla a tueih rhoek te aka dae, ainu loh aicahui ke a phae hmuiah a hluembael vaengkah a longim bangla na ca rhoek te hluembael ham ka ngaih taitu dae na ngaih uh pawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Na im tah namamih taengah khosoek la a hlahpham coeng he.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah nangmih taengah kan thui, 'Boeipa ming neh aka pawk tah a yoethen pai, 'tila na ti uh hlan atah tahae lamkah loh kai muei na hmuh uh loeng loeng mahpawh,” a ti nah.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh tah bawkim lamloh khoe uh tih Cet. Te vaengah bawkim kah hlinsainah te tueng ham a hnukbang rhoek loh a paan uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae amih te a doo tih, “Boeih na hmuh uh moenih a he? Nangmih taengah rhep kan thui, phil ham pawt koi lungto sokah lungto pataeng hmaai loeng loeng mahpawh he,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Olives tlang ah Jesuh amah bueng a ngol vaengah hnukbang rhoek loh a paan uh tih, “Na lonah neh kumhal kah a bawtnah miknoek tah metlam lae? He rhoek he me vaengah lae a om eh? Kaimih taengah thui lah?” a ti na uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesuh loh amih te a doo tih, “Khat khat loh nangmih te n'rhaithi pawt ham dawn uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai ming neh muep ha pawk uh ni. 'Kai tah Khrih ni,’ a ti uh vetih muep a rhaithi uh ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae caem neh caem kah puenpa na yaak uh tom coeng. Na hmuh uh vaengah let uh boeh. Te khaw a om ham a kuek ngawn dae a bawtnah tah om hlan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namtom loh namtom, ram loh ram a tlai thil ni. Te phoeiah khokha om vetih hmuen tom ah lingluei hinghuen ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae he rhoek boeih he bungtloh a tongnah ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah nangmih te phacipphabaem dongah m'voeih uh vetih nangmih te n'ngawn uh ni. Kai ming kongah namtom boeih kah a hmuhuet la na om uh ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah a cungkuem te a khah uh vetih pakhat te a voeih uh phoeiah pakhat te a thiinah uh ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah laithae tonghma muep thoo vetih hlang muep a rhaithi uh ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Olaeknah te ping vetih lungnah te muep daeh ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae a bawt duela aka ueh te tah daem ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah ram kah olthangthen he namtom boeih taengah laipai la om sak ham lunglai pum boeih ah a hoe ni. Te daengah ni a bawtnah te ha pawk pueng eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah tonghma Daniel loh hmuen cim ah pai tih mitmoengnah neh tueilaehnah a thui te na hmuh uh, aka tae loh yakming saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah Judah kah rhoek loh tlang la rhaelrham uh saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Imphu sokah loh a im kah te puen hamla suntla boel saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lohma kah loh a himbai khuen ham a hnukla bal boel saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae te khohnin ah bungvawn neh cacun la aka om rhoek tah lungma.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Nangmih kah rhaelrhamnah tah sikca neh Sabbath ah a om pawt ham thangthui uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah phacipphabaem muep om ni. Te bang te Diklai tongcuek lamkah loh tahae duela om noek pawt tih ka om bal eh a ti tlaih voel moenih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te khohnin te boem pawt koinih pumsa boeih tah daem mai mahpawh. Tedae a coelh rhoek ham te khohnin a boem pah ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah pakhat loh nangmih taengah, 'Hela khrih he, kela ke,’ a ti atah tangnah boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Laithae khrih neh laithae tonghma rhoek tah thoo uh ni. Coengthai koinih a coelh rhoek pataeng rhaithi ham miknoek a len neh khobae rhambae te a khueh uh ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih taengah kan thui coeng he ne.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah nangmih te, 'Khosoek ah om ke,’ a ti uh atah cet uh boeh. 'Imkhui ah la ke,’ a ti uh akhaw tangnah uh boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khophaa loh khothoeng lamkah cet tih khotlak due a phaa bangla hlang capa kah a lonah khaw om van ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Rhok loh a om nah te langta loh hnap a boo ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tekah phacipphabaem khohnin phoeiah khomik loh tlek hmuep vetih hla loh a aa pae mahpawh. Aisi tah vaan lamkah loh cuhu vetih vaan kah thaomnah loh hinghoek uh ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah Hlang Capa kah miknoek tah vaan ah tueng ni. Diklai koca boeih loh a rhaengae uh vetih, hlang capa loh vaan kah khomai dongah thaomnah, a len la thangpomnah neh ha pawk te a hmuh uh ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah kah puencawn rhoek te olueng ol aka cai neh a tueih vetih a coelh hlang rhoek te dilaikil pali lamkah, vaan ak a soi lamloh a soi duela tingtun uh ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thaibu lamkah nuettahnah te ming uh. A hlaeng loh suepluep la om tih a hnah a boe vaengah khohal tom coeng tila na ming uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangmih khaw he rhoek he boeih na hmuh uh vaengah tah thohka ah ha pawk tom coeng tila ming uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangmih taengah rhep kan thui, he rhoek boeih loh a thoeng hlan atah he cadil he khum loeng loeng mahpawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Vaan neh diklai tah khumpael ni tedae ka ol he ta khumpael rhoerhoe mahpawh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tekah a tue neh khohnin te a Pa bueng pawt atah Capa long khaw, vaan kah puencawn rhoek long khaw ming pawh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Noah tue kah bangla Hlang Capa kah ha lonah khaw om tangloeng van ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tevaeng tue kah rhoek tah tuilii hlan lamkah loh Noah lawng khuila a kun khohnin duela a caak uh, a ok uh, yuuloh vasak, rhaihlan neh om uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuilii lo tih boeih a khuen duela ming uh pawh. Hlang Capa kah a lonah khaw om van tangloeng ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah lohma ah hlang panit om ni. Pakhat te a khuen vetih pakhat a hlah ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Phaklung neh aka kuelh rhoi te pakhat a khuen vetih pakhat a paih ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te dongah hak uh laeh, na Boeipa ha pawk tue te na ming uh moenih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Imkung loh hlanghuen ha pawk tue te ming koinih hak vetih a im te muk sak mahpawh tite na ming uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te dongah nangmih khaw sikim la om uh. Hlang capa tah na poek uh pawt tue vaengah ha pawk ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te koinih uepom neh sal cueih la unim aka om? Anih te boeipa loh a imkhuikho ah a tuetang vaengah amih ham buh aka poep la a khueh.
  </para>
  <para style="p">
    <verse number="46" style="v" />A boei loh ha pawk vaengah a saii te a hmuh tangloeng atah sal te khaw a yoethen.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nangmih taengah rhep ka thui, amah kah khuehtawn boeih soah anih te a om sak ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tedae sal thae long tah a thinko khuiah, 'Ka boeipa tah di coeng,’ a ti.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te dongah a sal puei rhoek te koe a boh. Aka rhui rhoek taengah a caak tih a ok van.
  </para>
  <para style="p">
    <verse number="50" style="v" />A lamso pawh khohnin neh a ming pawt tue vaengah ni boeipa loh sal te a paan eh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te vaengah anih te a tloek vetih a paihmuen te hlangthai palat rhoek taengla a khueh pah ni. Te rhoek ah rhah neh no rhuengnah ni a om eh.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah vaan ram tah oila parha neh vai uh. Te rhoek loh amamih kah hmaiim te a khuen tih yulokung doenah la cet uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amih khuikah panga tah hlang ang la om uh tih panga tah cueih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aka ang rhoek loh amamih kah hmaiim te a khuen uh dae situi te amamih taengah khuen uh pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aka cueih rhoek tah amamih kah hmaiim te palang dongkah situi neh a khuen uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yulokung te a di dongah boeih ngam uh tih ip uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khoyin boengli atah, 'Yulokung ke, Amah doe hamla cet uh laeh,’ tila tamlung a soeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah oila rhoek tah boeih thoo uh tih a hmaiim te a tok uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aka ang rhoek loh aka cueih rhoek taengah, 'Nangmih kah situi te kaimih m'pae uh laem, kaimih kah hmaiim tah thi pawn ni,’ a ti uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae aka cueih loh a doo uh tih, 'Te koinih nangmih ham neh kaimih ham rhoeh voel mahpawh, aka yoi rhoek taengah lat cet uh lamtah namamih ham lai uh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lai hamla a caeh uh vaengah yulokung tah ha pawk. Te dongah aka sikim rhoek tah yulueinah khuiah amah neh kun uh tih thohka te a khaih.
  </para>
  <para style="p">
    <verse number="11" style="v" />A tloe oila rhoek tah hnukkhueng la pawk uh van tih, “Boeipa, boeipa, kaimih ham khaw ong dae,” a ti uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae a doo tih, “Nangmih taengah rhep kan thui nangmih te kan ming moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah hak uh laeh, a tue neh khohnin te na ming uh moenih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aka yiin ham hlang loh a sal rhoek te a khue tih a khuehtawn te amih taengah a tloeng pah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah amamih kah a thaomnah tarhing la pakhat te talen panga, pakhat te panit, pakhat te pakhat rhip a paek tih yiin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Talen panga aka dang tah tlek cet tih te rhoek nen te a saii dongah a tloe panga a dang thil.
  </para>
  <para style="p">
    <verse number="17" style="v" />Panit aka dang long khaw a tloe panit a dang thil tangloeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae pakhat aka dang tah cet tih diklai a too. Te phoeiah a boeipa kah tangka te a thuh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A tue a sen phoeiah boeipa loh sal rhoek te a paan tih amih taengah bitat te a soepsoei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah talen panga aka dang loh talen panga han khuen thil tih a paan. Te phoeiah, “Boeipa, Kai he talen panga nan paek tih talen panga ka dang thil he,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />A boeipa loh anih te, “Then, uepom neh sal then a yool soah uepom la na om dongah nang tah a yet soah khaw kang khueh pai eh. Na boeipa kah omngaihnah khuiah kun van,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Talen panit long khaw a paan tih, “Boeipa kai taengah talen panit nan paek tih talen panit ka dang thil he,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />A boeipa loh anih te, “Then, uepom neh sal then a yool soah uepom la na om tih nang te a yet soah kang khueh ni. Na boeipa kah omngaihnah khuiah kun van,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Talen pakhat aka dang long khaw a paan tih, “Boeipa, nang he mangkhak hlang la na om, na tuh pawt nah ah te na ah tih na haeh pawt nah ah na yoep te ka ming.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka rhih dongah ka ceah neh nang kah talen te lai ah ka thuh. Na khueh te om ta he,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae a boeipa loh anih te a doo tih, 'Sal boethae neh yaikat aw, ka tuh pawt ah ka ah tih ka haeh pawt ah ka coi te na ming.
  </para>
  <para style="p">
    <verse number="27" style="v" />Namah khaw a kuek ta, kai kah tangka te tangkapu taengah na khueh ham om. Te daengah man kai ka pawk vaengah a casai neh ka tangka te ka dang ve.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah anih taengkah talen te lo uh lamtah talen parha aka khueh te pae uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aka khueh boeih te a paek thil vetih a coih pah ni. Tedae aka khueh pawt te a khueh duen pataeng te a taeng lamkah loh a loh pa ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah sal hlangkhue hlangvaih te poengben kah yinnah khuila voei uh, te ah te rhah neh no rhuengnah neh om ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hlang Capa tah amah kah thangpomnah dongah a taengkah puencawn rhoek boeih neh ha pawk vetih a thangpomnah ngolkhoel dongah ngol ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah namtom boeih tah amah hmaiah a coi vetih tudawn loh maae taeng lamkah tu te a hoep bangla amih te rhip a hoep ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tu rhoek tah amah kah bantang ah, maae rhoek te banvoei ah a pai sak ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah manghai loh a bantang ben kah rhoek te, “Halo, a pa kah a uem rhoek, Diklai a tongnah lamloh nangmih ham a rhoekbah ram te pang uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ka pong vaengah caak ham te kai nan paek uh, ka halh vaengah kai nan tul uh. Yinlai la ka om vaengah kai nan khue uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka pumtling vaengah kai nan khuk uh. Ka tlohtat vaengah kai nan hip ah ka om vaengah kai taeng la na pawk uh,’ a ti nah ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah aka dueng rhoek loh, “Boeipa me vaengah lae na bungpong te ka hmuh uh tih kang khut uh, na halh vaengah kan tul uh?
  </para>
  <para style="p">
    <verse number="38" style="v" />Me vaengah nim nang te yinlai la kam hmuh uh tih kang khue uh, na pumtling tih kang khuk uh?
  </para>
  <para style="p">
    <verse number="39" style="v" />Me vaengah lae na tlohtat te kan hmuh uh tih thongim ah khaw nang taengla ka pawk uh,’ a ti uh ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah manghai loh amih te a doo vetih, 'Nangmih taengah rhep ka thui, ka manuca rhoek khuiah a yit koek pakhat taengah na saii uh te tah kai taengah ni na saii uh,’ a ti nah ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah banvoei kah rhoek te khaw, 'Thaephoei thil rhoek, kai taeng lamkah loh, rhaithae neh a puencawn rhoek ham a hmoel pah dungyan hmai khuila cet uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka pong vaengah caak ham khaw kai nan pae uh pawt tih, ka halh vaengah kai te nan tul uh moenih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Yinlai la ka om vaengah kai nang khue uh moenih. Ka pumtling vaengah kai nan khuk uh moenih. Ka tattloel neh thongim ah kai nan hip uh moenih,’ a ti nah ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te vaengah amih rhoek loh a doo uh vetih, 'Boeipa me vaengah lae na pong, halh tih yinlai neh na pumtling te khaw ka hmuh uh? Me vaengah lae na tattloel neh thongim ah nang kan talong uh pawh? a ti uh ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te vaengah amih te a doo vetih, 'Nangmih taengah rhep ka thui, he rhoek khuiah a yit ca pakhat ham pataeng na saii uh pawt te tah kai ham na saii uh pawt la om,’ a ti nah ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te vaengah amih te dungyan dantatnah khuila cet uh ni. Tedae aka dueng roek tah dungyan hingnah khuila kun uh ni,” a ti nah.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh loh hekah ol he boeih a khah tom vaengah a hnukbang rhoek te,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hnin nit phoeiah yoom om ni tila na ming uh, hlang capa tah te vaengah tai hamla a tloeng coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah khosoihham rhoek neh pilnam khuikah patong rhoek tah Kaiaphas la a khue khosoihham kah vongup ah tingtun uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesuh te tuengkhuepnah neh tuuk phoeiah ngawn ham dawtlet uh thae.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae, “Khotue vaengah boel saeh, pilnam khuiah olpungnah la om pawt nim,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesuh te Bethany kah hmaibae Simon im ah om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih te a phu aka kuel, botui lungbok aka pom huta loh a paan tih aka vael Jesuh kah a lu te a suep thil.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hmuh uh vaengah hnukbang rhoek loh a yakdam uh tih, “He vakrhanah la he.
  </para>
  <para style="p">
    <verse number="9" style="v" />He tah a yet la a yoih vetih khodaeng a paek thai dae ta,” a ti uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae Jesuh loh a ming vaengah amih te, “Balae tih huta he thakthaenah neh na toeh uh, kai hamla bibi then ni a saii.
  </para>
  <para style="p">
    <verse number="11" style="v" />khodaeng rhoek tah nangmih taengah om taitu ta, tedae kai he ka om taitu moenih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huta loh ka pum dongah botui a suep he kai kah rhokkhoem ham ni a saii coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangmih taengah rhep ka thui, Diklai pum kah olthangthen a hoe nah takuem ah anih loh a saii he khaw a kutmuei la a thui ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlainit khuikah pakhat Judah Iskariot la a khue tah vik cet.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khosoihham rhoek taengah, “Na ngaih yet te mah kai m'pae uh anih te nangmih taengah ah kan tloeng bitni,” a ti nah. Te dongah anih ham tangka sawmthum a cun uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaeng lamloh Jesuh te voeih ham a tuethen a dawn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vaidamding kah a cuek khohnin ah hnukbang rhoek loh Jesuh te a paan uh tih, “Melam na ngaih dae, yoom na caak ham ka rhuengphong uh pawn eh?” a ti na uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah Jesuh loh, “Khopuei la cet uh lamtah pakhat taengah, 'Saya loh, 'Kai kah a tue tah om tom coeng, nang taengah ka hnukbang rhoek neh yoom ka saii ni,’ a ti, 'ti na uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesuh loh amih a thuinuet bangla hnukbang rhoek loh a saii uh tih Yoom te a rhuengphong uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlaem a pha vaengah hlainit taengah a vael.
  </para>
  <para style="p">
    <verse number="21" style="v" />A caak uh li vaengah, “Nangmih taengah rhep ka thui, nangmih khuikah pakhat loh kai m'voeih ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah bahoeng a kothae uh tih amah te, “Boeipa, kai ka om mai khaming,” rhip pahoi a ti uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae amah loh a doo tih, “Kai taengah baeldung khuila kut aka puei loh kai m'voeih ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlang Capa tah amah kawng a daek pah bangla cet ngawn ta. Tedae anih kongah Hlang Capa a voeih sak hlang tah anunae. Tekah hlang tah cun pawt koinih anih ham then ngai ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah anih aka voei Judah loh a doo tih, “Rhabbi, kai ka om mai khaming “ a ti nah hatah anih te, “Na thui coeng te,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />A caak uh vaengah Jesuh loh vaidam te a loh tih a uem tih a aeh. Te phoeiah hnukbang rhoek te a paek tih, “Doe uh lamtah ca uh, he tah kamah pum ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah boengloeng te a loh tih a uem phoeiah amih te a doe tih, “Te te boeih o uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />He tah kamah kah paipi thii ni. A yet kah tholh khodawkngainah ham ni a long.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae nangmih taengah kan thui, tahae lamkah loh misur thaih he ka o loeng loeng mahpawh. Te khohnin a pha hlan atah a pa kah ram khui daengah ni nangmih taengah a thai la ka ok eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah a hlai doeah Olives tlang la cet uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Jesuh loh amih te, “He khoyin ah tah kai kongah nangmih boeih n'khah uh ni, 'Tudawn te ka tam vetih tuping dongkah tu tah taekyak uh ni'tila a daek coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae kai ka thoh phoeiah Galilee la nangmih hmaiah ka lamhma ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Peter loh amah te a doo tih, “A cungkuem he nang kongah a khah uh akhaw kai tah n'khap mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesuh loh Peter taengah, “Nang taengah rhep kan thui, tu khoyin kah ai a khong hlanah kai he voei thum nan huek uh tak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Peter loh Jesuh taengah, “Nang taengah ka duek ham kuek cakhaw nang kan huek uh tak loeng loeng mahpawh,” a ti nah. Hnukbang rhoek long khaw boeih a ti uh van.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah Jesuh tah hnukbang rhoek neh Gethsemene la a khue hmuen la pawk uh. Te vaengah hnukbang rhoek te, “He rhoek ana ngol uh dae ka cet tih ka thangthui phai narhuet ah,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah Peter neh Zebedee kah ca rhoi te a khuen tih khothae neh khobing te a tong.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah amih te, “Ka hinglu loh dueknah te ngang a yaak coeng, heah ana naeh uh lamtah kai n'hak puei uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te phoeiah hawt lamhma phai tih a maelhmai neh bakop thuk. Te phoeiah thangthui tih, “A Pa a coeng thai atah hekah boengloeng he kai taeng lamkah loh khoe mai. Tedae kai ngaih banglam pawt tih namah ngaih bangla om saeh,” a ti.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te phoeiah hnukbang rhoek te a paan hatah a ih uh te a hmuh. Te dongah Peter te, “Khonoek pakhat khaw kai taengah hak ham na noeng uh moenih a?” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Cuekhalhnah khuiah na kun uh pawt ham hak lamtah thangthui uh. Mueihla loh a yakvawt ngawn dae pumsa tah tattloel pueng
  </para>
  <para style="p">
    <verse number="42" style="v" />Te phoeiah a pabae la cet tih thangthui. Te vaengah, “A pa he he poenghal ham neh ok pawt ham ni a coeng pawt oeh atah namah kongaih la om saeh,” a ti.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te phoeiah koep ha pawk hatah amih a ih te a hmuh. Amih aka om rhoek te a mik loh bakba a hap sak.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te dongah amih te sut a hlah tih a pathum na koep a caeh vaengah amah ol bangla koep a thui tih thangthui.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te phoeiah hnukbang rhoek te a paan tih, “Yulh ip lamtah vawk mong uh, a tue yoei coeng tih hlang capa tah hlangtholh kut ah a voeih coeng he.
  </para>
  <para style="p">
    <verse number="46" style="v" />Thoo uh, mawt uh thae sih. Kai aka voei tah ha yoei coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="47" style="v" />A cal li ah hlainit khuikah pakhat Judah te pakcak ha pawk. Te vaengah anih te hlangping a yet loh cunghang neh, thingboeng neh, khosoihham rhoek neh, pilnam kah a ham rhoek neh ham pueiuh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Amah aka voei loh hlangping te miknoek a paek tih, “Ka mok te tah anih ni, anih te tuu uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te dongah Jesuh te koe a paan tih, “Rhabbi, na sading saeh,” a ti na tih a mok.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tedae Jesuh loh anih taengah, “Pueivan aw balae aka om?” a ti nah. Te vaengah Jesuh te a paan uh, kut a hlah thil uh tih a tuuk uh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te vaengah Jesuh taengkah pakhat loh kut a yueng tih a cunghang te a yueh. Te phoeiah khosoihham kah sal te a tloek tih a hna a pat pah.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jesuh loh anih te, “Na cunghang te amah hmuen ah koep khueh laeh, cunghang aka muk boeih tah cunghang dongah poci uh ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />A pa te khue ham coeng mahpawh tila na poek uh a? Puencawn caempuei caempa hlainit hlai pataeng kai ham pahoi a paisak ni ta.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te koinih, cacim loh a om ham a kuek te metlam a soep pai eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tekah a tue ah Jesuh loh hlangping te, “Kai tuuk ham thingboeng, cunghang neh dingca bangla nam paan uh, hnin takuem bawkim ah ka ngol tih ka thuituen vaengah kai nan tuuk uh pawt lae?
  </para>
  <para style="p">
    <verse number="56" style="v" />Tedae aka om boeih nen he ni tonghma rhoek kah cacim khaw a soep eh,” a ti nah. Te vaengah Jesuh te hnukbang rhoek loh boeih a toeng uh tih rhaelrham uh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Te vaengkah aka tuu rhoek loh Jesuh te khosoihham Kaiaphas taengah a khuen uh. Te rhoek ah cadaek rhoek neh a ham rhoek tah tingtun uh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Peter loh khosoihham kah vongup duela hawt a vai. Te phoeiah hnuktloih te ming hamla a khuila kun tih tueihyoeih rhoek taengah ngol.
  </para>
  <para style="p">
    <verse number="59" style="v" />Khosoihham rhoek neh khoboei rhoek boeih loh Jesuh te ngawn hamla a hong a hi neh a paelnaeh thil uh.
  </para>
  <para style="p">
    <verse number="60" style="v" />A paelnaeh uh tloel vaengah laithae laidang neh muep a paan uh. Tedae a tloihsoi ah panit loh a paan tih,
  </para>
  <para style="p">
    <verse number="61" style="v" />“Anih loh , 'Pathen kah bawkim te phae tih hnin thum ah ka sak thai,’ a ti,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Te vaengah khosoihham te pai tih, “Amih rhoi loh nang m'pael te na doo mapawt a?” a ti nah.
  </para>
  <para style="p">
    <verse number="63" style="v" />Tedae Jesuh loh hil a phah. Khosoihham loh, “Nang he Pathen capa Khrih la na om tangtang atah kaimih taengah thui lah tila aka hing Pathen ming neh nang kan ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="64" style="v" />Jesuh loh anih te, “Namah loh na thui coeng. Tedae nangmih taengah ka thui, tahae lamloh Hlang Capa te thaomnah bantang ah ngol vetih vaan kah muei dongah ha pawk te na hmuh uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="65" style="v" />Te vaengah khosoihham loh a himbai te a phen tih, “A soehsal coeng, mebang laipai lae koep n'ngoe eh?, a soehsalnah khaw na yaak uh coeng he.
  </para>
  <para style="p">
    <verse number="66" style="v" />Metlam na poek ?” a ti nah. Te vaengah a doo uh tih, “A dueknah om kueluek saeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="67" style="v" />Te phoeiah Jesuh te a maelhmai ah a timthoeih uh tih a thoek uh.
  </para>
  <para style="p">
    <verse number="68" style="v" />Te vaengkah aka bael rhoek loh, “Khrih nang, kaimih taengah phong lah, unim nang aka bael te,” a ti na uh.
  </para>
  <para style="p">
    <verse number="69" style="v" />Tedae Peter tah vongup khuiah hoeih ngol. Te vaengah salnu pakhat loh anih te a paan tih, “Nang khaw Galilee kah Jesuh taengah na om,” a ti nah.
  </para>
  <para style="p">
    <verse number="70" style="v" />Tedae hlang boeih hmaiah basa tih, “Na thui te ka ming moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="71" style="v" />Te phoeiah vongka la cet dae a tloe loh a hmuh tih tekah rhoek taengah, “Anih he Nazareth Jesuh taengah om,” a ti nah.
  </para>
  <para style="p">
    <verse number="72" style="v" />Te vaengah, “Tekah hlang te ka ming moenih,” tila olhlo neh koep basa.
  </para>
  <para style="p">
    <verse number="73" style="v" />Rhaih a om atah aka pai rhoek loh Peter te a paan uh tih, “Namah khaw amih kah hlang rhep ni, namah kah olcal long mah nang m'mingpha sak coeng,” a ti na uh.
  </para>
  <para style="p">
    <verse number="74" style="v" />Tedae pahoi thae a phoei tih, “Tekah hlang te ka ming moenih, “tila a toemngam vaengah ai tlek khong.
  </para>
  <para style="p">
    <verse number="75" style="v" />Te vaengah Peter loh Jesuh kah olka, “Ai a khong hlanah kai voei thum nan huek uh tak ni,” a ti nah te poek. Te dongah phawn cet tih hlawk hlawk rhap.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mincang a pha atah Jesuh te duek sak hamla khosoihham rhoek neh pilnam khuikah a ham rhoek tah dawtletnah boeih a khueh uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesuh te a khih uh phoeiah a khuen uh tih khoboei Pilat taengah a thak uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesuh a boe sak uh te anih aka voei Judah loh a hmuh vaengah yut tih khosoihham rhoek neh a ham rhoek taengah tangka sawmthum te a balkhong.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ka tholh tih ommongsitoe thii ka voeih,” a ti nah. Tedae te rhoek loh , “Kaimih neh balae benbo benpang, namah loh ming saw,” a ti na uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah tangka te bawkim khuiah a voeih tih vik khoe uh. Te phoeiah cet tih kuiok.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae khosoihham rhoek loh tangka te a loh uh tih, “Thii phu la a om dongah Korban khuila khueh ham tueng pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah dawtletnah a khueh uh tih te nen te kholong rhoek kah phuel la ambop kah lo te a lai uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah te kah lohmuen tah tihnin due, “Thii lohmuen, “tila a khue uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah tonghma Jeremiah loh a thui tah soep coeng. Te vaengah, “Tangka sawmthum te a doe uh. A phu a tloek te Israel ca rhoek lamloh a tloek uh,” a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah ka boeipa loh a thuinuet bangla ambop kah lohmuen te tangka la a paek uh,” a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesuh te khoboei hmaiah a pai vaengah khoboei loh a dawt tih, “Nang Judah manghai la na om a?” a ti nah hatah Jesuh loh, “Namah long ni na ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah khosoihham rhoek neh patong rhoek loh Jesuh te a paelnaeh dae a doo moenih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Pilat loh Jesuh te, “Nang he muep m'pael uh te na yaak moenih a?” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Jesuh loh olka kam khat nen pataeng a lan pawt dongah khoboei te bahoeng a ngaihmang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khotue ah ana sainoek tah khoboei loh hlangping ham amamih ngaih thongtla pakhat te a hlah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah Barabbas Jesuh la a khue thongtla mingthang te a khueh uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amih a tingtun uh vaengah Pilat loh amih te, “Jesuh Barabbas neh Khrih la a khue Jesuh khuiah nangmih ham ulae kan hlah ham na ngaih uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Uethnetnah dongah anih he a voeih uh tila a ming.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pailat te laitloek ngolkhoel dongah a ngol vaengah a yuu loh anih te ol a tah tih, “Hlang dueng te nang hut moenih, anih kongah tihnin ka mang ah mat ka patang,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae khosoihham rhoek neh a ham rhoek loh Barabbas te bih tih Jesuh te poci hamla hlangping te a yoek uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah khoboei loh amih te a doo tih, “Panit khuiah ulae nangmih taengah hlah ham na ngaih uh,” a ti nah. Te vaengah te rhoek loh, “Barabbas,” a ti uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pilat loh amih taengah, “Te koinih Khrih la a khue Jesuh te metlam ka saii eh?” a ti nah hatah, “Tai saeh,” boeih a ti uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae Pilat loh, “Balae thae a saii te,” a ti nah . Te vaengah amih pang uh khungdaeng tih, “Tai laeh,” a ti uh .
  </para>
  <para style="p">
    <verse number="24" style="v" />Pilat loh a hoeikhang hae moenih olpungnah ni aka om tila a hmuh. Tui a loh tih hlangping hmaiah kut a yuh phoeiah, “Anih thii dongah ommongsitoe lamni ka om, namamih loh na ming bitni,” a ti nah .
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah pilnam boeih loh a doo tih, “Anih kah thii tah kaimih so neh ka ca rhoek soah tla saeh,” a ti nah .
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah amih hamla Barabbas te a hlah pah. Tedae Jesuh te a tam tih tai ham a paek.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Jesuh te khoboei kah rhalkap rhoek loh khoboeiyung la a khuen uh tih caem pum loh a tingtun thil uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A himbai te a pit pa uh tih rhalkap himbai a nukyum te anih a bai sakuh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hling rhuisam khaw a vaeh uh tih a lu soah a khuem sakuh. Te phoeiah capu kong te a bantang kut ah a pom sakuh. Te vaengah a hmaiah cungkueng neh a tamdaeng uh tih, “Judah manghai na sading saeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah Jesuh te a timthoeih uh, capu te a loh uh tih a lu ah a boh uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesuh a tamdaeng uh vaengah rhalkap himbai te a pit pa uh tih amah kah himbai te a bai sakuh. Te phoeiah tai hamla a khuen uh .
  </para>
  <para style="p">
    <verse number="32" style="v" />A caeh uh vaengah Kurena hlang, a ming ah Simon te a hmuh uh tih anih te thinglam te a koh hamla a tanolh uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah Golgotha a ti hmuen la pawk uh. Te tah lurhuh la a khue hmuen ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah ankhaa neh a thoek misurtui te ok hamla Jesuh te a paek uh dae a ten vaengah ok ham ngaih pawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Anih a tai uh phoeiah tah a himbai te tael uh thae tih hmulung a naan uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah ngol uh tih amah te pahoi a tawt uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah a paelnaehnah te a lu soah a khing pa uh tih, “Anih tah Judah manghai Jesuh ni,” tila a daek.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah dingca rhoi tah Jesuh taengkah banvoei ah pakhat neh bantang ah pakhat a tai uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Aka van paitai loh a lu a hinghuen uh tih anih te a soehsal uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te vaengah, “Bawkim te aka phae tih hnin thum ah aka sa aw, namah te khang uh lamtah Pathen Capa la na om atah thinglam lamloh suntla lah saw,” a ti na uh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Khosoihham rhoek , cadaek rhoek neh a ham rhoek long khaw a tamdaeng uh van.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Hlang tloe te a khang tih amah te khang thai pawh, Israel manghai ni, thinglam lamloh suntla laeh saeh, te vaengah anih te ka tangnah uh bitni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Pathen dongah pangtung lah ko, a ngaih atah hlawt laeh saeh, 'Kai he Pathen Capa ni,’ a ti lah ko,” a ti uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />A taengkah a tai uh dingca rhoi long khaw amah la a thuithet rhoi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Khonoek parhuk lamloh khonoek pako duela diklai boeih te yinnah loh a khuk thil coeng.
  </para>
  <para style="p">
    <verse number="46" style="v" />Khonoek pako tluk atah Jesuh tah ol a len pang tih, “Eli Eli lama sabakhthani,” a ti. Te tah, 'Ka Pathen, Ka Pathen oeh, balae tih kai nan phap,' tila om.
  </para>
  <para style="p">
    <verse number="47" style="v" />Aka pai rhoek khuikah hlangvang a yaak uh vaengah, “Anih loh Elijah a khue,” a ti uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te vaengah amih khuikah pakhat tah tlek yong tih caethum te a loh. Yuthui neh a sul phoeiah capu kong dongah a yen tih Jesuh te a tul.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tedae a tloe rhoek loh, “Hlah dae, anih aka khang ham Elijah ha pawk venim so uh lah sih,” a ti uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te phoeiah Jesuh te ol a len ngai la koep pang tih mueihla te pak a hlah.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te vaengah bawkim kah hniyan te a so lamloh a hmui due panit la pawn tih diklai khaw hinghuen, lungpang khaw paeng.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hlan khaw ong uh tih aka ip tangtae hlangcim rhoek kah a pum muep thoo uh.
  </para>
  <para style="p">
    <verse number="53" style="v" />A thohkoepnah hnukah phuel lamkah aka cet rhoek tah khopuei cim la kun uh tih muep a yaak sakuh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te vaengah rhalboei neh anih taengkah Jesuh aka tawt rhoek loh lingluei neh aka thoeng hno te a hmuh uh tih bahoeng a rhih uh. Te vaengah, “Anih tah Pathen Capa la om tangtang,” a ti uh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tekah aka om huta rhoek long khaw a hla lamloh muep a hmuh uh. Amih loh Jesuh te Galilee lamkah a vai uh tih a taengah thotat uh.
  </para>
  <para style="p">
    <verse number="56" style="v" />Amih lakliah Magadala kah Mary, James neh Joseph kah a manu Mary neh Zebedee kah capa rhoek kah a manu khaw om.
  </para>
  <para style="p">
    <verse number="57" style="v" />Hlaem a pha vaengah tah Arimathea kah kuirhang hlang pakhat a ming ah Joseph te ha pawk. Anih tah amah rhoe khaw Jesuh taengah bang.
  </para>
  <para style="p">
    <verse number="58" style="v" />Anih loh Jesuh rhok bih hamla Pilat te a paan vaengah mael hamla Pilat loh ol a paek.
  </para>
  <para style="p">
    <verse number="59" style="v" />Joseph loh rhok te a loh phoeiah hnipen aka caih neh a yen.
  </para>
  <para style="p">
    <verse number="60" style="v" />Te phoeiah lungpang khuiah a thai la a thuk hlan khuiah a khueh. Te vaengah hlan thohka te lungto len a paluet thil tih a caeh tak .
  </para>
  <para style="p">
    <verse number="61" style="v" />Te vaengah Magadala Mary neh a tloe Mary tah pahoi om tih hlan kah hmai ah ngol rhoi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Rhuengphongnah a om phoeikah a vuen ah khosoihham rhoek neh Pharisee rhoek loh Pilat taengah tingtun uh .
  </para>
  <para style="p">
    <verse number="63" style="v" />Te vaengah “Boeipa, te kah laithaelaidang loh a hing vaengah, “'Hnin thum phoeiah ka thoo ni,’ a ti te ka poek uh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Te dongah hlan te a thum hnin duela tawt ham olpae mai. A hnukbang rhoek ha pawk uh tih huen uh ve. Te vaengah pilnam taengah, 'Duek lamloh thoo coeng,’ ti ve. Te dongah a hnukkhueng kah tholhhiknah tah lamhma lakah a thae la om ve,” a ti uh.
  </para>
  <para style="p">
    <verse number="65" style="v" />Pilat loh amih taengah, “Rhaltawt na khueh uh te ta, Cet uh lamtah na ming uh bangla tawt uh,” a ti nah .
  </para>
  <para style="p">
    <verse number="66" style="v" />Te phoeiah amih te cet uh tih phuel ah rhaltawt taengkah lungto te kutnoek a daeng thil tih a khoh uh .
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath poeng kah Sabbath aka paan cuek mincang vaengah Magadala Mary neh a tloe Mary te hlan hip hamla ha pawk uh .
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah lingluei a tloh la hlawt hinghuen. Boeipa kah puencawn loh vaan lamkah ha rhum dongah lungto te a paan tih a paluet phoeiah a ngol thil.
  </para>
  <para style="p">
    <verse number="3" style="v" />A mueisa tah khophaa bangla om tih a himbai te khaw vuelsong bangla bok.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah aka tawt rhoek loh a rhihnah neh thuen uh tih duek rhok bangla om uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah puencawn loh huta rhoi te a doo tih, “Nangmih rhoi loh rhih boeh, a tai uh tangtae Jesuh na toem rhoi te ka ming.
  </para>
  <para style="p">
    <verse number="6" style="v" />He rhoek ah a om moenih, a thui bangla thoo coeng. Halo lamtah a yalh nah hmuen te so rhoi lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah koe cet lamtah a hnukbang rhoek te, 'Duek lamloh a thoh coeng te thui pah. Nangmih lakah Galilee la lamhma phai coeng ke, te rhoek ah amah na hmuh uh bitni. Nangmih taengah kan thui coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah hlan lamloh rhihnah neh tatloe la cet uh. Te phoeiah a hnukbang rhoek taengah puen hamla omngaihnah neh muep yong uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah Jesuh loh amih te pakcak a doe tih, “Omngaih uh lah,” a ti nah. Amih long khaw a paan uh tih a kho te a kop uh tih a bawk uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah Jesuh loh amih te, “Rhih uh boeh, cet uh lamtah ka manuca rhoek taengah puen uh. Galilee la ana cet uh saeh lamtah kai m'hmuh uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amih rhoek te a mael uh vaengah rhaltawt a ngen te khopuei khuila pakcak pawk uh tih aka thoeng boeih te khosoihham rhoek taengah puen uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah a ham rhoek te tingtun uh tih dawtletnah a khuehuh. Tangka a khuen uh khungdaeng tih rhalkap rhoek te a paek uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah, “Khoyin ka ih vaengah a hnukbang ha pawk tih a huen uh, 'ti uh ne.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te te khoboei taengla a yaak atah, anih te kaimih loh ka hloih uh vetih nangmih te bidip la kan khueh uh bitni,” a ti na uh .
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah te rhoek loh tangka te a doe uh tih a thuituen bangla a saii uh . Te dongah tekah ol tah tihnin khohnin duela Judah rhoek taengah a thui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah hnukbang hlaikhat tah Jesuh loh amih a uen nah Galilee kah tlang la cet uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amah te a hmuh uh tih a bawk uh dae hlangvang loh a uepvawt uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah Jesuh loh a paan tih amih te a voek. Te vaengah, “Diklai hman neh vaan ah saithainah boeih tah kai taengah m'paek coeng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah cet uh lamtah namtom boeih te ham bang sakuh. Amih te Pa, Capa, Cim Mueihla kah ming neh nuem uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangmih kang uen boeih te tuem sak ham amih te thuituen uh. Kai khaw nangmih taengah kumhal kah a bawtnah duela hnin takuem ka om coeng he,” a ti nah.
  </para>
</usx>
