<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PHM" style="id">Philemon</book>
  <para style="h">Philemon</para>
  <para style="toc1">Philemon</para>
  <para style="toc2">Philemon</para>
  <para style="mt">Philemon</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh Khrih kah thongtla Paul neh Timothy loh manuca neh kaimih kah thintlo neh bibipuei Philimon,
  </para>
  <para style="p">
    <verse number="2" style="v" />ka ngannu Apphia neh kaimih kah rhalkappuei Arklipas neh nang im kah hlangboel taengah kan yaak sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mamih kah Pa Pathen neh Boeipa Jesuh Khrih taeng lamkah Lungvatnah neh ngaimongnah nangmih taengah om saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka thangthuinah takuem ah nang kah na saii te ka poek taitu tih ka Pathen te ka uem.
  </para>
  <para style="p">
    <verse number="5" style="v" />Boeipa Jesuh so neh hlang cim rhoek boeih soah nangmih kah lungnah neh tangnah na khueh uh te ka yaak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te daengah ni mamih ah Khrih ham a then mingnah cungkuem neh na tangnah dongkah rhoinaengnah te khuekcet la a om eh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang kah lungnah dongah omngaihnah neh thaphohnah muep ka khueh coeng. Manuca na saeh, nang rhangneh hlangcim rhoek kah a kotak tah paang caih uh coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah a tueng te tah Khrih ah sayalhnah muep khueh sak ham ni nang n'tueih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Patong bangla aka om Paul long he lungnah neh lat kan hloep.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae Khrih Jesuh kah thongtla long khaw ka ca ham te nang kan hloep coeng. Amah Onesima he hloong dongah ni ka sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih te hnukbuet ah nang ham a hoeihae coeng dae, tahae atah nang ham neh kai ham khaw congpang coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih te nang tengah kan tueih. Te ni ka kotak ah aka om.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih te ka taengla khueh ka ngaih. Te daengah ni olthangthen kah hloong khuiah khaw nang yueng la kai m'bongyong eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae nang kah mingpueinah pawt atah saii ka ngaih moenih. Te daengah ni nang a then loh kueknah lam pawt tih, namah kongaih ningla a om eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tahae kah hnin at na paek uh rhoi dongah anih te dungyan na dang khaming.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih he sal voel pawt tih sal lakah olpuei la kai ham tah thintlo manuca la om coeng. Pumsa neh Boeipa ah nang ham muep lat hoekhang coeng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah kai he pueipo la nan khueh atah kai bangla anih te doe.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae nang soah thae tih lai a ba khoem atah te te kai hut la nawt laeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kai Paul loh kamah kut neh kan daek coeng. Kamah loh kan sah bitni. Te te nang taengah, 'Nang khaw kai lai na ba van,’ ka ti moenih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thuem pai, manuca nang, kai tah nang lamlong ni Boeipa dongah ka hoeikhang. Ka kotak tah Khrih ah mong coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang kah olngainah te ka pangtung dongah ni nang taengah kan daek. Ka thui te a pueh la na saii pataeng ni tila ka ming.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pahoi ah kai ham khaw pahnah rhoekbah lah. Nangmih kah thangthuinah rhangneh nangmih khodawkngai ham te ka ngaiuep.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesuh Khrih kongah kai kah thongtlapuei Epaphras,
  </para>
  <para style="p">
    <verse number="24" style="v" />kai kah bibipuei rhoek Marku, Aristarkhu, Demas neh Luka loh nang te kut n'tuuk uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Boeipa Jesuh Khrih kah lungvatnah tah nangmih kah mueihla neh om saeh.
  </para>
</usx>
