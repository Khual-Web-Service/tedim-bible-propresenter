<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LUK" style="id">Luka</book>
  <para style="h">Luka</para>
  <para style="toc1">Luka</para>
  <para style="toc2">Luka</para>
  <para style="mt">Luka</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mamih taengah aka soep tangtae hno kah cilol te muep a thuep tih boelrhai vaengah,
  </para>
  <para style="p">
    <verse number="2" style="v" />oltak kah tueihyoeih la aka om rhoek neh a tongcuek lamloh loh aka hmu rhep rhoek loh mamih taengah m'paek uh vanbangla,
  </para>
  <para style="p">
    <verse number="3" style="v" />kai khaw khaeh khaeh boeih ka thuep koep tih hlangcong Theophilu nang taengah daek ham tluep ka poek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te daengah ni hiluepnah ol loh n'thuituen te khaw na ming eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judea manghai Herod tue vaeng ah, Abijah rhoihui khosoih pakhat, a ming ah Zekhariah te om tih Elizabeth aka ming nah Aaron canu te a yuu nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathen hmaiah a dueng la bok om rhoi. Boeipa kah rhilam neh olpaek cungkuem dongah cuemthuek la pongpa rhoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae Elizabeth tah cakol la om tih camoe a om kolla a kum khaw patong la bok om rhoi coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen hmaiah a khosoih vaengkah bangla anih rhoihui te aitlaeng loh a pha.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khosoih kah khosing bangla, Boeipa kah bawkim khuiah kun tih hmueihphum ham a yo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bo-ul tue vaengah pilnam khuikah aka om rhaengpuei boeih khaw poeng ah thangthui uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Boeipa kah puencawn tah a taengah a phoe pah tih bo-ul hmueihtuk kah bantang ah pai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zekhariah loh a thuen doela a sawt dongah rhihnah loh anih a tlak thil.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae anih te puencawn pakhat loh, “Zekhariah rhih boeh, nang kah rhenbihnah te a hnatun coeng dongah na yuu Elizabeth loh nang ham capa pakhat han cun vetih, a ming te Johan la na khue ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang ham omngaihnah neh kohoenah la om vetih anih kah rhuirhong dongah boeih omngaih uh ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Boeipa hmaiah a len la om vetih, misurtui neh yu te o loengloeng mahpawh. A manu bung khuiah a om vaengah Mueihla Cim neh baetawt ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel ca rhoek te a Boeipa Pathen taengla muep a mael puei ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih tah a hmaiah Elijah kah mueihla neh thaomnah dongah lamhma ni. Pa rhoek kah thinko te ca rhoek taengla, lokhak rhoek te aka dueng lungcueinah dongla mael ni. Rhoekbah tangtae pilnam tah Boeipa ham a hmoel ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah Zekhariah loh puencawn taengah, “Hekah he Ba nen lae ka ming eh? Kai tah patong la ka om coeng tih ka yuu khaw a kum te ham coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah puencawn loh anih te a doo tih, “Kai tah Pathen hmaiah aka pai Gabriel ni, nang taengah he rhoek he phong ham neh thui ham n'tueih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae kai ol te na tangnah pawt dongah he he a soep nah khohnin duela olmueh la na om vetih na cal thai mahpawh ne. Amah tue ah ka ol te soep bit ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah Zekhariah te aka lamso pilnam a om dongah bawkim khuiah a di te a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ha thoeng vaengah tah amih te voek thai voel pawh. Te dongah bawkim khuiah a mangthui a hmuh coeng tila a ming uh. Te dongah Zekhriah loh amih taengah a lu a thuk tih olmueh la phat om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amah kah thothueng khohnin te a cup la a om phoeiah tah amah im la cet.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te khohnin phoeiah a yuu Elizabeth te vawn tih amah khaw hla nga thuh uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Boeipa loh kai ham hnin at neh a saii tangloeng coeng, te nen ni hlang lakliah kai dogkah hnaelnah te khoe hamla n'hip,” a ti.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hla rhuk dongah Pathen taeng lamkah puencawn Gabriel te Galilee khopuei, a ming ah Nazareth la a tueih.
  </para>
  <para style="p">
    <verse number="27" style="v" />David imkhui kah hlang pakhat, a ming ah Joseph ham te oila a bae pah. Oila ming tah Mary ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah huta taengla kun tih, “A lungvat tangtae aw, omngaih lah, Boeipa tah nang taengah om pai,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Mary te tekah olka dongah konglong ngaihit la om tih te toidalnah loh metla a om eh tila a poek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Puencawn loh anih te, “Mary rhih boeh, Pathen taengkah lungvatnah na dang coeng te.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah bungvawn neh na yom tih capa na cun vaengah a ming te Jesuh sui ne.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anih tah tanglue la om vetih Khohni capa tila a khue ni. Boeipa Pathen loh anih te a napa David kah ngolkhoel te a paek ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jakob im ah kumhal due manghai pawn ni. A ram te khaw bawt ti om mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah Mary loh puencawn taengah, “Hekah he metlam a om eh? tongpa khaw ka ming moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah anih te puencawn loh a doo tih, “Mueihla Cim loh nang n'thoeng thil vetih, Khohni kah thaomnah te nang m'muek sak ni. Te dongah na cun te aka cim Pathen Capa tila a khue bal ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah namah huiko Elizabeth te a patong soiah, camoe a yom van coeng ke. Te dongah cakol la a khue te tahae ah hla rhuk lo coeng.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pathen kah olka boeih long tah a tloel nah moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te dongah Mary loh, “Boeipa kah salnu he, na olka bangla kai taengah om saeh,” a ti nah. Te phoeiah puencawn tah anih taeng lamloh nong.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mary tah tekah khohnin ah thoo tih tlang kah Judah kho ah thahluenah neh cet.
  </para>
  <para style="p">
    <verse number="40" style="v" />Zekhariah im khuiah kun tih Elizabeth te a voek.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mary kah toidalnah te Elizabeth loh a yaak vaengah a bung khuikah cahni te soipet tih Elizabeth khaw Mueihla Cim neh baetawt.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te vaengah tamlung neh pang khungdaeng tih, “Nang tah huta rhoek lakliah na yoethen coeng tih, nang bung kah a thaih te a yoethen coeng.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kai aih he metlam nim, ka boeipa kah a manu kai taengla ha pawk tarha he?
  </para>
  <para style="p">
    <verse number="44" style="v" />Nang kah toidalnah ol te ka hna khuiah a kun vaengah tah, ka bung khuikah cahni loh kohoenah neh soipet he.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te dongah Boeipa loh a thui te hmakhahnah om ni tila aka tangnah tah a yoethen,” a ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mary long khaw, “Boeipa te ka hinglu loh a oep.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ka mueihla tah ka khangkung Pathen dongah hlampan coeng.
  </para>
  <para style="p">
    <verse number="48" style="v" />A salnu mathoe he a paelki thil coeng dongah tahae lamkah tah cadil boeih loh kai ng'uem uh pawn ni.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kai taengah thaom tloe la a saii dongah, a ming tah cim pai saeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />A rhennah tah amah aka rhih rhoek kah cadil cahma ham ni.
  </para>
  <para style="p">
    <verse number="51" style="v" />A ban neh a thaomnah a saii, a thinko kopoek ah buhueng aka pom te a taekyak.
  </para>
  <para style="p">
    <verse number="52" style="v" />Mangpa rhoek a ngolkhoel lamloh a hlak tih, tlayae rhoek te a pomsang.
  </para>
  <para style="p">
    <verse number="53" style="v" />Bungpong rhoek te hno then neh a hah sak tih, khuehtawn rhoek a tlongtlai la a tueih.
  </para>
  <para style="p">
    <verse number="54" style="v" />Boeipa loh a rhennah te anih taengah a khueh tih, a oep te a huiko neh imben loh a yaak vaengah anih te a omngaih puei uh.
  </para>
  <para style="p">
    <verse number="55" style="v" />A pa rhoek taengah a thui bangla, Abraham neh a tiingan taengah kumhal duela a khueh,” a ti.
  </para>
  <para style="p">
    <verse number="56" style="v" />Mary te Elizabeth neh hla thum tluk hmaih a naeh phoeiah amah im la bal.
  </para>
  <para style="p">
    <verse number="57" style="v" />Elizabeth te a om tue a pha coeng tih capa a cun.
  </para>
  <para style="p">
    <verse number="58" style="v" />Boeipa loh a rhennah te anih taengah a khueh tih, a oep te a huiko neh imben loh a yaak vaengah anih te a omngaih puei uh.
  </para>
  <para style="p">
    <verse number="59" style="v" />Khohnin hnin rhet a lo vaengah camoe te yahvinrhet ham cet uh. Te vaengah anih te a napa ming Zekhariah la a khue uh.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tedae a manu loh a doo tih, “Moenih, Johan la a khue ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="61" style="v" />Te vaengah anih taengah, “Hekah ming la a khue te na cako khuiah a om pawt ah,” a ti na uh.
  </para>
  <para style="p">
    <verse number="62" style="v" />Camoe metla khue a ngaih poek tila a napa te a yavaih uh.
  </para>
  <para style="p">
    <verse number="63" style="v" />Te vaengah cabael a hoe tih a daek hatah, “A ming tah Johan ni,” a ti tih boeih a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Te vaengah a hmui, a lai te khaw pahoi a khui pah dongah cal tih Pathen te a uem.
  </para>
  <para style="p">
    <verse number="65" style="v" />Te vaengah amih tolvael rhoek boeih te rhihnah loh a pai thil. Te dongah hekah olka loh Judah tlang tom te boeih a ngae uh.
  </para>
  <para style="p">
    <verse number="66" style="v" />Aka ya boeih loh a thinko khuiah a dueh uh tih, “Hekah camoe he metlam nim a om ve?” a ti uh. Tedae Boeipa kah kut loh anih te a om puei.
  </para>
  <para style="p">
    <verse number="67" style="v" />A napa Zekhariah tah Mueihla Cim neh a baetawt.
  </para>
  <para style="p">
    <verse number="68" style="v" />Te dongah a olphong neh, “A pilnam te a hip tih tlannah a saii dongah, Israel Pathen Boeipa tah uemom pai saeh.
  </para>
  <para style="p">
    <verse number="69" style="v" />A taengom David im khuiah mamih ham khangnah ki a thoh sak.
  </para>
  <para style="p">
    <verse number="70" style="v" />Khosuen lamloh a tonghma ciim rhoek kah ka dongah a thui vanbangla,
  </para>
  <para style="p">
    <verse number="71" style="v" />Mamih kah rhal rhoek neh mamih aka hmuhuet rhoek boeih kut lamkah khangnah,
  </para>
  <para style="p">
    <verse number="72" style="v" />a pa rhoek taengah rhennah tueng sak ham neh a paipi ciim te poek sak ham,
  </para>
  <para style="p">
    <verse number="73" style="v" />a pa Abraham taengah olhlo neh a toemngam te mamih paek ham,
  </para>
  <para style="p">
    <verse number="74" style="v" />amah taengah thothueng hamla rhal kut lamloh hoel n'hlawt coeng.
  </para>
  <para style="p">
    <verse number="75" style="v" />mamih kah khohnin rhoek boeih te amah hmaiah duengnah neh cimcaihnah ham ni.
  </para>
  <para style="p">
    <verse number="76" style="v" />Te phoeiah, camoe, nang tah Khohni tonghma la n'khue vetih a longpuei rhoekbah ham Boeipa hmaiah na lamhma ni.
  </para>
  <para style="p">
    <verse number="77" style="v" />Amih kah tholh khodawkngainah rhangneh a pilnam taengah khangnah mingnah a paek ni.
  </para>
  <para style="p">
    <verse number="78" style="v" />Mamih Pathen kah rhehnah om. Te nen te a sang lamkah khothoeng loh mamih n'hip.
  </para>
  <para style="p">
    <verse number="79" style="v" />Dueknah mueihlip neh yinnah khuiah aka ngol rhoek ham te a tue vetih, mamih kah kho te ngaimongnah longpuei la hoihaeng ham ni,” a ti.
  </para>
  <para style="p">
    <verse number="80" style="v" />Camoe tah rhoeng tih mueihla ah khaw rhaang. Te dongah Israel taengah a phoenah khohnin duela khosoek ah om.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />A khohnin a pha vaengah Kaisar Augustus taengkah oltloek te lunglai pum ah a pat.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te hlangmi soepnah tah Syria Kurenius kah a taem vaengah lamhmacuek la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah hlang boeih loh minghlum ham amah kho la rhip cet uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah Joseph khaw Galilee, Nazareth kho lamloh Judea kah Bethlehem la a khue David khopuei la cet. Anih te David imkhui kah nurhui pahrhui la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Minghlum ham vaengah amah ham a bae Mary te pumrhih la om pueng.
  </para>
  <para style="p">
    <verse number="6" style="v" />A om rhoi kuelhuelh ah a caom tue loh a kae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae a capa camingomthang te a cun vaengah tah impahnah ah hmuen a om pawt dongah a yol tih khongduk dongah a soei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah amah tekah pingpang ah tudawn rhoek om uh. A tuping te khoyin ah thongim la a khoem uh tih a rhaeh thil uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah Boeipa kah puencawn tah amih taengah a phoe pah. Amih te Boeipa kah thangpomnah loh a tue dongah rhihnah neh bahoeng a rhih uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae amih te puencawn loh, “Rhih uh boeh, pilnam boeih taengah aka om ham omngaihnah tanglue te nangmih taengah olthangthen kan thui he.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tihnin ah nangmih ham khangkung om coeng. Anih tah David khopuei ah Khrih Boeipa la om coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmih ham miknoek pakhat om vetih, cahni te a yol phoeiah kongduk dongah a yalh te na hmuh uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah puencawn te vaan caempuei rhaengpuei loh tarha a om puei tih Pathen te a thangthen uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah, “Pathen te a sangkoek ah thangpomnah om saeh, diklai ah rhoepnah neh hlang rhoek soah a kolonah om saeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A om van bangla puencawn rhoek tah amih taeng lamloh vaan la cet uh. Tudawn rhoek loh khat neh khat taengah, “Bethlehem la cet pawn sih lamtah olthang aka thoeng he so uh sih. Te tah Boeipa long ni mamih ham a phoe sak,” a ti uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah, tatloe la cet uh tih Mary, Joseph neh kongduk dong ah aka yalh cahni te a hmuh uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A hmuh uh vaengah, te camoe kawng neh amih taengah a thui olka te a doek uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih taengah tudawn rhoek loh a thui te aka ya rhoek boeih tah a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Mary loh tekah olka te boeih a kuem tih a thinko ah a khing a mong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tudawn rhoek tah amih taengah a thui pah bangla boeih a hmuh uh. A yaak uh dongah te Pathen a thangpom uh tih a thangthen uh phoeiah bal uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hnin rhet cup coeng tih, camoe te yahvin a rhet vaengah tah a ming te Jesuh a sui. Te tah bung khuikah a yom hlanah puencawn kah a sui pah coeng ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Moses kah olkhueng bangla amih kah imcim khohnin te a pha vaengah Jesuh te Boeipa taengah nawn ham Jerusalem la a khuen rhoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Boeipa kah olkhueng dongah a daek bangla bung aka va tongpa boeih tah Boeipa ham cimcaih la a khue ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Boeipa kah olkhueng dongah, “Vahu phiknit mai khaw, vahui ca panit mai khaw,” a ti bangla hmueih te a paek rhoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah hlang pakhat, a ming ah Simeon te Jerusalem ah khoem om. Tekah hlang tah dueng tih cuep. Te dongah Israel kah thaphohnah te a lamtawn tih Mueihla Cim loh anih a om thil.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mueihla Cim loh anih taengah, “Boeipa kah Khrih te a hmuh hlan atah dueknah na hmu mahpawh, “tila a mangthui tangtae te om.
  </para>
  <para style="p">
    <verse number="27" style="v" />Simeon te mueihla loh bawkim khuila a pawk puei. Te vaengah camoe Jesuh amah te olkhueng kah khosing la saii ham a manu pana loh a khuen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah Simeon loh a kut dongah a doe tih Pathen te a uem.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah, “Boeikung na sal he na olthui bangla ngaimongnah neh nan hlah coeng.
  </para>
  <para style="p">
    <verse number="30" style="v" />Namah kah khangnah te ka mik loh a hmuh coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te ni pilnam tom kah mikhmuh ah na tawn pah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vangnah he namtom a pumphoenah la, thangpomnah te na pilnam Israel hamla om coeng,” a ti.
  </para>
  <para style="p">
    <verse number="33" style="v" />Camoe kawng a thui soah a napa neh a manu tah a ngaihmang rhoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Simeon loh amih te yoethen a paek tih a manu Mary taeng ah, “Anih he Israel khuiah a yet kah a bungnah neh thohkoepnah ham neh boekoek miknoek la a khueh coeng he.
  </para>
  <para style="p">
    <verse number="35" style="v" />Namah neh namah khaw na hinglu thunglang loh n'rhaih ni. Te daengah ni thinko kah poeknah te poeng a pumphoe eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah Asher koca kah Phanuel canu tonghmanu Anna om tih a kum khaw muep patong coeng. Anih he a hula lamloh a va neh kum rhih bueng hing rhoi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te phoeiah kum sawmrhet kum li hil nuhmai la om. Anih tah bawkim te hlah tlaih kolla khoyin khothaih yaehnah neh, rhenbihnah neh tho a thueng.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pathen uem tue a pai kuelhuelh vaengah Jerusalem kah tlannah aka lamtawn rhoek boeih ham camoe kawng te a thui pah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Boeipa kah olkhueng bangla boeih a soep vaengah te amah kho Galilee, Nazareth la bal rhoi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Camoe tah a rhoeng vaengah rhaang tih cueihnah neh bae. Pathen kah lungvatnah long khaw a om thil.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kum takuem yoom khotue ah a manu napa te Jerusalem la cet.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kum hlainit a lo vaengah khotue kah khosing bangla amih te cet uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Khohnin te cup tih a a bal uh vaengah cadong Jesuh tah Jerusalem ah uelh tih a manu napa loh ming pawh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Jesuh te lambong khuiah om tila a poek uh dae hnin at long caeh phoeiah tah a huiko neh a hmat taengah a tlap rhoi.
  </para>
  <para style="p">
    <verse number="45" style="v" />A hmuh rhoi pawt dongah anih tlap ham Jerusalem la mael rhoi.
  </para>
  <para style="p">
    <verse number="46" style="v" />A thum khohnin a pha phoeiah Jesuh te bawkim khuikah saya rhoek kah a laklung ah ana ngol, amih taengah a hnatun tih amih ana dawt te a hmuh rhoi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Anih kah yakmingnah neh ollannah boeih te aka ya rhoek boeih tah limlum uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Jesuh te a hmuh rhoi vaengah let rhoi tih a manu loh, “Ka capa, balae tih kaimih rhoi tlam he nang khueh? Na pa neh kai loh nang kan toem rhoi tih n'yuek sut coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te vaengah amih rhoi te, “Balae kai nan toem rhoi? A pa im ah ka om ham a kuek te na ming rhoi mahnim?” a ti nah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tedae amih rhoi taengah a thui pah olka te amih rhoi loh a hmuhming rhoi moenih.
  </para>
  <para style="p">
    <verse number="51" style="v" />Te phoeiah amih rhoi taengah cet tih Nazareth la pawk uh. A taengah boengai la om tih olka te a manu loh a thinko ah boeih a khoem.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jesuh tah cueihnah neh pumrho ah rhoeng tih Pathen neh hlang taengah lungvatnah a dang.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tiberius Kaisar a manghai kum hlainga vaengah Judea te Pontius Pilat loh a taem tih, Herod te Galilee ah khoboei la om. A manuca Philip tah Ituraea neh Trakhoniti kho kah khoboei la om. Lusania tah Abilene kah khoboei la om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Annas neh Kaiaphas khosoihham la a om vaengah Pathen kah ol tah khosoek kah Zekhariah capa Johan taengla thoeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Jordan pingpang te boeih a pha tih tholh khodawkngainah ham yutnah baptisma kawng a hoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tonghma Isaiah kah ol te cabu dongah ana daek sut bangla, khosoek kah pang ol loh , “Boeipa kah longpuei te rhoekbah uh lamtah, a caehlong te a dueng la saii uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Soklong te boeih a et vetih, tlang neh mol khaw boeih a tlarhoel sak ni. Aka kawn te a dueng la, long mueng khaw long tlaai la om ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah pumsa boeih loh Pathen kah khangnah a hmuh ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah anih kah a nuem hamla aka thoeng hlangping te, “Rhulthae rhoek kah cadil rhoek, kosi aka tawn uh te rhaelrham tak ham unim nangmih aka tueng?
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah yutnah neh a tiing la a thaih te saii uh. Na khuiah, 'Abraham te pa la ka khueh,’ ti koeloe boeh. Pathen tah hekah lungto lamloh Abraham ca rhoek a thoh thai te nangmih ham kan thui.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae hai tah thing yung ah oepsoeh la a khueh van coeng. Thaih tak la aka thai pawh thing tah boeih a vung tih hmai ah a pup,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah amah te hlangping loh a dawt tih, “Te koinih balae ka saii uh eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah amih te a doo tih, “Angki yungnit aka khueh loh aka khueh pawt te doedan saeh. Te vanbangla caak aka khueh long khaw saii van saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah mangmucoi rhoek khaw nuem hamla ha pawk uh tih anih taengah, “Saya, balae ka saii uh eh? “a ti uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah amih te, “Nangmih ng'uen phoeiah a yet la khoboe boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih te rhalkap rhoek long khaw a dawt uh tih, “Kaimih tah balae ka saii uh van eh?” a ti uh. Amih te khaw, “Hlang te hihham uh boeh, huttet uh boeh. Namamih kah buhcun neh rhaemhal uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilnam kah a lamso vanbangla amamih kah thinko ah Johan te boeih a thui uh tih, “Anih he Khrih coini,” a ti uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Johan loh a doo tih, “Nangmih he kai loh tui dongah kan nuem dae kai lakah aka tlung te ha pawk coeng. Anih kah khokhom rhui hlam ham pataeng aka koih la ka om moenih. Anih loh nangmih te Mueihla Cim dongah hmai neh n'nuem ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kut dongkah cangcopcung loh a cangtilhmuen a coeh vetih cang te a khai khuila a sang ni. Tedae canghi tah aka duek pawh hmai neh boeih a hoeh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah pilnam te a tloe neh muep a thaphoh tih olthangthen a phong pah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Herod a khoboei vaengah a mana yuu Herodias kawng dongah Herod loh boethae a saii boeih te Johan loh a toeltham.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te te boeih a tungsaep thil dongah Johan te thongim ah a uup.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pilnam te boeih a nuem vaengah Jesuh khaw a nuem tih a thangthui hatah vaan te ong uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah Mueihla Cim te a pumrho neh vahu kah mueimae bangla a suntlak thil. Te vaengah, “Nang tah ka capa thintlo la na om tih, nang taengah ka lungtlun,” tila vaan lamkah ol ha thoeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesuh loh amah bibi a tong vaengah a kum sawmthum tluk lo coeng. Poek vaengah Heli capa Joseph kah a ca bangla om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae Heli te Matthat capa, Matthat te Levi capa, Levi te Melkhi capa, Melkhi te Janna capa, Janna te Joseph capa,
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph te Mattathias capa, Mattathias te Amos capa, Amos te Nahum capa, Nahum te Esli capa, Esli te Naggai capa,
  </para>
  <para style="p">
    <verse number="26" style="v" />Naggai te Maath capa, Maath te Mattathias capa, Mattathias te Shimei capa, Shimei te Joseph capa, Joseph te Joda capa,
  </para>
  <para style="p">
    <verse number="27" style="v" />Joda te Joanan capa, Joanan te Rhesa capa, Rhesa te Jerubbabel capa, Zerubbabel te Shealtiel capa, Shealtiel te Neri capa,
  </para>
  <para style="p">
    <verse number="28" style="v" />Neri te Melkhi capa, Melkhi te Addi capa, Addi te Kosam capa, Kosam te Elmadam capa, Elmadam te Er capa,
  </para>
  <para style="p">
    <verse number="29" style="v" />Er te Jose capa, Jose te Eliezer capa, Eliezer te Jorim capa, Jorim te Matthat capa, Matthat te Levi capa,
  </para>
  <para style="p">
    <verse number="30" style="v" />Levi te Simeon capa, Simeon te Judah capa, Judah te Joseph capa, Joseph te Jonan te Eliakim capa,
  </para>
  <para style="p">
    <verse number="31" style="v" />Eliakim te Melea capa, Melea te Menna capa, Menna te Mattatha capa, Mattatha te Nathan capa, Nathan te David capa,
  </para>
  <para style="p">
    <verse number="32" style="v" />David te Jesse capa, Jesse te Obed capa, Obed te Boaz capa, Boaz te Sala capa, Sala bte Nashon capa,
  </para>
  <para style="p">
    <verse number="33" style="v" />Nashon te Amminadab capa, Aminadab te Admin capa, Admin te Aram capa, Aram te Hezron capa, Hezron te Perez capa, Perez te Judah capa,
  </para>
  <para style="p">
    <verse number="34" style="v" />Judah te Jakob capa, Jakob te Isaak capa, Isaak te Abraham capa, Abraham te Terah capa, Terah te Nakhaw capa,
  </para>
  <para style="p">
    <verse number="35" style="v" />Nakhaw te Saruk capa, Saruk te Rhagau capa, Rhagau te Phalek capa, Phalek te Eber capa, Eber te Shelah capa,
  </para>
  <para style="p">
    <verse number="36" style="v" />Shelah te Kainan capa, Kainan te Arpaxad capa, Arpaxad te Shem capa, Shem te Noah capa, Noah te Lamekh capa,
  </para>
  <para style="p">
    <verse number="37" style="v" />Lamekh te Methuselah capa, Mehtuselah te Enok capa, Enok te Jared capa, Jared te Maleleel capa, Maleleel te Kainan capa,
  </para>
  <para style="p">
    <verse number="38" style="v" />Kainan te Enos capa, Enos te Seth capa, Seth te Adam capa, Adam te Pathen capa la om.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh tah Jordan lamloh Mueihla Cim a baetawt la mael tih Mueihla loh khosoek la a khuen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rhaithae loh khohnin sawmli a noemcai. Tekah khohnin vaengah caak pakhat khaw a caak kolla bungpong neh a thok sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah anih te rhaithae loh, “Pathen capa la na om atah, lungto he voek lamtah buh la poeh saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah anih te Jesuh loh, “'Hlang long he buh bueng neh hing boel saeh, 'tila a daek coeng ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah anih te a khuen tih a tue kolkalh rhuet ah lunglai kah ram rhoek te boeih a tueng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah anih te rhaithae loh, “Hekah saithainah boeih neh a thangpomnah he nang kam pae eh?, kai taengah m'paek coeng dongah ka ngaih te tah ka paek mai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah, nang khaw kai taengah na bakop atah nang hamla boeih om bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae Jesuh loh anih te a doo tih, “A daek tangtae coeng ni, BOEIPA na Pathen mah bawk lamtah amah bueng mah thothueng,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah anih te Jerusalem la a khuen tih bawkim kah tlungsoi ah a pai sak. Te vaengah anih te, “Pathen capa la na om atah, he lamloh namah te cungpung thuk.
  </para>
  <para style="p">
    <verse number="10" style="v" />A daek tangtae vanbangla amah kah puencawn rhoek te nang aka khoem ham namah yueng a uen bitni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na kho te lungto dongah na tongtah ve a ti dongah nang te a kut neh n'dom uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae anih Jesuh loh a doo tih, “A thui coeng te ta, BOEIPA na Pathen te noemcai boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rhaithae loh a noemcainah te boeih a soep coeng dongah a tuetang a pha hlan duela anih taeng lamloh nong.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesuh tah Mueihla kah thaomnah neh Galilee la mael. Te vaengah anih kah olthang te te rhoek pingpang tom ah cet.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amamih kah tunim ah khaw a thuituen tih hlang boeih loh a thangpom.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah aka khut a om nah Nazareth la pawk. Tedae a sainoek bangla Sabbath hnin ah tunim khuila kun tih ca tae hamla pai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah anih te tonghma Isaiah kah cabu te a doe uh. Cabu te a hlam vaengah tekah hmuen ah a daek tangtae aka om te a hmuh;
  </para>
  <para style="p">
    <verse number="18" style="v" />BOEIPA Mueihla loh kai n'om thil tih khodaeng te olthangthen phong pah ham kai ng'koelh coeng. Hlangsol taengah khodawkngainah, mikdael taengah khoval te hoe pah ham, a haemtaek rhoek te khodawkngainah khuila tueih ham,
  </para>
  <para style="p">
    <verse number="19" style="v" />BOEIPA kah kum uem om te hoe ham kai n'tueih coeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cabu te a awn tih tueihyoeih taengla a mael phoeiah ngol. Te dongah tunim ah aka om rhoek kah a mik loh anih te boeih a hmaitang uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah amih te, “Tihnin ah olcim he nangmih hna khuiah soep coeng,” pahoi a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah anih te boeih a oep uh tih a ka lamkah aka thoeng lungvatnah olka dongah a ngaihmang uh. Te dongah, “Joseph capa moenih a he? ,” a ti uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah amih te, “Siboei la, 'Namah mah hoeih vaikhai,’ a ti, nuettahnah he kai taengah na thui uh tangkhuet. Kapernaum ah aka om te boeih ka yaak uh coeng, he khaw namah tolrhum ah saii,’ na ti uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae nangmih taengah rhep ka thui, Amah tolrhum ah a uem uh tonghma a om moenih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih te oltak ni kan thui. Elijah tue vaengah Israel khuiah nuhmai muep om. Te vaengah vaan ke kum thum hla rhuk a khaih tih, khokha loh diklai pum ah muep om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah Sidoni Zarephath kah nuhmai nu taeng pawt atah amih taengla Elijah a tueih moenih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tonghma Elisha tue vaengah Israel khuiah hmaibae muep om dae, Syria Naaman pawt atah amih a cing pah moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te rhoek te a yaak uh vaengah tunim khuikah rhoek tah a thinsanah neh boeih hah uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah thoo uh tih Jesuh te kho voel la a haek uh. Anih te tulh ham amamih kah a sak khopuei tlang kah pango la a khuen uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae amih te a laklung ah a va tih cet.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Galilee khopuei, Kapernaum la suntla thuk tih, Sabbath vaengah amih aka thuituen la pahoi om.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ol tah saithainah neh a om dongah a thuituennah te a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah rhaithae kah rhalawt mueihla aka kaem hlang te tunim khuiah om tih ol ue la pang.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Aya! Nazareth Jesuh, nang taeng neh kaimih taengah balae aka om? Kaimih aka poci sak ham nim na pawk? Nang te kan ming ta, Pathen kah hlangcim la na om ta,” a ti.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae anih te Jesuh loh a ho tih, “Paa lamtah anih lamloh cet,” a ti nah. Te dongah anih te rhaithae loh a laklung la a voeih tih a tloh kolla anih te a caeh tak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah ngaihmangnah loh boeih a thoeng thil uh. Te dongah khat neh khat te voek uh tih, “Mebang olka nim he, saithainah neh a thaomnah dongah rhalawt mueihla rhoek a tueih tih, a caeh uh mai he,” a ti uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te dongah Jesuh kah olhum tah te rhoekg pingpang kah a hmuen boeih la pawk.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tunim lamloh thoo tih Simon im la kun. Te vaengah Simon masae te satloh om tih a nan malcal. Te dongah anih kongah Jesuh te a dawt uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih te a pai thil tih tloh te a ho daengah anih te tloh loh a hlah. Te dongah pahoi thoo tih amih te a kok.
  </para>
  <para style="p">
    <verse number="40" style="v" />Khomik a tlak vaengah tlohtat cungkuem neh tattloel la aka om boeih te Jesuh taengla a khuen uh. Amih pakhat rhip te kut a tloeng thil tih amih te a hoeih sak.
  </para>
  <para style="p">
    <verse number="41" style="v" />A yet taeng lamkah rhaithae rhoek khaw nong uh. Te phoeiah pang uh tih, “Nang tah Pathen capa ni,” a ti nah. Anih te Khrih ni tila a ming uh dongah amih te a ho tih thui sak voel pawh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Khothaih a pha vaengah khoe uh tih khosoek hmuen te a paan. Tedae hlangping loh anih te a toem uh tih anih te a paan uh. Te phoeiah amih taeng lamkah a nong pawt ham Jesuh te a tuuk uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tedae amih te, “Pathen kah ram te kho tloe rhoek taengah khaw ka thui ham a kuek dongah ni n'tueih,” a ti nah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te dongah Judea ah om tih tunim ah olthangthen a hoe.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />A om rhuet vaengah anih te hlangping loh a et tih Pathen kah olka a hnatun uh. Te vaengah anih tah Gennesaret tuili taengah om tih pai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah tuili kah aka pai lawng panit te a hmuh. Tedae te lamkah tuihoi rhoek tah lawk suk la khoe uh coeng. Te phoeiah ngol tih lawng dong lamkah loh hlangping te a thuituen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah lawng pakhat khuila kun. Te tah Simon kah la a om dongah, “Lan lamkah bet thoeih dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />A thui a bawt van neh Simon te, “A dung la thoeih lamtah nga tuuknah ham na lawk te voei lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae Simon loh a doo tih, “Boeipa, khoyin khing ah ka thakthae uh tih ka dang uh moenih. Tedae namah ol dongah lawk te ka voei eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A saii uh tangloeng vaengah nga hol te muep a kol uh tih a lawk khaw a va pah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah lawng tloe dongkah a pueipo rhoek te a cavaih uh tih amih talong ham ha pawk uh. Tedae ha pawk uh vaengah lawng rhoi te bae coeng tih dalh buek uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Simon Peter loh a hmuh vaengah Jesuh te khuklu a bakop thil tih, “Kai taeng lamloh nong laeh, kai he hlang tholh ni BOEIPA,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />A tuuk uh bangla a nga tuknah soah amah neh a taengkah rhoek boeih te ngaihmangnah loh a tuuk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simon kah a pueipo la aka om Zebedee ca rhoi James neh Johan khaw a ngaihmang rhoi van. Te phoeiah Simon te Jesuh loh, “Rhih boeh tahae lamkah tah hlang aka tu la na om pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lawng rhoek te lan la a thak phoeiah boeih a toeng uh tih Jesuh te a vai uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kho pakhat ah a om vaengah hlang pakhat tah hmaibae hoeng la tarha om. Jesuh te a hmuh vaengah a hmai long bakop. Te vaengah, “BOEIPA na ngaih atah kai nan cim sak thai,” a ti nah tih a bih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih te kut a yueng doela a taek tih, “Ka ngaih ta, cim saeh,” a ti nah. Te dongah anih te hmaibae loh pahoi a nong tak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae anih te Jesuh loh , “Thui boeh ne, tedae cet lamtah namah te khosoih taengah moe pah, na cimcaihnah dongah Moses loh ng'uen bangla nawn lamtah amih taengah laipai la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae anih kah olthang tah a nah la cet. Te dongah a ol hnatun ham neh amih vawtthoek rhoek te hoeih sak ham hlangping loh muep tingtun uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Jesuh amah tah khosoek la vi uh tih thangthui.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hnin at om tih Jesuh loh a thuituen vaengah, Galilee vangca boeih neh Judea, Jerusalem lamkah aka pawk Pharisee rhoek neh saya rhoek khaw om uh tih ngol uh. Te vaengah a hoeih ham khaw BOEIPA kah a thaomnah loh om ngawn coeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khawn tih aka om sut hlang te hlang rhoek loh phak dongah tarha hang khuen uh. Te phoeiah a taengla a khuen tih tloeng pah ham Jesuh a toem uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae hlangping laklo ah metla anih khuen ham khaw hmu uh thai pawh. Imphu la yoeng uh bangyai longah a laklung kah Jesuh hmaiah thingkongca neh a hlak uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amih kah tangnah te a hmuh vaengah, “Hlang pa aw, na tholhnah loh nang n'hlah coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae cadaek rhoek neh Pharisee rhoek long tah dawtlet ham a tong uh tih, “Soehsalnah aka thui te unim ca he? Pathen bueng pawt atah tholh hlah ham ulae aka coeng thai eh?” a ti uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae amih kah poeknah te Jesuh loh a ming dongah amih te a doo tih, “Nangmih thinko khuiah balae na poek uh?
  </para>
  <para style="p">
    <verse number="23" style="v" />'Na tholh loh nang n'hlah coeng, 'ti ham neh 'Thoo lamtah cet, 'ti ham te melae a phoeng la aka om?
  </para>
  <para style="p">
    <verse number="24" style="v" />Te daengah ni hlang capa loh diklai dongah tholh hlah hamla saithainah a khueh te na ming uh eh,” a ti nah. Aka khawn te khaw, “Namah khaw kan thui eh?, thoo, na thingkongca te khuen lamtah namah im la cet laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah amih hmaiah hlat thoo tih, a yalh nah te a khuen tih, Pathen a thangpom doela a im te a paan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah mueimang bangla boeih om uh tih Pathen te a thangpom uh. Rhihnah nen khaw baetawt uh tih, “Tihnin ah poektloel la m'hmuh,” a ti uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoei lamkah loh a caeh vaengah a ming ah Levi, mangmu aka coi tah mangmu doenah ah a ngol te a hmuh tih, “Kai m'vai laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah a cungkuem te a hnoo phoeiah thoo tih Jesuh te a vai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah Levi loh amah im ah Jesuh ham buhloei muep a tael pah. Te vaengah mangmucoi rhoek khaw hlangping la muep om tih amih taengkah aka om hlang tloe rhoek long khaw a vael uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah Pharisee rhoek neh cadaek rhoek loh Jesuh kah hnukbang rhoek te a kohuet thil uh tih, “Balae tih mangmucoi rhoek neh hlangtholh rhoek taengah na caak na ok uh?” a ti na uh .
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesuh loh amih te a doo tih, “Siboei he sading rhoek loh ngoe pawt cakhaw tloh aka khueh rhoek long tah a ngoe.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aka dueng rhoek khue ham pawt tih aka tholh rhoek te yutnah dongla khue ham ni ka pawk,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te rhoek loh Jesuh te, “Johan kah hnukbang rhoek tah puet a yaeh uh tih rhenbihnah khaw a saii uh. Pharisee rhoek kah hnukbang rhoek long khaw a saii uh van. Nangmih tah na caak na ok uh,” a ti na uh .
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae Jesuh loh amih te, “Yulueihmuen kah pacaboeina la na om uh moenih a? Amih neh a om rhuet ah yulokung loh a yaeh ham na saii uh aya?
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae a tue ha pawk bitni, yulokung te amih taeng lamkah loh a khue khohnin ah a yaeh uh bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah amih te nuettahnah neh, “Himbai a thai te a himbai pen la a phen tih himbai rhuem a bo thil moenih. Te pawt koinih, a thai khaw pawn vetih himpai pen a thai te a rhuem neh rhoep mahpawh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Misur noe te tuitang rhuem dongah a than moenih, te pawt koinih, misur noe loh tuitang te a va vetih, misur khaw cae ni, tuitang khaw poci ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae misur noe te tuitang thai dongah ni a than.
  </para>
  <para style="p">
    <verse number="39" style="v" />A rhuem aka o loh misur noe a ngaih moenih. 'A rhuem tah kodam la om,’ a ti,” a ti nah.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath a om vaengah Jesuh te canghli longah pah phai. Te vaengah a hnukbang rhoek loh cangvuei te a yun uh tih a kut neh a noi uh phoeiah a caak uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah Pharisee rhoek khuikah hlangvang loh , “Sabbath vaengah a ngaih pawt te balae tih, na saii uh?” a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Jesuh loh amih te a doo tih, “Amah neh a taengkah rhoek te bungpong la a om vaengah David loh a saii te na tae uh mahnim he.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathen im ah kun tih a hmai kah vaidam te a loh tih a caak phoeiah a taengkah rhoek khaw a paek ta, te te khosoih rhoek bueng pawt atah u khaw cah ham a paek moenih ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah amih te, “Hlang Capa tah Sabbath Boeipa ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tloe vaengah khaw Sabbath a om nen tah tunim la cet tih a thuituen. Te vaengah bantang kut aka khaem hlang pakhat om van.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah anih te Sabbath vaengah a hoeih sak atah a paelnaeh thil te hmuh hamla cadaek rhoek neh Pharisee rhoek loh a dawn uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae amih kah poeknah te a ming dongah, kut khaem la aka om hlang te, “Thoo lamtah a laklung ah pai lah,” a ti nah vanbangla thoo tih pai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah amih te Jesuh loh, “Nangmih te kan dawt lah eh, Sabbath vaengah a then ham neh thae ham, hinglu khang ham neh poci sak ham, melae a ngaih?” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah amih te boeih a sawt tih, “Na kut te yueng,” a ti nah. Tedae anih long khaw a ngai van dongah a kut te a then pah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amih a anglat neh hah uh sumsoek tih, Jesuh te saii hamla amamih khat neh khat te thui uh thae.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tue a pha vaengah thangthui ham tlang la cet tih, Pathen taengah thangthuinah neh hak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khothaih a pha vaengah tah a hnukbang rhoek te a khue. Amih lamkah hlang hlainit te a tuek tih, amih te caeltueih rhoekla a khue bal.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah Peter la a khue Simon te khaw, a mana Andrew khaw, James neh Johan khaw, Philip neh Bartholomew khaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />Matthai neh Thomas khaw, Alphaeus capa James neh Namlung la a khue Simon khaw,
  </para>
  <para style="p">
    <verse number="16" style="v" />James capa Judah neh hlangyoi la aka om Judah Iskariot khaw thum van.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah amih te a suntlak puei tih hmuen naep ah pai uh. A hnukbang rhoek te muep hlangping uh tih, Judah pum neh Jerusalem, Tyre neh Sidon tuikaeng lamkah pilnam rhaengpuei khaw muep omuh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih tah a taengah hnatun ham neh, a tlohtat lamloh hoeih hamla, rhalawt mueihla loh a tulnoi rhoek hoeih ham ha pawk uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesuh lamkah thaomnah a coe vaengah tah boeih a hoeih uh dongah anih aka taek ham hlangping loh boeih a toem uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah a hnukbang rhoek te Jesuh loh a mik a huel thil, “Khodaeng rhoek tah a yoethen pai, Pathen ram tah nangmih kah ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />A yoe aka then rhoek tah tahae ah na bungpong cakhaw na hah uh ni, yoethen hlang rhoek tah tahae ah na rhap uh cakhaw na nuei uh bitni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmih te hlang loh m'hmuhuet uh vaengah, nangmih te n'hlaang uh tih n'thuithet uh vaengah khaw, hlang capa kongah a thae la na ming a voeih vaengah khaw na yoethen uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tekah khohnin ah omngaih uh lamtah soipetuh. Nangmih kah thapang tah vaan ah muep om coeng ke. Amah te tlam ni a napa rhoek loh tonghma rhoek te a saii uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae anunae nangmih kuirhang rhoek aih, namamih kah thaphohnah ni na bawt uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anunae nangmih aka hah coeng rhoek khaw na pong uh ni. Anunae aka nuei coeng rhoek, na nguek neh na rhap uh ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anunae hlang tom loh a then la nangmih n'thui uh vaengkah aih. Amah te tlam ni na pa rhoek loh laithae tonghma rhoek te a saii uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae ka ol aka hnatun nangmih rhoek taengah kan thui, na rhal rhoek te lungnah uh, nangmih aka hmuhuet rhoek ham a then saii pa uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih thae aka phoei rhoek te uem uh, nangmih aka hnaep rhoek ham thangthui pa uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kamrhuh ah nangmih aka bop tah pakhat te khaw duen pah. Na himbai aka khuen te angki khaw hloh pah boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na taengah aka bih boeih te pae lamtah, na koe a khuen te khaw lat voel boeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hlang loh nangmih taengah a saii ham na ngaih uh bangla amih taengah saii uh van.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangmih aka lungnah rhoek bueng te na lungnah uh koinih nangmih ham mebang lungvatnah lae a om eh? hlangtholh rhoek long pataeng amamih aka lungnah rhoek a lungnah uh ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangmih ham aka then rhoek taengah dawk na then van koinih nangmih ham mebang lungvatnah lae a om eh? Amah te bang te hlangtholh rhoek long khaw a saii uh ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />A taeng lamkah dang hamla na ngaiuep uh te na puu uh koinih nangmih ham mebang lungvatnah lae a om eh? Te tlam te dang boeiloeih ham ngawn tah hlangtholh rhoek loh hlangtholh roek te a puu uh van ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na rhal rhoek taengah pataeng lungnah neh then pa uh lamtah na puu vaengah khaw lamtawn uh voel boeh. Te daengah ni nangmih kah thapang tah muep om vetih Khohni ca rhoek la na om uh eh. Amah tah noihhai neh boethae taengah khaw kodam la om ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Na pa te sitlohthamla la a om van dongah silohthamlam la om uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hlang te lai na thui thil uh pawt daengah ni lai la n'thui uh loengloeng pawt eh. Hlang te boe sak uh boeh nangmih m'boe sak uh loengloeng mahpawh. Tholh te hlah pa uh lamtah nangmih khaw han hlah van ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pae uh, lamtah nangmih te m'paek van ni. Cangnoek then dongah a det tih a rhueng tangtae te na rhang ah a baecoih la m'paek bitni. Na loeng nah cangnoek nen te nangmih ham a loeng van ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te phoeiah amih ham nuettahnah pakhat koep a thui. “Mikdael loh mikdael long a tueng thai khaming? Rhom la bok cungku mahpawt nim?
  </para>
  <para style="p">
    <verse number="40" style="v" />Hnukbang tah saya soah a om moenih. Boeih aka moeh uh pataeng a saya banglam ni a om eh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Na manuca mik kah mikdaeng te metlam na hmuhuh. Namah mik khuikah thingboeng pataeng na hmat moenih.
  </para>
  <para style="p">
    <verse number="42" style="v" />Metlam lae na manuca te, “Manuca, na mik khuikah mikdaeng kang koeih eh, “na ti nah thai. Na mik khuikah thingboeng te namah loh na hmuh moenih. Hlangthai palat aw namah mik lamkah thingboeng te koeih lamhma dae, te daengah ni na manuca mik khuikah mikdaeng na koeih ham khaw phaeng na hmuh eh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Thaih huk la aka cuen thing then he a om moenih, thaih tak la aka cuen thing thae khaw a om van moenih.
  </para>
  <para style="p">
    <verse number="44" style="v" />Thingkung boeih he a thaih long ni a mingpha sak eh. Hlingkung lamkah loh thaibu thaih a bit uh moenih. Tangpuem dongah misur a yoep uh moenih.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hlang then long tah thinko khui lamkah khohrhang then te hnothen la a thoeng sak tih, hlang thae loh boethae dong lamkah loh hnothae te a thoeng sak. Thinko kah aka baecoih te ni a ka loh a thui.
  </para>
  <para style="p">
    <verse number="46" style="v" />Balae tih kai he BOEIPA, BOEIPA tila nang khueuh. Ka thui te na saii uh hae moenih.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kai taengla aka pawk tih ka ol a yaak neh aka saii boeih tah u bangla a om khaw nangmih kan tueng eh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Anih tah im aka sa hlang phek la om. Anih tah a to khaw dung tih lungpang soah khoengim a khueh. Tuili om tih tuiva loh tekah im te a daeng. Tedae a then la a sak dongah a hinghuen thai moenih.
  </para>
  <para style="p">
    <verse number="49" style="v" />A yaak tih aka saii pawt rhoek tah khoengim om kolla diklai sokah im aka sa hlang bangla om tih tuiva loh a daeng vaengah pahoi tim van. Te dongah im kah a po a ci khaw muep om.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />A ol te pilnam kah a hna ah boeih a baetawt sak phoeiah tah Kapernaum la kun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah rhalboei kah sal pakhat te tloh a khueh tih dalh duek. Anih tah a taengah a khoelh la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kawng a yaak coeng dongah Judah patong rhoek te Jesuh taengla a tueih tih a sal hoeih sak ham halo dae saeh tila a cael.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te rhoek loh Jesuh te a paan uh phoeiah ngahngah a cael uh tih, “Anih te doedan tueng la om he,
  </para>
  <para style="p">
    <verse number="5" style="v" />mah namtu a lungnah dongah tunim te khaw anih long ni mamih ham a sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah amih te Jesuh loh a caeh puei tih im pha ham pataeng hla voel pawh. Te vaengah rhalboei loh a puei rhoek te a tueih tih, “Boeipa, na tawnba mai pawt nim? Ka imphu ah na kun ham khaw a koihvaih la ka om moenih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Namah te kam paan ham khaw ka tueng moenih. Tedae ol kamat mah thui lamtah ka sal he hoeih bitni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai khaw saithainah aka khueh hmuikah aka om hlang pakhat van ni. Kamah hmuiah rhalkap rhoek khaw om van. Te dongah pakhat te “Cet” ka ti nah tih cet, pakhat te, “Ha lo lah,” ka ti nah tih ha lo mai. Te dongah tahae kah bangla na saii pah vetih ka sal te a saii mako,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te te Jesuh loh a yaak vaengah a ngaihmang. Te dongah anih aka vai hlangping te a mael thil tih, “Nangmih taengah ka thui, Israel khuiah pataeng tangnah heyet ka hmuh moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tueih rhoek te im la a bal uh vaengah rhalboei kah a sal te sading la a hmuh uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A vuen a pha neh Nain la a khue kho pakhat la cet. Te vaengah anih te a hnukbang rhoek neh hlangping loh muep a puei uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khopuei vongka neh a yoei vaengah manu pakhat tah capa khueh duen te a duek pah tih tarha hang khuen. Anih te nuhmai la om dae, khopuei kah hlangping loh anih taengah muep omuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih te a hmuh vaengah Boeipa loh anih soah a thinphat tih, “Rhap boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />A paan tih rhoep te a taek vaengah aka kawt rhoek loh cawt a pai puei uh. Te phoeiah, “Cadong namah, thoo laeh ka ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah aka duek te ngol tih pahoi cal. Te phoeiah anih te a manu taengla a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah rhihnah loh boeih a thing uh. Te dongah, “Mamih taengah tonghma puei ha thoeng coeng, Pathen loh a pilnam a hip,” a ti uh tih Pathen a thangpom uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Jesuh kah ol loh Judah pum neh te rhoek pingpang boeih a pha.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te rhoek boeih te a hnukbang rhoek loh Johan taengla a puen pauh. Te dongah Johan loh a hnukbang rhoek khuikah panit te a khue.
  </para>
  <para style="p">
    <verse number="19" style="v" />Boeipa taengla a tueih tih, “Aka pawk la na om coeng atah a tloe ka lamso pueng aya?” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tekah hlang rhoi loh Jesuh te a paan rhoi tih, “Tuinuem Johan loh nang taengla kaimih rhoi n'tueih tih, 'Aka pawk la na om atah a tloe ka lamso aya?' a ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaeng tue ah tlohtat khaw, nganboh khaw, mueihla thae muep a hoeih sak. Mikdael rhoek khaw muep a hmuh sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah amih te a doo tih, “Cet uh lamtah na hmuh neh na yaak te Johan taengla puen pah. Mikdael loh a hmuh coeng, aka khawn loh pongpa coeng, hmaibae khaw cing tih hnapang loh a yaak, aka duek rhoek khaw thoo uh coeng, khodaeng loh olthangthen a yaak coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae kai kongah a khah pawt te tah yoethen la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Johan kah puencawn rhoi te a caeh phoeiah Johan kawng neh hlangping te, “Khosoek la na caeh uh vaengah balae na hmuh uh? Khohli kah a hinghuen capu a?
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae himbai hnal neh aka phuekhlak uh hlang te hmuh ham nim na caeh uh? Rhuepom pueinak neh pumdomnah dongah kho aka sa rhoek tah manghai-im ah om uh lah ko ke.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae na caeh uh te balae na hmuh uh? Tonghma a? Ue ta, nangmih taengah tonghma lakah khaw olpuei ka ti rhoe ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />A kawng la a daek pah te anih ni. Ka puencawn te Nang hmai ah kan tueih. Anih long ni nang hmaikah na longpuei te a rhoekbah eh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih taengah kan thui, huta kah a cun rhoek khuiah Johan lakah aka tanglue a om moenih. Tedae Pathen ram khuiah a yit koek long pataeng anih lakah tanglue la om,” pahoi a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aka ya pilnam boeih neh mangmucoi rhoek long tah Pathen te a tang sak uh tih Johan kah baptisma neh nuem uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae Pharisee rhoek neh olming rhoek long tah Pathen kah mangtaengnah te amamih ham a aal uh dongah Johan lamloh nuem uh pawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah tahae cadil hlang rhoek ba nen nim ka thuidoek lah vetih unim phek a loh uh he?
  </para>
  <para style="p">
    <verse number="32" style="v" />Hnoyoih hmuen ah ngoluh tih khat neh khat aka khue uh thae camoe rhoek phek a lohuh. Amih loh, “Nangmih ham phavi kan tum uh dae na lam uh pawh. Kan hlai uh akhaw na rhap uh pawh ,” a ti uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuinuem Johan ha pawk tih buh ca pawh, misur khaw a ok pawt hatah, 'Rhaithae a khueh,’ na ti uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hlang capa loh ha pawk tih a caak, a ok hatah, 'hlang khaw carhut neh yumi la he, mangmu aka coi neh hlangtholh rhoek kah a paya ni,' na ti uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae cueihnah loh a ca rhoek te boeih a tang sak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pharisee pakhat loh Jesuh te amah taengah buh ca la a cael. Te dongah Pharisee im la kun tih a vael van.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pharisee im ah buh a vael te kho ah aka om hlangtholh nu loh lawt a ming.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te dongah botui te lungbok um dongah a khuen tih a rhah doela Jesuh kho tang ah pai. Te phoeiah Jesuh kho te mikphi neh koe a sul tih a lu sam neh a huih pah. A kho te a mok pah tih botui neh a hluk pah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih aka khue Pharisee loh a hmuh vaengah a khuiah a toel tih, “Anih he tonghma la om koinih amah aka taek huta te, unim?, mebangnim? ti khaw a ming ni ta, hlangtholh dae ni ke,” a ti.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah Jesuh loh anih te a doo tih, “Simon, nang taengah thui ham bet ka khueh,” a ti nah. Anih long khaw, “Thui lah saw saya,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Puhlah pakhat taengah purhong panit om tih, pakhat loh denari yanga, pakhat loh sawmnga a ba.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tedae a thuung nah a khueh rhoi pawt dongah vik a yoe sak. Te vaengah amih rhoi khuiah ulae puhlah a lungnah ngai eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Simon loh a doo tih, “A yet a yoe sak te ka ti,” a ti nah. Te dongah anih te Jesuh loh, “Buelh na naai het coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te phoeiah huta taengla mael tih Simon te, “Huta he na hmuh a? Nang im khuila ka kun dae, kai he kho silh tui nan paek moenih. Anih long tah kai kho he mikphi neh a sul tih a sam neh a huih.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kai taengah moknah khaw nang khueh pawh, anih long tah ka kun parhi te kai kho a mok he toeng voel pawh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ka lu he situi nan hluk pawh, anih long tah ka kho he botui neh a hluk.
  </para>
  <para style="p">
    <verse number="47" style="v" />Te dongah ni namah taengah kan thui, anih tah tholh a yet loh a hlah coeng dongah muep a lungnah. Tedae a yool a hlah pah long te tah a yool ni a lungnah,” a ti nah.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te phoeiah huta te khaw, “Na tholhnah loh n'hlah coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te vaengah aka vael rhoek loh amamih khuiah, “Tholh aka hlah pah te ulae aka om he,” pahoi a ti uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huta te khaw, “Na tangnah loh nang ng'khang coeng, ngaimong la cet laeh,” a ti nah.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te a poeng phoeiah amah loh khopuei boeih neh vangca patoeng a hil. Te vaengah Pathen ram te a hoe tih a olthangthen a thui. A hnukbang hlainit loh anih te a pueiuh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mueihla thae, vawtthoeknah lamkah aka hoeih tangtae la aka om huta hlangvang rhoek, a khui lamkah rhaithae parhih loh a nong tak Magdala la a khue Mary,
  </para>
  <para style="p">
    <verse number="3" style="v" />Herod buhtaem Chuza yuu Joanna, Susanna neh a tloe rhoek khaw muep lo uh tih amih loh Jesuh khaw a hnukbang rhoek te khaw a khuehtawn neh a bongyong uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khopuei takuem kah hlangping te muep capit uh tih a taengla ha pawk uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah nuettahnah neh, “Cangti aka tuh tah a cangtii tuh hamla cet. Tedae a tuh vaengah a ngen tah long taengah tla. Te dongah a taelh uh tih vaan kah vaa loh a kueh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tloe rhoek tah lungpang soah tla dae, laiyuem a om pawt dongah a poe neh pahoi koh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A tloe rhoek tah hling puem ah tla tih, a rhoeng vaengah hling loh a thing.
  </para>
  <para style="p">
    <verse number="8" style="v" />A tloe te lai then dongah tla tih, a poe vaengah a vuei yakhat lam khaw thoeng,” a ti. Te phoeiah te, “Yaak nah hna aka khueh loh ya saeh,” a ti nah tih a doek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah nuettahnah loh metla a om te a hnukbang rhoek loh amah a dawt uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah, “Pathen ram kah olhuep he ming hamla nangmih m'paek coeng. Te phoeiah a hmuh uh vaengah a hmat uh pawt ham, a yaak uh dae a hmuhming uh pawt ham ni nuettahnah neh ka hlihloeh sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nuettahnah tah he tlam ni a om. Cangtii tah Pathen kah olka ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />A yaak uh vaengah amih a khang ham te tangnah boel saeh tila, rhaithae te ha pawk tih a thinko kah olka a rhawt pah rhoek tah, long taengkah rhoek la om uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungpang sokah rhoek te tah olka te a yaak uh vaengah omngaihnah neh a doeuh. Tedae te rhoek te a yung om pawh. Amih loh a tue kolkalh ham a tangnah uh tih noemcainah tue vaengah tah nong uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hling puem kah aka tla rhoek, amih khaw aka ya tangtae rhoek ni. Tedae a pongpa vaengah mawntangnah, khuehtawn neh khosaknah omthenbawn loh a thing tih tak pawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lai then dongkah rhoek, amih rhoek tah thinko then neh a then la aka om rhoek ni. Te dongah ol a yaak uh te a dueh uh tih uehnah neh thaihtak uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmaiim a tok te hnopai neh aka dah, thingkong hmuiah aka det he a om moenih. Tedae aka kun rhoek te vangnah hmuh sak ham hmaitung soah ni a khueh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A huephael la aka om te mingpha la a om mueh moenih. A huep te khaw mingpha mueh pawt tih mingpha la a pawk mueh moenih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah metla na yaak uh khaw hmuminguh. Aka khueh te tah a a taengla a paek ni. Tedae aka khueh pawt te tah a taengah a khueh la a ngai te khaw a loh pah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesuh te a manu neh a mana rhoek loh a paan. Tedae hlangping dongah anih te hum uh thai pawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah amah te, “Na nu neh na mana rhoek loh nang hmuh ham la a ngaih uh tih poeng ah pai uh ,” tila a puen pah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae Jesuh loh amih te a doo tih, “Pathen kah olka a yaak tih aka saii rhoek tah ka manu neh ka manuca la om uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hnin at vaengah Jesuh tah a hnukbang neh lawng khuila kun. Te phoeiah amih te, “Tuili kah rhalvangan la kat uh sih,” a ti nah tih kat uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hlaikan uh vaengah Jesuh tah vik ip. Te vaengah hlipuei khohli loh tuili la ha pawk tih dalh a muelh coeng dongah khopo uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Jesuh te a paan uh tih a haeng uh. Te phoeiah, “Boeipa, Boeipa, m'poci uh coeng he,” a ti nauh. Tedae a haeng vaengah khohli neh tui dongkah tuiphu te khaw a toel hatah khohli khaw paa tih suepduem la koep om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah amih te, “Nangmih kah tangnah te ta?” a ti nah. Tedae a rhih uh tih a ngai a hmang uh dongah amamih te, “Unim he, khohli neh tui khaw a voek tih a ngai pah he,” a ti uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah Galilee imdan ah aka om Gerasenes kho te a pha uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lan so a pha vaengah khopuei lamkah rhaithae aka khueh hlang pakhat loh a doe. Kum te yet ah himbai bai voel pawh, im ah pawt tih phuel ah naeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesuh te a hmuh vaengah pang tih a bakop thil. Te phoeiah ol ue la, “Kai taeng neh nang taengah balae aka om?, Khohni Pathen capa Jesuh aw. Kai nan phaep pawt ham ni nang kan hloep,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah hlang khui lamkah a coe hamla rhalawt mueihla te a toel. Te vaengah anih a paco te a tue khaw yet coeng . Thirhui neh a pael tih hloong nen khaw a khoh uh coeng. Tedae rhaithae loh khosoek la a vai vaengah tah hloong te khaw a dueng.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah anih te Jesuh loh, “Na ming ulae? tila a dawt. Anih te rhaithae a yet loh a kun thil dongah, “caempuei caempa,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah amih te tangrhom dung khuiah cungpung saeh tila olpaek pawt ham Jesuh te a hloep uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah tlang ah aka luem ok hui te muep tapkhoeh om. Te dongah amih te ok khuila kun sak ham a bih uh tih a kun sak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te daengah rhaithae rhoek tah hlang lamloh cet uh tih ok khuila kun uh. Tedae ok hui tah laengpoeng ah tuili khuila cu tih buek uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aka thoeng hno te ok vuelh rhoek loh a hmuh uh vaengah rhaelrham uh tih khopuei neh lohma lam khaw puen uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah aka om hno te sawt hamla cet uh tih Jesuh te a paan uh. Te vaengah a khui lamkah rhaithae rhoek loh a nong tak hlang khaw ana yol uh tih Jesuh kho kungah samthing la a ngol te a hmuh uh hatah a rhih uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah rhaithae aka kaem loh a khang te aka hmuh rhoek loh amih taengah patoeng puen uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae rhihnah loh mat a nan uh dongah Gerasenes pingpang kah rhaengpuei boeih loh Jesuh te amih taeng lamkah nong sak ham la a hloep uh. Jesuh khaw lawng khuila kun tih mael.
  </para>
  <para style="p">
    <verse number="38" style="v" />A khui lamkah rhaithae loh a nong tak hlang long khaw Jesuh neh amah taengah om hamla a bih.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae anih te a tueih tih, “Namah im la bal lamtah, Pathen loh nang ham a saii te thui pah,” a ti nah. Te dongah kho tom la cet tih Jesuh loh anih ham a saii te a hoe.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jesuh aka lamso la boeih a om uh dongah a mael vaengah anih te hlangping loh a doe.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te vaengah Jairus aka ming nah hlang pakhat te pakcak ha pawk. Anih tah tunim kah boei la om dae, Jesuh kho taengah bakop tih a im ah pah sak ham a cael.
  </para>
  <para style="p">
    <verse number="42" style="v" />A canu khueh duen, kum hlainit tluk te duek. Tedae a caeh vaegah Jesuh te hlangping loh a thing.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te phoeiah kum hlainit ah thii buk aka khueh huta om. Anih loh a khosaknah te siboei taengah boeih a hnonah coeng dae coeng thai pawt tih hoeih pawh.
  </para>
  <para style="p">
    <verse number="44" style="v" />A hnuk lamloh a paan tih a himbai dongkah salaw te a taek pah. Te dongah a thii buk te dup a ngol pah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tedae Jesuh loh, “Ulae kai aka taek te,” a ti nah. Boeih basa uh tih Peter loh, “Boeipa, hlangping loh nang te ng'et tih n'nen te ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te vaengah Jesuh loh, “Khat khat loh kai n'taek, kai lamkah ka thaomnah a caeh te ka ming,” a ti nah.
  </para>
  <para style="p">
    <verse number="47" style="v" />A phah tloel te huta loh a hmuh vaengah a birhih doela a paan tih a taengah a bakuep pah. Anih a taek vaengah a paelnaehnah te khaw, metla a hoeih pahoi te khaw pilnam boeih taengah puen.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te dongah anih te, “Ka canu, na tangnah loh namah ng'khang coeng, ngaimong la cet laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />A thui pueng ah tamtaeng taeng lamkah hlang pakhat ha pawk tih, “Na canu duek coeng, saya te toehoeih boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesuh loh a yaak vaengah, “Rhih boeh, dawk tangnah lamtah daem bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="51" style="v" />A pha vaengah Peter, Johan neh James, camoe kah manu a napa pawt atah pakhat khaw amah taengah im khuila kun sak pawh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te vaengah boeih rhap uh tih camoe te a rhaengsae uh. Tedae Jesuh loh , “Rhap uh boeh, a duek moenih, aka ip ni he,” a ti nah.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tedae a duek te a ming uh dongah Jesuh te a nueih thiluh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tedae Jesuh loh a kut a tuuk pah phoeiah a khue tih, “Camoe thoo laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="55" style="v" />Te dongah a mueihla ha mael tih pahoi thoo. Te phoeiah anih te a caak a paek ham a uen.
  </para>
  <para style="p">
    <verse number="56" style="v" />Te vaengah a manu napa tah limlum rhoi. Tedae aka om hno te thui pawt ham amih te a uen.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hnukbang hlainit te a hueh tih rhaithae te boeih khulae tih tlohtat hoeih sak ham amih taengah thaomnah neh saithainah a paek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Pathen ram hoe ham neh tattloel hoeih sak ham a tueih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah amih te, “Longpueng ham cunghol, sungsa, vaidam neh tangka khaw khuen uh boeh. Angki khaw yung nit khuen boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Im te na kun thil coeng atah, na naeh uh to vetih te lamlohna nong uh mako.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae nangmih aka doe pawt te tah kho lamkah na nong vaengah na kho dongah tangdik te, amih aka laipai thil ham khoek pa uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah aka cet rhoek loh kho tom a hil uh tih olthangthen a thui phoeiah khotomrhali ah tloh a hoeih sakuh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka om hno boeih te khoboei Herod loh a yaak vaengah sut hit. A ngen loh, “Johan te duek lamkah thoo coeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ngen bal loh, “Elijah phoe coeng te, “ a tloe rhoek long tah, “Khosuen kah tonghma khat khat ni aka thoo coeng te,” a ti uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae Herod loh , “Johan te ka rhaih coeng dae ulae aka om tih a thang vawk ka yaak he,” a ti tih amah hmuh ham a toem.
  </para>
  <para style="p">
    <verse number="10" style="v" />Caeltueih rhoek a bal uh vaengah amamih kah a saii uh boeih te Jesuh taengah a thui uh. Te phoeiah amih te a khuen tih Bethsaida a ti uh kho la amah bueng vil vi uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae anih aka vai hlangping loh a ming coeng dongah, amih te a doe tih Pathen ram kawng te amih ham a thui pah. Te vaengah hoeihnah aka ngoe rhoek khaw a hoeih sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khohnin loh a khum thuk vaengah hlainit rhoek loh amah te a paan tih, “Hlangping he tueih pawn sih, te daengah ni a taengvai kah kho neh lohma la cet vetih a pah nah ham neh buham khaw a dang uh eh. Khosoek hmuen ah ni ng'om uh he,” a ti uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae hnukbang rhoek te, “Amih kah a caak ham te nangmih loh pae uh,” a ti nah. Te vaengah amih loh , “He Pilnam pum ham caak aka lai la ka cet uh pawt koinih, vaidam panga neh nga panit lakah aka yet te kaimih taengah om voel pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah hlang thawngnga tluk om uh. Tedae a hnukbang rhoek te, “Amih te a boel pakhat ah hlang sawmnga tluk rhip ngol sak,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah a saii uh van tih boeih a ngol sakuh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah vaidam panga neh nga panit te a loh. Vaan la oeloe tih a uem phoeiah a aeh tih hlangping te patoeng paek hamla hnukbang rhoek taengah a paek.
  </para>
  <para style="p">
    <verse number="17" style="v" />A caak uh tih boeih a hah uh phoeiah a coih a nueipil te voh hlainit la a phueih uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A tue loh a pha vaengah thangthui neh amah bueng om tih hnukbang rhoek loh anih te a puei uh. Te vaengah amih te a dawt tih, “Hlangping loh kai he ulae a ti uh?” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />A doo uh tih, “Hlangvang loh tuinuem Johan, Elijah, hlangvang bal loh khosuen kah tonghma pakhat khat koep thoo,’ a ti uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah amamih te, “Nangmih long tah kai he ulae na ti uh?,” a ti nah. Te vaengah Peter loh a doo tih, “Pathen kah Khrih ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae amih te a ho tih te te thui pawt ham a uen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang Capa tah a muep a patang ham a kuek. Te dongah patong rhoek, khosoihham rhoek, neh cadaek rhoek loh a hnawt uh vetih a ngawn uh ni. Tedae a thum hnin ah thoo ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amih boeih te khaw, “Khat khat long ni ka hnukah lo ham a ngaih atah, amah te hnawt uh saeh lamtah, a thinglam a koh doela hnin takuem ah kai m'vai van saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A hinglu te khang ham aka ngaih te tah a hingnah poci ni. Tedae kai kongah hinglu aka poci long tah a hingnah a khang ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hlang loh Diklai pum a dang dae amah poci uh tih a sungdaeh atah balae a hoeikhang eh?
  </para>
  <para style="p">
    <verse number="26" style="v" />Kai neh ka ol he aka yah puei te tah capa kah, pa kah, a cim puencawn rhoek kah thangpomnah neh ha pawk vaengah hlang capa loh anih te a yah puei ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae nangmih taengah rhep kan thui. Hekah aka pai khuiah hlangvang om. Amih loh Pathen kah ram he a ming uh hlan atah dueknah te ten uh mueh mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />He kah olka a poeng phoeikah hnin rhet tluk ah, Peter, Johan neh James te a khuen tih tlang la thangthui ham a caeh puei .
  </para>
  <para style="p">
    <verse number="29" style="v" />A thangthui vaengah a maelhmai kah a mueimae loh a tloe la om tih a pueinak te a bok la khooi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah hlang panit loh anih te tarha a voek rhoi. Amih rhoi tah Moses neh Elijah ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amih rhoi tah thangpomnah neh phoe rhoi tih a Sunglatnah te a thui rhoi. Te te Jerusalem ah soep sak ham om coeng .
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae Peter neh a taengkah rhoi tah a ih neh bakba a hap uh tih om uh. A haenghang uh vaengah a thangpomnah te a hmuh uh tih a taengah hlang panit ana pai pah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amih rhoi te Jesuh taeng lamloh a khoe uh phoeiah Peter loh Jesuh te, “Boeipa, he ah he mamih ng'om uh ham then, dap pathum ah tuk uh sih, namah ham pakhat, Moses ham pakhat, Elijah ham pakhat saeh,” a ti nah tih a thui nawn te khaw ming pawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te te a a thui vaengah muei yal tih amih te a dah. Te dongah muei khuila a kun uh te khaw a rhih uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Muei khui lamkah ol ha thoeng tih, “Anih tah ka tuek ka ca ni, a ol hnatun pa uh,” a ti.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ol a thui bawt ah Jesuh tah amah bueng te tueng. Amih khaw kam a khuem uh tih te khohnin ah a hmuh uh te puen uh pawh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hnin at om tih a vuen ah amih te tlang lamloh suntla uh. Te vaengah Jesuh te hlangping loh muep a doe.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah hlang pakhat te hlangping khui lamloh tarha pang tih, “Saya, kai ham tah khueh duen la a om dongah, ka capa te nan paelki ham kam bih.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih te mueihla loh a tuuk tarha vaengah tah buengrhuet pang tih, tolhom neh suvaih. Anih te mat a ngawn a thaeh daengah a mael tak.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mueihla aka haek la na hnukbang rhoek te ka hloep dae coeng thai pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te dongah Jesuh loh a doo tih, “Aka tangnahmueh neh pamdah cadil aw, nangmih taengah mevaeng hil nim ka om vetih nangmih te ka yaknaem ve? Na capa te he la han thak,” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />A taengla ham paan vaengah camoe te rhaithae loh a voeih dongah thuen pueng. Tedae Jesuh loh mueihla thae te a ho daengah, camoe te hoeih tih a napa taengla a mael.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah Pathen kah a lennah soah boeih let uh tih, a hnukbang rhoek taengkah a thui neh a saii boeih soah boeih a ngaihmang uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te vaengah, “He kah ol he na hna ah namamih loh dueh uh. Hlang capa tah hlang kut ah voeih ham cai coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tedae he olthui he a mangvawt uh. Te te a hmuhming pawt ham ni amih ham a phah la om coeng. Te dongah he olthui he amah dawt ham a rhih uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tedae amamih khuiah ulae tanglue la aka om eh tila amamih khuiah poeknah a kun pah.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jesuh loh amih thinko poeknah te a hmuh dongah camoe a loh tih amah taengah a pai sak.
  </para>
  <para style="p">
    <verse number="48" style="v" />Te vaengah, “He camoe he ka ming neh aka doe long tah kai ni n'doe. Ka tueih aka doe long tah kai ni n'doe. Nangmih boeih lakli ah a diknoi la kho aka sa tah tanglue la om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Johan loh a doo tih, “Boeipa, nang ming neh rhaithae aka haek hlang pakhat ka hmuh uh. Tedae mamih taengah a bang pawt dongah anih te ka paa sak uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tedae anih te Jesuh loh, “Paa sak uh boeh, nangmih kah a kingkalh la aka om pawt te tah nangmih ham ni a om,” a ti nah.
  </para>
  <para style="p">
    <verse number="51" style="v" />A lueinah khohnin te a paan tom coeng dongah Jesuh tah Jerusalem la caeh ham a maelhmai a hooi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te dongah puencawn rhoek te a hmai ah a tueih. Te vaengah cet uh tih Jesuh ham aka rhuengphong la Samaria kho khuila kun uh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tedae Jerusalem la cet tih a maelhmai tueng ham a om dongah anih te doe uh pawh.
  </para>
  <para style="p">
    <verse number="54" style="v" />A hnukbang James neh Johan loh a hmuh rhoi vaengah, “Boeipa, vaan lamkah hmai suntlak sak ham neh amih hlawp sak ham khue na ngaih a?” a ti nah rhoi.
  </para>
  <para style="p">
    <verse number="55" style="v" />A mael thil tih amih rhoi te a ho.
  </para>
  <para style="p">
    <verse number="56" style="v" />Te dongah kho tloe la vik cet uh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Long ah a caeh uh vaengah hlang pakhat loh , “Mela na caeh akhaw nang kam vai ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="58" style="v" />Te vaengah Jesuh loh anih te, “Metang loh a khui, vaan kah vaa long khaw bu a khuehuh. Tedae hlang capa tah lu a tloeng nah khaw khueh pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="59" style="v" />Te phoeiah a tloe taengah, “Kai m'vai lah,” a ti nah. Tedae, te long te, “Boeipa, a pa up ham lamhma la kai n'caeh sak mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tedae anih te, “Aka duek rhoek up ham aka duek rhoek te hlah pah. Tedae nang tah cet lamtah Pathen kah ram te doek ngawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="61" style="v" />Te phoeiah pakhat long khaw, “Nang kam vai van ni Boeipa, tedae kai tah ka im kah rhoek te lamhma la m'phih sak dae,” a ti nah.
  </para>
  <para style="p">
    <verse number="62" style="v" />Tedae anih te Jesuh loh, “Laithol cung te kut a tloeng thil tih a hnuk la aka dan pawt ni Pathen kah ram ham aka ting la a om,” a ti nah.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Boeipa loh a tloe sawmrhih panit a tuek tih, amih te amah hmai kah pha hamla a cai thil kho neh a hmuen takuem la panit panit ah a tueih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah amih taengah, “Cangah hamla yet dae bibikung yool, te dongah cangah Boeipa taengah bih uh lamtah amah kah cangah hmuen ah bibikung han hlah saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cet uh, uithang lakli ah tuca bangla nangmih kan tueih coeng he.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sungkoi, sungsa neh khokhom khaw khuen uh boeh, longpueng ah hlang kuttu uh boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Im te na kun thil uh coeng atah lamhma la, 'He im khuiah ngaimongnah om saeh, 'ti na uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te ah te ngaimongnah kah a capa a om van atah nangmih kah ngaimongnah loh anih soah om ni. Te pawt koinih nangmih taengla koep ha bal bitni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah amah tekah im ah naeh uh, amih taengkah te ca uh lamtah ouh. Bibikung tah a thapang a dang hamla tueng pai. Im pakhat lamloh im pakhat la thoeih uh boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khopuei te na kun uh thil tih nangmih te n'doe uh atah na taengah han tawn te ca uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A khuikah tattloel te hoeih sak uh lamtah amih te, 'Pathen kah ram tah nangmih taengah yoei coeng,’ ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae khopuei te na kun thil uh vaengah nangmih te n'doe uh pawt atah toltung ah cet uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na khopuei lamkah loh kaimih kho dongah tangdik aka kap te nangmih kan khoek uh thil coeng, 'ti nauh. Tedae te nen te Pathen kah ram tah yoei coeng tila ming uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmih taengah ka thui, tekah khohnin ah Sodom te tekah khopuei lakah a phoeng la om ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anunae nang Khorazim, anunae nang Bethsaida, nangmih ah thaomnah aka om te Tyre neh Sidon ah om koinih, tlamhni neh hmaiphu dongah ngol uh vetih yut uh dingrhae pawn ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae laitloeknah khuiah Tyre neh Sidon te nangmih lakah a phoeng la om ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kapernaum nang te, vaan la na pomsang pawt nim? Tedae Hell la na cungpung bitni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmih taengah aka hnatun long tah kai ol a hnatun tih, nangmih aka hnawt long tah kai ni n'hnawt. Tedae kai aka hnawt long tah ka tueih hlang te khaw a hnawt,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sawmrhih panit tah omngaihnah neh mael uh tih, “Boeipa, nang ming nen tah rhaithae pataeng kaimih taengah boe a ngai uh coeng,” a ti uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah amih te, “Satan he vaan lamkah khophaa a tlak banglam ni ka hmuh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rhul neh saelkhui-ta-ai khaw, rhal kah thaomnah boeih khaw cawt thil hamla nangmih taengah saithainah kam paek he. Te dongah pakhat nen pataeng nangmih te n'thae sak loengloeng boel saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae mueihla loh nangmih taengah boe a ngai dongah he omngaih uh boeh, vaan ah na ming a tarhit dongah mah omngaih uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah te vaeng tue ah Mueihla Cim loh a hlampan sak tih, “A Pa, vaan neh diklai kah Boeipa namah te kan uem, lungming hlangcueih taengkah na phah tangtae te cahmang rhoek taengah a pumphoe pah. Te pai saeh, a pa, te ni na hmaiah kolonah la aka om.
  </para>
  <para style="p">
    <verse number="22" style="v" />A cungkuem he a Pa loh kai taengah a tloeng. Pa mueh atah capa te unim ti khaw a ming moenih. Capa mueh atah pa te unim ti khaw a ming moenih. Amih taengah khaw capa loh pumphoe hamla a ngaih,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah amah te hnukbang rhoek taengla mael tih, “Na hmuh uh he na mik loh a hmuh dongah he a yoethen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangmih ham ni ka thui, nangmih loh na hmuh uh he tonghma rhoek neh manghai rhoek loh hmuh ham muep a ngaih uh dae ana hmu uh pawh, na yaak uh he ana yaak lam khaw ana yaak uh moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah olming pakhat tah Jesuh te noemcai ham tarha thoo tih, “Saya, balae ka saii vetih dungyan hingnah ka pang eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah Jesuh loh anih te, “Olkhueng dongah a daek te metlam na tae te?” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih long khaw a doo tih, “Boeipa na Pathen te na thinko boeih, na hinglu boeih, na thadueng boeih, na kopoek boeih neh, na imben te khaw namah pum bangla na lungnah ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah anih te, “Buelh nan doo coeng, te te saii lamtah na hing bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae anih long te amah a tang a ngaih dongah, Jesuh te, “Ka imben te unim,” a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesuh loh a doo tih, “Hlang pakhat tah Jerusalem lamkah loh Jerikho la suntla dae dingca rhoek neh tonguh. Anih te a pit uh phoeiah lucik la a khuehuh. Te daengah a toeng uh tih duekhlong la a caeh tak uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tapkhoeh taploeng la khosoih pakhat tah tekah longpuei ah suntla tih anih te a hmuh dae a rhael.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vanbangla Levi khaw te hmuen kah aka om te a thoeng thil tih a hmuh dae a rhael bal.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae Samaria yin pakhat loh anih te a thoeng thil tih a hmuh vaengah a thinphat.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah a paan tih a hma te a ben pah, situi, misurtui neh a toi pah. Te phoeiah anih te amah kah boiva dongah a ngol sak, rhaehim la a khuen tih, a cuncah.
  </para>
  <para style="p">
    <verse number="35" style="v" />A vuen ah tah denari panit te a loh tih imtawt te a paek. Te phoeiah, 'Anih he cuncah lamtah pakhat khaw na vak yet te tah ka mael vaengah nang te kan thuung bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te rhoek pathum khuiah dingca kut ah aka cungku kah imben la ulae aka om ni tila na poek?” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah anih long te, “A soah rhennah aka tueng sak te,” a ti nah. Te phoeiah amah te Jesuh loh, “Cet lamtah namah loh saii van,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />A caeh uh vaengah kho pakhat ah pah. Te vaengah huta pakhat, a ming ah Martha loh Jesuh te a doe.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te vaengah a mana Mary la a khue te khaw om. Anih tah Boeipa kah kho taengah ngol van tih a ol te a hnatun.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tedae Martha tah bibi dongah mat tok. Te dongah koe pai tih, “Boeipa, kai mana tah nang hamla a ngaihuet voel pawt tih kamah bueng he thohtat ham n'hnoo coeng. Te dongah anih te thui pah lamtah kai n'bom mai saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tedae anih te Boeipa loh a doo tih, “Martha, Martha, muep na mawn tih na tom na ta mai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tedae pakhat a ngoe om, Mary loh buham then te a tuek coeng dongah anih kah he rhawt pa uh mahpawh,” a ti nah.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amah a om vaengah a tue a pha tih hmuen pakhat ah thangthui. A thangthui bawt ah, a hnukbang pakhat loh Jesuh taengah, “Boeipa, kaimih he thangthui ham n'thuituen lah, Johan long khaw a hnukbang rhoek te a thuituen van,” a ti nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah amih te, “Na thangthui uh vaengah, 'A pa na ming tah ciim pai saeh, na ram pai saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khohhnin rhamhnin kaimih kah buh he amah khohnin ah kaimih m'pae lah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaimih kah tholhnah soah kaimih he n'hlah lah, kaimih khaw kaimih taengah laiaka ba boeih te ka hlah uh van dongah. Cuekhalhnah khuila kaimih n'khuen boeh, 'ti uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah amih te, “Nangmih khuikah pakhat loh paya a khueh tih, ihdulh ah anih taengla cet mai ni. Te vaengah anih te, 'Ka paya, vaidam pa thum ah kai m'pu dae.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka paya yin lamkah kai taengla ha pawk tih, anih ham ka tawn pah khaw ka khueh pawh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te long khaw a khuiah a doo tih, 'Thakthaenah nen khaw kai n'toeh boeh. Thohka a khaih coeng, ka taengkah ka ca rhoek khaw ihnah dongla om uh coeng, nang paek ham ka tho thai mahpawh,’ a ti nah ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangmih taengah ka thui, anih te a paya la a om dongah thoo cakhaw pae mai mahpawh. Tedae a paya te a calaak coeng atah thoo vetih a kuek yet te a paek ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangmih taengah ka thui, Bih uh lamtah, nangmih tem'paek bitni, toem uh lamtah na hmuh uh bitni, khoek uh lamtah nangmih ham a ong binit.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aka bih loh boeih a dang tih, aka toem loh a hmuh dongah aka khoek ham khaw a ong pah ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih khuikah napa pakhat te a ca loh nga a hoe vaengah, nga yueng la rhul a doe aya?
  </para>
  <para style="p">
    <verse number="12" style="v" />Aiduei hoe koinih a ca te saelkhui-ta-ai a paek aya?
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah nangmih a thae la aka om long pataeng, na ca rhoek te kutdoe then paek ham na ming uh atah, vaan lamkah pa loh muep a ming ngai dongah amah aka dawt rhoek te tah Mueihla Cim a paek ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rhaithae om tih a haek hatah olmueh la ana poeh pah. Te dongah rhaithae te vawl a caeh daengah olmueh te koep cal tih hlangping khaw a ngaihmang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae amih khuikah hlangvang loh , “Rhaithae boei Beelzebul rhangnen ni rhaithae a haek,” a ti uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />A tloe rhoek loh a noemcai uh tih vaan lamkah miknoek te anih taengah a toem uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae amah loh amih kah kopoek te a ming dongah amih te, “Ram boeih he amah a paekboe atah poci tih, imkhui loh imkhui a paekboe thil atah cungku.
  </para>
  <para style="p">
    <verse number="18" style="v" />Satan khaw amah neh amah paekboe uh koinih, metlam lae a ram a pai eh? Kai loh Beelzebul rhangneh rhaithae a haek na ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Beelzebul rhangneh rhaithae te ka haek koinih, na ca rhoek long tah u rhangnen lae a haekuh. Te dongah amih te nangmih soah laitloekkung la om uh ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Pathen kah kutdawn neh rhaithae te ka haek koinih, nangmih soah Pathen kah ram ha pai coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khangmai la aka nuet uh long ni a vongup te a hung tih a khuehtawn loh ngaimong la om van.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae anih lakah aka tlung ngai ha pawk vaengah tah anih te a noeng. Te vaengah a pangtung thil lungpok haica te a rhawt pah tih, a kutbuem a poelyoe pah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai taengah aka om pawt tah kai aka koek ni. Kai taengah aka coi pawt loh a thaek.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mueihla thae tah hlang taeng lamkah a nong vaengah tuihang hmuen te a hil tih duemnah a tlap. Tedae hmuen a hmuh pawt vaengah, “Ka nong tak tangtae kamah im la ka mael ni,' a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ha pawk vaengah, im te nawt tangtae neh a khoem la a hmuh
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah cet tih amah lakah aka thae mueihla tloe parhih te a khuen. Te phoeiah a kun puei tih pahoi a om puei dongah tekah hlang kah a hnukkhueng tah lamhma kah lakah a thae la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te a thui vaengah hlangping khui lamkah huta pakhat loh ol a huel tih Jesuh te, “Nang aka yom bung neh aka cun rhang suk tah a yoethen,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae Jesuh loh , “Pathen ol aka ya tih aka tuem rhoek tah a yoethen ngai,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hlangping he a khawk vaengah a tong tih, “Tahae kah cadil tah rhaithae cadil ni, Miknoek te a toem uh dae Jonah kah miknoek pawt atah miknoek pae mahpawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jonah tah Nineveh ham miknoek la a om vanbangla, hlang capa khaw tahae kah cadil taengah om van ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tahae cadil hlang rhoek taengkah laitloeknah ah tuithim manghainu te thoo vetih amih te a boe sak ni. Anih tah Solomon kah cueihnah hnatun ham diklai khobawt lamkah ha pawk. He ah he Solomon lakah aka khuet om ta he.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ninevi hlang rhoek loh tahae cadil kah laitloeknah te a pai uh thil vetih a boe sak ni. Jonah kah olhoe neh a yut uh atah, he ah aka om he Jonah lakah khuet dae ta he.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hmaiim a tok te tanhnaem ah khueh pawt tih voh khuiah khaw a muek moenih. Tedae aka kun rhoek loh vangnah hmu van saeh tila hmaitung soah ni a khueh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na mik tah na pum kah hmaiim ni. Na mik loh cilrhik la a om vaengah na pum boeih te cilping la om van. Tedae a thae la a om vaengah na pum tah hmuep van.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te dongah ngaithuen, na khuikah vangnah te yinnah la poeh ve.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah na pum te boeih vang tih cungvang ah a hmuep pakhat khaw a om pawt atah, hmaiim loh a aa neh nang n'tue vaengkah bangla phaeng aka vang la om ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />A thui vaengah, Pharisee loh a taengah buh ca la anih te a cael dongah kun tih a ngol puei.
  </para>
  <para style="p">
    <verse number="38" style="v" />Buh kungah khut a nuem lamhma pawt te Pharisee loh a hmuh tih a ngaihmang.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae Boeipa loh anih te, “Nangmih Pharisee rhoek loh boengloeng neh baelpuei kah a hmanhu tah na cil na poe coeng. Tedae na khuiah halhkanah neh halangnah ni aka bae.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hlang ang rhoek! a sohman ah aka saii loh a khui te khaw a saii moenih a?
  </para>
  <para style="p">
    <verse number="41" style="v" />Tedae a khuikah aka om te doedannah la pae uh lamtah, nangmih ham boeih caih ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anunae nangmih Pharisee rhoek! Sungii, sungsing neh toian boeih tah na paek uh dae Pathen kah tiktamnah neh lungnah tah na hnalvaluh. Saii hamla a kuek te dalrha uh tak boeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anunae nangmih Pharisee rhoek te! tunim kah ngolhmuen then neh hnoyoih hmuen kah toidalnah ni na lungnah uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Anunae nangmih aih te, hlan bangla lumrhilumrha la na om uh dongah a sokah aka pongpa hlang loh ming pawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Olming pakhat loh Jesuh te a doo tih, “Saya, na thui te kaimih ni nan neet,” a ti nah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tedae Jesuh loh, “Nangmih olming rhoek khaw anunae, hlang rhoek te hnophueih neh phueihtloel la na nan uh tih, namamih tah na kutdawn pakhat nen khaw hnophueih te na ben uh pawh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Anunae nangmih aih, tonghma rhoek kah phuel te na sak uh dae na pa rhoek long ni amih te a ngawn.
  </para>
  <para style="p">
    <verse number="48" style="v" />Na pa rhoek kah a khuui la na om uh van dongah a khoboe te na rhoihuh. Tonghma rhoek te amih loh a ngawn tih nangmih loh phuel im na sak pa uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te dongah Pathen kah cueihnah long khaw, “Amih taengah tonghma rhoek neh caeltueih rhoek te ka tueih van vaengah, amih te a ngawn uh vetih a hnaemtaek bitni,” a ti.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te dongah Diklai a tongnah lamkah tahae cadil rhoek loh a long sak tonghma rhoek kah a thii phu te boeih suk nawn saeh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Abel thii lamloh Zekhariah thii duela hmueihtuk neh im laklo ah ni a poci. Ue ta, nangmih taengah ka thui, tahae kah cadil taengah a suk bitni.
  </para>
  <para style="p">
    <verse number="52" style="v" />Anunae nangmih olming rhoek te, mingnah cabi na pom lalah namamih khaw na kun uh pawt tih aka kun rhoek te na kang uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="53" style="v" />Te lamkah loh Jesuh vawl a nong phoeiah tah cadaek rhoek neh Pharisee rhoek loh mat a hmuhuet uh tih anih kawng te muep a cawh uh.
  </para>
  <para style="p">
    <verse number="54" style="v" />A ka lamkah ol khat khat neh tangkhuep ham amah te a rhongngol uh.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlangping a thawng a sang te tingtun uh tih khat neh khat taelh uh thae. Lamhma kah a hnukbang rhoek te, “Tolrhu te na ngaithuen uh mako, te tah Pharisee kah thailatnah ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah phah la aka om te tah pumphoe mueh pawt tih a huephael te khaw a ming mueh moenih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te yueng la a hmuep ah na thui uh te vangnah khuiah a yaak ni. Imkhui kah a hna ah na thui uh te khaw imphu ah a hoe ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka paya rhoek nangmih taengah ka thui coeng. Pumsa te a ngawn uh dae, te phoeiah saithainah pakhat khaw aka khueh pawt te rhih uh boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae na rhih uh te kan tueng eh. Pum te a ngawn phoeiah hell la voeih ham saithainah aka khueh te rhih uh. Ue ta, nangmih taengah anih la rhih uh ka ti loel.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vahnup phiknga te pe hnih la a yoih uh moenih a? Te rhoek te pakhat khaw Pathen hmaiah a hmaai a om moenih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na lu kah sam pataeng boeih a tae coeng. Rhih uh boeh, vahnup lakah muep na tiing uh ngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Nangmih taengah ka thui, kai kawng he hlang hmaiah aka phong boeih te tah hlang capa loh anih te Pathen kah puencawn rhoek hmaiah a phong van ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae hlang hmaiah kai aka hnawt tah Pathen puencawn rhoek hmaiah ka huek uh tak ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlang capa te ol aka tha thil boeih te tah tholh a hlah pah pueng ni. Tedae Cim Mueihla taengah aka soehsal te tah tholh hlah pah mahpawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih te tunim la, boeilu rhoek neh saithainah aka khueh taengla n'khuen uh ni. Te vaengah metla na huul uh vetih ba na thui uh ham khaw mawn uh boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thui ham a kuek te tah amah tue vaengah Cim Mueihla loh nangmih n'thuituen bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hlangping khuikah pakhat loh Jesuh te, “Saya, ka manuca te thui pah lamtah kai hamla rho ham paek,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Jesuh loh anih te, “Ka hlang aw, nangmih rhoi soah laitloekkung ham neh tultaelkung la u long kai n'tuek,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah amih te, “Halhkanah te boeih hmuming uh lamtah cue uh. A khuehtawn om dae a hingnah pakhat khaw a cawt moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah amih taengah nuettahnah a thui tih, “Kuirhang hlang pakhat kah lo te cang a thawt pah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae amah khuiah a poek tih, ‘Ka cang thaih he, ka tung nah ka khueh pawt dongah banim ka saii lah ve,’ a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah, ‘He tla ka saii eh, ka khai te ka phae vetih a len la ka saii eh, te ah te ka cang neh ka koe te boeih ka tung eh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah ka hinglu te, “Ka hinglu nang, kum a sen ham koe muep na khueh coeng dongah duem lamtah, ca lamtah, o lamtah, uum laeh,” ka ti nah ni,’ a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae anih te Pathen loh, ‘Hlang ang, tu khoyin ah na hinglu te nang taeng lamkah loh a lat pawn ni. Tahae kah na hmoel te u ham nim a om ve?’ a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah anih loh amah ham a tung dae a khuehtawn loh Pathen taengla a pawk puei moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hnukbang rhoek te khaw, “He dongah ni nangmih taengah ka thui, na caak uh te khaw, pum dongah na bai uh ham te khaw, na hinglu mawn sak uh boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />hinglu tah buh lakah, pum he khaw himbai lakah olpuei la om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vangak ke poek uh lah, tuh uh pawt tih at uh pawh, a im khaw, khai khaw khueh uh pawt dae Pathen loh amih te a khut. Nangmih tah vaa lakah muep na olpuei uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmih khuiah unim aka mawn tih a hinglung te dong at khaw aka cong thil thai?
  </para>
  <para style="p">
    <verse number="26" style="v" />A yit dongah na coeng uh pawt atah, ba ham lae a tloe dongah na mawn uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hmat uh lah, rhaipai ke metlam a rhoeng, thakthae pawt tih cunghmui khaw hnuk pawh. Tedae nangmih taengah ka thui, Solomon loh a thangpomnah boeih neh rhaipai pakhat banglam pataeng a bai sak moenih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tihnin ah om tih thangvuen ah hmailing khuila a phum lohma kah khopol pataeng Pathen loh a thoeihcam atah nangmih te muep na uepvawt aih mai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah nangmih loh na caak ham neh na ok te toem uh boeh uepvawt uh boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Diklai namtom boeih loh te te a tlap uh. Tedae nangmih kah na kuek te pa loh a ming coeng.
  </para>
  <para style="p">
    <verse number="31" style="v" />A ram te tlap uh dae lamtah tekah te nangmih ham han thap bitni.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ram te nangmih paek ham na pa a lung a tlun coeng dongah, tuping ca aw, birhih boeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na khuehtawn te yoi uh lamtah, doedannah la pae uh, aka rhuem pawh sungkoi te namamih ham saii uh. khohrhang he vaan ah tah cueng. Te ah te hlanghuen loh muk pawt tih, keet long khaw phae pawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na khohrhang a om nah ah na thinko khaw pahoi om ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Na pumpu te yen tangtae la om saeh lamtah hmaiim khaw vang saeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah yuluei kung lamkah aka bal a boeipa aka lamtawn hlang rhoek bangla na om uh mako. Te daengah ni ha lo tih a khoek vaengah anih ham pahoi a ong pa thai eh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Boei ha lo vaengah hmuh hamla aka hueltue rhoek tah sal yoethen ni. Nangmih taengah rhep ka thui, amih te cihin a vaep tih a ngolhlung dongah aka pongpa rhoek loh amih te a khut.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pathum, pabae la ha pawk vaengah aka tawt te a hmuh tangloeng dongah amih tah yoethen la om uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tedae he he ming uh, hlanghuen ha pawk nah khonoek te imkung loh ming koinih, a im te muk hamla hlah sut pawt sue.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah nangmih loh sikim la om uh, hlang capa tah na poek uh pawt tue ah ni ha pawk eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Peter loh, “Boeipa, he nuettahnah he kaimih ham a? Hlang boeih ham khaw na thui a?” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Boeipa loh, “Unim uepom neh aka cueih hnokhoem la aka om van? Boeipa loh anih te a imlo soah a tue a tang neh maehham aka tael la a khueh ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tekah sal tah a yoethen, a saii te a Boeipa ha pawk vaengah a hmuh pah van ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nangmih taengah rhep kan thui, a khuehtawn boeih soah anih ni a ngol sak eh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tedae tekah sal loh a thinko khuiah, ‘Ka boeipa ha pawk ham tah koe pueng ni,’ a ti. Te dongah salnu camoe te koe a boh tih, a caak a ok neh rhui.
  </para>
  <para style="p">
    <verse number="46" style="v" />Sal kah a boei tah a lamtawn mueh khohnin neh a ming mueh a tue vaengah ha pawk koinih, anih te a tloek vetih a paihmuen te aka tangnahmueh rhoek taengla a khueh pah ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />Tekah sal loh a Boeipa kah kongaih a ming dae, rhuengphong pawt tih amah kongaih bangla a saii dongah a boh dahlawt ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tedae aka ming pawt loh a saii atah nganboh a yook ham tueng te a yool ni a boh eh. A yet a paek hlang boeih te tah a taengah a yet a toem pah vetih, muep a paek hlang taengah khaw muep a hoe pah ni.
  </para>
  <para style="p">
    <verse number="49" style="v" />“Diklai dongah hmai pak hamla ka pawk coeng dongah, metla hlae oepsoeh cakhaw ka ngaih mai coeng.
  </para>
  <para style="p">
    <verse number="50" style="v" />Baptisma khaw nuem hamla ka om pueng tih, ka coeng hlan atah metlam nim n'nan ve.
  </para>
  <para style="p">
    <verse number="51" style="v" />Diklai ah rhoepnah paek ham ka pawk tila na poek uh a? Moenih ta, nangmih taengah ka thui, paekboenah ham dae ni he.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tahae lamkah longtah im pakhat ah panga la paek uh thae vetih, panit pathum, panit pathum ah om uh ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />Pa neh capa, capa neh pa, manu neh canu, canu neh manu, mani neh a langa, langa neh mani paekboe uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te phoeiah hlangping te khaw, “Khotlak ah khomai a thoeng te na hmuh uh vaengah, ‘Khonal ha pai ni,’ pahoi na ti uh tih pai tangloeng van.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tuithim a hli vaengah, ‘Kholing ha pai ni,’ na ti uh tih pai tangloeng.
  </para>
  <para style="p">
    <verse number="56" style="v" />Hlangthai palat rhoek, diklai neh vaan kah maelhmai ke soepsoei ham na ming uh tih a tue he balae tih soepsoei ham na ming uh pawh.”
  </para>
  <para style="p">
    <verse number="57" style="v" />“Namamih ham khaw balae tih a dueng la lai na tloek uh pawh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Na kocaelh neh boei taengla na caeh vaengah anih te a paa nah hamla longpueng ah bi saii laeh, laitloekkung taengla namah n'det ve. Laitloekkung loh namah te palik taengla m'voei vetih palik loh thongim ah n'hla ve.
  </para>
  <para style="p">
    <verse number="59" style="v" />Na taengah kan thui, mucih ca khaw boeih na thuung hlan atah te lamkah loh na loeih loengloeng mahpawh,” a ti nah.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amah a khoning vaengah Pilat loh hmueih neh Galilee rhoek kah thii a thoek te hlangvang aka om rhoek loh Jesuh taengla puen uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah amih te a doo tih, “Te te a yook uh dongah Galilee rhoek tah Galilee rhoek boeih lakah hlangtholh la om tila na poek uh a?
  </para>
  <para style="p">
    <verse number="3" style="v" />Moenih ta, nangmih taengah kan thui, na yut uh pawt atah boeih na poci uh van ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Siloam kah imsang loh a bung thil tih aka duek hlairhet rhoek te ta. Amih tah Jerusalem khosa hlang boeih lakah hlangtholh ni tila na poek uh a?
  </para>
  <para style="p">
    <verse number="5" style="v" />Moeinih ta, nangmih taengah ka thui, na yut uh pawt atah boeih na poci uh van ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah nuettahnah a thui bal. “Amah dum ah thaibu aka ling hlang pakhat om tih, a thaih hoel hamla ha pawk hatah hah a sawt.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah dumpho taengah, 'Kum thum khuiah ka lo tih hekah thaibu dongah a thaih ka hoel dae hah ka sawt coeng he. Te dongah vung laeh, ba ham lae te nen te diklai a kang eh?,’ a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae anih te a doo tih, “Boeipa, te te pin ka to li tih aek ka sang hil tah kum at he khaw hlun mai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thanghal a pha atah a thaih khaw cuen mai ni ta, a thaih pawt bal atah na vung mai bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sabbath vaengah tunim pakhat ah om tih a thuituen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah kum hlairhet ah ngoicaemnah mueihla aka kaem huta te pakcak ha thoeng. Anih te ting khun la om coeng tih khuek pai thai pawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih te a hmuh vaengah Jesuh loh a khue tih amah taengah, “Huta, Na ngoicaemnah te na hlah coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah huta te kut a tloeng thil hatah pahoi a dueng pah dongah Pathen te a thangpom.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Jesuh loh Sabbath vaengah a hoeih sak te tamtaeng loh a yakdam. Te dongah hlangping te a doo tih, “Hnin rhuk a om khuiah a saii ham te a kuek, te vaengah ha pawk kanoek vetih na hoeih uh mako, Sabbath hnin ah pawt mako,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah anih te Boeipa loh a doo tih, “Hlangthai palat rhoek! nangmih pakhat rhip loh Sabbath ah a vaito neh muli-marhang te khongduk lamkah a hlam tih tui tul ham a khuen uh moenih a?
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih he Abraham canu la om dae ta. Amah he Satan loh kum hlai rhet a pin coeng ta he. Te dongah Sabbath khohnin ah he hloong dong lamkah loh hlam ham a kuek moenih a?,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />He he a thui vaengah, anih aka kingkalh rhoek boeih tah yah a poh uh. Tedae hlangping boeih tah amah loh rhuepom la boeih a thoeng sak soah omngaih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah koep a thui tih, “Balae Pathen kah ram phek la aka om?
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae metlam ka thuidoek eh te? Te te mukang mu phek la om. Te te hlang loh a loh tih a dum ah a haeh. Tedae a rhoeng vaengah thing la poeh tih vaan kah vaa loh a hlaeng dongah bu a tuk,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah, “Ka thuidoek thil ham Pathen kah ram te tah tolrhu phek la om.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te te huta loh a loh tih vaidam khoi thum boeih a rhoi hil khaw a hlum thil,” koep a ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khopuei vangca ah pah tih a thuituen phoeiah tah Jerusalem la a caeh long a tarhoek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah hlang pakhat loh a taengah, “Boeipa, te rhoek ca bueng khang koinih,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Jesuh loh amih te, “Thohka caek longah kun hamla thingthuel uh lah. Nangmih taengah ka thui, a yet loh kun hamla a toem uh suidae noeng uh mahpawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Imkung loh thoo tih thohka a khaih nen tah, poeng ah na pai uh pahoi vetih thohka te na khoek uh ni. Te vaengah, 'Boeipa, kaimih ham ong dae,' na ti uh ni. Tedae nangmih te n'doo vaengah, 'Nangmih me kah aka om rhoek nim? kam ming moenih,’ a ti ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te vaengah, 'Namah taengah ka caak ka ok uh tih, kaimih kah toltung ah na thuituen ta,’ na ti uh ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae nangmih taengah a thui vetih, 'Nangmih mekah aka om rhoek nim kam ming moenih, boethae kah bibikung rhoek kai taeng lamkah loh boeih nong uh,’ a ti ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te ah te rhah neh no rhuengnah ni aka om eh. Pathen kah ram ah Abraham, Isaak, Jakob neh tonghma rhoek te boeih na hmuh uh vaengah nangmih te phawn n'thaek uh ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah khocuk neh khotlak lamkah, tlangpuei neh tuithim lamkah loh ha pawk uh vetih Pathen kah ram ah ngolhlung uh ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />A hnuk la aka om rhoek te lamhma la om uh vetih, lamhma la aka om rhoek te a hnuk la om uh ni ke,” a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah tekah a tue vaengah Pharisee pakhat loh Jesuh te a paan tih, “Khoe uh lamtah cet dingdoeng laeh, Herod loh nang ngawn ham a ngaih,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah amih te, “Cet uh lamtah maetang te thui pa uh, rhaithae ka haek tih tihnin ah hoeihnah ka saii he thangvuen neh omvai ah ka coeng ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae kai ham tihnin neh thangvuen te khaw a kuek dongah caeh hamla om. Jerusalem voel ah tonghma sai a caeh te yae boel saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jerusalem, Jerusalem, tonghma rhoek te aka ngawn tih a taengla a tueih pah rhoek te khaw aka dae, ainu loh a phae hmuiah a aicahui khoep a ku vaengkah a longim bangla, na ca rhoek te ka kholcui ham ka ngaih taitu dae na ngaih uh pawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na im te nangmih taengla han hlah coeng he. Tedae nangmih ham ni ka thui. Boeipa ming neh aka pawk tah a yoethen, 'na ti uh tue te ha pawk duela kai nan hmuh uh loengloeng mahpawh,” a ti nah.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath a pha vaengah Jesuh tah Pharisee boeilu pakhat im ah buh ca la cet. Te vaengah amah te a om thil uh tih a dawn uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah hlang pakhat bungthung aka khueh te a hmaiah pakcak a pawk pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Jesuh loh olming rhoek neh Pharisee rhoek te a doo tih a voek vaengah, “Sabbath hnin ah tloh hoeih sak ham tueng a, a tueng moenih a?” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae amih loh a hil a phah uh dongah a hoeih sak hlang te a mawt tih a tueih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah amih te, “Na ca mai khaw, vaito mai khaw tangrhom ah aka cungku te, Sabbath hnin ah pahoi a doek moenih a?” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae te te oelh uh thai pawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmuensang te mat a laehdawn tih aka tuek, a cael rhoek te nuettahnah a thui pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah amih te, “Yuluei kung la hlang khat khat loh n'khue uh vaengah, hmuensang ah ngol uh boeh, anih loh a khue te nang lakah a khoelh la vik om ve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te vaengah nang neh anih aka khue te ha pawk vetih nang te, ‘Anih he hmuen pae dae,’ a ti ni. Te vaengah yah te na poh van vetih a hmuen hnukkhueng te na dang ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah n'khue vaengah cet lamtah hnukkhueng hmuen ah ngol. Te daengah ni nang aka khue te ha pawk vaengah nang te, ‘Paya aw, thoo hang dae,’ a ti vetih na taengkah aka ngol rhoek boeih taengah nang hamla thangpomnah a om eh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah aka pomsang boeih tah tlarhoel vetih amah aka tlarhoel tah a pomsang ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah amah aka khue te khaw, “Buhkoknah neh hlaembuh na saii vaengah, na paya, na manuca, na huiko, na imben kuirhang rhoek te khue boeh. Amih loh namah te n'buhung van vetih kutthungnah loh namah taengla ha thoeng ve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae buhloei na tael vaengah khodaeng, kut ngun kho ngun, aka khaem, mikdael te khue.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yoethen la na om bitni, nang n'sah ham te khueh pawt cakhaw aka dueng rhoek kah thohkoepnah dongah nang ham a sah bitni,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />A yaak uh vaengah aka ngol rhoek khuikah pakhat loh, “Yoethen long te tah Pathen kah ram ah buh a caak ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih te khaw Jesuh loh, “Hlang pakhat loh hlaembuh muep a thong tih hlang muep a khue.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hlaembuh tue ah tah a sal te a khue rhoek taengla a tueih tih, ‘Ham paan uh laeh, sikim la om coeng,’ a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae a bangtlang la boeih a thaanah uh tih, lamhma kah loh, ‘Lo ka lai tih aka hip la caeh ham a kueknah la ka om. Namah taengah kam bih mai eh, om mai saeh, kai tah ng'rhoe mai,’ a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakhat loh, ‘Vaito a rhoi panga ka lai tih, nainong ham ka cet ni, Namah taengah kam bih mai eh, om mai saeh, kai tah ng'hoep mai,’ a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pakhat bal loh, ‘Yuu ka loh tih ka lo ham coeng mahpawh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah sal te a pawk vaengah tah a boeipa taengla a puen pah. Te vaengah imkung tah kosi a hong tih a sal te, ‘Khopuei kah toltung neh imhlai laklo ah a loe la cet lamtah, khodaeng, a kut a kho aka ngun, mikdael, aka khaem te pahoi hang khuen,’ a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sal loh, ‘Boeipa, nan tueih bangla ka saii coeng dae a hmuen om pueng,’ a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah boei loh sal taengah, ‘Khohla longpuei neh vongtung taengah khaw cet lamtah ha kun ham tanolh dae, te daengah ni ka im ah hlang a bae eh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangmih taengah ka thui coeng, ka khue hlang rhoek loh kai kah hlaembuh ten uh boel saeh,’ a ti nah,” te a thui pah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesuh te hlangping loh muep a puei hatah, amih taengla mael tih,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Khat khat te kai taengla ha lo vaengah a napa neh a manu, a yuu neh a ca, pacaboeina neh tanu takhong, amah kah a hinglu khaw a toeng thil bal pawt atah ka hnukbang la om ham a coeng moenih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah kah thinglam a koh pawt ah kai hnukla aka lo te tah ka hnukbang la om ham a coeng moenih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih khui lamkah loh imsang sak ham aka ngaih te unim? Lamhma la ngol tih a hnonah te a tae moenih a? Imcoeng ham khueh mai cakhaw?
  </para>
  <para style="p">
    <verse number="29" style="v" />A khoengim a sut tih coeng thai pawt koinih aka hmu boeih loh anih te pahoi a tamdaeng ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />hlang loh sak hamla a tong dae a coeng thai moenih,’ a ti uh ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mebang manghai khaw manghai pakhat te a noem tih ni caem la a caeh. Te vaengah ngol lamhma tih a doe ham te thawng rha a om thai atah anih te thawng kul neh paan thil ham a moeh moenih a?
  </para>
  <para style="p">
    <verse number="32" style="v" />Te pawt koinih voelh a om vaengah rhoepnah ham laipai a tueih vetih a dawt ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah nangmih boeih khaw, a khuehtawn boeih aka hlah pawt te tah ka hnukbang la om ham a coeng moenih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lungkaeh khaw tui, tedae lungkaeh te khaw a dap atah ba nen lae a hlihlim sak eh?
  </para>
  <para style="p">
    <verse number="35" style="v" />Laimen ham khaw om pawt tih, aek lam khaw hoeikhang laklo pawt dongah phawn a voeih uh. Yaak nah hna aka khueh rhoek loh yaa uh,” a ti nah.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />A om uh vaengah mangmucoi rhoek neh hlangtholh rhoek loh anih taengah hnatun ham boeih a paan uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Pharisee rhoek neh cadaek rhoek te cai uh tih, “Anih loh hlangtholh rhoek a doe tih amih taengah a caak,” a ti uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah hekah nuettahnah he amih ham a thui pa tih,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nangmih khuikah mebang hlang khaw tu yakhat a khueh vetih te khui lamkah loh pakhat te poci koinih, sawmko pako te khosoek ah a hnoo tih a hmuh duela aka poci te a hnuk ah a hlak moenih a?
  </para>
  <para style="p">
    <verse number="5" style="v" />A hmuh vaengah khaw a laengpang dongah a tloeng tih omngaih ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Im la a pawk vaengah khaw a paya rhoek neh imben rhoek te a hueh tih, ‘Kamah taengah omngaih uh, ka tu aka poci te ka hmuh coeng,’ a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vanbangla nangmih taengah ka thui. Yutnah aka ngoe pawh hlang dueng sawmko pako so lakah aka yut hlangtholh pakhat soah ni vaan ah omngaihnah a om eh.”
  </para>
  <para style="p">
    <verse number="8" style="v" />“Huta loh tangkanuei lung rha te a khueh. Tangkanuei pakhat te a hlong atah, hmaiim te a tok phoeiah im te a nawt, a hmuh pawt atah khaelh khaelh a tlap.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hmuh daengah, a paya rhoek neh imben rhoek te a hueh tih, ‘Tangkanuei ka poci sak te ka hmuh dongah kamah taengah omngaih uh,’ a ti pueng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vanbangla nangmih taengah kan thui. Hlangtholh pakhat a yut soah ni Pathen kah puencawn rhoek hmaiah omngaihnah a om,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah, “Hlang pakhat loh capa panit a khueh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amih rhoi khuiah a noe loh a napa te, ‘A pa, koe a kaekvang na hmoel te kamah m'pae laeh,’ a ti nah. Te dongah a napa loh amih rhoi ham khosaknah te a tael pah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae khohnin muep a koe kolla boeih aka kool a capa a noe tah kho hla la yiin. Te phoeiah a koe te pahoi a poek tih cungpoeh cungdam la hing.
  </para>
  <para style="p">
    <verse number="14" style="v" />Boeih a hnonah phoeiah tah te rhoek pingpang ah khokha loh muep a pai thil tih anih khaw vawt tangkhuet.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah te pingpang kah pilnam pakhat taengah cet tih kap. Te vaengah anih te ok vuelh ham lohma la a tueih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah ok loh a caak canghlam koi te caak ham a hue dae anih te pae uh pawh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te daengah amah te a cueih koep om tih, ‘A pa kah kutcoep rhoek te yet pataeng buh a coih sak uh dae kai tah khokha neh ka poci pahoi coeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka thoo vetih a pa taengla ka cet pawn ni. Amah taengah, “A pa, vaan neh nang hmaiah ka tholh coeng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na ca la khue ham khaw a koihvaih la ka om moenih, kai he na kutcoep pakhat la ng'khueh,” ka ti nah ni,’ a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah thoo tih a napa te a paan. Tedae a hla la a om vaengah a napa loh a hmuh tih a thinphat. Te dongah yong tih a rhawn ah a kop tih a mok.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah a capa loh, ‘A pa, vaan neh namah hmaiah ka tholh coeng, na ca la khue ham khaw ka a koihvaih la ka om moenih,’ a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae a napa loh a sal rhoek te, ‘Hnikul tanglue te a loe la hang khuen uh lamtah anih he bai sak uh. A kut dongah kutbuen, a kho dongah khokhom buen sak uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vaito puetsuet te han khuen uh, te te ngawn uh. Te phoeiah uum uh sih lamtah ca uh sih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka ca a duek la aka om he koep hing, aka poci la om dae koep a phoe coeng dongah pahoi uum sih,’ a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah lohma ah aka om a capa a ham te, im vat ham pha tih toembael neh a lam uh te a yaak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te dongah camoe pakhat a khue tih tekah hno aka om te a dawt.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te long te anih taengah, ‘Na mana te ha pawk coeng. Te dongah na pa loh vaito puetsuet te a ngawn tih anih te sading la a doe,’ a ti nah.”
  </para>
  <para style="p">
    <verse number="28" style="v" />“Te dongah kosi a hong tih kun ham ngaih pawh. Tedae a napa tah cet tih anih te a hloep.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae a napa te a doo tih, ‘Kum, he yet na taengah sal ka bi tih na olpaek ka poe moenih he. Tedae kai ham tah ka paya neh uum hamla maae pataeng nan paek moenih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae hlanghalh rhoek neh na khosaknah aka yoop na capa tah ha pawk vaengah, vaito puetsuet te anih ham na ngawn pah,’ a ti nah.”
  </para>
  <para style="p">
    <verse number="31" style="v" />“Tedae a napa loh amah te, ‘Camoe aw, nang tah kai taengah rhawp na om tih, kai koe boeih he nang hut coeng ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae uum vaengah khaw omngaih ham a kuek ta. Na mana tah aka duek la om coeng dae ha hing koep, poci coeng dae koep ha phoe,’ a ti,” a ti nah.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hnukbang rhoek te khaw, “Hlang pakhat tah kuirhang la om tih hnokhoem a khueh. Te long te a khuehtawn a haeh pah dongah amah a khotoh nah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te dongah anih te a khue tih, ‘Nang kawng ka yaak he me tlam lae? Na hnokhoemnah dongkah olka te thuung laeh, na khoom ham na coeng voel moenih,’ a ti nah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah hnokhoem amah te, ‘Balae ka saii lah eh? Ka boeipa loh hnokhoemnah he kai lamloh a lat coeng, diklai daeng ham khaw ka noeng pawh, bih ham khaw ka yak,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka saii ham te ka ming coeng. Te daengah ni hnokhoemnah lamkah ka puen uh vaengah a im khuila kai n'doe uh eh,’ a ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah, a boeipa kah purhong rhoek te rhip a khue tih, lamhma taengah, ‘Ka boeipa taengah meyet na ba?’ a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te long te, ‘Situi um yakhat,’ a ti nah. Te vaengah anih te, ‘Na cabu na doe vaengah ngol pahoi lamtah sawmnga mah daek,’ a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pakhat te khaw, ‘Nang tah meyet na ba,’ a ti nah. Te long te, ‘Cang phueih yakhat,’ a ti nah. Anih te, ‘Cabu na doe vaengah sawmrhet la daek,’ a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />A thai a lai neh a saii dongah boethae kah hnokhoem te boeipa loh a koeh. Ta kumhal kah ca rhoek he amah cadil khuiah tah vangnah kah a ca rhoek lakah cueih uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah kai loh nangmih taengah ka thui, Boethae laikhuehtawn te khaw na paya la khueh uh. Te daengah ni dungyan dap khuila na khum vaengah n'doe uh eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A yit dongah uepom la aka om tah a len dongah khaw uepom la om tih, a yit dongah aka halang tah a len dongah khaw halang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Halang, laikhuehtawn neh uepom la na om uh pawt bal atah unim nangmih rhep aka tangnah te?
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah na hlanglang tih uepom la na om pawt atah na koe te u long nangmih m'paek eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Imkhut pakhat loh boei panit kah sal a bi thai moenih, pakhat te a toeng vetih pakhat te a lungnah ni, pakhat te a talong vetih pakhat te a hnoel ni. Pathen neh laikhuehtawn kah sal na bi rhenten thai moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te te naivoei la aka om Pharisee rhoek loh boeih a yaak uh vaengah amah te a nueih thil uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah amih te, “Nangmih loh hlang hmaiah aka tang la na om uh. Tedae Pathen loh nangmih thinko te a ming. Hlang soah aka sang te Pathen hmaiah tueilaehnah la om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Olkhueng neh tonghma rhoek loh Johan hil, te lamkah loh Pathen kah ram tah ana phong coeng tih a khuila la boeih ana ael uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Olkhueng te a dek pakhat a rhul lakah vaan neh diklai a khum te a phoeng la om pueng.
  </para>
  <para style="p">
    <verse number="18" style="v" />A yuu te a tueih tih a tloe aka lo boeih tah samphaih coeng. Te phoeiah va aka ma aka yunah te khaw samphaih.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Hlang pakhat tah kuirhang la om. Te dongah daidi, hnithen neh khuk uh tih hnin takuem thayoei tuipan la a uum.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vaengah khodaeng pakhat, a ming ah Lazarus tah buhlut neh a vongka ah a yalh pah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah kuirhang caboei lamkah aka bo nen te bunghah khaw a nai. Tedae ui rhoek long pataeng ha pawk uh vaengah a buhlut te a laeh pa uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae khodaeng te a duek vaengah puencawn rhoek loh Abraham rhang dongla a khuen. Te phoeiah kuirhang te khaw duek tih a up uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae saelkhui ah a mik a hoh tih nganboh neh kho a sak vaengah tah Abraham neh a rhang dongkah Lazarus te a hla lamkah a hmuh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah a pang neh, ‘A pa Abraham, kai he n'rhen lamtah Lazarus te han tueih mai. A kutdawn kah a hmoicue te tui dongah naek saeh lamtah ka lai he sul sak saeh, hmaitak khuiah mat n'yuek coeng he,’ a ti nah.”
  </para>
  <para style="p">
    <verse number="25" style="v" />“Tedae Abraham loh, ‘Camoe, na hingnah dongkah na hnothen na dang te poek. Te vaengah Lazarus tah yoethae bangla om. Tedae anih a mong vaengah he nang tah patang loh n'yuek coeng.
  </para>
  <para style="p">
    <verse number="26" style="v" />He rhoek boeih khuiah khaw kaimih neh nangmih laklo kah longhoi tah muep n'lak coeng. Te dongah nangmih taengla hlaikan dingdoeng aka ngaih long khaw coeng pawh, kaimih taengla hlaikan dingdoeng ham khaw coeng pawh,’ a ti nah.”
  </para>
  <para style="p">
    <verse number="27" style="v" />“Te phoeiah, ‘A pa namah ni kan hloep. Te dongah anih te a pa im la tueih mai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Manuca panga ka khueh dongah amih te uen mai saeh. Te daengah ni amih khaw hekah nganboh hmuen la ha pawk uh pawt eh,’ a ti nah.”
  </para>
  <para style="p">
    <verse number="29" style="v" />“Tedae Abraham loh, ‘Moses neh tonghma te a khueh uh ta, amih taengah hnatun uh saeh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tedae te long te, ‘Moenih, a pa Abraham, aka duek tangtae pakhat loh amih te paan koinih yut uh ni,’ a ti nah.”
  </para>
  <para style="p">
    <verse number="31" style="v" />“Tedae anih te, ‘Moses neh tonghma rhoek kah olthui te a hnatun uh pawt atah, duek khui lamkah khat khat thoo cakhaw ngaitang mahpawh,’ a ti nah,” a ti.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah a hnukbang rhoek te, “Thangkui te a thoeng pawt ham om tloel coeng. Tedae anunae anih lamloh aka thoeng sak aih.
  </para>
  <para style="p">
    <verse number="2" style="v" />He camoe rhoek khuikah pakhat a khah ham lakah tah a rhawn ah lungto phaklung a oi tih tuili la voei koinih anih ham hoeikhang lah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Namamih te ngaithuen uh, na manuca loh a tholh atah amah te toel, a yut atah anih te hlah laeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hnin at neh nang soah voei rhih tholh coeng dae namah taengla voei rhih ha bal tih, ‘Ka yut,’ a ti coeng atah anih te hlah laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Caeltueih rhoek loh Boeipa taengah, “Kaimih ham tangnah han thap lah,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae Boeipa loh, “Tangnah he mukang mu tet na khueh uh koinih, hekah thaihae kung he, ‘Phong uh lamtah tuili ah phung,’ na ti uh mai cakhaw nangmih kah te a ngai ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangmih khuiah sal aka khueh te tah lai a thol pah tih boiva a dawn pah. Lohma lamkah a paipaek vaengah anih te u long, ‘Ha kun lamtah cawt ngol dae,’ a ti na eh?
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih te, ‘Mebang khaw tawn lamtah ka ca eh, te phoeiah cihnin vaep lamtah ka caak ka ok vaengah kai taengah thotat, te phoeiah ni na caak na ok eh,’ ti na mahpawt nim?
  </para>
  <para style="p">
    <verse number="9" style="v" />A uen te a saii dongah sal soah lungvatnah khueh mapawt nim?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmih khaw, nangmih ng'uen te boeih na saii uh tangloeng dae, ‘Kaimih tah sal hlangkhue hlangvaih rhoek ni, saii ham a kuek te ni n'saii,’ ti uh mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jerusalem la a caeh a om vaengah Jesuh tah Samaria neh Galilee laklo longah cet.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah vangca pakhat la a kun hatah hmaibae hlang parha loh Jesuh te a doe uh tih amamih tah soei pai uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah a ol a huel uh tih, “Boeipa Jesuh kaimih n'rhen lah,” a ti uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih te a hmuh vaengah, “Cet uh lamtah namamih te khosoih rhoek taengah tueng uh,” a ti nah. Tedae a caeh uh li vaengah mah amih te boeih cim uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae amih khuikah pakhat long tah a hoeih te a hmuh vaengah bal tih ol ue la Pathen te a thangpom.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah anih tah Samaria dae ni a kho kung ah maelhmai a buluk thil tih Jesuh te a uem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te dongah Jesuh loh a doo tih, “Parha la a cim uh moenih a? Pako rhoek ta melae?
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih kholong hlang pawt atah Pathen te thangpomnah paek ham aka bal hmu uh boel saeh a?” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah anih te, “Thoo, cet laeh, namah kah tangnah loh namah ng'khang coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathen kah ram ha pawk vaengkah te Pharisee rhoek loh a dawt dongah amih te a doo tih, “Pathen kah ram tah hmuhnah neh ha pawk moenih.
  </para>
  <para style="p">
    <verse number="21" style="v" />‘He la he, ke la ke,’ ti uh mahpawh. Pathen kah ram tah namamih khuiah ni a om te,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah hnukbang rhoek te, “Khohnin ha pawk vaengah hlang capa kah khohnin te hnin at hmuh ham na hue uh suidae na hmuh uh mahpawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangmih taengah, ‘Ke la ke, he la he,’ a ti uh akhaw cet uh boeh, hnuktlak uh boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khophaa loh phaa tih vaan hmui pakhat lamkah loh vaan hmui pakhat la sae ni. Hlang capa tah amah tue vaengah ha om tangloeng bitni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae lamhma la muep a patang ham neh tahae cadil loh a hnawt ham khaw a kuek.
  </para>
  <para style="p">
    <verse number="26" style="v" />Noah tue vaengkah a om vanbangla, hlang capa kah a tue vaengah khaw om van ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Noah lawng khuila a kun khohnin duela yuloh rhaihlan neh a caak a ok uh. Te dongah tuilii ha pawk vaengah boeih poci.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lot kah khohnin vaengah khaw amah boeiloeih la om uh tih a caak uh‍, a ok uh‍, a lai uh‍, a yoih uh‍, a tawn uh‍, a sak uh‍.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae Sodom lamkah loh Lot a caeh khohnin ah, vaan lamkah hmai neh kat a tlan pah tih boeih poci.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hlang capa a pumphoe tue vaengah amah boeiloeih la om ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te khohnin vaengah imphu ah aka om tah, im khuikah a hno te loh hamla suntla boel saeh. Lohma kah long khaw a hnuk la mael van boel saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lot yuu te poek uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />A hinglu te kutloh ham aka toem long tah poci ni, tedae aka hlong long tah tekah a hing thil ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangmih taengah ka thui, tekah khoyin ah panit loh thingkong pakhat dongah om rhoi cakhaw, pakhat te a khuen vetih pakhat te a hlun ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amah nawn ah sum aka kuelh panit om ni. Pakhat te a khuen vetih, pakhat a hlun ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah amah te a doo uh tih, “Melae Boeipa,” a ti na uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae amih te, “Rhok te tah langta loh pahoi a bo van ni,” a ti nah.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thangthui yoeyah ham neh thathae pawt ham a kuek soah amih te nuettahnah neh a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Kho pakhat ah laitloekkung pakhat om tih Pathen taengah birhih pawt tih hlang taengah a yahnah om pawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah kho khuiah aka om nuhmai loh anih te a paan tih, ‘Ka kocaelh hmaiah kai n'tang sak,’ a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae te khohnin ham ngaih pawh. Te phoeiah amah te, ‘Pathen taengah ka birhih pawt tih hlang te ka yahnah mai ngawn pawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te akhaw he nuhmai he kamah thakthaenah la n'toeh dongah anih ka tang sak eh. Te daengah ni a bawtnah la pawk vetih kai n'ngae pawt eh,’ a ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Boeipa loh, “Laitloekkung loh a boethae kah a cal te ya uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A taengah khoyin khothaih aka pang, a coelh hlang kah kutthungnah te Pathen loh a saii mueh moenih. Te dongah amih taengah a thinsen a?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangmih taengah ka thui te, amih kah kutthungnah te thamaa la a saii ni ta. Tedae hlang capa ha pawk vaengah tangnah he diklai hmanah a hmuh venim?” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />A dueng la om ham amah neh amah pangtung tih a tloe aka hnaelcoe hlangvang rhoek te khaw hekah nuettahnah neh,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Hlang panit tah thangthui ham bawkim la cet rhoi. Pakhat tah Pharisee tih pakhat te mangmu aka coi ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharisee tah amah la pai tih, ‘Hlang tloe kutveet aka khueh, halang rhoek, samphaih rhoek, neh he kah mangmucoi bangla ka om pawt dongah Pathen nang he kan uem,
  </para>
  <para style="p">
    <verse number="12" style="v" />Sabbath te hnavoei ka yaeh, ka kaelh boeih te parha pakhat la vawpvawp ka paek,’ tila thangthui.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae mangmucoi tah soei pai tih mik pataeng vaan la a dai ngaih pawh. A lungkoe te a tum tih, ‘Pathen aw, ka tholh he han dawth lah,’ a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangmih taengah ka thui, anih he pakhat lakah aka tang ngai la a im te a paan. Te dongah amah neh amah aka pomsang boeih tah a tlarhoel sak ni. Tedae amah neh amah aka yalh tah a pomsang ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah cahni rhoek te taek van saeh tila amah taengla a bawnhlak uh. Tedae hnukbang rhoek loh a hmuh vaengah amih te a tlung uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae Jesuh loh amih a khue tih, “Camoe rhoek te kamah taengla ha pawk ham han hlah uh, amih te kang uh boeh. Amih ham ni Pathen kah ram a om.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmih taengah rhep ka thui, Pathen kah ram te camoe bangla aka doe pawt long tah a khuiah kun loengloeng mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesuh te boei pakhat loh a dawt tih, “Saya then, mebang ka saii nen lae dungyan hingnah ka pang eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah anih te Jesuh loh, “Balae tih kai he then na ti? Pathen amah bueng pawt atah aka then a om moenih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Olpaek rhoek te na ming coeng, samphaih boeh, hlang ngawn boeh, huen boeh, laithae boeh, na pa neh na nu te hinyah,” a ti nah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae te long te, “Te rhoek te ka camoe lamkah loh boeih ka tuem coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />A yaak vaengah Jesuh loh anih te, “Pakhat na vawt pueng. Na khueh sarhui te boeih yoi lamtah khodaeng rhoek ham tael pah. Te daengah ni vaan ah khohrhang na khueh eh. Te phoeiah kai taengah pahoi ha bang,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae anih te kuirhang la muep a om dongah te ol te ngang a yaak vaengah sut om.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngang a yaak te Jesuh loh a hmuh vaengah, “Tangka aka khueh rhoek loh Pathen kah ram khuila a kun ham tah bahoeng kuel mai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuirhang te Pathen ram khuiah a kun lakah phamet khui ah kalauk a kun te a phoeng la om,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aka ya rhoek loh, “Te koinih unim aka daem thai ve?” a ti uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae Jesuh loh, “Hlang loh a tloel nah te Pathen taengah tah yoeikoek la om mai,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah Peter loh, “Amah kah imlo aka toeng kaimih long tah namah kam vai uh he,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Jesuh loh amih te, “Nangmih taengah rhep ka thui, Pathen kah ram ham im khaw, yuu khaw, manuca khaw, manu napa khaw, a ca khaw aka toeng te a om moenih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih tah tahae tue vaengah a pawklaih neh kumhal ah dungyan hingnah aka thoeng te dang mueh pawt suidae? a ti nah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hlainit te a khuen tih amih taengah, “Jerusalem la cet uh sih ne, tonghma rhoek loh a daek hlang capa kawng te boeih soep pawn ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Namtom rhoek taengah a voeih vetih a tamdaeng ni, a neet ni, a timthoih ni,
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih te a boh uh vetih a ngawn uh ni, tedae a thum hnin ah koep thoo ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae amih loh te te a hmuhming uh moenih. Hekah oltak long he amih taeng lamloh a thuh uh pueng dongah a thui te yakming uh pawh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jerikho te a pha tom vaengah mikdael pakhat loh long taengah ngol tih a bih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hlangping kah a pah te a yaak vaengah, “Balae aka om he,” a ti.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te vaengah Nazareth Jesuh a pah te a taengla a puen pa uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te dongah pang tih, “David Capa, Jesuh, kai n'rhen lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te vaengah aka lamhma rhoek loh anih te kamkhuem sak ham a ho uh. Tedae anih te muep lat pang tih, “David capa kai ng'rhen lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Te dongah Jesuh tah pai tih, anih te amah taengla mawt hamla ol a paek. A yoei uh vaengah Jesuh loh mikdael amah te a dawt.
  </para>
  <para style="p">
    <verse number="41" style="v" />“Nang ham na ngaih te balae kan saii eh,” a ti nah. Te vaengah mikdael loh, “Boeipa, hmuh ham,” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesuh loh anih te, “Tueng saeh, namah kah tangnah loh nang n'khang,” a ti nah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te vaengah pahoi a hmuh dongah Jesuh hnuk a vai doeah Pathen te a thangpom. Pilnam boeih long khaw a hmuh vaengah Pathen te thangthennah a paek.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerikho te a kun thil tih a hil.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah hlang pakhat, a ming ah Zakkhaeus la a khue te lawt om. Anih tah mangmu boei neh kuirhang la om.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih long khaw Jesuh te hmuh hamla a toem. Tedae a pumrho he merheh la a om dongah hlangping te aep thai pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae a khum ham te a om coeng dongah a hmai la a khal tih amah hmuh ham thaibah dongla yoeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tekah hmuen la a pha vaengah Jesuh tah oeloe tih anih te, “Zakkhaeus, a loe la rhum, tihnin ah nang im ah ka naeh ham a kuek,” a ti nah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te dongah suntla tok tih Jesuh a doe te omngaih coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Boeih a hmuh uh vaengah cai uh tih, “Hlang tholh taengah pah hamla kun,” a ti uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pai neh Zakkhaeus loh Boeipa taengah, “Boeipa, Ka khuehtawn he rhakthuem he khodaeng rhoek ka paek. Hlang khat khat kah hno khat khat ni ka rhawt pah bal atah rhaepli la ka thuung coeng he,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah anih te Jesuh loh, “Anih tah Abraham capa la a om van dongah tihnin ah tah khangnah loh he imkhui la pai coeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlang Capa ha pawk he aka poci te toem ham neh khang ham rhoe pai ni,” a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jerusalem a pha tom vaengah a yaak neh Pathen kah ram a tueng hamla cai tomlael coeng tila a poek dongah nuettahnah pakhat te a thap tih a thui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah, “Tongpa hlangtang pakhat tah, a ram loh ham kho hla la cet tih ha voei hamla cai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah a sal hlangrha te a khue tih mina lungrha te amih taengah a paek. Te phoeiah amih te, ‘Amah ka pawk hil thenpom uh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae a pilnam rhoek loh anih te a hmuhuet uh. Te dongah amah hnukah laipai tloep a tueih uh tih, ‘Kaimih soah a manghai ham he ka ngaih uh moenih,’ a ti na uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ram te a loh tih amah ha mael vaengah tah tangka a paek a sal rhoek te amah taengla a khue tih metla a thenpom uh khaw ming hamla a dawt.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te vaengah aka pawk lamhma loh, ‘Boeipa, nang kah mina pakhat te mina parha ka kum thil,’ a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te vaengah anih te, ‘Then, sal then a yit dongah uepom la na om tih, kho parha soah saithainah aka khueh la om laeh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aka pawk pabae long khaw, ‘Nang kah, mina loh mina panga a sak boeipa,’ a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih khaw, ‘Nang loh kho panga om thil van,’ a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te phoeiah pakhat loh ha pawk tih, ‘Boeipa, nang kah mina tah himbaica khuiah ka khueh tih ka tung he.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dikkhih dikkhaeh hlang la na om dongah namah khaw kang rhih. Na khueh pawt te na phueih tih na tuh pawt te na ah,’ a ti nah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih te tah, ‘Na ka lamkah vanbangla nang taengah ol ka tloek ni, sal thae aw, kai he dikkhih dikkhaeh hlang la ka om te na ming coeng. Ka khueh pawt te ka poh tih ka tuh pawt te ka ah het a?
  </para>
  <para style="p">
    <verse number="23" style="v" />Te vaengah balae tih ka tangka te caboei dongla na tloeng pawh. Kai ka pawk vaengah a casai neh ka dang kolo mako,’ a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah aka pai rhoek te, ‘Anih taengkah mina te lo uh lamtah mina lungrha aka khueh te pae uh,’ a ti nah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah anih te, ‘Boeipa, mina parha a khueh ta,’ a ti na uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmih taengah ka thui, Aka khueh boeih te a paek thil vetih, aka khueh pawt tah a khueh te khaw a loh pahni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae amih soah kai manghai sak ham aka ngaih pawh ka rhal rhoek te pahoi hang khuen uh lamtah ka hmaiah ngawn uh,’ a ti nah,” te a thui pah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te te a thui phoeiah a hmai la cet tih Jerusalem la luei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Olives tlang a ti uh taengkah Bethphage neh Bethany te vat a pha vaengah hnukbang panit te a tueih tih,
  </para>
  <para style="p">
    <verse number="30" style="v" />“Rhaldan kah kho la cet rhoi, a khuila na kun rhoi vaengah laakca a pael te na hmuh rhoi ni. Te soah hlang ngol noek pawt dae hlam lamtah hang khuen rhoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />khat loh nangmih rhoi te, ‘Ba ham lae na hlam?’ tila n'dawt atah, ‘Boeipa loh a ngoe,’ ti nah,” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah a tueih rhoi loh a caeh rhoi vaengah a ti nah bangla a hmuh rhoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />laak ca te a hlam rhoi vaengah a boei loh amih rhoi te, “Balae tih laak ca te na hlam rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te rhoi long khaw, “Boeipa loh a ngoe,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te te Jesuh taengla a khuen rhoi. Te phoeiah laak ca te a himbai neh a khuk uh tih Jesuh te a soah a ngol sak uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />A caeh vaengah a himbai te long ah a phaih uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Olives tlang kah singling te a pha tom vaengah a thaomnah te hnukbang rhaengpuei loh pahoi boeih a hmuh uh. Te boeih nen te omngaih uh tih Pathen te ol neh rhuprhup a thangthen uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Boeipa ming neh aka pawk manghai tah a yoethen, vaan ah ngaimongnah, thangpomnah tah a sangkoek ah om saeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te dongah hlangping lamkah Pharisee hlangvang loh amah te, “Saya, na hnukbang rhoek te toel lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tedae a doo tih, “Nangmih taengah ka thui, amih paa uh koinih lungto rhoek loh pang uh ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Khopuei te a tueng tom vaengah a rhah thil.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Tahae kah ngaimongnah he nang long khaw tihnin ah na ming koinih, tedae na mikhmuh lamloh a thuh coeng.
  </para>
  <para style="p">
    <verse number="43" style="v" />Khohnin loh nang taengla ha pawk vetih na rhal rhoek loh nang te vaam n'too thil ni. Te vaengah nang te n'dum vetih voeivang ah nang te ng'et ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te phoeiah namah neh na khuikah na ca rhoek te a hnaa uh ni. Namamih kah hiphoelnah tue te na ming pawt yueng, na khuikah lungto sokah lungto pakhat pataeng hmaai uh mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Bawkim la a kun neh hno aka yoi rhoek te a vai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Amih te, “‘Ka im tah thangthuinah im la om ni,’ tila a daek coeng dae nangmih loh dingca rhoek kah khuirhung la na saii uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="47" style="v" />Te phoeiah hnin takuem bawkim khuiah om tih a thuituen. Tedae khosoihham rhoek, cadaek rhoek neh pilnam kah a congkhang long tah anih te poci sak ham a mae uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tedae pilnam loh Jesuh te a hmaitoh tih boeih a hnatun dongah metla a saii uh ham khaw ming uh pawh.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hnin at ah bawkim khuikah pilnam te a thuituen tih olthangthen a phong vaengah khosoihham rhoek, cadaek rhoek neh patong rhoek loh a pai thil uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah anih te a voek uh tih, “Mebang saithainah nen lae na saii he kaimih taengah thui lah? He saithainah he nang aka paek om nim?” a ti na uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah amih te a doo tih, “Nangmih te ol pakhat kan dawt saeh lamtah kai n'doo uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan kah baptisma tah vaan lamkah a, hlang lamkah a om?” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amih long khaw amamih te poek uh tih, “Vaan lamkah n'ti uh koinih, ‘Balae tih anih te na tangnah uh pawh,’ a ti veh.
  </para>
  <para style="p">
    <verse number="6" style="v" />‘Hlang lamkah loh,’ n'ti bal nim te pilnam pum loh mamih he n'dae veh,” a ti uh. Johan te tonghma aka om la ana pang uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah, “Me lamkah nim, ka ming pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Jesuh loh amih te, “Kai loh mebang saithainah neh ka saii khaw nangmih taengah ka thui mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah pilnam taengah hekah nuettahnah he a tong tih, “Hlang pakhat loh dum a tue tih lotawn a phaam sak. Te phoeiah amah te kum a sen puet vik yiin.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tue vaengah tah dum kah a thaih te amah taengah ham pae uh saeh tila sal pakhat te lotawn rhoek taengla a tueih. Tedae lotawn rhoek loh anih te a boh uh tih a tling la a tueih uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah sal a tloe a rhaep la a tueih bal. Tedae anih a boh uh tih yah a bai phoeiah a tling la a tueih uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pathum nen khaw a rhaep tih a tueih dae te khaw hmalaem la a haek uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah dum boei loh, ‘Balae ka saii eh? Ka capa thintlo he ka tueih eh, anih tah a yahnah uh khaming,’ a ti.”
  </para>
  <para style="p">
    <verse number="14" style="v" />“Tedae anih te lotawn rhoek loh a hmuh uh vaengah khat neh khat dawtlet uh thae tih, ‘Rhopangkung tah anih coeng ni, anih he ngawn uh sih, te vaengah rho te mamih ham om saeh,’ a ti uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah anih te a vai uh tih dum voelah a ngawn uh. Te vaengah dum boei loh amih te metlam a saii eh?
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae amih lotawn rhoek te a paan vetih a poci sak ni, dum te khaw a tloe taengla a paek ni,” a ti nah. A yaak uh vaengah, “A coeng moenih,” a ti uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae Jesuh loh amih te a sawt tih, “A daek tangtae he balae aka om bal pueng. Im aka sa rhoek loh a hnawt lungto te, imkil a soi la pawk ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tekah lungto aka tlak thil boeih te tah tlawt uh vetih, amah a tlak thil atah amah te tip ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te dongah cadaek rhoek neh khosoihham rhoek long tah amah vaengah Jesuh te kut hlah thil ham a mae uh. He nuettahnah he amih a thui thil te a ming uh ngawn dae pilnam te khaw koek a rhih uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih aka dawn rhoek te a huep la a tueih uh tih amamih te a dueng la om ham sa uh. Te vaengah a ol tuuk pah ham, Jesuh te boeilu neh khoboei kah saithainah dongah voeih hamla cai uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te dongah Jesuh te a dawt uh tih, “Saya, nang loh buelh buelh na thui tih na thuituen dongah maelhmai na dan pawt te ka ming uh. Tedae Pathen kah oltak longpuei ah ni na thuituen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaisar taengah mangmu paek he mamih ham thuem a, thuem pawt a?” a ti na uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae amih kah rhaithinah te a hmat dongah amamih te,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Denari pakhat te kai n'tueng uh lah, u kah muei neh ming lae aka om,” a ti nah hatah, “Kaisar kah,” a ti uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah Jesuh loh amih te, “Kaisar koe te Kaisar taengla, Pathen koe te Pathen taengla mael uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae pilnam hmaiah anih ol tuuk pah ham coeng uh voel pawh. A ollannah te khaw a ngaihmang uh tih a kam a khuem uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thohkoepnah om pawh tila boe aka koek Sadducee hlangvang long khaw a paan uh tih a dawt uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te vaengah, “Saya, Moses loh kaimih ham a daek coeng, pakhat te a maya loh yuu a khueh tih a duek vaengah cakol la a om atah a yuu te a mana loh lo saeh lamtah a maya ham a tiingan thoh pah saeh,’ a ti.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah boeinaphung parhih lo uh tih, lamhma loh yuu a loh dae cakol la duek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah a pabae neh a pathum loh huta te a loh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vanbangla a parhih long khaw camoe om mueh la a caehtak tih duek bal.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hnukkhueng ah huta te khaw duek.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thohkoepnah dongah huta te u kah yuu lam lae a om eh? Parhih loh anih te yuu la a khueh uh tih,” a ti na uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah amih te Jesuh loh, “Ta kumhal kah camoe rhoek loh yuloh rhaihlan neh om uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kumhal kah te dang ham neh duek lamkah loh thohkoepnah dongkah aka tiing rhoek long tah yuu a loh va a sak uh moenih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Vaan puencawn la a om uh dongah koep duek ham khaw om pawh. Pathen kah a ca la om uh tih thohkoepnah kah a ca la poeh uh bal.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae aka duek rhoek a thoh te Moses loh tangpuem taengah ana phoe pataeng coeng. Te vanbangla Boeipa te Abraham Pathen, Isaak Pathen neh Jakob Pathen ana ti coeng.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae aka duek rhoek kah pawt tih aka hing rhoek kah Pathen ni, anih dongah ni boeih a hing uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cadaek hlangvang rhoek loh a doo tih, “Saya, buelh na thui coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amah te dawt ham ngaingaih uh voel pawh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Jesuh loh amih te, “Metlamlae Khrih te, ‘David capa ni,’ a ti uh?
  </para>
  <para style="p">
    <verse number="42" style="v" />David amah loh Tingtoeng cabu dongah a thui tah, ‘Boeipa loh ka boeipa taengah,
  </para>
  <para style="p">
    <verse number="43" style="v" />“Na rhal te na kho ham khotloeng la ka khueh hlan atah kai kah bantang ah ngol dae,” a ti,’
  </para>
  <para style="p">
    <verse number="44" style="v" />David loh anih te Boeipa la a khue atah metlamlae a capa la a om eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Pilnam boeih kah a yaak ah a hnukbang rhoek te,
  </para>
  <para style="p">
    <verse number="46" style="v" />“Cadaek rhoek te ngaithuen uh, hnikul neh pongpa aka ngaih uh tih hnoyoih hmuen kah toidalnah, tunim ah ngolhmuen then, buhkung kah hmuensang a lungnah uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Amih loh nuhmai rhoek kah im te a yoop pa uh tih mueituengnah ham khing thangthui uh. He rhoek long ni laitloeknah muep a yook eh,” a ti nah.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />A dan vaengah kuirhang rhoek kah a kutdoe tangkabu khuila a sang uh te a hmuh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah khodaeng nuhmai pakhat loh mucih panit a sang te a hmuh bal.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah, “Nangmih taengah rhep kan thui, hekah nuhmai khodaeng loh amih boeih lakah muep a sang coeng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amih tah amamih kah a coih te kutdoe la boeih a sang uh. Anih long tah a vawtthoeknah khui lamkah a khosaknah ham a khueh te boeih a sang coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawkim te lungto khaw then tih nawnnah neh a thoeihcam coeng bet a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Hekah he na hmuh uh dae khohnin ha pawk ni. Te vaengah a phil pawt te lungto pakhat dongah lungto pakhat khaw hmaai mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amah te a dawt uh tih, “Saya, te koinih te te me vaengah lae a om eh? Miknoek loh a om tom vaengah balae aka om eh?” a ti na uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Jesuh loh. “Ng'rhaithi pawt ham hmat uh. Ka ming neh muep ha pawk uh vetih, ‘Kai coeng ni, a tue loh yoei coeng,’ ti uh cakhaw amih hnukah cet uh boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Caem neh soekloeknah na yaak uh vaengah let uh boeh. Te te lamhma la a om ham ngawn a kuek. Tedae a bawtnah long tah pha koeloe mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah amih te, “Namtu loh namtu, ram loh ram a thoh thil ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lingluei puei neh khokha loh hmuen tom ah tlung vetih duektahaw khaw pul ni. Mueirhih neh vaan lamkah miknoek long khaw mat ha thoeng ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae te hlan ah te hlang boeih kah a kut te nangmih pum dongla a hlah uh vetih n'hnaemtaek uh ni. Tunim neh thongim la n'thak uh ni. Kai ming kongah manghai tom neh khoboei tom taengla ng'khuen uh ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangmih ham laipai la poeh bitni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te dongah na thinko khuiah khueh uh lamtah huul uh ham khaw tawn boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai loh olka neh cueihnah te nangmih kam paek bitni. Te te nangmih aka kingkalh rhoek boeih loh a kamkaih ham neh a oelh ham coeng thai mahpawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmih te manu napa, manuca rhoek, huiko neh paya laikoi long khaw m'voeih uh vetih n'duek sak ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai ming kongah hlang boeih kah a hmuhuet la na om uh ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae na lu sokah sampin pataeng poci loengloeng mahpawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Namamih kah uehnah nen ni na hinglu te na kaelh uh eh.”
  </para>
  <para style="p">
    <verse number="20" style="v" />“Caem loh Jerusalem a vael uh te na hmuh uh vaengah, anih kah mitmoengnah loh yoei coeng tite ming uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah Judea kah rhoek loh tlang la rhaelrham uh saeh. A laklung kah rhoek long khaw coe uh saeh. Tekah kho kah rhoek khaw a khuila kun boel saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah a daek tangtae te boeih soep sak ham ni te rhoek kah kutthungnah khohnin tah a om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anunae bungvawn la aka om neh te khohnin kah cacun rhoek aih. Diklai hmankah a kueknah a len neh he pilnam taengah kosi la om bitni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah cunghang ha dongah cungku uh vetih namtom boeih taengah a sol uh ni. Namtom rhoek kah a tue a soep duela Jerusalem khaw namtom kah a til ham ni a om eh.”
  </para>
  <para style="p">
    <verse number="25" style="v" />“Te vaengah tah miknoek boeih loh khomik, hla neh aisi dongah om uh ni. Tuipuei kah olhum neh tuiphu kah ngaihitnah dongah namtom rhoek kah ngaisaknah te diklai ah om ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lunglai ah aka thoeng rhihnah neh lamsonah dongah hlang he sut hit uh ni. Vaan kah thaomnah long khaw hinghuen uh ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah khomai dongah thaomnah neh thangpomnah a len neh aka pawk hlang capa te a hmuh uh ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih kah tlannah tah a yoei coeng dongah, aka om ham te a moe vaengah pai uh lamtah na lu dangrhoek uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah amih ham nuettahnah neh, “Thaibu neh thing boeih ke na hmuh uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tahae kah aka boe te aka hmuh rhoek long tah namah neh namah te, khohal vat a pha coeng tila na ming uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vanbangla nangmih long khaw he he ha thoeng tih na hmuh uh vaengah Pathen kah ram tah pai tom coeng tila ming uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangmih taengah rhep ka thui, boeih a thoeng hlan atah tahae kah cadil loh a khum mueh la om mahpawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Vaan neh diklai tah khum ni, tedae kai ol khum loengloeng mahpawh.”
  </para>
  <para style="p">
    <verse number="34" style="v" />“Te dongah namamih te ngaithuen uh lukilnah, rhuihahnah, khosak rhamsak kah mawntangnah dongah na thinko loh n'nan ve. Tekah khohnin loh nangmih soah buengrhuet ha pai ve.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thaang bangla diklai maelhmai tom ah aka ngol rhoek boeih te a thoeng thil ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae aka thangthui rhoek loh a tue cungkuem dongah hak uh. Te daengah ni om la aka cai boeih he poenghal ham neh, hlang capa hmaiah pai ham na noeng uh eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Khothaih puet bawkim ah om tih a thuituen dae khoyin ah tah Olive a ti uh tlang soah cet tih rhaeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah pilnam boeih loh anih ol yaak ham bawkim khuikah amah taengla ana yue uh coeng.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yoom a ti uh vaidamding khotue tah yoei coeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah khosoihham rhoek neh cadaek rhoek loh pilnam te loei a rhih uh dongah Jesuh metla ng'ngawn eh tila a mae uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah Satan loh hlainit khuikah hlangmi pakhat la aka om Iskariot a ti uh Judas te a kun thil.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah cet tih amih taengla Jesuh metla a voeih ham khaw khosoihham rhoek neh imtawt boei rhoek te a voek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah a uem uh tih anih te tangka paek ham a kotluep uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ko a tluep puei tih, amih hlangping kah mikvoelh ah Jesuh voeih ham a tuethen te a dawn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vaidamding khohnin tah a pha coeng. Te vaengah yoom te ngawn ham a kuek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah Peter neh Johan te a tueih tih, “Cet rhoi lamtah mamih kah yoom n'caak ham te rhoekbah rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amih rhoi long khaw amah taengah, “Melam saii ham na ngaih?” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesuh loh amih rhoi te, “Khopuei la na kun rhoi vaengah, tuitang dongah tui aka phuei hlang pakhat loh nangmih rhoi te n'doe ni. Anih loh a kun thil im duela anih te vai rhoi ne.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah im kungmah te, ‘Nang taengah saya loh, “Yinpanah tah melam a om, te ah te ka hnukbang rhoek te Yoom ka caak puei mai eh,” a ti,’ ti nah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loh imhman aka ka te a khoem tangtae la nangmih rhoi n'tueng bitni, te ah te rhoekbah rhoi,” a ti nah.
  </para>
  <para style="p">
    <verse number="13" style="v" />A caeh rhoi vaengah a ti nah bangla a hmuh rhoi tih Yoom te a rhoekbah rhoi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A tue loh a pha vaengah, amah taengkah caeltueih rhoek te a ngol puei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah amih te, “Ka patang hlanah nangmih neh Yoom caak ham he thincavat la ka hue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmih taengah kan thui, Pathen kah ram ah a soep hlan atah he he ka ca voel mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Boengloeng te a loh tih a uem phoeiah, “He he lo uh lamtah namamih te tael uh thae.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangmih taengah ka thui, tahae lamloh Pathen ram a pai hlan khuiah misur thaih te ka o voel mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vaidam te a loh tih a uem phoeiah a aeh tih amih te a paek. Te vaengah, “He tah nangmih hamla ka paek ka pum ni. Kai poekkoepnah neh he he saii uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te vanbangla boengloeng te khaw a vael uh tih, “He boengloeng tah ka thii dongkah paipi thai ni, te tah nangmih ham long coeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae caboei dongah kamah aka om puei kah a kut loh kamah m'voeih coeng he.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlang Capa tah a hmoel tangtae bangla cet pai dae, anih dongah hlang aka voei hlang te tah anunae,” a ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah te bang saii hamla aka caii te amih lakli ah u lam nim a pawk ve tila amamih khuiah koe oelh uh thae.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah amih khuiah tanglue la om ham aka koih te unim tila, amamih khuiah tuituknah khaw om.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae amih taengah Jesuh loh, “Namtom manghai rhoek loh amih a tulnoi uh tih a buem rhapsat te hlangrhoei rhoek la a khue uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae nangmih tah te tlam moenih, nangmih khuiah aka tanglue loh a noe bangla om saeh, hlang aka mawt long khaw aka thotat la om saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah aka vael neh aka thothat khuiah ulae aka tanglue? Aka vael te moenih a? Tedae kai tah nangmih lakli ah aka thotat lam ni ka om.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmih tah kai kah cuekhalhnah khuikah he kai neh aka tukkai la na om uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ram te a pa loh kai taengah a hal bangla nangmih taengah kai loh kang hal coeng.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te daengah ni ka ram kah ka caboei dongah na caak na ok uh eh. Te vaengah Israel kah lai aka tloek koca hlainit te ngolkhoel soah na ngol thil uh ni.”
  </para>
  <para style="p">
    <verse number="31" style="v" />“Simon, Simon, Satan loh cang bangla hlaih ham nangmih n'laem coeng te.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kai tah nang kah tangnah te a muei pawt ham ni nang ham ka thangthui. Tedae na bal vaengah na manuca rhoek te duel nawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae Simon loh, “Boeipa, namah nen tah thongim neh duek paan ham khaw sikim la ka om ngawn,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesuh loh, “Peter, namah taengah kan thui, kai hmat hamla voeithum na huek uh hlan atah tihnin ah ai khong mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te phoeiah amih te, “Sungkoi, sungsa neh khokhom khuen kolla nangmih kan tueih vaengah pakhat khaw na hlavawt uh pawt nim?” a ti nah. Te vaengah amih loh, “Om pawh,” a ti uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te phoeiah amih te, “Tedae tahae atah, sungkoi aka khueh loh khuen saeh, sungsa khaw khuen saeh. Aka khueh pawt loh a himbai te yoi saeh lamtah cunghang lai saeh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nangmih ham kan thui, a daek tangtae te kai soah a soep ham a kuek. ‘Anih te lailak rhoek neh a tae thil,’ a ti, kai kawng loh hmakhah a pha,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te vaengah amih loh, “Boeipa, cunghang yungnit om he,” a ti na uh. Te dongah Jesuh loh amih te, “Rhoeh coeng te,” a ti nah.
  </para>
  <para style="p">
    <verse number="39" style="v" />A khosing vanbangla cet tih Olive tlang te a paan. Te vaengah hnukbang rhoek long khaw anih te a vai uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />A hmuen a pha vaengah amih te, “Cuekhalhnah khuiah kun pawt ham thangthui uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah Jesuh tah amih taeng lamloh lungto dongat tluk ah khoe uh tih, khuklu cungkueng neh thangthui.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te vaengah, “A pa, na ngaih atah boengloeng he, kai taeng lamkah loh khoe mai. Tedae kai kongaih boel saeh lamtah namah kongaih la om saeh,” a ti.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te vaengah vaan lamkah puencawn te a taengah phoe tih anih te thaa a cong pah.
  </para>
  <para style="p">
    <verse number="44" style="v" />A thangthui te khaw thingthuelnah la mat a om pah. A hlantui khaw a thii cip bangla a om pah tih diklai la a bo pah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Thangthuinah lamloh thoo tih hnukbang rhoek taengla a pawk vaengah a kothaenah lamloh a ih uh te a hmuh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te dongah amih te, “Balae tih na ih uh? Thoo uh lamtah thangthui uh, te daengah ni cuekhalhnah khuila na kun uh pawt eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="47" style="v" />A thui vaengah hlangping tarha ha pawk. Te vaengah hlainit khuikah pakhat Judas a ti long te amih hmaiah a lamhma pah tih Jesuh te mok hamla a paan.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tedae Jesuh loh amah te, “Judas, moknah mai neh hlang capa te na voeih nama?” a ti nah.
  </para>
  <para style="p">
    <verse number="49" style="v" />A taengkah rhoek loh a hmuh uh vaengah aka om ham te, “Boeipa, cunghang neh ka boeng uh koinih ta,” a ti na uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te dongah amih khuikah pakhat loh khosoihham kah sal te a boeng tih a bantang hna a pat pah.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tedae Jesuh loh a doo tih, “Te te hlah laeh,” a ti nah. Te phoeiah a hna te a taek pah tih a hoeih sak.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te phoeiah Jesuh loh amah taengla aka pawk khosoihham rhoek neh bawkim kah imtawt boei rhoek, patong rhoek taengah, “Dingca a, cunghang neh thingboeng neh na caeh thil uh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Hnin takuem bawkim khuiah nangmih taengah ka om tih kai soah kut na thueng uh moenih. Tedae tahae tue neh yinnah kah saithainah tah nangmih ah om,” a ti nah.
  </para>
  <para style="p">
    <verse number="54" style="v" />Jesuh te a tuuk uh phoeiah a mawt uh tih khosoihham im khuila a khuen uh. Tedae Peter long tah soeisoei a vai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Te vaengah imtol kah a laklung ah hmai a toih uh tih a ngoltun uh hatah Peter khaw amih lakli ah ngol van.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tedae hmaivang ah aka ngol salnu pakhat loh anih a hmuh vaengah a hmaitang tih, “He khaw he anih taengah om,” a ti nah.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tedae Peter loh basa tih, “Anih, ka ming moenih, huta,” a ti nah.
  </para>
  <para style="p">
    <verse number="58" style="v" />Rhaih a om phoeiah pakhat loh anih te hmuh tih, “Nang khaw amih taengah na om van,” a ti nah. Tedae Peter loh, “Hlang khaw he, kai ka om moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="59" style="v" />Khonoek pakhat tluk a koe phoeiah a tloe pakhat loh, “Oltak ni, he khaw anih taengah om ta, amah khaw Galilee hlang ni,” rhap a ti nah.
  </para>
  <para style="p">
    <verse number="60" style="v" />Tedae Peter loh, “Hlang khaw he, banim na thui ka ming moenih,” a ti nah. Te tlam te a thui li vaengah ai pahoi khong.
  </para>
  <para style="p">
    <verse number="61" style="v" />Te vaengah Peter te Boeipa loh a mael thil tih a sawt. Te daengah, “Tihnin kah ai a khong hlanah kai voeithum nan huek uh tak ni,” a ti nah vaengkah Boeipa ol te Peter loh a thoelh.
  </para>
  <para style="p">
    <verse number="62" style="v" />Te dongah phawn cet tih hlawk hlawk rhap.
  </para>
  <para style="p">
    <verse number="63" style="v" />Jesuh te hlang rhoek loh a et uh phoeiah a tamdaeng uh tih a boh uh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Amah te a khuk uh tih a dawt uh vaengah, “Nang aka bael te unim phong lah,” a ti na uh.
  </para>
  <para style="p">
    <verse number="65" style="v" />A tloe nen khaw muep a salpham uh tih anih te a voek uh.
  </para>
  <para style="p">
    <verse number="66" style="v" />Khothaih a pha vaengah pilnam kah kangham rhoek, khosoihham rhoek neh cadaek rhoek te tingtun uh. Te phoeiah Jesuh te amamih kah khoboei taengla a khuen uh.
  </para>
  <para style="p">
    <verse number="67" style="v" />Te vaengah, “Khrih la na om atah kaimih taengah thui laeh,” a ti na uh. Tedae amih te, “Nangmih taengah kan thui cakhaw na tangnah uh loengloeng mahpawh.
  </para>
  <para style="p">
    <verse number="68" style="v" />Kan dawt bal cakhaw nan doo uh loengloeng mahpawh.
  </para>
  <para style="p">
    <verse number="69" style="v" />Tahae lamkah hlang capa tah Pathen kah thaomnah bantang ah aka ngol la om pueng ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="70" style="v" />Tedae hlang boeih loh, “Nang tah Pathen capa la na om van a?” a ti na uh. Te dongah Jesuh loh amih te, “Ka om te na thui uh coeng,” a ti nah.
  </para>
  <para style="p">
    <verse number="71" style="v" />Te vaengah amih loh, “Laipai a ngoe pueng a te? A ka lamkah te mamih loh n'yaak uh coeng,” a ti uh.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amih te rhaengpuei la huek pai uh tih Jesuh te Pilat taengla a khuen uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Jesuh te pahoi a paelnaeh uh tih, “Anih loh mah namtu he a pamdah sak, Kaisar taengah mangmu paek ham te a paa sak tih amah te, ‘Khrih manghai ni,’ a ti khaw ka hmuh,” a ti uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Pilat loh a dawt tih, “Nang he Judah manghai la na om a?” a ti nah. Tedae Jesuh loh anih te a doo tih, “Nang long ni na ti,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah Pilat loh khosoihham rhoek neh hlangping rhoek te, “Hekah hlang soah a lolh ka hmuh moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae amih loh a mangkhak la, “Pilnam a hueh tih, Galilee lamloh he hil, Judah tom ah pahoi a thuituen,” a ti uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pilat loh a yaak vaengah, “Hekah hlang tah Galilee hoel la om maco,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te daengah Herod kah saithainah dongah aka om la a ming tih Herod taengla a tueih. Te vaeng tue ah Herod khaw Jerusalem ah om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Herod loh Jesuh te a hmuh vaengah bahoeng omngaih. Hlamat kum lamkah a kawng a yaak coeng dongah amah hmuh ham te ngaihlih ana om coeng. Te dongah anih loh a saii miknoek khat khat te hmuh hamla a ngaiuep.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Jesuh te ol muep a dawt. Tedae Jesuh loh anih te a doo moenih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah khosoihham rhoek neh cadaek rhoek loh pai uh tih Jesuh te rhaprhap a paelnaeh uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Herod neh a rhalkap rhoek long khaw Jesuh te a hnaelcoe uh tih a tamdaeng uh. Te phoeiah himbai a cim thik a bai sak tih Pilat taengla a tueih uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te khohnin kuelhuelh ah Herod neh Pilat loh khat neh khat paya la coeng rhoi. A noek ah amih rhoi te thunkha la om rhoi dae ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Pilat loh khosoihham rhoek, boei rhoek neh pilnam te a hueh tih,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Hekah hlang he kai taengah pilnam aka palet bangla nang khuen uh. Kai loh nangmih hmaiah ka boelh het coeng dae a lolh la anih na paelnaeh uh thil te hekah hlang soah ka hmuh moenih he.
  </para>
  <para style="p">
    <verse number="15" style="v" />Herod long khaw a hmuh pawt dongah ni anih he mamih taengla han tueih. A saii te dueknah neh aka tiing a om moenih he.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah anih he ueih sak lamtah ka hlah eh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khotue ah amih ham hlang pakhat tah a loeih sak ham manghkhak la a kuek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae huek pang uh tih, “Anih he khuen laeh, Barabbas mah kaimih ham han hlah,” a ti uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Barabbas tah khopuei ah olpungnah bet a om vaengah ngawnnah a saii dongah thongim khuila a hlak uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesuh te hlah a ngaih dongah Pilat loh amih te koep a khue.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae amih loh a o uh tih, “Anih te tai laeh, tai laeh,” a ti uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae Pilat loh amih te, “He loh boethae balae a saii tih, dueknah ham koila anih soah a lolh ka hmuh moenih. Anih he ueih sak lamtah ka hlah tangloeng eh,” voeithum a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae a lalh uh coeng dongah Jesuh tai ham te ol ue la a hoe uh tih amih ol loh boeih a khumla uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pilat long khaw amih kah bihhoenah te rhoirhi ham ko a tam.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah a hoe uh vanbangla olpungnah neh ngawnnah dongah thongim khuila a det tangtae te a hlah. Tedae Jesuh te amih kongaih bangla a voeih pah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih te a khuen uh vaengah Kurena Simon te lohma lamkah ha pawk hatah a tuuk uh tih Jesuh hnukah koh pah ham thinglam te a tloeng pa uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te vaengah anih te pilnam rheangpuei neh anih aka rhaengsae tih aka hlai huta rhoek loh muep a vai uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amih te Jesuh loh a mael thil tih, “Jerusalem nu rhoek, kai hamla rhap uh boeh. Namamih ham neh na ca rhoek ham mah rhap uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />‘Cayaa, camoe aka cun pawh bung, aka khut pawh rhang suk loh a yoethen,’ a ti uh tue tah ha pawk coeng he.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah tlang taengah, ‘Kaimih n'tim thil laeh,’ mol taengah khaw, ‘Kaimih m'vuei laeh,’ pahoi a ti uh ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thing te a thingsup pataeng te tlam te a saii uh atah a koh vaengah metlam a om eh?” a ti nah.
  </para>
  <para style="p">
    <verse number="32" style="v" />A tloe laihmuh panit te khaw anih taengah ngawn ham a khuen uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lurhuh a ti uh hmuen te a pha uh vaengah Jesuh neh laihmuh rhoi te pahoi a tai uh. Laihmu rhoi khuiah pakhat te bantang ben ah pakhat banvoei ben ah a tai uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te vaengah Jesuh loh, “A pa, amih he tholh hlah mai, a saii uh he khaw a ming uh moenih,” a ti. Te phoeiah a himbai te a phen uh tih hmulung a naan thil uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah pilnam loh pai tih a sawt. Boei rhoek long khaw a nueih thil tih, “Hlang tloe aka khang te amah khaw khang uh saeh. Anih he Pathen kah a coelh Khrih la a om atah,” a ti uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih te rhalkap rhoek long khaw a tamdaeng uh tih a paan uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih te yuthui a paek uh tih, “Nang he Judah rhoek kah manghai la na om atah namah khang uh saw,” a ti nah.
  </para>
  <para style="p">
    <verse number="38" style="v" />A sokah a ming khaw, ‘Judah rhoek kah manghai tah anih ni’ tila a om pah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te vaengah laihmu rhoi a hoei uh khuikah pakhat loh anih te a soehsal tih, “Nang he Khrih la na om mahnim? Namah khaw kaimih rhoi khaw ng'khang lah,” a ti nah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tedae pakhat loh anih te a doo tih a ho. Te vaengah, “Nang tah Pathen ke na rhih moenih a? Laitloeknah khuiah na om boeiloeih dae.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mamih rhoi ngawn tah mah khoboe te n'yook tueng tih tiktam coeng. Tedae anih tah a halang la a saii moenih,” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te phoeiah Jesuh te, “Na ram khuiah na pawk vaengah kai m'poek ne,” a ti nah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah anih te, “Namah taengah rhep kan thui, tihnin ah paradai ah kai taengah na om pawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Khonoek parhuk tluk a pha vaengah diklai pum ah yinnah loh a thing tih khonoek pako hil Khomik khaw hmuep.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te vaengah bawkim kah hniyan loh phak phin uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jesuh tah ol ue la pang tih, “A pa, na kut dongah ka mueihla kan paek,” a ti nah. Te a thui neh pahoi pat.
  </para>
  <para style="p">
    <verse number="47" style="v" />Aka om hno te rhalboei loh a hmuh vaengah Pathen te a thangpom tih, “Hekah hlang tah hlang dueng la om taktak,” a ti.
  </para>
  <para style="p">
    <verse number="48" style="v" />A miklaw kah hlangping aka taai uh boeih loh aka om hno te a hmuh uh vaengah a lungkoe te a tum uh tih bal uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te vaengah khohla lamkah a huiko khaw boeih ha pai uh. Galilee lamloh a taengah aka bang huta rhoek long khaw a hmuh uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te vaengah hlang pakhat, a ming ah Joseph tah khoboei la tapkhoeh om. Anih tah hlang then neh hlang dueng la om.
  </para>
  <para style="p">
    <verse number="51" style="v" />Anih tah Judah khopuei pakhat Arimathea lamkah tih amih kah mangtaengnah neh khoboe dongah tlangnaem tlangphai la om pawh. Anih long tah Pathen kah ram ni a lamtawn.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te long te Pilat a paan tih Jesuh kah rhok te a bih.
  </para>
  <para style="p">
    <verse number="53" style="v" />Rhok te a hlak tih himbai neh a yen. Te phoeiah rhok te phuel lung khuiah a khueh. Tekah phuel ah aka yalh om hlan.
  </para>
  <para style="p">
    <verse number="54" style="v" />Tedae khohnin tah rhuengphong la om tih Sabbath tom coeng.
  </para>
  <para style="p">
    <verse number="55" style="v" />Te vaengah huta rhoek loh a hloem uh. Amih tah Galilee lamkah loh Jesuh aka puei la om uh tih phuel neh a rhok metla a khueh te a hmuh uh.
  </para>
  <para style="p">
    <verse number="56" style="v" />A bal uh vaengah bo-ul neh botui te a hmoel uh. Tedae Sabbath vaengah tah olpaek vanbangla duem uh.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath poeng kah a cuek hnin mincang hi ah bo-ul a hmoel te a khuen uh tih phuel la cet uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tedae phuel lamkah lungto vik a paluet te a hmuh uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kun uh vaengah tah Boeipa Jesuh pum te hmu uh pawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />He kawng dongah amamih te ingang la a om vaengah hlang panit te himbai leklek a phaa la tarha a pai pa uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amih khaw lakueng ngaiha neh om uh tih diklai la a maelhmai a buluk uh. Te vaengah amih te, “Balae tih aka hing te aka duek taengah na toem uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />He ah a om moenih thoo coeng. Galilee ah a om vaengah nangmih taengah a thui te poek uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Hlang capa he hlang tholh kut ah a voeih vetih a tai ni, a thum hnin ah a thoh ham a kuek,’ a ti ta,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ol te a poek uh van dongah,
  </para>
  <para style="p">
    <verse number="9" style="v" />phuel lamloh bal uh tih hlaiat taeng neh a tloe rhoek boeih taengah puen uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Magadala Mary, Joanna, Jakob manu Mary khaw om. Te phoeiah amih taengkah a tloe rhoek long khaw caeltueih rhoek taengah a thui pa uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae amih taengah tah cil ol bangla a om pah dongah a hnalval tak uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Peter tah thoo tih phuel la yong. Te phoeiah a sawt thuk hatah himbai bueng te a hmuh. Te dongah amah khaw aka om hno dongah ngaihmang la khoe uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amah tekah khohnin ah Jerusalem lamkah phalong sawmrhuk aka hla, a ming ah Emmaus vangca la khoem aka cet rhoi te om.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amih rhoi loh te rhoek kah aka thoeng hno boeih te khat neh khat taengah a thui rhoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A thui rhoi tih a oelh uh rhoi vaengah Jesuh amah long khaw a paan tih amih rhoi te a puei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae anih te a hmat pawt ham a mik a buem pah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah amih rhoi te, “Aka cet paitai loh khat neh khat taengah na saep rhoi te mebang olka nim he,” a ti nah hatah a hmueprhut la pai rhoi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah Kleopas aka ming nah loh anih te a doo tih, “Namah loh Jerusalem te na kuepkol thil dae tihnin kah a khuiah aka om te na ming mahnim?” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah amih rhoi te, “Aba e te?” a ti nah. Te rhoi van loh amah te, “Nazareth Jesuh kawng ca, anih tah tonghma pa la om, a khoboe neh a ol khaw Pathen neh pilnam boeih taengah a thaom.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih te mamih kah khosoihham rhoek neh boei rhoek loh dueknah neh laitloek thil ham a voeih uh tih a tai uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae Israel tlan ham aka cai tah anih ni tila kaimih loh ka ngaiuep uh. Te boeih te khaw a poeng tih, tahae kah hno a om lamloh a thum hnin pataeng a pha coeng he.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kamamih khuikah huta hlangvang long khaw kaimih n'limlum sak uh. Phuel ah yue om uh coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae a pum te hmu uh mueh la ha pawk uh. Puencawn rhoek kah mangthui a hmuh te khaw a thui uh. Amah a hing te amih loh a thui uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah kaimih taengkah hlangvang tah phuel la cet uh. Te vaengah huta rhoek loh a thui bangla a hmuh uh van tangloeng tih amah te tah hmu uh pawh,” a ti nah rhoi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah amah loh amih rhoi te, “Hlangang rhoi aw, na thinko a rhihnun cukduk la, tonghma rhoek loh a thui te boeih tangnah rhoi saw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khrih te a patang phoeiah a thangpomnah khuila a kun te a kuek moenih a?” a ti nah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Moses lamkah a tong tih tonghma rhoek boeih neh cacim boeih khuiah khaw amah kawng te amih ham a thuicaih pah coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vangca te vat a pha uh vaengah amah tah voelh cet la sa uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tedae amah te a hloh rhoi tih, “Kaimih rhoi taengah rhaeh mai, hlaem a pha tih khohnin khaw khum coeng,” a ti nah. Te dongah amih rhoi taengah rhaeh hamla kun.
  </para>
  <para style="p">
    <verse number="30" style="v" />A tue a pha tih amih rhoi taengah a ngol puei. Vaidam te a loh tih a uem phoeiah a aeh tih amih rhoi te a paek.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te vaengah a mik tah a tueng pah rhoi tih amah te a hmat rhoi. Tedae amah tah amih rhoi taeng lamloh vova a hma pah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te daengah khat neh khat te, “Mamih rhoi kah thinko tah a ung moenih a? Longpueng ah mamih ham a thui bangla mamih rhoi taengah om pai, cacim he mamih rhoi khuiah puk pai,” a ti rhoi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te dongah amah tekah a tue ah thoo rhoi tih Jerusalem la bal rhoi. Te vaengah hlaikhat rhoek neh a taengkah rhoek ana tingtun uh te a hmuh rhoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Boeipa tah thoo rhep tih Simon taengla a phoe te ana thui uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amih rhoi long khaw longpueng kah te a thui rhoi tih vaidam a aehnah nen te amih a ming sak.
  </para>
  <para style="p">
    <verse number="36" style="v" />A thui uh li vaengah amah te amih lakli ah a pai pah tih amih te, “Nangmih taengah ngaimongnah om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae let uh tih mueihla aka hmuh bangla a poek uh dongah lakueng ngaiha la om uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te phoeiah amih te, “Balae tih na thuen neh na om uh, poeknah te balae tih na thinko ah a phul?
  </para>
  <para style="p">
    <verse number="39" style="v" />Kai kamah ni tite ka kut rhoi neh ka kho rhoi he so uh. Kai he n'phathuep uh lamtah m'ming uh, mueihla loh a saa neh a rhuh a khueh moenih, nam hmuh uh vanbangla kai ka khueh he,” a ti nah.
  </para>
  <para style="p">
    <verse number="40" style="v" />He he a thui phoeiah a kut rhoi neh a kho rhoi te amih a tueng.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tedae omngaihnah lamloh a hnalval uh pueng tih a ngaihmang uh dongah amih te, “Caakkoi khat khaw na khueh uh a he?” a ti nah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amih loh amah te nga phoeng kaekvang a paek uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te dongah a doe tih amih hmaiah a caak pah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te phoeiah amih te, “Nangmih taengah ka om vaengah nangmih ham ka thui ka ol tah he ni. Moses kah olkhueng neh tonghma rhoek, tingtoeng dongah khaw kai kawng a daek te boeih a soep ham a kuek ta,” a ti nah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te daengah cacim hmuhming ham te a lungbuei puk uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te dongah amih te, “Khrih a patang ham neh a thum hnin ah duek lamkah a thoh ham khaw,
  </para>
  <para style="p">
    <verse number="47" style="v" />Jerusalem lamkah loh tong uh lamtah namtom boeih taengah tholh khodawkngainah ham yutnah te amah ming neh hoe ham a daek tangloeng coeng.
  </para>
  <para style="p">
    <verse number="48" style="v" />Nangmih tah he rhoek kah laipai rhoek ni.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kai loh nangmih taengah a pa kah olkhueh te kan tueih coeng he. Tedae nangmih tah a sang lamkah thaomnah na bai uh hlan atah kho khuiah ana ngol uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Amih te Bethany duela voelh a khuen phoeiah a kut a phuel tih amih te yoethen a paek.
  </para>
  <para style="p">
    <verse number="51" style="v" />Amih yoethen a paek nen tah amih taeng lamloh khoe uh tih vaan la a khuen.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te vaengah amih loh amah te a bawk uh tih Jerusalem ah omngaihnah neh muep bal uh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Te phoeiah bawkim khuiah om taitu uh tih Pathen te a uem uh.
  </para>
</usx>
