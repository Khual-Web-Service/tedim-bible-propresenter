<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LEV" style="id">Thothueng</book>
  <para style="h">Thothueng</para>
  <para style="toc1">Thothueng</para>
  <para style="toc2">Thothueng</para>
  <para style="mt">Thothueng</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a khue tih tingtunnah dap lamkah a voek vaengah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek lamtah amih te thui pah., 'Nangmih khuikah hlang. loh BOEIPA taengah nawnnah a khuen vaengah rhamsa, saelhung, boiva khui lamkah khaw namamih kah nawnnah la khuen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nawnnah ham hmueihhlutnah te saelhung mai koinih a tal aka cuem te tingtunnah dap thohka ah nawn saeh lamtah BOEIPA mikhmuh ah a kolonah ham nawn saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah hmueihhlutnah kah a lu soah a kut tloeng saeh lamtah anih ham a dawth te doe saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA mikhmuh ah saelhung ca te ngawn saeh lamtah khosoih Aaron ca rhoek loh a thii te khuen saeh. Te vaengah thii te tingtunnah dap thohka kah hmueihtuk so neh a kaepvai ah haeh uh saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmueihhlutnah te hlaih saeh lamtah maehpoel la tloek saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aaron koca khosoih rhoek loh hmueihtuk ah hmai toih uh saeh lamtah hmai soah thing hueng uh saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Maehpoel, a lu, neh a tha te hmueihtuk sokah thing toih hmai soah Aaron koca khosoih rhoek loh tloeng uh saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kotak neh a kho te tui neh sil saeh lamtah khosoih. loh BOEIPA taengah hmuehmuei botui hmueihhlutnah hmaihlutnah la hmueihtuk ah boeih phum saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae anih kah nawnnah te boiva khui lamkah koinih hmueihhlutnah ham tah tu khaw, maae tal aka cuem te khuen saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tekah te BOEIPA mikhmuh kah hmueihtuk kaep kah tlangpuei ben ah ngawn saeh lamtah Aaron koca khosoih rhoek loh a thii te hmueihtuk so neh a kaepvai ah haeh uh saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pum te maehpoel la tloek saeh lamtah a lu neh a tha te khosoih. loh hmueihtuk sokah thing toih hmai dongah tloeng saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae a kotak neh a kho rhoek te tui neh sil saeh. Te phoeiah khosoih loh khuen saeh lamtah BOEIPA taengah hmuehmuei botui hmueihhlutnah hmaihlutnah la hmueihtuk ah boeih phum saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />BOEIPA taengah anih kah nawnnah ham hmueihhlutnah te vaa khui lamkah koinih vahu mai khaw, vahui ca mai khaw amah kah nawnnah ham khuen saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah khosoih. loh hmueihtuk la khuen saeh. A lu te a paimaelh pah phoeiah hmueihtuk ah phum saeh. A thii te hmueihtuk pangbueng dongah ci saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae a tukpoe neh a dii te poelh saeh lamtah hmueihtuk khothoeng kah maehhloi hmuen ah voei saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vaa te a phae let pah saeh lamtah boe boel saeh. Te phoeiah khosoih. loh BOEIPA taengah hmuehmuei botui hmueihhlutnah hmaihlutnah la hmueihtuk sokah thing toih hmai dongah phum saeh.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlinglu. loh BOEIPA taengla khocang a khuen vaengah vaidam te anih kah nawnnah la om saeh. Te vaengah vaidam te situi suep saeh lamtah hmueihtui te a soah phul saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te phoeiah Aaron koca khosoih rhoek taengla khuen saeh. Vaidam te kutvang ah mawk paco saeh lamtah situi hmueihtui boeih neh BOEIPA ham hmueihtuk kah hmaihlutnah soah khosoih. loh kamhoeinah hmuehmuei botui la phum saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khocang khui lamkah a coih te tah Aaron ham neh anih koca rhoek ham om tih BOEIPA kah hmaihlutnah khuiah aka cim khuikah aka cim koek la om.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmaiulh dongkah cangrhoh khocang nawnnah na khuen atah vaidam, situi a piit vaidamding vaidam laep mai khaw, situi neh a koelh vaidamding te vaidam rhawmla om saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang kah nawnnah khocang te thiphael dongkah koinih vaidam te situi neh thoek lamtah vaidamding la om saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Buhkam te aek lamtah a khocang la a soah situi suep thil.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae nang kah nawnnah khocang te thi-am dongkah koinih vaidam te situi neh saii saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te rhoek khui lamkah a saii khocang te BOEIPA taengla na khuen vaengah khosoih te a kamhoei phoeiah hmueihtuk la thoeih saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khocang khuikah kamhoeinah te khosoih loh ludoeng saeh lamtah hmueihtuk kah hmaihlutnah soah BOEIPA ham hmuehmuei botui la phum saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae khocang kah a coih te Aaron ham neh anih koca rhoek ham om saeh. BOEIPA hmaihlutnah khuiah aka cim khuikah aka cim koek ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />BOEIPA taengah na khuen khocang boeih te tolrhu nuen boel saeh. Tolrhu mai khaw, khoitui mai khaw BOEIPA taengkah hmaihlutnah dongah phum thil boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thaihcuek nawnnah te BOEIPA taengla na khuen vaengah hmueihtuk soah hmuehmuei botui bangla nawn uh boel saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na khocang nawnnah boeih te lungkaeh neh thoek lamtah na Pathen kah lungkaeh moi toeng boeh. Na khocang khui lamkah na nawnnah boeih te lungkaeh nawn thil.
  </para>
  <para style="p">
    <verse number="14" style="v" />BOEIPA taengah thaihcuek khocang na khuen atah a vueilue te hmai neh rhoh lamtah cangthai yenkip te namah kah thaihcuek khocang la nawn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te te situi suep thil lamtah khocang te hmueihtui la tloeng thil.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah yenkip khui lamkah neh situi lamkah kamhoeinah, hmaihlutnah hmueihtui boeih te khosoih. loh BOEIPA taengah phum saeh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anih kah nawnnah tah rhoepnah hmueih te a saelhung khui lamkah a tal mai khaw a la mai khaw a nawn atah BOEIPA mikhmuh ah a cuemthuek te nawn saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah a nawnnah saelhung kah a lu dongah a kut tloeng saeh lamtah tingtunnah dap thohka ah ngawn saeh. Te phoeiah thii te Aaron koca khuikah khosoih rhoek loh hmueihtuk kaepvai ah haeh uh saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rhoepnah hmueih khui lamkah a kotak aka dah maehtha neh a kotak dongkah maehtha boeih te BOEIPA taengah hmaihlutnah hamla khuen saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kuel rhoi neh a uen dongkah a tha khaw, a thin neh a kuel dongkah a thinhnun te khaw rhoe saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Aaron koca rhoek loh hmueihtuk dongah hmueihhlutnah thing hmai soah BOEIPA ham hmuehmuei botui hmaihlutnah la phum uh saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae a nawnnah boiva te BOEIPA taengah rhoepnah hmueih la a nawn atah a tal mai khaw, a la mai khaw a cuemthuek te nawn saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih kah nawnnah te tuca neh a nawn atah BOEIPA kah mikhmuh ah nawn van saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah anih kah nawnnah tu kah a lu soah a kut tloeng saeh lamtah tingtunnah dap hmai ah ngawn saeh. Te phoeiah a thii te Aaron koca rhoek loh hmueihtuk kaepvai ah haeh uh saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah a songrhuh voeivang kah a kawl tha a hmabuet neh, a kotak aka dah a tha khaw, a kotak dongkah a tha boeih khaw hluep saeh lamtah BOEIPA taengah rhoepnah hmaihlutnah hmueih la nawn saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah a kuel rhoi neh a uen dongkah a tha khaw, a thin neh a kuel dongkah a thinhnun te khaw hluep saeh lamtah,
  </para>
  <para style="p">
    <verse number="11" style="v" />BOEIPA taengkah hmaihlutnah buh la hmueihtuk soah khosoih. loh phum saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae anih kah nawnnah te maae mai khaw BOEIPA mikhmuh ah a nawn atah,
  </para>
  <para style="p">
    <verse number="13" style="v" />maae lu soah a kut tloeng saeh lamtah tingtunnah dap hmai ah ngawn saeh. Te phoeiah a thii te Aaron koca rhoek loh hmueihtuk kaepvai ah haeh uh saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah hmaihlutnah nawnnah khui lamkah a kotak aka dah a tha neh a kotak dongkah a tha boeih te BOEIPA taengah nawn saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah a kuel rhoi neh a uen dongkah a tha khaw, a thin neh a kuel dongkah a thinhnun khaw hluep saeh lamtah,
  </para>
  <para style="p">
    <verse number="16" style="v" />a tha boeih te khosoih. loh hmueihtuk kah hmaihlutnah buh soah BOEIPA ham hmuehmuei botui la phum saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tolrhum boeih kah na cadilcahma ham kumhal khosing la aka om, maehtha boeih neh thii boeih tah ca uh boeh.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah BOEIPA. loh Moses a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek lamtah thui pah. Hinglu pakhat loh tohtamaeh ah BOEIPA kah olpaek boeih soah tholh mai ni. A saii tueng pawt khaw a lamkah pakhat khaw a saii mai ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A koelh tangtae khosoih. loh pilnam kah dumlai khuila lai a hmuh atah tekah tholhnah a laihmuh dongah boirhaem la saelhung khuikah vaitotal ca cuemthuek te BOEIPA taengah nawn saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah vaitotal te tingtunnah dap thohka kah BOEIPA mikhmuh la khuen saeh. Te phoeiah a kut te vaito kah a lu soah tloeng saeh lamtah BOEIPA mikhmuh ah vaito te ngawn saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A koelh tangtae khosoih. loh vaito thii te lo saeh lamtah tingtunnah dap khuila khuen saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah khosoih. loh a kutdawn te thii khuila nuem saeh lamtah thii te hmuencim hniyan hmai kah BOEIPA mikhmuh ah voei rhih haeh saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah thii te tingtunnah dap khuikah BOEIPA mikhmuh ah botui bo-ul la hmueihtuk ki dongah khosoih. loh pae saeh. Tedae vaito thii aka coih boeih te tah tingtunnah dap thohka kah hmueihhlutnah hmueihtuk kah khoengim taengah hawk saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Boirhaem vaito tha boeih neh a kotak soah khoep aka dah maehtha te khaw, a kotak dongkah a tha boeih te khaw hluep saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kuel rhoi neh a uen kaep dongkah a tha te khaw, a thin neh a kuel dongkah a thinhnun te khaw hluep saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rhoepnah hmueih vaito kah a tha vanbangla khosoih. loh ludoeng saeh lamtah hmueihhlutnah hmueihtuk dongah phum saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae vaito pho neh a saa boeih khaw, a lu neh a kho rhoek khaw, a kotak neh a aek khaw,
  </para>
  <para style="p">
    <verse number="12" style="v" />vaito pum te rhaehhmuen vongvoel kah maehhloi a lunnah hmuen tlaai la khuen saeh lamtah hoeh saeh. Maehhloi lunnah kah thing hmai dongah hoeh saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Israel rhaengpuei pum. loh palang uh tih hlangping mikhmuh lamkah olka a rhael vaengah BOEIPA olpaek boeih khuikah mai khaw saii pawt koi pakhat te a saii uh atah boe uh coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tholh uh tih a tholhnah te amah loh a ming coeng atah saelhung khuikah vaitotal ca te hlangping. loh boirhaem la khuen uh saeh lamtah tingtunnah dap hmai ah tloeng uh saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah rhaengpuei khuikah patong rhoek loh BOEIPA mikhmuh kah vaito lu soah a kut tloeng uh saeh. Te phoeiah vaito te BOEIPA mikhmuh ah ngawn uh saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah a koelh tangtae khosoih. loh vaito thii te tingtunnah dap khuila khuen saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah khosoih loh a kutdawn te thii khuila nuem saeh lamtah hniyan hmai kah BOEIPA mikhmuh ah voei rhih haeh saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />thii te khaw tingtunnah dap ah BOEIPA mikhmuh kah hmueihtuk ki dongah pae saeh. Tedae thii aka coih te tingtunnah dap thohka kah hmueihhlutnah hmueihtuk kah khoengim taengah hawk saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah maehtha boeih te ludoeng saeh lamtah hmueihtuk dongah phum saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A saii vaengah boirhaem vaito a saii vanbangla rhoepnah vaito te saii saeh. Te daengah ni khosoih loh amih ham a dawth pah vetih amih te khodawk a ngai eh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te phoeiah vaito te rhaehhmuen vongvoel la khuen saeh lamtah lamhma kah hlangping kah boirhaem vaito a hoeh bangla hoeh saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khoboei khaw tholh tih a BOEIPA Pathen kah olpaek khat khat khui lamkah saii pawt koi te tohtamaeh ah a saii vaengah boe coeng.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae tholhnah dongah a tholh te amah loh a ming van neh nawnnah ham maae a tal ca a cuemthuek te khuen saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Maae tal lu soah a kut tloeng saeh. BOEIPA mikhmuh ah hmueihhlutnah a ngawn nah hmuen ah boirhaem te ngawn saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah boirhaem thii te khosoih loh a kutdawn neh lo saeh lamtah hmueihhlutnah hmueihtuk ki dongah pae saeh. Te phoeikah thii te hmueihhlutnah hmueihtuk kah khoengim taengah hawk saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae a tha boeih te rhoepnah hmueih tha bangla hmueihtuk ah phum saeh. Te daengah ni anih kah tholhnah kongah khosoih. loh anih ham a dawth pah vetih khodawk a ngai eh.
  </para>
  <para style="p">
    <verse number="27" style="v" />BOEIPA olpaek dongkah saii pawt koi khat khat te tolrhum pilnam lamkah hinglu pakhat mai. loh tohtamaeh ah a saii tholh tih boe coeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae a tholhnah neh a tholh te amah loh aming atah a tholhnah neh a tholh kongah a nawnnah ham te maae a la ca a cuemthuek te khuen saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah boirhaem lu soah a kut tloeng saeh lamtah hmueihhlutnah hmuen ah boirhaem te ngawn saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah thii te khosoih loh a kutdawn neh lo saeh lamtah hmueihhlutnah hmueihtuk ki dongah pae saeh. Tedae thii kah a coih boeih te hmueihtuk kah khoengim taengah hawk saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A tha boeih te rhoepnah hmueih tha a hluep vanbangla hluep saeh lamtah BOEIPA taengkah hmuehmuei botui la hmueihtuk dongah khosoih loh phum saeh. Te daengah ni anih ham te khosoih loh a dawth pah vetih anih te khodawk a ngai eh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae a nawnnah ham te tuca ni a. khuen atah a la a cuemthuek te boirhaem la khuen saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah boirhaem lu soah a kut tloeng saeh lamtah hmueihhlutnah a ngawn nah hmuen ah boirhaem la ngawn saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te phoeiah boirhaem thii te khosoih loh a kutdawn neh lo saeh lamtah hmueihhlutnah hmueihtuk ki dongah koelh saeh. Te phoeikah thii aka coih boeih te hmueihtuk kah khoengim taengah hawk saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae a tha boeih te rhoepnah hmueih dongkah tuca tha a hluep vanbangla hluep saeh lamtah BOEIPA kah hmaihlutnah hmueihtuk dongah khosoih loh phum saeh. Te daengah ni anih kah tholhnah kongah khosoih loh a dawth pah vetih a tholh te khodawk a ngai eh?,” a ti nah.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hinglu pakhat te tholh tih thaephoeinah ol a yaak. Te vaengah amah te laipai la a om dongah a hmuh tih a ming. Tedae a puen pawt atah anih kathaesainah te phuei saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hinglu pakhat loh rhalawt hno khaw, rhalawt mulhing rhok mai khaw cuem pawh rhamsa rhok mai khaw, rhalawt rhulcai rhok khat khat mai khaw buengrhuet a ben vaengah tah rhalawt la boe mai ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hlang kah a tihnai dongkah khaw, a tihnai boeih dongah khaw a ben mai atah te nen te poeih uh coeng. Te te a phah akhaw a ming akhaw anih boe saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hinglu pakhat loh a cungkuem dongah thaehuet ham neh voelphoeng ham a hmuilai neh khungrhap la a toemngam mai ni. Hlang he olhlo neh a khungrhap coeng dongah te te a phah a khaw a ming akhaw te pakhat dongah anih boe saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae he rhoek khuikah khat nen khaw a boe mai akhaw te kah a tholh te. loh phoe saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah a tholhnah neh a tholh bangla BOEIPA taengah a hmaithennah khuen saeh. Boirhaem la boiva khuikah tu a la mai khaw, maae la ca mai khaw om saeh. Te daengah ni a tholhnah dongah khosoih loh anih ham a dawth pa eh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae boiva kangna khaw a kut loh a na pawt atah a tholh bangla a hmaithennah te vahu phiknit mai khaw, vahui ca phiknit mai khaw, pakhat te boirhaem la, pakhat te hmueihhlutnah la BOEIPA taengah khuen saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah khosoih taengla khuen saeh lamtah boirhaem ham te nawn lamhma saeh. A lu te a rhawn lamloh paimaelh pah saeh lamtah boe boel saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah boirhaem thii te hmueihtuk pangbueng dongah haeh saeh lamtah thii aka coih te boirhaem hmueihtuk kah khoengim taengah ci saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae a pabae te tah laitloeknah vanbangla hmueihhlutnah saii saeh. Te vaengah, a tholhnah neh a tholh dongah khosoih. loh anih ham dawth pah saeh lamtah anih te khodawkngai saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae vahu phiknit mai khaw, vahui ca phiknit mai khaw a kut loh a na pawt oeh atah, a tholh bangla a boirhaem ham nawnnah te vaidam cangnoek parha khuen saeh. Te tah boirhaem la a om dongah a soah situi bueih boel saeh lamtah hmueihtui khaw tloeng thil boel saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah khosoih taengla khuen saeh lamtah kamhoeinah te khosoih loh a kut dongah a bae mawk la paco saeh. Te phoeiah boirhaem te BOEIPA hmueihtuk kah hmaihlutnah soah phum saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te daengah ni te khuikah pakhat nen khaw a tholh vanbangla a tholhnah dongah khosoih loh anih ham a dawth pah vetih anih te khodawk a ngai eh. Tedae khosaa bangla khosoih hamla om saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />BOEIPA. loh Moses a voek tih,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Hinglu pakhat loh tholh tih BOEIPA taengah boekoeknah la boe a koek mai ni. Te vaengah hnokhueh neh kut khoom kawng dongah a imben taengah a basa atah, huencannah neh a imben te a hnaemtaek atah,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmuencim dongah lai a hmuh te a sah phoeiah panga neh thap saeh lamtah khosoih taengla thak saeh. Te daengah ni khosoih loh anih kah hmaithennah ham te tutal neh a dawth pah vetih anih te khodawk a ngai eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hinglu pakhat loh BOEIPA olpaek khat khat khuikah saii pawt koi te pakhat khaw a saii tholh coeng dae a boe te khaw a ming pawt atah amah kathaesainah te phuei van saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah a phu aka ting boiva khuikah tutal a cuemthuek te khosoih taengah hmaithennah la khuen saeh. Te daengah ni anih. loh ming pawt tih tohtamaeh la a taengphael te khosoih loh anih ham a dawth pah vetih anih te khodawk a ngai eh.
  </para>
  <para style="p">
    <verse number="19" style="v" />He tah a boe, a boe vaengah BOEIPA taengkah a saii hmaithennah ni,” a ti nah.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te phoeiah Moses te BOEIPA loh a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hinglu pakhat loh tholh tih BOEIPA taengah boekoeknah la boe a koek mai ni. Te vaengah, hnokhueh neh hnohol kawng dongah a imben taengah a basa atah, huencannah neh amah imben a hnaemtaek atah,
  </para>
  <para style="p">
    <verse number="3" style="v" />hnohma khaw a hmuh lalah basa tih hlang taengkah a saii boeih khuikah pakhat mai neh a honghi la a toemngam dongah tholh mai thai
  </para>
  <para style="p">
    <verse number="4" style="v" />anih laihmu la om vetih a boe coeng dongah a huenkoe a rhawth te khaw, hnaemtaeknah neh a hnaemtaek hno te khaw, anih taengah a hlah hnokhueh te khaw, hnohma a hmuh te khaw, mael saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A honghi neh a toemngam tih a dang boeih te khaw dumlai sahnah khohnin vaengah tah a kungmah te a muel la koep sah saeh. Te te a kungmah ham panga neh thap saeh lamtah pae saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah hmaithennah ham tutal a hmabut te BOEIPA taengah khuen saeh lamtah tekah tutal neh a phu aka tluk boiva te khosoih taengla hmaithennah ham thak saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te daengah ni BOEIPA mikhmuh ah khosoih loh anih ham a dawth pah vetih anih khaw dumlai a saii boeih dong lamloh khodawk a ngai eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="9" style="v" />Aaron neh anih koca rhoek te uen lamtah hmueihhlutnah olkhueng he thui pah. Hmueihtuk sokah hmaikol hmuen ah hmueihhlutnah. loh khoyin puet neh mincang due om saeh lamtah a soah hmueihtuk hmai. loh rhong saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah khosoih. loh amah kah takhlawk himbai te bai saeh lamtah takhlawk hnii te a pum dongah na saeh. Te phoeiah hmueihtuk sokah hmueihhlutnah hmai ah aka tlum maehhloi te kol saeh lamtah hmueihtuk taengah khueh saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah a himbai te pit saeh lamtah himbai a tloe bai saeh. Maehhloi te rhaehhmuen vongvoel kah hmuen saelh la thak saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmueihtuk dongkah hmai te khaw phat rhong saeh lamtah thi boel saeh. Te dongah mincang mincang vaengah khosoih. loh thing toih thil saeh. Te phoeiah hmueihhlutnah te tloeng thil saeh lamtah rhoepnah maehtha soah phum saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmai te hmueihtuk soah phat rhong saeh lamtah thi boel saeh.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Tahae kah he tah Aaron koca rhoek loh BOEIPA mikhmuh kah hmueihtuk hmai la khocang a khuen vaengkah olkhueng ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khocang vaidam te a kutvang neh lo saeh lamtah situi neh hmueihtui boeih te khocang soah khueh saeh. Te phoeiah BOEIPA taengah kamhoeinah hmuehmuei botui la hmueihtuk ah phum saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae a coih te tah Aaron neh anih koca rhoek loh ca uh saeh lamtah a caak vaengah tingtunnah dap vongup kah hmuen cim ah vaidamding neh ca uh saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka hmaihlutnah lamloh amih kah hamsum ka paek te tolrhu neh thong boel saeh. Te tah boirhaem bangla, hmaithennah bangla a cim khuikah a cim koek ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />BOEIPA kah hmaihlutnah lamloh na cadilcahma rhoek ham kumhal buhvae coeng ni. Aaron koca khui lamkah tongpa boeih long tah ca saeh lamtah te te aka ben boeih long tah amah te ciim uh saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="20" style="v" />Tahae kah nawnnah dongah Aaron neh anih koca rhoek loh khocang vaidam, cangnoek parha te a koelh khohnin vaengah BOEIPA taengla khuen uh saeh lamtah mincang ah a ngancawn, hlaem vaengah a ngancawn nawn saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tekah khocang te thiphael dongah situi neh saii saeh. A kae phoeiah a nuei kamat te khuen lamtah BOEIPA taengah hmuehmuei botui la nawn saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah a koelh tangtae khosoih neh amah koca rhoek khuikah a hnukthoi. loh saii saeh. BOEIPA ham kumhal kah buhvae la boeih phum saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae khocang boeih he rhuemtuet la om saeh lamtah khosoih loh ca boel saeh,” a ti nah.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah hmaithennah olkhueng he a cim khuikah a cim koek la om.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmueihhlutnah a ngawn uh hmuen ah hmaithennah te ngawn uh saeh lamtah a thii te hmueihtuk kaepvai ah haeh saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te vaengah a kawl dongkah a tha boeih neh a kotak aka dah maehtha te nawn saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kuel rhoi neh a uen kaep dongkah maehtha khaw, a thin dongkah a thinhnun te khaw a kuel neh rhen hluep saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah hmaithennah te BOEIPA taengkah hmueihtuk sokah hmaihlutnah dongah khosoih. loh phum saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmueihlutnah maeh te khosoih tongpa boeih. loh hmuen cim ah ca uh saeh lamtah a cim khuikah a cim koek la ca saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Boirhaem khaw hmaithennah khaw a olkhueng pakhat la a om dongah dawth ham koi te khosoih hut la om.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah khosoih loh hlang khat khat kah hmueihhlutnah te a nawn pah vaengah a nawn hmueihhlutnah kah a pho khaw khosoih amah hut la om saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tapkhuel dongkah a thong khocang boeih, thi-am dongkah neh thiphael dongkah a saii boeih khaw khocang aka nawn khosoih amah hut la om saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Situi neh a thoek khaw, a kaksap akhaw khocang boeih tah Aaron koca rhoek boeih neh amih boeinaphung ham rhip om saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae tahae kah he tah BOEIPA taengah rhoepnah hmueih a nawn vaengkah olkhueng ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Uemonah ham a nawn atah uemonah hmueih la situi neh a thoek vaidamding vaidam laep khaw, situi neh a koelh vaidamding kah vaidam rhawm khaw, situi neh a thoek tih a kae vaidam laep khaw nawn saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengkah tolrhu buhham vaidam laep te uemonah, rhoepnah hmueih neh nawnnah la nawn saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengkah BOEIPA taengla a nawn, nawnnah boeih khui lamkah pakhat te tah rhoepnah thii aka haeh khosoih kah khocang la om saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rhoepnah dongkah uemonah hmueih saa te tah amah nawnnah hnin ah ca saeh lamtah mincang duela paih boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae olcaeng neh kothoh nawnnah hmueih tah a nawn khohnin vaengah hmueih te ca saeh lamtah a caknoi te a vuen ah ca saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmueih saa khui lamkah a coih te a thum hnin ah hmai neh hoeh saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah kah rhoepnah hmueih saa te a thum hnin dongah a caak la a caak atah anih kah a nawn te doe pah mahpawh. Anih te a nawt a na pawt atah dikyik dikyak la om ni. Te te aka ca hinglu tah amah kathaesainah te amah loh phuei saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rhalawt hno boeih dongah a ben maeh te ca boel saeh lamtah hmai neh hoeh saeh. Tedae aka caih maeh saa boeih tah ca saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hinglu pakhat loh BOEIPA taengkah rhoepnah hmueih saa a caak vaengah amah te amah dongah a ti a hnai a om atah tekah hinglu te a pilnam khui lamloh hnawt saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hinglu te rhalawt cungkuem dongah, hlang kah a tihnai dongah khaw, rhalawt rhamsa dongah khaw, konawhnah boeih dongah a rhalawt te a ben atah. BOEIPA taengkah rhoepnah hmueih saa te a caak atah tekah hinglu te pilnam lamloh hnawt saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Israel ca rhoek te voek lamtah thui pah. Vaito, tu, maae kah a tha boeih ca uh boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah maehrhok tha neh saha tha tah bibi khat khat dongah hnonah mai cakhaw ca rhoe ca uh boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khat khat long ni BOEIPA taengkah hmaihlutnah ham a nawn rhamsa tha te a caak atah, aka ca hinglu te pilnam lamloh hnawt saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na tolrhum boeih ah vaa lamkah khaw, rhamsa lamkah khaw thii boeih te ca uh boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hinglu khat khat. loh thii khat khat ni a. caak atah tekah hinglu te pilnam lamloh hnawt saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="28" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Israel ca rhoek te voek lamtah thui pah. BOEIPA taengah rhoepnah hmueih aka khuen long tah rhoepnah hmueih khui lamkah a nawnnah te BOEIPA taengla pawk puei saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />BOEIPA taengkah hmaihlutnah ham te a kut loh a khuen vaengah a tha neh a rhang te khuen saeh. A rhang te BOEIPA mikhmuh ah thueng hmueih la thueng saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Maehtha te khosoih. loh hmueihtuk soah phum saeh. Tedae a rhang te Aaron ham neh anih koca rhoek hamla om saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te dongah nangmih kah rhoepnah hmueih khui lamkah bantang benkah a laeng te tah khosoih taengah khosaa la pae uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aaron koca rhoek khui lamkah rhoepnah thii neh maehtha aka nawn ham maehvae la bantang laeng te om saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rhoepnah hmueih khuiah thueng hmueih kah a rhang neh a laeng he Israel ca rhoek taeng lamkah khosa la ka loh tih Israel ca rhoek taengkah kumhal maehvae la khosoih Aaron neh anih koca rhoek taengah ka paek coeng.
  </para>
  <para style="p">
    <verse number="35" style="v" />He tah BOEIPA taengah khosoih la a nuen hnin vaengah BOEIPA hmaihlutnah khui lamkah Aaron kah maeham neh anih koca rhoek kah maeham ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih a koelh hnin van vaengah Israel ca rhoek loh khosoih rhoek taengah paek ham koi te tah cadilcahma due kumhal khosing la khueh ham BOEIPA loh a uen coeng.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hekah olkhueng dongkah hmueihhlutnah ham, khosaa ham khaw, boirhaem ham khaw, hmaithennah ham khaw, saboi ham khaw, rhoepnah hmueih ham khaw,
  </para>
  <para style="p">
    <verse number="38" style="v" />BOEIPA. loh Sinai tlang ah Moses a uen vanbangla amah a uen khohnin vaengah Israel ca rhoek amamih kah nawnnah te Sinai khosoek kah BOEIPA taengah a nawn uh.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron neh anih koca rhoek te amah neh himbai khaw, a koelhnah situi, boirhaem ham vaito neh tutal pumnit, vaidamding voh at te hang khuen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah rhaengpuei boeih. loh tingtunnah dap thohka ah tingtun uh saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te dongah BOEIPA kah a uen vanbangla Moses loh a saii tih rhaengpuei. loh tingtunnah dap thohka ah tingtun uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Moses. loh rhaengpuei taengah saii ham koi BOEIPA loh a uen te a thui pah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Moses. loh Aaron neh anih koca rhoek te a pai sak tih tui neh a silh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aaron te angkidung a paek tih lamko a vah sak. Hnikul te a bai sak tih hnisui te a sui pah. Cihin neh a yen phoeiah hnisui khaw a hlin pah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rhangpho te a buen pah vaengah Urim neh Thummim te rhangpho khuiah a det pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />A lu ah lupong a muei sak bal tih BOEIPA. loh Moses a uen vanbangla sui tamlaep neh rhuisam cim te a hmai kah lupong soah a khuem sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah Moses loh a koelhnah situi te a loh tih dungtlungim neh a khuikah aka om boeih te a koelh tih a ciim.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah situi te hmueihtuk soah voei rhih a haeh tih hmueihtuk neh a tubael boeih, baeldung neh hmueihtuk kho te khaw a koelh tih a ciim.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te phoeiah a koelhnah situi te Aaron lu soah a suep tih anih te ciim ham a koelh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah Moses. loh Aaron koca rhoek te a pai sak tih amih te angkidung a bai sak. BOEIPA. loh Moses a uen vanbangla amih te lamko a vah sak tih amih te samkhuem a khuem sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Boirhaem vaito te a khuen vaengah boirhaem vaito lu soah Aaron neh anih koca rhoek loh a kut a tloeng uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vaito te a ngawn phoeiah a thii te Moses loh a khuen tih hmueihtuk ki neh a kaepvai ah a kutdawn neh a koelh. Te phoeiah hmueihtuk te a caih sak tih thii te hmueihtuk kah khoengim taengah a hawk. Te daengah te anih dongah a dawth ham koi te a ciim pah.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kotak dongkah maehtha boeih neh a thin dongkah a thinhnun khaw, a kuel rhoi neh a kuel dongkah a tha khaw a loh bal tih Moses. loh hmueihtuk soah a phum.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae vaito pho neh a saa khaw, a aek khaw Moses taengkah BOEIPA kah a uen vanbangla rhaehhmuen vongvoel kah hmai dongah a hoeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmueihhlutnah tutal te khaw a khuen tih tutal a lu soah Aaron neh anih koca rhoek loh a kut a tloeng thiluh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah a ngawn tih a thii te hmueihtuk so neh a kaepvai ah Moses loh a haeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tu te khaw maehpoel la a sah tih a lu neh maehpoel khaw, a tha khaw Moses loh a phum.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae a kotak neh a kho te tui neh a silh. Te phoeiah BOEIPA. loh Moses a uen vanbangla tutal pum boeih te BOEIPA ham hmuehmuei botui hmaihlutnah la hmueihhlutnah hmueihtuk soah Moses loh a phum.
  </para>
  <para style="p">
    <verse number="22" style="v" />A pabae kah tutal te saboi la a nawn. Te phoeiah tutal kah a lu soah Aaron neh anih koca rhoek loh a kut a tloeng uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tu te a ngawn phoeiah a thii te Moses loh a loh tih Aaron bantang a hnapae neh bantang kut kah kutpuei dongah khaw, bantang kho kah khopuei dongah khaw a koelh pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te phoeiah Moses. loh Aaron koca rhoek te a pai sak tih amih kah bantang hna kah hnapae neh bantang kut kah kutpuei dongah khaw, bantang kho kah khopuei dongah khaw thii te a koelh pah. Te phoeiah thii te hmueihtuk kaepvai ah Moses loh a haeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te phoeiah maehtha neh a kawl khaw, a kotak dongkah a tha boeih neh a thin, a kuel rhoi dongkah a thinhnun neh a tha khaw, bantang ben kah a laeng khaw a loh tih,
  </para>
  <para style="p">
    <verse number="26" style="v" />BOEIPA mikhmuh kah vaidamding kodawn dongkah vaidamding vaidam laep pakhat, situi buh vaidam laep pakhat neh vaidam rhawm pakhat te a loh tih maehtha neh bantang laeng soah a khueh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te phoeiah Aaron kut neh anih koca rhoek kah kut ah boeih a tloeng tih BOEIPA mikhmuh ah thueng hmueih te a thueng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah amih kut dong lamkah saboi te Moses loh a loh tih BOEIPA taengah hmuehmuei botui hmaihlutnah la hmueihtuk sokah hmueihhlutnah dongah saboi te a phum.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te phoeiah a rhang te Moses loh a loh tih BOEIPA mikhmuh ah thueng hmueih la a thueng. Saboi tutal te tah BOEIPA. loh Moses a uen vanbangla Moses amah kah maehvae la a khueh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah Moses loh a koelhnah situi neh hmueihtuk sokah thii te a loh tih Aaron neh anih kah himbai dongah khaw, anih koca rhoek neh anih koca rhoek kah himbai dongah khaw a haeh thil tih Aaron neh a himbai khaw, anih koca rhoek neh, anih koca rhoek kah himbai khaw a ciim pah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te phoeiah Aaron neh anih koca rhoek taengah Moses loh , “Maeh te tingtunnah dap thohka ah thong uh lamtah saboi kodawn dongkah buh te, Aaron neh anih koca rhoek loh ca uh saeh,’ ka ti tih ka uen vanbangla pahoi ca uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tedae maeh neh buhham aka coih te hmai neh hoeh uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah nangmih kah koiyaeh hnin tah na kut dongah hnin rhih cum saeh. Khohnin hnin rhih a cup hil tingtunnah dap thohka lamloh moe uh boeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tihnin ah a saii vanbangla nangmih kah te saii ham neh dawth ham khaw BOEIPA loh ng'uen coeng.
  </para>
  <para style="p">
    <verse number="35" style="v" />Te vaengah khoyin khothaih hnin rhih tah tingtunnah dap thohka ah om uh. BOEIPA kah a kuek te kang uen bangla na tuem uh daengah ni na duek uh pawt eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te dongah BOEIPA. loh Moses kut ah a uen hno boeih te Aaron neh anih koca rhoek loh a saii.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hnin rhet a lo vaengah Moses. loh Aaron, anih koca rhoek neh Israel kah a hamca rhoek te a khue.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Aaron taengah, “Namah ham boirhaem la saelhung khuikah vaito ca neh hmueihhlutnah ham tutal a cuemthuek te lo lamtah BOEIPA mikhmuh ah nawn laeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te phoeiah Israel ca rhoek te voek lamtah, 'Boirhaem la maae ca, hmueihhlutnah ham vaitoca neh tuca kum khat ca a cuemthuek te lo uh,’ ti nah.
  </para>
  <para style="p">
    <verse number="4" style="v" />BOEIPA tah tihnin ah nangmih taengla a phoe ham coeng dongah vaito khaw, tu khaw, situi neh a thoek khocang khaw, BOEIPA mikhmuh ah rhoepnah hmueih la nawn uh laeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Moses kah a uen te tingtunnah dap hmai la a khuen uh. Te phoeiah rhaengpuei boeih. loh mop uh tih BOEIPA mikhmuh ah pai uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah Moses loh, “BOEIPA. loh ol ng'uen he na vai uh daengah ni nangmih taengah BOEIPA kah thangpomnah a tueng eh?,” a ti nah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah Moses. loh Aaron taengah, “Hmueihtuk la halo phai. Namah kah boirhaem neh hmueihhlutnah te saii lamtah namah ham neh pilnam ham dawth pah laeh. Te phoeiah pilnam kah nawnnah te saii pah lamtah BOEIPA a uen vanbangla amih ham khaw dawth pah,” a ti nah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah hmueihtuk te Aaron loh a paan tih amah ham boirhaem la vaitoca te a ngawn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah thii te Aaron koca rhoek loh Aaron taengla a khuen pauh. Te dongah a kutdawn te thii khuila a nuem tih hmueihtuk ki dongah a koelh phoeiah thii te hmueihtuk kah khoengim taengah a bueih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te phoeiah BOEIPA loh Moses taengkah a uen vanbangla boirhaem kah a tha, a kuel neh a thin dongkah a thinhnun te hmueihtuk dongah a phum.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah a saa neh a pho te rhaehhmuen vongvoel ah hmai neh a hoeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmueihhlutnah te a ngawn phoeiah thii te Aaron koca rhoek loh a pom uh tih hmueihtuk kaepvai ah a haeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah hmueihhlutnah te a taengah maehpoel la a pom pa uh tih a lu neh hmueihtuk dongah a phum.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah a kotak neh a kho rhoek te a silh tih hmueihtuk dongkah hmueihhlutnah soah a phum.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah pilnam kah nawnnah te a nawn. Te vaengah pilnam kah boirhaem maae te a loh tih a ngawn phoeiah lamhma kah bangla a hlup pah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah hmueihhlutnah te a khuen tih laitloeknah vanbangla a saii.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah khocang te a khuen tih a kut dongkah a bae neh hmueihtuk sokah mincang hmueihhlutnah dongah a phum thil.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah pilnam kah rhoepnah hmueih la vaitotal neh tutal te a ngawn. thii te Aaron koca rhoek loh a thueng uh tih hmueihtuk kaepvai ah a haeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae vaito neh tu kah a tha khaw, a kawl neh a dakda, a kuel neh a thin dongkah a thinhnun khaw,
  </para>
  <para style="p">
    <verse number="20" style="v" />a rhang dongkah a tha khaw a tloeng uh tih a tha te hmueihtuk dongah a phum.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae a rhang rhoek neh bantang laeng te tah Moses loh a uen vanbangla BOEIPA mikhmuh kah Aaron. loh thueng hmueih la a thueng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te phoeiah Aaron loh a kut te pilnam taengla a phuel tih yoethen a paek. Te daengah boirhaem, hmueihhlutnah neh rhoepnah a saii lamloh suntla thuk.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah Moses neh Aaron. loh tingtunnah dap khuikla kun rhoi. Te dongah ha moe rhoi tih pilnam te yoethen a paek rhoi vaengah BOEIPA kah thangpomnah. loh pilnam cungkuem taengah a tueng pah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah BOEIPA maelhmai lamloh hmai ha thoeng tih hmueihtuk dongkah hmueihhlutnah neh maehtha te a hlawp. Pilnam boeih loh a hmuh vaengah tamhoe uh tih a hmai a buluk uh.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aaron ca rhoi Nadab neh Abihu. loh amah amah baelphaih te a loh rhoi tih hmai soah a tloeng rhoi. Te phoeiah bo-ul te a khueh thil rhoi tih hmai hloeh neh BOEIPA mikhmuh ah a khueh rhoi. Te te amih rhoi taengah a uen dae moenih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah BOEIPA hmai lamkah hmai ha thoeng tih amih rhoi te a hlawp dongah BOEIPA mikhmuh ah duek rhoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah Moses. loh Aaron taengah, “BOEIPA loh, 'Kai neh aka yoei taengah ka ciim uh vetih pilnam boeih kah mikhmuh ah ka thangpom uh ni,’ a ti te a thui coeng he,” a ti nah. Te vaengah Aaron khaw kuemsuem sut.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah Moses loh Aaron kah a napa noe Uzziel ca rhoi Mishael neh Elizaphan te a khue tih, “Halo rhoi lah. Na manuca rhoi he hmuencim hmai lamloh rhaehhmuen vongvoel la kawt uh ,” a ti nah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah Moses kah olpaek vanbangla halo uh tih amih rhoi te a angkidung dongah rhaehhmuen vongvoel la a koh uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te phoeiah Moses loh Aaron, a ca rhoi Eleazar neh Ithamar taengah, “Na lu te lim uh boeh, na himbai khaw phen uh boeh. Te daengah ni a thintoek ah rhaengpuei pum loh na duek uh pawt eh. Tedae Israel imkhui boeih ah BOEIPA loh hmai neh a hoeh na manuca rhoek te tah rhah uh mai saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te dongah tingtunnah dap thohka lamkah moe uh boeh. Na soah BOEIPA kah koelhnah situi dongah na duek uh ve,” a ti nah. Te dongah Moses kah olthui bangla a saii uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />BOEIPA. loh Aaron te a voek tih,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Namah neh namah taengkah na ca rhoek loh tingtunnah dap khuila na kun uh vaengah misurtui khaw, yu khaw o boeh. Te daengah ni na cadilcahma ham khaw kumhal khosing vanbangla na duek uh pawt eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cimcaihnah laklo neh rhongingnah laklo ah, rhalawt laklo neh aka cil laklo ah paekboe ham om,” a ti nah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel ca rhoek thuinuet ham oltlueh cungkuem te khaw BOEIPA. loh amih ham Moses kut ah a thui pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah Moses loh Aaron, Eleazar neh Ithamar koca aka sueng rhoek te, “BOEIPA hmaihlutnah dong lamkah khocang aka coih te lo uh. Tedae te tah a cim kah a cim dongah hmueihtuk taengah vaidamding la ca uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai ng'uen van coeng dongah BOEIPA hmaihlutnah khui lamkah khocang te namah kah buhvae neh namah koca rhoek kah buhvae la hmuen cim ah ca uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae Israel ca rhoek kah rhoepnah hmueih khuiah thueng hmueih kah a rhang neh khosaa kah a laeng tah namah kah maehvae neh, na ca rhoek kah maehvae coeng ni. Na capa rhoek, na canu rhoek neh namah kah hmuen saelh ah ca uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khosaa kah a laeng neh thueng hmueih kah a rhang khaw maehtha hmaihlutnah khaw BOEIPA mikhmuh kah thueng hmueih la thueng ham khuen uh. BOEIPA kah a uen vanbangla namah ham neh na ca rhoek ham kumhal ah maehvae la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah boirhaem maae te Moses loh a tlap a tlap hatah vawl ana hai pauh. Te dongah Aaron koca rhoek khuiah aka sueng Eleazar neh Ithamar taengah a thintoek tih,
  </para>
  <para style="p">
    <verse number="17" style="v" />“A cim kah a cim boirhaem he balae tih hmuencim hmuen ah na caak uh pawh He khaw rhaengpuei kathaesainah aka phuei tih BOEIPA mikhmuh ah amih kah tholh aka dawth hamla nangmih taengah m'paek dae.
  </para>
  <para style="p">
    <verse number="18" style="v" />A thii te hmuencim la a khuen moenih ko he. Kang uen bangla hmuencim ah ca khaw ca uh yap mai saw,” a ti nah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah Aaron loh Moses taengah, “Tihnin ah a boirhaem neh hmueihhlutnah te khaw BOEIPA mikhmuh ah a nawn uh coeng dae tahae kah bangla kai taengah thoeng coeng he. Tihnin ah boirhaem he ka ca koinih BOEIPA mikhmuh ah then aya?,” a ti nah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae Moses loh a yaak vaengah a mikhmuh ah a thuem sak.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses neh Aaron te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek rhoi lamtah, diklai hmankah rhamsa boeih khuiah na caak uh ham mulhing he thui pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rhamsa khuiah a khomae rhak tih a khomae dongkah a khorhaek aka thal neh caknaih aka naih boeih te tah ca uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae caknaih aka naih neh khomae aka rhak khuiah Kalauk he ca uh boeh. Caknaih a naih dae a khomae a rhak pawt dongah nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="5" style="v" />Saphih he khaw caknaih a naih dae a khomae a rhak pawt dongah nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="6" style="v" />Saveh khaw caknaih a naih dae a khomae a rhak pawt dongah nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ok he a khomae rhak tih a khomae dongkah a khorhaek thal dae caknaih a naih pawt dongah nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="8" style="v" />A saa te ca uh boeh. A rhok khaw ben uh boeh. Te rhoek te nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tui dongkah aka om boeih khuiah he ca uh. tui dongkah khaw, tuitunli dongkah khaw, soklong kah khaw a phae neh a lip aka om boeih tah ca uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae tuitunli dongkah khaw, soklong kah khaw, tui dongkah rhulcai boeih neh tui khuikah aka hing hinglu boeih khuiah a phae neh a lip aka om pawt boeih te nangmih ham konawhnah ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih ham konawhnah la a om uh dongah a saa te ca uh boeh. A rhok te khaw tuei uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A phae khaw, a lip khaw a khueh mueh la tui dongah aka om boeih te nangmih ham konawhnah ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vaa khuiah he rhoek tah tuei uh, caak ham moenih. atha khaw, langta khaw, thamuk khaw konawhnah ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />murhung neh maisi hui khaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />vangak neh anih hui boeih,
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuirhuk khaw, kirhoeng, khangkhoe, mutlo neh anih hui boeih,
  </para>
  <para style="p">
    <verse number="17" style="v" />thathawt, tuiliim, saelbu,
  </para>
  <para style="p">
    <verse number="18" style="v" />abuu, khosoek saelbu, tamcu,
  </para>
  <para style="p">
    <verse number="19" style="v" />bungrho, kaikoi neh anih hui, thongpanai neh pumphak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vaa bangla om tih a kho pali neh aka yuel rhulcai boeih khaw nangmih ham konawhnah ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae vaa bangla om tih a kho pali neh yuel cakhaw diklai dongah cungpet nah ham a kho phoeiah a kho aka khueh rhulcai boeih tah ca uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaisih neh a hui, tangboeng neh a hui khaw, tungrhit neh a hui khaw, tangku neh anih hui khaw ca uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae vaa bangla om tih a kho pali aka khueh rhulcai boeih tah nangmih ham konawhnah ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />A rhok aka ben boeih tah te nen te na poeih uh ni. Amih te kholaeh duela a poeih ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />A rhok aka phuei boeih long khaw a himbai te til saeh. Anih te kholaeh duela poeih uh ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rhamsa boeih khaw a khomae rhak tih a khorhaek aka thal pawt neh caknaih aka naih pawt tah nangmih ham rhalawt. Te te aka ben boeih tah poeih uh ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A kho pali neh aka yuel mulhing boeih khuiah a kut neh aka yuel boeih khaw nangmih ham rhalawt. A rhok aka ben boeih tah kholaeh duela a poeih ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />A rhok aka phuei long tah a himbai te til saeh. Hlaem duela a poeih uh vaengah tah amih te nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="29" style="v" />Diklai kah aka luem rhulcai khuiah saham, su, imrhai neh anih hui boeih,
  </para>
  <para style="p">
    <verse number="30" style="v" />tawkke, tangkong, cangdawl, lainaat, hambo he khaw nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="31" style="v" />Rhulcai boeih khuiah nangmih ham aka rhalawt rhoek te a duek vaengah aka ben boeih khaw kholaeh duela poeih uh ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />A duek vaengah anih soah aka cungku boeih tah poeih uh ni. Te dongah thing hnopai boeih neh himbai khaw, maehpho mai khaw, tolkhui mai khaw, te rhoek neh bitat la a saii hnopai boeih te tah tui dongah duung saeh. Hlaem due poeih uh saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tedae amih khuikah te lai umam khat khat khuila a tlak atah a khui neh a khui kah boeih khaw a poeih dongah rhek dae uh laeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Caak ham cakok khat khat te tekah am tui loh a pha thil atah a poeih coeng. Te dongah umam khat khat khui lamkah ok ham koi tui khaw boeih a poeih coeng.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amih rhok loh a cuhu thil boeih tah tapkhuel khaw, lungthu khaw a poeih coeng. Te rhoek rhalawt rhoek te tah palet saeh. Nangmih ham khaw rhalawt la om.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tedae tuisih neh tangrhom tui tungnah a tlak thil atah tuicil la om mai cakhaw a rhok aka ben te a poeih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae te cangti ballung boeih tah a rhok. loh tlak thil cakhaw cuem ngawn dongah tue ngawn saeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tedae cangti te tui dongah a khueh vaengah a rhok loh a cuhu thil atah nangmih ham rhalawt.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na caak ham koi rhamsa a duek vaengah khaw a rhok aka ben tah hlaem duela poeih uh ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />A rhok aka ca tah a himbai te til saeh. Anih khaw hlaem duela poeih uh ni. A rhok aka phuei te khaw a himbai te til saeh. Hlaem due la poeih uh ni. Diklai
  </para>
  <para style="p">
    <verse number="41" style="v" />ah aka luem rhulcai boeih khaw konawhnah, caak koi moenih.
  </para>
  <para style="p">
    <verse number="42" style="v" />A bung neh aka colh boeih, a kho pali neh aka van boeih khaw, a kho aka ping boeih khaw, diklai ah aka luem rhulcai boeih he tah konawhnah ni ca uh boeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aka luem rhulcai boeih neh na hinglu te rhun uh boeh. Amih nen khaw poeih uh boel lamtah amih long khaw nang m'poeih uh boel saeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kai tah nangmih Pathen BOEIPA ni. Te dongah ciim uh lamtah ka cim bangla a cim la om uh. Te dongah diklai kah aka colh rhulcai boeih dongah na hinglu te poeih uh boeh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangmih kah Pathen la om ham Egypt khohmuen lamloh nangmih aka khuen khaw BOEIPA kamah ni. Te dongah kai ka cim bangla a cim la om uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />He tah rhamsa neh vaa, tui dongkah aka hing tih aka colh hinglu boeih neh diklai dongkah aka luem hinglu boeih ham,
  </para>
  <para style="p">
    <verse number="47" style="v" />rhalawt laklo neh cuemcaih laklo ah, caak ham mulhing laklo neh caak koi pawh mulhing laklo ah paekboe ham olkhueng ni,” a ti nah.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel ca rhoek te voek lamtah thui pah. Huta he vawn tih capa a cun atah pumom tue vaengah a poeih uh bangla hnin rhih khuiah poeih uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae hnin rhet vaengah camoe kah yahhmui saa te rhet pah saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te phoeiah ciimnah thii dongah khohnin sawmthum hnin thum khosa saeh. A caihcilnah khohnin a cum hlan atah aka cim boeih te ben boel saeh lamtah rhokso lam khaw cet boel saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tedae huta a cun atah pumom vaengkah bangla yalh khat khuiah poeih uh la om saeh. Te dongah ciimnah thii dongah khohnin sawmrhuk hnin rhuk khosa saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A caihcilnah khohnin a cup vaengah atah capa canu kah hmueihhlutnah ham tu kum khat ca neh boirhaem la vahui ca neh vahu mai khaw tingtunnah dap thohka kah khosoih taengla khuen saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah anih ham te BOEIPA mikhmuh ah nawn pah saeh lamtah dawth pah saeh. Te daengah ni anih kah pumthim thii te a caihcil eh. He tah huta tongpa aka cun ham olkhueng ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae a kut. loh boiva kangna khaw a hmuh pawt atah vahu phiknit mai khaw, vahui ca phiknit mai khaw hmueihhlutnah ham pakhat, boirhaem ham pakhat te khuen saeh. Te daengah ni anih ham te khosoih loh a dawth pah vetih a caihcil eh?,” a ti nah.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses neh Aaron te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hlang a vin a saa dongah a phuem mai khaw, a vinhna mai khaw, a dikdak la om tih a vin a saa dongah hmaibae tloh la om mai ni. Te vaengah khosoih Aaron taengah khaw, khosoih koca rhoek khuikah pakhat taengah khaw khuen saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A vin saa dongkah a tloh te khosoih loh a sawt vaengah a hma dongkah a mul te a bok la om tih a tloh kah a hmuethma khaw a vin saa khuila dawp a dung atah hmaibae tloh coeng ni. Tedae khosoih. loh so saeh lamtah anih poeih uh ti saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah a vin saa dongkah dikdak la bok dae a hmuethma loh a vin khuila dung pawt tih a mul khaw a bok la a om pawt atah hlang tlo te khosoih loh hnin rhih khoh dae saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A rhih hnin vaengah khosoih. loh so saeh. Tedae tloh te a mikhmuh hmuen la om tih a vin khuila tloh rhoeng mai mahpawh. Te vaengah anih te khosoih. loh pabae la hnin rhih parhaeng saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hnin rhih dongah anih te khosoih. loh pabae la so bal saeh. Te vaengah a hma te maat tih a vin dongkah a hma khaw a rhoeng pawt atah khosoih. loh caihcil coeng ti saeh. Phai la a om dongah a himbai te a suk vetih caihcil bitni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae a ciimnah ham khosoih taengla a tueng phoeiah a vin dongkah phai a rhoeng la a rhoeng atah khosoih taengah pabae la tueng bal saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khosoih loh a sawt vaengah a vin dongkah phai te a rhoeng atah anih te khosoih. loh poeih uh coeng ti saeh. Te te hmaibae ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmaibae tloh he hlang dongah a om van neh khosoih taengla khuen saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khosoih loh a sawt vaengah a vin te a bok la phuem tih, a phuem dongkah a mul te a bok la a poeh phoeiah a saa te thingsup la a thing mai ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />A vin a saa dongkah hmaibae he rhung coeng tih a poeih uh coeng. Anih te rhalawt coeng tih khosoih. loh anih parhaeng voel boel saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tedae a vin dongah hmaibae te hnai khaw hnai mai ni. Te vaengah khosoih mik kah hmuhnah boeih ah hlangtlo kah a vin boeih te hmaibae. loh a lu lamkah a kho duela a thing mai ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te vaengah khosoih. loh so saeh lamtah a pumsa tom te hmaibae loh a thing tih tloh te a bok la boeih a om atah anih te caihcil coeng ti saeh. Anih te cim ngawn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae a pum dongah a saa thing a phoe tue vaengah tah aka poeih uh la om ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae a saa te khosoih loh a haeng la a hmuh saeh daengah ni poeih uh a ti eh. A saa a haeng atah hmaibae coeng tih anih rhalawt om.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae a saa thing te hoilae uh tih a bok la a poeh atah khosoih taengla koep khuen saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khosoih loh a sawt tih a tloh te a bok la a poeh atah khosoih loh anih caihcil coeng ti saeh. A tloh te cim ngawn.
  </para>
  <para style="p">
    <verse number="18" style="v" />A pumsa kah a vin dongkah buhlut om tih hoeih mai ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te buhlut hmuen ah a bok la aka phuem mai khaw, dikdak la a ling a bok te a om atah khosoih taengla tueng saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khosoih loh a sawt vaengah a hmuethma loh a vin khuila dung tih a mul khaw a bok la a poeh atah khosoih. loh anih poeih uh coeng ti saeh. Buhlut dongkah aka puek hmaibae tloh ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae te te khosoih loh so saeh lamtah a mul te a khuiah bok mai pawt nim? Te te a vin lakah dung pawt tih nuk mai ni. Te vaengah anih te khosoih. loh hnin rhih parhaeng saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae a vin dongah ni a rhoeng la a rhoeng atah khosoih loh anih te poeih uh coeng ti saeh. Te te tloh coeng ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae dikdak te amah hmuen la om tih buhlut kah vinhnahlo khaw a rhoeng pawt atah anih te khosoih loh caihcil coeng ti saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A vin a saa khaw hmai ung bangla om tih dikdak aka bok te khaw aka ung thai a ling a bok la a om atah, khosoih loh koep so saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah dikdak dongkah a mul te a bok la poeh tih a hmuethma loh a vin khuila a dung atah hmai ung dongkah aka phoe hmaibae coeng ni. Te dongah khosoih loh anih poeih uh coeng ti saeh. Te te hmaibae tloh coeng ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae khosoih loh a sawt vaengah dikdak dongkah a mul khaw bok voel pawt tih a vin khuila dung pawt dae a nuk atah anih te khosoih loh hnin rhih parhaeng bal saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A hnin rhih dongah khosoih loh koep so saeh lamtah a vin dongah ni a rhoeng la a rhoeng atah khosoih loh anih poeih uh coeng ti saeh. Te te hmaibae tloh coeng ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae dikdak te amah hmuen la om tih a vin dongah khaw rhoeng pawt tih a ung kah a phuem te a nukyum mai ni.A ung kah vinhnahlo la a om dongah anih te khosoih loh caihcil coeng ti saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />tongpa khaw huta mai khaw, a lu neh a baengpae dongah tloh om mai ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tloh te khosoih loh a sawt vaengah a hmuethma loh a vin khuila dung tih a mul khaw huephuep a ae atah khosoih loh anih poeih uh coeng ti saeh.A lu neh a baengpae kah a thak te hmaibae ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tedae thak tloh te khosoih loh a sawt vaengah a hmuethma te a vin khuila dung pawt tih a sam muem mai mahpawh. Te vaengah khosoih loh thak tloh kongah hnin rhih parhaeng dae saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hnin rhih dongah a tloh te khosoih loh koep so saeh. Te vaengah thak te rhoeng pawh, a mul dongah a ae om pawh, thak hmuethma khaw a vin khuila dung mahpawh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te vaengah vo saeh lamtah a thak te tah vo boel saeh. Te phoeiah aka thak te khosoih loh a pabae la hnin rhih parhaeng saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />A hnin rhih dongah a thak te khosoih loh koep so saeh. Te vaengah a vin dongkah a thak te rhoeng pawt tih a hmuethma khaw a vin khuila a dung pawt atah khosoih loh anih caihcil coeng ti saeh. Te phoeiah a himbai suk saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tedae a ciimnah hnukah a thak te a vin dongah a rhoeng la rhoeng mai ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah khosoih. loh so saeh lamtah a vin dongkah a thak te a rhoeng atah a mul aka ae te khaw khosoih loh rhae hnukdawn boel saeh. Anih te rhalawt coeng ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tedae thak te a mikhmuh hmuen la om tih a sam muem a cawn atah a thak te hoeih tih caih coeng. Te dongah anih te khosoih loh caihcil coeng ti saeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tongpa khaw, huta khaw a vin saa dongah dikdak dikdak la a bok om mai ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Te vaengah khosoih loh so saeh lamtah a vin saa dongkah dikdak la nuk tih a bok te a vin dongah bungsap bangla a cuen atah anih te cim ngawn .
  </para>
  <para style="p">
    <verse number="40" style="v" />Hlang he a lu poel tih lukoelh la om cakhaw cuemcaih ngawn .
  </para>
  <para style="p">
    <verse number="41" style="v" />A baengpae neh a hmai lamloh a lu te tlaai tih talkoelh la om cakhaw cim ngawn .
  </para>
  <para style="p">
    <verse number="42" style="v" />Tedae lukoelh dongah khaw, talkoelh dongah khaw a tloh a bok a ling la om tih a lukoelh neh a talkoelh dongla hmaibae loh a phoei mai ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te vaengah anih te khosoih loh so saeh. Tloh aka phuem te a lukoelh soah khaw, a talkoelh soah khaw a vin a saa dongah hmaibae mueimae bangla a bok a ling la om mai ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hlang te a pahuk atah anih te rhalawt coeng tih amah te poeih uh coeng. A lu ah a tloh a om dongah khosoih loh anih poeih uh coeng ti saeh.
  </para>
  <para style="p">
    <verse number="45" style="v" />A pum dongah tloh neh aka pahuk tah himbai pawn neh om uh saeh lamtah a lu khaw a pham la om saeh. Te phoeiah a hmui te buem saeh lamtah rhalawt coeng, rhalawt tila pang saeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />A pum dongah tloh neh rhalawt la a poeih uh tue khuiah tah anih te tolrhum rhaehhmuen vongvoel ah amah bueng khosa saeh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hmaibae tloh te a pum dongkah himbai, tumul himbai dongah khaw, hlamik himbai dongah khaw,
  </para>
  <para style="p">
    <verse number="48" style="v" />hnitah dongah khaw, hlamik hnithun dongah khaw, tumul, maehpho, maehpho neh bitat boeih dongah khaw om mai ni.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tloh te himbai dongah khaw, a maehpho dongah khaw, hnitah dongah khaw, hnithun dongah khaw, maehpho hnopai khat khat dongah khaw a hing neh a ling la a om atah te te hmaibae tloh coeng ni. Te dongah khosoih taengla tueng saeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te vaengah tloh te khosoih loh so saeh lamtah hlangtlo te hnin rhih parhaeng saeh.
  </para>
  <para style="p">
    <verse number="51" style="v" />A hnin rhih dongah a tloh te koep sawt pah saeh. Tloh te himbai dongah khaw, hnitah dongah khaw, hnithun dongah khaw, maehpho dongah khaw, maehpho neh a saii boeih dongah a phoei atah tloh loh a dom hmaibae kah bitat te rhalawt coeng.
  </para>
  <para style="p">
    <verse number="52" style="v" />Te dongah tloh aka om himbai neh hnitah khaw, tumul hnithun khaw, hlamik khaw, maehpho neh a saii hnopai khaw boeih hoeh saeh. Hmaibae loh a dom coeng dongah hmai neh hoeh saeh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tedae khosoih loh a sawt vaengah a tloh te himbai dongah khaw, hnitah dongah khaw, hnithun dongah khaw, maehpho hnopai khat khat dongah khaw phoei pawt mai thai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te vaengah khosoih. loh uen saeh lamtah a pum dongkah tloh te sil saeh. Te phoeiah anih te a pabae la hnin rhih parhaeng saeh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Tedae a tloh te a silh phoeiah khosoih loh so saeh. Te vaengah a tloh te rhoeng pawt cakhaw tloh te a hmuethma loh a lang pawt atah anih te rhalawt coeng ni. A hnuk a hmai ah impap om tih hmai neh hoeh laeh.
  </para>
  <para style="p">
    <verse number="56" style="v" />Tedae khosoih. loh so saeh lamtah a silh phoeiah a tloh a maat atah a himbai neh maehpho khaw, hnitah neh hnithun khaw phen saeh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Tedae himbai neh hnitah dongah khaw, hnithun neh maehpho hnopai khat khat dongah khaw koep cuen tih koep a phoe atah tloh aka om hnopai te tah hmai neh hoeh laeh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tedae himbai neh hnitah khaw, hnithun neh maehpho hnopai boeih te khaw na suk vetih tloh a nong atah pabae na suk vetih caihcil bitni.
  </para>
  <para style="p">
    <verse number="59" style="v" />He tah tumul neh hlamik himbai khaw, hnitah neh hnithun, maehpho hnopai cungkuem dongah hmaibae tloh caihcil nah ham neh poeih uh coeng ti ham koi vaengkah olkhueng ni,” a ti nah.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“He tah aka pahuk te ciimnah khohnin ah khosoih taengla a khuen vaengkah olkhueng ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Te dongah khosoih te rhaehhmuen vongvoel la cet saeh. Te phoeiah khosoih. loh so saeh lamtah aka pahuk kah hmaibae tloh te a hoeih atah,
  </para>
  <para style="p">
    <verse number="4" style="v" />khosoih loh uen saeh lamtah caihcil sak ham aka hing vathawt phiknit a cimbit neh lamphai thing, hlampai lingdik neh pumpiding te khuen saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah khosoih. loh uen saeh lamtah vathawt pakhat te lai am khuikah tui hing soah ngawn saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vathawt pakhat te a hing la khuen saeh lamtah lamphai thing neh, hlampai a lingdik khaw, pumpiding khaw, vathawt aka hing te khaw tui hing sokah a ngawn vathawt thii khuila nuem saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te phoeiah hmaibae aka caihcil soah voei rhih haeh thil saeh lamtah caihcil coeng ti saeh. Te phoeiah vaa hing te khohmuen hoeng la tueih saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah aka caihcil coeng long te a himbai suk saeh lamtah a sam boeih vo saeh. Te phoeiah tui hlu saeh lamtah caihcil uh saeh. Te phoeiah rhaehhmuen khuila ha kun saeh. Tedae dap tol ah hnin rhih khosa saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tedae hnin rhih a lo vaengah a lu neh a baengpae dongkah a sam boeih, a mik kong khaw vo saeh. A mul te boeih vo saeh lamtah a himbai te suk saeh. A pumsa te tui neh sil saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hnin rhet dongah tutal a hmabut pumnit neh tumanu kum khat ca a hmabut pumat, situi neh a thoek khocang vaidam doh thum, situi khap at khuen saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah khosoih taengah nawn saeh lamtah aka caihcil hlang te tingtunnah dap thohka kah BOEIPA mikhmuh ah caihcil saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah tutal pakhat te khosoih. loh lo saeh lamtah situi khap at neh hmaithennah la rhen nawn saeh. Te phoeiah thueng hmueih te BOEIPA mikhmuh ah thueng saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuca te hmaithennah boirhaem bangla khosoih ham cim tih a cim koek coeng dongah boirhaem neh hmuen cim dongkah hmueihhlutnah a ngawn nah hmuen ah ngawn saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te vaengah hmaithennah thii te khosoih. loh lo saeh. Te phoeiah aka caihcil hlang kah bantang hna, a hnapae neh bantang kut kah kutnu dongah khaw, bantang kho kah khopuei dongah khaw khosoih. loh koelh pah saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khap dongkah situi te khaw khosoih. loh lo saeh lamtah khosoih kah banvoei kutpha dongah bueih saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah khosoih. loh a banvoei kutpha dongkah situi khuila bantang kutdawn te nuem saeh lamtah situi te BOEIPA mikhmuh ah a kutdawn neh voei rhih haeh saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kutpha dongkah situi aka coih te khosoih loh aka caihcil kah bantang hna hnapae dongah khaw, a bantang kut kah kutnu dongah khaw, a bantang kho kah khonu dongah khaw, hmaithennah thii soah khaw koelh saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khosoih kutpha dongah situi aka coih te aka caihcil kah a lu dongah hluk pah saeh lamtah anih ham te khosoih. loh BOEIPA mikhmuh ah dawth pah saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te vaengah boirhaem te khosoih. loh nawn saeh lamtah hmueihhlutnah te a ngawn phoeiah a tihnai lamkah aka caihcil ham dawth pah saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmueihtuk dongkah hmueihhlutnah neh khocang te khaw khosoih. loh nawn saeh. Te phoeiah anih ham te khosoih. loh dawth pah saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae anih te tattloel oeh tih a kut loh a na pawt atah anih ham a dawth pah vaengkah thueng hmueih la hmaithennah tuca pakhat, khocang ham situi neh a thoek vaidam doh at neh situi khap at,
  </para>
  <para style="p">
    <verse number="22" style="v" />vahu phiknit mai khaw, vahui ca phiknit mai khaw a kut loh a na thai te tah khuen van saeh lamtah pakhat te boirhaem la, pakhat te hmueihhlutnah la om saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te te a rhet hnin dongah tah amah kah a ciimnah ham te tingtunnah dap thohka kah BOEIPA mikhmuh ah khosoih taengla khuen saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah hmaithennah tuca neh situi khap at te khosoih. loh lo saeh lamtah BOEIPA mikhmuh ah thueng hmueih la khosoih. loh thueng saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmaithennah tuca te khaw ngawn saeh. Te phoeiah hmaithennah thii te khosoih. loh lo saeh lamtah aka caihcil kah bantang hna hnapae neh bantang kut kah kutnu dongah khaw, bantang kho kah khonu dongah khaw koelh pah saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Situi te khaw khosoih. loh khosoih kah banvoei kutpha dongah bueih saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />banvoei kutpha dongkah situi te BOEIPA mikhmuh ah khosoih loh a bantang kutdawn neh voei rhih haeh saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A kutpha dongkah situi te khosoih loh a caihcil sak hlang kah bantang hna hnapae dongah, bantang kut kah kutnu dongah khaw, bantang kho kah khonu dongah khaw, hmaithennah thii hmuen ah khaw koelh saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khosoih kutpha dongkah situi aka coih te a caihcil sak kah a lu soah hluk pah saeh lamtah anih ham te BOEIPA mikhmuh ah dawth pah saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te phoeiah amah kut loh a na van te vahu neh vahui ca khuikah khat khat te nawn saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A kut loh a na dong kah pakhat te boirhaem la, pakhat te hmueihhlutnah la khocang neh rhen khueh saeh. Te phoeiah BOEIPA mikhmuh ah a caihcil sak hlang ham te khosoih. loh dawth pah saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />He tah a pum dongah hmaibae tloh om dae a ciimnah ham a kut loh aka na pawt ham olkhueng ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />BOEIPA. loh Moses neh Aaron te a voek tih,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Kai. loh nangmih taengah khohut la kam paek Kanaan kho la na kun uh vaengah na khohut, im lo ah hmaibae tloh ka khueh atah,
  </para>
  <para style="p">
    <verse number="35" style="v" />Im kung amah te cet saeh lamtah khosoih taengah puen saeh. Te vaengah, 'Ka im khuiah tloh bangla puek coeng,’ ti nah saeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Te vaengah khosoih. loh uen saeh lamtah tloh te sawt ham khosoih a kun hlan ah a im te saekboe saeh. Te daengah ni im khuikah boeih te a poeih uh pawt eh. Te phoeiah im te sawt ham khosoih kun saeh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Te phoeiah tloh te so saeh. Tloh te im pangbueng dongah a hma a hing neh a ling la om tih a hmuethma khaw pangbueng khuila dung mai ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Te phoeiah khosoih te imkhui lamkah im thohka la cet saeh lamtah im te hnin rhih parhaeng pah saeh.
  </para>
  <para style="p">
    <verse number="39" style="v" />A hnin rhih dongah khosoih. loh koep mael saeh lamtah so saeh. Te vaengah a tloh te im pangbueng dongah a phoei mai thai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tedae khosoih. loh uen saeh lamtah tloh aka om lungto te phil uh saeh. Te phoeiah khopuei vongvoel kah rhalawt hmuen la voei uh saeh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah im te a khui khaw, a kaepvai khaw kuet saeh lamtah a kuet dongkah a laipi te khopuei vongvoel kah rhalawt hmuen ah hawk uh saeh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Te phoeiah lungto a thai lo uh saeh lamtah lamhma lungto yuneg la khueh uh saeh. Dikpo khaw a thai lo saeh lamtah im te bol saeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Lungto te a phil tih im a kuet phoeikah a bol hnukah khaw tloh te puek im dongla a phoei mai thai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tedae khosoih te cet lamtah so saeh. Te vaengah tloh te im khuiah a pung atah hmaibae loh a dom im khui te rhalawt coeng.
  </para>
  <para style="p">
    <verse number="45" style="v" />Te dongah im dongkah lungto neh thing khaw, im dongkah laipi boeih te khaw palet saeh lamtah khopuei vongvoel kah rhalawt hmuen la thak saeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te te parhaeng hnin khuiah a im khuila aka kun tah kholaeh due poeih uhla om saeh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Im khuiah aka yalh tah a himbai te suk saeh. Im khuiah caak aka ca long khaw a himbai te suk saeh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tedae khosoih ha pawk la ha pawk tih a sawt vaengah a im ah tloh a pung voel pawt atah im te koep bol saeh. Tloh a hoeih coeng dongah im te khaw khosoih loh caihcil coeng ti saeh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Te dongah im ciim ham vaa phiknit, lamphai thing, hlampai a lingdik neh pumpiding te khuen saeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Te phoeiah vaa pakhat te lai am dongkah tui hing soah ngawn saeh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Lamphai thing neh pumpiding te khaw, hlampai a lingdik te khaw, vaa hing te khaw lo bal saeh lamtah tui hing soah a ngawn vaa thii khuiah nuem saeh. Te phoeiah im dongla voei rhih haeh saeh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Im te khaw vaa thii, tui hing, vaa hing, lamphai thing, pumpiding, hlampai a lingdik neh ciim saeh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tedae vaa hing te khopuei vongvoel kah khohmuen hoeng la a hlah phoeiah im ham dawth pah saeh lamtah caihcil sak saeh.
  </para>
  <para style="p">
    <verse number="54" style="v" />He tah hmaibae tloh neh thak cungkuem ham khaw,
  </para>
  <para style="p">
    <verse number="55" style="v" />himbai neh im khuikah hmaibae ham khaw,
  </para>
  <para style="p">
    <verse number="56" style="v" />a phuem, vinhna, a dikdak ham khaw,
  </para>
  <para style="p">
    <verse number="57" style="v" />He hmaibae olkhueng he rhalawt hnin neh cuemcaih hnin ah khaw aka thuinuet ham olkhueng ni, ' a ti nah.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses neh Aaron te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek rhoi lamtah thui pah rhoi. Hlang pakhat te a pumsa dong lamkah pumthim om tih a buk pah vaengah anih te rhalawt coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih kah pumthim te a ti a hnai la om tih a pumsa dongkah aka long pumthim mai khaw, a saa dongah aka kap pumthim mai khaw a ti a hnai la om.
  </para>
  <para style="p">
    <verse number="4" style="v" />A hnai loh a hnai thil thingkong khat khat dongah aka yalh khaw aka poeih uh la om vetih anih loh a hnai thil hnopai khat khat dongkah aka ngol khaw aka poeih uh la om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih kah thingkong aka ben boeih long tah a himbai te suk saeh lamtah tui neh sil uh saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A pum aka hnai loh a ngol thil hnopai dongah aka ngol long khaw a himbai te suk saeh lamtah tui hlu saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aka hnai kah a pumsa aka ben long khaw a himbai suk saeh lamtah tui hlu saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A cuem te a hnai loh a phuh atah a himbai suk saeh lamtah tui hlu saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A pum aka hnai loh a ngol thil ngoldoelh boeih khaw aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih dangkah aka om boeih te aka ben boeih khaw kholaeh due aka poeih uh la om saeh. Tekah hno aka phuei long tah a himbai te suk saeh lamtah tui hlu saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pum dongah aka hnai hlang aka taek boeih khaw a kut te tui neh a lae pawt atah a himbai suk saeh lamtah tui hlu saeh. Anih te khaw kholaeh duela aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lai am khaw a pum buk loh a ben atah rhek dae saeh. Tedae thing baelyak boeih te tah tui neh lae saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A pumthim aka buk te a caihcil van atah a ciimnah ham hnin rhih due tae saeh. Te phoeiah a himbai te suk saeh lamtah a pumsa te tui hing neh sil saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hnin rhet dongah vahu phiknit mai khaw, vahui ca phiknit mai khaw amah ham lo saeh. Te phoeiah tingtunnah dap thohka kah BOEIPA mikhmuh la khuen saeh lamtah khosoih taengah pae saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te vaengah pakhat te boirhaem la, pakhat te hmueihhlutnah la khosoih. loh nawn pah saeh. Te phoeiah anih kah pumthim kongah te khosoih. loh BOEIPA mikhmuh ah dawth pah saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlang te a yangtui a yae atah a pumsa tom te tui neh sil saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himbai khat khat mai khaw, maehpho khat khat mai khaw yangtui aka om atah tui neh sil saeh. Anih te khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huta tongpa a yalh hmaih vaengkah yangtui te khaw tui neh sil rhoi saeh. Amih rhoi khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huta khaw a pumsa pumthim om tih thii a buk vaengah pumom bangla hnin rhih om saeh. Te vaengah anih aka ben boeih tah kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pumom vaengkah a yalh thil hnopai boeih khaw aka poeih uh la om tih a ngol thil hnopai boeih te a poeih uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih kah thingkong aka ben boeih. loh a himbai te suk saeh lamtah tui hlu saeh. Anih khaw kholaeh due aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ngol thil hnopai khat khat aka ben boeih long khaw a himbai te suk saeh lamtah tui hlu saeh. Anih khaw kholaeh due poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A thingkong khaw, anih loh a ngol thil hnopai mai khaw aka ben tah kholaeh due poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hlang loh a yalh a yalh puei tih pum a om atah hnin rhih khuiah poeih uh la om saeh. Te vaengah a yalh thil thingkong boeih khaw aka poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huta he khohnin a sen pumthim la a thii buk tih a pumom tue pawt ah khaw, pumom tue a poeng phoeiah khaw pumthim la a ti a hnai neh hnin takuem a buk atah pumom tue bangla anih te rhalawt la om.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pumthim a om tue khuiah a yalh thil thingkong boeih khaw pumom vaengkah thingkong vanbangla om. A ngol thil hnopai boeih khaw pumom tue vaengkah a tihnai vanbangla anih te rhalawt la om ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tekah hnopai aka ben boeih khaw a poeih coeng dongah a himbai te suk saeh lamtah tui hlu saeh. Anit khaw kholaeh due poeih uh la om saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae a pumthim te a caihcil phoeiah hnin rhih hil tae saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />A rhet hnin dongah vahu phiknit mai khaw vahui ca phiknit mai khaw amah ham lo saeh lamtah tingtunnah dap thohka kah khosoih taengla khuen saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te vaengah pakhat te boirhaem la, pakhat te hmueihhlutnah la khosoih. loh nawn saeh. Te phoeiah anih kah a ti a hnai pumthim kongah khosoih. loh BOEIPA mikhmuh ah dawth pah saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Israel ca rhoek loh a tihnai khui lamkah cue uh saeh. Te daengah ni amih khui kah ka dungtlungim te a poeih vaengkah amamih kah a tihnai dongah a duek uh pawt eh.
  </para>
  <para style="p">
    <verse number="32" style="v" />He tah a pum lamloh a hnai neh yangtui aka coe loh a poeih ham,
  </para>
  <para style="p">
    <verse number="33" style="v" />a pumom vaengkah hainakthak neh pumthim aka buk ham khaw, tongpa ham neh huta ham khaw, rhalawt taengah aka yalh hlang ham olkhueng ni,” a ti nah.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aaron ca rhoi. loh BOEIPA mikhmuh la a moe rhoi hatah duek rhoi. Amih rhoi a duek phoeiah Moses te BOEIPA loh a voek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te vaengah Moses taengah BOEIPA loh , “Na maya Aaron te thui pah. Thingkawng tlaeng sokah cingmai dongah ka phoe coeng. Te dongah thingkawng tlaeng hmai, imkhui hniyan khuikah hmuencim khuila a tue takuem ah kun mailai boel saeh. Te daengah ni a. duek pawt eh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aaron te hmuencim la a kun atah boirhaem la saelhung khuikah vaito ca neh hmueihhlutnah la tutal te khuen saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />A pumsa dongah takhlawk angkidung cim te bai saeh lamtah takhlawk hnii te na saeh. Te phoeiah takhlawk lamko te vah saeh lamtah takhlawk lupong te muei saeh. He rhoek he himbai cim ni. Te dongah a pumsa te tui neh a silh phoeiah te te bai saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te phoeiah Israel ca rhaengpuei taeng lamkah boirhaem la maae ca pumnit neh hmueihhlutnah la tutal pakhat te lo saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah boirhaem vaito te Aaron. loh amah ham nawn saeh lamtah amah ham neh a imkhui ham dawth saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Maae rhoi te khaw lo saeh lamtah tingtunnah dap thohka kah BOEIPA mikhmuh ah tloeng saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Aaron. loh maae rhoi ham hmulung naan saeh lamtah hmulung pakhat te BOEIPA ham, hmulung pakhat te sombawknah la khueh saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />BOEIPA kah hmulung loh a nan maae te Aaron. loh khuen saeh lamtah boirhaem la nawn saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tedae sombawknah ham hmulung loh a nan maae te BOEIPA mikhmuh ah a hing la pai sak saeh. Te phoeiah sombawknah te khosoek la hlah saeh lamtah amah tholh te dawth saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te phoeiah boirhaem vaito te Aaron. loh amah ham khuen saeh lamtah amah ham neh a imkhuikho ham dawth saeh. Te phoeiah boirhaem vaito te amah ham ngawn saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah BOEIPA mikhmuh kah hmueihtuk dongkah hmai alh te baelphaih a bae neh botui bo-ul kah a vai a kutnarhum a bae pom saeh lamtah im khuikah hniyan khuila khuen saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te phoeiah bo-ul te BOEIPA mikhmuh kah hmai dongah tloeng saeh. Te vaengah bo-ul kah a hu. loh olphong sokah a tlaeng te a khuk daengah ni a. duek pawt eh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vaito thii te khaw lo saeh lamtah thingkawng tlaeng kah a hmai khothoeng benla a kutdawn neh haeh saeh. Thingkawng tlaeng kah a hmai ah khaw thii te a kutdawn neh voei rhih haeh saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah pilnam kah boirhaem maae te ngawn saeh lamtah a thii te im khuikah hniyan khuila khuen saeh. Tekah thii te khaw vaito thii a saii bangla saii saeh lamtah thingkawng tlaeng dongah khaw, thingkawng tlaeng kah a hmai ah khaw haeh saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te tlam te hmuencim ham khaw, Israel ca rhoek kah a ti a hnai neh boekoek kongah khaw, amih kah tholhnah cungkuem ham khaw dawth pah saeh lamtah amih khuiah a ti a hnai neh aka om tingtunnah dap ham khaw saii pah saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tholh dawth ham hmuencim la kun tih koep ha pawk hlandue hlang pakhat khaw tingtunnah dap khuiah om boel saeh. Te vaengah amah ham neh a imkhui ham khaw, Israel hlangping boeih ham khaw dawth pah saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeiah BOEIPA mikhmuh kah hmueihtuk la cet saeh lamtah amah ham koep dawth bal saeh. Te vaengah vaito thii neh maae thii te lo saeh lamtah hmueihtuk ki dongkah a kaepvai ah koelh saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />thii te khaw a kutdawn neh voei rhih haeh saeh lamtah amah a caihcil phoeiah Israel ca rhoek a ti a hnai lamkah ciim
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmuencim, tingtunnah dap neh hmueihtuk ham a dawth te a coeng phoeiah maae te a hing la nawn saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Te vaengah Aaron. loh a kut te kut bok la maae hing kah a lu dongah tloeng saeh. Te phoeiah Israel ca rhoek kathaesainah boeih neh amih kah boekoek boeih, amih kah tholhnah boeih te khaw phoe thil saeh lamtah maae lu dongah phueih sak saeh. Te phoeiah sikim hlang kah kut dongah khosoek la thak saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te vaengah amih kathaesainah boeih te maae. loh khohmuen hoeng la phuei saeh lamtah maae te khosoek ah hlah saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te phoeiah Aaron te tingtunnah dap khuila kun saeh. Hmuencim la a kun vaengkah a bai takhlawk himbai te pit saeh lamtah pahoi khoem saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A pum te khaw hmuen cim kah tui neh sil saeh lamtah a himbai te bai saeh. Te phoeiah halo saeh lamtah amah kah hmueihhlutnah neh pilnam kah hmueihhlutnah te nawn saeh. Te phoeiah amah ham neh pilnam ham te dawth saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Boirhaem kah a tha te khaw hmueihtuk dongah phum saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sombawknah maae aka hlah long khaw a himbai te suk saeh lamtah a pum te tui neh sil saeh. Te phoeiah rhaehhmuen la kun saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tholh dawth nah ham hmuencim koek la a thii a khuen boirhaem vaito neh boirhaem maae te khaw rhaehhmuen vongvoel la thak saeh lamtah a vin khaw, a saa khaw, a aek khaw hmai neh hoeh uh saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te te aka hoeh long khaw a himbai suk saeh lamtah a pum te tui neh a silh phoeiah rhaehhmuen khuila koep kun saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah hla rha dongkah a hla rhih vaengah tah na hinglu te phaep uh. Nangmih khui kah mupoe neh nangmih taengah aka bakuep yinlai. loh bitat pakhat khaw na saii uh pawt ham te nangmih taengah kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tekah khohnin dongah nangmih te na tholhnah cungkuem khui lamkah caihcil sak ham BOEIPA mikhmuh ah nangmih ham a dawth vetih na caihcil uh ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sabbath khaw nangmih ham koiyaeh la om tih na hinglu na phaep ham te kumhal khosing la om coeng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Te vaengah a napa hnukthoi ah khosoih ham a koelh tih a kut tloeng thil tangtae khosoih. loh takhlawk himbai neh himbai cim te bai saeh lamtah dawth van saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Te phoeiah hmuencim kah rhokso neh tingtunnah dap ham dawth pah saeh. Hmueihtuk ham khaw dawth saeh lamtah khosoih rhoek ham neh pilnam hlangping boeih ham khaw dawth bal saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Te dongah tahae kah he BOEIPA. loh Moses a uen vanbangla amamih kah tholhnah cungkuem dongah kum khat ah voeikhat a saii tih Israel ca rhoek ham tholh a dawth vaengkah ham nangmih taengah kumhal khosing la om saeh,” a ti nah.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses te BOEIPA loh a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron, anih koca rhoek neh Israel ca rhoek boeih te voek lamtah thui ham koi tah, BOEIPA kah a uen bangla olka he amih taengah thui pah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel imkhui lamkah hlang khat khat loh vaito mai khaw, tuca mai khaw, maae mai khaw rhaehhmuen ah a ngawn tih rhaehhmuen vongvoel ah khaw a ngawn mai ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te vaengah BOEIPA dungtlungim hmai kah BOEIPA taengah nawnnah la nawn ham tingtunnah dap thohka ah khuen boel saeh. Tekah hlang te thii aka long sak la poek saeh. Thii a long sak coeng dongah tekah hlang te a pilnam khui lamkah hnawt saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kohong khaepdan ah a nawn hmueih te khaw Israel ca rhoek loh hang khuen ngawn saeh. Te vaengah tingtunnah dap thohka kah BOEIPA taeng neh khosoih taengah khuen uh saeh lamtah BOEIPA taengah rhoepnah hmueih la nawn uh saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Te vaengah thii te tingtunnah dap thohka kah BOEIPA hmueihtuk dongah khosoih. loh haeh saeh. Te phoeiah maehtha te BOEIPA taengah hmuehmuei botui la phum saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae amih. loh a taengah a cukhalh puei uh maae taengah amamih kah hmueih koep nawn uh boel saeh. He tah amamih ham neh a cadilcahma ham khaw kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah Israel imkhui kah hlang boeih neh amih lakli kah aka bakuep tih hmueihhlutnah hmueih aka nawn yinlai khaw thui pah.
  </para>
  <para style="p">
    <verse number="9" style="v" />BOEIPA taengah nawn ham kangna khaw tingtunnah dap thohka la a khuen pawt atah tekah hlang te a pilnam lamkah hnawt saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel imkhui lamkah hlang khat khat long khaw, amih lakli kah aka bakuep yinlai lamkah long khaw thii khat khat ni a caak atah ka hmai ka khueh thil ni. Thii aka ca hinglu te pilnam khui lamloh ka hnawt ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ba dongah tikoinih pumsa kah hinglu he thii dongah om. Te dongah nangmih kah hinglu ham hmueihtuk soah na dawth uh vaengah hinglu thii la dawth ham ni kai. loh nangmih taengah kam paek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah, 'Israel ca rhoek nangmih lamkah hinglu boeih. loh thii ca uh boel lamtah, nangmih lakli kah aka bakuep yinlai long khaw thii te ca boel saeh,’ ka ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Israel ca rhoek khui lamkah hlang khat khat long mai khaw, amih lakli kah aka bakuep yinlai long mai mulhing saa neh vaa te a yuep tih a caak oeh atah a thii te ci saeh lamtah laipi neh vuei saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pumsa boeih kah hinglu tah a thii dongah om tih a thii khaw a hinglu dongah om. Te dongah, 'Pumsa khat khat kah a thii tah ca uh boeh. Pumsa boeih kah hinglu a thii aka ca boeih tah hnawt saeh,’ tila Israel ca rhoek taengah ka thui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah tolrhum mupoe neh yinlai khuikah hinglu boeih. loh maehrhok neh saha te a caak atah a himbai te suk saeh lamtah tui hlu saeh. Kholaeh due aka poeih uh la om saeh lamtah caihcil saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae himbai te suk pawt tih a pum te a silh pawt atah amah kathaesainah te amah loh phuei van saeh,” a ti nah.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses te BOEIPA loh a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek lamtah thui pah. Kai tah BOEIPA na Pathen ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Egypt kho ah na om uh vaengkah bibi bangla saii uh boeh. Te phoeiah kai. loh nangmih kam pha sak Kanaan kho kah khoboe bangla om uh boel lamtah amih kah khosing te awt uh boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai kah laitloeknah he ngai uh lamtah ka khosing te vai ham ngaithuen uh. Kai tah nangmih kah Pathen Yahweh ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te dongah kai kah khosing aka ngaithuen tih ka laitloeknah aka ngai hlang te tah tekah khosing dongah hing van ni. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlang la aka om hlang long tah amah kah a pum a saa boeih te ayah hliphen ham paan boel saeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na pa kah a yah khaw, na nu kah a yah khaw, na manu khaw hliphen boeh. A yah khaw hliphen pah boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na pa yuu kah a yah, na pa kah a yah te hliphen pah boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na ngannu, na pa kah a ngannu, na nu kah a tanu kah a yah khaw, im kah pacaboeina neh kholong kah pacaboeina yah khaw hliphen boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na capa canu neh na canu canu kah a yah khaw namah kah a yah la a om boeiloeih dongah amih kah a yah te hliphen boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na pa yuu canu kah a yah khaw, na pa kah pacaboeina, na ngannu kah a yah khaw hliphen boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pa ngannu kah , na pa huiko kah a yah khaw hliphen pah boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na nu kah a tanu, na nu huiko kah a yah khaw hliphen pah boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na pa manuca kah a yah khaw hliphen boeh. Anih yuu neh na pi khaw paan pah boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na langa kah a yah te hliphen pah boeh. Na ca yuu kah a yah khaw hliphen pah boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na manuca yuu kah a yah, na manuca kah a yah te hliphen pah boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na yuu neh a canu, a capa canu neh a canu canu kah a yah te hliphen pah boeh. Na thii na saa kah a yah hliphen pah ham lo boeh. Te bang te khonuen rhamtat ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na yuu amah a hing lalah a yah hliphen pah ham neh daengdaeh ham a tanu te lo boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah huta te a ti a hnai neh pumom tue vaengah a yah hliphen pah ham paan boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na imben kah a yuu aka poeih ham khaw na tamtah tii te khueh boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na tiingan te Molek taengah khumpael sak ham pae boeh. Te dongah na Pathen ming te poeih boeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />tongpa puei khaw huta thingkong bangla yalh puei boeh. Te ta tueilaehkoi ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rhamsa khat khat neh aka poeih uh ham khaw na tamtah khueh boeh. Huta long khaw rhamsa neh pitpom tih, anih kui hamla duen boel saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />He boeih nen he poeih uh boeh. Namtom rhoek khaw he boeih nen he a poeih uh dongah ni nangmih mikhmuh ah ka haek.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khohmuen pataeng a poeih uh dongah amah kathaesainah te ka cawh pah tih, khohmuen kah khosa rhoek khaw a lok thil.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tedae nangmih. loh ka khosing neh ka laitloeknah he ngaithuen uh. Te dongah te bang tueilaehkoi boeih te tolrhum mupoe long khaw, nangmih taengah aka bakuep yinlai long khaw saii boel saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangmih mikhmuh kah tolrhum hlang rhoek loh he rhoek kah tueilaehkoi boeih he a saii uh dongah khohmuen khaw a poeih uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te dongah nangmih mikhmuh kah namtom a tha bangla na khohmuen na poeih uh van tih nangmih khaw khohmuen loh n'tha boel saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />U hlang khaw he rhoek kah tueilaehkoi hno khat khat a saii atah aka saii hlanghing boeih te pilnam lamkah hnawt saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Te dongah nangmih mikhmuh kah tueilaehkoi khosing aka saii rhoek te vai pawt ham kamah loh ka kuek te ngaithuen uh. Te daengah ni amih taengah pum te na poeih uh pawt eh. Kai tah nangmih kah Pathen BOEIPA ni,” a ti nah.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses te BOEIPA loh a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek rhaengpuei boeih te voek lamtah thui pah. Na Pathen BOEIPA kamah he ka cim dongah a cim la om uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hlang boeih loh a manu neh a napa te rhih lamtah ka Sabbath khaw tuem uh. Kai tah na BOEIPA Pathen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mueirhol rhoek taengla hooi uh boeh. Mueihlawn pathen rhoek khaw namamih ham saii uh boeh. Kai tah na Pathen BOEIPA ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />BOEIPA taengah rhoepnah hmueih na nawn vaengah khaw nangmih taengah kolonah la nawn uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na hmueih te amah khohnin neh a vuen ah ca. Tedae a thum hnin duela a coih atah hmai neh hoeh saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thum hnin ah dikyik dikyak te koep a caak la a caak atah anih te moeithen mahpawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te te aka ca. loh BOEIPA kah a cimcaihnah te a poeih dongah amah kathaesainah te phuei saeh. Tekah hlanghing te a pilnam lamloh hnawt saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na khohmuen kah cang na ah uh vaengah khaw na lo saa te boeih at boel lamtah na cangvuei kah a mo khaw boeih yoep boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na misur khaw boeih yun boel lamtah na misur mo te koep rhut boeh. Te tah mangdaeng ham neh yinlai ham hnoo pah. Kai tah nangmih kah BOEIPA Pathen ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huen uh boeh. Basa uh boeh. Hlang khat neh khat loh a imben taengah rhilat uh boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kai ming neh a honghi te toemngam uh boeh kai BOEIPA na Pathen ming he na poeih uh ve.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na hui te hnaemtaek boeh, rheth khaw rheth boeh. Kutloh kah thaphu te namah taengah mincang duela rhaeh sak boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hnapang te tap boeh, mikdael hmai ah hmuitoel khueh boeh. Na Pathen te rhih lah. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tiktamnah te dumlai la saii uh boeh. tattloel maelhmai khaw dan uh boeh, hlanglen maelhmai khaw hiin uh boeh. Na imben kah lai te duengnah neh tloek uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na pilnam taengah caemtuh ham dongpoeng boeh, na hui kah a thii te pai thil boeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na manuca te na thin neh hmuhuet boeh. Na tluung tueng atah na imben khaw tluung lamtah anih kah tholhnah te tah rhooi boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na pilnam koca taengah phulo boel lamtah lunguen boeh. Tedae na hui te namah pum bangla lungnah. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka khosing he ngaithuen uh, na rhamsa khaw a coom neh kui sak boeh. Na lo ah cangti aka coom tuh boeh. Himbai khaw a coom la a yaep te na pum dongah khueh boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang khat khat loh huta taengah yalh tih yangtui a hlah phoeiah hlang kah salnu te a veet mai ni. Te vaengah a lat ham dae lat uh pawt tih poenghalnah a paek pawt atah huta te lai la om cakhaw hlang hoeng la a om pawt dongah duek sak uh boel saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tedae tongpa loh hmaithennah tutal te tingtunnah dap thohka kah BOEIPA taengah hmaithennah la khuen saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tongpa khaw tholhnah neh lai a hmuh coeng dongah amah ham hmaithennah tutal neh BOEIPA mikhmuh ah khosoih. loh dawth pah saeh. Te vaengah anih te tholhnah neh a laihmuh khui lamloh khodawkngai saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khohmuen la na kun uh tih caak ok kung khat khat na ling uh vaengah a thaih te yahhmui rhet banghui la a muel la ca boeh kum thum om sak dae.
  </para>
  <para style="p">
    <verse number="24" style="v" />A kum li dongkah a thaih boeih te tah BOEIPA taengah cangkoeinah buhcim la om saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae a kum nga dongkah a thaih te ca uh lamtah a vuei khaw nangmih ham tomthap saeh. Kai tah nangmih kah Pathen BOEIPA ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thii te ca uh boeh, lungso uh boeh, kutyaek khaw so uh boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na lu kah baengki te rhuep uh boeh. Na hmuimul ngalh ngalh kuet uh boeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinglu ham namah saa te a boenahhma khueh uh boeh. Na pum dongah mangthun ngo khaw khueh uh boeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cukhalh dongah na tanu te poeih uh boeih. Te daengah ni khohmuen. loh cukhalh pawt vetih khohmuen ah khonuen rhamtat a baetawt pawt eh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai kah Sabbath he ngaithuen uh lamtah ka rhokso khaw rhih uh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangmih aka poeih ham rhaitonghma taengla hooi uh boeh. Hnam khaw tlap uh boeh. Kai tah nangmih kah Pathen BOEIPA ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sampok hmai ah thoh pah lamtah patong maelhmai hiin lah. Te phoeiah na Pathen khaw rhih lah. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na khohmuen ah aka bakuep yinlai te vuelvaek boeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangmih taengah aka bakuep yinlai te namamih lamkah mupoe bangla om van saeh. Egypt kho ah yinlai la na om uh van dongah anih te namah pum bangla lungnah. Kai tah na Pathen BOEIPA ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Laitloeknah dongkah cungnueh ham, a khiing ham neh khoe ham dumlai la saii boeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nangmih taengah duengnah cooi, duengnah coilung, duengnah cangnoek, neh duengnah bunang mah dawk om saeh. Kai tah Egypt kho lamkah nangmih aka khuen na Pathen BOEIPA ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka khosing boeih te ngaithuen uh lamtah ka laitloeknah boeih te vai uh lah. Kai tah BOEIPA ni,” a ti nah.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek taengah thui pah. Israel ca rhoek neh Israel taengah aka bakuep yinlai khui lamkah hlang khat khat loh a tiingan te Molek taengah a paek atah vang khuikah pilnam. loh lungto neh dae uh saeh lamtah duek rhoela duek saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tekah hlang te kai. loh ka hmai ka khueh thil ni. A tiingan te Molek taengla a paek tih ka rhokso te a poeih phoeiah ka ming cim te a thae sak dongah a pilnam khui lamkah ka khoe ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae Molek taengah a tiingan aka pae hlang te khohmuen pilnam. loh a mik a him a him thil uh tih a duek sak uh pawt atah,
  </para>
  <para style="p">
    <verse number="5" style="v" />tekah hlang neh a huiko te kai. loh ka hmai ka khueh thil van vetih anih neh anih taengkah aka cuk aka halh boeih khaw, Molek taengah aka cuk aka halh khaw a pilnam khui lamkah ka khoe ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rhaitonghma neh hnam hnukah cukhalh ham aka mael hinglu te khaw ka hmai ka khueh thil bal ni. Tekah hlanghing te a pilnam khui lamkah ka khoe ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai tah na BOEIPA Pathen la ka om dongah nangmih khaw ciim uh lamtah a cim la om uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai kah khosing he ngaithuen uh lamtah vai uh. Kai tah nangmih aka ciim BOEIPA ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hlang khuikah hlang. loh a manu neh a napa te a tap atah duek rhoe duek saeh. A manu a napa a tap dongah amah thii te amah pum ah tla saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlang yuu neh aka samphaih tih, a hui kah a yuu neh aka samphaih hlang te aka samphaih pa khaw aka samphaih nu khaw duek rhoe duek rhoi saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hlang te a napa yuu taengah yalh tih a napa kah a yah te a poelyoe pah atah amih rhoi te duek rhoe duek rhoi saeh lamtah a thii te amamih dongah om saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlang te a langa taengah a yalh atah amih rhoi te duek rhoe duek saeh. Amah thii te amah dongah pitpom ham a saii rhoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huta thingkong bangla tongpa neh tongpa aka yalh te khaw tueilaehkoi ni. Amamih rhoi kah a saii vanbangla duek rhoe duek rhoi saeh lamtah a thii te amamih rhoi tlak thil saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />tongpa pakhat loh huta neh a manu te rhen a loh te khaw khonuen rhamtat ni. Amih te hmai neh hoeh uh. Te daengah ni nangmih khui ah khonuen rhamtat a om pawt eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rhamsa taengah a tamtah aka khueh hlang te tah duek rhoe duek sak lamtah rhamsa te ngawn uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rhamsa boeih te khaw amah taengah kui sak ham ni huta loh a paan atah huta te ngawn lamtah rhamsa khaw duek rhoe duek sakuh. A thii te amah pum dongah tla saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A napa canu, a manu canu, amah ngannu aka lo tih a napa kah a yah aka so neh a manu kah a yah aka so hlang he khaw rhaidaeng. A pilnam boeina mikhmuh lamkah khoe saeh. A ngannu kah a yah a hli a phen dongah amah kathaesainah te phuei saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hlang pakhat loh pumthim aka tlo huta te a yalh puei atah anih kah a yah ni a. hli a phen pah tih pumthim ni a tai pah. Huta amah long khaw a rhoi tih a thii pumthim te a tai dongah amih rhoi te pilnam khui lamkah khoe uh saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na nu kah a tanu neh na pa ngannu kah a yah khaw na hli na phen mahpawh. Te dongah amah saa aka yan tah amamih kathaesainah te phuei uh saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hlang pakhat mai long ni a napi te a yalh puei atah a nupu kah a yah ni a hli a phen. Te dongah a tholh te phuei saeh lamtah cakol la duek saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />U bang hlang long khaw a manuca kah a yuu aka rhawt pah tah rhalawt la om. A manuca kah a yah te a hliphen dongah cakol la duek saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Te dongah ka khosing te ngaithuen lamtah ka laitloeknah boeih te vai uh. Te daengah ni kai loh kam pha sak khohmuen loh nangmih te n'lok thil pawt vetih a khuiah te kho na sak uh eh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Namtom kah khosing bangla pongpa uh boeh. Te boeih te a saii uh tih amih te ka muei a puel dongah nangmih mikhmuh lamkah ka haek.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae amih kah khohmuen te na pang ham, 'Suktui neh khoitui aka long khohmuen pang ham khaw nangmih taengah kamah loh kam paek ni, ' tila nangmih taengah ka thui. Nangmih kah Pathen BOEIPA kamah long ni pilnam khui lamkah nangmih kan hoep.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah rhamsa aka cuem te rhalawt khui lamloh, vaa rhalawt te khaw a cuem lamloh hoep uh. Na hinglu te rhamsa nen khaw, vaa nen khaw, diklai kah aka colh boeih nen khaw rhun uh boeh. Te tah nangmih ham aka poeih uh lam ni ka hoep.
  </para>
  <para style="p">
    <verse number="26" style="v" />BOEIPA kamah ka cim dongah kai taengah a cim la om uh. Kamah taengah om sak ham ni pilnam rhoek khui lamkah nangmih te kan hoep.
  </para>
  <para style="p">
    <verse number="27" style="v" />Te dongah tongpa khaw huta khaw, rhaitonghma neh hnam te a om atah duek rhoe duek saeh. Amih te lungto neh dae uh saeh lamtah a thii te amamih dongah tla saeh,” a ti nah.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih, “Aaron koca khosoih te voek lamtah thui pah. Amih loh a hinglu te a pilnam taengah poeih boel saeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />amah pumsa, amah huiko rhep ham, a manu ham, a napa ham, a capa ham, a canu ham, a manuca ham,
  </para>
  <para style="p">
    <verse number="3" style="v" />a ngannu a va om pawt tih anih dongah oila la aka hangdang ham atah poeih uh mai saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah aka poeih ham a pilnam khuikah boei nen khaw poeih uh boel saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A lu te lungawng la kuet rhoe kuet uh boel saeh. A baengpae neh a baengki khaw vo uh boel saeh. A pumsa te a boenah neh boe uh boel saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A Pathen ham a cim la om uh saeh lamtah a Pathen ming te poeih uh boel saeh. Te dongah BOEIPA kah hmaihlutnah, Pathen kah buh aka nawn amih khaw a cim la om uh saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pumyoi neh huta rhong te lo uh boel saeh. A va aka ma huta khaw lo uh boel saeh. Te dongah a Pathen ham a cim la om saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khosoih long tah na Pathen kah buh a nawn dongah amah te ciim uh saeh. Nangmih aka ciim BOEIPA kamah he ka cim dongah khosoih khaw nang taengah a cim la om saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khosoih tongpa kah a canu khaw a cuk a halh loh a poeih atah a napa ni a poeih. Te dongah anih te hmai neh hoeh uh saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A manuca khui lamkah a lu dongah koelhnah situi a suep pah tih himbai bai ham a kut a tloeng thil khosoih a ham long tah a lu dongkah lupong te dul boel saeh lamtah a himbai te phen boel saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aka duek hinglu boeih taengah khaw cet boel saeh. A napa ham neh a manu ham khaw poeih uh boel saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rhokso lamkah khaw nong boel saeh. Anih soah a Pathen kah koelhnah situi rhuisam a om coeng dongah a Pathen kah rhokso te poeih boel saeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />A yuu khaw a cuemnah neh lo saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nuhmai, vama, pumyoi hlang rhong khaw lo boel saeh. A pilnam khuikah oila bueng te a yuu la lo saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih te BOEIPA kamah loh ka ciim coeng dongah a pilnam khuikah a tii a ngan long khaw poeih boel saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te phoeiah BOEIPA. loh Moses a voek tih,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Aaron te voek lamtah a cadilcahma ham khaw, 'Na tii na ngan taengah rhip thui pah,’ ti nah. U khaw a pum dongah a lolhmaih a om atah a Pathen kah buh aka nawn ham ha moe boel saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A pum dongah a lolh a maih aka om hlang boeih, mikdael neh aka khaem khaw, a sa aka vawt neh a sa aka hoei hlang khaw,
  </para>
  <para style="p">
    <verse number="19" style="v" />A pum dongah kut tlawt, kho tlawt aka om hlang te khaw,
  </para>
  <para style="p">
    <verse number="20" style="v" />tingkhun khaw, merheh khaw, mik haeh khaw, phaikawk neh vinhna khaw, til hi khaw ha mop boel saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khosoih Aaron tiingan khuikah hlang khat khat te a pum dongah a lolh a maih atah BOEIPA kah hmaihlutnah nawn ham ha mop boel saeh. A Pathen kah buh te nawn ham ha mop boel saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A Pathen kah buh tah a cim uet ah cim tih aka cim van loh ca saeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah a pum dongah a lolh a maih aka om loh hniyan khuila kun boel saeh lamtah hmueihtuk taengla mop boel saeh. Te daengah ni ka rhokso te a poeih pawt eh. Amih te BOEIPA kamah long ni ka ciim,” a ti nah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah Moses. loh Aaron neh anih koca rhoek taengah, Israel ca boeih taengah a thui pah.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron neh anih koca rhoek taengah thui pah. Israel ca kah buhcim te hai pa uh saeh. Te daengah ni kai ham a ciim uh vanbangla ka ming cim he a poeih uh pawt eh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na cadilcahma ham khaw thui pah. Israel ca rhoek tah BOEIPA ham a ciim uh coeng dongah buhcim te na tii na ngan khat khat khui lamkah hlang khat khat long ni a pum dongkah a ti a hnai neh a nawn atah tekah hlanghing te ka mikhmuh lamkah khoe uh saeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aaron tiingan khuikah hlang khat khat te pahuk tih a hnai atah a caihcil hlanhil buhcim te ca boel saeh. Te phoeiah rhalawt hinglu khat khat aka ben neh yangtui aka coe hlang khaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />Rhulcai khat khat te a ben tih amah aka poeih uh hlang te khaw, A ti a hnai khat khat dongah amah aka poeih uh hlang te khaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />te te aka ben hinglu te khaw kholaeh duela poeih uh. Te dongah a pum te tui neh a silh pawt atah buhcim te ca boel saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae khomik a tlak phoeiah atah koep caihcil bitni. Te vaengah buhcim dongkah amah buh te koep ca saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Maehrhok neh saha sa a caak nen te poeih uh boel saeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka kueknah te a ngaithuen uh daengah ni tholh loh a poeih tih aka duek ham long khaw amah tholh te a phueih pawt eh. Kai tah amih aka ciim BOEIPA ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kholong hlang khat khat long khaw buhcim te ca boel saeh. Khosoih kah impah neh kutloh long khaw buhcim te ca boel saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae khosoih. loh a tangka, hnopai neh a lai hlanghing long tah ca mai saeh. Amah im kah cahlah long khaw anih kah buh te ca saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khosoih canu khaw kholong hlang taengla a om coeng atah khocang neh buhcim te ca boel saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae khosoih canu nuhmai la om mai tih tiingan om mueh la a hlak uh atah a napa im la mael saeh lamtah a napa kah buh te a camoe vaengkah bangla ca saeh. Tedae kholong boeih long tah ca boel saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang. loh buhcim te tohtamaeh la a caak atah panga neh thap pah saeh lamtah buhcim te khosoih taengah pae saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah BOEIPA taengah Israel ca rhoek kah a tloeng buhcim te poeih uh boel saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amih te BOEIPA kamah loh ka ciim coeng dongah amih kah buhcim aka ca tah amamih kathaesainah lai te amamih loh phuei saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Te phoeiah BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Aaron neh anih koca rhoek khaw Israel ca rhoek boeih te khaw voek lamtah thui pah. Israel imkhui kah hlang boeih khaw, Israel taengkah yinlai long khaw, a olcaeng cungkuem dongah amah kah nawnnah a nawn ham khaw, a kothoh cungkuem ham akhaw,
  </para>
  <para style="p">
    <verse number="19" style="v" />nangmih taengah kolonah ham saelhung khuikah khaw, tu khuikah khaw mae khuikah khaw, a tal a cuemthuek te tah hmueihhlutnah ham BOEIPA taengah nawn uh saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A pum dongah khat khat te a lolh a maih atah khuen boeh. Nang ham kolonah khaw om hae mahpawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hlang. loh olcaeng soep sak ham BOEIPA taengah rhoepnah hmueih a nawn atah kothoh bangla kolonah ham saelhung khaw boiva khaw a cuemthuek la om saeh. A pum dongah a lolh a maih khat khat khaw om boel saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mikdael khaw, aka paep khaw, vitvawt khaw, aka hnai khaw, phaikawk khaw, vinhna khaw BOEIPA taengah nawn boel saeh. BOEIPA taengkah hmueihtuk dongah hmaihlutnah ham khaw te khuikah te tloeng boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tedae kothoh ham tah vaito mai khaw tu mai khaw sahoei neh vitvawt lamkhaw na nawn suidae olcaeng ham tah doe mahpawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah a neet tangtae, a phop tangtae, vitvawt, aka moeng tangtae te BOEIPA taengah nawn uh boeh. Na khohmuen ah khaw saii uh boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kholong ca kut lamkah te khaw na Pathen kah buh la nawn boeh. Amih sokah a lolh a maih khat khat loh amih rhoek te a poeih thai dongah nangmih ham a kolo mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te phoeiah BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Vaito khaw, tu khaw, maae khaw, a thang atah a manu taengah hnin rhih om dae saeh. Tedae a hnin rhet lamkah tah BOEIPA taengah nawnnah hmaihlutnah la thuem pawn ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae vaito khaw, tu khaw, a ca neh khohnin pakhat dongah hmaih ngawn boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />BOEIPA taengah uemonah hmueih na nawn uh vaengah namamih taengah kolonah la nawn uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khohnin pakhat dongah hlawp ca uh lamtah mincang duela paih uh boeh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah ka olpaek tuem uh lamtah vai uh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel ca rhoek taeng ah ka ciim vanbangla ka ming cim te poeih uh boeh. Kai tah nangmih aka ciim BOEIPA ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangmih kah Pathen la om ham ni nangmih te Egypt kho lamkah kan doek. Kai tah BOEIPA ni,” a ti nah.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek lamtah thui pah. BOEIPA kah khoning te hoe uh lamtah ka khoning vaengah a cim tingtunnah te khuehuh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hnin rhuk khuiah bi saii uh saeh. Hnin rhih dongah koiyaeh Sabbath la om saeh lamtah a cim tingtunnah om saeh. BOEIPA kah Sabbath vaengah na tolrhum tom ah bitat khat khaw saii uh boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah khoning vaengah tahae kah BOEIPA khotue he doek uh lamtah a cim tingtunnah khuehuh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hla lamhma dongkah hlasae hnin hlai li hlaem ah BOEIPA kah Yoom om ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlasae hnin hlai nga dongah BOEIPA kah vaidamding khotue om saeh lamtah hnin rhih khuiah vaidamding ca uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A cuek khohnin dongah nangmih ham a cim tingtunnah om saeh lamtah thohtatnah bitat boeih tah saii boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hnin rhih khuiah BOEIPA taengla hmaihlutnah nawn uh. A hnin rhih dongah a cim tingtunnah om saeh lamtah thohtatnah bitat boeih te tah saii uh boeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te phoeiah Moses te BOEIPA loh a voek tih,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel ca rhoek te voek lamtah thui pah. Kai. loh nangmih taengah kam paek khohmuen la na kun uh tih cang na ah uh atah na cangah cuek kah canghmuei te khosoih taengla thak uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Canghmuei te BOEIPA mikhmuh ah thueng saeh. Nangmih taengah kolonah ham khosoih loh Sabbath vuen ah thueng saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Canghmuei na thueng uh hnin vaengah tu kum khat ca te BOEIPA taengah hmueihhlutnah ham a cuemthuek la nawn uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Situi neh a thoek khocang vaidam doh nit te BOEIPA ham hmaihlutnah hmuehmuei botui la om saeh. Tuisi ham misurtui bunang pali khueh saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na Pathen kah nawnnah a khohnin tuung na pha hlan atah vaidam khaw, vairhum khaw, cangthai khaw ca uh boeh. Na tolrhum boeih kah na cadilcahma ham kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thueng hmueih la canghuei na khuen tue phoeikah Sabbath vuen lamkah te tae lamtah Sabbath voeirhih a cum due om sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sabbath voei rhih na tae vuen kah hnin sawmnga vaengah khocang cangthai te BOEIPA taengla nawn uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tolrhum lamkah thueng hmueih vaidam hluem nit, tolrhu neh a thong vaidam doh nit te BOEIPA ham thaihcuek la khuen uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te vaengah vaidam hluem rhih, tu kum khat aka lo ca a cuemthuek neh, saelhung khuikah vaito ca pakhat, tutal panit te khuen lamtah BOEIPA taengkah hmueihhlutnah ham om saeh. Amih kah khocang neh tuisi te khaw BOEIPA ham hmuehmuei botui hmaihlutnah la om saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Te phoeiah boirhaem ham maae tal pakhat neh rhoepnah hmueih ham tu kum khat ca pumnit te nawn uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thaihcuek buh te thueng hmueih la BOEIPA mikhmuh ah khosoih. loh thueng saeh lamtah BOEIPA taengkah a cim tuca panit te tah khosoih ham la om saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tekah khohnin tuung dongah a cim tingtunnah om ham hoe uh lamtah namahmih kah thohtatnah bitat boeih te tah saii uh boeh. He tah Na tolrhum boeih kah na cadilcahma ham kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na khohmuen kah cang na ah uh vaengah khaw na khohmuen te hmangrhong kaep due khap uh boeh. Cang na ah uh vaengah khaw na cang mo te boeih yoep uh boeh. Mangdaeng neh yinlai ham hnoo pauh. Kai tah nangmih kah Pathen BOEIPA ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Israel ca rhoek te voek lamtah thui pah. Hla hlarhih khuikah lamhmacuek hla te nangmih ham a cim tingtunnah tamlung poekkoepnah koiyaeh om saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te vaengah thohtatnah bitat boeih tah saii uh boel lamtah BOEIPA taengah hmaihlutnah nawn ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Moses te BOEIPA loh a voek.
  </para>
  <para style="p">
    <verse number="27" style="v" />“A hla rha khuikah a hla rhih dongah khaw nangmih ham a cim tingtunnah neh dawthnah hnin te om saeh. Te vaengah na hinglu te phaep uh lamtah BOEIPA taengah hmaihlutnah nawn uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na Pathen BOEIPA kah mikhmuh ah nangmih kah te dawth ham dawthnah khohnin la a om dongah tekah khohnin tuung ah bitat pakhat khaw saii uh boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tekah khohnin tuung dongah a pum aka phaep pawt hlanghing boeih tah a pilnam lamkah khoe van saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tekah khohnin tuung dongah bitat khat khat te hlanghing khat khat. loh saii mai ngawn saeh. Tedae tekah hlanghing te a pilnam khui lamkah ka milh sak ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bitat pakhat khaw na saii uh pawt ham te na tolrhum boeih kah na cadilcahma rhoek ham kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangmih kah koiyaeh Sabbath ah te na hinglu phaep uh. Hla ko dongkah hlaem ah tah hlaem lamloh hlaem hil na Sabbath yaeh uh,” a ti nah.
  </para>
  <para style="p">
    <verse number="33" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Israel ca rhoek te voek lamtah thui pah. Hla rhih dongkah hnin hlai nga dongah pohlip khotue te BOEIPA ham hnin rhih khuiah om saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Khohnin lamhmacuek, a cim tingtunnah vaengah thohtatnah bitat boeih tah saii uh boeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hnin rhih khuiah BOEIPA taengah hmaihlutnah nawn uh. Hnin rhet te nangmih kah a cim tingtunnah la om saeh. Pahong vaengah khaw BOEIPA taengah hmaihlutnah nawn uh lamtah thohtatnah bitat boeih te saii uh boeh.
  </para>
  <para style="p">
    <verse number="37" style="v" />BOEIPA kah khoning rhoek te a cim tingtunnah la hoe uh. Tekah khohnin vaengah a khohnin loh a kuek te tah hmueihhlutnah khaw, khocang hmueih neh tuisi khaw BOEIPA taengah hmaihlutnah la khuen uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />BOEIPA kah Sabbath khaw amah vaengah, nangmih kah kutdoe khaw amah vaengah, na olcaeng boeih khaw amah vaengah, na kothoh boeih khaw amah vaengah BOEIPA taengla pae uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hla rhih phoeikah hnin hlai nga dongah khohmuen kah a vuei a thaih te khoem uh bal lamtah BOEIPA kah khotue te hnin rhih lam uh. A cuek khohnin dongah koiyaeh om vetih a rhet khohnin dongah khaw koiyaeh om bal ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />A cuek khohnin dongah rhuepomnah thing thaih neh rhophoe bom, thing bu thing hlaeng, soklong tuirhi te namamih ham lo uh. Na Pathen BOEIPA mikhmuh ah hnin rhih khui na kohoe sakuh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kum khat ah hnin rhih tah BOEIPA ham khotue na lam uh ham te na cadilcahma taengah kumhal khosing la omsaeh lamtah hla rhih dongah lam uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dungtlungim ah hnin rhih khosa uh. Israel khuikah mupoe boeih longtah dungtlungim khuiah khosa saeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Te daengah ni kamah. loh Egypt kho lamkah Israel ca rhoek ka mawt vaengah dungtlungim ah ka om sak te na cadilcahma loh a ming eh. Kai tah na Pathen BOEIPA ni,” a ti nah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Te dongah BOEIPA kah khoning te Israel ca rhoek ham Moses loh a thui pah.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses te BOEIPA loh a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te uen lah. Te vaengah olive situi cil a sui te khuen saeh hmaiim dongah hmaivang te phat vang saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tekah hmaiim te tingtunnah dap khuikah olphong hniyan kah a voel ah Aaron loh ten saeh lamtah BOEIPA mikhmuh ah khoyin lamkah mincang duela pai yoeyah saeh. Te te na cadilcahma rhoek taengah kumhal khosing la om saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmaiim rhoek te BOEIPA mikhmuh kah a cim hmaitung soah ten yoeyah saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vaidam te khaw lo lamtah vaidam laep parha hlai nit la kaeng saeh. Vaidam doh nit tah vaidam laep pakhat la rhip om saeh lamtah,
  </para>
  <para style="p">
    <verse number="6" style="v" />BOEIPA mikhmuh kah caboei cim soah than at dongah parhuk neh than nit la tloeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tekah a than dongah hmueihtui cil te khueh bal lamtah vaidam te BOEIPA taengah kamhoeinah hmaihlutnah la om saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kumhal paipi vanbangla Israel ca rhoek taeng lamkah vaidam te Sabbath hnin, Sabbath hnin ah tah BOEIPA mikhmuh ah tloeng yoeyah saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tekah vaidam te a Aaron neh anih koca rhoek kah a hut la a om dongah aka cim te a cim vanbangla hmuen cim ah dawk ca uh saeh. BOEIPA kah hmaihlutnah khuiah tekah vaidam tah Aaron ham kumhal buhvae la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te vaengah Israelhoel nu kah a capa neh Egypt hlang kah a capa te Isreal ca rhoek taengah cet tih rhaehhmuen khuikah Israelhoel nu kah a capa neh Israel hlang te a hnueih uh rhoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah Israelhoel nu kah a capa. loh ming a sal a pham tih a tap. Te dongah anih te Moses taengla a thak uh hatah a manu ming tah Dan koca khuikah Dibri nu Shelomith la pawk.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah a lungbuei loh BOEIPA olpaek te a puk duela anih te thongim ah a khoh uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />BOEIPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="14" style="v" />Thae aka phoei te rhaehhmuen vongvoel la khuen uh. Aka ya boeih. loh anih lu soah a kut tloeng uh saeh. Anih te rhaengpuei boeih. loh dae uh saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Isreal ca rhoek te khaw voek lamtah thui pah. Hlang khat khat long ni a Pathen te a tap atah a tholh te amah loh yook van saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Te dongah BOEIPA ming aka toeh tah duek rhoe duek saeh. rhaengpuei boeih. loh anih te dae rhoe dae uh. Yinlai khaw tolrhum mupoe khaw BOEIPA ming a toeh atah duek saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hlang kah hinglu khat khat aka ngawn hlang khaw duek rhoe duek saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rhamsa kah hinglu aka ngawn long khaw hinglu te hinglu neh thuung saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hlang. loh a imben te nganboh a paek atah a saii vanbangla amah taengah saii pah van saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rhuh tlawt ham rhuh tlawt, mik ham mik, no ham no van, hlang soah nganboh a paek vanbangla amah te pae van saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rhamsa aka ngawn khaw a yueng thuung sak lamtah hlang aka ngawn tah duek saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai tah nangmih kah BOEIPA Pathen la ka om dongah nangmih taengkah laitloeknah he pakhat la om saeh lamtah yinlai ham khaw, tolrhum mupoe ham khaw, pakhat la om saeh,” a ti nah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah Israel ca rhoek te Moses loh a voek. Te phoeiah BOEIPA. loh Moses a uen vanbangla Israel ca rhoek loh a saii uh dongah thae aka phoei te rhaehhmuen vongvoel la a khuen uh tih lungto neh a dae uh.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sinai tlang ah BOEIPA. loh Moses a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek lamtah thui pah. Kai. loh nangmih taengah kam paek khohmuen te na kun thil uh vaengah khohmuen. loh BOEIPA ham Sabbath te yaeh saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na khohmuen te kum rhuk tawn lamtah na misur khaw kum rhuk na hloe khuiah a thaih te bit.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae a kum rhih dongah tah khohmuen ham koiyaeh Sabbath la om saeh. BOEIPA kah Sabbath ah na khohmuen te tawn boeh. Na misur khaw hloe boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na cang pong te at boeh. Na khohai misur khaw bit boeh. Khohmuen kah koiyaeh kum la om saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na Khohmuen kah Sabbath vaengah tah cakok te namah ham neh na salpa ham khaw, na salnu ham khaw, na kutloh ham khaw, na taengah aka bakuep na lampah ham khaw om bitni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na khohmuen kah na rhamsa neh mulhing loh a caak ham khaw a thaih boeih om ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te dongah kum rhih kum rhih kah Sabbath voei rhih tae lamtah voei rhih a cup phoeikah kum sawmli pako vaengah Sabbath kum la om saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hla rhih dongkah hlasae hnin rha vaengah tamlung neh tuki na ueng ni. Tholh dawthnah khohnin ah khaw na khohmuen boeih ah tuki na ueng ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kum sawmnga kum te ciim uh lamtah kho khuikah khosa rhoek boeih ham sayalhnah hoe uh. Te te nangmih ham jubilee la om saeh. Hlang kah a khohut te mael lamtah hlang boeih te a huiko taengla mael uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A sawmnga kum te nangmih ham jubilee kum la om saeh lamtah, lo tawn uh boeh. Te dongah amah aka pong khaw at uh boeh. Khohai kah khaw bit uh boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tekah jubilee tah nangmih ham a cim la a om dongah khohmuen kah a thaih te na caak uh ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tekah jubilee kum vaengah hlang kah a khohut te mael uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hnoyoih te na imben taengah na yoih uh tih, na imben kut lamkah na lai atah manuca te khat neh khat vuelvaek uh thae boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jubilee phoeikah kum na tae soah na imben kah khohmuen te na lai uh neh a vuei a thaih kum na tae soah yoi saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />A cangvuei kah a tarhing te namah taengah han yoih coeng dongah a kum loh amah tarhing ah yet tih a lainah. loh rhoeng cakhaw kum kah a tarhing te hnah pah lamtah a lainah te hnah pah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hlang pakhat long he a imben te vuelvaek boel saeh. Tedae kai tah nangmih kah BOEIPA Pathen la ka om dongah na Pathen te rhih lah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongah ka khosing te vai uh lamtah ka laitloeknah te ngaithuen uh. Te te na saii uh daengah ni diklai ah ngaikhuek la kho na sak uh eh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Diklai long khaw a thaih a paek vetih kodam la na caak ni. A khuiah khaw ngaikhuek la kho na sak uh ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae, “Kum rhih dongah lo ka tawn uh pawt tih ka cangvuei khaw ka khoem uh pawt koinih balae ka caak uh eh,” na ti uh oeh cakhaw,
  </para>
  <para style="p">
    <verse number="21" style="v" />kai kah yoethennah he kum rhuk khuiah nangmih ham kang uen vetih kum thum ham a vuei a thaih om bitni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kum rhet dongah tawn uh lamtah cang rhuem te kum ko hil ca uh. Cangah a pha duela cang rhuem te ca uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangmih tah kai taengah yinlai neh n lampah uh dae khohmuen tah kamah taengah a ti ham dongah khohmuen te khaw yoi boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te dongah na khohut khohmuen boeih dongah khohmuen ham tlannah khueh uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na manuca te daeng tih a khohut te a yoih atah khohmuen aka tlan ham anih neh aka yoei uh loh ham paan saeh lamtah a manuca kah hnoyoih te koep tlan saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aka tlan ham hlang ni a. om pawt tih khohmuen a tlannah rhoeh te a kut. loh pha pawh, a dang pawt bal atah,
  </para>
  <para style="p">
    <verse number="27" style="v" />a hnoyoih kah kum te tae saeh lamtah a hoei te koe a yoi thil hlang taengah thuung saeh. Te phoeiah amah khohut te lat saeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae anih taengah a mael rhoeh te a kut loh a dang pawt atah a hnoyoih te aka lai kut dongah jubilee kum duela om dae saeh. Tedae jubilee vaengah hlah pah saeh lamtah amah khohut taengla mael saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hlang. loh tolrhum khopuei vongtung khuikah im te a yoih mai ni. Tedae a yoihnah kum a thok hil a tlannah om saeh lamtah a tlannah tue te khueh saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kum loh cup tih a thok duela a tlan pawt atah khopuei vongtung khuikah im te im aka lai neh anih kah cadilcahma taengah a ti la pai saeh lamtah jubilee vaengah khaw hlah boel saeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vongup kah im mai cakhaw a kaepvai ah vongtung a om pawt atah khohmuen lohma bangla poek uh saeh. Anih ham tlannah om saeh lamtah jubilee vaengah hlah pah saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Levi khopuei kah khopuei im tah amih kah khohut ni. Levi ham tah kumhal ah tlannah om saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Israel ca rhoek khuiah Levi rhoek long tah a khopuei neh a im bueng he amih kah a khohut la a khueh uh dongah Levi rhoek long tah tlan saeh. A khohut khopuei kah im a yoih tangtae khaw jubilee vaengah koep lat saeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tedae amih Levi khopuei kah khohmuen khocaak te tah amamih kah kumhal a khohut la a om coeng dongah yoi uh boel saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na manuca te daeng tih nang taengah a kut a hmawn oeh atah anih te yinlai neh lampah banghui lam khaw talong lamtah namah taengah hing sak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih taeng lamkah a casai neh a pueh a kan khaw lo boeh. Na Pathen te na rhih daengah ni na manuca. loh nang taengah a hing eh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih te a casai la tangka pu boeh. Na cang khaw a pueh a kan la yoi boeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kai tah nangmih taengah Pathen la om ham neh nang taengah Kanaan khohmuen paek ham Egypt khohmuen lamkah nangmih aka doek na Pathen BOEIPA ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na taengkah na manuca te daeng tih nang taengla amah a yoih uh atah sal kah thotatnah bangla anih te thohtat sak boeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Namah taengah kutloh neh lampah bangla om saeh lamtah Jubilee kum hil nang taengah thotat saeh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Te phoeiah amah neh a ca rhoek te nang taeng lamkah nong saeh lamtah a huiko taengla mael saeh. Te vaengah a napa kah khohut la mael saeh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kamah kah sal la om ham amih te Egypt kho lamkah ka loh. Amih te sal yoih la yoi uh boel saeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih te mangkhak la taemrhai boeh. Na Pathen te rhih lah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na kaepvai namtom taeng lamkah sal, salnu na lai te tah namah taengah namah kah salnu salpa la om uh saeh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nangmih loh na lai uh tih nangmih taengah aka bakuep lampah ca rhoek neh nangmih taengkah a huiko lamloh na kho kah nangmih lakliah a cun uh te khaw khohut bangla nangmih taengah om uh saeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Te dongah amih te namah phoeikah na ca rhoek taengah kumhal kah a pang khohut la pang sak lamtah thohtat sak. Tedae na manuca Israel ca rhoek khat khat neh anih kah a manuca soah mangkhak la taemrhai boeh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nang taengkah yinlai neh lampah kut long pataeng a kae vaengah a taengkah na manuca tah daeng tih na taengkah yinlai lampah taengah khaw, yinlai huiko kah a mii taengah khaw, amah a yoi uh khaming,
  </para>
  <para style="p">
    <verse number="48" style="v" />a yoih uh phoeiah khaw a manuca khui lamkah khat khat long ni tlannah a khueh atah tlan saeh.
  </para>
  <para style="p">
    <verse number="49" style="v" />A nupu long khaw, a nupu capa long khaw tlan saeh. A pumsa saa lamkah, amah huiko long khaw tlan saeh. A kut loh a na mak atah amah khaw tlan uh saeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Anih a yoih lamkah a lai kum te jubilee kum duela tae pah saeh. Te phoeiah a kum tarhing dongkah a khohnin vanbangla a yoih tangka te om saeh lamtah anih te kutloh bangla om saeh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Kum muep a ngaih pueng atah a yet tarhing la a lainah tangka dong lamkah te tlannah la pae saeh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tedae jubilee kum duela kum cavilcavel ni a ngaih coeng atah a kum tarhing te poek pah saeh lamtah a tlannah te pae van saeh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kum at phoeiah kum at kutloh bangla om saeh. Anih te na mikhmuh ah mangkhak la taemrhai boeh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Te tlam pataeng a tlan thai pawt atah Jubilee kum vaengah anih te a ca rhoek neh rhenten hlah saeh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Israel ca rhoek he kamah taengah ka sal rhoek kah sal la om ham ni Egypt kho lamkah ka loh. Kai tah nangmih kah BOEIPA Pathen ni.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mueirhol khaw, mueithuk khaw namamih ham saii uh boeh. Kaam khaw namamih ham ling uh boeh. Kai tah na BOEIPA Pathen la ka om dongah a hmaiah bakop thil ham lung thuk khaw na kho ah khueh uh boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Sabbath te tuem uh lamtah ka rhokso te rhih uh. Kai tah BOEIPA ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka khosing te na vai uh atah ka olpaek khaw ngaithuen uh lamtah saii uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te daengah ni amah tuetang vaengah nangmih ham khonal kan tueih vetih diklai. loh a cangpai m'paek phoeiah khohmuen kah thingkung long khaw a thaih a thaih eh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah na cangtil loh misurbit due a pha vetih na misurbit loh na rhoktuh tue te a pha ni. Na buh khaw kodam la na caak uh vetih na khohmuen ah ngaikhuek la kho na sak uh ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khohmuen te rhoepnah ka paek vetih lakueng om mueh la na yalh uh ni. Khohmuen lamkah boethae mulhing khaw ka kangkuen sak vetih na khohmuen te cunghang. loh khawkkhek mahpawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na thunkha pataeng na hloem vaengah na mikhmuh kah cunghang dongah cungku uh ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te vaengah nangmih khuikah panga. loh yakhat te a hloem uh vetih yakhat. loh thawngrha khaw a hloem ni. Na thunkha rhoek khaw na mikhmuh kah cunghang dongah cungku uh ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangmih taengla ka mael vetih kam pungtai sak phoeiah kan rhoeng sak ni. Ka paipi te khaw nangmih taengah ka thoh ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cang rhuem aka ip te na caak uh vetih cang thai ham te cang rhuem na hlah uh ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih lakli ah ka dap ka khueh vetih nangmih te ka hinglu. loh tuei voel mahpawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmih lakli ah ka pongpa vetih nangmih kah Pathen la ka om vaengah nangmih khaw ka pilnam la na om uh ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Egypt kho lamkah nangmih aka doek te khaw na BOEIPA Pathen kamah ni. Amih sal la na om khui lamkah na hnamkun hnokohcung khaw ka khaem tih nangmih te a dueng la kan caeh sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae ka olna ngai uh pawt tih hekah olpaek boeih he na vai uh pawt atah,
  </para>
  <para style="p">
    <verse number="15" style="v" />ka khosing te na sawtsit uh tih na hinglu. loh ka laitloeknah te a tuei dongah ka olpaek boeih te vai pawt ham ka paipi te na phae uh atah,
  </para>
  <para style="p">
    <verse number="16" style="v" />kai. loh nangmih ham hekah he ka saii van ni. Te vaengah kositloh neh mik hum satloh te nangmih soah lungmitnah la kan hlak vetih na hinglu a mueipuel ni. Na cangti khaw a poeyoek la na tuh vetih na thunkha long ni a caak eh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmih taengah ka hmai ka khueh vetih na thunkha rhoek kah mikhmuh ah na paloe uh ni. Na lunguet rhoek loh nangmih te n'taemrhai uh vetih nangmih n'hloem pawt cakhaw na rhaelrham uh ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />He rhoek phoeiah khaw ka ol te na yaak uh pawt atah namamih kah tholh dongah voeirhih duela nangmih te toel ham ka khoep van ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangmih kah hoemdamnah sarhi te ka khaem vetih na vaan ke thi bangla, na diklai he khaw rhohum bangla ka khueh ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na khohmuen loh a cangpai m'pae pawt dongah na thadueng khaw a poeyoek la boeih vetih khohmuen kah thingkung khaw a thaih thaii mahpawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai taengah boekoekthingka la na om uh tih ka ol ngai ham na huem uh pawt van atah na tholh tarhing ah hmasoe parhih duela nangmih soah kan khoep sak van ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kohong mulhing te nang taengla kan tueih vetih namamih khaw cakol la n'khueh uh ni. Na rhamsa te a thup vaengah voehvoeh na muei uh vetih na longpuei khaw sut pong ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />He phoeiah pataeng kai taengah na toel uh pawt tih kai soah boekoekthingka la na pongpa uh mai ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Te vaengah kai ngawn tah nangmih taengah boekoekthingka la ka lo vetih namamih kah tholhnah dongah voeirhih duela kang ngawn van ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Phulohnah paipi neh phu aka lo cunghang te nangmih soah kang khuen ni. Na khopuei ah kan coi phoeiah nangmih lakli ah duektahaw kan tueih vetih thunkha kut dongah kam voeih ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmih kah thahuelnah buh te kai loh ka khah vaengah na buh te huta parha loh tapkhuel pakhat dongah a thong uh ni. Te vaengah na buh te amah tarhing neh ham phom uh vetih na caak uh suidae na hah uh mahpawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />He phoeiah pataeng kai taengah na khinngai uh pawt tih kai soah boekoekthingka la na pongpa uh atah,
  </para>
  <para style="p">
    <verse number="28" style="v" />nangmih taengah kosi neh boekoekthingka la ka lo van vetih nangmih te namamih kah tholh dongah voeirhih duela kan toel ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te vaengah na capa rhoek kah a saa te na caak uh vetih na canu rhoek kah a saa khaw na caak uh ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangmih kah hmuensang te ka mit sak vetih na bunglawn khaw ka vung ni. Nangmih kah mueirhol thingkoh soah na rhok te ka hmoek vetih nangmih te ka hinglu loh a tuei ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na khopuei te imrhong la ka khueh vetih na rhokso khaw ka pong sak ni. Nangmih kah hmuehmuei botui khaw ka him mahpawh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Khohmuen te khaw ka pong sak vetih a khuikah kho aka sa na thunkha rhoek te pong uh ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangmih te namtom rhoek taengah kan thaek kan yak phoeiah na hnukah cunghang neh kan thun ni. Te vaengah na khohmuen. loh khopong la om vetih na khopuei rhoek khaw imrhong la poeh uh ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khohmuen loh a Sabbath te a pong tue khuiah uum saeh. Nangmih te na thunkha khohmuen ah na om uh vaengah khohmuen khaw kangkuen saeh lamtah a Sabbath te uum saeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />A khuiah kho na sak uh vaengkah na Sabbath ah a duem pawt yueng te a pong tue khuiah tah duem saeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nangmih khuikah aka sueng rhoek pataeng a thunkha rhoek kah khohmuen ah a thinko te rhiyawpnah ka paek ni. Amih te hloem pawt cakhaw hawn a yawn ol loh a hloem vaengah cunghang kah a hloem bangla yonglong ah rhaelrham uh vetih cungku uh ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />N'hloem uh pawt cakhaw cunghang ha dongkah bangla hlang long he a manuca pataeng a paloe thil vetih na thunkha rhoek hmai ah na oelnah om mahpawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Namtom taengah na milh uh vetih na thunkha rhoek kah khohmuen. loh nangmih te n'yoop ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nangmih khui lamkah aka sueng rhoek te na thunkha rhoek kah khohmuen ah amamih kathaesainah dongah muei uh vetih, a napa rhoek kathaesainah dongah khaw amih te muei ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />A boekoeknah la kai taengah boe a koek uh tih kai soah boekoekthingka la a caeh uh vaengah amamih kathaesainah neh a napa rhoek kathaesainah te a omtoem uh mai ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kai khaw amih taengah boekoekthingka la ka cet vetih amih te thunkha rhoek kah khohmuen la ka thak ni. Tedae amih kah thinko pumdul loh a kunyun daengah ni amamih kah thaesainah khaw a moeithen eh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jakob taengkah ka paipi khaw, Isaak taengkah ka paipi khaw ka thoelh ni. Abraham taengkah ka paipi khaw ka thoelh vetih khohmuen te ka ngaidam ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amih om mueh la a pong sut vaengah amih kah a hnoo khohmuen. loh amah kah Sabbath te a uum ni. Ka laitloeknah a hnawt uh tih a hinglu. loh ka khosing a tuei dongah amih kathaesainah a thung ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kai tah amih kah BOEIPA Pathen la ka om dongah amih he a thunkha rhoek kah khohmuen ah a om vaengah pataeng amih taengkah ka paipi phae ham neh amih thup ham aih tah amih te ka hnawt pawt vetih ka tuei mahpawh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kai. loh amih taengah BOEIPA Pathen la om ham te tah namtom rhoek kah mikhmuh ah Egypt kho lamkah ka khuen patuel rhoek kah paipi te amih ham ka thoelh pueng ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hekah oltlueh neh laitloeknah neh olkhueng rhoek he Moses kut neh Sinai tlang ah BOEIPA. loh amah laklo neh Israel ca rhoek laklo ah a khueh.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />BOEPA. loh Moses te a voek tih,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel ca rhoek te voek lamtah thui pah. Hlang khat khat loh na hinglu phu neh BOEIPA taengah olcaeng a rhaisang sak atah,
  </para>
  <para style="p">
    <verse number="3" style="v" />na phu te tongpa kum kul ca lamkah kum sawmrhuk ca rhoek te tah hmuencim kah shekel ah tangka shekel sawmnga te na phu la om saeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tedae anih te huta la a om atah shekel sawmthum na phu la om saeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Te vaengah kum nga ca lamkah kum kul ca te tah tongpa ham shekel pakul neh huta ham shekel parha te na phu la om saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tedae hla khat ca lamkah kum nga ca te tah tongpa ham tangka shekel panga te na phu la om saeh lamtah huta ham tangka shekel pathum te na phu la om saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kum sawmrhuk ca lamkah a so te tah tongpa te shekel hlai nga te, na phu la om saeh lamtah huta ham shekel parha om saeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na phu te a daeng bal oeh atah amah te khaw khosoih kah mikhmuh ah pai saeh lamtah khosoih. loh a phu tloek pah saeh. Aka caeng kut loh a na tarhing ah khosoih. loh rhan pah saeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rhamsa te BOEIPA taengkah nawnnah ham a nawn uh bal atah BOEIPA taengah a paek boeih te tah a cimcaih la om saeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A thae te a then neh, a then te a thae neh thung khaw thung boel saeh, tho khaw tho boel saeh. Rhamsa te rhamsa neh a tho la a tho atah rhamsa aka om neh a hnothung te khaw a cimcaih la om saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tedae rhalawt rhamsa boeih tah BOEIPA taengkah nawnnah ham khuen uh boel saeh. Tedae rhamsa te khosoih kah mikhmuh ah tloeng saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te vaengah a thae a then khaw anih te khosoih loh a phu tloek saeh lamtah khosoih kah a tloek te na phu la om saeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae amah loh a tlan la a tlan atah na phu te panga neh thap van saeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hlang pakhat mai long khaw a im te BOEIPA ham a cim la a ciim coeng atah a thae a then khaw khosoih. loh a phu tloek saeh lamtah khosoih kah a phu a tloek vanbangla a phu khaw om van saeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae a im a ciim tangtae te a tlan atah a phu te tangka a pueh panga neh koep thap saeh lamtah amah hut la koep om saeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlang pakhat mai loh khohmuen khui lamkah amah khohut te BOEIPA ham a ciim atah a cangti a cuk tarhing la a phu om saeh lamtah cangtun tii hma at cuk te tangka shekel sawmnga neh ting van saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jubilee kum dongah a khohmuen te a ciim atah a phu te amah tarhing la om saeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae a khohmuen te jubilee poengah a ciim atah jubilee kum duela aka sueng te khosoih. loh tae saeh lamtah a kum tarhing kah tangka vanbangla a phu te hnop van saeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hoep mueh tangtae khohmuen te koep a tlan la a tlan atah khohmuen phu tangka te a pueh panga neh koep thap thil saeh lamtah amah hut la koep om saeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae khohmuen te tlan pawt tih hlang taengla patoeng a yoih coeng atah khohmuen te koep tlan voel boel saeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jubilee a poeng vaengah khohmuen loh BOEIPA taengah a cim la a om pueng atah khohmuen bangla yaehtaboeih la aka om te tah khosoih kah khohut la om saeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amah kah khohut khohmuen pawt dae a kho lai te BOEIPA ham a ciim atah,
  </para>
  <para style="p">
    <verse number="23" style="v" />Jubilee kum a pha duela a phu yet te khosoih. loh tae saeh lamtah BOEIPA ham a cimcaih sak khohnin van vaengah a phu te pae saeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jubilee kum vaengah tah khohmuen a lai vaengkah a kungmah taengah amah kah khohmuen khohut vanbangla bal saeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na phu boeih boeih hmuencim kah shekel neh tae la om vetih gerah pakul ah shekel pakhat la om saeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rhamsa khuikah a cacuek boeih he BOEIPA kah caming omthang la a om dongah vaito mai khaw tu mai khaw BOEIPA hut tangtae te tah hlang long he ciim boel saeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tedae rhalawt rhamsa mai khaw namah kah phu bangla a lat mai ni. Tedae te te a panga neh thap saeh. A tlan pawt daengah ni namah ka a phu bangla a yoih eh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tedae hlang. loh a khueh khui boeih lamkah hlang khaw, rhamsa khaw, amah kah khohut khohmuen khaw BOEIPA ham a ha tangtae, yaehtaboeih la aka om khat khat te tah yoi boel saeh. BOEIPA ham aka cim tih a cim tangkik yaehtaboeih la aka om boeih te tah tlan boel saeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hlang pataeng yaehtaboeih la a ha boeih te tah lat boel saeh lamtah duek rhoe duek sak saeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khohmuen cangtii khaw, diklai thing thaih khaw parha pakhat boeih BOEIPA hut la om tih BOEIPA ham cimcaih bal.
  </para>
  <para style="p">
    <verse number="31" style="v" />Te dongah hlang khat khat mai loh amah kah parha pakhat te a tlan la a tlan atah amah kah panga neh thap thil saeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Saelhung khaw, boiva khaw mancai hmuikah aka luem boeih kah parha pakhat boeih te BOEIPA kah a cim parha pakhat la om saeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />A thae a then khaw hnukdawn boel saeh lamtah thovael boel saeh. A tho la a tho atah aka om tangtae neh a hnothung te a cim la rhen om coeng tih tlan thai mahpawh,” a ti nah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tahae kah olpaek rhoek he Israel ca rhoek ham Sinai tlang ah BOEIPA. loh Moses a uen.
  </para>
</usx>
