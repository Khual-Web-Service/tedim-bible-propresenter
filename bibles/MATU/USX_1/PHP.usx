<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PHP" style="id">Philipi</book>
  <para style="h">Philipi</para>
  <para style="toc1">Philipi</para>
  <para style="toc2">Philipi</para>
  <para style="mt">Philipi</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesuh Khrih kah sal rhoi Paul neh Timothy loh Philipi ah aka om hiphoelkung rhoek, tueihyoeih rhoek neh Jesuh Khrih ah hlangcim rhoek boeih taengah kan yaak sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />A pa Pathen neh Boeipa Jesuh Khrih taengkah lungvatnah neh ngaimongnah tah nangmih taengah om saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangmih kah poekkoepnah cungkuem dongah ka Pathen te ka uem.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai kah rhenbihnah takuem ah nangmih rhoek boeih ham omngaihnah neh rhenbihnah ka saii taitu he khaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />A tongcuek khohnin lamkah tahae duela olthangthen dongah nangmih kah bulbonah dongah ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />He he boeih ka ngaitang ngawn ta. Te dongah nangmih khuiah bibi then aka tong long tah Jesuh Khrih kah khohnin duela a khah ni ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangmih thinko khuiah ka om dongah nangmih boeih yueng la poek ham he kai ham tah a dueng la om ngawn. Kai kah thongtlak dongah khaw, olthungnah dongah khaw olthangthen kah caksaknah dongah khaw lungvatnah te kai aka bawn puei laboeih na om uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai kah laipai la Pathen om ta. Jesuh Khrih kah kotak dongah nangmih rhoek boeih te bahoeng kan ngaidam.
  </para>
  <para style="p">
    <verse number="9" style="v" />He tla ka thangthui daengah ni nangmih kah lungnah loh mingnah neh hmuhmingnah cungkuem dongah taoe taoe a pungtai pueng eh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah a tanglue te na soepsoei uh daengah ni Khrih kah khohnin ah tah a cuemhmuet neh a cilrhik la na om uh eh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathen kah thangpomnah neh koehnah ham Jesuh Khrih lamkah duengnah thaihtak tah soep coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manuca rhoek, kai taengah taoe aka thoeng olthangthen kah rhoengcawtnah te nangmih ming sak ham ka ngaih coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Te dongah Khrih ham kai kah thongtlak te khoboeiyung boeih neh a tloe boeih ah a pha tih mingpha coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te phoeiah boeipa ah manuca a yet loh kai kah thongtlak te a ngaitang uh. Te dongah sayalh la olka thui ham taoe a ngaingaih uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlangvang loh uethnetnah, tohhaemnah neh om uh ngawn dae hlangvang ngawn tah Khrih kawng te kolonah la a hoe uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cungvang ah lungnah lamlong tah olthangthen kah olthungnah ham n'tuek tila a ming uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae koevoeinah neh Khrih olthang aka doek rhoek tah cuemcaih pawh. Kai kah thongtlak vaengkah phacip phabaem te soehsal ham ni a cai uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te phoeikah tah mebang nim? Mueituengnah mailai nen khaw oltak nen khaw a longim boeih neh Khrih kawng doek mai cakhaw hekah ham he ka omngaih tih koep ka omngaih pueng ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />He tah nangmih kah rhenbihnah neh Jesuh Khrih Mueihla kah bomnah lamloh kai ham khangnah la poeh ni tila ka ming.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka rhingoelnah neh ngaiuepnah vanbangla yah ka pok mahpawh. Tedae sayalhnah cungkuem neh hingnah lamlong khaw, dueknah lamlong khaw a yoeyah la ka pum dongah Khrih a oep van pawn ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai ham tah ka hing khaw Khrih tih ka duek te khaw ka hoeikhangnah ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae pumsa ah hing ham akhaw te tah kai ham bibi kah a thaih la om tih ka tuek ham te ka ming pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah voeivang lamloh n'nan. Ka bal ham neh Khrih taengah om ham te hoehhamnah ka khueh te muep then ngai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae pumsa ah om he nangmih ham tangkik ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Te dongah ka pangtung he ka ming daengah ni ka rhaehrhong vetih nangmih boeih te namamih kah rhoengcawtnah neh tangnah dongkah omngaihnah dongah ka nguel eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Te daengah ni nangmih kah thangpomnah loh kai dongkah neh kai lamloh nangmih taengah mikhmuh la Khrih Jesuh dongah a pungtai eh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khrih olthangthen kah a tingtawk la dawk hing uh. Te daengah ni ka pawk tih nangmih kan hmuh vaengah khaw, lakhla vaengah khaw, nangmih kawng te ka yaak eh. Mueihla pakhat dongah na pai uh tih, olthangthen kah tangnah dongah pakhat la hinglu na cut uh te ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Te phoeiah boekoek rhoek kongah a hong nen khaw hlawt let uh boeh. Te tah amih ham pocinah dongah mingphanah ni. Tedae nangmih ham tah khangnah la om. He tah Pathen taeng lamkah ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangmih taengah Khrih yueng la m'paek coeng. Amah dongah aka tangnah ham bueng pawt tih amah yueng la aka patang taengah khaw a paek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai dongah thingthuelnah aka khueh rhoek te amah la na hmuh uh tih ka khuikah te na yaak uh coeng.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khrih dongah thaphohnah khat khat a om van akhaw, lungnah dongkah suemnah khat khat a om akhaw, mueihla dongah rhoinaengnah khat khat a om akhaw, sitlohnah neh sitlohnah khat khat a om akhaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />amah thikat la na poek uh, amah thikat la lungnah na khueh uh, ko-at thin-at ca neh pakhat la na poek uh te ni omngaihnah la ka kum mai coeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Koevoeinah nen boel saeh lamtah koehhahnah nen boel saeh. Tedae tlayaenah neh khat neh khat taengah amamih te tanglue la poek uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hlang khat rhip loh amamih ham te paelki uh boel saeh. Tedae hlangtloe te khaw rhip so uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesuh Khrih ah aka om van te tah nangmih khuiah na poek uh he.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amah tah Pathen kah mueimae la aka om loh Pathen neh vanat la a om te laikoeinah ham a poek moenih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae amah te a tlongtlai la saii uh. Sal kah mueimae te a loh tih hlang kah mueisa neh om.
  </para>
  <para style="p">
    <verse number="8" style="v" />A suisak tah hlang bangla a hmuh dae amah te tlarhoel tih dueknah hil khaw, thinglam dongkah dueknah nen pataeng olngai la om coeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te dongah Pathen long khaw anih te a pomsang tih ming boeih soah ming tanglue te anih a paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah vaan neh diklai neh laikhui kah aka om boeih loh Jesuh ming dongah khuklu cungkueng uh saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te vaengah ol cungkuem loh pa Pathen kah thangpomnah ham Jesuh Khrih tah Boeipa ni tila phong saeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te dongah ka thintlo rhoek , ol na ngai uh taitu vanbangla ka mikhmuh bueng ah pawt tih ka yinhnuk ah khaw muep ngai uh laeh. Rhihnah neh thuennah lamloh namamih kah khangnah te thoeng sakuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A kolonah bangla ngaih sak ham neh tueng sak ham khaw nangmih khuiah aka tueng tah Pathen amah ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />A cungkuem te uepvawtnah neh kohuetnah khueh kolla saii uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te daengah ni vilvak neh aka pamdah cadil lakli ah aka cuem Pathen kah a ca rhoek, a cuemthuek neh caepakyik la na om uh eh. Amih taengah khaw Diklai dongkah a aa bangla na phoe uh eh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hingnah ol aka laehdawn tah Khrih kah khohnin ah ka thangpomnah la om. Te dongah a tlongtlai la ka yong pawt tih a tlongtlai la ka thakthae moenih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tedae nangmih kah tangnah thothueng neh hmueih te m'bueih thil atah ka omngaih coeng tih nangmih boeih taengah khaw ka omngaih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Te dongkah bangla nangmih khaw omngaih uh lamtah kai taengah omngaih uh van.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae Timothy te nangmih taengah Boeipa Jesuh ming neh tlek tueih ham ka ngaiuep. Te daengah ni nangmih kawng te ka ming vetih kai khaw ka ngai a dip van eh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih phek la nangmih kawng ah aka mawn taktak ka khueh moenih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah ham aka toem boeih ham tah Jesuh Khrih kah koe om moenih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tedae anih kah khinngainah te na ming uh. Olthangthen ham paca bangla kai taengah sal a bi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Te dongah kai kawng te tlek ka ming nen tah anih he kan tueih ham ka ngaiuep.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tedae kai khaw tlek ka pawk ni tila Boeipa ming neh ka ngaitang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tedae manuca neh bibipuei neh ka rhalkappuei Epapharoditu te ka poek tangkik. Tedae nangmih kah caeltueih neh ka ngoe vaengkah bibikung ham nangmih taengla kan tueih eh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmih rhoek boeih te n'ngaidam tih a om dongah omdam tih tlo tila na yaak uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A tloh dongah dalh duek ngawn dae Pathen loh anih a rhen. Anih bueng pawt tih kai khaw kothaenah hmanah kothaenah khueh pawt ham ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anih te thintawn la kan tueih tangloeng daengah ni amah na hmuh uh vaengah koep na omngaih uh vetih kai khaw bidip la ka om eh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Te dongah Boeipa ah omngaihnah cungkuem neh anih te doe uh lamtah anih bang te a khoelh la khueh uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khrih kah bibi dongah dueknah te a paan. Ka taengkah thothueng dongah na vawtthoeknah te tomthap ham a hinglu a phum.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tloihsoi ah ka manuca rhoek , Boeipa ah omngaih uh. Amah la nangmih taengah kan daek ham he ka yaikat ngawn moenih tedae nangmih te pangkha ham ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ui rhoek te dawn uh, bibikung thae rhoek te dawn uh, maehsah rhoek te dawn uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mamih tah yahvinrhetnah neh n'om uh. Pathen kah Mueihla neh tho aka thueng uh tih Khrih Jesuh ah aka pomsang uh neh pumsa ah aka pangtung pawt rhoek ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai khaw pumsa ah pangtungnah ka khueh van. Khat khat loh pumsa ah pangtung ham a tloe la a poek atah kai loh taoe ka poek ham om.
  </para>
  <para style="p">
    <verse number="5" style="v" />A hnin rhet dongkah yahvinrhetnah neh Israel namtu khuiah Benjamin koca ni he. Hebrew rhoek khuikah Hebrew, olkhueng dongah ka Pharisee coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kohlopnah neh hlangboel te ka hnaemtaek. Olkhueng dongkah duengnah neh cuemthuek la ka om.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tedae kai ham hoeikhangnah balae aka om. He kah sungdaehnah he Khrih ham ni tila ka poek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te lakah ka Boeipa Jesuh Khrih mingnah tanglue kongah a cungkuem te sungdaehnah la om ham ni ka poek bal. Amah ham ka ti ah a cungkuem te ka hlong. Tedae te te aek bangla ka poek daengah ni Khrih te ka dang vetih amah dongah m'hmuh eh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka duengnah he olkhueng lamlong pawt tih Khrih tangnah lamlong ni n'dang. Tekah tangnah te Pathen kah duengnah soah a kungsut.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te tah amah neh amah thohkoepnah dongkah thaomnah aka ming sak tih a patangnah dongah rhoinaengnah neh a dueknah aka rhoii sak la om.
  </para>
  <para style="p">
    <verse number="11" style="v" />Duek khui lamloh thohkoepnah dongah ka pha mak atah ka ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka dang tangtae tih ka rhuemtuet tangtae ngawn moenih. Tedae ka hnuktlak van atah ka pom van ni. Te ham te Khrih Jesuh rhangneh ka pom van coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Manuca rhoek, kai kamah loh pom ham ka poek pawt dae pakhat ah hnuksul te ka hmaai tih a hmaila ka kan.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khrih Jesuh dongah Pathen kah khuenah, soben kah kutdoe ham ni paelkinah te ka hnuktlak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah lungcuei rhoek boeih long tah he tlam he poek uh sih. Pakhat khaw a hlinghlang la na poek uh koinih, te pataeng Pathen loh nangmih taengah a pumphoe sak ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tedae m'pha uh hil te tah amah la m'vai uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Manuca rhoek, kai kah omih aka awt la om uh. Te dongah kaimih kah mueimae na dang uh bangla aka cet rhoek te paelki uh van.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amih kah khokan te nangmih taengah muep ka thui taitu. Tahae ah khaw rhah doeah ka thui dae Khrih thinglam kah rhal la om uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amih kah a bawtnah tah pocinah ni. Amih kah pathen tah bungpuei la poeh tih thangpomnah tah amih kah yahkoi dongah a om pah. Te rhoek loh diklai koe te a poek uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tedae mamih kah pilnam tah vaan ah ni a om. Te lamkah khangkung Boeipa Jesuh Khrih te n'lamtawn uh bal.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah loh mamih kah mathoe pum he amah kah thangpomnah pum phek la a tho ni. Bibi a noeng van bangla a cungkuem te amah taengah boe a ngai sak pataeng.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah, kai kah omngaihnah rhuisam, ka manuca te ka thintloh tih kan ngaidam. Te vanbangla thintlo rhoek aw Boeipa dongah pai uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Evodia te ka hloep tih Boeipa ah amah la poek ham Suntuki khaw ka hloep.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ue namah khaw kan dawt. Hmantang ah yingyawn lamtah amih te talong pai. Amih loh olthangthen dongah kai taengah m'puei uh coeng. Kalemen neh a tloe rhoek te khaw kamah kah bibipuei rhoek pai ni. Amih kah ming tah hingnah cabu dongah om coeng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Boeipa ah omngaih uh taitu lah. Koep ka thui eh omngaih uh lah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangmih kah kodo te hlang boeih taengah ming sak. Boeipa tah yoei coeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawn uh boeh, tedae a cungkuem dongah thangthuinah neh rhenbihnah khaw uemonah neh na bihhoenah te Pathen taengah phoe saeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Te vaengah lungbuei boeih lakah aka tanglue Pathen kah ngaimongnah loh nangmih kah thinko neh nangmih kah poeknah te Khrih Jesuh dongah a khoembael bitni.
  </para>
  <para style="p">
    <verse number="8" style="v" />A tloihsoi la manuca rhoek aw, a thuem aka om boeih, a hin aka om boeih, aka dueng boeih, aka cuem boeih, lungloeinah koi boeih, thang aka then boeih, khoboethen neh koehnah ham a mai atah he he poek uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te te kai taengah na cang uh tih na dang uh coeng, na yaak uh tih na hmuh uh coeng. Te te saii uh lamtah ngaimongnah Pathen loh nangmih taengah ha om bitni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah hnukbuet kah ka poek te nan cuen sak coeng dongah Boeipa ah ka omngaih tangkik. Amah te na ngaihlih uh ngawn dae na hloo uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka vawtthoek bangla te khaw ka thui moenih. Kai tah mebang ka tong vaengah khaw ngaikhuek la om ham ka cang coeng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tlarhoel ham khaw ka ming. Khuehtawn ham khaw ka ming. Cungkuem neh cungkuem dongah bunghah ham neh bungpong ham khaw, khuehtawn ham neh vawtthoek ham khaw ka thuep coeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai aka thaphoh kung rhangneh a cungkuem khaw ka thai coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tedae kai kah phacip phabaem dongah na thum uh te a thuem ni na saii uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te phoeiah Philipi rhoek aw, nangmih long khaw olthangthen a tongcuek vaengkah te ming uh. Makedonia lamloh ka caeh vaengah nangmih bueng kah doenah pawt koinih doedannah dongah ol nen pataeng hlangboel loh kai m'boek moenih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thessalonika ah pataeng ka ngoengaih dongah vai khaw hnavoei khaw nan pat uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tete kutdoe ka toem moenih. Tedae nangmih kah olka dongah a thaih te pungtai sak ham ka toem.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tedae a cungkuem te ka dang tih coih. Nangmih lamkah te Epapharoditu taeng lamloh ka dang tih ka rhoeh pataeng. Te te Pathen taengah botui kah a bova, uemo koi neh a doe koi hmueih la om.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tedae ka Pathen loh Khrih Jesuh dongkah thangpomnah neh amah kah khuehtawn tarhing ah na ngoe boeih te han cung sak bitni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Te dongah a Pa Pathen te kumhal duela thangpomnah om saeh. Amen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesuh Khrih ah hlangcim boeih te toidal uh. Ka taengkah manuca rhoek loh nangmih te kut n'tuuk uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmih hlangcim rhoek boeih neh olpuei la Kaisar im kah rhoek loh kut kan tuuk uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Boeipa Jesuh Khrih kah lungvatnah tah nangmih kah Mueihla neh om saeh.
  </para>
</usx>
