<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2TH" style="id">2 Thessalonika</book>
  <para style="h">2 Thessalonika</para>
  <para style="toc1">2 Thessalonika</para>
  <para style="toc2">2 Thessalonika</para>
  <para style="mt">2 Thessalonika</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paul, Silvanas neh Timothy loh Thessalonika kah hlangboel te a pa Pathen neh Boeipa Jesuh Khrih ah kan yaak sakuh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A pa Pathen neh Boeipa Jesuh Khrih lamkah lungvatnah neh ngaimongnah nangmih taengah om saeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Manuca rhoek nangmih ham Pathen te uem yoeyah ham ka kuek uh. Te tla a om tueng pai. Nangmih kah tangnah te rhoeng khunghak tih nangmih boeih pakhat rhip lungnah tah pakhat taengla pungtai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangmih kah uehnah neh nangmih taengkah hnaemtaeknah, phacip phabaem boeih khaw tangnah neh na yaknaem uh. Te dongah kaimih khaw Pathen kah hlangboel rhoek lakliah nangmih ham ka pomsang uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathen kah aka dueng laitloeknah te a mingphanah ni. Pathen ram neh na tiing uh ham dongah te ham te na patang uh van.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmaitak khuiah amah kah thaomnah puencawn rhoek neh vaan lamkah Boeipa Jesuh kah a pumphoenah dongah,
  </para>
  <para style="p">
    <verse number="7" style="v" />phacip phabaem neh nangmih aka lawn rhoek khaw, hlang aka lawn nangmih khaw, kaimih taengkah hilhoemnah neh sah ham he Pathen hmaiah dueng ngawn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathen aka ming pawt rhoek neh mamih Boeipa Jesuh kah olthangthen aka ngai pawt rhoek te kutthungnah a paek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te rhoek tah Boeipa mikhmuh lamkah neh a thadueng kah thangpomnah lamloh kumhal rhawpnah te dantatnah la a paek ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ha pawk vaengah a hlangcim rhoek neh thangpom uh vetih aka tangnah rhoek boeih khuiah a ngaihmang uh ni. Tekah khohnin ah nangmih taengah kaimih kah laipai te a tangnah uh coeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah nangmih ham khaw ka thangthui uh taitu. Te daengah ni mamih kah Pathen loh n'khuenah neh na tingtawk uh vetih boethennah kah kolonah neh saithainah loh tangnah bibi boeih a soep sak eh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te daengah ni nangmih ah mamih Boeipa Jesuh ming te a thangpom vetih mamih kah Pathen neh Boeipa Jesuh Khrih kah lungvatnah bangla amah ah nangmih khaw n'thangpom eh.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Te dongah manuca rhoek mamih kah Boeipa Jesuh Khrih a lonah ham neh amah taengah mamih tingtunnah ham nangmih te kan hloep uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaimih loh mueihla nen khaw, olka nen khaw, capat nen khaw Boeipa kah khohnin te aka pai coeng bangla ka thui uh te nangmih lungbuei tarha hinghoek tih let ham moenih.
  </para>
  <para style="p">
    <verse number="3" style="v" />A longim pawt ah pakhat long khaw nangmih n'hoilae boel saeh. Phaelhnah te ha pawk lamhma vetih pocinah kah a capa olaeknah hlang loh a pumphoe hlan atah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Te long te Pathen a ti boeih neh bawknah soah kingkalh uh tih pomsang uh. Pathen kah bawkim ah amah ngol ham amah te Pathen ni tila tai uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangmih neh n'om vaengah he he nangmih ham ka thui te na poek uh mahnim?
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih te amah tuetang ah pumphoe sak ham aka khoh te khaw na ming uh coeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Olhuep tah olaeknah dongah tueng coeng. Tedae a khui lamloh a saii hlan ah te long te hnap a tuuk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Te phoeiah lailak te khaw pumphoe ni. Anih te Boeipa Jesuh amah ka kah hil neh a ngawn vetih amah a lonah kah a phoenah loh a thup ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Te kah Satan kah bibi lamloh a lonah la a om dongah saithainah neh miknoek boeih, laithae kah khobae rhambae neh ha pawk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Te dongah boethae kah hmilhmaknah cungkuem neh poci uh tih oltak kah lungnah dongah amih khang ham te doe uh pawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Te dongah amih loh laithae te a tangnah uh ham Pathen loh amih taengah aka tlung tholhhiknah he khaw a tueih pah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te daengah ni oltak aka tangnah pawt tih boethae dongah lung aka tlun rhoek boeih lai a tloek eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae Boeipa loh a lungnah manuca rhoek, kaimih loh nangmih ham Pathen te ka uem uh ham a kuek yoeyah. Mueihla kah cimcaihnah neh oltak tangnah dongkah khangnah ham Pathen loh nangmih te thaihcuek la n'tuek coeng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Te ham ni kaimih kah olthangthen rhangneh nangmih khaw n'khue. Te t ah mamih Boeipa Jesuh Khrih kah thangpomnah te dangnah ham ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Te dongah manuca rhoek pai uh van laeh. Kaimih kah olka lamloh, capat lamloh n'thuituen nah singyoe te muk uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah mamih kah Boeipa Jesuh Khrih neh mamih kah pa Pathen loh mamih n'lungnah tih dungyan thaphohnah neh lungvatnah dongkah ngaiuepnah then te m'paek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmih thinko te han hloep saeh lamtah bibi takuem neh olka then dongah cawt n'duel saeh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tloihsoi ah manuca rhoek kaimih ham thangthui uh. Te daengah ni Boeipa kah olka loh ha yong vetih nangmih taengkah vanbangla a thangpom eh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Te daengah ni aka lang neh hlang thae taeng lamloh n'hlawt eh. Tangnah he boeih a khueh uh moenih,
  </para>
  <para style="p">
    <verse number="3" style="v" />Tedae Boeipa tah uepom la om, Amah loh nangmih n'duel vetih a thae lamkah n'hoeptlang bitni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangmih ham boeipa dongah ka pangtung uh. Kang uen te na saii uh tih na saii uh bal bitni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Boeipa loh nangmih kah thinko te Pathen kah lungnah neh Khrih kah uehnah khuila hoihaeng saeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Manuca rhoek nangmih te mamih kah Boeipa Jesuh Khrih ming neh kang uen uh. Vapsa la aka pongpa tih manuca boeih te na rhael uh. Te dongah tebang singyoe te kaimih lamkah na dang uh moenih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaimih nan awt uh ham bahoeng a kuek te nangmih loh na ming uh. Nangmih taengah ka cungpoeh uh pawt tih pakhat kah buh yoe khaw ka caak uh moenih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tedae thakthaenah, patangnah neh khoyin khothaih ka saii uh tih nangmih khuikah pakhat khaw thinrhih sak moenih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Saithainah ka khueh uh pawt dongah moenih. Tedae te nen ni kaimih nan awt uh ham te mueimae la kamamih ka hmoel uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmih taengah ka om uh vaengah pataeng nangmih te he ni kang uen uh. Khat khat long ni bi saii a ngaih pawt atah ca van boel saeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmih khuikah hlangvang tah vapsa la a pongpa uh te ka yaak uh. Bi tah saii uh pawt dae tomban la om uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Te tlam te Boeipa Jesuh Khrih ah kang uen uh tih kan hloep uh. Te daengah ni kammueh la aka saii rhoek loh amah buh te a caak uh eh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tedae manuca rhoek nangmih tah a then te thathae uh boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khat khat loh capat dongkah kaimih ol te a ngai pawt atah anih te kuem uh. Anih te na rhoinaeng puei pawt daengah ni a. yah eh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tedae rhal bangla poek boel lamtah manuca bangla rhalrhing sakuh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tahae ah ngaimongnah boeipa amah loh a longim boeih neh a cungkuem lamloh nangmih te ngaimongnah m'pae saeh. Boeipa tah nangmih boeih taengah n'om puei saeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuttuknah he tah, Paul kamah kut ni. Capat boeih dongah miknoek aka om te ka daek tangloeng coeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mamih kah Boeipa Jesuh Khrih lungvatnah tah nangmih taengah boeih om saeh.
  </para>
</usx>
