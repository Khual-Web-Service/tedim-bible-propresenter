<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Palungha Lok</book>
  <para style="h">Palungha Lok</para>
  <para style="toc1">Palungha Lok</para>
  <para style="toc2">Palungha Lok</para>
  <para style="mt">Palungha Lok</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Haenawk loe Israel siangpahrang, David capa, Solomon ih palungha lok ah oh;
  </para>
  <para style="p">
    <verse number="2" style="v" />palungha lok mah palunghahaih, thuitaekhaih hoi kathuk lokhlongnawk panoekhaih to na paek tih;
  </para>
  <para style="p">
    <verse number="3" style="v" />thuitaek thaihaih, katoeng ah lokcaekhaih, kangvan ah lok takroekhaih to na hnu tih;
  </para>
  <para style="p">
    <verse number="4" style="v" />kami rumramnawk khaeah palunghahaih to paek ueloe, thendoeng mah panoekhaih hoi poek thaihaih to tawn tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palungha kami loe lok tahngai ueloe, panoekhaih to pung tih; panoekhaih tawn kami loe palungha kami mah thuih ih lok to talawk tih;
  </para>
  <para style="p">
    <verse number="6" style="v" />palungha lok hoi patahhaih loknawk, palungha kami mah thuih ih palunghahaih lok hoi kathuk loknawk to panoek thai hanah,
  </para>
  <para style="p">
    <verse number="7" style="v" />Sithaw zithaih loe palunghahaih takung ah oh; toe amthu mah loe palunghahaih hoi thuitaekhaih to patoek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka capa, nam pa thuitaekhaih lok to tahngaih loe, nam no mah patukhaih to pahnawt sut hmah.
  </para>
  <para style="p">
    <verse number="9" style="v" />To tiah thuitaekhaih hoi patukhaih loe na lu hanah apawk lumuek baktih, na tahnong hanah bungmu ah om tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka capa, kami zaenawk mah na zoek cadoeh, nihcae ih lok to tahngai hmah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae mah, Kaicae hnuk ah na bang ah, kami athii palong hanah zing si loe, zaehaih tawn ai kaminawk to angang si;
  </para>
  <para style="p">
    <verse number="12" style="v" />nihcae to taprong baktih, tangqom thungah caeh kaminawk baktiah, kahing ah paaeh boih si;
  </para>
  <para style="p">
    <verse number="13" style="v" />to tiah nahaeloe atho kana hmuenmae to a hnu o ueloe, aicae ih im doeh minawk khae hoi lomh ih hmuenmae hoiah koi tih;
  </para>
  <para style="p">
    <verse number="14" style="v" />kaicae hoi nawnto taham khethaih phoisa to va ah; a hnuk o ih phoisa doeh kangvan ah amzet si, tiah na naa o cadoeh,
  </para>
  <para style="p">
    <verse number="15" style="v" />ka capa, nihcae hnukah bang hmah; nihcae caehhaih loklam ah caeh hmah:
  </para>
  <para style="p">
    <verse number="16" style="v" />nihcae loe zaehaih sak hanah cawnh o moe, athii palong hanah angtawt rang o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tavaa mah hnuk naah palok payang nahaeloe tih atho maw om tih!
  </para>
  <para style="p">
    <verse number="18" style="v" />To baktih kaminawk loe angmacae athii long hanah zing o moe, angmacae hinghaih lak han ih ni angang o!
  </para>
  <para style="p">
    <verse number="19" style="v" />Amsoem ai ah hmuen hak koeh hmoek kaminawk boih loe, hnukkhuem ah angmacae hinghaih to ni a lak o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palunghahaih loe tasa bangah hangh moe, loklamnawk ah tha hoiah a hangh;
  </para>
  <para style="p">
    <verse number="21" style="v" />kami angpophaih ahmuennawk hoi vangpui khongkhanawk ah a hangh; vangpui thungah a hang ih loknawk loe,
  </para>
  <para style="p">
    <verse number="22" style="v" />nangcae kami rumramnawk, khosak rumramhaih to nasetto maw na palung o han vop? Nangcae loe minawk mah pahnuithuihaih to na koeh o, amthu kaminawk loe palunghahaih to nasetto maw hnuma o vop tih?
  </para>
  <para style="p">
    <verse number="23" style="v" />Kang thuitaek o haih lok hae tahngai oh loe, amlaem oh; khenah, ka muithla nangcae nuiah ka kraih moe, ka thuih ih loknawk to kang panoek o sak han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kang kawk o naah, nang maak o; ka ban payangh naah, tidoeh nang sah o ai;
  </para>
  <para style="p">
    <verse number="25" style="v" />kang thuih ih lok to tidoeh na sah o ai moe, kang thuitaek o haih lok doeh na tahngai o ai pongah,
  </para>
  <para style="p">
    <verse number="26" style="v" />raihaih na tongh o naah kang pahnuih thuih moe, zithaih na tongh o naah,
  </para>
  <para style="p">
    <verse number="27" style="v" />na nuiah raihaih mah takhi sae baktiah phak moe, amrohaih mah takhi kamhae baktiah angzoh thuih naah, palungsethaih hoi raihaih mah na nuiah krak thuih naah doeh kang pahnui o thuih toeng han:
  </para>
  <para style="p">
    <verse number="28" style="v" />Kai nang kawk o naah, kang pathim o mak ai; nihcae mah kai to pakrong o tih, toe na hnu o mak ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae loe palunghahaih to hnukma o, Angraeng zithaih to qoi o ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka thuih ih lok to nihcae mah tahngai o ai, ka zoehhaih loknawk boih doeh patoek o.
  </para>
  <para style="p">
    <verse number="31" style="v" />To pongah nihcae mah a caeh o haih loklam ih athaih to caa o ueloe, sak han a poek o ih hmuen hoiah koi o tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Poekhaih tawn ai kaminawk loe loklam amkhraeng o moe, duek o; amthu kaminawk khosakhoihaih loe angmacae amrohaih ah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe ka lok tahngai kami loe ngancuem ueloe, kasae zithaih om ai ah monghaih hoiah khosah tih.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka capa, kang thuih ih lok to na tahngaih moe, kang paek ih loknawk palung thungah na pakuem nahaeloe,
  </para>
  <para style="p">
    <verse number="2" style="v" />palunghahaih bangah na naa to patuengh loe, panoekhaih bangah na palung to paek ah;
  </para>
  <para style="p">
    <verse number="3" style="v" />ue, panoekhaih hnuk hanah na hangh, panoek thai hanah tha hoiah na hangh moe,
  </para>
  <para style="p">
    <verse number="4" style="v" />sumkanglung pakrong baktiah na pakrong pacoengah, hawk ih hmuen baktiah na pakrong nahaeloe,
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng zithaih to na panoek ueloe, Sithaw palunghahaih to na hnu tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng mah palunghahaih to paek, palunghahaih hoi panoekhaih loe anih pakha hoiah ni tacawt.
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng kaminawk hanah palughahaih to paek moe, toenghaih hoiah lamcaeh kaminawk hanah anih loe abuephaih ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Katoeng kaminawk caehhaih loklam to anih mah toep moe, oepthok angmah ih kaminawk to pakaa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To tiah ni toenghaih, katoengah lokcaekhaih, kangvan ah lok takroekhaih to na panoek ueloe, kahoih loklamnawk to na panoek tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palunghahaih mah na palungthin to paongh naah, panoekhaih loe na pakhra anghoesakkung ah om tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Panoekthaihaih mah na pakaa ueloe, na panoekhaih mah na toep tih;
  </para>
  <para style="p">
    <verse number="12" style="v" />palunghahaih mah loe toenghaih loklam amkhraeng taak kami, vinghaih thungah caeh kami, kahoih ai kami caehhaih loklam hoi katoengah lokthui ai kami ih ban thung hoiah pahlong tih;
  </para>
  <para style="p">
    <verse number="14" style="v" />hmuensae sakhaih bangah kanawm panoek moe, kasae kaminawk mah sak ih katoeng ai hmuen ah kanawm acaeng kami,
  </para>
  <para style="p">
    <verse number="15" style="v" />toenghaih loklam ah caeh ai, loklam kangkoih ah caeh kaminawk ban thung hoiah pahlong ueloe,
  </para>
  <para style="p">
    <verse number="16" style="v" />zaehaih sak koeh nongpata, kami zoek thaih nongpata khae hoiah doeh pahlong tih;
  </para>
  <para style="p">
    <verse number="17" style="v" />to baktih nongpata loe tangla nathuem ah thuitaekhaih lok to pahnawt moe, a Sithaw hmaa ah sak ih lokmaihaih pahnet ving kami ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />To nongpata ih im loe duekhaih bangah laemh tathuk moe, kadueh kami pakhranawk caehhaih loklam bangah a caeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih khaeah caeh kaminawk boih loe, mi doeh amlaem o ai boeh, hinghaih loklam doeh hnu o ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang loe kahoih kaminawk ih loklam to pazui ah loe, katoeng kaminawk ih loklam ah caeh poe ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Katoeng kami loe prae thungah khosah ueloe, coek koi om ai kami loe to prae thungah om poe tih,
  </para>
  <para style="p">
    <verse number="22" style="v" />toe kasae kaminawk loe prae thungah om o thai mak ai, zaehaih sah kaminawk loe prae thung hoiah haek o ving tih.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka capa, kang patukhaih lok hae pahnet hmah, kang paek ih lok hae palung thungah pakuem ah;
  </para>
  <para style="p">
    <verse number="2" style="v" />nang hanah hing sawkhaih hoi monghaih na paek tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahmenhaih hoi loktang to caeh taak hmah; nangmah ih tahnong ah a oih ah loe, na palung cabu pongah tarik ah:
  </para>
  <para style="p">
    <verse number="4" style="v" />to tih nahaeloe Sithaw hmaa hoi kami hmaa ah mikhmai hnu ueloe, ahmin hoihaih na hnu tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na palungthin boih hoi Angraeng oephaih to tawn ah; na panoekhaih pongah amha hmah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na caehhaih loklam kruekah anih to panoek ah, to tih nahaeloe na caehhaih loklam na hnusak tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na mikhnuk ah palungha baktiah om hmah; Angraeng to zii ah loe, hmuensae to caeh taak ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />To tih nahaeloe na thaquinawk ngantui o ueloe, na huhnawk doeh thacak o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na tawnh ih hmuen, thingthai tangsuek hoiah Angraeng to pakoeh ah:
  </para>
  <para style="p">
    <verse number="10" style="v" />to tiah na sak nahaeloe nang ih tapupnawk cang hoiah koi amthlai o ueloe, misurtui suekhaih muroihnawk doeh misurtui kangtha hoiah koi amthlai o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka capa, Angraeng thuitaekhaih to patoek hmah; ang zoehhaih lok pongah doeh palung naa hmah:
  </para>
  <para style="p">
    <verse number="12" style="v" />palung ih capa loe ampa mah thuitaek baktih toengah, Angraeng mah palung ih kami loe thuitaek ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Palunghahaih pakrong moe, panoekhaih tawn kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palunghahaih loe sumkanglung pongah atho oh kue moe, sui pongah doeh hoih kue.
  </para>
  <para style="p">
    <verse number="15" style="v" />Atho kaom thlung kathim pongah doeh atho nat kue, na koeh ih hmuennawk boih hoiah doeh patah thai ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />A bantang bangah hingsawkhaih to a suek, banqoi bangah loe angraenghaih hoi khingyahaih to a suek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Palunghahaih loklam loe nawm moe, a caehhaih loklamnawk boih ah monghaih to oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palunghahaih loe palunghahaih patawn kami hanah hinghaih thingkung ah oh; palunghahaih tawn kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng mah long hae palunghahaih hoiah ni sak; vannawk doeh panoekhaih hoiah a suek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kathuk parai tuipuinawk to a palunghahaih hoiah tapraek moe, tamai thung hoiah dantuinawk to a kraksak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka capa, palunghahaih hoi panoekhaih to na hmaa hoiah amkhraengsak ving hmah; pakuem poe ah.
  </para>
  <para style="p">
    <verse number="22" style="v" />To tiah na sak nahaeloe na pakhra hinghaih ah om ueloe, na tahnong kranghoihaih bungmu ah om tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kholong caeh naah raihaih na tawn mak ai; khok doeh na pathuih mak ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na iih naah zithaih na tawn mak ai; ue, kahnaep ah na iip thai tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tasoehhaih na tawn mak ai, kahoih ai kaminawk mah parohaih doeh na tong mak ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng loe nam haahaih ah om ueloe, dongh pongah amanh han ai ah na khoknawk to patawn tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na ban ah sakthaihaih na tawnh naah, kahoih hmuen sak pae han krak, tiah na poek ih kami nuiah kahoih hmuen to sah ai ah om hmah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na imtaeng kami han paek koi hmuen na tawnh, toe anih khaeah vaihi loe amlaem raeh, khawnbang nang zoh let naah kang paek han hmang, tiah thui hmah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang oephaih hoiah khosah na imtaeng kami khaeah, kasae sak han atim hmah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na nuiah sethaih sah ai kami to, tidoeh na ai ah zoeh hmah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pacaekthlaek kami ih hmuen to ut hmah loe, a caehhaih loklam to awt hmah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Poek angkawnh kaminawk loe Angraeng mah panuet; toe poektoeng kaminawk loe angmah hoi nawnto angkomhaih to a sak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Angraeng tangoenghaih loe kahoih ai kaminawk imthung ah phak, toe katoeng kaminawk ohhaih ahmuen loe Angraeng mah tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="34" style="v" />Minawk pahnui thuih kami to anih mah pahnui thuih toeng, toe kami tlim ah khosah kaminawk khaeah loe tahmenhaih to a paek.
  </para>
  <para style="p">
    <verse number="35" style="v" />Palungha kaminawk loe lensawkhaih to toepsak; toe amthu kaminawk loe azatsak.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka caanawk, ampa thuitaekhaih lok to tahngai oh; panoekhaih tawnh hanah kahoih ah tahngai oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Patukhaih kahoih kang paek o, to pongah kang patuk ih lok hae pahnawt o hmah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kam pa hanah kai loe nawkta ah ka oh, kam no han loe palung ih capa, nawkta ah ka oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kam pa mah kang thuih ih loknawk hae palung thungah suem ah, kang paek ih loknawk hae pakuemh loe, hing haih ah, tiah ang patuk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palunghahaih to amtuk ah loe panoekhaih to cang ah; pahnet hmah loe, ka thuih ih loknawk hae angqoi taak hmah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Palunghahaih to pahnawt hmah, palunghahaih mah ni nang to pakaa tih; palunghahaih to palung ah, to tih nahaeloe palunghahaih mah na toep tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Palunghahaih loe lokpui ah oh; to pongah palunghahaih to amtuk ah; nam tuk ih hmuennawk boih thungah panoekhaih to amtuk oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palunghahaih to lokpui ah suem ah; to tih nahaeloe anih mah na qoengsak tahang tih; anih to na patawnh caeng nahaeloe, khingzahaih na hnu tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na lu ah tahmenhaih lumuek hoiah zaeng ueloe, lensawkhaih angraeng lumuek to angmueksak tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka capa, ka thuih ih lok hae tahngaih loe, tapom ah; to tih nahaeloe na hinghaih saning to sawk tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palunghahaih loklam to kang patuek o moe, katoeng loklam ah kang caeh o haih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na caeh o naah lam tamcaek ah na pha o mak ai; na cawnh o naah doeh nam thaek o mak ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuitaekhaih lok hae patawn caeng ah, kangthla ah caehsak hmah; na hinghaih ah oh pongah, kahoih ah pakuem ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasae kaminawk ih loklam ah khok takan hmah loe, kasae kaminawk ih loklam to pazui hmah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Caeh hmah, ayae ah; amlaem taak ah loe, angqoi taak ving ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />To baktih kaminawk loe kasae hmuen sah ai ah loe iip o thai ai; thoemto kaminawk loe amtimsak ai ah loe iip o thai ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae loe sethaih takaw to caak o moe, athii longhaih misurtui to a naek o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Katoeng kami ih loklam loe ni aengh baktiah oh moe, khodai khoek to aang aep aep.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe kasae kami ih loklam loe khoving baktiah ving; tih mah maw nihcae to amtimsak, tito panoek o ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka capa, ka thuih ih loknawk hae tahngai ah; ka thuih ih loknawk bangah naa to patueng ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na mik hoi kangthla ah suem hmah, na palung thungah suem ah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hae tiah patukhaih loe hnu kaminawk hanah hinghaih ah oh moe, taksa ngantuihaih ah oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Palung loe hinghaih lokpui koekah oh pongah, na palung to kahoih ah khenzawn ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Oep om ai lok to pakha thung hoiah tacawtsak hmah loe, angaek thaih pahni to kangthla ah suem ah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na mik mah hmabang to katoeng ah khen nasoe, na hmaa to kahoih ah dan ah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na caehhaih loklam to poek ah, na loklamnawk boih to caksak ah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bangqoi bantang angqoi hmah; sethaih thungah caeh han ai ah ayae ah.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka capa, ka palunghahaih lok hae tahngaih loe, ka panoekhaih to pakuem ah;
  </para>
  <para style="p">
    <verse number="2" style="v" />to tih nahaeloe hmuen panoekhaih na tawn ueloe, na pahni mah panoekhaih to pakuem tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zaehaih sak koeh nongpata ih pahni loe khoitui baktiah long moe, a thuih ih lok doeh situi pongah amnae kue;
  </para>
  <para style="p">
    <verse number="4" style="v" />toe anih boenghaih loe ahmuet baktiah khaa moe, haa hnetto kaom sumsen baktiah noet.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih ih khoknawk loe duekhaih bangah anghum tathuk moe, a caehhaih loklam doeh hell ah akunh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih loe hinghaih loklam to poek ai, a caehhaih loklamnawk loe cak ai, loklam doeh panoek ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah ka caanawk, ka lok hae tahngai oh; ka thuih ih lok hae angqoi o taak hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />To nongpata to kangthla ah caeh o taak ah loe, a im ih thok taengah doeh caeh o hmah;
  </para>
  <para style="p">
    <verse number="9" style="v" />to tih ai nahaeloe pakoeh ah na ohhaih to minawk khaeah paek ving ueloe, na hinghaih saningnawk doeh tahmenhaih tawn ai kaminawk khaeah na paek ving moeng tih;
  </para>
  <para style="p">
    <verse number="10" style="v" />nang ih hmuenmae hoiah kalah kaminawk ih zok to koi lat ueloe, toksak hoiah na hak ih hmuennawk to minawk im ah cawn ving tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na takpum hoi na ngan to qongh naah, palungset hoiah na om sut tih,
  </para>
  <para style="p">
    <verse number="12" style="v" />to naah kawbangmaw thuitaekhaih to ka hnukma moe, zoehhaih lok doeh ka palung mah patoek boeh;
  </para>
  <para style="p">
    <verse number="13" style="v" />kai patukkungnawk ih lok to ka tahngai ai, nihcae mah patuk ih loknawk doeh ka tahngai ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kai loe amkhueng kaminawk salakah kasae kami ah ni ka oh boeh, tiah na thui tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmah ih tui tabu thung ih tui to nae ah loe, nangmah ih tuikhaw thung ih tui to nae ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tuipuek to ahmuen kruekah long nasoe, vapui tuinawk baktiah loklam boih ah longsak ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmah han khue long nasoe, minawk kalah han pazet hmah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tuipuek loe tahamhoihaih om nasoe loe, na thendoeng nathuem ih zu hoiah kanawm ah khosah ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih loe palung koi kaom tasuk amno, koeh koi kaom tasuk baktiah om nasoe loe, anih ih tahnu mah na koehhaih to koepsak poe nasoe; ang palunghaih mah na palung to dipsak nasoe.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka capa, tipongah zaehaih sak koeh nongpata to na koeh moe, tangzat zaw nongpata to na takoih loe?
  </para>
  <para style="p">
    <verse number="21" style="v" />Kami caehhaih loklamnawk loe Angraeng hmaa ah ni oh, a caehhaih loklamnawk boih Angraeng mah hnuk pae.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kasae kami loe a sakpazaehaih hmuen pongah aman ueloe, a zaehaih quinawk mah anih to zaeng caeng tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih amthuhaih loe nung parai pongah anih loe loklam amkhraeng ving ueloe, thuitaekhaih om ai ah dueh tih.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka capa, nam pui ih laiba pathok pae hanah lokkamhaih to na sak moe, minawk kalah abomh hanah lokkamhaih na sak moeng pongah,
  </para>
  <para style="p">
    <verse number="2" style="v" />na thuih ih lok pongah na manh moe, na pakha hoi tacawt lok mah na naeh moeng nahaeloe,
  </para>
  <para style="p">
    <verse number="3" style="v" />ka capa, nam pui ih ban thungah na krakhaih hoiah na loih thai hanah hae tiah sah ah; nam pui khaeah, Caeh loe, poeknaemhaih hoiah anih tlim ah om paeh; nam pui ban thung hoi loih thai hanah tahmenhaih hni ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mik to iipsak hmah loe, angamsak hmah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Moi kat kami ih ban thung hoiah kaloih tasuk baktih, dongh patung kami ih ban thung hoiah kaloih tavaa baktiah nangmah hoi nangmah to loih ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang thasae kami, cahmat khaeah caeh ah, a caehhaih loklamnawk to khen ah loe, palungha ah;
  </para>
  <para style="p">
    <verse number="7" style="v" />cahmat loe lam patuekkung hoi thuitaekkung tawn ai, ukkung doeh tawn ai,
  </para>
  <para style="p">
    <verse number="8" style="v" />toe anih loe nipui tue hoi caang aah tue ah rawkcak to patung.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw thasae kami, nasetto maw na iih han vop? Natuek naah maw iihhaih ahmuen hoiah nang thawk han?
  </para>
  <para style="p">
    <verse number="10" style="v" />Atue setta thungah na iih moe, atue setta thungah na ngam, nawnetta thung nang hak moe, na ban pakhuem duem nathung ah;
  </para>
  <para style="p">
    <verse number="11" style="v" />kholong caeh kami baktiah amtanghaih mah na patom ueloe, vawthaih mah maiphaw sin kami baktiah na patom tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kasae kami hoi amram aak kami loe lok amlai hoiah ni khosak o;
  </para>
  <para style="p">
    <verse number="13" style="v" />minawk aling hanah mikpakhrip thuih, khok hoiah angmathaih a paek moe, banpazungnawk hoiah patuk o;
  </para>
  <para style="p">
    <verse number="14" style="v" />anih loe palung thungah alinghaih to koi moe, kahoih ai poekhaih to vaa thai ai, maeto hoi maeto misa angcoengsak hanah a poek.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah nihcae loe poek ai pui hoi amrohaih mah pha thui tih; abuephaih om ai ah nawnetta thung amro tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah hnukma ih hmuen tarukto oh; ue, panuet thok hmuen sarihto oh;
  </para>
  <para style="p">
    <verse number="17" style="v" />amoek kami ih mik tamdai, amsawnlok thui thaih palai, zaehaih tawn ai kami humhaih ban,
  </para>
  <para style="p">
    <verse number="18" style="v" />kasae poekhaih palungthin, hmuesae sakhaih bangah caeh karang khok,
  </para>
  <para style="p">
    <verse number="19" style="v" />amsawnlok pongah hnukungah kaom, nawkamya poek amkhraeng han sah kaminawk hae ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka capa, nam pa lokpaekhaih to pakuemh loe, nam no patukhaih doeh pahnawt hmah;
  </para>
  <para style="p">
    <verse number="21" style="v" />na palung thungah zaeng ah loe, na tahnong ah kom caeng ah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na caehhaih loklam to anih mah patuek tih; na iih naah na toep ueloe, nang lawt naah, lok na thui tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lokpaekhaih loe hmaithaw ah oh; patukhaih lok loe aanghaih ah oh; zae thuitaekhaih loe hinghaih loklam ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kahoih ai nongpata, lok hoiah minawk kazoek thaih nongpata khae hoiah na pakaa tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nongpata kranghoihaih to khit hmah, a mik pakhriphaih pongah aman hmah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tangyat zawhhaih hoiah takaw kae maeto ni qan thai tih; sava laep ah zaehaih sah nongpata loe atho kana hinghaih to amrosak thaih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kami mah angmah ih saoek hmai hoi thlaek naah, angmah ih laihaw to hmai mah kangh mak ai maw?
  </para>
  <para style="p">
    <verse number="28" style="v" />Kami mah hmai nuiah caeh naah, a khok to hmai mah kangh mak ai maw?
  </para>
  <para style="p">
    <verse number="29" style="v" />Na imtaeng kami ih zu khaeah caeh kami doeh to tiah oh; mi kawbaktih doeh to nongpata sui kami loe, zaehaih hoiah loih thai ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zok amthlam pongah zok amthlamhaih dipsak hanah paqu kami loe, mi mah doeh kasae thui mak ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kamqu to naeh naah alet sarihto pathoksak moe, a tawnh ih hmuennawk boih paeksak han oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe zu laep ah nongpata hoi zaehaih sah kami loe, poekhaih tawn ai kami ah ni oh; to kami loe a hinghaih amrosak kami ah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih to bop o tih, a nuiah khingyahaih tawn o mak ai; anih kasae thuihaih loe boeng thai mak ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zu nuiah palung haenghaih mah sava to palungphuisak; to pongah danpaekhaih tue phak naah tahmenhaih roe tawn mak ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kawbaktih ronghaih phoisa doeh koeh mak ai, tangqum paroeai paek cadoeh palungphui dip mak ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka capa, ka thuih ih loknawk hae pakuem ah, kang paek ih loknawk to palung thungah suem ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kang paek ih loknawk to pakuemh loe, hing haih ah; kang patuk ih lok to na mikmu baktiah suem ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na banpazung nuiah komh loe, na palung thungah tarik ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Palunghahaih khaeah, Nang loe ka tanuh baktiah na oh, tiah thui ah loe, panoekhaih khaeah, Nang loe ka canawk baktiah na oh, tiah thui ah;
  </para>
  <para style="p">
    <verse number="5" style="v" />to tiah na sak nahaeloe zaehaih sak koeh nongpata, minawk zoek thaih nongpata ban thung hoiah na pakaa tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka im thokbuem hoi ka khet naah ka hnuk ih hmuen loe,
  </para>
  <para style="p">
    <verse number="7" style="v" />poekhaih tawn ai kami rumramnawk thungah ka khet naah, thendoengnawk thungah, poekhaih tawn ai thendoeng maeto ka hnuk.
  </para>
  <para style="p">
    <verse number="8" style="v" />To kami loe nongpata ohhaih loklam im takii bang hoiah to nongpata ohhaih im bangah a caeh,
  </para>
  <para style="p">
    <verse number="9" style="v" />Duembang khoving, khoving qum taning tue phak naah loe,
  </para>
  <para style="p">
    <verse number="10" style="v" />khenah, tangzat zaw khukbuen angkhuk, minawk kazoek thaih nongpata loe anih hnuk hanah angzoh.
  </para>
  <para style="p">
    <verse number="11" style="v" />To nongpata loe palungthah moe, lok doeh ho parai; anih loe angmah ih im ah doeh om vai ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loe tasa bangah tacawt moe, kami angpophaih loklam, lam takii kruekah minawk to a zing.
  </para>
  <para style="p">
    <verse number="13" style="v" />To nongpata mah anih to naeh moe, a mok; azathaih mikhmai tawn ai ah anih khaeah,
  </para>
  <para style="p">
    <verse number="14" style="v" />misa angdaeh angbawnhaih sak han ka tawnh; vaihniah lokkamhaih ka koepsak boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah nang hnuk hanah kang zoh, palung tang hoi nang to kang pakrong, vaihi loe kang hnuk boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rong congca kaom Izip prae ih, puu kahni hoiah ka iihhaih ahmuen to ka khuk het boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmuihoih tui myrrh, aloe, cinnamon hoiah iihkhun to ka bawh boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angzo ah, khawnbang khodai khoek to amlunghaih hoiah angkom hoi si; amlunghaih hoiah kanawm acaeng hoi si!
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka sava loe im ah om ai, angthla parai kholong ah a caeh ving.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih loe phoisa tabu koi mongah phoisa to pacaeng pongah, khrah akoep ai karoek to im ah amlaem mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lokthuih kophaih hoiah anih to a zoek moe, kanaem lok hoiah anih to pazawk.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih loe boh hanah hoih ih maitaw, thaang kacawh tasuk baktiah to nongpata hnukah bang roep;
  </para>
  <para style="p">
    <verse number="23" style="v" />anih loe panoekhaih tamsi pongah, palaa mah anih ih pathin to kaat ai karoek to, dongh pongah kaman tavaa baktiah a hinghaih to boengsak.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah ka caanawk, ka lok to tahngai oh loe, ka thuih ih lok to pakuem oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />To nongpata hnukah na poekhaih caeh o sak hmah loe, to nongpata ih loklam doeh pazui o hmah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih mah kami paroeai amtimsak boeh; ue, paroeai thacak kaminawk doeh anih mah hum boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih ih im loe hell caehhaih manglai lam ah oh moe, duekhaih imthung ah akun tathuk.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palunghahaih mah kami to kawk ai maw? Panoekhaih mah doeh tha hoi lokthui ai maw?
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih loe hmuensang hoi lamkrung taengah angdoet.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih loe vangpui thung akunhaih khongkha taeng, thoknawk taengah angdoet moe, tha hoi a hangh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw kahing kaminawk, kang kawk o; kaminawk hanah lok ka thuih pae.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw poekhaih tawn ai kami rumramnawk, palunghahaih to panoek oh; Aw amthu kaminawk, panoekhaih palungthin to tawn oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahngai oh, hmuen kahoih kang thuih o han; toenghaih lok to kang thuih o han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka pakha mah loktang lok to thui ueloe, ka pahni mah sethaih to panuet tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka pakha pong ih loknawk boih loe toeng, angkawnh moe, amsoem ai lok maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thaikop kami hanah loe hmuennawk boih to zoi, palunghahaih pakrong kami han loe toenghaih ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sumkanglung pongah loe ka thuitaekhaih hae talawk ah loe, sui pongah loe palunghahaih to qoi ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Atho kana thlung kathim pongah loe palunghahaih to hoih kue, to loe koeh ih hmuennawk boih hoiah patah thai ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka palunghahaih loe acoehaih hoiah amraep pongah, palunghahaih hoi panoekhaih to ohsak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kahoih ai hmuen zithaih loe, Angraeng zithaih ah oh; amoekhaih, poeksanghaih, sethaih loklam hoi lok kangkoiah thuihaih to ka hnukma.
  </para>
  <para style="p">
    <verse number="14" style="v" />Poek kahoih paekhaih hoi palunghahaih loe kai ih ni; kai loe panoekhaih hoi sakthaihaih tha to ka tawnh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Siangpahrangnawk loe kai rang hoiah ni angraeng tangkhang nuiah anghnut o moe, katoeng patukhaih to angraengnawk mah pazui o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai rang hoiah angraeng capanawk, angraengnawk hoi lokcaekkungnawk mah, long kaminawk to uk o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai palung kaminawk to ka palung, palung tang hoi kai pakrong kaminawk mah loe kai to ang hnuk o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angraenghaih hoi pakoehhaih loe kai khaeah oh; ue, atue kasawkah kakaan angraenghaih hoi toenghaih doeh oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kai ih athaih loe sui pongah hoih kue; ue, kaciim suitui pongah doeh hoih kue; kai khae hoi hakih hmuen loe, qoih het ih sumkanglung pongah doeh hoih kue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kai loe toenghaih hoi katoeng lokcaekhaih loklam um li ah ka caeh pongah,
  </para>
  <para style="p">
    <verse number="21" style="v" />kai palung kaminawk khaeah qawktoephaih to ka paek, nihcae hmuen patunghaih ahmuen to ka koisak han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai loe canghnii ih hmuennawk sah ai nathuem, a tok sak amtong tangsuek na hoi boeh ni Angraeng ih hmuen ah ka oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai loe long om ai vop, long oh amtong tangsuek nathuem hoiah dungzan ah ang caksak boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuipuinawk om o ai vop, vapui tui doeh long ai naah, kai hae ang tapen boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Maenawk om ai vop, maesomnawk doeh om ai naah, kai hae ang tapen boeh;
  </para>
  <para style="p">
    <verse number="26" style="v" />long hoi tawnawk to sah ai vop, long nui ih maiphu doeh sah ai naah, kai hae ang tapen boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vannawk to sak moe, tuipuinawk hmaa ah kaom hmuennawk to a sak nathuem,
  </para>
  <para style="p">
    <verse number="28" style="v" />van ranui ih tamainawk to a sak moe, tuipui thung ih tuinawk to thacaksak nathuem;
  </para>
  <para style="p">
    <verse number="29" style="v" />a paek ih lok to tui mah poeng thai han ai ah, long angdoethaih ahmuen a sak naah kai ka oh boeh:
  </para>
  <para style="p">
    <verse number="30" style="v" />to naah kai loe anih hoi nawnto qoeng tahang capa baktiah, anih taengah ka oh; ni thokkruek anih anghoehaih ah ka oh; a hmaa ah anghoehaih hoiah ka koi poe;
  </para>
  <para style="p">
    <verse number="31" style="v" />a sak ih long nuiah anghoehaih ka tawnh moe, kami capanawk nuiah doeh oephaih ka tawnh.
  </para>
  <para style="p">
    <verse number="32" style="v" />To pongah Aw ka caanawk, ka lok hae tahngai oh; kai ih loklam pazui kaminawk loe tahamhoih o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kang thuitaekhaih lok to tahngai oh, pahnawt o hmah loe, palungha oh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka lok tahngaih moe, ni thokkruek kai ih khongkhanawk to toep pacoengah, kai ih thok tungnawk taengah zing kami loe, tahamhoih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai hnu kami loe hinghaih to hnuk; Angraeng anghoehaih to a hnuk.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toe ka hmaa ah zaehaih sah kami loe, a hinghaih paro kami ah oh; kai hnuma kaminawk boih loe, duekhaih palung kami ah ni oh o.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palunghahaih mah im tung sarihto a aah moe, ohhaih im to a sak;
  </para>
  <para style="p">
    <verse number="2" style="v" />angmah pacah ih moinawk to a boh; misurtui to a lawn moe, caboi to pahnut.
  </para>
  <para style="p">
    <verse number="3" style="v" />A tok sahkung tanglanawk to patoeh moe, vangpui kasang koek ahmuen ah angdoet pacoengah, a hangh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Poekhaih tawn kaminawk haeah angzo oh; khokhan thai ai kaminawk anih khaeah angzo oh, tiah a kawk,
  </para>
  <para style="p">
    <verse number="5" style="v" />angzo oh, kai ih takaw hae caa oh loe, ka lawn tangcae misurtui hae nae oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na hing hanah, khosak amthuhaih to caeh taak ah loe, palunghahaih loklam to pazui ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kami tiah doeh sah ai kami thuitaekung loe azathaih to tongh moe, kahoih ai kami thuitaekkung doeh kasae thuihaih to tong lat.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami pahnui thuih kami to zoeh hmah, na hnuma lat tih; palungha kami to na zoeh nahaeloe, na palung tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Palungha kami na thuitaek nahaeloe, palungha aep tih; katoeng kami to na patuk nahaeloe, anih amtukhaih to sang aep tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng zithaih loe palungha amtonghaih takung pui ah oh; ciimcai Sithaw panoekhaih loe palunghahaih ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai rang hoiah na hinglung sawk ueloe, na hinghaih saning to pop tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palung na ha nahaeloe palunghahaih atho to na hnu tih; toe minawk khet na patoek nahaeloe, nangmah na zok tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amthu nongpata ih lok loe ham; anih loe poekhaih tawn ai moe, panoekhaih tidoeh tawn ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih loe angmah im thok taengah anghnut moe, vangpui kasang koek ahmuen ah anghnut,
  </para>
  <para style="p">
    <verse number="15" style="v" />katoeng loklam caeh kaminawk to a kawk;
  </para>
  <para style="p">
    <verse number="16" style="v" />poekhaih tawn ai kaminawk khaeah athung bangah angzo oh, tiah a naa; khokhan thai ai kaminawk khaeah loe,
  </para>
  <para style="p">
    <verse number="17" style="v" />paquk ih tui loe luep, tamquta hoi caak ih takaw loe khraem, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe to ahmuen ah loe duekhaih to oh, nongpata mah kawk ih kaminawk loe duekhaih hell thungah ni oh o, tiah nongpa mah panoek ai. p
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solomon palunghahaih lok loe hae tiah oh; palungha caa mah loe ampa to poeknawmsak, kamthu ih caa mah loe amno to palungsetsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amsoem ai ah hak ih hmuen loe atho om ai, toe toenghaih mah loe duekhaih thung hoiah pahlong.
  </para>
  <para style="p">
    <verse number="3" style="v" />Katoeng kami loe zok amthlam moe, duek hanah Angraeng mah asaeng ai; toe kahoih ai kami ih hmuenmae loe amrosak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thasae ban mah anih to amtangsak, thahoih ban mah loe anih to angraengsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nipui tueah caaknaek patung kami loe palungha capa ah oh, cang aah tue ah iip kami loe azathaih paek capa ah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Katoeng kami ih lu ah loe tahamhoihaih to oh; toe kahoih ai kami ih pakha loe athii palonghaih hoiah koi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng kaminawk loe pahnet thai ai pongah tahamhoih o; toe kasae kami ih ahmin loe qong tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palungha palungthin mah loe lokpaekhaih to pazui; toe lok angaek thaih kamthu loe amro tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toenghaih loklam ah caeh kami loe ngancuem tih; toe lam amkhraeng kami loe a poekhaih to amtueng tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uthaih mik pakhriphaih mah kami to raihaih paek, lok angaek thaih kamthu loe amro tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Katoeng kami ih pakha loe hinghaih tuipuek ah oh, toe kasae kami ih pakha loe kahoih ai hmuen hoiah koi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hnukmahaih mah misa angcoengsak, toe amlunghaih mah loe zaehaih boih to khuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Panoekhaih tawn kami ih pahni ah palunghahaih to amtueng, toe panoekhaih tawn ai kami ih kaengah loe quiboeng to oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palungha kami loe palunghaih to patungh, toe amthu kami ih pakha loe amro han zoi daek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng ih tacong loe kacak angmah ih vangpui ah oh; toe amtang kami amtanghaih loe angmah amrohaih ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Katoeng kami toksakhaih atho loe hinghaih ah oh, toe kahoih ai kami ih thingthai mah loe zaehaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thuitaekhaih lok tahngai kami loe hinghaih loklam ah caeh; toe thuitaekhaih lok aek kami loe loklam amkhraeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lok amlaihaih mah hnukmahaih to amtueng ai ah ohsak, minawk kasae thui kami loe kamthu ah ni oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kapop ah lokthuih naah thuih pazaehaih to oh; toe palungha kami loe pahni to ciip.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palungha kami ih palai loe qoih ih sumkanglung baktiah oh; toe kahoih ai kami ih palungthin loe atho om ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Katoeng kami ih pahni mah kami paroeai pacah; toe kamthu loe panoekhaih tawn ai pongah duek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng tahamhoihaih mah angraenghaih to ohsak, to angraenghaih ah loe palungsethaih om ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kamthu loe kahoih ai hmuen nuiah anghoe, toe palungha kami loe panoekhaih tawnh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kahoih ai kami nuiah zithaih to pha tih; toe katoeng kami koehhaih loe akoepsak tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kahoih ai kaminawk loe, kamhae takhi baktiah laemh o; toe katoeng kaminawk loe dungzan kacak ahmuen ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kathaw tui mah haa kinsak moe, hmaikhue mah mik amcapsak baktih toengah, thasae kami doeh anih patoeh kami hanah to tiah oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Angraeng zithaih mah hinglung sawksak; toe kasae kaminawk loe saning duem tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anghoehaih loe katoeng kaminawk oephaih ah oh; toe kasae kaminawk oephaih loe anghmaa tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng ih loklam loe katoeng kaminawk hanah thacakhaih ah oh; toe kahoih ai hmuen sah kaminawk han loe amrohaih ah oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Katoeng kami loe natuek naah doeh angthui mak ai; toe kasae kami loe long nuiah kacakah khosah thai mak ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Katoeng kami ih pakha thung hoiah palunghahaih to tacawt; toe kangkoih ah lokthui kami ih palai loe aat pae pat tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Katoeng kami ih palai loe tapom thaikoi ah kaom hmuen to panoek; toe kasae kami ih pakha loe kangkoih ah lok apaeh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe katoeng ai tahhaih to pahnuet; toe katoeng tahhaih nuiah loe anghoehaih tawnh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amoekhaih oh naah, azathaih to oh; toe minawk tlim ah khosah kami khaeah loe palunghahaih to oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Poektoeng kami loe toenghaih mah zaeh; toe poeksae kami loe poeksethaih mah amrosak tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw palungphui naah angraenghaih mah na bomh mak ai; toe toenghaih mah loe duekhaih thung hoiah pahlong.
  </para>
  <para style="p">
    <verse number="5" style="v" />Coek koi om ai katoeng kami loe toenghaih mah loklam to hnuksak; toe kasae kami loe a sethaih mah amtimsak tik.
  </para>
  <para style="p">
    <verse number="6" style="v" />Katoeng kaminawk loe angmacae toenghaih mah nihcae to pahlong tih; toe sethaih sah kaminawk loe angmacae sethaih pongah aman o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kahoih ai kami duek naah, anih oephaih doeh anghma tih; poektoeng ai kaminawk ih oephaih loe anghmat.
  </para>
  <para style="p">
    <verse number="8" style="v" />Katoeng kami to raihaih thung hoiah pahlong, anih zuengah kasae kami nuiah raihaih to phak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angsah thaih kami loe pronghaih lok hoiah a imtaeng kami to amrosak; toe katoeng kami loe palunghahaih hoiah loi tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Katoeng kami khosak hoih naah, vangpui to anghoe; kasae kami duek naah loe, anghoe hoi hanghaih lok to oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Katoeng kami tahamhoih naah, vangpui to pakoeh ah oh; toe kasae kami ih pakha mah loe vangpui to amrosak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palunghahaih tawn ai kami loe, a imtaeng kami to khet patoek; toe palunghahaih tawn kami loe a palai to ciipsak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lokpung kami loe tamqu hmuen to taphong; toe oepthok kami loe tamqu hmuen to angphat.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zaehhoihaih om ai naah, prae kaminawk amro o; toe poekhaih paek thaih kami pop tawnh naah ngancuemhaih to oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angvin ih laiba pathok pae hanah lokkam kami loe poek angpho tih; toe to tiah lokkam ai kami loe mawnhaih tawn mak ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tahmenhaih tawn nongpata loe khingzahaih to hak; toe thahoih nongpanawk loe angraeng o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tahmenhaih tawn kami loe tangqum to hak; toe hmawsaeng kami loe a taksa raihaih paek kami ah ni oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kasae kami loe alinghaih atho to hnuk; toe toenghaih tuh kami loe amkhrai thai ai tangqum to hak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toenghaih loe hinghaih ah oh baktih toengah, sethaih hnukah patom kami loe a duekhaih ni patom.
  </para>
  <para style="p">
    <verse number="20" style="v" />Poek angkawn kami loe Angraeng mah panuet; toe toenghaih loklam pazui kami nuiah loe anghoehaih to tawnh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kasae kaminawk loe nawnto amhong o cadoeh, danpaek ai ah om mak ai; toe katoeng kaminawk ih caa loe loihsak tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khopoek thai ai kranghoih nongpata loe, ok tahmawh nui ih sui bantuek baktiah ni oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Katoeng kami loe kahoih hmuen khue ni koeh; toe kasae kami ih oephaih loe palungphuihaih hae ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cangti haeh kami loe pop aep ah hak; angaihaih pong kamthlai ah patung kami loe amtang aep.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuuhoih kami loe angraeng; minawk han tuibawh kami loe, angmah doeh tuibawh ah om toeng tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cang zawh paawt kami loe, minawk mah kasae thui tih; toe cang zaw kami ih lu loe tahamhoihaih om tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kahoih hmuen pakrong kami loe hoihaih to hnuk; toe kahoih ai hmuen pakrong kami loe sethaih to hnu tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Angmah angraenghaih oep kami loe amtim tih; toe katoeng kami loe thingqam baktiah sai tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angmah imthung raihaih paek kami loe takhi to qawk ah toep tih; amthu loe palungha kami ih tamna ah om tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hinghaih thingkung loe toenghaih thingthai ah oh; palungha kami loe minawk hinghaih to pazawk.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khenah, katoeng kaminawk mataeng doeh long nuiah hnuk han koi atho to hnu o nahaeloe, Sithaw panoek ai kami hoi zaehaih sak koeh kaminawk cae loe kawkruk maw danpaekhaih atho to hnu o tih!
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thuitaekhaih koeh kami loe palungha kami ah oh; toe zoehhaih hnuma kami loe amthu kami ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahoih kami mah loe Angraeng palung anghoesak; toe kahoih ai hmuen poek kami loe lokcaekhaih to hnu tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kahoih ai hmuen mah kami tangzun caksak ai; toe katoeng kami ih tangzun loe aphong thai mak ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuinuen kahoih zu loe a sava han sui lumuek ah oh; toe ahmin saesak zu loe sava ih ahuh to hmawnsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katoeng kami poekhaih loe toeng; toe kasae kaminawk ih lok loe alinghaih ah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kasae kami ih lok loe minawk athii palonghaih to zing; toe katoeng kami ih lok loe minawk to pahlong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kasae kami ih im loe amtim ueloe, anghmaa tih; toe katoeng kami ih im loe kacakah angdoe poe tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palungha kami loe minawk mah pakoehhaih to hnuk; toe poek angkawn kami loe minawk mah hnap.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angmah hoi angmah angraeng ah amkoeh, caaknaek tawn ai kami pongah loe, kami mah patoek e, caaknaek tawn toksah kami to hoih kue.
  </para>
  <para style="p">
    <verse number="10" style="v" />Katoeng kaminawk loe a pacah ih moinawk nuiah tahmenhaih to tawnh; toe hmawsaenghaih loe kasae kaminawk ih tahmenhaih sang koek ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angmah ih lawk phrawk kami loe zok amhah tih; toe palungha ai kami loe tidoeh avang ai kami hnukah bang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Katoeng ai kami loe kasae kami ih palok to patoh han koeh; toe katoeng kami ih tangzun loe aquih tacawt.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kasae kami loe a pahni zaehaih mah dongh pongah amansak; toe kami katoeng loe raihaih thung hoiah loih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kami loe angmah pahni athaih hoiah zok amhah tih; a ban hoi sak ih kasae kahoih hmuen baktih toengah atho doeh hnu tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kamthu loe a caehhaih loklam to kamsoem ah a hnuk; toe palungha kami loe minawk mah thuih ih lok to tahngaih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kamthu loe palungphuihaih to amtuengsak roep; toe palungha kami loe azat koi hmuen to angphat.
  </para>
  <para style="p">
    <verse number="17" style="v" />Loktang thui kami loe toenghaih to amtuengsak; amsawnlok pongah hnukung ah angdoe kami loe alinghaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sumsen hoi thunh ih baktiah lok apae kami to oh; toe palungha kami ih palai mah loe kami ngantuisak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Loktang pahni loe dungzan khoek to cak; toe amsawnlok loe nawnetta ni oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahoih ai hmuen poek kaminawk ih palung thungah alinghaih to oh; toe angdaehhaih sah kaminawk loe anghoehaih tawnh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Katoeng kaminawk khaeah sethaih pha mak ai; toe kasae kami loe tahamsethaih hoiah koi tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lok amlai palai loe Angraeng mah panuet; toe toenghaih hoi khosah kaminawk loe Angraeng mah palung.
  </para>
  <para style="p">
    <verse number="23" style="v" />Palungha kami loe panoekhaih to angphat; toe amthu ih palungthin mah loe amthuhaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thahoih ban mah kami to uk tih; toe thasae kami loe misong ah om tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Palungsethaih mah kami palungboengsak; thapaekhaih lok mah poek nawmsak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Katoeng kami loe a imtaeng kami to loklam patuek; toe kahoih ai kami ih loklam mah nihcae to loklam anghmangsak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thasae kami loe a kah ih moi paaem han mataeng doeh paqak; thahoih kami ih tacong loe atho oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toenghaih loklam ah duekhaih om ai, hinghaih ni oh.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palungha caa loe ampa thuitaekhaih lok to tahngaih; toe minawk padaeng thaih kami loe thuitaekhaih lok to tahngai ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kami loe angmah pahni ih athaih kahoih to caa tih; toe zaehaih sah kami loe athii palonghaih athaih to caa tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pahni angsum kami loe a hinghaih cuem kami ah oh; pakha kawkah aang kami loe amro tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thasae kami loe a koehhaih baktiah tidoeh tawn ai; thahoih kami loe a koehhaih to hak tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katoeng kami loe lok amlaihaih to hnukma; toe kasae kami loe panuet thoh moe, azathaih to ohsak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Loklam amkhraeng ai kami loe toenghaih mah toep; toe kahoih ai kami mah loe kami kazae to amtimsak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng ah angsah, tidoeh tawn ai kami to oh moe, kamtang ah angsah, angraeng parai kami doeh oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng loe angraenghaih hoiah a hinghaih to akrang han oh; toe amtang kami loe thuitaekhaih lok to tahngai mak ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Katoeng kami aanghaih loe anghoehaih ah oh; toe kasae kami ih hmaiim loe dueh ving tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amoekhaih mah angzoehhaih to tacawtsak; toe palungha kami loe acoe paekhaih lok to tahngaih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Azom ah hak ih phoisa loe anghma zuep tih; toe toksak moe, patung ih phoisa loe pung aep tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Oephaih anghmat ving naah poekhaih angpho; toe koehhaih acung naah loe, hinghaih thingkung ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuitaekhaih lok patoek kami loe amro tih; toe paek ih lok khingya kami loe tangqum to hnu tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palungha kami patukhaih lok loe, duekhaih thaang thung hoi loih hanah, hinghaih tuipuek ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kahoih panoekhaih tawn kami loe minawk hmaa ah mikhmai pan tih; toe kasae kami ih loklam loe rai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Palungha kami loe palunghahaih hoiah toksak; toe kamthu loe amthuhaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kahoih ai laicaeh loe raihaih thungah amtim; toe oepthok laicaeh loe ngantuihaih ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thuitaekhaih tahngai ai kami loe amtanghaih hoi azathaih mah pha thui tih; toe thuitaekhaih lok tahngai kami loe pakoehaih to hnu tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Koeh acunghaih loe hing thung kawkruk maw khosak hoih! Toe kahoih ai hmuen caeh taakhaih loe amthu kaminawk hanah panuet thok hmuen ah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palungha hoi angkom kami loe palungha tih; toe kamthu hoi angkom kami loe amro tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kazae kaminawk loe sethaih mah hnukah patom; toe katoeng kaminawk loe tahamhoihaih tangqum to hnu o tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kahoih kami loe a caanawk ih caa patoeng hanah, qawk to caeh taak; toe kami zae loe katoeng kaminawk han ih ni hmuenmae to patung pae.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amtang kami ih lawk loe cang hoih parai; toe anih to aling o pongah amro boih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Quiboeng patoh ai kami loe, a caa hnuma kami ah oh; toe caa palung kami loe, nawkta nathuem hoiah thuitaekhaih to tawnh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Katoeng kami loe a hing hanah buhcaak; toe kasae kami loe zok amthlam tih.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palungha nongpata loe a ohhaih im to sak; toe kamthu nongpata loe a im to a phraek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng zii kami loe katoeng loklam ah caeh; toe loklam amkhraeng kami loe Angraeng to khet patoek tihhaih ih ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kamthu ih pakha loe amoekhaih quiboeng ah oh; toe palungha kami ih pahni mah loe nihcae to pahlong tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Maitaw om ai ahmuen ih maitaw okduk loe cai pin; toe maitaw ih tha hoiah cang to a hak mangh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Oep kaom hnukung loe kaminawk to aling ai; toe amsawn hnukung loe lok amlai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Minawk hnaphnae kami loe palunghahaih to pakrong, toe hnu ai; toe panoekhaih tawn kami hanah loe palungha zoidaek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih ih pahni ah palunghahaih om ai tiah na panoek nahaeloe, kamthu to om taak duem ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palungha kami loe a caehhaih loklam to palunghahaih hoiah poek; toe kamthu ih amthuhaih loe alinghaih ah oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kamthu loe zaehaih to tiah doeh sah ai; toe katoeng kaminawk khaeah loe tahmenhaih to oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palung mah palungsethaih to panoek; mi mah doeh angmah anghoehaih to minawk han paek thai ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kasae kami ih im loe amro tih; toe katoeng kami ih kahni im loe aquih tacawt tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kami maeto khaeah katoeng loklam maeto baktiah amtueng pae; toe boenghaih ah loe duekhaih loklam ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Palungsethaih amtueng han ai ah pahnui kami doeh om tih; anghoehaih doeh palungsethaih hoiah boeng thaih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hnuk angnawn kami loe a tok sakhaih atho to hnu tih; toe kahoih kami loe a sak ih hmuen baktih toengah tangqum to hnu tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Poek tawn ai kami loe minawk mah thuih ih loknawk boih to tang; toe palungha kami loe a caehhaih loklam to kahoih ah poek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Palungha kami loe Angraeng to zit moe, sethaih to cawn taak; toe kamthu loe poekham moe misahoih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Poek amthueng kami loe amthuhaih hoiah toksak; kahoih ai hmuen sak pacaeng kami loe minawk mah hnuma tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Poekhaih tawn ai kami loe amthuhaih to qawk ah toep; toe palungha kaminawk loe palunghahaih lumuek to angmuek o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kahoih ai kami loe katoeng kami hmaa ah angam sut tih; kasae kami doeh katoeng kami ih khongkha taengah angam sut tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amtang kami loe a imtaeng kami mah doeh hnukma; toe angraeng loe ampui tawn mangh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kami zae loe a imtaeng kami to khet patoek; toe kamtang tahmen kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sethaih poek kaminawk loe loklam caeh pazae o boeh na ai maw? Toe kahoih hmuen poek kaminawk loe amlunghaih hoi oepthohhaih to hnuk o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toksakhaih boih ah toksakhaih atho to oh; toe lok khue thui kami loe amtang tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Palungha kaminawk ih angraenghaih loe angmacae ih sui lumuek ah oh; toe kamthunawk amthuhaih mah loe amthuhaih to tacawtsak aep.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tangtang hnukung mah loe hinghaih to pahlong; toe amsawn hnukung ah kaom kami loe amsawnlok to thuih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng zii kami loe kacak oephaih to tawn ueloe, a caanawk abuephaih ahmuen doeh tawn tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Angraeng zithaih loe hinghaih tuipuek ah oh moe, duekhaih dongh thung hoiah loisakkung ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kami pop prae thungah loe siangpahrang lensawkhaih to cak; toe kami tamsi prae ah loe siangpahrang amrohaih ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Panoekhaih kathuk kami loe palungsawk; toe poek amthueng kami loe amthuhaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Poekhoih palung mah taksa to ngantuisak; toe uthaih mah loe huhong to hmawnsak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kamtang pacaekthlaek kami loe angmah Sahkung to ni pacaekthlaek; toe Sithaw khingya kami loe kamtang nuiah palungnathaih to tawnh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kasae kami loe a sethaih mah kraksak tathuk; toe katoeng kami loe duek naah doeh oephaih to tawnh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Palungha kami ih palung thungah palunghahaih to oh; toe kamthu ih palung thungah kaom hmuen loe amtueng phaeng.
  </para>
  <para style="p">
    <verse number="34" style="v" />Toenghaih mah prae kaminawk to sangsak tahang; toe zaehaih loe kami boih kasaethuihaih ah oh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Siangpahrang loe palungha tamna nuiah anghoe; toe azatsak thaih tamna loe angraeng to palungphuisak.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Loknaem mah palungphuihaih to dipsak; toe lokham mah loe palungphuihaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Palungha kami loe palai to katoeng ah patoh; toe kamthu ih pakha mah loe amthuhaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng ih mik loe ahmuen kruekah oh moe, kasae kahoih to khet.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kahoih lok kathui palai loe kami ngantuihaih ah oh; toe aling thaih palai loe poekhaih patangkhangsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamthu loe ampa thuitaekhaih to patoek; toe palungha kami loe thuitaekhaih lok to tahngaih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Katoeng kami ih im ah loe hmuenmae oh mangh; toe kasae kami ih phoisa mah loe raihaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Palungha kami ih pahni mah palunghahaih to pungsak; toe kamthu ih palung ah loe palunghahaih to om ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami zae angbawnhaih loe Angraeng mah panuet; toe katoeng kami lawkthuihaih mah Angraeng to anghoesak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kasae kami ih loklam loe Angraeng mah panuet; toe toenghaih pakrong kaminawk loe anih mah palung.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lam amkhraeng kaminawk loe thuitaekhaih to koeh o ai; toe thuitaekhaih hnuma kami loe dueh tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hell hoi amrohaih mataeng doeh Angraeng hmaa ah amtueng phaeng nahaeloe, kaminawk ih palung cae loe kawkruk maw amtueng aep tih?
  </para>
  <para style="p">
    <verse number="12" style="v" />Minawk patoek kami loe thuitaek naah palungphui; palungha kami khaeah lokduenghaih to tawn mak ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Palung anghoe naah mikhmai pan; toe palungset naah loe poekhaih patangkhang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khopoek thaih palung mah loe palunghahaih to pakrong; toe kamthu ih pakha loe amthuhaih to zok ah amthlam.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amtanghaih tlim ah khosah kaminawk ih aninawk loe sethaih hoiah koi; toe poeknawmhaih loe sak toepsoep ih buhraenghaih poih ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dawnraihaih hoiah hmuenmae angraeng parai pongah loe, Angraeng zithaih hoiah hmuen zetta tawnh to hoih kue.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kathawk hruk maitaw to boh moe, anghnukmahaih ahmuen ah buhcaak pongah loe, amlunghaih kaom ahmuen ah aan hoiah buhcaak to hoih kue.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palungphuihaih mah ampraekhaih to tacawtsak; toe pauephaih tawn kami loe angzoehhaih to dipsak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thasae kami ih loklam loe soekhring hoiah koi; toe katoeng kami caehhaih loklam loe manglaih lampui ah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palungha capa mah ampa to anghoesak; toe kamthu loe amno to hnaphnae.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kamthu loe poekhaih tawn ai kami to kawnh haih; toe palungha kami loe katoengah lamcaeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Poekhaih kahoih paek ih om ai ah loe sak atimhaih to amro; toe poekhaih kahoih paek kami pop naah sak atimhaih to cak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kami loe lokduenghaih pathim naah anghoe; atue nathuem ah apaeh ih lok loe kawkruk maw hoih!
  </para>
  <para style="p">
    <verse number="24" style="v" />Hell thung hoi loih hanah, palungha kami loe hinghaih loklam bangah caeh tahang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amoek kami ih im loe Angraeng mah phrae tih; toe lamhmai ih ramri loe caksak tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kasae kami poekhaih loe Angraeng mah panuet; toe poekciim kaminawk ih poekhaihnawk loe a kawnh pae.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kamthlai koeh hmoek kami imthung ah raihaih to phak; toe bokhaih tangqum hnuma kami loe hing tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Katoeng kami loe lok pathim hanah palung thung hoiah lok to khingh; toe kasae kami ih pakha loe loksae to pathaak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kasae kami loe Angraeng mah amhoe taak; toe katoeng kaminawk ih lawkthuihaih lok loe anih mah tahngaih pae.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mikhmai panhaih mah palung anghoesak; kahoih tamthang mah huhong ngantuisak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinghaih paek thaih thuitaekhaih lok tahngai kami loe, palungha kaminawk ohhaih im ah om toeng tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thuitaekhaih lok tahngai ai kami loe a hinghaih patoek kami ah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Angraeng zithaih loe palungha amtuenghaih ih ni; kami tlim ah khosakhaih loe minawk mah pakoeh ih loklam ah oh.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kami mah a poekhaih hoiah khokhan, toe lok pathimhaih loe Angraeng khae hoiah ni angzoh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kami mah loe a caehhaih loklam to katoeng boih ah poek; toe Angraeng mah loe palungthin to khingh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na sak ih hmuen kruekah Angraeng khaeah amha ah; to tih nahaeloe nam sakhaih hmacawn tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah hmuennawk boih angmah hanah ni sak; ue, kasae kaminawk loe sethaih ani to tong hanah ohsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amoek kaminawk loe Sithaw mah panuet; nihcae loe nawnto amhong o cadoeh, danpaekhaih to loih o mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Palungnathaih hoi loktang mah zaehaih to ciimsak; Sithaw zii kami loe zaehaih to caeh taak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kami mah Angraeng anghoe koiah khosak naah, a misa hoiah mataeng doeh angdaeh thaih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Katoeng ai loklam hoiah hmuenmae pop ah hak pongah loe, toenghaih hoiah hmuenmae zetta hak to hoih kue.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kami mah a caehhaih loklam to poek; toe a caehhaih loklam to Angraeng mah patuek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw mah thuih ih lok to siangpahrang ih pakha ah oh; anih ih pakha hoiah katoeng ai lok to tacawt han om ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Katoeng hmuenzit tahhaih hoi coi tahhaih loe Angraeng ih hmuen ah oh; pasah thung ih kazit hmuen tahhaih boih loe anih mah sak ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng tangkhang loe toenghaih hoiah sak pongah, kahoih ai hmuen sakhaih loe siangpahrangnawk hanah panuet thoh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Katoeng kami ih pahni to siangpahrangnawk mah anghoe o haih; loktang lokthui kami to palung o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Siangpahrang palungphuihaih loe duekhaih laicaeh baktiah oh; toe palungha kami loe palungphuihaih to dipsak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Siangpahrang mikhmai pan naah hinghaih to oh; anih anghoehaih loe hnukkhuem ih khotui baktiah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sui pongah loe palunghahaih to hoih kue; sumkanglung qoih pongah loe palunghahaih qoih to kawkruk maw hoih!
  </para>
  <para style="p">
    <verse number="17" style="v" />Kahoih ai hmuen caehtaakhaih loe katoeng kami ih loklam ah oh; a caehhaih loklam hoi amkhraeng ai kami loe a hinghaih angvaeng thaih kami ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amoekhaih loe amrohaih ih loklam ni; poeksanghaih mah amtimhaih loklam ah caeh haih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kamoek kami hoi angkom moe, a lomh ih hmuen to amzet pongah loe, palungsawk kami hoi angkom moe, kami tlim ah khosak to hoih kue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palunghahaih hoi toksah kami loe khosak hoih tih; Angraeng oephaih tawn kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Poekhaih palungha kami loe khopoek thaih kami ah oh; kahoih lokthui thaih pahni loe minawk han palunghahaih lok to patuk thaih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Palunghahaih tawn kami loe hinghaih tuipuek ah oh; toe kamthu thuitaekhaih lok loe amthuhaih ah ni oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Palungha ih palungthin loe angmah ih pakha to thuitaek moe, a pahni ah palunghahaih to thap pae.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tahngai kahoih loknawk loe khoitui baktiah oh; na hinghaih pakhra hanah luep moe, huhong to ngantuisak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kami maeto hanah loe katoeng loklam maeto baktiah amtueng; toe boenghaih ah loe duekhaih loklam ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toksah kami loe, angmah ih pakha pacah han ih ni tok to a sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sithaw panoek ai kami loe kahoih ai hmuen to poek, a thuih ih lok doeh kangqong hmai baktiah ni oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Poektoeng ai kami loe angzoehhaih atii to a haeh; pronghaih mah ampui kangzong to ampraeksak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Poeksae kami loe a imtaeng kami to pacuek moe, kahoih ai loklam to pazuisak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kahoih ai kami loe kasae hmuen sak hanah, a mik to pasimh moe, kahoih ai hmuen angcoengsak hanah, pahni to haehsak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toenghaih loklam ah khosak pongah sam to pok nahaeloe, lensawkhaih lumuek ah ni oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Palungsawk kami loe thacak kami pongah hoih kue; poekhaih angsum thaih kami loe vangpui pazawk kami pongah hoih kue.
  </para>
  <para style="p">
    <verse number="33" style="v" />Taham khethaih phoisa vahhaih hoiah sak ih lok takroekhaih loe aimacae mah ni sak o; toe hmuen boih nuiah lok takroekkung loe Angraeng ni.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Imthung koi mongah sak ih angbawnhaih buh to angzoehhaih hoiah caak pongah loe, buh karoem zetta poek monghaih hoiah caak to hoih kue.
  </para>
  <para style="p">
    <verse number="2" style="v" />Palungha tamna loe kahoih ai imkung ih capa to uk tih, anih loe a caanawk hoi nawnto qawk to toep tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sumkanglung tui pacii hanah laom to patoh baktih toengah, sui tui pacii hanah hmai kamngaeh to patoh; toe Angraeng loe kami ih palung to tanoem.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kahoih ai hmuen sah kami loe lok amlai kami mah thuih ih lok to tang; amsawnlok thui kami doeh loksae to tahngaih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mithoe hnaphnae kami loe anih Sahkung hnaphnae kami ah ni oh; minawk raihaih tong naah anghoe kami loe danpaekhaih to loih mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Caanawk ih caa patoeng loe mitongnawk hanah sui lumuek ah oh, amno ampa loe caanawk lensawkhaih ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kahoih lok loe kamthu hoi amcuk ai baktih toengah, amsawnlok doeh ukkung angraeng hoi amcuk ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tangqum loe hak kami hanah atho kana thlung baktiah oh; a caehhaih ahmuen kruekah, tahamhoihaih oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Minawk zaehaih tahmen kami loe amlunghaih to pungsak; toe zaehaih tahmen ai kami loe ampui to ampraeksak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kamthu loe quiboeng hoi cumvaito boh cadoeh poek amkhrai mak ai; palungha loe thuitaekhaih lok to thaih kop.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kahoih ai kami loe lokaek han khue ni pakrong; to pongah tahmenhaih tawn ai laicaeh to anih khaeah patoeh tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palungkraeng kamthu khaeah caeh moe, raihaih tong pongah loe, taqom caa lomh pae to hoih kue.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmuenhoih to hmuensae hoiah pathok kami loe, kahoih ai hmuen mah a im to caehtaak mak ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angzoehhaih loe kamsah tui hoiah anghmong; to pongah angzoehhaih om ai naah to hmuen to toengh sut ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zaehaih sah kami to loisak lat kami, to tih ai boeh loe katoeng kami zaehaih net lat kami hnik to Angraeng mah panuet hmaek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kamthu loe palunghahaih koeh ai pongah, kamthu ban ah paek ih phoisa loe tih atho maw oh?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ampui loe amlunghaih tawnh poe; nawkamya loe karai tonghaih atue nathuem han ih ni tapen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Poekhaih tawn ai kami loe coi ih phoisa to pathok pae hanah, angmah ih ampui hmaa ah lokkamhaih to sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angzoeh koeh kami loe zae sakhaih doeh koeh; angmah ih khongkha amoek haih kami loe amrohaih ni pakrong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Poektoeng ai kami loe khosak hoihaih tawn ai; amsawnlok thui palai loe raihaih tongh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kamthu tapen kami loe tapenkung to palungsetsak; kamthu ih ampa loe anghoehaih tawn ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Poeknawmhaih loe kahoih tasi ah oh; toe palungsethaih mah ahuh to zaeksak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kasae kami loe toenghaih loklam angkawnsak hanah, bokhaih ah paek ih tangqum to lak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Palungha kami loe panoekhaih to tawnh; toe kamthu ih mik loe long boenghaih khoek to khet parui.
  </para>
  <para style="p">
    <verse number="25" style="v" />Capa kamthu mah ampa palungsetsak, anih cunkung to palungboengsak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Katoeng kami to danpaek han hoih ai; toenghaih hoiah lokcaek angraeng doeh danpaek han om ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Palungha kami loe poek het pacoengah ni lok to thuih; panoekhaih tawn kami loe angam duem.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lokpae ai ah om duem kami loe, kamthu mataeng doeh palungha kami ah poek o moe, palai angsum thaih kami doeh khopoek thaih kami ah poek o.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Minawk hoi angkom ai kami loe, angmah koehhaih to pazui moe, minawk lok takroekhaih aek thaih kami ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kamthu loe palunghahaih nuiah anghoehaih tawn ai moe, angmah poekhaih nui khue ah ni anghoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kahoih ai kami angzoh naah, hnaphnaehaih to oh; ahmin sethaih oh naah, azathaih doeh oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kami pakha thung hoi tacawt lok loe tuili baktiah thuk, toe palunghahaih loe tuibap baktiah puek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lokcaek naah kahoih kami to sungsak hanah, kami kasae to angdoet haih han om ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamthu ih pahni mah angzoehhaih to tacawtsak, anih ih pakha hoiah angbohhaih to ohsak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kamthu ih pakha loe angmah amrohaih ah oh moe, anih ih pahni loe a hinghaih pakhra amanhaih dongh baktiah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Minawk kasaethuihaih lok loe ahmaa kana baktiah, kami ih zok thung khoek to akun tathuk.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thasae kami loe hmuenmae tahmat thaih kami ih nawkamya ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng ih ahmin loe kacak abuephaih sipae ah oh; katoeng kami loe to imthung ah cawnh moe, to ah monghaih to hnuk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmuenmae hoi angraeng kami loe angmah ih angraenghaih to vangpui kacak baktih, kasang parai sipae baktiah poek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amoekhaih mah amrohaih to phaksak; toe kami tlim ah khosakhaih loe pakoehhaih loklam tuhkung ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lok tahngai hmaloe ai ah pathim ih lok loe, amthuhaih hoi azathaih ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kami ih palung mah ngannathaih to khaang thaih; toe palungsethaih loe kawbangmaw khaang thai tih?
  </para>
  <para style="p">
    <verse number="15" style="v" />Khopoek thaih kami ih palung loe palunghahaih to tawnh; palungha kami ih naa mah loe palunghahaih to pakrong.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kami mah sin ih tangqum mah, kalen kaminawk hmaa ah caeh haih loklam to paawh pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angmah kawng thui hmaloe kami loe katoeng kami baktiah amtueng; toe a imtaeng kami to angzoh moe, anih ih akawng to thuih naah ni, katoeng hoi katoeng ai to amtueng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tahamsae kahoih khethaih phoisa vahhaih mah lok angaekhaih to dipsak moe, lokaek thaih thacak kaminawk doeh pathlaeng thaih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lok angaek thaih nawkamya loe pazawk hanah kacak vangpui tuk pongah doeh rai kue; nihnik lok angaekhaih loe misatoep kami ohhaih sipae hoiah anghmong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kami loe angmah ih pakha hoi tacawt thingthai to caa ueloe, zok amhah tih; a pahni hoi tacawt hmuen hoiah zok amhah tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Palai loe duekhaih hoi hinghaih tha to tawnh; palai palung kaminawk loe palai ih athaih to caa o tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zu la kami loe kahoih hmuen to a hnuk moe, Angraeng koehhaih to a tongh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amtang kami loe tahmenhaih hnik thaih; toe angraeng loe lok kaham hoiah minawk ih lok to pathim.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ampui kapop ah tawn kami loe angmah amrohaih ah oh; toe nawkamya pongah palung cak kue ampui doeh oh.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lok kangkoih ah apae thaih kamthu pongah loe, toenghaih loklam pazui amtang kami to hoih kue.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahoih ai poekhaih loe, panoekhaih tawn ai; tawt hoi khok takan kami loe loklam caeh pazae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kami amthuhaih mah a caehhaih loklam to amkhraengsak moe, palung thung hoiah Angraeng to kasae a thuih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmuenmae angraeng kami loe ampui tawnh mang; toe kamtang loe a imtaeng kami mah doeh caehtaak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amsoem ai hmuen hnukung ah om kami loe danpaek ai ah om mak ai; amsawnlok thui kami doeh loih mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pop parai kaminawk loe ukkung palung anghoehaih to sak hanah koeh o; tangqum paek thaih kami loe kami boih hoiah ampui ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amtang kami loe angmah ih nawkamyanawk mah doeh hnukma o; angmah ih ampuinawk mah cae loe kawkruk maw ayae o taak tih! Anih loe tahmenhaih hnik hanah nihcae hnukah patom, toe nihcae mah anghmat o taak boih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palunghahaih tawn kami loe a hinghaih to palung; panoekhaih amtuk kami loe khosak hoihaih to hnu tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amsoem ai hmuen hnukungah om kami loe danpaek ai ah om mak ai; amsawnlok thui kami loe amro tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kamthu loe kahnaep ah khosak han krah ai; tamna mah angraengnawk uk hanah krah ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palungha kami loe palungphuihaih to pauep thaih; minawk sakpazaehaih tahmen kami loe lensawkhaih to tawnh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siangpahrang palungphuihaih loe kahang kaipui baktiah oh moe, anih hoihhaih loe phroh nui ih dantui baktiah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Caa kamthu loe ampa amrohaih ah oh, angzoeh koeh zu loe apet ai ah kaca tui baktiah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Im hoi hmuenmae loe ampa ih qawk ah oh; toe palungha zu loe Angraeng khae hoi hak ih qawk ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thasae kami loe iih sawk, thasae kami pakhra loe zok amthlam tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thuitaekhaih lok tahngai kami loe hinglung sawk; toe a caehhaih loklam patoek kami loe dueh tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amtang khenzawn kami loe Angraeng hanah hmuen coi pae baktiah ni oh; anih loe a sak ih hmuen baktiah atho hnu let tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thuitaek thaih koiah oh naah, na caa to thuitaek ah; anih qahhaih to tahmen hmah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Palungphui kami loe danpaekhaih to hnu tih; anih to na pahlong nahaeloe, anih to na pahlong tuektuek han angai tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thuitaekhaih lok to tahngai ah loe, patukhaih lok to talawk ah, to tiah nahaeloe atue boeng naah palung na ha tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kami ih palung thungah sak atimhaih oh mangh; toe Angraeng khokhanhaih mah ni sak atimhaih to caksak tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Boeng thai ai amlunghaih loe kami mah koeh ih hmuen ah oh; amtang kami loe lok amlai kami pongah hoih kue.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng zithaih loe hinghaih ah oh; to tiah poekhaih tawn kami loe koehhaih to acung tih; raihaih tidoeh tongh mak ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thasae kami loe saoek nui hoiah a ban to azuh moe, buh abah han mataeng doeh paqak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Minawk tiah doeh sah ai kami to danpaek ah, poekhaih tawn ai kami to palungha lat tih; khopoek thaih kami to zoeh ah, palungha aep tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ampa ih hmuenmae to pasaengh boih moe, amno to haek kami loe, azathaih paek capa, kasaethuihaih tongsak capa ah oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka capa, thuitaekhaih lok to tahngai ai ah na oh nahaeloe, thuitaek ih panoekhaih loknawk hoiah nam khraeng ving tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lok amlai kami han hnukungah om kami loe, katoengah lokcaekhaih tiah doeh sah ai kami ah oh; kahoih ai kami loe kahoih ai hmuen to kakhraem caaknaek baktiah a caak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kami tiah doeh sah ai kami hanah danpaekhaih to oh, kamthu hanah loe bohhaih to oh.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Misurtui loe tamhnui tabu ah ni oh; mu mah angzoehhaih to ohsak; mu paquih loe amthuhaih ah ni oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Siangpahrang palungphuihaih loe kahang kaipui kabtiah oh; anih palungphui han sah kami loe a hinghaih zaehaih sahsak kami ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angzoehhaih dipsakkung loe khingya han krak; toe kamthu mah angzoehhaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thasae kami loe atue naah laikok atok ai pongah, cang aah tue ah minawk khaeah hni cadoeh, hak mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kami ih palung thung hoi sak atimhaih loe kathuk tui baktiah oh; toe panoekhaih tawn kami mah ni la thai tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kami boih mah a sak o ih kahoih hmuen to thuih o boih; toe mi mah maw oepthok kami to hnu thai tih?
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng kami loe a toenghaih loklam to pazui pongah, a caanawk loe tahamhoih o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Siangpahrang mah lokcaek hanah angraeng tangkhang pongah anghnut naah, kahoih ai hmuennawk to a mik hoiah pathlaeng thaih boih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka palung hae ka ciimsak boeh, zaehaih ka tawn ai, tiah mi mah maw thui thai tih?
  </para>
  <para style="p">
    <verse number="10" style="v" />Angvan ai hmuenzit tahhaih patoh hoi angvan ai kasawk tahhaih patohhaih to Angraeng mah panuet.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nawkta loe a sak ih hmuen toeng maw toeng ai, ciim maw ciim ai, tito a sak ih hmuen hoiah amtueng.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thaihhaih naa hoi hnukhaih mik loe, Angraeng mah ni sak hmaek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Iih koeh hmoek hmah; nam tang tih; na mik to padai ah, to tiah nahaeloe takaw hoiah zok nam hah tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmuen qankung mah hmuen to qan naah, Hoih ai, hoih ai, tiah thuih; toe nawnetta caeh pacoengah loe, a qan ih hmuen to amoek haih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sui to oh moe, atho kana thlung kathim doeh oh mangh; toe palunghahaih lokthui pahni to hoih kue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Panoek ai ih kami hanah phoisa coi han lokkam kami loe angmah ih kahni to la pae ving tih, panoek ai ih angvin nongpata hanah lokkamhaih sah kami loe angmah ih hmuenmae to naeh pae tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Alinghaih hoiah hnuk ih caaknaek loe khraem parai; toe hnukkhuem ah loe pakha to thlungcaret hoiah koi tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na timhaih sah ai naah minawk khae hoi kahoih poekhaih to la ah; kahoih poekhaih paekkung na tawnh naah, misa to tuh ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pakhaa cip ai kami mah tamqu hmuen to angphongsak; to pongah pakha cip ai kami hoiah angkom hmah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amno hoi ampa pasoih kami loe, khoving thungah anih ih hmaithaw paduek pae ving tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Karangah angraenghaih loe, hnukkhuem ah tahamsethaih ah om tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sak ih zaehaih baktiah ka pathok let han, tiah thui hmah; Angraeng to mah oep ah, anih mah na pahlong tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Katoeng ai hmuenzit tahhaih to Angraeng mah panuet; anih loe amsoem ai coi tahhaih nuiah anghoe ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kami ih khok takan loe Angraeng mah ni zaeh; kami mah kawbangmaw a caehhaih loklam to panoek thai tih?
  </para>
  <para style="p">
    <verse number="25" style="v" />Poek het ai ah tawthaih hoi Sithaw khaeah lokkamhaih sah kami, lokkam pacoengah a lokkamhaih dawnpakhuem let kami loe, aimah hanah dongh patung kami ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Palungha siangpahrang loe kahoih ai kaminawk to anghaehsak phaeng moe, cang kaehhaih hoiah nihcae to a kaeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kami ih muithla loe, angmah palung thung ih hmuennawk pakronghaih, Angraeng ih hmaithawk ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amlunghaih hoi oepthohhaih mah siangpahrang to ngancuemsak; amlunghaih mah angraeng tangkhang to caksak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thacakhaih loe thendoeng lensawkhaih ah oh moe, sampok loe mitong kranghoihaih ah oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nganbawh kana hakhaih hoi ahmaa caakhaih mah kasae hmuen to ciimsak; bohhaih mah palungthin thung ih sethaih to pasaeh.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Siangpahrang ih palung loe, vapui baktiah Angraeng ban ah oh moe, a koehhaih ahmuen bangah longh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kami maeto boih mah a caehhaih loklam to toeng, tiah poek; toe Angraeng loe palungthin ni khingh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angbawnhaih ah paek ih hmuen pongah loe, katoengah sak ih hmuen, katoengah lokcaekhaih to Angraeng mah koeh kue.
  </para>
  <para style="p">
    <verse number="4" style="v" />Azat panoek ai mik tamdai hoi amoek palungthin, kahoih ai kami ih hmaithaw loe zaehaih hae ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Poek het pacoengah toksah kami loe angraeng, tawt kaak hoi toksah kami loe amtang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lok amlaihaih hoi hak ih hmuen loe kazawk tamai hoi duekhaih thaang ah ni oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kahoih ai kaminawk loe kahoih hmuen to sak koeh o ai pongah, a sak o ih sethaih hmuen mah angmacae to amrosak tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami caehhaih loklam loe angkawnh; toe poekciim kami toksakhaih loe toeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angzoeh koeh zu hoiah kawk parai im ah oh pongah loe, imphu ranui ih im takii ah oh to hoih kue.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kahoih ai kami loe uthaih palung to tawnh; a imtaeng kami nuiah doeh tahmenhaih tawn ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kahoih ai kami danpaek naah, poek tawn ai kami to palungha lat; palungha kami thuitaek naah loe anih mah panoekhaih to hak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Katoeng kami loe kahoih ai kami ih im to palunghahaih hoiah khet; toe kahoih ai kami loe a sak ih sethaih pongah amrosak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amtang kami qah naah naa tamuep kami loe, a qah naah mi mah doeh tahngai pae mak ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tamquta hoi paek ih tangqum mah palungphuihaih dipsak; tamquta hoi paek ih bokhaih tangqum mah kanung parai palungphuihaih to dipsak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kahoih kami loe katoeng hmuen sakhaih nuiah anghoehaih tawnh; toe sethaih sah kami hanah loe amrohaih ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Palunghahaih loklam hoi amkhraeng kami loe kadueh kaminawk salakah ni anghak tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nawmhaih koeh kami loe amtang tih; mu hoi situi koeh kami doeh angraeng mak ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahoih ai kami loe katoeng kami akranghaih ah oh moe, zaehaih sah kami loe katoeng kami hanah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angzoeh koeh moe, poeksae zu hoi nawnto oh pongah loe, praezaek ah oh to hoih kue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palungha im ah loe buh hoi situi amthlai pok ah oh; toe kamthu loe a tawnh ih hmuennawk to tahmat boih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toenghaih hoi tahmenhaih pakrong kami loe hinghaih, toenghaih hoi ahmin pakoehhaih to hnuk.
  </para>
  <para style="p">
    <verse number="22" style="v" />Palungha kami loe thacak kami ih vangpui to tuk moe, nihcae mah oep o ih sipae to phraek pae thaih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pahni hoi palai cip kami loe raihaih thung hoi a hinghaih loih thai hanah angvaeng kami ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amoek moe, palungphui thaih kami loe amoek kami, minawk pahnuithuih kami, tiah kawk o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thasae kami loe bantha set pongah, vawthaih mah duehsak tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />To baktih kami loe ni thokkruek angaihaih pop aep aep; toe katoeng kami loe paawt ai ah paek.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kahoih ai kami mah paek ih angbawnhaih hmuen loe panuet thoh; anih mah kasae poekhaih palungthin hoi hmuen to sin nahaeloe kawkruk maw panuet thok aep tih!
  </para>
  <para style="p">
    <verse number="28" style="v" />Amsoem ai hnukungah kaom kami loe amro tih; toe lok thaih tangtang kami loe katoeng ah lokthuih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kasae kami loe mikhmai pan thai ai; toe katoeng kami loe a caehhaih loklam to poek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Angraeng ai ah loe palunghahaih, panoekhaih hoi sak atimhaih loe azom pui ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Misatuk hanah hrang to suek coek boeh; toe misa pazawkhaih loe Angraeng ih ni.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraenghaih pongah loe ahmin hoihhaih to qoih han hoih kue; sui hoi sumkanglung pongah doeh amlunghaih to koeh kue han oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Long angraeng hoi kamtang anghmonghaih loe hae tiah oh: nihnik loe Sithaw mah ni sak hmaek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khopoek thaih kami loe raihaih to hnukcoek pongah ayae ving; toe poekhaih tidoeh tawn ai kami loe caeh moe, raihaih to tongh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Minawk tlim ah khosakhaih hoi Angraeng zithaih mah angraenghaih, pakoehhaih hoi hinghaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Poek angkawn kami caehhaih loklam loe soekhring hoi thaang hoiah koi; toe a hinghaih angvaeng kami mah loe ahmuen kangthla ah amhoe taak ving.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nawkta mah pazui han ih loklam to patuk ah; to naah ni a qoeng tahang naah, to loklam hoiah amkhraeng mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng kami mah kamtang kami to uk, hmuenmae coi kami loe coisakkung ih tamna ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sethaih amu haeh kami loe sethaih to aat tih; anih palungphuihaih quiboeng loe amro tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kami tahmenhaih mik to tawnh moe, amtang kami han paek koehhaih palungthin hoiah paek kami loe tahamhoih tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Minawk khet patoek kami to haek oh, lok angaekhaih to amding tih; angzoehhaih hoi kasae thuihaih doeh boeng tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Poektoeng kami loe, tahmenhaih hoiah lokthuih pongah, siangpahrang loe anih ih ampui ah om tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng ih mik mah loe palunghahaih lok to pakaa moe, zaehaih sak koeh kami ih loknawk loe tiah doeh sah pae ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thasae kami loe tasa bangah kaipui oh! Minawk mah na hum tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sava laep ah zaehaih sah nongpata ih pakha loe kathuk tangqom ah oh; Angraeng mah panuet ih kami loe to tangqom thungah krah tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nawkta ih palung loe amthuhaih mah zaeng; toe thuitaekhaih cung mah to amthuhaih to kangthla ah haek ving tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng thai hanah amtang kaminawk to pacaekthlaek moe, angraeng kami hanah tamquta hoiah tangqum paek kami loe amtang tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Naa to patueng ah loe palungha kami ih loknawk to tahngai ah; ka palunghahaih hae na palung thungah khrum ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palung thungah na khrum nahaeloe anghoehaih ah om tih; na pahni ah doeh suem ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng ah nam ha thai hanah, vaihniah kang patuk boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahoih koek poekhaih hoi palunghahaih loknawk to kang tarik pae boeh,
  </para>
  <para style="p">
    <verse number="21" style="v" />loktang lok to na panoek thaih moe, nang khae patoeh ih kaminawk khaeah, loktang lok na thuih pae let thai hanah, kang pat boeh na ai maw?
  </para>
  <para style="p">
    <verse number="22" style="v" />Amtang pongah kamtang ih hmuen to lomh pae o hmah; patangkhang kami to lokcaekhaih ahmuen ah pacaekthlaek o hmah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah nihcae kawng to thui ueloe, nihcae hinghaih paro kami to amrosak toeng tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Poek amthueng kami to ampui ah sah hmah; palungphui thaih kami hoi nawnto caeh hmah;
  </para>
  <para style="p">
    <verse number="25" style="v" />anih ih kuu na la moeng ueloe, na hinghaih to thaang pongah aman moeng tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Minawk ih laiba pathok pae hanah lokmaihaih sah hmah, to tih ai boeh loe lokkamhaih to sah hmah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Laiba pathok hanah phoisa na tawn ai nahaeloe, na iihkhun to na paek han maw?
  </para>
  <para style="p">
    <verse number="28" style="v" />Nam panawk mah quenh tangcae ih prae angzithaih ramri to pathui hmah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kahoih ah toksah kami to na hnuk maw? To kami loe kami rumram ih toksah mak ai, siangpahrang ih tok ni sah tih.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ukkung hoi buh nawnto caak han nang hnut naah, na tuinuen to kahoihah angsum ah;
  </para>
  <para style="p">
    <verse number="2" style="v" />buhcaak nam oeh hmoek nahaeloe, na qawnh to haita hoi aah baktiah ni oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kakhraem anih ih buh to khit hmah; to buh loe alinghaih buh ah ni oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng thai hanah toksah hmah; na palunghahaih to oep hmah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nawnetta ah anghma thaih hmuen to na khet maw? Tangtang ni van bangah kazawk tahmu baktih toengah, angraenghaih doeh pakhraeh tawnh moe, azawk ving.
  </para>
  <para style="p">
    <verse number="6" style="v" />Uthaih tawn kami ih buh to caa pae hmah; anih ih kahoih caaknaek doeh khit pae hmah;
  </para>
  <para style="p">
    <verse number="7" style="v" />anih loe a palung thung hoi poek ih baktih toengah oh; caa ah loe nae ah, tiah ang naa, toe palung tang hoiah thui ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zetta na caak ih buh to palok roep ueloe, kahoih loknawk to na sung moeng tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kamthu khaeah lokthui hmah; anih loe na thuih ih palunghahaih lok to patoek tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Canghnii ih prae angzithaih ramri to pathui hmah; naqah ih lawk to lomh pae hmah;
  </para>
  <para style="p">
    <verse number="11" style="v" />anih krangkung loe thacak; Angraeng mah nihcae kawng pongah na thuitaek tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thuitaekhaih bangah palung paek ah loe, palunghahaih lok bangah na naa to patueng ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nawkta to thuitaek hanah paquem hmah; anih to cung hoiah na boh cadoeh dueh mak ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hell thung hoiah anih to pahlong hanah, cung hoiah bop ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka capa, palunghahaih na tawnh nahaeloe, ka palung hae anghoe tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ue, na pahni mah katoeng hmuen to thuih naah, ka palung hae anghoe tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kazae kaminawk to awt hmah; Angraeng zithaih khue to palung thung hoi poek ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na oephaih loe hmabang ah oh, na oephaih loe boeng mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka capa, tahngai ah loe palungha ah; katoeng loklam ah na poekhaih palung to suem ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mu coih kami, moi caak koeh hmoek kami hoi angkom hmah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mu coih kami hoi caaknaek amoeh kaminawk loe amtang tih; iih koeh hmoek kami loe amtanghaih mah khuk hmoek tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na tapenkung nam pa ih lok to tahngai ah, nam no mitong naah hnap hmah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Loktang to qan ah, zaw let hmah; palunghahaih, thuitaekhaih hoi panoekhaih to talawk ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Katoeng kami ih ampa loe paroeai anghoe tih; palungha caa tapen ampa loe a caa nuiah anghoe tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nam no hoi nam pa to anghoe tih, nang tapenkung loe anghoehaih tawn tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka capa, palung to na paek ah loe, ka loklamnawk hae na mik hoiah khen ah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tangzat zaw nongpata loe kathuk tangqom baktih, minawk zoek thaih nongpata loe tamcaek tuikhaw baktiah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mingcah baktiah kami to angang moe, nongpanawk zaehaih to pungsak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khosak bing kami loe mi maw? Mi maw palungsae? Mi maw patangh? Mi maw amoek? Tidoeh na ai ah mi maw nganbawh kana hak? Mi maw mik kamlingh?
  </para>
  <para style="p">
    <verse number="30" style="v" />To baktih kaminawk loe mu naek angsum thai ai kami, tasi hoi atok ih mu naek hanah pakrong kaminawk ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mu kathim maw, boengloeng pong lawn naah rong kampha mu maw, naek naah akun kahoih mu kathim maw to khen hmah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Boenghaih ah loe pahui baktiah kami to patuk moe, pahui sae ih kasoetui baktiah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na mik mah kahoih ai nongpata to khen ueloe, na poekhaih palungthin to amkhraengsak ving tih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ue, nang loe tuipui um ah iip kami baktih, palong paehhaih qui nuiah iip kami baktiah na om tih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nihcae mah ang boh o, toe kana panoek ai; ang caep o, toe tidoeh ka panoek ai! Kang thawk naah, naek hanah mu to pakrong let han vop, tiah ni na thui tih.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasae kaminawk to awt hmah; nihcae hoi angkom han doeh poek hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae loe palung thung hoi amro han khue ni poek o, pahni hoiah raihaih sak han khue to a thuih o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Im loe palunghahaih hoiah sak moe, panoekhaih hoiah caksak;
  </para>
  <para style="p">
    <verse number="4" style="v" />palunghahaih mah imkhaannawk to atho kana hmuenmae, koeh kaom hmuennawk hoiah koisak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palungha kami loe thacak; ue, palunghahaih tawn kami loe thacakhaih pung aep.
  </para>
  <para style="p">
    <verse number="6" style="v" />Palungha kami khae hoi poekhaih lak pacoengah, misa tuh ah; ngancuem hanah kahoih poekhaih paekkung pop tawnh han angaih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Palunghahaih loe sang pongah kamthu mah pha thai ai; kami pop amkhuenghaih khongkha ah lokthui thai ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kahoih ai hmuen sak pacaeng kami loe raihaih sah kami ni, tiah kawk o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kamthu poekhaih loe zaehaih ah oh, minawk pahnui thuih kami loe panuet thoh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Raihaih phak naah palung boeng nahaeloe, thazok kami ah ni na oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Duekhaih loklam ah zaeh ih kami to pahlong ah; humhaih ahmuen ah caehhaih ih kami to hoi let ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khenah, hae kawng hae ka panoek ai, tiah na thuih nahaeloe, palungthin khenkung mah panoek mak ai maw? Na hinghaih khenkung mah panoek mak ai maw? Kami mah sak ih hmuen baktiah anih mah pathok mak ai maw?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka capa, khoitui loe hoih pongah nae ah; khoi lutui loe pataeng naah luep dueng;
  </para>
  <para style="p">
    <verse number="14" style="v" />to baktih toengah palunghahaih loe na hing thungah luep tih; na hnuk naah nang han tangqum ah om tih; na oephaih anghma mak ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw katoeng ai kami, katoeng kami ih im to toep hmah; anih ohhaih ahmuen to amrosak hmah;
  </para>
  <para style="p">
    <verse number="16" style="v" />katoeng kami loe vai sarihto amtim cadoeh, angthawk let tih; toe kasae kami loe raihaih mah amtimsak tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na misa amtim naah anghoe hmah; anih amthaek naah palung anghoe hmah;
  </para>
  <para style="p">
    <verse number="18" style="v" />nang hoe nahaeloe Angraeng mah hnu ueloe, poeknawm mak ai, to kami nuiah Anih palungphuihaih to dip ving tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kahoih ai kami pongah palungboeng hmah; kahoih ai kami doeh awt hmah;
  </para>
  <para style="p">
    <verse number="20" style="v" />kasae kami loe hmabang kaom oephaih to tawn ai; kasae kami ih hmaithaw loe paduek pae ving tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka capa, Angraeng hoi siangpahrang to zii ah; misa angthawk koeh kami hoiah angkom hmah;
  </para>
  <para style="p">
    <verse number="22" style="v" />akra ai ah nihcae nuiah amrohaih pha tih; kawbaktih raihaih maw nihcae mah omsak tih, tito mi mah maw panoek thai tih?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hae baktih hmuennawk doeh palungha kami mah thuih ih lok ah ni oh. Lok takroek naah mikhmai khet han hoih ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kasae kami khaeah, Nang loe na toeng, tiah thui kami loe minawk mah kasae thui o ueloe, prae kaminawk mah panuet o tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toe minawk thuitaekkung loe poeknawm ueloe, tahamhoihaih to hnu tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kami boih mah toenghaih lokthui kami ih pahni to mok o tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tasa bang ih tok to sah hmaloe ah, nangmah hanah laikok atok pacoengah, na ohhaih im to sah ah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Takung om ai ah na imtaeng kami to zaehaih net hmah; alinghaih lok thui hmah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kai khaeah sak ih hmuen baktih toengah, anih nuiah doeh ka sak toeng han; a sak ih hmuen baktih toengah ka pathok let han, tiah thui hmah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thasae kami ih lawk ah ka caeh moe, poekhaih tawn ai kami ih misur takha thungah ka caeh naah,
  </para>
  <para style="p">
    <verse number="31" style="v" />khenah, soekhring cing ah oh, long doeh phroh cing ah oh; thlung hoi pakaa ih sipae doeh amtimh boih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka hnuk ih hmuen to palung thung hoi ka poek het naah, ka khet ih hmuen nuiah amtuk han koi ka hnuk.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nawnetta iih, nawnetta iih angam, iih hanah nawnetta thungah ban pakhuem moe, nang hak nathuem ah,
  </para>
  <para style="p">
    <verse number="34" style="v" />amtanghaih mah kholong caeh kami baktih, vawthaih mah maiphaw sin kami baktiah na pha thui tih.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hae hmuennawk loe Judah siangpahrang Hezekiah ih kaminawk mah tarik pakong patoeng ih, Solomon palunghahaih loknawk ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sithaw lensawkhaih loe amtueng ai ah kaom hmuen maeto ah oh; toe hmuen maeto kawng pakronghaih loe siangpahrangnawk lensawkhaih ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Van loe sang moe, long loe thuk baktih toengah, siangpahrangnawk ih palung loe hnu thai mak ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sumkanglung thung ih sum aek to va ah, to naah ni sum sahkung mah boengloeng kahoih to sah thai tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kasae kaminawk to siangpahrang hmaa hoiah takhoe oh; to tiah ni anih ih angraeng tangkhang to toenghaih hoiah cak poe tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siangpahrang hmaa ah nangmah hoi nangmah to amkoeh hmah; kalen kaminawk ih ahmuen ah angdoe hmah;
  </para>
  <para style="p">
    <verse number="7" style="v" />mik hoiah na hnuk ih angraeng hmaa ah azathaih hoiah oh pongah loe, Hae ah angzo tahang ah, tiah thui kami ih lok to tahngaih han hoih kue.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lokcaekhaih im ah kami to karangah khing hmah; hnukkhuem ah na imtaeng kami mah azathaih na tongsak nahaeloe kawbangah maw na om tih?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na imtaeng kami hoi poek anghmong ai pongah lok angaek cadoeh, tamqu hmuen to minawk khaeah taphong hmah;
  </para>
  <para style="p">
    <verse number="10" style="v" />to tih ai nahaeloe lok thaih kami mah nang azathaih tongsak hanah taphong ueloe, na hmin hoihaih to amro moeng tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kahoih lok apaehhaih loe sumkanglung pazut het ih sui bungmu hoiah anghmong.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palunghahaih lok hoi thuitaek kami loe, lok tahngai kami hanah, sui naa tangkraeng baktih, suitui kaciim hoiah sak ih bungmu baktiah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Oep kaom laicaeh loe anih patoehkung hanah, cang aah nathuem ih dantui kamding baktiah oh, patoehkung Angraeng ih palungthin to angthasak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tangqum paek han, tiah amoek moe, paek ai kami loe khotui om ai tamai hoiah anghmong.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pauephaih rang hoiah ukkung to pazawk thaih moe, loknaem mah ahuh to angkhaehsak thaih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khoitui to na hnuk maw? Kahoih boekah caa ah, amhah aak ah na caak nahaeloe na palok tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na imtaeng khaeah kahoih boekah caeh ah, na caeh tuektuek nahaeloe, na hmawt ueloe, na hnuma moeng tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />A imtaeng kami nuiah amsawn hnukung ah angdoe kami loe thingboeng, haita, palaa hoiah anghmong.
  </para>
  <para style="p">
    <verse number="19" style="v" />Raihaih tong naah oep kaom ai kami khaeah amhahaih loe, haa kangkhaek, khokkhaem kami hoiah anghmong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Poek angpho kami khaeah laasah kami loe siktue ah laihaw angkhring kami, zencing nuiah kathaw tui bawh baktiah ni oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na misa to zok amthlam nahaeloe buh paek ah; tui anghae nahaeloe naek hanah tui to paek ah;
  </para>
  <para style="p">
    <verse number="22" style="v" />hae loe anih lu nuiah hmaisaae koeng pae baktiah om ueloe, Angraeng mah tahamhoihaih na paek tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aluek bang ih takhi mah kho angzohsak baktih toengah, minawk kasae thui kami ih palai mah palungphuihaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Angzoeh koeh zu hoiah kakawk parai im thungah nawnto oh pongah loe imphu ranui ih im takii ah oh to hoih kue.
  </para>
  <para style="p">
    <verse number="25" style="v" />Angthla parai ahmuen hoiah angzo kahoih tamthanglok loe pakhra tui anghae kami hanah tui kamding ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kahoih ai kami hmaa ah kamtimh katoeng kami loe tui kamnu hoi kaqong tui baktiah ni oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khoitui pop hmoek ah caak han hoih ai baktih toengah, angmah lensawkhaih pakrong kami loe lensawkhaih to hnu mak ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />A poekhaih angsum ai kami loe sipae om ai, kamtimh vangpui hoiah anghmong.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipui tue ih dantui baktih, cang aah tue ah angzo khotui baktiah, kamthu to pakoeh han hoih ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Takung om ai ah kasae thuihaih loe ahmuen kruekah kamhet parit caa hoi anghak ai ah azawk pungpae baktiah ni oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Quiboeng hoiah hrang to boh moe, sum hoiah laa hrang ih tahmawh moem pae baktih toengah, kamthu to cung hoiah bop ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamthu to amthuhaih baktiah pathok hmah; na pathok nahaeloe nang doeh kamthu baktiah ni na om tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamthu ih lok to na pathim nahaeloe, a mik hnukah palungha kami ah poek moeng tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamthu khaeah pat ih lok loe a khok to takroek pat moe, amrohaih tui naek baktiah ni oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kamthu pakha pong ih palunghahaih lok loe, adue ai khokkhaem kami ih khok baktiah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamthu pakoeh kami loe, ngazai pongah lawkthluem moep sut baktiah ni oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kamthu pakha pong ih palunghahaih lok loe soekhring mah thun ih mu paqui ban baktiah ni oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kalen Sithaw mah hmuen boih to sak; kamthu hoi zaehaih sah kami hanah doeh toksakhaih atho to paek boih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ui mah angmah ih tamlok to caak let baktiah, kamthu loe angmah amthuhaih thungah amlaem let.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angmah hoi angmah palungha kami ah poek kami to na hnuk maw? To kami pongah loe kamthu to oepthoh kue.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thasae kami mah loe loklam ah kaipui oh; loklam ah hmawsaeng kaipui oh, tiah thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thok loe takhing ih sum nuiah angbang baktih toengah, thasae kami doeh angmah ih iihkhun nuiah angbet caeng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thasae kami loe laom thungah ban to tapawh boeh, toe pakha ah buh abah hanah paqak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thasae kami loe khopoek thaih kami sarihto pongah, angmah hoi angmah to palungha kue ah poek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lamcaeh naah angmah hoi asaenghaih om ai angzoehhaih pongah kathum kami loe, ui naa patawn caeng kami hoiah anghmong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tamhnuilok ni ka thuih, tiah thuih moe, a imtaeng kami aling kami loe kangqong hmai vah ih baktih, duekhaih phasak kalii kaat kamthu hoiah anghmong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing om ai pongah hmai to duek; pronghaih lok kaom ai ahmuen ah loe, angzoehhaih to om ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hmaisaae to amngaeh moe, thing angqong baktih toengah, angzoeh koeh kami mah lok pungsak thaih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pronghaih lok loe kahoih caaknaek baktiah, kami ih takpum thungah akun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lok loe hoih, toe poeksae palungthin loe anui ah rong nok dui ih long laom baktiah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Minawk hnuma kami loe pahni hoiah kahoih hmuen to thuih, toe a palung thungah loe alinghaih hoiah koi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih mah thuih ih lok loe hoih, toe tang hmah; anih ih palung thungah panuet thok hmuen sarihto oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih mah hnukmahaih to alinghaih hoiah kraeng khoep, toe anih sethaih to minawk hmaa ah angphong let tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Qumqai kami loe angmah qumqaih ih tangqom thungah krah tih; thlung palet kami doeh a palet ih thlung to angmah nuiah amlet let tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amsawnlok thui palai loe angmah pacaekthlaek ih kami to hnukma; lokcaep thaih pakha mah kami to amrosak.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khawnbang hanah amoek hmah, khawnbang ah timaw angzo tih, tito na panoek ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na pakha hoi amkoeh hmah, minawk kalah mah pakoeh nasoe; na pahni hoiah amkoeh hmah, minawk kalah ih pahni mah pakoeh nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thlung loe azit moe, savuet doeh azit; toe kamthu palungphuihaih loe to hnik pongah doeh azit kue.
  </para>
  <para style="p">
    <verse number="4" style="v" />Palungphuihaih loe zit thoh; toe mi maw uthaih hmaa ah angdoe thai tih?
  </para>
  <para style="p">
    <verse number="5" style="v" />Tamquta hoiah amlung pongah loe kamtueng ah angzoeh to hoih kue.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ampui loe ahmaa caak naah doeh oepthoh; toe misa mah mok ih loe alinghaih ah ni oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zok amhah kami loe khoitui to panuet; toe zok amthlam kami hanah loe ka khaa doeh luep.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angmah ih im caehtaak kami loe, angmah ih tabu azawk taak tavaa hoiah anghmong.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmuihoih hoi hmuihoih tui mah poekhaih to nawmsak; ampui kahoih mah loe anghoe koi kaom poekhaih to palung tang hoiah paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nam pui hoi nam pa ih ampui to pahnawt hmah; raihaih tong naah nam nawkamya im ah caeh hmah; na imtaeng kami loe ahmuen kangthla ah kaom nam nawkamya pongah hoih kue.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka capa, palungha ah loe, ka palungthin hae anghoesak ah; to tiah ni kai hnaphnae kaminawk to ka pathim thai tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khopoek thaih kami loe raihaih to hnukcoek moe, abuephaih to pakrong; toe poekhaih tawn ai kami loe muk rumram moe, patangkhanghaih to hnuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kahni to na khring pae ai ah loe angvin hoi panoek ai ih nongpata khaeah lokkamhaih to sah hmah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khawnthaw ah angmah ih ampui hanah tha hoi tahamhoihaih paek kami loe, anih tangoenghaih baktiah ni oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angzoeh koeh zu loe cawh tue ah, khotui kalong imphu hoiah anghmong.
  </para>
  <para style="p">
    <verse number="16" style="v" />To baktih nongpata to hawk kami loe, takhi hawk kami hoiah anghmong, anih loe bantang ban ah bawh ih situi baktiah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sum mah sum to noetsak baktih toengah, ampui mah angmah ih ampui mikhmai to pansak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thaiduetkung toep kami loe thaiduet thaih to caa tih; to baktih toengah Angraeng khenzawn kami loe pakoehhaih to om tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui pongah krang amtueng baktih toengah, kami ih palungthin mah kami to amtuengsak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hell hoi duekhaih loe natuek naah doeh koi thai ai; to baktih toengah kami mik mah hnukhaih to boep thai ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sumkanglung tui pacii hanah laom to oh, suitui pacii hanah kamngaeh hmai to oh; to baktih toengah kami doeh pakoehhaih hoiah tanoek thaih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kamthu loe cang hoi nawnto suum pongah na daeng cadoeh, amthuhaih to anghmaa thai mak ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangmah ih tuunawk to kahoih ah panoek ah loe, nangmah ih maehnawk to kahoih ah khenzawn ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Angraenghaih loe dungzan ah cak poe ai; angraeng lumuek doeh caa nawktanawk khoek to cak poe ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Phroh loe amprawk moe, phroh kangtha to tacawt, mae ah kaom lawk ih cang to aah o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuu zawhhaih phoisa hoiah khukbuen to qan ah, maeh zawhhaih atho hoiah lawk to qan ah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na caanawk hoi na tamna nongpatanawk pacah hanah, maeh tahnutui kapop ah na tawn tih. p
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kahoih ai kami loe mi mah doeh patom ai to mah a cawnh; toe katoeng kaminawk loe kaipui baktiah misahoih o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Prae thungah zaehaih pung pongah, ukkung doeh pop; toe khopoek thaih kami hoi palungha kami hoiah ni prae to cak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kamtang pacaekthlaek kami loe thingthai athaisak ai khotui baktiah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Patukhaih lok pahnawt kami loe kahoih ai kami to thapaek, toe patukhaih lok baktiah khosah kami loe nihcae ih lok to aek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kasae kami loe toenghaih to panoek ai; toe Angraeng pakrong kami loe hmuen to panoek boih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kahoih ai hmuen sah angraeng pongah loe toenghaih hoi khosah mithoe to hoih kue.
  </para>
  <para style="p">
    <verse number="7" style="v" />Patukhaih lok pazui kami loe palungha kami ah oh; toe angzoeh koeh kami hoi ampui sah kami loe ampa to mikhmai setsak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Katoeng ai loklam hoiah hak ih phoisa hoi hmuenmae patung mangh kami loe, kamtang tahmen thaih kami hanah ni patung pae.
  </para>
  <para style="p">
    <verse number="9" style="v" />Patukhaih lok pazui ai kami loe, anih ih lawkthuihaih doeh panuet thoh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Katoeng kami loklam amkhraengsak kami loe, angmah ih tangqom thungah krah tih; toe katoeng kami loe kahoih hmuen to toep tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Long angraeng loe angmah hoi angmah to palungha kami ah poek; toe poek thaihaih katawn mithoe loe anih pongah panoek kue.
  </para>
  <para style="p">
    <verse number="12" style="v" />Katoeng kami palung anghoe naah, kating ai lensawkhaih to oh; kasae kami thacak naah loe kaminawk anghawk o king.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angmah ih zaehaih angphat kami loe khosak hoih mak ai; toe a zaehaih taphong moe, caehtaak kami loe, Sithaw palungnathaih to hnu tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng zithaih tawn poe kami loe tahamhoih; toe palungthah kami loe raihaih thungah amtim tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ukkung kahoih ai loe hmawhsaeng kaipui, to tih ai boeh loe taqom baktiah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Panoekthaihaih tawn ai ukkung loe pacaekthlaek kami ah oh; toe uthaih hnuma kami loe hinglung sawk tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Athii palong kami loe tangqom thungah caeh tih; anih to mi mah doeh angdoe haih hmah nasoe.
  </para>
  <para style="p">
    <verse number="18" style="v" />Katoeng loklam ah caeh kami loe ngancuem tih; toe lam amkhraeng kami loe amtim roep tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lawk toksah kami loe caaknaek tawn mang tih; toe tidoeh avang ai kami hnukbang kami loe amtang tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Oepthok kami loe tahamhoihaih hnu tih; toe karangah angraeng koeh kami loe toenghaih hoiah toksah mak ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Minawk mikhmai khet han hoih ai; kami loe takaw kae maeto hak hanah kasae hmuen to sak thaih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karangah angraeng koeh kami loe kahoih ai mik to tawnh; anih mah a nuiah amtanghaih pha tih, tito panoek ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pakha hoi pakoeh kami pongah loe, minawk thuitaek kami to hnukkhuem ah pakoehhaih hak tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ampa hoi amno ih hmuenmae to lomh ah, zaehaih ah om ai, tiah thui kami loe, amrosak kami ih ampui ah ni oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amoekhaih palungthin tawn kami mah angzoehhaih to ohsak; toe Angraeng oep kami loe zok amhah tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />A poekhaih angoep kami loe kamthu ni; toe palunghahaih hoiah caeh kami loe loihaih to hnu tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kamtang abomh kami loe amtang mak ai; toe kamtang to hnu ai kami baktiah angsah kami loe, kasaethuihaih to hnu tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Katoeng ai kami angraeng naah minawk mah anghawk taak; toe nihcae duek naah, katoeng kaminawk to qoeng o tahang tih.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thuitaek pacoengah doeh angmah ih tahnong amtaksak kami loe, hoih thai ai, amrohaih to tong roep tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Katoeng kami ukhaih kaa tawnh naah, kaminawk anghoe o; toe kahoih ai kami mah uk naah loe kaminawk palungset o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Palunghahaih koeh kami loe ampa to anghoesak; toe tangzat zaw nongpata hoi angkom kami loe a tawnh ih hmuen to pasaeng boih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toenghaih hoiah prae uk siangpahrang loe prae to caksak; toe bokhaih tangqum paekhaih koeh kami loe a prae to amtimsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />A imtaeng pakoeh kami loe angmah aman hanah palok payang kami ah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kasae kami loe a zaehaih pongah amanh; toe katoeng kami loe anghoehaih hoiah laa to sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng kami loe kamtangnawk hanah khopoek pae; toe kahoih ai kami loe tidoeh dawncang ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Minawk khet patoek kami loe vangpui to hmai angqongsak; toe palungha kami loe palungphuihaih to dipsak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Palungha hoi kamthu loe lam nawnto a caeh hoi naah, kamthu loe palungphuihaih hoiah maw, to tih ai boeh loe pahnuihaih hoiah maw om cadoeh, monghaih roe tawn mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Minawk athii palong koeh kami loe katoeng kami to hnukma; toe katoeng kami loe minawk hinghaih to khet pae.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kamthu loe a poekhaih to taphong boih; toe palungha kami loe atue pha ai karoek to angphat.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ukkung mah amsawnlok to tahngai nahaeloe, a toksah tamnanawk boih loe kasae kami ah ni oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kamtang hoi aling thaih kami anghmonghaih loe hae tiah oh; Angraeng mah ni nihnik hanah mik aanghaih to paek hmaek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Siangpahrang mah kamtang to toenghaih hoiah lokcaek nahaeloe, angmah ih angraeng tangkhang to cak poe tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thuitaekhaih cung mah palunghahaih to paek; toe prawt sut ih caa mah loe amno to ahmin setsak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kasae kami pung naah, zaehaih doeh pung; toe katoeng kami mah loe nihcae amtimhaih to hnuk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na caa to thuitaek ah, to tih nahaeloe anih mah poek monghaih to na paek tih; ue, anih mah poeknawmhaih to na paek tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angzo han koi hmuen hnukhaih om ai ah loe kaminawk amro o; toe patuk ih lok pazui kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamna loe kahoih lok khue hoi thuitaek han om ai; anih loe lok to thaih, toe thai ai baktiah om tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Poek het ai ah karangah lok apae kami to na hnuk maw? To kami pongah loe kamthu to oepthoh kue.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tamna to nawkta nathuem hoiah kahoih ah khetzawn nahaeloe, hnukkhuem ah angmah ih caa ah angcoeng tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Palungphui thaih kami mah angzoehhaih to tacawtsak, poek amthueng kami loe zaehaih sak pop.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amoekhaih mah kami to krahsak tathuk tih; toe kami tlim ah khosakhaih loe pakoehhaih ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kamqu hoi amyok kami loe a hinghaih to hnukma; anih mah kasae thuihaih lok to thaih, toe taphong han zit.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kami zithaih loe kami hanah patung ih dongh ah oh; toe Angraeng oep kami loe ngancuem tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kami paroeai mah ukkung koehhaih to pakrong o; toe kami loe Angraeng khae hoiah ni toenghaih to hnuk.
  </para>
  <para style="p">
    <verse number="27" style="v" />Katoeng kami mah toeng ai kami to panuet; katoeng ai kami mah toenghaih hoi khosah kami to panuet toengh.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakeh capa Agur mah thuih ih, palunghahaih loknawk loe hae tiah oh; kami maeto mah, Ithiel, Ithiel hoi Ukal khaeah, taphong pae;
  </para>
  <para style="p">
    <verse number="2" style="v" />kai loe minawk boih pongah poek ka ham kue, kami poekhaih to ka tawn ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Palunghahaih to kam tuk ai moe, ciimhaih kawng doeh ka panoek ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi maw van ah daw tahang moe, long ah anghum tathuk? Azom pui ah takhi naeh kami loe mi maw? Mi maw kahni pongah tui tapawk vai? Long boenghaih ahmuennawk boih caksakkung loe mi maw? To tiah sahkung ih ahmin hoi a caa ih ahmin loe mi maw? Na thui thai tih maw?
  </para>
  <para style="p">
    <verse number="5" style="v" />Sithaw ih lok loe ciim boih; anih loe angmah khae amha kaminawk boih hanah abuephaih ah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng ih lok to patomh hmah, to tih ai nahaeloe anih mah na zoeh ueloe, na thuih ih amsawnlok to amtueng moeng tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, ka dueh ai naah nang sak pae hanah, hnik ih hmuen hnetto oh;
  </para>
  <para style="p">
    <verse number="8" style="v" />amsoem ai lok hoi amsawn lok hae kai khae hoiah na takhoe pae ving ah; amtanghaih hoi angraenghaih doeh na paek hmah; ni thokkruek caak khawt caaknaek to na paek ah:
  </para>
  <para style="p">
    <verse number="9" style="v" />to tih ai ah pop hmoek ah ka tawnh nahaeloe, nang kang pahnet ving ueloe, Angraeng loe mi aa? tiah ka thui moeng tih; kam tang hmoek nahaeloe, ka paqu moeng ueloe, ka Sithaw ih ahmin to ka saesak moeng tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angmah ih angraeng khaeah tamna sethaih kawng to thui hmah, kasae na thuih nahaeloe nang to na pasoih ueloe, na nuiah zaehaih om moeng tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ampa to kasae thui kami, amno tahamhoihaih paek ai kami to oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angmacae amhnonghaih to pasae ai ah, angmah mik ah kai loe ciim, tiah poekhaih tawn kami to oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amoekhaih hoiah mikpadai kami, patoekhaih hoi minawk khen kami to oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Haa loe sumsen baktiah oh moe, long ah kaom kamtang hoi mithoenawk to paaeh hanah, toektaboe ahuh haita baktih kaom kami doeh oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Taqawt loe canu hnetto tawnh; nihnik loe na paek ah, na paek ah, tiah hangh hoi. Amhah thai ai hmuen thumto oh, ue, khawt boeh, tiah thui vai ai hmuen palitonawk loe,
  </para>
  <para style="p">
    <verse number="16" style="v" />taprong, caa kak nongpata ih zok, tui amhah thai ai long karoem; zetto mah tiah thui vai ai hmai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ampa pahnui thuih moe, amno patoek kami loe, azawn ih pangaahnawk mah anih ih mik to taprok pae ueloe, tahmunawk mah a ngan to caa o tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka dawnrai ih hmuen thumto khue ai ah, ka panoek thai ai ih hmuen palitonawk loe,
  </para>
  <para style="p">
    <verse number="19" style="v" />van ih tahmu azawkhaih loklam, cathaeng nui ih pahui caehhaih loklam, tuipui thung ih palongpui caehhaih loklam, thendoeng mah tangla paqaihaih loklam hae ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sava nuiah oep om ai nongpata caehhaih loklam doeh to tiah oh; to nongpata loe buh to caak moe, pakha a huk pacoengah, kai loe hmuen sakpazaehaih ka tawn ai, tiah thuih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Long tasoehsak hmuen thumto khue ai ah, pauep thai ai ih hmuen palitonawk loe,
  </para>
  <para style="p">
    <verse number="22" style="v" />siangpahrang ah kangcoeng tamna, caaknaek tawn mangh kamthu;
  </para>
  <para style="p">
    <verse number="23" style="v" />amram aak nongpata sava sakhaih hoi tamna nongpata mah angraeng ih qawktoephaih hae ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Long nuiah tetta ah ni oh, toe paroeai palungha hmuen palitonawk loe,
  </para>
  <para style="p">
    <verse number="25" style="v" />thacak ai, toe nipui tueah caaknaek patung thaih, cahmatnawk;
  </para>
  <para style="p">
    <verse number="26" style="v" />thacak ai, toe lungsong thungah tabu sah savehnawk;
  </para>
  <para style="p">
    <verse number="27" style="v" />siangpahrang tawn ai, toe nawnto hmabangah kacaeh pakhunawk;
  </para>
  <para style="p">
    <verse number="28" style="v" />angmah ih ban hoiah angdoet, toe siangpahrang im ah ohhaih ahmuen katawn caneknawk cae hae ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kahoih ah kacaeh thaih hmuen thumto khue ai, ue, kahoih ah kacaeh thaih hmuen palitonawk loe,
  </para>
  <para style="p">
    <verse number="30" style="v" />kasan moinawk thungah thacak koek, kawbaktih hmuen om cadoeh hnuk angnawk taak ai kaipui;
  </para>
  <para style="p">
    <verse number="31" style="v" />misatukhaih hrang, maeh tae hoi misa tawn ai siangpahrang cae hae ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kamthu ah nang coeng moe, nangmah hoi nangmah nam koeh naah maw, to tih ai boeh loe kahoih ai hmuen na poek naah maw, na pakha to tamuep khoep ah!
  </para>
  <para style="p">
    <verse number="33" style="v" />Maitaw tahnutui loe ahaeh khing nahaeloe, amkhawk tih, hnah doeh na hnoih khing nahaeloe, athii long tih; to baktih toengah palungphui hanah pahrue khing nahaeloe, angzoehhaih to om tih.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lemuel siangpahrang ih palunghahaih lok, amno mah patuk ih lok loe hae tiah oh;
  </para>
  <para style="p">
    <verse number="2" style="v" />aw ka capa, aw ka zok thung ih ka capa, aw lokkamhaih ka capa,
  </para>
  <para style="p">
    <verse number="3" style="v" />na thacakhaih to nongpatanawk khaeah patoh hmah loe, siangpahrang hum koeh kaminawk caehhaih loklam to pazui hmah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Lemuel, siangpahrangnawk loe misurtui naek han om ai; angraengnawk loe misurtui paqui han amcuk ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />nihcae mah nae o nahaeloe, patukhaih lok to pahnet o ueloe, amtang kami han toenghaih hoiah lokcaekhaih to amkhraeng o taak ving moeng tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anghmaa angtaa kami hanah mu to paek oh loe, palungboeng kami hanah misurtui to paek oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah amtanghaih hoi patangkhanghaih pahnet hanah nae nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amtang kaminawk mah hak han koi hmuen to a hak o thai hanah, lokthui thai ai kaminawk to lokthuih abomh oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lok to thui ah loe, toenghaih hoiah lok to caek ah; amtang kami hoi mithoenawk mah hak han koi hmuen to paek oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi mah maw tuinuen kahoih zu to hnu thai tih? To nongpata loe atho kana thlung kathim pongah atho oh kue.
  </para>
  <para style="p">
    <verse number="11" style="v" />A sava mah anih to oep ueloe, amtanghaih hoiah loih tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />To baktih nongpata loe a sava hanah kasae hmuen to sah ai; a hing thung kahoih hmuen to a sinh pae.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih loe tuumui hoi pathlah to pakrong moe, a koeh baktiah a ban hoiah tok to a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih loe hmuenmae zawhaih palongpui baktiah oh moe, angthla parai ahmuen hoiah caaknaek to a phawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loe khodai ai naah angthawk moe, a imthung takoh hanah caaknaek to patoem pae, a tamna nongpatanawk hanah caaknaek to a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih loe poek het moe, lawk doeh a qanh; a toksakhaih atho hoiah misurkung to a tlingh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih loe kaengkaeh to kacakah angzaeng moe, a ban to thacaksak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah zawh ih hmuenmae loe atho oh; anih ih hmaiim doeh aqum puek dueh mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />A ban hoiah lahat to a kaeh moe, a ban hoiah kahni to a sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amtang kaminawk to a khetzawn, ue, mithoenawk to abomh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih ih imthung takoh loe kahni kamling to angkhuk o boih pongah, dantui krah cadoeh tasoehhaih tawn ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angmah hanah kahni to a sak moe, rong kamling hup puu ngan laihaw to angkhuk.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih ih sava loe vangpui khongkhanawk ah prae thung ih kacoehtanawk hoi nawnto anghnut moe, ahmin amthang kami ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih loe puu ngan kahni to sak moe, a zawh; kaziinawk doeh hmuenmae zaw kami khaeah a zawh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih loe thacak moe, khingya koi khukbuen hoiah amthoep; anih loe angzo han koi atue ah anghoehaih hoiah khosah tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih loe palunghahaih hoiah lok to thuih, anih ih pahni ah tahmenhaih lok to oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih loe angmah ih imthung takoh to kahoih ah khetzawn, thasethaih buh to caa ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />A caanawk loe angthawk o moe, amno to tahamhoihaih paek o; a sava mah doeh anih to pakoeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Paroeai kami ih canunawk mah kahoih hmuen to sak o; toe nang mah loe nihcae to na takrenh boih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lok kahoih loe alinghaih ah ni oh; kranghoihaih doeh azom pui ni; toe Angraeng zii nongpata loe, pakoehhaih hnu tih.
  </para>
  <para style="p">
    <verse number="31" style="v" />To baktih nongpata hanah a toksakhaih tangqum to paek oh; a toksakhaih mah anih to vangpui khongkha ah pakoeh nasoe.
  </para>
</usx>
