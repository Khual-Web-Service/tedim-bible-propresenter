<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MAT" style="id">Mathai</book>
  <para style="h">Mathai</para>
  <para style="toc1">Mathai</para>
  <para style="toc2">Mathai</para>
  <para style="mt">Mathai</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham capa David, David capa Jesu Kri angzohhaih kawng Cabu loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham mah Isak to sak; Isak mah Jakob to sak; Jakob mah Judah hoi nawkamyanawk to sak;
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah mah Tamar khae hoiah Perez hoi Zerah to sak; Perez mah Hezron to sak; Hezron mah Ram to sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ram mah Aminadab to sak; Aminadab mah Nashon to sak; Nashon mah Salmon to sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Salmon mah Rahab khae hoiah Boaz to sak; Boaz mah Ruth khae hoiah Obed to sak; Obed mah Jesse to sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesse mah David siangpahrang to sak; David siangpahrang mah Uriah ih zu khae hoiah Solomon to sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Solomon mah Rehoboam to sak; Rehoboam mah Abijah to sak; Abijah mah Asa to sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asa mah Jehoshaphat to sak; Jehoshaphat mah Jehoram to sak; Jehoram mah Uzziah to sak;
  </para>
  <para style="p">
    <verse number="9" style="v" />Uzziah mah Jotham to sak; Jotham mah Ahaz to sak; Ahaz mah Hezekiah to sak;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hezekiah mah Manasseh to sak; Manasseh mah Amon to sak; Amon mah Josiah to sak;
  </para>
  <para style="p">
    <verse number="11" style="v" />Babylon ah misong ah hoih o nathuem ah, Josiah mah Jekoniah hoi anih ih nawkamyanawk to sak:
  </para>
  <para style="p">
    <verse number="12" style="v" />Babylon ah misong ah hoih o pacoengah Jekoniah mah Shealtiel to sak; Shealtiel mah Zerubbabel to sak;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerubbabel mah Abiud to sak; Abiud mah Eliakim to sak; Eliakim mah Azor to sak;
  </para>
  <para style="p">
    <verse number="14" style="v" />Azor mah Zadok to sak; Zadok mah Akim to sak; Akim mah Eliud to sak;
  </para>
  <para style="p">
    <verse number="15" style="v" />Eliud mah Eleazar to sak; Eliazar mah Matthan to sak; Matthan mah Jakob to sak;
  </para>
  <para style="p">
    <verse number="16" style="v" />Jakob mah Meri sava Joseph to sak; Meri mah Kri, tiah kawk ih, Jesu to tapen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham hoi David karoek to dung hatlai palito oh moe, David hoi Babylon ah misongah hoih o karoek to, dung hatlai palito oh; Babylon misong ah laemh o haih hoi kamtong Kri karoek to dung hatlai palito oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu Kri tapenhaih loe hae tiah oh: Anih ih amno Meri loe Joseph mah zu ah hamh, nihnik zu sava ah om hoi ai naah, Meri loe Kacai Muithla ih caa to pomh boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A sava Joseph loe katoeng kami ah oh, to pongah minawk panoeksak han koeh ai, a zu to tamquta hoi pahnawt sut hanah a poek.
  </para>
  <para style="p">
    <verse number="20" style="v" />To tiah a poek li naah, khenah, Angraeng ih van kami mah amang ah anih khaeah amtueng thuih, David capa Joseph, na zu Meri to zu ah lak han zii hmah: anih loe Kacai Muithla rang hoiah ni zokpomh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meri mah Caa nongpa to sah tih, Anih ih ahmin loe JESU, tiah sak han oh, Anih loe angmah ih kaminawk to zaehaih thung hoiah pahlong tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tahmaa patohhaih rang hoiah Angraeng mah thuih ih lok akoep hanah hae hmuen hae sak ah oh,
  </para>
  <para style="p">
    <verse number="23" style="v" />khenah, kacuem tangla loe zokpom tih, capa maeto sah ueloe, anih ih ahmin to Emmanuel, tiah kawk o tih; thuih koehhaih loe Sithaw aicae hoi nawnto oh, tih haih ih ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joseph iih anglawt pacoengah loe, Angraeng ih van kami mah thuih pae ih lok baktih toengah Meri to zu ah lak,
  </para>
  <para style="p">
    <verse number="25" style="v" />a zu mah Calu nongpa tapen ai karoek to a zu to iip haih ai. Anih ih ahmin to JESU, tiah a sak.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Herod siangpahrang ah oh nathuem ah, Jesu loe Judea prae Bethlehem vangpui ah tapenh, khenah, ni angyae bang hoiah palungha kaminawk Jerusalem ah angzoh o moe,
  </para>
  <para style="p">
    <verse number="2" style="v" />vaihiah tapen Judea kaminawk ih siangpahrang loe naa ah maw oh? Ni angyae bangah anih ih cakaeh to ka hnuk o pongah, anih bok hanah kang zoh o, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To lok to Herod siangpahrang mah thaih naah, dawnrai, Jerusalem vangpui ih kaminawk boih dawnrai o.
  </para>
  <para style="p">
    <verse number="4" style="v" />To naah anih mah kalen koek qaimanawk hoi ca tarikkungnawk to nawnto kawk cuu moe, Kri loe naa ah maw tapen tih, tiah a dueng.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae mah anih khaeah, Judea prae Bethlehem vangpui ah tapen tih: tahmaa mah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Judea prae thung ih, Bethlehem, nang loe Judea prae ukkungnawk thungah kathoeng koek na ai ni; nang thung hoiah Ukkung to angzo ueloe, anih mah Kai ih Israel kaminawk to uk tih, tiah tarik ih oh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah Herod mah palungha kaminawk to kawk duem moe, natuek naah maw nihcae khaeah cakaeh amtueng pae, tito kahoihah dueng.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah nihcae to Bethlehem ah patoeh, Caeh oh loe nawkta to kahoihah pakrong oh; anih to na hnuk o naah tamthang na thaih o sak ah, kang zoh moe, anih to ka bok toeng han, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Siangpahrang ih lok thaih pacoengah nihcae loe caeh o; khenah, ni angyae bangah a hnuk o ih cakaeh loe, nawkta ohhaih ahmuen to phak moe, anghak o ai karoek to nihcae hmaa ah caeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae mah cakaeh to hnuk o naah, paroeai anghoehaih hoiah oh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Imthug ah akun o naah loe, nawkta hoi Anih ih amno Meri to a hnuk o, khokkhu cangkrawn o moe, anih to a bok o: tangqum tabunawk to paongh o moe, sui, hmuihoih Frankinsin hoi myrrth to anih hanah paek o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae Herod khaeah amlaem let han ai ah Sithaw mah amang ah acoehaih paek pongah, loklam kalah bang hoiah angmacae prae ah amlaem o ving.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae amlaem o pacoengah, khenah, Angraeng ih van kami maeto Joseph ih amang ah amtueng pae, Angthawk ah, nawkta hoi Anih ih amno to lah loe, Izip prae ah cawn haih ah, to ah lok kang thui ai karoek to om ah; Herod mah nawkta hum hanah pakrong tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih loe angthawk moe, nawkta hoi Anih ih amno to lak pacoengah, khoving ah Izip prae ah caeh haih:
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loe to ah Herod dueh ai karoek to oh: Izip prae hoiah ka Capa to ka kawk, tiah tahmaa patohhaih rang hoiah Angraeng mah thuih ih lok akoep han ih ni to tiah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Palungha kaminawk mah ang ling boeh, tiah Herod mah panoek naah, paroeai palungphui; palungha kaminawk khaeah lokduenghaih atue pakoep pacoengah, kami patoeh moe, Bethlehem vangpui hoi a taengah kaom saning hnetto hoi atlim bang nawktanawk to humsak boih.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah Ramah vangpui thungah oihaih, qahhaih hoi palungsethaih lok to oh, Rachel mah a caanawk to qah haih, a caanawk om o ai boeh pongah, monghaih om ai boeh, tiah tahmaa Jeremiah mah thuih ih lok to akoep boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe khenah, Herod duek pacoeng, Izip prae ah oh naah, Angraeng ih van kami maeto Joseph ih amang ah amtueng pae,
  </para>
  <para style="p">
    <verse number="20" style="v" />anih khaeah, Angthawk ah, nawkta hoi Anih ih amno to lah loe, Israel prae ah caeh haih ah; nawkta hinghaih lak han pakrong kaminawk loe duek o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih loe angthawk moe, nawkta hoi Anih ih amno lak pacoengah, Israel prae ah amlaem haih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe anih mah Arkhelaus loe ampa Herod zuengah Judea prae to uk, tiah thaih naah to ah caeh hanah zit: Sithaw mah amang ah acoehaih paek baktih toengah, anih loe Kalili prae thungah caeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih loe Nazareth vangpui ah caeh moe, to ah khosak: Anih loe Nazareth kami, tiah kawk o tih, tiah tahmaanawk mah thuih o ih lok akoep han ih ni to tiah oh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />To naah tuinuemhaih paekkung Johan to angzoh moe, Judea praezaek thungah lok to thuih,
  </para>
  <para style="p">
    <verse number="2" style="v" />anih mah, Dawnpakhuem oh: van prae loe zoi boeh, tiah thuih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tahmaa Isaiah mah thuih ih lok loe, Praezaek ah kahang lok mah, Angraeng ih loklam to paroep oh, a loklamnawk to patoengh oh, tiah thuih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan loe kaengkuu hrang moihin to angkhuk moe, moihin kaengkaeh to angzaeng; anih loe pakhuh hoi khoitui to buh ah caak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jerusalem, Judea prae kami hoi Jordan vapui taeng ih kaminawk boih anih khaeah caeh o,
  </para>
  <para style="p">
    <verse number="6" style="v" />angmacae zaehaih taphong o pacoengah, anih mah Jordan vapui ah tuinuemhaih to paek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih tuinuemhaih ahmuen ah angzo paroeai Farasi hoi Sadusinawk to a hnuk naah, anih mah nihcae khaeah, Aw pahui caanawk, angzo han koi palungphuihaih cawnhtaak ving hanah mi mah maw ang thuih o?
  </para>
  <para style="p">
    <verse number="8" style="v" />Dawnpakhuemhaih athaih to athai oh:
  </para>
  <para style="p">
    <verse number="9" style="v" />kaicae loe pa Abraham ka tawnh o, tiah poek o hmah: kang thuih o, Sithaw mah loe hae thlungnawk hae Abraham ih caa ah angcoengsak thaih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vaihi loe thingkung tangzun ah caka suekcoek ah oh boeh: kahoih athaih athai ai thingkung loe pakhruk moe, hmai thungah vah boih boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai mah loe dawnpakhuem tuinuemhaih ni tui hoiah kang paek o: toe ka hnukah angzo kami loe kai pongah len kue, kai loe anih ih khokpanai sin han mataeng doeh kam cuk ai: anih mah loe Kacai Muithla hoi hmai hoiah tuinuemhaih na paek o tih:
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loe ban ah cang hawhhaih paqa to sin ueloe, cang to kaciim ah haw tih; angmah ih cang loe tapup thungah suem ueloe, canghii loe kadueh thai ai hmai thungah va tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah Jesu loe tuinuem hanah Kalili prae hoi Jordan vapui ah Johan khaeah caeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe Johan mah angmaak pae, Kai loe nang khae ih tuinuemhaih to ka ngaih, tipongah kai khaeah nang zoh lat loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu mah anih khaeah, Aihnik mah toenghaih boih akoepsak hanah oh pongah, vaihi loe to tiah na sah pae raeh, tiah a naa. To naah Johan mah Anih koehhaih to paroi pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu loe tuinuem pacoengah, tui thung hoiah angthawk tahang: khenah, anih hanah van to amongh, a nuiah kacuk, pahuu baktiah anghum tathuk, Sithaw ih Muithla to a hnuk:
  </para>
  <para style="p">
    <verse number="17" style="v" />to naah van bang hoiah, Hae loe palung duek ih ka Capa ni, a nuiah paroeai kang hoe, tiah lok to angzoh.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jesu loe taqawk mah pacuek hanah, Muithla mah praezaek ah caeh haih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Qum quipalito hoi ni quipalito buhzah pacoengah, anih loe zok amthlam.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pacuekkung loe anih khaeah caeh moe, Sithaw Capa ah na oh nahaeloe, hae ih thlungnawk hae takaw ah angcoengsak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe anih mah, Kami loe takaw khue hoiah hing mak ai, Sithaw pakha thung hoi tacawt lok hoiah ni hing tih, tiah tarik ih oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pacoengah taqawk mah anih to kaciim vangpui thungah caeh haih moe, tempul ranui ah ohsak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih khaeah, Na khok thlung pong daeng han ai ah, anih mah angmah ih van kaminawk to lokpaek ueloe, nihcae ih ban hoiah nang to na tapom o tih, tiah tarik ih lok oh baktih toengah, Sithaw Capa ah na oh nahaeloe, lungpung tathuk ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu mah anih khaeah, Na Angraeng Sithaw to tanoek hmah, tiah tarik ih oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah taqawk mah anih to maesang nuiah caeh haih moe, long nui ih praenawk hoi lensawkhaihnawk boih to patuek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih khaeah, Na cangkrawn moe, kai nang bok nahaeloe, hae hmuennawk boih hae kang paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah anih khaeah, Setan, hae ahmuen hoi tacawt ah: na Angraeng Sithaw khue to bok ah loe, Anih ih tok khue to sah ah, tiah tarik ih oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah loe taqawk mah anih to caehtaak, khenah, van kaminawk angzoh o moe, Anih ih tok to sak pae o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Johan thongim pakhrak o, tito Jesu mah thaih naah, anih loe Kalili prae ah amlaem;
  </para>
  <para style="p">
    <verse number="13" style="v" />Nazareth vangpui to a caehtaak, tuipui taeng ih Zebulun hoi Naphtali prae angzithaih ahmuen ah kaom, Kapernuam vangpui ah a caeh moe, to ah khosak:
  </para>
  <para style="p">
    <verse number="14" style="v" />tahmaa Isaiah mah thuih ih lok akoep thai hanah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebulun hoi Naphtali ih prae, tuipui caehhaih loklam, Jordan vapui yaeh, Gentel kaminawk ih Kalili;
  </para>
  <para style="p">
    <verse number="16" style="v" />vinghaih thungah anghnu kaminawk mah kalen parai aanghaih to hnuk o boeh; to prae thungah kaom, duekhaih tahlip ah anghnu kaminawk nuiah aanghaih to phak boeh, tiah thuih ih lok to akoep han ih ni to tiah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />To nathuem hoi kamtong Jesu mah, Dawnpakhuem oh; van prae loe zoi boeh, tiah tamthanglok thuih amtong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu Kalili tuipui taengah caeh naah, Piter tiah kawk ih Simon hoi amnawk Andru, nawkamya hnik loe, tuipui ah palok haeng hoi; to naah Anih mah hnuk: nihnik loe tanga naeh kami ah oh hoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih mah nihnik khaeah, Ka hnuk ah bang hoih, kami naehkung ah kang sak hoi han, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihnik loe palok to vah hoi sut moe, Anih hnukah bang hoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih to ahmuen hoiah tacawt pacoengah, ampa Zebedi hoi nawnto palong thungah palok pading, kalah nawkamya Zebedi ih capa Jakob hoi amnawk Johan to anih mah hnuk naah nihnik to a kawk.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihnik loe palong hoi ampa to caeh hoi taak moe, anih hnukah bang hoi roep.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu loe Kalili prae thung boih ah caeh moe, Sineko ah kaminawk to patuk, siangpahrang mah ukkhaih prae tamthanglok hoih to a thuih pae, ngantui ai kaminawk hoi congca nathaih tawn kaminawk to ngan a tuisak.
  </para>
  <para style="p">
    <verse number="24" style="v" />To naah Syria prae boih ah Jesu kawng to amthang: congca nathaih tawn kami hoi congca patangkhanghaih tongh kaminawk, ngantui ai kaminawk, kamthunawk, taqawk tawn kaminawk, khok ban angtawt thai ai kaminawk boih, anih khaeah angzoh o haih, anih mah nihcae to ngantuisak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kalili, Dekapoli, Jerusalem, Judea prae, Jordan vapui yaeh hoiah angzo paroeai kaminawk loe anih hnukah bang o.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anih mah kami paroeai hnuk naah, mae nuiah dawh tahang moe, anghnut, to naah a hnukbang kaminawk anih khaeah angzoh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah anih mah lok to thuih moe, nihcae to patuk,
  </para>
  <para style="p">
    <verse number="3" style="v" />poek amtang kaminawk loe tahamhoih o: van prae loe nihcae ih ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Palungsae kaminawk loe tahamhoih o: nihcae mah monghaih to hnu o tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Poeknaem kaminawk loe tahamhoih o: nihcae mah long qawk to toep o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toenghaih bangah zok amthlam, tui anghae kaminawk loe tahamhoih o: nihcae loe zok amhah o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kami nuiah palungnathaih tawn kaminawk loe tahamhoih o: nihcae loe palungnathaih to hnu o tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Poekciim kaminawk loe tahamhoih o: nihcae loe Sithaw to hnu o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angdaehhaih sah kaminawk loe tahamhoih o: nihcae loe Sithaw ih caa, tiah kawk o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toenghaih pongah pacaekthlaekhaih tongh kaminawk loe tahamhoih o: van prae loe nihcae taham ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai pongah, minawk mah ang zoeh o, ang pacaekthlaek o, amsoem ai ah congca kasae loknawk hoiah ang zoeh o naah, tahamhoih kami ah na oh o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anghoe oh loe, paroeai oephaih to tawn oh: nangcae han kalen parai tangqum van prae ah oh: nangcae hma ah kaom tahmaanawk doeh to tiah ni pacaekthlaek ah oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangcae loe long paloi ah na oh o: toe paloi loe a khrumhaih anghma nahaeloe, kawbangah maw khrum let thai tih boeh? Vah ving moe, minawk mah khok hoiah cawh khue ai ah loe, tidoeh avanghaih om ai boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangcae loe long aanghaih ah na oh o: mae nuiah kaom vangpui loe anghawk thai ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi kawbaktih kami mah doeh hmai pa-aang naah, hmai to takho hoiah muek o vai ai, hmai paanghaih ahmuen ah ni suek o; to naah ni imthung ah kaom hmuennawk to aanghaih paek boih.
  </para>
  <para style="p">
    <verse number="16" style="v" />To baktih toengah, kaminawk mah na sak o ih kahoih hmuen to hnuk o moe, van ah kaom nangcae ampa to pakoeh o thai hanah, na aanghaih loe kaminawk mikhnuk ah aang nasoe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai loe kaalok maw, to tih ai boeh loe tahmaanawk ih lok phraek hanah kang zoh, tiah poek o hmah: phraek hanah kang zo ai, akoepsak han ih ni kang zoh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Loktang kang thuih o, Long hoi van to anghmat moe, hmuen boih akoep ai karoek to kaalok thung ih kangdaek daek lok maeto maw, to tih ai boeh loe ahmin maeto maw mataeng doeh anghmaa mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi kawbaktih doeh hae kaalok thung ih kathoeng koek kaalok maeto aek moe, to tiah aek toeng hanah kaminawk han patuk kami loe, van prae ah kathoeng koek kami, tiah kawk o tih: toe mi kawbaktih doeh pazui moe, kaminawk doeh pazui hanah patuk kami loe, van prae ah kalen koek kami, tiah kawk o tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kang thuih o, Na toeng o haih mah Farasinawk hoi ca tarikkungnawk ih toenghaih to poeng ai nahaeloe, van prae ah na kun o thai mak ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kami hum hmah; mi kawbaktih mah doeh kami to hum nahaeloe, zit kaom lokcaekhaih to hnu tih, tiah canghnii ah thuih ih lok to na thaih o boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe kang thuih o, Mi kawbaktih doeh ahlong om ai ah angmah ih nawkamya palungphui thuih kami loe, zit kaom lokcaekhaih to hnu tih: mi kawbaktih doeh angmah ih nawkamya hanah, Raka, tiah thui kami loe, zit kaom lokcaekhaih to tong tih: mi kawbaktih doeh, Kamthu, tiah thui kami loe zit kaom hell hmai to tong tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah hmaicam ah tangqum paek han na sin naah, nam nawkamya mah sinsak han koeh ai, tiah na panoek nahaeloe;
  </para>
  <para style="p">
    <verse number="24" style="v" />tangqum to hmaicam ah caehtaak ah, amlaem let ah loe nam nawkamya to pathloep hmaloe ah, to pacoengah angzoh loe, tangqum to paek ah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na misa hoi nawnto lam na caeh hoi naah, karangah anih hoi angdaehhaih to sah ah; to tih ai nahaeloe na misa mah lokcaekhaih ahmuen ah na caeh haih tih, lokcaekkung mah angraeng khaeah na hoi ueloe, anih mah thongim thungah na pakhrah tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Loktang kang thuih o, Laiba na pathok boih ai karoek to, thongim thung hoi na tacawt thai mak ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zu sava laep ah nongpa nongpata zaehaih to sah hmah, tiah canghnii ah thuih ih lok to na thaih o boeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toe kang thuih o, mi kawbaktih doeh nongpata to taksa koehhaih mik hoiah khen nahaeloe, to nongpata to palung thung hoiah a zae haih boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na bantang mik mah na zaesak nahaeloe, taprok dok ah loe va ving ah: na takpum boih hell thungah krak pongah loe, na takpum tanghang maeto anghmat to atho oh kue.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na bantang ban mah na zaesak nahaeloe, takroek pat ah loe, va ving ah: na takpum boih hell thungah krak pongah loe, na takpum thung ih hmuen maeto amrosak to nang hanah atho oh kue.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi kawbaktih mah doeh zu to pakrah nahaeloe, zu pakhrakhaih ca to paek nasoe, tiah thuih ih lok to oh boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe kang thuih o, Mi kawbaktih mah doeh sava laep ah zae sakhaih om ai ah, a zu to pakhrah nahaeloe, daan ai ah nongpata zaehaih sahsak kami ah ni oh: mi kawbaktih doeh pakhrak ih nongpata to zu ah la kami loe daan ai ah zaehaih sah kami ah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pacoengah, Nangmah hoi nangmah kamsoem ai ah lokkamhaih to sah hmah, Angraeng khaeah na sak ih lokkamhaih to akoepsak ah, tiah canghnii ah thuih ih lok to na thaih o boeh:
  </para>
  <para style="p">
    <verse number="34" style="v" />toe kang thuih o, Lokkamhaih roe sah o hmah; van hoiah lokkamhaih to sah o hmah; van loe Sithaw anghnuthaih ahmuen ah oh:
  </para>
  <para style="p">
    <verse number="35" style="v" />long hoiah lokkamhaih to sah o hmah; long loe a khok koenghaih ahmuen ah ni oh: Jerusalem hoiah lokkamhaih to sah o hmah; Jerusalem loe kalen Siangpahrang ih vangpui ah ni oh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Na lu hoiah lokkamhaih to sah o hmah, nangcae mah lu nui ih sam maeto mataeng doeh nang lung o sak moe, nam num o sak thai ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kamsoem loe amsoem, tiah thui oh loe, kamsoem ai loe amsoem ai, tiah thui oh. Kawbaktih hmuen doeh hae pongah kamtlai lok loe kasae khae hoiah ni angzoh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mik hanah mik, haa hanah haa, tiah thuih ih lok to na thaih o boeh:
  </para>
  <para style="p">
    <verse number="39" style="v" />toe kang thuih o, Kahoih ai sah kami to pakaa o hmah: mi kawbaktih mah doeh bantang tangbaeng to tabaeng nahaeloe, banqoi tangbaeng doeh patueng paeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kami mah nang to tayacoi hanah khiing moe, laihaw kalen to na la pae ving nahaeloe, nangmah ih kahni doeh paek ah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mi kawbaktih mah doeh meng maeto caeh hanah na thui nahaeloe, anih hoi nawnto meng hnetto caeh ah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nang khaeah hnih kami hanah paek ah, hmuen coi han ih nang khaeah angzo kami to pakak hmah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Na imtaeng kami to palung ah loe, na misa to hnuma ah, tiah thuih ih lok to na thaih o boeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Toe kang thuih o, Na misa to palung oh, nang tangoeng kami to tahamhoihaih paek oh, nang hnuma kaminawk khaeah kahoih hmuen to sah oh, nangcae pacaekthlaek moe, kasae thui kaminawk hanah lawkthui pae oh.
  </para>
  <para style="p">
    <verse number="45" style="v" />To tiah ni van prae ah kaom nangcae ampa ih caa ah na om o tih: Anih loe kahoih hoi kahoih ai kami nuiah ni tacawtsak moe, katoeng hoi katoeng ai kami nuiah doeh kho to angzohsak.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nangcae palung kaminawk khue na palung o nahaeloe, tih tangqum maw na hnu o tih? Tamut cong kaminawk mah mataeng doeh to tiah sak o toeng bae.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nam nawkamyanawk khue to na talawk o nahaeloe, minawk pongah hoih kuehaih timaw na tawnh o? Tamut cong kaminawk mah mataeng doeh to tiah sak o toeng na ai maw?
  </para>
  <para style="p">
    <verse number="48" style="v" />Van prae ah kaom nangcae Ampa loe akoep baktih toengah, Nangcae doeh akoep o toeng ah.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaminawk mah hnuk hanah, kaminawk hmaa ah tahmenhaih hoi paek ih hmuen to sak han ai ah acoe oh: to tiah na sak o nahaeloe, van ah kaom nangcae ampa khae hoi tangqum na hnu o mak ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pongah tahmenhaih hoiah hmuen to na paek o naah, minawk mah pakoeh hanah, angsah thaih kaminawk mah, Sineko hoi lamkrung ah sak o ih baktih toengah, nangmah hma ah mongkah baktiah ueng hmah. Loktang kang thuih o, Nihcae loe angmacae ih tangqum to hnuk o boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe nangcae mah hmuen na paek o naah, na bantang ban mah sak ih hmuen to banqoi ban mah panoek hmah nasoe:
  </para>
  <para style="p">
    <verse number="4" style="v" />to tiah ni na paek o ih hmuen to tamquta ah om ueloe, tamquta hoi khenkung nangcae ampa mah kamtuengah tangqum to na paek o tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lawk na thuih o naah, angsah thaih kaminawk baktiah om o hmah: nihcae loe minawk mah hnuk hanah, Sineko hoi lamkrung ah angdoet o moe, lawkthuih han a koeh o. Loktang kang thuih o, Nihcae loe angmacae ih tangqum to hnuk o boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe nangcae mah lawk na thuih o naah, imthung ah akun oh, thok to kha oh loe, tamquta hoi kaom nangcae ampa khaeah lawkthui oh; to tiah ni tamquta hoi khenkung nangcae ampa mah kamtuengah tangqum to na paek o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangcae mah lawkthuih naah, Sithaw panoek ai kaminawk baktiah, thui kok ih lok to thui o let hmah: nihcae loe kapop ah lawkthuih naah ni nihcae mah thuih ih lok to thaih pae tih, tiah a poek o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangcae loe nihcae baktiah om o hmah: nangcae mah na hnih o ai naah, nang toeng o ih hmuen to nam Pa mah panoek boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah nangcae mah hae tiah lawkthui oh, tiah a naa: Van ah kaom kaicae Ampa, na hmin saiqathaih om nasoe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na prae to angzo lai nasoe, van ih baktiah, na koehhaih, long nuiah sah lai nasoe.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ni thokkruek caaknaek khawt na paek ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaicae khae laiba tawn kaminawk ka tahmen o baktih toengah, kaicae ih laiba to tahmen ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pacuekhaih thungah na caeh haih hmah loe, kasae thung hoi na loisak ah: na prae loe, thacakhaih, lensawkhaih hoi dungzan ah om poe nasoe, Amen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Minawk zaehaih na tahmen o nahaeloe, van ah kaom nam pa mah doeh nangcae zaehaih to tahmen toeng tih:
  </para>
  <para style="p">
    <verse number="15" style="v" />toe minawk zaehaih na tahmen o ai nahaeloe, nam pa mah doeh nangcae zaehaih to tahmen mak ai. Sithaw hmaa ah buhzaa ah
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangcae mah buh na zah o naah, angsah thaih kaminawk baktiah, palungsethaih mikhmai to amtueng o sak hmah: nihcae loe minawk mah buhzah tiah panoek hanah, minawk hma ah mikhmai sae to amtueng o sak. Loktang kang thuih o, nihcae loe angmacae ih tangqum to hnuk o boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe nangcae mah buh na zah o naah, ungsi to angnok oh loe, mikhmai to pathlak oh;
  </para>
  <para style="p">
    <verse number="18" style="v" />nangcae loe kaminawk hma ah buh na zaa o ai, tamquta ah kaom nangcae ampa hmaa ah ni buh na zah o: to tiah ni tamquta hoi khenkung, nangcae ampa mah kamtuengah tangqum to na paek o tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Karaa hoi aek mah caak thaih moe, kamqunawk mah doeh pakhoih moe, paquk thaih ih, hae long nuiah hmuen to patung o hmah:
  </para>
  <para style="p">
    <verse number="20" style="v" />karaa hoi aek mah caa thai ai, kamqunawk mah doeh pakhoih moe, paquk thai ai ih, van prae ah hmuen to patung oh:
  </para>
  <para style="p">
    <verse number="21" style="v" />hmuenmae ohhaih ahmuen ah ni, na palung doeh om toeng tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Takpum ih hmaithaw loe mik hae ni: to pongah na mik to hoih nahaeloe, na takpum boih aang tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe na mik to hoih ai nahaeloe, na takpum to ving boih tih. To pongah nangcae thung ih aanghaih to ving nahaeloe, to vinghaih loe kawkruk maw len!
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi mah doeh angraeng hnetto ih tok to sah hmaek thai ai: maeto hnuma ueloe, kalah maeto to palung tih; to tih ai boeh loe maeto patawn ueloe, kalah maeto loe prawt tih. Sithaw ih tok hoiah phoisa ih tok na sah hmaek thai mak ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pongah kang thuih o, Timaw ka caak moe, timaw ka naek han tiah, hing hanah mawn o hmah; timaw kang khuk han tiah, na takpum han mawn o hmah. Hinghaih loe caaknaek pongah lokpui kue moe, takpum doeh khukbuen pongah lokpui kue na ai maw?
  </para>
  <para style="p">
    <verse number="26" style="v" />Van ih tavaanawk ho khen oh: nihcae loe cang tuh o ai, cang doeh aat o ai, tapup thungah doeh patung o ai; toe van ah kaom nangcae ampa mah nihcae to pacah: nangcae loe nihcae pongah na hoih o kue na ai maw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Mawnhaih rang hoiah nangcae thung ih mi mah maw a sanghaih to dongto thap thaih?
  </para>
  <para style="p">
    <verse number="28" style="v" />Tipongah angkhuk hanah na mawnh o loe? Lawk ih lili pawknawk loe toksah o ai, pathlah doeh kae o ai; toe kawbangah maw qoeng o tahang, tito khen oh:
  </para>
  <para style="p">
    <verse number="29" style="v" />toe kang thuih o, Solomon mah mataeng doeh, hae ih apawknawk baktiah a lensawkhaih boih hoiah amthoep ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />To baktih toengah, vaihniah hing moe, khawnbangah hmai thungah vah han koi lawk ih phroh mataeng doeh, Sithaw mah khenzawn nahaeloe, Aw tanghaih tamsi kaminawk, anih mah loe nangcae to kamtlai ah na khenzawn o mak ai maw?
  </para>
  <para style="p">
    <verse number="31" style="v" />To pongah timaw ka caak o moe, timaw ka naek o han? To tih ai boeh loe, timaw kang khuk o han, tito mawn o hmah.
  </para>
  <para style="p">
    <verse number="32" style="v" />(Gentel kaminawk mah ni hae baktih hmuennawk hae pakrong o;) hae baktih hmuennawk nang toeng o, tito van ah kaom nangcae ampa mah panoek.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sithaw prae hoi a toenghaih to pakrong o hmaloe ah; to pacoengah hae hmuennawk boih hae na paek o tih.
  </para>
  <para style="p">
    <verse number="34" style="v" />To pongah khawnbang hanah mawn o hmah: khawnbang mah angmah ih hmuennawk hanah kho poek tih. Vaihni raihaih loe vaihni hanah khawt boeh.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangmah to lokcaek han ai ah, minawk to lokcaek hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Minawk lok na caek baktih toengah, lokcaekhaih na tong tih: minawk na tahhaih hmuen hoiah na tah let tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tipongah na mik thung ih anuen to poek ai ah, nawkamya mik ah kaom tetta anuen to na khet loe?
  </para>
  <para style="p">
    <verse number="4" style="v" />Tikhoe na mik thung ih anuen to khen ai ah, nawkamya hanah, Na mik thung ih anuen to kang lak pae han, tiah na naa loe?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang, aling thaih kami! Na mik pong ih anuen to la hmaloe ah; to tiah ni na mik to amtueng ueloe, nawkamya mik thung ih anuen to na la pae thai tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ciimcai hmuen to uinawk han paek hmah, pale thlung doeh oknawk hma ah suem o hmah, na suek o nahaeloe, khok hoiah ni cawh o tih, nangmah khaeah angqoi ueloe, na kaek tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hnih ah, na paek tih; pakrong ah, na hnu tih; takhuek ah, na paong pae tih:
  </para>
  <para style="p">
    <verse number="8" style="v" />hni kami loe hak; pakrong kami loe hnuk; takhuek kami hanah paong pae tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na caa mah takaw hni nahaeloe, thlung paek kami nangcae thungah om tih maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tanga hni nahaeloe, pahui na paek o tih maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangcae, kasae kaminawk mah mataeng doeh na caanawk hanah kahoih hmuen paek han na panoek o nahaeloe, van ah kaom nangcae ampa mah cae loe nazetto maw hni kami hanah paek tih?
  </para>
  <para style="p">
    <verse number="12" style="v" />Minawk mah na nuiah hmuen kahoih saksak han na koeh o ih baktih toengah, nihcae nuiah kahoih hmuen to sah toeng ah: hae loe kaalok hoi tahmaanawk ih lok ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khongkha tamcaek thungah akun oh: kakawk khongkha hoi kalen loklam loe, anghmathaih bang zaehoikung ah oh: paroeai kaminawk loe to bangah caeh o:
  </para>
  <para style="p">
    <verse number="14" style="v" />tamcaek khongkha hoi tamcaek loklam loe hinghaih bang zaehoikung ah oh, kami tamsi loe to ahmuen bangah caeh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kamro tahmaanawk khae hoiah acoe oh, nihcae loe tuu hin to a nuiah angkhuk o moe, a thungah loe alinghaih hoiah kakoi tasui ah oh o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angmacae ih athaih hoiah nihcae to na panoek o tih. Mi mah maw soekhringkung hoiah misurthaih pakhrik moe, soekhring takha thung hoiah misurthaih pakhrik vaih?
  </para>
  <para style="p">
    <verse number="17" style="v" />Kahoih thingkung mah kahoih thingthai to tacawtsak; toe kasae thingkung mah loe kasae thingthai to tacawtsak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahoih thingkung hoiah kasae thingthai tacawt thai ai, kasae thingkung mah kahoih thingthai athaisak thai mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kahoih thingthai athai ai thingkung loe pakhruk boih moe, hmai thungah vah o.
  </para>
  <para style="p">
    <verse number="20" style="v" />To tiah angmacae ih athaih hoiah nihcae to na panoek o tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai khaeah, Angraeng, Angraeng, tiah thui kami boih, van prae thungah akun o mak ai; van ah kaom kam Pa koehhaih sah kami ni akun tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />To na niah loe paroeai kaminawk mah kai khaeah, Angraeng, Angraeng, na hmin hoiah lok ka thuih o moe, na hmin hoiah taqawknawk to ka haek o, na hmin hoiah paroeai dawnrai hmuennawk ka sak o boeh na ai maw? tiah thui o tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To naah kai mah nihcae khaeah, Kang panoek o ai: zaehaih sah kaminawk, kai khae hoi tacawt oh, tiah ka naa han.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah mi kawbaktih doeh ka thuih ih hae loknawk hae thaih moe, sah kami loe, lungsong nuiah im sah palungha kami hoiah anghmong:
  </para>
  <para style="p">
    <verse number="25" style="v" />kho angzoh moe, tui to len, takhi song moe, im to hmuh; lungsong nuiah sak ih im ah oh pongah, amtim ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi kawbaktih doeh ka thuih ih hae loknawk hae thaih boeh, toe sah ai kami loe savuet nuiah im sah kamthu hoiah ni anghmong:
  </para>
  <para style="p">
    <verse number="27" style="v" />kho angzoh moe, tui to len, takhi song moe, im to hmuh naah, im loe amtim rup: amtimhaih loe paroeai len, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu mah hae loknawk thuih pacoengah, kaminawk loe anih mah patuk ih hmuen pongah dawnrai o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih loe ca tarik kaminawk mah patuk ih baktiah patuk ai, sakthaihaih tawn kami mah patuk ih baktiah ni patuk.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anih mae nui hoi anghum tathuk naah, paroeai kaminawk anih hnuk ah bang o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenah, ngansae man kami maeto anih khaeah angzoh moe, anih to a bok, Angraeng na koeh nahaeloe, kai hae nang ciimsak thaih, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu mah ban payangh moe, anih to sui, Ka koeh; ciim lai ah, tiah a naa. Akra ai anih ih ngansae nathaih to hoih pae roep.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu mah anih khaeah, Mi khaeah doeh thui hmah; nihcae mah panoek o hanah, caeh ah loe qaima khaeah na takpum to patuek ah, Mosi ih kaalok baktih toengah tangqum to paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu Kapernuam vangpui ah akun naah, misatuh angraeng maeto anih khaeah angzoh moe, tahmenhaih hnik,
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng, ka tamna loe khok ban angtawt thai ai nathaih hoiah im ah angsong sut, ngannat nung parai, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu mah anih khaeah, Kang zoh moe, ngan ka tuisak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />To naah misatuh angraeng mah anih khaeah, Angraeng, kai ih im ah nang angzoh hanah kam cuk ai: lok khue mah thui ah, ka tamna loe ngantui tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai loe ukhaih tlim ah ka oh, ka tlim ah misatuh kaminawk oh o: kami maeto khaeah, Caeh ah, tiah ka thuih naah a caeh; kalah maeto khaeah, Angzo ah, tiah ka thuih naah anih to angzoh; ka tamna khaeah, Hae hae sah ah, tiah ka thuih naah a sak, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To lok to Jesu mah thaih naah, dawnrai moe, a hnukbang kaminawk khaeah, Loktang kang thuih o, Israel kaminawk salakah to baktih kalen parai tanghaih to ka hnu vai ai vop.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kang thuih o, paroeai kaminawk ni angyae, niduem bang hoiah angzo o ueloe, Abraham, Isak, Jakob hoi nawnto van prae ah anghnu o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe prae ih caanawk loe khoving tasa bangah va o tih: to ah qahhaih hoi haa kaekhaih to om tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pacoengah Jesu mah misatuh angraeng khaeah, Caeh lai ah; na tanghaih baktih toengah, nang khaeah sak ah oh boeh, tiah a naa. To na thuem ih atue ah anih ih tamna to ngantui roep.
  </para>
  <para style="p">
    <verse number="14" style="v" />Piter im ah Jesu angzoh naah, Piter zu ih amno loe ngannat moe, angsong sut.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih mah nongpata ih ban to sui pae naah, nongpata to ngantui: to pacoengah nongpata to angthawk moe, nihcae to a khetzawn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Duembang phak naah loe, taqawk tawn paroeai kaminawk anih khaeah angzoh o haih: anih mah taqawknawk to lok hoiah haek moe, nganna kaminawk to ngan a tuisak boih:
  </para>
  <para style="p">
    <verse number="17" style="v" />tahmaa Isaiah mah, Aicae thazokhaihnawk to anih mah lak moe, aicae nathaihnawk to a phawh, tiah thuih ih lok akoep han ih ni to tiah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu mah a taengah kaom paroeai kaminawk to hnuk naah, tuipui yaeh ah caeh hanah lok a paek.
  </para>
  <para style="p">
    <verse number="19" style="v" />To naah ca tarik kami maeto anih khaeah angzoh, Patukkung, na caehhaih ahmuen kruekah kang bang han, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu mah anih khaeah, Tasuinawk loe akhaw tawnh o, van ih tavaanawk doeh tabu tawnh o; toe kami Capa loe lu koenghaih ahmuen mataeng doeh tawn ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />A hnukbang kalah kami maeto mah anih khaeah, Angraeng, ka caeh moe, kam pa aphum hmaloe han vop, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe Jesu mah anih khaeah, Ka hnukah bang ah; kadueh kaminawk mah kadueh angmacae ih kaminawk to aphum o nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih palong thungah akun naah, a hnukbang kaminawk doeh anih hnukah caeh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khenah, tuipui ah takhi sae song moe, tuiphu mah palong to boh: toe anih loe iih.
  </para>
  <para style="p">
    <verse number="25" style="v" />A hnukbang kaminawk anih khaeah caeh o moe, anih to palawt o, Angraeng, kaicae hae na pahlong ah: kam ro o han boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih mah nihcae khaeah, Tanghaih tamsi kaminawk, tipongah na zit o loe? tiah a naa. To pacoengah anih loe angthawk moe, takhi hoi tuipui to zoeh; to naah takhi to dip.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae loe dawnrai o, hae kami loe kawbaktih kami maw vai? Takhi hoi tuipui mah mataeng doeh a lok tahngai pae o bae hae! tiah a thuih o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuipui yaeh ah kaom Kerkesen prae to a phak naah, taqawk tawn kami hnetto taprong hoiah anih khaeah angzoh hoi; nihnik loe hmawsaeng hoi parai pongah to loklam ah mi doeh caeh thai ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khenah, nihnik loe hang hoi moe, Nang Sithaw Capa, nang loe kaihnik hoi asaenghaih timaw oh? Atue pha ai naah kaihnik pacaekthlaek han ih maw nang zoh, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nihnik ohhaih ahmuen hoi kangthla kue ahmuen ah pop parai ok pacahhaih ahmuen to oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Taqawknawk mah Anih khaeah, Kaicae hae nang haek nahaeloe, oknawk takoh thungah na caehsak ah, tiah tahmenhaih a hnik o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu mah nihcae khaeah, Caeh oh, tiah a naa. Taqawknawk loe tacawt o moe, ok takoh thungah akun o: khenah, oknawk loe tuipui ohhaih bangah tha hoi cawnh o tathuk moe, tui thungah duek o boih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ok pacah kaminawk loe vangpui thungah cawnh o moe, taqawk tawn kami hnik khaeah kaom hmuennawk boih to thuih o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khenah, vangpui thung ih kaminawk boih Jesu hnuk hanah caeh o: anih to hnuk o naah, nihcae prae thung hoi tacawt ving hanah Anih khaeah tahmenhaih a hnik o.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anih loe palong thungah akun, tuipui to angkat moe, angmah vangpui bangah caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenah, iihhaih nuiah kangsong, khok ban dueh nathaih tawn kami anih khaeah angzawn o: Jesu mah nihcae tanghaih to hnuk naah, nganna kami khaeah, Ka capa, kamongah om ah; na zaehaihnawk loe tahmen boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khenah, ca tarik kami thoemto kaminawk mah palung thung hoiah, Hae kami loe Sithaw hmin kasae bae a thuih hae, tiah poek o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae poekhaih to Jesu mah panoek pae naah, Tipongah palung thungah kasae na poek o loe?
  </para>
  <para style="p">
    <verse number="5" style="v" />Na zaehaihnawk loe tahmen boeh, tiah thuih ih lok maw kazoi kue, to tih ai boeh loe Angthawk loe caeh lai ah, tiah thuih ih lok?
  </para>
  <para style="p">
    <verse number="6" style="v" />Kami Capa loe long nuiah zae tahmen thaihaih tawnh, tiah na panoek o thai hanah, (anih mah ngan kadueh nathaih tawn kami) khaeah, Angthawk ah, kahni to lah loe, na im ah caeh lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah anih loe angthawk moe, angmah im ah caeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Paroeai pop kami mah to hmuen to hnuk naah, dawnrai o moe, kaminawk khaeah to tiah thacakhaih paekkung, Sithaw to saphaw o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu loe to ahmuen hoiah caeh poe moe, tamut conghaih ahmuen ah kanghnu Mathai, tiah ahmin kaom, kami maeto a hnuk: anih khaeah, Ka hnuk ah bangah, tiah a naa. Anih loe angthawk moe, anih hnukah bang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu buhcaak han anghnut naah, khenah, tamut cong kaminawk hoi pop parai kazae kaminawk anih khaeah angzoh o moe, a hnukbang kaminawk hoi nawnto anghnut o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Farasi kaminawk mah hnuk o naah, anih hnukbang kaminawk khaeah, Tikhoe nangcae patukkung loe tamut cong kaminawk, kazae kaminawk hoi nawnto buhcaak loe? tiah a naa o.
  </para>
  <para style="p">
    <verse number="12" style="v" />To lok to Jesu mah thaih naah, anih mah nihcae khaeah, Ngantui kami loe siboi angai ai, nganna kami mah ni angaih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe nangcae loe caeh oh loe, angbawnhaih na ai ah, palungnathaih ni ka koeh, tiah thuih ih lok hae amtuk oh: katoeng kami kawk hanah kang zo ai, kazae kaminawk dawnpakhuemsak han ih ni kang zoh, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Johan hnukbang kaminawk anih khaeah angzoh o moe, Kaicae hoi Farasinawk loe buh ka zah o, tikhoe nang hnukbang kaminawk loe buhzaa o ai loe? tiah a naa o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu mah nihcae khaeah, Zu la kami ih ampuinawk loe zu la kami hoi nawnto oh o naah, palungsae o tih maw? Toe zulakung nihcae khae hoi lak vinghaih ni to pha tih, to naah nihcae mah buh to zaa o tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi mah doeh khukbuen kangtha to kangquem nuiah abu vai ai, abu nahaeloe angan kangtha mah kangquem to azuk ueloe, prawn aep tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi mah doeh misurtui kangtha to pailang kangquem thungah lawn vai ai: lawn nahaeloe pailang to tapok ueloe, misurtui to long boih tih, pailang doeh amro tih: to pongah misurtui kangtha loe pailang kangtha thungah ni lawn o, to tiah ni kahoih ah suem hmaek thai tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah nihcae khaeah hae loknawk thuih li naah, khenah, ukkung maeto angzoh moe, anih to bok pacoengah, Ka canu loe vaicuek pangah duek boeh; toe angzoh loe a nuiah na ban to koeng ah, to tiah nahaeloe anih to hing tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu loe angthawk moe, anih hnukah caeh, a hnukbang kaminawk doeh caeh o toeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khenah, saning hatlai hnetto thung athii kalong, nongpata maeto anih hnukah angzoh moe, anih ih kahni tom to a sui duem.
  </para>
  <para style="p">
    <verse number="21" style="v" />To nongpata mah anih ih kahni tom mah ka sui nahaeloe, ngan ka tui tih, tiah poek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu loe angqoi moe, nongpata to hnuk naah, Ka canu, kamongta ah om ah; na tanghaih mah ngan ang tuisak boeh, tiah a naa. To atue nathuem roe ah nongpata to ngantui roep.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ukkung imthung ah akun naah Jesu mah tam-oi ueng kaminawk hoi paroeai kaminawk to hnuk,
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih mah nihcae khaeah, Ahmuen na paek oh: nongpata loe dueh ai, iih ni a iih, tiah a naa: to naah nihcae mah anih to pahnui o thuih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kaminawk tasa bangah tacawtsak pacoengah, anih loe a thungah akun, nongpata to ban ah patawnh naah, nongpata ta loe angthawk.
  </para>
  <para style="p">
    <verse number="26" style="v" />To tamthang to prae thung boih ah amthang.
  </para>
  <para style="p">
    <verse number="27" style="v" />To ahmuen hoiah Jesu tacawt naah, mikmaeng hnetto anih hnukah bang hoi moe, David capa, kaihnik nuiah tahmenhaih tawn raeh, tiah hangh hoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anih imthung ah caeh naah, mikmaeng hnik anih khaeah angzoh hoi: Jesu mah nihnik khaeah, Hae hmuen hae ka sak thaih, tiah na tang hoi maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />To pacoengah nihnik ih mik to a sui pae, Na tang hoi baktih toengah nanghnik khaeah om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />To naah nihnik ih mik amtueng pae roep; Jesu mah, mi khaeah doeh thui hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toe nihnik loe caeh hoi moe, anih ih tamthang to prae boih ah thuih hoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nawnetta caeh hoi pacoengah, khenah, taqawk tawn lokpae thai ai kami maeto Jesu khaeah angzoh o haih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jesu mah taqawk haek pacoengah loe, lokpae thai ai kami to lok apaeh: paroeai kaminawk loe dawnrai o moe, Israel prae thungah hae baktih hmuen ka hnu o vai ai vop, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Toe Farasinawk mah, Taqawknawk ih angraeng hoiah ni taqawknawk to a haek, tiah a naa o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesu loe vangpui hoi vangta bangah caeh moe, Sineko ah kaminawk to patuk, siangpahrang ukhaih prae tamthanglok kahoih to taphong, nganna kaminawk hoi congca nathaih tawn kaminawk to ngan a tuisak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pop parai kaminawk to a hnuk naah, nihcae loe thazok o moe, tuutoep kami om ai ah, ampraek phang tuu baktiah oh o pongah, nihcae nuiah palung hoih ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />To naah anih mah a hnukbang kaminawk khaeah, Cang aah han paroeai pop, toe toksah kaminawk loe tamsi o.
  </para>
  <para style="p">
    <verse number="38" style="v" />To pongah lawk tawnkung mah, a lawk thungah cang aat kaminawk kapop ah patoeh thai hanah lawkthui oh, tiah a naa.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anih loe kami hatlai hnettonawk to angmah khaeah kawk moe, kasae taqawknawk haek thaihaih, ngannathaih hoi congca nathaihnawk hoisakthaihaih to a paek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Patoeh ih kami hatlai hnettonawk ih ahmin loe; hmaloe koek ah, Piter, tiah kawk ih Simon hoi amnawk Andru; Zebedi capa Jakob hoi amnawk Johan;
  </para>
  <para style="p">
    <verse number="3" style="v" />Philip hoi Bartholomu; Thomas hoi tamut congkung Mathai; Alfai capa Jokob hoi Lebbai, tiah kalah ahmin kaom Thadai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kananite, tiah kawk ih Simon, Anih kaminawk ban ah paekkung, Juda Iskariot cae hae ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu mah hae kami hatlai hnettonawk patoeh moe, nihcae khaeah, Gentel kaminawk khaeah caeh o hmah, Samaritan kaminawk ih vangpui ah doeh akun o hmah:
  </para>
  <para style="p">
    <verse number="6" style="v" />toe tuu kanghmaa Israel imthung takohnawk khaeah caeh oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na caeh o naah, van prae loe zoi boeh, tiah taphong oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nganna kaminawk to ngantui o sak ah, ngansae man kaminawk to ciim o sak ah loe, kadueh kaminawk to pathawk oh, taqawknawk to haek oh: azom ah na hnuk o ih hmuen to azom ah paek oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Phoisa tabu thungah sui, sum kanglung hoi sum kamling phoisa to sin o hmah,
  </para>
  <para style="p">
    <verse number="10" style="v" />kholong na caeh o naah pasah, khukbuen hnetto, khokpanai hoi cunghet doeh sin o hmah: toksahkung loe a tok sakhaih atho to hnuk han krak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vangpui ah maw, to tih ai boeh loe vangta ah maw, na kun o naah, na toemh o han koi im to pakrong oh; to ahmuen hoi na hloi o ai karoek to to im ah om o poe ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Im maeto thungah na kun o naah, lok tapring oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />To im ah oh han amcuk nahaeloe, na monghaih a nuiah om nasoe: toe amcuk ai nahaeloe, na monghaih to nangmah khaeah amlaem let nasoe.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi kawbaktih doeh nang toemsak ai, na lok doeh tahngai ai nahaeloe, to im hoiah maw, to tih ai boeh loe to vangpui hoiah maw na tacawt o naah, na khok pong ih maiphu to takhoek oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Loktang kang thuih o, lokcaekhaih niah to vangpui loe Sodom hoi Gomorrah vangpui pongah nung kue tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khenah, tasuinawk salak ih tuu baktiah ni kang patoeh o: to pongah pahui baktiah palungha oh loe, pahuu baktiah acoe oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaminawk khae hoiah acoe oh: to tih ai nahaeloe lokcaekhaih im ah na caeh o haih ueloe, angmacae ih Sineko ah na bop o moeng tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai pongah nihcae hoi Gentel kaminawk khaeah hnukung ah na oh o hanah, prae ukkungnawk hoi siangpahrangnawk khaeah na caeh o haih tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe ang naeh o naah, nangcae mah kawbangmaw ka thuih o han, timaw ka thuih o han, tiah poek o hmah: to na atue thuem roe ah, na thuih o han ih lok to na paek tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lokthuikung loe nangcae na ai ni, nangcae Ampa ih Muithla mah ni nangcae thungah lok to thuih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nawkamya mah nawkamya, ampa mah a caa to paduek hanah paek tih: a caanawk mah amno hoi ampa to misa ah suem ueloe, nihcae to paduek hanah sah o tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai pongah kaminawk boih mah na hnukma o tih: toe boeng khoek to pauep kami loe pahlonghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahmuen maeto ah na pacaekthlaek o nahaeloe, kalah ahmuen bangah caeh o taak ah: loktang kang thuih o, Kami Capa angzo ai karoek to Israel ih vangpuinawk to nam kae o boih mak ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ca amtuk kami loe patukkung ranui ah om ai, tamna doeh angmah ih angraeng ranui ah om ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ca amtuk kami to patukkung baktiah oh moe, tamna doeh angraeng baktiah oh boeh loe khawt boeh. Im tawnkung to Beelzabub, tiah kawk o nahaeloe, anih imthung takoh ih kaminawk cae loe kawkruk maw kawk o tih?
  </para>
  <para style="p">
    <verse number="26" style="v" />To pongah nihcae to zii o hmah: amtueng thai han ai ah kraeng ih hmuen tidoeh om ai; panoek thai han ai ah, hawk ih hmuen tidoeh om mak ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khoving ah kang thuih o ih lok to, khodai ah thui oh: naa hoi na thaih o ih lok to imphu nuiah taphong oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Takpum paduek thaih, hinghaih pakhra paduek thai ai kaminawk to zii o hmah: toe hinghaih pakhra hoi takpum hell thungah paduek thaih hmaek kami to zii oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Paritca hnetto loe phoisa dip maeto hoiah zawh o na ai maw? Toe van ah kaom nangcae Ampa koehhaih baktih ai ah loe maeto doeh long ah krah mak ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangcae lu nui ih sam mataeng doeh kroek boih ah oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />To pongah zii o hmah, nangcae loe paritcanawk pongah atho na oh o kue.
  </para>
  <para style="p">
    <verse number="32" style="v" />To pongah mi kawbaktih doeh kaminawk hmaa ah kai angdoe haih kami loe, van ah kaom kam Pa hmaa ah anih to kang doet haih toeng han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe mi kawbaktih doeh kaminawk hmaa ah kai pahnawt kami loe, van ah kaom kam Pa hmaa ah anih to ka pahnawt toeng han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kai loe angdaehhaih sin han ih ni long ah kang zoh, tiah poek o hmah: angdaehhaih sin hanah kang zo ai, sumsen sin han ih ni kang zoh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai pongah kami mah ampa to misa ah suem tih, canu mah amno to misa ah suem ueloe, langah mah angmah ih amni to misa ah suem tih,
  </para>
  <para style="p">
    <verse number="36" style="v" />a imthung ih kami a misa ah ohsak han ih ni kang zoh, tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kai pongah amno maw, ampa maw, palung kue kami loe kai ih kami ah oh han amcuk ai; a canu maw, a capa maw, kai pongah palung kue kami loe kai ih kami ah oh han amcuk ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Angmah ih thinglam to aput moe, ka hnukah bang ai kami loe, kai ih kami ah oh han amcuk ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />A hinghaih pakrong kami loe, pathlong ving tih: kai pongah a hinghaih pathlong ving kami loe hinghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nangcae talawk kami loe kai talawk kami ah oh, kai talawk kami loe kai patoehkung talawk kami ah oh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tahmaa ih ahmin hoiah tahmaa talawk kami loe, tahmaa ih tangqum to hnu tih; katoeng kami ih ahmin hoiah katoeng kami talawk kami loe, katoeng kami ih tangqum to hnu tih.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mi kawbaktih doeh tetta hae kaminawk thung ih maeto khaeah, hnukbang kami maeto ih ahmin hoiah tui angqai boengloeng maeto paek kami loe, loktang kang thuih o, angmah ih tangqum to sung mak ai, tiah a naa.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu mah a hnukbang hatlai hnettonawk khaeah lokthuih pacoengah, kami to patuk moe, lokthuih hanah, to ahmuen hoiah tacawt moe, nihcae ih vangpuinawk bangah caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu toksakhaihnawk Johan mah thongim thung hoiah thaih naah, a hnukbang kami hnetto patoeh moe,
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih khaeah, Nang loe kang zing o ih angzo han koi kami to boeh maw, to tih ai boeh loe kalah kami to ka zing o han vop maw? tiah a duengsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu mah nihnik khaeah, Amlaem hoi let ah loe, na thaih moe, na hnuk hoi ih hmuen to Johan khaeah thui pae hoih, tiah a naa:
  </para>
  <para style="p">
    <verse number="5" style="v" />mikmaengnawk loe mik amtueng o boeh, khokkhaemnawk loe caeh o thai boeh, ngansae man kaminawk loe ngantui o boeh, naa pang kaminawk loe lok thaih o boeh, kadueh kaminawk loe angthawk o boeh moe, amtang kaminawk mah doeh taphong ih kahoih tamthanglok to thaih o boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai pongah palungboeng ai kami loe tahamhoih, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihnik caeh hoi pacoengah, Jesu mah rangpuinawk khaeah, Tih khet han ih maw praezaek ah na caeh o? Takhi mah hmuh naah anghuen phrokung khet han ih maw? tiah Johan kawng pongah lok a thuih pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />To tih ai boeh loe tih hnuk han ih maw na caeh o? Kahoih khukbuen kanaem hoi amthoep kami khet han ih maw? Khenah, kahoih khukbuen kanaem angkhuk kami loe, siangpahrang im ah ni oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe nangcae loe tih khet han ih maw na caeh o? Tahmaa khet han ih maw? Ue, tahmaa maeto pongah len kue, tiah kang thuih o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khenah, Nangcae hmaa ah tamthang sin kami to ka patoeh han, anih mah na hma ah loklam to paroep tih, tiah anih kawng tarik ih oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Loktang kang thuih o, Nongpata mah tapen ih kami thungah tuinuemkung Johan pong kalen kue kami om vai ai vop: toe van prae ah kathoeng koek loe Johan pongah len kue.
  </para>
  <para style="p">
    <verse number="12" style="v" />Van prae loe tuinuemkung Johan oh nathuem hoi kamtong vaihi khoek to paroeai raihaih tongh, thacak kaminawk mah tha patohhaih hoiah a lomh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tahmaanawk ih lok hoi kaalok boih loe Johan karoek to ni taphong o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tapom han na koeh o nahaeloe, anih loe angzo han koi Elijah boeh ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thaihaih naa tawn kami loe thaih nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hae dung ih kaminawk loe tih hoiah maw ka patah han? Hmuen zawhhaih ahmuen ah anghnu nawktanawk mah, angmacae ampuinawk khaeah,
  </para>
  <para style="p">
    <verse number="17" style="v" />nangcae han tamoi kang uengh o thuih, toe na hnaw o ai; qahhaih lok hoiah kang oi o haih cadoeh, palung na sae o ai, tiah thuih ih lok hoiah ni nang hmong o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Johan loe angzoh moe, nae ai, caa ai ah oh, to naah Anih loe taqawk tawnh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kami Capa angzoh moe, a caak a naek naah, nihcae mah, khenah, caak amoeh kami, misurtui amoeh kami, tamut cong kaminawk hoi kazae kaminawk ih ampui, tiah a naa o. Toe palunghahaih loe a caanawk mah amtuengsak.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pacoengah paroeai dawnrai hmuennawk to a sak, toe vangpuinawk loe dawnpakhuemhaih tawn o ai pongah a zoeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Korazin, khosak na bing! Bethsaida, khosak na bing! Nanghnik khaeah sak ih dawnrai hmuen to, Tura hoi Sidon vangpui ah ka sak nahaeloe, canghnii ah ni maiphu pongah anghnu o ueloe, buri angkhuk hoiah dawnpakhuem o tih boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe kang thuih o, lokcaekhaih niah nanghnik loe Tura hoi Sidon mah tong ih hmuen pongah nung kue tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pacoengah nang, Kapernuam, van khoek to amkoeh tahang, hell ah ni na krah tathuk tih: nang khaeah sak ih dawnrai hmuennawk to Sodom ah sak soe nahaeloe, vaihni ni khoek to om vop tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe kang thuih o, lokcaekhaih niah nang loe Sodom mah tong ih hmuen pongah nung kue tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu mah, Aw Pa, long hoi van Angraeng, hae hmuennawk hae palungha kaminawk, kathoem kaminawk khae hoi na hawk moe, nawktanawk khaeah nam tuengsak pongah, nang kang pakoeh, tiah thuih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ue, Pa, hae loe na mik hnukah kahoih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pa mah hmuennawk boih kai khaeah paek boeh: Pa ai ah loe mi mah doeh Capa to panoek ai; Capa hoi Capa mah amtueng thuih han ih kami mah khue ai ah loe, mi mah doeh Ampa to panoek ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangcae hmuenzit phaw kami hoi patangkhang kaminawk, kai khaeah angzo oh, anghakhaih kang paek o han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kai ih hnam hae phaw oh, kai khaeah amtuk oh; kai loe poeknaem moe, tuinom ka tawnh; to pongah palung monghaih na hnu o tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai ih hnam loe phawh han zoi, ka phawh ih hmuen doeh anghoep, tiah a naa.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu loe Sabbath niah lawk thungah caeh; a hnukbang kaminawk loe zok amthlam o pongah, cangqui pazut o moe, pakuep o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Farasinawk mah hnuk o naah anih khaeah, Khenah, na hnukbang kaminawk loe Sabbath niah sak han koi ai hmuennawk to a sak o, tiah naa o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe anih mah nihcae khaeah, David mah zok amthlam naah, angmah hoi nawnto kaom kaminawk hoi sak o ih hmuen to na kroek o ai maw?
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih Sithaw imthung ah akun naah, anih hoi angmah ih ampuinawk mah caak han koi ai, qaimanawk khue mah caak han ih takaw to a caak o to loe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Qaimanawk mah Sabbath niah tempul thungah Sabbath to amhnong o sak, toe coek han koi tawn ai ah a oh o, tiah kaom kaalok to na kroek o vai ai maw?
  </para>
  <para style="p">
    <verse number="6" style="v" />Kang thuih o, Tempul pong kalen kue hae ahmuen ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angbawnhaih na ai ah, palungnathaih to ni ka koeh, tiah thuih ih lok to na thaih o kop nahaeloe, zaehaih tawn ai kami to zaehaih na net o mak ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami Capa loe Sabbath Angraeng ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe to ahmuen hoiah tacawt moe, nihcae ih sineko thungah caeh:
  </para>
  <para style="p">
    <verse number="10" style="v" />khenah, to ah ban khaem kami maeto oh. Anih to zae net o thai hanah, nihcae mah anih khaeah, Sabbath niah ngantuisak han hoih maw? tiah lok a dueng o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah nihcae khaeah, Nangcae thung ih kami maeto mah tuu maeto tawnh, tuu to Sabbath niah tangqom thungah krah nahaeloe, anih mah tuu to la mak ai maw?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kami loe tuu pongah nazetto maw atho oh kue? To pongah Sabbath niah kahoih hmuen sak han hoih, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />To kami khaeah, Na ban to payangh ah, tiah a naa. Anih mah ban to payangh; to naah kalah ban maeto baktiah oh let.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe Farasinawk loe tasa bangah tacawt o moe, anih to kawbangmaw a hum o thai han, tiah lok angdueng o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu mah to hmuen to panoek naah, to ahmuen to tacawt taak: paroeai kaminawk anih hnukah bang o, anih mah nihcae to ngantuisak boih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih loe kawbaktih kami maw, tito minawk khaeah thuih han ai ah a thuih pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tahmaa Isaiah mah thuih ih lok akoep thai hanah anih mah,
  </para>
  <para style="p">
    <verse number="18" style="v" />khenah, ka qoih ih ka tamna; ka palung duek ih anih khaeah anghoehaih ka tawnh: anih nuiah ka Muithla to ka suek han, anih mah Gentel kaminawk khaeah toenghaih amtuengsak tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih loe angaek mak ai, hang mak ai; mi mah doeh loklam ah anih ih lok to thaih mak ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pazawk hanah toenghaih hoiah caeh ai karoek to, a cawh ih sakrungkung to angkhaek mak ai, tlangqui pong ih hmaikhue doeh paduek mak ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih ih ahmin pongah Gentel kaminawk mah tanghaih to tawn o tih, tiah a thuih.
  </para>
  <para style="p">
    <verse number="22" style="v" />To naah taqawk katawn, mikmaeng, lokaa, naa doeh kapang kami maeto anih khaeah angzoh o haih: anih mah to kami to ngantuisak, to naah mikmaeng khue ai, lok doeh aa kami to lok apaeh moe, a mik doeh amtueng pae roep.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kaminawk boih dawnrai o moe, Hae kami loe David ih capa na ai maw? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe Farasinawk mah to lok to thaih o naah, Hae kami loe taqawk angraeng Beelzabub ih ahmin hoiah ni taqawknawk to a haek, tiah a naa o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu mah nihcae poekhaih to panoek pae naah, nihcae khaeah, Kawbaktih prae doeh maeto hoi maeto angtuh moe, ampraek prae loe anghmat angtaa; kawbaktih vangpui doeh maeto hoi maeto angtuh moe, ampraek vangpui loe, angdoe thai ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Setan mah Setan to haek nahaeloe, angmah hoi angmah misa ah angcoeng moe, ampraek pongah, kawbangah maw a prae loe angdoe thai tih?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kai mah Beelzabub rang hoiah taqawknawk to ka haek nahaeloe, nang ih kaminawk mah loe mi ih ahmin hoiah maw taqawknawk to haek o?
  </para>
  <para style="p">
    <verse number="28" style="v" />Toe Sithaw ih Muithla hoiah taqawknawk to ka haek nahaeloe, Sithaw prae loe nangcae khaeah phak boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thacak parai kami to taoeng hmaloe ai ah, kawbangmaw thacak parai im tawnkung ih imthung ah akun ueloe, anih ih hmuennawk to paro pae thai tih? Taoeng pacoengah ni anih ih im to phrae pae thai tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai hoi nawnto om ai kami loe kai ih misa ah oh, kai hoi nawnto om ai kami loe anghaeh phang.
  </para>
  <para style="p">
    <verse number="31" style="v" />To pongah kang thuih o, Zaehaih hoi Sithaw kasae thui kaminawk loe zae tahmenhaih om tih, toe Kacai Muithla kasae thui kaminawk loe tahmenhaih om mak ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi kawbaktih doeh kami Capa kasae thui kami loe, zae tahmenhaih om tih: toe Kacai Muithla kasae thui kami loe, vaihi thuem hoi angzo han koi adung ah doeh, zae tahmenhaih to om mak ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kahoih thingkung pongah athaih kahoih to athaih, kahoih ai thingkung pongah kasae athaih to athaih: thingkung maeto loe athaih hoiah panoek thaih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nangcae pahui caanawk, kawbangmaw kami zae ah kaom nangcae mah kahoih hmuen to na thui o thai tih? Palung thungah amtlai hmuen to ni pakha mah thuih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kahoih kami loe kahoih poekhaih hoiah kahoih hmuennawk to tacawtsak: kasae kami loe kasae hmuen thung hoiah kasae hmuennawk to tacawtsak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toe kang thuih o, Kaminawk loe avang ai apaeh ih lok pongah, lokcaekhaih niah lokduenghaih to om tih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na thuih ih loknawk pongah toenghaih to na hnu ueloe, na thuih ih loknawk pongah lokcaekhaih to na hnu tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="38" style="v" />To pacoengah Farasinawk hoi ca tarikkung thoemto kaminawk mah anih khaeah, Patukkung, nang khae hoi angmathaih maeto hnuk han ka koeh o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Toe anih mah nihcae khaeah, Kahoih ai kami hoi daan ai ah zu sava nuiah zaehaih sah kaminawk loe angmathaih to pakrong o; tahmaa Jonah ih angmathaih khue ai ah loe, angmathaih kalah paek mak ai boeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jonah loe tanga pui ih zokthung ah ni thumto hoi qum thumto oh; to baktih toeng ah kami Capa doeh long thungah ni thumto hoi qum thumto om tih.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nineveh vangpui kaminawk loe Jonah mah thuih ih lok pongah dawnpakhuem o pongah, nihcae loe lokcaekhaih niah hae adung ih kaminawk hoi nawnto angdoe o ueloe, lok na caek o tih: khenah, Jonah pongah kalen kue haeah oh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Aloih bang ih siangpahrang nongpata mah lokcaekhaih niah vaihi dung ih kaminawk hoi nawnto angdoe ueloe, lok na caek o tih: anih loe Solomon palunghahaih lok to tahngaih hanah, long boenghaih ahmuen hoiah angzoh; khenah, Solomon pongah kalen kue haeah oh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Taqawk sae loe kami takoh thung hoiah tacawt pacoengah, anih loe praezaek ahmuen ah caeh moe, anghakhaih to pakrong, toe hnu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />To pongah anih mah, Ka tacawt taak ih im ah kam laem let han, tiah thuih; anih angzoh naah loe, kacai pin ah pahuih moe, raemh tangcae ah kaom kakong ahmuen to a hnuk.
  </para>
  <para style="p">
    <verse number="45" style="v" />To pacoengah anih loe caeh moe, angmah pongah kasae kue kalah taqawk sarihtonawk to akun haih, nihcae loe a thungah akun o moe oh o: to naah to kami loe tangsuek ih pongah doeh nung kue. To baktih toengah vaihi thuem ih kasae caanawk khaeah doeh om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kaminawk khaeah lok a thuih li naah, khenah, anih ih amno hoi angmah ih nawkamyanawk loe anih hoi lokpaeh hanah, tasa bangah angdoet o.
  </para>
  <para style="p">
    <verse number="47" style="v" />To naah kami maeto mah anih khaeah, Khenah, nam no hoi nam nawkamyanawk loe nang hoi lokpaeh hanah tasa bangah angdoet o, tiah a naa.
  </para>
  <para style="p">
    <verse number="48" style="v" />Toe anih mah lokthui kami khaeah, Kam no hoi kam nawkamya loe mi aa? tiah a naa.
  </para>
  <para style="p">
    <verse number="49" style="v" />Anih mah a hnukbang kaminawk to ban hoiah takhih moe, Khenah, hae kaminawk loe kai ih amno hoi nawkamyanawk ah oh o, tiah a naa.
  </para>
  <para style="p">
    <verse number="50" style="v" />Mi kawbaktih doeh van ah kaom kam Pa koehhaih sah kami loe, kai ih nawkamya, ka tanuh hoi kam no ah ni oh o, tiah a naa.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />To na niah Jesu loe im hoiah caeh moe, tuipui taengah anghnut.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah paroeai kaminawk anih khaeah amkhueng o pongah, anih loe palong thungah caeh moe, anghnut; kaminawk loe tui taengah angdoet o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah to kaminawk khaeah patahhaih hoiah pop parai lok to a thuih pae, Khenah, aanmu haeh kami maeto loe aanmu haeh hanah caeh;
  </para>
  <para style="p">
    <verse number="4" style="v" />aanmu a haeh naah, thoemto aanmunawk loe loklam ah krak, tavaanawk angzoh o moe, aanmu to akhuih o boih:
  </para>
  <para style="p">
    <verse number="5" style="v" />thoemto aanmunawk loe long tampa tlungcaret nuiah krak: long tampa pongah amprawk o phrat:
  </para>
  <para style="p">
    <verse number="6" style="v" />toe ni tacawt naah loe ni kabae mah aankungnawk to dawk; tangzun om ai pongah, azaem o roep.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thoemto aanmu loe soekhringnawk thungah krak; soekhringnawk loe qoeng o tahang moe, aankungnawk to tahlip hmoek:
  </para>
  <para style="p">
    <verse number="8" style="v" />thoemto aanmunawk loe long kahoih thungah krak moe, athaih athaih o, thoemto loe alet cumvai, quitaruk hoi quithumto ah athaih o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Naa tawn kami loe, thaih na soe, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hnukbang kaminawk anih khaeah angzoh o moe, Tipongah rangpui kaminawk khaeah patahhaih hoiah lok na thuih loe? tiah a dueng o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah nihcae khaeah, Siangpahrang mah uk ih van prae loktamqu to panoek thaihaih to nangcae khaeah paek boeh, toe nihcae khaeah loe paek ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi kawbaktih doeh katawn kami loe thap pae aep ueloe, pop parai ah tawn tih: toe mi kawbaktih doeh katawn ai kami loe a tawnh ih hmuen to doeh la pae kik tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah ni nihcae khaeah loe patahhaih lok hoiah ka thuih pae: nihcae loe khet o, toe hnu o ai; tahngaih o, toe thaih o ai; thaih kophaih tawn o ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tahmaa Isaiah mah, Na tahngai o tih, toe na thaih o kop mak ai; na khen o tih, toe na panoek o thai mak ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />hae kaminawk loe palung maeng o, naa hoiah thaih o thai ai, mik pasim o ving; to tih ai nahaeloe nihcae mah mik hoiah hnu o tih; naa hoiah thaih o ueloe, palung hoiah panoek o tih; hnukbang ah angqoi o ueloe, nihcae to ngan ka tuisak moeng tih, tiah thuih ih lok loe nihcae ah akoep boeh:
  </para>
  <para style="p">
    <verse number="16" style="v" />toe kahnu thaih mik hoi thaikophaih naa loe, tahamhoih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Loktang kang thuih o, paroeai tahmaanawk hoi katoeng kaminawk mah na hnuk o ih hmuennawk hae hnuk han a koeh o, toe hnu o thai ai; na thaih o ih hmuennawk doeh thaih han a koeh o, toe thaih o thai ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah aanmu haeh kami patahhaih lok to tahngai oh:
  </para>
  <para style="p">
    <verse number="19" style="v" />kami maeto loe Sithaw prae lok to thaih naah, thai kop ai, to pacoengah taqawk angzoh moe, anih palung thungah haeh ih lok to lak pae ving. Hae loe loklam ah kakrah aanmu hoiah anghmong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tlungcaret thungah kakrah aanmu loe lok to thaih naah, oephaih hoiah talawk roep kami hoiah anghmong;
  </para>
  <para style="p">
    <verse number="21" style="v" />toe anih loe tangzun om ai pongah, nawnetta thungah ni oh: Sithaw lok pongah raihaih hoi pacaekthlaekhaih oh naah, anih loe amtim roep.
  </para>
  <para style="p">
    <verse number="22" style="v" />Soekhring thungah kakrah aanmu loe lok to thaih, toe anih loe long hae palung pongah, alinghaih hoi angraenghaih mah lok to khuk khoep, to pongah athaih athai ai kami hoiah anghmong.
  </para>
  <para style="p">
    <verse number="23" style="v" />Long kahoih thungah kakrah aanmu loe, lok to thaih naah, panoek thaihaih to a tawnh; anih loe athaih to athaih moe, thoemto loe alet cumvaito, thoemto loe quitarukto, thoemto loe quithumto ah angpung, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih mah kalah patahhaih lok nihcae khaeah thuih pae let: Siangpahrang mah uk ih van prae loe angmah ih lawk thungah canti haeh kami maeto hoiah anghmong:
  </para>
  <para style="p">
    <verse number="25" style="v" />toe kaminawk iih o naah, a misa to angzoh, cangti thungah phroh mu to haeh moe, a caehtaak ving.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cang loe amprawk moe, aquih to tacawt, to naah phroh doeh amprawk tahang toeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pongah lawk tawnkung ih tamnanawk to anih khaeah angzoh o moe, Angraeng, kahoih cangti na ai maw lawk thungah na haeh? Naa hoiah maw prohnawk hae amprawk loe? tiah a naa o.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah anih mah nihcae khaeah, Misa mah ni hae tiah sak, tiah a naa. Tamnanawk mah anih khaeah, to tih nahaeloe ka caeh o moe, ka phong o han maw? tiah naa o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Toe anih mah, To tiah na ai ni; phroh to na phongh o nahaeloe, cang doeh na phongh o hmaek tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cang aat ai karoek to nawnto amprawk hoi rae nasoe: cang aahhaih atue phak naah cangaat kaminawk khaeah, hmai hoi qoeng hanah phrohnawk to akhui oh loe, taoeng o hmaloe ah: toe cang loe kai mah ih tapup thungah thaeng oh, tiah ka naa han, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih mah nihcae khaeah, Siangpahrang mah uk ih van prae loe kami maeto mah lak moe, angmah ih lawk ah haeh ih antam mu maeto hoiah anghmong, tiah kalah patahhaih lok a thuih pae let bae:
  </para>
  <para style="p">
    <verse number="32" style="v" />to antam mu loe aanmunawk boih thungah kathoeng koek ah oh: toe amprawt naah loe phronawk boih pong kalen koek ah oh, thingkung ah angcoeng pongah, van ih tavaanawk to angzoh o moe, tahangnawk pongah acuk o, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih mah nihcae khaeah, Siangpahrang mah uk ih van prae loe nongpata maeto mah taeh to lak moe, tui noekhaih boengloeng thumto kaom takaw thungah taeh to a phuih naah, taeh mah anguengsak ih takaw hoiah anghmong, tiah kalah patahhaih lok to a thuih pae let.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hae hmuennawk loe Jesu mah pop parai kaminawk khaeah thuih ih patahhaih lok ah oh; patahhaih lok patoh ai ah loe nihcae khaeah tidoeh thui pae ai:
  </para>
  <para style="p">
    <verse number="35" style="v" />to pongah tahmaa mah, Patahhaih hoiah lok ka thuih moe, long oh tangsuek na hoi tamquta ah suek ih hmuennawk to ka thuih han, tiah thuih ih lok akoep han ih ni to tiah oh.
  </para>
  <para style="p">
    <verse number="36" style="v" />To pacoengah Jesu mah kaminawk to tacawtsak moe, im thungah a caeh: to naah a hnukbang kaminawk anih khaeah angzoh o moe, Lawk thung ih phroh patahhaih lok to kamtuengah na thui ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih mah nihcae khaeah, Kahoih cangti haeh kami loe, kami Capa ni;
  </para>
  <para style="p">
    <verse number="38" style="v" />lawk loe long hae ni; kahoih cangti loe Siangpahrang ukhaih prae thungah kaom caanawk thuih koehhaih ih ni; toe phrohnawk loe kasae kaminawk ih caa thuih koehhaih ah oh;
  </para>
  <para style="p">
    <verse number="39" style="v" />phroh haeh kami ih misa loe taqawk ni; cang aahhaih loe long boenghaih ah oh, cangaat kaminawk loe van kaminawk ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Phrohnawk to lak o moe, hmai thungah vah o baktih toengah, hae long tue boeng naah om tih.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kami Capa mah angmah ih van kaminawk to patoeh tih, zaehaih sah kami hoi kahoih ai hmuen sah kaminawk boih to angmah ih prae thung hoiah nihcae mah nawnto pakhueng o ueloe,
  </para>
  <para style="p">
    <verse number="42" style="v" />paroeai kabae hmai kamngaeh thungah va o tih: to ah qahhaih hoi hakaekhaih to om tih.
  </para>
  <para style="p">
    <verse number="43" style="v" />To pacoengah katoeng kaminawk loe angmacae Ampa mah uk ih prae ah ni baktiah aang o tih. Thaihaih naa tawn kami loe, thaih nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="44" style="v" />Van prae loe lawk thungah hawk ih hmuen hoiah anghmong; to hmuen to kami maeto mah hnuk naah, a hawk hmoek, anghoehaih hoiah a caeh moe, a tawnh ih hmuennawk to zawh boih pacoengah, to lawk hmuen to a qanh.
  </para>
  <para style="p">
    <verse number="45" style="v" />To pacoengah, van prae loe kahoih pale thlung pakrong hmuenmae zaw kami hoiah anghmong:
  </para>
  <para style="p">
    <verse number="46" style="v" />anih mah atho kaom pale thlung to hnuk naah caeh moe, a tawnh ih hmuennawk to zawh boih pacoengah, to thlung to a qanh.
  </para>
  <para style="p">
    <verse number="47" style="v" />To pacoengah, van prae loe tanga congca kaman, tuipui thungah haeng ih palok hoiah anghmong:
  </para>
  <para style="p">
    <verse number="48" style="v" />palok to tanga hoi koi mong naah, nihcae mah tuicing bangah zaeh o, anghnut o moe, kahoih tanga to daengkraem thungah pacaeng o, kahoih ai tanga loe a vah o ving.
  </para>
  <para style="p">
    <verse number="49" style="v" />Long boeng naah loe to tiah om tih: van kaminawk to angzo o ueloe, katoeng kaminawk thung hoiah kazae kaminawk to pathlaeng o tih,
  </para>
  <para style="p">
    <verse number="50" style="v" />nihcae to paroeai kabae hmai kamngaeh thungah va o tih: to ah loe qahhaih hoi hakaekhaih to om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="51" style="v" />Jesu mah nihcae khaeah, Hae hmuennawk hae na thaih o kop boih maw? tiah a naa. Nihcae mah, Ue, Angraeng, tiah a naa o.
  </para>
  <para style="p">
    <verse number="52" style="v" />Anih mah nihcae khaeah, To pongah siangpahrang mah uk ih van prae kawng patuk ca tarik kaminawk boih loe, a tawnh ih hmuen kangtha hoi kangquem tasa bangah kasin, im tawn kami maeto hoiah anghmong, tiah a naa.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesu mah hae patahhaih lok thuih pacoengah, to ahmuen to a caehtaak.
  </para>
  <para style="p">
    <verse number="54" style="v" />Angmah ih vangpui ah a caeh moe, sineko ah kaminawk to patuk, to naah nihcae mah dawnrai o moe, Hae kami loe naa hoi ih maw hae baktih palunghahaih hoi dawnrai toksakthaihaihnawk hae a tawnh? tiah thuih o.
  </para>
  <para style="p">
    <verse number="55" style="v" />Anih loe thing aat kami ih capa na ai maw? Anih ih amno loe Meri na ai maw? Anih ih nawkamyanawk loe Jakob, Jose, Simon hoi Judah na ai maw?
  </para>
  <para style="p">
    <verse number="56" style="v" />Anih ih tanuhnawk doeh aicae hoi nawnto oh o na ai maw? Hae kami loe naa hoi ih maw hae baktih hmuennawk hae a tawnh? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="57" style="v" />Kaminawk loe anih nuiah palung hoih o ai. Toe Jesu mah nihcae khaeah, Tahmaa loe angmah im hoi angmah ih vangpui tasa bangah ni, pakoehhaih hoiah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="58" style="v" />Nihcae loe tanghaih tawn o ai pongah, to ahmuen ah dawnrai hmuen to sah pae mangh ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />To nathuem ah Herod siangpahrang mah Jesu tamthang to thaih,
  </para>
  <para style="p">
    <verse number="2" style="v" />anih mah a tamnanawk khaeah, Anih loe duekhaih thung hoiah kangthawk let, tuinuemhaih paekkung Johan boeh ni; to pongah ni dawnrai hmuen sakthaihaih anih nuiah oh, tiah thuih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Herod loe, Amnawk Philip ih zu Herodias pongah, Johan to naeh moe, taoengh pacoengah, thongim thungah pakhrak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan mah anih khaeah, Nam nawk ih zu na lomh pae haih loe kasoem hmuen na ai ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih to hum han koeh, toe kami boih mah Johan loe tahmaa ni, tiah poek o pongah, kaminawk to a zit.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe Herod tapenhaih ni phak naah loe, Herodias ih canu mah nihcae hma ah hnawh pae moe, Herod to poek nawmsak.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah to nongpata mah hnik sarui hmuen to paek hanah lokkamhaih to a sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />To naah nongpata ta mah, amno mah pacuek ih lok baktih toengah, Tuinuemhaih paekkung Johan ih lu to sabae pongah na paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah siangpahrang loe palungset: toe buh nawnto caa angvinnawk hma ah lokkamhaih a sak boeh pongah, nongpata ta mah hnik ih baktih toengah paek hanah a thuih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah kami to patoeh moe, thongim thungah Johan ih lu to takroeksak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih ih lu to sabae hoiah sin pae o moe, nongpata ta khaeah paek o: anih mah amno khaeah paek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Johan hnukbang kaminawk loe caeh o moe, qok to lak o, aphum o pacoengah, caeh o moe, Jesu khaeah thuih pae o.
  </para>
  <para style="p">
    <verse number="13" style="v" />To lok to Jesu mah thaih naah, to ahmuen hoiah kamding rue ahmuen ah palong hoiah a caeh ving: toe kaminawk mah thaih o naah, vangpuinawk thung hoiah khok hoiah a caeh o moe, anih hnukah bang o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu tuicing bangah phak naah loe pop parai kaminawk to a hnuk, nihcae to tahmen pongah nganna kaminawk to ngan a tuisak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Duembangah loe, a hnukbang kaminawk anih khaeah angzoh o moe, Hae ahmuen loe praezaek ah oh, ni doeh duem boeh; to pongah hae kaminawk hae caehsak lai ah, vangpuinawk thungah a caeh o moe, caaknaek a qan o han oh boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe Jesu mah nihcae khaeah, Nihcae caehsak han angai ai; nihcae han caaknaek to paek o khae, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae mah anih khaeah, Takaw kae pangato hoi tanga hnetto khue ni ka tawnh o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah, Hae ah na sin oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih mah kaminawk to phroh nuiah anghnut hanah lokpaek, takaw kae pangato hoi tanga hnetto a lak, van bangah a doeng tahang moe, anghoehaih lawkthuih pacoengah, a aeh, takaw to a hnukbang kaminawk khaeah a paek, a hnukbang kaminawk mah paroeai kaminawk khaeah paek o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae boih mah caak o naah, zok amhah o: caaknoi to nihcae mah phromh o naah, benthang hatlai hnetto koi.
  </para>
  <para style="p">
    <verse number="21" style="v" />To ih buh caa kaminawk loe nongpata hoi nawkta thui ai, nongpa khue ah sang pangato oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih mah pop parai kaminawk to caehsak naah, a hnukbang kaminawk to palong thungah akunsak moe, tuipui yaeh ah caeh o hmaloe ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Paroeai kaminawk caehsak pacoengah, lawkthuih hanah angmah bueng mae nuiah a caeh: duembang phak naah loe, angmah bueng to ahmuen ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe palong loe tuipui um li ah oh, takhi song pongah, tuiphu mah atoengh tahang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Qum tue palito phak naah, Jesu loe nihcae khaeah tui nuiah caeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuipui nuiah kacaeh Anih to hnukbang kaminawk mah hnuk o naah, zit o, pakhra mue tiah poek o pongah, zit hoiah a hang o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe Jesu mah nihcae khaeah, Kamongta ah om oh; Kai ni; zii o hmah, tiah a thuih pae phrat.
  </para>
  <para style="p">
    <verse number="28" style="v" />Piter mah anih khaeah, Angraeng, Nang nahaeloe, tui nuiah nang khaeah kai angzosak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih mah, Angzo khae, tiah a naa. To naah Piter loe palong thung hoi anghum tathuk moe, Jesu khaeah caeh hanah, tui nuiah a caeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe takhi sae to a hnuk naah, a zit; tui thungah krak naah, Angraeng, na pahlong ah, tiah a hang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu mah ban payangh moe, anih to patawnh, Nang, tanghaih tamsi kami, tikhoe palunghaenghaih na tawnh loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nihnik palong thungah angzoh hoi pacoengah loe takhi to dip.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pacoengah palong thungah kaom kaminawk to angzoh o moe, Nang loe Sithaw capa tangtang ni, tiah a thuih o pacoengah anih to bok o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nihcae loe tuipui to angkat o moe, Gennesaret prae to phak o.
  </para>
  <para style="p">
    <verse number="35" style="v" />To ahmuen ah kaom kaminawk mah anih panoek o naah, a taeng ih vangpuinawk boih ah tamthang to a thuih o, to naah nathaih tawn kaminawk boih anih khaeah caeh o haih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih ih kahni tom sui hanah anih khaeah tahmenhaih hnik o: sui kaminawk boih ngantui o.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />To naah Jerusalem vangpui hoiah Farasinawk hoi thoemto ca tarik kaminawk Jesu khaeah angzoh o moe,
  </para>
  <para style="p">
    <verse number="2" style="v" />tipongah nang hnukbang kaminawk mah kacoehtanawk ih lok to aek o loe? Nihcae loe buhcaak naah ban amsae o ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu mah nihcae khaeah, To tiah nahaeloe tipongah nangcae mah doeh nangmacae ih khosakhaih dan hoiah Sithaw ih kaalok to na aek o toeng loe?
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw mah paek ih lok mah loe, Nam no hoi nam pa saiqat ah: ampa maw, to tih ai boeh loe amno maw loksae bah kami loe, dueh nasoe, tiah thuih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toe nangcae mah loe, Mi kawbaktih doeh ampa maw, to tih ai boeh loe amno khaeah maw, Kai khae hoi na hak han koi abomhaih boih loe, Sithaw ih tangqum ah ni oh boeh, tiah thui nahaeloe,
  </para>
  <para style="p">
    <verse number="6" style="v" />anih mah ampa hoi amno saiqat han angai ai boeh, tiah na thuih o, to tiah nangmacae ih atawk pongah Sithaw ih lok to tidoeh avang ai ah na suek o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angsah thaih kaminawk, Isaiah mah,
  </para>
  <para style="p">
    <verse number="8" style="v" />hae kaminawk loe pakha hoiah kai khaeah anghnaih o moe, pahni hoiah kai ang pakoeh o; toe palung loe kai khae hoiah angthla o, tiah nangcae kawng thuih coek ih lok to oh boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae loe azom pui ah ni kai ang bok o, kaminawk mah thuih ih lok ni patuk o lat, tiah thuih ih lok loe amsoem tangak, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah paroeai kaminawk to kawk moe, Tahngai oh loe, thaih kop oh:
  </para>
  <para style="p">
    <verse number="11" style="v" />pakha thungah akun hmuen mah kami amhnongsak ai; pakha thung hoi tacawt hmuen mah ni, kami to amhnongsak, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah a hnukbang kaminawk angzoh o moe, anih khaeah, Farasinawk mah hae lok thaih o naah palung hoih o ai, tito na panoek maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe anih mah, Van ih ampa mah thling ai ih thingkung loe, aphong boih tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae to om o taak duem ah: nihcae loe mikmaeng zaehoikung mikmaeng ah ni oh o. Mikmaeng mah mikmaeng to zaehoi nahaeloe, tangqom thungah krah hoi hmaek tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Piter mah anih khaeah, Hae patahhaih lok hae kaicae khaeah kamtuengah na thui ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu mah, Nangcae doeh vaihi khoek to na panoek o thai ai vop maw?
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakha thungah akun hmuen loe zokthungah caeh boih moe, aek ah tacawt boih, tito na panoek o ai maw?
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe pakha thung hoi tacawt hmuen loe palung thung hoiah ni tacawt; to hmuennawk mah loe kami to amhnongsak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Poeksethaih, kami humhaih, zu sava laep ah zaehaih, daan ai ah zae sakhaih, paqukhaih, kahoih ai hnukung ah angdoethaih, Sithaw kasae thuihaihnawk loe palung thung hoiah ni tacawt.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hae hmuennawk mah ni kami to amhnongsak: toe ban amsae ai ah buhcaakhaih mah kami amhnongsak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu loe to ahmuen hoiah tacawt moe, Tura hoi Sidon vangpui bangah caeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khenah, Kanaan nongpata maeto loe angmah prae hoiah angzoh moe, anih khaeah, Angraeng, David capa, ka nuiah palungnathaih tawn raeh; ka canu loe taqawk mah naeh moe, patangkhang parai boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe anih mah lok pakha to doeh pathim pae ai. To pongah a hnukbang kaminawk loe anih khaeah caeh o moe, nongpata to kalah bangah caehsak ving ah; anih loe aicae hnukah hangh khing, tiah a naa o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih mah, Kai loe kalah kaminawk khaeah patoeh ai, tuu kanghmaa kanghmaa Israel imthung khae khue ah ni patoeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah nongpata to angzoh moe, a hmaa ah cangkrawn hoiah Angraeng, na bom ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih mah, Nawktanawk ih takaw to lak moe, uinawk khaeah vah pae han hoih ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To nongpata mah, Loktang ni, Angraeng: toe uinawk mah doeh angraeng ih caboi nui hoi kakrah caaknoi to caak o toeng bae, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu mah anih khaeah, Nongpata, na tanghaih loe thuk parai! Na koehhaih baktiah nang khaeah om nasoe, tiah a naa. To na atue thuem hoiah a canu to ngantui roep.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu loe to ahmuen hoiah caeh moe, Kalili tuipui taengah angzoh; mae nuiah a dawh tahang moe, to ah anghnut.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pop parai kaminawk anih khaeah angzoh o, khokkhaem, mikmaeng, lokaa, khok ban akoep ai kaminawk hoi kalah pop parai kaminawk to anih khokkung ah angzoh o haih, anih mah to kaminawk to ngantuisak boih:
  </para>
  <para style="p">
    <verse number="31" style="v" />lokaa doeh lok apaeh moe, khok ban akoep ai kaminawk doeh ngantui o, khokkhaem kaminawk lam a caeh o thaih, mikmaeng doeh mik amtueng: pop parai kaminawk mah to baktih hmuennawk to hnuk o naah dawnrai o moe, Israel Sithaw to saphaw o.
  </para>
  <para style="p">
    <verse number="32" style="v" />To pacoengah Jesu mah a hnukbang kaminawk angmah khaeah kawk moe, Hae kaminawk nuiah tahmenhaih ka tawnh, nihcae loe tidoeh caa ai ah, kai khaeah ni thumto thung oh o boeh; zok kamthlam ah caehsak han ka koeh ai, to tih ai nahaeloe loklam ah thazok o moeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />A hnukbang kaminawk mah anih khaeah, Kami hae zetto zok amhah hanah praezaek ah naa ih takaw maw ka hnu o tih? tiah a naa o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah nihcae khaeah, Takaw nazet to maw na tawnh o? tiah a naa. Nihcae mah takaw kae sarihto hoi tanga zetta oh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="35" style="v" />To naah anih mah to ah kaom pop parai kaminawk long ah anghnut o hanah lok a paek.
  </para>
  <para style="p">
    <verse number="36" style="v" />Takaw kae sarihto hoi tanga to a lak moe, anghoehaih lawk a thuih, a aeh pacoengah, a hnukbang kaminawk khaeah a paek, a hnukbang kaminawk mah pop parai kaminawk khaeah pazet o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nihcae loe caak o moe, zok amhah o boih: nihcae mah caaknoi to phromh o naah, benthang sarihto koi.
  </para>
  <para style="p">
    <verse number="38" style="v" />To ah buhcaa kaminawk boih loe nawkta hoi nongpata thui ai ah, nongpa ngai sang palito oh o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Pop parai kaminawk caehsak pacoengah, palong thungah akun moe, Magdala avang taengah a caeh.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Farasinawk hoi Sadusinawk anih khaeah angzoh o moe, nihcae khaeah van bang ih angmathaih amtuengsak hanah tanoek o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah nihcae khaeah, duembang phak naah loe, tamai to thim pongah, kho hoi tih, tiah na thuih o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Akhawnbang ah loe, tamai to thim moe, tamai thah pongah, vahni loe kho hoih mak ai, tiah na thuih o: Aw nangcae angsah thaih kaminawk, van ih khotue loe na panoek o thaih e, atue angmathaih loe na panoek o thai ai maw?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kami kasae hoi zu sava laep ah zaehaih sah caanawk mah loe angmathaih to pakrong o; tahmaa Jonah ih angmathaih khue ai ah loe, angmathaih paek ih tidoeh om mak ai boeh, tiah pathim pae. To pacoengah nihcae to kalah bangah caehtaak ving.
  </para>
  <para style="p">
    <verse number="5" style="v" />A hnukbang kaminawk kalah ahmuen bangah caeh o naah, takaw sin hanah pahnet o ving.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Jesu mah nihcae khaeah, Farasinawk hoi Sadusinawk ih taeh thung hoiah acoe oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah nihcae mah takaw a sin o ai pongah mue to tiah lok a thuih, tiah angmacae hoi angmacae lok angdueng o.
  </para>
  <para style="p">
    <verse number="8" style="v" />To tiah a thuih o ih lok to Jesu mah thaih naah, Tanghaih tamsi kaminawk, takaw na sin o ai pongah maw, nangmacae hoi nangmacae salakah to baktih lok to nang dueng o?
  </para>
  <para style="p">
    <verse number="9" style="v" />Kami sang pangato mah takaw kae pangato caak o naah, benthang nazetto maw na phromh o, tito na panoek o ai boeh maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Kami sang palito mah takaw kae sarihto caak o naah, benthang nazetto maw na phromh o?
  </para>
  <para style="p">
    <verse number="11" style="v" />Farasi hoi Sadusinawk ih taeh thung hoiah acoe oh, tiah ka thuih ih lok loe, takaw thuih koehhaih ih na ai ni, tipongah na panoek o thai ai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah loe a hnukbang kaminawk mah takaw thungah kaom taeh hoi acoe han thuih ih na ai ni, Farasi hoi Sadusinawk ih patukhaih thung hoiah acoe han ih ni a thuih, tito panoek o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu Philipi prae Siseria vangpui ah caeh naah, a hnukbang kaminawk to lok a dueng, Kami Capa, kai hae minawk mah kawbangah maw a thuih o? tiah lok a duengh.
  </para>
  <para style="p">
    <verse number="14" style="v" />To naah nihcae mah, Thoemto kamimawk mah loe nang loe tuinuem paekkung Johan ni, tiah a thuih o: thoemto kaminawk mah loe Elijah, tiah thuih o moe, kalah thoemto kaminawk bae mah loe, Jeremiah, to tih ai boeh loe tahmaanawk thung ih maeto kami ah oh, tiah a thuih o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih mah nihcae khaeah, Nangcae mah loe kai hae mi kawbaktiah maw na poek o? tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To naah Simon Piter mah, Nang loe Kri, kahing Sithaw ih Capa ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu mah anih khaeah, Nang Simon Barjona, taham na hoih: taksa hoi athii mah to hmuen to ang panoeksak ih na ai ni, van ah kaom kam Pa mah ni ang panoeksak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang khaeah doeh lok ka thuih, Nang loe Piter ni, hae lungsong nuiah kai bokhaih im to kaimah roe ka sak han; kai bokhaih im loe hell khongkhanawk mah pazawk o thai mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Van prae cabi to kang paek han: long nuiah na taoeng ih hmuen boih van ah taoeng tih: long nuiah na khram ih hmuen boih van ah khram tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />A hnukbang kaminawk khaeah anih loe Jesus Kri ni, tito mi khaeah doeh thuih o han ai ah lok a thuih pae.
  </para>
  <para style="p">
    <verse number="21" style="v" />To nathuem hoi kamtong a hnukbang kaminawk khaeah Jesu mah, Anih loe Jerusalem ah caeh tih, kacoehtanawk, kalen koek qaimanawk hoi ca tarik kaminawk ban thung hoiah congca patangkhanghaih to tong tih, anih to hum o ueloe, ni thumto naah angthawk let tih, tiah kamtuengta ah a thuih pae.
  </para>
  <para style="p">
    <verse number="22" style="v" />Piter mah anih to kalah bangah caeh haih moe, anih to thuitaek, Angraeng, hae baktih hmuen na nuiah pha hmah nasoe: nang hoi angthla nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe anih mah Piter khaeah angqoi moe, Setan, ka hnuk ah angnawn ah: nang loe kai amthaek han ih ni na oh: Sithaw ih hmuennawk to na poek ai, kaminawk ih hmuen ni na poek lat, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pacoengah Jesu mah a hnukbang kaminawk khaeah, ka hnukah bang koeh kami loe, angmah hoi angmah to angmaa nasoe, angmah ih thinglam to aput hoiah ka hnukah bang nasoe.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi kawbaktih doeh a hinghaih pahlong kami loe anghmaa tih: toe mi kawbaktih doeh kai pongah a hinghaih anghmaa kami loe hinghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kami maeto mah longpum a tawnh, toe a hinghaih anghma ving nahaeloe, tih atho maw om tih, to tih ai boeh loe a hinghaih tih hoiah maw anglai thai tih?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kami Capa loe Ampa lensawkhaih hoiah van kaminawk hoi nawnto angzo ueloe, kami boih a toksakhaih baktih toengah tangqum paekhaih to om tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Loktang kang thuih o, Hae ah angdoe kaminawk thungah, thoemto loe angmah prae ah angzo kami Capa hnu o ai karoek to duekhaih pataeng han ai kami to oh, tiah a naa.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni tarukto oh pacoengah Jesu loe Piter, Jakob hoi amnawk Johan to kawk moe, nihcae to maesang ah dawh haih tahang,
  </para>
  <para style="p">
    <verse number="2" style="v" />to naah anih loe nihcae hma ah krang amkhraih pae: anih ih mikhmai loe ni aengh baktiah aang, anih ih kahni loe ni aengh baktiah anglung.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khenah, nihcae hma ah Mosi hoi Elijah to amtueng pae moe, anih hoiah lok apaeh hoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Piter mah Jesu khaeah, Angraeng, aicae haeah oh han hoih: na koeh nahaeloe, hae ah kahni im thumto sah si; nang hanah maeto, Mosi hanah maeto, Elijah hanah maeto, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />To tiah anih lokthuih li naah, khenah, nihcae loe ka-aang tamai mah khuk hmoek: khenah tamai thung ih lok mah, Hae loe ka koeh moe, ka palung duek ih ka Capa ah oh, a lok to tahngai pae oh, tiah thuih.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hnukbang kaminawk mah to lok to thaih o naah, paroeai zit o moe, lu takhum hoiah tabok o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu angzoh moe nihcae to sui, Zii o hmah, angthawk o lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />A khet o tahang naah, Jesu khue ai ah loe, mi doeh hnu o ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mae nui hoi anghum o tathuk naah, Jesu mah nihcae khaeah, Kami Capa duekhaih thung hoi angthawk let ai karoek to, na hnuk o ih hmuen hae mi khaeah doeh thui o hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah a hnukbang kaminawk mah, Tikhoe ca tarik kaminawk mah loe Elijah angzo hmaloe tih, tiah thuih o loe? tiah a dueng o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu mah nihcae khaeah, Elijah to angzo hmaloe tangtang ueloe, hmuennawk to sak pakhrai boih tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe kang thuih o, Elijah loe angzoh boeh, nihcae mah anih to panoek o ai, nihcae loe anih nuiah koeh baktiah toksak o. To baktih toengah kami Capa doeh nihcae ban thungah patangkhang tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae khaeah a thuih pae ih lok loe tuinuemhaih paekkung Johan kawng ni, tito a hnukbang kaminawk mah panoek o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Paroeai angpop kaminawk khaeah a caeh o naah, kami maeto anih khaeah angzoh moe, khok cangkrawn hoiah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng, ka capa nuiah palungnathaih tawn raeh: anih loe amthu moe, patangkhang parai boeh: hmai hoi tui thungah doeh vaihi hoi vaihi amtimh, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang hnukbang kaminawk khaeah ka caeh haih, toe nihcae mah ngantui o sak thai ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu mah, Aw tanghaih tawn ai kami hoi palung thah caanawk, nasetto maw kang oh haih han vop? Nasetto maw kang pauep haih han vop? Anih to haeah kai khaeah na hoi ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu mah taqawk to zoeh pae; to naah anih ih takoh thung hoiah taqawk to tacawt: to nathuem hoiah nawkta loe ngantui roep.
  </para>
  <para style="p">
    <verse number="19" style="v" />To naah a hnukbang kaminawk Jesu khaeah tamquta hoi angzoh o moe, tipongah kaicae mah loe ka haek o thai ai loe? tiah a dueng o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu mah nihcae khaeah, Tanghaih na tawn o ai pongah ni: loktang kang thuih o, antam mu tet to mah tanghaih na tawnh o nahaeloe, hae mae khaeah hae ahmuen hoiah ho ahmuen ah angthui ah, tiah na naa o nahaeloe, angthui tih; nangcae hanah angcoeng thai ai hmuen tidoeh om mak ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hae baktih hmuen loe lawkthuihaih hoi buhzahhaih hoi ai ah loe kawbangah doeh tacawt thai ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae Kalili prae ah oh o naah, Jesu mah nihcae khaeah, Kami Capa loe minawk ban ah paek o tih:
  </para>
  <para style="p">
    <verse number="23" style="v" />nihcae mah anih to hum o tih, anih loe ni thumto naah angthawk let tih, tiah a naa. To naah nihcae loe paroeai palungset o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nihcae Kapernuam vangpui ah angzoh o naah, tamut cong kaminawk Piter khaeah angzoh o moe, Nangcae patukkung loe tamut paek ai maw? tiah a dueng o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih mah, a paek bae, tiah a naa. Anih imthungah akun naah Jesu mah, Simon, kawbangmaw na poek? Long nui siangpahrangnawk mah mi khaeah maw tamut a cong o? angmacae ih caanawk khaeah maw, to tih ai boeh loe minawk kalah khaeah? tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Piter mah anih khaeah, Minawk kalah khaeah, tiah a thuih pae. Jesu mah anih khaeah, to tih nahaeloe a caanawk loe loih o takhae, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe nihcae palungphuisak han ai ah, tuipui ah caeh ah, cakoih to va ah loe, tathok hmaloe ih tanga to la ah; tanga pakha angh naah, phoisa maeto na hnu tih: to phoisa to la ah loe, nang hoi kai hanah tamut ah paek ah, tiah a naa.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />To nathuem ah hnukbang kaminawk Jesu khaeah caeh o moe, siangpahrang mah uk ih van prae ah mi maw len koek tih? tiah a dueng o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu mah angmah khaeah nawkta ta to kawk moe, nihcae salakah ohsak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae khaeah, Loktang kang thuih o, poek nam khraih o moe, nawkta ta baktiah na om o ai nahaeloe, van prae thungah na kun o thai mak ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pongah mi kawbaktih doeh hae nawkta ta baktiah poek pahnaemhaih hoiah khosah kami loe, van prae ah kalen koek kami ah om tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi kawbaktih doeh nawkta to hae tiah ka hmin hoiah talawk kami loe kai talawk kami ah ni oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe kai tanghaih tawn hae nawktanawk thung ih kami maeto khaeah zaehaih sahsak kami loe, cangkaehhaih thlung tahnong ah a oihsak moe, kathuk tuipui thungah pakhrak nahaeloe anih han hoih kue tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sakpazaehaih hmuen pongah long loe khosak bing! To baktih hmuen sakpazaehaih loe kaom han ih roe ni; toe hmuen sakpazaehaih omsak kami loe khosak bing!
  </para>
  <para style="p">
    <verse number="8" style="v" />Na ban mah maw, to tih ai boeh loe na khok mah maw hmuen sah pazae nahaeloe takroek pat ah loe, va ving ah: ban hnetto hoi khok hnetto akoep ah dungzan hmai thungah na krak pongah loe, takpum akoep ai ah hinghaih thungah akun to hoih kue.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na mik mah hmuen sahpazae nahaeloe, taprok dok ah loe, va ving ah: mik hnetto hoi hell hmai thungah na krak pongah loe, mik maeto hoiah hinghaih thungah akun to hoih kue.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hae nawktanawk thung ih kami maeto doeh na hnap o han ai ah acoe oh; kang thuih o, nihcae ih van kaminawk mah loe van ah kaom kam Pa ih mikhmai to a hnuk o toepsoep.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kami Capa loe kanghmaa kami pahlong han ih ni angzoh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kawbangah maw na poek o? Kami maeto loe tuu cumvaito tawnh, tuu maeto loklam amkhraeng ving nahaeloe, anih mah qui takawt, takawtto tuu to caehtaak sut ueloe, mae nuiah a caeh pacoengah, lam amkhraeng ving tuu maeto to pakrong mak ai maw?
  </para>
  <para style="p">
    <verse number="13" style="v" />Loktang kang thuih o, anih loe lam amkhraeng ai tuu qui takawt, takawtto pongah, a hnuk ih tuu anghmaa maeto nuiah palung anghoe kue.
  </para>
  <para style="p">
    <verse number="14" style="v" />To baktih toengah van ah kaom nangcae Ampa loe, hae nawktanawk thung ih kami maeto mataeng doeh anghmatsak han koeh ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nam nawkamya mah na nuiah hmuen sah pazae nahaeloe, caeh ah loe, a zaehaih to nangma hnik salak khue ah thui ah: na thuih ih lok to anih mah tahngai nahaeloe, anih to na pazawk.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe anih mah na lok tahgai ai nahaeloe, kami hnetto maw, to tih ai boeh loe thumto hoiah maw caeh ah, hnukung kami hnetto maw, to tih ai boh loe thumto hoiah maw lokcaek ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah nihcae ih lok tahgai ai bae nahaeloe, kricabu khaeah thui ah: kricabu mah thuih ih lok doeh tahngai ai vop nahaeloe, anih to taksa kami hoi tamut cong kami baktiah poek oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Loktang kang thuih o, Long nuiah na taoengh o ih hmuen boih van ah taoeng ueloe, long nuiah na khram o ih hmuen boih van ah khram tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kang thui o let bae, Long nuiah kami hnetto mah poek anghmonghaih hoiah kawbaktih hmuen doeh hnih nahaeloe, van ah kaom kam Pa mah nihnik hanah sah pae tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kai ih ahmin hoiah kami hnetto maw, thumto maw angpophaih ahmuen ah, nihcae salakah kai ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />To naah Piter to Jesu khaeah caeh moe, Angraeng kam nawkamya mah ka nuiah hmuen sak pazae naah, vai nazetto maw ka tahmen han? Vai sarihto maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu mah anih khaeah, Kang thuih, vai sarihto khue na ai: qui sarih, alet sarih karoek to, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah van prae loe siangpahrang maeto mah, a tamnanawk khaeah laiba sukhaih hoiah anghmong.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih mah laiba phoisa kroek amtong naah, phoisa sang hato laiba tawn kami maeto, anih khaeah hoih o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih loe laiba pathok thai ai pongah, phoisa coisakkung mah, a zu a caa hoi a tawnh ih hmuenmae boih zawh pacoengah, laiba pathok hanah lok a thuih pae.
  </para>
  <para style="p">
    <verse number="26" style="v" />To naah tamna loe anih hma ah tabok moe, tahmenhaih hnik, Angraeng, na tahmen raeh, kang pathok boih han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tamna ih angraeng mah anih to tahmen moe, laiba to loihsak boih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toe to tamna loe tasa bangah tacawt naah, anih khaeah phoisa cumvaito kacoi, tamnanawk thungah kaom angmah ih ampui maeto a hnuk: anih to tahnong ah patawnh moe, laiba na pathok lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angmah ih ampui tamna loe anih khokkung ah tabok moe, na tahmen raeh, kang pathok boih han hmang, tiah tahmenhaih hnik.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe anih to prawt ai: laiba pathok boih ai karoek to anih to thongim thungah pakhrak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Angmah ih ampui tamnanawk mah to tiah sak ih hmuen to hnuk o naah, paroeai palung set o, nihcae loe caeh o moe, anih mah sak ih hmuennawk to angmacae ih angraeng khaeah a thuih pae o.
  </para>
  <para style="p">
    <verse number="32" style="v" />To naah angmah ih angraeng mah, anih to kawk moe, anih khaeah, Aw kahoih ai kami tamna nang, kai khaeah tahmenhaih nang hnik pongah nang baa ih laiba to kang tahmen boih moe, kang loihsak:
  </para>
  <para style="p">
    <verse number="33" style="v" />na nuiah tahmenhaih ka tawnh baktih toengah, nam puinawk nuiah tahmenhaih na tawn toeng han oh bae? tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Anih ih angraeng loe palungphui moe, laiba pathok boih ai karoek to tamna to thongim pakhrah kaminawk khaeah a paek.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nangcae doeh nam nawkamya zaehaih tahmen han na koeh o ai nahaeloe, van ah kaom kam Pa mah nangcae nuiah to tiah sah toeng tih, tiah a naa.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu mah hae loknawk thuih pacoengah, Kalili prae hoiah tacawt moe, Judea prae Jordan vapui zaeh ah a caeh;
  </para>
  <para style="p">
    <verse number="2" style="v" />paroeai kaminawk anih hnukah bang o; anih mah to ahmuen ah nihcae to ngantuisak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thoemto Farasinawk loe Anih tanoek hanah, anih khaeah angzoh o, kawbaktih hmuen pongah doeh kami maeto mah a zu to pakhrak thaihaih daan oh maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah nihcae khaeah, Tangsuek hoi sahkung mah loe nongpa hoi nongpata to a sak, tiah pathim pae,
  </para>
  <para style="p">
    <verse number="5" style="v" />hae pongah nongpa mah ampa hoi amno to caehtaak ueloe, a zu to la tih: nihnik loe takpum maeto ah om hoi tih, tiah kaom lok to na kroek o vai ai maw?
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah nihnik loe hnetto na ai boeh ni, takpum maeto ah ni oh hoi boeh. To pongah Sithaw mah nawnto patomh boeh loe, mi mah doeh tapraek hmah nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae mah anih khaeah, to tiah nahaeloe tipongah Mosi mah loe, Zu pakhrakhaih ca to paek ah loe, zu to pakhrah ah, tiah thuih loe? tiah a naa o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu mah nihcae khaeah, Palung na thah o hmoek pongah ni zu pakhrak hanah ang thuih o: toe tangsuek naah loe to tiah om ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kang thuih o, mi kawbaktih doeh zu sava laep ah daan ai ah nongpa nongpata zae sakhaih khue ai ah, zu pakhrah moe, kalah nongpata to zu ah la kami loe, daan ai ah minawk ih zu sava hoi zaehaih sah kami ah ni a oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hnukbang kaminawk mah, Zulakhaih kawng pongah hae tiah kami to om nahaeloe, zu lak han hoih ai bae to, tiah a naa o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe anih mah nihcae khaeah, Paek ih kaminawk khae khue mah ai ah loe, kami boih mah hae thuih ih lok hae talawk o thai mak ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thoemto kaminawk loe amno zokthung hoiah tangzat dueh kami ah tapen: thoemto kaminawk loe kaminawk mah loe tangzat to duek o sak: thoemto kaminawk loe van prae taham ah angmacae hoi angmacae tangzat dueh kami ah oh o. Talawk thaih kami mah hae lok hae talawk nasoe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah nawktanawk nuiah ban koeng moe, lawkthuih pae hanah nawktanawk anih khaeah angzoh o haih, toe a hnukbang kaminawk mah nihcae to zoeh pae o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe Jesu mah, Nawktanawk to om o nasoe, nihcae to pakaa o hmah, kai khaeah angzo o haih ah: siangpahrang mah uk ih van prae loe to baktih kaminawk han ih ni oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nihcae nuiah a ban koeng pae pacoengah, to ahmuen hoiah tacawt taak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khenah, kami maeto anih khaeah angzoh moe, Kahoih patukkung, dungzan hinghaih ka hnuk thai hanah, kahoih hmuen timaw ka sak han? tiah a dueng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah, tipongah Kahoih, tiah nang kawk loe? Sithaw, maeto khue ai ah loe, kahoih maeto doeh om ai: hinghaih thungah akun han na koeh nahaeloe, kaaloknawk to pazui ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To naah to kami mah, Kawbaktih kaalok maw? tiah a naa. Jesu mah, Kami hum hmah, zu sava laep ah nongpa nongpata zaehaih sah hmah, paqu hmah, hnukung amsawn ah om hmah,
  </para>
  <para style="p">
    <verse number="19" style="v" />nam no hoi nam pa to saiqat ah, na imtaeng kaminawk to nangmah baktih toengah palung ah, tiah thuih ih kaalok to, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />To naah thendoeng mah anih khaeah, Hae kaaloknawk loe nawkta nathuem hoiah ka pazui boih boeh: ka sak han ih timaw angai vop? tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu mah anih khaeah, Kakoep ah oh han na koeh nahaeloe, caeh ah loe, na tawnh ih hmuennawk to zawh boih pacoengah, amtang kaminawk hanah paek ah, siangpahrang mah uk ih van prae ah hmuenmae to na tawn tih: to pacoengah ka hnukah bangah, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />To lok to thendoeng mah thaih naah, anih loe hmuenmae hoiah angraeng parai kami ah oh pongah, palungset moe, a caeh ving.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu mah a hnukbang kaminawk khaeah, Loktang kang thuih o, Long angraeng loe siangpahrang mah uk ih van prae thungah akun han rai parai;
  </para>
  <para style="p">
    <verse number="24" style="v" />kang thuih o let, Long angraeng Sithaw mah ukhaih prae thungah akun pongah loe, kaengkuu hrang phungvang khaw thungah akun han zoi kue, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To lok to a hnukbang kaminawk mah thaih o naah, nihcae mah dawnrai o parai, to tiah nahaeloe mi maw pahlong ah om thai tih? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe Jesu mah nihcae khaeah angqoi moe, Kami han loe hae hmuen hae angcoeng thai ai; toe Sithaw hoiah loe hmuen boih angcoeng thaih, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pacoengah Piter mah anih khaeah, Khenah, kaicae loe hmuennawk boih ka caeh o taak moe, na hnukah ka bang o: kaicae loe timaw ka hnu o tih? tiah pathim pae.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu mah nihcae khaeah, Loktang kang thuih o, hmuenmae kangtha ah amkhraihaih atue to oh moe, kami Capa a lensawkhaih angraeng tangkhang nuiah anghnut naah, nangcae doeh angraeng tangkhang hatlai hnetto nuiah nang hnu o ueloe, Israeal acaeng hatlai hnettonawk to lok na caek o tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi kawbaktih doeh ka hmin pongah imnawk maw, to tih ai boeh loe nawkamyanawk maw, to tih ai boeh loe ampa maw, to tih ai boeh loe amno maw, to tih ai boeh loe a zu maw, to tih ai boeh loe a caanawk hoi a lawknawk maw caehtaak kami loe, atho alet cumvaito hnu ueloe, dungzan hinghaih qawk to toep tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe pop parai hmahman kaminawk hnukkhuem o ueloe, hnukkhuem kaminawk to hmahman o tih, tiah a naa.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Van prae loe khawnthaw ah angmah ih takha thungah kacaeh, toksak han kami pakrong, takha tawn kami maeto hoiah anghmong.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah toksah kami to nito naah denari phoisa maeto paek hanah palung adue pacoengah, nihcae to angmah ih misur takha thungah patoeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih loe atue thumto phak naah tasa bangah caeh, to naah hmuenmae zawhhaih ahmuen ah angdoe rumram kalah kaminawk to a hnuk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae khaeah, Nangcae doeh misur takha thungah caeh o toeng ah, kating tawk atho kang paek o han hmang, tiah a naa. To naah nihcae loe caeh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Atue tarukto hoi takawtto naah a caeh let moe, to tiah a thuih pae let.
  </para>
  <para style="p">
    <verse number="6" style="v" />Atue hatlaito phak naah tasa bangah a caeh let, to naah angdoe rumram kalah kaminawk to a hnuk, nihcae khaeah, Tipongah athun qui tidoeh sah ai ah haeah nang doet o sut loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae mah anih khaeah, kaicae loe mi mah doeh pacae ai, tiah a naa o. Anih mah nihcae khaeah, Nangcae doeh misur takha thungah caeh o toeng ah; kating tawk atho na hnu o tih hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Duembang phak naah loe, misur takha tawnkung mah phoisa pakuem kami khaeah, toksah kaminawk to kawk ah, hnukkhuem angzo kami hoi amtong ah loe, hmaloe angzo kami khoek to toksakhaih atho to paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Atue hatlaito nathuem ah toksak han pacae ih kaminawk to angzoh o, nihcae loe denari phoisa maeto hnuk o boih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toe toksak han pacae hmaloe ih kaminawk angzoh o naah loe, nihcae mah kaicae loe kapop kue ah ka hnu o tih, tiah poekhaih a tawnh o; toe nihcae doeh denari phoisa maeto ni hnuk o toeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Phoisa a hnuk o pacoengah loe, kahoih im tawnkung to laisaep o thuih,
  </para>
  <para style="p">
    <verse number="12" style="v" />hnukkhuem ah angzo kaminawk loe atue maeto thung khue ni toksak o, toe nihcae to athun qui ni kana thungah toksah kaicae hoi kangvan ah na suek, tiah a naa o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe anih mah nihcae thung ih kami maeto khaeah, Ampui, na nuiah hmuen sak pazaehaih ka tawn ai: denari phoisa maeto paek han ih na ai maw palung duehaih a sak hoi?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang mah ih hmuen to la ah loe, caeh lai ah: nang han kang paek ih baktih toengah ni hae ih hnukkhuem kaminawk khaeah doeh ka paek han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tawnh ih hmuen nuiah koeh baktiah sak thaihaih ka tawn mak ai maw? Ka hoih pongah uthaih mik na tawnh maw?
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah hnukkhuem kaminawk to hmahman o ueloe, hmahman kaminawk to hnukkhuem o tih: kawk ih kami loe pop parai, toe qoih ih kami loe tamsi, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu Jerusalem ah caeh naah a hnukbang hatlai hnettonawk to kamhoe ah a caeh haih moe, nihcae khaeah,
  </para>
  <para style="p">
    <verse number="18" style="v" />khenah, Jerusalem ah caeh o tahang si; Kami Capa loe kalen koek qaima hoi ca tarik kaminawk khaeah paek o ueloe, nihcae mah hum han khokhan o tih,
  </para>
  <para style="p">
    <verse number="19" style="v" />pahnuih o thuih moe, boh o pacoengah thinglam pongah takhing hanah, Gentel kaminawk khaeah paek o tih: Anih loe ni thumto naah angthawk let tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />To nathuem ah Zebedi caanawk ih amno mah a capa hnik to Jesu khaeah caeh haih, a koeh ih hmuen maeto hnik hanah, anih to bok.
  </para>
  <para style="p">
    <verse number="21" style="v" />To naah anih mah timaw na koeh? tiah a naa. Nongpata mah, Siangpahrang ah na ukhaih prae thungah, hae ka capa hnik hae na bantang bangah maeto, banqoi bangah maeto anghnuthaih ahmuen to paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe Jesu mah, Nang hnik ih hmuen to na panoek ai. Ka naek han koi boengloeng hae na nae hoi thai tih maw, ka tuinuemhaih hae na nuem hoi thai tih maw? tiah a naa. Nihnik mah, Ue, ka sah hoi thai tih, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu mah nihnik khaeah, Kai ih boengloeg hae na nae hoi thaih ueloe, kai tuinuemhaih doeh na nuem hoi thaih tangtang tih: toe ka bantang bang hoi banqoi bangah anghnut han ih loe, ka paek han koi hmuen na ai ni, kam Pa mah pahoe tangcae kaminawk hanah ni paek tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />To lok to kami hatonawk mah thaih o naah, nihnik amnawk nuiah palungphui o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toe Jesu mah nihcae to kawk moe, Gentel kaminawk loe angmacae Gentel kaminawk nuiah ukhaih to tawnh o, ukkungnawk mah nihcae nuiah ukhaih akaa to tawnh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe nangcae thungah loe to tiah oh han om ai: mi kawbaktih doeh nangcae thungah kalen koek ah kaom han koi kami loe nangcae ih toksahkung ah om nasoe;
  </para>
  <para style="p">
    <verse number="27" style="v" />mi kawbaktih doeh nangcae thungah kalen koek ah kaom han koi kami loe, nangcae ih tamna ah om nasoe:
  </para>
  <para style="p">
    <verse number="28" style="v" />kami Capa loe minawk toksaksak hanah angzo ai, minawk ih tok to sak moe, pop parai kaminawk akrang pacoengah, a hinghaih paek han ih ni angzoh, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae Jeriko vangpui thung hoi tacawt o naah, pop parai kaminawk anih hnukah bang o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khenah, mikmaeng hnik loe lam taengah anghnut hoi, to loklam ah Jesu angzoh boeh, tiah a thaih hoi naah, Aw Angraeng, David capa, kai hnik nuiah palungnathaih tawn raeh, tiah a hang hoi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Paroeai kaminawk mah oh hoi duem hanah nihnik to zoeh o: toe nihnik loe, Aw Angraeng, David capa, kaihnik nuiah palungnathaih tawn raeh, tiah kanung aep ah hang hoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />To naah Jesu loe angdoet moe, nihnik to kawk, timaw saksak han na koeh hoi, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />To naah nihnik mah anih khaeah, Angraeng, mik amtueng han ka koeh hoi, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah nihnik to tahmen moe, mik to sui pae: to naah nihnik ih mik to amtueng roep, to pacoengah nihnik loe anih hnukah bang hoi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem phak tom boeh moe, Olive mae Berthphage vangpui to phak o naah, Jesu mah a hnukbang kami long hnetto patoeh,
  </para>
  <para style="p">
    <verse number="2" style="v" />nihnik khaeah, Na hma ah kaom avang ah caeh hoih, paeh ih laa hrang acaa hoi amno to na hnu hoi roep tih: khram hoih loe kai khaeah hoi hoiah,
  </para>
  <para style="p">
    <verse number="3" style="v" />mi kawbaktih mah doeh lok na dueng hoi nahaeloe, Angraeng mah angtoeng; na thak let tih hmang, tiah thui pae hoih, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hae hmuennawk boih loe Tahmaa mah, Khenah, tuinom kaom, nangcae ih siangpahrang loe laa hrang nuiah angthueng ueloe, laa hrang acaa angthueng hoiah nangcae khaeah angzo tih, tiah Zion canu khaeah thui paeh, tiah thuih ih lok akoep han ih ni oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hnukbang hnik loe caeh hoi moe, Jesu mah thuih ih lok baktih toengah a sak hoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihnik mah laa hrang amno hoi a caa to zaeh hoi moe, a nuiah kahni baih pae hoi, anih to a nuiah anghnut o sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pop parai kaminawk mah angmacae ih kahni to loklam ah baih o; thoemto kaminawk mah loe thing tanghang to pakhruk o moe, loklam ah baih o.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hmabang caeh kami hoi a hnuk bangah angzo pop parai kaminawk mah David Capa khaeah, Hosanna: Angraeng ih ahmin hoi angzo kami loe tahamhoih nasoe; kasang koek Hosanna, tiah hangh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih Jerusalem vangpui thungah akun naah, vangpui boih angthawk o moe, hae kami loe mi aa? tiah thuih o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Paroeai kaminawk mah, hae kami loe Kalili prae Nazareth vangpui ih tahmaa Jesu ni, tiah a naa o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesu loe tempul thungah caeh moe, hmuenmae zaw kami hoi qan kaminawk to a haek, phoisa atlaeng kaminawk ih caboi to palet pae moe, pahuu zaw kaminawk ih anghnuthaih hmuennawk doeh palet pae king.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae khaeah, Kai ih im loe lawkthuihaih im tiah kawk o tih, tiah tarik ih oh; toe nangcae mah loe kamqunawk ohhaih ahmuen ah na sak o lat, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mikmaeng hoi khokkhaemnawk loe tempul thungah anih khaeah angzoh o moe, anih mah nihcae to ngantuisak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih mah sak ih dawnrai hmuen to hnuk o moe, nawktanawk mah tempul thungah, David Capa khaeah, Hosanna, tiah hang o ih lok to kalen koek qaima hoi ca tarik kaminawk mah thaih o naah, palungphui o;
  </para>
  <para style="p">
    <verse number="16" style="v" />anih khaeah, Hae kaminawk mah thuih o ih lok na thaih maw? tiah a naa o. Jesu mah nihcae khaeah, Ue: nawktanawk hoi tahnu nae li nawktanawk ih pakha thung hoiah nang to saphaw o tih, tiah tarik ih ca to na kroek o vai ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah nihcae to caehtaak ving, Bethany avang ah a caeh moe, to ah anghak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih khawnbang khawnthaw vangpui ah amlaem naah, zok amtlam.
  </para>
  <para style="p">
    <verse number="19" style="v" />Loklam taengah kaom thaiduetkung to a hnuk naah a taengah a caeh, aqam khue ai ah loe tidoeh hnu ai; to naah thaiduetkung khaeah, Vaihi hoi kamtong natuek naah doeh athaih athai hmah lai ah, tiah a naa. Thaiduetkung loe akra ai ah azaem roep.
  </para>
  <para style="p">
    <verse number="20" style="v" />A hnukbang kaminawk mah hnuk o naah dawnrai o, kawbangmaw thaiduetkung loe azaem roep halat! tiah a thuih o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu mah nihcae khaeah, Loktang kang thuih o, palung haenghaih tawn ai ah, tanghaih na tawnh o nahaeloe, hae thaiduetkung khaeah sak ih hmuen khue ai, hae mae khaeah doeh angthui ah loe, tuipui thungah krah ah, tiah na naa o nahaeloe, angthui tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tanghaih hoiah lawkthuih moe, hnik ih hmuen to na hnu o boih tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih loe tempul thungah angzoh, anih mah kaminawk patuk nathuem ah qaima hoi kacoehtanawk anih khaeah angzoh o moe, naa ih sakthaihaih akaa hoiah maw hae baktih hmuennawk hae na sak? Mi mah maw hae baktih sakthaihaih ang paek? tiah a dueng o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu mah nihcae khaeah, Kai mah doeh lok maeto kang dueng o toeng han, nang pathim o nahaeloe, naa ih sakthaihaih akaa hoiah maw hae baktih hmuennawk hae ka sak, tito kang thuih o han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Johan tuinuemhaih loe naa hoiah maw angzoh? Van bang ih maw, to tih ai boeh loe kaminawk khae hoi ih? tiah a naa. To naah angmacae hoi angmacae to lok angdueng o, Van bang ih tiah a thuih o nahaeloe, tikhoe na tang o ai loe? tiah na naa tih,
  </para>
  <para style="p">
    <verse number="26" style="v" />kaminawk khae hoi ih ni, tiah a thuih o nahaeloe, kaminawk boih mah Johan loe tahmaa ni, tiah poek o pongah, kaminawk to zit han oh koek, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pongah nihcae mah Jesu khaeah, Ka panoek o ai, tiah pathim pae o. Jesu mah, to tiah nahaeloe naa ih sakthaihaih akaa hoiah maw hae baktih hmuennawk hae ka sak, tito kang thui o mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangcae loe kawbangah maw na poek o? Kami maeto mah capa hnetto tawnh; anih loe capa kacoeh khaeah caeh moe, Ka capa, vaihniah kai ih misur takha thungah caeh ah loe, toksah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih mah ka caeh mak ai, tiah pathim; toe nawnetta oh pacoengah dawnpakhuem moe, a caeh let.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pacoengah hnetto haih capa khaeah caeh moe, to tiah a thuih pae let. Anih mah, Ka caeh han hmang, angraeng, tiah a naa; toe caeh ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nihnik thungah ampa koehhaih sah kami loe mi maw? tiah a naa. Nihcae mah anih khaeah, hmaloe ih kami, tiah pathim pae o. Jesu mah nihcae khaeah, Loktang kang thuih o, tamut cong kami hoi tangzat zaw kaminawk mah Sithaw prae ah na caeh o taak tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangcae loklam katoeng hnuksak hanah Johan nangcae khaeah ang zoh, toe anih to na tang o ai: tamut cong kami hoi tangzat zaw kami mah loe tang o: to tiah kaom hmuen to na hnuk o, toe anih tang hanah, dawnpakhuemhaih na tawn o ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Patahhaih lok kalah tahngai o let bae ah: takha tawnkung maeto oh, anih mah misurkung to thling, takha to pakaa takui boih pacoengah, misurtui pasawhhaih long to takaeh moe, toephaih im to a sak, takha thungah toksak hanah toksah kami to pacae pacoengah, angmah to loe kholong kangtla ah a caeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Misurthaih pakhrikhaih atue phak naah loe, misurthaih pakhrik hanah, takha toepkung khaeah a tamnanawk to patoeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Takha thung toksah kaminawk mah anih ih tamnanawk to naeh o moe, tamna maeto loe boh o, kalah maeto loe hum o, kalah maeto doeh thlung hoiah vah o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Takha tawnkung mah hmaloe ih tamna pong kapop ah tamnanawk to patoeh let: toe takha thungah toksah kaminawk mah nihcae to patoeh hmaloe ih tamnanawk baktih toengah sak o let.
  </para>
  <para style="p">
    <verse number="37" style="v" />Toe ka capa loe nihcae mah saiqat o tih hmang, tiah a poek pongah, a capa to hnukkhuem koek ah patoeh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Toe takha toep kaminawk mah a capa to hnuk o naah, Hae kami loe qawktoep kami ni; angzo oh, anih hae hum si loe, anih ih qawk to lomh pae o si, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih to a naeh o, takha thung hoiah vah o moe, hum o.
  </para>
  <para style="p">
    <verse number="40" style="v" />To pongah misur takha tawnkung angzoh naah loe, takha thungah toksah kaminawk to kawbangmaw sah tih? tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nihcae mah anih khaeah, Kahoih ai kaminawk to khet kamcuk ai ah amrosak ueloe, misur athaihaih atue phak naah angmah han athaih kapaek thaih kalah kami hanah misur takha to tlaisak tih, tiah a naa o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu mah nihcae khaeah, Im sah kaminawk mah pahnawt o sut ih thlung loe, kacak koek im takii ih thlung ah oh boeh: hae loe Angraeng mah sak ih hmuen ah oh, aicae mikhnuk ah loe dawnrai hmuen ah oh, tiah kaom lok to Cabu thungah na kroek o vai ai maw?
  </para>
  <para style="p">
    <verse number="43" style="v" />To pongah kang thuih o, Nangcae khae hoi ih Sithaw mah siangpahrang ah uk ih prae to la ving ueloe, athaih athai han koi acaeng khaeah paek tih.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mi kawbaktih doeh hae thlung nuiah amtimh kami loe koi phaeng tih: thlung mah taeh ih kaminawk doeh adip pueng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="45" style="v" />Anih mah thuih ih patahhaih lok to qaima hoi Farasinawk mah thaih o naah, nihcae thuih koehhaih ih ni, tito panoek o.
  </para>
  <para style="p">
    <verse number="46" style="v" />To pongah nihcae mah anih naeh thaihaih loklam to pakrong o, toe kaminawk mah anih loe tahmaa maeto ni, tiah poek o pongah, nihcae mah pop parai kaminawk to zit o.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu mah lok pathim pacoengah nihcae khaeah patahhaih lok thuih pae let, anih mah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Van prae loe siangpahrang maeto mah a capa han sak pae ih zu raenghaih poih hoiah anghmong.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaminawk zu paluemhaih poihkung ah angzoh o hanah a tamnanawk to patoeh moe, pacaesak, toe nihcae loe angzoh han koeh o ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah kalah tamnanawk to patoeh let, pacae ih kaminawk khaeah, Khenah, duembuh to ka thongh coek boeh: maitaw taenawk hoi kathawk parai moinawk to ka boh moe, hmuennawk boih ka suek coek boeh: zu paluemhaih poihkung ah angzo oh, tiah a kawksak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toe nihcae mah tiah doeh sah pae o ai, angmacae ih loklam bangah caeh o taak ving, kami maeto loe angmah ih lawk ah caeh, kalah kami maeto loe phoisa pakronghaih ahmuen ah caeh:
  </para>
  <para style="p">
    <verse number="6" style="v" />kanghmat kaminawk mah anih ih tamnanawk to naeh o moe, nihcae to khet kamcuk ai ah pacaekthlaek o pacoengah, a hum pae o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Siangpahrang mah to tiah kaom hmuen to thaih naah, anih loe palungphui: anih mah angmah ih misatuh kaminawk to patoeh moe, kami hum kaminawk to hum pacoengah, nihcae ih avang doeh hmai hoiah thlaek pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah anih mah a tamnanawk khaeah, Zu paluemhaih poih loe sak coek boeh, toe ka pacae ih kamimawk loe buh raenghaih poihkung ah caeh han krah kami ah om o ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah lampui ah caeh oh loe, na hnuk o sarui kaminawk to zu paluemhaih poihkung ah pacae oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pongah lampui ah a caeh o moe, kasae kahoih tih ai, a hnuk o sarui ih kaminawk boih to pakhueng o: to tiah zu paluemhaih poih loe angvinnawk hoiah koi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angvinnawk khet hanah siangpahrang a thungah angzoh naah, zu paluemhaih kahni angkhuk ai kami maeto a hnuk:
  </para>
  <para style="p">
    <verse number="12" style="v" />anih khaeah, Ampui, thikhoe zu pluemhaih kahni angkhuk ai ah haeah nang zoh loe? tiah a naa. To naah anih loe lokthuih han tawn ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Siangpahrang mah a tamnanawk khaeah, Hae kami ih khok ban to taoeng pae oh loe, qahhaih hoi haakaekhaih kaom, tasa bang ih khoving thungah va oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kawk ih kami loe paroe ai pop, toe qoih ih kami loe tamsi, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Farasinawk loe caeh o moe, anih mah thuih ih lok pongah kawbangmaw zaehaih hnuk thai han, tiah lok angdueng o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae mah angmacae hnukbang kaminawk hoi Herod ih kaminawk to Jesu khaeah patoeh o, nihcae mah, Patukkung, nang loe loktang lok to na thuih moe, Sithaw ih loklam to loktangta hoiah na patuk; nang loe mi kawbaktih koehhaih doeh na paroi ai, kaminawk ih mikhmai doeh na khen ai, tito ka panoek o.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah kawbangmaw na poek? Na thui ah, Caesar khaeah tamut paek hae hoih maw, hoih ai? tiah a naa o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Jesu mah nihcae ih kasae poekhaih to panoek pae naah, nangcae angsah thaih kaminawk, tikhoe kai nang tanoek o loe?
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamut phoisa to na patuek oh, tiah a naa. To pongah nihcae mah phoisa dip maeto anih khaeah sin pae o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih mah nihcae khaeah, Mi ih krang hoi mi ih ahmin maw haeah tarik o? tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nihcae mah anih khaeah, Caesar ih, tiah a naa o. Anih mah nihcae khaeah, Caesar ih hmuennawk to Caesar khaeah paek oh loe, Sithaw ih hmuennawk to Sithaw khaeah paek oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae mah hae loknawk thaih o naah, dawnrai o moe, anih to caeh o taak.
  </para>
  <para style="p">
    <verse number="23" style="v" />To na niah kadueh kami angthawk lethaih om ai, tiah kathui, Sadusinawk loe anih khaeah angzoh o moe,
  </para>
  <para style="p">
    <verse number="24" style="v" />patukkung, kami maeto loe caa sah ai ah, duek ving, to naah amnawk mah anih ih zu to la ueloe, amya hanah caa sah pae tih, tiah Mosi mah thuih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vaihi kaicae khaeah nawkamya sarihto katawn kami to oh: kacoeh koek loe zu a lak, toe caa sah ai ah, a duek ving, to pongah a zu to amnawk mah hamh:
  </para>
  <para style="p">
    <verse number="26" style="v" />to tiah vai hnetto haih, vai thumto haih hoi vai sarih karoek to oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hnukkhuem koek ah loe nongpata doeh duek.
  </para>
  <para style="p">
    <verse number="28" style="v" />To nongpata to nihcae boih mah zu o haih pongah, angthawk lethaih niah loe sarihto thungah mi ih zu ah maw om tih? tiah lok a dueng o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu mah nihcae khaeah, Cabu thung ih loknawk hoi Sithaw thacakhaih na panoek o ai pongah, na poek o pazae boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Angthawk lethaih niah loe imthong krakhaih hoi zu lakhaih to om mak ai boeh, van prae ah kaom Sithaw ih van kaminawk baktiah ni oh o boeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kadueh kaminawk angthawk lethaih kawng pongah, Sithaw mah ang thuih o ih lok to na kroek o vai ai maw? Sithaw mah,
  </para>
  <para style="p">
    <verse number="32" style="v" />Kai loe Abraham ih Sithaw, Isak ih Sithaw, Jakob ih Sithaw ah ka oh, tiah thuih. Sithaw loe kadueh kaminawk ih Sithaw na ai, kahing kaminawk ih Sithaw ah ka oh, tiah thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Paroeai kaminawk mah hae lok thaih o naah, anih ih patukhaih nuiah dawnrai o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah Sadusinawk angamsak duem boeh, tito Farasinawk mah thaih o naah, nihcae loe nawnto angcuu o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nihcae thung ih daan kop kami maeto mah, anih to tanoek hanah lokdueng,
  </para>
  <para style="p">
    <verse number="36" style="v" />patukkung, daan thungah kawbaktih kaalok maw kalen koek? tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jesu mah anih khaeah, Angraeng na Sithaw to palungthin boih, hinghaih boih, poekhaih boih hoiah palung ah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hae loe hmaloe koek hoi kalen koek kaalok ah oh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hnetto haih loe hae tiah oh, Na imtaeng kaminawk to nangmah ih takpum baktih toengah palung ah, tiah thuih ih lok hae ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kaalok hoi tahmaanawk mah thuih ih loknawk loe hae kaalok hnetto thungah akrum boih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />Farasinawk nawnto amkhueng o naah, Jesu mah nihcae khaeah,
  </para>
  <para style="p">
    <verse number="42" style="v" />Kri loe kawbangmaw na poek o? Anih loe mi ih capa maw? tiah lokdueng. Nihcae mah anih khaeah, David ih capa, tiah a naa o.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih mah nihcae khaeah, to tih nahaeloe kawbangah maw David mah Muithla ah Anih to Angraeng, tiah kawk loe? Anih mah loe,
  </para>
  <para style="p">
    <verse number="44" style="v" />Angraeng mah ka Angraeng khaeah, Na misanawk na khok tlim ah ka suem ai karoek to, ka bantang bangah anghnu ah, tiah thuih ih to oh bae.
  </para>
  <para style="p">
    <verse number="45" style="v" />David mah anih to Angraeng, tiah kawk nahaeloe, kawbangah maw Anih loe capa ah oh lat loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mi mah doeh a dueng ih lok to pathim o thai ai, to na ni hoi kamtong mi mah doeh anih khaeah lokdueng o ai boeh.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jesu mah angpop kaminawk hoi a hnukbang kaminawk khaeah hae tiah lokthuih pae,
  </para>
  <para style="p">
    <verse number="2" style="v" />ca tarik kami hoi Farasinawk loe Mosi ih tangkhang nuiah anghnut o:
  </para>
  <para style="p">
    <verse number="3" style="v" />to pongah nihcae mah thuih ih lok to pazui o boih ah loe, sah pae oh; toe nihcae mah sak ih hmuen baktiah sah o hmah: nihcae loe a thuih o ih lok baktiah, sah o ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe phawh thai ai ih hmuenzit hoiah taoengh o moe, minawk ih palaeng ah a koeng pae o; toe angmacae loe to hmuennawk to banpazung hoiah tahruet han mataeng doeh koeh o ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae mah sak ih hmuennawk boih loe kaminawk mah hnuk han ih ni sak o: nihcae loe ban ah zaeng ih hmuen to kalen ah sak o moe, kahni atom to kasawkah pakhrak o,
  </para>
  <para style="p">
    <verse number="6" style="v" />buh raenghaih poihkung ah anghnuthaih hmuensang to koeh o moe, synagogue ah kasang koek anghnuthaih ahmuen to a koeh o,
  </para>
  <para style="p">
    <verse number="7" style="v" />hmuenmae zawhhaih ahmuen ah minawk mah saiqat paekhaih, Rabbi, Rabbi, tiah kaminawk mah kawkhaih to a koeh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe nangcae loe Rabbi, tiah kawk o hmah, nangcae loe Patukkung, Kri khue ni na tawnh o; nangcae loe nawkamya ah ni na oh o boih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Long nuiah mi kawbaktih doeh pa, tiah kawk o hmah: nangcae loe van ah kaom, nam Pa maeto khue ni na tawnh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Patukkung, tiah na kawk o hanah, Patukkung maeto khue ni na tawnh o: anih loe Kri ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangcae thung ih kalen koek kami loe nangcae ih tamna ah oh han angaih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi kawbaktih doeh angmah hoi angmah to amkoeh kami loe, pahnaem tathuk ah om tih; mi kawbaktih doeh poek pahnaem kami loe pakoehhaih om tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangcae angsah thaih, Farasi hoi ca tarik kaminawk, khosak na bing o! Kaminawk hanah siangpahrang ah uk ih van prae to na khah pae o khoep: nangmacae doeh na kun o ai, a thungah akun koeh kaminawk doeh na pakaa o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangcae angsah thaih, Farasi hoi ca tarik kaminawk, khosak na bing o! Lamhmainawk ih im to na taek o moe, angsakhaih hoiah kasawkah lawk na thuih o: to pongah kalen aep danpaekhaih to na hnu o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangcae angsah thaih, Farasi hoi ca tarik kaminawk, khosak na bing o! Kami maeto amkhraisak hanah tuipui hoi saoeng to na takui o moe, kami to na hnuk o naah, anih to nangmacae pong alet hnetto kamtlai ah hell ih caa ah nang coeng o sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangcae mikmaeng zaehoikungnawk, khosak na bing o! Nangcae mah mi kawbaktih doeh tempul hoi lokkamhaih sah kami loe kawbangah doeh om mak ai; toe tempul thung ih sui hoiah lokkamhaih sah kami loe, a lokkamhaih to caksak poe han oh, tiah na thuih o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangcae mikmaeng hoi amthu kaminawk: sui maw kalen kue, to tih ai boeh loe sui ciimsakkung tempul?
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi kawbaktih doeh hmaicam hoi lokkamhaih sah kami loe, kawbangah doeh om mak ai, toe hmaicam nui ih tangqum hoiah lokkamhaih sah kami loe sak pazaehaih a tawnh, tiah na thuih o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangcae mikmaeng hoi amthu kaminawk: tangqum maw kalen kue, to tih ai boeh loe tangqum ciimsakkung hmaicam?
  </para>
  <para style="p">
    <verse number="20" style="v" />To pongah mi kawbaktih doeh hmaicam hoi lokkamhaih sah kami loe hmaicam hoi a nuiah kaom hmuen boih hoi lokkamhaih sak ah ni oh boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi kawbaktih doeh tempul hoi lokkamhaih sah kami loe tempul thungah kaom kami hoiah lokkamhaih sak ah ni oh boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi kawbaktih doeh van hoi lokkamhaih sah kami loe, Sithaw ih angraeng tangkhang hoi a nuiah anghnu kami hoiah lokkamhaih sak ah ni oh boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nangcae angsah cop thaih, ca tarik kami hoi Farasinawk, khosak na bing o! Nangcae loe cungpram, hmuihoih aan hoi cungsimnawk to haato thungah maeto na paek o, toe kaalok thungah kaom katoeng lokcaekhaih, kami tahmenhaih hoi tanghaih to tiah doeh na poek o ai: kalah hmuennawk to pahnawt sut ai ah, lokpui parai hmuennawk doeh na sak o han angaih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangcae mikmaeng zaehoikungnawk, taksae maeto doeh oh han ai ah tui to na pacii o, toe kaengkuu hrang maeto na pa-aeh o lat.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangcae angsah cop, ca tarik kami hoi Farasi kaminawk, khosak na bing o! Boengloeng hoi sabaenawk to anui bang kaciim ah na pasaeh o, toe athung bangah loe kami lomhhaih hoi kamtlai koeh hmoekhaih hoiah koi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Farasi mikmaengnawk, boengloeng hoi sabae to a thung bangah pasae o hmaloe ah, to tiah ni anui bang doeh ciim thai tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangcae angsah cop thaih, ca tarik kami hoi Farasinawk, khosak na bing o! Nangcae loe anui bang hoi khet kahoih ah rong kanglung hoi nok moe, athung bangah loe kadueh kaminawk ih ahuh, kaciim ai hmuennawk hoiah kakoi taprong hoiah ni anghmong.
  </para>
  <para style="p">
    <verse number="28" style="v" />To baktih toengah nangcae doeh tasa bang hoiah loe kaminawk hma ah katoeng kami baktiah amtueng, toe a thung bangah loe angsak cophaih, zaehaih hoiah ni na koi o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangcae angsah cop thaih, ca tarik kami hoi Farasinawk, khosak na bing o! Nangcae loe tahmaanawk ih taprong to na sak o moe, katoeng kaminawk ih taprong to na sak pathoep o,
  </para>
  <para style="p">
    <verse number="30" style="v" />kaicae loe kaimacae ampanawk ih adung ah kho ka sak o langlacadoeh, tahmaanawk athii palong kaminawk khaeah ka thum o mak ai, tiah na thuih o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nangcae loe tahmaanawk hum kaminawk ih caa ah na oh o, tiah nangmacae hoi nangmacae to hnukung ah na oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nam panawk khosakhaih tuinuen to koi o sak ngala khae.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangcae pahuinawk, nangcae pahui ih caanawk, kawbangmaw hell thung hoiah na loih o thai tih?
  </para>
  <para style="p">
    <verse number="34" style="v" />To pongah khenah, Tahmaanawk, palungha kaminawk hoi ca tarik kaminawk to nangcae khaeah kang patoeh: thoemto kaminawk to na hum o ueloe, thinglam pongah na takhing o tih; thoemto kaminawk loe sineko ah na bop o ueloe, vangpui maeto pacoeng maeto ah na pacaektlaek o tih:
  </para>
  <para style="p">
    <verse number="35" style="v" />tempul hoi hmaicam salakah na hum o ih, katoeng kami Abel hoi Barakiah capa, Zakariah karoek to long nuiah kalong katoeng kaminawk boih ih athii loe nangcae nuiah om tih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Loktang kang thuih o, hae hmuennawk boih loe hae adung ih kaminawk nuiah pha tih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aw Jerusalem, Jerusalem, tahmaanawk humkung hoi nang khaeah patoeh ih kaminawk thlung hoiah vakung, aa amno mah a caanawk pakhraeh tlim ah tapop baktih toengah, na caanawk nawnto tapop hanah vai nazetto maw koehhaih ka tawnh boeh, toe nang mah na koeh ai!
  </para>
  <para style="p">
    <verse number="38" style="v" />Khenah, na im loe angqai krang ah ni oh sut boeh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kang thuih o, Angraeng ih ahmin hoi angzo kami loe tahamhoih, tiah na thui o ai karoek to, vaihi hoi kamgtong kai nang hnuh o mak ai boeh, tiah a naa.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jesu tasa bangah tacawt moe, tempul hoiah a caeh ving: anih han tempul im patuek hanah a hnukbang kaminawk angzoh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu mah nihcae khaeah, Hae hmuennawk boih na hnuk o maw? Loktang kang thuih o, Maeto pacoeng maeto nuiah kamhong thlung maeto doeh haeah om mak ai, va o boih tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih Olive mae nuiah anghnut naah, a hnukbang kaminawk khue anih khaeah angzoh o moe, Hae hmuennawk hae natuek naah maw om tih, nang zohhaih atue hoi long boenghaih tue angmathaih loe kawbangmaw om tih? Na thui ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu mah nihcae khaeah, Mi mah doeh aling han ai ah, acoe oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai ih ahmin hoiah paroeai kaminawk angzo o tih, Kai loe Kri, ni tiah thui o uele, paroeai kaminawk to aling o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Misa angkahhaih hoi misa angtukhaih loknawk to na thaih o tih: toe mawn o hmah: hae hmuennawk boih loe kaom han koi roe ni, toe boenghaih pha mak ai vop.
  </para>
  <para style="p">
    <verse number="7" style="v" />Acaeng maeto hoi maeto misa angcoeng ueloe, prae maeto hoi maeto misa ah om tih: ahmuen kruekah takaang thohhaih, amtang amlaihaih hoi talihnawhaihnawk to om tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hae hmuennawk boih loe palungset amtonghaih ah ni oh vop.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pacaekthlaek moe, paduek hanah minawk ban ah na paek o tih: kai ih ahmin pongah prae kaminawk boih mah na hnuma o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />To tiah oh pacoengah kapop kami loe oepthok ah khosah o mak ai, maeto hoi maeto angphat o taak ueloe, maeto hoi maeto ang hnuma o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angsah cop paroeai tahmaanawk angzo o ueloe, paroeai kaminawk to aling o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zaehaih angpung pongah, paroeai kaminawk ih amlunghaih to amding tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe boeng khoek to pauep kami loe pahlonghaih hnu tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Acaeng kaminawk boih khaeah hnukung ah oh hanah, hae kahoih siangpahrang ukhaih prae tamthanglok hae long pum ah thuih ah om tih; to pacoengah ni boenghaih to pha vop tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah tahmaa Daniel mah thuih ih lok baktih toengah, Hmuenciim ah kangdoe, panuet thok amrohaih hmuen na hnuk o naah, (kroek kami loe thaikophaih tawn nasoe:)
  </para>
  <para style="p">
    <verse number="16" style="v" />Judea prae thungah kaom kaminawk loe mae nuiah cawn o nasoe:
  </para>
  <para style="p">
    <verse number="17" style="v" />imphu ah kaom kami loe a imthung ih hmuen lak hanah anghum tathuk hmah nasoe:
  </para>
  <para style="p">
    <verse number="18" style="v" />lawk ah kaom kami loe a khukbuen lak hanah amlaem let hmah nasoe.
  </para>
  <para style="p">
    <verse number="19" style="v" />To na niah zokpomh nongpatanawk hoi tahnu nae nawkta tawn nongpatanawk loe khosak bing o!
  </para>
  <para style="p">
    <verse number="20" style="v" />Na cawnh o haih atue loe siktue hoi Sabbath niah phak han ai ah lawkthui oh:
  </para>
  <para style="p">
    <verse number="21" style="v" />long oh tangsuek na hoi vaihi khoek to kaom vai ai, natuek naah doeh kaom han ai, paroeai kalen raihaih to om tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />To ih aninawk to duemsak ai nahaeloe, mi kawbaktih doeh loih o mak ai: toe qoih ih kaminawk rang hoiah to ninawk to duemsak tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To naah kawbaktih kami mah doeh, Khenah, Kri loe haeah oh, to tih ai boeh loe ho ah ni oh, tiah na thui o cadoeh, a thuih ih lok to tang o hmah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Angsah cop kri hoi angsah cop tahmaanawk to tacawt o ueloe, angcoeng thaih nahaeloe qoih ih kaminawk mataeng doeh aling hanah, kalen parai angmathaih hoi dawnrai hmuennawk to sah o tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khenah, Kang thuih o coek boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaminawk mah, khenah, anih loe praezaek ah ni oh, tiah na thui o cadoeh, caeh o hmah: khenah, anih loe tamquta hoi imthungah ni oh, tiah na naa o cadoeh, to lok to tang o hmah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ni angyae bang hoiah ni aengh to tacawt moe, niduem bang khoek to aang baktih toeng ah, kami Capa angzoh naah doeh om toeng tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Moi kadueh qok ohhaih ahmuen kruekah, tahmuu prawnnawk nawnto angpop o tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />To baktih paroeai raihaih ninawk oh pacoengah loe, ni to tahmuep tih, khrah loe aang mak ai boeh, cakaehnawk loe van hoiah krah o tathuk ueloe, van thacakhaihnawk to anghuen tih:
  </para>
  <para style="p">
    <verse number="30" style="v" />to pacoengah kami Capa angmathaih van ah amtueng tih: long nui ih acaengnawk boih qah o tih, thacakhaih hoi paroeai lensawkhaih hoiah van ih tamai nuiah angzo kami Capa to nihcae mah hnu o tih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih loe paroeai kalen mongkah lok hoiah angmah ih van kaminawk to patoeh tih, van boenghaih hae bang hoi ho bang khoek to, ahmuen takii palito bang hoiah a qoih ih kaminawk to nihcae mah nawnto pakhueng tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vaihi thaiduetkung patahhaih maeto hae amtuk oh; a tanghang nuiah tadok tacawt moe, aqam tacawt naah, nipui tue loe zoi boeh, tiah na panoek o:
  </para>
  <para style="p">
    <verse number="33" style="v" />to baktih toengah hae hmuennawk boih na hnuk o naah, atue loe zoi boeh, thok taengah ni oh boeh, tito panoek oh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Loktang kang thuih o, Hae hmuennawk boih akoep ai karoek to, hae ih kaminawk hae anghmaa o mak ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Van hoi long anghmaa tih, toe Ka loknawk loe anghmaa mak ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />To ani hoi atue loe mi mah doeh panoek ai, van kaminawk mah doeh panoek ai, Kam pa khue mah ni panoek.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kami Capa angzohhaih loe Noah dung nathuem ih ninawk baktiah om toeng tih.
  </para>
  <para style="p">
    <verse number="38" style="v" />Long tuiuemhaih om ai nathuem hoi kamtong Noah palong thungah akun ai karoek to, nihcae loe naek o moe, caak o, zu lak o moe, zu raenghaih poih to a sak o,
  </para>
  <para style="p">
    <verse number="39" style="v" />tuiuemhaih pha ai karoek to tidoeh panoek o ai, to naah tui mah nihcae to lak boih, kami Capa angzoh naah doeh to tiah om toeng tih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kami long hnetto lawk ah om hoi tih; maeto loe la ving ueloe, maeto loe caehtaak sut tih.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nongpata hnik loe cangdaeng hoi tih; maeto loe la ving ueloe, maeto loe caehtaak sut tih.
  </para>
  <para style="p">
    <verse number="42" style="v" />Natuek naah maw na Angraeng angzo tih, tito na panoek ai, to pongah acoe hoiah zing ah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Toe hae hae panoek oh, im tawnkung mah natuek naah maw kamqu angzo tih, tiah panoek coek nahaeloe, anih mah kahoih ah toep ueloe, im to muksak mak ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />To pongah nangcae doeh amsak o coek ah: kami Capa loe na poek o ai ih atue ah angzo tih.
  </para>
  <para style="p">
    <verse number="45" style="v" />To tiah nahaeloe atue phak naah nihcae buh pacah hanah, angmah ih Angraeng mah a imthung takoh nuiah ukkung ah suek ih, oep kaom moe, palungha tamna loe mi aa?
  </para>
  <para style="p">
    <verse number="46" style="v" />Angmah ih angraeng angzoh naah, a mikhnuk ah toksah tamna loe tahamhoih.
  </para>
  <para style="p">
    <verse number="47" style="v" />Loktang kang thuih o, anih mah to tamna to angmah ih hmuennawk boih ukkung ah suem tih.
  </para>
  <para style="p">
    <verse number="48" style="v" />Toe kahoih ai tamna loe angmah ih palung thungah, Ka Angraeng angzohhaih atue loe akra parai vop tih, tiah poek pongah,
  </para>
  <para style="p">
    <verse number="49" style="v" />angmah ih ampui tamnanawk to boh moe, mu paqui kaminawk hoi nawnto naek caak o:
  </para>
  <para style="p">
    <verse number="50" style="v" />to tamna mah anih angzo tih boeh, tiah poek ai ih ni, panoek ai ih atue ah angmah ih angraeng to angzo nahaeloe,
  </para>
  <para style="p">
    <verse number="51" style="v" />angmah ih angraeng mah a tamna to takroek pat ueloe, qahhaih hoi haakaekhaih ahmuen ah, angsah cop kaminawk hoi nawnto anih to va tih.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Van prae loe hmaiim sin hoi zu la kami dawt hanah kacaeh, tangla cuem haato hoiah anghmong.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae thungah pangatonawk loe palungha o moe, pangatonawk loe amthu o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kamthunawk loe hmaiim to sin o, toe hmaitui sin o ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />toe palungha kaminawk loe hmaitui tabu hoi hmaiimnawk to sinh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zu la kami angzoh han akra pongah, nihcae loe iih angam o moe, iih o boih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Qum taning phak naah loe, Khenah, zu la kami to angzoh boeh; anih dawt hanah caeh oh, tiah hanghaih lok to a thaih o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah tangla cuemnawk boih angthawk o moe, hmaiim to hmai pacen o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamthunawk mah palunghanawk khaeah, hmaitui na paek o thoem ah; kaicae ih hmaiim loe duek ving boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe palunghanawk mah, to tiah na ai ni; nangcae hoi kaimacae hanah khawt mak ai: hmaitui zaw kaminawk khaeah caeh oh loe, nangmacae hanah qan oh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmaitui qan han a caeh o li naah, zu la kami to angzoh; amsakcoek tangla cuemnawk loe zulakung hoi nawnto zu raenghaih poihkung ah caeh o: thok to a khah o.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah kalah tangla kacuemnawk doeh angzoh o toeng, Angraeng, Angraeng, kaicae hanah thok paong raeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe anih mah, Loktang kang thuih o, kang panoek o ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kami Capa angzohhaih ni hoi atue na panoek o ai pongah, amsakcoek hoiah zing oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Van prae loe prae kangthla ah kholong caeh kami maeto mah, a tamnanawk to kawk moe, nihcae khaeah a tawnh ih hmuennawk boih aaphaih hoiah anghmong.
  </para>
  <para style="p">
    <verse number="15" style="v" />A tawnh ih sakthaihaih baktih toengah, kami maeto khaeah phoisa talent pangato a paek, kalah maeto khaeah talent hnetto a paek, kalah maeto khaeah talent maeto a paek; to pacoengah kholong ah a caeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Phoisa talent pangato la kami loe a lak ih phoisa hoiah hmuenmae zawhhaih to sak moe, kamtlai phoisa talent pangato a hnuk.
  </para>
  <para style="p">
    <verse number="17" style="v" />To baktih toengah phoisa talent hnetto la kami doeh kamtlai phoisa talent hnetto hnuk toeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe phoisa talent maeto la kami loe caeh moe, long to takaeh pacoengah, angmah angraeng ih phoisa to a hawk.
  </para>
  <para style="p">
    <verse number="19" style="v" />Atue akra parai pacoengah tamnanawk ih angraeng to angzoh moe, nihcae hoi nawnto tangka to pakoep o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangka talent pangato la kami loe angzoh moe, kamtlai phoisa talent pangato a sinh, Angraeng, phoisa talent pangato nang paek: khenah, kamtlai phoisa talent pangato ka hnuk, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Angmah ih angraeng mah anih khaeah, Hoih, kahoih oepthok tamna nang; hmuen zetta nuiah oepthok ah kho na sak pongah, hmuen zetpui ukkung ah kang suek han: na angraeng anghoehaih thungah akun ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Phoisa talent hnetto la kami doeh angzoh moe, angraeng phoisa talent hnetto nang paek: khenah, kamtlai phoisa talent hnetto ka hnuk, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angmah ih angraeng mah anih khaeah, Hoih, kahoih oepthok tamna nang; hmuen zetta nuiah oepthok ah kho na sak pongah, hmuen zetpui ukkung ah kang suek han: na angraeng anghoehaih thungah akun ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pacoengah phoisa talent maeto la kami to angzoh moe, Angraeng, nang loe karai parai kami ah na oh, na haeh ai ih ahmuen ah na aah moe, na patit ai ih ahmuen ah na lak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang to kang zit pongah, ka caeh moe, na phoisa talent to long thungah ka hawk: khenah, nang ih hmuen loe ho ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angmah ih angraeng mah anih khaeah, Kahoih ai thasae tamna, kai loe ka haeh ai ih ahmuen ah ka aah moe, patit ai ih ahmuen ah ka lak, tito na panoek tangak:
  </para>
  <para style="p">
    <verse number="27" style="v" />kang zoh naah phoisa to acaa kangpung hoi nawnto ka lak hanah, ka phoisa loe phoisa thlaeng kaminawk khaeah na suek han oh bae.
  </para>
  <para style="p">
    <verse number="28" style="v" />To pongah anih khae ih phoisa talent to la oh loe, phoisa talent haato tawn kami khaeah paek oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi kawbaktih doeh katawn kami loe paek ueloe, tawn aep tih: toe katawn ai kami loe a tawnh ih mataeng doeh la pae kik tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Avang ai tamna to khoving tasa bangah va oh: to ah loe qahhaih hoi haakaekhaih to om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kami Capa a lensawkhaih hoi angzoh naah loe, angmah ih kaciim van kaminawk hoi nawnto angzo tih, Anih loe a lensawkhaih angraeng tangkhang nuiah anghnu tih:
  </para>
  <para style="p">
    <verse number="32" style="v" />acaengnawk boih anih hmaa ah amkhueng o tih: tuu toepkung mah maeh thung hoiah angmah ih tuu to tapraek baktih toengah, anih mah kami maeto pacoeng maeto tapraek tih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuunawk to angmah ih bantang bangah suem ueloe, maehnawk to angmah ih banqoi bangah suem tih.
  </para>
  <para style="p">
    <verse number="34" style="v" />To pacoengah Siangpahrang mah a bantang bang ih kaminawk khaeah, Kam Pa mah tahamhoihhaih paek ih kaminawk, angzo oh, long sak tangsuek nathuem hoi nangcae han sak ih siangpahrang ukhaih prae to toep oh:
  </para>
  <para style="p">
    <verse number="35" style="v" />zok kam thlam naah, buh nang paek: tui kang haeh naah, tui nang paek: angvin ah ka oh naah, im ah nang toemsak:
  </para>
  <para style="p">
    <verse number="36" style="v" />bangkrai ah ka oh naah, khukbuen to nang paek: ngan ka nat naah, nang khetzawn: thongim ka krak naah, nang paqaih thuih, tiah naa tih.
  </para>
  <para style="p">
    <verse number="37" style="v" />To pacoengah katoeng kaminawk loe anih khaeah, Angraeng, natuek naah maw zok kamthlam ah kang hnuk o moe, buh kang paek o, natuek naah maw tui kanghae ah kang hnuk o moe, tui kang paek o?
  </para>
  <para style="p">
    <verse number="38" style="v" />natuek naah maw angvin ah kaom nang to kang hnuk o moe, im ah kang toem o sak, natuek naah maw bangkrai ah na oh moe, khukbuen to kang paek o?
  </para>
  <para style="p">
    <verse number="39" style="v" />Natuek naah maw ngan na nathaih to kang hnuk o moe, kang khetzawn o? Natuek naah maw thongim na krak moe, nang khaeah kang paqaih o? tiah anih ih lok to pathim o tih.
  </para>
  <para style="p">
    <verse number="40" style="v" />To naah Siangpahrang mah nihcae khaeah, Loktang kang thuih o, hae ih kathoeng koek nawkamyanawk khaeah na sak o ih hmuen boih loe, kai khaeah na sak o ih hmuen ah ni oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />To pacoengah bangqoi bangah kaom kaminawk khaeah doeh, Nangcae tangoeng ih kaminawk, Kai khae hoi tacawt oh, taqawk hoi anih ih van kaminawk hanah sak ih dungzan hmai thungah caeh oh:
  </para>
  <para style="p">
    <verse number="42" style="v" />zok kam thlam naah, buh nang paek o ai: tui kang haeh naah, tui nang paek o ai:
  </para>
  <para style="p">
    <verse number="43" style="v" />angvin ah ka oh naah, im ah nang toem o sak ai: bangkrai ah ka oh naah, khukbuen nang paek o ai: ngannat moe, thongim ka krak naah, kai khaeah nang paqai o ai pongah ni, tiah naa tih.
  </para>
  <para style="p">
    <verse number="44" style="v" />To naah nihcae mah anih khaeah, Angraeng, natuek naah maw zok nam thlam, to tih ai boeh loe tui nang haeh, to tih ai boeh loe angvin ah na oh, to tih ai boeh loe bangkrai ah na oh, to tih ai boeh loe ngan na nat, to tih ai boeh loe thongim na krakhaih to kang hnuk o moe, kang khenzawn o ai? tiah pathim o tih.
  </para>
  <para style="p">
    <verse number="45" style="v" />To naah anih mah nihcae khaeah, Loktang kang thuih o, hae ih kathoeng koek nawkamyanawk nuiah na sah o ai ih hmuen loe kai khaeah na sah o ai ih hmuen ah ni oh, tiah pathim tih.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nihcae loe dungzan patangkhanghaih ahmuen ah caeh o tih, toe katoeng kaminawk loe dungzan hinghaih thungah akun o tih.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu mah hae loknawk thuih pacoengah, a hnukbang kaminawk khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />ni hnetto pacoeng ah misong loihhaih poih om tih, tito na panoek o, to naah kami Capa thinglam pong takhing hanah paek o tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah kalen koek qaimanawk, ca tarik kaminawk, kacoehtanawk, Kaiapha, tiah kawk ih kalen koek qaima im ah amkhueng o,
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu to zoek moe, naeh o pacoengah, hum hanah a thuih o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toe poihsakhaih niah sah hmah si, to tih ai nahaeloe rangpui palungpuihaih om moeng tih, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu loe Bethany vang ah kaom, ngansae maan Simon im ah oh naah,
  </para>
  <para style="p">
    <verse number="7" style="v" />atho kana parai hmuihoih tabu kasin nongpata maeto anih khaeah angzoh moe, anih buhcaak han anghnut naah lu nuiah a bawh pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hnukbang kaminawk mah hnuk o naah, palungphui o moe, tikhoe avang ai ah hae tiah a kraih vai?
  </para>
  <para style="p">
    <verse number="9" style="v" />Atho kana ah hmuihoih tui to zawh moe, amtang kaminawk hanah phoisa to a paek han oh, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah to tiah kaom hmuen to panoek naah, Tih hanah nongpata to na tavet o khing loe? Anih loe ka nuiah kahoih hmuen ni a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangcae loe amtang kamminawk hoi nawnto na oh o toepsoep: toe kai loe nangcae hoi ka om poe mak ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nongpata mah ka nuiah bawh ih hmuihoih tui loe Kai aphum hanah sak ih hmuen ah ni oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Loktang kang thuih o, Long pum ah hae kahoih tamthanglok thuih kruek, hae nongpata mah ka nuiah sak ih hmuen doeh anih panoek poehaih hanah thui o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To naah a hnukbang hatlai hnetto thungah Judah Isakariot, tiah kawk ih kami maeto loe, kalen koek qaima khaeah caeh moe,
  </para>
  <para style="p">
    <verse number="15" style="v" />nihcae khaeah, Anih to kang paek nahaeloe timaw nang paek o han? tiah a naa. To naah nihcae mah anih khaeah phoisa quithumto paek hanah palungdue o.
  </para>
  <para style="p">
    <verse number="16" style="v" />To nathuem hoi kamtong anih mah Jesu naeh thai han ih atue kahoih to pakrong boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Taeh thuh ai misong loihhaih poih nito naah loe, a hnukbang kaminawk Jesu khaeah angzoh o moe, nang hanah misong loihhaih poih hae naah maw saksak han na koeh? tiah a naa o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah, Vangpui thung ih kami maeto khaeah caeh oh loe, anih khaeah, Patukkung mah Kai ih atue loe zoi boeh; ka hnukbang kaminawk hoi nang im ah Misong loihhaih poih ka sak han, tiah a thuih, tiah thui pae oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu mah thuih ih lok baktih toengah a hnukbang kaminawk mah, Misong loihhaih poih to sak o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Duembang phak naah, anih loe buhcaak hanah kami hatlai hnettonawk hoi nawnto anghnut.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nihcae buhcaak o naah anih mah, Loktang kang thuih o, nangcae thung ih kami maeto mah kai angphat taak tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />To naah nihcae loe palungset o moe, kami boih mah anih khaeah, Angraeng, kai maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih mah, Kai hoi nawnto sabae tapawh kami mah, kai angphat taak tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kami Capa loe angmah kawng tarik ih baktih toengah caeh tih: toe kami Capa angphat taak kami loe khosak bing! To kami loe tapen ai ah om nahaeloe hoi kue tih, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih angphat taak kami, Judah mah, Rabbi, kai maw? tiah a naa. To naah anih mah, Na thuih ih baktih toengah nang ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nihcae buhcaak o nathuem ah, Jesu mah takaw to lak moe, tahamhoihhaih paek pacoengah, a aeh, a hnukbang kaminawk khaeah a paek, la oh loe, caa oh: hae loe ka taksa ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pacoengah boengloeng to a lak moe, kawnhaih lawkthuih pacoengah, nihcae khaeah a paek, nae o boih ah;
  </para>
  <para style="p">
    <verse number="28" style="v" />hae loe pop parai kaminawk ih zae tahmen hanah kalong, lokkamhaih kangtha, ka thii ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kang thuih o, Vaihi hoi kamtong Pa ih prae ah nangcae hoi nawnto kangtha naekhaih ni pha ai karoek to, hae misurtui hae ka nae mak ai boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Laa maeto a sak o pacoengah, Olive mae ah a caeh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu mah nihcae khaeah, Tuutoep kami to ka boh han, tuunawk loe ahmuen kalah ah ampraek o phang tih, tiah tarik baktih toengah, kai pongah vaiduem poekhaih nam ro o boih tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe kang thawk let pacoengah, nangcae hmaa ah Kalili ah ka caeh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Piter mah anih khaeah, Nang pongah minawk poek amro o boih cadoeh, kai loe natuek naah doeh poek amro mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah anih khaeah, Loktang kang thuih, vaiduem aakhong ai naah, vai thumto kai nang phat taak tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />Piter mah anih khaeah, Nang hoi nawnto duek han om cadoeh, nang to kang phat taak mak ai, tiah a naa. A hnukbang kaminawk mah doeh to tiah thuih o boih.
  </para>
  <para style="p">
    <verse number="36" style="v" />To pacoengah Jesu loe Gethsemane, tiah kawk ih ahmuen ah a hnukbang kaminawk hoi caeh o, a hnukbang kaminawk khaeah, haeah anghnu oh, ho ah lawkthuih han ka caeh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Piter hoi Zebedi capa hnik to a caeh haih, anih loe palungset moe, paroeai dawnraihaih hoiah oh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Anih mah nihcae khaeah, Ka hinghaih pakhra loe duek han khoek to palungset parai; haeah om oh loe nawnto na hak o haih ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih loe ahmuen kangthla kue ah caeh moe, mikhmai long ah akuep, Aw Pa, angcoeng thai nahaeloe, hae boengloeng hae kai khae hoi takhoe ving ah: toe ka koehhaih baktih na ai ah, na koehhaih baktiah om nasoe, tiah lawk a thuih.
  </para>
  <para style="p">
    <verse number="40" style="v" />A hnukbang kaminawk khaeah a caeh naah, ka-iip nihcae to a hnuk, Piter khaeah, atue maeto thung mataeng doeh nang hak o haih thai ai maw?
  </para>
  <para style="p">
    <verse number="41" style="v" />Pacuekhaih thungah na kun o han ai ah, Hak oh loe, lawkthui oh: pakhra mah loe koeh, toe taksa loe thazok, tiah a naa.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anih loe caeh let moe, Aw Pa, hae boengloeng hae kai khae hoiah ni takhoe ving thai ai moe, ka naek hanah om khruek nahaeloe, na koehhaih baktiah om nasoe, tiah lawk a thuih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih angzoh let naah, iih kangmue khaang o ai pongah, ka-iip nihcae to a hnuk let bae.
  </para>
  <para style="p">
    <verse number="44" style="v" />To pongah nihcae to a caeh taak moe, vai thumto haih, to tiah lawk a thuih let bae.
  </para>
  <para style="p">
    <verse number="45" style="v" />To pacoengah a hnukbang kaminawk khaeah a caeh, nihcae khaeah, Vaihi khoek to nang song o moe, na iih o vop maw? Khenah, Kami Capa to angphat taak moe, kazae kaminawk ban ah paekhaih atue loe zoi boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="46" style="v" />Angthawk oh, caeh o si boeh: khenah, kai angphat taak kami loe angzoh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="47" style="v" />Anih lokthuih li naah, khenah, hatlai hnetto thung ih maeto, Judah to angzoh, kalen koek qaima hoi rangpui kacoehtanawk mah patoeh ih, pop parai kaminawk loe haikaek hoi thingboengnawk to sin o moe, angzoh o.
  </para>
  <para style="p">
    <verse number="48" style="v" />Anih angphat taak kami mah nihcae hanah angmathaih to paek, Ka mok ih kami loe, Anih to boeh ni; anih to naeh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="49" style="v" />Judah loe Jesu khaeah caeh phrat moe, Patukkung, tiah lok tapring pacoengah, Anih to a mok.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu mah anih khaeah, Ampui, tih sak han ih maw nang zoh? tiah a naa. To naah kaminawk angzoh o moe, Anih to naeh o pacoengah, a caeh o haih.
  </para>
  <para style="p">
    <verse number="51" style="v" />To naah khenah, Jesu hoi nawnto kaom kaminawk thung ih maeto loe a ban to phok moe, a sumsen to azuh pacoengah, kalen koek qaima tamna ih naa to takroek pae pat.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jesu mah anih khaeah, angmah ih ahmuen ah na sumsen to suem ah: mi kawbaktih doeh sumsen sin kami loe suemsen hoiah dueh tih.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kai paek hanah misatuh abu hatlai hnetto pongah kapop van kaminawk to Pa khaeah vaihi ka hni thai mak ai, tiah na poek o maw?
  </para>
  <para style="p">
    <verse number="54" style="v" />Toe to tiah om nahaeloe, cabu thungah hae tiah om tih, tiah thuih ih lok to kawbangah maw akoep thai tih? tiah a naa.
  </para>
  <para style="p">
    <verse number="55" style="v" />To nathuem ah Jesu mah pop parai kaminawk khaeah, Kai hae kamqu baktiah naeh han ih maw, sumsen hoi thingboengnawk hoiah nang zoh o? Tikhoe ni thokkruek tempul thungah nangcae hoi nawnto kang hnut moe, kaminawk ka patuk naah nang naeh o ai loe?
  </para>
  <para style="p">
    <verse number="56" style="v" />Toe tahmaanawk mah tarik ih cabu akoep han ih ni hae hmuen hae oh, tiah a naa. To pacoengah a hnukbang kaminawk mah anih to angphat o taak moe, cawnh o taak boih.
  </para>
  <para style="p">
    <verse number="57" style="v" />Jesu naeh kaminawk mah anih to ca trik kaminawk hoi kacoehtanawk amkhuenghaih, kalen koek qaima, Kaiapha im ah caeh o haih.
  </para>
  <para style="p">
    <verse number="58" style="v" />Toe Piter loe qaima im khoek to ahmuen kangtla hoiah anih hnukah bang, kawbangah maw a sak o, tiah panoek hanah, a thungah akun moe, imtoep tamnanawk hoi nawnto anghnut.
  </para>
  <para style="p">
    <verse number="59" style="v" />Qaimanawk, kacoehtanawk hoi lokcaekungnawk boih mah Jesu hum hanah, sak pazaehaih to pakrong o;
  </para>
  <para style="p">
    <verse number="60" style="v" />toe tidoeh hnu o ai: ue, zae netkung paroeai angzoh o, toe nihcae mah zaehaih tidoeh hnu o ai. Hnukkhuem koek ah loe amsawn zaehaih hnukung hnetto angzoh moe,
  </para>
  <para style="p">
    <verse number="61" style="v" />hae kami mah, Sithaw ih tempul hae ka phraek moe, ni thumto thungah ka sak thaih, tiah thuih, tiah a thuih hoi.
  </para>
  <para style="p">
    <verse number="62" style="v" />To naah kalen koek qaima to angthawk moe, anih khaeah, lok nang pathim mak ai maw? Hae hnukung hnik mah zae nethaih loe kawbangah maw oh? tiah a naa.
  </para>
  <para style="p">
    <verse number="63" style="v" />Toe Jesu loe angam duem. Qaima mah anih khaeah, Kahing Sithaw ih ahmin palawkhaih hoiah lok kang dueng, nang loe Sithaw Capa, Kri maw? Na thui ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="64" style="v" />Jesu mah anih khaeah, Na thuih ih baktih toengah ka oh: toe nang khaeah lok ka thuih, hmabang ah loe Thacak bantang bangah kanghnu, tamai nui hoiah angzo Kami Capa to na hnu tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="65" style="v" />To naah kalen koek qaima mah angmah ih kahni to asih moe, Anih mah Sithaw to kasae thuih boeh; aicae mah kalah hnukungnawk timaw angaihaih oh vop? Khenah, a thuih ih Sithaw padaenghaih lok to vaihi na thaih o boeh.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kawbangah maw na poek o? tiah a naa. Nihcae mah, Anih loe duek han krah zaehaih a tawnh, tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="67" style="v" />Nihcae mah a mikhmai ah tamtui hoi pathoih o moe, anih to thong o; thoemto kaminawk mah anih to tabaeng o,
  </para>
  <para style="p">
    <verse number="68" style="v" />nang Kri, mi mah maw ang boh? Na thui ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="69" style="v" />Piter loe im tasa bangah anghnut: to naah nongpata maeto anih khaeah angzoh moe, nang doeh Kalili prae ih Jesu hoi nawnto na oh toeng bae, tiah a naa.
  </para>
  <para style="p">
    <verse number="70" style="v" />Toe Piter mah nihcae boih hma ah angphat, timaw na thuih ka panoek ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="71" style="v" />Im hmabang ih khongkha ah a caeh naah, kalah nongpata maeto mah anih to hnuk, nongpata mah to ah kaom kaminawk khaeah, Hae kami doeh Nazareth Jesu hoi nawnto oh, tiah a thuih.
  </para>
  <para style="p">
    <verse number="72" style="v" />To naah anih mah, To kami to ka panoek ai, tiah lokmaihaih hoiah angphat taak let.
  </para>
  <para style="p">
    <verse number="73" style="v" />Akra ai ah to ah angdoe kaminawk anih khaeah angzoh o moe, Piter khaeah, nang doeh nihcae thung ih kami maeto ah ni na oh; na paeh ih lok pongah amnoek boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="74" style="v" />To naah anih mah, To kami to ka panoek ai, tiah tangoenghaih hoiah lokkamhaih to a sak. To pacoengah loe aa to khong roep.
  </para>
  <para style="p">
    <verse number="75" style="v" />Jesu mah, aakhong ai naah, vai thumto kai nang phat taak tih, tiah thuih ih lok to Piter mah panoek. To pongah tasa bangah a caeh moe, palungset loiah a qah.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khawnbang phak naah loe, kalen koek qaima hoi rangpui kacoehtanawk boih amkhueng o moe, Jesu hum hanah lok aram o:
  </para>
  <para style="p">
    <verse number="2" style="v" />anih to taoengh o pacoengah, hoih o moe, prae ukkung Pilat khaeah paek o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih angphat taak, Judah mah Jesu hum hanah lokkhaeh o boeh, tiah panoek naah, dawnpakhuem moe, phoisa quithumto to qaima hoi kacoehtanawk khaeah a sin let,
  </para>
  <para style="p">
    <verse number="4" style="v" />ka sakpazae boeh, zaehaih tawn ai kami ih athii to kang phat taak moeng boeh, tiah a thuih. Nihcae mah, Kaicae hoi timaw asaenghaih oh? Nang mah kaa boeh ni, tiah a naa o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judah mah phoisa to tempul thungah vah moe, caehtaak ving pacoengah, angmah hoi angmah to amhnawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kalen koek qaima mah phoisa to lak moe, athii tho ah oh pongah, phoisa patunghaih thungah suek han ciim ai, tiah thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae mah lok aram o pacoengah, kadueh angvinnawk aphum hanah, to phoisa hoiah long laom sahkung ih lawk to a qan o.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah to lawk to, Athii lawk, tiah vaihni ni khoek to kawk o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahmaa Jeremiah mah, Israel caanawk loe anih hoi katingah khaeh o ih, phoisa quithumto lak o moe,
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng mah paek ih lok baktih toengah, nihcae mah long laom sahkung ih lawk qan hanah patoh o, tiah thuih ih lok to akoep boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu prae ukkung hmaa ah angdoet naah, prae ukkung mah anih to lokdueng: nang loe Judahnawk ih siangpahrang maw? tiah a naa. To naah Jesu mah anih khaeah, Na thuih ih baktih toengah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kalen koek qaihma hoi kacoehtanawk mah zaehaih net o naah, lok pakha to doeh pathim pae ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilat mah anih khaeah, Na zaehaih net kami hnukung nazetto maw oh o, tito na thai ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe anih mah lok pakha to doeh pathim pae ai; to pongah prae ukkung loe paroeai dawnrai.
  </para>
  <para style="p">
    <verse number="15" style="v" />To poih thungah rangpui mah koeh ih thongkrah kami maeto, ukkung mah prawt pae han ih atawk to oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />To nathuem ah ahmin kamthang Barabba, tiah kawk ih thongkrah kami loe thongim thungah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah rangpuinawk nawnto amkhueng o naah, Pilat mah mi maw kang prawt pae o han? Barabba maw, to tih ai boeh loe Kri, tiah kawk ih Jesu? tiah dueng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih nuiah uthaih tawnh o pongah ni Jesu anih khaeah thak o, tito Pilat mah panoek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pilat lokcaekhaih tangkhang nuiah anghnut naah, to Katoeng Kami nuiah tidoeh sah hmah, tiah a zu mah lokpat pae, anih pongah vaihni ih amang ah paroeai ka patangh, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe kalen koek qaima hoi kacoehtanawk mah, Barabba to prawt moe, Jesu hum hanah rangpuinawk to pacuek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Prae ukkung mah nihcae khaeah, kami hnetto thungah mi maw kang prawt pae o han? tiah dueng. To naah nihcae mah, Barabba, tiah a naa o.
  </para>
  <para style="p">
    <verse number="22" style="v" />To tiah nahaeloe Kri, tiah kawk ih Jesu loe kawbangah maw ka sak han? tiah Pilat mah dueng. Nihcae boih mah anih khaeah, Anih loe thinglam pongah takhing ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Prae ukkung mah, Tipongah, tih zaehaih maw a sak loe? tiah a naa. Toe nihcae mah, Anih to thinglam pongah takhing ah, tiah kanung aep ah hang o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kawbangah doeh pazawk thai ai boeh, angpop kaminawk set aep hanah ni oh boeh, tiah Pilat mah panoek naah, tui to lak moe, rangpui hma ah ban amsaeh, kai loe hae katoeng Kami ih athii pongah zaehaih ka tawn ai: nangmacae kaa boeh ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rangpuinawk boih mah, Anih ih athii loe kaicae nui hoi ka caanawk nuiah om nasoe, tiah pathim o.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pongah Barabba to nihcae khaeah prawt pae: anih mah Jesu to boh pacoengah, thinglam pongah takhing hanah nihcae khaeah paek.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pongah prae ukkung ih misa toep kaminawk mah Jesu to impui thungah caeh o haih, misa toep kaminawk boih anih taengah angpop o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kahni to khring pae o moe, kahni kathim to angkhuk o sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Soekhring lumuek to lu ah angmuet o sak moe, cunghet to bantang ban ah sin o sak: anih hma ah cangkrawn pae o moe, pahnui o thuih, Judah Siangpahrang! tiah a naa o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih to tamtui hoi pathoih o, cunghet to lak pae o moe, a lu ah boh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />To tiah pahnui o thuih pacoengah, kahni khring pae o moe, angmah ih kahni to angkhuk o sak let, to pacoengah thinglam pongah takhing hanah caeh o haih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nihcae caeh o naah, Cyrene ah kaom Simon, tiah kawk ih kami to a hnuk o: anih to thinglam aput o sak nganga.
  </para>
  <para style="p">
    <verse number="33" style="v" />Luhuh ahmuen, tiah thuih o ih Golgotha a phak o naah loe,
  </para>
  <para style="p">
    <verse number="34" style="v" />kakhaa tui hoi abaeh ih misurtui kathaw to naek o sak: pataeng naah anih mah naek han koeh ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nihcae mah anih to thinglam pongah takhing o moe, taham khethaih phoisa vah o pacoengah, anih ih kahni to amzet o: taham khethaih phoisa vah o moe, kai ih kahni to amzet o, tiah tahmaa mah thuih ih lok to akoep han ih ni to tiah oh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nihcae loe anghnut o moe, anih to toep o;
  </para>
  <para style="p">
    <verse number="37" style="v" />a lu nuiah, HAE LOE JUDAH SIANGPAHRANG JESU, tiah zae nethaih ca to tarik o moe, takhing pae o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kamqu hnetto doeh, maeto bantang bang, maeto banqoi bangah, anih hoi nawnto thinglam pongah takhing o.
  </para>
  <para style="p">
    <verse number="39" style="v" />To ahmuen a taengah caeh kaminawk mah Anih to padaeng o, lu haek o thuih moe,
  </para>
  <para style="p">
    <verse number="40" style="v" />tempul to phraek moe, ni thumto thungah sah let thaih kami, nangmah hoi nangmah to amhlong ah! Sithaw Capa ah na oh nahaeloe, thinglam nui hoiah anghum tathuk khae, tiah a naa o.
  </para>
  <para style="p">
    <verse number="41" style="v" />Qaima, ca tarik kaminawk hoi kacoehtanawk mah doeh to tiah naa o toeng.
  </para>
  <para style="p">
    <verse number="42" style="v" />Minawk kalah loe pahlong, angmah hoi angmah loe amhlong thai ai. Israel Siangpahrang ah na oh nahaeloe, vaihi thinglam nui hoiah anghum nasoe, to tiah nahaeloe anih to ka tang o han.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih mah Sithaw oephaih ka tawnh, tiah thuih; Sithaw mah anih koehhaih tawn nahaeloe, anih to vaihi pahlong nasoe: Kai loe Sithaw Capa ni, tiah a thuih na ai maw, tiah a naa o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Angmah hoi nawnto thinglam nuiah takhing ih kamqu hnik mah doeh, to tiah a naa hoi toeng.
  </para>
  <para style="p">
    <verse number="45" style="v" />Atue tarukto hoi takawt karoek to long pum ah khoving.
  </para>
  <para style="p">
    <verse number="46" style="v" />Atue takawtto naah Jesus loe Eli, Eli, lama sabaktha ni, tiah tha hoiah hangh, a thuih koehhaih loe, Ka Sithaw, Ka Sithaw, tipongah nang caehtaak ving loe, tih haih ih ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />To ahmuen ah angdoe thoemto kaminawk mah to lok to thaih o naah, Hae kami mah Elijah to kawk, tiah thuih o.
  </para>
  <para style="p">
    <verse number="48" style="v" />Nihcae thung ih kami maeto mah cawnh moe, laprawn kanaem to lak, kathaw misurtui thungah a nup, cunghet pongah takaek pacoengah, naek hanah Jesu to a paek.
  </para>
  <para style="p">
    <verse number="49" style="v" />To ah kaom kaminawk mah, angmah koeh ah om nasoe, anih pahlong hanah Elijah angzo tih vai, khen o noek si, tiah thui o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu tha hoiah hangh let, to naah hinghaih qui to apet.
  </para>
  <para style="p">
    <verse number="51" style="v" />To naah khenah, tempul thungah payang ih kahni loe tadong hoi takung khoek to hnetto ah angsih; talih hnawh moe, lungsongnawk doeh koih o;
  </para>
  <para style="p">
    <verse number="52" style="v" />taprongnawk am-ongh o moe, pop parai kadueh kaciim kaminawk ih takpum to angthawk o;
  </para>
  <para style="p">
    <verse number="53" style="v" />Anih angthawk pacoengah nihcae loe taprong thung hoiah angthawk o, kaciim vangpui thungah caeh o moe, paroeai kaminawk khaeah amtueng pae o.
  </para>
  <para style="p">
    <verse number="54" style="v" />Misa toep angraeng hoi Jesu toep a taengah kaom kaminawk mah talihnawhaih hoi to ah kaom hmuennawk to hnuk o naah, paroeai zit o moe, Hae kami loe Sithaw Capa tangtang ni, tiah thuih o.
  </para>
  <para style="p">
    <verse number="55" style="v" />Kalili ah Jesu hnukbang kami, anih khenzawn kami pop parai nongpatanawk doeh to ah oh o, ahmuen kangthla hoiah a khet o:
  </para>
  <para style="p">
    <verse number="56" style="v" />nihcae thungah Meri Magdalene, Jakob, Joseph amno Meri hoi Zebedi caanawk ih amno cae to oh o.
  </para>
  <para style="p">
    <verse number="57" style="v" />Duembang phak naah loe, Jesu hnukbang kami maeto, Joseph, tiah ahmin kaom, Arimathea avang ih angraeng maeto angzoh:
  </para>
  <para style="p">
    <verse number="58" style="v" />anih mah Pilat khaeah caeh moe, Jesu ih qok to hnik, to pacoengah Pilat mah Jesu ih qok anih khaeah paek hanah lok a paek.
  </para>
  <para style="p">
    <verse number="59" style="v" />Joseph mah Jesu ih qok to lak moe, kaciim puu kahni hoiah ayaw pacoengah,
  </para>
  <para style="p">
    <verse number="60" style="v" />thlung pongah thuuk ih, kangtha angmah ih taprong thungah pasongh: taprong to kalen parai thlung hoiah kraeng moe, a caehtaak.
  </para>
  <para style="p">
    <verse number="61" style="v" />Meri Magdalene hoi kalah maeto Meri loe taprong hma ah anghnut hoi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Amprikcaihaih ni to boeng moe, khawnbang phak naah loe, kalen koek qaima hoi Farasinawk Pilat khaeah caeh o,
  </para>
  <para style="p">
    <verse number="63" style="v" />Angraeng, to aling thaih kami loe a hing naah, ni thumto pacoengah kang thawk let han, tiah thuih ih lok to ka pahnet o ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="64" style="v" />To pongah ni thumto karoek to taprong kahoihah toep o hanah lokpaek ah, to tih ai nahaeloe a hnukbang kaminawk mah aqum ah caeh o ueloe, qok to paqu o ving tih, to pacoengah kaminawk khaeah anih loe duekhaih thung hoi angthawk let boeh, tiah thui o tih: to naah hnukkhuem sakpazaehaih loe hmaloe ih pongah nung kue tih, tiah a naa o.
  </para>
  <para style="p">
    <verse number="65" style="v" />Pilat mah nihcae khaeah, Katoep misatuh kami na suek o boeh to loe: caeh oh loe, na sak o thai thung taprong to kahoihah toep o sak khae, tiah a naa.
  </para>
  <para style="p">
    <verse number="66" style="v" />Nihcae caeh o moe, taprong to kahoihah sak o, thlung nuiah angmathaih tacik to daeng o pacoengah, katoep misatuh kaminawk to suek o.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sabbath ni boeng moe, zarhto thung ih ni hmaloe koek khawnthaw ah, Meri Magdalene hoi kalah maeto Meri loe taprong khet hanah caeh hoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenah, to naah thacak parai talih hnawhhaih to oh: Angraeng ih van kami maeto van hoiah anghum tathuk, taprong ah angzoh moe, taprong kraenghaih thlung to takhoe pacoengah, a nuiah anghnut.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih ih krang loe ni aengh baktiah ampha, anih ih kahni loe dantui baktiah anglung:
  </para>
  <para style="p">
    <verse number="4" style="v" />taprong toep kaminawk loe anih to zit loiah tasoeh o moe, kadueh kami baktiah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Van kami mah nongpata hnik khaeah, Zii hoi hmah: thinglam pongah takhing ih, Jesu na pakrong hoi tito ka panoek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih loe haeah om ai: a thuih ih lok baktih toengah, anih loe angthawk boeh. Angzo ah loe, Angraeng pasonghaih ahmuen hae khen hoih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karangah caeh hoih loe, a hnukbang kaminawk khaeah anih loe duekhaih thung hoi anghtawk boeh: khenah, anih loe nangcae hma ah Kalili ah caeh, to ah anih to na hnu o tih: khenah, kang thuih hoi boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihnik loe zithaih hoi oephaih hoiah taprong hoi karangah caeh hoi moe, a hnukbang kaminawk khaeah thuih pae hanah a cawnh hoi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hnukbang kaminawk khaeah lokthuih hanah a caeh hoi li naah, khenah, Jesu mah nihnik to tongh, Anghoe hoiah, tiah a naa. Anih khaeah a caeh hoi moe, a khok patawnh pae hoi pacoengah, anih to a bok hoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah nihnik khaeah, Zii hoi hmah: Kai ih nawkamyanawk Kalili ah caeh o hanah thui pae hoih, to ah Kai na hnu o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihnik loklam ah caeh hoi li naah, khenah, taprong toep thoemto kaminawk loe vangpui ah caeh o moe, kalen koek qaima khaeah to ah kaom hmuennawk to thuih pae o boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Qaimanawk hoi kacoehtanawk loe nawnto amkhueng o, lok aram o pacoengah misatuh kaminawk hanah pop parai phoisa a paek o,
  </para>
  <para style="p">
    <verse number="13" style="v" />nangcae mah aqum ah Anih hnukbang kaminawk angzoh o moe, ka iih o li naah Anih to paquk o ving, tiah thui oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Prae ukkung mah hae lok hae thaih nahaeloe, na loih o thai hanah anih to kang patloep pae o han hmang, tiah a naa o.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah misatuh kaminawk mah phoisa to lak o moe, nihcae mah thuih pae ih lok baktih toengah a thuih o: vaihni ni khoek to Judahnawk salakah to lok to thuih o vop.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah a hnukbang hatlai hnettonawk loe Jesu mah nihcae khaeah thuih pae ih, Kalili prae mae nuiah caeh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />A hnukbang kaminawk mah Anih to hnuk o naah, a bok o: toe thoemto kaminawk loe palunghaenghaih tawnh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu nihcae khaeah angzoh moe, Van hoi long ah sakthaihaih boih loe Kai hanah paek boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pongah caeh oh loe, acaengnawk boih to patuk oh, nihcae to Ampa, Capa, Kacai Muithla ih ahmin hoiah tuinuemhaih to paek oh:
  </para>
  <para style="p">
    <verse number="20" style="v" />kang thuih o ih loknawk boih nihcae mah pazui o thai hanah patuk oh: khenah, long boeng khoek to, nangcae hoi nawnto ka oh, tiah a naa. Amen.
  </para>
</usx>
