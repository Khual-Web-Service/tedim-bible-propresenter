<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PSA" style="id">Saam</book>
  <para style="h">Saam</para>
  <para style="toc1">Saam</para>
  <para style="toc2">Saam</para>
  <para style="mt">Saam</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Katoeng ai kaminawk ih thuitaekhaih thungah caeh ai, kazae kaminawk ih loklam ah doeh angdoe ai moe, pahnuithuih kaminawk anghnuthaih ahmuen ah anghnu ai kami,
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah paek ih lok pongah anghoehaih tawn kami, Angraeng mah paek ih lok khoving khodai poek toepsoep kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih loe tuipuinawk taengah thling moe, atue phak naah athai, aqam zaek vai ai thing hoiah anghmong; to kami loe a sak ih hmuen boih ah hmacawn tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Katoeng ai kaminawk loe to tiah om o ai; nihcae loe takhi mah hmuh phaeng ih canghii baktiah ni oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah katoeng ai kaminawk loe lokcaekhaih ahmuen ah angdoe o thai mak ai, kazae kaminawk doeh katoeng kaminawk amkhuenghaih ahmuen ah athum o thai mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng loe katoeng kaminawk ih loklam to panoek; katoeng ai kaminawk ih loklam loe amro tih.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tipongah Sithaw panoek ai kaminawk loe palungphui o moe, kaminawk loe avang ai hmuen to poek o?
  </para>
  <para style="p">
    <verse number="2" style="v" />Long siangpahrangnawk hoi ukkungnawk loe nawnto amkhueng o moe, Angraeng hoi anih mah situi bawh tangcae kami ih lok to aek o,
  </para>
  <para style="p">
    <verse number="3" style="v" />nihcae ih qui to taprawt pae pat si loe, nihcae ih sumqui doeh vaa pae o ving si, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vannawk ah anghnu kami loe pahnui tih: Angraeng mah nihcae to pahnuithui tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah anih mah nihcae to palungphuihaih hoiah thuitaek ueloe, kana parai koeh koi kaom ai anghmang thok khosakhaih to phasak tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe kaimah ih kaciim Zion mae nuiah, kaimah ih siangpahrang to kang hnutsak boeh, tiah anih mah thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng mah ang thuih ih lok to ka thuih han; nang loe ka Capa ni; nang loe vaihniah kang tapen boeh, tiah ang naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na hniah, to tih nahaeloe Sithaw panoek ai kaminawk to nang han qawk ah kang paek han, nihcae loe longboeng khoek to nang ih qawk ah om o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae to sumboeng hoiah na uk ueloe, long laom pakhoih phaeng baktih toengah, nihcae to na vaa phaeng tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pongah nangcae siangpahrangnawk, Palungha oh loe, long ukkungnawk thuitaekhaih lok to tahngai oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zithaih palungthin hoiah Angraeng ih tok to sah oh loe, tasoeh takuenhaih hoiah anghoe oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Capa to mok oh, to tih ai nahaeloe Anih palungphui ueloe, nang loe loklam hoiah nang hmaa ving tih, anih loe palungphui cadoeh akra mak ai. Anih nuiah amha kaminawk boih loe tahamhoih o.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, kai raihaih paek misanawk loe paroeai pop o! Nihcae loe pop o parai pongah, kai hae misa ah ang suek o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaminawk mah, Sithaw mah anih to angsak haih mak ai, tiah ang naa o. Selah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe aw Angraeng, nang loe ka buephaih, ka lensawkhaih ah na oh moe, kai ih lu atoengh tahang kami ah na oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng khaeah tha hoi ka hang naah, anih mah angmah ih kaciim mae nui hoiah ka lok ang pathim. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kang song moe, ka iih; Angraeng mah ang patawnh pongah, kang thawk let.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai takui khoep, ka misa sang hatonawk to ka zii mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, angthawk ah; Aw ka Sithaw, na pahlong ah: ka misanawk ih akam huh to nang boh pae moe, Sithaw panoek ai kaminawk ih haa to nam rosak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pahlonghaih loe Sithaw ih ni; na tahamhoihaih loe nangmah ih kaminawk nuiah om nasoe. Selah.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka toenghaih Sithaw, kang kawk naah na oi pae ah: dawnraihaih hoi ka oh naah monghaih nang paek; lawk ka thuih naah, tahmenhaih hoiah nang tahngaih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw kaminawk, ka lensawkhaih hae nasetto maw azat nang paw o sak han vop? Nasetto maw avang ai hmuen to na palung o moe, lok amlaihaih na pakrong o han vop? Selah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe Sithaw panoek kami loe Sithaw mah Angmah hanah pahoe boeh, tiah panoek oh: anih to ka kawk naah Angraeng mah na pathim tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tasoeh takuenhaih hoi om oh loe, zaehaih sah o hmah: iihkhun nuiah nang song naah, anghngai o duem ah loe, palung hoiah khopoek oh. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katoeng hmuenpaekhaih to sah oh loe, Angraeng to oep oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi mah maw aicae han kahoih hmuen patuek tih? tiah thui kami paroeai oh. Angraeng, na mikhmai aanghaih to kaicae nuiah amtuengsak ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cang to hak o moe, misurthaih hak o nathuem ih nihcae anghoehaih pongah doeh, ka palung thungah anghoehaih pop kue ah nang suek pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai loe monghaih hoiah kang song moe, ka iih han boeh: Angraeng, nang mah khue ni, ngan nang cuemsak.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, ka loknawk hae tahngai ah loe, ka hanghaih lok hae na poek paeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka siangpahrang hoi ka Sithaw, lawk kang thuih baktih toengah, ka hanghaih lok hae na tahngai pae ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng, akhawn bangah ka lok nang tahngai pae; akhawn bangah, kang khet tahang moe, lawk ka thuih han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang loe zae sakhaih bangah anghoe haih Sithaw na ai ni: kasae kami loe nang hoi nawnto om mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamthu loe na hmaa ah angdoe thai mak ai: hmuen sahpazae kaminawk boih to na hnukma.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amsawnlok thui kaminawk to nam rosak; athii anghae kami hoi aling thaih kaminawk loe Sithaw mah panuet.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe kai loe pop parai na palungnathaih hoiah na imthung ah kang zoh han; nang khingyahaih hoiah na tempul kaciim thungah kang bok han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, ka misanawk oh o pongah, na toenghaih bangah na hoi ah; ka hmaa ah na loklam to patoengh ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae ih pakha ah oephaih om ai; nihcae poekhaih palungthin loe paroeai set o; nihcae ih aqawnh loe kam-ong sut taprong ah oh moe, palai hoiah amsawnlok to a thuih o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Angraeng, nihcae to amrosak ah; nihcae sak atimhaih loe angmacae amtimhaih ah om nasoe; nihcae loe na misa ah oh o, zaehaih paroeai sak o boeh pongah, nihcae to haek lai ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe nang amha kaminawk loe anghoe o nasoe: nihcae to na pakaa pongah, nihcae loe anghoehaih hoiah laa sah o nasoe: na hmin palung kaminawk doeh nang ah anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Angraeng, katoeng kaminawk to tahamhoihaih na paek ueloe, na tahmenhaih hoiah nihcae to pakaa tih.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, na palungphuihaih hoiah na zoeh hmah, palungphuihaih hoiah na thuitaek hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Angraeng, tha ka cak ai pongah, na tahmen ah: Aw Angraeng, kai ih ahuhnawk loe angthlong hlawk boih boeh pongah, na hoihsak ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka hinghaih doeh thazok sut boeh: toe aw Angraeng, nang loe nasetto maw na oh han vop?
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, amlaem ah loe, ka hinghaih na pahlong ah; na tahmenhaih rang hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tipongah tih nahaeloe duek pacoengah loe nang poekhaih to om mak ai boeh: mi mah maw taprong thung hoiah nang khaeah kawnhaih lok thui tih?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka hanghaih loiah kang pho sut boeh; aqum puek ka qahhaih mikkhraetui mah ka iihkhun to pazawk moe, ka iihhaih ahmuen doeh ka mikkhraetui hoiah ka suisak boih boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Palungset loiah ka mik thazok sut boeh moe, ka misanawk pongah ka mik amtueng ai boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangcae kasae hmuen sah kaminawk, kai khae hoi tacawt o lai ah, tipongah tih nahaeloe Angraeng mah ka qahhaih lok to ang thaih pae boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahmen ka hnikhaih lok to Angraeng mah ang thaih pae; ka qahhaih lok Angraeng mah ang thaih pae boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka misanawk boih loe dawnraihaih hoiah azatpaw o nasoe loe; azatpawhaih hoiah hnuk angnawn o nasoe.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng ka Sithaw, nang khaeah ka buep: kai pacaekthlaek kaminawk boih ban thung hoiah na pahlong ah loe, na loisak ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />To tih ai nahaeloe misa mah kaipui baktiah ka hinghaih to asik pet tih boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng ka Sithaw, hae hmuen ka sak pongah, ka ban ah zaehaih to oh moeng moe,
  </para>
  <para style="p">
    <verse number="4" style="v" />kai hoi angdaeh kami khaeah ka sae hmuen to ka sak, ue, takung tidoeh om ai ah, ka misa ih hmuen to ka lomh pae moeng nahaeloe;
  </para>
  <para style="p">
    <verse number="5" style="v" />ka misa mah ka hinghaih to la nasoe loe, pacaekthlaek nasoe; ue, ka hinghaih long ah atii nasoe loe, kai pakoehhaih to maiphu ah suem nasoe. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Angraeng, palungphuihaih hoiah angthawk ah loe, ka misanawk palungphuihaih to pakaa ah: kai han angthawk ah loe, na thuih ih lok baktih toengah lok to takroek ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaminawk loe amkhueng o moe, nang ang ven o; nihcae han hmuensang ah amlaem let ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng mah kaminawk to lokcaek tih: aw Angraeng, ka toenghaih hoi kai thungah kaom akoephaih baktih toengah, nang mah lokcaek ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kami poekhaih khenkung, poeksae kami sethaih to boengsak ah loe, katoeng kami to caksak ah: aw katoeng Sithaw, nang loe palungthin ni na khet.
  </para>
  <para style="p">
    <verse number="10" style="v" />Poek toeng kaminawk pahlongkung Sithaw loe, kang vaenghaih ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw loe lokcaekkung katoeng ah oh, poeksae kami nuiah loe ni thokkruek palungphuihaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih amlaem let ai nahaeloe, angmah ih sumsen to taak tih; angmah ih kalii to takoih ueloe, suem coek tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih hanah duekhaih hmuennawk to paroep pae moe, pacaekthlaek kaminawk kah hanah angmah ih kaliinawk to pathoep coek boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khenah, anih loe kasae to zokpomh; kasae poekhaih hoiah zokpomh moe, amrohaih to tacawtsak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loe tangqom to takaeh moe, a takaeh ih tangqom thungah krak.
  </para>
  <para style="p">
    <verse number="16" style="v" />A poeksethaih to angmah ih lu nuiah krah let ueloe, minawk nganbawh kana paekhaih doeh a lu nuiah krah lat tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />A toenghaih baktih toengah Angraeng to ka saphaw moe, Sang Koek Angraeng ih ahmin pakoehhaih laa to ka sak han.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, kaicae Angraeng, long nui boih ah nang ih ahmin loe kawkruk maw hoih! Na lensawkhaih to vannawk nuiah na suek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na misanawk pongah, misanawk hoi lula kaminawk nang hngaisak duem hanah, tahnu nae nawktanawk ih pakha hoiah thacakhaih to na paek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na banpazung hoiah sak ih van ah kaom hmuennawk, na sak ih khrah hoi cakaehnawk ka poek naah,
  </para>
  <para style="p">
    <verse number="4" style="v" />kami loe kawbangmaw oh moe, anih to na poek haih khing? Kami capa loe kawbangah maw oh moe, anih to na paqai thuih?
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe vankami pong kahnaem kue ah na sak moe, lensawkhaih hoiah pakoehhaih to nang mueksak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih to na ban hoi sak ih hmuennawk boih ukkung ah na suek moe, a khok tlim ah hmuennawk boih na suek pae:
  </para>
  <para style="p">
    <verse number="7" style="v" />maitaw taenawk hoi tuunawk boih, ue, taw ah kaom moinawk boih;
  </para>
  <para style="p">
    <verse number="8" style="v" />van ah kaom tavaanawk, tuipui thungah kaom tanganawk boih hoi tuipui thungah kaom angtawt thaih minphaw amiinawk boih, a khok tlim ah na suek pae.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, kaicae ih Angraeng, na hmin loe long nui boih ah kawkruk maw hoih!
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, ka palungthin boih hoi nang kang saphaw han; na sak ih dawnrai hmuennawk boih to ka hnuksak han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Poeknawmhaih hoi nang ah kang hoe moe, aw Sang koek, na hmin pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka misanawk hnukbangah amlaem o let naah, na hmaa ah amtimh o moe, anghmat o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka toenghaih to nang doet haih; angraeng tangkhang nuiah nang hnut moe, katoengah lok na caek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sithaw panoek ai kaminawk to na thuitaek; kasae kaminawk to nam rosak moe, nihcae ih ahmin dungzan khoek to nang hmatsak boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw na misa amrohaih loe, boeng khoek to phak boeh: vangpuinawk to na phreak pae, nihcae panoekhaih doeh angmacae hoi nawnto amro boih boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe Angraeng loe dungzan khoek to cak tih; lokcaek hanah angmah ih angraeng tangkhang to a caksak boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah long hae toenghaih hoiah lokcaek ueloe, katoeng lokcaekhaih hoiah kaminawk to uk tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng loe pacaekthlaekhaih tong kaminawk abuephaih ah om tih, raihaih atue ah doeh abuephaih ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na hmin panoek kaminawk loe nang to oep o tih; Angraeng, nang pakrong kaminawk to na pahnawt sut mak ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zion ah kaom, Angraeng khaeah saphawhaih laa to sah oh loe, a sak ih hmuennawk to congca kaminawk khaeah thui oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loe kami athii longhaih to pakuem, pahnet ai: anih loe poek pahnaemhaih hoiah qah kaminawk ih lok to pahnet ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Angraeng, kai hae na tahmen ah; kai hnuma kaminawk ih pacaekthlaekhaih to na khen paeh loe, duekhaih khongkha thung hoiah na loisak ah:
  </para>
  <para style="p">
    <verse number="14" style="v" />to tih nahaeloe Zion canu ih khongkhanawk ah nang pakoehhaih laa to ka sah thai boih ueloe, na pahlonghaih ah anghoehaih hoiah ka om tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sithaw panoek ai kaminawk loe angmacae mah takaeh o ih tangqom thungah krak o: angmacae mah hawk ih palok pongah angmacae ih khok to amanh o boih boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng loe a sak ih lokcaekhaih hoiah amtueng: toe kasae kami loe a ban hoi sak ih thaang pongah amanh. Higgaion. Selah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw pahnet prae kaminawk hoi kasae kaminawk loe, hell thungah caeh o tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kavawt kaminawk to pahnet poe mak ai ueloe, amtang kaminawk oephaih doeh anghma poe mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Angraeng, angthawk ah, kami mah na pazawk hmah nasoe: Sithaw panoek ai kaminawk loe na hmaa ah lokcaekhaih om nasoe.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aw Angraeng, nihcae to ziisak ah: to tiah ni prae congca kaminawk mah angmacae hoi angmacae to kai loe kami rumram ni, tiah panoek o thai tih. Selah.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, tipongah kangthla ah nang doet ving loe? Tikhoe raihaih ka tongh naah nang hawk ving loe?
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasae kami loe amoek moe, amtang kaminawk to pacaekthlaek; angmacae poeksethaih mah angmacae to naeh nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasae kami loe a palung thungah koeh ih baktiah amoek; anih loe kamtlai koeh hmoek kami to thapaek moe, Angraeng to kasae thuih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kasae kami loe, amoek loiah Sithaw to pakrong ai: a poekhaihnawk boih ah Sithaw han ahmuen om ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih ih loklamnawk loe palungsethaih ah oh; nihcae lokcaekhaih loe Sithaw mah paek ih lok hoiah angthla moe, a misanawk to tiah doeh sah ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah, Kai loe raihaih ka tong mak ai; natuek naah doeh kam tang mak ai, tiah a poek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih ih pakha loe kasaethuihaih, amsawnlok thuihaih, alinghaih hoiah koi, anih palai ah loe raihaih hoi sethaih khue ni oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih loe avang taengah anghawk moe, sakpazaehaih tawn ai kami to hum: amtang kami naeh hanah tamquta hoiah a khet.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaipui mah akhaw thung hoi moi angang baktih toengah, anih loe anghawkhaih hoiah a angang: amtang kami to angang moe, anih to angmah taengah phak naah palok hoiah a naeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amtang kaminawk a thacakhaih thungah akun o thai hanah, angmah hoi angmah to mi tlim ah kaom thacak ai kami baktiah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah palung thung hoiah, Sithaw mah pahnet boeh: a mikhmai to hawk ving boeh, natuek naah doeh hnu mak ai boeh, tiah poek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Angraeng, angthawk ah! aw Sithaw, na ban to payangh tahang ah: poek pahnaem kaminawk to pahnet hmah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tipongah kasae kami mah Angraeng to kasae thuih loe? Anih loe Angraeng mah kawbangah doeh na naa tang mak ai, tiah a poek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe nang mah loe na hnuk pae; raihaih hoi pacip paaahaih to na ban hoi lak hanah na khet: amtang kami loe angmah hoi angmah to nang khaeah ang paek; tipongah tih nahaeloe nang loe ampa tawn ai kami bomkung ah na oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sethaih sah kami hoi zaehaih sah kami ih ban to khaek pae ah: a sak ih sethaih hnu ai karoek to pakrong ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng loe dungzan hoi dungzan khoek to Siangpahrang ah oh poe: Sithaw panoek ai kaminawk loe a prae thung hoiah anghmaa o tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Angraeng, nang loe mi tlim ah khosah kaminawk koehhaih to na panoek pae: nihcae ih palungthin to na caksak:
  </para>
  <para style="p">
    <verse number="18" style="v" />Long kami mah pacaekthlaek let han ai ah, ampa tawn ai kami hoi pacaekthlaekhaih tongh kaminawk, toenghaih hoi lokcaek hanah nihcae qahhaih lok to na tahngaih pae.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kai loe Angraeng khaeah ni kam ha: tipongah, Tavaa baktiah nangmah ih mae ah azawk lai ah, tiah ka muithla hanah na naa loe?
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenah, kasae kami loe kalii to takoih moe, katoeng kaminawk palung thuem ah kah hanah, anghawk o moe, kalii qui nuiah palaa to koeng o coek boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae angdoethaih ahmuen to paro pae ving nahaeloe, katoeng kami loe timaw sah thai tih boeh?
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng loe kaciim tempul thungah oh moe, Angraeng ih angraeng tangkhang loe van ah oh: kami capanawk to mik hoiah a khet moe, a mikhin hoiah nihcae to tanoek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah katoeng kami to tanoek: toe anih ih muithla mah loe kasae hoi poeksae kaminawk to hnukma.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah kasae kaminawk nuiah hmai kamngaeh, kaat hmai hoi angbaeh thlung kamngaeh hoi kabae parai takhi kasae to krahsak tih, hae loe nihcae naek han koi taham ah om tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng loe toeng pongah, toenghaih to koeh; katoeng kaminawk loe anih ih mikhmai to hnu o tih.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng, na bom ah, Angraeng zii kami om ai boeh: oep ohhaih loe kaminawk salak hoiah anghmat boih boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae loe a imtaeng kaminawk hoi avang ai lok to apaeh o: amsawnlok thuihaih pahni, poek angphaehaih palungthin hoiah lok to apaeh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pazawk hanah thuithaihaih pahni hoi palai to a tawnh o, mi mah doeh pakaa thai mak ai; aicae nuiah mi maw angraeng ah ka om vop?
  </para>
  <para style="p">
    <verse number="4" style="v" />tiah thui kaminawk ih, amsawnlok thuihaih pahninawk boih to Angraeng mah aat pae tih; amoekhaih palai doeh aat pae tih:
  </para>
  <para style="p">
    <verse number="5" style="v" />Amtang kami mah tong ih pacaekthlaekhaih, tidoeh tawn ai kami qahhaih lok pongah, vaihi kang thawk han boeh; anih pacaekthlaek kami ban thung hoiah amtang kami to ka pakaa han, tiah Angraeng mah thuih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng ih loknawk loe ciim: amlai long hmai kamngaeh thungah vai sarihto atui pakaw ih, sumkanglung tui hoiah anghmong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, nihcae to na khen ueloe, nihcae to hae kaminawk khae hoiah dungzan khoek to na pakaa poe tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tidoeh avang ai kaminawk pakoehhaih atue phak naah, poeksae kaminawk loe ahmuen kruekah azatpawhaih hoiah caeh o tih.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, nasetto maw nang pahnet han vop? Nang pahnet poe han boeh maw? Nasetto maw kai khae hoiah mikhmai na hawk han vop?
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai loe ni thokkruek nasetto maw palung ka set moe, nasetto maw khopoekhaih hoiah ka oh han vop? Ka misa mah nasetto maw na uk vop tih?
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng ka Sithaw, ka lok hae tahngai ah loe, na pathim ah: ka mik hae amtuengsak ah, to tih ai nahaeloe duekhaih hoiah ka iip poe moeng tih;
  </para>
  <para style="p">
    <verse number="4" style="v" />to naah ka misanawk mah, Anih loe ka pazawk boeh, tiah na naa o ueloe, kam tim naah kai raihaih paek kaminawk anghoe o moeng tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toe kai loe nam lunghaih tang kami ah ka oh; na pahlonghaih pongah kai ih palungthin anghoe tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih loe ka nuiah paroeai hoih pongah, Angraeng khaeah laa ka sak han.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kamthu loe angmah ih palungthung ah, Sithaw om ai, tiah thuih. Nihcae loe amro o moe, panuet thok hmuennawk to sak o, kahoih hmuen sah kami maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thaikophaih tawn kami hoi Sithaw pakrong kami oh maw tiah hnuk hanah, Sithaw mah van hoiah kami capanawk to khet tathuk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaminawk loe loklam amkhraeng o boih, nihcae loe panuet thok ah oh o boih boeh: kahoih hmuen sah kami maeto doeh om ai, om roe om ai, maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Takaw a caak o baktih toengah, kai ih kaminawk to a caak o; zaehaih sah kaminawk boih loe panoekhaih tawn ai ah maw oh o?
  </para>
  <para style="p">
    <verse number="5" style="v" />Katoeng kaminawk khaeah Sithaw oh pongah, nihcae loe paroeai zithaih hoiah koi o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng loe amtang kaminawk abuephaih ah oh pongah, amtang kaminawk atimhaih to na paro pae o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Israelnawk pahlonghaih loe Zion hoiah angzoh! Angraeng mah angmah ih kaminawk misong thung hoiah hoih let naah, Jakob loe oephaih tawn ueloe, Israel loe anghoe tih.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng, mi maw na ohhaih kahni im ah om tih? Mi maw nang ih kaciiim mae ah om tih?
  </para>
  <para style="p">
    <verse number="2" style="v" />Katoeng ah caeh kami, toenghaih hmuen sah kami, palung thung hoi toenghaih lokthui kami,
  </para>
  <para style="p">
    <verse number="3" style="v" />palai hoi kami pronghaih lok thui vai ai kami, angmah imtaeng kami khaeah kahoih ai hmuen sah vai ai kami, angmah imtaeng kami ahminsae thui vai ai kami,
  </para>
  <para style="p">
    <verse number="4" style="v" />kasae kami to panuet moe, Angraeng zithaih tawn kaminawk khingyahaih paek kami, angmah han sethaih om langlacadoeh a lokkamhaih baktih toengah poek amkhrai ai kami,
  </para>
  <para style="p">
    <verse number="5" style="v" />a coi ih phoisa nuiah a caa kangpung la ai kami, sakpazaehaih tawn ai kami, nganbawh kana paek hanah, minawk khae hoi bokhaih tangqum talawk ai kaminawk ni om o tih. Hae hmuennawk sah kami loe natuek naah doeh angthui mak ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, na pakaa ah, nang khaeah ni ka buep.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw ka hinghaih, nang mah Angraeng khaeah, Nang loe ka Angraeng ni; nang ai ah loe ka hoihhaih tetta doeh ka tawn ai, tiah na naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe long ah kaom kaciim kaminawk hoi lensawkhaih hoiah koi kaminawk to ka palung.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalah sithaw khaeah caawn kaminawk loe palungsethaih pung aep tih: naek han a paek o ih athii hoiah angbawnhaih ka sah mak ai; pahni hoiah nihcae ih ahminnawk bokhaih lok to ka thui mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng loe ka toep han koi kai ih qawk hoi boengloeng ah oh: ka toep han koi taham doeh nang pahoe pae boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kahoih koek ahmuen ah nang suek; ue, kahoih qawk to ka toep boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka poekhaih paekkung, Angraeng to ka pakoeh han: aqum ah doeh ka plungthin mah na lok hoiah ang thuitaek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng to ka hmaa ah ka suek toepsoep: anih loe ka bantang bangah oh pongah, kang thui mak ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah ka palungthin loe anghoe moe, ka lensawkhaih doeh anghoe: ka taksa doeh oephaih hoiah om tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka muithla hae hell thungah na caeh taak mak ai; Ciimcai nangmah ih kami doeh na qongsak mak ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai hanah hinghaih loklam to na patuek tih: kacung anghoehaih loe na hmaa ah oh, na bantang bangah loe dungzan anghoehaih to oh.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, toenghaih hoi ka hanghaih lok hae tahngai pae ah loe, lawk ka thuihaih naa patueng pae ah, alinghaih pahni hoiah lawk ka thui ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka nuiah lok takroekhaih loe nang khae hoiah angzo nasoe loe, na mik hoiah toenghaih to hnu nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka palungthin to nang khingh pae moe, aqum ah nang khetzawn; kai hae nang tanoek, toe tidoeh na hnu ai; ka pakha ah zaehaih om mak ai, tiah ka poek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaminawk mah sak ih hmuennawk baktih toengah, amrosak thaih kaminawk caehhaih loklam ah athum han ai ah, na pakha thung hoi tacawt tamthanglok hoiah ka yae ving boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kam thaek han ai ah, na loklam ah ka caehhaih khok tangkan na caksak ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Sithaw, kang kawkhaih lok nang pathim han oh pongah, nang to kang kawk: na naa to patuengh loe, lawk ka thuihaih lok hae na tahngai paeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang khae abuephaih pakrong kaminawk, misa ih ban thung hoiah na ban hoi pahlongkung, dawnrai nam lunghaih to amtuengsak ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai pacaekthlaek kasae kaminawk hoi kai takui khoep kami hum han koeh misanawk thung hoiah mikmu baktiah na khenzawn ah loe, na pakhraeh tahlip ah na buepsak ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae loe kathawk angmacae ih angan to ang oep o moe, amoekhaih lok to a thuih o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aicae caehhaih loklam to vaihi takui o khoep boeh: aicae long ah amtimsak hanah mik hoiah a khet o;
  </para>
  <para style="p">
    <verse number="12" style="v" />kaek ih moi to caak han kaom zok amthlam kaipui, moi naeh hanah tamquta hoiah angangh kaipui caa kanawk baktiah a oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Angraeng, angthawk ah, anih to pakaa ah loe, amtimsak ah; na sumsen hoiah ka hinghaih kasae kami ih ban thung hoiah na loisak ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Angraeng, long kami ah kaom, to baktih kaminawk ih ban thung hoiah ka hinghaih hae na ban hoi na pahlong ah; nihcae loe hae long nuiah hing o nathung, tangqum a hak o boeh, nihcae ih zok to na hawk ih hmuenmae hoiah na koisak boeh: a caanawk loe angraeng o; nihcae loe caa nawktanawk to sak o mangh, a tawnh o ih hmuenmaenawk doeh a caanawk hanah suek pae o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai loe, toenghaih hoiah na krang to ka hnu tih: kang thawk tahang naah, na krang baktiah kaom nangmah roe to ka hnu tih, to naah loe ka poekhaih palung hae khuek ti tih boeh.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka thacakhaih, Aw Angraeng, nang kang palung han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng loe ka lungsong, kacak kai ih sipae hoi kai pahlongkung ah oh: ka Sithaw, ka thacakhaih, ka buephaih, kang vaenghaih, ka loihhaih taki, kai ih imsang ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakoeh han krah Sithaw to ka kawk han, anih mah ka misanawk ban thung hoiah na pahlong tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Duekhaih quinawk mah ang zaeng moe, Sithaw panoek ai kaminawk ih tuiphu mah zithaih hoiah ang ohsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hell qui mah ang zaeng kang moe, duekhaih thaang mah ang maah khoep.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dawnrai naah Angraeng to ka kawk, ka Sithaw to ka palawk: anih mah angmah ih tempul thung hoiah ka lok ang tahngaih pae; ka hanghaih lok loe anih hmaa ah phak moe, anih ih naa thungah akun.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih palungphui naah, long anghuen moe, tasoeh; maenawk ohhaih takung khoek to anghuen moe, angthuih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih ih hnah thung hoiah hmaikhue tacawt moe, anih pakha thung ih hmai mah kangh pongah, to ih hmaipalai hoiah hmai to amngaeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih mah van to takoih moe, pahnaem tathuk; kaving loe anih ih khok tlim ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih loe Cherubim nuiah angthueng moe, azawk: ue, anih loe takhi ih pakhraehnawk nuiah azawk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih loe angmah anghawk haih hanah vinghaih to sak moe, kaving khak tuinawk hoi kathah van ih tamainawk mah anih to takui o.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hmaa ah aanghaih oh pongah, kathah tamainawk mah qaetui hoi hmai kamngaeh thlung to sin o moe, hmabang ah caeh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng loe van ah doeh khopazihsak moe, Sang koek mah qaetui hoi hmai kamngaeh thlungnawk hanah lok a paek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ue, anih loe angmah ih palaanawk to kah; tangphra a pueksak pongah, misanawk anghaehsak phang moe, a sungsak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw Angraeng, na thuitaekhaih hoi na hnah thung ih takhi nang hahhaih hoiah, tui longhaih loklamnawk to amtueng moe, long angdoethaih doeh amtueng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih loe ranui bang hoiah ban to payangh, kai ang patawnh moe, pop parai tuinawk thung hoiah kai to azuh tahang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah kai hnuma kaminawk, kai han paroeai thacak, ka misanawk ban thung hoiah ang pahlong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kam rohaih niah nihcae mah ang maah o khoep; toe Angraeng loe ka buephaih ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih mah kalen parai imthung ah ang caeh haih; ka nuiah palung a tongh pongah, anih mah ang pahlong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angraeng mah ka toenghaih baktih toengah, tangqum to ang paek, ka ban ciimhaih baktih toengah atho ang paek let.
  </para>
  <para style="p">
    <verse number="21" style="v" />Angraeng ih loklamnawk to ka pazui pongah, zaehaih sak hanah Sithaw to ka caeh taak ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />A lok takroekhaihnawk boih loe ka hmaa ah oh, anih mah sak ih daannawk ka pahnawt vai ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hmaa ah toenghaih hoiah kho ka sak moe, zaehaih to ka caeh taak.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah ka toenghaih baktih, a mikhnuk ah ka ban ciimhaih baktih toengah, Angraeng mah tangqum to ang paek.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang loe tahmen thaih kami khaeah tahmenhaih nam tuengsak moe, katoeng kami khaeah toenghaih to nam tuengsak;
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaciim kami khaeah ciimhaih nam tuengsak moe, poek angkoih kami khaeah poek angkoihaih to nam tuegsak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi tlim ah khosah kaminawk to na pahlong; toe kasang ah mikpadai kaminawk loe na pakhrak tathuk.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aw Angraeng, kai ih hmaithawk nang paaang pae, ka Angraeng Sithaw mah ka vinghaih hae na aangsak tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang oephaih rang hoiah misa to ka patom moe, ka Sithaw oephaih rang hoiah ni sipae to ka poeng thaih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sithaw ih loklam loe acung: Angraeng ih lok loe coek han koi om ai. Anih loe angmah khaeah abuep kaminawk boih hanah angvaenghaih ah oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Angraeng pacoengah mi maw Sithaw ah kaom vop? To tih ai boeh loe aicae Sithaw ai ah loe mi maw lungsong ah kaom?
  </para>
  <para style="p">
    <verse number="32" style="v" />Sithaw mah thacakhaih kazii hoiah ang zaeng moe, ka caehhaih loklam to acungsak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tasuk khok baktiah ka khok hae ang sak pae moe, ka ohhaih hmuensangnawk ah ang suek.
  </para>
  <para style="p">
    <verse number="34" style="v" />Misatuk kop hanah ka ban ang patoh pae, to naah ni ka ban mah sum kalii to takoih thai vop.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai nang pakaa moe, na pahlonghaih to nang paek: na bantang ban hoiah nang zaeh moe, na tuinom hoihaih hoiah nang lensak boeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka caehhaih loklam to na kawksak pongah, ka khok hae amkhraeng thai ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka misanawk ka patom moe, ka kae: nihcae amro ai karoek to kam laem let ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nihcae loe ka khok tlim ah amtimh o: angthawk thai ai khoek to nihcae to ka tit.
  </para>
  <para style="p">
    <verse number="39" style="v" />Misatuk hanah thacakhaih kazii hoiah nang zaeng; ka misanawk ka khok tlim ah na kuepsak.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kai hnuma kaminawk ka hum thai hanah, ka misanawk ih tahnongnawk doeh nang paek.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nihcae loe hang o, toe pahlongkung tawn o ai; Angraeng khaeah a hang o, toe anih mah pathim pae ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />To naah nihcae to adip pueng ah ka hnoih moe, takhi nuiah maiphu takhoek ih baktih toengah ka takhoek: nihcae to loklam ih maiphu baktiah ka haeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kai naeh kaminawk ih ban thung hoiah nang loisak moe, sithaw panoek ai kaminawk ih lu ah nang suek; panoek ai ih kaminawk doeh kai ih tok to a sak o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kai ih tamthang a thaih o naah, ka lok to tahngaih o; panoek ai ih kaminawk loe angmacae koeh ah ka hmaa ah ang paek o.
  </para>
  <para style="p">
    <verse number="45" style="v" />Panoek ai ih kaminawk loe palung boeng o moe, angmacae ohhaih ahmuen hoi tasoehhaih hoiah angzoh o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Angraeng loe hing! Ka lungsong loe tahamhoihaih om nasoe! Kai pahlongkung Sithaw loe, pakoehhaih om nasoe.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kai hanah lulak moe, kaminawk kai tlim ah kuepsakkung loe, Sithaw ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ka misanawk thung hoiah anih mah ang pahlong; ue, ka misanawk ranuiah kai nang toengh tahang: amrosak thaih kami ban thung hoiah nang pahlong.
  </para>
  <para style="p">
    <verse number="49" style="v" />To pongah aw Angraeng, kai loe Sithaw panoek ai kaminawk salakah, nang khaeah anghoehaih lawk ka thuih moe, na hmin pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="50" style="v" />Anih mah angmah ih siangpahrang khaeah kalen parai loisakhaih to paek moe, situi a bawh ih David hoi angmah ih acaengnawk khaeah boeng thai ai palungnathaih to amtuengsak.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vannnawk mah Sithaw lensawkhaih to taphong o, long ranui ih van mah a toksakhaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nito pacoeng nito lokthuih o moe, qumto pacoeng qumto palunghahaih to amtueng o sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lokthuihaih hoi lokpaehhaih to om ai; kawbaktih ahmuen ah doeh nihcae ih lok thaih han om ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe nihcae ih lok loe longpum ah phak, a loknawk loe long boenghaih khoek to amthang boeh. Van ah ni ohhaih kahni im to a sak pae,
  </para>
  <para style="p">
    <verse number="5" style="v" />ni loe impui thung hoi tacawt zu la thendoeng baktiah oh, angnoekhaih ahmuen ah anghoehaih hoi kacawn thacak kami hoiah anghmong.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih loe van boenghaih hoiah tacawt moe, van boenghaih khoek to takui: ni aengh mah phak han ai ah kanghawk hmuen tidoeh om ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng ih kaalok loe acung moe, muithla to amkhraisak: Angraeng mah thuih ih lok loe oepthoh moe, palungha ai kaminawk to palunghasak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng thuitaekhaih loknawk loe toeng moe, palungthin to anghoesak; Angraeng ih kaaloknawk loe ciim moe, mik to amtuengsak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng zithaih loe ciim moe, dungzan khoek to cak poe: Angraeng lok takroekhaih loe amsoem moe, toeng boih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sui pongah atho nat, ue, kaciim suitui pongah doeh koeh han oh kue: khoitui pongah luep moe, khoi lutui pongah doeh luep kue.
  </para>
  <para style="p">
    <verse number="11" style="v" />To baktih hmuennawk hoiah na tamnanawk to acoehaih na paek, daan pazuihaih loe paroeai kalen tangqum to oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi maw a sakpazaehaih panoek thaih? Kamtueng ai sakpazaehaih thung hoiah kai na ciimsak ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na tamna mah zaehaih sak parui poe han ai ah na pakaa ah; to zaehaihnawk mah kai na uk hmah nasoe: to tiah ni katoeng ah ka om ueloe, kalen parai zaehaih thung hoiah ka loih tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Angraeng, ka thacakhaih hoi kai akrangkung, ka pakha thung ih loknawk hoi palung thungah ka poek ih hmuennawk loe, na hmaa ah talawk han koi ah om nasoe.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dawnrai hoi na oh naah Angraeng mah na lok tahngai pae nasoe loe, Jakob ih Sithaw ahmin mah na pakaa nasoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmuenciim hoiah nang abomh hanah patoeh nasoe loe, Zion hoiah thacakhaih na paek nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na tathlang ih hmuennawk boih panoek nasoe loe, na sak ih angbawnhaih to talawk nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na koehhaih palungthin baktih toengah, na paek nasoe loe, na poekhaihnawk boih acungsak nasoe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na pahlonghaih pongah kang hoe o moe, aicae Sithaw ih ahmin hoiah pazawkhaih kahni ka payang o han: na hnik ih hmuennawk boih Angraeng mah na paek nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />A qoih ih kami loe Angraeng mah pahlong; thacak pahlonghaih a bantang ban hoiah anih ih lok to angmah ih kaciim van hoiah tahngai pae, tiah vaihi ka panoek boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thoemto kaminawk loe hrangleengnawk to oep o, thoemto kaminawk loe hrangnawk to oep o: toe kaicae loe kaimacae Angraeng Sithaw ih ahmin ni ka oep o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae loe lu takhum o moe, amtim o: toe kaicae loe angthawk o moe, kacakah kang doet o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, pahlong ah! Kang kawk o naah siangpahrang mah pathim nasoe.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, siangpahrang loe na thacakhaih ah anghoe; na pahlonghaih pongah cae loe kawkruk maw anih anghoe tih!
  </para>
  <para style="p">
    <verse number="2" style="v" />A pahni hoiah hnikhaih to na tamuep pae khoep ai moe, a koehhaih palung baktih toengah na paek boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih hanah kahoih tahamhoihaih to na paek: a lu nuiah kaciim suitui hoi sak ih lumuek to nang mueksak boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah hinghaih ang hnik naah, na paek, dungzan hoi dungzan khoek to kasawk hinghaih to na paek boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na pahlonghaih rang hoiah anih loe paroeai len: pakoehhaih hoi huham ohhaih to a nuiah na suek pae.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih han dungzan tahamhoihaih na paek: na hmaa ah paroeai anghoehaih hoi na koisak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Siangpahrang loe Angraeng to oep moe, Ranui koek tahmenhaih rang hoiah anih loe angthui mak ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na ban mah na misanawk boih to hnu tih, na bantang ban mah nang hnuma kaminawk to hnu tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Palung na phui naah nihcae to hmai kamngaeh omthuh baktiah na ohsak: Angraeng mah nihcae to palungphuihaih hoiah paaeh tih, nihcae to hmai mah kang tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae ih athaih to long hoiah nang hmaasak ueloe, kaminawk salak hoiah nihcae ih caanawk to nam rosak tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae loe na nuiah kasae sak han ih pacaeng o moe, kahoih ai hmuen to a poek o, toe nihcae mah sah o thai ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pongah kalii to na nueng thuih moe, nihcae mikhmai ah na patoep naah, nihcae to hnukbang ah nam laemsak tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Angraeng, na thacakhaih hoiah nang pakoehhaih to om nasoe; na thacakhaih to laasakhaih hoiah kang saphaw o han.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka Sithaw, ka Sithaw, tipongah nang caeh taak ving loe? Kai nang bomh ai, tikhoe ka hanghaih lok pathim ai ah kangthla ah na oh ving loe?
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw ka Angraeng, khodai ah ka hangh, toe nang pathim ai; khoving ah doeh kang hngai duem thai ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe aw nang loe na ciim, nang loe Israel kaminawk saphawhaih ah na oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kam panawk mah nang ni oep o: nang ang oep o pongah, nihcae to na pahlong.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang khaeah a hang o naah, nihcae to na pahlong; nang ang oep o pongah, azathaih tongh o ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai loe kami na ai, sadong ah ni ka oh; minawk mah kasaethuih moe, hnaphnae han koi ah ni ka oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai hnu kaminawk boih mah ang patoek o moe, ang pahnuih o thuih: pahni ang baek o thuih moe, lu ang haek o thuih,
  </para>
  <para style="p">
    <verse number="8" style="v" />anih loe Angraeng oephaih tawnh na ai maw, Angraeng mah pahlong nasoe khae: anih ih mikcuk naakrak ah om nahaeloe, anih mah pahlong nasoe khae, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe kam no zok thung hoiah nang taprok moe, tahnu ka naek naah kamongah nang ohsak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zok thung hoiah boeh ni nang khaeah kang tathlang boeh, nang loe kam no zok thung hoiah ka Sithaw ah na oh boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kangthla ah na om taak hmah; raihaih mah ang phak thuih tom boeh; bomkung mi doeh om ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Maitaw taenawk mah ang takui o khoep; thacak Bashan ih maitaw taenawk mah ang ven o khoep boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hanghaih hoi moi kaek kaipui baktiah, nihcae mah pakha ang angh o thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tui baktiah ang kraih o moe, ka huhnawk doeh angkhring boih boeh: ka palungthin loe samdai baktiah oh moe, ka palung thungah amnaeng boih boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka thacakhaih loe laom koi baktiah oh, ka palai doeh akam huh hoiah angbet caeng boeh; kai hae duekhaih maiphu thungah nang zaeh tathuk boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai loe uinawk mah ang takui o khoep: nawnto amkhueng kasae kaminawk mah ang ven o khoep boeh: ka ban hoi ka khoknawk to ang takhing o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai ih ahuhnawk loe kroek thai boih han koiah ni oh boeh: nihcae mah padaenghaih hoiah ang khet o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nihcae mah ka khukbuennawk to amzet o moe, kai ih laihaw lak hanah taham khethaih phoisa to a vah o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe, Aw Angraeng, kangthla ah na om taak hmah: Aw ka thacakhaih, kai abomh han karangah angzo ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sumsen thung hoiah ka hinghaih pakhra hae pahlongh loe, ka palung koek ih pakhra hae ui thacakhaih thung hoiah pahlong ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kaipui pakha thung hoiah na pahlongh loe, hmawsaeng kokno ih taki thung hoi nang pahlong hanah ka lok hae nang thaih pae boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kam nawkamyanawk khaeah na hmin to ka thuih moe, kaminawk salakah nang kang pakoeh han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng zii kaminawk, anih to pakoeh oh; nangcae Jakob ih caanawk boih, anih to pakoeh oh; nangcae Israel caanawk boih, anih to zii oh!
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih loe patangkhang kami hoi raihaih tong kami to khet patoek ai, panuethaih doeh tawn ai; a mikhmai doeh hawk ving ai, Angmah khaeah hang naah, Anih mah pathim pae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kami rangpui salakah nang to kang pakoeh moe, Anih zii kaminawk hmaa ah lokkamhaih to ka sak han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tlim ah khosah kaminawk loe caa o ueloe, zok amhah o tih: Angraeng pakrong kaminawk loe, Anih to saphaw o tih: to tiah nahaeloe nangcae ih palungthin dungzan khoek to hing tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Long boenghaih ah kaom kaminawk boih mah panoek o ueloe, Angraeng khaeah amlaem o tih: prae kaminawk boih mah na hmaa ah bok o tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ukhaih prae loe Angraeng ih ni: anih loe prae kaminawk boih ukkung ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Long ah kaom angraengnawk boih hoi caaknaek kamtlai ah tawn kaminawk mah nang to bok o tih: a hinghaih pakaa thai ai kaminawk, maiphu thungah caeh kaminawk boih na hmaa ah akuep o tih:
  </para>
  <para style="p">
    <verse number="30" style="v" />nihcae acaengnawk mah anih ih tok to sah pae o ueloe, angzo han koi a caanawk khaeah Angraeng kawng to thui pae o tih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nihcae angzo o ueloe, Anih mah hae hmuen hae sak boeh, tiah Anih toenghaih to tapen han koi kaminawk khaeah taphong o tih.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe kai ih tuu toepkung ah oh; kam tang mak ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah qam kahing ahmuen ah ang taboksak: anih mah tui taengah ang hoih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah ka hinghaih tha ang caksak: anih mah angmah ih ahmin hanah, toenghaih loklam ah ang hoih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ue, duekhaih tahlip mah khuk ih tahawt thungah ka caeh langlacadoeh, kai nang oh thuih pongah, kahoih ai hmuen roe to ka zii mak ai: nang ih thing hoi cunghet mah poekhaih ang mongsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka misanawk hmaa ah caboi nang paroep pae: ka lu ah situi nang bawh; ka boengloeng loe amtlai pok.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka hing thung hoihaih hoi palungnathaih to ka hnu poe ueloe, Angraeng imthung ah dungzan khoek to ka om tih boeh.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Long hoi a thung ih hmuennawk; long hoi a thungah kaom kaminawk boih loe, Angraeng ih ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah to ahmuen to tuipui nuiah angdoetsak moe, tuinawk nuiah a caksak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi maw angraeng ih mae nuiah daw tih? To tih ai boeh loe mi maw anih ih hmuenciim ah angdoe tih?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ban ciim kami hoi poek ciim kami, krangbokhaih bangah a hinghaih to paek ai, kamsoem ai hmuen ah lokkamhaih sah ai kami loe,
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng khae hoiah tahamhoihaih to hnu ueloe, anih pahlonghaih Sithaw khae hoiah toenghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />To kami loe Sithaw pakrong kaminawk ih acaeng, Sithaw krang pakrong Jakob ih acaeng ah oh. Selah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw nangcae khongkhanawk, na lunawk to phok o tahang ah; nangcae dungzan thoknawk, angtoeng o tahang ah; lensawk Siangpahrang loe athung ah akun tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hae lensawk siangpahrang loe mi aa? Anih loe lensawk thacak Angraeng, misatuk thacak Angraeng to ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw nangcae khongkhanawk, na lunawk to phok o tahang ah; nangcae dungzan thoknawk, angtoeng o tahang ah; lensawk Siangpahrang athung ah angzo tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hae lensawk Siangpahrang loe mi aa? Misatuh kaminawk ih Angraeng, anih loe lensawk Siangpahrang to boeh ni. Selah.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, ka hinghaih kang tathlang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw ka Sithaw, na nuiah kam ha: na zatsak hmah loe, ka misanawk mah na pazawk o hmah nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ue, na nuiah amha kaminawk boih loe azathaih tong o mak ai: takung tiodeh om ai ah oep om ai ah khosah kaminawk loe azatpaw o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, na loklamnawk to na patuek ah loe, na caehhaih loklamnawk to na hnusak ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang loe ka pahlonghaih Sithaw ah na oh pongah, na loktang thungah na hoi ah loe, na patuk ah; ni thokkruek nang ni kang zing.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Angraeng, canghnii hoiah kaom na palungnathaih hoi nam lunghaih to pahnet hmah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka qoeng thuem naah ka sak ih, zaehaihnawk hoi lokaekhaihnawk to poek hmah lai ah: Aw Angraeng, nang loe na hoih moe, palungnathaih na tawnh baktih toengah na pahnet hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng loe toeng moe, hoih pongah zaehaih tawn kaminawk hanah angmah ih loklam to patuek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi tlim ah khosah kaminawk to toenghaih a hnuksak, poeknaem kaminawk hanah angmah ih loklam to patuk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng ih loklamnawk loe, a lokmaihaih hoi a thuih ih loknawk pazui kaminawk boih hanah, palungnathaih hoi loktang ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Angraeng, ka sakpazaehaih len parai cadoeh, na hmin rang hoiah tahmen ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng zii kami loe mi aa? To kami hanah a qoih pae ih loklam to patuk tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih loe hoihaih hoi khosah ueloe, anih ih ca mah long to toep tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng zii kaminawk loe, panoek thai ai ih a lokmaihaih to panoeksak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka mik mah Angraeng khue ni danh; anih mah thaang pongah kaman ka khok to na khramh pae tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaimabueng patangkhanghaih hoiah ka oh sut pongah, kai khaeah angqoi ah loe, na tahmen rae ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Poek patanghaih ka thuilaek ai: khosak binghaih thung hoi na loisak ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka patanghaih hoi pacip paaahaih to na khen paeh loe, ka zaehaihnawk boih na tahmen ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka misanawk loe pop o phi, nihcae mah paroeai kai ang hnukma o, tiah panoek ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka hinghaih hae pakaa ah loe, na pahlong ah: nang thungah ka buep pongah, azat na pawsak hmah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang kang zing pongah, poekciimhaih hoi toenghaih mah na pakaa nasoe.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Sithaw, Israel hae raihaihnawk boih thung hoiah akrang ah!
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, toenghaih ka pazui pongah, ka toenghaih baktiah lok takroek ah: Angraeng to ka oep pongah, kam thaek mak ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Angraeng, ka poekhaih hoi palungthin hae khen ah loe, caek tanoek ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nam lunghaih ka hmaa ah oh poe pongah, na loktang lok ah ka caeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Avang ai kaminawk hoi nawnto kang hnu ai moe, angsah thaih kaminawk hoi doeh nawnto ka caeh vai ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kasae sah kaminawk amkhuenghaih to ka panuet, kasae kaminawk hoi nawnto kang hnu mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Angraeng, zaehaih om ai ah ban kam saeh moe, na hmaicam to ka ven han:
  </para>
  <para style="p">
    <verse number="7" style="v" />anghoehaih lok to ka thuih moe, anghmang thok na toksakhaihnawk boih to ka thuih han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, na im ohhaih ahmuen, na lensawk amtuenghaih ahmuen to ka koeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka pakhra hae kazae kaminawk hoi nawnto suem hmah loe, ka hinghaih doeh athii anghae kaminawk hoi nawnto suem hmah:
  </para>
  <para style="p">
    <verse number="10" style="v" />nihcae ih ban loe kasae sakhaih kop o moe, a bantang bannawk loe bokhaih hmuen hoiah koi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe kai loe toenghaih loklam to pazui pongah, na krang ah loe, na tahmen ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka khok hae kadue ahmuen ah angdoe ueloe, rangpui amkhuenghaih ahmuen ah Angraeng to tahamhoihaih ka paek han.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe ka hmaithaw hoi ka pahlonghaih ah oh; mi maw ka zit han vop? Angraeng loe ka hinghaih tha ah oh, mi maw ka zit bae han vop?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ngan caak hanah, kasae kaminawk kai khaeah angzoh o naah, amthaek o moe, amtimh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Misatuh kaminawk mah na takui o khoep cadoeh, ka palung mah zithaih tawn mak ai: misatuk han angzo o cadoeh, angoephaih palungthin to ka tawnh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng kranghoihaih to ka hnuk moe, anih ih tempul thungah ka oh pacoengah, ka hing thung Angraeng imthung ah ka oh thai hanah, ka koeh ih hmuen maeto Angraeng khaeah ka hnik boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Raihaih phak naah anih mah angmah ih im ah kai na buepsak tih: angmah ih kahni imthung ah na hawk ueloe, lungsong nuiah anghnusak tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vaihi kai takui khoep ka misanawk nuiah ka lu hae atoeng tahang tih: to pongah angmah ih kahni imthung ah anghoe angbawnhaih to ka sak han: laa ka sak han, ue, Angraeng khaeah pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, kang kawkhaih lok hae na pathim paeh: na tahmen ah loe na pathim pae raeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka krang hae pakrong oh, tiah na thuih naah, ka palung mah nang khaeah, Angraeng, na krang ni ka pakrong han, tiah thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na mikhmai hawk ving hmah loe, palungphuihaih hoiah na tamna hae haek ving hmah: Aw Sithaw, ka pahlonghaih, kai abomkung loe nang ni; na pahnawt sut hmah loe, na caeh taak hmah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kam pa hoi kam no mah kai pahnawt sut naah, Angraeng mah kai na talawk tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Angraeng, na loklam to patuek ah; ka misanawk pongah katoeng loklam ah na caeh haih ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amsawnlok thui kaminawk hoi tahmenhaih tawn ai poeksae kaminawk loe, kai han misa angthawk o thuih pongah, ka misanawk koehhaih baktiah kai hae nihcae khaeah paek hmah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kahing kaminawk ih prae ah, Angraeng hoihhaih to ka hnu tih, tiah tanghaih ka tawn ai nahaeloe, ka palung thazok tih boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng to zing ah: thazok hmah, to tiah nahaeloe anih mah na poekhaih palungthin to thacaksak tih. Angraeng to mah zing ah.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, ka lungsong, nang ni kang kawk; pathim ai ah om hmah; nang pathim ai nahaeloe, tangqom thungah krah nihcae baktiah ni ka om tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na hmuenciim bangah ban ka payangh moe, nang kang kawk naah, tahmen kang hnikhaih lok to na tahngai paeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angmacae imtaeng kaminawk khaeah angdaehhaih lok thui kami, palung thungah loe sethaih poek kami, kasae kaminawk, sethaih sah kaminawk hoi nawnto na caeh haih hmah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae khaeah a sak o ih tuinuen baktih, a sak o ih sethaih baktih toengah, pathok let ah: ban hoi a sak o ih tok baktih toengah, paek ah loe lokcaek ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng ih toknawk hoi a sak ih hmuennawk to tidoeh dawncang ai ah a oh o pongah, to kaminawk to anih mah amrosak tih, nihcae loe angthawk o let mak ai boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahmen ka hnikhaih loknawk anih mah ang thaih pae pongah, Angraeng khaeah tahamhoihaih om nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng loe ka thacakhaih hoi ka buephaih ah oh; ka palungthin mah anih to oep pongah, anih mah ang bomh: to pongah ka plungthin anghoehaih hoiah koi; anih to laa hoiah ka pakoeh han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng loe angmah ih kaminawk hanah thacakhaih ah oh; situi a bawh ih kami hanah thacak pahlonghaih ah oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangmah ih kaminawk to pahlong ah loe, na qawktoep kaminawk to tahamhoihaih paek ah: nihcae to khenzawn ah loe dungzan khoek to toep ah.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw nangcae thacak kaminawk, Angraeng khaeah angpaek oh; lensawkhaih hoi thacakhaih to Angraeng khaeah paek oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahmin lensawk Angraeng khaeah angpaek oh loe, kaciim amthoephaih hoiah Angraeng to bok oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng ih lok loe kalen tuinawk nuiah oh; Sithaw lensawkhaih loe khopazih baktiah tuenh: Angraeng loe paroeai kalen tui nuiah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng ih lok loe thacak; Angraeng ih lok loe thacakhaih hoiah koi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng ih lok mah sidar thingnawk to angkhaehsak; ue, Lebanon ih sidar thingnawk to Angraeng mah khaeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae to maitaw caa baktiah angphetsak moe, Lebanon hoi Sirion to hmawsaeng kokno ih caa baktiah oh sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng ih lok mah hmaipalai to pakhoih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng ih lok mah praezaek to ahoek moe, Angraeng mah Kedesh praezaek to ahuenh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng ih lok mah tasuknawk to caa tapensak moe, tawnawk doeh amtuengsak: anih ih tempul thungah kami boih mah a lensawkhaih to thuih o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng loe tuipui nuiah anghnut; ue, Angraeng loe dungzan Siangpahrang ah anghnut poe.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah angmah ih kaminawk to thacaksak ueloe, Angraeng mah angmah ih kaminawk hanah monghaih hoi tahamhoihaih to paek tih.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, nang kang pakoeh han; kai hae nang pahlong, ka misanawk mah ka nuiah anghoe o thai han ai ah na sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Angraeng ka Sithaw, nang kang kawk naah, kai ngan nang tuisak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng, ka pakhra taprong thung hoiah nang zuh tahang moe, tangqom thungah ka caeh han ai ah, nang hingsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangcae Angraeng ih kaciim caanawk, Angraeng khaeah laa sah oh, ahmin kaciim to saphaw oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih palungphuihaih loe nawnetta ah ni oh; anih tahmenhaih loe hing thung cak poe tih: qahhaih loe qumto thung khue ni oh, toe akhawnbang ah loe anghoehaih to oh let.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khosak hoih li nathuem ah loe, natuek naah doeh mawnhaih ka tawn mak ai boeh, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, nang tahmenhaih rang hoiah ni kai ih mae hae nang caksak: mikhmai na hawk ving naah, dawnraihaih hoiah ka oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, nang ni kang kawk; Angraeng khaeah lawk ka thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka hinghaih amro moe, tangqom thungah ka caeh nahaeloe timaw atho om tih? Maiphu mah nang to pakoeh tih maw? Anih mah nang ih loktang lok to taphong tih maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Angraeng, tahngai ah loe, ka nuiah palungnathaih to tawn raeh: Aw Angraeng, kai abomkung ah om ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka qahhaih to hnawhhaih ah nang coengsak: buri canghnawh to nang khringh pae moe, anghoehaih kazii hoiah nang zaeng;
  </para>
  <para style="p">
    <verse number="12" style="v" />to pongah anghngai duem ai, ka hinghaih mah nang pakoehhaih laa to sah tih. Aw Angraeng ka Sithaw, dungzan khoek to kawnhaih lok kang thuih han.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, nang khaeah ni ka buep, azathaih na tongsak hmah; na toenghaih hoiah pahlong ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na naa patueng ah loe, karangah na pahlong ah; ka buephaih lungsong ah omh loe, kai pahlong hanah kacak sipae ah om ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang loe ka lungsong hoi kang hawkhaih ah na oh pongah, na hmin hoi na caeh haih ah loe, na zae ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hmaa ah amtung sut thaang hoiah na loisak ah, tipongah tih nahaeloe nang loe ka buephaih ah na oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka muithla na ban ah kang tathlang; Aw loktang Angraeng Sithaw, kai nang krang boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tidoeh angcoeng ai hmuen to ka hnukma, toe Angraeng to ka oep.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na palungnathaih ah anghoehaih hoi ka oh han: ka raihaih nang hnuk pae moe, ka pakhra patangkhanghaih nang panoek pae;
  </para>
  <para style="p">
    <verse number="8" style="v" />misa khaeah nang paek ai moe, ka khoknawk hae ahmuen kahnaep ah nang doetsak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, raihaih ka tong pongah, ka nuiah palungnathaih tawn raeh: palungset loiah ka mik, muithla hoi zoknawk doeh amro boih boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palungset hoiah ka hinghaih hae ka laemsak moe, saning paroeai thung khuiqahhaih hoiah ka oh: ka sakpazaehaih pongah ka thazok sut moe, ka huhnawk doeh qong boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka misanawk hoi ka imtaengnawk mah kai ang hnap o, ampui angzongnawk mah doeh kai ang zit o: tasa bangah kai hnu kaminawk mah ang cawn o taak boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kai loe poek han koi kaom ai kadueh kami baktiah ang pahnet o: kai loe kakoi long laom baktiah ni ka oh boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Paroeai kaminawk mah thuih o ih kasae lok khue ni ka thaih: ka taengah om kaminawk loe zitthok kami ah ni oh o boih: nihcae loe nawnto amkhueng o moe, ka hinghaih lak hanah khokhan o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe Aw Angaeng, nang ah ni kam ha: nang loe ka Sithaw ni, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai ih atuenawk loe na ban thungah ni oh; ka misanawk hoi kai pacaekthlaek kaminawk ban thung hoiah na loisak ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tamna nuiah na mikhmai pansak raeh loe, na palungnathaih hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Angraeng, na zatsak hmah; nang khaeah lawk ka thuih pongah, kasae kaminawk to azatpaw o nasoe, nihcae loe taprong thungah anghngai o duem nasoe.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amoekhaih lok, hnaphnaehaih hoi katoeng kaminawk khet patoekhaih lokthui kami, amsawnlok thuihaih pahninawk to angsumh o nasoe.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang zii kaminawk hanah na suek pae moe, kaminawk mikhnuk ah, na nuiah amha kaminawk khaeah na sak pae ih, na hoihaih loe kawkruk maw len.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaminawk ih amoekhaih thung hoi loisak hanah, panoek thai ai na ohhaih ahmuen thungah nihcae to na hawk boeh: misa koeh lok apaehhaih palai thung hoi pakaa hanah nihcae to, panoek thai ai na ohhaih ahmuen thungah na suek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kacak vangpui ah dawnrai tahmenhaih amtuengsak pongah, Angraeng khae tahamhoihaih om nasoe.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai loe na hmaa hoi kang thla ving boeh, tiah tasoehhaih hoiah lok ka thuih, toe nang kang kawk naah, tahmen kang hnikhaih lok to nang tahngai pae.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih ih kaciim kaminawk boih, Angraeng to palung oh! Angraeng loe oep kaom kaminawk to khetzawn, amoek kaminawk hanah loe kasae sakhaih tangqum to kating ah a paek.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangcae Angraeng oephaih tawn kaminawk boih, thazok o hmah, to tiah nahaeloe anih mah na palungthin tha na cak o sak tih.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />A sakpazaehaih to tahmen pae moe, a zaehaih khuk pae ih kami loe, tahamhoih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah net ih zaehaih thung hoiah loih moe, alinghaih palungthin tawn ai kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka zaehaih taphong ai ah ka oh moe, athun qui ahamhaih hoiah ka oh pongah, ka huhnawk hmawn o boih boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aqum athun na ban loe kai hanah azit parai; kai ih angsatui loe nipui tue ih long karoem baktiah ni oh boeh. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah ka zaehaih kang taphong, ka sakpazaehaih to ka taphat ai. Ka sakpazaehaih Angraeng khaeah ka taphong han, tiah ka thuih naah, ka sakpazae moeng ih zaehaih to nang tahmen pae. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah nang hnuk thaikoi ah oh nathuem ah, Sithaw zii kaminawk boih mah nang khaeah lawkthui o tih: tangtang ni kalen tuiphunawk loe nihcae khaeah pha mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang loe ka buephaih ahmuen ah na oh pongah, raihaih thung hoiah kai nang pakaa ueloe, pahlonghaih laanawk hoiah kai nang takui khoep tih. Selah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na caeh han koi loklam to kang hnuksak moe, kang patuek han: ka mik hoiah loklam kang patuek han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Panoekhaih tawn ai hrang, to tih ai boeh loe mule hrang baktiah om o hmah: nihcae ih pakha loe sum hoiah moem moe, sumqui hoi zaeh han angaih khruek, to tiah sah ai nahaeloe nihcae to na hoi thai mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kahoih ai kaminawk loe paroeai raihaih tongh o: toe Angraeng oep kami loe, palungnathaih mah anih to om thuih poe tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangcae katoeng kaminawk, Angraeng ah anghoe oh loe, oephaih tawn oh: poek toeng kaminawk boih anghoehaih laa to sah oh.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangcae katoeng kaminawk, Angraeng ah anghoe oh: katoeng kaminawk loe saphawhaih laasak han krak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toenghaih hoiah Angraeng to pakoeh oh: aqui hato kaom katoeng tamoi kruek hoiah anih to pakoeh oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih khaeah laa kangtha to sah oh; mongkah uenghaih hoiah kanawm ah anih to pakoeh oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng ih lok loe toeng; anih ih toknawk boih loe toenghaih hoiah ni sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe toenghaih hoiah khokhan moe, kamsoem ah lokcaekhaih to a koeh, long loe Angraeng hoihaih hoiah koi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vannawk loe Angraeng ih lok hoiah sak moe, van ah kaom hmuennawk boih doeh a pakha thung ih takhi hoiah ni a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah tuipui ih tuinawk to nawnto acuu moe, kathuk tuipui doeh pakhuenghaih ahmuen ah a suek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Long boih mah Angraeng to zii o nasoe: long kaminawk boih mah anih to khingza o nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tipongah tih nahaeloe anih loe thuih baktiah angcoengsak; a paek ih lok baktiah ohsak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw panoek ai kaminawk lokramhaih to anih mah paro pae: kaminawk atimhaih doeh a phraek pae.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng khokhanhaih loe dungzan khoek to cak, a poekhaih loe angzo han koi caanawk khoek to om poe tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angmah ih qawktoep hanah a qoih ih kaminawk hoi Sithaw loe Angraeng ni, tiah tapom acaengnawk loe tahamhoih o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng mah van hoi khet tathuk naah, kaminawk to hnuk boih.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ohhaih ahmuen hoiah khet naah, long ah kaom hmuennawk to panoek boih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng mah kami boih hanah poekhaih palungthin to paek; nihcae mah sak ih hmuennawk Angraeng mah panoek boih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kawbaktih siangpahrang doeh kanoih parai misatuh kaminawk mah pahlong ai: thacak kami doeh thacakhaih mah loisak ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hrang mah ngancuemhaih paek thai ai: a thacakhaih mah mi doeh pahlong thai ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khenah, Angraeng ih mik loe angmah zithaih tawn kami, a palungnathaih oep kaminawk nuiah oh;
  </para>
  <para style="p">
    <verse number="19" style="v" />duekhaih thung hoiah nihcae ih pakhra to anih mah pahlong moe, khokhaa naah nihcae hingsak hanah a khetzawn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aicae hinghaih mah Angraeng to zing: anih loe aicae bomkung hoi angvaenhaih aphaw ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kaciim anih ih ahmin to a oep o pongah, aicae ih palungthin loe anih ah anghoehaih a tawnh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Angraeng, nang kang oep o baktih toengah, na palungnathaih kaicae nuiah om nasoe.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe tahamhoihaih ka paek poe han: anih pakoehhaih loe ka pahni hoi palai ah om poe tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka hinghaih mah Angraeng to amoek haih tih: poeknaem kaminawk mah thaih o nasoe loe, anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng to na pakoeh o haih ah, anih ih ahmin nawnto pakoeh o si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng khaeah ka hnik naah, anih mah ang pathim; ka zithaihnawk boih thung hoiah ang pahlong.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih khen kaminawk loe aanghaih to hnuk o: nihcae mikhmai ah azathaih om ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng mah amtang kami kawkhaih lok to thaih pae moe, raihaihnawk boih thung hoiah anih to pahlong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih zithaih tawn kaminawk loe Angraeng ih vankaminawk mah takui khoep moe, nihcae to pahlong.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng hoihhaih to pataeng oh loe, khen o tanoek ah: anih khae amha kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangcae anih ih kaciim kaminawk, Angraeng to zii oh: anih zii kami loe amtanghaih om mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Saning nawk kaipuinawk loe thazai o sut moe, zok amthlam o; toe Angraeng pakrong kaminawk loe kahoih hmuen angaihaih om mak ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangcae nawktanawk, angzo oh, ka lok hae tahngai oh: Angraeng zithaih loklam kang patuk o han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kahoih hmuen to hnuk moe, hinglung sawk na koeh maw?
  </para>
  <para style="p">
    <verse number="13" style="v" />Loksae thuih han ai ah, na palai to angsumh loe, lok amlai han ai ah, na pahni to angsum ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasae hmuen to caeh taak ah loe, kahoih hmuen to sah ah; angdaehhaih to pakrongh loe patom ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng ih mik loe katoeng kaminawk nuiah oh moe, nihcae hanghaih lok to tahngaih pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sethaih sah kaminawk loe a oh o haih long hoiah pahnet ving han khoek to tamit bit hanah, Angraeng mah mikhmai angqoi taak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Katoeng kaminawk loe hangh o naah, Angraeng mah thaih pae moe, nihcae to raihaihnawk boih thung hoiah pahlong.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angraeng loe poek amro kaminawk khaeah anghnaih moe, dawnpakhuemhaih palungthin tawn kaminawk to pahlong.
  </para>
  <para style="p">
    <verse number="19" style="v" />Katoeng kami loe raihaih paroeai tong langlacadoeh, to baktih hmuennawk boih thung hoiah Angraeng mah anih to pahlong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih ih ahuhnawk to pakuem pae boih pongah, maeto doeh angkhaek ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe sethaih sah kami mah kahoih ai kami to hum ueloe, katoeng kami hnuma kaminawk loe lokcaekhaih tong o tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng mah a tamnanawk to pahlong: angmah khaeah abuep kaminawk loe lokcaekhaih hnu o mak ai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, ka lokaek kaminawk to nang mah aek ah loe; kai tuh kaminawk to nang mah tuh ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angvaenghaih hoi pakaahaih to la ah loe, kai abomh hanah angthawk ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tayae to aphong ah loe, kai pacaekthlaek han patom kaminawk to pakaa khoep ah: ka hinghaih pakhra khaeah, Kai loe nang pahlongkung ni, tiah thui paeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hinghaih boeng hanah pakrong kaminawk to palungboeng o nasoe loe, azatpaw o nasoe: kai amro han khokhan kaminawk to azatpawhaih hoiah hnukbangah amlaem o let nasoe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe takhi mah hmuh ih tavai baktiah om o nasoe loe, Angraeng ih van kami mah nihcae to haek nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae caehhaih loklam to khoving nasoe loe, loklam amnaesak nasoe: Angraeng ih van kami mah nihcae to pacaekthlaek nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae loe takung om ai ah tamquta hoi kai hanah palok zang o, takung om ai ah ka hinghaih paro hanah tangqom to takaeh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />To baktih kami nuiah poek ai pui hoiah raihaih to pha pae nasoe; angmah payang ih palok pongah angmah to aman nasoe: to amrohaih tangqom thungah angmah to krah nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah ka hinghaih mah Angraeng ah anghoe ueloe, anih pahlonghaih pongah anghoe tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah ka huhnawk boih mah, thacak kami ban thung hoiah amtang kami pahlongkung, ue, paro thaih kami ban thung hoiah amtang kaminawk pahlongkung, Angraeng, mi maw nang baktih kaom? tiah thui o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amsawn hnukung ah angdoe kaminawk loe angthawk o moe, ka panoek ai ih hmuennawk to ka nuiah amtik o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka hinghaih paro hanah kahoih hmuen to kasae hoiah ang pathok o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe kai loe nihcae ngannat o naah, buri kazii to kang zaeng moe, buhzah lawkthuihaih hoiah poek ka pahnaem pacoengah, palungthin tang hoiah lawk ka thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae to kam pui hoi kaimah ih nawkamya baktiah ka poek: kami mah amno duek naah palungset baktih toengah, palungset hoiah ka ngam sut.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe kai amtim naah loe nihcae anghoe o moe, nawnto amkhueng o; ue, kai patoem kaminawk loe nawnto amkhueng o, nihcae to ka panoek ai; nihcae loe anghak ai ah kai ang pasik o:
  </para>
  <para style="p">
    <verse number="16" style="v" />kasae kaminawk mah poihkung ah minawk pahnuih o thuih baktih toengah, kai han haa ang kaek o thuih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Angraeng, nasetto maw nang khet sut han vop? Amrosak thaih nihcae ban thung hoiah ka hinghaih na pahlong paeh loe, hae kaipui ban thung hoiah ka palung koek ih ka hinghaih hae pahlong ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rangpui amkhuenghaih ahmuen ah nang khaeah anghoehaih lok to ka thuih, kaminawk salakah nang kang pakoeh han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amsoem ai ah ka misanawk mah ka nuiah anghoe o thuih hmah nasoe; takung om ai ah kai hnuma kaminawk mah mik na pakhrip o thuih hmah nasoe.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae loe angdaehhaih to lok thui o ai; nihcae loe prae thungah amding rue ah khosah kaminawk athlaeng thai hanah pacaeng o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ue, nihcae loe pakha angh o moe, Aha, aha, aimacae ih mik hoi roe a hnuk o boeh, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Angraeng, hae baktih hmuennawk hae na hnuk boeh pongah, om taak duem hmah: Aw Angraeng, kangthla ah na om taak hmah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka Sithaw hoi Angraeng, kai kawng pongah lokcaek hanah, anglawt loe, angthawk ah!
  </para>
  <para style="p">
    <verse number="24" style="v" />Aw Angraeng ka Sithaw, na toenghaih hoiah lok na takroek pae ah; ka nuiah nihcae mah anghoehaih tawn o hmah nasoe.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae mah palung thung hoiah Aah, aicae koehhaih loe acung boeh, tiah thui o hmah nasoe: anih loe a paaeh o boeh, tiah thui o hmah nasoe.
  </para>
  <para style="p">
    <verse number="26" style="v" />Karai ka tonghaih nuiah anghoe kaminawk loe azatpaw o nasoe loe, dawnraihaih hoiah om o nasoe: kai amoek thuih kaminawk loe azatpaw o nasoe loe, ahminsethaih hoiah om o nasoe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka toenghaih pongah anghoe kaminawk loe, anghoehaih laa to sah o nasoe loe, nawm o nasoe: ue, Angmah ih tamna qoeng tahanghaih koeh Angraeng loe, lensawkhaih om nasoe, tiah thui o poe nasoe.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka palai mah loe na toenghaih ni thui ueloe, athun qui nang pakoehhaih lok to thui tih.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasae kami zaehaih mah ka palung thungah lok ang thuih: Anih loe mik ah Sithaw zithaih roe tawn ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Panuet thok angmah ih zaehaih to hnu ai, angmah hoi angmah to kahoih baktiah a hnuk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih pakha thung ih loknawk loe sethaih hoi alinghaih khue ni oh: hoihaih paek thaih palunghahaih to a caehtaak boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih loe iihhaih ahmuen ah oh naah mataeng doeh kasae khue ni poek; kahoih ai loklam to a pazui, sethaih tuinuen to panuet ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng, na palungnathaih mah vannawk to phak moe, na oep thohhaih loe tamai khoek to phak boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na toenghaih loe mae pui baktiah oh; na lokcaekhaih loe thuk parai: Aw Angraeng, nang mah ni kami hoi taw ih moinawk to na khetzawn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Sithaw, nam lunghaih loe kawkruk maw hoih! To pongah ni kaminawk loe na pakhraeh tahlip ah abuep o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na im thung ih angraenghaih mah nihcae to palung khuek tihsak ueloe, nang hoehaih vapui tui to nihcae han na naesak tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinghaih tuibap loe nang khaeah ni oh: na aanghaih mah kaicae han aanghaih to paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang panoek kaminawk khaeah nam lunghaih to omsak poeh loe, poek toeng kaminawk khaeah na toenghaih to omsak poe ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amoek kami ih khok to kai khaeah angzosak hmah, kasae kami ih ban mah doeh kai hae na tahruet hmah nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kahoih ai hmuen sah kaminawk loe amtimh o: nihcae loe amtimh o moe, angthawk o thai ai boeh.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmuensae sah kaminawk pongah palungboeng hmah loe, nihcae to awt hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae loe akra ai ah qam baktiah aat ueloe, qam kahing baktiah azaem o tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng to oep ah loe, kahoih hmuen to sah ah; prae thungah om ah loe, poek caksak ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng ah anghoehaih tawn ah, to tih nahaeloe palung thung hoi na koeh ih hmuen to na paek tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na caehhaih loklam to Angraeng khaeah aap ah; anih to oep ah; to tih nahaeloe angmah na hoi tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah loe na toenghaih to hmai baktih, katoengah takroek ih lok to athun ih ni aengh baktiah aangsak tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng hmaa ah anghngai duem ah loe, anih to palungsawkhaih hoiah zing ah: a caehhaih loklam amkah hanah toksah thaih, sethaih poeng hanah toksah thaih kami pongah palungboeng hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palungphui hmah loe, palung doeh baesak hmah: zaehaih sak hanah kahoih ai poekhaih to tawn hmah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sethaih sah kaminawk loe pahnawt sut ah om tih, toe Angraeng zing kaminawk loe long to toep o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sethaih sah kami loe akra ai ah om mak ai boeh: ue, anih ih ahmuen to na pakrong khing cadoeh, na hnu mak ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe tuinom tawn kaminawk loe long hae toep o ueloe, kating ai monghaih hoiah khosak nawm o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kasae kami mah loe katoeng kami to pacaeng moe, haa a kaek thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe anih ih atue pha tih boeh, tiah Angraeng mah panoek pongah, anih to pahnui thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasae kaminawk mah amtang kaminawk to amtimsak moe, toenghaih sah kaminawk to hum hanah, sumsen aphong thuih pacoengah, kalii to anueng thuih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe angmacae ih sumsen mah angmacae ih palung to thun pae ueloe, palaanawk doeh angkhaek pae tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kahoih ai kami angraeng parai pongah loe, katoeng kami mah tawn ih hmuen zetta to hoih kue.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kasae kami ih ban loe angkhaek tih: toe katoeng kami loe Angraeng mah patawnh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Katoeng kaminawk ih aninawk loe Angraeng mah panoek pae: nihcae ih qawk loe dungzan khoek to cak poe tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae loe sethaih tue phak naah azatpaw o mak ai; takaang thohhaih atue naah doeh zok amhah o tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe kahoih ai kami loe anghma angtaa tih: Angraeng ih misanawk loe kathawk tuu baktiah om o cadoeh, amro o ueloe, hmaikhue baktiah anghma o boih tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kahoih ai kami loe hmuenmae to coi, toe pathok let ai: toe katoeng kami mah loe palungnathaih to amtuengsak moe, paek let.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng tahamhoihaih tongh kaminawk loe, long hae toep o tih; anih mah tangoeng ih kaminawk loe pahnawt sut tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kahoih kami ih khok tangkannawk loe Angraeng mah caksak; a caehhaih loklam nuiah palung tongh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih loe amthaek cadoeh, amtim bung mak ai: tipongah tih nahaeloe Angraeng mah anih ih ban to patawnh pae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Katoeng kami to pahnawt sut, anih ih caanawk loe buh hnik o ti, tiah ka qoeng li nathuem hoi kamtong vaihi mitong khoek to ka panoek vai ai vop.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih loe tahmenhaih tawnh moe, minawk han a paek pongah, a caanawk mah tahamhoihaih hnuk o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kasae hmuen to caehtaak ah loe, kahoih hmuen to sah ah; to tiah nahaeloe prae thungah na om poe tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Angraeng loe toenghaih to koeh pongah, angmah ih kaciim kaminawk to pahnawt sut ai; nihcae to dungzan khoek to khet poe: toe kasae kaminawk ih caanawk loe pahnawt suthaih to tongh o tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Katoeng kami loe long to toep ueloe, to ah dungzan khoek to om tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Katoeng kami ih pakha mah loe palunghahaih lok to thuih; anih ih palai mah doeh toenghaih lok ni thuih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih loe Sithaw ih kaalok to palung thungah suek pongah, a caeh naah amthaek mak ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kasae kami loe katoeng kami to hum hanah, angang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe Angraeng mah anih to kasae kami ban ah caehtaak sut mak ai, lokcaek naah doeh anih to sungsak mak ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Angraeng to zing ah loe a loklam to pazui ah, prae toep hanah anih mah na pakoeh tih: kasae kaminawk amro o naah, to hmuen to na hnu tih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kasae kami loe thacak moe, long kahoih pongah amprawk thing kahing baktiah qoeng tahang to ka hnuk.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toe anih loe laemh ving boeh, khenah, om ai boeh: ue, anih to ka pakrong, toe anih loe hnu thai ai boeh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kahoih kami hnuk ah bangah, katoeng kami to khen ah: to tiah sah kami loe hnukkhuem ah monghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zaehaih sah kaminawk loe amro o ueloe, sethaih sah kaminawk loe hnukkhuem ah amrohaih tong o tih.
  </para>
  <para style="p">
    <verse number="39" style="v" />Katoeng kami pahlonghaih loe Angraeng ih ni: raihaih tongh naah Angraeng loe nihcae thacakhaih ah oh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Angraeng mah nihcae to abomh ueloe, pahlong tih: anih khaeah amha o pongah, anih mah kasae kaminawk ban thung hoiah nihcae to pahlong tih.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, palungphuihaih hoiah na zoeh hmah loe, palungbethaih hoiah doeh na thuitaek hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang kah ih palaanawk loe ka tak thungah akun, na ban hoiah nang boh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Palung na phui pongah, ka takpum ngantuihaih om ai; ka zaehaih pongah ka huhnawk ngantuihaih om ai boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka sakpazaehaih mah ka lu hae zaeng khoep, kai han kazit parai hmuen ah oh, ka phaw thai ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kam thuhaih pongah kai ih ahmaanawk loe hmuiset moe, qongh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Raihaih ka tong boeh; kanung parai ah ka krak tathuk moe, qahhaih hoiah athun qui ka vah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka kaeng loe panuet thok nathaih hoiah koi, ka takpum roe ah ngantuihaih om ai boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tha ka zai sut boeh moe, ka pan dui boeh: tasoehhaih palungthin to ka tawnh pong ah, ka hangh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, ka koeh ih hmuennawk loe na hmaa ah amtueng boih, ka hanghaih lok doeh na hmaa hoiah hawk thai ai boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka palung loe tasoeh moe, tha doeh ka tawn ai: ka mik doeh amtueng ai boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka nathaih pongah ka palung ih kaminawk hoi kam puinawk mah doeh kai ang yae o taak, ka imtaeng kaminawk mah doeh kangthla ah ang oh o taak boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka hinghaih paduek han pakrong kaminawk loe kai hanah thaang patung o: nganbawh kana paek hanah kai pakrong kaminawk loe, athun qui amrohaih hoi alinghaih lok to thuih o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe kai loe naapang baktiah ka oh moe, pakhaa ang thai ai lokaa baktiah ka oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lok thaikop ai, lokthuih palaem let thai ai kami baktiah ni ka oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw Angraeng, nang ni kang oep: Aw Angraeng ka Sithaw, nang mah loe nang pathim tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae mah kai anghoe o thuih ueloe, kam thaek naah nihcae mah kai han amoek o thui tih, to pongah na pathim raeh, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Palungsethaih boeng thai ai boeh pongah, kam timh tom boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka sakpazaehaih to taphong moe, ka zaehaih pongah dawnpakhuem han boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka misanawk loe ngantui o moe, thacak o parai: tidoeh na ai ah kai hnuma kaminawk loe paroeai pop o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahoih hmuen to ka patom pongah, hoihaih to sethaih hoiah pathok kaminawk loe kai ih misa ah oh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aw Angraeng, na prawt sut hmah: Aw ka Sithaw, kangthla ah na om taak hmah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Angraeng kai pahlonghaih, kai abomh hanah karangah angzo rae ah.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palai hoi zaehaih ka sak han ai ah, ka caehhaih loklam ah ka coe han: kahoih ai kaminawk ka hmaa ah oh o nathung, pakha hae ka tamuep han, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lokpae ai ah ka oh duem, to tiah ka oh pongah hoikhanghaih om ai; palungsethaih to pung aep.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka palung loe bet, ka poek naah nung aep ah bet: to naah,
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, kai loe amro thaikoi hmuen ah ni ka oh, nasetto maw ka hing han vop, tiah na panoeksak ah, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khenah, ka hinghaih aninawk loe ban tamsum setto khue ni na sak; ka hinghaih loe na hmaa ah tiah doeh om ai: tangtang ni, kami loe kasang koek ahmuen ah pha cadoeh azom pui ni. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tangtang ni, kami loe tidoeh avang ai tahlip thungah ni amkaeh: tangtang ni, kaminawk loe azom pui ah ni patang o: anih loe hmuenmae to patung, toe mi mah maw toep tih, tiah panoek ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vaihi timaw ka zing han vop? Angraeng, ka oephaih loe nang ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka sakpazae ih hmuennawk thung hoiah na pahlong ah: amthu kaminawk mah kasaethuih hanah na sah hmah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hae tiah nang ohsak boeh pongah, lok ka pae ai, pakha doeh ka aang ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dan nang paekhaih to kai khae hoiah na takhoe pae ah: ban hoi nang boh pongah ka thazok sut boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zaehaih pongah kami to na thuitaek, dan na paek naah karaa mah caak ih baktih toengah, nihcae hoihaih to nam rosak: kaminawk loe azom pui ah ni oh o boih. Selah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Angraeng, lawk ka thuihaih hae na thai paeh loe, ka hanghaih lok hae na tahngai paeh; ka mikkhraetui krakhaih hae na khen pae sut hmah: kai loe kam panawk baktiah kholong ka caeh moe, angvin baktiah ni ka oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hae ahmuen hoi ka duek moe, ka caeh ai naah, tha ka oh let hanah, na tahmen rae ah.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to palungsawkhaih hoiah ka zing pongah, anih loe kai khaeah angqoi moe, ka qahhaih lok to ang tahngaih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah tangnong kathuk, zitthok tangqom thung hoiah ang zuh tahang, ka khok lungsong nuiah ang koengsak moe, ka caehhaih loklam to ang caksak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah aicae Sithaw saphawhaih laa kangtha to ka pakha ah ang paek: to hmuen to kanoih parai kaminawk mah hnuk o naah, zithaih tawn o ueloe, Angraeng tanghaih to tawn o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amoek kami thapaek ai, kami aling hanah lam amkhraeng kami to khen ai ah, Angraeng tanghaih tawn kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw ka Angraeng Sithaw, kaicae han nang sak pae ih dawnrai hmuennawk hoi na poekhaihnawk loe pop parai; ka thui laek mak ai: ka kroek aep to mah kroek thai mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang loe angbawnhaih hoi hmuen paekhaih to na koeh ai; ka naa hae nang khawsak boeh: hmai angbawnhaih hoi zae angbawnhaih to na hni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah kai mah, cabu tangoeng thungah kai kawng tarik o baktih toengah, khenah, kang zoh boeh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw ka Sithaw, na koehhaih sak han ka koeh, ue, nang ih kaalok loe ka palung thungah oh, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kanoih parai kaminawk khaeah toenghaih kawng to ka thuih: khenah, Aw Angraeng, ka pahni hae ka tamuep ai, tito na panoek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na toenghaih ka palung thungah ka hawk ai; na oepthohhaih hoi na pahlonghaih to ka thuih boeh: pop parai kaminawk hmaa ah nam lunghaih hoi tangtang na lok to taphong ai ah ka om ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Angraeng, na tahmenhaih to pakaa ving hmah: nam lunghaih hoi na loktang lok mah na toep poe nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kroek laek ai sethaihnawk mah kai ang takui o khoep boeh: ka sakpazaehaihnawk mah kai ang zaeng khoep boeh pongah, ka mik amtueng ai boeh; nihcae loe ka lu nui ih samnawk pongah doeh pop o kue: to pongah palung ka boeng sut boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Angraeng, kai pahlong han anghoe ah: Aw Angraeng, kai abomh hanah karangah angzo ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka hinghaih lak han pakrong kaminawk loe azatpaw o nasoe loe, dawnrai anghmanghaih hoiah om o nasoe: kai amrosak koeh kaminawk loe azatpaw o nasoe loe, palung boenghaih hoiah hnukbangah amlaem o nasoe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai hanah Aha! aha! tiah pahnui thuih kaminawk loe, azat loiah khosak anghmang o sut nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang pakrong kaminawk boih loe, nang ah anghoe o nasoe loe, poeknawm o nasoe: na pahlonghaih koeh kaminawk mah, Angraeng loe lensawkhaih om nasoe, tiah thui o poe nasoe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe kai loe amtang kami ah ka oh; Angraeng mah kai hanah kho ang poek pae: nang loe kai bomkung hoi pahlongkung ah na oh; Aw ka Sithaw, akra hmah.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kamtang tahmenhaih tawn kami loe tahamhoih: raihaih tongh naah Angraeng mah anih to pahlong tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah anih to toep tih, anih to hingsak pongah, long nuiah tahamhoihaih hnu tih: Angraeng mah anih to a misanawk khaeah paek mak ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngannat naah Angraeng mah om thui tih: ngannat thung Angraeng mah anih ih iihkhunnawk boih to toep pae tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai mah, Aw Angraeng, na tahmen raeh: na nuiah zaehaih ka sak boeh pongah, ka hinghaih ngantuisak ah, tiah ka naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka misanawk mah, Anih loe natuek naa ah maw dueh ueloe, ahmin to anghmaa tih? tiah kasae ang thuih o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai hnuk hanah anih angzoh naah, amsoem ai lok to a thuih: anih ih palungthin loe sethaih khue talawk moe, tasa bang a caeh naah to kawng to a thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai hnuma kaminawk boih mah nawnto kai kasae ang thuih o: kai nganbawh kana paek hanah a poek o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih loe nathaih kasae mah phak thuih boeh pongah, angsonghaih ahmuen hoiah angthawk let mak ai boeh, tiah ang naa o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ue, ka oep koek ih, kai ih takaw kacaa, ampui kangzong mah doeh, kai hae khok hoiah ang pathuih boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toe Aw Angraeng, nihcae to ka sak pathok hanah, na tahmen raeh loe, na pathawk ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka misanawk mah na pazawk o ai pongah, ka nuiah anghoehaih na tawnh, tito ka panoek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka ciim pongah kai hae nang bomh, anih hmaa ah dungzan khoek to nang om thui tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel Angraeng Sithaw khaeah, dungzan hoi dungzan khoek to tahamhoihaih om nasoe. Amen hoi Amen.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tasuk mah tui anghaeh baktih toengah, Aw Sithaw, ka pakhra mah nang to tui ah anghaeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka hinghaih mah Sithaw, kahing Sithaw to tui baktiah anghaeh: natuek naah maw kang zoh moe, Sithaw hmaa ah kam tueng han?
  </para>
  <para style="p">
    <verse number="3" style="v" />Minawk mah, Na Sithaw loe naah maw oh? tiah ang naa o tuektuek pongah, khoving khodai mikkhraetui hae buh baktiah ka caak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hae hmuennawk ka poek naah, ka hinghaih patangkhang: kai loe pop parai kaminawk hoi nawnto anghoehaih hoi saphawhaih laa sak hanah, Sithaw ih im ah ka caeh; pop parai poihkung caeh kaminawk hoi nawnto ka caeh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw ka hinghaih, tipongah na ngam sut loe? Tipongah ka thungah dawnraihaih hoiah na oh loe? Angraeng to oep ah: kai pahlongkung, ka bok ih Sithaw tahmenhaih to ka saphaw han vop.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka hinghaih loe ka palung thungah angam sut boeh pongah, Jordan prae, Hermon mae, Mizar mae hoiah nang to kang panoek poe han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang ih tacangtui hoi kangphui tuikennawk loe maeto hoi maeto ang kawk o moe, kai ang uem o zup boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe khodai naah Angraeng mah a tahmenhaih lok to paek moe, khoving ah angmah ih laa to kai han ang paek pongah, ka hinghaih Sithaw khaeah lawkthuihaih hoiah ka oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka Sithaw lungsong khaeah, Tipongah nang pahnet ving loe? Tipongah ka misa mah ang pacaekthlaek moe, palungsethaih hoiah ka oh loe? tiah ka naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka misanawk mah, Na Sithaw loe naah naw oh? tiah vaihi hoi vaihi ang dueng o pongah, ka huhnawk angkhaeh moe, kai kasae ang thuih o boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw ka hinghaih, tipongah na ngam sut loe? Tipongah ka palung thungah dawnraihaih hoiah na oh loe? Sithaw to oep ah: kai pahlongkung, ka bok ih Sithaw hoihhaih to ka saphaw han vop.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, toenghaih amtuengsak ah, Sithaw panoek ai acaeng khaeah ka toenghaih to thui ah: aling thaih kami, kasae kaminawk ban thung hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang loe ka thacakhaih Sithaw ah na oh: tipongah nang pahnawt ving loe? Tipongah ka misa mah kai pacaekthlaek moe, palungsethaih hoiah ka oh loe?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na aanghaih hoi loktang to na patoeh ah: nihcae mah kai na caeh o haih nasoe loe, nihcae mah na ohhaih kaciim mae hoi kahni im ah na caeh haih nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />To tiah nahaeloe Sithaw hmaicam ohhaih ahmuen ah, kang hoehaih hoi kang hoehaih Sithaw khaeah ka caeh han: Aw Sithaw, ka Sithaw, katoeng kruekhaih hoiah nang kang pakoeh han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw ka hinghaih, tipongah na ngam sut loe? Tipongah ka palung thungah dawnraihaih hoiah na oh loe? Sithaw to oep ah: kai pahlongkung, ka bok ih Sithaw hoihhaih to ka pakoeh han vop.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, naa hoi ka thaih o boeh; canghnii ah, nang mah nihcae khaeah na sak pae ih tok to, kam panawk mah ang thuih o boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sithaw panoek ai kaminawk loe na ban hoiah na haek moe, kam panawk hanah to ahmuen to na paek; to kaminawk to na pacaekthlaek moe, kam panawk to na loisak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae mah to prae to sumsen hoiah pazawk o ai, angmacae bantha hoiah doeh pazawk o ai: toe nihcae to na palung pongah na bantang ban, na ban hoi na mikhmai aanghaih hoiah ni na pahlong.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Sithaw, nang loe ka Siangpahrang ah na oh; Jakob pahlonghaih lok to paek ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang rang hoiah ka misanawk to hnuk kang nawn o sak moe, nangmah ih ahmin hoiah nihcae to ka tit o han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaimah ih kalii hae kang oep haih mak ai, ka sumsen mah doeh na pahlong mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe kai hnuma kaminawk to na zatsak moe, kaicae to misanawk ban thung hoiah nang pahlong.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaicae loe athun qui Sithaw ah ni kam oek o, na hmin to dungzan khoek to ka saphaw o. Selah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe vaihi loe nang pahnawt sut boeh moe, azat nang pawsak boeh; kaicae ih misatuh kaminawk hoi doeh nawnto na caeh ai boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaicae hae misa khae hoiah nam laemsak let: kaicae hnuma kaminawk loe angmacae koeh ah amro o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moicaak han suek ih tuu baktiah nang prawt sut boeh moe, Sithaw panoek ai kaminawk salakah nang haehsak phang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmah ih kaminawk to atho kazoi ah na zawh, toe nihcae zawhhaih atho mah nang ih hmuenmae to pung kue mak ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka imtaeng ih kaminawk mah kasaethuih han kahoih ah nang sak, ka imtaeng kaminawk mah kasaethuihaih hoi pahnuithuihaih to nang phawsak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sithaw panoek ai kaminawk salakah patahhaih lok ah na thuih moe, minawk salakah lu haek thuih hanah nang sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na hmaa ah ni thokkruek ahmin ka set moe, ka mikhmai hae azathaih mah khuk khoep boeh,
  </para>
  <para style="p">
    <verse number="16" style="v" />kasaethuih koeh kami hoi ahmin setsak koeh kami, lulak koeh kami hoi misanawk pongah ni, to tiah ka oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hae hmuennawk boih kaicae nuiah phak; toe nang kang pahnet o ai, lok na maihaih doeh ka phrae o ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kaicae ih palungthin loe hnuk bangah amlaem ai moe, kaicae ih khoknawk doeh na loklam hoiah amkhraeng ai;
  </para>
  <para style="p">
    <verse number="19" style="v" />toe tasuinawk ohhaih salakah nang tit moe, duekhaih tahlip hoiah nang kraeng khoep.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaicae mah Sithaw ih ahmin ka pahnet o moe, prae kalah sithaw khaeah ban ka payangh o cadoeh,
  </para>
  <para style="p">
    <verse number="21" style="v" />Sithaw loe palung thungah tamquta hoi poek ih hmuen to panoek pongah anih mah hnu mak ai maw?
  </para>
  <para style="p">
    <verse number="22" style="v" />Ue, nang pongah athun qui duekhaih ka tong o; hum han ih tuu baktiah ang poek o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aw Angraeng, anglawt lai ah, tipongah na iih loe? Angthawk ah, kaicae hae dungzan khoek to na haek hmah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tipongah mikhmai na hawk ving moe, kaicae raihaih hoi patangkhanghaih to nang pahnet pae ving loe?
  </para>
  <para style="p">
    <verse number="25" style="v" />Kaicae hinghaih loe maiphu thungah krak tathuk boeh moe, kaicae ih zok doeh long ah angbet caeng boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaicae abomh han angthawk ah loe, na palungnathaih hoiah kaicae hae na krang ah.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kai ih palungthin loe hoihaih hoiah angphui tahang moe, ka sak atimhaih to siangpahrang hmaa ah ka thuih: ka palai loe ca tarik kop kami ih cacung ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang loe kaminawk pongah na hoih kue: na pahni loe tahmenhaih hoiah koi: to pongah Sithaw mah dungzan khoek to tahamhoihaih ang paek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw thacak koek, na lensawkhaih hoi na thacakhaih hoiah, na sumsen to na phaih nuiah angnaeng ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Loktang ah ohhaih, poeknaemhaih, na toenghaih ah na lensawkhaih to amtueng moe, hmabang ah caeh poe; na bantang ban mah zitthok hmuennawk to na patuek tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kanoe nang ih palaanawk mah siangpahrang misanawk ih palung thuem ah kah pae, to naah kaminawk loe na khok tlim ah amtim o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Sithaw, na angraeng tangkhang loe dungzan khoek to cak: na prae ukhaih cunghet loe toenghaih cunghet ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang loe toenghaih to na koeh moe, sethaih to na hnukma: to pongah Sithaw, na Sithaw mah, nam puinawk pong kamthlai ah, anghoehaih situi hoiah ang bawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tasaino hoi sak ih siangpahrang imthung hoiah lak ih, myrrh, aloes, hmuihoih thing hoi khukbuennawk mah, nang han palung anghoesak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Siangpahrang ih canunawk loe na khingya han koi nongpatanawk thungah athum o: na bantang bangah loe Ophir sui hoiah amthoep siangpahrang zu to angdoet.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw canu, tahngai ah, na naa to patuengh loe poek ah; nangmah ih kaminawk hoi nam pa im doeh pahnet lai ah;
  </para>
  <para style="p">
    <verse number="11" style="v" />na kranghoihaih mah siangpahrang to anghoesak tih: anih loe na Angraeng ah oh pongah, anih to pakoeh ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tura canu loe tangqum sin ueloe, angzo tih; angraengnawk mah doeh na koehhaih sak hanah na hni o tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Siangpahrang canu loe athung ah lensawkhaihnawk boih hoiah oh: anih loe sui hoiah sak ih khukbuen to angkhuk.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih to angan hoih parai rong congca khukbuen hoiah amthoep o sak ueloe, siangpahrang khaeah caeh o haih tih: anih hnukbang tangla hoi ampuinawk doeh, nang khaeah hoi o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anghoehaih hoiah nihcae to hoi o ueloe, siangpahrang ohhaih imthung ah akun o haih tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na caanawk mah nam panawk ih ahmuen to la o ueloe, long nui boih ah nihcae to angraeng ah na omsak tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na hmin to adung maeto pacoeng maeto pahnet thai han ai ah ka sak han, to ah kaminawk boih mah nang hae dungzan hoi dungzan khoek to pakoeh o tih boeh.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw loe aicae abuephaih hoi thacakhaih ah oh, raihaih tong naah bomkung ah oh, tiah amtueng.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pongah long hae angthui moe, maenawk tuipui thungah amtim cadoeh, ka zii o mak ai;
  </para>
  <para style="p">
    <verse number="3" style="v" />tuipuinawk angthawk o moe, raihaih pha cadoeh, tuiphu angthawk moe, maenawk anghuen langlacadoeh, ka zii o mak ai. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vapui maeto oh, to vapui mah loe Kasang Koek ih kahni im ohhaih hmuenciim, Sithaw vangpui to anghoesak.
  </para>
  <para style="p">
    <verse number="5" style="v" />To vangpui thungah Sithaw oh pongah, amtim mak ai: khawnthaw khodai ah Sithaw mah abom tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw panoek ai kaminawk loe tasoehaih hoiah hang o, praenawk loe thazok o, anih ih lok hoiah long loe atui amkaw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Misatuh Angraeng loe aicae khaeah oh; Jakob ih Sithaw loe aicae abuephaih ah oh. Selah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angzo ah loe Angraeng mah long nuiah sak ih amrohaih hmuennawk hae khenah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Long boeng khoek to misa amdinghaih a sak; anih mah kalii to khaeh pae moe, tayae doeh angkhaehsak; anih mah hrang lakok to hmai thlaek pae.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anghngai o duem ah loe, kai loe Sithaw ni, tiah panoek oh; prae kaminawk salakah kai nang pakoeh o ueloe, long ah nang pakoeh o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Misatuh Angraeng loe aicae hoi nawnto oh; Jakob ih Sithaw loe aicae abuephaih ah oh.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaminawk boih, ban tabaeng oh! Taahaih lok hoiah Sithaw khaeah hang oh!
  </para>
  <para style="p">
    <verse number="2" style="v" />Tipongah tih nahaeloe Kasang Koek Angraeng loe zitthoh; anih loe long nui boih ah kalen koek Siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah kaminawk boih aicae tlim ah suem ueloe, prae kaminawk to aicae khok tlim ah omsak tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angmah palung ih Jakob lensawkhaih, aicae mah toep han koi qawk to aicae hanah na qoi pae tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sithaw loe hanghaih lok hoiah dawh tahang, Angraeng loe mongkah lok hoiah dawh tahang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw khaeah saphawhaih laa to sah oh, saphawhaih laa to sah oh! Aicae Siangpahrang khaeah saphawhaih laa to sah oh, saphawhaih laa to sah oh!
  </para>
  <para style="p">
    <verse number="7" style="v" />Tipongah tih nahaeloe Sithaw loe long nui boih ih Siangpahrang ah oh; panoek thaihaih hoiah saphawhaih laa to sah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sithaw loe prae kaminawk nuiah Angraeng ah oh; Sithaw loe ciimcai Angmah ih angraeng tangkhang nuiah anghnut.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kami ukkung angraengnawk loe, Abraham mah bok ih Sithaw kaminawk khaeah nawnto amkhueng o. Tipongah tih nahaeloe long ukkung siangpahrangnawk loe Sithaw mah uk boih; anih to lensawkhaih hoiah pakoeh o boeh.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe lensawk pongah, ciimcai Angmah ih mae hoi aicae Sithaw ih vangpui ah lensawkhaih hoiah pakoeh han oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aluek bangah kaom, lensawk Siangpahrang ih vangpui, long boih anghoehaih Zion mae loe, kranghoih parai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sithaw loe a ohhaih ahmuen ah oh moe, anih loe abuephaih ah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khenah, siangpahrangnawk loe amkhueng o moe, nawnto caeh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae mah hnuk o naah, dawnrai o; zithaih hoiah cawnh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae loe to ahmuen ah zithaih hoiah oh o, nongpata caa tapen nathuem ih kana baktiah, pauep o,
  </para>
  <para style="p">
    <verse number="7" style="v" />ni angyae bang ih takhi mah Tarshish ih palongpuinawk palet pae phaeng baktiah ni a oh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aicae mah a thaih o ih baktih toengah, aicae Sithaw ih vangpui hoi misatuh Angraeng ih vangpui thungah, a hnuk o boeh; to ahmuen loe Sithaw mah dungzan khoek to caksak tih. Selah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Sithaw, na tempul thungah, nang palunghaih to ka poek o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na hmin amthang baktih toengah, aw Sithaw, nang saphawhaih loe long boenghaih khoek to phak boeh; na bantang ban loe toenghaih hoiah koi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toenghaih hoi lok na caek pongah, Zion mae to anghoe nasoe loe, Judah canunawk to anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zion ah caeh ah, ataeng ah caeh takui ah loe, misa toephaih imsangnawk to kroek ah;
  </para>
  <para style="p">
    <verse number="13" style="v" />angzo han koi caanawk khaeah na thuih pae hanah, misa abuephaih longkhawnawk hoi anih ohhaih ahmuennawk to poek ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae Sithaw loe aicae ih dungzan Sithaw ah oh; anih loe boeng khoek to aicae zaehoikung ah om tih.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangcae boih, hae hae tahngai oh; long ah khosah kaminawk:
  </para>
  <para style="p">
    <verse number="2" style="v" />kahnaem kasang, angraeng hoi kamtang kaminawk boih, nawnto tahngai oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai ih pakha loe palunghahaih lok to thui ueloe, ka palungthin mah panoek thaihaih to poek tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Patahhaih lok bangah naa ka patueng moe, kathuk ruici lok to katoeng kruekhaih hoiah kamnoek ah ka thuih han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tipongah maw kasae aninawk to angzoh moe, kai aling koeh kaminawk ih zaehaih mah ang takui khoep naah ka zii tih?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae loe angmacae ih hmuenmae to oep o moe, angraenghaih pongah amoek o cadoeh;
  </para>
  <para style="p">
    <verse number="7" style="v" />angmacae nawkamyanawk to mi mah doeh akrang o thai ai, anih han Sithaw khaeah akranghaih hmuen doeh paek o thai ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />nihcae hinghaih akrang hanah paroeai atho nat, to pongah dungzan khoek to sung tih boeh:
  </para>
  <para style="p">
    <verse number="9" style="v" />akrang nahaeloe kami loe qong ai ah, dungzan khoek to hing han oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palungha kaminawk duekhaih loe kami boih mah hnuk; nihcae loe kamthu kami hoi tidoeh panoek ai kami baktiah ni anghmat o moe, minawk hanah ni a tawnh o ih hmuennawk to caeh o taak.
  </para>
  <para style="p">
    <verse number="11" style="v" />A tawnh o ih imnawk loe dungzan khoek to cak tih, a oh o haih ahmuennawk doeh a caanawk dung khoek to cak poe tih, tiah a poek o pongah, longnawk to angmacae ih ahmin hoiah suek o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe kami loe lensawk cadoeh cak poe ai: kanghmaa kangtaa taw ih moi hoiah ni anghmong.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae amthuhaih loklam loe to tiah oh: nihcae mah thuih o ih loknawk to a caanawk mah tahngai pae o. Selah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae loe tuu baktiah taprong ah angsong o, duekhaih mah nihcae to pacah tih; akhawnbang ah nihcae to katoeng kaminawk mah uk tih; nihcae ih krang loe taprong ah qong tih, taprong loe nihcae ohhaih ahmuen ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe ka pakhra loe taprong thacakhaih thung hoiah Sithaw mah akrang ueloe, angmah khaeah na caeh haih tih. Selah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kami loe angraeng moe, a im lensawkhaih hoiah qoeng tahang naah, zii hmah;
  </para>
  <para style="p">
    <verse number="17" style="v" />A duek naah loe tita doeh sin mak ai, a lensawkhaih mah anih to patom tathuk mak ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih hing naah loe, angmah hoi angmah to tahamhoih koek ah a poek: nang raeng naah loe, kaminawk mah nang to ang pakoeh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe anih loe ampanawk ih acaeng ohhaih ahmuen ah caeh tih; nihcae loe hinghaih to natuek naah doeh hnu o mak ai boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmuenmae angraenghaih hoi koi, panoekhaih tawn ai kami loe, anghma angtaa taw ih moi hoiah ni anghmong.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thacak, Angraeng Sithaw mah, ni tacawt hoi niduem khoek to, long to kawk moe, lok a thuih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Coek koi om ai kranghoih, Zion mae hoiah, Sithaw aanghaih to tacawt.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aicae ih Sithaw angzo tih, anih loe omduem mak ai: Anih hmaa ah hmai angqong ueloe, takhi pui mah anih to takui khoep tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angmah ih kaminawk lokcaek hanah, ranui ih vannawk hoiah long to a kawk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angbawnhaih hoiah kai hoi lokmaihaih sah kaminawk loe, kaimah ih kaciim kaminawk hoi nawnto pakhueng han, tiah a thuih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw loe toeng pongah, vannawk mah a toenghaih to taphong o tih. Selah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw kai ih kaminawk, tahngai oh, lok ka thuih han; aw Israel, na nuiah ka koeh ai ih hmuen to kang thuih han: kai loe Sithaw, na Sithaw ah ka oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka hmaa ah na sak o toepsoep ih, angbawnhaih, hmai angbawnhaih pongah, kang zoeh o mak ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na im thung hoiah maitaw tae, na takha thung hoiah maeh taenawk doeh, ka la mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Taw thung ih moi hoi mae sangto nuiah kapra moinawk boih loe kai ih ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Maenawk nuiah kaom tavaanawk to ka panoek boih: prae thung ih kasan moinawk boih loe kai ih ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zok kam thlam cadoeh, kang thui mak ai: tipongah tih nahaeloe long hoi athung ah kaom hmuennawk boih loe kai ih ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maitaw tae moi to ka cak moe, maeh thii to ka naek han maw?
  </para>
  <para style="p">
    <verse number="14" style="v" />Sithaw khaeah anghoe angbawnhaih to sah ah; Sang koek khaeah na sak ih lokmaihaih to koepsak ah:
  </para>
  <para style="p">
    <verse number="15" style="v" />raihaih tongh na niah na kawk ah: kang loisak han, to naah loe kai nang pakoeh tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe kasae kami khaeah loe, Ka paek ih lok to na taphong moe, ka sak ih lokmaihaih pazui han angaih maw? tiah Sithaw mah thuih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thuitaekhaih to na hnukma moe, ka loknawk to hnukbang ah na vah ving boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kamqu na hnuk naah, anih to na bomh, zu sava laep ah nongpa nongpata zaehaih sah kaminawk hoiah nam yok.
  </para>
  <para style="p">
    <verse number="19" style="v" />Loksae thuih hanah pakha to na patoh moe, na palai to alinghaih hoiah na zaeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang hnut moe, boeng ai ah nam nawkamyanawk to kasae na thuih, nam no ih caa khaeh mataeng doeh kasae na thuih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hae baktih hmuennawk boih hae na sak, toe kang oh taak duem pongah, nang baktiah ka oh toeng mue, tiah na poek: toe kang thuitaek han, na hmaa roe ah na zaehaih kam tuengsak han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sithaw pahnet kaminawk, hae hae panoek oh, to tiah ai nahaeloe nangcae pahlongkung om ai ah, kang taprawt o pat han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anghoe angbawnhaih sah kami loe kai pakoeh kami ah oh, coek koi om ai ah ka thuih ih lok pazui kami hanah Sithaw pahlonghaih ka hnuksak han.
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, nam lunghaih hoiah na tahmen raeh: na palung nathaih kalen parai hoiah ka sakpazaehaihnawk hae ciimsak ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka sakpazaehaih pasae paeh loe, ka zaehaih thung hoiah na ciimsak ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tipongah tih nahaeloe ka sakpazae ih hmuennawk to ka panoek: ka zaehaih loe ka hmaa ah oh poe boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na lok ka aek moeng boeh, nang khae khue ah, zaehaih ka sak moe, na hmaa ah sethaih ka sak moeng boeh: to pongah lok na thuih naah na toenghaih to amtueng, coek koi om ai ah lok na caek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khenah, tapen tangsuek nathuem hoiah ka zae boeh; kam no mah zaehaih hoiah ang pomh boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khenah, nang loe athung ah loktang oh hanah na koeh: ka palung hanah palunghahaih to na patuk ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hyssop hoiah na pasae ah, to tiah nahaeloe ka ciim tih: na pasae ah, to tih nahaeloe dantui pongah kang lung kue tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anghoehaih hoi oephaih lok to na thaisak ah; to tiah nahaeloe nang khaehsak ih ka huhnawk to anghoe o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka zaehaihnawk pongah na mikhmai to hawk ving ah loe, ka sakpazaehaihnawk boih to ciimsak ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Sithaw, ka thungah kaciim palung to suem ah, ka thungah muithla to angthasak ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na hmaa hoiah na haek ving hmah, kai khae ih kacai na Muithla to la ving hmah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pahlonghaih hoi kasaeng anghoehaih to na paek let ah loe, poekhoihaih hoiah na patawn ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />To tiah nahaeloe hmuen sah pazae kaminawk khaeah na loklam to ka patuek thai ueloe, zae kaminawk doeh nang khaeah amlaem o let tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Sithaw, kai akrangkung Sithaw, kami athii palong zaehaih thung hoiah na pahlong ah: to tiah nahaeloe ka palai mah na toenghaih laa to sah tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw Angraeng, ka pahni hae paong ah: to tiah nahaeloe ka pakha mah nang pakoehhaih lok to thui tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang loe angbawnhaih to na koeh ai; nang koeh nahaeloe angbawnhaih to kang paek han boeh: nang loe hmai angbawnhaih ah nang hoe ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw mah koeh ih angbawnhaihnawk loe, kamro phaeng palung hae ni: Aw Sithaw, kakoi phaeng palung hoi dawnpakhuemhaih palung tawn kaminawk to na patoek mak ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zion mae loe na koehhaih baktiah omsak ah; Jerusalem sipaenawk to pathawk let ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />To naah toenghaih hoi paek ih angbawnhaih, hmai angbawnhaih, takpum boih hmai angbawnhaih to nang hoe haih tih; to pacoengah loe nihcae mah na hmaicam ah maitaw taenawk to paek o tih boeh.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nang thacak kami, tikhoe kasae sak nam oek haih loe? Sithaw hoihhaih loe cak poe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na palai loe haita kanoe baktiah, kasae sak han ih khue to poek pongah, alighaih tok to a sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang loe kahoih hmuen pongah kasae hmuen to na palung kue moe, loktang lok thuih pongah loe, amsawnlok thuih to na koeh kue. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw aling thaih palai, nang loe kasae lokthuihaih to na koeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang loe Sithaw mah dungzan khoek to amrosak tih, na haek ving ueloe, na ohhaih ahmuen hoiah azuk ving tih; ka hing kaminawk ohhaih prae thung hoiah na tangzun to aphongh ving tih. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Katoeng kaminawk mah hnuk o naah, zii o ueloe, anih to pahnui o thui tih:
  </para>
  <para style="p">
    <verse number="7" style="v" />Sithaw oep ai, angmah angraenghaih oep kami, kasae sakhaih caksak kaminawk to khen oh, tiah thui o tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe kai loe Sithaw imthung ih kahing olive thing baktiah ka oh: kai loe Sithaw amlunghaih ni dungzan hoi dungzan khoek to kang oep haih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na sak pacoeng ih hmuen pongah, dungzan khoek to kang pakoeh han: na hoih pongah, nangmah ih kaciim kaminawk hmaa ah, na hmin to ka zing han.
  </para>
  <chapter number="53" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kamthu mah loe a palung thungah, Sithaw om ai, tiah thuih. Nihcae loe anghmaa angtaa kami, panuet thok zaehaih sah kami ah oh o: kahoih hmuen sah kami maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Panoek thoemhaih tawn, Sithaw pakrong kami oh khoe maw, tiah Sithaw mah van hoiah kami capanawk to khet tathuk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaminawk loe loklam amkhraeng o boih; nihcae loe amro o boih boeh; hmuen kahoih sah kami maeto doeh om o ai, om roe om ai, maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Takaw caak baktiah nihcae mah kai ih kaminawk to caak o, Sithaw doeh kawk o vai ai: kahoih ai hmuen sah kaminawk loe panoekhaih tawn o ai boeh maw?
  </para>
  <para style="p">
    <verse number="5" style="v" />Sithaw mah nang takui khoep kaminawk ih ahuhnawk to haeh pae phaeng boeh pongah, zit han om ai to mah paroeai a zit o; Sithaw mah nihcae to patoek pongah, azathaih tongsak boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw, Israel kaminawk pahlonghaih loe, Zion mae hoiah angzo nasoe! Sithaw mah angmah ih kaminawk misong angtanghaih thung hoiah hoih let naah, Jakob loe anghoe ueloe, Israel loe poeknawm tih.
  </para>
  <chapter number="54" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, na hmin hoiah na pahlong ah, na thacakhaih rang hoiah lok na caek ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Sithaw, lawk ka thuihaih hoi ka thuih ih loknawk hae tahngai ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Panoek ai ih kaminawk loe kai tuk hanah angthawk o, tahmenhaih tawn ai kaminawk loe, ka hinghaih to pakrong o: nihcae loe Sithaw mikhmai khethaih tawn o ai. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khenah, Sithaw loe kai bomkung ah oh: Sithaw loe ka hinghaih patawn kaminawk khaeah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe ka misanawk to sethaih hoiah lula pathok tih: na loktang lok hoiah nihcae to amrosak ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka koeh ih baktiah nang khaeah angbawnhaih to ka sak han: Aw Angraeng, na hmin pakoehhaih loe hoih pongah, nang to kang pakoeh han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka raihaihnawk boih thung hoiah Ang pahlong pongah, ka misanawk to taahaih mik hoiah ka khet.
  </para>
  <chapter number="55" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, lawk ka thuihaih hae tahngai ah; tahmen kang hnikhaih hoi angqoi taak hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na tahngai pae ah loe pathim ah: poek anghmang sut moe,
  </para>
  <para style="p">
    <verse number="3" style="v" />ka misa ih lok hoi kasae kaminawk ih pacaekthlaekhaih pongah, ka hang khing boeh; nihcae loe a sakpazae o haih to ka nuiah amtik o, kai palung ang phui o thuih moe, ang hnukma o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka palung loe athung ah patangkhang; duek zithaih mah ang kraeng khoep boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka nuiah zithaih hoi tasoehhaih to phak moe, kai loe zithaih mah muek khoep boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah, Aw pahuu baktiah pakhraeh ka tawnh soe nahaeloe, kangthla ah ka zawk moe, amding rue ah ka oh han boeh!
  </para>
  <para style="p">
    <verse number="7" style="v" />Khenah, kangthla ah kam het moe, praezaek ah ka oh ving han. Selah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Takhi pui hoi takhi sae to loih hanah, karangah ka cawnh han, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, nihcae amrosak hanah, lok to anghmangsak ah; vangpui thungah lokpunghaih hoi angzoehhaih to ka hnuk boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae loe aqum athun sipae taengah caeh o; athung ah loe kahoih ai hmuen sakhaih hoi qahhaih to oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kasae sakhaih vangpui thungah oh o, lampuinawk ah kaom pacaekthlaekhaih hoi alinghaih loe boeng thai ai boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kai pahnui thuih kami loe kai ih misa na ai ni, kai ih misa ah om cadoeh ka pauep thai tih; angmah hoi angmah amkoeh moe, kai hnuma kami doeh kai ih misa na ai ni, kai ih misa ah om nahaeloe, anih to ka yae ving han:
  </para>
  <para style="p">
    <verse number="13" style="v" />to kami loe, kai hoi kanghmong, kam pui, ampui kangzong ah kaom, nang ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaicae loe kahoih lok to ka thuih o moe, kaminawk hoi nawnto Sithaw im ah ka caeh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sethaih loe nihcae ohhaih ahmuen, nihcae salakah oh pongah, nihcae to duekhaih mah naeh nasoe loe, hell thungah kahingah caeh o nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe kai loe, Sithaw to ka kawk han; Angraeng mah na pahlong tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Duembang, akhawnbang hoi athun ah, lawkthuihaih hoiah ka hangh; to naah anih mah ka lok na thaih pae tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai tuh kami loe pop o parai pognah, kai ang tuk o naah, anih mah monghaih hoiah ka hinghaih ang pahlong.
  </para>
  <para style="p">
    <verse number="19" style="v" />Canghnii hoiah kaom poe Sithaw mah thaih naah, nihcae to pacaekthlaek tih. Selah. Nihcae loe amkhraihaih om ai pongah, Sithaw zii o ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />To baktih kami loe a thuih ih lok baktiah om ai, angmah hoi angdaeh ampui to misa ah suek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pakha hoi tacawt a thuih ih loknawk loe samdai baktiah amnae, toe palung thungah loe misatuk han ih khue ni a poek; a lok loe moithawk pongah naem kue, toe nihcae loe sumsen hoi kami hum hanah oh o coek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmah ih hmuenzit to Angraeng khaeah amtii ah, anih mah na bomh tih; katoeng kami loe natuek naah doeh amtimsak mak ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe Aw Sithaw, nang mah nihcae to tangqom thungah pakhrah tih; athii anghae kami hoi aling thaih kaminawk loe, a hing o haih ahap mataeng doeh hing o mak ai; toe kai loe, nang khaeah ni ka buep han.
  </para>
  <chapter number="56" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, na tahmen ah, kaminawk loe kai caak hanah, ni thokkruek ang pacaekthlaek o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Kasang koek, ka misanawk mah kai caak hanah, ni thokkruek ang tuk o; nihcae loe paroeai pop o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zithaih hoi ka oh naah, nang khaeah ka buep han.
  </para>
  <para style="p">
    <verse number="4" style="v" />A lok to ka pakoeh han, Sithaw ka oep pongah ka zii mak ai, kami mah kawbangmaw na naa thai tih?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe ni thokkruek ka loknawk to tamet o, ka nuiah kahoih ai poekhaih a tawnh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae mah ka hinghaih tamit hanah angang o naah, nawnto amkhueng o, anghawk o moe, ka caehhaih khok tangkan to khet parui o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae loe sakpazaehaih hoiah loih o tih maw? Aw Sithaw, palung na phuihaih hoiah to kaminawk to amtimsak ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahmuen kruekah kam hethaih to na poek paeh loe, ka mikkhraetuinawk hae nangmah ih pailang thungah na khrum paeh: to mikkhraetuinawk loe na cabu thungah oh na ai maw?
  </para>
  <para style="p">
    <verse number="9" style="v" />Sithaw kai khaeah oh pongah, kang kawk naah, ka misanawk loe hnukbangah angnawn o tih, tiah ka panoek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw oephaih hoiah a lok to ka pakoeh han; Sithaw oephaih hoiah a lok to ka pakoeh han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw ka oep pongah ka zii mak ai; kami mah kawbangmaw na naa thai tih?
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Sithaw, na hmaa ah lokmaihaih ka sak baktih toengah; nang pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tipongah tih nahaeloe duekhaih thung hoiah nang loisak boeh; Sithaw hmaa ah ka hing kaminawk ih aanghaih hoiah ka caeh thai hanah, ka khok hae nam thaeksak ai.
  </para>
  <chapter number="57" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, ka nuiah palungnathaih tawn raeh, ka nuiah palungnathaih tawn raeh! Hae raihaihnawk laem ai karoek to, ka hinghaih nang khaeah ni abuep; ue, na pakhrae tahlip ah ka buep han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai han hmuennawk boih sahkung Sithaw, Kasang koek Sithaw khaeah ka hang han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah van hoiah patoeh ueloe, kai caak han koeh kami mah kasaethuihaih thung hoiah na pahlong tih. Sithaw mah a palungnathaih hoi a loktang lok to patoeh tih. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hinghaih loe kaipui salakah oh; kai loe hmawsaeng kaminawk salakah kang song, nihcae ih haa loe tayae hoi palaa baktiah oh, palainawk loe kanoe parai sumsen baktiah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Sithaw, nang loe, vannawk ranui khoek to lensawk nasoe; na lensawkhaih loe long boenghaih khoek to om nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae loe ka caehhaih loklam ah palok to payang o, ka hinghaih thazok sut boeh; nihcae loe ka hmaa ah tangqom takaeh o moe, angmacae ih tangqom thungah a krak o. Selah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Sithaw, ka palungthin loe cak, ka palungthin loe cak rap; laa to ka sak han, pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka hinghaih, angthawk ah! Katoeng hoi tamoinawk, angthawk oh! Kai doeh kang thawk palang han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, kaminawk salakah, nang kang pakoeh han; prae kaminawk salakah doeh nang khaeah laa ka sak han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tipongah tih nahaeloe nam lunghaih loe vannawk khoek to len moe, na loktang lok loe tamainawk khoek to phak boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Sithaw, nang loe, vannawk ranui khoek to lensawk nasoe; na lensawkhaih loe long boenghaih khoek to om nasoe.
  </para>
  <chapter number="58" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw kaminawk, na thuih o ih loknawk loe toeng tangtang hmang maw? Aw kaminawk, katoeng ah lok na caek o hmang maw?
  </para>
  <para style="p">
    <verse number="2" style="v" />Tangtang ni, palung thung hoiah kasae na poek o, na bannawk mah long nuiah athii to palong o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kasae kaminawk loe zok thung hoiah ni a set o roe boeh; tapen tangsuek nathuem hoiah loklam amkhraeng o boeh moe, lok amlai o boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae ih kasoe loe pahui kasoe baktiah oh moe, naa pang pahui sae baktiah a oh o;
  </para>
  <para style="p">
    <verse number="5" style="v" />kawkruk ah thoemhaih hoiah thuih pae khing cadoeh, thuikungnawk ih lok to tahngai mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Sithaw, nihcae pakha thung ih haanawk to khaek pae ah; Aw Angraeng, saning nawk kaipui ih anonawk to khaek pae ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae loe kalong tui baktiah kang o boih nasoe; kalii anueng moe, kah o naah, palaanawk to angkhaek pae boih nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae loe longnat mah caeh naah atui amkaw noehnoeh baktih, atue pha ai ah tapen nongpata mah ni aengh hnu ai baktih toengah, dueh o boih nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang ih laomnawk mah soekhring thing hoi tik ih hmai kabae panoek ai naah, kahing soekhring kung hoi hmai kangqong soekhring kung to, kamhae takhi mah hmut phaeng nasoe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kami katoeng loe lulakhaih hnuk naah anghoe tih; anih loe kasae kaminawk ih athii hoiah a khok to pasae tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah kaminawk mah, katoeng kaminawk hanah tangqum loe oh tangtang; anih loe long lokcaekkung Sithaw tangtang ni, tiah thui o tih.
  </para>
  <chapter number="59" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka Sithaw, ka misanawk ban thung hoi na loisak ah; ka misanawk ban thung hoiah pakaa ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasae sah kaminawk thung hoiah na loisak ah; athii anghae kaminawk ih ban thung hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khenah, nihcae loe kai hum hanah angang o; Aw Angraeng, thacak kaminawk loe ka zaehaih pongah na ai, ka sakpazaehaih pongah doeh na ai ah, ka nuiah kahoih ai hmuen sak hanah amkhueng o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe ka sakpazaehaih tidoeh om ai ah, cawnh o moe, tuk hanah amsak o coek boeh; kai abomh hanah angthawk ah loe na khen ah!
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw misatuh kaminawk ih Angraeng Sithaw, Israel Sithaw, Sithaw panoek ai kaminawk thuitaek hanah angthawk ah; kasae sah kami loe, kawbaktih kami nuiah doeh palungnathaih to tawn hmah. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae loe duembang ah amlaem o; ui baktiah hangh o moe, vangpui thungah amkaeh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khenah, nihcae loe patoekhaih lok to thuih o; nihcae ih pahni thungah loe sumsen to oh, mi mah maw thaih tang tih, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe Aw Angraeng, nihcae to pahnui thui ah loe, Sithaw panoek ai kaminawk boih to pahnui thui ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih thacakhaih ah kaom nang, nang to kang zing han; Aw Sithaw, nang loe ka buephaih ah na oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amlunghaih ka Sithaw mah na pakaa tih; ka misanawk nuiah anghoehaih to Sithaw mah na hnusak tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kaicae angvaenghaih, Aw Angraeng, nihcae to hum hmah; na hum nahaeloe kai ih kaminawk mah pahnet o ving moeng tih; na thacakhaih hoiah nihcae to anghaehsak phaeng ah loe, pakhrah tathuk ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pakha hoi tangoenghaih, kamoek pahninawk hoiah a thuih o ih lok amlaihaih pongah aman o king nasoe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Palungphuihaih hoiah nihcae to amrosak ah loe, tamit boih ah; Jakob hoi long boenghaih khoek to Sithaw mah ni uk, tiah nihcae mah panoek o nasoe. Selah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae loe duembang ah amlaem o nasoe; ui baktiah hang o nasoe loe, vangpui thungah amkae o nasoe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Buh pakronghaih hoiah ahmuen kruekah amhet o nasoe loe, zok kamthlam ah aqum puek hang o nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe kai loe na thacakhaih to laa ah ka sak han; ue, raihaih ka tong naah, nang loe kang vaenghaih hoi ka buephaih ah na oh pongah, na palungnathaih pongah akhawnbang ah hanghaih hoiah laa ka sak han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw ka thacakhaih, nang khaeah laa ka sak han; Sithaw loe ka buephaih ah oh moe, amlunghaih Sithaw ah oh.
  </para>
  <chapter number="60" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, kaicae hae nang pahnawt sut boeh, kaicae nam hetsak phang boeh moe, palung na phui boeh; kaicae khaeah angqoi let ah!
  </para>
  <para style="p">
    <verse number="2" style="v" />Long to nang huensak moe, na koihsak boeh; kakoinawk to pacong let ah, anghuen o khing vop.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangmah ih kaminawk to karai hmuen na tongsak boeh; anghmanghaih misurtui to nang naeksak boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Loktang lok ah oh pongah, nang zithaih tawn kaminawk khaeah, payang han ih pazawkhaih kahni to na paek. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang palung kaminawk loisak hanah, ka lok tahngai pae ah loe, na bantang ban hoiah pahlong ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw loe angmah ih hmuen ciim hoiah lokthuih boeh pongah, kang hoe han, Shekem vangpui to ka taphraek moe, Sukkot azawn to ka tah han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gilead loe kai ih ni, Manasseh doeh kai ih ni; Ephraim loe ka lu thacakhaih ah oh moe, Judah loe ka loihhaih ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moab loe kam saehhaih sabae kathuk ah oh; Edom nuiah khokpanai ka vah han; Philistin prae nuiah pazawkhaih hoiah ka hangh han, tiah a thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi mah maw kacak vangpui ah na caeh haih tih? Mi mah maw Edom ah na hoi tih?
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Sithaw, kaicae pahnawt kami loe, nang na ai maw? Aw Sithaw, kaicae misatuh kaminawk hoi nawnto caehsak ai kami loe, nang na ai maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Kami abomhaih loe azom pui ah oh pongah, raihaih thung hoiah ka loih o thai hanah na bomh ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sithaw rang hoiah ka pazawk o hanah, anih mah kaicae ih misanawk to khok hoiah atii pae tih.
  </para>
  <chapter number="61" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, ka qahhaih lok hae tahngai ah loe, lawk ka thuihaih hae tahngai ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Palungthin thazok naah, long boenghaih hoiah nang to kang kawk; kai pongah kasang kue lungsong khaeah na caeh haih ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang loe ka buephaih ah na oh moe, ka misanawk hmaa ah sipae kacak ah na oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang ih kahni im ah dungzan khoek to ka oh han; na pakhraeh tahlip ah ka buep han. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Sithaw, ka sak ih lokkamhaih nang thaih pae boeh; na hmin zii kaminawk ih qawk to nang paek boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siangpahrang to hinglung sawksak ah loe, boeng thai ai ah dungzan khoek to caksak poe ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe Sithaw hmaa ah dungzan khoek to om nasoe loe, tahmenhaih hoi loktang lok mah, anih to ohhaih poe nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />To naah na hmin pakoehhaih laa to ka sak poe moe, lok ka maihaih to ni thokkruek ka sak han.
  </para>
  <chapter number="62" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tangtang ni, ka hinghaih mah laisaep ai ah Sithaw to zing; kai pahlonghaih doeh anih khae hoiah ni angzoh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih khue ni ka lungsong hoi ka pahlonghaih ah oh; anih loe kai ih sipae ah oh pongah, mawnh paraihaih ka tawn mak ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kami maeto to nasetto maw na tuk o han? Kai loe amtimh tom sipae, angkhaa thai ai khongkha baktiah ni ka oh boeh, nangcae boih mah nasetto thungah maw nang hum o han vop?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe ka ohhaih hmuensang hoiah kai pakhrak hanah poek o; lok amlai o; pakha hoiah tahamhoihaih to paek o, toe palung thung hoiah loe kasae to a thuih o. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka hinghaih loe, laisaep ai ah Sithaw khue ni zing; ka oephaih doeh anih khae hoiah ni angzoh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih khue ni ka lungsong hoi ka pahlonghaih ah oh; anih loe kai ih sipae ah oh pongah, mawnh paraihaih ka tawn mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka pahlonghaih hoi ka lensawkhaih loe Sithaw khaeah ni oh; ka thacakhaih lungsong hoi ka buephaih loe Sithaw ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw kaminawk, anih khaeah amha o poe ah loe, anih khaeah palungthin to paek oh; Sithaw loe aicae abuephaih ah oh. Selah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tangtang ni, khosak kahnaem kaminawk loe takhi khue ah ni oh o, khosak sang kaminawk doeh amsawnlok thui kami ah ni oh o; tahhaih hoiah tah naah, nihcae loe takhi pongah anghoep o kue.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pacaekthlaekhaih to oep hmah loe, lomh ih hmuenmae pongah doeh amoek o hmah; hmuenmae hoi angraeng parai naah, to hmuenmae nuiah na poekhaih suem hmah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw mah lok vaito thuih; vai hnetto thuih naah, thacakhaih loe Sithaw ih ni, tiah ka thaih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Angraeng, nang loe palungnathaih hoiah na koi; nang loe kaminawk boih hanah a tok sakhaih baktih toengah tangqum to na paek.
  </para>
  <chapter number="63" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, nang loe ka Sithaw ah na oh; nang to kang pakrong han; tui om ai praezaek ah, ka pakhra mah nang hae tui ah anghaeh moe, ka taksa mah nang to poek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na thacakhaih hoi na lensawkhaih to hnuk hanah, hmuenciim ah nang kang pakrong moe, kang hnuk boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang tahmenhaih loe hinghaih pongah hoih kue baktih toengah, pahni hoiah nang kang pakoeh han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hing thung tahamhoihaih kang paek han, na hmin hoiah ban ka payangh han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tangkhring hoi kathawk moi baktiah, ka hinghaih mah zok amhah tih, ka pahni mah anghoehaih laa to sah ueloe, ka pakha mah nang to pakoeh tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka iihkhun hoi nang to kang panoek poe moe, aqum puek nang to kang poek han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang loe kai bomkung ah na oh pongah, na pakhraeh tahlip ah kang hoe han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka hinghaih loe nang khaeah ni amha, na bantang ban hoiah nang patawnh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka pakhra paro han pakrong kaminawk loe, longkhaw thungah caeh o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae loe sumsen hoi amtimh o ueloe, tasuinawk ih rawkcak ah angcoeng o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe siangpahrang loe Sithaw ah anghoe tih; anih hoi lokkamhaih sah kaminawk loe lensawk o tih; toe amsawnlok thui kaminawk ih pakha loe tamuep pae khoep tih.
  </para>
  <chapter number="64" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, lawk ka thuihaih hae tahngai ah; misa zithaih thung hoiah ka hinghaih hae pakaa ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasae kaminawk mah tamquta hoi thuih o ih lokramhaih thung hoiah na pakaa ah loe, sethaih sah kaminawk salak hoiah na hawk ah;
  </para>
  <para style="p">
    <verse number="3" style="v" />nihcae loe palai to sumsen baktiah taak o; palaa to kah hanah kalii anueng baktiah, loksae hoiah kami to patoep o,
  </para>
  <para style="p">
    <verse number="4" style="v" />coek koi om ai kami to tamquta hoi kah hanah patoep o moe, zithaih tawn ai ah anih to kah o roep.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe kasae hmuen sakhaih bangah maeto hoi maeto tha ang paek o; mi mah maw nihcae to hnu tih, tiah poek o moe, tamquta hoi thaang patung hanah a thuih o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae loe kahoih ai hmuen sak hanah pakrong o; kahoih ai hmuen to ka sak o tangtang han, palung thungah a poek o ih hmuen loe thuk parai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe Sithaw mah nihcae to palaa hoiah kat tih; nihcae loe poek ai pui hoiah ahma caa o tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angmacae ih palai to angmacae nuiah krah o sak let tih; nihcae hnu kaminawk boih cawn o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaminawk boih mah nihcae to zii o ueloe, Sithaw toksakhaih to taphong o tih, to naah anih mah sak ih hmuen to nihcae mah poek o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Katoeng kami loe Angraeng ah anghoe ueloe, anih khaeah abuep tih; poek toeng kaminawk boih lensawkhaih hoiah om o tih.
  </para>
  <chapter number="65" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, Zion mae ah, pakoehhaih mah nang to ang zing; to ah loe nang khaeah sak ih lokkamhaih baktiah sak ah om tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw lawkthuihaih pathimkung, kaminawk boih nang khaeah angzo o tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai loe zaehaihnawk mah ang kraeng khoep boeh; toe kaicae sakpazaehaihnawk to nang pasae pae tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na imthung ah oh moe, nang khaeah anghnai hanah, na qoih ih kami loe tahamhoih; kaciim na tempul hoi na im ih kahoih hmuen hoiah ka koi o tih boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Sithaw, kaicae pahlongkung, dawnrai hmuennawk to toenghaih hoiah nang pathim; nang loe long boenghaih ah kaom kaminawk boih, tuipui hoi kangthla ah kaom kaminawk hanah abuephaih ah na oh,
  </para>
  <para style="p">
    <verse number="6" style="v" />nang loe thacakhaih hoiah na koi; na thacakhaih hoiah maenawk to na sak;
  </para>
  <para style="p">
    <verse number="7" style="v" />nang loe tuipui tuen, tuiphu kangthawk tuen hoi kaminawk hanghaih lok dipsakkung ah na oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kangthla koek ah kaom kaminawk loe na sak ih angmathaih hmuennawk to zit o; aduem akhawn ni tlim ah kaom kaminawk loe nang pongah anghoehaih to tawnh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Long to na khet moe, tui na bawh; Sithaw ih vapuinawk to tui hoiah na koisak moe, long to paroeai nang raengsak; to tiah long to na sak moe, caak koi cang to nam prawksak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kakah longnawk to tui na bawh; long to kadue ah na sak; khotui hoiah long to na padung moe, kamprawk akungnawk to tahamhoihaih na paek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Saning to tahamhoihaih hoiah na khuk, na caehhaih loklam loe athawk hoiah koi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Praezaek doeh ahmuen kahoih caphoi ah na ohsak; maesomnawk doeh anghoehaih hoiah na khuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Caphoinawk kakoi ah tuunawk to na pratsak moe, azawnnawk doeh cang hoiah na koisak; nihcae loe anghoehaih hoiah hangh o moe, laa to sak o.
  </para>
  <chapter number="66" style="c" />
  <para style="p">
    <verse number="1" style="v" />Long boih, anghoehaih hoi Sithaw khaeah hang oh!
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih ih ahmin lensawkhaih laa to sah oh loe, lensawk parai ah pakoeh oh!
  </para>
  <para style="p">
    <verse number="3" style="v" />Sithaw khaeah, na sak ih hmuennawk loe kawkkruk maw dawnrai han oh! Na misanawk loe kalen parai na thacakhaih hoiah na hmaa ah tabok o tih, tiah thui oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Longnawk boih mah nang to bok o ueloe, nang saphawhaih laa to sah o tih; na hmin saphawhaih laa to sah o tih. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angzo oh loe, Sithaw mah sak ih hmuennawk to khen oh; kaminawk salakah a sak ih hmuennawk loe anghmang han koi oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah tuipui to saoeng ah angcoengsak; to naah kaminawk loe tui ohhaih ahmuen ah khok hoiah caeh o, kaicae loe anih ah anghoehaih ka tawnh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah a thacakhaih hoiah dungzan khoek to uk; a mik hoiah kaminawk boih to khet; misa koeh kaminawk loe amoek o hmah nasoe. Selah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw kaminawk boih, kaicae ih Sithaw hae tahamhoihaih paek oh; kangthaih ah anih to saphaw oh;
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih mah aicae hinghaih to patawnh moe, aicae ih khok doeh amthaeksak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Sithaw, kaicae hae nang tanoek boeh; sumkanglung to hmai hoiah pakaw ih baktiah, kaicae hae nang tanoek boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palok pongah nang mansak moe, hmuenzit nang phawhsak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaicae lu nuiah kaminawk to nang thuengsak; hmai hoiah tui thungah ka caeh o; toe angraenghaih ahmuen ah nang hoih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai loe hmai angbawnhaih hoiah na im ah ka caeh han; nang khaeah ka sak ih lokmaihaih baktiah ka ohsak han,
  </para>
  <para style="p">
    <verse number="14" style="v" />raihaih ka tongh naah, ka pahni mah to tiah lokkamhaih to sak moe, ka pakha mah lok a thuih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kathawk moi hoiah nang khaeah hmai angbawnhaih ka sak moe, hmuihoih ah tuunawk to kang paek han; maitaw taenawk hoi maeh taenawk doeh kang paek han. Selah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangcae, Sithaw zii kaminawk, angzo oh loe tahngai oh; ka hinghaih nuiah anih mah sak ih hmuen kawng to kang thuih o han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka pakha hoiah anih khaeah ka hang moe, ka palai hoiah anih to ka pakoeh boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palung thungah zaehaih ka suek poe nahaeloe, Angraeng mah ka lok hae tahngai mak ai;
  </para>
  <para style="p">
    <verse number="19" style="v" />toe Sithaw mah ka lok ang tahngai pae tangtang; lawk ka thuihaih lok to ang tahngaih pae.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lawk ka thuihaih anghmasak ai, ka nuiah suek ih a palungnathaih to apet ai, Sithaw khaeah tahamhoihaih om nasoe!
  </para>
  <chapter number="67" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw mah aicae tahmen nasoe loe, tahamhoihaih na paek nasoe; anih ih krang aicae nuiah aang nasoe. Selah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na loklam to long nuiah panoek o nasoe loe, kaminawk boih mah na pahlonghaih to panoek o nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Sithaw, kaminawk mah nang to saphaw o nasoe loe, kaminawk boih mah nang saphaw o nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Prae kaminawk anghoe o nasoe loe, anghoehaih laa to sah o nasoe; nang loe toenghaih hoiah kaminawk to lok na caek tih, long nuiah prae kaminawk to uk tih. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Sithaw, kaminawk mah nang to saphaw o nasoe loe, kaminawk boih mah nang to saphaw o nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Long mah athaih tacawtsak ueloe, Sithaw, aicae ih Sithaw mah tahamhoihaih paek tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sithaw mah aicae tahamhoihaih na paek tih; long boenghaih ah kaom kaminawk boih mah doeh anih to zii o tih.
  </para>
  <chapter number="68" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw loe angthawk nasoe, anih ih misanawk loe anghaeh o phang nasoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Takhi mah hmaikhue hmuh phaeng baktih toengah, nihcae to hmut phaeng ah; hmai pongah amkaw dui samdai baktiah, kasae kaminawk loe Sithaw hmaa ah anghma angtaa o nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe katoeng kaminawk loe anghoe o nasoe; nihcae loe Sithaw hmaa ah oep o nasoe; ue, paroeai anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw khaeah laasah oh; ahmin saphawhaih laa to sah oh; tamai nuiah angthueng anih to pakoeh oh; anih ih ahmin loe YAH, anih hmaa ah anghoe oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe ampa tawn ai kaminawk hanah ampa ah oh moe, lamhmainawk bomkung ah oh, Sithaw loe a ohhaih hmuenciim ah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw mah angmabueng kaom kami to imthong ah angcoengsak; thongkrah kaminawk doeh a loihsak; toe lok angaek thaih kaminawk loe prae karoem ah oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Sithaw, nang loe nangmah ih kaminawk hmaa ah na caeh moe, praezaek hoi na caeh haih naah, Selah;
  </para>
  <para style="p">
    <verse number="8" style="v" />Sithaw hmaa ah, long to anghuenh, van hoiah kho angzoh; Sinai mae loe Sithaw, Israel Sithaw hmaa ah anghuenh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Sithaw, nangmah pop parai ah kho nang zohsak; thazai sut na qawktoep kaminawk to na bomh boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmah ih kaminawk loe athung ah oh o; Aw Sithaw, na angraenghaih thung hoiah amtang kaminawk to na pacah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah thuih ih lok taphong kaminawk loe noih o parai:
  </para>
  <para style="p">
    <verse number="12" style="v" />siangpahrangnawk ih misatuh kaminawk loe, tawt hoiah cawnh o; im ah kaom kaminawk loe lak ih hmuenmaenawk to amzet o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangcae loe mae salakah na iih o cadoeh, sumkanglung hoi pazut ih pahuu pakhraeh baktiah na om o ueloe, amuinawk doeh sui rong baktiah ampha tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thacak Angraeng mah siangpahrangnawk prae thungah anghaehsak phang naah, Salmon mae nuiah dantui kanglung baktiah oh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sithaw ih mae loe Bashan mae baktiah oh; kasang mae doeh Bashan mae baktiah ni oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Maesangnawk, athung ah oh hanah Sithaw mah qoih ih mae; ue, dungzan khoek to Angraeng ohhaih mae to, tih hanah uthaih hoiah na khet o loe?
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw misatukhaih hrangleeng loe sang pumphaeto oh, vankaminawk loe sangto pacoeng sangto oh o; Angraeng loe nihcae salakah oh, Sinai mae loe angmah ih hmuenciim ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang loe hmuensang ah na dawh tahang moe, misong ah naeh ih kaminawk to na hoih tahang; ue, Angraeng Sithaw nihcae salakah oh thaih hanah, kaminawk han khue ai, angaek thaih kaminawk han doeh, tangqum to na talawk pae.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni thokkruek aicae ih hmuenzit phaw Angraeng, aicae pahlongkung, Sithaw loe tahamhoihaih om nasoe. Selah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih loe aicae ih Sithaw, pahlonghaih Sithaw ah oh; Angraeng Sithaw loe duekhaih thung hoi loihaih ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A misanawk ih lu, zaehaih sah kaminawk ih sam kathah lunawk to, caeh taak ai ah Sithaw mah atii tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng mah, nihcae to Bashan hoi kang zoh haih let han, kaimah ih kaminawk to kathuk tuipui thung hoiah kang hoih let han,
  </para>
  <para style="p">
    <verse number="23" style="v" />na misanawk ih athii to khok hoiah na cawh ueloe, nang ih uinawk mah doeh athii to palaek o tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aw Sithaw, hmuenciim ah nang zohhaih to nihcae mah hnuk o boeh, ka Sithaw, ka Siangpahrang angzohhaih to nihcae mah hnuk o boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laasah kaminawk loe hmabang ah caeh o, katoeng tamoi congca kruek kaminawk hoi nihcae salakah cingceng bop tanglanawk loe, anih hnuk ah bang o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel kaminawk, kami pop amkhuenghaih ahmuen ah, Sithaw to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamin acaeng zetta thung hoi ih nihcae zaehoikung, Judah ih angraengnawk, Zebulun ih angraengnawk hoi Nephtali ih angraengnawk to athum o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aw Sithaw, thacaksak ah, Sithaw, kaicae khae na sak ih baktih toengah, na thacakhaih to na patuek ah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na tempul loe Jerusalem ah oh pongah, siangpahrangnawk mah nang khaeah tangqum sin o nasoe.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tuu thung ih kasan moinawk, maitaw taenawk hoi kaminawk ih maitaw caanawk to thuitaek ah, kami boih mah sumkanglung sin o nasoe loe, mi tlim ah om o nasoe; misa koeh kaminawk to anghaehsak phang ah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Laicaehnawk loe Izip prae thung hoiah angzo o tih; Ethiopia loe Sithaw khaeah ban payangh ueloe, ang paek tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Long ih praenawk, Sithaw khaeah laasah oh; Angraeng saphawhaih laa to sah oh, Selah;
  </para>
  <para style="p">
    <verse number="33" style="v" />tangsuek hoi vannawk nui ih van angthueng, Anih khaeah, saphawhaih laa to sah oh; khenah, anih mah lok tacawtsak naah, thacak parai lok ah angcoeng.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sithaw loe thacak, tiah thui oh; a lensawkhaih loe Israel caanawk nuiah oh moe, a thacakhaih doeh tamai nuiah amtueng.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aw Sithaw, kaciim angmah ih hmuenciimnawk thungah kaom nang loe zitthoh; Israel Sithaw loe, angmah ih kaminawk hanah thacakhaih hoi sakthaihaih paekkung ah oh. Sithaw loe tahamhoihaih om nasoe!
  </para>
  <chapter number="69" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, na pahlong ah, tui loe ka hinghaih khoek to phak boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khok cawhhaih om ai, tangnong thungah ka krak boeh; kathuk parai tui thungah, tui ka uem boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka hang loiah, taaw doeh zaek sut boeh; ka Sithaw, ka khet naah, ka mik doeh amtueng ai boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tidoeh na ai ah kai hnuma kaminawk loe ka lu nui ih sam pongah doeh pop o kue; tidoeh na ai ah kai hum hanah, pakrong ka misanawk loe thacak o parai; ka lak ai ih hmuen to ka paek let.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Sithaw, kam thuhaih hae nang panoek; ka zaehaihnawk loe na hmaa hoiah hawk thai ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw misatuh kaminawk ih Angraeng Sithaw, nang oephaih tawn kaminawk loe, kai pongah palung boenghaih tawn o hmah nasoe; Aw Israelnawk ih Sithaw, nang pakrong kaminawk loe kai pongah azathaih tongh o hmah nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang hanah kasaethuihaih ka tongh boeh; azathaih mah ka mikhmai hae khuk khoep boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai loe kaimah ih nawkamya khaeah angvin ah ka oh moe, kam no ih caanawk khaeah prae kalah kami ah ka oh boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang ih im poekhaih mah kai ang caak boih boeh; nang kasaethui kaminawk mah thuih ih sethaih to ka nuiah krak boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Buhzah moe, qahhaih hoi lawk ka thuih naah doeh, kai kasae ang thuih o haih to ka pauep vop.
  </para>
  <para style="p">
    <verse number="11" style="v" />Buri khukbuen kang khuk naah, minawk mah ang pahnuih o thuih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khongkha ah anghnu kaminawk mah kai ang pahnui o thuih; mu paquih kaminawk mah kai han laa ang sak o thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />AwAngraeng, kai loe talawkhaih atue ah, nang khaeah lawk kang thuih; aw Sithaw, kanoih parai na palungnathaih hoi na pahlonghaih loktang lok hoiah ka lok hae na tahngai pae ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tangnong thungah na krahsak hmah, na loihsak ah; kai hnuma kaminawk ban thung hoi na pahlong ah loe, kathuk tui thung hoi na pahlong ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuilen mah kai na khuk hmah nasoe, kathuk tui mah na paaeh hmah nasoe, tangqom mah doeh na paaeh hmah nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw Angraeng, nam lunghaih loe hoih pongah, ka lok hae tahngai ah; kalen na palungnathaih hoiah kai khaeah angqoi raeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tamna khaeah na mikhmai hawk ving hmah; raihaih ka tong boeh; karangah na tahngai pae ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka pakhra khaeah anghnai ah loe, pahlong ah; ka misanawk thung hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka tongh ih kasaethuihaih, azathaih hoi ahminsethaih to na panoek; ka misanawk loe ka hmaa ah ni oh o boih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kasaethuihaih mah kai ih palungthin to koihsak; paroeai palung ka boeng; tahmenhaih tawn kami to ka pakrong, toe mi doeh om ai; pathloepkung to ka pakrong, toe mi doeh ka hnu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka caak hanah nihcae mah kakhaa ahmuet to ang paek o; tui kang haeh naah naek hanah misurtui kathaw to ang paek o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae ih caboi loe angmacae hmaa ah thaang ah om nasoe loe, nihcae khosak hoihaih doeh peet ah angcoeng pae nasoe.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nihcae mah hnuk o han ai ah, mik amtueng pae hmah nasoe; nihcae ih kaeng doeh thacak hmah nasoe.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nihcae nuiah palung na phuihaih to krai ah loe, na palung bethaih mah nihcae to pha thuih nasoe.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae ohhaih ahmuen to pong sut nasoe loe, nihcae ih buk ah mi doeh om hmah nasoe.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tipongah tih nahaeloe na boh ih kaminawk to nihcae mah pacaekpathlaek o; nganbawh kana na paek ih kaminawk to kasae a thuih o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae sakpazaehaih to zaehaih hoiah patomh pae ah; nihcae loe na toenghaih thungah angzo o hmah nasoe.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hinghaih cabu thung hoiah nihcae to phrae ah, nihcae to katoeng kaminawk hoi nawnto tarik hmah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kai loe amtang pongah, palung ka set boeh; Aw Sithaw, na pahlonghaih mah na sangsak nasoe.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai loe Sithaw ahmin pakoehhaih laa to ka sak han; anghoe lokthuihaih hoiah anih to ka pakoeh han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Takii hoi khokpacin kaom, maitaw hoi maitaw tae paek pongah loe hae tiah sakhaih hae Angraeng mah koeh kue tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Poek pahnaem kaminawk loe to baktih hmuen to hnu o ueloe, anghoe o tih; Sithaw pakrong kami ih palungthin loe hing tih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Angraeng loe amtang kaminawk ih lok to tahngaih pae; thongkrah angmah ih kaminawk doeh pahnet ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Van hoi long mah anih to saphaw nasoe; tuipui hoi athung ah kaom kangtawt thaih hmuennawk boih mah doeh anih to saphaw o nasoe.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tipongah tih nahaeloe Zion mae loe Sithaw mah pahlong ueloe, Judah vangpuinawk to sah let tih; to naah nihcae mah la o ueloe, athung ah khosah o tih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih tamnanawk ih caanawk mah doeh to vangpui to toep o tih; ahmin palung kaminawk loe to vang thungah om o tih.
  </para>
  <chapter number="70" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, karangah na pahlong ah; Aw Angraeng, kai abomh hanah karangah angzo ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka hinghaih lak han pakrong kaminawk loe azathaih tongh o nasoe loe, anghmanghaih hoiah om o nasoe; kai raihaih paek koeh kaminawk loe hnuk amlaem o nasoe loe, palungboenghaih hoiah om o nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai hanah Aha, Aha, tiah pahnuithuih kaminawk loe azathaih hoiah amlaem o let nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang pakrong kaminawk boih, nang ah anghoe o nasoe loe, nawm o nasoe; na pahlonghaih koeh kaminawk mah, Sithaw loe dungzan khoek to lensawkhaih om nasoe, tiah thui o nasoe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toe kai loe amtang moe, caaknaek vawt kami ah ka oh; Aw Sithaw, kai khaeah karangah angzo ah; nang loe kai bomkung hoi kai pahlongkung ah na oh; aw Angraeng, akra hmah.
  </para>
  <chapter number="71" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, nang thungah ni kang hawk; natuek naah doeh azathaih na tongsak hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na toenghaih hoi pahlong ah loe, na loisak ah; kai khaeah na naa to patueng ah loe, na pahlong ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka phak thaihaih ahmuen kruekah, ka buephaih ah om ah; nang loe ka lungsong hoi kang vaenghaih ah na oh pongah, kai pahlong hanah lok na paek boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw ka Sithaw, kami zaenawk ih ban thung hoiah pahlong ah, katoeng ai kami hoi hmawsaeng kaminawk ih ban thung hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng Sithaw, nang loe ka oephaih akung pui ah na oh; ka thendoeng nathuem hoi boeh ni nang loe kang oephaih ah na oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka tapen tangsuek nathuem hoi nang khaeah kam ha boeh; nang mah ni kam no zok thung hoiah nang lak. Nang loe dungzan ah kang pakoeh han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai loe kanoih kaminawk dawnrai han koi ah ni ka oh; toe nang loe kacak ka buephaih ah na oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka pakha loe athun qui nang pakoehhaih, na lensawkhaih hoiah koi nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai mitong naah na pahnawt sut hmah; ka thaboeng naah na caeh taak hmah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka misanawk loe kai aekhaih lok to thuih o; ka hinghaih patoem kaminawk loe nawnto amkhueng o,
  </para>
  <para style="p">
    <verse number="11" style="v" />anih loe Sithaw mah pahnawt sut boeh; patom oh loe naeh oh; anih bomkung mi doeh om ai boeh, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Sithaw, kangthla ah na om taak ving hmah; aw ka Sithaw, kai abomh hanah karangah angzo ah!
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka hinghaih misa ah poek kaminawk loe azathaih hoiah anghma angtaa o nasoe; kai nganbawh kana paek han pakrong kaminawk loe pronghaih hoi ahminsethaih mah kraeng khoep nasoe.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe kai loe oephaih ka tawnh poe pongah, nang to kang pakoeh aep aep han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nazetto maw tiah ka panoek ai cadoeh, ka pakha mah na toenghaih hoi na pahlonghaih to ni thokkruek thui tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai loe Angraeng Sithaw thacakhaih hoiah ka caeh, na toenghaih khue ni ka thuih han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Sithaw, ka thendoeng nathuem hoiah nang patuk boeh; na sak ih dawnrai hmuennawk to vaihni khoek to ka thuih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Sithaw, kai loe vaihi mitong boeh, na thacakhaih to sampok khoek to, vaihi dung ih kaminawk khaeah ka thuih moe, na sakthaihaih to angzo han koi kaminawk khaeah ka thui ai karoek to, na pahnawt sut hmah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Sithaw, kalen parai hmuennawk sahkung, na toenghaih loe van khoek to phak; Aw Sithaw, nang baktih mi maw kaom?
  </para>
  <para style="p">
    <verse number="20" style="v" />Kalen parai raihaih to nang patuek boeh; nang mah nang hingsak let ueloe, kathuk long thung hoiah kai nang thawksak let tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai khosak hoihhaih to pungsak ueloe, na pathloep let tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw ka Sithaw, nang hoi na loktang lok to katoeng hoiah kang pakoeh han; aw Israelnawk ih Ciimcai Sithaw, katoeng kruekhaih hoiah nang pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang khaeah laa ka sak naah, ka palainawk anghoe o ueloe, na krang ih ka hinghaih doeh anghoe tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni thokkruek ka palai mah na toenghaih to thui tih; kai nganbawh kana paek hanah pakrong kaminawk loe, azathaih to tongh o moe, dawnraihaih hoiah oh o sut boeh.
  </para>
  <chapter number="72" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, katoeng na lokcaekhaih to siangpahrang han paek ah loe, na toenghaih to siangpahrang ih capa hanah paek ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih loe nangmah ih kaminawk to toenghaih hoiah lokcaek ueloe, nangmah ih amtang kaminawk hanah toenghaih to paek tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Maenawk mah kaminawk khaeah monghaih to sin tih; maesomnawk mah toenghaih athaih to sin pae tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah amtang kaminawk to lokcaek tih; kavawt kaminawk ih caanawk to pahlong ueloe, pacaekthlaek kaminawk to anghma angtaasak tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ni hoi khrah oh nathung, adung kaminawk boih mah, nang to zii o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih loe aah kok ih phroh nuiah kakrah khotui baktih, long duksak khotui baktiah, angzo tathuk tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng kami loe anih oh nathung khosak hoihaih to tawn o tih; khrah anghma ai karoek to, pop parai monghaih to om tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuipui maeto hoi maeto bang khoek to, vapui hoi long boenghaih khoek to, anih mah uk tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Praezaek ah kaom kaminawk loe anih hmaa ah tabok o tih; a misanawk loe maiphu to palaek o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tarshish siangpahrang hoi tuipui thungah kaom prae ukkung siangpahrangnawk mah tangqum to sin o tih; Sheba hoi Seba siangpahrangnawk mah doeh tangqum to paek o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ue, siangpahrangnawk boih anih hmaa ah tabok o tih; prae congca kaminawk boih mah anih ih tok to sah pae o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kavawt kami hoi bomkung tawn ai amtang kaminawk qah o naah, anih mah pathloep tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah amtang kami hoi kavawt kaminawk to tahmen ueloe, kavawt kaminawk hinghaih to pahlong tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alinghaih hoi pacaekthlaekhaih thung hoiah nihcae hinghaih to loisak tih; nihcae ih athii loe a mikhnuk ah atho om tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loe hinglung sawk tih; anih khaeah Sheba ih sui to paek o tih; apet ai ah anih han lawkthui pae o ueloe, ni thokkruek anih to saphaw o tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Long ah cang pung tih, Lebanon baktiah maesangnawk nuiah athaih tacawt tih; vangpui thung ih kaminawk loe long ih phroh baktiah qoeng o tahang tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahmin loe dungzan khoek to cak tih; ni oh nathung Anih ih ahmin to om poe tih. Anih rang hoiah kaminawk tahamhoih o tih; prae congca kaminawk mah anih to tahamhoihaih, tiah kawk o tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel Sithaw, Angraeng Sithaw loe tahamhoihaih om nasoe; anih mah khue ni dawnrai hmuennawk to sak!
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih ih ahmin lensawkhaih loe dungzan khoek to om nasoe! Long boih a lensawkhaih hoiah koi nasoe. Amen hoi Amen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesse capa David lawkthuihaihnawk loe boeng boeh.
  </para>
  <chapter number="73" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw loe poekciim kami hoi Israelnawk nuiah hoih tangtang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toe ka khok loe amthaek tom boeh; kang doethaih ahmuen angthuih tom boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Poeksae kaminawk mah hnuk o ih tahamhoihaih to ka hnuk naah, amthu kaminawk to ka khit moeng boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe duek naah patangkhang o ai; ngantui o moe, thacak o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe minawk kalah baktiah raihaih panoek o ai; minawk baktiah patang o ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah amoekhaih to bungmu baktiah a oih o; pacaekthlaekhaih to khukbuen baktiah angkhuk o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmuenmae hoi angraeng o pongah, nihcae ih mik loe tasa bangah tacawt dok; nihcae loe palung thung hoi poek ih hmuen pongah kamthlai ah koeh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae mah kahoih ai pacaekthlaekhaih to pahnuih o thuih; amoekhaih lok apaeh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae loe pakha hoiah vannawk to kasae thuih o moe, palai to long pum ah amkaeh o sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pongah Sithaw mah angmah ih kaminawk to amlaemsak let moe, a paek ih tui to kamhah ah naek o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae mah, Kawbangmaw Sithaw mah panoek tih? Kasang koek ah kaom loe panoekhaih tawnh maw? tiah thuih o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khenah, Sithaw panoek ai kaminawk loe hae tiah oh o; nihcae loe long nuiah khosak hoih o moe, angraeng o aep aep.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tangtang ni, ka suek ih kaciim poekhaih loe azom pui ni; zaehaih om ai ah kam saeh ih ban doeh azom pui ah ni oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ni thokkruek patang ka khang, akhawnbang kruek thuitaekhaih to ka tongh.
  </para>
  <para style="p">
    <verse number="15" style="v" />To tiah kasae thuih han ka poek nahaeloe, khenah, na caanawk nuiah kasae sah kami ah ni ka om tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hae hmuen hae kawbangmaw ka panoek thaih han, tiah ka poek naah, kai hanah loe panoek han rai parai hmuen ah oh;
  </para>
  <para style="p">
    <verse number="17" style="v" />hnukkhuem ah loe Sithaw ih hmuenciim thungah ka phak, to naah ni to hmuennawk boenghaih to ka panoek thai vop.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tangtang thuih nahaeloe nang mah ni nihcae to kamnae ahmuen ah na suek moe, nihcae to amrohaih thungah na vah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae loe kawbangmaw, nawnetta thungah amro o halat! Hnukkhuem ah loe zitthok hmuen mah nihcae to paduek boih boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kami mah angthawk naah amang to poek baktih toengah, Aw Angraeng, nang thawk tahang naah, nihcae poekhaih to tiah doeh sah pae hmah.
  </para>
  <para style="p">
    <verse number="21" style="v" />To tiah palung ka nat moe, ka poekhaih anghmang sut.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai loe amthu kami, tidoeh panoek ai kami ah ka oh; na hmaa ah kasan moi baktiah ni ka oh sut boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe kai loe nang khaeah ka oh poe; ka bantang ban hae nang patawnh pae.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangmah loe na thoemhaih hoiah loklam nang patuek ueloe, lensawkhaih thungah nang caeh haih tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang ai ah loe van ah ka tawnh ih mi maw oh vop? Nang pacoengah loe long nuiah ka koeh ih mi doeh om ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka ngan hoi ka palung loe amro boeh; toe Sithaw loe ka palungthin thacakhaih ah oh moe, dungzan ah kai ih taham ah ni oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khenah, nang hoi angthla kaminawk loe amro o boih tih; nang khae hoi amkhraeng moe, oep om ai ah khosah kaminawk loe nam rosak boih tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toe kai loe Sithaw khaeah anghnaih han hoih; na toksakhaihnawk boih ka thuih hanah, Angraeng Sithaw khaeah ka buep.
  </para>
  <chapter number="74" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, tipongah dungzan khoek to nang pahnawt loe? Tipongah nangmah ih caphoih ahmuen ah kapra tuunawk nuiah palung na phui loe?
  </para>
  <para style="p">
    <verse number="2" style="v" />Canghnii hoiah na qan ih kaminawk, na qawktoep acaengnawk hoi na ohhaih Zion mae to poek ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaciim ahmuen to misanawk mah paro o boih boeh pongah, dungzan ah kamro ahmuen ah na khok to paqoi lai ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na misanawk loe nangmah ih kaminawk salakah hang o; nihcae loe angmacae angmathaih kahni to payang o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe caka hoi tu thung ih thing pakhruh kaminawk baktiah oh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe vaihi loe sak ih hmuennawk to caki hoi cakanawk hoiah a saek o boih boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na hmuenciim to hmai hoiah a thlaek o boeh; na hmin ohhaih ahmuen doeh long ah vah o moe, panuet thok ah a sak o boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae mah, Hae kaminawk hae paduek boih si, tiah thuih o moe, prae thung ih Sithaw bokhaih ahmuennawk to hmai hoiah thlaek o boih boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaicae loe kaimacae angmathaih tidoeh ka hnu o ai; tahmaanawk doeh om o ai boeh; nasetto maw hae tiah om vop tih, tiah panoek kami kaicae thungah mi doeh om ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Sithaw, nasetto maw misa mah kasaethui vop tih? Misa mah na hmin kasae thui poe tih maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Tipongah na ban, na bantang ban to na zuh let loe? Na saoek thung hoiah pathok ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sithaw loe canghnii hoiah ni kai ih siangpahrang ah oh boeh; anih mah ni long nuiah pahlonghaih to sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na thacakhaih hoiah tuipui to na pakhoih; tuipuinawk thung ih pahui puinawk ih lu to na khaeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Leviathan ih lunawk to na koihsak phaeng moe, praezaek ah kaom kaminawk hanah buh ah na paek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmah ni tuibap tui hoi vacong tuinawk to na longsak; vapui tuinawk doeh na kaangsak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khodai loe nang ih ni, khoving doeh nang ih ni; nangmah ni ni hoi aanghaih to na sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmah ni long angzithaih ramrinawk to na sak moe, nipui hoi siktue doeh na sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Angraeng, misa mah kasaethuihaih to poek ah; kamthunawk mah loe na hmin to patoek o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangmah ih pahuu tuinom hinghaih to kasae kaminawk khaeah paek hmah; nangmah ih amtang kaminawk to dungzan khoek to pahnet hmah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lokkamhaih to poek ah; long khoving ahmuennawk loe pacaekthlaekhaih hoiah koi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Patangkhang kaminawk to palung boengsak hmah; kamtang hoi kavawt kaminawk mah na hmin to saphaw o nasoe.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Sithaw, angthawk tahang ah loe, na sak ih hmuen to pakaa ah; kawbangmaw kamthunawk mah nang sethaih kawng ni thokkruek thuih o, tito panoek ah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na misanawk ih lok to pahnet hmah; na misanawk hanghaih lok loe pop aep aep boeh.
  </para>
  <chapter number="75" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, anghoehaih lok kang thuih o; nang khaeah anghoehaih lawk kang thuih o; na hmin loe anghnaih boeh, tiah dawnrai na toksakhaih hmuennawk mah amtuengsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kahoih atue khaehhaih to ka hnuk naah, katoeng ah lok ka caek han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Long hoi kaminawk boih tasoeh o naah, tungnawk to kacakah ka patawnh pae. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamthunawk khaeah, amthu o hmah lai ah; kasae kaminawk khaeah, taki pathawk tahang hmah;
  </para>
  <para style="p">
    <verse number="5" style="v" />na taki to van bangah pathawk tahang hmah; tahnong payuengh tahanghaih hoiah lok to thui hmah, tiah ka naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakoehhaih loe ni angyae bang, niduem bang, to tih ai boeh loe aloih bang hoiah doeh angzo ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe lokcaekkung loe Sithaw ni; maeto loe pakhrak tathuk, maeto loe pasangh tahang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng ban ah boengloeng maeto oh; misurtui loe thim moe, ahmui congca hoi angbaeh; anih mah to misurtui to kraih; kanghmat to long ih kasae kaminawk boih mah naek o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe kai loe dungzan khoek to ka taphong han; Jakob ih Sithaw khaeah pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kasae kaminawk ih takiinawk to ka boeng pae boih han; toe katoeng kaminawk ih taki loe pakoehhaih om tih.
  </para>
  <chapter number="76" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah prae ah Sithaw to panoek o; Anih ih ahmin loe Israel prae ah amthang parai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ani ih kahni im loe Salem ah oh, anih oh ohhaih ahmuen loe Zion mae ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />To ahmuen ah kalii, palaanawk, angvaenghaih sumsen, misatukhaih hmuennawk to na paro pae boih boeh. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang loe moinawk prathaih maenawk pongah doeh na len moe, na hoih kue.
  </para>
  <para style="p">
    <verse number="5" style="v" />Misahoih kaminawk to lomh o boeh; iih angmuethaih mah nihcae to muek boeh; thacak kaminawk mi mah doeh nihcae ih ban to hnu o ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Jakob Sithaw, na thuitaekhaih rang hoiah hrang lakok hoi hrangnawk to na iihsak muen boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zit han koi kaom loe nang khue ni; palung na phui naah mi maw na hmaa ah angdoe thai tih?
  </para>
  <para style="p">
    <verse number="8" style="v" />Na lokcaekhaih to van hoiah na taphong;
  </para>
  <para style="p">
    <verse number="9" style="v" />long nui ih poeknaem kaminawk to pahlong boih hanah, Sithaw mah lokcaek han angdoet tahang naah, long loe zit moe, angam sut. Selah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tangtang ni palungphui kaminawk mah nang to saphaw o tih; kadip thai ai palungphuihaih mah nang to zaeng tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na Angraeng Sithaw khaeah na lokkamhaih to akoepsak ah; ataeng ah kaom kaminawk boih mah zit kaom anih khaeah, tangqumnawk to sin o nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih mah angraengnawk ih poekhaih to pahnaem pae tih; anih loe long siangpahrangnawk hanah zit thoh.
  </para>
  <chapter number="77" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw khaeah ka hangh; ka hangh naah, anih mah ka lok ang tahngaih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Raihaih ka tong naah Angraeng to ka pakrong; angpho ai ah aqum ah ban ka payangh; ka hinghaih mah pathloephaih to koeh ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sithaw ka poek moe, raihaih ka tong; ka poek het naah ka muithla angpho. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang mah ka mik pakhrip thai ai ah nang suek; raihaih ka tong pongah lok ka pae thai ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kalaem tangcae aninawk hoi canghnii ih adungnawk to ka poek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aqum ah kaimah ih laa to ka poek; kaimah ih palung hoiah lok ka paeh hoi; to naah ka muithla mah lok ang dueng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng mah dungzan khoek to pahnawt tih boeh maw? A tahmenhaih amtuengsak mak ai boeh maw?
  </para>
  <para style="p">
    <verse number="8" style="v" />A palungnathaih to dungzan khoek to boeng tih boeh maw? A lokkamhaih doeh amro poe tih boeh maw?
  </para>
  <para style="p">
    <verse number="9" style="v" />Tahmen hanah Sithaw mah pahnet boeh maw? Palungphui pongah palungnathaih thok to khah ving boeh maw? Selah.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah raihaih ka tong; toe Kasang koek bantang ban hoiah sak ih saningnawk to ka poek han, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah sak ih hmuennawk to ka poek han; canghnii ah na sak ih dawnrai hmuennawk to ka pakuem poe han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na toksakhaihnawk boih to ka poek moe, na toksakhaihnawk to ka thuih han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Sithaw, na loklam loe ciim; aicae Sithaw baktiah lensawk Sithaw mi maw om vop?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang loe dawnrai hmuennawk sah Sithaw ah na oh; na thacakhaih to minawk salakah nam tuengsak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na ban thacakhaih hoiah nangmah ih kaminawk, Jakob hoi Joseph ih caanawk to na pahlong. Selah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw Sithaw, tuinawk mah nang ang hnuk o; tuinawk mah nang ang hnuk o naah, ang zit o; kathuk tuinawk doeh tasoeh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tamainawk mah tui to kraih o; vannawk ah khopazih; nang ih kaliinawk doeh ahmuen kruekah krak o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang ih khopazih tuen loe van ah oh; tangphrapuekhaih mah long to toeh; long loe tasoeh moe, anghuenh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na loklam loe tuipui thungah oh, na caehhaih loklam loe kalen tuipuinawk thungah oh, na khok tangkannawk loe amtueng ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosi hoi Aaron ih ban hoiah nangmah ih kaminawk to tuunawk baktiah na hoih.
  </para>
  <chapter number="78" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw kai ih kaminawk, kang patuk ih kaalok ah naa to patueng oh loe, ka pakha hoi tacawt loknawk hae tahngai oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Patahhaih hoiah pakha to ka paongh moe, canghnii ah thuih ih kathuk loknawk to kang thuih o han,
  </para>
  <para style="p">
    <verse number="3" style="v" />to loknawk loe aicae ampanawk mah aicae khaeah thuih o boeh, aicae mah a thaih o moe, a panoek o boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae ih caanawk khaeah kang phat pae o mak ai; Angraeng saphawhaih, a thacakhaih, a sak ih dawnrai hmuennawk loe, angzo han koi adung kaminawk khaeah amtuengsak tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakob acaeng hanah lok a paek, Israel caanawk khaeah kaalok to a caksak, anih mah aicae ampanawk khaeah, na caanawk han patuk o patoeng ah:
  </para>
  <para style="p">
    <verse number="6" style="v" />angzo han koi nawktanawk hoi tapen han koi nawktanawk mah doeh panoek o moe, a caanawk khaeah thuih pae o patoeng hanah,
  </para>
  <para style="p">
    <verse number="7" style="v" />Sithaw to oep o moe, Sithaw mah sak ih hmuennawk to pahnet ai ah, a paek ih loknawk to pazui o hanah, lokthui pae ah:
  </para>
  <para style="p">
    <verse number="8" style="v" />nihcae loe palung thah o moe, laisaep o thaih, poek toeng ai kami, Sithaw oephaih muithla tawn ai, ampanawk baktiah om o ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ephraim caanawk loe kalii avak o moe, misa to tuk o, toe hnukbangah amlaem o let.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae loe Sithaw lokmaihaih to pakuem o ai, anih mah paek ih kaalok to pazui han koeh o ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae loe anih mah sak ih toknawk hoi nihcae khaeah amtuengsak ih dawnrai hmuennawk to pahnet o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Izip prae, Zoan ah ampanawk hmaa ah anih mah dawnrai hmuennawk to sak pae.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah tuipui to pakhoih moe, tui to angkatsak; tuinawk to tapang baktiah angdoetsak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khodai ah tamai hoiah a zaeh, khoving ah aqum puek hmaithaw hoiah a hoih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Praezaek ah lungsongnawk to boh moe, tuipui baktiah pop parai tui to nihcae hanah a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thlung thung hoiah tui to tacawtsak moe, tuinawk to vapui baktiah a longsak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe nihcae loe anih nuiah zaehaih to sak o aep, Kasang koek to praezaek ah laisaep o thuih vop.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angmacae zok kamthlam dipsak han ih khue ni Sithaw to tanoek o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ue, nihcae loe Sithaw aekhaih lok to thuih o; praezaek ah Sithaw mah caboi na baih pae tang tih maw? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khenah, thlung a boh naah, tui to tacawt moe, pop parai vacong tui ah longh; takaw doeh na paek thai tih maw? Angmah ih kaminawk hanah moi doeh paek thai tih maw? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Angraeng mah to lok to thaih naah, palungphui; Jakob acaengnawk to hmai mah kangh moe, Israel caanawk nuiah palungphuihaih to phak,
  </para>
  <para style="p">
    <verse number="22" style="v" />tipongah tih nahaeloe nihcae loe Sithaw tang o ai, anih ih pahlonghaih ah doeh oephaih to tawn o ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe anih mah ranui ih tamai to lokpaek moe, van thoknawk to amongh,
  </para>
  <para style="p">
    <verse number="24" style="v" />caak hanah nihcae nuiah manna kho to angzoh pae; nihcae hanah van takaw to a paek.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kaminawk loe vankaminawk ih buh to caak o; nihcae zok amhah hanah caaknaek to a paek.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ni angyae bang ih takhi to van ah a songsak moe, a thacakhaih hoiah aloih bang ih takhi to a songsak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Maiphu baktiah moi to kho ah angzohsak, tuipui taeng ih savuet baktiah tavaanawk to azawksak.
  </para>
  <para style="p">
    <verse number="28" style="v" />A sak o ih im salak hoi nihcae ataihaih ahmuen taengah a kraksak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae koeh ih baktiah anih mah paek pongah, nihcae loe caak o moe, zok amhah o.
  </para>
  <para style="p">
    <verse number="30" style="v" />A koeh o ih buhcaakhaih to angkhoe o ai vop, buh a caak o li naah,
  </para>
  <para style="p">
    <verse number="31" style="v" />Sithaw palungphuihaih to nihcae nuiah phak, nihcae thungah kathawk koek kami to anih mah hum pae ving; a qoih o ih Israel thendoengnawk to dueksak.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hae baktih hmuennawk boih a tongh o, toe anih mah sak ih dawnrai hmuennawk to tang o ai, zaehaih to a sak o toeng toeng vop.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pongah nihcae ih ani to azom pui ah laemsak moe, saningnawk to raihaih hoiah boengsak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sithaw mah nihcae to hum naah, kalah kaminawk loe amlaem o let moe, Sithaw to palung tang hoiah pakrong o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sithaw loe angmacae ih lungsong, Kasang koek loe angmacae pahlongkung ah oh, tiah nihcae mah panoek o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toe pakha hoiah ni anih to pakoeh o, anih khaeah palai hoi amsawnlok to a thuih o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih khaeah poek toenghaih tawn o ai, a sak o ih lokkamhaih nuiah doeh oephaih tawn o ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Toe anih loe tahmenhaih hoiah koi pongah, nihcae zaehaih to tahmen pae, nihcae to amrosak ai: ue, pop parai palungphuihaih to anih mah pauep, palung a phuihaih to amtuengsak ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Sithaw mah nihcae loe taksa ah ni oh o, kalaem tangcae amlaem let thai ai takhi ah ni oh o, tiah panoek.
  </para>
  <para style="p">
    <verse number="40" style="v" />Anih to praezaek ah vai nazetto maw laisaep o thuih moe, taw ah nazetto maw palungset o sak?
  </para>
  <para style="p">
    <verse number="41" style="v" />Ue, nihcae loe hnukbangah amlaem o moe, Sithaw to tanoek o, Israel Ciimcai Kami to palungphui o sak.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anih thacakhaih to nihcae mah panoek o ai, anih mah misa ban thung hoi pahlonghaih to panoek o ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Izip prae ah sak ih angmathaih, Zoan ah sak ih dawnrai hmuennawk;
  </para>
  <para style="p">
    <verse number="44" style="v" />nihcae mah tui naek o thaih han ai ah, vapuinawk hoi vacongnawk to athii ah angcoengsak.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nihcae kaek hanah taksaenawk to prawt pae moe, nihcae amrosak hanah ukongnawk to patoeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nihcae ih thingthai qumponawk loe langkawk hanah paek moe, nihcae ih hmuennawk doeh pakhu hanah a paek.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nihcae ih misurkungnawk to qaetui hoiah dueksak moe, thaiduetkungnawk doeh dantui hoiah dueksak.
  </para>
  <para style="p">
    <verse number="48" style="v" />Sithaw mah nihcae ih maitawnawk to qaetui hanah paek moe, tuunawk doeh hmai hanah paek pae.
  </para>
  <para style="p">
    <verse number="49" style="v" />Anih palungphuihaih tha hoiah nihcae khaeah kasae vankaminawk to patoeh moe, palungbethaih, palung hmai amngaehhaih hoi raihaihnawk to ohsak.
  </para>
  <para style="p">
    <verse number="50" style="v" />Palungphuihaih loklam to a sak; nihcae ih pakhra paduek hanah paawt ai, nihcae hinghaih to nathaih kasae khaeah a paek.
  </para>
  <para style="p">
    <verse number="51" style="v" />Izip prae ah calunawk boih, Ham ih kahni imthung ah kaom thacak tangsuekhaih calu koek to paduek pae boih.
  </para>
  <para style="p">
    <verse number="52" style="v" />Toe angmah ih kaminawk loe tuu baktiah a huih moe, tuunawk baktiah praezaek ah a caeh haih.
  </para>
  <para style="p">
    <verse number="53" style="v" />Misa ban thung hoi loih hanah anih mah zaeh pongah, nihcae loe zii o ai; toe nihcae ih misanawk loe tuipui mah khuk khoep.
  </para>
  <para style="p">
    <verse number="54" style="v" />Nihcae to kaciim ahmuen angzithaih ramri khoek to, a bantang ban hoiah lak ih mae karoek to a caeh haih.
  </para>
  <para style="p">
    <verse number="55" style="v" />Nihcae hmaa ah Sithaw panoek ai kaminawk to a haek pae, qawk ah toep ih long to tah o moe, amzet o, Israel caanawk loe imsak o moe, to ah oh o.
  </para>
  <para style="p">
    <verse number="56" style="v" />Toe nihcae mah Kasang koek Sithaw to tanoek o moe, laisaep o thuih, a thuih ih lok to tahngai o ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Nihcae loe ampanawk baktiah oep om o ai, hnukbangah angnawn o; oepthok ai palaa baktiah lam amkhraeng o.
  </para>
  <para style="p">
    <verse number="58" style="v" />Nihcae mah kasang ahmuennawk hoiah anih to palungphui o sak moe, sakcop ih krangnawk hoiah uthaih palung to tacawt o sak.
  </para>
  <para style="p">
    <verse number="59" style="v" />Sithaw mah thaih naah, palungphui moe, Israel caanawk to paroeai panuet,
  </para>
  <para style="p">
    <verse number="60" style="v" />kaminawk salakah kaom, Shiloh ih kahni im doeh a caeh taak,
  </para>
  <para style="p">
    <verse number="61" style="v" />a thacakhaih to tamna ah caehsak moe, a lensawkhaih to misa banah a paek.
  </para>
  <para style="p">
    <verse number="62" style="v" />Angmah ih kaminawk to sumsen hoi hum hanah a paek; a toep han ih qawk nuiah kating ai palungphui.
  </para>
  <para style="p">
    <verse number="63" style="v" />Nihcae ih thendoengnawk to hmai mah kangh pae; nihcae ih tanglanawk doeh sava sah o ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Angmacae ih qaimanawk doeh sumsen hoiah duek o; lamhmainawk doeh qah o ai boeh.
  </para>
  <para style="p">
    <verse number="65" style="v" />To naah Angraeng loe iih kangthawk baktih, misurtui pongah kahang thacak kami baktiah angthawk.
  </para>
  <para style="p">
    <verse number="66" style="v" />Angmah ih misanawk to a tuk moe, dungzan khoek to azatsak.
  </para>
  <para style="p">
    <verse number="67" style="v" />Joseph ih kahni im to a maak pae, Ephraim acaeng doeh qoi ai,
  </para>
  <para style="p">
    <verse number="68" style="v" />toe Judah acaeng, angmah palung ih, Zion mae to anih mah qoih.
  </para>
  <para style="p">
    <verse number="69" style="v" />Angmah ih hmuenciim to hmuen sang baktiah a sak moe, dungzan khoek to caksak ih long baktih a ohsak.
  </para>
  <para style="p">
    <verse number="70" style="v" />A tamna David to qoih, tuu imthung hoiah anih to a lak;
  </para>
  <para style="p">
    <verse number="71" style="v" />angmah ih kami Jakob acaeng hoi angmah ih qawk ah kaom Israel acaeng to khetzawn hanah, caa kaom tuu amnonawk toephaih thung hoiah ni anih to qoih.
  </para>
  <para style="p">
    <verse number="72" style="v" />To pongah toenghaih palungthin hoiah nihcae to a khetzawn moe, palunghahaih ban hoiah nihcae to a hoih.
  </para>
  <chapter number="79" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, Sithaw panoek ai kaminawk loe nang ih qawktoep kaminawk khaeah caeh o; kaciim na tempul to amhnong o sak boeh moe, Jerusalem to amro o sak boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na tamnanawk ih qok to van ih tavaanawk hanah rawkcak ah paek o; nangmah ih kaciim kaminawk ih angan loe long ah kaom moinawk hanah buh ah paek o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae ih athiinawk loe tui baktiah Jerusalem taeng boih ah kraih o; nihcae aphum hanah kami mi doeh om ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaicae loe imtaeng kaminawk kasaethuih han koi ah ni ka oh o moe, kaicae taengah kaom kaminawk ih tamhnui tabu ah ni ka oh o boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng, nasetto maw? Dungzan khoek to palung nang phui thuih han boeh maw? Palung na phuihaih hmai baktiah kangh tih boeh maw?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang panoek ai kaminawk nuiah palung na phuihaih to krai ah loe, na hmin kawk ai praenawk nuiah palung na phuihaih to krai ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tipongah tih nahaeloe nihcae mah Jakob to caak o moe, a ohhaih ahmuennawk doeh phraek pae o boih boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Canghnii ah sak ih zaehaihnawk to kaicae khaeah palai hanah poek hmah; kaicae loe poek pahnaemhaih hoiah ka oh o baktih toengah, na palungnathaih mah kaicae hae karangah pakaa nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Sithaw kaicae pahlongkung, na hmin pakoeh hanah na bom ah; na hmin pongah, na krang ah loe kaicae zaehaihnawk to pasae ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tipongah Sithaw panoek ai kaminawk mah, Nihcae ih Sithaw loe naah maw oh, tiah thuih o loe? Na tamnanawk ih athii tho lu na lakhaih to, kaicae hmaa ah Sithaw panoek ai kaminawk mah hnu o nasoe.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thongkrah kaminawk hanghaih lok to na hmaa ah pha nasoe; paduek hanah suek ih kaminawk to na ban thacakhaih hoiah loisak ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na sethaih kathui ka imtaeng kaminawk ih saoek nuiah, kasae a thuih o haih atho alet sarihto ah, Angraeng nang mah pathok ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah nangmah ih kami kaicae hoi nangmah ih caphoih kahing saihaih ahmuen ih na tuunawk mah nang to dungzan khoek to saphaw o tih boeh; hmabang angzo han koi caanawk boih khaeah nang saphawhaih to kam tueng o sak han.
  </para>
  <chapter number="80" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuu baktiah Joseph zaehoikung, Aw Israel tuu toepkung, tahngai ah; Cherubim salakah anghnu nang, aanghaih to amtuengsak ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ephraim, Benjamin hoi Manasseh hmaa ah, na thaa pathok ah, angzo ah loe, kaicae hae pahlong ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Sithaw, kaicae hae angthasak let ah loe, na mikhmai to aangsak ah; to tiah nahaeloe pahlong ah ka om o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw misatuh kaminawk ih Angraeng Sithaw, nangmah ih kaminawk lawkthuihaih nuiah nasetto maw palung na phui thuih han vop?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae to mikkhraetui takaw hoiah na pacah moe, boengloeng kakoi ah mikkhraetui naek hanah nihcae to na paek boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka imtaeng kaminawk mah palungphui thuih hanah nang sak, ka misanawk mah kaicae ang pahnuih o thuih boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw misatuh kaminawk ih Sithaw, kaicae hae angthasak let ah loe, na mikhmai to aangsak ah; to tih nahaeloe pahlong ah ka om o tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Misurkung to Izip prae hoiah nang sinh; Sithaw panoek ai kaminawk to na haek bit pacoengah, na thlingh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thlingh hanah long to na takaeh, tangzun na saksak moe, prae thungah na koisak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih ih tahlip mah maenawk to khuk moe, anih ih tanghangnawk mah thacak Sidar thingnawk to khuk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih ih tanghang loe tuipui khoek to phak, tadoknawk doeh vapui khoek to phak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tipongah loklam ah kacaeh kaminawk boih mah misurthaih pakhrik o hanah, takha to na phraek ving loe?
  </para>
  <para style="p">
    <verse number="13" style="v" />Pangaeh mah akung to amuui moe, taw ih moisannawk mah caak o boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw misatuh kaminawk ih Sithaw, angqoi let hanah, kang pacae o; van hoiah dan tathuk ah, hae misurkung hae khet hanah angzo ah;
  </para>
  <para style="p">
    <verse number="15" style="v" />na bantang ban hoiah akung to na thlingh, nangmah hanah tanghang to tha na caksak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akung loe hmai hoiah thlaek moe, pakhruk ving boeh; na mikhmai hoi thuitaek ih kaminawk loe amro o boih boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na bantang bang ih kami hoi nangmah han tha na caksak ih kami capa nuiah na ban to koeng nasoe.
  </para>
  <para style="p">
    <verse number="18" style="v" />To tiah nahaeloe nang to kang qoi o taak mak ai; na hmin kang kawk o hanah, kaicae hae pathawk ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw misatuh kaminawk ih Sithaw, kaicae hae angthasak let ah loe, na mikhmai to aangsak ah; to tiah nahaeloe pahlong ah ka om o tih.
  </para>
  <chapter number="81" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aicae thacakhaih Sithaw khaeah hanghaih hoiah laa to sah oh; Jakob Sithaw khaeah anghoehaih hoiah hang oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lok kamding katoeng tamoi to sin oh, cingceng to bop oh loe, laa hoiah pakoeh oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khrah tarae moe, khrah amdueng nathuem ih poihkung ah, mongkah to ueng oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hae loe Jakob Sithaw zaehhoihaih lok, Israel han paek ih thuitaekhaih lok ah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka thaikop ai ih lok ka thaihaih, Izip prae hoiah a caeh naah, Joseph hanah to baktih lokthuihaih to a sak pae.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih palaeng nui ih kazit hmuen to ka takhoe pae moe, benthang thung hoiah a ban to ka zuh pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Raihaih na tongh naah, kang loisak; kamtueng ai khopazihaih ahmuen hoiah kang pathim; Meribah tuinawk nuiah nang to kang tanoek. Selah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw kai ih kaminawk tahngai oh, lok kang thuih o han; Aw Israel, ka lok hae na tahngai o nahaeloe!
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangcae khaeah kalah sithaw om mak ai; sithaw kalah doeh na bok o mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kai loe Izip prae hoiah nangcae zaehoikung, Angraeng na Sithaw ah ka oh; pakha to kakawk ah aang oh, pakha koimongah kang paek o han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe kai ih kaminawk loe ka lok tahngai o mak ai; Israel loe kai khaeah amha mak ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pongah angmacae palungthahhaih baktih toengah ka prawt sut; nihcae loe angmacae koehhaih baktiah caeh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai ih kami mah ka lok tahngaih o moe, Israel mah ka loklam to pazui nahaeloe!
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae ih misanawk to karangah ka kuepsak moe, a misanawk bangah ka ban ka paqoi han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng hnuma kaminawk loe angmacae koeh ah anih hmaa ah akuep o tih, nihcae danpaekhaih loe dungzan khoek to om tih boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih mah kakhraem koek buh hoiah nihcae to pacah ueloe, cathaeng thung ih khoitui hoiah na zok kam hahsak han, tiah a thuih.
  </para>
  <chapter number="82" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw loe thacak kaminawk salakah angdoet; sithawnawk salakah lokcaek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangcae loe kasae kaminawk to nang sak o haih moe, katoeng ai ah nasetto maw lok na caek o han vop? Selah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amtang kami hoi ampa tawn ai kaminawk to abom oh; amtang kami hoi patangkhang kaminawk khaeah toenghaih hoiah lokcaek ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amtang kami hoi kangaih kaminawk to pahnawt hmah; kasae kami ban thung hoiah pahlong ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe tidoeh panoek o ai, panoek thaihaih doeh tawn o ai; kaving thungah amkaeh o; long ohhaih ahmuennawk boih loe cak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai mah, Nangcae loe long sithaw ah na oh o; nangcae loe Kasang koek ih caa ah na oh o, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe nangcae loe kaminawk baktiah na dueh o ueloe, ukkung minawk kalah baktiah ni nam tim o toeng tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Sithaw, angthawk ah loe, long hae lokcaek ah; long kaminawk boih loe nang ih qawktoep kami ah ni oh o.
  </para>
  <chapter number="83" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, angam duem hmah; aw Sithaw, om sut hmah loe, om duem hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na misanawk loe savaih o; nang hnuma kaminawk kawbangmaw lu to padoengh o tahang, tito khen ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae loe nang ih kaminawk aling hanah thuih o moe, na buepsak ih kaminawk naeh hanah lok aram o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae mah, Angzo oh, nihcae to acaeng ah ohhaih thung hoiah anghmasak ving si; Israel ahmin to mi mah doeh panoek mak ai boeh, tiah thuih o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palung maeto amhonghaih hoiah lok a thuih o; na lok to aek hanah maeto ah angcuu o:
  </para>
  <para style="p">
    <verse number="6" style="v" />Edom ih kahni imnawk hoi Ishmael ih caanawk, Moab kaminawk hoi Hagar ih kaminawk;
  </para>
  <para style="p">
    <verse number="7" style="v" />Gebal kaminawk, Ammon kaminawk hoi Amelek kaminawk, Philistia kaminawk hoi Tura vangpui kaminawk;
  </para>
  <para style="p">
    <verse number="8" style="v" />Assyria kaminawk doeh nihcae khaeah athum o; nihcae mah Lot ih caanawk to abomh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midian kaminawk nuiah na sak ih baktih, Sisera kaminawk hoi Kishon tava ah Jabin kaminawk khaeah na sak ih baktih toengah, nihcae nuiah sah toeng ah,
  </para>
  <para style="p">
    <verse number="10" style="v" />nihcae loe En Dor ah amro o boih moe, long nuiah panuet thok ah ni oh o boih boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae ih kalen kaminawk to Oreb hoi Zeeb baktiah sah ah; ue, angmacae angraeng ih caanawk to Zebah hoi Zalmunna baktiah omsak ah,
  </para>
  <para style="p">
    <verse number="12" style="v" />nihcae mah, Sithaw ih imnawk to aimacae hanah la si, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw ka Sithaw, nihcae to takhi mah pahae ih anghnoeng baktiah omsak ah loe, takhi mah hmuh ih tavai baktiah angcoengsak ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmai mah kangh ih thing baktih, hmai mah maenawk kangh naah kangqong hmaipalai baktiah omsak ah,
  </para>
  <para style="p">
    <verse number="15" style="v" />takhi sae hoiah nihcae to patom ah loe, nangmah ih takhipui hoiah nihcae to pazih ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw Angraeng, nihcae mah na hmin pakrong o thai hanah, nihcae ih mikhmainawk to azathaih hoiah koisak ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae azat o nasoe loe, raihaih tong o poe nasoe; ue, nihcae loe azat o nasoe loe, anghma o poe nasoe.
  </para>
  <para style="p">
    <verse number="18" style="v" />JEHOVAH, tiah ahmin maeto khue kaom Nang loe long nui boih ah na Sang koek, tiah kaminawk mah panoek o nasoe.
  </para>
  <chapter number="84" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw misatuh kaminawk ih Angraeng, na ohhaih kahni im loe kawkruk maw palung han oh!
  </para>
  <para style="p">
    <verse number="2" style="v" />Ue, Angraeng ih longhmaa to dawn loiah, ka hinghaih loe zaisut boeh; ka palungthin hoi ka ngan mah kahing Sithaw to kawk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw misatuh kaminawk ih Angraeng, ka Siangpahrang hoi ka Sithaw, ue, na hmaicam ah, paritca mah tabu sak, a caa khaek haih hanah, pungpae mah tabu to boh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na im ah kaom kaminawk loe tahamhoih o; nang to saphaw o poe tih. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang ah thacakhaih tawn kaminawk loe tahamhoih o; to kaminawk loe na loklam bangah palungthin to suek o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae Baca azawn ah caeh o naah, tuibap tui to takaeh o; khotui mah tui hoiah koisak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae loe thacak o aep, Zion ih kaminawk loe Sithaw hmaa ah angphong o boih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw misatuh kaminawk ih Angraeng Sithaw, lawk ka thuihaih hae tahngai ah; aw Jakob Sithaw, tahngai rae ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khenah, Aw Sithaw kaicae abuephaih, nangmah na caksak kami ih mikhmai to khen ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahmuen kalah bangah saning sangto oh pongah loe, nangmah ih longhmaa ah nito oh hae hoih kue. Kasae kaminawk ih kahni im ah oh pongah loe, ka Angraeng im thungah thok toepkung ah ka oh khoek roek han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng Sithaw loe ni hoi abuephaih ah oh; Angraeng mah tahmenhaih hoi lensawkhaih to paek tih; loklam katoengah caeh kaminawk hanah loe hmuen kahoih roe paawt pae mak ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw misatuh kaminawk ih Angraeng, nang oephaih tawn kami loe tahamhoih.
  </para>
  <chapter number="85" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, na prae thungah palung koi kaom hmuen to nam tuengsak; naeh ih Jakob acaengnawk to na hoih let.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmah ih kaminawk sakpazaehaih to na tahmen moe, nihcae zaehaih to na khuk pae. Selah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Palung na phuihaihnawk to na takhoe boih; thacak palung na phuihaih to nang qoi taak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Sithaw, pahlongkung, kaicae hae angthasak let ah loe, kaicae khaeah palung na phuihaih to diipsak ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaicae nuiah palung na phui poe han vop maw? Na caanawk ih adung khoek to palungphuihaih na suek poe han vop maw?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangmah rang hoiah nangmah ih kaminawk mah anghoehaih hak o thai let hanah, kaicae hae nang talawk let mak ai boeh maw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, na palungnathaih kaicae khaeah amtuengsak ah loe, na pahlonghaih to na paek ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng Sithaw mah thuih han ih lok to ka tahngaih han; anih loe angmah ih kaminawk hoi angmah ih kaciim kaminawk khaeah lok to thui tih; toe amthuhaih bangah amlaem o let hmah nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tangtang ni kaicae prae ah lensawkhaih oh thai hanah, a pahlonghaih loe anih zithaih tawn kaminawk taengah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palungnathaih hoi loktang lok to angtongh hoi boeh; toenghaih hoi angdaehhaih loe maeto hoi maeto angmok hoi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Loktang loe long thung hoiah tacawt tahang tih; toenghaih mah van hoiah khen tathuk tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ue, Angraeng mah kahoih hmuen to paek ueloe, kaicae ih prae mah athaih to tacawtsak tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toenghaih loe anih hmaa ah caeh ueloe, a caehhaih loklam to aicae ih loklam ah na sah pae tih.
  </para>
  <chapter number="86" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, na naa to patueng ah loe, na pathim ah; kai loe kamtang hoi kavawt kami ah ni ka oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ciim pongah, ka hinghaih hae pathlung ah; Nang loe ka Sithaw ah ni na oh; nang oephaih tawn na tamna hae pahlong ah!
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng, ka nuiah palungnathaih tawn raeh; ni thokkruek nang khaeah ka hangh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na tamna ih pakhra to anghoesak ah; Aw Angraeng, nang khaeah, ka hinghaih kang vah tahang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng, nang loe na hoih, zae tahmen hanah na koeh; nang kawk kaminawk boih khaeah, pop parai palungnathaih to nam tuengsak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Angraeng, lawk ka thuihaih hae tahngai ah; tahmen kang hnikhaih lok hae tahngai raeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Raihaih ka tongh niah nang to kang kawk han; to naah nang mah nang pathim tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, sithawnawk thungah nang baktih mi doeh om ai; na sak ih toknawk baktih tok doeh om ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, na sak ih prae congca kaminawk angzo o tih; nihcae loe na hmaa ah tabok o ueloe, na hmin to pakoeh o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang loe lensawk moe, dawnrai hmuennawk to na sak; Sithaw ah kaom loe nang khue ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Angraeng, loklam na patuek ah; kai loe na loktang lok pongah ni ka caeh han; na hmin ka zit thaih hanah, ka palungthin hae amhongsak ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw ka Angraeng Sithaw, ka palungthin boih hoiah kang pakoeh han; dungzan khoek to na hmin kang pakoeh han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na palungnathaih loe kating ai len; kathuk taprong thung hoiah ka hinghaih to nang pahlong boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Sithaw, amoek kaminawk loe naeh hanah angthawk o tahang; tahmenhaih tawn ai amkhueng kaminawk loe nang to hmaloe koek ah suem o ai, nihcae loe ka hinghaih to pakrong o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe Aw Angraeng, nang loe tahmenhaih, amlunghaih, pauep thaihaih, pop parai palungnathaih, loktang lok hoiah koi Sithaw ah na oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai khaeah angqoi ah loe, ka nuiah palungnathaih to tawn ah; na tamna khaeah na thacakhaih to paek ah loe, na tamna nongpata ih capa hae pahlong ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai hnuma kaminawk mah a hnuk o thaih moe, azat o thaih hanah, kai han angmathaih kahoih to na patuek ah; tih pongah tih nahaeloe Angraeng nang mah nang bomh moe, nang pathloep boeh.
  </para>
  <chapter number="87" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anih angdoethaih ahmuen loe angmah ih kaciim mae ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng loe Jakob ohhaih ahmuennawk boih pongah doeh, Zion ih khongkhanawk to palung kue.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Sithaw vangpui, nihcae mah na lensawkhaih hmuennawk to thuih o. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai panoek kaminawk khaeah Rahab hoi Babylon to ka thuih han; Philistia, Tura hoi Ethiopia kaminawk to khenah; hae kami loe to vangpui ah ni tapen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hae ih kaminawk hoi ho ih kaminawk loe to vangpui ah ni tapen; Kasang koek, angmah roe mah, to vangpui to caksak tih, tiah Zion kawng to thui o tih boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng mah kaminawk ih ahmin to tarik naah, hae kami loe to ahmuen ah ni tapen, tiah pakuem tih. Selah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Laasah kaminawk, katoeng kruek moe, tamoi ueng kaminawk boih mah, kaicae anghoehaihnawk boih loe nang khaeah ni oh, tiah thui o tih.
  </para>
  <chapter number="88" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka pahlonghaih Angraeng Sithaw, nang khaeah aqum athun kang hangh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lawk ka thuihaih nang khaeah pha nasoe; ka hanghaih lok na tahngai pae ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka hinghaih mah raihaih tong boeh moe, ka hinghaih taprong taengah phak boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai loe tangqom thungah caeh kaminawk hoi nawnto ang kroek o hmaek boeh; tha tawn ai kami baktiah ni ka oh sut boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kadueh kaminawk salakah vah sut ih kami, kami hum moe, taprong ah pasong o ih baktiah, na ban thung hoiah na takhoe ving moe, anih to na panoek ai boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kathuk koek tangqom, kaving moe, kathuk parai tangqom thungah nang pasong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Palung na phuihaih mah kai ang taeh; kai hae na tuiphunawk boih hoiah nang pacaekthlaek. Selah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kam puinawk to nang lak pae ving; kai hae nihcae mah panuet hanah nang sak; kai nang paung caeng pongah, tasa bangah ka tacawt thai ai boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Raihaih mah ka mik amrosak boeh; Angraeng, ni thokkruek nang kang kawk; nang khaeah ka ban kang payangh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kadueh kaminawk hanah dawnrai hmuen na sak pae han maw? Kadueh kaminawk angthawk o ueloe, nang to saphaw o tih maw? Selah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nam lunghaih to taprong thungah thui o tih maw, to tih ai boeh loe na oepthohhaih to amrohaih thungah thui o tih maw?
  </para>
  <para style="p">
    <verse number="12" style="v" />Na sak ih dawnrai hmuennawk to khoving thungah panoek o tih maw? Na toenghaih doeh pahnet thaih prae ah panoek o tih maw?
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe Aw Angraeng, kai loe nang khaeah ka qah; akhawn bangah lawkthuihaih loe na hmaa ah phak boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng, tipongah ka pakhra nang vah pae ving loe? Tipongah mikhmai nang hawk taak ving loe?
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai loe nawkta nathuem hoi patang ka khang boeh moe, ka duek duih boeh; raihaih nang tongsak pongah kang pho sut boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Palung na phuihaih mah kai ang kraeng khoep boeh; nang tongsak ih raihaih mah ang paro boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />To hmuennawk loe tuibaktiah ka taengah ni thokkruek angzoh o; kai hae nawnto ang takui o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palung ih kami hoi ampuinawk to kai khae hoi kangthla ah nang suek pae, kam puinawk loe vinghaih thungah oh o.
  </para>
  <chapter number="89" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng palungnathaih to dungzan khoek to laa ah ka sak han; na oepthohhaih to kaminawk boih khaeah ka pakha hoi roe ka thuih han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Palungnathaih loe dungzan khoek to caak tih; vannawk boih nuiah na oepthohhaih to na caksak tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka qoih ih kami hoiah lokmaihaih to ka sak moe, ka tamna David khaeah lokmaihaih to ka sak boeh,
  </para>
  <para style="p">
    <verse number="4" style="v" />na tii to dungzan khoek to ka caksak moe, na caanawk ih adung khoek to na angraeng tangkhang to ka caksak han, tiah na thuih. Selah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng, na sak ih dawnrai hmuennawk to vannawk mah saphaw o ueloe, na oepthohhaih doeh kaciim kaminawk amkhuenghaih ahmuen ah saphaw o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Van ah Angraeng hoi patah han koi mi maw kaom? Thacak kami ih capanawk thungah Angraeng baktiah mi maw kaom?
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaciim kaminawk amkhuenghaih ahmuen ah loe Angraeng to paroeai zit o; anih loe ataeng ah kaom kaminawk pongah khingya paek han koi ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw misatuh kaminawk ih Angraeng Sithaw, nang baktih thacak Angraeng mi maw om tih? Na oepthohhaih mah nang to ang takui.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang mah tuipui to na uk; tuiphu angthawk tahang naah, tuiphu to na dipsak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hum ih kami baktiah, Rahab to na taprawt pet pet moe, na ban thacakhaih hoiah na misanawk to na vah phaeng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vannawk loe nang ih hmuen ah oh o, long doeh nang ih ni; long hoi athung ah kaom hmuennawk boih loe, nang mah ni na sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aluek hoi aloih to na sak; Tarbo hoi Hermon loe na hmin rang hoiah anghoe tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na ban loe thacakhaih hoiah koi; na ban loe thacak moe, na bantang ban loe sang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Katoengah lokcaekhaih hoi toenghaih loe na angraeng tangkhang ohhaih ahmuen ah oh; tahmenhaih hoi loktang loe na hmaa ah caeh tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anghoehaih lok panoek kaminawk loe tahamhoih! Aw Angraeng, nihcae loe na hmaa ah aanghaih hoiah caeh o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae loe na hmin rang hoiah ni thokkruek anghoe o; na toenghaih rang hoiah ni nihcae mah pakoeh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang loe nihcae lensawkhaih hoi thacakhaih ah na oh; nang tahmenhaih rang hoiah ni kaicae ih taki loe pakoeh ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kaicae abuephaih loe Angraeng ih ni; Ciimcai Israelnawk ih kami loe kaicae ih siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hnuksakhaih hoiah nangmah ih kaciim kami khaeah lok na thuih; thacak kami abomh hanah kang paek boeh; kaminawk thung hoi qoih ih kami maeto ka sangsak boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tamna David to ka hnuk boeh; anih loe kaciim kaimah ih situi hoiah ka bawh boeh,
  </para>
  <para style="p">
    <verse number="21" style="v" />anih nuiah ka ban thacak tih; ka ban tampawk hoiah anih tha ka caksak han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Misa mah anih ih hmuen to lomh pae mak ai; kasae kami ih ca mah doeh anih to pacaekthlaek mak ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih hmaa ah a misanawk to ka boh pae moe, anih hnuma kaminawk to raihaih ka paek han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka oepthohhaih hoi ka palungnathaih anih khaeah om ueloe, ka hmin rang hoiah anih ih taki to pakoeh tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih ih ban loe tuipui nuiah ka suek pae moe, a bantang ban to vapuinawk nuiah ka koeng pae han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih mah, Nang loe kam pa, ka Sithaw, ka pahlonghaih lungsong, tiah na kawk tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih to long siangpahrangnawk pongah sang kue, anih to ka calu ah ka suek han.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anih hanah ka palungnathaih dungzan khoek to ka suek han; ka lokmaihaih loe a nuiah cak poe tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih ih atii to dungzan khoek to ka caksak moe, van oh nathung anih anghnuthaih angraeng tangkhang to ka caksak poe han.
  </para>
  <para style="p">
    <verse number="30" style="v" />A caanawk mah ka paek ih kaalok caeh o taak moe, ka lokcaekhaih baktiah caeh o ai ah,
  </para>
  <para style="p">
    <verse number="31" style="v" />ka thuih ih loknawk to aek o moe, ka paek ih loknawk to pazui o ai nahaeloe,
  </para>
  <para style="p">
    <verse number="32" style="v" />a sakpazaehaihnawk pongah thingboeng hoiah ka thuitaek moe, a sakpazae o haih baktih toengah dan ka paek han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe kai ih tahmen amlunghaih to anih khae hoiah ka la pae ving mak ai, ka oepthohhaih doeh kam rosak mak ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka sak ih lokmaihaih to kam rosak mak ai, pakha hoi ka thuih ih lok doeh kam khraisak mak ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />David khaeah lok kam lai mak ai, tiah ka ciimhaih hoi vaito ka khawt ah lok ka kam boeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih ih atii loe cak poe ueloe, anih ih angraeng tangkhang loe ka hmaa ih ni baktiah om tih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Khrah baktiah cak poe ueloe, van ih oepthok hnukung baktiah om tih. Selah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Toe nang mah nang pahnawt sut boeh moe, nang panuet boeh, situi na bawh ih kami nuiah palung na phui boeh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na tamna hoiah sak ih lokmaihaih to na pahnawt sut boeh moe, anih ih angraeng lumuek to panuet kaom long ah na vah pae ving boeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Anih ih sipaenawk to na phraek pae boih boeh; anih ih kacak sipaenawk doeh nam rosak boeh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Loklam ah caeh kaminawk mah anih to lomh o; anih loe ataeng ah kaom kaminawk kasaethuih han koi ah oh.
  </para>
  <para style="p">
    <verse number="42" style="v" />A misanawk ih bantang ban to na toengh pae tahang; a misanawk boih to nang hoesak boeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih ih sumsen haa to na paqoi pae ving boeh; anih misatuk naah nang doe haih ai boeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />A lensawkhaih to na boengsak moe, anih ih angraeng tangkhang to long ah na vah pae ving boeh.
  </para>
  <para style="p">
    <verse number="45" style="v" />A qoeng li naah aninawk to na duemsak; azathaih hoiah anih to na khuk khoep boeh. Selah.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nasetto maw? Aw Angraeng, nang hawk poe han boeh maw? Palung na phuihaih hmai baktiah kangh tih maw?
  </para>
  <para style="p">
    <verse number="47" style="v" />Ka hinghaih loe nasetto maw duemh, tito panoek ah; na sak ih kaminawk loe azom pui ah ni oh o.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kawbaktih kami maw duekhaih tongh ai ah hing thaih? Anih loe taprong thacakhaih thung hoiah a hinghaih pahlong thai tih maw? Selah.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aw Angraeng, loktang lok hoiah na tamna David khaeah na sak ih lokmaihaih hoi canghnii ih na tahmenhaih to naah maw oh ving boeh?
  </para>
  <para style="p">
    <verse number="50" style="v" />Angraeng, na tamnanawk pahnuithuihhaih to pakuem poe ah; thacak kaminawk boih mah kasaethuihaih to palung thung hoi kawbang maw ka pauep, tito panoek ah,
  </para>
  <para style="p">
    <verse number="51" style="v" />Aw Angraeng, na misanawk mah kasae a thuih o; nihcae loe nangmah na caksak kami ih khok tangkannawk to pahnui o thuih boeh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Angraeng khaeah tahamhoihaih dungzan khoek to om nasoe! Amen hoi Amen.
  </para>
  <chapter number="90" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng, nang loe adung boih ah kaicae ohhaih ahmuen ah na oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Maenawk loe om o ai vop, longlai hoi long na sah ai nathuem hoi boeh ni, nang loe dungzan hoi dugzan khoek to Sithaw ah na oh boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kami to nam rosak; kami ih caanawk, amlaem o let ah, tiah na naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Saning sangto loe na hmaa ah tidoeh na ai ni, kalaem tangcae ni baktih, atue setta qum atue baktiah ni oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae to tui mah pazawk baktiah na lak ving; nihcae loe ka iip baktiah oh o moe, akhawnbang ah tacawt tahang phroh baktiah oh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Phroh loe akhawnbang ah sai moe, qoeng tahang, duembang ah loe amro moe, azaem ving.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaicae loe palung na phuihaih hoiah kam ro o; palung na bet pongah tasoehhaih hoiah ka oh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaicae sakpazaehaihnawk to na hmaa ah na suek moe, tamqumta hoiah ka sak o ih zaehaihnawk loe na hmaa ih aanghaih mah toeh phaeng.
  </para>
  <para style="p">
    <verse number="9" style="v" />Palung na phui pongah kaicae ih aninawk loe laemh boeh; saningnawk loe thuih ih ruici baktiah ni ka laemh o sak boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaicae hinghaih saning loe qui sarihto sawk; thacak nahaeloe saning qui tazetto pha tih; khosak hoih li nathuem ah doeh patanghaih hoi palungsethaih khue ni oh; toe saningnawk loe akra ai ah laemh o, kaicae doeh kang hmat kang taa o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palung na phuihaih tha loe mi mah maw panoek tih? Nang loe zitthoh baktih toengah palung na phuihaih doeh zitthoh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palunghahaih ka patoh o thai hanah, ka hing o haih aninawk kroek thaihaih to na patuk ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Angraeng, amlaem let ah, nasetto maw akra vop tih? Na tamnanawk nuiah tahmenhaih to tawn ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na tahmenhaih rang hoiah akhawnbang ah zok amhahsak ah; to tiah nahaeloe ka hing o thung anghoehaih hoi oephaih hoiah ka om o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaicae patang nang khangsakhaih saning, kasae tonghaih saning paroeai pop boeh pongah, kaicae anghoehaih atue to na paek ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na sak ih hmuen to na tamnanawk khaeah amtuengsak ah loe, na lensawkhaih to a caanawk khaeah amtuengsak ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aicae Angraeng Sithaw tahmenhaih aicae nuiah om nasoe; kaimacae ban hoi ka sak o ih tok to na caksak ah; ue, kaimacae ban hoi ka sak o ih tok to na caksak ah.
  </para>
  <chapter number="91" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasang koek pakaahaih ahmuen ah kaom kami loe, Thacak Sithaw ih tahlip ah abuep o tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng loe ka buephaih, kacak kai ih sipae ah oh; anih loe kam hahaih, ka Sithaw ah oh, tiah ka thuih han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah loe tavaa han dongh patung kami ih ban thung hoi paduek thaih kasae nathaih thung hoiah na loisak tangtang tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angmah ih pakhraeh hoi na khuk ueloe, anih ih pakhraeh tahlip ah na buepsak tih; anih ih loktang lok loe nang pakaahaih hoi angvaenghaih ah om tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aqum ah kaom zitthok hmuen, khodai ah kah ih palaa,
  </para>
  <para style="p">
    <verse number="6" style="v" />khoving ah kaom nathaih kasae, athun ah kaom amrohaih doeh, na zii mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na taengah kami sangto amtimh o ueloe, na bantang bangah kami sang hato amtim o tih; toe nang khaeah pha mak ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mik hoi khue na dan ueloe, kasae kaminawk han paek ih tangqum to na hnu tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng loe ka buephaih ah oh, tiah na thuih moe, Kasang koek khaeah, na ohhaih ahmuen to sak pongah,
  </para>
  <para style="p">
    <verse number="10" style="v" />sethaih roe na nuiah krah mak ai, kawbaktih amrohaih doeh na ohhaih ahmuen taengah angzo mak ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na caehhaih ahmuen kruekah nang toep hanah, angmah ih vankaminawk to paek tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na khok to thlung pongah daeng han ai ah, nihcae mah ban hoi na tapom o tahang tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaipui hoi pahui sae to na cawh ueloe, kaipui kanawk hoi pahui pui to khok hoiah na tii tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih mah ang palung pongah, anih to ka pahlong han; anih mah ka hmin to panoek pongah, anih to ka tapom tahang han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih mah ang kawk naah, ka pathim pae han; raihaih a tong naah, ka oh thuih han; anih to ka pahlong moe, ka pakoeh han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hinglung sawkhaih hoiah palung ka dipsak moe, ka pahlonghaih ka hnuksak han, tiah a thuih.
  </para>
  <chapter number="92" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng pakoehhaih loe hoih, Aw Kasang koek, na hmin pakoehhaih laasak hae hoih,
  </para>
  <para style="p">
    <verse number="2" style="v" />akhawnbang ah nam lunghaih to thuih moe, duembang ah na oepthohhaih thuih hae hoih,
  </para>
  <para style="p">
    <verse number="3" style="v" />aqui hato kaom katoeng, tamoi hoi atuen kahoih katoeng hoiah na hmin pakoeh hae hoih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, na sak ih hmuen hoiah kai palung nang hoesak; na ban hoi sak ih hmuennawk pongah pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng, na sak ih hmuen loe kawkruk maw len! Na poekhaih loe thuk parai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Poekhaih tawn ai kaminawk mah panoek o thai ai; kamthu mah doeh hae hae panoek ai,
  </para>
  <para style="p">
    <verse number="7" style="v" />kasae kaminawk loe phroh baktiah tacawt o moe, kahoih ai hmuen sah kaminawk qoeng o tahang naah, nihcae to dungzan khoek to amrosak tih boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe Angraeng, nang loe dungzan khoek to kasang ah na oh poe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, na misanawk ho khenah; khenah, na misanawk loe anghmaa o tih; kahoih ai hmuen sah kaminawk boih loe ahmuen kruekah amhet o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Maitaw tae taki baktiah kai ih taki hae na pakoeh moe, kahoih situi hoiah nang bawh boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka mik mah ka misanawk to hnuk moe, kahoih ai ka misanawk pazawkhaih kawng ka thaih naah loe, ka poekhaih palungthin khuek ti tih boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Katoeng kami loe ungsikung baktih, Lebanon ih Sidar thing baktiah qoeng tahang tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng imthung ah thling ih kaminawk loe, aicae Sithaw ih longhmaa ah qoeng o tahang tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae loe mitong naah doeh thingthai athai o vop tih; aqam angtha o ueloe, hing suep ah om o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah nihcae mah, Angraeng loe toeng, anih loe ka lungsong ah oh; a nuiah katoeng ai hmuen tidoeh om ai, tiah amtueng tih.
  </para>
  <chapter number="93" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah uk, anih loe lensawkhaih hoiah amthoep; Angraeng loe amthoep, anih loe thacakhaih hoiah angzaeng. Angthuih thai han ai ah, long to a caksak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na angraeng tangkhang loe canghnii hoiah ni oh boeh; nang loe dungzan ah na hing.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng, tui kangcuu loe angphui o tahang; tuipuinawk mah atuen tacawt o sak; vapuinawk mah tuisamba to tacawt o sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuinawk ih atuen, ue, tuipuinawk ih atuen pongah doeh, ranui ih Angraeng loe thacak kue.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na paek ih loknawk loe paroeai cak; Aw Angraeng, ciimcaihaih loe dungzan khoek to nang ih im ah angcoeng boeh.
  </para>
  <chapter number="94" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng Sithaw, lu lakung; Aw lu lakung Sithaw, amtueng thuih raeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw long lokcaekkung, angthawk ah; amoek kami han katingah tangqum to paek ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng, kasae kaminawk loe nasetto maw, kahoih ai kaminawk loe nasetto maw nawm o vop tih?
  </para>
  <para style="p">
    <verse number="4" style="v" />Sethaih sah kaminawk loe amoek o boih, nihcae loe nasetto maw lok kaham lok to apae o vop tih?
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng, nihcae mah nang ih kaminawk to atit o moe, na qawktoep kaminawk to pacaekthlaek o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lamhmainawk, angvinnawk hoi ampa tawn ai kaminawk to a hum o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng mah hnu mak ai hmang, Jakob ih Sithaw mah doeh dawncang mak ai, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Minawk salakah kaom poekhaih tawn ai kaminawk, panoek oh; kamthu kaminawk, natuek naah maw palung na haa o tih?
  </para>
  <para style="p">
    <verse number="9" style="v" />Naa sahkung mah loe thaih mak ai maw? Mik sahkung mah loe hnu mak ai maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw panoek ai kami thuitaekkung mah loe, danpaek ai ah om tih maw? Kami palunghahaih patukkung loe, panoekhaih tawn ai maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Kami poekhaih loe azom pui ni, tiah Angraeng mah panoek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Angraeng, kasae kami hanah tangqom takae ai karoek to, karai tonghaih niah anih to nang haksak hanah, na thuihtaek moe, na lok patuk ih kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng mah angmah ih kaminawk to pahnawt sut mak ai, angmah ih qawktoep kaminawk doeh prawtsut mak ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toenghaih nuiah lokcaekhaih to om tih, poektoeng kaminawk boih loe to hmuen to pazui o tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kasae kaminawk tuk hanah mi maw kai hanah angthawk tih? To tih ai boeh loe kasae sah kaminawk tuk hanah mi maw kai han angdoe tih?
  </para>
  <para style="p">
    <verse number="17" style="v" />Angraeng mah na bomh ai nahaeloe, akra ai ah ka hinghaih hae amding rue duekhaih ahmuen ah ka om tih boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai mah, Ka khok loe amthaek boeh, tiah ka thuih naah, Aw Angraeng, na palungnathaih hoiah kai to nang patawnh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka palung thung poekhaih angpung sut naah, ka hinghaih to nang hoesak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toeng ai ah lokcaek kaminawk to na koeh ai, kamro angraeng tangkhang loe nang hoiah angkomhaih oh maw?
  </para>
  <para style="p">
    <verse number="21" style="v" />Nihcae loe katoeng kami hinghaih to lak hanah, amkhueng o moe, zaehaih tawn ai kami hum hanah khokhan o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe Angraeng loe kacak kai ih sipae ah oh; ka Sithaw loe ka buephaih lungsong ah oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah nihcae zaehaih to angmacae nuiah krahsak ueloe, kasae a sak o haih pongah nihcae to amrosak tih; ue, aicae Angraeng Sithaw mah nihcae to paro tih.
  </para>
  <chapter number="95" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angzo oh, Angraeng khaeah anghoehaih laa to sah o si; aicae pahlonghaih lungsong khaeah anghoehaih hoiah hang o si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kawnhaih lokthuih hoiah a hmaa ah caeh o si loe, anih khaeah anghoehaih laa to sah o si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng loe lensawk Sithaw ah oh moe, sithawnawk boih nuiah Kalen koek Siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kathuk long ahmuennawk loe anih ban ah oh; mae sangnawk doeh anih ih ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih mah tuipuinawk to sak pongah, angmah ih hmuen ah oh; saoeng doeh a ban hoiah ni sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angzo oh, akuephaih hoiah bok o si; aicae sahkung Angraeng hmaa ah cangkrawn o si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe aicae ih Sithaw ah oh; aicae loe angmah ih kasai qam ahmuen ah kaom kami, a ban thungah kaom tuu ah a oh o. Vaihniah a lok to na thaih o nahaeloe,
  </para>
  <para style="p">
    <verse number="8" style="v" />palungphui han tavet o nathuem ih baktih, praezaek ah raihaih tong naah tanoek ih baktiah, palung thah o sak hmah,
  </para>
  <para style="p">
    <verse number="9" style="v" />nam panawk mah kai ang tanoek o naah, ka sak ih hmuen to nihcae mah hnuk o, toe nihcae mah kai ang tanoek o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Saning qui palito thung nihcae nuiah palung ka phui, Hae kaminawk loe poek amro kami, ka caehhaih loklam panoek ai kami ah oh o, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah palung ka phuihaih hoiah nihcae khaeah, Nangcae loe kang hakhaih ahmuen thungah na kun o thai mak ai, tiah lok ka thuih.
  </para>
  <chapter number="96" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng khaeah laa kangtha to sah oh; long kaminawk boih, Angraeng khaeah laa to sah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng khaeah laa to sah oh loe, anih ih ahmin to tahamhoihaih paek oh; nito pacoeng nito anih pahlonghaih to amtueng o sak ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sithaw panoek ai kaminawk khaeah anih lensawkhaih to taphong oh loe, kaminawk boih khaeah a sak ih dawnrai hmuennawk to thui oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng loe lensawk moe, pakoeh han krak; anih loe sithawnawk boih thungah zit han koiah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sithaw panoek ai kaminawk ih sithawnawk loe sakcop ih krang rumram tok ni; toe vannawk loe Angraeng mah ni sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih ih ahmin lensawkhaih hoi thacakhaih loe angmah hmaa ah oh; thacakhaih hoi a lensawkhaih loe a hmuenciim ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw prae boih ah kaom acaeng kaminawk boih, Angraeng khaeah angpaek oh, lensawkhaih hoi thacakhaih to Angraeng khaeah paek oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih ih ahmin lensawkhaih to Angraeng khaeah paek oh; paek han koi hmuen to sin oh loe, angmah ih imthung ah angzo oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaciim hmuen hoi amthoep oh loe, Angraeng to bok oh; long kaminawk boih, anih hmaa ah tasoeh oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw panoek ai kaminawk salakah, Angraeng mah uk, tiah thui oh; angthuih han ai ah, long to caksak tih; anih mah kaminawk to toenghaih hoiah lokcaek tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vannawk loe anghoe o nasoe, long loe oep nasoe; tuipui hoi athung ah kaom hmuennawk boih mah atuen to tacawt o sak nasoe;
  </para>
  <para style="p">
    <verse number="12" style="v" />laikoknawk hoi laikok thungah kaom hmuennawk boih anghoe o nasoe; taw thungah kaom thingnawk mah Angraeng hmaa ah anghoehaih laa to sah o tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih loe angzoh boeh, anih loe long lokcaek hanah angzo tih; anih loe long to toenghaih hoiah lokcaek ueloe, kaminawk to a loktang lok hoiah lokcaek tih.
  </para>
  <chapter number="97" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah uk pongah, long loe anghoe nasoe; tuipui thung ih praenawk doeh anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tamainawk hoi khoving mah anih to takui o khoep; toenghaih hoi amsoem ah lokcaekhaih loe angraeng tangkhang pahnuthaih ahmuen ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmai loe anih hmaa ah caeh moe, anih taengah kaom a misanawk to kangh boih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kampha anih ih a aengh mah long to toeh phaeng; long mah anih to hnuk naah tasoeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Maenawk loe Angraeng hmaa ah, long boih ukkung Angraeng hmaa ah, samdai baktiah amkaw o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vannawk mah a toenghaih to amtueng o sak, kaminawk boih mah a lensawkhaih to hnuk o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sakcop ih krangnawk bok kami, krangnawk pongah amoekhaih tawn kaminawk loe, azat o nasoe; nangcae sithawnawk boih, anih to bok oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, na lokcaekhaih pongah, Zion mah thaih naah anghoe moe, Judah canunawk doeh anghoe o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng, nang loe, longnawk boih pongah na sang koek; sithawnawk boih pong kasangah pakoeh ah na oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng palung kaminawk, kahoih ai hmuen to hnuma oh; anih loe kaciim angmah ih kaminawk hinghaih to toep pae; nihcae to kasae kaminawk ih ban thung hoiah pahlong pae.
  </para>
  <para style="p">
    <verse number="11" style="v" />Katoeng kami hanah aanghaih to oh moe, poek katoeng kaminawk hanah anghoehaih to oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangcae katoeng kaminawk, Angraeng ah anghoe oh; a ciimcaihaih to pakoeh oh.
  </para>
  <chapter number="98" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng khaeah laa kangtha to sah oh; anih mah dawnrai hmuennawk to sak boeh; a bantang ban hoi kaciim a ban mah, angmah hanah pahlonghaih to sak boeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah a pahlonghaih to panoeksak boeh; a toenghaih to Sithaw panoek ai kaminawk khaeah amtuengsak boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel imthung takoh ah a palungnathaih hoi oepthohhaih to poek pae boeh; aicae Sithaw pahlonghaih loe long boenghaih ah kaom kaminawk boih mah hnuk o boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Long kaminawk boih, anghoehaih hoiah Angraeng khaeah hang oh; atuenpawk hoiah saphawhaih laa to anghoehaih hoiah sah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katoeng kruek hoi Angraeng khaeah laasah oh; katoeng kruek hoiah laa to sah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mongkah hoi tuu taki to ueng oh loe, Angraeng, Siangpahrang hmaa ah anghoehaih hoiah hang oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuipui hoi athung ah kaom sak ih hmuennawk boih; long hoi anui ah kaom kaminawk boih mah atuen to pathok o nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vapuinawk mah ban tabaeng o nasoe; maenawk loe Angraeng hmaa ah anghoehaih laa nawnto sah o nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe long lokcaek hanah angzoh; anih mah toenghaih hoiah long to lokcaek ueloe, kaminawk to kangvan ah lokcaek tih.
  </para>
  <chapter number="99" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah uk; kaminawk tasoeh o nasoe! Anih loe Cherubimnawk salakah anghnut; long doeh tasoeh nasoe!
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng loe lensawkhaih hoi Zion ah oh; anih loe kaminawk boih pongah sang kue.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kalen moe, zitthok ahmin to nihcae mah saphaw o nasoe; anih loe ciimcai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toenghaih koeh siangpahrang loe thacak; nang mah loe kangvan ah ohhaih to na caksak; Jakob imthung ah toenghaih hoi kamsoem ah lokcaekhaih to na sak boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aicae Angraeng Sithaw to pakoeh oh loe, a khokkung ah tabok oh; anih loe ciimcai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi hoi Aaron loe nangmah ih qaima ah oh hoi; na hmin palawk Samuel doeh nihnik hoi nawnto oh toeng; nihcae mah Angraeng to kawk o naah, Anih mah pathim pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kangdoe tahang tamai thung hoi nihcae khaeah lok na thuih pae; nihcae loe na paek ih loknawk hoi patukhaihnawk to tahngaih o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw kaicae Angraeng Sithaw, nihcae ih lok to na pathim pae; nang loe nihcae sakpazaehaih tahmen Sithaw ah na oh; toe nihcae sakpazae naah dan na paek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aicae Angraeng Sithaw to pakoeh oh loe, angmah ih kaciim mae ah anih to bok oh; aicae Angraeng Sithaw loe ciimcai.
  </para>
  <chapter number="100" style="c" />
  <para style="p">
    <verse number="1" style="v" />Long kaminawk boih, anghoehaih hoi Angraeng khaeah hang oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anghoehaih hoi Angraeng ih tok to sah oh; laasak hoi anih hmaa ah angzo oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng loe Sithaw ni, tiah panoek oh; aicae loe anih mah ni sak, aicae loe angmah ih hmuen ah oh; angmah ih kami ah a oh o moe, angmah ih qam kahing saihaih ahmuen ah kapra tuu ah ni a oh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anghoe lawkthuihaih rang hoiah angmah ih khongkha thungah akun oh loe, pakoehhaih hoiah angmah ih longhmaa ah akun oh; anih khaeah anghoehaih lawk to thui oh loe, anih ih ahmin to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tipongah tih nahaeloe Angraeng loe hoih; a palungnathaih loe dungzan khoek to cak; a loktang lok loe adung kaminawk khoek to cak.
  </para>
  <chapter number="101" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, na palungnathaih hoi na toenghaih nuiah laa ka sak moe, nang khaeah laa ka sak han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Coek koi om ai ah acoehaih hoiah kho ka sak han. Natuek naah maw kai khaeah nang zoh han? Coek koi om ai palungthin hoiah ka ohhaih imthung ah ka caeh han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka mik ah kahoih ai hmuen to ka omsak mak ai; lam amkhraeng kaminawk mah sak ih hmuen to ka hnukma; kai khaeah to baktih hmuennawk akap mak ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Poektoeng ai kaminawk loe kai khae hoi amkhraeng o tih; kasae hmuen roe ka panoek mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi kawbaktih doeh a taeng ih kami to tamquta hoi kasae thui kami loe, kam rosak han; poeksang moe, amoek kami to kang hngai taak duem mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai hoi nawnto a oh o thai hanah, oepthok prae kaminawk to ka khet han; coek koi om ai ah lam caeh kaminawk loe, ka tok to sah o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aling thaih kami loe ka imthung ah om mak ai; amsawnlok thui kami doeh ka hmaa ah angdoe mak ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Prae thungah kaom kasae kaminawk boih kam rosak hmaloe han; hmuensae sah kaminawk doeh Angraeng ih vangpui thung hoiah ka tamit boih han.
  </para>
  <chapter number="102" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, lawk ka thuihaih hae tahngai ah; ka qahhaih lok loe nang khaeah pha nasoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Raihaih ka tong naah kai khae hoi mikhmai hawk ving hmah; na naa to kai khae bangah patueng ah; kang kawk naah, karangah na pathim ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai ih aninawk loe hmaikhue baktiah azawk o moe, ka huhnawk doeh hmai kamngaeh baktiah kangh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka palungthin loe zaek moe, qam baktiah azaem; buhcaak hanah doeh ka pahnet sut boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka haam loiah ka huhnawk doeh ka ngan hin hoiah angbet caeng boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai loe praezaek ih bukbuh baktih; long karoem ahmuen ih tavaa baktiah ni ka oh sut boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai loe iip ai ah ka oh, angmabueng kaom imphu ih parit tavaa baktiah ni ka oh boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka misanawk mah ni thokkruek kasae ang thuih o; kai pahnui thuih kaminawk loe kai ih misa ah oh hanah lokthuih o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Maiphunawk to buh baktiah ka caak; ka naek han koi doeh mikkhraetui hoiah angbaeh,
  </para>
  <para style="p">
    <verse number="10" style="v" />dip thai ai ah palung na phui pongah, kai hae nang toengh tahang moe, long ah nang vah tathuk ving.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka hinghaih aninawk loe kasawk tahlip baktiah oh moe, qam baktiah ka zaem.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe Angraeng nang loe dungzan khoek to cak; na hmin panoekhaih doeh adungh kaminawk boih khoek to cak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang loe angthawk ueloe, Zion nuiah palungnathaih na tawn vop tih; anih tahmenhaih atue, atue khaehhaih atue angzoh boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na tamnanawk loe to ih thlungnawk to koeh o moe, maiphu doeh koeh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sithaw panoek ai kaminawk mah Angraeng ih ahmin to zii o ueloe, long ih siangpahrangnawk boih mah a lensawkhaih to zii o tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah Zion to pakhraih naah, anih loe a lensawkhaih hoiah angphong tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amtang kaminawk lawkthuihaih lok to anih mah pathim pae tih, nihcae lawkthuihaih to patoek pae mak ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hae kawng hae angzo han koi adung kaminawk hanah tarik tih; a sak ih kaminawk mah Angraeng to saphaw o tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng loe kasang angmah ih hmuenciim hoiah khet tathuk moe, van hoiah long to a dan tathuk,
  </para>
  <para style="p">
    <verse number="20" style="v" />thongkrah kaminawk hanghaih lok to tahngai pae, kadueh tom kaminawk to loisak hanah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Zion ah Angraeng ih ahmin to taphong moe, Jerusalem ah anih saphawhaih laa to sak pacoengah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng ih tok sak hanah, kaminawk hoi praenawk nawnto amkhueng o tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Loklam ka caeh li naah anih mah tha ang zoksak; kai ih aninawk to ang duemsak.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah kai mah, Aw ka Sithaw, khosak hoih li naah ka hinghaih na la pae ving hmah; nang ih saningnawk loe angzo han koi adung kaminawk khoek to oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tangsuek nathuem hoi boeh ni long hae na sak; vannawk loe na ban hoiah sak ih hmuen ah ni oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nihcae loe anghma angtaa o tih, toe nang loe na om poe tih; ue, nihcae loe kahni baktiah prawn o boih tih; nihcae to kahni baktiah nam khraisak tih, to naah nihcae loe amkhraih o tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe nang loe nangmah toeng roengah ni om tih; na saningnawk loe boenghaih om mak ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na tamnanawk ih caanawk loe apet ai ah om o tih, nihcae ih atii loe na hmaa ah kacakah om o tih.
  </para>
  <chapter number="103" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka hinghaih, Angraeng to tahamhoihaih paek ah; kai ih takoh thungah kaomnawk boih, anih ih ciimcai ahmin to pakoeh oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw ka hinghaih, Angraeng to tahamhoihaih paek ah, ang paek ih kahoih hmuennawk boih to pahnet hmah;
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah ni na zaehaihnawk to tahmen moe, na nathaihnawk boih to hoihsak,
  </para>
  <para style="p">
    <verse number="4" style="v" />amrohaih thung hoiah na hinghaih to akrang moe, amlunghaih hoi a palungnathaih hoiah na lu to ang khuk pae,
  </para>
  <para style="p">
    <verse number="5" style="v" />na tha oh lihaih to tahmu baktiah angthasak hanah, kahoih hmuen hoiah na koehhaih to akoepsak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng loe pacaekthlaekhaih tongh kaminawk to katoeng ah lokcaek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi khaeah angmah ih loklam to panoeksak moe, Israel caanawk khaeah a sak ih hmuennawk to panoeksak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng loe palungnathaih hoi amlunghaih to tawnh, palung sawk, anih loe palungnathaih hoiah koi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe zaehaih net poe mak ai; palung doeh phui poe mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih loe aicae zaehaih baktiah lokcaek ai; a sakpazae o haih baktiah doeh pathok ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Van loe long pongah sang kue baktih toengah, anih zii kaminawk hanah anih palungnathaih loe len parai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni angyae hoi niduem loe angthla parai baktih toengah, aicae zaehaih to kangthla ah ang takhoe pae ving boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ampa mah a caanawk tahmen baktih toengah, anih zii kaminawk loe Angraeng mah tahmen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aicae hae kawbangah maw a sak, tito anih mah panoek; aicae loe maiphu ah ni a oh o, tiah anih mah panoek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kami hinghaih aninawk loe qam baktih, lawk ih apawk baktiah ni oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Takhi song naah apawk loe anghmat boih, a ohhaih ahmuen mataeng doeh panoek thai ai boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe anih zithaih tawn kaminawk khaeah loe, Angraeng amlunghaih to dungzan hoi dungzan khoek to oh, a toenghaih loe a caanawk ih a caanawk patoeng khoek to oh,
  </para>
  <para style="p">
    <verse number="18" style="v" />a lokmaihaih aek ai kaminawk hoiah a paek ih loknawk pazui han panoek kaminawk loe to tiah om o tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng loe angmah ih angraeng tangkhang to van ah caksak moe, a ukhaih prae mah pazawk boih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thacak moe, a thuih ih lok baktiah kasah, nangcae angmah ih vankaminawk, Angraeng to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih koehhaih kasah, a toksah kaminawk boih, anih ih misatuh kaminawk boih, Angraeng to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ukhaih prae thung ih ahmuen kruekah kaom a toksah kaminawk, Angraeng to tahamhoihaih paek oh; Aw ka hinghaih, Angraeng to tahamhoihaih paek ah.
  </para>
  <chapter number="104" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka hinghaih, Angraeng to tahamhoihaih paek ah; Aw Angraeng ka Sithaw, nang loe na len parai; nang loe lensawk thacakhaih hoiah nam thoep.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih loe aanghaih to kahni baktiah angkhuk; vannawk to kahni im baktiah payuengh,
  </para>
  <para style="p">
    <verse number="3" style="v" />a ohhaih ranui im tung to tuinawk thungah a suek; tamainawk to hrang lakok ah a sak moe, takhi ih pakhraehnawk nuiah a caeh,
  </para>
  <para style="p">
    <verse number="4" style="v" />angmah ih vankaminawk to takhi baktiah a sak; angmah ih toksah kaminawk to hmaipalai baktiah a sak;
  </para>
  <para style="p">
    <verse number="5" style="v" />dungzan khoek to angthuih ving han ai ah, long angdoethaih ahmuen to a sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Long to kahni hoiah khuk baktih toengah kathuk tui hoiah na khuk; maenawk nuiah tui na ohsak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na thuitaek pongah tuinawk loe cawnh o; nangmah ih khopazih tuen pongah karangah a cawnh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuinawk loe mae nuiah long o tahang; azawnnawk ah long o tathuk moe, nihcae han na sak pae ih ahmuen ah a long o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuinawk amlaem o moe, long to uem han ai ah, tui doeh amsah han ai ah, angzithaih ramri to na suek pae.
  </para>
  <para style="p">
    <verse number="10" style="v" />Maenawk salak ih azawnnawk ah tui to na pueksak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Taw ah kaom moinawk boih hanah na naeksak; taw ih hrangnawk tui anghae na dipsak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Van ih tavaanawk loe tui taengah tabu boh o; thing tanghangnawk salakah hang o.
  </para>
  <para style="p">
    <verse number="13" style="v" />A ohhaih ranui ih im hoiah maenawk to tui a bawh; long loe na toksakhaih atho hoiah zok amhah boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih mah maitawnawk hanah phroh amprawksak; kami hanah anqam kahing amprawksak pongah, kami loe long hoiah caaknaek to a hnuk,
  </para>
  <para style="p">
    <verse number="15" style="v" />kami poeknawmsak thaih misurtui, mikhmai pansak hanah situi, palungthin thacaksak hanah takaw to a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng ih thingnawk loe tui amhah o; Lebanon ah a thling ih sidar thingnawk nuiah,
  </para>
  <para style="p">
    <verse number="17" style="v" />tavaanawk tabu boh o; tahnong kapaw tuilawnnawk loe far thingnawk nuiah tabu boh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Maesangnawk to saza hoi satharnawk prathaih ahmuen ah a suek; cathaengnawk loe savehnawk ohhaih ahmuen ah a suek pae.
  </para>
  <para style="p">
    <verse number="19" style="v" />Atue panoek hanah khrah to a sak; ni mah doeh niduemhaih atue to panoek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vinghaih to na sak moe, khoving naah, taw ih moinawk boih avah o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Saning nawk kaipuinawk loe taw ih moinawk kaek hanah a hang o; Sithaw khaeah caak han koi moi to pakrong o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni tacawt naah nawnto angpop o moe, angmacae ih thlungkhaw thungah tabok o.
  </para>
  <para style="p">
    <verse number="23" style="v" />To naah kami loe toksak hanah caeh moe, duembang khoek to tok a sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aw Angraeng, na toksakhaih loe pop parai! To hmuennawk boih to palunghahaih hoiah na sak; long loe na sak ih hmuennawk hoiah koi,
  </para>
  <para style="p">
    <verse number="25" style="v" />kakawk parai tuipui doeh oh moe, kathoeng kalen moinawk hoi kroeklaek ai, long ah kavak moinawk doeh oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Palongpuinawk loe to ahmuen ah caeh o; to ah amhai hanah, na sak ih kalen pui Leviathan doeh oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />To moinawk loe nang khaeah ni amha o, atue phak naah to moinawk to na pacah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na paek ih buh to ni, nihcae mah caak o; na ban pathae naah nihcae loe kahoih hmuen hoiah koi o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mikhmai na hawk naah, nihcae raihaih tong o; nihcae anghahhaih takhi na lak pae ving naah, nihcae loe duek o moe, maiphu ah amlaem o let.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na Muithla to na patoeh moe, nihcae to na sak; long krang hae nang thasak let.
  </para>
  <para style="p">
    <verse number="31" style="v" />Angraeng lensawkhaih loe dungzan khoek to om poe tih; Angraeng loe a toksakhaihnawk pongah anghoe tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Long to a khet moe, anghuensak; anih mah maenawk sui naah, hmaikhue tacawt o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka hing thung Angraeng khaeah laa ka sak han; khosak nathung ka Sithaw pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka poekhaih loe angmah khaeah anghoehaih ah om nasoe; kai loe Angraeng ah kang hoe han.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kazae kaminawk loe long hoiah anghmaa o nasoe loe, kasae kaminawk doeh om o hmah lai nasoe. Aw ka hinghaih, Angraeng to tahamhoihaih paek ah. Angraeng to pakoeh ah.
  </para>
  <chapter number="105" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng khaeah anghoehaih lok to thui ah; anih ih ahmin to kawk oh; a sak ih hmuennawk to kaminawk khaeah amtuengsak oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angmah khaeah laasah oh loe, angmah khaeah saam laa to sah oh; a sak ih dawnrai hmuennawk to thui oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih ih ciimcai ahmin to lensawkhaih hoiah amoek o haih ah; Angraeng pakrong kaminawk ih palungthin loe anghoe nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng hoi a thacakhaih to pakrong oh; a mikhmai to pakrong oh!
  </para>
  <para style="p">
    <verse number="5" style="v" />A sak ih dawnrai, anghmang thok hmuennawk, angmah ih pakha hoi tacawt lokcaekhaihnawk to pakuem oh,
  </para>
  <para style="p">
    <verse number="6" style="v" />a tamna Abraham ih caanawk, a qoih ih Jakob ih caanawk to panoek oh!
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe aicae Angraeng Sithaw ah oh; a lokcaekhaih loe long nui boih ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih loe angmah sak ih lokmaihaih to dungzan khoek to panoek poe, a thuih ih lok to adung sangto khoek to panoek,
  </para>
  <para style="p">
    <verse number="9" style="v" />anih loe Abraham hoi a sak ih lokmaihaih, Isaak khaeah sak ih lokkamhaih to panoek poe;
  </para>
  <para style="p">
    <verse number="10" style="v" />to lokmaihaih to Jakob khaeah a caksak moe, Israel khaeah dungzan lokmaihaih ah a suek:
  </para>
  <para style="p">
    <verse number="11" style="v" />Kanaan prae to kang paek han, nangmah ih taham ah kaom qawk baktiah na toep tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae loe kami tamsi o, ue, paroeai tamsi kaminawk loe prae thungah angvin ah oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae mah acaeng maeto hoi maeto khaeah caeh o moe, prae maeto hoi kalah kaminawk khaeah a caeh o naah,
  </para>
  <para style="p">
    <verse number="14" style="v" />mi doeh kasae hmuen to sahsak ai; ue, nihcae pongah siangpahrangnawk to a thuitaek,
  </para>
  <para style="p">
    <verse number="15" style="v" />situi ka bawh ih kami to sui o hmah; kai ih tahmaanawk to nganbawh kana paek o hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih mah prae thungah khokhahaih to phaksak; caaknaek boih amrosak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae hmaa ah kami maeto, tamna ah zawh o ih, Joseph to patoeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih ih khok to thlongthuk pae o moe, sumboeng hoiah pacaekthlaek o;
  </para>
  <para style="p">
    <verse number="19" style="v" />a thuih ih lok acung ai karoek to, Angraeng ih lok mah anih to tanoek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Siangpahrang mah kami to patoeh moe, loisak; kaminawk ukkung mah doeh anih to loisak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih to a imthung ah angraeng ah suek, a tawnh ih hmuennawk boih ukkung ah a suek,
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih mah angraeng capanawk to a koeh baktiah patuk, to tiah anih loe kacoehtanawk palunghahaih patuk hanah oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israel doeh Izip prae thungah angzoh; Jakob loe Ham prae thungah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Angraeng mah angmah ih kaminawk to pungsak moe, nihcae ih misanawk pongah tha a caksak kue.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih ih kaminawk hnukma moe, a tamnanawk kasae sak pacaeng hanah, nihcae ih palungthin to a paqoi pae.
  </para>
  <para style="p">
    <verse number="26" style="v" />A tamna Mosi hoi a qoih ih Aaron to patoeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihnik mah nihcae khaeah Angraeng ih angmathaih to sak pae hoi, anghmang thok hmuennawk to Ham prae ah a sak pae hoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vinghaih to patoeh pae moe, prae to khovingsak; to tiah nihcae mah anih ih lok to aek o ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae ih tuinawk to athii ah angcoengsak moe, tanganawk to dueksak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nihcae ih prae thungah ukongnawk to a pungsak, angmacae siangpahrang iihhaih ahmuen khoek to ohsak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lok a thuih moe, taksaenawk to a pungsak, prae thung boih ah alungh to koi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anih mah khotui zuengah qaetui to paek moe, a prae thungah hmai kangqong to phaksak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Misurkung hoi thaiduetkungnawk to amrosak king moe, prae thung ih thingnawk to amtimsak boih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Anih mah lokthuih let naah, pakhuhnawk to angzoh o, kroeklaek ai langkawknawk to angzoh o,
  </para>
  <para style="p">
    <verse number="35" style="v" />angmacae prae thung ih kahing aanqamnawk to caak pae o king moe, long ah kamprawk thingthai qumponawk doeh caak pae o boih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Angmacae prae thungah kami ih athaih tangsuek ah kaom a calunawk to a hum pae boih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih mah nihcae han sui hoi sumkanglung to phawsak; angmah ih acaengnawk thungah thacak ai kami maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Izip kaminawk mah nihcae to zit pongah, nihcae amlaem o naah prae boih anghoe o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nihcae khuk hanah tamai to amzamsak, aqum ah aanghaih paek hanah hmai to a paek.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kaminawk mah hnik o naah, kuikoem to a paek, van ih takaw hoiah nihcae to zok amhahsak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anih mah thlung to paongh moe, tui to tacawt; tui loe prae karoem ah vapui baktiah longh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anih loe a tamna Abraham khaeah paek ih, kaciim a lokkamhaih to panoek poe.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih mah angmah ih kaminawk to anghoehaih hoiah caeh haih, a qoih ih kaminawk to anghoehaih hoiah a zaeh,
  </para>
  <para style="p">
    <verse number="44" style="v" />Sithaw panoek ai kaminawk ih prae to nihcae hanah a paek; minawk mah sak tangcae ih prae to nihcae mah qawk ah toep o,
  </para>
  <para style="p">
    <verse number="45" style="v" />nihcae mah anih ih kaalok to pakuem o moe, a paek ih loknawk to pazui o thai hanah, to tiah a sak pae. Angraeng to saphaw oh!
  </para>
  <chapter number="106" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh; Angraeng loe hoih pongah, angmah khaeah kawnhaih lok to thui oh; anih amlunghaih loe dungzan ah cak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi maw Angraeng mah sak ih thacak hmuennawk to thui thaih? Mi mah maw anih pakoehhaih to amtuengsak boih thai tih?
  </para>
  <para style="p">
    <verse number="3" style="v" />Toenghaih sah poe kaminawk, katoeng hmuen pazui kaminawk loe tahamhoih o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, nangmah ih kaminawk khaeah na hoihhaih amtuengsak naah, na pahnet hmah; na pahlonghaih hoiah angzo ah,
  </para>
  <para style="p">
    <verse number="5" style="v" />to tiah nahaeloe na qoih kami ih hoihhaih to ka hnu tih, na caeng kaminawk to kang hoe haih ueloe, qawk ah na toep ih kaminawk hoi nawnto kang pakoeh thai tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaicae loe kam panawk ih zaehaih baktiah ka zae o boeh, hmuen ka sak o pazae boeh; kahoih ai hmuen to ka sak o boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kam panawk Izip prae ah oh o naah, na sak ih dawnrai hmuennawk to panoek o thai ai; pop parai na palungnathaihnawk to panoek o ai boeh, tuipui taengah tuipui kathim taengah, anih to laisaep o thuih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe thacak a sakthaihaih to amtuengsak thai hanah, angmah ih ahmin hoiah nihcae to pahlong.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuipui kathim to a zoeh naah, tui to kang boih; praezaek ah caeh baktih toengah, nihcae to a caeh haih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae hnuma kami ih ban thung hoiah anih mah pahlong moe, misa ban thung hoiah nihcae to akrangh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae ih misanawk loe tui mah khuk hmoek, maeto doeh anghmat o ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah nihcae mah a thuih ih loknawk to tang o moe, anih saphawhaih laa to a sak o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe nasetto doeh akra ai ah anih mah sak ih hmuennawk to pahnet o let; anih mah thuih ih lok to zing o ai,
  </para>
  <para style="p">
    <verse number="14" style="v" />toe caaknaek koeh hmoekhaih hoiah praezaek ah khosak o moe, praezaek ah Sithaw to tanoek o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nihcae mah hnik ih hmuen to anih mah paek pae, toe angmacae pakhra zaekhaih to a phaksak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae kahni im ah atai o naah, Mosi hoi Angraeng ih kaciim kami Aaron to a ut o.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah long to koih moe, Dathan to paaeh; Abiram ih ampuinawk to taet hmoek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih ih kaminawk to hmai hoiah qoeng o, kahoih ai kaminawk to hmaipalai mah kangh boih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Horeb ah maitaw caanawk to sak o moe, to tiah sakcop ih krang to a bok o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angmacae lensawkhaih to qam kacaa, sakcop ih maitaw krang hoiah athlaeng o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izip prae ah kalen parai hmuen kasah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ham prae ah dawnrai hmuennawk kasah, tuipui kathim taengah zitthok hmuennawk kasah, angmacae pahlongkung Sihtaw to pahnet o ving boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah nihcae to paduek han ai ah, anih palungphuihaih to dipsak hanah, a qoih ih Mosi mah a hmaa ah angdoe khoep ai nahaeloe, nihcae to paduek tih boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ue, nihcae mah kahoih prae to patoek o moe, a thuih ih lok to tang o ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Angmacae ih kahni im ah laisaep o, Angraeng ih lok to tahngai o ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pongah nihcae to praezaek ah hum hanah,
  </para>
  <para style="p">
    <verse number="27" style="v" />a caanawk doeh prae kalah kaminawk ih ban thungah amtimsak moe, prae thung boih ah amhetsak phang hanah, a ban payanghaih hoiah lokkamhaih to a sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae loe Peor ih Baal khaeah angqoi o lat moe, hinghaih katawn ai sithawnawk khaeah paek ih angbawnhaih buh aannawk to a caak o.
  </para>
  <para style="p">
    <verse number="29" style="v" />To tiah a sak o ih hmuennawk hoiah Sithaw palungphui hanah a sak o pongah, nihcae khaeah nathaih to phaksak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe Phinehas loe angthawk moe, nihcae abomh hanah salakah angdoet pongah, nathaih to amkhap pae duk.
  </para>
  <para style="p">
    <verse number="31" style="v" />To tiah a sak ih hmuen pongah anih loe angzo han koi adung kaminawk boih mah kami katoeng ni, tiah dungzan khoek to thuih o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lok angaekhaih tui taengah nihcae mah Angraeng to palungphui o sak, nihcae pongah Mosi khaeah raihaih to phak,
  </para>
  <para style="p">
    <verse number="33" style="v" />Sithaw ih Muithla to aek o pongah, poek ai puiah Mosi ih pakha thung hoiah lok to tacawt.
  </para>
  <para style="p">
    <verse number="34" style="v" />Angraeng mah nihcae khaeah paek ih lok baktih toengah, acaeng kalah kaminawk to hum o ai,
  </para>
  <para style="p">
    <verse number="35" style="v" />toe Sithaw panoek ai kaminawk hoiah angbaeh o moe, nihcae khosakhaih tuinuen to amtuk o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Angmacae han thaang ah kaom, prae kalah kaminawk ih krangnawk to a bok o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ue, angbawnhaih ah a capa hoi a canunawk to taqawk khaeah paek o,
  </para>
  <para style="p">
    <verse number="38" style="v" />Kanaan kaminawk mah bok o ih krangnawk khaeah, tidoeh panoek ai a capanawk hoi a canunawk ih athii to palong o; athii hoiah prae to panuet thok ah a sak o.
  </para>
  <para style="p">
    <verse number="39" style="v" />A sak o ih hmuennawk hoiah angmacae to amhnong o sak; a sak o ih hmuennawk hoiah tangyat zaw kami ah angcoeng o.
  </para>
  <para style="p">
    <verse number="40" style="v" />To pongah Angraeng loe angmah ih kaminawk nuiah palungphui, angmah ih qawktoep koi kaminawk doeh panuet.
  </para>
  <para style="p">
    <verse number="41" style="v" />To pongah nihcae to Sithaw panoek ai kaminawk ban ah a paek, a hnukma ih kaminawk mah nihcae to uk.
  </para>
  <para style="p">
    <verse number="42" style="v" />A misanawk mah nihcae to pacaekthaek o, nihcae to misa ban thungah a suek.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih mah nihcae to pahlong tuektuek boeh; toe anih ih lokaek han khue a poek o pongah, nihcae loe angmacae zaehaih thungah amtimh o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Toe nihcae qahhaih lok anih mah thaih naah, patang a khang o haih to a poek pae let;
  </para>
  <para style="p">
    <verse number="45" style="v" />nihcae khaeah sak ih a lokmaihaih to poek pae let, pop parai a palungnathaih baktih toengah, dawnpakhuemhaih a tawnh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nihcae misongah caeh haih kaminawk khaeah tahmenhaih a tawnhsak let.
  </para>
  <para style="p">
    <verse number="47" style="v" />Aw Angraeng kaicae ih Sithaw, kaciim na hmin pongah anghoehaih lok to ka thuih o moe, na lensawkhaih to ka saphaw o thai hanah, kaicae hae na pahlong ah loe, Sithaw panoek ai kaminawk ih ban thung hoiah na tacuu let ah.
  </para>
  <para style="p">
    <verse number="48" style="v" />Israelnawk ih Angraeng Sithaw loe dungzan hoi dungzan khoek to tahamhoihaih om nasoe; kaminawk boih mah, Amen, tiah thui o nasoe. Angraeng to saphaw oh.
  </para>
  <chapter number="107" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe hoih pongah, angmah khaeah kawnhaih lok to thui oh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah akrang ih kaminawk mah, anih mah ni misa ban thung hoiah ang krang,
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah ni, ni angyae, niduem, aluek, aloih, prae congca hoiah nihcae to nawnto pakhueng, tiah thui o nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe praezaek ah bomkung om ai ah amhet o; khosak hanah vangpui doeh hnu o ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zok amthlam hoi tui anghae ah a oh o moe, a hinghaih thazai o sut.
  </para>
  <para style="p">
    <verse number="6" style="v" />Raihaih tong naah Angraeng khaeah a qah o, to naah anih mah patangkhanghaih thung hoiah nihcae to pahlong.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah a oh o haih vangpui thungah phak o thai hanah, katoeng loklam hoiah caeh haih.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hoihhaih hoi kaminawk khaeah sak ih dawnrai hmuennawk pongah, Angraeng khaeah kawnhaih lawk thui o nasoe!
  </para>
  <para style="p">
    <verse number="9" style="v" />Hinghaih tui anghae kami to anih mah dipsak moe, hinghaih zok amthlam kami doeh caak hanah kahoih hmuen hoiah a koisak.
  </para>
  <para style="p">
    <verse number="10" style="v" />To baktih kami loe vinghaih hoi duekhaih tahlip thungah anghnut o, patangkhang o moe, sumqui hoiah pathlet o,
  </para>
  <para style="p">
    <verse number="11" style="v" />nihcae loe Sithaw ih loknawk to aek o moe, Kasang koek mah thuih ih lok to tidoeh sah o ai pongah, to tiah oh o.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pongah nihcae mah palungthin pahnaem o thai hanah, karai tok to a saksak; nihcae loe amthaek o, kalawnkung mi doeh om ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Raihaih tong o naah Angraeng khaeah a hang o, nihcae patangkhanghaih thung hoiah anih mah pahlong.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih mah vinghaih, duekhaih tahlip thung hoiah zaeh moe, sumquinawk to a khramh pae.
  </para>
  <para style="p">
    <verse number="15" style="v" />A hoihhaih hoiah kaminawk khaeah sak ih dawnrai hmuennawk pongah, Angraeng khaeah kawnhaih lawkthui o nasoe!
  </para>
  <para style="p">
    <verse number="16" style="v" />Tipongah tih nahaeloe anih mah sumkamling hoi sak ih khongkha to khaeh moe, ataehhaih sumboeng doeh adaem pae boih boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thoemto kaminawk loe lokaekhaih pongah amthu o moe, a sakpazae o haih pongah, patangkhang o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Buh aannawk to panuet o moe, duekhaih khongkha taengah a phak o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Raihaih tong o naah Angraeng khaeah a hang o, nihcae patanghaih thung hoiah anih mah pahlong.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih mah lok to thuih moe, nihcae to ngantuisak; amrohaih thung hoiah nihcae to pahlong.
  </para>
  <para style="p">
    <verse number="21" style="v" />A hoihhaih hoiah kaminawk khaeah sak ih dawnrai hmuennawk pongah, Angraeng khaeah kawnhaih lawk thui o nasoe!
  </para>
  <para style="p">
    <verse number="22" style="v" />Anghoehaih hoiah hmuenpaekhaih to tathlang o nasoe loe, a sak ih hmuennawk to anghoehaih hoiah taphong o nasoe.
  </para>
  <para style="p">
    <verse number="23" style="v" />Palongpuinawk hoiah tuipui thungah kacaeh, tuipui nuiah toksah kaminawk loe,
  </para>
  <para style="p">
    <verse number="24" style="v" />Angraeng ih hmuenmaenawk hoi a sak ih tui thungah kaom dawnrai hmuennawk to hnuk o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih mah lokpaek naah takhi song moe, tuiphunawk to angthawksak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuiphunawk loe van khoek to angthawk o tahang moe, tui thungah krak o tathuk let; zitthoh parai pongah, palungboeng o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae loe ahnuk ahma angthuih o, mu paqui kami baktiah a caeh o moe, poekhaih palung boeng o sut.
  </para>
  <para style="p">
    <verse number="28" style="v" />Raihaih tong o naah Angraeng khaeah a hang o, palungboenghaih thung hoiah nihcae to a zaeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih mah takhi sae to dipsak moe, tuiphunawk to anghaksak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tui anghak naah nihcae anghoe o; to naah a caeh koeh o haih ahmuen ah nihcae to a zaeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A hoihhaih hoiah kaminawk khaeah sak ih dawnrai hmuennawk pongah, Angraeng khaeah kawnhaih lawk thui o nasoe!
  </para>
  <para style="p">
    <verse number="32" style="v" />Kaminawk angpophaih ahmuen ah anih to pakoeh oh loe, kacoehtanawk amkhuenghaih ahmuen ah anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih loe vapuinawk to praezaek ah angcoengsak moe, tuibap ahmuen doeh long karoem ah angcoengsak,
  </para>
  <para style="p">
    <verse number="34" style="v" />to ahmuen ah kaom kaminawk ih sethaih pongah, long kahoih prae to thingthai qumpo tacawt thai ai ahmuen ah angcoengsak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Praezaek to tuili ah angcoengsak moe, long karoem to tuibap ah angcoengsak.
  </para>
  <para style="p">
    <verse number="36" style="v" />To ah zok amthlam kaminawk to ohsak moe, angmacae oh haih hanah vangpui to sak o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Lawknawk a tawnh o, misur takha a sak o moe, kating ai athaihnawk to tacawt.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nihcae to tahamhoihaih a paek moe, pop parai ah angpung o; nihcae ih maitaw hoi tuunawk doeh tamsisak ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nihcae loe pacaekthlaekhaih, patangkhanghaih hoi palungsethaih pongah, kami to tamsi o moe, khosak ahnaem o tathuk let.
  </para>
  <para style="p">
    <verse number="40" style="v" />Anih mah Angraeng ih capanawk to azathaih tongsak moe, loklam kaom ai praezaek ah amhetsak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Toe amtang kaminawk to patanghaih thung hoiah tapom tahang moe, tuunawk baktiah imthong ah angcoengsak.
  </para>
  <para style="p">
    <verse number="42" style="v" />Katoeng kaminawk mah to hmuen to hnuk o naah anghoe o tih; kahoih ai kaminawk boih loe angmacae ih pakha to tamuep o tih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Palungha kami loe, hae hmuennawk hae poek ueloe, Angraeng amlunghaih to panoek o tih.
  </para>
  <chapter number="108" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Sithaw, ka palungthin loe cak; ka hinghaih boih hoiah nang pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Katoeng hoi tamoinawk, angthawk oh! Kai loe khawnthaw ah kang thawk han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng, kaminawk salakah, nang kang pakoeh han; acaeng kaminawk salakah nang pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na palungnathaih loe len moe, van pongah doeh sang kue; na loktang lok loe van khoek to phak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Sithaw, nang loe vannawk pongah sang nasoe; na lensawkhaih long nui boih ah om nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na palung ih kaminawk pahlong thai hanah, na bantang ban hoiah pahlong ah loe, ka lok hae na tahngai pae ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sithaw loe angmah ih hmuenciim hoiah lokthuih boeh; kai loe kang hoe han; Shekem to pakhoih moe, Sukkoth azawn to ka tah han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gilead loe kai ih ni; Manasseh doeh kai ih ni; Ephraim loe ka lu thacakhaih lumuek ah oh; Judah loe kai ih kaalok patukkung ah oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moab loe khok kam saehhaih sabae kathuk ah oh; Edom nuiah kaimah ih khokpanai to ka vah han; Philistia nuiah pazawkhaih hoiah ka hangh han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sipae kacak vangpui thungah mi mah maw na zae tih? Mi mah maw Edom prae ah na caeh haih tih?
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Sithaw, nangmah na ai maw kaicae hae pahnawt sut? Kaicae ih misatuh kaminawk hoi nawnto caeh ai ah kaom kami doeh, nang na ai maw?
  </para>
  <para style="p">
    <verse number="12" style="v" />Raihaih thung hoiah ka loih o thai hanah, na bom ah; kami mah abomhaih loe azom pui ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaicae loe Sithaw rang hoiah misa ka hoih o tih; kaicae ih misanawk to anih na tii pae tih.
  </para>
  <chapter number="109" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka pakoeh ih, Aw Sithaw, angam duem hmah;
  </para>
  <para style="p">
    <verse number="2" style="v" />kasae kaminawk hoi aling thaih kaminawk mah kai han pakha ang angh o thuih, nihcae loe kai khaeah amsawnlok thuih o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hnukmahaih loknawk hoiah kai ang takui o; takung om ai ah kai ang tuk o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai ih amlunghaih to misa ah a poek o lat; toe kai loe lawkthuihaih hoiah ni ka oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae mah kahoih hmuen to kasae hoiah ang pathok o moe, kai ih amlunghaih to a hnukma o.
  </para>
  <para style="p">
    <verse number="6" style="v" />To baktih kami nuiah kasae kami to suem pae ah, Setan loe a bantang bangah angdoe pae nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe lokcaek naah sung nasoe loe, lawk a thuihaih to zaehaih ah angcoeng pae nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hinghaih aninawk tamsi pae nasoe loe, minawk kalah mah anih angdoethaih ahmuen to la pae ving nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih ih caanawk loe ampa tawn ai ah om o nasoe loe, a zu loe lamhmai ah om nasoe.
  </para>
  <para style="p">
    <verse number="10" style="v" />A caanawk loe ahmuen kruekah amhet hoiah ban patueng o nasoe; kamro a oh o haih im hoiah tacawt o nasoe loe, caaknaek to pakrong o nasoe.
  </para>
  <para style="p">
    <verse number="11" style="v" />A tawnh ih hmuennawk to hmuenmae coi han paek kami mah la pae boih nasoe; a toksakhaih atho doeh minawk kalah mah lomh pae ving nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi mah doeh anih nuiah tahmenhaih tawn hmah nasoe; ampa tawn ai nawktanawk doeh tahmen o hmah nasoe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih ih caanawk loe anghma angtaa o nasoe; angzo han koi adungah doeh nihcae ih ahmin to phrae o boih nasoe.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ampanawk sakpazaehaih loe Angraeng hmaa ah amtueng poe nasoe; amno zaehaih to anghma pae hmah nasoe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nihcae panoekhaih long hoiah tahmat pae ving hanah, nihcae zaehaih loe Angraeng hmaa ah om poe nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih loe palungnathaih amtuengsak hanah poek ai, amtang kaminawk to pacaekthlaek moe, palungboeng kaminawk doeh a hum.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih loe tangoenghaih to palung pongah, tangoenghaih to anih nuiah krah nasoe; tahamhoihaih koeh ai pongah, tahamhoihaih loe anih khae hoi kangthla ah om nasoe.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah loksae to kahni baktiah angkhuk pongah, a zok thungah tui baktih, ahuhnawk thungah situi baktiah akun pae nasoe.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angmah angkhuk ih kahni baktih, kaengah angzaeng poe ih kazii baktiah, a nuiah om pae nasoe.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kai kasaethui kaminawk khaeah, Angraeng mah hae hae tangqum ah paek nasoe.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe, Aw Angraeng Sithaw, na hmin hoiah na sah paeh; na palungnathaih loe hoih pongah, na pahlong ah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai loe kam tang, ka tak thung ih palung loe ahma caak boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai loe duembang ih tahlip baktiah ka zaem tathuk boeh; pakhuh baktiah ahnuk ahma kang thuih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Buhzah pongah ka khokkhunawk hae cak ai boeh; ka taksa doeh zaek keng boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Minawk kasaethuih han ih ni ka oh boeh moe, nihcae mah kai ang khet o naah lu ang haek o thuih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aw Angraeng ka Sithaw, na bom ah; na palungnathaih hoiah na pahlong ah,
  </para>
  <para style="p">
    <verse number="27" style="v" />hae loe na ban ni; Angraeng, nang mah ni na sak, tiah panoek o nasoe.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae loe tangoeng o, toe nang loe tahamhoihaih paek ah; nihcae angthawk o naah, azat o nasoe; toe na tamna loe anghoe nasoe.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka misanawk loe azathaih to kahni baktiah angkhuk o nasoe, kahni hoi khuk ih baktiah, mikhmai sethaih to angkhuk o nasoe.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka pakha hoiah Angraeng to ka pakoeh parai boeh; ue, pop parai salakah anih to ka pakoeh han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zaehaih net kaminawk ih ban thung hoiah amtang kaminawk ih hinghaih pahlong hanah, anih loe amtang kaminawk ih bantang bangah angdoet.
  </para>
  <chapter number="110" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah ka Angraeng khaeah, Na misanawk na khok koenghaih ah ka sah boih ai karoek to, ka bantang bangah anghnu ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah na thacakhaih cunghet to Zion hoiah patoeh ueloe, na misanawk salakah uk tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na thacakhaih hoi na ukhaih niah na lensawkhaih to nang ih kaminawk hnu o tih, nang loe kaciim thacakhaih hoiah nam thoep ueloe, akhawnbang ih zok thung hoiah na tha ohhaih dantui to na tawn tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah sak ih lokkamhaih loe amkhrai let mak ai boeh; Melkhizadek baktiah Nang loe dungzan khoek to qaima ah na oh boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na bantang bangah kaom Angraeng loe palungphuihaih niah siangpahrangnawk to bop tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah Sithaw panoek ai kaminawk to lokcaek ueloe, ahmuen kruekah kaminawk ih qok to omsak tih; prae congca ukkungnawk to ahmaa caasak tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe loklam taeng ih vacong tui to nae ueloe, lu to phok tahang tih.
  </para>
  <chapter number="111" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to pakoeh oh. Katoeng kami amkhuenghaih hoi minawk amkhuenghaih ahmuen ah, Angraeng to palungthin boih hoiah ka pakoeh han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah sak ih hmuennawk loe len parai; to baktih hmuen koeh kaminawk boih mah loe anih to pakrong o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih ih tok loe lensawkhaih hoiah koi moe, pakoeh han koi oh; a toenghaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah panoek poe hanah dawnrai hmuennawk to sak; Angraeng loe tahmenhaih tawnh moe, amlunghaih hoiah koi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe angmah zithaih tawn kaminawk khaeah caaknaek to paek; anih loe a sak ih lokmaihaih to pahnet ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />A sakthaihaih hmuennawk to angmah ih kaminawk khaeah amtuengsak moe, Sithaw panoek ai kaminawk ih qawk to nihcae hanah a paek.
  </para>
  <para style="p">
    <verse number="7" style="v" />A ban hoi sak ih hmuennawk loe toeng moe, oepthoh; anih mah patuk ih loknawk doeh oepthoh.
  </para>
  <para style="p">
    <verse number="8" style="v" />To hmuennawk loe dungzan hoi dungzan khoek to cak o poe, a sak naah loktang hoi toenghaih hoiah a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angmah ih kaminawk hanah akranghaih to paek; lok amaihaih to dungzan khoek to a caksak; anih ih ahmin loe ciimcai moe, zitthoh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng zithaih loe palungha amtonghaih ah oh; a paek ih lok pazui kaminawk boih loe panoekhaih kahoih to tawnh o; anih pakoehhaih loe dungzan khoek to cak poe.
  </para>
  <chapter number="112" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh. Angraeng to zit moe, a paek ih loknawk nuiah anghoehaih tawn kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih ih caanawk loe long nuiah thacak o tih; katoeng kami ih caanawk loe tahamhoih o tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />A im ah hmuenmae hoi angraenghaih to om tih; a toenghaih loe dungzan khoek to om poe tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Katoeng kami hanah loe, khoving thungah aanghaih to oh. To baktih kami loe tahmenhaih hoi amlunghaih to tawnh moe, toenghaih hoiah tok to sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kuuhoih moe, paek koehhaih palungthin tawn kami loe khosak hoih; anih loe toenghaih hoiah tok to sah tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih loe tasoehhaih om mak ai; katoeng kami loe dungzan khoek to pahnet mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tamthang sae to anih mah zii mak ai; Angraeng to a oep pongah, palungthin to cak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih ih palungthin loe cak, a misanawk pazawkhaih hnu ai karoek to zithaih tawn mak ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe amtang kaminawk hanah paek moe, pazet boih pongah, a toenghaih loe dungzan khoek to cak; angmah ih taki to pakoehhaih hoiah tapom tahang tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kahoih ai kami mah anih to hnuk naah, palung naa tih; anih loe haa to kaek ueloe, amro tih; to naah kasae kami koehhaih to anghmaa tih boeh.
  </para>
  <chapter number="113" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh. Aw Angraeng ih tamnanawk, saphaw oh, Angraeng ih ahmin to saphaw oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vaihi hoi dungzan khoek to Angraeng ih ahmin tahamhoihaih om nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni tacawt hoi niduem khoek to Angraeng ih ahmin to saphaw han oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng loe prae kaminawk boih pongah sang moe, a lensawkhaih doeh vannawk pongah sang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahmuen sang ah kaom, aicae Angraeng Sithaw baktiah,
  </para>
  <para style="p">
    <verse number="6" style="v" />van hoi long ih hmuennawk khet hanah poekhaih pahnaemh mi maw kaom?
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe amtang kami to maiphu thung hoiah pathawk moe, kavawt kami to aek thung hoiah pathawk,
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah siangpahrang ih caanawk, angmacae kami siangpahrang ih caanawk hoi nawnto anghnuthaih ahmuen to paek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Caa kaak nongpata to im khenzawnkung hoi anghoehaih tawn caanawk ih amno ah a sak. Angraeng loe saphaw oh.
  </para>
  <chapter number="114" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel loe Izip prae thung hoiah tacawt, Jakob ih imthung takoh loe kalah prae kaminawk khae hoiah angzoh naah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah loe angmah ih hmuenciim ah oh, Israel loe a ukhaih prae ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuipui mah Sithaw to hnuk naah, cawnh ving; Jordan vapui loe amlaem let.
  </para>
  <para style="p">
    <verse number="4" style="v" />Maenawk loe tuu taenawk baktih, maesomnawk loe tuu caanawk baktiah angphet o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw tuipui nang, tipongah na cawnh ving, Aw Jordan vapui nang, tipongah nam laem let loe?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangcae maenawk, tipongah tuu taenawk baktih, nangcae maesomnawk, tipongah tuu caanawk baktiah nang phet o loe?
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw long nang, Angraeng hmaa hoi Jakob ih Sithaw hmaa ah, tasoeh ah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah lungsong to tuili ah, kamtak thlung to tuibap tui ah angcoengsak boeh.
  </para>
  <chapter number="115" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaicae khaeah na ai, Aw Angraeng, kaicae khaeah na ai, na palungnathaih hoi na loktang lok pongah, na hmin lensawkhaih to om nasoe.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tipongah Sithaw panoek ai kaminawk mah, Nihcae ih Sithaw loe naa ah maw oh tiah thuih o loe?
  </para>
  <para style="p">
    <verse number="3" style="v" />Aicae ih Sithaw loe van ah oh; anih loe a koeh baktiah hmuennawk to sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae ih krang loe kami ban hoiah sak ih sumkanglung hoi sui ah ni oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe pakha tawnh o, toe lok apae o thai ai; mik a tawnh o, toe hnu o thai ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />naa a tawnh o, toe thaih o thai ai, hnah doeh a tawnh o, toe ahmui thaih o thai ai;
  </para>
  <para style="p">
    <verse number="7" style="v" />ban a tawnh o, toe sui o thai ai; khok a tawnh o, toe caeh o thai ai; taaw hoiah lokthui o thai ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Krang sah kaminawk loe krang hoiah anghmong o, krang oephaih tawn kaminawk doeh krang baktiah ni oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Israel imthung takoh, Angraeng to oep ah; anih loe nangcae bomkung hoi angvaenghaih ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aaron imthung takoh, Angraeng to oep oh, anih loe nihcae bomkung hoi abuephaih ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih zii kaminawk, Angraeng to oep oh; anih loe nihcae bomkung hoi abuephaih ah oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng mah aicae pahnet mak ai; aicae hanah angmah ih tahamhoihaih to paek tih: Israel imthung takoh to tahamhoihaih paek ueloe, Aaron imthung takoh doeh tahamhoihhaih paek tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kathoeng doeh kalen doeh, Angraeng zii kaminawk loe anih mah tahamhoihaih to paek tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng mah nangmah hoi na caanawk to pungsak aep nasoe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Van hoi long sahkung Angraeng mah tahamhoihhaih paek nasoe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Van hoi vannawk loe Angraeng ih ni; toe long loe kaminawk khaeah a paek boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angqai krang ahmuen ah caeh tathuk, kadueh kaminawk loe Angraeng to saphaw o vai ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe kaicae loe vaihi hoi dungzan khoek to Angraeng tahamhoihaih ka paek o han. Angraeng to saphaw oh.
  </para>
  <chapter number="116" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka lok hoi tahmen ka hnikhaih lok, anih mah ang thaih pae pongah, Angraeng to ka palung.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai khae bangah a naa to patueng pongah, ka hing thung anih to ka kawk han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai loe duekhaih qui mah ang zaeng moe, taprong patangkhanghaih mah ang naeh; raihaih hoi palungsethaih to ka tongh.
  </para>
  <para style="p">
    <verse number="4" style="v" />To naah Angraeng ih ahmin to ka kawk; Aw Angraeng, ka hinghaih na pahlong ah, tiah ka hnik.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng loe toeng moe, tahmenhaih hoiah koi; ue, aicae ih Sithaw loe palungnathaih hoiah koi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng mah poektoeng kami to khetzawn; poekhaih ka pahnaem naah, kai hae ang bomh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw ka hinghaih, nang hakhaih ahmuen ah amlaem ah; Angraeng mah nang hanah kahoih hmuen to sak boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Duekhaih thung hoiah ka hinghaih hae pahlong ah, mikkhraetui krakhaih thung hoiah ka mik hae pahlong ah loe, amthaekhaih thung hoiah ka khoknawk to na pahlong rae ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai loe kahing kaminawk ih prae ah Angraeng hmaa ah ka caeh han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kai loe patangkhang parai boeh, tiah ka thuih, toe tanghaih ka tawnh vop.
  </para>
  <para style="p">
    <verse number="11" style="v" />Poek ai pui hoiah kaminawk loe lok amlai o boih, tiah ka thuih moeng boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng mah ka nuiah sak ih hoihaihnawk boih kawbangmaw ka pathok han?
  </para>
  <para style="p">
    <verse number="13" style="v" />Pahlonghaih boengloeng to ka patawnh moe, Angraeng ih ahmin to ka kawk han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng khaeah lokkamhaih to anih ih kaminawk boih hmaa ah ka koepsak han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angmah ih kaciim kaminawk duekhaih loe, Angraeng mikhnuk ah atho kaom koek ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw Angraeng, kai loe na tamna tangtang ni; kai loe na tamna hoi na tamna nongpata ih capa ah ka oh; pathlethaih khawkqui to nang khramh pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kawnhaih lok thuihaih to nang khaeah kang tathlang moe, Angraeng ih ahmin to ka kawk han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angmah ih kaminawk boih hmaa ah Angraeng khaeah lokkamhaih to ka koepsak han,
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng ih im longhmaa ah, Aw Jerusalem, nang salakah ka koepsak han. Angraeng to saphaw oh.
  </para>
  <chapter number="117" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangcae prae congca kaminawk boih, Angraeng to saphaw oh; nangcae kaminawk boih, anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aicae nui ah kaom a palungnathaih loe len parai; Angraeng ih loktang lok loe dungzan khoek to cak. Angraeng to saphaw oh.
  </para>
  <chapter number="118" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe hoih pongah, angmah khaeah kawnhaih lok to thui oh; a tawnh ih palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="2" style="v" />A palungnathaih loe dungzan khoek to cak, tiah Israel mah thui nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />A palunghaih loe dungzan khoek to cak, tiah Aaron imthung takoh mah thui nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng zii kaminawk boih mah, a palungnathaih loe dungzan khoek to cak, tiah thui o nasoe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palung ka boeng naah Angraeng to ka kawk; anih mah ang pathim moe, kalen parai ahmuen ah ang prawt.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng loe kai bangah oh pongah, ka zii mak ai; kami mah kawbangmaw na naa thai tih?
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng loe kai bangah oh moe, kai ang bomh pongah, kai hnuma kaminawk nuiah palung khuek, tihhaih ka hnu tih boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami oep pongah loe Angraeng khaeah amha hae hoih kue.
  </para>
  <para style="p">
    <verse number="9" style="v" />Long angraengnawk to oep pongah loe Angraeng khaeah amha hae hoih kue.
  </para>
  <para style="p">
    <verse number="10" style="v" />Prae congca kaminawk mah kai ang takui o khoep; toe Angraeng ih ahmin hoiah nihcae to kam rosak han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihcae mah kai ahnuk ahma ang maah o; ue, kai ang takui o; toe Angraeng ih ahmin hoiah nihcae to kam rosak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khoimi baktiah kai ang takui o khoep; nihcae loe soekhring hmai baktiah duek o; Angraeng ih ahmin hoiah nihcae to kam rosak han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai amtimh thai hanah, nang nuih; toe Angraeng mah kai ang bomh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng loe ka thacakhaih hoi laasakhaih ah oh moe, ka pahlonghaih ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anghoehaih hoi pahlonghaih lok loe katoeng kaminawk ohhaih ahmuen ah oh: Angraeng ih bantang ban mah kalen parai hmuen to sak boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng ih bantang ban loe payangh tahang moe, Angraeng ih bantang ban mah kalen parai hmuen to sak boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka dueh mak ai, ka hing tih, to pongah Angraeng mah sak ih hmuen to ka thuih han vop.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angraeng mah kana parai ah ang thuitaek; toe duekhaih khaeah na paek ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kai hanah toenghaih khongkha to ang paongh pae; kai loe akun moe, Angraeng to ka pakoeh han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hae khongkha loe Angraeng ih ni; katoeng kaminawk loe akun o tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka lok nang pathim moe, ka pahlonghaih ah na oh pongah, nang to kang pakoeh han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Imsah kaminawk mah pahnawt ih thlung loe atho kaom koek im takii ih thlung ah angcoeng boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hae loe Angraeng mah a sak; aicae mikhnuk ah dawnrai hmuen ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hae loe Angraeng mah sak ih ani ah oh, anghoehaih hoiah anih khaeah nawm o si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aw Angraeng, nang pahlong hanah kang hnik; Aw Angraeng, tahamhoihhaih nang paek hanah kang hnik.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng ih ahmin hoi angzo kami loe tahamhoih nasoe; Angraeng im hoiah tahamhoihaih kang paek o boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Angraeng loe Sithaw ah oh moe, aicae han aanghaih to ang paek; angbawnhaih moi to hmaicam takii ah qui hoiah kom o si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nang loe ka Sithaw ah ni na oh, nang to kang pakoeh han; nang loe ka Sithaw ah ni na oh, nang to kang pakoeh han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng loe hoih pongah, angmah khaeah anghoehaih lok to thui oh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <chapter number="119" style="c" />
  <para style="p">
    <verse number="1" style="v" />Coek koi om ai loklam ah caeh ah, Angraeng ih kaalok to pazui kaminawk loe tahamhoih.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thuih ih loknawk to pakuem moe, palungthin boih hoiah anih pakrong kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae loe zaehaih sah o ai; anih ih loklam ah caeh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na loklam to loktangta hoi pazui hanah kaicae khaeah nang thuih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw, na paek ih loknawk to pazui thai hanah, lam nang patuek!
  </para>
  <para style="p">
    <verse number="6" style="v" />Na paek ih loknawk boih to ka pakuem nahaeloe, azathaih ka tongh mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng na lokcaekhaih kam tuk naah, poektoenghaih hoiah nang to kang pakoeh han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang paek ih loknawk to ka pazui han; aw kai hae na pahnawt hmah roe ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kawbangmaw qoengthuem kami mah a caehhaih loklam to ciimsak thai tih? Na lok baktih toengah khosakhaih rang hoiah ni ciimsak tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palungthin boih hoiah nang to kang pakrong; Aw, nang paek ih loknawk hoi nam khraengsak hmah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na nuiah zaehaih ka sak han ai ah, na lok to palung thungah ka suek boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Angraeng, taham na hoih! Nang paek ih loknawk to na patuk ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na pakha thung hoi tacawt na loknawk boih to pakha hoiah ka taphong boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmuenmae congca hoi angraeng parai kami baktiah, na thuih ih loknawk pongah anghoehaih ka tawnh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na loknawk to ka poek moe, na loklamnawk doeh ka khet han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang paek ih loknawk pongah kang hoe, na lok to ka pahnet mak ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka hing moe, na lok pazui thai hanah, na tamna khaeah kahoih hmuen to sah ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na kaalok thungah dawnrai hmuennawk ka hnuk thai hanah, ka mik hae na paong pae ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Long ah angvin ah ka oh; nang paek ih loknawk to kai khae hoi hawk ving hmah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na lokcaekhaih ka poek loiah ka hinghaih amro boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lokpaekhaihnawk hoiah amkhraeng ving, amoek kami hoi tangoeng ih kaminawk to nang mah na thuitaek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang thuih ih loknawk ka pazui pongah, kasaethuihaih hoi hnaphnaehaih to kai khae hoi na takhoe pae ving ah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraengnawk mah kai kasae ang thuih o; toe na tamna loe nang paek ih loknawk ni ka poek.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na thuih ih loknawk loe kang hoehaih hoi kai han poekhaih paekkung ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka hinghaih loe maiphu thungah anghnut sut, na lok baktih toengah na hingsak ah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka caehhaih loklam kawng ka thuih naah, nang pathim; nang paek ih loknawk to kai han na patuk ah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang thuitaekhaih loklamnawk to na panoeksak ah; to tiah nahaeloe dawnrai hmuennawk to ka poek tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Palungset pongah ka hinghaih angpho sut boeh; na lok hoiah tha na caksak ah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Alinghaih loklam thung hoi ka loih thai hanah, tahmenhaih hoi na kaalok to na paek ah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai loe loktang lam to ka qoih moe, na lokcaekhaih ka hmaa ah ka suek boeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na thuih ih loknawk to kacakah ka patawnh boeh; Aw Angraeng, azathaih na tongsak hmah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka palungthin nam ongsak boeh pongah, na thuih ih loklam pongah ka cawnh han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aw Angraeng, na thuih ih loknawk pazuihaih loklam to na patuk ah; to loklam to boeng khoek to ka pazui han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na kaalok to ka pazui hanah, panoek thaihaih to na paek ah; ue, kaalok to palungthin boih hoiah ka pazui han.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nang paek ih loknawk hoiah loklam na patuek ah; to loklam ah ni anghoehaih ka tawnh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka palung hae khithaih bangah na ai ah, na thuih ih loknawk bangah paqoi ah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Atho kaom ai hmuennawk khet han ai ah ka mik hae paqoi ving ah; na loklam ah na hingsak ah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nang zithaih tawn, na tamna khaeah na lok to caksak ah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na lokcaekhaih loe hoih baktih toengah, ka zit koek ih kasaethuihaih to na la pae ving ah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Khenah, nang paek ih loknawk to ka poek khing; na toenghaih bangah na hingsak ah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Aw Angraeng, na tahmenhaih rang hoiah na lok baktih toengah, na pahlonghaih kai khaeah angzo nasoe.
  </para>
  <para style="p">
    <verse number="42" style="v" />Na lok ah oephaih ka tawnh pongah, kai kasae thui kami to lok ka pathim han.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ka pakha thung hoiah loktang lok to na la pae ving hmah; na lokcaekhaih ah ni oephaih to ka suek.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na kaalok to dungzan hoi dungzan khoek to ka pazui han.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nang patuk ih loknawk to ka pakrong pongah, pakaahaih om ai ah ka caeh han.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nang paek ih loknawk to siangpahrangnawk hmaa ah ka thuih han, azathaih ka tongh mak ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kai loe ka palung ih, na lokpaekhaih ah kang hoe tih boeh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ka palung ih na lokpaekhaih bangah ban ka payangh tahang moe, nang patuk ih loknawk to ka poek han.
  </para>
  <para style="p">
    <verse number="49" style="v" />Na tamna khaeah paek ih lok to panoek poe ah, to lok hoiah ni oephaih to nang paek.
  </para>
  <para style="p">
    <verse number="50" style="v" />Patangkhang naah hae lok mah monghaih ang paek; na lok mah ni kai ang hingsak.
  </para>
  <para style="p">
    <verse number="51" style="v" />Amoek kaminawk mah kai ang pahnui o thuih; toe kai loe na kaalok hoiah kam khraeng ving ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Aw Angraeng, canghnii ih lokcaekhaihnawk to ka pakuem poe pongah, monghaih to ang paek.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kasae kaminawk hoi na kaalok pahnawt kaminawk pongah, palungphuihaih mah kai ang pazawk.
  </para>
  <para style="p">
    <verse number="54" style="v" />Nang patuk ih lok loe kholong ka caehhaih ahmuen kruekah kai ih laa ah oh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Aw Angraeng, khoving ah, na hmin to ka poek moe, na kaaloknawk to ka pazui.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nang paek ih loknawk ka pazuihaih loe ka sakzong ih hmuen ah oh boeh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Aw Angraeng, nang loe kai taham ah na oh; na loknawk to ka pazui han, tiah ka thuih boeh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Palungthin boih hoiah nang to kang pakrong boeh; na thuih ih lok baktih toengah na tahmen ah.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ka caehhaih loklamnawk ka poek naah, nang paek ih loknawk bangah khok ka takan boeh.
  </para>
  <para style="p">
    <verse number="60" style="v" />Nang paek ih loknawk loe akra ai, karangah ka pazui roep.
  </para>
  <para style="p">
    <verse number="61" style="v" />Kasae kaminawk mah kai ang tuk o; toe na kaalok to ka pahnet ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Katoengah lok na caek pongah, aqum ah kang thawk moe, nang khaeah kawnhaih lok ka thuih han.
  </para>
  <para style="p">
    <verse number="63" style="v" />Kai loe nang zithaih tawn kaminawk hoi nang paek ih loknawk pazui kaminawk boih ih, ampui ah ka oh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Aw Angraeng, long loe na tahmenhaih hoiah koi; na thuitaekhaih loknawk to na patuk ah.
  </para>
  <para style="p">
    <verse number="65" style="v" />Aw Angraeng, na lok baktih toengah, na tamna khaeah kahoih hmuen to na sah pae ah.
  </para>
  <para style="p">
    <verse number="66" style="v" />Nang paek ih loknawk to ka tang pongah, palunghahaih hoi kahoih lokcaekhaih to na paek ah.
  </para>
  <para style="p">
    <verse number="67" style="v" />Loklam kam khraeng ving pongah, nang thuitaek vai boeh; toe vaihi loe na lok to ka tahngai boeh.
  </para>
  <para style="p">
    <verse number="68" style="v" />Nang loe na hoih, na sak ih hmuen doeh hoih; nang paek ih thuitaekhaih loknawk to na patuk ah.
  </para>
  <para style="p">
    <verse number="69" style="v" />Amoek kaminawk mah amsawnlok hoiah kai ahmin ang set o sak; toe nang paek ih loknawk to palungthin boih hoiah ka pazui han.
  </para>
  <para style="p">
    <verse number="70" style="v" />Nihcae ih palung loe moithawk baktiah amkhawk; toe kai loe na kaalok ah anghoehaih ka tawnh.
  </para>
  <para style="p">
    <verse number="71" style="v" />Nang paek ih thuitaekhaih loknawk to kam tuk thai hanah, patangkhanghaih loe kai hanah hoih.
  </para>
  <para style="p">
    <verse number="72" style="v" />Na pakha pong ih kaalok loe kai hanah, sui hoi sumkanglung sangto pongah doeh hoih kue.
  </para>
  <para style="p">
    <verse number="73" style="v" />Na ban hoiah nang sak moe, krang ah nang coengsak; nang paek ih loknawk kam tuk thai hanah, panoekthaihaih to na paek ah.
  </para>
  <para style="p">
    <verse number="74" style="v" />Na lok ah oephaih ka suek pongah, nang zithaih tawn kaminawk mah ang hnuk o naah anghoe o tih.
  </para>
  <para style="p">
    <verse number="75" style="v" />Aw Angraeng, nang loe toenghaih hoiah lok na caek, na oepthohhaih hoiah ni kai patang nang khangsak, tito ka panoek.
  </para>
  <para style="p">
    <verse number="76" style="v" />Na tamna khaeah na suek ih lok baktih toengah, na palungnathaih mah monghaih na paek nasoe, tiah lawk ka thuih.
  </para>
  <para style="p">
    <verse number="77" style="v" />Ka hing thai hanah, na palungnathaih kai khaeah om nasoe; na kaalok loe kang hoehaih ah oh.
  </para>
  <para style="p">
    <verse number="78" style="v" />Amoek kaminawk loe takung tidoeh om ai ah ka nuiah sethaih sak o pongah, azat o nasoe; toe kai loe nang patuk ih loknawk to ka pakuem han.
  </para>
  <para style="p">
    <verse number="79" style="v" />Nang zithaih tawn kami hoi na thuih ih loknawk panoek kaminawk loe, nang khaeah amlaem o let nasoe.
  </para>
  <para style="p">
    <verse number="80" style="v" />Azat ka tong han ai ah, nang thuitaekhaih loknawk pongah ka palung hae coek koi om ai ah om nasoe.
  </para>
  <para style="p">
    <verse number="81" style="v" />Na pahlonghaih to ka koeh loiah, ka pakhra thazok sut boeh; toe kai loe na lok ah ni oephaih to ka suek.
  </para>
  <para style="p">
    <verse number="82" style="v" />Ka miknawk mah na lok to danh, toe hnu ai; natuek naah maw kai nang mongsak tih? tiah ka thuih.
  </para>
  <para style="p">
    <verse number="83" style="v" />Kai loe kazaek moihin pailang baktiah ni ka oh sut boeh, toe nang thuitaekhaih loknawk to ka pahnet ai.
  </para>
  <para style="p">
    <verse number="84" style="v" />Na tamna ih ni loe nasetto maw akra vop tih? Kai pacaekthlaek kaminawk to natuek naah maw lok na caek han?
  </para>
  <para style="p">
    <verse number="85" style="v" />Na kaalok baktih na ai ah, amoek kaminawk mah kai hanah tangqom ang takaeh pae o.
  </para>
  <para style="p">
    <verse number="86" style="v" />Nang paek ih loknawk boih loe oepthoh; tidoeh na ai ah nihcae mah kai ang pacaekthlaek o; na bom ah.
  </para>
  <para style="p">
    <verse number="87" style="v" />Long nuiah nihcae mah kai ang tamit o tom boeh, toe na paek ih loknawk to ka pahnawt sut ai.
  </para>
  <para style="p">
    <verse number="88" style="v" />Nam lunghaih hoiah ka hinghaih hae pathawk ah, to tiah ni pakha hoi na thuih ih loknawk to ka pakuem thai tih.
  </para>
  <para style="p">
    <verse number="89" style="v" />Aw Angraeng, na lok loe van ah, dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="90" style="v" />Na oepthohhaih loe angzo han koi caanawk dung khoek to cak; long loe na caksak ih baktih toengah, oh poe.
  </para>
  <para style="p">
    <verse number="91" style="v" />Na sakzong ih atawk loe vaihni khoek to cak, to sak ih hmuennawk loe na tamna ah ni oh o boih.
  </para>
  <para style="p">
    <verse number="92" style="v" />Na kaalok to kang hoehaih ah om ai nahaeloe, patangkhanghaih hoiah kang hmaa tih boeh.
  </para>
  <para style="p">
    <verse number="93" style="v" />Nang patuk ih loknawk to natuek naah doeh ka pahnet mak ai; to loknawk hoiah ni nang hingsak.
  </para>
  <para style="p">
    <verse number="94" style="v" />Na pahlong ah, nang ih hmuen ah ni ka oh; kai loe nang patuk ih loknawk to ni ka pakrong.
  </para>
  <para style="p">
    <verse number="95" style="v" />Kasae kaminawk loe kai hum hanah zing o; toe kai loe na thuih ih loknawk ni ka poek han.
  </para>
  <para style="p">
    <verse number="96" style="v" />Kacung bit baktiah kamtueng hmuennawk boih loe boenghaih oh, tiah ka hnuk; toe nang paek ih loknawk loe paroeai kawk.
  </para>
  <para style="p">
    <verse number="97" style="v" />Aw na lok hae kawkruk maw ka palung! Athun qui ka poek.
  </para>
  <para style="p">
    <verse number="98" style="v" />Ka misanawk pongah nang paek ih loknawk mah palung ang hasak kue; to loknawk loe ka taengah oh o poe.
  </para>
  <para style="p">
    <verse number="99" style="v" />Na thuih ih loknawk to ka poek pongah, kai patuk kaminawk boih pongah panoekhaih ka tawnh kue.
  </para>
  <para style="p">
    <verse number="100" style="v" />Nang patuk ih loknawk to ka pazui pongah, canghnii ih kaminawk pongah doeh panoekhaih ka tawnh kue.
  </para>
  <para style="p">
    <verse number="101" style="v" />Na lok tahngaih thai hanah, kasae loklamnawk thungah khok ka takan ai.
  </para>
  <para style="p">
    <verse number="102" style="v" />Nang patuk boeh pongah, na lokcaekhaih thung hoiah kam khraeng ai.
  </para>
  <para style="p">
    <verse number="103" style="v" />Ka pataeng naah na loknawk loe kawkruk maw luep! ue, ka pakha ah loe khoitui pongah doeh luep kue!
  </para>
  <para style="p">
    <verse number="104" style="v" />Nang patuk ih loknawk rang hoiah palunghahaih to ka hnuk; to pongah katoeng ai loklamnawk boih to ka hnukma.
  </para>
  <para style="p">
    <verse number="105" style="v" />Na lok loe ka khok hanah hmaithaw ah oh moe, ka caehhaih loklam hanah aanghaih ah oh.
  </para>
  <para style="p">
    <verse number="106" style="v" />Katoeng na lokcaekhaih pazui han, tiah lokkamhaih to ka caksak han.
  </para>
  <para style="p">
    <verse number="107" style="v" />Paroeai patang ka khang; Aw Angraeng, na lok baktih toengah, na pathawk ah.
  </para>
  <para style="p">
    <verse number="108" style="v" />Aw Angraeng, ka pakha mah koehhaih baktiah paek ih hmuen to nang talawk pae hanah, kang hnik; na lokcaekhaihnawk to na patuk ah.
  </para>
  <para style="p">
    <verse number="109" style="v" />Ka hinghaih loe ka ban ah ni oh poe; toe na kaalok to ka pahnet ai.
  </para>
  <para style="p">
    <verse number="110" style="v" />Kasae kaminawk mah kai hanah thaang ang patung pae o; toe kai loe nang paek ih loknawk hoi kam khraeng ving ai.
  </para>
  <para style="p">
    <verse number="111" style="v" />Na thuih ih loknawk loe kai hanah dungzan qawk ah oh moe, ka palung anghoehaih ah oh.
  </para>
  <para style="p">
    <verse number="112" style="v" />Nang thuitaekhaih loknawk boeng khoek to pazui poe hanah, ka palungthin hae ka paongh.
  </para>
  <para style="p">
    <verse number="113" style="v" />Poek angphae kaminawk to ka hnukma; toe na kaalok loe ka palung.
  </para>
  <para style="p">
    <verse number="114" style="v" />Nang loe ka buephaih hoi kai pakaahaih ah na oh; na lok ah oephaih ka tawnh.
  </para>
  <para style="p">
    <verse number="115" style="v" />Nangcae kahoih ai hmuen sah kaminawk, kai khae hoi tacawt oh; ka Sithaw mah paek ih loknawk to ka pazui han.
  </para>
  <para style="p">
    <verse number="116" style="v" />Ka hing thai hanah, na lok baktih toengah na patawn ah; oephaih ka tawnh pongah na zatsak hmah.
  </para>
  <para style="p">
    <verse number="117" style="v" />Ka loih hanah, na patawn ah; nang thuitaekhaih loknawk to ka pazui poe han.
  </para>
  <para style="p">
    <verse number="118" style="v" />Na thuitaekhaih loknawk hoi amkhraeng kaminawk boih to na pahnawt; nihcae loe aling hanah lok amlai o.
  </para>
  <para style="p">
    <verse number="119" style="v" />Kami zae, long kaminawk boih to sum aek baktiah na takhoe baat pongah, na thuih ih loknawk to ka palung.
  </para>
  <para style="p">
    <verse number="120" style="v" />Nang kang zit loiah ka tasoeh; na lokcaekhaihnawk to ka zit.
  </para>
  <para style="p">
    <verse number="121" style="v" />Kai loe kamsoem lokcaekhaih hoi toenghaih to ka sak boeh; kai hnaphnae kaminawk khaeah na caeh taak hmah.
  </para>
  <para style="p">
    <verse number="122" style="v" />Na tamna kai ka hoih thai hanah na caksak ah; amoek kaminawk mah na pacaekthalek o hmah nasoe.
  </para>
  <para style="p">
    <verse number="123" style="v" />Na pahlonghaih hoi na toenghaih loknawk to, mik hoiah ka khet.
  </para>
  <para style="p">
    <verse number="124" style="v" />Na palungnathaih baktih toengah, na tamna khaeah sah rae ah loe, nang thuitaekhaih loknawk to na patuk ah.
  </para>
  <para style="p">
    <verse number="125" style="v" />Kai loe na tamna ah ni ka oh; na thuih ih loknawk ka panoek thai hanah, thaikophaih to na paek ah.
  </para>
  <para style="p">
    <verse number="126" style="v" />Aw Angraeng, vaihi loe na toksakhaih atue ah ni oh boeh; nihcae loe na kaalok to phraek o boeh.
  </para>
  <para style="p">
    <verse number="127" style="v" />Sui pongah doeh, ue, atui kaciim sui pongah doeh, nang paek ih loknawk to ka palung kue.
  </para>
  <para style="p">
    <verse number="128" style="v" />To pongah nang paek ih loknawk boih loe toeng tiah ka poek; katoeng ai loklamnawk boih loe ka hnukma.
  </para>
  <para style="p">
    <verse number="129" style="v" />Na thuih ih loknawk loe dawnrai han oh; to pongah ka pakhra mah pazui.
  </para>
  <para style="p">
    <verse number="130" style="v" />Amtuengsak ih na loknawk mah aanghaih to ang paek moe, panoek ai kaminawk hanah panoekthaihaih to a paek.
  </para>
  <para style="p">
    <verse number="131" style="v" />Na paek ih loknawk to ka poek loiah, angpho hoiah pakha ka aang sut boeh.
  </para>
  <para style="p">
    <verse number="132" style="v" />Na hmin palung kaminawk khaeah na sak ih baktih toengah, palungnathaih hoiah na khen ah.
  </para>
  <para style="p">
    <verse number="133" style="v" />Na lok hoiah ka khok tangkannawk hae toengsak ah; zaehaih mah na uk hmah nasoe.
  </para>
  <para style="p">
    <verse number="134" style="v" />Nang patuk ih loknawk to ka pazui thai hanah, pacaekthlaekhaih thung hoiah na loisak ah.
  </para>
  <para style="p">
    <verse number="135" style="v" />Na tamna nuiah na mikhmai to pansak ah loe, nang thuitaekhaih loknawk to na patuk ah.
  </para>
  <para style="p">
    <verse number="136" style="v" />Kaminawk mah na kaalok to pazui o ai pongah, ka mik hoiah mikkhraetui vapuituinawk baktiah longh.
  </para>
  <para style="p">
    <verse number="137" style="v" />Aw Angraeng, nang loe na toeng, na lokcaekhaihnawk doeh toeng.
  </para>
  <para style="p">
    <verse number="138" style="v" />Na thuih ih loknawk loe toeng moe, oepthoh.
  </para>
  <para style="p">
    <verse number="139" style="v" />Ka misanawk mah na thuih ih loknawk pahnet o ving boeh pongah, poekhaih tha ang zok o sak sut boeh.
  </para>
  <para style="p">
    <verse number="140" style="v" />Na lok loe ciim parai; to pongah na tamna mah palung.
  </para>
  <para style="p">
    <verse number="141" style="v" />Kai loe takpum thoengkae moe, hnap han koi kami ah ka oh; toe nang paek ih loknawk to ka pahnet ai.
  </para>
  <para style="p">
    <verse number="142" style="v" />Na toenghaih loe dungzan khoek to oh, na lok loe loktang ah oh.
  </para>
  <para style="p">
    <verse number="143" style="v" />Raihaih hoi patanghaih mah kai ang khuk khoep boeh; toe nang paek ih loknawk loe kang hoehaih ah oh.
  </para>
  <para style="p">
    <verse number="144" style="v" />Na thuih ih katoeng loknawk loe dungzan khoek to cak; ka hinghaih hanah, panoekthaihaih to na paek ah.
  </para>
  <para style="p">
    <verse number="145" style="v" />Palungthin boih hoiah ka hangh, Aw Angraeng, na tahngai pae ah! Nang thuitaekhaih loknawk to ka pazui han.
  </para>
  <para style="p">
    <verse number="146" style="v" />Nang khaeah kang hang; na thuih ih loknawk pazui thai hanah, na pahlong ah.
  </para>
  <para style="p">
    <verse number="147" style="v" />Akhawnbang khawnthaw ah nang khaeah kang hangh; na lok ah oephaih ka tawnh.
  </para>
  <para style="p">
    <verse number="148" style="v" />Na lok ka poek hanah, qum taning ah kang lawt.
  </para>
  <para style="p">
    <verse number="149" style="v" />Nam lunghaih baktih toengah ka hanghaih lok hae na tahngai pae ah; Aw Angraeng, na lokcaekhaih baktih toengah, na pathawk ah.
  </para>
  <para style="p">
    <verse number="150" style="v" />Kasae poekhaih pazui kaminawk loe kasae sak hanah kai khaeah anghnaih o aep; toe nihcae loe na kaalok hoiah angthla o.
  </para>
  <para style="p">
    <verse number="151" style="v" />Aw Angraeng, nang loe na zoi, nang paek ih loknawk boih loe loktang lok ah oh.
  </para>
  <para style="p">
    <verse number="152" style="v" />Na thuih ih loknawk loe dungzan khoek to na caksak boeh, tito canghnii hoi ni ka panoek boeh.
  </para>
  <para style="p">
    <verse number="153" style="v" />Na kaalok to ka pahnet ai pongah, patang ka khanghaih hae na poek pae ah loe, na pahlong ah.
  </para>
  <para style="p">
    <verse number="154" style="v" />Kai hae angsak haih ah loe, na krang ah; na lok baktih toengah na hingsak ah.
  </para>
  <para style="p">
    <verse number="155" style="v" />Kasae kaminawk loe na thuitaekhaih loknawk to pakrong o ai pongah, pahlonghaih hoiah angthla o.
  </para>
  <para style="p">
    <verse number="156" style="v" />Aw Angraeng, na palungnathaih loe len parai; na lokcaekhaihnawk baktih toengah kai hae na hingsak ah.
  </para>
  <para style="p">
    <verse number="157" style="v" />Kai pacaekthlaek kami hoi ka misanawk loe pop o parai; toe kai loe na thuih ih loknawk hoiah kam khraeng ai.
  </para>
  <para style="p">
    <verse number="158" style="v" />Nihcae loe na lok pazui o ai pongah, oep om ai kaminawk to ka khet naah ka panuet.
  </para>
  <para style="p">
    <verse number="159" style="v" />Nang patuk ih loknawk kawkruk maw ka palung, tito panoek ah; Aw Angraeng, nam lunghaih ah na hingsak ah.
  </para>
  <para style="p">
    <verse number="160" style="v" />Na lok loe tangsuek na hoi boeh ni loktang ah oh; katoeng lok na caekhaihnawk boih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="161" style="v" />Takung om ai ah angraegnawk mah kai ang pacaekthlaek o; toe ka palungthin mah loe na lok to zit.
  </para>
  <para style="p">
    <verse number="162" style="v" />Pop parai hmuenmae hnu kami baktih toengah, kai loe na lok pongah ni anghoehaih ka tawnh.
  </para>
  <para style="p">
    <verse number="163" style="v" />Kai loe amsawnlok to ka hnukma moe, ka panuet, toe na kaalok loe ka palung.
  </para>
  <para style="p">
    <verse number="164" style="v" />Na caek ih katoeng lok pongah, nito naah vai sarihto nang kang pakoeh.
  </para>
  <para style="p">
    <verse number="165" style="v" />Na kaalok palung kaminawk loe kalen parai monghaih to tawnh o; nihcae to tih mah doeh pakha mak ai.
  </para>
  <para style="p">
    <verse number="166" style="v" />Aw Angraeng, na pahlonghaih to ka zing moe, nang paek ih loknawk to ka pazui boeh.
  </para>
  <para style="p">
    <verse number="167" style="v" />Na thuih ih loknawk to palungthin boih, ka hinghaih boih mah pazui boeh.
  </para>
  <para style="p">
    <verse number="168" style="v" />Nang patuk ih loknawk hoi na thuih ih loknawk to ka pazui boeh; ka loklamnawk boih loe na hmaa ah oh.
  </para>
  <para style="p">
    <verse number="169" style="v" />Aw Angraeng, ka hanghaih lok hae na hmaa ah pha nasoe; na lok baktih toengah panoekhaih na paek ah.
  </para>
  <para style="p">
    <verse number="170" style="v" />Tahmen kang hnikhaih lok hae na hmaa ah pha nasoe; na thuih ih lok baktih toengah na loisak ah.
  </para>
  <para style="p">
    <verse number="171" style="v" />Nang thuitaekhaih loknawk to nang patuk naah, ka pahni mah pakoehhaih lok to thui tih.
  </para>
  <para style="p">
    <verse number="172" style="v" />Nang paek ih loknawk boih loe toeng pongah, ka palai mah na lok to laa ah sah tih.
  </para>
  <para style="p">
    <verse number="173" style="v" />Nang patuk ih loknawk to ka qoih boeh pongah, na ban mah kai na bomh nasoe.
  </para>
  <para style="p">
    <verse number="174" style="v" />Aw Angraeng, na pahlonghaih hnuk han ka koeh phi boeh; na kaalok loe kang hoehaih ah oh.
  </para>
  <para style="p">
    <verse number="175" style="v" />Nang kang pakoeh thai hanah, ka pakhra hae na pathawk ah; na lokcaekhaihnawk mah na bomh nasoe.
  </para>
  <para style="p">
    <verse number="176" style="v" />Kai loe tuu kanghmaa baktiah loklam kang hmang sut boeh; na tamna to pakrong ah; nang paek ih loknawk to ka pahnet ai.
  </para>
  <chapter number="120" style="c" />
  <para style="p">
    <verse number="1" style="v" />Patang ka khang naah Angraeng to ka kawk, ka kawkhaih lok to anih mah ang pathim.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Angraeng, amsawnlok thuihaih pahninawk hoi alinghaih palainawk thung hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw aling thaih palai nang, kawbaktih danpaekhaih maw nang paek han? To tih ai boeh loe na nuiah timaw ka sak han?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang loe thacak kami ih kasum palaa hoi hmai kamngaeh thing hoiah thuitaek han oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kedar ih kahni im ah ka oh moe, Meshek ah ka oh pongah, kai han khosak bingh!
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka hinghaih hnuma moe, angdaehhaih hnuma kami hoi nawnto ohhaih atue sawk parai boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai loe angdaehhaih koeh kami ah ka oh; toe lok ka thuih naah, nihcae loe misa angcoenghaih to koeh o lat.
  </para>
  <chapter number="121" style="c" />
  <para style="p">
    <verse number="1" style="v" />Naa bang hoiah maw kai bomkung angzo tih? tiah poek hoiah mae bangah ka dan tahang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai bomkung loe long hoi van sahkung, Angraeng khae hoiah ni ang zoh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah loe na khok to amthaeksak mak ai, nang toepkung loe iih angam mak ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khenah, Israel toepkung loe iih angam mak ai, iip doeh iip mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng loe nang toepkung ah oh; Angraeng loe na bantang bangah nang han tahlip paekkung ah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Athun ah ni mah na kangh mak ai, aqum ah doeh khrah mah raihaih na paek mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng mah kahoih ai hmuen congca thung hoiah na pakaa ueloe, na hinghaih to toep tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng mah na caehhaih hoi nang zohhaih to vaihi hoi dungzan khoek to toep tih.
  </para>
  <chapter number="122" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng im ah caeh o si, tiah ang thuih o naah, anghoehaih ka tawnh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Jerusalem, kaicae ih khoknawk loe na khongkha thungah angdoet boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem, nang loe kacakah sak ih, kranghoih vangpui ah na oh!
  </para>
  <para style="p">
    <verse number="4" style="v" />Acaeng kaminawk loe caeh o tahang moe, Israelnawk mah thuih ih baktih toengah, Angraeng ih acaengnawk loe Angraeng ih ahmin pakoeh hanah caeh o tahang.
  </para>
  <para style="p">
    <verse number="5" style="v" />To ah lokcaekhaih angraeng tangkhangnawk hoi David im ih angraeng tangkhangnawk to oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jerusalem monghaih tawnh hanah lawkthui oh; nang palung kaminawk loe khosak hoih o nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na sipae thungah monghaih to om nasoe loe, na angraenghaih imthung ah khosak hoihaih om nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kam nawkamya hoi ampuinawk pongah, na thungah monghaih om nasoe, tiah ka thuih han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aicae Angraeng Sithaw ih im pongah, na hoihaih to ka pakrong han.
  </para>
  <chapter number="123" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vannawk ah kaom, nang khaeah ka mik padai tahang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tamnanawk mah angmacae angraeng ih ban to khet o moe, tamna nongpatanawk mah angmacae angraeng nongpata ih ban to khet o baktih toengah, a palungnathaih aicae khaeah amtuengsak ai karoek to, aicae loe aimacae Angraeng Sithaw to a khet o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaicae nuiah palungnathaih tawn ah, Aw Angraeng, kaicae nuiah palungnathaih tawn ah; kaicae loe minawk mah hnaphnae ih kami ah ka oh o boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaicae ih pakhra loe, amoek kaminawk mah pahnuithuihaih hoi poeksang kaminawk hnaphnaehaih hoiah koi hmoek boeh.
  </para>
  <chapter number="124" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aicae bangah Angraeng om ai nahaeloe, Israelnawk mah hae tiah thui o nasoe;
  </para>
  <para style="p">
    <verse number="2" style="v" />aicae bangah Angraeng om ai nahaeloe, kaminawk loe aicae ih misa ah om o tih,
  </para>
  <para style="p">
    <verse number="3" style="v" />nihcae mah aicae han palung ang phui o thuih naah, aicae to kahing ah na paaeh o tih boeh;
  </para>
  <para style="p">
    <verse number="4" style="v" />kalen tui mah aicae khuk khoep ueloe, aicae pakhra nuiah tui to long tih boeh;
  </para>
  <para style="p">
    <verse number="5" style="v" />kamoek tuinawk loe aicae pakhra nuiah long o tih boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae mah aicae haa hoi kaek hanah paek ai, Angraeng loe tahamhoihaih om nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aicae ih pakhra loe dongh patung kami ih dongh thung hoi kaloih tavaa baktiah loih o; dongh qui to apet dok moe, aicae loe a loih o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aicae abomhaih loe van hoi long sahkung, Angraeng ih ahmin ah ni oh.
  </para>
  <chapter number="125" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng oep kaminawk loe anghuen ai, dungzan kacak, Zion mae baktiah om o tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Maenawk mah Jerusalem to takui khoep baktih toengah, Angraeng mah angmah ih kaminawk to vaihi hoi dungzan khoek to takui khoep.
  </para>
  <para style="p">
    <verse number="3" style="v" />Katoeng kaminawk ih prae thungah kasae kaminawk ih cunghet to om mak ai, to tih ai nahaeloe katoeng kaminawk loe a ban to kahoih ai hmuen sak hanah patoh o moeng tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, kahoih kaminawk hoi poektoeng kaminawk khaeah, kahoih hmuen to sah ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Loklam kang koiah amkhraeng kaminawk loe, Angraeng mah kahoih ai hmuen sah kaminawk hoi nawnto caeh haih hmaek tih; toe Israel nuiah loe monghaih to om nasoe.
  </para>
  <chapter number="126" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Zion kaminawk hoih let naah, kaicae loe amang baktiah ni ka oh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaicae ih pakhanawk loe pahnuihaih hoiah koi moe, palainawk doeh anghoe laasakhaih hoiah koi o; to naah Sithaw panoek ai kaminawk mah, Angaeng mah nihcae hanah kalen parai hmuen sak pae boeh, tiah thuih o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng mah aicae hanah kalen parai hmuennawk to sak boeh, to pongah aicae loe anghoehaih hoiah koi o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, misong ah naeh ih kaicae hae, aloih bang ih vacongnawk baktiah, amlaemsak let ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mikkhraetui hoi tuh kaminawk loe, anghoehaih hoiah aat o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Qahhaih hoi atho kaom, cangtii tuk hanah caeh kaminawk loe, cangqui to sin o ueloe, anghoehaih hoiah amlaem o let tih.
  </para>
  <chapter number="127" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah im sah ai nahaeloe, imsahkungnawk loe azom pui ah ni toksak o; Angraeng mah vangpui to toep ai nahaeloe, toepkungnawk loe azom pui ah ni toep o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angsatui hoi buhcaak hanah, khawnthaw ah nang thawk, khoving khoek to anghnut moe, toksakhaih loe azom pui ah ni oh; a palung ih kami khaeah kahnaep ah iihhaih to paek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khenah, caa nawktanawk loe Angraeng ih qawk ah oh o moe, zok ih thingthai loe anih mah paek ih tangqum ah ni oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tha oh li naah sak ih caanawk loe, thacak kami ih ban ah kaom palaanawk baktiah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palaa hoi kakoi kalii tabu tawn kami loe tahamhoih; nihcae loe azathaih tongh o mak ai, khongkha ah misanawk to pakaa o thai tih.
  </para>
  <chapter number="128" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to zit moe, anih ih loklam pazui kaminawk boih loe tahamhoih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na toksakhaih athaih to na caa tih; anghoehaih hoi khosakhoihaih doeh na tawn tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na zu loe na imtaeng ih kathai parai misurkung baktiah om ueloe, na caanawk loe na caboi taengah kaom olive tadoknawk baktiah om o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khenah, Angraeng zii kami loe to tiah om tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah Zion hoiah tahamhoihaih na paek ueloe, na hing thungah Jerusalem tahamhoihaih to na hnu tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ue, na caanawk ih caa patoeng doeh na hnu tih, Israel nuiah monghaih om nasoe.
  </para>
  <chapter number="129" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka nawkta nathuem hoi boeh ni nihcae mah kai ang pacaekthlaek o, Israel mah vaihi,
  </para>
  <para style="p">
    <verse number="2" style="v" />ka nawkta nathuem hoi boeh ni nihcae mah kai ang pacaekthlaek o boeh; toe nihcae mah na pazawk o vai ai, tiah thuih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Laikok atok kaminawk mah long atok naah kaom ahmaa baktiah ka kaengah ahmaa kathuk to oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe Angraeng loe toeng; poeksae kaminawk ih qui to anih mah aah pae pat.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zion hnuma kaminawk boih azathaih hoiah amlaem o let nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Qoeng tahang ai ah kazaem, imphu nui ih phroh baktiah om o nasoe;
  </para>
  <para style="p">
    <verse number="7" style="v" />to phroh aatkung loe ban tamsum maeto mataeng doeh hak ai, cang taoeng kami aput han kakhawt ah doeh hak thai ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />To ahmuen ah caeh kaminawk loe, Angraeng tahamhoihaih na nuiah om nasoe; Angraeng ih ahmin hoiah tahamhoihaih kang paek, tiah thui o mak ai.
  </para>
  <chapter number="130" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, kathuk ahmuen hoiah nang khaeah ka hangh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Angraeng, ka lok hae tahngai ah; tahmen kang hnikhaih lok bangah na naa to patueng ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng, nang, zaehaihnawk to na pakuem soe nahaeloe, Aw Angraeng angdoe thai koi mi maw om tih?
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe nang to zit thai hanah, kaicae hae nang tahmen boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai loe Angraeng ni ka zing, ka hinghaih mah anih to zing, a lok ah oephaih to ka suek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khodai zing kaminawk, khodai zing kaminawk pong kamthlai ah, ka hinghaih mah Angraeng to zing.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng ah palungnathaih hoi pop parai pahlonghaih oh pongah, Israel mah a oephaih to Angraeng ah suem nasoe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah Israel to zaehaihnawk boih thung hoiah akrang tih.
  </para>
  <chapter number="131" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, ka palungthin loe amoek ai, ka miknawk doeh sang ai; kaimah hoi amcuk ai kalen parai hmuennawk, to tih ai boeh loe kasang parai hmuennawk ah athumhaih ka tawn ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tangtang ni kai loe amno khae hoi tahnutui amphi nawkta baktiah, ka poekhaih hae mong moe, ka oh duem; ka poekhaih loe tahnutui amphi nawkta baktiah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Israel, vaihi hoi dungzan khoek to na oephaih to Angraeng khaeah suem ah.
  </para>
  <chapter number="132" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, David hoi anih patangkhanghaih to panoek ah;
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng hanah ahmuen ka hnu ai moe, thacak Jakob ih Sithaw hanah ahmuen ka hak ai khoek to, ka mik hae ka iipsak mak ai, ka mikhin doeh ka ngamsak mak ai, tangtang ni kaimah ih kahni imthung ah ka kun mak ai ueloe, ka iihhaih ahmuen ah doeh ka caeh mak ai, tiah anih mah Angraeng khaeah lokkamhaih to sak moe, thacak Jakob Sithaw khaeah lokkamhaih to a sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khenah, to kahni im loe Ephratah ah oh, tiah a thaih o moe, kathah thing thungah a hnuk o boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angmah ih kahni imthung ah caeh o si loe, a khokkung ah anih to bok o si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, nangmah hoi na thacakhaih thingkhong hoi nawnto, angthawk ah loe, nang hakhaih ahmuen ah, angzo ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na qaimanawk loe toenghaih hoiah amthoep o nasoe loe, nangmah ih kaciim kaminawk mah anghoehaih laa to sah o nasoe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na tamna David pongah, situi na bawh ih kami to pahnawt hmah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng loe David khaeah loktang lokkamhaih to sak; lokkamhaih to hnuk amlaem taak mak ai; na takpum ih thingthai ah kaom kami to na angraeng tangkhang nuiah kang hnutsak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na caanawk mah ka lokkamhaih hoi nihcae hanah ka patuk ih ka loknawk to pazui o nahaeloe, nihcae ih caanawk doeh na angraeng tangkhang nuiah dungzan khoek to anghnu o toeng tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng mah Zion to qoih boeh; anih loe to ah ohhaih ahmuen sak hanah koehhaih tawnh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae loe dungzan ah kang hakhaih ahmuen ah oh; ka koeh pongah, hae ah ka oh han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih to pop parai caaknaek hoiah tahamhoihaih ka paek moe, amtang angmah ih kaminawk to zok kam hahsak han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angmah ih qaimanawk doeh pahlonghaih hoiah ka khuk han, kaciim angmah ih kaminawk loe anghoehaih laa to sah o tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />To ah David to taki ka cawnhsak moe, situi ka bawh ih kami hanah hmaithaw to ka sak pae boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih ih misanawk to azathaih hoiah ka khuk pae han; toe anih lu nui ih sui lumuek loe ampha tih.
  </para>
  <chapter number="133" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khenah, poek amhonghaih hoiah nawkamyanawk nawnto oh hae kawkruk maw hoih moe, koeh han koi oh!
  </para>
  <para style="p">
    <verse number="2" style="v" />Lu nuiah bawh moe, Aaron ih toektaboe mui ah kalong, toektaboe hoi kahni tom khoek to long tathuk, atho kana situi baktiah oh;
  </para>
  <para style="p">
    <verse number="3" style="v" />Hermon mae ih dantui baktih, Zion maen nuiah kalong tathuk dantui baktiah oh; to ahmuen ah Angraeng mah tahamhoihaih, dungzan hinghaih to paek.
  </para>
  <chapter number="134" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khenah, aqum ah Angraeng im katoep, Angraeng ih tamnanawk boih, Angraeng to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmuenciim ah ban payangh oh loe, Angraeng to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Van hoi long sahkung Angraeng mah Zion mae hoiah nang tahamhoihaih ang paek.
  </para>
  <chapter number="135" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe saphaw oh. Angraeng ih ahmin to saphaw oh; nangcae Angraeng ih tamnanawk, anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangcae Angraeng imthung ah angdoe kaminawk, aicae Sithaw im longhma ah angdoe kaminawk, Angraeng to saphaw oh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng loe hoih pongah, Angraeng to saphaw oh; anih ih ahmin saphawhaih laa to sah oh, to loe anghoe han koi hmuen ah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah Jakob to angmah hanah qoih, Israel to angmah ih hmuen ah suek hanah a qoih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng loe len, aicae Sithaw loe sithawnawk boih pongah doeh len, tiah ka panoek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Van hoi long, tuipuinawk hoi kathuk ahmuennawk boih ah, Angraeng mah a koeh baktiah hmuennawk to a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah long boenghaih ahmuen hoiah tamai amzamsak moe, tangphrapuekhaih hoi khotui to a sak; anih mah hmuen patuhaih ahmuen hoiah takhi to tacawtsak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah Izip prae ih tapen tangsuek kami hoi moinawk to hum pae boih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Izip, nang thungah kaom Faro hoi anih ih tamnanawk boih nuiah, tanoekhaih hoi dawnrai hmuennawk to na patoh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pop parai prae kaminawk to na dueksak moe, thacak siangpahrangnawk to na hum;
  </para>
  <para style="p">
    <verse number="11" style="v" />Amor kaminawk ih siangpahrang Sihon, Bashan siangpahrang Og hoi siangpahrang mah uk ih Kanaan praenawk boih;
  </para>
  <para style="p">
    <verse number="12" style="v" />nihcae ih prae to angmah ih kami Israelnawk hanah qawk ah a paek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Angraeng, na hmin loe dungzan khoek to cak; Aw Angraeng, na panoekhaih doeh, adung boih khoek to om tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng mah angmah ih kaminawk to lokcaek ueloe, a tamnanawk nuiah dawnpakhuemhaih tawn tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sithaw panoek ai kaminawk mah bok o ih krangnawk loe, sui, kami ban hoi sakcop ih sui hoi sumkanglung rumram ah ni oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae loe pakha tawnh o, toe lok apae o thai ai; mik a tawnh o, toe hnu o thai ai;
  </para>
  <para style="p">
    <verse number="17" style="v" />naa a tawnh o, toe thaih o thai ai; pakha thungah anghahhaih takhi om ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Krang sah kaminawk loe krang baktiah ni oh o, krang oephaih tawn kaminawk doeh krang hoiah ni anghmong o boih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Israel imthung takoh, Angraeng to tahamhoihaih paek oh; Aw Aaron imthung takoh, Angraeng to tahamhoihaih paek oh;
  </para>
  <para style="p">
    <verse number="20" style="v" />Aw Levi imthung takoh, Angraeng to tahamhoihaih paek oh; Angraeng zii kaminawk, Angraeng to tahamhoihaih paek oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jerusalem vangpui ah kaom Angraeng loe Zion hoiah tahamhoihaih om nasoe. Angraeng to saphaw oh.
  </para>
  <chapter number="136" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng loe hoih pongah, angmah khaeah kawnhaih lok to thui oh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="2" style="v" />sithawnawk ih Sithaw khaeah kawnhaih lok to thui oh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="3" style="v" />angraengnawk ih Angraeng khaeah anghoehaih lok to thui oh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah ni kalen dawnrai hmuen to sak; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="5" style="v" />A palunghahaih hoiah vannawk to sak; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah ni long hae tuinawk nuiah payuengh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah ni kalen parai aanghaih to sak; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khodai uk hanah ni to a sak; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="9" style="v" />khoving uk hanah khrah hoi cakaehnawk to a sak; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah ni tapen tangsuek Izip kaminawk ih calu to hum pae noih; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="11" style="v" />nihcae salak hoiah Israel kaminawk to a hoih; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loe thacakhaih hoiah ban to payangh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah ni tuipui kathim to tapraek; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="14" style="v" />kampraek tuipui salakah Israel caanawk to a caehsak; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="15" style="v" />toe Faro hoi angmah ih misatuh kaminawk loe tuipui kathim mah ayaw hmoek; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih mah ni angmah ih kaminawk to praezaek hoiah zaeh; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah ni kalen siangpahrangnawk to hum; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah ni ahmin kamthang siangpahrangnawk to hum; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih mah ni Amor kaminawk ih siangpahrang Sihon to hum; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih mah ni Bashan siangpahrang Og to hum; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="21" style="v" />nihcae ih prae to anih mah qawk ah paek; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih mah ni tamna Israel caanawk hanah qawk to paek; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aicae poek pahnaemhaih to anih mah ang panoek pae; a palungnathaih loe dungzan khoek to cak;
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih mah ni aicae hae misanawk ban thung hoiah loisak; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kami boih caaknaek paekkung loe Anih ni; a palungnathaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="26" style="v" />A palungnathaih loe dungzan khoek to cak pongah, van Sithaw khaeah kawnhaih lok thui oh.
  </para>
  <chapter number="137" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babylon vapui taengah, kang hnut o, ue, Zion to ka poek o naah, ka qah o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Katoengnawk doeh tui taeng ih thing tanghang nuiah ka bang o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To ah kaom kaicae misong ah naeh kaminawk mah laasak hanah ang pacae o; kaicae pacaekthlaek kaminawk mah anghoehaih laasak hanah ang pacae o; Zion laa maeto sah o noek khae, tiah ang naa o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kawbangmaw Angraeng ih laa to minawk prae ah ka sah o thai tih?
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Jerusalem, nang to kang pahnet o ving nahaeloe, ka bantang ban mah a sakthaihaih to pahnet roep nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang to kang panoek o ai boeh moe, kang hoe o haih koek Jerusalem to ka pakoeh o ai boeh nahaeloe, ka palai hae pakha ranuiah angbet caeng nasoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, Jerusalem amtimh na niah, im hmuen to phrae oh, phrae oh, tiah kathui Edom kaminawk to poek ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amrosak thaih, Aw Babylon canu, kaicae nuiah na sak ih hmuen baktih toengah, na nuiah sah pathok kami loe tahamhoih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na caa nawktanawk to lak moe, thlung nuiah va kami loe tahamhoih.
  </para>
  <chapter number="138" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, palungthin boih hoiah nang to kang pakoeh han; sithawnawk hmaa ah nang pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaciim na tempul bang khet hoiah nang to kang bok moe, nam lunghaih hoi na oepthohhaih pongah na hmin to ka pakoeh han; nangmah ih ahmin rang hoiah na lok to hmuennawk boih pong kasang kue ah nam tuengsak boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kang kawkhaih niah kai han nang pathim moe, palung thungah tha nang ohsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, long nui ih siangpahrangnawk boih mah na thuih ih lok to thaih o naah, nang to saphaw o tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ue, Angraeng lensawkhaih loe len parai pongah, Angraeng ih loklamnawk to pazui o ueloe, laa to sah o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng loe hmuensang ah oh; toe poeknaemhaih tawn kaminawk to anih mah khet; amoek kaminawk loe ahmuen kangthla hoiah anih mah panoek boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Raihaih thungah caeh cadoeh, nang hingsak tih; ka misanawk palungphuihaih to pakaa hanah na ban to payangh ueloe, na bantang ban hoiah na pahlong tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng mah sak atimhaih to kai hanah akoepsak tih; Aw Angraeng; na tahmenhaih loe dungzan khoek to cak; na ban hoi sak ih hmuennawk to pahnawt sut hmah.
  </para>
  <chapter number="139" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, kai to nang pakrong moe, nang panoek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kang hnuthaih hoi kang doethaih to na panoek, ka poekhaih hae ahmuen kangthla hoiah na panoek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka caehhaih loklam hoi ka iihhaih doeh nang panoek, ka caehhaih loklamnawk doeh na maat boih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka palai mah lok maeto doeh thui ai vop to mah, toe khenah, Aw Angraeng, nangmah loe panoek boih boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai hae nang takui moe, ka nuiah ban na koeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />To baktih palunghahaih loe kai hanah dawnrai parai han kaom hmuen ah ni oh; sang parai moe, ka phak vawt.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na Muithla khae hoiah naah maw ka caeh thai tih? To tih ai boeh loe na hmaa hoiah nabangah maw ka cawn thai tih?
  </para>
  <para style="p">
    <verse number="8" style="v" />Van ah ka caeh tahang cadoeh, to ah nang na oh; taprong thungah kang song cadoeh, khenah, to ah nang na oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Akhawnbang ih pakhraeh to ka tawnh moe, tuipui zaeh ahmuen kangthla ah ka zawk langlacadoeh;
  </para>
  <para style="p">
    <verse number="10" style="v" />na ban hoiah kai nang zae ueloe, na bantang ban hoiah nang patawn tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vinghaih mah kai na khuk khoep tangtang tih boeh, tiah ka thuih cadoeh, ka taengah aanghaih to om tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ue, vinghaih mah kai na khuk thai mak ai; khoving loe khodai baktiah aang tih; nang hanah loe vinghaih hoi aanghaih to anghmong.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka tak thung ih angannawk loe nangmah ni na sak; kam no zokthung ah ka oh naah nang khuk hmoek boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kai hae zitthok hoi dawnrai koi kaom ah nang sak pongah, nang to kang pakoeh han; na sak ih hmuennawk loe dawnrai han oh, tiah ka hinghaih mah kahoih ah panoek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai hae sak naah kathuk koek ahmuen ah tamquta hoiah nang sak; ka takpum hae nang khae hoiah anghawk thai ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kacung ai ah sak ih, ka takpum hae mik hoiah na hnuk boeh; nihcae ih krang to om ai vop moe, mi doeh om ai naah, ka sak ih hmuennawk to na cabu thungah na tarik boih boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Sithaw, na poekhaihnawk loe kai hanah atho oh parai! Kroeklaek ai khoek to kawk!
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka kroek nahaeloe, savuet pongah pop kue tih; kang thawk tahang naah, nang khaeah ni ka oh poe vop.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Angraeng, kasae kaminawk loe na hum tangtang tih; to pongah nangcae athii anghae kaminawk, kai khae hoi kangthla ah om oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae mah nang to kasae thuih o moe, na misanawk mah na hmin to atho kaom ai ah patoh o boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aw Angraeng, nang hnuma kaminawk to ka hnukma moe, nang misa angthawk thuih kaminawk to ka panuet na ai maw?
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae to ka hnukma tangtang, nihcae loe ka misa ah ni ka poek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aw Sithaw, na pakrong ah loe, ka palungthin hae panoek pae ah; na tanoek ah loe, ka poekhaihnawk hae panoek ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sethaih loklam to ka pazui maw pazui ai tito khen ah loe, dungzan loklam ah na caeh haih ah.
  </para>
  <chapter number="140" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, kahoih ai kami khae hoiah na pahlong ah; poeksae kami ih ban thung hoiah na pakaa ah;
  </para>
  <para style="p">
    <verse number="2" style="v" />nihcae loe sethaih khue to poek o; ni thoekkruek misatuk hanah amkhueng o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae loe palai to pahui palai baktiah taak o; nihcae ih pahni thungah pahui sae kasoe tui to oh. Selah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Angraeng, kasae kaminawk ih ban thung hoiah na pakaa ah; poeksae kami ih ban thung hoiah na pakaa ah; nihcae loe ka khok tangkan amthaeksak hanah poek o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amoek kaminawk mah kai hanah tamquta hoi thaang ang patung pae o moe, qui to payang o; ka caehhaih loklam ah palok payang o moe, dongh patung o. Selah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng khaeah, nang loe kai ih Sithaw ah na oh, tiah ka thuih; Aw Angraeng, tahmen kang hnikhaih hae tahngai ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng Sithaw, thacak kai akrangkung, misatukhaih niah ka lu hae nang khuk pae boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Angraeng, kasae kaminawk koehhaih to paek hmah; nihcae poekhaih doeh koepsak hmah, to tih ai nahaeloe nihcae loe amoek o moeng tih. Selah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai takui kaminawk ih lu loe, angmacae pahni hoi thuih ih sethaih mah khuk nasoe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae nuiah hmai kamngaeh to krah nasoe; nihcae angthawk o let han ai ah, kangqong hmai thungah, tangqom kathuk thungah va o nasoe.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sethaih lok thui thaih kami loe prae thungah om hmah nasoe; to baktih poeksae kami loe a hnukah sethaih mah patom nasoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Patangkhang kami to Angraeng mah khetzawn, amtang kami to toenghaih hoiah lok a caek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tangtang ni katoeng kaminawk mah loe na hmin to saphaw o tih; poektoeng kaminawk loe na hmaa ah om o tih.
  </para>
  <chapter number="141" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, nang to kang kawk; kai khaeah karangah angzo ah; nang kang kawk naah, ka lok hae tahngai pae ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lawk ka thuihaih to na hmaa ah hmuihoih baktih, ka payangh ih ban loe duembang ah sak ih angbawnhaih baktiah om nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng, ka pakha ah toepkung to na suem pae ah; kai ih pahni thok hae na toep pae ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kahoih ai hmuen to sak hanah, kai ih palung hae kahoih ai hmuen sah kaminawk hoi nawnto paqoi hmah; nihcae ih caaknaeknawk doeh na pacah hmah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katoeng kami mah kai na bop nasoe, to tiah ang bohhaih loe amlunghaih ah ni om tih; zoeh doeh na zoeh nasoe, ka lu hanah kahoih koek situi ah ni om tih, ka lu mah angmaa mak ai. Toe sethaih sah kaminawk mah sak ih hmuennawk pongah lawk ka thuih vop.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae ukkungnawk amngoe taengah vah o naah loe, ka thuih ih loknawk loe luep pongah, nihcae mah ka thuih ih loknawk to thaih o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thing to boeng moe, long ah pakhoih baktih toengah, taprong taengah kaicae ih ahuhnawk to a haeh o phang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe, Aw Angraeng Sithaw, ka mik mah loe nang ni ang danh; kai loe nang khaeah ni kam ha; ka hinghaih hae raihaih hoiah na caeh taak hmah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai han patung ih thaang hoi kasae sah kaminawk mah patung ih dongnawk thung hoiah na loisak ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka loih pacoengah, kasae sah kaminawk loe angmacae ih palok pongah aman o nasoe.
  </para>
  <chapter number="142" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng khaeah tha hoi ka hang; tahmen hnikhaih hoi Angraeng khaeah ka hang.
  </para>
  <para style="p">
    <verse number="2" style="v" />A hmaa ah laisaephaih lok to ka thuih moe, ka raihaih to a hmaa ah ka taphong.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka tak thungah muithla thazok sut naah, ka caehhaih loklam to nang panoek pae. Ka caehhaih loklam ah nihcae mah kai hanah tamquta hoiah dongh ang patung o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bantang bangah ka khet naah, kai panoek kami mi doeh om ai; abuephaih ka tawn ai; ka hinghaih paawt mi doeh om ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng, nang khaeah ka hang; nang loe ka buephaih ah na oh moe, kahing kaminawk prae ah kai ih taham ah na oh, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka poekhaih ka pahnaem boeh pongah, ka hanghaih lok hae tahngai ah; kai pacaekthlaek kaminawk ih ban thung hoiah na pahlong ah; nihcae loe kai pongah thacak o kue.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na hmin pakoeh thai hanah, thongim thung hoiah na loisak ah; ka nuiah na hoih pongah, katoeng kaminawk loe ka taengah angzo o tih.
  </para>
  <chapter number="143" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Angraeng, lawk ka thuihaih lok hae tahngai ah; tahmen kang hnikhaih lok hae na tahngai pae ah; na oepthohhaih hoi toenghaih rang hoiah na pathim pae ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na tamna hoi nawnto lokcaekhaih thungah caeh hmah; na hmaa ah kahing kami katoeng maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka misa mah ka hinghaih hae pacaekthlaek; ka hinghaih longah ang vah pae; saning kasawk ah kadueh kaminawk baktih toengah, vinghaih thungah ang ohsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pongah palung ka boeng moe, poekhaih thazok sut boeh, ka palung loe tasoehaih hoiah koi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Canghnii ih atuenawk to ka poek; na sak ih hmuennawk boih to ka poek; na ban hoi sak ih hmuennawk doeh ka poek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang khaeah ban ka payangh; long mah tui anghaeh baktih toengah, ka hinghaih mah nang to tui ah anghaeh. Selah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Angraeng, karangah na tahngai pae ah; ka muithla loe thazok sut boeh; kai khae hoiah na mikhmai to hawk ving hmah, to tih ai nahaeloe tangqom thungah caeh tathuk kaminawk baktiah ka om moeng tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akhawnbang ah nam lunghaih to na thaisak ah, nang ni kang oep; ka caeh han koi loklam to na panoeksak ah; nang khaeah ni ka hinghaih kang tathlang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Angraeng, ka misanawk salak hoiah na krang ah; abuep hanah nang khaeah kang cawnh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang loe ka Sithaw ah na oh pongah, na koehhaih sak hanah na patuk ah; na Muithla loe hoih; toenghaih prae thungah na hoi ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Angraeng, kai hae na hmin hoiah na pathawk ah; na toenghaih hoiah ka hinghaih hae raihaih thung hoiah na loisak ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang tahmen baktih toengah, ka misanawk to paduek ah; ka hinghaih pacaekthlaek kaminawk to amrosak ah; kai loe na tamna ah ni ka oh.
  </para>
  <chapter number="144" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka thacakhaih Sithaw loe tahamhoihaih om nasoe, anih mah ka ban hoi misatuk thaihaih to paek moe, misa kah hanah ka banpazungnawk tha ang caksak;
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih loe kai amlunghaih, kai ih sipae kacak, kai ih misatoephaih imsang, kai krangkung, kang vaenghaih, ka buephaih ah oh moe, kai ih kaminawk kaimah tlim ah omsakkung ah a oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Angraeng, kami loe kawbangah maw oh moe, na poek haih khing? To tih ai boeh loe kami capa loe kawbangah maw oh moe, lokpui parai ah na suek?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kami loe tidoeh na ai ni; anih ih aninawk doeh anghmaa ving tahlip baktiah ni oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Angraeng, na vannawk to akuepsak ah loe, angzo tathuk ah; hmaikhue tacawt thaih hanah, maenawk to sui ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tangphra to pueksak ah loe, misanawk to anghaehsak phang lai ah; nangmah ih palaanawk to kaat ah loe, nihcae to amrosak ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ranui bang hoiah na ban to payangh loe, kai hae na krang ah; kalen parai tuipuinawk thung hoi prae kalah kaminawk ih ban thung hoiah na pahlong ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae ih pakha loe amsawnlok to thuih o, nihcae ih bantang ban doeh alinghaih hoiah koi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Sithaw, nang khaeah laa kangtha to ka sak han; aqui hato kaom katoeng hoiah nang pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah ni siangpahrangnawk khaeah pahlonghaih to paek moe, duekhaih sumsen thung hoiah a tamna David to loisak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Prae kalah kaminawk ih ban thung hoiah na zuk ah loe, akrang ah; nihcae ih pakha loe amsawnlok to thuih o moe, nihcae ih bantang ban loe alinghaih hoiah koi;
  </para>
  <para style="p">
    <verse number="12" style="v" />to tiah ni kaicae ih capanawk loe qoeng o li naah, apawkkung baktiah om o ueloe, canunawk doeh pathoep het ih siangpahrang im taki ih thlung baktiah om o tih;
  </para>
  <para style="p">
    <verse number="13" style="v" />kaicae ih tapupnawk doeh caak koi congca hoiah koi tih; kaicae ih tuu doeh lawk ah, sangto hoi sang hato khoek to pung o tih;
  </para>
  <para style="p">
    <verse number="14" style="v" />kaicae ih maitaw taenawk doeh angpung o ueloe, paroeai toksah o tih; sipae phraekhaih hoi misong ah caehhaih to om mak ai boeh; loklam ah doeh palungset khuiqahhaih lok to a thaih o mak ai boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />To tiah kaom kaminawk loe tahamhoih; ue, Sithaw to Angraeng ah suem kaminawk loe tahamhoih o.
  </para>
  <chapter number="145" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka Sithaw, Aw siangpahrang, nang to kang pakoeh han; na hmin to dungzan hoi dungzan khoek to tahamhoihaih ka paek han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni thokkruek tahamhoihaih kang paek moe, na hmin to dungzan hoi dungzan khoek to kang pakoeh han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng loe len parai pongah, lensawkhaih hoiah pakoeh han krak; a lensawkhaih loe tah laek thai ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na sak ih hmuennawk loe adung maeto pacoeng maeto khoek to pakoeh o ueloe, thacak na tok sakhaihnawk to thui o tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakoeh koi kaom thacak na lensawkhaih hoi na sak ih dawnrai hmuennawk to ka thuih han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaminawk mah thacak, zitthok na sak ih hmuennawk to thui o tih, kai doeh na lensaawkhaih to ka taphong toeng han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kating ai na hoih haih to nihcae mah poek o ueloe, na toenghaih laa to sah o tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng loe tahmenhaih hoi amlunghaih ah oh; anih loe palungphui han rai moe, palungnathaih hoiah koi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng loe kami boih hanah hoih; a sak ih hmuennawk boih nuiah palungnathaih a tawnh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Angraeng, na sak ih hmuennawk boih mah nang to saphaw o ueloe, nangmah ih kaciim kaminawk mah tahamhoihaih na paek o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na prae lensawkhaih hoi na thacakhaih to nihcae mah thui o tih;
  </para>
  <para style="p">
    <verse number="12" style="v" />to tiah ni a thacakhaih hoiah sak ih hmuennawk, thacak a lensawkhaih prae to kaminawk boih mah panoek o thai tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na prae loe dungzan prae ah oh moe, na ukhaih loe adungnawk boih khoek to cak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng loe amtimh kaminawk boih to patawnh moe, poek pahnaem kaminawk boih to tapom tahang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaminawk ih mik boih mah nang to ang khet o; atue phak naah nihcae to buh na pacah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na ban to paongh moe, hinghaih katawn sak ih hmuennawk boih koehhaih to na koepsak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angraeng loe a caehhaih loklam boih ah toeng, a tok sakhaihnawk boih ah ciim.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih kawk kaminawk boih, loktangta hoiah anih kawk kaminawk boih to Angraeng mah oh thuih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih zithaih tawn kaminawk koehhaih to acungsak tih; nihcae hanghaih lok to thaih pae ueloe, nihcae to pahlong tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angraeng palung kaminawk to anih mah khetzawn; toe poeksae kaminawk loe amrosak boih tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka pakha mah loe Angraeng pakoehhaih lok to thui tih; kaminawk boih mah kaciim ahmin to dungzan hoi dungzan khoek to tahamhoihaih paek o nasoe.
  </para>
  <chapter number="146" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to pakoeh ah. Aw ka hinghaih, Angraeng to pakoeh ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka hing thung Angraeng to ka pakoeh han; ka hing thung boih ka Sithaw pakoehhaih laa to ka sak han.
  </para>
  <para style="p">
    <verse number="3" style="v" />long angraengnawk to oep hmah, kami doeh oep hmah; nihcae mah abomh o thai mak ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe duek naah long ah ni amlaem o let; to naah nihcae poekhaihnawk boih to anghmat.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakob ih Sithaw to bomkung ah suem kami, a oephaih to angmah ih Angraeng Sithaw khaeah suem kami loe tahamhoih,
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah ni long hoi van, tuipui hoi athung ah kaom hmuennawk boih to sak; anih loe dungzan khoek to oepthoh;
  </para>
  <para style="p">
    <verse number="7" style="v" />pacaekthlaek ih kaminawk to toenghaih hoiah lok a caek; zok amthlam kaminawk to buh a paek. Angraeng mah ni thongkrah kaminawk to loisak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng mah mikmaengnawk to mik amtuengsak moe, poek pahnaem kaminawk to tapom tahang; katoeng kaminawk to Angraeng mah palung.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng mah angvinnawk to toep moe, ampa tawn ai kami hoi lamhmainawk to pacah; toe kasae kaminawk ih loklam loe buenglueng tamlet ah ohsak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng loe dungzan khoek to Angraeng ah om tih; Aw Zion, na Sithaw mah adungnawk boih khoek to uk tih. Angraeng to saphaw oh.
  </para>
  <chapter number="147" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh; aicae Sithaw khaeah saphawhaih laasak hae hoih; anih saphawhaih loe hoih, anghoe han oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah Jerusalem to sak moe, anghmaa Israel caanawk to tacuu let.
  </para>
  <para style="p">
    <verse number="3" style="v" />Poek amro kaminawk to ngantuisak moe, nihcae ih ahmaa to a zaeng pae.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cakaehnawk to a kroek moe, ahmin hoiah kawk boih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng loe lensawk, thacak parai; anih ih panoekhaih loe boeng thai ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kami tlim ah khosah kaminawk loe Angraeng mah tapom tahang; kasae kaminawk loe long ah a vah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kawnhaih lok thuihaih hoiah Angraeng khaeah laa to sah oh; katoeng kruekhaih hoiah aicae ih Sithaw khaeah saphawhaih laa to sah oh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah ni van to tamai hoiah khuk; long ah kho angzosak moe, maenawk nuiah phroh to amprawksak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Taw ih moinawk hoi kahang thaih pangaah caanawk to buh a paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih loe hrang thacakhaih to oep ai moe, kami ih khoknawk nuiah doeh anghoehaih tawn ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng loe anih zithaih tawn kami hoi a palungnathaih oep kaminawk nuiah ni anghoe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Jerusalem, Angraeng to pakoeh ah; Aw Zion, na Sithaw to pakoeh ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah na khongkha takraenghaih thing to thacaksak moe, nangmah thungah na caanawk tahamhoihaih to ang paek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na prae angzithaih ramri ah angdaehhaih to a sak moe, nang to caak kahoih koek buh hoiah zok amhahsak.
  </para>
  <para style="p">
    <verse number="15" style="v" />A lokpaekhaih to long nuiah patoeh naah, a lok loe karangah cawnh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih mah long ah dantui to tuumui baktiah kraksak moe, dantui kamkhawk doeh maiphu baktiah a haeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Qaetui to thlung caret baktiah a haeh; a haeh ih kamding qaetui thungah mi maw angdoe thai tih?
  </para>
  <para style="p">
    <verse number="18" style="v" />A lok to patoeh moe, tui amkawsak; takhi a songsak pongah, tui to longh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A lok to Jakob khaeah patoeh moe, anih mah patuk ih loknawk hoi anih ih lokcaekhaihnawk to Israel khaeah amtuengsak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Prae kalah kaminawk hanah loe to tiah sah pae ai; toe a lokcaekhaihnawk to nihcae mah panoek o ai. Angraeng to saphaw oh.
  </para>
  <chapter number="148" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh. Vannawk hoiah Angraeng to saphaw oh; anih to ranui koek ah saphaw oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angmah ih vankaminawk boih, anih to saphaw oh; angmah ih van misatuh kaminawk boih, anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni hoi khrahnawk, anih to saphaw oh; nangcae aanghaih tawn cakaehnawk boih, anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangcae vannawk ih vannawk, vannawk nui ih tuinawk, anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih mah lokpaek naah, hmuennawk to angcoeng o pongah, Angraeng ih ahmin to saphaw o nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah to hmuennawk to dungzan khoek to caksak moe, amro han ai ah lok a paek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Long ah kaom tuipui thung ih moinawk hoi kathuk tuinawk boih;
  </para>
  <para style="p">
    <verse number="8" style="v" />hmai hoi qaetuinawk, dantui hoi tamainawk, a lok tahngai takhi saenawk;
  </para>
  <para style="p">
    <verse number="9" style="v" />maenawk hoi maesomnawk boih; kathai thingnawk hoi sidar thingnawk;
  </para>
  <para style="p">
    <verse number="10" style="v" />kasan moinawk hoi im ah pacah ih moinawk; zok hoi kavak moinawk hoi kazawk tavaanawk;
  </para>
  <para style="p">
    <verse number="11" style="v" />long siangpahrangnawk hoi kaminawk boih, angraeng ih caanawk hoi long lokcaekkungnawk boih;
  </para>
  <para style="p">
    <verse number="12" style="v" />thendoengnawk hoi tanglanawk, mitongnawk hoi nawktanawk; Angraeng to saphaw oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih ih ahmin khue ni hoih; a lensawkhaih loe long hoi van nuiah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih loe angmah ih kaminawk to taki tacawtsak moe, angmah ih kaciim kaminawk boih saphawhaih, angmah hoi anghnai koekah kaom, Israel caanawk saphawhaih doeh anih mah ni sak pae. Angraeng to saphaw oh.
  </para>
  <chapter number="149" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh. Angraeng khaeah laa kangtha to sah oh, kaciim kaminawk amkhuenghaih ahmuen ah anih saphawhaih laa to sah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel loe anih sahkung nuiah anghoe nasoe; Zion caanawk loe angmacae siangpahrang nuiah anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih ih ahmin to hnawhaih hoiah saphaw o nasoe; satuem hoi katoeng hoiah anih saphawhaih laa to sah o nasoe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng loe angmah ih kaminawk nuiah anghoehaih tawnh; kami tlim ah khosah kaminawk loe pahlonghaih hoiah amthoepsak tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaciim kaminawk loe lensawkhaih hoiah anghoe o nasoe; a iih o haih ahmuen hoiah anghoehaih laa to sah o nasoe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihcae ih pakha ah Kasang koek Sithaw saphawhaih to om nasoe; nihcae ban ah ahnuk ahma kanoe sumsen to om nasoe,
  </para>
  <para style="p">
    <verse number="7" style="v" />Sithaw panoek ai kaminawk nuiah lu la ah loe, kaminawk to danpaek ah;
  </para>
  <para style="p">
    <verse number="8" style="v" />nihcae siangpahrangnawk to qui hoiah taoengh loe, nihcae ih lensawk kaminawk doeh sumboeng hoiah thlongthuk ah:
  </para>
  <para style="p">
    <verse number="9" style="v" />cabu thungah tarik ih baktih toengah, nihcae to kating ah lokcaek ah: hae loe kaciim Angmah ih kaminawk boih mah hak han koi pazawkhaih ah oh. Angraeng to saphaw oh.
  </para>
  <chapter number="150" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng to saphaw oh. Angmah ih hmuenciim ah Sithaw to saphaw oh; a van thacakhaih to saphaw oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thacakhaih hoiah sak ih hmuennawk to saphaw oh; kahoih koek a lensawkhaih baktih toengah, anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mongkah lok hoiah anih to saphaw oh; katoeng tamoi hoiah anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Satuem tabaeng moe, hnawhaih hoiah anih to saphaw oh; aqui kacung atuenpawk hoiah anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cingceng bohhaih hoiah anih to saphaw oh; lok kalen cingceng bohhaih hoiah anih to saphaw oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hinghaih tawn a sak ih hmuennawk boih mah Angraeng to saphaw o nasoe. Angraeng to saphaw oh.
  </para>
</usx>
