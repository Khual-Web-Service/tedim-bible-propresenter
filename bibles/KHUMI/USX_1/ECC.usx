<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ECC" style="id">Patukkung</book>
  <para style="h">Patukkung</para>
  <para style="toc1">Patukkung</para>
  <para style="toc2">Patukkung</para>
  <para style="mt">Patukkung</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jerusalem ih siangpahrang, David capa, Patukkung ih loknawk loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Azom pui ni! Azom pui ni! tiah Patukkung mah thuih; azom pui ni! Hmuen boih hae azom pui ah ni oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kami mah ni tlim ah angpho qawt hoi toksakhaih atho timaw oh?
  </para>
  <para style="p">
    <verse number="4" style="v" />Adung maeto laemh naah, adung kalah maeto angzoh; toe long loe dungzan khoek to cak poe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ni doeh tacawt tahang moe, akun tathuk, angmah tacawthaih ahmuen hoiah ni tacawt let.
  </para>
  <para style="p">
    <verse number="6" style="v" />Takhi loe aloih bangah song tathuk moe, aluek bangah amlaem tahang; ahnuk ahma amhae moe, a songhaih ahmuen ah amlaem let.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vapuinawk boih loe tuipui ah long o tathuk; toe tuipui loe koi ai toengtoeng vop, vapuinawk loe angmacae long tangsuekhaih ahmuen ah amlaem o let.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmuen boih loe kami mah thui thaih han ai khoek to, angpho haih koiah ni oh o; mik mah a hnukhaih to boep thai ai, naa doeh a thaihaih hoiah koi thai ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaom han koi hmuen loe, kaom tangcae hmuen baktiah ni om tih; sak han kaom hmuen doeh, sak tangcae hmuen baktih ni sah let tih; ni tlim ah hmuen kangtha tidoeh om ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khenah, Hae loe hmuen kangtha ah oh, tiah thuih han koi hmuen oh maw? To baktih hmuen loe canghnii hoiah ni oh boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Canghnii ih hmuennawk to mi mah doeh panoek ai boeh; angzo han koi kaminawk mah doeh, angzo han koi hmuennawk to panoek o mak ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kai, Patukkung loe Jerusalem Israel siangpahrang ah ka oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni tlim ah sak ih hmuennawk boih to palunghahaih hoiah ka pakrong moe, panoek thai hanah tha ka pathok; Sithaw mah to hmuenzit to kaminawk hanah pahoe pae boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ni tlim ah sak ih hmuennawk to ka hnuk boih; khenah, hmuen boih loe azom pui ni, poek angpho han ih ni oh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angkawn pacoeng boeh loe patoengh thai ai boeh; angaihaih doeh kroek thai ai boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khenah, kai loe, ka om ai nathuem ih Israel ukkungnawk pongah, ka len kue moe, palunghahaih bangah doeh ka sang kue; ue, palunghahaih hoi panoekhaih to pop kue ah ka tawnh, tiah ka poek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Palunghahaih bang, amthuhaih bang hoi poek cai ai ah ohhaih bangah doeh, ka panoek thai hanah palungthin to ka paek; hae hmuen doeh takhi hnuk patom baktiah ni oh toengtoeng.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palunghahaih pop baktiah, palungsethaih doeh pop; panoekhaih pop kami loe, palungsethaih doeh pop aep.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palung thungah ka poek, Vaihi caeh ah, takpum nawmhaih loe kawbang maw oh tito kam tuengsak han, toe hae hmuen doeh azom pui ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pahnuihaih loe amthuhaih ah oh moe, nawmhaih mah timaw angcoengsak? tiah ka thuih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaminawk mah hing thung ni tlim ah timaw sak han hoih, tito ka panoek thai hanah, misurtui hoi nawm hanah tha ka pathok, toe amthuhaih ni ka naeh lat; ka palung mah palunghahaih hoiah ni loklam to ang hnuksak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kalen parai tok to ka sak; kaimah hanah imnawk to ka sak moe, misur takhanawk doeh ka sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Takhanawk hoi apawk takhanawk to ka sak moe, takha thungah thingthai kung congca ka thling.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thingnawk to tui paek hanah, tuili to ka sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka im ah tapen tamnanawk, tamna nongpatanawk hoi nongpanawk doeh ka tawnh; kai om ai naah Jerusalem ah kaom tangcae kaminawk pongah doeh maitaw hoi tuunawk to ka tawnh kue.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaimah hanah sui hoi sumkanglungnawk to ka patung, siangpahrangnawk hoi prae thung ih hmuenmaenawk boih doeh ka tawnh; laasak kop nongpa hoi nongpatanawk to ka tawnh moe, nongpanawk poeknawm o hanah laasakhaih ahmuennawk, congca hmuennawk doeh ka tawnh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai loe ka len parai, ka hmaa ah kaom Jerusalem kaminawk pongah ka len moe, palunghahaih doeh ka tawnh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka mik mah khit ih hmuennawk nuiah angsumhaih ka tawn ai, ka palungthin nawmsak koi hmuen pongah angsumhaih ka tawn ai; ka toksakhaih boih ah anghoehaih ka tawnh; ka toksakhaih tangqum to ka hnuk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe ka ban mah sak ih hmuennawk boih to ka khet naah, ka sak ih toknawk boih loe azom pui ni, takhi hnukah patomhaih hoiah ni anghmong; ni tlim ah atho ohhaih tidoeh om ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah poekhaih ka paqoi moe, palunghahaih, palungmaenghaih hoi amthuhaihnawk to ka poek; sak tangcae hmuennawk pong kamtlai ah, siangpahrang pacoengah kaom kami mah timaw sah thai tih?
  </para>
  <para style="p">
    <verse number="13" style="v" />Aanghaih loe vinghaih pongah hoih kue baktih toengah, palunghahaih loe amthuhaih pongah hoih kue, tito ka panoek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palungha kami ih mik loe a lu nuiah suek; toe kamthu loe vinghaih thungah caeh; toe boeng naah nihnik mah tongh han koi hmuen loe maeto ah ni oh, tito ka panoek.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah palung thungah hae tiah ka poek, Kamthu khaeah kaom hmuen baktiah ni, kai khaeah doeh oh toeng; to tih nahaeloe tipongah kai loe palungha kue ah ka oh loe? To pacoengah loe ka palung thungah, Hae hmuen doeh azom pui bae hae, tiah ka poek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vaihi kaom hmuennawk hae hmabangah loe pahnet boih ah om tih, to pongah palungha kami doeh kamthu baktiah ni pahnet o tih; palungha kami doeh kamthu baktiah ni dueh toeng tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah hinghaih hae ka hnukma; ni tlim ah sak ih tok mah palungsethaih ni ang paek; hmuen boih loe azom pui ni, takhi hnukah patom rumramhaih tok ah ni oh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ue, ka hnukah angzo han koi kami khaeah caehtaak han oh pongah, ni tlim ah angpho qawt hoi ka sak ih toknawk boih to ka hnukma.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih loe palungha maw, to tih ai boeh loe amthu maw, tiah mi mah maw panoek tih? Tha pathok moe, tok ka sakhaih boih, ni tlim ah palunghahaih kam tuengsak ih hmuennawk boih loe anih mah ni la tih. To pongah hae hmuen doeh azom pui ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pongah ni tlim ah tha ka pathok moe, tok ka sakhaih mah palung ang boengsak sut boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kami mah palunghahaih, panoekhaih, thoemhaih hoi toksah tih, toe a tawnh ih hmuennawk to toksah ai kami hanah ni caehtaak boih tih. Hae hmuen doeh azom pui ah oh moe, kalen koek tahamsethaih ah ni oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kami mah ni tlim ah tha pathokhaih boih, poek patanghaih hoi toksakhaih pongah, timaw amekhaih hnuk?
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih ih aninawk boih loe palungsethaih ah oh moe, a toksakhaih doeh patangkhanghaih ah ni oh; ue, aqum ah doeh palungthin to anghak ai. Hae hmuen doeh azom pui ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kami loe caak moe, naek pacoengah, sak ih tok nui ah kanawm acaenghaih pongah kahoih kue tidoeh om ai boeh. Ka hnukhaih dan ah, hae hmuen doeh Sithaw ban hoi kaom hmuen ah ni oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Angmah ai ah, mi maw caaknaek to hnu moe, nawmhaih pakrong thaih?
  </para>
  <para style="p">
    <verse number="26" style="v" />A mikhnuk ah kahoih kami khaeah Sithaw mah, palunghahaih, panoekhaih hoi anghoehaih to paek; toe kazae kami khaeah loe khosak raihaih to paek tih, anih mah tawnh ih hmuennawk loe Sithaw palung anghoesak kami hanah paek boih tih. Hae hmuen doeh azom pui ni, takhi hnukah patom rumramhaih tok ah ni oh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmuen boih hanah atue to oh, van tlim ah sak atimhaih hmuennawk nuiah khaeh ih atue to oh boih:
  </para>
  <para style="p">
    <verse number="2" style="v" />tapenhaih atue oh, duekhaih atue oh; patithaih atue oh, patit ih akung aphonghaih atue doeh oh,
  </para>
  <para style="p">
    <verse number="3" style="v" />humhaih atue oh, ngantuihaih atue oh; phraekhaih atue oh, sakhaih atue oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Qahhaih atue oh, pahnuihaih atue oh; palungsethaih atue oh, hnawhaih atue oh,
  </para>
  <para style="p">
    <verse number="5" style="v" />thlungnawk vah phaenghaih atue oh, nawnto pakhueng lethaih atue oh; takoihaih atue oh, takoih han ayae ih atue oh,
  </para>
  <para style="p">
    <verse number="6" style="v" />hakhaih atue oh, sunghaih atue oh; pakuemhaih atue oh moe, vahhaih atue oh,
  </para>
  <para style="p">
    <verse number="7" style="v" />abuuhaih atue oh, huihhaih atue oh; anghngai duemhaih atue oh, lok apaehhaih atue oh,
  </para>
  <para style="p">
    <verse number="8" style="v" />amlunghaih atue oh, hnukmahaih atue oh; misatukhaih atue oh, angdaehhaih atue oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toksah kami mah tha pathok moe, toksakhaih atho timaw oh?
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaminawk mah sak hanah, Sithaw mah paek ih hmuenzit to ka hnuk boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmuen boih hae Angmah ni angmah ih atue thuem ah khet kamcuk ah sak; Sithaw mah sak ih tok amtonghaih hoi boeng khoek to mi mah doeh hnuk thai han ai ah, nihcae palungthin thungah boeng thai ai panoek koehhaih to a suek pae.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hing thung kami loe anghoe moe, kahoih hmuen sak pongah kahoih kue hmuen tidoeh om ai boeh, tiah ka panoek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sithaw mah paek ih tangqum ah oh pongah ni, kami boih mah caak o thaih, naek o thaih moe, a toksakhaih atho to kanawm ah patoh o thaih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sithaw mah sak ih hmuen boih, dungzan khoek to om tih, tiah ka panoek; maeto doeh patomh thai mak ai, maeto doeh azuk ving thai mak ai; kami mah anih to khingza thai hanah, Sithaw mah to tiah sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vaihi ih kaom hmuen loe kaom tangcae hmuen hoiah anghmong; kaom han koi hmuen doeh kaom tangcae hmuen baktiah ni oh; kalaem tangcae hmuennawk to Sithaw mah omsak let tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ni tlim ah kaom lokcaekhaih ahmuen ah kasae sakhaih oh; toenghaih ahmuen ah sakpazaehaih to oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw mah katoeng kami hoi kasae kami to lokcaek hmaek tih, tiah ka panoek; to pongah tok amsakhaih atue oh moe, toksakhaih atue doeh oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kami capanawk khosakhaih kawng pongah hae tiah ka poek; kaminawk mah angmacae hoi angmacae to kasan moinawk baktiah ni ka oh o, tiah panoek o thai hanah, Sithaw mah nihcae khaeah amtuengsak tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaminawk ih taham loe moinawk ih taham hoiah anghmong; to tiah kanghmong taham to ni nihnik mah zing hoi hmaek; maeto duek baktiah, kalah maeto doeh duek toeng; ue, nihnik loe anghahhaih takhi maeto ni tawnh hoi; kami loe moi pongah amek kuehaih om ai; hmuen boih loe azom pui ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmuen boih ahmuen maeto ah ni caeh o; hmuen boih maiphu hoiah tacawt o baktih toengah, maiphu ah amlaem o boih let.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe kami ih pakhra loe ranui bangah caeh tahang moe, moi ih pakhra loe long ah caeh tathuk, tiah mi mah maw panoek?
  </para>
  <para style="p">
    <verse number="22" style="v" />To pongah kami loe angmah ih taham ah kaom, a sak ih tok nuiah anghoe pongah kahoih kue, tidoeh om ai boeh, tiah ka panoek; anih pacoengah timaw om vop tih, tiah panoek thai hanah, mi mah maw anih to patuek tih?
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni tlim ah sak ih pacaekthlaekhaihnawk to ka khet moe, ka poek let bae naah; khenah, pacaekthlaekhaih tongh kaminawk loe qah o, toe pathloepkung tawn o ai; kami pacaekthlaek kaminawk loe sakthaihaih tha to tawnh o, toe pacaelthlaek ih kaminawk loe pathloepkung tawn o ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pongah kadueh tangcae kaminawk loe, kahing kaminawk pongah tahamhoih o kue, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ue, kaom vai ai, ni tlim ah sak ih sethaih hmuen hnu vai ai kami loe to kaminawk pongah tahamhoih kue.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kami mah a imtaeng kami to ut pongah ni, patanghaih hoiah tok a sak, tiah ka hnuk. Hae hmuen doeh azom pui ni, takhi hnuk tapom rumramhaih ah ni oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamthu loe a ban to pakhuem moe, angmah ih angan to caak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Patanghaih hoiah toksak moe, ban hnetto koiah hmuen tawnh pacoengah, takhi hnukah patom rumram pongah loe, kamding rue ah toksak moe, ban tamsum maeto hmuen tawnh to hoih kue.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah ni tlim ah kaom azom pui hmuen to ka hnuk let bae vop.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami maeto loe ampui tawn ai, caa sah ai moe, nawkamya doeh tawn ai, angmabueng khosak, toe toksak patanghaih to boeng thai ai; a tawnh ih hmuennawk to khet boep thai ai; kai loe kaimah hoi kaimah pacaekthlaek kami ah ni ka oh moe, kaimah ih khosak hoihaih to poek ai ah, minawk han ih maw patanghaih hoiah tha ka pathok moeng, tiah anih mah poek vai ai. Hae hmuen doeh azom pui ni, patangkhang rumramhaih ah ni oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hnetto loe maeto pongah hoih kue; nihnik mah toksak azom hoi nahaeloe, toksakhaih atho to hnu hoi hmaek tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Maeto amtim nahaeloe ampui mah anih to pathawk tih; toe bomkung tawn ai ah angmabueng ah amtimh kami loe khosak bing!
  </para>
  <para style="p">
    <verse number="11" style="v" />Kami hnetto nawnto angsong hoi nahaeloe, bae um tih! Toe angmabueng ah angsong nahaeloe, kawbangmaw bae thai tih?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kalah kami mah maeto han hmaang naah nihnik loe angbomh hoi tih; aqui thumto ah zet ih qui loe apet han rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuitaekhaih koeh ai siangpahrang kamthu mitong pongah loe, palungha mithoe nawkta to hoih kue.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kami loe thongkrah cadoeh, siangpahrang ah angcoeng thaih; siangpahrang imthung ah tapen cadoeh amtang thaih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni tlim ah kahing khosah kaminawk loe, siangpahrang qawktoep han kazing, kami hnukah ni bang o boih, tiah ka poek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih loe angmah hmaa ih kroeklaek ai kami nuiah siangpahrang ah oh, toe angzo han koi kaminawk loe siangpahrang nuiah anghoe o poe mak ai. Hae hmuen doeh azom pui ah ni oh tangtang, takhi hnukah patom ramrum baktiah ni oh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw imthung ah na caeh naah na khok tangkan to acoe ah; amsoem ai hmuen a sak o tiah panoek ai kamthunawk ih angbawnhaih to sak pae pongah loe, lok tahngaih hanah azom ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na pakha to rangsak hmah, Sithaw hmaa ah lokthuih hanah, na poekhaih rangsak hmah; Sithaw loe van ah oh moe, nang loe long ah na oh; to pongah na lok to tamsisak ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kapop ah poek ih hmuen to amang ah hnuk baktih toengah, lokpunghaih mah amthuhaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw khae lokkamhaih sak naah, akoepsak ai ah om hmah; anih loe kamthunawk nuiah anghoe ai; lokkamhaih to koepsak ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lokkamhaih na koepsak ai pongah loe, lokkamhaih sah ai ah oh to hoih kue.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na pakha pongah na takpum to zaehaih sahsak hmah; ka sakpazae moeng boeh tiah, van kaminawk hmaa ah thui hmah; na thuih nahaeloe Sithaw palungphui ueloe, na ban hoi sak ih hmuen to amrosak tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pop parai amang hoi pop hmoek ah apaeh ih lok loe avanghaih tidoeh om ai; to pongah nang loe Sithaw to zii ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Prae thungah kamtang hnaphnaehaih, toenghaih loklam hoi amkhraeng moe, patuk ih lok baktih na ai ah lokcaekhaih hoi athii palonghaih to na hnuk naah, to baktih hmuen pongah dawnrai hmah; angraeng maeto loe angmah pongah kasang kue angraeng mah anih to khet parui, nihnik doeh angmah hnik pongah kasang kue angraeng mah khet parui let bae vop.
  </para>
  <para style="p">
    <verse number="9" style="v" />Prae thung ih amekhaih loe kami boih han ih ni, siangpahrang angmah doeh lawk thung hoiah amekhaih to hnuk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Phoisa palung kami loe phoisa hoiah palungdip mak ai; angraenghaih koeh kami doeh a tawnh ih hmuenmae hoiah palungdip thai mak ai; hae hmuen doeh azom pui ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmuenmae pop naah, patohhaih doeh pop aep; katawn kaminawk mah mik hoiah dan o khue ai ah loe tih amekhaih maw a tawnh o?
  </para>
  <para style="p">
    <verse number="12" style="v" />Toksahkung loe zetta caa cadoeh kapop ah caa cadoeh, iih nawm pae; angraeng loe hmuenmae tawnh mang, toe iip thai ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni tlim ah kasae koek hmuen to ka hnuk; angraengnawk loe a tawnh o ih hmuen to angmacae patang han ih ni patung o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe to tiah angraeng kaminawk loe tahamsethaih mah anghmatsak boih; caa nongpa tapen cadoeh, anih mah toep han ih hmuen tidoeh om ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loe amno zokthung hoi bangkrai ah tacawt baktih toengah, bangkrai ah ni amlaem let tih; a toksakhaih to a ban hoi tidoeh sin thai mak ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kami loe angmah angzohhaih baktiah, caeh let tih, hae doeh kasae koek hmuen ah ni oh; takhi hanah toksak hae timaw amekhaih oh?
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih hinghaih aninawk loe khoving thungah laemsak boih; palungsethaih, palungphuihaih, nathaih hoiah ni kho a sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sithaw mah paek ih hinghaih ni setta thungah kami han kahoih, kamsoem ah kaom ka hnuk ih hmuen loe caaknaek moe, tha pathok hoiah hnuk ih toksakhaih atho nuiah poeknawm ah khosakhaih hae ni; to hmuen loe angmah khosakhaih taham ah ni oh roe boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sithaw mah kami boih hanah angraenghaih hoi hmuenmae tawnhhaih to paek; to hmuennawk hoi kanawm ah khosakhaih to paek, angmah ih taham to laksak moe, a toksakhaih pongah anghoehaih to paek; hae hmuen loe Sithaw ih tangqum ah ni oh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaminawk khaeah hmuenzit ah kaom sethaih, ni tlim ah ka hnuk let bae vop:
  </para>
  <para style="p">
    <verse number="2" style="v" />koehhaih akoep hanah, Sithaw mah kami khaeah angraenghaih, hmuenmae tawnhhaih hoi pakoehhaih to paek; toe hmuenmae nuiah kanawm acaeng hanah paek ai pongah, minawk kalah mah kanawm acaeng haih lat; hae doeh azom pui ni, nathaih kasae ah ni oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kami maet loe caa cumvaito tawnh moe, saning sawk parai ah hing cadoeh, hing thung koehhaih akoep ai, duek naah doeh kahoih ah aphum ai nahaeloe, anih pongah loe zok thungah kamro nawkta to hoih kue.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zok thungah kamro nawkta loe azom pui ah tacawt moe, vinghaih thungah caeh, anih ih ahmin loe vinghaih mah ayaw khoep tih boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe ni to hnu vai ai, tidoeh panoek ai; toe anih loe minawk kalah pongah pop kue anghakhaih to hnuk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ue, anih loe saning sang hnetto hing langlacadoeh, a tawnh ih hmuen nuiah nawmhaih tawn ai; kaminawk loe ahmuen maeto ah na ai maw caeh o boih?
  </para>
  <para style="p">
    <verse number="7" style="v" />Kami mah tha pathok moe, sak ih tok boih loe pakha han ih ni sak, toe caak koehhaih loe boeng thai ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palungha mah kamthu pong kamtlai ah amekhaih timaw tawnh? Kahing kaminawk hmaa ah kawbangmaw khosak nahaeloe hoi tih, tiah panoek kamtang loe amekhaih timaw tawnh?
  </para>
  <para style="p">
    <verse number="9" style="v" />Palung koehhaih bangah amkaeh khing pongah loe, mik hoi hnuk ih hmuen to hoih kue; hae doeh azom pui ni, takhi hnukah patom rumram baktiah ni oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vaihiah kaom hmuen loe canghni ah a poek ih hmuen to ni; kami loe angmah pongah thacak kue kami hoiah angnoek thai ai, hae loe kami khosakhaih dan boeh ni, tiah amtueng boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pop hmoek ah lok apaeh naah, avang ai lok to pop aep, to baktih lok mah kami han tih amekhaih maw ohsak?
  </para>
  <para style="p">
    <verse number="12" style="v" />Tahlip baktiah kalaem thaih, avanghaih om ai hing thungah, kami han atho om hmuen mi maw panoek thaih? Kami duek pacoengah loe ni tlim ah timaw om tih, tiah mi mah maw thui thai tih?
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hminhoihaih loe atho kana hmuihoih tui pongah hoih kue; duekhaih ni loe tapenhaih ni pongah hoih kue.
  </para>
  <para style="p">
    <verse number="2" style="v" />Buhraenghaih im ah caeh pongah loe kadueh kami im ah caeh to hoih kue; duekhaih loe kaminawk boih hanah boenghaih loklam ah oh pongah, kahing kaminawk mah palung thungah pakuem han angaih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pahnuih pongah palungset to hoih kue; palungsae mikhmai mah poeknawmhaih to khuk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Palungha ih palung loe palungsethaih tongh kami im ah oh, toe kamthu ih palung loe kanawm acaenghaih im ah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamthunawk ih laa to tahngaih pongah loe, palungha kami zoehhaih lok tahngaih to hoih kue.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamthunawk pahnuihaih lok loe long laom tlim ih hmai tapraek soekhringkung baktiah oh; hae doeh azom pui ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kami pacaekthlaekhaih mah palungha kami to amthusak moe, bokhaih tangqum mah palung amrosak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmuen boenghaih loe amtonghaih pongah hoih kue, amtueng suthaih loe amoek pongah hoih kue.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karangah palungphui hmah, kamthunawk ih palung thungah loe palungphuihaih to oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tipongah canghnii ih aninawk loe vaihi thuem ih aninawk pongah hoih kue loe, tiah dueng hmah; to baktih lokduenghaih loe palungha lok na ai ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palunghahaih loe qawk baktiah hoih moe, ni hnu kaminawk hanah amekhaih oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Phoisa loe pakaahaih ah oh baktih toengah, palunghahaih doeh pakaahaih ah oh; toe palunghahaih mah tacawtsak ih amekhaih loe hae ni; palunghahaih tawn kaminawk hanah hinghaih to paek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sithaw mah sak ih hmuen to poek ah; anih mah angkawnsak tangcae ih hmuen to mi mah maw patoeng thai tih?
  </para>
  <para style="p">
    <verse number="14" style="v" />Atue hoih li naah anghoe ah; toe atue set naah khopoek ah; kami mah hmabang angzo han koi hmuen to panoek thai han ai ah, Sithaw mah taham sae kahoih maeto pacoeng maeto phaksak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Azom pui ah ka hing nathung hmuennawk boih to ka hnuk boeh; katoeng kami loe a toenghaih pongah duek moe, kasae kami loe sethaih hoiah saning kasawk ah hing lat.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toeng hmoek hmah loe, palungha hmoek hmah; tipongah nangmah hoi nangmah to nam ro han loe?
  </para>
  <para style="p">
    <verse number="17" style="v" />Sae hmoek hmah loe, kamthu baktiah doeh om hmah; tipongah atue pha ai naah na duek han loe?
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathlong ving ai ah, patawn caeng han kaom hmuen maeto loe hae ni; ue, Sithaw zii kami loe hmuennawk boih thung hoiah loih tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Palungha kami maeto loe palunghahaih hoiah, vangpui thungah kaom thacak kami hato pongah thacak kue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zaehaih sah vai ai, kahoih hmuen khue kasah, katoeng kami hae long nuiah mi doeh om ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Minawk mah thuih ih lok boih to tahngai hmah; to tiah na sak nahaeloe na tamna mah ang padaeng ih lok to na thaih moeng tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang doeh minawk kasae na thuih toeng, tiah na palung mah panoek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hae hmuennawk hae palunghahaih hoiah ka tanoek boih boeh; palunghahaih hoiah ka koep han boeh, tiah ka thuih, toe palunghahaih to ka phak vawt.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kangthla parai hmuen, kathuk parai hmuen to mi mah maw hnu thai tih?
  </para>
  <para style="p">
    <verse number="25" style="v" />Palunghahaih hoiah ohhaih takung to pakrong moe, panoek thaih pacoengah, kasae kaminawk amthuhaih hoi kamthunawk amthuhaih panoek thai hanah, ka poekhaih palungthin to ka paqoi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dongh hoi palok baktiah poekhaih katawn, qui hoiah kakom thaih nongpata loe duekhaih pongah khaa kue, tiah ka panoek; Sithaw zii kami loe anih khae hoiah loih tih, toe kazae kami loe anih khaeah aman tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khenah, patukkung mah ka hnuk ih hmuen loe hae tiah oh; ka pakrong moe, ka hnu ai ih hmuen hnuk thai hanah, maeto pacoeng maeto ka pakoep naah,
  </para>
  <para style="p">
    <verse number="28" style="v" />nongpa sangto thungah kami katoeng maeto ka hnuk, toe nongpatanawk boih thungah katoeng kami maeto doeh ka hnu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khenah, ka hnuk ih hmuen maeto loe, Sithaw mah kami to katoengah sak, toe kaminawk loe pop parai hmuen to sak hanah pakrong o lat.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi maw palungha baktiah kaom? Mi maw hmuennawk kawng to thui thaih? Palunghahaih mah palungha kami ih mikhmai to pansak moe, anih ih mikhmai amtuenghaih kasae to amkhraisak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sithaw hmaa ah sak ih lokkamhaih to poek ah loe, siangpahrang lokpaekhaih to tahngai ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Siangpahrang hmaa hoi karangah tacawt hmah; kasae hmuen sak hanah angdoe haih hmah; anih loe a koeh baktiah sah tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Siangpahrang ih lok loe thacak; mi mah maw anih khaeah, timaw na sak? tiah naa thai tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi kawbaktih doeh anih ih lok tahngai kami loe nganbawh kana hak mak ai; palungha kami ih palungthin mah loe atue hoi lokcaekhaih to panoek hmaek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kami nuiah raihaih hmuenzit pha langlacadoeh, kawbaktih hmuen ah doeh sakhaih atue hoi sakhaih dan to oh boih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmabang ih akawng loe mi mah doeh panoek ai pongah, angzo han koi hmuen to mi mah maw thui thai tih?
  </para>
  <para style="p">
    <verse number="8" style="v" />Angmah ih muithla pazawk hanah, patawn thaih mi doeh om ai; duek thaih han ai ah duekhaih nuiah thacakhaih tawn mi doeh om ai; misatuh kami loe anghak ai; hmuen kasae sah kaminawk loe a sak o ih sethaih mah nihcae to loisak thai mak ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ni tlim ah sak ih hmuennawk boih ka poek naah, hae hmuennawk hae ka hnuk; angmah nganbawh kana hak hanah kami maeto mah kalah kami ukhaih atue to oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah kasae kaminawk loe aphum o, toe hmuenciim ah angzo moe, kacaeh kaminawk duek o naah loe, a sak o ih vangpui kaminawk mah nihcae to pahnet o boih, tiah ka hnuk; hae doeh azom pui ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zaehaih sah kaminawk to karangah danpaek ai pongah, kaminawk ih palungthin loe zae sak koehhaih hoiah koi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kami zae loe zaehaih cumvaito sah moe, hinglung sawk cadoeh; Sithaw zii kaminawk loe angmah hmaa ah khingyahaih hoiah akuep o pongah, khosak hoihaih to hnu o tih, tiah ka panoek khuek boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kasae kami loe Sithaw to zii ai pongah, khosak hoihaih hnu mak ai; hinghaih doeh sawk mak ai, anih hinghaih loe tahlip baktiah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Azom pui ah kaom hmuen to longah ka hnuk let bae vop; kasae kaminawk mah hnuk han koi sethaih to katoeng kaminawk mah hnuk o moe, katoeng kaminawk mah hnuk han koi tangqum to kasae kaminawk mah hnuk o lat; hae doeh azom pui ni, tiah ka poek.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah kanawm ah khosakhaih to tha ka paek, caaknaek moe, kanawm ah ohhaih khue ai ah loe, ni tlim ah kami han amekhaih tidoeh om ai; Sithaw mah hinghaih paek nathung ni tlim ah tok to sak moe, hnuk ih amekhaih loe to baktih nawmhaih khue to boeh ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Long nuiah toksakhaih hnuk hanah, palunghahaih hoiah panoek thaih han ka poek naah, mik loe khoving khodai iip ai;
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw mah sak ih hmuennawk boih ka khet naah, ni tlim ah sak ih toknawk to mi mah doeh panoek thai ai; tha pathok moe, hnuk han pakrong cadoeh panoek thai mak ai; ue, palungha kami mah ka panoek, tiah a poek, toe hnu thai mak ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni tlim ah kaom hmuennawk boih ka poek naah, katoeng kaminawk hoi palungha kaminawk mah sak ih hmuen boih Sithaw ban ah ni oh; toe nihcae mah tongh o ih hmuen loe amlunghaih, to tih ai boeh loe hnukmahaih hoiah maw oh, tiah mi mah doeh panoek o ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kasae kami, kahoih kami, ciimcai kami, ciimcai ai kami, angbawnhaih paek kami, angbawnhaih paek ai kami, katoeng kami, kami zae, lokkamhaih sah kami hoi lokkamhaih sak han zii kaminawk nuiah kaom hmuen loe anghmong boih, kami boih nuiah kaom hmuen doeh anghmong boih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni tlim ah kaom hmuennawk boih thungah kasae koek hmuen, kami boih khaeah kaom hmuen loe anghmong boih; ue, kaminawk ih palung loe sethaih hoiah koi; a hing o nathung amthuhaih palung hoiah koi o, to pacoengah duekhaih thungah a caeh o boih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kahing kaminawk salakah kaom kami loe oephaih to tawnh; kadueh kaipui pongah loe kahing ui to hoih kue.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kami mah kai loe ka dueh tih, tiah panoek; toe dueh kami loe tidoeh panoek ai, tangqum hnuk han tawn o ai; panoekhaih doeh anghmat boih boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amlunghaih, hnukmahaih hoi uthaihnawk doeh, anghmat boih boeh; ni tlim ah kaom hnuk han koi taham to natuek naah doeh hnu let mak ai boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Caeh ah loe anghoehaih hoiah buh ann to caa ah, poeknawmhaih hoiah misurtui to nae ah; na toksakhaih to Sithaw mah vaihi tapom boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khokpanai kanglung to abuen ah loe, na lu ah situi angnok toepsoep ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ni tlim ah Sithaw mah paek ih azom pui ah kaom na hing thungah na palung ih na zu hoiah kanawm ah khosah ah; hae loe ni tlim ah tha pathokhaih hoiah toksak ih atho ah ni oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na ban hoi sak han koi hmuennawk boih to tha pathok ah loe sah ah; na caehhaih ahmuen, taprong ah loe toksakhaih doeh, khopoekhaih doeh, to tih ai boeh loe panoekhaih hoi palunghahaih doeh om ai boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ni tlim ah kaom hmuennawk to ka khet naah, cawnh rang kami mah angnoekhaih to pazawk poe ai, thacak kami mah misa angtukhaih pazawk poe ai, palungha kami doeh zok amhah poe ai; thoemthaih tawn kami doeh angraeng poe ai; palungha kami doeh minawk hmaa ah mikhmai hak poe ai; toe taham sae, taham hoih tonghaih atue mah nihcae nuiah kangvan ah phak thuih boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kami mah tong han koi atue to panoek ai; palok pongah kaman tanga hoi dongh pongah kaman tavaanawk baktiah, atue kasae mah anih to naeh, anih loe poek ai pui hoiah to baktih raihaih thungah amtimh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hae baktih palunghahaih to ni tlim ah ka hnuk, to hmuen loe kai hanah len parai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Avang tetta maeto oh moe, to avang thungah kami zetta oh o; thacak siangpahrang loe angzoh moe, to vangpui to takui khoep, anih mah kalen parai misa abuephaih long to takaeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah to vangpui thungah palungha kamtang maeto oh; to kami ih palunghahaih mah vangpui to pahlong, toe amtang kami to mi mah doeh poek o ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah palunghahaih loe thacakhaih pongah hoih kue, tiah ka thuih; toe kamtang palunghahaih loe tidoeh sah pae o ai; a thuih ih lok doeh tahngai pae o ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ukkung kamthu hanghaih lok tahngaih pongah loe palungha ih loknaem to tahngaih hanah hoih kue.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palunghahaih loe misatukhaih hmuenmae pongah hoih kue, toe kami zae maeto mah loe pop parai kahoih hmuen to amrosak.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kadueh taksae mah hmuihoih tui to hmuisae ah angcoengsak baktih toengah, kamthu khosakhaih mah palunghahaih hoi ahmin kahoih pakoehhaih to amrosak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Palungha kami ih palung loe bantang bangah oh, toe kamthu ih palung loe banqoi bangah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ue, kamthu loe lamcaeh naah doeh, amthuhaih to amtueng moe, angmah amthuhaih to minawk boih khaeah thuih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ukkung mah palung ang phui thuih naah, na ohhaih ahmuen to caeh taak hmah; angdaehahih mah kalen sakpazaehaih to dipsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ukkung khae hoiah sakpazaehaih tacawt baktih toengah, ni tlim ah ka hnuk ih hmuen kasae to oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng mah ahmuen kahnaem ah anghnut naah, kamthu loe kasang ahmuen ah anghnut lat.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraengnawk khok hoiah amkaeh o naah, tamnanawk mah hrang nuiah angthueng o lat.
  </para>
  <para style="p">
    <verse number="8" style="v" />Qumqai kami loe tangqom thungah krah tih; sipae phrae kami loe pahui mah patuk tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thlung takhoe kami loe nganbawh kana hak tih; thing khuek kami loe ahmaa caa tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Caka to kanoe ah taak ai nahaeloe, tha ueng han angaih; toe palunghahaih mah atho ohhaih loklam to hnuksak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pahui to adoi hoiah na sak cadoeh na patuk tih, lokpunghaih loe amekhaih tidoeh om ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palungha kami ih pakha thung hoiah tacawt loknawk loe tahmenhaih to oh, toe kamthu loe angmah ih pahni mah paaeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih pakha hoi tacawt tangsuek lok loe amthuhaih hoiah amtong, anih ih lokpaeh boenghaih loe kasae amthuhaih ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kamthu loe lok pung, kami mah angzo han koi hmuen to thui thai ai; anih hmabang ah timaw om tih, tiah mi mah maw thui thai tih?
  </para>
  <para style="p">
    <verse number="15" style="v" />Vangpui thungah caehhaih loklam to panoek ai baktih toengah, kamthu toksakhaih mah kaminawk angphosak boih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nawkta ukkung siangpahrang ohhaih prae, khawnthaw ah buh raenghhaih poih sah angraengnawk ohhaih prae, nang loe khosak bing!
  </para>
  <para style="p">
    <verse number="17" style="v" />Khingya han koi kaom imthung takoh hoiah tapen siangpahrang ohhaih prae, mu kanae hmoek ai, tha oh hanah atue phak naah buh kacaa angraengnawk ohhaih prae, nang loe tahamhoih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thasethaih mah im to hmawnsak; bantha set pongah im loe kho longh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pahnuih hanah ni poih to sak, mu mah kami poeknawmsak; toe phoisa mah hmuenmae to qan thaih boih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Siangpahrang to palung thung hoiah doeh pasoih hmah; angraengnawk doeh na iihhaih ahmuen hoiah pasoih hmah; van ih tavaa mah na lok to sin ueloe, pakhraeh kaom tavaa mah thui pae moeng tih.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tui nuiah takaw to va ah, ni akra parai pacoengah na hnu let tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kami sarihto khae khue ah na ai, tazetto hanah doeh paek ah; long nuiah kawbaktih sethaih maw pha tih, tiah na panoek ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tamai loe khotui hoiah koi naah ni, long ah kho angzoh; thing loe aluek bangah maw, to tih ai boeh loe aloih bangah maw, amtim cadoeh, amtimhaih ahmuen ah ni oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Takhi khen kami loe patii mak ai, tamai khen kami doeh aat mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Takhi caehhaih loklam to na panoek ai, amno zokthung ah nawkta ih ahuh kawbangmaw qoeng tahang, tito na panoek ai; to baktih toengah hmuen boih Sahkung Sithaw toksakhaih to na panoek ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khawnthaw ah cangtii tuh ah, duembang ah doeh na ban to pakhuem duem hmah; kawbaktih maw atho om tih, kawbaktih maw atho om mak ai, to tih ai boeh loe atho om hoi hmaek tih maw, tito na panoek ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tangtang ni ni aengh loe luep, ni aengh hnuk naah mik hanah anghoehaih to oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kami loe saning sawk ah hing moe, hmuen boih ah anghoehaih tawn cadoeh, vinghaih aninawk to poek nasoe; to aninawk loe sawk parai tih. Angzo han koi hmuennawk boih loe azom pui ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw thendoeng, tha oh nathuem ah anghoe ah; tha oh thuem naah na palung to anghoe nasoe, na palung mah koeh ih loklam baktih, na mik mah hnuk ih loklam baktiah caeh ah; toe hae hmuennawk boih pongah Sithaw mah lok na caek tih, tito panoek ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pongah palung na sethaih to takhoe ah loe, na takpum pong ih sethaih to va ah; saning nawkhaih hoi qoeng thuemhaih doeh azom pui ah ni oh.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kai loe to baktih hmuennawk nuiah anghoehaih ka tawn ai, tiah na thuihaih saning mah pha thuih ai vop moe, sethaih aninawk mah na pha thuih ai nathuem, na qoeng li naah, nang Sahkung Sithaw to panoek ah;
  </para>
  <para style="p">
    <verse number="2" style="v" />to baktih atue loe ni hoi ni aengh om mak ai, khrah hoi cakaeh doeh aang mak ai, kho angzoh moe, tamai anghmat phaenghaih atue ah om tih;
  </para>
  <para style="p">
    <verse number="3" style="v" />im toep kaminawk loe tasoeh o tih, thacak kaminawk loe kaengkuu o tih, kami tamsi pongah cang kae kaminawk loe anghak o tih, thokbuem hoiah khen kaminawk loe hnu o thai mak ai boeh;
  </para>
  <para style="p">
    <verse number="4" style="v" />cang kaehhaih atuenh thazok boeh, to naah lampui taeng ih thoknawk to khaa o tih; tavaa ih lok thaih naah anih to angthawk tih, laasah nongpatanawk mah laa lok kahnaem ah laa to sah o tih;
  </para>
  <para style="p">
    <verse number="5" style="v" />nihcae mah kasang ahmuen to zii o tih, loklam ah zithaih to om tih, almond thing loe tadok tacawt ueloe, pakhuh loe nang han hmuen kazit ah om tih, koehhaih palungthin to thazok tih boeh; kami loe angmah ih dungzan im ah caeh boeh pongah, palungsae kaminawk loe loklam ah caeh o tih:
  </para>
  <para style="p">
    <verse number="6" style="v" />to tih ai boeh loe sumkanglung aqui khramhaih maw, sui boengloeng koihhaih maw, tuibap tui sohhaih laom koihhaih maw, to tih ai boeh loe tuikung ah khok angkhaehhaih to om tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Maiphu loe a ohhaih long ah amlaem let ueloe, muithla loe paekkung Sithaw khaeah amlaem let tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Azom pui ni! azom pui ni! Hmuen boih loe azom pui ah ni oh, tiah patukkung mah thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Patukkung loe palungha pongah, kaminawk hanah palunghahaih to patuk; ue, tha pathokhaih hoiah pakrong pacoengah, pop parai palunghahaih loknawk to a sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Patukung loe tapom thaih koiah kaom loknawk to hnuk thai hanah pakrong, anih mah tarik ih loknawk loe toeng moe, loktang lok ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palungha kami ih loknawk loe, kamsum cung baktih, tuu toepkung mah tuu huih haih hanah patoh ih thingboeng, kaminawk mah thing nawnto takhing haih, sumdiknawk baktiah oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah ka capa, to baktih loknawk hoi thuitaek ih kami ah om ah; cabu sakhaih loe boeng thai ai; kapop ah amtukhaih mah takpum angphosak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sangqum boih ah lok pakhaphaih loe hae tiah oh; Sithaw to zii ah loe, a paek ih loknawk to pakuem ah; hae loe kami mah hing thung sak han ih tok ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kasae maw, kahoih maw, tamquta hoiah sak ih hmuen baktih, sak ih hmuennawk baktih toengah Sithaw mah lokcaek tih.
  </para>
</usx>
