<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JHN" style="id">Johan</book>
  <para style="h">Johan</para>
  <para style="toc1">Johan</para>
  <para style="toc2">Johan</para>
  <para style="mt">Johan</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tangsuek naah Lok to oh, to Lok loe Sithaw hoi nawnto oh, Lok loe Sithaw ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lok loe tangsuek na hoiah boeh ni Sithaw hoi nawnto oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah hmuennawk boih to sak; anih ai ah sak ih hmuen tidoeh om ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih thungah hinghaih oh; to hinghaih loe kami han aanghaih ah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aanghaih loe kaving thungah aang; toe kaving mah anih to panoek ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw khae hoi patoeh ih kami maeto oh; anih ih ahmin loe Johan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih rang hoiah kaminawk boih mah tanghaih tawnh o thai hanah, anih loe hnukung maeto ah oh moe, aanghaih hnukung ah oh hanah angzoh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih loe to Aanghaih to na ai ni, toe to Aanghaih hnukung ah oh han ih ni patoeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />To Aanghaih loe long nuiah angzo kaminawk boih aanghaih paekkung, Aanghaih tangtang ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih loe long ah oh, long loe Anih mah ni sak, toe long mah Anih to panoek ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih loe Angmah kaminawk khaeah angzoh, toe Angmah ih kaminawk mah Anih to talawk o ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe Anih talawk kaminawk hoi Anih ih ahmin tang kaminawk khaeah, Sithaw caa ah angcoeng thaihaih to a paek:
  </para>
  <para style="p">
    <verse number="13" style="v" />to caanawk loe athii, taksa hoi kami koehhaih baktiah tapen ai, Sithaw koehhaih baktiah tapen kami ah ni oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lok loe takpum ah angcoeng, aicae salakah oh moe, tahmenhaih hoi loktang hoiah koi (Ampa mah maeto khue tawnh ih lensawkhaih,) a lensawkhaih to a hnuk o boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Johan mah, Ka hnukah angzo kami loe kai tapen ai naah oh boeh, kai pongah len kue, tiah ka thuih ih lok loe Anih thuih koehhaih ih ni, tiah anih kawng to thuih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih akoephaih hoi tahmenhaih loe aicae boih mah hnuk o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaalok loe Mosi khaeah paek, toe tahmenhaih hoi loktang loe Jesu Kri rang hoiah ni angzoh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi mah doeh Sithaw to hnu vai ai, toe Ampa ih saoek ah kaom, maeto khue tawnh ih, Capa mah Anih to amtuengsak boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jerusalem ih Judahnawk mah, Nang loe mi aa? tiah dueng hanah qaimanawk hoi Levinawk to anih khaeah patoeh naah, Johan mah hae tiah thuih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih loe angphat ai ah kai loe Kri na ai ni, tiah thuih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nihcae mah anih khaeah, to tih nahaeloe nang loe mi aa? Elijah maw? tiah dueng o. Anih mah, Kai loe Elijah na ai, tiah a naa. Nang loe Tahmaa maw? tiah dueng o. Anih mah, Kai loe tahmaa na ai ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae mah anih khaeah, Kaicae patoeh kaminawk khaeah ka thuih pae o hanah nang loe mi aa, nangmah hoi nangmah to kawbangmaw na thuih? tiah a naa o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih mah, Tahmaa Isaiah mah thuih ih lok baktih toengah, Kai loe Angraeng ih loklam to patoengh oh, tiah praezaek ah kahang kami ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nihcae loe Farasinawk mah ptoeh ih kami ah oh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae mah anih khaeah, Kri na ai, Elijah doeh na ai, Tahmaa doeh na ai to mah, tih han ih tuinuemhaih na paek loe? tiah dueng o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Johan mah nihcae khaeah, Kai loe tui hoiah ni tuinuemhaih to ka paek: toe nangcae salakah kaom na panoek o ai ih kami maeto angdoet;
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih loe ka hnukah angzoh, toe kai pongah len kue, kai loe anih ih khokpanai qui khram pae han mataeng doeh kam cuk ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae hmuennawk loe Johan mah tuinuem paekhaih, Bethany avang Jordan vapui yaeh ah sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khawnbangah loe angmah khaeah kangzo Jesu to Johan mah hnuk, To naah khenah, long zaehaih phawkung, Sithaw Tuucaa! tiah thuih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih loe kai tapen ai naah oh boeh, ka hnukah angzo kami loe kai pongah len kue, tiah ka thuih ih kami loe, Anih hae ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih to ka panoek ai: Anih loe Israel kaminawk khaeah amtueng han koi kami ah oh pongah, tui hoiah tuinuemhaih to ka paek, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Johan mah, Pahuu baktiah van hoiah anghum tathuk, Anih nuiah kacuk, Muithla to ka hnuk, tiah thuih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih to ka panoek ai: toe tui hoi tuinuem hanah kai patoehkung mah kai khaeah, Anih nuiah kacuk, anghum tathuk Muithla to na hnuk nahaeloe, Anih loe Kacai Muithla hoi tuinuem ih kami ah ni oh, tiah ang thuih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka hnuk ih baktiah hae kami loe Sithaw Capa ni, tiah ka taphong boeh, tiah thuih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Khawnbangah Johan loe a hnukbang hnik hoi nawnto angdoet;
  </para>
  <para style="p">
    <verse number="36" style="v" />loklam ah kacaeh Jesu to a hnuk naah, Khenah, Sithaw Tuucaa! tiah thuih.
  </para>
  <para style="p">
    <verse number="37" style="v" />To lok to a hnukbang hnik mah thaih hoi naah, Jesu hnukah bang hoi ving.
  </para>
  <para style="p">
    <verse number="38" style="v" />Anih hnukah bang kami hnik to Jesu mah hnuk naah, angqoi moe, nihnik khaeah, Timaw na pakrong hoi? tiah a naa. Nihnik mah anih khaeah, Rabbi, (Patukkung, tiah thuih koehhaih ih ni) naa ah maw na oh? tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih mah nihnik khaeah, Angzoh loe, khen hoih, tiah a naa. Nihnik loe caeh hoi moe, anih ohhaih ahmuen to khet hoi, to na ni loe Anih hoi nawnto oh hoi: to nathuem ah atue hato phak tom boeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Johan mah thuih ih lok thaih, Anih hnukah bang kami hnik thung ih maeto loe, Simon Piter ih amnawk Andru ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Andru loe amya Simon to pakrong hamloe moe, anih khaeah, Messiah (Kri, tiah thuih koehhaih ih ni) to ka hnuk o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anih mah amya to Jesu khaeah caeh haih. Jesu mah anih to khet moe, Nang loe Jona capa Simon: Cepha (thlung, tiah thuih koehhaih ih ni,) tiah kawk tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jesu loe khawnbangah Kalili ah caeh han amsak, Philip to a hnuk naah anih khaeah, Ka hnukah bangah, tiah a naa.
  </para>
  <para style="p">
    <verse number="44" style="v" />Philip loe Andru hoi Piter baktih toengah Bethsaida vangpui ih kami ah oh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Philip mah Nathanael to hnuk naah anih khaeah, Kaicae loe Mosi ih kaalok hoi tahmaanawk mah tarik ih, Joseph capa, Nazareth Jesu to ka hnuk o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nathanael mah anih khaeah, Nazareth hoiah hmuen kahoih tacawt thai tih maw? tiah a naa. Philip mah anih khaeah, Angzoh loe khen ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="47" style="v" />Philip khaeah kangzo Nathanael to Jesu mah hnuk naah, anih khaeah, Khenah, alinghaih tawn ai, Israel kami tangtang! tiah a naa.
  </para>
  <para style="p">
    <verse number="48" style="v" />Nathanael mah anih khaeah, Natuek naah maw kai nang panoek loe? tiah a naa. Jesu mah anih khaeah, Philip mah na kawk ai vop, thaiduet kung tlim ah na oh naah, kang hnuk boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="49" style="v" />To naah Nathanael mah anih khaeah, Patukkung, Nang loe Sithaw Capa, Israel Siangpahrang ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu mah anih khaeah, Thaiduet kung tlim ah na oh naah, kang hnuk boeh, tiah kang naa pongah maw na tang? Hae pongah kalen kue hmuennawk to na hnu vop tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="51" style="v" />Jesu mah anih khaeah, Loktang to, loktang ah, Kang thuih o, Kam-ong van to na hnu o ueloe, Kami Capa nuiah daw tahang anghum tathuk Sithaw ih van kaminawk to na hnu o tih, tiah a naa.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni thumto naah Kalili prae Kana vangpui ah zu paluemhaih poih to oh; Jesu ih amno doeh toah oh toeng:
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu hoi a hnukbang kaminawk doeh to zu raenghaih poihkung ah kawk o toeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Misurtui boeng ving naah, Jesu amno mah Anih khaeah, Misurtui tawn o ai boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu mah anih khaeah, Nongpata nang hoi kai timaw asaenghaih oh? Kai ih atue pha ai vop, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amno mah tamnanawk khaeah, Ang thuih o ih lok baktiah sah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judahnawk amprikcaihaih atawk baktih toengah, toah Kalan pumphaeto, to tih ai boeh loe quithumto akun, moiroih tarukto pahung o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu mah nihcae khaeah, Muiroih to tui pakoih oh, tiah a naa. Nihcae mah muroih koiah tui to thaeng o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah nihcae khaeah, Vaihi tui to buek oh loe, poih khawng kacoehta khaeah sin oh, tiah a naa. A thuih ih lok baktiah nihcae mah sak pae o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Poih khawng kacoehta mah misurtui ah angcoengsak ih tui to pataeng naah, Naa ih maw lak o tito panoek ai: (toe tui doh tamnanawk mah loe panoek o;) poih khawngkung mah zu paluem kami to kawk,
  </para>
  <para style="p">
    <verse number="10" style="v" />anih khaeah, Kaminawk loe misur asing tui bae hmaloe ah patoem o; kaminawk paquih o boep tih naah ni, kahoih ai misurtui to paek o vop: toe nang loe vaihi khoek to maw misur asing tui na suek vop! tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hae loe Jesu mah Kalili prae Kana vangpui ah sak tangsuek ih dawnrai hmuen ah oh moe, a lensawkhaih to amtuengsak; a hnukbang kaminawk mah Anih to tang o.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah amno, nawkamyanawk, a hnukbang kaminawk hoi nawnto Kapernuam vangpui ah caeh o: to ah ni kasawk cam o ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Judahnawk ih misong loihhaih ni phak tom naah, Jesu loe Jerusalem ah caeh tahang,
  </para>
  <para style="p">
    <verse number="14" style="v" />tempul thungah maitaw, tuu, pahuu zaw kaminawk hoi phoisa athlaeng kaminawk to a hnuk:
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih mah bohhaih qui tetta to sak moe, maitaw, tuu hoi to ih kaminawk to tempul thung hoiah haek boih; phoisa athlaeng kaminawk ih phoisa to kraih pae moe, caboinawk doeh pakhup pae boih;
  </para>
  <para style="p">
    <verse number="16" style="v" />pahuu zaw kaminawk khaeah, Hae ahmuen hoiah hae hmuennawk hae la oh; kam Pa ih im hae hmuenmae zawhhaih im ah sah o hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah a hnukbang kaminawk mah, Na im palunghaih mah Kai ang caak boih boeh, tiah tarik ih lok to poek o vawk.
  </para>
  <para style="p">
    <verse number="18" style="v" />To naah Judahnawk mah anih khaeah, Hae hmuennawk na sak naah, tih angmathaih maw kaicae han nang hnuksak? tiah dueng o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu mah nihcae khaeah, Hae tempul hae phrae oh, ni thumto thungah ka padoet let han, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />To naah Judahnawk mah, Saning quipali, tarukto thung ka sak o ih, hae tempul hae nang mah ni thumto thungah na padoet let han maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe anih mah thuih koehhaih loe angmah ih takpum tempul to ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih duekhaih hoi angthawk let naah, a hnukbang kaminawk khaeah a thuih pae ih lok to panoek o let; to pongah nihcae loe Cabu hoi Jesu mah thuih ih lok to tang o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih Jerusalem ih misong loihhaih poihkung ah oh naah, anih mah sak ih dawnrai hmuennawk to hnuk o, to naah paroeai kaminawk mah anih ih ahmin to tang o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe Jesu mah kaminawk to panoek boih pongah, anih loe to kaminawk khaeah angmah hoi angmah to nihcae tlim ah angpaek ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kami ih palungthin to anih mah panoek pongah, mi kawbaktih mah doeh anih hanah kami kawng thuih pae han angai ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah uk kaminawk thungah, Nicodemu, tiah ahmin kaom Farasi kami maeto oh:
  </para>
  <para style="p">
    <verse number="2" style="v" />anih loe qum ah Jesu khaeah caeh moe, anih khaeah, Rabbi, nang loe Sithaw khae hoi angzo patukkung ah na oh, tiah kang panoek o: Sithaw mah anih to om thuih ai nahaeloe, na sak ih dawnrai hmuennawk hae mi mah doeh sah thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu mah anih ih lok to pathim pae, anih khaeah, Loktang to, loktang ah kang thuih, Mi kawbaktih doeh tapen let ai kami loe, Sithaw mah siangpahrang ah uk ih prae to hnu thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nikodemu mah anih khaeah, Kami loe mitong pacoengah kawbangmaw tapen let thai tih, anih loe amno zokthung ah vai hnetto akun ueloe, tapen let thai tih maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu mah, Loktang to, loktang ah kang thuih, Tui hoi Muithla hoiah tapen ai kami loe, Sithaw prae thungah akun thai mak ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Taksa ah tapen kami loe taksa ah oh; Muithla ah tapen kami loe muithla ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na tapen let han oh, tiah kang thuih pongah dawnrai hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Takhi loe a koeh baktiah song, takhi tuen to na thaih, toe naa bang hoiah maw angzoh moe, naa bangah maw caeh, tiah na thui thai ai: Muithla ah tapen kami loe to tiah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nikodemu mah anih khaeah, Hae hmuenawk loe kawbangmaw om thai tih? tiah pathim.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah anih khaeah, Israel kaminawk patukkung ah na oh to mah, hae hmuennawk hae na panoek ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Loktang to, loktang ah kang thuih, Kaicae loe panoek ih hmuen to ka thuih o moe, ka hnuk o ih hmuen to ni ka taphong o; ka taphong o ih hmuen to na talawk o ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Long hmuen kawngnawk ka thuih naah mataeng doeh, na tang o ai nahaeloe, van hmuen kawngnawk ka thuih nahaeloe, kawbangmaw na tang o thai tih?
  </para>
  <para style="p">
    <verse number="13" style="v" />Van hoi angzo tathuk, van ah kaom kami Capa ai ah loe, mi doeh van ah daw vai ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mosi mah praezaek ah takhing ih pahui baktih toengah, kami Capa to takhing o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi kawbaktith doeh Anih tang kami loe anghmaa mak ai, dungzan hinghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sithaw mah long palung phi pongah, maeto khue tawnh ih a Capa to a paek, mi kawbaktih doeh Anih tang kami loe anghmaa mak ai, dungzan hinghaih to hnu tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Long lokcaek hanah Sithaw mah a Capa to long ah patoeh ai; Anih rang hoiah long pahlong han ih ni patoeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih tang kami loe lokcaek mak ai, toe tang ai kami loe maeto khue tawnh ih Sithaw Capa ahmin to tang ai pongah, lokcaek ah oh boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hae loe lokcaekhaih ah oh, aanghaih loe long ah angzoh, toe a sak o ih hmuennawk to hoih ai pongah, kaminawk mah aanghaih pongah vinghaih to koeh o kue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahoih ai hmuen sah kami loe aanghaih to hnukma, a toksakhaih amtueng moeng tih, tiah a poek pongah, aanghaih thungah angzoh han koeh ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe loktang hoi kahing kami loe, Sithaw rang hoiah a sak o ih hmuennawk to amtueng thai hanah, aanghaih thungah angzoh, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />To pacoengah Jesu hoi a hnukbang kaminawk loe Judea prae ah caeh o; anih loe nihcae hoi nawnto to ahmuen ah oh moe, tuinuemhaih to paek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Johan mah doeh Salim taengah kaom Aenon avang ah tuinuemhaih to paek: to ahmuen ah loe tui pop pongah, kaminawk angzoh o moe, tuinuemhaih to sak o.
  </para>
  <para style="p">
    <verse number="24" style="v" />To nathuem ah Johan loe thongim krah ai vop.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ciimcaihaih kawng pongah Judahnawk hoi Johan hnukbang kaminawk lok angaek o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nihcae loe Johan khaeah caeh o moe, anih khaeah, Rabbi, khenah, Jordan vapui yaeh ah nang hoi nawnto kaom kami, na taphong ih kami mah tuinuemhaih to paek, kaminawk loe anih khaeah caeh o boih boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Johan mah, Van hoiah anih han paek ai ah loe, kami mah tidoeh hnu thai mak ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kai loe Kri na ai ni, toe kai loe Anih hmaa ah patoeh ih kami ni, tiah hnukung ah nangcae na oh o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zu lak naah nongpa mah ni nongpata to lak: toe zu kala thendoeng ih ampui loe anih taengah angdoet moe, anih ih lok to thaih, zu lakung ih lok to thaih pongah, paroeai anghoe: to pongah kang hoehaih loe hae tiah akoep boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih loe pung tahang aep tih, toe kai loe amsah tathuk tih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Van hoiah angzo kami loe hmuen boih ranui ah oh: long hoiah angcoeng kami loe long hmuen ah oh moe, long hmuen kawng to a thuih: van hoiah angzo kami loe hmuen boih ranui ah oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anih mah loe hnuk moe, thaih ih hmuen to ni a thuih; mi mah doeh a thuih ih lok to talawk pae o ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />A thuih ih lok talawk kami mah loe, Sithaw loe loktang ni, tiah catui to a daengh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sithaw mah patoeh ih kami loe Sithaw lok to thuih: Sithaw mah anih khaeah tahhaih om ai ah Muithla to paek.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ampa mah Capa to palung pongah hmuennawk anih ban ah paek boih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Capa tang kami loe dungzan hinghaih to tawnh: Capa tang ai kami loe hinghaih hnu mak ai; Sithaw palungphuihaih a nuiah om tih, tiah a naa.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />(Jesu mah loe tuinuemhaih to paek ai, a hnukbang kaminawk mah ni paek o,) toe Jesu loe Johan pongah hnukbang kaminawk pop kue ah tawnh, kapop kue tuinuemhaih paek ti, tiah Farasinawk mah thaih o boeh, tiah Angraeng mah panoek naah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Judea prae to tacawt taak moe, Kalili ah a caeh let.
  </para>
  <para style="p">
    <verse number="4" style="v" />To tiah a caeh naah Samaria prae thung hoiah caeh han angaih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe caeh moe, Jacob mah a capa Joseph khaeah paek ih lawk taeng ih, Samaria prae thungah kaom Sikar, tiah kawk ih avang to phak.
  </para>
  <para style="p">
    <verse number="6" style="v" />To ahmuen ah loe Jacob mah takaeh ih tuikhaw to oh, Jesu loe kholong caeh angpho pongah tuikhaw nuiah anghnut: to naah atue tarukto thuemtham oh boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Samaria nongpata maeto loe tuidok hanah angzoh: Jesu mah anih khaeah, Naek han tui na paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />(A hnukbang kaminawk loe buh qan hanah avang ah caeh o.)
  </para>
  <para style="p">
    <verse number="9" style="v" />Samaria nongpata mah anih khaeah, Judah kami maeto ah na oh to mah, kawbangmaw Samaria nongpata, kai khaeah naek han tui nang hnik loe? Judahnawk loe Samari kaminawk hoi angkom o ai bae, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah nongpata khaeah, Tui naek han na paek ah, tiah nang khaeah lokthui kami, Sithaw ih tangqum to na panoek soe nahaeloe, nang mah ni anih khaeah na hni ueloe, anih mah hinghaih tui to na paek tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nongpata mah anih khaeah, Patukkung, nang loe tui sohhaih tidoeh na tawn ai, tuikhaw loe thuk parai bae: to hinghaih tui loe naa hoiah maw na hnu tih?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang loe kaicae ampa Jakob pongah na len kue maw? Anih loe angmah doeh, a caanawk hoi a pacah ih moinawk mah doeh naek o ih, tuikhaw to kaicae hanah ang paek, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu mah anih khaeah, Mi kawbaktih doeh hae tui nae kami loe tui anghae let tih:
  </para>
  <para style="p">
    <verse number="14" style="v" />toe mi kawbaktih doeh anih ka paek han koi tui nae kami loe, natuek naah doeh tui anghae mak ai boeh; anih ka paek han koi tui loe, anih thungah kalong dungzan kahing tuibap ah om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nongpata mah anih khaeah, Patukkung, tui kang haeh han ai, haeah tuidok han ai ah, to tui to na paek khae, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu mah anih khaeah, Caeh ah loe, na sava to kawk pacoengah, haeah angzo ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah nongpata mah, Sava ka tawn ai, tiah a naa. Jesu mah nongpata khaeah, Sava ka tawn ai, tiah na thuih ih lok loe amsoem:
  </para>
  <para style="p">
    <verse number="18" style="v" />sava pangato na tawnh boeh; vaihi na tawnh ih nongpa doeh na sava na ai ni: na thuih ih lok loe amsoem, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nongpata mah anih khaeah, Patukkung, nang loe tahmaa maeto ah na oh, tito kang panoek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaicae ampanawk loe hae mae ah sithaw bok o; nangcae mah loe Jerusalem ah ni kaminawk mah Sithaw bok han oh, tiah na thuih o, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu mah anih khaeah, Nongpata, Kai hae na tang ah, hae mae ah na ai, Jerusalem ah doeh na ai ah, Pa na bok o haih atue to phak tom boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangcae loe na panoek o ai ih hmuen to na bok o: kaicae loe panoek ih hmuen to ni ka bok o: pahlonghaih loe Judahnawk ih ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe Sithaw bok kaminawk mah Pa to Muithla hoi loktang ah bokhaih atue to pha tih, vaihi doeh phak boeh: Ampa loe to tiah Anih bok kaminawk to ni pakrong.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sithaw loe Muithla ah oh: Anih bok kaminawk loe Muithla hoi loktang ah bok o han oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nongpata mah anih khaeah, Kri, tiah kawk ih Messiah angzo tih, tito ka panoek: anih angzoh naah loe kaicae hanah hmuennawk to thui boih tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />To naah Jesu mah anih khaeah, Nang khaeah lokthui Kai loe Anih to boeh ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To nathuem ah a hnukbang kaminawk to phak o, nongpata hoi lok kapae Anih to hnuk o naah dawnrai o: toe mi mah doeh timaw na koeh? To tih ai boeh loe tikhoe nongpata hoiah lok na paeh loe? tiah dueng o ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />To nongpata loe tui laom to caehtaak moe, avang thungah caeh pacoengah, kaminawk khaeah,
  </para>
  <para style="p">
    <verse number="29" style="v" />angzo oh loe, ka sak ih hmuennawk boih thui kami to khen oh: hae kami loe Kri na ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kaminawk loe avang thung hoiah tacawt o moe, anih khet hanah caeh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />To naah a hnukbang kaminawk mah, Patukkung, buhcaa raeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe anih mah nihcae khaeah, Na panoek o ai ih buhcaak han ka tawnh, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pongah a hnukbang kaminawk mah, Kami maeto mah caak han buh sinh pae mue, tiah maeto hoi maeto thuih o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah nihcae khaeah, Kai patoehkung koehhaih to sak moe, anih ih tok sak pacoeng pae haih loe, Kai ih buh ah oh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Khrah palito pacoengah loe cang aah han khawt boeh, tiah na thuih o na ai maw? Khenah, kang thuih o, Mikpadai oh loe, lawknawk ho khen o noek ah; caang aah han hmin boeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cang aat kami loe atho to hnuk moe, dungzan hing hanah athaih to pakhrik: to naah ni caang tuh kami hoi aat kami to anghoe hoi hmaek tih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kami maeto mah patit moe, maeto mah aah, tiah thuih ih lok loe amsoem.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tok na sah o ai ih lawk ah cang aah hanah kang patoeh o: kalah kaminawk mah toksak o, nangcae loe nihcae toksakhaih thungah na kun o, tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nongpata mah, Ka sak ih hmuennawk ang thuih boih, tiah thuih pongah to avang thung ih paroeai Samaritan kaminawk mah Anih to tang o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Samaritan kaminawk anih khaeah caeh o naah, nihcae khaeah cam pae hanah Anih to tahmenhaih hnik o, to pongah nihcae khaeah ni hnetto a cam pae.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anih mah thuih ih lok pongah paroeai kaminawk mah tanghaih to tawnh o;
  </para>
  <para style="p">
    <verse number="42" style="v" />nihcae mah to nongpata khaeah, Nang mah thuih ih lok pongah na ai ni, kaimacae khaeh mah anih ih lok to ka thaih o moe, hae kami loe long pahlongkung, Kri ni, tiah ka panoek o pongah ni, vaihi ka tang o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="43" style="v" />Toah ni hnetto cam pacoengah, Kalili bangah a caeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tahmaa loe angmah prae ah pakoeh ah om vai ai, tiah Jesu angmah khaeh mah thuih.
  </para>
  <para style="p">
    <verse number="45" style="v" />Anih Kalili ah phak naah, Kalili kaminawk mah anih to dawt o, nihcae doeh poihkung ah caeh o toeng, Jerusalem poihkung ah Anih mah sak ih hmuennawk to nihcae mah hnuk o boih.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jesu loe tui misurtui ah angcoengsakhaih, Kalili prae thung ih Kana avang ah caeh let. Kapernuam avang ah a capa nganna angraeng maeto oh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Anih mah Jesu Judea prae hoi Kalili prae ah angzoh ti, tiah thaih naah, anih khaeah caeh moe, kadueh duih a capa to ngantuisak hanah tahmenhaih hnik.
  </para>
  <para style="p">
    <verse number="48" style="v" />Jesu mah anih khaeah, Dawnrai hmuen hoi angmathaihnawk na hnu o ai ah loe, na tang o mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="49" style="v" />To naah angraeng mah anih khaeah, Angraeng, ka capa dueh ai naah angzo tathuk raeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu mah anih khaeah, Caeh lai ah, na capa loe ngantui boeh, tiah a naa. Jesu mah thuih ih lok to a tang pongah, anih loe angmah im ah amlaem.
  </para>
  <para style="p">
    <verse number="51" style="v" />Loklam ah a caeh li naah, a tamnanawk angzoh o moe, anih khaeah, Na capa loe ngantui boeh, tiah thuih pae o.
  </para>
  <para style="p">
    <verse number="52" style="v" />Natuek naah maw a capa ngantui let, tiah a dueng naah, Cangduem atue sarihto naah ngantui let, tiah a thuih pae o.
  </para>
  <para style="p">
    <verse number="53" style="v" />To atue nathuem ah ni, Jesu mah anih khaeah, Na capa loe ngantui boeh, tiah a thuih pae, tito ampa mah panoek; to pongah angmah hoi a imthung takoh kaminawk boih mah tang o.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hae loe Jesu mah Judea prae hoi Kalili prae ah caeh naah, sak ih dawnrai hmuen vai hnetto haih ah oh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Judahnawk ih poih to oh; to naah Jesu loe Jerusalem ah caeh tahang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jerusalem vangpui ih tuu khongkha taengah, Hebru lok hoi Bethesda, tiah kawk ih tuili maeto oh, toah imphu kaom anghakhaih ahmuen pangato oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />To ahmuen ah mikmaeng, khokkhaem, kangoi hoi nganna kaminawk angsong o mangh moe, kangphui tui to a zing o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Atue atue naah van kami to angzoh tathuk moe, tui to angphuisak: mi kawbaktih doeh tui angphui naah lungpung hmaloe loe a tawnh ih kawbaktih nathaih doeh hoih.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah saning quithumto pacoeng, tazetto kangoi kami maeto tui taengah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu mah to kami loe saning paroeai kasawk ah to ahmuen ah angsong boeh, tito panoek naah, anih mah to kami khaeah, Ngantui han na koeh maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nganna kami mah anih khaeah, Angraeng, tui angphui naah kai tui thungah va kami om ai: kang thawk moe, ka caeh li naah, kalah kaminawk ka hma ah lungpung o ving boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu mah anih khaeah, Angthawk ah, nangmah ih nambaih to la ah loe, caeh laih, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Akra ai ah to kami to ngantui roep, angmah ih kahni to lak moe, a caeh: to na ni loe Sabbath ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah Judahnawk mah ngantui kami khaeah, Vaihni loe Sabbath niah oh: kahni lak han daan na ai ni, tiah a naa o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe anih mah nihcae khaeah, Kai ngantuisak kami mah, kai khaeah, nangmah ih kahni to la ah loe, caeh laih, tiah ang naa, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah nihcae mah anih khaeah, Nangmah ih kahni to la ah loe, caeh laih, tiah thui kami loe mi aa? tiah dueng o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu loe toah kangpop paroeai kaminawk salakah caeh ving boeh pongah, ngantui kami mah anih loe mi kawbaktih maw, tito panoek ai boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pacoengah Jesu mah anih to tempul thungah hnuk, anih khaeah, Khenah, ngan na tui boeh: zaehaih sah let hmah lai ah, to tih ai nahaeloe kanung aep hmuen na nuiah pha tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />To kami loe caeh moe, anih ngantuisak kami loe Jesu ni, tiah Judahnawk khaeah thuih pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu mah Sabbath niah to baktih hmuennawk sak pongah, Judahnawk mah Jesu to pacaekthlaek moe, hum hanah pacaeng o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe Jesu mah nihcae khaeah, Kam Pa loe vaihi khoek to toksak vop, to pongah kai doeh tok ka sak toeng, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih loe Sabbath ni to zaa ai khue na ai ah, Sithaw loe Kam Pa ni, tiah thui moe, angmah hoi angmah to Sithaw hoi kangvan ah suek pongah, Judahnawk mah anih to hum hanah pacaeng o aep.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu mah nihcae khaeah hae tiah lok pathim pae, Loktang to, loktang ah, Kang thuih o, Ampa mah sak ih hmuen hnu ai ah, Capa loe angmah koeh ah tidoeh sah thai ai: ampa mah sak ih hmuennawk baktih toengah ni, Capa mah doeh sak toeng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ampa mah Capa to palung pongah, a sak ih hmuennawk boih to anih hanah patuek: na dawnrai o hanah, hae hmuennawk pongah kalen kue anih han patuek vop tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ampa mah kadueh kaminawk to pathawk moe, nihcae han hinghaih paek baktih toengah, Capa mah doeh angmah koeh ih kaminawk khaeah hinghaih to paek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ampa loe mi doeh lokcaek ai, lokcaekhaih to Capa khaeah paek boih boeh:
  </para>
  <para style="p">
    <verse number="23" style="v" />Ampa to saiqat o baktih toengah, Capa to kami boih mah saiqat o thai hanah to tiah paek. A Capa saiqat ai kami loe, anih patoehkung ampa doeh saiqat ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Loktang to, loktang ah, Kang thuih o, Ka lok hae tahngai moe, kai patoehkung Anih to tang kami loe, dungzan hinghaih to tawnh boeh pongah, lokcaekhaih tong mak ai; duekhaih thung hoiah a poeng boeh moe, hinghaih thungah akun boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Loktang to, loktang ah, Kang thuih o, Kadueh kaminawk mah Sithaw Capa ih lok to thai o tih: lok thaih kaminawk loe hing o tih, to baktih atue to angzo tih, vaihi doeh angzoh boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ampa loe angmah ah hinghaih to tawnh boeh, to baktih toengah Capa mah doeh angmah ah hinghaih tawnh hanah ampa mah paek boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih loe Kami Capa ah oh pongah, lokcaek thaihaih doeh anih hanah paek boeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae pongah dawnrai o sak hmah: taprong thung kaom kaminawk boih mah anih ih lok thaihaih atue to pha tih,
  </para>
  <para style="p">
    <verse number="29" style="v" />kahoih hmuen sah kaminawk loe, hinghaih to toep hanah, angthawk o let ueloe, kasae hmuen sah kaminawk doeh, lokcaekhaih hnuk hanah, angthawk o let tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai loe kaimah koeh ah tidoeh sah thai ai: ka thaih ih baktih toengah lok ka caek: kaimah koehhaih to ka pakrong ai, kai patoehkung Pa koehhaih to ni ka pakrong, to pongah ka lokcaekhaih loe amsoem.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaimah hoi kaimah hnukung ah ka oh nahaeloe, hnukung ah ka ohhaih to amsoem mak ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe kai hnukung kalah maeto oh; anih mah kai hnukung ah ohhaih lok loe amsoem, tiah ka panoek.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih loe loktang hnukung ah oh pongah, Johan khaeah kami na patoeh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Toe kami mah thuih ih hnukung ah ohhaih to ka tapom ai: toe pahlonghaih na hnuk o thai han ih ni hae loknawk hae ka thuih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Johan loe kangqong, aanghaih paekkung hmai-im ah oh: nangcae loe anih aanghaih thungah nawnetta thung khue anghoe han ih ni na koeh o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toe kai loe Johan pong kalen kue hnukung to ka tawnh: kai loe toksak pacoeng hanah Pa mah ang paek ih toknawk to ni ka sak, to toknawk loe Pa mah ang patoeh, tiah hnukung ah oh o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kai patoehkung, Pa loe kai hnukung ah oh. Nangcae mah loe anih ih lok to na thaih o vai ai, anih ih krang doeh na hnu o vai ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nangcae thungah anih ih lok om ai pongah, anih mah patoeh ih kami to na tang o ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nangcae dungzan hinghaih loe Cabu thungah oh, tiah na poek o pongah, Cabunawk to na khet o; to Cabunawk loe kai kawng thuikung ah ni oh o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Toe hinghaih na hnuk o hanah, kai khaeah angzoh han na koeh o ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kai loe kaminawk pakoehhaih to tiah doeh ka poek ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Toe nangcae thungah Sithaw amlunghaih om ai, tito ka panoek.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kai loe kam Pa ih ahmin hoiah ni kang zoh, toe kai to nang talawk o ai: angmah ih ahmin hoiah kalah kami to angzo nahaeloe, anih to na talawk o tih.
  </para>
  <para style="p">
    <verse number="44" style="v" />Sithaw khae khue hoiah angzo pakoehhaih to pakrong ai ah, kami maeto hoi maeto pakoehhaih to na koeh o pongah, kawbangmaw na tang o thai tih?
  </para>
  <para style="p">
    <verse number="45" style="v" />Kai mah Pa hmaa ah nangcae zaehaih net tih, tiah poek o hmah: nangcae zaehaih net kami loe na oep o ih, Mosi ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosi na tang o nahaeloe, kai doeh nang tang o tih: anih loe kai kawng ni tarik.
  </para>
  <para style="p">
    <verse number="47" style="v" />Toe anih mah tarik ih loknawk to na tang o ai nahaeloe, kawbangmaw ka thuih ih loknawk to na tang o thai tih? tiah a naa.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jesu loe Kalili tuipui yaeh ah kaom, Tiberia tuipui ah caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nathaih tawn kaminawk nuiah a sak ih dawnrai hmuen to hnuk o pongah, paroeai kaminawk anih hnukah bang o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu loe mae nuiah dawh moe, a hnukbang kaminawk hoi nawnto anghnut.
  </para>
  <para style="p">
    <verse number="4" style="v" />Judahnawk ih misong loihhaih poih loe, zoi boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu mah doeng tahang naah, anih khaeah angzo paroeai kaminawk to hnuk, to naah anih mah Philip khaeah, Hae kaminawk caak o hanah naa ah maw takaw a qan o han? tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah a sak han koi hmuen to panoek boeh, toe Philip to tanoek hanah hae lok hae a thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Philip mah anih khaeah, denari cumvai hnetto tho takaw qan cadoeh nihcae han khawt mak ai, kami maeto mah zetta ni hak o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hnukbang kami maeto, Simon Piter ih amnawk Andru mah, anih khaeah,
  </para>
  <para style="p">
    <verse number="9" style="v" />Barley cang hoi sak ih takaw pangato hoi tanga tetta katawn nawkta maeto haeah oh: toe kami hae zetto hanah loe tiah maw angcoeng tih? tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mahkaminawk anghnu o sak ah, tiah a naa. To ahmuen loe paroeai phroh pop ahmuen ah oh. Sang pangato thuemtham kaom kaminawk loe phroh nuiah anghnut o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu mah takaw to lak moe, kawnhaih lawkthuih pacoengah, hnukbang kaminawk khaeah a paek; hnukbang kaminawk mah toah anghnu kaminawk hanah pazet pae o; to baktih toengah tanga doeh kaminawk zok amhah hanah a paek.
  </para>
  <para style="p">
    <verse number="12" style="v" />To kaminawk zok amhah o pacoengah, Anih mah a hnukbang kaminawk khaeah, Caaknoinawk to phrom oh, tidoeh anghmat o sak hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaminawk mah zok amhah ah caak o pacoengah, barley takaw pangato hoiah kamtlai caaknoinawk to a phrom o naah, benthang hatlai hnetto koi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu mah sak ih dawnrai hmuen to pop parai kaminawk mah hnuk o naah, Hae kami loe long nuiah angzo han koi Tahmaa tangtang boeh ni, tiah thuih o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nihcae angzo o ueloe, anih to Siangpahrang ah om o sak nganga tih, tiah Jesu mah panoek naah, angmah bueng mae ah oh hanah caehtaak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aduem bang phak naah, a hnukbang kaminawk loe tuipui ah caeh o tathuk,
  </para>
  <para style="p">
    <verse number="17" style="v" />palong thungah akun o moe, Kapernuam avang ah caeh o. Khoving boeh, toe Jesu loe nihcae khae pha ai vop.
  </para>
  <para style="p">
    <verse number="18" style="v" />Takhi sae song pongah tuiphu angthawk tahang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae mah meng thumto maw, to tih ai boeh loe meng palito maw palong mong o pacoengah, palong ohhaih bangah tuipui nuiah kacaeh Jesu to nihcae mah hnuk o; nihcae loe zit o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe Anih mah nihcae khaeah, Zii o hmah; Kai ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah nihcae mah Anih to palong thungah akun o sak: akra ai ah palong hoiah caeh han amsak o ih ahmuen to a phak o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khawnbang phak naah, tuipui yaeh ah angdoe kaminawk loe a hnukbang kaminawk mah angthueng o ih palong khue ai ah loe, toah kalah palong om ai boeh, tito panoek o, a hnukbang kaminawk loe angmacae bueng ni caeh o, Jesu loe a hnukbang kaminawk hoi nawnto palong thungah akun ai;
  </para>
  <para style="p">
    <verse number="23" style="v" />(toe kalah palongnawk loe Angraeng mah kawnhaih lawkthuih pacoengah, nihcae takaw caakhaih ahmuen taengah Tiberia bang hoiah angzoh o:)
  </para>
  <para style="p">
    <verse number="24" style="v" />to ih kaminawk mah Jesu hoi a hnukbang kaminawk to ih ahmuen ah om o ai boeh, tiah panoek o naah, palong to angthueng o moe, Jesu pakrong hanah, Kapernuam vangpui bangah caeh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae mah tuipui yaeh ah Anih to hnuk o naah, nihcae mah anih khaeah, Rabbi, natuek naah haeah na phak loe? tiah dueng o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu mah nihcae khaeah, Loktang to, loktang ah, kang thuih o, dawnrai hmuennawk na hnuk o pong na ai ah, zok kamhah ah takaw na caak o pongah ni, kai nang pakrong o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ampa Sithaw mah Anih nuiah catui daeng boeh pongah, Kamro koi buh hak hanah toksah o hmah, Kami Capa mah nangcae han paek han ih dungzan hinghaih hnuk hanah, tok to sah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae mah anih khaeah, Sithaw mah koeh ih tih tok maw ka sak o han? tiah dueng o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu mah nihcae khaeah, Anih mah patoeh ih Kami tang hae Sithaw ih tok boeh ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nihcae mah anih khaeah, Ka hnuk o moe, kang tang o hanah, kawbaktih angmathaih maw nang patuek han? Tih tok maw na sak han? tiah a naa o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aicae ampanawk mah praezaek ah manna to caak o; nihcae mah caak o hanah, Anih mah van bang hoiah takaw to paek, tiah tarik ih oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu mah nihcae khaeah, Loktang to, loktang ah, kang thuih o, Mosi mah nangcae han van hoiah takaw to paek ai; Kam Pa mah ni van hoiah takaw tangtang to ang paek o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Van hoiah angzo tathuk, long hinghaih paek Anih loe Sithaw ih takaw ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nihcae mah anih khaeah, Angraeng, to takaw to kaicae han na paek poe ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesu mah nihcae khaeah, Kai loe hinghaih takaw ah ka oh: mi kawbaktih doeh kai khaeah angzo kami loe zok amthlam mak ai; kai tang kami loe natuek naah doeh tui anghae mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toe kang thuih o baktih toengah, Kai nang hnuk o boeh, toe nang tang o ai vop.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pa mah kai hanah paek ih kaminawk boih, Kai khaeah angzo o tih; kai khae angzo kami loe ka haek mak ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ka koehhaih sak han ih na ai ah, kai patoehkung koehhaih sak han ih ni, van hoiah kang zoh tathuk.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kai hanah ang paek ih kaminawk boih mi doeh anghmaa ai ah, hnukkhuem niah pathawk let han ih tok loe, kai patoehkung Pa koehhaih ah oh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mi kawbaktih doeh Capa to hnu moe, anih tanghaih tawn kami loe dungzan hinghaih tawn tih, hae loe kai patoehkung Anih koehhaih ah oh: hnukkhuem niah anih to kang thawksak let han, tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kai loe van hoiah angzo takaw ah ka oh, tiah a thuih pongah, Judah kaminawk mah anih to laisaep o thuih.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nihcae mah, Hae kami loe Joseph capa, Jesu na ai maw? Anih ih amno hoi ampa doeh ka panoek o, kawbangmaw anih mah, Kai loe van hoiah ni kang zoh tathuk, tiah a thuih halat loe? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="43" style="v" />To pongah Jesu mah nihcae khaeah, Laisaep o hmah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hnukkhuem niah anih kang thawksak let hanah, Kai patoehkung Pa mah anih to ze ai nahaeloe, mi doeh kai khaeah angzo thai mak ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tahmaanawk ih Cabu thungah Sithaw mah nihcae to patuk boih tih, tiah tarik ih oh. To pongah mi kawbaktih doeh Pa ih lok to tahngai moe, anih khaeah amtuk kami loe, kai khaeah angzoh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Sithaw khae hoi angzo kami ai ah loe, mi mah doeh Pa to hnu vai ai, Anih khue mah ni Pa to hnuk.
  </para>
  <para style="p">
    <verse number="47" style="v" />Loktang to, loktang ah, Kang thuih o, mi kawbaktih doeh kai tang kami loe dungzan hinghaih to tawnh boeh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kai loe hinghaih takaw ah ka oh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Nam panawk loe praezaek ah manna to caak o moe, duek o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hae loe van hoiah angzo tathuk takaw ah oh, mi kawbaktih doeh to takaw caa kami loe dueh mak ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Kai loe van hoiah angzo tathuk hinghaih takaw ah ka oh: mi kawbaktih doeh hae takaw caa kami loe, dungzan ah hing tih: long mah hinghaih tawnh hanah, ka paek han koi takaw loe ka ngan hae boeh ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="52" style="v" />To pongah Judahnawk angmacae salakah lok angaekhaih to oh, Kawbangmaw hae kami mah caak hanah angmah ih ngan to aicae han paek thai tih? tiah a thuih o.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesu mah nihcae khaeah, Loktang to, loktang ah, Kang thuih o, Kami capa ih ngan to caak moe, anih ih athii to nae ai ah loe, a thungah hinghaih na tawn o mak ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Mi kawbaktih doeh ka ngan to caa moe, ka thii to nae kami loe, dungzan hinghaih to tawnh; hnukkhuem niah anih to kang thawksak let han.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ka ngan loe buh tangtang ah oh moe, ka thii loe naek koi hmuen tangtang ah oh.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ka ngan to caa moe, ka thii to nae kami loe, anih kai thungah oh, kai doeh anih thungah oh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Kahing Pa mah ni Kai hae ang patoeh, Kai loe Pa rang hoiah ka hingh; to pongah kai caa kami loe kai rang hoiah hing tih.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hae loe van hoiah angzo tathuk takaw ah oh: nam panawk mah manna to caak o moe, duek o baktih na ai ah, hae takaw caa kami loe dungzan ah hing tih.
  </para>
  <para style="p">
    <verse number="59" style="v" />Hae loknawk loe Kapernuam avang ih sineko thungah patuk naah thuih.
  </para>
  <para style="p">
    <verse number="60" style="v" />A hnukbang paroeai kaminawk mah hae lok to thaih o naah, a thuih ih lok loe rai parai; mi mah maw panoek thai tih, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="61" style="v" />A hnukbang kaminawk laisaep o, tiah Jesu mah panoek naah, anih mah nihcae khaeah, Hae lok pongah palung na boeng o maw?
  </para>
  <para style="p">
    <verse number="62" style="v" />To tiah nahaeloe a oh tangsuekhaih ahmuen ah daw tahang Kami Capa na hnuk o naah cae loe, kawbangmaw na om o tih!
  </para>
  <para style="p">
    <verse number="63" style="v" />Hinghaih loe Muithla mah ni paek; taksa loe avanghaih om ai: kang thuih o ih loknawk loe Muithla ah oh pongah, hinghaih to oh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Toe nangcae thung ih thoemto kaminawk mah loe tang o ai, tiah a naa. Jesu mah loe tangsuek nathuem hoiah boeh ni, nihcae loe kawbaktih kami maw, tanghaih tawn ai kami loe mi maw, mi mah maw anih to angphat taak tih, tiah panoek coek boeh.
  </para>
  <para style="p">
    <verse number="65" style="v" />To pongah ni anih mah, Kam Pa mah anih han paek ai ah loe, mi kawbaktih doeh kai khaeah angzo thai mak ai, tiah kang thuih o, tiah a naa.
  </para>
  <para style="p">
    <verse number="66" style="v" />To nathuem hoiah loe pop parai a hnukbang kaminawk mah anih to angqoi o taak boih, anih hoi nawnto caeh o ai boeh.
  </para>
  <para style="p">
    <verse number="67" style="v" />Jesu mah hatlai hnettonawk khaeah, Nangcae doeh angqoi ving han na koeh o maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="68" style="v" />Simon Piter mah anih khaeah, Angraeng, na lok ah ni dungzan hinghaih to oh, mi khaeah maw ka caeh o han?
  </para>
  <para style="p">
    <verse number="69" style="v" />Nang loe kahing Sithaw Capa, Kri ni, tiah kang panoek o moe, kang tang o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="70" style="v" />Jesu mah nihcae khaeah, Kaimah na ai maw nangcae hatlai hnettonawk to kang qoih? Toe nangcae thung ih kami maeto loe taqawk sae ah oh ving, tiah a naa.
  </para>
  <para style="p">
    <verse number="71" style="v" />Simon capa Juda Iskariot to thuih koehhaih ih ni: anih loe hatlai hnetto thungah kathum maeto ah oh, toe hnukhuem ah loe Jesu to angphat taak ving.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jesu loe Kalili prae ah caeh: Judahnawk mah anih hum han pakrong o pongah, Judah prae thungah amkaeh han koeh ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Judahnawk ih Kahni im poih sakhaih atue loe zoi boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah anih ih nawkamyanawk mah anih khaeah, Hae ahmuen hoiah tacawt ah loe, Judah prae ah caeh ah, to naah ni na sak ih dawnrai hmuennawk to na hnukbang kaminawk mah hnu o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahmin amthang han koeh kami loe tamquta hoiah hmuen to sah vai ai. Hae hmuennawk hae na sak pongah, nangmah hoi nangmah to long kaminawk khaeah amtuengsak ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angmah ih nawkamyanawk mah mataeng doeh Jesu to tang o ai vop.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu mah nihcae khaeah, Kai ih atue pha ai vop: toe nangcae ih atue loe phak boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Long mah nangcae hnuma thai mak ai; a sak o ih kasae hmuennawk to ka thuih pongah, Kai ni ang hnukma o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangcae loe to poihkung ah caeh oh: kai ih atue pha ai vop pongah, to poihkung ah ka caeh mak ai vop, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae khaeah hae lok a thuih pae pacoengah, anih loe Kalili ah oh vop.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toe angmah ih nawkamyanawk poihkung ah caeh o pacoengah loe, anih doeh poihkung ah caeh toeng, toe minawk panoeksak ai, tamquta ah ni a caeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Judahnawk mah poihkung ah anih to pakrong o, Anih loe naa ah maw oh? tiah dueng o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amkhueng kaminawk loe anih kawng to angaek o: thoemto kaminawk mah, Anih loe hoih, tiah thuih o: kalah kaminawk mah loe, Hoih ai, anih loe kaminawk to aling, tiah thuih o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe Judahnawk zit o pongah, mi mah doeh anih kawng to kamtuengah thui o ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Poih a um phak naah, Jesu loe tempul ah dawh tahang moe, kaminawk to patuk.
  </para>
  <para style="p">
    <verse number="15" style="v" />Judahnawk loe dawnrai o, hae kami loe ca doeh amtuk ai to mah, kawbangmaw ca panoek halat? tiah thuih o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu mah nihcae khaeah, Kang patuk o ih lok loe Kai ih lok na ai, Kai patoehkung ih lok ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih koehhaih sak koeh kami mah loe, ka patuk ih lok hae Sithaw ih lok maw, to tih ai boeh loe kaimah kaa ah patuk ih lok, tito panoek thaihaih to tawn tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angmah koeh ah lokthui kami loe, a lensawkhaih hnuk han ih ni a thuih: toe Anih patoehkung lensawkhaih pakrong Kami loe, loktang ah oh, Anih loe alinghaih lok to thui ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosi mah kaalok ang paek o na ai maw, tipongah maeto mah doeh na pazui o ai moe, tikhoe kai hum hanah nang pakrong o loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaminawk mah, Nang loe taqawk na tawnh: mi mah maw nang hum han pakrong? tiah a naa o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu mah nihcae khaeah, Hmuen maeto ka sak naah, dawn na rai o boih.
  </para>
  <para style="p">
    <verse number="22" style="v" />To pongah Mosi mah tangzat hin aah hanah lok ang paek o (Mosi khae hoi angzo ai, ampanawk khae hoiah ni angzoh); Sabbath niah nawkta tangzat hin na aah o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sabbath niah nawkta tangzat hin na aah o naah, Mosi ih kaalok aek kami ah na om o ai to mah, tikhoe Sabbath niah nganna kaminawk ngan ka tuisak naah, ka nuiah palung na phui o loe?
  </para>
  <para style="p">
    <verse number="24" style="v" />Anui phawn khet hoiah lokcaek o hmah, toenghaih hoiah lokcaek oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah Jerusalem ih thoemto kaminawk mah, Nihcae mah hum han pakrong o ih kami loe Anih hae na ai maw?
  </para>
  <para style="p">
    <verse number="26" style="v" />Khenah, Anih loe misahoihaih hoiah lok a thuih, nihcae mah Anih to kawbang doeh naa o ai. Hae Kami loe Kri tangtang boeh ni, tiah ukkungnawk mah panoek o maw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kri angzoh naah, Anih loe naa hoiah maw angzoh, tito mi mah doeh panoek mak ai, toe hae kami loe naa ih kami maw, tito ka panoek o, tiah thuih o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu mah tempul thungah patuk naah, Nangcae mah Kai nang panoek o: toe Kai loe kaimah koeh ah kang zo ai, Kai patoehkung loe loktang ah oh, Anih to na panoek o ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih mah Ang patoeh moe, Anih khae hoi Kang zoh pongah, Anih to Ka panoek, tiah tha hoi a hangh.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pongah nihcae mah Jesu naehhaih loklam to pakrong o: toe Anih ih atue pha ai vop pongah, Anih to mi mah doeh naeh o ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Paroeai kaminawk mah Anih to tang o moe, Kri angzoh naah loe, hae Kami mah sak ih pong pop kue ah anih mah dawnrai hmuennawk to sah tih maw? tiah thuih o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu kawng angaek kaminawk ih lok Farasinawk mah thaih o naah, Farasinawk hoi kalen koek qaima mah Anih to naeh hanah, tempul thungah toksah kaminawk to patoeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jesu mah nihcae khaeah, Nangcae khaeah atue setta thung ni ka oh han boeh, to pacoengah loe Kai patoehkung khaeah Ka caeh han boeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kai nang pakrong o tih, toe nang hnu o mak ai: nangcae loe ka ohhaih ahmuen ah nang zo o thai mak ai, tiah thuih pae.
  </para>
  <para style="p">
    <verse number="35" style="v" />To naah Judahnawk mah, Aicae mah anih hnuk han ai ah, naa ah maw caeh han thuih? Maeto hoi maeto ampraek Gentelnawk khaeah caeh moe, Gentelnawk patuk han ih maw a thuih?
  </para>
  <para style="p">
    <verse number="36" style="v" />Kai nang pakrong o tih, toe nang hnu o mak ai: nangcae loe ka ohhaih ahmuen ah nang zo o thai mak ai, tiah thuih ih lok loe tih thuih koehhaih ih maw vai? tiah thuih o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kalen poihsakhaih hnukkhuem koek niah, Jesu angdoet moe, Mi kawbaktih doeh tui anghae kami loe, Kai khaeah angzo nasoe loe, nae nasoe.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mi kawbaktih doeh Kai tang kami loe, Cabu mah thuih ih lok baktih toengah, anih ih takoh thung hoiah hinghaih tuipui to long tih, tiah tha hoi hang moe, lok a thuih.
  </para>
  <para style="p">
    <verse number="39" style="v" />(Toe to lok loe, Anih tang kaminawk mah hnuk han ih Muithla, thuih koehhaih ih ni: Jesu loe lensawkhaih hoi pakoeh ah om ai vop pongah, Kacai Muithla to paek ai vop).
  </para>
  <para style="p">
    <verse number="40" style="v" />Paroeai kaminawk mah a lok to thaih o naah, Hae kami loe Tahmaa tangtang boeh ni, tiah thuih o.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kalah kaminawk mah loe, Hae kami loe Kri ni, tiah thuih o. Toe thoemto kaminawk mah loe, Kalili hoiah Kri angzo tih maw?
  </para>
  <para style="p">
    <verse number="42" style="v" />Cabu mah, Kri loe David ih atii hoiah angzo tih, David ohhaih Bethlehem vangpui hoiah ni angzo tih, tiah thuih ih lok oh na ai maw? tiah thuih o.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih pongah kaminawk ampraek o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Thoemto kaminawk mah anih to naeh han koeh o; toe mi mah doeh anih to naeh o ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tempul ah toksah kaminawk loe Farasinawk hoi kalen koek qaima khaeah amlaem o let, to naah nihcae mah tikhoe Jesu nang zo o haih ai loe? tiah naa o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Tempul ah toksah kaminawk mah, Hae kami baktiah lokthui kami mi doeh om vai ai vop, tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="47" style="v" />Farasinawk mah nihcae khaeah, Nangcae doeh ang ling o boeh maw?
  </para>
  <para style="p">
    <verse number="48" style="v" />Ukkungnawk, to tih ai boeh loe Farasinawk thungah Anih mah thuih ih lok tang kami oh o maw?
  </para>
  <para style="p">
    <verse number="49" style="v" />Kaalok panoek ai haeah amkhueng kaminawk loe tangoenghaih tongh o boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="50" style="v" />(Nihcae ih kami maeto ah kaom, khoving naah Jesu khaeah kacaeh), Nikodemu mah nihcae khaeah,
  </para>
  <para style="p">
    <verse number="51" style="v" />aicae ih daan pongah kami maeto mah sak ih hmuen to panoek ai, a thuih ih lok doeh thaih ai ah lokcaek thai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="52" style="v" />To naah nihcae mah anih khaeah, Nang doeh Kalili ih kami ah maw na oh? Pakrongah loe khenah: Kalili hoiah tahmaa tacawt vai ai vop, tiah a naa o.
  </para>
  <para style="p">
    <verse number="53" style="v" />To kaminawk loe angmacae im ah caeh o boih.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu loe Olive mae ah caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih loe khawnbang khawnthaw ah tempul ah caeh let, to naah kaminawk boih anih khaeah angzoh o; anih loe anghnut moe, nihcae to patuk.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah ca tarik kaminawk hoi Farasinawk mah sava laep ah zaehaih sah nongpata maeto anih khaeah hoih o; kaminawk salakah nongpata to angdoet o sak pacoengah,
  </para>
  <para style="p">
    <verse number="4" style="v" />nihcae mah Jesu khaeah, Patukkung, zaehaih sak li naah hae nongpata hae ka naeh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi ih kaalok baktiah, hae baktih nongpata loe thlung hoi vah maat han oh: toe nangmah loe kawbangmaw na poek? tiah a naa o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih to zae net thai hanah, nihcae mah Anih to tanoek o. Toe Jesu loe lu takhum moe, nihcae ih lok thaih ai baktiah banpazung hoiah long ah ca tarik.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae mah boeng ai ah Anih to lokdueng o pongah, Anih loe angthawk tahang moe, nihcae khaeah, Nangcae thung ih zaehaih tawn ai kami mah, nongpata to thlung hoi va o hmaloe nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih loe takhum moe, long ah ca tarik let.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae mah to lok to thaih o naah, angmacae panoekhaih palung mah angmacae zaehaih to amtuengsak pongah, kacoeh hoi kamtong boeng khoek to, maeto pacoeng maeto tacawt o boih: Jesu hoi toah nawnto angdoe nongpata khue oh hoi sut.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu angthawk naah, nongpata khue ai ah loe, mi doeh hnu ai boeh. Anih mah nongpata khaeah, Nongpata, Nang zaehaih net kaminawk loe naa ah maw caeh o boih boeh? Mi mah doeh lok na caek o ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nongpata mah, Angraeng, Mi mah doeh lok na caek o ai, tiah naa. Jesu mah nongpata khaeah, Kai mah doeh lok kang caek ai: caeh ah loe zaehaih sah let hmah lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesu mah nihcae khaeah lokthuih let, Kai loe long aanghaih ah ka oh: Ka hnukah bang kami loe, vinghaih thungah caeh mak ai, hinghaih to hnu tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Farasinawk mah anih khaeah, Nang loe nangmah hoi nangmah hnukung ah na oh; hnukung ah na ohhaih to amsoem ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu mah nihcae khaeah, Kaimah hoi kaimah hnukung ah oh cadoeh, Kai loe naa hoiah maw angzoh moe, naa ah maw ka caeh han, tito ka panoek pongah, hnukung ah ka ohhaih loe amsoem: toe nangcae loe Kai naa hoiah maw angzoh moe, naa ah maw ka caeh han, tito na panoek o ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangcae loe taksa baktiah lok na caek o; toe Kai loe mi doeh lok ka caek vai ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kai loe kaimah bueng ah ka om ai, Kai patoehkung Pa hoi nawnto ka oh pongah, lok ka caek aep to mah, ka lokcaekhaih loe amsoem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kami hnetto mah thuih ih lok loe amsoem, tiah nangmacae ih daan thungah tarik ih oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai loe kaimah hoi kaimah hnukung ah Ka oh, Kai patoehkung Pa doeh Kai hnukung ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />To naah nihcae mah anih khaeah, Nam pa loe naa ah maw oh? tiah dueng o. Jesu mah, Kai doeh Kam Pa doeh na panoek o ai: Kai nang panoek o soe nahaeloe, kam Pa doeh na panoek o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hae lok loe Jesu mah tempul thung ih phoisa bawm suekhaih taengah patuk nathuem ah thuih pae ih lok ah oh: angmah ih atue pha ai vop pongah, mi mah doeh anih to naeh o ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu mah nihcae khaeah lokthuih pae let, Kai loe ka caeh ving han boeh, kai nang pakrong o tih, toe nangmacae zaehaih pongah na dueh o tih: ka caehhaih ahmuen ah nang zo o thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Judahnawk mah, Ka caehhaih ahmuen ah nang zo o thai mak ai, tiah a thuih pongah, angmah hoi angmah anghum han thuih kalang mue, tiah poek o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe anih mah nihcae khaeah, Nangcae loe atlim bang ih kami ah na oh o; kai loe ranui bang ih kami ah ni ka oh: nangcae loe hae long kami ah na oh o; kai loe hae long kami na ai ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah kang thuih o, Na zae o haih pongah na dueh o tih: Kai loe Anih to boeh ni, tiah na tang o ai nahaeloe, nangmacae zaehaih pongah na dueh o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae mah anih khaeah, Nang loe mi aa? tiah dueng o. Jesu mah nihcae khaeah, Kai loe tangsuek nathuem hoi kang thuih o khing ih kami ah ka oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lok thuih moe, nangcae lokcaek hanah ka tawnh mangh: toe kai patoehkung loe loktang ah oh; anih khae hoi ka thaih ih hmuennawk ni long khaeah ka thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesu mah thuih ih Ampa kawng to nihcae mah thai pae o kop ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu mah nihcae khaeah, Kami Capa na takhing o naah ni, Kai loe Anih to boeh ni, kaimah bueng ah tidoeh Ka sah ai; kam Pa mah ang patuk ih loknawk ni ka thuih, tiah na panoek o vop tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kai patoehkung loe Kai hoi nawnto oh: Pa mah kaimah bueng na caehtaak sut ai; a koeh ih hmuennawk ni ka sak pae toepsoep, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih mah hae loknawk thuih naah, paroeai kaminawk mah anih to tang o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu mah Anih tanghaih tawn Judahnawk khaeah, Ka lok ah na oh o poe nahaeloe, ka hnukbang kami tangtang ah ni na oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Loktang to na panoek o ueloe, loktang mah na loih o sak tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nihcae mah anih khaeah, Kaicae loe Abraham ih atii ah ka oh o, minawk ih tamna ah ka om o vai ai: kawbangmaw na loih o tih, tiah na thuih? tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah nihcae khaeah, Loktang to, loktang ah, Kang thuih o, mi kawbaktih doeh zaehaih sah kami loe zaehaih tamna ah oh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tamna loe im ah om poe ai: toe Capa loe oh poe.
  </para>
  <para style="p">
    <verse number="36" style="v" />To pongah Capa mah na loih o sak nahaeloe, na loih o tangtang tih.
  </para>
  <para style="p">
    <verse number="37" style="v" />Abraham ih atii ah na oh o, tito ka panoek; toe nangcae thungah ka lok ohhaih ahmuen om ai pongah, kai hum hanah nang pakrong o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kai loe Kam Pa khae hoi ka hnuk ih hmuen to ni ka thuih: nangcae loe nam pa khae hoi na hnuk o ih hmuen to na sak o, tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nihcae mah anih khaeah, Abraham loe kaicae ih ampa ni, tiah pathim pae o. Jesu mah nihcae khaeah, Abraham ih caa ah na oh o nahaeloe, Abraham mah sak ih toknawk to na sak o han oh bae.
  </para>
  <para style="p">
    <verse number="40" style="v" />Toe Sithaw khae hoi ka thaih ih, loktang lok kang thuih o pongah, vaihi Kai hum hanah nang pakrong o, Abraham loe to baktih hmuen to sah ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nangcae loe nam panawk mah sak o ih hmuennawk ni na sak o, tiah a naa. Nihcae mah Anih khaeah, Kaicae loe payang caa na ai ni; kaicae loe Ampa, Sithaw maeto ni ka tawnh o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu mah nihcae khaeah, Kai loe Sithaw khae hoi tacawt kami ah ka oh, anih khae hoiah ni kang zoh; kai mah koeh ah kang zo ai, Sithaw loe nangcae Ampa ah om nahaeloe, anih mah kai ang patoeh pongah, kai hae nang palung o tih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tipongah ka thuih ih lok na thaih o kop ai loe? Ka lok na tahngai o kop ai pongah ni, kalok hae na thaih o kop ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nangcae loe nam pa taqawk ih caa ah na oh o, to pongah nam pa koehhaih sak hanah na koeh o. Anih loe tangsuek nathuem hoi boeh ni kami humkung ah oh, anih thungah loktang om ai pongah, anih loe loktang ah angdoe ai. Anih mah amsawnlok thuih naah, angmah koeh baktiah ni a thuih: anih loe lok amlai kami ah oh moe, lok amlai kaminawk ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Loktang lok ka thuih pongah, Kai nang tang o ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nangcae thungah kai zaehaih net thaih na oh o maw? Loktang bae kang thuih o, tipongah Kai nang tang o ai loe?
  </para>
  <para style="p">
    <verse number="47" style="v" />Sithaw kami loe, Sithaw ih loknawk to tahngaih: Sithaw kami ah na om o ai pongah ni, a lok na tahngai o ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="48" style="v" />Judahnawk mah anih khaeah, Taqawk na tawnh, Samaritan kami maeto ah na oh, tiah kang naa o ih lok loe amsoem, tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="49" style="v" />Jesu mah, Taqawk ka tawn ai; kam Pa to ni ka pakoeh, toe nangcae mah loe kasae nang thuih o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Kaimah hoi kaimah amkoehhaih ka pakrong ai: Ka lensawkhaih pakrong moe, lokcaek kami Maeto oh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Loktang to, loktang ah, Kang thuih o, Ka thuih ih lok pakuem kami loe, natuek naah doeh dueh mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="52" style="v" />Judahnawk mah anih khaeah, Taqawk na tawnh, tiah vaihi kang panoek o boeh. Abraham loe duek boeh moe, Tahmaanawk doeh duek o boeh; toe nang mah loe Ka lok pakuem kami loe, natuek naah doeh duekhaih hnu mak ai, tiah na thuih.
  </para>
  <para style="p">
    <verse number="53" style="v" />Nang loe kaicae ampa Abraham pongah na len kue maw? Anih loe duek boeh, tahmaanawk doeh duek o boeh: nangmah hoi nangmah to kawbangmaw na poek? tiah a naa o.
  </para>
  <para style="p">
    <verse number="54" style="v" />Jesu mah, Kaimah hoi kaimah amkoeh nahaeloe, to tiah kam koehhaih to tiah doeh angcoeng mak ai: Anih loe kaicae ih Sithaw ni, tiah na thuih o ih, Kam Pa mah ni Kai hae ang pakoeh:
  </para>
  <para style="p">
    <verse number="55" style="v" />Anih to na panoek o ai, toe kaimah loe Anih to panoek: Anih to Ka panoek ai, tiah Ka thuih nahaeloe, Kai doeh nangcae baktiah amsawnlok thui kami ah ni ka om tih: toe anih to ka panoek moe, a thuih ih lok to ka pakuem.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nangcae ampa Abraham loe Kai ih ani to hnuk hanah koeh parai: anih mah hnuk naah, paroeai anghoe, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="57" style="v" />Judahnawk mah anih khaeah, Nang loe saning quipangato mataeng doeh akoep ai vop, Abraham to na hnuk maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="58" style="v" />Jesu mah nihcae khaeah, Loktang to, loktang ah, Kang thuih o, Abraham om ai naah, Ka oh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="59" style="v" />To naah nihcae mah Anih vah hanah thlung akhui o: toe Jesu mah anghawk taak ving, paroeai kaminawk salakah a caeh moe, tempul thung hoiah tacawt ving.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu loe loklam ah caeh, to naah tapen tangsuek hoi mikmaeng kami to a hnuk.
  </para>
  <para style="p">
    <verse number="2" style="v" />A hnukbang kaminawk mah anih khaeah, Rabbi, hae kami loe angmah ih zaehaih pongah maw, to tih ai boeh loe amno ampanawk zaehaih pongah maw mik maengh? tiah dueng o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu mah, Angmah zaehaih pongah na ai, amno ampanawk zaehaih pongah doeh na ai: toe anih khaeah Sithaw toksakhaih to amtueng tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khodai naah kai patoehkung ih tok to ka sak han oh: khoving naah loe mi doeh toksah thai mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kia long ah ka oh nathung, kai loe long aanghaih ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hae loknawk a thuih pacoengah, anih mah long ah tamtui pathoih moe, long to tamtui hoiah kanaem ah pathluem; to pacoengah mikmaeng ih mik to long kanaem hoiah a nok pae,
  </para>
  <para style="p">
    <verse number="7" style="v" />caeh ah loe kangbuem Siloam tuili (thuih koehhaih loe patoeh tih haih ih ni) ah amsae ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Imtaeng kaminawk hoi anih loe mikmaeng ni, tiah hnuzong kaminawk mah, Hae kami loe anghnut moe, minawk khaeah ban patueng kami na ai maw? tiah thuih o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thoemto kaminawk mah, Hae kami loe anih to ni, tiah thuih o, kalah thoemto kaminawk mah loe, Hae kami loe anih hoiah anghmong, tiah thuih o: toe mikmaeng mah to kami loe kai ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae mah anih khaeah, Kawbangmaw na mik amtueng? tiah a naa o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah, Jesu, tiah kawk ih kami mah long to kanaem ah pathluem moe, ka mik ah ang nok pae, to pacoengah kangbuem Siloam tuili ah amsaeh hanah ang thuih; ka caeh moe, kam saeh naah, ka mik hae amtueng, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae mah anih khaeah, To kami loe naa ah maw oh? tiah dueng o. Anih mah, Ka panoek ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae mah mikmaeng to Farasinawk khaeah hoih o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sabbath niah Jesu mah long to kanaem ah pathluem moe, mikmaeng to ngantuisak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Farasinawk mah doeh na mik loe kawbangmaw amtueng, tiah dueng o. Anih mah nihcae khaeah, Anih mah long kanaem to ka mik ah ang nok pae, tui hoiah mik ka pasaeh naah, ka mik hae amtueng, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To naah thoemto Farasinawk mah, Hae kami loe Sabbath ni za ai pongah, Sithaw khae ih kami na ai ni, tiah thuih o. Kalah kaminawk mah loe, Kazae kami mah kawbangmaw hae baktih dawnrai hmuennawk to sah tih, tiah a naa o. To pongah maeto hoi maeto ampraek o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae mah mikmaeng khaeah, Na mik amtuengsak kami to kawbangmaw na poek? tiah dueng o let. To naah anih mah, To kami loe Tahmaa ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Judahnawk mah hae kami loe mikmaengh, toe vaihi loe mik amtueng boeh, tito mik amtueng kami ih amno hoi ampa kawk ai karoek to tang o ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae mah to kami ih amno hoi ampa khaeah, Anih loe tapen tangsuek nathuem hoiah mik a maeng boeh, tiah na thuih hoi ih nanghnik ih capa maw? Kawbangmaw vaihi anih ih mik amtueng pae? tiah dueng o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih ih amno hoi ampa mah nihcae khaeah, Hae kami loe kaihnik ih capa ni, anih loe tapen tangsuek na hoiah mikmaeng boeh:
  </para>
  <para style="p">
    <verse number="21" style="v" />toe kawbangmaw vaihi a mik amtueng pae let, mi mah maw a mik amtuengsak, tito ka panoek hoi ai: anih loe saning akoep boeh: to pongah angmah khaeah dueng oh: anih mah angmah kawng to thui tih hmang, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi kawbaktih doeh Anih loe Kri ni, tiah thui kami loe sineko hoiah pathok si, tiah Judahnawk palung adue o; Judah kaminawk to a zit hoi pongah ni, anih ih amno hoi ampa mah to tiah lokthuih hoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah, anih ih amno hoi ampa mah anih loe saning akoep boeh; angmah khaeah dueng oh, tiah a thuih pae hoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nihcae mah mikmaeng to kawk o let moe, anih khaeah, Sithaw to mah pakoeh ah: hae kami loe kami zae, tiah ni ka panoek o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih mah, Hae kami loe kami zae maw, kami zae ai, tito ka panoek ai: hmuen maeto ka panoek ih oh, kai loe canghniah mik ka maengh, toe vaihi loe mik amtueng boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />To naah nihcae mah anih khaeah, Anih mah tih maw ang sak pae? Anih mah na mik to kawbangmaw amtuengsak? tiah dueng o let.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih mah nihcae khaeah, Kang thui o boeh, toe na tahngai o ai: tikhoe thaih let han na koeh o loe? Nangcae doeh Anih hnukbang kami ah oh hanah na koeh o maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah nihcae mah anih to zoeh o, Nang loe Anih hnukbang kami ah na oh, toe kaicae loe Mosi hnukbang kami ah ni ka oh o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sithaw mah Mosi khaeah ni lokthuih pae, tito ka panoek o: toe hae kami loe naa ih kami maw, tito ka panoek o ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="30" style="v" />To kami mah nihcae khaeah, Dawnrai han oh, Anih loe naa ih kami maw, tito na panoek o ai, toe anih mah ni ka mik hae amtuengsak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sithaw mah kami zaenawk ih lok tahngai ai, tito a panoek o: toe Sithaw to bok moe, a koehhaih sah kami ih lok loe, Anih mah tahngai pae.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tapen tangsuek na hoi kaom mikmaeng to mik amtuengsak, tiah long oh tangsuek na hoi mi mah doeh thai vai ai vop.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hae kami loe Sithaw ih kami ai nahaeloe, anih mah tidoeh sah thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nihcae mah anih khaeah, Kami zae ah tapen nang mah kaicae hae nang patuk maw? tiah a naa o. Anih to tasa bangah pathok o ving.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nihcae mah mikmaeng to haek o ving, tiah Jesu mah thaih; Jesu mah mikmaeng to hnuk naah, anih khaeah, Kami Capa to na tang maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />To naah mikmaeng mah Jesu khaeah, Angraeng, Anih to ka tang thai hanah, Anih loe mi maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jesu mah anih khaeahAnih to na hnuk boeh bae, nang hoi lokpae kami loe anih to boeh ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="38" style="v" />To naah mikmaeng mah, Angraeng, Ka tang, tiah thuih moe, Anih to a bok.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesu mah, Kai loe mikmaengnawk mik amtuengsak moe, mik amtueng kaminawk mikmaengsak han hoi lokcaek han ih ni hae long nuiah kang zoh, tiah a naa.
  </para>
  <para style="p">
    <verse number="40" style="v" />Anih khae kaom thoemto Farasinawk mah to loknawk to thaih o naah, anih khaeah, Kaicae doeh mik ka maengh o maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="41" style="v" />Jesu mah nihcae khaeah, Mik na maeng o nahaeloe, zaehaih na tawn o mak ai: toe kaicae loe mik amtueng, tiah vaihi na thuih o pongah, zaehaih na tawnh o, tiah a naa.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Loktang to, loktang ah, kang thuih o, Tuu khongkha thung hoi akun ai, kalah loklam hoiah daw tahang kami loe, kamqu hoi mingcahnawk ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toe tuutoep kami loe tuu khongkha thung hoiah ni akunh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khongkha toep kami mah anih hanah thok to paongh pae; tuunawk mah anih ih lok to tahngai pae o: anih loe angmah ih tuunawk to ahmin hoiah kawk moe, tasa bangah caeh haih.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tuunawk tasa bangah caeh haih naah, nihcae hmaa ah a caeh pae, tuunawk mah anih ih lok to maat o pongah, anih hnukah bang o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuunawk loe hnuk vai ai ih kami hnukah natuek naah doeh bang o mak ai, a lok to maat o ai pongah, cawn o taak tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu mah nihcae khaeah, Hae patahhaih lok hae a thuih pae, toe nihcae khaeah a thuih pae ih lok to nihcae mah thaih pae o kop ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah Jesu mah nihcae khaeah, Loktang to, loktang ah, kang thuih o, Kai loe tuu khongkha ah ka oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai hmaa ah angzo kaminawk boih loe kamqu hoi mingcahnawk ni: tuunawk mah nihcae ih lok to tahngai pae o ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kai loe khongkha ah ka oh: mi kawbaktih doeh kai thung hoiah akun kami loe, pahlonghaih hnu tih, a thungah caeh ueloe, tacawt tih, to pacoengah rawkcak caakhaih kahoih ahmuen to hnu tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kamqu loe paquk han ih, hum han ih hoi paro han ih ni angzoh: Kai loe nihcae hinghaih tawnh o moe, pop aep ah a tawnh o han ih ni kang zoh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai loe kahoih tuutoepkung ah ka oh: kahoih tuutoepkung loe tuunawk hanah a hinghaih to paek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuutoep kami ai, tuu tawnkung doeh na ai, thlai ih kami loe kangzo tasui to hnuk naah, tuunawk to prawtsut moe, cawnh taak ving: tasui mah tuunawk to kaek moe, tuunawk to ampraeksak phang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thlai ih kami loe thlai ih kami ah oh pongah, tuunawk to dawncang ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kai loe kahoih tuutoepkung ah ka oh; Kai mah ih tuunawk to Ka panoek, tuunawk mah doeh kai ang panoek o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pa mah Kai ang panoek baktih toengah, Pa to Ka panoek, Ka hinghaih to tuunawk hanah ka paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hae tuu khongkha thungah kathum ai, kalah tuunawk doeh Ka tawnh: nihcae doeh Ka hoih han oh vop, nihcae mah ka lok to tahngai o tih; to pacoengah loe tuu khongkha maeto hoi tuutoepkung maeto ni om tih boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka hinghaih ka paek pongah, Kam Pa mah Kai ang palung, to hinghaih to ka lak let han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi mah doeh kai khae hoi lomh mak ai, Kaimah koehah ni hinghaih to ka paek. Ka paek thaih baktih toengah, lak let thaihaih doeh ka tawnh. Kam Pa khae hoiah ni hae lokpaekhaih hae Ka hnuk, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hae a thuih ih loknawk pongah Judah kaminawk salakah ampraekhaih to oh let.
  </para>
  <para style="p">
    <verse number="20" style="v" />Paroeai kaminawk mah, Anih loe taqawk tawnh moe, amthu boeh; tih hanah a lok to na tahngai pae o khing loe? tiah naa o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kalah kaminawk mah loe, Hae loknawk loe taqawk tawn kami mah thuih ih lok na ai ni. Taqawk mah loe mikmaeng to mik amtuengsak thai tih maw? tiah thuih o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Siktue phak naah loe, Jerusalem ah angpaekhaih poih to oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu loe tempul thung ih Solomon impoem ta ah amkaeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />To naah Judahnawk mah anih to takui o moe, anih khaeah, Nasetto maw kaicae palung nang haengsak han vop? Kri ah na oh nahaeloe, kamnoek ah na thui ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu mah nihcae khaeah, Kang thuih o boeh, toe nang tang o ai: Kam Pa ih ahmin hoiah ka sak ih toknawk loe, Kai hnukung ah oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe kang thuih o baktiah, Kai ih tuu ah na om o ai pongah, Kang thuih o ih lok to na tang o ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kai ih tuunawk loe Ka lok to tahngai o, nihcae to Ka panoek, nihcae loe Ka hnukah bang o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dungzan hinghaih to nihcae hanah ka paek; nihcae loe natuek naah doeh anghmaa o mak ai, mi mah doeh Ka ban thung hoiah lomh mak ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae kai khaeah paekkung, Kam Pa loe, tih boih pongah len kue; mi mah doeh nihcae to Kam Pa ban thung hoiah lomh thai mak ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai hoi Kam Pa loe maeto ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />To naah Judahnawk mah Anih vah hanah thlung akhui o let.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu mah nihcae khaeah, Kam Pa khae hoi ih paroeai kahoih toknawk to kang patuek o boeh; kawbaktih tok pongah maw Kai thlung hoiah nang va o han? tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Judahnawk mah anih khaeah, Kahoih tok pongah thlung hoi kang va o mak ai; toe nang loe Sithaw ih ahmin kasae na thuih; kami ah na oh to mah, nangmah hoi nangmah to Sithaw ah nang sak pongah ni, tiah a naa o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah nihcae khaeah, Nangcae loe sithawnawk ah na oh o, tiah Ka thuih, tiah nangmacae ih kaalok thungah tarik ih lok to oh na ai maw?
  </para>
  <para style="p">
    <verse number="35" style="v" />Anih mah nihcae to sithawnawk, tiah kawk nahaeloe, mi khaeah maw Sithaw lok to angzoh, Cabu loe amro thai mak ai;
  </para>
  <para style="p">
    <verse number="36" style="v" />ampa mah ciimcaisak moe, long nuiah patoeh ih kami mah, Kai loe Sithaw Capa ah ka oh, tiah Ka thuih pongah maw, Sithaw ih ahmin kasae na thuih, tiah nang naa o?
  </para>
  <para style="p">
    <verse number="37" style="v" />Kam Pa ih tok to ka sah ai nahaeloe, na tang o hmah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Toe a tok to ka sak pae nahaeloe, Kai nang tang o ai cadoeh, ka sak ih toknawk to tang oh; to tiah nahaeloe Pa Kai thungah oh moe, Kai doeh Anih thungah ka oh, tito na panoek o thai tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />To pongah nihcae mah Anih naeh hanah pakrong o let: toe Anih loe nihcae ban thung hoiah loih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Anih loe Johan mah tuinuem paek tangsuekhaih Jordan vapui yaeh ah caeh moe, toah oh.
  </para>
  <para style="p">
    <verse number="41" style="v" />To pacoengah paroeai kaminawk anih khaeah angzoh o moe, Johan loe dawnrai hmuen sah vai ai: toe Johan mah thuih ih hae kami kawngnawk boih loe amsoem, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="42" style="v" />To ahmuen ah paroeai kaminawk mah Anih to tang o.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lazaru, tiah kawk ih kami loe ngannat, anih loe Meri hoi amnawk Martha ohhaih Bethani avang ih kami ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />(To Meri loe nganna Lazaru ih tanuh ah oh moe, Angraeng ih khok to hmuihoih tui hoiah bawh moe, a sam hoiah anih ih khok hmawt pae kami ah oh.)
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah a tanuh hnik mah Anih khaeah, Angraeng, khenah, na palung ih kami loe ngannat, tiah lok a pat pae hoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />To lok to Jesu mah thaih naah, Hae nathaih loe duek han khoek to om ai, toe Sithaw lensawkhaih amtueng han ih ni oh, hae nathaih rang hoiah lensawk Sithaw Capa amtuenghaih to om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu mah Martha, anih ih amnawk hoi Lazaru to palung.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lazaru ngannat ti, tiah Anih mah thaih pacoengah, anih loe a ohhaih ahmuen ah ni hnetto thung cam vop.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah a hnukbang kaminawk khaeah, Jerusalem ah caeh o let si boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hnukbang kaminawk mah Anih khaeah, Rabbi, canghni pangah ni Judahnawk mah thlung hoi vah hanah Ang pakrong o; to ahmuen ah Na caeh let han maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu mah, Nito naah atue hatlai hnetto om ai maw? Mi kawbaktih doeh khodai ah caeh kami loe, hae long aanghaih to a hnuk pongah amthaek ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toe khoving ah caeh kami loe, aanghaih om ai pongah, amthaek, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah nihcae khaeah, Hae loknawk thuih pacoengah, Aicae ampui Lazaru loe a iih; toe Ka caeh moe, Ka pathawk han, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih hnukbang kaminawk mah, Angraeng, anih iip nahaeloe hoi tih, tiah a naa o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu mah Lazaru loe duek boeh, tiah thuih koehhaih ih ni, toe nihcae mah loe iih rumramhaih mue a thuih, tiah poek o.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pacoengah Jesu mah nihcae khaeah, Lazaru loe duek boeh, tiah kamnoek ah thuih pae.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na tang o thai hanah, to ahmuen ah ka om ai pongah, nangcae hanah anghoehaih ka tawnh; vaihi anih khaeah caeh o si, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To naah Didymas, tiah kawk ih, Thomas mah a hnukbang ampuinawk khaeah, aicae doeh anih hoi nawnto duek hanah caeh o toeng si, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu phak naah, anih aphumhaih ni palito oh boeh, tito Anih mah panoek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bethani loe Jerusalem hoiah meng hnetto oh duih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihnik ih thangqoi to duek pae boeh pongah, pathloep hanah paroeai Judahnawk Martha hoi Meri khaeah caeh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu angzoh ti, tiah Martha mah thaih naah, Anih dawt hanah a caeh: toe Meri loe im ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Martha mah Jesu khaeah, Angraeng, haeah na oh nahaeloe, ka thangqoi hae dueh mak ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe vaihi doeh Sithaw khaeah na hnik ih hmuen boih loe, Sithaw mah na paek tih, tiah ka panoek, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu mah nongpata khaeah, Na thangqoi loe angthawk let tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Martha mah anih khaeah, Hnukkhuem angthawk lethaih niah loe anih angthawk let tih, tiah ka panoek, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu mah anih khaeah, Kai loe angthawk lethaih hoi hinghaih ah Ka oh: Kai tang kami loe, dueh cadoeh, hing tih:
  </para>
  <para style="p">
    <verse number="26" style="v" />mi kawbaktih doeh Kai tanghaih hoiah khosah kami loe natuek naah doeh dueh mak ai. Hae lok hae na tang maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nongpata mah Anih khaeah, Ue, Angraeng: Nang loe Kri ni, long nuiah angzo han koi, Sithaw Capa ah na oh, tito Ka tang, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />To tiah lok cae a thuih pacoengah, Martha loe caeh moe, tamquta hoi amnawk Meri to kawk, Patukkung, angzoh boeh, nang ang kawksak, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Meri mah to lok to thaih naah, karangah angthawk moe, Anih khaeah caeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />To naah Jesu loe avang thungah akun ai vop, Anih loe Martha mah dawthaih ahmuen ah ni oh vop.
  </para>
  <para style="p">
    <verse number="31" style="v" />Meri pathloep hanah im ah kangzo Judahnawk loe, karangah angthawk o moe, tasa bangah tacawt Meri to hnuk o naah, qah han ih mue taprong ah a caeh, tiah poek o pongah, anih hnukah bang o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Meri loe Jesu ohhaih ahmuen to phak moe, Anih to hnuk naah, a khokkung ah cangkrawn moe, Anih khaeah, Angraeng, haeah na oh nahaeloe, ka thangqoi hae dueh mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih qahhaih hoi anih hoi nawnto kangzo Judahnawk qahhaih to Jesu mah hnuk naah, palungset moe, poek angpho,
  </para>
  <para style="p">
    <verse number="34" style="v" />anih mah naa ah maw a qok to na pasong o? tiah a naa. Nihcae mah anih khaeah, Angraeng, angzo ah loe khenah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesu qah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Judah kaminawk mah, Khen oh, Anih mah kawkrukmaw Lazaru to palung, tiah thuih o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nihcae thung ih thoemto kaminawk mah, Mikmaeng mik amtuengsak, hae kami mah Lazaru duek han ai ah sah thai mak ai maw? tiah thuih o.
  </para>
  <para style="p">
    <verse number="38" style="v" />To pongah Jesu loe palungset hoiah taprong ah caeh. Taprong loe thlung khaw ah oh pongah, akhaw to thlung hoiah kraeng o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesu mah, Thlung to takhoe oh, tiah a naa. Toe kadueh kami ih tanuh Martha mah, Anih khaeah, Vaihi loe anih ih qok hmuisae tih boeh, aphumhaih ni palito oh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jesu mah anih khaeah, Na tang nahaeloe, Sithaw lensawkhaih na hnu tih, tiah kang thuih boeh na ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />To naah qok pasonghaih taprong thlung to takhoe pae o. Jesu mah van ah doeng tahang moe, Pa, Ka lok nang tahngaih pae pongah, kawnhaih lok kang thuih.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka lok nang tahngaih pae toepsoep, tiah ka panoek: toe haeah angdoe kaminawk mah, Kai loe Nang mah ni patoeh, tiah tang o thai han ih ni, hae lok hae ka thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hae lok a thuih pacoengah, Lazaru, tacawt ah, tiah tha hoi a hang.
  </para>
  <para style="p">
    <verse number="44" style="v" />To naah kadueh kami to tacawt, a ban hoi a khok loe kadueh khukhaih kahni mah zaeng caeng: mikhmai doeh pavawh mah khuk khoep. Jesu mah nihcae khaeah, Anih to khram oh, caeh nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="45" style="v" />Jesu mah sak ih hmuen to, Meri pathloep han angzo paroeai Judahnawk mah hnuk o naah, Anih to tang o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Toe nihcae thung ih thoemto kaminawk loe Farasinawk khaeah caeh o moe, Jesu mah sak ih hmuennawk to thuih pae o.
  </para>
  <para style="p">
    <verse number="47" style="v" />To naah kalen koek qaima hoi Farasinawk nawnto amkhueng o, Hae kami mah paroeai dawnrai hmuennawk sak boeh pongah, timaw a sak o han?
  </para>
  <para style="p">
    <verse number="48" style="v" />Anih hae hae tiah prawtsut nahaeloe, kaminawk mah anih hae tang o boih tih boeh: to naah Rom kaminawk angzo o ueloe, aicae ih ahmuen hoi acaeng to la o tih boeh, tiah thuih o.
  </para>
  <para style="p">
    <verse number="49" style="v" />To naah nihcae thung ih kami, to na saning ah kalen koek qaima toksah Kaiapha mah, nihcae khaeah, Tidoeh na panoek o ai,
  </para>
  <para style="p">
    <verse number="50" style="v" />acaeng boih anghmat pongah loe, kaminawk hanah kami maeto duek to hoih kue, tiah a naa.
  </para>
  <para style="p">
    <verse number="51" style="v" />Anih mah hae lok hae angmah koeh ah thui ai: to na saning ah kalen koek qaima ah a oh baktih toengah, acaeng taham ah Jesu dueh tih, tiah anih mah taphong coek boeh;
  </para>
  <para style="p">
    <verse number="52" style="v" />to acaengnawk han khue ai, prae kalah ah ampraek phang, Sithaw ih caanawk doeh maeto ah angcusak hanah thuih ih lok ah doeh oh.
  </para>
  <para style="p">
    <verse number="53" style="v" />To na ni hoi kamtong nihcae loe nawnto amkhueng o moe, Anih hum hanah pacaeng o.
  </para>
  <para style="p">
    <verse number="54" style="v" />To pongah Jesu loe Judahnawk salakah kamtuengah caeh ai; praezaek taengah kaom, Ephraim, tiah kawk ih avang taengah a caeh moe, to ah a hnukbang kaminawk hoi nawnto oh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Judahnawk misong loihaih poih loe anghnai boeh: to poih sah ai naah, amprikcai o hanah, paroeai kaminawk loe angmacae avang hoiah Jerusalem ah caeh o.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nihcae mah Jesu to pakrong o, nihcae tempul thungah angdoet o naah, kawbangmaw na poek o? Anih poihkung ah angzo mak ai maw? tiah maeto hoi maeto angdueng o.
  </para>
  <para style="p">
    <verse number="57" style="v" />Kalen koek qaima hoi Farasinawk mah, Mi kawbaktih doeh Anih ohhaih panoek kami loe, Anih to a naeh o thai hanah, a ohhaih ahmuen to patuek han angaih, tiah lokpaek o.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Misong loihhaih poih phak tomhaih ni tarukto naah, Jesu loe kadueh Lazaru pathawkhaih Bethani avang to phak.
  </para>
  <para style="p">
    <verse number="2" style="v" />To avang ah nihcae mah anih han duembuh caakhaih sak pae o; Martha mah caaknaek to thongh pae: toe Lazaru loe caboi nuiah Anih hoi nawnto anghnut.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah Meri mah, atho kana parai hmuihoih tui tabu maeto lak moe, Jesu ih khok to bawh pae pacoengah, a sam hoiah huk pae: to naah imthung ah hmuihoih tui to koi.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pacoengah a hnukbang kaminawk thung ih maeto, Anih angphat taak han kaom Simon capa, Juda Iskariot mah,
  </para>
  <para style="p">
    <verse number="5" style="v" />tikhoe kamtang kaminawk na paek hanah hae hmuihoih tui hae phoisa cumvai thumto hoiah na zaw ai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kamtang kaminawk abomh han koeh pongah anih mah hae lok hae thuih ih na ai ni; anih loe kamqu ah oh, phoisa pakuemkung ah oh moe, phoisa to angmah han patoh kami ah oh pongah ni to tiah lok a thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu mahnongpata loe angmah hmawk ah om nasoe: Kai aphumhaih ni han ih ni hae hmuihoih tui hae a suek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kamtang kaminawk loe nangcae hoi nawnto oh o poe; toe Kai loe nangcae hoi nawnto ka om poe mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih toah oh, tiah Judahnawk mah panoek o naah, Jesu hnuk han ih khue ai ah, duekhaih thung hoi anih mah pathawk ih Lazaru doeh hnuk han koeh o pongah, paroeai kaminawk angzoh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kalen koek qaima mah Lazaru doeh hum hanah pacaeng;
  </para>
  <para style="p">
    <verse number="11" style="v" />Lazaru kawng pongah paroeai Judah kaminawk mah qaima to caeh o taak moe, Jesu tanghaih to tawnh o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khawnbang phak naah loe, poihkung ah angzo paroeai kaminawk mah, Jesu Jerusalem ah angzoh, tiah thaih o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bawksawk qam hoi kanghmong thing tanghang to sin o moe, anih dawt hanah caeh o, Hosanna: Angraeng hmin hoi angzo Israel Siangpahrang loe tahamhoihaih om nasoe, tiah hang o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu mah laa hrang to hnuk naah, a nuiah angthueng;
  </para>
  <para style="p">
    <verse number="15" style="v" />Zion canu, zii hmah: khenah, na Siangpahrang loe laa hrang nuiah angthueng moe, angzoh, tiah tarik ih oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tangsuek naah loe a hnukbang kaminawk mah hae hmuennawk hae thaih o kop ai: toe Jesu to pakoeh ah oh naah, hae hmuennawk loe Anih kawng ni tarik o, hae hmuennawk loe Anih han ih ni sak pae o, tito nihcae mah panoek o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah Lazaru to taprong thung hoiah kawk moe, duekhaih thung hoiah pathawk let naah kaom paroeai kaminawk loe, Anih hnukung ah oh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah dawnrai hmuen sak, tito nihcae mah thaih o naah, anih hnuk hanah caeh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pongah Farasinawk mah kawbang doeh na sah o thai ai boeh, khen oh, long loe Anih hnukah ni caeh boeh, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Poih tue ah Sithaw bok han angzo kaminawk thungah Griknawk doeh athum o toeng:
  </para>
  <para style="p">
    <verse number="21" style="v" />to kaminawk loe Kalili prae Bethsaida avang ah om kami, Philip khaeah angzoh o moe, Patukkung, Jesu hnuk han ka koeh o, tiah tahmenhaih hnik o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Philip loe caeh moe, Andru khaeah thuih pae: to pacoengah Andru hoi Philip Jesu khaeah caeh hoi moe, thuih pae hoi let.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu mah nihcae khaeah, Kami Capa pakoehhaih atue loe phak boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Loktang to, loktang ah, kang thuih o, Cangti loe long ah krak moe, dueh ai nahaeloe, angmah toengroeng ah ni oh: toe a duek naah loe, athaih paroeai athaih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi kawbaktih doeh a hinghaih palung kami loe, anghmaa tih; hae long nuiah a hinghaih hnuma kami loe dungzan hinghaih to toep tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi kawbaktih doeh Ka tok sah kami loe, Ka hnukah bang nasoe; Ka ohhaih ahmuen ah, Ka tamna doeh om toeng tih: Ka tok sah kami loe Kam Pa mah pakoeh tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vaihi ka poekhaih angpho; timaw ka thuih han? Pa, hae atue thung hoiah na pahlong ah: toe hae tiah oh han ih ni, hae atue ah kang zoh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pa, na hmin to pakoeh ah, tiah a naa. To naah van hoiah, Ka pakoeh hmaek boeh, Ka pakoeh let han vop, tiah lok to angzoh.
  </para>
  <para style="p">
    <verse number="29" style="v" />To ahmuen ah angdoe kaminawk mah, To lok to thaih o naah, Khopazih, tiah thuih o: kalah kaminawk mah loe, Van kami mah lok a thuih pae, tiah thuih o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu mah hae lok loe kai han angzo ai, nangcae hanah ni angzoh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hae long loe vaihi lokcaek ah oh boeh: hae long angraeng haekhaih to om tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kai long ranui ah atoengh tahang naah, kaminawk boih kaimah khaeah ka zaeh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hae lok loe, anih kawbangmaw due tih, tiah thuih koehhaih ih ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />To naah paroeai kaminawk mah anih khaeah, Kri loe dungzan ah caak poe tih, tiah kaalok mah thuih ih lok to ka thaih o: nangmah loe kawbangmaw, Kami Capa to ranui ah bang o tih, tiah na thuih, hae Kami Capa loe mi maw? tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="35" style="v" />To naah Jesu mah nihcae khaeah, Aanghaih loe nawnetta thungah ni nangcae hoi nawn to oh. Aanghaih na tawnh o naah caeh oh, to tih ai nahaeloe nangcae nuiah vinghaih pha moeng tih: khoving thung caeh kami loe naa ah maw a caeh, tito panoek ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aanghaih caa ah na oh o thai hanah, aanghaih na tawnh o naah, aanghaih to tang oh, tiah a naa. Hae loknawk a thuih pacoengah, Jesu mah nihcae to yae moe, caehtaak ving.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih mah nihcae hma ah paroeai dawnrai hmuen sak pae cadoeh, nihcae mah anih to tang o ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Angraeng, ka thuih o ih lok tang kami oh o maw? Angraeng ih ban loe mi khaeah maw amtueng? tiah tahmaa Isaiah mah thuih ih lok akoep han ih ni oh.
  </para>
  <para style="p">
    <verse number="39" style="v" />To pongah nihcae mah tang o thai ai, Isaiah mah,
  </para>
  <para style="p">
    <verse number="40" style="v" />Anih mah nihcae mikmaengsak moe, nihcae ih palung amtaksak; to tih ai nahaeloe nihcae mah mik hoiah hnu o moeng tih, palung hoiah panoek o ueloe, amnlaem o tih, to naah kai mah nihcae to ngan ka tuisak moeng tih, tiah thuih let.
  </para>
  <para style="p">
    <verse number="41" style="v" />Isaiah mah, Anih lensawkhaih hnuk naah, Anih kawng to hae tiah thuih.
  </para>
  <para style="p">
    <verse number="42" style="v" />To tiah om cadoeh, paroeai ukkung ah kaom kaminawk mah anih to tang o; toe Farasinawk mah sineko thung hoiah haek moeng tih, tiah a poek o pongah, Anih kawng to nihcae mah taphong o ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nihcae loe Sithaw mah pakoeh pongah kami mah pakoehhaih to koeh o kue.
  </para>
  <para style="p">
    <verse number="44" style="v" />To naah Jesu mah, Kai tang kami loe Kai to tang ai, Kai patoehkung tang kami ah ni oh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kai khen kami loe Kai patoehkung to a hnuk.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kai tang kaminawk, khoving thungah oh o han ai ah, Kai loe long ah kangzo aanghaih ah ka oh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mi kawbaktih doeh ka lok to thaih moe, tang ai nahaeloe anih to lok ka caek mak ai: Kai loe long lokcaek hanah kang zo ai, long pahlong hanah ni kang zoh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kai talawk ai moe, ka lok tahngai ai kami lokcaekkung maeto oh: Ka thuih ih lok mah anih to hnukkhuem niah lokcaek tih.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kai loe kaimah koehah lok ka thui ai; toe ka thuih moe, ka patuk han ih lok loe kai patoehkung Pa mah ni ang paek.
  </para>
  <para style="p">
    <verse number="50" style="v" />Anih mah paek ih lok loe dungzan hinghaih lok ah oh, tito ka panoek: to pongah Pa mah ang thuihsak ih baktih toengah ni lok ka thuih, tiah a naa.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Misong loihhaih poih pha ai vop, Jesu mah hae long tacawt taak moe, Ampa khaeah caehhaih atue phak boeh, tiah panoek naah, long ah kaom angmah ih kaminawk khaeah, atue boeng khoek to amlunghaih to amtuengsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Duembuh caak pacoeng tom naah, Anih angphat taak hanah, Simon capa, Juda Iskariot ih palung thungah taqawk mah toksak pae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ampa mah hmuen boih anih ban ah paek boeh, anih loe Sithaw khae hoi angzoh moe, Sithaw khaeah caeh han oh boeh, tiah Jesu mah panoek;
  </para>
  <para style="p">
    <verse number="4" style="v" />anih loe duembuh caakhaih ahmuen hoiah angthawk moe, angmah ih kahni to angkhring, pavawh to lak moe, kaeng ah angzaeng.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pacoengah sabae thuk thungah tui a lawn moe, a hnukbang kaminawk ih khok to pasaeh pae, to pacoengah kaeng ah angzaeng ih pavawh hoiah a huk pae.
  </para>
  <para style="p">
    <verse number="6" style="v" />Simon Piter khaeah phak naah loe, Piter mah anih khaeah, Angraeng, ka khok nang pasaeh pae han maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu mah anih khaeah, Vaihi ka sak ih tok hae na panoek thai mak ai; toe amzai ah ni na panoek vop tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Piter mah anih khaeah, Ka khok hae natuek naah doeh na pasae mak ai, tiah a naa. Jesu mah anih khaeah, Kang pasae pae ai nahaeloe, kai ih kami ah na om mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Simon Piter mah anih khaeah, Angraeng, ka khok khue ai, ka ban hoi ka lu doeh pasae ngala ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah anih khaeah, Tui amhluh kami loe khok khue ni pasaeh han angaih, kalah takpum loe ciim boeh: nangcae loe na ciim o, toe na ciim o boih ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih angphat taak han kami to anih mah panoek pongah, na ciim o boih ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih mah nihcae ih khok pasaeh pae pacoengah, angmah ih kahni to lak moe, anghnut let, anih mah nihcae khaeah, Nangcae khaeah ka sak ih hmuen hae na panoek o maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai hae Patukkung, Angraeng, tiah nang kawk o: to tiah nang kawk o haih loe amsoem; kai loe to tiah ni ka oh roe.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kai loe nangcae Patukkung hoi Angraeng ah ka oh, toe khok kang pasaeh pae o baktih toengah, nangcae mah doeh maeto hoi maeto ih khok to pasae oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangcae khae ka sak ih baktih toengah, na sak o toeng hanah, khet koi kaom hmuen kang patuek o boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Loktang to, loktang ah, kang thuih o, Tamna loe angmah ih angraeng pongah len kue ai; patoeh ih kami doeh patoehkung pongah len kue ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hae hmuennawk hae na panoek o moe, na sak o nahaeloe, taham na hoih o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nangcae boih ka thuih koeh ih na ai ni: ka qoih ih kaminawk loe ka panoek: Cabu akoep hanah, kai hoi nawnto buhcaa kami mah khok hoiah ang pathuih boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />To baktih hmuen pha ai naah kang thuih o coek boeh, to tiah ni hae baktih hmuen phak naah, Kai loe Anih boeh ni, tiah na tang o thai tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Loktang to, loktang ah, kang thuih o, Ka patoeh ih kami talawk kami loe, kai talawk kami ah oh, Kai talawk kami loe Kai patoehkung talawk kami ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hae lok a thuih pacoengah, Jesu loe dawnrai hoiah oh; Loktang to, loktang ah, kang thuih o, Nangcae thung ih kami maeto mah kai angphat taak tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />To naah a hnukbang kaminawk mah, Mi thuih koehhaih ih maw, tiah poek o moe, maeto hoi maeto ang khet o.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hnukbang kaminawk thungah Jesu mah palung ih kami maeto loe, Jesu ih saoek nuiah amha.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simon Piter mah saoek ah amha a hnukbang kami khaeah, Jesu mah thuih ih lok loe mi thuih koehhaih ih maw dueng noek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah Jesu ih saoek ah amha kami mah anih khaeah, Angraeng, to kami loe mi aa? tiah dueng.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu mah, Sabae thungah takaw ka nup moe, ka paek ih kami to ni, tiah a naa. To pacoengah Anih mah sabae thungah takaw to nup moe, Simon capa, Juda Iskariot hanah paek.
  </para>
  <para style="p">
    <verse number="27" style="v" />Takaw nup pacoengah, anih takoh thungah Setan akun. To pacoengah Jesu mah anih khaeah, Na sak han koi hmuen to karangah sah lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tipongah maw anih hanah to tiah lok a thuih pae, tito toah buhcaa kami maeto mah doeh panoek o ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae thung ih thoemto kaminawk mah Judah loe phoisa pakuemkung ah oh pongah, poihsak hanah hmuenmae qan han ih a thuih pae kalang mue, to tih ai boeh loe kamtang kaminawk paek hanah hmuenmae a qansak mue, tiah poek o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Takaw lak pacoengah, anih loe tasa bangah tacawt roep; to naah khoving boeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Juda tasa bang tacawt pacoengah, Jesu mah, Kami Capa loe vaihi pakoeh ah oh boeh, Anih pongah Sithaw doeh pakoeh ah oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anih pongah Sithaw pakoeh ah om nahaeloe, anih pongah Sithaw Angmah to doeh pakoeh ah om ueloe, akra ai ah Anih to pakoeh roep tih boeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nawktanawk, nawnetta thungah ni nangcae khaeah ka om tih boeh. Nangcae mah nang pakrong o tih: toe Judahnawk khaeah ka thuih ih lok baktih toengah, vaihi roe kang thuih o: ka caehhaih ahmuen ah, nang zo o thai mak ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kaalok kangtha kang paek o, maeto hoi maeto amlung oh; kang palung o baktih toengah, nangcae doeh maeto hoi maeto amlung oh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Maeto hoi maeto nam lung o naah ni, kaminawk boih mah nangcae loe kai hnukah bang kaminawk ni, tiah panoek o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />Simon Piter mah anih khaeah, Angraeng, naa ah maw na caeh han? tiah a naa. Jesu mah anih khaeah, Vaihi ka caehhaih ahmuen ah nang zo o thai mak ai, toe hae pacoengah ni nang zo o thai vop tih, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="37" style="v" />Piter mah anih khaeah, Angraeng, tipongah vaihi kang zo o thai mak ai loe? Nang pongah ka hinghaih ka vah han, tiah a naa.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesu mah anih khaeah, Kai pongah na hinghaih na vah han maw? Loktang to, loktang ah, kang thuih, Aakhong ai na ah, vai thumto kai nang phat taak tih, tiah pathim pae.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Poek anghmang o hmah: Sithaw to tang oh loe, kai doeh tang oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kam Pa im ah loe ohhaih ahmuen oh mangh: to tiah om ai nahaeloe, kang thuih o han boeh. Nangcae ohhaih ahmuen sak hanah ka caeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangcae ohhaih ahmuen ka sak pacoengah, Kang zoh let moe, Ka ohhaih ahmuen ah, na oh o toeng hanah, kaimah khaeah kang lak o han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka caeh han ih ahmuen hoi loklam to na panoek o, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thomas mah anih khaeah, Angraeng, naa ah maw na caeh han, tito ka panoek o ai; kawbangmaw loklam to ka panoek o thai tih? tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu mah anih khaeah, Kai loe loklam, loktang hoi hinghaih ah ka oh: Kai ai ah loe mi kawbaktih doeh Pa khaeah angzo thai mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai nang panoek o boeh nahaeloe, kam Pa doeh na panoek o tih: vaihi hoi kamtong Anih to na panoek o moe, Anih to na hnuk o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Philip mah anih khaeah, Angraeng, kaicae hanah Ampa to patuek ah, to tih nahaeloe kaicae han khawt boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu mah anih khaeah, Philip, atue kasawk ah nang hoi nawnto ka oh boeh, toe kai nang panoek ai vop maw? Kai hnu kami loe Ampa to hnuk boeh; kawbangah maw kaicae hanah Ampa to patuek ah, tiah na thuih?
  </para>
  <para style="p">
    <verse number="10" style="v" />Pa thungah Kai ka oh moe, Kai thungah Pa oh, tito na panoek ai maw? Kang thuih o ih loknawk loe kaimah koeh ah thuih ih lok na ai ni: Kai thungah kaom Pa mah ni thuih, Anih mah ni hae toknawk hae sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai loe Pa thungah ka oh, Pa doeh kai thungah oh, tiah tang oh, to tih ai boeh loe ka sak ih hmuennawk pongah Kai hae tang oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Loktang to, loktang ah, kang thuih o, Ka nuiah tanghaih tawn kami loe, ka sak ih hmuennawk hae anih mah doeh sah toeng tih; Kam Pa khaeah caeh han oh boeh pongah, anih mah hae pongah kalen kue hmuennawk to sah tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Capa rang hoiah Ampa to pakoeh thai hanah, Kai ih ahmin hoiah nang hnik o ih hmuennawk boih kang paek o han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kawbaktih hmuen doeh Ka hmin hoiah nang hnik o nahaeloe, nang hnik o ih baktih toengah kang sak pae o han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kai nang palung o nahaeloe, kang paek o ih loknawk to pakuem oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih nangcae khaeah oh poe hanah, Pa khaeah lawk ka thuih han, Anih mah kalah Pathloepkung to na paek tih;
  </para>
  <para style="p">
    <verse number="17" style="v" />loktang Muithla to na paek o tih; long mah Anih to hnu ai moe, panoek ai pongah, long mah Anih to talawk thai ai: toe nangcae mah loe Anih to na panoek o; Anih loe nangcae hoi nawnto oh, nangcae thungah doeh om tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathloep ai ah kang caeh o taak mak ai: nangcae khaeah Kang zoh han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Akra ai ah long mah Kai hnu mak ai boeh; toe nangcae mah loe nang hnu o tih: Kai ka hing pongah, nangcae doeh na hing o toeng tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />To na niah loe Kam Pa khaeah Kai ka oh, Kai thungah nangcae na oh o moe, nangcae thungah Kai ka oh, tito na panoek o tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka paek ih lok tahngai moe, pakuem kami loe, Kai palung kami ah oh: Kai palung kami loe Kam Pa mah palung tih, Kai mah anih to palung moe, kaimah roe anih khaeah kam tueng pae han.
  </para>
  <para style="p">
    <verse number="22" style="v" />To naah Judah (Judah Iskariot na ai) mah anih khaeah, Angraeng, tipongah kaicae khaeah nam tueng moe, long khaeah nam tueng ai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu mah anih khaeah, Kai palung kami loe, kai ih loknawk to pakuem tih: Kam Pa mah anih to palung tih, anih khaeah ka caeh o moe, anih hoi nawnto Kaimacae ohhaih im to ka sak o han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kai palung ai kami mah loe ka thuih ih loknawk to pakuem ai: na thaih o ih lok loe kai ih lok na ai ni, Kai patoehkung Pa ih lok ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangcae hoi nawnto ka oh naaah hae loknawk hae kang thuih o boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe kam Pa mah Kai ih ahmin hoiah patoeh han ih Pathloepkung, Kacai Muithla mah, nangcae han hmuennawk boih patuk tih, kang thuih o ih loknawk to panoeksak boih tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangcae khaeah monghaih ka caehtaak, Ka monghaih to Kang paek o; long mah paek ih baktiah kang paek o ai. Poek anghmang o hmah loe, zii o hmah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka caeh moe, nangcae khaeah kang zoh let han, tiah kang thuih o ih lok to na thaih o boeh. Kai nang palung o nahaeloe, Pa khaeah ka caeh han boeh, tiah ka thuih pongah, nang hoe o tih: Pa loe kai pongah len kue.
  </para>
  <para style="p">
    <verse number="29" style="v" />To hmuen pha ai naah kang thuih o coek boeh, to tiah ni to hmuen phak naah, na tang o tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Long angraeng angzoh boeh pongah, hae pacoengah loe nangcae hoi lok kapop ah ka thui mak ai boeh, anih mah Kai kawbangah doeh na naa thai mak ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toe Ampa to ka palung moe, Ampa mah ang paek ih lok baktih toeng ah tok ka sak, tito long mah panoek tih. Angthawk oh, hae ahmuen hoiah caeh o si boeh, tiah a naa.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kai loe misurkung tangtang ah ka oh, Kam Pa loe takha tawnkung ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih loe kai ih athaih kathai ai tanghangnawk to pakhruk: athaih kathai tanghangnawk loe athaih aep hanah, tanghangnawk to atlik pae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangcae loe kang thuih o ih lok hoiah vaihi na ciim o boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai khaeah om o poe ah, Kai doeh nangcae khaeah ka oh poe han. Misurkung ah angpeh ai tanghang loe, angmah koehah athaih athai thai ai; Kai ah na om o ai nahaeloe, athaih na thai o thai mak ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai loe misurkung ah ka oh, nangcae loe tanghang ah na oh o: Kai ai ah loe tidoeh na sah o thai ai pongah, Kai ah kaom kami loe, Kai doeh anih khaeah ka oh, to tiah om kami loe athaih paroeai athaih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai ah kaom ai kami loe, kangqo tanghang baktiah tasa bangah vah o ving; kaminawk mah tanghang to akhuih o moe, hmai thungah vah o, nihcae loe hmai mah kangh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai ah na oh o moe, ka lok nangcae thungah om nahaeloe, na koeh o ih hmuen to hni oh, nangcae hanah sah pae tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kam Pa loe athaih kapop ah na thaih o haih rang hoiah pakoeh ah oh; to tiah ni ka hnukbang kami ah na om o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pa mah Ang palung baktih toengah, Kang palung o toeng: Kai amlunghaih ah om oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kam Pa mah paek ih loknawk to ka pakuem moe, Anih amlunghaih ah ka oh baktih toengah, Kang paek ih loknawk to na pakuem o nahaeloe, Kai amlunghaih ah na om o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kang hoehaih nangcae khaeah oh moe, nang hoe o haih akoep thai hanah, hae loknawk hae kang thuih o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kang palung o baktih toengah, nangcae doeh maeto hoi maeto amlung oh, hae loe kang paek o ih lok ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kami maeto mah ampuinawk hanah a hinghaih paek khoek to amlunghaih pongah kalen kue amlunghaih to om ai boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kang thuih o ih lok baktiah na sak o nahaeloe, Kai ih ampui ah na oh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angmah ih angraeng mah sak ih tok to tamna mah panoek ai pongah, vaihi hoi kamtong tamna, tiah kang kawk o mak ai boeh; Kam Pa khae hoi ka thaih ih loknawk to nangcae khaeah kam tuengsak boeh pongah, ampui, tiah ni kang kawk o boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangcae mah kai nang qoi o ai, Kai mah ni nangcae to kang qoih, na caeh o moe, athaih na thaih o pacoengah, nangcae ih athaih to oh poe hanah, tok kang paek o: to naah Kai ih ahmin hoiah Pa khaeah hni kami loe, Anih mah nangcae hanah paek tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Maeto hoi maeto nam lung o hanah, hae loknawk hae kang paek o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Long mah nangcae hnuma nahaeloe, nangcae hnuma ai naah Kai ni ang hnukma, tito panoek oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Long kami ah na oh o nahaeloe, angmah ih kami ah na oh o pongah, long mah nangcae to palung tih: toe nangcae loe long kami ah na om o ai, long thung hoiah kang qoih o boeh pongah, long mah nangcae to hnukma.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kang thuih o ih lok to poek oh, Tamna loe angmah ih angraeng pongah len kue ai. Nihcae mah Kai pacaekthlaek nahaeloe, nangcae doeh pacaekthlaek o toeng tih; nihcae mah Ka thuih ih lok pakuem o nahaeloe, nangcae mah thuih o ih lok doeh nihcae mah pakuem o toeng tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nihcae mah Kai patoehkung Anih to panoek o ai pongah, Kai ih ahmin pongah nihcae mah hae hmuennawk hae nangcae nuiah sah o tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai kang zo ai moe, nihcae khaeah ka thui ai nahaeloe, nihcae loe zaehaih tawn o mak ai: toe vaihi loe angmacae zaehaih to angphat o thai mak ai boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai hnuma kami loe Kam Pa doeh hnukma.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kalah kaminawk mah sah ai ih toknawk to nihcae salakah ka sah ai nahaeloe, nihcae loe zaehaih tawn o mak ai: toe vaihi loe ka sak ih toknawk nihcae mah hnuk o boeh pongah, nihcae mah Kai hoi Kam Pa to hnukma o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toe angmacae ih kaalok pongah, Tidoeh na ai ah nihcae mah Kai ang hnukma o, tiah tarik ih lok to akoep thai han ih ni hae tiah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pa khae hoiah kang patoeh han ih Pathloepkung, Pa khae hoi tacawt, loktang Muithla to angzoh naah, Anih mah Kai kawng to taphong tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangcae doeh tangsuek na hoi Kai khaeah na oh o pongah, Kai hnukung ah na om o toeng tih.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palung na boeng o han ai ah, hae loknawk hae kang thuih o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae mah Sineko thung hoiah na haek o tih: ue, nangcae hum kami mah, kai loe Sithaw ih tok ni ka sak, tiah poekhaih atue to pha tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae mah Pa hoi Kai to panoek o ai pongah, hae baktih toknawk nangcae nuiah sah o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />To baktih atue phak naah kang thuih o ih loknawk na panoek o thai hanah, kang thuih o coek boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vaihi loe kai patoehkung Anih khaeah Ka caeh han boeh; mi mah doeh naa ah maw na caeh han? tiah nang dueng o ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangcae khaeah hae tiah kang thuih o pongah, palung na set o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe loktang kang thuih o; Ka caeh ving hae nangcae hanah hoih: Ka caeh ving ai nahaeloe, Pathloepkung nangcae khaeah angzo mak ai; toe ka caeh ving nahaeloe, Anih to nangcae khaeah kang patoeh han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih angzoh naah anih mah long zaehaih, toenghaih hoi lokcaekhaih to panoeksak tih:
  </para>
  <para style="p">
    <verse number="9" style="v" />nihcae mah Kai tang o ai pongah, zaehaih to amtuengsak tih;
  </para>
  <para style="p">
    <verse number="10" style="v" />kam Pa khaeah Ka caeh moe, kai nang hnuk o han ai boeh pongah, toenghaih to amtuengsak tih;
  </para>
  <para style="p">
    <verse number="11" style="v" />long angraeng to lokcaek boeh pongah, lokcaekhaih to amtuengsak tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangcae khae thuih han ih lok oh mang vop, toe vaihi loe na panoek o thai ai vop.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe loktang Muithla, Anih to angzoh naah loe, anih mah loktang boih to na patuk o tih: anih loe angmah koehah lokthui mak ai; anih mah loe a thaih ih lok to ni thui tih: to pacoengah angzo han koi hmuennawk to nangcae hanah patuek tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih mah kai ih hmuen to la ueloe, nangcae hanah patuek tih, to tiah Anih mah Kai to pakoeh tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pa mah tawnh ih hmuen boih loe Kai ih ni: to pongah ni anih mah Kai ih hmuen to la ueloe, nangcae hanah patuek tih, tiah ka thuih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pa khaeah Ka caeh han boeh pongah, akra ai ah nangcae mah Kai nang hnu o mak ai boeh: akra ai ah Kai nang hnu o let tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />A hnukbang thoemtokaminawk mah, Pa khaeah Ka caeh han boeh pongah, akra ai ah Kai nang hnu o mak ai boeh: akra ai ah Kai nang hnu o let tih, tiah nang thuih ih lok loe tih thuih koehhaih ih maw?
  </para>
  <para style="p">
    <verse number="18" style="v" />Akra ai ah, tiah a thuih ih lok loe tih thuih koehhaih ih maw? A thuih koehhaih lok a panoek o thai ai, tiah maeto hoi maeto a thuih o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih khaeah hae lok dueng han a koeh o, tiah Jesu mah panoek naah, nihcae khaeah, Akra ai ah Kai nang hnu o mak ai boeh: akra ai ah Kai nang hnu o let tih, tiah ka thuih ih lok pongah maw maeto hoi maeto lok nang dueng o?
  </para>
  <para style="p">
    <verse number="20" style="v" />Loktang to, loktang ah, kang thuih o, Long palung anghoe naah, nangcae palung na sae o ueloe, na qah o tih: palung na sae o tih, toe palung na set o haih to anghoehaih ah angcoeng tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nongpata loe zokpomh, caa tapenhaih atue phak boeh pongah, palung a set: toe nawkta tapen pacoengah loe long ah kami maeto tapen boeh pongah, anih mah patangkhanghaih to pahnet moe, anghoe.
  </para>
  <para style="p">
    <verse number="22" style="v" />To baktih toengah vaihi palung na set o, toe kang hnuk o let naah loe, palung anghoehaih na tawn o tih, nang hoe o haih loe mi mah doeh nangcae khae hoi la thai mak ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />To na niah loe Kai khaeah tidoeh nang hni o mak ai boeh. Loktang to, loktang ah, kang thuih o, Kai ih ahmin hoi Pa khaeah na hnik o ih hmuen boih Anih mah na paek o tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangcae mah vaihi khoek to Kai ih ahmin hoiah tidoeh na hni o ai vop: nangcae anghoehaih akoep thai hanah, hni oh, na hnu o tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Patahhaih lok hoiah ni hae loknawk hae kang thuih o: toe patahhaih lok patoh ai ah, nangcae khaeah Pa kawng kamtueng ah thuihaih atue to pha tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />To na niah loe Ka hmin hoiah nang hni o tih: nangcae han Pa khaeah kang hnik pae o han, tiah ka thuih koehhaih ih na ai ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kai loe Sithaw khae hoiah ni kang zoh, tiah na tang o moe, kai nang palung o pongah, Pa angmah roe nangcae to palung.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kai loe Pa khae hoiah tacawt moe, long ah kang zoh: long hae Ka caehtaak moe, Pa khaeah Ka caeh let han, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />A hnukbang kaminawk mah anih khaeah, Khenah, vaihi loe patahhaih lok hoi thui ai ah, kamtueng ah na thuih boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hmuennawk boih na panoek, mi mah doeh nang khaeah lokdueng han angaih ai boeh, tiah vaihi ka panoek o boeh: hae kawng pongah nang loe Sithaw khae hoiah ni nang zoh, tiah ka tang o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu mah nihcae khaeah, Vaihi loe na tang o boeh maw?
  </para>
  <para style="p">
    <verse number="32" style="v" />Khenah, nam praek o phang tih, nangmacae im ah na cawn o ueloe, kai nang caeh o taak suthaih atue to pha tih, ue, vaihi roe phak boeh: toe kai loe kaimah buengah ka om ai, Pa loe kai hoi nawnto oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kai ah monghaih na tawnh o thai hanah, hae hmuennawk hae kang thuih o. Long nuiah raihaih na tong o tih: toe mawn o hmah, long hae ka pazawk boeh, tiah a naa.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu mah hae loknawk thuih pacoengah, van ah doeng tahang moe, Pa, atue mah phak boeh; na Capa mah Ang pakoeh hanah, na Capa hae pakoeh lai ah, tiah lawkthuih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Capa han na paek ih paroeai kaminawk khaeah, Capa mah dungzan hinghaih to paek hanah, kaminawk boih ukhaih to Capa khaeah na paek boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae mah, Na patoeh ih Jesu Kri hoi nang khue ni Sithaw tangtang, tiah panoekhaih loe dungzan hinghaih ah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sak han nang paek ih tok to ka pacoeng boeh: long nuiah na hmin ka pakoeh boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Pa, long om ai naah nang khae hoi ka tawnh ih lensawkhaih hoiah, vaihi nang mah hoi nawnto na pakoeh lai ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Long hoiah nang paek ih kaminawk khaeah na hmin to kam tuengsak boeh: nihcae loe nang ih kami ah ni oh o, nihcae to kai hanah nang paek; nihcae mah na lok to pakuem o boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang paek ih hmuennawk boih loe nang ih ni, tiah vaihi nihcae mah panoek o boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang paek ih loknawk to nihcae khaeah ka thuih, nihcae mah lok to talawk o boeh, Kai loe nang khae hoiah ni kang zoh, tiah nihcae mah kamtueng ah panoek o boeh, Kai loe nang mah ni patoeh, tiah a tang o boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae loe nang ih kami ah oh o pongah, nang paek ih kaminawk hanah, lawk ka thuih pae, long hanah lawk ka thui ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka tawnh ih hmuennawk boih loe nang ih ni, nang ih hmuennawk boih doeh Kai ih ni; nihcae rang hoiah kai loe pakoeh ah ka oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kai loe vaihi long ah ka om ai boeh, toe nihcae loe long nuiah oh o vop, Kai loe nang khaeah kang zoh han boeh. Ciimcai Pa, Nang hoi Kai loe maeto ah a oh hoi baktih toengah, nang paek ih nihcae doeh, maeto ah a oh o thai hanah, na hmin hoiah khenzawn ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae hoi nawnto long ah ka oh naah, nihcae to na hmin hoiah ka khetzawn: nang paek ih kaminawk to ka khetzawn boeh, toe Cabu akoep thai hanah, kanghmaa kangtaa capa thuih ai ah loe, maeto doeh anghmaa o ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vaihi nang khaeah kang zoh han boeh; Kang hoehaih hoiah nihcae koi o thai hanah, long ah hae loknawk hae ni ka thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae khaeah na lok to ka paek boeh; Kai loe long kami ah ka om ai baktih toengah, nihcae doeh long kami ah om o ai, to pongah long mah nihcae to hnukma.
  </para>
  <para style="p">
    <verse number="15" style="v" />Long hoiah nihcae lak ving han lawk ka thui ai; kasae hmuen thung hoiah nihcae khetzawn han ih ni lawk ka thuih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Long ih hmuen ah ka om ai baktih toengah, nihcae doeh long ih hmuen ah om o ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Loktang na lok hoiah nihcae to ciimcaisak ah: na lok loe loktang ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Long nuiah kai nang patoeh baktih toengah, nihcae doeh long nuiah ka patoeh toeng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae loktang lok hoiah ciimcai o thai hanah, nihcae pongah kaimah hoi kaimah to ciimcai ah ka oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae han khue lawk ka thui ai, nihcae mah thuih o ih lok rang hoiah Kai tang han kaom kaminawk hanah doeh lawk ka thuih;
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai loe nang mah ni patoeh, tiah long mah tang thai hanah, nihcae doeh aicae khaeah maeto ah oh o toeng, Pa, Kai thungah na oh moe, Kai nang thungah ka oh baktih toengah, nihcae boih maeto ah oh o thai hanah, lawk ka thuih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aicae maeto ah a oh o baktih toengah, nihcae doeh maeto ah oh o thaih moe,
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai nihcae thungah Ka oh moe, nang Kai thungah na oh, Kai nang patoeh moe, Kai nang palung baktih toengah, nihcae doeh na palung toeng, tiah long mah panoek moe, nihcae maeto ah oh o thai hanah, nihcae khaeah nang paek ih lensawkhaih to ka paek boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pa, long om ai na hoiah boeh Kai nang palung boeh, nang paek ih ka lensawkhaih nihcae mah hnuk o thai hanah, nang paek ih kaminawk doeh ka ohhaih ahmuen ah kai hoi nawnto ohsak han ka koeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aw katoeng Pa, long mah nang to panoek ai: toe Kaimah loe kang panoek; Kai loe nang mah ni patoeh, tito hae kaminawk mah panoek o boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nihcae khaeah na hmin ka taphong boeh, nang palunghaih nihcae khaeah oh moe, Kai nihcae thungah ka oh thai hanah, na hmin to ka taphong han vop, tiah a thuih.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu lawkthuih pacoengah, a hnukbang kaminawk hoi nawnto Kidron tava yaeh ah caeh o, a hnukbang kaminawk hoi vapui yaeh ah kaom takha thungah akun o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu loe to ahmuen ah a hnukbang kaminawk hoi caeh o toepsoep pongah, Anih angphat taak Juda mah doeh to ahmuen to panoek toeng.
  </para>
  <para style="p">
    <verse number="3" style="v" />Juda mah kalen koek qaima, Farasinawk mah patoeh ih misatuh kaminawk to takha thungah angzoh haih, nihcae loe hmaithaw, hmaiim, maiphawnawk hoiah ang zoh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu loe a nuiah pha han koi hmuennawk to panoek boih pongah, hmaa bangah caeh moe, nihcae khaeah, mi maw na pakrong o, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae mah anih khaeah, Nazareth Jesu, tiah a naa o. Jesu mah nihcae khaeah, Anih loe Kai hae boeh ni, tiah a naa. Anih angphat taak Juda doeh nihcae hoi nawnto angdoet toeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah nihcae khaeah, Anih loe Kai hae boeh ni, tiah thuih pacoengah, nihcae loe hnukbang angnawn o moe, long ah amtimh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah Anih mah nihcae khaeah, Mimaw na pakrong o? tiah dueng let. Nihcae mah, Nazareth Jesu, tiah a naa o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu mah, Anih loe Kai hae boeh ni, tiah kang thuih o boeh na ai maw: kai nang pakrong o nahaeloe, hae kaminawk hae caeh o sak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang paek ih kaminawk maeto doeh kang hmasak ai, tiah a thuih ih lok akoep han ih ni hae tiah a thuih.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah Simon Piter mah, angmah ih sumsen to aphongh moe, kalen koek qaima tamna ih bangtang naa to takroek pae pat. Tamna ih ahmin loe Malkuh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu mah Piter khaeah, Na sumsen to tabu thungah pacaeng ah: Kam Pa mah ang paek ih boengloeng hae Ka nae mak ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah misatuh kaminawk hoi Judahnawk zaehoikung angraengnawk mah Jesu to naeh o moe, taoengh o,
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih to Anna khaeah caeh o haih hmaloe, anih loe Kaiapha ih amsae ah oh moe, to na saning ah kalen koek qaima ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaiapha loe kaminawk hanah kami maeto duek to hoih kue, tiah Judahnawk khaeah thui kami ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Simon Piter hoi a hnukbang kalah kami maeto loe Jesu hnukah bang hoi: to a hnukbang kami loe kalen koek qaima hoiah angmat hoi pongah, anih loe Jesu hoi nawnto kalen koek qaima imthung ah akunh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe Piter loe tasa bang ih thok taengah angdoet sut. Kalen koek qaima hoi angmat a hnukbang kalah kami maeto loe tasa bangah tacawt, khongkha toep nongpata hoiah lok apaeh hoi pacoengah, Piter to imthung ah akunsak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khongkha toep nongpata mah Piter khaeah, Nang doeh hae kami hnukbang kaminawk thung ih maeto ah na oh toeng na ai maw? tiah a naa. To naah Piter mah, Kai na ai ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angqai pongah, tamnanawk hoi toksah angraengnawk loe hmaitik o moe, hmai angawt o: Piter doeh nihcae khaeah angdoet moe, hmai angawt toeng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kalen koek qaima mah Jesu khaeah a hnubang kaminawk hoi anih mah patuk ih hmuennawk kawng to dueng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu mah anih khaeah, Kai loe long khaeah kamtuengah lok ka thuih; Judahnawk amkhueng o haih sineko hoi tempul ah patukhaih ka sak toepsoep; tih lok doeh tamquta ah ka thui vai ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tih han ih kai lok nang dueng loe? Ka thuih ih lok thaih kaminawk khaeah dueng oh, khenah, nihcae khaeah tih lok maw ka thuih, ka thuih ih lok loe nihcae mah panoek o.
  </para>
  <para style="p">
    <verse number="22" style="v" />To tiah lok a thuih pacoengah, to ahmuen ah angdoe toksah angraeng maeto mah Jesu to tabaeng, kalen koek qaima ih lok to hae tiah maw na pathim? tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu mah anih khaeah, Kasae ka thuih nahaeloe, ka sethaih to na thui ah: loktang lok ni ka thuih, tikhoe kai nang tabaeng loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pacoengah Anna mah anih to taoengh moe, kalen koek qaima, Kaiapha khaeah patoeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Simon Piter loe angdoet moe, hmai angawt. To naah nihcae mah anih khaeah, Nang doeh anih hnukbang kaminawk thung ih maeto toeng na ai maw? tiah a naa o. Anih mah angphat taak, kai na ai ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kalen koek qaima ih tamna maeto ah kaom, Piter mah naa takroek pae pat ih tamna ih canawk maeto mah, nang loe Anih hoi nawnto takha thungah kaom kang hnuk ih kami na ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe Piter mah, angphat taak let bae: akra ai ah aakhong roep.
  </para>
  <para style="p">
    <verse number="28" style="v" />To pacoengah nihcae mah khawnthaw ah Jesu to Kaiapha im hoi lokcaekhaih im bangah caeh o haih: nihcae loe amhnong moeng tih, tiah poek o pongah, lokcaekhaih imthung ah caeh o ai; amhnong kaminawk loe misong loihaih poihkung ih buh to caa o thai mak ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />To pongah Pilat mah nihcae khaeah caeh moe, Tih zae nethaih maw oh moe, hae kami hae kai khaeah nang hoih o? tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nihcae mah anih khaeah, Sethaih sah kami ah om ai nahaeloe, anih hae nang khaeah kang hoi o tih maw? tiah a naa o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pilat mah nihcae khaeah, Anih hae hoi oh loe, nangmacae ih daan baktiah lokcaek oh, tiah a naa. Toe Judahnawk mah anih khaeah, Kaicae loe mi kawbaktih doeh hum thaihaih daan ka tawn o ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="32" style="v" />To tiah thuih ih lok loe, kawbaktih duekhaih hoiah maw Jesu dueh tih, tiah thuih ih lok akoephaih han ih ni oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pacoengah Pilat loe lokcaekhaih imthung ah akun let moe, Jesu to kawk, anih khaeah, Nang loe Judahnawk ih Siangpharang maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu mah anih khaeah, Nangmah koeh ah maw hae lok hae na thuih? To tih ai boeh loe kalah kaminawk mah maw kai kawng hae ang thuih o? tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pilat mah, Kai loe Judah kami ah maw ka oh? Nangmah ih kaminawk hoi kalen koek qaima mah ni nang hae kai khaeah ang thak o: timaw na sak? tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jesu mah, Ka mah siangpahrang ah ukkhaih prae loe hae long nuiah om ai: hae long hae ka ukhaih prae ah om nahaeloe, Judahnawk khaeah kai ang thak o han ai ah, ka tamnanawk mah tuh o tih: toe vaihi kai mah siangpahrang ah ukhaih prae loe hae long nuiah om ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pilat mah anih khaeah, To tih nahaeloe nang loe Siangpahrang takhae? tiah a naa. Jesu mah, Kai loe Siangpahrang ah ka oh, tiah na thuih ih lok loe amsoem. Kai loe loktang hnukung ah oh han ih ni, ka tapen moe, long ah kang zoh. Mi kawbaktih doeh loktang ah kaom kami mah loe, ka lok to tahngaih, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pilat mah anih khaeah, Loktang loe timaw? tiah a naa. Anih mah hae lok thuih pacoengah, Judahnawk khaeah tasa bangah caeh let moe, nihcae khaeah, Anih nuiah zaehaih tidoeh ka hnu ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />Toe nangmacae ih atawk baktih toengah misong loihhaih poih ah kami maeto kang prawt pae o han oh, to pongah Judah Siangpahrang hae kang prawt pae o han maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="40" style="v" />To naah nihcae boih mah, Hae kami na ai, Barabba to prawt ah, tiah a hangh o. Barabba loe mingcah ah oh.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />To naah Pilat mah Jesu to lak moe, a boh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Misatuh kaminawk mah soekhring lumuek sak pae o moe, a lu ah angmuek o sak, nihcae mah kahni kamling to angkhuk o sak,
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih hanah, Judah Siangpahrang, tiah a naa o. Anih to tabaeng o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilat loe Judahnawk khaeah caeh let moe, nihcae khaeah, Khenah, A nuiah zaehaih ka hnu ai, tiah na panoek o hanah, nangcae khaeah kang hoih, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu loe soekhring lumuek to angmuek moe, kahni kamling angkhuk pacoengah, tasa bangah angzoh. Pilat mah nihcae khaeah, Kami hae khen oh! tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kalen koek qaima hoi toksah angraengnawk mah Anih to hnuk o naah, Anih to thinglam pongah takhing ah! Anih to thinglam pongah takhing ah! tiah hang o. Pilat mah nihcae khaeah, A nuiah zaehaih ka hnu ai pongah, Anih to nangmacae mah hoi oh loe, takhing oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah Judahnawk mah anih khaeah, Kaicae loe daan ka tawnh o, angmah hoi angmah Sithaw Capa ah angsak pongah, kaimacae ih daan baktih toengah Anih loe duek han oh, tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pilat mah to lok to thaih naah, a zit aep:
  </para>
  <para style="p">
    <verse number="9" style="v" />lokcaekhaih imthung ah caeh let moe, Jesu khaeah, Naa hoiah maw nang zoh? tiah a naa. Toe Jesu mah lok pathim pae ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pilat mah anih khaeah, Lok nang pathim mak ai maw? Nang thinglam pong takhing thaih kami hoi loisak thaih kami ah ka oh, tito na panoek ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu mah, Ranui bang hoiah na paek ai nahaeloe, ka nuiah sakthaihaih tidoeh na tawn mak ai: to pongah nang khaeah Kai paek kami loe kalen kue zaehaih to tawnh, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naa hoi kamtong Pilat mah Anih loisak hanah loklam to pakrong: toe Judahnawk mah, Hae kami na loisak nahaeloe, nang loe Caesar ih ampui na ai boeh ni: mi kawbaktih doeh angmah hoi angmah siangpahrang ah angsah kami loe Caesar ih misa ni, tiah a naa o.
  </para>
  <para style="p">
    <verse number="13" style="v" />To lok to Pilat mah thaih naah, anih mah Jesu to tasa bangah hoih moe, thlung hoi sak ih lokcaekhaih tangkhang nuiah anghnut. To ahmuen loe Hebru lok ah Gabbatha, tiah thuih o.
  </para>
  <para style="p">
    <verse number="14" style="v" />To na ni loe misong loihhaih poih niah oh moe, atue tarukto oh duih boeh: Pilat mah Judahnawk khaeah, Nangmacae ih Siangpahrang hae khen oh! tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe nihcae mah, Anih to hoi ving ah, anih to hoi ving ah, anih to thinglam pongah takhing ah, tiah hang o. Pilat mah nihcae khaeah, Nangcae ih Siangphrang hae thinglam pongah ka takhing han maw? tiah a naa. To naah kalen koek qaima mah, Caesar ai ah loe siangpahrang ka tawn o ai, tiah pathim pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah Pilat mah Jesu to thinglam pong takhing hanah nihcae ban ah paek. Nihcae mah Jesu to lak o moe, a caeh o haih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih loe angmah ih thinglam to aput moe, luhuh (Hebru lok hoiah Golgotha,) tiah thuih ih ahmuen ah caeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />To ahmuen ah nihcae mah anih to thinglam pongah takhing o, banqoi bangah maeto bantang bangah maeto, kami hnetto anih hoi nawnto takhing o moe, Jesu loe a um ah takhing o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pilat mah, NAZARETH JESU, JUDAHNAWK IH SIANGPAHRANG, tiah angmathaih ca tarik pacoengah, thinglam pongah takhing.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu thinglam nuiah takhinghaih ahmuen loe vangpui hoiah zoidaek: to ih ca loe Hebrew, Grik, Latin lok hoiah tarik pongah, paroeai Judah kaminawk mah kroek o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Judahnawk ih kalen koek qaima mah Pailat khaeah, Judah Siangpahrang, tiah tarik hmah, hae kami mah, Kai loe Judah Siangpahrang ah ka oh, tiah thuih, tiah tarik hanah a thuih pae.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pilat mah, Ka tarik pacoeng boeh loe, tarik pacoeng ah ni oh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Misatuh kaminawk mah, Jesu thinglam pong takhing o pacoengah, anih ih kahni to lak o moe, palito ah tapraek o, misatoep kaminawk mah maeto kangbae ah lak o boih; anih ih kahni doeh lak pae o: to kahni loe lu hoi khok khoek to kasawkah sak ih kahniah oh pongah, huihhaih ahmaa to om ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nihcae mah, Kahni loe asik o hmah si, mi mah maw coe tih, tiah taham khethaih phoisa va o si, tiah maeto hoi maeto thuih o: nihcae mah kai ih kahni to amzet o moe, kang khuk ih kahni lak hanah taham khethaih phoisa to azuh o, tiah tarik ih Cabu akoep han ih ni, misatuh kaminawk mah to tiah sak o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu ih thinglam taengah, amno, amno ih amnawk, Kalopa ih zu Meri hoi Meri Magdalene cae to oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu mah toah kangdoe amno hoi anih mah palung ih a hnukbang kami to hnuk naah, amno khaeah, Nongpata, na capa hae khenah! tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pacoengah a hnukbang kami khaeah, Nam no hae khenah! tiah a naa. To nathuem hoi kamtong a hnukbang kami mah Jesu amno to angmah im ah caeh haih.
  </para>
  <para style="p">
    <verse number="28" style="v" />To pacoengah loe Jesu mah Cabu lok akoep hanah, hmuen boih sak pacoeng boeh, tiah panoek naah, Tui kang haeh, tiah a thuih.
  </para>
  <para style="p">
    <verse number="29" style="v" />To ahmuen ah misurtui kathaw laom maeto pongah pahung o: tui pazop thaih laprawn to misurtui kathaw thungah nup o, hyssop tadong ah takaek o moe, Anih ih pakha ah bah pae o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu mah misurtui kathaw to pataeng pacoengah, Pacoeng boeh, tiah thuih, to pacoengah luthuk moe, a hinghaih to qui apet.
  </para>
  <para style="p">
    <verse number="31" style="v" />To na ni loe amprikcaihaih niah oh, (Sabbath ni loe kasang niah oh), to pongah Sabbath niah thinglam pongah kami qok oh han om ai, Judahnawk loe nihcae ih khok to khaeh moe, a qok to lak hanah, Pilat khaeah caeh o moe, a hnik o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Misatuh kaminawk angzoh o moe, anih hoi nawnto takhing ih hmaloe koek kami maeto ih khok to khaeh pae o pacoengah, kalah maeto ih khok doeh khaeh pae o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe Jesu khae phak o naah, Anih loe duek boeh pongah, Anih ih khok loe khaek pae o ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Toe misatoep kami maeto mah tazae hoiah Anih ih panak to thunh, to naah athii hoi tui to tacawt.
  </para>
  <para style="p">
    <verse number="35" style="v" />To tiah kaom hmuen hnu kami mah hnukung ah ohhaih kawng to a thuih, anih mah thuih ih lok loe amsoem: na tang o thai hanah, anih mah thuih ih lok loe amsoem, tito anih mah panoek.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih ih ahuh maeto doeh angkhaek mak ai, tiah tarik ih Cabu lok akoep hanah, hae tiah hmuennawk to oh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kalah Cabu mah, A thunh o ih Anih to nihcae mah khen o tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="38" style="v" />To pacoengah Judahnawk zit pongah, tamquta hoi Jesu hnukbang kami, Arimathea avang ih Joseph mah, Pilat khaeah, Jesu ih qok lak hanah a hnik: Pilat mah lak han paek pongah, anih loe caeh moe, Jesu ih qok to lak.
  </para>
  <para style="p">
    <verse number="39" style="v" />Khoving ah Jesu khae kacaeh Nikodema doeh caeh toeng, anih mah myrrh hoi aloe kangbaeh boengloeng cumvaito kazit hmuihoih tui to sinh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nihhnik mah Jesu ih qok to lak hoi moe, aphum hanah Judahnawk mah sakzong ih atawk baktih toengah, hmuihoih tui hoi nawnto kahni hoiah ayaw hoi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anih thinglam nuiah takhinghaih ahmuen ah takha maeto oh; to takha thungah loe, mi doeh aphum vai ai ih, taprong kangtha maeto oh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Judahnawk amprikcaihaih niah oh moe, taprong doeh anghnai daek pongah, nihcae mah to ahmuen ah Jesu to aphum o.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Meri Magdalene loe, ni sarihto thung hmaloe koek ni, khawnthaw khoving ah taprong ah caeh, to naah kang khoe ving taprong kraenghaih thlung to a hnuk.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah Simon Piter hoi Jesu mah palung ih, kalah a hnukbang khaeah cawnh moe, nihnik khaeah, Taprong thung hoiah Angraeng to lak o ving boeh, naa ah maw a suek o, tito ka panoek ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah Piter hoi kalah a hnukbang kami hnik taprong ah caeh hoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihnik loe nawnto cawnh hoi: toe kalah a hnukbang maeto mah Piter to poengtaak ving moe, taprong ah phak hmaloe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih mah takhum tathuk moe, a thungah khet naah, kahni khue kaom to a hnuk; toe anih loe a thungah akun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah a cawnhtaak ih Simon Piter to phak, taprong thungah akun naah, kahni khue kaom,
  </para>
  <para style="p">
    <verse number="7" style="v" />a lu taengah suek ih pavawh loe kahni hoi nawnto om ai, angmah koehah ahmuen maeto ah nawnto amkhraep to a hnuk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Taprong ah pha hmaloe, kalah a hnukbang doeh a thungah akun toeng, anih mah hnuk naah, tanghaih to tawnh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe duekhaih thung hoi angthawk let tih, tiah thuih ih Cabu lok to nihcae mah panoek o ai vop.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah a hnukbang kami hnik loe angma hnik im ah caeh hoi let.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe Meri loe taprong taengah angdoet moe, qah: anih loe qah hoi takhum tathuk moe, taprong thungah khet,
  </para>
  <para style="p">
    <verse number="12" style="v" />to naah Jesu qok pasonghaih ahmuen ah, lu bangah maeto, akhok bangah maeto kanghnu, kanglung van kami hnik to a hnuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihnik mah anih khaeah, Nongpata tikhoe na qah loe? tiah a naa hoi. Anih mah nihnik khaeah, Ka Angraeng nihcae mah lak o ving boeh, anih loe naa ah maw a suek o, tito ka panoek ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To tiah a thuih pacoengah, anih loe hnukbang ah anghae, to naah kangdoe Jesu to a hnuk, toe Jesu ni, tito anih mah panoek ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu mah anih khaeah, Nongpata, tikhoe na qah loe? Mi maw na pakrong? tiah a naa. To kami loe takha tawnkung mue, tiah a poek pongah, anih khaeah, Patukkung, anih ih qok na lak nahaeloe, anih to naa ah maw na suek na thui ah, ka caeh moe, anih to ka lak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu mah anih khaeah, Meri, tiah a naa. To naah Meri mah angqoi moe, Anih khaeah Rabboni! (thuih koehhaih loe Patukkung, tih haih ih ni) tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu mah nongpata khaeah, Na sui hmah; Pa khaeah Ka caeh ai vop: toe kam nawkamyanawk khaeah caeh ah loe, nihcae khaeah, Kam Pa hoi nangcae ih Ampa; Ka Sithaw hoi nangcae ih Sithaw khaeah ka caeh han boeh, tiah a thuih, tiah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To naah Meri Magdalene loe caeh moe, a hnukbang kaminawk khaeah, Angraeng to ka hnuk boeh, Anih mah ni hae hmuennawk hae ang thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni sarihto thung ih ni hmaloe koek, to na ni duembang ah a hnukbang kaminawk amkhueng o, Judahnawk a zit o pongah thok to khah o, to naah Jesu angzoh moe, nihcae um ah angdoet pae, nihcae khaeah, Nangcae khaeah monghaih om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih mah to tiah thuih pacoengah, A ban hoi panak to nihcae khaeah patuek pae. Angraeng to a hnuk o naah, a hnukbang kaminawk poeknawm o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu mah nihcae khaeah, Nangcae khaeah monghaih om nasoe: Kam Pa mah ang patoeh baktih toengah, nangcae doeh kang patoeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />To tiah a thuih pacoengah, nihcae to anghah thuih moe, nihcae khaeah, Kacai Muithla talawk oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Minawk zaehaih na tahmen o nahaeloe, na zae o haih tahmen toeng tih, minawk zaehaih na tahmen o ai nahaeloe, na zaehaih doeh tahmen mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe kami hatlai hnetto thungah maeto (Didymu, tiah kawk ih) Thomas loe Jesu angzoh naah, nihcae hoi nawnto om ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pongah kalah a hnukbang kaminawk mah anih khaeah, Kaicae loe Angraeng ka hnuk o boeh, tiah a thuih pae o. Toe anih mah nihcae khaeah, Ban ah sum hoi takhing ih ahmaa to ka hnuk moe, sum hoi takhing ih ahmaa to ka banpazung hoi roe sui pacoengah, anih ih panak to ban hoi ka tapawh ai ah loe, ka tang mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />A hnukbang kaminawk loe ni tazetto pacoengah imthung ah amkhueng o let bae, to naah loe Thomas doeh nihcae khaeah oh boeh: thok khah o nathuem ah Jesu angzoh moe, nihcae um ah angdoet pae, Nangcae khaeah monghaih om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pacoengah Anih mah Thomas khaeah, Na banpazung to haeah payangh loe, ka bannawk hae khen ah; na ban to haeah payangh loe, ka panak hae tapawh ah: palunghaeng ai ah, tang ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah Thomas mah anih khaeah, Ka Angraeng, Ka Sithaw, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu mah anih khaeah, Thomas, na hnuk pongah ni, na tang: hnu ai ah tang kaminawk loe tahamhoih o, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu mah hae Cabu thungah tarik ai ih, kalah paroeai angmathaih doeh a hnukbang kaminawk hmaa ah sak pae:
  </para>
  <para style="p">
    <verse number="31" style="v" />toe Jesu loe Kri, Sithaw Capa ni, tiah na tang o moe, anih ih ahmin tanghaih rang hoiah hinghaih na tawn o thai han ih ni, hae canawk hae tarik ah oh.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jesu mah Tiberia tuipui ah a hnukbang kaminawk khaeah amtueng pae let.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toah Simon Piter, (Dydimu, tiah kawk ih) Thomas, Kalili prae Kana avang ih Nathanael, Zebedee ih caanawk, a hnukbang kalah hnetto oh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Simon Piter mah nihcae khaeah, Tanga haeng hanah ka caeh han, tiah a naa. Nihcae mah anih khaeah, Kaicae doeh kang zoh o toeng han, tiah a naa o. To pongah nihcae doeh caeh o moe, palong thungah akun o roep: toe to na aqum loe nihcae mah tidoeh naeh o ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khawnbang phak naah, Jesu loe tui taengah angdoet: toe Jesu ni, tito a hnukbang kaminawk mah panoek o ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu mah nihcae khaeah, Nawktanawk, caak koi na tawnh o maw? tiah a naa. Nihcae mah anih khaeah, Ka tawn o ai, tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah nihcae khaeah, Palong bantang bangah palok to haeng oh, na naeh o tih, tiah a naa. To pongah nihcae mah palok to haeng o, to naah palok zae thai ai khoek to pop parai ah tanga to a naeh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah Jesu mah palung ih a hnukbang kami mah Piter khaeah, Anih loe Angraeng bae! tiah a naa. Anih loe Angraeng ni, tiah thuih ih lok to Piter mah thaih naah, (anih loe bangkrai ah oh) pongah, laihaw kalen to angkhuk moe, tui thungah lungpung tathuk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kalah a hnukbang kaminawk loe anih hnukah palong hoiah angzoh o: (nihcae loe tuicing hoi angthla parai ai, lam quipangato thuemtham ni angthla,) palok koiah kaman tanga to saoeng bangah a zaeh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae saoeng bang phak o naah, tik ih hmai nuiah paaem ih tanga hoi takawnawk to a hnuk o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu mah nihcae khaeah, Vaihi pang na naeh o ih tanga to na sin oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Simon Piter loe palong nuiah dawh moe, tanga kalen ngai ah cumvai quipangato pacoeng, thumto kaman palok to tuicing bangah a zaeh: tanga loe pop parai, toe palok loe angsik ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesu mah nihcae khaeah, Angzo oh loe, buhcaa oh, tiah a naa. Angraeng ni, tiah panoek o boeh pongah, a hnukbang kami maeto mah doeh nang loe mi aa? tiah dueng o ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu loe angzoh moe, takaw hoi tanga to lak pacoengah, nihcae hanah a paek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae loe a duek moe, angthawk let pacoengah, a hnukbang kaminawk khaeah amtueng ih vai thumto haih ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nihcae buhcaak o pacoengah, Jesu mah Simon Piter khaeah, Jonah capa, Simon, hae hmuennawk pongah kai nang palung kue maw? tiah a naa. Piter mah, Ue, Angraeng; nang kang palung, tito na panoek, tiah a naa. Anih mah, Kai ih tuucaanawk hae pacah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu mahJonah capa, Simon, Kai nang palung maw? tiah vai hnetto a naa let. Piter mah, Ue, Angraeng; kang palung, tito na panoek, tiah a naa. Anih mah, Kai ih tuunawk hae pacah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu mahJonah capa, Simon, Kai nang palung maw? tiah vai thumto a naa let bae. Jesu mahkai nang palung maw? tiah vai thumto a naa pongah, Piter loe palungset. Piter mah anih khaeah, Angraeng, hmuennawk boih na panoek; nang kang palung, tito doeh na panoek, tiah a naa. Jesu mah anih khaeah, Kai ih tuunawk hae pacah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Loktang to, loktang ah, kang thuih, Na nawkta nathuem ah loe, nangmah hoi nangmah kahni nang khuk moe, na koeh ih ahmuen ah na caeh: toe na mitong naah loe, ban na payangh ueloe, kalah kami mah ni kahni to angkhuksak tih, na caeh koeh ai ih ahmuen ah na caeh haih tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />To tiah a thuih ih lok loe, Piter mah kawbaktih duekhaih hoiah maw Sithaw pakoeh tih, tiah thuih koehhaih ih ni. To tiah lok a thuih pacoengah, anih mah, Piter khaeah, Ka hnukah na bangah, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Piter hnukbang angqoi naah, anih hnukah kabang Jesu mah palung ih a hnukbang kami to a hnuk; anih loe duembuh caak o naah Jesu ih saoek nuiah amha moe, Angraeng, mi mah maw nang angphat taak tih? tiah lokdueng kami ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Piter mah to kami to hnuk naah Jesu khaeah, Angraeng, anih hae loe kawbangmaw om tih? tiah dueng.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu mah anih khaeah, Kai angzoh karoek to anih hingsak hanah ka koeh cadoeh, nang hoi timaw asaenghaih oh? Ka hnukah mah na bangah, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hae tiah thuih ih lok pongah, To a hnukbang kami loe, dueh mak ai, tiah nawkamyanawk salakah lok to amsong: toe Jesu mah anih khaeah, Nang loe na dueh mak ai, tiah thui ai; toe Kai angzoh karoek to anih hingsak hanah ka koeh cadoeh, nang hoi timaw asaenghaih oh? tiah ni a thuih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hae a hnukbang kami loe hae hmuennawk thuikung hoi tarikkung ah oh. Anih mah thuih ih lok loe amsoem, tiah ka panoek o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu mah sak ih kalah paroeai hmuennawk doeh oh vop, maeto doeh anghmat ai ah to hmuennawk to tarik boih si tih nahaeloe, tarik ih cabunawk suek hanah long acaeh mak ai, tiah ka poek.
  </para>
</usx>
