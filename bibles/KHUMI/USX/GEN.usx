<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Genesis</book>
  <para style="h">Genesis</para>
  <para style="toc1">Genesis</para>
  <para style="toc2">Genesis</para>
  <para style="mt">Genesis</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tangsuek naah Sithaw mah van hoi long to sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Long loe tungkrang om ai, kong sut; kaving loe kathuk nuiah oh. Sithaw ih Muithla loe tui nuiah angtawt.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sithaw mah, Aanghaih om nasoe, tiah thuih pongah, Aanghaih to oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw mah aanghaih to hnuk naah hoih, tiah thuih; Sithaw mah aanghaih to kaving thung hoiah tapraek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka-aang to Sithaw mah Khodai, tiah kawk moe, kaving to Khoving, tiah kawk. To tiah duem hoi khawn to oh moe, amtong tangsuekhaih niah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw mah, Tuinawk um ah van hma to om nasoe loe, tui thung hoiah tui to ampraek nasoe, tiah thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah Sithaw mah van hma to sak moe, van hma tlim ih tui hoi van hma ranui ih tui to tapraek; a thuih ih lok baktih toengah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sithaw mah van hma to van, tiah kawk; to tiah duem hoi khawn to oh; to loe ni hnetto haih ah oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sithaw mah, tuinawk loe van tlim ah nawnto angcu o nasoe loe, saoeng to amtueng nasoe, tiah thuih; a thuih ih lok baktih toengah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw mah kaphui long to saoeng, tiah kawk moe, nawnto angcuu tui to tuipui, tiah kawk; a sak ih hmuen to Sithaw mah hnuk naah hoih, tiah thuih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw mah, Saoeng nuiah phroh, amuu kaom aan kahingnawk, amuu kaom thingthai congca kathai thingkungnawk to amprawk o nasoe, tiah thuih; a thuih ih lok baktih toengah oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Long ah phroh to amprawk, amuu kaom aan congca hoi thingthai congca to amprawk o; a sak ih hmuen to Sithaw mah hnuk naah hoih, tiah thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Duem hoi khawn to oh, to loe ni thumto haih ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sithaw mah, khoving thung hoi khodai to tapraek hanah, van hma ah aanghaih to om nasoe, atuenawk, aninawk, saningnawk loe angmathaih ah om nasoe,
  </para>
  <para style="p">
    <verse number="15" style="v" />long to aanghaih paek hanah van hma ah aanghaih to om nasoe, tiah thuih; a thuih ih lok baktih toengah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sithaw mah aanghaih paekkung kalen hnetto sak, kalen kue khodai ukkung ka-aang hoi kathoeng kue khoving ukkung ka-aang to a sak; cakaehnawk doeh a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Long to aanghaih paek hanah, to aanghaih to Sithaw mah van hma ah suek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khodai hoi khoving to uk moe, khoving thung hoi khodai to tapraek hanah, to tiah a suek; a sak ih hmuen to Sithaw mah hnuk naah hoih, tiah thuih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Duem hoi khawn to oh, to loe ni palito haih ah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sithaw mah, tui thungah Hinghaih katawn, kangtawt thaih moi congca to om nasoe loe, long ranui ah kaom kawk parai van hma ah tavaanawk to azawk o nasoe, tiah thuih.
  </para>
  <para style="p">
    <verse number="21" style="v" />To tiah Sithaw mah kalen parai tuipui thungah tanga pui, hinghaih katawn angtawt thaih moi congca hoi azawk thaih tava congca doeh pungsak; a sak ih hmuen to Sithaw mah hnuk naah hoih, tiah thuih.
  </para>
  <para style="p">
    <verse number="22" style="v" />To a sak ih moinawk to Sithaw mah tahamhoihaih paek, Athaih pop nasoe loe, tuipui koi mongah pung o nasoe, tavaanawk doeh long ah pung o nasoe, tiah thuih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Duem hoi khawn to oh, to loe ni pangato haih ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sithaw mah, Hinghaih tawn pacah ih moi congca, long ah kavak moinawk, taw ah kaom congca moinawk loe long mah pungsak nasoe, tiah thuih; a thuih ih lok baktih toengah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sithaw mah taw ih congca moi, pacah ih congca moi, long ah kavak angtawt thaih congca moi to sak; a sak ih hmuen to Sithaw mah hnuk naah hoih, tiah thuih.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pacoengah Sithaw mah, Kami hae aimacae tungkrang baktih, aimacae hoi kanghmong ah sah si loe, tuipui thung ih tanganawk, van ih tavaanawk, long ah pacah ih moinawk, long ah kavak moinawk boih to uk nasoe, tiah thuih.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pongah Sithaw mah kami to angmah ih tungkrang baktih toengah sak; Sithaw krang hoi kanghmong ah nongpa hoi nongpata to sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sithaw mah, nihnik khaeah, Athaih athai hoih, pung hoih, long ah koi hoi ah loe, long to uk hoih; tuipui thung ih tanganawk, van ih tavaanawk, long nuiah kavak hinghaih katawn moinawk boih to uk hoih, tiah tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="29" style="v" />To pacoengah Sithaw mah, Khenah, long pum ah amuu kaom ann congca, thingthaikung congca to kang paek; to hmuennawk loe nang hnik ih buh ah om tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na caak hoi hanah, long ah kaom taw ih moinawk boih, van ih tavaanawk boih, long ah kavak hinghaih tawn moinawk boih, anqam congca to kang paek, tiah a naa. A thuih ih lok baktih toengah oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A sak ih hmuennawk boih Sithaw mah khet naah, Hoih parai, tiah thuih. Duem hoi khawn to oh, to loe ni tarukto haih ah oh.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />To tiah van hoi long, to ah kaom hmuennawk boih to a sak pacoeng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni sarihto naah loe Sithaw mah a sak ih tok to pacoengh, to pongah ni sarihto naah loe a toksakhaih boih thung hoiah anghak.
  </para>
  <para style="p">
    <verse number="3" style="v" />A sak ih tok boih thung hoiah Sithaw anghakhaih niah oh pongah, sarihto ni to Sithaw mah tahamhoihaih paek moe, ciimcaisak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng Sithaw mah van hoi long sak na niah, van hoi long sakhaih kawngnawk loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng Sithaw mah long nuiah kho angzosak ai pongah, long ah thingkung to om ai, aan doeh amprawk ai; long ah toksah kami doeh om ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe long thung hoiah tui to tacawt pongah, long to tui mah duksak boih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng Sithaw mah long ih maiphu hoiah kami to sak moe, anih ih hnahkhaw thungah hinghaih takhi to uengh pae; to naah hinghaih tawn kami ah angcoeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng Sithaw mah ni angyae bang ih Eden ah takha maeto sak; to ah a sak ih kami to a suek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng Sithaw mah to long thung hoiah khet kahoih, caak kahoih thingkung congca to amprawksak; hinghaih thingkung hoi kasae kahoih panoekhaih thingkung doeh takha um ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Takha tui paek hanah Eden takha thung hoiah vapui maeto longh; to ahmuen hoiah ampraek moe, vapui sip palito ah angphae.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmaloe koek ih ahmin loe Pishon; to vapui loe sui ohhaih, Havilah prae thung boih ah longh.
  </para>
  <para style="p">
    <verse number="12" style="v" />To prae thung ih sui loe hoih; to ah loe bdellium hmuihoih thing hoi onyx thlungnawk doeh tacawt.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hnetto haih vapui ahmin loe Gihon; to vapui loe Ethiopia prae thung boih ah longh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thumto haih vapui ahmin loe Hiddekel; to loe Assyria prae ni angyae bangah longh. Palito haih vapui loe Euphrates.
  </para>
  <para style="p">
    <verse number="15" style="v" />Eden takha to khetzawn moe, to ah toksak hanah, Angraeng mah kami to lak moe, takha thungah anih to suek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng Sithaw mah kami khaeah, Takha thungah kaom thingkung hoi tacawt athaihnawk boih to na caak thaih;
  </para>
  <para style="p">
    <verse number="17" style="v" />toe kasae kahoih panoekhaih thingthai loe na caa mak ai; na caak niah na dueh tangtang tih, tiah lokpaek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angraeng Sithaw mah, Kami loe angmabueng oh han hoih ai; anih han kamcuk bomkung maeto ka sak pae han, tiah thuih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng Sithaw mah long hoiah sak ih taw ih moinawk boih, van ih tavaanawk boih to khetzawn moe, ahmin phui hanah, Adam khaeah sinh pae; kahing moi loe, Adam mah sak ih ahmin baktih toengah ahmin tawnh o boih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adam mah moinawk, van ih tavaanawk hoi taw ih moinawk boih to ahmin sak; toe Adam loe angmah hoi kamcuk bomkung to tawn ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Angraeng Sithaw mah Adam to iih angmuetsak parai pongah, anih loe iih; anih ih panak huh maeto a lak pae, a lak ih ahmuen ah ngan to pacong pae let.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng Sithaw mah kami khae hoi lak ih, panak huh hoiah nongpata to sak moe, anih to nongpa khaeah a caeh haih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Adam mah, Hae loe ka huhnawk thung ih ahuh, ka ngan thung ih ngan ah oh; anih loe Nongpa thung hoiah lak ah oh pongah, Nongpata, tiah kawk han oh, tiah thuih.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah nongpa mah ampa hoi amno to caehtaak ueloe, a zu to la tih, to naah nihnik loe takpum maeto ah om hoi tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nongpa hoi a zu loe bangkrai ah oh hoi, toe azathaih tawn hoi ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pahui loe Angraeng mah sak ih moi kasan boih thungah aling thaih koek ah oh. Anih mah nongpata khaeah, Takha thungah kaom thingkung hoiah kathai athaih to caa hoi boih hmah, tiah Sithaw mah thuih tangtang maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nongpata mah pahui khaeah, Takha thungah kaom thingkungnawk hoiah kathai athaih to ka caak hoi thaih;
  </para>
  <para style="p">
    <verse number="3" style="v" />toe Sithaw mah, Takha um ah kaom thingkung pong ih athaih loe caa hoi hmah, sui doeh sui hoi hmah, na dueh hoi tih, tiah thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pahui mah nongpata khaeah, Na dueh hoi tangtang mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na caak hoi niah na mik to amtueng ueloe, sithawnawk baktih toengah, kasae kahoih na panoek hoi toeng tih, tiah Sithaw mah panoek pongah ni, to tiah ang thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nongpata mah thingkung loe caak han kahoih thingkung ah a hnuk, mik hoiah khit moe, palunghahaih paek thaih thingkung ah oh pongah, thingthai to pakhrik moe, a caak, a sava han doeh a paek; anih mah doeh caak toeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah nihnik ih mik to amtueng, nihnik loe bangkrai ah ni ka oh hoi, tiah panoekhaih to a tawnh hoi boeh; to naah thaiduet qamnawk to a huih hoi moe, kaeng ah angzaeng hoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni amding ruehaih atue phak naah loe, takha thungah amkae Angraeng Sithaw ih atuen to a thaih hoi: Adam hoi anih ih zu mah Angraeng to takha thung ih thingkungnawk salakah anghawk hoi taak ving.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng Sithaw mah Adam to kawk, anih khaeah, Naa ah maw na oh? tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah, Takha thungah na lok to ka thaih, bangkrai ah ka oh pongah, zithaih ka tawnh moe, kang hawk ving boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah, bangkrai ah na oh, tiah mi mah maw ang thuih? Caa hmah tiah kang thuih ih thingthai to na caak ving boeh tani? tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah Adam mah, Kai han nang paek ih nongpata mah thingkung pong ih athaih to ang paek moe, ka caak, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng Sithaw mah nongpata khaeah, Tipongah hae tiah na sak loe? tiah a naa. Nongpata mah, Pahui mah ang ling pongah, ka caak, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Angraeng Sithaw mah pahui khaeah, Hae hmuen hae na sak boeh pongah, Moinawk boih, taw ih moisannawk boih pongah tangoenghaih na zok boeh; nang loe zok hoiah avak ueloe, na hing thung maiphu to na caa tih boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang hoi nongpata salak, na tii hoi nongpata ih atii salak misa ah ka suek han; anih mah na lu to ati tih, nang mah anih ih khok tahmawh to na patuk pae tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nongpata khaeah, Zok na pomh naah nathaih kating ai kang pungsak han, kana pauephaih hoiah caa na sah tih; na sava koehhaih palung loe boeng mak ai, anih mah na uk tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Adam khaeah, Na zu ih lok to na tahngaih moe, Caa hmah, tiah kang thuih ih thingthai to na caak boeh pongah, nang pongah long loe tangoenghaih zok boeh; na hing thung patanghaih hoi toksak naah ni buh na caa tih boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang han soekhring congca kam prawksak han; lawk ih aannawk to na caa tih;
  </para>
  <para style="p">
    <verse number="19" style="v" />long hoiah nang zoh baktih toengah, long ah nam laem let ai karoek to, na mikhmai ah angsatui long naah ni buh na caa vop tih; maiphu ah na oh pongah, maiphu ah nam laem let tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahing kaminawk boih ih amno ah oh pongah, Adam mah a zu to Evi, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="21" style="v" />Angraeng Sithaw mah Adam hoi a zu hanah, moihin kahni to sak pae moe, angkhuksak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng Sithaw mah, Khenah, kami loe kasae kahoih panoekhaih bang ah, aicae thung ih kami maeto baktiah oh toeng boeh; vaihi anih mah ban payangh ueloe, dungzan ah hing hanah thingthai to pakhrik pacoengah, caa moeng tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah angmah tacawthaih long ah toksak hanah, Angraeng Sithaw mah kami to Eden takha thung hoiah haek ving.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kami to haek pacoengah, hinghaih thingkung loklam to toep hanah, Cherubimnawk hoi ahnuk ahma angmet thaih hmai sumsen to Eden takha ni angyae bang ah a suek.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam mah a zu Evi to iih haih, anih loe zokpom moe, Kain to tapen; to naah anih mah, Angraeng khae hoi kami maeto ka hnuk boeh, tiah thuih.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah anih mah amnawk Abel to sak let. Abel loe tuu toep kami ah oh, toe Kain loe lawkphrawk kami ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Atue phak naah, Kain mah hmuenpaekhaih maeto ah long hoi tacawt thingthai to Angraeng khaeah sinh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abel mah doeh tapen tangsuek, kathawk tuu to sinh toeng. Abel mah paek ih hmuen to Angraeng mah talawk pae;
  </para>
  <para style="p">
    <verse number="5" style="v" />toe Kain mah paek ih hmuen loe talawk pae ai. To pongah Kain loe palungphui parai moe, mikhmai set.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Angraeng mah Kain khaeah, Tipongah palung na phui loe? Tipongah mikhmai na set?
  </para>
  <para style="p">
    <verse number="7" style="v" />Katoeng hmuen na sak nahaeloe, nang to talawk ai ah om tih maw? Katoeng ah na sah ai pongah, zaehaih loe thok taengah tabok boeh. Anih mah loe na koehhaih to paroi tih, toe anih to na pazawk han angaih, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kain mah amnawk Abel khaeah, Lawk ah caeh si, tiah naa. Lawk ah a oh hoi naah, Kain mah amnawk Abel to hmang moe, hum ving.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng mah Kain khaeah, Nam nawk Abel naa ah maw oh? tiah naa. Anih mah, Ka panoek ai; kai loe kam nawk toepkung ah maw ka oh? tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng mah, Timaw na sak? Nam nawk ih athii mah long hoiah Kai ang palawk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vaihi na ban hoi palong ih nam nawk ih athii to talawk hanah, pakha aang long mah tangoeng haih to na zok boeh pongah,
  </para>
  <para style="p">
    <verse number="12" style="v" />vaihi hoi kamtong long ah tok na sak naah, long mah nang hanah thingthai tacawtsak mak ai boeh; nang loe long nuiah avak rumram hoi kamhet rumram kami ah ni na om tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kain mah Angraeng khaeah, Nang thuitaekhaih loe, pauep thai ai khoek to ah lenh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khenah, vai hniah long hoiah nang haek boeh pongah, na hmaa hoiah kang hawk ving han boeh; long nuiah avak rumram hoi kamhet rumram kami ah ka oh naah, kai hnu kaminawk boih mah na hum o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe Angraeng mah anih khaeah, To pongah mikawbaktih doeh Kain hum kami loe, a nuiah alet sarihto lu lakhaih om tih, tiah a naa. Kain hnu kaminawk mah anih to hum o han ai ah, Angraeng mah Kain nuiah angmathaih to sak pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah Kain loe Angraeng hmaa hoi tacawt moe, Eden takha ni angyae bang ah kaom Nod prae ah khosak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kain mah a zu to iih haih; a zu loe zokpom moe, Enok to sak; Kain mah vangpui maeto sak, a capa ih ahmin to lak moe, vangpui to Enok, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Enok mah Irad to sak; Irad mah Mehujael to sak; Mahujael mah Methusael to sak; Methusael mah Lamek to sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lamek loe zu hnetto lak; a zu ih ahmin loe Adah; kalah zu maeto ih ahmin loe Zillah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adah mah Jabal to sak; anih loe kahni im ah om kami hoi pacah ih moinawk toepkung ampa ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amnawk ih ahmin loe Jubal; anih loe katoeng, tamoi kruek kami ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zillah mah doeh capa Tubal-Kain to sak; anih loe sum kamling hoi sum kanglung daeng kami ah oh; Tubal-Kain ih tanuh loe Naamah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lamek mah a zu, Adah hoi Zillah hnik khaeah, Lamek ih zu hnik, ka lok hae tahngai hoih; ka thuih ih lok hae tahngai hoih; kai ahmaa caasak kami, kai pacaekthlaek thendoeng maeto ka hum boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kain hum kami to alet sarihto lu lak han om nahaeloe, Lamek mah loe alet qui sarih, vai sarihto lu laa tih, tiah thuih pae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adam mah a zu to iih haih let, a zu mah capa maeto sak; Kain mah hum ih Abel zuengah Sithaw mah capa maeto ang paek, tih ah a thuih pongah, a capa to Seth, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="26" style="v" />Seth mah doeh capa maeto sak; a capa to Enos, tiah ahmin sak; to nathuem hoi kamtong kaminawk mah Angraeng ih ahmin to palawk amtong o.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam ih caanawk anghumhaih kawng loe hae tiah oh. Sithaw mah kami sak naah, Sithaw angmah krang hoi kanghmong ah anih to sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nongpa hoi nongpata to a sak moe, nihnik to tahamhoihaih paek; nihnik sak na niah nihnik ih ahmin to Adam, tiah ahmin paek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Adam loe saning cumvai, qui thumto hing naah, angmah baktiah kaom, angmah krang hoi kanghmong capa maeto sak; anih ih ahmin to Seth, tiah a sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Seth tapen pacoengah, Adam loe saning cumvai tazetto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="5" style="v" />Adam loe saning cumvai takawt, qui thumto hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Seth loe saning cumvaito pacoeng, pangato hing naah, Enos to sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Enos tapen pacoengah, Seth loe saning cumvai tazet, pangato hing moe, kalah capa hoi canunawk doeh a sak vop.
  </para>
  <para style="p">
    <verse number="8" style="v" />Seth loe saning cumvai takawt, hatlai hnetto hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Enos loe saning qui takawtto hing naah, Kainan to sak;
  </para>
  <para style="p">
    <verse number="10" style="v" />Enosh loe Kainan tapen pacoengah, saning cumvai tazet, hatlai pangato hing moe, kalah capa hoi canunawk doeh sak vop;
  </para>
  <para style="p">
    <verse number="11" style="v" />Enos loe saning cumvai takawt, pangato hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kainan loe saning qui sarihto hing naah, Mahalalel to sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mahalalel tapen pacoengah Kainan loe, saning cumvai tazet, qui palito hing moe, kalah capa hoi canunawk doeh a sak vop.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kainan loe saning cumvai takawt, hato hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahalalel loe saning qui taruk, pangato hing naah, Jared to sak;
  </para>
  <para style="p">
    <verse number="16" style="v" />Mahalalel loe Jared tapen pacoengah, saning cumvai tazet, qui thumto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mahalel loe saning cumvai tazet, qui takawt, pangato hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jared loe saning cumvai qui taruk, hnetto hing naah, Enok to sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jared loe Enok tapen pacoengah, saning cumvai tazetto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jared loe saning cumvai takawt, qui taruk, hnetto hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Enok loe saning qui tarukto pacoeng, saning pangato hing naah, Methuselah to sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Enok loe Methuselah tapen pacoengah, saning cumvai thumto thung Sithaw hoi nawnto lam caeh; to pacoengah doeh kalah capa hoi canunawk to sak vop.
  </para>
  <para style="p">
    <verse number="23" style="v" />Enok loe saning cumvai thum, qui tarukto pacoeng, pangato hing.
  </para>
  <para style="p">
    <verse number="24" style="v" />Enok loe Sithaw hoi nawnto lam caeh pacoengah, Sithaw mah lak ving boeh pongah, om ai boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Methuselah loe saning cumvai qui tazetto pacoeng, sarihto hing naah, Lamek to sak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Methuselah loe Lamek tapen pacoengah, saning cumvai sarih, qui tazet, hnetto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="27" style="v" />Methuselah loe saning cumvai takawt, qui taruk, saning takawtto hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lamek loe saning cumvai qui tazet, hnetto hing naah, capa maeto sak;
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng mah tangoeng ih long ah, ban hoi toksak patangh naah, anih mah monghaih na paek tih, tiah a poek pongah anih ih ahmin to Noah, tiah sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lamek loe Noah tapen pacoeng, saning cumvai panga, qui takawt, pangato hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lamek loe saning cumvai sarih, qui sarih, sarihto hing pacoengah duek.
  </para>
  <para style="p">
    <verse number="32" style="v" />Noah loe saning cumvai pangato hing naah, Shem, Ham hoi Japheth to sak.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Long ah kaminawk pung o aep aep naah, nihcae mah canunawk to sak o,
  </para>
  <para style="p">
    <verse number="2" style="v" />Sithaw capanawk mah kami canunawk to kranghoih parai ah hnuk o; angmacae koeh ih kami to qoih o moe, zu ah lak o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah Angraeng mah, Kami loe taksa ah oh pongah, nihcae khaeah kai ih Muithla om poe mak ai; toe a hinghaih loe saning cumvai, pumphaeto ni om tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="4" style="v" />To nathuem ah kalen parai kaminawk long ah khosak o; to pacoengah doeh, Sithaw capanawk loe kami canunawk khaeah caeh o moe, nihcae hoiah caa tapen o; to kaminawk loe canghnii ah thacak kami hoi ahmin kamthang kami ah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Long nuiah kami zaehaih to pung, boeng thai ai kasae hmuen khue ni palung thungah a poek, tiah Angraeng mah hnuk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Long ah a sak ih kami nuiah dawnpakhuem moe, palungset.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah Angraeng mah, Long nuiah ka sak ih, kami, taw ih moi, long ah avak hmuen hoi van ih tavaanawk to ka tamit boih han boeh; nihcae ka sak pongah, dawnpakhuemhaih ka tawnh, tiah a thuih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe Noah loe Angraeng mikcuk naakrak ah khosak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Noah kawng loe hae tiah oh; Noah loe koephaih tawn kami ah oh moe, angmah dung ah kaom kaminawk thungah coek koi om ai kami, Sithaw hoi nawnto lam caeh kami ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Noah mah capa thumto sak; Shem, Ham hoi Japheth.
  </para>
  <para style="p">
    <verse number="11" style="v" />Long loe Sithaw hmaa ah amro boeh moe, athii longhaih hoiah koi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sithaw mah long to khet naah, set parai boeh, long kaminawk doeh kasae loklam khue ni pazui o boeh, tito a hnuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah Sithaw mah Noah khaeah, Long loe athii longhaih hoiah koi sut boeh pongah, taksa ah kaom kami amro boihhaih to ka hmaa ah phak boeh; khenah, nihcae to long hoi nawnto kam rosak han.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah kophar thing hoiah palong to sah ah; a thungah ohhaih imkhaan to sah loe, a thung hoi a nui to hmaica thing tangpri hoiah pazut ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Palongpui loe hae tiah sah ah; palong loe kasawk dong cumvai thum; kakawk dong qui panga hoi dong qui thumto sangsak ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Palong imphu to sah ah loe, na sak pacoengah dongto kasang thokbuem to pathlung ah; thokbuem sak hanah palong panak bangah pathlung ah loe, atlim koek asom, hnetto haih asom hoi asom thumto ah sah ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khenah, Van tlim ah kaom hinghaih takhi tawn moi boih, long ah kaom sak ih hmuennawk to paduek boih hanah, long tui uemhaih to ka phaksak han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Kai loe nang hoi lokmaihaih to ka caksak han; nang loe na capanawk, na zu hoi na capanawk ih zunawk boih hoi nawnto palong thungah akun ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hinghaih tawn hmuennawk boih thung hoiah amno hoi ampa kacung ah lah loe, nangmah hoi nawnto hing hanah, palong thungah caeh haih ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kanghmong tavaanawk, kanghmong moinawk, kanghmong long ah avak moinawk boih, hing hanah amno hoi ampa kacung ah nang khaeah angzo o tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nangmacae hoi moinawk mah caak hanah, caak koi hmuen congca to patung ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sithaw mah thuih ih lok baktih toengah, Noah mah sak.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Noah khaeah, Nangmah hoi na imthung takoh boih palong thungah akun oh; nang loe ka hmaa ah vaihi dung ih kaminawk salakah kami katoeng ah kang hnuk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Long nuiah taw ih moi atii anghmat ving han ai ah, atii kamghnong kaciim moi to amno hoi ampa sarihto, acaeng kanghmong kaciim ai moi doeh amno hoi ampa hnetto,
  </para>
  <para style="p">
    <verse number="3" style="v" />atii kanghmong van ih tavaa doeh amno hoi ampa sarihto ah la boih ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vaihi hoi ni sarihto thungah, long ah ni qui palito hoi qum qui palito thung kho kang oihsak moe, long nuiah kaom ka sak ih kahing hmuennawk to kam rosak boih han, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah thuih ih lok baktih toengah Noah mah sak boih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Long to tui mah uem naah, Noah loe saning cumvai tarukto oh boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tui len pongah, Noah mah a capanawk, a zu hoi a capanawk ih zu boih, palong thungah akun haih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaciim hoi kaciim ai moinawk, tavaanawk hoi long ah kavak moinawk boih,
  </para>
  <para style="p">
    <verse number="9" style="v" />Sithaw mah Noah khaeah thuih ih lok baktih toengah, amno hoi ampa hnetto kacung ah, Noah hoi nawnto palong thungah akun o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni sarihto pacoengah loe long nuiah tui uemhaih to phak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noah hinghaih saning cumvai tarukto koephaih saning, khrah hnetto haih, ni hatlai sarihto naah, kalen hoi kathuk long thung hoiah tui to puek moe, van thokbuemnawk to am-ongh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni qui palito hoi qum qui palito long nuiah kho angzoh.
  </para>
  <para style="p">
    <verse number="13" style="v" />To na niah Noah loe a capa Shem, Ham hoi Japheth, a zu hoi a capa thumto ih zunawk,
  </para>
  <para style="p">
    <verse number="14" style="v" />Moi kasannawk, pacah ih moinawk boih, long ah kavak moi, pakhraeh tawn tavaanawk loe Noah hoi nawnto palong thungah akun o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinghaih tawn, moinawk boih loe hnetto kacung ah, Noah khaeah caeh o moe, palong thungah akun o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sithaw mah Noah khaeah thuih ih lok baktih toengah, moinawk boih amno hoi ampa kacung ah, Noah khaeah palong thungah akun o; to pacoengah Angraeng mah anih to thok khah thuih khoep.
  </para>
  <para style="p">
    <verse number="17" style="v" />Long loe ni qui palito thung tui mah uem; kalen aep aep tui mah palong to long ranui ah atoengh tahang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tui loe len moe, long ranui bangah sang tahang aep aep; tui mah palong to long ranui ah atoengh tahang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Long nuiah tui len parai pongah, van tlim ah kaom, maesangnawk to tui mah uem boih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mae ranuih dong hatlai panga karoek to tui mah uengh tahang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Long ah kaom angtawt thaih moinawk, tavaanawk, pacah ih moinawk, taw ih moisannawk, long ah kavak moinawk hoi kaminawk to duek o boih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Saoeng ah kaom, hnah hoi anghahaih takhi tawn moinawk to duek o boih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Long nuiah kaom kahing hmuennawk, kami, pacah ih moi, long ah kavak moinawk, van ih tavaanawk to tamit boih; Noah angmah, anih hoi nawnto kaom kaminawk khue ni anghmat o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tui mah long to ni cumvai, qui pangato thung uem.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Toe Sithaw mah kahing hmuennawk boih, Noah hoi nawnto kaom moinawk boih to pahnet ai; long nuiah takhi to songsak pongah, tui to anghak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kathuk thung ih tuipueknawk hoi van ih thokbuemnawk to anghak moe, van hoi angzo kho to dip.
  </para>
  <para style="p">
    <verse number="3" style="v" />Long asom ih tui to kaang tathuk; ni cumvai, qui pangato pacoengah, tui to amsah tathuk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khrah sarihto, ni hatlai sarihto naah, palong to Ararat mae nuiah angtang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khrah ha karoek to tui to amsah tathuk, khrah hato haih hmaloe koek niah loe kasang maenawk to amtueng boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ni qui palito pacoengah, Noah mah a sak ih palong thokbuem to paongh;
  </para>
  <para style="p">
    <verse number="7" style="v" />pangaah maeto a prawt, pangaah loe long nuiah tui kang ai karoek to, ahnuk ahma azawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah long nuiah tui kaang boeh maw tiah panoek hanah, pahuu maeto a prawt let;
  </para>
  <para style="p">
    <verse number="9" style="v" />toe long to tui mah khuk boih vop pongah, acukhaih ahmuen to hnu ai; to pongah a ohhaih palong ah amlaem let; to pacoengah Noah mah ban to payangh moe, pahuu to angmah khaeah palong thungah lak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni sarihto zing pacoengah, pahuu to palong thung hoiah a prawt let.
  </para>
  <para style="p">
    <verse number="11" style="v" />Duembang ah loe pahuu to angmah khaeah amlaem let, khenah, pahuu loe tahmawh ah olive thingqam to koeng; to naah long nuiah tui to kaang tathuk boeh, tiah Noah mah panoek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni sarihto zing pacoengah, pahuu to a prawt let; to pacoengah loe pahuu to angmah khaeah amlaem let ai boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Saning cumvai taruk, maeto, khrahto haih, ni tangsuek naah long nui ih tui to kaang tathuk; Noah mah palong imphu to khok moe, a khet naah, long nuiah tui to kaang boeh, tiah a hnuk.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khrah hnetto haih, ni pumphaeto pacoeng, sarihto naah, long nuiah tui to kaang boih boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah Sithaw mah Noah khaeah,
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmah hoi na zu, na capanawk hoi na capanawk ih zunawk, palong thung hoiah tacawt o laih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang hoi nawnto kaom hinghaih tawn hmuennawk, moinawk boih, tavaanawk, pacah ih moinawk hoi long ah kavak hmuennawk boih tacawt haih ah; long ah caa kapop ah sah o nasoe, thingthai athai o nasoe loe, long nuiah pung o nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah Noah loe a caanawk, a zu hoi a caanawk ih zunawk hoi nawnto tacawt o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Moi kasannawk boih, long ah kavak hmuennawk boih, tavaanawk boih, atii kanghmong long ah kavak moinawk boih, palong thung hoiah tacawt o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah mah Angraeng hanah hmaicam to sak; kaciim moi, kaciim tavaa to a lak pacoengah, hmai hoi angbawnhaih to a sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />To tiah hmai angbawnhaih to Angraeng mah hmuihoih ah thaih pae naah, Angraeng mah palung thung hoiah, Kami mah nawkta nathuem hoiah poekhaih kasae tawn cadoeh, kami hanah long hae ka tangoeng let mak ai boeh; ka sak ih hmuen baktih toengah, kahing hmuennawk to natuek naah doeh kam rosak mak ai boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Long oh nathung, antii haehhaih tue, thingthai qumpo lakhaih tue, kangqai tue, kabae tue, nipui tue hoi sik tue, khodai hoi khoving to natuek naah doeh boeng mak ai boeh, tiah thuih.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw mah Noah hoi a caanawk to tahamhoihaih paek, nihcae khaeah, athaih athai oh, pung oh loe, long ah koi oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Long nui ih moi boih, van ih tavaa boih, kavak angtawt thaih long nui ih moi boih, tuipui nui ih tanganawk boih mah, nangcae to zii o ueloe, tasoeh o tih; to moinawk to nangcae ban ah kang paek boih boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kangtawt moe, hinghaih tawn angtawt thaih hmuen boih to nang hanah buh ah om tih; kahing aannawk hoi hmuen boih nangcae hanah kang paek boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe hinghaih tawn moi ih athii to caa o hmah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na hing o haih, nangcae ih athii to ka suk han; kami hoi moinawk to lok ka caek boih han; kami boih mah angmacae nawkamya ih athii to palong o pongah lok ka caek han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sithaw angmah ih krang hoi kanghmong ah kami to sak pongah, kami ih athii palong kami loe, anih doeh kami mah athii longsak toeng tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe nang loe, thingthai athai ah loe, pung ah; long ah caa sah o mang ah loe, pung oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah Sithaw mah Noah hoi a caanawk khaeah,
  </para>
  <para style="p">
    <verse number="9" style="v" />Khenah, nang hoi lokmaihaih to ka sak moe, nang pacoeng kaom na caanawk,
  </para>
  <para style="p">
    <verse number="10" style="v" />nang hoi nawnto kaom hinghaih tawn moinawk, tavaanawk, pacah ih moinawk, long ih moisannawk boih, palong thung hoi tacawt moinawk boih, long ih moinawk boih hoiah doeh, lokmaihaih to ka sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang hoi ka sak ih lokmaihaih to ka caksak han; hinghaih tawn moinawk boih loe natuek naah doeh tui uemhaih hoiah kam rosak mak ai boeh; long amrosak hanah natuek naah doeh tui uemhaih thok mak ai boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sithaw mah, Hae loe nang hoi kai salak, nang hoi nawnto kaom moinawk boih salakah dungzan khoek to ka sak ih lokmaih angmathaih ah om tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tamai thungah khungzae to ka suek, to loe kai hoi long salakah lokmaih angmathaih ah om tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Long ah tamai to ka taboksak naah, tamai nuiah khungzae to amtueng tih;
  </para>
  <para style="p">
    <verse number="15" style="v" />moinawk amrosak boih hanah tui uemhaih om let mak ai boeh, tiah aihnik salak hoi hinghaih tawn moinawk boih salakah ka sak ih, lokmaihaih to ka pahnet mak ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tamai thungah khungzae kamzam ka hnuk nathung, long nui ih hinghaih tawn moinawk boih hoi Sithaw salakah sak ih dungzan lokmaihaih to ka poek poe han, tiah thuih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw mah Noah khaeah, Hae loe kai hoi long nuiah kaom hinghaih tawn moinawk boih salakah ka sak ih, lokmaihaih ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Palong thung hoi tacawt Noah ih capa thumtonawk loe, Shem, Ham hoi Japheth; Ham loe Kanan ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nichae loe Noah ih caa ah oh o moe, nihcae thung hoiah ni long boih ah kaminawk to pung o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah loe lawk phrawk kami ah oh pongah, misur takha to sak;
  </para>
  <para style="p">
    <verse number="21" style="v" />anih loe misurtui to naek moe, misurtui paquih pongah, angmah ih kahni imthung ah bangkrai ah angsong sut.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kanaan ampa Ham loe bangkrai ah kaom ampa to hnuk naah, tasa bangah kaom amya hnik khaeah a thuih pae.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe Shem hoi Japheth mah loe kahni to lak hoi moe, palaeng ah a thuengh hoi tahang pacoengah, hnukbang angqoi hoi moe, bangkrai ah kaom ampa to a khuk hoi; hnukbang angqoi hoi pongah bangkrai ah kaom ampa to hnu hoi ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noah misurtui paquihaih cai naah loe, a capa kanawk mah a nuiah sak ih hmuen to panoek.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah Kanaan loe tangoenghaih to zok nasoe loe, amya hnik ih tamna ah om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pacoengah anih mah, Shem ih Angraeng Sithaw loe tahamhoihaih om nasoe loe, Kanaan loe Shem ih tamna ah om nasoe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sithaw mah Japheth ih prae to kawksak nasoe loe, Japheth loe Shem ih kahni im ah om nasoe; Kanaan loe anih ih tamna ah om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Noah loe tui uemhaih phak pacoengah, saning cumvai thum, qui pangato hing vop.
  </para>
  <para style="p">
    <verse number="29" style="v" />Noah loe saning cumvai takawt, qui pangato hing pacoengah duek.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tui uemhaih phak pacoengah kaom, Noah ih caa Shem, Ham hoi Japheth kawng loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japheth ih caanawk loe Gomer, Magog, Madai, Javan, Tubal, Meshek hoi Tiras.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gomer ih caanawk loe, Ashkenaz, Riphath hoi Togarmah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Javan ih caanawk loe, Elishah, Tarshish, Kittim hoi Dodanim.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae loe tuipui mah takui ih prae thungah khosah Gentel kami ah oh o; angmacae acaeng hoi angmacae prae thungah kho a sak o moe, angmacae ih lok to patoh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ham ih caanawk loe Kush, Mizraim, Phut hoi Kanaan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kush ih caanawk loe Seba, Havilah, Sabtah, Raamah hoi Sabtaka; Raamah ih caanawk loe, Sheba hoi Dedan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kush mah long nuiah misatuh thaih, thacak Nimrod to sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe Angraeng hmaa ah thacak, moi kaat kop kami ah oh; to pongah kaminawk mah, Angraeng hmaa ah thacak, moi kaat kop Nimrod baktiah, tiah ruici to thuih o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih ih vangpui hmaloe koek loe Babel Erek, Akkad hoi Shinar thungah kaom Kalneh.
  </para>
  <para style="p">
    <verse number="11" style="v" />To prae thung hoiah Asshur prae thungah a caeh moe, to ah Nineveh, Rehoboth hoi Kalah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nineveh hoi Kalah salakah kaom, kalen parai vangpui Resen to a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mizraim loe Ludim, Anamim, Lehabim, Naphtuhim,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrusim, Kashluhim, hoi (to thung hoiah Philistin kaminawk to tacawt o), Kaphtor kaminawk ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kanaan mah calu Sidon hoi Heth to sak,
  </para>
  <para style="p">
    <verse number="16" style="v" />Jebus, Amor, Girgash,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiv, Ark, Sin,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvad, Zemar hoi Hammath kaminawk cunkung ah oh; to pacoengah loe Kanaan kaminawk ampraek o phang boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kanaan prae ramri loe Sidon hoi Gerar, Gerar hoi Gaza khoek to oh moe, to ahmuen hoiah Sodom, Gomorrah, Admah hoi Zeboim, Lasha karoek to phak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hae kaminawk loe Ham capa hoi anih ih imthung takoh, a lok, a prae hoi acaeng kaminawk ah oh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shem mah doeh caanawk sak toeng, Japheth loe anih ih amya ah oh; Shem loe Eber capanawk boih cunkung ah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem ih caanawk loe Elam, Asshur, Arphazad, Lud hoi Aram.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aram ih caanawk loe Uz, Hul, Gether hoi Mash cae hae ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arphazad mah Salah to sak; Salah mah Eber to sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber mah caa hnetto sak; maeto loe Peleg, tiah ahmin sak; anih dung naah long to tapraek o; anih amnawk ih ahmin loe Joktan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joktan loe Almodad, Sheleph, Hazarmaveth, Jerah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="28" style="v" />Obal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophir, Havilah hoi Jobab cungkung ah oh; nihcae boih loe Joktan ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nihcae ohhaih prae loe Mesha hoi ni angyae bangah Sephar mae karoek to kawk.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hae kaminawk loe Shem ih caanawk ah oh o moe, angmacae imthung takoh, angmacae ih lok, angmacae ih prae hoi angmacae ih acaeng baktih toengah khosak o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hae kaminawk loe angmacae acaeng baktih toengah pakuem ih Noah ih caa ah oh o; tui uem pacoengah kaminawk loe hae ahmuen hoiah long nui boih ah ampraek o.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />To naah long pum ah lok maeto khue oh moe, lok maeto ni apaeh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni angyae bang hoiah a caeh o, Shinar azawn to hnuk o naah, to ah khosak o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah nihcae mah maeto hoi maeto khaeah, Angzo oh, amlai long pahlom o si loe, hmaiqoeng o si, tiah thuih o. Thlung zuengah amlai long to patoh o moe, param long zuengah thing tangpri to patoh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae mah, Angzo oh, vangpui maeto sah o si loe, van pha khoek to imsang to sah o si; aimacae ahmin amthang hanah sah o si, to tih ai nahaeloe long pum ah ampraek o boih moeng tih, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng loe kaminawk mah sak ih imsang hoi vangpui to khet hanah, angzoh tathuk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng mah, Khenah, kaminawk loe maeto ah oh o moe, lok maeto apaeh o boih pongah, hae tok hae sak amtong o boeh; vaihi sak han a poek o ih hmuen hae pakaahaih tidoeh om ai ah sah o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angzo oh, caeh o tathuk si loe, maeto hoi maeto lok angthaih han ai ah, lok anghmangsak si, tiah thuih o.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah Angraeng mah nihcae to long pum ah ampraeksak; to naah vangpui to sah ai ah toengh o sut.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng mah long pum ah kaom kaminawk to lok anghmangsak, to ahmuen hoiah nihcae to long pum ah ampraeksak phang, to pongah vangpui to Babel, tiah kawk o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shem ih caanawk kawng loe hae tiah oh; Shem loe saning cumvaito oh moe, tui uemhaih phak pacoeng, saning hnetto naah, Arphazad to sak;
  </para>
  <para style="p">
    <verse number="11" style="v" />Arphazad to a sak pacoengah, Shem loe saning cumvai pangato hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arphazad loe saning qui thum, pangato naah Salah to sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Arphazad loe Salah sak pacoengah, saning cumvai pali, thumto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="14" style="v" />Salah loe saning qui thumto naah, Eber to sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Salah loe Eber sak pacoengah saning cumvai pali, thumto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="16" style="v" />Eber loe saning qui thum, palito naah Peleg to sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eber loe Peleg sak pacoengah, saning cumvai pali, qui thumto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="18" style="v" />Peleg loe saning qui thumto naah Reu to sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Peleg loe Reu sak pacoengah, saning cumvai hnet, takawtto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reu loe saning qui thum, hnetto naah Serug to sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reu loe Serug sak pacoengah, saning cumvai hnet, sarihto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="22" style="v" />Serug loe saning qui thumto naah Nahor to sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Serug loe Nahor sak pacoengah, saning cumvai hnetto hing moe, kalah capa hoi canunawk doeh sak vop.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahor loe saning pumphae takawtto naah, Terah to sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nahor loe Terah sak pacoengah, saning cumvai, hatlai takawtto hing moe, capa hoi canunawk sak vop.
  </para>
  <para style="p">
    <verse number="26" style="v" />Terah loe saning cumvai sarihto naah, Abram, Nahor hoi Haran to sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Terah ih caanawk kawng loe hae tiah oh; Terah mah Abram, Nahor hoi Haran to sak; Haran mah Lot to sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Haran loe ampa Terah dueh ai naah, a tapenhaih Khaldia prae Ur vangpui ah duek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abram hoi Nahor loe zu lak hoi hmaek; Abram ih zu loe Sarai; Nahor ih zu loe Milkah; Haran mah canu, Milkah hoi Ishkah to sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sarai loe caa kaak; to pongah caa sah ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Terah mah a capa Abram, Haran ih capa Lot, a capa Abram ih zu, a langah Sarai to kawk moe, Khadia prae Ur vangpui hoiah Kanaan prae ah caeh haih; Haran vangpui phak o naah, to ah khosak o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Terah loe saning cumvai hnet, pangato hing moe, Haran vangpui ah duek.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Abram khaeah, Na prae, nangmah ih canawk hoi na imthung takohnawk to caehtaak loe, kang patuek han ih prae ah caeh ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Acaeng kalen kami ah kang sak han, tahamhoihaih kang paek moe, na hmin kang lensak han; tahamhoihaih na hnu tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang tahamhoihaih paek kaminawk to tahamhoihaih ka paek moe, nang tangoeng kaminawk to ka tangoeng han; nang rang hoiah long ah kaom kaminawk boih tahamhoih o tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah anih khaeah thuih pae ih lok baktih toengah, Abram mah loe caeh; Lot doeh anih hoi nawnto caeh; Haran vangpui hoi tacawt naah, Abram loe saning qui sarih, pangato oh boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram loe a zu Sarai, amya capa Lot, a tawnh ih hmuennawk boih, Haran vangpui hoiah kawk ih kaminawk boih Kanaan prae ah caeh haih, Kanaan prae to a phak o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram loe kahoih Shekem ih ahmuen ah caeh moe, Moreh ih azawn to phak naah, Kanaan kaminawk loe to prae thungah khosak o boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abram khaeah Angraeng angphong moe, hae prae hae na caanawk khaeah ka paek han, tiah a naa. To pongah anih khaeah amtueng, Angraeng hanah to ahmuen ah hmaicam maeto a sak pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih loe to ahmuen hoiah angthawk moe, Bethel ni angyae bang kaom mae ah caeh pacoengah, ni duembang kaom Bethel vangpui hoi ni angyae bang kaom Ai vangpui salakah, kahni im to a sak; to ahmuen ah Angraeng khaeah hmaicam maeto a sak moe, Angraeng ih ahmin to palawk.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abram loe to ahmuen hoiah angthawk let moe, aloih bangah caeh tatuk.
  </para>
  <para style="p">
    <verse number="10" style="v" />To nathuem ah Kanaan prae thungah khokhahaih to oh; prae thungah khokha nung parai pongah, Abram loe Izip prae ah khosak han caeh tathuk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Izip prae thung akun tom naah, a zu Sarai khaeah, Nang loe kranghoih nongpata ah na oh, tito ka panoek;
  </para>
  <para style="p">
    <verse number="12" style="v" />Izip kaminawk mah nang ang hnuk o naah, Hae nongpata loe anih ih zu ni, tiah thui o tih; nihcae kai hae na hum o ueloe, nang loe na loih o sak tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah kai loe anih ih tanuh ni, tiah thui ah; to tiah ni nang rang hoiah kai hae kahoih ah na khenzawn o ueloe, ka hinghaih loih tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abram Izip prae thung akun naah, Izip kaminawk mah anih ih zu to kranghoih parai ah hnuk o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Faro ih angraengnawk mah anih to hnuk o naah, Faro khaeah thuih pae o, nongpata to Faro siangpahrang im ah caeh o haih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih pongah Abram to Faro mah kahoih ah khetzawn; Abram hanah tuunawk, maitaw taenawk, laa hrang ataenawk, tamna nongpanawk hoi tamna nongpatanawk, laa hrang amnonawk hoi kaengkuu hrangnawk to a paek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe Abram ih zu Sarai pongah, Angraeng mah Faro hoi a imthung takoh nuiah kasae nathaih to phaksak.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah Faro mah Abram to kawk moe, Tipongah hae tiah nang sak loe? Tipongah anih loe ka zu ni, tiah nang thui ai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tikhoe anih loe ka tanuh ni, tiah nang thuih moe, ka zu ah nang laksak loe? To pongah vaihi na zu hae lah loe, caeh lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abram kawng pongah Faro mah angmah ih kaminawk khaeah thuih pae ih lok baktih toengah, nihcae mah Abram to a zu hoi a tawnh ih hmuennawk hoi nawnto patoeh o ving.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pongah Abram loe a zu hoi a tawnh ih hmuennawk boih to sinh moe, Izip prae thung hoiah caeh tahang; Lot doeh anih hoi nawnto caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah Abram loe pacah ih moinawk, sum kanglung, suinawk hoiah angraeng parai boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aloih bang hoiah Bethel ah caeh, tangsuek nathuem hoi a sak ih kahni im ohhaih Bethel hoi Hai salakah a caeh,
  </para>
  <para style="p">
    <verse number="4" style="v" />a sak hmaloe ih hmaicam ohhaih ahmuen to phak naah, to ahmuen ah Abram mah Angraeng ih ahmin to palawk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram hoi nawnto kacaeh Lot doeh, tuunawk, maitawnawk hoi kahni imnawk tawnh toeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nihnik nawnto khosak han long ahmuen mah khawt ai boeh; a tawnh hoi ih hmuennawk pop parai boeh pongah, nawnto om hoi thai ai boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abram ih maitaw toep kaminawk hoi Lot ih maitaw khenzawn kaminawk to angzoeh o; to naah Kanaan kaminawk hoi Periz kaminawk loe to prae thungah oh o boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah Abram mah Lot khaeah, Aihnik loe nawkamya ah ni a oh o; nang hoi kai salak, nang ih maitaw toep kami hoi kai ih maitaw khen kami salakah, angzoehhaih om hmah nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kawk parai prae na hma ah om ai maw? Kai hoi ampraek halat si; nang banqoi bangah na caeh nahaeloe, kai bantang bangah ka caeh han; nang bantang bangah na caeh nahaeloe, kai banqoi bangah ka caeh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lot mah khet naah, Angraeng ih takha baktih, Zoar vangpui ah na caeh naah Izip prae baktih kaom, ahmuen kruekah long kaduk Jordan azawn ah to a hnuk; to tui kahoih azawn loe Angraeng mah phraek ih Sodom hoi Gomorrah vangpui pha ai naah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lot mah angmah hanah Jordan azawn to qoih moe, ni angyae bangah a caeh; to tiah maeto hoi maeto ampraek hoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram loe Kanaan prae ah oh, Lot loe azawn taengah kaom vangpuinawk ah khosak moe, Sodom vangpui taengah kahni im to a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sodom vangpui ih kaminawk loe set o moe, Angraeng hmaa ah doeh pop parai zaehaih hoiah khosak o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lot mah anih caehtaak pacoengah, Angraeng mah Abram khaeah, Na ohhaih ahmuen hoi aluek, aloih, ni angyae hoi niduem bang to doeng ah;
  </para>
  <para style="p">
    <verse number="15" style="v" />na hnuk ih prae boih nangmah hoi na caanawk khaeah, dungzan khoek to kang paek han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na caanawk to long ih maiphu zetto kang pungsak han; kami mah maiphu kroek thaih nahaeloe, na caanawk doeh kroek o thai tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angthawk loe, prae to kasawk hoi kalen boenghaih khoek to amkae boih ah; to ahmuen to nang khaeah kang paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah Abram mah kahni im to khok, Hebron ih Mamre azawn ah caeh moe, to ah khosak; to ahmuen ah Angraeng han hmaicam maeto a sak.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />To naah Shinar siangpahrang Amraphel, Ellasar siangpahrang Ariok, Elam siangpahrang Kedorlaomer hoi Goiim siangpahrang Tidal cae loe,
  </para>
  <para style="p">
    <verse number="2" style="v" />caeh o moe, Sodom siangpahrang Bera, Gomorrah siangpahrang Birsha, Admah siangpahrang Shinah, Zeboiim siangpahrang Shemeber hoi Bela (to loe Zoar ni) siangpahrang to tuk o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To siangpahrangnawk boih loe Siddim paloi tuili azawn ah atai o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe saning hatlai hnetto thung Kedorlaomer ban thungah oh o, toe saning hatlai thumto naah loe, misa angthawk o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Saning hatlai palito naah, Kedorlaomer siangpahrang loe anih angdoe haih siangpahrangnawk hoi nawnto angzoh o moe, Ashteroth Karnaim ah kaom Rephaim kaminawk, Ham ah kaom Zuzim kaminawk, Shaveh Kiriathaim ah kaom Emim kaminawk,
  </para>
  <para style="p">
    <verse number="6" style="v" />Seir mae ah kaom Hor kaminawk to tuk o moe, praezaek taengah kaom El-Paran vangpui khoek to patom o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah amlaem o moe, En-Mishpat (Kadesh) ah caeh o; Amalek prae pum hoi Hazezon-Tamar prae ah kaom, Amor kaminawk doeh tuk pazawk o.
  </para>
  <para style="p">
    <verse number="8" style="v" />To naah Sodom siangpahrang, Gomorrah siangpahrang, Admah siangpahrang, Zeboiim siangpahrang hoi Bela (Zoar) siangpahrang mah misatuk hanah Siddim azawn ah caeh haih moe,
  </para>
  <para style="p">
    <verse number="9" style="v" />Elam siangpahrang Kedorlaomer, Goiim siangpahrang Tidal, Shinar siangpahrang Amraphel hoi Ellasar siangpahrang Ariok, siangpahrang palito hoiah siangpahrang pangatonawk misa angtuk o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siddim azawn loe tangnong cing ah oh; Sodom hoi Gomorrah ih siangpahrang hnik loe cawnh hoi ving, toe to ih tangnong thungah krak hoi hmaek; kanghmat kaminawk loe mae nuiah cawnh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Misatuk pazawk siangpahrangnawk mah Sodom hoi Gomorrah vangpui ih hmuennawk hoi caaknaeknawk to lak pae o boih pacoengah caeh o taak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sodom vangpui ah kaom Abram amya ih capa, Lot hoi anih ih hmuennawk doeh lak pae o boih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Misa angtukhaih thung hoi loih kami maeto mah to kawng to Hebru kami, Abram khaeah thuih pae; to naah Abram loe Eshkol hoi Aner amnawk, Amor kami Mamre ih azawn taengah oh; to ah kaom kaminawk loe Abram hoi ampui ah oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Misanawk mah amya ih caanawk naeh o boih boeh, tiah Abram mah thaih naah, angmah im ah tapen kami, angmah patuk ih kami cumvai thum, hatlai tazetto hoiah nihcae to Dan vangpui karoek to patom o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angmah ih kaminawk to tapraek moe, to kaminawk to khoving ah tuksak pacoengah, Damaska vangpui aluek bangah kaom Hobah vangpui khoek to patom o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmuennawk to lomh pae o let moe, amya capa, Lot hoi anih ih hmuennawk, nongpatanawk hoi kaminawk to hoih pae o boih let.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abram loe Kedolaomer siangpahrang hoi anih ih ampui siangpahrangnawk to pazawk boih pacoengah amlaem let, to naah Sodom siangpahrang mah anih to Shaveh azawn (to loe siangpahrang ih azawn ah oh) karoek to dawt.
  </para>
  <para style="p">
    <verse number="18" style="v" />To naah Salem siangpahrang Melkhizedik mah takaw hoi misurtui to sinh; anih loe Sang koek Sithaw ih qaima ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih mah Abram tahamhoihaih paek moe, Sang koek Sithaw, van hoi long sahkung mah, Abram tahamhoihaih paek nasoe.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na misanawk na ban ah paekkung, Sang koek Sithaw loe, tahamhoihaih om nasoe, tiah a naa. To naah Abram mah a tawnh ih hmuen boih thung hoiah hato thungah maeto anih khaeah paek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sodom siangpahrang mah Abram khaeah, Kaminawk to kai han na paek ah, hmuennawk loe nangmah hanah la ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe Abram mah Sodom siangpahrang khaeah, Sang koek Sithaw, van hoi long sahkung, Angraeng khaeah ban payangh moe, lokkamhaih ka sak boeh pongah,
  </para>
  <para style="p">
    <verse number="23" style="v" />nang ih hmuen tih ta doeh ka la mak ai, khopanai bum aqui hoi tlangqui tetta mataeng doeh ka la mak ai; to tih ai nahaeloe Abram loe kaimah ni kang raengsak, tiah na thui moeng tih;
  </para>
  <para style="p">
    <verse number="24" style="v" />kai ih kaminawk mah patoh o moe, a caak o ih hmuen khue to ka lak han; kai bomkung Aner, Eshkol hoi Mamre cae loe angmacae hnuk han koi taham to la o nasoe, tiah a naa.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah hnuksakhaih hoiah Angraeng ih lok Abram khaeah phak; Abram zii hmah; kai loe nang abuephaih, kalen parai nang ih tangqum ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toe Abram mah, Angraeng Sithaw, timaw nang paek han? Kai loe caa tawn ai ah kho ka sak; Damaska ih Eliezer mah ni kai ih qawk to toep tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram mah, Khenah, kai han caa nang paek ai; to pongah ka imthung ah tapen kami mah ni kai ih qawk to toep tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />To naah Angraeng ih lok anih khaeah angzoh; Na tamna mah nang ih qawk to toep mak ai; toe na takpum thung hoi tacawt na capa tangtang mah ni nang ih qawk to toep tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram to tasa bangah caeh haih moe, anih khaeah, Van bang doeng tahang ah, cakaehnawk na kroek thaih nahaeloe, kroek ah; na caanawk loe to tiah om o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram mah Angraeng to tang pongah, a tanghaih to toenghaih ah tapom pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih khaeah, Kai loe hae prae hae qawk ah paek hanah, Khaldia prae Ur vangpui hoiah nang zaehoikung, Angraeng ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe Abram mah, Angraeng Sithaw, hae prae hae qawk ah ka toep han, tito kawbang maw ka panoek thai tih? tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah Angraeng mah anih khaeah, Saning thumto kaom maitaw tae maeto, saning thumto kaom maeh amno maeto, saning thumto kaom tuu tae maeto, pahuu maeto hoi im pahuu maeto na sin ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abram mah to hmuennawk to sinh boih; hnetto ah a bawk moe, kalah kalah ah suek boih; toe tavaanawk loe hnetto ah bawk ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moicaa tavaanawk loe kadueh qok moinawk nuiah azawk o tathuk, to naah Abram mah tavaanawk to huih boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Niduem naah loe iih kangmue mah kae pongah Abraham loe iih; to naah zit kaom kalen parai khoving mah anih to khuk hmoek.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah Angraeng mah anih khaeah, Na caanawk loe minawk prae ah angvin ah om o tih; to kaminawk ih tamna ah om o ueloe, nihcae mah saning cumvai palito thung pacaekthlaek o tih, tito panoek ah;
  </para>
  <para style="p">
    <verse number="14" style="v" />toe nangcae tamna ah patoh acaeng to lok ka caek han; to pacoengah ni nihcae to paroeai pop hmuenmaenawk hoiah tacawt o vop tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang loe lunghoih ta hoi nam panawk khaeah na caeh ueloe, mitong naah na phum o tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na caanawk loe dung palito phak naah, hae ahmuen ah angzo o let tih; Amor kaminawk sakpazaehaih koep ai vop, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aduem bang khoving ah loe, akhue tacawt hmai kangqong, pa-aang ih hmai-im to tacawt moe, kalah kalah ah tapraek ih moi salakah caeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />To na niah Angraeng mah Abram hoi lokmaihaih to sak moe, Izip prae vapui thung hoiah kalen parai vapui, Euphrates vapui;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ken, Ken-zi, Kadmon,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hit, Periz, Rephaim,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amor, Kanaan, Girgash hoi Jebus kaminawk ih prae loe na caanawk khaeah ka paek boeh, tiah a naa.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram zu, Sarai loe caa kaak; toe anih loe Izip tanuh, Hagar tiah ahmin kaom tamna maeto tawnh.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pongah Sarai mah Abram khaeah, Angraeng mah caa ang kaaksak boeh; caeh ah loe ka tamna nongpata khaeah iip ah, anih mah caa na sah pae khoe doeh om tih, tiah a naa. Abram mah Sarai ih lok to tahngaih pae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram loe Kanaan prae ah saning hato oh pacoengah, Sarai mah a tamna nongpata, Izip tanuh Hagar to lak moe, zu haih hanah sava khaeah paek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abram mah Hagar to iih haih, to naah nongpata to zokpomh; zokpom boeh, tiah Hagar mah panoek naah angmah angraeng ih zupui to hnap.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah Sarai mah Abram khaeah, Ka sakpazae ih hmuen loe na lu nuiah om nasoe; ka tamna nongpata to na saoek nuiah kang paek; anih mah zokpom boeh, tiah panoek naah, kai hae ang patoek; nang hoi kai salakah Angraeng mah lokcaek halat nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe Abram mah Sarai khaeah, Na tamna nongpata loe na ban ah ni oh; na koeh baktiah a nuiah sah khae, tiah a naa. Sarai mah Hagar to pacaekthlaek, to pongah Hagar loe anih khae hoi cawnh ving.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng ih van kami mah Hagar to praezaek tuipuek taeng, Shur vangpui caehhaih loklam taengah hnuk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah, Sarai ih tamna nongpata, Hagar, naa hoiah maw nang zoh? Naa ah maw na caeh han? tiah a naa. Anih mah, Ka angraeng zupui Sarai khae hoiah ka cawnh ving, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah Angraeng ih van kami mah anih khaeah, Na angraeng zupui khaeah amlaem let loe, anih tlim ah khosah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Van kami mah anih khaeah, Kroek laek ai khoek to na caanawk kang pungsak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng ih van kami mah anih khaeah, Khenah, nang loe zokpomh boeh, caa nongpa to na sah tih; na patanghaih Angraeng mah thaih pae boeh pongah, anih ih ahmin to Ishmael, tiah sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih loe poek ham kami ah om ueloe, kami boih hoi angtuh tih, kami boih mah anih to tuh tih; anih loe angmah ih nawkamyanawk taengah khosah tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah Hagar mah, angmah khaeah lokthuikung Angraeng to, Nang loe kai hnukung Sithaw, tiah ahmin paek; anih mah, Vaihi kai Hnukung to ka hnuk boeh, tiah thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah to ih tuipuek to, Beer Lahai Roi, tiah ahmin sak; khenah, to tuipuek loe Kadesh hoi Bered salakah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hagar mah Abram hanah capa maeto sak pae; Hagar mah sak pae ih capa to Abram mah Ishmael, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hagar mah Abram han Ishmael sak pae naah, Abram loe saning qui tazet, tarukto oh boeh.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram loe saning qui takawt, takawtto naah, Angraeng mah amtueng thuih; anih khaeah, Kai loe Thacak Sithaw ah ka oh; na koep thai hanah, ka hmaa ah caeh ah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai hoi nang salakah lokmaihaih ka sak moe, nang to pop parai ah kang pungsak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah Abram loe long ah akuep; Sithaw mah anih khaeah,
  </para>
  <para style="p">
    <verse number="4" style="v" />khenah, ka sak ih lokmaihaih loe nang khaeah oh; nang loe prae kami boih ih ampa ah na om tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang ih ahmin loe Abram, tiah kawk mak ai boeh; Abraham, tiah ni kawk tih boeh; nang loe prae kami boih ih ampa ah kang sak boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Athaih paroeai kang thaisak moe, nang khae hoiah kami congca kang coengsak han; siangpahrangnawk doeh nang khae hoiah ni tacawt o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kai loe na Sithaw, na caanawk ih Sithaw ah ka oh moe, nang hoi na caanawk boih nuiah dungzan khoek to ka sak ih lokmaihaih to ka caksak han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vaihi angvin ah na ohhaih prae, Kanaan prae boih to dungzan ah toep hanah, nang hoi na hnuk ah angzo na caanawk khaeah ka paek han; kai loe nihcae ih Sithaw ah ka oh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pacoengah Sithaw mah Abraham khaeah, Nangmah hoi na hnuk ah angzo han koi na caanawk boih mah loe, ka sak ih lokmaihaih to pazui oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hae loe nangmah hoi na hnuk ah angzo han koi na caanawk salakah, na pazui o han ih ka lokmaihaih ah oh; nangcae thung ih nongpa boih tangzat hin aat oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tangzat hin to aat oh; to loe kai hoi nang salakah sak ih lokmaih angmathaih ah om tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angzo han koi na caanawk boih, na imthung ah tapen kami, to tih ai boeh loe nangmah ih acaeng na ai, phoisa hoi qan ih prae kalah kami boih, ni tazetto koep naah tangzat hin aat oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na imthung ah tapen kami doeh, phoisa hoi qan ih kami doeh, tangzat hin aah han angaih; na taksa nuiah ka sak ih lokmaihaih to dungzan khoek to om tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tangzat hin aat ai caa nongpa, tangzat hin aat ai kami loe, acaeng thung hoiah pahnawt ah; anih loe ka lokmaihaih phraekung ah ni oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sithaw mah Abram khaeah, na zu Sarai loe Sarai, tiah kawk hmah lai ah; anih ih ahmin loe Sarah, tiah om tih boeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih to tahamhoihaih ka paek han, anih mah capa maeto na sah pae tih; ue, anih to tahamhoihaih ka paek han, anih loe prae kami boih ih amno ah om tih; siangpahrangnawk doeh anih thung hoiah ni tacawt tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham loe mikhmai akuep tathuk moe, pahnuih pacoengah, a palung thung hoiah, Saning cumvaito kaom kami mah caa sah vop tih maw? Saning qui takawt, takawtto kaom, Sarah mah caa sah vop tih maw? tiah thuih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham mah Sithaw khaeah, Aw Ishmael loe na hmaa ah hing nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sithaw mah, Na zu Sarah mah capa na sah pae tih; anih ih ahmin to Issak, tiah sah ah; anih hoi anih hnuk ah angzo a caanawk khaeah doeh dungzan lokmaihaih to ka sak han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ishmael han na thuih ih lok to ka thaih boeh; khenah, anih to tahamhoihaih ka paek han, athaih ka thaisak moe, pop parai ah ka pungsak han; anih loe ukkung hatlai hnetto ih ampa ah om ueloe, anih to kalen parai acaeng ah kang coengsak han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe hmabang saning vaihi atue ah, Sarah mah ang sak pae han ih Issak hoiah ni lokmaihaih to ka sak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lokthuih boih pacoengah, Sithaw loe Abraham khae hoiah caeh tahang ving.
  </para>
  <para style="p">
    <verse number="23" style="v" />To na niah Abraham mah a capa Ishmael, a imthung ah tapen kaminawk boih, phoisa hoi qan ih kaminawk boih, imthung ah kaom nongpa boih to kawk moe, Sithaw mah thuih ih lok baktih toengah, tangzat hin to aahsak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tangzat hin aah naah, Abraham loe saning qui takawt, takawtto oh boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />A capa Ishmael loe saning hatlai thumto oh boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abraham hoi a capa Ishmael loe to na niah tangzat hin aah hoi hmaek.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham im ah kaom nongpa boih, anih im ah tapen nongpa boih, prae kalah ah phoisa hoi qan ih kaminawk boih, angmah hoi nawnto tangzat hin aah o.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham loe Mamre azawn ah oh, ni bet moe, kahni im ah anghnut naah, Angraeng anih khaeah amtueng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham mah doeng tahang naah, a taengah anghnu kami thumto a hnuk; nihcae to a hnuk naah, nihcae tongh hanah angmah ih kahni im khongkha taeng hoiah karangah caeh moe, long ah akuep.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae khaeah, Ka Angraeng na mikcuk naakrak ah ka oh nahaeloe, na tamna kai hae na caehtaak hmah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na khok pasaeh hanah, tui zetta ka lak han, khok nam saeh o pacoengah doeh, thing tahlip ah anghak o raeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Caak han takaw zetta ka lak han, nawnetta anghak pacoengah caeh oh, to tiah kang khetzawn o han ih ni na tamna khaeah nang zoh o, tiah a naa. Nihcae mah, Na thuih ih lok baktiah sah ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah Abraham loe kahni imthung ah Sarah khaeah karangah cawnh; anih khaeah, Noekhaih thumto ah takaw dip to karangah naep ah loe, takaw to sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Maitawnawk pacahhaih ahmuen ah a cawnh moe, caak khawt boek maitaw maeto naeh pacoengah, a tamna thendoeng maeto khaeah paek; anih mah karangah thongh pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah maitaw tahnutui kamkhawk, maitaw tahnutui hoi caak kahoih maitaw moi to sinh moe, nihcae hmaa ah patoemh pae; nihcae buhcaak o naah, anih loe nihcae taeng ih thing tahlip ah angdoet.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae mah, Na zu Sarah loe naa ah maw oh? tiah a naa. Anih mah, Khenah, Sarah loe kahni imthung ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah anih mah hmabang saning vaihi tue thuem ah kang zoh let han, to naah na zu Sarah loe capa maeto sah tih, tiah a naa. To naah anih hnuk ah kaom kahni im thok taeng hoiah anih mah thuih ih lok to Sarah mah thaih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham hoi Sarah loe mitong hoi boeh moe, saning doeh coeh hoi boeh; Sarah loe caasakhaih atue to laemh boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pongah Sarah mah, Kai loe mitong boeh moe, ka angraeng doeh mitong boeh, vaihi to baktih anghoehaih ka tawn vop tih maw? tiah pahnuihaih hoiah lok a thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah Angraeng mah Abraham khaeah, Tipongah Sarah mah pahnuihaih hoiah, Kai loe mitong boeh, caa ka sah thai vop tih maw? tiah lok a thuih loe?
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng hanah karai parai hmuen to oh maw? Hmabang saning vaihi tue phak naah nang khaeah kang zoh let han, to naah Sarah mah capa maeto sah tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah Sarah mah zit pongah amsawnlok a thuih moe, Ka pahnui ai, tiah a thuih. Toe anih mah, Na pahnui to loe, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To ih kaminawk loe amsak o moe, angthawk o naah, Sodom vangpui to dan o tathuk; Abraham mah nihcae to loklam ah caeh haih.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah Angraeng mah, Ka sak han koi tok to Abraham khaeah kang phat pae tih maw?
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham loe thacak hoi kalen parai acaeng ah angcoeng tih; long nui ih prae kaminawk boih anih rang hoiah tahamhoihaih hnu o tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih loe a hnuk ah angzo han koi nawktanawk hoi imthung takohnawk to thuitaek tih, tiah ka panoek. Nihcae mah Angraeng ih loklam to pazui o ueloe, toenghaih to sah o tih. To naah Angraeng mah Abraham khae thuih ih lok to akoep tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pacoengah Angraeng mah, Sodom hoi Gomorrah kaminawk hanghaih lok loe paroeai len moe, zaehaih doeh pop parai boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai khaeah kapha hanghaih lok baktih toengah, to ih kaminawk mah sak o maw, sah o ai tito khet hanah, ka caeh tathuk han; to naah ni to tiah sah o ai nahaeloe, to tiah sah o ai, tito ka panoek tih, tiah a thuih.
  </para>
  <para style="p">
    <verse number="22" style="v" />To kaminawk loe to ahmuen hoiah angqoi o moe, Sodom vangpui bangah caeh o; toe Abraham loe Angraeng hmaa ah angdoet poe.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abraham mah Angraeng khaeah anghnaih moe, Katoeng kami to kazae kami hoi nawnto nam rosak han maw?
  </para>
  <para style="p">
    <verse number="24" style="v" />Vangpui thungah katoeng kami qui pangato om nahaeloe, katoeng kami qui pangato pathlung ai ah, vangpui to nam rosak han maw?
  </para>
  <para style="p">
    <verse number="25" style="v" />Katoeng kami to kazae kami hoi nawnto hum hmaek han ih loe nang khae hoiah angthla nasoe; katoeng kami to kazae kami baktiah hum han ih doeh nang khae hoiah angthla nasoe; long pum lokcaekkung loe, katoeng hmuen to sah mak ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng mah, Sodom vangpui thungah katoeng kami qui pangato ka hnuk nahaeloe, nihcae rang hoiah vangpum to ka paquem han, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pacoengah Abraham mah, Kai loe maiphu hoi vai poep ah ni ka oh, toe khenah, vaihi Angraeng khaeah tha hoi lokthui rae ue,
  </para>
  <para style="p">
    <verse number="28" style="v" />katoeng kami qui pangato akoep hanah pangato angaih nahaeloe, kami pangato angaih pongah vangpui to na phraek han maw? tiah a naa. Anih mah, Vangpui thungah kami qui pali, pangato ka hnuk nahaeloe, kam rosak mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih mah, vangpui thungah kami qui palito hnu khoe doeh om tih, tiah a naa. To naah anih mah, kami qui palito om nahaeloe, ka phrae mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pacoengah, Angraeng, palungphuisak hmah raeh; lok ka thuih han vop; kami qui thumto hnu khoe doeh om tih, tiah a naa. Anih mah qui thumto ka hnuk nahaeloe, vangpui to kam rosak mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Abraham mah, Khenah, vaihi tha ohhaih hoi Angraeng khae lokthuih hanah kam sak; kami pumphaeto hnu khoe doeh om tih, tiah a naa. Anih mah, kami pumphaeto pongah, vangpui kam rosak mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />To pacoengah anih mah, Angraeng, palungphuisak hmah raeh; vaihi khue lokthui rae ue; kami hato hnuk khoe nahaeloe? tiah a naa let bae. Anih mah, Kami hato om nahaeloe, nihcae rang hoiah vangpui to ka phrae mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham hoi lok apaeh pacoengah Angraeng loe a caehhaih loklam ah amlaem let; Abraham doeh angmah im ah amlaem.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Van kami hnik loe duembang ah Sodom vangpui ah angzoh hoi; to naah Lot loe Sodom vangpui khongkha ah anghnut; Lot mah nihnik to hnuk hanah angthawk moe, mikhmai long ah kuep tathuk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah, Khenah, ka Angraeng hnik, vaihi na tamna im ah angzo hoi ah; khok amsae hoih loe, duem to iip hoi ah; khawnbang khawnthaw ah angthawk hoih loe caeh hoih, tiah a naa. Nihnik mah, To tih na ai, Kaihnik loe qum puek loklam ah ka oh hoi han, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe anih mah pacae khruek pongah, anih hnuk ah bang hoi moe, anih imthung ah akun hoi; nihnik hanah caak koi, taeh thuh ai ih takaw to patoem pae moe, a caak hoi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe nihnik iip hoi ai naah, Sodom vangpui thung ih kaminawk, thendoeng hoi mitongnawk, ahmuen kruek ih kaminawk mah, im to takui o khoep.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae mah Lot to kawk o moe, anih khaeah, Vai qum ah na im ah katoem nongpanawk loe naa ah maw oh o? Kaicae khaeah na patoeh ah, ka zae o haih han vop, tiah a naa o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lot loe nihcae khaeah tasa bang ah caeh moe, a hnuk bang ih thok to khah pacoengah,
  </para>
  <para style="p">
    <verse number="7" style="v" />nihcae khaeah, Nawkamyanawk, tahmenhaih hoi to baktih kasae hmuen to sah o hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khenah, nongpa hoi iip vai ai canu hnetto ka tawnh; nihnik to nangcae khaeah kang zoh haih han, na koeh o ih baktiah sah oh; toe hae kami hnik loe kawbang doeh sah o hmah; nihnik loe ka imphu tlim ah kabuep angvin ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae mah, Hnuk angnawn ah, tiah naa o. To pacoengah nihcae mah, Nang loe hae ah angvin ah ni nang zoh, toe vaihi loe lokcaekkung ah oh han na koeh; nihnik pong kanung kue ah nangmah to kang sak o lat han, tiah a naa o. Lot to hmaang o moe, thok to phraek hanah a caeh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toe van kami hnik loe ban payangh hoi moe, Lot to imthung ah zaeh hoi pacoengah, thok to khah hoi khoep.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nihnik mah kathoeng kalen tih ai, thok taengah kaom, kaminawk to mikmaengsak boih pongah, nihcae loe thok pakrong naah angpho o.
  </para>
  <para style="p">
    <verse number="12" style="v" />To ih kami hnik mah Lot khaeah, Hae ahmuen ah na imthung takoh kaminawk oh o vop maw? Vangpui thung kaom, na canu ih sava, na capanawk, na canunawk to hae ahmuen hoi tacawt haih boih lai ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hae ahmuen hae ka phraek hoi han boeh; hae ih kaminawk hanghaih lok Angraeng ih naa ah koi sut boeh pongah, hae vangpui hae phraek hanah ang patoeh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Lot loe tacawt moe, a canu kazu haih, a canu ih sava khaeah, Angthawk ah loe, hae ahmuen hoiah tacawt hoi lai ah; Angraeng mah hae vangpui hae phrae tih boeh, tiah a naa. Toe a canu ih sava hnik mah loe tamhnuilok thuih rumram ih lok tok mue, tiah a poek hoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khodai naah loe, van kami hnik mah Lot khaeah, Karangah angthawk ah loe, hae ah kaom na zu hoi na canu hnik to kawk ah; to tih ai nahaeloe hae vangpui zaehaih mah na pha thuih moeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angtawt hnung parai pongah, Angraeng mah nihcae to tahmen, to naah van kami hnik mah Lot ih ban, a zu hoi a canu hnik ih ban to patawnh pae, vangpui tasa bang khoek to zaeh moe, caeh haih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae to vangpui tasa bang khoek to zaeh pacoengah loe anih mah, Na hing o hanah cawn oh, hnukbang angqoi o hmah loe, azawn ah doeh anghak o hmah, mae nuiah cawn oh; to tih ai nahaeloe na dueh o moeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Lot mah nihnik khaeah, Aw, ka angraeng, to tih na ai ni;
  </para>
  <para style="p">
    <verse number="19" style="v" />khenah, vaihi na tamna kai loe mikcuk naakrak ah ka oh pongah, nang tahmenhaih amtuengsak moe, ka hinghaih nang pathlung boeh; toe mae ah loe ka cawn thai ai; sethaih maeto ka tongh ueloe, ka dueh moeng tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khenah, vaihi cawnhhaih kanghnai daek ah vangpui tetta maeto oh, to ih vangpui tetta ah na cawnsak ah; (to vangpui loe tetta na ai maw?) to ah ka cawnh nahaeloe ka hinghaih loih tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih mah, khenah, nang thuih ih lok to ka tapom, nang hnik ih baktih toengah, to vangpui to ka phrae mak ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe to ah karangah cawn ah, to ahmuen na pha ai karoek to tidoeh ka sah thai mak ai, tiah a naa. To pongah to vangpui to Zoar, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zoar vangpui thungah Lot akun naah loe, long nuiah ni tacawt boeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />To naah Angraeng mah van bang hoiah kaat hmai hoi kangqong hmai to Sodom hoi Gomorrah vangpui nuiah khotui baktiah angzohsak.
  </para>
  <para style="p">
    <verse number="25" style="v" />To vangpuinawk hoi nawnto azawn boih, vangpui thungah kaom kaminawk boih, long ah kamprawk akungnawk to amro boih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe Lot zu loe hnukbang ah angqoi pongah, paloi tungah angcoeng ving.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham loe khawnbang khawnthaw ah angthawk moe, Angraeng hmaa ah angdoethaih ahmuen ah caeh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Sodom hoi Gomorrah, azawn boih to doeng tathuk; khenah, hmaitikhaih ahmuen ih hmaikhue baktiah prae thung boih ah tacawt hmaikhue to a hnuk.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng mah azawn ih vangpuinawk to phraek naah, Sithaw mah Abraham to pahnet ai, Lot ohhaih vangpui to phraek han oh naah doeh, kamro vangpui thung hoiah Lot to a loihsak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lot loe Zoar vangpui thungah oh han zit pongah, Zoar vangpui thung hoiah tacawt moe, a canu hnik hoi nawnto mae nuiah khosak; a canu hnik hoi nawnto thlung khaw thungah oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nito naah loe a canu kacoeh mah, a canu kanawk khaeah, Aihnik ampa loe mitong boeh, long pum ah aihnik iih haih han angzo nongpa maeto doeh om ai boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pa ih atii anghmat han ai ah, aihnik ampa to misurtui naesak si loe, anih to iip haih si, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />To na aqum ah ampa to misurtui panaek hoi moe, canu kacoeh mah ampa to iih haih; a canu mah natuek naah maw iih haih moe, natuek naah maw angthawk taak, tito ampa mah panoek ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khawnbang ah loe a canu kacoeh mah amnawk khaeah, Khenah, cangduem aqum ah pa to ka iih haih; vaiduem doeh misurtui naesak let si; anih khaeah nang caeh ah loe, pa ih atii anghmat han ai ah, nang doeh anih to iip haih toeng ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />To naduem doeh ampa to misurtui panaek hoi let, canu kanawk loe angthawk moe, ampa to iih haih; natuek naah maw iih haih moe, natuek naah maw angthawk, tito ampa mah panoek ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />To pongah a canu hnik loe ampa ih caa to pomh hoi hmaek.
  </para>
  <para style="p">
    <verse number="37" style="v" />Canu kacoeh mah capa maeto sak moe Moab, tiah ahmin phui; anih loe vaihni ni khoek to Moab kaminawk ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Canu kanawk mah doeh capa maeto sak moe Ben-Ammi, tiah ahmin phui; anih loe vaihni ni khoek to Ammon kaminawk ih ampa ah oh.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham loe ohhaih ahmuen hoi aloih bang ah angpuen moe, Kadesh hoi Shur vangpui salakah khosak. Gerar vangpui ah doeh nawnetta thung oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah Abraham mah a zu Sarah to, Ka tanuh ni, tiah thuih. To pongah Gerar vangpui siangpahrang Abimelek mah kami to patoeh moe, Sarah to laksak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe qum amang ah Abimelek khaeah Sithaw angzoh pae moe, anih khaeah, Khenah, nongpata to na naeh pongah nang loe kadueh kami ah ni na oh boeh, anih loe kami maeto ih zu boeh ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe Abimelek loe Sarah khaeah caeh ai vop; anih mah, Angraeng, katoeng acaeng to na hum han maw?
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih mah kai khaeah nongpata loe, Ka tanuh ni, tiah ang naa moe, nongpata mah doeh anih loe, Ka thangqoi ni, tiah thuih; kai loe hae hmuen hae poekciimhaih hoi kaciim ban hoiah ni ka sak, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Sithaw mah amang ah anih khaeah, Ue, poekciimhaih hoiah ni na sak tito ka panoek; to pongah ni ka koeh ai ih hmuen baktiah na zae haih han ai ah kang pakaa moe, anih to kang suisak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah kami ih zu to paek let ah; anih loe tahmaa ah oh, anih mah nang hanah lawk na thui pae nahaeloe, hinghaih na hnu tih; toe anih ih zu to na paek let ai nahaeloe, nangmah hoi na caanawk boih, na dueh o tangtang tih, tiah panoek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abimelek loe khawnbang khawnthaw ah angthawk, a tamnanawk to kawk moe, nihcae khaeah amang ah hnuk ih hmuennawk to thuih pae boih, to naah nihcae loe paroeai zit o.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pacoengah Abimelek mah Abraham to kawk moe, anih khaeah, Tipongah kaicae nuiah hae baktih hmuen hae na sak loe? Na nuiah tih sethaih maw ka sak moe, ka nui hoi ka prae thungah hae baktih kalen zaehaih to nang phaksak? Tikhoe sak koi ai hmuen to ka nuiah na sak loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abimelek mah Abraham khaeah, Kawbang maw na poek moe, hae tiah na sak? tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham mah, Hae prae kaminawk loe Sithaw zithaih tawn o ai moe, ka zu pongah kai na hum o tih, tiah ka poek.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah anih loe ka tanuh ah doeh oh roe; kam pa ih canu ah oh, toe amno loe lah; anih to ka zu haih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kam pa imthung hoiah Sithaw mah ang proengsak naah, nongpata khaeah, Nam lunghaih kai khaeah amtuengsak hanah, na caehhaih ahmuen kruekah, kai loe, na thangqoi ni, tiah thui ah, tiah ka naa, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pacoengah Abimelek mah, tuu hoi maitawnawk, tamna nongpa hoi nongpatanawk to lak moe, a zu Sarah hoi nawnto Abraham khaeah paek let.
  </para>
  <para style="p">
    <verse number="15" style="v" />Abimelek mah Abraham khaeah, Khenah, na hmaa ah kaom long loe kai ih boih ni; na koeh ih ahmuen ah khosah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih mah Sarah khaeah, Khenah, Na thangqoi khaeah mikhmai sakhaih phoisa shekel sangto ka paek boeh; to phoisa loe na taengah kaom kaminawk boih hmaa ah kaciim ah na oh moe, zaehaih tidoeh na sah ai, tiah nihcae boih mah panoek han ih ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah Abraham mah Sithaw khaeah lawkthuih pae, to naah Sithaw mah Abimelek, anih ih zu hoi a tamna nongpatanawk to ngantuisak; nihcae loe caa sak o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham ih zu Sarah pongah, Angraeng mah Abimelek imthung takoh boih caa kaaksak.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah thuih ih lok baktih toengah, Sarah khaeah caeh moe, a thuih ih lok baktih toengah, Angraeng mah Sarah khaeah sak pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham mitong naah Sarah zokpomh moe, Sithaw mah khaeh ih atue phak naah, Abraham han capa maeto a sak pae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sarah mah sak pae ih capa to Abraham mah, Issak, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw mah anih khaeah thuih pae ih lok baktih toengah, ni tazetto akoep naah, Abraham mah a capa Issak ih tangyat hin to aah pae.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham loe a capa Issak tapen naah saning cumvaito oh boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sarah mah, Sithaw mah kai ang pahnuisak boeh, hae lok thaih kaminawk boih, kai hoi nawnto pahnui o tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah, Mi mah maw Abraham khaeah, Sarah mah a caa tahnutui panae tih, tiah thui thai tih? Toe mitong lam ah anih han capa maeto ka sak pae, tiah a thuih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nawkta loe qoeng tahang moe, tahnutui amphi boeh; tahnutui toengh na niah Abraham mah kalen parai uumhaih poih to sak pae.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe Abraham han capa maeto kasah pae, Izip nongpata Hagar mah pahnui thuih, tito Sarah mah panoek.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pongah anih mah Abraham khaeah, Na tamna nongpata hoi a capa hae haek lai ah; tamna nongpata ih capa loe natuek naah doeh ka capa Issak hoi nawnto qawktoep thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham loe a capa ah oh pongah, haek ving to anih han karai parai hmuen ah oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe Sithaw mah, Nawkta hoi na tamna nongpata pongah palungsae hmah; Sarah mah thuih ih lok to tahngai ah; nang ih atii loe Issak khae hoi ni tacawt tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na tamna nongpata ih capa doeh, na caa ah oh pongah, anih doeh acaeng maeto ah ka sak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khawnbang khawnthaw ah, Abraham mah takaw hoi moihin tui tabu to lak moe, Hagar to paek; anih ih palaeng ah koeng pae moe, nawkta hoi anih to nawnto haek ving; Hagar loe caeh poe moe, Beersheba praezaek ah amhet khing.
  </para>
  <para style="p">
    <verse number="15" style="v" />Moihin tui tabu pong ih tui to boeng naah loe, kabuk thing tlim ah nawkta to pasongh.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah kadueh nawkta to hnuk han ka koeh ai, tiah a thuih pongah caeh moe, nawkta hoi kangthla kue pala kahhaih setto kangthla ahmuen maeto ah anghnut pacoengah, tha hoi a qah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nawkta qahhaih lok to Sithaw mah thaih naah, Sithaw ih van kami mah Hagar to van hoiah kawk, anih khaeah, Hagar, tih raihaih maw na tongh? Zii hmah, Sithaw mah angsonghaih ahmuen hoi kaqah nawkta ih lok to thaih boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angthawk ah, nawkta to pathawk ah loe, na ban ah tapom ah; anih loe kalen parai acaeng ah ka sak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sithaw mah Hagar ih mik to amtuengsak naah, anih mah tuipuek maeto hnuk; a caeh moe, moihin tui tabu koi mongah tui to dok pacoengah, nawkta to tui naeksak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nawkta loe qoeng tahang, anih loe Sithaw mah oh thuih; praezaek ah khosak moe, kalii kaat kop kami ah angcoeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Paran praezaek ah oh naah, amno mah anih hanah Izip tanuh to zu ah lak pae.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abimelek hoi angmah ih misatuh angraeng Phikol mah Abraham khaeah, Na sak ih hmuen boih ah Sithaw mah ang oh thuih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah ka caa nuiah, to tih ai boeh loe ka caa ih caa patoeng nuiah, amsoem ai hmuen to ayae moe, angvin ah na ohhaih prae thungah kai mah kang tahmen baktih toengah, ka nuiah doeh tahmenhaih nam tuengsak toeng hanah; vaihi kai hanah Sithaw ih ahmin hoi lokkamhaih to sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham mah, Lokkamhaih ka sak han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah Abraham mah Abimelek khaeah, Na tamnanawk mah kai ih tuikhaw ang lomh pae o ving, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe Abimelek mah, Kai khaeah nang thui ai pongah, mi mah maw to tiah sak, tito ka panoek ai, vaihni ah ni ka thaih vop, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham mah tuu hoi maitawnawk to lak moe, Abimelek hanah paek; to pacoengah nihnik mah lokmaihaih to sak hoi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham mah tuu khongkha thung ih tuu tala sarihto lak.
  </para>
  <para style="p">
    <verse number="29" style="v" />To naah Abimelek mah Abraham khaeah, Tipongah tuu tala sarihto na pahoe loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih mah, Tuikhaw loe kaimah ni takaeh, tiah hnukung ah oh hanah hae tuu tala sarihto hae, ka ban thung hoi la ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lokmaihaih a sak hoi pongah, to ahmuen to Beersheba, tiah kawk o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abimelek hoi angmah ih misatuh angraeng Phikol loe, Beersheba ah misa angdaehhaih sak pacoengah, Philistin prae ah amlaem hoi let.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham mah Beersheba ah thingkung maeto tling moe, to ahmuen hoiah dungzan Angraeng, Sithaw ih ahmin to palawk.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abraham loe Philistin prae thungah saning kasawk ah khosak.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />To tiah hmuen oh pacoengah, Sithaw mah Abraham to tanoek, anih khaeah, Abraham tiah kawk; to naah anih mah, Khenah, hae ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah Sithaw mah, Na palung duek moe, maeto khue na tawnh ih na capa, Issak to hoi ah loe, Moriah prae ah caeh haih ah; kang patuek han ih mae ah kai khaeah nang tathlang hanah hmai angbawnhaih sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham loe khawnbang khawnthaw ah angthawk moe, laa hrang nuiah hmuenmae to a thuengh; a capa Issak hoi nawnto thendoeng hnetto a kawk moe, hmai angbawnhaih sak hanah, thing aek pacoengah, Sithaw mah thuih ih mae nuiah a caeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ni thumto naah to ahmuen to, Abraham mah kangthla hoiah khet.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham mah thendoeng hnik khaeah, Nang hnik loe haeah laa hrang to toep hoih; kai loe ka caa hoi nawnto ka caeh moe, Sithaw ka bok hoi pacoengah, nang hnik khaeah kang zoh let han, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham loe hmai angbawnhaih sak hanah thing to cop moe, a capa Issak to aputsak; hmai hoi haita to a ban ah sinh moe, nawnto a caeh hoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Issak mah ampa Abraham khaeah, Kam pa, tiah kawk. Abraham mah, Ka capa, haeah ka oh, tiah a naa. Issak mah, Hmai hoi thing loe a sin hoi boeh, toe hmai angbawnhaih sak hanah tuu caa loe naa ah maw oh? tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham mah, Ka capa, Hmai angbawnhaih sak hanah Sithaw angmah to tuu caa ah angpaek tih hmang, tiah a naa. To pacoengah nawnto caeh hoi poe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sithaw mah thuih ih mae to phak hoi naah, Abraham mah to ahmuen ah hmaicam to sak, a nuiah thing to pahong moe, a capa Issak to qui hoi taoengh pacoengah, hmaicam nui ih thing nuiah pasongh.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah Abraham mah ban payangh moe, a capa to hum hanah haita to a lak.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah van bang hoiah Angraeng ih van kami mah anih to, Abraham! Abraham! tiah kawk. Anih mah, Haeah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih mah, Nawkta nuiah na ban phok hmah; anih nuiah tidoeh sah hmah; maeto khue na tawn ih na capa mataeng doeh paawthaih na tawn ai pongah, Sithaw na zit, tito ka panoek boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham mah khet moe, doeng tahang naah, khenah, phroh kapring thungah takii kaman caeng, tuu tae to a hnuk; Abraham loe caeh moe, tuu tae to lak pacoengah, a capa zuengah hmai angbawnhaih to a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Abraham mah to ahmuen to, Jehovah-jireh, tiah kawk; vaihni ni khoek to, Angraeng ih mae nuiah loe Angraeng mah na paek tih, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Van kami ih Angraeng mah Abraham to van hoiah kawk let bae.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang loe maeto khue na tawnh ih na capa mataeng doeh paawthaih na tawn ai pongah, kaimah hoi kaimah lokkamhaih ka sak boeh, tiah Angraeng mah thuih;
  </para>
  <para style="p">
    <verse number="17" style="v" />tahamhoihaih kang paek moe, na caanawk to van ih cakaeh hoi tuipui taeng ih savuet zetto kang pungsak han; na caanawk mah misa ih vangpui khongkha to toep o tih;
  </para>
  <para style="p">
    <verse number="18" style="v" />ka lok na tahngaih pongah, na caanawk rang hoiah long nui ih kaminawk boih tahamhoihaih hnu o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pacoengah Abraham loe angmah ih thendoeng hnik khaeah amlaem let; nihcae loe amsak o moe, Beersheba ah caeh o; Abraham loe Beersheba ah khosak.
  </para>
  <para style="p">
    <verse number="20" style="v" />To tiah hmuennawk oh pacoengah Abraham khaeah, Khenah, nam nawk Nahor ih zu, Milkah loe caa sak mangh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Huz loe calu ah oh, amnawk Buz, Aram ih ampa Kemuel,
  </para>
  <para style="p">
    <verse number="22" style="v" />Khesed, Hazo, Pildash, Jidlaph hoi Bethuel cae to sak, tiah a thuih pae o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bethuel mah Rebekah to sak; Milkah mah Abraham amnawk Nahor hanah capa nongpa tazetto a sak pae.
  </para>
  <para style="p">
    <verse number="24" style="v" />A zula Reumah mah doeh Tebah, Gaham, Thahash hoi Maakah to sak pae.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sarah loe saning cumvai, pumphae sarihto hing;
  </para>
  <para style="p">
    <verse number="2" style="v" />Sarah loe Kanaan prae Kirjath Arba (Hebron tiah doeh thuih) ah duek; Abraham loe Sarah pongah palungset moe qah.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pacoengah Abraham loe kadueh a zu qok khae hoi angthawk moe, Hit caanawk khaeah lok a thuih, nihcae khaeah,
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai loe nangcae salakah angvin ah ni ka oh; kadueh ka zu qok aphum hanah long ahmuen na qan o sak thoem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hit kaminawk mah Abraham khaeah,
  </para>
  <para style="p">
    <verse number="6" style="v" />ka angraeng, Kaicae ih lok hae tahngai ah; nang loe kaicae salakah thacak angraeng capa ah na oh; na koeh ih ahmuen to qoi ah loe, qok to kaicae ih taprong salakah aphum ah; kadueh qok aphum hanah mi mah doeh taprong to paawt mak ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah Abraham loe angthawk moe, to prae thungah kaom Hit kaminawk hma ah akuep pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae khaeah, Kadueh ka zu ih qok to ka mikhnuk ah aphum sak han nang koeh o haih nahaeloe, ka lok hae tahngai oh; Zohar capa Ephron mah,
  </para>
  <para style="p">
    <verse number="9" style="v" />angmah ih lawk taengah kaom, Makpelah thlung khaw to, atho kating ah kai khaeah zawh hanah na hni pae oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To nathuem ah Ephron loe Hit kaminawk salakah anghnut; Hit kami Ephron loe vangpui khongkha thungah akun, Hit kami rangpui hmaa ah Abraham ih lok to pathim pae; anih mah,
  </para>
  <para style="p">
    <verse number="11" style="v" />ka angraeng, to tih na ai ni, ka lok hae tahngai ah; lawk to kang paek moe, lawk thungah kaom thlung khaw doeh kang paek; kaimah ih kaminawk hma ah nang han kang paek boeh, kadueh na zu ih qok to aphum lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham mah to kaminawk hma ah akuep let moe,
  </para>
  <para style="p">
    <verse number="13" style="v" />prae kaminawk mikhnuk ah Ephron khaeah, Na koeh nahaeloe, ka lok hae tahngai ah; lawk qanhaih atho to kang paek han; to ah qok ka phum thai hanah, atho hae na talawk paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ephron mah Abraham khaeah,
  </para>
  <para style="p">
    <verse number="15" style="v" />ka angraeng, tahngai ah, to long loe phoisa shekel cumvai palito a ting; toe nang hoi kai salakah timaw angaih? Kadueh na zu ih qok to mah aphum laih, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ephron ih lok to Abraham mah tapom moe, Hit kaminawk ih mikhnuk ah thuih ih lok baktih toengah, hmuen zaw kaminawk mah patoh ih tahhaih pongah, Ephron hanah phoisa cumvai palito a noek pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah Mamre hma ah kaom, Makpelah ahmuen, Ephron lawk thung ih thlung khaw hoi thingkungnawk boih, a taengah kaom thingkungnawk boih to,
  </para>
  <para style="p">
    <verse number="18" style="v" />vangpui khongkha thung akun Hit kaminawk boih mikhnuk ah Abraham ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pacoengah Abraham mah a zu sarah to Kanaan prae Mamre (Hebron) taengah kaom Makpelah lawk thung ih thlung khaw thungah aphum.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pongah lawk hoi a thungah kaom thlung khaw to, Abraham ih taprong ah oh thai hanah, Hit kaminawk mah raihaih om ai ah paek o.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham loe mitong boeh moe, saning doeh coeh boeh; Angraeng mah Abraham to hmuen boih ah tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham loe a imthung ih tamna kacoeh koek hoi a tawnh ih hmuennawk boih khenzawnkung khaeah, Na ban to ka phaih tlim ah tapawh ah;
  </para>
  <para style="p">
    <verse number="3" style="v" />ka capa hanah hae Kanaan nongpata zu ah lak pae han ai ah, van hoi long Sithaw khaeah Angraeng ih ahmin hoiah lokkamhaih kang saksak han;
  </para>
  <para style="p">
    <verse number="4" style="v" />ka prae ah kaimah ih acaengnawk khaeah caeh ah loe, ka capa Issak hanah zu to la paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />A tamna mah anih khaeah, Nongpata mah hae prae ah angzoh hanah ka hnukah bang koeh ai nahaeloe kawbang maw ka sak han loe? Nang zohhaih prae ah na capa to hoih moe, ka caeh haih let han maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham mah, To ahmuen ah ka capa caeh haih let hmah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kam pa imthung hoi kaimah ih acaeng kaminawk ohhaih prae thung hoiah kai zaehoikung, van Angraeng Sithaw mah, Na caanawk khaeah hae prae hae ka paek han, tiah ang thuih moe, lokmaihaih to a sak boeh; ka capa han to ahmuen ih zu to na lak pae thai hanah, na hma ah angmah ih van kami to patoeh tih hmang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nongpata mah na hnukah bang han koeh ai nahaeloe, ka lokkamhaih thung hoiah na loih tih; toe ka capa to to ahmuen ah caeh haih let hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah a tamna mah angmah ih angraeng Abraham ih phaih tlim ah ban to tapawh moe, hae hmuen kawng pongah anih khaeah lokkamhaih to a sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah a tamna loe angmah angraeng ih kaengkuu hrang hato lak, angmah angraeng ih kahoih hmuen congcanawk to a sin pacoengah, Mesopotamia prae, Nahor vangpui ah caeh hanah amsak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nongpatanawk tuidok tue duembang phak naah loe, vangpui tasa bang ih tui ohhaih ahmuen ah kaengkuu hrangnawk to taboksak.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah anih mah, Aw ka angraeng Abraham ih Angraeng Sithaw, vaihni ah ka thuih ih lok hae angcoengsak ah loe, ka angraeng Abraham nuiah na tahmenhaih amtuengsak ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khenah, hae ih tui khaw taengah kang doet, vangpui thung ih nongpatanawk tuidok han angzoh o naah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Tangla maeto khaeah, tui tabu to amtii raeh loe tui naek hanah na paek thoem ah, tiah ka naa han, to naah anih mah, Nae khae, nangmah ih kaengkuu hrangnawk hanah doeh tui kang dok paek han, tiah kathui nongpata to na tamna Issak ih zu ah om nasoe; to naah ni ka angraeng nuiah tahmenhaih nam tuengsak, tito ka panoek thai tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />To tiah lawkthuih pacoeng ai naah, khenah, Abraham ih amnawk Nahor zu Milkah capa, Bethuel ih canu, Rebekah loe tui tabu to sin moe, angzoh.
  </para>
  <para style="p">
    <verse number="16" style="v" />To nongpata loe kranghoih parai moe, kacuem tangla ah oh; kawbaktih nongpa hoiah doeh iip vai ai vop; anih loe tuikhaw ah caeh tathuk moe, tui to dok pacoengah angzoh tahang let.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah tamna loe nongpata khaeah karangah caeh moe, anih khaeah, Na tui tabu pong ih tui to na naesak thoem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih mah, Ka angraeng, nae khae, tiah a naa. A ban pong ih tui tabu to karangah amtik moe, naek hanah tui to a paek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anih han naek tui paek pacoengah, nongpata mah, Nang ih kaengkuu hrangnawk hanah doeh tui kang dok pae han, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tui tabu pong ih tui to okduk pongah karangah a lawn moe, tuidok let hanah tui khaw ah a caeh let; kaengkuu hrangnawk to tui a paek boih.
  </para>
  <para style="p">
    <verse number="21" style="v" />To kami mah nongpata to hnuk naah dawnrai, Angraeng mah anih kholong caehhaih to hmacawnsak maw, cawnsak ai, tito panoek hanah anghngai duem.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaengkuu hrangnawk tuinaeksak boih pacoengah, to kami mah shekel ahap kazit naa tangkraeng, shekel hato kazit sui hoiah sak ih banlakok to lak moe,
  </para>
  <para style="p">
    <verse number="23" style="v" />nang loe mi ih canu aa? Na thui ah, kaicae toem hanah nam pa ih im to kong tih maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nongpata mah anih khaeah, Kai loe Nahor ih zu Milkah capa, Bethuel ih canu ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To nongpata mah anih khaeah, Caphaeh hoi caaknaek doeh kakhawt ah oh moe, iih haih ahmuen doeh oh bae, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />To naah to kami mah akuep moe, Angraeng to a bok.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih mah, a tahmenhaih hoi oepthohhaih to caehtaak ai, ka angraeng Abraham ih Angraeng Sithaw loe, tahamhoihaih om nasoe; kholong ka caeh naah ka angraeng ih nawkamyanawk im ah Angraeng mah ang patoeh boeh, tiah a thuih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nongpata loe cawnh moe, amno ih imthung takoh khaeah to ih hmuen kawng to a thuih pae.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rebekah mah Laban, tiah ahmin kaom a thangqoi maeto tawnh; anih loe to kami ohhaih ahmuen tui khaw ah karangah cawnh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Laban mah naa tangkraeng hoi a tanuh ban ih banlakok to hnuk moe, Abraham tamna mah thuih ih lok doeh Rebekah khae hoi a thaih pongah, to kami khaeah a caeh, to naah to kami loe tui khaw taengah kaom kaengkuu hrangnawk ohhaih ahmuen ah angdoet.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih khaeah, Angraeng mah tahamhoihaih paek ih kami nang, angzo ah, tipongah tasa bangah nang doet sut loe? Nang hanah im ka pathoep moe, kaengkuu hrangnawk ohhaih ahmuen doeh ka sak boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />To kami to im ah caeh haih moe, kaengkuu hrang pong ih hmuennawk to amtiksak; kaengkuu hrangnawk hanah caphaeh hoi caak koi hmuennawk to a paek; angmah hoi angmah ih kaminawk khok amsaeh hanah tui doeh a sin pae.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pacoengah anih han buh to patoem pae, toe anih mah, Ka thuih han koi lok ka thui ai karoek to buh ka caa mak ai, tiah a naa. Laban mah, To tih nahaeloe thui khae, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />To pongah to kami mah, Kai loe Abraham ih tamna ah ka oh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sithaw mah ka angraeng to kating ai tahamhoihaih to paek pongah, anih loe angraeng parai; tuuunawk, maitawnawk, phoisa hoi suinawk, a tamna nongpa hoi nongpatanawk, kaengkuu hrang hoi laa hrangnawk doeh tawnh mang.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka angraeng ih zu Sarah mah mitong pacoengah capa maeto sak pae moe, a tawnh ih hmuenmaenawk boih a capa hanah paek.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka angraeng mah, Ka ohhaih prae thung ih, Kanaan tanuhnawk to ka capa han zu ah la pae hmah;
  </para>
  <para style="p">
    <verse number="38" style="v" />toe kam pa ih imthung takohnawk hoi kaimah ih acaeng kaminawk khaeah caeh ah loe, ka capa han zu to la paeh, tiah lok ang kamsak.
  </para>
  <para style="p">
    <verse number="39" style="v" />To naah kai mah ka angraeng khaeah, Nongpata mah ka hnukah bang han koeh ai nahaeloe kawbang maw ka sak han loe? tiah ka naa.
  </para>
  <para style="p">
    <verse number="40" style="v" />To naah anih mah kai khaeah, Kai loe, Angraeng hmaa ah kacaeh, to Angraeng mah angmah ih van kami to nang hoi nawnto patoeh ueloe, kholong na caehhaih hmacawnsak tih; kaimah ih acaeng hoi kam pa imthung takoh thung ih kami to ka capa han zu ah na la pae thaih tih hmang;
  </para>
  <para style="p">
    <verse number="41" style="v" />ka caengnawk khaeah na caeh pacoengah loe, kang saksak ih lokkamhaih thung hoiah na loih tih boeh; nihcae mah zu na paek o ai cadoeh, nang loe kang saksak ih lokkamhaih thung hoiah na loih tih boeh, tiah ang naa.
  </para>
  <para style="p">
    <verse number="42" style="v" />Vaihniah tui ohhaih ahmuen ah ka phak naah, Aw, ka angraeng Abraham ih Angraeng Sithaw, kholong ka caehhaih hae hma na cawnsak nahaeloe,
  </para>
  <para style="p">
    <verse number="43" style="v" />khenah, Kai loe tui ohhaih ahmuen taengah kang doet, tui kadoh tangla cuem angzoh naah anih khaeah, Na tui tabu pong ih tui to na naesak thoem ah, tiah ka naa han;
  </para>
  <para style="p">
    <verse number="44" style="v" />to naah anih mah, Nae khae, nang ih kaengkuu hrangnawk han doeh tui kang dok pae han, tiah thui kami to ka angraeng capa hanah Angraeng mah qoih ih zu ah om nasoe, tiah lawk ka thuih.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ka palung thung hoi lawkthuih boeng ai naah, Angmah ih palaeng ah tui tabu koeng moe, angzo Rebekah to ka hnuk; anih loe tuikung ah caeh tathuk moe, tui to a dok; to naah kai mah anih khaeah, Tui na naesak thoem ah, tiah ka naa.
  </para>
  <para style="p">
    <verse number="46" style="v" />To naah anih mah angmah palaeng nui ih tuidue to karangah amtik moe, Nae khae, nang ih kaengkuu hrangnawk doeh tui ka paek han, tiah ang naa. To pongah tui to ka naek pacoengah, kaengkuu hrangnawk to tui a paek.
  </para>
  <para style="p">
    <verse number="47" style="v" />To pongah kai mah, Nang loe mi ih canu aa? tiah lok ka dueng. Anih mah, Milkah mah sak ih Nahor capa, Bethuel ih canu ni, tiah ang pathim. To naah kai mah anih hanah naa tangkraeng to ka paek moe, a ban ah banlakok to ka buensak.
  </para>
  <para style="p">
    <verse number="48" style="v" />To pacoengah ka kuep moe, Angraeng to ka bok; ka angraeng Abraham amnawk ih canu patoeng to, a capa ih zu ah laksak hanah, katoeng loklam ah zaehoikung, ka angraeng Abraham ih Angraeng Sithaw to tahamhoihaih ka paek pacoengah, Angraeng to ka bok.
  </para>
  <para style="p">
    <verse number="49" style="v" />Vaihi ka angraeng nuiah tahmenhaih hoi oepthohhaih nam tueng o sak han maw, nam tueng o sak han ai, tito na thui oh; kai doeh bantang bangah maw, to ai boeh loe banqoi bangah maw, angqoi moe ka caeh han, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="50" style="v" />Laban hoi Bethuel mah, Hae hmuen loe Angraeng mah khokhan ih boeh ni; nang khaeah kasae kahoih kang thui hoi thai mak ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Khenah, Rebakah loe na hma ah oh; anih to la ah loe, caeh haih ah; Angraeng mah thuih ih lok baktih toengah, anih loe na angraeng capa ih zu ah om nasoe, tiah a thuih pae hoi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Nihnik mah thuih ih lok to Abraham ih tamna mah thaih naah, Long ah akuep moe, Angraeng to a bok.
  </para>
  <para style="p">
    <verse number="53" style="v" />To pacoengah sui hoi phoisa, amthoephaih khukbuennawk to a lak moe, Rebekah hanah a paek pacoengah, atho kana hmuennawk to a thangqoi hoi amno hanah doeh a paek.
  </para>
  <para style="p">
    <verse number="54" style="v" />To pacoengah angmah hoi nawnto angzo kaminawk hoi nawnto buhcaak o moe, qum to a iih o; khawnbang khawnthaw ah angthawk o pacoengah, anih mah, Ka angraeng khaeah na caehsak lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="55" style="v" />Toe a thangqoi hoi amno mah, Tangla loe kaicae khaeah ni hato om rae nasoe, to pacoengah na caeh haih tih hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="56" style="v" />Anih mah nihnik khaeah, Na kang hoi hmah; Angraeng mah kholong ka caehhaih hmacawnsak boeh pongah, ka angraeng khaeah na caehsak raeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="57" style="v" />To pacoengah nihnik mah, Tangla to kawk si loe, lokdueng rae si, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="58" style="v" />To pongah Rebekah to kawk hoi moe, anih khaeah, Hae kami hoi nawnto na caeh han maw? tiah lok a dueng hoi naah, anih mah, Ka caeh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="59" style="v" />To pongah angmah ih tanuh Rebekah hoi anih khenzawnkung loe, Abraham ih tamna, anih hoi nawnto angzo kaminawk hoi nawnto a caehsak.
  </para>
  <para style="p">
    <verse number="60" style="v" />Rebekah to tahamhoihaih paek hoi moe, anih khaeah, Ka tanuh, sing sangto kaminawk ih amno ah om nasoe loe, na caanawk mah misanawk ih khongkha to toep o nasoe, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="61" style="v" />To pacoengah Rebekah hoi anih ih nongpatanawk angthawk o moe, kaengkuu hrang nuiah angthueng o pacoengah, to kami hnuk ah bang o; Abraham ih tamna mah Rebakah to lak moe, a caeh haih.
  </para>
  <para style="p">
    <verse number="62" style="v" />To naah Issak loe aloih bang prae ah oh pongah, Beer Lahai Roi hoiah angzoh toeng.
  </para>
  <para style="p">
    <verse number="63" style="v" />Niduem naah loe khopoek hanah lawk ah caeh, a danh naah kangzo kaengkuu hrangnawk to a hnuk.
  </para>
  <para style="p">
    <verse number="64" style="v" />Rebekah mah doeh danh tahang naah, Issak to a hnuk; to naah kaengkuu hrang nui hoi anghum tathuk moe,
  </para>
  <para style="p">
    <verse number="65" style="v" />aicae dawt hanah taw ah angzo kami loe mi aa? tiah tamna to lok a dueng naah, tamna mah anih loe ka angraeng ni, tiah a naa. To pongah mikhmai khukhaih to a lak moe, a mikhmai to khuk.
  </para>
  <para style="p">
    <verse number="66" style="v" />To pacoengah tamna mah kangcoeng hmuennawk to Issak khaeah a thuih pae boih.
  </para>
  <para style="p">
    <verse number="67" style="v" />Issak mah anih to amno Sarah ohhaih imthung ah caeh haih moe, Rebekah to a zu haih; anih loe Issak ih zu ah angcoeng, Issak mah anih to palung pongah, amno duek pacoengah doeh poek monghaih to tawnh.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham loe zu maeto lak let, anih ih ahmin loe Keturah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah Zimran, Jokshan, Medan, Median, Ishbak hoi Shuah to sak pae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jokshan mah Sheba hoi Dedan to sak. Dedan ih caanawk loe Asshur kaminawk, Letush kaminawk hoi Leum kaminawk ah oh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Midian caanawk loe Ephah, Epher, Hanok, Abidah hoi Eldaah. Hae kaminawk boih loe Keturah mah sak ih caanawk ah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham loe a tawnh ih hmuennawk boih Issak hanah paek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe a hing naah angmah zula ih caanawk hanah tangqumnawk to a paek moe, nihcae to a capa Issak hma hoi ni angyae bangah patoeh boih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abraham loe mitong boeh moe, saning cumvai qui sarih, pangato hing.
  </para>
  <para style="p">
    <verse number="8" style="v" />To tiah mitong moe, hinghaih qui apet pacoengah a duek, to pacoengah angmah ih kaminawk khaeah caeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A caa Issak hoi Ishmael mah Mamre vangpui pha ai nathuem ih, Hit kami Zohar capa Ephron ih lawk thungah kaom, Makpelah thlung khaw thungah aphum hoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />To lawk loe Abraham mah Hit kaminawk khaeah qanh; Abraham hoi a zu Sarah loe to ahmuen ah aphum hoi hmaek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham duek pacoengah, Sithaw mah Issak to tahamhoihaih paek; Issak loe Beer Lahai Roi taengah khosak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sarah ih tamna Izip tanuh, Hagar mah Abraham han sak pae ih, Abraham capa Ishmael ih caanawk kawng loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ishmael caanawk ih ahmin loe, angmacae acaeng anghumhaih ahmin baktih toengah, calu ah Nebajoth, Keder, Adbeel, Mibsam;
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Dumah, Massa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadar, Tema, Jetur, Naphish hoi Kedemah;
  </para>
  <para style="p">
    <verse number="16" style="v" />hae kaminawk loe Ishmael ih caa ah oh o, to tiah ahmin kaom kaminawk loe, angmacae ih vangpui, angmacae misa abuephaih baktih toengah, acaeng hatlai hnetto ukkung ah oh o roep.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ishamael loe saning cumvai qui thum, sarihto hing; a hinghaih qui apet moe, duek pacoengah, angmah ih kaminawk khaeah angkuem.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih ih caanawk loe Assyria prae caehhaih loklam, Havilah hoi Izip prae ni angyae bang ih Shur vangpui khoek to khosak o; anih loe angmah ih nawkamyanawk boih hma ah duek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abraham capa, Issak kawng loe hae tiah oh; Abraham mah Issak to sak;
  </para>
  <para style="p">
    <verse number="20" style="v" />Issak loe Padan Aram ahmuen ah kaom, Syria acaeng Bethuel ih canu, Syria acaeng Laban ih tanuh, Rebekah to zu ah lak naah, saning qui palito oh boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A zu loe caa kaak pongah, Issak mah a zu hanah Angraeng khaeah lawkthuih pae; Angraeng mah lawkthuihaih lok to tahngaih pae pongah, a zu Rebekah loe zokpomh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A zok thung ih nawkta loe maeto hoi maeto ang-et hoi khing; to naah amno mah, Tipongah hae tiah oh vai? tiah poek. To pongah lokdueng hanah Angraeng khaeah a caeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah anih khaeah, Na zok thungah kami acaeng hnetto oh; na zok thung hoiah tuinuen kalah acaeng hnetto tacawt tih; acaeng maeto loe kalah acaeng maeto pongah thacak kue ueloe, kacoeh mah kanawk ih tok to sah pae tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nawkta zahhaih tue phak naah, anih zok thung ih nawkta loe angphae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tacawt hmaloe loe ngan to thim dung, a tak loe amui cing ah oh; to pongah anih to Esau, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pacoengah amnawk to tapen; a ban hoiah Esau ih khok tahmawh to patawnh; to pongah anih to Jakob, tiah ahmin sak; Rebakah mah nihnik to sak naah, Issak loe saning qui tarukto oh boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nawkta hnik loe qoeng hoi tahang, Esau loe moi kat kop kami, moi zoep thaih kami ah oh; toe Jakob loe kaom duem kami ah oh moe, kahni imthung ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Issak loe taw ih moi to caak pongah Esau to palung, toe Rebekah mah loe Jakob to palung.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nito naah loe Jakob mah caak koi maeto thongh, to naah Esau loe taw hoiah angzoh moe, zok amthlam parai pongah,
  </para>
  <para style="p">
    <verse number="30" style="v" />Esau mah Jakob khaeah, Na thongh ih kamling huep caak koi to na paek thoem ah, zok amthlam parai boeh, tiah a naa. To pongah anih ih ahmin to Edom, tiah sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />To naah Jakob mah, Calu ah na ohhaih to vaihniah kai khaeah na zaw ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />To naah Esau mah, Khenah, ka duek tom boeh; calu ah ohhaih loe timaw atho oh? tiah a thuih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jakob mah vaihniah kai khaeah lokkamhaih sah ah, tiah a naa. Esau mah anih khaeah lokkamhaih sak pacoengah, calu ah ohhaih to Jakob khaeah a zawh.
  </para>
  <para style="p">
    <verse number="34" style="v" />To pacoengah Jakob mah takaw hoi peh to Esau hanah paek; anih mah caak moe, naek pacoengah, angthawk moe, a caeh. To tiah Esau mah calu ah ohhaih to khet patoek.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham dung nathuem ah kaom hmaloe koek khokhahaih oh pacoengah, to prae thungah khokhahaih oh let. To pongah Issak loe Gerar ah kaom Philistin siangpahrang Abimelek khaeah caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Issak khaeah Angraeng angphong pae moe, Izip prae ah caeh tathuk hmah; oh han kang thuih ih prae ah om ah;
  </para>
  <para style="p">
    <verse number="3" style="v" />hae prae thungah om ah, kai mah kang oh thuih moe, tahamhoihaih kang paek han; hae prae boih hae nangmah hoi na caanawk khaeah kang paek moe, nam pa Abraham khaeah ka sak ih lokmaihaih to ka koepsak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na caanawk to van ih cakaeh zetto kang pungsak moe, hae prae hae kang paek boih han; na caanawk rang hoiah long nui ih kaminawk boih tahamhoihaih hnu o tih;
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham loe ka lok to tahngaih, ka thuih ih loknawk, patuk ih loklamnawk hoi daannawk to pazui, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah Issak loe Gerar ah oh;
  </para>
  <para style="p">
    <verse number="7" style="v" />to ah kaom kaminawk mah a zu kawng to dueng o naah, anih mah ka zu ni, tiah thuih han zit pongah, Ka tanuh ni, tiah a thuih. To tiah thui ai nahaeloe Rebekah loe kranghoih pongah, hae prae ah kaom kaminawk mah na hum o moeng tih, tiah a poek.
  </para>
  <para style="p">
    <verse number="8" style="v" />To prae thungah atue kasawk ah oh; nito naah loe Philistin siangpahrang Abimelek mah thokbuem hoiah dan tathuk naah, kamhai Issak hoi a zu Rebekah to a hnuk.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah Abimelek mah Issak to kawk moe, Khenah, anih loe na zu bae to; tipongah anih loe ka tanuh ni, tiah na thuih loe? tiah a naa. Issak mah anih khaeah, to tiah ka thui ai nahaeloe anih pongah ka dueh moeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah Abimelek mah, Tipongah kaicae khaeah to tiah lok na thuih loe? Kami maeto mah na zu hae iip haih moeng nahaeloe, kaicae nuiah zaehaih nam tik sut han bae to, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah Abimelek mah angmah ih kaminawk boih khaeah, Mi kawbaktih doeh hae kami, anih ih zu sui kami loe hum oh, tiah lok paek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Issak loe to prae thungah lawk to sak; Angraeng mah tahamhoihaih paek moe, saningto thungah cang alet cumvaito hak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih loe to nathuem hoiah angraeng amtong moe, angraeng parai, a tawnh ih hmuennawk doeh pung pae aep aep;
  </para>
  <para style="p">
    <verse number="14" style="v" />tuunawk, maitawnawk hoi tamna paroeai a tawnh pongah, Philistin kaminawk mah anih to ut o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ampa Abraham hing na thung a tamnanawk han takaehsak ih tuikhawnawk to Philistinnawk mah pit pae o ving moe, long hoiah taet pae o boih let.
  </para>
  <para style="p">
    <verse number="16" style="v" />To naah Abimelek mah Issak khaeah, Nang loe kaicae pong thacak boeh pongah, hae ahmuen hoi kalah bangah caeh lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah Issak mah to ahmuen to caehtaak moe, Gerar azawn ah khosak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ampa hing nathuem ah takaeh ih tuikhawnawk, Abraham duek pacoengah Philistinnawk mah pahnawtsak ih tuikhawnawk to Issak mah a tamnanawk han takaehsak let moe, ampa mah sak ih ahmin to sak let.
  </para>
  <para style="p">
    <verse number="19" style="v" />Issak ih tamnanawk mah azawn ah tui takaeh o moe, kaciim tuipuek to hnuk o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe Gerar ah maitaw toep kaminawk hoi Issak ih maitaw toep kaminawk loe maeto hoi maeto, Kai ih tui ni, tiah anglomh o. To tiah anglomh o pongah, to ih tuikhaw to Esek, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah kalah tuikhaw to takaeh let, to tuikhaw doeh anglomh o let bae; to pongah to tuikhaw to Sitnah, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />To ahmuen hoi angpuen o moe, kalah tuikhaw maeto takaeh o let; to naah loe mi mah doeh lomh o ai boeh. Vaihi loe Angraeng mah ahmuen paek boeh moe, prae thungah qoeng o tahang tih boeh, tiah a thuih pongah, to tuikhaw to Rehoboth, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih loe to ahmuen hoiah Beersheba ah caeh tahang.
  </para>
  <para style="p">
    <verse number="24" style="v" />To na ni qum ah anih khaeah Angraeng angphong pae, Kai loe nam pa Abraham ih Sithaw ah ka oh; zii hmah, nang hoi nawnto ka oh, ka tamna Abraham rang hoiah tahamhoihaih kang paek moe, na caanawk kang pungsak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Issak mah to ahmuen ah hmaicam to sak moe, Angraeng hmin to kawk; to ah kahni im a sak moe, a tamnanawk mah tuikhaw to takaeh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />To naah Abimelek loe angmah ih ampui Ahuzzath hoi misatuh angraeng Phikol to hoih moe, Gerar vangpui hoiah Issak ohhaih ahmuen ah caeh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Issak mah nihcae khaeah, Kai nang hnukma o moe, nang haek o boeh na ai maw, tikhoe nang zoh o let loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae mah, Angraeng loe nang hoi nawnto oh, tito kahoih ah ka panoek o boeh; to pongah, aicae salakah lokmaihaih to om nasoe, kaicae hoi nang salak lokmaihaih to om nasoe, tiah ka thuih o; kaicae hoi nang salakah angdaehhaih sah si;
  </para>
  <para style="p">
    <verse number="29" style="v" />kaicae mah na nuiah kahoih hmuen khue ai ah loe, sethaih tidoeh ka sah o ai, nang to lunghoih ta ah ni kang patoeh o; to pongah nangmah doeh kaicae sethaih to sah hmah; nang loe Angraeng mah vaihi tahamhoihaih paek boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pacoengah Issak mah nihcae hanah buh raenghaih to sak pae, nihcae loe caak o moe naek o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khawnbang khawnthaw ah angthawk o moe, maeto hoi maeto lokmaihaih to sak o; to pacoengah Issak mah nihcae to patoeh; nihcae loe lunghoih ta hoiah caeh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />To na niah Issak ih tamnanawk to angzoh o moe, tuikhaw takaehhaih kawng to thuih pae o, anih khaeah, Tui to ka hnuk o boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih mah to tui to Shebah, tiah ahmin sak; to pongah to vangpui ih ahmin loe vaihni ni khoek to Beersheba, tiah kawk o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau loe saning qui palito oh naah, Hit kami Beeri canu, Judith hoi Hit kami Elon canu, Bashemath to zu ah lak;
  </para>
  <para style="p">
    <verse number="35" style="v" />nihnik loe Issak hoi Rebekah dawnrai paekkung ah oh hoi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Issak loe mitong moe, miktha om ai boeh pongah, mik doeh amtueng ai boeh, to naah a capa kacoeh Esau to kawk moe, Ka capa, tiah a naa. Anih mah, Khenah, haeah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Issak mah, Khenah, kai loe vaihi mitong boeh moe, natuek naah maw ka duek han, tito ka panoek ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah vaihi na sin ih hmuen, kalii hoi palaa to la ah; taw ah caeh ah loe, kai han moi na kat paeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka caak koeh ih moi to kakhraem ah thong ah loe, caak han ka hmaa ah na patoem ah; ka dueh ai naah tahamhoihaih kang paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Issak mah a capa Esau khae thuih ih lok to Rebekah mah thaih. To pongah Esau loe moi kah han taw ah caeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rebekah mah a capa Jakob khaeah, Khenah, Nam pa mah nam ya Esau khaeah,
  </para>
  <para style="p">
    <verse number="7" style="v" />taw ih moi to kat ah loe kakhraem ah thongh pacoengah, ka caak hanah na sin ah; ka dueh ai naah Angraeng hmaa ah tahamhoihaih kang paek han, tiah thuih ih lok to ka thaih.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah, Ka capa, vaihi kang thuih ih lok hae tahngai ah loe sah ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vaihi tuu khongkha thungah caeh ah loe kahoih maeh caa hnetto la ah; nam pa mah koeh baktih toengah ka thongh pae han;
  </para>
  <para style="p">
    <verse number="10" style="v" />to pacoengah nam pa caak hanah sin paeh, dueh ai naah tahamhoihaih na paek nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jakob mah amno Rebekah khaeah, Khenah, kam ya Esau loe ngnmui tawnh moe, kai loe nganmui ka tawn ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pa mah na pathoep doeh om tih, to naah kai loe minawk aling kami baktiah ka om ueloe, tahamhoihaih hnu ai ah, tangoenghaih ka hnu lat tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amno mah anih khaeah, Ka capa, nang tangoenghaih loe ka nuiah krah nasoe; ka thuih ih lok hae tahngai ah loe, kahoih maeh caa to la ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah anih loe caeh moe, amno khaeah maeh caa to sinh pae; amno mah ampa caak koeh baktih toengah moi to thongh pae.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah Rebekah mah a capa kacoeh Esau ih khukbuen kahoih to imthung ah lak moe, a capa kanawk Jakob to angkhuksak.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah Rebakah mah Jakob ih ban hoi tahnong to maeh caa ahin hoiah khuk pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah a capa Jakob ban ah, caak khraem ah a thong het ih takaw hoi moi to a paek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih loe ampa khaeah caeh moe, Pa, tiah a naa. Anih mah, Haeah ka oh, ka capa, nang loe mi aa? tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob mah ampa khaeah, Kai loe na calu Esau ni, nang thuih ih lok baktih toengah ka sak boeh; tahamhoihaih nang paek hanah, angthawk ah loe anghnut pacoengah, ka kah ih moi hae caa lai ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Issak mah a capa khaeah, Kawbang maw akra ai ah moi na hak thaih takan loe? Ka capa? tiah a naa. Anih mah, Na Angraeng Sithaw mah, ang haksak, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />To naah Issak mah Jakob khaeah, Ka capa, kai khaeah angzo ah, Esau tangtang maw, tangtang ai, tito kang pathoep han vop, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jakob loe ampa Issak khaeah caeh, anih mah pathoep pacoengah, Lok loe Jakob ih lok, toe ban loe Esau ih ban ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ban loe amya Esau ih ban baktiah amui oh pongah, anih mah panoek thai ai; to pongah anih han tahamhoihaih to a paek.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih mah, Nang hae ka capa Esau tangtang maw? tiah a naa. Anih mah, Ue, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pacoengah anih mah, Tahamhoihaih kang paek hanah, na kah ih moi to caak han na sin ah, tiah a naa. Jakob mah moi to a taengah patoemh pae moe, a caak. To pacoengah misurtui doeh patoemh pae moe, a naek.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pacoengah ampa Issak mah anih khaeah, Ka capa, ka taengah angzo ah loe, na mok ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih mah caeh moe, a mok. Issak mah khukbuen hmui to thaih naah, anih han tahamhoihaih a paek; khenah, ka capa ih hmui loe, Angraeng mah tahamhoihaih paek ih lawk hmui hoiah anghmong;
  </para>
  <para style="p">
    <verse number="28" style="v" />to pongah Sithaw mah van ih dantui hoi kathawk long to paek nasoe loe, cang hoi misurtui doeh pungsak nasoe;
  </para>
  <para style="p">
    <verse number="29" style="v" />prae kaminawk boih mah nang ih tok to sah o nasoe loe, kaminawk na hmaa ah akuep o nasoe; nam nawkamyanawk nuiah angraeng ah om ah loe, nam no ih caanawk doeh na hmaa ah akuep o nasoe; nang tangoeng kaminawk loe tangoenghaih tongh o nasoe loe, nang tahamhoihaih paek kaminawk to tahamhoihaih hnu o nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Issak mah Jakob tahamhoihaih paek pacoengah, ampa hmaa hoiah tacawt; akra ai ah Esau loe moi zoephaih ahmuen hoiah phak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih mah doeh moi to caak khraem ah thongh moe, ampa hanah patoem pae; ampa khaeah, Pa, tahamhoihaih nang paek hanah, angthawk ah loe ka kah ih moi hae caa ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ampa Issak mah anih khaeah, Nang loe mi aa? tiah a naa. Anih mah, Kai loe na calu, Esau ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />To naah Issak loe paroeai tasoeh moe, Moi kah moe, ka caak hanah moi sin kami loe naa ah maw oh? Nang, nang zo ai naah moi to ka caak ving boeh moe, anih han tahamhoihaih ka paek moeng boeh; tahamhoihaih loe anih mah ni hnu tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau mah ampa ih lok to thaih naah, tha hoi qah moe, ampa khaeah, Aw, pa, kai doeh tahamhoihaih na paek toeng ah, Pa, kai doeh, tahamhoihaih na paek toeng ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />Toe anih mah, Nam nawk mah palunghahaih hoiah ang ling boeh moe, nang ih tahamhoihaih to lak boih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />Esau mah, angmah ih ahmin hoi kamcuk ah Jakob, tiah ahmin to phui roe boeh na ai maw? Vaihi a sak ih hmuen hoiah loe kai vai hnetto ang ling boeh; ka calu ah ohhaih to ang lomh pae moe, vaihi doeh tahamhoihaih ang lak pae ving let bae vop, tiah a thuih. To pacoengah anih khaeah, Kai han tahamhoihaih nang suem pae ai boeh maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Issak mah Esau khaeah, Khenah, Anih loe nang ih angraeng ah ka sak moe, anih ih nawkamyanawk boih doeh anih ih tamna ah ka paek boeh; cang hoi misurtui doeh ka paek boeh; to pongah nang han timaw kang sak pae han loe? Ka capa, tiah a naa.
  </para>
  <para style="p">
    <verse number="38" style="v" />Esau mah ampa khaeah, Tahamhoihaih maeto doeh na tawn ai boeh maw, pa? Pa, kai doeh tahamhoihaih na paek toeng ah, tiah a naa. To pacoengah Esau loe tha hoi qah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ampa Issak mah anih han hae tiah lok pathim pae; khenah, Na ohhaih ahmuen loe kathawk long ah om ueloe, van bang hoiah dantui to krah tih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang loe sumsen hoi kho na sah ueloe, nam nawk ih tok to na sah pae tih; toe ukhaih atue phak naah loe anih mah phawsak ih kazit hmuen to na tahnong nui hoiah nang khring tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ampa mah Jakob han tahamhoihaih paek king boeh pongah, Esau mah Jakob to hnukma; pa duekhaih ni loe zoi boeh; to na niah kamnawk Jakob hae ka hum han, tiah a poek.
  </para>
  <para style="p">
    <verse number="42" style="v" />A capa kacoeh Esau ih lok to amno Rebekah mah thaih; to pongah capa kanawk Jakob to kami kawksak moe, anih khaeah, Khenah, nam ya Esau palungphuihaih dip thai hanah, na hum tih boeh.
  </para>
  <para style="p">
    <verse number="43" style="v" />To pongah ka capa, vaihi kang thuih ih lok hae tahngai ah; vaihi Haran ah kaom ka thangqoi Laban khaeah cawn ah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nam ya palungphuihaih dip ai karoek to anih khaeah om ah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nam ya palungphuihaih to dip moe, a nuiah na sak ih hmuen to pahnet pacoengah, nang zoh let hanah lok kang pat moe, nang to kang kawksak han hmang; kawbang maw nito thungah ka capa hnik hanah palung ka sae thuih hmaek thai tih? tiah a thuih.
  </para>
  <para style="p">
    <verse number="46" style="v" />Rebekah mah Issak khaeah, Heth ih canunawk pongah poek kang pho boeh; Jakob mah hae prae kami canunawk baktih, Heth ih canunawk hoiah imthong krah nahaeloe, kai han hinghaih atho timaw om tih? tiah a naa.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pongah Issak mah Jakob to kawk moe, anih to tahamhoihaih paek pacoengah, anih khaeah, Kanaan tanuh to zu ah la hmah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angthawk ah, nam no ih ampa Bethuel ohhaih Padan Aram ah caeh ah loe, to ah nam no ih thangqoi Laban ih canunawk to nangmah han zu ah la ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Acaeng pop mang ai karoek to, Thacak Sithaw mah tahamhoihaih na paek nasoe loe, athaih taksak pacoengah, kami doeh pungsak nasoe;
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw mah Abraham khaeah paek ih prae to na toep hanah, Angraeng mah Abraham khaeah paek ih tahamhoihaih baktiah, vaihi angvin ah na ohhaih hae prae hae, nangmah hoi na caanawk khaeah paek nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pacoengah Issak mah Jakob to caehsak; anih loe Syria acaeng Bethuel capa, Jakob hoi Esau amno Rebekah ih thangqoi, Laban ohhaih Padan Aram ah caeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Issak mah Jakob tahamhoihaih paek moe, zu lak hanah Padan Aram ah patoeh; tahamhoihaih paek naah, anih khaeah, Kanaan tanu to zu ah la hmah, tiah lok a thuih pae,
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob loe amno hoi ampa ih lok to tahngaih moe, Padan Aram ah caeh, tito Esau mah panoek,
  </para>
  <para style="p">
    <verse number="8" style="v" />Kanaan tanunawk zu ah ka lak pongah kam pa Issak poeknawm ai, tito Esau mah panoek naah,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ishmael khaeah a caeh moe, Nebajoth ih tanuh, Abraham capa Ishmael ih canu Mahalath to zu ah lak let.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob loe Beersheba hoiah amsak moe, Haran ah caeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Niduem boeh pongah, ahmuen maeto phak naah, aqum puek to ahmuen ah anghak; to ih thlungnawk to a lak moe, lu anghnoeng hanah a suek pacoengah, to ahmuen ah a iih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amang ah tadong van khoek to kapha thlak maeto long ah oh; khenah, to thlak nuiah daw tahang moe, anghum tathuk, Sithaw ih van kaminawk to a hnuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khenah, Angraeng loe thlak ranui ah anghnut moe, Kai loe nam pa Abraham ih Angraeng Sithaw hoi Issak ih Sithaw ah ka oh; nang songhaih ahmuen to nangmah hoi na caanawk khaeah ka paek han;
  </para>
  <para style="p">
    <verse number="14" style="v" />na caanawk loe long nui ih maiphu zetto pung o ueloe, niduem, ni angyae, aluek aloih bang khoek to koi o tih; nang hoi na caanawk rang hoiah long kaminawk boih tahamhoihaih hnu o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khenah, nang to kang oh thuih han, na caehhaih ahmuen kruekah kang khetzawn moe, hae prae ah kang hoih let han; kang thuih ih lok koep ai karoek to kang caehtaak mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jakob loe iihhaih ahmuen hoiah angthawk pacoengah, hae ahmuen ah Angraeng oh tangtang, tito ka panoek ai, tiah thuih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih loe zit moe, Hae ahmuen loe zit kaom ahmuen ni; hae ahmuen loe tih kalah doeh na ai, toe Angraeng ih im ah ni oh; hae loe van khongkha ni, tiah a thuih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob loe khawnbang khawnthaw ah angthawk moe, lu koeng han suek ih thlung to a lak, thlung to a thlingh pacoengah, a nuiah situi to a bawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tangsuek naah loe to vangpui to Luz, tiah ahmin sak, toe to ahmuen to Bethel, tiah a paek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jakob mah, Kai khaeah Sithaw oh moe, vaihi ka caehhaih loklam ah doeh ang khetzawn pacoengah, caaknaek hoi khukbuen doeh ang paek pongah,
  </para>
  <para style="p">
    <verse number="21" style="v" />kam pa im ah lunghoih ta hoi kam laem thai let nahaeloe, Angraeng loe ka Sithaw ah om ueloe,
  </para>
  <para style="p">
    <verse number="22" style="v" />haeah ka thling ih thlung loe Angraeng ih im ah om tih; nang paek ih hmuennawk boih thung hoi hato thungah maeto kang paek han, tiah lokkamhaih a sak.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jakob loe kholong a caeh moe, ni angyae bang kaminawk ohhaih ahmuen to phak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah khet naah, lawk thungah tuikhaw maeto a hnuk; tuunawk loe to ih tuikhaw taengah ahmuen thumto ah tabok o; to ih tuikhaw thung ih tui to tuunawk han naek o sak; to ah tuikhaw kraenghaih kalen parai thlung kangphaek maeto oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuutoep kaminawk to ah oh o naah, tuikhaw kraenghaih kalen parai thlung kangphaek to takhoe o moe, tuunawk to tui naek o sak; to pacoengah tuikhaw to thlung hoiah kraeng o let.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jakob mah tuutoep kaminawk khaeah, Nawkamyanawk naa hoiah maw nang zoh o? tiah lok a dueng. Nihcae mah, Haran hoiah kang zoh o, tiah pathim pae o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae khaeah, Nahor ih capa Laban to na panoek o maw? tiah a naa. Nihcae mah, Ka panoek o bae, tiah a naa o.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah Jakob mah nihcae khaeah, Anih loe ngantui hmang maw? tiah a naa. Nihcae mah, Ngan a tui bae; khenah, a canu Rachel loe tuunawk hoi nawnto angzoh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah, Khenah, niduem ai vop; tuunawk huih han atue pha ai vop; tuunawk to tui nae o sak ah loe, rawkcak pacah o rae khae, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae mah, Ka hui o mak ai vop; tuunawk to acuu boih moe, tuikhaw kraenghaih kalen parai thlung kangphaek takhoe pacoeng, tuunawk tui ka paek o ai karoek to ka caeh o thai mak ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae hoi lok apaeh li naah, Rachel loe ampa ih tuunawk to huih moe, angzoh; anih loe tuutoep kami ah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob mah amno ih tangqoi Laban canu Rachel hoi amno ih thangqoi Laban ih tuunawk to hnuk naah, caeh moe, tuikhaw kraenghaih kalen parai thlung kangphaek to takhoe pae, amno ih thangqoi Laban ih tuunawk to tui a naeksak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jakob mah Rachel to mok moe, tha hoi qah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jakob mah Rachel khaeah anih loe ampa ih nawkamya ah oh moe, Rebekah ih capa ah ohhaih kawng to a thuih pae; to pongah Rachel loe cawnh moe, ampa khaeah thuih pae.
  </para>
  <para style="p">
    <verse number="13" style="v" />Laban mah a tanuh ih capa Jakob kawng to thaih naah, anih tongh hanah karangah cawnh; takop moe, a mok pacoengah, angmah im ah a caeh haih. Jakob mah im ah phak naah, kangcoeng tangcae hmuennawk kawng to a thuih pae.
  </para>
  <para style="p">
    <verse number="14" style="v" />Laban mah anih khaeah, Nang loe ka thii ka ngan ah ni na oh, tiah a naa. Anih loe khrah to thung Laban khaeah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Laban mah Jakob khaeah, Kai ih nawkamya ah na oh pongah, kai han tih tok doeh nang sah pae mak ai maw? Na toksakhaih atho to na thui ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laban loe canu hnetto tawnh; canu kacoeh ahmin loe Leah, canu kanawk ih ahmin loe Rachel.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leah loe mik hoih parai ai; toe Rachel loe kranghoih moe, palung han koiah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob loe Rachel to koeh moe, Nang han saning sarihto thung tok kang sak pae han, na canu kanawk Rachel to na paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban mah anih to minawk kalah han ka paek pongah loe, nang han kang paek to hoih kue, tiah a naa. Kai khaeah mah om poe ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pongah Rachel hak hanah saning sarihto thung tok a sak; toe Rachel to koeh pongah setta thung atue kalaem baktiah a poek.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah Jakob mah Laban khaeah, Ka zu na paek lai ah, ka toksakhaih atue doeh khawt boeh, anih hoi nawnto iih han ka koeh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />To pongah Laban mah to ahmuen ih kaminawk boih to kok moe, buh raenghaih a sak pae.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe niduem naah loe a canu Leah to zaeh moe, Jakob khaeah a caeh haih; anih to Jakob mah iih haih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Laban mah a tamna Zilpah to a canu Leah khenzawnkung ah paek.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khenah, khawnbang khawnthaw ah loe, Leah ah oh pae ving; to pongah Jakob mah Laban khaeah, Tipongah hae tiah nang sak loe? Rachel han ah ni tok kang sak pae; tipongah kai nang ling loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban mah, Kaicae prae ah loe, Canu kacoeh sava sah ai naah, kanawk sava sah sai ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zu lakhaih ni sarihto boeng rae nasoe; to pacoengah saning sarihto toksah let ah, to naah canu kanawk doeh kang paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jakob loe to tiah toksak hanah oh let; Leah hoi ni sarihto thung oh hoi pacoengah, Laban mah a canu Rachel to zu ah paek.
  </para>
  <para style="p">
    <verse number="29" style="v" />Laban mah a tamna nongpata Billah to, a canu Rachel khenzawnkung tamna ah paek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jakob mah Rachel to iih haih; anih mah Leah pongah Rachel to palung kue; to pacoengah Laban hanah saning sarihto thung toksak pae let.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jakob mah Leah hnukma, tito Angraeng mah hnuk naah, anih ih caa im to paongh pae, toe Rachel loe caa kaak.
  </para>
  <para style="p">
    <verse number="32" style="v" />Leah loe zokpomh moe, capa maeto sak; kai patangkhanghaih Angraeng mah hnuk boeh, vaihi loe ka sava mah na palung tih boeh, tiah a poek pongah, a capa to Reuben, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih loe zokpomh let moe, capa maeto sak; kai hnukmahaih to Angraeng mah ang panoek pae pongah, hae capa doeh ang paek let, tiah a thuih; to pongah Simeon, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Anih loe zokpomh let moe, capa maeto sak; ka sava hanah capa thumto ka sak pae boeh pongah, anih loe kai khaeah ni akap tih boeh, tiah a thuih. To pongah Levi, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Anih loe zokpomh let moe, capa maeto sak, to naah vaihi loe Angraeng to ka pakoeh han boeh, tiah a thuih; to pongah Judah, tiah ahmin sak. To pacoeng loe anih caa sah ai boeh.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob han caa maeto doeh sah pae ai, tito Rachel mah panoek naah, Rachel mah amya to ut; to pongah Jakob khaeah, Nawkta to na paek ah, to tih ai nahaeloe ka duek han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob loe Rachel nuiah palungphui moe, anih khaeah, Kai loe nang caa kaaksak thaih Sithaw ah maw ka oh? tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah anih mah, Khenah, ka tamna Billah khaeah caeh ah, anih mah caa na sah pae nasoe, anih rang hoiah imthung takoh kang doet toeng han, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pongah anih mah a tamna Billah to zu ah paek; anih to Jakob mah iih haih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe zokpomh moe, Jakob hanah capa mae to sak pae.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Rachel mah, Sithaw mah kai ang bomh, tahmen ka hnikhaih lok ang thaih pae moe, capa maeto ang paek boeh, tiah thuih; to pongah anih mah Dan, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rachel ih tamna Billah loe zokpomh let moe, Jakob hanah capa maeto sak pae let.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rachel mah, Kamya hoi kang pan hoi moe, ka pazawk boeh, tiah thuih. To pongah anih mah Naphtali, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leah mah doeh caa ka sah ai boeh, tiah panoek naah, a tamna Zilpah to caeh haih moe, Jakob han zu ah paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Leah ih tamna Zilpah mah Jakob han capa maeto sak pae.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah Leah mah, Misatuh kami abu to angzoh, tiah thuih; to pongah anih mah Gad, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leah ih tamna Zilpah mah Jakob hanah capa maeto sak pae let.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah Leah mah, Kang hoe parai, nongpatanawk mah tahamhoih kami, tiah na kawk o tih, tiah thuih pongah, Asher, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cang aah tue naah, Reuben loe lawk ah caeh, to naah tasi ah patoh ih mandrake thaih to a hnuk moe, amno Leah khaeah sinh pae. Rachel mah Leah khaeah, Na capa mah sin ih tasi thingkung to na paek thoem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe anih mah, Ka sava nang lomh to khawt ai vop maw? Ka capa ih mandrake thaih doeh na lak bae han vop maw? tiah a naa. Rachel mah, Na capa ih mandrake thaih nang paek pongah, Jakob loe vaiduem nang khaeah iip nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Duembang ah Jakob loe lawk hoiah amlaem, anih to Leah mah dawt moe, Kai na iip haih ah, ka capa ih mandrake thaih hoiah nang kang tlai boeh, tiah a naa. To pongah to na qum ah anih khaeah a iih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sithaw mah Leah ih lok to tahngaih pae, anih mah zokpomh let moe, Jakob hanah capa pangato haih sak pae let.
  </para>
  <para style="p">
    <verse number="18" style="v" />To naah Leah mah, Ka tamna nongpata to ka sava hanah ka paek pongah, Sithaw mah kai han tangqum ang paek, tiah thuih; to pongah anih to Issakar, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pacoengah Leah loe zokpomh let, Jakob hanah capa tarukto haih sak pae let.
  </para>
  <para style="p">
    <verse number="20" style="v" />To naah Leah mah, Sithaw mah atho kana tangqum kai han ang paek boeh, ka sava hanah capa tarukto ka sak pae boeh pongah, vaihi loe kai khaeah ni om tih boeh, tiah thuih; to pongah anih to Zebulun, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah canu maeto sak moe, anih to Dinah, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="22" style="v" />To naah Sithaw mah Rachel to poek, Sithaw mah anih ih lok tahngaih pae moe, anih ih caa im to paongh pae.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih loe zokpomh moe, capa maeto sak; Sithaw mah patoekhaih ang takhoe pae boeh, tiah a thuih;
  </para>
  <para style="p">
    <verse number="24" style="v" />to pongah anih ih ahmin to Joseph, tiah sak; Angraeng mah kalah capa na paek let nasoe, tiah a thuih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rachel mah Joseph tapen pacoengah loe, Jakob mah Laban khaeah, Ka ohhaih ahmuen, ka prae ah, na caehsak lai ah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka zu hoi ka caanawk han tok kang sak pae baktih toengah, nihcae to na paek ah loe, na caehsak lai ah; nazetto maw nang hanah tok kang sak pae, tito na panoek, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe Laban mah anih khaeah, Na mikcuk naakrak ah ka oh nahaeloe, om raeh; nang pongah ni Angraeng mah tahamhoihaih ang paek, tito ka panoek, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />To pacoengah, Na toksakhaih atho thui ah kang paek han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jakob mah anih khaeah, Kawbang maw tok kang sak pae moe, na pacah ih moinawk doeh ka ban thungah kawbang maw pung o, tito na panoek boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kai kang zo ai naah hmuen zetta ni na tawnh, vaihi loe pung parai boeh; kai kang zoh nathuem hoi kamtong Angraeng mah tahamhoihaih ang paek boeh; kaimah ih imthung takoh hanah loe natuek naah maw tok ka sah tih boeh? tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih mah, To tih nahaeloe timaw kang paek han? tiah a naa. Jakob mah, Tidoeh na paek hmah; toe ka koeh baktiah nang sak pae nahaeloe, nang ih tuunawk to kang toep pae poe han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Vaihniah nang tuu pacahhaih ahmuen ah ka caeh moe, aem kaom tuunawk, kamnum hoi kanglung angbaeh tuunawk hoi aem kaom maeh caanawk to ka tapraek han; aem kaom maeh, kamnum hoi kanglung angbaeh tuunawk loe ka toksakhaih atho ah om nasoe.
  </para>
  <para style="p">
    <verse number="33" style="v" />To tiah ni hmabang ah ka toksakhaih atho na hmaa ah phak naah, ka toenghaih mah kai han lok na thui tih; kai taham moinawk thungah aem kaom ai maeh, kamnum hoi kanglung angbaeh ai tuucaanawk om nahaeloe, to maeh hoi tuu loe kai mah paquk, tiah amnoek thai tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Laban mah, Khenah, na thuih ih lok baktiah om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />To na niah anih mah aem kaom maeh, aem kaom maeh amno, kanglung hoi aem kaom maeh, rong kamunm hoi kamling angbaeh tuucaanawk to pahoe boih moe, a caanawk ban ah paek.
  </para>
  <para style="p">
    <verse number="36" style="v" />Angmah ohhaih ahmuen hoi Jakob ohhaih ahmuen loe ni thumto caeh, to ahmuen ah tuunawk to a suek; Jakob loe kanghmat Laban ih tuunawk to toep pae.
  </para>
  <para style="p">
    <verse number="37" style="v" />Toe Jakob loe Poplar thing, almond thing hoi azawn ah kaom kahing thing tanghang to lak moe, a thung ih ngan kanglung to amtuengsak hanah, ahin to a saih.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tuunawk tuinaek han angzoh o naah apa cuuk o pongah, angan kanglung amtueng hanah ahin saih ih thing to tuunawk mah hnuk o thai hanah, tui naekhaih okduk hmaa ah a suek pae.
  </para>
  <para style="p">
    <verse number="39" style="v" />To naah a suek ih thing hmaa ah tuunawk to apaa cuuk o, to pongah caa tapen naah doeh aem kaom ah tacawt boih.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jakob mah tuucaanawk hoi maeh caanawk to ahmuen kalah ah tapraek moe, aem kaom tuu hoi maeh, kamnum hoi kamling angbaeh tuu hoi maehnawk to Laban ih tuu pacahhaih ahmuen bangah angqoisak; to tiah Laban ih tuu hoi angmah ih tuunawk to angbaeh han ai ah a suek.
  </para>
  <para style="p">
    <verse number="41" style="v" />Thacak tuunawk apa cuuk han koeh o naah, ahin saih ih thing taengah apa cuuk o pongah, Jakob mah ahin saih ih thing to tui paekhaih okduk hmaa ah suek pae.
  </para>
  <para style="p">
    <verse number="42" style="v" />Toe tuunawk thazok o naah loe, ahin saih ih thing to suem pae ai; to pongah thazok tuunawk loe Laban ih tuu ah oh moe, thacak tuunawk loe Jakob ih tuu ah oh o.
  </para>
  <para style="p">
    <verse number="43" style="v" />To tiah Jakob loe angraeng parai; tuunawk, maehnawk, tamna nongpa hoi nongpatanawk, kaengkuu hrang hoi laa hrangnawk a tawnh mang.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Laban ih caanawk mah, Pa ih hmuennawk boih Jakob mah lak king pongah, vaihi anih loe hmuenmaenawk hoi angraeng boeh, tiah thuih ih lok to Jakob mah thaih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob mah Laban to khet naah, canghni ih baktiah mikhmai pan ai boeh, tito panoek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng mah Jakob khaeah, Nam pa ohhaih prae hoi nangmah ih acaeng kaminawk khaeah amlaem ah; kai mah kang oh thuih han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pongah Jakob mah tuutoephaih ahmuen ah a zu Rachel hoi Leah to hoih hanah kami to patoeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihnik khaeah, Nam pa ih mikhmai ka khet naah, canghni ih baktiah om ai boeh, tiah ka panoek; toe kam pa ih Sithaw mah ang oh thuih poe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka thacakhaih boih hoiah nam pa ih tok ka sak, tito nang panoek hoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe nam pa mah kai ang ling, ka toksakhaih atho doeh vai hato ang ling; toe kai pacaekthlaek hanah Sithaw mah pakaa pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah, aem kaom tuunawk loe na toksakhaih atho ah om nasoe, tiah a thuih, to naah tuunawk loe aem oh o boih; rong kangdaek tuunawk loe ka toksakhaih atho ah om nasoe, tiah a thuih, to naah doeh tuunawk loe rong kangdaek ah tapen boih.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah Sithaw mah nam pa ih tuunawk to lak moe, kai han ang paek boeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuunawk apa cuukhaih tue phak moe, ka khet naah, tuu taenawk loe aem kaom tuu amnonawk khaeah ni apa cuuk o, tiah amang ah ka hnuk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw ih van kami mah amang ah kai khaeah, Jakob, tiah ang kawk. Kai mah, Haeah ka oh, tiah ka naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah anih mah, Danh tahang ah, Tuu taenawk loe aem kaom, rong kangdaek tuu amnonawk khae khue ah ni apa cuuk o; Laban mah na nuiah sak ih hmuennawk to ka hnuk boih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai loe thlung na thling moe, situi na bawh pacoengah, kai khaeah lokkamhaih na sak ih, Bethel hmuen ih Sithaw ah ka oh; vaihi angthawk ah, hae prae hae caehtaak ah loe, na caeng kaminawk ohhaih prae ah amlaem ah, tiah ang thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To naah Rachel hoi Leah mah anih khaeah, Kam pa im ah kaihnik mah toep han koi qawk hoi taham timaw ka tawn hoi?
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaihnik hae prae kalah kami ah a poek, kaihnik hae zawh khue ai ah, kaihnik han paek tangcae hmuen mataeng doeh ang patoh pae king na ai maw?
  </para>
  <para style="p">
    <verse number="16" style="v" />Pa khae hoi Sithaw mah lak ih hmuennawk boih loe, aicae hoi aimacae caanawk ih hmuen ah ni oh boeh; to pongah vaihi Sithaw mah ang thuih ih baktih toengah sah ah, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah Jakob loe angthawk moe, a caanawk hoi a zu hnik to kaengkuu hrang nuiah angthuengsak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Padan Aram ah oh naah, a hak ih hmuennawk boih, pacah ih moinawk to a hoih boih moe, ampa Issak ohhaih Kanaan prae ah caeh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban loe angmah ih tuu amui aah hanah caeh, to naah Rachel mah sakcop ih ampa imthung ih sithaw krangnawk to paquk pae ving.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jakob mah ka cawnh ving han boeh, tiah thui pae ai, Syria kami Laban to tamquta hoiah a caehtaak.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pongah anih loe a tawnh ih hmuennawk boih hoiah a cawnh; angthawk moe, vapui angkat o pacoengah, Gilead mae bangah a caeh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jakob cawnh ving boeh, tito Laban mah ni thumto naah thaih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angmah ih nawkamyanawk to kawk moe, ni sarihto thung anih to patom o, anih to Gilead maeah kae o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Syria kami Laban ih amang ah Sithaw to amtueng pae; Jakob khaeah kasae doeh kahoih doeh, lokthuih han ai ah acoe ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laban mah nihcae to kae naah, Jakob loe Gilead mae ah kahni im a sak boeh; Laban hoi angmah ih nawkamyanawk doeh Gilead mae ah im to sak o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban mah Jakob khaeah, Tipongah hae tiah na oh loe? Kai hae nang ling moe, ka canu hnik doeh misa mah sumsen hoi pahuem moe, naeh ih kami baktiah, na caeh haih ving loe?
  </para>
  <para style="p">
    <verse number="27" style="v" />Tipongah kai nang ling moe, tamquta hoi na cawnh ving loe? Nang thuih soe nahaeloe, anghoehaih laa to sak moe, cingceng bohhaih, katoeng kruekhaih hoiah kang prawt han bae, tikhoe nang thui ai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tipongah ka caanawk hoi ka canunawk doeh nang moksak ai loe? Amthuhaih hoiah ni hae hmuen hae na sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang han nganbawh kana kang paek thaih; toe cangduem aqum ah nam pa ih Sithaw mah kai khaeah, Kahoih doeh kasae doeh, Jakob khae lokthuih han ai ah acoe ah, tiah ang thuih pongah ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Vaihi loe nam pa im to na poek boeh pongah, na caeh han angaih boeh; tikhoe kai ih sithawnawk to na paquk loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jakob mah Laban khaeah, Na canu hnik hae tha hoi nang lomh ving tih, tiah ka poek moe, ka zit pong ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe nang ih sithaw paqu kami na hnuk nahaeloe, anih to hing hmah nasoe; nang ih hmuen ka lak o moeng nahaeloe, aicae nawkamyanawk hmaa roe ah la ah, tiah a naa. Toe Rachel mah sakcop ih sithawnawk paquk pae ving, tito Jakob mah panoek ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pongah Laban loe Jakob ih kahni im, Leah ih kahni im hoi anih ih tamna nongpata hnik ih kahni imthung ah akunh, toe tidoeh hnu ai; Leah ih kahni imthung hoi tacawt pacoengah, Rachel ih kahni imthung ah akun let.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rachel mah ampa imthung ih sithawnawk to lak moe, kaengkuu khrang khukhaih kahni thungah pacaeng, to pacoengah a nuiah anghnut thuih khoep. Laban loe kahni imthung ih hmuennawk to pakrong boih, toe tidoeh hnu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Rachel mah ampa khaeah, Ka angraeng, na hmaa ah kangdoe thai ai pongah palungphuisak hmah; athii ka hnuk pongah ni, tiah a naa. Anih loe sakcop ih krangnawk to pakrong, toe hnu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />To naah Jakob loe palungphui moe, Laban to zoeh; tih sakpazaehaih maw ka tawnh? Tih zaehaih maw ka sak moe, nang patom? tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kai ih hmuennawk to na pakrong boih boeh; na imthung ih hmuen timaw na hnuk? Nam nawk amyanawk hoi kai ih kaminawk hmaa ah suem ah, mi maw katoeng, tito nihcae mah aihnik salakah lokcaek nasoe.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nang khaeah saning pumphaeto ka oh; nang ih tuunawk hoi maehnawk a caa zun o vai ai; nang ih tuu tae maeto mataeng doeh ka caa vai ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nang ih tuunawk to moisannawk mah kaek vai ai; kanghmaa tuu to kai mah ka rong; khoving ah maw, khodai ah maw, tuunawk anghmat naah kai khaeah atho nang suk.
  </para>
  <para style="p">
    <verse number="40" style="v" />To tiah kho ka sak; khodai ah ni kabae mah ang dawk moe, khoving ah kangqai mah ang koep; iih boep ai ah to tiah kho ka sak.
  </para>
  <para style="p">
    <verse number="41" style="v" />To tiah na im ah saning pumphaeto thung ka oh; na canu hnik hanah saning hatlai palito thung tok kang sak pae moe, saning tarukto thung na pacah ih moinawk to kang toep pae, ka toksakhaih atho vai hato nang ling.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kai khaeah kam pa ih Sithaw, Abraham ih Sithaw, Issak mah zit ih Sithaw om ai nahaeloe, bangkrai ah ni nang patoeh tangtang tih; toe Sithaw mah patangkhanghaih hoi ka ban mah sak ih tok to ang hnuk pae pongah ni, cangduem qum ah nang to ang thuitaek, tiah a naa.
  </para>
  <para style="p">
    <verse number="43" style="v" />Laban mah Jakob khaeah, Hae nongpata hnik loe ka canu ni; hae nawktanawk doeh ka caa ni, hae ih moinawk doeh kai ih ni; na hnuk ih hmuennawk boih doeh kai ih ni; toe vaihniah ka canu hnik hoi nihnik mah sak hoi ih caanawk doeh kawbang maw ka naa thai tih boeh?
  </para>
  <para style="p">
    <verse number="44" style="v" />To pongah vaihi angzo ah loe, nang hoi kai salakah lokmaihaih to sah si; to lokmaihaih loe nang hoi kai salakah hnukung ah om nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="45" style="v" />To pongah Jakob mah thlung to lak moe, tung ah a thling.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jakob mah angmah ih nawkamyanawk khaeah, Thlung to a laksak; nihcae mah thlung to sinh pae o moe, pakhueng o pacoengah, pakhueng ih thlung nuiah buh a caak o.
  </para>
  <para style="p">
    <verse number="47" style="v" />To a hmuen to Laban mah Jegar Sahadutha, tiah ahmin paek; toe Jakob mah loe Galeed, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="48" style="v" />Laban mah, Vaihniah haeah pakhueng ih thlung loe nang hoi kai hnukung ah oh boeh, tiah a naa. To pongah to ahmuen to Galeed, tiah kawk o.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aihnik loe maeto hoi maeto kangthla ah oh hoi naah doeh, Sithaw mah toep poe nasoe, tiah a thuih pongah, Mizpah, tiah doeh kawk o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Nang mah ka canu hnik hae pacaekthlaek maw, to ai boeh loe ka canu hnik nuiah zu kalah na lak tak ving cadoeh, mi mah doeh aicae hae hnu ai; toe Sithaw loe aihnik salakah hnukung ah oh, tito pahnet hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="51" style="v" />To pacoengah Laban mah Jakob khaeah, Khenah, kai hoi nang salakah sak ih, haeah pakhueng ih thlung hoi tung ah thling ih thlung hae oh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Haeah tapop ih thlung loe hnukung ah oh moe, haeah thling ih thlung doeh hnukung ah oh; nang nganbawh kana paek hanah, haeah tapop ih thlung hae ka poeng mak ai; nangmah doeh kai nganbawh kana paek hanah, haeah tapop ih thlung hae poeng hmah.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham Sithaw, Nahor Sithaw, nihnik ampa ih Sithaw mah aihnik salakah lok takroek nasoe, tiah a naa. To pongah Jakob loe ampa Issak mah zit ih Sithaw ih ahmin hoiah lokmaihaih to a sak.
  </para>
  <para style="p">
    <verse number="54" style="v" />Jakob loe to ih mae nuiah angbawnhaih to sak moe, buhcaak hanah angmah ih nawkamyanawk to kawk; nihcae loe buhcaak o moe, mae nuiah aqum puek oh o.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob loe caehhaih loklam ah caeh poe, to naah Sithaw ih van kaminawk mah anih to tongh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob mah nihcae to hnuk naah, Hae loe Sithaw ih misatuh kaminawk ni, tiah thuih; to pongah to ahmuen to Mahanaim, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jakob mah Edom prae, Seir hmuen ah, amya Esau khaeah laicaehnawk to hmaloe ah patoeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anih mah nihcae khaeah, Ka angraeng Esau khaeah, Na tamna Jakob mah, Kai loe Laban khaeah ka caeh moe, vaihi doeh to ah ka oh vop;
  </para>
  <para style="p">
    <verse number="5" style="v" />maitawnawk, laa hrangnawk, tuunawk, tamna nongpa hoi nongpatanawk doeh ka tawnh; na mikcuk naakrak ah ka oh hanah, vaihi ka angraeng khaeah lokthuih hanah ang patoeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Laicaehnawk loe Jakob khaeah amlaem o let, anih khaeah, Nam ya Esau khaeah ka caeh o, vaihi nang hnuk hanah kami cumvai palito angzoh haih, tiah a thuih pae o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob loe paroeai zit moe, tasoeh pongah, angmah khae kaom kaminawk, tuunawk, maitawnawk hoi kaengkuu hrangnawk to, abu hnetto ah tapraek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau mah abu maeto tuh nahaeloe, kalah abu maeto loih nasoe, tiah a poek pongah to tiah a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah Jakob mah, Aw, kam pa Abraham ih Sithaw, kam pa Issak ih Sithaw, Na prae hoi nangmah acaeng kaminawk khaeah amlaem ah, nang hae kang lensak han, tiah kai khaeah lokthuikung, Angraeng,
  </para>
  <para style="p">
    <verse number="10" style="v" />na tamna khaeah nam tuengsak ih na tahmenhaih hoi oepthohhaih tetta mataeng doeh hnuk han kam cuk ai; hae Jordan vapui kang kaat naah, cunghet khue ni ka tawnh; toe vaihi loe abu hnetto ah ka oh boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kam ya ih ban, kam ya Esau ih ban thung hoi nang pahlong hanah, lawk kang thuih; anih loe kaimah hoi ka zu, ka caanawk hum hanah angzo tih, tiah zithaih ka tawnh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe nangmah ni kai khaeah, Nang hae kang lensak moe, kroek laek ai ah kaom, tuipui taeng ih savuet zetto, na caanawk kang pungsak han, tiah nang thuih, tiah lawk a thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih loe aqum puek to ahmuen ah iih; a tawnh ih hmuennawk thung hoiah amya Esau to tangqum paek hanah,
  </para>
  <para style="p">
    <verse number="14" style="v" />maeh amno cumvai hnetto, maeh tae pumphaeto, tuu tala cumvai hnetto, tuu tae pumphaeto,
  </para>
  <para style="p">
    <verse number="15" style="v" />kaengkuu hrang amno qui thumto hoi a caanawk, maitaw tala qui palito hoi maitaw tae hato, laa hrang tala pumphaeto hoi a caa hato a qoih.
  </para>
  <para style="p">
    <verse number="16" style="v" />To moinawk to a tamnanawk ban ah paek moe, abu tapraek pacoengah, Ka hmaa ah caeh oh, abu maeto hoi maeto salak kangthla ah caeh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nihcae thungah hmaloe koeh caeh kami khaeah, Kam ya Esau mah nang to hnuk naah, nang loe mi aa? Naa ah maw na caeh han? Na hmaa ih moinawk loe mi ih aa? tiah na dueng nahaeloe,
  </para>
  <para style="p">
    <verse number="18" style="v" />to moinawk loe na tamna Jakob ih ni; ka angraeng Esau paek han ih tangqum ni, khenah, anih loe hnukah angzoh, tiah thuih paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />To tiah anih hnukah angzo abu hnetto hoi abu thumto kaminawk khaeah doeh, Esau na hnuk o nahaeloe, to tiah thui oh, tiah lok a paek.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pacoengah na tamna loe kaicae hnukah angzoh, tiah thui oh, tiah a naa. Hmaloe koek caeh kami mah paek ih tangqumnawk hoiah mikhmai ka sak han; to tiah nahaeloe anih hoi kang qum naah na talawk pae khoe doeh om tih, tiah a poek.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pongah Jakob ih tangqumnawk to hmaloe ah caeh o haih; toe to na aqum ah, anih loe kaminawk ataihaih ahmuen ah ni a oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />To na aqum ah Jakob loe angthawk moe, a zu hnik, a tamna nongpata hnik hoi a caa hatlaito caeh haih moe, Jabbok vapui ih tui amdaehaih ahmuen ah angkaat haih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nihcae vapui zaeh ah thak pacoengah, a tawnh ih hmuennawk doeh a thaksak boih.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pongah Jakob loe angmabueng oh sut; to naah anih loe kami maeto hoiah khodai ai karoek to angpanh.
  </para>
  <para style="p">
    <verse number="25" style="v" />To kami mah anih to pazawk mak ai, tiah panoek naah, Jakob ih phaih to boh pae tuek; to tiah angpan hoi li naah Jakob ih phaih huh amkhraeng pae ving.
  </para>
  <para style="p">
    <verse number="26" style="v" />To kami mah, Na prawt lai ah, khodai tom boeh, tiah a naa. Toe Jakob mah, Tahamhoihaih nang paek ai nahaeloe, kang prawt mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To kami mah, Na hmin loe mi aa? tiah a naa. Anih mah, Jakob, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah to kami mah, Nang loe Sithaw hoi anih ih kaminawk hoiah nang panh moe, na pazawk boeh pongah, na hmin to Jakob, tiah kawk mak ai boeh; Israel, tiah ni kawk tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jakob mah, Na hmin loe mi aa? Tahmenhaih hoiah na thui ah, tiah a naa. Toe anih mah, Tih hanah ka hmin nang dueng loe? tiah a naa. To pacoengah anih mah to ahmuen ah Jakob hanah tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jakob mah mikhmai kangtong ah Sithaw to ka hnuk boeh, toe anih mah ka hinghaih ang pathlung, tiah a poek pongah, to ahmuen to Jakob mah Peniel, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Penuel to poeng pacoeng loe khodai boeh; to naah Jakob loe khok kangbai baktiah lam caeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anih mah Jakob ih phaih thaqui to atumh pae tuek pongah, vaihni ni khoek to Israel caanawk mah phaih thaqui taeng ih angan to caa o ai.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob mah khet tahang naah, kami cumvai palito hoi nanwto angzo Esau to hnuk. To pongah nawktanawk to tapraek moe, Leah, Rachel hoi a tamna nongpata hnik khaeah a paek.
  </para>
  <para style="p">
    <verse number="2" style="v" />A tamna nongpata hnik hoi a caanawk to hmaloe ah a caehsak, to pacoengah Leah hoi a caanawk to caehsak moe, hnukkhuem koekah Rachel hoi Joseph to caehsak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angmah to hmahmanh moe, amya khaeah a phak naah, a hmaa ah long ah vai sarihto akuep pae.
  </para>
  <para style="p">
    <verse number="4" style="v" />Esau loe Jakob hnuk hanah cawnh moe takop; tahnong ah takoih moe, anih to mok; to pacoengah loe qah hoi hmaek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Esau mah khet naah, nongpatanawk hoi a caanawk to hnuk; nang hoi nawnto kaom kaminawk loe mi aa? tiah a naa. Jakob mah, Nihcae loe Sithaw mah na tamna khaeah tahmenhaih hoi paek ih kaminawk ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah a tamna hnik hoi a caanawk to angzoh o moe, anih hmaa ah akuep o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah Leah hoi a caanawk doeh anih khaeah angzoh o moe, akuep o; hnukkhuem koekah Rachel hoi Joseph to angzoh hoi moe, a hmaa ah akuep hoi toeng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esua mah, Ka hnuk ih moinawk loe tih sak han ih aa? tiah a naa. Anih mah, Ka angraeng, na tahmenhaih ka hnuk thai hanah, nang hanah kang sinh pae, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe Esau mah, Kam nawk, Kai doeh ka tawnh mang bae, nangmah hanah mah suem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob mah, Tahmenhaih hoiah na talawk paeh; na tahmenhaih ka tongh nahaeloe, ka sinh ih tangqum hae na talawk pae ah; na mikhmai ka hnuk hae, Sithaw mikhmai hnuk baktiah ni oh, na mikhmai panhaih to ka hnuk boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang han kang sinh ih taham ka hoihaih tangqumnawk hae na talawk pae ah, Sithaw mah ang tahmen pongah, ka ngaihaih boih ka tawnh boeh, tiah a naa. Jakob mah paek pae khruek pongah, Esau mah talawk pae.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah Esau mah, Caeh o si, kholong caeh amsak o si boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe Jakob mah, Ka angraeng, nawktanawk loe saning nawk o vop moe, tapen kangtha tuu hoi maitawnawk doeh ka khetzawn han oh, tito na panoek; nito thung karangah ka caeh haih nahaeloe, moinawk hae dueh o boih tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah ka angraeng nang loe, na tamna hmaa ah caeh halat ah; kai loe moinawk to amzai ah huih moe, nawktanawk hoi nawnto ka angraeng ohhaih Seir mae ah amzaita hoi kang zoh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esau mah, To tih nahaeloe kaimah ih kaminawk ahap kang caehtaak han, tiah a naa. Toe Jakob mah, Na koehhaih baktiah ka oh nahaeloe, tih han ih nihcae to caehtaak han angai tih loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah to na niah Esau loe Seir prae ah amlaem let.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe Jakob loe Sukkoth ah caeh, ohhaih ahmuen maeto a sak, angmah ih maitawnawk ohhaih im doeh a sak pae; to pongah to ahmuen to Sukkoth, tiah ahmin paek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob loe Padan prae hoiah angzoh moe, Kanaan prae Shekem vangpui to kamong ah a phak, to vangpui phak tom naah ataihaih ahmuen to a sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shekem ampa Hamor caanawk khae ih long to, phoisa cumvaito hoiah a qanh moe, to ahmuen ah ataihaih kahni im to a sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />To ahmuen ah hmaicam maeto a sak pacoengah, El-Elohe-Israel, tiah ahmin sak.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leah mah Jakob han sak pae ih canu Dinah loe to prae thung ih nongpatanawk khaeah paqaih hanah caeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />To prae ukkung, Hiv acaeng Hanor capa, Shekem mah anih to hnuk naah, anih to naeh moe, iih haih pacoengah amhnongsak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih loe poekhaih palungthin boih Jakob canu Dinah hanah paek, nongpata to a palung khruek pongah, lok kanaem ta hoiah anih to paroi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shekem mah ampa Hamor khaeah, Hae nongpata hae ka zu ah na la pae ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />A canu Dinah to Shekem mah iih haih boeh, tito Jakob mah thaih, a caanawk loe lawk ah maitaw toep o; Jakob loe nihcae angzo ai karoek to lok apae ai ah anghngai duem.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Shekem ampa Hamor loe lokthuih hanah, Jakob khaeah caeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob ih caanawk mah to tamthang to thaih o naah, im ah amlaem o roep; Shekem loe Israel kaminawk salakah kahoih ai hmuen hoi sak koi ai hmuen ah kaom, Jakob ih canu Dinah to iih haih moeng boeh pongah, nihcae loe palungnat khue khawt ai ah, palung a phui o parai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe Hamor mah nihcae khaeah, Ka capa Shekem mah na canu hae palung khruek boeh; anih han zu ah na paek halat ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaicae hoi zu sava ah om si, na canunawk to na paek oh loe, nangcae doeh kaicae tanuh hae la o toeng ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaicae khaeah khosah oh, hae prae hae nangcae han kang paongh pae; a thungah khosah oh loe, hmuenmaenawk doeh zaw oh; a thung ih hmuennawk to toep oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah Shekem mah Dinah ih ampa hoi nawkamyanawk khaeah, Hae hmuen pongah na tahmen o raeh, nang hnik o ih hmuen boih kang paek han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Avang hoi tangqum loe nazetto doeh pop nasoe, nang hnik o zetto kang paek han hmang, nongpata hae mah ka zu ah na paek oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah nihcae ih tanuh Dinah to zae haih boeh pongah, Jakob ih caanawk mah Shekem hoi ampa Hamor to aling o;
  </para>
  <para style="p">
    <verse number="14" style="v" />nihcae mah nihnik khaeah, Tangzat hin aat ai kaminawk khaeah, to baktih hmuen to ka sah o thai mak ai; to baktih hmuen loe kaicae han azat kathok hmuen ah ni oh;
  </para>
  <para style="p">
    <verse number="15" style="v" />toe kaicae baktih toengah, nangcae thung ih nongpa boih tangzat hin na aah o nahaeloe, na thuih ih lok to kang tapom pae o han;
  </para>
  <para style="p">
    <verse number="16" style="v" />to pacoengah ni kaicae ih canunawk to kang paek o moe, nangcae ih canunawk doeh ka la o toeng tih; nangcae hoi nawnto ka om o ueloe, acaeng maeto ah om tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe kang thuih o ih baktih toengah, tangzat hin aah han na koeh o ai nahaeloe, ka canu to ka lak o moe, ka caeh o han boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="18" style="v" />To tiah a thuih o ih lok to Hamor hoi a capa Shekem mah palung due hoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />To thendoeng loe ampa imthung ah khingya o koek ih thendoeng ah oh moe, Jakob ih canu to koeh khruek pongah, nihcae mah thuih ih lok to aek ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />To naah Hamor hoi a capa Shekem loe to vangpui khongkha taengah caeh hoi moe, angmacae vangpui thung ih kaminawk khaeah lok a thuih pae hoi,
  </para>
  <para style="p">
    <verse number="21" style="v" />nihnik mah, Hae kaminawk loe angdaeh koeh kami ah oh o; aicae prae ah omsak si loe, hmuenmaenawk doeh zawsak si; khenah, nihcae han kakhawt kalen parai ahmuen doeh oh; nihcae ih canunawk to la o si loe, aicae ih canunawk doeh nihcae han paek si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe nihcae loe tangzat aat kami ah oh o pongah, aicae doeh nihcae baktiah tangzat hin aah o naah ni, nihcae loe nangcae hoi nawnto om o thai tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nihcae ih maitawnawk, nihcae ih hmuennawk hoi moinawk loe aicae ih hmuen ah om mak ai, tiah na poek o maw? To pongah aicae mah nihcae ih lok to paroi o halat si, to tiah ni nihcae loe aicae hoi nawnto om o tih, tiah a thuih pae hoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anih ih vangpui khongkha ah kacaeh kaminawk boih mah Hamor hoi a capa Shekem ih lok to paroi o; to pongah anih ih vangpui thungah kaom nongpanawk loe tangzat hin to aah o boih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aahhaih ahmaa nat li haih, ni thumto naah Jakob ih caa, Dinah ih thangqoi Simeon hoi Levi loe angmah hnik ih sumsen to lak hoi moe, misahoihaih hoiah vangpui to muk hoi pacoengah nongpanawk to hum hoi boih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hamor hoi a capa Shekem to sumsen hoi a hum hoi moe, Shekem imthung ih Dinah to a lak hoi pacoengah, tacawt hoi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae mah a tanuh to zae o haih pongah, Jakob ih caanawk loe kadueh kaminawk khaeah caeh o moe, vangpui to phraek o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tuunawk, maitawnawk, la hrangnawk, vangpui thung kaom hmuennawk hoi lawk ah kaom hmuennawk to a lak o,
  </para>
  <para style="p">
    <verse number="29" style="v" />nihcae ih hmuennawk, nihcae ih nawktanawk hoi zunawk to naeh o boih moe, im ah kaom hmuennawk to paro pae o boih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jakob mah Simeon hoi Levi khaeah, Raihaih nang paek hoi boeh, Kanaan kaminawk hoi Periz kaminawk, hae prae ah kaom kaminawk khaeah panuet thok ah nang sak hoi boeh; aicae loe kami zetta, nihcae loe kai tuk hanah amkhueng o tih, kai na hum o ueloe, kaimah hoi ka imthung takoh doeh hum o boih tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toe nihnik mah, Anih mah ka tanuh tangzat zaw kami baktiah sak han oh maw? tiah a naa hoi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Sithaw mah Jakob khaeah, Angthawk ah, Bethel ah caeh tahang ah loe, to ah om ah; nam ya Esau khae hoi na cawnh naah, nang khae kamtueng Sithaw khaeah, hmaicam maeto sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pongah Jakob mah a imthung takoh hoi anih khae kaom kaminawk boih khaeah, Nangcae salak ih prae kalah sithawnawk to va o boih ah, ciimcai oh loe, khukbuen to angkraih oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angthawk oh, Bethel ah caeh o tahang si; raihaih ka tongh na niah ka lok pathimkung hoi ka caehhaih loklam ah kaom thuih Sithaw khaeah, to ih ahmuen ah hmaicam to ka sak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pongah nihcae ban ah kaom kalah sithawnawk boih, nihcae naa pong ih naa tangkraengnawk to Jakob khaeah paek o boih; to hmuennawk to Jakob mah Shekem ih oak thing tlim ah a phum pae.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pacoengah a caeh o; nihcae taeng ih vangpuinawk thungah kaom kaminawk nuiah Sithaw zithaih to phak pongah, mi mah doeh nihcae to patom thai ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jakob hoi angmah ih kaminawk loe Kanaan prae thung ih Luz (Bethel thuihhaih ih ni) vangpui ah phak o boih.
  </para>
  <para style="p">
    <verse number="7" style="v" />To ahmuen ah hmaicam maeto a sak, amya khae hoi cawnh naah to ahmuen ah Sithaw mah angphong thuih pongah, to ahmuen to El Bethel, tiah kawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />To naah Rebekah khenzawnkung, Deborah loe duek moe, Bethel ih oak thingkung tlim ah a phum o; to pongah to ahmuen to Allon Bakuth, tiah kawk.
  </para>
  <para style="p">
    <verse number="9" style="v" />Padan Aram hoi Jakob angzoh naah, anih khaeah Sithaw angphong pae let moe, anih to tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw mah anih khaeah, Na hmin loe Jakob; toe na hmin to Jakob, tiah kawk mak ai boeh, Israel, tiah ahmin om tih boeh, tiah a naa. To pongah anih ih ahmin to Israel, tiah kawk o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw mah anih khaeah, Kai loe Thacak Sithaw ah ka oh; thingthai athai oh loe, pung oh; nang khae hoiah prae maeto hoi acaeng maeto ah om ueloe, nang khae hoiah ni siangpahrangnawk to tacawt o tih;
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham hoi Issak khaeah ka paek ih prae to kang paek moe, na caanawk khaeah doeh ka paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pacoengah anih hoi lokthuihaih ahmuen hoiah Sithaw mah anih to caehtaak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jakob mah Sithaw hoi lokpaehhaih ahmuen ah thlung maeto thling moe, a nuiah naek koi hmuen to a bawh pacoengah, situi doeh a bawh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jakob mah Sithaw hoi lokpaehhaih ahmuen to, Bethel, tiah kawk.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah Bethel hoiah ahmuen kalah bangah angpuen o; Ephrath ahmuen hoi kangthla kue ahmuen ah oh o naah, Rachel caa tapenhaih tue to phak, caa tapen han rai parai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Caa om thai ai naah, nawkta omsakkung mah, anih khaeah, Zii hmah; capa maeto na sah let tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hinghaih qui apet tom moe, (duek han oh sut naah) a capa to Ben-Oni, tiah ahmin sak; toe ampa mah loe anih to Benjamin, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rachel loe duek moe, anih to Ephrath (Bethlehem) caehhaih loklam ah aphum o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anih aphumhaih taprong nuiah Jakob mah thlung maeto thling; to thlung loe vaihni ni khoek to Rachel ih taprong nuiah thling ih thlung ah oh poe.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel loe to ahmuen hoiah caeh moe, Eder imsang to poeng pacoengah kahni im to sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israel loe to prae ah oh naah, Reuben mah ampa ih zula Billah to iih haih, tiah Israel mah thaih. Jakob loe capa hatlai hnetto tawnh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leah ih caanawk loe, Jakob ih calu Reuben, Simeon, Levi, Judah, Issakar hoi Zebulun.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rachel ih caanawk loe, Joseph hoi Benjamin;
  </para>
  <para style="p">
    <verse number="25" style="v" />Rachel ih tamna Billah ih caanawk loe, Dan hoi Nephtali;
  </para>
  <para style="p">
    <verse number="26" style="v" />Leah ih tamna Zilpah ih caanawk loe, Gad hoi Asher. Hae kaminawk loe Padan Aram ah oh o naah sak ih Jakob ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jakob loe Hebron, tiah kawk ih Arba vangpui, Abraham hoi Issak ohhaih Mamre ahmuen ah caeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Issak loe saning cumvai, qui tazetto hing.
  </para>
  <para style="p">
    <verse number="29" style="v" />Issak loe saning coeh moe, mitong naah duek; anih loe anghahhaih takhi to boeng pacoengah angmah ih kaminawk khaeah nawnto oh; a capa Esau hoi Jakob mah anih to aphum hoi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Edom tiah kawk ih Esau ih caanawk kawng loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esau loe Kanaan tanuhnawk to zu ah lak moe, Hit acaeng Elon canu Adah, Hiv acaeng Zibeon ih canu patoeng, Anah ih canu Aholibamah doeh zu ah lak;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ishmael canu, Nebajoth ih tanuh, Bashemath doeh zu ah a lak bae vop.
  </para>
  <para style="p">
    <verse number="4" style="v" />Adah mah Esau hanah Eliphaz to sak pae moe, Bashemath mah Reuel to sak pae;
  </para>
  <para style="p">
    <verse number="5" style="v" />Aholibamah mah Jeush, Jaalam hoi Korah to sak; hae kaminawk loe Kanaan prae ah sak ih, Esau ih capa ah oh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Esau loe a zunawk, a capanawk hoi a canunawk, a imthung ah kaom kaminawk boih, angmah ih maitawnawk boih, moinawk boih hoi Kanaan prae ah hnuk ih hmuennawk to sinh boih moe, amnawk Jakob hoi angthla kuehaih ahmuen ah angpuen.
  </para>
  <para style="p">
    <verse number="7" style="v" />A tawnh ih hmuennawk loe pop hmoek boeh pongah, ahmuen maeto ah nawnto oh hmaek han angcoeng ai boeh; nihnik ohhaih ahmuen loe a tawnh hoi ih moinawk pacah han khawt ai boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah Edom tiah kawk ih Esau loe Seir mae ah khosak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Seir mae ah kaom Edom kaminawk ih ampa ah kaom, Esau ih caanawk loe hae tiah oh;
  </para>
  <para style="p">
    <verse number="10" style="v" />Esau caanawk ih ahmin loe, Eliphaz, anih loe Esau ih zu Adah capa ah oh moe, Reuel loe Esau ih zu Bashemath ih capa ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Eliphaz ih caanawk loe, Teman, Omar, Zepho, Gatam hoi Kenaz.
  </para>
  <para style="p">
    <verse number="12" style="v" />Esau capa Eliphaz mah Timna to zula ah lak let, anih mah Amalek to sak pae; hae kaminawk loe Esau ih zu Adah mah sak ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Reuel ih caanawk loe Nahath, Zerah, Shammah hoi Mizzah; hae kaminawk loe Esau zu Bashemath ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zibeon ih canu Anah, Anah ih canu hoi Esau ih zu, Aholibamah mah Esau han sak pae ih caanawk loe Jeush, Jaalam hoi Korah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esau ih caanawk thungah angraeng acaeng ah kaom kaminawk loe, Esau ih calu Eliphaz ih caanawk thung hoiah Teman, Omar, Zepho hoi Kenaz,
  </para>
  <para style="p">
    <verse number="16" style="v" />Korah, Gatam hoi Amalek; hae kaminawk loe Edom prae thungah Eliphaz mah sak ih caa ah oh o moe, Adah ih caa patoeng ah oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Esau capa Reuel ih caanawk loe Nahath, Zerah, Shammah hoi Mizzah; hae kaminawk loe Edom prae thungah Reuel mah sak ih caa ah oh o moe, Esau ih zu Bashemath ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Esau zu Aholibamah ih capanawk loe Jeush, Jaalam hoi Korah; hae kaminawk loe Anah canu, Esau zu Aholibamah ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hae kaminawk loe Edom, tiah kawk ih Esau ih caa ah oh o moe, angmacae zaehoikung lu koek ah ah oh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hae kaminawk loe Hor acaeng Seir ih caa ah oh o; to prae thung ah kaom kaminawk loe Lotan, Shobal, Zibeon, Anah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Dishon, Ezer hoi Dishan; hae kaminawk loe Edom prae thungah kaom, Hor caphung thungah, angraeng acaeng ah kaom Seir ih capa ah oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lotan capanawk loe, Hori hoi Hemam; Timna loe Lotan ih tanuh ah oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shobal capanawk loe Alvan, Manahath, Ebal, Shepho hoi Onam.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zibeon ih caanawk loe Ajah hoi Anah; hae Anah loe praezaek ah ampa Zibeon ih laa hrangnawk to toep pae naah, kabae tuipuek hnukung ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anah ih caanawk loe Dishon hoi Aholibamah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dishon ih caanawk loe Hemdan, Eshban, Ithran hoi Keran.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezer ih caanawk loe Bilhan, Zaavan hoi Akan.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishan ih caanawk loe Uz hoi Aran.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hor acaeng thung ih zaehoikung lu koek loe Lotan, Shobal, Zibeon, Anah,
  </para>
  <para style="p">
    <verse number="30" style="v" />Dishon, Ezer hoi Dishan; hae kaminawk loe ukkung angraeng, Hor ih acaeng ah oh o moe, Seir prae thungah ukkung angraeng ah oh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hae kaminawk loe Israel ukkung siangpahrang om ai naah, Edom prae thungah siangpahrang ah oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beor capa Bela loe Edom siangpahrang ah oh; anih ih vangpui ahmin loe Dinhabah.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bela duek pacoengah, anih zuengah Bozrah ah kaom, Zerah capa Jobab to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jobab duek pacoengah, anih zuengah Temani prae ih Husham to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Husham duek pacoengah, anih zuengah Moab prae thungah Midian kaminawk pazawkkung, Bedad capa Hadad to siangpahrang ah oh; anih ih vangpui ahmin loe Avith.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hadad duek pacoengah, anih zuengah Masrekah ih Samlah to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Samlah duek pacoengah, anih zuengah vapui taengah kaom, Rehoboth ih Shaul to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shaul duek pacoengah, anih zuengah Akhor capa Baalhanan to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akhor capa Baalhanan duek pacoengah, anih zuengah Hadar to siangpahrang ah oh; anih ih vangpui ahmin loe Pau; anih ih zu hmin loe Mehezahab canu Matred, Matred ih canu Mehetabel.
  </para>
  <para style="p">
    <verse number="40" style="v" />Esau hoi anghum tathuk angraeng acaengnawk loe, angmacae imthung takoh, angmacae ohhaih ahmuen baktiah paek ih ahminawk loe Timnah, Alvah, Jetheth,
  </para>
  <para style="p">
    <verse number="41" style="v" />Aholibamah, Elah, Pinon,
  </para>
  <para style="p">
    <verse number="42" style="v" />Kenaz, Teman, Mibzar,
  </para>
  <para style="p">
    <verse number="43" style="v" />Magdiel hoi Iram cae hae ni; hae kaminawk loe angmacae ohhaih ahmuen baktih toengah Edom ukkung angraeng acaeng ah oh o; Esau loe Edom kaminawk ih ampa ah oh.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob loe ampa angvin ah ohhaih, Kanaan prae ah khosak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob anghumhaih kawng loe hae tiah oh; Joseph loe amyanawk hoi nawnto tuu toep naah, saning hatlai sarihto oh boeh; thendoeng loe Jakob ih zu, Billah hoi Zilpah ih caanawk hoi nawnto ah oh, nihcae sethaih kawng to anih mah ampa khaeah thuih pae.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel loe mitong lam ah capa Joseph to sak pongah, anih to kalah amyanawk pongah palung kue; to pongah anih hanah rong congca kaom laihaw to a sak pae.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ampa loe kalah nawkamyanawk pongah Joseph to palung kue, tiah amyanawk mah panoek o naah, anih to hnukma o moe, lunghoih ta hoiah lok tapring o vai ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Joseph mah amang to sak, anih mah to amang to amyanawk khaeah thuih pae, to naah nihcae mah anih to hnukma o aep.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amyanawk khaeah, Ka mang hae tahngai oh;
  </para>
  <para style="p">
    <verse number="7" style="v" />khenah, Aicae loe lawk ah cangqui taoengh o, to naah kai ih cangqui loe angthawk moe, angdoet tahang; toe nangcae ih cangqui loe kangkui ah angdoet o moe, kai ih cangqui to bok o, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amyanawk mah anih khaeah, Kaicae ukkung ah oh han na poek maw? To tiah kaicae nang uk thai tang tih maw? tiah a naa o. A hnuk ih amang hoi a thuih ih lok pongah, nihcae mah anih to hnukma o aep.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pacoengah anih mah amang to sak let, to amang to amyanawk khaeah a thuih pae let; Tahngai oh, kalah amang ka sak let bae vop; khenah, ka mangah, ni, khrah hoi cakaeh hatlaito mah kai to bok o, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ampa hoi amyanawk khaeah a thuih pae naah, ampa mah anih khaeah, Tikhoe to baktih amang to na sak khruek loe? tiah a thuitaek. Na hmaa ah ka kuep o hanah, kai, nam no hoi nam nawk amyanawk, nang khaeah kang zoh o tih maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amyanawk mah anih to ut o; toe ampa mah loe a thuih ih lok to palung thungah pakuem poe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amyanawk loe Shekem vangpui ah ampa ih tuu rawkcak pacah hanah caeh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah Israel mah Joseph khaeah, Nam yanawk loe Shekem vangpui ah tuu rawkcak pacah o; angzo ah, nihcae khaeah kang patoeh han, tiah a naa. Anih mah, Haeah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah anih khaeah, Caeh ah loe, nam yanawk hoi tuunawk ngantui o vai, khen noek ah, to pacoengah tamthang na thui let ah, tiah a naa. Hebron azawn hoiah Joseph to patoeh pongah, Shekem ah a caeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih taw ah amhet khing naah, lawk caeh kami maeto mah anih to hnuk, Timaw na pakrong loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih mah, Kam yanawk to ka pakrong, naa ah maw tuu a toep o, na thui ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To kami mah, Nihcae loe hae ahmuen hoiah kalah ahmuen bangah caeh o ving boeh; Dothan ah caeh o si, tiah thuih o ih lok to ka thaih, tiah a naa. To pongah Joseph loe amyanawk khaeah caeh, nihcae to Dothan ah a hnuk.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih to kangthla hoiah a hnuk o, nihcae khae pha ai naah, anih hum hanah pacaeng o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae mah, Amang sah kami to angzoh boeh, tiah maeto hoi maeto lok ang thuih o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angzo oh, anih to hum o si, tangqom khaw maeto thungah va si loe, anih loe moisan mah kaek boeh, tiah thui si. To naah anih ih amang kawbang maw oh, tito khen o si, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben mah to lok to thaih naah, anih to hum o hmah si, tiah a naa moe, Joseph to nihcae ban thung hoiah a lak ving.
  </para>
  <para style="p">
    <verse number="22" style="v" />Reuben mah nihcae khaeah athii palong o hmah; toe anih to hae praezaek ih tuikhaw thungah mah va o sut ah, a nuiah ban phok o hmah, tiah a naa. Reuben mah, nihcae ban thung hoiah ka pahlong moe, kam pa khaeah ka caeh haih let han, tiah a poek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph amyanawk khae phak naah, anih mah angkhuk ih rong congca kaom laihaw to a khringh pae o;
  </para>
  <para style="p">
    <verse number="24" style="v" />anih to naeh o moe, tuikhaw thungah vah o; tuikhaw loe tui kaang boeh moe, tui om ai boeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae loe buhcaak han anghnut o; a danh o tahang moe, a khet o naah, Gilead prae hoiah angzo, kaengkuu hrang pongah hmuihoih hmuen, hmuihoih thing tangpri hoi myrrhnawk kaphaw, Izip prae ah kacaeh Ishmael kaminawk to a hnuk o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah mah amyanawk khaeah, Aimacae ih amnawk to a hum o moe, anih ih athii hawk o khing cadoeh aicae han timaw atho oh?
  </para>
  <para style="p">
    <verse number="27" style="v" />Angzo oh, anih to Ishmael kaminawk khaeah mah zaw si, anih nuiah ban phok o hmah si; anih loe aimacae ih amnawk hoi acaeng ah ni oh, tiah a naa. Anih ih lok to amyanawk mah paroi pae o.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah hmuenzaw Midian kaminawk to angzoh o; amnawk Joseph to tuikhaw thung hoiah a zuh o let moe, anih to Ishmael kaminawk khaeah phoisa shekel pumphaeto hoiah a zawh o; nihcae mah Joseph to Izip prae ah caeh o haih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Reuben loe amlaem let moe, tuikhaw to khet naah Joseph loe om ai boeh; to pongah angmah ih laihaw to asih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amnawknawk khaeah amlaem moe, nawkta loe om ai boeh; kai loe naa ah maw ka caeh han boeh? tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />To naah Joseph ih laihaw to lak o moe, maeh caa maeto a boh o pacoengah, maeh thii thungah laihaw to a nup o;
  </para>
  <para style="p">
    <verse number="32" style="v" />rong congca kaom laihaw to ampa khaeah a sin pae o moe, hae ni ka hnuk o boeh; na caa ih laihaw maw, laihaw ai tito kahoih ah khenah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih mah maat moe, Hae loe ka caa ih laihaw boeh ni! Anih loe moisan mah ni kaek boeh; Joseph loe moisan mah taprawt pet pet boeh hae loe, tiah a thuih.
  </para>
  <para style="p">
    <verse number="34" style="v" />To naah Jokob loe angmah ih khukbuen to angkhring moe, kazii to kaengah angzaeng pacoengah, a capa to ni paroeai thung qah haih.
  </para>
  <para style="p">
    <verse number="35" style="v" />A capanawk hoi a canunawk boih anih pathloep hanah angzoh o; toe pathloep o thai ai; palungset loiah ka capa caehhaih taprong thungah ka caeh han boeh, tiah a thuih. To tiah a capa pongah ampa to qah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Midian kaminawk mah Joseph to, Izip prae ih misatuh angraeng, Faro ih toksahkung angraeng maeto ah kaom, Potiphar khaeah zawh o.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />To naah Judah loe angmah ih nawkamyanawk to caehtaak moe, Adullam acaeng Hirah khaeah caeh tathuk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah mah to ah Kanaan acaeng Shuah canu to hnuk, anih to zu ah lak moe, a iih haih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nongpata loe zokpomh moe, capa maeto sak; anih to Er, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nongpata loe zokpomh let moe, capa maeto sak, anih to Onan, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih loe zokpomh let bae moe, capa maeto sak, anih to Shelah, tiah ahmin sak; to capa loe Kezib vangpui ah oh naah tapen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah mah a calu, Er hanah zu lak pae; anih ih ahmin loe Tamar.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe Judah ih calu Er loe, Angraeng mikhnuk ah kahoih ai kami ah oh; to pongah anih to Angraeng mah dueksak ving.
  </para>
  <para style="p">
    <verse number="8" style="v" />To naah Judah mah Onan khaeah, nam ya ih zu khaeah caeh ah, anih to zu haih ah loe nam ya han caa sah paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih hoi sak ih caa loe angmah ih caa ah om mak ai, tito Onan mah panoek naah, am ya han caa sak pae han koeh ai pongah, amya ih zu khaeah iih naah, angmah ih atii to tasa bangah pathok ving.
  </para>
  <para style="p">
    <verse number="10" style="v" />To tiah sak ih hmuen to Angraeng mah koeh ai; to pongah anih doeh dueksak.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah Judah mah angmah ih langah Tamar khaeah, Ka capa Shelah thendoeng ai karoek to nam pa im ah hmai ah, tiah a naa. Anih doeh amya hnik baktiah dueh moeng tih, tiah a poek. To pongah Tamar loe amlaem moe, ampa im ah a hmaih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nasetto maw oh pacoengah Shuah canu, Judah ih zu to duek; Judah palungsae dip pacoengah loe angmah ih tuu mui aat kaminawk khaeah, Adullam acaeng angmah ih ampui Hirah hoi nawnto Timnah vangpui ah caeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah nam qang loe tuu mui aah hanah Timnah vangpui ah caeh, tiah Tamar khaeah thuih pae o.
  </para>
  <para style="p">
    <verse number="14" style="v" />To naah lamhmai khukbuen to angkhring moe, a mikhmai to khuk khoep, a lu to zaeng pacoengah Timnah vangpui caehhaih loklam ah kaom, Enaim akunhaih khongkha taengah anghnut; Shelah loe thendoeng boeh, toe anih to zusak han koeh ai, tito a langah mah panoek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Judah mah anih to hnuk naah, mikhmai to khuk khoep pongah, tangzat zaw nongpata mue, tiah a poek.
  </para>
  <para style="p">
    <verse number="16" style="v" />(To nongpata loe angmah ih langah ni, tito panoek ai) pongah, anih khaeah loklam taengah caeh moe, Nang khaeah na iipsak ah, tiah a naa. Nongpata mah kai nang iih haih nahaeloe, timaw nang paek han? tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih mah, Maeh caa to kang pat han, tiah a naa. Nongpata mah to tiah nahaeloe to hmuen nang pat ai nathung ah hmuen maeto ka ban ah nang koeng thai tih maw? tiah a naa let.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nongpa mah tih hmuen maw kang koeng han loe? tiah a naa. Nongpata mah, Nangmah ih bantuek, banlakok hoi cunghet, tiah a naa. Anih mah to hmuennawk to nongpata hanah paek pacoengah, anih to a iih haih, to pongah nongpata loe zokpomh.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pacoengah nongpata loe angthawk moe, a caeh, anih mah mikhmai khukhaih kahni to angkhring moe, lamhmai khukbuen to angkhuk let.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judah mah nongpata khaeah suek ih hmuennawk to lak let hanah koeh pongah, angmah ih ampui Adullam acaeng khaeah maeh caa to a pat pae; toe anih mah nongpata to hnu ai boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />To naah to ahmuen ah kaom kaminawk khaeah, Enaim lam taengah kaom tangzat zaw nongpata loe naa ah maw oh? tiah a dueng. Nihcae mah, Haeah tangzat zaw nongpata om ai bae, tiah a naa o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih loe Judah khaeah amlaem let moe, To nongpata to ka hnu ai boeh; to ah kaom kaminawk mah doeh haeah tangzat zaw kami om ai, tiah ang naa o, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="23" style="v" />To naah Judah mah, Khenah, hae maeh caa hae ka pat pae, toe nongpata to na hnu ai boeh pongah, nongpata mah to ih hmuennawk to angmah han la nasoe, to tih ai nahaeloe azat apaw hoi moeng tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khrah thumto oh pacoengah, Na langah Tamar loe tangzat zawh moe, vaihi zokpom boeh, tiah Judah khaeah thuih pae o. Judah mah, Nongpata to angzo o haih loe hmai hoiah qoeng oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih to angzoh o haih naah, Tamar mah amqang khaeah angmah ih bantuek, banlakok hoi cunghetnawk to thaksak, hae hmuen tawnkung mah kai zok angpomsak, tiah a naa. To pacoengah, khenah, bantuek, banlakok hoi cunghet loe mi ih maw, na panoek maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah mah to hmuennawk to panoek naah, Ka capa Shelah ka zusak ai pongah, anih loe kai pongah toeng kue, tiah thuih. To pacoengah loe anih to iip haih let ai boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khenah, nawkta ohhaih tue phak naah loe, anih ih zok thungah caa hnetto angphae.
  </para>
  <para style="p">
    <verse number="28" style="v" />Caa tapen naah nawkta maeto loe a ban tasa bangah payangh, Caa omsakkung mah hae kami hae tapen hmaloe, tiah thuih moe, nawkta ih ban to tlangqui kathim hoiah zaeng pae.
  </para>
  <para style="p">
    <verse number="29" style="v" />Toe ban to azuh let moe, anih ih amnawk to tapen lat; to naah nawkta omsakkung mah, Kawbang maw tha hoi na muk puk thaih takan loe? Tha hoi na muk pukhaih loe na nuiah om nasoe, tiah a naa. To pongah anih ih ahmin to Perez, tiah a sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pacoengah ban ah tlangqui kathim zaeng ih amya to tapen; anih to Zerah, tiah ahmin phui.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph to Izip prae ah caeh o haih tathuk; Faro ih angraeng maeto ah kaom, Izip kami, misatuh angraeng Potiphar mah, Joseph to Ishmael kaminawk ih ban thung hoiah a qanh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah Joseph to oh haih, anih loe tuinuen hoih kami ah oh; anih loe Izip kami, angmah angraeng ih im ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng mah anih oh thuih pongah, a sak ih toknawk boih ah hmacawn, tito angmah ih angraeng mah panoek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joseph loe anih ih mikcuk naakrak ah khosakhaih hoiah anih ih tok to sak pae; angmah ih imthung khenzawnkung ah a suek moe, a tawnh ih hmuennawk boih doeh anih ban ah ap.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anih to imthung takoh hoi a tawnh ih hmuennawk boih khenzawnkung ah suek pacoengah, Joseph rang hoiah Angraeng mah Izip kami ih imthung takoh to tahamhoihaih paek; Angraeng tahamhoihaih loe Potiphar mah tawnh ih im ih hmuennawk hoi lawk ah tawnh ih hmuennawk boih nuiah oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah a tawnh ih hmuennawk to Joseph khaeah a paek boih; anih loe takaw caak khue ai ah loe, a tawnh ih hmuen roe poek ai boeh; Joseph loe somsang hoih moe, krang doeh hoih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nazetto maw oh pacoengah loe angraeng ih zu mah Joseph to khit moe, kai hae na iip haih ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe Joseph mah angmak pae, angmah ih angraeng zu khaeah, Khenah, ka angraeng mah imthung ah kaom hmuennawk boih ka ban ah ap boeh pongah, im ah a suek ih hmuenmae to poek ai boeh;
  </para>
  <para style="p">
    <verse number="9" style="v" />hae imthung takoh ah kai pong kalen kue mi doeh om ai boeh; nang loe anih ih zu ah na oh pongah, nang khue ai ah loe ka angraeng mah kai hanah paawt ih hmuen tidoeh om ai; kawbang maw kalen parai hae baktih kasae hmuen hoiah zaehaih to Sithaw hmaa ah ka sah thai tih? tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nito pacoeng nito Joseph khaeah to baktih lok to a thuih pae, toe Joseph loe anih to iih haih moe, nawnto oh haih han koeh ai pongah, anih ih lok to tahngai pae ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nito naah Joseph loe angmah ih tok to sak hanah imthung ah caeh; to naah imthung ah tamna maeto doeh om ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Potiphar ih zu mah Joseph ih laihaw to patawnh moe, Kai hae na iip haih ah, tiah a naa. Toe Joseph mah angmah ih laihaw to nongpata ban ah angkhring pae sut moe, im tasa bangah cawnh taak ving.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nongpata mah Joseph loe laihaw angkhring moe, anih ban ah caehtaak sut pacoengah, tasa bangah cawnh ving boeh, tiah panoek naah,
  </para>
  <para style="p">
    <verse number="14" style="v" />nongpata mah a im ih kaminawk to kawk moe, nihcae khaeah, Khenah, aicae pahnui thuih han ih ni hae Hebru kami hae aicae khaeah a hoih; anih loe kai iih haih hanah kai khaeah angzoh, toe tha hoi ka hang;
  </para>
  <para style="p">
    <verse number="15" style="v" />tha hoi ka hanghaih lok to anih mah thaih naah, angmah ih laihaw to kai khaeah a caehtaak sut moe, im tasa bangah a cawnh ving, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angmah ih angraeng im ah angzo ai karoek to, Joseph ih laihaw to nongpata angmah khaeah suek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angraeng angzoh naah loe hae tiah a thuih pae, Kaicae khaeah nang hoih ih Hebru thendoeng loe kai pahnui thuih hanah kai khaeah angzoh;
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe tha hoi ka hangh naah, angmah ih laihaw to kai khaeah a caeh taak moe, angmah to loe im tasa bangah cawnh ving, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />To tiah na tamna mah kai hae ang sak, tiah a zu mah thuih ih lok to angraeng mah thaih naah, a sava palungphuihaih loe hmai baktiah amngaeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joseph ih angraeng mah anih to naeh moe, siangpahrang mah thong pakhrak ih kaminawk suekhaih ahmuen ah Joseph to suek; Joseph loe to ih thongim thungah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe Joseph loe Angraeng mah oh thuih; a nuiah tahmenhaih amtuengsak moe, thongim toepkungnawk mikcuk naakrak ah oh thaihaih to paek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thongim ukkung mah thongkrah kaminawk boih khenzawnkung ah Joseph to suek; to ah sak o ih hmuennawk boih khenzawnkung ah Joseph to a suek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah anih to oh thuih pongah, a sak ih hmuen boih ah hmacawn; Joseph khetzawnhaih tlim ah kaom hmuennawk loe thongim khenkung mah khet let han angai ai boeh.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni nazetto maw oh pacoengah, Izip siangpahrang ih boengloeng sinkung hoi buh thongkung loe angmah ih angraeng Izip siangpahrang koeh ai ih hmuen to sak hoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Faro loe boengloeng sinkung hoi buh thongkung, angmah ih toksah angraeng hnik nuiah paroeai palungphui.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah nihnik to Joseph thongkrakhaih ahmuen, im toepkung ohhaih im ah thong pakhrak hmaek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thongim ukkung mah nihnik to Joseph ban ah paek moe, Joseph mah nihnik to khetzawn; ni nazetto maw loe to imthung ah thongkrak hoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />To tiah thongim thungah oh hoi pacoengah, Izip siangpahrang ih boengloeng sinkung hoi buh thongkung mah, qumto naah angmah hnik hnuksak ih amang to a sak hoi hmaek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Joseph loe khawnbang khawnthaw ah nihnik khaeah caeh; nihnik to khet naah, palung a set hoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah angmah ih angraeng im ah angmah hoi nawnto thongkrah Faro ih toksah angraeng hnik khaeah, Tipongah vaihni loe palung na set hoi parai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihnik mah, Amang ka sak hoi, toe lehkung om ai, tiah a naa hoi. To pongah Joseph mah nihnik khaeah, Sithaw mah leh thai ai, tiah na poek hoi maw? Na mang to na thui hoih, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah boengloeng sinkung mah angmah ih amang to Joseph khaeah thuih pae; anih khaeah, Ka mang ah, misurkung to ka hmaa ah oh;
  </para>
  <para style="p">
    <verse number="10" style="v" />to misurkung pongah tanghang thumto oh; tanghang nuiah tadok to tacawt moe, apawk to apawk, athaih to tacawt moe, hminh;
  </para>
  <para style="p">
    <verse number="11" style="v" />Faro ih boengloeng loe ka ban ah oh; misurthaih to ka pakhrik moe, Faro ih boengloeng ah ka pasawh pae, boengloeng to a ban ah ka paek, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph mah anih khaeah, Amang thuih koehhaih loe hae tiah oh; tanghang thumto loe ni thumto thuih koehhaih ih ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni thumto thungah Faro mah na lu to atoeng tahang ueloe, nangmah ih ahmuen ah na suem let tih; canghniah boengloeng sinkung ah na oh baktih toengah, Faro ban ah boengloeng paekkung ah na om let tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khosak hoihaih na tongh naah, kai hae na pahnet hmah loe, ka nuiah na tahmenhaih amtuengsak ah; Faro khaeah kai ih kawng to na thui pae ah loe, hae thongim thung hoiah na loisak toeng ah;
  </para>
  <para style="p">
    <verse number="15" style="v" />kai loe Hebru prae thung hoiah ang paquk o ving moe, hae prae ah doeh sakpazaehaih om ai ah thongim thungah ang pakhrak o let bae, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph mah amang kahoih ah leh pae, tito buh thong kami mah panoek naah, Joseph khaeah, Kai doeh amang ka sak toeng, Khenah, ka lu nuiah takaw suekhaih kanglung takho thumto ka koeng;
  </para>
  <para style="p">
    <verse number="17" style="v" />ranui koek ih takho pongah loe Faro han ih takaw congca to oh; toe ka lu nui ih takaw loe tavaanawk mah caak o, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph mah, Amang thuih koehhaih loe hae tiah oh; takho thumto loe ni thumto thuih koehhaih ih ni;
  </para>
  <para style="p">
    <verse number="19" style="v" />ni thumto thungah Faro mah na lu to pathawk tahang ueloe, thing pongah na bang tih; to pacoengah na ngan to tavaanawk mah caa o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ni thumto naah Faro tapenhaih ni to oh; to naah anih mah angmah ih tamnanawk boih hanah buhraenghaih to sak pae; a tamnanawk salakah boengloeng sin kami hoi buh thong kami ih lu to atoengh pae tahang;
  </para>
  <para style="p">
    <verse number="21" style="v" />boengloeng sin kami hanah loe tok to a paek let pongah, anih loe Faro ban ah boengloeng paek kami ah oh let;
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe buh thong kami loe Joseph mah thuih pae ih lok baktih toengah, thing nuiah a bangh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe boengloeng sin kami mah Joseph to panoek ai, pahnet ving boeh.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Saning hnetto boeng pacoengah, Faro mah amang to sak; anih loe vapui taengah angdoet.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenah, to naah krang kahoih, kathawk maitaw sarihto tui thung hoiah tacawt tahang moe, vapui taeng ih phroh to a caak o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pacoengah krangsae, zaek kaeng kalah maitaw sarihto vapui thung hoiah tacawt let moe, hmaloe ih maitawnawk khaeah vapui taengah angdoet o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Krangsae zaek kaeng maitawnawk mah, kranghoih kathawk maitaw sarihtonawk to caak o king. To naah Faro loe anglawt.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ih let naah amang to sak let; khenah, katak moe, kahoih parai cangqui sarihto loe cangkung maeto nuiah tacawt o tahang.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah ni angyae bang ih takhi mah hmuh phaeng ih, katak ai kazaek cangqui sarihto tacawt let.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah katak ai kazaek cangqui sarihto mah, katak moe, kahoih cangqui sarihtonawk to caak boih. Faro anglawt naah to hmuen loe, amang ah oh pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khawnbang phak naah loe a dawnrai; to pongah Izip prae thungah kaom miklet kop kaminawk hoi palungha kaminawk to a kawk boih; Faro mah nihcae khaeah angmah ih amang to thuih pae, toe mi mah doeh leh pae o thai ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah boengloeng sinkung mah Faro khaeah, Vaihniah ka poek vawk;
  </para>
  <para style="p">
    <verse number="10" style="v" />nito naah Faro loe a tamnanawk nuiah palungphui moe, kai hoi buh thongkung to thongim khenzawnkung ih im ah thong ang pakhrak hoi hmaek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Qumhto naah, anih hoi nawnto amang ka sak hoi; kaimah hnik thuih koehhaih amang to ka sak hoi hmaek.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah misatuh angraeng ih tamna, Hebru kami, thendoeng maeto doeh oh toeng; anih khaeah amang to ka thuih pae hoi, anih mah kaihnik hanah amang ang leh pae; ka sak hoi ih amang to ang leh pae hoi hmaek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anih mah ang leh pae ih amang baktih toengah, hmuen to oh phaek; kai loe tok ka hnuk let, kalah maeto loe thing nuiah bangh o, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Faro mah Joseph to kawksak; anih to thongim thung hoi karangah angzoh o haih; sam to aah pae moe, khukbuen to angkraisak pacoengah, Faro hmaa ah a caeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Faro mah Joseph khaeah, Amang ka sak, toe mi mah doeh na leh pae o thai ai; toe nang loe amang leh thaih, tiah thuih ih tamthang to ka thaih, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph mah Faro khaeah, Kai mah sakthaihaih ka tawn ai; toe Sithaw mah a koehhaih baktih toengah Faro khaeah thui tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah Faro mah Joseph khaeah, khenah, amang ah vapui taengah kang doet;
  </para>
  <para style="p">
    <verse number="18" style="v" />khenah, vapui thung hoiah krang kahoih, kathawk maitaw sarihto tacawt o moe, vapui taeng ih phrohnawk to a caak o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khenah, to pacoengah krangsae kathawk ai, kazaek kaeng maitaw sarihto tacawt let bae.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kasae moe, kathawk ai, kazaek kaeng maitaw sarihto mah, tacawt hmaloe krang kahoih, kathawk maitaw sarihtonawk to caak o king;
  </para>
  <para style="p">
    <verse number="21" style="v" />maitawnawk caak o king pacoengah doeh, caak king boeh, tito mi mah doeh panoek thai ai; toe kathawk maitaw kacaa king, kazaek maitawnawk loe, kathawk maitawnawk caa ai nathuem ih baktih toengah, krangset moe, zaek kaeng ah oh o toeng roeng vop. To pongah kang lawt ving.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amang ka sak let naah, khenah, kahoih parai cangkung maeto nuiah tacawt cangqui sarihto ka hnuk;
  </para>
  <para style="p">
    <verse number="23" style="v" />khenah, to pacoengah katak ai, kazaek, ni angyae bang ih takhi mah hmuh phaeng ih kamprawk cangqui sarihtonawk to ka hnuk let.
  </para>
  <para style="p">
    <verse number="24" style="v" />Atak kaom ai, kazaek cangqui mah atak kaom cangqui sarihtonawk to paaeh boih; hae kawng hae miklet kop kaminawk khaeah ka thuih pae; toe mi mah doeh na thui pae o thai ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pacoengah Joseph mah Faro khaeah, Faro ih amang loe maeto ah ni oh; Sithaw mah sak han ih hmuen loe Faro khaeah amtuengsak boeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kahoih maitaw sarihto loe saning sarihto thuikoehhaih ih ni; katak cangqui sarihto doeh saning sarihto thuikoehhaih ih ni; amang loe maeto ah ni oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />To maitawnawk hnukah tacawt krangsae moe, kazaek kaeng maitaw sarihtonawk doeh, saning sarihto thuikoehhaih ih ni; atak kaom ai, ni angyae bang ih takhi mah hmuh phaeng ih cangqui loe, saning sarihto thung khokha han thuikoehhaih ih ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae loe Faro khaeah ka thuih tangcae ih amang hoiah ni anghmong; Sithaw mah sak han ih hmuen to Faro khaeah amtuengsak boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khenah, Izip prae thung boih ah saning sarihto thung angraeng paraihaih to om tih;
  </para>
  <para style="p">
    <verse number="30" style="v" />to pacoengah saning sarihto thung khokhahaih to om tih; to naah Izip prae thungah paroeai angraenghaih to mi mah doeh panoek mak ai boeh; khokhahaih mah prae to amrosak boih tih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khokhahaih nung parai pongah, canghniah angraeng paraihaih to mi mah doeh panoek thai mak ai boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sithaw mah sak han ih hmuen to caksak boeh pongah, Faro khaeah amang vai hnetto amtuengsak boeh; to pongah akra ai ah Sithaw mah to hmuen to omsak tih.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pongah Faro mah, vaihi khopoek thaihaih hoiah palungha kaminawk to pakrong ah loe, Izip prae to uksak ah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Faro mah hae tiah sak na nasoe, prae ukkungnawk to kawk ah loe, prae angraenghaih saning sarihto thung tacawt cang to pangato thungah maeto kok o nasoe.
  </para>
  <para style="p">
    <verse number="35" style="v" />Prae angraeng nathung nihcae mah cang to kok o nasoe loe, Faro khaeah suem o nasoe, vangpui kruekah cang to patung o nasoe.
  </para>
  <para style="p">
    <verse number="36" style="v" />Saning sarihto thung Izip prae khokha naah, khokhahaih mah prae to paro ai ah, prae kaminawk mah caak o thai hanah, hae tiah cang patung han oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />To tiah Joseph mah thuih ih lok to Faro hoi a tamnanawk boih mah hoih, tiah poek o.
  </para>
  <para style="p">
    <verse number="38" style="v" />To pongah Faro mah, a tamnanawk boih khaeah, Sithaw ih Muithla katawn, hae baktih kami a hnu o thai tih maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />To pacoengah Faro mah Joseph khaeah, Sithaw mah nang khaeah hae hmuennawk hae amtuengsak boih boeh pongah, nang pongah khopoek thaih hoi palungha kami om ai boeh;
  </para>
  <para style="p">
    <verse number="40" style="v" />nang mah ka imthung to uk ah; na thuih ih lok baktih toengah kai ih kaminawk lokcaek han oh; kai loe angraeng tangkhang pongah kang hnut naah khue ni nang pong ka len kue ah ka om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="41" style="v" />To pongah Faro mah Joseph khaeah, Izip prae boih ukkung ah kang suek boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="42" style="v" />To pacoengah Faro mah angmah ih bantuek to angkhring moe, Joseph ih ban ah abuensak; puu kahni to angkhuksak moe, tahnong ah sui bungmu to a oihsak.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih mah hnetto haih hrang leeng nuiah Joseph to angthuengsak, kaminawk anih hmaa ah khokkhu cangkrawn oh, tiah hang o. To tiah anih loe Izip prae thung boih ukkung ah oh.
  </para>
  <para style="p">
    <verse number="44" style="v" />To pacoengah Faro mah Joseph khaeah, Kai loe Faro ah ka oh, toe nang ih lok ai ah loe mi kawbaktih doeh Izip prae thung boih ah a ban maw, a khok maw phok o thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="45" style="v" />Faro mah Joseph to Zaphnath Paneah, tiah ahmin paek moe, On vangpui ah kaom qaima Potipherah ih canu, Asenath to anih hanah zu ah a paek; Joseph loe Izip prae thung boih ah caeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Joseph mah Izip siangpahrang Faro ih toksak pae naah, saning qui thumto oh boeh; Joseph loe Faro hmaa hoi caeh moe, Izip prae to takui boih.
  </para>
  <para style="p">
    <verse number="47" style="v" />Saning sarihto thung prae thungah cang paroeai tacawt.
  </para>
  <para style="p">
    <verse number="48" style="v" />Joseph mah saning sarihto thung Izip prae thung boih ah cang to pakhueng moe, vangpui kruekah suek; vangpui taeng ih cang boih vangpui thungah pakhuengsak.
  </para>
  <para style="p">
    <verse number="49" style="v" />Anih mah patung ih cang loe tuipui taeng ih savuet baktiah paroeai pop moe, kroek laek ai khoek to pop, kroek doeh kroek thai ai boeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Khokhahaih amtong ai naah, On vangpui ah kaom qaima, Potipherah ih canu Asenath mah, Joseph han capa hnetto sak pae.
  </para>
  <para style="p">
    <verse number="51" style="v" />Joseph mah Sithaw mah ka raihaih hoi kam pa ih imthung takoh ang pahnetsak boeh, tiah a thuih pongah calu to Manasse, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="52" style="v" />A capa hnetto haih loe, Ka patanghaih prae ah Sithaw mah athaih ang thaisak, tiah a thuih pongah Ephraim, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="53" style="v" />Izip prae angraenghaih loe saning sarihto thungah boeng.
  </para>
  <para style="p">
    <verse number="54" style="v" />Joseph mah thuih ih lok baktih toengah, khokhahaih saning sarihto oh amtong boeh; prae boih ah khokha pongah kaminawk loe duek o, toe Izip prae ah loe buh to oh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Izip prae thungah khokhahaih amtong naah, kaminawk loe buh hnik hanah Faro khaeah hang o; to naah Faro mah Izip kaminawk boih khaeah, Joseph khae caeh oh loe, a thuih ih lok baktih toengah sah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="56" style="v" />Long pum ah khokhahaih to phak, Izip prae thung khokhahaih nung parai boeh pongah, Joseph mah patung ih cang to paongh moe, Izip kaminawk khaeah zawh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Prae thung boih ah khokhahaih nung parai boeh pongah, prae kruek ih kaminawk Izip prae ah angzoh o moe, Joseph khaeah cang to qan o.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izip prae ah cang oh, tito Jakob mah thaih naah, a caanawk khaeah, Tikhoe nangmacae hoi nangmacae to nang khet o khing loe?
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenah, Izip prae ah cang oh, tiah ka thaih; caeh o tathuk loe, a duek o han ai a hing o thai hanah, cang to qan oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah Joseph ih amya hatonawk loe cang qan hanah Izip prae ah caeh o tathuk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe Jakop mah raihaih tong moeng tih, tiah zithaih tawnh pongah, Joseph ih amnawk, Benjamin loe patoeh ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kanaan prae ah khokha pongah, cang qan han caeh kaminawk thungah, Israel ih caanawk athum o toeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Joseph loe prae ukkung ah oh moe, kaminawk khaeah cang zawkung ah oh; Joseph ih amyanawk loe caeh o moe, anih hmaa ah long ah akuep o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joseph mah amyanawk to hnuk naah, nihcae to maat boih, toe kami kalah baktiah angsak pae moe, nihcae to lok kaham hoiah tapring; nihcae khaeah, Nangcae loe naa hoiah maw nang zoh o? tiah a naa. Nihcae mah, Cang qan hanah Kanaan prae hoiah kang zoh o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph mah amyanawk to panoek, toe nihcae mah anih to panoek o ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joseph mah nihcae kawng thuih koehhaih amang to a poek moe, nihcae khaeah, Nangcae loe tamquta hoi misa khen kami ni, prae thung thazokhaih oh maw, om ai tiah khet han ih ni nang zoh o, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihcae mah, To tih na ai ni, ka angraeng, na tamnanawk loe cang qan han ih ni kang zoh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kaicae loe kami maeto ih caa ni, kaicae loe kahoih kami ah ni ka oh o, na tamnanawk loe minawk khen paqu kami na ai ni, tiah a naa o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae khaeah, To tih na ai ni; prae thung thazokhaih oh maw, om ai tiah khet han ih ni nang zoh o, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe nihcae mah, Kaicae loe nawkamya hatlai hnetto ka oh o moe, Kanaan prae ah kaom kami maeto ih caa ah ni ka oh o boih; khenah, asoi koek loe kam pa khaeah oh moe, maeto loe om ai boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph mah nihcae khaeah, Kang thuih o ih baktiah ni na oh o; nangcae loe tamquta hoi misa khen kami ni, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />To tih boeh loe nangcae tanoek hanah hae tiah om nasoe, nam nawk asoi koek to haeah angzo ai nahaeloe, Faro hing thung hae ahmuen hoiah na tacawt o thai mak ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangcae loktang thuih maw, thui ai tito tanoek hanah, nangmacae thung ih kami maeto patoeh oh, anih mah nam nawk kanawk koek to haeah angzo haih nasoe; to tih ai nahaeloe, Faro hing thung nangcae loe tamquta hoi misa khen kami ah ni na om o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah nihcae to ni thumto thung thongim pakhrak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni thumto naah loe Joseph mah nihcae khaeah, Kai loe Sithaw ka zit, nangcae na hing o thai hanah, hae tiah sah oh;
  </para>
  <para style="p">
    <verse number="19" style="v" />kahoih kami ah na oh o nahaeloe, nangcae thung ih kami maeto thongim thungah caeh o taak ah; kalah kaminawk loe im ah kaom zok kamthlam kaminawk hanah cang to phaw pae oh;
  </para>
  <para style="p">
    <verse number="20" style="v" />nam nawk asoi koek to kai khaeah nang hoih o nahaeloe, nang thuih o ih lok baktih toengah katoeng kami ah na om o ueloe, na hing o tih, tiah a naa. To tiah a thuih pae ih lok baktih toengah nihcae mah sak o.
  </para>
  <para style="p">
    <verse number="21" style="v" />To naah nihcae mah, aimacae ih amnawk nuiah zaehaih a tawnh o boeh; anih mah tahmenhaih ang hnik naah, anih loe kawkruk maw poek angpho, tito a panoek o, toe aicae mah a thuih ih lok tahngai pae o ai; to pongah vaihi aicae nuiah tasoehhaih phak boeh, tiah maeto hoi maeto a thuih o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Reuben mah nihcae khaeah, Nawkta nuiah zaehaih sah o hmah, tiah kang thuih o naah na tahngai o ai to loe? To pongah khenah, vaihi loe anih ih athii tho a hnu o tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lok lehkung to patoh pongah, Joseph mah nihcae ih lok to thaih kop, tiah nihcae mah panoek o ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joseph loe nihcae khae hoi kalah bangah angqoi moe qah; toe angqoi let moe, nihcae khaeah lokthuih pae let, nihcae mikhnuk ah Simeon to naeh moe, qui hoiah pathlet.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph mah nihcae ih dip thungah cang to thaengh pae moe, a paek o ih phoisa doeh angmacae ih dip thungah pacaeng pae let pacoengah, loklam ah caak koi hmuennawk pacaeng pae hanah, lok a thuih pae; to tiah nihcae hanah a sak pae.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angmacae ih laa hrang nuiah cang to thuengh o moe, a caeh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ataihaih ahmuen ah phak o naah, kami maeto mah angmah ih laa hrang to rawkcak paek hanah dip to paongh, to naah phoisa to dip thungah a hnuk.
  </para>
  <para style="p">
    <verse number="28" style="v" />Angmah ih nawkamyanawk khaeah, Khenah, phoisa ang pakut let, kai ih dip thungah oh, tiah a naa. To naah palungboeng o moe, tasoehhaih hoiah oh o; tipongah Sithaw mah aicae nuiah hae tiah hmuen a sak vai? tiah maeto hoi maeto ang thuih o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kanaan prae ah ampa Jakob khae phak o naah, a tongh o ih hmuennawk boih a thuih pae o; nihcae mah,
  </para>
  <para style="p">
    <verse number="30" style="v" />to prae ukkung angraeng mah lok kaham hoiah kaicae to ang tapring; kaicae loe tamquta hoi prae thazokhaih khen kami ah a poek.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaicae mah anih khaeah, Kaicae loe kahoih kami ni, tamquta hoi minawk khen kami na ai ni;
  </para>
  <para style="p">
    <verse number="32" style="v" />kaicae loe nawkamya hathai hnetto ka oh o moe, ampa maeto ih caa ni, maeto loe om ai boeh; kanawk koek loe Kanaan prae ah kam pa khaeah oh, tiah ka thuih pae o.
  </para>
  <para style="p">
    <verse number="33" style="v" />To naah to prae ukkung angraeng mah, kaicae khaeah, Kami kahoih ah na oh o, tiah ka panoek thai hanah, nangcae thung ih kami maeto kai khaeah na caeh o taak ah, kalah kaminawk loe na imthung takoh zok kamthlam kaminawk hanah cang to phaw pae oh;
  </para>
  <para style="p">
    <verse number="34" style="v" />nangcae loe tamquta hoi misa khen kami na ai, kahoih kami ni, tiah ka panoek thai hanah, nangcae ih amnawk asoi koek to kai khaeah angzo o haih ah; to pacoengah haeah kaom nam nawk hae kang paek o let han; to naah ni prae thungah hmuenmae na zaw o thai vop tih, tiah ang naa, tiah a thuih pae o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Angmacae dip thung ih cang to pakong o boih naah, khenah, angmacae ih phoisa bawm loe dip thungah oh boih let; angmacae hoi ampa mah phoisa tabunawk to hnuk naah, tasoeh o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ampa Jakob mah nihcae khaeah, Ka caanawk to nang tahmat pae o boih boeh; Joseph loe om ai boeh moe, Simeon doeh om ai boeh; vaihi Benjamin lak hanah na thuih o let bae vop; hae hmuennawk hae ka koeh baktiah om thai ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="37" style="v" />To naah Reuben mah ampa khaeah, Anih nang khaeah kang zo o haih let ai nahaeloe, ka caa hnik hae hum hmaek ah; ka ban ah na paek ah, kai mah kang hoih let han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="38" style="v" />Toe Jakob mah, Ka capa hae na caeh haih mak ai; amya duek boeh moe, anih loe angmabueng ah ni oh boeh, loklam ah kasae tongh moeng nahaeloe, palungset loiah ka lu ih sampok hoi nawnto ah ni taprong thungah nang caeh o sak tih boeh, tiah a naa.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Prae thungah khokhahaih nung parai vop.
  </para>
  <para style="p">
    <verse number="2" style="v" />Izip prae thung hoi phawh o ih cang to caak o boih pacoengah ampa mah, nihcae khaeah, Caeh o let ah loe, cang to na qan pae o let raeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe Judah mah anih khaeah, To ih kami mah, Nam nawk na hoi o ai nahaeloe, ka mikhmai nang hnu o thai mak ai, tiah ang thuih boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kam nawk to kaicae hnukah nang zohsak nahaeloe, ka caeh o tathuk moe, cang to kang qan pae o han;
  </para>
  <para style="p">
    <verse number="5" style="v" />toe anih to nang zosak ai nahaeloe, ka caeh o tathuk mak ai; to kami mah, Nam nawk na hoi o ai nahaeloe, ka mikhmai na hnu o thai mak ai, tiah a thuih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel mah, kai raihaih paek hanah, tikhoe kam nawk oh vop, tiah na thuih o loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae mah, To kami mah kaimacae kawng hoi imthung takoh kawng, nam pa hing vop maw? Nam nawk kalah oh vop maw? tiah ang dueng; kaicae mah doeh ang dueng ih lok ni ka pathim pae o; nam nawk haeah na hoi o tathuk ah, tiah thui tih tito mi mah maw panoek? tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah Judah mah ampa Israel khaeah, Kaicae boih, nangmah hoi nawkta to dueh ai, ka hing o thai hanah, nawkta to kai hoi nawnto patoeh ah, kang thawk o moe, ka caeh o roep han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih to kahoih ah ka khetzawn han hmang; anih to nang khaeah kang zo haih let ai moe, na hmaa ah kang pha haih let ai nahaeloe, ka hing thung zaehaih ka zok han; kai khaeah anih to na suk ah;
  </para>
  <para style="p">
    <verse number="10" style="v" />hae tiah pakaahaih om ai nahaeloe, ka caeh o moe, vai hnetto doeh kam laem o han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah ampa Israel mah nihcae khaeah, To tiah om nasoe, tiah na poek o nahaeloe, hae tiah sah oh; hae prae thung ih kahoih koek thingthai, tak angnok koi hmuihoih, khoitui zetta, aan ah thuh ih hmuihoih, myrrh, thingthai mu hoi almond mu to phaw oh loe, to kami hanah tangqum ah paek oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Phoisa to kamtlai ah sin pae oh; nangmacae ih dip thungah kaom phoisa to sin oh loe, paek o let ah; anih mah pacaeng pazae moeng mue.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nam nawk hae caeh o haih ah, angthawk oh loe, to kami khaeah caeh o let ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />To kami mah to ih nam nawk to prawt moe, Benjamin na hoih o let thai hanah, Thacak Sithaw mah nangcae to tahmen nasoe; kai loe ka caanawk pongah, palungset hoiah ni ka oh han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah nihcae mah tangqum hoi phoisa to kamtlai ah sin o moe, Benjamin doeh caeh o haih; angthawk o moe, Izip prae ah caeh o tathuk pacoengah, Joseph hmaa ah angdoet o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae salakah kaom Benjamin to Joseph mah hnuk naah, angmah ih im khenzawnkung khaeah, Hae kaminawk hae ka im ah caeh haih ah, maitaw maeto bop oh loe, buh raenghhaih to sah ah; athun naah nihcae hoi nawnto buh ka caak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Joseph mah thuih ih lok baktih toengah to kami mah sak pae, nihcae to Joseph im ah caeh haih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph im ah a caeh haih pongah nihcae loe tasoeh o, canghni cang qan han a caeh o tangsuek naah aicae dip thungah phoisa oh let pongah ni, im ah ang caeh haih boeh; aicae hae na bop ueloe, nganbawh kana na paek tih boeh, tamna ah suek pacoengah, aicae ih laa hrangnawk doeh laa boih tih boeh, tiah a poek o.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pongah Joseph im toepkung khaeah caeh o moe, thok taengah anih khaeah lokthuih pae o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae mah, Aw angraeng, kaicae loe canghniah haeah cang qan han kang zoh o vai boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ataihaih im ka phak o naah, dip to ka paongh o, to naah kaimacae ih dip thungah phoisa tabu angmah toengroeng ah ka hnuk o let; to pongah vaihi kang sin o let.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cang qan hanah kalah phoisa doeh ka sin o let; mi mah maw kaicae ih dip thungah phoisa pacaeng, tito ka panoek o ai, tiah naa o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih mah, Lunghoihta hoiah om oh, mawn o hmah; nangcae ih Sithaw, nangcae ampa ih Sithaw mah ni nangcae ih dip thungah phoisa to ang pacaengh pae; nangcae ih phoisa loe ka hnuk bae, tiah a naa. To pacoengah anih mah Simeon to nihcae khaeah caeh haih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Im toepkung mah nihcae to Joseph im ah caeh haih, khok amsaeh han tui a paek moe, laa hrangnawk doeh rawkcak pacah.
  </para>
  <para style="p">
    <verse number="25" style="v" />To ah buhcaak han oh, tiah a thaih o pongah, Joseph athun buhcaak han angzoh naah tangqum hae paek si, tiah a thuih o moe, tangqumnawk to pathok o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joseph im ah amlaem naah, a sinh o ih tangqum to imthung ah Joseph han paek o moe, a hmaa ah long ah akuep pae o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngan na tui o maw? Nang thuih o ih nam pa mitong loe ngantui maw? A hing vop maw? tiah a dueng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae mah, Na tamna kaicae ampa loe hing vop, ngan doeh tui vop bae, tiah a naa o; to pacoengah a hmaa ah akuep o moe, khingyahaih paek o.
  </para>
  <para style="p">
    <verse number="29" style="v" />A khet naah amno ih capa, amnawk Benjamin to a hnuk, Anih loe nang thuih o ih, nam nawk asoi koek maw? tiah a naa. Sithaw mah na tahmen nasoe, ka capa, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amnawk nuiah palungset pongah, qahhaih ahmuen pakrong hanah karangah a caeh ving; angmah ih imthung ah a caeh moe, to ah a qah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mikhmai pathlak pacoengah, angzoh let, qah amsumh pacoengah, Buhcaak hanah patoemh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Angmabueng caak hanah buh to patoemh pae o, anih ih nawkamyanawk caak hanah doeh ahmuen kalah ah buh to patoem pae o; anih hoi nawnto buhcaa Izip kaminawk hanah doeh buh to patoem pae o toeng; Izip kaminawk hanah panuet thoh pongah, Izip kaminawk loe Hebru kaminawk hoi nawnto buhcaa o ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nawkamyanawk loe kacoeh koek hoi kanawk koek khoek to, angmacae ih saning baktih toengah Joseph hmaa ah anghnut o; nihcae loe maeto hoi maeto ang khet o moe, dawnrai o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Joseph mah nihcae caak hanah buh pazet naah, Benjamin to kalah kaminawk pongah alet pangato kamtlai ah a paek; nihcae loe naek o moe, anih hoi nawnto kanawm ah oh o.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph mah angmah ih im khenzawnkung khaeah, nihcae a phawh o thai thung, cang to phawsak ah loe, cang qanhaih phoisa to angmacae dip thungah pacaeng pae boih let ah, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah kai ih boengloeng, sum kanglung hoi sak ih boengloeng to, kanawk koek ih dip thungah cang a qanhaih phoisa hoi nawnto pacaeng paeh, tiah a naa. Joseph mah thuih ih lok baktih toengah anih mah sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khawnbang khodai naah loe nihcae to, angmacae ih laa hrang hoi nawnto patoeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae vangpui thung hoi tacawt o moe, nasetto kangthla ah doeh caeh o ai vop, to naah Joseph mah angmah ih im khenzawn kami khaeah, to kaminawk to patom ah loe, na kae naah, nihcae khaeah, Tipongah kahoih hmuen to kasae hoiah nang pathok o loe?
  </para>
  <para style="p">
    <verse number="5" style="v" />Tih hanah ka angraeng mah tui naek naah patoh ih, a boengloeng to na paquk o loe? To boengloeng loe kaom han koi hmuen khet naah patoh ih boengloeng ah oh, na sak o ih hmuen hae hoih ai, tiah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah nihcae to kae naah, a thuisak ih lok baktih toengah nihcae khaeah a thuih pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe nihcae mah, Tikhoe ka angraeng loe to tiah lokthuih loe? Na tamnanawk loe to baktih hmuen to ka sah o mak ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khenah, dip thungah ka hnuk o ih phoisa mataeng doeh, Kanaan prae thung hoiah kang sin o let bae; kawbang maw na angraeng im ih phoisa hoi sui to ka paqu o halat tih?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na tamnanawk thungah mi kawbaktih ih dip thungah doeh to hmuen to na hnuk nahaeloe, anih to dueh nasoe; kalah kaicae boih loe ka angraeng ih tamna ah ka oh o han, tiah a naa o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah, Na thuih o ih lok baktiah om nasoe, mi kawbaktih ih dip thungah doeh boengloeng to ka hnuk nahaeloe, anih to ka tamna ah om nasoe, kalah kaminawk loe loih o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah long ah karangah amtik o moe, angmacae ih dip to paongh o boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Im toepkung mah kacoeh ih hmuen hoi kanawk ih hmuen khoek to pakrong pae bit; to naah Benjamin ih dip thungah boegloeng to a hnuk.
  </para>
  <para style="p">
    <verse number="13" style="v" />To naah nihcae loe laihaw to asih o moe, laa hrang nuiah hmuennawk to thuengh o pacoengah, vangpui ah amlaem o let.
  </para>
  <para style="p">
    <verse number="14" style="v" />Judah hoi nawkamyanawk Joseph imthung ah akun o naah, Joseph loe imthung ah oh vop, nihcae loe anih hmaa ah long ah akuep o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph mah nihcae khaeah, Tipongah hae tiah na oh o loe? Na sak o ih hmuen ka panoek mak ai, tiah na poek o maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Judah mah anih khaeah, Ka angraeng khaeah timaw ka thuih o han boeh? Timaw ka thuih o han vop? Kawbang maw toenghaih kam tueng o sak han? Na tamnanawk ih zaehaih Sithaw mah amtuengsak boeh; khenah, kaicae loe nang ih tamna ah ni ka oh o han boeh, kaicae hoi boengloeng phawkung loe na tamna ah ka oh o han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe Joseph mah nihcae khaeah, To baktih hmuen to ka sah mak ai; boengloeng phawkung khue ni kai ih tamna ah om tih; kalah boih loe nam pa khaeah lunghoihta hoiah caeh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah mah anih khaeah caeh moe, Aw, ka angraeng, ka angraeng khaeah lok pakha to mah na thuisak raeh, nang loe Faro hoi kangvan ah na oh; toe na tamna nuiah palungphuisak hma raeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka angraeng nang mah, Nam pa hoi nam nawk na tawnh o vop maw? tiah nang dueng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaicae mah ka angraeng khaeah, Kam pa loe oh vop, anih loe mitong boeh moe, mitong lam ah sak ih capa maeto oh vop; anih ih amya loe duek boeh; amno ih capanawk thungah anih khue ni anghmat boeh; anih loe ampa mah paroeai palung, tiah kang thuih o.
  </para>
  <para style="p">
    <verse number="21" style="v" />To naah nang mah na tamnanawk khaeah, Kai khaeah angzo o haih ah, hnuk han ka koeh toeng, tiah na thuih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaicae mah ka angraeng nang khaeah, Nawkta loe ampa hoi ampraek thai ai, anih mah caeh taak nahaeloe, kam pa loe dueh tih, tiah kang thuih o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe nang mah na tamnanawk khaeah, Asoi koek nam nawk to nang zo o haih tathuk ai nahaeloe, ka mikhmai nang hnu o let mak ai boeh, tiah nang thuih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na tamnanawk kam pa khaeah ka caeh o let naah, ka angraeng nang mah nang thuih ih loknawk to ka thuih pae o boih.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah kam pa mah, Caeh o let ah loe, cang na qan pae o let ah, tiah ang naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe kaicae mah, Ka caeh o tathuk let mak ai; asoi koek kam nawk angzoh naah ni ka caeh o thai tih; asoi koek kam nawk to om ai nahaeloe, to kami ih mikhmai to ka hnu o let thai mak ai boeh, tiah ka naa o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na tamna ih ampa mah, Ka zu mah caa hnetto ang sak pae, tito na panoek o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Maeto loe kai khae hoiah caeh ving boeh pongah, Anih loe moi kasan mah taprawt pet pet boeh mue, tiah kang naa o. To pacoeng hoiah loe anih to ka hnu let ai boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Anih hae na lak o let moe, kasae tongh moeng nahaeloe, palungset loiah ka lu nui ih sampok hoiah ni nawnto taprong thungah nang thak o tih boeh, tiah ang naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pongah vaihi, nawkta hae hoi ai ah, na tamna mah kam pa khaeah ka caeh let nahaeloe, nawkta hinghaih hoi amhoe thai ai kam pa mah,
  </para>
  <para style="p">
    <verse number="31" style="v" />nawkta to khet hawk moe, kaicae hoi nawnto nawkta angzo ai, tiah panoek nahaeloe, anih loe dueh roep tih boeh; na tamnanawk mah palungset loiah anih lu nui ih sampok to taprong thungah ka laem o sak moeng tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na tamna kai mah nawkta to ngancuem ah kang zoh haih let han hmang, tiah ka thuih pae boeh; anih to kang zo haih let ai nahaeloe, ka hing thung kam pa hmaa ah kasae thuihaih ka phawh han hmang, tiah lok ka thuih boeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pongah vaihi nawkta zuengah kai hae na tamna ah ka oh han, nawkta loe amyanawk hoi nawnto amlaemsak ah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nawkta om ai ah, kawbang maw kam pa khaeah kam laem let thai tih? To tih ai nahaeloe, kam pa nuiah kapha raihaih to ka hnu moeng tih, tiah a naa.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph loe a taengah kangdoe kaminawk hmaa ah angsum thai ai boeh pongah, Kai khae hoi kalah bang caeh o boih ah, tiah a hang; to naah Joseph mah amyanawk khaeah angmah hoi angmah to taphong, to naah a taengah mi doeh om ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tha hoi a qah pongah, Izip kaminawk hoi Faro imthung takohnawk mah doeh thaih o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Joseph mah amyanawk khaeah, Kai loe Joseph ni! Pa to hing vop maw? tiah a naa. Toe amyanawk loe, Anih hmaa ah poek anghmang o sut pongah, lok pathim pae o ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />To naah Joseph mah amyanawk khaeah, Ka taengah angzo oh, tiah a naa. Nihcae loe caeh o. Anih mah, Kai loe Izip prae ah nang zawh o ih, nangcae ih amnawk Joseph ni!
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah kai nang zawh o pongah vaihi palungsae o sak hmah loe, palung doeh phui o hmah; hinghaih pahlong han ih ni hae ahmuen ah Sithaw mah kai ang patoeh hmaloe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vaihi prae thungah khokhahaih saning hnetto oh boeh, hmabang saning pangato thung mi mah doeh lawk sah mak ai ueloe, cang doeh aat o mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe long ah kanghmat nangcae to hingsak moe, kalen parai pahlonghaih hoiah nangcae to loisak hanah, Sithaw mah hae ahmuen ah kai hae ang patoeh boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah kai haeah patoehkung loe nangcae na ai, Sithaw ni; anih mah Faro to ampa ah ang sak pae, a imthung takoh boih ih angraeng ah ang suek moe, Izip prae boih ukkung ah ang sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kam pa khaeah karangah caeh oh loe, anih khaeah, Na capa Joseph mah, Kai loe Sithaw mah Izip prae thung boih ukkung angraeng ah ang sak boeh; akra ai ah, kai khaeah angzo tathuk ah, tiah a thuih;
  </para>
  <para style="p">
    <verse number="10" style="v" />kaimah hoi kazoi ahmuen, Goshen prae ah khosah oh, nangmah hoi na caanawk, na caanawk patoeng, maitawnawk, tuunawk hoi na tawnh ih hmuennawk to sin o boih ah;
  </para>
  <para style="p">
    <verse number="11" style="v" />kai mah kang pacah o han hmang, saning pangato thung khokha vop tih; to tih ai nahaeloe nangmah hoi na imthung takoh boih, na tawnh ih hmuennawk boih anghmaa tih, tiah thui pae oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khenah, nangcae hoi kam nawk Benjamin mikhnuk ah, ka pakha hoiah kang thuih o ih lok to na thaih o boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Izip prae ah ka lensawkhaih hoi na hnuk o ih hmuennawk boih, kam pa khaeah thui pae oh; karangah caeh oh loe, kam pa to haeah angzo o haih ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pacoengah amnawk Benjamin to takop moe, a qah; Benjamin mah doeh anih to takop moe, qah;
  </para>
  <para style="p">
    <verse number="15" style="v" />to pacoengah amyanawk boih to a mok moe, a qah; to pacoengah amyanawk hoiah lok apaeh o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph ih amyanawk angzoh o ti, tiah Faro imthung takoh mah thaih naah, Faro hoi a tamnanawk boih poeknawm o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Faro mah Joseph khaeah, Nam yannawk khaeah, hae tiah thui paeh loe, hae tiah sahsak ah; laa hrang hoiah hmuennawk to phaw o sak ah loe, Kanaan prae ah amlaemsak ah;
  </para>
  <para style="p">
    <verse number="18" style="v" />nam pa hoi imthung takoh kaminawk to kai khaeah angzosak ah; Izip prae thungah kahoih koek prae to kang paek han, prae kathawk to na caa o tih, tiah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangmah doeh nihcae khaeah hae tiah sak hanah thui paeh, a caanawk hoi a zunawk to lak hanah Izip prae thung ih hrang leeng to la nasoe loe, nam pa to angzo o haih nasoe.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmuennawk to paawt o hmah, Izip prae thung boih ih kahoih koek hmuen loe nihcae hanah om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pongah Israel caanawk mah to tiah a sak o; Faro mah thuih ih lok baktih toengah, Joseph mah hrang leengnawk to a paek, to pacoengah loklam ah caak han ih hmuen doeh a paek.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae boih han khukbuen kangtha to a paek, toe Benjamin loe phoisa cumvai thumto hoi khukbuen zung pangato a paek.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ampa hanah Izip prae thung ih kahoih koek hmuennawk to laa hrang hato pongah a phawsak, laa hrang amno hato pongah cang hoi takaw to phawsak pacoengah, ampa mah loklam ah caak han ih hmuennawk to a pat pae.
  </para>
  <para style="p">
    <verse number="24" style="v" />To pacoengah amyanawk to patoeh, nihcae doeh amsak o; loklam ah maeto hoi maeto angzoeh o hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae loe Izip prae thung hoiah angthawk o tahang moe, ampa Jakob ohhaih Kanaan prae ah caeh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih khaeah, Joseph loe hing vop! Izip prae ukkung ah oh, tiah a naa o. To naah Jakob loe palungboeng sut; nihcae to tang ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe Joseph mah thuih ih loknawk boih a thuih pae o moe, anih phawh hanah Joseph mah pat pae ih hrang leeng to a hnuk naah ni, ampa Jakob loe poekhaih tha oh let vop.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah Israel mah, Khawt boeh! Ka capa Joseph loe hing vop, ka caeh moe, ka dueh ai naah anih to ka hnuk han vop, tiah thuih.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pongah Israel loe a tawnh ih hmuennawk boih hoiah caeh moe, Beersheba phak naah, ampa Issak ih Sithaw khaeah angbawnhaih to sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sithaw mah Jakob khaeah aqum ah hnuksakhaih hoi lok to thuih pae, Jakob! Jakob! tiah a naa. Anih mah, Haeah ka oh, tiah pathim.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah, Kai loe Sithaw, nam pa ih Sithaw ah ka oh; Izip prae ah caeh tathuk hanah zii hmah; to ah kalen parai acaeng ah kang sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izip prae ah kang caeh haih moe, kam laem haih let han, Joseph mah na mik nuiah a ban to koeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pacoengah Jakob loe kholong caeh hanah Beersheba hoiah amsak, Israel ih caanawk mah ampa Jakob, anih ih caanawk hoi a zunawk to Faro mah nihcae phawh hanah patoeh ih hrang leeng nuiah angthueng o sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah Jakop mah Kanaan prae ah hnuk o ih hmuennawk hoi maitawnawk to sinh moe, a caanawk hoi nawnto Izip prae ah caeh tathuk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob loe angmah hoi a caanawk doeh Izip prae ah caeh haih boih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hae kaminawk loe Izip prae ah kacaeh Israel ih caanawk, Jakob caanawk ih ahmin ah oh; Reuben loe Jakob ih calu ah oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Reuben ih caanawk loe Hanok, Phallu, Hezron hoi Karmi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simeon ih caanawk loe Jemuel, Jamin, Ohad, Jachin, Zohar hoi Kanaan nongpata ih capa Shaul.
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi ih caanawk loe Gershon, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="12" style="v" />Judah ih caanawk loe Er, Onan, Shelah, Pharez hoi Zerah; toe Er hoi Onan loe Kanaan prae ah duek hoi boeh. Perez ih caanawk loe, Hezron hoi Hamul.
  </para>
  <para style="p">
    <verse number="13" style="v" />Issakar ih caanawk loe Tola, Puvah, Job hoi Shimron.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun ih caanawk loe Sered, Elon hoi Jahleel.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hae kaminawk loe Padan Aram ah, Leah mah Jakob hanah, canu Dinah hoi nawnto sak ih caa ah oh o; a capa hoi a canunawk loe sangqum boih ah qui thum, thumto oh o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad ih caanawk loe Zephion, Haggi, Shuni, Ezbon, Eri, Arodi hoi Areli.
  </para>
  <para style="p">
    <verse number="17" style="v" />Asher ih caanawk loe Jimnah, Ishuah, Isui hoi Beriah; nihcae ih tanuh loe Serah; Beriah ih caanawk loe Heber hoi Malkiel.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hae kaminawk loe Laban mah a canu Leah khaeah paek ih, Zilpah mah Jakob hanah sak pae ih caa ah oh o; kami hatlai tarukto oh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Joseph hoi Benjamin loe Jakob ih zu Rachel ih caa ah oh,
  </para>
  <para style="p">
    <verse number="20" style="v" />Izip prae, On vangpui ah kaom qaima Photipherah canu, Asenath mah Joseph han sak pae ih caanawk loe Manasseh hoi Ephraim.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin ih caanawk loe Bela, Beker, Ashbel, Gera, Naaman, Ehi, Rosh, Muppim, Huppim hoi Ard.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hae kaminawk loe Rachel mah, Jakob hanah sak pae ih kami ah oh o moe, sangqum boih ah hatlai palito oh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan ih caanawk loe Hushim.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali ih caanawk loe, Jahzeel, Guni, Jezer hoi Shillem.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hae kaminawk loe Laban mah a canu Rachel khaeah paek ih, Bilah mah Jakob han sak pae ih caa ah oh o moe, sangqum boih ah sarihto oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jakob hoi nawnto Izip prae ah angzo kaminawk boih, a capa ih zunawk to kroek ai ah, angmah ih caanawk boih loe qui taruk, tarukto oh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Joseph mah Izip prae thungah sak ih capa hnetto hoi Izip prae ah angzo, Jakob ih canawknawk boih loe, sangqum boih ah qui sarihto oh o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Goshen prae caehhaih loklam duengh hanah Jakob mah Judah to Joseph khaeah patoeh hmaloe, to tiah Goshen prae to a phak o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Joseph loe hrang leeng to suek coek moe, ampa Israel to hnuk hanah Goshen prae ah caeh; Goshen prae ah ampa khaeah phak naah, ampa to takop moe, a qah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Israel mah Joseph khaeah, Na hing vop pongah, na krang ka hnuk boeh; vaihi loe ka duek cadoeh palung mong boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />To pacoengah Joseph mah amyanawk hoi ampa imthung takohnawk khaeah, Faro khaeah ka caeh tahang moe, Kanaan prae ah kaom kam yanawk hoi kam pa imthung takohnawk angzoh o boeh;
  </para>
  <para style="p">
    <verse number="32" style="v" />nihcae loe tuu toep kami, maitaw khenzawn kami ah oh o; nihcae loe a tawnh o ih hmuen boih, maitawnawk, tuunawk to sin o, tiah ka thuih pae han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Faro mah kawk moe, tih tok maw na sak o? tiah na dueng nahaeloe,
  </para>
  <para style="p">
    <verse number="34" style="v" />nangcae mah, Na tamnanawk loe nawkta nathuem hoi kamtong vaihni ni khoek to, kam pa mah sak ih baktih toengah, maitawnawk ni ka toep o, tiah thui oh; to tiah nahaeloe nangcae to Goshen prae ah na omsak tih; tuutoep kami loe Izip kaminawk mah panuet o, tiah a naa.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph loe caeh moe, Faro khaeah, Kam pa hoi kam yanawk loe tuu, maitawnawk hoi a tawnh o ih hmuennawk boih phawh o moe, Kanaan prae hoiah angzoh o boeh, vaihi Goshen ah oh o, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anih mah amya pangato a qoih moe, nihcae to Faro khaeah caeh haih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Faro mah anih ih amyanawk to lokdueng, Tih tok maw na sak o? tiah a naa. Nihcae mah Faro khaeah, Na tamnanawk loe kam pa mah sak ih tok baktih toengah, tuu toep kami ah ka oh o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae mah Faro khaeah, Kanaan prae ah khokhahaih nung parai moe, pacah ih moinawk caak han ahmuen om ai boeh pongah, hae prae ah khosak hanah kang zoh o; to pongah vaihi na tamnanawk hae Goshen prae ah na omsak ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Faro mah Joseph khaeah, Nam pa hoi nam yanawk loe nang khaeah angzoh o boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Izip prae loe na hmaa ah ni oh; prae thung ih kahoih koek ahmuen ah nam pa hoi nam yanawk to omsak ah; Goshen prae ah om o nasoe; nihcae thungah hmuenmae sak kophaih tawn kami om nahaeloe, kai ih maitaw khenkung ah suem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah Joseph mah ampa to zaeh moe, Faro to patuek; Jakob mah Faro tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Faro mah Jakob khaeah, Saning nazetto maw na oh boeh? tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jakob mah Faro khaeah, Kai loe angvin ah ka ohhaih saning cumvai, qui thumto oh boeh; ka hinghaih saning loe tamsi vop, toe raihaih paroeai ka tongh; angvin ah kaom kam panawk khosakhaih saning to ka pha ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah Jakob mah Faro to tahamhoihaih paek moe, a caehtaak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Joseph mah ampa hoi amyanawk Izip prae ah ohsak moe, Faro ih lokpaekhaih baktih toengah, kahoih koek prae, Ramses ahmuen to a paek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph mah angmah ih ampa, amyanawk hoi ampa ih imthung takohnawk boih, kaom kami zetto caaknaek to a paek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khokha nung parai pongah, prae thung boih ah buh to om ai boeh; Izip prae hoi Kanaan prae doeh zaek sut boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Izip hoi Kanaan prae thung ih cang qanhaih phoisa loe Joseph mah patung boih moe, Faro im ah thak pae.
  </para>
  <para style="p">
    <verse number="15" style="v" />Izip prae hoi Kanaan prae ah phoisa boeng naah loe, Izip kaminawk boih Joseph khaeah angzoh o moe, caak hanah buh na paek ah, phoisa ka tawn o ai boeh, to pongah na hmaa ah maw ka duek o han boeh? tiah a naa o.
  </para>
  <para style="p">
    <verse number="16" style="v" />To naah Joseph mah, Phoisa na tawn o ai boeh nahaeloe, maitaw to sin oh, maitaw zuengah cang to kang paek o han, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah nihcae mah Joseph khaeah maitaw to sinh o; anih mah hrang, tuu, maeh, maitaw hoi laa hrangnawk to cang hoiah alaih pae; to na saning loe nihcae ih maitaw hoiah cang to alaisak boih.
  </para>
  <para style="p">
    <verse number="18" style="v" />To saning to boeng pacoeng amlaa ah loe, anih khaeah, phoisa ka tawn o ai boeh, tito ka angraeng na hmaa ah kang phat o ai boeh; kaicae ih maitawnawk doeh nang khaeah ni oh boih boeh, ka angraeng mikhnuk ah kaimacae ih takpum hoi lawknawk khue ai ah loe, tidoeh ka tawn o ai boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na hmaa ah ka duek o moe, prae doeh kam ro o sak han boeh maw? Kaimacae hoi ka lawknawk hae cang hoiah qan ah; lawk hoi kaimacae hae Faro ih tamna ah ka oh o halat han boeh; ka hing o moe, prae angqai krang hanah ka duek o han ai ah, cang to na paek ah, tiah a hnik o let bae.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pongah Joseph mah Faro hanah Izip prae ih lawknawk to qan pae boih; khokhahaih nung parai boeh pongah, Izip kaminawk loe lawk to zawh o boih; to pongah lawknawk loe Faro ih lawk ah angcoeng boih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izip prae boenghaih maeto bang hoi maeto bang khoek to kaminawk to vangpui ah angpuensak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe qaimanawk ih lawk loe qan pae ai; qaimanawk loe Faro khae hoi caaknaek khawt ah hnuk o; Faro mah nihcae han caaknaek khawt ah paek pongah, lawk to zaw o ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph mah prae kaminawk khaeah, Khenah, vaihi nangcae ih lawk Faro han ka qan pae boeh, hae ih cangtii hae la oh loe, lawk ah tuh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe cang na aah o naah pangato thungah maeto Faro han paek oh; kalah palito loe nangmacae han la oh loe, lawk ah tuh oh; nangmacae, na imthung takoh hoi na caanawk mah caak hanah cang to la oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae mah, Kaicae hinghaih nang pahlong; ka angraeng na mikcuk naakrak ah ka oh o nahaeloe, Faro ih tamna ah ka oh o halat han boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pongah qaimanawk ih lawk khue ai ah loe, Faro mah pangato thung ah maeto la nasoe, tiah Joseph mah sak ih lawk tawnkung nuiah lok takroekhaih to Izip prae thungah vaihni ni khoek to patoh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israelnawk loe Izip prae Goshen ah oh o; to prae to toep o moe, qoeng o tahang pacoengah, paroeai pung o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jokob loe Izip prae thungah saning hatlai sarihto oh, a hinghaih saning loe sangqum boih ah cumvai qui pali, sarihto phak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israel duek tom naah, a capa Joseph to kawk moe, anih khaeah, Na mikcuk naakrak ah ka oh nahaeloe, na ban to ka phaih tlim ah hawt ah loe, tahmenhaih hoi palungthin tang hoiah kai hoi nawnto lokkamhaih sah ah; tahmenhaih hoi kai hae Izip prae ah na phum hmah;
  </para>
  <para style="p">
    <verse number="30" style="v" />kai loe kam panawk khaeah ni kang song han, Izip prae thung hoiah na phaw ah loe, nihcae aphumhaih ahmuen ah na phum ah, tiah a naa. Anih mah, Na thuih ih baktih toengah ka sak han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih mah, Kai khaeah lokkamhaih sah ah, tiah a naa. To naah Joseph mah anih khaeah lokkamhaih to a sak; Israel loe angmah iihkhum lu bang ah lu akuep tathuk.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atue nasetto maw oh pacoengah, Nam pa loe ngannat, tiah Joseph khaeah thuih pae o; to pongah a caa Manasseh hoi Ephraim to kawk moe, a caeh haih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob khaeah, Na capa Joseph nang khaeah angzoh, tiah thuih pae o; to naah Israel loe tha pathok moe, a iih haih ahmuen ah anghnut.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jakob mah Joseph khaeah, Kanaan prae Luz vangpui ah Thacak Sithaw kai khaeah angphong moe, tahamhoihaih ang paek,
  </para>
  <para style="p">
    <verse number="4" style="v" />anih mah kai khaeah, Khenah, athaih kang thaisak moe, kang pungsak han, kami pop parai acaeng ah kang sak moe, angzo han koi na caanawk khaeah, hae prae hae dungzan ah toep hanah kang paek han, tiah ang naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kai haeah kang zo ai naah Izip prae ah na sak ih na caa Manasseh hoi Ephraim loe ka caa ah ni om hoi tih; Reuben hoi Simeon baktih toengah, nihnik loe ka caa ah om hoi tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah na sak ih na caa loe nangmah ih hmuen ah om tih, a toep o han koi qawknawk loe angmah ih nawkamya ahmin hoiah nawnto kroek o hmaek tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Padan hoiah kang zoh, Kanaan prae thungah ka caeh li moe, Ephrath vangpui to phak tom naah, nam no Rachel loe ka taengah duek; to pongah anih to Bethlehem, tiah thuih ih, Ephrath caehhaih loklam ah ka phum sut, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel mah, Joseph ih caanawk hnuk naah, Mi hnik aa? tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joseph mah ampa khaeah, Sithaw mah hae prae ah ang paek ih ka caa hnik ni, tiah a naa. Israel mah, tahamhoihaih paek hanah, ka taengah angzo haih ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel loe mitong boeh pongah a mik tha om ai boeh, to pongah kho hnu thai ai boeh; Joseph mah a caa hnik to anih khaeah caeh haih, ampa mah nihnik to mok moe, takop.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel mah Joseph khaeah, Na mikhmai hnuk han ka poek ai boeh, khenah, Sithaw mah vaihi na caa hnik to ang hnuksak boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph mah a caa hnik to ampa ih khokhu salakah suek moe, long ah lu takhumsak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Joseph mah nihnik to lak moe, Ephraim to a bantang ban hoi patawnh pacoengah, ampa ih bangqoi bangah a suek, Manasseh to a banqoi ban hoiah patawnh moe, ampa ih bantang bangah a suek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh loe calu ah oh, toe Israel mah palunghahaih hoiah a ban to payuengh moe, a bantang ban to Ephraim ih lu ah koeng pacoengah, a banqoi ban to Manaaseh ih lu ah a koeng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph to tahamhoihaih a paek, Kam pa Abraham hoi Issak mah bok ih Sithaw, ka hing thung vaihni ni khoek to kai khenzawnkung Sithaw,
  </para>
  <para style="p">
    <verse number="16" style="v" />zit kathok raihaih congca thung hoi kai pahlongkung van kami mah, hae ih nawkta hnik hae tahamhoihaih paek nasoe; nihnik loe kai ih ahmin, kam pa Abraham hoi Issak ih ahmin to phui o nasoe, long ah pop parai ah pung o nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ampa mah Ephraim nuiah bantang ban to koeng pae, tiah Joseph mah hnuk naah ampa nuiah palung hoih ai; to pongah Ephraim lu ih ampa ih ban to lak moe, Manasseh ih lu nuiah koeng pae.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph mah ampa khaeah, Pa, to tih na ai ni; anih loe calu ni, to pongah anih lu nuiah na bantang ban to koeng ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe ampa mah angmaak pae; Ka panoek, ka capa, ka panoek; anih doeh kami ah angcoeng ueloe, paroeai len tahang tih; toe amnawk loe anih pongah len kue tih, anih ih caanawk loe pop parai acaeng ah angcoeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang loe Sithaw mah Ephraim hoi Manasseh baktih toengah omsak nasoe, Israel caanawk loe nang rang hoiah tahamhoihaih hnu o tih, tiah to na niah nihcae to tahamhoihaih a paek; to tiah Ephraim to Manasseh hmaa ah suek lat.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah Israel mah, Joseph khaeah, Kai loe ka duek han boeh; toe Sithaw mah na om haih ueloe, nam panawk ih prae ah na hoi let tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe sumsen hoi kalii hoiah Amor kaminawk khaeah ka lak ih kahoih prae loe nam yanawk han ih na ai ah, nang han ih ni kang paek, tiah a naa.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Jakob mah a capanawk to kawk moe, hmabang angzo han koi hmuen kang thuih o han pongah, ahmuen maeto ah amkhueng oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob ih caanawk, nawnto amkhueng oh loe, nam Pa Israel ih lok hae tahngai oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reuben, nang loe ka calu, ka thacakhaih, ka tha oh tangsuekhaih, saiqathaih hoi sakthaihaih sang koek ah na oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tui baktiah nang phui pongah, na hoihhaih om mak ai boeh; nam pa iihhaih nuiah na dawh moe, ka iihhaih to nam hnongsak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon hoi Levi loe nawkamya ah oh moe, sumsen hoiah kasae sakhaih ahmuen ah a oh hoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw ka hinghaih, nihnik mah tamquta hoi sak ih ahmuen ah na thumsak hmah, kai pakoehhaih loe nihcae amkhuenghaih ahmuen ah na thumsak hmah; nihnik loe palungphuihaih hoiah kami to hum hoi moe, a koeh hoi ih baktiah vangpui tapang to paro hoi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihnik loe palungphui hoi, poek amthueng hoi moe, palungduemh hoi pongah kasae zok hoi nasoe! Jakob acaeng thungah nihnik to ka tapraek moe, Israel acaeng thungah kam hetsak phang han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah, nang loe nam yanawk mah pakoeh o tih; na ban loe misanawk ih tahnong nuiah om tih; nam pa ih caanawk loe na hmaa ah akuep o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Judah, nang loe kanawk kaipui ah na oh, ka capa, nang loe moi kaekhaih ahmuen hoiah nang zoh tahang moe, na tabok; kaipui baktih, kaipui amno baktih toengah avah; mi mah maw anih to pathawk thai tih?
  </para>
  <para style="p">
    <verse number="10" style="v" />Shiloh pha ai karoek to tayae toeng loe, Judah khae hoi amhoe mak ai ueloe, a ukhaih cunghet doeh a khok salak hoiah takhoe mak ai; kaminawk loe anih khaeah ni amkhueng o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Misurkung pongah angmah ih hrang to paeh ueloe, laa hrang caa to kahoih koek misurkung pongah paeh tih; angmah ih khukbuen to misurtui hoi pasuk ueloe, angmah ih laihawnawk doeh misurtui hoiah pasuk tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih ih mik loe misurtui hoi thim ueloe, a ha doeh maitaw tahnutui hoiah anglung tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebulun loe tuipui taengah om ueloe, palongpui anghakhaih ahmuen ah om tih; anih ih ramri loe Sidon karoek to kawk tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Issakar loe mae salakah tabok thacak laa hrang ah oh;
  </para>
  <para style="p">
    <verse number="15" style="v" />anghakhaih ahmuen kahoih to a hnuk moe, prae kahoih to a hnuk pongah, angmah ih palaeng nuiah hmuen to koeng ueloe, tamut paek tamna ah om tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan loe Israel ih acaeng maeto ah oh baktih toengah, angmah ih kaminawk to lokcaek tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan loe loklam ah kaom pahui ah om ueloe, hrang angthueng kami to hnuk angnawnsak hanah, hrang khok tahmawh patuk pahui sae ah om tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Angraeng, na pahlonghaih to ka zing.
  </para>
  <para style="p">
    <verse number="19" style="v" />Misanawk mah Gad to tuh o tih, toe anih mah nihcae to tuh let ueloe, hnukkhuem ah pazawk tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asher ah caaknaek kahoih tacawt tih, siangpahrang paek koi caaknaek to tacawt tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naphtali loe angmah koeh baktiah kaom tasuk, kranghoih caa sahkung tasuk ah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph loe thacak thingkung, tui taengah kaom thingkung ah oh; anih ih tanghangnawk loe tapang ranui khoek to amzam.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kalii kaat kop kaminawk mah anih to paroeai raihaih paek o, hnukma o moe, a kah o;
  </para>
  <para style="p">
    <verse number="24" style="v" />toe anih ih kalii loe thazok ai; anih ih ban tampawk loe Jakob Sithaw ih ban thacakhaih rang hoiah, (tuutoep kami ah kaom, Israel ih lungsong ah oh;)
  </para>
  <para style="p">
    <verse number="25" style="v" />nang loe nang bomkung, nam pa ih Sithaw rang hoiah nang han van ranui hoi tahamhoihaih paekkung, Sithaw rang hoiah tha na cak; atlim ah kaom kathuk tahamhoihaih, tahnutui hoi caa im tahamhoihaih mah nang han tahamhoihaih paek nasoe;
  </para>
  <para style="p">
    <verse number="26" style="v" />nam pa mah paek ih tahamhoihaih loe, canghni ah mae nui ih tahamhoihaih, dungzan maesomnawk nuiah kaom kahoih hmuennawk pongah doeh len kue; to tahamhoihaih loe Joseph ih lu nuiah om nasoe loe, amyanawk hoi kamhoe ah kaom kami ih lu nuiah om nasoe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamin loe kalomh thaih tasui ah oh; anih loe khawnthaw ah moi to kaek ueloe, aqum ah a lomh ih hmuen to tapraek tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae kaminawk loe Isreal acaeng hatlai hnetto ah oh o, ampa mah nihcae khaeah thuih pae ih lok loe hae tiah oh; ampa mah nihcae hak han koi tahamhoihaih to paek boih.
  </para>
  <para style="p">
    <verse number="29" style="v" />To pacoengah nihcae khaeah hae tiah lokthuih pae; Kai loe kaimah ih kaminawk amkhuenghaih ahmuen ah ka caeh han boeh; Hit kami Ephron ih lawk thungah kaom thlungkhaw thungah kam panawk hoi nawnto na phum oh,
  </para>
  <para style="p">
    <verse number="30" style="v" />to thlungkhaw loe Kanaan prae, Mamre vangpui pha ai naah, Makpelah ahmuen ah oh moe, Abraham mah Hit kami Ephron khaeah, lawk hoi nawnto taprong sak hanah a qanh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Abraham hoi a zu Sarah, Issak hoi a zu Rebakah loe to ahmuen ah aphum o; Leah doeh to ahmuen ah ka phum.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lawk hoi thlungkhaw loe, Hit kaminawk khaeah ni ka qanh, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />A caanawk khaeah lokthuih boih pacoengah, Jakob loe a iihhaih ahmuen ah a khok to azuh tahang, hinghaih qui apet pacoengah, angmah ih kaminawk amkhuenghaih ahmuen ah angkuem.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Joseph loe ampa nuiah tabok moe, qah pacoengah a mok.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah Joseph mah tasi sah kop a tamnanawk khaeah ampa ih qok to tasi pazut hanah thuih pae; tasi sah kop kaminawk mah Israel to tasi hoiah pazut o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih ih qok to tasi hoiah pazut hanah, ni qui palito akra; ni akoep pacoengah Izip kaminawk mah anih to ni qui sarihto thung qah o haih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Qahhaih ni boeng pacoengah, Joseph mah Faro imthung takohnawk khaeah, Nangcae mikcuk naakrak ah ka oh nahaeloe, Faro khaeah na thui pae oh,
  </para>
  <para style="p">
    <verse number="5" style="v" />kam pa mah, Khenah, ka duek tom boeh, ka duek naah Kanaan prae ah kaimah han takaeh ih taprong ah na phum ah, tiah lok ang kamsak. To pongah vaihi kam pa aphum hanah ka caeh moe, aphum pacoengah kam laem let han, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Faro mah, Lok ang kamsak baktih toengah, caeh tahang ah loe nam pa to aphum ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah Joseph loe ampa aphum hanah caeh tahang; Faro ih tamnanawk boih, anih im ih kacoehtanawk hoi Izip prae ih kacoehtanawk boih anih hoi nawnto caeh o,
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph imthung takohnawk, angmah ih amyanawk hoi ampa imthung takoh boih a caeh o; a caanawk, tuunawk hoi maitawnawk khue ni Goshen ah a caeh o taak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hrang leeng hoi hrang angthueng kaminawk doeh anih hoi nawnto caeh o; to pongah kami paroeai pop o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jordan vapui taengah kaom, Atad ih cang atithaih ahmuen to phak o naah, nihcae loe tha hoi qah o; Joseph mah ampa to ni sarihto thung qah haih.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah Kanaan prae thungah kaom kaminawk mah Atad cang atithaih ahmuen ih kaqah kaminawk to hnuk o naah, nihcae mah, Izip kaminawk loe paroeai qah o, tiah thuih o. To pongah Jordan vapui taeng ih to ahmuen to, Abel Mizraim, tiah kawk o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jakob ih caanawk loe ampa mah thuih pae ih lok baktih toengah sak o.
  </para>
  <para style="p">
    <verse number="13" style="v" />A capanawk mah anih ih qok to Kanaan prae ah caeh o haih moe, Abraham mah Hit kami, Ephron khaeah taprong sak hanah qan ih, Mamre vangpui pha ai naah kaom, Makpelah lawk ih thlung khaw thungah aphum o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ampa aphum o pacoengah, Joseph loe Izip prae ah amlaem let, anih loe angmah ih amyanawk, ampa aphum han caeh kaminawk boih hoi nawnto amlaem let.
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph ih amyanawk mah ampa duek boeh ti, tiah panoek o naah, nihcae mah, Anih nuiah a sak o ih kasae hmuen pongah, Joseph mah aicae hae hnuma ueloe, aicae nuiah kasae hmuen hoi pathok tih boeh, tiah a poek o.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah Joseph khaeah kami to patoeh o moe, Nam pa mah dueh ai naah kaicae khaeah hae tiah lok ang thuih,
  </para>
  <para style="p">
    <verse number="17" style="v" />Joseph khaeah, Nam yanawk mah na nuiah sak o ih zaehaih hoi sakpazaehaih boih to tahmen ah, tiah nam pa mah tahmenhaih hnik, tiah thui pae oh; nihcae mah na nuiah sak o ih zaehaih hoi nam pa ih Sithaw, anih ih tamnanawk mah sak o ih zaehaih to tahmen ah, tiah ang thuisak, tia a naa o. Nihcae mah thuisak ih hae lok to a thuih pae naah, Joseph loe qah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amyanawk loe anih hmaa ah caeh o moe, a hmaa ah akuep o; khenah, kaicae loe na tamna ah ni ka oh o boeh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toe Joseph mah nihcae khaeah, Zii o hmah; toe kai loe Sithaw angdoethaih ahmuen ah maw ka oh?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangcae mah kai hum hanah na poek o; toe vai hniah kaom hmuen baktih toengah Sithaw mah loe pop parai kaminawk hinghaih to pahlong hanah kho a khan.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pongah zii o hmah; nangmacae hoi na caanawk boih kang kok o han hmang, tiah a naa. Nihcae to patloep moe, lok kanaem hoiah tapring.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph loe ampa imthung takohnawk boih hoi nawnto Izip prae thungah khosak; Joseph loe saning cumvaito pacoeng, hato hing.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph loe a caa dung thumto haih, Ephraim ih caanawk to hnuk; Manasseh capa Makir ih caanawk loe Jospeh ih khokhu nuiah tapensak.
  </para>
  <para style="p">
    <verse number="24" style="v" />To naah Joseph mah amyanawk khaeah, Kai loe ka duek han boeh; toe nangcae abomh hanah Sithaw angzo ueloe, hae prae thung hoiah Abraham, Issak hoi Jakob khaeah paek han lokkam ih prae thungah na hoi o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph mah Israel ih caanawk to lokkamsak, Nangcae abomh hanah Sithaw angzo tih, to naah hae prae thung hoiah kai ih ahuh hae sin oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pongah Joseph loe saning cumvaito pacoeng, hato phak naah duek; anih ih qok to kaqong thai ai tasi pazut o pacoengah, Izip prae ah thingkhong thungah pasong o.
  </para>
</usx>
