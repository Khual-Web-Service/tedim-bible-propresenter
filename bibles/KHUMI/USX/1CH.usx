<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">1 Dungkrhoekhaih</book>
  <para style="h">1 Dungkrhoekhaih</para>
  <para style="toc1">1 Dungkrhoekhaih</para>
  <para style="toc2">1 Dungkrhoekhaih</para>
  <para style="mt">1 Dungkrhoekhaih</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam, Seth, Enosh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kenan, Mahalalel, Jared, Enok, Methuselah, Lamek, Noah. Noah, Shem, Ham hoi Japheth.
  </para>
  <para style="p">
    <verse number="5" style="v" />Japheth ih caanawk loe, Gomer, Magog, Madai, Javan, Tubal, Meshek hoi Tira.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gomer ih caanawk loe, Ashkenaz, Riphath hoi Togarmah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Javan ih caanawk loe, Elishah, Tarshish, Kittim hoi Rodanim.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ham ih caanawk loe, Kush, Mizraim, Put hoi Kanaan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kush ih caanawk loe, Seba, Havilah, Sabta. Raamah ih caanawk loe, Sheba hoi Dedan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kush ih capa loe Nimrod, anih loe long nuiah misatuk thacak kami ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mizraim mah Ludim, Anamim, Lehabim hoi Naphtuhim,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathrusim, Kasluhim (hae kami khae hoiah Philistin hoi Paphtorim acaengnawk anghum o).
  </para>
  <para style="p">
    <verse number="13" style="v" />KanaAn mah capa kacoeh koek Sidon hoi Hetht to sak;
  </para>
  <para style="p">
    <verse number="14" style="v" />anih loe Jebus, Amor, Girgash,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiv, Arkat, Sina,
  </para>
  <para style="p">
    <verse number="16" style="v" />Arvad, Zemar hoi Hamath acaengnawk ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shem ih capanawk loe, Elam, Asshur, Arphaxad, Lud hoi Aram, Uz, Hul, Gether hoi Meshek ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Arphaxad loe Shelah ih ampa ah oh moe, Shelah mah Eber to sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Eber mah capa hnetto sak; capa maeto tapen naah long tapraekhaih ah oh pongah, Peleg, tiah ahmin sak moe, amnawk loe Joktan, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joktan mah Amodad, Sheleph, Hazar-Maveth, Jerah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hadoram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ebal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ophir, Havilah hoi Jobab to sak; hae kaminawk boih loe Joktan ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shem, Arphaxad, Shelah,
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber, Peleg, Reu,
  </para>
  <para style="p">
    <verse number="26" style="v" />Serug, Nahor, Terah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Abram (Abraham) cae hae ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham capa hnik loe, Issak hoi Ishmael.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hae kaminawk loe nihnik ih caa ah oh o; Ishmael ih calu loe Nabaioth; to pacoengah Kedar, Adbeel, Mibsam,
  </para>
  <para style="p">
    <verse number="30" style="v" />Mishma, Dumah, Massa, Hadad, Tema,
  </para>
  <para style="p">
    <verse number="31" style="v" />Jetur, Naphish hoi Kedemah; hae kaminawk loe Ishmael ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abraham ih zula Keturah mah sak ih caanawk loe, Zimran, Jokshan, Medan, Midian, Ishbak hoi Shuah. Jokshan ih caanawk loe, Sheba hoi Dedan.
  </para>
  <para style="p">
    <verse number="33" style="v" />Midian ih caanawk loe Ephah, Epher, Henok, Abida hoi Eldaah; hae kaminawk loe Keturah ih caa ah oh o boih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abraham loe Isaak ih ampa ah oh; Isaak ih caa hnik loe, Esau hoi Israel.
  </para>
  <para style="p">
    <verse number="35" style="v" />Esau ih caanawk loe, Eliphaz, Reuel, Jeush, Jalam hoi Korah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eliphaz ih caanawk loe Teman, Omar, Zephi, Gatam hoi Kenaz, Timna hoi Amalek.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reul ih caanawk loe Nahath, Zerah, Shammah hoi Mizzah cae hae ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Seir ih caanawk loe Lotan, Shobal, Zibeon, Anah, Dishon, Ezar hoi Dishan.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lotan ih caa hnik loe, Hori hoi Homam; Timna loe Lotan ih tanuh ah oh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shobal caanawk loe Alian, Manahath, Ebal, Shephi hoi Onam; Zibeon capa hnik loe, Aiah hoi Anah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anah capa loe Dishon; Dishon ih caanawk loe, Amram, Eshban, Ithran hoi Keran.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ezer ih caanawk loe Bilhan, Zavan hoi Jakan; Dishan caa hnik loe, Uz hoi Aran.
  </para>
  <para style="p">
    <verse number="43" style="v" />Israel kaminawk siangpahrang tawn o ai naah, hae kaminawk loe Edom prae ah siangpahrang ah oh o; Beor capa Bela, anih ih vangpui ahmin loe Dinhabah.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bela duek pacoengah, Bozrah ah kaom Zerah capa Jobab to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Jobab duek pacoengah, Teman prae ih Husham to siangpahrang ah suek o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huhsam duek pacoengah, Bedad capa Hadad, Moab prae ih Midian kaminawk pazawkkung to, anih zuengah siangpahrang ah oh; anih vangpui ih ahmin loe Avith.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hadad duek pacoengah, Masrekah prae ih Samlah to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Samlah duek pacoengah, vapui taeng Rehoboth ah kaom, Shaul to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shaul duek pacoengah, Akbor capa Baal-Hanan to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Baal-Hanan duek pacoengah, anih zuengah Hadad to siangpahrang ah oh; anih ih vangpui hmin loe Pai; anih zu ih ahmin loe Me-Zahab canu Matred, Matred canu Mehetabel.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hadad doeh duek. Edom ih kacoehtanawk loe, Timna, Aliah, Jetheth,
  </para>
  <para style="p">
    <verse number="52" style="v" />Aholibamah, Elah, Pinon,
  </para>
  <para style="p">
    <verse number="53" style="v" />Kenaz, Teman, Mibzar,
  </para>
  <para style="p">
    <verse number="54" style="v" />Magdiel hoi Iram; hae kaminawk loe Edom prae kacoetanawk ah oh o.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel caanawk loe, Reuben, Simeon, Levi, Judah, Ishkar, Zebulun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Dan, Joseph, Benjamin, Naphtali, Gad hoi Asher.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah ih caanawk loe, Er, Onan hoi Shelah; hae thumtonawk loe Kanaan nongpata Shua canu ih caa ah oh o. Judah calu Er loe Angraeng mikhnukah kami kasae ah oh; to pongah anih to Angraeng mah paduek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Judah ih langah Tamar mah Perez khae hoiah Zerah to sak. Judah loe capa pangato tawnh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Perez ih caa hnik loe, Hezron hoi Hamul.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerah ih caanawk loe Zimri, Ethan, Heman, Kalkol hoi Dara, sangqum boih ah pangato oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karmi capa loe Akhar; anih loe tangoeng ah kaom Angraeng han pahoe ih hmuen to lak pongah, Israel nuiah raihaih phasakkung ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ethan capa loe, Azariah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hezron mah sak ih caanawk loe, Jerahmeel, Ram hoi Khelubai cae to ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ram loe Amminadab ih ampa ah oh; Amminadab loe Judah kaminawk zaehoikung Nashon ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nashon mah Salmon to sak, Salmon mah Boaz to sak,
  </para>
  <para style="p">
    <verse number="12" style="v" />Boaz mah Obed to sak moe, Obed mah Jesse to sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesse ih calu loe Eliab, hnetto haih capa loe Abinadab, thumto haih loe Shimma,
  </para>
  <para style="p">
    <verse number="14" style="v" />palito haih loe Nethanel, pangato haih loe Raddai,
  </para>
  <para style="p">
    <verse number="15" style="v" />tarukto haih loe Ozem, sarihto haih loe David;
  </para>
  <para style="p">
    <verse number="16" style="v" />nihcae ih tanunawk loe Zeruiah hoi Abigail. Zeruiah ih caanawk loe Abishai, Joab hoi Asahel.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abigail mah Amasa to sak, ampa loe Ishmael acaeng Jether.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hezron capa Kaleb mah a zu Azubah hoi Jerioth hnik khae hoiah sak ih caanawk loe, Jesher, Shobab hoi Ardon.
  </para>
  <para style="p">
    <verse number="19" style="v" />Azubah duek pacoengah, Kaleb mah Ephrath to zu haih moe, anih hoiah Hur to sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hur mah Uri to sak, Uri mah Bezalel to sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah Hezron mah Gilead ampa Makir canuh to iih haih, saning quitarukto oh naah, to nongpata to ani mah zu haih, anih mah Segub to sak pae.
  </para>
  <para style="p">
    <verse number="22" style="v" />Segub mah Jair to sak; anih loe Gilead prae ah vangpui quitarukto tawnh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Geshur hoi Aram hnik mah Jair vangpui to lak; Kenath hoi a taengah kaom vangpui quitarukto doeh a lak hoi; hae kaminawk loe Gilead ampa Maakir ih caa ah oh o boih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hezron duek pacoengah, Kaleb mah ampa ih zu Ephratah to iih haih; Hezron ih zu Abijah mah anih hanah Tekoa ih ampa Ashhur to sak pae.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hezron ih calu Jerahmeel ih caanawk loe, calu Ram, Bunah, Oren, Ozem hoi Ahijah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jerahmeel loe zula maeto tawnh; anih ih ahmin loe Atarah; anih loe Onam ih amno ah oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerahmeel calu Ram ih caanawk loe, Maaz, Jamin hoi Eker.
  </para>
  <para style="p">
    <verse number="28" style="v" />Onam ih caa hnik loe, Shammai hoi Jada; Shammai ih caa hnik loe, Nadab hoi Abishur.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abishur ih zu loe Abihail, anih mah Ahban hoi Molid to sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nadab capa hnik loe, Seled hoi Appaim; Seled loe caa sah ai ah duek.
  </para>
  <para style="p">
    <verse number="31" style="v" />Appaim capanawk loe, Ishi, anih mah Sheshan to sak moe, Sheshan mah Ahlai to sak.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shammai ih amnawk Jada capa hnik loe, Jether hoi Jonathan; Jether loe caa sah ai ah duek.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jonathan ih caa hnik loe, Peleth hoi Zaza; hae kaminawk loe Jerahmeel ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sheshan loe capa tawn ai, canunawk khue ni tawnh; anih loe Jarha, tiah kawk ih Izip kami tamna maeto a tawnh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sheshan loe a tamna Jarha hanah canu to paek moe, anih mah Attai to sak pae.
  </para>
  <para style="p">
    <verse number="36" style="v" />Attai mah Nathan to sak; Nathan mah Zabad to sak,
  </para>
  <para style="p">
    <verse number="37" style="v" />Zabad mah Ephial to sak moe, Ephial mah Obed to sak,
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed mah Jehu to sak moe, Jehu mah Azariah to sak,
  </para>
  <para style="p">
    <verse number="39" style="v" />Azariah mah Helez to sak moe, Helez mah Eleasah to sak,
  </para>
  <para style="p">
    <verse number="40" style="v" />Eleasah mah Sisamai to sak moe, Sisamai mah Shallum to sak,
  </para>
  <para style="p">
    <verse number="41" style="v" />Shallum mah Jekamiah to sak moe, Jekamiah mah Elishama to sak.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jerahmeel amnawk Kaleb ih capanawk loe Mesha, anih loe calu ah oh; anih loe Ziph ih ampa ah oh, anih ih capa loe Mereshah, anih loe Hebron ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hebron ih capanawk loe Korah, Tappuah, Rekem hoi Shema.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shema mah Raham to sak moe, Raham mah Jorkeam to sak; Rekem mah Shammai to sak.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shammai ih capa loe Maon; Maon mah Beth Zur to sak.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kaleb ih zula Ephah mah, Haran, Moza hoi Gazez to sak; Haran mah Gazez to sak.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jahdai capanawk loe Regem, Jotham, Geshan, Pelet, Ephah hoi Shaaph.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kaleb ih zula Maakah mah Sheber hoi Tirhanah to sak.
  </para>
  <para style="p">
    <verse number="49" style="v" />Anih mah Mad-mannah ih ampa Shaaph, Macbenah hoi Gibea ampa Sheva to sak; Kaleb ih canu loe Aksah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ephratah ih calu Hur ih capa, Kaleb ih caanawk loe, Kiriath-Jearim ampa Shobal,
  </para>
  <para style="p">
    <verse number="51" style="v" />Bethlehem ih ampa Salma hoi Berth-Gader ih ampa Harep.
  </para>
  <para style="p">
    <verse number="52" style="v" />Kiriath-Jearim ih ampa Shobal ih caanawk loe, Haroh, ahap Manahath ih kaminawk,
  </para>
  <para style="p">
    <verse number="53" style="v" />Kiriath-Jearim acaengnawk loe, Ithra kaminawk, Put kaminawk, Shumat kaminawk hoi Mishra kaminawk ah oh o; hae kaminawk khae thung hoiah ni Zareat kaminawk hoi Eshtalat kaminawk to tacawt.
  </para>
  <para style="p">
    <verse number="54" style="v" />Salma ih caanawk loe, Bethlehem, Netophat, Atarot, Joab imthung takohnawk, ahap Manahethi kami hoi Zori kaminawk ah oh o.
  </para>
  <para style="p">
    <verse number="55" style="v" />Jabez ah kaom ca tarik acaengnawk, Tirathi kaminawk, Shimeathi kaminawk hoi Sukathi kaminawk to oh o. Hae kaminawk loe Rekab imthung takoh ih ampa Hammath khae hoi angzo Ken kami ah oh o.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hebron ah oh naah David mah sak ih capanawk loe, Jezreel kami Ahinoam mah calu Ammon to sak pae; Karmel tanuh Abigail mah capa hnetto haih Daniel to sak pae;
  </para>
  <para style="p">
    <verse number="2" style="v" />Geshur siangpahrang Talmai canu Maakah capa Absalom loe, thumto haih ah oh moe, Haggith capa Adonijah loe palito haih ah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pangato haih loe, Abital capa Shephatiah; tarukto haih loe a zu Eglah hoiah sak ih Ithream.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hae ih capa taruktonawk loe Hebron ah saning sarih, khrah tarukto uk naah, David mah sak ih capa ah oh o; David mah Jerusalem vangpui to saning quithumto pacoeng, saning thumto thung uk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jerusalem ah sak ih caanawk loe, Shimea, Shobab, Nathan hoi Solomon; hae capa palitonawk loe Ammiel canu Bathshua mah sak pae;
  </para>
  <para style="p">
    <verse number="6" style="v" />nihcae pacoengah, Ibhar, Elishama, Eliphelet,
  </para>
  <para style="p">
    <verse number="7" style="v" />Nogah, Nepheg, Japhia,
  </para>
  <para style="p">
    <verse number="8" style="v" />Elishama, Eliada hoi Eliphelet cae to sak; sangqum boih ah takawtto oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hae kaminawk boih loe David ih capa ah oh o; a zulanawk ih caanawk thui ai ah, nihcae ih tanuh Tamar doeh oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Solomon ih capa loe Rehoboam, Rehoboam ih capa loe Abijah, Abijah ih capa loe Asa, Asa ih capa loe Jehosaphat,
  </para>
  <para style="p">
    <verse number="11" style="v" />Jehosaphat ih capa loe Joram, Joram ih capa loe Ahaziah, Ahaziah ih capa loe Joash,
  </para>
  <para style="p">
    <verse number="12" style="v" />Joash ih capa loe Amaziah, Amaziah ih capa loe Azariah, Azariah ih cap aloe Jotham,
  </para>
  <para style="p">
    <verse number="13" style="v" />Jotham ih capa loe Ahaz, Ahaz ih capa loe Hezekiah, Hezekiah ih capa loe Manasseh,
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh ih capa loe Amon, Amon ih capa loe Josiah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Josiah ih capanawk loe calu Johanan; hnetto haih loe Jehoiakim, thumto haih loe Zedekiah, palito haih loe Shallum.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jehoiakim ih caanawk loe a capa Jekoniah, Jekoniah ih capa loe Zedekiah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Misong ah naeh ih Jekoniah ih capanawk loe Assir, Assir capa Shealtiel,
  </para>
  <para style="p">
    <verse number="18" style="v" />Malkiram, Pedaiah, Shenazzar, Jekamiah, Hoshama hoi Nedabiah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pedaiah ih capanawk loe, Zerubabel hoi Shimei; Zerubabel ih capa hnik loe, Meshullam hoi Hananiah; Shelomith loe nihnik ih tanuh ah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kalah pangatonawk loe Hashubah, Ohel, Berekiah, Hasadiah hoi Jushap-Hesed.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hananiah ih caanawk loe Pelatiah hoi Jeshaiah; Rephaiah ih capa loe Arnan, Arnan ih capa loe Obadiah, Obadiah ih capa Shekaniah cae to athum o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shekaniah ih caanawk loe Shemaiah; Shemaiah ih capanawk loe Hattush, Igeal, Bariah, Neariah hoi Shaphat; sangqum boih ah tarukto oh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Neariah ih capanawk loe Elionai, Hezekiah hoi Azrikam, sangqum boih ah thumto oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Elionai capanawk loe Hodaiah, Eliashib, Pelaiah, Akkub, Johanan, Delaiah hoi Anani; sangqum boih ah sarihto oh o.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah ih caanawk loe Perez, Hezron, Karmi, Hur hoi Shobal.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shobal ih capa Reaiah mah Jahath to sak, Jahath mah Ahumai hoi Lahad to sak. Ha kaminawk loe Zorath ih acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hae kaminawk loe Etam ih caa ah oh o; Jezreel, Ishma hoi Idbash; nihcae tanuh ih ahmin loe Hazelelponi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Penuel mah Gedor to sak, Ezer mah Hushah to sak. Hae kaminawk loe Ephratah ih calu, Bethlehem ampa, Hur ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tekoa ampa Ashur loe zu hnetto lak, Helah hoi Narah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naarah mah Ahuzzam hoi Hepher, Temeni hoi Haahastari to sak pae. Hae kaminawk loe Naarah ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Helah ih caanawk loe Zereth, Jezoar, Ethnan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Koz loe Anub, Zobebah hoi Harum capa Aharhel ih imthung takoh kaminawk to sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jabez loe angmah ih nawkamyanawk pongah pakoeh han krah kami ah oh; anih to palungsethaih hoiah ka tapen pongah, amno mah Jabez, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jabez loe Israel Sithaw khaeah, Aw nang mah tahamhoihaih nang paek moe, ka prae hae nang kaawksak! Palungset khuiqahhaih hoi sethaih thung hoiah ka loih o thai hanah, na ban hoiah pakaa ah, tiah a hang. A hnik ih lok baktih toengah Sithaw mah paek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shuah ih amnawk Kelub mah Mehir to sak; anih loe Ashton ih ampa ah oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eshton mah Beth-Rapha, Paseah, Ir-Nahash ih ampa Tehinah to sak. Hae kaminawk loe Rekah ih kami ah oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kenaz capa hnik loe, Othniel hoi Seraiah; Othniel ih capa hnik loe, Hathath.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meonothai mah Ophrah to sak moe, Seraiah mah Joab to sak, Joab ih caanawk loe bantok sah kop kami ah oh o pongah, Kharashim azawn ah khosak o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jephunneh capa Kaleb ih caanawk loe, Iru, Elah hoi Naam; Elah capa loe, Kenaz.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jehallelel ih capanawk loe Ziph, Ziphah, Tiria hoi Asarel.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ezra ih caanawk loe Jether, Mered, Epher hoi Jalon; Mered zu maeto mah Miriam, Shammai hoi Eshtemoa ih ampa Ishbah to sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />A zu Jehudijah mah Gedor ampa Jered, Soko ampa Heber hoi Zanoah ampa Jekuthiel to sak pae. Hae kaminawk loe Mered mah zu ah lak ih Faro canu Bithiah ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Naham tanuh Hodiah zu ih caanawk loe Garmi acaeng Keilah ampa hoi Maakah acaeng Eshtemoa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shimon caanawk loe Amnon, Rinnah, Ben-Hanan hoi Tilon. Ishi ih caanawk loe Zo-Heth hoi Ben-Zoheth.
  </para>
  <para style="p">
    <verse number="21" style="v" />Judah capa Shelah ih caanawk loe Lekah ampa Er, Mareshah ampa Laadah hoi puu tlangqui pathokhaih bangah toksah Ashbea imthung takohnawk,
  </para>
  <para style="p">
    <verse number="22" style="v" />Jokim, Kozeba ih kaminawk, Moab hoi Jashubi-Lehem ukkung, Joash hoi Saraph cae to ni. Hae ah tarik ih ca loe canghnii hoiah ni oh boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hae kaminawk loe laom sah kaminawk, lawksah kaminawk ah oh o pongah siangpahrang ih toksak hanah anih taengah oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simeon ih caanawk loe Nemuel, Jamin, Jarib, Zerah hoi Shaul.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shallum capa Mibsam, Mibsam capa Mishma,
  </para>
  <para style="p">
    <verse number="26" style="v" />Mishma capa, Hammuel, Hamuel capa Zakur, Zakur capa Shimei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shimei loe capa hatlaitarukto hoi canu tarukto tawnh; toe anih ih amnawk loe caa kapop ah tawn ai, to pongah nihcae acaeng loe Judah acaengnawk zetto om o ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae loe Beer-Sheba, Moladah hoi Hazar-Shual,
  </para>
  <para style="p">
    <verse number="29" style="v" />Bilhah, Ezem, Tolad;
  </para>
  <para style="p">
    <verse number="30" style="v" />Bethuel, Hormah, Ziklag,
  </para>
  <para style="p">
    <verse number="31" style="v" />Beth-Markaboth, Hazar-Susim, Beth-Birei hoi Sharaim ah oh o. Hae kaminawk loe David siangpahrang ah oh nathung, angmacae ih vangpui ah oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nihcae ih vangtanawk loe Etam, Ain, Rimmon, Token hoi Ashan, taih vangpui pangato oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hae vangpuinawk taengah kaom vangtanawk boih loe Baal karoek to athum. Hae kaminawk loe angmacae ohhaih ahmuen ah oh o; angmacae anghumh tathukhaih ah oh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Meshobab, Jamlek, Amaziah capa Josiah,
  </para>
  <para style="p">
    <verse number="35" style="v" />Joel, Jehu loe Joshibiah capa, Joshibiah loe Seraiah capa, Seraiah loe Asiel capa,
  </para>
  <para style="p">
    <verse number="36" style="v" />Elioenai, Jaakobah, Jeshohaiah, Asaiah, Adiel, Jesimiel, Benaiah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Ziza loe Shiphi capa, Shiphi loe Allon capa, Allon loe Jedaiah capa, Jedaiah loe Shimri capa, Shimri loe Shemaiah capa ah oh;
  </para>
  <para style="p">
    <verse number="38" style="v" />ahmin hoi thuih ih hae kaminawk loe angmacae acaeng zaehoikung ah oh o; nihcae ih acaeng loe paroeai pung o.
  </para>
  <para style="p">
    <verse number="39" style="v" />To kaminawk loe tuu pacahhaih ahmuen to pakrong o moe, ni angyae bang ih azawn, Gedor ramri khoek to caeh o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nihcae mah phroh kapop, long kahoih ahmuen, kawk parai ahmuen, monghaih hoi kamding rue ah kaom prae to hnuk o; Ham kaminawk loe to ahmuen ah canghnii hoiah ni oh o boeh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahmin tarik ih kaminawk loe Judah siangpahrang Hezekiah dung naah angzoh o; to ahmuen loe tuu pacah han hoih parai pongah, to ah kaom Ham kaminawk to boh o moe, imnawk to a phraek pae o pacoengah, vaihni ni khoek to to ah khosak o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Simeon kami cumvai pangatonawk loe, Ishi ih caa misatuh angraeng Pelatiah, Neariah, Rephaiah hoi Uzziel cae hoi Seir mae ah caeh o moe,
  </para>
  <para style="p">
    <verse number="43" style="v" />canghniah kaloih Amalek kaminawk to hum o, to ahmuen ah vaihni ni khoek to khosak o.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel calu Reuben ih caanawk, anih loe calu ah oh, toe ampa ih iihkhun to amhnongsak pongah, calu ah ohhaih ahmuen to Israel capa Joeseph ih caanawk hanah paek ving boeh; to pongah acaeng paruihaih loe calu ah ohhaih baktiah tarik o ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Calu ah ohhaih loe Joseph ih qawk ah oh boeh, toe anih ih nawkamya thung hoiah ukkung, thacak koek Judah to tacawt,
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel calu Reuben ih caanawk loe Hanok, Pallu, Hezron hoi Karmi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joel ih caanawk loe Shemaiah capa Gog, Gog capa Shimei,
  </para>
  <para style="p">
    <verse number="5" style="v" />Shimei capa Mikah, Mikah capa Reaiah, Reaiah capa Baal, Baal capa,
  </para>
  <para style="p">
    <verse number="6" style="v" />Beerah, anih loe Assyria siangpahrang Tilgath-Pileser mah misong ah naeh; Beerah loe Reuben kaminawk zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae ih nawkamya Jeiel hoi Zekariah loe acaeng anghumhaih ahmin paruihaih cabu thungah pakuem o;
  </para>
  <para style="p">
    <verse number="8" style="v" />Joel capa Shema, Shema capa Azaz, Azaz capa Bela loe Aroer vangpui, Nebo vangpui hoi Baal-meon vangpui khoek to oh o;
  </para>
  <para style="p">
    <verse number="9" style="v" />Gilead prae ah nihcae mah pacah ih maitawnawk loe paroeai pung pongah, ni angyae bang ih Euphrate vapui hoi praezaek ramri karoek to akun o moe, khosak o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Saul siangpahrang dung ah Hagar ih kaminawk to tuk o moe, nihcae pazawk pongah Hagar kaminawk ohhaih prae Gilead ni angyae bang boih ah khosak o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gad kaminawk loe nihcae taengah khosak o; Bashan prae thung Salekah vangpui khoek to oh o;
  </para>
  <para style="p">
    <verse number="12" style="v" />Joel loe kalen koek ah oh, Shapham loe hnetto haih ah oh, to pacoengah Jaanai hoi Shaphat loe Bashan ah oh hoi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae ih acaengnawk loe Mikael, Meshullam, Sheba, Jorai, Jakan, Zia hoi Eber; sangqum boih ah sarihto oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae kaminawk loe Huri capa Abihail ih caa ah oh o; Huri loe Jaroah capa, Jaroah loe Gilead capa, Gilead loe Mikael capa, Mikael loe Jeshishai capa, Jeshishai loe Jahdo capa, Jahdo loe Buz capa ah oh;
  </para>
  <para style="p">
    <verse number="15" style="v" />Guni ih capa loe Abdiel, Abdiel ih capa Ahi loe nihcae acaeng lu koek ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad kaminawk loe Gilead prae, Bashan prae ih vangtanawk hoi Sharon vangpui karoek to oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hae acaeng anghum paruihaih cabu thung ih ahminnawk boih loe Judah siangpahrang Jotham dung hoi Israel siangpahrang Jeroboam dung naah lak o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Reuben kaminawk, Gad kaminawk hoi ahap Manasseh acaeng thungah misatukhaih aphaw hoi sumsen sin thaih kami, kalii kaat kop kami, misatuk kop kami sing pali, sang pali, cumvai sarih, quitarukto misa angtukhaih ahmuen ah caeh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae mah Hagar, Jetur, Naphish hoi Nodab kaminawk to tuk o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Misa a tuk o naah, Sithaw oephaih hoiah lawk a thuih o pongah, Sithaw mah nihcae to abomh moe, Hagar ih kaminawk hoi a tawnh o ih hmuenmaenawk to nihcae hanah paek boih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hagar kaminawk ih maitawnawk to lak pae o king; tahnongsawk hrang sing panga, tuu sing pumphae, sang quipangato, laa hrang sang hnetto hoi kami doeh sing hato misong ah hoih o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sithaw oephaih hoiah misa a tuk o pongah, kami paroeai duek o. Israel kaminawk misong ah caeh o ai karoek to, Hagar kaminawk ih prae thungah oh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahap Manasseh acaeng loe prae thung ih, Bashan vangpui, Baal-Hermon vangpui, Senir vangpui hoi Hermon mae karoek to oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Epher, Ishi, Eliel, Azriel, Jeremiah, Hodaviah hoi Jahdiel cae loe hae acaengnawk ih lu koek ah oh o, nihcae loe thacak kami, ahmin doeh kamthang misatuh kami ah oh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nihcae loe angmacae ampanawk ih Sithaw hmaa ah zaehaih to sak o moe, nihcae hmaa ah Sithaw mah paro pae ih, to prae ah kaom kaminawk ih sithaw hoiah zaehaih a sak o.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pongah Israel Sithaw mah Assyria siangpahrang Pul hoi siangpahrang Tiglath-Pileser ih muithla to pahruek pae moe, Reuben kaminawk, Gad kaminawk hoi ahap Manasseh acaengnawk to tamna ah caeh haih; anih mah nihcae to Gozan vapui taeng ih Halah, Habor, Hara vangpui ah caeh o haih tathuk, nihcae loe to ahmuen ah vaihni ni khoek to oh o.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levi acaengnawk loe Gershon, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kohath ih caanawk loe Amram, Izhar, Hebron hoi Uzziel.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amram ih caanawk loe Aaron, Mosi hoi Miriam. Aaron ih caanawk loe Nadab, Abihu, Eleazar hoi Ithamar.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eleazar mah Phinehas to sak moe, Phinehas mah Abishua to sak,
  </para>
  <para style="p">
    <verse number="5" style="v" />Abishua mah Bukki to sak moe, Bukki mah Uzzi to sak,
  </para>
  <para style="p">
    <verse number="6" style="v" />Uzzi mah Zerahiah to sak moe, Zerahiah mah Meraioth to sak,
  </para>
  <para style="p">
    <verse number="7" style="v" />Meraioth mah Amariah to sak moe, Amariah mah Ahitub to sak,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahitub mah Zadok to sak moe, Zadok mah Ahimaaz to sak,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahimaaz mah Azariah to sak moe, Azariah mah Johanan to sak,
  </para>
  <para style="p">
    <verse number="10" style="v" />Johanan mah Azariah to sak; anih loe Solomon mah sak ih Jerusalem tempul thungah toksahkung qaima ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Azariah mah Amariah to sak moe, Amaziah mah Ahitub to sak,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahitub mah Zadok to sak moe, Zadok mah Shallum to sak,
  </para>
  <para style="p">
    <verse number="13" style="v" />Shallum mah Hilkiah to sak moe, Hilkiah mah Azariah to sak,
  </para>
  <para style="p">
    <verse number="14" style="v" />Azariah mah Seraiah to sak moe, Seraiah mah Jehozadak to sak,
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng mah Nebuchdnezzar ban hoiah Judah hoi Jerusalem to misong ah caehsak naah Jehozadak doeh athum toeng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Levi ih caanawk loe Gershom, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gershom capa hnik ih ahmin loe Libni hoi Shimei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath ih caanawk loe Amram, Izhar, Hebron hoi Uzziel.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari ih capa hnik loe Mahli hoi Mushi. Hae kaminawk hae Levi acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gershom ih caanawk loe Libni, Jehath hoi Zimmah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Zimmah ih capa loe Joah; anih ih capa loe Iddo; anih ih capa loe Zerah; anih ih capa loe Jeaterai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kohath ih capa loe Aminadab; anih ih capa loe Kohath; anih ih capa loe Assir,
  </para>
  <para style="p">
    <verse number="23" style="v" />anih ih capa loe Elkanah; anih ih capa loe Ebiasaph, anih ih capa loe Assir,
  </para>
  <para style="p">
    <verse number="24" style="v" />anih ih capa loe Tahath; anih ih capa loe Uriel; anih ih capa loe Uzziah; anih ih capa loe Shaul;
  </para>
  <para style="p">
    <verse number="25" style="v" />anih ih capa Elkanah; anih ih capa hnik loe Amasai hoi Ahimoth,
  </para>
  <para style="p">
    <verse number="26" style="v" />Alkanah hanah, Alkanah ih capa loe Zophai; anih ih capa loe Nahath,
  </para>
  <para style="p">
    <verse number="27" style="v" />anih ih capa Eliab; anih ih capa loe Jehoram; anih ih capa loe Elkanah;
  </para>
  <para style="p">
    <verse number="28" style="v" />Samuel ih capa loe calu Vashni hoi hnetto haih capa Abijah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari ih capa loe Mahli; anih ih capa loe Libni; anih ih capa loe Shimei; anih ih capa loe Uzziah,
  </para>
  <para style="p">
    <verse number="30" style="v" />anih ih capa loe Shimea; anih ih capa loe Haggiah; anih ih capa loe Asaiah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sithaw ih thingkhong to suek pacoengah, Angraeng imthung ah laasah kami ah hae kaminawk hae David mah suek.
  </para>
  <para style="p">
    <verse number="32" style="v" />To kaminawk loe kahni im hmaa hoi kami amkhuenghaih im hmaa ah, Solomon mah Jerusalem ah Angraeng ih im sak nathung, laasakhaih tok to a sak o; im sak pacoengah loe nihcae mah sak koi paek ih tok to sak hanah zing o.
  </para>
  <para style="p">
    <verse number="33" style="v" />To tiah toksak hanah a caanawk hoi nawnto kazing hae kaminawk loe, Kohath acaeng thung hoiah Samuel capa Joel, Joel capa laasah kop Heman,
  </para>
  <para style="p">
    <verse number="34" style="v" />Samuel loe Elkanah ih capa, Elkanah loe Jeroham ih capa, Jeroham loe Eliel ih capa, Eliel loe Toah ih capa,
  </para>
  <para style="p">
    <verse number="35" style="v" />Toah loe Zuph ih capa, Zuph loe Elkanah ih capa, Elkanah loe Mahath ih capa, Mahath loe Amasai ih capa,
  </para>
  <para style="p">
    <verse number="36" style="v" />Amasai loe Elkanah ih capa, Elkanah loe Joel ih capa, Joel loe Azariah ih capa, Azariah loe Zephaniah ih capa,
  </para>
  <para style="p">
    <verse number="37" style="v" />Zephaniah loe Tahath ih capa, Tahath loe Assir ih capa, Assir loe Ebiasaph ih capa, Ebiasaph loe Korah ih capa,
  </para>
  <para style="p">
    <verse number="38" style="v" />Korah loe Izhar ih capa, Izhar loe Kohath ih capa, Kohath loe Levi ih capa, Levi loe Israel ih capa ah oh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Heman bomkung Asaph loe anih ih bantang bangah angdoet; Asaph loe Berakiah capa ah oh; Berekiah loe Shimea ih capa,
  </para>
  <para style="p">
    <verse number="40" style="v" />Shimea loe Mikael ih capa, Mikael loe Baaseiah ih capa, Baaseiah loe Malkiah ih capa,
  </para>
  <para style="p">
    <verse number="41" style="v" />Malkiah loe Ethni ih capa, Ethni loe Zerah ih capa, Zerah loe Adaiah ih capa,
  </para>
  <para style="p">
    <verse number="42" style="v" />Adaiah loe Ethan ih capa, Ethan loe Zimmah ih capa, Zimmah loe Shimei ih capa,
  </para>
  <para style="p">
    <verse number="43" style="v" />Shimei loe Jahath ih capa, Jahath loe Gershom ih capa; Gershom loe Levi ih capa ah oh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nihnik bomkung Merari capanawk loe banqoi bangah angdoet o; Ethan loe Kishi ih capa, Kishi loe Abdi ih capa, Abdi loe Malluk ih capa,
  </para>
  <para style="p">
    <verse number="45" style="v" />Malluk loe Hashabiah ih capa, Hashabiah loe Amaziah ih capa, Amaziah loe Hilkiah ih capa,
  </para>
  <para style="p">
    <verse number="46" style="v" />Hilkiah loe Amzi ih capa, Amzi loe Bani ih capa, Bani loe Shemer ih capa,
  </para>
  <para style="p">
    <verse number="47" style="v" />Shemer loe Mahli ih capa, Mahli loe Mushi ih capa, Mushi loe Merari ih capa, Merari loe Levi ih capa ah oh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Nihcae ih nawkamya Levinawk doeh Sithaw imthung ih kahni im ah tok congca sak hanah paek o.
  </para>
  <para style="p">
    <verse number="49" style="v" />Toe Aaron hoi anih ih caanawk loe, hmaicam pongah angbawnhaih paek moe, hmaicam ah hmuihoih thlaek pacoengah, hmuenciim koek ahmuen ah tok congca sak hanah, Sithaw ih tamna Mosi lokpaekhaih baktih toengah, Israel kaminawk mah zaehaih thung hoi loih o thai hanah, angbawnhaih sah kami ah oh o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hae kaminawk loe Aaron ih caa ah oh o; Aaron capa loe Eleazar, Eleazar capa loe Phinehas, Phinehas capa loe Abishua, Abishua capa loe Bukki,
  </para>
  <para style="p">
    <verse number="51" style="v" />Bukki capa loe Uzzi, Uzzi capa loe Zerahiah,
  </para>
  <para style="p">
    <verse number="52" style="v" />Zerahiah capa loe Meraioth, Meraioth capa loe Amariah, Amaziah capa loe Ahitub,
  </para>
  <para style="p">
    <verse number="53" style="v" />Ahitub capa loe Zadok, Zadok capa loe Ahimaaz.
  </para>
  <para style="p">
    <verse number="54" style="v" />Aaron ih caa Kohath ih acaengnawk mah taham khethaih phoisa vahhaih hoiah nihcae mah hak o ih nihcae ohhaih ahmuen loe,
  </para>
  <para style="p">
    <verse number="55" style="v" />Judah prae thungah Hebron hoi a taengah kaom ahmuennawk to athum boih.
  </para>
  <para style="p">
    <verse number="56" style="v" />Toe lawknawk hoi vangpui taeng ih vangtanawk loe Jephunneh capa Kaleb hanah paek o.
  </para>
  <para style="p">
    <verse number="57" style="v" />Aaron caanawk hanah loe anghawkhaih vangpui, Hebron; Judah prae thung ih Libnah vangpui hoi a taeng ih ahmuen, Jattir hoi Eshtemoa vangpui hoi a taeng ih ahmuen,
  </para>
  <para style="p">
    <verse number="58" style="v" />Holon vangpui hoi a taeng ih ahmuen, Debir vangpui hoi a taeng ih ahmuen,
  </para>
  <para style="p">
    <verse number="59" style="v" />Ashan vangpui hoi a taeng ih ahmuen, Berth-Shemesh vangpui hoi a taeng ih ahmuen to paek o;
  </para>
  <para style="p">
    <verse number="60" style="v" />Benjamin acaeng khae hoiah Geba vangpui hoi a taeng ih ahmuen, Alemeth vangpui hoi a taeng ih ahmuen, Anathoth vangpui hoi a taeng ih ahmuen to a paek. Angmace ih acaengnawk mah paek ih vangpuinawk loe sangqum boih ah hatlaithumto oh.
  </para>
  <para style="p">
    <verse number="61" style="v" />Kanghmat Kohath ih caanawk loe taham khethaih phoisa vah pacoengah, ahap Manasseh acaeng thung ih vangpui hato a hak o.
  </para>
  <para style="p">
    <verse number="62" style="v" />Gershom ih caanawk loe, angmacae ih acaeng Issakar, Asher, Naphtali, Bashan prae thungah kaom Manasseh khae hoiah vangpui hatlaithumto hak o.
  </para>
  <para style="p">
    <verse number="63" style="v" />Merari caanawk loe, taham khethaih phoisa vahhaih rang hoiah angmacae ih acaeng Reuben, Gad hoi Zebulun khae hoiah vangpui hatlaihnetto hak o.
  </para>
  <para style="p">
    <verse number="64" style="v" />Israel kaminawk mah Levi kaminawk hanah hae vangpuinawk hoi a taeng ih ahmuennawk to hak o.
  </para>
  <para style="p">
    <verse number="65" style="v" />Taham khethaih phoisa vahhaih hoiah Judah, Simeon hoi Benjamin acaeng khae hoiah ranui ah thuih tangcae ih vangpuinawk to hak o.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kanghmat Kohath acaengnawk loe, Ephraim acaengnawk khae hoiah prae to hak o.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Issakar ih capanawk loe Tola, Puah, Jashub hoi Shimron, sangqum boih ah palito oh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tola ih caanawk loe Uzzi, Rephaiah, Jeriel, Jahmai, Jibsam hoi Samuel; nihcae loe imthung takoh zaehoikung ah oh o; David dung naah misatuh Tola ih caanawk loe sangqum boih ah kami sing hnet, sang hnet, cumvai tarukto oh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uzzi ih caanawk loe Izrahiah; Izrahiah ih caanawk loe, Mikael, Obadiah, Joel hoi Ishiah; nihcae loe zaehoikung lu koek ah oh o moe, sangqum boih ah pangato oh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae acaeng loe imthong kami pop o parai pongah, misatuh kop kami sing thum, sang tarukto oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Issakar acaeng thungah misatuh thaih kami, acaeng paruihaih cabu thungah kathum kami sing tazet, sang sarihto oh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benjamin ih capa thumtonawk loe Bela, Beker hoi Jediael.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bela ih caanawk loe Ezbon, Uzzi, Uzziel, Jerimoth hoi Iri; nihcae loe imthung takoh lu koek ah oh o moe, sangqum boih ah pangato oh o; acaeng anghumhaih cabu thungah pakuem ih baktih toengah, misatuh thaih kami sang pumphae hnet, quithumto pacoeng, palito oh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Beker ih caanawk loe Zemira, Joash, Eliezer, Elioenai, Omri, Jerimoth, Abiah, Anathoth hoi Alemeth. Hae kaminawk boih loe Beker ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae boih loe acaeng paruihaih cabu thungah pakuem o, nihcae loe acaeng zaehoikung lu koek ah kaom, misatuh thaih kami sang pumphae, cumvai hnetto oh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jediael ih capanawk loe Bilhan; Bilhan ih caanawk loe, Jeush, Benjamin, Ehud, Khenaanah, Zethan, Tharshish hoi Ahishahar.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hae ih Jediael caanawk loe acaeng zaehoikung lu koek ah oh o moe, misatuh thaih kami sang hatlai sarih, cumvai hnetto oh o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shuppin hoi Huppim loe Ir ih caa ah oh moe, Hushim loe Aher ih caa ah oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naphtali acaeng Bilhah ih caanawk loe Jahziel, Guni, Jezer hoi Shallum.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh ih caanawk loe Ashriel; (toe Aramite kami zula mah Gilead ampa Makir to sak pae:
  </para>
  <para style="p">
    <verse number="15" style="v" />Makir mah Huppin hoi Shushim ih tanuh to zu ah lak, anih ih ahmin loe Maakah;) hnetto haih capa loe Zelophehad, tiah ahmin sak; Zelophehad loe canunawk to tawnh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Makir ih zu Maakah loe capa maeto sak moe, Peresh, tiah ahmin phui; anih amnawk ih ahmin loe Sheresh; anih ih capa hnik loe Ulam hoi Rakem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ulam ih caanawk loe Bedan. Manasseh ih capa loe Makir, Makir ih capa Gilead acaeng ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih ih tanuh Hammoleketh mah Ishod, Abiezer hoi Mahalah to sak pae.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shemidah ih caanawk loe Ahian, Shekem, Likhi hoi Aniam.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim ih caanawk loe Shuthelah; anih ih capa loe Bered; anih ih capa loe Tahath; anih ih capa loe Eladah; anih ih capa loe Tahath,
  </para>
  <para style="p">
    <verse number="21" style="v" />anih ih capa loe Zabad; anih ih capa loe Shuthelah, anih capa loe Ezer hoi Elead; nihnik loe to prae kaminawk ih maitaw naeh hanah caeh hoi naah, to prae ah tapen Gad kaminawk mah hum o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anih ih ampa Ephraim loe atue kasawkah palungset pongah, anih pathloep hanah angmah ih canawk angzoh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anih loe a zu khae iih, a zu loe zokpomh moe, caa nongpa to sak; a imthung takoh mah tahamsethaih to tongh pongah, a capa to Beriah, tiah ahmin phui.
  </para>
  <para style="p">
    <verse number="24" style="v" />A canu ih ahmin loe Sheerah; anih loe aluek bang ih Beth-Horon vangpui hoi aloih bang ih Uzzen-Sheresh vangpui khenzawnkung ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anih ih capa loe Rephah, anih ih capa loe Telah, anih ih capa loe Tehan,
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih ih capa loe Ladan, anih ih capa loe Ammihud, anih ih capa loe Elishama,
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih ih capa loe Nun, anih ih capa loe Joshua.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae ohhaih ahmuen loe Bethel vangpui hoi a taeng ih ahmuennawk; ni angyae bangah Naaran vangpui, niduem bangah Gezer vangpui hoi a taeng ih ahmuennawk, Shekem vangpui hoi a taeng ih ahmuennawk, Gaza vangpui hoi a taeng ih ahmuennawk to athum boih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh ramri ah kaom Beth-Shan vangpui taeng ih ahmuennawk, Taanak vangpui hoi a taeng ih ahmuennawk, Megiddo vangpui hoi a taeng ih ahmuennawk, Dor vangpui hoi a taeng ih ahmuennawk to athum boih. Israel capa Joseph ih caanawk loe hae vangpui hoi a taeng ih vangnawk ah khosak o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Asher ih caanawk loe Imnah, Isuah, Ishuai, Beriah hoi nihcae ih tanuh Serah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Beriah capa hnik loe, Heber hoi Birzavith ampa Malkiel.
  </para>
  <para style="p">
    <verse number="32" style="v" />Heber mah Japhlet, Shomer, Hotham hoi nihnik ih tanuh Shua to sak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Japhlet ih caanawk loe Pasak, Bimhal hoi Ashvath. Hae kaminawk loe Japhlet ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shamer ih caanawk loe Ahi, Rohgah, Jehubbath hoi Aram.
  </para>
  <para style="p">
    <verse number="35" style="v" />Anih amnawk Helem ih caanawk loe Zophah, Imna, Shelesh hoi Amal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zophah ih caanawk loe Suah, Harnepher, Shual, Beri, Imrah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Bezer, Hod, Shamma, Shilshah, Ithran hoi Beera.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jether ih caanawk loe Jephunneh, Pispah hoi Ara.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ulla ih caanawk loe Arah, Hanniel hoi Rezia.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hae kaminawk loe Asher ih caa ah oh o boih moe, acaeng zaehoikung lu koek ah oh o; qoih ih kami, thacak ukkung angraeng ah oh o; nihcae loe misatuh thaih acaeng pakuemhaih cabu thungah pakuem ih kami ah oh o; sangqum boih ah kami sing hnet, sang tarukto oh o.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Benjamin mah calu Bela, hnetto haih ah Ashbel, thumto haih ah Aharah to sak,
  </para>
  <para style="p">
    <verse number="2" style="v" />palito haih ah Nohah to sak moe, pangato haih ah Rapha to sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bela ih caanawk loe Addar, Gera hoi Abihud,
  </para>
  <para style="p">
    <verse number="4" style="v" />Abishua, Naaman, Ahoah,
  </para>
  <para style="p">
    <verse number="5" style="v" />Gera, Shephuphan hoi Huram.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hae kaminawk loe Maharath vangpui ah kangpuen, Geba vangpui ah kaom acaeng zaehoikung lu koek, Ehud ih caa ah oh o,
  </para>
  <para style="p">
    <verse number="7" style="v" />nihcae loe Naaman, Ahiah hoi Gera; ohhaih ahmuen angpuen pacoengah, Uzza hoi Ahihud to sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaharaim loe a zu Hushim hoi Baara to pahnong sut pacoengah, Moab prae ah capanawk to sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />A zu Hodest mah Jobab, Zibia, Mesha, Malkam,
  </para>
  <para style="p">
    <verse number="10" style="v" />Jeuz, Shakia hoi Mirma to sak pae. Hae kaminawk loe a capa ah oh o moe, acaeng zaehoikung lu koek ah oh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hushim mah Abitub hoi Elpaal to sak pae.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elpaal ih caanawk loe Eber, Misham, Shamed, anih mah Ono hoi Lod vangpui to sak pacoengah, a taeng ih avangnawk to sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Beriah hoi Shema doeh Aijalon ah acaeng zaehoikung lu koek ah oh hoi moe, Gad ah kaom kami haekkung ah oh hoi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahio, Shashak, Jeremoth,
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebadiah, Arad, Eder,
  </para>
  <para style="p">
    <verse number="16" style="v" />Mikael, Ispah hoi Joha loe Beriah ih capa ah oh;
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebadiah, Meshullam, Hezeki, Heber,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ishmerai, Jezliah hoi Jobab loe Elpaal ih caa ah oh;
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakim, Zikri, Zabdi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Elienai, Zilthai, Eliel,
  </para>
  <para style="p">
    <verse number="21" style="v" />Adaiah, Beraiah hoi Shimrath loe Shimhi ih caa ah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ishpan, Heber, Eliel,
  </para>
  <para style="p">
    <verse number="23" style="v" />Abdon, Zikri, Hanan,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hananiah, Elam, Antothijah,
  </para>
  <para style="p">
    <verse number="25" style="v" />Iphedeiah hoi Penuel loe Shashak ih caa ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shamsherai, Shehariah, Athaliah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Jareshiah, Eliah hoi Zikri loe Jehoram ih caa ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae kaminawk boih loe acaeng zaehoikung lu koek hoi acaeng paruihaih cabu thungah kathum kami ah oh o. Hae kaminawk loe Jerusalem ah oh o boih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gibeon ih ampa loe Gibeon vangpui ah khosak; anih zu ih ahmin loe Maakah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anih ih calu loe Abdon; anih pacoengah Zur, Kish, Baal, Ner, Nadab,
  </para>
  <para style="p">
    <verse number="31" style="v" />Gedor, Ahio, Zeker to sak.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mikloth mah Shimeah to sak. Hae kaminawk loe Jerusalem ah a caanawk khaeah oh o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ner mah Kish to sak, Kish mah Saul to sak, Saul mah Jonathan to sak, Jonathan mah Malkishua to sak, Malkishua mah Abinadab hoi Esh-Baal to sak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jonathan ih caanawk loe Merib-Baal, anih mah Mikah to sak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mikah ih caanawk loe Pithon, Melek, Tarea hoi Ahaz.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahaz mah Jehoadah to sak; Jehoadah mah Alemeth, Azmaveth hoi Zimri to sak; Zimri mah Moza to sak.
  </para>
  <para style="p">
    <verse number="37" style="v" />Moza mah Binea to sak; Binea mah Raphah to sak, Rapha mah Eleasah to sak, Eleasah mah Azel to sak.
  </para>
  <para style="p">
    <verse number="38" style="v" />Azel loe capa tarukto tawnh; nihcae ih ahmin loe Azrikam, Bokeru, Ishmael, Sheariah, Obadiah hoi Hanan. Hae kaminawk boih loe Azel ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Anih ih amnawk Eshek ih caanawk loe calu Ulam, hnetto haih ah Jeush, thumto haih ah Eliphelet.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ulam ih capanawk loe thacak misatuh kami ah oh o moe, kalii kaah kop kami ah oh o; nihcae loe ca paroeai tawnh o, anih ih caa patoeng loe kami paroeai pop o; sangqum boih ah cumvai quipangato oh o. Hae kaminawk loe Benjamin ih caa ah oh o boih.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khenah, Israel kaminawk loe acaeng pakuemhaih cabu thungah pakuem o; Israel hoi Judah kaminawk loe angmacae zaehaih pongah Babylon prae ah misong ah laemh o, to kawng to Israel hoi Judah siangpahrangnawk ih cabu thungah tarik o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel rangpuinawk, qaimanawk, Levi acaengnawk hoi Nethinim kaminawk loe angmacae ih vangpui thungah hmaloe koek kaom kami ah oh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem ah kaom Judah, Benjamin, Ephraim hoi Manasseh kaminawk loe,
  </para>
  <para style="p">
    <verse number="4" style="v" />Judah acaeng Perez ih caanawk, Bani, anih ih capa Imri, anih ih capa Omri, anih ih capa Ammihud, anih ih capa Uthai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shilon ih acaeng thung hoiah a calu Asaiah hoi anih ih caanawk to oh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerah ih acaeng thung hoiah Jeul hoi anih ih nawkamyanawk cumvai taruk, quitakawtto oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Benjamin acaeng thung hoiah Hassenuah capa Hodaviah, anih ih capa Meshullam, anih ih capa Sallu,
  </para>
  <para style="p">
    <verse number="8" style="v" />Jeroham capa Ibneiah, Mikri capa Uzzi, anih ih capa Elah, Ibnijah capa Reuel, anih ih capa Shephatiah, anih ih capa Meshullam,
  </para>
  <para style="p">
    <verse number="9" style="v" />acaeng paruihaih cabu thungah tarik ih baktih toengah, nawkamya sangqum boih ah cumvai takawt, quipanga, tarukto oh o. Hae kaminawk loe acaeng zaehoikung lu koek ah oh o boih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Qaimanawk thung hoiah Jedaiah, Jehoiarib, Jakin,
  </para>
  <para style="p">
    <verse number="11" style="v" />Sithaw im khenzawnkung Ahitub capa Meraioth, Meraioth capa Zadok, Zadok capa Meshullam, Meshullam capa Hilkiah, Hilkiah capa Azariah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Immer capa Meshillemith, Meshillemith capa Jahzerah, Jahzerah capa Adiel, Adiel capa Maasai, Maasai capa Malkijah, Malkijah capa Pashur, Pashur capa Jeroham, Jeroham capa Adaiah;
  </para>
  <para style="p">
    <verse number="13" style="v" />acaeng zaehoikung lu koek ah kaom kaminawk loe, sangqum boih ah, sang cumvai sarih, quitarukto oh o; hae kaminawk loe Sithaw im toksah thaih kami ah oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Levi acaengnawk thung hoiah Merari acaeng Hashabiah capa Azrikam, Azrikam capa Hasshub, Hasshub capa Shemaiah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Bakbakkar, Heresh, Galal hoi Asaph capa Zikri, Zikri capa Mika, Mika capa Mattaniah;
  </para>
  <para style="p">
    <verse number="16" style="v" />Jethun capa Galal, anih ih capa Shemaiah, anih ih capa Obadiah; Netophath vangpuinawk ah kaom Elkanah capa Asa, anih ih capa Berekiah cae to oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sipae khongkha toep kaminawk loe Shallum, Akkub, Talmon, Ahiman hoi anih ih nawkamyanawk; Shallum loe nihcae zaehoikung lu koek ah oh;
  </para>
  <para style="p">
    <verse number="18" style="v" />Shallum loe siangpahrang akunhaih ni angyae bang ih khongkha to toep moe, vaihi khoek to khongkha toepkung ah oh; hae kaminawk loe Levi acaeng thungah kaom khongkha toep kami ah oh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Korah capa Ebiasaph; Kore capa Shallum hoi anih ih nawkamyanawk loe thok toephaih tok to sak o, kahni im thungah akunhaih thok to a toep o; nihcae ih ampanawk loe Angraeng ohhaih im khongkha toepkung ah oh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Eleazar capa Phinehas loe canghniah khongkha toepkung ah oh; anih loe Angraeng mah oh thuih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meshelemiah capa Zekariah loe kami amkhuenghaih kahni im akunhaih thok toepkung ah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khongkha toep hanah qoih ih kaminawk loe sangqum boih ah cumvai hnetto pacoengah, hatlaihnetto oh o. Hae kaminawk loe angmacae ohhaih avangnawk ah acaeng paruihaih cabu thungah pakuem o; David hoi tahmaa Samuel mah oep pongah nihcae to khongkha toepkung ah suek o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nihcae loe angmacae ih caanawk khoek to Angraeng khongkha hoi kahni im toepkung ah oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sipae khongkha loe palito oh; ni angyae, niduem, aluek hoi aloih bangah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vangta ah kaom nihcae ih nawkamyanawk doeh atue tue naah angzoh o moe, ni sarihto thung toksak abomh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Levinawk thungah khongkha toep palitonawk loe, paek ih tok baktih toengah, Angraeng imthung hoi phoisa suekhaih ahmuen khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae loe akhawnbang kruek khongkha to paongh o pongah, Sithaw im hoi kazoi ah oh o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thoemto kaminawk loe im thung ih laom sabaenawk pakuemkung ah oh o; athung ah akunhaih laom sabae hoi tasa bang tacawthaih laom sabaenawk to kroek o boih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thoemto kaminawk doeh hmuenciim thung ih hmuennawk hoi laom sabaenawk, takaw dip, misurtui, situi, hmai thlaek koi hmuihoih hoi kalah hmuihoih congcanawk khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe thoemto qaima ih caanawk loe hmuihoih tui to sak o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Levi kami Korah acaeng Shallum ih calu Mettihiah loe, angbawnhaih takaw hmai pahaikung ah oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Korah acaeng thoemto nawkamyanawk loe, Sabbath ni kruekah caboi nuiah suek ih takaw to naep.
  </para>
  <para style="p">
    <verse number="33" style="v" />Laasah kami Levi acaeng zaehoikung lu koeknawk loe, angmacae ih tok to aqum athun sak o pongah, tempul thungah oh o sak, tok kalah sah o sak ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Levi acaeng zaehoikung lu koeknawk loe, adung thung boih ah zaehoikung ah oh o moe, Jerusalem ah khosak o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Gibeon ampa loe Gibeon vangpui ah oh; anih zu ih ahmin loe Maakah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anih ih calu loe Abdon, anih pacoengah loe Zur, Kish, Baal, Ner, Nadab,
  </para>
  <para style="p">
    <verse number="37" style="v" />Gedor, Ahio, Zekariah hoi Mikloth cae to oh o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mikloth mah Shimeam to sak, nihnik doeh angmacae ih nawkamyanawk taengah Jerusalem ah oh o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ner mah Kish to sak; Kish mah Saul to sak, Saul mah Jonathan, Malki-Shua, Abinadab hoi Esh-Baal to sak.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jonathan mah Merib-Baal to sak, Merib-baal mah Mikah to sak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mikah ih caanawk loe Pithon, Melek, Tahrea hoiahaz.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahaz mah Jarah to sak; Jarah mah Alemeth, Azmaveth hoi Zimri to sak; Zimri mah Moza to sak;
  </para>
  <para style="p">
    <verse number="43" style="v" />Moza mah Binea to sak, Binea mah Rephaiah to sak, Rephaiah mah Eleasah to sak, Eleasah mah Azel to sak.
  </para>
  <para style="p">
    <verse number="44" style="v" />Azel loe ca tarukto sak, ahmin loe Azrikam, Bokeru, Ishmael, Sheariah, Obadiah hoi Hanan. Hae kaminawk loe Azel ih caa ah oh o.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Philistin kaminawk mah Israel caanawk to tuk o; Israel caanawk loe nihcae hmaa ah cawnh o moe, Gilboa mae nuiah kami paroeai duek o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Philistinnawk loe Saul hoi anih ih capanawk to patom o moe, Saul ih capa Jonathan, Abinadab hoi Malki-Shua to hum pae o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Saul to kanung aep ah tuk o, kalii kaat kop kaminawk mah Saul to kah o moe, ahmaa caak o sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Saul mah angmah ih maiphawmaica sinkung khaeah, Na sumsen to aphongh loe na thun ah; to tih ai nahaeloe tangzat hin aat ai kaminawk mah kai hae na pacaekthlaek o tih, tiah a naa. Toe anih ih maiphawmaica sin kami loe zit pongah, anih to thun ai. To pongah Saul mah angmah ih sumsen to lak moe, a sumsen pongah angthunh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Saul loe duek boeh, tiah maiphaw sin kami mah hnuk naah, anih doeh angmah ih sumsen hoiah angthunh moe, duek toeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Saul loe angmah ih imthung takoh ah kaom, a capa thumtonawk hoi nawnto duek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Azawn ah kaom Israelnawk mah, nihcae ih misatuh kaminawk loe cawnh o ving boeh, Saul hoi anih ih caanawk doeh duek o boeh ti, tiah panoek o naah, avang to cawnh o taak boih; to pacoengah Philistinnawk angzoh o moe, avang ah khosak o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khawnbangah loe Philistinnawk mah kadueh kaminawk ih khukbuen to khring hanah angzoh o, to naah Gilboa mae ah kadueh Saul hoi anih ih capanawk to hnuk o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nihcae mah Saul ih khukbuen to khringh pae o, anih ih lu hoi maiphaw to a lak o moe, angmacae kaminawk hoi sakcop ih krangnawk khaeah tamthang thuih o hanah, Philistin prae boih ah kami to patoeh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih ih maiphaw to angmacae sithawnawk suekhaih im ah a suek o; anih ih lu to Dagon tempul thungah bangh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Philistinawk mah Saul nuiah sak o ih hmuen boih to Gilead prae Jabesh vangpui ah kaom kaminawk mah thaih o naah,
  </para>
  <para style="p">
    <verse number="12" style="v" />misahoih kaminawk boih caeh o moe, Saul hoi anih capanawk ih qok to lak o pacoengah, Jabesh ah amlaem o haih; nihcae ih ahuhnawk to Jabesh avang ih Oak thing tlim ah aphum o, nihcae mah ni sarihto thung buhzah o haih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Saul loe Angraeng ih lok tahngai ai, Angraeng hmaa ah zaehaih to sak moe, Angraeng khaeah hni ai ah, taqawk oephaih hoiah pakhra kawk thaih kaminawk khaeah lokdueng lat pongah,
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng mah anih to paduek moe, Jesse capa David khaeah prae to paek ving.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel kaminawk loe David khaeah Hebron ah angzoh o boih moe, kaicae loe nang ih ahuh hoi athii angan ah ni ka oh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Canghniah Saul siangpahrang ah oh naah mataeng doeh, nangmah ni Israel kaminawk to na zaeh; to naah na Angraeng Sithaw mah nang khaeah, Kai ih kami Israelnawk hae na pacah ueloe, kai ih kami Israelnawk ukkung ah na om tih, tiah ang thuih boeh, tiah a thuih pae o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel kacoehtanawk David khaeah Hebron ah angzoh o boih pacoengah, David mah Hebron ah nihcae hoi Angraeng hmaa ah lokmaihaih to sak; to pacoengah Angraeng mah Samuel khaeah suek ih lok baktih toengah, David to Israel siangpahrang ah suek o.
  </para>
  <para style="p">
    <verse number="4" style="v" />David hoi Israelnawk boih Jerusalem (Jebus) ah caeh o; to ahmuen ah kaom kaminawk loe Jebus kami ah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jebus ah kaom kaminawk mah David khaeah, Hae thungah na kun thai mak ai, tiah a naa o; toe David mah David ih vangpui, tiah kawk ih, Zion ih misa abuephaih kacak parai sipae to lak.
  </para>
  <para style="p">
    <verse number="6" style="v" />David mah, Kamianwk khaeah Jebus kaminawk tuh hmaloe kami loe, misatuh angraeng ah om tih, tiah a naa. Zeruiah capa Joab loe hmaloe ah angthawk moe, a caeh, to pongah anih loe misatuh angraeng ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />David mah misa abuephaih sipae kaom ahmuen to a ohhaih ahmuen ah sak pongah, David ih vangpui, tiah kawk o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih mah Millo, tiah kawk ih ahmuen hoi a taeng boih ah vangpui to sak; kalah vangpuinawk loe Joab mah sak pakhraih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Misatuh kaminawk ih Angraeng mah oh haih pongah, David loe len aep aep.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel kaminawk khaeah Angraeng mah thuih ih lok baktih toengah, David to siangpahrang ah suek hanah, prae thungah kaom thacak ukkungnawk hoi Israel kaminawk boih mah anih to thapaek o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hae kaminawk loe David ih thacak kami ah oh o; Hakmon acaeng, Jashobeam loe misatuh angraengnawk ukkung ah oh; anih loe tayae hoiah misa cumvai thumtonawk to vaito ah hum boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih pacoengah Ahoah acaeng, Dodo capa Eleazar doeh thacak kami thumto thungah athum toeng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Philistinnawk loe misatuk hanah barli cang patithaih lawk hmuen ah amkhueng o, to naah Eleazar loe David hoi nawnto Pas-Dammim ah oh; Israel caanawk loe Philistinnawk hmaa hoiah cawn o king.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe nihcae loe lawk um ah anghawk o moe, Philitinnawk to a hum o, Angraeng mah nihcae to pahlong moe, loihaih to paek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Misatuh angraeng quithumto thung ih thumtonawk loe, David ohhaih thlungkhaw, Adullam ah caeh o tathuk; Philistinnawk loe Rephaim azawn ah atai o.
  </para>
  <para style="p">
    <verse number="16" style="v" />David loe kacak misa abuephaih im ah oh, Philistin misatuh kaminawk loe Bethlehem ah oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />David mah tui anghaeh naah, Aw, mi mah maw Bethlehem khongkha taeng ih tuibap tui to na thak tih? tiah thuih.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah to ah kaom kami thumtonawk mah Philistinnawk to muk o moe, Bethlehem khongkha taeng ih tuibap tui to dok o moe, David khaeah sin pae o; toe David mah nae pae ai; Angraeng hmaa ah a kraih pae ving,
  </para>
  <para style="p">
    <verse number="19" style="v" />hae tui ka naek hanah, Sithaw mah ang pakaa: angmacae hinghaih mataeng doeh paawt ai ah paek kaminawk ih athii to ka naek han maw? tiah a thuih. To kaminawk loe angmacae hinghaih angpaekhaih hoiah ni tui to sin pae o. To pongah anih tui to nae pae ai. Hae ih thacak kami thunmtonawk loe to tiah tok to sak o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joab ih amnawk Abishai loe, nihcae thumto zaehoikung ah oh; anih loe tayae to sinh moe, kami cumvai thumto hum; to pongah anih doeh misahoih kami thumto thungah ahmin athum toeng.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih loe thacak kami thumto thung ih hnetto pongah ahmin pakoeh o kue pongah, anih loe thumto kaminawk ukkung ah oh; toe hmaloe ih thumto kaminawk to pha ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kabzeel vangpui ih kami, misahoih Jehoiada capa Benaiah loe, kaipui hoi kanghmong Moab kami hnetto a hum; dantui krak nathuem ah doeh longkhaw thungah kaom kaipui to a hum bae vop.
  </para>
  <para style="p">
    <verse number="23" style="v" />Somsang kahoih, dong pangato kasang, Izip kami maeto doeh a hum let bae; Izip kami loe a ban ah camprai tetto kaom tayae to sinh, toe Benaiah mah anih to thingboeng hoiah pangh moe, Izip kami ban ih tayae to a lomh pacoengah, angmah ih tayae hoiah a hum.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jehoiada capa Benaiah mah to tiah hmuennawk to sak; anih doeh thacak thumto kaminawk baktiah ahmin amthang toeng.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khenah, anih loe kami quithumto thungah minawk mah pakoeh ih kami ah oh; toe hmaloe ih thumto kaminawk to pha ai; to pongah David mah anih to angmah misa toep kami ah suek.
  </para>
  <para style="p">
    <verse number="26" style="v" />Misahoih kaminawk loe Joab ih amnawk Asahel, Bethlehem vangpui ih Dodo capa Elhanan,
  </para>
  <para style="p">
    <verse number="27" style="v" />Haro acaeng Shammoth, Pelon acaeng Helez,
  </para>
  <para style="p">
    <verse number="28" style="v" />Tekoa acaeng Ikkesh capa Ira, Anathoth acaeng Abiezer,
  </para>
  <para style="p">
    <verse number="29" style="v" />Hushath acaeng Sibbekai, Ahoh acaeng Ilai,
  </para>
  <para style="p">
    <verse number="30" style="v" />Netopha acaeng Baanah capa Heled,
  </para>
  <para style="p">
    <verse number="31" style="v" />Benjamin acaeng, Gibeah vangpui ah kaom Ribai capa Ithai, Pirathon acaeng Benaiah,
  </para>
  <para style="p">
    <verse number="32" style="v" />Gaash vacong thung ah kaom Hurai, Arbathi acaeng Abiel,
  </para>
  <para style="p">
    <verse number="33" style="v" />Baharum acaeng Azmaveth, Shaalbon acaeng Eliahba,
  </para>
  <para style="p">
    <verse number="34" style="v" />Gizon acaeng Hashem capanawk, Harari acaeng Shage capa Jonathan,
  </para>
  <para style="p">
    <verse number="35" style="v" />Harari acaeng Sakar capa Ahiam, Ur capa Eliphal,
  </para>
  <para style="p">
    <verse number="36" style="v" />Mekerath acaeng Hepher, Pelon acaeng Ahijah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Karmel acaeng Hazro, Ezbai capa Naarai,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nathan ih amnawk Joel, Haggeri capa Mibhar,
  </para>
  <para style="p">
    <verse number="39" style="v" />Ammon acaeng Zelek, Zeruiah capa Joab ih maiphaw sinkung, Berot acaeng Naharai,
  </para>
  <para style="p">
    <verse number="40" style="v" />Ithri acaeng Ira, Ithri acaeng Gareb,
  </para>
  <para style="p">
    <verse number="41" style="v" />Hit acaeng Uriah, Ahlai capa Zabad,
  </para>
  <para style="p">
    <verse number="42" style="v" />Reuben acaeng Shiza capa Adina, anih loe Reuben acaeng zaehoikung lu koek ah oh moe, kami quithumto oh o.
  </para>
  <para style="p">
    <verse number="43" style="v" />Maakah capa Hanan, Mithna acaeng Joshaphat,
  </para>
  <para style="p">
    <verse number="44" style="v" />Ashteroth acaeng Uzzia, Aroer acaeng Hotham capa hnik, Shama hoi Jehiel,
  </para>
  <para style="p">
    <verse number="45" style="v" />Shimri capa Jediael, Tiz acaeng amnawk Joha,
  </para>
  <para style="p">
    <verse number="46" style="v" />Mahavah acaeng Eliel, Elnaam capa hnik Jeribai hoi Joshaviah, Moab acaeng Ithmah,
  </para>
  <para style="p">
    <verse number="47" style="v" />Mesoba acaeng Eliel, Obed hoi Jasiel cae hae ni.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kish capa Saul khae hoiah anghawk ving moe, Ziklag ah oh naah, David khaeah angzo kaminawk loe, misatuk abomh kami hoi thacak misatuh kami ah oh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae loe kalii to sin o moe, banqoi bantang palaa kaat thaih kami, ngazai hoiah thlung zai thaih kami ah oh o; to kaminawk loe Benjamin acaeng Saul ih nawkamya ah oh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gibeath acaeng Shemah capa hnik Ahiezer hoi Joash loe kacoehta ah oh hoi; Azmaveth capa hnik loe Jeziel hoi Pelet; Berakhah hoi Jehu loe Anathoth acaeng ah oh hoi,
  </para>
  <para style="p">
    <verse number="4" style="v" />kami quithumto thungah thacak kami Gibeon vangpui acaeng Ishmaiah loe kami quithumto zaehoikung ah oh; Jeremiah, Jahaziel, Johanan, Gederah acaeng Jozabad,
  </para>
  <para style="p">
    <verse number="5" style="v" />Eluzai, Jerimoth, Bealiah, Shemariah hoi Harup acaeng Shephatiah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Elkanah, Jesiah, Azarel, Joezer hoi Korah acaeng Jashobeam,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gedor vangpui ih Jeroham capa Joelah hoi Zebadiah.
  </para>
  <para style="p">
    <verse number="8" style="v" />David ohhaih praezaek ah kaom thoemto Gad kaminawk doeh oh o, nihcae loe thacak misatuh kami ah oh o moe, aphaw sin hoi misatuh thaih kami ah oh o; nihcae ih mikhmai loe kaipui mikhmai baktiah oh o moe, mae nui ih tasuk baktiah angtawt loe o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ezer loe kacoehta ah oh; hnetto haih ah Obadiah; thumto haih ah Eliab,
  </para>
  <para style="p">
    <verse number="10" style="v" />palito haih ah Mishmanah, pangato haih ah loe Jeremiah to oh,
  </para>
  <para style="p">
    <verse number="11" style="v" />tarukto haih ah Attai, sarihto haih ah loe Eliel,
  </para>
  <para style="p">
    <verse number="12" style="v" />tazetto haih ah Johanan; takawtto haih ah Elzabad,
  </para>
  <para style="p">
    <verse number="13" style="v" />hato haih ah Jeremiah, hatlaito haih ah Makbanai to oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae kaminawk loe Gad ih caanawk thungah misatuh zaaehoikung ah oh o, tamsi koekah cumvaito, kapop koekah sangto oh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jordan vapui taeng tui mah uengh boihhaih khrah tangsuek naah, azawn ah kaom kaminawk loe ni angyae bang hoiah niduem bangah cawnh o boih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Benjamin kaminawk hoi Judah kaminawk loe David misa abuephaih ahmuen ah angzoh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />David loe nihcae dawt hanah caeh moe, nihcae khaeah, Kai abomh hanah poekmonghaih hoiah nang zoh o nahaeloe, nangcae abomh hanah ka ohcoek; toe ka misanawk hmaa ah kai nang phat o taak nahaeloe, ka sakpazaehaih om ai pongah, aicae ampa ih Sithaw mah khen nasoe loe, nangcae nuiah lokcaek nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pacoengah kami quithumto zaehoikung kacoehta Amasai nuiah Muithla to angzoh, Anih mah David, kaicae loe nang ih kami ah ni ka oh o, Jesse capa, kaicae loe nang bangah ni ka oh o: nang khaeah, monghaih, monghaih to om nasoe! Nang abomh kaminawk khaeah monghaih om nasoe; na Sithaw mah nang ang bomh, tiah a naa. To pongah David mah nihcae to talawk moe, angmah ih misatuh zaehoikung ah suek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Philistin kaminawk hoi Saul tuk hanah a caeh naah, thoemto Manasseh kaminawk loe David khaeah angzoh o; nihcae loe angmah ih angraeng Saul khaeah akun o ueloe, aicae ih lu nganbawh kana paek o tih, tiah a thuih o pongah, David hoi anih ih kaminawk mah Philistin kaminawk to abomh o ai, angmacae angraengnawk hoi lok angdueng o pacoengah, David to kalah bangah patoeh o ving.
  </para>
  <para style="p">
    <verse number="20" style="v" />David Ziklag vangpui ah caeh naah, Manasseh acaeng Adnah, Jozabad, Jediael, Mikael, Jozabad, Elihu hoi Zallethai cae to anih khaeah angzoh o; hae kaminawk loe Manasseh acaeng sangto ukkung ah oh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />To kaminawk loe thacak misatuh angraeng ah oh o moe, mingcah ban thung hoiah David bomkung ah oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nito pacoeng nito, Sithaw ih misatuh kami baktiah, thacak parai misatuh kami tawn ai nathung, David to abomh hanah kaminawk angzoh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah thuih ih lok baktih toengah, Saul ukhaih prae to David khaeah paqoi pae ving hanah, Hebron ah David khaeah angzo, misatuk han amsakcoek kaminawk loe,
  </para>
  <para style="p">
    <verse number="24" style="v" />aphaw hoi tayae kasin, misatuh Judah kaminawk sang taruk quitazetto,
  </para>
  <para style="p">
    <verse number="25" style="v" />misatuk han amsakcoek thacak Simeon kaminawk sang sarih, cumvaito,
  </para>
  <para style="p">
    <verse number="26" style="v" />Levi kaminawk sang pali, quitarukto oh o,
  </para>
  <para style="p">
    <verse number="27" style="v" />Jehoiada loe Aaron acaeng zaehoikung ah oh moe, kami sang thum, cumvai sarihto,
  </para>
  <para style="p">
    <verse number="28" style="v" />thacak thendoeng Zadok hoi anih ampa ih imthung takoh thung hoiah misatuh angraeng pumphae hnetto,
  </para>
  <para style="p">
    <verse number="29" style="v" />Benjamin acaengnawk thung hoiah Saul ih nawkamyanawk sang thumto oh o; hae acaeng thungah kami pop loe Saul ih imthung nuiah oepthok ah khosah kami ah oh o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thacak moe, angmacae acaeng thungah ahmin kamthang Ephraim ih acaeng sing hnet, sang tazetto,
  </para>
  <para style="p">
    <verse number="31" style="v" />David to siangpahrang ah suek hanah ahmin paek ahap Manasseh acaeng thung ih kami sang hatlai tazetto oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Atue panoek moe, Israel kaminawk mah sak han koi panoek kami, Issakar kami kacoehta cumvai hnetto oh o, nihcae ih nawkamyanawk loe nihcae tlim ah toksak hanah amsak o coek.
  </para>
  <para style="p">
    <verse number="33" style="v" />Misatuh kop, misa angtukhaih hmuenmae hoi akoep ah kaom, misatuh thaih Zebulun kami sing pangato oh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Naphtali acaeng hoi misatuh angraeng sangto, aphaw hoi tayae sin kami sing thum, sang sarihto oh o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Misatuk kop Dan acaeng loe sing hnet, sang tazet, cumvai tarukto oh o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Misatuk kop misatuk han amsakcoek Asher acaeng loe sing palito oh o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jordan vapui yaeh ih Reuben, Gad hoi ahap Manasseh kami thung hoiah maiphaw congca sin kami sing hatlaihnetto oh o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hae kaminawk boih loe misatuk kop kami, misatuh thaih angdoethaih ahmuen ah angdoet o moe, David to Israel kaminawk boih ukkung siangpahrang ah suek hanah poekhaih katawn, Hebron ah angzo kami ah oh o; kanghmat Israel kaminawk boih mah doeh David to siangpahrang ah suek hanah poekhaih tawn o.
  </para>
  <para style="p">
    <verse number="39" style="v" />To kaminawk loe David khaeah ni thumto oh o moe, a naek o moe, a caak o; angmacae nawkamyanawk mah caaknaek to paek o.
  </para>
  <para style="p">
    <verse number="40" style="v" />A taengah kaom Issakar, Zebulun hoi Naphtali kaminawk loe caaknaek to laa hrang, kaengkuu hrang, mule hrang hoi maitawnawk hoiah phawh pae o; nihcae loe anghoe o parai pongah, Israel prae thungah takaw dip, thaiduet thaih hoi sak ih takaw, misur thaih kazaek hoiah sak ih takaw, misurtui, situi, maitawnawk hoi tuunawk to sin pae o.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />David loe kami cumvaito ukkung misatuh angraengnawk, cumvaito ukkung angraengnawk, zaehoikungnawk boih hoi nawnto lok a ram.
  </para>
  <para style="p">
    <verse number="2" style="v" />David mah, Israel kaminawk boih khaeah, Hae hmuen hae nangcae mah hoi tih, tiah na poek o moe, aicae Angraeng Sithaw koehhaih ah om tih, tiah na poek o nahaeloe, Israel prae thung boih ah kaom aimacae nawkamyanawk boih, vangpui hoi a taengah kaom qaimanawk hoi Levinawk boih aicae hoi nawnto amkhuenghaih ahmuen ah athum o thai hanah lok pat si;
  </para>
  <para style="p">
    <verse number="3" style="v" />Saul siangpahrang ah oh nathung, mi mah doeh to thingkhong khaeah lok a dueng o vai ai pongah, aimacae Sithaw ih thingkhong to aimacae khaeah sin let si boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaminawk boih mah amsoem, tiah poek o pongah, sak hanah rangpui mah naakrak o.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah David mah Kiriath-Jearim hoiah Sithaw ih thingkhong to sin let hanah, Izip prae ih Shihor vapui hoi Hammath karoek to Israel kaminawk to pakhueng boih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cherubim salakah kaom, Angraeng Sithaw ih ahmin hoi kasaeng Sithaw ih thingkhong to angzawnh hanah, David hoi Israel kaminawk loe Keriath-Jearim, tiah kawk ih Judah prae Baalah ah caeh o boih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abinadab ih imthung hoiah Sithaw ih thingkhong to maitaw leeng kangtha pongah suek o moe, Uzzah hoi Ahio mah ruet.
  </para>
  <para style="p">
    <verse number="8" style="v" />David hoi Israel kaminawk boih loe, aqui kapop katoeng, cingceng, satuem hoi mongkahnawk to sin o moe, Angraeng hmaa ah tha hoi laasak o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kidon ih cang atithaih ahmuen ah phak o naah loe, maitaw tae to amthaek pongah, Uzzah mah krak han ai ah Sithaw ih thingkhong to ban hoiah patawnh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sithaw ih thingkhong to ban hoi a sui pongah, Uzzah nuiah Angraeng palungphuihaih hmai baktiah angqong pongah, anih loe Sithaw hmaa ah duek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Uzzah nuiah Angraeng palungphui pongah, David loe poeknawm ai; to ahmuen loe vaihni ni khoek to Perez Uzzah, tiah kawk o.
  </para>
  <para style="p">
    <verse number="12" style="v" />To na niah loe David mah Sithaw to zit pongah, Kawbangmaw Sithaw ih thingkhong to im ah kaimah khaeah ka sin thai han? tiah a thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah David mah Sithaw ih thingkhong to angmah khaeah David ih vangpui thungah sin ai; ayae ving moe, Gitti kami Obed-Edom im ah sinh o lat.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sithaw ih thingkhong loe Obed-Edom imthung takoh hoi nawnto khrah thumto thung oh. To naah Angraeng mah Obed-Edom imthung takoh hoi a tawnh ih hmuennawk boih nuiah tahamhoihaih to paek.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tura siangpahrang Hiram loe David ohhaih im sak pae hanah, laicaeh hoi nawnto Sidar thing, thing tok sah kop kami hoi thlung tok sah kop kaminawk to patoeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah David to Israel siangpahrang ah suek boeh moe, angmah ih kami Israel caanawk hanah, prae tapom pae boeh, tiah David mah panoek.
  </para>
  <para style="p">
    <verse number="3" style="v" />David loe Jerusalem ah pop parai zu to lak moe, canu hoi capa paroeai sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jerusalem ah oh naah sak ih a caanawk ih ahmin loe Shammua, Shobab, Nathan, Solomon,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ibhar, Elishua, Elpalet,
  </para>
  <para style="p">
    <verse number="6" style="v" />Nogah, Nepheg, Japhia,
  </para>
  <para style="p">
    <verse number="7" style="v" />Elishama, Beeliada hoi Eliphalet.
  </para>
  <para style="p">
    <verse number="8" style="v" />David loe Israel caanawk boih ih siangpahrang ah situi bawh o boeh, tiah Philistinnawk mah thaih o naah, Philistinnawk boih David pakrong hanah caeh o; to tamthang to David mah thaih naah nihcae tuk hanah caeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Philistinnawk angzoh o moe, Rephaim azawn boih ah ahmuen takhawh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah David mah Sithaw khaeah, Ka caeh moe, Philistinnawk to ka tuk han maw? Nihcae to ka ban ah nang paek han maw? tiah a hnik. Angraeng mah anih khaeah, Caeh tahang ah, nihcae to na ban ah kang paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah David hoi anih ih kaminawk to Baal-Perazim ah caeh o tahang, to ah David mah nihcae to tuk. To pacoengah David mah, Tui pakhoih baktiah, Angraeng mah, ka ban hoiah ka misanawk amrosak boih boeh, tiah thuih; to pongah to ahmuen to Baal-Perazim, tiah sak o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Philistinnawk mah caeh o taak ih angmacae ih sithawnawk to, hmai hoi thlaek hanah David mah lokpaek.
  </para>
  <para style="p">
    <verse number="13" style="v" />Philistinnawk loe azawn boih ah ahmuen takhawh o let.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah David mah Sithaw khaeah hnik let; Sithaw mah anih khaeah, Nihcae ohhaih ahmuen ah katoengah caeh tahang hmah; nihcae khae hoi angqoi oh loe, langkawk pacahhaih thing ohhaih ahmuen hoiah daw o tahang ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Langkawk pacahhaih thing nuiah misatuk han caehhaih lok na thaih naah, misatuk hanah caeh oh; Sithaw loe Philistin misatuh kaminawk hum hanah nangcae hmaa ah caeh boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah Sithaw mah thuih pae ih lok baktih toengah, David mah sak, nihcae mah Gibeon hoi Gezer karoek to Philistin kaminawk to hum o.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah David loe prae thung boih ah ahmin amthang; prae kaminawk boih mah anih to zit o hanah Angraeng mah sak.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />David loe angmah hanah, David vangpui to sak moe, Sithaw ih thingkhong suekhaih kahni im doeh a sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah David mah, Angraeng mah Sithaw thingkhong to aput moe, dungzan khoek to anih ih toksak hanah, Levi acaengnawk to qoih boeh pongah, Levi acaengnawk ai ah loe mi mah doeh apu thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />David mah sak ih kahni im ah Sithaw ih thingkhong phawh hanah, David mah Israel kaminawk boih Jerusalem ah nawnto amkhuengsak.
  </para>
  <para style="p">
    <verse number="4" style="v" />David mah, Aaron ih caanawk hoi Levi acaengnawk to pakhueng boih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kohat acaeng, zaehoikung Uriel hoi anih ih caa cumvai pumphaeto,
  </para>
  <para style="p">
    <verse number="6" style="v" />Merari acaeng, zaehoikung Asaiah hoi anih ih caa cumvai hnet, pumphaeto,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershom acaeng, zaehoikung Joel hoi anih ih caa cumvai quithumto,
  </para>
  <para style="p">
    <verse number="8" style="v" />Elizaphan acaeng, zaehoikung Shemaiah hoi anih ih caa cumvai hnetto,
  </para>
  <para style="p">
    <verse number="9" style="v" />Hebron acaeng, zaehoikung Eliel hoi anih ih caa quitazetto,
  </para>
  <para style="p">
    <verse number="10" style="v" />Uzziel acaeng, zaehoikung Amminadab hoi anih ih caa cumvai hatlaihnetto oh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoeng ah David mah qaima Zadok hoi Abiathar; Levi acaeng Uriel, Asaiah, Joel, Shemaiah, Eliel hoi Amminadab cae to kawk.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae khaeah, Nangcae loe Levi acaeng zaehoikung kacoehta ah na oh o; nangmacae hoi nam nawkamyanawk loe ciimcai ah om o sak loe, Israel Angraeng Sithaw ih thingkhong to, ka sak ih ahmuen ah angzawnh oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nangcae loe canghniah to tiah na sah o ai, a thuih ih lok baktih toengah kawbangmaw ka sak o han? tiah lok a dueng o ai pongah, aicae Angraeng Sithaw loe aicae nuiah palungphui, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah qaima hoi Levi acaengnawk loe Israel Angraeng Sithaw ih thingkhong aput hanah ciimcai ah oh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angraeng mah Mosi khaeah paek ih lok baktih toengah, Levi acaengnawk mah Sithaw ih thingkhong to angzawnhaih thing hoiah palaeng ah aput o.
  </para>
  <para style="p">
    <verse number="16" style="v" />David mah Levi kacoehtanawk khaeah, atuen congca, aqui kapop katoeng, cingceng, tamoi kruekhaih hoiah anghoehaih laa to sak o moe, angmacae ih nawkamyanawk to tok paek hanah a thuih pae.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah Levi acaengnawk mah angmacae nawkamya thung hoiah Joel capa Heman, angmah ih amnawk Berakiah capa Asaph; Merari acaeng thungah angmacae nawkamya Kushaiah capa Ethan;
  </para>
  <para style="p">
    <verse number="18" style="v" />Hnetto haih ah kaom angmacae ih nawkamya Zekariah, Ben, Jaaziel, Shemiramoth, Jehiel, Unni, Eliab, Benaiah, Maaseiah, Mattithiah, Elipheleh, Mikneiah, Obed-Edom hoi khongkha toepkung Jeiel cae hanah tok paek o.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pongah Heman, Asaph hoi Ethan loe cingceng bopkung ah oh o;
  </para>
  <para style="p">
    <verse number="20" style="v" />Zekariah, Aziel, Shemiramoth, Jehiel, Unni, Eliab, Maaseiah hoi Benaiah cae mah Alamoth katoeng to kruek o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mattithiah, Elipheleh, Mikneiah, Obed-Edom, Jeiel hoi Azaziah cae mah aqui kapop sheminith katoeng to kruek o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Levi zaehoikung lu koek, Kenaniah loe laasak zaehoikung ah oh; anih loe laa zaehhoihaih kop kami ah oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Berekiah hoi Elkanah loe Sithaw ih thingkhong akunhaih khongkha toepkung ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Qaima Shebaniah, Jehoshaphat, Nathanel, Amasai, Zekariah, Benaiah hoi Eliezer mah Sithaw thingkhong hmaa ah mongkah to ueng o; Obed-Edom hoi Jehiah loe thingkhong khongkha toepkung ah oh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pongah David hoi Israel kacoehtanawk, kami sangto ukkungnawk loe, anghoehaih hoiah Obed-Edom imthung hoiah Sithaw lokkamhaih thingkhong to sinh hanah caeh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng lokkamhaih thingkhong apu Levi acaengnawk to, Sithaw mah abomh boeh pongah, maitaw tae sarihto hoi tuutae sarihto angbawnhaih ah a paek o.
  </para>
  <para style="p">
    <verse number="27" style="v" />David hoi Sithaw ih thingkhong apuu Levi acaengnawk, laasah kaminawk, laasah zaehoikung Kenaniah loe puu ngan khukbuen hoiah amthoep o; David doeh puu ngan kahni to angkhuk toeng.
  </para>
  <para style="p">
    <verse number="28" style="v" />To tiah Israel kaminawk boih mah Angraeng lokkamhaih thingkhong to, hanghaih lok, tuu takii bohhaih lok, mongkah lok, cingceng lok hoi aqui kapop katoeng lok hoiah phawh o tahang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng lokkamhaih thingkhong David vangpui thungah phak naah, Saul canu Mikael mah thokbuem hoiah khet; anih mah hnawh moe, anghoehaih hoiah kaom, David siangpahrang to hnuk naah, anih to palung thung hoiah khet patoek.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw ih thingkhong to phawh o moe, David mah sak ih kahni im aum ah suek o pacoengah, Sithaw hmaa ah hmai angbawnhaih hoi angdaeh angbawnhaih to sak o.
  </para>
  <para style="p">
    <verse number="2" style="v" />David mah hmai angbawnhaih hoi angdaeh angbawnhaih sak pacoengah, Angraeng ih ahmin hoiah tahamhoihaih to paek.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pacoengah Israel nongpa nongpanawk boih khaeah, takaw phaek maeto, moi ngan maeto, misurthaih takaw karoem to a paek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thoemto Levi kaminawk hanah loe, Angraeng lokkamhaih thingkhong hmaa ah toksak moe, Israel Angraeng Sithaw to saphaw pacoengah, anghoehaih lokthuihaih tok to a paek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Asaph loe lu koekah oh, hnetto haih ah Zekariah, anih pacoengah Jeiel, Shemiramoth, Jehiel, Mattithiah, Eliab, Benaiah, Obed-Edom cae to a suek; Jeiel loe aqui kapop katoeng hoi tamoinawk to kruek moe, Asaph mah cingceng to boh;
  </para>
  <para style="p">
    <verse number="6" style="v" />qaima Benaiah hoi Jahaziel hnik doeh Sithaw lokkamhaih thingkhong hmaa ah mongkah to ueng hoi toeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />To niah David mah Asaph hoi angmah ih nawkamyanawk khaeah, paek hmaloe ih anghoehaih hoi Angraeng saphawhaih saam laa to sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng khaeah anghoehaih lok to thui oh, ahmin to kawk oh; a sak ih hmuennawk to kaminawk boih panoek o sak ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih khaeah laa to sah oh, anih saphawhaih laa to sah oh, a sak ih dawnrai hmuennawk to thui oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih ih kaciim ahmin to pakoeh oh; Angraeng pakrong kaminawk ih palungthin loe anghoe nasoe.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng hoi a thacakhaih to khen oh loe, anih ih mikhmai to khen o poe ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />A sak ih dawnrai hmuennawk hoi anghmang thok hmuennawk, a thuih ih lokcaekhaihnawk to panoek oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw a tamna Israel caanawk, Jakob ih caanawk, a qoih ih kaminawk.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih loe aicae ih Angraeng Sithaw ah oh; a lokcaekhaih loe long nui boih ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih loe a sak ih lokmaihaih to panoek poe moe, a paek ih lok to caanawk dung khoek to panoek;
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham hoi sak ih lokmaihaih, Isaak hoi sak ih lokmaihaih to panoek poe;
  </para>
  <para style="p">
    <verse number="17" style="v" />Jakob khaeah lok takroekhaih to caksak moe, Israel khaeah dungzan lokmaihaih to a caksak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na toep o han koi qawk ah kaom, Kanaan prae to kang paek han, tiah thuih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangcae loe nazetto doeh na om o ai, kami zetta ni na oh o, to prae thungah angvin ah ni na oh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae loe prae maeto khaeah caeh o moe, kami maeto hoi maeto khaeah ah amhet o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nihcae to mi mah doeh pacaekthlaeksak ai, nihcae pongah siangpahrangnawk to a zoeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Situi ka bawh ih kaminawk hae sui hmah; kai ih tahmaanawk to pacaekthlaek o hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Long kaminawk boih, Angraeng khaeah laasah oh; nito pacoeng nito a pahlonghaih to thui oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A lensawkhaih to Sithaw panoek ai kaminawk khaeah thui oh loe, a sak ih dawnrai hmuen to prae kaminawk boih khaeah taphong oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Angraeng loe lensawk moe, pakoeh han krak; sithawnawk boih pongah doeh zitthoh kue.
  </para>
  <para style="p">
    <verse number="26" style="v" />Prae kalah kaminawk ih sithaw loe sakcop ih krang rumram tok ni; toe Angraeng mah loe vannawk to sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Anih hmaa ah lensawkhaih hoi pakoehhaih to oh moe, anih ohhaih ahmuen ah loe anghoehaih hoi thacakhaih to oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Angraeng khaeah paek oh, prae boih ih canawknawk, Angraeng khaeah lensawkhaih hoi thacakhaih to paek oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng ih ahmin loe lensawk, tiah thui oh; a hmaa ah angzo oh loe, hmuen to paek oh; ciimcai hmuen hoiah Angraeng to saphaw oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Long boih, a hmaa ah tasoeh oh; long loe kacakah angdoe tih, angthui mak ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vannawk anghoe o nasoe loe, long doeh anghoe nasoe; prae kaminawk boih khaeah, Angraeng mah uk, tiah thui o nasoe.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuipui hoi a thungah kaom hmuennawk mah lok tacawt o sak nasoe loe, lawk thungah kaom hmuennawk boih, anghoe o nasoe.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anih loe long lokcaek hanah angzoh pongah, taw ih thingnawk mah laa to sah o tih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Angraeng loe hoih pongah, anih khaeah anghoehaih lok to thui oh; anih tahmenhaih loe dungzan khoek to cak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kaciim na hmin to ka pakoeh o moe, nang saphawhaih ah kam oek o thai hanah, Na pahlong ah, Aw Sithaw kaicae pahlongkung! Kaicae hae nawnto amkhuengsak loe, Sithaw panoek ai kaminawk thung hoiah na pahlong ah, tiah hang oh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Israel Angraeg Sithaw loe dungzan hoi dungzan khoek to tahamhoihaih om nasoe, tiah thuih naah, kaminawk boih mah Amen, Angraeng loe saphaw oh, tiah thuih o.
  </para>
  <para style="p">
    <verse number="37" style="v" />David mah Asaph hoi angmah ih nawkamyanawk to Angraeng lokkamhaih thingkhong hmaa ah, ni thokkruek toksak hanah caehtaak;
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed-Edom loe angmah ih nawkamya qui taruk, tazettonawk to nihcae bomkung ah oh o sak moe, Jeduthun capa Obed-Edom hoi Hosah loe khongkha toepkung ah oh hoi.
  </para>
  <para style="p">
    <verse number="39" style="v" />David mah qaima Zadok hoi angmah ih nawkamya qaimanawk to, Gibeon ih hmuensang hoi Angraeng ih kahni im ah caehtaak,
  </para>
  <para style="p">
    <verse number="40" style="v" />Angraeng khaeah aduem akhawn, hmaicam nuiah hmai angbawnhaih to sak moe, Israel kaminawk khaeah paek ih, cabu thungah tarik tangcae Angraeng ih kaalok baktih toengah, angbawnhaih sak o poe hanah a caehtaak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Angraeng tahmenhaih loe dungzan khoek to cak pongah, Angraeng khaeah anghoehaih lawkthuih hanah, nihcae hoi nawnto kaom kaminawk hoi nawnto Heman hoi Jeduthun pacoengah, qoih moe, ahmin lak ih kaminawk doeh oh o;
  </para>
  <para style="p">
    <verse number="42" style="v" />Heman hoi Jeduthun loe mongkah, cingceng hoi Sithaw ih katoeng kruekhaih bangah toksahkung ah oh hoi. Jeduthun ih caanawk loe khongkha toepkung ah oh o.
  </para>
  <para style="p">
    <verse number="43" style="v" />To pacoengah kaminawk boih angmacae im ah amlaem o; to tiah David doeh angmah ih imthung takoh tahamhoihaih paek hanah amlaem toeng.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />David loe angmah ih im ah oh naah, tahmaa Nathan khaeah, Khenah kai loe sidar thing hoiah sak ih im ah ka oh, Angraeng lokkamhaih thingkhong loe kahni im ah oh sut, tiah thuih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nathan mah David khaeah, Nang khaeah Sithaw oh pongah, palung thungah na poek ih hmuennawk boih to sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To na aqum ah Sithaw ih lok Nathan khaeah angzoh;
  </para>
  <para style="p">
    <verse number="4" style="v" />caeh ah loe ka tamna David khaeah, Angraeng mah, Ka ohhaih im loe nang mah na sah mak ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />Izip prae hoi Israel ka zaeh na ni hoi kamtong vaihni ni khoek to im ah ka om ai vop; toe kahni im maeto hoi maeto ah ka caeh moe, ohhaih ahmuen maeto hoi maeto bangah kang puen, tiah thuih, tiah thui paeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel caanawk hoi ka caehhaih ahmuen kruekah, kai ih kaminawk to pacah hanah, Israel lokcaekkungnawk khaeah, Tipongah kai han sidar im na sah o ai loe, tiah ka naa vaih maw?
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah ka tamna David khaeah, misatuh Angraeng mah, Misatuh kaminawk ih Angraeng mah, Kai ih kami Israel caanawk ukkung ah oh hanah, nang hae tuu toephaih tuu khongkha thung hoiah ka lak han,
  </para>
  <para style="p">
    <verse number="8" style="v" />na caehhaih ahmuen kruekah kang oh thuih moe, na hmaa ih misanawk to kang haek pae boih han; long ah ahmin amthang koek kaminawk baktiah na hmin kang ohsak han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaimah ih kami Israelnawk hanah ahmuen to ka paek han, nihcae loe angpuen o mak ai boeh, angmacae ohhaih ahmuen ah oh o thai hanah, ka tlingh han; tangsuek ah a oh o ih baktih toengah, kahoih ai kaminawk mah hnaphnae o mak ai boeh,
  </para>
  <para style="p">
    <verse number="10" style="v" />kaimah ih kami Israelnawk nuiah lokcaekkung mah uk nathuem ih baktiah om o mak ai boeh; na misanawk to tha ka zoksak boih han. Angraeng mah ni nang hanah im na sah pae tih, tiah kang thuih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang ih aninawk to boeng moe, nam panawk khae oh hanah na caeh naah, nang khae hoi tacawt caanawk thung ih, na capa maeto ka pathawk moe, anih ukhaih prae to ka sak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih mah ni kai hanah im sah tih, anih ih angraeng tangkhang loe dungzan khoek to ka caksak han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kai loe anih ih ampa ah ka oh han, anih loe ka capa ah om tih; na hmaa ah kaom kaminawk khae hoi ka lak pae ih baktih toengah, ka tahmenhaih anih khae hoi ka zuk mak ai boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih to ka im hoi ka prae ah dungzan khoek to ka suek han, anih ih angraeng tangkhang loe dungzan khoek to cak tih, tiah thuih, tiah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hae ah thuih ih loknawk hoi hae hnuksakhaih hmuen baktih toengah, Nathan mah David khaeah thuih pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />David siangpahrang loe imthung ah caeh, Angraeng hmaa ah anghnut moe, Aw Angraeng Sithaw, kai loe kawbaktih kami ah maw ka oh moe, ka imthung takoh doeh kawbangmaw ka oh o moe, hae ahmuen khoek to nang zaehhoih?
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe Aw Sithaw, hae hmuen loe na mikhnukah tetta ah ni oh, kalen parai na tamna imthung takoh hmalam to nang thuih boih boeh; Aw Angraeng Sithaw, kai hae pakoeh koi kaom kasang koek kaminawk baktiah nang khet boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tamna hae na panoek boeh pongah, David mah timaw thui thai vop tih?
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Angraeng, na tamna nuiah na koehhaih baktiah, kalen parai hae hmuennawk boih amtuengsak hanah, kalen parai hmuennawk hae na suek boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aw Angraeng, nang baktih mi doeh om ai; naa hoi ka thaih o boih ih baktih toengah, nang ai ah loe kalah Sithaw roe om ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izip prae thung hoi na krang ih nangmah ih kaminawk hmaa ah, prae kaminawk haekhaih rang hoiah nang to zitthok kalen ahmin ah suek hanah, Sithaw mah angmah ih kami ah oh hanah akrang ih, nangmah ih kami Israel hoi kanghmong acaeng maeto long nui ah oh maw?
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmah ih kami Israel caanawk loe dungzan khoek to nang ih kami ah oh o thai hanah, na sak boeh, Angraeng, nang loe nihcae ih Sithaw ah na oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah vaihiah, Angraeng, na thuih ih na tamna hoi a imthung takoh hmuennawk to dungzan khoek to caksak ah; na thuih ih lok baktiah sah ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na hmin dungzan khoek to len hanah, to tiah cak nasoe; misatuh kaminawk ih Angraeng, Israel Sithaw loe, Israel kaminawk ih Sithaw ah oh; na tamna David ih im loe na hmaa ah cak nasoe, tiah thuih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aw ka Sithaw, nang hanah im kang sak pae han, tiah na tamna khaeah nang thuih pongah, na tamna loe na hmaa ah lawkthuih koehhaih palungthin a tawnh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aw Angraeng, nang loe Sithaw ah na oh! Na tamnanawk khaeah hae lokkamhaih hae na suek boeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pongah vaihi na hmaa ah dungzan ah oh thaih moe, na tamna ih im tahamhoihaih paek hanah, anghoehaih palungthin tawn rae ah; Aw Angraeng, tahamhoihaih nang paek boeh pongah, dungzan khoek to tahamhoihaih to hnu tih boeh, tiah lawkthuih.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />David mah, Philistin kaminawk to tuk moe, pazawk; Philistin kaminawk ih ban thung hoiah Gath vangpui hoi a taeng ih ahmuennawk doeh a lak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Moab prae doeh a tuk, Moab kaminawk loe anih ih tamna ah oh o moe, anih hanah tamut paek o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zobah siangpahrang Hadadezer loe a ukhaih caksak hanah Euphrate vapui khoek to caeh, to naah David mah anih to tuk moe, Hammath vangpui karoek to pazawk.
  </para>
  <para style="p">
    <verse number="4" style="v" />David mah anih khae hoi hrangleeng sangto, hrang angthueng kami sang sarihto, khok hoi misatuh kami sang pumphaeto naeh; hrangleeng cumvaito khue ni a lak pae, kalah hrangleengnawk loe paro pae boih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zobad siangpahrang Hadarezer abomh hanah Damaska vangpui ih Syria kaminawk angzoh o, to naah David mah nihcae to sang pumphae hnetto hum.
  </para>
  <para style="p">
    <verse number="6" style="v" />David loe Syria prae Damaska vangpui ah misatoep kami to suek; Syria kaminawk loe David ih tamna ah oh o moe, anih hanah tamut paek o. David loe a caehhaih ahmuen kruekah Angraeng mah oh thuih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hadarezer ih tamnanawk mah patoh ih sui aphawnawk to David mah lak moe, Jerusalem ah sin.
  </para>
  <para style="p">
    <verse number="8" style="v" />David mah Hadarezer ih vangpui Tibhat, Kun thung hoiah paroeai pop sumkamling to lak; to ih sumkamling hoiah ni Solomon mah, sumkamling tuili, tungnawk hoi sumkamling hmuennawk to sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />David mah kawbangmaw Zobad siangpahrang Hadarezer ih misatuh kaminawk to pazawk, tiah Hammath siangpahrang Tou mah thaih;
  </para>
  <para style="p">
    <verse number="10" style="v" />(Tou hoi Hadarezer loe misa angtuk hoi) Tou ih misa Hadarezer to tuk pazawk pae pongah, David to ban sin moe, oephaih lokthuih hanah, a capa Hadoram to patoeh; Hadoram mah sui, phoisa, sumkamling hoiah sak ih laom sabae congcanawk to sin pae.
  </para>
  <para style="p">
    <verse number="11" style="v" />David loe to ih hmuenmaenawk boih, Edom, Moab, Ammon, Philistin, Amalek kaminawk boih khae hoiah lak ih, sui hoi phoisa hoiah sak ih hmuennawk to Angraeng hanah paek boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zeruiah capa Abishai mah Paloi azawn ah Edom kami sang hatlaitazetto hum.
  </para>
  <para style="p">
    <verse number="13" style="v" />Edom ah misatoep kami to a suek, Edom kaminawk loe David ih tamna ah oh o boih. David loe a caehhaih ahmuen kruekah Angraeng mah oh thuih.
  </para>
  <para style="p">
    <verse number="14" style="v" />David loe Israel kaminawk boih ukkung siangpahrang ah oh, anih loe angmah ih kaminawk nuiah kamsoem hoi katoeng hmuennawk to ni sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zeruiah capa Joab loe misatuh kaminawk ukkung ah oh; Ahilud capa Jehosaphat loe ca tarikkung ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahitub capa Zadok hoi Abiathar capa Abimelek loe qaima ah oh hoi; Shasha loe athung ih ca tarikkung ah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jehoiada capa Benaiah loe Kereth hoi Peleth kaminawk ukkung ah oh; David capanawk loe David khaeah angraeng tok to sak o.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />To nathuem ah Ammon siangpahrang Nahash loe duek moe, a capa mah anih zuengah uk.
  </para>
  <para style="p">
    <verse number="2" style="v" />David mah, Anih ih ampa mah kai ang tahmen pongah, Nahash capa Hanun nuiah tahmenhaih kam tuengsak han, tiah a poek. Ampa kawng pongah palungsethaih amtuengsak hanah David mah Hanun khaeah laicaeh patoeh. David ih kaminawk loe, Hanun khaeah palungsethaih lokthuih hanah Ammon prae ah angzoh o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toe Ammon angraengnawk mah Hanun khaeah, David mah nam pa nuiah palungsethaih amtuengsak han ih ni, pathloep kaminawk to patoeh, tiah na poek maw? Anih ih tamnanawk loe prae to khet moe, paro han hoi misatuk han ih na ai maw angzoh o? tiah a naa o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hanun mah David ih kaminawk to naeh moe, sam to aah pae; khukbuen to laetabu khoek to aah pae pat moe, amlaemsak let.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pacoengah kangcoeng hmuen kawng to kami maeto mah David khaeah thuih pae. Nihcae to paroeai azat thokah sak o pongah, nihcae tongh hanah anih mah kami to patoeh. Siangpahrang mah, Na toektaboe mui tacawt ai karoek to, Jeriko vangpui ah na oh o pacoengah, amlaem oh, tiah thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />David hanah hmuisae hmuen a sak pae o boeh, tiah Ammon kaminawk mah panoek o naah, Hanun hoi Ammon kaminawk mah Mesopotamia prae, Syria-Maakah hoi Zobah prae hoiah hrangleeng, hrang angthueng kaminawk to tlai hanah, phoisa talent sangto a pat pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae mah hrangleeng sing thum, sang hnetto, Maakah siangpahrang hoi anih ih misatuh kaminawk to tlai pongah, nihcae loe angzoh o moe, Medeba taengah atai o. Ammon kaminawk loe avang maeto pacoeng maeto ah amkhueng o moe, misatuk hanah caeh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />David mah to tamthang to thaih naah, Joab hoi thacak angmah ih misatuh kaminawk to patoeh boih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ammon kaminawk loe angzoh o moe, angmacae ih vangpui sipae khongkha ah misatuk hanah amkhueng o; angmacae koeh ah angzo siangpahrangnawk loe taw thungah oh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Joab mah anih tuk hanah ahnuk ahmaa kaom kaminawk to hnuk naah, Israel thung hoi kahoih koek misatuh kaminawk to a qoih moe, Syria kaminawk to tuksak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kalah misatuh kaminawk loe amnawk Abishai hanah uksak, nihcae loe Ammon kaminawk tuk hanah amsak o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joab mah, Syria kaminawk thacak o hmoek nahaeloe, kai hae na bom ah, nang hanah Ammon kaminawk thacak o hmoek nahaeloe, kai mah kang bomh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Misahoih ohsak loe, aimacae kaminawk hoi aimacae ih Sithaw hanah, misahoihaih hoiah tuh si; Angraeng mah a mikhnukah kahoih hmuen to sah nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joab hoi a taengah kaom kaminawk loe Syria misatuk hanah caeh o boih; Syria kaminawk loe nihcae hmaa ah cawnh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Syria kaminawk cawnh o boeh, tiah Ammon kaminawk mah hnuk o naah, nihcae doeh amnawk Abishai hmaa ah cawnh o toeng moe, vangpui thungah akun o. To pacoengah Joab loe Jerusalem ah amlaem let.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel kaminawk hmaa ah misa sung boeh, tiah Syria kaminawk mah panoek o naah, nihcae mah laicaehnawk to patoeh o moe, vapui yaeh ah kaom Syria misatuh kaminawk to kawksak; Hadarezer ih misatuh angraeng Shophak mah nihcae to caeh haih.
  </para>
  <para style="p">
    <verse number="17" style="v" />To lok to David khaeah thuih pae o naah, anih mah Israel kaminawk boih to pakhueng moe, Jordan vapui to angkat o; nihcae khaeah phak o moe, nihcae tuk hanah amsak o. David loe Syria kaminawk tuk hanah amsak moe, nihcae hoi misa angtuk o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Syria kaminawk loe Israel kaminawk hmaa ah cawnh o; David mah hrangleeng nuiah angthueng kami sang sarihto hum moe, khok hoi misatuh kami sing palito a hum; nihcae ih misatuh angraeng Shophak doeh a hum pae.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel kaminawk mah pazawk boeh, tiah Hadarezer taengah kaom tamnanawk mah panoek o naah, David hoi angdaehhaih sak o moe, anih ih tamna ah oh o. To pongah Syria kaminawk mah Ammon kaminawk abomh han koeh o ai boeh.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Saning laemh moe, siangpahrangnawk misatuk han caeh o naah, Joab mah misatuh kaminawk to caeh haih; Ammon prae to a tuk moe, Rabbah vangpui to takui. Toe David loe Jerusalem ah ni oh. Joab mah Rabbah to tuk moe, paro pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />David mah nihcae siangpahrang lu pong ih angraeng lumuek to lak pae; to ih angraeng lumuek loe sui talent maeto azit moe, atho kaom thlung hoiah sak o; to lumuek loe David ih lu ah suek pae o; vangpui thung hoiah paroeai kapop lomh o ih hmuennawk to a lak o,
  </para>
  <para style="p">
    <verse number="3" style="v" />vangpui thung kaom kaminawk to hoih o moe, nihcae to sarang hoiah aah o, sumboeng hoi caka hoiah boeng o. David mah Ammon kaminawk to tiah sak pacoengah, kaminawk hoi nawnto Jerusalem ah amlaem.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pacoengah Gezer vangpui ah Philistinnawk hoi misa angtuk o, Hushath kami Sibbekhai mah Raphaim acaeng Sippai to hum moe, Philistinnawk to pazawk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Philistin kaminawk hoi misa angtukhaih ahmuen kalah maeto ah, Jair capa Elthanan mah, thangbui no baktih kanoe tayae sinkung, Git acaeng Goliath ih amnawk Lahmi to hum.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah Gath vangpui ih misa angtukhaih ahmuen ah, ban maeto pongah banpazung tarukto hoi khokpazung tarukto, sangqum boihah pumphae palito katawn, kalen parai kami maeto oh, anih loe Rapha ih caa ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah Israel kaminawk to khet patoek pongah, David amnawk Shimea capa Jonathan mah anih to hum.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hae kaminawk loe Gath vangpui ah kaom kalen parai kami Rapha ah oh o, nihcae loe David hoi anih ih kaminawk ban ah duek o.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel pacuek hanah Setan loe angthawk moe, Israel kaminawk kroek hanah David to pahruek.
  </para>
  <para style="p">
    <verse number="2" style="v" />David mah Joab hoi zaehoikung angraengnawk khaeah, Beersheba hoi Dan karoek to caeh oh loe, Israel kaminawk to kroek oh; kami nazetto maw oh, tiah panoek hanah, kai khaeah na sin oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Joab mah, Angraeng mah angmah ih kaminawk alet cumvai khoek to pungsak nasoe; toe ka angraeng siangpahrang, Israel caanawk loe ka angraeng ih tamna ah na ai maw oh o? To pongah tih han ih hae hmuen hae sak na koeh loe? Tipongah Israel nuiah zaehaih sak han na koeh loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe siangpahrang ih lok mah Joab to pazawk. To pongah Joab loe Israel prae boih ah caeh moe, Jerusalem ah amlaem let.
  </para>
  <para style="p">
    <verse number="5" style="v" />Joab mah milu cazin to David khaeah paek. Israel prae boih ah sumsen patoh thaih kaminawk, sang cumvai hatlaito oh o moe, Judah prae thungah sumsen patoh thaih kami, sang cumvai pali, sing sarihto oh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe siangpahrang ih lok to Joab mah koeh ai pongah, Levi acaeng hoi Benjamin acaeng to kroek ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hae hmuen nuiah Sithaw palung anghoe ai pongah, Israel to boh.
  </para>
  <para style="p">
    <verse number="8" style="v" />David mah Sithaw khaeah, Hae hmuen ka sak pongah paroeai ka zae boeh; vaihi tahmenhaih kang hnik, na tamna zaehaih hae na takhoe pae ah; amthuhaih hmuen ni ka sak boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng mah David ih tahmaa Gad khaeah,
  </para>
  <para style="p">
    <verse number="10" style="v" />caeh ah loe David khaeah Angraeng mah, Qoih koi hmuen thumto kang paek han, na koehhaih kang sak pae hanah, thumto thungah maeto qoi ah, tiah thuih, tiah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah Gad mah David khaeah caeh moe, anih khaeah, Angraeng mah,
  </para>
  <para style="p">
    <verse number="12" style="v" />saning thumto khokhahaih maw, khrah thumto thung na misanawk sumsen hoiah ang tuk pazawk moe, na misanawk hmaa ah nam rohaih maw, to tih ai boeh loe Angraeng ih sumsen ah kaom, ni thumto thung prae boih ah nathaih kasae tonghaih hoi Angraeng ih van kami mah Israel prae boih parohaih maw, hae thumto thungah maeto qoih hanah thuih, tiah a naa. To pongah vaihi kai patoehkung Anih khaeah kawbangmaw ka thuih pae han, tiah poek het ah loe na thui ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />David mah Gad khaeah, Palung ka set parai; anih tahmenhaih loe len parai pongah, Angraeng ban ah na krahsak ah; kami ban ah na krahsak hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Angraeng mah Israel nuiah nathaih to phaksak, Israel kami sing sarihto duek o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jerusalem phraek hanah Angraeng mah van kami maeto patoeh; van kami mah phreak ih hmuen to Angraeng mah khet naah, anih loe sak ih kasae hmuen pongah dawnpakhuem moe, parokung van kami khaeah, Khawt boeh, na ban to azuk ah, tiah a naa. Angraeng ih van kami loe Jebus kami Ornan ih cang atithaih ahmuen taengah angdoet.
  </para>
  <para style="p">
    <verse number="16" style="v" />David mah khet tahang naah, long hoi van salakah angdoe, Jerusalem nuiah sumsen kalaek, Angraeng ih van kami to hnuk. David hoi kacoehtanawk loe kazii to angzaeng o boih moe, nihcae hmaa ah akuep o.
  </para>
  <para style="p">
    <verse number="17" style="v" />David mah Sithaw khaeah, Kaimah na ai maw milu cazin ka koksak? Kai loe ka zae boeh, hmuen ka sakpazae boeh; hae ih tuunawk loe tih zaehaih maw sak o? Aw ka Angraeng Sithaw, kaimah hoi kam panawk ih imthung nuiah, na ban to krahsak ah; nangmah ih kaminawk nuiah, hae nathaih hae phasak hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pacoengah Angraeng ih van kami mah Gad khaeah, David khaeah caeh tahang ah loe, Jebus kami Ornan ih cang atithaih ahmuen ah, Angraeng hanah hmaicam sak hanah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />David loe Angraeng ih ahmin hoiah Gad mah thuih ih lok baktih toengah caeh tahang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ornan loe cang atit li moe, hnukbang angqoi naah, van kami to hnuk; a taengah kaom a capa palitonawk loe anghawk o king.
  </para>
  <para style="p">
    <verse number="21" style="v" />David loe Ornan khaeah caeh, Ornan mah anih to hnuk naah, cang atithaih to toengh sut moe, David hmaa ah long ah akuep.
  </para>
  <para style="p">
    <verse number="22" style="v" />David mah Ornan khaeah, Kai ih kaminawk nuiah nathaih to dip moe, Angraeng han hmaicam ka sak thai hanah, cang na tithaih ahmuen to atho hoiah na qansak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ornan mah David khaeah, La ah, ka angraeng siangpahrang mah a koeh ih hmuen to sah nasoe; khenah, hmai angbawnhaih paek hanah maitawnawk doeh kang paek; cang atit naah patoh ih thing doeh kang paek, angdaeh angbawnhaih sak hanah cang doeh kang paek; hmuennawk hae kang paek boih, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe David siangpahrang mah Ornan khaeah, To tih na ai, kakoep ah atho kang paek han; nang ih ahmuen to Angraeng hanah azom ah ka la mak ai, atho hoi qan ai ih hmuen hoiah angbawnhaih ka sah mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pongah David mah Ornan ih lawkhmuen qanhaih atho sui shekel cumvai tarukto paek.
  </para>
  <para style="p">
    <verse number="26" style="v" />David mah to ahmuen ah Angraeng hanah hmaicam to sak; hmai angbawnhaih hoi angdaeh angbawnhaih to a sak moe, Angraeng to kawk; Angraeng mah kawkhaih lok to van hoiah pathim pae, angbawnhaih hmaicam to hmai mah kangh pae.
  </para>
  <para style="p">
    <verse number="27" style="v" />Angraeng mah van kami khaeah lokthuih pae pongah, anih mah a sumsen to tabu thungah pacaeng let.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jebus acaeng Ornan ih cang atithaih ahmuen hoiah Angraeng mah lok pathim pae, tiah David mah panoek naah, to ahmuen ah angbawnhaih to sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />To nathuem ah Mosi mah praezaek ah sak ih Angraeng ih kahni im hoi hmai angbawnhaih hmaicam loe Gideon hmuensang ah ni oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe Angraeng ih van kami ih sumsen to zit pongah, David loe Sithaw lokdueng hanah hmabangah caeh thai ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />David mah, Hae ahmuen loe Angraeng Sithaw ih im ah oh moe, hae hmai angbawnhaih hmaicam doeh Israelnawk ih hmaicam ah oh, tiah thuih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel prae thungah kaom angvinnawk nawnto amkhueng hanah David mah lokpaek; anih mah Sithaw im sak hanah thlung sah kop kaminawk to tok paek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thok patomhhaih hoiah thok sakhaih sumdiknawk to sak hanah, tah laek ai sumkamling to a paek;
  </para>
  <para style="p">
    <verse number="4" style="v" />paroeai kapop sidar thing doeh a paek; Sidon hoi Tura vangpui ih kaminawk mah David hanah paroeai pop sidar thing to sin pae o.
  </para>
  <para style="p">
    <verse number="5" style="v" />David mah ka capa Solomon loe nawkta vop moe, saning doeh nawk vop, Angraeng han sak han ih im loe kalen kasawk im, prae boih ah ahmin kamthang, dawnrai koi kaom im ah om tih; im sak paroep hanah vaihi kam sak han, tiah a thuih. To pongah David loe dueh ai naah kalen parai im sak hanah paroephaih to tawnh.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah a capa Solomon to kawk moe, Israel Angraeng Sithaw im sak hanah lok a paek.
  </para>
  <para style="p">
    <verse number="7" style="v" />David mah Solomon khaeah, Ka capa, ka Angraeng Sithaw ih ahmin hanah im sak han poekhaih ka tawnh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe hae tiah Angraeng ih lok kai khaeah angzoh, Nang loe paroeai athii na longsak moe, pop parai misa to na tuk; ka mikhnukah long nuiah athii paroeai na longsak pongah, nang mah Kai ih ahmin hanah im na sah mak ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khenah, capa maeto na sah tih, anih loe poekmonghaih tawn kami ah om tih; anih taengah kaom a misanawk khae hoiah monghaih to ka paek han; anih ih ahmin loe Solomon, anih siangpahrang ah oh nathung, Israel khaeah monghaih hoi amdinghaih ka paek han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anih mah Ka hmin hanah im to sah tih; anih loe ka capa ah om ueloe, kai loe anih ih ampa ah ka om tih; anih ih angraeng tangkhang to Israel nuiah dungzan khoek to ka caksak han, tiah ang naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng loe, vaihi nang khaeah oh; anih mah thuih ih lok baktih toengah, na Angraeng Sithaw ih im to pacoeng karoek to sah ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na Angraeng Sithaw ih daan to pazui hanah, Angraeng mah palunghahaih hoi panoekthaihaih to paek nasoe loe, Israel uk thaihaih to na paek nasoe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng mah Israel kaminawk hanah, Mosi khae paek ih lok takroekhaih hoi daan to acoehaih hoi kahoih ah na pazui nahaeloe, hmacawn ueloe, sak na pacoeng thai tih; na thacaksak loe, palung thacaksak ah; zii hmah loe, palungboengsak hmah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khenah, vaihi raihaih thung hoi Angraeng ih im hanah sui talent sang cumvaito, phoisa sang sangto, tah laek ai sumkamling hoi sum; paroeai pop thing hoi thlungnawk doeh ka sak paroep boeh; nang mah sah thap ah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toksah kaminawk, thlung aat thaih kami, thlung tok sah kop kaminawk, thing tok sah thaih kaminawk, hmuen congca sah thaih kaminawk, paroeai na tawnh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sui, phoisa, sumkamling hoi sum sah kop kaminawk, kroek laek ai na tawnh. Angthawk ah loe, vaihi toksak amtong ah, Angraeng mah na oh thuih nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />David mah a capa Solomon abomh hanah Israel zaehoikungnawk to lokpaek,
  </para>
  <para style="p">
    <verse number="18" style="v" />nihcae khaeah, Nangmacae ih Angraeng Sithaw oh na ai maw? Ahmuen kruek hoiah monghaih ang paek na ai maw? Prae kaminawk ka ban ah paek baktih toengah, prae loe Angraeng hoi prae kaminawk hmaa ah paek boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vaihi nangmacae ih Angraeng Sithaw to pakrong hanah, na palungthin hoi poekhaih to paek oh; Angraeng ih ahmin hanah sak ih im thungah Angraeng lokkamhaih thingkhong hoi ciimcai Angraeng ih laom sabaenawk to suek hanah angthawk ah; Angraeng Sithaw ih hmuenciim to sah ah, tiah a naa.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />David loe mitong moe, saning coeh boeh pongah, a capa Solomon to Israel siangpahrang ah suek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel angraengnawk boih, qaimanawk hoi Levi acaengnawk to nawnto amkhuengsak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Saning quithumto hoi ranui bang kapha Levi acaengnawk to a kroek boih, sangqum boih ah nongpa sing thum, sang tazetto oh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hae kaminawk thung ih kami sing hnet, sang palito loe Angraeng ih im tok to sak o; sang tarukto loe angraeng hoi lok takroekkung ah oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kami sang palito loe khongkha toepkung ah oh o moe, kami sang palito loe ka paek ih atuen congca hoiah Angraeng to saphaw o tih, tiah David mah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />David loe Levi acaeng to angmacae acaeng baktih toengah abu abu ah tapraek; to kaminawk loe Gershom, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershom acaengnawk loe Ladan hoi Shimei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ladan loe caa thumto sak; calu Jehiel, Zetham hoi Joel.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shimei loe caa thumto sak; Helemoth, Haziel hoi Haran. Hae kaminawk loe Ladan imthung takoh thung ih lu koek ah oh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shimei ih capanawk loe Jahath, Zina, Jeush hoi Beriah. Hae kami palitonawk loe Shimei ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jahath loe calu koekah oh, Zizah loe hnetto haih ah oh; toe Jeush hoi Beriah loe capa kapop ah tawn hoi ai; to pongah nihnik loe ampa maeto ih imthung takoh milu cazin thungah ni athum hoi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kohath ih caanawk loe Amram, Izhar, Hebron hoi Uzziel; palito oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amram ih caanawk loe Aaron hoi Mosi. Aaron hoi anih ih caanawk loe dungzan ah kaciim koek hmuennawk to tathlangh o moe, Angraeng hmaa ah hmuihoih thlaek to hanah, anih hmaa ah toksak moe, dungzan ahmin hoiah tahamhoihhaih paek hanah pahoe o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sithaw kami Mosi ih caanawk loe Levi acaeng thungah kroek o hmaek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi ih caanawk loe Gershom hoi Eliezer.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gershom ih caanawk thungah Shebuel loe calu ah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eliezer ih caanawk thungah Rehabiah loe calu ah oh. Rehabiah ih caanawk loe pop o parai; toe Eliezer loe kalah capanawk to tawn ai boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izhar ih caanawk thungah Shelomith loe calu ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hebron ih caanawk thungah Jeriah loe calu ah oh; hnetto haih ah Amariah, thumto haih ah Jahaziel to oh moe, palito haih ah Jekameam to oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uzziel ih caanawk thungah Mikah loe calu ah oh; hnetto haih ah Jesiah to sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merari ih caanawk loe Mahli hoi Mushi. Mahli ih caanawk loe Eleazar hoi Kish.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eleazar loe capa tawn ai ah duek; canu khue ni a tawnh; anih ih canunawk loe amnawk Kish ih capanawk mah zu ah lak o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mushi loe caa thumto sak; Mahli, Eder hoi Jeremoth.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hae kaminawk loe saning pumphaeto hoi ranuih bang, Angraeng ih im ah toksah kami ah kaom, Levi acaeng thungah milu cazin kakun, acaeng zaehoikungnawk ah oh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />David mah, Israel Angraeng Sithaw mah angmah ih kaminawk khaeah anghakhaih to paek boeh moe, Angraeng angmah doeh Jerusalem ah dungzan ah oh boeh pongah,
  </para>
  <para style="p">
    <verse number="26" style="v" />Levi acaengnawk mah kahni im aput han angai ai, to ah toksak hanah laom sabaenawk phawh han angai ai boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hnukkhuem koek David mah paek ih loknawk baktih toengah, Levi acaengnawk loe saning pumphaeto hoi ranuih bang khue ni kroek o;
  </para>
  <para style="p">
    <verse number="28" style="v" />Angraeng ih im thungah toksakhaih, longhmanawk, imkhaannawk, ciimcai hmuennawk pasaehhaih, Sithaw imthung ah toksak naah, Aaron ih caanawk abomhaih loe Levi acaengnawk mah sak han koi tok ah oh:
  </para>
  <para style="p">
    <verse number="29" style="v" />caboi pongah patoem ih takaw, buh hoi angbawnhaih sak hanah takawdip, taeh thuh ai ih takaw, camphaek laom pongah paaem ih takaw, situi hoiah haek ih takaw, kazit tahhaih hoi kalen kasawk tahhaih hmuennawk sahkung ah a oh o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Akhawnbang kruek angdoet o moe, Angraeng khaeah anghoehaih lok to a thuih o; duembangah doeh to tiah a sak o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Angraeng mah paek ih lok baktih toengah, Sabbath ni, khrah kangtha ni, poih sakhaih ni kruek, apet ai ah Angraeng hmaa ah hmai angbawnhaih boih to sah o tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Levi acaengnawk mah kaminawk amkhuenghaih kahni im, hmuenciim hoi Angraeng im thungah toksah angmacae nawkamya Aaron ih caanawk to khetzawn o.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aaron ih caanawk tapraekhaih dan loe hae tiah oh. Aaron ih caanawk loe Nadab, Abihu, Eleazar hoi Ithamar.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toe Nadab hoi Abihu loe caa sah hoi ai, nihnik loe ampa dueh ai naah duek hoi ving boeh; to pongah Eleazar hoi Ithamar mah qaima tok to sak hoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />David mah Eleazar acaeng Zadok hoi Ithamar acaeng Ahimelek hanah a sak hoi han koi tok to paek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ithamar ih caanawk pongah loe Eleazar ih caanawk thung hoiah zaehoikung toksah kami to pop kue; nihcae loe angmacae sak han koi tok to amzet o. Eleazar caanawk thung hoiah zaehoikung hatlai tarukto oh moe, Ithamar caanawk thung hoiah zaehoikung tazetto oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmuenciim ukkung hoi Sithaw im ukkung tok to, Eleazar hoi Ithamar caanawk salakah, taham khethaih phoisa vahhaih hoiah amzet o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi acaeng Nethanel capa ca tarikkung Shemaiah mah, siangpahrang, angraengnawk, qaima Zadok, Abiathar capa Ahimelek hoi qaima Levi ih caanawk, zaehoikungnawk hmaa ah nihcae ih ahmin to tarik; Eleazar imthung takoh hoiah imthong maeto, Ithamar imthung takoh thung hoiah imthong maeto a lak o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vah ih taham khethaih phoisa loe Jehoiarib khaeah amtimh hmaloe, hnetto haih loe Jedaiah khaeah,
  </para>
  <para style="p">
    <verse number="8" style="v" />thumto haih loe Harim khaeah, palito haih loe Seorim khaeah,
  </para>
  <para style="p">
    <verse number="9" style="v" />pangato haih loe Malkijah khaeah, tarukto haih loe Mijamin khaeah,
  </para>
  <para style="p">
    <verse number="10" style="v" />sarihto haih loe Hakkoz khaeah, tazetto haih loe Abijah khaeah,
  </para>
  <para style="p">
    <verse number="11" style="v" />takawtto haih loe Jeshua khaeah, hato haih loe Shekaniah khaeah,
  </para>
  <para style="p">
    <verse number="12" style="v" />hatlaito haih loe Eliashib khaeah, hatlaihnetto haih loe Jakim khaeah,
  </para>
  <para style="p">
    <verse number="13" style="v" />hatlaithumto haih loe Huppah khaeah, hatlaipalito haih loe Jeshebeab khaeah,
  </para>
  <para style="p">
    <verse number="14" style="v" />hatlaipangato haih loe Bilgah khaeah, hatlaitarukto haih loe Immer khaeah,
  </para>
  <para style="p">
    <verse number="15" style="v" />hatlaisarihto haih loe Hezir khaeah, hatlaitazetto haih loe Happizzez khaeah,
  </para>
  <para style="p">
    <verse number="16" style="v" />hatlaitakawtto haih loe Pethahiah khaeah, pumphaeto haih loe Jehezekel khaeah,
  </para>
  <para style="p">
    <verse number="17" style="v" />pumphae maeto haih loe Jakin khaeah, pumphae hnetto haih loe Gamul khaeah,
  </para>
  <para style="p">
    <verse number="18" style="v" />pumphae thumto haih loe Delaiah khaeah, pumphae palito haih loe Maaziah khaeah amtimh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel Angraeng Sithaw mah angmacae ih amsae Aaron khaeah paek ih lok baktih, angmacae ih amsae Aaron mah sak ih baktih toengah, toksak hanah nihcae loe Angraeng imthung ah angzoh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kalah Levi acaengnawk loe Amram ih caanawk thung hoiah Shubael; Shubael ih caanawk thung hoiah Jehdeiah to oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rehabiah ih caanawk thung hoiah Isshiah loe calu ah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izhar acaeng thung hoiah Shelomoth; Shelomoth ih caanawk thung hoiah Jahath to oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hebron ih caanawk thung hoiah Jeriah loe calu ah oh; hnetto haih ah Amariah; thumto haih ah Jahaziel to oh moe, palito haih ah Jekameam to oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Uzziel ih caa loe Mikah; Mikah ih caanawk thung hoiah Shamir.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mikah ih amnawk loe Isshiah; Isshiah ih caanawk thung hoiah Zekariah to oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Merari ih caanawk loe Mahli hoi Mushi; Jaaziah capa loe Beno.
  </para>
  <para style="p">
    <verse number="27" style="v" />Merari ih caanawk, Jaaziah khae hoiah Beno, Shoham, Zakkur hoi Ibri to oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mahli khae hoiah Eleazar to oh, anih loe capa tawn ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kish khae hoiah Kish ih capa loe Jerahmeel.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mushi ih caanawk loe Mahli, Eder hoi Jerimoth. Hae kaminawk ih imthung takoh loe Levi acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hae kaminawk loe David siangpahrang, Zadok, Ahimelek, qaimanawk hoi Levi acaeng zaehoikung hmaa ah, angmacae nawkamya ih caanawk boih kangvan ah taham khethaih phoisa to vah o.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />David mah angmah ih misatuh angraeng Asaph, Heman hoi Jeduthun ih capanawk to aqui pop katoeng kruek kami, cingceng bop kami hoi tamoi ueng kami, lok taphong kami, tiah tok tapraek pae. Hae toksah kaminawk ih ahmin loe,
  </para>
  <para style="p">
    <verse number="2" style="v" />Asaph ih caa Zakkur, Joseph, Nethaniah hoi Asarelah; nihcae loe siangpahrang mah paek ih lok baktih toengah ampa Asaph zaehhoihaih thungah oh o moe, lok to taphong o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jeduthun ih caanawk loe Gedaliah, Zeri, Jeshaiah, Hashabiah hoi Mattithiah, sangqum boih ah tarukto oh o; nihcae loe ampa zaehhoihaih thungah oh o moe, katoeng kruek hoiah lok to taphong o; Angraeng khaeah anghoehaih lok to a thuih o moe, ahmin to saphaw o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Heman ih caanawk loe Bukkiah, Mattaniah, Uzziel, Shebuel, Jerimoth, Hananiah, Hanani, Eliathah, Giddalti hoi Romamti-Ezer, Joshbekashah, Mallothi, Hothir hoi Mahazioth.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hae kaminawk loe taki to uengh o, nihcae loe Sithaw lok taphong siangpahrang ih tahmaa Heman capanawk ah oh o; Sithaw mah Heman hanah capa hatlaipalito hoi canu thumto paek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hae kaminawk boih loe Asaph, Heman hoi Jeduthun khaeah siangpahrang mah paek ih lok baktih toengah, ampanawk zaehhoihhaih tlim ah Angraeng im ah katoeng kruekhaih, laasakhaih, cingceng bohhaih, aqui pop katoeng kruekhaih, katoeng congca kruekhaih hoiah Angraeng im ah toksah kami ah oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae hoi nawnto Angraeng ih laa kamtuk, angmacae ih nawkamyanawk loe kami cumvai hnet, quitazet, tazetto oh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae loe angmacae sak han koi taham to khet hanah, kathoeng doeh, kalen doeh, patukkung doeh, amtuk kami doeh phoisa to vah o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmaloe koek ih phoisa loe Asaph ih kami Joseph hanah vah o; hnetto haih loe Gedaliah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="10" style="v" />thumto haih loe Zakkur hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="11" style="v" />palito haih loe Izri hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="12" style="v" />pangato haih loe Nethaniah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="13" style="v" />tarukto haih loe Bukkiah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="14" style="v" />sarihto haih loe Jesarelah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="15" style="v" />tazetto haih loe Jeshaiah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="16" style="v" />takawtto haih loe Mattaniah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="17" style="v" />hato haih loe Shimei hanah, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="18" style="v" />hatlai to haih loe Azarel hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="19" style="v" />hatlaihnetto haih loe Hashabiah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="20" style="v" />hatlaithumto haih loe Shubael hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="21" style="v" />hatlaipalito haih loe Mattithiah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="22" style="v" />hatlaipangato haih loe Jeremoth hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="23" style="v" />hatlaitarukto haih loe Hananiah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="24" style="v" />hatlai sarihto haih loe Joshbekashah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="25" style="v" />hatlaitazetto haih loe Hanani hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="26" style="v" />hatlaitakawtto haih loe Mallothi hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="27" style="v" />pumphaeto haih loe Eliathah hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="28" style="v" />pumphae maeto haih loe Hothir hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="29" style="v" />pumphae hnetto haih loe Giddalti hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh;
  </para>
  <para style="p">
    <verse number="30" style="v" />pumphae thumto haih loe Mahazioth hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh,
  </para>
  <para style="p">
    <verse number="31" style="v" />pumphae palito haih loe Rommam-Ezer hanah vah o, anih loe capanawk hoi nawkamya hatlaihnetto tawnh.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Korah acaeng thung hoiah Asaph capa Kore, anih ih capa Meshelemiah to khongkha toep kami ah tok paek o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meshelemiah ih caanawk loe calu Zekariah, hnetto haih ah Jediael, thumto haih Zebadiah, palito haih ah Jathniel,
  </para>
  <para style="p">
    <verse number="3" style="v" />pangato haih ah Elam, tarukto haih ah Jehohanan hoi sarihto haih ah Elioenai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Obed-Edom ih caanawk loe, calu Shemaiah, hnetto haih ah Jehozabad, thumto haih ah Joah, palito haih ah Sakar, pangato haih ah Nethanel,
  </para>
  <para style="p">
    <verse number="5" style="v" />tarukto haih ah Ammiel, sarihto haih ah Issakar, tazetto haih ah Peulthai; anih loe Sithaw mah tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih ih capa Shemaiah mah doeh caa sak; nihcae loe thacak kami ah oh o pongah, ampa ih imthung takoh zaehoikung ah oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shemaiah ih caanawk loe Othni, Rephael, Obed hoi Elzabad; anih ih nawkamyanawk loe Elihu hoi Semakiah, nihnik loe thacak kami ah oh hoi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hae kaminawk boih loe Obed-Edom ih caa ah oh o; angmacae hoi a caanawk pacoengah kaom nawkamyanawk loe thacak o moe, toksah kop kami ah oh o, sangqum boih ah quitaruk, hnetto oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thacak Meshelemiah ih caanawk hoi nawkamyanawk loe sangqum boih ah hatlaitazetto oh o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Merari ih caa Hosah mah doeh capanawk to sak; Simri loe calu ah oh, (anih loe tapen hmaloe kami na ai ni, toe ampa mah calu ah suek:)
  </para>
  <para style="p">
    <verse number="11" style="v" />hnetto haih ah Hilkiah, thumto haih ah Tebaliah, palito haih ah Zekariah; Hosah ih capanawk hoi nawkamyanawk loe sangqum boih ah hatlaithumto oh o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hae kaminawk loe Angraeng ih im toep hanah abu tapraek ih, khongkha toep lu koek ah oh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kathoeng doeh kalen doeh, khongkha to toep o boih hanah, angmacae imthung takoh boih mah taham khethaih phoisa to vah o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ni angyae bang ih khongkha to toep hanah phoisa vah naah Shelemiah khaeah amtimh. To pacoengah kahoih poekhaih paekkung, a capa Zekariah doeh phoisa vah naah, aluek bang ih khongkha toep hanah phoisa to anih khaeah amtimh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aloih bang ih khongkha toep hanah phoisa loe Obed-Edom khaeah amtimh moe, Asuppim hmuenmae khetzawnhaih toksak hanah phoisa to anih ih capanawk khaeah amtimh pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />Niduem bang ih khongkha hoi aluek bang ih loklam nuiah kaom Shalleketh khongkha to toep hanah, phoisa to vah naah Shuppim hoi Hosah khaeah amtimh. Khongkha toep kami loe khongkha maeto pacoeng maeto a toep o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ni thokkruek ni angyae bangah Levi kami tarukto, aluek bangah palito, aloih bangah palito, Asuppim hmuenmae suekhaih ahmuen ah hnetto a suek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Niduem bang ih longhmaa ah kami palito suek moe, loklam ranuiah palito, longhmaa ah hnetto a suek.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hae kaminawk loe Kore hoi Merari ih caanawk thung hoiah tapraek ih khongkha toep kami ah oh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Levi acaeng Ahijah loe Sithaw im ih phoisa pakuemgkung hoi Sithaw han paek ih hmuenmae khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Acaeng zaehoikung ah kaom Gershom acaeng, Laadan ih capanawk thungah Jehieli hoi,
  </para>
  <para style="p">
    <verse number="22" style="v" />Jehieli ih capanawk, Zetham hoi anih ih amnawk Joel loe Angraeng im thung ih phoisa pakuemkung ah oh hoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kalah phoisa pakuem kaminawk loe Amram ih acaeng, Izhar ih acaeng, Hebron ih acaengnawk hoi Uzziel ih acaengnawk to athum o:
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi capa Gershom, Gershom capa Shubael loe phoisa pakuem kami ukkung ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gershom ih amnawk Eliezer, Eliezer capa Rehabiah, anih ih capa Jeshaiah, anih ih capa Joram, anih ih capa Zikri, anih loe Shelomith ih capa ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shelomith hoi anih ih nawkamyanawk loe David siangpahrang, acaeng zaehoikung kaminawk, misatuh kami cumvaito ukkung, misatuh kami sangto ukkung angraengnawk hoi misatuh angraengnawk mah paek ih hmuenmaenawk khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Misatuk naah lak o ih hmuenmaenawk to Angraeng im pathoep hanah paek o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tahmaa Samuel mah paek ih hmuennawk boih, Kish capa Saul mah paek ih hmuennawk boih, Ner capa Abner hoi Zeruiah capa Joab mah paek ih hmuennawk loe Shelomith hoi anih ih amnawk mah pakuem boih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Izhar acaeng hoi Kenaniah ih capanawk loe Israel prae tasa bangah tok sah, angraeng hoi lokcaekkung ah oh o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hebron acaeng Hashabiah hoi nawkamyanawk loe, thacak kami ah oh o moe, sang cumvai sarihto oh o; nihcae loe Jordan vapui niduem bang ih Israel prae thungah Angraeng ih tok hoiah siangpahrang ih tok to a sak o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hebron acaeng thungah loe, acaeng ahmin pakuemhaih baktih toengah, Jeriah loe nihcae zaehoikung lu koek ah oh. David siangpahrang ah ohhaih saning quipalito naah, ahmin pakuemhaih cabu thungah nihcae ih acaeng to pakrong o naah, nihcae loe Gilead prae Jazer vangpui ah kaom thacak kaminawk ni, tiah amtueng.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jeriah ih nawkamyanawk loe thacak o; acaeng zaehoikung lu koek ah oh o moe, kami sang hnet, cumvai sarihto oh o; David siangpahrang mah nihcae to Rueben kami, Gad kami, thoemto Manasseh kaminawk to uksak moe, Sithaw ih congca hmuenmae hoi siangpahrang ih hmuenmae khenzawnkung ah suek.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Siangpahrang toksah Israel kaminawk loe, acaeng zaehoikungnawk, misatuh kami sangto ukkung hoi cumvaito ukkung misatuh angraengnawk, toksah angraengnawk hoi nawnto, saningto thung khrah kruek tacawt moe, kakun siangpahrang ih toksah hanah tapraek ih kami ah oh o, nihcae loe abu maeto naah kami sing hnet, sang palito oh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khrah tangsuek, hmaloe koek zaehoikung loe, Zabdiel capa Jashoebeam; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih loe Perez acaeng ah oh moe, hmaloe koek khrah ah kaminawk zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khrah hnetto haih misatuh zaehoikung loe, Ahoh acaeng Dodai; Mikloth loe anih ih kami zaehoikung ah oh; anih ih kami loe sing hnet, sang palito to oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khrah thumto haih misatuh zaehoikung angraeng loe, qaima kalen koek, Jehoiada capa Benaiah; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benaiah loe kami quithumto thungah, thacak kami ah oh moe, quithumto zaehoikung ah oh; a capa Amizabad loe kami zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khrah palito naah, palito haih misatuh zaehoikung angraeng loe, Joab ih amnawk Asahel; angmah pacoengah loe a capa Zebadiah to oh; anih ih kaminawk loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pangato haih khrah naah, pangato haih misatuh zaehoikung angraeng loe, Izrah acaeng Shamhuth; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khrah tarukto haih naah, tarukto haih misatuh zaehoikung angraeng loe, Teko acaeng Ikkesh capa Ira; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khrah sarihto haih naah, sarihto haih misatuh zaehoikung angraeng loe, Ephraim kami, Pelon acaeng Helez; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khrah tazetto haih naah, tazetto haih misatuh zaehoikung angraeng loe Zera acaeng, Hushath kami, Sibbekai; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khrah takawtto haih naah, takawtto haih misatuh zaehoikung angraeng loe Benjamin acaeng, Anathoth kami Abiezer; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khrah hato haih naah, hato haih misatuh zaehoikung angraeng loe Zerah acaeng, Netophath kami Maharai; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khrah hatlaito haih naah, hatlaito haih misatuh zaehoikung angraeng loe Ephraim acaeng, Pirathon kami Benaiah; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khrah hatlaihnetto haih naah, hatlaihnetto haih misatuh zaehoikung angraeng loe, Othniel acaeng, Netophath kami, Heldai; anih ih kami loe sing hnet, sang palito oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel acaeng nuiah angraeng ah kaom kaminawk loe Reuben acaeng thungah, Zikri capa Eliezer; Simeon acaeng thungah Maakah capa Shephatiah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Levi acaeng thungah Kemuel capa Hashabiah; Aaron acaeng thungah Zadok,
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah acaeng thungah David amnawk Elihu; Issakar acaeng thungah Mikael capa Orim,
  </para>
  <para style="p">
    <verse number="19" style="v" />Zebulun acaeng thungah Obadiah capa Ishmaiah; Naphtali acaeng thungah Azriel capa Jerimoth,
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim acaeng thungah Azaziah capa Hoshea; thoemto Manasseh acaeng thungah Pedaiah capa Joel,
  </para>
  <para style="p">
    <verse number="21" style="v" />Gilead ah kaom thoemto Manasseh acaeng thungah Zekariah capa Iddo; Benjamin acaeng thungah Abner capa Jaasiel.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan acaeng thungah Jehoram capa Azarel. Hae kaminawk loe Israel acaeng thungah angraeng ah oh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah Israel kaminawk loe van ih cakaehnawk zetto pop tih, tiah thuih pongah, David mah saning pumphaeto hoi atlim bang kaminawk boih loe kroek ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeruiah capa Joab mah milu to kroek amtong; toe milu kroek naah Israel nuiah palungphuihaih phak pongah, milu kroek pacoeng thai ai; kroek pacoeng ih milu doeh David siangpahrang mah sak ih pakuemhaih cabu thungah khrum o ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adiel capa Azmaveth loe siangpahrang im hmuenmae toepkung ah oh; Uzziah capa Jonathan loe laikok, vangpui, vangta hoi misatoephaih ahmuen ih hmuenmae patunghaih ahmuen khenzawnkung ah oh;
  </para>
  <para style="p">
    <verse number="26" style="v" />Kelub capa Ezri loe lawk thung ih toksah kaminawk ukkung ah oh;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ramath acaeng Shimei loe misur takha khenzawnkung ah oh; Shipmi kami Zabdi loe misur takha hoi muroih thungah suek ih misurthaih pasawhhaih khenzawnkung ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Geder acaeng Baal-Hanan loe, azawn ah kaom olive thingnawk hoi thaibaa thingnawk khenzawnkung ah oh; Joash loe olive situi pazetkung ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sharon acaeng Shitrai loe Sharon ah kaom pacah ih moinawk khenzawnkung ah oh moe, Adlai capa Shaphat loe azawn ah kaom pacah ih moinawk khenzawnkung ah oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ishmael acaeng Obil loe kaengkuu hrangnawk khenzawnkung ah oh; Meronoth acaeng Jehdeiah loe laa hrangnawk khenzawnkung ah oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hagar acaeng Jaziz loe tuunawk khenzawnkung ah oh. Hae kaminawk boih loe David siangpahrang ih hmuenmae khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />David ih ampa kanawk Jonathan loe khopoek thaih, palungha ca tarikkung ah oh; Hakmoni capa Jehiel loe siangpahrang ih capanawk khenzawnkung ah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahithophel loe siangpahrang han poekhaih kahoih paekkung ah oh moe, Arka acaeng Hushai loe siangpahrang ampui ah oh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahithophel paoengah Benaiah capa Jehoiada hoi Abiathar to oh hoi; Joab loe siangpahrang ih misatuh kaminawk ukkung kalen koek angraeng ah oh.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />David mah Israel angraengnawk boih, acaeng zaehoikung, siangpahrang toksah misatuh angraengnawk, sangto hoi cumvaito ukkung misatuh angraengnawk, hmuenmaenawk boih khenzawnkung, siangpahrang hoi a capanawk ih hmuenmae khenzawnkung, siangpahrang imthung ah toksah angraengnawk, thacak kaminawk hoi misahoih misatuh kaminawk boih Jerusalem ah nawnto amkhuengsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />David siangpahrang loe angdoet moe, Kam nawkamya hoi kaimah ih kaminawk, ka lok hae tahngai oh; aicae Sithaw khok koenghaih hoi Angraeng lokkamhaih thingkhong suekhaih im sak hanah poekhaih ka tawnh pongah, im sak hanah kam sak coek boeh;
  </para>
  <para style="p">
    <verse number="3" style="v" />toe Sithaw mah kai khaeah, Nang loe misatuh kami hoi athii palongh kami ah na oh pongah, Ka hmin hanah nang mah im na sah mak ai, tiah ang naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe Israel Angraeng Sithaw mah, Israel siangpahrang ah oh poe hanah, kam pa ih imthung takoh boih thung hoiah kai hae ang qoih boeh; zaehoikung ah oh hanah anih mah Judah to qoih boeh; Judah imthung takoh thung hoiah kam pa imthung takoh to a qoih; kam pa ih capanawk thung hoiah kai hae Israelnawk boih ukkung siangpahrang ah ang paek.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka capanawk boih thungah, (Angraeng mah kai hanah pop parai capa ang paek), Angraeng ukhaih prae ih angraeng tangkhang nuiah anghnut moe, Israel to uk hanah ka capa Solomon to a qoih boeh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah kai khaeah, Na capa Solomon mah ni kai ih im hoi longhma to sah tih; anih to ka capa ah ka qoih boeh pongah, kai loe anih ih ampa ah ka om tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vaihniah sak ih baktih toengah, ka paek ih loknawk hoi ka lokcaekhaihnawk to amkhraeng taak ai nahaeloe, a prae to dungzan khoek to ka caksak han, tiah ang naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah vaihi Israel kaminawk boih mikhnukah, Angraeng hmaa hoi Sithaw hmaa ah amkhueng kaminawk hmaa ah lok kang paek o; na Angraeng Sithaw mah paek ih loknawk to pakrong oh loe pazui oh; to tiah nahaeloe hae prae kahoih hae na toep o ueloe, na caanawk hanah dungzan khoek to qawk ah na paek o thai tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang ka capa, Solomon, nam pa ih Sithaw to panoek ah loe, poekhaih boih hoi palungthin tang hoiah anih ih tok to sah ah; Angraeng loe kaminawk boih ih palungthin to pakrong, kami palung thung ih poekhaihnawk to panoek boih; anih to na pakrong nahaeloe, na hnu tih; toe anih to na caeh taak nahaeloe, anih mah nang to dungzan khoek to na pahnawt sut tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vaihi acoe ah; hmuenciim im sak hanah Angraeng mah nang ang qoih boeh; na thacakhaih hoiah tok to sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah im sak han ih krang, impui, hmuenmae suekhaih ahmuennawk, tasa bang ih imkhaannawk, athung bang ih imkhaannawk hoi palungnathaih ahmuen sakhaih dan to a paek;
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng im longhmanawk; ataeng ih imkhaannawk, Sithaw im ih hmuenmae pakuemhaih ahmuennawk, tathlang ih hmuennawk pakuemhaih ahmuennawk sakhaih dan to Muithla mah anih hanah paek boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Qaimanawk hoi Levi acaengnawk tapraekhaih, Angraeng im thungah toksakhaih, Angraeng im thungah patoh han ih laom sabae sakhaihnawk boih doeh a thuih pae.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toksakhaih lah boih baktih toengah, to tiah toksak naah patoh han ih hmuen sak han kangaih sui hoi phoisa to tah moe, a paek;
  </para>
  <para style="p">
    <verse number="15" style="v" />hmaithawk paanghaih sui tungnawk hoi hmai-imnawk sak hanah, kangai zetto sui to tah moe, a paek, to tiah hmaithawk tung hoi hmai-im maeto sak han angaih zetto phoisa to tah moe, a paek.
  </para>
  <para style="p">
    <verse number="16" style="v" />Takaw suekhaih sui caboi maeto sak han angaih zetto sui to tah moe, a paek baktih toengah, phoisa caboi maeto sak han angaih zetto sumkanglung to tah moe, a paek;
  </para>
  <para style="p">
    <verse number="17" style="v" />moi banghhaih cakoihnawk, kathuk boengloengnawk hoi tui boengloengnawk sak hanah kaciim sui to a paek moe, sui sabae maeto sak han angaih zetto sui to tah moe, a paek baktih toengah, sumkanglung sabae maeto sak han angaih zetto sumkanglung to tah moe, a paek;
  </para>
  <para style="p">
    <verse number="18" style="v" />hmuihoih thlaekhaih hmaicam sak hanah kaciim sui to tah moe, a paek baktih toengah, pakhraeh atoeng tahang, Angraeng lokkamhaih thingkhong kakhuk, cherubim krang kaom hrangleeng sak hanah, sui to tah moe, a paek.
  </para>
  <para style="p">
    <verse number="19" style="v" />David mah, Angraeng ih ban ka nuiah oh pongah, hae hmuen sak han kamtueng krang, panoek thaihaih to ang paek, tiah thuih.
  </para>
  <para style="p">
    <verse number="20" style="v" />David mah a capa Solomon khaeah, Thacaksak ah loe, misahoihaih hoiah tok to sah ah; zii hmah loe, palung doeh boengsak hmah; na Angraeng Sithaw, ka Sithaw loe nang khaeah oh; Angraeng ih im sak hanah tok pacoeng ai karoek to anih mah na caeh taak mak ai ueloe, toksak pacoeng ai ah omsak mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khenah, qaimanawk hoi Levi acaengnawk loe Sithaw im toksak hanah, nang hoi nawnto om o tih; bantok sah kop kaminawk boih mah doeh, hmuen boih sakhaih bangah na bomh o tih; angraengnawk hoi rangpuinawk boih doeh na thuih ih lok baktih toengah om o tih, tiah a naa.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah David siangpahrang mah kamkhueng kaminawk boih khaeah, Sithaw mah qoih ih, ka capa Solomon loe nawkta moe, saning doeh nawk vop; sak han koi tok loe len parai; siangpahrang im loe kami han ih na ai, Angraeng Sithaw han ih ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Sithaw ih im hanah sui hoi sak han koi hmuen to sui, sumkanglung hoi sak han koi hmuen to sumkanglung, sumkamling hoi sak han koi hmuen to sumkamling, sum hoi sak han koi hmuen to sum, thing hoi sak han koi hmuen to thing, thlung hoi sak han koi hmuen to Onyx thlung, rong kampha thlung, rong congca kampha thlung, atho kaom congca thlung hoi thlung kanglungnawk doeh, ka sak thai thung paroeai sak hanah ka paroep boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka Sithaw bokhaih im ah palung ka suek pongah, ciimcai im sakhaih hmuennawk loe ka tawnh ih hmuennawk, im sak han ka paroep ih sui hoi sumkanglung to ka Sithaw ih im ah ka paek boih boeh,
  </para>
  <para style="p">
    <verse number="4" style="v" />tasa bang hoiah im tapang pazut hanah, ophir sui talent sang thumto, atui kaciim sumkanglung talent sang sarihto,
  </para>
  <para style="p">
    <verse number="5" style="v" />sui hoi sak han koi hmuennawk to sui, sumkanglung hoi sak han koi sumkanglung to, ban toksah kop kaminawk khaeah ka paek boih boeh. Mi maw vaihniah Angraeng khae angpaek han ka koeh? tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah imthung takoh lu koek, Israel acaeng angraengnawk, misatuh kami sangto ukkung, cumvaito ukkung angraengnawk hoi siangpahrang toksah ukkungnawk loe anghoehaih hoiah angpaek o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae loe Sithaw im toksak haih hanah, sui talent sang pangato, sui darik sang hato, sumkanglung talent sang hato, sumkamling talent sang hatlaitazetto hoi sum talent sang cumvaito a paek o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Atho kana thlung tawn kaminawk doeh, Gershom acaeng Jehiel ban ah, Angraeng im ih hmuen pakuemhaih ahmuen ah a paek o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaminawk loe paek koehhaih hoiah paek o pongah anghoe o; Angraeng khaeah paawt ai ah palung tang hoiah a paek o; David siangpahrang doeh paroeai anghoehaih hoiah oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />David mah rangpui hmaa ah, Kaicae ampa Israel ih Angraeng Sithaw, nang khaeah dungzan khoek to, tahamhoihaih om nasoe, tiah Angraeng to tahamhoihaih paek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Angraeng, nang loe lenhaih, thacakhaih, pakoehhaih, pazawkhaih hoi ranui koekah lensawkhaih ah oh; long hoi van ah kaom hmuennawk boih loe nang ih ni; Aw Angraeng, nang mah na uk moe, kaminawk boih nuiah na oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraenghaih hoi pakoehhaih loe nang khae hoiah ni angzoh; nang loe hmuennawk boih ukkung ah na oh; kaminawk boih na lensak, thacakhaih paek hanah, na ban ah sakthaihaih hoi thacakhaih to oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah vaihi, kaicae ih Sithaw, nang to tahamhoihaih kang paek o moe, na hmin lensawkhaih kang pakoeh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Paek koehhaih palung hoiah hae tih khoek to ka paek o thai hanah, kai hoi kai ih kaminawk loe kawbaktih kami ah maw ka oh o? Hmuen boih loe nang khae hoiah ni angzoh, na ban hoi ka hnuk o ih hmuen ni nang khaeah kang paek o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaicae loe kam panawk baktiah na hmaa ah angvin ah ni ka oh o; long ah kaicae hinghaih loe tahlip baktiah ni oh, oep han koi om ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw kaicae ih Angraeng Sithaw, ciimcai na hmin hanah, na im sak ka paroep o haih hae hmuennawk boih loe na ban hoiah ni angzoh, hmuennawk boih loe nang ih ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka Sithaw, nang loe palung to na khingh moe, toenghaih to nang hoe haih, tiah ka panoek. Kai loe hae hmuennawk boih hae poek toenghaih hoi paek koehhaih palungthin hoiah ni kang paek; vaihi hae ah kaom nangmah ih kaminawk mah paek koehhaih palungthin hoiah nang khaeah paek o ih hmuen hae anghoehaih hoiah ka hnuk boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw kaicae ampa Abraham, Issak hoi Israel ih Angraeng Sithaw, hae tiah hmuenmae paek koehhaih palungthin hae nangmah ih kaminawk palung thungah omsak poe ah loe, nihcae ih palungthin doeh nang khaeah omsak ah;
  </para>
  <para style="p">
    <verse number="19" style="v" />na paek ih loknawk, na thuih ih loknawk hoi na lok takroekhaih dannawk to palungthin boih hoiah pazui moe, sak ka tim ih siangpahrang im to a sak pacoeng thai hanah, ka capa Solomon khaeah kakoep palungthin to paek ah, tiah lawkthuih.
  </para>
  <para style="p">
    <verse number="20" style="v" />To pacoengah David mah rangpuinawk khaeah, Na Angraeng Sithaw to tahamhoihaih paek oh, tiah a naa. To pongah kaminawk boih mah ampanawk ih Sithaw to bok o moe, Angraeng hoi siangpahrang hmaa ah akuep o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khawnbangah Angraeng khaeah hmuen tathlanghaih to sak o, Angraeng khaeah hmai angbawnhaih to a sak o; maitaw tae sangto, tuu tae sangto, tuucaa sangto, naek koi hmuennawk, angbawnhaih hmuen paekhaihnawk to Israel caanawk boih hanah paek o.
  </para>
  <para style="p">
    <verse number="22" style="v" />To na niah Angraeng hmaa ah anghoehaih hoiah a caak o moe, naek o. To pacoengah a capa Solomon to vai hnetto haih ah, siangpahrang ah suek o let; Angraeng hmaa ah, ukkung ah situi to bawh o moe, tok paek o pacoengah Zadok to qaima ah cak o sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pongah Solomon loe, ampa David zuengah, angraeng tangkhang pongah siangpahrang ah anghnut; a qoengh tahang moe, Israel kaminawk boih mah anih ih lok to tahngaih pae o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Angraengnawk boih hoi thacak kaminawk, David siangpahrang capanawk boih mah doeh, Solomon siangpahrang khaeah ang paek o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel kaminawk boih mikhnukah Angraeng mah Solomon to tapom tahang, Israel siangpahrangnawk mah tawn o vai ai ih lensawk siangpahrang to paek.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesse capa David loe Israel kaminawk boih nuiah siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israel kaminawk to saning quipalito uk; Hebron ah saning sarihto uk moe, Jerusalem ah saning quithum, thumto uk.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anih loe saning kasawkah hing; angraenghaih hoi pakoehhaih hoiah oh moe, mitong naah duek; anih zuengah a capa Solomon to siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khenah, David siangpahrang ah oh naah, toksakhaihnawk loe amtonghaih hoi boeng khoek to, tahmaa Samuel, tahmaa Nathan hoi tahmaa Gad ih cabu thung ah oh,
  </para>
  <para style="p">
    <verse number="30" style="v" />anih ukhaih hoi a lensawkhaih, angmah hoi Israel kaminawk hoiah kalah praenawk nuiah kaom hmuennawk kawng to tarik o.
  </para>
</usx>
