<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Nambar</book>
  <para style="h">Nambar</para>
  <para style="toc1">Nambar</para>
  <para style="toc2">Nambar</para>
  <para style="mt">Nambar</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel kaminawk Izip prae thung hoi tacawthaih saning hnet, khrah hnetto haih hmaloe koek niah, Sinai praezaek ih kaminawk amkhuenghaih kahni imthung ah, Angraeng mah Mosi khaeah hae tiah lokthuih pae,
  </para>
  <para style="p">
    <verse number="2" style="v" />nawnto amkhueng Israel kaminawk thungah, angmacae acaeng hoi angmacae imthung takoh thung ih nongpanawk boih,
  </para>
  <para style="p">
    <verse number="3" style="v" />nang hoi Aaron mah saning pumphaeto pacoeng ranui bang kaom, misatuh thaih Israel kaminawk boih to milu kok hoih, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Acaeng maeto thung ih acaeng zaehoikung lu koek kami maeto mah nang hnik to abom o tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Milu kroek naah nang hnik hoi nawnto angdoe han kami ahminnawk loe, Reuben acaeng thung hoiah Shedeur capa Elizur.
  </para>
  <para style="p">
    <verse number="6" style="v" />Simeon acaeng thung hoiah, Zurishaddai capa Shelumiel.
  </para>
  <para style="p">
    <verse number="7" style="v" />Judah acaeng thung hoiah, Amminadab capa Nahshon.
  </para>
  <para style="p">
    <verse number="8" style="v" />Issakar acaeng thung hoiah, Zuar capa Nathanel.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulun acaeng thung hoiah, Helon capa Eliab.
  </para>
  <para style="p">
    <verse number="10" style="v" />Joseph ih caanawk; Ephraim acaeng thung hoiah, Ammihud capa Elishama; Manasseh acaeng thung hoiah, Pedahzur capa Gamaliel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Benjamin acaeng thung hoiah, Gideoni capa Abidan.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan acaeng thung hoiah, Amishaddai capa Ahiezer.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher acaeng thung hoiah, Okran capa Pagiel.
  </para>
  <para style="p">
    <verse number="14" style="v" />Gad acaeng thung hoiah, Deuel capa Eliasaph.
  </para>
  <para style="p">
    <verse number="15" style="v" />Naphtali acaeng thung hoiah, Enan capa Ahira cae hae ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hae kaminawk loe amkhueng kaminawk salakah ahmin kamthang, acaeng zaehoikung hoi Israel kaminawk lu koek ah oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />To tiah ahmin paek ih kaminawk to Mosi hoi Aaron mah kawk moe,
  </para>
  <para style="p">
    <verse number="18" style="v" />kaminawk to khrah hnetto haih, hmaloe koek niah amkhuengsak; kaminawk loe angmacae ih acaeng hoi imthung takoh ahmin to thuih o moe, saning pumphaeto hoi ranui bang kaminawk ih ahmin to pakoep o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng mah Mosi khae paek ih lok baktih toengah, Israel kaminawk to Sinai mae ah a kroek.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel ih calu, Reuben ih caanawk thungah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben acaengnawk loe, sing pali, sang taruk, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simeon ih caanawk thungah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="23" style="v" />Simeon acaengnawk loe, sing panga, sang takawt, cumvai thumto oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gad ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="25" style="v" />Gad acaengnawk loe, sing pali, sang panga, cumvai taruk, qui pangato oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Judah acaengnawk loe, sing sarih, sang pali, cumvai tarukto oh o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Issakar ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="29" style="v" />Issakar acaengnawk loe sing panga, sang pali, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="31" style="v" />Zebulun acaengnawk loe sing panga, sang sarih, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Joseph ih capa hnik; Ephraim ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="33" style="v" />Ephraim acaengnawk loe sing pali, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Manasseh ih caanawk thungah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="35" style="v" />Manasseh acaengnawk loe, sing thum, sang hnet, cumvai hnetto oh o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Benjamin ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="37" style="v" />Benjamin acaengnawk loe sing thum, sang panga, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dan ih caanawk thungah, angmacae ih acaeng hoi imthung takoh thung ih caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="39" style="v" />Dan acaengnawk loe sing taruk, sang hnet, cumvai sarihto oh o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Asher ih caanawk thungah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="41" style="v" />Asher acaengnawk loe, sing pali, sangto pacoeng, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Naphtali ih caanawk thung hoiah, angmacae ih acaeng hoi imthung takoh caanawk boih, saning pumphaeto pacoeng ranui bang kaom, misatuh thaih nongpa boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="43" style="v" />Naphtali acaengnawk loe, sing panga, sang thum, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hae kaminawk loe Mosi hoi Aaron mah, angmacae imthung takoh maeto thung hoi kami maeto, Israel zaehoikung hatlai hnetto thung hoiah qoih hoi ih kami ah oh o.
  </para>
  <para style="p">
    <verse number="45" style="v" />Saning pumphaeto pacoeng ranui bang kaom, misatuh thaih kaminawk boih, Israel caanawk thungah angmacae imthung takoh kaminawk boih ahmin to kroek naah,
  </para>
  <para style="p">
    <verse number="46" style="v" />Sangqum boih ah kami sang cumvai taruk, sang thum, cumvai panga, qui pangato oh o.
  </para>
  <para style="p">
    <verse number="47" style="v" />Toe Levi acaeng hoi nihcae imthung takohnawk loe, nihcae hoi nawnto kroek o ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="49" style="v" />Levi acaeng loe kroek hmah loe, Israel kaminawk thungah doeh athumsak hmah.
  </para>
  <para style="p">
    <verse number="50" style="v" />Toe Levi kaminawk loe hnukung lokthuihaih kahni im khenzawnkung, laom sabaenawk boih hoi to imthung ah kaom hmuennawk boih toepkung ah suem ah; nihcae loe kahni im hoi laom sabaenawk boih to apu o tih; nihcae mah kahni im thung ih sak han koi tok to sah o ueloe, ataihaih ahmuen phak o naah, kahni im taengah om o tih.
  </para>
  <para style="p">
    <verse number="51" style="v" />Kahni im puenhaih tue phak naah, Levi kaminawk mah pakuem o ueloe, kahni im sakhaih tue phak naah doeh, Levi kaminawk mah sah o tih; kahni im taengah kacaeh kalah kami loe paduek han oh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Israel kaminawk mah angmacae ih im sak o naah, misatuh kami boih mah, angmacae ataihaih ahmuen to angmacae hoi karaem ah sah o tih.
  </para>
  <para style="p">
    <verse number="53" style="v" />Toe amkhueng Israel kaminawk nuiah palungphuihaih phak han ai ah, Levi kaminawk loe hnukung lokthuihaih kahni im taengah atai o ueloe, hnukung lokthuihaih kahni im to khenzawn o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="54" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Israel kaminawk mah sak o.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk boih mah, angmah ih khosakhaih dan baktih toengah im to sak moe, imthung takoh angmathaih kahni payanghaih taengah, rangpui amkhuenghaih kahni im to sahsak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni tacawthaih ni angyae bangah, Judah acaeng misatuh kaminawk loe angmacae angmathaih kahni payang ih baktih toengah ohhaih im to sah o tih; Amminadab capa Nashon loe, Judah kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kroek naah anih ih misatuh kaminawk loe sing sarih, sang qui pali, cumvai tarukto oh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nihcae taengah Issakar acaengnawk ohhaih im to sah o tih; Zuar capa Nathanel loe Issakar kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kroek naah anih ih misatuh kaminawk loe sing panga, sang pali, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zebulun acaengnawk loe nihcae taengah om o tih; Helon capa Eliab loe Zebulun kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kroek naah anih ih misatuh kaminawk loe sing panga, sang sarih, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah kaminawk ohhaih ahmuen ah kaom, angmacae ih misatuh kaminawk to kroek naah sangqum boih ah, sing cumvai, sang qui tazet, sang taruk, cumvai palito oh o. Hae kaminawk loe hmaloe koek ah caeh o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Reuben ih misatuh kaminawk loe angmacae angmathaih kahni payang ih baktih toengah, aloih bangah ohhaih im to sah o tih; Shedeur capa Elizur loe Reuben kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kroek naah anih ih misatuh kaminawk loe sing pali, sang taruk, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Simeon acaengnawk loe nihcae taengah om o tih; Zurishaddai capa Shelumiel loe Simeon kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kroek naah anih ih misatuh kaminawk loe sing panga, sang takawt, cumvai thumto oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nihcae taengah Gad acaengnawk to om o tih; Reuel capa Elisaph loe Gad kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kroek naah anih ih misatuh kaminawk loe sing pali, sang panga, cumvai taruk, qui pangato oh o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Reuben acaengnawk ohhaih ahmuen ah kaom angmacae ih misatuh kaminawk to kroek naah sangqum boih ah, sing cumvai, sing panga, sang ha, cumvai pali qui pangato oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah misatuh kaminawk um li ah rangpui amkhuenghaih kahni im hoi nawnto Levi kaminawk ohhaih ahmuen to om tih; angmacae angmathaih kahni payang ih baktih toengah, angmacae ohhaih im to sah o tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ephraim acaeng misatuh kaminawk loe angmacae angmathaih kahni payang ih baktih toengah, ohhaih im to sah o tih; Ammihud capa Elishama loe Ephraim acaeng zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kroek naah anih ih misatuh kaminawk loe sing pali, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nihcae taengah Manasseh acaengnawk to om o tih; Pedahzur capa Gamaliel loe Manasseh kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kroek naah anih ih misatuh kaminawk loe sing thum, sang pumphae hnetto oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae taengah Benjamin acaengnawk om o tih; Gideoni capa Abidan loe Benjamin kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kroek naah anih ih misatuh kaminawk loe sing thum, sang panga, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ephraim acaengnawk ohhaih ahmuen ah kaom angmacae ih misatuh kaminawk to kroek naah sangqum boih ah, sing cumvai, sang tazet, cumvaito oh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aluek bangah Judah acaeng misatuh kaminawk loe angmacae angmathaih kahni payang ih baktih toengah, ohhaih im to sah o tih; Ammishaddai capa Ahierzer loe Dan kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kroek naah anih ih misatuh kaminawk loe sing taruk, sang hnet, cumvai sarihto oh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae taengah Asher acaengnawk om o tih; Okran capa Pagiel loe Asher kaminawk zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kroek naah anih ih misatuh kaminawk loe sing pali, sang cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nihcae pacoengah Naphtali acaengnawk om o tih; Enan capa Abira loe Naphtali acaeng zaehoikung ah om tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kroek naah anih ih misatuh kaminawk loe sing panga, sang thum, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dan acaengnawk ataihaih ahmuen ah kaom kaminawk to kroek naah sangqum boih ah, sing cumvai, sang qui panga, sang sarih, cumvai tarukto oh o. Angmacae angmathaih kahni payang ih baktih toengah, nihcae loe hnukkhuem koek ah caeh o tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Angmacae ih acaengnawk boih thung ih kami hoi angmacae ataihaih ahmuen ih misatuh kaminawk to kroek naah, Israel misatuh kaminawk loe sangqum boih ah, sang cumvai taruk, sang thum, cumvai pangato pacoeng, qui pangato oh o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Levinawk loe Israel kaminawk thungah kroek o ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Israel kaminawk mah sak o boih; angmacae khosakhaih dan hoi angmacae imthung takoh boih nawnto ataihaih ahmuen to a sak o.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sinai mae ah Angraeng mah Mosi khaeah lokthuih naah, hae ih kaminawk loe Aaron hoi Mosi ih caanawk ah oh o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron caanawk ih ahmin loe calu ah Nadab, Abihu, Eleazar hoi Ithamar.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hae kaminawk loe qaima toksak hanah ampa mah situi bawh moe, pahoe ih Aaron caanawk ih ahmin ah oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nadab hoi Abihu loe, Sinai praezaek ah sak koi ai kalah hmai hoi angbawnhaih a sak hoi pongah, Angraeng hmaa ah duek hoi hmaek; nihnik loe caa tawn hoi ai; to pongah Eleazar hoi Ithanar to ampa Aaron hmaa ah qaima tok a sak hoi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi acaengnawk to kawk loe, Aaron ih toksak hanah, anih hmaa ah caeh haih ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae loe Aaron hoi kahni im ah amkhueng kaminawk ih kangaih tok to, amkhuenghaih kahni im hmaa ah sah o tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nihcae loe kaminawk amkhuenghaih kahni im ih hmuenmaenawk boih khen o ueloe, Israel kaminawk mah sak han koi tok to sah o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Levi kaminawk to Aaron hoi a caanawk khaeah paek ah; Israel caanawk thung hoi qoi ah loe anih khaeah paek boih ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aaron hoi anih ih caanawk doeh qaima toksak hanah paek ah; hmuenciim taengah kacaeh minawk kalah loe dueksak han oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="12" style="v" />khenah, Israel kaminawk thung hoi tapen calu boih zuengah, Israel kaminawk thung hoi Levi kaminawk to ka qoih boeh pongah, Levi kaminawk loe kai ih ni;
  </para>
  <para style="p">
    <verse number="13" style="v" />tapen tangsuek hmuen boih loe kai ih ni; Izip prae thungah tapen tangsuek ka hum boih naah, Israel prae thungah loe tapen tangsuek to kai hanah pahoe o pongah, to hmuennawk loe kai ih hmuen ah oh o; Kai loe Angraeng ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />14 Angraeng mah Sinai praezaek ah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Levi acaengnawk boih to kroek ah, khrah to pacoeng ranui bang kaom nihcae thung ih nongpanawk to kroek boih hanah a thuih pae.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pongah Angraeng mah thuih ih lok baktih toengah, Mosi mah nihcae to kroek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Levi kaminawk ih ahmin loe Gershon, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gershon kaminawk ih ahmin loe Libni hoi Shimei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kohath acaengnawk ih ahmin loe Amram, Izehar, Hebron hoi Uzziel.
  </para>
  <para style="p">
    <verse number="20" style="v" />Merari acaengnawk ih ahmin loe Mahli hoi Mushi. Hae kaminawk loe angmacae acaeng thung hoiah kroek ih Levi acaeng ah oh hoi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gershon khae hoi tacawt, Libni hoi Shimei ih caanawk loe Gershon ih acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khrah to pacoeng ranui bang kaom nongpa to kroek boih naah, sangqum boih ah, sang sarih, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gershon ih caanawk loe niduem bang kahni im hnukah om o tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lael capa Eliasaph loe Gershon imthung takoh zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gershon kaminawk mah sak han koi tok loe, kaminawk amkhuenghaih kahni im, im hoi anui padihhaih ahmuen, kaminawk amkhuenghaih kahni im akunhaih thok taengah payang ih kahninawk,
  </para>
  <para style="p">
    <verse number="26" style="v" />longhmaa ah payang ih kahninawk, kahni im hoi hmaicam longhma taengah payang ih kahninawk, longhma akunhaih thok taengah payang ih kahninawk, zaenghaih quinawk boih loe nihcae mah khen o tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kohath hoi tacawt Amram caanawk, Izehar caanawk, Hebron caanawk hoi Uzziel caanawk loe, Kohath ih acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khrah to pacoeng ranui bang kaom nongpanawk to kroek boih naah, sang tazetto pacoeng, cumvai tarukto oh o; nihcae loe hmuenciim khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kohath imthung takoh ih caanawk loe kahni im aloih bangah om o tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Uzziel capa Elizaphan loe Kohath imthung takoh zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nihcae loe Sithaw lokkamhaih thingkhong, caboi, hmaithawk, hmaicamnawk, angmacae toksakhaih hmuenciim thung ih laom sabaenawk, payang ih kahninawk hoi hmuennawk boih khenzawnkung ah oh o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aaron capa qaima Eleazar loe Levi kaminawk zaehoikung ah oh; anih loe hmuenciim toep kaminawk khenzawnkung ah oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Merari khae hoiah tacawt; Mahli hoi Mushi caanawk loe, Merari ih acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khrah to pacoeng ranuih bang kaom nongpa to kroek boih naah, sang tarukto pacoeng, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abihail capa Zureil loe Merari imthung takoh zaehoikung ah oh; nihcae loe kahni im aluek bangah om o tih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Merari ih caanawk mah sak o han koi toknawk loe, kahni im sakhaih thingnawk, pakhang ih thingnawk, tungnawk, tung padoethaih hmuennawk, laom sabaenawk hoi kalah patoh ih hmuennawk boih,
  </para>
  <para style="p">
    <verse number="37" style="v" />imthung longhma taeng ih tungnawk, tung angdoethaih ahmuennawk, kahni im komhaih quinawk hoi takhuekhaih sumnawk khenzawnkung ah om o tih.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mosi hoi Aaron ih caanawk loe ni angyae bang ih kahni im ahma hoi rangpui amkhuenghaih kahni im hma ah om o tih; nihcae loe Israel kaminawk zuengah hmuenciim khenzawnkung ah oh o; hmuenciim taengah angzo kalah kami loe paduek han oh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Angraeng mah paek ih lok baktih toengah, Mosi hoi Aaron mah khrah to pacoeng ranuih bang kaom nihcae imthung takoh ih, nongpanawk to kroek boih naah, Levi acaengnawk loe sangqum boih ah, sing hnet, sang hnetto oh o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Angraeng mah Mosi khaeah, Israel caanawk thungah khrah to pacoeng ranuih bang kaom nongpa to kroek o boih ah loe, nihcae ih ahmin to tarik ah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Israel kaminawk ih calu boih zuengah, Levi kaminawk to la ah loe, Israel kaminawk ih tapen tangsuek moinawk zuengah, Levi kaminawk ih maitaw to kai hanah la ah; Kai loe Angraeng ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="42" style="v" />To pongah Angraeng mah paek ih lok baktih toengah, Mosi mah sak moe, Israel ih calu to kroek boih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Khrah to pacoeng ranuih bang kaom, calu to kroek boih moe, nihcae ih ahmin to lak naah, sing hnet, sang hnet qui sarih, thumto oh o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="45" style="v" />Israel calunawk boih zuengah, Levi kaminawk to la ah loe, nihcae ih maitaw zuengah, Levinawk ih maitaw to la ah; Levinawk loe kai ih kami ah ni oh o; Kai loe Angraeng ah ka oh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Levi kaminawk pong pop, Israel calu cumvai hnet, qui sarih, thumto akrang ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="47" style="v" />Gerah pumphaeto kazit, hmaicam ah patoh ih tahhaih shekel baktih toengah, kami maeto khaeah shekel pangato la ah;
  </para>
  <para style="p">
    <verse number="48" style="v" />kamtlai Israel kaminawk akranghaih phoisa to Aaron hoi a caanawk khaeah paek ah.
  </para>
  <para style="p">
    <verse number="49" style="v" />To pongah Levinawk mah kamtlai Israel calunawk akranghaih phoisa to Mosi mah cong;
  </para>
  <para style="p">
    <verse number="50" style="v" />Israel calunawk khaeah cong ih phoisanawk loe, hmuenciim ih shekel tahhaih hoi tah naah, shekel sang hatlai thum, qui taruk, pangato oh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Angraeng mah thuih ih lok baktih toengah, Mosi mah to akranghaih phoisa to Aaron hoi a caanawk khaeah paek.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Angmacae acaeng hoi imthung takoh ah kaom kami baktih toengah, Levi acaeng ah kaom Kohath ih caanawk to kroek ah,
  </para>
  <para style="p">
    <verse number="3" style="v" />amkhuenghaih kahni imthung ah toksak hanah, saning qui thumto hoi saning qui pangato kaom nongpanawk to kroek boih ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kohath caanawk mah khetzawn ih kaminawk amkhuenghaih kahni im loe, ciimcai koek ahmuen ah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ohhaih ahmuen angpuen o naah, Aaron hoi a caanawk to angzo o tih, nihcae mah a nuiah khuk ih kahni to khring o ueloe, hnukung ah kaom thingkhong to khuk o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pacoengah tuipui caham ih ahin hoiah khuk o tih; to hmuen ih a nuiah rong kamiing kahni to khuk o ueloe, cung to angmah ih ahmuen ah suem o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Caboi nui ih takaw to kahni kamiing hoiah kraeng o tih, to ah sabaenawk, kathuk sabaenawk, naek han koi tui lawnhaih boengloengnawk, takawnawk to apet ai ah suem o tih;
  </para>
  <para style="p">
    <verse number="8" style="v" />to ih hmuen nuiah kamling kahni to baih o tih; a nuiah tuipui caham ih ahin hoiah khuk o ueloe, cung to angmah ahmuen ah suem o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kahni kamiing to la o ueloe, hmaithawk, hmaiim, hmai ataephaih taitaehnawk, hmai cenhaih boengloeng, hmaitui suekhaih boengloengnawk boih to khuk o tih; to tiah nihcae mah toksah o tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />To pacoengah to ih laom sabaenawk boih to tuipui caham ih ahin hoiah ayaw o hmoek pacoengah, aputhaih to sah o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sui hmaicam nuiah kahni kamiing to baih o ueloe, tuipui caham ih ahin hoiah khuk o tih; aputhaih cung to angmah ohhaih ahmuen ah suem o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmuenciim thungah toksak naah hmuenmaenawk to la o boih ueloe, kahni kamiing hoiah ayaw o tih; tuipui caham hin hoi khuk o pacoengah, aputhaih to sah o tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae mah hmaicam pong ih maiphunawk to takhoek o ueloe, a nuiah kahni kamling hup to khuk o tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />To hmaicam ah toksak naah kangaih hmuennawk, laom sabaenawk, moi banghaih sumnawk, moi thunhaih sumnawk, hmai kamngaeh sohhaih sum kangphaeknawk, tui bawhhaih boengloengnawk hoi hmaicam ih laom sabaenawk to a nuiah suem o boih tih; to hmuen to tuipui caham hin hoiah khuk o ueloe, aputhaih cung to a ohhaih ahmuen ah suem o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ataihaih ahmuen angpuen han oh naah, Aaron hoi a caanawk loe, hmuenciim hoi hmuenciim ih laom sabaenawk to khuk o pacoengah, to hmuennawk to aput hanah, Kohath ih caanawk angzo o tih; toe nihcae loe kaciim hmuen to sui o mak ai; sui o nahaeloe dueh o tih. Hae hmuennawk loe kaminawk amkhuenghaih kahni im ah Kohath ih caanawk mah sak han koi tok ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Qaima Aaron capa Eleazar mah sak han koi tok loe hmaitui, hmai thlaek koi hmuihoih, ni thokkruek paek ih cang hoi lu bawhhaih situi, kahni im hoi a thung ih hmuennawk boih, hmaicam hoi a thung ih laom sabaenawk boih to khenzawn tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath imthung takoh to Levi acaeng thung hoiah takhoe ving hmah;
  </para>
  <para style="p">
    <verse number="19" style="v" />to pongah kaciim koek ahmuen ah caeh hoi naah, duekhaih thung hoiah loih moe, hing thai hanah, hae tiah nihcae han sah paeh; Aaron hoi a caanawk to hmuenciim thungah akun o hmaloe ueloe, kaminawk boih mah sak han koi hmuen hoi tok to tapraek pae tih:
  </para>
  <para style="p">
    <verse number="20" style="v" />toe ciimcai hmuennawk kraeng nathuem ah, to hmuennawk khet hanah Kohath ih caanawk a thungah caehsak hmah; to tih ai nahaeloe dueh o moeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Gershon caanawk doeh angmacae ih acaeng hoi imthung takoh ah kami ih ahmin to la ah;
  </para>
  <para style="p">
    <verse number="23" style="v" />amkhuenghaih kahni imthung ah kaom kaminawk angaihaih toksak hanah, saning qui thumto hoi saning qui pangato kaom nongpanawk to kroek boih ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gershon imthung takoh mah sak moe, aput han koi hmuennawk loe hae tiah oh;
  </para>
  <para style="p">
    <verse number="25" style="v" />kahni im ah payang ih kahni, rangpui amkhuenghaih kahni im, a nui khuk ih kahninawk, a nui khukhaih tuipui caham ahinnawk, kaminawk amkhuenghaih kahni im, amkhuenghaih kahni im thok taengah payang ih kahninawk,
  </para>
  <para style="p">
    <verse number="26" style="v" />kahni im hoi hmaicam taeng ih longhmaa ah payang ih kahni, longhma thok taengah payang ih kahni, toksak naah patoh ih quinawk hoi kangaih hmuennawk loe Gershon ih caanawk mah sah o boih tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gershon acaengnawk mah sak ih hmuen hoi aput han koi hmuennawk boih loe, Aaron hoi a caanawk mah thuih ih lok baktih toengah sah o tih; nihcae mah aput han koi hmuenawk boih to thui pae o tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae hmuennawk loe Gershon imthung takoh mah, kami amkhuenghaih kahni imthung ah sak han koi tok ah oh; nihcae toksakhaih loe Aaron capa qaima Ithamar mah khenzawn tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari ih caanawk doeh angmacae ih acaeng hoi imthung takoh ah kaom kaminawk baktih toengah kroek ah;
  </para>
  <para style="p">
    <verse number="30" style="v" />kaminawk amkhuenghaih kahni imthung ah toksak han kangzo, saning qui thumto hoi saning qui pangato kaom nongpa to kroek boih ah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nihcae mah kaminawk amkhuenghaih kahni im to sak moe, aput o han koi tok loe, kahni im sakhaih thingnawk, pakhang ih thingnawk, tungnawk hoi tung padoethaih hmuennawk,
  </para>
  <para style="p">
    <verse number="32" style="v" />longhma taeng boih ah kaom tungnawk, tung padoethaih hmuennawk, sumnawk, quinawk, toksak naah patoh ih hmuennawk to sah o boih tih; nihcae mah aput ih hmuennawk to pakuem moe, kroek boih han oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hae hmuen loe Aaron capa qaima Ithamar mah khethaih tlim ah, kaminawk amkhuenghaih kahni im ah Merari ih caanawk mah sak han koi tok ah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mosi, Aaron hoi amkhueng kaminawk zaehoikung kacoeh koek mah, angmacae acaeng hoi imthung takoh khosakhaih baktih toengah, Kohath ih caanawk to kroek o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kaminawk amkhuenghaih kahni im ah toksak han kangzo, saning qui thumto hoi saning qui pangato kaom nongpa boih,
  </para>
  <para style="p">
    <verse number="36" style="v" />angmacae imthung takoh ih kami to kroek o boih naah, sang hnet, cumvai sarih, qui pangato oh o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hae kaminawk loe Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Mosi hoi Aaron mah amkhuenghaih kahni im ah toksak hanah kaom Kohath ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Gershon ih caanawk loe angmacae acaeng hoi imthung takoh to kroek o boih.
  </para>
  <para style="p">
    <verse number="39" style="v" />Amkhuenghaih kahni im ah toksak han kangzo, saning qui thumto hoi saning qui pangato kaom nongpa boih,
  </para>
  <para style="p">
    <verse number="40" style="v" />angmacae ih acaeng hoi imthung takoh to kroek o boih naah, sang hnet, cumvai taruk, qui thumto oh o.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hae kaminawk loe Angraeng mah thuih ih lok baktih toengah, Mosi hoi Aaron mah kroek ih, kahni im ah toksah koi kami ah oh o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Merari ih caanawk mah angmacae acaeng hoi imthung takoh to kroek o boih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kaminawk amkhuenghaih im ah toksak han kangzo kami saning qui thumto hoi saning qui pangato kaom nongpa boih,
  </para>
  <para style="p">
    <verse number="44" style="v" />angmacae acaeng hoi imthung takoh to kroek o boih naah, kami sang thum, cumvai hnetto oh o.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hae kaminawk loe Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Mosi hoi Aaron mah kroek ih Merari ih caa ah oh o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Levi caanawk loe Mosi, Aaron hoi Israel zaehoikungnawk mah, angmacae acaeng hoi imthung takoh to kroek pae boih.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kaminawk amkhuenghaih kahni im ah toksak moe, aput han angzo saning qui thumto hoi saning qui pangato kaom nongpa boih,
  </para>
  <para style="p">
    <verse number="48" style="v" />nihcae to kroek o boih naah, sang tazet, cumvai panga, qui tazetto oh o.
  </para>
  <para style="p">
    <verse number="49" style="v" />Angraeng mah Mosi khaeah paek ih lok baktih toengah, kami boih mah sak o ih tok hoi aput koi tok to khet moe, nihcae ih milu to a kroek.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngansae man kami, kahoih thai ai takpum nathaih tawn kami hoi kaciim ai kadueh qok sui Israel kaminawk loe ataihaih ahmuen tasa bangah suem ah;
  </para>
  <para style="p">
    <verse number="3" style="v" />ka ohhaih ahmuen amhnongsak han ai ah, to baktih nathaih tawn kami loe nongpa maw, nongpata maw ohhaih im tasa bangah suem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Israel kaminawk mah sak o; to baktih nathaih tawn kami loe ohhaih ahmuen tasa bangah a suek o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel kaminawk khaeah hae tiah thui paeh; kaminawk mah sak o ih zaehaih to nongpa mah maw, nongpata mah maw, Angraeng hmaa ah oep om ai ah sak o pazae pongah, to kami to zaehaih tawn nahaeloe,
  </para>
  <para style="p">
    <verse number="7" style="v" />to kaminawk mah sak o ih zaehaih to taphong han oh; a sakpazae o pongah, a sakpazae o ih kami khaeah ahmuen pangato thungah ahmuen maeto thap ueloe, rong pae boih tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe kami maeto mah a sakpazae ih hmuen pongah, rong ih hmuen talawkkung om ai nahaeloe, to rong ih hmuen to Angraeng ih hmuen ah suek moe, qaima khaeah paek han oh; to pacoengah anih zaehaih loih thai hanah angbawnhaih sak hanah tuu tae to paek han oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel kaminawk mah qaima han sin ih ciimcai hmuennawk boih loe anih ih hmuen ah om tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kami boih mah kaciim ah sin ih hmuennawk loe, anih ih hmuen ah om tih; kami mah qaima han paek ih tangqumnawk doeh anih ih hmuen ah om tih, tiah thuih paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel kaminawk han hae tiah lokthui paeh; kami maeto ih zu loe oep om ai pongah, loklam amkhraeng ving moe, a sava nuiah zaehaih a sak;
  </para>
  <para style="p">
    <verse number="13" style="v" />kami maeto mah to nongpata to iih haih, toe a sava khaeah thui ai ah angphat; to nongpata loe ciim ai boeh, toe anih hnukung om ai pongah, mi mah doeh a sak ih zaehaih to naeh thai ai,
  </para>
  <para style="p">
    <verse number="14" style="v" />toe sava mah a zu loe ciim ai boeh, tiah oep vawthaih to tawnh maw, to tih ai boeh loe a zu nuiah palunghaenghaih a tawnh, toe anih ih zu loe amhnonghaih tidoeh om ai to mah a sava mah anih nuiah palunghaenghaih tawn nahaeloe,
  </para>
  <para style="p">
    <verse number="15" style="v" />a sava mah a zu to qaima khaeah caeh haih ueloe, barli takaw dip ephah hato thungah maeto a zu ih zae angbawnhaih sak hanah sin tih; takaw dip nuiah situi bawh mak ai, a nuiah hmuihoih doeh thlaek mak ai; to baktih angbawnhaih loe zu nuiah palunghaeng pongah, sak ih angbawnhaih ah oh moe, zaehaih panoek hanah sak ih angbawnhaih ah doeh oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Qaima mah to nongpata to caeh haih ueloe, Angraeng hmaa ah angdoesak tih;
  </para>
  <para style="p">
    <verse number="17" style="v" />to naah qaima mah kaciim tui to long laom thungah lawn ueloe, anih mah kahni imthung ih maiphu to lak pacoengah, tui thungah phuih tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Qaima mah nongpata to Angraeng hmaa ah angdoesak ueloe, nongpata ih lu to khuk pae hmoek tih; nongpata nuiah palunghaeng pongah zaehaih panoek hanah sak ih angbawnhaih takaw dip to a ban ah pasumsak tih; qaima mah tangoenghaih kaomsak thaih tui kakhaa to a ban ah sin tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Qaima mah nongpata to, Kaw baktih nongpa hoiah doeh na iip ai, oep om ai loklam ah doeh nam khraeng ai moe, na sava laep ah kalah nongpa hoiah takpum amhnonghaih to na sah ai nahaeloe, hae ih tangoenghaih kaomsak thaih tui kakhaa hae na nuiah pha hmah nasoe, tiah thui tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe na sava nuiah oep thok ai ah na oh moe, kalah nongpa hoiah loklam nam khraeng ving; na sava nuiah kalah nongpa hoiah na iih moe, na takpum to amhnong boeh nahaeloe,
  </para>
  <para style="p">
    <verse number="21" style="v" />qaima mah nang loe nangmah ih kaminawk salakah, Angraeng mah na phaih to zaeksak ueloe, na zok doeh bawksak tih, to tiah nang loe tangoenghaih zok kami ah na om tih, tiah nongpata khaeah thuih pae pacoengah, nongpata to tangoenghaih lok akamsak tih;
  </para>
  <para style="p">
    <verse number="22" style="v" />tangoenghaih kaomsak hae tui kakhaa hae na zok thungah akun naah, na phaih to zaeksak ueloe, na zok doeh baawk tih, tiah thui pae tih. To naah nongpata mah, Amen, to tiah om nasoe, tiah thui tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hae tangoenghaih lok loe qaima mah cabu thungah tarik ueloe, kakhaa tui hoiah phrae let tih;
  </para>
  <para style="p">
    <verse number="24" style="v" />qaima mah tangoenghaih kaomsak kakhaa tui to nongpata hanah naesak tih; nongpata ih zok thungah tangoenghaih kaomsak tui kakhaa akun naah, paroeai khaa pae tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pacoengah qaima mah to nongpata ban ah sinsak ih palunghaeng pongah sak ih angbawnhaih takaw dip to la ueloe, Angraeng hmaa ah ahaek pacoengah, hmaicam nuiah suem tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Qaima mah zaehaih panoek han sak ih angbawnhaih takaw dip to ban tangsum maeto la ueloe, hmaicam nuiah hmai hoiah thlaek tih; to pacoengah to tui to nongpata hanah naesak tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />To nongpata mah angmah ih sava nuiah zaehaih to sah moe, ciim ai boeh nahaeloe, tangoenghaih lokkam ih baktih toengah omsakkung tui kakhaa to naek naah, zok thungah tui to paroeai khaa tih; to naah a phaih to zaek ueloe, a zok doeh baawk tih; to naah to nongpata loe angmah ih kaminawk salakah tangoenghaih zok kami ah om tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toe nongpata loe ciimcai moe, amhnonghaih tidoeh om ai nahaeloe, anih loe zaehaih tawn ai pongah, caa sah let tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hae loe zu mah oep kaom ai ah, kalah nongpa hoi loklam amkhraeng ving moe, sava nuiah ciimcai ai ah khosak naah maw, palunghaenghaih tawnh naah maw,
  </para>
  <para style="p">
    <verse number="30" style="v" />to tih ai boeh loe nongpa mah a zu nuiah palunghaenghaih tawnh naah maw, patoh ih kaalok ah oh; sava mah a zu nuiah palunghaenghaih tawnh naah, qaima mah nongpata to Angraeng hmaa ah angdoesak ueloe, hae ih kaalok baktih toengah nongpata to lokcaek tih.
  </para>
  <para style="p">
    <verse number="31" style="v" />To tiah sava loe zaehaih ciim ueloe, nongpata loe a zaehaih pongah danpaekhaih to zok tih, tiah thui paeh, tiah a naa.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk khaeah hae tiah thui paeh; nongpa maw, nongpata maw, angmah hoi angmah to Angraeng han ih ni ka oh, tiah thuih moe, Nazaret kami ah oh hanah amhoe pacoengah, lokkamhaih to a sak naah,
  </para>
  <para style="p">
    <verse number="3" style="v" />mu hoi paqui thaih kalah mu maw, misurtui hoiah sak ih misurtui kathaw maw, kalah paqui thaih misurtui hoiah sak ih kathaw tui maw, misurtui hoiah sak ih munawk to naek han om ai; misurthaih doeh caa mak ai, misurthaih kazaek doeh caak han om ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />A hing thung misurthing hoi tacawt hmuen roe caak han om ai; amu caak hanah ahin doeh et han om ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kamhoe ah oh hanah lokkamhaih sak nathung, a lu nui ih sam roe aat mak ai; Angraeng khaeah lokkamhaih sak baktih toengah, amhoehaih tue akoep ai karoek to, anih loe kaciim ah om ueloe, a lu nui ih sam to kasawk ah pathlung tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angraeng khaeah amhoehaih atue thung, kadueh kami qok taengah caeh mak ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angmah ih Angraeng hanah a lu to pahoe pongah, anih loe ampa maw, amno maw, amnawk maw, to tih ai boeh loe a tanu maw dueh cadoeh caeh mak ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng khaeah pahoe ih kami ah oh nathung, anih loe ciimcai kami ah om tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Poek ai pui hoiah anih taengah kami dueh moeng nahaeloe, pahoe ah kaom a lu nui ih sam to amhnong boeh pongah, ciimcaihaih ni, ni sarihto naah a lu sam to aat tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni tazetto naah loe pahu, to tih ai boeh loe im ah pacah ih pahu hnetto amkhuenghaih kahni im thok taengah, qaima khaeah sin tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih loe kadueh kami mah zaesak boeh pongah, a zaehaih to loihsak hanah, qaima mah pahu maeto zae angbawnhaih ah bop ueloe, kalah maeto hmai angbawnhaih sah pae tih; to na ni roe ah anih ih lu to kaciim ah suem let tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pahoe ih atue thungah Angraeng khaeah angpaek ueloe, saningto kaom tuucaa hoiah zae angbawnhaih to sah tih; canghni ah pahoe ih atue thungah ciim ai boeh pongah, hmaloe ih atue to kroek mak ai boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nazaret kami ah oh han pahoehaih atue to boeng naah loe, kaminawk amkhuenghaih kahni im akunhaih thok taengah anih to caeh haih tih;
  </para>
  <para style="p">
    <verse number="14" style="v" />to ah anih mah Angraeng khaeah anih han angbawnhaih to sah pae tih; coek koi kaom ai saningto kaom tuucaa tae maeto, hmai angbawnhaih ah paek ueloe, coek koi kaom ai saningto kaom tuucaa tala maeto zae angbawnhaih ah paek tih; coek koi kaom ai tuu tae maeto doeh angdaeh angbawnhaih ah paek tih;
  </para>
  <para style="p">
    <verse number="15" style="v" />taeh thuh ai ih takaw benthang maeto, situi atok ih takaw kangphaek, situi atok ih takaw kaenawk, cang hoi naek koi tuinawk to nawnto paek tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />To hmuennawk to qaima mah Angraeng khaeah sin ueloe, zae angbawnhaih hoi hmai angbawnhaih to sah tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Qaima mah angdaeh angbawnhaih ah, taeh thuh ai ih takaw benthang maeto hoi tuu tae maeto Angraeng khaeah paek pacoengah, cang hoi naek koi tuinawk doeh paek tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pacoengah kaminawk amkhuenghaih kahni im akunhaih thok taengah, Nazaret kami mah pahoe ih a lu nui ih sam to aat tih; a sam to angdaeh angbawnhaih hmai thungah va tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pahoe ih sam to aah pacoengah, tui hoi bueh ih tuu palaeng maeto, benthang pong ih taeh thuh ai ih takaw kae hoi taeh thuh ai ih takaw karoem to la ueloe, Nazaret kami ih ban ah suem pae tih;
  </para>
  <para style="p">
    <verse number="20" style="v" />to pacoengah qaima mah to hmuennawk to Angraeng hmaa ah ahaek ih angbawnhaih ah paek tih; to tiah ahaek ih saoek hoi palaeng loe caiimcai moe, qaima han paek ih hmuen ah oh; to pacoengah loe Nazaret kami mah misurtui to nae tih boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hae loe amhoehaih atue thungah, Angraeng han hmuen paek moe, lokkamhaih sah Nazaret kami ih atawk ah oh; hae hmuen pacoengah angpaekhaih kaalok baktiah anih mah sak moe, a lokkamhaih baktih toengah akoepsak han oh, tiah thuih paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="23" style="v" />Aaron hoi a caanawk khaeah, Israel kaminawk to hae tiah tahamhoihaih paek oh, nihcae khaeah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Angraeng mah tahamhoihaih paek nasoe loe, nihcae to toep nasoe;
  </para>
  <para style="p">
    <verse number="25" style="v" />Angraeng mah nangcae nuiah a mikhmai aangsak nasoe loe, tahmen nasoe;
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng loe nangcae khaeah angqoi nasoe loe, monghaih paek nasoe, tiah thui ah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nihcae mah Israel kaminawk nuiah ka hmin to suem o tih, to naah nihcae to tahamhoihaih ka paek han, tiah a naa.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi mah kahni im sak pacoengah, kahni imthung ah kaom hmuenmaenawk, hmaicam hoi laom sabaenawk boih to, situi bawh moe, a ciimsak.
  </para>
  <para style="p">
    <verse number="2" style="v" />To pacoengah kroek ih kami thungah kaom, Israel kaminawk ukkung, imthung takoh zaehoikung hoi acaeng zaehoikung lu koeknawk mah hmuen paekhaih to sak o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae mah Angraeng paek hanah sin o ih hmuennawk loe, ukkung maeto mah maitaw tae maeto, ukkung hnetto hanah maitaw mah ruet ih maitaw leeng maeto, imphu kaom maitaw leeng tarukto hoi maitaw tae hatlai hnetto, kahni imthung ah a sin o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="5" style="v" />kaminawk amkhuenghaih kahni im ah patoh hanah, nihcae mah paek ih hmuennawk to la ah; kami boih mah toksak angaihaih baktih toengah, to hmuennawk to Levi kaminawk han paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah Mosi mah maitaw leeng hoi maitaw taenawk to lak moe, Levi kaminawk hanah paek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toksak angaihaih baktih toengah anih mah Gershon ih caanawk hanah, maitaw leeng hnetto hoi maitaw tae palito paek pae;
  </para>
  <para style="p">
    <verse number="8" style="v" />toksak angaihaih baktih toengah anih mah Merari ih caanawk hanah, maitaw leeng palito hoi maitaw tae tazetto paek pae; nihcae loe qaima Aaron capa Itharma ukhaih tlim ah oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmuenciim ah toksah Kohath ih caanawk loe, angmacae palaeng hoi aput koi tok to a sak o pongah, nihcae han maitaw leeng hoi maitaw taenawk to paek o ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmaicam situi bawh na niah, ukkungnawk mah hmaicam tathlanghaih hmuennawk to hmaicam hmaa ah paek o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah Mosi khaeah, Hmaicam tathlang hanah ukkung maeto boih mah ni thokkruek hmuen to paek o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmaloe koek niah Judah acaeng Amminadab capa Nashon mah, tathlang ih hmuen to sinh;
  </para>
  <para style="p">
    <verse number="13" style="v" />anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih tui pathaek naah patoh ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae takaw dip;
  </para>
  <para style="p">
    <verse number="14" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="15" style="v" />angbawnhaih paek hanah maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto;
  </para>
  <para style="p">
    <verse number="16" style="v" />zae angbawnhaih hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="17" style="v" />to pacoengah angdaeh angbawnhaih sak hanah, maitaw tae hnetto, tuu tae pangato, maeh tae pangato, saningto kaom tuucaa pangato a sinh; hae loe Amminadab capa Nashon mah paek ih hmuennawk ah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni hnetto na naah Issakar ih acaeng ukkung, Zuar capa Nethanel mah tathlang ih hmuen to sinh;
  </para>
  <para style="p">
    <verse number="19" style="v" />anih mah sin ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="20" style="v" />shekel hato kazit, hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="21" style="v" />hmai angbawnhaih sak hanah, saning kanawk maitaw maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="22" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="23" style="v" />angdaeh angbawnhaih sak hanah paek ih maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Zuar capa Nethanel mah paek ih hmuennawk ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni thumto naah, Zebulun caanawk zaehoikung, Helon capa Eliab mah tathlang ih hmuen to sinh;
  </para>
  <para style="p">
    <verse number="25" style="v" />anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak han suek ih sabae hnetto koiah situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="26" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="27" style="v" />hmai hoi angbawnhaih sak hanah, saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="28" style="v" />zae angbawnhaih sak hanah, maeh caa maeto,
  </para>
  <para style="p">
    <verse number="29" style="v" />angdaeh angbawnhaih sak hanah paek ih maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Helon capa Eliab mah paek ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ni palito naah loe Reuben caanawk zaehoikung, Sheudeur capa Elizur mah tathlang ih hmuennawk to sinh;
  </para>
  <para style="p">
    <verse number="31" style="v" />anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="32" style="v" />Shekel hato kazit hmuihoih koimongah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="33" style="v" />hmai hoi angbawnhaih sak hanah, saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="34" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="35" style="v" />angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Shedeur capa Elizur mah paek ihhmuennawk ah oh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni pangato naah loe Simeon caanawk zaehoikung, Zurishaddai capa Shelumiel mah tathlang ih hmuenawk to sinh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="38" style="v" />shekel hato kazit hmuihoih koiah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="39" style="v" />hmai hoi angbawnhaih sak hanah, saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="40" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="41" style="v" />to pacoengah angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Zurishaddai capa Shelumiel mah paek ih hmuennawk ah oh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ni tarukto naah Gad caanawk zaehoikung, Deuel capa Eliasaph mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak han suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="44" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="45" style="v" />hmai hoi angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto;
  </para>
  <para style="p">
    <verse number="46" style="v" />zae angbawnhaih sak hanah, maeh caa maeto,
  </para>
  <para style="p">
    <verse number="47" style="v" />angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Deuel capa Eliasaph mak paek ih hmuennawk ah oh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ni sarihto naah Ephraim caanawk zaehoikung, Ammihud capa Elishama mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Anih mah paek ih hmuen loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="50" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="51" style="v" />hmai hoi angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="52" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="53" style="v" />angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Ammihud capa Elishama mah paek ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ni tazetto naah Manasseh ih caanawk zaehoikung, Pedahzur capa Gamaliel mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="56" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="57" style="v" />hmai angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="58" style="v" />zae angbawnhaih hmuen paek hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="59" style="v" />angdaeh angbawnhaih hmuen paek hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Pedahzur capa Gamaliel mah paek ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="60" style="v" />Ni takawtto naah, Benjamin kaminawk zaehoikung, Gideoni capa Abidan mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="61" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="62" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="63" style="v" />hmai hoi angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto;
  </para>
  <para style="p">
    <verse number="64" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="65" style="v" />angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae hmuennawk loe Gideoni capa Abidan mah sinh.
  </para>
  <para style="p">
    <verse number="66" style="v" />Ni hato naah Dan ih caanawk zaehoikung, Ammishaddai capa Ahiezer mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="67" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak hanah suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="68" style="v" />shekel hato kaom hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="69" style="v" />angdaeh angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="70" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="71" style="v" />angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato, saningto kaom tuucaa pangato a sinh; hae loe Ammishaddai capa Ahiezer mah paek ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="72" style="v" />Khrah hatlaito niah loe Asher ih caanawk zaehoikung, Okran capa Pagiel mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="73" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak han suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="74" style="v" />shekel hato kazit hmuihoih koimong ah suek ih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="75" style="v" />angdaeh angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="76" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="77" style="v" />angdaeh angbawnhaih sak hanah paek ih maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuu caa pangato a sinh; hae loe Okran capa Pagiel mah paek ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="78" style="v" />Hatlai hnetto niah Naphtali zaehoikung, Enan capa Ahira mah tathlang ih hmuen to sinh.
  </para>
  <para style="p">
    <verse number="79" style="v" />Anih mah paek ih hmuennawk loe, hmuenciim ih shekel baktih toengah, shekel cumvai, qui thumto kazit sum kanglung hoiah sak ih sabae maeto, shekel qui sarihto kazit sum kanglung hoiah sak ih sabae kathuk maeto, cang hoi angbawnhaih sak han suek ih sabae hnetto kakoi situi hoi atok tangcae ih takaw dip;
  </para>
  <para style="p">
    <verse number="80" style="v" />shekel hato kazit hmuihoih suek haih sui sabae maeto,
  </para>
  <para style="p">
    <verse number="81" style="v" />hmai angbawnhaih sak hanah saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa maeto,
  </para>
  <para style="p">
    <verse number="82" style="v" />zae angbawnhaih sak hanah maeh caa maeto,
  </para>
  <para style="p">
    <verse number="83" style="v" />angdaeh angbawnhaih sak hanah maitaw tae hnetto, tuu tae pangato, maeh tae pangato hoi saningto kaom tuucaa pangato a sinh; hae loe Enan capa Ahira mah paek ih hmuen ah oh.
  </para>
  <para style="p">
    <verse number="84" style="v" />Israel zaehoikungnawk mah, situi bawh moe, hmaicam tathlanghaih niah paek o ih hmuennawk loe, sum kanglung hoiah sak ih sabae hatlai hnetto, sum kanglung hoiah sak ih sui sabae kathuk hatlai hnetto hoi sui kathlah hatlai hnetto oh;
  </para>
  <para style="p">
    <verse number="85" style="v" />sum kanglung sabae maeto naah shekel cumvai, qui thumto azit; sum kanglung hoiah sak ih sabae kathuk loe shekel qui sarihto azit; hmuenciim ih shekel baktih toengah, sum kanglung hoiah sak ih laom sabaenawk loe sangqum boih ah shekel sang hnetto pacoeng, cumvai palito azit.
  </para>
  <para style="p">
    <verse number="86" style="v" />Hmuenciim ah suek ih shekel baktih toengah, hmuihoih koimong ah suek ih sui kathlah hatlai hnetto loe shekel hato azit; sui kathlahnawk loe sangqum boih ah shekel cumvai, pumphaeto azit.
  </para>
  <para style="p">
    <verse number="87" style="v" />Hmai angbawnhaih sak hanah, cang hoi nawnto a sin o ih moinawk boih loe, maitaw tae hatlai hnetto, tuu tae hatlai hnetto hoi saningto kaom tuucaa tae hatlai hnetto oh moe, zae angbawnhaih sak hanah maeh caa hatlai hnetto a sin o.
  </para>
  <para style="p">
    <verse number="88" style="v" />Angdaeh angbawnhaih sak hanah sin o ih moinawk boih loe, saning kanawk maitaw tae pumphae palito, tuu tae qui tarukto, maeh tae qui tarukto hoi saningto kaom tuucaa qui tarukto oh. Hae tiah paek ih hmuennawk loe situi bawh moe, hmaicam tathlanghaih niah a paek o.
  </para>
  <para style="p">
    <verse number="89" style="v" />Mosi loe Angraeng hoi lokpaeh hanah kaminawk amkhuenghaih kahni imthung ah akun naah, cherubim hnetto salak, hnukung thingkhong suekhaih ranuih ah kaom palungnathaih ahmuen hoiah thuih ih lok to a thaih; to tiah Angraeng mah Mosi khaeah lokthuih pae.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aaron han, Hmaiim na thlaek naah, hmaiim sarihto paanghaih tung hmabang ah thlaek hanah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah Aaron mah to tiah a sak; Angraeng mah Mosi khaeah thuih ih lok baktih toengah, anih mah hmaiim tung hmabang ah hmaiim to angqoisak boih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmaiim tung loe, Angraeng mah Mosi khaeah patuek ih krang baktih toengah a sak; takung hoi tadong khoek to sui hoiah a sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel kaminawk salak hoi Levinawk to la ah loe, ciimsak ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nihcae ciimsak hanah, hae tiah sah ah; ciimsakhaih tui to nihcae nuiah bawh ah; nganmui to aat o nasoe loe, khukbuennawk doeh pasuk o nasoe, to tiah ciimsak ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Saning kanawk maitaw tae maeto, cang hoi angbawnhaih sak ih baktiah, situi hoiah atok tangcae ih takaw dip hoi nawnto, zae angbawnhaih sak hanah, kalah saning kanawk maitaw tae maeto sin nasoe.
  </para>
  <para style="p">
    <verse number="9" style="v" />Levinawk to amkhuenghaih kahni im hmabang ah angzosak ah loe, Israel acaeng kaminawk to nawnto amkhuengsak boih ah;
  </para>
  <para style="p">
    <verse number="10" style="v" />Levinawk to Angraeng hmaa ah hoi ah; to naah Israel kaminawk mah nihcae nuiah ban koeng o tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel kaminawk mah tathlang o ih hmuen ah, Aaron mah Levinawk to Angraeng khaeah tathlang tih; to naah nihcae mah Angraeng ih tok to sah o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Levi kaminawk mah maitaw lunawk nuiah ban koeng o tih; Levi kaminawk zae angbawnhaih sak hanah maitaw maeto, hmai hoi angbawnhaih sak hanah kalah maitaw maeto Angraeng khaeah paek ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Levi kaminawk to Aaron hoi a caanawk hmaa ah angdoesak ah loe, nihcae to tathlang ih hmuen ah Angraeng khaeah paek ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae tiah Levi kaminawk to Israel kaminawk salak hoi pahoe ah; Levinawk loe kai ih hmuen ah om o tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />To tiah Levinawk ciimsak hanah na tathlang pacoengah ni, nihcae loe amkhuenghaih ahmuen ah toksak han caeh o vop tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae loe Israel kaminawk thungah kai khaeah takpum angpaek boih kami ah oh o; zok thung hoi tacawt kami boih, Israel kaminawk ih calu boih zuengah nihcae to ka lak boeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kami maw, moi maw, Israel kaminawk ih calu boih loe kai ih ni; Izip prae ih calu to ka tamit boih naah, nihcae to kaimah hanah ka pahoe boeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel kaminawk thung ih calu boih zuengah, Levinawk to ka lak boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel kaminawk hmuenciim ah caeh o naah, nathaih kasae a tongh o han ai ah, amkhuenghaih kahni im ah tok to sak o moe, Israel caanawk akranghaih to a sak o hanah, Israel kaminawk thungah Levi kaminawk loe Aaron hoi a caanawk hanah tangqum ah ka paek boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Levi kawng pongah, Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Mosi, Aaron hoi Israel acaengnawk mah, Levinawk nuiah sak o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Levinawk loe ciimcai o moe, khukbuennawk to pasuk o; Aaron mah nihcae han paek ih hmuen baktih toengah, Angraeng khaeah a paek moe, nihcae ciim hanah angbawnhaih to a sak pae.
  </para>
  <para style="p">
    <verse number="22" style="v" />Levi kawng pongah, Angraeng mah Mosi khaeah thuih ih lok baktih toengah, kaminawk mah sak o; to pacoengah Levinawk loe kahni im ah toksak hanah, Aaron hoi a caanawk hma ah caeh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pacoengah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Levi kaminawk loe saning pumphae pangato akoep pacoengah ni, amkhuenghaih kahni im ah toksak han caeh o vop tih; hae loe Levinawk mah sak han koi tok ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toe saning qui pangato akoep naah loe, kahni im thungah toksakhaih hoiah anghak o tih; toksah o mak ai boeh;
  </para>
  <para style="p">
    <verse number="26" style="v" />Angmacae nawkamyanawk hoi nawnto toksah o tih; toe nihcae loe toksah o mak ai boeh. Hae tiah Levi kaminawk mah sak han koi tok to sah paeh, tiah a naa.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izip prae hoi tacawt o pacoeng, saning hnetto haih, khrah hmaloe koek naah, Sinai praezaek ah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />atue phak naah Israel kaminawk misong loihaih ni to uumsak ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sakhaih atawk baktih, sakhaih daan baktih toengah, hae khrah hatlai palito, duembang phak naah loe, uumhaih poih to sah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="4" style="v" />To pongah Mosi mah Israel kaminawk khaeah, misong loihaih poih to sak o hanah a thuih pae.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah khrah tangsuek, ni hatlai palito naah, Sinai praezaek ah misong loihaih poih to a sak o; Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Israel kaminawk mah sak o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toe kadueh kami pongah kaciim ai thoemto kaminawk loe, misong loihaih poih to sah o thai ai pongah, Mosi hoi Aaron khaeah angzoh o moe,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi khaeah, Kadueh kami pongah kaicae loe ka ciim o ai boeh; tipongah atue phak naah kalah Israel kaminawk baktih toengah, Angraeng khaeah hmuen tathlanghaih nang sahsak ai loe? tiah a naa o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi mah nihcae khaeah, Nangcae kawng pongah Angraeng mah lok na paek ai karoek to, zing o raeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel kaminawk khaeah, Nangcae hoi na caanawk loe kadueh kami pongah ciimcai ai ah na oh o moe, kholong kangthla ah na caeh o cadoeh, misong loihaih poih to na sah o thai tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khrah hnetto haih, ni hatlai palito, duembang ah sah oh; nihcae mah tuucaa moi hoi aan kakhaa to taeh thuh ai ih takaw hoiah nawnto caak o han oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Moi to khawnbang khoek to amtlai o sak han om ai; ahuh to khaek ai ah, misong loihaih poih sakhaih atawk baktih toengah sak o han oh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe amhnonghaih om ai, kholong ah doeh caeh ai to mah, misong loihaih poih to sah ai kami loe, atue phak naah Angraeng khaeah hmuen tathlanghaih sah ai pongah, anih to angmah ih kaminawk salak hoiah takhoe ving han oh; anih loe zaehaih atho to hnu tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangcae khaeah kaom angvin mah Angraeng hanah misong loihaih ni to uum han koeh nahaeloe, sak zong ih misong loihaih baktih, poih sakhaih atawk baktih toengah a sak han oh; prae kami hoi angvin hanah poih sakhaih dan kangvan ah sah paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kahni im sakhaih niah, hnukung ah kaom, kahni im to tamai mah khuk hmoek; duembang hoi akhawnbang khoek to kahni im ranui ah hmai baktiah amtueng.
  </para>
  <para style="p">
    <verse number="16" style="v" />To tiah oh poe; athun ah tamai mah khuk moe, aqum ah hmai baktiah amtueng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tamai mah kahni im to caehtaak naah, Israel kaminawk kholong caeh o moe, tamai tabok naah, Israel kaminawk mah im to sak o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angraeng mah paek ih lok baktih toengah, Israel kaminawk kholong caeh o moe, Angraeng mah paek ih lok baktih toengah nihcae mah im to sak o; kahni im nuiah tamai oh nathung, nihcae loe angmacae ih kahni im ah anghak o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kahni im nuiah atue kasawk ah tamai oh naah, Israel kaminawk kholong caeh o ai, Angraeng mah paek ih lok to a zing o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kahni im nuiah atue setta thung tamai tabok naah loe, Angraeng mah paek ih lok baktih toengah anghak o; to pacoengah Angraeng mah paek ih lok baktih toengah kholong caeh o let.
  </para>
  <para style="p">
    <verse number="21" style="v" />Duembang hoi akhawnbang khoek to tamai tabok moe, akhawnbang ah tamai van bangah angkhong tahang naah, Israel kaminawk kholong caeh o; khodai ah doeh, khoving ah doeh, tamai angkhong tahang kruek, kholong a caeh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kahni im nuiah ni hnetto maw, to tih ai boeh loe khrah to maw, to tih ai boeh loe saningto maw, tamai mah khuk nahaeloe, Israel kaminawk loe tamai oh nathung kholong caeh o mak ai, anghak o tih; toe tamai van ah angkhong tahang nahaeloe, nihcae mah kholong caeh amsak o tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah paek ih lok baktih toengah, nihcae loe im ah anghak o moe, Angraeng mah paek ih lok baktih toengah, nihcae loe kholong caeh amsak o; Angraeng mah Mosi ban ah paek ih lok baktih toengah, Angraeng ih lok to tahngaih o.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />kaminawk amkhueng o naah kawkhaih, ataihaih ahmuen maeto pacoeng maeto bang angpuen naah patoh hanah, sum kanglung hoiah mongkah hnetto sah ah;
  </para>
  <para style="p">
    <verse number="3" style="v" />mongkah na ueng o hmaek naah, acaeng kaminawk boih angkhuenghaih kahni im thok taengah, nang ih ahma ah amkhueng o boih tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mongkah maeto khue ueng nahaeloe, ukkungnawk hoi Israel ukkung lu koeknawk to na hma ah amkhueng o tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Acoe paekhaih mongkah to ueng naah, ni angyae bangah kaom kaminawk to hmabang ah caeh o tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Acoe paekhaih mongkah vai hnetto ueng naah, aloih bang ataihaih ahmuen ah kaom kaminawk to caeh o tih; acoe paekhaih mongkah lok loe nihcae caeh han angmathaih lok ah om tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaminawk amkhueng o hanah, mongkah to ueng ah; toe kanghmong acoe paekhaih to ueng hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aaron caanawk hoi qaimanawk mah mongkah to ueng o tih; hae loe na caanawk dung khoek to sak han koi hmuen ah om tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na prae thungah nangcae pacaekthlaek misanawk to tuk hanah na caeh o naah, acoe paekhaih lok hoi mongkah to nawnto ueng ah; to naah na Angraeng Sithaw mah nangcae to panoek ueloe, na misanawk ban thung hoiah pahlong tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangcae loe nawmhaih atue, poihsakhaih atue, khrah kangtha uumhaih atue ah na Angraeng Sithaw na panoek o thai hanah, angbawnhaih hoi angdaeh angbawnhaih sak naah mongkah to ueng oh; Kai loe na Angraeng Sithaw ah ka oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Saning hnet, khrah hnetto haih, ni pumphaeto naah, hnukung ah kaom kahni im ranui ih tamai to van bangah angkhoeng tahang.
  </para>
  <para style="p">
    <verse number="12" style="v" />To naah Israel kaminawk loe kholong caeh han Sinai praezaek hoiah angthawk o; to pacoeng ah Paran praezaek ah tamai to anghak let.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng mah Mosi khaeah paek ih lok baktih toengah, hae loe nihcae hmaloe koek kholong caehhaih ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Judah kaminawk loe angmacae angmathaih kahni to sin o moe, ataihaih ahmuen hoiah hmaloe koek ah caeh o; Amminadab capa Nashon loe nihcae ukkung ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zuar capa Nathanel loe Issakar acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Helon capa Eliab loe Zebulun acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pacoengah kahni im to phraek o, Gershon hoi Merari ih caanawk mah aput o moe, a caeh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pacoengah Reuben kaminawk mah angmacae angmathaih kahni to sin o moe, ohhaih ahmuen hoiah hmabang ah caeh o; Shedeur capa Elizur loe nihcae zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zurshaddai capa Shelumiel loe Simeon acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Deuel capa Eliasaph loe Gad acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah Kohath acaegnawk mah hmuenciim ih hmuenmaenawk to aput o moe, hmabang ah caeh o; hmaloe caeh kaminawk mah nihcae pha ai naah kahni im to sak o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ephraim kaminawk loe angmacae angmathaih kahni to sin o moe, ataihaih hmuen hoiah hmaloe koek ah caeh o; Ammihud capa Elishama loe nihcae zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pehdazur capa Gamaliel loe Manasseh acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gideoni capa Abidan loe Benjamin acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hnukkhuem koek ah, Dan kaminawk loe angmacae angmathaih kahni to sin o moe, ataihaih ahmuen hoiah hmabang ah caeh o; Ammishaddai capa Ahiezer loe nihcae zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Okran capa Pagiel loe Asher acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Enan capa Ahira loe Naphatali acaeng zaehoikung ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hae loe Israel kaminawk kholong caeh naah, angmacae acaeng maeto pacoeng maeto caehhaih dan ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Angraeng mah, Mosi khaeah paek ih lok baktih toengah, Mosi mah Midian prae, Mosi ih amsae, Raguel capa Hobab khaeah, Angraeng mah nangcae khaeah ka paek han, tiah lokkam ih prae thungah vaihi ka caeh o; kaicae hnukah bang ah, Angraeng mah Israel kaminawk ih khosak hoihaih kawng to thuih boeh pongah, nang to kang tahmen o han hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hobab mah anih khaeah, Ka caeh mak ai; ka prae hoi kaimah ih kaminawk khaeah ni ka caeh han, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toe Mosi mah, Kaicae hae na caehtaak hmah; kaicae loe praezaek ah ka tai o han vop, tito na panoek; nang loe kaicae ih mik ah na oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kaicae hoi nawnto nang zoh nahaeloe, Angraeng mah kaicae khaeah paek ih kahoih hmuen, nang han doeh kang pazet o toeng han, tiah a naa.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pongah Angraeng ih mae hoiah angthawk o moe, ni thumto caehhaih kangthla ahmuen ah a caeh o; ni thumto kholong caeh nathung, Angraeng lokkamhaih thingkhong loe, nihcae ataihaih ahmuen to pakrong pae hanah, nihcae hmaa ah caeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khodai ah nihcae kholong caeh o naah, Angraeng ih tamai loe nihcae nuiah oh poe.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thingkhong hmabang ah caeh naah, Mosi mah, Aw Angraeng, Angthawk ah! Na misanawk loe amhet o phang nasoe loe, nang hnuma kaminawk to na hma ah cawn o nasoe, tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />Anghakhaih ahmuen to a phak o naah, Kroek laek ai Israel kaminawk khaeah, Aw Angraeng, amlaem let lai ah, tiah a naa.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />1 Kaminawk mah laisaep thui ih lok to Angraeng mah thaih naah, palungphui hmai baktiah amngaeh; to pongah Angraeng ih hmai mah nihcae salak to kangh moe, kangthla koek ohhaih ahmuen taeng ih thoemto kaminawk to duek o.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah kaminawk loe Mosi khaeah hangh o; Mosi mah Angraeng khaeah lawkthuih naah, hmai to duek let.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng ih hmai mah nihcae salak to kangh pongah, to ahmuen to Taberah, tiah kawk o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel kaminawk hoi nawnto kaom prae kalah kaminawk loe, zok amthlam o; Israel kaminawk doeh qah o moe, mi mah maw ka caak o hanah moi na paek tih?
  </para>
  <para style="p">
    <verse number="5" style="v" />Izip prae ah atho paek ai ah caak ih tanga moi, paye thaih, yaengkaem thaih, rasawn kathim hoi kanglung rasawn, kalah congca aannawk to ka poek o parai boeh;
  </para>
  <para style="p">
    <verse number="6" style="v" />toe vaihi loe ka hing o haih thazok sut boeh; hae ih manna khue ai ah loe, kalah tidoeh hnuk han koi om ai, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Manna loe Coriander thingthai mu baktiah oh moe, arong loe bedellium thingthai mu hoiah anghmong.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaminawk loe caeh o moe, Manna akhuih o pacoengah, daengh o moe, long laom pongah takaw baktiah pahaih o; to loe situi hoiah haek ih takaw baktiah khraem.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ataihaih ahmuen ah aqum ih dantui krak naah, manna doeh dantui hoi nawnto krak toeng.
  </para>
  <para style="p">
    <verse number="10" style="v" />To naah kami boih angmacae ih thok taengah, angmacae imthung takoh boih hoi nawnto qahhaih lok to Mosi mah thaih; Angraeng loe palungphui parai pongah, Mosi doeh poek nawm ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah Mosi mah Angraeng khaeah, Tipongah na tamna raihaih nang paek loe? Tikhoe na hmaa ah mikcuk naakrak ah ka om ai to mah, hae kaminawk boih ih hmuenzit ka nuiah nam tik loe?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hae kaminawk loe kai mah zok ah ka pomh ih kaminawk maw, tikhoe nawkta tapenkung mah nawkta to tapom baktih toengah, hae kaminawk hae ka ban ah tapom moe, nihcae ampanawk khaeah paek hanah lok na kam ih, prae thungah caeh haih hanah nang thuih loe?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hae kaminawk hanah naa ih moi maw ka la pae thai tih? Nihcae mah kai khaeah, Caak han moi na paek ah, tiah ang hnik o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae kaminawk hae kaimah bueng ka hoi thai mak ai; hae hmuen loe kai hanah azit hmoek.
  </para>
  <para style="p">
    <verse number="15" style="v" />To tiah kai hae nang ohsak moe, na mikhnuk ah koeh koiah ka oh nahaeloe, vaihiah na hum halat ah! Amtanghaih na hnusak hma ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah Mosi khaeah, Israel kacoehtanawk qui sarihto hoi zaehoikungnawk, na panoek ih ukkungnawk to nangmah hoi nawnto amkhuenghaih kahni im ah angdoet o thai hanah, kai khaeah angzo haih ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />To ah nang hoi lokthuih hanah kang zoh tathuk han; na nuiah kaom pakhra to ka lak moe, nihcae nuiah ka suek han; hae kaminawk hae nangmah bueng na hoi mak ai, kaminawk ih hmuen kazit to nihcae mah na lawn o tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kaminawk khaeah hae tiah thui paeh; khawnbang hanah ciimcai oh, moi to na caa o tih; nangcae mah, Mi mah maw caak han moi na paek tih? Izip prae ah loe khosak kahoih ah ka oh o, tiah na qah o haih lok Angraeng mah thaih boeh pongah, Angraeng mah moi na paek o ueloe, na caa o tih boeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nito, ni hnetto, ni pangato, ni hato, ni pumphaeto khue na caa o mak ai;
  </para>
  <para style="p">
    <verse number="20" style="v" />na hnah thung hoiah moi tacawt moe, na panuet o sut khoek to, khrato thung moi to na caa o poe tih; nangcae salakah kaom Angraeng to khet na patoek o moe, tih pongah maw Izip prae to ka caeh o taak? tiah anih hmaa ah na qah o pongah, khrah to thung moi to na caa o tuek tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toe Mosi mah loe, Kai hoi nawnto kholong caeh kami sang cumvai tarukto oh o; khrah to thung caak poe han ih moi to kang paek han, tiah na thuih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae caak kakhawt ah maitaw hoi tuunawk to boh han maw? Tuipui ih tanganawk boih naeh cadoeh, nihcae caak han khawt tih maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah Mosi khaeah, Angraeng ih ban loe duem tet maw? Ka thuih ih lok baktih toengah nangcae khaeah oh maw, om ai, tito vaihi na hnu tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi loe caeh moe, Angraeng mah thuih ih loknawk to kaminawk khaeah thuih pae; nihcae thung ih kacoehta qui sarihto a kawk moe, kahni im taengah ohsak.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah Angraeng loe tamai hoiah anghum tathuk moe, anih khaeah lokthuih; anih nui ah kaom Pakhra to a lak moe, kacoehta qui sarihto nuiah a suek; nihcae nuiah Pakhra oh naah, nihcae loe boeng ai ah lok taphong o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe kami hnetto, Eldad hoi Medad loe ataihaih ahmuen ah oh hoi poe; nihnik doeh kacoehta thungah athum hoi toeng, toe kahni im taengah caeh hoi ai; nihnik nuiah doeh Pakhra to oh pongah, atai hoi haih ahmuen ah lok taphong hoi toeng.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thendoeng maeto loe cawnh moe, Mosi khaeah, Eldad hoi Medad hnik doeh ataihaih im ah lok taphong hoi toeng, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosi ih tamna, thendoeng, Nun capa Joshua mah, Ka angraeng Mosi, nihnik to lokthuih anghaksak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Toe Mosi mah anih khaeah, Ka nuiah uthaih palungthin na tawnh maw? Angraeng ih kaminawk loe tahmaa ah ni oh o boih, Angraeng mah nihcae nuiah angmah ih Muithla to suem tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pacoengah Mosi hoi Israel kacoehtanawk loe a oh o haih im ah amlaem o let.
  </para>
  <para style="p">
    <verse number="31" style="v" />To naah Angraeng khae hoiah takhi to songh moe, nihcae ataihaih im hae bang hoi ni to caehhaih loklam, ho bang hoiah doeh ni to caehhaih loklam karoek to, tuipui hoiah kuikoem to a sin pae; long hoi dong hnetto kathah ah angpopsak.
  </para>
  <para style="p">
    <verse number="32" style="v" />To naah kaminawk mah athun qui, aqum puek, kuikoem to akhuih o, khawnbang khoek to a lak o; tamsi koek akhui kami mah homer hato akhuih o; kuikoem to atai o haih im taeng boih ah tapop o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe kuikoem moi to caa o ai naah, Angraeng palungphuihaih kaminawk nuiah phak; to pongah nihcae khaeah kanung parai nathaih kasae to phaksak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Caak amoeh hmoek kaminawk to aphum o pongah, to ahmuen to Kibroth-Hattaavah, tiah kawk o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kaminawk loe Kibroth-Hattavah ahmuen hoiah Hazeroth ahmuen ah caeh o moe, to ah atai o.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi mah Ethiopia tanu to zu haih moe, Ethiopia nongpata to zu ah a lak pongah, Miriam hoi Aaron mah Mosi to kasae thuih hoi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihnik mah, Angraeng mah Mosi khae khue ah maw lokthuih? Aicae khaeah doeh lokthui ai maw? tiah a thuih hoi. To lok to Angraeng mah thaih.
  </para>
  <para style="p">
    <verse number="3" style="v" />(To naah Mosi loe long pum ah kaom kaminawk boih pongah doeh, poek panaemhaih tawn kami ah oh.)
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah, Mosi, Aaron hoi Miriam khaeah, Nangcae long thumto amkhuenghaih im ah angzo oh, tiah a naa. To pongah nihcae loe caeh o.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah Angraeng loe tamai thung hoiah angzoh tathuk, kahni im thok taengah angdoet moe, Aaron hoi Miriam to kawk; nihnik loe hmabang ah tacawt hoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah, Ka lok hae tahngai hoih; Nangcae salakah Angraeng ih tahmaa to om nahaeloe, anih khaeah hnuksakhaih hoiah kam tueng moe, anih khaeah amang ah lok ka thuih pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe ka tamna Mosi loe to tiah om ai; anih loe ka imthung takoh boih ah oep thok koek kami ah oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anih hoi lok ka thuih naah, mikhmai kangtong ah ni lok ka thuih han, thaih karai lok hoiah ka thui mak ai; anih mah Angraeng ih krang to hnu tih; tikhoe ka tamna Mosi ih lok aek hanah zithaih na tawn hoi ai loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng palungphuihaih mah nihnik to kangh, to pacoengah anih mah caehtaak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tamai mah kahni im to caehtaak pacoengah, khenah, Miriam loe dantui kanglung baktiah ngansae man khrung; Aaron mah Miriam to khet naah, anih loe ngansae man kami ah a hnuk.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah Aaron mah Mosi khaeah, Ka angraeng, amthuhaih hoiah ni hmuen hae ka sak hoi moeng boeh, tahmenhaih hoiah hae zaehaih hae kai hnik nuiah amtii hmah raeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih hae amno ih zok thung hoiah tacawt naah kakoep ai kami, takpum ahap kadueh kami baktiah omsak hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah Mosi mah Angraeng khaeah, Aw Sithaw, tahmenhaih hoiah anih hae vaihi ngantuisak rae ah, tiah a hangh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Angraeng mah Mosi khaeah, ampa mah Miriam ih mikhmai ah pathoih nahaeloe, anih loe ni sarihto thung azathaih hoiah om mak ai maw? Anih to na oh o haih ahmuen tasa bangah ni sarihto thung suem ah, to pacoengah a thungah akunsak let ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah Miriam to ataihaih im tasa bangah ni sarihto thung a suek o; Miriam a thungah akun o sak let ai karoek to, kaminawk loe kholong caeh o ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah kaminawk loe, Hazeroth ahmuen ah angpuen o moe, Paran praezaek ah ohhaih ahmuen takhawh o.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />kai mah Israel kaminawk khaeah paek ih Kanaan prae khet hanah kami to patoeh ah; acaeng maeto thung hoi zaehoikung maeto patoeh ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng mah paek ih lok baktih toengah, Mosi mah Paran praezaek hoiah nihcae to patoeh; nihcae loe Israel zaehoikung ah oh o boih.
  </para>
  <para style="p">
    <verse number="4" style="v" />To kaminawk ih ahmin loe, Reuben acaeng thung hoiah, Zakur capa Shammua.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon acaeng thung hoiah, Hori capa Shaphat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah acaeng thung hoiah, Jephunneh capa Kaleb.
  </para>
  <para style="p">
    <verse number="7" style="v" />Issakar acaeng thung hoiah, Joseph capa Igal.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim acaeng thung hoiah, Nun capa Oshea.
  </para>
  <para style="p">
    <verse number="9" style="v" />Benjamin acaeng thung hoiah, Raphu capa Palti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebulun acaeng thung hoiah, Sodi capa Gaddiel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Joseph acaeng ah kaom, Mannaseh acaeng thung hoiah, Susi capa Gaddi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan acaeng thung hoiah, Gemalli capa Ammiel.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher acaeng thung hoiah, Mikhael capa Sethur.
  </para>
  <para style="p">
    <verse number="14" style="v" />Naphtali acaeng thung hoiah, Vophsi capa Nahbi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad acaeng thung hoiah, Maki capa Geuel.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hae kaminawk loe Mosi mah tamquta hoi prae khet han patoeh ih kami ah oh o. Mosi mah Nun capa Oshea to Jehoshua, tiah ahmin paek.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kanaan prae khet hanah Mosi mah nihcae to patoeh naah, aloih bang hoiah caeh o tahang ah loe, mae ah daw o tahang poe ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Prae loe kawbang maw oh; to ah kaom prae kaminawk loe thacak o maw, thacak o ai, kami pop o maw, pop o ai;
  </para>
  <para style="p">
    <verse number="19" style="v" />nihcae ohhaih prae loe hoih maw, hoih ai; kawbaktih vangpui thungah maw oh o; buk thungah maw, to tih ai boeh loe sipae kaom vangpui thungah;
  </para>
  <para style="p">
    <verse number="20" style="v" />long loe kawbang maw oh, long loe hoih maw, hoih ai; thing pop maw, pop ai, tito khen oh; misahoih oh loe, prae thung ih thingthai doeh sin oh, tiah a naa. To nathuem ih atue loe misurthaih hmin tangsuekhaih atue ah oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pongah nihcae loe Zin praezaek hoiah caeh o moe, Hammath vangpui taeng ih Rehob ahmuen karoek to prae to a khet o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aloih bang hoiah caeh o poe moe, Anak caanawk, Ahiman, Sheshai hoi Talmai ohhaih, Hebron vangpui to a phak o. Hebron vangpui loe Izip prae ih Zoan vangpui sah ai naah saning sarihto oh boeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Eshkol ih vacong to phak o naah, misurthaih kangbom tanghang maeto pakhruk o moe, kami hnetto mah angzawn hoi; pomogranat thaih hoi thaiduet thaih doeh angzawn hoi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Israel kaminawk mah to ahmuen ah kanghmat misurthaih tanghang maeto pakhruk o pongah, to ahmuen to Eshkol vacong, tiah kawk o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni qui palito pacoengah prae khethaih ahmuen hoiah amlaem o let.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nihcae loe Mosi hoi Aaron ohhaih Paran praezaek ih Kadesh ah, Israel kaminawk khaeah angzoh o let; nihcae khaeah prae khethaih kawng to thuih pae o, kaminawk khaeah to prae thung ih thingthai to patuek o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mosi khaeah, Nang patoeh ih prae thungah ka caeh o, to prae loe khoitui hoi tahnutui long tangak boeh; hae loe to prae thung hoi kang sin o ih thingthai ah oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toe to prae thungah kaom kaminawk loe thacak o parai moe, vangpuinawk doeh len parai, vangpuinawk loe sipae thungh o boih; to ahmuen ah Anak ih caanawk to ka hnuk o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amalek kaminawk loe aloih bang prae ah oh o; Hit kaminawk, Jebus kaminawk hoi Amor kaminawk loe mae nuiah oh o; Kanaan kaminawk loe tuipui taeng hoi Jordan vapui taengah oh o, tiah a thuih pae o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kaleb mah Mosi hmaa ah kaminawk to anghaisak moe, Caeh o si loe, to prae to la o si; a pazawk o thai tih hmang, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toe anih hoi nawnto caeh kaminawk mah loe, To ih kaminawk to a pazawk o thai mak ai; nihcae loe aicae pongah thacak o kue, tiah a naa o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nihcae mah prae khethaih tamthang kasae to Israel kaminawk salakah haeh o; to kaminawk mah, Ka caeh moe, ka khet o ih prae loe, a thungah kaom kaminawk paaeh boih prae ah oh; to ah kaom ka hnuk o ih kaminawk boih loe len o phi.
  </para>
  <para style="p">
    <verse number="33" style="v" />To ah kalen parai kami, Anak caanawk to ka hnuk o; nihcae loe kalen parai kami hoi anghum tathuk kami ah oh o; nihcae mikhnuk ah kaicae loe pakhuh baktiah ni ka oh o; kaicae loe nihcae mikhnuk ah to tiah ka oh o, tiah a naa o.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />To aqum naah kaminawk loe tha hoi hangh o moe, qah o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk boih mah Mosi hoi Aaron to laisaep o thuih, Izip prae ah maw, to tih ai boeh loe praezaek ah duek halat nahaeloe hoih han to mah!
  </para>
  <para style="p">
    <verse number="3" style="v" />Tikhoe aicae loe sumsen hoiah a duek o moe, aicae ih zu caanawk minawk mah lomh hanah, Angraeng mah hae prae ah caeh haih loe? Izip prae ah amlaem let nahaeloe, hoikhang tih, tiah nihnik khaeah thuih pae o.
  </para>
  <para style="p">
    <verse number="4" style="v" />To naah angmacae hoi angmacae zaehoikung to qoi o si loe, Izip prae ah amlaem o let si, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi hoi Aaron mah to ah amkhueng Israel kaminawk boih hma ah, long ah akuep pae hoi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kanaan prae khet han kacaeh, Nun capa Joshua hoi Jephunneh capa Kaleb loe, angmah hnik ih kahni to angkhring hoi pacoengah,
  </para>
  <para style="p">
    <verse number="7" style="v" />to ah amkhueng Israel kaminawk boih khaeah, a caeh o moe, a khet o ih prae loe hoih parai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng mah aicae nuiah palung tongh nahaeloe, tahnutui hoi khoitui longhaih prae thungah, aicae na caeh haih ueloe, hae prae hae aicae han na paek tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng nuiah laisaep o hmah loe, to ih prae kaminawk to zii o hmah; nihcae loe a caak o han koi takaw ah ni oh o; nihcae loe angvaenghaih tawn o ai; Angraeng loe aicae hoi nawnto oh; nihcae to zii o hmah, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toe kaminawk mah nihnik to thlung hoiah vah han thuih o; to naah Angraeng lensawkhaih Israel kaminawk amkhuenghaih kahni imthung ah phak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah Mosi khaeah, Hae kaminawk mah nasetto maw palung na phui o sak tih? Nihcae khaeah ka sak ih dawnrai hmuen to a hnuk o boeh; toe nasetto maw hae kaminawk mah kai tang ai ah om o vop tih?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae nuiah kasae nathaih ka phaksak han, qawk doeh ka toepsak mak ai; toe nihcae pong kalen kue, thacak kue acaeng ah nang to kang sak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi mah Angraeng khaeah, To tiah nahaeloe, Na thacakhaih hoiah hae kaminawk hae na zaehhoih, tiah Izip kaminawk mah panoek o tih boeh;
  </para>
  <para style="p">
    <verse number="14" style="v" />to naah nihcae mah hae prae ah kaom kaminawk khaeah hae tamthang hae thui pae o tih; Angraeng, nang loe hae kaminawk hoi nawnto na oh, Angraeng, nang to mikhmai kangtong ah a hnuk o boeh; nang ih tamai loe nihcae nuiah angdoet moe, nang loe nihcae hma ah na caeh; khodai ah nihcae to tamai hoiah na zaeh moe, khoving ah hmaithaw hoiah na caeh haih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hae kaminawk boih hae kami maeto baktiah vaihi na dueksak nahaeloe, nang ih tamthang thaih acaengnawk mah loe,
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah to kaminawk khaeah prae to kang paek han, tiah lokkamhaih a sak pae; toe anih mah to prae thungah caeh haih thai ai pongah, praezaek ah a hum boih, tiah thui o tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na thuih ih lok baktih toengah, vaihiah ka Angraeng thacakhaih to len nasoe,
  </para>
  <para style="p">
    <verse number="18" style="v" />Angraeng loe palungsawk, amlunghaih hoiah koi moe, zaehaih hoi sakpazaehaihnawk to tahmen pae; toe zaehaih sah kami loe thuitaek ai ah om ai; anih loe ampanawk zaehaih pongah adung thum, adung pali karoek to a caanawk thuitaekkung ah oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kalen parai na palungnathaih rang hoiah, Izip prae thung hoi kamtong vaihni ni khoek to hae kaminawk hae na tahmen baktih toengah, hae kaminawk zaehaih doeh tahmen raeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angraeng mah, Nang hnik ih lok baktih toengah, kang tahmen boeh;
  </para>
  <para style="p">
    <verse number="21" style="v" />toe kai ka hing tangtang baktih toengah, longpum ah Angraeng lensawkhaih to koi tih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izip prae hoi praezaek ah ka sak ih lensawkhaih hoi dawnrai hmuennawk hnu kaminawk boih mah ka lok hae tahngai o ai, vai hato Kai ang tanoek o pongah,
  </para>
  <para style="p">
    <verse number="23" style="v" />ampanawk khaeah paek han tiah lokkam ih prae to mi mah doeh hnu o mak ai; kai palungphuisak kawbaktih kami mah doeh to prae to hnu o mak ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe ka tamna Kaleb loe, kalah poekhaih pakhra to tawnh moe, palungthin boih hoiah kai ang bang pongah, anih to a caehhaih prae thungah ka hoih han; anih ih caanawk mah prae to toep o tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amalek hoi Kanaan kaminawk loe azawn ah khosak o; khawnbang ah amlaem oh loe, tuipui kathim bang hoiah praezaek ah caeh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="27" style="v" />ka lok to aek moe, laisaep hae ih kasae kaminawk hae nasetto maw ka pauep han vop? Israel kaminawk mah kasae ang thuih o moe, kai laisaep thuihaih lok to ka thaih boeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nihcae khaeah, Kai ka hing pongah, ka naa ah nang thuih o ih baktih toengah, ka sak han, tiah Angraeng mah thuih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na kroek o ih nangmacae kaminawk boih thungah, kai laisaep thuih, saning pumphaeto hoi ranuih bang kaminawk loe praezaek ah dueh o tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jephunneh capa Kaleb hoi Nun capa Joshua khue ai ah loe, ban ka payangh moe, ohsak hanah lok ka kam ih prae thungah mi doeh akun o mak ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Misa mah lomh ving tih, tiah na thuih o ih na caanawk to kai mah ka zaeh han, nangcae mah na khet patoek o ih prae to nihcae mah panoek o tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toe nangcae loe hae praezaek ah na dueh o ueloe, qok doeh pong sut tih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nangcae loe oepthok ah kho na sah o ai pongah, praezaek ah nangcae ih qok to pong sut boih ai karoek to, na caanawk loe saning qui palito thung praezaek ah amhet o tih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Prae pakrong hanah ni qui palito akra baktih toengah, nito hae saningto ah suem oh, na sak o ih zaehaih atho baktih toengah, saning qui palito thung patang na khang o tih; to naah ka lok aekhaih atho to na panoek o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kai, Angraeng mah lokthuih boeh; kai ih lok aek hanah nawnto amkhueng, kahoih ai hae kaminawk nuiah, hae hmuen hae ka sak tangtang han; nihcae loe hae praezaek ah amro o ueloe, dueh o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />To pongah prae khet hanah Mosi mah patoeh ih kaminawk amlaem o pacoengah, a khet o ih prae loe hoih ai, tiah amkhueng kaminawk hmaa ah laisaep thuih kaminawk,
  </para>
  <para style="p">
    <verse number="37" style="v" />kanaan prae loe hoih ai tiah thui kaminawk loe, Angraeng hmaa ah kasae nathaih mah phak thuih moe, duek o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Prae khet han kacaeh kaminawk boih thungah, Nun capa Joshua hoi Jephunneh capa Kaleb hnik khue ni hing hoi.
  </para>
  <para style="p">
    <verse number="39" style="v" />To lok to Mosi mah Israel kaminawk khaeah thuih pae naah, kaminawk loe paroeai hangh o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Khawnbang khawnthaw ah angthawk o moe, mae nuiah caeh o; khenah, a zae o boeh; toe Angraeng mah lokkam ih ahmuen ah caeh o si, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="41" style="v" />Toe Mosi mah, Tipongah vaihi Angraeng mah paek ih lok to na tahngai o ai loe? Hae tiah na sak o nahaeloe na qoeng o thai mak ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nangcae khaeah Angraeng om ai pongah, caeh o tahang hmah; na caeh o nahaeloe misanawk to na pazawk o mak ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amalek hoi Kanaan kaminawk loe, nangcae hma ah oh o boeh pongah, nangcae loe sumsen hoiah na dueh o tih; nangcae mah Angraeng to nang qoi o taak boeh pongah, nangcae khaeah Angraeng om mak ai boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="44" style="v" />Toe Mosi hoi Angraeng ih thingkhong loe, ataihaih ahmuen to caehtaak ai; toe nihcae loe palungthah o pongah, mae nuiah caeh o nganga.
  </para>
  <para style="p">
    <verse number="45" style="v" />To naah to mae nuiah kaom, Amalek hoi Kanaan kaminawk anghum o tathuk moe, Israel kaminawk to tuk o, nihcae to pazawk o pacoengah, Hormah vangpui khoek to patom o.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk khaeah hae tiah thui paeh; nihcae khaeah, Kang paek ih prae thungah na kun o naah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Angraeng khaeah hmai angbawnhaih to sah oh; maitaw maw, to tih ai boeh loe tuu to Angraeng khaeah hmai angbawnhaih ah paek oh; maitaw doeh, tuu doeh Angraeng khaeah hmuihoih hmuen ah maw, to tih ai boeh loe angbawnhaih maw, to tiah ai boeh loe tathlang ih hmuen ah maw, to tih ai boeh loe lokkamhaih sak han ih maw, to tih ai boeh loe aimah koehah paek ih hmuen tathlanghaih maw, poihsakhaih ah tathlang ih hmuen ah maw sah oh:
  </para>
  <para style="p">
    <verse number="4" style="v" />mi kawbaktih doeh Angraeng khaeah hmuen paekhaih sin kami loe, cang paekhaih sak naah situi hint palito thungah maeto hoi atok ih takaw dip ephah hato thungah maeto paek han oh;
  </para>
  <para style="p">
    <verse number="5" style="v" />tuucaa hoi angbawnhaih sah nahaeloe, naek han koi hmuen hoi misurtui hint palito thungah maeto paek han oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuu tae maeto hoi angbawnhaih sah nahaeloe, cang ephah hato thungah hnetto, situi hint thumto thungah hint maeto hoi atok ih takaw dip to paek han oh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng khaeah hmuihoih ah hmuen tathlang nahaeloe, naek koi paek naah misurtui hint thumto thungah maeto paek han oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng khaeah maitaw tae hoi angbawnhaih maw, to tih ai boeh loe hmuen paekhaih, to tih ai boeh loe lokkamhaih sak han angbawnhaih maw, to tih ai boeh loe angdaeh angbawnhaih maw sak naah,
  </para>
  <para style="p">
    <verse number="9" style="v" />maitaw tae hoi nawnto situi hint ahap hoi atok tangcae ih takaw dip ephah hato thungah thumto sin ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Naek hanah misurtui hint ahap to sin ah. To tiah hmai hoi sak ih angbawnhaih loe Angraeng khaeah paek ih hmuihoih ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Maitaw tae maeto, to tih ai boeh loe tuu tae maeto, to tih ai boeh loe tuucaa maeto, to tih ai boeh loe maeh caa maeto hoi angbawnhaih sak naah to tiah sak han oh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kapop maw, tamsi maw, sak na timhaih nuiah pakoep ah loe, maeto boih hanah to tiah sah ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Prae thung tapen kaminawk boih mah, Angraeng khaeah hmuihoih sin han hmai hoi angbawnhaih sak naah, to tiah sak han oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nangcae salakah kaom angvinnawk maw, to tih ai boeh loe mi kawbaktih doeh, hmuihoih ah paek han Angraeng khaeah hmai hoi angbawnhaih sak naah, nangcae mah sak ih baktih toengah a sak o toeng han oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hing thung na caanawk mah pazui o poe hanah paek ih atawk loe, nangcae amkhueng kaminawk hoi nangcae salakah kaom angvinnawk hanah doeh maeto ah ni oh; nangcae Angraeng hmaa ah oh baktih toengah, angvin doeh om toeng tih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangcae hoi nangcae salakah kaom angvinnawk hanah, daan maeto hoi atawk maeto ah omsak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel kaminawk khaeah hae tiah thui paeh; nihcae khaeah, Kang hoih o han ih prae thungah na kun o naah,
  </para>
  <para style="p">
    <verse number="19" style="v" />to prae thung ih takaw na caak o naah doeh, Angraeng khaeah hmuen tathlanghaih to sah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na daengh tangsuek ih takaw dip hoi sak ih takaw hoi na tit tangsuek ih cang to paek ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na caanawk mah hmaloe koek daengh ih takaw to Angraeng khaeah paek o han oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng mah Mosi khaeah paek ih lok na pazui o ai moe,
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng mah Mosi patohhaih rang hoiah ang thuih ih lok to na pazui o ai nahaeloe, Angraeng mah Mosi khaeah thuih ih ni hoi kamtong angzo han koi caanawk dung khoek to,
  </para>
  <para style="p">
    <verse number="24" style="v" />amkhueng kaminawk mah panoek ai ah, poek ai pui hoi zaehaih sah moeng nahaeloe, rangpuinawk mah Angraeng khaeah hmuihoih angbawnhaih sak hanah, a sak o zong ih atawk baktih toengah, saning kanawk maitaw caa to cang hoi nawnto paek o ueloe, zae angbawnhaih sak hanah maeh caa to paek o tih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Qaima mah kaminawk boih hanah zae angbawnhaih to sah pae tih, to naah nihcae mah poek ai pui hoiah a sak o moeng ih zaehaih to tahmen pae tih; Angraeng khaeah hmai hoi angbawnhaih, poek ai pui hoi sak ih zae angbawnhaih sak hanah hmuen to sin o han oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />To tiah sah o nahaeloe, Israel kaminawk hoi nihcae salakah kaom angvinnawk boih mah, poek ai pui hoi sak o moeng ih zaehaih to loihsak tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe kami maeto mah poek ai pui hoiah zaehaih sah moeng nahaeloe, zae angbawnhaih ah saningto kaom, maeh tala maeto a sin han oh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Poek ai pui hoi Sithaw hmaa ah zaehaih sah kami hanah, qaima mah zae angbawnhaih to sah pae tih; to naah anih zaehaih to loisak tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Poek ai pui hoi zaehaih sak o naah, Israel kami hoi nihcae salakah kaom angvin hanah doeh, daan maeto khue tawnh han oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe prae thung tapen Israel kami maw, to tih ai boeh loe angvin maw, zithaih tawn ai ah zaehaih to sah nganga nahaeloe, Angraeng khingyahaih tawn ai pongah, to kami to acaeng thung hoiah pahnawt han oh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anih loe Angraeng ih lok to patoek moe, anih ih lok to aek pongah, to kami to pahnawt sut han oh; anih loe sakpazaehaih atho to hnu tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel kaminawk praezaek ah oh o naah, Sabbath niah thing aek kami maeto a hnuk o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Thing aek kami hnukungnawk mah anih to Mosi, Aaron hoi Israel kaminawk boih hmaa ah hoih o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thing aek kami to kawbang maw lokcaek han tito amtueng ai vop pongah, anih to imthung ah paung o.
  </para>
  <para style="p">
    <verse number="35" style="v" />To naah Angraeng mah Mosi khaeah, To kami loe duek han oh; anih to ataihaih tasa bangah kaminawk boih mah thlung hoiah va o mat tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="36" style="v" />To pongah acaeng kaminawk mah anih to ataihaih imthung hoi tasa bangah zaeh o moe, Angraeng mah Mosi khaeah paek ih lok baktih toengah, duek khoek to thlung hoiah vah o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="38" style="v" />Israel kaminawk khaeah hae tiah thui paeh; angzo han koi caa nawktanawk khoek to, khukbuen atom nuiah rong kahing hoi bangh hanah, apawk to soi ah;
  </para>
  <para style="p">
    <verse number="39" style="v" />to apawknawk to na hnuk o naah, palung thung hoiah na poek o ih baktih toengah caeh moe, mik hoiah na hnuk o ih hmuen hnukah na patom pacoengah, na caeh o pazae han ai ah, Angraeng mah thuih ih loknawk to pakuem o poe ah loe sah oh;
  </para>
  <para style="p">
    <verse number="40" style="v" />to naah kang paek o ih loknawk to pazui boih hanah na panoek o ueloe, na Sithaw khaeah ciimcai hanah kamhoe ah na om tih.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kai loe na Sithaw ah oh hanah, Izip prae thung hoi nangcae zaehoikung, na Angraeng Sithaw ah ka oh; Kai loe na Angraeng Sithaw ah ka oh tiah, a thuih, tiah thui paeh, tiah a naa.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levi acaeng Kohath capa Izhar, Izhar capa Korah loe, Reuben acaeng Paleth capa On, On capa Eliab, Eliab capa hnik Dathan hoi Abiram cae to kawk moe,
  </para>
  <para style="p">
    <verse number="2" style="v" />amkhueng kaminawk thungah minawk mah panoek ih kami, ahmin kamthang kami, amkhuenghaih ukkung Israel kami cumvai hnet, qui pangato hoi nawnto Mosi to hmang o;
  </para>
  <para style="p">
    <verse number="3" style="v" />nihcae loe nawnto amkhueng o moe, Mosi hoi Aaron ih lok to aek o, nihnik khaeah, Kamtlai hmoek ah tok na sak hoi; amkhueng kaminawk loe ciimcai o; Angraeng loe, kami boih nuiah oh bae, tiah a naa o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae ih lok Mosi mah thaih naah a mikhmai long ah akuep;
  </para>
  <para style="p">
    <verse number="5" style="v" />to pacoengah Mosi mah, Korah hoi a hnukbang kaminawk khaeah, Angraeng ih kami loe mi maw, mi maw ciimcai, angmah khaeah angzohsak han ih kami loe mi maw, tito khawnbang ah amtuengsak tih; a qoih ih kami doeh angmah taengah amtuengsak tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang, Korah hoi na hnukbang kaminawk boih hae hae sah oh; sabae to la o ah loe,
  </para>
  <para style="p">
    <verse number="7" style="v" />khawnbang ah Angraeng hmaa ah, sabae thungah hmuihoih hmai thlaekhaih to sah oh; to naah Angraeng mah qoih ih kami loe ciimcai kami ah om tih; nangcae Levi kaminawk loe kamtlai hmoek ah na sak o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi mah Korah khaeah, Nangcae Levi kaminawk, tahngai oh;
  </para>
  <para style="p">
    <verse number="9" style="v" />nangcae loe Angraeng ih kahni imthung ah toksak moe, kaminawk hma ah angdoet pacoengah, nihcae ih tok to sak hanah, nangcae to Israel Sithaw mah a taengah kawk boeh, Israel kaminawk thung hoi pahoe ih hmuen loe, nangcae han tetta hmuen ah maw oh?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmah hoi nam nawkamya Levi ih caanawk boih, angmah hoi kanghnai ah suek boeh to mah, nangcae mah qaima ah oh han ih na pakrong o vop maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah nangmah hoi na hnukbang kaminawk boih nawnto nam khueng o moe, Angraeng ih lok to na aek o; Aaron loe kawbaktih kami ah maw oh moe, na laisaep o thuih? tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pacoengah Mosi mah Eliab capa hnik Dathan hoi Abiram to kawk; toe nihnik mah, Kang zo hoi mak ai,
  </para>
  <para style="p">
    <verse number="13" style="v" />nang mah ni praezaek ah kaicae dueksak hanah, tahnutui hoi khoitui longhaih prae thung hoiah nang tacawt haih, to hmuen loe tetta ah maw oh moe, vaihi kaicae nuiah angraeng ah oh han na koeh vop?
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe tahnutui hoi khoitui longhaih prae ah kaicae nang caeh haih ai, lawk hoi misur takhanawk doeh qawk ah nang paek ai; hae kaminawk ih mik to na taprok pae han maw? Kaihnik loe nang khaeah kang zo hoi mak ai, tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah Mosi loe paroeai palungphui moe, Angraeng khaeah, nihnik mah paek ih hmuen to talawk pae hmah; nihnik khae ih laa hrang maeto doeh ka la pae ai, nihcae han nganbawh kana doeh ka paek vai ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosi mah Korah khaeah, Aaron, nangmah hoi na hnukbang kaminawk boih, khawnbang ah Angraeng hmaa ah angphong oh;
  </para>
  <para style="p">
    <verse number="17" style="v" />kami boih mah hmuihoih thlaekhaih sabae to sin oh, a thungah hmuihoih to suem oh; nangcae boih mah hmuihoih thlaekhaih sabae cumvai hnet, qui pangato Angraeng hmaa ah sin oh; nang hoi Aaron mah doeh hmuihoih sabae to sin hoi toeng ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah kami boih mah angmah ih hmuihoih sabae to sin o moe, hmuihoih to hmai hoiah thlaek o pacoengah, Mosi, Aaron hoi nawnto kaminawk amkhuenghaih kahni im thok taengah angdoet o boih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Korah mah doeh Mosi hoi Aaron ohhaih ahmuen maeto bang ih kaminawk amkhuenghaih thok taengah, angmah hnukbang kaminawk to amkhuengsak toeng; to naah Angraeng lensawkhaih kaminawk boih khaeah amtueng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Atue setta thungah hae kaminawk hae ka hum boih han boeh pongah, hae kaminawk salak hoiah amhoe hoi ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe Mosi hoi Aaron loe long ah akuep hoi moe, Aw Sithaw, kaminawk boih ih pakhra ukkung Sithaw, kami maeto zaehaih pongah, acaeng kaminawk boih nuiah palung na phui han maw? tiah a naa hoi.
  </para>
  <para style="p">
    <verse number="23" style="v" />To naah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Korah, Dathan hoi Abiram ih kahni im hoi kamhoe ah oh hanah kaminawk to lokthui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi loe angthawk moe, Israel kami kacoehtanawk hoi nawnto Dathan hoi Abiram khaeah caeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaminawk khaeah, Hae ah kaom kasae kaminawk ih kahni im hoi kamhoe ah om oh; nihcae ih hmuen tita doeh sui o hmah; to tih ai nahaeloe nangcae doeh nihcae zaehaih pongah nam ro o moeng tih, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaminawk loe Korah, Dathan hoi Abiram cae ih kahni imthung hoiah tacawt o boih boeh pongah, Korah, Dathan hoi Abiram loe a zunawk, a capanawk, a caa nawktanawk hoi nawnto angmacae ohhaih im thok taengah angdoet o.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah Mosi mah, Hae ah kaom hmuennawk loe kaimah koeh ah sak ih na ai ni; Angraeng mah sak han ang patoeh pongah ni ka sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kaminawk boih mah tong ih duekhaih hoi thuitaekhaih to hae kaminawk mah tong o nahaeloe, Angraeng mah kai hae patoeh ai, tito panoek oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toe Angraeng mah hmuen kangtha to sah moe, long to akah rak pacoengah, hae kaminawk hoi nihcae ih ampuinawk to paaeh moe, kahing ah tangqom thungah caeh o nahaeloe, hae kaminawk mah Angraeng to khet patoek o, tito na panoek o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />To loknawk a thuih boih pacoengah, Nihcae ohhaih im tlim ih long to akah rak,
  </para>
  <para style="p">
    <verse number="32" style="v" />long loe pakha aangh moe, to kaminawk hoi nihcae ih imnawk, Korah ih imthung takoh boih, a tawnh ih hmuenmaenawk boih to paaeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />To kaminawk, nihcae hoi angkom kaminawk loe, kahing ah long thungah caeh o tathuk; long mah nihcae to pakuep hmoek; to tiah nihcae loe acaeng kaminawk thung hoiah anghmat angtaa o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nihcae hanghaih lok to thaih o naah, aicae doeh long mah paaeh toeng tih boeh, tiah a poek o pongah, a taengah kaom Israel kaminawk loe cawnh o boih.
  </para>
  <para style="p">
    <verse number="35" style="v" />To naah Angraeng khae hoi hmai to angzoh moe, hmuihoih thlaek kami cumvai hnet, qui pangatonawk to hmai mah kangh boih.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk khaeah hae hae thui paeh; ampanawk ih acaeng zaehoikungnawk khae hoi acaeng maeto naah cunghet maeto, acaeng hatlai hnetto khae hoiah cunghet hatlai hnetto la ah loe, cunghet pongah kami ih ahmin to tarik boih ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levi ih cunghet pongah Aaron ih ahmin to tarik ah; acaeng zaehoikung maeto mah cunghet maeto tawnh boih han oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />To cunghetnawk to lok kang thuihaih ahmuen, kaminawk amkhuenghaih kahni imthung ih hnukung hmaa ah suem ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka qoih kami ih cunghet loe tadok tacawt tih; to pacoengah loe Israel kaminawk mah na nuiah laisaephaih to ka dipsak han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah Mosi mah Israel kaminawk khaeah lokthuih pae, zaehoikungnawk boih mah anih han cunghet maeto paek o boih, acaeng zaehoikung maeto mah, cunghet maeto sin o, sangqum boih ah cunghet hatlai hnetto oh; Aaron ih cunghet doeh to ih cunghetnawk thungah athum toeng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi mah to ih cunghetnawk to hnukung kahni imthung ih Angraeng hmaa ah suek.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khawnbang ah Mosi hnukung kahni imthung ah akun naah, khenah, Levi imthung takoh ah kaom Aaron ih cunghet loe tadok tacawt, aqam tacawt tahang moe, apawk pawk pacoengah, almond thaih to athaih.
  </para>
  <para style="p">
    <verse number="9" style="v" />To naah Mosi mah Angraeng hmaa ih cunghet to Israel kaminawk hma sinh pae boih; nihcae mah khet o moe, angmacae ih cunghet to lak o boih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng mah Mosi khaeah, Aaron ih cunghet to hnukung hmaa ah sin ah loe, to ah suem let ah, to cunghet loe lok tahngai ai kaminawk acoe paekhaih angmathaih ah om tih; to naah ni nihcae mah ka nuiah laisaep o haih to na boengsak tih, to tih ai nahaeloe nihcae loe dueh o moeng tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Angraeng mah thuih ih lok baktih toengah, Mosi mah sak boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel kaminawk mah Mosi khaeah, Khenah, aicae loe a duek o tangtang boeh; aicae loe anghmat boeh, aicae loe anghmat o boih boeh!
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi kawbaktih doeh Angraeng ih kahni im ah angzo kami loe dueh tih; aicae loe a dueh o boih tih boeh maw? tiah a naa o.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Aaron khaeah, Hmuenciim ah sak ih na zae haih pongah loe, nangmah hoi na caanawk, nam pa ih imthung takohnawk mah na zok o tih; qaima toksakhaih pongah zaehaih na sak nahaeloe, nangmah hoi na caanawk mah zok o tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nam pa acaeng, Levi acaengnawk thung ih nam nawkamyanawk to nangcae hoi nawnto toksak han kawk ah; toe nangmah hoi na caanawk loe hnukung kahni imthung ah tok na sah o tih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levi caanawk loe angmacae ih tok hoi kahni imthung ah sak han koi toknawk boih to sah o tih; toe hmaicam hoi hmuenciim ih laom sabaenawk taengah caeh o mak ai; caeh o nahaeloe, nihcae doeh, nangcae doeh na dueh o boih tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nihcae loe nangcae hoi nawnto toksah o ueloe, kaminawk amkhuenghaih kahni im to khenzawn o tih; kahni imthung ah sak han koi toknawk boih to sah o tih; asaeng ai kalah kami loe na taengah anghnaih o han om ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel kaminawk nuiah palungphuihaih phak let han ai ah, nangcae loe hmuenciim hoi hmaicam to khenzawn oh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khenah, Israel kaminawk salak hoiah nam nawkamya Levi kaminawk to ka qoih boeh, amkhuenghaih kahni im ah tok a sak o hanah, Angraeng khaeah paek ih angbawnhaih hmuen baktih toengah nangcae hanah paek boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah nangmah hoi na caanawk loe, hmaicam hoi kahni payanghaih thungah kaom, qaima ih toknawk boih to sah oh; nangcae khaeah qaima toksakhaih to tangqum ah kang paek boeh; kasaeng ai nang khaeah angzo kami loe paduek han oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pacoengah Angraeng mah Aaron khaeah, Khenah, Israel kaminawk mah kaciim ah kai khaeah paek o ih hmuennawk to nang han kang paek boih boeh; nangmah hoi na caanawk mah dungzan ah toep hanah taham ah kang paek boeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmai thungah pha ai, nihcae mah kai khaeah kaciim koek ah paek o ih hmuennawk boih, cang paekhaih, zae loisak han paek ih hmuennawk boih, sakpazaehaih loisak han paek ih hmuennawk boih loe, nangmah hoi na caanawk hanah kaciim koek ah om tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />To hmuennawk to kaciim koek ahmuen ah caa ah; nangcae han ciimcai hmuen ah oh pongah, nongpa boih mah caak thaih.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pacoengah Israel kaminawk mah paek ih hmuennawk hoi tangqum ah paek ih hmuennawk boih to, nangmah hoi na capa hoi na canunawk mah dungzan ah toep hanah atawk baktiah paek ih, nangcae ih qawk ah om tih; na imthung takoh ah kaom kaciim kaminawk mah to hmuennawk to caa o tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae mah Angraeng khaeah paek ih kathai tangsuek thingthai, kahoih koek situinawk, kahoih koek misurtuinawk hoi cang to, nangcae han kang paek boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nihcae mah Angraeng khaeah sin o ih, lawk thungah kathai tangsuek hmuennawk boih loe, nangcae ih hmuen ah om tih; na imthung takoh ah kaom ciimcai kaminawk mah to hmuennawk to caa o tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel kaminawk mah angbawnhaih sak hanah Angraeng khaeah paek o ih hmuennawk boih loe nangcae ih hmuen ah om tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tapen tangsuek capa maw, to tih ai boeh loe kami maw, to tih ai boeh loe pacah ih moi maw, Angraeng khaeah paek ih hmuennawk boih loe nangcae taham ah om tih; toe na calu hoi ciimcai ai tapen tangsuek moinawk loe nangmacae mah akrang oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Akrang han koi caanawk loe khrah to akoep naah, akrang han atho khaeh ih baktih, hmuenciim ih shekel tahhaih baktih toengah, gerah pumphaeto hoi kangvan shekel pangato hoiah akrang oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toe tapen tangsuek maitaw tae maw, to tih ai boeh loe tapen tangsuek tuu tae maw, to tih ai boeh loe tapen tangsuek maeh tae loe na krang o mak ai; to moinawk loe ciim o pongah, nihcae ih athii to hmaicam ah haeh ah, athawknawk loe Angraeng khaeah hmuihoih ah paek hanah, hmai hoi angbawnhaih to sah oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angan, saoek hoi bantang bang ih palaeng loe nangcae taham ah om tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel kaminawk mah Angraeng khaeah paek ih kaciim hmuennawk boih loe, nangmah hoi na capanawk hoi na canunawk mah dungzan ah toep hanah, atawk baktiah kang paek boeh; hae loe nangmah hoi na caanawk han Angraeng hmaa ah paloi hoiah sak ih dungzan lokmaihaih ah om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Angraeng mah Aaron khaeah, Nang loe nihcae ih prae thungah, qawktoep han ih ahmuen, nihcae salakah na tawnh ih hmuen tidoeh om mak ai; kai loe Israel kaminawk salakah, nangcae taham ah ka oh moe, nangcae mah toep han koi qawk ah ka oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khenah, Levi kaminawk loe kaminawk amkhuenghaih kahni imthung ah toksak o pongah, nihcae mah qawktoep hanah Israel kaminawk ih hmuen hato thungah maeto ka paek boeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vaihi hoi kamtong Israel kaminawk loe amkhuenghaih kahni im taengah anghnai o mak ai boeh; anghnai o nahaeloe angmacae zaehaih atho to zok o ueloe, dueh o moeng tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Levi kaminawk khue mah ni amkhuenghaih kahni imthung ih tok to sah o tih, nihcae mah kamsoem ai hmuen to sah o nahaeloe, angmacae zaehaih atho to zok o tih; hae loe angzo han koi na caanawk khoek to dungzan ah pazui hanah paek ih daan lok ah oh; nihcae loe Israel kaminawk salakah toep han koi qawk tawn o mak ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe Israel kaminawk mah Angraeng khaeah paek o ih hato thungah maeto loe, Levinawk mah qawk ah toep o hanah ka paek boeh; to pongah ni nihcae khaeah, Israel kaminawk salakah qawktoep han tawn o mak ai, tiah ka thuih, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="26" style="v" />Levi kaminawk khaeah, Nangcae mah qawktoep han kang paek o ih Israel kaminawk khae ih hato thungah maeto na lak o naah, nangcae mah doeh hato thungah maeto Angraeng khaeah paek o patoeng hanah thui paeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangcae mah hae tiah na paek o ih hmuennawk loe, cang atithaih ahmuen hoiah paek ih cang, misurtui pasawhhaih ahmuen hoiah paek ih misurtui baktiah poek pae tih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangcae mah doeh Israel kaminawk khae hoi na hak o ih hato thungah maeto to, Angraeng khaeah paek o toeng ah; to tiah Angraeng khaeah paek ih hmuen to qaima Aaron hanah paek oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangcae khaeah paek ih hmuennawk boih thungah, kahoih koek hoi kaciim koek hmuen to Angraeng han paek oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />To pongah Levi kaminawk khaeah, Nangcae mah kahoih koek hmuen na paek o naah, na paek o ih hmuen to cang atithaih ahmuen, misurtui pasawhaih ahmuen hoi paek ih hmuen baktiah poek pae tih, tiah thui paeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kamtlai to loe nangmah hoi na imthung takoh boih mah kawbaktih ahmuen ah doeh na caak o thaih; to hmuen loe kaminawk amkhuenghaih kahni im ah toksakhaih atho ah paek ih tangqum ah om tih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kahoih koek hmuen na paek o pacoengah, kamtlai na caak o ih hmuen nuiah zaehaih om ai; Israel kaminawk mah paek ih kaciim hmuennawk to amhnong o sak hmah, to tih ai nahaeloe na dueh o moeng tih, tiah thui paeh, tiah a naa.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah thuih ih atawk lok loe, Coek koi kaom ai, rong angdaek ai, vaito doeh laikok atokhaih thing tahnong ah koeng vai ai, kathim maitaw tala to nang khaeah sin o hanah, Israel kaminawk khaeah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To maitaw tala to qaima Eleazar khaeah paek oh, anih mah ohhaih im tasa bangah hoi ueloe, kami maeto mah anih hmaa ah bop tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Qaima Eleazar mah maitaw tala athii to a banpazung tadong hoiah lak pacoengah, amkhuenghaih kahni im hmaa ah vai sarihto haeh tih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kami maeto mah anih hmaa ah maitaw tala to hmai hoiah qoeng tih; ahin, angan, athii hoi aeknawk to hmai hoiah qoeng boih tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Qaima mah sidar thing, hmuihoih husop kung tadok hoi thlangqui kathim to la ueloe, hmai hoi qoeng ih maitaw tala nuiah va tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pacoengah qaima mah a khukbuen to pasuk ueloe, tui doeh amhluh tih; to pacoengah ni a ohhaih im ah caeh vop tih; toe qaima loe duembang khoek to ciim mak ai vop.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmai qoeng kami doeh a khukbuen to pasuk pacoengah, tui amhluk han oh; anih doeh duembang khoek to ciim mak ai vop.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaciim kami mah hmai hoi thlaek ih maitaw tala apoep to phrom ueloe, atai o haih tasa bang ih hmuenciim maeto ah suem tih; to maiphu loe ciimcai ah amsaehhaih tui ah patoh han oh pongah, Israel acaengnawk mah pakuem o tih; to hmuen loe zae ciimhaih ah om tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Maitaw tala ih maiphu phrom kami loe a khukbuen to pasuk han oh, anih loe duembang khoek to ciim mak ai; hae loe Israel kaminawk hoi nihcae salakah kaom angvin hanah dungzan ah paek ih zaehhoihhaih daan lok ah om tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kadueh qok sui kami loe, ni sarihto thung ciim mak ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni thumto naah to ih maiphu hoiah a takpum to amsae tih, anih loe ni sarihto naah ni ciim vop tih; toe anih mah ni thumto naah a takpum to kaciim ah amsae ai nahaeloe, ni sarihto khoek to ciim mak ai boeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kadueh qok to sui to mah a takpum tui hoiah amsae ai kami loe, Angraeng ih kahni im to amhnongsak; to kami loe Israel kaminawk thung hoiah pahnawt han oh; kaciim ah amsaehhaih tui to a nuiah pathaek ai pongah, anih loe ciim ai; anih nuiah amhnonghaih to oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ohhaih im ah kami dueh nahaeloe, sakhaih daan loe hae tiah oh; to kami ohhaih im ah akun kaminawk hoi imthung ah kaom kaminawk boih loe, ni sarihto thung ciim mak ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kraeng ai ah kam-ong sut laom sabaenawk boih doeh ciim mak ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sumsen hoi hum ih kami qok maw, to tih ai boeh loe kadueh qok maw, to tih ai boeh loe kami huh maw, to tih ai boeh loe taprong maw sui kami loe, ni sarihto thung ciim mak ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaciim ai kami ciimsak hanah hmai hoi thlaek ih maitaw tala ih apoep maiphu to la ah loe, kalong tui to laom thungah lawn pacoengah,
  </para>
  <para style="p">
    <verse number="18" style="v" />kaciim kami mah hmuihoih husop kung tadok to tui thungah nup ueloe, a ohhaih im maw, laom sabaenawk maw, im ah kaom kaminawk nuiah maw, kami huh sui kami nuiah maw, to tih ai boeh loe hum ih kami maw, to tih ai boeh loe kadueh kami maw, to tih ai boeh loe taprong sui kami nuiah maw pathaek tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaciim kami mah kaciim ai kami to ni thumto hoi ni sarihto niah pathaek tih; ni sarihto naah a takpum to ciimsak ueloe, a khukbuen to pasuk pacoengah, tui amhlu tih; duembang ah loe anih to ciim tih boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe ciim ai kami mah a takpum to ciimsak ai nahaeloe, Angraeng ih hmuenciim to amhnongsak pongah, anih to amkhueng kaminawk salak hoi pahnawt han oh; kaciim ah pasaehhaih tui to anih nuiah pathaek ai pongah, anih loe ciim ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hae loe nihcae han dungzan ah paek ih zaehhoihhaih daan lok ah oh; kaciim tui pathaek kami doeh a khukbuen to pasuk han angaih; to tui sui kami doeh duembang khoek to ciim mak ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaciim ai kami mah sui ih hmuennawk boih loe, ciim mak ai; to hmuen sui kami doeh duembang khoek to ciim mak ai, tiah a naa.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel rangpuinawk Zin praezaek phakhaih khrah to naah, Kadesh ahmuen ah oh o; Miriam loe to ahmuen ah duek moe, aphum o.
  </para>
  <para style="p">
    <verse number="2" style="v" />To ahmuen ah kaminawk naek hanah tui om ai pongah, kaminawk mah Mosi hoi Aaron to zoeh hanah amkhueng o.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kam nawkamyanawk Angraeng hmaa ah duek o naah, kaicae doeh ka duek o nahaeloe hoih han tomah!
  </para>
  <para style="p">
    <verse number="4" style="v" />Tih hanah kaicae hoi ka pacah o ih moinawk dueksak hanah, Angraeng ih kaminawk hae praezaek ah na caeh hoi haih loe?
  </para>
  <para style="p">
    <verse number="5" style="v" />Tih hanah Izip prae thung hoiah nang tacawthaih moe, lawksak han kahoih ai, thaiduet thaih kaom ai, misurkung kaom ai, pomogranat thai doeh kaom ai, naek han tui doeh kaom ai, hae ahmuen kasae ah nang caeh haih loe? tiah kasae pakung o moe, a zoeh o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi hoi Aaron loe amkhueng kaminawk hmaa hoiah angthawk hoi moe, kahni im thok taengah a caeh hoi pacoengah, long ah akuep hoi; to ah Angraeng lensawkhaih to nihnik khaeah amtueng pae.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="8" style="v" />cunghet to la ah loe nam nawk Aaron hoi nawnto kaminawk to amkhuengsak ah; nihcae hmaa ah kaom lungsong khaeah lok to thui ah; lungsong thung hoiah tui to tacawt tih, lungsong thung hoi tacawt tui to kaminawk khaeah sin paeh loe, kaminawk hoi moinawk to naesak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraeng mah thuih ih lok baktih toengah, Mosi mah Angraeng hmaa ih cunghet to lak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosi hoi Aaron mah kaminawk to lungsong hmaa ah nawnto amkhuengsak; Mosi mah nihcae khaeah, Nangcae lok aek karah kaminawk, vaihi tahngai oh; hae lungsong thung hoiah nangcae han tui kang tacawt hoi sak han, tiah a naa.
  </para>
  <para style="p">
    <verse number="11" style="v" />To naah Mosi mah ban payangh moe, a cunghet hoiah lungsong to vai hnetto boh; to naah pop parai tui to tacawt, kaminawk hoi a tawnh o ih moinawk mah tui to naek o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe Angraeng mah Mosi hoi Aaron khaeah, Nanghnik loe, Israel kaminawk hmaa ah Ka ciimcaihaih amtuengsak hanah kai nang tang hoi ai pongah, nihcae khaeah ka paek ih prae thungah hae kaminawk hae na caeh hoi haih thai mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel kaminawk mah to ahmuen ah Angraeng ih lok aek o cadoeh, Angraeng mah nihcae khaeah a ciimcaihaih amtuengsak pongah, to ih tui to Meribah, tiah kawk o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mosi mah Kadesh ahmuen hoiah Edom siangpahrang khaeah laicaehnawk to patoeh moe, Nam nawk Israel mah, Kaicae nuiah angzo raihaihnawk to na panoek boih boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaicae ampanawk loe Izip prae ah caeh o tathuk moe, to ah saning sawk parai ah khosak o; Izip kaminawk mah kaicae hoi kaicae ampanawk to pacaekthlaek o;
  </para>
  <para style="p">
    <verse number="16" style="v" />Toe Angraeng khaeah ka qah o naah, anih mah kaicae qahhaih lok to tahngaih pae, angmah ih van kami to patoeh moe, Izip prae thung hoiah loisak; khenah, kaicae loe vaihi nangcae ramri taeng, Kadesh ahmuen ah ka oh o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaicae hae na prae thung hoiah na caehsak raeh; nangcae ih lawk ah maw, to tih ai boeh loe misur takha thungah maw ka caeh o mak ai; na tuipuek tui doeh ka nae o mak ai; Siangpahrang ih Manglaih Lampui hoiah ni ka caeh o han; na prae ka poeng o ai karoek to, banqoi bantang kam khraeng o mak ai, tiah a naa o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Edom mah anih khaeah, Hae ahmuen hoiah angzo o hmah; nang zoh o nahaeloe, sumsen hoiah kang takroek o han, tiah a naa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel kaminawk mah anih khaeah, Lampui hoiah ni ka caeh o han; kaicae mah maw, ka tawnh o ih moi mah maw, na tui to nae moeng nahaeloe, atho kang rong o han hmang; tidoeh ka sah o mak ai, khok hoi khue ni ka caeh o han, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toe nihcae mah, Hae ahmuen hoiah na caeh o mak ai, tiah a naa o let bae. Edom loe nihcae tuk hanah thacak pop parai kaminawk hoiah angzoh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Edom mah Israel caehhaih loklam to pahoe pae ai pongah, Isarael kaminawk loe amlaem o let.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israel kaminawk loe Kadesh ahmuen hoiah angqoi o boih moe, Hor mae ah caeh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Edom prae ramri, Hor mae ah Angraeng mah Mosi hoi Aaron khaeah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Aaron loe angmah ih kaminawk khaeah la tih boeh; Meribah ahmuen ih tui kawng pongah ka thuih ih lok to nang aek hoi pongah, Aaron loe Israel kaminawk khaeah ka paek ih prae thungah akun mak ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aaron hoi a capa Eleazar to kawk ah loe, Hor mae ah caeh haih ah;
  </para>
  <para style="p">
    <verse number="26" style="v" />Aaron ih khukbuennawk to khring paeh loe, a capa Eleazar to angkhuksak ah; Aaron loe angmah ih kaminawk khaeah la ueloe, to ah dueh tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />Angraeng mah thuih ih lok baktih toengah, Mosi mah sak; nihcae loe rangpui kaminawk mikhnuk ah Hor mae ah dawh o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosi mah Aaron ih khukbuennawk to khring pae moe, a capa Eleazar to angkhuksak; Aaron loe mae nuiah duek; to pacoengah Mosi hoi Eleazar loe mae nui hoiah anghum hoi tathuk.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aaron duek boeh, tito kaminawk mah panoek o naah, Israel imthung takoh boih mah Aaron hanah ni qui thumto thung palungset o haih.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Prae aloih bang kaom, Kanaan siangpahrang Arad mah, Israel kaminawk loe Atharim loklam bang hoiah angzo o tih, tiah a thaih naah, Israel kaminawk to a tuk moe, thoemto Israel kaminawk to a naeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah Israel mah Angraeng khaeah, Hae kaminawk hae ka ban ah nang paek nahaeloe, nihcae ih vangpuinawk to ka phraek pae boih han, tiah lokkamhaih sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />To naah Israel lawkthuihaih to Angraeng mah tahngaih pae moe, Kanaan kaminawk to nihcae ban ah a paek; nihcae hoi nihcae ih vangpuinawk to Israel kaminawk mah phraek pae o boih; to pongah to ahmuen to Hormah, tiah kawk o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hor mae hoi tacawt o moe, tuipui kathim bangah caehhaih loklam hoiah, Edom prae takui hanah a caeh o naah, loklam to set pongah kaminawk palungboeng o.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah kaminawk mah Sithaw hoi Mosi khaeah, Tipongah kaicae praezaek ah dueksak hanah Izip prae hoiah nang tacawt haih loe? Caak han takaw doeh om ai, tui doeh om ai; kakhraem ai hae takaw doeh ka panuet o boeh, tiah laisaep o thuih.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Angraeng mah kasoetui thacak pahuinawk to kaminawk khaeah patoeh, pahui mah kaminawk to patuk pongah, Israel kaminawk loe paroeai duek o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah kaminawk loe Mosi khaeah angzoh o moe, Angraeng hoi nang kang laisaep o thuih pongah ka zae o boeh; Angraeng mah pahuinawk hae kaicae khae hoiah lak let hanah, lawk na thui paeh, tiah a naa o. To pongah Mosi mah kaminawk hanah lawkthuih pae.
  </para>
  <para style="p">
    <verse number="8" style="v" />Angraeng mah Mosi khaeah, Kasoetui thacak pahui maeto sah ah loe, cungkui tadong ah bang ah; pahui mah patuk ih kami boih mah, pahui to khet naah, hing o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pongah Mosi mah sum kamling hoiah pahui to sak moe, cungkui pongah a bangh; pahui mah patuk ih kami mah, sum kamling hoiah sak ih pahui to khet naah a hing.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel kaminawk loe hmabang caeh o poe moe, Oboth ah anghak o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Oboth hoi amsak o let moe, ni angyae bang ih Moab pha ai naah kaom, Iye-Abarim ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="12" style="v" />To ahmuen hoiah amsak o let bae moe, Zered azawn ah anghak o.
  </para>
  <para style="p">
    <verse number="13" style="v" />To ahmuen hoiah amsak o moe, Amor kaminawk ohhaih prae taeng ih praezaek ah kaom, Arnon vapui taeng ih ahmuen maeto bangah anghak o; Arnon vapui loe Moab hoi Amor prae salakah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah, Tuipui kathim hoi Arnon vacongnawk ah a sak ih hmuen kawng loe Angraeng ih misatukhaih cabu thungah oh,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ar prae ah longh tathuk moe, Moab prae ramri taengah kaom vacong tui ah oh, tiah thuih ih lok to oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Arnon vapui hoi Beer tuipuek ah caeh o moe, to ih tuipuek ahmuen ah Angraeng mah Mosi khaeah, Kaminawk to nawnto amkhuengsak ah, nihcae to tui ka paek han, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />To naah Israel kaminawk mah hae laa hae sak o; Aw tuipuek nang, tacawt tahang ah; tacawt tahang hanah laa to sah o boih ah;
  </para>
  <para style="p">
    <verse number="18" style="v" />ukhaih kaalok sahkung mah thuih ih lok baktih toengah, Angraeng ih caanawk mah tuipuek to takaeh o moe, kami zaehoikungnawk mah doeh angmacae ih cunghet hoiah tuipuek to takaeh o boeh, tiah laa to sak o. To praezaek ahmuen hoiah Mattanah ah a caeh o;
  </para>
  <para style="p">
    <verse number="19" style="v" />Mattanah ahmuen hoiah Nahaliel ah, Nahaliel hoiah Bamoth ah,
  </para>
  <para style="p">
    <verse number="20" style="v" />Bamoth hoiah Moab prae thung ih azawn ah caeh o moe, Jeshimon vangpui danhaih Pisgah maesom nuiah a caeh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel kaminawk mah Amor siangpahrang Sihon khaeah laicaehnawk to patoeh moe,
  </para>
  <para style="p">
    <verse number="22" style="v" />na prae thung hoiah na caehsak raeh; na lawk thungah maw, to tih ai boeh loe na misur takha thungah maw, ka caeh o mak ai; na tuipuek thung ih tui doeh ka nae o mak ai; na prae ka poeng o ai karoek to, Siangpahrang ih Manglaih Lampui hoiah ni ka caeh o han, tiah thuih pae o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe Sihon mah Israel kaminawk to a prae thung hoiah caehsak ai; anih mah angmah ih misatuh kaminawk to kok boih moe, Israel kaminawk tuk hanah praezaek ah a caeh; Jahaz ahmuen ah caeh moe, Israel kaminawk to a tuk.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toe Israel kaminawk mah anih to sumsen hoiah takroek o moe, anih ih prae to Arnon hoi Jabbok karoek to, Ammon kaminawk ohhaih ahmuen karoek to lak pae o; Ammon kaminawk ih ramri loe kacak ah pakaa o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel kaminawk mah Amor kaminawk ih vangpuinawk to lak o boih moe, Heshbon hoi a taengah kaom avangnawk doeh a lak pae o boih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Heshbon loe Armor kaminawk ih siangpahrang, Sihon ohhaih vangpui ah oh; anih mah hmaloe ah kaom Moab siangpahrang to tuk moe, anih khae hoiah a prae to Arnon vapui khoek to a lak pae.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pongah palungha lokthui kaminawk mah, Heshbon vangpui ah angzo oh, Sihon ih vangpui hae sah o si;
  </para>
  <para style="p">
    <verse number="28" style="v" />Sihon siangpahrang ohhaih, Heshbon hoiah hmai to tacawt moe, Moab prae thungah kaom Ar vangpui hoi Arnon vapui taengah kaom, maesang ukkung siangpahrangnawk to kangh boih boeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aw Moab prae, khosak na bingh! Aw Khemosh kaminawk, nam ro o boih boeh! Kacawn a capa to misa mah naeh boeh moe, a canunawk to Amor kaminawk ih siangpahrang Sihon khaeah misong ah caehsak boeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kaicae mah Amor kaminawk to ka tuk o pongah, Heshbon prae loe Dibon vangpui khoek to amro boih boeh; Medeba taengah kaom, Nophah vangpui khoek to nihcae to kam ro o sak boih boeh, tiah a thuih o.
  </para>
  <para style="p">
    <verse number="31" style="v" />To pongah Israel kaminawk loe Amor kaminawk ih prae thungah khosak o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mosi mah Jaazer vangpui to khet hanah kaminawk to patoeh moe, a taengah kaom vangtanawk to a lak o, to ah kaom Amor kaminawk doeh a haek o.
  </para>
  <para style="p">
    <verse number="33" style="v" />To pacoengah nihcae loe amlaem o moe, Bashan bang caehhaih loklam bangah caeh o tahang; to naah Bashan siangpahrang Og mah, angmah ih misatuh kaminawk boih hoiah Edrei ahmuen ah nihcae to tuk hanah a caeh o.
  </para>
  <para style="p">
    <verse number="34" style="v" />To naah Angraeng mah Mosi khaeah, Anih to zii hmah; anih doeh, anih ih misatuh kaminawk boih hoi anih ih prae doeh, na ban ah kang paek boeh; to pongah Heshbon ah kaom, Amor kaminawk ih siangpahrang Sihon nuiah na sak ih hmuen baktih toengah, anih nuiah doeh sah ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />To pongah anih to, a capanawk hoi a misatuh kaminawk boih hoiah nawnto, maeto doeh kahing ah loisak ai ah a hum bit; to pacoengah anih ih prae to lak pae o.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pacoengah Israel kaminawk loe Moab azawn ah caeh o moe, Moab prae azawn, Jordan vapui taeng, Jeriko vangpui maeto bangah atai o.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk mah Amor kami nuiah sak o ih hmuen to, Zippor capa Balak mah hnuk boih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel kaminawk loe pop o parai pongah, Moab kaminawk mah nihcae to paroeai zit o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moab kaminawk mah Midian kacoehtanawk khaeah, Maitaw tae mah palai hoiah taw ih qam takoih boih baktih toengah, haeah amkhueng kaminawk mah aicae taengah kaom hmuennawk to caa o boih tih boeh, tiah a naa o. To nathuem ah Zippor capa Balak to Moab siangpahrang ah oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ammon prae thungah kalong vapui taengah kaom, Pethor vangpui ih kami, Beor capa Baalam to kawk hanah laicaehnawk to patoeh. Balak mah, Izip prae hoi angzo acaeng maeto loe, prae koimongah ka taengah atai o boeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah vaihi angzo ah, hae kaminawk loe kai pongah thacak o, to pongah kai hanah nihcae to tangoeng paeh; to tiah na sak nahaeloe nihcae ka tuk naah, prae thung hoiah ka haek thai khoe doeh om tih; nang mah tahamhoihaih na paek ih kaminawk loe tahamhoihaih a hnuk o moe, na tangoeng ih kaminawk loe tangoeng ah oh o, tiah ka panoek, tiah a naa.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moab hoi Midian kacoehtanawk loe tahmaa mah thuih ih lok to atho paek hanah, tangqum to sin o moe, a caeh o; Balaam khaeah a phak o naah, Balak mah thuih ih lok to anih khaeah thuih pae o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Balaam mah nihcae khaeah, Vaiduem loe haeah cam o raeh; Angraeng mah paek ih lok to kang thuih o han hmang, tiah a naa. To pongah Moab ukkung angraengnawk loe to ah Balaam hoi nawnto oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Balaam khaeah Sithaw angzoh moe, Nang khaeah kaom kaminawk loe kawbaktih kaminawk maw? tiah a dueng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balaam mah Sithaw khaeah, Zippor capa, Moab siangpahrang Balak mah hae kaminawk hae kai khaeah ang patoeh,
  </para>
  <para style="p">
    <verse number="11" style="v" />khenah, Izip prae hoi angzo kaminawk loe, prae koimongah oh o boeh; to pongah vaihi angzo ah loe, hae kaminawk hae kai hanah tangoeng pae ah; to tih nahaeloe hae kaminawk hae ka tuh pazawk ueloe, ka haek thai khoe doeh om tih, tiah ang thuih o, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe Sithaw mah Balaam khaeah, Nihcae hnukah caeh hmah; to kaminawk loe tahamhoih kami ah oh o pongah, tangoeng hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Balaam loe khawnbang khawnthaw ah angthawk moe, Balak ih toksah angraengnawk khaeah, Nangmacae prae ah amlaem o lai ah, Angraeng mah nangcae hnukah na bangsak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Moab ukkung angraengnawk loe Balak khaeah amlaem o let moe, anih khaeah, Balaam loe kaicae hnukah bang hanah angmak khruek, tiah a naa o.
  </para>
  <para style="p">
    <verse number="15" style="v" />To naah Balak mah hmaloe ah patoeh ih ukkungnawk pongah kapop, ahmin kamthang kue kalah ukkung angraengnawk to laicaeh ah patoeh let.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nihcae Balaam khaeah angzoh o moe, anih khaeah, Zippor capa Balak mah, Kai khae angzoh han ai ah, tih mah doeh pakaa hmah nasoe;
  </para>
  <para style="p">
    <verse number="17" style="v" />nang to kasang ah kang pakoeh moe, na thuih ih hmuen to kang sak pae boih han; to pongah angzo ah loe, hae kaminawk hae kai hanah na tangoeng paeh, tiah a thuih, tiah a naa o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe Balaam mah, Balak ih tamnanawk khaeah, Balak mah sui, sum kanglung hoi koimongah kaom angmah ih siangpahrang im to na paek langlacadoeh, zetta ah maw, to tih ai boeh loe pop parai ah maw, ka Angraeng mah paek ih lok pong kamtlai ah tidoeh ka sah mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pongah nangcae doeh, Vaiduem loe haeah cam o raeh; Angraeng mah timaw na thui vop tih, tito tahngai rae si, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />To naduem ah Sithaw Balaam khaeah caeh moe, anih khaeah, Kai nang kawk hanah kaminawk angzo o nahaeloe, angthawk ah loe, nihcae hoi nawnto caeh ah; toe kang thuih ih lok khue ni na sak han oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Balaam loe khawnbang khawnthaw ah angthawk, laa hrang nuiah anghnut moe, Moab ukkung angraengnawk hoi nawnto a caeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nihcae hoi nawnto a caeh pongah, Sithaw palungphui; nihcae to pakaa hanah Angraeng ih van kami to loklam ah angdoet khoep. Balaam loe angmah ih laa hrang nuiah angthueng moe, a tamna hnetto hoi nawnto a caeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng ih van kami loe a ban ah sumsen to sin moe, loklam ah angdoet khoep, tiah laa hrang mah hnuk naah, hrang loe loklam amkhraeng moe, lawk bangah caeh ving; to loklam ah a caeh let thai hanah, Balaam mah laa hrang to boh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Misur takha salak ih loklam ah a caeh naah, Angraeng ih van kami to angdoet moe, hae bangah doeh ho bangah doeh sipae thungh pae khoep.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laa hrang mah Angraeng ih van kami to hnuk let naah, sipae to a daeng hmop moe, Balaam ih khok daeng pae ngawng; to naah Balaam mah hrang to boh let bae.
  </para>
  <para style="p">
    <verse number="26" style="v" />To pacoengah Angraeng ih van kami loe hmabang ah caeh moe, banqoi bantang angqoi han kaom ai tamcaek loklam ah angdoet pae khoep.
  </para>
  <para style="p">
    <verse number="27" style="v" />Laa hrang mah Angraeng ih van kami to hnuk let naah, Balaam tlim ah tabok pae; to naah Balaam palungphui moe, cunghet hoiah laa hrang to boh let.
  </para>
  <para style="p">
    <verse number="28" style="v" />To naah Angraeng mah laa hrang ih pakha to paongh pae, hrang mah Balaam khaeah, Kawbang maw kang naa moe, kai vai thumto nang boh? tiah a naa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balaam mah laa hrang khaeah, Kai hae tiah doeh nang sah ai; ka ban ah sumsen om nahaeloe, vaihi roe kang hum han boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />To naah laa hrang mah Balaam khaeah, Kai loe nang mah vaihni ni khoek to nang thueng ih, nangmah ih laa hrang ah na ai maw ka oh? Nang khaeah hae tiah ka oh vai maw? tiah Balaam hanah a naa. To naah anih mah, Hae tiah na om vai ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Angraeng mah Balaam ih mik to amtuengsak naah, a ban ah sumsen kasin, loklam tamcaek ah kangdoe khoep, Angraeng ih van kami to anih mah hnuk; to pongah anih loe akuep tathuk moe, long ah tabok.
  </para>
  <para style="p">
    <verse number="32" style="v" />Angraeng ih van kami mah, Tipongah nangmah ih laa hrang to vai thumto na boh loe? Khenah, na caehhaih loklam loe kai hoi buenglueng tamlet ah oh, to pongah nangpakaa hanah kang zoh;
  </para>
  <para style="p">
    <verse number="33" style="v" />laa hrang mah kai ang hnuk pongah, kai khae hoi loklam vai thumto amkhraeng ving; kai khae hoi amkhraeng ai nahaeloe, vaihi roe nang to kang hum moe, nang ih laa hrang to ka hingsak lat han, tiah a naa.
  </para>
  <para style="p">
    <verse number="34" style="v" />Balaam mah Angraeng ih van kami khaeah, Ka zae moeng boeh; kai pakaa hanah loklam ah nang doet, tito ka panoek ai; to pongah vaihi na koeh ai nahaeloe, kam laem let han, tiah a naa.
  </para>
  <para style="p">
    <verse number="35" style="v" />Angraeng ih van kami mah Balaam khaeah, Kaminawk hoi nawnto caeh ah, toe kang thuih ih lok khue to ni na thuih han, tiah a naa. To pongah Balaam loe Balak ih toksah angraengnawk hoi nawnto caeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Balaam angzoh boeh, tiah Balak mah thaih naah, anih dawt hanah, Moab prae ramri Arnon vapui taengah kaom vangpui maeto ah a caeh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Balak mah Balaam khaeah, Nang kawk hanah vaihi hoi vaihi kami kang patoeh na ai maw, tikhoe hae tih khoek to na kra loe? Nang hae kasang ah kang paloep mak ai, tiah na poek maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="38" style="v" />Balaam mah Balak khaeah, Khenah, vaihi nang khaeah kang zoh boeh, lok ka thui thai tih maw? Sithaw mah ka pakha thungah suek ih lok khue ni ka thuih han, tiah a naa.
  </para>
  <para style="p">
    <verse number="39" style="v" />To pacoengah Balaam loe Balak hoi nawnto Kirjath-Huzoth ah caeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Balak mah maitaw hoi tuunawk hoiah angbawnhaih to sak, to pacoengah Balaam hoi anih khaeah kaom ukkung angraengnawk hanah doeh a pat pae thoem.
  </para>
  <para style="p">
    <verse number="41" style="v" />Khawnbang ah loe Balak mah Balaam to kawk moe, Israel kaminawk patuek hanah, Baal sithaw ohhaih hmuensang ah a caeh haih.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Balaam mah Balak khaeah, Kai han haeah hmaicam sarihto sah ah loe, maitaw tae sarihto hoi tuu tae sarihto suem ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balaam mah thuih ih lok baktih toengah Balak mah sak pae; Balak hoi Balaam mah hmaicam maeto nuiah, maitaw tae maeto, tuu tae maeto hoiah angbawnhaih a sak hoi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Balaam mah, Balak khaeah, Na sak ih hmai angbawnhaih taengah om ah; kai loe ahmuen maeto ah ka caeh han; to ah kai tongh hanah Angraeng angzo khoe doeh om tih; anih mah ang hnuksak ih hmuen to kang thuih boih han hmang, tiah a naa. To pacoengah anih loe hmuensang ah caeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sithaw mah Balaam to tongh, Balaam mah anih khaeah, Hmaicam sarihto ka sak moe, hmaicam maeto boih nuiah maitaw tae maeto hoi tuu tae maeto ka tathlang boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng mah Balaam ih pakha thungah lok to suek pae, Balak khaeah amlaem let ah loe, hae lok hae anih khaeah thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />To pongah anih Balak khaeah amlaem tathuk naah, khenah, Balak loe Moab ukkung angraengnawk boih hoi nawnto sak ih hmai angbawnhaih taengah angdoet.
  </para>
  <para style="p">
    <verse number="7" style="v" />To naah Balaam mah patahhaih lok to thuih pae; Moab siangpahrang Balak mah, angzo ah loe, kai hanah Jakob acaengnawk hae tangoeng pae ah; angzo ah loe, Israel kaminawk hae amrosak ah, tiah Aram prae ni angyae bangah kaom maesang hoiah kai hae ang caeh haih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sithaw mah tangoeng ai ih kami to kawbang maw ka tangoeng thaih ueloe, Angraeng mah amrosak ai ih kami to kawbang maw kam rosak thai tih?
  </para>
  <para style="p">
    <verse number="9" style="v" />Lungsong nui hoiah anih to ka hnuk moe, maesang hoiah anih to ka dan; khenah, to kaminawk loe angmacae khue om o tih, kalah kaminawk hoi angbaeh o mak ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob acaeng ih maiphu loe mi mah maw kroek thai tih, Israel acaeng palito thung ih maeto mataeng doeh mi mah maw kroek thai tih? Kai loe katoeng kami baktiah dueh nasoe, ka boenghaih doeh nihcae boenghaih baktiah om nasoe, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="11" style="v" />Balak mah Balaam khaeah, Kai khaeah timaw na sak? Ka misanawk tangoeng thuih han ih na ai maw kang kawk, khenah, tipongah nihcae to tahamhoihaih na paek lat loe? tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih mah, Angraeng mah ka pakha thungah suek ih lok to acoehaih hoiah ka thui mak ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Balak mah anih khaeah, Angzo ah, nihcae khet naah, nihcae boih kamtueng ai ahmuen, nihcae ahap khue amtuenghaih ahmuen kalah bangah caeh si; to ahmuen hoiah nihcae to kai han na tangoeng pae let ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah Zophim azawn hoiah Pisgah mae nuiah anih to caeh haih moe, to ah hmaicam sarihto sak pacoengah, hmaicam maeto nuiah maitaw tae maeto hoi tuu tae maeto angbawnhaih ah a paek.
  </para>
  <para style="p">
    <verse number="15" style="v" />Balaam mah Balak khaeah, Angraeng tongh hanah ahmuen kalah ah ka caeh nathung, nang loe na sak ih angbawnhaih ahmuen taengah om ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah Balaam to tongh, anih ih pakha ah lok to a suek pae moe, Balak khaeah amlaem let ah loe, hae lok hae thui paeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Balaam amlaem let naah loe, khenah, Moab ukkung angraengnawk hoi nawnto sak ih hmai angbawnhaih taengah angdoe Balak to a hnuk. To naah Balak mah, Angraeng mah timaw ang thuih? tiah a dueng.
  </para>
  <para style="p">
    <verse number="18" style="v" />To naah anih mah patahhaih lok to hae tiah a thuih pae; Balak, angthawk ah loe, tahngai ah; Zippor capa, ka lok hae tahngai ah;
  </para>
  <para style="p">
    <verse number="19" style="v" />Sithaw loe amsawnlok thui kami na ai ni; dawnpakhuemhaih tawn kami ih capa doeh na ai ni; anih loe a thuih ih lok baktiah sah ai ah oh vai maw? A lokkam ih baktiah koepsak ai ah oh vai maw?
  </para>
  <para style="p">
    <verse number="20" style="v" />Khenah, Tahamhoihaih paek hanah ang thuih ih lok to ka hnuk boeh; tahamhoihaih ang paek boeh pongah, ka pakhrai thai mak ai boeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih mah Jakob zaehaih to hnu ai, Israel acaeng nuiah doeh kahoih ai loklam amkhraenghaih to hnu ai; anih ih Angraeng Sithaw loe anih hoi nawnto oh moe, nihcae salakah Siangpahrang hanghaih lok to oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sithaw mah nihcae to Izip prae thung hoiah tacawtsak boeh; Israel kaminawk loe kokno thacakhaih to tawnh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jakob tuk hanah lungh aahhaih om ai, Israel tuk hanah tahmaa baktiah thuih coek ih lok doeh om ai. Jakob hoi Israel kawng pongah, Vaihi Sithaw mah timaw sak, tito khen oh, tiah thui o tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khenah, kaminawk loe kaipui baktiah angthawk o tih; saning kanawk kaipui baktiah tacawt o tih; a naeh ih moi to caa ai moe, a kaek ih moi thii to nae ai karoek to, omduem ai kaipui baktiah oh o, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />To naah Balak mah Balaam khaeah, Nihcae to tangoeng thuih hmah loe, tahamhoihaih doeh paek hmah, tiah a naa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe Balaam mah, Balak khaeah, Angraeng mah thuih ih lok khue ni kang thuih han, tiah kang thuih boeh na ai maw? tiah a naa.
  </para>
  <para style="p">
    <verse number="27" style="v" />To pacoengah Balak mah Balaam khaeah, Angzo ah; kalah ahmuen bangah kang caeh haih han; to ahmuen hoiah nihcae nang tangoeng pae hanah, Angraeng ih palung tongh khoe doeh om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Balak mah Balaam to kawk moe, Jeshimon vangpui bangah angqoi Peor mae nuiah a caeh haih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balaam mah, Balak khaeah, Hae ahmuen ah kai han hmaicam sarihto sah ah loe, maitaw tae sarihto hoi tuu tae sarihto angbawnhaih ah paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Balaam mah thuih ih lok baktih toengah Balak mah sak moe, hmaicam maeto boih nuiah maitaw tae maeto hoi tuu tae maeto a tathlang.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Israel kaminawk tahamhoihaih paek han koeh, tito Balaam mah panoek naah, hmacawnhaih hnuk hanah, canghniah caeh ih baktih toengah caeh ai ah, a mikhmai to praezaek bangah paqoi ving.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balaam mah khet naah, angmacae acaeng maeto pacoeng maeto nawnto amkhueng Israel kaminawk to a hnuk; to naah Sithaw ih Muithla a nuiah phak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anih mah taphong han ih patahhaih lok to lak moe, mik amtueng, Beor capa Balaam ih lok;
  </para>
  <para style="p">
    <verse number="4" style="v" />long ah amtimh pacoengah, mik kamtueng, thacak Angraeng hnuksakhaih hnukung, Sithaw mah thuih ih lok thaih kami mah thuih ih lok loe,
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Jakob, na ohhaih imnawk loe kawkruk maw hoih, Aw Israel, na kahni im loe kawkruk maw hoih!
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang loe kawk parai azawnnawk, tuipui taengah kaom takhanawk, Angraeng mah thling ih thingnawk hoi tui taengah amprawk sidar thingnawk baktiah na oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih loe a tui tabu thung hoiah tui to krai ueloe, anih ih aanmunawk loe kapop tui ahmuen ah krah o tih; anih ih siangpahrang loe Agag pongah len kue ueloe, a ukhaih prae doeh kasang ah pakoehhaih om tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sithaw mah anih to Izip prae thung hoiah zaeh, anih loe kokno baktiah thacak; anih mah a misa ah kaom prae kaminawk to paaeh ueloe, nihcae ih ahuhnawk to khaek pae tih; angmah ih kalii hoiah nihcae to kat tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anih loe kaipui baktiah caeh moe, kalen kaipui baktiah tabok; anih to mi mah maw pathawk thai tih? Nang tahamhoihaih paek kami loe, tahamhoihaih tongh ueloe, nang tangoeng kami loe tangoeng ah om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balak mah Balaam to palungphui thuih, a ban tabaeng phang pacoengah, Balak mah Balaam khaeah, Ka misanawk tangoeng hanah kang kawk, toe khenah, nihcae to vai thumto tahamhoihaih na paek lat.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah vaihi na ohhaih ahmuen ah cawn lai ah; nang hae kasang ah kang suek han, tiah poekhaih ka tawnh; toe khenah, to tiah oh han ai ah Angraeng mah pakaa ving boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Balaam mah Balak khaeah, Nang patoeh ih laicaehnawk khaeah,
  </para>
  <para style="p">
    <verse number="13" style="v" />Balak mah sui hoi sum kanglung koimongah suek ih angmah ih siangpahrang im to na paek langlacadoeh, Angraeng mah paek ih lok pong kamtlai ah, kasae hmuen ah maw, to tih ai boeh loe kahoih hmuen ah maw, ka poekhaih to ka thui cop mak ai; Angraeng mah thuih ih lok khue ni ka thuih han, tiah ka thuih boeh na ai maw?
  </para>
  <para style="p">
    <verse number="14" style="v" />Khenah, vaihi loe kaimah ih kaminawk khaeah ka caeh han boeh; to pongah angzo ah; hae kaminawk mah hmabang ah nang ih kaminawk nuiah timaw sah o tih, tito kang thuih han, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih mah taphong han ih patahhaih lok to lak moe, mik kamtueng, Beor capa Balaam mah thuih ih lok;
  </para>
  <para style="p">
    <verse number="16" style="v" />long ah amtimh pacoengah, mik kamtueng, thacak Angraeng hnuksakhaih hnukung, Kasang koek Sithaw palunghahaih panoekkung mah thuih ih lok loe,
  </para>
  <para style="p">
    <verse number="17" style="v" />anih to ka hnu tih, toe vaihi ka hnu mak ai vop; anih to ka khet han, toe atue loe anghnai ai vop; Jakob acaeng thung hoiah cakaeh maeto tacawt ueloe, Israel thung hoiah angraeng cunghet maeto angthawk tahang tih; anih mah Moab prae taki taket khoek to tuh ueloe, Sheth capanawk to amrosak boih tih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Edom prae to la ueloe, Seir mae doeh anih ih misanawk mah la o tih; toe Israel loe misahoihaih hoiah thacak aep aep tih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob thung hoiah ukkung maeto tacawt ueloe, vangpui thungah anghmat kaminawk to hum tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="20" style="v" />Balaam mah Amalek to khet moe, patahhaih lok to a thuih; acaeng kaminawk boih thungah Amalek loe hmaloe koek ah oh; toe anih loe hnukkhuem koek ah amro tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah Ken kaminawk to a khet moe, patahhaih lok to a thuih; na ohhaih ahmuen loe caak moe, tabu doeh lungsong nuiah na boh,
  </para>
  <para style="p">
    <verse number="22" style="v" />toe Ken kaminawk loe, Ashur ukkung mah tamna ah naeh ueloe, anghma angtaa o tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pacoengah taphong han ih patahhaih lok to lak moe, Ala, Sithaw mah hae hmuen sak naah mi maw hing thai tih?
  </para>
  <para style="p">
    <verse number="24" style="v" />Kittim tui taeng hoiah palongpuinawk angzo o ueloe, nihcae mah Asshur hoi Eber to pazawk tih; toe angmacae doeh amro tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Balaam loe angthawk tahang moe, angmah im ah amlaem, to pacoengah Balak doeh angmah ih loklam ah caeh toeng.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel kaminawk Shittim ah oh o naah, Moab canunawk hoiah nongpa nongpata zaehaih sak amtong o.
  </para>
  <para style="p">
    <verse number="2" style="v" />To nongpatanawk mah angmacae sithaw angbawnhaih ahmuen ah Israel kaminawk angzoh thai hanah pacae o; to kaminawk loe angbawnhaih buh aan to caak o moe, to ih sithawnawk hma ah akuep o.
  </para>
  <para style="p">
    <verse number="3" style="v" />To tiah Israel kaminawk mah Peor ahmuen ah Baal to bok o pongah, Angraeng palungphuihaih Israel kaminawk nuiah phak.
  </para>
  <para style="p">
    <verse number="4" style="v" />To naah Angraeng mah Mosi khaeah, Hae kami zaehoikungnawk to kawk boih ah loe, zit kathok Angraeng palungphuihaih Israel khae hoi dip thai hanah, nihcae to khodai ah Angraeng hmaa ah qui hoiah bang ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah Mosi mah Israel lokcaekkungnawk khaeah, Baal-Peor bokhaih ahmuen ah caeh kaminawk boih to hum oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khenah, Israel kami maeto mah, Mosi hoi amkhuenghaih kahni im thok taengah kaqah, kamkhueng angmah ih nawkamya Israel kaminawk boih hma ah, Midian nongpata maeto angzoh haih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Qaima Aaron capa Eleazar, Eleazar capa Phinehas mah anih to hnuk naah, anih mah tayae to ban ah sin, kamkhueng kaminawk salak hoiah angthawk moe,
  </para>
  <para style="p">
    <verse number="8" style="v" />to tiah zaehaih sah Israel kami ohhaih kahni im khoek to a pangh pacoengah, Israel kami hoi to nongpata to tayae hoiah zok ah takhawh hmaek. To naah Israel salak ih nathaih kasae to dip.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toe to ih kasae nathaih pongah kami sing hnet, sang palito duek o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Qaima Aaron capa Eleazar, Eleazar capa Phinehas loe, kai pakoehhaih bangah palungthin thacak kami ah oh pongah, Israel kaminawk ka hum han ai ah, Israel nuiah palung ka phuihaih to anih mah dipsak boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />To pongah, Khenah, anih khaeah angdaeh lokmaihaih to ka paek boeh;
  </para>
  <para style="p">
    <verse number="13" style="v" />anih loe Sithaw bokhaih bangah palungthin thacak moe, Israel kaminawk zae loih thai hanah, angbawnhaih a sak pongah, angmah hoi a caanawk khoek to dungzan ah qaima toksak hanah lokmaihaih to hnu tih, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="14" style="v" />Midian nongpata hoi nawnto hum ih Israel kami ahmin loe, Simeon acaeng zaehoikung ah kaom, Salu ih capa Zimri.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hum ih Midian nongpata ahmin loe, Midian imthung takoh lu koek ah kaom, Zur canu Gozbi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Midian kaminawk to na misa baktiah poek ah loe hum ah;
  </para>
  <para style="p">
    <verse number="18" style="v" />Peor sithaw to bok pongah, nathaih kasae phakhaih niah hum ih, Midian kaminawk zaehoikung ih canu, nihcae ih tanu ah kaom, Gozbi hoi Peor kawng pongah, nangcae to ang ling o boeh, tiah a naa.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kasae nathaih phak pacoengah, Angraeng mah Mosi hoi qaima Aaron capa Eleazar khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />saning pumphaeto pacoeng ranuih bang kaom, misa tuh thaih Israel acaeng thung ih kaminawk boih to ahmin la ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah Mosi hoi qaima Eleazar mah, Moab azawn, Jordan vapui taeng, Jeriko vangpui ahmuen maeto bang ih kaminawk khaeah,
  </para>
  <para style="p">
    <verse number="4" style="v" />Angraeng mah Mosi khaeah paek ih lok baktih toengah, saning pumphaeto ranuih bang kami boih ahmin lak han oh, tiah a thuih pae hoi. Izip prae hoi angzo Israel kaminawk loe,
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel ih calu, Reuben ih caanawk; Hanok ih acaeng loe, Hanok hoi tacawt kami ah oh; Pallu ih acaeng loe, Pallu hoi tacawt kami ah oh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezron ih acaeng loe, Hezron hoi tacawt kami ah oh; Karmi ih acaeng loe, Karmi hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="7" style="v" />To kaminawk loe Reuben ih acaeng ah oh o moe, ahmin lak naah sangqum boih ah sing pali, sang thum, cumvai sarih, qui thumto oh o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pallu capa loe Eliab;
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliab capanawk loe Nemuel, Dathan hoi Abiram; to ih Dathan hoi Abiram loe rangpui kaminawk salakah ahmin amthang hoi moe, Aaron hoi Mosi ih lok aek kami, Angraeng ih lok aek kami ah oh hoi pacoengah, Korah hnukbang kaminawk hoi amyok kami ah oh hoi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nihnik loe long mah pakha aangh moe, Korah hoi nawnto paaeh ving boeh, anih hnukbang kami cumvai hnet, qui pangato doeh hmai mah kangh moe duek o; nihcae loe acoehaih paekkung ah oh o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toe Korah ih caanawk loe dueh o ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Simeon imthung takoh hoi tacawt caanawk loe, Nemuel ih acaeng loe, Nemuel hoi tacawt kami ah oh o; Jamim hoi tacawt kami loe, Jamim ih acaeng ah oh o; Jachin ih acaeng loe, Jachin hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerah ih acaeng loe, Zerah hoi tacawt kami ah oh o; Shaul ih acaeng loe, Shaul hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Simeon ih acaengnawk loe, kami sang pumphae hnet, cumvai hnetto oh o.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad imthung takoh hoi tacawt caanawk; Zephon ih acaeng loe, Zephon hoi tacawt kami ah oh o; Haggi ih acaeng loe, Haggi hoi tacawt kami ah oh o; Shuni ih acaeng loe, Shuni hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ozni acaeng loe, Ozni hoi tacawt kami ah oh o; Eri ih acaeng loe, Eri hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="17" style="v" />Arodi ih acaeng loe, Arod hoi tacawt kami ah oh o; Areli acaeng loe, Areli hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gad acaengnawk loe, kami sang qui pali, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Er hoi Onan loe, Judah ih capa ah oh hoi moe, Kanaan prae ah duek hoi ving boeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judah imthung takoh hoi tacawt caanawk; Shelah ih acaeng loe, Shelah hoi tacawt kami ah oh; Pharez ih acaeng loe, Pharez hoi tacawt kami ah oh o; Zerah ih acaeng loe, Zerah hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pharez ih caanawk; Hezron ih acaeng loe, Hezron hoi tacawt kami ah oh; Hamul ih acaeng loe, Hamul hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Judah ih acaengnawk loe kami sing sarih, sang taruk, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Issakar imthung takoh hoi tacawt caanawk; Tola ih acaeng loe, Tola hoi tacawt kami ah oh o; Pua ih acaeng loe, Pua hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jashub ih acaeng loe, Jashub hoi tacawt kami ah oh, Shimron ih acaeng loe, Shimron hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Issakar ih acaengnawk loe, kami sing taruk, sang pali, cumvai thumto oh o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jebulun imthung takoh hoi tacawt caanawk; Sardi ih acaeng loe, Sered hoi tacawt kami ah oh o; Elon ih acaeng loe, Elon hoi tacawt kami ah oh o; Jahleel ih acaeng loe, Jahleel hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jebulun acaengnawk loe, kami sing taruk, cumvai pangato oh o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Joseph imthung takoh hoi tacawt caanawk loe, Manasseh hoi Ephraim hae ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh acaengnawk; Makir ih acaeng loe, Makir hoi tacawt kami ah oh o; Makir loe Gilead ih ampa ah oh; Gilead ih acaeng loe, Gilead hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="30" style="v" />Gilead ih acaengnawk; Jeezer ih acaeng loe, Jeezer hoi tacawt kami ah oh o; Helek ih acaeng loe, Helek hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="31" style="v" />Asriel ih acaeng loe, Asriel hoi tacawt kami ah oh o; Shekem ih acaeng loe, Shekem hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="32" style="v" />Shemida ih acaeng loe, Shemida hoi tacawt kami ah oh o; Hepher ih acaeng loe, Hepher hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hepher ih capa Zelophehad loe, capa tawn ai; canunawk khue ni a tawnh; canunawk ih ahmin loe, Mahlah, Noah, Hoglah, Milkah hoi Tirzah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hae kaminawk loe Manasseh ih acaeng ah oh o moe, kroek naah nihcae loe kami sing panga, sang hnet, cumvai sarihto oh o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ephraim imthung takoh hoi tacawt caanawk; Shuthelah ih acaeng loe, Shuthelah hoi tacawt kami ah oh o; Beker ih acaeng loe, Beker hoi tacawt kami ah oh o; Tahan ih acaeng loe, Tahan hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shutheleh ih caanawk; Eran ih acaeng loe, Eran hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ephraim ih acaengnawk loe kroek naah, kami sing thum, sang hnet, cumvai pangato oh o. Joseph imthung takoh hoi tacawt acaengnawk loe to zetto oh o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Benjamin imthung takoh hoi tacawt caanawk; Bela ih acaeng loe, Bela hoi tacawt kami ah oh o; Ashbel ih acaeng loe, Ashbel hoi tacawt kami ah oh o; Ahiram ih acaeng loe, Ahiram hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="39" style="v" />Shupham ih acaeng loe, Shupham hoi tacawt kami ah oh o; Hupham ih acaeng loe, Hupham hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ard hoi Naaman hoi tacawt Bela ih caanawk; Ard ih acaeng loe, Ard hoi tacawt kami ah oh o; Naaman hoi tacawt kami loe, Naaman ih acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="41" style="v" />Benjamin ih acaengnawk loe kroek naah, kami sing pali, sang panga, cumvai tarukto oh o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dan imthung takoh hoi tacawt caanawk; Shuham hoi tacawt kami loe, Shuham ih acaeng ah oh o. Hae kaminawk loe Dan ih acaeng ah oh o.
  </para>
  <para style="p">
    <verse number="43" style="v" />To tiah Shulam ih acaengnawk loe kroek naah, kami sing taruk, sang pali, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Asher imthung takoh hoi tacawt caanawk; Jimna ih acaeng loe, Jimna hoi tacawt kami ah oh o; Jesui ih acaeng loe, Jesui hoi tacawt kami ah oh o; Beriah ih acaeng loe, Beriah hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="45" style="v" />Beriah ih caanawk; Herber ih acaeng loe, Heber hoi tacawt kami ah oh o; Malkiel ih acaeng loe, Malkiel hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Asher canu ih ahmin loe Sarah.
  </para>
  <para style="p">
    <verse number="47" style="v" />Asher ih acaengnawk loe kroek naah, kami sing panga, sang thum, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="48" style="v" />Naphtali imthung takoh hoi tacawt caanawk; Jahzeel ih acaeng loe, Jahzeel hoi tacawt kami ah oh o; Guni ih acaeng loe, Guni hoi tacawt kami ah oh o;
  </para>
  <para style="p">
    <verse number="49" style="v" />Jezer ih acaeng loe, Jezer hoi tacawt kami ah oh o; Shillem ih acaeng loe, Shillem hoi tacawt kaminawk ah oh o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Naphtali ih acaengnawk loe kroek naah, sing pali, sang panga, cumvai palito oh o.
  </para>
  <para style="p">
    <verse number="51" style="v" />Israel kaminawk loe kroek naah, kami sing qui taruk, sangto pacoeng, cumvai sarih, qui thumto oh o.
  </para>
  <para style="p">
    <verse number="52" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="53" style="v" />Angmacae ih ahmin baktih toengah, nihcae han prae to pazet paeh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Kami pop kue acaeng hanah qawk to pop kueah paek ah loe, kami tamsi kue hanah qawk to tamsi kueah paek ah; angmacae imthung takoh ih kami zetto qawk to paek han oh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Toe prae loe taham khethaih phoisa vah hoiah pazet ah; ampanawk ih acaeng hmin hoiah ni prae to toep o tih.
  </para>
  <para style="p">
    <verse number="56" style="v" />Lawk loe kami pop hoi tamsi baktih toengah, taham khethaih phoisa vahhaih hoiah pazet ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="57" style="v" />Levi imthung takoh hoi tacawt acaengnawk; Gershon ih acaeng loe, Gershon hoi tacawt kami ah oh o; Kohath ih acaeng loe, Kohath hoi tacawt kami ah oh o; Merari ih acaeng loe, Merari hoi tacawt kami ah oh o.
  </para>
  <para style="p">
    <verse number="58" style="v" />Levi acaeng thungah loe, Libni ih acaeng, Hebron ih acaeng, Mahli ih acaeng, Mushi ih acaeng hoi Korah ih acaengnawk athum o. Kohath mah Amram to sak.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amram ih zu hmin loe Jokhebed; anih loe Levi ih canu ah oh moe, Izip prae ah oh naah Levi acaeng thung hoiah tacawt. Amram hoi anih mah Aaron, Mosi hoi nihnik ih tanuh Miriam to sak.
  </para>
  <para style="p">
    <verse number="60" style="v" />Aaron ih capanawk loe, Nadab, Abihu, Eleazar hoi Ithamar.
  </para>
  <para style="p">
    <verse number="61" style="v" />Toe Nadab hoi Abihu loe, Angraeng hmaa ah paek koi ai hmai hoi angbawnhaih to sak hoi pongah duek hoi hmaek.
  </para>
  <para style="p">
    <verse number="62" style="v" />Levi acaeng thung hoiah nongpa khrah to pacoeng ranui bang kaom kami to kroek boih naah, sing hnet, sang thumto oh o. Nihcae loe Israel kaminawk salakah qawktoep o ai pongah, Israel kaminawk hoi nawnto ahmin kroek o hmaek ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Hae loe Mosi hoi qaima Eleazar mah, Moab azawn, Jordan vapui taeng, Jeriko zaeh ah ah ahmin lak ih Israel kami ah oh o.
  </para>
  <para style="p">
    <verse number="64" style="v" />Mosi hoi qaima Aaron mah Sinai praezaek ah Israel kaminawk ih ahmin to kroek hoi naah, hae kaminawk thung ih thoemto kaminawk ih ahmin maeto doeh kroek hoi ai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Jephunneh capa Kaleb hoi Nun capa Joshua khue ai ah loe, maeto doeh anghmat o mak ai, praezaek ah dueh o tih, tiah Angraeng mah thuih boeh pongah, anih ih ahmin to kroek o ai boeh.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manasseh capa Makir, Makir capa Gilead, Gilead capa Hepher, Hepher capa Zelophehad, anih ih canunawk loe, Joseph capa Manasseh acaeng ah oh o. Anih canunawk ih ahmin loe Mahlah, Noah, Hoglah, Milkah hoi Tirzah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nihcae loe amkhuenghaih kahni im thok taengah, Mosi hoi qaima Eleazar, zaehoikungnawk hoi rangpui kaminawk hmaa ah, angdoet o pacoengah,
  </para>
  <para style="p">
    <verse number="3" style="v" />kaicae ampa loe praezaek ah duek boeh; anih loe Angraeng ih lok aek kami, Korah hnukbang kaminawk thungah athum ai; anih loe a zaehaih pongah duek moe, capa tawn ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />To tiah capa tawn ai pongah, anih ih ahmin to canawk thung hoiah tahmat han boeh maw? To pongah kam pa ih nawkamyanawk hoi nawnto qawk na paek o thoem ah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah Mosi mah nihcae kawng to Angraeng khaeah thuih pae.
  </para>
  <para style="p">
    <verse number="6" style="v" />To naah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="7" style="v" />Zelophehad canunawk mah thuih ih lok loe amsoem; ampa ih nawkamyanawk salakah nihcae han qawk na paek han oh; ampa ih qawknawk to nihcae han paek paeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel kaminawk thung ih, Kami maeto loe, capa tawn ai ah dueh nahaeloe, anih ih qawk to a canu han paek ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Canu doeh tawn ai nahaeloe, anih ih qawk to angmah ih nawkamyanawk khaeah paek ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nawkamyanawk doeh tawn ai bae nahaeloe, anih ih qawk to ampa ih nawkamyanawk khaeah paek ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ampa loe nawkamya tawn ai nahaeloe, acaeng thung kazoi koek kami to paek ah; anih mah qawk to toep tih; hae loe Angraeng mah Mosi khaeah paek ih lok baktih toengah, Israel kaminawk hanah kangaih zaehoihhaih atawk ah om tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="12" style="v" />Angraeng mah Mosi khaeah, Abarim mae nuiah daw tahang ah loe, Israel kaminawk khaeah ka paek han ih prae to doeng ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />To prae na hnuk pacoengah loe, nam ya Aaron lak baktih toengah, nang doeh nam panawk khaeah la tih boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel kaminawk Zin praezaek, Kadesh hmuen ih Meribah tuipuek taengah, laisaep o naah ciimcai ka hmin pakoeh ai ah, ka lok nang aek, tiah a naa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi mah Angraeng khaeah,
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng, kaminawk boih ih Muithla ukkung Sithaw mah, hae kaminawk,
  </para>
  <para style="p">
    <verse number="17" style="v" />hma ah caeh thaih kami, akun thaih kami, zaehoi thaih kami, akunsak thaih kami to zaehoikung ah suem nasoe; to tiah nahaeloe Angraeng ih kaminawk loe toepkung om ai tuunawk baktiah om o mak ai, tiah a naa.
  </para>
  <para style="p">
    <verse number="18" style="v" />To pongah Angraeng mah Mosi khaeah, muithla katawn, Nun capa Joshua to kawk loe, a nuiah na ban to koeng ah;
  </para>
  <para style="p">
    <verse number="19" style="v" />qaima Eleazar hoi kaminawk hmaa ah angdoesak ah loe, kaminawk hma ah tok to paek ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel kaminawk mah a lok tahngaih o hanah, hmuen na sak thaihaih thoemto anih han paek ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih to qaima Eleazar hma ah angdoesak ah loe, qaima mah Angraeng hmaa ah Urim to lokdueng pacoengah, anih han lok takroek pae tih. Anih mah thuih ih lok baktih toengah, anih hoi Israel kaminawk to tacawt o ueloe, anih mah thuih ih lok baktih toengah akun o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng mah thuih ih lok baktih toengah, Mosi mah sak; Joshua to kawk moe, qaima Eleazar hoi rangpui hma ah angdoetsak.
  </para>
  <para style="p">
    <verse number="23" style="v" />To pacoengah anih nuiah ban koeng moe, Angraeng mah Mosi khaeah thuih ih lok baktih toengah, tok to a paek.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hae lok hae Israel kaminawk khaeah thui paeh; nihcae khaeah, Nangcae mah kai han paek ih hmuen, kai khaeah hmuihoih paek hanah hmai hoi sak ih angbawnhaih takaw to, atue phak naah na paek oh, tiah a thuih, tiah thui paeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae khaeah, Ni thokkruek, coek koi kaom ai saningto kaom, tuucaa hnetto, Angraeng khaeah hmai angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuucaa maeto akhawnbang ah paek oh loe, kalah tuucaa maeto loe duembang ah paek ah;
  </para>
  <para style="p">
    <verse number="5" style="v" />olive situi hint palito thungah hint maeto hoi atok ih, takaw dip ephah hato thungah maeto hoi nawnto paek ah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hae loe Sinai mae ah caksak ih, boeng ai ah Angraeng khaeah paek hanah, hmuihoih ah paek ih hmai angbawnhaih ah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuucaa maeto naah, naek han misurtui hint maeto to palito ah tapraek ah loe, to misurtui to naek koi tui hoiah sak ih angbawnhaih baktiah hmuenciim ih Angraeng hmaa ah krai ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kalah tuucaa maeto hoi angbawnhaih loe duembang ah sah ah; akhawn bangah na paek ih takaw dip hoi naek koi tui na paek ih baktih toengah, Sithaw khaeah hmuihoih ah paek ih hmai hoiah angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sabbath niah coek koi kaom ai, saningto kaom tuucaa hnetto loe, naek koi paek ih hmuen hoi nawnto, situi hoi atok tangcae ih takaw dip ephah maeto thung hoi tapraek ih hato thungah hnetto paek ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hae loe hmai hoi angbawnhaih, naek koi tui hoi angbawnhaih sak pacoengah, Sabbath ni kruek sak han koi hmuen ah oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khrah amtong tangsuek naah, coek koi kaom ai maitaw tae hnetto, tuu tae maeto hoi saningto kaom tuucaa sarihto hoiah Angraeng khaeah hmai angbawnhaih to sah ah;
  </para>
  <para style="p">
    <verse number="12" style="v" />Maitaw tae maeto naah situi hoi atok ih takaw dip ephah maeto thung hoi tapraek ih hato thungah thumto; tuu tae maeto naah situi hoi atok tangcae ih takaw dip ephah maeto thung hoi tapraek ih hato thungah hnetto hoi nawnto paek ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuucaa maeto naah situi hoi atok tangcae ih takaw dip ephah maeto thung hoi tapraek ih hato thungah maeto paek ah; hae loe Angraeng khaeah hmuihoih ah paek ih hmai angbawnhaih ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Maitaw tae maeto naah naek koi hmuen ah misurtui hint ahap; tuu tae maeto naah misurtui hint maeto thung hoi tapraek ih thumto thungah maeto, tuucaa maeto naah misurtui hint maeto thung hoi tapraek ih palito thungah maeto paek ah; hae loe saningto thung khrah kruek sak han ih angbawnhaih ah om tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni thokkruek boeng ai ah sak ih hmai angbawnhaih, naek han misurtui hoi angbawnhaih sak pacoengah, zae angbawnhaih sak hanah Angraeng khaeah maeh caa maeto paek han oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khrah tangsuek ni hatlai palito loe, Angraeng mak sak ih misong loihhaih niah oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />To khrah ni hatlai pangato naah poih to sak moe, ni sarihto thung taeh thuh ai ih takaw to caak han oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmaloe koek niah kaciim rangpui amkhuenghaih to sah ah, na sak zong ih tok to sah hmah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angraeng khaeah hmai angbawnhaih sak hanah, coek koi kaom ai saning kanawk maitaw tae hnetto, tuu tae maeto hoi saningto kaom tuucaa sarihto paek ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Maitaw tae maeto naah situi hoi atok tangcae ih takaw dip ephah maeto thung hoi tapraek ih hato thungah thumto; tuu tae maeto naah ephah maeto thung hoi tapraek ih hato thungah hnetto,
  </para>
  <para style="p">
    <verse number="21" style="v" />tuucaa maeto naah ephah maeto thung hoi tapraek ih hato thungah maeto, to tiah tuucaa sarihto han paek ah;
  </para>
  <para style="p">
    <verse number="22" style="v" />nangmacae zae angbawnhaih sak hanah maeh tae maeto paek ah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ni thokkruek boeng ai ah hmai hoi angbawnhaih sak pacoengah, to baktih angbawnhaih doeh sah ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />To tiah boeng ai ah hmai hoi sak ih angbawnhaih hoi naek koi tui hoiah angbawnhaih sak pacoengah, ni thokkruek Angraeng khaeah hmuihoih ah hmai hoi angbawnhaih sak ih takaw to paek ah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni sarihto naah loe kaciim rangpui amkhuenghaih to sah ah, na sak toepsoep ih tok to sah hmah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ni sarihto akoep pacoengah, hmaloe koek tacawt thingthai qumponawk Angraeng khaeah sinhaih ni, hmaloe koek thingthai qumpo paekhaih niah, kaciim rangpui amkhuenghaih to sah oh, na sak o toepsoep ih tok to sah hmah;
  </para>
  <para style="p">
    <verse number="27" style="v" />toe saning kanawk maitaw tae hnetto, tuu tae maeto hoi tuucaa sarihto, Angraeng khaeah hmuihoih angbawnhaih ah paek ah;
  </para>
  <para style="p">
    <verse number="28" style="v" />maitaw tae maeto naah situi hoi atok tangcae takaw dip ephah maeto thung hoi tapraek ih hato thungah thumto; tuu tae maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah hnetto,
  </para>
  <para style="p">
    <verse number="29" style="v" />tuucaa maeto naah takaw dip maeto thung hoi tapraek ih hato thungah maeto paek ah, to tiah tuucaa sarihto han paek ah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangmacae zae angbawnhaih sak hanah, maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Boeng ai ah paek ih hmai angbawnhaih, takaw hoi angbawnhaih sak pacoengah, naek koiah paek ih hmuen hoi nawnto ah coek koi kaom ai moinawk to paek ah.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khrah sarihto haih, ni hmaloe koek ah kaciim rangpui amkhuenghaih to sah ah, na sak zong ih tok to sah hmah; to loe nang han mongkah uenghaih niah om tih.
  </para>
  <para style="p">
    <verse number="2" style="v" />To naah Angraeng khaeah hmuihoih ah paek ih hmai angbawnhaih sak hanah, coek koi kaom ai saning kanawk maitaw tae maeto, tuu tae maeto hoi coek koi kaom ai saningto kaom tuucaa sarihto paek ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Maitaw tae maeto naah situi hoi atok tangcae ih takaw dip ephah maeto thung hoi tapraek ih hato thungah thumto; tuucaa maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah hnetto paek ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuucaa maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah maeto paek ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangmacae zae angbawnhaih sak hanah, maeh caa maeto paek ah;
  </para>
  <para style="p">
    <verse number="6" style="v" />sak zong ih angmacae ih atawk baktih toengah, khrah kruek sak ih hmai hoi angbawnhaih, takaw hoi angbawnhaih, ni thokkruek sak ih hmai angbawnhaih, takaw hoi angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, Angraeng khaeah hmuihoih ah paek ih hmai hoi angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hae khrah sarihto haih, ni hato naah, kaciim rangpui amkhuenghaih to sah ah; to naah nangmacae hoi nangmacae to poek kamtang ah om ah loe, na sak zong ih tok to sah hmah;
  </para>
  <para style="p">
    <verse number="8" style="v" />toe Angraeng khaeah hmuihoih angbawnhaih sak hanah, coek koi kaom ai saning kanawk maitaw tae maeto, tuu tae maeto hoi saningto kaom tuucaa sarihto paek ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Maitaw tae maeto naah situi hoi atok tangcae ih takaw dip ephah maeto thung hoi tapraek ih hato thungah thumto; tuu tae maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah hnetto paek ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuucaa maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah maeto hoiah sah ah; to tiah tuucaa sarihto hanah paek ah;
  </para>
  <para style="p">
    <verse number="11" style="v" />zae angbawnhaih, boeng ai ah sak ih angbawnhaih, takaw angbawnhaih hoi naek koi hmuen paekhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khrah sarihto haih, ni pangato naah, kaciim rangpui amkhuenghaih to sah ah, na sak zong ih tok to sah o hmah; Angraeng khaeah to poih to ni sarihto thung sah ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Angraeng khaeah hmuihoih ah paek ih hmai angbawnhaih sak hanah, saning kanawk maitaw tae hatlai thumto, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuucaa hatlai palito paek ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Maitaw tae hatlai thumto naah situi hoi atok tangcae takaw dip ephah maeto thung hoi tapraek ih hato thungah thumto; tuu tae maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah hnetto,
  </para>
  <para style="p">
    <verse number="15" style="v" />tuucaa maeto naah takaw dip ephah maeto thung hoi tapraek ih hato thungah maeto paek ah; to tiah tuucaa hatlai palito han paek ah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Boeng ai ah hmai angbawnhaih, cang hoi angbawnhaih, naek koi hmuen hoi angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ni hnetto haih naah saning kanawk maitaw tae hatlai hnetto, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuucaa hatlai palito paek ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Angmacae mah sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto ah, cang hoi angbawnhaih, naek koi hmuen hoi angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Boeng ai ah sak ih hmai angbawnhaih, cang hoi angbawnhaih, naek koi hmuen hoi angbawnhaih sak pacoengah, zae angbawnhaih hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ni thumto naah maitaw tae hatlaito, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuucaa hatlai palito paek ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />A sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto ah, cang hoi angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Boeng ai ah hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ni palito naah maitaw caa hato, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuucaa hatlai palito paek ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />A sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto paek ih cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Boeng ai ah hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ni pangato naah maitaw tae takawtto, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuucaa hatlai palito paek ah;
  </para>
  <para style="p">
    <verse number="27" style="v" />a sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto ah, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Boeng ai ah hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ni tarukto naah maitaw tae tazetto, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuuca hatlai palito paek ah.
  </para>
  <para style="p">
    <verse number="30" style="v" />A sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto ah, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Boeng ai ah hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ni sarihto naah, maitaw tae sarihto, tuu tae hnetto hoi coek koi kaom ai saningto kaom tuuca hatlai palito paek ah.
  </para>
  <para style="p">
    <verse number="33" style="v" />A sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto ah, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="34" style="v" />Boeng ai ah hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ni tazetto naah, rangpui amkhuenghaih sah oh, na sak o zong ih tok to sah o hmah;
  </para>
  <para style="p">
    <verse number="36" style="v" />toe Angraeng khaeah hmuihoih ah paek ih hmai hoi sak ih angbawnhaih sak hanah, maitaw tae maeto, tuu tae maeto hoi coek koi kaom ai saningto kaom tuucaa sarihto paek ah.
  </para>
  <para style="p">
    <verse number="37" style="v" />A sak o zong ih atawk baktih, kami pop hoi tamsi baktiah, maitaw tae, tuu tae hoi tuucaanawk hoi nawnto ah, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih to sah ah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Boeng ai ah hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih sak pacoengah, zae angbawnhaih sak hanah maeh caa maeto paek ah.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lokkamhaih sak hanah hmuen tathlanghaih, palung angthawk baktiah hmuen paekhaih, hmai hoi sak ih angbawnhaih, cang hoi sak ih angbawnhaih, naek koi hmuen hoi sak ih angbawnhaih pacoengah, angdaeh angbawnhaihnawk to atue phak naah sah ah, tiah a naa.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah thuih ih lok to Mosi mah Israel zaehoikungnawk khaeah hae tiah thuih pae.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kami maeto mah Angraeng khaeah lokkamhaih a sak, to tih ai boeh loe palung thung hoiah hmuen maeto sak han thui nahaeloe, a thuih ih lok to amkhrai han om ai;
  </para>
  <para style="p">
    <verse number="3" style="v" />nongpata maeto loe nawkta vop, ampa im ah oh nathuem ah, Angraeng khaeah lokkamhaih sak moe, a poekhaih baktiah hmuen maeto sak hanah amsak;
  </para>
  <para style="p">
    <verse number="4" style="v" />anih ih lokkamhaih hoiah sak han atim ih lok to ampa mah kawbangah doeh naa ai, omtaak duem nahaeloe, hmuen maeto sak han lokkamhaih hoiah a thuih ih lok to cak tih boeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toe anih lokkamhaih to ampa mah kaang pae khruek nahaeloe, sak han lokkamhaih to cak mak ai; ampa mah kaang pongah, Angraeng mah anih to tahmen tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nongpata loe sava tawnh moe, a lokkamhaih baktiah maw, to tih ai boeh loe hmuen maeto ka sak han, tiah pahni hoiah thuih naah,
  </para>
  <para style="p">
    <verse number="7" style="v" />a sava mah thaih, toe a thaih niah kawbangah doeh naa ai, omtaak duem nahaeloe, a sak ih lokkamhaih hoi a thuih ih lok to caksak han oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toe a sava mah thaih na niah sak han ai ah pakaa pae khruek nahaeloe, anih lokkamhaih maw, pahni hoiah thuih ih lok maw loe azom ah ni om tih; Angraeng mah doeh anih to tahmen tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lamhmaih nongpata hoi sava mah pakhrak ih nongpata mah lokkamhaih sah nahaeloe, a lokkamhaih to caksak han oh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sava tawn nongpata mah lokkamhaih to sak han ih maw, to tih ai boeh loe hmuen maeto sak han lokkamhaih sak naah,
  </para>
  <para style="p">
    <verse number="11" style="v" />a sava mah thaih, toe pakaa ai, kawbangah doeh naa ai, omtaak duem nahaeloe, hmuen maeto sak han lokkamhaih hoiah a thuih ih lok to cak tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toe sava mah to lok to thaih na niah a lok to aek pae nahaeloe, pahni hoiah thuih ih lokkamhaih hoiah sak han thuih ih lok to cak mak ai; a sava mah phraek boeh pongah, Angraeng mah doeh anih to tahmen tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />A poekhaih amtang hanah a sak ih lokkamhaih boih, hmuen maeto sak han thuih ih lok boih loe, a sava mah caksak thaih baktiah, a phraek thaih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toe a sava mah to hmuen kawng pongah, nito pacoeng nito tidoeh thui ai ah omtaak duem nahaeloe, to nongpata mah lokkamhaih hoiah sak han thuih ih loknawk boih loe cak tih; a sava mah thaih, toe anih to kawbangah doeh naa ai pongah, a thuih ih lok to cak tih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toe sava mah thaih pacoengah hnukkhuem ah phraek han thui nahaeloe, a zu zaehaih to sava nuiah krah tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hae loe Angraeng mah Mosi khaeah thuih pae ih, zu sava salak, ampa hoi ampa im ah kaom a canu tangla salakah khosakhaih atawk ah oh.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk nuiah sak ih zaehaih baktih toengah, Midian kaminawk khaeah sah pathok ah; to pacoengah loe nangmah ih kaminawk khaeah la tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="3" style="v" />To pongah Mosi mah kaminawk khaeah, Midian kaminawk nuiah Angraeng ih lu to lak moe, Midian kaminawk to tuk hanah, nangcae thung ih thoemto kaminawk maiphaw maica hoi amthoep oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel acaeng thung hoi acaeng maeto mah kami sang to misatuk hanah patoeh oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="5" style="v" />To pongah Israel acaeng maeto boih thung hoiah patoeh ih kami sang hatlai hnetto loe misatuk hanah angthawk o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi mah to kaminawk to misatuk hanah acaeng maeto thung hoiah kami sangto patoeh; nihcae hoi nawnto mongkah ueng Eleazar capa qaima Phinehas to hmuenciim thung ih maiphaw maicanawk hoiah nawnto patoeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, nihcae mah Midian kaminawk to tuk o moe, nongpanawk to hum o boih.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hum o ih kaminawk thungah Evi, Rekem, Zur, Hur hoi Reba, Midian siangpahrang pangato athum o; nihcae mah Beor capa Balaam doeh sumsen hoiah hum o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel kaminawk mah Midian nongpatanawk hoi nawktanawk, nihcae ih hmuenmaenawk, maitawnawk hoi tuunawk to lomh pae o boih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Midian kaminawk ohhaih vangpuinawk to hmai hoiah thlaek pae o boih; a ohhaih kahoih imnawk doeh thlaek pae o boih.
  </para>
  <para style="p">
    <verse number="11" style="v" />A naeh o ih kaminawk, a lak o ih hmuennawk hoi pacah ih moinawk doeh lak pae o boih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Misong ah naeh o ih kaminawk hoi a lak pae o ih hmuennawk boih loe, Moab azawn ih Jordan vapui taeng, Jeriko vangpui zaeh ah kaom, Mosi, qaima Eleazar hoi Israel kaminawk khaeah a sinh pae o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi, qaima Eleazar hoi acaeng zaehoikung boih loe, nihcae tongh hanah ataihaih ahmuen tasa bangah caeh o.
  </para>
  <para style="p">
    <verse number="14" style="v" />To naah Mosi loe misatukhaih ahmuen hoiah amlaem misatuh angraengnawk, kami sangto ukkungnawk hoi kami cumvaito ukkungnawk nuiah palungphui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi mah nihcae khaeah, Nongpatanawk na pathlungh o boih maw? tiah a dueng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khenah, hae nongpatanawk loe Balaam ih lok to tahngaih o moe, Peor kawng pongah Israel kaminawk to Angraeng khae hoi loklam amkhraengs o sak boeh; to pongah Angraeng ih kaminawk salakah kasae nathaih to oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vaihi nawktanawk salak ih nongpa to hum o boih ah; nongpa hoi nawnto iip nongpatanawk doeh hum o boih ah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toe nongpa panoek vai ai tanglanawk loe nangmacae han suem oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangcae thungah mi kawbaktih doeh kami hum kami, to tih ai boeh loe hum ih kami qok sui kami to ataihaih im tasa bangah ni sarihto thung suem oh; ni thumto hoi ni sarihto naah nangmacae hoi na naeh o ih kaminawk boih ciimcaihaih to sah oh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangmacae ih khukbuen, moihin hoi sak ih hmuennawk, maeh mui, thing hoi sak ih hmuennawk to ciimcai o sak ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="21" style="v" />To pacoengah qaima Eleazar mah misatuk han kacaeh misatuh kaminawk khaeah, Angraeng mah Mosi khaeah paek ih atawk loe hae tiah oh;
  </para>
  <para style="p">
    <verse number="22" style="v" />sui, sum kanglung, sum kamling, sum, camphaeh ngan hoiah kimah,
  </para>
  <para style="p">
    <verse number="23" style="v" />hmai kakaang thaih hmuennawk boih loe hmai hoiah qoeng ah, to tiah nahaeloe ciim tih; ciimsakhaih tui hoiah doeh pasae oh; hmai khaan thai ai hmuennawk loe tui hoiah pasae oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni sarihto naah khukbuennawk to pasuk oh, to tiah nahaeloe na ciim o tih; to pacoengah loe ataihaih imthung ah nang zo o thai tih boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="26" style="v" />kaminawk mah lak o ih hmuenmaenawk to nangmah hoi qaima Eleazar hoi acaeng zaehoikung mah la oh loe,
  </para>
  <para style="p">
    <verse number="27" style="v" />to hmuennawk to ahmuen hnetto ah tapraek ah; misatuk han caeh misatuh kaminawk hoi amkhueng kaminawk han tapraek paeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Misatuk han kacaeh misatuh kaminawk loe kami doeh, maitaw doeh, laa hrang doeh, tuu doeh, cumvai pangato thungah maeto, Angraeng khaeah paek han oh;
  </para>
  <para style="p">
    <verse number="29" style="v" />nihcae mah hak ih tamut ahap to la ah loe, Angraeng taham to qaima Eleazar khaeah paek ah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Israel acaeng ahap khae hoiah, kami doeh, maitaw doeh, laa hrang doeh, tuu doeh, maeh doeh, kalah moinawk doeh, qui pangato thungah maeto la ah loe, to hmuennawk to Angraeng ih kahni im khenzawnkung Levinawk khaeah paek ah, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />To pongah Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Mosi hoi qaima Eleazar mah sak hoi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Misatuh kaminawk mah lak o ih kanghmat tuunawk loe sang cumvai taruk, sang qui sarih, sang pangato oh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Maitaw sing sarih, sang hnetto,
  </para>
  <para style="p">
    <verse number="34" style="v" />laa hrang sing taruk, sangto,
  </para>
  <para style="p">
    <verse number="35" style="v" />nongpa hoi iip vai ai nongpata sing thum, sang hnetto oh o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Misatuk naah kacaeh kaminawk ih taham ahap loe, tuu sing qui thum, sing thum, sang sarih, cumvai pangato,
  </para>
  <para style="p">
    <verse number="37" style="v" />Angraeng khaeah tathlang han ih hmuen loe cumvai taruk, qui sarih, pangato oh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Maitaw sing thum, sang tarukto oh; to thung hoiah qui sarih, hnetto loe Angraeng khaeah paek han ih taham ah oh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Laa hrang sing thum, cumvai pangato oh; to thung hoiah Angraeng ih taham loe qui taruk, maeto;
  </para>
  <para style="p">
    <verse number="40" style="v" />kami loe singto pacoeng, sang tarukto oh; to thung hoiah Angraeng ih taham loe qui thum, hnetto.
  </para>
  <para style="p">
    <verse number="41" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Mosi mah Angraeng ih taham to qaima Eleazar khaeah paek.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mosi mah misatuh kaminawk khae hoiah lak moe, Israel kaminawk mah hak han koi ahap,
  </para>
  <para style="p">
    <verse number="43" style="v" />rangpuinawk mah hak han koi ahap loe, tuu sang cumvai thum, sing thum, sang sarih, cumvai pangato;
  </para>
  <para style="p">
    <verse number="44" style="v" />maitaw sing thum, sang tarukto,
  </para>
  <para style="p">
    <verse number="45" style="v" />laa hrang sing thum, cumvai pangato hoi,
  </para>
  <para style="p">
    <verse number="46" style="v" />kami singto pacoeng, sang tarukto oh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Angraeng mah thuih ih lok baktih toengah, Israel rangpui mah hak han koi taham ahap thung hoiah, Mosi mah kami maw, moi maw qui pangato thungah maeto lak moe, Angraeng ih kahni im khenzawnkung Levi kaminawk khaeah paek.
  </para>
  <para style="p">
    <verse number="48" style="v" />To pacoengah misatuh sangto ukkungnawk hoi misatuh cumvaito ukkungnawk Mosi khaeah caeh o moe,
  </para>
  <para style="p">
    <verse number="49" style="v" />anih khaeah, Na tammanawk mah misatuh kaminawk thung ih kami ka kroek o naah, maeto doeh anghmaa ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />To pongah Angraeng khaeah paek hanah sui hoiah sak ih hmuennawk, bungmunawk, ban lakoknawk, bantuetnawk, naa tangkraengnawk, hnah ah bangh koi hmuennawk to Angraeng hmaa ah angbawnhaih ah sak han ih kang sin o, tiah a naa o.
  </para>
  <para style="p">
    <verse number="51" style="v" />Mosi hoi qaima Eleazar mah nihcae ih suinawk to talawk pae hoi; ban tok sah kop kaminawk mah sak ih suinawk to talawk pae hoi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Mosi hoi qaima Eleazar mah misatuh kami sangto ukkungnawk hoi misatuh kami cumvaito ukkungnawk khae hoiah talawk ih Angraeng ih taham suinawk loe sangqum ah shekel sang hatlai taruk, cumvai sarih, qui pangato oh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Misatuh kami maeto mah angmah hanah hmuen maeto lak o boih.
  </para>
  <para style="p">
    <verse number="54" style="v" />Mosi hoi qaima Eleazar mah misatuh kami sangto hoi misatuh kami cumvaito ukkungnawk khae hoiah talawk hoi ih suinawk to Israel kaminawk mah panoek poe hanah amkhuenghaih kahni im ah Angraeng hmaa ah a sin hoi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Reuben hoi Gad kaminawk mah Jazer hoi Gilead prae to hnuk o naah, kahoih parai maitaw pacahhaih ahmuen doeh a hnuk o;
  </para>
  <para style="p">
    <verse number="2" style="v" />to pongah Reuben hoi Gad kaminawk angzoh o moe, Mosi, qaima Eleazar hoi Israel rangpui zaehoikungnawk khaeah lokthuih o,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ataroth, Dibon, Jazer, Nimrah, Heshbon, Elealeh, Shebam, Nebo, Beon hoi,
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel kaminawk hmaa ah Angraeng mah tuk pae ih prae loe, moi pacah han hoih parai, na tamna kaicae loe pacah ih moi paroeai ka tawnh o;
  </para>
  <para style="p">
    <verse number="5" style="v" />nangcae mikcuk naakrak ah ka oh o nahaeloe, hae praenawk hae na tamnanawk hanah qawk ah na paek ah, kaicae hae Jordan vapui angkatsak hmah, tiah a naa o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi mah Gad hoi Reuben kaminawk khaeah, Nam nawkamyanawk loe misatuk naah caeh o, toe nangcae loe haeah nang hnut o sut han maw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Tipongah Angraeng mah nihcae khaeah paek ih prae thungah caeh hanah, Israel kaminawk tha na set o sak loe?
  </para>
  <para style="p">
    <verse number="8" style="v" />Prae khet hanah nam panawk to Kadesh-Bernea hoi ka patoeh naah to tiah a oh o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eskol azawn to phak o moe, prae to a hnuk o naah, Angraeng mah nihcae khaeah paek ih prae thungah akun hanah, Israel kaminawk to palungboeng o sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />To niah Angraeng palungphui o sak pongah, Anih mah lokkamhaih sak naah,
  </para>
  <para style="p">
    <verse number="11" style="v" />nihcae loe palungthin boih hoi ka hnukah bang o ai pongah, mi kawbaktih doeh Izip prae thung hoi tacawt saning pumphaeto hoi ranuih bang kaom kaminawk boih, Abraham, Issak hoi Jakob khaeah paek han lokkam ih prae to hnu o mak ai;
  </para>
  <para style="p">
    <verse number="12" style="v" />palungthin boih hoi Angraeng hnukah kabang, Keniz acaeng Jephunneh capa Kaleb hoi Nun capa Joshua khue ni prae to hnu tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah Angraeng Sithaw hmaa ah kasae sah kaminawk ih caanawk amrosak boih ai karoek to, praezaek ah saning qui palito thung amhetsak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khenah, nangcae loe vaihi nam panawk pongah na zae o kue, nam panawk zuengah nang thawk o moe, Israel kaminawk nuiah Angraeng palungphui aep han ih ni na sak o boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anih to nam khraeng o taak nahaeloe, Israel kaminawk to praezaek ah amhetsak let tih, nangcae loe hae kaminawk amrosakkung ah na om o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />To pacoengah Reuben hoi Gad kaminawk anih khaeah angzoh o moe, Hae ahmuen ah maitaw pacahhaih imnawk hoi nawktanawk ohhaih vangpuinawk to ka sak o han;
  </para>
  <para style="p">
    <verse number="17" style="v" />toe Israel kaminawk angmacae ohhaih ahmuen ah thaak boih ai karoek to, maiphaw ka sinh o moe, Israel caanawk hma ah ka caeh o han; hae prae thungah kaom kaminawk pongah, aicae ih caanawk loe sipae thungh ih vangpuinawk thungah khosak o han oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel acaeng maeto boih mah qawktoep ai karoek to, im ah kam laem o mak ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaicae loe Jordan vapui zaeh ah nihcae hoi nawnto qawktoep han tidoeh om mak ai; Jordan vapui ni angyae bangah ni qawktoep han oh, tiah a naa o.
  </para>
  <para style="p">
    <verse number="20" style="v" />To naah Mosi mah nihcae khaeah, Hae tiah oh pongah, maiphaw na sin o moe, Angraeng hmaa ah misatuk hanah na caeh o,
  </para>
  <para style="p">
    <verse number="21" style="v" />Angraeng mah a misanawk to a hmaa hoiah haek boih ai karoek to, Angraeng hmaa ah maiphaw sin hoi Jordan vapui nang kat o boih moe,
  </para>
  <para style="p">
    <verse number="22" style="v" />Angraeng hmaa ah prae na pazawk o nahaeloe, nam laem o let thai tih, to pacoengah loe Angraeng hoi Israel kaminawk hmaa ah zaehaih tidoeh na tawn o mak ai boeh; to naah hae prae loe Angraeng hmaa ah nangcae ih qawk ah om tih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toe na sah o ai nahaeloe, khenah, nangcae loe Angraeng hmaa ah zaehaih na tawnh o pongah, na zae o haih mah nangcae to patom tih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na caa nawktanawk hanah vangpuinawk, tuunawk hanah tuu imnawk to sah pae oh; pakha hoi na thuih o ih lok baktih toengah sah oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gad hoi Reuben kaminawk mah Mosi khaeah, Na tamna kaicae loe ka angraeng mah thuih ih lok baktih toengah ka sak o han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka zu hoi ka caa nawktanawk, maitawnawk hoi tuunawk loe Gilead prae ih vangpuinawk thungah om o tih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toe ka angraeng mah thuih ih lok baktih toengah, na tamna kaicae loe, maiphaw ka sinh o moe, misatuk hanah Angraeng hmaa ah Jordan vapui to kang kat o han, tiah a naa o.
  </para>
  <para style="p">
    <verse number="28" style="v" />To kawng pongah Mosi mah, qaima Eleazar, Nun capa Joshua hoi Israel acaeng zaehoikung lu koeknawk khaeah, lokthuih pae;
  </para>
  <para style="p">
    <verse number="29" style="v" />nihcae khaeah, Gad hoi Reuben kaminawk loe misatuk hanah Angraeng hmaa ah nangcae hoi nawnto Jordan vapui to angkat o boih moe, nangcae hmaa ah misa pazawk o nahaeloe, to Gilead prae to nihcae han qawk ah toep o sak ah:
  </para>
  <para style="p">
    <verse number="30" style="v" />toe nihcae mah maiphaw to sin o moe, nangcae hoi nawnto vapui angkat o ai nahaeloe, Kanaan prae ah ni nangcae salakah taham to tawn o tih, tiah a naa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Gad hoi Reuben kaminawk mah, Angraeng mah na tamnanawk khaeah thuih ih lok baktih toengah, ka sak o han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jordan vapui hae bang zaeh ih prae to ka toep o hanah, maiphaw sin hoi Angraeng hmaa ah Kanaan prae thungah ka kun o han, tiah a naa o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosi mah Gad kaminawk, Reuben kaminawk hoi Joseph ih caa, ahap Manasseh acaengnawk khaeah, Amor siangpahrang Sihon prae thung ih vangpuinawk boih, Bashan siangpahrang Og prae thung ih vangpuinawk to paek boih.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gad kaminawk mah Dibon, Ataroth, Aroer,
  </para>
  <para style="p">
    <verse number="35" style="v" />Atroth, Shophan, Jaazer, Jogbehah,
  </para>
  <para style="p">
    <verse number="36" style="v" />Beth-Nimrah hoi Beth-Haran vangpuinawk to sipae thungh o moe, pacah ih tuunawk han doeh im sak pae o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuben kaminawk mah Heshbon, Elealeh hoi Kirjathaim,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nebo hoi Baal-Meon (to vangpui ahmin loe athlaeng o ving boeh), Shibmah vangpui to sak o; a sak o ih vangpuinawk loe angmacae mah ni ahmin to sak o.
  </para>
  <para style="p">
    <verse number="39" style="v" />Manasseh capa Makir ih caanawk loe Gilead ah caeh o moe, vangpuinawk to lak o pacoengah, Amor kaminawk to haek o.
  </para>
  <para style="p">
    <verse number="40" style="v" />To pongah Mosi mah Gilead to Manasseh capa Makir hanah paek; anih loe to ah khosak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Manasseh capa Jair mah nihcae ohhaih ahmuen to tuk moe, a lak pacoengah Havoth-Jair, tiah ahmin sak.
  </para>
  <para style="p">
    <verse number="42" style="v" />To pacoengah Nobah mah Kenath hoi a taengah kaom avangnawk to tuk moe, a lak pacoengah, angmah ih ahmin to sak.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi hoi Aaron zaehhoihaih rang hoiah, Israel kaminawk Izip prae thung hoi tacawt o moe, kholong caehhaih kawng,
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng mah thuih ih lok baktih toengah, Mosi mah kholong caehhaih kawng tarik ih ca loe hae tiah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel kaminawk loe khrah tangsuek, ni hatlai pangato naah, Ramese vangpui hoiah tacawt o; Israel kaminawk loe misong loihaih ni boeng pacoeng, akhawnbang ah Izip kaminawk mikhnuk ah amoekhaih hoiah tacawt o.
  </para>
  <para style="p">
    <verse number="4" style="v" />To nathuem ah Izip kaminawk loe, Angraeng mah hum pae ih a calunawk ih qok to aphum o; nihcae ih sithawnawk doeh Angraeng mah lokcaek pae.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel kaminawk loe Ramese vangpui hoiah tacawt o moe, Sukkoth ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sukkoth ahmuen hoiah tacawt o moe, praezaek ramri ah kaom Etham ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Etham ahmuen hoiah tacawt o moe, Baal-Zephon hma ah kaom, Pi-Hahiroth vangpui ah amlaem o let; to pacoengah Migdol vangpui hma ah atai o.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pi-Hahiroth vangpui hoiah tacawt o moe, tuipui um hoi praezaek ah caeh o poe; Etham praezaek ah ni thumto thung caeh o pacoengah, Marah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="9" style="v" />Marah ahmuen hoiah tacawt o moe, Elim avang ah caeh o; Elim avang ah loe tuipuek hatlai hnetto hoi ungsikung qui sarihto ohhaih ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="10" style="v" />Elim hoiah tacawt o moe, tuipui kathim taengah atai o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuipui kathim hoiah tacawt o moe, Sin praezaek ah atai o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sin praezaek hoiah tacawt o moe, Dophkah ah atai o.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dophkah hoiah amsak o moe, Alush ah atai o.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alush hoiah amsak o moe, Rephidim ah atai o; to ahmuen ah loe kaminawk mah naek han koi tui to om ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rephidim hoiah amsak o moe, Sinai praezaek ah atai o.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sinai praezaek hoiah amsak o moe, Kibroth-Hattaavah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kibroth Hattaavah hoiah amsak o moe, Hazeroth ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hazeroth hoiah amsak o moe, Rithmah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rithmah hoiah amsak o moe, Rimmon-Perez ah atai o.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rimmon-Perez hoiah amsak o moe, Libnah avang ah atai o.
  </para>
  <para style="p">
    <verse number="21" style="v" />Libnah avang hoiah amsak o moe, Rissah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rissah hoiah amsak o moe, Kehelathah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kehelathah hoiah amsak o moe, Shepher mae ah atai o.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shepher mae hoiah amsak o moe, Haradah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="25" style="v" />Haradah hoiah amsak o moe, Makheloth ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="26" style="v" />Makheloth hoiah amsak o moe, Tahath ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahath hoiah amsak o moe, Terah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Terah hoiah amsak o moe, Mithkah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mithkah hoiah amsak o moe, Hashmonah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hashmonah hoiah amsak o moe, Moseroth ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Moseroth hoiah amsak o moe, Ben-Jaakan ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bene-Jaakan hoiah amsak o moe, Hor-Haggidgad ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hor-Haggidgad hoiah amsak o moe, Jotbathah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jotbathah hoiah amsak o moe, Abronah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abronah hoiah amsak o moe, Ezion-Geber ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ezion-Geber hoiah amsak o moe, Zin praezaek ah kaom Kadesh ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kadesh hoiah amsak o moe, Edom ramri ah kaom, Hor mae ah atai o.
  </para>
  <para style="p">
    <verse number="38" style="v" />Angraeng mah paek ih lok baktih toengah, Israel kaminawk loe Izip prae thung hoiah tacawt o pacoeng, saning qui pali, khrah pangato haih, ni tangsuek naah, qaima Aaron loe Hor mae ah dawh tahang moe, to mae ah duek.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hor mae ah duek naah Aaron loe saning cumvai pumphaeto pacoeng, thumto oh boeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kanaan prae aloih bangah kaom siangpahrang Arad mah, Israel kaminawk angzoh o ti, tiah a thaih.
  </para>
  <para style="p">
    <verse number="41" style="v" />To pongah Israelnawk loe Hor mae hoiah amsak o moe, Zalmonah ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zalmonah hoiah amsak o moe, Punon hmuen ah atai o.
  </para>
  <para style="p">
    <verse number="43" style="v" />Punon hoiah amsak o moe, Oboth hmuen ah atai o.
  </para>
  <para style="p">
    <verse number="44" style="v" />Oboth hoiah amsak o moe, Moab ramri ah kaom, Iye-Abarim hmuen ah atai o.
  </para>
  <para style="p">
    <verse number="45" style="v" />Iye-Abarim hoiah amsak o moe, Dibon-Gad hmuen ah atai o.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dibon-Gad hoiah amsak o moe, Almon-Diblathaim ahmuen ah atai o.
  </para>
  <para style="p">
    <verse number="47" style="v" />Almon-Diblathaim hoiah amsak o moe, Nebo hma ah kaom, Abarim mae taengah atai o.
  </para>
  <para style="p">
    <verse number="48" style="v" />Abarim mae hoiah amsak o moe, Jeriko vangpui taeng, Jordan vapui yaeh ih Moab azawn ah atai o.
  </para>
  <para style="p">
    <verse number="49" style="v" />Moab azawn hoiah Jordan vapui taeng, Beth-Jeshimon vangpui hoi Abel-Shittim vangpui khoek to atai o.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jeriko vangpui maeto bang, Jordan vapui taengah kaom, Moab azawn ah oh o naah, Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="51" style="v" />Israel kaminawk khaeah hae tiah thui paeh; Jordan vapui to nang kat o moe, Kanaan prae thungah na kun o naah,
  </para>
  <para style="p">
    <verse number="52" style="v" />nangcae hma ah kaom prae kaminawk to haek oh; a sak o ih krangnawk hoi atui pakaw moe, pahlom ih krangnawk to phrae pae o ah loe, nihcae ih hmuensangnawk doeh phrae pae o boih ah.
  </para>
  <para style="p">
    <verse number="53" style="v" />To prae to nangcae han kang paek boeh pongah, to prae kaminawk to haek oh loe, a thungah om oh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Prae loe imthung takoh maeto boih hanah, taham khethaih phoisa vahhaih hoiah pazet ah; kapop kue imthung takohnawk hanah kalen kue ah prae to paek ah loe, imthung takoh tamsi kue kaminawk hanah loe kathoeng kue prae to paek ah; taham khethaih phoisa vahhaih moe, amtimhaih ahmuen to nihcae mah toep han ih qawk ah om tih; acaeng maeto pacoeng maeto, to tiah qawk to toep o tih.
  </para>
  <para style="p">
    <verse number="55" style="v" />Toe nangcae hma ah kaom prae kaminawk to na haek o ai nahaeloe, na pathlung o ih kaminawk loe nangcae ih miknuen ah om o ueloe, nangcae ih panak hanah soekhring ah om o tih; na oh o han koi prae thungah nihcae mah raihaih na paek o tih.
  </para>
  <para style="p">
    <verse number="56" style="v" />To naah nihcae nuiah sak han ka tim ih hmuen to nangcae nuiah ka sak lat han, tiah a thuih, tiah thui paeh, tiah a naa.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk khaeah hae tiah thui paeh; Kanaan prae na phak o naah, nangcae mah qawk ah na toep o han ih Kanaan prae loe hae tiah oh,
  </para>
  <para style="p">
    <verse number="3" style="v" />aloih bang ih ramri loe, Edom ramri hoi kangbet Zin praezaek khoek to; topacoengah aloih bang ih na ramri loe Paloi tuipui ni angyae boenghaih ahmuen khoek to om tih;
  </para>
  <para style="p">
    <verse number="4" style="v" />aloih bang ih na ramri loe, aloih bang hoiah angkoih moe, Akkarabim tangkhamh bangah caeh tahang pacoengah, Zin praezaek bangah caeh poe; to ahmuen hoiah Kadesh-Barnea avang, Hazar-Addar avang, Azmon avang ah caeh poe;
  </para>
  <para style="p">
    <verse number="5" style="v" />Azmon ah amlaem let moe, Izip prae vapui to poeng pacoengah, tuipui ah boeng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kalen tuipui loe niduem bang ih na ramri ah om tih; to tiah niduem bang ih na ramri to om tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aluek bang ih na ramri loe, kalen tuipui hoiah amtong moe, Hor mae karoek to caeh tih;
  </para>
  <para style="p">
    <verse number="8" style="v" />Hor mae hoiah Hammath akunhaih karoek to caeh tih; to pacoengah ramri loe to ahmuen hoiah Zedad karoek to caeh ueloe,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ziphron avang ah caeh poe pacoengah, Hazar-Enan ah boeng tih; hae loe aluek bang ih na ramri ah om tih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni angyae bang ih na ramri loe, Hazar-Enan hoi ah Shepham karoek to om tih.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shepham avang hoiah caeh tathuk poe ueloe, Ain avang ni angyae bangah kaom, Riblah avang to phak pacoengah, Kinnereth ni angyae bangah kaom, tuipui ah caeh tathuk tih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ramri loe to ahmuen hoiah Jordan vapui ah caeh tathuk poe ueloe, paloi tuipui ah boeng tih: hae loe nangcae mah qawktoep han koi prae ahnuk ahma ramri ah om tih, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi mah Israel kaminawk khaeah lokthuih pae; Angraeng mah thuih ih lok baktih toengah, Hae loe taham khethaih cung vah moe, acaeng takawt to hoi ahap ah kaom acaengnawk khaeah, qawk ah paek han ih prae ah oh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Reuben imthung takoh, Gad imthung takoh hoi ahap Manasseh acaeng ah kaom kaminawk loe qawktoep hanah hak o boeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Acaeng hnetto hoi acaeng ahap ah kaom kaminawk loe, Jeriko vapui taeng, Jordan vapui zaeh, ni angyae bang ih ahmuen to qawk ah a hak o boeh, tiah a naa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="17" style="v" />na toep o han ih prae pazetkungnawk ih ahmin loe, qaima Eleazar hoi Nun capa Joshua.
  </para>
  <para style="p">
    <verse number="18" style="v" />Qawktoep koi prae pazet hanah, acaeng maeto thung hoiah zaehoikung maeto qoi oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nihcae ih ahminnawk loe, Judah acaeng thung hoiah Jephunneh capa Kaleb.
  </para>
  <para style="p">
    <verse number="20" style="v" />Simeon acaeng thung hoiah Ammihud capa Shemuel.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin acaeng thung hoiah, Kislon capa Elidad.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan acaeng thung hoiah, Jogli capa Bukki.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph capa Manasseh acaeng thung hoiah, Ephod capa Hanniel.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joseph capa Ephraim acaeng thung hoiah, Shiphtan capa Kemuel.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zebulun acaeng thung hoiah, Parnak capa Elizaphan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Issakar acaeng thung hoiah, Azzan capa Paltiel.
  </para>
  <para style="p">
    <verse number="27" style="v" />Asher acaeng thung hoiah Shelomi capa Ahihud.
  </para>
  <para style="p">
    <verse number="28" style="v" />Naphtali acaeng thung hoiah, Ammihud capa Pedahel cae hae ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hae kaminawk loe Angraeng mah thuih ih Kanaan prae thungah, Israel kaminawk toep han ih prae pazetkung ah oh o.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jeriko vangpui maeto bang, Jordan vapui taengah kaom, Moab azawn ah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel kaminawk mah toep o ih prae thungah Levi kaminawk ohhaih vangpui hoi a taengah kaom ahmuennawk boih to paek ah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levi kaminawk loe to vangpuinawk thungah om o tih, vangpui taeng ih ahmuennawk loe maitaw, moinawk hoi a tawnh o ih hmuennawk suekhaih ahmuen ah om tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Levi kaminawk han paek ih vangpui taeng ih ahmuennawk loe, vangpui sipae hoi dong sangto kawksak han oh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vangpui tasa bang hoi aluek, aloih, ni angyae hoi niduem bang to dong sang hnetto kakawk ah tah ah; vangpui loe a um ah om tih; vangpui taeng ih ahmuen loe to tiah om tih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi kaminawk han paek ih vangpui taruktonawk loe, kami hum moeng naah abuephaih vangpui ah patoh hanah sah paeh; to vangpuinawk pacoengah kalah vangpui qui pali, hnetto doeh thap paeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Levinawk na paek han ih vangpuinawk loe qui pali, tazetto om tih; vangpui taeng ih ahmuennawk hoi nawnto paek ah.
  </para>
  <para style="p">
    <verse number="8" style="v" />To vangpuinawk loe Israel kaminawk mah toep ih ahmuen thung hoiah tapraek paeh; ahmuen kapop ah tawn kami khae hoiah kapop ah la ah loe, ahmuen zetta tawn kami khae hoiah zetta ah la ah; kami boih qawktoep ih ahmuennawk thung hoiah Levinawk hanah paek oh, tiah a naa.
  </para>
  <para style="p">
    <verse number="9" style="v" />To pacoengah Angraeng mah Mosi khaeah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel kaminawk khaeah hae tiah thui paeh; Kanaan prae ah caeh hanah Jordan vapui to nang kat o naah,
  </para>
  <para style="p">
    <verse number="11" style="v" />poek ai pui hoi kami hum moeng kami loe cawnh moe, abuep hanah vangpui to qoi ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />To vangpuinawk loe, poek ai pui hoi kami hum moeng kami, rangpui hma ah lokcaek han angdoe ai karoek to, lu la kami ih ban thung hoiah duek han ai ah, abuephaih vangpui ah om tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />To tiah na paek ih vangpui taruktonawk loe na buephaih vangpui ah om tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abuep haih hanah Jordan vapui hae bangah vangpui thumto, Kanaan prae ah vangpui thumto sah paeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hae vangpui taruktonawk loe Israel kaminawk, angvinnawk hoi nihcae salakah kaom kaminawk abuephaih ah om tih; poek ai pui hoi kami hum moeng kami loe to vangpui thungah cawnh han oh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kami maeto mah sumboeng hoiah kami to bop maat nahaeloe, anih loe kami humkung ah oh; kami humkung loe paduek han oh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kami maeto hum hanah, thlung hoiah va maat nahaeloe, anih loe kami humkung ah oh; kami humkung loe, paduek han oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kami maeto mah a ban ah sin ih thingboeng hoiah kami to bop maat nahaeloe, anih loe kami humkung ah oh; kami humkung loe paduek han oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Athii tho lu la kami mah kami hum kami to hum tih; anih to hnuk naah hum tih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kami maeto loe hnukma pongah kami to a thunh maw, to tih ai boeh loe hum hanah angang moe, hmuen maeto hoiah a vah maat maw;
  </para>
  <para style="p">
    <verse number="21" style="v" />to tih ai boeh loe hnukma pongah ban hoiah a boh naah, kami to dueh ving nahaeloe, to tiah bop kami to paduek han oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toe pacaenghaih om ai ah kami maeto mah poek ai pui hoiah nuih moeng maw, to tih ai boeh loe patoemhaih om ai ah hmuen maeto hoiah vah moeng maw,
  </para>
  <para style="p">
    <verse number="23" style="v" />to tih ai boeh loe anih hoi misa ah om ai, hnukmahaih doeh om ai; to kami to hnu ai pongah thlung hoiah va maat moeng nahaeloe, anih hoi misa ah om ai, hum han pacaenghaih doeh om ai pongah,
  </para>
  <para style="p">
    <verse number="24" style="v" />hae lokcaekhaih daan baktih toengah, athii tho lu la kami hoi kadueh kami salakah rangpui mah lokcaek tih;
  </para>
  <para style="p">
    <verse number="25" style="v" />rangpui mah poek ai pui hoiah kami hum moeng kami to athii tho lu la kami ih ban thung hoiah la ueloe, cawnh moe abuep han koi vangpui thungah caehsak tih; anih loe to ahmuen ah kaciim situi hoi bawh ih kalen koek qaima dueh ai karoek to om tih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toe kami hum kami loe abuephaih vangpui tasa bangah tacawt pongah,
  </para>
  <para style="p">
    <verse number="27" style="v" />athii tho lu la kami mah anih to tasa bangah hnuk naah hum nahaeloe, kami hum pongah zaehaih tawn mak ai;
  </para>
  <para style="p">
    <verse number="28" style="v" />kami hum kami loe kalen koek qaima dueh ai karoek to abuephaih vangpui thungah om tih; kalen koek qaima duek pacoengah ni a ohhaih ahmuen ah amlaem let thai vop tih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hae loe na ohhaih ahmuen kruekah na caa nawktanawk dung khoek to na pazui o han ih lokcaekhaih daan ah om tih.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kami hum kami loe, kami hum tiah hnukung mah thuih ih lok baktih toengah, anih to paduek han oh; toe hnukung maeto khue om nahaeloe anih to paduek han om ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Duek han kaom kami akranghaih phoisa to talawk hmah; anih loe paduek han roe oh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kalen koek qaima dueh ai naah, abuephaih vangpui thungah cawn kami mah a ohhaih prae thungah oh thai hanah, paek ih akranghaih phoisa to talawk han om ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na ohhaih prae to amhnongsak hmah; athii longhaih mah prae to amhnongsak boeh; athii palong kami maeto ih athii longhaih om ai ah loe, angbawnhaih hoiah prae thungah kalong athii to ciimsak thai mak ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kai, Angraeng loe Israel kaminawk salakah ka oh pongah, na oh o haih prae hoi Ka ohhaih prae to amhnong o sak hmah, tiah a naa.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph acaeng, Manasseh capa Makir, Makir capa Gilead imthung takoh lu koeknawk to angzoh o moe, Mosi, zaehoikungnawk hoi Israel imthung takoh lu koeknawk khaeah lokthuih o;
  </para>
  <para style="p">
    <verse number="2" style="v" />nihcae mah, Kaicae ih angraeng Mosi mah taham khethaih cung to vah moe, Israel kaminawk Kanaan prae toepsak hanah, Angraeng mah lokpaek boeh; Angraeng mah kaicae angraeng khaeah kaicae ih amnawk Zelophehad ih canunawk hanah qawk paek han ih kawng doeh a thuih boeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nihcae loe kalah Israel acaengnawk khaeah sava sah o nahaeloe, ampanawk mah toep o ih qawk thung hoiah nihcae ih qawk to la o ueloe, sava sakhaih acaeng kaminawk ih qawk ah om tih; to tiah kaicae ih qawk to la o tih boeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel caanawk ih Jubili to phak naah, nihcae ih qawk loe nihcae sava sakhaih acaengnawk ih qawk ah om tih, to tiah kam panawk khae hoi hak ih acaeng qawk to la o tih, tiah a naa o.
  </para>
  <para style="p">
    <verse number="5" style="v" />To naah Angraeng mah thuih ih lok baktih toengah, Mosi mah Israel kaminawk khaeah, Joseph ih caanawk mah thuih o ih lok loe amsoem.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zelophehad ih canunawk hanah Angraeng mah thuih ih lok loe hae tiah oh; nihcae loe a koeh o koek ih kami khaeah sava sah o nasoe; toe ampa ih acaengnawk khae khue ah sava sak o han oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah Israel acaeng thung ih qawk doeh acaeng maeto hoi maeto khaeah paqoi han om ai; Israel kaminawk boih ampanawk khae hoiah toep o ih qawk to pakuem o han oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kawbaktih Israel acaeng thungah doeh qawktoep canunawk loe, ampa ih acaeng thungah ni sava sak o han oh; to tiah Israel kaminawk boih mah ampanawk ih qawk to toep o tih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Qawk ah toep ih hmuen to acaeng maeto hoi maeto khaeah paqoi o hmah; Israel acaeng boih mah angmacae ih qawk to pakuem o han oh, tiah a thuih pae.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng mah Mosi khaeah thuih ih lok baktih toengah, Zelophehad canunawk mah sak o.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zelophehad canu, Mahlah, Tirzah, Hoglah, Milkah hoi Noah cae loe, ampa amnawk ih capanawk khaeah sava sak o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae loe Joseph capa Manasseh ih caanawk khaeah sava sak o, to tiah nihcae ih qawk loe ampanawk ih acaeng thungah oh poe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hae loe Jeriko vangpui zaeh, Jordan vapui taengah kaom, Moab azawn ah, Angraeng mah Mosi patohhaih rang hoiah Israel kaminawk khaeah thuih ih lokpaekhaih hoi lokcaekhaih ah oh.
  </para>
</usx>
