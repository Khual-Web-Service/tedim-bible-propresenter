<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EPH" style="id">Efisa</book>
  <para style="h">Efisa</para>
  <para style="toc1">Efisa</para>
  <para style="toc2">Efisa</para>
  <para style="mt">Efisa</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sithaw koehhaih rang hoiah Jesu Kri mah patoeh ih kami, Pawl mah, Efisa vangpui ah kaom kaciim kaminawk hoi Kri Jesu ah oepthok kaminawk khaeah ca tarik:
  </para>
  <para style="p">
    <verse number="2" style="v" />Angraeng Jesu Kri, aicae Ampa Sithaw khae hoiah tahmenhaih hoi monghaih nangcae khaeah om nasoe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kri rang hoiah van prae Muithla tahamhoihaih aicae han kapaek Sithaw hoi aicae Angraeg Jesu Kri ampa khaeah tahamhoihaih om nasoe,
  </para>
  <para style="p">
    <verse number="4" style="v" />amlunghaih rang hoiah Sithaw hmaa ah ciimcai moe, coek koi kaom ai ah a oh o thai hanah, aicae loe Anih mah long om ai naah Kri ah qoih boeh,
  </para>
  <para style="p">
    <verse number="5" style="v" />a koehhaih baktih toengah, Jesu Kri rang hoiah Angmah khaeah a caa ah ohsak hanah, aicae kawng to canghnii hoiah a thuih coek boeh,
  </para>
  <para style="p">
    <verse number="6" style="v" />A tahmenhaih hoi lensawkhaih pakoeh hanah, palung ih a Capa rang hoiah aicae to talawk boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kathuk a tahmenhaih baktih toengah, anih ih athii rang hoiah angmah ah akranghaih hoi zae tahmenhaih to a hnuk o;
  </para>
  <para style="p">
    <verse number="8" style="v" />A tahmenhaih, palunghahaih hoi panoekhaihnawk to paawt ai ah aicae nuiah a kraih boih.
  </para>
  <para style="p">
    <verse number="9" style="v" />A koehhaih hoi angmah ah khokhanhaih baktih toengah, kathuk angmah ih atimhaih to aicae hanah amtuengsak boeh:
  </para>
  <para style="p">
    <verse number="10" style="v" />dung kroekhaih akoep naah, Anih mah van ih hmuen hoi long ih hmuennawk boih, Kri ah maeto omsak tih:
  </para>
  <para style="p">
    <verse number="11" style="v" />hmuennawk boih a koehhaih baktiah sahkung loe, atimhaih a tawnh baktih toengah, aicae loe anih rang hoiah qawk a hnuk o boeh, tiah canghnii hoiah a thuihcoek boeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kri ah oephaih tawn hmaloe aicae loe a lensawkhaih pakoeh kami ah a om o tih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Loktang lok ah kaom, nangcae pahlonghaih kahoih tamthanglok na thaih o pacoengah ni, nangcae mah doeh anih tanghaih to na tawnh o: anih to na tang o boeh pongah, nangcae loe lokkamhaih kacai Muithla hoiah catui daeng boeh,
  </para>
  <para style="p">
    <verse number="14" style="v" />A lensawkhaih pakoeh hanah, lokkam ih Kacai Muithla loe, a qan ih hmuen akranghaih pha ai karoek to, aicae qawktoephaih caksakung ah oh.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah Angraeng Jesu tanghaih rang hoiah kaciim kaminawk boih na palung o ti, tiah ka thaih naah,
  </para>
  <para style="p">
    <verse number="16" style="v" />nangcae han boeng ai ah kawnhaih lawk ka thuih, nangcae han lawkthuih ka pahnet ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aicae Angraeng Jesu Kri ih Sithaw, lensawk Ampa mah, anih panoekhaih hoi palunghahaih muithla ang paek o thai hanah, lawk ka thuih:
  </para>
  <para style="p">
    <verse number="18" style="v" />oep kaom anih kawkhaih to na panoek o thaih han, nangcae ih palung mik aangsak moe, kaciim kaminawk mah toep han ih lensawk qawk to na panoek o thai han hoi,
  </para>
  <para style="p">
    <verse number="19" style="v" />kalen a thacakhaih hoiah toksak baktih toengah, aicae tangcaanawk khaeah kalen parai a thacakhaih amtuengsak hanah,
  </para>
  <para style="p">
    <verse number="20" style="v" />to thacakhaih mah Kri ah toksak naah, Anih to duekhaih thung hoiah pathawk moe, Anih to van prae ah Angmah ih bantang bangah anghnutsak:
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih loe hmuennawk boih ranui ah angraenghaih, akaa tawnhaih, thacakhaih hoi ukhaih to tawnh, hae long nuiah khue ai, angzo han koi long ah doeh ahmin paek ih ahminnawk boih ranui ah oh,
  </para>
  <para style="p">
    <verse number="22" style="v" />hmuennawk boih a khok tlim ah a suek moe, kricaabu boih ih lu ah ohhaih to anih khaeah paek boeh,
  </para>
  <para style="p">
    <verse number="23" style="v" />to kricaabu loe tih boih boih, hmuennawk boih hoiah kakoi anih akoephaih angmah ih takpum ah oh.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nangcae sakpazaehaih hoi zaehaih thungah na duek o naah anih mah ang pathawk o;
  </para>
  <para style="p">
    <verse number="2" style="v" />canghniah loe hae long atawk baktih, takhi ukkung angraeng koehhaih baktiah na oh o, to muithla loe vaihi doeh lok tahngai ai kaminawk khaeah toksak:
  </para>
  <para style="p">
    <verse number="3" style="v" />canghniah loe aicae boih doeh tang ai kaminawk salakah taksa koehhaih baktiah a sak o toeng, taksa hoi palung mah koeh ih baktih toengah a sak o; kalah kaminawk baktiah, aicae doeh taksa ah palungphuihaih katongh kami ah a oh o.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toe palungnathaih hoiah kakoi, Sithaw mah kathuk parai angmah ih amlunghaih hoiah aicae to palung pongah,
  </para>
  <para style="p">
    <verse number="5" style="v" />zae thungah a duek o naah, Kri hoi nawnto aicae to hingsak let boeh, (tahmenhaih rang hoiah ni pahlong ah na oh o;)
  </para>
  <para style="p">
    <verse number="6" style="v" />Anih mah aicae nawnto pathawk moe, Kri Jesu rang hoiah van ahmuen ah aicae han anghnuthaih ahmuen to paek boeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anih mah Kri Jesu rang hoiah angzo han koi adung ah, a palungnathaih hoi kathuk parai tahmenhaih to amtuengsak tih.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangcae loe tahmen pongah, tanghaih rang hoiah, pahlong ah na oh o; nangmacae koehah hak ih na ai ni: Sithaw ih tangqum ni:
  </para>
  <para style="p">
    <verse number="9" style="v" />toksakhaih rang hoiah hak ih na ai ni, to tiah nahaeloe mi kawbaktih doeh amoek han om ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmuen kahoih a sak o thai hanah, Kri Jesu ah sak ih kami ah a oh o moe, a ban thung hoi tacawt kami ah a oh o, to baktih kahoih hmuen thungah a caeh o thai hanah, Sithaw mah paroep coek boeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />To pongah nangcae loe canghniah taksa ah Gentel kami ah na oh o, taksa ah ban hoi tangzat hin aat kaminawk mah, tangzat hin aat ai kami, tiah ang kawk o ih lok to poek oh;
  </para>
  <para style="p">
    <verse number="12" style="v" />to nathuem ah Kri na tawn o ai vop, Israel kaminawk khaeah angvin ah na oh o pongah, lokkamhaih thungah kaom lokmaihaih thung hoiah doeh angvin ah na oh o; long nuiah Sithaw tawn ai ah na oh o moe, oephaih tawn ai kami ah na oh o:
  </para>
  <para style="p">
    <verse number="13" style="v" />canghniah kangthla ah kaom nangcae loe vaihi Kri ih athii rang hoiah Kri Jesu ah kanghnai ah na oh o boeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih loe aicae misa angdaehhaih ah oh, aicae salakah kaom pakaa ih tapang to phraek moe, hnetto to maeto ah a sak boeh;
  </para>
  <para style="p">
    <verse number="15" style="v" />a taksa ah misa ah kaom, toksak han kangaih kaalok hoi atawknawk to a phraek; Angmah ah acaeng hnetto to kangtha acaeng maeto ah a sak, to tiah misa angdaehaih to a sak;
  </para>
  <para style="p">
    <verse number="16" style="v" />thinglam rang hoiah acaeng hnetto to takpum maeto ah a sak, Sithaw khaeah to tiah angdaehhaih to a sak hmaek moe, misa ah ohhaih to a dueksak:
  </para>
  <para style="p">
    <verse number="17" style="v" />Anih loe kangthla ah kaom nangcae khae hoi kazoi ah kaom kaminawk khaeah angzoh moe, angdaehhaih tamthanglok to thuih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anih rang hoiah aihnik loe Muithla maeto ah Ampa khae akun thaihaih a tawn hoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />To pongah nangcae loe vaihi acaeng kalah kami hoi angvin ah na om o ai boeh, prae kami hoi kaciim kami, Sithaw imthungah kaom kami ah ni na oh o boeh;
  </para>
  <para style="p">
    <verse number="20" style="v" />nangcae loe patoeh ih kaminawk hoi tahmaanawk nuiah sak ih im ah ni na oh o boeh, Jesu Kri angmah loe im takii ah tling ih kalen koek thlung ah oh,
  </para>
  <para style="p">
    <verse number="21" style="v" />im boih thlung hoi nawnto peh moe, Angraeng ah qoeng tahang pongah, kacai tempul maeto ah oh:
  </para>
  <para style="p">
    <verse number="22" style="v" />Muithla ah kaom Sithaw ohhaih ahmuen ah oh thai hanah, nangcae doeh kaicae hoi nawnto im to na sak o toeng.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hae pongah ni kai Pawl mah nangcae Gentelnawk hanah Kri Jesu ih thongim krah kami ah ka oh,
  </para>
  <para style="p">
    <verse number="2" style="v" />nangcae atho oh thai hanah kai khaeah paek ih Sithaw tahmenhaih to na thaih o boeh:
  </para>
  <para style="p">
    <verse number="3" style="v" />to tamqulok loe hnuksakhaih hoiah Anih mah kai khaeah amtuengsak; (canghniah ca setta kang tarik o baktih toengah,
  </para>
  <para style="p">
    <verse number="4" style="v" />to ca to na kroek o naah, Kri ih tamqulok ka panoekhaih to na thaih o kop tih,)
  </para>
  <para style="p">
    <verse number="5" style="v" />to tamqulok loe canghnii dung ih kami capanawk khaeah amtuengsak ai, toe Muithla rang hoiah angmah patoeh ih kaciim kaminawk hoi tahmaanawk khaeah vaihi amtuengsak boeh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Gentelnawk loe qawktoep ampui, takpum maeto ah om o ueloe, kahoih tamthanglok rang hoiah Kri ah a lokkamhaih thungah kathum kami ah om o tih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thacak a toksakhaih rang hoiah kai khaeah paek ih Sithaw tahmenhaih tangqum baktih toengah ni, toksah kami maeto ah ka oh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gentel kaminawk khaeah pakrong laek thai ai Kri angraenghaih ka thuih thai hanah, kaciim kaminawk boih thungah kathoeng koek, kai khaeah hae tahmenhaih hae ang paek;
  </para>
  <para style="p">
    <verse number="9" style="v" />to pacoengah Jesu Kri rang hoiah hmuennawk boih sahkung, long amtong tangsuek nathuem hoi Sithaw ah hawk ih hae kathuk toksak atimhaih hae kaminawk boih mah panoek o moe,
  </para>
  <para style="p">
    <verse number="10" style="v" />van ukkung angraeng hoi akaa tawn kaminawk mah doeh kricaabu rang hoiah Sithaw palunghahaih hoi sak atimhaih to vaihi panoek o thai hanah, to tahmenhaih to kai khaeah ang paek,
  </para>
  <para style="p">
    <verse number="11" style="v" />dungzan sak atimhaih a tawnh baktih toengah, to sak atimhaih to anih mah aicae Angraeng Kri Jesu rang hoiah koepsak boeh:
  </para>
  <para style="p">
    <verse number="12" style="v" />Anih a tang o haih rang hoiah Sithaw khaeah misahoihaih hoi anghnai thaihaih to a tawnh o.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah nangcae pakoeh ah na oh o thai hanah, nangcae han patang ka khang naah, tha na zok o han ai kang koeh o haih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hae pongah aicae Angraeng Jesu Kri Ampa khaeah khokkhu ka cangkrawn,
  </para>
  <para style="p">
    <verse number="15" style="v" />van hoi long ah kaom imthung takoh ahmin boih loe Anih khae hoiah ni a lak o,
  </para>
  <para style="p">
    <verse number="16" style="v" />kalen parai a lensawkhaih baktih toengah, nangcae han hmuen ang paek o moe, angmah ih Muithla thacakhaih rang hoiah a thung ih kami to tha a caksak;
  </para>
  <para style="p">
    <verse number="17" style="v" />tanghaih rang hoiah nangcae palung thungah Kri oh thai hanah, amlunghaih ah tling moe, tangzun to caksak,
  </para>
  <para style="p">
    <verse number="18" style="v" />kaciim kaminawk baktiah kalen, kakawk, kathuk, kasang loe tih maw, tito na panoek o thaih moe,
  </para>
  <para style="p">
    <verse number="19" style="v" />panoekhaih mah pha thai ai ih Kri amlunghaih to panoek pacoengah, Sithaw akoephaih boih hoi na koi o thai hanah, lawk ka thuih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aicae mah hnik moe, a poek o haih boih pongah kamthlai ah sah thaih Sithaw loe, a thacakhaih hoiah aicae thungah toksak baktih toengah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Kri Jesu rang hoiah Anih hoi kricaabu khaeah dungzan khoek to tahamhoihaih om poe nasoe. Amen.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kawk ih kami ah na oh o baktih toengah, kawk ih kami hoi kamcuk ah kho na sak o hanah, Angraeng pongah thongkrah kami, Kai mah kang pacae o,
  </para>
  <para style="p">
    <verse number="2" style="v" />hmuen boih ah, minawk tlim ah khosakhaih, poeknaemhaih hoi palungsawkhaih to tawn oh loe, maeto hoi maeto amlunghaih hoiah khosah oh;
  </para>
  <para style="p">
    <verse number="3" style="v" />Muithla ah poekhaih maeto amhong thai hanah tha pathok oh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Oephaih maeto tawnh hanah nangcae to kawk baktih toengah, takpum maeto hoi Muithla maeto ni oh;
  </para>
  <para style="p">
    <verse number="5" style="v" />Angraeng maeto, tanghaih maeto, tuinuemhaih maeto,
  </para>
  <para style="p">
    <verse number="6" style="v" />kaminawk boih ih Ampa, Sithaw maeto khue ni oh, anih loe aicae boih ranui ah oh, kami boih khaeah oh moe, nangcae boih thungah oh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toe Kri ih tangqum paekhaih baktih toengah, tahmenhaih loe aicae boih khaeah paek boeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />To pongah ni Anih ranui bangah caeh tahang naah, misong ah kaom kaminawk to a zaeh moe, kaminawk khaeah tangqumnawk to paek, tiah a thuih.
  </para>
  <para style="p">
    <verse number="9" style="v" />(Anih caeh tahang, tiah thuih naah, anih loe long thung ih kahnaem koek ahmuen ah anghum tathuk hmaloe, tiah doeh thuih koehhaih ih na ai maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Anghum tathuk kami loe, hmuen boih koepsak hanah, van boih ranui koekah daw tahang kami to thuih koehhaih ih ni.)
  </para>
  <para style="p">
    <verse number="11" style="v" />Anih mah thoemto kaminawk to patoeh ih kami, thoemto kaminawk to tahmaa, thoemto kaminawk to tamthanglok taphong kami, thoemto kaminawk to kricaa zaehoikung hoi patukkung ah paek:
  </para>
  <para style="p">
    <verse number="12" style="v" />kaciim kaminawk toksak akoep moe, Kri takpum a qoeng o sak thai hanah,
  </para>
  <para style="p">
    <verse number="13" style="v" />aicae boih tanghaih hoi Sithaw Capa panoekhaih bangah maeto ah amhong moe, Kri akoephaih tawn kami maeto ah a pha o ai karoek to om tih;
  </para>
  <para style="p">
    <verse number="14" style="v" />aicae loe aling thaih kaminawk mah, aling thai hanah patuk ih loknawk pongah, takhi mah hmuh naah ahnuk ahmaa kangthui nawktanawk baktiah a oh o han om ai,
  </para>
  <para style="p">
    <verse number="15" style="v" />toe tih boih ah lu ah kaom, Kri hoi kangvan ah a qoeng o thai hanah, amlunghaih hoiah loktang lok thui kami ah a oh o han oh boeh:
  </para>
  <para style="p">
    <verse number="16" style="v" />Anih khae hoiah ni takpum boih nawnto amcong moe, kamtomh ahuhnawk boih doeh thacaksak, takpum ah kaom tanghangnawk boih mah angmacae ih tok a sak o boih baktih toengah, takpum to amlunghaih bangah a qoeng o sak tahang.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah Angraeng rang hoiah hae tiah lok ka thuih, vaihi hoi kamtong tiah doeh angcoeng ai, Gentelnawk caehhaih baktiah caeh o hma lai ah,
  </para>
  <para style="p">
    <verse number="18" style="v" />nihcae panoekhaih loe khoving baktiah tahmuep moe, panoekhaih tawn o ai, palung mik a maeng o pongah, Sithaw hinghaih hoiah amkhraeng o ving boeh:
  </para>
  <para style="p">
    <verse number="19" style="v" />nihcae loe azathaih tawn o ai, taksa koehhaih bangah thacak o parai moe, long taksa koeh hmoekhaih palung tawnh o pongah, kaciim ai hmuennawk boih to a sak o.
  </para>
  <para style="p">
    <verse number="20" style="v" />To baktih hmuen to Kri khae hoiah nam tuk o ai;
  </para>
  <para style="p">
    <verse number="21" style="v" />Anih kawng to na thaih o boeh, loktang loe Jesu ah ni oh, tiah anih mah ang patuk o boeh:
  </para>
  <para style="p">
    <verse number="22" style="v" />canghnii ih aling koehhaih palungthin hoiah kamro kangquem hinghaih to angkhring oh loe,
  </para>
  <para style="p">
    <verse number="23" style="v" />Muithla ah poekhaih palungthin to angtha o sak ah;
  </para>
  <para style="p">
    <verse number="24" style="v" />toenghaih hoi loktang ciimcaihaih bangah, Sithaw ah sak ih kami kangtha to angkhuk oh.
  </para>
  <para style="p">
    <verse number="25" style="v" />To pongah lok amlaihaih to takhoe oh, aicae loe takpum maeto hoi kaom tanghang ah a oh o pongah, kami boih mah a imtaeng kami khaeah loktang lok to thuih han oh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Palung na phui o, toe zaehaih sah o hmah: palung na phuihaih loe niduem hmah nasoe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Setan hanah ahmuen pahoe pae o hmah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Paqu kami loe paqu hma lai nasoe: toksah nasoe loe, amtang kaminawk abom hanah, kahoih hmuen to a ban hoiah sah nasoe.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na pakha thung hoiah loksae tacawt hmah nasoe, tahngai kaminawk atho oh thai hanah, atho kaom lok to patoh oh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sithaw ih Kacai Muithla to palungsae o sak hmah, Anih hoiah ni akranghaih ni karoek to hanah catui ang daeng o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hnukmahaih, poek amthuenghaih, palungphuihaih, hraw-anghaih, loksethaih hoi uthaihnawk boih to nangmacae khae hoiah takhoe o ving ah:
  </para>
  <para style="p">
    <verse number="32" style="v" />maeto hoi maeto nuiah tahmenhaih hoi amlunghaih to tawn oh, Kri ah Sithaw mah ang tahmen o baktih toengah, nangcae doeh maeto hoi maeto tahmenhaih tawn oh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />To pongah Sithaw mah palung ih caa ah na oh o baktih toengah, Sithaw hnukbang kami ah om oh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Kri mah aicae ang palung moe, Sithaw khaeah hmuihoih ah oh hanah, angmah hoi angmah aicae angbawnhaih ah angpaek boeh, to pongah nangcae doeh amlunghaih hoiah khosah oh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaciim kami ah na oh o boeh pongah, zae sakhaih, ciimcai ai hmuen hoi kamthlai hmoek koehhaihnawk nangcae thungah oh han om ai boeh;
  </para>
  <para style="p">
    <verse number="4" style="v" />amhnonghaih, kamthu lok apaehhaih hoi tamhnui lok sakhaihnawk loe kamsoem hmuen na ai ni, to baktih hmuen sak pongah loe kawnhaih lok to thui o lat ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nongpa nongpata zaehaih sah kami, ciimcai ai kami, kamthlai hmoek koeh kami, krang bok kaminawk loe Kri hoi Sithaw mah siangpahrang ah uk ih prae to toep o thai mak ai, tito na panoek o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi kawbaktih mah doeh avang ai lok hoiah na ling o hmah nasoe: to baktih hmuen pongah ni lok tahngai ai kaminawk nuiah Sithaw palungphuihaih to phak.
  </para>
  <para style="p">
    <verse number="7" style="v" />To pongah nangcae loe nihcae hoi angkom o hmah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangcae loe canghnii ah vinghaih thungah na oh o, toe vaihi loe Angraeng pongah aanghaih ah na oh o boeh: to pongah aanghaih caanawk baktiah khosah oh:
  </para>
  <para style="p">
    <verse number="9" style="v" />(hoihhaih, toenghaih hoi loktangnawk boih loe Muithla ih thingthai ah ni oh;)
  </para>
  <para style="p">
    <verse number="10" style="v" />Angraeng mah talawk thai koi hmuen to pakrong oh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Athaih kaom ai kaving toksakhaih hoiah angkom o hmah, toe to baktih kaving toksakhaih to amtueng o sak ah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nihcae mah tamquta hoi sak o ih hmuennawk to lok hoi thuih han ih mataeng doeh azat thoh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toe to tiah kamtueng hmuennawk loe kawbaktih hmuen maw, tito aanghaih mah ni amtuengsak: hmuennawk boih amtuengsakkung loe aanghaih hae ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anih mah, Aw iip kami nang anglawt laih, duekhaih thung hoi angthawk ah, to tih nahaeloe Kri mah aanghaih to na paek tih, tiah thuih.
  </para>
  <para style="p">
    <verse number="15" style="v" />To pongah acoehaih hoiah khosah oh, kamthu baktiah om ai ah, palungha baktiah om oh,
  </para>
  <para style="p">
    <verse number="16" style="v" />aninawk loe hoih ai boeh pongah, atue kahoih to paawt ah.
  </para>
  <para style="p">
    <verse number="17" style="v" />To pongah kamthu baktiah om o hmah, Angraeng koehhaih panoek kami ah om oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mu paqui o hmah, to tiah ohhaih mah sethaih to tacawtsak, to pongah Muithla hoi koi oh;
  </para>
  <para style="p">
    <verse number="19" style="v" />maeto hoi maeto Saam laa, pakoehhaih laa hoi Muithla laa to sah oh, palung thung hoi Angraeng khaeah laa to sah oh;
  </para>
  <para style="p">
    <verse number="20" style="v" />hmuen boih ah aicae Angraeng Jesu Kri ih ahmin hoiah Pa Sithaw khaeah anghoehaih lawkthui o toepsoep ah;
  </para>
  <para style="p">
    <verse number="21" style="v" />Sithaw zithaih hoiah maeto hoi maeto tlim ah khosah oh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zunawk, Angraeng khaeah nang paek o baktih toengah, na savanawk khaeah angpaek oh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kri loe kricaabu lu ah oh baktih toengah, sava loe zu ih lu ah oh: Anih loe takpum pahlongkung ah oh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kricaabu mah Kri khaeah angpaek baktih toengah, zunawk mah doeh hmuen boih ah angmacae sava khaeah angpaek o nasoe.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kri mah kricaabu palung moe, hinghaih paek baktih toengah, savanawk, na zu to palung oh;
  </para>
  <para style="p">
    <verse number="26" style="v" />Anih mah kricaabu to tui hoiah pasae ueloe, lok hoiah ciimsak tih,
  </para>
  <para style="p">
    <verse number="27" style="v" />coek koi kaom ai, nganhin angcu ai, to tiah coek han koi tidoeh kaom ai, lensawk kricaabu maeto ah angmah khaeah paek thai hanah, coek koi kaom ai, ciimcai kricabu ah oh han angaih.
  </para>
  <para style="p">
    <verse number="28" style="v" />To pongah nongpanawk mah a zunawk to angmacae ih takpum baktih toengah palung han oh. Azu palung kami loe angmah hoi angmah amlung kami ah oh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi kawbaktih mah doeh angmah ih takpum to hnuma vai ai; Angraeng mah kricaabu khetzawn baktih toengah ni, a takpum to pacah moe, a khetzawn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aicae loe angmah ih takpum, angan, ahuh thungah kathum kami ah ni a oh o.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hae pongah nongpa mah amno hoi ampa to caehtaak ueloe, a zu hoi nawnto om tih, to naah nihnik loe takpum maeto ah ni om hoi tih boeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hae loe kalen loktamqu ah oh: toe kai loe, Kri hoi kricaabu kawng ni ka thuih.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toe nangmacae takpum na palung o baktih toengah, na zunawk to palung o toeng ah; zu mah doeh sava to khingya han oh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nawktanawk, Angraeng ah nam no hoi nam pa ih lok to tahngai oh: amno ampa lok tahngaihaih loe katoeng hmuen ah oh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nam no hoi nam pa to saiqat ah; hae loe lokkamhaih hmaloe koekah oh;
  </para>
  <para style="p">
    <verse number="3" style="v" />to tiah na sak nahaeloe khosak na hoih ueloe, long nuiah na hinglung sawk tih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ampanawk, na caanawk palungphui han sah hmah: Angraeng ah thuitaekhaih hoi patukhaih bangah qoeng o sak ah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tamnanawk, Kri ih lok na tahngaih o baktih toengah, poekhaih amkhraeng ai ah, zithaih hoi tasoehhaih hoiah taksa ah na angraeng ih lok to tahngai oh;
  </para>
  <para style="p">
    <verse number="6" style="v" />minawk palung tongh hanah, minawk mikhnuk ah khue sah o hmah; Kri ih tamna ah na oh o baktih toengah, Sithaw koehhaih to palung thung hoiah sah oh;
  </para>
  <para style="p">
    <verse number="7" style="v" />kami ih toksak baktiah poek ai ah, Angraeng ih toksak baktiah, palung tang hoiah toksah oh:
  </para>
  <para style="p">
    <verse number="8" style="v" />tamna maw tamna ai, kami boih mah a sak o ih kahoih hmuen baktih toengah, Angraeng khae hoiah tangqum to hnu o tih, tito panoek oh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Angraengnawk, na tamnanawk khaeah to tiah sah oh, nangcae ih angraeng doeh van ah oh, tiah panoek oh loe, tamnanawk to pazih o hmah: Anih loe kami mikhmai khethaih tawn ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nawkamyanawk, hnukhuem koekah loe anih thacakhaih hoiah Angraeng ah thacak o sak ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Setan zoekhaih na pakaa o thai hanah, Sithaw ih aphawnawk to angkhuk oh,
  </para>
  <para style="p">
    <verse number="12" style="v" />aicae loe taksa hoi athii kaom misa to a tuh o ai, sakthaihaih akaa katawn, ukkungnawk, hae long vinghaih ukkungnawk hoi kasang ahmuen ah kaom kasae muithlanawk ni a tuk o.
  </para>
  <para style="p">
    <verse number="13" style="v" />To pongah Sithaw ih aphaw to angkhuk oh, to tiah ni kahoih ai ni angzoh naah na pakaa o thai ueloe, misa tuk pazawk boih karoek to nang doe o thai tih.
  </para>
  <para style="p">
    <verse number="14" style="v" />To pongah loktang to kaengkaeh ah angzaeng oh loe, toenghaih to saoek padaphaih ah angkhuk oh;
  </para>
  <para style="p">
    <verse number="15" style="v" />taphong han paroep ih angdaehhaih tamthanglok hoih to khokpanai bum ah abuen oh,
  </para>
  <para style="p">
    <verse number="16" style="v" />to hmuennawk boih pacoengah, pakaahaih ah kaom tanghaih to angkhuk oh, to tiah ni taqawk mah kah ih hmai kamngaeh palaanawk to na paduek o thai boih tih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pahlonghaih sum lumuek hoi Muithla sumsen ah kaom, Sithaw lok to angnaengh oh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lawkthuih hoi hnikhaih, lawkthuihaih congca hoiah Muithla ah lawkthui o toepsoep ah; lawkthuih thazok ai ah, kaciim kaminawk boih hanah lawk to thui oh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tamthanglok hoih taphonghaih kai khaeah ang paek baktih toengah, misahoihaih hoiah pakha angh moe, kathuk tamthanglok hoih to ka thuih thai hanah, kai han doeh lawk na thui pae o toeng ah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka thuih han koi lok to, misahoihaih hoiah ka thuih han ih ni, kai loe sumqui hoi pathlet ih laicaeh ah ka oh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kai loe kawbangmaw ka oh, timaw ka sak, tito na panoek o hanah, Angraeng ah oep kathok toksah kamnawk, Tukika mah, hmuennawk boih na thui o tih:
  </para>
  <para style="p">
    <verse number="22" style="v" />kaicae khosakhaihnawk na panoek o moe, nangcae pathloep thai hanah, anih to kang patoeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angraeng Jesu Kri hoi Ampa Sithaw khae ih monghaih, tanghaih hoi amlunghaih to nawkamyanawk khaeah om nasoe.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aicae Angraeng Jesu kri palunghaih tawn tangtang kaminawk boih khaeah tahmenhaih om nasoe. Amen.
  </para>
</usx>
