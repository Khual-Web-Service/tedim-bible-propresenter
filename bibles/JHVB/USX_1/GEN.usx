<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Ningpawt Ninghpang</book>
  <para style="h">Ningpawt Ninghpang</para>
  <para style="toc1">Ningpawt Ninghpang</para>
  <para style="toc2">Ningpawt Ninghpang</para>
  <para style="mt">Ningpawt Ninghpang</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shawng ningpawt e Karai Kasang gaw sumsing lamu hte ginding aga hpe hpan da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ginding aga chyawm gaw akrin ayang re ai hte asan awan rai nga ai; nsin mung sung ai shara e sin up nga ai rai nna, Karai Kasang a Wenyi gaw hka hpung ni a ntsa e ahpum nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Karai Kasang gaw, “Ahtoi tai wa u ga,” ngu wu ai rai nna, ahtoi tai wa ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai ahtoi kaja nga ai gaw Karai Kasang mu wu ai: shaloi Karai Kasang gaw ahtoi hte nsin hpe karan jahka wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw dai ahtoi hpe, “Shani,” dai nsin hpe, “Shana,” ngu nna, shamying wu ai. Shaloi shana hte jahpawt gaw, nhtoi langai ngu na hta tai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai Karai Kasang gaw, “Hka hpungnung a ka-ang e lamu madin din nna, hka hte hka karan u ga,” nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi Karai Kasang gaw dai lamu madin a kata e nga ai hka hte lamu madin ntsa e nga ai hka hpe karan da wu ai: dai mung shing rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang gaw dai lamu madin hpe, “Sumsing lamu,” ngu nna shamying wu ai. Shaloi shana hte jahpawt gaw, ni ni nhtoi hta tai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai Karai Kasang gaw, “lamu kata e nga ai hka hpung ni, shara mi hta shinggyin hpawng nga nna hkarang ga dawng pru u ga,” nga ai: dai mung shing rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang gaw dai hkarang hpe, “Aga,” shinggyin hpawng nga ai hka hpung ni hpe, “Nammukdara,” ngu nna shamying wu ai: dai kaja nga ai gaw Karai Kasang mu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Karai Kasang gaw, “Aga gaw, tsingdu tsingman hpe mung, nsi naisi li rawng ai nai mam chyakai hpe mung, ga ntsa e tinang nang a nli rawng ai hte tinang amyu a asi si ai namsi namsaw hpun hpe mung shatut u ga,” nga ai: dai mung shing rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi dai aga gaw, tsingdu tsingman hpe mung, tinang amyu hta nli rawng ai nai mam chyakai hpe mung, tinang amyu hta nli rawng nna si si chye ai hpun hpe mung shatut wu ai: dai kaja nga ai gaw Karai Kasang mu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi shana hte jahpawt gaw masum ya nhtoi hta tai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai Karai Kasang gaw, “Shani hte shana hpe karan ginhka na matu, sumsing lamu a madin hta e ahtoi hkum tai nga mu ga; dai ni gaw kumla tai na matu mung, duhkra ladaw a matu mung, shani nhtoi hte shaning nhtoi a ladaw langa matu mung, tai nga mu ga;
  </para>
  <para style="p">
    <verse number="15" style="v" />ginding aga ntsa e htoi ya nga na matu, dai ni gaw sumsing lamu a madin hta e ahtoi hkum tai nga mu ga,” nga ai: dai mung shing rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai Karai Kasang gaw, dai ahtoi hkum kaba lahkawng galaw wu ai: ahtoi hkum kaba gaw shani hpe up na matu, ahtoi hkum kaji gaw shana hpe up na matu rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shagan ni hpe mung shi galaw wu ai. Ga ntsa e htoi ya nga na matu mung, shani hte shana hpe up nga na matu mung, ahtoi hte nsin hpe karan ginhka na matu mung,
  </para>
  <para style="p">
    <verse number="18" style="v" />Karai Kasang gaw dai ni hpe sumsing lamu a madin hta e tawn da wu ai: dai kaja nga ai gaw Karai Kasang mu wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi shana hte jahpawt gaw mali ya nhtoi hta tai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Karai Kasang gaw, “Nsoi nsa rawng nna, hkrung ai baw wunawng wuwa gaw hka hpung ni hta kanawng nga nna, u ni mung sumsing lamu a madin npu, ginding aga a ntsa malen e pyen nga mu ga,” nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi Karai Kasang gaw, nammukdara na nga kaba hpe mung, hka e kanawng nga ai nsoi nsa rawng nna shamu shamawt chye ai amyu shagu hpe mung, hpan da wu ai: dai kaja nga ai gaw Karai Kasang mu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai Karai Kasang gaw, “Nanhte kasha ja nna mayat maya wa ai hte nammukdara hka hta hpring wa mu; ntsa malen u ni mung ga ntsa e law htam wa mu ga,” ngu nna shanhte hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi shana hte jahpawt gaw manga ya nhtoi hta tai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bai Karai Kasang gaw, “Aga gaw, tinang nang amyu hta nsoi nsa rawng ai baw, yamnga mung, gumrawt hkawm ai baw hpe mung, ga ntsa na dusat nhprang amyu myu hpe mung shapraw u ga,” nga ai: dai mung shing rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai Karai Kasang gaw, ga ntsa na dusat nhprang amyu myu, yamnga amyu myu, ga e gumrawt hkawm ai baw amyu myu hpe mung galaw wu ai: dai kaja nga ai gaw Karai Kasang mu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai Karai Kasang gaw, “Anhte gaw, anhte a hkrang sumla hte anhte a asam hte bung ai, shinggyim masha hpan ga: shanhte gaw, nammukdara hta rawng ai nga ni a ntsa e mung, lamu kata na ntsa malen e pyen ai u ni a ntsa e mung, yamnga ni a ntsa e mung, ga ting a ntsa e mung, ga ntsa e gumrawt hkawm ai baw mahkra a ntsa e mung up nga mu ga,” nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shing rai Karai Kasang gaw shi a hkrang sumla hte maren, Karai Kasang gaw shi hpe hpan da wu ai: shinggyim lasha hte shinggyim numsha hpe shi hpan da wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi Karai Kasang gaw shan hpe tsun mu ai gaw, “Nan kashu kasha shaprat nna mayat maya wa mu; ga ting hpe jahpring nna dai hpe up nga lu mu: nammukdara hta rawng ai nga ni a ntsa e mung, lamu kata na ntsa malen e pyen ai u ni a ntsa e mung, ga ntsa e nsoi nsa rawng ai shamu shamawt chye ai baw mahkra a ntsa e mung a up nga mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai Karai kasang gaw, “yu mu, ga ntsa ting hta nsi naisi li rawng ai nai mam amyu shagu mung, ngai nanhte hpe jaw made ai; dai gaw nanhte a matu lusha shahpa tai nga na rai nga ai:
  </para>
  <para style="p">
    <verse number="30" style="v" />dai hta kaga, ga ntsa na ashu ashan mahkra a matu mung, lamu kata na ntsa malen e pyen ai u ni mahkra a matu mung, ga ntsa e nsoi nsa rawng ai gumrawt hkawm ai baw mahkra a matu mung, sha na ushat tsit lali ai namlaw namlap tsingdu tsingman amyu myu ngai jaw da we ai,” nga ai: dai mung shing rai nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Karai Kasang gaw shi hpan hpajang da ai amu yawng mayawng hpe yu yu nna, yu mu dai gaw nachying kaja nga ai. Shaloi shana hte jahpawt gaw kru ya nhtoi hta tai ma ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shing rai sumsing lamu hte ginding aga gaw, tinang nang a zaw nawng zaw wa yawng hte hte nawng ngut nga masai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang gaw sanit ya nhtoi hta e shi galaw ai amu magam hpe shangut wu ai: shi galaw nu ai amu mahkra ngut masai rai nna, dai sanit ya nhtoi hta ban nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna Karai Kasang gaw dai sanit ya nhtoi hpe shaman wu ai hte dai hpe shachyoi shapra wu ai: kaning rai nme law, Karai Kasang gaw shi hpan hpajang da nna galaw nu ai amu magam mahkra ngut ma nna, dai shani hta e laban nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ndai hte gaw, Yehowa Karai Kasang ginding aga hte sumsing lamu hpe galaw ai nhtoi na, sumsing lamu hte ginding aga hpan hpajang da ai lam a ahtik ni rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ginding aga ntsa na ga nhprang hta anaw anam matut langai mi muk garai n tu ai, ga na nsi naisi, shatmaw shatmai matut langai mi muk garai n tu ai: kaning rai nme law, Yehowa Karai Kasang gaw ga ntsa e marang garai n jahtu wu ai hte, aga hpe yu lajang na masha mung garai n nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rai timung ga na saiwan rawt nna aga ntsa ting hpe madit nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi Yehowa Karai Kasang gaw aga hta na ga yun hte shinggyim hkrang shachyaw wu ai rai nna, shi a ladi hta hkrung ai nsoi nsa kawut bang ya wu ai: dai rai nna shinggyim masha gaw hkrung nga ai myit masin rawng ai masha tai wa ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Yehowa Karai Kasang gaw, sinpraw maga na Edin ngu ai shara e sun langai mi hkai sharam tawn wu ai: dai kaw e shi shachyaw ai shinggyim masha hpe nga shangun da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Yehowa Karai Kasang gaw yu chyoi ai hte sha na matu mai kaja ai hpun amyu myu hpe, ga hta nna tu shangun wu ai: dai sun a ka-ang e asak jahkrung jaw ai hpun hte, kaja ai hte n kaja ai chye ginhka shangun ai hpun mung tu nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai sun hpe madit na matu mung Edin kaw nna hka nu langai mi lwi pru wa ai; dai hka nu gaw dai kaw na bra nna hka gai mali tai wa ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Langai ngu na hka gai a mying gaw Pishun rai nga ai: dai gaw ja rawng ai Hawila mung grup rai lwi kawan mat wa ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />dai mung na ja gaw ja kaja rai nga ai: dai yang e badelim hpun naw hte unuk lungseng mung, rawng nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lahkawng ngu na hka gai a amying gaw Gihun rai nga ai: dai gaw Hkusha mung grup rai lwi kawan mat wa ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Masum ngu na hka gai a amying gaw Hidekela rai nga ai: dai gaw Asuri mung sinpraw maga de lwi mat wa ai. Mali ngu na hka gai a amying gaw Uhprat rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Yehowa Karai Kasang gaw dai masha hpe woi la nna, Edin sun hpe yu lajang na hte sin nga na matu, tawn da wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa Karai Kasang dai masha hpe, “Dai sun hta tu ai hpun yawng mayawng hta na gaja wa nang sha lu na ndai:
  </para>
  <para style="p">
    <verse number="17" style="v" />rai timung kaja ai hte n kaja ai hpe chye ginhka shangun ai hpun hta na chyawm gaw, nang n sha lu na ndai: kaning rai nme law, dai hpun hta na sha ai nhtoi hta, nang teng teng si lu na ndai,” ngu nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai Yehowa Karai Kasang gaw, “Dai lasha gaw shi hkrai nga na n mai ai; shi hte ram ai nrum ntau shi a matu ngai galaw na we ai,” nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi Yehowa Karai Kasang gaw nam mali na ashu ashan mahkra hpe mung, ntsa malen pyen ai u mahkra hpe mung, ga hte shachyaw wu ai rai nna, dai ni hpe kaning ngu shamying na chye lu hkra, dai masha wa hpang de woi wa wu ai; dai masha wa mung nsoi nsa rawng ai baw yawng hte hpe amying shingteng jaw wu ai hte maren, tinang nang shingteng amying tai nga malu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi dai masha wa yamnga mahkra hpe mung, ntsa malen pyen ai u mahkra hpe mung, nam mali na dusat nhprang mahkra hpe mung, amying shingteng jaw wu ai: rai timung dai masha wa a matu shi hte ram ai nrum ntau garai n nga lu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai majaw Yehowa Karai Kasang gaw dai masha wa hpe yup kaba hte shayup wu ai rai nna, shi gaw yup pyaw nga ai; shaloi shi a garep nra langai mi shaw la nna dai shara hta ashan hte shatup ya wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai, Yehowa Karai Kasang gaw dai masha wa hta na shaw la ai garep nra hte shinggyim numsha shachyaw wu ai rai nna, dai masha wa kaw woi wa ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi dai masha wa gaw, “Ya, masha ndai gaw, nye a nra hta na nra, nye a ashan hta na ashan rai nga ai: dai majaw shi hpe numsha ngu na rai nga ai; kaning rai nme law, shi gaw lasha hta na shaw la ai rai nga ai,” nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai re ai majaw lasha gaw tinang a kanu kawa hpe kau da nhtawm shi a madu jan hte manoi nga na rai nna, shan lahkawng gaw hkum shan langai sha tai lu na mara ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya dai masha yan la gaw singgu krin nga ma ai rai timung, shan shada n kaya ma ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai lapu gaw, Yehowa Karai Kasang galaw ai nam mali na dusat nhprang mahkra hta hpaji grau rawng nga ai. Shi gaw dai numsha hpe, “Ndai sun hta tu ai hpun mahkra hta na, nan n sha lu na rai myit dai, nga nna Karai Kasang gaja wa tsun a ni?” Ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi dai numsha gaw, “Ndai sun hta tu ai hpun ni a asi hta na an sha lu ga ai;
  </para>
  <para style="p">
    <verse number="3" style="v" />rai timung, ndai sun a ka-ang e tu ai hpun a asi hpe chyawm gaw, Nan si ai n hkrum myit ga, dai hta na nan n sha lu na myit dai, dai hpe mung hkum hkra myit, nga nna Karai Kasang tsun ai,” ngu nna lapu hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna lapu gaw, “Nan gaja wa n si na myit dai:
  </para>
  <para style="p">
    <verse number="5" style="v" />kaning rai nme law, dai hta na sha ai nhtoi hta e nan a myi hpaw nna, kaja ai hte n kaja ai hpe chye ginhka na ra ai majaw, Karai Kasang hte maren nan tai na marin dai gaw, Karai Kasang chye nga ai,” ngu nna dai numsha hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hpun dai gaw sha na matu mai kaja ai mung, myi a matu yu chyoi nga ai mung, hpaji lu la na matu sharawng awng ai hpun rai nga ai mung, dai numsha gaw mu wu jang, dai hpun hta na asi di sha wu ai: madu wa hpe mung shi agaw jaw wu ai rai nna, shi mung sha wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Shaloi shan a myi hpaw malu ai rai nna, singgu krin rai nga ma ai gaw chye ma ai; shaloi shan gaw lakum lap chywi matut nna tinang a matu dangpai galaw ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang shan gaw, shana de bungsoi katsi ai aten e Yehowa Karai Kasang dai sun hta sa hkawm shara nga ai hpe na mu ai; dai majaw Adam hte shi a madu jan gaw, Yehowa Karai Kasang a myi man kaw na makoi lu hkra, dai sun na hpun ni a kata e gawp nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Yehowa Karai Kasang gaw Adam hpe, “Nang kanang nga nga n ta?” Ngu nna shaga wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw, “Ndai sun e na a nsen ngai na nna singgu chyakrin rai nga nngai majaw ngai hkrit nna gawp makoi nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Yehowa Karai Kasang gaw, “Nang singgu chyakrin rai nga ai gaw nang hpe kadai shadum a ta? Ngai, hkum sha, ngu nna jet da ai hpun hta na nang sha kau nu ni?” Ngu wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna Adam gaw, “Ngai hte rau nga na, nang ngai hpe ya ai num gaw, dai hpun hta na ngai hpe di jaw nna ngai sha kau se ai.”
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Yehowa Karai Kasang gaw, dai numsha hpe, “Ndai nang galaw ai gaw, hpa rai nga a ta?” Ngu nna san wu ai; dai numsha gaw, “Ngai hpe lapu e lau nna ngai sha kau se ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai rai nna Yehowa Karai Kasang gaw dai lapu hpe, “Nang ndai galaw ndai majaw, yamnga mahkra hte nam mali na dusat nhprang mahkra hta, nang dagam dala hkrum na ndai; na a kan hte nang hkawm lu na rai nna, nang hkrung nga ai nhtoi mahkra hte hta, ga nhpu sha lu na ndai:
  </para>
  <para style="p">
    <verse number="15" style="v" />nang hte numsha hpe mung, na a amyu matu hte shi amyu matu hpe mung ngai majan shangun da na made ai: shi gaw na a baw abrep na ra ai, nang mung, shi a lahtin achye na ra ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Numsha hpe mung, Na a tsin-yam hte shinggyim machyi ai gaw ngai grau shalaw ya na de ai: shinggyim machyi ai hte nang kashu kasha shangai lu na ndai; na a madu wa hta nang myit manoi nga na ra ai rai nna, shi mung na a ntsa e up nga na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Adam hpe mung, “Na madu jan a ga nang madat nna, ngai, Hkum sha, ngu nna jet da ai hpun hta na nang sha nit dai majaw, aga gaw na a jaw e dingnye hkrum nga ai; nang hkrung nga ai nhtoi mahkra hte hta, ru tsang ai hte, ga hta na nang sha nga lu na ndai;
  </para>
  <para style="p">
    <verse number="18" style="v" />aju hte atsing mung na a matu shi shatut na ra ai; ga na nsi naisi namlaw namlap nang sha nga lu na ndai:
  </para>
  <para style="p">
    <verse number="19" style="v" />ga de na nang hpe shapraw la de ai majaw, ga de nang nhtang wa ai du hkra, na a myi man a salu salat hte na a shat nang sha nga lu na ndai; kaning rai nme law, nang ga yun rai nga ndai rai nna, ga yun bai tai na rin dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Adam gaw shi a madu jan hpe, “Ewa,” ngu nna shamying wu ai; kaning rai nme law, shi gaw hkrung mahkrung a kanu rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa Karai Kasang mung Adam hte shi a madu jan a matu shanhpyi hpun palawng galaw nna shan hpe shabu jahpun mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Yehowa Karai Kasang gaw, “Yu mu, masha wa gaw kaja ai hte n kaja ai hpe chye ginhka lu ai lam hta, anhte hta na langai mi zawn tai nga ai, ya shi gaw prat dingsa hkrung nga lu na matu, shi a lata ladawn nna asak jahkrung ai hpun a asi di sha na, n mai nga ai,” nga ai rai nna,
  </para>
  <para style="p">
    <verse number="23" style="v" />dai masha wa gaw, shi pru ai ga hta galaw sha nga u ga nga, Yehowa Karai Kasang gaw, Edin sun hta na, shi hpe shapraw kau dat wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai dai masha wa hpe shi shapraw kau dat nna, dai asak jahkrung ai hpun a lam sin nga na matu, Hkerub ngu ai ni hte shi chyu nwat shadang chye ai wan nhtu hpe, Edin sun sinpraw maga de tawn da wu ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Adam gaw shi a madu jan Ewa hte kanawn nna, shi gaw na-um nasin rai nhtawm, Ka-in hpe shangai wu ai; shaloi shi gaw, “Yehowa a matu shadang sha ngai lu se ai,” nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bai kanau Abela hpe bai shangai wu ai. Abela chyawm gaw sagu rem sha ai wa rai nga ai; Ka-in gaw yi hkauna galaw sha ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya aten du ai shaloi Ka-in gaw Yehowa hpe hkungga jaw na matu, ga na nsi naisi la sa wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abela mung, shi a sagu hpung hta shawng hkrat ai ni hta na mung, dai ni hta na asau mung, la sa wu ai. Yehowa gaw Abela hte shi a hkungga hpe sawn ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka-in hte shi a hkungga hpe chyawm gaw shi sawn ya wu ai n rai. Dai rai nna Ka-in gaw ja ja pawt bu ai hte myi man sum nga lu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai majaw Yehowa gaw Ka-in hpe, “Nang hpa rai pawt nga n ta? Hpa rai myi man sum rai nga nta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang kaja ai galaw yang gaw, myi man hpaw lu na n rai ni? N kaja ai nang galaw yang chyawm gaw, yubak gaw chyinghka makau e makun hpum nga ai: dai gaw nang kaw kanan mayu nga ai; rai timung, dai hpe nang up lu na rai ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Ka-in gaw shi a kanau Abela hte shaga nga ai; lang mi na shan gaw pa hkan e nga ma ai shaloi, Ka-in gaw kanau wa Abela hpang de rawt nna, shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna Yehowa gaw, “Na nnau Abela gaw kanang nga nga a ta?” Ngu nna Ka-in hpe san wu ai. Shi gaw, “Ngai n chye nngai; ngai gaw ngai nau wa hpe hkan sin ai wa rai nga a ni?” Ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Yehowa gaw, “Nang hpa di nu ta? Nnau wa a asai nsen gaw ga de nna ngai hpe jahtau nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna na a lata na nnau wa a asai hpe hkap la na, shi a n-gup mahka ai aga a dagam ai gaw, nang hkrum lu na ndai;
  </para>
  <para style="p">
    <verse number="12" style="v" />dai majaw aga hta nang galaw sha ai shaloi, lu la ang ai made, ya kaw nna nang n lu la na nit dai: ga ntsa e hprawng hkawm ai wa hte brak hkawm ai wa mung nang tai na nit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai majaw Ka-in gaw, Yehowa hpe, “Nye a yubak gaw n dang gun hkra kaba nga li ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yu u, dai ni nang ngai hpe aga hta na shaden kau nit dai; na a myi man kaw na makoi kau ai mung ngai hkrum na ni ai; ga ntsa e hprawng hkawm ai wa hte brak hkawm ai wa mung ngai tai na ni ai; dai rai nna ngai hpe mu hkrup ai wa kadai mung, ngai hpe sat kau na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Yehowa gaw, “Ka-in hpe sat ai wa kadai rai timung yubak ari htam sanit hkrum lu na re ai,” ngu nna shi hpe tsun nhtawm, ka-in hpe mu hkrup ai kadai mung shi hpe n sat u ga, Yehowa gaw shi a matu masat shakap ya wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Ka-in gaw Yehowa a myi man kaw na pru mat wa nna Edin mung sinpraw maga na Noda mung hta nga nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai Ka-in gaw shi a madu jan hte kanawn nna, shi gaw na-um nasin rai nhtawm Enuk hpe shangai wu ai: mare mung shi de wu ai rai nna, dai mare hpe, kasha a mying hku hkan nna Enuk ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya Enuk gaw kasha Irad hpe shaprat wu ai; Irad gaw Mahuyala hpe shaprat wu ai; Mahuyala gaw Mahtushaela hpe shaprat wu ai; Mahtushaela gaw Lamek hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lamek chyawm gaw num lahkawng la wu ai; langai mi a amying gaw Ada, langai mi a amying gaw Zila rai lu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ada gaw Yabala hpe shangai wu ai: dai wa gaw janghpang sum hta nga nna, yamnga rem sha ai ni a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi kanau a mying gaw Yubala rai lu ai: dai wa gaw tingse hte sumpyi chye dum ai ni mahkra a kawa rai nga ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zila mahtang gaw Htubala Ka-in hpe shangai wu ai: dai wa gaw, magri hte hpri arai dai ai baw amyu myu a ndup sama rai nga ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Htubala Ka-in kajan gaw Nama rai lu ai. Ya Lamek gaw shi a madu jan yan hpe, “Ada yan Zila e, nye a nsen madat mu, Lamek a num yan e, nye a ga matsing mu: Ngai hpe nsam dat ai majaw masha langai mi e, Ngai hpe n-gung hkang shakap ai majaw shabrang langai mi hpe, ngai sat kau lu se ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka-in hpe shut ai wa, yubak matai htam sanit hkrum yang gaw, Gaja nan Lamek hpe shut ai wa gaw, yubak matai htam sanit shi sanit hkrum lu na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya Adam gaw shi a madu jan hte bai kanawn wu yang, Ewa gaw shadang sha shangai nna, shi hpe Shet ngu nna shamying wu ai; “kaning rai nme law, Ka-in sat kau ai Abela a malai, amyu matu langai mi Karai Kasang gaw ngai hpe tawn da ya ni ai,” nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shet mung shadang sha langai mi lu wu ai rai nna, shi hpe Enusha, ngu nna shamying wu ai: dai prat kaw nna Yehowa a mying ningsang hpe nnan shaga hpang ma ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya ndai gaw Adam a labau lasang ni a lam rai nga ai. Karai Kasang gaw shinggyim masha hpe hpan tawn da ai nhtoi hta shi Karai Kasang a hkrang sumla hte maren shi hpe galaw wu ai; lasha hte numsha hpe hpan da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yan hpe shi shaman ya nna, shan hpe hpan da ai nhtoi hta shinggyim masha ngu nna shamying u ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Adam gaw latsa e sumshi ning rai sayang, shi a hte shi a asam hte bung ai shadang sha shaprat wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai wa hpe Shet ngu nna shamying wu ai. Shet hpe shaprat wu ai hpang, Adam a nhtoi gaw matsat tsa ning rai lu ai: shadang sha hte shayi sha hte hpe shi shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai ra nna Adam hkrung nga ai nhtoi mahkra hte gaw, jahku tsa e sumshi ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shet gaw latsa e manga ning du jang, Enusha hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Enusha hpe shaprat wu ai hpang, Shet gaw matsat tsa e sanit ning naw hkrung nga nna, shadang sha hte shayi sha hte shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shet a nhtoi mahkra hte gaw jahku tsa e shi lahkawng ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Enusha gaw jahku shi ning du jang, Kenan hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kenan hpe shaprat wu ai hpang, Enusha gaw matsat tsa e shi manga ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Enusha a nhtoi mahkra hte gaw jahku tsa e manga ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kenan gaw sanit shi ning du jang Mahalela hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mahalela hpe shaprat wu ai hpang Kenan gaw matsat tsa e mali shi ning naw hkrung nga nna shadang sha hte shayi sha hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />kenan a nhtoi mahkra hte gaw jahku tsa e shi ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahalela gaw kru shi manga ning du jang, Yared hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yared hpe shaprat wu ai hpang, Mahalela gaw matsat tsa e sumshi ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mahalela a nhtoi Mahkra hte gaw, matsat tsa e jahku shi manga ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yared gaw latsa e kru shi lahkawng ning du jang, Enuk hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Enuk hpe shaprat wu ai hpang Yared gaw matsat tsa ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yared a nhtoi mahkra hte gaw Jahku tsa e kru shi lahkawng ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Enuk gaw kru shi manga ning du jang Mahtusala hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mahtusala hpe shaprat wu ai hpang, Enuk gaw masum tsa ning tup Karai Kasang hte rau hkawm rau sa nga ai rai nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Enuk a nhtoi mahkra hte gaw masum tsa e kru shi manga ning rai lu ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />Enuk chyawm gaw Karai Kasang hte rau hkawm sa nga ai rai nna, shi n nga sai; kaning rai nme nga Yang, Karai Kasang gaw shi hpe Jahtawt la wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mahtusala gaw latsa e matsat shi sanit ning du jang Lamek hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lamek hpe shaprat wu ai hpang Mahtusala gaw sanit tsa e matsat shi lahkawng ning naw hkrung nga nna shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mahtusala a nhtoi mahkra hte gaw jahku tsa e kru shi jahku ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lamek gaw latsa e matsat shi lahkawng ning du jang, shadang sha shaprat wu ai rai nna, shi a amying hpe Noa ngu nna shamying wu ai: “kaning rai nme law, “Yehowa dagam kau ai ga hta, anhte hkrum ai amu bungli hte lata a ru tsang ai hta, ndai wa gaw anhte hpe shangwi shapyaw na ra ai,” nga ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Noa hpe shaprat wu ai hpang Lamek gaw manga tsa e jahku shi manga ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lamek a nhtoi mahkra hte gaw sanit tsa e sanit shi sanit ning rai lu ai: shaloi shi si mat ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ya Noa a asak gaw manga tsa ning rai nga ai: shaloi Noa gaw Shem, Ham, Yahpet hte hpe shaprat wu ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya ga ntsa masha ni, law htam wa ma ai hte, shayi sha shaprat ya nga ma ai shaloi
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang a shadang sha ni gaw shinggyim masha ni a shayi sha ni tsawm htap nga ma ai hpe mu mu ai rai nna, tinang ra ai hte maren num lata la ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa chyawm gaw, “shinggyim masha ni, lam dam ai gaw, hkum shan sha rai nga ma ai majaw, nye a Wenyi shanhte hpe tut tut a daru nga na n rai: dai rai nna shi a asak gaw latsa e hkun ning sha rai na rai nga ai.”
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai aprat e Nehpelim ngu ai ni ga n ntsa e nga nga ma ai; Karai Kasang a shadang sha ni shinggyim masha ni a shayi sha ni hte nga nna, kashu kasha shaprat ya mu ai hpang e mung, dai ni gaw naw nga nga ma ai: shanhte gaw moi nna n-gun nsam kaba ai hte kajai gumhkawng ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shinggyim masha ni a n hkru n hkra ai lam ga ntsa e kaba la ai hte, shi a kraw lawang na myit maw mamaw gaw tut tut n shawp nga ai hpe Yehowa mu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai majaw Yehowa gaw shinggyim masha ni e ga ntsa e hpan tawn da ai hpe myit malai lu nna, shi a kraw lawang e yawn nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai rai nna Yehowa, gaw, “Ngai hpan tawn da ai shinggyim masha hpe ga ntsa na atsai awai ngai di kau na we ai: masha kaw nna yamnga, gumrawt hkawm ai baw hte ntsa malen pyen ai u ni hpe du hkra shatsai kau na we ai: kaning rai nme law, dai ni hpe ngai hpan da we ai majaw myit malai lu nngai,” nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Noa chyawm gaw Yehowa a man e myi man pa nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ndai gaw Noa a maumwi lam rai nga ai: Noa gaw dinghpring ai hte, dai aprat na ni hta hkum tsup ai wa rai nga ai: Noa gaw Karai Kasang hte rau ahkawm asa nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Noa gaw shadang sha masum shaprat wu ai: dai ni gaw, Shem, Ham, Yahpet hte rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya, dai aga gaw Karai Kasang a man e n ding n man ai rai nga ai; dinghta ga gaw kashun kashe re ai hte hpring chyat nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Karai Kasang gaw dai aga hpe mada yu wu yang, yu u, dai gaw n ding n man rai nga ai: kaning rai nme law, dinghta hkum shan mahkra gaw, ga ntsa e tinang lam hpe shabyak kau ai hkrai rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Karai Kasang Noa hpe tsun wu ai gaw, “Dinghta hkum shan yawng mayawng a chyahtum gaw nye a man e pru ra ai; kaning rai nme law, dai ni a majaw dinghta ga gaw kashun kashe re ai hte hpring chyat nga ai: dai rai nna, yu u, ga hte nawng, ngai shanhte hpe jahten kau na mawe ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a matu guhpra hpun hte sanghpaw li shachyaw u: dai sanghpaw li a kata e gawk kaji nang karan da na rai ndai; de a kata maga hte shinggan maga de mung, hpun naw nang chya na rai ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang galaw na kasi gaw ning rai nga ai: dai sanghpaw li a galu maga dawng masum tsa, nda de dawng manga shi, tsaw de dawng sumshi rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai sanghpaw li hta nhtoi shang na hku nang galaw nna, ntsa de na dawng mi jahka na hte magap shangut na rai nga ai: sanghpaw li a nhkrem maga de mung, chyinghka langai mi nang waw na rai ndai: kata tsang mi, lapran tsang mi, ntsa tsang mi di nna nang galaw na rai ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai mung, lamu kata na nsoi nsa rawng ai hkum shan mahkra hpe jahten na, ga ntsa de hka kaba hte sha-u sha-ing dat na we ai: ga ntsa e nga manga hte gaw nsa hti mat na mara ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang hte chyawm gaw nye a ga shaka ngai tawn da na we ai: nang hte na a shadang sha ni mung, na a madu jan hte na a nnam ni mung, dai sanghpaw li hta nang hte rau shang na rai myit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang hte rau hkrung nga na matu mung, nsoi nsa rawng ai ashu ashan amyu shagu hta na lahkawng hkawng, dai sanghpaw li hta nang la jashawn na rai ndai; dai gaw ayi, ala rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />U ni mung tinang a amyu hta na, yamnga ni mung tinang a amyu hta na, ga ntsa e gumrawt hkawm ai baw amyu shagu hta na mung, hkrung nga na matu, lahkawng hkawng nang kaw du na mara ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sha mai ai lusha shahpa amyu myu mung la nna htun tawn da u: dai gaw na a matu mung, dai ni a matu mung lusha tai na rai malit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Noa gaw shing rai galaw wu ai; Karai Kasang shi hpe hkang da wu ai hte maren, lam shagu shi galaw wu ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yehowa Noa hpe tsun wu ai gaw, “Ndai aprat na ni hta nye a man e nang dinghpring nga ndai gaw ngai mu se ai majaw, nang hte na a nta masha ni mahkra, dai sanghpaw li de shang mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ga ntsa e nli tai nga na matu, seng ai ashu ashan amyu shagu hta na ayi ala sanit nit; n seng ai ashu ashan hta na gaw ayi ala lahkawng hkawng:
  </para>
  <para style="p">
    <verse number="3" style="v" />ntsa malen e pyen ai u ni hta na mung ayi ala sanit nit nang la bang da na rai ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, dai ni kaw nna sanit ya du jang, shani mali shi ya, shana mali shi na tup, ga ntsa de ngai marang jahtu dat na we ai rai nna, ngai hpan tawn da ai hkrung mahkrung mahkra hte hpe, ga ntsa na atsai awai di kau na mawe ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Noa mung, Yehowa shi hpe hkang da mada hte maren galaw wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ga ntsa e sha-u ing ai shaloi, Noa gaw kru tsa ning rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi Noa gaw sha-u ing ai hka a majaw, shi a shadang sha ni hte, shi a madu jan hte shi a kanam ni hte rau dai sanghpaw li de shang ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang Noa hpe hkang da wu ai hte maren, seng ai ashu ashan hta na mung, n seng ai ashu ashan hta na mung, u ni hta na mung, ga ntsa gumrawt hkawm ai baw mahkra hta na mung,
  </para>
  <para style="p">
    <verse number="9" style="v" />ayi ala lahkawng hkawng, Noa hte rau dai sanghpaw li hta shang wa ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, dai sanit ya nhtoi du jang, sha-u sha-ing na hka gaw, ga ntsa e pru wa ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noa a asak kru tsa du ai shaning, shata lahkawng hta, dai shata shi sanit ya nhtoi hta e nan, ja ja sung ai hka htung hka hku ni kapaw pru wa ai hte, sumsing lamu na hkuwawt hku ni hpaw malang mat wa ai rai nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />shani mali shi ya, shana mali shi na tup, ga ntsa e marang a htu nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai nhtoi hta e Noa hte shi a shadang sha Shem, Ham, Yahpet hte mung, Noa a madu jan hte shi a kanam masum hte mung sanghpaw li hta shang ma ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />shanhte hte nawng dusat nhprang amyu myu, yamnga amyu myu, ga ntsa e gumrawt hkawm ai baw amyu myu, u amyu myu hte pyen chye ai baw amyu myu:
  </para>
  <para style="p">
    <verse number="15" style="v" />nsoi nsa rawng ai dusat dumyeng amyu mahkra hta na lahkawng hkawng Noa kaw dai sanghpaw li hta shang ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang shi hpe hkang da ai hte maren shang wa ai dusat dumyeng ni gaw, amyu baw mahkra hta na ayi ala yep yep rai shang ma ai: shaloi Yehowa gaw shi hpe kata e la sharawng da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai sha-u ing ai gaw ga ntsa e mali shi ya tup ing wa ai rai nna, hka tung rawt wa ai hte, dai sanghpaw li hpe sharawt nna ga hta na shawaw mat wa ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hka gaw tung jat wa ai hte, ga ntsa nna nachying rawt sung wa nna, sanghpaw li gaw hka ntsa e yawng nang nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hka gaw ga ntsa e nachying tung rawt wa ai rai nna, sumsing lamu a npu ting na tsaw la ai bum mahkra hte gaw lim mat ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lim mat ai bum ni a ntsa de, tung rawt ai hka gaw, dawng shi manga kra nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ga ntsa e shamu shamawt chye ai dusat dumyeng ngu ai, u mung, yamnga mung, matse labye mung, ga ntsa e gumrawt hkawm ai baw mahkra mung, shinggyim masha mahkra mung, si mat ma ai;
  </para>
  <para style="p">
    <verse number="22" style="v" />tinang a ladi hta hkrung ai nsoi nsa rawng ai, hkarang ntsa e nga manga hte gaw si mat ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi, ga ntsa na hkrung mahkrung mahkra gaw, shinggyim masha mung, yamnga mung, gumrawt hkawm ai baw mung, ntsa malen pyen ai u mung, atsai awai di kau ai hkrum ma ai: dai ni gaw ga ntsa na atsai awai di kau ai hkrum ma ai rai nna, Noa hte dai sanghpaw li kata shi hte rau rawng ai ni sha ngam nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai sha-u gaw ga ntsa e nhtoi latsa e manga shi ya tup a ing nga ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Karai Kasang gaw Noa hte shi hte rau sanghpaw li hta rawng ai ashu ashan mahkra hte yamnga yawng hpe dum wu ai: dai majaw Karai Kasang gaw ga ntsa e nbung shabung dat wu ai rai nna, hka hpungtun ni sim mat ma ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />sung ai hka htung hka hku ni hte lamu na hkuwawt hku ni hpe pat kau wu ai rai nna, lamu marang htu ai mung hpawng mat ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi dai hka gaw ga ntsa na lwi hkrai lwi mat wa nna, latsa e manga shi ya rai jang ga ntsa na yawm mat wa ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai sanghpaw li mung, shata sanit ngu na a nhtoi shi sanit ya hta, Ararat ngu ai bum ga e mara nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hka gaw shata shi du hkra yawm hkrai yawm mat wa nna, shata shi ngu na a praw langai ya hta bum pungding ni dawng pru wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya nhtoi mali shi ya lai jang, Noa gaw, shi shachyaw ai sanghpaw li a hkuwawt chyinghka hpaw wu ai rai nna, u hka hpe dat dat wu ai: dai u hka gaw ga ntsa e hka hkyet mat ai nhtoi du hkra a pyen kahkrang hkawm nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ga ntsa e hka tang wa ai n tang wa ai chye lu hkra, hkrudu hpe mung dat dat yu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ga ntsa ting e hka naw ing nga ai majaw hkrudu gaw shi a lagaw hte dung sa na shara n mu wu ai rai nna, dai sanghpaw li de Noa kaw bai nhtang wa ai; Noa mung lata ladawn nna hkrudu hpe hkap jum la nhtawm sanghpaw li kata de jashawn la wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai kaw nna sanit ya du hkra shi naw la nga nhtawm, hkrudu hpe sanghpaw li na bai dat dat wu ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />dai hkrudu gaw shana e shi kaw bai wa ai rai nna, yu u, shi a n-gup hta tsanlun lap katsing di makrang da wu ai: dai rai nna ga ntsa e hka tang wa sai gaw, Noa chye wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung, sanit ya naw bai la nga nna, dai hkrudu hpe bai dat dat wu ai. Dai hkrudu chyawm gaw shi hpang de bai n wa ai nga mat sai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi kru tsa e langai ning na shawng shata a praw langai ya hta, ga ntsa na hka hpungtun ni hkyet mat wa sai: dai rai nna Noa gaw sanghpaw li a magap hpaw kau nna mada yu wu yang, yu u, aga gaw nnan kang wa nga ai mu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shata lahkawng ngu na a hkun sanit ya hta, aga gaw hkraw kang mat nga sai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Karai Kasang Noa hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang hte na a madu jan mung, na a shadang sha ni hte na a nnam ni mung dai sanghpaw li hta na pru wa mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang hte rau nga ai nsoi nsa rawng ai dusat dumyeng amyu shagu hta na, a-u hte yamnga hpe mung, ga ntsa e gumrawt hkawm ai baw mahkra hpe mung, nang hte rau shapraw u: dai ni gaw ga ntsa e tsanawn tsanang rai wa hkra, mayat maya wa nna law htam wa mu ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna Noa hte shi a shadang sha ni mung, shi a madu jan hte kanam ni mung, pru wa ma ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />ga ntsa e shamu shamawt chye ai dusat dumyeng yawng mayawng gumrawt hkawm ai baw yawng mayawng, u yawng mayawng hte mung, tinang a amyu hte tinang dai sanghpaw li hta na pru wa ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Noa gaw Yehowa a matu tawn hkungri galaw nhtawm seng ai yamnga amyu shagu hta na hte seng ai u amyu shagu hta na lata la nna dai tawn hkungri ntsa e wan nat hkungga nawng wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa mung dai manam pyaw ai sangau hkap manam la wu ai: dai rai nna Yehowa gaw, Ginding aga hpe shinggyim masha ni a majaw, hpang de ngai dagam kau na ni ai n rai; kaning rai nme law, shi a kraw lawang na myit mang gaw, kaji kaw nna n shawp nga lu ai: dai hta kaga, ya e hkrung mahkrung hte hpe ngai jahten mawe ai zawn, hpang de galoi mung ngai bai jahten na ni ai n rai:
  </para>
  <para style="p">
    <verse number="22" style="v" />ginding aga naw pra nga dingsa, nli dat ai aten hte mam shu la ai aten, kashung ai hte kahtet ai, nshung ta hte nlum ta, shani hte shana n htum n wai na sai, nga nna shi a kraw lawang e tsun nga ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Karai Kasang Noa hte shi a shadang sha ni hpe shaman ya nna, shanhte hpe tsun wu ai gaw, “Nanhte kashu kasha shaprat nna, mayat maya wa ai hte lamu ga hpe jahpring mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ga ntsa na dusat dumyeng mahkra hte hte, ntsa malen pyen ai u mahkra hte gaw nanhte hpe hkrit gari nna myit kang nga na mara ai: lamu ga ntsa e shamu shamawt chye ai yawng hte hte, nammukdara na nga mahkra hpe nanhte a lata hta ngai ap ya masade ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nsoi nsa rawng nna shamu shamawt chye ai baw mahkra gaw nanhte a matu shahpa tai na rai nga ai: tsit lali ai nsi naisi hpe zawn, yawng mayawng ngai nanhte hpe jaw da masade ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung nanhte gaw, asak rawng ai asai hte nawng ashan n sha lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gaja wa, asak rawng ai nanhte a asai hpe gaw ngai bai hpyi na we ai: dusat dumyeng mahkra hpe mung dai gaw ngai hpyi na we ai: masha a lata hta na, kahpu kanau a lata hta na pyi, masha a asak gaw ngai bai hpyi na we ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kadai rai timung, masha a asai hpe hkaw kau ya yang, shi a asai hpe mung, masha a lata hte hkaw kau ya lu na rai nga ai: kaning rai nme law, Karai Kasang gaw shi a hkrang sumla hte maren di nna masha hpe hpan da nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanhte gaw kashu kasha shaprat nna law htam wa manit; ga ntsa e tsanawn tsanang rai nna, law wa htam wa manit,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Karai Kasang Noa hte shi a shadang sha ni hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Yu mu, ngai gaw nanhte hte nanhte a kashu kasha ni hte mung,
  </para>
  <para style="p">
    <verse number="10" style="v" />nanhte hte rau sanghpaw li na pru wa ai, ga ntsa na dusat dumyeng amyu myu ngu ai, a-u, yamnga, ashu ashan re ai, nanhte hte rau lamu ga ntsa e nga ai hkrung mahkrung hte hte mung, nye a ga shaka tawn da nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte hte ngai tawn da ai ga shaka gaw, Htawm hpang de sha-u ing ai hka hte hkrung mahkrung hte hpe ngai bai n jahtum kau na hte, lamu ga hpe jahten na mung, htawm hpang de sha-u bai n ing na sai, ngu ai ga rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hta kaga, ngai hte lapran e nanhte hte, nanhte hte rau nga ai hkrung mahkrung mahkra hte hte shu mashi shu masha prat dingsa na ngai tawn da ai ga shaka a kumla gaw,
  </para>
  <para style="p">
    <verse number="13" style="v" />nye a n-goilatum sumwi hta ngai tawn da se ai; dai gaw ngai hte lamu ga a lapran e tawn da ai ga shaka a kumla tai na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai re ai majaw, ga ntsa e ngai lamu mu shangun ai shaloi, dai n-goilatum gaw sumwi hta dan pru na ra ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />shaloi ngai hte lapran e nanhte hte rau nga ai hkrung ai nsoi nsa rawng ai dusat dumyeng nga manga hte hte tawn da ai nye a ga shaka hpe ngai dum na we ai rai nna, hkrung mahkrung hte hpe jahten na htawm hpang de sha-u hka bai ing sana n rai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai n-goilatum gaw sumwi hta nga ga na ra ai rai nna, Karai Kasang hte ga ntsa na hkrung ai nsoi nsa rawng ai dusat dumyeng mahkra hte a lapran na htani htana ga shaka hpe dum na matu, dai hpe ngai yu nga na we ai,” ngu nna Karai Kasang tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hta kaga Karai Kasang gaw Noa hpe “Ndai gaw ngai hte ga ntsa e nga ai hkrung mahkrung mahkra hte a lapran na, ngai tawn da ai ga shaka a kumla rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai sanghpaw li na pru wa ai Noa a shadang sha ni gaw, Shem, Ham, Yahpet hte rai ma ai: Ham chyawm gaw Hkanan a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai ni masum gaw Noa a shadang sha ni rai ma ai rai nna, shanhte hta nna lamu ga ting chyam wa ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ya Noa gaw sun hkauna amu galaw sha ai rai nna, tsabyi sun hkai wu ai: dai tsabyi jahku hpe mung shi lu wu ai rai nna nang nga ai;
  </para>
  <para style="p">
    <verse number="21" style="v" />shing rai shi a sum kata e hpun nba n hpun ai taw nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Hkanan a kawa Ham gaw shi a kawa a singgu krin hpe mu jang, shinggan e nga ai kahpu yan kanau hpe sa tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai re ai majaw Shem yan Yahpet gaw hpun nba la nhtawm, tinang a lahpa hta mara let htingnut sa wa nna shan a kawa a singgu krin hpe magap ya mu ai: shan a myi man shinggan de yawng malu ai majaw, shan gaw kawa a singgu krin hpe n mu ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ya Noa tsabyi nang ai bran nna hprang yang, shi a kasha kaji shi hpe kaning di ai mung shi chye wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai majaw Noa gaw, “Hkanan gaw dagam dala hkrum u ga, Kahpu kanau ni a mayam ni kaw manam tai nu ga,” nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai shi gaw, “Shem a Karai Kasang Yehowa gaw a nga u ga. Hkanan chyawm gaw shi a mayam tai nu ga,
  </para>
  <para style="p">
    <verse number="27" style="v" />Karai Kasang Yahpet hpe maden shajat dat nna, Shem a sum hkan e shi nga nga u ga: Hkanan chyawm gaw shi a mayam tai nu ga,” nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Noa chyawm gaw dai sha-u ing ai hpang masum tsa e manga shi ning du hkra naw hkrung nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Noa a nhtoi mahkra hte gaw jahku tsa e manga shi ning rai lu ai: shaloi shi si mat ai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya ndai gaw Noa a shadang sha Shem, Ham, Yahpet hte a lakung lama ni rai nga ma ai: dai ni gaw sha-u ing ai hpang e shaprat ai kashu kasha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yahpet a shadang sha ni gaw, Goma, Magu, Madai, Yawan, Htubala, Meshek, Htira hte rai ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Goma a shadang sha ni gaw, Ashkena, Rihpat, Htugama hte rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yawan a shadang sha ni gaw, Elisha, Tarshi, Kihtim, Dodanim hte rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte hta nna zunlawng amyu ni gaw tinang nang a mungdan hte ran wa ma ai; dai ni gaw tinang a amyu ni hta shaga ai ga hte abaw asang kaga ga rai wa ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ham a shadang sha ni gaw, Hkusha Mizra-im Hput, Hkanan hte rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkusha a shadang sha ni gaw, Seba, Hawila, Saphta, Rama, Sabahtahka hte rai ma ai. Rama a shadang sha gaw Sheba yan Dedan rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkusha gaw Nimrod hpe mung shaprat wu ai; dai wa gaw ga ntsa e kaba hpang ai wa rai nga ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa a man e mung shi gaw jaugawng kaba rai nga ai rai nna, Nimrod zawn re ai Yehowa a man na jaugawng kaba wa, nga nna ga malai tsun ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a mungdan a npawt gaw, Shina mung Babela, Erek, Ahkada, Hkalna ginwang ni rai lu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai mung nna Ashuri mung de shi sa nna, Ninewe mare, Rehubut mare, Hkala mare hpe mung,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ninewe hte Hkala lapran e Resen mare hpe mung de wu ai: Resen mare gaw mare kaba rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mizra-im gaw, Ludim, Anamim, Hkasluhim, Hkaphturim amyu ni hpe shaprat wu ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />Hpeliste masha ni gaw Hkasluhim amyu hta na rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkanan gaw shi a kasha alat Sidon hte Het,
  </para>
  <para style="p">
    <verse number="16" style="v" />Yebusi, Amuri, Girgashi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiwi, Arki, Sini,
  </para>
  <para style="p">
    <verse number="18" style="v" />Arwadi, Zimari, Hamahti amyu ni hpe shaprat wu ai: dai hpang e Hkanan a amyu lakung ni gaw, langai hte langai ran mat wa ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hkanan masha ni a lamu ga jarit chyawm gaw, Sidon mare kaw nna Gerara hku hprang, Gaza mare du hkra; bai Sodom, Gomora, Adma hte Zebuim mare ni hku hkrawn rai nna Lasha mare du hkra rai nga malu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai ni gaw lakung lama kaga ga shaga ai ga kaga ga mungdan ni kaga ga hte amyu baw ni kaga ga re ai, Ham a kashu kasha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yahpet a kahpu kaba, Ebera masha ni mahkra a kawa Shem mung kashu kasha shaprat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem a shadang sha ni gaw, Elam, Ashura, Arhpaza, Luda, Aram hte rai ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aram a shadang sha ni gaw, Uza, Hula, Gehta, Masha hte rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arhpaza mung Shela hpe shaprat wu ai; Shela gaw Ebera hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ebera mung shadang sha lahkawng shaprat wu ai: langai wa a amying gaw Hpelek rai lu ai: kaning rai nme law, dai wa a prat e lamu ga hpe karan la ma ai; kanau wa a mying gaw Yoktan rai lu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yoktan gaw, Almoda, Shalep Hazarmawet, Yarak,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzala, Dikla,
  </para>
  <para style="p">
    <verse number="28" style="v" />Ubala, Abimela, Sheba,
  </para>
  <para style="p">
    <verse number="29" style="v" />Uhpira, Hawila, Yoba hte hpe shaprat wu ai: ndai hte mahkra gaw Yoktan a shadang sha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte a lamu ga gaw, Mesha mare kaw nna, sinpraw maga de Sahpara bum du hkra rai malu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai ni gaw lakung lama kaga ga, shaga ai ga kaga ga, mungdan ni kaga ga, amyu baw ni kaga ga re ai Shem a kashu kasha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ndai hte gaw Noa a shadang sha ni hta na, tinang a lakung lama hkan nna, langai hte langai hkrat wa ai amyu baw ni a lam rai nga ai: dai sha-u ing ai hpang shanhte hta nna ga ntsa e masha amyu ni bran wa ma ai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya ga ntsa ting hta e n-gup ga langai sha hte tsun ai hku langai sha rai nga malu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya sinpraw maga de htawt hkawm wa ma yang, shanhte gaw Shina mung hta e pa layang langai mi mu mu ai rai nna dai yang e de nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi langai hte langai tinang a manang wa hpe, “Sa marit, anhte wut galaw nna ja hkra kabaw gaw,” nga nna tsun ma ai. Dai rai nna shanhte gaw nlung a malai awut, wut shakap na matu hka namsu lu la ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai shanhte gaw, “Sa marit, ga ntsa ting e anhte n bra mat na hte, kajai gumhkawng ai amying lu la na matu, mare hte lamu dep ai wahpang langchyi anhte galaw ga,” nga nna tsun shajang ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Yehowa gaw, shinggyim masha ni galaw ai mare hte langchyi hpe yu yu na nga, yu hkrat wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna Yehowa gaw, “Yu mu, shanhte gaw amyu langai sha rai ma ai hte, shaga ai ga langai sha rai nga malu ai rai nna, ndai gaw shanhte nnan galaw hpang ai amu rai nga malu ai: ya kaw nna shanhte maw mamaw hpe n hkum shadang lu na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sa marit, langai hte langai tinang a manang tsun ai ga n chye na mat hkra, shanhte a shaga ai ga hpe shanut kau ya na, anhte yu hkrat saga,” nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shing rai Yehowa gaw, shanhte hpe dai shara kaw nna ga ntsa ting de shabra dat wu ai rai nna, dai mare n de lu ai yu mat ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna shara dai hpe Babela ngu nna shamying mu ai: kaning rai nme law, dai yang e Yehowa gaw ga ntsa ting tsun ai ga hpe shanut kau ya wu ai; dai shara kaw nna mung, Yehowa gaw shanhte hpe ga ntsa ting de shabra kau dat wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ndai gaw Shem a lakung lama matu ni rai nga ma ai. Shem gaw latsa ning du nna, sha-u ing ai hpang ni ning rai jang Arhpaza hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shem gaw Arhpaza hpe shaprat wu ai hpang, manga tsa ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arhpaza gaw sumshi manga ning du jang, Shela hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Arhpaza gaw Shela hpe shaprat wu ai hpang, mali tsa e masum ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shela gaw sumshi ning du jang Ebera hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shela gaw Ebera hpe shaprat wu ai hpang mali tsa e masum ning naw hkrung nga nna shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ebera gaw sumshi mali ning du jang, Hpelek hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ebera gaw Hpelek hpe shaprat wu ai hpang, mali tsa e sumshi ning naw hkrung nga nna shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpelek gaw sumshi ning du jang Reu hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hpelek gaw Reu hpe shaprat wu ai hpang, ni tsa e jahku ning naw hkrung nga nna shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reu gaw sumshi lahkawng ning du jang, Seruk hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reu gaw Seruk hpe shaprat wu ai hpang, ni tsa e sanit ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seruk gaw sumshi ning du jang Nahura hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Seruk gaw Nahura hpe shaprat wu ai hpang ni tsa ning naw hkrung nga nna shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahura gaw hkun jahku ning du jang Htera hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nahura gaw Htera hpe shaprat wu ai hpang, latsa e shi jahku ning naw hkrung nga nna, shadang sha hte shayi sha hte hpe shaprat da wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Htera gaw sanit shi ning du jang, Abram, Nahura, Haran hte hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ndai gaw Htera a lakung lama matu ni rai nga ma ai. Htera gaw Abram, Nahura, Haran hte hpe shaprat wu ai: Haran gaw Lawt hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Haran chyawm gaw shi a kawa Htera naw nga nga yang, shi dai daw ai Hkaladea mung na Ura mare e si mat sai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abram yan Nahura mung num ma lat nna, Abram a madu jan gaw, Sarai mying ai rai lu ai; Nahura a madu jan gaw, Haran a shayi sha Milahka rai lu ai: Haran gaw Milahka yan Yishka a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sarai chyawm gaw maudung rai nga ai rai nna kashu kasha n lu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Htera gaw shi a kasha Aram hpe mung, shi a kashu Haran a kasha Lawt hpe mung, shi a kanam Abram a madu jan Sarai hpe mung shaga woi nhtawm, Hkanan mung de sa wa na nga, Hkaladea masha ni nga ai Ura mare kaw nna pru sa wa ai: shing rai shanhte gaw Haran de du nna, dai yang e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Htera a asak gaw ni tsa e manga ning rai lu ai: Htera chyawm gaw Haran mare e si mat ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yehowa gaw Abram hpe, “Na a buga hte na a amyu, na a nwa nta na pru nhtawm ngai nang hpe madun na ra de ai mung de sa wa su:
  </para>
  <para style="p">
    <verse number="2" style="v" />ngai nang hpe amyu kaba shatai na de ai rai nna, na a amying hpe galu kaba shangun ya na we ai; nang mung chyeju daju tai nga et.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang hpe shaman ai wa hpe, ngai shaman ya na we ai; nang hpe dagam ai wa hpe ngai dagam kau na we ai: na a marang e ga ntsa na masha amyu shagu gumring gumrat lu la shajang na mara ai,” ngu nna shaga wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna Abram gaw, Yehowa shaga wu ai hte maren pru sa wa ai rai nna, Lawt mung shi hte rau hkan nang sa wa ai: Abram gaw Haran nna pru sa wa ai shaloi, asak sanit shi manga ning rai sa lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Abram gaw, shi a madu jan Sarai hte, shi a kanau a kasha Lawt hpe mung, shanhte lu la ai arai yawng mayawng hte Haran e lu la ai masha mahkra hpe mung woi nna, Hkanan mung de sa wa na pru wa ma ai: Hkanan mung de mung shanhte du ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram gaw dai mung hpe ga sa wa ai rai nna, Shekim ginwang Mora ngu ai shara wamyi hpun nhpang de du ai: dai shaloi Hkanan masha ni gaw dai mung hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi Yehowa gaw Abram kaw dan pru nna, “Ndai mung hpe na a amyu matu ni e ngai jaw na we ai,” ngu wu ai. Dai majaw shi kaw dan pru ai Yehowa a matu, dai shara e tawn hkungri shi galaw wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai kaw nna Behtela a sinpraw maga na bum de shi htawt wa nhtawm, shi a sum hpe Behtela a sinpraw maga hte Ai a sinna maga pa lapran e gap wu ai: dai yang e mung Yehowa a matu tawn hkungri shi galaw nna, Yehowa a amying hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abram chyawm gaw htawt hkawm sa wa nna, dingda maga de yawng mat wa ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi dai mung e hku hku wa ai rai nna, Abram gaw Egutu mung de sa shingbyi nga na pru sa wa ai: kaning rai nme law, dai mung e hku wa kaba hku nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya Egutu mung du na ni jang, shi a madu jan Sarai hpe shi tsun wu ai gaw, “Ya yu u, nang gaw ahpraw tsawm ai num rai nga ndai, ngai chye da de ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna Egutu masha ni nang hpe mu jang, “Ndai gaw shi a madu jan rai nga lu ai, nga nna ngai hpe sat kau nhtawm, nang hpe gaw jahkrung da na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai majaw, nang gaw nye a kajan re ai she ngu u: shing rai, na a majaw ngai chyamai nga lu nna, na a marang e ngai asak hkrung lu na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Abram Egutu mung de du ai shaloi, dai numsha ja ja tsawm htap nga ai gaw Egutu masha ni mu mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hpara-u a agyi salang ni mung shi hpe mu ma ai rai nna, Hpara-u a man e shakawn ma ai; dai rai nna dai numsha hpe Hpara-u a htingnu de jashawn ya mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hpara-u gaw dai numsha a matu Abram hpe kaja ai hku galaw wu ai rai nna, shi gaw sagu, dumsu, lawze wula, lasha yam, numsha yam, lawze ayi hte gawla-uk hte hpe lu la wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa chyawm gaw, Abram a madu jan Sarai a majaw, Hpara-u hte shi a nta masha ni hpe tsin-yam kaba jaw wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai majaw Hpara-u gaw Abram hpe shaga nna, “Nang ngai hpe ndai galaw ai gaw, hpa rai nga a ta? Shi na a madu jan re ai gaw, ngai e hpa rai n tsun n ta?
  </para>
  <para style="p">
    <verse number="19" style="v" />Nye a madu jan tai nga na, ngai shi hpe la u ga nga, Shi nye a kajan re ai, nga nna nang hpa rai tsun n ta? Ya, na a madu jan hpe yu u, woi la nna wa mat u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Hpara-u gaw Abram a lam shi a masha ni hpe hkang dat mu ai rai nna, shanhte gaw shi hte shi madu jan hpe mung, shi lu la ai arai mahkra hte nawng hkan sa dat mu ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Abram gaw, shi hkum hte shi a madu jan mung, shi lu malu hte mung Egutu mung na pru lung wa ai rai nna, Hkanan mung Dingda maga de rai wa ma ai; Lawt mung shi hte rau hkan lung wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abram chyawm gaw yamnga sut mung, aja, gumhpraw sut mung ja ja lu su nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai shi gaw Dingda maga de na kanawt hkawm wa nna, Behtela ginwang e Behtela mare hte Ai mare a lapran na,
  </para>
  <para style="p">
    <verse number="4" style="v" />shawng de shi sum gap nna tawn hkungri galaw yu sai shara de bai du wa ai; dai yang e Abram gaw Yehowa a amying hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram kaw hkan hkawm ai Lawt mung, sagu bainam hpung, nga dumsu hpung hte janghpang sum law law lu ai rai nna,
  </para>
  <para style="p">
    <verse number="6" style="v" />shan lahkawng shara sha nga na gaw lamu ga n shang malu ai: kaning rai nme law, shan a sutgan law la malu ai majaw, shara sha hta rau n nga lu ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme nga yang, Abram a nga rem ma ni hte Lawt a nga rem ma ni ga law ga la nga ma ai: dai shaloi e Hkanan masha ni hte Hparizi masha ni mung, dai mung hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Abram gaw Lawt hpe, “An gaw hpunau rai nga ga ai majaw, ngai hte na a lapran e mung, nye a nga rem ma ni hte na a nga rem ma ni a lapran e mung, ga law ga la n nga u ga;
  </para>
  <para style="p">
    <verse number="9" style="v" />ga ting na a man e dam nga ai n rai ni? Ya ngai hte hka nna nga u; nang pai maga de rai yang ngai hkra maga de, nang hkra maga de rai yang ngai pai maga de rai wa na nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai prat e, Yehowa gaw Sodom hte Gomora mare hpe garai n jahten yang, Zora mare du hkra Yawdan hka a grup yin ginwang hkan e hka law nga ai rai nna Yehowa a sun zawn mung, Egutu mung zawn mung, rai nga ai gaw, Lawt mada yu nna mu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Lawt gaw dai Yawdan ginwang ting hpe lata la nhtawm sinpraw maga de htawt mat wa ai rai nna, shan gaw langai hte langai hka mat wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram chyawm gaw Hkanan mung e naw nga nga ai; Lawt gaw dai ginwang hkan na mare ni hta nga lawm nna, Sodom mare du hkra shi a sum gap wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya, Sodom mare na masha ni gaw n shawp nga ma ai rai nna, Yehowa a man e nachying yubak kaba ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Lawt gaw Abram kaw na hka mat wa ai hpang, Yehowa gaw Abram hpe shaga nna, “Ya nang nga ai shara kaw nna dingdung dingda, sinpraw sinna mada yu u:
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaning rai nme law, ya nang mu nga ai lamu ga mahkra, nang hte na a amyu matu ni hpe prat dingsa ngai jaw nga na made ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a kashu kasha ni hpe ga nhpu zawn ngai mayat maya shangun na mawe ai: masha langai ngai ga nhpu hpe dang hti yang gaw, na a kashu kasha ni hpe mung dang hti na mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rawt u, dai mung a dingdung de mung nda de mung dinghkren hkawm yu u: kaning rai nme law, dai mung ngai nang hpe jaw na de ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Abram gaw shi a sum htawt nna, Hebron mare na wamyi hpun tu ai Mamre ngu ai shara a makau e shang nga nga ai: dai yang e mung Yehowa a matu tawn hkungri shi galaw wu ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hte yang Shina hkawhkam Amrahpela, Elasa hkawhkam Ariok, Elam hkawhkam Hkedala-uma, Goim hkawhkam Htidala hte gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />Sodom hkawhkam Bera, Gomora hkawhkam Birsha, Adama hkawhkam Shinap, Zebuim hkawhkam Shemeba, Zora ngu ai Bela a hkawhkam hte hte hpyen gasat ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai ni nlang Sidim kadit e sa hpawng nga ma ai: (Sidim ngu ai kadit gaw dai Jum nawng rai nga ai).
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw shi lahkawng ning tup Hkedala-uma up ai hkam nga nhtawm, shi masum ning hta e gumlau mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi mali ning hta e Hkedala-uma gaw shi hpang maga e nga ai hkawhkam ni hte rau sa wa nna Ashtarut Kernaim hta e Rehpani masha ni hpe, Ham hta e Zuzim masha ni hpe, Shawe Kiryahta-im hta e Ema masha ni hpe dang kau ma ai hte,
  </para>
  <para style="p">
    <verse number="6" style="v" />Seira bum hta e nga ai Hori masha ni hpe mung nam makau e nga ai Ela Hparan du hkra shachyut kau mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai de nna shanhte bai wa nhtawm, Kadesha ngu ai En-Mishpat de du ma yang, Amalek mung ting hpe mung, Hazazon-Htama e nga ai Amori masha ni hpe mung gasat dang kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Sodom hkawhkam, Gomora hkawhkam, Adama hkawhkam, Zebuim hkawhkam Zera ngu ai Bela hkawhkam hte gaw rawt pru nna Sidim kadit e hkap gasat ma ai:
  </para>
  <para style="p">
    <verse number="9" style="v" />shanhte gaw Elam hkawhkam Hkedala-uma, Goim hkawhkam Htidala, Shina hkawhkam Amrahpela, Elasa hkawhkam Ariok hte hpe hkap gasat mu ai: shing rai hkawhkam mali hte hkawhkam manga gasat nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Sidim kadit hta hka namsu nhkun hkrai pri rai nga ai; shaloi Sodom hkawhkam yan Gomora hkawhkam gaw hprawng wa ma ai rai nna, dai hkan e hkrat shajang ma ai: lawt lu ai ni gaw dai bum ga de hprawng wa ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dang lu ai ni gaw Sodom hte Gomora mare na arai nga manga hte lusha shahpa mahkra htawm la nna wa mat ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sodom e nga ai Abram a kanau a kasha Lawt hte shi a arai hpe mung shanhte la mat wa ya mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya dai hta na hprawng lawt lu ai masha langai mi gaw, Hebre masha Abram hpe sa tsun dan wu ai: Abram chyawm gaw Eshhkula yan Anera a kahpu Amuri masha Mamre ngu ai wa a wamyi hpun makau e naw nga nga ai; shanhte gaw Abram hte ga shaka da ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Abram gaw shi kanau wa hpe rim mat wa ai lam na jang, shi a nta e shaprat nna shi sharin ai masha masum tsa e marai shi matsat hte hpe woi nna Dan mare du hkra hkan shachyut ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai shana e shi gaw shi a ma ni hpe karan nhtawm, shanhte hpe gasat jahtaw dat nna, Damasku mare a pai maga na Hoba mare du hkra hkan shachyut mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte la wa ai arai mahkra hpe mung shi a kanau Lawt hte shi a arai ni hpe mung, numsha ni hte mare masha ni hpe mung, shi bai la woi wa lu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Abram gaw Hkedala-uma hte shi hpang maga na hkawhkam ni hpe dang kau ai kaw na bai wa ai shaloi, shi hpe tau la na nga Sodom a hkawhkam gaw, hkawhkam kadit ngu ai Shawe kadit e pru sa wa ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shalem a hkawhkam Melhkizedek mung muk hte tsabyi jahku la sa wa ai: dai wa gaw Tsaw Htum ai Karai Kasang a hkinjawng wa rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi gaw Abram hpe, “Lamu hte aga Madu, Tsaw Htum ai Wa Karai Kasang gaw Abram hpe shaman ya u ga:
  </para>
  <para style="p">
    <verse number="20" style="v" />na a gumlau ni hpe na a lata hta ap ya ai Tsaw Htum ai Karai Kasang mung a nga u ga law,” ngu nna shaman ya wu ai. Abram mung shi lu la ai mahkra hta na htamshi hta htammi shi hpe jaw da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi Sodom hkawhkam wa gaw Abram hpe, “Dai masha ni hpe ngai e jaw da e; arai ni hpe chyawm gaw nang la wa u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Abram gaw Sodom hkawhkam wa hpe, “Abram hpe ngai sut jasu se ai, nga nna nang tsun shara n nga u ga,
  </para>
  <para style="p">
    <verse number="23" style="v" />ri yan mi muk, kyepdin sumri langai mi muk, nang lu ai arai hta na hpa muk ngai n la na, ngu nna lamu hte aga Madu, Tsaw Htum ai Karai Kasang Yehowa a man e nye a lata ngai sharawt nna dakan se ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />rai timung shabrang ni sha kau manu ai hte, ngai hte rau hkan sa ai Anera, Eshhkula, Mamre hte gaw shanhte lu la ai lanep daw mi hte daw mi la wa manu ga,” ngu nna htan wu ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Yehowa a ga gaw Abram kaw shingran hta du nna, “Abram e, hkum hkrit et; ngai gaw na a makawp ninggang rai nga nngai; nang lu la na shabrai kaba la nga lit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Abram gaw, “Yehowa Madu e, nang ngai hpe hpa chyeju jaw na n ta? Ngai kashu kasha n lu nngai wa mi, nye a dinghku madu na gaw, Damasku mare na, ndai Eliaza ngu ai wa arai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Abram gaw, “Yu u, nang ngai hpe amyu matu n jaw ndai; nye a npan dap na langai mi nye a Sali wunli dagraw na wa rai nga sahka,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Yehowa a ga shi kaw bai du ai gaw, “Dai wa gaw na a Sali wunli madu lu na n rai; na a nshang na nan hkrat ai wa she, na a Sali wunli madu lu na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing nga nhtawm Abram hpe shinggan de woi shapraw nna, “Sumsing lamu de mada yu u, dai shagan ni hpe nang dang hti yang gaw hti yu u: na a amyu matu ni dai hte maren rai na mara ai,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram mung Yehowa hpe kamsham wu ai rai nna, dai gaw shi a dinghpring ai lam ngu nna nawn ya wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai shi tsun wu ai gaw, “Ndai mung hpe na a Sali wunli shatai na matu jaw na nga nna, Hkaladea masha ni nga ai Ura mare kaw nna nang hpe shaga woi wa ai Yehowa gaw ngai rai nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Abram gaw, “Yehowa Madu e, dai mung nye a Sali wunli tai na gaw, ngai kaning di chye lu na rai ta?” Ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Yehowa gaw, “Masum ning du ai dumsu upra langai mi, Masum ning du ai bainam yi langai mi, masum ning du ai sagu la langai mi hte hkrudu langai mi, u ra kasha langai mi nye a matu la tawn u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hte maren dai ni nlang hpe shi la tawn nna, hkum shagu hpe ka-ang brang brang di ga nhtawm, maga mi de chyen chyen di nna jahka tawn wu ai: u yan hpe chyawm gaw shi n ga wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />U matse ni dai mang de pyen hkrat ma timung, Abram dai ni hpe hkap gawn kau wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jan du wa jang, Abram hta yup kaba du ai rai nna, ja ja htat ai nsin hta hkrit gari mat ai hkrum wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Yehowa Abram hpe tsun wu ai gaw, “Da ndai chye da nga u: na a kashu kasha ni gaw, shanhte hte n seng ai mung hta manam sa tai nga na mara ai rai nna, dai mung na masha ni a yam sha ai hte zingri zingrat ai hpe mali tsa ning tup hkrum nga na mara ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />shanhte hpe yam ai amyu hpe mung ngai jeyang na mawe ai: dai hpang shanhte gaw sutgan law law hte pru wa lu na mara ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang chyawm gaw nji nwoi ni kaw ngwipyaw ai hte wa lu na rin dai; aprat nga nna makoi mayang dat ai nang hkrum na ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aprat mali lai ai hpang, shanhte gaw nang de bai wa na mara ai: kaning rai nme law, Amori masha ni a shut hpyit ai gaw garai n dik malu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jan shang mat nna nsin htat nga ai shaloi, yu u, wan hkut hku ai wan mang hte, wan tu ai shanan paw pru nna shan chyen ni a lapran hku lai mat wa ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai shani e Yehowa gaw Abram hte ga shaka tawn da nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />“Ndai Keni, Kenizi, Kadmoni, Heti, Hparizi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Rehpa, Amori, Hkanani, Girgashi, Yebusi masha ni nga ai mung ngu ai,
  </para>
  <para style="p">
    <verse number="21" style="v" />Egutu hka nu kaw nna, Uhprat hka nu kaba du hkra dam ai lamu ga hpe, na a amyu matu ni e ngai jaw da se ai,” ngu wu ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Abram a madu jan Sarai gaw kashu kasha n lu nga ai: shi gaw Egutu amyu Hagara ngu ai shingnan num langai mi lu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna Sarai gaw Abram hpe, “Yu u, Yehowa ngai hpe kashu kasha lu na lam ban da nga ai: dai re ai majaw nye a shingnan jan kaw shang u; shi a marang e ngai kasha lu dam nhten,” ngu wu ai: Abram mung Sarai a ga madat ya wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram gaw Hkanan mung e nga ai shi ning du sayang she Abram a madu jan Sarai gaw shi a shingnan jan Egutu amyu Hagara hpe, shi madu wa Abram a lashi num shatai na ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Abram gaw Hagara kaw shang ai rai nna shi na-um nasin rai nga ai: shi na-um nasin rai sai chye wu jang, shi Sarai hpe n kaw n law di wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai majaw Sarai gaw Abram hpe, “Ngai hkrum ai yubak gaw na ntsa e du u ga; nye a shingnan jan hpe na a lahpyen e ngai jaw sade ai rai nna, ya shi na-um nasin re ai chye jang, ngai hpe n kaw n law di nngai: ngai hte na a lapran e Yehowa jeyang ya mi ga,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram chyawm gaw, “Yu u, na a shingnan jan gaw na a lata e rawng nga ai; nang kaning di mayu yang di u,” ngu nna Sarai hpe tsun wu ai. Shaloi Sarai gaw shi hpe adip akrip di wu ai rai nna, Hagara gaw shi kaw na hprawng pru mat wa ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya Yehowa a lamu kasa gaw, Shura de sa ai lam na hka htung langai mi a makau e shi hpe hkap mu nna,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Sarai a shingnan jan Hagara e, gade nna pru n ta? Gade sa wa nga n ta?” ngu nna san wu ai: shi gaw, “nye a madu Sarai kaw na hprawng wa nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna Yehowa a lamu kasa gaw, “Na a madu hpang de bai wa nna, shi shi a npu e taw nga u,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Yehowa a lamu kasa gaw, “Na a nshu nsha ni hpe n dang hti hkra ngai law htam shangun na we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hta n-ga Yehowa a lamu kasa bai tsun ai gaw, “Yu u, nang na-um nasin rai nga ndai rai nna shadang sha shangai na rin dai; dai wa a amying gaw Ishmaela ngu nna nang shamying ya lu na rai ndai; kaning rai nme law, nang hkrum ai matsan tsin-yam hpe Yehowa na ya nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw masha a man e nam lawze zawn tai na ra ai: masha yawng hpe hpyen ai wa mung shi tai na ra ai; shi hpe mung masha yawng e hpyen na maru ai; kahpu kanau ni yawng mayawng a saw masawn e shi nga lu na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai shi hte ga tsun ai Yehowa hpe, “Nang gaw mu lu ai Karai Kasang rai nga ndai, ngu nna shamying wu ai: kaning rai nme law shi gaw, Ngai hpe mu ai wa e ndai yang e ngai mu lu ni hka gaw?” Nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai ga hkan nna hka htung dai hpe, Bera-lahai-roi ngu nna shamying wu ai: dai gaw Kadesha hte Bared lapran e nga nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang Hagara gaw Abram hpe shadang sha shangai ya wu ai: Abram mung Hagara shangai ya ai shadang sha hpe Ishmaela ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hagara gaw Abram a matu Ishmaela hpe shangai ya ai shaloi Abram a asak gaw matsat shi kru ning du salu ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Abram asak Jahku shi jahku ning du sayang, Yehowa gaw shi kaw dan pru nna, “Ngai gaw Chyahtum Chyalai n-gun rawng ai Karai Kasang rai nga ai; nye a man e hkum tsup let hkawm sa wa u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi nye a ga shaka nang hte ngai tawn da na we ai rai nna, nang hpe nachying shalaw na de ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai majaw Abram gaw shi a man e dingnyawm dagup nga ai rai nna, Karai Kasang shi hpe bai tsun wu ai gaw, “Yu u, ngai nan nye a ga shaka hpe nang hte shagrin da se ai rai nna, nang gaw masha amyu baw law law a kawa rai na nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hta kaga, na a amying hpe ya kaw nna Abram ngu lu na n rai; ngai nang hpe masha amyu baw law law a kawa shatai sade ai majaw, na a amying Abraham ngu na rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai nang hpe nachying mayat maya shangun na de ai; nang hta nna masha amyu myu ngai shatai na we ai; nang hta nna mung hkawhkam hkawseng pru shajang na mara ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai gaw na a Karai Kasang mung, na a htawm hpang na, na a kashu kasha ni a Karai Kasang mung, tai nga na nngai, ngu nna, nang hte na a kashu kasha ni hta prat mi hte prat mi, nye a ga shaka hpe htani htana ga shaka ngai shatai na wa ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya nang manam tai nga ai ndai Hkanan mung ting, nang hpe mung, na a htawm hpang na, na a kashu kasha ni hpe mung, prat dingsa a madu nga lu na matu, ngai jaw da na we ai; dai hta kaga shanhte a Karai Kasang mung ngai tai nga na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai, Karai Kasang Abraham hpe tsun wu ai gaw, “Nang hkum nan hte na a hpang na, na a kashu kasha ni gaw nye a ga shaka hpe prat dingsa hkan nang lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang hte na a hpang na, na a kashu kasha ni hkan nang nga lu na nye a ga shaka gaw ndai rai nga ai: nanhte hta lasha hkum shagu gaw matu gadoi ai lam hkam la lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte gaw nanhte hkum a hpyi matu gadoi kau ai hkam la lu na rai myit dai: dai gaw ngai hte nanhte a lapran e tawn da ai ga shaka a kumla tai nga na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte a amyu hta prat dingsa, lasha hkum shagu gaw, tinang a nta e shangai ai rai timung, tinang amyu n re ai, amyu kaga ni kaw na gumhpraw hte mari la ai rai timung, matsat ya nhtoi du jang, matu gadoi ai hkam la lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tinang a nta e shangai ai wa mung, tinang gumhpraw hte mari la ai wa mung, matu gadoi ai hkam la lu na rai myit dai: shing rai nye a ga shaka gaw, nanhte a ashan hta htani htana ga shaka tai nga na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Matu n galoi ai, tinang hkum a hpyi matu gadoi n hkam la ai lasha gaw, shi a amyu hta na sumri dan kau ya ai hkrum lu na rai nga ai: dai wa gaw nye a ga shaka hpe lai kau nu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Karai Kasang Abraham hpe tsun wu ai gaw, “Na a madu jan Sarai hpe mung, Sarai ngu sana n rai, shi a amying Sara ngu na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi hpe ngai shaman ya nna, shi hta na ngai nang hpe shadang sha langai mi jaw na de ai: rai sa, ngai shi hpe shaman ya nna, shi gaw amyu myu a kanu tai na ra ai; shi hta nna mung amyu baw ni a hkawhkam hkawseng pru shajang na mara ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Abraham gaw dingnyawm dagup nga let, “Latsa ning du sai wa gaw kasha naw lu na kun? Jahku shi ning du sai Sara mung kasha naw shangai na ra ai kun?” Nga nna mani ai hte shi a kraw lawang e tsun nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna Abraham gaw, “Na a man e Ishmaela ahkrung nga nu ga,” ngu nna Karai Kasang hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi Karai Kasang gaw, “Nrai, na a madu jan Sara nan na a matu shadang sha shangai ya na ra ai; dai wa hpe Isak ngu nna nang shamying lu na wu ai: shi a hpang na shi a kashu kasha ni hta nye a ga shaka hpe htani htana ga shaka tai nga na matu, ngai shi hte dai ga shaka tawn da na we ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ishmaela matu mung na a ga ngai madat nga nngai: yu u, ngai shi hpe shaman ya nna, mayat maya shangun ai hte ja ja shalaw jahtam na we ai; shi gaw du shi lahkawng a kawa tai na ra ai rai nna, shi hpe amyu kaba mung ngai shatai na we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rai timung, htaning ndai aten e, na a matu Sara shangai na ra ai shadang sha Isak hta, nye a ga shaka ngai shagrin da na we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang gaw shi hte ga tsun ai sim nna, Abraham kaw nna lung mat wa ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi Abraham gaw Karai Kasang shi hpe tsun da ai hte maren, shi a kasha Ishmaela kaw nna, shi a nta e shangai ai ni nlang hte hte, shi a gumhpraw hte mari la ai ni nlang hte ngu ai shi a nta hte seng ai lasha yawng hte hpe shaga la nna, dai shani jang matu gadoi ai lam jaw mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham gaw shi hkum nan matu gadoi hkam ai shaloi jahku shi jahku ning rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi a kasha Ishmaela gaw matu gadoi hkam ai shaloi shi masum ning rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abraham yan shi a kasha Ishmaela gaw lani jan hta matu gadoi ai hkam la ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shi a nta e shangai ai ni hte amyu kaga ni kaw na gumhpraw hte mari la ai ni ngu ai shi a nta hte seng ai lasha nlang hte mung shi hte rau matu gadoi ai lam hkam la ma ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham gaw shani jan ja ai aten e shi a sum chyinghka lam e dung nga yang, Yehowa gaw Mamre a wamyi hpun makau e shi kaw dan pru nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi mada yu nga yang, yu u, shi a makau e masha marai masum tsap nga ma ai: dai ni hpe mu jang, sa tau la na nga sum chyinghka nna gat sa nhtawm, ga de dingnyawm dagup let tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Nye a madu e, na a man e ngai myi man pa nga nngai rai yang gaw, na a mayam wa kaw na hkum lai sa wa et;
  </para>
  <para style="p">
    <verse number="4" style="v" />ntsin loi mi la sa ya de ga, nanhte a lagaw kashin kau ngut jang, dai hpun npu e naw sa nga mu:
  </para>
  <para style="p">
    <verse number="5" style="v" />muk n-gup mi mung ngai naw la sa na nngai; shing rai nanhte myit shalan la mu; dai hpang lai sa wa na rai nga ai: kaning rai nme law, dai matu nanhte a mayam wa kaw nanhte du sa manit dai,” ngu wu ai. Shanhte mung, “Nang tsun ai hte maren di u,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Abraham gaw sum kata e nga ai Sara hpang de alawan wan gat shang wa nna, Muk shadung jare masum alawan gan gumchya nhtawm muk pa kaba u,” ngu nna tsun da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai Abraham gaw dumsu hpung de gat sa nhtawm, nu nu nai nai rai hpum sau ai dumsu kasha dun wa nna, shangun ma hpe ya wu ai: dai wa mung alawan sat lajang wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shingdi htawbat hte nga chyu mung, shi lajang ai dumsu kasha mung shi la nna shanhte a man e baw jaw mu ai: shi chyawm gaw dai hpun npu shanhte a makau e tsap nga ai; shanhte mung sha nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi shanhte gaw, “Na a madu jan Sara kanang nga nga a ta?” Ngu nna san mu ai. Shi gaw, “Wonang sum e nga nga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte hta na langai wa gaw, “Nhtoi gu jang nang hpang de ngai teng teng bai du na ring ngai rai nna, na a madu jan Sara gaw shadang sha lu na ra ai,” ngu nna tsun wu ai. Shing nga tsun ai wa a shingdu de chyinghka makau e Sara nga nga ai rai nna ga dai na wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya Abraham yan Sara gaw aprat kaba la masai; Sara hta mung numsha hking nga ai hte maren ya n nga salu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai majaw, Sara gaw, “Ya ngai gumgai ni ai, nye a madu wa mung dingla sai, dai re ai mi ngai naw pyaw na rai nga a hka i?” Nga nna shi a kraw e mani nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai rai nna Yehowa gaw Abraham hpe, “Sara gaw, ngai gumgai sayang me gaja wa kasha lu na a kun? Nga nna hpa rai mani a ta?
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa n di lu ai amu lama mi nga a ni? Nhtoi gu jang ngai nang hpang de bai du na ring ngai rai nna, Sara gaw shadang sha lu na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sara chyawm gaw, “Ngai n mani nngai” ngu nna ndang wu ai; kaning rai nme law shi hkrit nga ai. Dai wa mung, “N rai, nang mani nit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi dai masha ni dai kaw na rawt nna, Sodom mare de man yawng let sa wa nga ma ai: Abraham mung shanhte hpe hkan sa dat na nga, rau sa wa nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Yehowa gaw, “Ngai galaw ai amu Abraham hpe ngai makoi na we ai kun?
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham chyawm gaw, kaba ai hte nsam rawng ai amyu teng teng tai na ra ai; ga ntsa amyu nlang hte mung shi hta gumring gumrat lu la na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />kaning rai nme law, Abraham a lam Yehowa tsun da ai ga ndat hte maren shi hta shadik lu hkra, Yehowa a lam hkan nga nna, dinghpring ai lam hte tara tengman ai lam hpe shatsup lu na matu, Abraham gaw shi a kashu kasha ni hte shi a dinghku na ni hpe, shi hpang hkan nang nga mu ga nga, shi hkang na ra ai gaw ngai chye da we ai,” nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Yehowa gaw, “Sodom mare hte Gomora mare a jahtau ai nsen kaba la nga malu ai hte shanhte a shut hpyit ai gaw ja ja li nga malu ai majaw,
  </para>
  <para style="p">
    <verse number="21" style="v" />ya ngai sa yu nna, ngai kaw hkrang pru ai nsen hte maren shanhte gaja wa galaw ai n galaw ai gaw ngai yu yu na we ai; n galaw ai rai yang mung ngai chye na we ai,” nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya dai ni gaw dai kaw nna myi man kayin nna Sodom maga de sa wa ma ai; Abraham chyawm gaw Yehowa a man e naw tsap nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi Abraham gaw sit sa nna, “dinghpring ai ni hpe n shawp ai ni hte rau, gaja wa nang jahten kau na wu ni?
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai mare hta e dinghpring ai masha manga shi nga ma nhten; dai rai yang, dai dinghpring ai masha manga shi a majaw, dai mare hpe matsan dum ai hte n jahten ai, n da lu n ni?
  </para>
  <para style="p">
    <verse number="25" style="v" />dinghpring ai ni hpe n shawp ai ni hte rau sat kau na hte, dinghpring ai ni hpe n shawp ai ni e zawn jahkrum na gaw nang hte tsan nga u ga; rai sa, dai gaw nang hte tsan nga u ga: ga ntsa ting a Tara agyi wa gaw dingman ai hku galaw na n rai ni?” Ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai rai nna Yehowa gaw, “Sodom mare kata e dinghpring ai masha manga shi hpe ngai mu yang gaw, dai ni a majaw dai shara ting hpe ngai shalai kau na we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai Abraham gaw, “Yu u, ngai ga nhpu hte dap sha rai nga nngai, rai timung nang Madu hpe ngai tsun na ngu nga nngai:
  </para>
  <para style="p">
    <verse number="28" style="v" />dinghpring ai masha manga shi hta manga yawm nga nhten; shing rai masha manga yawm ai majaw mare ting hpe jahten na wu ni?” Ngu nna bai tsun wu yang, Dai mare hta marai mali shi manga ngai mu we yang gaw, dai shara hpe ngai n jahten na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai Abraham gaw, “Dai mare e marai mali shi nang mu hkrup na wu ai nhten,” ngu nna kahtap tsun wu yang, shi gaw, “Dai mali shi a majaw ngai n di na we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bai Abraham gaw, “Nye a Madu masin hkum pawt et, ngai naw tsun we ga, dai mare hta marai sumshi nang mu hkrup na wu ai nhten,” ngu wu yang, shi gaw, “Marai sumshi ngai mu we yang gaw, ngai n di na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Abraham gaw, “Nye a Madu hpe ngai naw tsun na ngu nga nngai: dai mare hta marai hkun mu hkrup na wu ai nhten,” bai ngu wu yang, shi gaw, “dai marai hkun a majaw ngai n jahten na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bai Abraham gaw, “Nye a Madu masin hkum pawt et; ndai lang mi sha ngai naw tsun n-ga: dai mare hta marai shi mu hkrup na wu ai nhten,” ngu wu yang, shi gaw, “Dai marai shi a majaw dai shara hpe ngai n jahten na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ya Yehowa gaw Abraham hte ga tsun ngut jang wa mat ai: Abraham mung shi a shara de bai nhtang wa ai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai lamu kasa yan gaw nrim e Sodom mare de sa du ma ai; Lawt gaw Sodom mare chyinghka lam e dung nga ai: shaloi Lawt gaw dai yan hpe mu nna, sa tau la na nga rawt sa nhtawm, shi a myi man ga de dagup let,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Madu yan e nan a mayam a nta de shang nna, dai na tup nga nga marit; nan a lagaw shin mu; hpawt de jau jau rawt nna, lai sa wa mu,” ngu nna hkap tsun wu ai. Dai yan gaw, “An n shang na ga ai, dai na tup mare lam hkan e nga nga na ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shan hpe akroi anoi nga nna saw mu ai majaw, shan gaw shi hpang de kayin nna nta de shang ma ai; shan a matu shi poi galaw nna, matsi n rawng ai muk kabaw ngut jang, shan sha ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai yan garai n yup yang, Sodom mare shara shagu hkan na sa ai lasha kaji kaba nlang hte gaw, dai nta hpe grup di wang da nna,
  </para>
  <para style="p">
    <verse number="5" style="v" />Lawt hpe shaga let, “Dai na nang kaw du ai manam yan, kanang nga ma ta? Dai yan hte anhte kanawn lu na matu shapraw ya mi,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Lawt gaw chyinghka shinggan de shanhte kaw pru nna, shi a shingdu de chyinghka la tawn nhtawm,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Nye a hpunau ni e, ndai hte wa n shawp ai amu gaw hkum galaw myit.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yu mu, ngai kaw la garai n chye ai shayi sha lahkawng nga nga ai; dai yan hpe nanhte hpang de shapraw ya na hkraw ya mi, shan hpe nanhte kam ai mi di mu; ndai yan chyawm gaw nye a nta a magaw shingnip hta sa shingbyi nga ma ai majaw, shan hpe hpa mung hkum di ya myit,” ngu nna sa tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung shanhte gaw, “Ndai wa gaw nang e she sa shingbyi nga ai mi, tara agyi tai mayu nga ai; ya ndai yan hpe di ai hta, nang hpe chyawm grau nna n hkru ai hku di na de ai,” ngu mu ai. Shing rai shanhte Lawt hpe jawm adip nna, chyinghka adawt hpaw kau na nga, sit sa wa ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai lamu kasa yan chyawm gaw lata shawn dat nna Lawt hpe nta nhku de shan kaw dun jashawn la nhtawm, chyinghka la kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hta kaga shan gaw, dai chyinghka shinggan e nga ai masha kaji kaba nlang hpe myi shamak kau ya mu ai rai nna, shanhte gaw chyinghka lam tam nna ba mat ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya dai lamu kasa yan Lawt hpe tsun mu ai gaw, “Ndai yang nang hte seng ai ni naw nga ma ni? Na a nhkri nsha ni hpe mung, na a shadang sha ni hte shayi sha ni hpe mung, ndai mare hta e nang lu malu hpe, ndai yang na woi shapraw u:
  </para>
  <para style="p">
    <verse number="13" style="v" />shara ndai hpe an jahten kau na rai nga ga ai; kaning rai nme law, ndai yang na masha ni a jahtau ai gaw Yehowa a man e nachying kaba nga malu ai majaw, ndai hpe jahten kau na Yehowa gaw an hpe shangun dat ma ni ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai majaw Lawt gaw pru nna shi a shayi sha ni hpe la ai kahkri ni e, “Rawt mu, ndai yang na pru wa mu; mare ndai hpe Yehowa jahten kau na da,” ngu nna hkan tsun wu ai. Kahkri ni chyawm gaw, shi shatu ai sha rai nga ai, nga nna myit ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nhtoi htoi ai shaloi dai lamu kasa yan gaw Lawt hpe shadut nna, “Rawt u; ndai mare a yubak hta nang n hten lawm n ga, na a madu jan hte nang e nga ai na a shayi sha yan hpe woi nna pru wa u,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi chyawm gaw a ganyi nga ai, rai timung Yehowa shi hpe matsan dum nga ai majaw, dai lamu kasa yan gaw shi hte shi a madu jan hpe mung, shi a shayi sha yan hpe mung lata hta dun nna shapraw nhtawm, dai mare shinggan e woi tawn mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai shanhte hpe shapraw tawn nhtawm, langai wa mi gaw, “Na asak lawt lu hkra hprawng u; hpang de hkum katin yu et, ndai pa garai n tawng tawng gaw hkrum hkring et; nang hten bya ai n hkrum hkra, bum ga de hprawng u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Law tsun wu ai chyawm gaw, “Nye a Madu e, shing n rai u ga:
  </para>
  <para style="p">
    <verse number="19" style="v" />Yu u, na a mayam wa na a man e myi man pa ni ai rai nna, nye a asak hkrung nga lu na matu ngai hta nang galaw ya ai matsan dum ai chyeju wa kaba la salit dai: dai yubak ngai hpe lep nna ngai n si n ga, bum ga du hkra wa ngai n dang hprawng nngai:
  </para>
  <para style="p">
    <verse number="20" style="v" />ya, yu u, wora mare gaw hprawng lu na daram ni nga ai, kaji mung kaji nga ai; nye a asak hkrung nga lu hkra dai de hprawng wa shangun e; dai gaw kaji nga ai n rai ni?” Ngu wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai wa mung, “Yu u, ndai lam hta mung nye a man e nang myi man pa nit dai rai nna, nang tsun ai mare hpe ngai n jahten ni ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai de lau hprawng wa u; nang dai de garai n du yang ngai hpa mung n galaw lu nngai,” ngu wu ai. Dai re ai majaw mare dai hpe Zora ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lawt gaw Zora mare de du shang jang, ga ntsa e jan pru sai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Yehowa gaw lamu de nna Sodom hte Gomora ntsa de kan hte grung ai wan jahtu dat wu ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shing rai shi gaw dai mare yan hte nawng ginwang ting hpe mung, dai mare yan hta nga ai masha mahkra hte ga e tu matu hpe mung galau ka-up kau wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lawt a madu jan chyawm gaw hpang de kayin yu nna jum shadaw tai mat lu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya Abraham gaw manap jau jau rawt nna, shi Yehowa a man e tsap ai shara de sa wa yu wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sodom hte Gomora maga de mung, dai ginwang ting de mung shi mada yu wu yang, yu u, wan nhkut gaw wan nmang hta na hku ai wan hkut zawn dai mung ting hta nna mawng lung nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Karai Kasang gaw dai ginwang na mare ni hpe jahten kau wu ai shaloi Karai Kasang Abraham hpe dum wu ai rai nna, Lawt nga ai mare ni hpe galau ka-up kau wu ai shaloi, dai galau ka-up kau ai hta na Lawt hpe dat dat wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Lawt gaw Zora mare hta nga hkrit ai majaw, shi a shayi sha yan hte rau Zora mare na pru nna bum ga e wa nga nga ai; shan wa ni gaw lungpu langai mi hta rawng nna nga nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ya kana mahtang kanau jan hpe tsun wu ai gaw, “An a kawa dingla mat sai; dai hta kaga ga ntsa ting hta, ga ntsa hking hte maren an hpe la na lasha langai mi muk n nga sai;
  </para>
  <para style="p">
    <verse number="32" style="v" />law, an gaw wa hpe tsabyi jaw shanang gaw, an a kawa amyu matu shapraw na shi hte yup ga,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai shana e shan gaw kawa hpe tsabyi jaw nhtawm, kana jan mahtang shang nna kawa hte rau yup wu ai; shi yup lawm ai mung, shi rawt wa ai mung kawa gaw n chye wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hpang jahpawt e kana gaw, “Yu u, mana e ngai wa hte yup ni ai; dai na mung shi hpe tsabyi jaw nna wa a amyu matu shapraw lu hkra nang shi kaw shang yup lawm u,” ngu nna kanau jan hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai shana mung shan gaw kawa hpe tsabyi jaw nhtawm kanau jan mahtang shang nna kawa hte rau yup wu ai; shi yup lawm ai mung, shi rawt wa ai mung kawa gaw n chye wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai rai nna Lawt a kasha yan gaw kawa hta na kasha kap ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kana jan shadang sha shangai ai rai nna, dai ma hpe Moba ngu nna shamying wu ai: dai wa gaw ya du hkra Moba masha ni a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kanau jan mung shadang sha shangai wu ai rai nna, dai ma hpe Ben-ammi ngu nna shamying wu ai: dai wa gaw ya du hkra Ammon a kashu kasha ni a kawa rai nga ai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Abraham gaw dai kaw na dingda maga de htawt sa wa nhtawm, Kadesha hte Shura lapran e nga da nna, Gerara mare hta shingbyi nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai shaloi Abraham gaw shi a madu jan Sara a lam, “Shi gaw ngai jan rai nga ai,” ngu nna tsun wu ai majaw, Gerara hkawhkam Abimelek gaw shangun dat nna Sara hpe la wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang chyawm gaw shana e yup mang hta Abimelek kaw du nna, “Yu u, nang la ai num a majaw, nang masha chyasi rai nit dai; kaning rai nme law, shi masha a num rai nga ai,” ngu nna daru wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya, Abimelek gaw Sara hte garai n kasawt ai rai nna, “Madu e, dingman ai amyu hpe mung nang sat kau na n ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi nan, Ngai jan re ai, nga nna ngai e tsun ai n rai ni? Num jan shi mung, Ngai yung re ai, nga nna tsun ai; n shut dum ai myit rawng nna, san seng ai lata hte ndai lam ngai galaw ni ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai dai yup mang hta Karai Kasang gaw, “Rai sai, n shut ai myit hte ndai lam nang galaw ai gaw ngai chye nngai; nang ngai e n shut u ga, ngu nna ngai hkum nan nang hpe ban shadang de ai: dai rai nna shi hte kasawt na ahkang ngai nang hpe n jaw de ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya dai wa a madu jan shi hpe bai ya u; shi myihtoi rai nga ai rai nna, na a matu shi akyu hpyi yang, nang hkrung lu na rin dai: nang bai n ya yang gaw, nang mung nang hte seng ai ni mahkra mung teng teng si na marin dai, chye da u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Abimelek jahpawt jau jau rawt nna, shi a mayam ni nlang hpe shaga la nhtawm, dai lam mahkra shanhte hpe tsun dan wu ai: dai ni mung ja ja hkrit nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abimelek gaw Abraham hpe mung shaga nna, “Nang anhte hpe hpa di ai rai ta? Nang hpe ngai hpa shut ai majaw, ngai hta mung nye mungdan hta mung ndai yubak kaba du shangun n ta? N galaw mai ai amu nang ngai hta galaw n hka,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Abimelek gaw, “Nang hpa lam mu nna shing rai galaw n ta?” Ngu nna Abraham hpe san wu yang,
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham gaw, “Ndai yang e Karai Kasang hkrit ai masha n nga ma ai rai nna, nye madu jan a majaw ngai hpe sat kau na ma ai, ngu nna ngai myit ai majaw sha rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hta kaga shi nye a kajan majing mung teng nga ai; ngai wa a shayi sha shi rai nga ai, ngai nu a chyawm gaw n rai: nye a madu jan mung rai nga ai
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang ngai hpe nye wa nta na jahkawm dat ai shaloi, Nang ngai hpe galaw na chyeju gaw ndai rai nga ai: an du hkawm wa ai shara shagu e, ngai e, N-yung re ai, ngu nna she tsun u, ngu nna shi hpe ngai htin da we ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Abimelek gaw sagu, dumsu, yamnga mung, numsha, lasha yam mung Abraham hpe jaw dat wu ai; madu jan Sara hpe mung bai ya wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hta n-ga Abimelek gaw, “Yu u, nye a lamu ga gaw na a man e rai nga ai; nga mayu ai hte maren nga u,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai Sara hpe mung, “Yu u, na n-yung wa hpe gumhpraw hkying mi ngai jaw ni ai; dai gaw nang kaw rau nga ai ni mahkra a man e mung, masha kaga yawng a man e mung nang hpe galaw ai ja rai u ga; dai rai nna nang sin maraw lawt nit dai,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham mung Karai Kasang kaw akyu hpyi ya wu ai rai nna, Karai Kasang gaw Abimelek hte shi a madu jan hpe mung, shi a mayam num ni hpe mung shamai ya mu ai rai nna shanhte gaw kashu kasha shaprat ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kaning rai nme law, Yehowa gaw Abraham a madu jan Sara a majaw, Abimelek a nta na num ni kashu kasha n kap hkra dim da nu ai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Yehowa a mungga nga ai hte maren Sara hpe shi kawan katsan yu sa ai rai nna, Yehowa tawn da ai ga ndat hte maren Sara hta shadik wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai majaw Sara gaw na-um nasin rai nna, Abraham hpe Karai Kasang ndat da ai ahkying hta, shi asak kaba sayang, shi a matu shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham mung shi a matu Sara shangai ai kasha hpe Isak ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang hkang da ai hte maren Abraham gaw shi a kasha Isak hpe matsat ya du ai nhtoi hta matu gadoi ai lam jaw wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham gaw shi a kasha Isak a myi man mu ai shaloi latsa ning rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna Sara gaw, “Karai Kasang ngai hpe mani shangun ni ai; dai shi na ai ni yawng mayawng gaw ngai hte maren mani na masai,” nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai shi gaw, “Sara gaw kasha e chyu shachyu na ru ai, nga nna Abraham hpe kadai tsun yu na a ta? Kaning rai nme law, shi dingla mat sayang she, ngai kasha shaprat ya we ai,” nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ma Isak mung kaba wa nna chyu jahka mu ai; Isak hpe chyu jahka ai shani e Abraham gaw poi kaba galaw wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Sara gaw, Egutu num Hagara hta Abraham lu ai shadang sha e roi nga ai, mu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai majaw shi gaw Abraham hpe, “Ndai shingnan num hte shi a kasha hpe gawt kau u; ndai shingnan num a kasha gaw ngai sha Isak hte rau Sali wunli dagraw lu na n rai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham chyawm gaw, shi a kasha rai nga ai majaw, dai lam hpe nachying yak dum nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung Karai Kasang gaw, “Dai ma hte na a shingnan num a majaw myit hkum ru et; Sara nang hpe tsun matsun madat u: kaning rai nme law, Isak hta, na a amyu matu tai na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai shingnan num a shadang sha mung, na a matu rai nga ai majaw, shi hpe mung amyu baw mi ngai shatai na we ai,” ngu nna Abraham hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Abraham gaw jahpawt jau jau rawt nna, muk hte ntsin ndum la nhtawm, Hagara a lahpa hta mara ya let jaw dat ngut jang, kasha ap ya nna dat dat wu ai; shi mung pru mat wa nna Berasheba nam mali hkan e kayin hkawm nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai ndum na ntsin ma jang, shi gaw ma dai hpe singwum langai mi a kata e gumpye bang kau da nna,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Ma si ai mung ngai n mu mayu nngai,” nga let, ndan lang mi gap hkap daram tsan ai kaw e ma hpang de yawng let dung nga ai. Shi gaw shing rai dung nga da nna jahtau hkrap wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Karai Kasang gaw dai ma a nsen na wu ai rai nna, lamu de nna Karai Kasang a lamu kasa mung Hagara hpe shaga let, “Hagara e, nang hta hpa re a ta? Hkum hkrit et; dai ma nga ai kaw na nsen Karai Kasang na nu ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />rawt u, dai ma hpe sharawt nna lata hte pawn shadaw u; ngai shi hpe amyu kaba shatai na we ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hta kaga Karai Kasang gaw shi hpe myi hpaw ya wu ai rai nna, hka htung langai mi shi mu wu ai; dai majaw shi sa nna ndum hta ntsin ja jahpring la nhtawm, ma hpe gawn jaw wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Karai Kasang mung dai ma hte rau nga nga ai rai nna, shi gaw galu kaba wa ai hte, nam e nga nna ndan jaugawng tai wa ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi gaw Hparan mali e nga nga ai rai nna, kanu mung Egutu mung na num langai mi la ya wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai ten hte yang, Abimelek hte shi a hpyen du wa Hpilola gaw Abraham hpe shaga nna, “Nang galaw wa ai lam shagu hta Karai Kasang nang hte rau nga nga ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />dai rai nna, ngai e mung, ngai sha ni e mung, ngai shu ni e mung nang n maw sha ai sha nang hpe ngai chyeju madun ai zawn, ngai e mung, ya nang shingbyi nga ai nye a mung hpe mung, chyeju madun sa na, ngu nna Karai Kasang hta, ya ndai yang e dagam da e,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham mung, “Rai sa, ngai dagam na we ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Abraham gaw, Abimelek a mayam ni kashun la ai hka htung a lam, Abimelek hpe daru wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abimelek chyawm gaw, “Dai gaw kadai galaw ai ngai n chye nngai, nang mung ngai e n tsun ndai, ngai mung dai ni du hkra n na nngai,” ngu nna ndang kau wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shaloi Abraham gaw sagu hte dumsu la nhtawm, Abimelek hpe jaw nna shan lahkawng gaw ga shaka tawn da ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bai Abraham gaw sagu hpung na sagu yi kasha sanit jahka tawn wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai rai nna Abimelek gaw, “Ndai jahka tawn ai sagu yi kasha sanit gaw, kaning re ai rai ta?” Ngu nna Abraham hpe san wu yang, shi gaw,
  </para>
  <para style="p">
    <verse number="30" style="v" />“Dai hka htung ngai htu se ai gaw, ngai hpang maga de sakse tai na matu, ndai sagu yi kasha sanit hpe nye a lata na nang hkap la lu na rai ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai yang e shan lahkawng dagam ma ai majaw, shi gaw shara dai hpe Berasheba ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shing rai shan gaw Berasheba shara e ga shaka tawn da ma ai: dai hpang Abimelek hte shi a hpyen du Hpilola gaw rawt nna Hpiliste mung de wa mat ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham chyawm gaw Berasheba shara e magyeng hpun hkai nna, dai yang e, htani htana anga nga ai Karai Kasang Yehowa a mying ningsang hpe nawku wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shing rai Abraham gaw Hpiliste mung e na na wa nga nga ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai hte a hpang e Karai Kasang gaw Abraham hpe chyam yu na nga, “Abraham e,” ngu nna shaga wu ai; shi gaw, “Ngai nang nga nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Karai Kasang gaw, “Nang tsawra ai, na shadang sha shingtai Isak hpe woi nna Moria ga de sa wa su; ngai nang hpe madun na ra de ai bum hta shi hpe wan nat hkungga di nna nawng e,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai majaw Abraham gaw jahpawt jau jau rawt nna, lawze daw byau nhtawm, shi kasha Isak hte shangun ma lahkawng hpe shaga la nna, hkungga nat na hpun chye la ngut jang, Karai Kasang shi hpe tsun ai bum de rawt sa wa ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masum ya sat ai nhtoi hta Abraham gaw mada dat yu wu yang, dai shara hpe tsan tsan kaw nna mu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Abraham gaw shangun ma yan hpe, “Nan nang e lawze hte rau naw hti nga mala; ngai hte ndai ma gaw htawra de lung wa nna nawku na ga ai; nawku ngut jang nan hpang de bai wa na ra ga ai,” ngu nna tsun da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Abraham gaw hkungga nat na hpun la nna kasha Isak hpe jahpai nhtawm, wan hte nhtu gaw shi a lata hta lang let, shan wa lahkawng sha rau lung wa ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lung wa nga yang Isak gaw, kawa Abraham hpe, “Wa e,” ngu wu ai; kawa gaw, “Sha e,” ngu nna htan ya wu ai: shaloi Isak gaw, “Yu u, hpun mung wan mung lu ga ai, wan nat hkungga di na sagu kasha gaw kanang rai ta?” Ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham chyawm gaw, “Sha e, wan nat hkungga di na sagu kasha gaw, Karai Kasang shi a matu, shi mazing da na ru ai,” ngu wu ai; shing rai shan wa lahkawng rau lung wa ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi shan gaw Karai Kasang tsun ai shara de du ma ai rai nna, Abraham gaw dai shara e tawn hkungri galaw nhtawm, hpun mara garai ngut jang, kasha Isak hpe gyit hkang nna, tawn hkungri hta hpun ntsa e mara tawn wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Abraham shi a lata ladawn nna, kasha hpe sat na nga, nhtu la lang wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Yehowa a lamu kasa gaw, “Abraham e, Abraham e,” nga nna lamu de na shaga pru ai: Abraham gaw, “Ngai nga nga nngai ngu wu yang,
  </para>
  <para style="p">
    <verse number="12" style="v" />“lamu kasa gaw, Na a lata dai ma e hkum hkra et, hpa mung hkum di et; na a shadang sha shingtai hpe ngai e jaw na nang n shim da ndai majaw nang Karai Kasang hpe hkrit hkungga ndai gaw, ya ngai chye sade ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Abraham mada dat yu wu yang, yu u, shi a shingdu e sagu la langai mi singwum hta nrung chya nna dau nga ai, mu wu ai: dai rai nna Abraham gaw dai sagu la sa raw la nna, shi kasha a malai wan nat hkungga di nna lang wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai re ai majaw Abraham gaw dai shara hpe Yehowa Yira ngu nna shamying wu ai; shing rai, Yehowa a bum hta mazing da ya na ra ai, nga nna ya du mateng ga malai tsun ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Yehowa a lamu kasa gaw lamu de nna Abraham hpe lang mi bai shaga nna,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Ngai Yehowa, ngai hkum nan hta dagam tsun nngai gaw, Ndai nang galaw ai lam hte, na a shadang sha shingtai hpe n shim da ndai majaw,
  </para>
  <para style="p">
    <verse number="17" style="v" />shaman ai chyeju hte ngai nang hpe shaman ya na de ai; na a amyu matu ni hpe lamu na shagan ni hte nammukdara hka kau na zaibru zawn ngai shalaw na we ai rai nna, na a kashu kasha ni gaw tinang hpyen ni a mare chyinghka ni hpe madu lu na mara ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />dai hta n-ga, nye a nsen hpe nang madat mara ndai majaw, na aru arat a marang e ga ntsa na amyu nlang hte gaw gumring gumrat re ai lu la na mara ai;” ngu wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi Abraham gaw shi a shangun ma yan hpang de bai wa nhtawm, shanhte rawt nna Berasheba de rau du wa ma ai: Abraham gaw Berasheba e anga nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ndai lam ni byin ai hpang e Abraham e tsun dan ai shiga gaw da ndai rai nga ai: “Yu u, na nnau Nahura a madu jan Milhka gaw kashu kasha shaprat nu ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />dai ni gaw, kasha alat Uza hte kanau wa Buza; Aram a kawa Kemuela;
  </para>
  <para style="p">
    <verse number="22" style="v" />Hkesed, Hazo, Piledasha, Yidlap, Behtuela hte rai ma ai.”
  </para>
  <para style="p">
    <verse number="23" style="v" />Bethuela gaw Rebeka hpe shaprat wu ai: dai marai matsat hte gaw Abraham a kanau Nahura madu jan Milhka shaprat ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi a lashi jan Reuma mung, Teba, Gaham, Htahasha, Mahka hte hpe shaprat wu ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Sara a prat gaw latsa hkun sanit ning rai salu ai; Sara hkrung nga ai gaw dai hte ning rai nga ai. Shaloi Sara gaw Hkanan mung na Kiryat Arba ngu ai Hebron mare hta si mat ai: Abraham mung Sara a majaw sharung shayawt ai hte hkrap ngu hkrap ngoi na nga sa wa ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hpang Abraham gaw shi a madu jan si mang a man na rawt nhtawm Heti masha ni hpe shaga nna tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ya ngai gaw nanhte kaw e malet nhprang manam hte sa chyu nga ai wa sha rai nga nngai; nye a madu jan si mang hpe nye a man na lup kau lu na matu, ngai madu nga na lup ra nanhte kaw e san da jaw mi,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna Heti a kashu kasha ni gaw Abraham hpe,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Madu e, anhte a ga madat ya mi, nang gaw anhte a ka-ang e Karai Kasang san da ai du rai nga ndai; anhte a kaja grau ai lup hta na a madu jan si mang hpe lup makoi u; na madu jan si mang hpe lup makoi na, anhte hta kadai mung tinang a lup hta ningdang na n rai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abraham chyawm gaw rawt nna dai mung na masha ni ngu ai Heti a kashu kasha ni a man e gum dagup nga nna,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Nye a man na nye a madu jan si mang hpe ngai lup makoi lu na nanhte hkraw myit yang gaw nye a ga madat ya mi: Zuhara a kasha Ehprun gaw shi a ga dachyawk jahtum e nga ai Makhpela ngu ai ginlawng hku ngai hpe jaw na hpyi ya mi;
  </para>
  <para style="p">
    <verse number="9" style="v" />ngai madu nga na lup ra matu, dai hpe manu ging ai made hte nanhte a man e ngai hpe dut ya ru ga,” ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ehprun mung Heti a kashu kasha ni a ka-ang e dung nga ai: shaloi dai Heti masha Ehprun gaw, shi a mare chyinghka de shang mashang ni ngu ai, Heti masha ni nlang hte a man e Abraham hpe,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Shing n rai, nye a Madu e, nye a ga madat ya e; dai ga dachyawk hte nawng dai kaw na ginlawng hku ngai nang hpe jaw de ai; nye a amyu masha mahkra hte a man e nang hpe ngai jaw nga nngai: na a madu jan si mang hpe lup makoi u,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai Abraham gaw dai mung na masha ni a man e gum dagup nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai mung na masha ni na ra hkra, “Nang hkraw n yang gaw nye a ga madat ya e; dai ga dachyawk a jahpu ngai jaw de ga; dai hkap la u; shaloi dai yang nye a madu jan si mang hpe ngai lup makoi na we ai,” ngu nna Ehprun hpe bai tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Ehprun gaw Abraham hpe, “Nye a madu e, nye a ga madat ya e;
  </para>
  <para style="p">
    <verse number="15" style="v" />lap sanit tsa jan sha ging ai ga dachyawk sha mi gaw, nang hte an a lapran e hpa mi rai na a ta? Dai rai nna na a madu jan si mang hpe she lup makoi u,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham mung Ehprun a ga madat wu ai rai nna, Heti kashu kasha ni a man e Ehprun manu dawdan ai hte maren, hpaga ni jai ai gumhpraw lap sanit tsa jan shi hpe shen ya wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Mamre hte tawtap na Makhpela e nga ai Ehprun a ga dachyawk mung, dai ga dachyawk na ginlawng hku hte hpun ni hpe mung, ga jarit grup hku na hpun ni hpe mung,
  </para>
  <para style="p">
    <verse number="18" style="v" />shi a mare chyinghka de shang mashang ni ngu ai, Heti a kashu kasha ni mahkra hte a man e, Abraham madu nga lu na matu tseng di ap ya wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang Abraham gaw, Hkanan mung Hebron ngu ai Mamre hte tawtap na Makhpela ga dachyawk a ginlawng hku hta, shi a madu jan Sara hpe lup makoi wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai ga dachyawk hte dai kaw na ginlawng hku hpe Abraham madu nga na lup tai na matu, Heti a kashu kasha ni shi hpe tseng di ap ya mu ai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Abraham gaw dingla wa nna prat kaba la sai; Yehowa gaw lam shagu hta Abraham hpe shaman ya nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Abraham gaw, shi a nta na asak grau kaba ai hte shi a sut rai mahkra up ai kunhting wa hpe shaga la nna, “Ya, na a lata nye a magyi npru e shawn bang tawn ru;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai sha a matu, ndai ngai chyu nga ai Hkanan mung na shayi sha ni hta na nang n la ya ai sha,
  </para>
  <para style="p">
    <verse number="4" style="v" />nye a dai daw ga, nye a baw sang ni kaw nang sa wa nna ngai sha Isak a matu num sa la ya lu na lam, sumsing lamu hte ginding aga a Karai Kasang Yehowa hta ngai nang hpe dagam shangun de ga,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna kunhting wa gaw, “Dai numsha ndai ga de n hkan nga hkraw nhten; shing rai yang, nang pru kau da ai ga de na a shadang sha hpe ngai bai woi sa lu na rai ni?” Ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Abraham gaw, “Ngai sha hpe dai de nang bai n woi wa ra n ga, sadi nga u:
  </para>
  <para style="p">
    <verse number="7" style="v" />nye wa nta hte nye a dai daw ga na ngai hpe shaga la nhtawm ngai hte ga matut nna, Na a amyu matu ni hpe ndai ga ngai jaw na we ai, nga nna ngai hpe dagam tsun ai sumsing lamu a Karai Kasang Yehowa gaw shi a lamu kasa na a shawng de shangun dat na wu ai rai nna, nye a shadang sha a matu dai yang na num nang la ya lu na rin dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai num nang kaw n hkan wa hkraw yang gaw, ya ngai nang hpe dagam shangun ai lam hte nang lawt mat nu ga: rai timung, ngai sha hpe dai de nang bai woi wa lu na n rai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna kunhting wa gaw shi a Madu Abraham a magyi npu e shi a lata shawn bang da nna, dai lam hta shi hpe dagam yin wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hpang dai kunhting wa gaw shi a madu a gawla-uk hpung na gawla-uk shi byau la nna pru sa wa ai; shi madu a ja hpaga mahkra mung shi gun nga ai: shing rai rawt sa wa nna Aram Naharim mung, Nahura mare de sa du wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Numsha ni hka ja ai shana de na ahkying hta, shi gaw mare shinggan na hka htung makau e gawla-uk ni hpe jahpum tawn nna nga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi shi gaw, “Nye a madu Abraham a Karai Kasang Yehowa e; nye a madu Abraham hpe chyeju madun ya na, dai ni na lam shabyin ya e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yu u, ndai hka htung makau e ngai tsap nga na nngai; ndai mare na shayi sha ni hka ja na nga pru sa wa na mara ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />shaloi, ‘Ngai ntsin lu n-ga na a ntsin di shayu u,’ ngu nna ngai tsun yang, ‘lu u, na a gawla-uk ni hpe mung ngai ja jaw na we ai,’ nga nna tsun pru ai mahkawn gaw, na a mayam Isak a matu nang san da ai num rai u ga: dai rai yang, nye a madu hpe nang chyeju madun ndai gaw ngai chye lu na we ai,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ga dai garai nhtum yang, yu u, Abraham a kanau Nahura a madu jan Milhka shadang sha Behtuela a shayi sha Rebeka gaw, ntsin dibu hpai let pru sa wa ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai mahkawn gaw nachying ahpraw tsawm ai hte, la garai n chye ai hkawnsek rai nga ai: dai hka htung de shi yu nna shi a dibu jahpring la nhtawm bai lung wa ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi dai kunhting wa gaw shi hpang de gat sa nna, “Na dibu hta na ntsin loi mi lu shangun e,” ngu nna tsun wu yang,
  </para>
  <para style="p">
    <verse number="18" style="v" />dai mahkawn gaw, “Lu u, madu e,” nga nna dai dibu alawan shayu nhtawm ntsin jaw lu wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi hpe jaw lu ngut jang, “Na a gawla-uk ni hpe mung hkru hkra ngai ja jaw na we ai,” nga nna,
  </para>
  <para style="p">
    <verse number="20" style="v" />dai dibu na ntsin hpe ntsin htung hta lau lau ru bang da nhtawm, hka bai ja na nga hka htung de gat yu nna gawla-uk ni mahkra a matu ntsin ja nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai wa gaw shi hpe azi yu let, shi a lam Yehowa mazing shading ya ai, rai nga ai n rai nga ai chye lu hkra, atsin sha nga nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gawla-uk ni ntsin lu ngut jang dai wa gaw, shekela chyen mi daram li ai ja shanghkawng hte, shekela shi daram li ai ja lahkawn man mi shaw nna,
  </para>
  <para style="p">
    <verse number="23" style="v" />“nang gade a kasha rai n ta? Ngai e tsun dan e; nan wa ni a nta e anhte nga na shara nga a ni?” Ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi gaw, “Nahura madu jan Milhka a shadang sha Behtuela kasha, rai nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai shi gaw, “Anhte a nta e yi hku hte ushat law law nga ai; nga na shara mung lu ga ai,” ngu nna kahtap tsun wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi dai wa gaw gum dagup nna Yehowa hpe nawku let,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Shi a chyeju matsan dum ai myit hte sadi sahka re ai myit, nye a madu hta na n dawm la ai, nye a madu Abraham a Karai Kasang Yehowa gaw a nga u ga law: lam e hkawm sa nga ai ngai hpe mung, nye madu a kanau ni a nta de Yehowa woi madun ni ai,” nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi dai mahkawn gaw gat wa nna, nta e kanu kaw dai lam wa tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya, Laban mying ai Rebeka a kayung langai mi nga ai: Laban mung hka htung de dai wa hpang de gat sa wa ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai shanghkawng hte shi kajan a lata na lahkawn man mi hpe mu wu ai hte, Dai wa ngai hpe shing nga tsun ai, nga nna kajan Rebeka tsun ai ga na wu ai majaw, dai wa hpang de shi pru sa yu yang, yu u, dai wa gaw hka htung de gawla-uk ni a makau e tsap nga la ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi shi gaw, “Yehowa hta a nga ai wa e shang rit; hpa rai shinggan e tsap nga n ta? Ngai nta lajang da se ai, gawla-uk ni rawng na shara mung nga ai,” ngu nna shachyen wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai majaw dai wa gaw nta de shang nna gawla-uk ni hpe hking raw kau mu ai; madu ni mung yi hku hte ushat jaw ya mu ai, dai wa a lagaw hte shi kaw hkan nang ai ni a lagaw kashin na matu ntsin mung jaw mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shi a man e shat mung baw tawn ya mu ai; rai timung shi gaw, “Nye a amu ngai garai n tsun yang, shat garai n sha na nngai,” ngu wu ai. Nta madu wa gaw, “Rai taw, tsun u,” nga wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi shi gaw, “Ngai gaw Abraham a mayam rai nga nngai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yehowa gaw nye a madu hpe grai shaman ya nu ai rai nna, shi galu kaba nga sai: sagu hpung, dumsu hpung hte aja gumhpraw, lasha yam numsha yam hte gawla-uk lawze re ai law law wa shi hpe jaw nu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nye a madu a madu jan Sara gaw asak kaba sayang, nye a madu a matu shadang sha shaprat ya wu ai rai nna, Abraham gaw lu malu mahkra kasha wa hpe jaw nu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bai nye a madu gaw, ‘Ngai shingbyi nga ai Hkanan mung na shayi sha ni hta na ngai sha a num nang n la ya ai sha;
  </para>
  <para style="p">
    <verse number="38" style="v" />nye wa a nta hte nye baw sang ni hpang de nang wa nna ngai sha a matu num la ya lu na rai ndai,’ ngu nna ngai hpe dagam shangun nngai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ngai gaw, Dai num ngai kaw n hkan wa mayu nhten, ngu nna nye madu hpe tsun we ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Rai timung shi gaw, ‘Ngai hkan hkawm nga ai Yehowa gaw shi a lamu kasa nang hte rau shangun dat nna, nang sa wa ai lam mazing shading ya ai hte, nye a baw sang, nye wa a nta na ngai sha a matu nang num la ya lu na rai ndai;
  </para>
  <para style="p">
    <verse number="41" style="v" />nye a baw sang ni kaw nang du jang, ndai dagam shangun ai lam hte nang lawt nit ga; shanhte nang hpe num n ya dat ma timung, ngai dagam shangun ai lam hta na gaw nang lawt mat na rai nga ai,’ ngu nna tsun dat nngai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ya dai ni ndai hka htung makau e ngai sa du nna, ‘Nye a madu Abraham a Karai Kasang Yehowa e, ndai ngai hkawm sa ai lam nang shaman ya ndai rai yang gaw,
  </para>
  <para style="p">
    <verse number="43" style="v" />yu u, ndai hka htung makau e ngai tsap nga nngai; nang de hka ja sa ai mahkawn langai ngai hpe, Na a dibu na ntsin ngai e loi mi jaw lu e, ngu yang, Lu u, na a gawla-uk ni hpe mung ngai ja jaw na nngai, nga nna ngai e htan tsun ai mahkawn gaw nye madu shadang sha a matu nang Yehowa san da ya ai num rai u ga,’ ngu nna hpyi we ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nye kraw kata e shing ngu tsun ai pyi garai n htum yang, Rebeka gaw dibu hpai let pru sa wa nna, hka htung de ntsin yu ja wu ai: shaloi ngai gaw, ‘Ntsin naw jaw lu e,’ ngu we ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shi mung ntsin dibu alawan shayu nna, ‘Lu u, na a gawla-uk ni hpe mung ngai ja jaw na we ai,’ ngu nngai; shing rai ngai mung lu nngai, gawla-uk ni hpe mung shi ja jaw wu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Shaloi ngai gaw, ‘Nang gade a kasha rai n ta?’ Ngu nna san we ai. Shi gaw, ‘Nahura a madu jan Milhka shaprat ai Behtuela a kasha rai nngai,’ nga nna tsun ai: dai majaw shi a ladi hta dai ja shanghkawng ngai noi ya nna lata hta lahkawn man mi mung hkawn ya we ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Dai shaloi ngai gum dagup nna Yehowa hpe nawku we ai: nye madu kanau a kashu hpe, nye madu a shadang sha a matu la ya lu hkra, ding ai lam hku ngai hpe woi sa ai, nye madu Abraham a Karai Kasang Yehowa hpe ngai shakawn kungdawn nngai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ya ngai pai maga hkra maga chye kayin nga, nye a madu hpe nanhte chyeju hte sadi sahka lam madun na n madun na gaw, tsun dan yu mi,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Dai rai nna Laban yan Behtuela gaw, “Ndai lam gaw Yehowa hpajang ai lam rai nga ai: an gaw nang hpe mai ai hku mung, n mai ai hku mung, n chye tsun dan ga ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Yu u, Rebeka gaw na a man e rai nga ai, shi hpe woi wa u, Yehowa a ga hte maren na madu a shadang sha a madu jan shi tai nu ga,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Abraham a kunhting wa gaw ga dai na jang, Yehowa a man e ga de gum dagup nga ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Bai dai kunhting wa gaw, gumhpraw sumli rai, aja sumli rai hte hpun palawng re ai ni shaw nna Rebeka hpe jaw wu ai; kanu yan kayung wa hpe mung hpu ai baw amyu myu jaw wu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Shaloi she shi mung shi kaw hkan nang ai ni mung lu sha nna dai shana nhtoi shalai mu ai: hpang jahpawt rawt ma ai shaloi, shi gaw, “Ya nye a madu hpang de ngai hpe shabawn dat ma ni,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Kanu yan kayung wa chyawm gaw, “Ndai ma anhte hte nhtoi shi ya dang naw nga nga u ga; shing rai nna she hkan nang wa u ga,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Dai wa gaw, “Ngai hpe hkum hkum da ma ni; ngai hkawm sa ai lam Yehowa shaman ya ni ai; nye madu hpang de lau bai wa lu n ga ngai hpe shabawn dat mi,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Bai shan gaw, “Rai taw, dai ma hpe shaga la nna naw san yu na ga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Shing rai shan gaw Rebeka hpe shaga la nna, “Nang ndai wa kaw hkan wa mayu nni?” Ngu nna san yu mu yang, shi gaw, “Hkan nang wa na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Dai rai nna shanhte gaw shanhte a kajan kasha Rebeka hte shi a shingnan jan hpe mung, Abraham a mayam hte shi kaw hkan nang ai ni hpe mung shabawn dat mu ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Bai shanhte gaw Rebeka hpe, “Anhte a kajan kasha e; nang gaw masha mun mun sen sen ni a kanu tai wa nit ga law; na a nshu nsha ni gaw tinang hpyen ni a mare chyinghka ni hpe madu lu nga manu ga law,” ngu nna shaman ya dat mu ai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Shaloi Rebeka hte shi a shingnan jan gaw rawt nna gawla-uk jawn let dai wa kaw hkan nang wa ma ai: shing rai dai kunhting wa gaw Rebeka hpe woi wa wu ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Ya Isak gaw dingda mung e nga nga ai rai nna, Bera-lahki-roi lam hku hprang du wu ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Shana de myit sumru yu na nga, Isak gaw dai pa de pru sa wa ai; shaloi shi mada dat yu wu yang, yu u, gawla-uk ni wa ra ai mu wu ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Rebeka mung mada yu nna Isak hpe mu wu yang, gawla-uk dinghkung na yu wu ai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Shaloi shi gaw, “Anhte hpe tau la na nga, pa e sa wa ai wa gaw, kadai rai ta?” ngu nna mayam wa hpe san yu wu ai. Mayam wa gaw, “Nye a madu rai nga ai,” ngu nna, htan wu ai. Dai majaw shi a man magap la nna myi man magap wu ai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Dai mayam mung shi galaw ai lam yawng Isak hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="67" style="v" />Isak gaw kanu Sara a sum hta shi hpe jashawn la wu ai; Rebeka hpe shi la wu ai rai nna, shi gaw shi a madu jan rai nga ai: Rebeka hpe shi tsawra wu ai rai nna, Isak gaw kanu a yawn hta na bran nga ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Abraham gaw num bai la wu ai; shi a amying gaw Ketura rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai num gaw shi a matu Zimran, Yokshan, Medan, Midian, Yishbak, Shua hte shaprat ya wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yokshan gaw Sheba hte Dedan yan hpe shaprat ya wu ai. Dedan a kasha ni gaw, Ashurim, Letushim, Leumim hte rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Midian a kasha ni gaw, Ehpa, Epera, Hanuk, Abida, Eleda hte rai ma ai: dai hte gaw Ketura kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham chyawm gaw shi lu ai sut yawng Isak hpe jaw wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lashi num ni hta na Abraham lu ai kasha ni hpe mung, Abraham kumhpa karan jaw wu ai rai nna, shi naw hkrung nga yang, shi a kasha Isak kaw na sinpraw ga de shanhte hpe dat dat mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya, Abraham a hkrung nga ai nhtoi hte gaw latsa e sanit shi manga ning rai lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Abraham gaw aprat kaba nna dingla sai hte, nhtoi dik ai hta nsa htum nna si mat wa ai: shing rai shi a kaji kawoi hpawng nga ai de shi du wa ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi shi a kasha Isak yan Ishmaela gaw, Mamre hte tawtap na Heti amyu Zahura kasha Ehprun a ga dachyawk e nga ai Makhpela ginlawng hku hta kawa hpe makoi mayang di mu ai;
  </para>
  <para style="p">
    <verse number="10" style="v" />dai gaw Heti a kashu kasha ni kaw na Abraham mari la ai ga dachyawk rai nga ai: Abraham hte shi a madu jan Sara hpe dai yang e makoi ai rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya, Abraham si mat ai hpang Karai Kasang gaw kasha Isak hpe shaman ya wu ai; Isak gaw Bera-lahki-roi makau e anga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya, ndai gaw Sara a shingnan, Egutu num Hagara, Abraham a matu shaprat ya wu ai, Abraham a kasha Ishmaela a lakung lama ni rai nga ma ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />dai gaw Ishmaela kashu kasha ni hta tinang nang a amyu lakung mying rai nga malu ai: Ishmaela a kasha la hpunglat gaw Nabaiyut; dai kaw nna Kedara, Adebela, Mibsam;
  </para>
  <para style="p">
    <verse number="14" style="v" />Mishma, Duma, Masa;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadad, Tema, Yetura, Nahpisha, Kedma hte rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ishmaela kashu kasha ni ndai hte rai nga ma ai: dai hte gaw tinang a kahtawng hte tinang a dabang hku hkan nna amyu myu mying ai du shi lahkawng rai nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ishmaela hkrung nga ai nhtoi hte gaw latsa e sumshi sanit ning rai lu ai; shaloi shi nsa htum nna si mat ai; shing rai shi a kaji kawoi hpawng nga ai de shi du wa ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte gaw Hawila kaw nna Egutu mung hte tawtap re ai, Ashuri mung hprang ai lam Shura du hkra nga ma ai: dai rai nna shi a shara gaw shi kahpu kanau nlang hte a masawn e rai nga lu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Da ndai gaw Abraham a kasha Isak a lakung lama ni a lam rai nga ai; Abraham gaw Isak hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isak gaw asak mali shi ning du jang, Hpadan Aram na Suri masha Behtuela a shayi sha Suri masha Laban a kajan Rebeka hpe la wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Isak gaw, shi a madu jan maudung dung ai majaw, shi a matu Yehowa hpe hpyi wu ai; dai rai nna Yehowa shi a ga madat ya ai hte shi a madu jan na-um nasin rai wa lu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi dai hkritung na ma yan gaw shada gasat hkat nga ai; dai rai nna kanu gaw, “Ngai hta ning nga ai gaw, hpa majaw rai nga ai i?” Nga ai. Shaloi Yehowa kaw san yu na shi sa wa ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna Yehowa gaw, “Na a hkum hta amyu lahkawng rawng nga lit dai, Hkritung nna pyi amyu lahkawng karan nga ma ai; Amyu mi gaw amyu mi hta grau nna n-gun ja na ra ai, kaba ai wa mahtang kaji ai wa kaw yam na ra ai,” ngu nna shi hpe htan dat wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ya shi a shangai nhtoi gu jang, yu u, shi a hkritung e kasha marun rawng nga lu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shawng shangai pru ai wa mahtang gaw, mun tu ai nba zawn hkum ting hkyeng nga ai: dai majaw shi hpe Esaw ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />De a hpang e kanau wa gaw, Esaw a lahtin manat let shangai pru wa ai; dai rai nna shi hpe Yaku ngu nna shamying mu ai: dai kasha yan hpe shaprat ai shaloi, Isak a asak kru shi ning du sa lu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai ma yan gaw kaba wa nna, Esaw gaw jaugawng hpaji rawng ai rai nna nam e nga ai wa tai wa ai: Yaku chyawm gaw myit shing di ai hte sum e nga ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isak gaw Esaw jaw ai shan lu sha ya wu ai rai nna, shi hpe tsawra wu ai: Rebeka chyawm gaw Yaku hpe tsawra wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lani mi na Yaku si shadu nga yang, Esaw gaw ba la ai hte nam de na pru wa ai; dai rai nna Esaw gaw Yaku hpe,
  </para>
  <para style="p">
    <verse number="30" style="v" />“Dai hkyeng ai si ngai hpe araw shangun e, ngai ba la ni ai,” ngu wu ai: dai re ai majaw shi hpe Edom ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Yaku gaw, “Dai ni jang na a hpu lat aya ngai e dut ya da e,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Esaw gaw, “Ngai si wa magang ni yang me, nye a hpu lat aya ngai hpa di na a ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai, Yaku gaw, “Rai taw dai ni jang ngai e dagam da e,” ngu wu ai; dai majaw shi dagam nna Yaku hpe shi a hpu lat aya dut kau da wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi Yaku gaw Esaw hpe muk hte shapre shat mai jaw wu ai rai nna, dai lu sha nhtawm, shi bai rawt hkawm mat wa ai: shing rai Esaw gaw shi a hpu lat aya hpe n gawn n sawn di wu ai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Abraham a aprat e wa ai hku wa hta kaga, dai mung e hku bai hku nga ai. Dai rai nna Isak gaw Hpiliste mung na Hkawhkam Abimelek nga ai shara Gerara de sa wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Yehowa gaw shi kaw dan pru nna, “Egutu mung de hkum sa et; ngai nang hpe madun na ra de ai mung de nga nga u:
  </para>
  <para style="p">
    <verse number="3" style="v" />ya nang nga ai ndai mung hta anga nga u; shaloi ngai nang hte rau anga nga nna, nang hpe shaman ya na de ai: kaning rai nme law, nang hte na a amyu matu ni hpe ndai mung ting ngai jaw na made ai; na nwa Abraham hpe ngai dagam ai ga nga nga ai hte maren ngai shatup na we ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a amyu matu ni hpe lamu a shagan zawn ngai shalaw na mawe ai rai nna, na nshu nsha ni hpe ndai mung ting ngai jaw na mawe ai: na a aru arat a marang e ga ntsa na masha amyu nlang gumring gumrat re ai chyeju lu la na mara ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />kaning rai nme law, Abraham gaw nye a nsen madat ai rai nna, ngai htet da ai ga, ngai jep ai tara, ngai hpajang ai lam, ngai tawn da ai tara hkan shatsup wu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya Isak gaw Gerara e anga nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai yang na masha shi a madu jan a lam san mu ai rai nna, shi gaw, “Ngai jan re ai,” ngu wu ai: kaning rai nme law, Rebeka ahpraw tsawm ai num rai nga ai majaw, ndai yang na ni shi a majaw ngai e n sat kau mi ga nga nna shi myit ai majaw, “Nye madu jan re ai,” n ngu wam wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya dai yang e nhtoi tsawmra na sayang, Hpiliste mung na Hkawhkam Abimelek gaw hkuwawt hku na yu dat wu yang yu u, Isak gaw shi a madu jan Rebeka hte makrai nga ai hpe, mu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai majaw Abimelek gaw Isak hpe shaga la nna, “Yu u, gaja wa shi gaw na a madu jan nan rai nga lit dai; dai re ai mi, shi ngai jan rai nga ai nga nna, hpa rai tsun n ta?” ngu nna daru wu yang, Isak gaw, “Shi a majaw ngai n si n ga, ngu nna rai nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Abimelek gaw, “Nang anhte hta ndai a galaw ai gaw hpa rai nga a ta? ndai yang na marai langai ngai na a madu jan hte ndum shami yup hkrup taw gaw, anhte a ntsa e nang yubak shapraw na rai nga ndai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Abimelek gaw shi a amyu masha ni nlang hte hpe, “Ndai wa hpe mung, shi a madu jan hpe mung shut ai wa gaw, teng teng si lu na re ai,” ngu nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya, Isak gaw dai mung e yi galaw wu ai rai nna, dai shaning hta htam latsa lu la wu ai: Yehowa mung shi hpe shaman ya wu ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai wa gaw galu kaba wa ai rai nna, nachying wa kaba wa ai du hkra a rawt wa nga ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />sagu dumsu re ai yamnga sut hte nta masha law law shi hta hpring nga ai rai nna, Hpiliste masha ni shi hpe manawn da mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi a kawa Abraham a aprat e, kawa a mayam ni htu ai hka htung nlang hte mung, Hpiliste masha ni e ga hte kaput nna magap kau ya mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hta n ga Abimelek gaw Isak hpe, “Nang anhte hta n-gun grau ja nga ndai majaw, anhte kaw na pru wa nu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Isak gaw dai yang na pru nhtawm, Gerara a kadit e wa mahta nna dai kaw anga nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Isak gaw, kawa Abraham a aprat e htu nna Abraham si mat ai hpang e Hpiliste masha ni kaput kau ai hka htung ni hpe bai htu hpaw ai hte, de a amying ni hpe mung shi kawa shamying da ai hte maren, bai shamying wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Isak a mayam ni mung dai kadit hta htu mu ai rai nna, hka npun pru ai hka htung mu hkrup mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna, Gerara na nga rem ai ni, “Ndai gaw anhte a hka rai nga ai,” nga nna Isak a nga rem ai ni hte kashun hkat ma ai: shing rai kashun hkat ma ai majaw, hka htung dai hpe Esek ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang e hka htung kaga shanhte htu ma ai; dai hta mung kashun hkat ma ai majaw, Sitna ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai dai yang na shi htawt nhtawm, hka htung kaga htu wu ai; dai hta gaw shanhte n kashun hkat masai: dai rai nna, Ya Yehowa anhte hpe nga shara dam lada jaw ma ni ai majaw, ndai mung e anhte mayat maya wa na saga ai, nga nna dai hpe Regobut ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai dai kaw na shi htawt nna Berasheba de lung wa ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai shana e Yehowa gaw shi kaw dan pru nna, “Ngai gaw na nwa Abraham a Karai Kasang rai nga nngai; hkum hkrit et, ngai nang hte rau rai nga nngai; ngai nang hpe shaman ya na de ai rai nna, nye a mayam Abraham a majaw, na a nshu nsha ni hpe shalaw jahtam na we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai yang e shi tawn hkungri galaw da nna Yehowa a mying nsang hpe shaga wu ai; dai kaw e shi a sum mung gap da wu ai: Isak a mayam ni mung dai yang e hka htung htu mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai shaloi Abimelek gaw shi a jinghku wa Ahuzat hte hpyen du wa Hpikula hpe woi nna, Gerara kaw nna Isak hpang de sa du ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai majaw Isak gaw, “Nanhte ngai hpe n dawng nna, nanhte kaw na shaden kau dat myit htawm e, ya hpa rai ngai kaw sa du myit ta?” ngu nna shanhte hpe hkap san mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw, “Yehowa nang hte rau nga nga ai gaw anhte teng teng mu chye saga ai: dai rai nna nang hte anhte a lapran e ga shaka tawn da ga;
  </para>
  <para style="p">
    <verse number="29" style="v" />Anhte nang hpe n shut ai sha, nang hpe kaja ai hku galaw nna, ngwipyaw ai hte dat dat saga ai hte maren nang anhte hpe n kaja ai hku hpa mung n galaw n-ga, nang hte anhte a ga shaka tawn da ga ngu nna sa ga ai: nang chyawm gaw Yehowa a shaman lu la ai wa rai nga ndai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Isak gaw shanhte hpe lusha daw mu ai rai nna shanhte lu sha ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shanhte gaw jahpawt jau jau e rawt nna, shada ga shaka dagam ma ai: shaloi Isak shanhte hpe shabawn dat mu ai rai nna, ngwipyaw ai hte shi kaw nna shanhte wa mat ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai shani jang Isak a mayam ni gaw, Anhte hka mu sagaw ai, nga nna shanhte htu ai hka htung a lam shi hpe wa tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shaloi dai hpe Sheba ngu nna shamying wu ai. Dai majaw dai ni du hkra dai yang de nga ai mare hpe Berasheba ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ya, Esaw gaw asak mali shi ning du jang, Heti amyu na Beri a shayi sha Yudit hte, Heti amyu Elon a shayi sha Basemat yan hpe la wu ai:
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai yan gaw Isak hte Rebeka a matu myit ru shara sha rai nga ma ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Isak dingla nna shi a myi amam ai hte myi n mu mat sayang, shi a kasha kaba Esaw hpe, “Ngai sha e,” ngu nna shaga wu ai: shi mung, nang nga nga nngai, ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi kawa gaw, “Yu u, ngai dingla ni ai, ngai si na nhtoi ngai n chye nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna, ngai garai n si yang, nye a myit masin nang hpe shaman ya de ga, na a jaugawng rai ngu na pala ndum hte ndan la lang nna, nye a matu shan sa tam na prang de sa su:
  </para>
  <para style="p">
    <verse number="4" style="v" />shing rai ngai sha ra ai hku shan shatmai shadu nna, ngai sha ya lu n ga, ngai hpang de la wa rit,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isak gaw shi a kasha Esaw hpe shing nga tsun ai ga Rebeka e na la wu ai. Ya Esaw gaw shan sa tam na nga prang de sa mat wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai laman e Rebeka gaw shi a kasha Yaku hpe shaga la nna, “Yu u, na nwa gaw, ‘Ngai garai n si yang, Yehowa man e nang hpe shaman ya de ga,
  </para>
  <para style="p">
    <verse number="7" style="v" />nye a matu shan la wa nna ngai sha na shan shatmai shadu u,’ nga nna na nhpu Esaw hpe tsun ai ga ngai na se ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna ngai sha gaw, ngai tsun matsun madat u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bainam hpung de sa su; tsawm ai bainam kasha lahkawng la wa rit; na nwa sha ra ai hku shan shatmai ngai shadu we ga:
  </para>
  <para style="p">
    <verse number="10" style="v" />na nwa garai n si yang, nang hpe shaman jaw da u ga, dai shatmai shi sha na matu, nang shi hpe wa jaw na rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yaku chyawm gaw, “Yu u, nye hpu Esaw amun tu ai wa rai nga ai; ngai gaw akrin sha re ai wa rai nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Wa ngai hpe masawp yu na ra ai nhten; shaloi shi a man e hkalem ai wa ngai tai nna, shaman ai mahtang gaw n lu la, matsa kau ai chyawm ngai hkrum sha na ra ai,” ngu nna kanu Rebeka hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai timung kanu gaw, “Ngai sha e, nang hkrum ai matsa mawa gaw nye ntsa e mara u ga; nang gaw nye a ga she madat u, bainam kasha sa la wa rit,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi shi sa la nna kanu kaw dun wa wu ai: kanu chyawm gaw kawa sha ra ai hku shan shatmai shadu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hta kaga Rebeka gaw, nta e shi kaw nga ai kasha kaba Esaw a tsawm ai hpun palawng la nna, kasha kaji Yaku hpe jahpun wu ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />bainam kasha hpyi hte mung lata hte du krin ai maga de kayawp ya wu ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />shing rai shi shadu ai shan shatmai hte muk hpe kasha Yaku a lata hta jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Yaku gaw kawa hpang de shang nna, “Wa e,” ngu wu ai; shi gaw, “Nga nga nngai; ngai sha e, nang kadai mahtang rai n ta?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yaku gaw, “Ngai na nsha lat wa Esaw rai nga nngai; nang wa tsun ai hte maren ngai galaw se ai; rawt nna dung u, nang wa a myit masin ngai hpe shaman ya na, ndai nye a shan shatmai sha ya e,” ngu nna kawa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Isak gaw, “Ngai sha e, kaning rai nme ndai hte wa nang lawan lu n ta?” ngu nna kasha hpe hkap san wu yang, shi gaw, “Na a Karai Kasang Yehowa ngai hpe lu loi shangun ai majaw rai nga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rai timung Isak gaw, “Ngai sha e, nang ngai sha Esaw re ai kun? nang hpe ngai masawp yu de ga, ngai hpang de sit wa yu rit,” ngu nna Yaku hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yaku mung kawa Isak hpang de sit wa wu ai rai nna, kawa gaw shi hpe masawp yu let, “Nsen gaw Yaku a nsen, lata chyawm gaw Esaw a lata rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai, shi a lata gaw kahpu Esaw a lata zawn mun tu nga lu ai majaw, shi hpe Yaku re ai n chye nna, shi hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rai timung shi bai san wu ai gaw, “Nang gaja wa ngai sha Esaw rai nga n ni?” Ngu wu ai: shi mung, “Rai nga nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai rai nna kawa gaw, “Ngai kaw la bang wa rit; nye a myit masin nang hpe shaman ya na, nang ngai sha a ashan ngai sha we ga,” ngu wu ai: shaloi shi la bang wa wu ai rai nna kawa gaw hkap sha wu ai; tsabyi mung jaw wu ai rai nna shi lu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai kawa Isak gaw, “Ngai sha e, ngai kaw sit wa nna, ngai e pup e,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yaku mung sit wa nna shi hpe pup wu ai: shaloi kawa gaw shi a palawng sung manam la nhtawm, “Yu u, ngai sha a sung gaw, Yehowa shaman ya ai yi hkauna nngawt hte bung nga ai:
  </para>
  <para style="p">
    <verse number="28" style="v" />Karai Kasang gaw lamu na mari hte Ga na sau tung mung, nai mam law law hte tsabyi jahku mung, nang hpe jaw na nit dai:
  </para>
  <para style="p">
    <verse number="29" style="v" />Masha amyu ni nang kaw mayam tai nna, Masha mungdan ni na man e dingnyawm nga manu ga; Na nhpu nnau ni a Madu nang tai nna, Ning nu a kasha ni nang kaw dingnyawm nga manu ga; Nang hpe matsa ai ni gaw matsa mawa hkrum mu ga, Nang hpe shaman ai ni gaw shaman ai hkrum mu ga,” ngu nna, shi hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ya Yaku gaw kawa Isak a shaman lu la ngut nna, kawa Isak man na Yaku rawt mat wa ai hpang hkring mi rai jang, kahpu Esaw gaw shan tam ai de na pru wa ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi mung shan shatmai shadu nna kawa kaw la wa nhtawm, “Nye wa e, rawt nna, na a myit masin ngai hpe shaman ya na, ngai ning sha a shan sha ya e,” ngu nna kawa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaloi kawa Isak gaw, “Nang kadai rai nga n ta?” ngu nna san wu yang, shi gaw, “Ngai ning sha lat wa Esaw rai nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai majaw Isak gaw, “Rai taw, nang garai n du yang ngai kaw shan shatmai la sa ai wa gaw, kadai wa rai na sata? dai ngai sha nna shi hpe shaman ya kau se hka; rai sa, dai wa gaw shaman ai teng teng lu la na nu ai,” nga nna grai mau gari ai hte tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kawa tsun ai ga na jang Esaw gaw nsen shaja nna jahtau hkrap let, “Wa e, ngai e mung shaman ya e,” nga nna kawa hpe hpyi wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kawa gaw, “Na nnau wa hpaji hte sa nna na a shaman chyeju la kau nu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai rai nna Esaw gaw, “Ning re ai majaw shi hpe Yaku ngu ai n rai ni? Ya ndai hte lahkawng lang shi ngai hpe maw sha dang kau ni ni? Nye a hpu lat aya mung shi la kau nu ai: ya nye a shaman chyeju mung bai la kau ya ni ai: nye a matu gaw shaman chyeju langai mi muk n ngam da sa ni?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shaloi Isak gaw, “Yu u, ngai shi hpe na a madu tai u, ngu se ai; shi a kahpu kanau ni yawng shi kaw yam mu ga ngu se ai; nai mam hte tsabyi jahku e mung shi hpe shadaw se ai: dai rai nna, ngai sha e, na a matu ngai kaning chye di na rai ta?” ngu nna Esaw hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Esaw gaw, “Wa e, shaman chyeju langai sha she lu n ni? Wa e, ngai hpe mung shaman ya e,” nga nna nsen shaja ai hte jahtau hkrap let kawa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai rai nna kawa Isak gaw, “Gaja wa, na nga shara gaw, sau tung rawng ai ga hte Lamu ntsa na mari hkrat ai hte, tsan wa na ra ai;
  </para>
  <para style="p">
    <verse number="40" style="v" />Na nhtu hte nang hkrung nga lu na ndai, Na nnau wa kaw nang yam lu na rin dai: Rai timung, nang ja pru ai nhtoi e, Shi shagun ai kandang hpe na a du hta na nang daw kau ya lu na rin dai,” ngu nna shi hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ya, Yaku hpe kawa shaman ya ai chyeju a majaw Esaw gaw Yaku hpe n dawng da wu ai rai nna, Wa a majaw sharung shayawt na nhtoi gaw ni wa sai; dai shaloi e ngai nau Yaku hpe ngai sat kau na we ai, nga nna shi a kraw e myit let tsun nga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shing nga nna kasha kaba Esaw tsun ai ga hpe Rebeka e shana ya mu ai; dai rai nna shi gaw kasha Yaku hpe shaga la nna, “Yu u, na nhpu Esaw gaw nang hpe sat nna masin jasi na maw nga ai;
  </para>
  <para style="p">
    <verse number="43" style="v" />dai majaw ngai sha gaw, nye ga madat u; rawt u, Haran e nga ai ngai yung Laban hpang de hprawng sa wa su:
  </para>
  <para style="p">
    <verse number="44" style="v" />na nhpu a masin kawp hkra shi kaw tawng marang mi sa nga su:
  </para>
  <para style="p">
    <verse number="45" style="v" />na nhpu masin kawp nna nang shi hpe di ai amu shi malap kau jang, ngai shaga shangun dat nna, nang hpe dai kaw na ngai woi la na de ai: lani jan sha hta nan lahkawng hpe hpa rai sum lu na rai ta?” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shaloi Rebeka gaw Isak hpe, “Ndai Heti amyu num ni a majaw nye a asak hpe ngai ndawt la ni ai; ndai mung na num ni zawn rai dam ai Heti amyu hta na Yaku a num a la ya yang gaw, ngai naw hkrung nga na hpa akyu nga a ta?” ngu wu ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai rai nna Isak gaw Yaku hpe shaga la nna shi hpe shaman ya let, “Hkanan amyu hta na num nang la lu na n rai;
  </para>
  <para style="p">
    <verse number="2" style="v" />rawt u, Hpadan Aram na, na nnau a kawa Behtuela nta de sa wa su; dai yang e, na nnu a kayung Laban a shayi sha ni hta na num sa la u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chyahtum chyalai n-gun rawng ai Karai Kasang gaw nang hpe shaman ya nna nang hpe shalaw jahtam na hte nang hpe mayat maya shangun nhtawm amyu kaba shatai u ga:
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang Abraham hpe jaw ai, ya nang chyu nga ai ga ndai, na a Sali wunli tai na matu, nang hpe mung, na nshu nsha ni hpe mung, Abraham a shaman chyeju shi jaw myit ga,” ngu nna hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Isak gaw Yaku hpe dat dat wu ai rai nna, shi gaw Hpadan Aram e nga ai, shi hte Esaw a kanu Rebeka a kayung Suri masha Behtuela a kasha Laban hpang de sa wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai Isak gaw Yaku hpe shaman ya nna, Hpadan Aram mung e num sa la u ga nga shangun dat wu ai mung, shi hpe shaman ya wu ai shaloi, Hkanan mung na num n la lu na ndai nga nna hkang da wu ai mung;
  </para>
  <para style="p">
    <verse number="7" style="v" />Yaku gaw kanu yan kawa ga madat nna Hpadan Aram de sa mat wa ai mung;
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkanan amyu num ni hpe kawa Isak n ra wu ai mung, Esaw mu chye wu yang;
  </para>
  <para style="p">
    <verse number="9" style="v" />shi gaw Ishmaela hpang de sa wa nna, shawng na madu jan yan hta kaga, Abraham shaprat ai Ishmaela a kasha, Nabaiyut a kajan Mahalat hpe sa la wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Yaku gaw Berasheba kaw na pru nhtawm Haran maga de sa wa ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi shara mi kaw du yang, jan du sai majaw, dai yang e dai shana nhtoi shalai na nga, dai shara na nlung langai mi shi hta la nhtawm dai bunghkum let yup nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai yup nga yang shi yup man mu wu ai gaw, yu u, ga ntsa na lakang langai mi htan nga ai: lakang baw gaw htaw sumsing lamu du hkap nga ai: Karai Kasang a lamu kasa ni mung dai hta e lung wa yu wa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai, yu u, Yehowa gaw lakang baw e tsap nga nna, “Ngai gaw na nji Abraham a Karai Kasang, na nwa Isak a Karai Kasang Yehowa rai nga nngai; ya nang kaleng taw nga ai ga ndai, nang hpe mung na a amyu matu ni hpe mung ngai jaw na made ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na nshu nsha ni gaw ga na nhpu zawn law htam wa na mara ai; nang gaw sinpraw sinna, dingdung, dingda maga hkan du hkra kung dam wa na rin dai rai nna, nang hte na a amyu matu ni a marang e ga ntsa na masha amyu shagu gumring gumrat re ai chyeju lu la shajang na mara ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yu u, ngai nang hte rau rai nga nngai; nang hkawm sa wa ai lam shagu de ngai hkan pau nga na ring ngai; ndai mung de ngai nang hpe bai woi wa na de ai: nang hte ngai shaka da ai ga n tup tup gaw, ngai nang hpe kau da na n rai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Yaku yup hprang nna, “Gaja wa, nang e Yehowa nga nga a hka; nga wa gaw dai n chye nngai,” nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai shi gaw hkrit la ai hte, “Shara ndai gaw ja ja hkrit mai ai shara rai nga a hka; shara ndai kaga n rai, Karai Kasang a nta hte sumsing lamu a chyinghka lam rai nga a hka gaw!” nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yaku gaw dai jahpawt jau jau rawt nna, shi bunghkum ai nlung la nhtawm mahtan daw di nna jun da wu ai: de a pungding e namman mung ru bun da wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai shara hpe Behtela ngu nna mung shamying da wu ai: dai mare a shawng na amying chyawm gaw Luza rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hta e Yaku gaw, “Ngai nye wa nta de ngwipyaw ai hte bai du wa lu hkra, Yehowa nye a Karai Kasang tai nga nna,
  </para>
  <para style="p">
    <verse number="21" style="v" />Karai Kasang shi ngai hte rau nga nga ai hte, ya ngai hkawm sa wa ai lam hkan e ngai hpe hkan pau let, sha na shat hte bu hpun na hpun palawng ngai hpe jaw a yang gaw,
  </para>
  <para style="p">
    <verse number="22" style="v" />ndai mahtan daw di nna ngai jun ai nlung mung, Karai Kasang a nta tai na ra ai: nang ngai hpe jaw ai mahkra hta na htamshi hta htammi, ngai nang hpe teng teng wa jaw na ring ngai,” ngu nna shaka dagam da wu ai.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yaku hkawm sa wa nna sinpraw mung masha ni a ga de sa du ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi shi mada yu wu yang, dai prang e hka htung langai mi nga ai, mu wu ai; dai hka htung na ntsin hte sagu hpung ni hpe ntsin jaw ga ma ai rai nna, dai makau e sagu hpung masum hpum nga ma ai: dai hka htung a magap gaw nlung kaba rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai kaw e sagu hpung yawng hpe jahpawng da ngut jang, shanhte gaw dai hka htung mahka na nlung hpe galau kau nna, sagu ni hpe ntsin jaw nhtawm, dai nlung hpe hka htung mahka e bai magap da da di mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Yaku gaw, “Hpunau ni e, nanhte kanang na rai myit ta?” ngu nna san wu yang, shanhte gaw, “Haran na rai ga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shi gaw, “Nahura a kashu Laban hpe nanhte chye myit ni?” ngu nna bai san wu yang, shanhte gaw, “Chye ga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi, “Shi hkam kaja nga a ni?” ngu nna bai san wu yang, shanhte gaw, “Hkam kaja nga ai: yu u, shi a shayi sha Rahkela mung sagu gawt nna sa wa ra ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai Yaku gaw, “Yu mu, jan naw rawng nga ai; yamnga ni hpe jahpawng na aten garai n re ai; sagu ni hpe ntsin shayaw nhtawm naw sa rem mu,” ngu nna shanhte hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw, “Sagu hpung mahkra du hpawng ma nna ndai nlung hpe garai n galau kau yang gaw, anhte n rai lu ga ai: galau kau ngut yang she anhte sagu ni hpe ntsin jaw lu ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing nga shanhte hte naw shachyen nga yang, Rahkela mung kawa a sagu ni rem ai rai nna, sagu gawt let du sa ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku gaw katsa wa Laban a shayi sha Rahkela hte, shi a sagu ni hpe mu jang, sit sa nna, dai hka htung mahka na nlung hpe galau kau nhtawm katsa wa Laban a sagu ni hpe ntsin jaw wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Yaku Rahkela hpe pup nhtawm nsen shaja nna hkrap wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yaku shi gaw Rahkela a kawa a kahkri, Rebeka a kasha re ai gaw, Rahkela hpe tsun dan wu ai majaw, shi gaw gat wa nna kawa hpe wa tsun shana wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya Laban gaw shi a kahkri Yaku a lam na jang, shi hpe tau la na gat sa wa nhtawm, shi hpe ahpum let pup nna nta de woi wa wu ai: Yaku mung shi a lam yawng Laban hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai rai nna Laban gaw, “Gaja wa nang gaw nye a nrut nra hte sai shan rai nga ndai,” ngu wu ai. Shing rai shi kaw shata mi daram nga nga sai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Laban gaw, “Nang ngai hkri rai nga ai; dai re ai majaw nang ngai hpe kaman a galaw yam kau na rai ni? na a shabrai gade hku tawn na ngai e tsun e,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya Laban shayi sha lahkawng lu da wu ai: kaba ai a amying gaw Lea, kaji ai a amying gaw Rahkela rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lea gaw myi mam mam re ai; Rahkela chyawm gaw hkumhkrang tsawm ai hte ahpraw asam htap nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yaku gaw Rahkela hpe tsawra wu ai rai nna, Laban hpe, “Na shayi sha kaji Rahkela a matu, ngai nang hpe sanit ning galaw jaw na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban mung, “Masha kaga hpe ya sha na hte nang hpe ya yang grau mai nga ai; ngai kaw nga ga,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Yaku gaw Rahkela a matu sanit ning galaw jaw wu ai; Rahkela hpe tsawra nga ai re ai majaw, gade ya na ai zawn n nawn wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ya nhtoi du yang Yaku gaw, “Ladaw tawn ai nhtoi du sai; nye a num ngai la ni ga, ngai e ya sha ni,” ngu nna Laban hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Laban gaw dai yang na ni nlang hpe shaga nna poi galaw wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shana rai jang shi a shayi sha Lea hpe Yaku kaw shi woi shawn tawn da wu ai; Yaku mung shi kaw shang wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Laban gaw shi a mayam Zilhpa hpe Lea a shingnan tai na jaw wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya, jahpawt rai jang, yu u, Lea rai nga lu ai; dai majaw Yaku gaw Laban hpe, “Ndai nang ngai hpe galaw ndai gaw hpa rai nga a ta? Rahkela a matu ngu nna she ngai nang hpe galaw jaw de ai n rai ni? dai re ai mi hpa majaw ngai hpe maw sha kau n ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban gaw, “Kaba ai hpe garai n ya yang kaji ai hpe shawng ya sha ai gaw anhte ga e n galaw ga ga ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />ndai nhtoi bat mi naw la u: dai hpang sanit ning nang naw galaw jaw na matu kaga hpe mung anhte ya na ga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yaku mung dai ga hte maren bat mi naw la nga ai rai nna, Laban gaw shi a shayi sha Rahkela hpe mung ya sha wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Laban gaw, Rahkela a shingnan shatai na, shi a mayam Bila hpe sharung dat wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rahkela kaw mung shi shang nna, Lea hta Rahkela hpe grau tsaw wu ai: shing rai sanit ning tup naw bai galaw jaw wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ya Lea gaw n dawng n yawt hkrum nga ai hpe Yehowa mu ya wu ai rai nna, kashu kasha shaprat na lam hpaw ya wu ai; Rahkela chyawm gaw maudung dung nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaloi Lea na-um nasin rai nna shadang sha shangai wu ai. Shi hpe Rubin ngu nna shamying wu ai: kaning rai nme law, shi gaw, “Ngai nga karen nga ai hpe Yehowa mada yu ni ai; dai rai nna ya nye a madu wa ngai hpe tsawra na ni ai,” nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai shi na-um nasin rai nna shadang sha shangai wu ai. Shaloi shi gaw, “Ngai n dawng n yawt hkrum nngai hpe Yehowa na ya ni ai majaw, ngai hpe ndai ma mung jaw ni ai,” nga nna shi hpe Simun ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bai shi na-um nasin rai nna shadang sha shangai wu ai. Shaloi shi gaw, “Ya, nye a madu wa ngai hte kanawn na ra ai; ngai shi a matu shadang sha masum shangai ya se ai,” nga nna shi hpe Lewi ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Bai shi na-um nasin rai nna shadang sha shangai wu ai. Shaloi shi gaw, “Ya gaw ngai Yehowa hpe shakawn na we ai,” nga nna shi hpe Yuda ngu shamying wu ai: dai hpang kasha n shaprat ai shalung nga mat ai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Rahkela gaw Yaku a matu kashu kasha n shaprat ya dum wu ai majaw, kana jan hpe manawn nna Yaku hpe, “Ngai e kasha jaw e; dai n rai ngai si mat na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna Yaku gaw Rahkela hpe masin pawt nna, “Ngai gaw nang hpe asi n si shangun ai, Karai Kasang a malai rai nga a ni?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Rahkela gaw “Yu u, nye a shingnan Bila nga nga ai; nye a lahpyen hta shi kasha shangai ya nna, ngai mung shi a marang e kasha shaprat lu n ga, shi kaw shang u, ngu nna Yaku hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai shi a madu jan tai na shingnan Bila hpe jaw wu ai; Yaku mung shi kaw shang wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Bila na-um nasin rai nna, Yaku a matu shadang sha shangai wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna Rahkela gaw, Karai Kasang nye a lam jeyang ya ni ai; nye a ga mung madat ya ni ai rai nna ngai hpe shadang sha jaw ni ai, nga nna shi hpe Dan ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya Rahkela shingnan Bila gaw na-um nasin bai rai nna, Yaku a matu lahkawng lang ngu na shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Rahkela gaw, Ngai na jan hpe ngai aja awa kamu hkat nna dang kau se ai, nga nna shi hpe Naphtali ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Lea gaw shi kashu kasha n shaprat ai shalung mat ai hpe dum wu yang, Yaku a madu jan shatai na shi a shingnan Zilhpa hpe jaw wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Lea a shingnan Zilhpa gaw Yaku a matu shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Lea gaw, Gam rawng nga ai, nga nna shi hpe Gad ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai Lea a shingnan Zilhpa gaw Yaku a matu lahkawng lang ngu na shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai rai nna Lea gaw, Ngai a lu ni ai; masha ni a shayi sha ni ngai hpe a lu ai jan ngu na ma ni ai, nga nna shi hpe Ashu ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Rubin gaw hkaulan mam dan ai aten e pru hkawm nna, mam yi hkan e dudim si mu wu ai rai nna kanu Lea kaw la wa wu ai. Shaloi Rahkela gaw Lea hpe, Na nsha la wa ai dudim si ngai e nkau mi jaw e, ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai rai nna Lea gaw Nye madu wa la kau ya da nhtawm, hpa n re ai zawn nawn wu ni? ya ngai sha a dudim si mung nang naw la mayu n hka i? Ngu wu ai. Rahkela gaw, Dai rai taw, ning sha a dudim si matu, dai na nang kaw shi yup u ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shana de Yaku pa de na wa jang Lea gaw shi hpe tau la na pru sa nna, Nang ngai kaw shang lu na rai ndai; ngai sha a dudim si hte ngai nang hpe gaja wa mari la sade ai, ngu nna hkap tsun wu ai: dai shana shi hte yup wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Karai Kasang Lea a ga madat ya wu ai rai nna, shi na-um nasin rai wa ai hte Yaku a matu manga lang ngu na shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Lea gaw Nye a madu wa hpe nye a shingnan ya sha we ai majaw, Karai Kasang ngai hpe shabrai jaw ni ai, nga nna shi hpe Yisahka ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bai Lea na-um nasin rai nna, Yaku a matu kru lang ngu na shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna Lea gaw, Karai Kasang ngai hpe sharung shakau kaja jaw ni ai; ya chyawm gaw, nye a madu wa matu shadang sha kru shangai ya se ai rai nna, shi ngai hte rau anga nga na sai, nga nna shi hpe Zebulun ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang shayi sha shangai nna shi hpe Dina ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Karai Kasang gaw Rahkela hpe dum wu ai hte shi a ga madat ya nna shi kashu kasha shaprat lu na lam hpaw ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi na-um nasin rai nna shadang sha shangai wu ai. Dai rai nna shi gaw, Ngai hkrum ai shatan nhkan hpe Karai Kasang la kau ya ni ai, nga nna mung,
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa ngai hpe shadang sha langai mi naw jat jaw n ga, nga nna mung shi hpe Yawsep ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya Rahkela Yawsep hpe shaprat ai hpang Yaku gaw, Ngai nye a mungga, ngai nga shara de wa ni ga ngai e shabawn dat e;
  </para>
  <para style="p">
    <verse number="26" style="v" />ngai nang hpe galaw jaw nna lu ai nye a kasha kanu ni hte ngai sha ni hpe woi nna wa lu na ahkang jaw e: ngai nang hpe kaning di galaw jaw de ai gaw nang chye nga ndai, ngu nna Laban hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shaloi Laban gaw, Na a man e ngai myi man pa ni ai rai yang gaw naw hkring et; na a majaw Yehowa ngai hpe shaman ya ni ai, ngu nna ngai dum nga nngai:
  </para>
  <para style="p">
    <verse number="28" style="v" />ngai nang hpe jaw na shabrai dawdan ya e, ngai jaw na nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai Yaku gaw, Ngai nang hpe kaning rai galaw jaw ai mung, na a yamnga ni nye a lata hta kaning rai nga ai mung, nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngai garai n du yang na a sutgan loi sha mi rai lit dai; ya chyawm gaw law law wa jat wa salit dai: ngai galaw ai lam shagu hta Yehowa nang hpe shaman ya nit dai: ya mung nye a nta a matu ngai galoi ai me shachyip lu na rai nga a ta? ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Laban gaw, Ngai nang hpe hpa jaw na rai ta? ngu nna san wu yang, Yaku gaw, Hpa mung n jaw ra ndai; rai timung nang ngai hpe ndai hku galaw mayu yang gaw, na a sagu bainam hpung ni hpe ngai bai sin rem lajang we ga:
  </para>
  <para style="p">
    <verse number="32" style="v" />dai ni jang na a sagu bainam hpung ting hta ngai ga sa wa nna, aprup aprap re ai aten apang rai ka ai hte, chyang ai sagu kasha nlang hpe mung, ateng apang re ai hte aprup aprap rai ka ai bainam ni hpe mung ngai lata tawn da na we ai: dai gaw nye a shabrai tai na rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai rai jang, htawm hpang e nye a shabrai lam nang sa yu ai shaloi, nye a dingman ai gaw dai hta dan na ra ai: bainam ni hta aprup aprap n re ai hte ateng apang n re ai, sagu ni hta n chyang ai, ngai hta lawm yang gaw, dai gaw ngai lagu ai ngu u, ngu wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Laban mung, Rai sa, na a ga hte maren rai u ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai shani jang shi gaw, ka ka re ai hte ateng apang re ai nam la ni hpe mung, aprup aprap rai ka ai hte ateng apang re ai nam yi ni hpe mung, hpraw ka ai nlang hte hte, chyang ai sagu kasha nlang hte hpe lata la nhtawm kasha ni hpe ap ya wu ai:
  </para>
  <para style="p">
    <verse number="36" style="v" />Yaku hte shi a lapran e lam masum ya sat kaw tawn da wu ai: Yaku chyawm gaw, ngam nga ai Laban a sagu bainam hpung ni hpe rem ya nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ya Yaku gaw tsit ai Libna hpun luza hpun hte armun hpun hta na shingna dan la nhtawm, ahpraw hte atsit bai bai rai hkra, gadoi dumrin gaw kau wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shing rai gaw kau ai shingna ni hpe, sagu bainam ni ntsin sa lu ai ntsin htung ni hta, sagu bainam ni a man e jung shajang da wu ai: dai ni ntsin sa lu yang uli lung ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Sagu bainam ni dai shingna ni a man e uli lung nna, ka ka re ai, aprup aprap re ai hte ateng apang re ai hkrat shajang ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Yaku gaw dai sagu kasha ni hpe mung karan tawn da nna, Laban a sagu hpung hpe dai ka ka re ai hte chyang ai sagu bainam hpung ni hpang de man yawng shangun wu ai: shi a hpung ni hte, Laban a hpung ni hpe n kayau ai sha, kaga ga di jahka da wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />N-gun ja ai sagu bainam ni uli lung ma ai shaloi, dai shingna ni a man e lung mu ga nga, Yaku gaw ntsin htung ni hta dai shingna ni hpe sagu bainam ni a man e jung da da di wu ai:
  </para>
  <para style="p">
    <verse number="42" style="v" />n-gun n ja ai ni a man e chyawm gaw n jung wu ai: dai rai nna n-gun n ja ai ni gaw Laban a matu rai nga ai; n-gun ja ai ni chyawm gaw Yaku a matu rai nga ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shing rai Yaku gaw ja ja rawt wa ai rai nna, sagu bainam hpung, numsha yam, lasha yam hte gawla-uk, lawze re ai law law wa lu wa ai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Laban a kasha ni gaw, Anhte a wa a sut nga manga Yaku e la kau nu ai: wa a marang e shi hta ndai hte wa lu su wa salu ai, nga nna tsun ma ai hpe Yaku na wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yaku gaw Laban a myi man hpe yu yang mung, shawng de na zawn n rai salu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Yehowa gaw Yaku hpe, Na a nji nwa ni nga ai ga, na a baw sang ni hpang de bai wa nu: ngai nang hte rau anga nga na nngai, nga nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai re ai majaw Yaku gaw masha shangun dat nna, sagu bainam ni nga ai pa de Rahkela yan Lea hpe shaga la nhtawm,
  </para>
  <para style="p">
    <verse number="5" style="v" />Nan a nwa myi man gaw nye a man e shawng de na zawn n rai salu ai, ngai mu se ai: rai timung nye ji wa ni a Karai Kasang ngai hte rau nga nga li ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nan a nwa a bungli hpe nye a n-gun rawng ai made ngai galaw jaw se ai gaw, nan chye nga myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nan a nwa chyawm gaw ngai hpe maw sha nna, nye a shabrai hpe shi lang galai kau ya ni ai: rai timung, ngai hpe jasum na Karai Kasang n hkraw nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mun aprup aprap re ai ni gaw na a shabrai rai u ga, nga nna shi tsun jang, sagu bainam ni mahkra mun aprup aprap re ai hkrat shajang ma ai. Ka ka re ai gaw na a shabrai rai u ga, nga jang, sagu bainam mahkra ka ka re ai hkrat shajang ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai Karai Kasang gaw nan a nwa a yamnga ni hpe shaw la nna ngai hpe jaw kau ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hta kaga, sagu bainam ni uli lung nga ai shaloi ngai mada yu we yang, yu mu, uli lung ai nam la mahkra hte, mun ka ka, aprup aprap re ai hte ateng apang re ai rai nga ma ai gaw, yup mang hta ngai mu we ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang a lamu kasa mung, yup mang hta, Yaku e, ngu nngai: ngai gaw, Nang nga nga nngai, ngu we ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai shi gaw, Mada yu u, uli lung ai nam la ni yawng ka ka re ai hte aprup aprap ateng apang re ai hkrai rai nga ma ai: kaning rai nme law, nang hpe Laban e di ai yawng ngai mu nga nngai
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw, mahtan daw hta nang namman jaw nna, ngai hpe ga shaka dagam da ai Behtela na Karai Kasang rai nga nngai: ya rawt u, ndai mung na pru nna, na a dai daw ga de bai wa nu, nga nna ngai hpe tsun nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Rahkela yan Lea gaw, Wa a nta hte hpa seng nna, an a matu hpa Sali wunli naw lu la na rai nga a ta?
  </para>
  <para style="p">
    <verse number="15" style="v" />shi an hpe masha tsasam zawn she myit mi ai n rai ni? an hpe shi dut sha kau ma ni ai; an a gumhpraw mung shi ma ma sha kau nu ai
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna an a wa kaw na Karai Kasang shaw ya ai sut mahkra hte gaw, an a matu hte an a kasha ni a matu rai nga malu ai; ya chyawm gaw Karai Kasang nang hpe tsun matsun hte maren hkan galaw nu, ngu nna shi hpe htan mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Yaku rawt nna shi a kasha ni hte madu jan ni hpe gawla-uk hta shajawn mu ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpadan Aram e shi lu la ai yamnga hpung mahkra hte shi mahkawng da ai sutgan yawng hte hpe shinggyin la nna, shi a kawa Isak nga ai Hkanan mung de wa na woi pru wa wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya Laban gaw sagu mun rep na nga kaga de sa mat ai laman e, Rahkela gaw kawa a hpara sumla ni lagu mat wa ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yaku mung shi hprawng na lam n shana ai sha, Suri masha Laban hpe zai hte dan kau da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai shi gaw sutgan yawng hte nawng hprawng mat wa nna, dai hka hpe rap kau nhtawm, Gilead bum de yawng let sa wa nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya Yaku hprawng mat wa ai lam masum ya hta e Laban hpe tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi shi gaw kahpu kanau ni hpe shaga woi nna, lam sanit ya sat hkan mu yang, Gilead bum e hkan dep mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Karai Kasang chyawm gaw shana e yup mang hta Laban kaw du pru nna, Yaku hpe kaja ai mung n kaja ai mung nang n tsun n ga, sadi nga u, nga wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya Laban gaw Yaku hpe dep nu ai: Yaku gaw dai bum e shi a sum gap tawn nu ai: Laban mung shi a kahpu kanau ni hte Gilead bum e but nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi Laban gaw Yaku hpe, Ngai kaw na atsin atsu hprawng mat wa ndai hte, hpyen gasat kaw rim la ai ni hpe zawn ngai sha ni hpe woi mat wa ndai gaw, hpa re ai rai ta?
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai kaw na hpa rai atsin atsu lagyim hprawng pru mat wa n ta? nang hpe kabu gara di nna mahkawn mangoi let sumpyi tingse dum nna shabawn dat lu hkra, ngai hpe hpa rai n tsun n ta?
  </para>
  <para style="p">
    <verse number="28" style="v" />ngai shu ni hte ngai sha ni hpe n pup lu na hku, hpa rai nang galaw n ta? Ya chyawm gaw myit n su ai hku nang galaw nit dai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nanhte hpe kaning di mayu yang ngai di lu nngai: rai timung, mana e na nwa a Karai Kasang gaw, Yaku hpe kaja ai mung n kaja ai mung nang n tsun n ga sadi nga u, nga nna ngai hpe tsun nngai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ya chyawm gaw na nwa nta de du na nang ndawt nit dai majaw, wa ai gaw rai nu ga; rai timung, nye a hpara ni hpe, nang hpa rai lagu la n ta? ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yaku gaw Laban hpe, Na a shayi sha yan hpe nang shingnyen la dam na ndai, ngu nna ngai hkrit ai majaw, rai nngai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na a hpara ni hpe chyawm gaw, kadai wa kaw nang mu hkrup yang, dai wa gaw si u ga: an a hpunau ni a man e, ngai kaw lawm ai na a arai, madun nna la u, ngu nna htan wu ai. Rahkela dai hpara ni hpe lagu ai chyawm gaw Yaku n chye wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shaloi Laban gaw Yaku a sum, Lea a sum hte shingnan num yan a sum hkan shang yu wu timung, hpara sumla ni hpe n mu wu ai. Lea a sum na pru nna
  </para>
  <para style="p">
    <verse number="34" style="v" />Rahkela chyawm gaw dai hpara sumla ni hpe la nna gawla-uk hking tingsan kata e bang da nhtawm de a ntsa e dung nga wu ai. Laban gaw sum ting sawk yu wu timung, dai ni hpe n mu wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Rahkela mung shi a kawa hpe, Wa e, na a man e ngai n rawt lu nngai hpe, hkum pawt et; ngai numsha hking lang nga nngai, ngu wu ai. Shing rai Laban gaw hpara sumla ni hpe n mu tam wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ya Yaku gaw masin pawt nna Laban hte dangrang hkat ma ai: Yaku gaw Laban hpe, Ngai hpa lam shut nga a ta? ndai hte wa shaja nna ngai hpe hkan shachyut ai gaw, ngai hta hpa mara nga a ta?
  </para>
  <para style="p">
    <verse number="37" style="v" />Nye a arai mahkra nang sawk yu nit dai re ai, ya na a nta na arai lama mi mu wu ni? Nye a hpunau ni hte na a hpunau ni a man e ya tawn u, shaloi shanhte an lahkawn a lapran e jeyang ya mi ga.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ya lai wa sai hkun ning tup ngai nang kaw nga nga nngai: na a sagu bainam yi ni ubya pyi n bya ma ai; na sagu bainam la ni mung ngai n sha ya de ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Rai matse e kawa sat ai hpe nang hpang de n la wa ai; ngai a sum kau nngai; shani e lagu shamat ai mung, shana e lagu shamat ai mung, nang kaw malai hpyi la la rai ndai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shing rai lam shagu ngai hkam mana sha nngai: shani na jan ja ai mung, shana na hkyen hkrat ai mung, ngai hpe adup kau ni ai: yup n lu sha ai mung ngai hkrum ni ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shing rai hkun ning tup na nta e ngai nga kau ni ai. Na a shayi sha yan a matu shi mali ning, na a sagu bainam npung ni a matu kru ning ngai nang hpe galaw jaw sade ai: rai timung, nye a shabrai shi lang nang galai kau ya nit dai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ya mung, nga wa a Karai Kasang, Abraham a Karai Kasang, ngai wa Isak a hkrit hkungga ai, ngai hte rau n nga taw gaw, gaja wa teng teng nang ngai hpe kaman dat dat na ndai: ngai ru tsang ai hte nye a lata galaw ba ai hpe Karai Kasang mu nna mana e nang hpe daru nit dai, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Dai rai nna Laban gaw Yaku hpe, Ndai numsha ni nye a shayi sha ni hkrai, ndai ma ni mung nye shu ni hkrai, sagu bainam hpung ni mung nye a hpung ni hkrai, nang mu mamu mahkra gaw nye a hkrai rai nga ai: dai re ai majaw, nye a shayi sha ni hte shanhte shaprat ai kasha ni hpe ngai dai ni hpa di lu na rai ta?
  </para>
  <para style="p">
    <verse number="44" style="v" />Ya sa rit, an lahkawng ga shaka tawn da ga; dai gaw ngai hte na a lapran e sakse tai nga u ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shaloi Yaku nlung langai mi la nna mahtan daw di jung da wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Bai Yaku gaw shi a kahpu kanau ni hpe, Nlung la wa marit, ngu mu ai; shaloi shanhte nlung la wa nna sumpum tawn da mu ai; dai sumpum ntsa e shanhte shat jawm sha ma ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Laban gaw dai hpe Yegara sahaduta, ngu shamying wu ai; Yaku chyawm gaw dai hpe Galeda ngu shamying wu ai:
  </para>
  <para style="p">
    <verse number="48" style="v" />Bai Laban gaw, Ndai nlung sumpum gaw ngai hte na a lapran e dai ni nna sakse tai nga ai, ngu wu ai: dai majaw dai hpe Galeda ngu mu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mizhpa mung ngu mu ai; kaning rai nme law, Laban gaw, An hka mat wa ai hpang ngai hte na a lapran e Yehowa yu nga u ga;
  </para>
  <para style="p">
    <verse number="50" style="v" />Nye a shayi sha yan hpe nang zingri ndai rai timung, ngai sha yan hta kaga nang num bai la ai rai yang mung, an hta masha sakse n nga ai: Karai Kasang ngai hte na a lapran e sakse tai nga u ga, ngu nna bai tsun wu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Dai hta kaga Laban gaw, Ngai hte na a lapran e ngai jung tawn se ai ndai nlung sumpum hte mahtan daw hpe yu yu u:
  </para>
  <para style="p">
    <verse number="52" style="v" />ngai nang hpe gasat na ndai nlung sumpum lai lu na n rai; nang mung ngai hpe gasat na, ndai sumpum hte ndai mahtan daw hpe lai lu na n rai, ndai sumpum hte ndai mahtan daw gaw sakse tai nga manu ga.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham a Karai Kasang, Nahura a Karai Kasang, shan a kawa a Karai Kasang gaw, an a lapran e jeyang ya nga ma ni ga, nga nna Yaku hpe bai tsun wu ai. Dai rai nna Yaku gaw shi a kawa Isak a hkrit hkungga ai hku hkan nna dagam wu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Shaloi Yaku dai bum e hkungga nawng ya wu ai rai nna, shi a kahpu kanau ni hpe shat sha shaga wu ai: shanhte mung shat sha nna dai bum e dai shana nhtoi shalai mu ai.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Laban gaw hpang jahpawt jau jau e rawt nna shi a kashu kasha ni hte shi a shayi sha ni hpe pup nhtawm, shanhte hpe shaman ya mu ai: shing rai Laban gaw pru nna shi nga ai mung de nhtang wa mat ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yaku mung shi sa ai lam bai sa wa ai rai nna Karai Kasang a lamu kasa ni shi hpe sa tau mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yaku gaw shanhte hpe mu jang, Ndai gaw Karai Kasang a wunawng wuwa rai nga ai, nga nna dai shara hpe Mahana-im ngu shamying mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Yaku gaw Seira ga Edom pa e nga ai shi a kahpu Esaw hpang de shi a shawng e kasa shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte hpe shi hkang dat mu ai gaw, Na mayam Yaku gaw, ya du hkra Laban kaw shingbyi nga ni ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />dumsu hte lawze mung, sagu bainam hpung mung, lasha yam numsha yam mung, ngai law law lu nngai: nye a madu a man e ngai myi man pa lu u ga, ngu nna shana dat nngai, nga ai ngu nna nye a madu Esaw hpe tsun ya mi, ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kasa ni mung bai nhtang wa nna Na nhpu Esaw kaw anhte du saga ai; shi nang hpe sa tau na nga masha mali tsa hte rawt sa wa ra ai, ngu nna Yaku hpe wa tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai majaw Yaku ja ja hkrit ai hte myit ru nga ai rai nna, shi kaw hkan nang ai masha ni hte sagu bainam hpung ni, dumsu hpung ni, gawla-uk ni hpe hpung lahkawng di nna karan wu ai:
  </para>
  <para style="p">
    <verse number="9" style="v" />kaning rai nme law, Hpung mi hpe Esaw mu nna hpya kau yang hpung mi gaw lawt lu na nhten, ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Yaku gaw, Ngai ji Abraham a Karai Kasang, ngai wa Isak a Karai Kasang, ngai hpe, Na a buga, na a baw sang ni hpang de bai wa nu, ngai nang hpe ngamu ngamai shangun na de ai, nga nna tsun ai Yehowa e:
  </para>
  <para style="p">
    <verse number="11" style="v" />na a mayam hpe nang madun ai chyeju hte sadi sahka mahkra hta na langai mi hte muk ngai n ging nngai; shawng e ndai Yawdan hka hpe nye a dawhkrawng hte sha rap wa nngai, ya chyawm gaw ngai hpung lahkawng tai ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai hpu Esaw a lata na ya ngai hpe hkye la e; shi du nna ngai hpe mung, kanu hte kasha ni hpe mung sat kau na ngai hkrit nga nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gaja wa nang hpe ngamai shangun na de ai; na a amyu matu ni hpe nammukdara hka kau na n dang hti ai zaibru zawn ngai shalaw na we ai, nga nna nang tsun nit dai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shana tup dai yang e shi nga nga nna shi lu ai sutgan hta na kahpu Esaw hpe jaw na kumhpa matu:
  </para>
  <para style="p">
    <verse number="15" style="v" />nam yi ni tsa, nam la hkun; sagu yi ni tsa: sagu la hkun;
  </para>
  <para style="p">
    <verse number="16" style="v" />kasha ni hte nawng chyu chyu ai gawla-uk kanu sumshi; dumsu uyi mali shi, usu shi; lawze yi hkun, lawze kasha shi, lata tawn wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hpung langai hte langai hpe mayam ni a lata hta ap ya nhtawm, dai mayam ni hpe, Nye a shawng e rap sa wa nna, hpung mi hte hpung mi gang gang rai mu, ngu nna hkang dat mu ai. Shawng sa wa ai wa hpe, Ngai hpu Esaw nang hte hkrum nna, Nang gade a masha rai n ta? gade sa wa nga n ta? na a shawng na yamnga ni gaw gade a rai ta? nga nna hkap san yang,
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a mayam Yaku a rai nga ai; nang Madu Esaw hpe jaw dat ai kumhpa rai nga ai; yu u, shi hkum gaw hpang de naw rai nga ai, ngu nna tsun u, ngu nna htet dat wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hte maren hpung lahkawng na wa hpe mung, hpung masum na wa hpe mung, hpung shagu hta hkan nang ai ni hpe, Ngai hpu, Esaw hte nanhte hkrum yang, shing ngu mu, nga nna mung;
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a mayam Yaku hpang de naw rai nga ai ngu nna tsun mu, nga nna mung htet dat wu ai. Kaning rai nme law, Ya nye a shawng de pru wa sai kumhpa hte shi a myit ngai shakawp ya na wa ai; shaloi shi hte ngai hkrum jang, nye a myi man shi yu ra a nhten, nga nna Yaku myit nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai shi a shawng e kumhpa sharap dat nna, shi hkum gaw dai shan e dai dabang na ni hte rau nga nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai shana e shi rawt nna, shi a madu jan yan hte shingnan num yan hpe mung, shi a kasha shi langai hte hpe mung woi nna, Yabok hka uhkan hta rap ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai shanhte hpe woi nna, shi a sut rai nga manga hte hpe sharap dat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Yaku shi hkrai sha hti nga nna masha langai mi nhtoi htoi hkra shi hte kamu hkat nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai wa gaw shi n dang lu ai mu jang, Yaku a magyi pawt ahtawk ya wu ai rai nna, shi hte kamu nga yang, shi a magyi pawt hkrihkraw kashai mat lu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shaloi dai wa gaw, Nhtoi htoi wa ra ai, ngai hpe dat dat ni, ngu wu ai. Yaku gaw, Nang ngai hpe n shaman ya yang gaw, ngai nang hpe n dat dat na ngai, ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bai dai wa gaw, Na a amying hpa rai lit ta? ngu nna san wu yang, Yaku ngu ai rai li ai, ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi dai wa gaw, Na a amying htawm hpang de Yaku ngu lu na n rai: Israela ngu na rai lit dai: kaning rai nme law, nang gaw Karai Kasang hte mung, masha hte mung gasat hkat nna dang kau nit dai ngu wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Yaku mung, Na a amying gaw hpa rai lit ta? ngai hpe tsun dan e, ngu nna san wu yang, dai wa gaw, Nye amying hpa rai san n ta? nga nna, dai yang e shi hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai majaw Yaku dai shara hpe Hpeniela ngu nna shamying wu ai: kaning rai nme law, Ngai gaw Karai Ksang hte myi man tut hkrum timung, ngai n si nngai, nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hpeniela shara na pru wa ai shaloi jan pru sai; shi a lagaw mung yaw jan mat lu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shing rai, Yaku a magyi pawt na lasa hpe ahtawk ya wu ai majaw, Israela masha ni dai ni du hkra magyi pawt na lasa n sha ma ai.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yaku mada yu wu yang, yu u, Esaw gaw sa wa ai rai nna, masha mali tsa shi kaw hkan nang nga ai. Dai mu jang, Lea yan Rahkela hte shingnan num yan hpe kasha karan ya wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shingnan num yan hte shan a kasha ni hpe shawng e, Lea hte shi a kasha ni hpe lapran e, Rahkela hte Yawsep hpe hpang jahtum e shi tawn da wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi chyawm gaw shanhte a shawng de lai sa wa nna, shi a kahpu kaw du ai du hkra, sanit lang ga de gum dagup wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Esaw mung shi hte hkrum hkra gat sa wa nna, shi hpe aphum let shi a du ginshum nna she hpe pup wu ai: shan nau lahkawng hkrap nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shi mada yu nna, numsha ni hte kasha ni hpe mu wu yang, Nang kaw nang ai ndai ni gaw, kadai ni rai nga ma ta? ngu wu ai. Yaku gaw, Karai Kasang na a mayam hpe jaw ai ma ni rai nga ma ai, ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi shingnan num yan hte shan a kasha ni sit sa nna gum dagup ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lea hte shi a kasha ni mung sit sa nna gum dagup nga ma ai: dai hpang Yawsep hte Rahkela sit sa nna gum dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Esaw gaw, Ngai hkrum dat ai yamnga hpung ni nlang hte gaw kaning re ai rai ta? ngu nna san wu yang, Yaku gaw, Nang madu a man e ngai myi man pa lu na matu, rai nga ai, ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Esaw gaw, Ngai nau e, ngai lu ai hte ram nga ai, na a sut rai gaw nang bai la da u, ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku gaw, N rai, shing hkum nga et; ngai na a man e myi man pa ni ai rai yang gaw, ngai jaw ai kumhpa hkap la u: Karai Kasang a myi man mu lu ai zawn, na a myi man ngai mu ya de ai rai nna, nang mung ngai hpe n-gaw ai myit rawng nga ndai:
  </para>
  <para style="p">
    <verse number="11" style="v" />nang kaw du ai nye a kumhpa gaw she hkap la u; Karai Kasang ngai hpe chyeju jaw ni ai rai nna, nye a matu gaw law nga li ai, nga nna agaw ya wu ai majaw, dai hpe hkap la wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Esaw gaw, Sa, rawt sa wa saga, na a shawng e ngai sa na nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yaku gaw, Ma ni mung n kung ma ai; sagu bainam ni hte dumsu ni mung chyu chyu ai hkalung nang ma ai hpe, nang madu chye ya nga ndai: lani mi hta sha nau gawt jang gaw hpung mahkra ni si mat na ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai re ai majaw nang madu gaw na a mayam a shawng e wa magang u: ngai gaw yamnga ni hte ma ni sa lu ai daram, nang madu nga ai Seira bum de du lu hkra, dai ni hpe yat yat woi lakawn wa na nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Esaw gaw, Dai rai taw gaw, ngai kaw hkan nang ai masha nkau mi nang kaw tawn da mawe ga, ngu wu ai. Yaku gaw, Hpa mi ra nga a ta? nang madu a man e myi man shapa u ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Esaw gaw dai shani jang rawt nna Seira bum de bai wa mat ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yaku chyawm gaw Suhkut ngu ai shara du hkra hkawm sa wa nna, shi nga na matu nta hte, yamnga rawng na matu, sum, gap wu ai: dai re ai majaw dai shara hpe Suhkut ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya Yaku gaw Hpadan Aram de na bai wa yang Hkanan mung na Shehkem ngu ai mare de hkam kaja ai hte du wa ai rai nna, dai mare a tawtap e but nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi sum gap ai ga dachyawk gaw, Shehkem a kawa, Hamura a kashu kasha ni kaw na gumhpraw lap latsa hte, shi mari la ai ga rai lu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai yang e mung shi tawn hkungri langai mi tawn da nhtawm, dai hpe El-Eluhe-Israela ngu nna shamying wu ai.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai Shaloi Yaku a madu jan Lea shaprat ai shayi sha Dina gaw, dai mung na numsha ma ni hpe sa shachyen na nga pru sa wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi dai mung up ai Hiwi amyu masha Hamura a kasha Shehkem gaw, shi hpe mu nna woi wa nhtawm, shi hpe woi yup ai hte shi a arawng jahpoi ya wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai wa a myit gaw Yaku a shayi sha Dina hta a noi nga ai rai nna, dai mahkawn hpe tsawra ai hte nja nhpra ga a tsun nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna Shehkem gaw kawa Hamura hpe, Ndai mahkawn nye a madu jan shatai na hpyi ya rit, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku gaw shi a shayi sha Dina hpe Shehkem e atawng jahpoi ya ai lam na wu ai, rai timung, shi a shadang sha ni yamnga ni hte pa de nga nga ma rai rai nna, shanhte bai wa ai du hkra atsin sha naw nga nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya Shehkem a kawa Hamura gaw, Yaku hpe sa shaga na nga pru sa wa ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yaku a shadang sha ni dai lam na jang pa de na du wa ma ai: dai wa gaw Yaku a shayi sha hte yup nna Israela amyu hta n shawp ai hte n galaw mai ai amu galaw wu ai majaw, shanhte myit machyi nna ja ja pawt bu nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hamura mung shanhte hte shachyen nna, Ngai sha Shehkem gaw nanhte a shayi sha hta myit marit nga ai; dai majaw shi hpe ya sha ya mi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte hte anhte mayu dama shaw ga; nanhte a shayi sha ni anhte hpe ya sha mi, anhte a shayi sha ni hpe mung nanhte la mu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai nanhte mung anhte hte rau nga nna ndai mung gaw nanhte a mung tai na ra ai; dai hta e nga nga mu, hpaga ga mu, lu wa su wa mu, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shehkem mung, Nanhte a man e ngai myi man she pa lu n ga; nanhte hpyi ai hte maren ngai jaw na nngai:
  </para>
  <para style="p">
    <verse number="12" style="v" />hpu ja re ai kumhpaw kumhpa re ai gade wa rai timung, nanhte tsun ai made ngai bang na nngai: ndai num hpe sha ngai e jaw mi, ngu nna kawa hte kayung ni hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya Yaku Dina hpe arawng jahpoi ya ai lam myit yu nna Shehkem hte shi a kawa Hamura hpe hpaji hte ning ngu htan mu ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />Anhte a kajan hpe matu n gadoi ai ni e jaw ya ai lam gaw, anhte a matu kaya shara nga ai re ai majaw n ya sha lu ga ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />anhte a htung hte maren, nanhte mung lasha ni yawng matu gadoi ai lam hkam myit yang gaw anhte hkraw na ga ai;
  </para>
  <para style="p">
    <verse number="16" style="v" />dai rai jang, anhte a shayi sha ni nanhte hpe ya sha nna, nanhte a shayi sha ni mung anhte la na ga ai; shaloi nanhte hte rau anhte nga nga nna, amyu langai sha tai na ga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing n rai, anhte a ga nanhte n madat, matu gadoi ai lam n hkam myit yang gaw, anhte a kajan kasha hpe woi nna wa mat na ga ai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ga dai hpe Hamura hte kasha wa Shehkem na ra mu ai rai nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />dai shabrang wa gaw Yaku a shayi sha hpe tsawra la wu ai hte, shi kawa a amyu mahkra hta arawng grau nna lu nga ai majaw dai lam hkan galaw na loi mi muk n hkring wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Hamura hte kasha wa Shehkem gaw shanhte a mare chyinghka de sa nna mare masha ni hpe shaga tsun mu ai gaw:
  </para>
  <para style="p">
    <verse number="21" style="v" />Ndai masha ni anhte hte hkau ram masai; dai majaw shanhte anhte a mung e nga nga nna hpaga yumga ga mu ga; yu mu, ndai mungdan gaw shanhte nga shang hkra dam nga ai; shanhte a shayi sha ni hpe anhte la ga, anhte a shayi sha ni hpe mung shanhte hpe ya sha ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai timung, shanhte matu gadoi hkam ai zawn, anhte hta lasha ni yawng matu gadoi ai lam hkam yang she, shanhte anhte kaw nga nga nna amyu langai sha tai na lam, hkraw na rai ma ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />shanhte a nga dumsu ni, sutgan hte yamnga mahkra gaw anhte a arai tai na n rai ni? shanhte a myit hkan ya ga, dai rai jang anhte kaw shanhte nga nga na mara ai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hamura hte shi a kasha Shehkem tsun ai ga hpe shi a mare chyinghka hku pru shang ai masha yawng hte madat ya mu ai rai nna, shi a mare chyinghka hku pru shang ai lasha yawng hte gaw matu gadoi lam hkam ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hkam ai masum ya du jang, shanhte machyi nga ma ai shaloi, Yaku a kasha Dina a kayung Simun yan Lewi gaw, nhtu hpra hpra lang nna, ndum n mi re ai mare de shang nhtawm, lasha nlang hte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shan gaw Hamura hte kasha Shehkem hpe mung nhtu hte sat kau nna, Dina hpe Shehkem a nta na shapraw la nhtawm woi mat wa mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte a kajan hpe awu asin di ya mu ai majaw, Yaku a shadang sha ni gaw sat kau sai ni hpang de bai sa nna dai mare hpe hpya la kau mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai ni a sagu bainam hpung ni mung, dumsu hte lawze re ai ni hpe mung, mare e nga ai arai hte hkauna pa e nga ai arai ni hpe mung;
  </para>
  <para style="p">
    <verse number="29" style="v" />shanhte a sutgan, shanhte a ma kaji ni hte numsha nlang hte hpe mung rim la nna nta hkan na rai ni mung hpya la kau mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai rai nna Yaku gaw, nan ngai hpe zingri manit dai; ndai mung na Hkanani hte Hperizi masha ni ngai hpe matsat na hku nan galaw manit dai; ngai hta masha n law ai hte shanhte jawm zup nna ngai hpe sat kau na mara ai; shaloi ngai hte nye a dinghku htum mat na ra ai, ngu nna Simun yan Lewi hpe daru wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shan gaw, Anhte a kajan hpe shawa num zawn rai ya lu na rai ni? ngu mu ai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Karai Kasang gaw Yaku hpe, Rawt u, Behtela de lung wa nna dai yang e nga nga u; na nhpu Esaw kaw na nang hprawng ai shaloi, nang kaw paw pru ai Karai Kasang a matu tawn hkungri galaw u, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna Yaku gaw shi a nta masha ni hte shi kaw nga ai ni mahkra hte hpe, Nanhte lu ai hpara tsasam ni hpe shapraw kau mu; tinang hkum tinang shachyoi shapra nna hpun palawng galai mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Behtela de lung wa na anhte rawt saga; ngai kyin dut ai nhtoi e ngai hpe htan ya nna, ngai hkawm sa ai lam hta ngai hte rau nga ai Karai Kasang a matu, dai kaw e ngai tawn hkungri galaw na we ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi shanhte gaw tinang lu ai hpara tsasam mahkra hte, na hta kai ai shanghkawng mahkra Yaku hpe ap kau mu ai rai nna, Yaku gaw dai hte hpe Shehkem makau e tu ai wamyi hpun nhpang e lup kau ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai shanhte htawt mat wa ma ai; grup yin na mare masha ni hta Karai Kasang a jahkrit shama ai nga nga ai majaw, shanhte Yaku a shadang sha ni hpe n hkan shachyut gwi mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Yaku hte shi kaw na masha nlang hte, Hkanan mung na Luza ngu ai Behtela shara de du ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai yang e shi tawn hkungri galaw nna, dai shara hpe El-Behtela ngu nna shamying wu ai: kaning rai nme law, kahpu wa kaw na shi hprawng ai shaloi, dai yang Karai Kasang shi kaw dan pru ai rai lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Rebeka a nbat jan Debora si nna, Behtela e tu ai wamyi hpun nhpang e lup makoi kau mu ai: dai majaw hpun dai hpe Alun-bahkut ngu shamying mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaku Hpadan Aram de na wa ai hpang, Karai Kasang gaw shi kaw lang mi bai dan pru nna, shi hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaman ai hta Karai Kasang gaw, Na amying Yaku rai nga lit dai; ya hpang de na amying Yaku ngu na n rai, Israela she ngu na rai lit dai, nga nna shi hpe Israela ngu shamying da wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Karai Kasang gaw, Chyahtum chyalai n-gun rawng ai Karai Kasang ngai rai nga nngai; mayat maya nna law htam wa u; amyu langai sha n-ga, amyu baw law law nang hta na tai na ra ai rai nna, na nshang na hkawhkam hkawseng mung hkrat shajang na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham hte Isak hpe ngai jaw mawe ai lamu ga, nang hte na a amyu matu ni hpe mung ngai jaw na made ai, ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang gaw shi hte hkrum shaga ai shara nna, bai lung mat wa ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang hte hkrum shaga ai shara e, Yaku gaw nlung mahtan langai mi jun nhtawm, dai hta e hpunghkaw hkungga ru jaw nna namman mung ru bun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yaku gaw Karai Kasang hte hkrum shaga ai shara dai hpe Behtela ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang shanhte gaw Behtela kaw nna htawt mat wa ma ai rai nna, Ehprat du na loi mi naw tsan yang, Rahkela shangai nhtoi gu nna shinggyim machyi laja nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai shangai yak nga yang shangai karum ai jan gaw, Hkum hkrit et; shadang sha langai mi nang bai lu nit dai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rahkela gaw, si htan mat wa ai rai nna shi a nsoi nsa hkyet mat wa nga yang, dai ma hpe Ben-uni ngu nna shamying wu ai: kawa chyawm gaw shi hpe Ben-yamin ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi Rahkela si mat nna Betlehim ngu ai Ehprat de sa ai lam makau e, shi hpe lup makoi mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yaku mung shi a lup ntsa e nlung mahtan jun da wu ai: dai nlung mahtan gaw, dai ni du hkra Rahkela a lup mahtan daw tai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang Israela gaw bai htawt nna, Edera langchyi lai nhtawm shi a sum gap wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israela dai yang e nga ai shaloi, Rubin gaw shi kawa a lashi num Bila kaw shang nna shi hte rau yup wu ai: dai lam Israela na wu ai. Ya Yaku a shadang sha ni shi lahkawng rai nga ma ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Lea hta na Yaku a shadang sha ni gaw, lat wa Rubin hte, Simun, Lewi, Yuda, Yisahka, Zebulun hte rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rahkela hta na gaw, Yawsep yan Ben-yamin rai nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rahkela a shingnan Bila hta na, Dan yan Naphtali rai nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lea a shingnan Zilhpa hta na, Gad yan Ashe rai nga ma ai: ndai hte gaw Hpadan Aram mung e naw nga yang shaprat ai, Yaku a shadang sha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai hpang Yaku gaw Abraham hte Isak shingbyi nga ai, mamre ga, Hebron ngu ai Kiriyat-arba e nga ai kawa Isak kaw du wa ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ya Isak a hkrung nga ai nhtoi gaw Latsa e matsat shi ning rai sa lu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi shi dingla nna nhtoi dik ai hta nsa hkyet si mat nna shi a amyu hpawng ai de du wa mat ai shi a shadang sha Esaw yan Yaku gaw shi hpe makoi mayang mu ai.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Da ndai gaw Edom ngu ai Esaw a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esaw gaw Hkanan mung na num la wu ai: langai mi gaw Hiti masha Elun a shayi sha Ada, langai mi Hiwi masha Tsibeum a kasha Ana a shayi sha Aholibama rai lu ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />dai yan hta kaga Ishmaela a shayi sha Nabaiyut a kajan Basemat hpe mung la wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ada gaw Esaw a matu Elihpa shangai wu ai; Basemat gaw Reuela hpe shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aholibama gaw, Yeusa, Yalam, Kora hte hpe shangai ya wu ai. Ndai hte gaw Hkanan mung e shaprat ai Esaw a shadang sha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Esaw gaw, shi a madu jan ni, shi a shadang sha ni hte shayi sha ni, shi a nta masha ni mahkra hte hpe mung, shi a dumsu hpung ni hte shi a yamnga nlang hte, Hkanan mung e shi lu malu hte hpe shinggyin la nna, shi a kanau Yaku kaw na mung kaga de bu htawt mat wa ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />kaning rai nme law, shan lahkawng sut law law lu ma ai majaw, shara mi hta sha rau n nga lu ma ai; shan shingbyi nga ai ga mung, shan a yamnga law ai majaw n shang malu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Esaw gaw Seira bum e nga nga ai: Esaw chyawm gaw Edom ngu ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Da ndai gaw Seira bum e nga ai, Edom masha ni a kawa Esaw a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Esaw a shadang sha ni a amying gaw, shi madu jan Ada hta na Elihpa, madu jan Basemat hta na Reuela rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Elihpa a shadang sha ni gaw, Hteman, Umara, Tsehpu, Gahtam Kenaza hte rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Esaw a kasha Elihpa a lashi num Htimna gaw, Elihpa a matu Amalek shangai ya wu ai: ndai hte gaw Esaw a madu jan Ada hta na matu mara ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Reuela a shadang sha ni gaw, Nahat, Zera, Shama, Miza hte rai ma ai: ndai hte gaw Esaw a madu jan Basemat hta na matu mara ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tsibeum a kasha Ana a shayi sha Esaw a madu jan Aholibama, Esaw a matu shaprat ai shadang sha ni gaw, Yeusa, Yalam, Kora hte rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Da ndai gaw Esaw a shadang sha ni hta na pru ai du ni rai nga ma ai: Esaw a kasha alat Elihpa a shadang sha, du Hteman, du Umara, du Tsehpu, du Kenaza,
  </para>
  <para style="p">
    <verse number="16" style="v" />du Kara, du Gahtam, du Amalek hte rai ma ai: dai du ni gaw Edom mung e Elihpa hta na pra ai du ni rai nga ma ai; shanhte gaw Ada hta na matu mara ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai Esaw a kasha Reuela shadang sha ni gaw, du Nahat, du Shama, du Miza rai nga ma ai: dai du ni gaw Edom mung e Reuela hta na hkrat ai du ni rai nga ma ai: shanhte gaw Esaw a madu jan Basemat hta na matu mara ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai Esaw a madu jan Aholibama hta na shadang sha ni gaw, du Yeusa, du Yalam, du Kora hte rai nga ma ai: dai du ni gaw Ana a shayi sha Esaw a madu jan Aholibama hta na matu mara ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai ni gaw Esaw a kashu kasha ni hte shanhte a du ni rai nga ma ai: shi chyawm gaw Edom rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai mung e nga ai Hori masha Seira a shadang sha ni gaw, Lotan, Shobala, Tsibeun, Ana,
  </para>
  <para style="p">
    <verse number="21" style="v" />Dishon, Ezera Dishan hte rai ma ai: dai du ni gaw Edom mung e nga ai Hori masha Seira a matu mara ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lotan a shadang sha yan gaw Heri hte Heman rai ma ai; Lotan a kajan gaw Htimna rai lu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shobala a shadang sha ni gaw Alwan, Manahat, Ebala, Shehpu, Unam hte rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tsibeun a shadang sha yan gaw Aya hte Ana rai ma ai: dai Ana gaw shi kawa Tsibeun a lawze rem nga ai shaloi nam hkan e shait sa mu ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ana a kasha yan gaw, shadang sha Dishon hte shayi sha Aholibama rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dishon a shadang sha ni gaw, Hemdan, Eshban, Yitran, Hkeran hte rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ezera a shadang sha ni gaw, Bilahan, Zawan, Akan hte rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dishan a shadang sha yan gaw Uza hte Aran rai ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ndai ni gaw Hori amyu hta na du ni rai nga ma ai: du Lotan, du Shobala, du Tsibeun, du Ana,
  </para>
  <para style="p">
    <verse number="30" style="v" />du Dishon, du Ezera, du Dishan hte rai ma ai: dai du ni gaw Seira mung e dung ai Hori amyu hta na pru ai du ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai ndai gaw Israela a kashu kasha ni hta Hkawhkam garai n up yang, Edom mung e up ai hkawhkam ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beora a kasha Bela gaw Edom mung e hkaw dung nga ai; shi a mare a amying gaw Dinhaba rai lu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bela si mat nna, Bozra mare na Zera a kasha Yoba gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yoba si mat yang, Hteman mung na Husham gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Husham si mat yang, Moba pa e Midian masha ni hpe gasat kau ai, Bedada a kasha Hadara gaw, shi a aya hta shang dung wu ai; shi a mare amying gaw Awit rai lu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hadara si mat yang, Masreka shara na Samla gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Samla si mat yang, dai hka makau e nga ai Rehubut shara na Sha-ula gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Sha-ula si mat yang, Akbura a kasha Bala-hanan gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akbura a kasha Bala-hanan si mat yang, Hadara gaw shi a aya hta shang dung wu ai: shi a mare a amying gaw Paw ngu ai rai lu ai; shi a madu jan a amying gaw Mehetabela rai nga ai; shi gaw Mezahaba a kasha Matreda a shayi sha rai nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Da ndai gaw Esaw hta na hkrat ai tinang lakung lama hte tinang nga shara tinang mying hkan nna du sha ai du ni a amying rai nga ai: dai ni gaw du Htimna, du Alwa, du Yehtet,
  </para>
  <para style="p">
    <verse number="41" style="v" />du Aholibama, du Ela, du Hpinon,
  </para>
  <para style="p">
    <verse number="42" style="v" />du Kena, du Hteman, du Mibzara, du Magdula, du Iram hte rai ma ai:
  </para>
  <para style="p">
    <verse number="43" style="v" />dai ni gaw tinang nga shara hte tinang up lu ai mung hta na Edom du ni rai ma ai. Edom amyu ni a kaji daju gaw Esaw rai nga ai.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yaku gaw shi a kawa shingbyi nga ai Hkanan mung e anga nga ai. Ya Yaku a lakung lama ni a maumwi gaw ning rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yawsep gaw asak shi sanit ning rai yang shi a kahpu ni hte sagu bainam ni rem nna nga ai; shi gaw kawa a madu jan Bila yan Zilhpa a kasha ni hte kanawn ai ma rai nga ai rai nna, Yawsep gaw shanhte a n shawp ai shiga kawa hpe shana ya ya rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya Israela gaw shi asak kaba sayang she, kasha Yawsep a myi man mu lu wu ai majaw, shi a kasha kaga ni mahkra hta shi hpe grau tsawra wu ai; shi a matu reng ai palawng galu mung shi chywi ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a kawa gaw shi kasha ni mahkra hta Yawsep hpe grau tsaw da wu ai gaw kahpu ni mu mu yang, shanhte gaw shi hpe n dawng nga ma ai rai nna, shi hpe ga ngwi ga sau hkaw mi muk n tsun kam ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lang mi na Yawsep gaw yup mang mu nna shi a kahpu ni hpe hkai dan wu ai; dai rai nna shanhte shi hpe grau nna n dawng mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi shanhte hpe yup mang hkai dan wu ai gaw, Ning re ai yup mang ngai mu nngai, madat yu mu:
  </para>
  <para style="p">
    <verse number="7" style="v" />yu mu, hkai bang yi e anhte hkauling gyit nga ga yang, nye a hkauling gaw jan rai rawt tsap nga ai; nanhte a hkauling ni gaw, grup wan rai nna nye a hkauling hpe nawku nga ma ai, ngu nna hkai dan wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a kahpu ni gaw, Gaja wa, anhte a ntsa e, nang wa hkawhkam tai na rai nga n ni? anhte a ntsa e, gaja wa, up lu na rin ni? nga nna shi a yup mang hte shi a ga majaw, shi hpe grau nna n dawng mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yup man langai mi shi bai mu nna, shi a kahpu ni hpe, Yu mu, yup mang langai mi ngai bai mu se ai; jan shata hte shagan shi langai ngai hpe nawku ma ai, ngu nna hkai dan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai kawa hte kahpu ni hpe hkai dan wu yang, kawa gaw, Nang mu ai yup mang gaw hpa rai nga a ta? Ngai hte na nnu, an mung, na nhpu ni mung, gaja wa teng teng na a man e sa dingnyawm nawku lu na rai nga a ni? ngu nna shi hpe daru kau wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi a kahpu ni gaw shi hpe manawn da mu ai; kawa chyawm gaw ga dai hpe matsing gun da wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya kahpu ni gaw kawa a sagu bainam hpung ni hpe Shehkem de sa rem na nga, sa wa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Israela gaw Yawsep hpe shaga nna, Na nhpu ni Shehkem e rem nga ma ai, n rai ni? wa rit, nang hpe shanhte hpang de ngai shangun dat de ga, ngu wu ai: shi gaw, Ngai nang nga nga nngai, ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi kawa gaw, Sa wa su, na nhpu ni hkam kaja nga ma ai kun? sagu bainam hpung ni achyoi sha rai nga ai kun? sa yu nhtawm ngai e wa tsun dan rit, ngu nna shangun dat wu ai. Shing rai Hebron kadit nna shi hpe shangun dat wu ai; shi mung Shehkem de sa du wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang e shi kayin hkawm nga yang masha langai mi shi hte hkrum nna, dai wa gaw, Nang hpa tam nga n ta? ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw, Ngai hpu ni hpe tam nga nngai; shanhte kanang rem nga ma ta? ngai hpe tsun dan e, ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai wa gaw, Shanhte nang na htawt mat wa masai; Dohtan de sa saga, nga nna shanhte tsun ai ngai na nngai, ngu nna tsun dan wu ai. Yawsep mung shi kahpu ni hpe hkan tam nna, Dohtan e shanhte hpe sa mu mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi tsan tsan e naw rai nga yang, shanhte shi hpe mu nna, shanhte kaw garai n du yang, shi hpe sat kau na bawng ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw, Yu mu, yup mang mu wa sa wa mawt ra ai;
  </para>
  <para style="p">
    <verse number="20" style="v" />Law, anhte gaw shi hpe sat kau nna, nhkun langai ngai hta jahkrat bang kau gaw; shing rai nhtawm, rai matse langai ngai e shi hpe kawa sat kau sai, ngu nna tsun ga; shaloi, shi a yup mang hpa tai na lu ai gaw anhte yu yu gaw, nga nna shada da tsun ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rubin chyawm gaw dai na jang, Shi hpe sat gaw n sat ga, ngu nna shanhte a lata na shi hpe hkye la wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rubin gaw, Sai hkum shapraw mu; lata hte mung hkum hta mu, wora nam na nhkun hta she jahkrat bang kau gaw, ngu wu ai: dai gaw, Yawsep hpe shanhte a lata na hkye la nhtawm, kawa kaw wa sa ya na nga, myit ai rai lu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya Yawsep kahpu ni kaw sa du jang, shi hpun nga ai, dai reng ai palawng galu shanhte raw la kau ya nhtawm,
  </para>
  <para style="p">
    <verse number="24" style="v" />shi hpe rim dun la nna, dai nhkun hta sa jahkrat bang da mu ai: dai nhkun gaw ntsin n rawng ai; ahkun ahkraw rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hpang shanhte shat sha na nga dung nga ma yang, shanhte mada yu nna, Gilead mung de nna Ishmaela masha hpaga ni yan sa wa nga ai hpe, mu mu ai: dai ni gaw gawla-uk ni hta manam pyaw ai hpun naw, balsam naw, mura naw htaw nna Egutu mung de yu hkrat wa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi Yuda gaw, Anhte a nau hpe sat nna shi a asai up da yang, hpa akyu pru na a ta?
  </para>
  <para style="p">
    <verse number="27" style="v" />law, shi hpe anhte a lata hte n hkra ai sha, Ishmaela masha ni hpe dut ya kau dat gaw: shi anhte a kanau hte anhte a sai shan rai nga ai, ngu nna kahpu kanau ni hpe tsun wu ai: kahpu kanau ni mung shi a ga madat ya ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ya Midian hpaga ni lai sa wa nga ma ai: shanhte mung dai nhkun hta na Yawsep hpe sa shaw la nhtawm, gumhpraw lap hkun hte Ishmaela masha ni hpe dut ya kau dat mu ai: dai ni gaw Yawsep hpe Egutu mung de woi sa wa mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi Rubin dai nhkun de bai wa yu yang, nhkun hta Yawsep n nga sai, mu wu ai; dai rai nna shi a palawng shi gang je kau wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shi a kanau ni kaw mung shi bai wa nna, Ya ma n nga sai, ngai kaning wa rai na i? nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi shanhte gaw Yawsep a palawng la nna, nam la langai mi sat nhtawm, palawng hpe dai sai hta kapruk mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai hpang shanhte gaw dai reng ai palawng galu shagun dat nna kawa hpang de la wa nhtawm, Ndai anhte mu gaw ai; na nsha a palawng re ai n re ai yu yu u, ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kawa gaw dai hpe matsing da wu ai rai nna, Ngai sha a palawng nan rai nga ai; rai matse shi hpe sha kau nu ai; gaja wa teng teng Yawsep hpe kahtum gadaw kawa kau dut kau nu hka, nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi Yaku shi a palawng gang je kau nna, lachyit nba lawai let nhtoi law law wa shi kasha a majaw sharung shayawt nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shi a shadang sha ni hte shayi sha ni mahkra gaw shi hpe shalan shabran na nga rawt sa ma ai; shi chyawm gaw shalan shabran ga n kam madat ai hte, Ngai gaw ngai sha hpang de yawn hkyen ai hte katsan ga de yu wa na ni ai, nga ai: shing rai kawa gaw shi a majaw hkrap ngu hkrap ngoi rai nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Midian masha ni chyawm gaw Yawsep hte Egutu mung e Hpara-u a bu, sin langa ni a agyi Hputihpa kaw dut kau mu ai.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai aten e Yuda gaw shi a kahpu kanau ni kaw na yu mat wa nna, Hira ngu ai Adulam masha langai mi kaw shang nga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yang e Shua mying ai Hkanani masha langai mi a shayi sha hpe Yuda mu nna, shi hpe la nhtawm shi kaw shang nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi dai num na-um nasin rai nna shadang sha shangai wu ai; dai hpe Era ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai shi na-um nasin rai nna shadang sha shangai wu ai; shi a amying Onan ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shadang sha shangai nna, dai wa hpe Shela ngu shamying wu ai: dai wa hpe Shela ngu shamying wu ai: dai ma hpe shangai ai shaloi, kawa gaw Hkezib e nga nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Yuda gaw shi a kasha alat Era hpe num la ya wu ai: shi a amying gaw Htama rai lu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya Yuda a kasha alat Era gaw Yehowa a man e n hkru nga ai rai nna, Yehowa shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Yuda gaw Onan hpe, Na nhpu a madu jan kaw shang nna shi hte kahkyin u; na nhpu a matu mara shapraw ya u, ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Onan chyawm gaw kasha lu jang, shi a kasha ngu na n re ai chye nna, kahpu a matu mara n shapraw ya mayu ai majaw, kahpu a madu jan kaw shang yang, ga de dingsa jahkaw kau wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi galaw ai lam Yehowa a man e n hkru nga ai rai nna, shi hpe mung sat kau wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Yuda gaw shi a kanam Htama hpe, Ngai sha Shela kaba wa hkra, gaida tai nna na nwa a nta e wa nga su, ngu nna tsun wu ai: kaning rai nme law, Shi mung kahpu yan zawn n si u ga, nga nna rai nga ai: Htama mung kawa nta e wa nga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya tsawmra wa na wa sayang, Shua a shayi sha Yuda a madu jan mung si mat lu ai: Yuda gaw yawn bran nna shi a jinghku Adulam masha Hira hte rau Htimna de shi a sagu mun rep ai ni kaw lung wa ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi masha langai ngai e, Yu u, na n-gu gaw shi a sagu ni hpe mun rep na nga, htimna de lung wa na ra ai, ngu nna Htama hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi shi gaw gaida hpun palawng raw kau nna, man magap hte shi a myi man magap nhtawm, shi a hkum hpe mung nba lawai let, Htimna de hprang ai lam Ena-im chyinghka makau e sa dung nga ai: kaning rai nme law, Shela kaba sa timung, shi hpe n hta shangun wu ai gaw, shi chye wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai num hpe Yuda mu wu yang, shi myi man magap da wu ai majaw, shawa num rai nga ai, ngu myit wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi shi lam she sa nna shi kaw sit nhtawm, Nang kaw shang n ga law, ngu wu ai: dai num shi a kanam gaw, Nang ngai kaw shang na gaw ngai hpe hpa jaw na n ta? ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yuda gaw, Hpung na bainam kasha langai mi jaw dat na, ngu wu ai: bai dai num gaw, Dai garai n jaw dat yang, rai lama ma n tang da na n ni? ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yuda gaw, Hpa tang da na ra n ta? ngu nna san wu yang, num jan gaw, Na a dazik hte saidawng mung, nang lang ai dawhkrawng mung jaw da e, ngu wu ai: shaloi shi kaw dai tang da nna shang wu ai; dai num mung shi a majaw na-um nasin rai wa sai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang shi rawt mat wa nna, myi man magap gun kau nhtawm, gaida hpun palawng bai hpun wu a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ya Yuda gaw dai num kaw tang da ai arai shaw la na, shi a jinghku Adulam masha hpe bainam kasha langai mi ya dat wu ai: shi chyawm gaw dai num hpe n mu wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai majaw dai kaw na ni hpe, Ena-im lam makau e dung nga ai shawa num kanang nga nga a ta? ngu nna san wu ai: shanhte gaw, Nang e shawa num n nga ai, ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai shi gaw Yuda hpang de bai wa nna, Num dai hpe ngai n mu tam we ai; dai yang na ni mung, Nang e shawa num n nga ai, nga ma ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi Yuda gaw, Dai bainam kasha ngai nang hpe ya dat se ai mi, nang shi hpe n mu tam sai gaw, an kaya n hkrum na matu arai dai gaw shi a la kau nu ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hpang shata masum dang rai jang masha ni Yuda hpe tsun dan mu ai gaw, Na nnam Htama gaw shawa num tai nna hpye hkawm ai hte na-um nasin rai nga lit dai, ngu mu ai: dai rai nna Yuda gaw, Shi hpe shapraw mu, wan hte nat kau gaw, ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi hpe shapraw mu yang shi gaw kagu hpang de arai shagun dat nna, Ndai arai madu ai wa a majaw ngai na-um nasin rai nga nngai: yu u, ndai dazik, saidawng, dawhkrawng gaw gade a rai nga a ta? ngu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi Yuda dai hpe chye wu ai rai nna, ngai hta shi grau dingman nga ai; shi hpe ngai sha Shela hte n kahkyin shangun we ai majaw rai nga ai, ngu nna yin la wu ai: dai hpang e shi hte mung n kanawn wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya shi a shangai ai nhtoi gu jang, yu u, shi a hkritung e ma marun rawng nga lu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shangai nga yang ma langai mi shi a lata ladawn dat wu ai rai nna, shangai karum ai jan gaw dai lata hta hkyeng ai sumri gyit nhtawm, Ndai mahtang shawng pru na ra ai, nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rai timung dai lata shi bai dawm la ai shaloi, yu u, kahpu wa pru wa ai: dai rai nna shangai karum ai jan gaw, Nang kaning rai lam hpaw n ta? dai gaw nang hta hpaw u ga, ngu nna shi a amying Hparet ngu mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai hpang lata hta sumri hkyeng hkawn ai kanau wa pru wa ai: shi a amying Zerak rai lu ai.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yawsep hpe Egutu mung de woi hkrat wa mu ai; dai de shi hpe woi hkrat wa ai Ishmaela masha ni a lata na, Hpara-u a bu, sin langa ni a agyi, Egutu masha Hputihpa e shi hpe mari la wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa chyawm gaw Yawsep hte rau nga nga ai rai nna, shi gaw myit kaw du ai wa rai nga ai: shi madu Egutu masha nta hta shi nga nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa shi hte rau nga ai rai nna, shi galaw ai amu yawng mayawng hta, Yehowa sha-awng ya wu ai gaw, shi a madu mu ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yawsep mung shi a man e myi man pa ai rai nna, shi a madu hpe galaw jau nga ai; shi a madu mung, nta ting hta shi hpe dinghku madu shangun nna, arai mahkra gaw shi a lata hta ap da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai, nta ting hte arai mahkra shi hpe madu shangun ai kaw nna, Yehowa gaw dai Egutu masha a dinghku hpe Yawsep a majaw shaman ya wu ai: dai rai nna nta e mung, yi hkauna de mung, shi lu malu mahkra hta, Yehowa a chyeju lu la wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi lu malu mahkra gaw Yawsep a lata hta ap da nu ai rai nna, shi sha ai shat hta kaga, arai gale langai mi nga ai mung n chye wu ai: Yawsep chyawm gaw hkumhkrang hking nna ahpraw asam mung htap nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang shi madu a madu jan gaw Yawsep hpe ra nna, Ngai hte rau yup ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yawsep chyawm gaw n hkraw ai hte shi madu a madu jan hpe, Yu u, nye a madu gaw shi lu malu nye a lata hta ap da sai rai nna ndai nta e hpa nga ai mung shi n chye wu ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />ndai nta e ngai hta grau kaba ai kadai mung n nga ai; nang hta kaga hpa mung ngai hpe hkum ai n rai; nang gaw shi a madu jan she rai ndai: dai rai nna dai n hkru ai amu kaba hte Karai Kasang a man e ngai kaning rai shut hpyit lu na rai ta? ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shani shagu dai num e shing ngu wu timung, shi a ga n madat ai sha, shi hte rau yup na mung, shi hte rau nga na mung n hkraw wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lani mi na gaw nta nhku de amu galaw na nga Yawsep shang wa ai rai nna, dai nta nhku e lasha langai mi mung n nga ai shaloi,
  </para>
  <para style="p">
    <verse number="12" style="v" />dai numsha gaw, Ngai hte yup ga, nga nna shi a hpun palawng gra di dun wu ai: shi chyawm gaw shi a hpun palawng dai num a lata hta kau da nna, shinggan de hprawng pru mat wa ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai shi a lata hta hpun palawng kau da nna shinggan de hprawng mat wa ai hpe shi mu wu yang,
  </para>
  <para style="p">
    <verse number="14" style="v" />shi a nta na lasha ni hpe shi shaga nna, Mada yu mu, anhte hpe n sawn n sang di shangun na nga, shi gaw Hebre masha langai mi jashawn tawn da mu ai: ngai e roi na nga shi shang wa ai majaw, nsen kaba hte ngai jahtau dat we ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />ngai a ja ja jahtau dat yang she shi a palawng ngai ka kau da nna shinggan de hprawng pru mat wa sai, ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi madu wa du wa hkra, dai palawng hpe shi kaw tawn da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu wa du wa jang shi gaw, Nang jashawn da ai Hebre mayam gaw ngai hpe n sawn n sang di na nga, ngai kaw shang wa ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />ngai a ja ja wa jahtau dat yang she, ngai kaw shi a palawng kau da nna shinggan de hprawng pru mat wa sai, ngu nna shawng na ga hte maren hkap tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a mayam ngai hpe ning di nngai, nga nna madu jan tsun ai ga hpe madu wa na jang, shi ja ja masin pawt nna,
  </para>
  <para style="p">
    <verse number="20" style="v" />Yawsep hpe rim la nhtawm, hkawhkam sharen da ai masha ni rawng ai htawng hta shi hpe rawng da wu ai: dai rai nna Yawsep gaw htawng e bawng dung nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rai timung Yehowa gaw shi hte rau nga ai rai nna, shi hpe matsan dum wu ai hte, htawng agyi a man e myi man pa shangun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai rai nna htawng agyi wa gaw sharen da ai bawng ni yawng hpe Yawsep a lata de ap da wu ai rai nna, htawng na galaw ai bungli yawng hpe shi hpajan wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa gaw Yawsep hte rau nga ai rai nna, shi galaw ai lam mahkra Yehowa shabyin ya wu ai majaw, htawng agyi wa gaw shi hte seng ai amu langai mi muk yu ra sai n rai.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai lam ni byin ai hpang Egutu hkawhkam kaw tsabyi jau ai wa hte muk kabaw ai wa gaw, shan a madu, dai Egutu hkawhkam hpe shut kau mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai majaw Hpara-u gaw, dai tsabyi jau ai hte muk kabaw ai agyi yan hpe masin pawt wu ai rai nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Yawsep bawng dung ai dai sin langa ni a agyi a nta na ga htawng hta e shan hpe sharen da wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sin langa ni a agyi wa gaw, shan hpe Yawsep a lata hta ap ya wu ai rai nna, shi gaw shan hpe yu wu ai: dai yan mung nhtoi tsawmra wa na hkra sharen da ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi htawng e bawng dung nga ai, Egutu hkawhkam a tsabyi jau ai wa hte muk kabaw ai wa gaw, langai hte langai tinang hte seng ai ga lachyum rawng ai yup mang, lana jan sha hta kaga ga rai mu ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jahpawt e Yawsep gaw shan kaw shang nna shan hpe yu wu yang, yu u, shan gaw myi man sum nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai majaw shi gaw, Nan dai ni hpa rai myi man sum nga myit ta? ngu nna shi madu a nta e shi hte rau bawng dung ai Hpara-u a agyi yan hpe san wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shan gaw, An yup mang mu saga ai, rai timung htai ya lu ai masha n nga ai, ngu nna htan mu ai: shaloi Yawsep gaw, Yup mang a lachyum lam gaw Karai Kasang hte sha seng ai n rai ni? dai ngai hpe hkai dan mi, ngu mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi tsabyi jau agyi wa shi a yup mang Yawsep hpe hkai dan wu ai gaw, Ngai mu ai Yup mang hta, yu u, tsabyi ru langai mi nye a man e tu nga ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />dai tsabyi ru hta lakung masum kung nga ai; dai lakung ni hta apu majawm ai hte pu pu ma ai; tsabyi si sumbaw ni mung myin nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hpara-u a tsabyi gawm mung ngai lang let dai tsabyi si sumbaw hpe la nna Hpara-u a gawm hta shup bang nhtawm, dai tsabyi gawm hpe Hpara-u a lata hta ngai jaw da we ai, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Yawsep gaw, De a ga lachyum gaw: tsabyi ru lakung masum gaw masum ya rai nga lit dai;
  </para>
  <para style="p">
    <verse number="13" style="v" />ya masum ya rai jang, Hpara-u gaw na a baw sharawt ya nna, na a aya hta nang hpe bai dang da ai hte, shawng de nang tsabyi jau yu nit dai hte maren, dai gawm hpe Hpara-u a lata hta myi na ta bai jau na rin dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang ngamu ngamai lu ai shaloi ngai hpe dum nna chyeju madun e lu yaw; Hpara-u a man e nye a lam tsun dan nna, ndai nta na ngai hpe shaw la e:
  </para>
  <para style="p">
    <verse number="15" style="v" />gaja wa ngai hpe Hebre mung na lagu wa mi ai; ya nang e mung, ngai hpa yubak n galaw ai hpe ndai htawng hta bang da mi ai. Ngu nna tsun dat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yup mang de a ga lachyum kaja nga lu ai hpe, muk kabaw agyi wa chye wu yang, Ngai mu ai yup mang mung, yu u, muk hpraw rawng ai ban masum nye a baw hta gup da we ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />ntsa ban hta Hpara-u sha na matu kabaw hkut sai shahpa amyu myu rawng nga li ai rai nna, u ni wa nye a baw hta gup ai ban hta na sa shaw sha ya ma ai, ngu nna Yawsep hpe hkai dan wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yawsep gaw, De a lachyum gaw: ban masum gaw masum ya rai nga lit dai;
  </para>
  <para style="p">
    <verse number="19" style="v" />ya masum ya rai jang Hpara-u gaw na a baw hpe nang hte jahka nna, hpun hta nang hpe noi kau na rin dai; shaloi u ni na a shan shaw sha ya na mara ai, ngu nna htai ya wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hpang masum ya lai jang, Hpara-u shangai ai nhtoi rai nga ai rai nna, shi a ali ama ni a matu, poi galaw daw wu ai: dai shaloi e shi a ali ama ni a man e, tsabyi jau agyi wa hte muk kabaw agyi wa a baw hpe shapraw dan wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yawsep htai ya ai hte maren, tsabyi jau agyi wa hpe gaw, shawng na shi a aya hta bai dang da wu ai rai nna, shi gaw Hpara-u a lata hta myi na ta tsabyi gawm jau lu wu ai: muk kabaw agyi wa hpe chyawm gaw noi kau wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung tsabyi jau agyi wa gaw Yawsep hpe n dum ai sha, malap nna nga nga ai.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang ni ning lai jang, Hpara-u yup mang mu wu ai gaw, yu u, dai hka nu makau e shi tsap nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai hka nu hta na hkumhkrang tsawm ai hte hpum ai nga upra sanit pru lung wa nna, dai hka kau na hka shaman sha let nga nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai, yu u, dai ni a hpang e hkumhkrang n tsawm ai hte lasi grawm grawm re ai nga upra kaga sanit dai hka na pru lung wa nna, shawng na nga ni a makau dai hkun-gau ntsa e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi dai n tsawm ai hte lasi ai nga upra sanit gaw, tsawm ai hte hpum ai nga upra sanit hpe sha kau mu ai: shaloi Hpara-u hprang mat ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi bai yup nna yup mang bai mang wu ai gaw: yu u, mam nhpun langai mi hta nna kaba ai hte ja kat ai mam gungsi sanit si pru wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai, yu u, de a hpang e kaji ai hte sinpraw nbung e ahpawt kau sai mam n myem gungsi sanit si pru wa ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai san mat sai n myem gungsi sanit gaw kaba ai hte ja kat ai gungsi sanit hpe mayu kau mu ai: shaloi Hpara-u hprang mat nna, yup mang re ai chye wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jahpawt rai jang Hpara-u gaw myit ru nna, Egutu mung na gumhpan ni mahkra hte hpaji byeng-ya rawng ai ni yawng hpe shaga la nhtawm, shanhte hpe shi a yup mang hkai dan wu ai: rai timung, Hpara-u hpe yup mang htai ya lu ai masha langai mi muk n nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi tsabyi jau ai agyi wa gaw Hpara-u hpe, Dai ni she nye a mara ngai dum dat se ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />Hpara-u gaw shi a mayam yan hpe masin pawt nna, sin langa agyi wa a nta e ngai hte muk kabaw agyi wa hpe sharen da mi ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />dai shaloi an lahkawng gaw, langai hte langai, tinang hte seng ai ga lachyum rawng ai yup mang, lana jan sha hta mu ga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte rau sin langa agyi wa a mayam, Hebre shabrang langai mi nga ai: dai wa hpe an hkai dan nna, shi gaw an a yup mang lachyum hpe, langai hte langai mu ai hte maren, an hpe htai ya mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi htai ya ai hte maren mung teng mali ai; ngai gaw nye aya bai lu la nngai, shi gaw noi kau ai hkrum nu ai, ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai majaw Hpara-u masha shangun dat nna Yawsep hpe shaga wu ai: dai rai nna shanhte gaw shi hpe alawan shapraw dat mu ai: shi mung nmun shangun ai hte hpun palawng galai nna, Hpara-u kaw shang sa wa ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Hpara-u gaw Yawsep hpe, Ngai yup mang mu nngai; dai htai ya lu ai masha langai mi mung n nga ma ai: nang chyawm gaw, yup mang hkai ai na jang, de a lachyum nang chye htai ya ai nga ai gaw, ngai na se ai, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yawsep chyawm gaw, Ngai rai timung nye a myit hte htai lu ai n rai: Karai Kasang gaw Hpara-u hpe ngwipyaw ai hte ga lachyum hpaw ya u ga, ngu nna Hpara-u hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Hpara-u gaw, Nye a yup mang hta, yu u, dai hka nu hka kau e ngai tsap nga nngai: shaloi tsawm ai hte hpum ai nga upra sanit dai hka nu na pru lung wa nna, hka kau na hka shaman sha let nga nga ma ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />dai ni a hpang e, grawm grawm re ai hte ja ja n tsawm nna lasi lamun re ai nga upra kaga sanit pru lung wa ma ai; Egutu mung ting hta dai daram wa n tsawm ai gaw lang mi muk ngai n mu yu nngai:
  </para>
  <para style="p">
    <verse number="20" style="v" />dai lasi lamun rai nna, n tsawm ai nga upra ni gaw shawng na hpum ai nga upra sanit hpe sha kau mu ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />shing rai sha kau ai hpang, sha ai mung, gade ai n chye mu ai; dai ni gaw myi na ta naw a lasi nga ma ai; shaloi ngai hprang mat nngai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai nye a yup mang hta ngai mu nngai gaw, yu u, mam nhpun langai mi hta nna kaba ai hte ja kat ai mam gungsi sanit si pru ma ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />bai, yu u, de a hpang e nyip nyip re ai hte kaji nna sinpraw nbung e ahpawt kau sai mam gungsi sanit si pru ma ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />shaloi dai nsan gungsi sanit gaw ja kat ai gungsi sanit hpe mayu kau mu ai: yup mang dai nye a gumhpan ni hpe ngai hkai dan mawe timung, htai ya lu ai masha langai mi muk n nga ma ai, ngu nna Yawsep hte hkai dan wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Yawsep gaw, Hpara-u mu ai yup mang gaw lam langai sha rai nga ai: Karai Kasang galaw na ra ai amu Hpara-u hpe madun dan nu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hpum sau ai nga upra sanit gaw sanit ning rai nga ai; ja kat ai mam gungsi sanit mung sanit ning rai nga ai: dai yup mang gaw lam langai sha rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />De a hpang e pru lung wa ai lasi lamun rai n tsawm ai nga upra sanit hte sinpraw nbung e ahpawt kau sai mam nsan gungsi sanit mung sanit ning rai nga ai: dai gaw hku hku na sanit ning rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hpara-u hpe ngai tsun mayu ai gaw ndai rai nga ai; Karai Kasang galaw na ra ai amu Hpara-u hpe madun dan nu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yu u, Egutu mung ting hta nai mam law law lu ai sanit ning du na ra ai:
  </para>
  <para style="p">
    <verse number="30" style="v" />de a hpang e hku hku ai sanit ning pru nna, Egutu mung na lu su ngamai ai yawng sim mat na ra ai; hku de a majaw mung ting hten mat na ra ai;
  </para>
  <para style="p">
    <verse number="31" style="v" />dai hku wa nachying ja na ra ai majaw, shawng na lusu ngamai ai lam hpe, kadai mung n dum lu hkra rai na ra ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hpara-u yup mang mu kahtap ai gaw, dai amu hpe Karai Kasang shagrin shangang nna alawan shabyin na majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai re ai majaw myit su ai hte hpaji byeng-ya rawng ai masha langai mi Hpara-u tam nna Egutu mung ting a ntsa e san tawn da u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai hta kaga Hpara-u gaw, mung ting hta hpareng san tawn da nna, lu su ai sanit ning hta htam manga hta htammi lahkawn shangun u:
  </para>
  <para style="p">
    <verse number="35" style="v" />shanhte gaw dai du na ra ai lu su ai shaning ni hta jarit mam lahkawn shinggyin la nna, sha jarit tai na matu, mare ni hta, Hpara-u kaw mam htun tawn da mu ga:
  </para>
  <para style="p">
    <verse number="36" style="v" />shaloi Egutu mung e du na ra ai hku hku ai sanit ning hta, mam dai gaw mung masha ni a matu htun tawn da ai jarit mam tai na ra ai rai nna, hku hku ai nhtoi hta mungdan hten lu na n rai, ngu nna Hpara-u hpe htai ya wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai lam gaw Hpara-u a man e mung, shi a agyi salang ni a man e mung, mai kaja nga malu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dai rai nna Hpara-u gaw, Karai Kasang a wenyi rawng ai ndai wa zawn re ai masha gaw, anhte kanang mu tam na ga ta? Ngu nna shi a agyi salang ni hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Bai Hpara-u gaw Yawsep hpe, Karai Kasang gaw nang hpe ndai amu yawng madun nit dai majaw, nang zawn myit su ai hte hpaji rawng ai masha n nga ai:
  </para>
  <para style="p">
    <verse number="40" style="v" />nang gaw nye a nta hta hkaw up tai lu na rai nga ai; na a ga hte maren nye a mung masha ni mahkra hpe up hkang shangun na de ai: tingnyang hte sha ngai nang hta grau na nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Bai Hpara-u gaw, Yu u, Egutu mung ting a ntsa e ngai nang hpe dang da sade ai, nga nna Yawsep hpe tsun let,
  </para>
  <para style="p">
    <verse number="42" style="v" />shi a lata na dazik lachyawp shaw nna Yawsep a lata hta chyawp ya wu ai: reng ai hpun palawng mung shi hpe jahpun nhtawm, shi a du hta ja saidawng gali ya nna,
  </para>
  <para style="p">
    <verse number="43" style="v" />shi a hpang na leng hta shajawn wu ai: shi a shawng e mung, lahput hput di nga mu, nga nna jahtau ma ai: shing di Egutu mung ting a ntsa e shi hpe dang tawn da wu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bai Hpara-u gaw, Ngai Hpara-u rai nga nngai; dai rai nna, na a ahkang hte n rai yang, Egutu mung ting hta kadai mung tinang a lagaw lata sharawt lu na n rai, ngu nna Yawsep hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hpara-u gaw Yawsep hpe Sahpenat Hpanea ngu nna shamying wu ai: Ona mare a hkinjawng Hputi Hpera a shayi sha Asnat hpe shi a matu la ya wu ai: Yawsep mung Egutu mung ting hta jawt hkawm nga ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Yawsep gaw Egutu hkawhkam Hpara-u kaw aya lu ai shaloi shi a asak sumshi ning rai lu ai: shaloi Yawsep gaw Hpara-u kaw na pru nna, Egutu mung ting hkan e jawt hkawm wu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Dai lu su ai sanit ning tup, dai mung hta e nsi naisi ja ja si nga ai;
  </para>
  <para style="p">
    <verse number="48" style="v" />sanit ning tup Egutu mung na jarit mam lahkawn shinggyin nna, mare hkan e htun da wu ai: mare grup yin hkauna ni hta na jarit mam ni hpe dai mare langai hte langai hta htun tawn da wu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Yawsep gaw nammukdara zaibru daram mam law law wa mahkawng da wu ai rai nna, n dang hti hkra law wa ai majaw n hte ai sha nga nga ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Dai hku hku ai shaning garai n du yang, Ona mare a hkinjawng Hputi Hpera a shayi sha Asnat gaw, Yawsep a matu shadang sha lahkawng shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Yawsep gaw, Ngai hkrum ai hki ba lam hte, nye wa nta mahkra hpe Karai Kasang malap kau shangun ni ai, nga nna shi kasha alat hpe Manashe ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hpang na kasha hpe gaw, Ngai matsan tsin-yam hkrum ai mung hta Karai Kasang ngai hpe mayat shangun ni ai, nga nna Ehprim ngu shamying wu ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ya Egutu mung hta lu su ai sanit ning lai mat sai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Dai hpang Yawsep htai ya ai hte maren, hku hku na sanit ning gaw du hpang wa ra ai: shaloi mung shagu hkan e hku hku nga ai, rai timung Egutu mung ting hta gaw lusha nga nga ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ya Egutu mung ting na ni kawsi hkrum ma yang, shanhte gaw Hpara-u kaw lusha hpyi jahtau ma ai shaloi Hpara-u gaw Yawsep kaw sa masit, shi tsun ai hte maren nanhte madat mu, ngu nna Egutu mung masha ni mahkra hpe tsun dat mu ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Dai hku wa gaw ga ntsa ting hta hku nga ai; shaloi Yawsep gaw mamdum nlang hpaw nna Egutu masha ni hpe dut ya mu ai: dai hku wa mung Egutu mung ting hta grau grau laja wa nga ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Dai hku wa gaw mung shagu hta nachying laja nga ai majaw, mung shagu na ni mam mari na nga Egutu mung de Yawsep kaw du sa shajang ma ai.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Egutu mung e mam nga ai lam Yaku na wu ai. Dai rai nna Yaku gaw shi a kasha ni hpe, Hpa rai nanhte shada yu nga myit ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Yu mu, Egutu mung e mam nga ai, nga ai gaw, ngai na se ai. Dai de yu sa nna, anhte matu sa mari masu; shaloi anhte n si n mat hkrung nga na ga ai, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai Yawsep a kahpu ni marai shi, mam sa mari na nga, Egutu mung de yu wa ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yawsep a kanau Ben-yamin hpe chyawm gaw kahpu ni hte rau Yaku n shangun dat wu ai; kaning rai nme law, Shi hta n hpru n mai ai lam lama ma mahkoi hkrum hkra nhten, nga nna tsang wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hku wa gaw Hkanan mung e mung hku wa ai majaw, Egutu mung de mam mari na du sa ai ni hte rau, Israela a kasha ni mung du sa ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai shaloi Yawsep gaw munggyi rai nga ai rai nna, mung masha ni yawng hpe mam dut ya ai madu rai nga ai: shing rai Yawsep a kahpu ni gaw du sa nna, shi a man e ga du hkra dingnyawm dagup ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yawsep gaw shi a kahpu ni hpe mu nna shanhte hpe chye wu ai: rai timung, n chye masu nna, aja awa ga hte, Nanhte kanang na sa myit ta? Ngu nna shanhte hpe san wu ai: shanhte gaw, Lusha mari na, Hkanan mung na sa ga ai law, ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yawsep kahpu ni hpe chye wu timung shanhte gaw shi hpe n chye mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yawsep gaw shanhte a lam hte shi mu ai yup mang hpe dum let, Nanhte kin-yu rai nga myit dai; ndai mung hta n-gun kya ai shara sa yu na nga, sa ai rai myit dai, ngu nna shanhte hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte gaw, N rai ga ai, madu e, na a mayam ni lusha mari na she sa ga ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />anhte yawng kawa langai a kasha hkrai rai ga ai; dingman ai masha mung rai ga ai; na a mayam ni kin-yu n rai ga ai, ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi chyawm gaw, N rai law, ndai mung hta n-gun kya ai shara yu sa ai nan rai myit dai, ngu nna shanhte hpe bai tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai shanhte gaw, Na a mayam ni Hkanan mung e kawa langai a kasha, an nau ni marai shi lahkawng rai ga ai: hpungdim wa mahtang gaw wa hte rau nga nga ta sai, langai mi chyawm gaw n nga ai, ngu nna bai tsun mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yawsep chyawm gaw, Ngai tsun ai hte maren nanhte kin-yu teng ai n teng ai gaw, nanhte hpe ning di chyam yu made ga:
  </para>
  <para style="p">
    <verse number="15" style="v" />nanhte a kanau hpungdim wa n woi sa myit yang gaw, Hpara-u hkrung nga ai hte maren, nanhte nang na pru wa lu na n rai:
  </para>
  <para style="p">
    <verse number="16" style="v" />nanhte a ga teng ai n teng ai chyam yu nna chye lu hkra, nanhte a kanau wa woi la shangun mu; gale ni hpe gaw htawng hta sharen da na made ai; dai hku n rai yang gaw, Hpara-u hkrung nga ai hte maren, gaja wa nanhte kin-yu rai myit dai,
  </para>
  <para style="p">
    <verse number="17" style="v" />ngu nna tsun nhtawm, shanhte mahkra hpe masum ya rim tawn da wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Masum ya du ai shani hta Yawsep gaw shanhte hpe shaga nna, Ngai mung Karai Kasang hpe hkrit ai wa rai nga nngai; dai rai nna nanhte hkrung nga lu na gaw, ning rai mu:
  </para>
  <para style="p">
    <verse number="19" style="v" />nanhte dingman myit dai teng yang gaw nan nau ni hta na langai mi hpe sharen da shangun nna, nanhte gale ni yawng gaw nta na ni hku hku nga ma ai majw mam la nna wa mu;
  </para>
  <para style="p">
    <verse number="20" style="v" />shing rai, nanhte a kanau hpungdim ngai hpang de woi sa marit; dai rai jang, nanhte a ga teng na malit dai nanhte mung si na myit dai n rai, ngu wu ai. Shi tsun ai hte maren mung shanhte galaw ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi shan nau ni shada da tsun hkat ma ai gaw, Gaja wa anhte a kanau wa a majaw anhte mara lu nga ga ai: shi anhte hpe hpyi nem yang, shi a myit masin ru tsang ai hpe anhte mu ya ninglen n madat ya ga ai; dai majaw, ya ndai amu anhte a ntsa e du ra ai, nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rubin chyawm gaw, Ma e hkum hkrit myit, ngu nna ngai tsun se ai n rai ni? Nanhte mahtang n madat myit dai; dai rai nna, shi asai galu ra ai, ngu nna shanhte hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shanhte shada tsun ai ga hpe Yawsep chye na ai gaw shanhte n chye ma ai: kaning rai nme law, Yawsep gaw shanhte hpe ga gale ai wa hte tsun tsun di wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Yawsep gaw shanhte kaw na pru hka nna hkrap nga ai; bai shanhte kaw shi sa nna shanhte hte shaga ngut jang, shanhte a ka-ang na Simun hpe dun la nhtawm, shanhte a man e shi hpe gyit tawn wu ai;
  </para>
  <para style="p">
    <verse number="25" style="v" />dai hta kaga shanhte a daw ni hta mam baw ya nna langai hte langai a jan hta e tinang a gumhpraw bai bang ya na hte, lam na matu sha jarit jaw na Yawsep htet da wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi shanhte gaw lawze ni hta mam daw shagun nna dai kaw na pru mat wa ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dabang e du yang langai wa mi gaw shi a lawze hpe mam yaw na nga shi a jan hpaw yu nna, yu u, jan mahka hta shi a gumhpraw mu wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai rai nna shi gaw kahpu kanau ni hpe, Nye a gumhpraw bai bang da ya mi hka, dai gaw jan mahka e rawng nga li ai, ngu nna tsun wu ai; shaloi shanhte myit mak mat nna, hkrit gari let, Karai Kasang anhte hpe galaw ai ndai gaw, hpa rai nga ai i? nga nna shada da tsun let mau nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi shanhte gaw Hkanan mung e nga ai kawa Yaku kaw du wa nna, shanhte hkrum ai lam magup shi hpe tsun dan mu ai gaw:
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai mung up ai munggyi wa gaw aja awa ga hte anhte hpe dai mung sa yu ai kin-yu shadu mi ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anhte chyawm gaw, Anhte tengman ai masha she rai ga ai; kin-yu n rai ga ai:
  </para>
  <para style="p">
    <verse number="32" style="v" />kawa langai a kasha an nau ni marai shi lahkawng rai nga ga ai: langai mi gaw n nga sai, hpungdim wa mahtang gaw Hkanan mung e kawa hte rau nga nga ta sai, ngu nna shi hpe tsun gaw ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai dai mung up ai munggyi wa gaw, nanhte tengman ai masha re ai n re ai ngai chye lu na gaw, nan nau ni hta na langai mi ngai kaw jahti da mu: nanhte nta na ni hku hku nga ma ai majaw mam la nna wa mu:
  </para>
  <para style="p">
    <verse number="34" style="v" />shing rai nanhte a kanau hpungdim wa hpe ngai hpang de woi sa marit: dai rai jang nanhte kin-yu n rai, tengman ai masha rai myit dai gaw ngai chye lu na made ai: nanhte a hpunau wa hpe mung ngai bai dat ya na made ai; shing rai nanhte ndai ga e hpaga yumga galaw lu na myit dai, nga ai, ngu nna tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai hpang shanhte a mam jan ni htawk mu yang, langai hte langai a gumhpraw makai gaw tinang nang a jan hta e rawng nga malu ai: dai gumhpraw makai ni hpe shanhte hte shanhte a kawa mu mu yang, shanhte hkrit gari nga ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai majaw shanhte a kawa Yaku gaw, Ngai sha ni hpe nanhte gare la kau ya ma manit dai; Yawsep n nga sai, Simun mung n nga sai, ya Bin-yamin hpe mung la kau ya maw nga myit hka; ndai lam mahkra gaw ngai hte nhtan shai ai hkrai rai nga ai, ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shaloi Rubin gaw shi a kawa hpe, Ngai shi hpe nang kaw n woi wa ya sayang gaw, ngai sha yan lahkawng hpe sat kau ya mi; nye a lata hta shi hpe ap ya e, ngai shi hpe nang kaw bai woi wa ya na de ai, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kawa gaw, Ngai sha gaw nanhte hte rau yu sa lu na n rai; shi a kahpu si mat sa lu ai, shi chyu sha ngam sai; nanhte yu sa ai lam e shi hta ruyak lama ma hkrum taw gaw, nye a kara hpraw hpe yawn hkyen ai hte katsan ga de nanhte shayu dat ai sha rai na malit dai, ngu nna tsun wu ai.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai mung e hku grai laja nga ai rai nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />Egutu mung na shanhte htaw wa ai mam ni sha ma ngut jang, kawa gaw, Anhte a matu mam loi mi naw sa mari masu, ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna Yuda gaw, Dai wa anhte hpe grai grai nga shama nna, Nanhte a kanau wa n lawm yang gaw nye myi man n mu lu na myit dai, ngu dat mani ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a kanau wa shalawm dat ya yang gaw anhte yu sa nna na a matu shahpa mari na ga ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />shi hpe n shalawm dat ya yang gaw, anhte n sa na ga ai: kaning rai nme law, dai wa anhte hpe, Nanhte a kanau wa n lawm yang gaw nye a myi man n mu lu na myit dai, ngu mani ai, ngu nna kawa hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai majaw Israela gaw, Dai wa hpe nanhte kanau lu ai lam tam tsun dan nna, ngai hpe hpa rai zingri myit ta? Ngu wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, Dai wa mahtang anhte a lam, anhte a a baw sang lam grai grai nga san let, Nanhte a kawa naw hkrung nga malit ni? Nanhte kanau naw lu myit ni? Nga ai majaw anhte gaw shi a ga hkan nna tsun dan kau ga ai; Nanhte a kanau woi sa myit, nga na gaw, anhte gin di chye lu na ga ta? Ngu mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Yuda gaw shi a kawa Israela hpe, Dai ma ngai hte shakap dat u; dai rai jang anhte rawt nna sa wa na ga ai: shaloi, nang wa mung, anhte hte anhte a ma kaji ni mung, n si n mat hkrung nga na ga ai:
  </para>
  <para style="p">
    <verse number="9" style="v" />shi a pahkam ngai tai sana; nye a lata na shi hpe nang hpyi lu na rai ndai: shi hpe ngai bai n woi wa ai, nan a man e shi hpe n woi tawn ya sayang gaw, prat dingsa na a man e ngai yubak hkrum nga n ga:
  </para>
  <para style="p">
    <verse number="10" style="v" />ndai hte wa nang n ganung nga taw gaw, lang mi bai du wa na saga ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai, shanhte a kawa Israela gaw, Dai rai taw, ning rai mu; dai wa hpe kumhpa sak na matu, ndai ga na kaja htum ai balsam naw loi mi, lagat jahku loi mi, manam pyaw ai hpun naw, mura sau, batan si, jaran si re ai ni la nna nanhte a daw hta htaw hkrat wa mu:
  </para>
  <para style="p">
    <verse number="12" style="v" />nanhte a lata hta gumhpraw htam lahkawng mung la gun mu: nanhte a jan mahka hta rawng lawm wa ai gumhpraw mung bai la gun mu; dai gaw malap kau ai lam rai sam ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />nanhte a kanau hpe mung woi nna, dai wa hpang de bai rawt sa wa masit:
  </para>
  <para style="p">
    <verse number="14" style="v" />nanhte a hpunau wa langai mi hte, Ben-yamin hpe dai wa nanhte hpe dat ya myit ga, Karai Kasang gaw dai wa a man e nanhte hpe myi man shapa ya myit ga law: ngai wa chyawm gaw kasha htum mat ai rai yang mung htum mat dam u ga, ngu nna shanhte hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi shanhte gaw dai kumhpa mung, tinang a lata hta gumhpraw htam lahkawng mung, Ben-yamin hpe mung la woi nna, rawt sa wa ai hte Egutu mung de du nna, Yawsep a man e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte hte rau Ben-yamin lawm sa ai hpe Yawsep mu wu yang, shi a kunhting wa hpe shaga nna, Ndai ni hpe nta de woi wa mu; dai ni shanhte hte ngai shani shat sha na nngai; shat mai sat nna lusha wa lajang u, ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yawsep shangun dat ai hte maren dai kunhting wa galaw nna, shanhte hpe Yawsep a nta de woi wa mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai Yawsep a nta de shaga wa mu yang, shanhte gaw, Shawng e anhte a jan mahka hta bai bang dat a ai gumhpraw a majaw shaga shawn da mi ai: dai hta shi mara tam nna anhte hpe shagyeng nhtawm, mayam yam ai hte anhte a lawze ni mung la kau ya na ma ni ai, nga nna hkrit let tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna shanhte gaw Yawsep a kunhting wa hpang de sit sa nna, chyinghka makau e shi hpe tsun mu ai gaw,
  </para>
  <para style="p">
    <verse number="20" style="v" />Madu e, anhte shawng de lusha mari na teng teng sa ga ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />dabang du nna anhte a jan ni hpe hpaw yu gaw yang, yu u, anhte langai hte langai a gumhpraw gaw myi na ta ta n yawm ai sha, tinang nang a jan mahka ni hta rawng nga la ai: gumhpraw dai ya bai la sa ra ga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya mung lusha mari na gumhpraw kaga anhte bai gun sa ga ai: gumhpraw dai anhte a jan ni hta kadai bang da ya mi ai kun? anhte n chye gaw ai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi chyawm gaw, Nanhte ngwipyaw nga myit, hkum hkrit myit; nanhte a Karai Kasang, nanhte a kawa a Karai Kasang gaw, nanhte a jan ni hta sutgan hkan jaw manit dai; nanhte a gumhpraw gaw ngai lu la sai, nga nna tsun nhtawm, Simun hpe shanhte kaw shapraw dat ya mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hta kaga dai wa gaw Yawsep a nta de shanhte hpe jashawn nhtawm, ntsin jaw wu ai rai nna, shanhte lagaw shin ma ai: lawze ni hpe mung ushat jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai nta hta shanhte hpe shani shat daw na nga ai, nga ma ai majaw jan pungding madi jang Yawsep wa na ra ai nga, myit mada nna shanhte a kumhpa ni lajang tawn da mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya Yawsep nta de du shang wa jang, shanhte lang ai kumhpa hpe, nta nhku de Yawsep kaw la shawn nna, shi a man e ga du hkra gum dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shi gaw shanhte hpe shachyen let, Shawng de nanhte tsun ai nanhte a kawa dingla gaw hkam kaja nga a ni? Shi naw hkrung nga a ni? Ngu nna shanhte hpe san mu yang,
  </para>
  <para style="p">
    <verse number="28" style="v" />shanhte gaw, Na a mayam, anhte a wa, hkam kaja nga ta sai; shi naw hkrung nga ai, nga nna htan let, gum dagup nna nawku ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai sharawt mada yu yang, shi kanu a kasha kanau Ben-yamin hpe mu nna, ndai wa gaw shawng de nanhte tsun ai, nanhte a kanau hpungdim rai nga malit ni? Nga nna, Ngai sha e, Karai Kasang nang hpe chyeju jaw n ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Yawsep gaw shi a kanau hpe mu nna shi a myit masin n-gaw la ai majaw, alawan rawt mat wa nna hkrap na shara tam nga ai: shing rai shi a gawk kata de shang nna hkrap nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai shi a man myit kau nhtawm, pru nna myit shaja let, Lusha tawn maru, ngu wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai rai nna, shi a matu sha ku langai mi, shanhte a matu shara mi, shi kaw rau sha ai Egutu masha ni a matu shara mi di nna kaga ga tawn mu ai: kaning rai nme law, Egutu masha ni gaw Hebre masha ni hte rau shat n sha lu ma ai; dai gaw Egutu masha ni a man e matsat shara rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kahpu kanau ni gaw hpu lat wa kaw nna hpungdim wa du hkra, tinang a aprat kaji kaba hkan nna shi a man e greng rai dung nga ma ai: shanhte chyawm gaw shada yu nna mau nga ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi kaw nna langai hte langai hpe shat lusha shalai jaw dat wu ai; Ben-yamin hpe jaw ai gaw kahpu ni hpe jaw ai hta htam manga law nga lu ai: shaloi shanhte lu sha nna shi hte rau pyaw nga ma ai.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang shi gaw kunhting wa hpe hkang da nna, Ndai ni a jan ni hta shanhte htaw lu ai made baw jahpring ya mu; langai hte langai a gumhpraw mung, tinang nang a jan mahka hta bang dat ya mu:
  </para>
  <para style="p">
    <verse number="2" style="v" />dai nye a gumhpraw gawm hte mam jahpu hpe dai kanau hpungdim wa a jan mahka hta bang dat ya u, ngu wu ai. Kunhting wa mung Yawsep tsun da ai hte maren galaw wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jahpawt nhtoi htoi jang dai masha ni hpe, shanhte a lawze ni hte nawng dat dat mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mare shinggan gale nna gade garai n tsan yang, Yawsep gaw shi a kunhting wa hpe, Rawt u, wora masha ni hpe hkan shachyut su; shanhte hpe dep jang, ning ngu u; Nanhte gaw chyeju hpe n kaja ai hte hpa rai htang myit ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai gaw nye a madu lu ai gawm n rai ni? Gaja wa shaba wawt ai gawm mung rai nga lu ai, n rai ni? Nanhte gaw n kaja ai mi she galaw nga myit dai, ngu su, ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi shanhte hpe shi hkan dep nna, dai hte maren hkan tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, Madu e, shing nga ai gaw hpa nga ai ga rai ta? Dai zawn re ai amu gaw na a mayam ni hte tsan nga u ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yu u, shawng de anhte a jan mahka hta mu ai gumhpraw hpe pyi, Hkanan mung nna nang hpang de bai la sa saga ai: dai she rai yang me, na madu a nta na ja gumhpraw anhte hpa rai lagu na ga ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a mayam ni kadai wa mahtang hta dai mu yang gaw, dai wa gaw si u ga, anhte mung shi madu a mayam ni tai na ga ai, ngu nna shi hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai wa gaw, Nanhte a ga hte maren rai u ga; rai timung, kadai wa mahtang hta mu yang, dai wa gaw nye mayam tai u ga: nanhte gale chyawm gaw lawt na rai myit dai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi shanhte yawng tinang a daw alawan shayu nna, tinang a jan tinang hpaw yu mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai kunhting wa mung, kaba ai wa kaw nna kaji ai wa du hkra tam nna, Ben-yamin a jan hta dai gawm mu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi shanhte gaw tinang a hpun palawng gang je kau nna, tinang a lawze ni hta daw shagun nhtawm mare de bai nhtang sa wa ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Yuda hte shi kahpu kanau ni gaw Yawsep a nta de bai du ma ai; shi mung nta e naw nga nga ai rai nna, shanhte gaw shi a man e ga du hkra dingnyawm dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Yawsep gaw, Nanhte hpa galaw yu myit ta? Ngai zawn re ai masha gaw teng teng shaba chye wawt ai, nanhte n chye myit ni? Ngu nna shanhte hpe hkap tsun mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna Yuda gaw, Nang madu hpe kaning ngu htan lu na ga ta? Hpa chye tsun na ga ta? Mara kanang raw lu na ga ta? Karai Kasang gaw na a mayam ni a mara sagawn nna mu ya ma ni ai: yu u, shi a lata hta gawm rawng ai wa hte anhte yawng hte gaw na a mayam ni rai saga ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yawsep chyawm gaw, Dai hku di na, ngai hte tsan u ga; gade a lata hta dai gawm rawng yang, dai wa sha nye a mayam tai u ga; nanhte chyawm gaw, nanhte a kawa hpang de angwi apyaw lung wa masit, ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai majaw Yuda gaw Yawsep hpang de sit sa nna, Nye a madu e, na a mayam nye madu a na hta ga hkaw mi tsun lu shangun e law; na mayam hpe masin hkum pawt et; nang gaw Hpara-u zawn rai nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />nang Madu na a mayam ni hpe, Nanhte kawa lu myit ni? Kanau lu myit ni? Nga nna san yang,
  </para>
  <para style="p">
    <verse number="20" style="v" />anhte mung, Anhte kawa dingla lu ga ai; shi dingla sayang na kasha kaji langai mi mung nga ai; shi kahpu chyawm gaw si mat salu ai, shi a kanu hta na shi hkrai sha ngam mat sai rai nna shi a kawa shi hpe tsawra wu ai, ngu nna nang madu hpe tsun dan ga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi nang mung, Dai wa hpe ngai mu lu hkra ngai hpang de shaga sa myit, nga nna na a mayam ni hpe tsun yang,
  </para>
  <para style="p">
    <verse number="22" style="v" />anhte gaw, Dai ma hpe kawa hte n jahka lu ai; kawa hte hka jang gaw kawa si mat na re ai, ngu nna nang madu hpe tsun ga timung,
  </para>
  <para style="p">
    <verse number="23" style="v" />nang mahtang, Nanhte a kanau n lawm yang gaw, nanhte nye a myi man hpang de n mu lu na myit dai, nga nna na a mayam ni hpe tsun dat ndai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai anhte gaw na mayam wa nye wa hpang de du wa yang nang madu a ga hte maren tsun dan ga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anhte a wa mung, Bai sa nna, anhte a matu lusha loi mi sa mari la ma su, ngu mi ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi anhte gaw, N yu sa lu na ga ai; anhte a kanau wa lawm yang gaw sa lu na ga ai; anhte a kanau wa n lawm yang gaw dai wa a myi man n mu ya lu na ga ai, ngu nna tsun ga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai rai nna na a mayam nye a wa tsun mi ai gaw, Nye a madu jan ngai hpe shadang sha lahkawng sha shangai ya ai gaw nanhte chye nga myit dai:
  </para>
  <para style="p">
    <verse number="28" style="v" />langai mi gaw ngai kaw na pru mat wa sai, Shi hpe gaja wa teng teng kahtum gadaw kawa dut kau nu hka, ngai ngu nna, dai kaw nna ya du hkra shi hpe ngai n mu lu ni ai:
  </para>
  <para style="p">
    <verse number="29" style="v" />ya ndai wa hpe mung, ngai kaw na woi mat wa nna, shi hta n hpru n mai ai lama ma hkrum yang gaw, nye a kara hpraw hpe yawn hkren ai hte katsan ga de nanhte yu shangun ai sha rai na myit dai, ngu mi ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai rai nna, na a mayam nye wa kaw ngai du wa ai shaloi, dai ma anhte hta n lawm yang gaw, kawa a myit masin dai ma hta manoi nga lu ai majaw,
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai ma n lawm ai shi mu jang, shi si mat na ra ai: dai rai nna, na a mayam ni gaw na a mayam anhte a wa a kara hpraw hpe yawn hkyen ai hte katsan ga de shayu ya ai sha rai na ra ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai hta kaga ngai na a mayam gaw, Ngai dai ma hpe nang wa hpang de bai n woi wa ya yang gaw, na a man e prat dingsa ngai mara lu nga ni ga, ngu nna wa kaw ma a pahkam tai ni ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai re ai majaw, ngai mahtang ma a malai hti nga nna, nang madu kaw yamnga ni ga: ma hpe chyawm gaw kahpu ni hte rau wa lu shangun ya e.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nye wa hta byin na ra ai aru ara ngai mu lu hkra, dai ma ngai kaw n lawm yang gaw, nye wa hpang de ngai kaning rai lung wa lu na rai nga a ta? ngu nna tsun wu ai.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yawsep gaw shi kaw nga ai ni a man e myit n shaja lu wu ai majaw, Masha mahkra ngai kaw na pru mat mu, nga nna jahtau wu ai. Yawsep gaw shi a kahpu kanau ni hpe, shi kadai re ai lam shapraw dan ai shaloi, masha kaga kadai mung n nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Yawsep jahtau hkrap nna, Egutu masha ni mung, Hpara-u a nta na ni mung na ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yawsep gaw shi a kahpu kanau ni hpe mung, Ngai gaw Yawsep rai nga nngai; nye a wa naw hkrung nga a ni? Ngu mu ai. Kahpu kanau ni chyawm gaw, shi a man e hkrit mau mat ma ai majaw, ga n htan lu ma ai
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Yawsep gaw, Ngai hpang de sit wa marit, ngu nna kahpu kanau ni hpe tsun wu yang, shanhte mung shi makau de sit wa ma ai. Shaloi shi gaw, Ngai gaw nanhte Egutu mung de dut kau dat ai, nanhte a kanau Yawsep rai nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai timung, nanhte ngai hpe nang de dut kau dat myit dai majaw myit hkum ru myit; tinang hkum hpe mung hkum pawt myit: kaning rai nme law, masha asak pau u ga nga Karai Kasang gaw nanhte a shawng e ngai hpe shangun dat ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ndai mung e ya hku hku ai ni ning rai sai: yi hkauna n galau lu na hte mam n dan lu na manga ning naw ra nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ga ntsa e nanhte hpe ngam nga shangun na mung, hkye la lam kaba hte nanhte hpe jahkrung da na matu mung, nanhte a shawng e Karai Kasang ngai hpe shangun dat ni ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna nanhte ngai hpe ndai de shangun dat myit dai n rai; Karai Kasang e shangun dat ai rai nga ai: ya ngai hpe Hpara-u a kawa tai na matu mung, shi a nta up na hte Egutu mung ting a madu tai na matu mung, san da ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya alawan rawt nna wa hpang de wa mu; wa hpe mung, Na nsha Yawsep ning nga dat ai; Karai Kasang gaw ngai hpe Egutu mung ting a madu shatai ni ai; ngai hpang de yu wa rit; hkum hkring nga nit:
  </para>
  <para style="p">
    <verse number="10" style="v" />nang wa Goshen mung hta e sa nga lu na rai nga ai; nang wa hte na nshu nsha ni mung, na a sagu bainam, yamnga hpung ni mahkra hte nang lu malu yawng, ngai hte ani sha nga lu na rai nga ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />dai yang e ngai nanhte hpe bau na made ai; shing n rai yang, hku hku na manga ning naw ra nga ai majaw, nang wa hte na dum nta masha ni makra matsan tsin-yam let na myit dai da, ngu mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yu mu, ngai hkum nan, nye n-gup hte nanhte hpe shaga lu ai gaw, nanhte a myi mung, ngai nau Ben-yamin a myi mung mu da chyalu rai manit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Egutu mung e ngai lu ai arawng sadang hte nanhte mu mamu wa hpe tsun dan na rai myit dai: alawan wan rai nna wa hte ndai ga de yu hkrat wa marit, ngu nhtawm,
  </para>
  <para style="p">
    <verse number="14" style="v" />kanau Ben-yamin a du ahpum nna hkrap nga ai; Ben-yamin mung shi a du hta noi nna hkrap nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kahpu kanau ni mahkra hpe mung shi pup nna shanhte hte hkrap nga ai: dai hpang shi a kahpu kanau ni gaw shi hte shaga nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Yawsep a kahpu kanau ni du mara ai, nga ai shiga gaw, Hpara-u a nta na ni na ma ai rai nna, dai hpe Hpara-u hte shi a agyi salang ni na sharawng ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna Hpara-u gaw Yawsep hpe shaga nhtawm, Na nhpu nnau ni hpe ning ngu lam madun u; nanhte a yamnga daw ni shagun nna Hkanan mung de naw bai wa nhtawm;
  </para>
  <para style="p">
    <verse number="18" style="v" />nanhte a kawa hte nanhte a nta masha ni yawng hpe woi nna ngai hpang de yu wa marit; Egutu mung na ngamu ngamai ai ngai nanhte hpe jaw na made ai rai nna, ndai mung a ga sau tung nanhte sha lu na marin dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya ngai nang hpe hkang da ai hte maren, ning rai galaw mu: nanhte a num ni hte ma kaji ni a matu Egutu mung na leng la wa nna, nanhte a kawa hpe woi yu hkrat wa marit:
  </para>
  <para style="p">
    <verse number="20" style="v" />nanhte a arung arai ni hpe hkum lahpawt myit; Egutu mung ting na nga mai ai gaw, nanhte a sut rai nga ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hte maren Israela a kasha ni galaw ma ai rai nna, Yawsep gaw, Hpara-u hkang da ai hte maren shanhte hpe leng mung, lam na sha jarit mung jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kahpu kanau ni mahkra hpe mung hpun palawng galai jaw mu ai: Ben-yamin hpe chyawm gaw, gumhpraw lap masum tsa hte hpun palawng man manga naw kahtap jaw wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kawa hpang de mung, Egutu mung na arai kaja htaw ai lawze shi, shi kawa a lam jarit shatai na mam hte muk re ai lusha shahpa htaw ai lawze yi shi jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nanhte hkrun lam e ga law ga la hkum rai myit, nga nna htet dat let, shanhte hpe shabawn dat mu ai rai nna, kahpu kanau ni pru mat wa ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai shanhte gaw Egutu mung na pru lung wa nna, Hkanan mung de kawa Yaku kaw du wa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi shanhte gaw, Yawsep naw hkrung nga ai, Egutu mung ting shi up nga ai, ngu nna tsun dan mu yang, Yaku gaw myit masin mak mat ai hte, shanhte tsun ai ga hpe n kam wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte mung, Yawsep tsun dat ai ga mahkra shi hpe hti dan mu ai: Yaku gaw, shi hpe shajawn na matu Yawsep jaw dat ai leng ni hpe mu jang, myit bai bran wu ai:
  </para>
  <para style="p">
    <verse number="28" style="v" />dai rai nna Israela gaw, Rai sa, ngai sha Yawsep naw hkrung nga li ai; nga garai n si yang shi hpe jahkrum na nga sa yu na we ai, nga ai.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Israela gaw shi lu malu mahkra hte htawt sa wa nna, Berasheba de du jang, shi a kawa Isak a Karai Kasang hpe hkungga jaw wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang mung shana e shingran hta Israela hpe shaga nna, Yaku e, Yaku e, ngu wu ai: shi gaw, Nang rai nga nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Karai Kasang gaw, Ngai gaw Karai Kasang nan rai nga nngai: Egutu mung de yu wa na lam hpe hkum myit ru et; dai kaw e nang hpe ngai amyu kaba shatai na de ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />ngai nang hte rau Egutu mung de yu wa na nngai; dai kaw na ngai nang hpe bai woi lung wa na de ai: Yawsep mung shi a lata na a myit hta mara ya lu na rin dai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Yaku gaw Berasheba kaw na rawt ai rai nna, Israela kasha ni gaw shanhte a kawa hpe mung, shanhte a num ni hte ma kaji ni hpe mung, shi hpe shajawn na matu Hpara-u jaw dat ai leng ni hte htaw mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkanan mung e shanhte lu ai yamnga ni hte sutgan rai ni hpe mung la nna Egutu mung de sa wa ma ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />shing rai Yaku gaw shi hkum hte shi a shayi shadang sha ni ngu ai, shi a kashu kasha ni hte shanhte a matu mara ni mahkra hte hpawn, Egutu mung de yu hkrat wa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Da ndai gaw Egutu mung de du ai Israela a kashu kasha ni a amying rai malu ai; Yaku hte shi a shadang sha ni gaw: - Yaku a kasha alat Rubin rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rubin a shadang sha ni gaw, Enuk, Hpalu, Hesrun, Hkami, hte rai ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simun a shadang sha ni gaw, Yemuela, Yamin, Ohad, Yahkin, Tsuhara hte Hkanan num hta na Sha-ula hte rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lewi a shadang sha ni gaw, Gershon, Kehat, Merari hte rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yuda a shadang sha ni gaw, Era, Onan, Shela, Hparet, Zerak hte rai ma ai; Era hte Onan chyawm gaw Hkanan mung e si mat masai: bai Hparet a shadang sha Hezron yan Hamula rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yisahka shadang sha ni gaw Htola, Hpua, Yoba, Shimron hte rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun a shadang sha ni gaw, Sered, Elon, Yabula hte rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ndai hte gaw Hpadan Aram e Yaku a matu shaprat ai, Lea hta na shadang sha ni hte shi a shayi sha Dina rai nga ma ai: shi a shayi shadang sha ni yawng sumshi masum rai nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad a shadang sha ni gaw, Tsipyon, Hagi, Shuni, Ezbun, Eri, Arudi, Areli hte rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ashe a shadang sha ni gaw, Yimna, Yiswa, Yiswi, Beria hte shanhte a kajan Sera hte rai ma ai: Beria a shadang sha gaw Hebera yan Malhkiela rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ndai hte gaw Laban shi a shayi sha Lea hpe jaw ai Zilhpa a shadang sha ni rai ma ai: Yaku a matu shi shaprat ai masha yawng marai shi kru rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yaku a num dun Rahkela hta na shadan sha gaw Yawsep yan Ben-yamin rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Egutu mung e Ona mare a hkinjawng Hpoti-hpera a shayi sha Asenat hta na Yawsep a matu shaprat ai shadang sha gaw, Manashe yan Ehprim rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ben-yamin a shadang sha ni gaw, Bela, Behkara, Ashbela, Gera, Naman, Ehi, Rosha, Muhpim, Huhpim Arda hte rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ndai hte gaw Yaku a matu Rahkela hta na prat ai shadang sha ni rai ma ai: masha yawng marai shi mali rai ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan a shadang sha gaw Hushim rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali a shadang sha ni gaw, Yazela, Guni, Yesera Shilem hte rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ndai hte gaw Laban shi a shayi sha Rahkela hpe jaw ai Bila hta na Yaku a matu shaprat ai shadang sha ni rai ma ai: masha yawng marai sanit rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yaku a kanam ni hpe n shalawm yang, Yaku a nshang na hkrat nna shi hte rau Egutu mung de sa wa ai ni yawng gaw, shinggyim masha mahkra marai kru shi kru rai ma ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />Egutu mung e Yawsep lu ai shadang sha lahkawng nga ma ai: dai rai nna Egutu mung de du ai Yaku a amyu matu yawng gaw, shinggyim masha marai sanit shi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Goshen mung de shi hpe lam sa madun ru ga nga, Yawsep hpang de Yuda hpe shi a shawng e shangun dat wu ai: shanhte mung Goshen mung de du ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai rai nna Yawsep gaw shi a leng byau la nna, shi a kawa Israela hpe wa tau la na, Goshen mung de lung wa ai: kawa kaw du jang shi hkum shi madun nna, kawa a du hta ahpum noi let na na wa hkrap nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Israela gaw, Ya ngai si ni ga, nang naw hkrung nga ai myi man gaw, ngai mu da ya sade ai, ngu nna Yawsep hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Yawsep gaw shi a kahpu kanau ni hte she a kawa a nta masha ni hpe, Ngai naw lung wa ni ga; shing rai, Hkanan mung na nye a hpunau ni hte nye wa nta masha ni ngai kaw du mara ai:
  </para>
  <para style="p">
    <verse number="32" style="v" />dai ni gaw sagu rem ni rai nga ma ai: dai rai nna shanhte a sagu bainam hpung ni hpe mung, shanhte a yamnga hpung ni hpe mung, shanhte lu malu mahkra hte hpe la sa mara ai, ngu nna Hpara-u hpe ngai wa tsun shana na we ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai hpang Hpara-u nanhte hpe shaga nna, Nanhte hpa galaw sha myit ta? nga nna san myit yang,
  </para>
  <para style="p">
    <verse number="34" style="v" />nanhte gaw, Na a mayam ni anhte gaw, ji woi prat nna kaji kaw na kaba du hkra, yamnga rem sha ai ni rai ga ai, ngu nna tsun na rai myit dai: shaloi Goshen mung hta nga na ahkang lu na ra ai: kaning rai nme law, sagu rem sha ai ni kadai hpe mung, Egutu masha ni matsat ma ai, ngu nna tsun da wu ai.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yawsep gaw Hpara-u kaw shang nna, Nye wa hte ngai hpu ngai nau ni, shanhte a sagu bainam, yamnga hpung ni hte arung arai yawng htaw nna Hkanan mung na du mara ai rai nna Goshen mung e nga nga ma ai, ngu nna tsun shana wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a kahpu kanau ni hta na marai manga hpe mung shi lata la nna Hpara-u kaw woi shang wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Hpara-u gaw, Nanhte hpa galaw sha ai ni rai myit ta? ngu nna Yawsep a kahpu kanau ni hpe san wu yang, shanhte gaw, Na mayam ni anhte gaw ji woi prat kaw nna sagu rem sha ai ni rai ga ai, ngu nna Hpara-u hpe htan mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai shanhte gaw, Hkanan mung e hku hku la nna, na a mayam ni a yamnga hpung ni matu udat shara n nga ai majaw, ndai mung hta shingbyi nga na, ngu nna anhte du sa ga ai: dai re ai majaw na a mayam ni Goshen mung e nga lu na ahkang jaw mi, ngu nna Hpara-u hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Hpara-u gaw Yawsep hpe, Na nwa hte nhpu nnau ni nang kaw du mara ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Egutu mung gaw na a man e dam nga ai; na nwa hte nhpu nnau ni hpe grau kaja htum ai shara, Goshen mung e tawn da u; shanhte hta myit kunghpan ai masha mu hkrup yang gaw, nye a yamnga rem agyi san da u, ngu wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang Yawsep gaw shi a kawa Yaku hpe jashawn nna, Hpara-u a man e shatsap da wu ai: Yaku mung Hpara-u hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Hpara-u gaw Yaku hpe shachyen let, Nang asak gade ning rai salit ta? ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaku gaw Hpara-u hpe, Ngai malet nhprang manam rai nna, lai mat sai nhtoi shaning gaw latsa e sumshi ning rai sali ai: ngai hkrung nga ai nhtoi shaning gadun ai hte yak la li ai rai nna, nye a aji awa ni a malet nhprang manam rai yang na hkrung nga ai asak nhtoi hpe n dep ya lu mawe ai, nga nna tsun nhtawm,
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku gaw Hpara-u hpe shaman ya nna shi kaw na pru mat wa ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang Yawsep gaw, Hpara-u a mungga hte maren, shi a kawa hte kahpu kanau ni hpe Egutu mung na kaja htum ai shara ngu ai, Ramase lamu ga hta nga shangun tawn mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai Yawsep gaw shi a kawa pe mung, shi a kahpu kanau ni hpe mung, shi a kawa a nta masha ni mahkra hpe mung, Htinggaw hkan nna lusha mam hte bau wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya dai mung ting hta lusha n nga ai: dai hku wa gaw nachying laja nga ai rai nna, Egutu mung hte Hkanan mung gaw dai hku wa ai majaw n-gun yaw mat ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yawsep mung, Egutu mung hte Hkanan mung hta, mung masha ni mari ai mam jahpu gumhpraw mu mamu hpe shinggyin nna, Hpara-u a sutdek hta bang da wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya Egutu mung hte Hkanan mung hta gumhpraw ma mat malu yang, Egutu mung masha ni mahkra gaw Yawsep kaw sa nna, Anhte hpe lusha jaw mi; anhte a gumhpraw ma mat sai majaw, na a man e anhte hpa rai si na ga ta? ngu nna hpyi mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Yawsep gaw, Gumhpraw ma malit yang gaw, nanhte a yamnga ya mi; dai yamnga a jahpu nanhte hpe mam jaw made ga, ngu wu ai;
  </para>
  <para style="p">
    <verse number="17" style="v" />dai hte maren shanhte Yawsep hpang de tinang a yamnga ni la sa mu ai rai nna, Yawsep gaw, gumra, sagu bainam hpung ni nga dumsu hpung ni hte lawze ni a matu, shanhte hpe mam jaw nna, dai shaning hta yamnga yawng a jahpu hte bau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai shaning htum yang, hpang shaning hta mung, shanhte sa du nna, Madu e, anhte a gumhpraw ma mat sai gaw, anhte nyet lu ga ai n rai; anhte a yamnga mung, nang madu, lu la nit dai: nang madu a man e anhte a hkum hte anhte madu ai lamu ga hta kaga hpa mung n ngam sai:
  </para>
  <para style="p">
    <verse number="19" style="v" />na a man e anhte hpa majaw si nna mungdan hten na rai ta? anhte a hkum hte anhte a lamu ga mari la nna anhte hpe lusha jaw mi; shing rai anhte hkum hte nawng anhte a lamu ga gaw Hpara-u kaw yam na ga ai: anhte n si na mat hkrung nga na hte, mungdan n katsi mat na matu, anhte hpe nli jaw mi, ngu nna hpyi mu, ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna Yawsep gaw Egutu mung na lamu ga mahkra hpe Hpara-u a matu mari la wu ai: kaning rai nme law, dai hku wa laja nga ai majaw, Egutu masha ni langai hte langai tinang madu ai lamu ga dut kau ma ai rai nna, dai gaw Hpara-u a lamu ga hkrai tai mat malu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mung masha ni hpe chyawm gaw, Egutu mung maga mi de na ni hpe maga mi de na, mare ni hta htawt nga shangun mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hkinjawng ni a ga hpe chyawm gaw shi mari la ya wu ai n rai: shanhte hpe gaw Hpara-u bau wu ai rai nna, Hpara-u gaw shanhte hpe jaw ai hta na sha nga lu ma ai: dai majaw shan hte gaw tinang a ga n dut ra ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai Yawsep gaw mung masha ni hpe, Yu mu, nanhte hkum hte nanhte a lamu ga hpe Hpara-u a matu dai ni nga mari la masade ai: nang e nlu nga nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />nanhte a lamu ga hta galaw hkai mu: nsi naisi shu ai shaloi, htam manga hta htammi gaw Hpara-u kaw sak lu na rai myit dai: htam mali chyawm gaw nanhte la nna hpang na nli shatai na hte, nanhte hte nanhte a nta masha ni sha na matu mung, nanhte a ma kaji ni hpe bau na matu mung tai na malit dai, ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte mung, Anhte a asak hpe nang hkye la ya nit dai: nang madu a man e anhte myi man pa saga ai rai nna anhte gaw Hpara-u a mayam ni tai na ga ai, ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai majaw htam manga hta htammi Hpara-u lahkawn sha u ga, nga nna dai ni du hkra Egutu mung e nga ai tara gaw Yawsep tawn da ai rai nga ai: hkinjawng ni a lamu ga chyu sha Hpara-u a ga n tai lu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shaloi Israela masha ni gaw Egutu mung Goshen shara e nga nga ma ai rai nna, lu su ngamai wa ai hte mayat maya let ja ja law htam wa nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yaku gaw Egutu mung e shi sanit ning sa nga ai rai nna, shi hkrung nga ai nhtoi yawng latsa e mali shi sanit ning rai lu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya Israela a si wa na nhtoi du magang salu ai rai nna shi a kasha Yawsep hpe shaga nhtawm, Na a man e ngai myi man pa ni ai rai yang gaw, na a lata nye a magyi npu e shawn bang u; chyeju hte sadi sahka lam ngai hpe madun nna, Egutu mung e ngai hpe hkum lup makoi et:
  </para>
  <para style="p">
    <verse number="30" style="v" />ngai ji ngai wa ni hte ngai yup nga yang, Egutu mung na nang ngai hpe la lung wa nna shanhte hpe lup ai shara hta e ngai hpe mung lup makoi lu na rai ndai, ngu wu ai. Yawsep mung, Nang wa tsun ai hte maren ngai galaw na nngai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Yaku gaw, Ngai hpe dagam dat e, ngu wu ai. Dai rai nna shi mung dagam wu ai. Shing rai Israela gaw yup ku baw nhpang e nawku gum nga ai.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang masha langai mi Yawsep hpe, Na nwa machyi nga lit dai, nga nna tsun dan wu ai: dai majaw shi a kasha Manashe yan Ehprim hpe woi nna lung wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi masha langai mi mung Yaku hpe, Na nsha Yawsep du ra ai, ngu nna tsun dan wu ai: dai rai nna Israela gaw shalan shaja nna yup ku hta dung nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Yaku gaw, Chyahtum chyalai n-gun rawng ai Karai Kasang gaw Hkanan mung Luza mare e ngai kaw dan pru nna shaman ya let tsun nngai gaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />Yu u, nang hpe ngai mayat maya shangun nna shalaw jahtam na de ai; masha amyu wunawng wuwa nang hta na ngai shatai na we ai; htawm hpang e na amyu matu ni ndai mung htani htana madu nga lu na matu, ngai jaw na mawe ai, ngu nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya chyawm gaw, Egutu mung e nang kaw ngai garai n du yang, Egutu mung e nang lu ai shadang sha lahkawng gaw nye a matu mara tai na ma ai: Ehprim yan Manashe gaw Rubin yan Simun zawn nye a matu mara tai na ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Htawm hpang nang shaprat na kasha ni gaw na a matu mara tai na rai nna, shanhte lu la na lamu ga ta shanhte a kahpu yan a amying hte shamying lu na rai mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a matu ngu na gaw, Hpadan mung na ngai bai wa ai shaloi, Hkanan mung Ehprahta mare garai n du kaw, dai lam hta e Rahkela gaw nye a makau e si mat sali ai rai nna, Betlehim ngu ai Ehprahta de sa ai lam e ngai shi hpe lup makoi se ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Israela gaw Yawsep a kasha yan hpe mu nna, Ndai yan gaw kadai dai rai ma ta? ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yawsep gaw, Ndai mung e Karai Kasang ngai hpe jaw ai ngai sha yan rai nga ma ai, ngu nna kawa hpe tsun wu ai. Kawa gaw, Shan hpe ngai kaw sit wa shangun rit, shan hpe ngai shaman ya mawe ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, Israela dingla la sai majaw myi amam nna n mu lu wu ai: shan hpe she kaw sit wa shangun nna, shan hpe ahpum let pup wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Israela gaw, Na a myi man mu lu na pyi ngai n myit nngai; rai timung, ya gaw na a matu mara du hkra Karai Kasang ngai hpe madun ni ai, ngu nna Yawsep hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yawsep gaw kasha yan hpe kawa lahpyen na shaw la nhtawm, ga du hkra myi man gum dagup wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai Yawsep gaw shan hpe la nna, Ehprim hpe shi a hkra lata hte dun nna, Israela a pai lata ang ang, Manashe hpe pai lata hte dun nna, Israela a hkra lata ang ang, woi sit wa mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israela chyawm gaw, Manashe kasha alat rai nga timung, zai hte shi a lata kashai nhtawm, shi a hkra lata ladawn nna, asak kaji ai Ehprim a baw ntsa e mara wu ai; shi a pai lata hpe gaw Manashe a baw ntsa e mara wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai Yawsep hpe shaman ya wu ai gaw, Ngai ji Abraham hte ngai wa Isak hkan hkawm nga ai Karai Kasang, shawng nnan nna dai ni du hkra ngai hpe bau ai Karai Kasang ngu ai,
  </para>
  <para style="p">
    <verse number="16" style="v" />kyin dut lam shagu hta na ngai hpe hkye hkrang la ai Lamu kasa gaw, ndai mayan hpe shaman ya u ga law: nye a amying hte mung, ngai ji Abraham yan ngai wa Isak a amying hte mung, shan hpe kahrap shamying mu ga law: ga ntsa e shan mayat maya wa nna, wunawng wuwa tai nga manu ga law, ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kawa gaw Ehprim a baw ntsa e shi a hkra lata mara wu ai hpe Yawsep mu wu yang, shi myi n mu nna, kawa hpe,
  </para>
  <para style="p">
    <verse number="18" style="v" />N rai, wa e, ndai mahtang alat rai nga ai; ndai wa a baw hta she na a hkra lata mara u, nga nna tsun let, kawa a lata hpe Ehprim a baw na Manashe a baw de htawt mara ya na nga, kawa a lata sa pawn ya wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kawa chyawm gaw n hkraw nna, Ngai chye nga nngai, ngai sha e, ngai chye nga nngai: shi mung amyu baw mi rai nna, galu kaba wa na ra ai: rai timung shi a kanau gaw shi hta grau kaba na ra ai rai nna, shi a matu mara ni masha amyu law law tai na mara ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai shi gaw, Karai Kasang nang hpe Ehprim yan Manashe hpe zawn shatai u ga law, nga nna Israela kashu kasha ni na a marang e shaman ai ga tsun nga na masai, ngu nna dai shani e shan hpe shaman ya wu ai: shing rai Manashe a shara hta Ehprim hpe tawn da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai Israela gaw, Ya ngai si wa na ni ai; rai timung Karai Kasang nanhte hte rau nga nga nna, nanhte a nji nwa ni nga nga ai ga de, nanhte hpe bai woi wa na marin dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hta kaga, na nhpu nnau ni hpe jaw ai hta ngai nang hpe grau jaw ai gaw, nye a nhtu hte ndan, Amori masha ni kaw na ngai lu la ai ga dachyawk rai na rai lit dai, ngu nna Yawsep hpe madat tsun da wu ai.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpawa e Yaku gaw shi a shadang sha ni hpe shaga nna, Htawm hpang e nanhte hta byin pru na ra ai lam, ngai nanhte hpe tsun da made ga, nang e wa hpawng marit:
  </para>
  <para style="p">
    <verse number="2" style="v" />Yaku a shadang sha ni e, wa hpawng nna na la mu, Nanhte a kawa Israela a ga madat la maru:
  </para>
  <para style="p">
    <verse number="3" style="v" />Rubin e, nang ngai sha alat rai ndai, Nye a nsam hte nye a n-gun ningshawng, Grau ai arawng, hpung shingkang ningtawn, nang rai nga ndai:-
  </para>
  <para style="p">
    <verse number="4" style="v" />Hka zawn kabrawng ndai rai nna nang grau lu na n rai: Na nwa a yup ku hta nang lung nna, Dai hpe nang awu asin di kau nu ai:- nye a yup ku hta shi lung wa a hka:
  </para>
  <para style="p">
    <verse number="5" style="v" />Simun yan Lewi shan nau rai nga ma ai; Shan a nhtu n hkru n shawp ai hpyen rai, rai malu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye myit masin e, shan a bawng ai hta hkum lawm et; Nye a arawng sadang e, shan a hpung hta hkum shang et; Shan a masin pawt ai hte masha asak sat manu ai, Tinang myit hkan nna usu lahkap dan masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shan a masin pawt ai ja nga malu ai hte, Shan a n-yun bu ai mazut nga malu ai majaw, dagam dala hkrum u ga. Yuda hta na ngai shan hpe karan kau na mawe ai. Israela hta na ngai shan hpe shabra kau na mawe ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yuda e, na nhpu nnau ni nang hpe shakawn na nit dai; Na lata gaw nang hpe hpyen ai ni a du hta mara nga na ra ai; Na nwa kasha ni na a man e gum dagup na mara ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yuda gaw hkanghkyi hkalung rai nga ai: Ngai sha e, htim sha ai kaw na nang lung wa wa rai ndai: Hkanghkyi hte hkanghkyi kanu zawn, shi hpum let gyem nga ai: shi hpe kadai wa shatu gwi na a ta?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngwipyaw Madu du nna, Masha amyu ni shi a ga madat mara nga ai du hkra, Yuda kaw na hkawhkam sumdoi, Shi a lahpyen n daru magam dawhkrawng, kangai mat lu na n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi gaw, si a lawze hpe tsabyi hpun hta, Shi a lawze kasha hpe kaja htum ai tsabyi ru hta dun da let, Shi a hpun palawng tsabyi jahku hta, Shi a hpun nba tsabyi si sai hta hkrut na ru ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a myi tsabyi jahku hte hkyeng na ra ai, Shi a wa mung nga chyu hte hpraw na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebulun gaw nawng hkin-gau e nga nna, Sanghpaw li sek ai danam tai na ra ai: Shi a lamu ga jarit Zidun makau du hkra maden na ra ai
  </para>
  <para style="p">
    <verse number="14" style="v" />Yisahka gaw, ulawng ni a laprin e hpum nna, N-gun ja la ai lawze rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi a sa ra kaja nga lu ai hte, Dai lamu ga masan nga ai hpe, shi mu wu ai. Lit hpai na nga shi lahpa ja nna, Shabrai sha ai nchyang tai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan gaw, Israela amyu ni hta langai mi zawn, Shi a masha ni hpe tara dara na ru ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan gaw, nmaw lam hta e lapu, Lam masun e pu htum tai nna, Gumra jawn ai wa hpe kadawng shangun na nga, Gumra lahtin kawa na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa e, na a hkye hkrang la ai lam ngai ala nga ni ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gad gaw, hpyen hpung mi shi hpe wang matep timung, Shi shanhte a lahtin hpe dip matep na ra ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mu sau ai lusha gaw Ashe kaw na pru ai rai nna, Hkawhkam sha mu ai baw shi jaw na ra ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naphtali gaw dat dat sai shan yi rai nga ai, Ga dwi ga sau chye shapraw nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yawsep gaw, asi si ai hpun lakung rai nga ai, Hka deng makau na asi si ai lakung rai nga ai. Shi a lakung lakying ni bunghku htawng nga lu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ndan jaugawng ni shi hpe n ju ma ai hte, Shi hpe shading gap nna zingri zingrat mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rai timung, Yaku hta daru magam rawng ai wa a lata hte, Sagu rem wa ngu ai Israela a nlung hta nna mung, Nang hpe karum nga ai, na nwa a Karai Kasang hte,
  </para>
  <para style="p">
    <verse number="25" style="v" />Sumsing lamu na shaman ai chyeju, Le sung ai kata tang na shaman ai chyeju, Madoi chyu hpang hte hkritung krawng wang a shaman ai chyeju gaw, Nang hpe shaman ya na chyahtum chyalai n-gun rawng ai wa kaw nna mung, Shi a ndan ngang ngang rai nga lu ai, Shi a lahpum lahpaw mung kung nga lu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na nwa a shaman ai chyeju gaw Ngai ji ngai wa ni a shaman ai chyeju hta grau nna, Htani htana grin nga ai bum ni a tsan htum ai jarit du hkra dep nga ai: Dai chyeju gaw Yawsep a baw ntsa e, Shi a kahpu kanau ni hte hka mat wa ai wa a majoi pungding hta anga nga na sai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ben-yamin gaw kashun kashe sha ai chyahkyawn rai nga ai: Rim la lu ai shan hpe jahpawt e sha nna, Lu la ai lanep shana e karan na ru ai, ngu nna madat tsun da mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ndai ni mahkra gaw Israela amyu shi lahkawng rai nga ma ai; ga ndai mung shanhte a kawa shanhte hpe tsun nna shaman ya ai rai malu ai: langai hte langai tinang lu la ang ai chyeju hte maren shanhte hpe shaman ya mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai hta kaga shi shanhte hpe, Nye a amyu hpawng nga ai de ngai wa na ni ai; dai rai nna Heti masha Ehprun a pa na ginlawng hku hta ngai wa ni hte rau ngai hpe lup makoi mi:
  </para>
  <para style="p">
    <verse number="30" style="v" />Hkanan mung Mamre tawtap na Makhpela pa hta nga ai dai ginlawng hku hpe, Abraham gaw shi madu nga na lup ra matu dai pa hte nawng, Heti masha Ehprun kaw na mari da nu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hta e Abraham hte madu jan Sara hpe makoi manu ai; Isak hte madu jan Rebeka hpe mung dai hta e makoi manu ai; dai hta e Lea hpe mung ngai makoi se ai:
  </para>
  <para style="p">
    <verse number="32" style="v" />dai gaw Heti masha ni kaw na mari la ai pa hte dai hta e nga ai ginlawng hku rai nga ai, ngu nna madat tsun jahtum da wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shing rai Yaku gaw shi a shadang sha ni hpe azin ayang tsun da ngut jang, shi a lagaw yup ku de dawm la nhtawm nsa hti nna shi a amyu hpawng nga ai de du wa mat ai.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yawsep shi kawa a myi man ntsa e gum nna, shi a ntsa e hkrap let shi hpe pup wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai hpang Yawsep gaw shi a kawa hpe manam pyaw ai tsi hte lajang na, shi a mayam tsi sara ni hpe hkang da wu ai rai nna, tsi sara ni mung manam pyaw ai tsi hte Israela hpe lajang mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Manam pyaw ai tsi hte lajang na lam hte maren, shanhte gaw nhtoi mali shi ya tawn da mu ai: Egutu masha ni mung Yaku a majaw nhtoi sanit shi ya tup hkrap ngu hkrap ngoi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hkrap ngu hkrap ngoi nhtoi lai lang Yawsep gaw Hpara-u a nta masha ni hpe shaga nna, Nanhte a man e ngai myi man pa nngai rai yang gaw, Hpara-u na hta ning ngu shana ya mi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai wa ngai hpe dagam shangun nna tsun da nngai gaw, Yu u, ngai si wa na ni ai; Hkanan mung e nye a matu ngai htu da ai lup ginlawng hku hta ngai hpe wa makoi e, ngu ni ai: dai majaw ngai wa hpe lung makoi da lu na ahkang jaw e, shing rai bai wa na nngai da, ngu ya mi, ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Hpara-u gaw, Lung wa u, nang hpe dagam shangun ndai hte maren, na nwa hpe wa makoi u, ngu wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai rai nna Yawsep gaw shi a kawa hpe wa makoi na lung wa ai: Hpara-u mayam ni mahkra hte shi a nta na agyi salang ni, Egutu mung na agyi salang ni mahkra hte mung:
  </para>
  <para style="p">
    <verse number="8" style="v" />Yawsep a nta masha ni yawng, si a kahpu kanau ni, shi kawa a nta masha ni mung, shi hte rau lung wa ma ai: shanhte a ma kaji ni, sagu bainam yamnga hpung ni hpe sha Goshen mung e tawn da mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leng mung gumra jawn ai masha mung shi hte rau lung wa ma ai rai nna, dai gaw ja ja kaba ai wunawng wuwa rai nga ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />Yawdan hka wora hkran na Atad a chyarang e du ma yang, shanhte gaw dai yang e sharung shayawt kaba hte sharung shayawt nga nna, shi kawa a matu nhtoi sanit ya tup hkrap ngu hkrap ngoi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai Atad a chyarang e hkrap ngu hkrap ngoi rai nga ma ai hpe dai mung na Hkanan masha ni mu ma yang, shanhte gaw, Dai hkrap ngu hkrap ngoi ai gaw Egutu masha ni hta ja ja kaba nga malu hka, nga ma ai: dai rai nna shara dai hpe Abela-mizra-im ngu nna shamying mu ai: dai gaw Yawdan hka wora hkran e rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai Yaku a shadang sha ni gaw shanhte hpe tsun da ai madat hte maren kawa hpe di mu ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />shi a shadang sha ni gaw shi hpe Hkanan mung de hpai lung wa nna, Abraham gaw shi a matu lup ra di na, Heti masha Ehpron kaw pa hte nawng mari la ai Mamre tawtap na Makhpela pa hta na ginlawng hku hta e shi hpe lup makoi mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kawa hpe makoi mayang di ngut jang, Yawsep hte shi a kahpu kanau ni mung, shanhte hte man lung sa lawm ai ni mahkra mung, Egutu mung de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya kawa si mat ai hpang Yawsep a kahpu kanau ni gaw, Yawsep anhte hpe n dawng n yawt nna, anhte shi hpe di gaw ai n hkru ai lam yawng, anhte hpe bai tai na mi ai nhten, nga nna myit ru ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna shanhte gaw Yawsep hpang de kasa shangun dat nna, Anhte na a nhpu nnau ni nang hpe n hkru ai hku galaw kau saga ai rai nna, dai nang hpe shut ai mara dat kau ya mi, ngu nna Yawsep kaw sa hpyi mu, nga nna na nwa garai n si yang, anhte hpe htet da ma ni ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />dai rai nna, na nwa a Karai Kasang a mayam ni hpe, yubak mara raw dat kau ya mi, ngu nna hpyi mu ai. Shing nga tsun ma ai majaw Yawsep hkrap nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kahpau kanau ni mung shang nna shi a man e dingnyawm dagup let, Yu u, anhte gaw na a mayam ni wa rai nga ga ai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi Yawsep gaw, Myit hkum ru myit; ngai gaw Karai Kasang a malai rai nga a ni?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanhte ngai hpe n hkru ai hku gaw maw myit dai; rai timung, dai ni nanhte mu lu nga ai hte maren, masha law law hpe asak jahkrung na matu, Karai Kasang dai hpe kaja ai hku maw dat nu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai majaw myit hkum ru myit; nanhte hte nanhte a ma kaji ni hpe ngai bau nga na made ai, nga nna shanhte hpe shalan shabran ga hte shangwi shapyaw wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai Yawsep gaw shi kawa a nta masha ni hte Egutu mung e nga nga ma ai: Yawsep gaw asak latsa e shi ning du hkra nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ehprim a kashu kasha prat masum du hkra Yawsep mu da wu ai: Manashe a kasha Mahkira a kasha ni hpe mung Yawsep a lahpyen hta pawn da lu wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Yawsep gaw shi a kahpu kanau ni hpe, Ngai si wa na ni ai; gaja wa teng teng Karai Kasang gaw nanhte hpe sa kawan katsan yu na ra ai rai nna, ndai mung na nanhte hpe, Abraham, Isak, Yaku hte hpe dagam nna jaw da ai mung de woi wa na marin dai, ngu nna tsun da wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai shi gaw, Gaja wa nanhte hpe Karai Kasang kawan katsan yu sa na ra ai shaloi, nye a nrut nra hpe ndai ga na nanhte la lung wa ya lu na rai myit dai, ngu nna Israela a kashu kasha ni hpe dagam shangun wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi Yawsep asak latsa e shi ning du nna si mat ai: shi a moi man hpe gaw manam pyaw ai tsi hte lajang nna, Egutu mung e dau hta tawn da mu ai.
  </para>
</usx>
