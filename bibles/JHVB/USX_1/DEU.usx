<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="DEU" style="id">Tara Jahprang</book>
  <para style="h">Tara Jahprang</para>
  <para style="toc1">Tara Jahprang</para>
  <para style="toc2">Tara Jahprang</para>
  <para style="mt">Tara Jahprang</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Da ndai gaw, Yawdan hka wora hkran, nam mali ga e, Paran, Tohpela, Laban, Hazerot hte Di-zahab a lapran, Suhpa hte tawtap na layang ga hta, Mawshe, Israela masha ni mahkra hpe tsun ai ga rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Horeb bum kaw nna Siera bum hku lung wa yang, Kadesha-barnea du hkra nhtoi shi langai ya sat rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hesbon e dung ai Amori hkawhkam Sihon hte, Edri makau e, Ashtarot e dung ai Bashan hkawhkam Oga hpe sat kau wu ai hpang e,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mawshe gaw, mali shi ning shaning, shata shi langai a nhtoi langai ya shani e, Yehowa shi hpe hkang da made hte maren, Israela kashu kasha ni hpe htawn tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yawdan hka wora hkran Moba mung hta e, ndai tara ga Mawshe tsun hpaw wu ai gaw:
  </para>
  <para style="p">
    <verse number="6" style="v" />“Anhte a Karai Kasang Yehowa Horeb bum e anhte hpe, ‘Nanhte ndai bum e nga ai gaw ram ma salit dai;
  </para>
  <para style="p">
    <verse number="7" style="v" />rawt mu, hkawm sa wa manu; Amori masha nga ai bum ga hte de a makau hkan na layang ga, bum ga, apa ga, Dingda ga, nammukdara hka kau ga ngu ai, Uhprat hka kaba du hkra dam ai Hkanan masha ni a mung hte Lebanon bum de, sa wa ma su.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yu mu, dai mungdan nanhte a man e ngai tawn ya se ai; nanhte a kaji kawa Abraham, Isak, Yaku hte hte, shanhte a hpang na matu mara ni hpe jaw na, nga nna Yehowa dagam da ai mung de shang nna madu la ma su,’ nga nna tsun ma ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai shaloi e ngai nanhte hpe tsun made ai gaw, ‘Ngai hkrai sha nanhte hpe n dang gun nngai:
  </para>
  <para style="p">
    <verse number="10" style="v" />nanhte a Karai Kasang Yehowa nanhte hpe shalaw jahtam manit dai rai nna, yu mu, dai ni nanhte sumsing lamu a shagan ni zawn law htam nga myit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte a nji nwa ni a Karai Kasang Yehowa gaw, ya na hta htam hkying mun nanhte hpe naw shalaw jahtam nna, shi a ga ndat nga nga ai hte mare, shaman ya nga myit ga law!
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte a ru tsang lam, bungli lit gun hpai lam, gasat ningjet lam re ai ni hpe ngai hkrai kaning rai gun na rit ta?
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanhte a amyu shagu hta myit hpaji hte zai byeng-ya rawng nna, sadang pru ai masha lata tawn mu; ngai shanhte hpe nanhte a ntsa na agyi dang ya made ga,’ ngu we ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanhte mung, ‘Nang tsun ai hte maren galaw mai nga ai,’ nga nna htan myit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai majaw nanhte a amyu shagu hta, myit hpaji rawng ai hte sadang pru ai masha hpe ngai lata la nna, nanhte a du agyi ngu na, masha hkying mi a agyi, latsa a agyi, manga shi a agyi, marai shi a agyi re ai ni hpe nanhte a ntsa e dang da ya masade ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai shaloi e nanhte a tara agyi ni hpe mung, ‘Nanhte gaw, nanhte a nhpu nnau ni a amu lam madat ya nna, amyu madung shada na lapran rai timung, tsasam amyu hte na lapran rai timung, dingman ai hku tara dara mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tara dara ai a lam hta masha a myi man tau yu lu na n rai; masha kaji a ga hpe masha kaba a ga zawn madat ya na rai myit dai; kadai wa hpe mung nanhte hkrit agam lu na n rai: kaning rai nme law, tara lam gaw Karai Kasang hte seng nga ai; nanhte n dang lu ai amu chyawm gaw ngai hpang de jashawn marit; ngai dai hpe madat ya na ring ngai,’ gai ngu nna hkang da we ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanhte hkan galaw na lam magup mung, dai shaloi e ngai nanhte hpe hkang da masade ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang Horeb bum na anhte htawt hkawm wa nhtawm, anhte a Karai Kasang Yehowa hkang dat mi ai hte maren, Amori masha ni nga ai bum hprang ai lam hku sa wa yang, nanhte mu da ai dai hkrithpa nam mali kaba ting hpe anhte ga lai kau da nna, Kadesha harnea de du ga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi ngai nanhte hpe, ‘Anhte a Karai Kasang Yehowa anhte hpe jaw ai Amori masha ni nga ai bum ga de nanhte du manit dai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yu u, na a Karai Kasang Yehowa gaw na a man e dai mungdan tawn ya nit dai: lung wa su, na nji nwa ni a Karai Kasang Yehowa nang hpe tsun dat ai hte maren, wa madu la nu; hkum hkrit et, myit mung hkum mang et,’ ngu made ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi nanhte a shawng e masha naw shangun yu ga; shanhte dai mung hpe lung yu nhtawm, anhte gara hku lung lu na hte, kaning re ai mare de du na gaw, anhte hpe wa tsun dan maru ga,’ nga nna ngai hpe tsun myit dai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hku ngai mung na ra nna, nanhte hta amyu mi na marai langai ngai di nna, marai shi lahkawng lata la we ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />shanhte mung bum ga hku kayin lung wa nna, Eshhkola kadit du hkra yu kau da mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai dai mung na namsi shanhte di hpai nna, anhte hpang de la wa let, Anhte a Karai Kasang Yehowa anhte hpe jaw ai mungdan gaw mung kaja rai nga ai,’ ngai nna, wa tsun mi ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai timung, nanhte gaw n lung hkraw myit dai hte, nanhte a Karai Kasang Yehowa hkang da ai ga hpe nhtan jashai nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />‘Yehowa gaw anhte hpe n dawng mi ai majaw, anhte hpe shabya kau lu hkra, Amori masha ni a lata hta ap kau na nga, Egutu mung na anhte hpe shaw wa mi hka.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anhte gade wa lung wa na i? anhte a hpunau ni mung, Dai mung na masha ni gaw, anhte hta grau kaba ma ai, shing-yan mung grau galu ma ai; mare ni mung kaba ai hte, bunghku ni gaw lamu dep malu ai; dai hta kaga, dai mung hta e Anakim amyu masha ni hpe anhte mu gaw ai, nga nna anhte hpe minla byaw shangun ma ni ai,’ nga nna nanhte gaw tinang a sum ni hta aput myit dai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi ngai gaw, ‘Myit hkum kahpra myit; shanhte hpe hkum hkrit myit;
  </para>
  <para style="p">
    <verse number="30" style="v" />Nanhte a shawng e hkawm sa wa ai, nanhte a Karai Kasang Yehowa gaw, nanhte a man e Egutu mung hta e mung,
  </para>
  <para style="p">
    <verse number="31" style="v" />nanhte hkawm sa wa ai nam mali lam dingdung hta mung, ndai shara du hkra, kawa gaw kasha hpe pawn lahku ai zawn, na a Karai Kasang Yehowa gaw nang hpe pawn lahku ai lam shagu hpe lu ai hte maren, nanhte hpang maga e naw gasat ya na ra ai,’ ngu nna nanhte hpe tsun made ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Rai timung, nanhte sum gap na dabang tam nna, nanhte sa wa na lam hpe madun ya na nga, shana e wan hta, shani e sumwi hta nanhte a shawng e hkawm sa wa ai nanhte a Karai Kasang Yehowa hpe
  </para>
  <para style="p">
    <verse number="33" style="v" />ndai amu a lam hta nanhte kamsham myit dai n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi Yehowa nanhte a ga nsen hpe na nna masin pawt let,
  </para>
  <para style="p">
    <verse number="35" style="v" />‘Nanhte a nji nwa ni hpe jaw na, ngu nna ngai dagam di ai mung dan kaja hpe, Yehpuna a kasha Hkaleb hta kaga, ndai n hkru ai amyu hta na marai langai mi muk gaja wa teng teng mu lu na n rai;
  </para>
  <para style="p">
    <verse number="36" style="v" />dai wa chyawm gaw mu lu na ru ai: shi gaw Yehowa hpe htep lahti hkan nang ai majaw, shi kabye lu sai ga hpe shi hte shi a kashu kasha ni hpe ngai jaw na mawe ai,’ nga nna dagam da wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nanhte a jaw e Yehowa gaw ngai hpe mung pawt nna, ‘Nang pyi dai mungdan hta shang lu na n rai:
  </para>
  <para style="p">
    <verse number="38" style="v" />na a man e tsap nga ai Nun a kasha Yawshu gaw shang lu na re ai; dai wa gaw Israela amyu masha ni hpe dai mungdan madu shangun lu na majaw, shi hpe shadaw shalan u.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai hta n-ga, hpyen ni rim la na matu sha rai nga ma ai, nga nna nanhte tsun ai ma chyangai ni hte dai shani e kaja n kaja pyi garai n chye ginhka ai, nanhte a ma ni gaw, dai mung hta e shang lu nna, dai mung ngai shanhte hpe ap ya na mawe ai rai nna, shanhte dai hpe madu lu na mara ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nanhte chyawm gaw, kayin wa mu, Nawng hkyeng hku hkan nna dai nam mali de hkawm wa mu,’ nga ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shaloi nanhte gaw, ‘Anhte Yehowa hpe shut kau sagaw ai; Yehowa anhte hpe hkang da ai hte maren, anhte lung gasat na ga ai,’ nga nna ngai hpe htan let, langai hte langai tinang a ri nhtu lang nna, bum de lung na nga katu wa myit dai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Yehowa chyawm gaw, Shanhte hpe ning ngu tsun u, ‘Ngai nanhte kaw n lawm nngai majaw, hkum lung mu, hkum gasat myit: gasat yang nanhte a hpyen ni nanhte hpe dang kau na myit dai;'
  </para>
  <para style="p">
    <verse number="43" style="v" />nga nna ngai e tsun ai hte maren, ngai nanhte hpe htawn tsun made ai rai timung, nanhte madat myit dai n rai: nanhte Yehowa a hkang da ai ga hpe tawt lai nna, gumrawng ai myit hte dai bum ga de lung wa myit dai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Dai bum ga e nga nga ai Amori masha ni gaw lagat jawm ai zawn nanhte hpe hkan ginbawm nna, Seira bum hte Horma shara du hkra hkan gasat kau dat myit dai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shaloi nanhte bai wa nna, Yehowa man e hkrap ngu hkrap ngoi rai myit dai; rai timung Yehowa gaw nanhte a nsen hpe n madat wu ai hte, nanhte a ga n na wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shing rai nanhte gaw Kadesha shara e nga nga nna, dai kaw e na na wa hkring kau mu ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa ngai hpe tsun da ai hte maren, anhte bai nhtang sa wa nna, Nawng hkyeng hprang ai lam hku hkan yang, dai nam mali de hkawm du ga ai; shing rai nhtoi na na wa, Seira bum hpe anhte kayin hkawm nga ga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Yehowa ngai hpe tsun nngai gaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Ndai bum hpe nanhte kayin hkawm ai gaw ram ma salit dai; dingdung maga de lung wa manu:
  </para>
  <para style="p">
    <verse number="4" style="v" />amyu mash ni hpe mung ning ngu hkang da mu: Seira bum e nga nga ai nanhte a nhpu nnau Esaw a kashu kasha ni a lamu ga jarit hku nanhte hkawm lai wa na rai nna, shanhte nanhte hpe hkrit na ma ai; dai re ai majaw nanhte nan grai sadi nga mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte hpe hkum shatsang mu; Seira bum gaw Esaw hpe ngai ap ya kau se ai re ai majaw, shanhte a lamu ga hta na, ngai nanhte hpe karan jaw na nngai n rai; lagaw kabye na shara pyi karen jaw na n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sha na matu lusha gaw gumhpraw hte nanhte mari lu na myit dai; lu na ntsin mung, gumhpraw hte mari lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, na a Karai Kasang Yehowa gaw lam shagu hta nang hpe shaman ya nit dai; ndai nam mali kaba hta e nang hkawm sa wa ai lam hpe shi dum ya nga ai; ndai mali shi ning tup na a Karai Kasang Yehowa gaw nang hte rau nga nga sai rai nna, nang hpa mung n ra hkra rai nit dai,’ ngu nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shing rai, Seria bum hta nga nga ai anhte a hpunau Esaw a kashu kasha ni a makau hku anhte lai wa nna, Elat hte Ezion-geba mare kaw nna sa wa ai layang lam hku hkan sa wa nhtawm, bai kayin nna Moba nam mali lam hku lung mat wa ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Yehowa gaw, Moba masha ni hpe hkum shatsang mu; shanhte hte majan hkum galaw myit: Ara mare hpe gaw Lawt a kashu kasha ni hpe ngai ap ya mase ai re ai majaw, shanhte a mung hta na ngai nanhte hpe madu shangun na made ai n rai,’ nga nna ngai hpe tsun ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />(Moi shawng de, Anakim masha ni zawn hkum shing-yan tsaw ai hte galu kaba nna law htam nga ai Emim amyu masha ni gaw dai mung hta e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />shanhte gaw Anakim masha ni zawn Rehpim ngu ai ni rai nga ma ai; Moba masha ni chyawm gaw shanhte hpe Emim ngu shamying mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Seira bum hta e Hori masha ni moi shawng de nga nga ma timung, Esaw a kashu kasha ni shanhte a hpang e sa nga ma ai: Yehowa gaw Israela mahsa ni hpe ap ya ai mung hta shanhte galaw ai hte maren, Esaw a masha ni Hori masha ni hpe gasat kamang kau nhtawm shanhte a shara hpe up sha kau ya mu ai.)
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya rawt nna Zered hkaraw hpe rap mu, nga nna tsun ai hte maren Zered hkaraw hpe anhte rap ga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa dagam kau wu ai hte maren, ndai hpyen dap hta lawm ai dai prat na hpyen masha nlang hte si grawm mat ma hkra, Kadesha-barnea de ningnan du ai shani kaw nna, Zered hkaraw tap ai nhtoi du yang, sumshi matsat ning na wa sai, rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai dai ni n si grawm mat dingsa, shanhte hpe ndai dap hta na shamyit kau lu hkra nga, Yehowa a lata gaw shanhte hpe htim shadang nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai, dai hpyen masha ni nlang hte shawa hpung hta na si grawm mat ma jang she,
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa ngai hpe tsun nngai gaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />‘Nang dai ni Moba lamu ga jarit na Ara ginwang hku ga lai wa na rai ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ammon masha ni nga ai de du wa jang shanhte hpe hkum shatsang myit, shanhte hte hkum gasat myit: Ammon a kashu kasha ni a lamu ga hta na ngai nang hpe madu shangun na n rai: dai gaw Lawt a matu ni hpe ngai jaw ka mase ai, nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />(Dai yang e mung Rehpim ngu ai masha ni a lamu ga re ai nga myit ma ai; Rehpim ngu ai ni moi prat e dai yang nga ma ai; Ammon masha ni chyawm gaw dai ni hpe Zamzumim masha nga nna shamying ma ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />dai ni gaw galu kaba nna, law htam ai hte Anakim masha ni zawn hkum shing-yan tsaw ai amyu rai ma ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />rai timung, Seria bum e nga ai Esaw a kashu kasha ni a man na Hori masha ni hpe Yehowa shamyit kau nna shanhte a shara e dai ni du hkra Esaw a kashu kasha ni nga lu ai zawn, Ammon masha ni hpe shamyit kau wu ai rai nna, shanhte a shara e Ammon masha ni nga ma ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />dai hte maren, Hkaphtora mung na pru ai Hkaphtori masha ni mung Gaza mare du hkra nga ai kahtawng ni hta na Awim masha ni hpe wa shamyit kau nna, shanhte a shara hta galai nga ma ai.)
  </para>
  <para style="p">
    <verse number="24" style="v" />Ya rawt nna hkawm sa wa mu; Arnon hkaraw rap manu: yu u, Amori masha Heshesbon hkawhkam Sihon hte shi a lamu ga na a lata hta ngai ap ya sade ai; ga dai madu la magang na shi hpe sa gasat u.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sumsing lamu a npu e nga ai masha amyu nlang hte hpe, dai ni kaw nna nang hpe hkrit gari ai hte ma shajang shangun na mawe ai; shanhte gaw na a shi na jang, na a majaw shanhte gari kanan nna myit htum shajang na ma ai,’ nga nna tsun dat nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi ngai gaw Kedmot mali kaw nna Hesbon hkawhkam Sehon hpang de kasa shangun dat nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />‘Na a mung ka-ang hku ngai ga lai wa n ga; nmaw lam hku sha ngai hkan na nngai; pai de hkra de ngai n yit na nngai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anhte a Karai Kasang Yehowa anhte hpe jaw ai mungdan de Yawdan hka rap nna, du wa lu ai du hkra, ngai sha na shat, ngai lu na ntsin gaw,
  </para>
  <para style="p">
    <verse number="29" style="v" />Seira bum e nga ai Esaw a kashu kasha ni hte, Ara e ngai ai Moba masha ni ngai hta galaw ai zawn, nang mung gumhpraw hte dut jaw e, lagaw hte sha ngai kabye lai lu n ga,’ ngu nna ga ngwi ga pyaw hte tsun we timung,
  </para>
  <para style="p">
    <verse number="30" style="v" />Hesbon hkawhkam Sihon gaw anhte lai wa na ahkang n jaw mi ai: kaning rai nme law, dai ni mu nga ai hte maren, nanhte a Karai Kasang Yehowa gaw, dai hkawhkam wa hpe nanhte a lata hta ap kau na matu, shi a wenyi hpe shaja ya nna, shi a myit hta nhtan jashai ya nu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Yehowa gaw, ‘Yu u, Sihon hkawhkam hte shi a lamu ga ngai nang hpe jaw magang de ga; dai hpe sali ga matu, madu la magang u,’ nga nna ngai hpe tsun nngai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaloi Sihon gaw shi a masha ni nlang hte hte, Yahat shara e anhte hpe hkap gasat na nga pru sa wa ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Anhte a Karai Kasang Yehowa mung, shi hpe anhte a lata hta ap mi ai rai nna, shi hkum hte shi a kasha ni hpe mung, shi a masha ni nlang hte hpe mung, anhte sat kau lu ga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai shaloi e shi a mare nga manga anhte kashun la nna, mare ninghkrin nlang hte hta na, numsha, lasha, ma kaji yawng hpe atsai awai hpya kau gaw ai; langai mi muk ngam da ga ai n rai:
  </para>
  <para style="p">
    <verse number="35" style="v" />Yamnga ni hte kashun la lu ai mare kata na lanep rai ni hpe sha anhte magawn la kau ga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shing rai, Arnon hkaraw makau na Aroera hte dai hkaraw kata na mare kaw nna, Gilead ga du hkra anhte n dang lu ai mare langai mi muk n nga ai; anhte a Karai Kasang Yehowa gaw yawng mayawng anhte hpe ap kau ma ni ai:
  </para>
  <para style="p">
    <verse number="37" style="v" />rai timung, Amon masha ni a lamu ga, Yabok hka ginwang ting hte bum ga na mare ni yawng ngu ai, anhte a Karai Kasang Yehowa hkum da mada hte chyawm gaw, nang n hkra ndai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai anhte kayin nna Bashan mung lam hku lung wa ga ai: Bashan hkawhkam Oga mung shi a masha ni nlang hte hte Edri shara e anhte hpe hkap gasat na nga pru sa wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa chyawm gaw, ‘Shi hpe hkum hkrit et; shi hpe mung, shi a masha ni hte hpawn, shi a lamu ga mung na a lata hta ngai ap ya sade ai: Hesbon e dung ai Amori hkawhkam Sihon hpe di ai zawn, dai wa hpe mung di na rai ndai,’ nga nna ngai hpe tsun ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing nga anhte a Karai Kasang Yehowa gaw Bashan hkawhkam Oga hte shi a masha ni nlang hte mung, anhte a lata hta ap mi ai rai nna, shi a matu ngu na langai mi muk n ngam hkra sat kau gaw ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai shaloi e anhte gaw shi a mare ni nlang kashun la kau ga ai; shanhte kaw na n dang la lu ai mare langai mi muk ngam sai n rai: dai hte gaw Bashan mung hta Oga a mungdan ngu na mare kru shi rawng ai Argoba ginwang ting rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai mare ni yawng gaw bunghku tsaw ai hte chyinghka hkik nna htinggrang brep brep rai kum ai hkrai rai nga ai; dai hta kaga bunghku n kum ai kahtawng law law mung naw lawm nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hesbon hkawhkam Sihon hpe di ai zawn, dai mare ni hpe mung, anhte di gaw ai: mare ninghkrin nlang hte hta na, numsha, lasha, ma kaji yawng hpe atsai awai hpya kau gaw ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yamnga ni yawng hte mare ni hta na lanep rai ni hpe sha, anhte magawn la kau ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai shaloi e Arnon hkaraw kaw nna Hermon bum du hkra re ai, Yawdan hta wora hkran na Amori hkawhkam lahkawng a mungdan hpe anhte madu la ga ai:
  </para>
  <para style="p">
    <verse number="9" style="v" />(dai Hermon bum hpe Sidon masha ni gaw Sirion, Amori masha ni chyawm gaw Senira, nga nna shamying ma ai:)
  </para>
  <para style="p">
    <verse number="10" style="v" />shing rai, layang ga na mare ni nlang hte hte, Gilead mung ting, Bashan mung ting, Bashan mung hta Oga a mungdan hte seng ai Saleka hte Edri mare hkan du hkra, anhte madu la ga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />(Kaning rai nme law, Rehpim ngu ai amyu hta na hkrat ai, Bashan hkawhkam Oga chyu sha ngam nga sai; yu u, shi a yup ku gaw hpri yup ku rai nga ai: dai gaw Amon kashu kasha ni a mung na Raba mare hta nga nga lu ai n rai ni? masha a dawng hku sawn yang, dai gaw galu de dawng jahku, nda de dawng mali rai nga ai.)
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai sa, lamu ga dai hte gaw dai shaloi e anhte madu la lu sagaw ai: dai hpe Arnon hkaraw makau na Aroera mare kaw nna, Gilead bum ga ka-ang hprut hte dai hta lawm ai mare ni gaw, Rubin matu ni hte Gad matu ni hpe ngai jaw mase ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />Naw ngam ai Gilead mungdaw mi hte Oga a mungdan ngu ai Bashan ga ting gaw Manashe amyu chyen ni hpe ngai jaw mase ai: dai gaw Bashan mung hta na Argoba ginwang hte rai nga ai. (Dai mung Rehpim masha ni a lamu ga re ai, nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manashe a kasha Ya-ira gaw Argoba ginwang ting hpe, Geshuri hte Mahkahti masha ni a lamu ga jarit du hkra madu la nhtawm, shi a mying hkan nna, dai ni du hkra dai Bashan mung a mare ni hpe Hawot-Ya-ira ngu nna shamying da wu ai.)
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Gilead mung gaw Mahkira hpe ngai jaw se ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gilead mung kaw nna, Arnon hkaraw du hkra, dai hkaraw nna ran, Amon masha ni a lamu ga jarit rai nga ai. Yabok hka htep re ai aga ting:
  </para>
  <para style="p">
    <verse number="17" style="v" />Genesaret nawng kaw nna, layang ga ting ngu na Yawdan hka kau dingyang hte layang ga na Jum Nawng, sinpraw hkran Pisga bum manep du hkra, Rubin matu ni hte Gad matu ni hpe ngai jaw mase ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai aten e ngai gaw, Nanhte a Karai Kasang Yehowa nanhte hpe dai lamu ga jaw madu manit dai; rai timung, majan gun chye ai ni nlang hte gaw hpyen ri nhtu lang nna, nanhte a hpunau Israela kashu kasha ni a man e rap sa wa na rai myit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa nanhte hpe ban sa ai jaw manit dai hte maren, nanhte a hpunau ni hpe mung ban sa shangun ai du hkra, nanhte a Karai Kasang Yehowa jaw ai Yawdan hka wora hkran ga shanhte madu la lu na matu,
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanhte a madu jan kasha ni hte nanhte a yamnga ni gaw, ngai jaw da sai mare ni hta nga nga lu na rai ma ai: nanhte hta yamnga law nga malit dai gaw ngai chye nga nngai: amu ngut ma jang she nanhte yawng gaw ngai jaw da sai hte maren, langai hte langai tinang madu ai Sali ga de bai wa lu na rai myit dai,’ ngu nna nanhte hpe ngai hkang da made ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi e Yawshu hpe mung, ‘Nanhte a Karai Kasang Yehowa ndai hkawhkam yan hta galaw ai lam yawng mayawng hpe nang hkum nan mu manit dai: ndai hte maren nang du hkawm sa wa ai mungdan shagu hta Yehowa galaw ya na ra ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai ni hpe hkum hkrit myit: kaning rai nme law, nanhte a Karai Kasang Yehowa gaw nanhte hpang maga majan gasat nga ai,’ ngu nna hkang da we ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai aten e Yehowa hpe mung ngai hpyi nem we ai gaw,
  </para>
  <para style="p">
    <verse number="24" style="v" />‘Yehowa Madu e, Nang gaw na a mayam hpe na a galu kaba ai hte, na a n-gun ja ai lata madun hpang nit dai: nang zawn daru magam bungli hte hpung shingkang amu shapraw lu ai Karai Kasang gaw, sumsing lamu hte ginding aga ntsa e kadai wa nga a ta?
  </para>
  <para style="p">
    <verse number="25" style="v" />Yawdan hka wora hkran de nga ai kaja ai bum ga hte Lebanon bum hpe mu lu n ga, ngai hpe rap wa lu na ahkang jaw e,’ ngu nna hpyi we ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yehowa chyawm gaw nanhte a majw ngai hpe pawt nga ai rai nna, nye a ga madat ya sai n rai: shing rai Yehowa gaw, ‘Dai hte ram nu ga; htawm hpang de dai hte seng ai lam ngai e hkum hpyi nit;
  </para>
  <para style="p">
    <verse number="27" style="v" />Rai timung, Pisga bum pungding de lung nhtawm, sinpraw sinna, dingdung dingda mada nna, ‘dai mungdan hpe yu la u; Yawdan hka chyawm gaw nang rap lu na n rai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yawshu hpe mahtang hkang da nna, shi hpe shaja da u, shadaw shangang tawn u: shi gaw ndai amyu a man e hkawm sa nna, nang mu da na rin dai mungdan hta Sali wunli woi dagraw lu na ra ai,’ nga nna ngai hpe hkang da nngai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shing rai anhte gaw Bet-Peora hte tawtap na kadit e but nga ga ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Israela amyu e, nanhte asak hkrung nga lu nna, nanhte a nji nwa ni a Karai Kasang Yehowa nanhte hpe jaw da ai mungdan hta shang madu sha lu hkra, nanhte hkan shatsup nga na matu ngai sharin achyin da ai matsun maroi ga hte hkang da ai tara ga hpe madat mara la mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai ngai nanhte hpe hkang da ai hte hta ga ningnan jat lu na n rai, ndai hta na langai mi muk lai kau lu na n rai: ngai nanhte hpe hkang da sai nanhte a Karai Kasang Yehowa a tara matsun ni hpe nanhte hkan shatsup nga lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bala-Peora majaw Yehowa di kau ai lam hpe nanhte hkum nan mu ma manit dai: Bala-Peora lam hkan nang ai ni nlang hpe nanhte a Karai Kasang Yehowa hta manoi nga ai nanhte ni chyawm gaw dai ni du hkra hkrung nga lu manit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanhte a Karai Kasang Yehowa hta manoi nga ai nanhte ni chyawm gaw dai du hkra hkrung nga lu manit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yu u, nanhte wa nna shang sha lu ai mungdan hta hkan nang nga na matsun maroi ga hte hkang ai tara gaw, nye a Karai Kasang Yehowa tsun da ai hte maren ngai nanhte hpe sharin achyin da ma masade ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna dai ga hpe hkan shatsup nga mu; dai rai jang, ndai matsun maroi ga nlang hte hpe na yu nna, ‘Gaja wa ndai galu kaba ai amyu gaw, hpaji byeng-ya hte kunghpan ai amyu rai nga ai,’ nga nna nanhte a lam kajai tsun na maigan amyu ni a man e, dai gaw nanhte a hpaji byeng-ya hte kunghpan ai lam tai na rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, anhte hpyi gang ai lam shagu hta anhte a Karai Kasang Yehowa anhte hte ni nga ai zawn, amyu kaba gale ni hta dai zawn ni ai Hpara kadai lu a ta?
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hta kaga, dai ni ngai nanhte hpe tawn da ya ai tara made dinghpring ai matsun maroi ga hte hkang ai tara ga gaw, amyu kaga gale ni hta kadai wa lu a ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna, nang hkum nan myi chyi mu lu sai lam ni hpe nang n malap kau ai sha, prat dingsa matsing gun nga lu n ga, tinang hkum nan sadi nna, tinang myit masin hta a maja nga u; dai lam ni hpe na a nshu nsha ni e mung sharin achyin ya nga u:
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai gaw, Horeb bum hta na a Karai Kasang Yehowa a man e nang tsap nga yang, ‘Amyu masha ni hpe ngai kaw jahpawng tawn ru; dinghta ga ntsa e shanhte hkrung nga prat dingsa ngai e hkrit hkungga ai hte kashu kasha ni hpe sharin achyin ya nga lu hkra, nye a mungga ngai shanhte hpe na la shangun na mawe ai,’ nga nna Yehowa ngai hpe tsun ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte mung sit sa wa nna, dai bum lagaw e tsap nga myit dai; dai bum mung lamu du hkra wan grung nna, nsin sin ai, sumwi mawng ai hte achyang amang rai sin mak nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Yehowa gaw dai wan kata kaw nna nanhte hpe shaga myit dai: ga nsen nanhte na lu myit dai, rai timung hkumhkrang n mu ya myit dai: nsen sha nanhte na myit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanhte hkan nga lu na matu, hkang da ai ga shaka ngu na tara ga kanu shi mung, shi nan nanhte hpe tsun dan nna, lungpa lahkawng hta ka da nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanhte wa nna madu sha nga na mungdan hta hkan nang lu na matu, ngai nanhte hpe sharin achyin ya na matsun maroi ga hte hkang ai tara ga ni hpe, dai shaloi e Yehowa ngai hta hkang da ni ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Horeb bum e wan kata nna, Yehowa nanhte hpe shaga myit dai shaloi, hpa zawn san ai hkrang mung nanhte n mu myit dai hte maren,
  </para>
  <para style="p">
    <verse number="16" style="v" />Htawm hpang de nanhte htak byak wa nna, ala nsan ai, anum nsan ai shinggyim masha hkrang hte bung ai tawk ai sumla;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ga ntsa e nga ai yamnga baw a hkrang; ntsa malen e pyen ai u a hkrang;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ga hta gumrawt hkawm ai dusat amyu a hkrang; ga a manep hka hta nga ai anga baw a hkrang hte bung ai tawk ai sumla, tinang a matu n galaw hkrup myit ga gaw:
  </para>
  <para style="p">
    <verse number="19" style="v" />sumsing lamu de mada yu nna mung, na a Karai Kasang Yehowa gaw sumsing lamu a npu na shinggyim masha ni a matu san da ai ja, shata, shagan ni ngu ai sumsing lamu a zaw nawng zaw wa ni hpe mu lu myit dai shaloi, dai hpe nawku ga nga yang, nanhte n naw n ku na hte n hkan nang shut lu hkra, tinang dai tinang sadi nga mu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanhte hta, dai ni rai nga ai hte maren, Yehowa a matu Sali wunli amyu tai myit ga nga, Egutu mung a hpri wan mang na shi nanhte hpe gare la manit dai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hta kaga nanhte a majaw Yehowa ngai hpe masin pawt nna, Yawdan hka wora hkran de ngai n rap sa lu n hte, nanhte a Karai Kasang Yehowa nanhte hpe Sali wunli matu jaw ai dai reng ai mungdan n shang sha lu na lam, dagam kau nu ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai rai nna, ndai ga e ngai si na ni ai; Yawdan hka ngai rap lu sa na n rai; nanhte chyawm gaw rap sa wa nna dai mai kaja ai mungdan shang sha lu na manit dai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai re ai majw, nanhte Karai Kasang Yehowa nanhte hte tawn da ai ga shaka hpe malap kau nna, nanhte a Karai Kasang Yehowa hkum da ai arai ni a hkrang hte bung ai tawk ai sumla n galaw hkrup myit ga, tinang dai tinang sadi nga mu.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kaning rai nme law, nanhte a Karai Kasang Yehowa gaw grung nga ai wan, nsu nnawn loi ai Karai Kasang rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nanhte kashu kasha shaprat nna, dai mungdan hta nga na wa jang, bai htak byak nna lama ma a hkrang hte bung ai sumla tawk tawn nna, nanhte a Karai Kasang Yehowa a masin shapawt ya na hku shi a man e n shawp ai amu galaw myit yang gaw:
  </para>
  <para style="p">
    <verse number="26" style="v" />Sumsing lamu hte ginding aga e gang nna dai ni ngai nanhte hpe madat tsun da made ga, Yawdan hka rap nna nanhte shang sha ai mungdan hta gade n na yang teng teng htum mat na myit dai; dai mung hta na na wa hkrung nga lu na myit dai n rai: atsai awai htum mat kaw du na marin dai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa nanhte hpe tsasam amyu ni hta shabra kau dat nna, nanhte hpe woi mat wa ai amyu ni a hpawng kata e, nanhte gaw kachyi sha rai mat hkra kaji mat na myit dai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai hkan e myi n mu, na n na, n lu n sha chye ai hte manam n chye ai, masha lata hte tawk la ai hpun hpara nlung hpara re ai ni hpe nanhte nawku lu na marin dai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rai timung, dai hkan e nanhte a Karai Kasang Yehowa hpe bai tam myit dai shaloi, myit masin, kraw lawang ting hte shi hpe tam myit yang chyawm gaw, mu lu na marin dai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Htawm hpang prat e ndai lam yawng mayawng hte katut nna ruyak kyin dut ai hkrum sha ai shaloi, na a Karai Kasang Yehowa hpang de bai wa nna, shi a nsen madat lu na marin dai:
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaning rai nme law, na a Karai Kasang Yehowa gaw matsan dum chye ai Karai Kasang rai nga ai: nang hpe shi kabai kau rap di na wu ai n rai; atsai awai nan di kau na n rai; na nji nwa ni hta dagam da ai ga shaka hpe malap na wu ai n rai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ginding aga ntsa e Karai Kasang shinggyim masha hpan da ai nhtoi kaw nna, nanhte garai n pra yang na lai mat wa sai prat hte ting hta, lamu htum maga mi kaw nna maga mi de du hkra gawn yu mu; ndai daram kaba ai amu byin yu sa ni? ndai zawn re ai shiga na yu myit ni?
  </para>
  <para style="p">
    <verse number="33" style="v" />Karai Kasang wan kata na tsun dat ai nsen hpe na lu ninglen nang hkrung nga lu ai zawn, amyu gale ni hta nga nga a ni?
  </para>
  <para style="p">
    <verse number="34" style="v" />Nanhte a Karai Kasang Yehowa Egutu mung hta nanhte a man e galaw dan ai zawn chyam dinglik ai, lamik kumla hte mauhpa amu madun ai, hpyen majan shapraw ai, n-gun ja ai lata hte ladawn ai lahpum sharawt ai, hkrithpa shingran madun ai di nna, Hpara shaje langai wa mi masha amyu mi hta na masha amyu mi hpe tinang a matu nga nna shaw la yu ai, nga a ni?
  </para>
  <para style="p">
    <verse number="35" style="v" />Yehowa chyu sha Karai Kasang rai nga ai hte shi hta kaga Karai Kasang shaje n nga ai gaw nanhte chye lu myit ga she, nanhte hpe dai hte madun ai rai nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nang hpe sharin achyin na nga, sumsing lamu de nna shi a ga nsen nan na lu shangun nit dai; ga ntsa e shi a grung ai wan kaba mu lu shangun wu ai rai nna, nang mung dai wan kata na shi a ga na lu lit dai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na nji nwa ni hpe shi tsawra wu ai majaw shanhte a amyu matu ni hpe lata la nu ai;
  </para>
  <para style="p">
    <verse number="38" style="v" />nang hta grau kaba nna grau law ai amyu ni hpe na a man na shi shaden kau ya nna, dai ni rai nga ai hte maren shanhte a lamu ga hta nang hpe woi shawn nna, Sali wunli madu shangun na nga, shi a nsam kaba hte Egutu mung kaw nna shi a man de shaw wa nit dai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai rai nna, Yehowa gaw sumsing lamu lahta tang hte ginding dinghta ga ntsa e Karai Kasang rai nga ai mung, Karai shaje mi n nga sai mung, dai ni dum hprang nna kraw lawang kata e matsing gun nga mu law.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang hte na a nshu ni ngamu ngamai lu hkra mung, na a Karai Kasang Yehowa prat tup matu nang hpe jaw tawn ai mungdan hta nang asak galu n ga mung, dai ni tsun da ai matsun maroi ga hte hkang ai tara ga hpe hkan shatsup nga lu na rai myit dai,” nga nna Mawshe hkaw tsun da ai rai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Dai tsun ngut jang Mawshe gaw, htingbu manang wa n dawng ai myit n rawng ai she, n dum shami sat kau hkrup ai wa hprawng shingbyi lu na mare masum,
  </para>
  <para style="p">
    <verse number="42" style="v" />Yawdan hka sinpraw, jan pru maga hkran e lata san da wu ai:
  </para>
  <para style="p">
    <verse number="43" style="v" />dai mare ni gaw, Rubin amyu a matu nam mali pa hta nga ai Bezera; Gad amyu a matu Gilead mung na Ramot; Manashe amyu ni a matu Bashan mung na Golan rai nga ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Da ndai gaw Israela kashu kasha ni hpe Mawshe tawn da ya ai Tara rai nga ai:
  </para>
  <para style="p">
    <verse number="45" style="v" />Egutu mung na shanhte pru wa ma yang, Hesbon e dung ai Amori hkawhkam Sihon a lamu ga, Yawdan hka sinpraw hkran, Bet-peora hte tawtap na kadit e, Mawshe, Israela kashu kasha ni hpe tsun da ai sakse ga, matsun maroi ga hte hkang da ai tara ga rai nga ai:
  </para>
  <para style="p">
    <verse number="46" style="v" />Egutu mung na pru wa ma yang Mawshe hte Israela kashu kasha ni gaw dai hkawhkam hpe sat kau nna,
  </para>
  <para style="p">
    <verse number="47" style="v" />shi a lamu ga mung, Bashan hkawhkam Oga a lamu ga hpe mung madu la kau ma ai:
  </para>
  <para style="p">
    <verse number="48" style="v" />shan gaw, Arnon hkaraw makau na Aroera mare kaw nna, Hermon ngu ai Sion bum htep, Yawdan hka sinpraw hkran na pa hte hpawn,
  </para>
  <para style="p">
    <verse number="49" style="v" />dai pa a matu nawng makau na Pisga a bum manep du hkra up ai Yawdan hka wora hkran sinpraw maga de na Amori hkawhkam lahkawng yan rai ma ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Mawshe gaw Israela kashu kasha ni nlang hte hpe shaga nna, “Israela amyu e, dai ni ngai nanhte hpe shana da ai matsun maroi ga hte hkang da ai tara ga hpe sharin la nna hkan nang lu hkra sadi nga na matu, madat mara la maru.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anhte a Karai Kasang Yehowa gaw, Horeb bum e anhte hte ga shaka da mi ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa gaw dai ga shaka, anhte a ji wa ni hte tawn da wu ai n rai; dai ni asak hkrung let ndai yang e nga ai anhte nlang hte nan tawn da ma ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw dai bum e wan hta nna nanhte hte myi man tut rai tsun manit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai shaloi e, nanhte wan dai hpe hkrit nna, bum de n lung gwi myit dai majaw, ngai gaw Yehowa a ga nanhte hpe htawn tsun ya na matu Yehowa hte nanhte a lapran e tsap nga nngai; tsun dat ai gaw:
  </para>
  <para style="p">
    <verse number="6" style="v" />‘Ngai gaw, Egutu mung hte mayam tai nga ai nta na nang hpe shapraw la ai, na a Karai Kasang Yehowa rai nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hta kaga Karai Kasang shaje hpe hkum naw hkum du et.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lamu a lahta tang, lamu a npu ga ntsa tsang, ga a npu hka hpungtang hta rawng ai baw a hkrang hte bung ai sumla, nang na a matu hkum galaw hkum shachyaw et;
  </para>
  <para style="p">
    <verse number="9" style="v" />dai hpe hkum naw hkum ku, hkum jaw hkum jau et: kaning rai nme law, ngai na a Karai Kasang Yehowa gaw, nsu nnawn loi ai Karai Kasang rai nga nngai rai nna, ngai hpe n dawng n yawt ai ni a amyu lakung hpe gaw kawa ni a yubak kasha ni hta prat masum prat mali du hkra jaw nga nngai;
  </para>
  <para style="p">
    <verse number="10" style="v" />ngai hpe tsawra nna ngai hkang da ai matsun hkan nang ai ni hpe gaw, lamun latsa prat du hkra matsan dum ai hku a galaw nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a Karai Kasang Yehowa a mying ningsang hpe kaman lila hkum gang hkum tsun et; kaning rai nme law, shi a mying ningsang kaman lila gang ai wa hpe, Yehowa mara n shagun ai, nga na wu ai n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a Karai Kasang Yehowa nang hpe hkang da sai hte maren, laban nhtoi hpe shachyoi shapra na, dai hpe matsing nga u:
  </para>
  <para style="p">
    <verse number="13" style="v" />kru ya nhtoi tup nang amu bungli galaw nna na a makan lam shachyen nga na rai ndai;
  </para>
  <para style="p">
    <verse number="14" style="v" />sanit ya nhtoi gaw na a Karai Kasang Yehowa a matu laban nhtoi rai nga ai; dai shani e nang hte na a shayi shadang sha ni mung, na a mayam num mayam la mung, na a dumsu, lawze re ai na a yamnga ni mung, na a chyinghka kata e rawng ai tsasam manam mung amu bungli galaw lu na n rai; nang ban sa nga ai hte maren, na a mayam num mayam la ni mung ban sa lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang Egutu mung e mayam tai nga rawng nit dai mung, na a Karai Kasang Yehowa n-gun ja ai lata, shada ngai ai lahpum hte dai kaw na nang hpe shapraw la nit dai mung, nang dum nga lu na rai ndai; de a majaw, laban nhtoi matsing nga lu na, na a Karai Kasang Yehowa nang hpe hkang da nit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mungdan hta, na a asak galu nna ngamu ngamai lit ga, na a Karai Kasang Yehowa nang hpe hkang da sai hte maren, na nnu yan nwa hpe hkungga lara di u.
  </para>
  <para style="p">
    <verse number="17" style="v" />Masha hkum sat et.
  </para>
  <para style="p">
    <verse number="18" style="v" />Masha num mung hkum shaw et.
  </para>
  <para style="p">
    <verse number="19" style="v" />Masha arai mung hkum lagu et.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na a htingbu manang wa a lam mung, n teng n man ai sakse hkum hkam et.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a htingbu manang wa a madu jan hpe mung, ra marit ai myit hkum rawng et; na a htingbu manang wa a ndum nta, yi hkauna, mayam num mayam la, dumsu lawze re ai, na htingbu manang wa lu ai arai hpa hpe mung ra marit ai myit hkum rawng et,” nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Ga dai ni gaw dai bum e awan, sumwi hta htat ai nsin kata nna, Yehowa shi nan nsen kaba hte nanhte hpawng nga shawa ting hpe tsun dat nu ai: dai hte hta tsun jat sai n rai: ga dai ni hpe mung lungpa lahkawng hta shi ka nna ngai e ap ya ni ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nsin kata na nsen nanhte na lu ai hte, dai bum wan grung nga ai shaloi nanhte hta na amyu ladung agyi ni hte salang ni nlang hte gaw ngai kaw sit sa nna,
  </para>
  <para style="p">
    <verse number="24" style="v" />‘Yu u, anhte a Karai Kasang Yehowa shi a hpung shingkang hte daru magam anhte hpe madun dan ma ni ai; wan grung ai kata na shi a ga nsen mung, anhte na lu saga ai: Karai Kasang Yehowa shi nan masha hte shaga nga ninglen, masha naw hkrung nga lu ai gaw, dai ni anhte mu chye saga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya, anhte hpa rai si wa na rai ta? Ndai grung la ai wan hte anhte si ma na ra ga ai: anhte a Karai Kasang Yehowa shaga ai nsen anhte naw a na nga yang gaw si lu na ga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaning rai nme law, ahkrung nga ai Karai Wa shi nan wan hta nna shaga ai nsen hpe anhte na lu ai zawn, shinggyim masha hta kadai wa na ninglen hkrung lu a ta?
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang madu mahtang sit sa nna, anhte a Karai Kasang Yehowa tsun matsun madat la su: anhte a Karai Kasang Yehowa nang hpe tsun matsun anhte hpe htawn tsun mi; anhte madat la nna hkan galaw na ga ai,’ nga nna hpyi myit dai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing nga nanhte ngai e hpyi ai lam Yehowa na wu ai rai nna, Yehowa mung, ‘Dai amyu masha ni nang hpe hpyi ai ga ngai na se ai; shanhte a ga nlang mung htuk nga malu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shanhte hte shanhte a kashu kasha prat dingsa ngamu ngamai lu hkra, ngai e hkrit hkungga nna ngai hkang da mada hkan sa mayu ai myit tutnawng rawng nga mu ga.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte hpe, Nanhte a sum de wa manu, ngu nna wa tsun dat u.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nang chyawm gaw ndai yang nye a makau e tsap nga ru; ngai shanhte hpe jaw tawn ai mung hta shanhte hkan nga na matu, nang shanhte hpe sharin achyin ya na hkang da mada, matsun maroi hte dawdan ai tara mahkra ngai nang hpe tsun hti de ga,’ nga nna ngai hpe tsun nngai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai rai nna, nanhte a Karai Kasang Yehowa nanhte hpe hkang da sai hte maren, nanhte hkan nang lu na rai myit dai: pai de hkra de yit lu na myit dai n rai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nanhte madu sha na marin dai mungdan hta nanhte hkrung nga lu nna, ngamu ngamai na hte asak galu malit ga gaw, nanhte a Karai Kasang Yehowa nanhte hpe hkang da ai lam magup hta nanhte hkan sa lu na rai myit dai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nang hkum nan hte na a kashu kasha ni, na a Karai Kasang Yehowa hpe hkrit hkungga let, ngai nang hpe hkang da ya sai matsun maroi hte hkang da ai tara nlang hte hpe prat dingsa hkan nang lu na hte na a prat galu nga lit ga nga;
  </para>
  <para style="p">
    <verse number="2" style="v" />nanhte sa nna madu sha na marin dai mung hta hkan lang nga na matu, nanhte hpe sharin achyin ya na nanhte a Karai Kasang Yehowa a hkang da ai ga, matsun maroi hte dawdan ai tara gaw, ndai rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Israela amyu e, na nji nwa ni a Karai Kasang Yehowa a ga ndat nga nga sai hte maren, nga chyu hte lagat jahku lwi ai mung hta nanhte ngamu ngamai nna law htam wa myit ga,’ madat mara la nna hkan nang nga u.
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Israela amyu e, madat la u: anhte a Karai Kasang Yehowa gaw, shi chyu sha Yehowa rai nga ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />dai, na a Karai Kasang Yehowa hpe, na a myit masin mahkra hte, na a kraw lawang mahkra hte, na a n-gun lagawng mahkra hte tsawra nga u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai ni ngai nang hpe hkang da ai ga ndai hpe na a kraw lawang e gun nga u:
  </para>
  <para style="p">
    <verse number="7" style="v" />ga ndai, na nsha ni hpe nang sharin achyin ya nga lu na rai ndai; nta e dung nga let mung, lam e hkawm sa let mung, taw nga rawt wa let mung, ga dai a tsun nga lu na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ga dai hpe na a lata hta kumla tai nga na matu hkang da nga nna, na a myi lapran e masat dingsat laika tai nga na rai lit dai:
  </para>
  <para style="p">
    <verse number="9" style="v" />ga dai hpe na nta chyinghka hkadun hte na mare chyinghka hta mung ka da na rai ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a Karai Kasang Yehowa na nji nwa Abraham, Isak, Yaku hte hpe dagam da ai mungdan hta nang hpe woi shawn nna, nang n de tawn ai sutgan hkum ai mare kaba ni,
  </para>
  <para style="p">
    <verse number="11" style="v" />nang n tam bang ai kun rai hpring chyat nga ai nta ni, nang n tawk n htu ra ai hka htung ni, nang n hkai tawn ai tsabyi sun hte tsanlun hpun ni, nang hpe jaw nna, nang hkru hkru kat kat sha nga lu ai shaloi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Egutu mung hte mayam nta na nang hpe shaw woi wa ai Yehowa hpe nang n malap kau n ga, sadi nga u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a Karai Kasang Yehowa hpe nang hkrit hkungga nna, shi hpe hkrai daw jau lu na ndai; dagam ai hta mung shi a mying ningsang gang lu na rai ndai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanhte hta rawng nga ai nanhte a Karai Kasang Yehowa gaw, nsu nnawn loi ai Karai Kasang rai nga ai majaw, na a Karai Kasang Yehowa nang hpe pawt bu nna, ga ntsa na nang hpe n jahtum kau u ga gaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />nanhte a grup yin e nga ai masha amyu ni a Hpara ngu ai Hpara shaje ni kaw hkum hkan kasawt myit.
  </para>
  <para style="p">
    <verse number="16" style="v" />Masa shara na zawn, nanhte a Karai Kasang Yehowa hpe chyam dinglik lu na n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nanhte a Karai Kasang Yehowa nang hpe tawn da ya ai hkang da ai ga, sakse ga hte matsun maroi ga hpe nanhte teng teng hkan nang lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang ngamu ngamai nga lu na hte Yehowa a ga ndat nga ai hte maren masha hpyen ni nlang hpe na a man na shaden kau nna, na nji nwa ni hpe dagam da ai chyeju mungdan de shang sha lu n ga gaw,
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa a man e dinghpring htaphtuk ai amu nang galaw nga na rai ndai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Htawm hpang prat e na nsha gaw nang hpe, ‘Anhte a Karai Kasang Yehowa tawn da ya ai ndai sakse ga, matsun maroi hte dawdan ai tara gaw kaning re ai rai ta?'
  </para>
  <para style="p">
    <verse number="21" style="v" />nga nna san n yang, nang gaw na nsha hpe, Anhte Egutu mung e Hpara-u a mayam ni rai nga yang, Yehowa gaw n-gun ja ai lata hte Egutu mung na anhte hpe shaw woi wa mi ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa gaw nachying kaba ai kumla hte mauhpa amu Egutu mung ting a ntsa e mung, Hpara-u hte shi a nta masha ni a ntsa e mung anhte a man pra madun dan nna,
  </para>
  <para style="p">
    <verse number="23" style="v" />ji wa ni hpe dagam da ai mungdan hta wa shawn da lu hkra nga dai yang na shaw wa ni ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai dai ni rai nga ai hte maren anhte a asak hpe bau ya nga na matu, anhte a tutnawng na ngamai nhpang tai lu hkra, anhte a Karai Kasang Yehowa hpe hkrit hkungga nga mu ga nga, Yehowa gaw ndai matsun maroi ga nlang anhte hpe tawn da ya ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai rai nna, anhte a Karai Kasang Yehowa anhte hpe hkang da sai hte maren, ndai hkang da sai matsun maroi ga nlang shi a man e hkan shatsup ga yang gaw, anhte a dinghpring ai tai na rai nga ai,’ ngu nna tsun dan na rai ndai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na a Karai Kasang Yehowa nang madu sha na rin dai mung de nang hpe woi shawn nna, Hiti, Gergashi, Amori, Hkanani, Perizi, Hiwi hte Yebusi ngu ai nang hta grau kaba nna law htam ai amyu sanit ting hpe na a man na gawt kau na,
  </para>
  <para style="p">
    <verse number="2" style="v" />na lata de ap ya ndai shaloi, shanhte hpe atsai awai sat kau na rai myit dai: shanhte hte ga shaka nang tawn da lu na n rai; matsan dum ai myit mung madun lu na n rai:
  </para>
  <para style="p">
    <verse number="3" style="v" />shanhte hte mayu dama shaw hkat lu na n rai: na a shayi sha hpe shi a shadang sha hte mung, na a shadang sha hte shi a shayi sha hpe mung, ya sha hkungran lu na n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, Hpara shaje hpe nawku shangun lu hkra, shi na nsha hpe nye a lam hta na shayit na ru ai: shaloi Yehowa nanhte hpe pawt bu nna, akajawng sha nang hpe sat kau na ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai re ai majaw shanhte hpe ning di mu: shanhte a tawn hkungri ni hpe agrawp kau ya mu; shanhte a sumla shadaw ni hpe adawt daw kau ya mu; shanhte a Asherim sumla ni hpe kran daw kau ya mu; tawk la ai sumla ni hpe mung nat kau ya mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaning rai nme law, nang gaw na a Karai Kasang Yehowa a matu chyoi pra ai amyu rai nga ndai: na a Karai Kasang Yehowa madu ging ai amyu shatai na nga, ga ntsa ting na masha amyu ni hta na, shi nang hpe lata la nit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanhte masha amyu gale mahkra hta nanhte grau law ai majaw nang hpe Yehowa nja nna lata la ndai n rai: amyu gale mahkra hta nanhte grau kaji nga myit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa nanhte hpe tsawra ai majaw mung, na nji nwa ni hpe dagam da ai ga shaka shatup mayu wu ai majaw mung, nang yam nga ai Egutu mung na hkawhkam Hpara-u a lata na, shi a n-gun ja ai lata hte nang hpe hkye la nna woi wa nit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna, na a Karai Kasang Yehowa gaw Karai Kasang rai nga ai chye nga u: shi gaw kangka re ai Karai Wa, shi hpe tsawra ai hte shi a hkang da ai ga hkan nang ai ni hpe prat hkying mun du hkra ga shaka shagrin nga nna matsan dum ai myit madun ai Karai Wa;
  </para>
  <para style="p">
    <verse number="10" style="v" />shi hpe n dawng ai ni e gaw jahten kau na nga, shanhte a man pa ari jaw ai Karai Wa rai nga ai: shi hpe n dawng ai wa e agam ai myit n rawng ai sha, dai wa hpe man pa ari jaw na wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai re ai majaw, dai ni ngai nang hpe tawn da ya ai hkang da ai ga, matsun maroi ga hte dawdan ai tara hpe shatsup lu hkra hkan nga na rai ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai dawdan ai tara ga ni hpe nanhte hkan nang na nga, madat mara ai myit rawng myit yang gaw, na a Karai Kasang Yehowa na nji nwa ni hpe dagam da ai ga shaka hte matsan dum na lam hpe shagrin nga na ra ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />shing rai shi nang hpe tsawra ai hte shaman ya nna shalaw jahtam na rin dai; nang hpe jaw na nga na nji nwa ni hpe dagam da ai mung hta, nang shaprat ai kashu kasha ni hpe mung, na a lamu ga na nsi naisi ngu na, na a nai mam, tsabyi jahku, sau namman hte, na a sagu dumsu yamnga re ai sut hta mung shaman ya na rai ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang gaw masha amyu danghta hta gumring gumrat grau lu la ai wa rai nga ndai rai nna, nang hta ala maudung anum maudung langai mi muk, na a yamnga hta uhtum langai mi muk pru lu na n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa gaw nang kaw na ana ahkya yawng mayawng yeng seng kau ya nna, nang mu yu ai Egutu mung na hkrithpa zinli nang hta kap shangun na wu ai n rai; nang hpe n dawng n yawt ai ni yawng hta shakap na wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a Karai Kasang Yehowa nang hpe ap ya ai masha amyu nlang hte hpe sha kau lu na rai ndai; na a myi gaw shanhte hpe matsan dum lu na n rai; shanhte a Hpara ni hpe mung nang jaw jau lu na n rai; jaw jau n yang, dai gaw na a mahkam tai na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Wora amyu ni ngai hta grau law nga ma ai mi, ngai shanhte hpe kaning di dang lu na i?’ nga nna na a kraw e myit la let, shanhte hpe hkum hkrit nga et:
  </para>
  <para style="p">
    <verse number="18" style="v" />na a Karai Kasang Yehowa Hpara-u hte Egutu mung ting hta galaw nu ai amu ni, nang dai myi chyi mu lu ai chyam dinglik lam kaba ni;
  </para>
  <para style="p">
    <verse number="19" style="v" />na a Karai Kasang Yehowa nang hpe shaw woi wa ai shaloi na, shi madun ai lamik kumla, mauhpa lam ni hte shi a n-gun ja ai lata, shada nga ai lahpum hpe azin ayang dum nga na rai ndai: dai zawn, nang hkrit ai amyu yawng hte hta na a Karai Kasang Yehowa di ya na ru ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hta kaga naw ngam nna, na a man na hprawng makoi nga ai ni hpe mung n htum mat dingsa gaw, na a Karai Kasang Yehowa shanhte hpang de git shang shangun dat na wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang hta rawng nga ai na a Karai Kasang Yehowa gaw galu kaba ai hte hkrithpa Karai Wa rai nga lit dai majaw, nang shanhte hpe hkrit ra ndai n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a Karai Kasang Yehowa gaw dai amyu ni hpe yat yat gawt kau ya na ra ai: nam na matse labye ni nau law wa na hpe tsang ra ai majaw, shanhte hpe alawan shamyit kau mai na n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung, na a Karai Kasang Yehowa gaw shanhte hpe na a lata hta ap ya nna, shanhte a ningli nmyit dingsa shanhte hpe jahtum kau na lam hpajang nga na nu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte a hkawhkam ni hpe mung na a lata hta ap kau nna, shanhte a nsang mying ni hpe pyi sumsing lamu npu na seng kau na rai nga ai: shanhte hpe n shamyit kau lu dingsa na aman e kadai tsap lu na n rai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte a tawk la ai sumla ni hpe nat kau ya mu: dai hta kap ai aja gumhpraw ni hpe hkum marit et; dai hpe hkum hta la et; hta la n-yang, dai gaw na a mahkam tai na ra ai: dai hpe na a Karai Kasang Yehowa matsat nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai matsat shabat re ai rai hpe na nta nhku de hkum shawn et; shawn n yang gaw, nang hkum mung rai dai zawn jahten kau hkrum ging ai tai na rin dai; dai zawn re ai arai hpe nang gaja wa matsat ai hte koi kau lu na rai ndai: dai gaw jahten kau ging ai arai rai nga ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nang hkrung nga nna law htam wa lit ga hte, Yehowa na a nji nwa ni hpe dagam da ai mung de sa nna shang sha lu n ga gaw dai ni ngai nang hpe hkang da ai matsun maroi nlang hte hpe hkan shatsup lu hkra sadi nga u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a Karai Kasang Yehowa nang hpe shagrit chyam yu nna, shi a hkang da ai ga hpe hkan nang mayu ai myit rawng ai n rawng ai chye lu hkra; lai mat wa sai mali shi ning tup woi hkawm ai nam mali lam dingdung hpe dum nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi nang hpe shagrit nna kawsi jahkrum ai hte, shinggyim masha gaw muk hte sha hkrung nga lu ai n rai, Karai Kasang a n-gup na pru mapru hte hkrung nga lu ai gaw nang chye lu hkra nga, nang mung n mu yu, na nji nwa ni mung n mu yu ai manna hte nang hpe bau nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lai mat wa sai mali shi ning ting hta, nang bu hpun ai hpun palawng n je n htum, na a lagaw mung n rawp n bum;
  </para>
  <para style="p">
    <verse number="5" style="v" />kawa gaw kasha hpe sharin shaga ai zawn, na a Karai Kasang Yehowa nang hpe sharin la nit dai gaw, na kraw lawang hta matsing gun nga u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai re ai majaw, na a Karai Kasang Yehowa hpajang ai lam hkan nang nna shi hpe hkrit hkungga let, shi a hkang da ai ga shatup nga u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, na a Karai Kasang Yehowa gaw, nang hpe dai kaja grau ai mungdan, hkaraw nhkap bum shagawng ntsa hkan nna lwi hkrat ai hka nu hka shi, hka hpawk hka htung hpring ai ga;
  </para>
  <para style="p">
    <verse number="8" style="v" />hkaulan mam, muk-yaw mam, tsabyi ru, maihpang hpun, hkainu si hpun ningru ai ga; tsanlun sau hte lagat jahku ing ai ga;
  </para>
  <para style="p">
    <verse number="9" style="v" />ra ai lam lama mi muk n nga hkra, hkru hkru hpring hpring sha lu ai ga; hpri rawng ai nlung hkrai chyat rai nna, bum kata na magri htu shaw lu ai ga de woi wa nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai nang hkru hkru kat kat sha lu na ra ai rai nna, nang hpe jaw da ai kaja htum ai mungdan a majaw, na a Karai Kasang Yehowa hpe shagrau sha a na rin dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai ni ngai nang hpe htawn tsun ai hkang da ai ga, dawdan ai tara hte matsun maroi ga hpe n hkan kau nna, na a Karai Kasang Yehowa hpe malap kau ai kaw n du lit ga, sadi nga u:
  </para>
  <para style="p">
    <verse number="12" style="v" />nang hkru hkru kat kat sha lu let, nta kaja shachyaw rawng nna nga nga yang;
  </para>
  <para style="p">
    <verse number="13" style="v" />na a sagu dumsu mayat maya wa ai hte, na a aja gumhpraw hpring wa nna, nang hta sutgan nlang law htam wa jang,
  </para>
  <para style="p">
    <verse number="14" style="v" />na a myit gumrawng wa nna, Egutu mung mayan tai ai nta na nang hpe shaw woi wa ai wa;
  </para>
  <para style="p">
    <verse number="15" style="v" />wan lapu hte n-gawgawk sawng nna lu na ntsin kata kawsi hpang gara let ai shata, dai hkrithpa mali kaba a ka-ang hku nang hpe woi wa nna, nhpai lungkring hta na ntsin shapraw jaw ai wa;
  </para>
  <para style="p">
    <verse number="16" style="v" />nang hpe shagrit chyam yu nna, hpang jahtum e nang hpe chyeju madun na nga, na a nji nwa ni pyi n chye ai manna hte dai nam mali kata e nang hpe bau maka ai na Karai Kasang Yehowa hpe nang malap kau nhtawm,
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a marai nye a atsam hte ndai sutgan ngai lu nngai, nga nna na a kraw kata e myit kau ai yubak n pru lit ga sadi nga u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na a Karai Kasang Yehowa hpe chyu sha dum nga lu na rai ndai: kaning rai nme law, na a nji nwa ni e dagam da ai ga shaka hpe, dai ni rai nga ai hte maren shagrin da na nga, Karai Kasang gaw sutgan lu su chye ai atsam nang hpe jaw nit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a Karai Kasang Yehowa hpe nang malap kau nhtawm, hpara shaje ni kaw kasawt nna nawku jaw jau rai wa nit yang gaw, nanhte teng teng hten bya ai kaw du na manit dai, nga nna dai ni nanhte a lam ngai sakse hkam da se ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nanhte a Karai Kasang Yehowa a ga nanhte n madat myit dai majaw, nanhte a man na Yehowa jahten kau ai amyu ni zawn, nanhte mung hten bya ai kaw du na manit dai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela amyu e, madat mara la u: nang hta grau kaba nna, n-gun grau ja ai amyu ni hpe mung, lamu ganghkau dep ai bunghku e shinggrup ai mare kaba ni hpe mung,
  </para>
  <para style="p">
    <verse number="2" style="v" />‘Anak masha ni a man e kadai wa tsap lu a ta?’ nga ai ga nang na yu nna chye lu ai, dai Anakim ngu ai galu kaba ai hte shing-yan hkra ai amyu hpe mung gasat gawt kau lu na matu, dai ni Yawdan hka wora hkran rap lu ningtawn rai nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna, na a Karai Kasang Yehowa gaw, grung ai wan zawn, na a shawng e langang sa wa ai wa rai nga ai hpe dai ni chye nga u: shi nan shanhte hpe jahten kau nna na a man e shagrit kau na ru ai: shing rai nang shanhte hpe shaden kau lu nna, Yehowa nang hpe tsun ai hte maren, nang shanhte hpe alawan shamyit kau lu na rin dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a Karai Kasang Yehowa gaw na a man na dai amyu ni hpe shaden kau ya ai hpang, nang gaw, ‘Nye a dinghpring ai majaw she Yehowa ngai hpe dai mungdan de woi shawn nna madu la shangun nngai mi,’ nga nna na a kraw e hkum myit et; dai amyu ni a n shawp ai amu majaw sha Yehowa gaw shanhte hpe na a man na shaden kau ya ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai mungdan nang shang madu sha lu ai gaw, na a dinghpring ai a marang e mung n rai, na a myit masin tengman ai a marang e mung n rai: Yehowa na nji nwa Abraham, Isak, Yaku hte hpe dagam da ai ga shadik na majaw, na a Karai Kasang Yehowa gaw dai amyu ni hpe, tinang a n shawp ai a majaw na a man na shaden kau nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, na a Karai Kasang Yehowa, na a dinghpring ai a marang e, dai kaja grau ai mungdan nang hpe jaw ai n re ai gaw, dum nga u: nang gaw du ja ai amyu rai nga ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang na a Karai Kasang Yehowa hpe dai nam mali hkan e kaning rai shapawt pawt rai ndai gaw nang adum nga u, hkum malap kau et: Egutu mung na nang pru wa ai shani kaw nna ndai yang du ai du hkra, Yehowa hpe nang a gumlau nga nit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Horeb bum e nanhte Yehowa hpe shapawt myit dai rai nna, nanhte hpe shamyit kau na daram shi pawt kau nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa nanhte hte tawn da ai ga shaka ka ai lungpa wa la na matu bum de ngai lung wa ai shaloi nhtoi mali shi ya tup dai bum ntsa e, shat n sha ntsin n lu ai wa nga nga nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanhte sa hpawng ai shani bum ntsa e Yehowa wan kata na tsun dat ai ga nlang, Karai Kasang a layung hte nan ka ai lungpa lahkawng, Yehowa ngai hpe ap ya nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai nhtoi mali shi ya gu jang, dai ga shaka lungpa lahkawng Yehowa ngai e ap ya nhtawm;
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa gaw ngai e, ‘Rawt u, alawan yu wa sit: Egutu mung na nang shaw wa ai na a masha ni gaw byak mat masai; ngai hkang da ai lam hta na shanhte alawan dam mat wa nna, jaw ai sumla galaw rau masai,’ nga nna tsun dat ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai Yehowa ngai e tsun ai gaw, ‘Ndai amyu hpe ngai yu mase ai; yu u, dai gaw du ja ai amyu rai nga ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />dai rai nna, ngai shanhte hpe jahten kau nna, shanhte a amying hpe sumsing lamu a npu na shaprai kau lu hkra, ngai hkrai chyu we ga: shing rai ngai nang hpe shanhte hta grau ja nna, grau law htam ai amyu shatai na de ai,’ nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi ngai gaw kayin nna dai bum na yu wa nngai; dai bum mung wan grung nga ai; dai ga shaka lungpa yan hpe mung nye a lata maga hpra lang da we ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi ngai mada yu yang, yu mu, nanhte gaw nanhte a Karai Kasang Yehowa hpe shut kau manu ai, jaw ai dumsu kasha sumla galaw tawn myit dai; Yehowa nanhte hpe hkang da ai lam hta na nanhte alawan yit kau myit dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi nye lata hta lang tawn ai laungpa yan hpe nanhte a man e ngai kabai agrawp kau we ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa a man e nanhte n shawp ai amu shapraw nna, shi hpe shapawt ai mara nlang a majaw, shawng na zawn nhtoi mali shi ya tup Yehowa a man e ngai dingnyawm dagup nga nna, shat n sha ntsin n lu ai bai nga nga nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaning rai nme law, Yehowa nanhte hpe shamyit kau sa na nga, pawt bu ai sindawng hpe ngai hkrit nga nngai: Yehowa chyawm gaw dai lang hta mung nye a ga madat ya ni ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Arun hpe mung jahten kau na nga, Yehowa grai pawt bu wu ai; Arun a matu mung dai shaloi e ngai hpyi nem ya we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanhte a yubak ngu na, nanhte galaw ai dumsu kasha hpe mung ngai la nna, wan hta ju nhtawm, ayun ayaw rai hkra arin ngut jang, dai ayun hpe bum na lwi hkrat ai hka hta kabai bang kau we ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hta kaga, Tabera, Masa hte Kibrot-hatawa shara hkan e mung nanhte Yehowa hpe shapawt manit dai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kadesha-barnea kaw nna Yehowa nanhte hpe shangun dat nna, ‘Ngai nang hpe jaw ai mungdan madu sha na matu lung wa ma su,’ nga nna tsun ai shaloi mung, nanhte a Karai Kasang Yehowa hkang dat ai ga hpe nanhte ndang nna, shi hpe n kam n sham ai hte shi a ga n madat myit dai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai she mu mu ai kaw nna nanhte Yehowa hpe gumlau hkrai gumlau myit dai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai, nanhte hpe shamyit kau na nga, Yehowa tsun ai majaw, dagup nga nga ai, nhtoi mali shi ya ting, Yehowa a man e ngai dingnyawm dagup nga kau nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yehowa hpe ngai hpyi we ai gaw, ‘Yehowa Madu e, na a hpung shingkang hte nang hkrang la nna, na a n-gun ja ai lata hte Egutu mung na shaw woi wa ai, na a Sali wunli ngu na, na a amyu masha ni hpe hkum shaza kau et:
  </para>
  <para style="p">
    <verse number="27" style="v" />na a mayam Abraham, Isak, Yaku hte hpe naw dum nga u: dai amyu a du ja ai, n shawp ai hte yubak mara hpe hkum dum ya et:
  </para>
  <para style="p">
    <verse number="28" style="v" />dai n rai yang, anhte hpe shaw wa ai mung na ni, Yehowa gaw shi a ga ndat jaw da ai mung de shanhte hpe n shawn lu wu ai majaw mung, nam mali hkan e sat kau na nga shanhte hpe shaw wa mu hka,’ nga na mara ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ndai ni chyawm gaw, ‘na n-gun kaba hte, na a shada tawn ai lahpum e shaw woi wa ai na amyu hte na a sali wunli rai nga ma ai,” ngu nna ngai hpyi nem we ai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai shaloi e Yehowa gaw, “Shawng na lungpa yan zawn lungpa lahkawng naw ga la su; dai bum e ngai hpang de lung wa rit; hpun sumpu mung galaw u:
  </para>
  <para style="p">
    <verse number="2" style="v" />shawng na nang agrawp kau ai lungpa yan hta kap ai ga hte maren, dai lungpa ya hta ngai bai ka da we ga: dai yan hpe dai sumpu hta nang bang da na rai ndai,” nga nna ngai hpe tsun ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai mung marau hpun hte sumpu galaw nna, shawng na zawn lungpa lahkawng ga la ngut jang, dai lungpa yan hpe lang let dai bum de lung wa nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sa hpawng ai shani e, dai bum ntsa e wan hta nna Yehowa tsun dat ai ga kanu shi hpe, shawng na lungpa yan hta kap ai hte maren, Yehowa bai ka nna ngai hpe ap ya nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai mung kayin nna, dai bum na yu wa nhtawm, galaw ngut tawn sai sumpu hta lungpa dai yan hpe bang da we ai: shing rai Yehowa ngai hpe hkang dat ai hte maren, dai sumpu hta ya rawng nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />(Ya Israela kashu kasha ni gaw Berot Bene-yakan kaw nna Mosera du hkra htawt hkawm wa ma ai; dai yang e Arun si nna makoi mayang kau sai: shi kasha Eliaza gaw kawa hkringhtawng dagraw nna hkinjawng amu galaw wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai kaw na htawt ai gaw Gudgoda e sa ma ai; Gudgoda kaw na htawt ai gaw hka shi law law lwi ai Yobahta e sa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai shaloi e Yehowa gaw, shi a ga shaka sumpu hpai na matu mung, shi a man e tsap nna amu gun hpai na matu mung, shi a amying ningsang gang nna shaman ya lu mu ga mung, dai ni du hkra Lewi masha ni hpe san da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai re ai majaw Lewi masha ni gaw kahpu kanau ni zawn kumhtaw madu lu na n rai, Sali wunli dagraw sha lu na n rai; na a Karai Kasang Yehowa shi hpe tsun dan ai hte maren, Yehowa gaw shi a Sali wunli rai nga ai.)
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai mung shawng na hte maren, nhtoi mali shi ya tup dai bum e nga nga nngai: shaloi na lam hta mung Yehowa nye a ga madat wu ai; Yehowa nang hpe n jahten kau nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa mung ngai e, “Rawt u, ndai amyu a shawng e sa wa su; shanhte hpe jaw na ngu nna, kaji kawa ni hpe dagam da ai mung de shanhte sa wa nna madu sha lu na rai ma ai,” ngu nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya, Israela amyu e, na a Karai Kasang Yehowa hpe hkrit hkungga let, shi a lam nlang hkan nang na; na a Karai Kasang Yehowa hpe na a myit masin mahkra hte na a kraw lawang mahkra hte tsawra let, shi a magam gun hpai na;
  </para>
  <para style="p">
    <verse number="13" style="v" />na ngamai wunli matu, dai ni ngai nang hpe hkang da ai, Yehowa a hkang da ai ga hte matsun maroi ga ni hpe hkan shatsup na lam ni hta kaga, na a Karai Kasang Yehowa shadut ai lam hpa naw nga a ta?
  </para>
  <para style="p">
    <verse number="14" style="v" />Yu u, sumsing lamu hte de a lahta tang, ginding aga hte dai hta pra mapra na a Karai Kasang Yehowa madu nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa gaw na nji nwa hpe chyu sha tsawra wu ai rai nna dai ni rai nga ai hte maren shanhte a amyu matu ngu ai nang hpe nan masha amyu danghta hta na lata la nit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai re ai majaw na a myit masin a matu gadoi kau u, htawm hpang de du hkum ja nit.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a Karai Kasang Yehowa gaw Karai ni a Karai, Madu ni a Madu, galu kaba ai, daru magam re ai, hkrit kang mai ai Karai Wa rai nga ai; shi gaw myi man n tau, manawn kumhpa n sha ai;
  </para>
  <para style="p">
    <verse number="18" style="v" />jahkrai nmai, gaida gaina ni hpang maga tara dara ya nna, shingbyi zaw nam ni hpe tsawra ai hte lusha hpun palawng jaw ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna shingbyi zaw nam ni hpe tsawra mu: kaning rai nme law, nanhte mung Egutu mung e manam tai nga yu manit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na a Karai Kasang Yehowa hpe hkrit hkungga nga u; shi a magam gun hpai u: shi hta shamyit shanat nna dagam ai hta shi a amying ningsang gang u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a matu mara nga nna, na a myi chyi mu lu ai galu kaba ai hte mauhpa amu galaw ya ai wa gaw, nang shakawn kungdawn shara hte na a Karai Kasang rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na nji nwa ni ngu na, masha marai sanit shi sha Egutu mung de yu wa ma ai; ya chyawm gaw na a Karai Kasang Yehowa sumsing lamu na shagan made nang hpe shalaw jahtam dat nit dai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai re ai majaw nang gaw na a Karai Kasang Yehowa hpe tsawra let, shi a ga madat hte matsun maroi, dawdan ai tara hte hkang da ai ga ni hpe hkan shatup nga na rai ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanhte a Karai Kasang Yehowa daru sharin ai lam hpe mung; shi a daru magam, shi a n-gun ja ai lata hte shada nga ai lahpum hpe mung;
  </para>
  <para style="p">
    <verse number="3" style="v" />shi a lamik kumla ni hte Egutu mung e Egutu hkawhkam Hpara-u hte shi a mungdan ting hta galaw dan ai amu hpe mung,
  </para>
  <para style="p">
    <verse number="4" style="v" />Egutu mung na hpyen luksuk ni hte shanhte a gumra ni shanhte a hpyen leng ni hpe di ai amu hpe mung; nanhte hpe hkan shachyut nga yang Nawng Hkyeng hka gaw shanhte hpe galup sat kau nna, dai ni du hkra Yehowa shanhte hpe jahtum kau wu ai lam hpe mung;
  </para>
  <para style="p">
    <verse number="5" style="v" />ndai yang garai n du ai laman nam mali hkan e nanhte hpe di ai lam ni hpe mung;
  </para>
  <para style="p">
    <verse number="6" style="v" />Rubin lakung Eliaba kasha Dahtan yan Abiram hpe di ai lam hpe mung; ga gaw shi a n-gup mahka nna shanhte hte shanhte a nta masha, shanhte a sum, shanhte lu malu hte hkan nang ai ni yawng hpe Israela amyu a ka-ang e mayu kau wu ai lam hpe mung, n mu n chye lawm ai nanhte a nshu nsha ni hpe ngai n tsun nngai:
  </para>
  <para style="p">
    <verse number="7" style="v" />nanhte chyawm gaw Yehowa galaw dan ai amu kaba yawng hpe tinang myi chyi mu lu manit dai, dai ni dum nga manu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai re ai majaw, nang shang sha lu na mungdan hpe nsam kaba dat nna shang madu lu na hte,
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa nanhte a nji nwa ni hta, shanhte hte shanhte a amyu matu ni hpe jaw na nga dagam da ai mungdan, dai nga chyu hte lagat jahku lwi ai mung hta nanhte asak galu malit ga gaw, dai ni ngai nang hpe tawn da ya ai hkang da mada ga hpe nanhte hkan shatup lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang shang madu sha lu na mungdan gaw, nanhte pru kau da ai Egutu mung hte bung ai n rai; shat mai sun galaw ai zawn, nli gat nhtawm, lagaw hte ntsin jaw ra ai mungdan n rai:
  </para>
  <para style="p">
    <verse number="11" style="v" />nanhte shang sha na mungdan chyawm gaw, kawng jinghkang hkaraw nhkap sawng ai hte marang ntsin lu lu ai ga rai nga ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />ga dai gaw nanhte a Karai Kasang Yehowa lajang da ai ga rai nga ai; shaning na nnan shani kaw nna hpang jahtum shani du hkra, na a Karai Kasang Yehowa lamu ga dai hpe tut tut a yu nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai, dai ni ngai nanhte hpe tawn da ya ai hkang da ai ga hpe nanhte azin ayang madat mara ai hte, nanhte a Karai Kasang Yehowa hpe tsawra let, nanhte a kraw lawang mahkra hte, nanhte a myit masin mahkra hte shi a amu magam gun hpai myit yang gaw;
  </para>
  <para style="p">
    <verse number="14" style="v" />na a nsi naisi, na a tsabyi jahku ningnan hte na a namman shu la lu hkra, nanhte a lamu ga hta, du hkra ladaw du jang, mahpawng hpaw marang hte hpang shadoi htu marang, ngai jahtu ya na ring ngai:
  </para>
  <para style="p">
    <verse number="15" style="v" />na a yamnga ni a matu pa e tsingdu mung ngai shatut ya nna, nang hkru hkru kat kat sha lu na rin dai: Rai timung, nanhte myit n shut nna, Hpra shade ni kaw n jaw n jau n naw n ku myit ga sadi nga mu;
  </para>
  <para style="p">
    <verse number="16" style="v" />dai n rai yang, Yehowa nanhte hpe masin pawt nna, na a lamu ga hta nai mam n tu lu na hku marang n htu lu hkra sumsing lamu hpe pat kau na wu ai: shaloi Yehowa nanhte hpe jaw ai kaja htum ai mungdan hta na, nanhte alawan htum mat na myit dai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna, nye a ga ndai ni hpe na a kraw lawang e, na a myit masin hta nang gun da ai hte, nanhte a lata hta kumla tai nga na matu hkawn da nna, nanhte a myi lapran e masat dingsat laika tai nga na rai malit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ga ndai hpe nanhte a nshu nsha ni hpe sharin achyin let, nta e dung nga yang mung, lam e hkawm sa yang mung, taw nga rawt wa yang mung, ga dai a tsun nga lu na rai ndai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ga dai hpe na nta chyinghka hkadun hte na mare chyinghka hta mung ka da na rai ndai:
  </para>
  <para style="p">
    <verse number="21" style="v" />shing rai jang, na nji nwa ni hpe jaw na nga, Yehowa dagam da ai mungdan hta, nang hta na nshu nsha ni a aprat gaw, ginding aga ntsa e sumsing lamu grin nga dingsa, galu nga na malit dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nanthe a Karai Kasang Yehowa hpe tsawra let, shi a lam yawng hkan nang nna shi hpe manoi manat nga lu hkra, ngai nanhte hpe hkang da ai ga matsun yawng hpe azin ayang shatsup lu na nga hkan sharau nga myit yang gaw;
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa mung ndai amyu ni nlang hpe nanhte a man na shaden kau ya nna, nanhte hta grau galu kaba ai hte grau law htam ai amyu ni hpe madu lu na marin dai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nanthe kabye du madu nanhte madu la lu nan, nam mali kaw nna Lebanon bum htep, Uhprat hka nu kaw na nammukdara hkin-gau e htuk, na a lamu ga jarit rai na ra ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kadai mung nanhte a man e tsap nga lu na nrai: nanhte a Karai Kasang Yehowa nanhte hpe tsun da sai hte maren, nanhte kabye du ai shara shagu na masha nlang hte, nanhte e hkrit gari ai hte ma mat shajang shangun na wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yu u, dai ni e chyeju lam hte dagam dala lam, ngai nanhte a man e tawn da se ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />dai ni ngai nanhte hpe tawn da ya ai, nanhte a Karai Kasang Yehowa a hkang da ai ga hpe nanhte madat mara myit yang gaw, chyeju lam rai nga ai:
  </para>
  <para style="p">
    <verse number="28" style="v" />nanhte a Karai Kasang Yehowa a hkang da ai ga hpe nanhte n madat, dai ni ngai nanhte hpe tawn da ya ai lam hta tawt nna, tinang n chye ai Hpara shaje hpang de manoi mat wa myit yang chyawm gaw, dagam dala lam rai nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang sa nna madu sha na mungdan de na a Karai Kasang Yehowa nang hpe woi shawn ngut jang, chyeju lam hpe Gerizim bum e, dagam dala lam hpe Ebala bum e jaw da na rai ndai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai bum yan gaw, Yawdan hka wora hkran, jan shang maga nmaw lam a shinggan, More wamyi hpun makau na Gilgala hte tawtap rai nga ai, layang ga na Hkanani masha ni a lamu ga hta rai nga ai, n rai ni?
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaning rai nme law, nanhte a Karai Kasang Yehowa nanhte hpe jaw da ai mungdan hpe shang madu la na matu, nanhte Yawdan hta rap nna, mungdan dai up la let nga sha lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shing rai dai ni ngai nanhte hpe jaw da ai matsun maroi ga hte dawdan ai tara yawng mayawng hpe, nanhte hkan shatup lu na rai myit dai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lamu ga dai hta nanhte hkrung nga prat dingsa madu sha nga na matu, na nji nwa ni a Karai Kasang Yehowa jaw ai mungdan e nanhte hkan lang nga na matsun maroi ga hte dawdan ai tara gaw, ndai rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanhte gawt kau na amyu ni, shanhte a Hpara ni hpe jaw jau ai shara ni ngu ai, tsaw ai bum ntsa hkan na, kawng ntsa hkan na hte tsit lali ai hpun shagu npu hkan na shara yawng hpe nanhte teng teng atsai awai di kau na rai myit dai:
  </para>
  <para style="p">
    <verse number="3" style="v" />shanhte a tawn hkungri ni hpe agrawp kau ya mu; sumla shadaw ni hpe adawt daw kau ya mu; shanhte a Asherim sumla ni hpe nat kau ya mu; shanhte a tawk la ai Hpara sumla ni hpe kran kau ya mu; dai yang na shanhte a amying du teng seng kau ya mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte galaw ai lam hkan nna, nanhte gaw nanhte a Karai Kasang Yehowa a matu galaw lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanhte a Karai Kasang Yehowa nanhte a amyu ting hta shi a amying ningsang nga nga na matu lata la ai shara ngu ai, shi shanu nga ai shara hpe nanhte tam nna dai de sa wa lu na rai myit dai:
  </para>
  <para style="p">
    <verse number="6" style="v" />dai de, nanhte a wan nat hkungga hte shagu hkungga; htamshi hta na htammi jaw ai kumhpa hte nanhte a lata na manawt kumhpa; ga shaka kumhpa hte mayu jaw jau ai kumhpa; sagu dumsu hpung ni hta na shawng hkrat ai kasha alat re ai kumhpa ni hpe la sa na rai myit dai:
  </para>
  <para style="p">
    <verse number="7" style="v" />dai yang e mung nanhte a Karai Kasang Yehowa man e nanhte lu sha nga nna, nanhte a galaw ai lam magup hta nanhte a Karai Kasang Yehowa shaman ya myit dai majaw, nang hkum hte na a nta masha ni nlang kabu gara nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya dai ni, ndai yang anhte galaw ai zawn, dai kaw e hkum shagu tinang ra ai hku galaw lu na n rai:
  </para>
  <para style="p">
    <verse number="9" style="v" />kaning rai nme law, ya gaw nanhte a Karai Kasang Yehowa jaw ai ban sa ai hte Sali wunli hta nanhte garai n shang myit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai timung, nanhte Yawdan hka rap nna, Sali wunli matu nanhte a Karai Kasang Yehowa nanhte hpe jaw ai mungdan hta nanhte nga sha lu ai hte, grup yin masha hpyen ni yawng a lata na maga tawn nna, nanhte ngwipyaw nga lu ai shaloi;
  </para>
  <para style="p">
    <verse number="11" style="v" />shi a mying ningsang nga nga na matu, nanhte a Karai Kasang Yehowa san da ai shara de, ngai hkang da mada hte maren, nanhte a wan nat hkungga hte shagu hkungga; htamshi hta htammi jaw ai kumhpa hte nanhte a lata na manawt kumhpa; Yehowa hpe ga shaka da ai hte maren jaw jau ai kaja htum ai ga rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai shaloi e nanhte ni mung, nanhte a mayam num mayam la ni mung, kumhtaw n htu nna Sali ga n lu ai, nanhte kaw shingbyi nga ai Lewi masha mung, nanhte a Karai Kasang Yehowa man e kabu gara nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkrup mahkrup shara hkan e na a wan nat hkungga nang n jaw n ga sadi nga u:
  </para>
  <para style="p">
    <verse number="14" style="v" />nanhte a amyu langai mi kaw Yehowa san tawn ai shara e, na a wan nat hkungga nang jaw jau nna, ngai nang hpe hkang da mada galaw lu na rai ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai timung, na a Karai Kasang Yehowa nang hpe shaman ya ndai hte maren, na a nga shara shagu hkan e sha mayu ai made mayu sat sha lu ai ahkang nga nga ai; atsu aya shan sha ai zawn, san seng ai ni hte n san n seng ai ni rau sha lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai timung asai gaw sha lu na myit dai n rai; ntsin ru kau ai zawn ga de ru kau na rai ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a nai mam, tsabyi jahku, sau namman re ai ni a htamshi hta na nawng jau ai htammi; sagu dumsu hta na shawng hkrat ai kasha alat; ga shaka kumhpa, mayu a jau ai kumhpa hte na a lata na manawt kumhpa re ai ni hta na baw mi hpe mung, tinang a nga ai shara e nang sha lu na ndai n rai:
  </para>
  <para style="p">
    <verse number="18" style="v" />na a Karai Kasang Yehowa lata da ai shara hta, nang hkum dai hte, na a shayi shadang sha ni mung, na a mayam num mayam la ni hte, nang kaw shingbyi nga ai Lewi masha wa mung, na a Karai Kasang Yehowa man e dai hpe sha lu na rai nna, nang galaw ai lam magup hta na a Karai Kasang Yehowa man e kabu gara nga na rai ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai lamu ga hta nang hkrung nga prat dingsa, Lewi wa hpe nang n kau n ga, sadi nga u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na a Karai Kasang Yehowa nang hpe tsun da ai hte maren, na a lamu ga shadam ya ndai shaloi, nang shan sha mayu myit rawng nna, “Ngai shan sha yu we ga,” nga yang, sha mayu ai made sha lu na ahkang nga nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a Karai Kasang Yehowa, shi a amying ningsang tawn da na lata da ai shara dai, na a nga shara hte tsan la lit yang gaw, Yehowa nang hpe jaw ai na a sagu dumsu hpe, ngai hkang da ai hku nang sat nna, na a nga shara e sha mayu ai made sha lu na ahkang nga nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Atsu aya shan sha ai zawn nang sha lu na rai ndai; san seng ai ni, n san n seng ai ni maren jawm sha lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung, asai n sha lawm myit ga gaw sadi nga mu, asak gaw asai hta rawng nga ai: dai rai nna ashan hpe asak hte hpawn sha lu na n rai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai majaw asai sha lu na nrai; ntsin ru kau ai zawn, ga de ru kau na rai ndai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa sharawng awng hpa amu nang galaw nna, nang hkum dai hte nshu nsha ni ngamu ngamai lit ga gaw, asai sha lu na n rai. Nang lu ai, na a chyoi pra ai kumhpa hte, na ga shaka kumhpa ni hpe sha nang la lang nna, Yehowa san da ai shara de sa lu na rai ndai;
  </para>
  <para style="p">
    <verse number="26" style="v" />shing rai, na a wan nat hkungga hpe, ashan hte asai nawng, na a Karai Kasang Yehowa a tawn hkungri ntsa e nang nat jau na rai ndai: hkungga gale chyawm gaw, asai hpe na a Karai Kasang Yehowa a tawn hkungri hta nang ru hkaw nna, ashan hpe gaw nang sha lu na rai ndai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na a Karai Kasang Yehowa a ra sharawng ai hte tengman ai amu nang galaw nna, nang hte na nshu nsha prat dingsa ngamu ngamai lu lit ga, ngai nang hpe hkang da mada ga ndai ni hpe azin ayang madat nna hkan shatsup nga u.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang sa nna madu sha na rin dai mung hta nga ai amyu masha ni hpe na a Karai Kasang Yehowa na a man na seng kau ya nna, shanhte a lamu ga hta nang madu sha nga ai shaloi e;
  </para>
  <para style="p">
    <verse number="30" style="v" />shanhte na a man na hten bya mat ai hpang, shanhte a lailen nang hkan nna yubak n pru lit ga gaw, “Dai amyu ni shanhte a Hpara ni hpe kaning rai jau ma ta? dai zawn ngai galaw yu na,” nga nna shanhte a hking lam n san hkrup n ga sadi nga u.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hku hkan nna, na a Karai Kasang Yehowa a lam hta nang galaw lu na n rai; kaning rai nme law, shanhte gaw, Yehowa n dawng n yawt ai lam shagu shanhte a Hpara ni hta galaw masai: tinang a shayi shadang sha ni hpe pyi shanhte a Hpara ni hpe jaw kau let, wan hte nat sat manu ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai nanhte hpe hkang da mada hkan shatsup nang nga mu; dai hta jat mung hkum jat et, Yawm mung hkum shayawm et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Myihtoi htoi ai wa, shing n rai, yup mang mu ai wa, nanhte hta paw pru nna, lamik kumla hte mauhpa amu nang hpe madun let,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang n chye ai Hpara shaje hpang de sit sa nna nawku ga nga tsun yang, dai nang hpe madun ai lamik kumla hte mauhpa amu byin lu ai rai timung,
  </para>
  <para style="p">
    <verse number="4" style="v" />dai myihtoi wa, dai yup mang mu ai wa a ga nang madat lu na n rai: kaning rai nme law, nanhte hta nanhte a Karai Kasang Yehowa hpe kraw lawang mahkra hte myit masin mahkra hte tsawra ai myit rawng ai n rawng ai, nanhte a Karai Kasang Yehowa chyam yu ai rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nanhte gaw nanhte a Karai Kasang Yehowa a hpang hkan nang nna, shi hpe hkrit hkungga ai hte shi a hkang da ai ga hkan shatsup let, shi a nsen madat mara nga na rai myit dai; nanhte shi hpe chyu sha jaw jau nna shi hta manoi nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Egutu mung na nang hpe shaw woi wa ai hte, mayam tai nga ai nta na nang hpe hkrang la ai, na a Karai Kasang Yehowa hpe gumlau ai hku tsun nna, na a Karai Kasang Yehowa nang hpe hkang da ai lam hta na shadam kau na maw ai majaw, dai myihtoi wa, dai yup mang mu ai wa, sat kau ai hkrum lu na rai nga ai. Shing rai nanhte hta na yubak mara seng kau lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na chyu rum hpunau wa, na a shayi shadang sha, na a lahpyen na nang nja ai madu jan, na hkum hte maren tsawra ai jinghku wa langai ngai, “Sa, nang mung n chye, na nji nwa ni mung n chye ai Hpara shaje hpang de,
  </para>
  <para style="p">
    <verse number="8" style="v" />na a grup yin na, ni ai tsan ai masha ni lamu htum maga mi de nna maga mi de du hkra nawku ai Hpara hpe jaw jau saga,” nga nna nang hpe lagyim gunglau n yang,
  </para>
  <para style="p">
    <verse number="9" style="v" />nang hkraw lu ndai n rai, shi a ga mung madat mai na n rai: nang shi hpe yu nna matsan dum lu na n rai: lahpawt ai hte n makoi da ai sha,
  </para>
  <para style="p">
    <verse number="10" style="v" />shi hpe teng teng sat kau lu na rai ndai: shi hpe sat na rai jang, na a lata shawng jahtim nna she, masha gale nlang jahtim na rai myit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Egutu mung hte mayam tai nga ai nta na nang hpe shaw woi wa ai na a Karai Kasang Yehowa kaw na dam mat ma na hku maw ai majaw, dai wa hpe nlung hte kabai sat kau na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai lam hpe Israela amyu ting na lu nna hkrit nga let htawm hpang de dai zawn re ai n shawp ai amu galaw wam sa na n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanhte hta na n shawp ai masha nkau mi rawt pru nna, “Sa, nanhte n chye ai Hpara shaje nawku saga,” nga nna, shanhte hte rau nga ai mare masha ni hpe woi awn ai lam,
  </para>
  <para style="p">
    <verse number="14" style="v" />na a Karai Kasang Yehowa nang nga shara matu jaw ai mare langai ngai hta ashi pru dam yang;
  </para>
  <para style="p">
    <verse number="15" style="v" />dai amu lam hpe nang azin ayang san gawn lu na rai ndai; ashi pru ai hte maren dandawng nna gaja wa teng teng nanhte hta dai zawn re ai matsat shabat amu galaw hkrup ai rai yang gaw;
  </para>
  <para style="p">
    <verse number="16" style="v" />dai mare na masha ni hpe nhtu hte teng teng sat kau na rai myit dai; dai mare hpe dai hta rawng marawng hte hpawn yamnga nlang hpe nang atsai awai hpya kau na rai ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kashun la lu ai lanep rai yawng mayawng hpe dai mare a nmaw lam ka-ang e nang shajawng tawn nna mare hte hpawn lanep yawng mayawng hpe na a Karai Kasang Yehowa a matu nat kau na rai ndai; mare dai gaw prat dingsa shanut sumpum tai nga na rai nga ai; dai hpe bai de lu na n rai. Yehowa gaw shi a pawt bu ai masin hpe shakawp nna, na nji nwa ni hpe ndat da ai ga hte maren nang hpe matsan dum lama ai hte shalaw jahtam lit ga gaw, dai jahten kau mai ai arai lama mi muk n la ai sha:
  </para>
  <para style="p">
    <verse number="18" style="v" />na a Karai Kasang Yehowa a ga nang madat nna, dai ni ngai nang hpe hkang da ai hte maren, shi hkang da mada hpe hkan nang ai hte, na a Karai Kasang Yehowa sharawng awng hpa amu, shi a man e galaw nga na rai ndai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nanhte gaw, nanhte a Karai Kasang Yehowa a kashu kasha ni rai nga myit dai; dai rai nna si ai wa a matu tinang hkum hpe gadoi jahpye lu na n rai, na a lahtan kara mung doi lu na n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, nang gaw na a Karai Kasang Yehowa a matu chyoi pra ai amyu rai nga ndai; Yehowa madu ging ai amyu shatai na nga, ga ntsa ting na masha amyu ni hta na, shi nang hpe lata la nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Matsat ai baw nang sha lu na ndai n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang sha mai ai shan gaw, dumsu, sagu, bainam:
  </para>
  <para style="p">
    <verse number="5" style="v" />shan krang, shan nga, mailu, aya shahpa, atsu, chyahkyi re ai hte;
  </para>
  <para style="p">
    <verse number="6" style="v" />lahkru ga nna shat lai lai ai shan amyu ni rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai timung, shat lai lai ai shan, lahkru ga ai shan ni hta na, gawla-uk, prangtai, shahpan ni gaw, shat lai lai timung, lahkru n ga ai majaw, nanhte hta n san n seng rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Wa gaw lahkru ga timung shat lai n lai ai majaw nanhte hta n san n seng rai nga ai: de a shan mung hkum sha myit, si mang mung hkum hkra myit.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hka e rawng ai nga amyu danghta hta na, singgung hte asep tu ai sha nanhte sha na rai myit dai;
  </para>
  <para style="p">
    <verse number="10" style="v" />singgung hte asep n tu ai baw sha lu na myit dai n rai; dai gaw nanhte hta n san n seng rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />San seng ai u amyu shagu sha lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte n sha mai ai u amyu ni gaw: wa hpai kalang, lang da, nga kalang;
  </para>
  <para style="p">
    <verse number="13" style="v" />langji kaba, mai bra kalang, lang mut amyu myu;
  </para>
  <para style="p">
    <verse number="14" style="v" />u hka amyu yawng:
  </para>
  <para style="p">
    <verse number="15" style="v" />u gawla-uk, nsin kalang, hka u, langji amyu myu;
  </para>
  <para style="p">
    <verse number="16" style="v" />du du di di, u hku, u langang;
  </para>
  <para style="p">
    <verse number="17" style="v" />wunpu u, urum langda, hka u hka;
  </para>
  <para style="p">
    <verse number="18" style="v" />gawn, u-gaw amyu myu, mu-u hte patsip re ai ni rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Singkaw tu nhtawm gumrawt hkawm chye ai baw amyu shagu gaw nanhte hta n san n seng rai nga ai majaw, de a shan sha lu na n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />San seng ai u amyu myu chyawm gaw sha lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi hkrai si ai rai a shan hkum sha myit; nang kaw shingbyi nga ai tsasam wa sha lu na matu, shi hpe jaw mai ai; shing n rai masha bu de sa dut kau u; nang chyawm gaw, na a Karai Kasang Yehowa matu chyoi pra ai amyu rai nga ndai. Bainam kasha hpe kanu a chyu hte hkum shapyaw et.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a yi hkauna hta na shaning shanang shu la lu ai nsi naisi hpe htamshi hta htammi teng teng jahka da na rai ndai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na a Karai Kasang Yehowa, shi a amying ningsang a matu san da ai shara e nai man, tsabyi jahku, sau namman hte sagu dumsu ni hta na shawng hkrat ai kasha alat re ai htamshi na htammi hpe shi a man e sha lu na rai myit dai; shing rai jang na a Karai Kasang Yehowa hpe hkrit hkungga nga na lam sharin la lu na rin dai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a Karai Kasang Yehowa nang hpe shaman ya ndai shaloi, shi a amying ningsang a matu lata da ai shara tsan la ai majaw sa na lam galu ai hte, na a rai htamshi na htammi hpe n la sa lu n yang gaw;
  </para>
  <para style="p">
    <verse number="25" style="v" />arai dai ni hpe gumhpraw hte galai nna, gumhpraw dai gun let na a Karai Kasang Yehowa lata da ai shara de sa na rai ndai:
  </para>
  <para style="p">
    <verse number="26" style="v" />shing rai sha mayu ai hte maren, dumsu, sagu, tsabyi jahku hte chyaru re ai rai ra mara mari la nhtawm nanhte a Karai Kasang Yehowa a man e tinang a nta masha ni yawng hte rau nang lu sha nna kabu gara nga na rai ndai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang kaw shingbyi nga ai Lewi wa hpe mung nang kau rap di lu na n rai: kaning rai nme law, shi gaw nang zawn kumhtaw hte Sali wunli lu nga ai n rai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Masum ning du shagu na, nang lu ai htamshi hta htammi hpe na a mare kata e shinggyin da na rai ndai:
  </para>
  <para style="p">
    <verse number="29" style="v" />dai hpe, nang zawn kumhtaw hte Sali wunli n lu ai Lewi wa hte nang kaw sa nga ai tsasam manam wa, jahkrai ningmai ni hte gaida gaina ni sa nna hkru hkru kat kat sha lu na rai ma ai: shing rai jang, na a Karai Kasang Yehowa gaw, nang galaw ai lam shagu hta nang hpe shaman ya na ra ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sanit ning ningdaw shagu raw dat lam hpaw lu na rai ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Raw dat lam ngu ai gaw ndai rai nga ai: htingbu manang wa hpe arai hkoi ya ai hka madu kadai mung, ahka dai hpe raw dat lu na rai nga ai; Yehowa a raw dat ningdaw rai nga ai majaw htingbu manang kaw na mung, hpunau wa kaw na mung, ji la lu na n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Maigan masha kaw na chyawm gaw ji la lu na ahkang nga nga ai: tinang a arai hpunau manang wa kaw kap makap raw dat lu na rai ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung, na a Karai Kasang Yehowa a nsen hpe nang azin ayang madat mara nna, dai ni ngai nang hpe hkang da mada hte hpe hkan shatsup n yang gaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />nang madu lu na matu na a Karai Kasang Yehowa nang hpe teng teng shaman ya na rai nna, nang hta matsan mayan masha n nga lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaning rai nme law, na a Karai Kasang Yehowa, shi a ga ndat hte maren nang hpe shaman ya na ra ai: shaloi maigan amyu law law hpe nang hkoi shap lu na rin dai rai nna, nang hkoi la ra na n rai; masha amyu law law hpe nang up lu na rin dai rai nna, shanhte gaw nang hpe up lu na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na Karai Kasang Yehowa nang hpe jaw ai mungdan na mare langai ngai hta, matsan mayan re a hpunau wa nga dam yang, dai na a hpunau matsan mayan wa hta, na a matsan dum ai myit hpe nang shim da lu na n rai, na a lata latup shangang lu na n rai:
  </para>
  <para style="p">
    <verse number="8" style="v" />na a lata hpe shi a matu dam lada hpyan tawn nna, shi a matsan bran ram hkra hkoi shap ya na rai ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a kraw hta n shawp ai myit rawng nna, Sanit ning ngu na raw dat ningdaw du magang ra ai nga, dum let, dai matsan mayan hpunau wa hpe lahpawt ai myit hte hpa n jaw ai nga nna, dai wa Yehowa hpe jahtau shaga yang na ntsa e yubak n du lit ga, sadi nga u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gaja wa teng teng nang shi hpe jaw lu na rai ndai; jaw n yang mung lahpawt ai myit hte jaw lu na n rai: kaning rai nme law, dai chyeju a majaw na a Karai Kasang Yehowa gaw nang galaw ai lam shagu, na a lata shachyen ai lam magup hta shaman ya na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a mungdan hta matsan mayan htum lu na n rai! Dai re ai majaw, na a mungdan hte, na a hpunau, ruyak hkrum ai wa hte matsan chyaren ai wa a matu, na a lata hpe nang gaja wa teng teng dam lada hpyan da lu na ndai, nga nna nang hpe ngai hkang da de ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a hpunau makyin Hebre amyu numsha, lasha yam nang mari yam ai rai yang, nang shi hpe kru ning sha yam sha lu na rai ndai; sanit ning ngu na hta shi hpe shabawn dat na rai ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi hpe shabawn dat yang, kaman san san n dat dat ai sha,
  </para>
  <para style="p">
    <verse number="14" style="v" />na a sagu hpung, na a mam chyarang, na a tsabyi htumbyen hta na ram ging ai made jaw dat lu na rai ndai: na a Karai Kasang Yehowa nang hpe shaman ya nit dai hte maren jaw dat na rai ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Egutu mung e nang mayam tai yu nit dai mung, na a Karai Kasang Yehowa nang hpe hkrang la nit dai mung, nang dum lu na rai ndai: dai re ai majaw ndai lam, dai ni ngai nang hpe hkang da de ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai timung, mayam wa mahtang nang hte na a nta masha ni hpe tsawra nna, nga pyaw dum ai majaw, “Ngai nang na n pru mayu nngai,” nga nna tsun a yang gaw;
  </para>
  <para style="p">
    <verse number="17" style="v" />nang sumprang la nna shi a ana hpe chyinghka hta shatai nna shajut htinggrang ya na rai ndai; shing rai shi gaw prat tup na a mayam tai nga na rai nga ai. Mayam num hpe rai timung, shing di na rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na a mayam shabawn kau na hpe yak dum lu na n rai: kaning rai nme law, kru ning tup na a amu shi galaw nna, nchyang lahkawng a jahpu shayet ya nit dai: na a Karai Kasang Yehowa mung nang galaw ai lam magup hta nang hpe shaman ya na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a sagu dumsu hpung hta na shawng hkrat ai ala nlang na a Karai Kasang Yehowa a matu, nang shachyoi shapra na rai ndai: shawng hkrat ai dumsu kasha hpe nang marang sha lu na n rai; shawng hkrat ai sagu kasha amun rep la lu na n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa lata da ai shara hta, nang hte na a nta masha ni gaw dai hpe shaning shanang na a Karai Kasang Yehowa man e jawm sha lu na rai ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai sagu dumsu ni hta na lagaw hten ai, myi kyaw ai hte lama ma ra nna hkrang n hkum ai rai yang, na a Karai Kasang Yehowa hpe nawng jau lu na n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai gaw na nta e sha lu na rai ndai: atsu aya shan sha ai zawn, san seng ai ni, n san n seng ai ni yawng jawm sha lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung de a asai sha lu na n rai; ntsin ru kau ai zawn aga hta ru kau na rai ndai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abi shata hpe matsing nna, na a Karai Kasang Yehowa a shalai dat ai poi hkan galaw u: kaning rai nme law, na a Karai Kasang Yehowa gaw Abi shata hta nang hpe Egutu mung na shana e shapraw la nit dai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa shi a amying ningsang tawn da na matu lata la ai shara e, sagu dumsu ngu na shalai dat ai poi hkungga, na a Karai Kasang Yehowa hpe nawng jau na rai ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai poi hta matsi rawng ai muk nang sha lu na ndai n rai: nang hkrung nga prat dingsa, Egutu mung na pru wa ai lam hpe nang dum nga lu hkra, sanit ya tup nni nkri ngu na matsi n rawng ai muk nang sha lu na rai ndai: kaning rai nme law, Egutu mung na nang tin shapun pru wa nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sanit ya tup na a mungdan ting hta matsi lang lu na n rai: nnan shana e nawng ai hkungga a shan hpe, shana tup jahpawt du hkra ngam da lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai shara magup hkan e shalai dat ai poi hkungga nawng lu na ndai n rai;
  </para>
  <para style="p">
    <verse number="6" style="v" />na a Karai Kasang Yehowa shi a amying ningsang tawn da na matu lata la ai shara hta sha, shalai dat ai poi hkungga hpe, Egutu mung na pru wa ai ta, shana de, jan shang mahka e nawng lu na rai ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a Karai Kasang Yehowa lata la ai shara hta dai hpe kakang nna sha na rai ndai; jahpawt manap e tinang a sum de bai wa na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kru ya tup matsi n rawng ai muk sha lu na rai ndai; sanit ya hta na a Karai Kasang Yehowa matu chyoi pra ai zuphpawng hpawng na rai ndai: dai shani e makan amu galaw lu na n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai, nhtoi bat sanit ningdaw nang tawn da na rai ndai: nmut nnan shang ai shani kaw nna, nhtoi bat sanit du hkra hti na rai ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai nhtoi gu jang na a Karai Kasang Yehowa a matu bat sanit ngu ai poi mung galaw na rai nna, na a Karai Kasang Yehowa nang hpe shaman ya ai made hta na mayu jaw jau kumhpa la sa na rai ndai:
  </para>
  <para style="p">
    <verse number="11" style="v" />shaloi nang hte na a shayi shadang sha, na a mayam num mayam la, na a mare na Lewi wa, nang kaw shingbyi nga ai tsasam manam wa hte nang kaw nga ai jahkrai nmai, gaida gaina ni yawng, Yehowa shi a amying nsang tawn da na matu san da ai shara hta na a Karai Kasang Yehowa man e sa kabu gara nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang Egutu mung e mayam tai nga rawng nit dai hpe nang dum nga nna, ndai matsun maroi ga hpe hkan shatup nga na rai ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a chyarang na nai mam hte htumbyen na tsabyi jahku shu la tawm jang, sanit ya tup sum poi mung galaw na rai ndai:
  </para>
  <para style="p">
    <verse number="14" style="v" />shaloi e dai poi hta nang hte na a shayi shadang sha, na a mayam num mayam la, dai Lewi wa, tsasam manam hte nang kaw nga ai jahkrai nmai, gaida gaina ni yawng, kabu gara nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa san da ai shara hta, sanit ya tup na a Karai Kasang Yehowa a matu poi galaw na rai ndai: kaning rai nme law, na a sut mayat wa na lam shagu hte, na a lata shachyen ai amu magup hta, na a Karai Kasang Yehowa nang hpe shaman ya na rai nna, nang gaw kabu hkrai kabu nga na rai ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laning mi hta masum lang ngu na, azuma poi, bat sanit poi, sum poi re ai aten ni hta, nanhte hta na lasha ni nlang hte gaw, na a Karai Kasang Yehowa san da ai shara, shi a man e myi man madun lu na rai myit dai: dai shaloi e kadai mung Yehowa man de kaman dawng pru lu na n rai:
  </para>
  <para style="p">
    <verse number="17" style="v" />na a Karai Kasang Yehowa nang hpe shaman ai chyeju jaw ai hte maren, langai hte langai gaw jaw lu ai made shapraw lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mare shagu hta, na a amyu e hkan nna, tara agyi hte du agyi tawn da na rai ndai; shanhte gaw amyu masha ni hpe dingman ai hku tara dara ya na rai mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tara lam hta na nang jashai lu na n rai; masha myi man tau lu na n rai; manawn kumhpa mung sha lu na n rai: kaning rai nme law, manawn kumhpa gaw hpaji rawng ai ni a myit hpe dingga kau ya nna, dingman ai ni a ga hpe gale kau ya chye ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang hkrung nga lu na hte na a Karai Kasang Yehowa nang hpe jaw ai mungdan madu sha lu n ga gaw, dingman ai hku hkrai jeyang lu na rai ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a Karai Kasang Yehowa a matu, nang gaw da ai hkungri a makau e kaning san ai Ashera hpundung mung jung tawn lu na n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a Karai Kasang Yehowa n dawng ai sumla shadaw mung shadun lu na ndai n rai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lama ma ra ai hte hkrang n tsawm ai sagu dumsu gaw, na a Karai Kasang Yehowa hpe nawng lu na n rai: dai zawn re ai hkungga gaw na a Karai Kasang Yehowa matu matsat shabat rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mare ni hta numsha, lasha langai ngai na a Karai Kasang Yehowa a ga shaka hpe tawt nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpara shaje kaw, shing n rai, ngai n hkang da ai ajan, shata hte sumsing lamu na zaw nawng zaw wa langai nga a lam hkan nang nna nawku jaw jau ai hte, shi a man e n shawp ai amu galaw ai rai yang gaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />dai ashi nang hpe shana ya nna nang chye lu jang, dai lam hpe nang azin ayang gawn yu nna, Israela amyu hta dai zawn re ai matsat shabat amu pru ai teng yang gaw;
  </para>
  <para style="p">
    <verse number="5" style="v" />dai n shawp ai amu shapraw ai numsha, lasha hpe, na a mare chyinghka de woi sa nhtawm, dai numsha, shing n rai, dai lasha hpe nlung hte kabai sat kau na rai myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sakse lahkawng masum a ga hte rai yang gaw, si ging ai wa gaw si ai hkrum na rai nga ai: sakse langai sha rai yang chyawm gaw si hkrum lu na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai wa hpe sat na rai yang, sakse ni a lata shawng jahtim nna she, dai hpang amyu masha nlang hte jahtim nang na rai mu ai: shing rai jang, nang kaw na n shawp ai amu seng kau lu na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a mare hta ndang kalang hkat amu ngu ai, bunglat amu, ru hka amu, gasat ningjet amu langai ngai pru nna, amu nau kaba ai majaw nang n sat ya lu yang gaw, nang rawt nhtawm, na a Karai Kasang Yehowa san da ai shara de sa nna,
  </para>
  <para style="p">
    <verse number="9" style="v" />Lewi masha hkinjawng ni hte dai aten e tara agyi galaw ai wa hpang de sa gawn na rai ndai: shanhte mung nang hparan ya na lam madun na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa san da ai shara na ni madun ai tara lam hku hkan nna galaw na rai ndai; shanhte nang hpe sharin ya ai hte maren hkan galaw na rai ndai:
  </para>
  <para style="p">
    <verse number="11" style="v" />shanhte nang hpe madun ai tara hte maren mung, shanhte dawdan ya ai lam hku mung, nang hkan galaw na rai ndai; shanhte madun ai lam hta na pai de hkra de yit lu na n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a Karai Kasang Yehowa man e amu gun hpai ai hkinjawng wa hte tara agyi wa a ga n madat ai, dingsa sa tawt lai ai wa gaw sat kau ai hkrum na rai nna, Israela amyu hta na n shawp ai amu seng kau lu na rai ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi amyu masha ni nlang dai shi na nna, hkrit gari let htawm hpang e tinang myit n hkan ai nga nga na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mungdan hta nang shang nna, madu sha nga lu ai nhtoi hta, “nang gaw Nye a grup yin na masha amyu ni zawn ngai mung nye a ntsa e hkawhkam langai mi tawn da na nngai,” nga nna tsun ndai rai yang;
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a Karai Kasang Yehowa lata la ai wa, na a hkawhkam teng teng tai na rai nga ai: na a amyu hpunau wa hpe sha hkawhkam aya jaw lu na rai ndai; na a hpunau n re ai, maigan masha wa hpe na a hkawhkam shatai lu na n rai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai timung, dai hkawhkam wa gaw gumra rem mai ai n rai; gumra law law lu la hkra nga, mung masha ni hpe Egutu mung de nhtang shangun lu na n rai: kaning rai nme law, “Dai lam de nanhte galoi mung nhtang lu na myit dai n rai,” nga nna Yehowa nanhte hpe tsun sai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi a myit masin lam n dam lu ga, num law law mung la tawn lu na n rai; aja gumhpraw mung law wa mahkawng da lu na n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hta kaga dai wa gaw shi a shu mashi shu masha prat dingsa, Israela amyu a mungdan hta asak galu kaba nga lu hkra, shi a Karai Kasang Yehowa hpe hkrit hkungga nga nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />ndai tara matsun maroi nlang shatsup lu hkra sharin na hte, shi a kahpu kanau ni hta gumrawng gumra n re ai sha, hkang da ai lam hta na apai ahkra n yit na matu,
  </para>
  <para style="p">
    <verse number="20" style="v" />shi a mungdan a tingnyang ntsa dung nga lu ai shaloi, Lewi masha hkinjawng ni a lata e nga ai, ndai tara laika hpe shabawn mi ka htawt la nna, dai hpe lang nga let, shi hkrung nga ai prat dingsa hte matsing nga na rai wu ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lewi masha hkinjawng ni ngu ai Lewi amyu ting gaw Israela amyu gale zawn kumhtaw hte sali wunli n lu ma ai rai nna, Yehowa hpe jaw jau ai wan nat hkungga hte shi a sali wunli shanhte sha na rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna shanhte gaw hpunau ni zawn sali ga madu lu ai n rai: shanhte hpe tsun da ai hte maren Yehowa gaw shanhte a sali wunli rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mung masha ni hkungga jaw ai shaloi dumsu hta na rai timung, sagu hta na rai timung, hkinjawng wa a kumhtaw matu jaw na tara gaw ndai rai nga ai: jaw jau ai wa gaw hkinjawng wa hpe lahpa magyi mi, shabyi lahkawng maga hte pu hpam pu kan mung;
  </para>
  <para style="p">
    <verse number="4" style="v" />shawng shu la ai nai mam, tsabyi jahku hte namman mung; shawng rep ai sagu mun mung jaw na rai wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, shi hte shi a kashu kasha prat dingsa Yehowa a amying hte shi a magam gun hpai na matu, na a Karai Kasang Yehowa, na a nhpu nnau ni nlang hta na shi hpe lata la nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israela mung ting a mare ni hta shingbyi manam nga ai Lewi wa langai ngai, nja nhpra myit kaba hte Yehowa lata la ai shara de du sa yang,
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa a man e tsap nga ai Lewi hpunau ni nlang hte maren, shi a Karai Kasang Yehowa a mying hte shi amu gun hpai lu nna;
  </para>
  <para style="p">
    <verse number="8" style="v" />shi a sali wunli dut nna lu ai arai hta kaga hpunau ni hte maren hkam sha lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mung hta nang shang sha lu ai shaloi, dai mung e nga ai masha amyu ni galaw ga ai matsat shabat lam hkan galaw na nga, nang sharin la lu na n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tinang a shayi shadang sha hpe wan hta nat nawng ai wa, shaba wawt ai wa, myihtoi htoi ai wa, lawng dat chye ai wa, mandan bau chye ai wa,
  </para>
  <para style="p">
    <verse number="11" style="v" />ahkyu hkyu chye ai wa, atsu hte shaga chye ai wa, shung sha chye ai wa hte gumhpan hpan ai wa langai mi muk nanhte hta nga lu na n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaning rai nme law, ndai lam galaw ai wa kadai mung Yehowa man e matsat shabat rai nga ai: dai matsat shabat lam a majaw, na a Karai Kasang Yehowa dai amyu ni hpe na a man na shachyut kau wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw na a Karai Kasang Yehowa man e hkum tsup nga na rai ndai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang madu lu na rin dai amyu ni gaw myihtoi htoi ai ni hte shaba wawt ai ni a ga madat ai ni rai ma ai: nang chyawm gaw shing rai galaw na, na a Karai Kasang Yehowa ahkang n jaw ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a Karai Kasang Yehowa gaw, ngai zawn re ai myihtoi langai mi, na a hpunau ni hta na, na a matu paw pru shangun na ra ai: dai wa a ga nanhte madat lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Horeb bum e hpawng ai shani e, nang tsun ndai gaw, “Ngai n si n ga, ya hpang de nye a Karai Kasang Yehowa a nsen ngai bai n na lu ni ga, dai wan kaba hpe mung ngai bai n mu ni ga,” nga nna na a Karai Kasang Yehowa hpe hpyi nem ndai hte maren,
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa mung, “shanhte tsun ai ga htuk nga malu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte a kahpu kanau ni hta na nang zawn re ai myihtoi langai mi, shanhte a matu ngai paw pru shangun na we ai rai nna, dai wa a n-gup hta nye a ga ngai hti bang na hte, ngai hkang da mada hte maren shi shanhte hpe htawn tsun na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai wa nye a mying ningsang hte htawn tsun ai nye a ga hpe, kadai wa n madat yang, dai wa hpe ngai deng na we ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rai timung, ngai n hkang da ai, nye a ahkang hpyi hpun nna nden ja ai hte tsun pru ai myihtoi mung, Hpara shaje a amying hte tsun pru ai myihtoi mung, si lu na rai nga ai,” nga nna ngai hpe tsun ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Yehowa tsun ai ga re ai n re ai gaw, anhte kaning di chye ginhka lu na rai ta?” nga nna nang myit ung ang n yang,
  </para>
  <para style="p">
    <verse number="22" style="v" />dai myihtoi wa Yehowa a amying gang nna tsun ai hku amu n byin, shi tsun ai ga n dik lu yang gaw, dai gaw Yehowa tsun ai ga n rai nga ai: dai myihtoi wa nden ja ai hte gaw tsun nu ai: nang shi hpe hkrit ra ai n rai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mungdan hta nga nga ai masha amyu ni hpe, na a Karai Kasang Yehowa jahtum kau wu ai rai nna, shanhte a shara hta nang shang lu ai hte, shanhte a mare ni, shanhte rawng nga ai nta ni hta nang rawng nga lu ndai shaloi,
  </para>
  <para style="p">
    <verse number="2" style="v" />na a Karai Kasang Yehowa nang hpe madu sha shangun ai mungdan a kata e mare masum nang san da na rai ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masha sat hkrup ai kadai mung, dai de hprawng lu hkra, na sali wunli matu na a Karai Kasang Yehowa nang hpe jaw ai mungdan hpe, masum hpai di karan nna, nmaw lam ni hpe mung gram kau na rai ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha sat hkrup nna tinang asak lawt hkra dai de hprawng lu na wa a lam gaw ndai rai nga ai: masha langai ngai hpun kran na nga manang wa hte nam de sa nna,
  </para>
  <para style="p">
    <verse number="5" style="v" />hpun kran nga yang nwa malaw gan wa ai hte manang wa hpe hkra ai majaw, manang wa hpe si hkra sat kau ai hku shang yang, n dawng ai myit hte n re ai she manang wa hpe hkala sat kau ai wa gaw, dai mare langai ngai de hprawng shingbyi lu na rai nna, shi asak lawt na ra ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />dai n rai yang gaw, matai htang ai wa pawt bu nga yang, dai wa hpe hkan shachyut nna, hprawng lam tsan ai majaw hkan dep yang sat kau na ra ai: shing mai rai na n rai; kaning rai nme law, shi gaw manang wa hpe n dawng ai myit n rawng ai majaw sat kau hkrum ging ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai re ai majaw mare masum nang san da na lam ngai nang hpe hkang da de ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ni ngai nang hpe hkang da mada ga mahkra shatup let, na a Karai Kasang Yehowa hpe tsawra ai myit hte shi a lam hta tutnawng hkan nga ai hta mung;
  </para>
  <para style="p">
    <verse number="9" style="v" />na a Karai Kasang Yehowa na nji nwa ni hpe jaw na nga ndat da ai mungdan nlang nang hpe jaw nna, na nji nwa ni hpe dagam da sai hte maren, na a mungdan hpe maden dat ya n yang mung;
  </para>
  <para style="p">
    <verse number="10" style="v" />na a Karai Kasang Yehowa na a sali wunli matu jaw ai mungdan hta n si ging ai wa si ai hkrum nna, masha sat ai yubak na a ntsa e n du lit ga gaw, ya tsun ngut sai mare masum hta kaga, mare masum naw jat san da na rai ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lam mi gaw manang wa hpe n dawng ai myit hte gyam nna shi hpe si hkra anu kayat ai wa, dai mare langai ngai de hprawng nna du lu hkra rai timung,
  </para>
  <para style="p">
    <verse number="12" style="v" />shi nga ai mare na agyi salang ni gaw masha shangun nna, dai wa hpe woi la nhtawm, shi si lu na matu, matai htang ai wa a lata hta ap kau na rai mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a myi gaw shi hpe matsan yu dum lu na n rai; nang ngamu ngamai lu n ga, masha sat ai yubak hpe Israela amyu hta na seng kau na rai ndai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang madu sha lu na matu na a Karai Kasang Yehowa nang hpe jaw na mungdan e nang lu la ai sali ga hta, moi na ni jung tawn ai htingbu wa a arit bandung hpe tawt kau ya lu na n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Marai langai ngai a galaw shut ai mara, tawt lai kau ai yubak sagawn yu n yang, sakse langai sha hte ngut lu na n rai: sakse lahkawng masum a n-gup ga hte rai yang she grin lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />N teng n man ai sakse wa langai ngai, masha wa a lam n teng n man ai hku mara shagun ai rai yang,
  </para>
  <para style="p">
    <verse number="17" style="v" />amu rawng ai yan shan lahkawng Yehowa a man e, dai prat na hkinjawng ni hte tara agyi ni hpang de sa jeyang na rai nna;
  </para>
  <para style="p">
    <verse number="18" style="v" />dai tara agyi ni azin ayang sagawn yu yang, dai sakse wa masu ai sakse rai nga ai rai nna, shi manang wa a lam n teng n man ai sakse hkam ai teng yang gaw;
  </para>
  <para style="p">
    <verse number="19" style="v" />shi a manang wa hpe di maw ai hku hkan nna shi hpe mahtang di na rai ndai: shing rai n shawp ai yubak nang kaw na seng kau na rai ndai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi masha gale ni mung dai na nna hkrit ai hte htawm hpang de dai zawn re ai amu n shapraw ai nga na mara ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a myi gaw shi hpe matsan yu dum lu na n rai; asak a matu asak, myi a matu myi, wa a matu wa, lata a matu lata, lagaw a matu lawgaw, matai htang ya na rai ndai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha hpyen ni hpe nang gasat sa wa ndai shaloi, gumra hte hpyen leng ni hpe mung, nang hta grau law ai masha ni hpe mung nang mu lu yang, nang shanhte hpe hkrit lu na n rai: kaning rai nme law, nang hpe Egutu mung na shaw woi wa ai, na a Karai Kasang Yehowa gaw nang hpang maga rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpyen de htim na rai jang, hkinjawng wa gaw sit sa nna masha ni hpe ning ngu na rai wu ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Israela amyu e, madat u; masha hpyen ni hpe gasat na dai ni nanhte hkyen ngut manit dai: dai rai nna shanhte a majaw, myit hkum htum et; hkum hkrit, hkum gari, hkum kajawng hkum ma myit:
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, nanhte a Karai Kasang Yehowa gaw, masha hpyen ni hpe manga kau nna, nanhte hpe hkye la na nga, nanhte hte rau sa wa nga ai,” ngu na rai wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai hpyen du ni mung masha ni hpe, “Nta gap nna dingshawn garai n shang ai, kadai lawm nga a ta? dai wa gaw nta de wa u ga; dai n rai, majan e si dam yang, masha wa e shang la kau na, tsang ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tsabyi sun hkai nna asi garai n di sha lu ai, kadai lawm nga a ta? dai wa gaw nta de naw wa u ga; dai n rai, majan e si dam yang, masha wa e dai si hpe sha kau na, tsang ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Num mahtan da nna garai n hkungran ai, kadai lawm nga a ta? dai wa gaw nta de naw wa u gaw; dai n rai, majan e si dam yang, num dai hpe masha wa e la kau na, tsang ra ai,” ngu na rai mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai hpyen du ni gaw, Hkrit ai myit rawng nna myit htum ai masha kadai lawm nga a ta? dai wa gaw nta de wa u ga; dai n rai yang, shi a majaw, manang ni mung myit htum mat na, tsang ra ai, ngu nna masha ni hpe naw tsun na rai mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hpyen du ni gaw dai tsun ngut jang, masha ni hpe woi awn na matu hpyen du karan san na rai ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mare langai ngai hpe gasat na du sa wa ndai shaloi, htinglu htinglai na lam nang shawng tsun na rai ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai mare na ni htinglu na hku htan nna, mare chyinghka hpaw ya ma yang gaw, dai mare na masha nlang nang kaw jahkawn bang nna, na a amu gun hpai lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai n rai, htinglu ga n tsun ai sha, nang hpe hkap gasat ma yang gaw, dai mare hpe nang wang tawn nna,
  </para>
  <para style="p">
    <verse number="13" style="v" />na a Karai Kasang Yehowa na a lata de ap ya ndai shaloi, lasha nga manga hpe nhtu hte sat kau na rai ndai:
  </para>
  <para style="p">
    <verse number="14" style="v" />numsha hte ma kaji ni, yamnga ni hte mare e mu la ai arai nga manga hpe tinang a matu nang magawn la nna, na a Karai Kasang Yehowa jaw ai, nang hpe hpyen ai wa kaw na lu la ai lanep hpe nang sha lu na rai ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ndai amyu ni nga ai mare ni hta shing di na rai ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a Karai Kasang Yehowa na a sali wunli matu jaw ai ndai amyu ni nga ai mare ni hta na nsa sa chye ai shinggyim masha langai mi hpe muk jahkrung da lu na n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiti, Amori, Kanani, Perizi, Hiwi hte Yebusi masha ni, shanhte a Hpara hta galaw ai matsat shabat lam nanhte hpe sharin ya nna, nanhte a Karai Kasang Yehowa hpe n shut myit ga,
  </para>
  <para style="p">
    <verse number="18" style="v" />nanhte a Karai Kasang Yehowa hkang da sai hte maren, masha amyu ndai ni hpe atsai awai shamyit kau na rai myit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mare langai ngai hpe gasat la na nga, na na wang tawn n yang gaw, hpun ni hpe nang kran kau lu na n rai; kaning rai nme law de a namsi hpe nang sha lu na majaw kran kau lu na ndai n rai: masha hpe she wang ai rai yang, nam na hpun hpe wang ai rai wa sa ni?
  </para>
  <para style="p">
    <verse number="20" style="v" />Asi n sha ai hpun ni hpe chyawm gaw, nang kran lu nna, nang gasat ai mare dang la lu ai du hkra, grup yin dap kum na matu, jahten lu na rai ndai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mungdan hta shara ra mi kaw masha mang mu hkrup nna, kadai sat ai re ai n chye yang;
  </para>
  <para style="p">
    <verse number="2" style="v" />nang kaw nga ai salang ni hte na a tara agyi ni pru sa nna, dai shara a grup yin nga ai mare ni de shadawn wa na rai ma ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />si mang taw ai shara hte grau ni ai mare na salang ni gaw, daw garai n shagun, garai n marang sha yu ai dumsu upra la nna,
  </para>
  <para style="p">
    <verse number="4" style="v" />hkauna n galaw, nli n hkai ai hka lawt ai hkaraw de dun sa nhtawm, dai hkaraw e nga ai hpe du abyen daw ya na rai mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lewi a kashu kasha hkinjawng ni mung sit sa na rai ma ai: kaning rai nme law, na a Karai Kasang Yehowa amu gun hpai na hte shi a amying nsang hta shaman ya na matu Yehowa shanhte hpe lata la nu ai rai nna, ndang kalang hkat ai amu shagu hte anu hkat ai amu shagu hpe shanhte a ga hte shangut lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Si mang taw ai shara hte grau ni ai mare na agyi salang ni gaw dai hkaraw e abyen sat ai nga upra a ntsa e tinang a lata shin kau let,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Anhte a lata gaw sai ndai n jahkaw ga ai, anhte a myi gaw ndai n mu ga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, nang hkye hkrang la ai amyu Israela hpe matsan dum e law; n si ging ai wa hpe sat ai yubak gaw na a amyu Israela a ntsa e hkum shagun myit law,” ngu nna htan tsun na rai mu ai. Shing di jang, masha sat ai yubak hta na lawt na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai Yehowa a man e dinghpring ai hku galaw jang, n si ging ai wa a asai hpe nang hta na kashin kau lu na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang masha hpyen ni hpe sa gasat nna, na a Karai Kasang Yehowa shanhte hpe na a lata hta ap kau ai hte nang shanhte hpe rim la lu ndai shaloi,
  </para>
  <para style="p">
    <verse number="11" style="v" />nang rim la ai bawng ni hta ahpraw tsawm ai num hpe mu nna, shi hpe tsawra ai hte na a madu jan shatai mayu n yang gaw,
  </para>
  <para style="p">
    <verse number="12" style="v" />na a nta de shi hpe woi wa nhtawm, shi a kara shangun, lamyin doi kau ai hte,
  </para>
  <para style="p">
    <verse number="13" style="v" />rim la yang na hpun palawng shi raw kau nna, shata mi tup kanu kawa hpe hkrap let na nta e nga nga shangun na rai ndai: dai hpang shi hpe kahkyin la na rai nna shi gaw na a madu jan tai na rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Htawm hpang e nang shi hpe n tsaw n yang gaw, shi a myit machyu shangun na rai ndai: shi hpe arawng jahpoi kau nit dai majaw, shi hpe dut lu na n rai, mayam hku shangun sha lu na n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Masha langai ngai num lahkawng lu nna, langai mi hpe tsawra nhtawm, langai mi hpe n tsaw n ra wu ai; dai lahkawng yan kasha shaprat ai hta shawng shangai ai alat gaw n tsaw num a kasha mahtang re ai rai yang;
  </para>
  <para style="p">
    <verse number="16" style="v" />dai la wa gaw shi a sali wunli karan ya ai shani e, n tsaw num hta na alat hpe shagrit nna, tsaw ai num a kasha hpe alat aya jaw lu na n rai:
  </para>
  <para style="p">
    <verse number="17" style="v" />n tsaw ai num a kasha hpe alat aya yin nna, sali wunli htam lahkawng jaw na rai wu ai: kaning rai nme law, dai wa mahtang she kawa n-gun ningshawng rai nga ai rai nna, alat aya gaw shi a rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Masha langai ngai n shawp ai hte n hkru myit rawng nna kanu kawa shaga n madat ai kasha, kanu kawa gade sharin timung, sharin n lu ai kasha lu ai rai yang,
  </para>
  <para style="p">
    <verse number="19" style="v" />kanu yan kawa gaw kasha hpe dun nna, mare na agyi salang ni nga ai shi a mare chyinghka de woi sa nhtawm:
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ndai an a kasha gaw n shawp ai hte n hkru ai myit rawng nna, an kanu kawa shaga n madat ai ma rai mali ai: lu lai, sha lai ma-mung rai mali ai,” ngu nna mare na agyi salang ni hpe tsun na rai mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi mare na lasha ni nlang hte gaw dai kasha hpe nlung hte kabai sat kau na rai ma ai: shing di nang hta na n shawp ai yubak seng kau nna, Israela amyu nlang hte gaw dai shi na ai hte hkrit kang nga na mara ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Masha langai ngai si ging ai yubak galaw ai majaw sat kau ai hkrum nna, hpun hta noi tawn ai rai yang,
  </para>
  <para style="p">
    <verse number="23" style="v" />na a Karai Kasang Yehowa nang hpe sali wunli jaw ai mungdan awu asin n hkrum na matu, dai wa a si mang hpe dai shani jang, ga hta teng teng lup kau na rai ndai; hpun hta shana tup noi da lu na n rai: kaning rai nme law, noi kau hkrum ai wa gaw, Karai Kasang kaw na dagam dala hkrum ai wa rai nga ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na hpunau wa a sagu dumsu lam dam ai hpe nang myi matu yu nna da lu na n rai: na a hpunau wa hpang de teng teng sa sa ya na rai ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a hpunau wa hte tsan ai rai yang mung, shi hpe n chye ai rai yang mung, dai sagu dumsu hpe na nta de gawt wa na rai ndai; na hpunau wa tam pru nna, shi a lata de ap ya ai nhtoi du hkra na a nta e rem da na rai ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lawze rai timung, hpun nba rai timung, na a hpunau wa a rai lama ma mat nna nang mu ya yang, myi matu n yu ai sha, dai hte maren hkap ya na rai ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na nhpu nnau wa a lawze, utang, lam e kataw nga ai hpe myi matu yu nga lu na n rai: shi hpe nang teng teng sharawt karum na rai ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Numsha gaw ala a hpun palawng bu hpun lu na n rai; lasha mung anum hpun palawng bu hpun lu na n rai: dai lam galaw ai ni gaw na a Karai Kasang Yehowa a man e matsat shabat rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hpun ndung e rai timung, ga e rai timung u kanu gaw u tsip hta udi shing n rai, u hkai hkalung hpum nga ai hpe mu hkrup yang, u kanu hpe kasha ni hte hpawn la kau lu na n rai:
  </para>
  <para style="p">
    <verse number="7" style="v" />nang ngamu ngamai nna asak galu lit ga, kasha ni hpe la kau n yang mung, kanu hpe teng teng dat dat na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nta magaw na masha hkrat ai a majaw, na nta hta masha sat ai yubak n du lit ga, nang nta nnan galaw ai shaloi, nta magaw ntsa hpe makau grup hkum ban na rai ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a tsabyi sun hta amyu gale nli hkai kayau lu na n rai; shing di yang, dai nli gale a asi hte tsabyi si lahkawng yan nawng, nawku shara hta sum kau lu na rai ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Utang hte lawze hpe dwi nna yi galau lu na n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sagu hte lachyit kayau da ai hpun palawng bu hpun lu na n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang lawai ai nba a matu mali maga de shingman madat da na rai ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Masha langai ngai num la nna hkungran nga sha ngut ai hpang, dai num hpe bai n tsaw nna,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Ngai ndai num hte nga sha we yang, shi a hkawn jet kumla ngai n mu we ai;” nga nna dai numsha hta kaya shara shapraw ai hte shi a arawng jahpoi ya ai rai yang;
  </para>
  <para style="p">
    <verse number="15" style="v" />dai numsha a kanu kawa ni gaw kasha jan a hkawn jet sakse ngu na kumla la lang let, mare chyinghka e nga ai du gyi salang ni hpang de sa nhtawm:
  </para>
  <para style="p">
    <verse number="16" style="v" />dai mahkawn a kawa gaw agyi salang ni hpe, “Ndai wa hpe nye a shayi sha ngai ya sha we ai; shi gaw nye a shayi sha hpe n dawng n yawt nna,
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Na a shayi sha hta hkawn jet kumla ngai n mu we ai,’ nga nna kaya shara shapraw ya nngai: rai timung, yu mu, ndai gaw nye a shayi sha a hkawn jet kumla rai nga li ai,” ngu nna tsun nhtawm, mare na agyi salang ni a man e dai nba hpyan dan na rai wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi dai mare na salang ni gaw dai la wa hpe kayat nhtawm,
  </para>
  <para style="p">
    <verse number="19" style="v" />gumhpraw joi mi shawa nna num jan a kawa hpe jaw na rai wu ai: kaning rai nme law, Israela amyu shayi sha a arawng hpe shi jahpoi nu ai: dai numsha mung shi a madu jan tai nga lu na rai nna prat tup hka lu na n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing n rai, la wa a ga mahtang teng nna, dai numsha hta hkawn jet kumla n nga lu yang gaw;
  </para>
  <para style="p">
    <verse number="21" style="v" />numsha dai hpe kawa nta chyinghka de shanhte woi wa nna, dai mare na lasha ni nlang shi hpe nlung hte kabai sat na rai mu ai; kaning rai nme law, shi gaw kawa nta e nga nga yang shawa num tai nna, Israela amyu hta n htap ai lam galaw nu ai: shing di nang hta na n shawp ai amu, nang seng kau na rai ndai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dinghku num hte kaga la wa shut nga ai mu hkrup yang, dai la wa hte num jan, shan lahkawng gaw sat kau ai hkrum lu na rai nga ai: shing di, Israela amyu hta na n shawp ai yubak seng kau na rai ndai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mahkawn langai ngai masha wa sa mahtan tawn sai hpang e la kaga hte mare e hkrum nna shut hpyit nga ai rai yang,
  </para>
  <para style="p">
    <verse number="24" style="v" />shan lahkawng hpe mare chyinghka de woi shapraw nna, nlung hte kabai sat na rai myit dai: num jan mung mare e rai nga yang, n jahtau wu ai majaw, la wa mung masha num hpe shut ya ai majaw, sat kau ai hkrum lu na rai ma ai: shing di nang hta na n shawp ai amu nang seng kau na rai ndai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rai timung, la wa gaw, dai mahtan tawn sai mahkawn hpe pa hkan e adip akrip di nna shut ai rai yang gaw la wa hkrai sha si lu na rai nga ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />dai mahkawn hpe hpa mung di lu na n rai; shi hta si ging ai yubak n nga lu ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />kaning rai nme law, la wa dai numsha hpe lam e hkrum nna num jan jahtau timung, hkye la na masha n nga ai majaw, dai gaw masha shada sat hkat ai amu zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Masha garai n mahtan tawn ai mahkawn hpe la langai ngai rim la nna shut hpyit nga ai mu yang,
  </para>
  <para style="p">
    <verse number="29" style="v" />dai la wa gaw num jan a kawa hpe gumhpraw manga shi wa lu na rai wu ai; shi hpe arawng jahpoi kau wu ai majaw dai numsha mung shi a madu jan tai na rai nga ai: shi hpe prat tup jahka lu na n rai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kadai mung tinang a kawa hte seng ai, kawa a madu jan hte nga sha lu na n rai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sat kau ai, shing n rai, daw kau ai a majaw lasha hkrang n hkum mat ai lasha kadai mung, Yehowa a shawa hpawng hta lawm lu na n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />N-gyi ma kadai mung, Yehowa a shawa hpawng hta lawm lu na n rai: shi a kashu kasha prat shi du hkra Yehowa a shawa hpawng hta lawm lu na n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ammon amyu hte Moba amyu masha mung Yehowa a shawa hpawng hta shang lu na n rai;
  </para>
  <para style="p">
    <verse number="4" style="v" />nanhte Egutu mung na pru wa ai shaloi, muk hte ntsin gun nna n tau la ma ai majaw mung, nanhte hpe dagam na Mesopotami mung, Pehtora mare na Beora kasha Balam hpe shaga mu ai majaw mung, shanhte hta kadai mung prat shi n du dingsa Yehowa a shawa hpawng hta lawm lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai timung, na a Karai Kasang Yehowa gaw Balam a ga n hkan ai sha, na a Karai Kasang Yehowa nang hpe tsawra wu ai majaw, dagam ai lam hpe shaman ai shatai kau wu ai,
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai re ai majaw, shanhte a ngamai wunli lam, shanhte a sutgan law wa nhpang hta galoi mung shadaw ya lu na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Edom masha hpe chyawm gaw n ju n yawt rai lu na n rai; shi gaw na hpunau wa rai nga ai: Egutu masha hpe mung n ju n yawt rai lu na n rai: nang shi a mungdan hta manam tai nga yu nit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shan a amyu matu gaw prat masum du jang she Yehowa a shawa hpawng hta shang lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang masha hpyen ni hpe gasat na sa wa ndai shaloi, n san n seng ai lam shagu koi gam na rai ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shana e byin chye ai n san n seng ai lam a majaw, n san n seng ai wa nanhte hta lawm yang, dai wa gaw dap shinggan de pru nga na rai wu ai; dap kata e nga lu na n rai:
  </para>
  <para style="p">
    <verse number="11" style="v" />jan du jang, shi hkum shin kau nna, jan shang jang she, dap de shang na rai wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a nam sa shara mung, dap shinggan e rai lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang lang ai hpyen arai ni hta shingban kaji mung nang shalawm nna dap shinggan de nang hkum sa tsan yang dai hte htu nhtawm na a shat sa hpe bai kaput kau da na rai ndai:
  </para>
  <para style="p">
    <verse number="14" style="v" />kaning rai nme law, na a Karai Kasang Yehowa, nang hpe hkye la nna, masha hpyen ni hpe na a lata hta ap kau na nga, na a dap e hkawm nga ai: dai re ai majaw nang kaw na n san n seng ai lama ma mu nna, nang hpe n koi kau da n ga gaw, na a dap chyoi pra nga na rai lit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu kaw na nang kaw hprawng pru ai mayam hpe madu a lata de bai ap ya lu na n rai:
  </para>
  <para style="p">
    <verse number="16" style="v" />dai wa gaw, shi nga mayu ai shara na a mare langai ngai hta nang kaw shingbyi nga lu na rai nga ai; shi hpe zingri zingrat di lu na n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israela amyu shayi sha ni hta na hpara shawa num da lu na n rai; Israela amyu shadang sha ni hta na mung hpara shaw la da lu na n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shawa num shabrai gumhpraw hte, gwi shabrai gumhpraw hpe ga shaka raw na matu, na a Karai Kasang Yehowa a htingnu de shawn lu na n rai: shing re ai gumhpraw amyu lahkawng gaw na a Karai Kasang Yehowa a man e, matsat shabat re ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a mayu shada, gumhpraw, shahpa hte hkoi shap ai hpa baw hta mung, atu amyat hpyi lu na n rai:
  </para>
  <para style="p">
    <verse number="20" style="v" />maigan masha hpe chyawm gaw hpyi lu na rai myit dai: nang shang sha na rin dai mungdan e nang galaw ai lam magup hta na a Karai Kasang Yehowa nang hpe shaman ya n ga gaw, na amyu shada atu amyat hte hkoi shap ai lam koi gam na rai ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a Karai Kasang Yehowa hpe ga shaka da n yang gaw, dai hpe lau n shatup ai hkring nga lu na n rai; kaning rai nme law, na a Karai Kasang Yehowa gaw nang kaw dai lam teng teng hpyi na rin dai: n shatup n yang gaw nang hta yubak pru na ra ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ga shaka da ai n rai yang chyawm gaw, yubak pru na n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na a Karai Kasang Yehowa hpe na a myit ra ai hku hte maren nang ga shaka tawn da nit dai rai nna, tinang n-gup hte tsun sai ga hpe nang shagrin lu na hte, da ngut sai ga hte maren galaw lu na rai ndai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a htingbu manang wa a tsabyi sun de nang shang n yang, nang hkru hkra sha lu nga ai; rai timung gun na lawm hkra la lu na n rai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Htingbu wa a yi hkauna hta shang n yang, mam nsi hpe lata hte di sha mai nga ai; rai timung, nhkyau hte dan la lu na n rai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />La langai ngai num la nna nga sha nhtawm, dai numsha hta mara shagun shara lama ma rawng nna, myit n htuk lu yang gaw jahka ai laika jaw nna dat dat na rai wu ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />shaloi dai numsha gaw madu wa a nta na pru wa ai hpang, lasha kaga kaw wa lu na ahkang nga nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpang na la wa mung shi hpe n ra ai majaw, jahka ai laika jaw nna shabawn kau ai rai yang rai, dai madu wa si mat ai rai yang rai,
  </para>
  <para style="p">
    <verse number="4" style="v" />shawng na madu wa dingsa gaw dai n san n seng sai num hpe bai hta num la na n rai: dai gaw Yehowa man e matsat shabat rai nga ai: na a Karai Kasang Yehowa nang hpe sali wunli jaw ai mungdan hta yubak mara shapraw lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dinghku ningnan shang sha ai wa gaw, majan gasat sa lu na n rai; du ni a magam mung gun hpai lu na n rai: laning mi tup tinang a nta e san san nga nna, madu jan hpe bau maka nga na rai wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Htumrin hpe nang tang la ya lu na n rai; ntsa magap lung pyi la ya lu na n rai: kaning rai nme law, dai gaw masha asak tang la ai hku ang nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masha langai ngai tinang hpunau Israela amyu hpe lagu la nna, mayam yam ai, shing n rai dut sha ai rai yang, dai lagut wa hpe sat kau na rai ndai: shing di nang hta na n shawp ai amu nang seng kau na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Manggang ana lam hta, Lewi masha hkinjawng ni nang hpe madun na ra ai hku hkan nna galaw lu na, sadi nga u: ngai shanhte hpe hkang da ai hku hte maren nanhte galaw lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Egutu mung na nanhte pru nna lam e hkawm sa wa nga yang, na a Karai Kasang Yehowa Meriam hta shakap ai lam hpe dum nga u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a htingbu wa hpe lama ma hkoi ya ai rai yang, shi tang kau sai rai la na nga, shi a nta nhku de shang lu na n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang shinggan e tsap nga nna, dai wa gaw shi tang ai rai shinggan de nang kaw la shapraw na rai wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai wa matsan la ai rai yang gaw, shi tang kau ai rai hpe bai n ya ai nhtoi jahtoi lu na n rai:
  </para>
  <para style="p">
    <verse number="13" style="v" />shi gaw tinang a hpun nba hpun let yup pyaw lu nna, nang hpe shaman ya n ga, shi tang tawn ai arai hpe jan garai n du yang teng teng bai ya lu na rai ndai: dai gaw na a Karai Kasang Yehowa a man e dinghpring ai amu rai na ra ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a hpunau hta na rai timung, nang kaw sa shingbyi nga ai amyu kaga ni hta na rai timung, matsan mayan re ai hte n lu n lawm nna nchyang chyang ai wa hpe adip akrip di lu na n rai;
  </para>
  <para style="p">
    <verse number="15" style="v" />shani shagu na, shi a shabrai jaw lu na rai ndai; n jaw ai jan hkum shadu et: kaning rai nme law, shi ga matsan ai majaw lu la ging ai shabrai hpe sha myit mada nga na ra ai: n jaw ai nga n yang gaw na a majaw Yehowa hpe shi jahtau nna nang hta mara rawng na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kasha ni a majaw kawa, kawa a majaw kasha si ai hkrum lu na n rai: kadai mung tinang a mara hte sha si ai hkrum lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ndang kalang hkat ai amu hta amyu kaga wa hte jahkrai nmai ma hpe jasum lu na n rai; gaida jan a hpun palawng hpe tang la kau lu na n rai:
  </para>
  <para style="p">
    <verse number="18" style="v" />Egutu mung e nang yam nga yu nit dai mung, na a Karai Kasang Yehowa dai kaw na nang hpe hkrang shaw wa nit dai mung, nang dum nga lu na rai ndai: dai re ai majaw ndai tara matsun ngai nang hpe tawn da ya se ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a yi hkauna hta nsi naisi shu la ai shaloi, malap kau da sai hkauling hpe bai hta la lu na n rai; nang galaw ai lam magup hta na a Karai Kasang Yehowa nang hpe shaman ya n-ga gaw, dai hpe amyu kaga wa, jahkrai nmai, gaida gaina ni a matu ngam da lu na rai ndai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na a tsanlun si hpe kayat sharun la ndai shaloi, naw si ngam ai tsanlun si hpe bai kayat sharun la lu na n rai: dai gaw amyu kaga wa, jahkrai nmai, gaida gaina ni a matu ngam da na rai ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a tsabyi sun na tsabyi si di la ndai shaloi, nlim bai gut lu na n rai; dai gaw amyu kaga wa, jahkrai nmai, gaida gaina ni a matu tai na rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Egutu mung e nang yam nga yu sai hpe dum lu na rai ndai: dai re ai majaw ndai tara matsun ngai nang hpe tawn da ya se ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Marai lahkawng shada amu rawng ai majaw, tara agyi ni kaw sa shawk nna, tara agyi ni shan a lam hparan yang, dingman ai wa hpe sha-awng nna, n dingman ai wa hpe jasum na rai mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />N shawp ai wa shingna hkrum ging ai rai yang, tara agyi wa gaw dai wa hpe shi a man e shagum tawn nna, shi a mara hte ging ai made kayat shangun na rai wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mali shi lang tup shi hpe kayat na mai nga ai; rai timung, dai hpe lai lu na n rai: dai hta lai nna law wa kayat yang gaw, na a hpunau wa hpe na a man e nau wa n jahpu ai hku tai na lit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mam kabye nga ai nga n-gup hpe magum ya lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nta langai sha na shan hpu shan nau ni hta langai wa mi matu mara n nga ai si mat yang, dai si ai wa a gaida hpe masha kaga hta lu na n rai: shi a karat gaw shi hpe hta kahkyin la nna, karat hpe lashum ang ai hte maren lashum na rai wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai Israela amyu hta kahpu a amyu matu n mat hkra, shawng shangai ai kasha gaw si mat sai kawa di a matu mara tai na rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kanau wa mahtang karat hpe n hta hkraw ai rai yang, dai numsha gaw agyi salang ni nga ai mare chyinghka de sa nna, “nye a karat wa gaw, kahpu wa a amying hpe Israela amyu hta n matut mayu nga ai; lashum lanoi ang ai hte maren, n shum n noi hkraw nga ai,” ngu nna sa tsun dan na rai wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi mare na agyi salang ni gaw dai wa hpe shaga la nna san yu na rai mu ai: shi mung, “Num ndai hpe ngai n hta mayu nngai,” nga nna ndang ting ting re ai rai yang gaw;
  </para>
  <para style="p">
    <verse number="9" style="v" />dai numsha, agyi salang ni a man e shi kaw sit sa nna shi a kyepdin raw kau ya ai hte, shi a myi man hta mayen mahtaw bun ya let, “Tinang kahpu a nta n gap mayu ai wa hpe gaw, ning di ma ai,” ngu nna shi hpe tsun na rai wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai kaw nna Israela amyu ting hta, dai wa a nta hpe, Kyepdin raw kau lakung ngu nna shamying nga na rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lasha shada kamu hkat nga ai kaw, langai wa a madu jan dai de sit sa nna, shi a madu wa hpe hkye la na matu, langai wa a nsa lam hpe gang ya wu ai rai yang;
  </para>
  <para style="p">
    <verse number="12" style="v" />dai num a lata hpe daw kau ya na rai ndai: na a myi gaw shi hpe matsan dum lu na n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a tingsan hta kaba ai joi si hte kaji ai joi si ngu ai, n bung ai joi si gun lu na n rai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a nta hta dang hteng kaji kaba ngu ai, n bung ai shadang rem lu na n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a Karai Kasang Yehowa nang hpe jaw ai mungdan hte na a asak galu lit ga gaw, tengman ai joi si, tengman ai shadang, nang rem lu na ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaning rai nme law, maw sha map sha ngu ai n teng n man ai lam hkan ai ni nlang hte hpe na a Karai Kasang Yehowa matsat nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang Egutu mung na pru wa nna, bu lam hkawm wa ndai shaloi, Amalek masha ni nang hpe hkap tau ai hte,
  </para>
  <para style="p">
    <verse number="18" style="v" />nang n-gun yawm nna ba galawp nga yang, n-gun lagaw kya nna hpang hkrat nga ai ni hpe hkan hpya la ai lam hte Karai Kasang hpe n hkrit n kang ma ai lam hpe adum nga mu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai re ai majaw, na a Karai Kasang Yehowa nang hpe sali wunli matu jaw ai mungdan hta, na a grup yin nga masha hpyen ni a lata na, na a Karai Kasang Yehowa nang hpe simsa nga shangun ndai shaloi, Amalek hpe n dum lu hkra, sumsing lamu npu na atsai awai shamyit kau na rai myit dai; nang dai hpe malap kau lu na n rai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na a Karai Kasang Yehowa nang hpe sali wunli matu jaw ai mungdan de nang shang madu sha lu ndai shaloi,
  </para>
  <para style="p">
    <verse number="2" style="v" />na a Karai Kasang Yehowa nang hpe jaw ai mungdan hta shawng myin ai nsi naisi amyu shagu hta na nang la nhtawm, ka hta bang da nna, na a Karai Kasang Yehowa a mying ningsang tawn da na matu san da ai shara de sa na rai ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai dai prat na hkinjawng agyi wa hpang de nang sa nhtawm, “Yehowa anhte hpe jaw na nga ji wa ni hpe dagam da ai mung de ngai du ring ngai gaw, na a Karai Kasang Yehowa a man e dai ni ngai yin la nga nngai,” ngu nna hkinjawng wa hpe tsun na rai wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkinjawng wa mung ka dai hpe na a lata na la nna, na a Karai Kasang Yehowa a hkungri man e tawn da na rai wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai na a Karai Kasang Yehowa man e nang tsun na gaw, “Nye wa gaw let hkawm manam Arame masha rai li ai; shi gaw Egutu mung de yu wa nna dai yang, n law n htam hte sha, shingbyi nga ai kaw na galu kaba ai hte n-gun atsam rawng nna law htam wa ai amyu tai wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Egutu masha ni mung anhte hpe nhtum nni, zingri zingrat ai hte aja awa yam sha kau mi ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />shaloi anhte gaw anhte a ji wa ni a Karai Kasang Yehowa hpe shaga gaw ai rai nna, Yehowa anhte a nsen madat mara ya ai hte anhte hkrum ai bungli lit hte nni nkri hpe yu ya mi ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Yehowa gaw n-gun ja ai lata hte shada da ai lahpum, hkrithpa lam law law hte lamik kumla, mauhpa amu madun nna,
  </para>
  <para style="p">
    <verse number="9" style="v" />Egutu mung na anhte hpe shaw woi wa nhtawm, nga chyu hte lagat jahku lwi ai ndai mungdan hta woi shawn tawn da ma ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, Yehowa e, nang ngai hpe jaw ai yi hkauna a shawng myin ai nsi naisi ngai la sa ring ngai law,” ngu nna na a Karai Kasang Yehowa a man e nawng let, na a Karai Kasang Yehowa hpe dingnyawm nawku na rai ndai:
  </para>
  <para style="p">
    <verse number="11" style="v" />shing rai, na a Karai Kasang Yehowa nang hte na a nta masha ni hpe jaw ya ai chyeju nlang hte hta nang mung, nang hte rau nga ai Lewi wa hte amyu kaga wa mung jawm kabu nga lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jahkawn hta ai shaning ngu na masum ning ningdaw hta, lu malu hta na htamshi na htammi lahkawn shinggyin tawn nhtawm, na a mare na Lewi wa hte amyu kaga wa, jahkrai nmai ma hte gaida gaina ni hkru hkru kat kat sha lu hkra, shanhte hpe gam jaw na rai ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi e, na a Karai Kasang Yehowa man e, “Nang ngai hpe hkang da sai hte maren, chyoi pra ai arai ni hpe nye a nta na ngai shapraw nna, Lewi wa hte amyu kaga wa hpe mung, jahkrai nmai ma hte gaida gaina ni hpe mung, gam jaw mase ai: nang hkang da mada ga ni hpe ngai n tawt n lai, malap mali n di kau nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Si hkrung bungli rawng yang dai hta na ngai n lang; n san n seng nga yang dai hpe ngai n hkra; si mang shakru ai hta dai hpe ngai n lang shalawm nngai: nye a Karai Kasang Yehowa a ga ngai madat ni ai: nang hkang da mada hte maren ngai hkan nang nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a chyoi pra ai shara, sumsing lamu na gum yu nna, na amyu Israela hpe mung, ji wa ni hpe dagam da ai hte maren, anhte hpe jaw mi ai mungdan, nga chyu hte lagat jahku lwi ai ga hpe mung, shaman ya mi law,” ngu na rai ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ndai matsun maroi ga hte dawdan ai ga hpe hkan nang lu na nga nna, na a Karai Kasang Yehowa dai ni nang hpe hkang da nit dai: dai rai nna, na a myit masin mahkra hte na a kraw lawang mahkra hte dai ga hpe nang hkan shatsup lu na rai ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa hpe, na a Karai Kasang rai nga ai, nga nna mung, shi a lam hta hkawm nga na nngai, shi a matsun maroi, hkang da ai ga hte dawdan ai tara hpe hkan shatsup na nngai, shi a nsen madat mara na ni ai, nga nna mung, dai ni nang yin la nit dai:
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa mung, shi a ga ndat hte maren, nang shi a hkang da ai matsun maroi ga nlang hte hpe hkan shatsup lu n ga nga, shi a sali amyu shatai sa na nga nna mung,
  </para>
  <para style="p">
    <verse number="19" style="v" />shi hpan da sai masha amyu danghta hta, na a kajai gumhkawng ai, na a nsang mying, na a arawng sadang shagrau ya na nga nna mung, shi tsun tawn da sai hte maren, na a Karai Kasang Yehowa a matu nang hpe chyoi pra ai amyu shatai na nga nna mung, Yehowa dai ni yin la nu ai, nga nna Israela amyu hpe tsun wu ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Mawshe hte Israela amyu hta na salang ni gaw, amyu masha ni hpe ning ngu hkang da mu ai: “Dai ni ngai nanhte hpe tawn da ya ai hkang da mada ga ni hpe hkan shatsup nga mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nanhte Yawdan hka wora hkran rap nna, na a Karai Kasang Yehowa nang hpe jaw ai mungdan de du ndai shaloi, nlung kaba ni nang sharawt shadun nna anggadi chya na rai ndai:
  </para>
  <para style="p">
    <verse number="3" style="v" />na nji nwa ni a Karai Kasang Yehowa ga ndat nga ai hte maren, nang hpe jaw ai mungdan, nga chyu hte lagat jahku lwi ai ga de shang sha na rap kawt lu jang, ndai jep ai tara ga nlang hte hpe dai nlung ni hta nang ka da na rai ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yawdan hka rap kawt jang, dai ni ngai hkang da ai nlung ni hpe Ebala bum e sharawt jung nna anggadi chya na rai ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai yang e mung, na a Karai Kasang Yehowa a matu, nlung hte tawn hkungri gaw na rai ndai: hpri rai hte n daw n ga la ai sha;
  </para>
  <para style="p">
    <verse number="6" style="v" />lungdin lung bawng ni hte na a Karai Kasang Yehowa a matu tawn hkungri nang gaw da nna, dai hta na a Karai Kasang Yehowa a matu wan nat hkungga nawng na rai ndai:
  </para>
  <para style="p">
    <verse number="7" style="v" />mahku hkungga ni mung nang nawng nna, dai yang lu sha let na a Karai Kasang Yehowa a man e kabu gara nga na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai nlung ni hta ndai jep ai tara ga nlang hte hpe, nang dan dan pra pra ka da na rai ndai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai Mawshe hte hkinjawng ni, Lewi masha ni gaw, Israela amyu ting hpe, “Israela amyu e, atsin sha nga nna madat mara la mu: dai ni nang gaw na a Karai Kasang Yehowa a amyu tai nga nit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai re ai majaw na a Karai Kasang Yehowa a ga madat nga nu; dai ni ngai htawn tsun ai hkang da ai ga hte matsun maroi hpe hkan shatsup nga u,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Mawshe gaw dai shani e masha ni hpe hkang da nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nanhte Yawdan hka rap kawt ai hpang, shaman ai maga na matu Gerizim bum e tsap na ni gaw, Simon, Lewi, Yuda, Yishahka, Yawsep hte Ben-yamin rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dagam dala ai maga na matu Ebala bum e tsap na ni gaw, Rubin, Gad, Ashe, Zebulun, Dan hte Naphtali rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Lewi a kashu kasha ni gaw nsen shaja nna Israela amyu lasha ni nlang hte hpe ning ngu jahtau na rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa matsat ai rai ngu ai, “sama chye ai wa a lata hte tawk la ai sumla, chyaw la ai sumla galaw nna shim ai kaw tawn da ai wa gaw, dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Kanu kawa hpe roi ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Htingbu wa a lamu ga jarit bandung sit kau ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Myi n mu ai wa hpe lam shadam ai wa gaw, dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Tara dara ai hta amyu kaga wa hte jahkrai nmai, gaida gaina hpe, n sun n ang ai hku jasum ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kawa hte sha seng ai kawa madu jan hte nga sha ai wa gaw dingnye hkrum u ga le, nga nna dagam yang, amyu masha ni nlang hte gaw, Amen ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Dusat yamnga lama ma hte nga sha ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Kawa a shayi sha, kanu a shayi sha ngu ai, tinang a kanau kana hte nga sha ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Tinang a kani hte nga sha ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Htingbu wa hpe mayun de nna gyam anu ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Mara n lu ai wa hpe sat na lam shabrai la sha ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Ndai jep ai tara ga hpe n hkan galaw ai wa gaw dingnye hkrum u ga le,” nga nna dagam yang, amyu masha ni nlang hte gaw, “Amen,” ngu nna htan na rai mu ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Dai ni ngai nang hpe hkang da mada ga yawng hpe hkan nang lu hkra, na a Karai Kasang Yehowa a ga hpe nang azin ayang madat n yang gaw, na a Karai Kasang Yehowa, masha amyu nlang hte hta nang hpe shagrau na rin dai:
  </para>
  <para style="p">
    <verse number="2" style="v" />na a Karai Kasang Yehowa a ga nang madat n yang gaw, ndai chyeju shaman nlang hte na ntsa e du nna nang kaw pru na ra ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a mare hta chyeju shaman lu la na ra ai; na a yi hkauna hte chyeju shaman lu la na ra ai
  </para>
  <para style="p">
    <verse number="4" style="v" />Kashu kasha matu mara hta mung, na lamu ga nsi naisi hta mung, yamnga mayat maya ai hta na, na a dumsu hte sagu bainam ulung ni hta mung, chyeju shaman lu la na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a shingnoi htingga hta mung, muk gumrin ai ban hta mung, chyeju shaman lu la na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nhku shang wa yang shaman lu la na ra ai, shinggan pru wa yang, chyeju shaman lu la na ra ai.”
  </para>
  <para style="p">
    <verse number="7" style="v" />“Yehowa gaw nang hpe hpyen ai gumlau ni hpe na a man e jasum kau na mu ai: shanhte nang hpang de lam langai sha hta shang ma timung, lam sanit hku na a man na htaw mat na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a sutdek hta mung, nang galaw ai lam magup hta mung, Yehowa gaw na a ntsa e chyeju shaman lu la na hku tsun ya na rin dai: na a Karai Kasang nang hpe jaw ai mung hta nang hpe shaman ya na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a Karai Kasang Yehowa a hkang da ai ga nang shatup nna shi a lam hkan sa n yang gaw, shi nang hpe dagam da ai hte maren, nang hpe shi a matu chyoi pra ai amyu shatai nga na rin dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai nang hpe Yehowa a amying ningsang hte nan shamying ai wa rai nga ai, nga nna ga ntsa amyu nlang chye lu ai hte nang hpe hkrit gari nga na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa nang hpe jaw na nga, nji nwoi ni hpe dagam da ai mungdan hta, shayi shadang sut, yamnga sut, nai mam sut kaja, Yehowa nang hpe shakat ya na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a mungdan hta du hkra ladaw shagu lamu marang jahtu ya na matu, Yehowa gaw shi a sutdek kaja ngu ai Sumsing lamu hpaw ya nna, na lata galaw ai lam magup hta nang hpe shaman ya na ra ai: masha amyu law law hpe nang mahtang hkoi ya lu na rin dai, nang gaw hkoi la ra na n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai ni ngai nang hpe hkang da ai, na a Karai Kasang Yehowa hkang da mada ga ni hpe hkan shatup lu hkra, nang madat mara nna,
  </para>
  <para style="p">
    <verse number="14" style="v" />dai ni ngai nanhte hpe hkang da ai lam hta na pai de hkra de n yit, Hpara shaje ni a hpang n hkan, dai ni hpe n jaw n jau ai nga n yang gaw, Yehowa nang hpe nmai n shatai ai sha abaw shatai na rin dai: nang gaw npu taw na n rai, ntsa e hkrai nga lu na rin dai.”
  </para>
  <para style="p">
    <verse number="15" style="v" />“Bai, dai ni ngai nang hpe hkang da ai, na a Karai Kasang Yehowa hkang da ai ga hte matsun maroi nlang hte hpe hkan nang na, shi a nsen nang n madat n yang gaw, ndai dagam dala dingnye nlang hte gaw na ntsa e du nna nang kaw pru na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a mare hta dingnye rawng na ra ai; na a yi hkauna de dingnye rawng na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a shingnoi htingga hta mung, muk gumrin ai ban hta mung dingnye rawng na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kashu kasha matu mara hta mung, na lamu ga nsi naisi hta mung, yamnga mayat maya ai hta na, na a dumsu hte sagu bainam ulung ni hta mung, dingnye rawng na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nhku shang wa de mung dingnye rawng na ra ai, shinggan pru wa de mung, dingnye rawng na ra ai.”
  </para>
  <para style="p">
    <verse number="20" style="v" />“Tinang galaw shut ai yubak hte ngai Yehowa hpe kau da ai mara majaw, nang hten byak nna alawan htum mat ga du hkra, na lata galaw ai lam magup hta, dagam dala, sharu shatsang, aroi arip, na ntsa e du shangun na we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang shang sha na mungdan hta na nang hpe jahtum kau lu hkra, Yehowa gaw dai ana zinli nang hta shakap na wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa gaw nang hpe mang shakrwi krawi ai, ali awaw waw ai, nma bya ai, bungge ge ai, jan gri ai, hkau pyi pyi ai, mam maru ru ai hte tsin-yam dai ni gaw nang kaw hkan nang na mara ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na baw ntsa na sumsing lamu gaw magri, na npu na lamu ga gaw ahpri tai na ra ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa gaw na a mungdan hta htu ai marang hpe ga nhpu hte nbun shatai nna, nang htum mat ai du hkra dai gaw lamu de na, na ntsa e htu na ra ai.”
  </para>
  <para style="p">
    <verse number="25" style="v" />“Nang hpe hpyen ai ni a man e Yehowa gaw nang hpe jasum kau na ndai; lam langai sha hku nang shanhte hpang de htim sa wa ai rai timung, lam sanit hku shanhte a man na nang hprawng htaw lu na rin dai; shing rai, ga ntsa ting na mungdan shagu de nang htawt hprawng hkawm lu na rin dai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na a si mang gaw ntsa malen u ni hte nam na matse labye ni a shat tai na ra ai: dai ni hpe gawn kau lu na kadai mung nga na n rai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa gaw nang hpe Egutu mung na shakrwi hte du htau htau ai, machyit chyit ai hte maru ru ai ana ngu ai, n mai chye ai ana hte tsin-yam jaw na rin dai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yehowa gaw nang hpe mana bu ai, myi hten ai, mau pung ngang ai hte tsin-yam jaw nna,
  </para>
  <para style="p">
    <verse number="29" style="v" />myi hten ai wa gaw n sin e lamawm ai zawn, shani chyingtung e pyi nang lamawm hkawm na rin dai; nang galaw ai lam n byin ai hte, zingri zingrat kashun kashe ai sha hkrum na rin dai; nang hpe kadai mung hkye la lu na n rai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nang num mahtan tawn timung, masha wa la kau na ra ai; nta gap tawn timung, nang nan rawng lu na n rai; tsabyi sun hkai tawn timung, nang nan di sha lu na n rai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na a nga hpe na a man e sat tawn timung, nang nan shan sha lu na n rai; na a lawze hpe adip akrip rai la mat wa nhtawm bai sa ya na n rai; na a sagu ni hpe gumlau wa lata de shang wa nga timung, nang hpe hkye la ai masha pru na n rai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na a shayi shadang sha ni masha tsasam a lata de shang mat wa nna, nang gaw shani tup shanhte hpe hkan mada let gawng run nga na rin dai; na a lata hta mung, lapyin rawng na n rai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na a mungdan a nsi naisi hte nang galaw tawn ai sutgan yawng gaw nang n mu n chye yu ai masha amyu sha kau na mara ai; nang chyawm gaw zingri zingrat hkrum sha ai tut rai na nit dai:
  </para>
  <para style="p">
    <verse number="34" style="v" />shing rai, nang hkrum sha ai shoihpa a majaw nang mana mat na rin dai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yehowa gaw na a lahput hte shinglang hta sha n rai, lagaw lahpan kaw nna baw pungting hkren, mai n chye ai shakrwi hte tsin-yam jaw na rin dai.”
  </para>
  <para style="p">
    <verse number="36" style="v" />“Yehowa gaw nang hte na a ntsa e nang shadun ai hkawhkam wa hpe, nang mung n chye, na nji nwa ni mung n chye ai amyu hpang de woi mat wa na marin dai rai nna, dai yang e hpun hpara, nlung hpara re ai Hpara shaje ni hpe nawku lu na marin dai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Yehowa nang hpe woi mat wa ai mungdan shagu hkan e, nang gaw masha ni a mau shara, abung shadawn chyai shara hte asawng shara tai na rin dai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mam nli law law wa na a yi hkauna de nang la sa timung, dinggam ni sha kau ai majaw kachyi sha shu la lu na ndai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tsabyi sun hkai sharing tawn timung, shingtai sha kau ai majaw tsabyi si di la lu na n rai tsabyi jahku mung lu lu na n rai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang nga ai shara magup hta tsanlun hpun tu timung, si garai n myin yang run mat ai majaw tsanlun sau hte na hkum hpe chya lu na n rai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kashu kasha shaprat timung, shanhte bawng dung mat na re ai majaw, na a kasha ngu lu na n rai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Na a mungdan a hpun tu matu hte lamu ga nsi naisi nga manga hpe dinggam ni sha kau na mara ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nang hte rau nga ai amyu kaga wa gaw grau tsaw wa nna na ntsa de nga na ra ai; nang chyawm gaw npu shang nna taw lu na rin dai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi mahtang nang hpe hkoi shap lu na ra ai, nang chyawm gaw shi hpe hkoi shap lu na n rai; shi mahtang baw tai nna nang gaw nmai tai na rin dai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na a Karai Kasang Yehowa nang hpe hkang da mada hte matsun maroi ga ni hpe hkan nang na nga, shi a nsen hpe nang n madat ndai majaw, nang htum mat ga du hkra dai dagam dala dingnye nlang hte gaw na a ntsa e du nna nang kaw pru na ra ai:
  </para>
  <para style="p">
    <verse number="46" style="v" />dai gaw na a ntsa e mung, na amyu matu ni a ntsa e mung, prat dingsa lamik kumla hte mauhpa amu tai nga na ra ai.”
  </para>
  <para style="p">
    <verse number="47" style="v" />“Nang ngamu nga mai ai hte yang, na a Karai Kasang Yehowa hpe kabu gara ai myit hte n daw n jau ndai majaw,
  </para>
  <para style="p">
    <verse number="48" style="v" />Yehowa nang hpang de shangun dat ai masha hpyen wa hpe, kawsi hpang kara, singgu krin, matsan tsin-yam hkrum let daw jau lu na ndai: nang hpe jahtum kau lu ai du hkra, dai wa gaw na a du hta hpri kandang jahpai na ra ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Yehowa gaw, kalang htim ai zawn larau ai masha amyu mi, tsan ai shara lamu ga htum na, nang hpang de sa gasat shangun na ra ai; dai amyu a shaga ai ga nang chye na na n rai:
  </para>
  <para style="p">
    <verse number="50" style="v" />dai amyu gaw ru ai myi man man nna, dingla wa hpe hpa n nawn, ma hpe mung n gawn;
  </para>
  <para style="p">
    <verse number="51" style="v" />nang htum mat ai du hkra shanhte gaw na a yamnga, na a nsi naisi sha na mara ai; nang kaw jahten kau lu hkra, nai mam, tsabyi jahku, tsanlun sau, dumsu kasha hte sagu bainam kasha re ai ni hpe, na a matu tawn da ya na n rai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Na mungdan hkan na, nang shamyet kam da ai mare bunghku, dai tsaw ai hte ngang ai bunghku ni, ndaw nru mat dingsa, na a mare ni hpe wang tawn na maru ai: na a Karai Kasang Yehowa nang hpe jaw ai mungdan shara shagu na mare nga manga hpe wang tawn na maru ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Shing rai wang tawn ai hte masha hpyen ni e shinggyin tawn ndai shaloi, tinang hkritung hkriwang na, na Karai Kasang Yehowa nang hpe jaw ai shayi shadang sha ni a shan sha lu kaw du na rin dai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Na a mare yawng hpe masha hpyen ni wang tawn nna, nang hpe shakyin tawn ndai shaloi, nanhte hta nachying sumnung shingdi ai la wa pyi, lusha htum ai majaw, tinang a kasha shan sha yang,
  </para>
  <para style="p">
    <verse number="55" style="v" />tinang a kahpu kanau, tinang a lahpyen na madu jan hte naw ngam nga ai kasha ni hpe pyi manawn ai myit rawng nna, shanhte hte jawm sha hkraw na n rai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Na a mare yawng hpe masha hpyen ni e wang tawn nna, nang hpe shakyin tawn ndai shaloi, nanhte hta nachying hkik htap ai hte shingdi la nna, hkik htap shingdi man sai majaw ga pyi n kabye wam ai num jan pyi gaw,
  </para>
  <para style="p">
    <verse number="57" style="v" />lusha hpa nan n nga ai majaw, tinang shangai ai ma chyangai hte tinang hkritung na ma manang hpe pyi, tinang hkrai lagyim sha kau nna, tinang a lahpyen na madu wa hte tinang a shayi shadang sha ni hpe jaw sha na pyi manawn na wu ai.”
  </para>
  <para style="p">
    <verse number="58" style="v" />“Na a Karai Kasang Yehowa ngu ai hpung shingkang hte hkrithpa rai nga ai mying ningsang hpe, hkrit kang nga na matu, ndai laika hta ka da ai tara matsun yawng hpe nang n hkan ai nga n yang gaw;
  </para>
  <para style="p">
    <verse number="59" style="v" />Yehowa gaw, nang hkrum sha na ana zinli hte na a amyu matu ni hkrum sha na ana zinli ngu na, mauhpa ana, nachying kaba nna na du ai ana, grai laja nna na du ai ahkya shakap na ndai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Dai hta kaga, nang hkrit kang ai Egutu mung na ana zinli yawng mayawng shi na ntsa e du shangun nna, dai ana ni nang hta kap na ra ai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Dai hta n-ga, ndai laika hta n ka lawm ai machyi makaw hte ana zinli amyu shagu mung, nang n htum mat dingsa, na ntsa e Yehowa shangun dat na ra ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Nanhte sumsing lamu shagan made law htam myit dai rai timung, na a Karai Kasang Yehowa a nsen hpe n madat myit dai majaw kachyi sha mi rai mat na marin dai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Nang hpe chyeju hte karum nna shalaw jahtam ai amu hta Yehowa awng sharawng wu ai zawn, nang hpe hpya nna shayawm shagrit ai amu hta awng sharawng na wu ai rai nna, nang wa shang sha na rin dai mung hta na ningli shamyit kau ai hkrum na rin dai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Yehowa gaw lamu htum maga mi kaw nna lamu htum maga mi du hkra masha amyu nlang hte hta shara magup de nanhte hpe shabra kau nna, nang mung n chye ai, nji nwa ni pyi n na yu ai hpun hpra, nlung hpara re ai Hpara shaje ni hpe nawku lu na rin dai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Dai amyu ni hta nang ngamu lu na n rai, kan zaw chying lu na n rai; Yehowa gaw nang hpe masin kahpra ai, myi man sum na hte minla byaw mat ai, jahkrum na ndai rai nna;
  </para>
  <para style="p">
    <verse number="66" style="v" />na asak sum wa magang ai lam hpe myit ru nga na rin dai: shani shana hkrit gari nga let, na asak prawn na n prawn na lam myit ung ang nga na rin dai.
  </para>
  <para style="p">
    <verse number="67" style="v" />Na a myit masin hta na hkrithpa lam hte, na myi e mu lu ai lam ni a majaw, jahpawt e rai yang, ‘Jan lau du u ga le,’ shana e rai yang, ‘Nhtoi lau htoi u ga le,’ nga nna marit nga na rin dai.
  </para>
  <para style="p">
    <verse number="68" style="v" />Lam ndai nang galoi mung bai mu lu sa na n rai, nga nna tsun kau sai lam hku, Yehowa gaw nang hpe Egutu mung de sanghpaw li hte bai woi sa wa nna, dai yang e mayam num mayam la sa tai nna, hpyen ni hpe tinang hkum dai sa dut timung, mari na kadai n nga ai.”
  </para>
  <para style="p">
    <verse number="69" style="v" />Ndai hte gaw Horeb bum e Yehowa Israela amyu hte shaka da ai ga shaka hta kaga, Moba mung e dai amyu hte shaka da na matu, Yehowa Mawshe hpe hkang da ai ga shaka rai nga ai.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Mawshe gaw Israela amyu masha nlang hte hpe shaga nna, Yehowa Egutu mung e Hpara-u hkawhkam hta mung, shi a mayam ni nlang hte hta mung, shi a mungdan ting hta mung, nanhte a man e shi galaw sai lam nlang hte ngu ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />tinang myi hte mu lu ai nachying kaba ai chyam dinglik amu, nachying kaba ai lamik kumla hte mauhpa hpung shingkang ni hpe nanhte mu yu manit dai:
  </para>
  <para style="p">
    <verse number="3" style="v" />rai timung, chye na lu ai myit masin, mu la lu ai shinggan myi, na la lu ai na gaw, dai ni du hkra Yehowa nanhte hpe garai n jaw myit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw nanhte hpe mali shi ning tup dai nam mali lam hku woi wa made yang, ngai nanhte a Karai Kasang Yehowa rai nga nngai gaw nanhte chye lu hkra, nanhte a hpun palawng n tsam mat, nanhte din ai kyepdin mung n htum;
  </para>
  <para style="p">
    <verse number="5" style="v" />nanhte muk mung n sha, tsabyi hte chyaru mung n lu ra myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nanhte ndai de pru myit dai shaloi, Hesbon hkawhkam Sihon hte Bashan hkawhkam Oga gaw anhte hpe hkap gasat na nga pru sa ma ai hpe, anhte mahtang shan hpe dang kau lu ga ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />shing rai shan a lamu ga anhte kashun la nna, Itubin amyu, Gad amyu hte Manashe amyu chyen mi hpe sali ga matu jaw kau sagaw ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna, nanhte galaw ai lam magup hta nanhte awng wa lu myit ga, ga shaka ndai hpe hkan shatsup shaja nga mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte a Karai Kasang Yehowa gaw, dai ni nanhte hpe shi a amyu shatai na nga, nang hpe tsun da sai hte, na nji nwa Abraham, Isak, Yaku hte hta dagam da sai hte maren,
  </para>
  <para style="p">
    <verse number="10" style="v" />na a Karai Kasang tai nga na matu, dai ni na Karai Kasang Yehowa nang hte tawn da ai shaka ga hte dagam ga hpe yin la na nga,
  </para>
  <para style="p">
    <verse number="11" style="v" />nanhte a amyu hta na baw mung ni, salang ni, du agyi ni hte Israela amyu numsha lasha ma kaji ni kaw nna, na dap kata e nga ai hpun hta hka ja shingbyi manam du hkra,
  </para>
  <para style="p">
    <verse number="12" style="v" />nanhte a Karai Kasang Yehowa man e, yawng mayawng dai ni tsap nga myit dai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hta n-ga, ndai shaka ga hte, ndai dagam ga hpe nanhte hte tawn da ai sha n rai: dai ni anhte a Karai Kasang Yehowa a man e tsap nga ai ni hte mung, dai ni anhte hta n tsap lawm ai ni hte mung tawn da nngai:
  </para>
  <para style="p">
    <verse number="15" style="v" />kaning rai nme law, Egutu mung e anhte kaning rai nga nga ga ai mung, lam hkan e, masha amyu ni a ka-ang hku kaning rai ga lai wa ai mung nanhte chye myit dai:
  </para>
  <para style="p">
    <verse number="16" style="v" />shanhte a matsat shabat lam ni hte shanhte nawku ai hpun, nlung, aja, gumhpraw hpara sumla ni hpe mung nanhte mu manit dai:
  </para>
  <para style="p">
    <verse number="17" style="v" />dai re ai majaw, anhte a Karai Kasang Yehowa kaw na yit mat wa mayu ai myit pru nna, dai masha amyu ni a hpara hpe sa nawku ai numsha, lasha, shing n rai amyu lakung langai ngai nanhte hta n nga pru u ga mung; nanhte hta na agung hte pila si si chye ai aru npawt n tu pru u ga mung;
  </para>
  <para style="p">
    <verse number="18" style="v" />shing re ai wa ndai dagam dala ga na jang, “Ngai gaw nye a myit ja ai lam hkan nna, katsing mi da chyahkraw mi da nlang hten mat wa hkra rai timung, ngai gaw pyaw na nngai,” nga nna tinang myit hta awng nga ai wa n nga pru u ga mung, sadi nga mu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai wa hpe Yehowa lahpawt na wu ai n rai; Yehowa pawt bu ai hte nsu ai myit gaw dai wa a ntsa e grung nga nna, ndai laika hta ka da ai dagam dala nlang hte hpe dai wa a ntsa e ru bun na wu ai; Yehowa mung dai wa a amying hpe sumsing lamu npu na arut kau na wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa mung, ndai tara laika hta ka da ai ga shaka dingnye nlang hte hte maren, dai wa hpe Israela amyu matu hta na lat kau nna arai jaw na matu jahku tawn na wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai mungdan hta Yehowa shakap tawn ai ana zinli hte machyi makaw lam hpe mung,
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa a pawt ai n-yun bu nna galau kau ai Sodom, Gomora, Adma, Zeboim mare ni hten mat ai zawn, mungdan ting kan hte jum wan hkru nna, nli n gat, nai mam n si, tsingdu tsingman n tu ai lam hpe mung,
  </para>
  <para style="p">
    <verse number="23" style="v" />htawm hpang prat na nanhte a kashu kasha ni hte sumtsan mung na sa ai tsasam wa mu ma yang, masha amyu myu ni gaw, “Ndai mungdan hpe hpa majaw Yehowa ning di wu ai i? Nde wa pawt ai sindawng gaw kaning re ai i?” nga nna san shajang na mara ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi masha ni gaw, “Shanhte a kaji kawoi ni nawku ai Karai Kasang Yehowa shanhte hpe Egutu mung na shaw woi wa ai shaloi, shanhte hte tawn da ai ga shaka hpe run kau mu ai majaw mung,
  </para>
  <para style="p">
    <verse number="25" style="v" />shawng de shanhte n chye ai, shanhte hpe mung n hkang da ai Hpara shaje ni hpe nawku jaw jau ma ai majaw mung,
  </para>
  <para style="p">
    <verse number="26" style="v" />laika dai hta ka da ai dingnye nlang hte hpe ndai mung hta jahkrat nna, Yehowa a pawt bu ai sindawng grung nga ai hte,
  </para>
  <para style="p">
    <verse number="27" style="v" />shanhte a mungdan kata na Yehowa shanhte hpe shaw kau nna, dai ni du hkra, kaga mungdan de gawt shapraw kau ai rai nga ai,” nga nna tsun dan na mara ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Makoi magap nga ai hte gaw anhte a Karai Kasang Yehowa hte seng nga ai: ndai tara matsun nlang hte gaw, anhte hkan nang nga lu hkra, dan shapraw ya sai lam ni gaw, anhte hte anhte a kashu kasha ni hte htani htana seng nga ai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Rai timung, ndai lam yawng mayawng ngu ai, na a man e ngai tawn da ai shaman chyeju hte dagam dala dingnye nlang hte gaw, na ntsa e du nna, na a Karai Kasang Yehowa nang hpe shachyut kau ai mungdan shagu hte hta ndai lam ni hpe dum nga let,
  </para>
  <para style="p">
    <verse number="2" style="v" />na a Karai Kasang Yehowa a hpang de bai kayin nna, dai ni ngai nang hpe hkang da mada hte maren, nang hte na a nshu nsha ni shi a ga hpe myit masin kraw lawang ting hte madat mara yang gaw;
  </para>
  <para style="p">
    <verse number="3" style="v" />na a Karai Kasang Yehowa mung, nang hkrum ai bawng nan amu hpe jahtum ya nna, nang hpe matsan dum ai hte kayin nhtawm, nang hpe shabra kau ai mungdan shagu hta na nang hpe shinggyin la na rin dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a bawng dung manang nkau mi gaw sumsing lamu npu tsan htum ai shara de gawt kau ai hkrum timung, dai kaw nna na a Karai Kasang Yehowa nang hpe shinggyin la na ra ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />shing rai na a nji nwa ni shang madu sha ai mungdan de na a Karai Kasang Yehowa nang hpe bai shawn tawn nna, dai hta nang shang sha lu na rin dai: shaloi shi nang hpe bai lahku ai hta, nji nwa ni hta nang hpe grau nna shalaw jahtam na rin dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang hkrung nga lu hkra, na a Karai Kasang Yehowa hpe na a myit masin kraw lawang mahkra hte tsawra lu na matu, na a Karai Kasang Yehowa gaw na a myit masin hte, na matu mara ni a myit masin hpe matu gadoi ya na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a hpyen wa ngu ai, nang hpe n dawng n yawt ai hte zingri zingrat ai ni hpe mung, ndai dagam dala dingnye nlang, na a Karai Kasang Yehowa shanhte hpe jahkrum na wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang chyawm gaw bai wa nna, Yehowa a nsen madat mara let, dai ni ngai hkang da mada matsun maroi ni hpe hkan shatsup nga na rin dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw na a Karai Kasang Yehowa hpang de na myit masin mahkra hte kraw lawang mahkra hte kayin wa n yang gaw;
  </para>
  <para style="p">
    <verse number="10" style="v" />nang galaw ai lam magup tai wa lu na hte, na a shayi shadang, sutgan yamnga, nsi naisi gumja wa na ra ai: kaning rai nme law, Yehowa gaw na nji nwa ni hta awng sharawng wu ai zawn, na a akyu matu nang hta mung awng sharawng na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Dai ni ngai nang hpe hkang da ai matsun maroi gaw, nang n hkan lu hkra yak ai n rai, nang hte tsan la ai mung n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘Dai tara hpe anhte madat nna hkan shatsup lu hkra, sumsing lamu de kadai lung nna anhte hpang de la sa na i?’ nga nna san na gaw, sumsing lamu de nga ai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai tara anhte madat nna hkan shatup lu hkra, ‘Nammukdara wora hkran kadai rap nna anhte hpang de la sa na i?’ nga nna san na mung, nammukdara wora hkran e nga ai n rai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai mungga gaw nang hkan lu na matu nang hte htep rai nga ai: na n-gup hta mung na kraw lawang hta mung rawng nga lit dai.”
  </para>
  <para style="p">
    <verse number="15" style="v" />“Yu u, nang asak galu nna mayat maya wa lu na hte, nang shang madu sha na mungdan hta, na a Karai Kasang Yehowa nang hpe shaman ya lit ga gaw, na a Karai Kasang Yehowa hpe tsawra ai hta, shi a lam hkan nga nna, shi a hkang da ai ga, shi a matsun maroi hte ga madat hpe hkan nang nga nu, ngu nna dai ni nang hpe hkang da ai ga hta,
  </para>
  <para style="p">
    <verse number="16" style="v" />asak hkrung lam hte ngamu lam, si hkrung si htan, lam hte matsan tsin-yam lam na a man e ngai dai ni tawn da ya sade ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai n rai, na a myit dam mat wa nna, madat mara myit n rawng ai hte agung alau ai de hkan nang nna Hpara shaje sa nawku mat wa n yang gaw;
  </para>
  <para style="p">
    <verse number="18" style="v" />Yawdan hka rap nna shang sha na marin dai mungdan hta asak hpungngang n nga ai; nanhte teng teng hten byak mat na marin dai, ngu nna dai ni ngai nanhte hpe shadum da nga nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Asak hkrung lam hte si htan lam, shaman ai chyeju lam hte dagam dala dingnye lam, na a man e dai ni ngai tawn da ya sade ai, ngu nna na a lam sumsing lamu hte ginding aga hpe ngai sakse da ya se ai: dai rai nna, nang hte na a amyu matu ni hkrung nga lu myit ga gaw, asak hkrung ai lam lata la mu:
  </para>
  <para style="p">
    <verse number="20" style="v" />na a Karai Kasang Yehowa hpe tsawra u, shi a nsen madat mara nga u, shi hta manoi manat nga u; kaning rai nme law, shi gaw na a asak hkrung lam hte na a prat galu na lam rai nga ai: dai rai jang, Yehowa Abraham, Isak, Yaku hte hpe jaw na nga dagam da ai mungdan hta nang anga nga lu na rin dai,” ngu nna Israela amyu masha mi hpe tsun da wu ai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Mawshe gaw Israela amyu ting hpe ndai ga madat tsun da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi shanhte hpe tsun wu ai gaw, “Ngai gaw dai ni asak latsa e hkun ning du ni ai: ya kaw nna nanhte a man e ngai n hkawm n sa lu ni ai: Yehowa mung, ‘Nang ndai Yawdan hka n rap lu na ndai,’ ngu ni ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a Karai Kasang Yehowa gaw na a shawng e rap sa wa nhtawm, dai mung na masha amyu nlang hpe shamyit kau nna shanhte a shara e nanhte shang sha lu na marin dai: Yehowa tsun da sai hte maren, Yawshu gaw na a man e rap lu na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa mung shi jahten kau ai Amori hkawhkam Sihon yan Oga a mungdan hte shan hpe di ai zawn, dai hkran na masha amyu ni hta mung di na wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa gaw shanhte hpe nanhte a lata de ap kau na ru ai rai nna, ngai hkang da mada hte maren shanhte hpe nanhte di lu na marin dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, nanhte n-gun da ting mu, myit nden shaja mu; hkum tsang myit, shanhte hpe hkum hkrit myit: nanhte hte rau hkawm sa nga ai wa gaw na a Karai Kasang Yehowa nan rai nga ai: shi nang hpe kau da na n rai, nang hpe kau rap rai na n rai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi Mawshe Yawshu hpe shaga la nna, “Nang mung n-gun da ting u, myit nden shaja u: Yehowa ndai ni hpe jaw na nga ji wa ni hpe dagam da ai mungdan nang shanhte hte rau rap sa nna, dai mungdan hpe madu sha shangun na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a man e hkawm sa ai wa Yehowa rai nga ai; shi nang hte rau nga nga ai rai nna, shi nang hpe kau da na n rai, nang hpe kau rap di na n rai; hkum tsang et, myit hkum htum e;” ngu nna Israela amyu ting a man e tsun da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Mawshe gaw ndai tara ga nlang ka da nna, Yehowa a ga shaka sumpu hpai ai Lewi amyu hkinjawng ni hte Israela salang ni nlang hte a lata hta ap da wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai Mawshe shanhte hpe hkang da mu ai gaw, “Sanit ning du nna, mayam dat dat ai ningdaw ngu na sum poi du jang,
  </para>
  <para style="p">
    <verse number="11" style="v" />nanhte a Karai Kasang Yehowa san da na ra ai shara e Israela amyu ting shi a man e tinang hkum pru dan na sa ma ai shaloi, ndai tara ga hpe Israela shawa hpawng nlang a man e hti dan na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Numsha, lasha ma kaji kaba nlang hte, na a mare na shingbyi manam ni chye na lu nna, na a Karai Kasang Yehowa hpe hkrit hkungga let ndai tara ga nlang hpe hkan nang nga mu ga, amyu masha ni hpe jahpawng tawn mu:
  </para>
  <para style="p">
    <verse number="13" style="v" />dai rai jang, garai n chye ai ma ni na la lu nna, nanhte Yawdan hka wora hkran e shang sha lu na marin dai mungdan hta nga pra lu prat dingsa, nanhte a Karai Kasang Yehowa hpe hkrit hkungga nga na matu sharin la lu na mara ai,” ngu nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw, “Nang si na nhtoi du magang ra ai: Yawshu hpe shaga la su; ngai shi hpe hkang da we ga, shawa sum de pru sa marit,” ngu wu ai. Dai rai nna Mawshe yan Yawshu pru sa nna shawa sum de sa nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa mung dai sum e sumwi shadaw hta dan pru nna, sumwi shadaw gaw sum chyinghka ntsa e jung nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Yehowa Mawshe hpe, “Yu u, nang gaw nji nwa ni hte yup pyaw nga na nit dai; ndai amyu masha ni chyawm gaw rawt nna, ya sa wa ai mung e nga ai tsasam amyu ni nawku ai Hpara ni hte shut hpyit nna, ngai e kau da let ngai tawn da ya ai ga shaka run kau na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shani e ngai shanhte hpe masin pawt nna shanhte hpe kabai kau na we ai; shanhte kaw na nye a myi man ngai makoi kau nna, shanhte hten bya hkrum ai hte ruyak kyin dut amyu myu kadup na mara ai: dai shani shanhte gaw, ‘Anhte a Karai Kasang anhte hta n nga ai majaw ndai yubak shoihpa anhte a ntsa e du ai n rai nga a ni?’ nga na mara ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte Hpara shaje hpang de rai mat wa nna, shut ai yubak nlang hte a majaw, dai shani e ngai gaw nye myi man shanhte kaw na teng teng makoi kau na we ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna, ndai mahkawn mangoi ga hpe ka tawn da nna, Israela kashu kasha ni hpe sharin ya mu: dai mahkawn mangoi ga gaw Israela kashu kasha ni a man e nye a lam sakse tai nga na matu shanhte a n-gup hta rawng nga malu ga.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaning rai nme law, shanhte a kaji kawa ni hpe ngai dagam da ai hte maren, nga chyu hte lagat jahku lwi ai mung de shanhte hpe ngai shaw tawn nna, shanhte hkru hkru kat kat sha lu ai hte hpum sau ai shani e, Hpara shaje ni hpang de shanhte dam mat wa nna daw jau na mara ai; shanhte ngai hpe jahpoi nna nye a ga shaka run kau na mara ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai nna, yubak shoihpa nlang hte hte kadup ai shani dai mahkawn ga gaw shanhte a man e sakse tai nga na rai ai; shanhte a amyu lakung gaw dai hpe malap kau mai na n rai: ngai dagam ai mung de shanhte hpe garai n shawn yang nna pyi shanhte a myit hta maw mawn ai lam hpe ngai chye ya nga nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mawshe mung dai shani e ndai mahkawn mangoi ga ka da nna Israela kashu kasha ni hpe sharin ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nun a kasha Yawshu hpe mung, “N-gun da ting u, myit nden shaja u; ngai dagam da ai mungdan de Israela kashu kasha ni hpe nang woi shawn na rai ndai; nang hte rau ngai nga nga na ring ngai,” ngu nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mawshe gaw ndai tara ga hpe laika hta azin ayang ka da ngut jang,
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa a ga shaka sumpu hpai ai Lewi masha ni hpe Mawshe hkang da wu ai gaw,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Ndai tara laika hpe lu na, nanhte a Karai Kasang Yehowa a ga shaka sumpu makau e tawn da mu; dai gaw na a matu sakse tai nga na rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nme law, nang hta gumlau ai myit hte du ja ai myit rawng lit dai gaw ngai chye nga nngai; yu mu, ngai hkrung nga ai hte nanhte kaw naw nga nga yang pyi, nanhte Yehowa hpe gumlau manit dai; ngai si ai hpang dai hta grau nna gumlau na ni, n rai myit ni?
  </para>
  <para style="p">
    <verse number="28" style="v" />Nanhte a amyu lakung ni a myit su salang ni hte du agyi ni hpe ngai kaw jahpawng tawn maru; ngai shanhte hpe ndai ga nlang tsun da nna, shanhte a man e sumsing lamu hte ginding aga hpe gang nna sakse tawn da we ga.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kaning rai nme law, ngai si mat ai hpang nanhte gaja wa htak mat nna, ngai hkang da ai lam hta na dam mat wa na marin dai gaw, ngai chye nga nngai; Yehowa a man e shut hpyit nna tinang lata e galaw ai amu hte shi hpe shapawt ai majaw, htawm hpang prat e nanhte ruyak tsin-yam hte kadup na marin dai,” ngu nna shadum da wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Mawshe ndai mahkawn mangoi ga ma hkra, Israela shawa hpung a man e tsun hkai wu ai gaw:
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Sumsing lamu e, madat u, ngai tsun de ga, Ginding aga, ngai tsun ai ga na la u ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsit lali ai tsingdu hta htu bun ai marang hte, Namlap hta htu hkrat ai marang ninghte zawn, Ngai sharin ai ga htu kahte nna, Nye a ga gaw mari zawn hkrat na ra ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa a mying ningsang hpe ngai hpaw dan ni ai; Anhte a Karai Kasang hpe shagrau mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai Lunghkrung, shi a magam hkum tsup nga ai. Shi a lam shagu dinghpring ai lam rai nga ai; Kangka re ai hte mara n rawng ai Karai Kasang, Dinghpring ai hte tengman, shi rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte hten byak masai, shi a kasha n rai, Agang chyalang kap ai hkrai rai ma ai; Myit manai ai hte magaw ai amyu rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Angawk ai hte myit n su ai amyu e, Yehowa hpe dai hku htang na mu ni? Shi nang hpe hkrang la ai kawa n rai lit ni? Shi nang hpe hpan da nna shagrin da nit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moi chyaloi nhkoi na hpe dum mu, Lai mat wa sai prat ni hpe aru yu mu; Na nwa hpe san u, shi tsun na ra ai, Dingla ni hpe gawn yu u, shanhte hkai dan na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tsaw Htum ai Wa gaw amyu ni hpe ninghtawn karan na, Shinggyim masha ni hpe hpajang tawn ai shaloi; Israela amyu ni a nambat sawn nna, Mungkan amyu ni a lamu ga jarit tawn da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa a kamhtaw chyawm gaw, shi a mayu rai nga ai, Yaku gaw shi a sali wunli rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Katsi katsang akrin ayang rai nna, Matse rai garu ai mali banda e, shi e mu la wu ai; Shi hpe makawp kawan, lahku lamai di ai hte Tinang myi sha hpe pawn maga wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kalang gaw shi a tsip hprun run nna, N kung u lung ni a ntsa e yan ai zawn, Shi shanhte hpe mapyen singkaw kahpyen nna pawn, Singkaw gunghtu e shalen nna awn wu ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi hpe woi wa ai wa, Yehowa hkrai, Maigan Hpara kadai lawm ai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ga ntsa tsaw grau ai shara hta shi hpe shajawn, Yi hkauna nsi naisi hte shi hpe shangawn wu ai: Machyu lunghtawn na lagat jahku, Nhpai lungkring na namman chyu mu shachyu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dumsu hta na htawbat hte sagu bainam hta na madoi chyu shat, Sagu kasha a sau tung, Bashan sagu la hte bainam sau dung, Kaja htum ai hkaulan mam lung, jaw sha wu ai: Tsabyi jahku mung, tsabyi si sai hta na nang lu ndai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yeshurun chyawm ga hpum sau nna lahkat wu ai: Hpum sau ai hte shing-yan bawng nna di di tawng tawng nang rai nga ndai; Dai rai ti, hpan wa Karai hpe shi kau da nna, Shi e hkrang la ai Lunghkrung hpe n sawn wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte gaw Hpara shaje hte shi hpe n ju shangun mu ai, Matsat shabat lam hte shi hpe shapawt mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang n re ai nat ni hpe nau, Tinang n chye ai Hpara ni hpe jau mu ai: Kaji kawa ni n hkrit n kang yu ai, Ya sha shang ai Hpara ni hpe jaw jau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang hpe sharat ai lunghkrung hpe n dum nit dai, Nang hpe shangai ai Karai Wa hpe malap nu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa dai mu nna, shi a shayi shadang sha ni hpe, Shanhte a mara majaw, matsat kau mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi tsun ai gaw, “Shanhte myit magaw ai amyu, Kangka n re ai kashu kasha ni rai ma ai;” Dai majaw, nye a myi man ngai makoi kau nna, Shanhte a lam jahtum hpe ngai yu yu na we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Karai Kasang n re ai hte shanhte ngai e n ju shangun nna, Shanhte a rai dum la ai myit hte shapawt mi ai: Dai re ai majaw, hti n mai ai amyu hte ngai shanhte hpe manawn shangun nna, Angawk angak re ai amyu hte shapawt na mawe ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nye a pawt bu ai hte wan nat dat nna, Sung htum ai katsan ga du hkra hkru wa ra ai: Ga hte de a nsi naisi hpe shakrawp kau nna, Bum ni a npawt pyi hkru mat nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shanhte a ntsa e ari zinli ngai dat dat na we ai, Nye a pala shanhte hta sharut bun na we ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte kawsi hpang kara, kahtet kamawt ari hkrum nna, Shoihpa shoirang kaba hte nyawp mat na mara ai; Matse labye a kawng mung, ga na rai matse a tuk mung, Shanhte hpang de ngai dat dat na we ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ndaw shinggan de na ari nhtu, Nhku kata de na hkrithpa amyu gaw, Mahkawn hte shabrang hpe n nga, Chyu chyu ai ma hte baw hpraw ai dingla hpe n da hkra, hpya kau na ra ai, nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai, ngai gaw, Masha hpyen wa myit tsaw wa na hpe, n tsang, Rawt gumlau ai ni gumrawng wa nna, Ndai amu nlang Yehowa di lu ai n rai, Anhte a lata nsam hte di sagaw ai, nga nna tsun na hpe n dang taw,
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte hpe tsan tsan ga de ngai shabra kau nna, Masha amyu hta na kadai n dum hkra shamyit kau na, myit se ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw byak ai amyu rai nga, Shanhte hta myit hpaji n rawng malu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shanhte hpaji byeng-ya lu la nna, ndai lam chye na lu mu ga law, Hpang jahtum e hpa byin hpa tai na, aru yu mu ga le!
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte a shamyet lunghkrung shanhte e dut ya ai n rai yang, Yehowa nan shanhte kaw ap kau ai n rai yang, Marai langai sha masha hkying mi hpe, Marai lahkawng e sha mun mi hpe, kaning rai hkan jahtaw kau lu a ta?
  </para>
  <para style="p">
    <verse number="31" style="v" />Anhte e hpyen ai ni shanhte nan pyi, Anhte a Lunghkrung gaw shanhte a Lunghkrung hte dang bung ai n rai, nga nna tsun lu ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shanhte a tsabyi ru gaw Sodom tsabyi ru, Gomora pa hkan e tu dam ai baw rai nga ai. Shanhte a tsabyi si gaw pila si rai nga ai, Tsabyi sumbaw mung hka ai hkrai rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shanhte a tsabyi jahku gaw lapu tuk, N hkru htum ai pu htum tuk rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ndai lam yawng ngai kaw htun da sai, Nye a sutdek hta dazik hte htep rai nga ai, n rai ni?
  </para>
  <para style="p">
    <verse number="35" style="v" />Matai htang na ahkang ngai lu da we ai; Shanhte a lagaw kashawt ai shani e, ngai tai na we ai: Kyin dut hkrum na nhtoi shanhte kaw du magang ra ai, Shanhte hkrum na ari gaw du lawan ra ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Yehowa gaw shi a amyu hpe tara dara na wu ai; Shi a masha ni n-gun htum mat ai hte, Bawng dung ai mi n nga, bawng lawt ai mi n pra ai hpe shi mu jang, Shanhte a matu myit malai lu ya na wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shaloi shi gaw, Shanhte a shamyet lunghkrung tai, Shanhte nawng jau ai sau man sha ai. Shanhte a ru hkaw kumhpa tsabyi jahku lu sai, Shanhte a gumgun Hpara ni gaw ya kanang rai malu ai i? Shanhte ya rawt nna, nanhte hpe karum u ga, Nanhte hpe ya magawp maga maru ga.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ngai dai, ngai nan, Karai wa rai nga nngai, Ngai hta kaga, Karai shaje n nga ai gaw, yu yu mu: Jasi ai mung, ngai, jahkrung ai mung, ngai, Jahpye ai mung, ngai, shamai ai mung, ngai, Nye lata na kadai n shaw la lu ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Sumsing lamu de nye a lata ngai ladawn nna, Htani htana ahkrung nga ai wa ngai rai nga nngai hte maren:
  </para>
  <para style="p">
    <verse number="41" style="v" />Nye a tu kabrim ai nhtu hpe ngai galaw karang nna, Nye a lata hpe tara dara na hkyen lang let, Gumlau ni hpe ngai matai htang nna, Ngai n dawng ai ni hpe ari jaw na mawe ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Si mana ai ni hte bawng yam ni a, Hpyen du ni hte du gyi ni a asai hte, Nye a pala hpe ngai shanang na we ai; Nye a nhtu mung, shanhte a shan sha na ra ai, ngu nna ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Maigan amyu ni e, shi a amyu hte rau kabu mu: Shi a ali ama ni a asai matai shi htang nna, Shi hpe gumlau ai ni e dawdan na mu ai; Shi a mungdan hte shi amyu a matu gawng malai hkungga shi jaw ya na ra ai, nga ai,” rai nga ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mawshe mung, Nun a kasha Hoshea hte rau sa nna, mahkawn mangoi ga ndai hte ting, amyu masha ni hpe hkai dan mu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shing rai Mawshe ndai ga mahkra Israela amyu nlang hte hpe azin ayang tsun shangut da nna, shanhte hpe,
  </para>
  <para style="p">
    <verse number="46" style="v" />“Dai ni ngai nanhte a man e hkam da ya ai sakse ga ndai hpe, nanhte a kraw lawang e mazing sumhting gun nga mu; nanhte a kashu ni ndai matsun maroi tara ga nlang hte hpe hkan shatsup nna nga mu ga, shanhte hpe nanhte bai htawn hkai da lu na rai myit dai
  </para>
  <para style="p">
    <verse number="47" style="v" />Kaning rai nme law, ndai gaw nanhte a matu amai ahkai ga sha n rai; dai gaw nanhte a asak hkrung lam rai nga malit dai: Yawdan hka rap nna shang sha na marin dai mungdan hta nde a marang e nanhte aprat galu wa na rai malit dai,” ngu nna tsun da wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Bai Yehowa gaw, dai shani jang Mawshe hpe,
  </para>
  <para style="p">
    <verse number="49" style="v" />“Yerihko hte tawtap, Moba mung na, ndai Abarim bum a Nebu ngu ai bum pungting de lung nna, Israela kashu kasha ni hpe ngai jaw ai Hkanan mung mada la u;
  </para>
  <para style="p">
    <verse number="50" style="v" />na nhpu Arun, Hora bum e si ai rai nna shi a amyu hpawng nga ai de du wa ai zawn, nang mung, ndai nang lung wa ai bum e si nna, na amyu hpawng nga ai de wa nu:
  </para>
  <para style="p">
    <verse number="51" style="v" />kaning rai nme law, Zin nam mali, Kadesha shara na, Meriba hka kau e, Israela kashu kasha ni a hpawng ka-ang e nan ngai e n shagrau n sha-a myit dai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Dai majaw, Israela kashu kasha ni hpe ngai jaw ai mung, dai hta shang sha lu na ndai n rai,” ngu nna tsun wu ai.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang a Masha Mawshe gaw, shi garai n si yang, ndai shaman ga hte Israela kashu kasha ni hpe ning nga shaman ya da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw “Yehowa, Sina bum nna yu wa ra ai, Seira bum shagawng kaw nna, shanhte a matu tu pru nga ai; Hparan bum ntsa e shi dan hkung nga ai; Chyoi pra ai ni mun sen kaw na du sa ra ai: Shi a hkra lata nna shanhte a matu tara wan tu pra nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai sa, dai amyu ni hpe shi tsawra wu ai. Shanhte a chyoi pra ni yawng, na a lata hta rai nga ai: Na a lagaw nhpang e shanhte dung ma ai; Na a mungga madat la nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mawshe anhte hpe jep ai tara, Yaku shawa hpawng a matu sali wunli, hkang da ya ma ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amyu lakung ni a du gyi ni hte, Israela amyu ting rau hpawng nga ai shaloi, Yeshurun hta shi hkawhkam rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rubin n si n htum, ahkrung nga u ga, Shi a kashu kasha ni chyawm gaw n law n htam manu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yuda amyu hpe chyawm gaw: Yehowa e, Yuda a nsen madat nna, Shi a amyu ni hpang de bai woi wa rit: Shi a lata gaw, shi a matu gasat nga ai; Masha hpyen ni a majaw, nang shi hpe karum la na ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lewi hpe gaw, Na a Htumim hte Urim tengman ai ai wa lang nga ai; Masa shara e nang shi hpe dinglik yu nit dai, Meriba hka makau e nang shi hte ndang hkat yu nit dai:
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw kanu kawa hpe pyi, kanu kawa n nga, Tinang hpunau wa hpe mung n da, Kashu kasha hpe pyi n chye, nga hkra, Na a mungga madat mara nna, Na a ga shaka hkan nang masai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte gaw na a matsun maroi ga Yaku hpe, Na a tara Israela hpe, sharin ya na mara ai: Manam pyaw hkungga na a man e, Wan nat hkungga na a tawn hkungri ntsa e, mara tawn na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa e, shi a kun dinghku shaman ya u, Shi a lata na magan amu hpe hkap la ya u; Shi e n dawng ai ni bai n rawt lu hkra agrawp kau u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ben-yamin hpe gaw, Yehowa a tsawra ai wa gaw, shi hte rau amu sha nga lu na ra ai: Shani tup shi hpe makawp maga na wu ai rai nna, Shi a du krang e shi dung nga lu na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yawsep hpe gaw, Matsaw tsang na reng seng ai rai ni hte mari e mung, Lamu tang shim ai de na sung ai shara hte mung;
  </para>
  <para style="p">
    <verse number="14" style="v" />Gumhtu gummai jan a dwi sau ai namsi namsaw hte mung, Shata ndaw nman e tu ai nsi naisi hte mung;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ju majat na bum ni a reng grau ai arai hte mung, Dinggrin anga nga ai kawng ni a reng ai sut hte mung,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ginding ganai hta na ngamu kumhpa hte mung, Dai singwum e rawng ai wa kaw na myi man pa ai hte mung, Yehowa gaw shi a mungdan hpe shaman ya u ga: Dai shaman chyeju gaw Yawsep a baw ntsa e, Kahpu kanau ni hte daw hka ai wa a majoi pungding hta e, anga nga nu ga.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi hta shawng hkrat ai usu gaw arawng sadang rai nga ai; Shi a nrung hpawlam nrung rai nga lu ai: Dai hte, masha amyu ni hpe lamu ga htum hkra, shachyut daru kau na mu ai. Dai ni gaw Ehprim a mun sen ni rai nga ma ai, Shanhte gaw Manashe a hkying mun ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zebulun hpe gaw, Zebulun e, na a pru lu ai lam hta kabu nga u; Yisahka e, na a sum hta kabu gara nga u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shan gaw amyu masha ni hpe dai bum de shaga la nna, Dai de tengman ai hkungga jaw na mara ai. Nammukdara na ngamu ngamai hte Zaibru kata na sut hpungnung chyu lu na mara ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gad hpe gaw, Gad hpe maden dat ai wa gaw, a nga u ga law; Shi gaw hkanghkyi kanu zawn nga nga nna, Lata e sha n-ga baw hpe pyi amya ga kau wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shawng san tawn ai kamhtaw shi lata la nna, Dai de, tara agyi wa a hkumbum madat da nga ai; Amyu ni a du agyi ni hte rau shi sa wa nna, Yehowa a dingman ai lam hte Israela hta tawn da ai tara lam hpe shatup wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan hpe gaw, Dan gaw hkanghkyi kasha rai nga ai rai nna, Bashan mung na htim na ra ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Naphtali hpe gaw, Naphtali e, chyeju hte hkru kat nna, Yehowa jaw ai shaman hpring ai hte, Sinna hte dingda maga madu sha nit ga law.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ashe hpe gaw, Ashe gaw kashu kasha hte a nga u ga; Shi a kahpu kanau ni hte myit hkrum u ga, Shi a lagaw namman hta madit nga u ga.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na a htinggrang ni gaw hpri hte magri rai na ra ai; Nang pra nga prat dingsa, na n-gun atsam mung ja nga na nit dai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yeshurun e, Karai Kasang hte bung ai kadai n nga ai; Nang hpe karum na nga, sumsing lamu hta yawn, Shi a hpung shingkang hte sumwi hta jawn nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyi nma Karai Kasang gaw na shingbyi shara rai nga ai, Htani htana lahpum ta gaw nang hpe pawn la nga ai. Shi gaw, Jahten shabya kau mu, nga nna, Hpyen wa hpe na a man na jahtaw kau wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai, nai mam hte tsabyi jahku ing ai mung hta e, Israela gaw nga ngwi nga pyaw rai nga nna, Yaku a hka hpawk chyu sha nga nga ai: Rai sa, shi a lamu de na mari hkrat abya nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israela e, nang a nga ndai: Yehowa hkye hkrang la ai amyu e, nang hte kadai bung a ta? Shi gaw nang hpe makawp maga ai ninggang, Na a shingkang shapraw ai nhtu rai nga ai. Na a hpyen ni nang kaw nawm nna, Shanhte a tsaw ai shara ni hpe nang kabye lu na rin dai,” nga nna tsun shaman ya wu ai.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Mawshe gaw Moba pa nna sa wa nhtawm, Yerihko hte tawtap na Nebo bum a Pisga kawng pungding de lung wa ai. Shaloi Yehowa gaw shi hpe Gilead mung ting hte Dan du hkra,
  </para>
  <para style="p">
    <verse number="2" style="v" />Naphtali ginwang ting hte, Ehprim, Manashe, Yuda mung ni hte tsan htum ai nammukdara du hkra,
  </para>
  <para style="p">
    <verse number="3" style="v" />Dingda mung hte, Zora mare du hkra, namhtan hpun mare ngu ai Yerihko mare de nga ai hkamwam hte pa ni hpe madun dan wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Yehowa gaw, “Abraham, Isak, Yaku hte hpe dagam nna, na amyu matu ni hpe jaw na ngu ndat da ai mungdan gaw dai rai nna ai; na amyi hte nan mu da lu ai ahkang ngai jaw de ai, rai timung, rap sa lu na n rai,” ngu nna Mawshe hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai Yehowa tsun ai hte maren, Yehowa a shangun kasa Mawshe gaw, Moba mung na shara dai yang si mat ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi hpe Bet-peora mare hte tawtap na Moba mung na hkaraw hta makoi mayang nu ai; rai timung, dai ni du hkra Mawshe a lupwa hpe kadai n chye ya ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mawshe gaw si wa ai shaloi, asak latsa e hkun ning du sai; shi a myi garai n mam, shi a n-gun atsam mun garai n yawm lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israela kashu kasha ni gaw Mawshe hpe dum nna Moba pa e nhtoi sumshi ya hkrap ngu hkrap ngoi rai nga ma ai: shing rai, Mawshe a matu sharung shayawt hkrap ai nhtoi gaw htum mat sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Nun a kasha Yawshu gaw hpaji byeng-ya Wenyi hpring ai wa rai nga ai: kaning rai nme law, shi a baw hta Mawshe e lata mara ya nu ai rai nna, Yehowa Mawshe hpe hkang da ya wu ai hte maren, Israela kashu kasha ni mung Yawshu a ga madat mara nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa e shangun dat nna, Egutu mung e Hpara-u kaw nna shi a hkringmang ni hte mungdan ting hta
  </para>
  <para style="p">
    <verse number="11" style="v" />lamik kumla mauhpa amu hkum sumhpa galaw ai hte, Israela amyu masha ni nlang a man e shi a galu kaba ai lahpum ta hte hkrithpa amu ni madun wa ai lam hta e,
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa hte tinang hkum nan myi man chyaw hkrum lu ai myihtoi Mawshe zawn re ai gaw, Israela amyu hta htawm hpang e langai mi muk paw pru yu ai n rai.
  </para>
</usx>
