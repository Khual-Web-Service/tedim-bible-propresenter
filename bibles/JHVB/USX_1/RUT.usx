<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="RUT" style="id">Ruhta</book>
  <para style="h">Ruhta</para>
  <para style="toc1">Ruhta</para>
  <para style="toc2">Ruhta</para>
  <para style="mt">Ruhta</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, tara agyi ni up ai aprat e, kalang wa mi, dai mungdan hta hku hku wa ai. Dai rai nna Yuda mung Betlehem mare na masha langai mi gaw, shi a madu jan hte shadang sha lahkawng woi nna, Moba mung e sa shingbyi na nga, pru wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai wa a amying gaw Elimelek, madu jan a amying gaw Naomi, kasha yan a amying gaw Malon hte Hkilion rai ma ai: shanhte gaw Yuda mung Betlehem na Ehprahta masha rai ma ai; shaloi shanhte Moba mung du nna, dai de nga nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya Naomi a madu wa Elimelek si mat nna, madu jan hte shadang sha lahkawng htawng da wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai shadang sha yan mung, Moba num la ma ai; langai mi gaw Orpa, langai mi gaw Ruhta mying ma ai; shing rai, shanhte gaw shi ning daram dai yang e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai shadang sha Malon yan Hkilion mung si mat ma ai rai nna, Naomi gaw kasha mung, madu wa mung n lu, shi khrai rai mat ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, dai numsha gaw Moba mung na bai wa na nga, kanam yan hte rau rawt wa ma ai: kaning rai nme law, Yehowa shi a amyu hpe kawan katsan yu wu ai rai nna, lusha bai jaw sai da, nga ai shi, Moba mung e na nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi shi gaw kanam yan hte rau shi shingbyi nga ai shara na pru nna, Yuda mung lam hku wa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Naomi chyawm gaw kanam yan hpe, “Wa manu, nan a nnu nwa nta de wa manu; nan gaw, si mat ai yan hpe mung, ngai hpe mung, galaw jaw manit dai hte maren, Yehowa nan hpe chyeju htang ya malit ga law.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nan bai wa na la ni a nta e, ngamu ngamai na matu, Yehowa nan hpe karum myit ga law,” ngu nna shan hpe pup wu ai. Shaloi shan gaw ja ja hkrap nna,
  </para>
  <para style="p">
    <verse number="10" style="v" />“An mung, nang hte rau na amyu ni hpang de wa na ga ai,” nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Naomi gaw, “Ngai nam yan e, she wa mu; ngai kaw hpa rai hkan wa na rai ta? Nan a madu wa tai ya na, nye a kan e kasha naw rawng a ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai nam yan gaw, she bai wa manu; ngai mung aprat lai sai rai nna, num bai wa htap sai n rai. Dai n rai nna, myit mada shara naw nga ai, ngu yang mung, dai na jang mi num wa nna shadang sha ngai shaprat hkra rai timung,
  </para>
  <para style="p">
    <verse number="13" style="v" />dai ni kaba hkra dang la nga na rai ni? Num n wa hkra, dai ni hpe myit mada nga lu na rai ni? Ngai nam yan e, n rai na re ai; Yehowa a lata ngai hta numdan nga ai majaw, nan a matu ngai nachying myit yu machyi nga nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing nga jang, shan ja ja bai hkrap ma ai; Orpa mahtang gaw kamoi hpe pup shakram kau da wu ai; Ruhta chyawm gaw shi hta a manoi nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Naomi gaw, “Yu u, na nna pyi tinang amyu, tinang Hpara hpang de bai wa sai; na nna kaw hkan nang wa su,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ruhta chyawm gaw “Nang hpe kau da nna, nang kaw n hkan lu na hku, ngai e hkum shagwi et; nang du shara shagu de ngai du na nngai; nang nga ai shara shagu e ngai nga na nngai: na a amyu gaw nye a amyu, na a Karai Kasang mung nye a Karai Kasang rai u ga;
  </para>
  <para style="p">
    <verse number="17" style="v" />nang si ai shara e ngai si nna, dai yang e makoi mayang hkam na nngai; si nna sha n rai yang gaw, kaga lam majaw nang hta ngai ahka sayang gaw, dai hta grau Yehowa ngai hpe deng n ga,” ngu nna bai tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ruhta mahtang hkan mayu ai myit, ting ting rai nga ai hpe, Naomi mu wu yang, shi atsin sha nga nga kau wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai shan lahkawng sa wa nna, Betlehem de du ma ai. Betlehem de du ma yang mare ting shan a majaw wu wu di di nga, “Ndai Naomi rai nga nni?” Nga nna num ni shada san shajang ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi chyawm gaw, “Ngai e, Naomi, hkum ngu ma ni; Mara she ngu mi; N-gun Chyalai rawng ai wa gaw, nachying hka ai hku ngai hpe shatai ni ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lu su hpring chyat pru wa nngai, Yehowa ngai hpe Kaman woi wa ni ai: Yehowa ngai hpe shagrit kau nna, N-gun Chyalai rawng ai wa, ngai hpe matsan shangun kau ni yang me, hpa rai ngai hpe Naomi naw nga nga myit ta?” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai, Naomi gaw, kanam Moba num Ruhta hte rau, Moba mung na wa ma ai rai nna, shan gaw muk-yaw mam dan ai aten e Betlehem de du ma ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Naomi a madu wa, Elimelek a amyu dap hta na, grai lu su ai hpunau wa langai mi nga ai; shi a amying gaw Bua rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Moba num Ruhta gaw, “Ngai yi de sa nna, ai nawn ai ni kaw, mam nlim hkan gut ni ga yaw,” ngu nna Naomi kaw hpyi wu ai. Naomi mung, “Sa su, ngai nam gaw,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ruhta mung sa nna, mam dan ai ni a hpang e nlim hkan gut wu yang, Elimelek amyu dap hpu na Bua a yi hta ndum shami sa ang wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Bua gaw Betlehem mare na sa nna, mam dan ai ni hpe, “Yehowa nanhte hte rau nga nga u ga law,” ngu wu ai. Shanhte mung, “Yehowa nang hpe shaman ya u ga law,” nga nna htan ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai Bua gaw, “Ndai numsha ma gaw, kadai kaw na rai ta?” ngu nna mam dan ai ni a agyi wa hpe san wu yang,
  </para>
  <para style="p">
    <verse number="6" style="v" />Agyi wa gaw, ‘Moba mung nna, Naomi kaw hkan nang wa ai, Moba numsha rai nga ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />shi mung, ‘Ngai mam dan ai ni a hpang e, mam hkauling hta na ngam ai nlim hkan gut la n ga yaw,’ nga nna shang gut nga ai; dai hpawt kaw nna, ya wa e, hkring mi sha nta e sa ai du hkra, gut nu ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Bua mung Ruhta hpe, “Ngai sha e, madat u; Yi gale de hkum sa gut; nang na n htawt ai sha, nye a shangun ma numsha ni hte kanawn nga u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte dan wa ai yi ngam yu nna, shanhte a hpang hkan u: lasha ma ni nang hpe n shatsang na lam, ngai hkang da se ai, n rai ni? nang hpang kara yang, dibu hta na lasha ma ni ja ai ntsin lu u,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Ruhta gaw ga de dingnyawm dagup nna, “Ngai maigan amyu numsha she re ai mi, nang madu ngai hpe shade wa gawn ai gaw, ngai hta myit du shara hpa wa nga a ta?” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Bua gaw, “Na a madu wa si ai hpang, na nmoi hpe nang galaw jaw ndai mung; nang na nnu nwa dai daw ga kau da nna, shawng de n chye ai amyu hpang de sa lu ndai mung, ngai hpe azin ayang tsun dan masai: na marai a akyu Yehowa nang hpe htang ya u ga law; shi a singkaw shingnip shingwung na nga, nang sit sa ai Israela Karai Kasang Yehowa gaw, chyeju hkum sumhpa, nang hpe jaw u ga law,” ngu nna shi hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ruhta mung, “Madu e, na a man e ngai myi man pa ni ga law; ngai wa, na a shangun ma numsha ni hte pyi n bung nngai wa; nang madu ga ngwi ga pyaw hte ngai hpe shalan nna, na a mayam jan hpe kabu shangun ni ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai, shat sha ai aten du jang, Bua gaw dai numsha hpe, “Wa rit, shat wa sha ru; ndai ntsin hkri hta na muk hkyep galu u,” ngu wu ai. Shaloi mam dan ai ni hte rau shi wa dung nna, Bua mung shi hpe mam nmyi jaw wu ai; shi mung sha hkru nna, ngam hkra rai nga lu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mam nlim gut na nga rawt sa wa yang, Bua gaw shi a ma ni hpe, “Dai numsha hkauling hkan na ngam ai nlim gut la u ga; shi e hkum jet myit.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkauling hta na mam kau mi mung, shi a matu ngam tawn da ya mu; shi e gut shangun u ga, shi e hkum daru myit,” ngu nna hkang da mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ruhta mung, dai yi hta shana de du hkra gut nna, lu la ai hte hpe dup wu yang, muk-yaw mam bye mi daram lu la wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpe gun wa nna mare de bai wa ai; shi gut lu ai mam dai kamoi hpe wa madun wu ai; shi sha hkru nna ngam tawn ai nmyi mung, shi hpe jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi kamoi gaw, “Dai ni kanang sa gut n ta? Kanang sa galaw n ta? nang hpe hkap shachyen la ai wa gaw, a nga u ga law,” ngu wu ai. Ruhta mung, “Dai ni ngai sa gut ai yi madu a amying gaw Bua rai lu ai,” nga nna shi a lam kamoi hpe tsun dan wu ai,
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai kamoi gaw, “hkrung nga ai ni hpe mung, si mat sai ni hpe mung chyeju jaw n jin ai wa hpe Yehowa shaman ya u ga law,” ngu nna kanam hpe tsun wu ai. Bai Naomi gaw, “Dai wa gaw anhte hte grau ni ai amyu dap, anhte a nta chyen rai nga ai,” ngu nna shi hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Moba num Ruhta gaw, “dai wa mung, mam dan tawm ai du hkra, nye a ma ni hte kanawn wa u, nga ai,” ngu nna kamoi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Naomi mung, “Ngai nam e, nang shi a shangun ma numsha ni hte kanawn ai grau mai nga ai; yi kaga de nang hpe n mu shangun mai ai,” ngu nna kanam Ruhta hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai shi gaw, muk-yaw mam hte hkaulan mam dan tawm ai du hkra, Bua shangun ma num ni hte kanawn let, mam nlim gut nna, kamoi hte rau nga nga ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi kamoi Naomi gaw, “Ngai nam e, nang hpe ngamu ngamai shangun na matu, na a nga pyaw nhpang ngai n tam na rai ni?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya nang kanawn nga ai manang num ni a madu Bua gaw, ndai nta ni a nta chyen rai nga ai n rai ni? Yu u, dai na shi chyarang e muk-yaw mam yit nna nga nga na la ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna, nang hka shin, sau chya rai nna, hpun palawng sumli la nhtawm chyarang de sa su: rai timung, shi shat garai n sha ngut jang, na hkum shi hpe hkum madun et.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi yup yang she shi a yup ra matsing la nhtawm, shang wa u, shi a lagaw magap ai nba kawaw nna, hkan taw lawm u: shaloi nang kaning rai na gaw shi tsun na ra ai,” ngu nna achyin dat wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ruhta mung, “Nang tsun matsun ngai galaw na nngai,” nga nna shi e tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi shi chyarang de yu wa nna, kamoi tsun ai hte maren galaw wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya Bua gaw lusha ngut nna myit pyaw let, mam sumpum makau e sa yup nga ai: shaloi Ruhta mung, atsin sha sit sa nhtawm, shi a lagaw magap ai nba kawaw nna taw lawm nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya yuptung hpawa e la wa gaw kajawng nna, kayin dat yang, yu u, numsha langai shi a lagaw nhpang e taw nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi shi gaw, “Nang kadai rai ta?” ngu wu yang, “Ngai na a mayam jan Ruhta rai nga nngai; nang gaw ngai e hta ang ai nta chyen rai ndai majaw, na a mayam jan hpe, na pahpun hte jahpum la ni,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bua mung, “Ngai sha e, Yehowa nang hpe shaman ya nit ga law; nang sut su ai la shabrang, matsan ai la shabrang kadai hpe mung n myit ndai majaw, shawng na galaw jaw ai chyeju hta, hpang na chyeju grau kaba salit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai re ai majaw, ngai sha e, hkum tsang et; nang hpyi mahpyi ngai galaw na nngai: nang sari rawng ai num rai nga ndai gaw, nye a mare na masha ni nlang chye ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai mung, nang hpe hta ang ai nta chyen re ai gaw, teng nngai; rai timung, ngai hta grau ni ai hpunau wa langai mi naw nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai na gaw naw nga nu; hpawt ni e lam ang ai hte maren, dai wa, shi hta mayu yang, hta u ga; hta sa yang mung mai sai: shi n hta mayu yang gaw, Yehowa anga nga ai hte maren ngai hta na de ai; nhtoi htoi hkra naw yup nga u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ruhta mung, jahpawt du hkra shi a lagaw nhpang e yup nga nna, shada garai n mu hkat ai aten daram e rawt wu ai. La wa mahtang, “Ndai chyarang de num sa ai, kadai hpe hkum chye shangun yaw,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai shi gaw, “Na nba la wa nna hpyan tawn ru,” ngu wu ai; dai hte maren shi hpyan tawn nna, Bua gaw, shi a matu muk-yaw mam bye kru hteng ya nna, shi hpe shagun dat ya wu ai: shi mung, mare de bai wa ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kamoi kaw du wa jang, shi gaw, “Ngai nam, kaning rai ta?” Ngu nna hkap san wu yang, Ruhta gaw, shi hta dai wa galaw ai lam mahkra hte tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai shi, “Na nmoi hpang de kaman hkum wa,” nga nna, ndai muk-yaw mam bye kru jaw dat ai mung, tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi kamoi gaw, “Ngai nam e, ndai amu kaning rai ngut wa na, chye lu hkra, naw la madat yu u: la dai re ai gaw, dai ni amu ndai n ngut ai, n tawn da na nu ai,” ngu wu ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Bua gaw mare chyinghka de sa dung nna, shana e shi tsun ai hpunau wa lai wa jang, “Wora hpawa wa e, nang de naw kayin dung yu rit,” ngu nna shaga wu ai. Dai wa mung kayin nna, dung nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mare na salang marai shi hpe mung shaga nna, “Nang e dung yu marit,” ngu wu ai. Shanhte mung dung ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Bua gaw dai hpunau wa hpe, “Moba mung na bai wa ai Naomi gaw anhte a hpunau wa Elimelek a ga dachyawk dut na re ai majaw, nang hpe shana nga nngai;
  </para>
  <para style="p">
    <verse number="4" style="v" />ya nang e dung nga ai ni hte, nye mare salang ni a man e, nang, mari u,” ngu nna bawng mayu nga nngai: nang shaw mayu yang shaw u; shing n rai, ngai hpe tsun e; nang hta kaga shaw ang ai masha shaje n nga ai; nang hta na lai jang gaw ngai hta ang sai,” ngu wu ai. Dai wa mung, “Ngai shaw na,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai Bua gaw, “Dai ga dachyawk hpe Naomi lata na mari ai shani e, si mat ai wa a sali ga majaw, shi a amying n mat na matu, shi a madu jan Moba num Ruhta a lata na mung mari ra na re ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi dai hpunau wa gaw, “Dai rai yang gaw ngai n mari lu na nngai; mari yang mung, nye a sali ga jahten na tai ai: dai majaw ngai n shaw lu ni ai; nang shaw la nu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya, moi shawng e Israela amyu hta ning re ai htung nga malu ai: rai hkrang shaw ai lam, rai galai ap ai lam, shagrin yang, langai wa gaw shi a kyepdin raw nna, langai wa hpe ap ga ma ai: shing rai Israela amyu hta sakse grin malu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Bua hpunau wa gaw, “Nang mari u,” nga nna shi a kyepdin raw wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Bua gaw, agyi salang ni hte shawa masha ni hpe, “Elimelek a sali ngu na, Hkilion a sali hte Malon a sali yawng, Naomi a lata na ngai mari se ai gaw, dai ni nanhte nye a sakse ni rai manit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hta kaga, si ai wa a amying hpe shi a kahpu kanau hpawng hta na mung, shi rawng ai mare a chyinghka kata na mung n htum mat hkra, shi a sali ga hta e shi a amying madat da na matu, Malon a gaida, Moba num Ruhta hpe, nye a num shatai na, ngai mari se ai mung, dai ni nanhte sakse rai manit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai chyinghka lam e dung lawm ai shawa masha ni hte agyi salang ni nlang hte mung, “Anhte sakse rai saga ai: na nta e pru ai num ndai gaw, Israela amyu hpe shaprat ai num Rahkela yan Lea zawn taw wa hkra, Yehowa hpajang ya nit ga law, Nang rai timung, ndai Ehprahta e n-gun nsam ja wa nna, Betlehem mare e arawng dan hkung nit ga law
  </para>
  <para style="p">
    <verse number="12" style="v" />Aprat garai n kaba ai, ndai num hta Yehowa jaw ya na ra ai amyu matu a marang e, na a lakung lama ni, Yuda madu jan Htama shaprat ai Hparet lakung lama zawn rai nga u ga law,” ngu nna shaman mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai Bua gaw Ruhta hpe kahkyin la nna, shi a madu jan shatai wu ai: Bua mung shi kaw shang nna, Yehowa chyeju hte shi na-um nasin rai nhtawm shadang sha shangai ya wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai re ai majaw numsha manang ni gaw Naomi hpe, “Dai ni, na nta matu n jahtum ya ai Yehowa gaw a nga u ga law; ya shangai ai wa mung, Israela amyu hta arawng dan hkung nga u ga law.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang hpe tsawra nna, shadang sha sanit lu ai hta, grau akyu nga ai, na nnam gaw, dai ma hpe shangai ya nit dai majaw, shi gaw na aprat nhtang ya ai wa, nang hpe aprat ugut gu hkra bau lahku ai wa, tai na ra ai,” ngu nna shaman mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Naomi gaw ma dai hpe la nna, shi a lahpyen e pawn ba maka wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi a htingbu jan ni mung, “Naomi shadang sha lu nu ai,” nga ma ai rai nna, ma dai hpe Obed, ngu shamying mu ai: dai wa gaw, Dawi a kawa Yese hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Da ndai gaw Hparet a lakung lama ni a ahtik labau rai ma ai: Hparet a kasha Hezron;
  </para>
  <para style="p">
    <verse number="19" style="v" />Hezron a kasha Ram; Ram a kasha Aminadab;
  </para>
  <para style="p">
    <verse number="20" style="v" />Aminadab a kasha Nashon; Nashon a kasha Salmon;
  </para>
  <para style="p">
    <verse number="21" style="v" />Salmon a kasha Bua; Bua kasha Obed;
  </para>
  <para style="p">
    <verse number="22" style="v" />Obed a kasha Yese; Yese a kasha Dawi, rai nga ma ai.
  </para>
</usx>
