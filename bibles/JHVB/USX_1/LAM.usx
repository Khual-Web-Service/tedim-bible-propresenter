<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LAM" style="id">Sharung Shayawt</book>
  <para style="h">Sharung Shayawt</para>
  <para style="toc1">Sharung Shayawt</para>
  <para style="toc2">Sharung Shayawt</para>
  <para style="mt">Sharung Shayawt</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha law ai mare gaw, ya kaning rai shi hkrai lik lik dung nga a hka! Masha amyu ni hta galu kaba ai num gaw, gaida jan zawn tai wa sahka! Mungdaw ni a du jan gaw, ya hkansi bang nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw shana e ja ja hkrap nna, shi a shabyi myi prwi hte nyaw nga ai; Shi a sumtsaw sumra ni mahkra hta, shi hpe shalan shabran ai wa n nga ai: Shi a kanawn manang ni yawng, shi hpe hkalem kau nna, shi hpe hpyen ai ni tai wa masai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yuda gaw nni nkri hte mayam amu kaba hkrum ai majaw, bawng dung wa sai; Shi gaw maigan amyu ni hta dung nna, gan ga lu na n rai: Hkan shachyut ai ni yawng, gyip ai shara e shi hpe dep mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kadai mung poi de n sa ai majaw, Ziun a lam ni yawn nga ai; De a chyinghka ni yawng shingran katsi nga ai; hkinjawng ni madai nga ma ai; Mahkawn ni yawn nga nna, shi hkum nan myit ru nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi law la ai yubak a lam, Yehowa shi hpe ari jaw ai majaw, Shi hpe n dawng ai ni baw tai wa nna, shi hpe hpyen ai ni galu kaba wa ma ai: Shi a ma kaji ni hpe mung, hpyen ni bawng rim wa manu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ziun shayi sha a hpung shingkang yawng wai mat sai; Shi a du ni gaw, ushat n mu ai shan nga hte bung nna, N-gun yawm ai majaw, hkan shachyut ai ni a man a hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mung masha ni gaw hpyen ni a lata de du nna, karum ai wa n nga ai majaw, Hpyen ni shi hpe mu mada nna, shi myit htum ai lam asawng nga ma yang, Yerusalem gaw nni nkri hte hki ba hkrum ai shani e, moi shawng na pyaw lam ni hpe dum nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yerusalem gaw grai shut hpyit ai majaw, matsat shabat tai wa sai; Shi hpe hkungga ai ni nlang, shi singgu krin rai nga ai hpe mu nna, shi hpe n kaw n law di kau mu ai: Gaja wa shi madai nga nna, kanut mat wa ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a n san n seng ai dan leng nga timung, htawm hpang e hkrum na ra ai lam hpe n dum nga ai; Dai re ai majaw shi mau hkra shagrit kau ai hkrum nna, shi hpe shalan shabran ai wa n nga ai: Yehowa e, ngai hkrum ai nni nkri hpe yu u; hpyen wa gaw shi hkum hpe shagrau wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hpyen wa gaw, shi a ngamu ngamai ai mahkra hpe kashun la nu ai; Na a shawa hpawng hta n mai shang ai, nga nna nang hkum da ai maigan amyu ni gaw, Shi a chyoi pra ai shara de shang wa ai hpe, shi mada mu nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi a masha ni yawng madat let, muk tam nga ma ai; Prawn wa lu hkra, tinang a hpu ai baw hpe, shahpa hte galai ma ai: Yehowa e, mada yu u; ngai shagrit kau ai hkrum nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ndai lam lai ai ni yawng hte e, nanhte hpa n nawn myit ni? Yehowa gaw shi pawt bu ai nhtoi hta, nye ntsa e shapraw ai yawn hpa zawn, Yawn hpa kaga naw nga ai kun, myit sumru yu mu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nye a nrut nra ni hpe a mani di kau na, ntsa de na wan shi shangun dat wu ai. Nye a lagaw lu na matu shi mahkam hkam nna, ngai hpe shabai kau ni ai: Shani tup myit garen ai hte gawng kya shangun nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai shut hpyit ai kandang hpe, shi a lata hte gyit da nu ai; Dai ni gaw gumhpawn nna nye du hta mara nga ai; shi gaw nye n-gun hpe shayawm kau nu ai: Madu gaw, ngai n hkap daw lu ai ni a lata hta, ngai hpe ap kau ni ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu gaw nye a share ni yawng hpe, nye a ka-ang e jahti kau da mu ai; Nye a shabrang ni hpe, shamyit kau na matu, shi shawa hpawng shaga mu ai: Madu gaw Yuda shayi sha hpe, tsabyi htumbyen hta kabye kau nu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai majaw ngai hkrap nna, myi prwi abya nga nngai; Nye a asak hpe lahku na, shalan shabran ai wa gaw, ngai hte tsan nga ai: Hpyen wa dang ai majaw, nye a kashu kasha ni htum mat masai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ziun gaw shi a lata ladawn timung, shalan shabran ai wa n nga ai: Yehowa gaw, Yaku grup yin e, hpyen ni hpe san da nu ai; Yerusalem gaw shanhte hta matsat shabat zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa gaw dinghpring nga ai; ngai mahtang shi a ga tawt lai nngai: Amyu baw ni e, madat nna, nye a yawn hpa hpe sumru yu mu: Nye a mahkawn ni hte shabrang ni hpe, bawng rim mat wa manu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai gaw sumtsaw ni hpe shaga ni ai; shanhte ngai hpe hkalem kau ma ai; Nye a hkinjawng ni hte nye a salang ni gaw tinang asak bau na, lusha tam yang pyi, Mare kata e nsa hti mat masai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa e, mada yu u; ngai ruyak hkrum nngai; ngai myit law nngai; Ngai grai wa gumlau nngai majaw, nye a kraw hta nye myit gale galau nga ai: Shinggan e nhtu kawa sha nga ai; nhku de si du nga ai zawn rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngai madai ai hpe shanhte na timung ngai hpe shalan shabran ai wa n nga ai; Ngai hkrum ai ruyak hpe hpyen ni yawng na lu nna, ndai lam nang shabyin ai majaw, shanhte kabu nga ma ai. Nang ndat da ai nhtoi nang shadu nna, shanhte gaw ngai zawn tai mu ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte a yubak mahkra hpe nang sawk yu u: Ngai grai wa madai nna gawng kya nga n ngai majaw, ngai tawt lai ai a jaw e, nang ngai hpe di ai zawn, shanhte hpe mung di mu.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu gaw pawt sindawng ai sumwi hte, Ziun shayi sha hpe, kaning rai ka-up nga a hka! Shi gaw Israela hpung shingkang hpe lamu kaw nna ga du hkra jahkrat kau nu ai: Shi pawt bu ai shani hta, shi a lagaw mara ai lahkum hpe shi dum nga ai, n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu gaw matsan n dum ai, Yaku a shara ni yawng hpe mayu kau nu ai; Shi pawt bu ai hte Yuda shayi sha a hpyen dap ni hpe sharun kau nu ai: Shi dai dap ni hpe ga de jahkrat kau nna, mungdan hte du salang ni hpe awu asin di kau manu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi pawt bu nna, Israela nrung yawng hpe daw kau nu ai; Hpyen ni a man e shi a hkra lata dawm la nu ai: Shara shagu hkru ai sharaw zawn, Yaku hpe hkru kau nu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hpyen wa zawn shi ndan shachyen nna, shi a hkra lata sharawt let, gumlau ni a maga e tsap nga ai; Tsawm htap ai ni yawng hpe, shi sat kau nu ai; Ziun shayi sha a sum kata de, wan zawn shi a pawt sindawng ai hpe ru dat nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu gaw hpyen wa zawn tai nna, Israela hpe mayu kau nu ai; Shi gaw htingnu ni mahkra hpe mayu kau nna, shi a hpyen dap ni hpe run kau nu ai; Shi gaw Yuda shayi sha a yawn hkyen ai hte sharung shayawt ai hpe, shalaw nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw shi a wang hpe sun zawn aja awa la kau nna, shawa zuphpawng shara hpe jahten shabyak kau nu ai; Ziun mare e galaw ai ndat da ai poi hte, laban nhtoi hpe, Yehowa malap kau shangun nu ai: Shi pawt sindawng let, hkawhkam wa hte hkinjawng wa hpe mung, n kaw n law di kau nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa gaw shi a tawn hkungri hpe kabai kau nna, shi a chyoi pra ai shara hpe matsat kau nu ai; De a htingnu bunghku ni hpe, hpyen ni a lata de ap kau nu ai: Ndat da ai poi shani zawn, hpyen ni gaw Yehowa a nta hta garu nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw Ziun shayi sha a bunghku hpe agrawp kau na maw nga ai: Shi gaw shadawn sumri hpe gran nna, jahten shabyak na matu, shi a lata dawm la ai n rai: Shi gaw kaduk hte bunghku sharung shayawt shangun nna, dai ni rau nyawp mat ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a chyinghka ni gaw ga hta lupwa nna, shi gaw de a htinggrang ni hpe agrawp kau nu ai: Shi a hkawhkam hte du salang ni gaw, tara n chye ai amyu hta lawm mat ma ai; Gaja wa shi a myihtoi ni gaw, Yehowa kaw na shingran n hkam la lu ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ziun shayi sha a salang ni gaw, ga ntsa e dung nna, atsin sha nga nga ma ai; Shanhte gaw tinang a baw ntsa e ga nhpu hpe bun nna, lachyit nba lawai ma ai. Yerusalem a mahkawn ni gaw, ga du hkra gum dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye amyu a shayi sha hten byak hkrum nna, ma kaji ni hte chyu chyu ai ni gaw, mare lam ni hta htan mat ma ai majaw, Nye a myi, myi prwi hte a mam nna, ngai myit law nga nngai: Nye a masin ga ntsa e ru jawng nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ma ni gaw, N-gu hte tsabyi jahku kanang nga a ta? nga nna kanu ni hpe san let, Hkala nba hkrum ai ni zawn, mare lam ni hta htan mat nna, Kanu a lahpyen e nsa hkyet mat masai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yerusalem shayi sha e, na a amu hta ngai hpa sakse madun na rai ta? nang hte hpa shadawn na rai ta? Ziun a shayi hkawnsek e, nang hpe shalan shabran na matu, nang hte hpa shabung na rai ta? Na a hten run ai gaw nammukdara zawn dam nga ai majaw, nang hpe shamai lu na, kadai wa rai ta?
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a myihtoi ni gaw masu ai hte kaman lila lam, na a matu htoi ma ai; Bawng dung kaw na nang lawt wa lu hkra, shanhte na a yubak hpe madun ma ai n rai; Shanhte gaw masu ai shingran hte shayit ai lam, na a matu htoi ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lam e lai wa ai ni yawng, “Ataw, masha ni kajai ai hte maren, Ndai mare gaw, Tsawm Htum ai hte, Ga ntsa ting a kabu gara shara ngu na mare rai ni?” Nga nna san let, Yerusalem shayi sha hpe lahpawk dum nna, lahpyaw let baw kanga nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hpyen ni yawng nang hpe n-gup mahka ma ai; Shanhte gaw, “Anhte shi hpe mayu kau gaw ai; gaja wa ndai shani gaw, anhte myit mada ai shani rai nga ai; anhte tam mu sagaw ai, Nga nna asawng let, wa utik ai hte tsun ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa gaw, shi maw ai hku shabyin nu ai; moi kaw nna shi tsun ai ga hpe shadik nu ai; N lahpawt ai shi agrawp kau nu ai: Shi gaw hpyen wa hpe, na ntsa e kabu shangun nu ai; nang hpe hpyen gasat ai ni a nrung hpe, shatsaw nu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte a myit masin Madu hpe jahtau nga ai; Ziun shayi sha bunghku e, na a myi prwi gaw, hka nu zawn, shani shana lwi u ga: Tinang dai hkum jasim kau et; na a myi tum hpe mung hkum magap kau et.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rawt u, shana ladaw da ai aten hkan nna jahtau u; Madu a man e na a myit masin hpe ntsin zawn ru dat u: Kawsi ai majaw lam she shagu hkan e htan mat ai, na a ma kaji ni a asak jahkrung da na lam, shi hpang de na a lata ladawn u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa e, yu u; nang kadai hpe ningrai galaw yu ga ai, sumru yu u; Num gaw, tinang nshang na hkrat nna, tinang pawn ai kasha hpe sha lu na rai ni? Hkinjawng hte myihtoi wa gaw, Madu a chyoi pra ai nta hta sat kau ai hkrum mai na rai ni?
  </para>
  <para style="p">
    <verse number="21" style="v" />Dingla ni hte ma ni gaw, mare lam ni hta kadawng taw ma ai; Nye a shabrang ni hte mahkawn ni gaw, nhtu hte si ma masai; Nang pawt bu ai shani hta, nang shanhte hpe matsan n dum ai, kahtam sat kau manu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ndat da ai poi shani hta, masha ni hpe shaga ai zawn, nang nye a grup yin e hkrithpa hpe shaga tawn nu ai; Yehowa a pawt bu ai shani e kadai mung n lawt, kadai mung ngam nga lu ai n rai: Ngai pawn ba nna kaba wa shangun ai ni hpe, hpyen wa gaw shamyit kau nu ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Wa a n-yun bu ai ri duk npu e nni nkri hkrum ai wa ngai nan rai nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi ngai hpe dun la nna, nhtoi hta n rai, nsin hta hkawm shangun nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gaja wa shi a lata, ngai hpe shani tup, atit anang ari jaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a shan hte ahpyi hpe, shi tsam shangun nna, nye nrut nra hpe agrawp kau nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi nye a man e kaduk htu nna, gung hte hki ba ai, wang tawn nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moi na si mat ai ni hpe zawn, shi ngai hpe nsin hta nga nga shangun ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai n pru lu hkra shi nhpan kum nna, ngai hpe gyit ai hpri sumri hpe shali wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gaja wa ngai shaga nna tawngban timung, shi nye a akyu hpyi ai ga hpe gang kau nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai sa wa ai lam hpe, tawk ai nlung hte shi kum nna, magaw ai lam hku sa wa shangun nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi nye a man e mayun ai tsap hte, gyem nga ai hkanghkyi zawn, rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi ngai hpe lam yit shangun nhtawm, kahtum gadaw di nna, shaza kau ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi ndan shachyen nna, ngai hpe gap na mahta shara shatai ni ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw shi a pala ni hpe, nye a nhkyun hta htinggrang shangun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai gaw, nye a amyu masha ni hta, asawng asang shara, shani tup laka ga hte shatan nhkan shara, tai wa ni hka.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi ngai hpe hkri hkup ai hte jahpring nna, lashi pila hte shanang ni ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi ngai hpe zaibru jaw shalawm nna, nye wa agrawp mat sai; shi ngai hpe wan dap hte hte bun ni ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang gaw nye a myit masin hpe ngwipyaw ai hte tsan tsan jahka kau nna, ngamu ngamai lam hpe ngai malap kau ni ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna ngai gaw, Nye n-gun atsam hte, Yehowa kaw na myit mada ai lam, wai mat sai,” nga nna tsun nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai hkrum ai nni nkri hte ruyak ai, lashi pila hte gung hpe, dum law.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a myit masin gaw dai hte hpe naw adum nga nna, gum dagup nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a myit masin dai lam sumru yu nga ai rai nna, ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa a chyeju majaw sha, anhte n htum mat ga ai; shi a matsan dum ai myit ma mat chye ai, n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai gaw jahpawt shagu ningnan rai nga ai; na a kangka myit galu kaba nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa nye a kumhtaw rai nga ai, nga nna nye a myit masin tsun lu ai majaw, shi hta ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa gaw, shi hpe ala nga ai ni hte, shi hpe tam ai myit masin hpe, chyeju madun nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Masha wa gaw myit mada nna, asim sha nga let, Yehowa a hkye hkrang la ai lam ala nga na, shi a matu mai kaja nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Masha wa gaw, brang ram prat e kandang hpai na, mai kaja nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai gaw shi ntsa e mara nga ai majaw, shi hkrai dung nna, atsin sha nga u ga.
  </para>
  <para style="p">
    <verse number="29" style="v" />Myit mada shara nga nhten, nga nna tinang a n-gup hpe ga nhpu hta amawp u ga.
  </para>
  <para style="p">
    <verse number="30" style="v" />Tinang a shabyi kayat ai wa hpe ja ya nna, shatan nhkan hte shi hpring chyat nga u ga.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaning rai nme law, Madu gaw tutnawng kau da ai n rai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shi yawn hkyen jahkrum timung, shi n-gaw nwai ai myit law htam nga ai hte maren, shi matsan naw dum na ra ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shi gaw dingsa myit hte shinggyim masha ni hpe zingri nna yawn hkyen shangun ai, n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mungdan a bawng dung ai ni hpe, lagaw hte kabye anin kau na mung,
  </para>
  <para style="p">
    <verse number="35" style="v" />Masha hkrum ging ai tara hpe, Tsaw htum ai wa a man e sharun kau na mung,
  </para>
  <para style="p">
    <verse number="36" style="v" />Masha wa a amu hpe shanut kau na mung, dai Madu n yu ra ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai Madu n htet da ai rai yang, tsun nna shabyin lu ai wa gaw, kadai wa rai ta?
  </para>
  <para style="p">
    <verse number="38" style="v" />Tsaw Htum ai Wa a n-gup na, mai kaja ai hte dingnye pru ai, n rai ni?
  </para>
  <para style="p">
    <verse number="39" style="v" />Asak hkrung ai wa gaw, hpa majaw put ngun nga a ni? masha wa gaw tinang a yubak majaw, put ngun nga u ga.
  </para>
  <para style="p">
    <verse number="40" style="v" />Anhte gaw, tinang hkan ai lam hpe sagawn yu nna, Yehowa hpang de nhtang wa saga.
  </para>
  <para style="p">
    <verse number="41" style="v" />Sumsing lamu e nga ai Karai Wa hpang de, myit masin hte lata sharawt ga.
  </para>
  <para style="p">
    <verse number="42" style="v" />Anhte tara tawt lai nna, gumlau saga ai; nang yubak raw dat kau ai, n rai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nang pawt sindawng ai lawai nna, anhte hpe shachyut mi ai; nang sat kau nna, matsan hpa n dum ndai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Akyu hpyi ai ga, nang hpang de n hkrang lu hkra, sumwi hte na hkum hpe ka-up kau ndai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nang gaw, masha amyu ni hta, anhte hpe shanut shanaw hte matsat shabat shatai kau mi ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hpyen ni yawng, anhte hpe n-gup hpaw mahka nga ma ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hkrit gari ai hte nsung hku, marawng marang hte hten byak ai gaw, anhte a ntsa e du sai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Nye amyu a shayi sha hten byak hkrum ai majaw, nye myi hka nu zawn lwi abya nga ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Yehowa gaw sumsing lamu de na gum yu nna, matsing nga ai du hkra,
  </para>
  <para style="p">
    <verse number="50" style="v" />Nye a myi prwi, n sim n sa tutnawng a lwi nga ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Nye mare shayi sha yawng a majaw, nye a myi ngai hpe kawa machyi shangun nga ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Mayu lakdik e ngai hpe hpyen ai ni gaw, u hpe zawn, ngai hpe hkan tam ma ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Shanhte gaw nhkun hta nye a asak hpe jahtum nna, nye a ntsa e nlung dip da ma ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Nye a baw ntsa e hka lim nna, “Ngai htum mat ni ai,” nga nna ngai tsun nngai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Yehowa e, ngai gaw sung ai nhkun kata nna, na amying shaga nngai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nang gaw nye a nsen hpe na nu ai; ngai madai ai hte shabam yang, na a na hpe hkum kayin kau et.
  </para>
  <para style="p">
    <verse number="57" style="v" />Ngai nang hpe shaga ai shani e, nang sit sa nna, “Hkum hkrit et,” tsun nit dai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Madu e, nang gaw nye a myit masin hte seng ai amu maga nna, nye a asak hpe hkrang la nit dai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Yehowa e, ngai hkrum ai zingri zingrat hpe nang mu nit dai; nye a amu dawdan ya e law.
  </para>
  <para style="p">
    <verse number="60" style="v" />Shanhte ngai hpe gumlau nna, maw ai hku mahkra hpe nang mu ndai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Yehowa e, shanhte shatan nhkan ai hte, ngai hpe maw ai hku mahkra hpe mung,
  </para>
  <para style="p">
    <verse number="62" style="v" />Ngai hpe mara shagun ai ni a n-gup hte, shani tup nye a lam n kaja ai hku maw ai ni a ga hpe, nang na nit dai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Shanhte adung nga ai hte rawt wa ai hpe mada yu u; ngai gaw shanhte a laka shagawp shara tai ni ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Yehowa e, shanhte a lata galaw ai amu hte maren, nang shanhte hpe nhtang tai na ndai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Nang shanhte a myi masin hpe shaja nna, shanhte hpe dagam kau na ndai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Nang pawt bu hte shanhte hpe hkan shachyut nna, Yehowa sumsing lamu npu na, shamyit kau na mu ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aja gaw kaning rai sum mat sahka! Jet ai ja gaw kaning rai galai mat sahka! Chyoi pra ai nta na nlung ni gaw, mare lam njut nnaw hkan e jawng nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jet htum ai ja hte bung ai, hpu la ai Ziun a shadang sha ni hpe, Di bu sama a lata hte galaw ai ga dibu zawn, kaning rai nawn da wu hka.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nam gwi ni pyi, tinang a hkalung ni hpe chyu shachyu chye ma ai; Nye a amyu shayi sha chyawm gaw, zaibru jang na u gawla-uk zawn gumshem nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chyu chyu ai ma gaw, chyu karut ai majaw, tinang a shinglet gumra hta kap mat nga ai; Ma kaji ni muk hpyi timung, karan jaw ai wa n nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mu mu mai mai sha ga ai ni gaw, shingbyi shara kata, mare lam ni hta nga nga ma ai: Hkyeng mang ai yup ra ntsa e yup ga ai ni gaw, nga hkyi sumpum machyu nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaning rai nme law, kadai mung n-gun n dat ai, akajawng sha hten byak hkrum ai, Sodom mare a yubak hta, Nye amyu shayi sha yubak gaw, grau kaba nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a arawng lu ai ni gaw, hkyen hta grau san pra nna, nga chyu hta grau hpraw nga ma ai; Shanhte a hkum shan gaw, lung hkyeng hta grau hkyeng nna, de a ningja nila lungseng hte bung nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya chyawm gaw shanhte nsam, nra hta grau chyang nga ai; mare lam ni hta kadai mung shanhte hpe n chye ma ai; Shanhte a hpyi nrut nra hta kap mat nna, dai gaw hpun zawn hkraw mat nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ri nhtu hte si ai ni gaw, kawsi hpang gara hte si ai ni hta, grau chyamai nga ma ai: Shanhte gaw, nsi naisi htum ai majaw, lasi lamun rai let nsa hkyet mat masai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Matsan grai chye dum ai num ni a lata gaw, tinang a kasha ni hpe pyi shadu ma ai; Nye amyu shayi sha hten byak hkrum ai shani e, tinang kasha ni hpe pyi sha ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa gaw shi a myit kahtet ai shakawp nna, shi pawt sindawng ai hpe ru kau nu ai; Shi gaw Ziun mare a npawt nhpang ni du hkra, hkru kau ai wan nat nu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gumlau wa hte hpyen wa gaw, Yerusalem mare chyinghka hku shang lu na lam, Ga ntsa hkawhkam ni hte, mungkan ga na ni nlang hte gaw, n kam ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai gaw myihtoi ni a yubak hte hkinjawng ni shut hpyit ai a majaw byin wa sai. Shanhte gaw dai mare ka-ang e, dinghpring ai ni a sai ru kau masai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte gaw myi hten ai ni zawn mare lam hkan lamawm hkawm nna sai galu ai majaw, Kadai mung shanhte a hpun palawng hpe n hkra lu ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Masha ni gaw, Yen mu, n san n seng ai majaw, yen mu, yen mu; shanhte hpe hkum hkra myit, nga nna jahtau ma ai. Shanhte hprawng nna brak hkawm nga ma yang, “Shanhte gaw ndai yang bai shanu nga na n rai;
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa a myi man shanhte hpe shabra kau manu ai; shi shanhte hpe bai yu na n rai; Shanhte gaw hkinjawng ni hpe n kaw n law di nna, salang ni hpe hkungga ma ai n rai,” nga nna masha amyu baw ni hta tsun shajang nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anhte a myi hten hkra, karum na wa hpe ya du hkra, kaman sha a mada nga ai; Anhte a maja nga let, n hkye la lu ai amyu hpe ala nga ga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte gaw nmaw lam ni hta n sa wa lu hkra, shanhte anhte a lagaw hkang hpe hkan tam ma ai; Anhte a jahtum du ra ai majaw, anhte htum na aten du nna, anhte a nhtoi ni gu mat sai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Anhte hpe hkan shachyut ai ni gaw, ntsa malen na langda ni hta grau lawan ma ai; Shanhte gaw bum lang hkan e, anhte hpe hkan shachyut ma ai; nam mali hkan e anhte hpe gyam ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte a nsai nsa ngu ai, Yehowa a namman chya ai wa gaw, shanhte a nhkun hta rim la hkrum sai, Anhte mahtang, “Ndai wa a shingnip npu e, masha amyu ni hta anhte nga nga lu na ga ai,” nga nna tsun yu saga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uza mung hta shanu nga ai Edom shayi sha e, kabu gara nna sharawng awng nga u; Shi a gawm nang hpang de mung rap wa na ra ai; nang chyaru nang nna singgu krin rai na rin dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ziun shayi sha e, na yubak majaw nang hkrum ging ai ari ahpri htum sai; htawm hpang de shi nang hpe bawng dung shangun sa na, n rai. Edom shayi sha e, na a shut hpyit ai hpe shi sawk yu nna, na a yubak hpe shadawng dan na ra ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, anhte hkrum ai lam hpe dum u; Anhte hkrum sha ai shatan nhkan hpe mada yu nna sumru yu u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anhte a sali wunli ga tsasam masha ni a lata de, Anhte a dum nta ni, maigan ni a lata de, ap kau hkrum sai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte, kawa n lu ai chyahkrai nmai ni rai nga ga ai; Anhte a nu ni, gaida jan ni zawn rai nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a ntsin hpe, jahpu jaw yang she lu lu ga ai; Anhte a hpun ni hpe mari ju ra ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte hpe hkan shachyut ai ni, anhte a du magra nga ma ai; Anhte hki ba hkrum timung, ban sa n lu ga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lusha lu na matu, anhte gaw Egutu masha ni hte Asuri masha ni kaw, nchyang chyang ga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ji wa ni gaw yubak galaw nna htum mat ma ai; Shanhte a yubak anhte hkrum ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mayam ni gaw anhte a ntsa e up nga ma ai; Shanhte a lata na anhte hpe mawai la ai wa, n nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte gaw, nam mali na nhtu tsin-yam hpe, Baw shanaw kau nna, shahpa tam ga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Grai kawsi kyet kahtet ai majaw, anhte a hpyi wan htung zawn, chyang mat sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw, Ziun mare hta e hpawmi ni hpe, Yuda mare ni hta mahkawn ni hpe, aroi arip di mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Du ni hpe, tinang a lata hte noi da mu ai; Salang ni hpe hkungga ma ai, n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shabrang ni gaw, htumrin hpe hpai ma ai; Ma kaji ni gaw, hpun npu e apyet taw ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Salang ni gaw, mare chyinghka e n dung ma ai; Shabrang ni gaw, sumpyi n dum ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Anhte kabu gara ai myit htum mat sai; Anhte ka manawt ai malai sharung shayawt ai tai mat sai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anhte gup ai janmau hkrat mat sai. Anhte shut hpyit ai majaw, dingnye lu ga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna anhte gawng kya nga saga ai; Dai lam majaw, anhte a myi amam nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ziun bum gaw, shingran katsi ai shara tai mat sai; Nam gwi ni de a ntsa e hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa e, nang gaw dinggrin anga nga ndai; Na a tingnyang gaw prat mi hte prat mi rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang anhte hpe hpa majaw tutnawng malap kau nna, Nde nlaw aten du hkra, kau da n ta?
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa e, anhte hpe nang hpang de kayin shangun mi; shing rai anhte nhtang wa na ga ai. Moi na zawn anhte a aten hpe bai nhtang ya mi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang chyawm gaw anhte hpe atsai awai kau da mi ai; Nang anhte hpe grai wa pawt bu nga ndai law.
  </para>
</usx>
