<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ACT" style="id">Kasa</book>
  <para style="h">Kasa</para>
  <para style="toc1">Kasa</para>
  <para style="toc2">Kasa</para>
  <para style="mt">Kasa</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yesu gaw, shi a lata la ai kasa ni hpe, Chyoi pra ai Wenyi hte ga matsun hkang da ngut nna, ntsa de shalun la hkrum ai nhtoi du hkra,
  </para>
  <para style="p">
    <verse number="2" style="v" />galaw dan ai hte, sharin shaga wa ai yawng mayawng a lam, shawng na laika hta ngai hpajang da se ai, Htawhpilu e:
  </para>
  <para style="p">
    <verse number="3" style="v" />shi gaw nni nkri hkrum ai hpang, shi hkum chyahkrung hpe, kam ging ai sakse law law hte shanhte hpe madun dan nna, Karai Kasang a mungdan lam hkai dan let, nhtoi mali shi ya laman e, shanhte kaw shi hkum sa pru dan dan di mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai rau hpawng nga yang, shi shanhte hpe, “Yerusalem kaw na n pru ai sha, nanhte ngai kaw na na la ai, Wa a ga ndat hpe a la nga mu,” nga nna hkang da nga ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />ga ndat dai gaw, Yawhan gaw hka hte baptisma jaw ai; nanhte chyawm gaw nhtoi gade n na yang, Chyoi pra ai Wenyi hta baptisma hkam la lu na marin dai, nga ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, naw hpawng nga ma yang shanhte gaw, “Madu e, dai Mungdan Israela masha ni hpe, ndai aten e bai de ya na rai sa ni?” ngu nna shi hpe san mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw, “Wa gaw shi a hpung shingkang hte, hkang tawn ai aten hte ahkying ladaw hpe, nanhte chye shara n nga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />rai timung, Chyoi pra ai Wenyi nanhte a ntsa e du jang, nanhte n-gun atsam lu la na marin dai rai nna, nanhte gaw Yerusalem mare hte Yuda mung ting, Samari mung hte lamu ga htum hkra, nye a sakse ni tai na marin dai,” ngu nna shanhte hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ndai tsun nga yang, shanhte yu nga ninglen shi hpe ntsa de shalun la ai rai nna, sumwi gaw shanhte a man na shi hpe magap la mat wa ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi lung mat wa nna, shanhte lamu de naw azi yu nga yang, yu mu, hpraw tu ai hpun palawng bu hpun ai marai lahkawng, shanhte a makau e tsap pru nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Galile masha ni e, hpa rai lamu de naw dawng yu nga myit ta? Nanhte a man na sumsing lamu de shalun la ai wa, dai Yesu gaw, nanhte mu nga yang sumsing lamu de wa ai zawn, dai hku bai du na ra ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi shanhte gaw, Yerusalem mare hte laban nhtoi sa ram sha gang ai Tsanlun bum kaw nna, Yerusalem de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Du wa ma yang shanhte nga nga re ai ntsa gawk de lung wa ma ai: dai ni gaw, Petru, Yawhan, Yaku, Andre, Hpilip hte Htawma, Barhtolume hte Mahte, Alhpe a kasha Yaku, Zelutu ngu ai Simun, Yaku a kasha Yuda hte rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte nlang hte gaw, numsha ni hte Yesu a kanu Mari hte mung, shi a kanau ni hte mung, myit langai sha hte akyu hpyi shaja let nga nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai nhtoi hte yang, masha latsa e hkun daram rai hpawng nga ai kahpu kanau ni a ka-ang e Petru rawt tsap nna,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Hpunau ni e, Yesu hpe rim la ai ni e woi shawng ai wa Yuda hpe lakap nna, moi Dawi a n-gup hta Chyoi pra ai Wenyi tsun da ai laika gaw dik wa lu na rai sai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaning rai nme law, dai wa gaw anhte hta hti lawm nna, ndai sara aya hta shi hte seng ai kumhtaw lu la nu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />(Dai wa gaw n ding n man ai hku na shabrai hte ga dachyawk langai mi lu la nna, nhtang chyaw di hkrat si ai hte kan ga nna, shi a pu nlang ayai mat salu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai lam hpe Yerusalem na ni nlang chye wa masai; dai rai nna, ga dachyawk dai hpe shanhte a ga hku, Akela dama ngu nna shamying mu ai; dai gaw, Sai ga, ngu ai, rai nga ai.)
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai lam gaw Shakawn Kungdawn laika hta, ‘Shi a htingra katsi katsang rai mat u ga, Dai hta kadai mung n nga mu ga,’ ngu nna mung; bai, ‘Shi a aya hpe masha kaga lu la u ga,' nga nna mung, rawng nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai re ai majaw, Yawhan baptisma nnan jaw ai kaw nna, anhte kaw na shalun la ai du hkra, Madu Yesu anhte hte,
  </para>
  <para style="p">
    <verse number="22" style="v" />rau hkawm rau sa ai nhtoi hte ting, anhte hte kanawn nga ai wa langai mi gaw, anhte hte rau, shi a bai rawt wa ai lam, sakse wa tai na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi shanhte gaw Yustu mying hkawt mying ai, Barsaba ngu ai Yawsep yan Mahtia hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai shanhte akyu hpyi ma ai gaw, “Yawng mayawng a myit masin chye chyang ai Madu e, Yuda gaw shi hte seng ai shara de wa mat na nga,
  </para>
  <para style="p">
    <verse number="25" style="v" />kau da ai shi a sara aya hte kasa ahkang hpe, kadai lu la na gaw, ndai yan hta gara mahtang hpe nang lata la ai madun ya mi,” nga nna hpyi ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi shanhte hpaida hte lata nna, dai hpaida gaw Mahtia hta ang wa ai: dai kaw nna shi gaw dai kasa shi langai hta shang lawm wa ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Pentekoti shani du jang, shanhte nlang shara sha hta rau hpawng nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi lamu de nna nbung laru kaba wa ai zawn, akajawng sha kadu pru nna, shanhte rawng nga ai nta ting hpring chyat rai wa ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bra karan ai wan shinglet zawn re ai mung, shanhte kaw dan pru nna, langai hte langai a ntsa e jung nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte nlang hte mung, Chyoi pra ai Wenyi hpring shajang nna, Wenyi e shadut mu ai hte maren, ga amyu kaga ga hku shaga wa ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai shaloi e sumsing lamu a npu e nga ai masha amyu shagu hta na, tara hkungga ai Yuda masha, Yerusalem mare e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai kadu ai nsen na ma yang, masha wunawng hpawng sa nna, langai hte langai tinang nang a buga ga hku chye na la ma ai majaw, shanhte mak mat ai rai nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />mau mahka let, “Yu mu, Ya shaga nga ai ndai ni yawng Galile masha hkrai n rai ma ni?
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai yang gaw, anhte langai hte langai tinang nang a buga ga hku na la lu ai gaw, kaning re ai i?
  </para>
  <para style="p">
    <verse number="9" style="v" />Parhti, Medi, Elam mung na ni hte Mesopotamia mung e nga nga ai ni, Yuda hte Kapadokia mung, Pontu hte Asi,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hprugi hte Pamhpuli, Egutu hte Kureni ginwang hkan e nga ai Lebu mung na ni, Roma nna wa nga ai ni, ngu ai, Yuda masha hte proselutu,
  </para>
  <para style="p">
    <verse number="11" style="v" />Kreti hte Arabi mung na ni, anhte gaw, Karai Kasang a mauhpa amu magam lam shanhte hkai dan ai ga hpe, tinang a buga ga hku na la lu nga ga hka,” nga nna myit kahpra rai tsun ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yawng mayawng hte mung mau mahka let, “Ning nga ai gaw hpa wa i?” nga nna shada da ung ang san hkat ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rai timung nkau mi gaw, “Shanhte tsabyi nnan hkru nga ma ai,” nga nna tsun jahpoi ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Petru gaw sape shi langai ni hte rau rawt nna, nsen shaja let dai masha ni hpe tsun wu ai gaw, “Yuda mung na ni hte Yerusalem e nga nga ai ni nlang hte e, ndai lam nanhte chye na myit ga; nye a ga hpe mung madat la mu.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nanhte zawn nawn ai hku n rai; ndai ni tsabyi n nang ma ai: kaning rai nme law, ya e shani ahkying masum sha naw rai nga ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />ndai lam chyawm gaw, myihtoi Yoela tsun da ai lam rai nga ai. Shi tsun ai gaw,
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Karai Kasang ning nga ai: Hpang jahtum na nhtoi ni hta, Nye a Wenyi, ashan yawng a ntsa e ngai ru jaw nna, Nanhte a shayi shadang sha ni myihtoi htoi na mara ai. Nanhte a brang ram ni shingran mu nna, Nanhte a dingla ni yup mang mu na mara ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rai sa, dai nhtoi hte yang, nye a nchyang la ni hte, Nye a nchyang jan ni a ntsa e, Nye a Wenyi ngai ru jaw nna, shanhte myihtoi htoi na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ntsa de sumsing lamu e mauhpa amu, Lawu na ga ntsa e, lamik kumla ngu ai, Asai, awan, nhkut salu hte hpe, ngai madun na nngai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Galu kaba re ai hte dan hkung ai shani ngu ai, Dai madu a nhtoi, garai n du yang, Ajan hpe ningsin hte, Shata hpe asai hte, galai kau na ra ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai shaloi e, shi Madu a mying ningsang hpe gang shaga ai masha kadai mung, Hkye hkrang la ai kaw du na mara ai,' nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israela masha ni e, ga ndai madat la mu: Nanhte chye nga myit dai hte maren, Karai Kasang gaw Nazaret wa ngu ai Yesu a lata hte magam ningsam, mauhpa amu, lamik kumla re ai ni nanhte a man e madun dan let, Karai Kasang e nanhte kaw awlaw shadan ya ai hkrum wu ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />ndai wa gaw, Karai Kasang shatawng ngut tawn sai hpaji hte, tau chye tau chyang ai lam hku ap kau hkrum wu yang, nanhte gaw, n tara ai masha a lata hte, shi hpe wudang hta jen sat kau myit dai:
  </para>
  <para style="p">
    <verse number="24" style="v" />rai timung, si hkrung si htan a nni, nkri hpe Karai Kasang raw kau ya nna, shi hpe jahkrung sharawt nu ai. Kaning rai nme law, dai nni nkri gaw shi hpe hkang shadang lu ai n rai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai wa hpe lakap nna Dawi tsun ai gaw, ‘Dai Madu hpe nye a myi man chyaw ngai tut tut mu lu nga nngai; Ngai n shamu n shamawt u ga nga, Shi nye a hkra maga e nga nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai re ai majaw nye a myit masin kabu nga ai hte, nye a shinglet awng nga li ai; Nye a hkum shan mung myit mada ai kaw rai na ra ai;
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nme law, nang nye a myit masin hpe katsan ga e kau da ya na n rai; Na a chyoi pra ai wa hten byak hkrum na, nang hkraw na n rai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Asak hkrung ai lam nang ngai hpe madun nit dai; Na a myi man hte nang ngai hpe kabu gara ai hte jahpring ya na rin dai,’ nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hpunau ni e, anhte wa daju Dawi gaw, nsa hkyet mat ai mung, lup kau ai hkrum ai mung, shi a lup gaw dai ni du hkra anhte hte rau nga nga ai gaw, ngai nanhte hpe tsun wam nga nngai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai wa gaw myihtoi rai nga ai rai nna, shi a amyu matu hta na langai wa mi, shi a tingnyang hta dung nga lu na, nga nna, shi hpe Karai Kasang dagam shaka da ai hpe chye wu ai majaw,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hkristu a bai hkrung rawt wa na lam shi chye tau tawn ai rai nna, shi hpe katsan ga e n kau da na hte, shi a hkum shan hten byak n hkrum na lam, tsun da wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai Yesu hpe Karai Kasang jahkrung sharawt la wu ai; anhte yawng mung, dai lam a sakse ni rai nga ga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shing rai, Karai Kasang a hkra lata hte shagrau tawn nu ai rai nna, Chyoi pra ai Wenyi a lam, Kawa kaw na ga ndat lu la wu ai majaw, ya nanhte mu lu, na lu ai lam, shi ru jaw dat ru ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kaning rai nme law, Dawi gaw sumsing lamu de lung wa sai n rai: shi nan she ning nga ai, ‘Shi Madu nye a Madu hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="35" style="v" />Na a gumlau ni hpe, na a lagaw nhpang e, Lagaw kabye lahkum, ngai shatai kau ai du hkra, Nye a hkra maga de naw dung nga u,’ nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai re ai majaw, nanhte wudang hta jen da sat kau ai, dai Yesu hpe, Karai Kasang gaw Madu hte Hkristu shatai nu ai gaw, Israela amyu ting gaja wa chye nga myit ga law,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai na ma yang, shanhte myit hta hkra malu ai rai nna, shanhte gaw, “Hpunau ni e, anhte kaning rai na rai ta?” nga nna Petru hte kaga kasa ni hpe tsun ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Petru gaw, “Myit malai lu nna, nanhte a yubak raw dat kau ya u ga, nanhte hkum shagu Yesu Hkristu a mying ningsang hta baptisma hkam la mu; shaloi Chyoi pra ai Wenyi ngu ai kumhpa gaw, nanhte lu la na marin dai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kaning rai nme law, ga ndat dai gaw, shi Madu anhte a Karai Kasang shaga la na ni mahkra hte ngu ai, nanhte hte nanhte a nshu nsha ni hte mung, sumtsan ga e nga ai ni nlang hte mung, seng nga ai,” ngu nna shanhte hpe tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ga kaga law law hte mung shi sakse hkam nna, “Ndai myit magaw ai amyu hta na lawt pru myit ga law,” ngu nna shanhte hpe shadum jahprang wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ga dai hta la ai ni gaw baptisma hkam la shajang nna, dai shani e masha hkying masum dang jat bang wa ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dai ni gaw kasa ni a sharin shaga ai lam, rau kanawn hpawng ai lam, muk ahkyep karan ai lam hte akyu hpyi ai lam hta, htep lahti hkan nga ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Masha nlang hte mung hkrit kang shajang ma ai: kasa ni a lata hta mung, mauhpa amu hte lamik kumla law law wa shapraw dan mu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kamsham ai ni nlang hte gaw, shara mi hta rau hpawng nna, arai yawng mayawng hpe jawm lang ma ai;
  </para>
  <para style="p">
    <verse number="45" style="v" />tinang a sut rai ni hpe mung, shanhte dut kau nna, kadai wa hpe mung n nga ai, ra ai shagu hpe karan jaw mu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shani shagu myit langai sha hte nawku Htingnu hta shanhte htep lahti machyu nga nna, tinang a nta e muk ahkyep karan nga yang,
  </para>
  <para style="p">
    <verse number="47" style="v" />Karai Kasang hpe shakawn kungdawn let, kabu gara ai hte myit tsup rai lusha shahpa sha ma ai; masha mahkra a man e mung myi man pa lu ma ai. Dai Madu mung, hkye hkrang la hkrum ai ni hpe, shani shagu shanhte hta jat wa shangun ya mu ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Petru yan Yawhan gaw, ahkying jahku na akyu hpyi ai ladaw hta, nawku Htingnu de lung wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi e, kanu a hkritung nna lagaw hten ai masha langai mi hpe hpai sa nna, Htingnu de shang wa ai ni kaw na hpyi sha u ga nga, Tsawm pra mying ai Htingnu chyinghka makau e shani shanang sa tawn da da di mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Petru yan Yawhan dai Htingnu de shang wa nga ma ai hpe, shi mu nna hkap hpyi nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Petru yan Yawhan chyawm gaw shi hpe jawm azi yu nna, “An hpe mada yu mi,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shan kaw lama ma lu la na myit mada let, shan hpe galaw yu nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Petru chyawm gaw, “Aja, gumhpraw gaw ngai n lu nngai, rai timung, ngai lu ai nang hpe jaw de ga: Nazaret wa Yesu Hkristu a amying ningsang hte rawt hkawm wa u,” nga nna tsun let,
  </para>
  <para style="p">
    <verse number="7" style="v" />shi a hkra lata jum nna dun sharawt wu ai: shaloi jang, shi a lagaw hkarutum ni n-gun rawng wa lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Alawan rawt tsap let shi hkawm sa wa yu nhtawm, hkawm sa let, gumlawt let, Karai Kasang hpe shakawn nna, shan hte rau Htingnu de shang wa ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi hkawm sa wa nga ai hte Karai Kasang hpe shakawn kungdawn nga ai gaw, masha yawng mu lu ma ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />dai wa gaw nawku Htingnu a Tsawm pra chyinghka makau e dung nna, hpyi sha ai wa rai nga ai hpe shanhte matsing da mu ai rai nna, shi hta byin wa ai lam majaw, mau mahka nna myit yu kahpra nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai wa gaw Petru yan Yawhan kaw kanan nang nga yang, shawa masha ni gaw mau mahka let, Shawlumon ngu ai jarawp de, shanhte kaw gat ru bang wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Petru dai mu jang, shawa masha ni hpe, “Israela masha ni e, ndai wa a lam hpe hpa rai mau myit ta? an lala a myit tsup ai hte ndai wa hpe hkawm sa lu shangun ai zawn rai nna, an hpe hpa rai azi yu nga myit ta?
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham, Isak hte Yaku a Karai Kasang ngu ai, anhte a ji wa ni a Karai Kasang gaw, shi a Shangun ma Yesu hpe hpung shingkang shapraw ya nu ai: nanhte chyawm gaw shi hpe ap kau myit dai rai nna, Pilat du wa, shi hpe dat kau na myit da sayang, nanhte mahtang shi a man e dai wa hpe ndang kau myit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai chyoi pra ai hte dinghpring ai wa hpe nanhte ndang kau nna, masha sat ai wa hpe mahtang hpyi la nhtawm,
  </para>
  <para style="p">
    <verse number="15" style="v" />asak Madu hpe sat kau myit dai; Karai Kasang chyawm gaw, chyasi ni hta na shi hpe jahkrung sharawt la nu ai: anhte mung dai lam a sakse ni rai nga ga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a amying ningsang hpe kamsham ai a marang e, shi a amying nan, ndai nanhte mu chye ai wa hpe n-gun shaja nu ai; rai sa, shi kaw na makam masham gaw, ndai wa hpe, nanhte yawng a man e, hkum hkum shamai tawn nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya rai timung, hpunau ni e, nanhte hte nanhte a du gyi ni dai lam hpe n chye nna galaw kau ai rai nga ai gaw, ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai gaw, Karai Wa a Hkristu nni nkri hkrum na re ai, nga nna myihtoi ni yawng a n-gup hte tau tsun shangun ai Karai Kasang shi nan, ning re ai lam hte shadik nu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai re ai majaw, dai Madu kaw na ngwipyaw ai aten ladaw du ru ga hte,
  </para>
  <para style="p">
    <verse number="20" style="v" />Yesu ngu ai, nanhte a matu san da ya ai Hkristu hpe, shi shangun dat ya ru ga, nanhte a yubak raw mat na matu, myit malai lu nna kayin wa marit;
  </para>
  <para style="p">
    <verse number="21" style="v" />moi chyaloi nhkoi nna nga nga ai, shi a chyoi pra ai myihtoi ni a n-gup hta, Karai Kasang tsun da sai lam hte maren, nga yawng danghta hpe nnan bai gram ai prat du hkra, sumsing lamu gaw dai wa hpe hkap la da nga na, rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mawshe nan tsun da ai mung, Dai Madu Karai Kasang gaw, ngai zawn re ai myihtoi, nanhte a nhpu nnau ni hta na, nanhte a matu paw pru shangun ya na ra ai: dai wa tsun matsun nanhte madat mara lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kadai wa dai myihtoi a ga hpe n madat yang, dai wa gaw tinang amyu hta na sumri dan kau ya ai hkrum lu na rai nga ai, nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rai sa, Samuela kaw nna, shi a hpang e hkan paw pru nna htawn tsun tsun re ai myihtoi yawng hte gaw, nhtoi ndai hpe lakap nna mung tau tsun wa masai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nanhte mung dai myihtoi ni a kashu kasha ni rai nga myit dai hte, Karai Kasang Abraham hpe, Na amyu matu a marang e ga ntsa amyu mahkra gumring gumrat chyeju hkam la shajang na mara ai, nga nna nanhte a nji nwa ni hte tawn da ai ga shaka a kashu kasha ni mung, rai nga myit dai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nanhte hta hkum shagu hpe tinang a shut hpyit ai lam hta na kayin wa lu shangun na hte, nanhte hpe shaman ya n ga nga, Karai Kasang gaw shi a Shangun ma hpe paw pru shangun ai hta, nanhte hpang de shawng shangun dat ya sai,” ngu nna tsun mu ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shing rai, shan gaw shawa masha ni hpe shaga nga yang, hkinjawng agyi ni, nawku Htingnu sin ai agyi wa hte Saduke ni katu pru nna
  </para>
  <para style="p">
    <verse number="2" style="v" />shawa masha ni hpe sharin shaga nga let, Yesu a marang e si mat sai ni bai hkrung rawt wa na lam tsun ma ai majaw, shanhte grai myit ru da mu ai rai nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />kasa yan hpe rim la nhtawm, ya shana rai wa sai majaw, jahpawt du hkra htawng hta bang da mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung, mungga na la ai ni law law wa, kamsham ma ai rai nna, kamsham ai lasha yawng hkying manga daram rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hpang jahpawt e, shanhte a du agyi ni, salang ni hte laika ka ai sara ni, Yerusalem mare hta hpawng nga ma ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />hkinjawng agyi Anna hte nawng, Kayahpa, Yawhan, Alesandru hte hte, hkinjawng agyi a amyu ni kadai mung, dai yang lawm nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi kasa yan hpe shanhte a ka-ang e shadun da nna, “Taw, nan gaw, hpa atsam, gade a amying hte ndai amu galaw myit ta?” ngu nna san mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Petru, Chyoi pra ai Wenyi hpring nga ai rai nna, shanhte hpe tsun mu ai gaw, “Mung masha ni a du agyi salang ni e,
  </para>
  <para style="p">
    <verse number="9" style="v" />ndai chyahten labye wa hpe madun ai chyeju lam a majaw, dai wa hpe kaning di shamai ai nga nna, dai ni an deng ai hkrum na rai yang gaw,
  </para>
  <para style="p">
    <verse number="10" style="v" />nanhte nlang hte Israela amyu yawng hpe chye la shangun made ga: nanhte wudang hta jen da sat kau nna, Karai Kasang chyasi ni kaw na jahkrung sharawt la ai, Nazaret wa Yesu Hkristu a amying ningsang hta, ndai wa nanhte a man e amai atsai tsap nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Yesu gaw, nanhte nta gaw ai ni lata kau ai nlung rai nga timung, ningjut jahtum na nlung bai rai wa sai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi hta shaje hkye krang la ai lam n nga sai; anhte hkye hkrang la kaw du lu na matu, sumsing lamu a npu, shinggyim masha ni hta jaw ya ai amying ningsang shaje, kanang mung n nga sai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte chyawm gaw, Petru yan Yawhan a nden ja ai myit mu nna, shan gaw laika n chye ai, yu maya masha rai nga ma ai hpe chye ma ai majaw, mau nga ma ai; rai timung, shawng de Yesu hte rau shan nga yu ai gaw, shanhte dum ma ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />dai hta kaga, mai tsai ai wa mung, shan hte rau tsap nga ai hpe, shanhte mu ma ai rai nna, ndang shara hpa mi n mu mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai timung, shan hpe dai salang hpawng na shapraw tawn nhtawm, shanhte shada bawng ma ai gaw,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Ndai yan hpe kaning di na rai nga ga ta? shan a lata hte dan hkung ai lamik kumla langai mi byin wa sai gaw, Yerusalem e nga ai ni nlang a man e dan dan pra pra rai wa sai rai nna, anhte mung ndang shara n mu sagaw ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai timung, dai lam, mung masha ni hta grau nna n gara wa u ga, ya kaw nna amying dai gang nna kadai hpe mung, n tsun dan na hku, shan hpe daru jet kau gaw,” nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai shan hpe shaga nhtawm, Yesu a amying gang nna hpa mung n tsun, n sharin lu na hku, hkang da ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Petru yan Yawhan chyawm gaw, “Karai Kasang a ga madat na hta, nanhte a ga mahtang madat yang, Karai Kasang a man e mai n mai gaw, nanhte she dawdan yu mu.
  </para>
  <para style="p">
    <verse number="20" style="v" />An chyawm gaw, mu la, na la sai lam ni hpe n tsun ai, n nga lu ga ai,” ngu nna shanhte hpe bai htan mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi shanhte gaw, mung masha ni hpe tau yu let, shan hpe ari jaw na lam n mu mu ai majaw, shan hpe bai daru nna dat dat mu ai; kaning rai nme law, dai byin ai amu majaw, masha nlang Karai Kasang hpe shagrau sha-a ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hta n-ga, dai lamik kumla byin ai shamai hkrum ai wa gaw, asak mali shi ning jan sai, rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai raw dat hkrum jang, shan gaw tinang a hpung manang ni hpang de wa nna, hkinjawng agyi ni hte salang ni, shan hpe ahkrim ai ga mahkra tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai na jang shanhte gaw myit langai sha hte Karai Kasang hpang de tinang a nsen shaja nna, “Sumsing lamu hte ginding aga, nammukdara hte dai hte hta nga manga hpan tawn da ai Madu e;
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang na a mayam, anhte a wa Dawi a n-gup hta, Chyoi pra ai Wenyi hte tsun da ndai gaw; ‘Maigan amyu ni hpa majaw n-yun bu nna, Masha amyu ni hpa majaw lila maw nga ma hka?
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai Madu hte shi a Hkristu hpe tai na, Ga ntsa hkawhkam ni rawt nna, Du salang ni rau hpawng nga ma ai,' nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gaja wa teng teng, na a lata, na a myit hpaji hte tau hpang da ai hku, byin wa lu hkra, nang namman chya ai, na a chyoi pra ai wa Shangun ma Yesu hpe tai na nga,
  </para>
  <para style="p">
    <verse number="28" style="v" />ndai mare hta e Herod yan Pontu Pilat, maigan amyu ni hte Israela amyu masha ni du hkra jawm hpawng nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya yang Madu e, shanhte a daru ahkrim ai ga hpe dum ya mi; machyi makaw mai tsai hkra, na a lata ladawn nna, na a chyoi pra ai Shangun ma Yesu a amying hte lamik kumla, mauhpa amu byin nga ai hta,
  </para>
  <para style="p">
    <verse number="30" style="v" />na a mayam ni, na a mungga hpe nden ja ai myit hte tsun dan nga lu hkra, karum ya mi law,” nga nna hpyi ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shing rai akyu hpyi ngut jang, shanhte hpawng nga ai shara gaw gari ashun wa nna, nlang hte hta Chyoi pra ai Wenyi hpring wa ai hte, Karai Kasang a mungga hpe nden ja ai myit hte tsun dan wa ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai kamsham ai shawa hpung ting gaw myit mang langai sha rai nga ma ai: kadai mung tinang lu ai arai hpe nye a, n nga ai sha, yawng mayawng hpe jawm lang ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kasa ni mung, dai Madu Yesu a bai hkrung rawt ai lam hpe atsam kaba hte sakse hkam ma ai rai nna, shanhte mahkra ntsa e chyeju kaba nga malu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte hta kadawn ai masha langai mi muk n nga ma ai; kaning rai nme law, ga dachyawk lu ai ni, nta lu ai ni kadai mung, dai dut nna, lu la ai gumhpraw hpe,
  </para>
  <para style="p">
    <verse number="35" style="v" />kasa ni a lagaw nhpang e sa tawn da ma ai; dai rai nna, kadawn ai wa kadai hpe mung rap shara nna, karan jaw karan ya mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai shaloi, Barnaba ngu nna, kasa ni e mying hkawt shamying ai, Kupru mung na Lewi masha Yawsep mung, shi lu ai ga dachyawk dut nna, lu la ai gumhpraw hpe kasa ni a lagaw nhpang e sa tawn da wu ai:
  </para>
  <para style="p">
    <verse number="37" style="v" />Barnaba ngu ai ga lachyum gaw shalan shabran ai a kasha ngu ai, rai nga ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rai timung, Anani mying ai la wa hte madu jan Sahpira gaw, shan lu ai ga dachyawk dut nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />shan la myit hkrum ai hte, dai jahpu kau mi ip da nhtawm, kau mi sha kasa ni a lagaw nhpang e sa tawn da wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna Petru gaw, “Anani e, Chyoi pra ai Wenyi hpe masu kau na hte, ga jahpu hta na kau mi ip da na gaw, hpa majaw Satan na a myit jahpring ya lu a ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />ga dai nga nga yang, na a arai nga ai n rai ni? dut kau ai hpang na mung, na a arai naw nga ai n rai ni? nang hpa rai dai hku maw n ta? masha hpe masu ai n rai, Karai Kasang hpe masu kau nu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai ga na jang Anani gaw kadawng si mat ai: dai na ai ni yawng mayawng mung nachying hkrit kahpra mat ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi shabrang ni rawt nna, shi a mang hpe ahkyen kayawp nhtawm, sa hpai lup kau ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang, ahkying masum daram na jang, madu jan mung, shing rai byin ai lam hpe n chye nna, shang wa ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Petru gaw, “Ga dachyawk dut ai, ndai hte sha re a ni? ngai e tsun dan e,” ngu wu yang, shi mung, “Rai sa, ndai hte hte sha dut ai re ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Petru gaw, “Dai Madu a Wenyi hpe chyam yu na, nan hpa majaw ndai hku myit hkrum myit ta? Yu u, na a madu wa hpe lup kau ai ni a lagaw, dai chyinghka e du ra ai; nang hpe mung hpai kau na mara ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi jang shi mung kasa wa a lagaw nhpang e kadawng si mat ai: shabrang ni mung shang wa yu yang, dai numsha si taw nga ai hpe mu nna hpai sa wa nhtawm, madu wa makau e lup kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna, Hpung ting hte, dai lam na mana ni yawng, nachying hkrit kahpra mat wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya kasa ni a lata hta lamik kumla hte mauhpa amu law law wa, mung masha ni a man e byin dan nga ai; dai ni nlang myit langai sha hte, Shawlumon mying ai jarawp hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Masha gale kadai mung shanhte hte n kanawn wam ma ai: mung masha ni chyawm gaw, shanhte hpe sha-a ma ai rai nna
  </para>
  <para style="p">
    <verse number="14" style="v" />kamsham ai numsha lasha hpung kaba, dai Madu kaw jat bang wa ma ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />dai rai nna, Petru lai sa wa yang, langai ngai a ntsa e shi a shingnip sha pyi hkra u ga, nga nna machyi makaw hkrum ai ni hpe, mare lam makau de hpai shapraw nhtawm yup ku ni hte panep ni hta, tawn da shajang ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hta kaga, Yerusalem grup yin ginwang hkan na mare ni kaw nna mung, masha law law wa machyi ai ni hte nat shang zingri hkrum ai ni hpe woi nna, du sa shajang ma ai; dai ni mung nlang hte shamai shatsai ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai timung, hkinjawng agyi wa hte, shi a manang ni, Saduke ngu ai hpung masha nlang hte gaw, manawn ai myit hkrai chyat rai nga malu ai rai nna, rawt nhtawm
  </para>
  <para style="p">
    <verse number="18" style="v" />kasa ni hpe rim la nna, mare na htawng hta rawng da mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai timung, dai shana e Madu a lamu kasa gaw, htawng chyinghka ni hpaw kau ya nna, shanhte hpe shapraw dat let,
  </para>
  <para style="p">
    <verse number="20" style="v" />“Nanhte pru wa mu, nawku Htingnu e wa tsap nna, ndai asak hkrung ai lam hte seng ai ga yawng mayawng, shawa masha ni hpe tsun dan mu,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ga dai na jang, jahpawt manap hpawa e dai Htingnu de shanhte shang wa nna sharin shaga nga ma ai. Hkinjawng agyi wa hte shi a manang ni mung sa du nna, tara agyi ni hte Israela kashu kasha ni a salang nlang hte hpe shaga jahpawng tawn nhtawm, kasa ni hpe shapraw la na htawng de masha shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ali ama ni chyawm gaw, htawng e kasa ni hpe n mu jang, bai wa nna,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Htawng mung chyip chyip la nga ai, sin langa ni mung chyinghka shinggan e sin nga ma la ai; dai wa mi hpaw yu yang me, kata e kadai mung n nga nga la ai,” ngu nna wa tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />nawku Htingnu agyi wa hte hkinjawng agyi ni dai ga na jang, ndai lam hpa byin ai rai wa sai kun, nga nna grai myit ru ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi langai wa mi shang sa nna, “Yu mu, nanhte htawng e rawng da ai ni gaw, nawku Htingnu e tsap nna masha ni hpe sharin shaga nga ma ai,” ngu nna shanhte hpe tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai rai nna hpyen du wa gaw ali ama ni hte sa nna, kasa ni hpe sa woi la mu ai; rai timung, aja awa n di wam mu ai; kaning rai nme law, shawa masha ni nlung hte kabai wa na hpe, hkrit da mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shing di shanhte hpe woi la nna, salang hpawng a man e tawn da ngut jang, hkinjawng agyi wa gaw,
  </para>
  <para style="p">
    <verse number="28" style="v" />“Nanhte hpe, amying dai hte hpa mung hkum tsun, ngu nna anhte aja awa hkang da saga ai; ya yu mu, Yerusalem mare ting nanhte a sharin shaga lam pri di manit dai rai nna, dai wa a asai anhte a ntsa e mara ya na maw nga myit dai,” ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi Petru hte kasa ni htan mu ai gaw, “Masha ga madat na hta, Karai Kasang a ga mahtang grau madat na ga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Anhte a ji wa ni a Karai Kasang gaw, nanhte wudang hta jen da sat kau ai Yesu hpe, jahkrung sharawt dat nu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Israela amyu hpe myit malai lam hte mara raw ya ai lam hpaw ya na matu, Daru Magam hte Hkye hkrang la ai Madu shatai na nga, Karai Kasang gaw dai wa hpe, shi a hkra lata hte shagrau tawn nu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anhte mung ndai lam ni a sakse ni rai nga ga ai; shi a mungga madat mara ai ni hpe Karai Kasang jaw ya ai Chyoi pra ai Wenyi mung, dai hte a sakse rai nga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai ga na jang, shanhte a myit masin hta mala la hkra malu ai majaw, kasa ni hpe sat kau na pyi myit lu ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rai timung, mung masha ni mahkra man e arawng lu ai tara sara Gamale ngu ai Hparishe langai mi, dai salang bawng hta rawt nna, kasa ni hpe hkring mi shapraw tawn shangun nhtawm,
  </para>
  <para style="p">
    <verse number="35" style="v" />tsun wu ai gaw, “Israela masha ni e, ndai ni hpe kaning di na gaw atsawm sha naw myit yu mu.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kaning rai nme law, moi shawng de Htuda ngu ai wa, shi hkum hpe reng ai wa rai nngai, nga nna paw pru yang, marai mali tsa daram shi kaw hkan nang yu sai; shi hkum nan sat kau ai hkrum nna, shi a ga madat ai ni nlang kamawng mat ma masai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai hpang, jahpan hti la ai aten hte yang, Galile masha Yuda paw pru nna, mung masha ni hpe shi hpang de lau la mu ai; shi mung hten byak hkrum nna, shi a ga madat ai ni nlang, bra mat wa masai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ya mung, ndai ni hpe hpa mi hkum gawn myit, ra mi rai mu ga; hpaji ndai hte, lam ndai rai timung, masha kaw na rai yang gaw, byak mat na ra ai:
  </para>
  <para style="p">
    <verse number="39" style="v" />Karai kasang kaw na rai yang chyawm gaw, nanhte hpya lu na n rai; Karai Kasang hpe daw ai tai na mahtang tsang ra ai, ngai tsun da made ga,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ga dai hpe shanhte myit htuk dum ma ai rai nna, kasa ni hpe shaga la nhtawm, kayat nna, Yesu a mying hte n sharin n shaga lu na lam hkang da ngut jang, dat dat ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shanhte chyawm gaw, Amying ningsang de a majaw she, kaya hkrum na gaw, ging nga ga ai, nga nna myit la ai majaw, kabu gara ai myit hte dai salang hpawng na pru wa ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dai rai timung, shanhte shani shagu nawku Htingnu hta mung, nta hkan e mung, Yesu gaw Hkristu rai nga ai, nga nna a hkaw a tsun nga ma ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, sape ni law htam wa ai nhtoi hte yang, Heleni ngu ai ni hta na gaida jan ni hpe, shani shagu na galaw lu galaw sha ai amu hta shadawng tawn ai nhkan e, dai Heleni ni gaw Hebre masha ni hpe, aput angun nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi dai kasa shi lahkawng hte gaw sape hpung ting hpe shaga la nna, “Anhte wa Karai Kasang a mungga hpe kau da rap rai nna, sha ku amu hpajang nga na gaw, n htuk ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai majaw, hpunau ni e, nanhte hta na sari rawng nna, Chyoi pra ai Wenyi hte hpaji byeng-ya hta myit kup ai masha marai sanit lata tawn mu; dai ni hpe ndai amu madu shangun na matu, anhte san da nme ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte chyawm gaw, akyu hpyi ai amu hte mungga hkai dan ai amu hta, htep lahti shatsup nga na ga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ga dai hpe hpung ting na ra ma ai rai nna, makam masham tsup ai hte, Chyoi pra ai Wenyi hpring ai Stehpan ngu ai wa hte, Hpilip, Prokoru, Nekanora, Timun, Parmena hte Antioki mare na Proselutu hpung na Nikola hte hpe lata la nna,
  </para>
  <para style="p">
    <verse number="6" style="v" />kasa ni a man e shadun tawn da mu ai; shanhte akyu hpyi ngut jang, shanhte hpe lata mara jaw da mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai kasang a mungga mung, galu kaba wa ai rai nna, Yerusalem mare hta sape ni nachying law htam wa ai hte, hkinjawng ni ga daga mung, dai makam masham lam madat mara nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya Stehpan gaw chyeju hte n-gun atsam hpring nga ai rai nna, mung masha ni a man e mauhpa amu hte lamik kumla kaba madun dan mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi, Shanglawt ngu ai ni a tara jawng hte seng ai ni hte, Kureni, Alesandru, Kiliki hte Asi ngu ai tara jawng hte seng ai ni nkau mi rawt nna, Stehpan hte ndang kalang hkat ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai timung, shi tsun wa ai hpaji ga hte Wenyi hpe shanhte n dang lu ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi shanhte gaw, “Ndai wa Mawshe hte Karai Kasang hpe shatan ai ga tsun nga ai gaw, anhte na saga ai,” nga nna tsun na masu ai sakse tam tawn ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai shanhte gaw mung masha ni hte, agyi salang ni, laika ka ai sara ni hpe masin sharawt ya nna, shi hpe sa rim la nhtawm, salang hpawng a man e woi tawn mu ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />sakse masu ni hpe mung jashawn dat mu ai rai nna, shanhte gaw, “Dai wa, ndai chyoi pra ai shara hte jep ai tara hpe jahpoi ai ga n sim n sa a tsun nga ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />Nazaret na Yesu ngu ai wa gaw, shara ndai hpe hpya kau nna, anhte hpe Mawshe jaw da ai tara a htung hking hpe galai kau na rai nga ai, nga nna shi nan tsun ai ga anhte na saga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi dai hpawng shingra e dung nga ai ni nlang, shi hpe jawm azi yu mu yang, shi a myi man lamu kasa myi man zawn rai nga lu ai gaw, shanhte mu ma ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi hkinjawng agyi wa, “Dai hku rai nga n ni?” ngu nna san wu yang,
  </para>
  <para style="p">
    <verse number="2" style="v" />Stehpan tsun mu ai gaw, “Hpunau ni hte wa ni e, madat mara yu mu: anhte a aji daju Abraham, Haran e garai n wa shingbyi, Mesopotami mung e naw rai nga yang, hpung shingkang rawng ai Karai Kasang gaw shi kaw dan pru nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Na a mung, na amyu kaw na pru nhtawm, ngai madun na ra de ai mung de sa wa su,’ ngu nna, shi hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Hkalde a mung na shi pru nna, Haran mung e wa shingbyi nga ai; dai hpang, shi a kawa si mat jang, dai kaw nna ya nanhte nga nga ai ndai mung de, Karai Kasang shi hpe woi htawt wa wu ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />dai mung e, sali wunli ngu na, lagaw hkang daram pyi shi e n jaw wu ai; rai timung, shi hta kashu kasha myi man garai n mu kaw nna, lamu ga ndai, shi hpe mung, htawm hpang na shi a kashu kasha ni hpe mung, jaw na nga ga ndat tawn da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hta kaga, Karai Kasang ndai lam hpe tsun ai gaw, shi a amyu matu ni masha tsasam a mung hta sa shingbyi nga nna, dai mung masha ni e yam sha na hte, mali tsa ning zingri zingrat hkrum na mara ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />shanhte e yam sha ai amyu hpe mung, ngai jeyang na mawe ai; shaloi shanhte pru wa nna, ndai yang e ngai hpe jaw jau lu na mara ai, nga nna Karai Kasang tsun sai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Matu gadoi jaw na lam hte seng ai ga shaka hpe mung shi e jaw dat wu ai; shaloi Isak hpe shaprat wu ai rai nna, matsat ya nhtoi hta matu gadoi ai lam jaw wu ai: Isak gaw Yaku hpe shaprat nna, Yaku gaw aji daju ni shi lahkawng hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai aji daju ni gaw Yawsep hpe manawn nna, Egutu mung de dut kau dat mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai timung, Karai Kasang shi hte rau nga nga ai rai nna, tsin-yam tsindam yawng na shi hpe shaw la ai hte, Egutu hkawhkam Hpara-u a man e chyeju hte hpaji byeng-ya jaw wu ai majaw, dai hkawhkam gaw Egutu mung ting hte hpawn, shi a htingnu madu shangun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hte yang Egutu mung hte Hkanan mung ting hta hku wa kaba wa nna, kyin dut kaba du ra ai; anhte a aji daju ni mung lusha htum mat malu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya Egutu mung e mam nga nga ai lam Yaku na wu yang, shawng na lang hta, anhte a aji daju ni hpe shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai hpang na lang hta, Yawsep gaw shi a kahpu kanau ni hpe shi a lam tsun hpaw dan wu ai rai nna, Hpara-u mung Yawsep a baw sang lam chye ya wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai shaloi Yawsep gaw kawa Yaku hte hpawn, nta masha yawng ngu ai, marai sanit shi manga hte hpe, shi hpang de woi la wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yaku mung Egutu mung de du yu wa nna, shi hkum hte anhte a aji daju ni yawng si mat wa masai;
  </para>
  <para style="p">
    <verse number="16" style="v" />shanhte hpe Shehkem de la wa nna, Shehkem e nga ai Hamora a kashu kasha ni kaw na, Abraham gumhpraw manu hte mari da ai lup hta wa lup ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Karai Kasang Abraham hpe jaw da ai ga ndat hte seng ai aten du wa magang yang, Egutu mung ntsa e Yawsep hpe n chye ai hkawhkam paw pru ai prat du hkra, anhte a amyu masha ni Egutu mung e kaba wa nna law htam wa ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hkawhkam wa gaw, anhte a baw sang ni hpe hpaji hte manai nna, ma chyangai ni hpe n jahkrung da lu hkra kabai kau na lam hte, ji wa ni hpe zingri zingrat mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hte yang Mawshe shangai ai rai nna, shi gaw Karai Kasang a man e ahpraw tsawm nga ai; shata masum kawa nta e bau maka nna,
  </para>
  <para style="p">
    <verse number="21" style="v" />kabai kau ai hkrum jang, Hpara-u a shayi sha shi e shaw la nhtawm, shi a kasha shatai nna shapan da wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mawshe mung Egutu hpaji yawng mayawng sharin la nna, mungga marai hte lata marai grai rawng ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya shi asak mali shi ning du magang yang, shi a kahpu kanau Israela kashu kasha ni hpang de kawan katsan yu na, myit pru nna sa wa ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi, zingri hkrum nga la ai wa langai mi hpe mu jang, dai wa hpe maga nna, zingri ai wa, Egutu masha hpe, matai htang let sat kau wu ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shi a lata hte kahpu kanau ni hpe, Karai Kasang hkye hkrang la ai lam hpaw ya nga ai gaw, shanhte chye na ma dawng, nga nna myit wu timung, shanhte chyawm gaw n chye ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hpang shani e shada gasat nga ai gaw sa ang hkrup nna, shan hpe je mayu ai majaw, ‘Hkau yan e, hpunau shada she rai yang me, hpa rai shada zingri hkat nga myit ta?’ ngu nna nem wu yang;
  </para>
  <para style="p">
    <verse number="27" style="v" />htingbu wa hpe zingri ai wa mahtang, ‘Anhte a ntsa e du hte tara agyi tai na, nang hpe kadai san da a ta?
  </para>
  <para style="p">
    <verse number="28" style="v" />Mani e Egutu masha hpe sat kau ai zawn, ngai hpe mung sat kau mayu nga n ni?’ nga nna htan let shi hpe nawng kau wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ga de a majaw Mawshe hprawng nna, Midian mung e sa manam nga let, dai yang e shadang sha lahkawng shaprat wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai kaw mali shi ning lai jang, Sina bum na nam mali e wan grung nga ai singwum hta, lamu kasa shi kaw dan pru ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mawshe gaw dai mu jang, dai shingran majaw shi mau nna, dai hpe yu yu na nga sit sa wa yang, dai Madu a nsen ngoi pru ai gaw,
  </para>
  <para style="p">
    <verse number="32" style="v" />“Ngai gaw, na nji nwa ni a Karai Kasang, Abraham, Isak, Yaku a Karai Kasang rai nga nngai,” nga ai. Mawshe chyawm gaw hkrit gari nna, n mada wam wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai, dai Madu gaw, “Na a kyepdin raw kau u; nang tsap ai shara chyoi pra ai ga rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Egutu mung na nye amyu a ru tsang ai hpe ngai gaja wa mu se ai; shanhte a madai ai nsen ngai na ni ai; shanhte hpe hkye la na ngai yu wa ring ngai; ya sa rit, ngai nang hpe Egutu mung de shangun dat de ga,” nga nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai rai nna, Nang hpe du hte tara agyi tai na, kadai san da a ta? nga nna shanhte ndang kau ai, dai Mawshe hpe, Karai Kasang gaw singwum e dan pru ai lamu kasa a lata hte, du hte hkye hkrang la ai wa shatai nna shangun dat nu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai wa nan, Egutu mung e mung, Nawng hkyeng hta mung, nam mali hkan e mung, mali shi ning tup mauhpa hte lamik kumla amu madun let, shi a amyu masha ni hpe woi wa mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai Mawshe nan, ‘Nan hpu nan nau ni hta na, nanhte a matu ngai zawn re ai myihtoi langai mi Karai Kasang paw pru shangun ya na ra ai,’ nga nna Israela kashu kasha ni hpe tsun da ai wa mung, rai nga ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nam mali e rai nga yang na shawa hpung hta, Sina bum e shi hte ga tsun ai lamu kasa hte, anhte a ji wa ni rau rai nga ai wa gaw, shi nan rai nga ai; anhte hpe ap ya na asak hkrung ai mungga hkap la ai wa mung, shi rai nga ai:
  </para>
  <para style="p">
    <verse number="39" style="v" />anhte a ji wa ni chyawm gaw shi a ga n madat mayu nna, shi hpe ndang kau let, Egutu mung hpe bai marit ai hte,
  </para>
  <para style="p">
    <verse number="40" style="v" />Arun hpe, ‘Anhte a shawng e sa wa na Hpara galaw ya mi; Egutu mung na anhte hpe shaw woi wa ai, ndai Mawshe hta hpa byin sai gaw anhte n chye saga ai,’ nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Dai nhtoi hte hta shanhte dumsu kasha sumla galaw nna, dai sumla hpe hkungga jaw let, tinang a lata hte galaw ai amu hta kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dai rai nna, myihtoi laika hta tsun ai gaw, ‘Israela amyu e; mali shi ning tup nam mali e lang ai hkungga hte kumhpa gaw, Ngai hpe jaw jau ai rai ni?
  </para>
  <para style="p">
    <verse number="43" style="v" />Nanhte nawku na matu galaw la ai sumla ngu ai, Molak sumla a sum hte, Rehpan Hpara a shagan hpe she, hpai hkawm myit dai: Dai majaw Babelon tawt hkra ngai nanhte hpe woi mat wa na made ai,' nga nna rawng ai; dai hte maren Karai Kasang gaw shanhte kaw na myi man kayin kau nna, sumsing lamu na zaw nawng zaw wa hpe nawku shangun na ap kau wu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nang mu ai kasi hte maren hkan galaw u, nga nna Mawshe hpe hkang dat ai hku galaw ai sakse sum hpe, dai nam mali e anhte a ji wa ni lu la ma ai rai nna;
  </para>
  <para style="p">
    <verse number="45" style="v" />Karai Kasang gaw ji wa ni a man na shachyut kau ya ai masha amyu ni a ninghtawn hta shanhte shang sha wa ai shaloi, dai prat na ji wa ni Yawshu hte rau dai hpe la shawn wa ma ai rai nna, Dawi a aprat du hkra rai nga ai:
  </para>
  <para style="p">
    <verse number="46" style="v" />Dawi chyawm gaw Karai Kasang a man e myi man pa ai rai nna, Yaku a Karai Kasang a matu nga shara tam na ahkang hpyi wu timung,
  </para>
  <para style="p">
    <verse number="47" style="v" />Shawlumon e she shi a matu nta gap wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Rai timung Tsaw Htum ai Wa gaw masha a lata hte sha gap ai nta hta rawng ai n rai; dai lam myihtoi wa htawn tsun ai gaw,
  </para>
  <para style="p">
    <verse number="49" style="v" />‘Sumsing lamu gaw nye a tingnyang, Ginding aga gaw nye a lagaw kabye lahkum rai nga ai: Kaning re ai nta nye a matu gap na myit ta? Ngai ban sa na shara kaning re ai shara rai na a ta?
  </para>
  <para style="p">
    <verse number="50" style="v" />Dai yawng hpe nye a lata hte hkrai galaw tawn ai n rai ni? Nga nna dai Madu tsun ai,’ nga ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Du ja nna, masin hte ana hpe matu n gadoi ai ni e, nanhte galoi mung Chyoi pra ai Wenyi hpe hkap daw myit dai; nanhte a nji nwa ni galaw ai zawn, nanhte mung a galaw nga myit dai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Nanhte a nji nwa ni n zingri yu ai myihtoi, kadai wa nga a ta? Dai Dingman ai Wa paw pru na lam htawn tsun ai ni hpe, shanhte sat kau ma ai; ya nanhte mung dai wa hpe ap kau ai ni, sat kau ai ni, rai nga myit dai;
  </para>
  <para style="p">
    <verse number="53" style="v" />lamu kasa a lata hte hpajang ai tara nanhte lu la myit timung, dai hpe hkan shatsup myit dai n rai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Dai lam na lu jang shanhte a masin mala la achyaw malu ai majaw, Stehpan hpe wa udik let yu da mu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Shi chyawm gaw Chyoi pra ai Wenyi hpring nna, lamu de azi yu wu yang, Karai Kasang a hpung shingkang hte Karai Kasang a hkra maga de Yesu tsap nga ai hpe, mu wu ai rai nna,
  </para>
  <para style="p">
    <verse number="56" style="v" />“Yu u, sumsing lamu hpaw malang nga ai hte, Karai Kasang a hkra maga de Masha Kasha tsap nga ai gaw, ngai mu se ai,” nga ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Shaloi shanhte gaw aja awa jahtau let, tinang a na pat kau nhtawm, lang lata rau shi hpang de htim nna,
  </para>
  <para style="p">
    <verse number="58" style="v" />mare shinggan de shapraw nhtawm, nlung hte jawm kabai mu ai: sakse ni mung, Shawlu mying ai shabrang wa a lagaw nhpang e, tinang a hpun palawng raw tawn ma ai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Shing rai kabai nga ma yang Stehpan gaw akyu hpyi let, “Madu Yesu e, nye a wenyi hkap la ya e,” nga ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Bai, hput di let, “Madu e ndai mara shanhte hpe hkum shagun ya et,” nga nna nsen kaba hte jahtau wu ai: dai tsun ngut jang shi yup mat wa ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shawlu mung shi hpe sat kau ai amu hta awlaw lawm nga ai. Dai shani e Yerusalem mare na Hpung gaw zingri zingrat kaba hkrum wa ai rai nna, kasa ni hta kaga, gale nlang hte gaw, Yuda mung, Samari mung, shara magup hkan e bra mat wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rai timung, tara hkungga ai masha Stehpan hpe makoi mayang nna, shi a majaw hkrap ngu hkrap ngoi kaba di mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shawlu chyawm gaw, nta shagu shang nna, numsha lasha hpe ahkyit karawt la nhtawm, htawng hta sharen da ai hte, dai Hpung hpe hpya sharun da mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bra hkawm mat wa ai ni chyawm gaw, mungga hkaw dan let htawt hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Hpilip gaw Samari mare de sa wa nna, Hkristu a lam hkaw tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi tsun dan ai lam na ai hte, shi madun ai lamik kumla mu ma yang, masha wunawng wuwa myit langai sha hte shi a ga madat mara nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, nat shung ai ni law law hta na, n seng ai nat ni jahtau marawn let pru mat shajang ma ai; hkum katsing si ai ni hte lagaw hten ai ni law law mung, mai mat shajang ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna, dai mare hta kabu gara lam kaba rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, Simun mying ai wa langai mi, shawng e dai mare hta lakle amu dan nna, shi hkum hpe, “Ngai gaw kang ai wa rai nngai,” nga nna Samari masha ni hpe shamau mu ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />masha kaji kaba yawng mung, “Ndai wa gaw, Galu kaba ngu ai, Karai Kasang a atsam rai nga ai,” nga nna shi a ga madat ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai wa gaw, na na wa shi a lakle amu hte shanhte hpe shamau mu ai majaw, shi hpe kam ya ai rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung, Karai Kasang a mungdan hte Yesu Hkristu a amying ningsang hte seng ai kabu gara shiga lam, Hpilip hkaw dan ai hpe, kamsham ma yang, numsha lasha baptisma hkam la shajang ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Simun shi mung kamsham nna, baptisma hkam la ngut jang, Hpilip kaw hkan nang nga ai: lamik kumla hte mauhpa amu kaba ni shi mu jang, mau mahka mat nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Samari masha ni, Karai Kasang a mungga hta la ma ai hpe, Yerusalem e nga ai kasa ni na ma yang, shanhte gaw Petru yan Yawhan hpe shangun dat mu ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />shan mung du jang, dai masha ni Chyoi pra ai Wenyi lu la na matu akyu hpyi ya mu ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />kaning rai nme law, shanhte hta na gade a ntsa e mung, Chyoi pra ai Wenyi garai n yu wa ai; Madu Yesu a amying hta baptisma a hkam ai sha, naw rai nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna kasa yan shanhte a ntsa e lata mara ya jang, shanhte dai Chyoi pra ai Wenyi hkam la lu ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kasa yan a lata mara ai hte Wenyi hkam la lu ai hpe Simun mu jang, shi gumhpraw sa sak nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />“Gade a ntsa e rai timung ngai lata mara jang, dai wa Chyoi pra ai Wenyi lu la na matu, dai baw ahkang ngai e mung jaw mi,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Petru chyawm gaw, “Karai Kasang a kumhpa hpe gumhpraw hte lu la na re ai, nga nna myit ndai majaw, na a gumhpraw gaw nang hte rau hten bya mat u ga,
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a myit Karai Kasang a man e n ding nga lit dai majaw, ndai lam hta nang hpa mung lawm lu ndai n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai majaw, na n hkru ai lam hpe myit malai lu u; na a kraw hta myit mang kau ai lam hpe, mahkoi raw dat kau ya dam nhten, shi Madu kaw hpyi nem u.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ladu nan ahkut nna n hkru ai hte, n ding n man ai hta ahkang achyang nga ndai gaw, ngai mu da de ai,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Simun gaw, “Nan tsun ai lam hpa mung ngai kaw n du u ga, nye a matu mara nan lala dai Madu kaw hpyi ya mi,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shan chyawm gaw, dai Madu a mungga lam sakse hkam nna hkai dan ngut jang, Samari kahtawng law law hkan e dai kabu gara shiga hkaw dan let, Yerusalem mare de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya, Madu a lamu kasa Hpilip hpe tsun wu ai gaw, “Rawt u; Yerusalem kaw nna Gaza de hprang ai lam pru hkra, dingda de tawk sa wa su,” ngu wu ai; lam dai gaw nam mali lam rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shaloi shi rawt nna sa wa ai; ya yu mu, Ehtiopi mung up ai hkawhkam jan Kandake a man e ahkang kaba lu nna, shi a sutgan yawng sin ai, unuk re ai, Ehtiopi masha langai mi, nawku na nga, Yerusalem de sa wa sai:
  </para>
  <para style="p">
    <verse number="28" style="v" />ya shi bai wa nna, shi a leng hta dung let, myihtoi Esaia laika hti nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi Wenyi gaw Hpilip hpe, “Sa sit, dai leng de rau rai u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hpilip mung gat sa wa nna, myihtoi Esaia laika hti nga ai na wu yang, “Nang hti ai lam hpe chye na da wu ni?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai wa gaw, “Htai ya ai mi n nga yang, ngai kaning rai chye na na rai ta?” nga nna htan nhtawm, shi kaw rau lung dung na, Hpilip hpe saw wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shi hti ai laika a ga gaw ndai rai nga ai, “Sat na matu sagu hpe zawn, shi hpe dun sa wa nu ai; Sagu kasha gaw mun rep ai wa a man e atsin sha nga ai zawn, Shi mung n shaga ai sha nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shagrit kau ai hkrum nga ai hta, shi dawdan ai kaw na lawt lu wu ai: Rai timung shi asak hpe ga ntsa na dawm kau ya wu ai majaw, Shi a baw sang ni a lam, kadai gawn dan lu na rai ta?” nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi dai Unuk wa gaw Hpilip hpe, “Rai taw, dai myihtoi wa gaw kadai hpe sha-ang nna tsun ai rai ta? shi hkum hpe tsun ai rai kun? shing n rai, kaga wa a lam tsun ai rai kun?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shaloi Hpilip ga tsun hpaw nna, dai laika hta ga sharawt nhtawm, Yesu hte seng ai kabu gara shiga, shi hpe hkai dan wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shing rai sa wa ma yang, hka nga ai kaw du jang, dai Unuk wa gaw, “Yu u, nang e hka nga nga ai; ngai baptisma hkam na, hpa hkum shara nga a ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />(Hpilip gaw, “Na a myit mahkra hte nang kamsham nit yang gaw hkam la mai ai,” ngu wu ai. Shi mung, “Yesu Hkristu Karai Kasang a kasha rai nga ai gaw, ngai kamsham ni ai,” ngu nna htan wu ai)
  </para>
  <para style="p">
    <verse number="38" style="v" />Shaloi shi a leng jahkring na tsun nhtawm, shan lahkawng hka de yu wa nna, Hpilip gaw Unuk wa hpe baptisma jaw wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hka na lung wa ma yang, dai Madu a Wenyi Hpilip hpe woi mat wa nna, Unuk wa mung shi sa wa ai lam de kabu gara let bai wa wu ai rai nna, shi e bai n mu wu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hpilip chyawm gaw, Azutu mare e wa du ai rai nna, dai mung ga sa wa yang, Kesare mare du hkra mare shagu hkan e dai kabu gara shiga hkai dan wu ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shawlu chyawm gaw, Madu a sape ni hpe jahkrit shama ai hte sat kau na nga, masin naw rawt bu nga ai rai nna, hkinjawng agyi kaw sa nhtawm,
  </para>
  <para style="p">
    <verse number="2" style="v" />ndai lam hkan ai, numsha lasha mu mamu hpe rim la nna, Yerusalem de dun wa lu hkra, Damasku mare na tara jawng ni hpe, jaw dat na ahkang laika hpyi gun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya sa wa yang, Damasku mare de shi ni magang wa sai rai nna, akajawng sha lamu de na nhtoi shi a grup e htoi tu pru wa ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />shi mung, ga e kadawng taw mat ai hte, “Shawlu, Shawlu, nang ngai hpe hpa rai zingri nga n ta?” nga nna shi hpe tsun ai nsen na wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi shi gaw, “Madu e, nang kadai rai nga n ta?” ngu nna san wu yang, Madu gaw, “Nang zingri zingrat ai Yesu rai nga nngai:
  </para>
  <para style="p">
    <verse number="6" style="v" />rai timung, rawt u, mare de shang wa u; nang galaw lu na lam nang hpe tsun dan shangun na we ai,” nga nna htan wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi hte rau sa ai manang ni gaw, dai nsen na timung, kadai hpe mung n mu ma ai majaw, mau let tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Shawlu rawt nna, myi hpaw yu wu yang, hpa mung n mu lu ai rai nna, shi hpe lata e dun let, Damasku mare de woi shang wa mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya shi gaw masum ya tup myi n mu nna, n lu n sha ai nga nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Damasku mare e Anani mying ai sape langai mi nga ai rai nna, Madu gaw shingran hta, “Anani e,” ngu wu ai. Shi mung, “Madu e, nang nga nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu bai tsun wu ai gaw, “Rawt u, Lam Ding ngu ai mare lam de sa nna, Yuda nta e, Tarshu masha Shawlu hpe sa tam su; yu u, shi akyu hpyi nga ai rai nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />Anani mying ai wa shang sa nna, shi myi bai hpaw ya n ga nga, shi a ntsa e lata mara da ya ai hpe, shingran hta mu nu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anani chyawm gaw, “Madu e, dai wa gaw Yerusalem e, na a chyoi pra ai ni hpe n hkru ai hku gade wa galaw ai gaw, ashi law law ngai na se ai;
  </para>
  <para style="p">
    <verse number="14" style="v" />ndai yang e mung, na a mying ningsang hpyi gang ai ni yawng mayawng hpe gyit dun la na nga, hkinjawng agyi ni kaw na ahkang lu la sai rai nga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu mung, “She sa su; dai wa gaw, maigan amyu ni hte hkawhkam ni a man e mung, Israela amyu masha ni a man e mung, nye a amying gun hpai na matu, nye a ngu nna san tawn da ai malai rai nga ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />kaning rai nme law, nye mying majaw gade wa matsan tsin-yam hkrum na gaw, ngai shi hpe madun na we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Anani du sa nna, dai nta de shang nhtawm, Shawlu a ntsa e lata mara let, “Hpunau Shawlu e, nang myi bai mu lu nna, Chyoi pra ai Wenyi hpring lit ga nga, nang sa wa ai lam e, nang hpe shadan dan ai Madu Yesu gaw, ngai e shangun dat ni ai,” ngu wu yang,
  </para>
  <para style="p">
    <verse number="18" style="v" />Shawlu a myi hta na asep zawn re ai alawan gaw hkrat mat nna, shi myi bai mu lu ai; shaloi shi rawt nna, baptisma hkam la wu ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />lusha mung sha nna, n-gun awai la wu ai. Dai hpang Shawlu gaw Damasku na sape ni hte rau tawng marang mi kanawn nga let,
  </para>
  <para style="p">
    <verse number="20" style="v" />Yesu gaw Karai Kasang a kasha rai nga ai, nga nna shaloi jang tara jawng ni hta hkaw dan nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a ga na ai ni nlang mau mahka let, “Ndai wa gaw Yerusalem e amying ndai gang ai ni hpe sharun shabya ai wa rai nga ai, n rai ni? ya ndai de mung, dai baw ni hpe gyit la nna, hkinjawng agyi ni hpang de wa ap na maw ai hte sa du ra hka,” nga nna tsun shajang ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shawlu chyawm gaw n-gun ja wa nna, Yesu gaw Hkristu nan rai nga ai lam pra pra madun dan ai hte, Damasku e nga ai Yuda ni hpe shamak kau mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya nhtoi tsawmra wa na jang, Yuda masha ni shi hpe sat kau na bawng ma ai: rai timung, shanhte a maw ai lam hpe Shawlu chye wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi hpe sat kau lu hkra, shani shana mare chyinghka ni hta hkap nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi a sape ni chyawm gaw, shana e shi hpe woi la nna, ka hta mare bunghku kaw nna shayat dat mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpang Yerusalem de du wa jang, sape ni hte kanawn na maw wu ai; rai timung, shi sape rai sai hpe n kam ma ai majaw, nlang hte shi hpe hkrit da mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Barnaba chyawm gaw shi hpe kasa ni hpang de woi wa wu ai rai nna, Shawlu shi dai Madu hte lam e kaning rai hkrum nna, dai Madu e shi hpe tsun ai ga na lu ai mung, Damasku mare hta Yesu a mying gang nna nden ja ai myit hte hkaw dan ai lam mung, shanhte hpe hkai dan mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai Yerusalem mare e shi shanhte hte rau pru pru shang shang rai nga let,
  </para>
  <para style="p">
    <verse number="29" style="v" />Madu a mying ningsang gang nna, nden ja ai myit hte hkaw tsun nga ai; Heleni ngu ai ni hte mung shi ndang hkat nga ai rai nna, shanhte gaw shi hpe sat kau na maw ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai lam hpunau ni chye jang, shi hpe Kesare de sa dat nna, Tarshu de shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hte yang, Yuda mung, Galile mung hte Samari mung shara magup hkan e nga ai Hpung gaw, shadaw shangang ai lu la nna, angwi apyaw rai nga ai; dai Madu hpe hkrit hkungga ai hte, Chyoi pra ai Wenyi a shalan shabran ai lam ni hta hkawm sa let, shanhte law htam wa ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai shaloi e Petru gaw shara magup hkan e kawan hkawm wa let, Luda mare e nga ai chyoi pra ai ni kaw mung sa du ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai yang e hkum katsing si nna, matsat ning tup yup shara na n rawt lu ai Ainea mying ai masha langai mi hpe mu hkrup wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi Petru gaw, “Ainea e, Yesu Hkristu nang hpe shamai nit dai: rawt u, na hpun panep lajang u,” ngu nna shi hpe tsun wu ai: shaloi jang shi rawt wa lu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Luda hte Sharon e nga nga ai ni nlang hte mung shi hpe mu nna, Madu hpang de kayin bang wa ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ya, Yopa mare hta Tabihta mying ai numsha sape langai mi nga ai; mying de a ga lachyum gaw Dorka ngu ai rai lu ai: dai numsha gaw kaja ai bungli hte alu jaw ya ai lam hta, myit tsup ai jan rai nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai hte yang shi machyi nna si mat sai; mang kashin nna, ntsa gawk e sharawn da ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Luda gaw Yopa mare hte ni nga ai rai nna, Petru dai yang nga ai lam sape ni na ma yang, shanhte marai lahkawng shangun dat nna, “Anhte kaw sa na hkum hkring et,” ngu nna hpyi dat mu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shaloi Petru rawt nna, dai yan hte rau hkan sa wa ai. Shi du jang ntsa gawk de woi shawn mu ai rai nna, gaida jan ni nlang hkrap let shi a makau e tsap nna, shanhte hte rau naw nga yang, Dorka chywi ai palawng ni, nba ni, madun let nga nga ma la ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Petru chyawm gaw nlang hte hpe shapraw kau ai; shing rai dai mang de kayin let, “Tabihta e, rawt u,” ngu wu ai. Shaloi dai jan myi hpaw nna, Petru hpe mu jang, rawt dung nga ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Petru mung lata ladawn nna gang sharawt nhtawm, chyoi pra ai ni hte gaida jan ni hpe shaga la nna, shi hpe chyahkrung ap ya wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dai lam hpe Yopa ginwang ting na ma ai rai nna, law law wa, dai Madu hpe kamsham ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shing rai Petru gaw, Simun ngu ai shanhpyi sama wa hte rau, nhtoi tsawmra na hkra, Yopa mare hta nga nga ai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Kesare mare e, Itali ngu ai hpyen dap hta, Korneli mying ai hpyen latsa up ai bu langai mi nga ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />dai wa gaw tara hkungga myit rawng nna, shi a nta na ni nlang hte rau Karai Kasang hpe hkrit hkungga ai hte, masha ni hpe alu law law jaw let, Karai kasang hpe tut tut a hpyi nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lani wa mi ahkying jahku daram e, Karai Kasang a lamu kasa shi kaw du nna, “Korneli e,” nga nna shi hpe shaga ai gaw, shingran hta leng leng mu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw dai wa hpe azi yu nna, “Madu e, hpa lam rai ta?” ngu nna hkrit let shi hpe san wu ai. Dai wa chyawm gaw, “Na a akyu hpyi ai hte alu jaw ai lam, Karai Kasang a man e, masat dingsat matu hkrang salit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya Yopa mare de shangun nna, Petru ngu ai Simun hpe shaga la su;
  </para>
  <para style="p">
    <verse number="6" style="v" />shi gaw shanhpyi sama Simun a nta e shingbyi nga ai; shi a nta gaw nammukdara makau e rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi hte ga tsun ai lamu kasa wa mat jang, shangun ma lahkawng hte, shi kaw tut hkan nga ai ni hta na, tara hkungga ai hpyen ma langai mi hpe shaga nna,
  </para>
  <para style="p">
    <verse number="8" style="v" />shanhte hpe yawng mayawng hkai dan nhtawm, Yopa mare de shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte mung hpang shani e sa wa nna, Yopa makau du magang jang, Petru gaw ahkying kru daram e akyu hpyi na nga, nta ntsa de lung wa ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi shi kawsi nna shat sha mayu nga ai: rai timung, lusha naw shachyip nga yang, shi myit nawng mat wa nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />sumsing lamu hpaw wa ai hte, hpajawng kaba zawn, jut mali de jum nna, ga de shayu dat ai arai hpe mu wu ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />dai hta e, ga ntsa na lagaw mali tu ai baw dusat hte gumrawt hkawm ai baw amyu myu, ntsa malen na u amyu myu, rawng nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nsen mung ngoi pru ai gaw, “Petru e, rawt u, sat sha u,” nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Petru chyawm gaw, “N rai law, Madu e; n sha mai ai hte n san n seng ai rai hpe, ngai galoi mung n sha yu nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai lang mi na nsen gaw, “Karai Kasang jasan jaseng ai rai hpe, n sha mai ai hkum nga et,” nga nna shi kaw bai ngoi pru ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Masum lang shing nga nhtawm, dai rai hpe sumsing lamu de, shaloi jang dawm la wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Petru gaw, shi mu ai shingran hpa rai na ra ai i? nga nna myit sumru yu nga yang, yu mu, Korneli shangun dat ai ni gaw, Simun a nta tam san let, chyinghka makau e tsap nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />Petru ngu ai Simun, nta dai hta nga ai n nga ai, jahtau san yu ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Petru mung, shingran de a lam myit naw sumru nga yang, Wenyi gaw, “Yu u, masha lahkawng nang hpe tam nga ma ai: rawt u, yu wa sit;
  </para>
  <para style="p">
    <verse number="20" style="v" />shan hpe ngai shangun dat mawe ai majaw, myit hpa n ganung ai sha, shan hte rau sa wa su,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi Petru dai ni hpang de yu wa nna, “Yu mu, nanhte tam ai wa ngai rai nga nngai: hpa lam rawng nna sa myit ta?” ngu nna san mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte gaw, “Dingman nna, Karai Kasang hpe hkrit hkungga ai hte, Yuda amyu ting a man e myi man pa ai, hpyen latsa up ai bu Korneli gaw, nang hpe shi a nta de shaga bang nna, nang tsun ai ga madat la na lam, chyoi pra ai lamu kasa nan shadum dan ai lu la nu ai,” ngu nna tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna, shi shanhte hpe shaga jashawn nhtawm, manam daw mu ai. Ya hpang shani e shi rawt nna, shanhte hte rau sa wa ai; Yopa mare na kahpu kanau ni nkau mi mung hkan nang ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />De a hpang shani Kesare mare de shang wa ai; Korneli chyawm gaw, shi a hpunau ni hte makyin jinghku ni hpe jahpawng tawn nna, shanhte hpe la nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya, Petru shang wa jang, Korneli gaw hkap tau let, shi a lagaw nhpang e dingnyawm nawku wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Petru chyawm gaw, “Rawt u, ngai mung masha she rai nngai,” nga nna tsun let shi hpe dun sharawt wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shing rai shi hte shaga let shang wa yu yang, law law hpawng nga ma ai hpe, mu wu ai. Shaloi Petru gaw shanhte hpe, “Yuda masha ngu ai wa gaw maigan amyu masha hte kanawn mazum, htinglup htingshang n rai mai ai, nanhte nan chye nga myit dai:
  </para>
  <para style="p">
    <verse number="28" style="v" />dai rai tim kadai wa hpe mung n ging n dan ai, n san n seng ai, n nga mai ai lam gaw, Karai Kasang ngai hpe madun ni ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai rai nga ai majaw, ngai e shaga yang, ngai n ningdang ai sha hkan nang ring ngai. Dai rai nna, hpa lam rawng ai majaw ngai hpe shaga myit ta? ngai san nga nngai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Korneli gaw, “Dai ni mali ya rai sai, akyu hpyi ai ahkying jahku hta, nye a nta e ngai akyu hpyi nga yang, yu u, tu kabrim ai hpun palawng bu hpun ai wa langai mi nye a man e tsap pru nna,
  </para>
  <para style="p">
    <verse number="31" style="v" />‘Korneli e, na a akyu hpyi ai ga madat mara nu ai; na alu jaw ai mung Karai Kasang matsing da nu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai re ai majaw Yopa de shangun nna, Petru ngu ai Simun hpe shaga su; dai wa gaw, nammukdara makau e nga ai shanhpyi sama Simun a nta e shingbyi nga ai,’ nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai majaw, shaloi jang ngai nang hpang de shangun dat ai rai nna, ya nang du ai gaw, mai kaja nga ai. Dai rai nna, shi Madu nang hpe hkang da mada madat la na, ya anhte nlang Karai Kasang a man e, rai nga ga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi Petru ga hpaw nna, “Karai Kasang masha myi man n tau ai gaw, ya ngai gaja wa chye se ai:
  </para>
  <para style="p">
    <verse number="35" style="v" />amyu baw shagu hta shi hpe hkrit hkungga ai hte dingman ai amu galaw ai wa gaw, shi kaw myi man pa nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nga yawng nga pra Madu rai nga ai Yesu Hkristu a marang e ngwipyaw ai hte seng ai kabu gara shiga hkaw tsun dan u ga nga, Israela kashu kasha ni kaw shangun dat ai mungga ngu ai:
  </para>
  <para style="p">
    <verse number="37" style="v" />Yawhan baptisma tara hkaw ai hpang, Galile mung kaw nna Yuda mung ting kajai gara wa ai lam hpe, nanhte nan chye nga myit dai:
  </para>
  <para style="p">
    <verse number="38" style="v" />dai gaw Nazaret wa Yesu a lam rai nga ai; Karai Kasang gaw Chyoi pra ai Wenyi hte mung, n-gun atsam hte mung, shi hpe chya ya wu ai; Karai Kasang shi hte rau rai nga ai majaw, mai kaja ai amu shi galaw nna, nat gumlau e zingri zingrat hkrum ai ni yawng mayawng hpe shamai ya let, kawan katsan hkawm nga ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shing rai, Yuda masha ni a mung hta e mung, Yerusalem mare hta mung, shi galaw hkawm wa ai amu yawng mayawng a sakse ni, anhte rai nga ga ai: dai wa hpe nan shanhte hpun hta jen sat kau mu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Karai Kasang chyawm gaw, masum ya nhtoi hta dai wa hpe sharawt dat wu ai rai nna, mung masha danghta man e n rai, sakse matu nga nna, shawng e Karai Kasang lata san da sai anhte ni a man e sha shadan dan mi ai:
  </para>
  <para style="p">
    <verse number="41" style="v" />si ai ni kaw na shi bai rawt ai hpang e, anhte gaw shi hte rau lu sha lu ga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shi Madu nan mung, hkrung ai ni hte si sai ni a tara agyi tai na, Karai Kasang san da ai wa rai nga sai lam, mung masha ni hpe tsun dan let sakse hkam na matu shi anhte hpe hkang da ma ni ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shi hpe kamsham masham ni nlang, shi mying ningsang a marang e, yubak raw dat kau ya ai hkrum na mara ai, nga nna tsun ai myihtoi mahkra mung shi a lam sakse rai nga ma ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Petru gaw dai lam naw tsun nga yang, dai ga na ai ni mahkra a ntsa e Chyoi pra ai Wenyi yu shang wa ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chyoi pra ai Wenyi ngu ai kumhpa gaw, maigan amyu masha ntsa e ru jaw ai majaw, Petru hte rau hkan nang ai, matu gadoi lam hkan sai, kamsham ai ni, mau mahka nga ma ai:
  </para>
  <para style="p">
    <verse number="46" style="v" />kaning rai nme law, shanhte ga amyu myu tsun ai hte Karai Kasang hpe shagrau ma ai, na lu ma ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Dai rai nna Petru gaw, “Anhte zawn Chyoi pra ai Wenyi hkam la ai ni hpe, baptisma n hkam shangun na nga, hka hpe kadai hkum lu a ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Shing rai, Yesu Hkristu a amying hta baptisma hkam na lam, shi shanhte hpe hkang da mu ai. Shaloi, nhtoi loi mi naw hkring nga na, shanhte shi hpe hpyi ma ai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Maigan amyu masha ni mung, Karai Kasang a mungga hta la ma ai, nga ai lam hpe kasa ni hte Yuda mung hkan na kahpu kanau ni na ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rai timung, Petru gaw Yerusalem de lung wa jang matu gadoi lam hkan ai ni mahtang,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Nang gaw matu gadoi n hkam ai ni a nta shang nna, shanhte hte rau lu rau sha ndai,” nga nna hkap ndang hkat ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />shaloi Petru ga sharawt nna, dai lam hpe npawt ndung hkren hkai dan nna shanhte hpe,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ngai gaw Yopa mare hta akyu hpyi nga nngai; shaloi ngai myit nawng mat wa nna, hpajawng kaba zawn jut mali de jum let, sumsing lamu de na ngai hpang de jahkrat dat ai arai yu wa ai gaw, shingran hta ngai mu we ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />dai hpe achyoi sha galaw yu yang, ga ntsa na lagaw mali tu ai baw dusat, matse labye, gumrawt hkawm ai baw hte, ntsa malen u ni rawng nga ai, ngai mu nna sumru yu nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai sha n rai, nsen ngoi pru ai mung, ‘Petru e, rawt u; sat sha u,’ nga ai, ngai na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai chyawm gaw, ‘N rai law, Madu e; n sha mai ai hte n san n seng ai baw, ngai galoi mung n sha ga nngai,’ ngu we ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai lang mi na nsen gaw, ‘Karai Kasang jasan jaseng ai rai hpe n sha mai ai hkum nga et,’ nga nna lamu de na tsun pru ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />shing rai masum lang byin nna, dai yawng hpe sumsing lamu de dawm la wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi jang, Kesare mare nna, ngai hpang de shangun dat ai masha masum, anhte nga ai nta ndaw e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Myit n ganung ai sha, shanhte kaw hkan sa na, Chyoi pra ai Wenyi ngai hpe tsun ni ai; ndai hpunau kru mung ngai hte rau sa nna, dai wa a nta de anhte shang saga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi dai wa gaw, shi a nta e lamu kasa yu tsap ai hte, Yopa mare de masha shangun nna, Petru ngu ai Simun hpe shaga su;
  </para>
  <para style="p">
    <verse number="14" style="v" />nang hte na nta masha ni nlang hkye hkrang la kaw du lu myit ga, shi nang hpe ga tsun dan na ra ai, nga nna sa tsun ai lam, anhte hpe hkai dan mi ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya, ngai ga hpaw nna tsun nga yang, shawng de anhte a ntsa e Chyoi pra ai Wenyi yu hkrat ai zawn, shanhte hta mung yu hkrat wa malu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi she, Yawhan gaw hka hte baptisma jaw wu ai; nanhte chyawm gaw, Chyoi pra ai Wenyi hta baptisma hkam la na marin dai, nga nna, shi Madu tsun ai ga hpe ngai dum we ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai re ai majaw, shi madu Yesu Hkristu hpe kamsham ai shani, anhte hpe jaw ai chyeju kumhpa hte maren she, Karai Kasang shanhte hpe jaw ai rai yang gaw, ngai hpa wa re ai ngu nna, Karai Kasang hpe shadang lu na rai ta?” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai lam na ma yang, shanhte myit pyaw nga nna, “Aw, rai sa, Karai Kasang gaw maigan amyu ni hpe mung, asak hkrung ai hte seng ai myit malai lam jaw manu hka,” nga nna Karai Kasang hpe shagrau sha-a ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya Stehpan kaw nna hpang ai zingri zingrat lam majaw bra mat wa ai ni gaw, Hpinisi, Kupru mung hte Antioki mare du hkra len hkawm wa nna, Yuda masha ni hpe hkrai sha, dai mungga hkaw dan ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rai timung, shanhte hta na Kupru hte Kureni mung na ni nkau mi, Antioki de hkan du ma ai rai nna, Madu Yesu a kabu gara shiga, Heleni masha ni hpe mung tsun dan ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai Madu a lata shanhte hte rau nga nga ai rai nna, kamsham ai hpung daw wa kaba, Madu hpang de kayin bang wa ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai ni a lam, Yerusalem na Hpung a na hta kajai gumhkawng shang wa ai rai nna, shanhte gaw Barnaba hpe Antioki du hkra shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai wa du nna, Karai Kasang a chyeju mu lu yang, kabu gara nga ai hte, shanhte dai Madu hta lashum shawt manoi manat nga na matu, nlang hte hpe shadum jahprang mu ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />kaning rai nme law, dai wa gaw masha kaja rai nna, Chyoi pra ai Wenyi hte mung, makam masham hte mung, hkum tsup ai wa rai nga ai: masha law law wa hpe dai Madu hpang de jat bang wa shangun mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai Barnaba gaw, Shawlu hpe sa tam na Tarshu de pru sa wa nna, shi hpe mu jang Antioki de woi wa wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya, shan gaw laning mi tup dai Hpung hte rau hpawng nga ma ai rai nna, masha law law hpe sharin shaga lu ma ai; sape ni mung, Hkristu ni, ngu ai amying hpe, Antioki mare hta shawng lu la ai rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai nhtoi hte hta myihtoi nkau mi Yerusalem kaw nna, Antioki de sa du ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai ni hta na Agabu ngu ai wa rawt nna, ga ntsa ting hta hku wa kaba wa na ra ai lam, Wenyi madun ai hte tsun dan mu ai; dai gaw hkawhkam Klawdi a aprat e byin wa sai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai rai nna, sape ni gaw, Yuda mung na kahpu kanau ni hpang de langai hte langai rai lu ai made karum dat na nga, myit shatawng da ma ai:
  </para>
  <para style="p">
    <verse number="30" style="v" />dai hte maren shanhte galaw nna, Barnaba yan Shawlu a lata hta salang ni hpang de shagun dat ma ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai aten hte yang, Herod hkawhkam gaw, Hpung masha nkau mi hpe zingri zingrat na dakan nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai, Yawhan a kahpu Yaku hpe htau kau wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai lam Yuda ni yu kabu ai mu jang, Petru hpe mung rim la shayan wu ai. Dai aten gaw Azuma poi rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya Shalai wa poi lai jang she, mung masha ni hpe shapraw ya na myit da wu ai majaw, shi hpe rim la ngut yang htawng hta bang da nhtawm, shi hpe sin nga na matu, hpyen hpung mali a lata de ap ya mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai Petru htawng hta rawng nga ai; Hpung masha ni chyawm gaw shi a matu mara Karai Kasang kaw akroi anoi akyu hpyi ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Herod gaw shi hpe shapraw la na a shawng shana e, Petru gaw hpri sumri lahkawng gyit nna, hpyen ma lahkawng lapran e yup nga ai: sin langa ni mung, htawng chyinghka e sin nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi, yu u, Madu a kasa langai mi pru tsap nna, dai gawk hta nhtoi htoi nga ai: shi gaw Petru a garep gumhpuk ya nna, “Alawan rawt u,” ngu nna jasu wu ai; shaloi hpri sumri ni mung shi a lata na malaw mat lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai lamu kasa gaw, “Shingkyit kyit nna, kyepdin din u,” ngu wu ai. Shi mung galaw wu ai. Bai, “Na nba lawai nna ngai kaw hkan rit,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi shi pru nna hkan nang nga ai; rai timung, lamu kasa shabyin ai amu dai hpe gaja wa re ai, shi n chye nna, shingran rai nga ai, ngu nna myit nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya shan gaw sin ai shara gap padu lahkawng lai nna, mare de pru ai hpri chyinghka du jang, chyinghka dai mung shi chyu hpaw mat wa ai rai nna, shan pru nhtawm, mare lam langai mi hta hkan sa wa nna, lamu kasa gaw, shaloi jang shi hte hka mat wa ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya Petru myit arai la lu jang, Madu gaw shi a lamu kasa shangun dat nna, Herod a lata hte Yuda masha ni myit mada ai lam yawng hta na ngai hpe shaw la sai gaw, ya ngai teng teng chye se ai, nga nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />dai lam myit aru ngut jang, masha tsawmra wa hpawng nna, akyu hpyi nga ai shara, Marku mying hkawt mying ai, Yawhan a kanu Mari a nta de du wa ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai dai wang chyinghka wa akawk wu yang, Rode mying ai num kasha langai mi, madat yu na nga pru sa ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw Petru a nsen re ai chye jang, kabu ai majaw chyinghka n hpaw ya ai sha, nhku de gat shang wa nna, “Petru gaw chyinghka lam e tsap nga ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte chyawm gaw, “Nang mana ndai,” shi e ngu mu ai. Shi mahtang, “gaja wa rai nga ai,” nga nna a tsun shanang nga ai. Bai shanhte gaw, “Shi a lamu kasa rai nga lu ai,” nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai timung, Petru gaw a akawk nga ai rai nna, shanhte hpaw la mu yang, shi hpe mada yu nna, mau mahka nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi gaw, shanhte hpe tsin mu ga nga nna, lata dingsi nhtawm, shi hpe Madu e htawng hta na kaning rai shaw la ai lam shanhte hpe tsun dan nna, “Ndai lam ni Yaku hte kahpu kanau ni hpe tsun shana dat mu,” ngu mu ai. Shaloi shi pru nna, shara kaga de sa mat wa ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya nhtoi htoi yang hpyen masha ni gaw, Petru hta hpa byin ai n chye ma ai majaw, grai ruk rak bu ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Herod chyawm gaw Petru hpe tam nna nmu jang, sin langa ni hpe gawn yu nhtawm, shanhte hpe sat kau na lam dawdan nga ai. Dai hpang shi gaw Yuda mung nna Kesare mare de yu wa nna nga nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hte yang hkawhkam wa gaw Turu hte Sidun masha ni hpe grai pawt bu da wu ai; dai rai nna, shanhte gaw myit langai sha hte shi hpang de sa nna, Blastu ngu ai, shi a kun hkringmang wa kaw sa hpa let, majan htinglu na lam sa hpyi ma ai: kaning rai nme law, shanhte a mung mahtang hkawhkam a mung na, lusha shahpa lu la ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi, madat da ai shani hta e, Herod gaw hkawhkam hpun palawng sumli nna, tingnyang hta dung let, shanhte hpe ga dan dat mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi mung masha ni gaw, “Ndai gaw shinggyim masha nsen n rai, Karai Wa a nsen she rai nga ai,” nga nna jahtau ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai shaloi jang, Karai Kasang a hpung shingkang hpe n tau yu wu ai majaw, Madu a lamu kasa shi hpe ari jaw nna, byet e sha ai hte shi nsa hti mat ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai Madu a mungga chyawm gaw galu kaba wa nna, maden jat wa sai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Barnaba yan Shawlu gaw, shan a galaw daw ai amu hpe ngut jang, Marku ngu ai Yawhan hpe shaga la nhtawm, Yerusalem mare na bai wa ma ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Antioki mare na Hpung hta e, myihtoi ni, sara ni, nang nga ma ai: dai ni gaw, Barnaba, Nigera ngu ai Simun, Kureni masha Luki, Herod du wa kanawn kanau Manaen hte Shawlu hte rai nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya shanhte Madu hpe nawku let lusha gam nga yang, Chyoi pra ai Wenyi gaw, “Barnaba yan Shawlu hpe, ngai shaga da ai amu gun hpai na matu, san da mu,” nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hte maren shanhte gaw lusha gam let, akyu hpyi nna, shan a ntsa e lata mara jaw ngut jang, shan hpe dat mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai, Chyoi pra ai Wenyi shan hpe shangun dat mu ai hte maren, shan gaw Seluki de yu wa nna, dai yang na li jawn nhtawm, Kupru de du ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Salami mare hta naw nga ai hte yang, Yuda ni a tara jawng ni hta, Karai Kasang a mungga hkai dan mu ai; Yawhan mung shan a nrum ntau rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya shanhte gaw dai zunlawng ga sa wa nna Pahpu mare du ma yang, Bara-Yesu mying ai Yuda masha rai nga ai lakle sara hte masu ai myihtoi langai mi hpe, mu hkrup mu ai;
  </para>
  <para style="p">
    <verse number="7" style="v" />dai wa gaw, Sergi Pawlu ngu ai, myit kunghpan ai munggyi wa kaw nga ai wa re ai. Dai munggyi wa Karai Kasang a mungga madat la mayu nna, Barnaba yan Shawlu hpe shaga la mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi lakle sara ngu ai, lachyum hku shamying ai, Eluma gaw, dai munggyi wa a kamsham ai lam jahpyak kau ya mayu ai rai nna, shanhte hpe ndang shadang mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Pawlu ngu ai Shawlu gaw, Chyoi pra ai Wenyi hpring let, shi hpe azi da nna,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Myit magaw lam yawng hte gumle gumlau yawng hpring nga ai, nat a kasha, dingman ai lam shagu a hpyen wa e, Madu a dingman ai lam hpe hkap shadang na n sim nga n ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya, yu u, Madu a lata na ntsa e du nna, tawng marang mi jan n mu lu ai, myi kyaw nga na rin dai,” ngu wu ai. Shaloi jang shi a myi shinggang mat nna, nsin chyip rai mat salu ai; shing rai, shi a lata dun ai masha tam let, kayin hkawm nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai lam hpe munggyi wa mu jang, Madu a sharin shaga ai lam hpe mau ai hte kamsham nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpang Pawlu hte shi a manang ni gaw, Pahpu kaw nna li jawn nhtawm, Pamhpuli mung na Perga mare de du ma ai: Yawhan chyawm gaw shanhte hte hka nna, Yerusalem mare de wa mat ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai, shanhte gaw Perga kaw nna rawt sa wa yang, Pesidi mung na Antioki mare de du ma ai: ya laban nhtoi e tara jawng hta shang dung nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi tara laika hte myihtoi laika hti ngut jang, jawng agyi ni gaw shanhte hpang de masha shangun nna, “Hpunau ni e, shawa hpawng hpe shadum jahprang na ga lu myit yang gaw, shadum jahprang mu,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Pawlu rawt nna lata dingsi let, “Israela masha ni hte Karai Kasang hpe hkrit hkungga ai ni e, madat mara la mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ndai Israela amyu a Karai Kasang gaw, anhte a ji wa ni hpe lata la nu ai rai nna, Egutu mung e naw nga nga yang, dai amyu hpe shagrau nna, shada da ai lahpum ta hte shaw woi nu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai, mali shi ning daram, nam mali hkan e shanhte a akyang hpe sharang ya nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />Hkanan mung na masha amyu sanit hpe shaza kau nhtawm, mali tsa manga shi ning daram, dai ni a mungdan hta na sali shanhte hpe karan jaw mu ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />dai hte a hpang e myihtoi Samuela aprat du hkra tara agyi ni tawn da ya mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang shanhte hkawhkam hpyi nna, Karai Kasang gaw shanhte hpe, Ben-yamin amyu, Kisa a kasha Shawlu hpe mali shi ning laman e, shadun ya mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai wa hpe jahkrat kau nhtawm, Dawi hpe, shanhte a hkawhkam tai na sharawt ya wu ai: dai wa a lam shi nan sakse hkam ai gaw, ‘Nye a myit hte tup ai Yese a kasha Dawi hpe ngai mu se ai; dai wa gaw, ngai ra ai hku yawng shadik ya na ra ai,’ nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai wa a amyu matu hta na, Karai Kasang gaw, ga ndat nga ai hte maren, Israela masha ni a matu, Hkye hkrang la ai Madu Yesu hpe, paw pru shangun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai wa garai n pru yang Yawhan mung, Israela amyu yawng hpe myit malai hte seng ai baptisma lam shawng hkaw dan manu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai Yawhan gaw shi gun ai magam hpra wa na rai jang, ‘Ngai hpe kadai re ai nawn nga myit ta? Ngai gaw dai wa n rai nngai; yu mu, nye a hpang e langai mi du na ra ai; dai wa a kyepdin raw na pyi ngai n ging nngai,’ nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abraham a amyu kashu kasha ni hte, nanhte hta na Karai Kasang hpe hkrit hkungga ai, hpunau ni e, ndai hkye hkrang la ai lam a mungga gaw, anhte hpang de jaw dat ra ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nme law, Yerusalem na ni hte, shanhte a du gyi ni gaw, shi madu hpe mung, laban nhtoi shagu hti ai myihtoi ni a ga hpe mung, n chye na ai wa, shi hpe dawdan ai hte dai ga ni hpe shatup manu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shi hta si ging ai mara n mu timung, shi hpe sat kau na, Pilat kaw hpyi ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shing rai, shi hpe lakap nna ka da mada shatup ma jang, shi hpe hpun hta na jahkrat la nna, lup hta bang da mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Karai Kasang chyawm gaw, chyasi ni kaw na shi hpe sharawt la wu ai:
  </para>
  <para style="p">
    <verse number="31" style="v" />Galile mung kaw nna Yerusalem mare de shi hte rau lung wa ai ni ngu ai, mung masha ni a man e ya shi a sakse tai nga ai ni, nhtoi tsawmra na hkra shi hpe mu lu masai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shing rai, ‘Nang ngai sha rai nga ndai, dai ni ngai nang hpe shaprat sade ai,’ nga nna kanu lahkawng ngu na Shakawn Kungdawn ga hta ka da nga ai hte maren,
  </para>
  <para style="p">
    <verse number="33" style="v" />Karai Kasang Yesu hpe hkrung sharawt ya ai a marang e, ji wa ni hpe jaw da ai ga ndat hpe, anhte a kashu kasha ni hta shadik ya ai kabu gara shiga gaw, nanhte kaw gun sa saga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai hta kaga, shi hten bya ai galoi n hkrum hkra, si ai ni kaw na hkrung sharawt la na lam, Karai Kasang tsun ai gaw, Dawi hta nna, chyoi pra ai hte grin nga ai chyeju, ngai nanhte hpe jaw na made ai, nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kaning rai nme law, kaga Shakawn Kungdawn laika hta mung, ‘Na a Chyoi pra ai wa hten bya hkrum na nang hkraw na n rai,’ nga nna shi tsun ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ya Dawi gaw, shi a prat hte hta Karai Kasang a ra ai hku gun hpai ngut jang, yup mat nna, kaji kawa ni kaw tawn da ai hte, hten byak ai kaw du wa sai;
  </para>
  <para style="p">
    <verse number="37" style="v" />Karai Kasang hkrung sharawt la ai wa chyawm gaw, hten byak hkrum wu ai n rai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dai re ai majaw, hpunau ni e, dai wa a marang e, yubak raw dat kau lu na ahkang, nanhte hpe hkaw dan nga ai gaw, chye nga mu:
  </para>
  <para style="p">
    <verse number="39" style="v" />dai hta n-ga, Mawshe a tara hte dingman ai kaw n du lu ai, dai wa hpe kamsham ai ni nlang hte lam shagu hta dingman ai kaw du lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Dai re ai majaw, ‘Yu mu, jahpoi ai ni e, mau nna htum mat mu: Nanhte a nhtoi hta lam langai mi ngai shabyin na nngai;
  </para>
  <para style="p">
    <verse number="41" style="v" />Dai lam marai langai ngai nanhte hpe hkai dan timung, hpa n kam na marin dai,' nga nna myihtoi ni tsun ai ga, nanhte hta n ang u ga, sadi nga mu,” ngu nna hkaw tsun nga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ya shan pru wa yang, ndai ga hpang na laban nhtoi hta mung bai hkai dan na shanhte hpyi ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tara jawng na bra mat wa jang, Yuda ni hte tara hkungga ai proselutu ni law law wa, Pawlu yan Barnaba kaw hkan nang ma ai rai nna, Karai Kasang a chyeju hta shanhte grin nga na matu, shanhte hpe shadum jahprang shaja mu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Dai hpang na laban nhtoi hta, Karai Kasang a mungga na la na matu, mare ting ganoi mahkra, wa zuphpawng nga ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Yuda masha ni chyawm gaw dai shawa hpawng hpe mu jang, manawn ai myit hte hpring chyat nga ma ai rai nna, Pawlu tsun ai lam hpe ndang hkat ai hte aroi ara ngu da mu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Pawlu yan Barnaba mung nden ja ai myit hte, “Karai Kasang a mungga nanhte hpe shawng tsun dan na gaw, lam rai nga ai; rai timung, nanhte mahtang dai hpe gang kau nna, n htum n wai asak hte n ging ai gaw, tinang dai dawdan la myit dai majaw, yu mu, maigan amyu ni hpang de anhte myi man kayin na saga ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kaning rai nme law, ‘Lamu ga htum hkra hkye hkrang la ai lam tai wa hkra, Ngai nang hpe, maigan amyu ni a matu nhtoi shatai sade ai,' nga nna shi Madu anhte hpe hkang dat mani ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Maigan amyu ni dai na jang, kabu gara nga ai hte, Karai Kasang a mungga hpe shagrau sha-a ma ai: n htum n wai asak lu la na san da ai ni nlang hte mung, kamsham mat ma ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Karai Kasang a mungga gaw dai mung ting pri rai wa sai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Yuda masha ni chyawm gaw, tara hkungga nna arawng lu ai num ni hte, dai mare na agyi ni hte shadut nna, Pawlu yan Barnaba hpe zingri zingrat di shangun ai hte, shanhte a lamu ga jarit na shaden kau mu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Shan gaw tinang a lagaw na nhpu shanhte hpang maga ahpu kau da nna, Ikoni mare de du ma ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Sape ni chyawm gaw, kabu gara ai hte Chyoi pra ai Wenyi hpring nga ma ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Ikoni mare e rai nga yang, shanhte gaw Yuda masha ni a tara jawng hta rau shang nna, Yuda masha hte Heleni masha wunawng kaba kamsham mat hkra, ga tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rai timung, n madat hkraw ai Yuda masha ni gaw, maigan masha ni hpe myit shadut nna, hpunau ni hpe n dawng na hku gumlau mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai majaw shan mung tsawmra na hkra dai yang nga nna, Madu hta hpa let nden ja ai myit hte hkaw dan mu ai rai nna, shi Madu mung, shan a lata hta lamik kumla hte mauhpa amu shabyin ya let, shi a chyeju mungga a lam, sakse hkam ya nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mare na ni chyawm gaw myit bra wa ma ai rai nna, nkau mi Yuda ni hpang de, nkau mi kasa ni hpang de, rai mat ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya maigan masha hta na ni mung, Yuda masha ni hte shanhte a agyi ni mung, shan hpe aroi arip di nna nlung hte kabai sat na nga htim ma ai hpe,
  </para>
  <para style="p">
    <verse number="6" style="v" />shan dum rau nna, Lukaoni mung na mare, Lustra, Derbe hte dai yan a ginwang de hprawng mat wa ma ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />dai hkan e mung dai kabu gara shiga hkaw dan mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya Lustra mare hta e, kanu a hkritung nna lagaw hten ai chyahten labye rai nna, galoi mung n hkawm yu ai wa langai mi, dung nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi mung Pawlu tsun ai ga madat nga ai; dai wa hpe Pawlu azi yu wu yang mai wa lu hkra kamsham ai myit rawng nga ai hpe shi chye ya nna,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Ai jan rawt tsap u,” nga nna, nsen shaja tsun wu ai; shi mung, gumlawt rawt nna hkawm yu nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai, Pawlu galaw ai amu hpe shawa masha ni mu jang, shanhte gaw Lukaoni ga hte, “Hpara ni, masha hkumhkrang dagraw nna, anhte hpang de yu hkrat wa mara ai,” nga nna jahtau ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna shanhte gaw, Barnaba hpe Zeu, Pawlu ga ningbawng wa re ai majaw, shi hpe Herma, ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai mare shinggan e nga ai Zeu jawng na hkinjawng wa mung, mare chyinghka hkan e usu hte nampan shanghkawng ni la sa nna, shawa masha ni hte rau hkungga jaw na maw ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai timung, kasa Barnaba yan Pawlu gaw dai na jang tinang a hpun palawng gang je kau let, shawa hpawng ka-ang de gat shang nhtawm,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Hkau hte e, hpa rai dai galaw wa myit ta? An mung nanhte hte maren shinggyim masha yan sha rai ga ai; ndai kaman lila amu kau da nna, sumsing lamu hte ginding aga, nammukdara hte dai hta rawng ai nga manga hpe hpan tawn da ai, ahkrung nga ai Karai Kasang hpang de kayin wa myit ga, ngu nna she nanhte hpe kabu gara shiga hkaw dan ai rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw, moi shawng na ni a ban e masha amyu baw shagu hpe, tinang ra ai hku hkan mu ga nga, dat tawn da mu ai;
  </para>
  <para style="p">
    <verse number="17" style="v" />rai timung, shi hkum a sakse kata ai n rai; mai kaja ai amu galaw let sumsing lamu na marang hte, nsi naisi shangai chye ai duhkra ladaw shi jaw da ai hte, nanhte hpe lusha hte mung kabu gara ai hte mung, jahkru shakat ya nga ai,” ngu nna jahtau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing nga tsun yang pyi, shawa masha ni shan hpe hkungga jaw na lam, n hkum dang na daram she rai wa ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpang, Antioki hte Ikoni mare hkan na Yuda masha ni sa du nna, shawa hpawng hpe woi awn nhtawm, Pawlu hpe nlung hte kabai nna, shi hpe si mat sai zawn nawn ai majaw, mare shinggan de karawt shapraw kau mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rai timung, sape ni grup rai tsap nga yang, shi rawt nna mare de shang wa ai; hpang shani e shi Barnaba hte rau Derbe mare de sa wa ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai mare hta e kabu gara shiga hkaw dan nna, sape law law shatai nhtawm, shan gaw, Lustra, Ikoni, Antioki mare lam bai wa nna
  </para>
  <para style="p">
    <verse number="22" style="v" />sape ni a myit shangang ya let, dai makam masham lam hta agrin nga na matu shadum jahprang ai hte, “Karai Kasang a mungdan de ru tsang ai law law hte shang wa na rai ga ai,” ngu nna sharin da mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hpung shagu hta, hpung up salang lata la nna, lusha gam let akyu hpyi ngut jang, shanhte kamsham nga ai Madu a lata hta, ap ya da mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hpang shan gaw, Pesidi mung ga sa wa nna, Pamhpuli mung de du ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai yang Perga mare hta mungga tsun dan nhtawm, Atali de yu wa ma ai;
  </para>
  <para style="p">
    <verse number="26" style="v" />dai kaw nna li jawn nhtawm, ya shan gun hpai lai wa sai amu a matu, Karai Kasang a chyeju hta ap nna, shangun dat hkam la ai Antioki mare de bai du wa ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shan du wa jang, Hpung masha ni hpe jahpawng tawn nna, Karai Kasang shan hta galaw ai lam yawng mayawng mung, maigan amyu ni hpe dai makam masham lam chyinghka hpaw ya wu ai mung, hkai dan mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai shan gaw, dai yang sape ni hte tsawmra wa na hkra, hkring nga ma ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yuda mung na ni nkau mi sa du nna, hpunau ni hpe, “Nanhte Mawshe a htung hte maren matu gadoi lam n hkan myit yang gaw, hkye hkrang la ai kaw n du lu na myit dai,” ngu nna sa sharin mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />De a majaw bra na lam pru nna, Pawlu yan Barnaba dai ni hte grai ndang kalang hkat ma yang, dai lam hpe jahkrup yu na matu, hpunau ni gaw, Pawlu yan Barnaba hte shanhte hta na nkau mi hpe, Yerusalem de nga ai kasa ni hte salang ni hpang de, shangun dat na san da ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />shing rai Hpung masha ni shanhte hpe sa sa jang, shanhte gaw Hpinisi mung hte Samari mung ga sa wa let, maigan masha ni a myit malai ai lam hkai dan nna, hpunau ni yawng mayawng hpe grai kabu shangun mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yerusalem mare de du jang, Hpung masha ni, kasa ni hte salang ni, shanhte hpe hkap hkalum la ma ai rai nna, Karai Kasang shanhte hta galaw dan ai lam magup shanhte hkai dan ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Hparishe hpung hta na, kamsham ai ni nkau mi rawt nna, “Shanhte hpe matu gadoi hking jaw na hte, Mawshe a tara hku hkan shangun na naw ra nga ai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya kasa ni hte salang ni, ndai lam bawng yu na matu, zuphpawng nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai lam hta law law wa san htailai nga ma yang, Petru rawt nna shanhte hpe, “Hpunau ni e, maigan amyu ni nye a n-gup hta nna, dai kabu gara shiga na la ai hte kamsham u ga nga, shawng nnan e Karai Kasang ngai hpe, nanhte kaw na lata la ai gaw, nanhte chye nga myit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kraw lawang hpe chye ya lu ai Karai Kasang gaw, anhte hpe jaw mi ai hte maren, shanhte hpe mung, Chyoi pra ai Wenyi jaw ya nna, shanhte a hpang maga sakse hkam ya manu ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />shing rai, kamsham ai hte shanhte a myit masin hpe kashin ya mu ai rai nna, anhte hte shanhte a lapran e, hpa hku mung ginhka mi ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai rai yang, ji wa ni e mung n dang, anhte mung n hpai dang ai lit hpe, sape ni a lahpa hta shagun ga nga, hpa rai Karai Kasang hpe chyam yu nga myit ta?
  </para>
  <para style="p">
    <verse number="11" style="v" />Anhte mung shanhte zawn, Madu Yesu a chyeju hte sha hkye hkrang la ai kaw du na, anhte kamsham nga ga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi shawa hpung ting atsin sha nga nna, Barnaba yan Pawlu, shan a lata hte maigan amyu ni hta, Karai Kasang kaning re ai lamik kumla hte mauhpa amu shabyin ya ai lam ni hkai dan ai ga, madat nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shan a ga htum jang Yaku mung, “Hpunau ni e, nye ga madat ya yu mi:
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang gaw maigan amyu ni hta na, shi a amying ningsang a matu, masha amyu mi hpe shaw la na nga, kaning rai shawng nna shanhte kaw kawan katsan sa yu sai lam, Simun tsun dan ma ni ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai lam gaw myihtoi ni a ga hte mung bung nga ai: dai gaw ning nga ka da nga ai,
  </para>
  <para style="p">
    <verse number="16" style="v" />‘Dai amu lam ni a hpang e ngai bai wa nna, Daw taw mat ai Dawi a nawku nta hpe bai gap na we ai; De a marawng marang ni ngai bai gaw nna, Dai hpe bai sharawt da na we ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi she, hti nga ai masha ni hte, Nye amying hta shamying la ai maigan amyu danghta, ngai Madu hpe tam lu na mara ai,’ nga nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ndai lam hpe chyi nma kaw nna shachye shachyang ai Madu tsun nga ai,” nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Dai re ai majaw, maigan masha ni hta na Karai Kasang hpang de kayin wa ai ni hpe, hpa mi n sharu ai sha,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hpara sumla ni a n san n seng ai hte, ndaw liknga lam, du manat sat ai shan hte, asai re ai ni hpe koi gam na lam, shanhte hpe laika hte shana mai ai, ngu nna ngai myit da we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kaning rai nme law, Mawshe a tara gaw laban nhtoi shagu, tara jawng ni hta a hti dan nga ma ai majaw, moi prat kaw nna mare shagu, hta dai tara hkaw dan ai ni nga nga ma ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi kasa ni hte salang ni gaw hpung masha nlang hte bawng nna, shanhte hta na masha lata la nhtawm, Pawlu yan Barnaba hte rau Antioki de shangun dat na lam myit hkrum ma ai: dai hte maren hpunau ni hta na, myit su ai salang Barsaba ngu ai Yuda yan Sila hpe lata la nna,
  </para>
  <para style="p">
    <verse number="23" style="v" />shan a lata hta ka ya dat mu ai ga gaw, “Anhte kasa ni, salang ni, hpunau ni gaw, Antioki mare hte Suri mung, Kiliki mung hkan e nga ai maigan amyu hpunau ni hpang de ngwipyaw ga shana dat ga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anhte kaw na pru wa wa re ai nkau mi, anhte muk n hkang dat yang, nanhte hpe ga hte shatsang nna myit gale galau di ya ai hpe, anhte na lu saga ai majaw,
  </para>
  <para style="p">
    <verse number="25" style="v" />anhte nlang bawng yu nna, masha lata la nhtawm, anhte a Madu Yesu Hkristu a mying ningsang majaw tinang asak pyi n lahpawt ai,
  </para>
  <para style="p">
    <verse number="26" style="v" />anhte a tsawra ai Barnaba yan Pawlu hte rau, nanhte hpang de shangun dat na, myit hkrum ga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai re ai majaw anhte gaw Yuda yan Sila hpe shangun dat gaw ai rai nna, shan a n-gup hte nan, laika hta rawng ai lam hte maren, tsun dan na mara ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nanhte a matu gaw, Hpara sumla ni hpe nawng ai rai hte, asai, du manat sat ai shan hte, ndaw liknga lam koi gam lu na hta kaga, grau ai lit shaje nanhte hta shagun shara n nga ai, nga nna, Chyoi pra ai Wenyi hte anhte myit hkrum ga ai;
  </para>
  <para style="p">
    <verse number="29" style="v" />dai hte hpe nanhte koi gam nga yang, mai kaja na rai malit dai. Hkam kaja nga myit ga law,” nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte hpe shangun dat mu yang, Antioki mare de du nna, hpung masha ni hpe jahpawng tawn nhtawm, dai shagun dat ai laika hpe ap ya mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hpe hti ngut jang, dai shalan shabran ga majaw, shanhte kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Yuda yan Sila gaw, myihtoi mung rai ma ai rai nna, mungga law law hte hpunau ni hpe shadum jahprang let shadaw shangang da mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai yang e tawng marang mi na hkra nga nga ai hpang, shanhte hpe shangun dat ai hpunau ni hpang de, ngwipyaw ai hte bai shabawn dat mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sila chyawm gaw shi myit shadang nna anga nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pawlu yan Barnaba chyawm gaw, Antioki mare e naw hkring nga ma ai rai nna, manang law law hte, Madu a mungga sharin achyin ya nna, hkaw dan mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai hpang, nhtoi ram ram na wa jang, Pawlu gaw Barnaba hpe, “Madu a mungga hkaw dan da sai mare shagu hkan na kahpu kanau ni kaning rai nga ma ai, bai sa kawan yu saga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Barnaba chyawm gaw Marku ngu ai Yawhan hpe shanan la mayu wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pawlu mahtang, shi gaw Pamhpuli mung nna shan hpe kau da ai hte, shan hte rau amu gun hpai ai de n hkan hkraw ai wa re ai, nga nna n shalawm mayu wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai nhkan e shan ga lai nna, langai hte langai hka mat ma ai; Barnaba gaw Marku hpe woi nna, Kupru zunlawng de li hte sa wa ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Pawlu chyawm gaw Sila hpe lata la nna, hpunau ni mung shi hpe Madu a chyeju hte ap dat ngut jang, pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shing rai Pawlu gaw, Suri mung, Kiliki mung hku ga sa wa nna, Hpung masha ni hpe shadaw shangang mu ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Derbe hte Lustra mare de mung shi du nna, yu u, dai yang e Timohti mying ai sape langai mi nga nga ai; kanu gaw kamsham ai Yuda num, kawa chyawm gaw, Heleni masha rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai sape gaw, Lustra hte Ikoni mare nga ai kahpu kanau ni hta, sari sadang lu ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pawlu gaw dai wa hpe shanan la mayu ai rai nna, shi a kawa Heleni masha rai nga ai gaw, dai yang na Yuda masha ni nlang chye ma ai majaw, shanhte hpe tau nna, shi hpe matu gadoi hking jaw wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai, dai mare ni ga sa wa let, Yerusalem na kasa ni hte salang ni hkang dat ai ga matsun hpe, hkan nang mu ga nga, shanhte hpe ap jaw ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hpung masha ni mung dai makam masham lam hta ngang wa nna, lani hte lani law htam wa ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya, Asi mung e mungga lam tsun dan na, Chyoi pra ai Wenyi shanhte hpe hkum shadang mu ai majaw, shanhte Hprugi hte Galati mung de ga sa wa nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />Musi mung du magang yang, Bihtuni mung de shang sa wa na maw ma ai; rai timung, Yesu a Wenyi shanhte hpe ahkang n jaw mu ai majaw,
  </para>
  <para style="p">
    <verse number="8" style="v" />Musi mung makau garet sa wa nna, Troa mare de du ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai yang, shana e Pawlu gaw shingran hta, Makedoni masha langai mi sa tsap nna, “Makedoni mung de rap sa nna, anhte hpe karum la mi,” nga nna shi hpe hpyi ai mu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shingran dai mu nna, Makedoni masha ni hpe kabu gara shiga hkaw dan na matu, Karai Kasang anhte hpe shaga ai rai sai, ngu nna myit la nhtawm, Makedoni mung de rap na matu anhte shaloi jang tam shajin ga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai re ai majaw, anhte Troa mare nna, Samohtrake zunlawng de ang ang li hta jawn sa wa nna, hpang shani e Neapoli mare de du ga ai;
  </para>
  <para style="p">
    <verse number="12" style="v" />dai kaw na bai lai yang, Makedoni mung e, Roma masha de ai, dai ginwang na mare daju, Hpilipi de, anhte du nna, dai yang tawng marang mi nga nga ga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Laban nhtoi du jang, akyu hpyi ai shara nga na zawn nawn nna, mare chyinghka shinggan, hka kau de anhte pru sa nhtawm, dung nga let, dai de hpawng sa wa ai num ni hpe tsun dan ga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi, Karai Kasang hpe nawku ai, Htuatira mare na, sumpan hkyeng dut ai num, Ludi ngu ai jan anhte a ga na la nna, Pawlu tsun dan ai lam hpe madat mara u ga nga, Madu gaw shi a myit hpaw ya wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Num dai hte shi a nta masha ni baptisma hkam la ngut jang, shi gaw, “Dai Madu hta ngai kangka rai ni ai, nanhte myit hkut da sai rai yang gaw, nye nta e shang manam marit,” nga nna anhte hpe akroi anoi hpyi ai hte nga shangun mi ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang anhte dai akyu hpyi ai shara de sa wa nga yang, gumhpan hpan nna, madu ni hpe sut grai jasu ai nat shung ai mayam numsha langai mi anhte hte hkrum hkrum re ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Numsha dai mi Pawlu hte anhte kaw hkan nang nang rai nhtawm, “Ndai ni gaw law, nanhte hpe hkye hkrang la ai lam tsun dan ai, Tsaw Htum ai Karai Kasang a shangun ma ni rai nga ma ai law,” nga nna jahtau htau re ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Law law ya wa shi shing re ai majaw, Pawlu grai myit n pyaw nna, kayin nhtawm, dai nat hpe, “Yesu Hkristu a mying ningsang hte ngai nang hpe tsun de ai, shi kaw na pru mat u,” ngu nna daru wu yang, dai ahkying hta nan shi pru mat wa ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya shi a madu ni gaw, ma-un shabrai lu sha na lam myit mada shara n nga sai, chye jang, shanhte Pawlu yan Sila hpe rim la nna, gat de nga ai agyi salang ni hpang de karawt wa mu ai;
  </para>
  <para style="p">
    <verse number="20" style="v" />shing rai, mare up ai ni a man de shan hpe woi jashawn n htawm, “Ndai Yuda masha yan, anhte a mare hpe nachying sharu shatsang ai hte,
  </para>
  <para style="p">
    <verse number="21" style="v" />anhte Roma masha ni n mai hta, n mai hkan ai htung hking hpe sa sharin nga ma ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai rai nna shawa masha ni shan a maga mi de lang lata rawt ma ai; mare up ai ni mung, shan a hpun palawng hpe gang je kau ya nna, ri tawng hte kayat na lam, dawdan mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai, shan hpe law law lang kayat nhtawm, htawng hta rawng da mu ai rai nna, shan hpe ashim sha sin da na lam, htawng agyi wa hpe hkang dat mu ai;
  </para>
  <para style="p">
    <verse number="24" style="v" />htawng agyi wa mung, shing nga hkang dat ai ga majaw, shan hpe htawng na kata gawk hta jashawn nna, share hte sharen tawn mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rai timung, yuptung hpawa e Pawlu yan Sila gaw akyu hpyi ai hte, Karai Kasang hpe mahkawn mangoi nga ma ai rai nna, bawng dung ai ni shan a ga madat nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi nnang nawn kaba akajawng sha nawn wa nna, htawng nta npawt ni awam wa ai hte, chyinghka mahkra ahkring sha hta hpaw malang mat shajang nna, yawng hte a hkang hkyihkyang ni malaw mat wa ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Htawng agyi wa mung, yup hprang nna, htawng chyinghka ni hpaw maden nga ai mu jang, bawng ni hprawng mat masai nga, myit la nna, shi a nhtu shaw nhtawm, shi dai dai galun si na hkyen nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pawlu chyawm gaw, “Nang dai, na hkum hpe hkum shaza et, anhte nlang ahkum sha rai nga ga ai law,” ngu nna aja awa jahtau tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi shi pyengdin hpyi lang nna, kata de gat bang wa nhtawm, hkrit gari let Pawlu yan Sila man e dingnyawm nga ai;
  </para>
  <para style="p">
    <verse number="30" style="v" />bai shan hpe woi pru nna, “Madu yan e, ngai hkye hkrang la ai kaw du lu hkra, kaning rai na rai ta?” ngu nna san mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi shan gaw, Madu Yesu hpe kamsham u; shaloi nang hte na nta masha ni nlang, hkye hkrang la ai kaw du na marin dai,” nga nna tsun ai lata,
  </para>
  <para style="p">
    <verse number="32" style="v" />dai htawng agyi wa hte shi a nta masha nlang hte hpe Madu a mungga hkaw tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai shana ahkying hta nan, shi shan hpe woi wa nhtawm, shan a nma kashin kau ya nna, shi hkum hte nta ting hpawn, shaloi jang baptisma hkam la ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bai, shi a nta nhku de mung shi shan hpe woi jashawn la nna, lusha galaw daw let, Karai Kasang hpe kamsham lu sai majaw, shi hte nta ting hte hpawn, ja ja kabu gara nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ya nhtoi htoi jang, mare agyi ni gaw, Dai yan hpe dat dat u, ngu nna mang galang ni hpe sa tsun shangun mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shaloi htawng agyi wa, dai ga Pawlu hpe tsun dan let, “Nan hpe dat dat na, mare agyi ni masha shangun mara ai majaw, ya angwi apyaw pru wa masit,” ngu nna tsun nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pawlu chyawm gaw, “An Roma masha she rai nga ga ai hpe, garai n san dawdan yang, masha man e an hpe kayat nna, htawng hta jahkrat da myit htawm me, ya atsin sha lagyim dat dat na maw ma hka i? N rai law, shanhte hkum lala she sa shapraw la mi ga,” ngu nna shanhte hpe htan dat mu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mang galang ni mare agyi ni hpe ga dai wa tsun dan wu yang, shan gaw Roma masha re ai na jang, hkrit nna,
  </para>
  <para style="p">
    <verse number="39" style="v" />shanhte hkum nan shan kaw sa nhtawm, sa nem shapraw la nna, dai mare na pru wa na lam hpyi nem ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shaloi shan gaw dai htawng na pru wa nna, Ludi a nta de shang wa ma ai; shing rai hpunau ni hpe mu jang, shanhte hpe shalan shabran tawn da nhtawm, pru mat wa ma ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang shanhte gaw Amhpipoli hte Apoloni mare ga sa wa ma yang, Htesaloni mare de du ma ai; dai yang e Yuda masha ni a tara jawng rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pawlu gaw shi a htung hte maren, shanhte kaw shang nna, Laban nhtoi masum ting, Chyum laika hku hkan nna shanhte hte tsun chyai let,
  </para>
  <para style="p">
    <verse number="3" style="v" />Hkristu gaw nni nkri hkrum lu na hte, si ai kaw na bai hkrung rawt wa na gaw, shi a lam rai nga ai, nga nna mung, Ngai nanhte hpe tsun dan ai Yesu gaw, dai Hkristu nan rai nga ai, nga nna mung, shanhte hpe jahprang mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte hta na nkau mi gaw kamsham nna, Pawlu yan Sila hte kanawn nga ma ai; dai ni hta, tara hkungga ai Heleni masha law law wa hte, arawng lu ai num ni ram ram mung, lawm ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yuda masha ni chyawm gaw myit manawn nna, pagawn para re ai masha ni hta na n hkru ai masha nkau mi hpe saw la nhtawm, masha jahpawng tawn nna, mare ting hpe kabrawng shangun mu ai; shing rai, Yasun a nta hpe adip nna, shawa masha ni hpang de shan hpe shapraw ya na hku, tam ma ai,
  </para>
  <para style="p">
    <verse number="6" style="v" />Shan hpe n mu jang, Yasun hte hpunau ni nkau mi hpe, shanhte mare du gyi ni hpang de karawt sa nna, “Mungkan ting hpe galau kau hkawm ai ndai ni, nang de mung du mara ai hpe, Yasun shan hpe hkap la mu ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />shanhte mahkra, Yesu ngu ai hkawhkam kaga langai mi naw nga ai, nga nna tsun ma ai majaw, Kehta tara hte nhtan shai ai, rai nga ma ai,” nga nna jahtau tsun ma ai,
  </para>
  <para style="p">
    <verse number="8" style="v" />Mare masha ni hte mare agyi ni dai ga na ma yang, myit ru myit ra nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, Yasun hte kaga ni kaw na pahkam hkam la nhtawm, shanhte hpe dat da mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hpunau ni chyawm gaw dai shana jang, Pawlu yan Sila hpe Beria mare de shangun dat mu ai; dai de du yang, shan gaw Yuda ni a tara jawng hta shang bang wa ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai mare masha ni gaw Htesaloni masha ni hta myit grau su ma ai rai nna, dai mungga hta myit shawn loi ai hte, dai lam ni teng ai n teng ai chye lu hkra, Chyum laika hpe shani shagu a yu nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna, shanhte hta na law law wa kamsham shajang ma ai; arawng lu ai Heleni numsha, lasha ram ram mung, lawm ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pawlu gaw Beria mare hta mung, Karai Kasang a mungga hkaw dan nga ai lam, Htesaloni mare na Yuda masha ni chye yang, dai de mung shanhte sa nna, mare masha ni hpe myit sharawt nna, kabrawng shangun mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi hpunau ni gaw Pawlu hpe nammukdara makau sa du hkra, shaloi jang, sa kau dat mu ai; Sila yan Timohti chyawm gaw naw hti nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai timung, Pawlu hpe hkan sa ai ni gaw, Ahten mare du hkra shi hpe hkan sa kau da nna, Sila yan Timohti hpe alawan hkan nang na lam, htet dat ai ga gun let, bai wa ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya Pawlu, Ahten mare hta dai yan hpe la let hkring nga yang, dai mare ting Hpara sumla hkrai chyat rai nga ai mu nna, shi a wenyi kahtet bu nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai re ai majaw shi gaw, tara jawng hkan e Yuda masha ni hte tara hkungga ai ni hte mung, shani shagu gat hkan e hkrum mahkrum ni hte mung, tsun dan hkat nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna, Epikuri lam hte Sto-i lam hkan ai hpaji sara ni nkau mi, shi hte dangrang hkat ma ai rai nna, nkau mi gaw, “Ndai baw law ai wa hpa tsun mayu nga ai kun?” nga nna mung, nkau mi gaw, “Hpara kaga ni a lam tsun dan ai wa rai sam ai,” nga nna mung, tsun shajang ma ai: dai gaw, shi Yesu a lam hte bai hkrung rawt wa ai lam tsun dan ai majaw rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing nga tsun nhtawm, Pawlu hpe Aripagu ngu ai kawng de woi lung wa nna, “Dai nang tsun ai sharin shaga lam ningnan, anhte mung chye yu mawe ga?
  </para>
  <para style="p">
    <verse number="20" style="v" />Mau na zawn nga ai lam nkau mi, nang anhte hpe tsun dan ndai rai nna, dai lam hpa nga mayu ai gaw, anhte chye mayu ga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />(Ya Ahten masha nlang hte hte dai yang na shingbyi manam ni gaw, amu ningnan lama ma a lam, hkai chyai ai hte madat mara let, nhtoi shalai nna nga nga ma ai.)
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Pawlu dai Aripagu ka-ang e tsap nna tsun mu ai gaw, “Ahten masha ni e, lam shagu hta Hpara ni hpe nanhte ja ja hkrit hkungga myit dai gaw, ngai mu nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kaning rai nme law, ngai lai hkawm wa nna, nanhte jaw jau ai rai ni hpe mada yu yang, N chye gaw ai Karai Wa matu, nga nna ka tawn ai hkungri langai mi mung, ngai mu hkrup we ai: dai nanhte n chye let nawku ai wa a lam, ngai nanhte hpe hkai dan made ga,
  </para>
  <para style="p">
    <verse number="24" style="v" />Mungkan ga hte dai hta nga ai yawng mayawng hpe, hpan tawn da ai Karai Kasang gaw, sumsing lamu hte ginding aga a Madu rai nga ai rai nna, masha lata hte shachyaw ai nawku nta hta rawng nga ai n rai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shi nan, yawng mayawng hpe hkrung ai asak, nsoi nsa hte arai hkum sumhpa jaw ya ai wa rai nga ai majaw, lama ma ra ai wa zawn masha lata hte daw jau ra ai n rai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi gaw, shinggyim masha ni Karai Kasang hpe hkan tam masawp lamawm yu nna, mu yang me mu mu ga nga, dinghta ga e nga pra na matu, masha amyu danghta hpe daju langai hte sha hpan tawn da nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />du hkra ladaw hte buga jarit madat da ya mu ai; shing nga tim shi anhte kadai hte mung tsan nga ai n rai:
  </para>
  <para style="p">
    <verse number="28" style="v" />kaning rai nme law, shi a jaw e anhte hkrung nga nna, shamu shamawt nga ai hte nga pra ga ai. Dai hte maren, nanhte hta na ningtam laka ni pyi, ‘Anhte mung Shi a amyu matu ni rai nga ga ai,' nga nna ka ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shing rai, anhte Karai Kasang a amyu matu ni rai nga ga ai majaw, Karai Kasang ngu ai hpe, masha a hpaji lata hte tawk ka ai aja, gumhpraw, nlung sumla hte bung ai, ngu nna n mai myit la ga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />N na n chye nna lai mat sai prat hpe, Karai Kasang shatawt lai kau wu timung, ya gaw, shara magup hkan na masha nga yawng hpe, myit malai lu mu, nga nna hkang dat ra ai:
  </para>
  <para style="p">
    <verse number="31" style="v" />kaning rai nme law, shi e san da sai wa a lata hte mungkan ga hpe dingman ai hku dawdan na nhtoi gaw, shi tawn da nu ai: dai wa hpe si ai ni kaw na shi hkrung sharawt la ai hte, dai san da ai lam hta, masha yawng a man e kam ram ai sakse tawn da nu ai,” ngu nna tsun nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Si sai ni bai hkrung rawt ai nga ai lam na jang, nkau mi gaw jahpoi asawng ma ai: nkau mi chyawm gaw, “Ndai lam, na a ga anhte lang mi naw madat yu na ga ai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shing rai Pawlu mung shanhte kaw na pru mat wa ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rai timung, masha nkau mi shi hte kanawn nna kamsham mat ma ai: dai ni hta na Aripagu kawng agyi Dionusi hte Damari mying ai num langai mi mung. dai hta kaga masha ni mung, lawm ma ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai lam byin ai hpang Pawlu gaw, Ahten mare na pru nna, Korinhtu mare de du ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yang, Pontu mung masha, Akula mying ai, Yuda la langai mi hte hkrum wu ai; dai wa gaw, ‘Yuda masha nlang, Roma mare na pru wa lu na,’ nga nna, Hkawhkam Klawdi ga dat ai majaw, madu jan Priskila hte rau Itali mung na htawt wa ai, gade garai n na ai; ya shi gaw, dai yan kaw manam nga ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />shanhte janghpang chywi sha ai hkrai rai nna, galaw sha bungli baw sha rai malu ai majaw, shi mung shan hte rau amu jawm galaw nna, nga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Laban nhtoi shagu, tara jawng hta Yuda masha hpe mung, Heleni masha hpe mung, tsun hkat let awn da mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya Sila yan Timohti Makedoni mung nna hkan dep jang, Pawlu gaw mungga hkaw lam hkrai san rai nna, Yesu gaw Hkristu nan rai nga ai, nga nna Yuda masha ni hpe sakse hkam da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte chyawm gaw hkap ndang ai hte aroi ara nga ma yang, shi palawng ahpu dan let, “Nanhte a asai gaw nanhte a baw e mara nga nu ga; ngai chyawm gaw lawt ni ai: ya kaw nna gaw, maigan amyu ni hpang de ngai kayin mat wa na ni ai,” ngu nna shanhte hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai yang na shi pru nhtawm, Karai Kasang hpe nawku ai Titu Yustu mying ai wa a nta de, shang bang wa ai; dai wa a nta gaw tara jawng hte htep rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Krispu mying ai tara jawng agyi wa mung, shi a nta masha nlang hte hte hpawn, Madu hpe kamsham ma ai: Korinhtu masha ni law law mung, na la nna kamsham ai hte baptisma hkam la ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai shaloi Madu gaw shana e shingran hta Pawlu hpe “hkum hkrit et; she tsun u, atsin sha hkum nga et;
  </para>
  <para style="p">
    <verse number="10" style="v" />ngai nang hte rau rai nga nngai, nang hpe shoihpa jahkrum na kadai lata shadu lu na n rai; ndai mare hta nye a masha law law nga nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai dai yang e Karai Kasang a mungga sharin achyin ya let, laning me shata kru anga nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung, Galio gaw Ahkaia mung e munggyi rai nga yang, Yuda masha ni lang lata sha Pawlu hpe gumlau rawt nna, shi hpe tara tingnyang de dun wa nhtawm,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Ndai wa jep ai tara hte nhtan shai ai hku, Karai Kasang hpe nawku na nga, masha ni hpe woi gunglau nga ai,” ngu nna mara shagun mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Pawlu htan na nga, n-gup ap sha naw rai yang, Galio mahtang, “Yuda masha ni e, amu ndai, tara tawt lai ai amu, n hkru n hkra re ai amu rai yang gaw, ngai nanhte a matu sharang ya lu na nngai:
  </para>
  <para style="p">
    <verse number="15" style="v" />rai timung, aga sumtu lam, amying shingjawng lam hte, nanhte a tara lam sha tsun hkat ai rai yang gaw, nanhte dai nanhte yu la mu: dai zawn re ai amu a matu ngai tara agyi n tai mayu nngai,” ngu nna Yuda masha ni hpe daru kau wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing nga shi shanhte hpe tara tingnyang na shaden kau mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi shanhte nlang tara jawng agyi wa Sosteni hpe rim la nna, tara tingnyang man e anu kau mu ai: Galio chyawm gaw, dai lam hpe hpa mung n nawn wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang Pawlu gaw, dai yang nhtoi tsawmra wa na hkra naw nga nga nhtawm, hpunau ni hpe shakram da nna, li jawn let Suri mung de sa wa ai; Priskila yan Akula shan la mung, shi hte rau rai nga ma ai; shawng e ga shaka da ai ga nga lu ai majaw, Kenhkrea mare e baw doi wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi shanhte Ehpesu mare de du nna, shi shan hpe dai yang e jahka tawn da mu ai: shi chyawm gaw tara jawng de shang nna, Yuda ni hte tsun hkat nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai yang na ni shi hpe, shanhte kaw tawng marang mi naw nga nga na hpyi ma timung, shi mahtang n hkraw let, “Ya du magang ra ai poi hta Yerusalem e ngai lawm ra nngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Karai Kasang hkraw yang gaw, ngai nanhte hpang de bai du na ring ngai,” ngu nna shanhte hpe shakram da nhtawm, Ehpesu kaw na li hte pru mat wa ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya Kesare mare du jang, shi lung wa nna, dai Hpung hpe wa jahkrum nhtawm, Antioki de bai yu wa ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai kaw tawng mi nga nhtawm, shi bai pru nna, Galati mung hte Hprugi mung ga sa wa let, sape ni nlang hpe shadaw shangang nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hte yang, Apolo ngu ai, Alesandru mare na, zai byeng-ya rawng ai Yuda masha langai mi, Ehpesu mare de du ai: dai wa gaw, Chyum laika grai chye chyang ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai wa gaw, Madu a lam sharin la hkrup nna, nachying sharawng let, Yesu a lam atsawm sha sharin achyin ya nga ai; rai timung, shi gaw Yawhan a baptisma lam sha naw chye nga ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />ya shi gaw tara jawng hta nden ja ai myit hte nnan hkaw hpang wa nga ai. Shaloi Priskila yan Akula gaw, shi hkaw tsun ai ga na jang, shi hpe shaga la nna, Karai Kasang a mungga lam azin ayang naw sharin shachyang ya mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai shi gaw, Ahkaia mung de rap sa mayu yang, hpunau ni mung, shi hpe galaw shadut nna, sape ni shi hpe hkap hkalum la na matu, shanhte hpang de laika jaw dat ya mu ai: shi du jang, chyeju majaw kamsham ai ni hpe, grai wa shadaw shangang mu ai:
  </para>
  <para style="p">
    <verse number="28" style="v" />kaning rai nme law, Yesu gaw Hkristu nan rai nga ai, nga nna Chyum laika hku madun let, Yuda ni hpe dan dan leng leng, aja awa tsun kapat kau nga ai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Apolo Korinhtu mare e nga nga yang, Pawlu gaw lahta mung hku ga sa wa nna, Ehpesu mare de du ai: dai yang shi sape nkau mi hpe hkrum ai rai nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />shanhte hpe, “Taw nanhte kamsham sai rai yang, Chyoi pra ai Wenyi lu la manit ni?” ngu nna san mu ai: shanhte gaw “Chyoi pra ai Wenyi nga ai pyi, anhte n na yu ga ai,” nga nna htan mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Pawlu gaw, “Dai rai yang, hpa ngu ai baptisma nanhte hkam la myit ta?” ngu nna san mu yang, shanhte gaw, “Yawhan a baptisma hkam ga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />shaloi Pawlu, “Yawhan gaw myit malai baptisma she jaw ai rai nna, shi a hpang e sa ai, Yesu ngu ai wa hpe mahtang, kamsham ra ai,” ngu nna mung masha ni hpe tsun mu ai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte dai ga na jang, Madu Yesu a amying hta baptisma hkam la ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya Pawlu shanhte a ntsa e lata mara jang, Chyoi pra ai Wenyi shanhte a ntsa e du nna, shanhte ga amyu kaga tsun nna myihtoi htoi ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte nlang, lasha marai shi lahkawng rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hpang Pawlu gaw tara jawng de shang nna, shata masum tup nden ja ai hte Karai Kasang a mungdan lam tsun hkai hkat nga nna, woi awn da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, nkau mi gaw myit ja ma ai rai nna, n madat hkraw ai hta n-ga, shawa masha ni a man e ndai Lam hpe aroi asawng ya jang, shanhte kaw na shi pru nna, sape ni hpe kaga jahka la nhtawm, Turanu ngu ai wa a hpaji jawng hta, shani shanang sharin shaga hkat nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai ni ning laman hte hta sharin nga ai rai nna, Asi mung ting na ni nlang, Yuda masha da, Heleni masha da, Madu a mungga na la lu ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang mung, Pawlu a lata hte chyalai magam ningsam madun wu ai rai nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pawlu lang ai hpajet re ai, shingkyit re ai, lama ma machyi ai ni hpang de la wa jang, dai ni mai mat wa ai hte, shung ai nat ni mung pru mat wa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai shaloi e nat hkyawt let, len hkawm ai Yuda masha nkau mi mung, nat ni hpe, “Pawlu hkaw tsun ai Yesu a amying hte ngai nanhte hpe shapraw made ai,” nga nna nat shung ai ni a ntsa e Madu Yesu a amying nsang la gang ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Skewa ngu ai, Yuda hkinjawng agyi langai mi a shadang sha sanit hte mung shing rai galaw ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi dai n hkru ai nat shanhte hpe, “Yesu hpe ngai chye nngai. Pawlu hpe mung ngai chye da we ai; nanhte mahtang kadai ni rai myit ta?” nga nna htan nhtawm,
  </para>
  <para style="p">
    <verse number="16" style="v" />dai nat shung ai wa mung shan a ntsa de gumjawt lung nna, adep anut ai hte, dang kau manu ai; dai rai nna shanhte gaw ahpye alam rai, dai nta na singgu krin hprawng htaw wa ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai lam hpe Ehpesu mare na Yuda masha, Heleni masha nlang chye ma yang, shanhte yawng hkrit mat shajang nna, Madu Yesu a amying gaw shagrau sha-a ai lu la nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kamsham sai ni hta na law law mung sa nna, tinang galaw shut ai lam ni tawngban tsun dan ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lakle mandan bau sha ga ai ni law law mung, shanhte a laika ni la sa nna, masha yawng a man e nat kau mu ai: dai ni a manu sawn yu yang, gumhpraw lap mun manga ging malu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai, dai Madu a mungga gaw n-gun atsam hta galu kaba maden jat wa nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ndai lam ni byin ai hpang e, Pawlu gaw, Makedoni mung hte Ahkaia mung ga sa wa ngut yang, Yerusalem de bai wa nhtawm, “Dai hpang e Roma mare de mung ngai du yu na nngai,” nga nna myit da nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai rai nna shi a ningrum ningtau tai ai Timohti yan Erastu hpe, Makedoni mung de shawng shangun dat nhtawm, shi hkum gaw Asi mung e tawng marang mi naw hkring nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya dai tawng hte yang dai lam majaw Kabring kabrawng grai wa byin wa ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hpa rai nga yang, Demetri ngu ai janghkam wa langai mi, Artemi Hpara num a gumhpraw nta hkrang kaji shachyaw nna, amu galaw manang ni hpe sut woi jasu da mu ai;
  </para>
  <para style="p">
    <verse number="25" style="v" />dai wa gaw shi a janghkam manang ni hte, dai baw amu galaw sha ai kaga ni yawng hpe shaga jahpawng la nna, “Manang ni e, ndai baw amu hte sha anhte ngamai nga ga ai gaw, nanhte nan chye nga myit dai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai timung ya gaw, Ehpesu mare hta sha nrai sa, Asi mung ting ganoi rai hkra, ndai Pawlu ngu ai wa e, masha lata hte shachyaw ai baw Karai Kasang n re ai, nga nna masha law law hpe gunglau ai hte myit shayit kau ya manu ai, nanhte nan mu nga chye nga myit dai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai rai nna, anhte a bungli hpoi mat na hpe tsang ra ai hta n-ga, galu kaba ai Hpara shayi Artemi a nawku htingnu gaw hpa n tai mat nna, Asi mung ting hte mungkan ting nawku ai Hpara shayi sha a hpung shingkang hpoi mat na mung, myit tsang shara rai nga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai ga na jang, shanhte masin pawt bu shajang nna, “Ehpesu masha ni a Artemi she galu kaba ai law,” nga nna marawn ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shing rai dai mare ting hpe woi kabrawng ai hte, Pawlu a manang, Makedoni masha Geu yan Aristarku hpe rim dun la nna, shanhte a poi wang de lang lata sha htim bang wa ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pawlu mung dai masha hpawng de shang mayu nga ai, rai tim sape ni shi hpe hkum shadang mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi a jinghku Asi poi up nkau mi mung, shi hpe poi wang de n shang u ga nga, masha shangun nna tsun dat mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai shawa hpawng chyawm gaw kashuk kashak rai nga ai rai nna, nkau mi baw kaga ga nga marawn bu ma ai; shanhte law malaw gaw tinang hpa majaw sa hpawng ai pyi, n chye ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ya Yuda masha ni Alesandru hpe shadut mu ai rai nna, masha ni mung shi hpe dai shawa hpawng nna shalun dat mu ai. Alesandru mung shawa hpawng hpe ga tsun hparan kau we ga nga, lata dingsi nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rai timung shi Yuda masha re ai chye jang, yawng hte ting, “Ehpesu masha ni a Artemi she galu kaba ai law,” nga nna lang lata hkying lahkawng daram na hkra marawn bu ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ya, mare chyare wa dai shawa hpawng hpe jasim kau ngut jang, shi shanhte hpe, “Ehpesu masha ni e, Ehpesu masha ni a mare ndai, galu kaba ai Artemi a nawku htingnu hte Zeu hpara kaw na hkrat ai sumla, bau sin ai mare rai nga ai hpe, n chye ai, kadai wa nga nga a ta?
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai lam ndang shara n nga ai majaw, nanhte atsin sha nga mai ai hte, sadi n dung ai amu gaw n galaw mai myit dai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte gaw nawku htingnu hpya ya ai ni mung n rai, anhte a Hpara shayi hpe jahpoi ya ai ni mung n re ai mi, nanhte ndai ni hpe dun wa myit hka.
  </para>
  <para style="p">
    <verse number="38" style="v" />Demetri hte shi a janghkam manang ni, marai langai ngai hte mungga lama ma rawng yang gaw, tara rung ni hpaw nga ai, mung du ni mung nga ma ai; shanhte shada da tara dara sa hkat na ma dawng.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lam gale lama ma tsun mayu yang chyawm gaw, mung bawng zuphpawng hta hparan na rai nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Dai ni kabrawng ai amu ndai hta, matu nhpang n nga ai majaw, anhte hta mara shagun na, tsang shara rai nga ai: ning re ai hpawng a lam hpe, hpa majaw hpawng ai ngu nna mung, anhte tsun dan shara n lu ga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shing ngu nna dai shawa hpawng hpe shabra kau wu ai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai kabring kabrawng lam sim mat ai hpang, Pawlu gaw sape ni hpe shaga la nna, shanhte hpe shadum jahprang ngut jang, shakram da nhtawm, Makedoni mung de sa wa na pru wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Makedoni ginwang hkan e ga sa wa nna, law law wa shadum jahprang da ngut jang, Heleni mung de wa du ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai yang shata masum nga nhtawm, Suri mung de li hte bai wa na hkyen yang, Yuda masha ni shi hpe gyam ma ai majaw, Makedoni mung hku nhtang wa na, myit da wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi shi kaw hkan nang ai ni gaw, Beri mare na Puru a kasha Sopata; Htesaloni mare na Aristarku yan Sekundu; Derbe mare na Geu hte Timohti; Asi mung na Tuhkiku yan Trohpimu hte rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte chyawm gaw shawng sa wa nna, Troa mare hta e anhte hpe sa la nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte mung Azuma poi lai ai hpang, Hpilipi mare na li jawn nna, manga ya e Troa mare de shanhte kaw du jang, dai yang e nhtoi sanit ya hkring nga ga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya nhtoi bat a langai ya ngu na shani e, muk ahkyep na matu anhte zuphpawng nga yang, Pawlu gaw hpang jahpawt pru na maw ai majaw, sape ni hpe sharin shaga let, yuptung tung hkra ga tsun galu nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai anhte hpawng nga ai ntsa gawk hta e, pyengdin law law tu nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkuwawt hku mahka e, Utuhku ngu ai shabrang langai mi yup nga dung nga ai; Pawlu ga naw tsun galu nga yang, dai wa yup malap mat wa ai hte, nta htap masum kaw na di hkrat nna, si mat sai hpe pawn sharawt da mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Pawlu yu wa nhtawm, dai wa ntsa e shi hkum mara ahpum let, “Hkum kashai myit, nsa naw rawng nga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai shi lung wa nna, muk ahkyep ai hte sha nhtawm, nhtoi htoi ai du hkra shanhte hte tsun chyai ngut jang, shi pru wa ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai ma hpe mung, ahkrung nga ai hte shanhte woi wa nna, grai kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anhte mahtang li de shawng sa wa magang nna, Asu mare e she Pawlu hpe hkap shajawn la na myit nna jawn sa wa ga ai: kaning rai nme law, Pawlu shi gaw hkarang hku sa wa na myit nna, dai hku hkang dat mi ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai Asu mare e anhte hte hkrum jang, shi hpe shajawn la nhtawm, Mitulene mare de jawn sa wa ga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai kaw nna bai rawt ai gaw, hpang shani e anhte Kiu zunlawng makau hku lai wa nhtawm, dai hpang shani e Samu zunlawng de wa hkring nna, lani mi bai rai jang, Melitu mare de du ga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaning rai nme law Pawlu gaw, Pentekoti shani e Yerusalem mare de dep lu yang dep hkra nga tin da wu ai rai nna, Asi mung e nhtoi hkatum n shama mayu ai majaw, Ehpesu mare hpe lai kau da na, myit shatawng da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Pawlu gaw Melitu mare na Ehpesu mare de masha shangun nna, Hpung na salang ni hpe shaga mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai ni du jang, shi shanhte hpe tsun mu ai gaw, “Asi mung hta ngai nnan shang ai shani kaw nna, ngai nanhte hte tutnawng e kaning rai nga nga nngai mung;
  </para>
  <para style="p">
    <verse number="19" style="v" />shi Madu a magam gun hpai ai hta nachying myit shanem nna, nep myi prwi hte, Yuda masha ni jahte tam ai a majaw ngai hta byin ai sharu shatsang hkam sha ai lam hpe mung;
  </para>
  <para style="p">
    <verse number="20" style="v" />nanhte a matu akyu rawng ai lam magup hpe n ginhtim da ai sha, shawa yawng a man e da, nta shagu hkan e da,
  </para>
  <para style="p">
    <verse number="21" style="v" />Yuda masha hte Heleni masha hpe, Karai Kasang a man na myit malai lam hte, anhte a Madu Yesu a makam masham lam sakse hkam let, ngai shaja nga nngai gaw, nanhte nan chye nga myit dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya, yu mu, nye wenyi hta ngai gyit hkang ai hkrum nna, ngai hpa hkrum hpa hkra na n chye ai wa mi, Yerusalem de sa wa lu na rai nga ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />rai timung, gyit hkang ai hte zingri zingrat na gaw ngai hpe la nga ai, nga nna, mare shagu hta Chyoi pra ai Wenyi ngai e sakse hkam nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai chyawm gaw, nye a gat shadu ra ai lam hpe mung, Karai Kasang a chyeju kabu gara shiga lam sakse hkam na matu, Madu Yesu kaw na ngai lu la ai magam hpe mung, ngut hkra gun hpai lu na rai yang, nye asak hpe pyi lahpawt nngai n rai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya bai yu mu, ndai mungdan lam ngai hkaw hkawm yang na hkrum kanawn yu ai ni, nanhte nlang, nye a myi man htawm hpang de bai n mu lu na manit dai, ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai majaw masha yawng a asai hte ngai lawt ni ai gaw, ngai dai ni nanhte hpe sakse hkam da made ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nme law, Karai Kasang a ra ai hku hte tup, nanhte hpe hkaw dan na, ngai ginhtim yu nngai n rai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Karai Kasang gaw shi a sai hte mari la ai Hpung hpe yu lahku na matu, Chyoi pra ai Wenyi nanhte hpe Hpung up ni shatai manit dai majaw, nanhte gaw, tinang hkum dai hte, sagu hpung ting hpe, sadi sahka hte yu nga mu law.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai pru ai hpang, Hpung hpe matsan n dum ai, n hkru ai chyahkyawn, nanhte hta shang na ra ai, ngai chye nga nngai:
  </para>
  <para style="p">
    <verse number="30" style="v" />dai hta kaga, nanhte hta na mung, sape ni hpe lau la lu hkra, shut ai hku tsun ai masha paw pru na ra ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai re ai majaw, ngai nanhte mahkra hpe masum ning tup shani shana n sim n sa myi prwi hte shadum jahprang da ai hpe, dum nna a maja nga mu.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ya gaw ngai nanhte hpe Karai Kasang kaw mung, shadaw shangang ya lu ai hte, shachyoi shapra lu la ai ni nlang hte rau, nanhte hpe Sali wunli jaw ya lu ai, shi a chyeju mungga hta mung, ap da masade ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ngai gaw gade a aja gumhpraw hpun nba mung n marin yu nngai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lata ndai ni, ngai hkum hte ngai kaw hkan nang ai ni a ra ai lam magup galaw jaw ai lata rai li ai, nanhte nan chye nga myit dai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shing rai galaw shaja nna, gawng kya ai ni hpe shadaw mai ai lam mung, Hkam sha ai hta jaw ya ai mahtang grau a nga ai, nga nna Madu Yesu nan tsun ai ga dum ga, ngu nna mung, ngai lam shagu hta nanhte a ningli tai ni ai law,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shing nga tsun ngut jang, shi lahput hput di nna, shanhte mahkra hte rau akyu hpyi nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte nlang ja ja hkrap ai hte, Pawlu a du ahpum let shi e pup mu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hpang de shi a myi man bai n mu lu na nga ai ga majaw, shanhte grau yawn ma ai. Li du hkra mung shi hpe hkan sa dat ma ai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya anhte gaw shanhte hpe jahka kau da nna li jawn sa wa yang, Kusa zunlawng de ang ang rai wa nna, hpang shani e Rodo zunlawng de du ga ai; dai kaw nna Patara mare de du jang,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpinisi mung de rap wa ai li mu nna, dai hta jawn sa wa ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya Kupru zunlawng mu mada jang, de a hkra maga hku lai mat wa nhtawm, Suri mung de anhte jawn sa wa nna, hpaga rai jahkrat na matu, Turu mare hta sek ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai yang na sape ni hpe tam mu nna, dai mare hta sanit ya hkring ga ai: dai sape ni mung Pawlu hpe, Yerusalem de n sa na lam, Wenyi hte tsun mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sanit ya nhtoi lai jang, anhte bai pru wa ga ai; shanhte mung, madu jan kasha ni hte rau, mare shinggan du hkra hkan sa dat ma ai rai nna, hka kau e hput di let, akyu hpyi ga ai: shing rai shada da shakram ngut jang,
  </para>
  <para style="p">
    <verse number="6" style="v" />anhte li de shang nna, shanhte mung nta de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai Turu mare na anhte a li jawn lam htum nga yang, anhte Toleme mare de du ga ai; dai yang na hpunau ni hte shachyen nna, shanhte hte rau lani mi rau nga ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpang shani e anhte bai pru nna, Kesare mare de du ga ai; shing rai sara sanit hta na, kabu gara shiga hkaw tsun ai wa Hpilip a nta e, anhte shang manam nga ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai wa gaw myihtoi htoi ai shayi hkawn jet mali lu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a nta e anhte tawng marang mi nga nga yang, Agabu ngu ai myihtoi langai mi, Yuda mung na sa du ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai wa anhte kaw shang nna Pawlu a shingkyit la nhtawm, shi dai dai shi a lagaw lata gyit nna, “Chyoi pra ai Wenyi ning nga tsun nga ai, Ndai shingkyit madu hpe Yuda masha ni Yerusalem mare e ning di gyit nna, maigan amyu ni a lata de ap kau na mara ai da,” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ga dai na jang, anhte hte dai yang na ni gaw, Yerusalem de n sa na lam shi hpe hpyi hkum gaw ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pawlu chyawm gaw, “Nanhte hpa rai hkrap ngu hkrap ngoi nga nna, nye myit hpe gawng run shangun ya nga myit ta? gyit hkang ai sha n-ga, Madu Yesu a amying ningsang majaw, Yerusalem e sa si hkam na pyi ngai jin jin rai nga nngai,” ngu nna htan shangap wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai n shabai lu gaw yang, “Karai Kasang a myit rai nu ga,” ngu nna anhte mung atsin sha nga ga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpang anhte gaw arai shachyip la nna Yerusalem de lung wa ga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kesare na sape nkau mi mung, anhte hte rau sa ma ai rai nna, anhte hpe manam hkap na wa, Kupru masha, Manason ngu ai shawng shawng na sape langai mi kaw sa bang da mi ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Yerusalem de du jang, hpunau ni anhte hpe kabu gara ai myit hte hkap la mi ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpang shani e Pawlu anhte hte rau Yaku kaw shang nna, salang ni nlang mung hpawng nga ma la ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte hte shachyen ngut jang, shi gun hpai ai amu majaw, Karai Kasang maigan amyu ni hta shabyin wa ai amu lam langai hte langai hkai dan mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai na jang shanhte mung Karai Kasang hpe shagrau sha-a ma ai: bai shanhte gaw Pawlu hpe, “Hpu wa e, Yuda masha hta na kamsham ai ni gade mun hkying law nga ma ai gaw, nang chye nga ndai; dai ni mahkra jep ai tara hta myit jung ai hkrai rai nga ma ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />rai timung, maigan amyu ni hta jahkran nga ai Yuda masha yawng hpe, tinang a kashu kasha ni e matu gadoi n jaw ra ai hte, tara htung hking n hkan nga na, nga nna Mawshe a tara kabai kau na hku nang sharin achyin ya ai da, nga ai ga dai ni nlang na ma masai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya kaning rai na rai ta? Nang du ai gaw shanhte kaja wa na lu na masai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna anhte tsun ai hte maren hkan galaw u: anhte kaw ga shaka da ai marai mali nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai ni hpe shaga la nna, shanhte hte rau nang hkum jasan jaseng u; shanhte baw shangun lu hkra hkungga jahpu shapraw ya u: shaloi she na a lam shanhte na ai shi n teng nga ai hte, nang hkum nan jep ai tara htung hking hkan shatsup ai wa rai nga ai gaw, masha nlang chye na na mara ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kamsham ai maigan masha ni a lam chyawm gaw, shanhte sumla hpe nawng ai rai hte, asai, du manat sat ai shan, ndaw liknga lam koi gam na, anhte dawdan let ga shangun sagaw ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai re ai majaw Pawlu gaw dai la ni hpe shaga la nna, hpang shani e shanhte hte rau shi hkum jasan jaseng nhtawm, nawku Htingnu de shang nna, shanhte langai hte langai a matu hkungga jaw lu hkra, shanhte a jasan jaseng nhtoi gu sai lam sa tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya dai nhtoi sanit gu magang yang, Asi mung na Yuda masha ni nawku Htingnu e Pawlu hpe mu jang, shawa masha ni hpe myit sharawt nna, shi e rim la let, “Israela masha ni e, karum marit;
  </para>
  <para style="p">
    <verse number="28" style="v" />ndai wa gaw shara shagu hkan e yawng mayawng hpe anhte a amyu hte jep ai tara hpe mung, ndai shara hpe mung, nhtan shai ai hku sharin achyin ai wa re ai law; dai hta n-ga, nawku Htingnu hta Heleni masha jashawn nna, ndai chyoi pra ai shara hpe awu asin di kau nu ai law,” nga nna jahtau ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hpa majaw law nga yang, Trohpimu ngu ai Ehpesu masha langai mi hpe, mare e Pawlu hte rau shanhte mu manu ai rai nna, dai wa hpe nawku Htingnu de jashawn nu ai, nga nna myit ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mare ting kabring kabrawng rai nna, shawa masha ni gat ginbawm bang wa ma ai; shanhte Pawlu hpe ahkyit karawt la nhtawm, Htingnu shinggan de shapraw la nna, chyinghka ni hpe alawan la da ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shing rai Pawlu hpe sat kau na maw nga ma yang, Yerusalem mare ting kabrawng nga ai, nga nna hpyen dap up ai bu kaba kaw ga hkawn pru ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaloi jang hpyen ma hte hpyen du shaga la nna, shanhte hpang de gat bang wa ai: shanhte chyawm gaw hpyen du kaba hte hpyen ma ni hpe mu jang, Pawlu hpe kayat ai, da kau mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shaloi hpyen du kaba sit sa nna, Pawlu hpe dun la nhtawm, hpri sumri lahkawng hte gyit na hkang da mu ai: shi kadai re ai, hpa shut ai mung, san yu wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shawa masha ni chyawm gaw, nkau mi kaga ga nga nna jahtau bu ma ai hte, nau garu ai majaw, atsawm sha n chye lu wu yang, Pawlu hpe hpyen wang de jashawn na hkang da wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lakang nhpang du jang, shawa masha ni nau anin ai majaw, hpyen ma ni shi e pawn lung wa mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />kaning rai nme law, shawa masha ni mahtang, “Sa sat kau mu,” nga nna ahkan jahtau nang nga ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ya hpyen wang de Pawlu hpe jashawn na ningtawn e, Pawlu gaw hpyen du kaba wa hpe, “Nang hpe ga hkaw mi tsun lu na a ni?” ngu nna san wu yang, hpyen du kaba gaw, “Nang Heleni ga chye n ni?
  </para>
  <para style="p">
    <verse number="38" style="v" />Dai rai yang, shawng de lang mi gumlau rawt nna, nam mali hkan e damya hkying mali hpe woi ginrawn hkawm ai Egutu masha nang n rai n ni?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Pawlu chyawm gaw, “ngai Kiliki mung na, Tarshu mare Yuda masha rai nga nngai; ngai nga ai mare gaw kaji kashan sha n rai li ai: ndai masha ni hpe ga tsun lu na ahkang jaw e,” ngu nna hpyi nem wu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shi hpe ahkang jaw jang, Pawlu gaw lakang baw e tsap let, lata dingsi nga ai: shanhte a katsi sha rai jang, Hebre ga hte shanhte hpe tsun wu ai gaw,
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Hpunau ni hte Wa ni e, nanhte a man e ngai mara raw ai ga, madat mara ya mi,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hebre ga hte shanhte hpe tsun ai na jang, grau nna tsin nga ma ai: shaloi shi gaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ngai gaw Kiliki mung, Tarshu mare e shangai ai Yuda masha rai nga nngai; rai timung, ndai mare hta Gamale a lagaw nhpang e ngai kaba wa nna, anhte a ji wa ni a ja la ai jep ai tara htung hking hte maren azin ayang sharin achyin la nna, dai ni na nanhte zawn, ngai mung, Karai Kasang hpang maga myit kaba ai hte,
  </para>
  <para style="p">
    <verse number="4" style="v" />numsha lasha hpe gyit hkang sharen nna, htawng hta bang kau let, ndai lam hpe sat kau ai du hkra, zingri zingrat yu ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hkinjawng agyi wa hte salang hpung ting mung, nye a sakse ni rai nga ma ai; shanhte kaw na laika, hpunau ni a matu ngai lu la nna, Damasku mare e nga ai ni hpe mung, ari jahkrum na matu, Yerusalem de gyit dun wa n ga, ngu nna Damasku de ngai lung wa nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai ngai sa wa nna, Damasku mare de du magang yang, jan pungding madi ai hpawa e, lamu de nna nhtoi kaba nye a grup yin e akajawng sha htoi tu pru ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ga de ngai kadawng taw nna, shaga pru ai nsen mung, ‘Shawlu, Shawlu, nang ngai hpe hpa rai zingri nga n ta?’ nga ai, nga na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai mung, ‘Madu e, nang kadai rai nga n ta?’ ngu nna htan we yang, Shi gaw, ‘Nang zingri zingrat ai Nazaret na Yesu rai nga nngai,’ nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai hte rau sa ai ni chyawm gaw, nhtoi mu ma timung, ngai e tsun ai wa a nsen n na ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai ngai gaw, ‘Madu e, ngai hpa galaw na rai ta?’ ngu we ai. Shaloi Madu gaw, ‘Rawt u, Damasku de sa wa su; na a matu san da ai lam nlang, dai yang e nang hpe tsun dan na ra ai,’ nga nna ngai e bai tsun ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai htoi kabrim ai shingkang a majaw ngai myi nmu mat yang, ngai kaw hkan nang ai ni nye a lata dun let, Damasku mare de ngai shang wa nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai, jep ai tara hku tara hkungga nna, dai yang e nga ai Yuda masha ni mahkra man e myi man pa ai Anani ngu ai wa,
  </para>
  <para style="p">
    <verse number="13" style="v" />ngai kaw sa nna, nye a makau e tsap let, ‘Ngai nau wa Shawlu e, na myi mu lit ga law,’ nga nna tsun ai. Shaloi jang ngai shi hpe mu mada lu nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai shi gaw, ‘Anhte a ji wa ni a Karai Kasang gaw, nang hpe shi a myit mang ai lam shachye u ga, nga nna mung, Dingman ai Madu hpe mu lu na hte shi a n-gup na mungga na la lu u ga, nga nna mung, nang hpe san da nit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaning rai nme law, nang mu la, na la lu ai lam hpe, masha yawng a man e shi a matu sakse hkam ya ai wa, nang tai na rin dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya hpa rai ganung nga n ta? rawt u, Shi a amying ningsang hpe gang shaga let baptisma hkam la nna, na yubak kashin kamun kau u,’ ngu nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang Yerusalem mare de ngai bai du wa nna, nawku Htingnu e akyu hpyi nga yang, ngai myit nawng mat wa ai hta,
  </para>
  <para style="p">
    <verse number="18" style="v" />‘Yerusalem na alawan pru wa u; nye a lam nang hkam na sakse ga, shanhte n hkap la na ma ai,’ nga nna shi Madu ngai hpe tsun ai, ngai mu nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi ngai gaw, ‘Madu e, nang hpe kamsham ai ni e ngai htawng e bang da ai hte tara jawng shagu hkan e anu kau ai gaw, shanhte nan chye nga ma ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />na a sakse Stehpan a asai ru kau ma ai shaloi mung ngai nan makau e tsap nna, dai lam myit hkrum lawm let, shi hpe sat kau ai ni a hpun palawng hpe sin ya nngai,’ ngu we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi chyawm gaw, ‘Pru wa su; ngai nang hpe maigan masha ni nga ai sumtsan ga de shangun na de ai,’ nga nna tsun ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai kaw du hkra shanhte shi a ga madat nhtawm, “Dai zawn re ai wa hpe ga ntsa na tsan kau mu; shi hkrung nga n-ging nu ai,” nga nna marawn ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing nga marawn let, tinang a hpun palawng raw kabai kau ai hte, ga nhpu kabai shamawng nga ma yang,
  </para>
  <para style="p">
    <verse number="24" style="v" />hpyen du kaba wa gaw, Pawlu hpe hpyen wang de jashawn la nhtawm, “shi a lam hpa majaw ning nga marawn bu ai, chye lu hkra, anu sharim nna san akrawk yu mu,” ngu nna hkang dat mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhpyi sumri hte shi hpe gang jen mu yang, Pawlu gaw makau e tsap nga ai hpyen du wa hpe, “Taw, Roma masha rai nga ai wa hpe, garai n jeyang ngut yang, nanhte kayat sharim mai a ni?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hpyen du wa dai na jang, hpyen du kaba kaw wa nna, “Nang hpa galaw maw nga n ta? dai wa gaw Roma masha rai nga ai,” ngu nna shi hpe shana ya wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hpyen du kaba mung Pawlu hpang de sa nna, “Nang Roma masha rai ndai da aw? ngai e tsun rit,” ngu wu ai. Shi gaw, “Rai nga nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bai hpyen du kaba gaw, “Ngai Roma masha tai lu na ahkang, manu kaba hte she lu la nngai,” ngu nna htan wu yang, Pawlu gaw, “Ngai chyawm gaw, Roma masha tai chyalu shangai ai wa rai nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi jang, shi hpe san akrawk yu na nga ai ni, shi kaw na wa mat ma ai; hpyen du kaba wa mung, Pawlu Roma masha re ai chye jang, shi hpe gyit shut wu ai majaw, hkrit kau wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hpang jahpawt e, Yuda masha ni Pawlu hpe shagun ai mara hpa re ai, teng teng chye lu hkra, shi hpe raw dat nna, hkinjawng agyi ni hte salang bawng ting hpe shaga jahpawng tawn nhtawm, Pawlu hpe shanhte a ka-ang e jashawn ya wu ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Pawlu gaw dai salang bawng hpe azi yu da let, “Hpunau ni e, dai ni du hkra Karai Kasang a man e, hkum tsup ai myit mang hte ngai hkan sa ni ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna, hkinjawng agyi Anani gaw, “shi a n-gup bye ya mu,” nga nna makau e tsap nga ai ni hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Pawlu gaw, “Htun hpraw chya ai shakum e, Karai Kasang nang hpe mahtang bye na ndai: tara hku hte maren ngai hpe jeyang na she nang nang e dung nhtawm me, tara hte nhtan shai ai hku ngai hpe bye na hkang dat n ni?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Makau e tsap nga ai ni mung, “Nang Karai Kasang a hkinjawng agyi wa hpe roi lu n ni?” nga nna jet ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pawlu gaw, “Hpunau ni e, shi hkinjawng agyi re ai ngai n chye nna rai sai; ‘na amyu ntsa e up ai wa hpe roi lu na n rai,’ nga nna ka da nga ai,” nga nna bai yin wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpawng nga ai ni hta nkau mi Saduke, nkau mi Hparishe rai nga ma ai hpe Pawlu chye da wu ai majaw, dai salang bawng hpe, “Hpunau ni e, ngai gaw Hparishe rai nga nngai; Hparishe kasha mung rai nga nngai; si ai ni bai hkrung rawt na myit mada ai lam majaw, ngai jeyang hkrum nga nngai,” ngu nna jahtau dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hku tsun dat yang, Hparishe ni hte Saduke ni shada da ndang hkat ma ai rai nna, shawa hpawng gaw myit shai shajang mat ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaning rai nme law, Saduke ni mahtang, ‘hkrung rawt ngu ai n nga ai, lamu kasa hte wenyi mung n nga ai,’ nga nna tsun ma ai; Hparishe ni chyawm gaw dai lam lahkawng nga ai, kam ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna grai wa tsun garu bu nga ma ai; shaloi Hparishe hpung na laika ka ai sara ni nkau mi rawt nna, “Ndai wa hta hpa mara mung anhte n mu ga ai; Wenyi, shing n rai, lamu kasa langai mi shi hte ga tsun ai rai yang, hpa re hka, “--nga nna tsun hkat bu ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai nau wa dangrang hkat wa jang, shanhte Pawlu hpe ashep ashin di kau na, hpyen du kaba tsang ai majaw, shanhte kaw yu wa nna, Pawlu hpe dai ni a ka-ang na kare la nhtawm, hpyen wang de jashawn la na, hpyen ma ni hpe hkang dat mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai shana Madu gaw shi a makau e tsap pru nna, “Myit hkum ru et; nang nye a lam Yerusalem mare hta sakse hkam nit dai hte maren, Roma mare hta mung naw hkam lu na ndai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya nhtoi htoi yang Yuda masha ni jawm hpawng nna, “Pawlu hpe garai n sat lu lu gaw, hpa mung n lu n sha na ga ai,” nga nna tinang hkum dai dagam shaka ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing nga bawng ai ni marai mali shi jan rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte gaw hkinjawng ni hte salang ni hpang de sa nna, “Pawlu hpe garai n sat lu lu gaw, hpa mung n chyim yu na, ngu nna anhte grai ngu dagam shaka tawn sagaw ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai re ai majaw, nanhte madu ni dai salang bawng hte rau, Pawlu a lam atsawm sha naw san yu mayu ai, ngu nna nanhte hpang de shi hpe shaga la na matu, hpyen du kaba wa hpe hpyi dat mu; shaloi anhte gaw, shi garai n du yang lam lapran e shi hpe sat na jin jin rai nga na ga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai, hkap lagyim la na lam hpe, Pawlu a kahkri wa na nna, hpyen wang de shang nhtawm Pawlu hpe sa tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pawlu mung, hpyen du langai mi hpe shaga la nna, “Ndai ma hpe hpyen du kaba wa hpang de woi wa ya e: shi lama mi tsun mayu ai da,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpyen du wa mung shi hpe woi sa wa nna, hpyen du kaba wa kaw woi shang nhtawm, “Ndai ma nang hpe tsun ai ga lama mi rawng ai majaw, shi e nang kaw woi sa na, bawng dung wa Pawlu ngai hpe shaga la nna hpyi dat nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi hpyen du kaba gaw shi a lata dun nna, shim ai shara de shi e woi bang nhtawm, “Nang ngai hpe hpa tsun mayu n ta?” ngu nna lagyim san yu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi dai ma gaw, “Pawlu hpe atsawm sha naw san yu na zawn di nna, salang bawng de hpawt ni e woi la na matu, nang kaw hpyi na, nga nna Yuda masha ni myit hkrum masai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai rai nna shanhte ra ai hku hkum hkraw ya et; Pawlu hpe garai n sat lu lu gaw, hpa mung n lu n sha, nga nna tinang hkum dai dagam shaka ai marai mali shi jan, shi hpe hkap rim na makoi nga na ma ai; ya pyi, na a ahkang ala let, ndai amu galaw na shanhte jin jin rai nga masai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi hpyen du kaba gaw, dai ma hpe, “Ndai lam nang ngai e sa tsun ndai, kadai hpe mung hkum tsun et,” nga nna ginhtim ngut jang dat dat wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai shi gaw, hpyen du lahkawng shaga la nna, “Dai na ahkying masum hta Kesare mare de sa wa na, hpyen ma ni tsa, gumra jawn ai sanit shi, ri lang ai ni tsa hte hpe shajin tawn mu,” ngu wu ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />dai hta kaga, Pawlu hpe munggyi Hpilik hpang de ashim sha sa dat lu hkra, Pawlu jawn na gumra byau ya na mung hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laika mung ning ngu ka shagun dat wu ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />“Klawdi Lusi gaw, grau htum ai munggyi Hpilik hpe ngwipyaw ga shana dat nngai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ndai wa hpe Yuda masha ni rim la nna, shi hpe sat na maw ma yang, hpyen masha ni hte ngai sa nna, shi Roma masha re ai chye we ai majaw, shanhte kaw na kare la we ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai, shi hpe shagun ai mara chye ya mayu we ai majaw, shanhte a salang bawng hta jashawn ya yu yang,
  </para>
  <para style="p">
    <verse number="29" style="v" />shanhte a tara hte seng ai lam sha mara shagun mu ai; si ging ai mara, sharen ging ai mara lama mi muk n nga lu ai, ngai chye we ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ndai wa hpe sat kau na, hpaji daw ai lam ngai hpe shana ma ai majaw, shaloi jang ngai shi hpe nang hpang de sa kau dat nna, shi e mara shagun mayu ai ni mung, na a man e sa shagun hkat na hku, hkang dat mawe ai,” nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shing rai, hkang dat ai hte maren hpyen ma ni mung Pawlu hpe woi nna, Antipatri du hkra shana e sa sa dat mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hpang jahpawt e, gumra hpyen ni hpe bai sa shadu shangun nhtawm, shanhte hpyen wang de bai wa ma ai:
  </para>
  <para style="p">
    <verse number="33" style="v" />gumra hpyen ni mung Kesare mare de du nna, munggyi wa hpe laika ya da nhtawm, Pawlu hpe mung shi a man e jashawn mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi laika dai hti ngut jang, Pawlu gara mung na re ai san yu nna, Kiliki mung na re ai chye jang,
  </para>
  <para style="p">
    <verse number="35" style="v" />Munggyi wa gaw, “Nang hpe mara shagun ai ni du jang she, na amu ngai sagawn yu na nngai,” nga nna tsun nhtawm, Pawlu hpe Herod a htingnu hta rawng da na, hkang dat wu ai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang manga ya rai jang, hkinjawng agyi Anani gaw, salang ni nkau mi hte rau, Tertulu ngu ai bawmung wa langai mi hpe woi sa wa nna, shanhte gaw munggyi wa kaw Pawlu a lam sa tsun ma ai. Shaloi Pawlu hpe shaga tawn ya jang, Tertulu mara shagun ai ga tsun hpaw wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Grau htum ai Hpilik e, anhte gaw na a marang e nachying nga ngwi nga pyaw nga ga ai hte, na a chye up chye hkang ai hta, ndai amyu a matu mung ding mung chying lam rai wa sai majaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />anhte dai hpe lam magup hta shara shagu hkan e, chyeju dum ai myit hte hkam sha nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung, ngai nang hpe nau wa n shapu ai sha, ga gadun hte anhte tsun na lam hkaw mi, na myit galu kaba hte naw madat ya na, ngai hpyi nngai law.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ndai wa gaw n hkru n hkra re ai hte, mungkan ting na Yuda masha ni nlang hpe gumlau sharawt nna, dai Nazaret hpung a agyi kaba rai nga ai gaw, anhte mu gaw ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />dai hta kaga, shi gaw nawku Htingnu hpe awu asin di na mung maw nga ai: dai majaw anhte shi hpe rim la gaw ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />shi hpe nang san yu jang, anhte shi e shagun ai mara lam yawng teng nga ai gaw, nang chye lu na ndai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yuda masha ni mung, “dai hku re ai,” nga nna jawm tsun lawm ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Munggyi wa lata dingsi nna, ga tsun na ahkang jaw wu yang, Pawlu gaw, “Nang madu tsawmra ning na hkra ndai amyu a ntsa e tara agyi tai yu nit dai, ngai chye nngai majaw, nye a mara raw ai ga hpe kabu gara ai myit hte ngai tsun we ga:
  </para>
  <para style="p">
    <verse number="11" style="v" />Yerusalem de nawku na matu ngai lung wa ai, nhtoi shi lahkawng ya garai n jan ai gaw, nang chye ya lu ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nawku Htingnu hte tara jawng hkan, mare kata hkan, kadai hte dangrang hkat ai mung, hpawng shingra hpe woi kabrawng ai mung, shanhte n mu ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya shanhte ngai e shagun ai mara lam ni hta, nang hpe sakse pyi n madun lu ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai timung, lam mi chyawm gaw nang hpe shapraw dan de ga; Jep ai tara lam shagu hte myihtoi ni a laika hta ka da ai hku yawng mayawng kamsham let, shanhte hka bra Lam ngu nna shamying ai htung hku hkan nna, ngai ji wa ni a Karai Kasang hpe nawku nga nngai:
  </para>
  <para style="p">
    <verse number="15" style="v" />shanhte myit mada ai hte maren, ngai mung, dingman ai ni hte n ding n man ai ni a matu, bai hkrung rawt wa na lam nga ai, ngu nna Karai Kasang hta myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna, Karai Kasang a man e mung, masha a man e mung, ra n rawng ai sha tutnawng myit mang san pra nga lu hkra, a shaja nga nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai, tsawmra ning lai wa ai hpang, nye amyu masha ni kaw, majaw maya kumhpa hte shawang alu wa jaw na ngai wa nngai:
  </para>
  <para style="p">
    <verse number="18" style="v" />shaloi e, ngai kanang na shawa hpawng mi rau n nga ai, hpa kabring kabrawng mung n rai ma ai; nawku Htingnu e nye hkum jasan jaseng nga ai hpe sha, ngai hpe mu ma ai; rai timung, Asi mung na Yuda masha nkau mi nga nga ai rai nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />dai ni gaw, ngai hta mara lama ma shagun shara rawng yang gaw, nang kaw sa tsun mai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing n rai, dai salang bawng a man e ngai tsap nga yang, Si ai ni a bai hkrung rawt wa ai lam a majaw, dai ni nanhte ngai hpe jeyang nga myit dai,
  </para>
  <para style="p">
    <verse number="21" style="v" />ngu nna, shanhte a ka-ang e ngai jahtau ai ga hta kaga, ngai hta hpa mara naw mu da mi yang gaw, ndai ni shanhte hkum nan tsun dan mu ga,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hpilik shi mahtang, dai tara lam grau chye da nhtawm, “hpyen du kaba Lusi du jang she, ngai nanhte a amu dawdan na nngai,” ngu nna shanhte hpe jahkring kau mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pawlu hpe mung majoi naw a sin tawn da nna, shi a jinghku jing-yu ni kadai sa galaw jaw mayu yang, galaw jaw shangun mu, ngu nna hpyen du wa hpe hkang da wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hpang gade ya garai n na yang, Hpilik gaw, Yuda num Drusila ngu ai madu jan hte sa nna, Pawlu hpe shaga la nhtawm, Hkristu Yesu a makam masham lam tsun dan ai madat la wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pawlu gaw dinghpring ai lam, tinang hkum hkang ai lam hte du magang ra ai tara dara ai lam shapraw dan wu yang, Hpilik kajawng nna, “Ya naw wa su, ngai rau jang me nang hpe shaga na de ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi chyawm gaw, Pawlu gumhpraw jaw na ra ai nhten, nga myit nna, law law lang shi hpe shaga chyai wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shing rai ni ning ladu hkrum jang, Hpilik a aya hta Porku Hpestu galai ai rai nna, Hpilik gaw Yuda masha ni a myi man shapa mayu ai majaw, Pawlu hpe sharen da let naw tawn da wu ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Hpestu dai mungdaw hta shang ai masum ya rai yang, Kesare mare kaw nna Yerusalem de lung wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi hkinjawng agyi ni hte Yuda masha ni a agyi salang ni, Pawlu a lam shi hpe sa tsun nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pawlu hpe lam e hkap gyam sat kau lu hkra maw ai myit hte, shi hpe Yerusalem mare de sa dat ya na lam, chyeju hkap hpyi mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung Hpestu gaw, Pawlu hpe Kesare mare e she sharen tawn nga ai rai nna, gade n na yang shi mung dai de bai wa na rai nga ai majaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Nanhte hta na ahkang lu ai ni ngai hte rau yu wa nna, dai wa hta mara lama ma rawng yang gaw, sa shagun mu,” ngu nna htan dat mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai shanhte kaw nhtoi matsat ya, shi ya daram hkring nga nhtawm, shi Kesare mare de bai yu wa nna, hpang shani e tara tingnyang hta dung let, Pawlu hpe shaga na hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi du jang, Yerusalem na yu wa ai Yuda masha ni gaw Pawlu a grup yin e tsap nna, sakse n madun lu ai mara kaba law law wa shi a ntsa e shagun mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pawlu chyawm gaw, “Yuda masha ni a jep ai tara hpe mung, nawku Htingnu hpe mung, hkawhkam Kehta hpe mung, ngai hpa n shut n hpyit yu nngai,” ngu nna mara raw ga tsun nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung Hpestu gaw, Yuda masha ni kaw myi man pa mayu nna, Pawlu hpe, “Nang Yerusalem mare de lung wa nna, dai yang e nye a man e ndai amu lam dawdan hkam na, nang hkraw nga n ni?” ngu nna shi hpe san wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pawlu chyawm gaw, “Hkawhkam Kehta a tara tingnyang man e ning ya tsap nga nngai; dawdan ai rai yang, nang e dawdan mi: nang madu atsawm sha chye nga ai hte maren, Yuda masha ni hpe ngai kachyi mi muk shut ai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai shut hpyit tawt lai ai wa rai nna, si ging ai mara lama ma galaw kau ai rai yang gaw, si hkam na lam ngai ndang ai n rai: rai timung, ndai ni shagun ai mara langai mi muk n teng yang gaw, shanhte a lata de ngai hpe kadai wa ap kau lu na n rai. Hkawhkam Kehta kaw du na nngai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Hpestu gaw, salang bawng hte bawng ngut jang, “Nang Kehta kaw du na nga nit dai: Kehta hpang de sa lu na re ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpang nhtoi gade n na yang, hkawhkam Agripa Yan Bernike hte Kesare mare de du nna Hpestu hpe sa shachyen ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai yang e tsawmra wa na hkra nga nga sayang, Hpestu dai hkawhkam hpe Pawlu a lam tsun dan wu ai gaw, “Hpilik sharen da nga la ai bawng langai mi nga ai;
  </para>
  <para style="p">
    <verse number="15" style="v" />ngai Yerusalem de nga nga yang, hkinjawng agyi ni hte Yuda salang ni, dai wa a lam sa tsun nna, ngai shi a lam dawdan ya na hkap hpyi ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai chyawm gaw, Mara shagun hkrum ai wa, mara shagun ai ni hte myi man chyaw dara hkat nna, mara raw ai ga garai n tsun lu yang, kadai hpe ap kau na lam mung, Roma masha ni a htung n nga ai, ngu nna shanhte hpe tsun da mawe ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna shanhte nang e zuphpawng nga ma yang, ngai mung n hkring ai sha, hpang shani jang tara tingnyang e dung nna, dai wa hpe woi wa ya na hkang dat we ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi shanhte dai wa hpe mara tsun bun ma yang, ngai zawn nawn ai mara lama mi muk n shagun tawn mu ai;
  </para>
  <para style="p">
    <verse number="19" style="v" />shanhte a nawku htung lam hte, si mat sai, Yesu ngu ai wa langai mi a lam sha, shi hte dangrang hkat ma ai; dai Yesu gaw naw hkrung nga ai, nga nna Pawlu a tsun nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai lam hpe kaning di sagawn na n chye we ai majaw, Yerusalem mare e dai lam dawdan sa hkam na hkraw n hkraw ai, shi hpe san yu yang,
  </para>
  <para style="p">
    <verse number="21" style="v" />Pawlu mahtang, Hkawseng kaba kaw she du na nga hpyi ai majaw, Kehta kaw garai n sa dat lu ai laman e, shi hpe naw sin da na, ngai hkang dat we ai,” ngu nna tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Agripa gaw Hpestu hpe, “Ngai mung dai wa a ga na mayu nngai,” ngu wu yang, “Hpawt de na lu na re ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hpang shani e Agripa yan Bernike gaw, amawn asam rai shingkang dat nna, hpyen du kaba ni hte mare na agyi salang ni hte rau sa nna, rung gawk e shang du ma yang, Hpestu hkang dat jang, Pawlu hpe jashawn dat mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Hpestu tsun wu ai gaw, “Hkawhkam wa Agripa hte ya nang e hpawng nga ai ni nlang hte e, Yerusalem mare hte ndai mare na Yuda masha yawng, ngai kaw sa tsun nna, Dai wa hpe naw jahkrung da n mai sai, nga nna jahtau bu ai gaw, ya nanhte mu ai ndai wa hpe rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rai timung, ndai wa hta sat ging ai mara hpa mung ngai n mu we ai: shi mahtang, Hkawseng kaw du na hpyi ai majaw, sa dat na ngai myit da se ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sa dat nga yang mung, nye a Madu hpang de shi a lam azin ayang ka shana dat na mi, n rawng lu ai. Dai rai nna, dai wa hpe manaw yu ngut yang, ka dat lu na ga langai ngai ngai mu lu hkra, nanhte a man e mung, grau nna nang hkawhkam Agripa man e mung, ngai shi hpe shapraw dan de ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nme law, bawng langai mi sa dat yang, shi hpe shagun ai mara n madun dat ai gaw, n jaw ai, ngu nna ngai myit nngai,” ngu mu ai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Agripa gaw Pawlu hpe, “Na a lam tsun na ahkang rai nga ai,” ngu wu ai. Dai rai nna Pawlu lata ladawn let mara raw ai ga tsun wu ai gaw:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hkawhkam Agripa e, Yuda masha ni a htung hking lam hte dangrang hkat ai lam magup hpe nang chye grau ai wa rai nga ndai majaw;
  </para>
  <para style="p">
    <verse number="3" style="v" />Yuda masha ni ngai hpe shagun ai mara lam shagu hpe, dai ni na a man e mara raw ga tsun lu ai gaw, ngai hta a nga sai, ngu nna myit nga nngai law: dai rai nna, myit galu kaba ai hte ngai e madat mara ya na, ngai hpyi nem nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shawng nnan, nye a brang ram prat kaw nna, nye a amyu hta mung, Yerusalem mare hta mung, ngai hkan nang ai arawn alai, Yuda masha ni nlang chye chyalu rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Moi nna nye a lam chye ma ai majaw, anhte a nawku htung na ja grau ai Hparishe ngu ai hpung hta ngai lawm nga nngai gaw, shanhte sakse hkam mayu yang, hkam lu ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rai timung, ya, Karai Kasang gaw ji wa ni hpe jaw da ai ga ndat na myit mada lam majaw, dawdan ai hkam sha na, ngai nang e tsap nga nngai:
  </para>
  <para style="p">
    <verse number="7" style="v" />dai ga ndat chyeju hkam la lu hkra nga, anhte a amyu shi lahkawng ting, shani shana Karai Kasang hpe jaw jau let, shaja nga ma ai: dai myit mada lam majaw, Hkawhkam wa e, Yuda masha ni ngai e mara shagun ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang si ai ni hpe jahkrung dat ai nga ai gaw, kam shara n re ai, nga nna nanhte hpa rai myit la myit ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai nan, Nazaret wa Yesu a amying hpe nhtan shai ai hku law law wa mai di na, ngu nna ngai teng teng myit nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gaja wa dai hku Yerusalem mare e galaw yu se ai, hkinjawng agyi ni kaw na ahkang lu la nna, chyoi pra ai ni hpe htawng e bang kau ai hte, shanhte hpe sat kau yang, ngai mung awlaw lawm ni ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tara jawng magup hta mung shanhte hpe law law lang ari jahkrum let, Yesu hpe shatan shangun lu hkra shaja se ai: shanhte hpe nachying pawt ai n-yun, bu nna, masha ga hkan na kahtawng mare du hkra pyi, hkan zingri mase ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai, hkinjawng agyi ni kaw na mungga ahkang la gun nna, Damasku mare de ngai sa wa yang,
  </para>
  <para style="p">
    <verse number="13" style="v" />Jan pungding madi ai aten e, Hkawhkam wa e, jan hta grau htoi tu ai nhtoi, dai lam e ngai hte nye a manang ni a grup yin, lamu de nna htoi tu pru ai, mu nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi anhte nlang ga de kadawng taw mat shajang nga yang, Hebre ga hte ngai hpe, ‘Shawlu, Shawlu nang ngai hpe hpa rai zingri nga n ta? masawn hpe htawng yang, na matu yak la ahka gaw,’ nga nna shaga ai nsen ngai na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi ngai gaw, ‘Madu e, nang kadai rai nga n ta?’ ngu nna htan we yang, Madu gaw, ‘Nang zingri zingrat ai Yesu rai nga nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai timung, rawt u, jan rai tsap u: kaning rai nme law, nang ngai hpe mu mada lu sai lam hte, ngai nang hpe naw madun na ra de ai lam ni a matu, amu gun hpai masha hte sakse wa shatai na san da de ga, ngu nna ya nang kaw ngai dan pru ring ngai:
  </para>
  <para style="p">
    <verse number="17" style="v" />shing rai maigan amyu ni, nsin kata nna nhtoi de, Satan a atsam kata nna Karai Kasang hpang de kayin wa lu nna, yubak raw dat kau ya ai chyeju lu la na hte, ngai hpe kamsham ai a marang e, shachyoi shapra hkam la ai ni hte rau Sali wunli dagraw lu hkra,
  </para>
  <para style="p">
    <verse number="18" style="v" />shanhte a myi jahpaw na matu, ngai nang hpe shanhte hpang de shangun dat de ai rai nna, na a amyu a lata na mung, maigan masha ni a lata na mung, hkye hkrang la na de ai,’ nga nna ngai hpe tsun nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna, Hkawhkam Agripa e, lamu na shingran dai hpe n madat ai, ngai n nga lu nngai:
  </para>
  <para style="p">
    <verse number="20" style="v" />dai lam hpe nnan e Damasku masha ni kaw nna, Yerusalem hte Yuda mung ting hta mung, maigan amyu ni myit malai lu nna, myit malai hte ging dan ai arawn alai shachyen let, Karai Kasang hpang de kayin wa mu ga, ngu nna maigan amyu ni hta mung, ngai hkaw shana nga nngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai lam a majaw Yuda masha ni, nawku Htingnu e ngai hpe rim la nna, sat kau na maw mi ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang kaw na karum ai lu la ai majaw sha, dai ni du hkra nga nga let, kaji kaba yawng hpe sakse hkam ai hta,
  </para>
  <para style="p">
    <verse number="23" style="v" />Hkristu nni nkri hkrum lu na hte, si ai ni kaw na shawng hkrung rawt wa lu nna, shi a amyu hte maigan amyu ni hpe nhtoi lam madun dan lu na ra ai, nga nna byin wa na ra ai lam ni a matu, myihtoi ni hte Mawshe tsun ai lam hta kaga, ngai hpa mung n tsun jan nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing nga mara raw ga tsun ai hpe, Hpestu gaw, “Pawlu e, nang mana nit dai; hpaji hparat nau htang shalai nna mana mat nit dai,” ngu nna aja awa jet wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pawlu Chyawm gaw, “Grau htum ai Hpestu e, ngai n mana nngai; tengman ai hte myit leng ai ga ngai tsun nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ndai lam hpe Hkawhkam wa nan chye da wu ai; shi a man e dingsa tsun ai mung, rai nga nngai: kaning rai nme law, ndai lam gaw njut nnaw e sha n byin re ai majaw, hkawhkam wa shi n chye ai mi n nga na re ai, ngu nna ngai kam nga nngai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hkawhkam Agripa e, myihtoi ni a ga hpe nang kam n ni? kam nga ndai gaw ngai chye nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi Agripa gaw Pawlu hpe, “Ga hkaw loi sha hte nang ngai hpe Hkristu a sape ganoi shatai lu da nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai Pawlu gaw, “Karai Kasang hkraw yang gaw, madu nang sha n rai, dai ni ngai tsun ai ga na mana ni nlang, ga hkaw loi sha hte rai timung, law law hte rai timung, ndai gyit hkang ai hpe n ngu ai sha, ngai zawn re ai hkrai rai na, ngai ra nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi hkawhkam wa yan munggyi wa hte Bernike gaw, shanhte hte dung nga manang ni hte rau rawt ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pru wa yang shanhte shada, “Ndai wa gaw sat ging ai mara, sharen ging ai mara, lama mi muk galaw ai n rai,” nga nna tsun shajang ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Agripa mung Hpestu hpe, “Ndai wa shi mahtang Kehta kaw du na n hpyi taw gaw, raw dat mai sai,” ngu nna tsun wu ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, anhte hpe Itali mung de li hte sharap sa wa na myit shatawng da ngut jang, shanhte Pawlu hte kaga bawng ni nkau mi hpe, Agustu hpyen dap hte seng ai, Yuli ngu ai hpyen du a lata hta ap dat mi ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi, Asi mung a nammukdara hkin-gau hkan na mare ni de garet shang hkawm wa ai, Adramuti na sanghpaw li hta anhte shang jawn ga ai: Htesaloni mare na Makedoni masha Aristarku mung anhte hte rau lawm nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpang shani e anhte Sidon mare hta sek ga ai; Yuli gaw Pawlu hpe matsan dum nna, shi a jinghku ni kaw sa jahkrum na hte galaw daw hkam sha na matu, ahkang jaw wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai kaw na pru jang, nbung n sun ai majaw, Kupru zunlawng lahta hku garet nna,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kiliki hte Pamhpuli mung na nawng makau hku rap tawng yang, Luki mung na Mura mare de du ga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai shara e hpyen du wa gaw, Itali mung de rap sa wa ai Alesandru mare na sanghpaw li mu hkrup nna, dai hta e anhte hpe jashawn mi ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai kaw nna nhtoi law law wa, yat yat sha sa wa nna, Kidu jut ang de yak let sha du lu jang, nbung n sun ai majaw, n shanang lu nna, Kreti zunlawng hpe shinggun let, Salmone ginchyum ang hku sa wa nhtawm,
  </para>
  <para style="p">
    <verse number="8" style="v" />de a makau hku yak la ai hte garet hkawm wa yang, Lasea mare hte ni nga ai Daru Kaja ngu ai, li sek ai shara de du ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya nhtoi tsawmra wa na wa jang, lusha gam aten lai mat ai majaw, li hte hkawm sa hkrit ra ai ta du sai rai nna,
  </para>
  <para style="p">
    <verse number="10" style="v" />Pawlu gaw, “Hkau ni e, ya hkawm yang, yak la nna ali hte arai ni sum na hta n-ga, anhte a asak pyi sum na zawn nawn da we ai,” ngu nna shanhte hpe tsun shadum wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hpyen du wa mahtang, Pawlu a ga hta, Li hkang ai wa hte li madu a ga hpe, grau nna kam wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Daru dai mung nshung ta sek shatawt lu na n tai ai majaw, Hponik daru de du lu yang du hkra sa nna, dai yang nshung shatawt lu hkra du wa na lam, law malaw myit hkrum ma ai: dai shara gaw, Kreti zunlawng na sinna dingdung hte sinna dingda de man yawng ai daru rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai rai nna, dingda nbung angwi sha bung wa jang, shanhte myit ai hte tup sai zawn nawn nna, hpri chyinghkyi dawm la nhtawm, Kreti zunlawng makau hku garet sa wa ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai timung gade n na yang, sinpraw dingdung nbung laru gaw, dai zunlawng de nna ru wa ai rai nna,
  </para>
  <para style="p">
    <verse number="15" style="v" />ali hpe adawt ai majaw n shadaw lu jang, anhte dat dat nna, nbung e woi ai de yawng nang ga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kawda ngu ai zunlawng kaji a lawu hku garet wa nga yang, de a li kaji hpe grai shaja ai hte gang la lu nna,
  </para>
  <para style="p">
    <verse number="17" style="v" />li ntsa de gang shakap nhtawm, li kaba hpe ngang hkra, dai hpe matep nna sumri hte hkang mu ai; bai Surti ngu ai zaibru jang hta mara mat na hpe tsang ai majaw, de a sumpan ni hpe shanhte jahkrat kau nna, yawng nang ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nbung laru nau nan ja la ai majaw, hpang shani e li hta na hpaga rai ni htawm jahkrat kau mu ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />bai masum ya rai jang, dai li a arai ni hpe mung, tinang a lata hte htawm jahkrat kau mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Law law ya wa jan n mu, shagan ni mung n dan pru ai hte, ja la ai laru sha aru nga ai majaw, anhte hta lawt lu na myit mada shara kachyi mi muk n nga masali ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ya shanhte shat n sha ai, tsawmra ya na wa sai rai nna, Pawlu gaw shanhte a ka-ang e tsap let, “Hkau hte e, nanhte nye a ga madat nna, Kreti zunlawng na n pru myit taw gaw, ning re ai hten bya ga n du na re ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya rai timung, ngai tsun ai madat nna myit shalan mu; nanhte hta na kadai mung asak sum ga du na n rai; sanghpaw li sha asum na re ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kaning rai nme nga yang, ngai hpe up hkang nna, ngai daw jau ai Karai Kasang a lamu kasa langai mi, mana e nye a makau e sa tsap nna,
  </para>
  <para style="p">
    <verse number="24" style="v" />‘Pawlu e, hkum hkrit et; hkawhkam Kehta a man e nang tsap lu na rin dai; yu u, nang hte rau ndai li hta jawn ai ni nlang, Karai Kasang nang hpe ap ya nit dai,’ nga nna ngai e tsun sai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai re ai majaw, Hkau hte e, hkum tsang myit; ngai hpe tsun dan ai hte maren rai na ra ai, ngu nna, ngai Karai Kasang hpe kam nga nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai timung, zunlawng langai ngai hta anhte mara na ga ai,” ngu nna shanhte hpe shalan wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya nhtoi shi mali ya shana du nna, anhte Adri nawng hta yawng kayin nga yang, yuptung hpawa e, hkarang kawng langai ngai de ni wa sam nga ai, nga nna li ma ni myit ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai, hka shadawn yu yang, lalam hkun sung ai chye ma ai; loi hkring rai jang, bai shadawn yu yang, lalam shi manga sha sung sai mu ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai re ai majaw, nlung hkin-gau hta ahtu hkra na hpe tsang ai rai nna, shanhte li mai de na hpri chyinghkyi mali jahkrat nhtawm, nhtoi htoi hkra ala nga ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Li ma ni dai sanghpaw li kau da nna hprawng na maw ai myit hte, li baw na chyinghkyi jahkrat na zawn di nna, li kaji hpe hka de shayu nga ma yang,
  </para>
  <para style="p">
    <verse number="31" style="v" />Pawlu gaw hpyen du hte hpyen ma ni hpe, “Ndai ni li e n nga sayang me, nanhte lawt lu na mi n rai sai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaloi hpyen ma ni gaw li kaji dun ai sumri ni sa dan kau nna, li kaji dai hpe jahka kau ya mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ya nhtoi htoi wa jang, Pawlu gaw, shanhte mahkra hpe shat sha na lam woi awn let, “Nanhte lusha hpa mung n sha ai gaw, dai ni shi mali ya na wa manit dai:
  </para>
  <para style="p">
    <verse number="34" style="v" />dai re ai majaw, lusha lama ma sha mu; dai gaw nanhte a lawt na matu rai nga ai; nanhte hta gade a kara singgawng mi muk sum ga du na n rai,” ngu nna shanhte hpe shalan wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shing nga tsun ngut ai hte muk la nna, shanhte mahkra a man e Karai Kasang a chyeju hpe shakawn kungdawn let, shi woi hkyep nna, woi sha wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shaloi she nlang hte mung myit pyaw nna, shat sha shajang ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai li hta rawng ai masha yawng gaw, ni tsa e sanit shi kru rai nga ga ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hkru hkra sha ngut jang, hkaulan mam hpe hka de kabai bang kau nna, li hpe shatsang mu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nhtoi leng rai yang, shara dai hpe shanhte n chye timung, zaibru jang shingjut langai mi mu mada nna, dai de du hkra hkang lu n hkang lu chyam yu na, bawng ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shaloi hpri chyinghkyi ni hpe shanhte raw nna nammukdara e kau da mu ai; li hkang ai lasham sumri hpe mung raw nna, li baw de na dawnghkawn sumpan sharawt nhtawm, dai zaibru jang de hkang wa ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Rai timung, zaini hkindawt langai mi kaw li wa chyat mat nna, li baw de n shamu lu ai hte, li mai de hka leng kayat ai majaw, agrawp mat wa ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shaloi hpyen ma ni gaw, bawng ni hpung-yawt rap wa nna lawt mat na hpe tsang ai majaw, shanhte hpe sat kau na bawng ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hpyen du wa chyawm gaw, Pawlu hpe hkye la mayu nna, shanhte a bawng ai lam hpe hkum kau nhtawm, hpung-yawt chye ai ni kadai mung, hka de yu nna, hkarang de shawng kaw wa mu ga, nga nna mung;
  </para>
  <para style="p">
    <verse number="44" style="v" />kaga ni gaw, nkau mi hpunpyen hte, nkau mi sanghpaw li a arai kaga ni hta, noi nna rap wa mu ga mung, hkang dat mu ai. Shing rai shanhte nlang hkarang de kaw wa nna lawt lu ma ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shing rai anhte, kaw lawt lu jang she, zunlawng dai Melite ngu ai zunlawng rai nga ai hpe, anhte chye gaw ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yang na karing karang masha ni anhte hpe grai wa matsan dum nna, marang a htu nga ai hte kashung ai majaw, wan wut nna, anhte nlang hte hpe hkap hkalum la mi ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Pawlu gaw hpun dingshan magawn la nna, wan mang hta bang dat wu yang, pu htum langai mi wan kahtet ai na jang pru wa nna, shi a lata hta kawa noi nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai, Pawlu a lata pu htum noi goi lang nga ai hpe, dai karing karang masha ni mu ma yang, shanhte gaw, “Gaja nan, ndai wa gaw masha sat ai wa teng sam ai; hka na lawt lu timung, shi hkrung nga na hpe, Shingra tara e n hkraw wu hka,” nga nna shada tsun shajang ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pawlu chyawm gaw lapu dai hpe wan mang de ari bang kau nna, hpa tsin-yam mung n hkrum ai anga nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw, shi hkum bum wa na ra ai, dai n rai, ahkring sha kadawng si na ra ai, nga nna myit nga ma ai, rai timung, na na wa la yu nga yang, shi hta hpa mung n byin ai mu jang, shanhte myit bai galai nna, ndai wa gaw Hpara langai mi she rai nga ai, nga nna bai tsun ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya, dai makau hkan e, Popli ngu ai zunlawng agyi wa a ga dachyawk ni nga shajang nga ai: dai wa gaw anhte hpe hkap hkalum la nna, masum ya tup jinghku myit hte manam daw mi ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai shaloi e Popli a kawa gaw hkali hte daren machyi nna taw nga ai; Pawlu gaw dai wa kaw shang nna, akyu hpyi ai hte shi a lata mara ya nna, shi hpe shamai ya wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai byin ai majaw, zunlawng na machyi ai ni kaga mung du ma ai rai nna, shamai shatsai lu la ma ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />shanhte mung, anhte hpe hkungga lara ai lam law law galaw nna, dai yang na li jawn pru wa jang, anhte hta ra ai made li hta bang ya dat ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai, shata masum lai jang, dai zunlawng e kashung ta shalai nna nga nga ai, Alesandru mare na, Hpara marun yan nau a sumla kap ai sanghpaw li hta anhte shang nna jawn pru wa ga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Surakusa mare de du yang, anhte dai yang e masum ya hkring nga ga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai kaw nna kawai jawn wa yang, anhte Regi mare de du ga ai: hpang shani e dingda nbung bung wa ai rai nna, ni ni shani hta Potioli mare de du ga ai;
  </para>
  <para style="p">
    <verse number="14" style="v" />dai yang e anhte hpunau ni hte hkrum nna, sanit ya tup hkring nga na shanhte hpyi ma ai rai nna, anhte hkring nga ga ai: dai hpang Roma mare du ga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai mare na hpunau ni, anhte du na lam na nna, tau la na nga, Api gat hte Manam Jarawp masum du hkra sa ma ai; Pawlu shanhte hpe mu jang, Karai Kasang hpe shakawn kungdawn nna shalan shabran nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya anhte Roma mare de du bang jang, Pawlu gaw shi hpe sin ai hpyen ma hte rau kaga hkrai rai nga na, ahkang lu la wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Masum ya nhtoi lai ai hpang, Pawlu gaw dai yang na Yuda agyi salang ni hpe shaga la wu ai: shanhte du sa shajang ma yang, shi gaw shanhte hpe, “Hpunau ni e, nye a amyu hpe mung, ji wa ni a htung hking hpe mung, nhtan jashai nna, ngai hpa mung n galaw yu nngai; rai timung Yerusalem mare kaw nna, Roma masha ni a lata de bawng di ap kau ai, ngai hkrum nngai:
  </para>
  <para style="p">
    <verse number="18" style="v" />Roma du ni chyawm gaw ngai hpe sagawn yu ngut jang, si ging ai mara ngai hta n mu ai majaw, ngai hpe raw dat mayu ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hpe Yuda masha ni mahtang n hkraw ai majaw, ngai kaning n chye di nna, Kehta kaw du na hpyi we ai: dai rai timung, nye a amyu hpe mara shagun shara rawng ai majaw n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai, Israela amyu a myit mada ai lam a nhkan e, ndai hpri hkang hkyihkyang hte sharen ai ngai hkrum nngai majaw, ngai kaw mahtang sa tsun chyai na, ngai nanhte hpe shaga dat nngai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi shanhte gaw, “Na a lam, Yuda mung na laika mung anhte n lu ga ai; hpunau ni kadai mung na a lam n kaja ai shi sa tsun ma ai n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai timung, ndai hka bra Hpung gaw, shara shagu hkan e ndang kau hkrum ai lam rai nga ai hpe, anhte chye ga ai majaw, nang myit ai hku mung anhte na mayu ga ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya shanhte shi hte hkrum chyai na nhtoi madat da nhtawm, shi manam nga ai nta de masha law law wa sa hpawng nga ma ai: shaloi shi gaw, jahpawt kaw nna shana de du hkra, Mawshe a tara hte myihtoi ni a ga hta hkan nna, Karai Kasang a mungdan lam sakse hkam ai hte, Yesu a lam shanhte hpe shapraw shadan dan mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing nga tsun ai lam hpe nkau mi hta la ma ai; nkau mi chyawm gaw n kam n sham ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai shanhte shada myit n hkrum ma ai majaw, Pawlu gaw, shanhte hpe, “Chyoi pra ai Wenyi myihtoi Esaia a n-gup hte nanhte a nji nwa ni hpe tsun ai ga gaw teng la malit dai: dai gaw,
  </para>
  <para style="p">
    <verse number="26" style="v" />‘Amyu dai hpe sa tsun dan su, Nanhte na lana n chye na na mu ai; Yu layu e, n mu na mu ai, ngu su.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nme law, tinang myi hte mu lu nna, Tinang a na hte na la lu let, Tinang a myit masin hta chye na lu ai hte Ngai hpang de kayin wa na hpe; Ngai shanhte hpe n shamai lu hkra, Dai amyu gaw myit mak nga nna, Shanhte a na lahpang nga ai hte, Shanhte a myi pat nga malu ai,' nga ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai re ai majaw, ndai Karai Kasang a hkye hkrang la ai lam, maigan amyu ni hpang de jaw dat nu ai rai nna, shanhte mahtang madat mara hta la na mara ai gaw, nanhte nan chye nga mu law,”
  </para>
  <para style="p">
    <verse number="29" style="v" />ngu nna dai ga hkaw mi tsun jat dat ai hpang, shanhte pru wa ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai kaw nna Pawlu gaw ni ning tup shi shap rawng ai nta hta nga nga let, shi kaw sa masa ni hpe hkap la nna,
  </para>
  <para style="p">
    <verse number="31" style="v" />Karai Kasang a mungdan lam, hkaw dan ai hte, Madu Yesu Hkristu hte seng ai lam hpe nden ja ai myit hte sharin shaga nga nna, kadai mung shi hpe hkum shadang ai n rai.
  </para>
</usx>
