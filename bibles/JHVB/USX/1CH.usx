<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">1 Hkawhkam Labau</book>
  <para style="h">1 Hkawhkam Labau</para>
  <para style="toc1">1 Hkawhkam Labau</para>
  <para style="toc2">1 Hkawhkam Labau</para>
  <para style="mt">1 Hkawhkam Labau</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam, Shet, Enusha;
  </para>
  <para style="p">
    <verse number="2" style="v" />Kenan, Mahalela, Yared;
  </para>
  <para style="p">
    <verse number="3" style="v" />Enuk, Mahtusala, Lamek;
  </para>
  <para style="p">
    <verse number="4" style="v" />Noa, Shem, Ham, Yahpet hte rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yahpet a shadang sha ni gaw, Goma, Magoga, Madai, Yawan, Htubala, Meshek, Htira hte rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Goma a shadang sha ni gaw, Ashkena, Rihpat, Htugama hte rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yawan a shadang sha ni gaw, Elisha, Tarshi, Kihtim, Dodanim hte rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ham a shadang sha ni gaw, Hkusha, Mizra-im, Hput, Hkanan hte rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkusha a shadang sha ni gaw, Seba, Hawila, Saphta, Rama, Sabhtahka hte rai ma ai. Rama a shadang sha gaw Sheba yan Dedan rai ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkusha gaw Nimrod hpe mung shaprat wu ai; dai wa gaw ga ntsa e kaba hpang ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mizra-im gaw Ludim, Anamim, Lehabim, Naphtuhim.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hpahtrusim, Hkasluhim, Hkaphturim amyu ni hpe shaprat wu ai: Hpiliste masha ni gaw Hkasluhim amyu hta na rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkanan gaw shi a kasha alat Sidon hte Het,
  </para>
  <para style="p">
    <verse number="14" style="v" />Yebusi, Amori, Girgashi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiwi, Arki, Sini;
  </para>
  <para style="p">
    <verse number="16" style="v" />Arwadi, Zimari, Hamahti amyu ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shem a shadang sha ni gaw, Elam, Ashura, Arhpaza, Luda, Aram, Uza, Hula, Gehta, Meshek hte rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Arhpaza gaw Shela hpe shaprat wu ai; Shela gaw Ebera hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ebera mung shadang sha lahkawng shaprat wu ai: Langai wa a amying gaw Hpelek rai lu ai: kaning rai nme law, dai wa a prat e lamu ga hpe karan la ma ai; kanau wa a amying gaw Yoktan rai lu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yoktan gaw, Almoda, Shalep, Hazarmawet, Yerak;
  </para>
  <para style="p">
    <verse number="21" style="v" />Hadoram, Uzala, Dikla;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ebala, Abimela, Sheba,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ohpira, Hawila, Yoba hte hpe shaprat wu ai: ndai hte mahkra gaw Yoktan a shadang sha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shem, Arhpaza, Shela;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ebera, Hpelek, Reu;
  </para>
  <para style="p">
    <verse number="26" style="v" />Seruk, Nahura, Htera,
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham ngu ai Abram rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham a shadang sha yan gaw, Isak hte Ishmaela rai ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Da ndai gaw shanhte a lakung lama ni rai nga ma ai: Ishmaela a kasha la hpunglat gaw Nabaiyut: dai kaw nna Kedara, Adebela, Mibsam;
  </para>
  <para style="p">
    <verse number="30" style="v" />Mishma, Duma, Masa, Hadad, Tema;
  </para>
  <para style="p">
    <verse number="31" style="v" />Yetura, Nahpisha, Kedma rai ma ai. Dai hte gaw Ishmaela a kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bai Abraham a lashi num Ketura a kashu kasha ni gaw, Zimran, Yokshan, Medan, Midian, Yishbak, Shua hte rai ma ai. Yokshan a kasha yan gaw Sheba hte Dedan rai ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Midian a kasha ni gaw, Ehpa, Epera, Hanuk, Abida, Eleda hte rai ma ai: dai hte yawng Ketura kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bai Abraham gaw Isak hpe shaprat wu ai. Isak a kasha yan gaw, Esaw hte Israela rai ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Esaw a shadang sha ni gaw, Elihpa, Reuela, Yeusa, Yalam, Kora hte rai ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Elihpa a shadang sha ni gaw, Hteman, Umara, Tsehpi, Gahtam, Keneza, Htimna, Amalek hte rai ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuela shadang sha ni gaw, Nahat, Zera, Shama, Miza hte rai ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Seira a shadang sha ni gaw, Lotan, Shobala, Zibeun, Ana, Dishon, Ezera, Dishan hte rai ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lotan a shadang sha yan gaw Hori hte Homam hte rai ma ai; Lotan a kajan gaw Htimna rai lu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shobala a shadang sha ni gaw, Alian, Manahat, Ebala, Shehpi, Unam hte rai ma ai. Zibeun a shadang sha yan gaw, Aya hte Ana rai ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ana a kasha gaw Dishon rai lu ai. Dishon a shadang sha ni gaw, Hamran, Eshban, Yitran, Hkeran hte rai ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ezera a shadang sha ni gaw, Bilahan, Zawan, Yakan hte rai ma ai. Dishan a shadang sha yan gaw Uza hte Aran rai ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Da ndai gaw Israela kashu kasha ni hta hkawhkam garai n nga yang, Edom mung e up ai hkawhkam ni rai nga ma ai. Beora a kasha Bela gaw hkaw dung nna, shi a mare a amying gaw Dinhaba rai lu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bela si mat nna, Bozra mare na Zera a kasha Yoba gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Yoba si mat yang, Hteman mung na Husham gaw shi a malai shang dung wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Husham si mat yang, Moba pa ga e Midian masha ni hpe gasat kau ai Bedada a kasha Hadad gaw, shi a aya hta shang dung wu ai: shi a mare a amying gaw Awit rai lu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hadad si mat yang, Masreka shara na Samla gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Samla si mat nna, dai hka makau e nga ai Rehubut shara na Sha-ula gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Sha-ula si mat nna, Akbura a kasha Bala-hanan gaw shi a aya hta shang dung wu ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Bala- hanan si mat nna, Hadad gaw shi a aya hta shang dung wu ai: shi a mare a amying gaw Pai ngu ai rai lu ai; shi a madu jan a amying gaw Mehetabela rai nga ai: shi gaw Mezahaba a kasha Matreda a shayi sha rai nga ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ya Hadad mung si mat sai. Edom mung a du ni gaw ndai hte rai nga ma ai: du Htimna, du Alia, du Yehtet;
  </para>
  <para style="p">
    <verse number="52" style="v" />du Oholibama, du Ela, du Pinon;
  </para>
  <para style="p">
    <verse number="53" style="v" />du Kena, du Hteman, du Mibzara;
  </para>
  <para style="p">
    <verse number="54" style="v" />du Magdiela, du Iram hte rai ma ai. Dai ni gaw Edom mung na du ni rai nga ma ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela a shadang sha ni gaw, Rubin, Simun, Lewi, Yuda, Yisahka, Zebulun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Dan, Yawsep, Ben-yamin, Naphtali, Gad, Ashe hte rai ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yuda a shadang sha ni gaw, Era, Onan, Shela hte rai ma ai: dai masum gaw Hkanan num Shua hta shaprat ai rai ma ai. Yuda a kasha alat Era gaw Yehowa man e n hkru nga ai rai nna, Yehowa shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a kanam Htama gaw shi a matu Hparet yan Zerak hpe shaprat wu ai. Yuda a kasha ni yawng marai manga rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hparet kasha yan gaw, Hezron hte Hamula rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerak a shadang sha ni gaw, Zimri, Ehtan, Heman, Hkalakola, Dara hte rai ma ai; yawng gaw marai manga rai nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkarmi a kasha Ahkara rai nga ai: shi gaw dai majai kau ai rai ni hpe lagu la wu ai rai nna, Israela amyu hpe sharu shatsang kau wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Ehtan a kasha gaw Azaria rai lu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hezron shaprat ai shadang sha ni gaw, Yeramela, Ram, Hkelubai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ram gaw Aminada hpe shaprat wu ai: Aminada gaw Yuda kashu kasha ni a du Nasun hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nasun gaw Salma hpe shaprat wu ai; Salma gaw Bua hpe shaprat wu ai;
  </para>
  <para style="p">
    <verse number="12" style="v" />Bua gaw Obed shaprat wu ai; Obed gaw Yese hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yese gaw shi a kasha alat Eliaba, lahkawng ngu na Abinadab, masum ngu na Shima,
  </para>
  <para style="p">
    <verse number="14" style="v" />mali ngu na Nahtanela, manga ngu na Radai;
  </para>
  <para style="p">
    <verse number="15" style="v" />kru ngu na Ozem, sanit ngu na Dawi hpe shaprat wu ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />shanhte a kajan yan gaw, Zeruia hte Abigala rai nga ma ai. Zeruia shadang sha ni gaw, Abishai, Yoba, Asahela hte rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abigala gaw Amasa hpe shaprat wu ai: Amasa a kawa gaw Ishmaela amyu Yehtera rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai Hezron a kasha Hkaleb gaw, shi a madu jan Azuba hta Yeriot hpe shaprat wu ai; shi a kasha ni gaw Yeshera, Shoba, Ardon hte rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Azuba si mat ai hpang, Hkaleb gaw Ehprat hpe la nna, Hura hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hura gaw Uri hpe, Uri gaw Bezalela hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang Hezron gaw asak kru shi ning du sayang, Gilead a kawa Mahkira a shayi sha kaw shang nhtawm, shi hpe la nna, shi gaw Seguba hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seguba gaw Ya-ira hpe shaprat wu ai: dai wa gaw, Gilead mung hta e mare hkun masum hte hpe up nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai Geshura yan Aram gaw Kenat hte hpawn, Ya-ira mare ni hte kahtawng kru shi kashun la mu ai. Dai hte yawng gaw Gilead kawa a Mahkira a kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ya Hezron gaw Hkaleb-ehprahta e si mat ai hpang, Hezron a madu jan Abiya gaw Tekoa kawa Ashura hpe shangai wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai Hezron a kasha alat Yeramela shadang sha ni gaw, kasha alat Ram hte Buna. Oren, Ozem, Ahiya hte rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yeramela gaw Atara mying ai kaga madu jan mung lu ai rai nna, shi gaw Onam a kanu rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai Yeramela a kasha alat Ram a shadang sha ni gaw Maza, Yamin, Ekera hte rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Onam a shadang sha yan gaw Shamai hte Yada rai ma ai. Shamai a shadang sha yan gaw Nadab hte Abishura rai ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abishura a madu jan a amying gaw Abihala rai lu ai; shi gaw kasha Aban hte Molid hpe shangai wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nadab a kasha yan gaw Seled hte Apa-im, Seled chyawm gaw kasha n kap ai si mat sai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Apa-im a kasha Ishi: Ishi a kasha Sheshan: Sheshan a kasha Alai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shamai a kanau Yada a shadang sha yan gaw, Yehtera hte Yonahtan rai ma ai; Yehtera chyawm gaw kasha n kap ai si mat sai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yonahtan a kasha yan gaw, Pelet hte Zaza rai ma ai. Dai ni gaw Yeramela a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sheshan chyawm gaw shadang sha n lu ai, shayi sha hkrai rai lu ai. Bai Sheshan gaw Yara mying ai Egutu mung na mayam la langai mi lu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sheshan gaw shi a mayam Yara hpe, shi a shayi sha ya wu ai rai n na, shi gaw kawa a matu Atai hpe shangai wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Atai gaw Nahtan hpe shaprat wu ai; Nahtan gaw Zabad hpe shaprat wu ai;
  </para>
  <para style="p">
    <verse number="37" style="v" />Zabad gaw Epla shaprat wu ai; Epla gaw Obed hpe shaprat wu ai;
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed gaw Yehu hpe shaprat wu ai. Yehu gaw Azaria hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Azaria gaw Hele hpe shaprat wu ai. Hele gaw Eleasa hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Eleasa gaw Sismai hpe shaprat wu ai; Sismai gaw Shalum hpe shaprat wu ai;
  </para>
  <para style="p">
    <verse number="41" style="v" />Shalum gaw Yekamia hpe shaprat wu ai; Yekamia gaw Elishama hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Bai Yeramela a kanau Hkaleb a shadang sha ni gaw, shi a kasha alat Zihpa a kawa Mesha hte, Hebron a kawa Maresha a kasha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hebron a shadang sha ni gaw, Kora, Tapua, Rekem, Shema hte rai ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shema gaw Yorkeam a kawa Raham hpe shaprat wu ai; Rekem gaw Shamai hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Bai Maon gaw Shamai a kasha rai nga ai; Maon mung Bet-zura a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hkaleb a lashi num Ehpa gaw, Haran, Moza, Gaze hte hpe shangai wu ai; bai Haram gaw Gaze hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Bai Yadai a shadang sha ni gaw, Regem, Yohtan, Geshan, Pelet, Ehpa, Shahpa hte rai ma ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hkaleb a lashi num Mahka gaw, Shebera yan Tirhana hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Dai hta kaga shi gaw, Madmana a kawa Shahpa Makbena yan Gibea a kawa Shewa hpe mung shaprat wu ai: Hkaleb a shayi sha gaw Aksa rai nga ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Da ndai gaw Ehprahta a kasha alat Hura a kasha Hkaleb a shadang sha ni rai nga ma ai: Kiriat-yarim a kawa Shobala;
  </para>
  <para style="p">
    <verse number="51" style="v" />Betlehem a kawa salma; Bet-gadera a kawa Harep hte rai ma ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Bai Kiriat-yarim kawa Shobala a kasha yan gaw, Haroe ngu ai Menuhot chyen mi up nga ma ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Bai Kiriat-yarim a lakung lama ni gaw, Ihtri masha ni, Puhti masha ni, Shumahti masha ni Mishrai masha ni rai ma ai; dai ni hta nna Zorahti masha ni hte Eshtaoli masha ni pru ma ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Salma a kashu kasha ni gaw, Betlehem hte Netohpa, Atrot-bet-yoba hte Zori ngu ai, Manahati amyu chyen mi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Bai Yabet mare e nga ai laika ka ai amyu ni gaw, Tirahti, Shimehti, Suhkahti ni rai ma ai. Dai ni gaw Rehkab dap ni a kawa, Hamat kaw nna karan wa ai, Keni amyu masha ni rai ma ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Da ndai gaw Hebron mare e shangai ai Dawi a shadang sha ni rai ma ai: Yezrela num Ahinoam, kasha alat Amanon; lahkawng ngu na, Hkarmela num Abigala a kasha Daniela;
  </para>
  <para style="p">
    <verse number="2" style="v" />masum ngu na, Geshura hkawhkam Talamai a shayi sha Mahka a kasha Absalom; mali ngu na Hagit a kasha Adoniya;
  </para>
  <para style="p">
    <verse number="3" style="v" />manga ngu na, Abitala a kasha Shehpati; kru ngu na, shi a numdung jan Egla a kasha Itream hte rai ma ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />Hebron mare hta e shi a kasha kru hte hpe shaprat wu ai: shi gaw dai yang e sanit ning e shata kru up wu ai; Yerusalem mare hta e sumshi masum ning up nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yerusalem e shaprat ai shi a kasha ni gaw, Shimea, Shoba, Nahtan, Shawlumon; dai mali gaw Amiela a shayi sha Bat-shua hta shaprat ai rai ma ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hta kaga, Iba, Elishama, Elihpelet
  </para>
  <para style="p">
    <verse number="7" style="v" />Noga, Nehpeg, Yahpia.
  </para>
  <para style="p">
    <verse number="8" style="v" />Elishama, Eliada, Elihpelet ngu na jahku rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Da ndai yawng, lashi num ni a shadang sha ni n tsun ai, Dawi a shadang sha ni hkrai rai nga ma ai: shanhte a kajan gaw Htama rai malu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Shawlumon a kasha Rehoboam; Rehoboam a kasha Abiya; Abiya a kasha Asa; Asa a kasha Yehosahpat;
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehosahpat a kasha Yoram; Yoram a kasha Ahazia; Ahazia a kasha Yosha;
  </para>
  <para style="p">
    <verse number="12" style="v" />Yosha a kasha Amazia; Amazia a kasha Azaria; Azaria a kasha Yohtam
  </para>
  <para style="p">
    <verse number="13" style="v" />Yohtam a kasha Ahaza; Ahaza a kasha Hezekia; Hezekia a kasha Manashe;
  </para>
  <para style="p">
    <verse number="14" style="v" />Manashe a kasha Amon; Amon a kasha Yoshia rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yoshia shadang sha ni gaw, kasha alat Yohanan; lahkawng ngu na Yehoiakim; masum nga na, Zedekia; mali ngu na Shalum hte rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehoiakim a kasha yan gaw, Yehkonia hte Zedekia rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bawng dung hkrum ai Yehkonia shadang sha ni gaw Shalatela,
  </para>
  <para style="p">
    <verse number="18" style="v" />Malhkiram, Pedaia, Shenaza, Yekamia, Hoshama, Nedabia hte rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pedaia a shadang sha yan gaw, Zerubabela hte Shime rai ma ai. Zerubabela shadang sha ni gaw Meshulam yan Hanania; bai,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hashuba, Ohela, Berehkia, Hasadia, Yushabhesed, manga ngu na, rai ma ai: shanhte a kajan gaw Shelomit rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hanania shadang sha yan gaw, Pelati hte Yeshaia rai ma ai. Yeshaia kasha Rehpaia; Rehpaia kasha Arnan; Arnan a kasha Obadia; Obadia kasha Shehkania;
  </para>
  <para style="p">
    <verse number="22" style="v" />Shehkania a kasha Shemaia rai nga ai. Shemaia shadang sha ni gaw, Hatu, Igala, Baria, Naria, Shahpat: dai gaw kru rai nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai Naria shadang sha ni gaw, Elionai, Hizkia, Azrikam; yawng masum rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Elionai a shadang sha ni gaw, Hodawia, Eliashib, Pelaia, Akub, Yohanan, Delaia, Anani, yawng marai sanit rai ma ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yuda a shadang sha ni gaw, Hparet, Hezron, Hkarmi, Hura, Shobala hte rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shobala a kasha Reaia gaw Yahat hpe shaprat wu ai. Yahat gaw Ahumai yan Lahad hpe shaprat wu ai. Da ndai gaw Zorahti dap ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai, dai ni gaw Etam a kawa a kashu kasha ni rai nga ma ai: Yezrela, Ishma, Idbash hte shanhte a kajan Hazeleponi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Gedora kawa Penuela; Husha a kawa Ezera hte rai ma ai: dai ni gaw, Betlehem a kawa Ehprahta a kasha alat Hura a dap ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tekoa a kawa Ashura gaw, Hela hte Nara mying ai num lahkawng lu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nara a kasha ni gaw, Ahuzam, Hehpera, Temeni, Hashtari hte rai ma ai. Dai ni gaw Nara a kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hela a kasha ni gaw, Zeret, Izhara, Etnan hte rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Hakoza gaw, Anub yan Zobeba hte Harum a kasha Ahazela a dap ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yabet gaw shi a kahpu kanau ni hta arawng grau lu nga ai: shi a kanu gaw, “Yawn hkyen hkrum let ngai shi hpe shaprat se ai,” nga nna Yabet shamying wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yabet mung, Israela Karai Kasang hpe, “Nang ngai hpe shaman ya nna, nye a lamu ga jarit dam lada di ya e! Ngai yawn hkyen ai hta lawt lu n ga na a lahpum hte n hkru n hkra ai hta na ngai hpe magawp maga la e!” ngu nna hpyi jahtau wu ai. Karai Kasang mung shi hpyi ai ga madat mara ya wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Shupa kanau Hkelub gaw Eshton a kawa Mehira hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eshton gaw, Bet-rahpa, Pasea, Irnahasa a kawa Tehina hpe shaprat wu ai. Dai ni gaw Rehka amyu ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kenaza a shadang sha yan gaw, Otniela hte Seraia rai ma ai. Otniela a kasha gaw Hahtat rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai Meonohtai gaw Ohpra hpe shaprat wu ai; Seraia gaw Ge-harashim a kawa Yoba hpe shaprat wu ai: shanhte gaw laksama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Yehpuna a kasha Hkaleb a shadang sha ni gaw, Iru, Ela, Na-an hte rai ma ai: Ela yan Kenaza mung kasha lu ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehalela shadang sha ni gaw, Zip, Zihpa, Tiria, Asarela hte rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ezra a shadang sha ni gaw, Yehtera, Mered, Ehpera, Yalon hte rai ma ai: Mered a madu jan Miriam, Shamai hte Eshtemoa a kawa Ishba hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai shi a madu jan Yuda num gaw, Gedora kawa Yered, Sohko a kawa Hebera, Zanoa kawa Yekuhtila hpe shaprat wu ai. Dai ni gaw Mered la ai Hpara-u a shayi sha Bihtia a kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bai Nahan a kajan, Hodia madu jan a kasha ni gaw, Garmi masha Keila a kawa hte Mahkahti masha Eshtemoa rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shimon a shadang sha ni gaw, Amnon, Rina, Benhanan, Tilon hte rai ma ai. Ishi a shadang sha yan gaw Zohet hte Ben-zohet rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yuda a kasha Shela a shadang sha ni gaw, Lehka a kawa Era. Maresha a kawa Lada hte, mani ai lachyit sumpan chye da ai Ashbea dap ni hte,
  </para>
  <para style="p">
    <verse number="22" style="v" />Yokim, Hkozeba amyu masha ni, Yoasha hte Moba ga hte Yashubi-lehem up ai Sarap hte rai ma ai: gawn da ai labau ga gaw, moi na ga rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shanhte gaw dibu sama ni hte, Netim e, Gedera e dung nga ai ni rai nga ma ai: shanhte makan galaw let, hkawhkam wa hte rau dai yang e nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simun a shadang sha ni gaw, Nemuela, Yamin, Yarib, Zera, Sha-ula hte rai ma ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />Sha-ula a kasha Shalum; Shalum a kasha Mibsan; Mibsan a kasha Mishma, rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mishma a kasha ni gaw Hamula, Zahkura, Shime hte rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shime gaw shadang sha shi kru hte shayi sha kru hte hpe shaprat wu ai: shi a kanau ni chyawm gaw kasha law law n lu ma ai hte, Yuda kashu kasha ni zawn mayat maya ma ai n rai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw Berasheba, Molada, Haza-shuala,
  </para>
  <para style="p">
    <verse number="29" style="v" />Bela, Ezem, Tolad,
  </para>
  <para style="p">
    <verse number="30" style="v" />Behtuela, Horma, Ziklag,
  </para>
  <para style="p">
    <verse number="31" style="v" />Bet-marhkabot, Hazarasusim, Bet-biri hte Sharim mare ni hta nga nga ma ai. Dai mare ni gaw Dawi hkaw dung ai prat du hkra shanhte a mare ni rai nga malu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shanhte a kahtawng ni gaw, Etam, A-in, Rimon, Tohken, Ashan hte rai malu ai: dai gaw mare manga rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai mare ni a grup yin na kahtawng ni mahkra hpe mung, Bala du hkra, up nga ma ai. Dai gaw shanhte a buga hte, shanhte a ahtik labau rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Meshoba, Yamlek, Amazia a kasha Yosha;
  </para>
  <para style="p">
    <verse number="35" style="v" />Yoela, Yoshibia a kasha Yehu; shi a kaji Seraia, shi a kawa Asiela;
  </para>
  <para style="p">
    <verse number="36" style="v" />Elionai, Yakoba, Yeshohaia, Asaia, Adeila, Yesimela, Benaia;
  </para>
  <para style="p">
    <verse number="37" style="v" />Shihpi a kasha Ziza, shi a kaji Alon, shi a kawa Yedaia, shi a kawa Shimri, shi a kawa Shemaia
  </para>
  <para style="p">
    <verse number="38" style="v" />ngu ai hte gaw tinang a dap ni hta du hkrai rai nga ma ai: shanhte a kaji kawa dap ni gaw, grai wa mayat maya wa ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ya shanhte gaw Gedora du hkra, kadit a sinpraw maga hku, shanhte a yamnga ni a matu udat shara tam let, hkawm wa ma ai rai nna,
  </para>
  <para style="p">
    <verse number="40" style="v" />dam lada, tsit lali, pyaw ai udat shara mu hkrup mu ai; hpyen majan mung n hkrum ma ai: kaning rai nme law, Ham a kashu kasha ni dai shara e shawng de nga nga ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Laika hta amying ka da ai ni gaw, Yuda hkawhkam Hezekia aprat e sa du nna, shanhte a sum ni hte shanhte hte rau nga ai Meunim masha ni hpe dai ni du hkra atsai awai shaza kau nhtawm, shanhte a shara hta shang nga nga ma ai: kaning rai nme law, shanhte a yamnga ni a matu dai yang e udat shara tsawm nga malu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Bai, Simun a kashu kasha ni, marai manga tsa hte gaw, Ishi a kasha ni Pelatia, Nearia, Rehpaia, Uziela hte hpe du shatai nna, Seira bum de shang nga let,
  </para>
  <para style="p">
    <verse number="43" style="v" />naw ngam nga ai Amalek masha ni hpe sat kau nhtawm, dai ni du hkra dai yang e nga nga ma ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rubin gaw Israela a kasha alat rai nga ai: rai timung, kawa a yup ku hpe awu asin di kau wu ai majaw, hpu lat aya gaw Israela a kasha Yawsep hpe jaw kau wu ai rai nna, ahtik labau laika gaw hpu lat aya hku hkan wu ai n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, Yuda gaw kahpu ni a ntsa e kaba wa ai rai nna, du gaw shi kaw nna pru wa ai: hpu lat aya chyawm gaw Yawsep hte seng nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya, Israela a kasha alat Rubin a shadang sha ni gaw, Hanuk, Hpalu, Hezron, Hkarmi hte rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Yoela a shadang sha ni gaw, Shemaia, shi a kasha Goga, shi a kasha Shime;
  </para>
  <para style="p">
    <verse number="5" style="v" />shi a kasha Mihka, shi a kasha Reaia, shi a kasha Bala;
  </para>
  <para style="p">
    <verse number="6" style="v" />shi a kasha Bera hte rai ma ai: dai Bera hpe Asuri hkawhkam Tilgat-pilnese bawng rim wa wu ai: shi gaw Rubin dap a du rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a kanau ni a ahtik labau laika ni prat mi hte prat mi gawn yu yang, du Yeila hte Zehkaria rai nga ma ai;
  </para>
  <para style="p">
    <verse number="8" style="v" />Azaza a kasha Bela mung rai nga ai; Azaza gaw Shema a kasha; Shema gaw Yoela a kasha; shi gaw Nebo kaw nna Bala-meon du hkra dam ai Aroera e dung nga ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />sinpraw maga de ang wa yang, shi gaw Uhprat hka nam mali lam du hkra up nga ai; kaning rai nme law, shanhte a yamnga ni gaw Gilead mung hta e law htam wa malu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai shanhte gaw Shawlu a aprat e Hagara masha ni hpe gasat dang kau nhtawm, Geliad mung na sinpraw maga de na, shanhte a sum ni hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai, Gad a kashu kasha ni gaw, Saleka mung du hkra shanhte a tawtap e, Bashan mung hta e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yoela gaw du rai nga ai; shi a lawu e Shahpam; Yanai, Bashan mung na Shahpat hte rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />shanhte a kawa a aru arat ni gaw, Mihkaela, Meshulam, Sheba, Yorai, Yahkan, Zia, Ebera hte, sanit ngu na, rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte gaw, Guni, Abdiela, Ahi, Buza, Yado, Yeshishai
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihkaela, Gilead, Yaroa, Huri, Abihala dap lakung ni rai nga ma ai: Guni gaw shanhte a du rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte gaw Gilead mung, Bashan mung, Sharon ginwang lamu ga jarit du hkra, tinang a mare kahtawng ni hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte a ahtik labau gawn ai laika gaw, Yuda a hkawhkam Yohtam hte Israela hkawhkam Yeroboam a lakhtak du hkra gawn da nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya Rubin amyu, Gad amyu hte Manashe amyu chyen mi hta na, n-gang lang ai hte nhtu hpye nna, ndan chye gap ai hte hpyen majan amu galaw ram ai nden ja ai wa-ngan mun mali hkying mali sanit tsa kru shi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw Hagara amyu ngu ai, Yetura, Nahpisha, Nodab hte gasat ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shanhte gasat nga ma yang, Karai Kasang hpe hpyi jahtau let, shi hpe tawngban ai hte shi hta shamyet shanat nga ma ai majaw, shanhte karum ai lu la nna, Hagara masha ni hte shanhte hte rau rai nga ai yawng hte hpe rim la lu mu ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />shanhte a yamnga hpung ni hpe mung, shanhte a gawla-uk mun manga, sagu bainam sen lahkawng mun manga hte, lawze hkying lahkawng, masha sen mi hpe mung, hkap rim la mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hpyen majan gaw Karai Kasang kaw na rai nga ai majaw, masha law law wa kataw si mat ma ai. Israela masha ni mung bawng dung ai aten du hkra, Hagara masha ni a shara e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai Manashe amyu chyen mi gaw, dai mung hta e nga nga nna, Bashan mung kaw nna, Bala-hermon, Senira hte Hermon bum du hkra law htam wa ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte a amyu dap ni hta baw rai nga ai ni gaw, Ehpera, Ishi Eliela, Azriela, Yeremia, Hodawia, Yadiela hte rai ma ai: shanhte gaw nden ja ai share ni hte tinang amyu dap ni a kajai gumhkawng ai baw ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rai timung, shanhte gaw tinang a kaji kawa ni a Karai Kasang hpe n madat nga ma ai rai nna, Karai Kasang gaw shanhte a man e shaza kau ai mung masha ni a hpara ni hte shut hpyit ai amu galaw nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai rai nna Israela Karai Kasang gaw Asuri hkawhkam Pula hte Tilgat-pilnese yan a myit hpe sharawt ya wu ai rai nna, Tilgat-pilnese gaw Rubin amyu Gad amyu, Manashe amyu chyen mi hpe bawng rim wa nna, shanhte hpe dai ni du hkra, Hala, Habora, Hara hte Gozan hka kau e bawng dung shangun mu ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lewi a shadang sha ni gaw, Gershon, Kohat, Merari hte rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kohat a shadang sha ni gaw, Amram, Izhara, Hebron, Uziela hte rai nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amram a kashu kasha ni gaw, Arun, Mawshe, Miriam hte rai ma ai. Arun a shadang sha ni gaw, Nadab, Abihu, Eleaza, Ihtama hte rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eleaza gaw Hpinehasa hpe shaprat wu ai; Hpinehasa gaw Abishua hpe shaprat wu ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Abishua gaw Buki, Buki gaw Uzi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Uzi gaw Zerahia, Zerahia gaw Meraiot.
  </para>
  <para style="p">
    <verse number="7" style="v" />Meraiot gaw Amaria; Amaria gaw Ahitob,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahitob gaw Zadok; Zadok gaw Ahimaza;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahimaza gaw Azaria, Azaria gaw Yohanan;
  </para>
  <para style="p">
    <verse number="10" style="v" />Yohanan gaw, Yerusalem mare na Shawlumon galaw da ai nta hkinjawng amu galaw ai Azaria hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Azria gaw Amaria, Amaria gaw Ahitob.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahitob gaw Zadok, Zadok gaw Shalum;
  </para>
  <para style="p">
    <verse number="13" style="v" />Shalum gaw Hilkia, Hilkia gaw Azaria:
  </para>
  <para style="p">
    <verse number="14" style="v" />Azaria gaw Seraia, Seraia gaw Yehozadek hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa gaw Yuda hte Yerusalem masha ni hpe Nebuhkadneza a lata hte rim woi wa ai shaloi e Yehozadek mung bawng dung lawm nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lewi a shadang sha ni gaw, Gershom, Kohat, Merari hte rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Da ndai gaw Gershom a shadang sha yan a amying rai nga ai: Libni hte Shime rai ma ai,
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohat a shadang sha ni gaw, Amram, Izhara, Hebron, Uziela hte rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari a shadang sha yan gaw Marali hte Mushi rai ma ai. Dai ndai gaw Lewi amyu a dap lakung ni rai nga ma ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />Gershom a dap ni: shi a kasha Libni a kasha Yahat, Yahat a kasha Zima;
  </para>
  <para style="p">
    <verse number="21" style="v" />Zima a kasha Yoa; Yoa a kasha Ido, Ido a kasha Zera, Zera a kasha Yeaterai hte rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kohat a shadang sha ni gaw: shi a kasha Aminadab, Aminadab a kasha Kora; Kora a kasha Asira:
  </para>
  <para style="p">
    <verse number="23" style="v" />Asira a kasha Elkana. Elkana a kasha Ebiasap, Ebiasap a kasha Asira;
  </para>
  <para style="p">
    <verse number="24" style="v" />Asira kasha Tahat, Tahat a kasha Uriela, Uriela a kasha Uzia, Uzia a kasha Shawlu hte rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Elkana a shadang sha yan gaw, Amasai hte Ahimot rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Elkana hte shi a kasha ni a ahtik labau gaw: Elkana a kasha Zohpai. Zohpai a kasha Nahat;
  </para>
  <para style="p">
    <verse number="27" style="v" />Nahat a kasha Eliaba; Eliaba kasha Yeroham, Yeroham a kasha Elkana hte rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bai Samuela shadang sha yan gaw, kasha alat Yoela hte shi a kanau Abiya rai ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari a shadang sha ni gaw, shi a kasha Mahali a kasha Libni, Libni a kasha Shime, Shime a kasha Uza.
  </para>
  <para style="p">
    <verse number="30" style="v" />Uza a kasha Shimea, Shimea kasha Hagia, Hagia kasha Asaia rai nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sakse sumpu gaw Yehowa a nta hta sim nga sayang e, Yehowa a nta hta mahkawn mangoi woi na matu. Dawi san tawn da nna san da ai ni rai nga ma ai:
  </para>
  <para style="p">
    <verse number="32" style="v" />Shawlumon gaw Yerusalem mare hta e Yehowa a nta hpe gap da ai nhtoi du hkra, shanhte gaw shawa hpawng a sumpan nta man e mahkawn mangoi woi nga ma ai. Shanhte gaw tinang a ahpung abat hkan nna woi ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mahkawn mangoi woi ai ni hte, shanhte a kashu kasha ni gaw ndai ni rai nga ma ai: Kohat a kashu kasha ni hta mahkawn mangoi woi ai Heman rai nga ai: Heman gaw Yoela kasha, Yoela gaw Samuela kasha;
  </para>
  <para style="p">
    <verse number="34" style="v" />Samuela gaw Elkana a kasha; Elkana gaw Yeroham a kasha; Yeroham gaw Eliela a kasha; Eliela gaw Toa a kasha;
  </para>
  <para style="p">
    <verse number="35" style="v" />Toa gaw Zup a kasha. Zup gaw Elkana a kasha; Elkana gaw Mahat a kasha, Mahat gaw Amasai a kasha;
  </para>
  <para style="p">
    <verse number="36" style="v" />Amasi gaw Elkana a kasha, Elkana gaw Yoela kasha, Yoela gaw Azaria kasha; Azaria gaw Zehpania a kasha; Zehpani gaw Tahat a kasha;
  </para>
  <para style="p">
    <verse number="37" style="v" />Tahat gaw Asira kasha; Asira gaw Ebiasap a kasha; Ebiasap gaw Kora a kasha;
  </para>
  <para style="p">
    <verse number="38" style="v" />Kora gaw Izhara a kasha; Izhara gaw Kohat a kasha; Kohat gaw Lewi a kasha; Lewi gaw Israela a kasha rai nga ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Bai Heman a kanau Asap gaw shi a hkra maga e tsap nga ai: Asap gaw Berehkia kasha; Berehkia gaw Shimea kasha;
  </para>
  <para style="p">
    <verse number="40" style="v" />Shimea gaw Mihkaela kasha; Mihkaela gaw Basea kasha; Basea gaw Malhkiya kasha;
  </para>
  <para style="p">
    <verse number="41" style="v" />Malhkiya gaw Etni kasha; Etni gaw Zera kasha; Zera gaw Adaia kasha;
  </para>
  <para style="p">
    <verse number="42" style="v" />Adaia gaw Ehtan a kasha; Ehtan gaw Zimma kasha; Zimma gaw Shime kasha;
  </para>
  <para style="p">
    <verse number="43" style="v" />Shime gaw Yahat a kasha; Yahat gaw Gershom a kasha; Gershom gaw Lewi a kasha rai nga ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Pai maga de e shanhte a kanau ni Merari a kashu kasha ni rai nga ma ai; Ehtan gaw Kishi a kasha, Kishi gaw Abdi a kasha; Abdi gaw Maluk a kasha;
  </para>
  <para style="p">
    <verse number="45" style="v" />Maluk gaw Hashabia kasha; Hashabia gaw Amazia kasha; Amazia gaw Hilkia kasha, Hilkia gaw Amzia kasha;
  </para>
  <para style="p">
    <verse number="46" style="v" />Amzia gaw Bani a kasha Bani gaw Shemera kasha;
  </para>
  <para style="p">
    <verse number="47" style="v" />Shemera gaw Mahali a kasha; Mahali gaw Mushi a kasha; Mushi gaw Merari a kasha; Merari gaw Lewi a kasha rai nga ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Shanhte a kahpu kanau Lewi masha ni gaw, Karai Kasang a sumpan nta e, daw jau na amu mahkra a matu san da ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Rai timung, Arun hte shi a shadang sha ni chyawm gaw, Karai Kasang a shangun ma Mawshe htet da mada hte maren, chyoi pra htum ai shara amu a nlang hte hte, Israela masha ni a lam htingrai htingrat ya na matu, wan nat hkungga nawng ai hkungri ntsa e mung, manam pyaw ai baw nat nawng ai hkungri ntsa e mung, nat nawng ma ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Da ndai gaw Arun a shadang sha ni gaw: shi a kasha Eleaza; Eleaza a kasha Hpinehasa; Hpinehasa a kasha Abishua;
  </para>
  <para style="p">
    <verse number="51" style="v" />Abishua a kasha Buki; Buki a kasha Uzi; Uzi a kasha Zerahi;
  </para>
  <para style="p">
    <verse number="52" style="v" />Zerahi a kasha Meraiot, Meraiot a kasha Amaria; Amaria a kasha Ahitob;
  </para>
  <para style="p">
    <verse number="53" style="v" />Ahitob a kasha Zadok; Zadok a kasha Ahimaza rai nga ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Da ndai gaw shanhte a lamu ga jarit na nga nga shara hte dabang ni rai nga malu ai: Arun a kasha Kohat a dap lakung ni a matu lata san tawn da ai lamu ga gaw:
  </para>
  <para style="p">
    <verse number="55" style="v" />Yuda mung na Hebron mare hte de a ginwang ga shanhte hpe jaw mu ai:
  </para>
  <para style="p">
    <verse number="56" style="v" />rai timung mare na yi hkauna ni hte grup yin na kahtawng ni hpe Yehpuna a kasha Hkaleb hpe jaw da mu ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Bai shanhte gaw Arun a kashu kasha ni hpe shingbyi nga na mare ni ap ya mu ai: Hebron, Libna hte de a ginwang ga; Yatira, Eshtemoa hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="58" style="v" />Hilen hte de a ginwang ga; Debira hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="59" style="v" />Ashan hte de a ginwang ga; Bet-sheme hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="60" style="v" />Ben-yamin amyu lamu ga hta na, Geba hte de a ginwang ga; Alemet hte de a ginwang ga; Anahtot hte de a ginwang ga rai malu ai; shing rai shanhte a dap lakung hkan nna, madu nga ai mare ni yawng, shi masum rai nga malu ai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Naw ngam nga ai Kohat a kashu kasha dap lakung ni hpe, Manashe amyu chyen mi a lamu ga hta na, mare shi hpe, hpaida da ai hte jaw da mu ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Gershom kashu kasha lakung lama hkan nna, Yishahka amyu hta na, Ashe amyu hta na, Naphtali amyu hta na, Bashan mung na Manashe amyu hta na mare shi masum hte hpe jaw da mu ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Bai Merari kashu kasha dap lakung ni hpe, hpai da hte, Rubin amyu hta na, Gad amyu hta na, Zebulun amyu hta na mare shi lahkawng hte hpe jaw da mu ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Israela masha ni gaw dai mare ni hte de a ginwang ga ni hpe Lewi masha ni hpe jaw da mu ai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Dai hta kaga shanhte gaw, Yuda kashu kasha ni a amyu hta na, Simun kashu kasha ni a amyu hta na, Ben-yamin kashu kasha ni a amyu hta na, lahta de tsun da sai mare ni hpe, hpaida da ai hte jaw kau mu ai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kohat a kashu kasha ni a dap lakung ni nkau mi gaw, Ehprim a lamu ga hta e san da ai mare ni hpe madu lu ma ai: shanhte gaw shingbyi nga na mare ni hpe ap ya mu ai:
  </para>
  <para style="p">
    <verse number="67" style="v" />Ehprim bum ga na Shehkem mare hte de a ginwang ga: Gezera mare hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="68" style="v" />Yokmeam hte de a ginwang ga; Bet-horon hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="69" style="v" />Aiyalon hte de a ginwang ga; Gat-rimon hte de a ginwang ga, rai nga ai.
  </para>
  <para style="p">
    <verse number="70" style="v" />Naw ngam nga ai Kohat kashu kasha ni a lakung lama ni a matu, Manashe amyu chyen mi hta na, Anera hte de a ginwang ga; Bileam hte de a ginwang ga ni hpe jaw da mu ai.
  </para>
  <para style="p">
    <verse number="71" style="v" />Ya Gershom a kashu kasha ni gaw Manashe amyu chyen mi hta na, Bashan mung na Golan hte de a ginwang ga; Ashtarat hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="72" style="v" />bai, Yisahka amyu hta na, Kedesha hte de a ginwang ga; Daberat hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="73" style="v" />Ramot hte de a ginwang ga; Anem hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="74" style="v" />bai, Ashe amyu hta na, Mashala hte de a ginwang ga, Abdon hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="75" style="v" />Hukok hte de a ginwang ga, Rehob hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="76" style="v" />bai, Naphtali amyu hta na Galile mung na Kadesha hte de a ginwang ga, Hamon hte de a ginwang ga; Kiriahtim hte de a ginwang ga ni hpe, jaw mu ai.
  </para>
  <para style="p">
    <verse number="77" style="v" />Naw ngam nga ai Merari a kashu kasha ni hpe mung, Zebulun amyu hta na, Rimo hte de a ginwang ga, Tabora hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="78" style="v" />bai, Yerihko mare a sinpraw maga, Yawdan hka wora hkran na Rubin amyu hta na, nam maling na Bezera hte de a ginwang ga, Yaza hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="79" style="v" />Kedemot hte de a ginwang ga, Mehpat hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="80" style="v" />bai, Gad a amyu hta na, Gilead mung na Ramot hte de a ginwang ga, Mahanim hte de a ginwang ga;
  </para>
  <para style="p">
    <verse number="81" style="v" />Heshbon hte de a ginwang ga, Yazera hte de a ginwang ga ni hpe jaw da mu ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yisahka shadang sha ni gaw, Htola, Hpua, Yashub, Shimron, yawng marai mali rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Htola a shadang sha ni gaw Uzi, Rehpaia, Yeriela, Yamai, Ibsam, Shemuela hte rai ma ai; dai ni gaw tinang adap lakung ni hta du rai nga ai hte, tinang a prat hta e nden ja ai share ni rai nga ma ai: shanhte gaw Dawi a aprat e mun lahkawng, hkying lahkawng kru tsa law nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uzi a shadang sha gaw, Izrahia; Izrahia shadang sha ni gaw, Mihkaela, Obadia, Yoela, Ishia; shanhte marai manga rai ma ai hte, yawng gaw masha kaba rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte hta madu jan ni hte kasha ni law nga ma ai majaw, shanhte gaw kawa ni a dap lakung hkan nna, hpyen luksuk ni mun masum hkying kru rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yisahka dap lakung ni mahkra hta, shanhte a kahpu kanau ni ngu ai, nden ja ai share ni yawng hpe hti yu yang, marai mun matsat hkying sanit rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai, Ben-yamin shadang sha ni gaw, Bela, Behkara, Yediela, marai masum rai nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bela shadang sha ni gaw, Ezbon, Uzi, Uziela, Yerimot, Iri, marai manga rai ma ai: shanhte gaw kawa ni a dap lakung hkan nna, nden ja ai share ni hpe hti yu yang, mun lahkawng hkying lahkawng sumshi mali rai nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Behkara a shadang sha ni gaw, Zemira, Yosha, Elieza, Elioni, Omri, Yeremot, Abiya, Anahtot, Alemet hte rai ma ai. Dai yawng Behkara a shadang sha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte gaw kawa ni a dap lakung hkan nna, du hkrai rai nga ai hte, nden ja ai share ni hpe hti yu yang, mun lahkawng, hkying lahkawng ni tsa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yediela kasha gaw, Bilhan rai nga ai. Bilhan a shadang sha ni gaw, Yesha, Ben-yamin, Ehud, Hkenana, Zehtan Tarshi, Ahishara hte rai nga ma ai;
  </para>
  <para style="p">
    <verse number="11" style="v" />dai ni yawng gaw tinang a kawa ni a dap lakung ni hkan nna, nden ja ai share ni hte hpyen majan luksuk ni hta lawm lu ai, Yediela a kashu kasha ni mun mi hkying sanit, ni tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte hta kaga Ira a kasha Shupim yan Hupim hte Ahera a kasha Hushim rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naphtali a shadang sha ni gaw, Yaziela, Guni, Yezera, Shalum hte rai ma ai: ndai ni gaw Bila a kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manashe a shadang sha gaw, shi a lashi num Arami numsha shaprat ai Asriela rai nga ai; bai, shi gaw, Gilead kawa Mahkira hpe shaprat wu ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahkira gaw Hupim yan Shupim shayi sha la wu ai: shi a kanau a amying gaw Mahka rai lu ai: kanau kaga a amying gaw Zelohpa rai nga ai; Zelohpa gaw shayi sha shaprat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mahkira madu jan Mahka gaw shadang sha shaprat wu ai rai nna, shi a amying hpe Pere shamying wu ai; shi a kanau a amying gaw Shere rai lu ai; shi a kasha yan gaw Ulam hte Rakem rai ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ulam a kasha Bedan rai nga ai. Dai ni gaw Manashe a kashu Mahkira a kasha Gilead a amyu matu ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi a kajan Molehket gaw Ishod, Abieze, Mala hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shemida a shadang sha ni gaw, Ahian, Shehkem, Lihki, Aniam hte rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ehprim a shadang sha gaw Shuhtela; Shuhtela a kasha gaw Bered; Bered a kasha Tahat, Tahat a kasha Eleada, Eleada a kasha Tahat,
  </para>
  <para style="p">
    <verse number="21" style="v" />Tahat a kasha Zabad, Zabad a kasha Shuhtela rai ma ai: dai hta kaga Ehprim a kasha Ezera hte Elead yan gaw, dai mung e shangai wa ai Gat a masha ni a yamnga ni hpe kashun la mu ai majaw, sat kau ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shan a kawa Ehprim gaw, nhtoi na na wa shan a lam yawn hkyen nga ai rai nna, kahpu kanau ni gaw shi hpe shalan shabran na, sa du ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang shi gaw madu jan kaw shang nna, shi na-um nasin hkum nga wa ai hte shadang sha shangai wu ai: shi a nta masha ni ruyak hkrum nga ma ai majaw, dai ma hpe Beria ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi a shayi sha gaw, Shera rai lu ai; shi gaw lawu lahta Bet-horon hte Uzen-shera de da wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai, shi a kasha Rehpa yan Reshep; Reshep a kasha Tela; Tela a kasha Tahan;
  </para>
  <para style="p">
    <verse number="26" style="v" />Tahan a kasha Ladan; Ladan a kasha Amihud; Amihud a kasha Elishama; Elishama a kasha Nun;
  </para>
  <para style="p">
    <verse number="27" style="v" />Nun a kasha Yawshu rai nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte a lamu ga jarit hte shanhte madu nga ai shara ni gaw, Betela hte de a kahtawng ni; sinpraw maga na Naran hte, sinna maga na Gezera hte de a kahtawng ni; Shehkem hte de a kahtawng ni kaw nna, Aza hte de a kahtawng ni du hkra.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manashe lamu ga jarit makau na Bet-shean hte de a kahtawng ni; Tanak hte de a kahtawng ni; Megido hte de a kahtawng ni; Dora hte de a kahtawng ni rai nga malu ai. Dai shara ni hta Israela a kasha Yawsep a kashu kasha ni nga nga ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ashe a shadang sha ni gaw, Imna, Ijiswa, Yiswi, Beria hte shanhte a kajan Sera hte rai ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Beria shadang sha gaw Hebera yan Malhkiela rai ma ai; Malhkiela gaw Birza-it a kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hebera gaw, Yaplet, Shome, Hohtam hte shanhte a kajan Shua hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yaplet a shadang sha ni gaw, Pasak, Bimhala, Ashwat hte rai ma ai. Dai ni gaw Yaplet a kashu kasha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sheme a shadang sha ni gaw, Ahi, Roga, Yehuba, Aram hte rai ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shi a kanau Helem a shadang sha ni gaw, Zohpa, Yimna, Shele, Amala hte rai ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zohpa a shadang sha ni gaw, Sua, Harnehpe, Shuala, Beri, Imra,
  </para>
  <para style="p">
    <verse number="37" style="v" />Bezera, Hoda, Shama, Shilsha, Ihtran, Bera hte rai ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Yehtera shadang sha ni gaw, Yehpuna, Pispa, Ara hte rai ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ula a shadang sha ni gaw, Ara, Haniela, Rizia hte rai ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Dai ni yawng gaw, kawa ni a dap lakung hta san da ai nden ja ai share ni hte du kaba ni rai nga ma ai; shanhte gaw Ashe a kashu kasha ni hkrai rai nga ma ai. Shanhte a labau hkan nna jahpan laika hta ka da ai, hpyen gasat ram ai ni gaw, mun lahkawng hkying kru rai nga ma ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ben-yamin gaw shi a kasha alat Bela, lahkawng ngu na Ashbela, masum ngu na Ahara,
  </para>
  <para style="p">
    <verse number="2" style="v" />mali ngu na Noha, manga ngu na Rahpa hte hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bela a shadang sha ni gaw, Adara, Gera, Abihu,
  </para>
  <para style="p">
    <verse number="4" style="v" />Abishua, Naman, Ahoa,
  </para>
  <para style="p">
    <verse number="5" style="v" />Gera, Shehpuhpan, Huram hte rai ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai ni gaw Ehuda shadang sha ni rai nga ma ai: shanhte gaw Geba shara na tinang kawa ni a nta na agyi ni rai nga nna, shanhte hpe Manahat du hkra bawng woi wa mu ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />Naman, Ahiya hte Gera gaw shanhte hpe bawng woi wa mu ai rai nna, Gera gaw Uza yan Ahihu hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte hpe dat dat mu ai hpang Shaharim gaw Moba mung hta e kasha shaprat wu ai; Hushim hte Bara gaw shi a madu jan yan rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai shi gaw shi a madu jan Hodesha hta, Yobaba, Zibia, Mesha, Malhkam,
  </para>
  <para style="p">
    <verse number="10" style="v" />Yeuza, Shahkia, Mirma hte hpe shaprat wu ai. Dai ni gaw shi a shadang sha ni, tinang a kawa a dap agyi ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shawng num Hushim hta Abitu yan Elpala hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elpala a shadang sha ni gaw, Ebera, Misham, Sheme hte rai ma ai; Sheme gaw Ono hte Loda mare hte de a mare ni hpe de da wu ai;
  </para>
  <para style="p">
    <verse number="13" style="v" />Beria hte Shema, Gat masha ni hpe jahtaw kau ai, Aiyalon masha ni a kawa dap ni a agyi ni rai ma ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />dai hta kaga, Ahio, Shashak, Yeremot,
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebadia, Arad, Edera,
  </para>
  <para style="p">
    <verse number="16" style="v" />Beria kasha ni Mihkaela, Ishpa, Yoha,
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebadia, Meshulam. Hizki, Hebera,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ishmerai, Izlia, Yobab, Elpala a kasha ni,
  </para>
  <para style="p">
    <verse number="19" style="v" />Yakim, Zihkri, Zabdi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Elienai, Zilehtai, Eliela,
  </para>
  <para style="p">
    <verse number="21" style="v" />Adaia, Beraia, Shimrat hte gaw Shimei a kasha ni rai ma ai;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ishpan, Ebera, Eliela,
  </para>
  <para style="p">
    <verse number="23" style="v" />Abdon, Zihkri, Hanan,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hanani, Elam, Anhtohiya;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ipdia, Penuela hte gaw Shashak a kasha ni rai nga ma ai;
  </para>
  <para style="p">
    <verse number="26" style="v" />Shamsherai, Shehari, Ahtalia,
  </para>
  <para style="p">
    <verse number="27" style="v" />Yeroham a kasha ni Yareshi, Elia, Zihkri hte rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai ni gaw Yerusalem mare e nga nga nna, prat mi hte prat mi tinang a kawa ni a dap lakung ni hta agyi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gibeon a shara hta e Abi-gibeon nga nga ai; shi a madu jan a amying Mahka rai lu ai;
  </para>
  <para style="p">
    <verse number="30" style="v" />shi a kasha alat gaw Abdon; shi a kanau ni, Zura, Kisha, Bla, Nadab,
  </para>
  <para style="p">
    <verse number="31" style="v" />Gedora, Ahio, Zehkera hte rai ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Miklot gaw Shimea hpe shaprat wu ai. Shanhte mung Yerusalem mare e tinang baw sang ni hte rau, kahpu kanau ni a tawtap e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai Nira gaw Kisha hpe shaprat wu ai; Kisha gaw Shawlu hpe shaprat wu ai; Shawlu gaw Yonahtan, Mahkishua, Abinadab, Eshbala hte hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yonahtan a kasha Meribala rai nga ai; Meribala gaw Mihka hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mihka a shadang sha ni gaw, Pihton, Melek, Tarea, Ahaza hte rai ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahaza gaw Yehoada, Yehoada gaw Alemet, Azmawet hte Zimri hpe shaprat wu ai; Zimri gaw Moza hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Moza gaw Binea hpe shaprat wu ai; Binea kasha Rahpa; Rahpa a kasha Eleasa; Elesa a kasha Azela.
  </para>
  <para style="p">
    <verse number="38" style="v" />Azela gaw shadang sha kru lu ai rai nna shanhte a amying ni, Azrikam, Bokeru, Ishmaela, Sheria, Obadia, Hanan rai nga malu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai ni yawng Azela kasha ni rai ma ai. Shi a kanau Eshek a shadang sha ni gaw, kasha alat Ulam, lahkawng ngu na Yeusha, masum ngu na Elihpelet rai nga ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ulam a shadang sha ni gaw nden ja ai share ni hte, ndan chye gap ai ni rai nga nna, kashu kasha marai latsa e manga shi law nga ma ai. Dai ni nlang hte gaw Ben-yamin a kashu kasha ni rai nga ma ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shing rai Israela masha ni yawng amyu mi hte amyu mi ka da nga masai; yu mu, shanhte gaw Israela hkawhkam ni a ahtik labau laika hta ka da nga ma ai: Yuda amyu gaw tinang a yubak mara majaw Babelon mung de bawng woi wa ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte a mare ni hte madu lu ai lamu ga hta shawng nga ai ni gaw, Israela masha ni, hkinjawng ni, Lewi masha ni hte Nehtinim ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yerusalem mare hta e, Yuda kashu kasha ni, Ben-yamin a kashu kasha ni, Ehprim hte Manashe a kashu kasha ni ngu ai,
  </para>
  <para style="p">
    <verse number="4" style="v" />Amihu a kasha Uhtai; Amihu gaw Omri a kasha, Omri gaw Imri a kasha, Imri gaw Bani a kasha, Bani gaw Yuda a kasha Hparet a aru arat rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shilon masha ni hta na, kasha alat Asaia hte shi a kashu kasha ni lawm ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zera a kashu kasha ni hta na, Yeuela hte shi a kanau ni, marai kru tsa jahku shi rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ben-yamin a shadang sha ni gaw, Meshulam a kasha Salu; Meshulam gaw Hodawia kasha, Hodawia gaw Hasenua kasha rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />bai, Yeroham a kasha Ibnea; Uzi a kasha Ela; Uzia gaw Mihkri a kasha; bai, Shehpatia kasha Meshulam; Shehpatia gaw Reuela a kasha, Reuela gaw Ibniya a kasha rai nga ai:
  </para>
  <para style="p">
    <verse number="9" style="v" />shanhte a kahpu kanau ni yawng amyu mi hte amyu mi, jahku tsa e manga shi kru rai nga ma ai. Dai ni yawng gaw tinang a kawa ni a dap lakung ni hta amyu agyi ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkinjawng ni hta na Yedaia, Yehoiarib, Yahkin hte rai ma ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />bai, Hilkia kasha Azaria; Hilkia gaw Meshulam a kasha, Meshulam gaw Zadok a kasha, Zadok gaw Meraiot a kasha; Meraiot gaw Karai Kasang a Nta up ai Ahitub a kasha rai nga ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />bai Yeroham a kasha Adaia; Yeroham gaw Pashura kasha, Pashura gaw Malhkiya a kasha; Malhkiya gaw Masai a kasha; Masai gaw Adiela kasha; Adiela gaw Yazera a kasha; Yazera gaw Meshulam a kasha; Meshulam gaw Meshilemit a kasha, Meshilemit Imera kasha rai ma ai;
  </para>
  <para style="p">
    <verse number="13" style="v" />tinang a kawa ni a dap lakung ni a agyi ngu ai kahpu kanau ni gaw, hkying mi sanit tsa kru shi rai ma ai; shanhte gaw Karai Kasang a nta na daw jau na amu matu grai chye galaw ai ni rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai, Lewi masha ni hta na, Hashuba kasha Shemaia; Hashuba gaw Azrikam a kasha; Azrikam gaw Hashabia kasha; dai ni gaw Merari a kashu kasha ni rai ma ai;
  </para>
  <para style="p">
    <verse number="15" style="v" />bai, Bakbara, Heresha, Galala hte Mihka a kasha Matania; Mihka gaw Zihkri a kasha; Zihkri gaw Asap a kasha rai ma ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />bai, Shemai a kasha Obadia; Shemai gaw Galala kasha; Galala gaw Yeduhtun a kasha; bai, Asa a kasha Berehkia; Asa gaw Netohpa kahtawng ni hta nga ai Elkana a kasha rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai, chyinghka sin ai ni gaw, Shalum, Akub, Talmon, Ahiman hte kahpu kanau ni rai nga ma ai: Shalum gaw agyi rai nga ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte gaw ya du hkra, sinpraw maga na hkawhkam chyinghka sin ai ni rai nga ma ai: Lewi a kashu kasha ni a dap na chyinghka sin ai ni shanhte rai nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Korah a dap Ebiasap a kashu, Kore a kasha Shalum hte shi a kahpu kanau Korah masha ni gaw, dai daw jau ai amu hpe bau sin na matu sumpan nta chyinghka hkinbawng hpe sin nga ma ai: shanhte a kaji kawa ni mung Yehowa a dap chyinghka lam hpe sin nga ai ni tai wa masai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Eleaza a kasha Hpineha gaw moi shawng e shanhte a ntsa e up nga ai. Yehowa shi hte rau nga u ga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai Meshelemia kasha Zehkaria gaw, shawa hpawng a sum chyinghka hpe sin nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyinghka hkinbawng hpe sin na matu san da ai ni yawng hte gaw ni tsa shi lahkawng rai ma ai. Shanhte gaw kahtawng mi hte kahtawng mi hta tinang a ahtik labau hkan nna, Dawi hte myihtoi Samuela aya dang da ai ni rai ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai shanhte hte shanhte a kashu kasha ni gaw ladaw tawn da ai hte maren, Yehowa a nta ngu ai sumpan nta a chyinghka lam hpe sin nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chyinghka sin ai ni gaw, sinpraw, sinna, dingdung, dingda, man mali sin nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kahtawng ni hta nga ai shanhte a kahpu kanau ni gaw, shanhte hpe sa tau na matu, nhtoi ladaw sanit ya shagu sa du ma ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaning rai nme law, Lewi masha rai nga ai, chyinghka sin na aya lu ai agyi marai mali gaw, Karai Kasang nta na sutdek hte gawk kaga ni hpe sin na matu, tut tut anga nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte gaw Karai kasang a nta grup yin e nga nga ma ai: dai hpe sin na matu shanhte a amu rai malu ai: jahpawt shagu chyinghka hpaw na, shanhte a amu mung rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bai, shanhte hta na nkau mi gaw daw jau yang lang ai gawm ni hpe sin nga ma ai; kaning rai nme law, jashawn yang mung, shapraw yang mung, dai ni langai hte langai hpe hti yu ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai nkau mi hpe gaw chyoi pra ai shara hte seng ai ku ni hte gawm ni mahkra hpe mung, mani ai shadung, tsabyi jahku, namman, lawban hte manam pyaw ai baw ni hpe lajang na matu san da mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bai, hkinjawng kasha ni nkau mi gaw, manam pyaw ai baw sau ni hpe hpaw chye ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Korah dap na, Shalum a kasha alat, Lewi masha, Matihtia gaw hpri pa hta kabaw ai muk pa ni hpe yu lajang na ahkang lu nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shanhte a kahpu kanau ni, Kohat a kashu kasha ni nkau mi gaw, madun dan ai muk ni hpe laban nhtoi shagu lajang nga ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai ni gaw Mahkawn mangoi woi ai, Lewi a dap lakung a agyi ni hte, wang gawk ni hta nga nga let, amu kaga hte lawt ai ni rai nga ma ai: shanhte gaw shani shagu tinang hte seng ai amu ni hpe gun hpai nga ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai ni gaw Lewi a dap lakung ni a agyi ni hte, prat mi hte prat mi, woi awn ai ni rai nga ma ai: shanhte gaw Yerusalem mare hta e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Gibeon shara hta e Gibeon a kawa Yeiela nga nga ai; shi a madu jan amying Mahka rai lu ai:
  </para>
  <para style="p">
    <verse number="36" style="v" />Shi a kasha alat gaw, Abdon; shi a kanau ni Zura, Kisha, Bala, Nera, Nadab,
  </para>
  <para style="p">
    <verse number="37" style="v" />Gedora, Ahio, Zehkaria, Miklot hte rai ma ai;
  </para>
  <para style="p">
    <verse number="38" style="v" />Miklot gaw Shimeam hpe shaprat wu ai. Shanhte mung, Yerusalem mare e tinang baw sang ni hte rau, kahpu kanau ni a tawtap e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Bai Nera gaw Kisha hpe shaprat wu ai; Kisha gaw Shawlu hpe shaprat wu ai; Shawlu gaw Yonahtan Mahkishua, Abinadab, Eshbala hte hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Yonahtan a kasha Meribala rai nga ai; Meribala gaw Mihka hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mihka a shadang sha ni gaw, Pihton, Melek, Tarea, Ahaza hte rai ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahaza gaw Yara hpe, Yara gaw Alemet, Azmawet, Zimri hte hpe shaprat wu ai; Zimri gaw Moza hpe shaprat wu ai;
  </para>
  <para style="p">
    <verse number="43" style="v" />Moza gaw Binea hpe shaprat wu ai; Binea kasha Rehpaia, Rehpaia kasha Eleasa, Eleasa a kasha Azela rai ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Azela gaw shadang sha kru lu ai rai nna, shanhte a mying ni, Azrikam, Bohkeru, Ishmaela, Sheria, Obadia, Hanan rai nga malu ai: dai ni gaw Azela a kasha ni rai nga ma ai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Hpilisti masha ni Israela masha ni hpe gasat mu ai: Israela masha ni mahtang masha hpyen ni a man e hprawng nna Gilaboa bum ga hkan e hkala nba hkrum ai hte si shajang ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpilisti masha ni mung Shawlu hte shi a kasha ni hpe htep lahti hkan shachyut nna, Shawlu a kasha Yonahtan, Abinadab hte Mahkishua hte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai dai gasat gala ai gaw, Shawlu a matu jin nga ai rai nna, ndan gap ai ni shi hpe dep mu ai: dai ndan pala gap ai ni a majaw shi myit ru nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna Shawlu gaw shi a ri nhtu gun hpai ai wa hpe, “Ndai matu n gadoi ai ni gaw ngai e n sa galun lu nna, ngai e n roi lu ma ai du hkra, na nhtu shaw nna ngai e galun ya e,” ngu wu timung, dai wa gaw grai hkrit nga ai majaw, n hkraw nga ai. Dai rai nna Shawlu gaw shi a nhtu dai la nna dai hta abraw ju si wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ri nhtu lang ai wa mung, Shawlu si mat sai hpe mu jang, shi gaw shi a nhtu hta abraw ju si wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai Shawlu hte shi a kasha masum si mat masai; shi a nta masha ni yawng, rau si wa masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya, Israela masha ni hprawng mat ma ai hte, Shawlu mung, shi a kasha ni mung si mat ma ai gaw dai kadit e nga ai Israela masha ni mu mu yang, shanhte gaw tinang a mare kahtawng ni hpe kau da ma ai rai nna, Hpilisti masha ni sa de nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpang jahpawt e Hpilisti masha ni, si mang ni hta na lanep hpyu la na nga, du sa wa ma yang, Shawlu hte shi a kasha ni Gilaboa bum ga e si taw nga ai hpe mu ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte shi a arai ni hpe hpyu la ai hte, shi a baw hte shi a hpyen palawng la wa nhtawm, shanhte a Hpara sumla hkan e mung, masha ni a man e mung, kajai gumhkawng na matu, Hpilisti mung grup yin hkan e shagun dat mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a hpyen palawng hpe tinang a Hpara ni a nta e tawn da mu ai; shi a baw hpe Dagon a nta e noi da mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hpilisti masha ni Shawlu hpe shing di ai lam Yabesha-gilead masha ni yawng na ma yang,
  </para>
  <para style="p">
    <verse number="12" style="v" />share ni mahkra rawt nna, Shawlu hte shi a kasha ni a moi mang ni hpe la nna, Yabesha mare de hpai wa nhtawm, Yabesha wamyi hpun npu e lup makoi kau nna, sanit ya tup lusha gam nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai Shawlu gaw Yehowa a ga hpe n madat ai hte, Yehowa hpe shut hpyit kau ai majaw mung, Yehowa hpe n san yu ai sha, nat shung ai num hpe tam san yu ai majaw mung si ai hkrum wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai re ai majaw Yehowa gaw shi hpe sat kau nhtawm, Yese a kasha Dawi hpe dai mungdan ap ya kau wu ai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Israela masha ni yawng, Hebron mare de Dawi kaw sa du nna, Yu u, anhte gaw na a nrut nra, na a hkum shan rai nga ga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mani ma ni Shawlu anhte a hkawhkam naw rai nga yang pyi, nang hkum nan Israela amyu hpe woi pru woi shang ai wa, rai nga nit dai: na a Karai Kasang Yehowa mung, Nang gaw nye a amyu Israela hpe woi rem na wa mung, nye a amyu Israela ntsa e du magam mung, tai lu na rin dai, ngu nna nang madu hpe tsun nit dai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai, Israela agyi salang ni yawng, Hebron mare de Hkawhkam wa kaw sa du nna, Dawi gaw Hebron mare hta e, Yehowa a man e shanhte hte ga shaka tawn da nhtawm, shanhte gaw, Samuela a n-gup hta Yehowa tsun da ai hte maren, Israela hkawhkam tai na matu, Dawi hpe namman chya ya mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Dawi hte Israela amyu ting, Yebu ngu ai, Yerusalem de lung wa ma ai: dai mung na kashu kasha ni ngu ai, Yebusi masha ni gaw, dai yang e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yebu mare masha ni chyawm gaw, Nang gaw nang e shang lu na ndai n rai, ngu nna Dawi hpe tsun mu timung, Dawi gaw Ziun ngu ai hpyen dap hpe gasat la wu ai; dai gaw Dawi a mare ngu ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai Dawi gaw, Yebusi masha ni hpe shawng dep gasat lu ai wa, agyi hte hpyen du tai na ra ai, nga nna tsun ai majaw, Zeruia kasha Yoab gaw shawng lung wa nna, agyi tai wa sai,
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang Dawi gaw dai hpyen dap hta a nga nga ai; dai re ai majaw dai mare hpe Dawi a mare ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hta kaga shi gaw, dai mare hpe Milo shara kaw nna grup yin du hkra de da wu ai: Yoab gaw dai mare a kaga daw mi hpe lajang wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dawi chyawm gaw grau nna galu kaba jat wa nga ai; kaning rai nme law, Zaw nawng Zaw wa up ai Yehowa gaw shi hte rau rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Da ndai gaw, Dawi hte rau nga ai nden ja ai share ni a agyi ni rai nga ma ai: Yehowa gaw Israela amyu a lam tsun wu ai hte maren, shanhte gaw Israela amyu masha ni mahkra hte rau Dawi hpe hkawhkam aya dang na matu, shi hpang maga e, dai mungdan hta, n-gun dat ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Da ndai gaw Dawi hte rau nga ai nden ja ai share ni a jahpan rai nga ai: Hakmoni amyu Yashobeam gaw hpyen du ni a du rai nga ai: shi gaw ri lang let, marai masum tsa hpe lang lata gasat nna, sat kau mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a hpang e, Ahohi masha Dodo a kasha Eliaza gaw, n-gun ja ai share masum hta lawm nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw Dawi hte rau Pasdamin shara e nga nga ai rai nna, dai shara e nga ai muk-yaw mam hkaibang lawk hta hpyen gasat na matu Hpilisti masha ni hpawng nga ma ai; mung masha ni gaw Hpilisti masha ni a majaw hprawng mat wa ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte chyawm gaw hkaibang lawk ka-ang e tsap let hkap gasat nga nna Hpilisti masha ni hpe sat kau mu ai: Yehowa gaw padang ninglaw kaba hte shanhte hpe hkye hkrang la mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lang mi gaw agyi sumshi hta na marai masum Dawi nga ai lunghkrung hkan na Adulam ginlawng hku kata de shang ma ai: Hpilisti luksuk ni gaw Rehpim kadit e dap jung nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dawi gaw dai shaloi e dai hpyen dap hta nga nga nna, Hpilisti sin langa ni gaw Betlehem mare kata de nga nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dawi gaw, “Marai langai ngai Betlehem chyinghka makau na hka htung ntsin ngai e lu shangun mi le,” nga nna marit ai myit hte tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />shaloi dai marai masum Hpilisti dap de htim bang nna, Betlehem chyinghka makau na ntsin ja la nhtawm, Dawi hpang de la wa mu ai: rai timung, Dawi gaw n lu hkraw ai sha Yehowa man e ru kau let,
  </para>
  <para style="p">
    <verse number="19" style="v" />“Ndai ntsin ngai lu na gaw nye a Karai Kasang hkum u ga; tinang asak hpe nawng kau ai ni a asai ngai lu na kun? shanhte gaja wa tinang asak nawng kau ai hte ndai ntsin la wa ma ai,” nga nna n lu hkraw ai. Shing rai dai share masum galaw ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Yoab a kanau Abshai gaw share kaba masum a agyi rai nga ai: shi gaw ri lang let masha masum tsa hte hpe gasat nna, sat kau mu ai majaw dai marai masum hta shi lawm nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai marai masum hta na, shi gaw marai lahkawng hta arawng grau lu nna, shan a agyi tai wa ai: rai timung, shi gaw shawng na marai masum a lahkam n dep wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai Kabzela shara na, nden ja ai myit hte magam amu kaba shachyen chye ai Yehoiada a kasha Benaia gaw, rai nga ai: shi gaw Moba masha Ariela a shadang sha yan hpe sat kau wu ai: dai hta kaga shi gaw nshung ta e lungpu ka-ang de shang nhtawm, hkanghkyi langai mi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hkum shing-yan dawng manga tsaw ai Egutu masha langai mi hpe mung shi sat kau wu ai: dai Egutu masha a lata hta dahkaw daram kaba ai ri numdu lang nga timung, Benaia gaw dawhkrawng sha lang let, sa wa nna, Egutu masha a lata na ri kashum la nhtawm, dai ri hte shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai amu hte hpe Yehoiada kasha Benaia galaw wu ai rai nna, share masum ngu na hta shi a amying mung lawm nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yu u, shi gaw share sumshi hta arawng grau lu timung, shawng na marai masum a lahkam n dep wu ai: Dawi gaw shi a sin langa ni a ntsa e shi hpe bu shatai wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai luksuk laba ni a share ni gaw: Yoab a kanau Asahela; Betlehem masha Dodo a kasha Elhanan;
  </para>
  <para style="p">
    <verse number="27" style="v" />Haro masha Shamot; Pelo masha Heleza;
  </para>
  <para style="p">
    <verse number="28" style="v" />Teko masha Ikesha a kasha Ira; Anahtot masha Abieza;
  </para>
  <para style="p">
    <verse number="29" style="v" />Hushat masha Sibehkai; Aho masha Ilai;
  </para>
  <para style="p">
    <verse number="30" style="v" />Netohpa masha Maharai; Netohpa masha Bana a kasha Heled;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ben-yamin amyu Gibea shara na Ribai a kasha Ihtai; Pirat masha Benaia;
  </para>
  <para style="p">
    <verse number="32" style="v" />Gasha hkaraw na Hurai; Arba masha Abiela;
  </para>
  <para style="p">
    <verse number="33" style="v" />Baharu masha Azmawet; Shalabo masha Eliaba;
  </para>
  <para style="p">
    <verse number="34" style="v" />Gizon masha Hashem a kasha ni; Hara masha Shage a kasha Yonahtan;
  </para>
  <para style="p">
    <verse number="35" style="v" />Hara masha Sahkara kasha Ahiam; Ura kasha Elihpala;
  </para>
  <para style="p">
    <verse number="36" style="v" />Mehkera masha Hehpera, Pelo masha Ahiya;
  </para>
  <para style="p">
    <verse number="37" style="v" />Hkarmela masha Hezro: Ezbai a kasha Narai;
  </para>
  <para style="p">
    <verse number="38" style="v" />Nahtan a kanau Yoela; Hagri a kasha Mibhara:
  </para>
  <para style="p">
    <verse number="39" style="v" />Amon masha Zelek; Zeruia kasha Yoab a ri nhtu gun hpai ai wa Berot masha Naharai;
  </para>
  <para style="p">
    <verse number="40" style="v" />Ihtri masha Ira; Ihtri masha Gareb;
  </para>
  <para style="p">
    <verse number="41" style="v" />Hiti masha Urai; Alai a kasha Zabad;
  </para>
  <para style="p">
    <verse number="42" style="v" />Rubin du amyu hta na Rubin masha Shiza a kasha Adina hte, shi hte rau nga ai marai sumshi;
  </para>
  <para style="p">
    <verse number="43" style="v" />Mahka a kasha Hanan, Mitni masha Yoshahpat;
  </para>
  <para style="p">
    <verse number="44" style="v" />Ashtera masha Uzia; Arori masha Hohtam a kasha Shama yan Yiela;
  </para>
  <para style="p">
    <verse number="45" style="v" />Shimri a kasha Yediela hte shi a kanau Tizi masha Yoha;
  </para>
  <para style="p">
    <verse number="46" style="v" />Mahawi masha Eliela; Elnam a kasha Yeribai yan Yoshawi;
  </para>
  <para style="p">
    <verse number="47" style="v" />Moba masha Itma hte hpawn Eliela. Obed, Mezoba masha Yesiela hte rai ma ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dawi gaw Kisha a kasha Shawlu hpe hprawng makoi nna, Zikla mare e naw nga nga yang, shi kaw sa shingbyi ai ni gaw da ndai hte rai ma ai: shanhte gaw hpyen majan hta shi hpe karum ai nden ja ai share ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw ndan lang nna, lakli hte nlung nwat kabai timung, ndan pala gap yang mung, pai hkra lata ma ai n rai: dai ni gaw Ben-yamin amyu hta na Shawlu a kahpu kanau ni rai ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Agyi wa gaw Ahizera; shi hpang na ni. Gibea masha Shema a kasha Yosha; Azmawet a kasha Yezela yan Pelet; Berahka. Anahtot masha Yehu;
  </para>
  <para style="p">
    <verse number="4" style="v" />dai marai sumshi hta lawm nna, shanhte a ntsa e rai nga ai, nden ja ai share Gibeon masha Ishmaia; Jeremia, Yahazela, Yohanan. Gedera masha Yozabad;
  </para>
  <para style="p">
    <verse number="5" style="v" />Eluzai, Yerimot, Bealia, Shemari, Haruk masha Shehpatia;
  </para>
  <para style="p">
    <verse number="6" style="v" />Elkana, Ishia, Azarela, Yozera, Yashobeam, Kora masha ni,
  </para>
  <para style="p">
    <verse number="7" style="v" />Yoela hte Gedora masha Yehoram a kasha Zebadia hte rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Dawi nga ai nam mali na hpyen dap ni hta, hprawng shingbyi nga ai, nden ja ai share ni, hpyen majan amu chye galaw nna, ri n-gang chye lang ai Gad masha ni mung lawm ma ai: shanhte a myi man gaw hkanghkyi myi man hte bung nna, bum lang ga hkan na tsu aya zawn gat laram chye ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ezera gaw agyi rai nga ai; lahkawng ngu na Obadia; masum ngu na Eliaba;
  </para>
  <para style="p">
    <verse number="10" style="v" />mali ngu na Mishman; manga ngu na Yeremia;
  </para>
  <para style="p">
    <verse number="11" style="v" />kru ngu na Atai; sanit ngu na Eliela;
  </para>
  <para style="p">
    <verse number="12" style="v" />matsat ngu na Yohanan; Jahku ngu na Elazaba;
  </para>
  <para style="p">
    <verse number="13" style="v" />shi ngu na Yeremia; shi langai ngu na, Makbanai, rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya tsun ai Dan masha ni gaw luksuk bu ni rai nga ma ai: Grau kaji ai wa gaw marai latsa hpe, grau kaba ai gaw marai hkying mi dang lu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte gaw Yawdan hka tung ai aten, shawng na ta hta rap sa nna, pa ga na sinpraw sinna e nga ai masha ni hpe jahtaw kau mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai, Dawi nga ai hpyen dap ni de, Ben-yamin hte Yuda kashu kasha ni mung sa shingbyi ma ai rai nna,
  </para>
  <para style="p">
    <verse number="17" style="v" />Dawi gaw shanhte hpe tau la na nga pru sa wa let, “Ngai hpe shingtau na matu nanhte ngwipyaw ai hte du sa myit dai rai yang gaw, nye a myit nanhte a myit hte makyit na li ai: shing n rai, nye hpyen ni a lata de ngai hpe ap kau na matu nanhte sa du ai rai yang, nye a lata hta hpa mara n kap ai majaw, ji wa a Karai Kasang dai hpe yu yu nna, daru kau u ga,” ngu nna shanhte hpe hkap tsun mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi marai sumshi a agyi Amasai a ntsa e Wenyi dung nga nna, Dawi e, na a masha ni anhte rai nga ga ai; Yese a kasha e, nang hpang maga anhte lawm nga ga ai. Na a Karai Kasang nang hpe Karum ai majaw, “Nang hta ngwi ngwipyaw pyaw rai nga u ga law; Nang hpe karum ai ni mung ngwipyaw nga mu ga law,” ngu nna htan wu yang, Dawi shanhte hpe hkap hkalum la nhtawm, luksuk ni a bu aya dang da mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dawi gaw Hpilisti masha ni hte rau Shawlu hpe gasat na nga sa wa nga yang, Manashe masha nkau mi mung, shi hpang de hprawng shingbyi ma ai: rai timung, Hpilisti masha ni hpe karum mu ai n rai: kaning rai nme law, Hpilisti du ni gaw, Anhte hpe sat kau na matu, shi gaw shi a madu Shawlu hpang de kayin mat na ra ai, nga nna bawng nhtawm, shi hpe shabai kau dat mu ai
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai Dawi gaw Zikla mare de sa wa yang, shi kaw hkan nang ai Manashe masha ni gaw Adna, Yozabad, Yediela, Mihkaela, Yozabad, Elihu, Zilihtai hte rai ma ai: dai ni gaw Manashe amyu na hkying hkying up ai bu ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte gaw nden ja ai share ni hte, hpyen luksuk du ni rai nga nna, damya hpung ni hpe gasat na matu, Dawi hpe karum mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai Karai Kasang a wunawng wuwa zawn law ai luksuk daram du hkra. Dawi hpe karum na matu, lani hte lani masha ru bang wa ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Da ndai hte gaw, Yehowa mungga hte maren, Shawlu a mungdan, Dawi a lata de ap ya na nga, Hebron mare de shi kaw sa du ai, hpyen majan galaw na matu ri nhtu lang ai agyi ni a nambat rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yuda amyu hta na n-gang hte ri lang ai hpyen masha hkying kru e matsat tsa;
  </para>
  <para style="p">
    <verse number="25" style="v" />Simun amyu hta na hpyen shang ram ai nden ja ai wa-ngan ni, hkying sanit e latsa;
  </para>
  <para style="p">
    <verse number="26" style="v" />Lewi kashu kasha ni hta na, hkying mali e kru tsa hte rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Arun dap na agyi gaw Yehoiada rai nga nna, shi hte rau marai hkying masum e sanit tsa lawm ma ai;
  </para>
  <para style="p">
    <verse number="28" style="v" />bai, nden ja ai wa-ngan Zadok hte shi kawa a dap na hpyen du hkun lahkawng mung lawm ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shawlu a kahpu kanau Ben-yamin masha ni hta na marai hkying masum sha lawm ma ai: kaning rai nme law, dai aten du hkra shanhte law malaw gaw Shawlu nta hta naw manoi nga ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ehprim a kashu kasha ni hta na, tinang a kaji kawa ni a dap hta kajai gumhkawng ai nden ja ai wa-ngan ni mun lahkawng e matsat tsa;
  </para>
  <para style="p">
    <verse number="31" style="v" />Dawi hpe hkawhkam dang na nga, jahpan hta lawm ai Manashe amyu chyen mi hta na mun me hkying matsat hte lawm ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bai, Israela masha ni, dai aten e mai galaw na lam chye dawdan ai Yisahka kashu kasha ni hta na, agyi ni tsa mung lawm nna, shanhte a kahpu kanau ni yawng, shanhte a ga madat mara nga ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Myit mashe n rawng nna, hpyen hking arai amyu myu hte hpyen majan lam chye shachyen nna, hpyen luksuk ni hte rau pru sa wa lu ai, Zebulun amyu hta na wa-ngan mun manga mung lawm ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Naphtali amyu hta na hpyen du hkying mi, n-gang hte ri lang ai hpyen masha mun masum hkying sanit;
  </para>
  <para style="p">
    <verse number="35" style="v" />Hpyen majan chye galaw ai Dan amyu hta na mun lahkawng hkying matsat e kru tsa;
  </para>
  <para style="p">
    <verse number="36" style="v" />hpyen majan chye galaw nna luksuk ni hte rau pru wa lu ai Ashe amyu hta na mun mali;
  </para>
  <para style="p">
    <verse number="37" style="v" />Yawdan hka wora hkran na Rubin, Gad hte Manashe amyu chyen mi hta na, hpyen gasat na matu hpyen hking amyu myu lang ai marai sen me mun lahkawng lawm ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shanhte nlang hpyen majan chye galaw nna, Dawi hpe Israela hkawhkam aya dang na nga, myit langai sha hte Hebron mare de sa wa ma ai: naw ngam nga ai Israela amyu yawng hte mung, myit langai sha hte Dawi hpe hkawhkam aya dang na maw ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shanhte gaw masum ya tup dai yang e Dawi hte rau lusha let nga nga ma ai: kaning rai nme law, shanhte a kahpu kanau ni hkyen tawn ngut manu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Dai hta kaga grup yin htingbu manang ni mung, Yisahka, Zebulun, Naphtali tsan ai ginwang kaw nna, shanhte gaw gumra, gawla-uk, lawze, utang ni hta, lusha, ngu ai muk hte muk shadung, lakum si dik apye, tsabyi si sumbaw, tsabyi jahku, tsanlun sau ni htaw sa ma ai: sagu dumsu law law mung gawt sa ma ai: kaning rai nme law, Israela amyu hta kabu gara rai nga ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Dawi gaw, agyi ni ngu ai, hpyen masha hkying mi up ai, latsa up ai bu ni yawng hte hte bawng nna, shi gaw Israela shawa hpawng hpe,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nanhte ra ai hte, anhte a Karai Kasang Yehowa mung hkraw a yang gaw, hkinjawng ni hte Lewi masha ni de nga ai mare ni hte de a ginwang ni hta naw ngam nga ai Israela mungdan shara shagu hkan na anhte a hpunau ni gaw anhte hte rau zuphpawng nga na matu, shaga la gaw;
  </para>
  <para style="p">
    <verse number="3" style="v" />shing rai, anhte a Karai Kasang a sakse sumpu hpe anhte bai hpai la ga: Shawlu a prat e dai sumpu a man e anhte san yu ga ga ai nrai,” nga nna tsun ai ga hpe,
  </para>
  <para style="p">
    <verse number="4" style="v" />shawa masha ni na ra mu ai rai nna, dai lam mung masha ni a man e htuk nga malu ai majaw, shing rai galaw na lam yin la ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai Dawi gaw Karai Kasang a sakse sumpu hpe, Kiriat-yearim mare na hpai la na nga, Egutu mung na Shihora hka shi kaw nna, Hamat lamu ga jarit du hkra nga ai Israela amyu masha yawng hte hpe jahpawng la nhtawm,
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkerubim lapran e dung ai, Yehowa amying nsang hte seng ai, Karai Kasang Yehowa sakse sumpu hpe hpai la na matu, Dawi hte Israela masha ni yawng, Yuda mung na, Kiriat-yearim ngu ai Bala mare de lung wa ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya shanhte gaw Karai Kasang a sumpu hpe Abinadab a nta na shapraw nhtawm, leng nnan a ntsa e mara mu ai: Uza yan Ahia gaw leng gau ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dawi hte Israela masha ni yawng, mahkawn mangoi na matu, tingse, doria, chying, shupsheng hte pahtau lang let, n-gun lagaw mahkra hte Karai Kasang a man e dum nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai shanhte gaw Hkidon a mam chyarang de du ai shaloi, usu ni kadawng ai majaw, sakse sumpu hpe jum shadang na matu, Uza lata ladawn nna jum wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai sakse sumpu hpe jum ai majaw, Yehowa gaw Uza hpe masin pawt nna, dai yang e shi hpe ari jaw ai hte, shi Karai Kasang a man e si wa sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa gaw Uza hpe anu sat kau ai majaw Dawi myit n pyaw nga ai rai nna, dai shara hpe ya du mateng Pere-Uza ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dawi gaw dai shani hta Karai Kasang hpe hkrit nna, ngai gaw Karai Kasang a sumpu hpe kaning rai hpai wa lu na kun, nga nna tsun let,
  </para>
  <para style="p">
    <verse number="13" style="v" />shi a shara Dawi mare de sumpu hpe n hpai wa ai sha, Giti masha Obed-edom a nta de hpai koi mat wa ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai Karai Kasang a sumpu gaw Obed-edom a nta masha ni hte rau, shi a nta hta shata masum tup rai nga ai: Yehowa mung Obed-edom a nta hte shi lu malu mahkra hpe shaman ya wu ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Turu hkawhkam Hiram gaw, Dawi a matu hkaw gap mu ga nga, kasa ni hte rau arit hpun, wut gaw ai ni hte laksama ni hpe shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai Yehowa gaw, shi hkum nan hpe Israela mungdan hta dang shagrin da nga ai gaw, Dawi nan chye da wu ai: kaning rai nme law, dai mungdan gaw, Israela amyu a jaw e shatsaw shagrau da ai hkrum nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Dawi gaw Yerusalem mare hta num bai la jat nna, shayi shadang sha hte hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya Yerusalem e shaprat ai, Dawi a kashu kasha ni a amying gaw, Shamua, Shoba, Nahtan, Shawlumon,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ibhara, Elishua, Elpelet
  </para>
  <para style="p">
    <verse number="6" style="v" />Noga, Nehpeg, Yahpia,
  </para>
  <para style="p">
    <verse number="7" style="v" />Elishama, Beliada, Elipelet hte rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya Dawi gaw Israela amyu ting a ntsa e hkawhkam tai na matu namman chya hkam ai lam, ai lam, Hpilisti masha ni na ma yang shanhte nlang Dawi hpe tam sa wa nga ma ai: Dawi mung dai lam na nna, shanhte hpe hkap gasat na pru sa wa ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hpilisti masha ni chyawm gaw Rehpim kadit e hpya lu hpya sha nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Dawi gaw, “Ngai Hpilisti masha ni hpe hkap gasat lu na kun? nang shanhte hpe na a lata hta ap ya na n ni?” ngu nna Karai Kasang hpe san wu yang, Yehowa gaw,” Lung wa su, ngai shanhte hpe na a lata hta ap ya na de ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai shanhte gaw Bala-perazim de lung nna, Dawi gaw shanhte hpe dai shara e hkap sat kau mu ai: Dawi mung, Karai Kasang gaw nye a lata hte, mawru ru ai zawn, nye a hpyen ni hpe agrawp kau wu ai, nga nna dai shara hpe Bala-perazim shamying wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte gaw dai shara e tinang a hpara ni hpe kau da ma ai rai nna, dai ni hpe nat kau na, Dawi hkang da wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai Hpilisti masha ni gaw, dai kadit e hpya lu hpya sha let, nga nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dawi mung Karai Kasang hpe bai san wu ai rai nna, Karai Kasang gaw, “Nang shanhte nga ai de hkan lung lu na n rai; shanhte hpe koi kau nna, labri shalawng tawtap hku lung htim su;
  </para>
  <para style="p">
    <verse number="15" style="v" />Iabri hpun ni a ndung e hpyen hkawm sharat ai na ai shaloi, hpyen gasat na htim u: Hpilisti luksuk ni hpe gasat na nga, Karai Kasang gaw na a shawng e pru wa sai,” ngu nna shi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang hkang da ai hte maren Dawi galaw wu ai rai nna, Gibeon shara kaw nna, Gezera du hkra Hpilisti luksuk ni hpe hkan shaza kau mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Dawi a kajai gumhkawng ai lam mung shagu hta dan hkung wa nna, amyu shagu shi hpe hkrit mu ga nga, Yehowa shabyin wu ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Dawi gaw, Dawi mare hta shi a matu nta shachyaw da wu ai; Karai Kasang a sakse sumpu matu mung shara mazing da nna sum gap wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Dawi gaw, “Lewi masha ni hta kaga, Karai Kasang a sakse sumpu hpe kadai mung mai hpai na n rai: Karai Kasang a sakse sumpu hpe hpai na hte, shi a man e tutnawng daw jau na matu, Yehowa shanhte hpe lata la mu ai,” nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna Dawi gaw, shi mazing da ai shara de, Yehowa sakse sumpu hpe hpai tawn na nga, Israela amyu ting hpe, Yerusalem mare e jahpawng la mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Dawi gaw, Arun a kashu kasha ni hte Lewi masha ni hpe mung jahpawng la mu ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Kohat a kashu kasha ni hta na, Uriela agyi rai nga nna shi kahpu kanau ni latsa e hkun rai ma ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Merari a kashu kasha ni hta na, Asaia agyi rai nga nna, shi a kahpu kanau ni ni tsa e hkun rai ma ai;
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershom a kashu kasha ni hta na, Yoela agyi rai nga nna shi a kahpu kanau ni latsa e sumshi rai ma ai;
  </para>
  <para style="p">
    <verse number="8" style="v" />Elizahpan a kashu kasha ni hta na, Shemia agyi rai nga nna, shi a kahpu kanau ni ni tsa rai ma ai;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hebron a kashu kasha ni hta na, Eliela agyi rai nga nna shi a kahpu kanau ni matsat shi rai ma ai;
  </para>
  <para style="p">
    <verse number="10" style="v" />Uziela kashu kasha ni hta na, Aminadab agyi rai nga nna, shi a kahpu kanau ni latsa e shi lahkawng rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Dawi gaw hkinjawng Zadok yan Abiahta hpe, Lewi masha ngu ai, Uriela, Asaia, Yoela, Shemia, Eliela Aminadab hte hpe shaga la nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />shanhte hpe, “Nanhte nan Lewi kaji kawa ni a dap na agyi ni rai nga myit dai, Israela Karai Kasang Yehowa a sakse sumpu hpe, ngai mazing da ai shara de hpai la na matu, nanhte hte nanhte a kahpu kanau ni tinang hkun shachyoi shapra mu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shawng de lang mi nanhte n hpai nna, tara hte maren shi hpe n tam ai majaw, anhte a Karai Kasang Yehowa anhte hpe ari jaw mi ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai, Israela Karai Kasang Yehowa a sakse sumpu hpe hpai shalun na matu, hkinjawng ni hte Lewi masha ni tinang hkum hpe shachyoi shapra ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa htet da ai ga hkan nna, Mawshe hkang da ai hte maren, Lewi kashu kasha ni gaw Karai Kasang a sakse sumpu hpe kandang hte tinang a lahpa hta hpai mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai, kabu gara myit hte nsen sharawt garu let, sumpyi, doria, tingse shupsheng dum nna, mahkawn mangoi chye ai Lewi kahpu kanau ni hta na lata san da na lam, Dawi gaw Lewi agyi salang ni hpe hkang da mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Lewi agyi ni gaw, Yoela kasha Heman hte shi a kanau ni hta na Berehkia kasha Asap; shanhte a kahpu kanau Merari a kashu kasha ni hta na Kushaia kasha Ehtan hte hpe mung;
  </para>
  <para style="p">
    <verse number="18" style="v" />shanhte a lawu na kahpu kanau ni, Zehkaria, Ben, Yaziela, Shemiramot, Yehiela, Uni, Eliaba, Benaia, Masia, Matihtia, Elihpelehu, Miknea hte hpe mung san da mu ai: chyinghka sin ai yan Obed-Edom hte Yeiela rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai mahkawn mangoi woi ai Heman, Asap, Ehtan hte gaw magri shupsheng dum shangoi ma ai;
  </para>
  <para style="p">
    <verse number="20" style="v" />bai, Aramut tingse dum ai ni gaw, Zehkaria, Aziela, Shemiramot, Yehiela, Uni, Eliaba, Masia, Benaia hte rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nsen hkum ai Sheminit tingse dum ai ni gaw, Matahtia, Elihpelehu, Miknea, Obed-edom, Yeiela, Azazia hte rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lewi masha ni a agyi Hkenani gaw mahkawn mangoi lam woi nga ai: shi gaw dai baw hpaji rawng ai majaw, mahkawn mangoi lam sharin ya wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Berehkia hte Elkana gaw, sakse sumpu a chyinghka sin ai yan rai nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bai, hkinjawng Shebania, Yoshahpat, Nehtanela, Amasai, Zehkaria, Benaia, Elieze hte gaw, Karai Kasang a sakse sumpu man e pahtau dum ma ai: Obed- edom hte Yehia gaw sakse sumpu a chyinghka sin ai yan rai nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai Dawi, Israela agyi salang ni hte hpyen hkying mi up ai bu ni gaw, Obed-edom a nta na Yehowa a ga shaka sumpu hpe kabu gara myit hte hpai la na nga, sa wa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya Karai Kasang gaw, Yehowa a ga shaka sumpu hpai la ai Lewi masha ni hpe karum mu ai majaw, shanhte gaw usu sanit, sagu la sanit nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dawi mung, sakse sumpu hpai ai ni mung, mahkawn mangoi ai ni hte mahkawn mangoi woi ai agyi Hkenania mung, hpraw tu ai lachyit sumpan lawai nga ma ai. dai hta kaga Dawi gaw lachyit hpahkai lawng kahtap hpun da wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai Israela masha ni yawng, garu jahtau nna, pahke, pahtau, shupsheng dum ai hte, tingse, doria hpe shangoi let, Yehowa a ga shaka sumpu hpe hpai wa ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya Yehowa a ga shaka sumpu Dawi mare hta shang wa yang, Shawlu a shayi sha Mihkala gaw hkuwawt hku hkap yu nna, Dawi ka let tingse dum nna wa ai hpe mu wu jang, shi hpe hkyet yu rung wu ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shing rai shanhte gaw Karai Kasang a sakse sumpu hpai la nna, Dawi mazing da ai sum ka-ang e tawn da nhtawm, wan nat hkungga hte mahku hkungga Karai Kasang a man e nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya Dawi gaw wan nat hkungga hte mahku hkungga nawng ya ngut jang, mung masha ni hpe Yehowa a mying nsang hte shaman ya mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai shi gaw Israela masha lasha numsha shagu hpe muk tawng mi, shan tau mi hte tsabyi si pa pa karan jaw mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai, Yehowa a sakse sumpu a man e daw jau na hte, Israela Karai Kasang Yehowa a chyeju dum nna, shi hpe shakawn kungdawn na matu, Dawi gaw Lewi masha nkau mi hpe san da mu ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Asap gaw agyi rai nga ai; shi a lawu e nga nna, tingse hte doria dum ai ni gaw, Zehkaria, Yeiela, Shemiramot, Yehiela, Matihtia, Eliaba, Benaia, Obed-edom, Yeiela hte rai ma ai; Asap gaw ngoi garu ai shupsheng dum nga ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />bai hkinjawng Benaia hte Yahaziela gaw Karai Kasang a ga shaka sumpu man e tutnawng pahtau dum nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai shani e Dawi gaw, Asap hte shi a kahpu kanau ni a n-gup e Yehowa a chyeju hpe shakawn kungdawn ai lam nnan tawn da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa a chyeju hpe shakawn mu, Shi a amying nsang hpe shaga mu: Shi a amu bungli amyu baw ni hpe tsun dan mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi hpe mahkawn mu, shi hpe mangoi mu, Shi a mauhpa amu nlang hte hkai dan mu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a chyoi pra ai amying hta kabu gumrawng nga mu: Yehowa hpe tam ai ni amyit masin kabu nga malu ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa hte shi a n-gun atsam hpe tam san mu; Shi a myi man hpe tutnawng e hkan tam mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a mayam Israela a aru arat hte e, Shi lata la ai Yaku a kashu kasha ni e,
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi galaw dan sai lamik kumla bungli hte, Shi a mauhpa magam, shi a n-gup na pru ai tara hpe, adum nga mu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi Yehowa gaw anhte a Karai Kasang rai nga ai: Ga ting hta e shi a tara dara ai ga, pru nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Abraham hte tawn da nga nna, Isak hpe dagam shagrin da ai ga shaka ngu ai,
  </para>
  <para style="p">
    <verse number="16" style="v" />Prat hkying mi a matu hkang da ai mungga hpe, Prat dingnawng e adum nga mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Hkanan mung hpe na a sali wunli jarit matu, Ngai nang hpe jaw na nngai,” nga ai ga gaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />Yaku hte ga madat shi tawn da nna, Israela hta prat dingsa na ga shaka shatai nu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanhte hpe hti yu na mi garai n ra, Amyu kaji naw rai nga nna, dai mung e shingbyi nga ma yang,
  </para>
  <para style="p">
    <verse number="20" style="v" />Amyu mi hta na amyu mi de, Mung mi kaw nna mung mi de, htawt hkawm ma ai shaloi e,
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte hpe zingri na shi n hkraw nga ai rai nna, Shanhte a majaw hkawhkam hpe pyi ari jaw nu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Nye a namman chya ai ni hpe hkum hkra myit, Nye a myihtoi ni hpe hkum shatsang myit,” nga nna shi tsun nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aga ting Yehowa hpe mahkawn mangoi mu, Shi a hkye hkrang la ai lam hpe lani hte lani hkai dan mu.
  </para>
  <para style="p">
    <verse number="24" style="v" />Masha amyu ni hpe shi a hpung shingkang, Amyu baw shagu hpe shi a mauhpa amu gawn dan mu.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa gaw galu kaba nga ai rai nna, Nachying shakawn ging ai wa rai nga ai: Hpara mahkra ni hta mung shi hpe grau hkrit mai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amyu baw ni a hpara ni, sumla hkrai rai nga ma ai; Yehowa chyawm gaw sumsing lamu hpe hpan da nu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ndaw nsa hte hpung shingkang shi a man e nga nga ai, Atsam hte reng htum ai shi a shara e nga nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Masha amyu dap ni e, anhte a Yehowa hpe, Rai sa, Yehowa hpe hpung shingkang hte atsam yin la mu.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yehowa a mying ningsang hpe hpung shingkang yin la mu; Lusha hkungga lang let shi a man de shang mu: Chyoi pra ai hpe mawn sumli nna, Yehowa hpe nawku mu.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mung shagu shi a man e hkrit gari nga mu ga; Gaja wa mungkan ga hpe shi tawn da nna, dai gaw shamu shamawt nga ai, n rai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sumsing lamu kabu gara nga nna, gingding aga garu jahtau na ra ai; “Yehowa gaw Hkawhkam rai nga ai,” ngu nna masha amyu ni hpe tsun dan mu.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nammukdara hte dai hta rawng marawng, nsen kaba hte kashaw nga mu ga: Pa hte dai yang na nga manga kabu awng nga mu ga:
  </para>
  <para style="p">
    <verse number="33" style="v" />Shaloi maling na hpun yawng hte, Yehowa man e awng sharawng nga na mara ai; Kaning rai nme law, Lamu ga hpe tara dara na shi du ra ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yehowa gaw mai kaja nga ai majaw, chyeju dum mu; Shi a chyeju htani htana e anga nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nanhte gaw, Anhte hpe hkye hkrang la ai Karai Kasang e, anhte hpe hkye hkrang la mi. Na a chyoi pra ai amying hpe shakawn kungdawn nna, Nang hpe shakawn ai hta nlaw nga lu hkra, Masha amyu ni hta na anhte hpe shinggyin la nna, mawai la mi law, ngu nna tsun mu.
  </para>
  <para style="p">
    <verse number="36" style="v" />Israela a Karai Kasang Yehowa gaw, Htani htana prat dingsa e a nga u ga law. Shaloi shawa masha ni yawng, Amen, ngu nna, Yehowa hpe shakawn kungdawn mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shing rai shi gaw, Yehowa a ga shaka sumpu man e shani shagu tutnawng daw jau na matu, Asap hte shi a kahpu kanau ni hpe mung,
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed-edom hte shi a kahpu kanau kru shi matsat hte hpe mung; chyinghka sin na matu Yeduhtun hte Hosa a kasha Obed-edom hpe mung, ga shaka sumpu man e san da mu ai;
  </para>
  <para style="p">
    <verse number="39" style="v" />Bai, wan nat hkungga nawng ai tawn hkungri ntsa e shani shagu jahpawt hte shana e Yehowa hpe wan nat hkungga nawng ya na matu, Gibeon a tsaw ai kawng ntsa na,
  </para>
  <para style="p">
    <verse number="40" style="v" />Yehowa a sumpan sum man e, hkinjawng Zadok hte shi a kahpu kanau ni hpe tawn da mu ai: dai gaw, Israela masha ni hpe hkang da ai hte, Yehowa a tara hta ka da nga ai hte maren rai nga ai:
  </para>
  <para style="p">
    <verse number="41" style="v" />bai, Yehowa a n-gaw nwai myit htani htana agrin nga ai majaw, shi a chyeju hpe mahkawn mangoi na matu, Heman hte Yeduhtun hpe mung, Jahpan hta amying lawm ai ni hpe mung, shanhte hte rau san da mu ai:
  </para>
  <para style="p">
    <verse number="42" style="v" />shing rai Heman yan Yeduhtun gaw Karai Kasang hpe mahkawn mangoi na matu, pahke hte shupsheng aja awa dum shangoi ma ai: Yeduhtun a kasha ni gaw chyinghka sin nga ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shing rai shawa masha ni langai hte langai tinang a nta de wa mat ma ai: Dawi mung shi a nta hpe shaman ya na matu, bai wa ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Dawi gaw shi a hkaw e ban sa nga yang, shi gaw myihtoi Nahtan hpe, “Yu u, ngai wa gaw marau hpun nta hta rawng nga ni ai; Yehowa a ga shaka sumpu chyawm gaw sumpan sum npu e rawng nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Nahtan gaw, “Nang myit lu ai hte maren galaw u; Karai Kasang nang hte rau rai nga ai,” ngu nna Dawi hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya dai shana e pyi Karai Kasang a mungga Nahtan kaw du pru nna,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nye a shangun ma Dawi hpe sa tsun su; Yehowa ning nga ai, Nang nye a matu shanu nga na nta galaw lu na n rai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, Israela amyu hpe woi lung wa ai shani kaw nna, dai ni du hkra, hpunpyen nta hta ngai n rawng ai sha, sum langai hte langai hta mung, htawt rawng nga ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israela amyu ting hte ngai myu hpe bau rem na Israela tara agyi langai ngai hpe, Nanhte gaw nye a matu marau hpun nta, hpa majaw n galaw myit ta? ngu nna ga hkaw mi tsun yu n ni?
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai re ai majaw nye a shangun ma Dawi hpe ning ngu u; Zaw nawng zaw wa up ai Yehowa ning nga ai. Nang gaw nye a amyu Israela ntsa e du tai na matu, nang sagu naw rem nga kaw nna, sagu lawng hta na ngai nang hpe lata la sade ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />nang hkawm sa wa ai lam shagu hta ngai nang hte rau rai nga nna, nang hpe hpyen ai ni yawng hpe na a man e ngai seng kau nhtawm, ga ntsa na dan hkung ai amying rawng ai ni a amying zawn, ngai na a amying hpe mung shatai ya na de ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai, ngai gaw nye a amyu Israela matu nga shara tawn da nna, shanhte gaw tinang a shara hta nga nga lu ai hte, htawm hpang e nhtawt wa lu hkra, ngai shanhte hpe shangang da na mawe ai: n hkru n hkra re ai masha ni mung, moi shawng e zawn,
  </para>
  <para style="p">
    <verse number="10" style="v" />bai, nye a amyu Israela a ntsa e ngai tawn da ai tara agyi ni a aprat e zawn, shanhte hpe shamyit kau lu na n rai; nang hpe hpyen ai ni mahkra hpe, ngai shadip kau na nme ai. Dai hta n-ga, Yehowa na a matu nta gap da na ra ai, ngu nna ngai nang hpe tsun dan de ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai nang aprat htum nna, na nji nwa ni kaw wa mat lu jang, na nsha ni hta na langai mi hpe ngai shagrau da nna, shi a mungdan hpe shagrin da na nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw nye a matu nta galaw na ra ai; shi a tingnyang prat dingsa e ngai shagrin da na we ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw shi a kawa tai nna, shi gaw nye a kasha rai na ra ai; na a shawng e nga ai wa kaw na, nye a n-gaw nwai myit ngai dawm la ai zawn, shi hta na ngai dawm la na n rai:
  </para>
  <para style="p">
    <verse number="14" style="v" />ngai gaw shi hpe nye a nta, nye a mungdan hta, tutnawng shagrin da nna, shi magam tingnyang gaw htani htana dinggrin anga nga na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai Nahtan gaw ndai ga mahkra hte, ndai shingran ga mahkra Dawi e htawn tsun ya wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Dawi hkawhkam gaw nhku kata de shang nna Yehowa man e dung let, “Karai Kasang Yehowa e, nang ngai hpe ndai hte wa shagrau da ai gaw, ngai hpa hkaw ai wa rai ta? nye a nta dap mung hpa rai nga a ta?
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai gaw Karai Kasang e, na a man e amu kaji naw rai nga ai: rai timung, Karai Kasang Yehowa e, na mayam a nta hta htawm hpang e byin na ra ai lam ni, nang tsun dan nna, ngai hpe hpung rawng ai wa zawn nawn da n hka!
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang gaw, na a mayam Dawi hpe madun dan ai arawng sadang lam, ngai nang hpe hpa naw tsun lu na rai nga a ta? nang gaw na a mayam wa hpe chye nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa e, ndai amu kaba mahkra hpe madu dan nga u ga, na a mayam wa matu mara mung, nang myit ra ai hte maren, ndai amu kaba mahkra hpe nang shabyin nu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa e, anhte na lu ai mahkra hte maren, nang hte bung ai mi n nga ai, nang hta kaga Karai Kasang shaje n nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ga ntsa ting hta e, na a amyu Israela hte kadai bung nga a ta? Karai Kasang gaw shi a matu amyu shatai nna, mauhpa hte hkrithpa amu galaw let, amying nsang kaba shadan dan u ga nga, Egutu mung na nang woi lung wa ai, na amyu a man na tsasam amyu ni hpe shaden kau mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaning rai nme law, nang gaw na a amyu Israela hpe htani htana prat dingsa na a amyu shatai nna, nang gaw Yehowa e, shanhte a Karai Kasang tai nit dai;
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya chyawm gaw Yehowa e, nang gaw na a mayam wa hte shi a nta masha ni a lam nang tsun ai ga tutnawng grin wa u ga; nang tsun ai hte maren shadik ya mi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zaw nawng zaw wa up ai Yehowa gaw Israela Karai Kasang rai nga ai; rai sa, Israela amyu a matu Karai Kasang rai nga ai, nga nna, htani htana e na amying nsang hpe shagrin da ai hte shagrau ai hkrum u ga law; na a mayam Dawi a amyu matu mung, na a man e tutnawng agrin nga ai,
  </para>
  <para style="p">
    <verse number="25" style="v" />Kaning rai nme law, nye a Karai Kasang e, nang gaw nye a amyu matu shagrin da na lam, na a mayam wa hpe madun dan nit dai majaw, na a mayam wa, na a man e akyu hpyi na wam nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya chyawm gaw Yehowa e, nang Karai Kasang rai nga nna, na a mayam wa hpe ndai mai kaja ai lam shaka da nit dai:
  </para>
  <para style="p">
    <verse number="27" style="v" />na a mayam wa a amyu matu ni na a man e prat dingsa grin nga lu hkra, na a mayam wa a nta hpe nang shaman ya nit dai: kaning rai nme law, nang Yehowa shaman ya nit dai majaw, dai gaw prat dingsa chyeju shaman ai hkrum nga ai,” ngu nna hpyi wu ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Dawi gaw Hpilisti masha ni hpe gasat dang kau nna, Gat hte de a kahtawng ni hpe Hpilisti masha ni a lata na kashun la mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Moba masha ni hpe mung shi gasat dang kau nna, shanhte gaw Dawi a mayam tai let, hkanse bang ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Dawi gaw Uhprat hka ginwang e shi a mungdan sa shagrin da yang, Zoba hkawhkam Hadareze hpe Hamat du hkra hkan gasat wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dawi gaw dai wa a hpyen leng hkying mi, gumra jawn ai masha hkying sanit, lagaw hkawm ai hpyen masha mun lahkawng rim la nhtawm. hpyan leng latsa a matu gumra ngam da nna hpyen leng gumra gale mahkra hpe lahkap dan kau ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya Damasku mare na Suri masha ni gaw Zoba hkawhkam Hadareze hpe sa karum yang Dawi gaw Suri masha mun lahkwng e hkying lahkawng sat kau wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Dawi gaw Suri mung na Damasku mare hta sin langa tawn da wu ai rai nna, Suri masha ni gaw Dawi a mayam tai nna, hkanse jaw mu ai. Dawi sa wa ai lam shagu hta Yehowa makawp maga nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hadareze a mayam ni lang ai ja n-gang ni hpe Dawi kashun la nna Yerusalem mare de la wa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hta kaga Dawi gaw Hadareze a mare Tibhat hte Hkun kaw na magri law law kashun la wu ai: Shawlumon gaw dai magri hte magri hka lawng, shadaw ni hte magri arai ni hpe galaw wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Dawi gaw Zoba hkawhkam Hadareze a hpyen luksuk ni mahkra hpe dang kau lu ai lam, Hamat hkawhkam Tau na wu yang,
  </para>
  <para style="p">
    <verse number="10" style="v" />shi gaw hkawhkam Dawi hpe hkap shachyen na hte shaman ya na matu, shi a kasha Hadoram hpe shangun dat wu ai: kaning rai nme law, Hadareze mung tau hte hpyen majan rai nga ai; Hadareze mung tau hpe ya sha gasat sat di wu ai; Hadora gaw aja, gumhpraw, magri arai amyu myu hpe la sa wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam Dawi gaw dai arai ni hpe mung, Edom, Moba, Ammon a kashu kasha ni, Hpilisti hte Amalek masha ni kaw na lahkawn wa ai aja gumhpraw hte rau Yehowa hpe nawng ya wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hta n-ga Zeruia kasha Abishai gaw Jum Kadit e Edom masha mun me hkying matsat sat kau wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Edom mung hta e, shi sin langa tawn da nna, Edom masha ni mahkra gaw Dawi a mayam ni tai nga ma ai. Yehowa mung Dawi a hkawm mahkawm hta shi hpe makawp maga da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai Dawi gaw Israela mungdan ting hpe up nna, shi a mung masha ni mahkra hpe tara dara ai hte dinghpring ai hku jeyang wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zeruia kasha Yoab gaw shi a jaubu kaba rai nga ai; Ahiluda kasha Yahosahpat gaw labau ka da ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahitob a kasha Zadok yan Abiahta a kasha Abimelek, hkinjawng rai nga ma ai; Shawsha gaw, kunhting chyare rai nga ai;
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehoiada kasha Benaia gaw Hkrehte yan Pelehti ni hpe up nga ai: Dawi a kasha ni gaw Hkawhkam a hkringmang ni rai nga ma ai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Ammon a kashu kasha ni a hkawhkam Nahat gaw si mat nna, shi a kasha, kawa a malai hkaw dung nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Dawi gaw, Hanun a kawa Nahat ngai hpe chyeju madun ai majaw, “Ngai mung Hanun hpe chyeju htang na we ai,” nga nna kawa a yawn hta na shi hpe shalan shabran na nga, kasa shangun dat wu ai. Dawi a ali ama ni mung Ammon a kashu kasha ni a mung hta, Hanun hpe shalan shabran na matu, shi kaw du ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ammon a kashu kasha ni a agyi salang ni chyawm gaw Hanun hpe, “Nang kaw shalan shabran ai masha sa du ai gaw, Dawi na a kawa hpe hkungga lara ai zawn, nawn da wu ni? Ndai mungdan hpe sawk yu nna, kin-yu yu ai hte hpya kau na matu, shi a shangun ma ni nang kaw sa du ai, n rai nga a ni?” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai rai nna Hanun gaw Dawi a shangun ma ni hpe rim la nna, mun shangun kau ya ai hte, dangbau du hkra shanhte a hpun palawng rep di kau ya nhtawm, dat dat mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya shanhte hpa hkrum ai lam, masha nkau mi Dawi hpe sa shana ya mu ai. Shanhte kaya kahpa kaba hkrum ai majaw, Dawi gaw shangun ma dat dat nna, hkawhkam wa gaw shanhte hpe, “Nanhte a nmun garai n galu dingsa, Yerihko mare e naw nga ga nna, dai hpang e she wa marit,” ngu dat mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ammon a kashu kasha ni gaw Dawi a man e matsat shabat rai nga ai lam, shanhte dum chye la jang, Hanun hte Ammon a kashu kasha ni gaw, hpyen leng hte gumra jawn ai masha shaga na matu, Mesopotami mung, Aram-mahka mung hte Zoba mung de gumhpraw joi hkying mi shagun dat mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai shanhte gaw hpyen leng mun masum hkying lahkawng hpe mung, Mahka hkawhkam hte shi a masha ni hpe mung shaga la nna, dai ni gaw Medeba mare tawtap e sa but nga ma ai. Ammon a kashu kasha ni mung zuphpawng nga nna, tinang a mare ni kaw na gasat na pru wa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai lam Dawi na wu jang shi gaw Yoab hte shi a share luksuk ni mahkra hpe shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai Ammon a kashu kasha ni mung pru nna, mare chyinghka lam e hpyen gasat hkyen nga ma ai: sa karum ai hkawhkam ni gaw pa ga e kaga hkrai rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Yoab gaw shi a shingdu aman hpyen man lahkawng tai nga ai mu jang, Israela masha ni mahkra hta na grau share ai ni yawng hpe lata la nna, Suri masha ni a hpang maga de hkyen tawn shangun mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naw ngam nga ai masha ni hpe shi a kanau Abishai a lata de ap ya wu ai rai nna, shanhte gaw Ammon masha ni a hpang maga de hkyen nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai Yoab gaw, Suri masha ni ngai hpe dang wa jang ngai e sa karum e; Ammon a kashu kasha ni nang hpe dang kau yang, ngai nang hpe karum na de ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dakan nga u; anhte a amyu hte anhte a Karai Kasang a mare ninghtawn ni a matu n-gun marai dat ga; Yehowa gaw shi ra ai hku hte maren, galaw u ga, ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai Yoab gaw shi a masha ni hte rau Suri dap hpe gasat na htim mu ai rai nna, Suri masha ni shi a man na hprawng mat wa ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Suri masha ni hprawng mat wa ai hpe Ammon a kashu kasha ni mu jang, shanhte mung shi a kanau Abishai a man na hprawng nna, mare de hprawng wa ma ai. Shaloi Yoab gaw Yerusalem mare de wa mat ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya Suri masha ni gaw Israela masha ni a man e sum mat ai mu chye jang, shanhte gaw kasa shangun dat nna, hka wora hkran na Hadareze san da ai hpyen du Shohpak hte shi up ai Suri masha ni hpe shaga mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai lam Dawi na wu jang, Israela masha ni yawng hte hpe jahpawng la nhtawm, Yawdan hka rap nna, shanhte nga ai de du jang hpyen gasat na hkyen tawn mu ai. Shing rai Dawi gaw hpyen gasat na hkyen ngut jang, Suri masha ni shi hpe hkap gasat mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Suri masha ni mung Israela masha ni a man na hprawng wa ma ai rai nna, Dawi gaw Suri hpyen leng masha hkying sanit, lagaw hkawm ai hpyen masha mun mali hpe sat kau ai hte, hpyen du Shohpak hpe mung sat kau wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw Israela man e sum mat ai hpe, Hadareze a ali ama ni mu jang, shanhte Dawi hte htinglu nna, shi kaw yamnga ma ai; Suri masha ni gaw htawm hpang e Ammon a kashu kasha ni hpe n karum manu ai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya shaning galai nna hkawhkam ni hpyen gasat na ladu bai hkrum jang, Yoab gaw hpyen luksuk ni hpe woi nna, Ammon a kashu kasha ni a mung hpe shaza kau nhtawm, Raba mare hpe wang tawn da mu ai. Dawi chyawm gaw Yerusalem mare e anga nga ai. Yoab mung Raba mare hpe gasat nna dang kau wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Dawi gaw shanhte a hkawhkam wa a janmau hpe shi a baw hta na raw la wu ai; dai gaw aja talenta langai mi daram li ai hte lungseng mung rawng nga ai: dai hpe Dawi a baw hta gup da wu ai: Dawi mung mare na lanep law law wa shapraw la wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mare masha ni hpe mung shi shapraw nna, shanhte hpe zingret, hpri nasit, nwa hte ret achye sat kau mu ai. Shing rai Dawi gaw Ammon a kashu kasha ni a mare ni mahkra hpe galaw wu ai. Dai hpang Dawi gaw shi a masha ni mahkra hte rau Yerusalem mare de rai wa ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hpyin ai hpang, Gezera shara hta e, Hpilisti masha ni hte hpyen majan baw wa sai: dai shaloi e Husha masha Sibehkai gaw Rehpim masha Sipai hpe sat kau nna, Hpilisti masha ni dang kau ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hpilisti masha ni hte hpyen majan bai baw pru wa ai: dai shaloi e Ya-ira kasha Elhanan gaw dahkaw daram kaba ai ri numdu lang ai Giti masha Goliat a kanau Lami hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gat mare hta e hpyen majan bai baw pru sai: dai yang e hkum shing-yan tsaw ai hte lagaw lata maga mi kru kru tu nna, yawng hkun mali tu ai wa langai mi nga ai; shi mung Rehpim amyu na rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw Israela masha ni hpe hta dakat nga yang, Dawi a kahpu Shimea kasha Yonahtan gaw shi hpe sat kau wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ndai ni gaw Gat mare na Rehpim amyu a kasha ni rai nga ma ai: shanhte gaw Dawi hte shi ali ama ni a lata hte si mat masai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Satan gaw Israela masha ni hpe alau nna, Israela amyu hpe jahpan la na Dawi hpe shadut wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai Dawi gaw, Yoab hte Israela agyi salang ni hpe,” Sa mu, Berasheba kaw nna Dan mare du hkra Israela amyu hpe hti yu nhtawm, shanhte gade law nga ma ai kun, ngai chye lu hkra, wa tsun dan marit,” ngu dat mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna Yoab gaw, “Yehowa shi a amyu hpe ya nga ai hta, htam latsa naw shalaw u ga; rai timung, nye a madu hkawhkam wa e, shanhte yawng na a mayam ni rai nga ma ai, n rai ni? nye a madu ndai lam hpa majaw ra nta? Israela amyu hpe hpa majaw shut shangun na rai ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung hkawhkam a ga gaw Yoab a ga hpe dang kau wu ai. Dai re ai majaw Yoab sa nna, Israela mung ting hproi hkra hkawm nhtawm, Yerusalem de bai wa ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya Yoab gaw Jahpan laika a nambat Dawi hpe wa sak ya wu ai. Israela amyu hta ri nhtu chye lang ai masha yawng ri mi e sen mi law nga ma ai: Yuda amyu hta ri nhtu chye lang ai masha sen mali mun sanit rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yoab gaw hkawhkam wa a ga hpe matsat ai majaw, Lewi hte Ben-yamin amyu hpe n hti shalawm wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang chyawm gaw dai lam n ra wu ai rai nna, Israela amyu hpe ari jaw wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Dawi gaw Karai Kasang hpe, “Ndai lam ngai galaw ai majaw, ngai nachying shut ni ai; rai timung, na a mayam wa a mara hpe ya raw dat kau ya e; ngai wa nachying ngawk ai amu galaw kau se ai,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai Yehowa gaw Dawi a myihtoi Gad hpe, “Dawi hpang de sa tsun su:
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa ning nga ai. ‘Ngai nang hpe lam masum madun dan de ga; nang hpe ari jaw na matu dai hta na langai mi lata la u, ngu u,’ ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai Gad Dawi hpang de sa nna, Yehowa ning nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Masum ning tup hku wa na tsin-yam; shing n rai, shata masum tup hpyen ni nang hpe hkan shachyut nna, nhtu hte shaza hkrum ai tsin-yam; shing n rai, masum ya tup ndai mungdan hta Yehowa nhtu ngu ai ana zinli pru nna, Yehowa a lamu kasa gaw Israela mungdan ting lamu ga jarit du hkra shaza kau na tsin-yam, gara mahtang lata la mayu yang lata la u: ngai e shangun ai wa hpe gara hku htan lu hkra myit aru yu u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai rai nna Dawi gaw, “Ngai myit grai ru nngai; Yehowa a lata hta ngai shang u ga; shi a matsan dum ai myit grai kaba nga lu ai: masha a lata hta ngai n du n ga,” ngu nna myihtoi Gad hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai Yehowa gaw Israela amyu hta ana zingli shangun dat nna, Israela masha mun sanit si mat ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yerusalem mare hpe jahten na matu, Karai Kasang gaw lamu kasa shangun dat nna, dai mare hpe jahten magang wa nga yang, Yehowa mada yu nna, ari dai hte a majaw myit bai kayin nna, “Ram sai, na lata dawm la nu,” ngu nna jahten maw ai lamu kasa hpe tsun wu ai. Yehowa a lamu kasa chyawm gaw Yebusi masha Ornan a mam chyarang makau e tsap nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dawi mada yu yang, Yehowa a lamu kasa gaw Yerusalem ntsa e nhtu shada let, lamu hte aga lapran e tsap nga ai hpe mu wu ai. Dai rai nna Dawi hte agyi salang ni gaw lachyit nba bu hpun let, ga hta gum dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi Dawi gaw Karai Kasang hpe, “Mung masha ni hpe hti yu na, ngai nan hkang da ai, n rai nga a ni? shut nna n shawp ai amu kaba galaw ai gaw, ngai hkum nan rai nga nngai; ndai sagu ni mahtang hpa lam shut nga ma ta? nye a Karai Kasang Yehowa e, na a mung masha ni ana zinli n hkrum lu hkra, ngai hpe mung, nye wa a nta dap hpe mung ari jaw e law,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dawi gaw, Yebusi masha Ornan a mam chyarang hta Yehowa a matu tawn hkungri galaw na lam, Dawi hpe hkang da na, Yehowa a lamu kasa gaw Gad hpe hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai rai nna Yehowa a amying nsang hte Gad htawn tsun ai ga hte maren, Dawi lung sa wa ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ornan gaw kayin yu wu yang, lamu kasa hpe mada mu wu ai; shi hte rau nga ai shi a shadang sha mali gaw makoi nga ma ai. Ornan chyawm gaw hkaulan mam dup nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ya Dawi Ornan kaw sa du yang, Ornan mada yu nna Dawi hpe mu jang, mam chyarang na shi pru nhtawm, Dawi a man e ga de gum dagup wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi Dawi gaw Ornan hpe, “Yehowa a matu tawn hkungri galaw na ndai mam chyarang ngai hpe ya e; mung masha ni hta na dai ana zinli jasim ya lu hkra, dai hpe ging dan ai manu hte dut ya rit,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi Ornan gaw, “Dai hpe la u; nye a madu hkawhkam wa myit ra ai hte maren galaw u ga: yu u, wan nat hkungga matu usu ni, hpun shatai na mam dup arai ni, lusha hkungga matu hkaulan mam hte yawng ngai sak jaw na nngai,” ngu nna Dawi hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hkawhkam Dawi mahtang, “Dai hku n rai; ngai gaja wa ging dan ai manu hte mari la na nngai; na a sut rai Yehowa hpe nawng ya na matu, ngai n la na nngai; manu n hkrat ai wan nat hkungga hpe mung n nawng ya na nngai,” ngu nna Ornan hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai Dawi gaw Ornan hpe aja shekela kru tsa shen ya nna, dai shara hpe mari la wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai Dawi gaw dai yang e Yehowa a matu tawn hkungri galaw nna, wan nat hkungga hte mahku hkungga nawng ya let, Yehowa hpe shaga wu ai: Yehowa mung wan nat hkungga nawng ai tawn hkungri ntsa e wan jahkrat ai hte sumsing lamu de nna Dawi hpe htan ya wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa gaw lamu kasa hpe hkang da nna, shi gaw shi a nhtu hpe n-ga hta bang da wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yehowa gaw Yebusi masha Ornan a mam chyarang e shi hpe htan ya wu ai gaw, Dawi mu wu yang, shi gaw dai shara e hkungga a nawng ya nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kaning rai nme law, nam mali hkan e Mawshe galaw ai Yehowa sumpan nta hte, wan nat hkungga nawng ya ai tawn hkungri gaw, dai aten e Gibeon a tsaw ai kawng ntsa e nga nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dawi chyawm gaw, Yehowa lamu kasa a nhtu hpe hkrit nga ai majaw, dai hkungri man e Karai Kasang hpe sa san na, n wam wu ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Dawi gaw, Ndai gaw Karai Kasang Yehowa nta, ndai gaw Israela masha ni a wan nat hkungga nawng na tawn hkungri, rai nga ai, nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bai Dawi gaw, Israela mung ting na tsasam masha ni hpe jahpawng da na lam hkang da wu ai: Karai Kasang a nta shachyaw na matu, nlung tawk ai ni hte nlung gaw chye ai ni hpe shaga mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hta kaga Dawi gaw nta chyinghka ni, wang chyinghka ni hte dingbat ni hpe dit na matu, hpri masen law law mahkawng da wu ai; n dang shen hkra law ai magri mung shi tawn da wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />N dang hti ai arit hpun hpe mung shi tawn da wu ai; kaning rai nme law, Sidon hte Turu masha ni gaw Dawi hpe arit hpun law law sak ya mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna Dawi gaw, Ngai sha Shawlumon asak kaji ai hte myit garai n kung nga ai: Yehowa matu shachyaw na nta chyawm gaw, mungdan shagu hta, hpung shingkang, arawng sadang dan hkung kajai gumhkawng ai nta rai na rai ai: dai re ai majaw dai nta matu ngai shachyip da we ga, nga nna Dawi shi garai n si yang, arai law law shachyip da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi shi gaw shi a kasha Shawlumon hpe shaga nna, Israela Karai Kasang Yehowa a matu nta galaw na lam hkang da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai Dawi gaw shi a kasha Shawlumon hpe, Ngai nan, nye a Karai Kasang Yehowa a mying ningsang matu nta galaw na myit nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai timung, Yehowa ngai hpe ning nga ai. Nang gaw asai law law ru kau ai hte, hpyen majan kaba gun nit dai: ga ntsa nye a man e sai law law hkaw kau ai majaw, nye a amying matu nta galaw lu na n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yu u, na a shadang sha langai mi ngwipyaw ai wa rai na ra ai; grup yin na hpyen ni shi hpe gumlau lu na n rai; shi a amying gaw Shawlumon rai nga lu ai rai nna, shi a aprat e Israela masha ni hpe ngwipyaw ai hte ban sa ai ngai jaw na nngai;
  </para>
  <para style="p">
    <verse number="10" style="v" />dai wa nan nye a amying matu nta galaw na ra ai; shi gaw ngai sha, ngai gaw shi a kawa tai na nngai; Israela mungdan ntsa e shi a tingnyang hpe htani htana prat dingsa e ngai shagrin da na we ai, nga ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya ngai sha e, Yehowa nang hte rau rai nga u ga; nang galu kaba wa nna, Yehowa na a lam tsun ai hte maren, na a Karai Kasang Yehowa a nta hpe galaw da u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a Karai Kasang Yehowa a tara hpe nang hkan nang lu hkra, Yehowa gaw nang hpe hpaji byeng-ya hte kunghpan ai myit jaw ya nna, Israela masha ni a lam nang hpe hkang da n ga.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa gaw Mawshe hpe Israela amyu ni a lam hkang da ai matsun maroi ga hte tara dara ai ga hpe, nang hkan nang n yang gaw, ngamu ngamai ai hkrum na ndai: n-gun da ting nna myit nden shaja u: hkum hkrit et, myit hkum hten et;
  </para>
  <para style="p">
    <verse number="14" style="v" />Yu u, ngai tsin-yam tsindam naw hkrum nga ai hte yang, Yehowa nta a matu, aja joi sen mi, gumhpraw joi ri mi hte n dang shen hkra law ai magri hte ahpri mahkawng da nngai; dai gaw grai law nga ai; ngau hte nlung mung shachyip da ni ai; nang gaw dai hta jat n ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hta n-ga amu chye galaw ai ni law law nang hte rau nga ma ai; nlung chye tawk ai ni, laksama ni hte hpa baw amu mung chye galaw ai ni law law wa nga ma ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />n dang hti ai aja, gumhpraw, magri, hpri nga nga ai, Rawt u, amu galaw nu, Yehowa nang hte rau rai nga u ga, ngu nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hta kaga Dawi gaw shi a kasha Shawlumon hpe karum na matu, Israela agyi salang ni mahkra hpe hkang da nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />Nanhte a Karai Kasang Yehowa gaw, nanhte hte rau rai nga ai n rai ni? shi nanhte hpe shara shagu hta ban sa shangun nga ai, n rai ni? shi gaw ndai mung na masha ni hpe nye a lata hta ap ya nna, dai mungdan gaw Yehowa a man e mung, shi a amyu masha ni a man e mung, taw nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai re ai majaw, nanhte a Karai Kasang Yehowa hpe hkan tam na nga, myit masin hte kraw lawang mahkra hpe shaja mu: rawt mu, Yehowa a mying ningsang a matu galaw na ra ai nta hta, Yehowa a ga shaka sumpu hte Karai Kasang a chyoi pra ai arai ni hpe jashawn na matu, Karai Kasang Yehowa chyoi pra ai nta hpe galaw da mu, ngu mu ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Dawi gaw dingla ugut gu wa sai rai nna, shi a kasha Shawlumon hpe Israela ntsa e hkawhkam shatai wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai hta kaga shi gaw, Israela agyi salang ni, hkinjawng ni hte Lewi masha nlang hte hpe, zuphpawng shangun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya Lewi masha ni hta na asak sumshi ning lai nna, jahpan hta lawm ai lasha langai hte langai hpe hti yu yang, marai mun masum hkying matsat rai nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai ni hta na, Yehowa a nta hta amu yu hpajang ai ni, mun lahkawng hkying mali rai nga ma ai; hkying kru hte gaw tara agyi ni hte salang ni;
  </para>
  <para style="p">
    <verse number="5" style="v" />hkying mali hte gaw chyinghka sin ai ni; bai hkying mali hte gaw, ngai Dawi galaw ai dum ai baw hte Yehowa hpe dum shakawn na, rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai Dawi gaw, Lewi a shadang sha ni, Gershon, Kohat hte Marari a amyu hkan nna, shanhte hpe hpung mi hte hpung mi karan tawn mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershon a shadang sha yan gaw, Ladan hte Shime rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ladan a shadang sha ni gaw, lat wa Yehiela, Zehtam hte Yoela, shanhte masum rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shime a shadang sha ni gaw, Shelomot, Haziela, Haran hte masum rai ma ai. Shanhte gaw kawa Ladan a nta dap ni a agyi ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Shime a kasha ni gaw, Yahat, Zina, Yeusha, Beria hte rai ma ai: dai mali gaw Shime a shadang sha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yahat gaw alat wa rai nga ai; Ziza gaw Nnaw ngu na rai nga ai: Yeusha yan Beria gaw shadang sha law law n lu ma ai majaw, kawa a nta dap hta jahpan lawm ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kohat a shadang sha ni gaw, Amram, Izhara, Hebron, Uziela hte mali rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amram a shadang sha yan gaw Arun yan Mawshe rai ma ai: Arun hte shi a shadang sha ni gaw, Yehowa a man e manam pyaw ai baw nat nawng na hte, shi hpe daw jau let shi a amying nsang hta shaman ya lu hkra, chyoi pra ai arai ni hpe tutnawng shachyoi shapra na matu, Arun gaw san da ai hkrum wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang a masha wa Mawshe a shadang sha ni gaw, Lewi amyu hta hti lawm ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawshe a shadang sha Gershom yan Eliaza rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gershom a shadang sha ni hta, Shebuela alat rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eliaza a shadang sha alat Rehabia rai lu ai: Eliaza gaw shadang sha kaga n lu ai: rai timung, Rehabia kasha ni grai law ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izhara shadang sha, alat Shelomit rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hebron a shadang sha ni gaw, alat wa Yeria, lahkawng ngu na Amaria, masum ngu na Yahaziela, mali ngu na Yekameam rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uziela shadang sha yan gaw, alat Mihka hta Nnaw Ishia rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merari a shadang sha gaw, Mali yan Mushi rai ma ai. Mali a shadang sha gaw, Eleaza hte Kisha rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eleaza gaw shadang sha n lu ai, shayi sha hkrai shaprat nna si mat sai. Kanau Kisha a shadang sha ni gaw shanhte hpe la mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mushi a shadang sha ni gaw, Mali, Edera, Yeremot hte masum rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Da ndai gaw, asak hkun ning lai nna, Yehowa a nta hta amu gun hpai ai, Lewi shadang sha ni a kawa dap hkan nna, jahpan hta lawm ai amyu dap ni a agyi salang ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kaning rai nme law, Dawi gaw, Israela Karai Kasang Yehowa, shi a amyu masha ni hpe ban sa ai jaw ya nna, shi gaw Yerusalem mare hta tutnawng anga nga ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />Lewi masha ni mung, sumpan nta hte daw jau na matu dai hte seng ai arai ni hpe, ‘ya kaw nna htawm hpang de n hpai ra na sai,’ nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kaning rai nga yang, Dawi a hpang jahtum na ga hte maren, asak hkun ning lai ai Lewi a shadang sha ni hpe jahpan la mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lewi a kashu kasha ni a aya chyawm gaw, Arun a shadang sha ni hpe shingtep shingtau ai rai nga ai: dai rai nna shanhte gaw, Yehowa a nta hte, nta wang ni hta, gawk ni hta mung, chyoi pra ai arai ni mahkra hpe, Karai Kasang a nta hta shi hpe daw jau na matu, shachyoi shapra na mung;
  </para>
  <para style="p">
    <verse number="29" style="v" />madun da ai muk ni hpe, shadung hkungga jaw na matu mani ai shadung, matsi n rawng ai muk, di hta kabaw ai hpe rai timung, katsing rai timung, shadawn sharam ai lam shagu hta mung;
  </para>
  <para style="p">
    <verse number="30" style="v" />jahpawt shagu, shana shagu, Yehowa a chyeju hpe shakawn kungdawn na matu mung;
  </para>
  <para style="p">
    <verse number="31" style="v" />ga shaka hte maren, laban nhtoi e mung, shata praw e mung, ladaw da ai poi nhtoi hta mung, Yehowa man e, tutnawng wan nat hkungga nawng ya na matu mung,
  </para>
  <para style="p">
    <verse number="32" style="v" />shawa masha ni hpawng nga ai sum hpe mung, chyoi pra ai shara hpe mung, Yehowa a nta hta daw jau na matu mung, tinang a kahpu kanau Arun a kashu kasha ni hpe shingtep shingtau na matu san da ai hkrum ma ai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, da ndai gaw Arun a amyu hpung ni rai nga ma ai. Arun a shadang sha ni gaw, Nadab, Abihu, Eliaza, Ihtama hte rai ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nadab yan Abihu gaw shadang sha n shaprat ai, kawa a shawng e si mat ma ai; dai rai nna, Eliaza hte Ihtama gaw hkinjawng amu galaw ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dawi gaw, Eliaza kasha Zadok yan Ihtama a kasha Ahimelek hte rau, shan a amyu dap ni hpe, galaw ang ai amu hte maren, karan da mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ihtama kashu kasha ni hta, agyi salang ni, Eliaza a agyi salang ni grau law ma ai: shanhte hpe ning rai karan da mu ai: Eliaza a amyu dap ni hta agyi shi kru, Ihtama a amyu dap ni hta agyi matsat rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Eliaza a kashu kasha ni hta na mung, Ihtama a kashu kasha ni hta na mung, chyoi pra ai shara hte, Karai Kasang a amu gun hpai na agyi ni rai nga ma ai majaw, shanhte hpe hpaida hte karan lata la mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lewi amyu na, Nehtanela kasha, chyare wa Shemaia gaw, hkawhkam wa a man e mung, agyi salang ni a man e mung, hkinjawng Zadok a man e mung, Abiahta a kasha Ahimelek a man e mung, Lewi amyu na hkinjawng dap agyi ni a man e mung, shanhte a amying hpe ka da na, Eliaza a amyu dap hte Ihtama amyu dap hta na, langai hte langai hpe lata la mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya hpaida hte ang ai ni gaw, shawng e Yehoiariba hpe, lahkawng lang na Yedaia hpe;
  </para>
  <para style="p">
    <verse number="8" style="v" />masum lang na Harim hpe; mali lang na Seorim hpe;
  </para>
  <para style="p">
    <verse number="9" style="v" />manga lang na Malhkiya hpe; kru lang na Mayamin hpe;
  </para>
  <para style="p">
    <verse number="10" style="v" />sanit lang na Hakoza hpe, matsat lang na Abiya hpe;
  </para>
  <para style="p">
    <verse number="11" style="v" />jahku lang na Yeshua hpe, shi lang na Shehkania hpe;
  </para>
  <para style="p">
    <verse number="12" style="v" />shi langai lang na Eliashiba hpe, shi lahkawng lang na Yahkim hpe;
  </para>
  <para style="p">
    <verse number="13" style="v" />shi masum lang na Hupa hpe, shi mali lang na Yeshebea hpe;
  </para>
  <para style="p">
    <verse number="14" style="v" />shi manga lang na Bilga hpe, shi kru lang na Imera hpe;
  </para>
  <para style="p">
    <verse number="15" style="v" />shi sanit lang na Hezira hpe, shi matsat lang na Hapize hpe;
  </para>
  <para style="p">
    <verse number="16" style="v" />shi jahku lang na Pehtaia hpe, hkun lang na Yehezkela hpe;
  </para>
  <para style="p">
    <verse number="17" style="v" />hkun langai lang na Yahkin hpe, hkun lahkawng lang na Gamula hpe;
  </para>
  <para style="p">
    <verse number="18" style="v" />hkun masum lang na Delaia hpe, hkun mali lang na Mazi hpe lata la mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai gaw, Israela Karai Kasang Yehowa shanhte a kawa Arun hpe hkang da nna, Arun gaw shanhte hpe htawn tsun ai lam hte maren, Yehowa nta hta daw jau ai amu galaw na matu, san da ai hpung ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ya naw ngam ai Lewi a kashu kasha ni gaw, Amram a kasha ni hta Shubaela; Shubaela kasha ni hta na Yedea;
  </para>
  <para style="p">
    <verse number="21" style="v" />Rehabia kasha ni hta na, alat Ishia rai nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izharia kasha ni hta na Shelomit; Shelomit a kasha ni hta na Yahat rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hebron a kasha ni hta na, alat wa Yeria, lahkawng ngu na, Amaria, masum ngu na Yahaziela, mali ngu na Yekameam rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Uziela shadang sha Mihka; Mihka a shadang sha Shamira rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihka a kanau Ishia; Ishia kasha ni hta na Zehkaria rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Merari a kasha Mali yan Mushi; Yazia kasha Beno;
  </para>
  <para style="p">
    <verse number="27" style="v" />Merari a amyu, Yazia shadang sha ni gaw, Beno, Shoham, Zahkura, Ibri hte rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mali kasha Eliaza gaw shadang sha n lu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kisha a kasha Yeramela rai lu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mishi a kasha ni hta na Mali, Edera, Yerimot rai ma ai. Da ndai gaw Lewi a kashu kasha ni a kawa dap ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shanhte mung, shanhte a kahpu kanau Arun a kashu kasha ni hte maren, Hkawhkam Dawi hte Zadok yan Ahimelek a man e mung, Lewi amyu na, hkinjawng hpung ni a agyi salang ni a man e mung, hpaida hte lata la nna, kanau a amyu dap ni hpe lata la mu ai hte maren, shanhte hpe mung lata la mu ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hta kaga, Asap, Heman, Yeduhtun a kashu kasha nkau mi tingse, duria, shupsheng dum let, myihtoi htoi na matu, Dawi hte luksuk ni a bu ni gaw shanhte hpe san da mu ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />san da ai hpung ni hte maren, amu galaw ai ni a nambat gaw, Asap a kashu kasha ni hta na, Zahkura, Yawsep, Nehtania, Asharela hte rai ma ai; shanhte gaw hkawhkam wa tawn da ai lam hte maren, kawa Asap a lawu e myihtoi htoi ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai, Yeduhtun amyu na, Yeduhtun a kashu kasha ni gaw Gedalia, Zeri, Yeshaia, Hashabia, Matihtia hte, kru rai ma ai; shanhte gaw kawa Yeduhtun a lawu e, tingse dum let, Yehowa chyeju hpe shakawn kungdawn nna, myihtoi htoi ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Heman amyu na, Heman a kashu kasha ni gaw, Bukia, Matania, Uziela, Shebuela, Yerimot, Hanania, Hanan, Eliahta, Gidalti, Romamti-ezera, Yoshbekasha, Malohti, Hohtira, Mahaziot hte rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte mahkra gaw hkawhkam a myihtoi wa Heman a lawu e pahtau dum let, Karai Kasang hpe shakawn ma ai. Karai Kasang gaw Heman hpe shadang sha shi mali hte shayi sha masum jaw ya wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte mahkra gaw, Yehowa a nta hta mahkawn mangoi na hte, shupsheng, duria, tingse dum let Karai Kasang a nta hta daw jau na matu, shanhte a kawa a lawu e rai nga ma ai; Asap, Yeduhtun hte Heman gaw hkawhkam a hkang da ai ga hte maren galaw ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte hte shanhte a kahpu kanau ni hte hpawn, Yehowa hpe mahkawn mangoi na hpaji lu ai ni yawng hte gaw, marai ni tsa e matsat shi matsat rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai aya lu la na matu shanhte hta kaji kaba, hte sape yawng, hpaida hte lata la ai maren hkrum ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shawng na hpaida gaw Asap amyu na Yawsep hta ang wa ai; lahkawng lang na Gedalia hta ang ai: shi hte shi a kahpu kanau ni hte shi a shadang sha ni, marai shi lahkawng rai ma ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />masum lang na, Zahkura hte shi a shadang sha ni hte shi a kahpu kanau ni, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />mali lang na, Izri hta shi a shadang sha ni hte shi a kahpu kanau ni, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />manga lang na, Nehtania hte, shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />kru lang na, Bukia hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai;
  </para>
  <para style="p">
    <verse number="14" style="v" />sanit lang na, Yesharela hte shi a shadang sha ni hte kahpu kanau shi lahkawng hta ang ma ai;
  </para>
  <para style="p">
    <verse number="15" style="v" />matsat lang na, Yeshaia hte, shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />jahku lang na, Matania hte, shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />shi lang na, Shime hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />shi langai lang na, Azarela hte shi a kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />shi lahkawng lang na, Hashabia hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />shi masum lang na, Shubaela hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />shi mali lang na, Matihtia hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />shi manga lang na, Yeremot hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />shi kru lang na, Hanania hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />shi sanit lang na, Yoshbekasha hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shi matsat lang na, Hanan hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />shi jahku lang na, Malohti hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />hkun lang na, Eliahta hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="28" style="v" />hkun langai lang na, Hohtira hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="29" style="v" />hkun lahkawng lang na, Gidalti hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="30" style="v" />hkun masum lang na, Mahaziot hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai:
  </para>
  <para style="p">
    <verse number="31" style="v" />hkun mali lang na, Romamti-ezera hte shi a shadang sha ni hte kahpu kanau, shi lahkawng hta ang ma ai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, chyinghka sin ai hpung ni gaw: Kora amyu hta na, Asap a dap, Kore a kasha Meshelemia rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meshelemia gaw shadang sha shaprat ai: kasha alat gaw Zehkaria; lahkawng ngu na, Yediela; masum ngu na, Zebadia; mali ngu na Yatniela;
  </para>
  <para style="p">
    <verse number="3" style="v" />manga ngu na, Elam; kru ngu na Yehohan; sanit ngu na Elihonai hte rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Obed-edom mung shadang sha shaprat wu ai: kasha alat gaw Shemai; lahkawng ngu na Yehozaba; masum ngu na Yoa; mali ngu na Sahkara; manga ngu na Nehtanela;
  </para>
  <para style="p">
    <verse number="5" style="v" />kru ngu na Amiela; sanit ngu na Isahka; matsat ngu na Peulhtai rai ma ai: kaning rai nme law, Karai Kasang shi hpe shaman ya wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi a kasha Shemaia mung, shadang sha shaprat wu ai: shanhte gaw kawa nta dap ni hpe up ma ai: hpa majaw nga yang, shanhte gaw nden ja ai wa-ngan ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shemaia shadang sha ni gaw, Otni, Rehpaela, Obed, Elzaba hte n-gun ja ai shi a kanau Elibu Semahkia hte rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ni mahkra gaw Obed-edom a kashu kasha ni rai ma ai: shanhte mung, shanhte a kashu kasha ni hte kahpu kanau ni mung, daw jau na matu n-gun ja ai ni rai nga ma ai; Obed-edom hta na yawng marai kru shi lahkawng rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meshelemia mung, n-gun ja ai shadang sha hte kahpu kanau shi matsat rai lu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Merare amyu na Hosa mung shadang sha lu nga ai; Shimri gaw kasha alat n rai tim kawa gaw shi hpe kasha alat shatai wu ai;
  </para>
  <para style="p">
    <verse number="11" style="v" />lahkawng ngu na Hilkia, masum ngu na Tebalia; mali ngu na Zehkaria hte rai ma ai: Hosa a shadang sha ni hte kahpu kanau ni yawng marai shi masum rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Da ndai gaw Yehowa nta hta daw jau na matu, shanhte a kahpu kanau ni hte maren aya lu ai chyinghka sin ai ni a agyi dap ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte kaji kaba langai hte langai hpe tinang a kawa dap hkan nna, chyinghka sin na matu hpaida hte lata la mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sinpraw chyinghka, Shelemia hta ang wa ai. Dai hpang shanhte gaw hpaji daw chye ai, shi a kasha Zehkaria matu hpaida da nna, shi gaw dingdung maga ang wa ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Obed-edom gaw dingda maga ang wa ai: shi a kasha ni gaw, rai tawn da ai nta hpe sin nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shupim hte Hosa gaw Shalek chyinghka makau na lung wa ai lam e, sin langa htap mi hte htap mi sin na matu, sinna maga ang wa ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shani shagu sinpraw maga de Lewi masha kru; dingdung maga de mali, dingda maga de mali; arai tawn da ai nta matu marai lahkawng hkawng;
  </para>
  <para style="p">
    <verse number="18" style="v" />sinna maga na Parabara shara hta lam sin na matu marai mali, Parabara matu lahkawng rai nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Da ndai gaw, Merari amyu Kora kashu kasha ni hta na chyinghka sin ai hpung ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Lewi masha Ahiya gaw, Karai Kasang nta na sutdek hte, chyoi pra ai arai ni a sutdek ni hpe up nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gershon a amyu Ladan hta na kawa dap ni a agyi, Ladan a shadang sha Yehiela rai nga ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehiela a shadang sha Zehtam hte shi a kanau Yoela gaw, Yehowa nta na sutdek hpe up nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amram amyu, Izhari a amyu, Hebron amyu hte Uziela amyu masha ni hta na nkau mi mung lawm ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mawshe a dap Gershom a kasha Shebuela gaw sutdek ni hpe up nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi a kanau ni hta na Eliezera, rai nga ai: Eliezera kasha Rehabia a kasha Yeshaia, shi a kasha Yoram, shi a kasha Zihkri, shi a kasha Shelomot rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shelomot hte shi a kanau ni gaw, hkawhkam Dawi hte kawa dap ni agyi ni ngu ai, hpyen ma hkying mi, hpyen ma latsa hte luksuk laba ni a bu ni tawn da ai chyoi pra ai sut rai ni mahkra hpe up nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hpyen gasat nna lu la ai lanep hta na, Yehowa nta hpe lajang na matu, shanhte majai tawn da mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Myihtoi Samuela, Kisha kasha Shawlu, Nera a kasha Abna, Zeruia kasha Yoab hte gaw, majai tawn da ai rai yawng mayawng hpe, Shelomot hte shi a kanau ni up nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Izhari a amyu hta na Hkenania hte shi a shadang sha ni gaw, du hte tara agyi tai nna, Israela mungdan a magam amu gun hpai ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hebron amyu hta Hashbia hte shi a kanau ni nden ja ai masha hkying me sanit tsa hte gaw, Yawdan hka sinna maga de nga ai, Israela amyu hta du tai nna, Yehowa hpe daw jau ai amu hte hkawhkam wa magam amu mahkra hpe gun hpai nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hebron amyu hta na, Hebron masha ni a kawa dap hkan yang, Yeriya gaw agyi rai nga ai. Dawi hkawhkam tai ai mali shi ning hta e, dai amyu ni hpe jahpan la yu yang, Gilead mung na Yazera mare hta nden ja ai masha mu hkrup ma ai,
  </para>
  <para style="p">
    <verse number="32" style="v" />Shi a kanau ni, nden ja ai masha kawa dap ni a agyi ni, marai hkying lahkawng sanit tsa hte gaw, Dawi hkawhkam san da ai hte maren, Rubin amyu, Gad amyu, Manashe amyu chyen mi hpe up nna, Karai Kasang hte hkawhkam wa a magam bungli shagu hpe gun hpai na matu, san da mu ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hkawhkam wa a amu gun hpai nna, shata mi hte shata mi, shaning ting hta, tinang a hpung hte maren galaw ai masha ni gaw, kawa ni a dap hkan nna, hpyen ma hkying mi, hpyen ma latsa up ai bu ni a mying sawn nna, sa sa wa wa re ai ni hpe ningja yang, masha mun lahkawng hkying mali li rai nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shawng na ta hta, shawng na hpung hpe up ai wa gaw, Zabdiela kasha Yeshobeam rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw Paret a kashu kasha ni hta na rai nna, shawng na ta na luksuk bu mahkra ni a agyi rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shata lahkawng na hpung hpe up ai wa gaw Ahohi amyu Dodai rai nga ai: Miklot gaw du rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shata masum hta na sin langa ni a hpyen du masum ngu na wa, hkinjawng Yehoiada a kasha Benaia rai nga nna, agyi rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai Benaia gaw share kaba rai nga ai hte, dai share sumshi hta lawm nna shanhte a agyi rai nga ai: shi a kasha Amizaba mung shi a hpung hta lawm nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shata mali hta na mali ngu na hpyen du wa, Yoab a kanau Asahela hte, shi a kasha Zebadia gaw shi a lawu e rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shata manga hta na manga ngu na hpyen du wa gaw, Izraha amyu Shamhut rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shata kru hta kru ngu na hpyen du wa gaw Teko masha Ikesha kasha Ira rai nga ai; shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shata sanit hta na sanit ngu na hpyen du wa gaw, Ehprim amyu, Peloni dap na Helet rai nga ai; shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shata matsat hta na matsat ngu na hpyen du wa gaw, Zerahi amyu, Hushai dap na Sibehkai rai nga ai; shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shata jahku hta na jahku ngu na hpyen du wa gaw, Ben-yamin amyu, Anahtot dap na Abiezera rai nga ai; shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shata shi hta na shi ngu na hpyen du wa gaw, Zerahi amyu, Netohpat dap na Maharai rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shata shi langai hta na shi langai ngu na hpyen du wa gaw, Ehprim amyu, Perahton dap na Benaia rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shata shi lahkawng hta na shi lahkawng ngu na hpyen du wa gaw, Otniela amyu, Netohpat dap na Heldai rai nga ai: shi a hpung hta marai mun lahkawng hkying mali lawm ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai, Israela ntsa e up ai du ni gaw: Rubin amyu hta, Zihkri a kasha du Eliezera; Simun amyu hta, Mahka a kasha Shehpatia;
  </para>
  <para style="p">
    <verse number="17" style="v" />Lewi amyu hta Kemuela kasha Hashabia; Arun dap hta, Zadok;
  </para>
  <para style="p">
    <verse number="18" style="v" />Yuda amyu hta, Dawi a kahpu Elihu: Yisahka amyu hta, Mihkaela kasha Omri;
  </para>
  <para style="p">
    <verse number="19" style="v" />Zebulun amyu hta Obadia kasha Ishmaia; Naphtali amyu hta, Azriela kasha Yeremot;
  </para>
  <para style="p">
    <verse number="20" style="v" />Ehprim amyu hta, Azazia kasha Hoshea; Manashe amyu chyen mi hta, Pedaia kasha Yoela;
  </para>
  <para style="p">
    <verse number="21" style="v" />Gilead mung na manashe amyu chyen mi hta, Zehkaria kasha Ido; Ben-yamin amyu hta, Abna a kasha Yasiela;
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan amyu hta, Yeroham a kasha Azarela hte rai ma ai. Da ndai gaw Israela amyu ni hta up ai du ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung, Yehowa gaw Israela kashu kasha ni hpe lamu na shagan ni zawn shalaw na nme ai, nga ai majaw, Dawi gaw asak hkun ning n du ai ni hpe jahpan laika hta n shalawm mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeruia kasha Yoab gaw dai jahpan la hpang timung, n shangut lu wu ai: dai lam majaw Israela ntsa e tsin-yam tsindam du pru ai; hti lu ai nambat hpe mung, hkawhkam Dawi a labau laika hta n ka shalawn wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai, Adiela kasha Azmawet gaw, hkawhkam a kunhting wa rai nga ai: Uzia kasha Yonahtan gaw, yi hkauna, mare kahtawng hte hpyen dap ni a sutdek ni hpe up nga ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />Hkelub a kasha Ezri gaw, yi hkauna galaw ai ni hpe up nga ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />Ramat masha Shime gaw tsabyi sun ni hpe up nga ai: Shipmi amyu na Zabdi gaw tsabyi si hte tsabyi jahku tawn da ai nhkun ni hpe up nga ai;
  </para>
  <para style="p">
    <verse number="28" style="v" />Gederi masha Bala-hanan gaw, layang ga e tu ai tsanlun hpun hte lakum hpun ni hpe up nga ai: Yoasha gaw tsanlun sau nhkun ni hpe up nga ai:
  </para>
  <para style="p">
    <verse number="29" style="v" />Sharon masha Shitrai gaw, Sharon udat na yamnga hpung ni hpe up nga ai: Adlai kasha Shahpat gaw kadit hkan na yamnga hpung ni hpe up nga ai:
  </para>
  <para style="p">
    <verse number="30" style="v" />Ishmaela masha Obila gaw gawla-uk hpung ni hpe up nga ai: Meron masha Yedia gaw lawze ni hpe up nga ai: Hagri masha Yazi gaw sagu bainam hpung ni hpe up nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai ni mahkra gaw hkawhkam Dawi a sutgan hkrai up ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bai, Dawi a kawa di Yonahtan gaw, myit su ai wa rai nga nna, bawmung hte chyare wa rai nga ai: Hakmoni a kasha Yehiela gaw hkawhkam kasha ni a kanawn manang rai nga ai:
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahihtohpela gaw hkawhkam a bawmung rai nga ai: Arhki masha Hushai gaw hkawhkam a jinghku rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahihtohpela lawu e Benaia kasha Yehoiada hte Abiahta rai nga ma ai: Yoab gaw hkawhkam a luksuk laba ni a bu rai nga ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Dawi gaw, Israela du agyi ni ngu ai, amyu ni a du agyi ni hpe, hkawhkam wa san da ai sin langa ni a bu ni hpe, hpyen ma hkying mi up ai bu ni hpe, latsa up ai bu ni hpe, hkawhkam wa hte shi a kasha ni a sut rai yawng up ai kunhting ni hpe, du ni hte nden ja ai share ni yawng mayawng hte hpe, Yerusalem mare e zuphpawng shangun mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Dawi hkawhkam sa tsap nna, “Nye a hpunau ni hte amyu masha ni e, nye a ga madat mara ya mi: Yehowa a ga shaka sumpu shanu nga na shara hte, anhte a Karai Kasang a lagaw kabye lahkum nga na nta galaw na ngai myit hkut nna, dai nta matu arai hkyen da se ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai timung Karai Kasang gaw, Nang hpyen gasat ai wa rai nga ndai hte, sai jahkaw kau ai majaw, nye mying nsang a matu nta galaw lu na nrai,” nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Shing nga timung, Ngai Israela amyu ntsa e prat dingsa e hkawhkam tai na nga Israela Karai Kasang Yehowa nan, nye wa nta na ngai hpe lata la ni ai; kaning rai nme law, agyi amyu tai na matu Yuda amyu hpe shi lata la wu ai: Yuda amyu hta nye wa nta hpe mung, Israela amyu yawng a ntsa e up na matu, nye wa a shadang sha ni hta shi ngai hpe sharawng awng ni ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />ngai shadang sha law law mayat timung, ngai sha Shawlumon langai hpe chyu sha shi lata la nna, Israela amyu ntsa e up let, Yehowa a mungdan tingnyang hta dung shangun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai hpe mung, Na nsha Shawlumon gaw nye nta hte nye a wang ni hpe galaw na ra ai: ngai shi hpe kasha yin la nna, ngai shi a kawa tai na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw nye a hkang da ai ga hte matsun maroi ga hpe, dai ni na zawn, tutnawng hkan shatup a yang gaw, ngai shi a mungdan hpe htani htana prat dingsa shagrin da na we ai,” nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Dai re ai majaw, ndai mai kaja ai mungdan hpe nanhte madu lu nna, nanhte a kashu kasha shu mashi shu masha prat du hkra, sali wunli tai lu na matu, Yehowa shawa hpawng ngu ai, Israela a man e mung, anhte a Karai Kasang na lu ai a majaw mung, nanhte a Karai Kasang Yehowa hkang da ai ga yawng mayawng hte hpe hkan shatup nga mu law.”
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ya chyawm gaw, ngai sha Shawlumon e, na nwa a Karai Kasang hpe chye u: ngwipyaw ai myit hte tsawra ai kraw lawang hte, shi hpe daw jau u; Yehowa gaw myit masin mahkra hpe sawk yu nna, myit mamyit lam mahkra hpe chye ya nga ai: nang shi hpe tam yang, mu na wu ai; shi hpe kau da yang, nang hpe tutnawng kau da na ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, sadi nga u; chyoi pra ai shara matu nta galaw na, Yehowa nang hpe lata la nit dai: da ting nga nna galaw u, ngu dat wu ai.”
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hpang Dawi gaw shi a kasha Shawlumon hpe, nta jan na kasi hte, nta a, sutdek ni a, ntsa gawk na, kata gawk na hte chyeju magap tawn da ai gawk na kasi kamang hpe mung;
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa a nta wang ni, grup yin e nga ai gawk ni, Karai Kasang a nta a sutdek ni hte majai tawn ai sut rai sutdek ni a kasi kamang ni hpe mung, shi a myit wenyi hta rawng ai hte maren, madun dan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hta kaga shi gaw, hkinjawng ni hte Lewi hpung ni a matu mung; Yehowa a nta hta daw jau na amu mahkra hte, Yehowa a nta hta daw jau na matu arai mahkra hpe mung;
  </para>
  <para style="p">
    <verse number="14" style="v" />daw jau yang, lam shagu hta lang ra ai aja rai ni a matu shen da ai aja; daw jau yang, lam shagu hta lang ra ai gumhpraw rai ni matu shen da ai gumhpraw:
  </para>
  <para style="p">
    <verse number="15" style="v" />ja pyengdin shadun hte de a pyengdin ni langai hte langai a matu shen da ai aja; gumhpraw pyengdin shadun hte de a pyengdin langai hte langai a matu mung lang ra ai hte maren, ja gumhpraw shen ya wu ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />madun dan ai muk ni a aja ku, langai hte langai a matu aja; gumhpraw ku a matu gumhpraw mung shen ya wu ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />chyinghkyi ni, angdung ni, gawm ni gaw, ja jet rai nga ai: aja gawm ni, langai hte langai a matu, ja jet shen ya wu ai: gumhpraw gawm ni, langai hte langai a matu gumhpraw shen ya wu ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />manam pyaw ai baw nat na hkungri a matu ja jet shen ya wu ai: singkaw shachyen nna, Yehowa a ga shaka sumpu hpe ka-up nga ai hkerubim leng sumla a kasi kamang matu mung, aja shen ya wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi Dawi gaw, “Ndai amu hte de a kasi kamang ni yawng mayawng, Yehowa a lata hte nye a ntsa e ka da nga ai majaw, ngai hpe chye na shangun nngai,” nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Dawi gaw shi a kasha Shawlumon hpe, “N-gun da ting nna myit nden shaja u; dai amu hpe galaw u; hkum hkrit et; myit hkum hten et; nye a Karai Kasang, Karai Kasang Yehowa, nang hte rau rai nga ai: daw jau na amu matu Yehowa nta ngut wa lu hkra, nang hpe shinggan kau na, nang hpe kau da na, n rai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai, Yu u, Karai Kasang nta na daw jau na amu mahkra a matu, hkinjawng hte Lewi hpung ni nga ma ai: daw jau na matu, hpa baw amu rai timung, chye chyang ai ni kadai mung, nang hte rau nga nga na mara ai: hpyen du ni hte mung masha ni gaw, na a hkang ai ga hkrai hkan nang na mara ai,” ngu wu ai.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai hkawhkam Dawi gaw dai shawa hpawng ting hpe, “Karai Kasang lata la ai, ngai sha Shawlumon, asak naw kaji ai hte myit garai n kung nga ai; amu mahtang kaba nga ai: dai htingnu gaw masha matu nrai, Karai Kasang Yehowa matu rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya ngai gaw nye a n-gun lagaw mahkra hte nye a Karai Kasang a nta matu, aja rai ni a matu aja, gumhpraw rai ni a matu gumhpraw, magri rai ni a matu magri, hpri rai ni a matu hpri, hpun rai ni a matu hpun; unuk nlung hte, tawk hkrep na matu ahpraw nsam amyu myu pru ai lungseng baw shagu mung, lunghpraw law law mung, ngai mahkawng hkyen da se ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hta kaga, Karai Kasang a nta hta nye a myit manoi nga ai hte, ngai hkum nan lu ai aja gumhpraw sut rai naw nga ai majaw, nye a Karai Kasang a chyoi pra ai nta matu, ngai mahkawng da ai hta n-ga,
  </para>
  <para style="p">
    <verse number="4" style="v" />nta shakum ni hpe tawk sup na matu, ngai hkum nan lu ai Ohpira ja joi hkying masum; jet ai gumhpraw joi hkying sanit hpe mung,
  </para>
  <para style="p">
    <verse number="5" style="v" />tawk chye ai masha ni a lata hte amu amyu myu galaw na matu, aja rai ni a matu aja, gumhpraw rai ni a matu gumhpraw, ngai jaw da ni ai. Dai rai yang, dai ni jang, Yehowa hpe tinang a kumhpa sa nawng ya na, kadai wa rai ta?” ngu nna san mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi, kawa dap ni a agyi ni, Israela amyu du ni, hpyen ma hkying mi up ai, latsa up ai bu ni hte, hkawhkam wa amu gun hpai ai agyi ni gaw, tsawra ai myit hte kumhpa nawng ya nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang a nta e daw jau na amu matu, aja joi mun manga, ja den-ga mun mi, gumhpraw joi sen mi, magri joi mun me hkying matsat, hpri joi sen mi, sak jaw mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungseng lu ai ni mung, Gershon masha Yehiela lata hte, Yehowa nta a sutdek hta sa bang da mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna shanhte gaw tsawra hkum tsup ai myit hte Yehowa hpe kumhpa sak jaw lu ai majaw, kabu gara shajang ma ai; hkawhkam Dawi mung ja ja kabu gara nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai re ai majaw, Dawi gaw shawa hpawng ting a man e Yehowa hpe shakawn kungdawn let, “Anhte a Wa, Karai Kasang Yehowa e, nang gaw htani htana prat dingsa, a nga n ga law.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa e, daru magam, n-gun atsam, hpung shingkang, padang ninglaw hte arawng sadang nang hta anga nga ai law: sumsing lamu hte ginding aga ntsa nga manga hpe nang madu nga ndai; Yehowa e, dai mungdan gaw na a mungdan rai nga ai hte, nga yawng nga pra ntsa e nang grau nga ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sutgan hte arawng sadang nang kaw na rai nga nna, nang gaw yawng mayawng a ntsa e up nga ndai; na a lata hta ahkang aya hte n-gun atsam rawng nga ai; nang gaw na a lata hte shagrau shatsaw lu nna, yawng mayawng hpe n-gun lagaw jaw lu nga ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai re ai majaw, anhte a Karai Kasang e, na a chyeju hpe anhte dum nna, na a hpung shingkang rawng ai mying ningsang shakawn kungdawn nga ga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rai timung, tsawra ai myit hte ndai daram wa jaw ya ai lu hkra, ngai mung, nye a amyu masha ni mung, hpa wa mi rai nga a hka? Yawng mayawng nang kaw na rai nga nna, nang kaw na arung arai hkrai, anhte nang hpe jaw ga ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />anhte gaw ji wa ni mahkra zawn, na a man e tsasam masha hte malet nhprang manam hkrai rai nga ga ai: anhte a ga ntsa e nga ai nhtoi hte gaw, shingnip hte bung nna myit mada shara n nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anhte a Karai Kasang Yehowa e, na a amying nsang a matu nta galaw na nga, anhte hkyen tawn da ai arai ni yawng, na a lata na rai nga ai, mahkra hpe nang madu nga ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a Karai Kasang e, nang gaw kraw lawang hpe dinglik yu nna, dinghpring ai myit hpe sharawng nga ndai, ngai chye nga nngai. Ngai gaw nye dinghpring ai hta, tsawra ai myit hte ndai arung arai yawng mayawng sak jaw nngai: dai hta kaga, nang e hpawng nga ai, na a amyu masha ni mung nang hpe sak jaw ai lam, kabu gara ai myit hte ngai mada mu nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte a ji wa Abraham, Isak, Israela a Karai Kasang Yehowa e, na a masha ni gaw ndai lam hpe tutnawng prat dingsa dum nga lu hkra, shanhte a myit nang hpang de kayin shagrin ya mu:
  </para>
  <para style="p">
    <verse number="19" style="v" />ngai sha Shawlumon hpe mung, na a hkang da ai ga, sakse ga, matsun maroi ga hte lam yawng mayawng hte hte, ngai hkyen tawn ai htingnu hpe galaw shangut lu na matu, hkum tsup ai myit jaw ya e law,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Dawi gaw, shawa hpawng ting hpe, “Nanhte a Karai Kasang Yehowa hpe ya shakawn kungdawn mu,” ngu mu yang, shawa hpawng ting gaw, shanhte a kaji kawa ni a Karai Kasang Yehowa hpe shakawn kungdawn nna, gum dagup let, Yehowa hpe mung, hkawhkam wa hpe mung, nawku mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hpang jahpawt e shanhte gaw Yehowa hpe shagu hkungga, Yehowa hpe wan nat hkungga, usu hkying mi, sagu la hkying mi, sagu kasha hkying mi hte hpawn, dumhpung hkungga hte, Israela matu shagu hkungga law law nawng ya nna,
  </para>
  <para style="p">
    <verse number="22" style="v" />dai shani e kabu gara ai myit kaba hte, Yehowa a man e lu lu sha sha rai nga ma ai. Dai hta kaga shanhte gaw Dawi a kasha Shawlumon hpe lahkawng lang ngu na hta hkawhkam aya dang ya nna, Yehowa a lawu e du tai na matu, shi hpe namman chya ya mu ai; Zadok hpe mung hkinjawng aya dang da mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna Shawlumon gaw, shi a kawa Dawi a malai, hkawhkam tai nna, Yehowa a tingnyang hta dung let galu kaba nga ai; Israela amyu ting shi a ga madat mara nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Du gyi salang ni, nden ja ai share ni hte Dawi hkawhkam a shadang sha ni yawng hte pyi, Shawlumon hkawhkam up hkang ai npu e rai nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa gaw Shawlumon hpe Israela amyu ting a man e ja ja shagrau shatsaw da nna, shi a shawng na Israela hkawhkam ni n hkam la yu ai hkawhkam daru magam jaw da wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya Yese a kasha Dawi gaw Israela mungdan ting hpe up nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israela ntsa e up nga ai aten gaw, mali shi ning rai nga ai: Hebron mare hta e sanit ning, Yerusalem e sumshi masum ning up nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dawi gaw ngamu ngamai daru magam rawng let, dingla ugut gu prat htum nna si mat wa sai: shi a kasha Shawlumon gaw shi a malai hkaw dung nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dawi hkawhkam tai ai lam npawt ndung hkren, up hkang ai lam, daru magam hte kajai gumhkawng ai lam ni hte hpawn, Israela mungdan hte kaga mungdan ni yawng hta byin mabyin mahkra gaw,
  </para>
  <para style="p">
    <verse number="30" style="v" />myihtoi Samuela laika, myihtoi Nahtan a laika, myihtoi Gad a laika ni hta ka da nga ai.
  </para>
</usx>
