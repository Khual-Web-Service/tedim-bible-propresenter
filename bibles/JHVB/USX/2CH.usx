<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="2CH" style="id">2 Hkawhkam Labau</book>
  <para style="h">2 Hkawhkam Labau</para>
  <para style="toc1">2 Hkawhkam Labau</para>
  <para style="toc2">2 Hkawhkam Labau</para>
  <para style="mt">2 Hkawhkam Labau</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Dawi a kasha Shawlumon gaw shi a mungdan hta grin wa ai hte, shi a Karai Kasang Yehowa gaw shi hte rau rai nga nna, shi hpe nachying shagrau da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Shawlumon gaw, Israela shawa hpawng ting, hpyen ma hkying mi up ai, latsa up ai bu ni, tara agyi ni, Israela du agyi ni ngu ai, tinang a kawa dap ni a agyi salang ni yawng hpe shaga bawng yu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai Shawlumon hte rau shawa hpawng ting, Gibeon a tsaw ai kawng de lung wa ma ai; kaning rai nme law, Yehowa a shangun ma Hawshe nam mali hkan e galaw ai, Karai Kasang a shawa sum, dai yang e nga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang a sumpu hpe chyawm gaw, Kiriat-yarim shara kaw nna Dawi hpai la wu ai rai nna, Yerusalem mare hta de a matu lajang gap da ai sum hta tawn da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rai timung, Hura kasha Uri a kasha Bezalela galaw ai magri hkungri gaw, Yehowa a sumpan sum man e, dai yang e naw nga nga ai rai nna, Shawlumon hte shawa hpawng ting dai hpe tam nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai Shawlumon gaw shawa sum hta e Yehowa a man e nga ai, magri hkungri de du nna, dai hkungri ntsa e wan nat hkungga hkying mi nawng ya wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai shana e Karai Kasang gaw Shawlumon hpe shi hkum shadan dan let, Ngai nang hpe hpa jaw na, hpyi e, ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Shawlumon gaw Nang Karai Kasang nye wa Dawi hpe chyeju myit kaba madun dan nna, shi a malai ngai hpe hkawhkam shatai nit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya, Yehowa Karai Kasang e, ga ntsa na ga nhpu zawn law ai masha amyu a ntsa e nang ngai hpe hkawhkam shatai ai majaw, nye wa Dawi hpe tsun da ai ga ndat shagrin da u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai amyu masha ni a man e ngai pru pru shang shang rai lu n ga, hpaji byeng-ya hte chye chyang ai myit ngai hpe jaw e law; ndai daram galu kaba ai, na a amyu hpe, kadai wa jeyang lu na rai nga a ta? ngu nna Karai Kasang hpe hpyi wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Karai Kasang gaw Shawlumon hpe, Ndai lam nang myit rawng nna, sutgan, arung arai, arawng sadang, nang hpe hpyen ai ni a asak hte, aprat galu mung, n hpyi ai sha, ngai nang hpe hkawhkam shatai ai amyu masha ni hpe jeyang lu hkra, hpaji byeng-ya hte chye chyang ai myit nang hpyi ndai majaw,
  </para>
  <para style="p">
    <verse number="12" style="v" />hpaji byeng-ya hte chye chyang ai myit nang hpe jaw da ni ai: dai hta kaga, na a shawng na hkawhkam ni mung n lu la yu ai hte, na a hpang na hkawhkam ni mung n dep lu hkra, sutgan, arung arai, arawng sadang ngai nang hpe jaw na de ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Shawlumon gaw Gibeon a shara na tsaw ai kawng e nga ai shawa sum man na pru nhtawm, Yerusalem mare de bai wa nna, Israela amyu ntsa e up nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai Shawlumon gaw gumra leng ni hte gumra jawn ai ni hpe lahkawn la mu ai: shi gaw leng hkying mi mali tsa hte gumra jawn ai ni mun me hkying lahkawng lu nna, leng ni rem da ai mare ni hte, Yerusalem mare na hkawhkam nta hta tawn da shajang mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai hkawhkam wa gaw Yerusalem mare hta e aja gumhpraw hpe nlung zawn, arit hpun hpe layang ga na lakum hpun zawn shalaw wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shawlumon rem la ai gumra ni gaw Egutu mung na pru nna, hkawhkam a hpaga ga ai ni hpung mi hte hpung mi manu sawn nna mari la mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Egutu mung na gumra leng langai mi gaw gumhpraw shekela kru tsa, gumra langai mi latsa manga shi ging nga ai: dai hte maren, shanhte gaw Hiti hte Suri hkawhkam ni mahkra a matu mung hkan mari tawn ma ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Shawlumon gaw Yehowa a amying nsang matu nta, shi a mungdan a matu nta ga kaw na hkang da mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna Shawlumon gaw, lit gun hpai ai ni mun sanit, bum ga de nlung tawk nga ai ni mun matsat, shanhte hpe up na matu marai hkying masum kru tsa hte hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shalai Shawlumon gaw Turu hkawhkam Huram hpang de shangun dat nna, Nye wa Dawi a nta galaw na matu, nang arit hpun jaw dat ai hte maren, ngai hpe mung chyeju galaw e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yu u, Israela amyu ni tutnawng prat dingsa htung nga ai hte maren, anhte a Karai Kasang Yehowa man e manam pyaw ai baw nat nawng na matu mung, jahpawt, shana, laban nhtoi, shata praw shani hte madat da ai poi shagu hta wan nat hkungga nat nawng na matu mung, nye a Karai Kasang Yehowa a mying nsang a matu, chyoi pra san da ai nta gaw da na, ngai galaw magang nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte a Karai Kasang gaw hpara ni mahkra hta grau nga ai majaw, ngai galaw na ra ai nta gaw galu kaba nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sumsing lamu hte sumsing lamu ni a sumsing lamu gaw, shi hpe n rawng da lu ai rai yang, shi a matu nta galaw na, kadai wa rai nga a ta? shi a man e manam pyaw ai baw nat nawng na hta kaga, shi a matu nta galaw na, ngai hpa wa mi rai nga n hka?
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai re majaw, Yuda mung hte Yerusalem mare hta ngai hte rau nga ai, nye wa Dawi san da ai maka pru ai ni hte rau nga lu hkra, aja, gumhpraw, magri, hpri hpe mung, hkyeng kabrim ai, gaja hkyeng ai, mut ai sumpan hpe mung, lam shagu hta tawk ka chye ai hpe mung, lam shagu hta tawk ka chye ai hpe mung, maka pru ai wa langai mi shangun dat ya e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hta kaga, Lebanon bum na arit hpun, marau hpun hte algum hpun ni hpe jaw dat e; na a shangun ma ni gaw, Lebanon bum ga na ngau chye shaw ma ai, ngai chye n ngai;
  </para>
  <para style="p">
    <verse number="9" style="v" />ngau law law lu la hkra, nye a shangun ma ni na a shangun ma ni hte rau amu galaw na ma ai; kaning rai nme law, ngai galaw magang nga ai nta gaw, galu kaba ai hte mauhpa nta rai na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya yu u, ngau shaw ai, na a shangun ma ni hpe, hkaulan mam dang mun lahkawng, muk-yaw mam mun lahkawng, tsabyi jahku bat mun lahkawng, tsanlun sau mun lahkawng, ngai jaw na nngai, ngu nna tsun dat wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Turu hkawhkam Huram gaw Shawlumon hpang de laika shagun dat nna, Yehowa gaw shi a amyu hpe tsawra ai majaw, shi nang hpe shanhte a ntsa e hkawhkam shatai nit dai, nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai Huram gaw, Yehowa a matu nta hpe mung, shi a mungdan a matu nta hpe mung galaw na nga, myit su ai hte hpaji byeng-ya rawng ai kasha, Dawi hpe jaw ya ai, sumsing lamu hte ginding aga hpe hpan tawn da ai Israela Karai Kasang Yehowa gaw, a nga u ga law.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hta kaga hpaji hparat zai byeng-ya rawng ai, nye wa Huram a ma langai mi hpe ngai shangun dat nngai:
  </para>
  <para style="p">
    <verse number="14" style="v" />shi a kanu gaw Dan numsha, kawa gaw Turu mare na masha rai nga ai; dai wa gaw, aja gumhpraw, magri, hpri, nlung, ngau hpunpyen, hkyeng kabrim ai, mut ai sumpan hte mani ai lachyit nba hte, gaja hkyeng ai sumpan hpe mung, tawk ka ai amyu myu hte hpa maka mung chye galaw ai wa rai nga ai: dai wa gaw, nang hte rau nga ai maka pru ai ni hte rau mung, na nwa, nye madu Dawi a maka pru ai ni hte rau mung, lawm nga u ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai rai nna nye a madu tsun nga ai hte maren, hkaulan mam, muk-yaw mam, tsanlun sau hte tsabyi jahku, na a shangun ma ni hpe jaw u:
  </para>
  <para style="p">
    <verse number="16" style="v" />shing rai, nang madu ra mara, anhte Lebanon bum ga na ngau shaw nna, Yopa mare du hkra wawn hte shayawng ya na ga ai; nang gaw Yerusalem de hpai la na ndai, ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai Shawlumon gaw shi a kawa Dawi hti tawn ai hte maren, Israela mungdan a tsasam masha ni hpe hti yu wu yang, marai sen mi, mun manga, hkying masum kru tsa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna shi gaw, lit gun hpai ai ni mun sanit, bum ga de nlung tawk nga ai ni mun matsat, dai masha ni hpe up na matu, marai hkying masum kru tsa hte hpe san tawn da ya mu ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Shawlumon gaw, Yerusalem mare na Moria bum ntsa e, Yehowa nan shi hkum, kawa Dawi hpe shadan dan ai, Yebusi masha Ornan a mam chyarang hta, Dawi mazing da ai shara e, Yehowa nta gaw da hpang wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai gaw, shi hkaw dung ai mali ning na shata lahkawng a ni ni hta e gaw da hpang wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Da ndai gaw Karai Kasang a nta matu Shawlumon gaw da ai npawt nhpang ni rai nga ai: galu de, shadawn yu ai hte maren, dawng kru shi, nda de dawng hkun rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai nta a ajan gaw, de a galu de, nta a nda hte bung nna, dawng hkun rai nga ai; de a tsaw de dawng latsa e hkun rai nga ai: shi dai hpe kata maga de ja jet hte sup da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai nta kaba a kata maga de marau hpunpyen hte galup nna, ja jet sup nhtawm, ma-un hpun sumla hte saidawng sumla tawk ka wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai nta hpe shatsawm na matu, lungseng hte tawk hkrep wu ai: dai aja chyawm gaw Parwaim aja rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hta kaga shi gaw, nta hpe, ngau ni, chyinghka hkinbawng ni, shakum ni hte de a chyinghka ni hpe ja hte sup wu ai: shakum ni hta hkerubim sumla hpe tawk ka wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai, Chyoi pra htum ai nta hpe galaw wu ai: de a galu de, nta a nda hte bung nna, dawng hkun, de a nda de dawng hkun rai nga ai: dai hpe ja jet joi kru tsa hte sup da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ja maina ni shen yang, shekela manga shi li nga ai. Ntsa gawk ni hpe mung ja hte sup da wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyoi pra htum ai nta hta hkerubim sumla lahkawng tawk ka nna, ja hte sup da mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hkerubim a singkaw ni gaw dawng hkun galu nga ai; singkaw maga mi de shakum du hkra, dawng manga; bai singkaw gaw shada hkrum hkra dawng manga rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sumla kaga a singkaw gaw, nta a shakum du hkra dawng manga; bai manang a singkaw shada hkrum hkra, dawng manga rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hkerubim yan gaw, kata de man yawng let, lagaw hte tsap nga nna, de a singkaw ni dawng hkun gang nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang shi gaw mut ai, hkyeng kabrim ai, gaja hkyeng ai ari, mani ai lachyit ri hte hkerubim sumla ka ai nba grang galaw wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai shi gaw, dawng sumshi manga tsaw ai shadaw lahkawng galaw nna, nta ndaw e jung da wu ai; de a matu na bandung gaw dawng manga nga rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanghkawng gran ai saidawng hpe mung shi galaw nna, shadaw ni a matu e noi da wu ai; hkainu si latsa mung shi galaw nna, saidawng ni hta noi da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shadaw yan hpe nawku htingnu a ndaw e, hkra de pai de jung da wu ai; hkra maga na shadaw hpe Yahkin, pai maga na hpe Boaza, shamying wu ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hta kaga, magri hkungri shi galaw nna, galu de dawng hkun, nda de dawng hkun, tsaw de dawng shi rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lum lum re ai magri hka lawng mung shi shajaw nna, de a mahka dam ai dawng shi, sung de dawng manga, mahka grup yin dawng sumshi rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Usu nsan ai sumla de a grup yin e hkrep nga ai; dawng mi hta shi shi grup hkra rai nga ai; usu sumla ni lam lahkawng hkrep nga nna, magri hka lawng shajaw yang, dai ni hpe mung jaw shalawm wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hka lawng gaw usu shi lahkawng a ntsa e dung nga ai: masum gaw dingdung maga de, masum gaw sinna maga de, masum gaw dingda maga de, masum gaw sinpraw maga de man yawng nna, shingdu hkrum rai ma nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai gaw lahpa mi tup htat nga ai; de a mahka gaw hka wan mahka zawn rai nna, hka law pan sumla hte sumli wu ai: ntsin bat hkying masum dai hta shang lu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kashin na matu angdung shi galaw nna, hkra de manga pai de manga tawn da wu ai: wan nat hkungga hte seng ai rai ni hpe dai hta kashin wu ai: hka lawng chyawm gaw, hkinjawng ni hka shin na matu rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai shi gaw, hkang da ai hte maren, aja pyengdin shadun shi galaw nna, nawku htingnu kata e, hkra maga de manga, pai maga de manga tawn da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aku shi mung galaw nna, nawku htingnu kata e, hkra maga de manga, pai maga de manga tawn da wu ai: ja angdung latsa mung galaw wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hta kaga, hkinjawng ni a wang, shinggan wang kaba, wang chyinghka ni hpe magri hte sup da wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai magri hka lawng hpe mung, dai nta a hkra maga de sinpraw dingda jut e tawn da wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Huram gaw, dibu ni, dap shakawt ni hte angdung ni hpe galaw wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai Huram gaw, hkawhkam Shawlumon a matu, Karai Kasang a nta hta na amu ni hpe shangut wu ai: dai shadaw lahkawng, hkawan ni, dai shadaw ntsa na bandung lahkawng hte, shadaw ni a ntsa na bandung na hkawan lahkawng hpe mawn sumli na matu sumgawn a wa hpe mung;
  </para>
  <para style="p">
    <verse number="13" style="v" />dai shadaw ni a ntsa na bandung na hkawan lahkawng hpe mawn sumli ai sumgawn awa hpe magap na matu, hkainu si nampan lam lahkawng grang ai, lam mi hta ni tsa tsa rai nna, yawng hpawn mali tsa rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hta kaga shi gaw, punghkum ni, dai hta shadun na angdung ni;
  </para>
  <para style="p">
    <verse number="15" style="v" />hka lawng langai mi hte, de a npu na usu shi lahkawng hpe mung galaw da wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai shi a kawa Huram gaw, Hkawhkam Shawlumon a matu, Yehowa nta hte seng ai arai ni yawng, dibu ni, shingban ni, shan chyinghkyi ni, de a hkawan ni hpe, kabrim ai magri hte galaw shangut wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hkawhkam wa gaw dai arai ni hpe, Yawdan layang ga na Suhkot hte Zereda lapran e nga ai ga kagam hta jaw shangun wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai Shawlumon gaw arai law law galaw wu ai rai nna, magri gaw joi gade re ai kadai n shen yu lu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bai Shawlumon gaw Karai Kasang a nta kata de nga ai rai yawng hte hpe galaw wu ai: aja hkungri hte madun dan nga na muk matu aku;
  </para>
  <para style="p">
    <verse number="20" style="v" />tara hte maten, shingran gawk man e shatu na matu, ja jet pyengdin shadun hte de a pyengdin ni,
  </para>
  <para style="p">
    <verse number="21" style="v" />ja jet nampan ni, pyengdin ni, lakap ni ja majing rai nna,
  </para>
  <para style="p">
    <verse number="22" style="v" />wan lakap ni, angdung ni, chyaw ni, wanban ni mung ja jet rai nga ai: nta chyinghka lam hta, chyoi pra htum ai shara na kata chyinghka ni hte, nawku htingnu ngu na nta chyinghka ni mung, aja rai nga ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />shing rai Shawlumon gaw, Yehowa a nta hta galaw ai yawng mayawng hte hpe shangut wu ai. Bai Shawlumon gaw shi a kawa Dawi madat da ai aja gumhpraw hte arai yawng mayawng hte hpe shapraw nna, Karai Kasang a nta sutdek ni hta tawn da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Shawlumon gaw, Yehowa a ga shaka sumpu hpe Ziun ngu ai Dawi a mare kaw na shalun la na matu, Israela agyi salang ni hte amyu ni a agyi ni ngu ai, Israela kashu kasha ni a ji wa dap lakung na du ni hpe, Yerusalem mare de shaga jahpawng wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai Israela masha ni yawng hte gaw, shata sanit e galaw ai poi hta, hkawhkam wa kaw sa zuphpawng nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israela agyi salang ni yawng sa du nna, Lewi masha ni gaw dai sumpu hpe hpai sharawt mu ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />shanhte gaw dai sumpu hpe mung, shawa sum hpe mung, dai Sum hta rawng ai chyoi pra ai arung arai yawng hpe mung, hpai sharawt mu ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkawhkam Shawlumon hte rau zuphpawng nga ai Israela wunawng wuwa ting, dai sumpu man e rau hpawng nga nna, law la ai majaw n dang hti lu ai sagu dumsu ni hpe sat nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkinjawng ni gaw Yehowa a ga shaka sumpu hpe chyoi pra htum ai shara ngu ai shingran gawk kata de hkerubim yan a singkaw npu e hpai tawn da mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaning rai nme law, dai Hkerubim yan gaw dai sumpu dung ai ntsa e tinang a singkaw ni shachyen nna, sumpu hpe mung, de a ntsa na kandang ni hpe mung ka-up da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kandang a matu ni gaw shingran gawk a nhpan e nga ai chyoi pra ai shara hta mu lu hkra galu nga ai; shinggan de chyawm gaw n kra nga ai; dai de gaw dai ni du hkra anga nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israela masha ni gaw Egutu mung na pru wa nna, Yehowa gaw Horeb bum e shanhte hte ga shaka tawn da nhtawm, Mawshe bang tawn da ai lungppa lahkawng hta kaga, dai sumpu hta hpa mung n rawng nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya hkinjawng ni gaw dai chyoi pra ai shara kaw na pru wa ma yang, hpawng nga ai hkinjawng ni nlang hte gaw, tinang hpung shachyoi shapra nna, tinang hkum hta daw jau nga ma ai n rai;
  </para>
  <para style="p">
    <verse number="12" style="v" />mahkawn mangoi chye ai Lewi masha ni, Asap, Heman, Yeduhtun hte, shanhte a kashu kasha, kahpu kanau nlang hte gaw, mani ai lachyit nba bu hpun ai hte, shupsheng, doria, tingse lang let, tawn hkungri sinpraw maga de tsap nga nna, pahtau dum ai hkinjawng latsa e hkun mung lawm ma ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />ya pahtau dum ai ni hte mahkawn mangoi ai ni gaw, rau Yehowa a chyeju dum let shi hpe shakawn kungdawn nna, pahtau, shupsheng, dum ai baw kaga hte nsen langai sha hte Yehowa hpe shakawn kungdawn nna, Shi gaw mai kaja nga ai; rai sa, shi a chyeju htani htana e agrin nga ai, nga nna tsun ma yang, sumwi gaw Yehowa nta hpe nan ka-up nga ai;
  </para>
  <para style="p">
    <verse number="14" style="v" />hkinjawng ni gaw dai sumwi a majaw, tinang a daw jau ai amu n galaw lu ma ai: kaning rai nme law, Yehowa a hpung shingkang gaw, Karai Kasang a nta hta hpring ka-up nga ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Shawlumon gaw, Yehowa htat chyang ai nsin kata e nga nga na ra ai, nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai chyawm gaw, na a matu tutnawng prat dingsa shanu nga na shingbyi shara hte nta, gaw da nngai, nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai hkawhkam wa gaw myi man kayin nna, zuphpawng nga ai Israela masha ni mahkra hpe shaman ya mu ai; zuphpawng nga ai Israela masha ni mahkra gaw tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai shi gaw, Nye amyu Israela hpe Egutu mung na shapraw ai shani kaw nna, Israela amyu ni a mare langai mi hta, nye a amying shanu nga na matu nta galaw na mung, nye a amyu Israela ntsa e du tai na wa hpe mung, ngai n lata la ai sha,
  </para>
  <para style="p">
    <verse number="5" style="v" />Yerusalem mare hta nye a amying nga nga lu na hte, nye amyu Israela ntsa e up na Dawi hpe ngai, lata la se ai,
  </para>
  <para style="p">
    <verse number="6" style="v" />nga nna nye wa Dawi hpe n-gup ga hte tsun nhtawm, shi a lata hte dai ga hpe shadik ya ai, Israela Karai Kasang Yehowa gaw a nga u ga law
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya, Israela Karai Kasang Yehowa mying nsang a matu nta galaw da na, nye wa Dawi maw nga timung,
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw, Nang nye a amying nsang matu nta galaw da na, nga nna myit maw ndai lam gaw, mai kaja nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, nang dai nta hpe gaw da lu na nrai: na nshang nna hkrat ai na nsha gaw, nye amying nsang a matu dai nta hpe gaw da na ra ai, nga nna nye wa Dawi hpe tsun da nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa mung shi tsun da ai ga hpe shadik nu ai; ngai wa gaw nye wa Dawi a malai paw pru nna, Yehowa ndat da ai hte maren, Israela tingnyang hta ngai dung nga nna, Israela Karai Kasang Yehowa a mying nsang matu, ndai nta hpe gaw da se ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai nhku e, Yehowa gaw Israela kashu kasha ni hte tawn da ai ga shaka rawng ai sumpu hpe mung, ngai tawn da se ai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai shi gaw Yehowa a tawn hkungri hte Israela masha ni a wunawng wuwa ting a man e tsap nga nna shi a lata ladawn wu ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />ya Shawlumon gaw, galu de dawng manga, nda de dawng manga, tsaw de dawng masum re ai magri pinra galaw nna, wang ka-ang e tawn da wu ai; dai ntsa e shi lung tsap nna, Israela shawa hpawng man e lahput hput di let, shi a lata hpe lamu de ladawn nna,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Israela Karai Kasang Yehowa e, sumsing lamu hte ginding aga hta, nang hte bung ai Karai Kasang n nga ai; myit masin mahkra hte na a man e hkawm nga ai ali ama ni hpe, nang ga shaka hku hte chyeju myit madun nga ndai:
  </para>
  <para style="p">
    <verse number="15" style="v" />na shangun ma nye wa Dawi hpe ga ndat tawn da ai hte maren nang shadik ya nu ai: rai sa, nang n-gup ga hte tsun nna, dai ni mu lu ai hte maren, na a lata hte nan dai hpe shadik ya nu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai rai nna Israela Karai Kasang Yehowa e, Nang gaw nye a tara hta hkawm nga sai hte maren, na nshu nsha ni mung kangka ai hte nye a man e hkawm nga ma yang gaw, Israela mungdan a tingnyang hta, na a aru arat kaw na nye a man e langai mi matut manoi adung nga na ra ai, nga nna na shangun ma, nye wa Dawi hpe tsun da sai hte maren, ya shagrin ya u ga.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai sa, Israela Karai Kasang Yehowa e, na shangun ma Dawi hpe nang tsun da ai ga gaw, teng nga lit ga law.
  </para>
  <para style="p">
    <verse number="18" style="v" />Karai Kasang gaw, shinggyim masha hte rau ga ntsa e gaja wa teng teng shanu nga lu na kun? yu u, sumsing lamu hte sumsing lamu ni a sumsing lamu gaw nang hpe rawng da lu na n rai: dai rai yang, ngai gaw da ai nta hta, nang kaning rai rawng lu na n hka!
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai timung, nye a Karai Kasang Yehowa e, na a mayam wa gaw, na a man e jahtau ai nsen hte akyu hpyi ai ga hpe na la lu hkra, na a mayam wa akyu hpyi ai hte hpyi nem ai ga hpe madat la ya e law.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a amying nsang dai yang e anga nga na ra ai, nga nna nang tsun da ai shara de yawng let, na a mayam wa dai shara a man e akyu hpyi ai ga na lu hkra, na a myi gaw dai shara hpe shani shana a mada nga lit ga law,
  </para>
  <para style="p">
    <verse number="21" style="v" />Na a mayam wa, na a amyu Israela gaw dai shara de yawng let akyu hpyi nga ma yang, anhte a hpyi nem ai ga hpe madat mara ya mi; sumsing lamu e nga ai na a shanu shara hta madat mara ya mi; madat mara nga yang, yubak raw dat kau u law.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Masha langai ngai tinang htingbu wa hpe shut nna, dagam shara pru ai majaw, ndai nta na tawn hkungri a man e sa dagam a yang,
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang gaw sumsing lamu hta e madat mara la nna, na a mayam ni hpe tara dara ya mu: shut ai wa hpe mara hte maren, shi a baw ntsa e tai u; dinghpring ai wa hpe dat dat nna shi dinghpring ai hte maren akyu jaw u law.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a amyu Israela gaw nang hpe shut kau ai majaw, hpyen ni a lata hte sum mat ai hkrum jang, shanhte gaw myit kayin nna, na a mying nsang hpe yin la let, ndai nta hta nang hpe akyu hpyi nna, tawngban nga ma yang;
  </para>
  <para style="p">
    <verse number="25" style="v" />nang gaw sumsing lamu hta e madat mara ya nna, na amyu Israela hpe yubak raw dat kau ya nhtawm, nang shanhte a kaji kawa ni hpe jaw da ai sali wunli ga de bai wa shangun ya mi law.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nang hpe shut ai mara majaw marang n htu nna, jan gri nga yang, shanhte gaw dai shara de yawng let, akyu hpyi nna, nang shanhte hpe ari jaw ai majaw, na a amying nsang hpe yin la let, tinang a yubak hpe kau da ma yang,
  </para>
  <para style="p">
    <verse number="27" style="v" />nang gaw sumsing lamu hta e madat mara ya nna, na a mayam ni hte, na amyu Israela a yubak hpe raw dat kau ya u; shanhte hkan nang mai ai lam kaja hpe madun dan nhtawm, na a amyu hpe jaw da ai sali wunli ga ngu ai, na a lamu ga ntsa e, marang htu shangun ya mi law.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Dai mungdan hta n-gawn hku wa wa ai, ana zinli, hkau pyi pyi ai, mam maru ru ai, dinggam-yaw hte shingchyut sha ai mung; shanhte hpe hpyen ai ni gaw, shanhte a mung na mare ni hpe sa wang tawn ai mung; hpa ana ahkya hte hpa machyi makaw hkrum yang mung;
  </para>
  <para style="p">
    <verse number="29" style="v" />marai langai ngai, shing n rai, na amyu Israela ting gaw, tinang hkum hta hkra ai ana ahkya hte yawn hkyen dum yang, dai nta de yawng let, lata ladawn nna, kaning nga akyu hpyi tawngban timung;
  </para>
  <para style="p">
    <verse number="30" style="v" />nang gaw sumsing lamu e nga ai na a shanu shara hta madat mara ya mi; nang masha myit masin hpe chye ya nga ai hte maren, yubak hpe raw dat kau ya nna, langai hte langai hte hpe amu bungli galaw ai hku hkan nna, htang ya mu; nang chyu sha shinggyim masha ni a myit masin hpe chye ya nga ndai.
  </para>
  <para style="p">
    <verse number="31" style="v" />shing rai nang shanhte a kaji kawa ni hpe jaw da ai mungdan hta, shanhte nga nga na laman e, nang hpe hkrit hkungga nga na mara ai law.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Dai hta n-ga, sumtsan mung na masha ni gaw, na a daru magam amying hpe mung, na a n-gun ja ai lata hte ladawn ai lahpum hpe mung, chye wa lu nna, na amyu Israela masha n rai timung, na amying nsang majaw sumtsan mung na pru masha tsasam wa gaw ndai nta de yawng let, akyu hpyi nga yang;
  </para>
  <para style="p">
    <verse number="33" style="v" />na amyu Israela gaw na amying hpe chye nna hkrit hkungga nga ai hte, ndai ngai galaw da ai nta gaw na a amying ningsang rawng ai nta rai nga ai gaw, ga ntsa na amyu baw mahkra chye nga lu hkra, nang gaw sumsing lamu e nga ai, na a shanu shara hta madat mara ya nna, tsasam wa hpyi mahpyi hte maren galaw ya u law.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Na amyu masha ni gaw hpyen ni hpe sa gasat nga ma yang, nang shanhte hpe gara lam shangun rai timung, shanhte gaw, nang lata la ai mare hte, na amying nsang matu ngai galaw da ai nta de yawng let, Yehowa hpe akyu hpyi nga ma yang,
  </para>
  <para style="p">
    <verse number="35" style="v" />nang gaw sumsing lamu hta e, shanhte a hpyi nem ai hte tawngban ga hpe madat mata ya nna, shanhte hpe ninglaw ya mu law.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Masha kadai mung yubak n galaw ai n nga ai majaw, shanhte nang hpe yubak galaw nna, nang shanhte hpe pawt sindawng nhtawm, hpyen ni a lata de ap ya nna, hpyen ni gaw tinang a mung hte tsan ai ni ai shara de shanhte hpe bawng wa dung shangun ai rai yang gaw,
  </para>
  <para style="p">
    <verse number="37" style="v" />shanhte bawng wa dung nga ai ga hta myit dum myit hprang nna, myit kayin wa let, Anhte yubak galaw saga ai; anhte nhtan shai ai hte shut hpyit nga ga ai, nga nna bawng wa dung nga ai madu ni a ga hta myit nem nna tawngban nga ma ai hte
  </para>
  <para style="p">
    <verse number="38" style="v" />bawng dung nga ma ai ga hta myit masin mahkra hte kraw lawang mahkra hte nang hpang de kayin wa nna, shanhte a kaji lawa ni hpe nang jaw ya ai mungdan hta, nang lata la ai mare hta, na a mying nsang matu ngai galaw da ai nta de yawng let, akyu hpyi nga ma ai,
  </para>
  <para style="p">
    <verse number="39" style="v" />shaloi jang nang gaw, sumsing lamu e nga ai, na a shanu shara hta shanhte a akyu hpyi tawngban ai ga madat mara ya nna, shanhte hpe ninglaw ya mu; nang hpe shut hpyit ai na a amyu hpe yubak dat dat ya mu.
  </para>
  <para style="p">
    <verse number="40" style="v" />“Ya, nye a Karai Kasang e, na a myi hpaw nna, ndai shara hta, nang hpe akyu hpyi ai ga madat mara nga u.
  </para>
  <para style="p">
    <verse number="41" style="v" />Dai re ai majaw Yehowa Karai Kasang e, rawt u, nang hte na a sumpu a daru magam na a shanu ai shara hta anga nga u ga: Yehowa Karai Kasang e, na a hkinjawng ni hkye hkrang la ai hpe bu hpun nna, na a chyoi pra ai ni chyeju hta kabu gara nga mu ga.
  </para>
  <para style="p">
    <verse number="42" style="v" />Karai Kasang Yehowa e, na a namman chya ya ai wa kaw na, na amyi man hpe hkum kayin la u; na shangun ma Dawi hpe madun ai n-gaw nwai chyeju hpe adum nga u law,” ngu nna hpyi wu ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Shawlumon gaw akyu hpyi ngut jang, sumsing lamu de na wan hkrat nna, wan nat hkungga hte shagu hkungga kaga hpe hkru kau wu ai: Yehowa a hpung shingkang mung dai nta hta hpring nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa a hpung shingkang gaw, Yehowa hta a hpring nga ai majaw, hkinjawng ni gaw Yehowa a nta de n shang lu ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai wan yu hkrat wa nna, Yehowa hpung shingkang gaw dai nta ntsa e, ka-up nga yang, Israela masha ni yawng mada yu nna, nlung nep ai shara e tinang hkum ga de myi man gum dagup let, nawku nna, Yehowa mai kaja nga ai hte, shi a chyeju htani htana anga nga ai majaw, shi hpe shakawn kungdawn ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai hkawhkam wa hte rau, amyu masha ni yawng Yehowa man e hkungga nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai hkawhkam Shawlumon gaw Yehowa hpe usu mun lahkawng hkying lahkawng, sagu sen me mun lahkawng sat nawng ya wu ai rai nna, hkawhkam wa hte mung masha ni yawng, Karai Kasang a nta hpe san tawn nna dingshawn shang ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkinjawng ni gaw tinang a daw jau ai amu gun hpai let, tsap nga ma ai: Yehowa a chyeju htani htana anga nga ai majaw, shi hpe shakawn kungdawn na matu, hkawhkam Dawi galaw ai dum ai baw amyu myu lang ai Lewi masha ni mung, Dawi tawn da ai htung hte maren, Yehowa hpe mahkawn mangoi nga let, hkinjawng ni shanhte a man e pahtau dum nna, Israela masha nu yawng tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hta kaga Shawlumon gaw Yehowa nta ndaw na wang ka-ang hpe shachyoi shapra wu ai rai nna, dai yang e wan nat hkungga hte mahku hkungga ni a sau man hte hpe nat nawng ya wu ai: kaning rai nme law, Shawlumon galaw da ai magri hkungri gaw, nau kaji nga ai majaw, dai ntsa e wan nat hkungga ni shadung hkungga ni hte sau man ni hpe tawn da shara n nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shing rai Shawlumon gaw ndai aten e, Hamat mare kaw nna Egutu hka shi du hkra, shara shagu hkan na du sa ai, grai law ai Israela shawa hpawng hte rau, sanit ya tup poi galaw wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Matsat ya ngu ai nhtoi hta shanhte jahtum zuphpawng galaw ma ai: kaning rai nme law, tawn hkungri hpe san da ai poi sanit ya tup, dai hpang na poi sanit ya tup galaw mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, shata sanit a nhtoi hkun masum ya e shi gaw shawa masha ni hpe shabawn dat nna, Yehowa gaw Dawi hpe mung, Shawlumon hpe mung, shi a amyu Israela hpe mung, galaw dan ai ngamu ngamai lam majaw shanhte kabu gara ai hte tinang a nta sum de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai Shawlumon gaw Yehowa nta hpe mung, hkawhkam nta hpe mung shangut wu ai; Yehowa nta hte shi a nta hta galaw na lam, Shawlumon a myit hta pru mapru hte maren, galaw shatup lu wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai, Yehowa gaw shana e shi hkum Shawlumon hpe shadan dan nna “Na akyu hpyi ai ga ngai madat ni ai: ndai nta hkungga nawng na shara tai na matu, ngai nan lata la se ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Marang n htu hkra, ngai jan gri shangun ai mung, dinggam-yaw dai mungdan hpe shaza kau na, ngai hkang da ai mung, nye a amyu hta ana zinli shangun dat ai rai yang mung;
  </para>
  <para style="p">
    <verse number="14" style="v" />nye a amying nsang gang ai nye a amyu gaw, myit nem akyu hpyi nna, nye a myi man tau let, tinang a n hkru ai lam hpe kau da ma yang, ngai gaw sumsing lamu de nna madat mara ya let, shanhte a yubak raw dat kau ai hte shanhte a mungdan hpe ngamu shangun na we ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya nye a myi hpaw nga nna, ndai shara hta akyu hpyi ai ga, nye a na madat mara na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ndai nta hta nye a amying hpe prat dingsa e anga nga na matu, ngai dai hpe lata la nna shachyoi shapra se ai; nye a myi mung, nye amyit masin mung, dai hta e shani shagu a shanu nga na li ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang chyawm gaw, na nwa Dawi zawn, ngai nang hpe hkang da mada hte maren, nye matsun maroi ga hte tara tawn da ai lam ni hpe hkan shatup nga n yang gaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />ngai gaw, Israela amyu hta, na a aru arat kaw na langai mi matut manoi anga nga nga ra ai,” ngu na nwa Dawi hpe ga shaka tawn da ai hte maren, na a mungdan a tingnyang ngai shagrin da na we ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing n rai, nanhte gaw, ngai nanhte hpe hkang da ai htet da ai ga hte matsun maroi ga hpe n hkan shatup ai sha, Hpara shaje hpe daw jau nawku nga myit yang gaw;
  </para>
  <para style="p">
    <verse number="20" style="v" />ngai shanhte hpe jaw da ai mungdan hta na aru hte nawng baw kau nna, nye a amying nsang matu ngai shachyoi shapra ai ndai nta hpe ngai shinggan kau na we ai rai nna, masha amyu ni hta abung shadawn chyai shara hte, asawng shara shatai na we ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Ndai nta gaw nde wa galu kaba nga timung, dai de lai wa ai ni nlang hte gaw, mau mahka let, Yehowa gaw ndai mungdan hpe mung, ndai nta hpe mung, hpa majaw ning rai galaw a ta? nga nna san ma yang,
  </para>
  <para style="p">
    <verse number="22" style="v" />masha ni gaw, Egutu mung na shanhte hpe shapraw la ai kaji kawa ni a Karai Kasang Yehowa hpe kau da nhtawm, Hpara shaje hpe hkan nang nna, nawku daw jau ma ai majaw, shi gaw shanhte a ntsa e ndai tsin-yam tsindam yawng shapraw wu ai, nga nna htan na ma ai,” ngu wu ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Shawlumon gaw Yehowa a nta hpe mung, shi a nta hpe mung, hkun ning ngu ai shaning hta galaw ngut jang,
  </para>
  <para style="p">
    <verse number="2" style="v" />Huram gaw Shawlumon hpe jaw da ai mare ni hpe Shawlumon bai de da nna, Israela kashu kasha ni hpe dai yang e nga nga shangun mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Shawlumon gaw Hamat-zoba hpe sa gasat nna, dang kau wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai shi gaw, nam mali Tadmora mare hte, Hamat mung na sutgan mahkawng da ai mare ni yawng de da wu ai
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hta kaga, bunghku, chyinghka, htinggrang ngang ai lahta Bet-horon hpe de da wu ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Balat mare hte, sutgan mahkawng da ai Shawlumon a mare ni yawng hpe, shi a hpyen leng ni tawn da na mare ni hte, shi a gumra jawn ai ni a matu mare ni hpe mung; Yerusalem mare hta, Lebanon ginwang hkan e mung, shi up nga ai mungdan shara shagu hkan e mung, shi a pyaw lam matu galaw mayu ai made de da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israela kashu kasha ni hta n lawm ai hte, Israela kashu kasha ni n shaza kau lu ai, dai mungdan hta naw ngam nga ai,
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiti, Amori, Perizi, Hiwi hte Yebusi masha ni a kashu kasha ni hpe, Shawlumon lahkawn la nna, dai ni du hkra mayam shatai da mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, Shawlumon gaw Israela kashu kasha ni hta na mayam n shayam mu ai; shanhte gaw shi a hpyen masha ni, hpyen du ni, hpyen leng ni hte gumra jawn ai ni a agyi ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai mung masha ni ntsa e up nga ai, hkawhkam Shawlumon a da agyi ni gaw, ni tsa e manga shi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Shawlumon gaw Hpara-u a shayi sha hpe Dawi mare kaw nna shi a matu galaw da ai htingnu de htawt la wu ai: kaning rai nme law, Yehowa sumpu du ai shara gaw chyoi pra nga ai rai nna, nye a madu jan gaw, Israela hkawhkam Dawi a nta hta rawng nga lu na n rai, nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Shawlumon gaw nta jan a ndaw e Yehowa a matu galaw da ai tawn hkungri hta, shani shagu a matu tawn da ai hku hkan nna,
  </para>
  <para style="p">
    <verse number="13" style="v" />Mawshe a tara hte maren, laban nhtoi hkungga, shata praw hkungga, laning mi hta tawn da ai poi masum ngu na, matsi n rawng ai poi, manga shi ya poi, sum poi hte hta, Yehowa hpe wan nat hkungga nawng ya wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai shi gaw, kawa Dawi tawn da ai htung hte maren, daw jau na matu, hkinjawng hpung ni hte, lani hte lani ang wa ai hte maren, hkinjawng ni a man e, daw jau ai ni hte, mahkawn mangoi nga na matu, Lewi masha hpung ni hpe mung tawn da mu ai; chyinghka shagu makau e tawn da mu ai: kaning rai nme law, Karai Kasang a masha wa Dawi gaw dai lam hkang da mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkawhkam wa gaw hkinjawng ni a lam, Lewi masha ni a lam, sutdek ni a lam hkang da mada hta kaga, shanhte hpa mung n galaw ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai Shawlumon a amu yawng, Yehowa nta a npawt nhpang gaw da ai nhtoi kaw nna, nta hpe shangut ai shani du hkra, shachyip ngut sai rai nna, Yehowa nta gaja wa ngut wa sai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai Shawlumon gaw Edom mung na panglai hkin-gau e nga ai Ezion-gebera hte Elot mare de sa du ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hutram mung nammukdara lam chye chyang ai, shi a shangun ma ni hte rau sanghpaw li shangun dat nna, shanhte gaw Shawlumon a shangun ma ni hte rau Ohpira shara de sa du nna, aja talenta mali tsa manga shi lu la nhtawm, hkawhkam Shawlumon hpang de la sa mu ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Sheba hkawhkam jan gaw, Shawlumon a kajai gumhkawng ai lam hpe na mu yang, shi hpe gumwai ga hte Yerusalem hta chyam yu na nga, hkan bawp hkan nang ai wunawng wuwa kaba ni hte, manam pyaw ai baw mung, aja law law hte lungseng htaw ai gawla-uk ni hte mung, sa du ai: Shawlumon a man e shang nhtawm, tinang a myit hta rawng marawng hte maren, shi hte tsun chyai wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shawlumon gaw, shi san yu ai ga yawng mayawng hte hpe htan ya wu ai: Shawlumon shi hpe n tsan dan lu ai lam langai mi muk n nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya Sheba hkawhkam jan gaw Shawlumon a hpaji byeng-ya hpe mung, shi gaw da ai nta hpe mung,
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a sha ku na lusha hpe mung, shi a ali ama ni dung nga ai lam hpe mung, shi a hkringjung hkringmang ni tsap nga ai hte, shanhte a bu hpun ai lam ni hpe mung, shi a tsabyi gawm jau ai ni hte shanhte a bu hpun ai lam hpe mung, shi Yehowa a nta de lung wa ai lam hpe mung, mu wu yang, shi a minla byaw mat lu ai rai nna,
  </para>
  <para style="p">
    <verse number="5" style="v" />shi gaw, “Nang galaw ai amu hte na a hpaji byeng-ya a lam, nye a mungdan hta ngai na lu ai kajai gumhkawng ai ga gaw teng nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rai timung, ngai grai n du yu nna, nye a myi hte chyaw garai n mu lu yang gaw, ngai shanhte a ga hpe n kam we ai; yu u, na a hpaji byeng- ya galu kaba ai lam, chyen mi pyi ngai hpe n tsun dan mi ai: ngai na lu ai kajai gumhkawng ai ga hta nang grau nga n hka'.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na man e tutnawng tsap nga nna, na a hpaji ga na lu ai mung masha ni hte, ndai na a ali ama ni gaw, a lu ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang hpe tsawra nna, na a Karai Kasang Yehowa a malai hkawhkam tai na nga, shi a tingnyang hta nang hpe dung shangun ai, na a Karai Kasang Yehowa gaw a nga u ga law: na a Karai Kasang gaw Israela hpe tsawra nna, prat dingsa shagrin da mayu ai majaw, dingman ai hku tara dawdan na matu shi nang hpe hkaw dung shangun nit dai,” ngu nna hkawhkam wa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai shi gaw, aja talenta latsa e hkun, manam pyaw ai baw law law hte, lungseng hpe mung, hkawhkam wa hpe sak jaw wu ai: Sheba hkawhkam jan hkawhkam Shawlumon hpe sak jaw ai hte bung ai manam pyaw ai baw htawm hpang de n nga sai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai, Ohpira mung na a aja htaw ya ai, Huram a ali ama ni hte Shawlumon a ali ama ni gaw, algum hpun hte lungseng mung, wa htaw sa ya mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />hkawhkam wa gaw, Yehowa a nta matu mung, shi a nta matu mung, algum hpun hte ngau gum, mahkawn mangoi ai ni matu tingse hte sumpyi, galaw wu ai; dai zawn re ai baw, Yuda mung hta shawng de galoi mung n mu yu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai hkawhkam Shawlumon gaw, Sheba hkawhkam jan hpe kumhpa hpaw ai hta kaga, hkawhkam jan myit ra ai hte maren, shi hpyi mahpyi jaw wu ai. Dai hpang hkawhkam jan gaw shi a ali ama ni hte rau tinang a buga de bai nhtang wa ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shawlumon gaw laning mi hta lu la ai aja shen yu yang, talenta kru tsa e kru shi kru rai lu ai;
  </para>
  <para style="p">
    <verse number="14" style="v" />dai hta kaga seng dung ai ni hte hpaga ga ai ni mung, dai hta jat mu ai; Arabi hkawhkam ni nlang hte hte mung du agyi ni mung, Shawlumon hpang de aja gumhpraw sak jaw mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai hkawhkam Shawlumon gaw n-gang kaba ni tsa aja hte dup wu ai; n-gang langai mi hta aja shekela kru tsa rawng lu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai shi gaw n-gang kaji masum tsa hte dup wu ai; n-gang langai mi hta aja joi masum rawng lu ai: hkawhkam wa gaw dai ni hpe Lebanon maling na nta kata e tawn da wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hta kaga hkawhkam wa gaw hkawhkam tingnyang kaba, magwi kawng hte galaw nna aja jet hte sup da wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tingnyang de lung wa na matu lakang n-gam kru rai nga nna, tingnyang hte matut ai lagaw kabye shara aja rai nga ai; dung shara maga mi hte maga mi de lata mara shara rawng nna, de a makau e hkanghkyi lahkawng tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />N-gam kru a maga mi hte maga mi yawng hpawn, hkanghkyi shi lahkawng tsap nga ma ai: dai zawn re ai majaw, gara mungdan hta mung n galaw yu ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hkawhkam Shawlumon ntsin lu ai gawm ni yawng aja rai nga ai; Lebanon maling a nta na wan ni yawng mung ja jet rai nga lu ai: Shawlumon a aprat e gumhpraw hpe hpa n nawn nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kaning rai nme law, hkawhkam wa gaw, Huram a ali ama ni hte rau Tarshi mare de sa ai sanghpaw li ni lu nga ma ai: Tarshi ngu ai sanghpaw li ni gaw, masum ning hta lang wa du nna, aja, gumhpraw, magwi kawng, awoi hte u tawng ni hpe wa htaw ya mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai hkawhkam Shawlumon gaw, ga ntsa hkawhkam ni mahkra hta, sutgan hte hpaji byeng-ya grau nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Karai Kasang gaw Shawlumon a myit masin hta bang ya ai hpaji byeng-ya hpe na lu na matu, ga ntsa hkawhkam ni yawng shi hpang de sa du ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shanhte langai hte langai, gumhpraw wan ni, aja wan ni, hpun palawng, ri nhtu ni, manam pyaw ai baw, gumra, hte lawze ni, hkang da ai hte maren, laning hte laning sak bang jaw mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai Shawlumon gaw gumra hte gumra leng matu ulawng gawk hkying mali hte, gumra jawn ai masha mun me hkying lahkawng lu nna, leng ni rem da ai mare ni hte, Yerusalem mare na hkawhkam nta hta tawn da shajang mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya shi gaw dai hka nu kaw nna, Hpilisti mung hprang, Egutu mung na lamu ga jarit du hkra, hkawhkam ni mahkra ntsa e up nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai hkawhkam wa gaw, Yerusalem mare hta e gumhpraw hpe nlung zawn, arit hpun hpe layang ga na lakum hpun zawn shalaw mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte gaw Shawlumon a matu, Egutu mung hte mung shagu kaw na gumra mari la mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya naw ngam nga ai Shawlumon a amu a lam npawt ndung hkren myihtoi Nahtan a labau gawn ai lai ka hte, Shilo mare na myihtoi Ahiya laika hte, Nebat a kasha Yeroboam a lam myihtoi Ido a shingran laika hta ka da nga ai, n rai ni?
  </para>
  <para style="p">
    <verse number="30" style="v" />Shing rai Shawlumon gaw Yerusalem mare hta hkaw dung nna, Israela ting a ntsa e, mali shi ning tup up nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Shawlumon gaw kaji kawa ni hte rau yup pyaw nna, kawa Dawi a mare hta makoi mayang di mu ai: kasha Rehoboam gaw shi a malai hkaw dung nga ai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Rehoboam gaw Shehkem mare de lung wa sai; kaning rai nme law, shi hpe hkawhkam aya dang na nga Israela masha ni yawng, Shehkem mare de du ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya Nebat a kasha Yeroboam gaw, hkawhkam Shawlumon a myi man kaw na hprawng mat nna, Egutu mung e nga nga ya yang, dai lam na wu ai shaloi, Egutu mung na bai wa ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai re ai majaw shanhte hte shi hpe shaga nna, Yeroboam hte Israela sha wa ting sa nna Rehoboam hpe,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Na nwa gaw anhte a kandang hpe li wa shangun ya mi ai: dai re majaw, na nwa a yak la ai amu makan hte, anhte e shagun ya ai li la ai kandang hpe, nang shayawm shatsang kau ya mi; shaloi anhte nang hpe daw jau nga na ga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi shi gaw, “Masum ya lai jang she ngai hpang de sa marit,” ngu nna shanhte hpe tsun dat mu ai. Masha ni mung wa mat ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya hkawhkam Rehoboam gaw, shi kawa Shawlumon a prat e shi a man e tsap nga ai salang ni hte bawng yu nna, “Ndai masha ni hpe htan ya na ga, nanhte ngai hpe hpa lam daw ya na myit ta?” ngu mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, “Nang dai masha ni hpe ga ngwi ga sau tsun nna, shanhte hpe myit shapyaw ai hte mai kaja ai ga tsun yang gaw, shanhte prat dingsa na a mayam ni tai na mara ai,” ngu nna shi hpe daw ya mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi chyawm gaw salang ni shi hpe hpaji daw ya ai hku kau da nhtawm, shi man e tsap nga nna, shi hte rau kaba wa ai shabrang ni hte bawng yu nna,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ndai masha ni gaw, “Na nwa anhte hpe shagun ya ai kandang hpe tsang shangun ya mi. nga nna ngai hpe hpyi ma ai majaw, shanhte hpe ga htan ya na lam, nanhte gara hku hpaji daw ya nga myit ta?” ngu nna shanhte hpe san mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi shi hte rau kaba wa ai shabrang ni gaw, “Na nwa anhte a kandang hpe li shangun nga timung, nang dai hpe anhte a matu tsang shangun ya mi, nga nna nang hpe hpyi ma ai masha ni hpe ning ngu u, Nye a yung hkyi gaw, nye wa nshang hte grau kaba nga ai;
  </para>
  <para style="p">
    <verse number="11" style="v" />nye wa gaw nanhte hpe li la ai kandang shagun da timung, ngai nanhte a kandang hta naw jat na we ai; nye wa gaw, nanhte hpe ri lasik hte kayat ai; ngai mahtang nanhte hpe hpri n-gawgawk hte kayat na made ai,” ngu nna tsun u, ngu mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai hkawhkam wa gaw, Masum ya lai jang she, ngai hpang de sa marit, nga nna hkang da ai hte maren, Yeroboam hte mung masha ni nlang masum ya nhtoi hta e Rehoboam hpang de bai sa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkawhkam wa gaw mung masha ni hpe sheng mareng ga tsun nna, salang ni shi hpe hpaji daw ya ai ga kau da nhtawm,
  </para>
  <para style="p">
    <verse number="14" style="v" />shabrang ni shi hpe hpaji daw ya ai ga hku hkan nna, “Nye wa gaw nanhte a kandang hpe shali timung, ngai dai hta naw jat na we ai; nye wa gaw nanhte hpe ri lasik hte kayat ai, ngai mahtang hpri n-gawgawk hte kayat na made ai,” ngu nna shanhte hpe tsun dat mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai hkawhkam wa gaw mung masha ni a ga n madat nga ai; dai lam gaw, Yehowa nan, Shilo masha Ahiya n-gup hte Nebat a kasha Yeroboam hpe tsun da ai ga hpe shagrin da na matu, Karai Kasang kaw nan pru ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkawhkam wa gaw shanhte a ga n madat nga ai hpe Israela masha ni gaw, “Anhte Dawi hta hpa daw nga ga ta? Yese kasha hta anhte sali n lawm ga ai; Israela e langai hte langai tinang a sum nta ni de bai wa mu; Dawi e na nta hpe ya yu yu u law,” ngu nna hkawhkam wa hpe htan nhtawm, Israela gaw tinang a sum nta ni de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai timung Yuda mung na mare ni hta nga nga ai Israela masha ni a ntsa e, Rehoboam gaw up nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi hkawhkam Rehoboam gaw, nchyang amu galaw ai ni a ntsa e up nga ai Hadoram hpe shangun dat wu yang, Israela masha ni gaw shi hpe nlung hte hkap kabai sat kau mu ai. Hkawhkam Rehoboam mung Yerusalem mare de hprawng wa na matu shi a leng hta alawan gat shang wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai Israela amyu ni gaw, dai ni du hkra Dawi a dap lakung ni hpe gumlau nga ma ai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Rehoboam gaw Yerusalem de du wa yang, Yuda hte Ben-yamin amyu hta na, Israela amyu hpe hkap gasat nna, Rehoboam kaw dai mungdan hpe nhtang jashawn lu na matu, hpyen masha sen me mun masat shaga tawn mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Karai Kasang a masha wa Shemia kaw Yehowa a mungga du nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Yuda hkawhkam, Shawlumon a kasha Rehoboam hte, Yida yan Ben-yamin mung hta nga ai Israela masha ni yawng hpe ning ngu tsun u,
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw ning nga ai, Nanhte gaw nhpu nnau ni hpe sa gasat lu na myit dai n rai nga ai, ngu u, ngu wu ai. Shing rai shanhte gaw Yehowa a ga madat mara nna, Yeroboam hpe n sa gasat ai, bai wa ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Rehoboam gaw Yerusalem e nga nga nna, Yuda mung hta bunghku kum ai mare de da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw, Betlehem, Etam, Tekoa,
  </para>
  <para style="p">
    <verse number="7" style="v" />Bet-zura, Sohko, Adulam,
  </para>
  <para style="p">
    <verse number="8" style="v" />Gat, Maresha, Zip,
  </para>
  <para style="p">
    <verse number="9" style="v" />Adorim, Lahkisha, Azeka,
  </para>
  <para style="p">
    <verse number="10" style="v" />Zora, Aialon Hebron hpe de da wu ai; dai mare ni gaw Yuda hte Ben-yamin ginwang hta bunghku kum ai mare ni rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai bunghku kum ai mare ni hta hpyen du mung, lusha shahpa hte tsanlun sau, tsabyi jahku mung tawn da wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mare shagu hta n-gang hte ri nhtu shi tawn da nna dai mare ni hpe grai wa shangang da wu ai. Yuda hte Ben-yamin ntsa e shi up nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ya Israela mung ting hta nga ai hkinjawng ni hte Lewi masha ni gaw, tinang nga ai shara shagu hkan na, shi hpang de sa manoi ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaning rai nme law, shanhte gaw Yehowa hpe daw jau na matu, hkinjawng amu n galaw lu hkra, Yeroboam hte shi a kasha ni gaw shanhte hpe hkum da nna,
  </para>
  <para style="p">
    <verse number="15" style="v" />tsaw ai kawng ni hta shi galaw da mu ai majaw, Lewi masha ni gaw tinang a buga hta ga dachyawk ni hpe kau da nna, Yuda mung Yerusalem mare de sa du ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte pru ma ai hpang, Israela amyu ni mahkra hta na, tinang a myit masin mahkra hte, Israela karai kasang Yehowa hpe hkan tam ai ni yawng hte gaw, kaji kawa ni a Karai Kasang Yehowa hpe hkungga nawng ya na nga, Yerusalem mare de hkan du nang ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing ra shanhte gaw Yuda mung hpe shangang shakang ya nna, Shawlumon a kasha Rehoboam hpe masum ning tup shangang da mu ai: kaning rai nme law shanhte gaw masum ning tup Dawi hte Shawlumon a lam hkan nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ya Rehoboam gaw Dawi a kasha Yerimot a shayi sha Mahalat hte, Yese kasha Eliab a shayi sha Abihala hpe hkungran la nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />shi gaw Yeusha, Shemari, Zaham ngu ai shadang ni hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hpang Absalom a shayi sha Mahka hpe la nna, shi gaw Abiya, Atai, Ziza, Shelomit hte hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ya Rehoboam gaw madu jan shi masat hte lashi num kru shi hte hpe la nna, shadang sha hkun matsat hte shayi sha kru shi shaprat wu timung, Absalom a shayi sha Mahka hpe shi a num kaga mahkra hta grau tsawra nna,
  </para>
  <para style="p">
    <verse number="22" style="v" />Mahka a kasha Abiya hpe kahpu kanau ni hta Agyi tai na matu san da wu ai: kaning rai nme law, Rehoboam gaw shi hpe hkawhkam shatai na maw nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hta kaga, shi gaw hpaji byeng-ya hte galaw nna, shi a shadang sha ni hpe Yuda hte Ben-yamin shara shagu hkan na bunghku kum ai mare ni hta tawn da mu ai rai nna, shanhte hpe lusha shahpa law law jaw da mu ai. Shanhte a matu num law law mung tam wu ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Rehoboam a mungdan gaw grin wa ai hte, shi n-gun ja wa jang, shi gaw Israela masha ni yawng hte rau, Yehowa a tara hpe kau da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai Yehowa hpe shut kau mu ai majaw, Rehoboam hkaw dung ai manga ning hta e, Egutu hkawhkam Shishak gaw, hpyen leng hkying mi ni tsa,
  </para>
  <para style="p">
    <verse number="3" style="v" />gumra jawn ai ni mun kru hte rau Yerusalem de lung wa ai. Shi hte rau Egutu mung na sa wa ai Lubim, Sukim hte Ehtiopi masha ni gaw n dang hti hkra law nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw Yuda mung na bunghku kum ai mare ni hpe gasat dang kau nna, Yerusalem mare de du ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi myihtoi Shemia gaw, hkawhkam Shishak a majaw Yerusalem mare hta hpawng nga ai Yuda du salang ni hte Rehoboam kaw du nna, Yehowa ning nga ai, Nanhte hpe Shishak a lata de ap kau masade ai, nga ai, ngu nna shanhte hpe htawn tsun mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, Israela du salang ni hte hkawhkam wa gaw tinang myit nem let, Yehowa dingman nga ai, nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai myit nem ai lam Yehowa mu jang, Yehowa mungga gaw Shemia kaw du nna, Shanhte gaw tinang myit nem masai; ngai shanhte hpe jahten kau na n rai: gade n na yang ngai shanhte a matu lawt na lam hpaw ya nna, nye a pawt bu ai gaw Yerusalem mare ntsa e Shishak a lata hte ru bun sa na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai timung, ngai hpe daw jau na lam hte ga ntsa mungdan ni hpe daw jau na lam chye ginhka lu mu ga, shanhte gaw shi a mayam ni tai na mara ai, nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai Egutu hkawhkam Shishak gaw Yerusalem mare de du nna, Yehowa nawku htingnu na aja gumhpraw hte hkawhkam htingnu na aja gumhpraw pe la kau wu ai; shi yawng mayawng hte hpe la kau nu ai: Shawlumon galaw sa ai aja n-gang ni mahkra hpe mung, la kau nu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkawhkam Rehoboam gaw aja n-gang ni a malai, magri n-gang galaw nna, hkawhkam htingnu a chyinghka sin langa ni agyi ni a lata hta ap ya mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai hkawhkam wa gaw Yehowa htingnu hta shang shagu, sin langa ni dai n-gang ni hpe lang nna, sin langa gawk hta e bai wa tawn sa mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya shi gaw tinang hkum hpe shagrit kau wu ai majaw, Yehowa a pawt bu ai shi kaw na nhtang wa nna, shi hpe atsai awai jahten kau; wu ai n rai: dai hta n-ga, Yuda mung hta e mung, mai kaja ai gaw nga nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai hkawhkam Rehoboam gaw Yerusalem mare nta n-gun ja wa nna dai yang up nga ai: Rehoboam gaw hkaw dung ai shaning e asak mali shi langai ning rai nga nna, Yerusalem mare hta e shi sanit ning hkaw dung wu ai; dai mare gaw, Yehowa shi a amying nsang tawn da na matu, Israela amyu lakung ni yawng hta na lata la ai mare rai nga ai: shi kanu a mying gaw, Amon numsha Nama rai lu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw Yehowa hpe shi a myit masin mahkra hte n hkan tam ai sha, n hkru ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rehoboam galaw ai lam npawt ndung hkren, ahtik labau hku gawn dan ai myihtoi Shemia hte myihtoi Ido a labau laika ni hta ka da nga ai, n rai ni? Rehoboam yan Yeroboam gaw shan a prat tup hpyen gasat hkat ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya Rehoboam gaw shi a kaji kawa ni hte yup pyaw wa nna, Dawi mare hta makoi mayang di ai hkrum wu ai: shi a kasha Abiya gaw shi a malai hkaw dung nga ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya hkawhkam Yeroboam hkaw dung ai shi matsat ning hta e, Abiya gaw Yuda mung hta hkaw dung hpang wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw Yerusalem mare hta e masum ning hkaw dung nga ai: Shi a kanu gaw Gibea masha, Uriela a shayi sha Mahka rai lu ai. Abiya yan Yeroboam gaw, shada hpyen gasat hkat ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya Abiya gaw hpyen gasat na na, nden ja ai share sen mali lata la nna pru sa wa ai; Yeroboam mung hpyen hkyen nna, nden ja ai share sen matsat lata la nna htim maw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Abiya gaw Ehprim bum ga na Zemarim kawng ntsa e tsap da nna, Yeroboam hte Israela masha nlang hte e, madat mara mu law.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israela Karai kasang Yehowa gaw, Jum hte jawn da ai ga shaka hte, Israela mungdan Dawi hte shi a kashu kasha ni hpe prat dingsa du hkra jaw da nga ai hpe nanhte dum mai myit dai, n rai myit ni?
  </para>
  <para style="p">
    <verse number="6" style="v" />Rai timung, Dawi a kasha Shawlumon a mayam, Nebat a kasha Yeroboam gaw, shi a madu hpe gumlau nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rehoboam gaw aprat garai n kaba nna, myit garai n kung ai majaw, shanhte hpe n hkap daw lu ai laman e, akyu n gawng ai n hkru n hkra ai masha ni gaw, Yeroboam a hpang maga lawm nna, Shawlumon a kasha Rehoboam hpe aja awa di kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya mung, Dawi kasha ni a lata hta rawng nga ai Yehowa a mungdan hpe, nanhte hkap daw na maw nga myit hka; gaja wa anhte gaw wunawng kaba rai nga myit dai hte, nanhte a Hpara malai Yeroboam galaw da ai aja dumsu kasha ni mung lawm nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte mahtang Yehowa hkinjawng ni, Arun a kashu kasha ni hte Lewi masha ni hpe shachyut kau nhtawm, maigan mung na myu ni zawn tinang ra ai hte maren hkinjawng dang da myit dai, n rai ni? shing rai, kadai mung hkinjawng aya lu la na matu, usu langai hte sagu la sanit sat nawng ya nna hpa n re ai Hpara ni a hkinjawng tai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte chyawm gaw Yehowa hpe n kau da ga ai; shi gaw anhte a Karai Kasang rai nga ai: Yehowa hpe daw jau ai hkinjawng ni gaw Arun a kashu kasha Lewi masha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw jahpawt shagu shana shagu Yehowa matu wan nat hkungga hte manam pyaw ai baw nat nawng ya ma ai; madun dan ai muk ni hpe mung san seng ai ku hta mara da mu ai: aja pyengdin shadun hte de a pyengdin ni shana shagu shatu ma ai: kaning rai nme law, anhte gaw anhte a Karai Kasang Yehowa hpe daw jau ga ai; nanhte chyawm gaw shi hpe kau da myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yu mu, Karai Kasang anhte a hpaawn wa rai nga nna, shi a hkinjawng ni mung pahtau dum let nanhte hpe shadum na nga, anhte hta rai nga ma ai. Israela masha ni e, kaji kaw ni a Karai kasang Yehowa hpe hkum dai myit, hkap daw yang sum na myit dai ngu mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Yeroboam gaw hpung mi di nna shanhte a hpang e mayun lung wa ai: shing rai Israela masha hpung mi Yuda masha ni a shawng e hkap nga nna, mayun lung wa ai ni, hpang de makoi nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Yuda masha ni kayin mada yu yang, shanhte a shawng de hpang de hpyen hpring nga ai mu jang, shanhte Yehowa hpe jahtau nga nna, hkinjawng ni mung pahtau dum nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai Yuda masha ni jahtau garu jang, Karai Kasang gaw, Abiya hta Yuda masha ni a man e, Yeroboam hte Israela masha ni yawng hpe ari jaw mu ai rai nna,
  </para>
  <para style="p">
    <verse number="16" style="v" />Israela kashu kasha ni gaw Yuda masha ni kaw na hprawng htawt mat wa ma ai. Karai Kasang gaw shanhte hpe Yuda masha ni a lata de ap kau mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Abiya hte shi a masha ni gaw, shanhte law law hpe sat kau nna, lata la ai Israela masha sen manga si mat ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai Israela masha ni dai aten hta sum mat nna, Yuda masha ni gaw tinang a kaji kawa ni a Karai Kasang Yehowa hpe shamyet shanat nga ai majaw, padang nlaw lu ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abiya mung, Yeroboam hpe hkan shachyut nna, Betela hte de a ginwang kahtawng ni, Yeshana hte de a ginwang kahtawng ni, Ehpron hte de a ginwang kahtawng ni hpe shi a lata na kashun la mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yeroboam gawa Abiya aprat ting hta n-gun yawm mat nna, bai n awai lu mat ai hte, Yehowa shi hpe ari jaw nna, shi si mat sai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Abiya chyawm gaw n-gun lagaw ja wa nna, num shi mali la nhtawm, shadang sha hkun lahkawng shayi sha shi kru shaprat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Naw gawn ga ai Abiya galaw ai lam hte hte shi tsun ai ga gaw, myihtoi Ido a labau laika hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai Abiya gaw kaji kaw ni hte ran yup pyaw wa nna, Dawi a mare hta makoi mayang di ai hkrum wu ai. Shi a kasha Asa gaw shi a malai hkaw dung nga ai. Dai mungdan gaw shi a prat hta shi ning tup ngwipyaw nga ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Asa gaw shi a Karai Kasang Yehowa a man e mai kaja ai amu hte dingman ai amu hpe galaw nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw tsasam amyu ni a hkungri ni hte tsaw ai kawng ni a hkungri ni hpe yeng kau wu ai rai nna, sumla shadaw ni hpe agrawp kau ai hte Asherim sumla ni hpe kran kau nhtawm,
  </para>
  <para style="p">
    <verse number="3" style="v" />Yuda masha ni gaw kaji kawa ni a Karai Kasang Yehowa hpe hkan tam nna, jep ai tara hte htet da ai ga ni hpe hkan shatup lu na lam, hkang ka mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yuda mung na mare shagu hta na mung, tsaw ai kawng shara ni hte ajan sumla ni hpe shi yeng kau wu ai rai nna, mungdan gaw shi a man e ngwipyaw nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai Yehowa gaw shi hpe asan aban di ya nna, hpyen majan n pru ai hte mungdan ting ngwipyaw wa ai majaw, shi gaw Yuda mung hta bunghku kum ai mare ni hpe de da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai shi gaw, Anhte gaw anhte a Karai Kasang Yehowa hpe hkan tam shakut nna, shi gaw anhte hpe shara shagu hta ban sa shangun mi ai rai nna, mungdan ting hpe anhte up nga ai majaw, ndai mare ni hpe de da nhtawm, bunghku, langchyi, chyinghka, htinggrang ni hpe galaw da mu, ngu nna Yuda masha ni hpe hkang da mi ai. Shing tai shanhte de da nna awng wa ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Asa kaw Yuda amyu hta na n-gang galu hte ri lang asi hpyen masha sen masum; bai Ben-yamin amyu hta na n-gang hte ndan lang ai hpyen masha sen lahkawng mun matsat nga nna, shanhte nlang hte gaw nden ja ai share ni hkrai rai nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai hkusha hkawhkam Zera gaw hpyen masha ri mi, hpyen leng masum tsa hte rau rawt lung wa nna, Maresha de du ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Asa gaw, shi hpe hkap daw na pru nna, Maresha makau na Zehpat kadit e gasat hkyen nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Asa gaw, shi a Karai Kasang Yehowa hpe jahtau nna, Yehowa e, n-gun n ja ai wa hpe, n-gun ja ai wa a lata na mawai la na, nang hta kaga kadai n nga ai: anhte a Karai Kasang Yehowa e, karum la mi; anhte gaw nang hta manoi nna, na mying ningsang hta hpa let, ndai hpyen luksuk ni hpe gasat na sa wa ga ai. Yehowa e, ngang gaw anhte a Karai Kasang rai nga ndai: masha gaw nang hpe n dang kau lu mu ga law, ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Yehowa gaw Hkusha masha ni hpe Asa hte Yuda masha ni a man e ari jaw nna, shanhte htaw mat wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Asa hte shi a masha ni gaw Hkusha masha ni hpe Gerara du hkra hkan shachyut nna, shanhte gaw hpyen bai n gasat gwi hkra, masha law law si mat ma ai: kaning rai nme law shanhte gaw Yehowa hte shi a luksuk ni a man e sum mat ai hkrum nna, Yuda masha ni gaw lanep law law wa lu la ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai shanhte gaw Gerara grup yin na mare ni nlang hte hpe jahten kau mu ai: kaning rai nme law, Yehowa a hkrithpa shanhte a ntsa e rai nga ai: dai mare ni hta lanep law law nga ai majaw, shanhte dai mare ni mahkra hpe jahten kau mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yamnga ulawng ni hpe mung jahten kau nhtawm, sagu hte gawla-uk law law gau let, Yerusalem de bai wa ma ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Karai Kasang a Wenyi gaw Oded a kasha Azaria ntsa e du nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />shi gaw Asa hpe tau la na pru let, Asa e, Yuda hte Ben-yamin masha nlang hte e, nye a ga madat mara mu: nanhte gaw Yehowa hpang maga nga ai hte yang, shi gaw nanhte hte rau nga na ra ai; nanhte shi hpe tam yang mu na mu ai; shi hpe kau da yang, shi nanhte hpe mung kau da na myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya nhtoi na na wa Israela amyu hta tengman ai Karai Kasang n nga ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />rai timung, shanhte ruyak hkrum let, Israela Karai Kasang Yehowa hpang de kayin tam wa yang, shanhte shi hpe mu mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai aten hte yang, shang wa pru wa ai wa a matu ngwipyaw shara n nga ai: mungdan masha ni mahkra a ntsa e shoihpa shoirang kaba hkrai rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang gaw tsin-yam tsindam amyu myu hte shanhte hpe sharu shatsang ai majaw, amyu mi hte amyu mi, mare mi hte mare mi shada gasat agrawp hkat ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nanhte chyawm gaw n-gun hkum shayawm myit; nanhte hkan galaw ai hte maren shabrai lu la na myit dai, ngu mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya Asa gaw dai ga hte myihtoi Oded a myihtoi ga hpe na wu yang, shi n-gun lu la nna, Yuda hte Ben-yamin mung ting hta na mung, Ehprim bum ga na gasat dang la ai mare ni hte na mung, matsat shabat lam hte hpe yeng seng kau nna, Yehowa a nta jan man e nga ai Yehowa a tawn hkungri hpe bai lajang da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai shi gaw, Yuda hte Ben-yamin amyu masha ni mahkra hpe mung, shanhte hte rau shingbyi nga ai Ehprim, Manashe hte Simun amyu masha ni hpe mung hpawng nga shangun mu ai: kaning rai nme law, Asa a Karai Kasang Yehowa gaw shi hte rau rai nga ai hpe, Israela masha ni mu mu yang, shanhte hta na law law wa shi hpang de sa shingbyi nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai rai nna shanhte gaw Asa hkaw dung ai shi manga ning, shata masum hta Yerusalem mare hta sa hpawng ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw dai shani e tinang la wa ai lanep hta na, usu sanit tsa, sagu hkying sanit, Yehowa hpe nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai shanhte gaw, kaji kawa ni a Karai Kasang Yehowa hpe, kraw lawang mahkra hte myit masin mahkra hte hkan tam nna,
  </para>
  <para style="p">
    <verse number="13" style="v" />Israela Karai Kasang Yehowa hpe n hkan tam ai numsha lasha kaji kaba kadai mung si ai hkrum mu ga, nga nna ga shaka tawn da ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai shanhte gaw ja ja jahtau garu let pahtau pahke dum ai hte Yehowa hpe dagam da mu ai. Yuda masha ni yawng dagam nga yang ja ja kabu gara nga ma ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />kaning rai nme law, shanhte gaw myit masin mahkra hte dagam nna, sharawng awng ai myit mahkra hte shi hpe hkan tam mu ai: shanhte mung Yehowa hpe mu hkrup nna, shi gaw shanhte hpe shara shagu hta ngwipyaw shangun mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkawhkam Asa a kanu Mahka mung, matsat shabat re ai Ashera sumla galaw da nu ai majaw, shi hpe hkawhkam jan aya na gum-yu yu kau nna, shi a sumla hpe kahtam kau nna, ayun ayaw agrawp kau nhtawm, Kedron hka shi hkaraw e nat kau ya wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai timung, tsaw ai kawng ni a nawku shara ni hpe Israela mung na shi htawm kau wa ai n rai: Asa a myit masin chyawm gaw shi hkrung nga dingsa hkum tsup nga lu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi a kawa majai da ai hte, shi hkum nan majai kau ai aja, gumhpraw hte wan ni hpe, Karai Kasang a nawku Htingnu kata e tawn da wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Asa hkaw dung ai sumshi manga ning du hkra, hpyen majan n pru nga ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Asa hkaw dung ai sumshi kru ning hta e, Yuda hkawhkam Asa hpang de kadai mung n shang n pru lu mu ga, Israela hkawhkam Basha gaw Yuda mung de lung nna, Rama mare hpe de da wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Asa gaw Yehowa nta na sutdek hte, hkawhkam htingnu a sutdek hta na aja gumhpraw shaw la nhtawm, Damasku e dung ai Suri hkawhkam Benhada hpang de shangun dat nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye wa hte na nwa lapran e ga shaka nga ai hte maren, ngai hte na a lapran e mung ga shaka rai nga ai; yu u, ngai nang hpe aja gumhpraw sak ya de ai; Israela hkawhkam Basha gaw ngai kaw na pru wa lu hkra, nang shi hte tawn da ai ga shaka hpe sa sharun kau u, ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya Benhada gaw hkawhkam Asa a ga hpe madat nna, shi a hpyen du ni hpe Israela mare ni hpang de shangun dat nna, shanhte gaw Ion mare, Dan mare, Abela-miam kaw nna Naphtali mung na sut rai tawn da ai mare ni hpe shaza kau mu ai,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya Basha gaw dai lam na wu yang, shi Rama mare hpe n de shangut ai sha, dai amu hpe kau tawn da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi hkawhkam Asa gaw, Yuda mung na ni yawng shaga la nna, Rama mare e Basha shachyip da ai nlung ni hte ngau ni hpe la wa nhtawm, Geba mare hte Mizpa de da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai aten e myihtoi Hanani gaw Yuda hkawhkam Asa hpang de du nna, Nang gaw na a Karai Kasang Yehowa hta n hpa ndai hte, Suri hkawhkam hta hpa ndai majaw, Suri hkawhkam a hpyen luksuk ni gaw na a lata na lawt wa masai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkushi masha ni hte Lubim masha ni gaw, hpyen leng law law, gumra jawn ai ni grai wa hte luksuk kaba rai nga ai, n rai ni? Rai timung, nang gaw Yehowa hpe hpa nga ai majaw, dai ni hpe na a lata hta ap ya nit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaning rai nme law, Yehowa gaw, dinghpring ai ni a matu, ngang ai shingbyi shara tai na nga, shi a myi mungkan ting hproi hkra mada yu nga ai: nang chyawm gaw ndai lan hta ngawk ai hku galaw kau nu ai; dai majaw ya kaw nna hpyen majan a pru nga na sai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai ga majaw Asa gaw myihtoi wa hpe masin pawt nna, htawng hta e rawng da wu ai: shi gaw dai lam majaw shi hpe n-yun bu nna, dai aten e, mung masha nkau mi hpe mung sharu shatsang mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya Asa galaw ai lam npawt ndung hkren, Yuda hte Israela hkawhkam laika ni hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya Asa hkaw dung ai sumshi jahku ning hta e, shi a lagaw hta ana kap nna, grai machyi jung nga timung, Yehowa hpe n tam ai sha, tsi sara ni hpe mahtang tam nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asa gaw kaji kawa ni hte rau yup pyaw wa nna, shi hkaw dung ai mali shi langai ning hta e si wa sai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mung masha ni gaw, shi a moi mang hpe hpaw ya chye ai sara ni hpaw da ai manam pyaw ai baw amyu myu hpring ai yup ku hta sharawn da nhtawm, Dawi mare e shi a matu shi krawk da ai lup hta makoi mayang di ai hte, shi a matu grai kaba ai wan nat poi mung galaw ma ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya shi a kasha Yehosahpat gaw shi a malai hkaw dung nna, Israela mungdan hpe hkap daw lu hkra, n-gun da ting nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai shi gaw Yuda mung na bunghku kum ai mare ni mahkra hta hpyen, Yuda mung shara shagu hkan mung, shi kawa Asa lu la ai Ehprim mung na mare ni hta mung, sin langa tawn da mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehosahpat gaw, shawng na kawa Dawi a lam ni hta hkawm nga nna, Bala hpara ni hpe n tam ai majaw, Yehowa gaw shi hte rau rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw Israela masha ni zawn n re ai sha, shi kawa a Karai Kasang hpe hkan tam nna, shi a htet da ai ga hpe hkan nang nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai re ai majaw Yehowa gaw, dai mungdan hpe shi a lata hta shagrin da nna, Yuda mung ting shi hpe hkanse jaw mu ai; shi gaw sutgan arawng sadang law law lu nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa a lam ni hpe hkan nang na shi myit hkut nga nna, Yuda mung hta na tsaw ai kawng ni a nawku shara ni hte Asherim sumla ni hpe htawm kau wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya shi hkaw dung ai masum ning hta e, Yuda mare ni hta sharin achyin ya na matu, shi a du salang ni ngu ai, Ben-haila, Obadia, Zehkaria Nehtanela, Mihka hte hpe shangun dat mu ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />shanhte hte rau Lewi masha Shemaia, Nehtania, Zebadia, Asahela, Shemiramot, Yonahtan, Adonia, Tobiya, Togadoni hte hte, hkinjawng Elishama yan Yehoram hte hpe shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte gaw Yehowa a tara laika hpe gun let, Yuda mung hta sharin shaga nna, Yuda mare ni hproi hkra htawt hkawm ai hte mung masha ni hpe sharin achyin ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai Yuda mung grup yin na mungdan ni mahkra a ntsa e Yehowa hkrithpa du nna, shanhte gaw Yehosahpat hpe hpyen n gasat gwi mat ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hpilisti masha nkau mi mung Yehosahpat hpe kumhpa hte hkanse gumhpraw jaw mu ai: Arabi masha ni mung, sagu la hkying sanit e sanit tsa, nam la hkying sanit e sanit tsa sak jaw mi ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya Yehosahpat gaw garai n-gun ja wa ai hte, Yuda mung hta hpyen dap hte sut rai tawn da ai mare ni hpe de da wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai shi gaw Yuda mare ni hta amu amyu myu galaw nna, Yerusalem mare hta nden ja ai hpyen share ni hpe tawn da mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Da ndai gaw share ni a dap lakung hkan nna, hti ai jahpan rai nga ai: Yuda amyu hta hkying mun up ai bu ni gaw, hpyen du Adna hte rau hpyen share sen masum rai nga ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />shi kaw hkan ai, hpyen du Yehohanan hte rau hpyen share sen lahkawng mun matsat rai nga ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />shi kaw hkan ai wa, myit masin mahkra hte Yehowa hpe shi a hkum ap ya ai, Zihkri a kasha Amasia hte rau, hpyen share sen lahkawng lawm ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ben-yamin amyu hta na, nden ja ai share wa Eliada hte rau, ndan hte n-gang lang ai hpyen masha sen lahkawng lawm ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi kaw hkan ai Yehozabad hte rau jin jin rai nga ai hpyen masha sen me mun matsat rai nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hkawhkam wa gaw, Yuda mung na bunghku kum ai mare ni hta shanhte hpe tawn da mi ai hta n-ga, shanhte gaw shi hpe yu lajang ai ni mung, rai nga ma ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yehosahpat gaw sutgan hte arawng sadang law law lu nna, Ahab hte mayu dama shaw hkat nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai shi gaw shaning tsawmra na jang, Samari mung Ahab hpang de sa jahkrum wu ai. Ahab gaw shi a matu hte shi kaw hkan bawp nang ai ni a matu sagu dumsu law law sat lajang nna, Ramotgilead de shi hte rau lung wa na shagwi wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai Israela hkawhkam Ahab gaw, “Nang ngai hte rau Ramotgilead de hkan lung na n ni?” Ngu nna Yuda hkawhkam Yehosahpat hpe san wu yang, shi gaw, “Ngai wa nang zawn, nye a amyu na a amyu zawn rai nga ma ai: anhte nang hte rau hpyen gasat ai de lung na ga ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Yehosahpat gaw, “Dai ni jang anhte Yehowa a ga hpe naw san yu ga ngu” nna Israela hkawhkam wa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Israela hkawhkam wa myihtoi mali tsa jahpawng tawn nhtawm, “Anhte gaw Ramot-gilead de hpyen gasat na, sa mai n sa mai na a kun?” Ngu nna shanhte hpe san mu yang, shanhte gaw, “Lung wa su; Karai Kasang gaw dai mare hpe hkawhkam wa a lata de ap ya na ra ai,” ngu nna htan mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rai timung, Yehosahpat gaw, “Anhte Yehowa hpe san yu lu na, shi a myihtoi langai ngai naw nga a ni?” Ngu nna san wu yang,
  </para>
  <para style="p">
    <verse number="7" style="v" />Israela hkawhkam wa gaw, “Yehowa hpe san yu na matu marai langi mi naw nga ai; rai timung, dai wa hpe ngai n dawng we ai: shi nye a lam n kaja ai hku hkrai hkaw ya ya re ai; dai wa gaw Imla a kasha Mihkaia rai ngai ai, ngu nna Yehosahpat hpe htan wu ai. Yehosahpat chyawm gaw, Hkawhkam wa dai lam n tsun u ga,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Israela hkawhkam gaw shangun ma langai mi hpe shaga nna, “Imla kasha Mihkaia hpe alawan shaga wa rit,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Israela hkawhkam hte Yuda hkawhkam Yehosahpat gaw, hkawhkam hpun palawng bu hpun let, Samari mare na chyinghka lam a ndaw e, tinang nang a tingnyang hta dung nga ma ai rai nna, myihtoi ni mahkra gaw shan a man e htoi nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkenana a kasha Zedekia gaw hpri nrung galaw nna, Yehowa ning nga ai, Suri masha ni hpe shaza kau lu hkra, ndai nrung hte nang shanhte hpe daru kau na mu ai, nga ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Myihtoi ni mahkra mung, “Ramot-gilead de lung gasat nna awng wa nu; Yehowa dai mare hpe hkawhkam wa a lata de ap ya na ra ai,” ngu nna hkaw ya mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya Mihkaia hpe sa shaga ai kasa gaw, “Yu u, myihtoi ni yawng hkawhkam wa hpe n-gup langai hte sha, kaja ai hku hkrai hkaw ya manu ai: dai majaw mang mung shanhte hte maren kaja ai hku sha hkaw ya u,” ngu nna shi hpe hpyi wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihkaia gaw, “Yehowa hkrung nga ai hte maren, nye a Karai Kasang ngai hpe tsun ai hte sha ngai htawn tsun na nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya shi gaw hkawhkam kaw du jang, hkawhkam wa gaw, “Mihkaia e, an gaw Ramot-gilead de hpyen gasat nna awng wa manu; shanhte hpe nan a lata de ap kau ai hkrum na mara ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hkawhkam wa gaw, “Yehowa a mying hte tengman ai ga hta kaga, nang ngai hpe hpa mung n tsun wu ai.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi shi gaw, “Sagu rem wa n nga ai sagu ni zawn, Israela masha ni yawng bum ga hkan e bra nga ma ai hpe ngai mu nngai:” Yehowa mung, “Ndai ni gaw madu n lu ma ai: langai hte langai tinang a nta de ngwipyaw ai hte nhtang wa manu ga,” nga ai, ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Israela hkawhkam gaw Yehosahpat hpe, “Ndai wa nye a lam kaja ai n rai, n kaja ai hku sha hkaw ya ya re ai, ngu nna ngai ngang hpe tsun ni ai n rai ni?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai Mihkaia gaw, “Dai re ai majaw Yehowa a ga madat mara ya mu: Yehowa gaw shi a tingnyang hta dung nna, sumsing lamu na zaw nawng zaw wa ni shi a hkra maga hte pai maga de tsap nga ma ai hpe ngai mu nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa mung, Israela hkawhkam Ahab gaw Ramot Gilead de lung wa nna si wa hkra, shi hpe kadai wa woi lau lu na rai ta? nga ai rai nna, langai mi gaw ndai lam, kaga wa gaw wora lam tsun shajang ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai wenyi langai mi gaw Yehowa man e sa tsap na ngai shi hpe woi lau lu na we ai, nga ai. Yehowa gaw, kaning di lau na wu ta? ngu nna san wu yang,
  </para>
  <para style="p">
    <verse number="21" style="v" />dai wenyi gaw, Ngai pru nna shi a myihtoi ni mahkra a n-gup hta masu ai wenyi tai na nngai, ngu nna htan wu ai. Yehowa mung, Nang shi hpe lau lu na wu ai: dai hku sa galaw su, ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai re ai majaw, yu u, Yehowa gaw ndai na a myihtoi ni mahkra a n-gup hta masu ai wenyi bang da wu ai; Yehowa mung na a lam n kaja ai hku hkrai hkaw ya ndai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai rai nna Hkenana kasha Zedekia sit sa nhtawm, Mihkaia hpe kahpret nna, “Yehowa a wenyi gaw nang hta shung lu hkra, gara lam hku ngai kaw na pru wa sata?” ngu ru ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihkaia gaw, “Yu u, nang wa makoi na nga, kata gawk de shang wa na shani jang, mu na rin dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israela hkawhkam wa mung, Mihkaia hpe rim la nna, mare agyi wa Amon hte ap ya nhtawm,
  </para>
  <para style="p">
    <verse number="26" style="v" />Hkawhkam wa ning nga ai, “Ngai ngwipyaw ai hte bai wa ai du hkra, ndai wa hpe htawng hta rawng da nna, matsan mayan di jaw lu jaw sha mu, ngu wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihikaia gaw, Nang gaja wa ngwipyaw ai hte bai wa n yang gaw, Yehowa nye a n-gup hte ga htawn tsun sai, n rai,” ngu wu ai. Bai shi gai, Mung masha ni e, yawng hte gaw dum nga mu law, nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai Israela hkawhkam hte Yuda hkawhkam Yehosahpat gaw Ramotgilead de lung wa ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ya Israela hkawhkam gaw Yehosahpat hpe, “Ngai nye a hkum hpe yu maya hking dagraw nna hpyen ginra de shang na nngai: nang mahtang hkawhkam hpun palawng bu hpun u,” ngu wu ai. Shing rai Israela hkawhkam gaw yu maya hking dagraw nna, shan gaw hpyen ginra de shang wa ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ya Suri hkawhkam gaw, Israela hkawhkam hta kaga, kaji kaba kadai hpe mung hkum gasat myit, ngu nna shi a hpyen leng bu ni hpe hkang da mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ya hpyen leng bu ni gaw Yehosahpat hpe mu mu yang, shanhte gaw, “Ndai wa gaw Israela hkawhkam rai nga ai,” nga nna shi hpe gasat na nga hkan shachyut mu ai. Yehosahpat chyawm gaw marawn jahtau nna Yehowa shi hpe karum wu ai: Karai Kasang shanhte hpe nhtang wa shangun mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai wa gaw, Israela hkawhkam n re ai hpe, hpyen leng bu ni chye dum yang, shi hpe n hkan shachyut ai, kayin mat wa ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Marai langai mi chyawm Israela hkawhkam wa a kan magap hte sinda magap lapran e hkra ya wu ai rai nna, shi gaw, “Kayin u, ngai hpe hpyen gasat de na shapraw wa e; ngai hkala nba grai wa hkrum ni ai,” ngu nna shi a leng hkang ai wa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai shani hta myit htum myit si gasat mu ai: rai timung, Israela hkawhkam wa gaw, Suri masha ni hte katut nga yang shana du hkra shi a hpyen leng hta e tsap nga nna, jan du jang si mat sai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yuda hkawhkam Yehosahpat gaw ngwipyaw ai hte Yerusalem mare, shi a nta de bai du wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi Hanani a kasha myihtoi Yehu gaw hkawhkam Yehosahpat hpe sa tau nna, “Nang gaw n hkru ai wa hpe karum na hte, Yehowa hpe n dawng ai ni hpe tsawra mai nga a ni? nang galaw ai amu a majaw Yehowa a pawt sindawng ai gaw na ntsa e du ra ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai timung, mung ting na Asherot sumla ni hpe htawm kau nna, Karai Kasang hpe hkan tam sharawng ndai majaw, nang hta kaja ai lam mu hkrup se ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya Yehosahpat Yerusalem mare e nga nga ai: shi gaw Berasheba mare kaw nna, Ehprim bum ga du hkra, bai jawt hkawm nhtawm, mung masha ni hpe kaji kawa ni a Karai Kasang Yehowa hpang de, kayin wa shagun mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hta kaga shi gaw Yuda mung ting na bunghku kum ai mare ni langai hte langai hta tara agyi ni hpe tawn da mu ai rai nna,
  </para>
  <para style="p">
    <verse number="6" style="v" />tara agyi ni hpe, “Nanhte gaw masha a amu n rai, Yehowa amu hpe tara dara nna, shi nanhte a tara dara ai amu hta lawm nga ai majaw, nanhte galaw ai amu hta sadi nga mu:
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa a hkrithpa gaw nanhte a ntsa e anga nga u ga; sadi ai hte galaw mu: anhte a Karai Kasang Yehowa hta n hkru n hkra ai hpa mung n rawng nga ai; shi gaw myi man n tau ai hte, sake manawn n sha nga ai,” ngu nna hkang dat mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hta kaga Yehosahpat gaw, Yerusalem mare hta e, Yehowa a tara hpe mung, masha amu hpe mung dawdan ya na matu, Lewi masha, hkinjawng ni hte Israela agyi salang ni hta na tara agyi tawn da nna, shanhte gaw Yerusalem e anga nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai shi gaw shanhte hpe. “Nanhte gaw hkum tsup ai myit hte Yehowa hpe hkrit kamyin let dawdan nga mu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mare kahtawng ni hta nga ai, nanhte a nhpu nnau ni gaw, masha asak sat ai amu, jep ai tara hte htet da ai ga ni hpe tawt lai ai amu, nanhte a man e sa shawk ma yang, nanhte hte nanhte a nhpu nnau ni a ntsa e pawt sindawng ai n du lu u ga, shanhte Yehowa man e mara n kap hkra, shanhte hpe shadum jahprang nga mu; dai lam galaw yang, nanhte mara n kap na myit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa amu hte seng ai lam shagu hta, hkinjawng agyi Amaria gaw nanhte a ntsa e up nga ai; hkawhkam wa hte seng ai lam shagu hta, Yuda hkawhkam nta up ai Ishmaela kasha Zebadia gaw up nga ai: Lewi masha ni mung, nanhte hpe tau na agyi ni, tai na rai ma ai. Nden ja ai hte galaw mu; Yehowa gaw mai kaja ai ni hte rau anga nga u ga, ngu nna hkang da mu ai.”
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang e Moba kashu kasha ni Ammon kashu kasha ni hte Menuim masha nkau mi gaw, Yehosahpat hpe gasat na lung wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi masha nkau mi Yehosahpat hpe, Suri mung na, nawng wora hkran hku nang hpe sa gasat na nga, Wunawng kaba lung wa nna, shanhte gaw Egedi ngu ai Hazazon-tama shara e dap jung nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna Yehosahpat hkrit nga ai hte, Yehowa hpe hkan tam shana nna, Yuda mung ting hta lusha gam shangun mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai Yuda mung masha ni gaw, Yehowa hpe akyu hpyi na nga, zuphpawng nga ma ai: shanhte gaw Yehowa hpe hkan tam na matu Yuda mare shagu hta na pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Yehosahpat gaw Yehowa a nta wang ndaw e Yuda hte Yerusalem masha ni a shawa hpawng hta tsap let,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Anhte a ji wa ni a Karai Kasang Yehowa e, nang gaw sumsing lamu hta e Karai Kasang nan rai nga ndai, n rai ni? nang gaw maigan amyu ni a mungdan mahkra a du rai nga ndai, n rai ni? nang hpe kadai na hkap daw lu hkra, na a lata hta n-gun atsam rawng nga lit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anhte a Karai Kasang e, ndai mung e nga yu ai amyu ni hpe, na a amyu Israela man na nang jahtaw kau ya nna, na a jinghku wa Abraham a aru arat hpe jaw da mu ai, n rai ni?
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw dai mung hta nga nga nna, na a amying nsang a matu chyoi pra ai shara gaw da ai hte,
  </para>
  <para style="p">
    <verse number="9" style="v" />ruyak ai, hpyen gasat ai, ari ahpri, ana zinli, hku wa wa ai, anhte a ntsa e du yang, na a amying gaw ndai nta hta shanu nga ai majaw, ndai nta hta na a man e anhte tsap nna, ru tsang hkrum let nang hpe hpyi jahtau yang, nang madat mara ya nna, hkye hkrang la na ndai, nga saga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya, yu u, Israela kashu kasha ni gaw, Egutu mung na pru wa yang, nang matsan dum nna, shaza kau da ai,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ammon a kashu kasha ni, Moba masha ni hte Seira bum masha ni gaw, nang anhte hpe jaw da ai Sali wunli ga hta na anhte hpe shapraw kau na nga, rawt masai: yu u, dai gaw shanhte a chyeju htang ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte a Karai Kasang e, nang shanhte hpe n dawdan ai nga na n ni? anhte hpe sa htim ai hpyen laba ni hpe, anhte a n-gun hte hkap manga kau lu na n rai; kaning di na mung anhte n chye sagaw ai: anhte a myi nang hpe mada yu nga saga ai,” nga nna hpyi let,
  </para>
  <para style="p">
    <verse number="13" style="v" />Yuda masha ni, madu jan, kashu kasha, kaji kaba yawng, Yehowa a man e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya, dai shaw hpawng ka-ang e lawm nga ai, Lewi amyu, Asap a dap lakung Matania, Yeiela, Benaia hte Zehkaria kasha Yahaziela ntsa e Yehowa a wenyi yu hkrat wa nna shi gaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />Yuda mung ting, Yerusalem mare na ni hte, nang hkawhkam Yehosahpat e, madat mara mu: Yehowa nanhte hpe ning nga ai, “Dai hpyen laba a majaw myit hkum ru, myit hkum kaji myit: dai hpyen gasat ai gaw nanhte a mu n rai, Karai Kasang hte seng nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hpawt de shanhte gaw Ziza kadawng e lung wa nna, Yeruela nam mali na hkaraw baw e hkrum na marin dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai timung nanhte gasat shara n nga ai: Yuda hte Yerusalem masha ni e, asim sha tsap nga mi: Yehowa nanhte hpe hkye hkrang la ai lam mada yu mu: hkum hkrit myit, myit hkum kaji; hpawt ni jang shanhte hpe htim mu; Yehowa nanhte hte rau rai nga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Yehosahpat gaw ga de gum dagup nna, Yuda masha ni yawng hte Yerusalem na mare masha ni mung, Yehowa man e gum dagup let Yehowa hpe nawku ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lewi amyu, Kohat hte Korah kashu kasha ni gaw tsap nga nna, grai kaba ai nsen hte, Israela Karai Kasang Yehowa hpe shakawn kungdawn nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai shanhte gaw hpang jahpawt jau jau rawt nna, Tekoa nam mali de sa wa ma ai: shanhte sa wa nga yang, Yehosahpat gaw tsap nna, Yuda masha ni hte Yerusalem masha ni e, “Madat mara mu; nanhte a Karai Kasang Yehowa hpe kamsham nga mu; shing rai yang nanhte grin wa lu na myit dai; shi a myihtoi ni hpe mung kamsham nga mu, shaloi nanhte ninglaw lu na myit dai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai shi gaw, mung masha ni hte bawng jahkut nhtawm, Yehowa a n-gaw nwai ai myit tutnawng grin nga ai majaw, mawn sumli ai hte shakawn kungdawn mu, nga nna hpyen luksuk ni a shawng e sa wa na, Yehowa hpe mahkawn mangoi chye ai ni hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya shanhte gaw makawn mangoi ai hte shakawn kungdawn hpang wa yang, Yehowa gaw, Yuda mung masha ni hpe hkap gasat na, Ammon, Moba hte Seira bum masha ni hpe gumle gumlau lam shangun nna, shanhte gaw shada da gasat ma ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Ammon hte Moba kashu kasha ni gaw Seira bum masha ni hpe atsai awai shaza kau lu hkra shaja nna, shanhte hpe jahtum kau ngut jang, shanhte langai hte langai shada da bai gasat nna shamyit kau mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ya Yuda mung masha ni gaw nam mali na langchyi du nna, dai wunawng wuwa hpe mada yu mu yang, yu u, shanhte mahkra; langai mi n lawt ai. Ga e kadawng taw ai yawng, si mang hkrai rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Yehosahpat hte shi a masha ni gaw, shanhte a lanep lu la na sa du ma yang, shanhte gaw dai si mang ni hta sut rai hte manu hpu ai gali lakai law law wa mu hkrup nna, langai hte langai n dang hpai hkra, hpyu la mu ai: dai gaw grai law nga ai majw, masum ya tup hpyu shinggyin la let nga nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya mali ya du yang shanhte gaw Berahka kadit e zuphpawng nga nna, dai yang e Yehowa hpe shakawn kungdawn ma ai: dai re ai majaw dai shara hpe dai ni du hkra Berahka kadit ngu nna shamying da mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai hpang Yehosahpat woi awn ai hte, Yuda mung hte Yerusalem masha ni nlang hte gaw kabu gara let Yerusalem mare de bai wa ma ai: kaning rai nme law, Yehowa gaw hpyen ni a ntsa e shanhte hpe kabu shangun mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi shanhte gaw tingse, sumpyi, pahtau dum let, Yerusalem mare na Yehowa a nta de du wa ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yehowa gaw Israela masha ni matu, hpyen ni hpe gasat kau nga ai lam, maigan mungdan ni yawng na ma yang, Karai Kasang a hkrithpa shanhte a ntsa e rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shing rai Karai Kasang gaw grup yin shara shagu ngwipyaw wa shangun nna, Yehosahpat a mungdan gaw asan apan rai nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ya Yehosahpat gaw Yuda mung ntsa e up nga ai: shi up hpang nga yang, aprat sumshi manga ning rai nga nna, Yerusalem mare hta e hkun manga ning tup up nga ai: shi a kanu gaw Shilahi a shayi sha Azuba rai lu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shi gaw kawa Asa a lam hta hkan hkawm nna, Yehowa a man e tengman ai lam galaw na, hpa mung n hprai kau wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rai timung, tsaw ai kawng ni a nawku shara ni hpe shi htawm kau wu ai n rai: mung masha ni gaw, kaji kawa ni a Karai Kasang hpe tinang a myit n-gun hte garai n tam ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Naw gawn ra ai Yehosahpat a amu a lam npawt ndung hkren, Israela hkawhkam ni a jahpan laika hta lawm ai, Hanani a kasha Yehu a laika hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dai hpang e Yuda hkawhkam Yehosahpat gaw, Israela hkawhkam Ahazia hte matut nga ai; dai wa gaw grai n hkru ai amu galaw nga ai:
  </para>
  <para style="p">
    <verse number="36" style="v" />shi hte rau Tarshi de sa na sanghpaw li shachyaw na, shi hte myit hkrum nna, dai sanghpaw li ni hpe Ezion-gebera e shachyaw mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai shaloi e Marresha masha Dodawahu a kasha Elieze hte matut ndai majaw, Yehowa gaw na a amu hpe jahten kau nu ai, ngu nna myihtoi htoi ya wu ai. Sanghpaw li ni mung Tarshi de n sa lu hkra, agrawp mat ai hkrum lu ai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yehosahpat gaw kaji kawa ni hte yup pyaw wa nna, shanhte hte rau Dawi mare hta makoi mayang di ai hkrum wu ai: shi a kasha Yehoram gaw shi a malai hkaw dung nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehosahpat a shadang sha ni, shi a kanau ni gaw, Azaria, Yehiela, Zehkaria, Azaria, Mihkaela, Shehpatia hte rai ma ai: shanhte nlang hte gaw Israela hkawhkam Yehosahpat a shadang sha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte a kawa gaw shanhte hpe aja, gumhpraw, sutgan kaumhpa law law hte hpawn, Yuda mung na bunghku kum ai mare hpe ap ya mu timung; mungdan gaw kasha alat Yehoram hpe ap ya wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya Yehoram gaw kawa a mungdan ntsa e up nga nna n-gun ja wa jang, shi gaw kanau ni mahkra hte Israela hkawhkam kasha ni nkau mi hpe, nhtu hte sat kau mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehoram gaw hkaw dung hpang ai shaloi e asak sumshi lahkawng ning rai lu ai rai nna, Yerusalem mare hta e matsat ning up nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw Ahab a shayi sha hpe la ai majaw, Ahab a nta masha ni zawn, Israela hkawhkam ni a lam hkan nna, Yehowa a man e n hkru n hkra ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai timung, Yehowa gaw Dawi hte tawn da ai ga shaka hte, shi a kashu kasha ni a man e tutnawng pyengdin htoi tu nga u ga, nga nna ga ndat tawn da ai majaw, Dawi a nta hpe jahten kau mayu ai n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hkawhkam a aprat e Edom masha ni gaw Yuda hkawhkam hpe gumlau nna, tinang a amyu hkawhkam shadun mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Yehoram gaw shi a hpyen du ni hte hpyen leng ni mahkra hte rau rap sa wa nna, shi hpe wang tawn ai Edom masha ni hte shanhte a hpyen leng bu ni hpe shana aten e sat kau mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai timung Edom mung gaw dai ni du hkra Yuda hkawhkam hpe gumlau nga ai; dai aten e Libna mung shi hpe gumlau nga ai: kaning rai nme law, shi gaw kaji kawa ni a Karai Kasang Yehowa hpe kau da nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />Yuda kawng ni a ntsa e pyi nawku shara tawn da nna, Yerusalem masha ni hpe shut hpyit shangun ai hte, Yuda mung masha ni hpe lam woi shadam mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai aten e myihtoi Elia laika shi kaw du nna, “Na a nji Dawi a Karai Kasang Yehowa ning nga ai. Nang gaw na nwa Yehosahpat a lam hte Yuda hkawhkam Asa a lam ni hpe n hkan ai sha,
  </para>
  <para style="p">
    <verse number="13" style="v" />Israela hkawhkam ni a lam hkan nna, Ahab a nta masha ni zawn, Yuda hte Yerusalem masha ni hpe shut hpyit shangun ai hta n-ga, nang hta grau kaja nga ai, na nwa nta na na nnau ni hpe sat kau ndai majaw,
  </para>
  <para style="p">
    <verse number="14" style="v" />yu u, Yehowa gaw, na a mung masha ni, na a nshu nsha ni, na nshu nsha ni a kanu ni hte nang lu malu mahkra hpe ana zinli kaba hte ari jaw na mu ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />nang mung kan ana kaba kap nna, lani hte lani na a kan pu ni ayai hkra machyi nga na ra ai,” ngu nna ka dat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai Yehowa gaw Hpilisti masha ni hte Hkusha mung makau e nga ai Arabi masha ni gaw, Yehoram hpe gumlau mu ga nga, shadut mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte gaw Yuda mung hpe lung gasat nna, shaza kau mu ai: hkawhkam htingnu e mu mamu sut rai mahkra hte, kashu kasha ni madu jan ni yawng hpe rim mat wa mu ai rai nna, shi a kasha hpungdim Yehoaza hta kaga, shadang sha langai mi muk n ngam nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hpang Yehowa gaw, galoi n mai hkraw ai kan ana hte shi hpe ari jaw wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai shi gaw na na wa machyi jung nga nna, ni ning ladu hkrum yang grai machyi bu ai majaw, shi a kan pu ni ayai pru nna shi si mat sai. Mung masha ni chyawm gaw kaji kawa ni hpe zawn, shi a matu wan nat poi n galaw ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw hkaw dung hpang yang asak sumshi lahkawng ning rai nga nna, Yerusalem mare hta matsat ning up nga ai; kadai mung n yawn ai shi si mat sai: Dawi mare hta lup makoi rai timung, hkawhkam ni a lup hta makoi ai n rai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yerusalem masha ni gaw shi a kasha hpungdim Ahazia hpe shi a malai hkawhkam shatai mu ai: kaning rai nme law, Arabi masha ni hte rau dap de shang ai damya ni gaw kahpu ni nlang hte hpe sat kau mu ai. Shing rai Yuda hkawhkam Yehoram a kasha Ahazia up nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahazia gaw hkaw dung hpang yang, asak mali shi lahkawng ning rai nga nna, Yerusalem mare hta e laning mi up nga ai. Shi kanu a amying Ahtalia rai nga nna, shi gaw Omri a kasha rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />N hkru ai amu galaw na shi a kanu shi hpe hpaji daw ya ai majaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />shi gaw Ahab a nta masha ni a lam hta hkan hkawm nga nna, shanhte zawn Yehowa a man e n hkru n hkra ai amu galaw wu ai: shi a kawa si ai hpang, shanhte gaw shi hpe hten hkra hpaji daw ya mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shi gaw shanhte a hpaji lam hkan nna, Ramot-gilead de Suri hkawhkam Hazaela hpe sa gasat na matu, Israela hkawhkam, Ahab a kasha Yehoram hte myit hkrum wu ai; Suri masha ni chyawm gaw Yoram hpe hkala kau mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai, Suri hkawhkam Hazaela hpe gasat yang, shanhte gaw Rama shara e shi hpe jahkrum ai hkala nba hpe shamai na matu, hkawhkam wa gaw Yezrela mare de bai wa nna, shi machyi nga ai majaw, Yuda hkawhkam Yehoram a kasha Azaria gaw, Ahaba a kasha Yehoram hpe sa hpu yu na nga, Yezrela mare de yu wa ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahazia gaw Yoram hte rau sa wa ai majaw, shi a hten wa ai lam Karai Kasang kaw na rai nga ai: shi sa du yang shi gaw Yehoram hte rau Nimshi a kasha Yehu hpe sa hkap tau ma ai: dai wa gaw Ahab a nta masha ni hpe sat kau na matu, Yehowa shi hpe namman chya ya wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya Yehu gaw Ahab a nta masha ni hpe shamyit kau mu yang, shi gaw Yuda hkawhkam kasha ni hte, Ahazia hpe daw jau nga ai, shi a kahpu kanau ni a kasha ni hpe mu hkrup nna, shanhte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Ahazia gaw Samari shara e makoi nga ai; shi hpe hkan tam nna mu hkrup jang, Yehu hpang de woi wa nna sat kau mu ai. Shi gaw, myit masin mahkra hte Yehowa hpe hkan tam ai Yehosahpat a kasha re ai lam dum nna, shi hpe makoi mayang di mu ai. Ahazia nta masha ni chyawm gaw mungdan hpe up lu na magam n nga sai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahazia kanu Ahtalia gaw, shi a kasha si nga ai hpe mu wu yang, shi rawt nna, Yuda mung na hkawhkam kasha ni nlang hte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai timung, hkawhkam a shayi sha Yehosheba gaw Ahazia kasha Yosha hpe, sat kau hkrum ai hkawhkam kasha ni hta na mayun shaw la nhtawm, shi hte shi a masut num hte rau yup gawk hta e tawn da wu ai. Shing rai hkawhkam Yehoram a shayi sha Ahazia a kajan, hkinjawng Yehoiada madu jan Yehosheba gaw, shi hpe makoi da nna, Ahtalia gaw shi hpe n sat kau wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai shi gaw shanhte hte rau kru ning tup Karai Kasang a nta hta makoi nga nna, Ahtalia gaw dai mung ntsa e up nga ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya sanit ning ngu na hta Yehoiada gaw n-gun ja wa nna, hpyen latsa up ai bu ni, Yeroham a kasha Azaria, Yehohana a kasha Ishmaela, Obed a kasha Azaria, Adai a kasha Masea, Zihkri a kasha Elishahpat hte hpe shaga nna, shanhte hte ga shaka tawn da mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw Yuda mung hta jawt hkawm nna, Yuda mare ni yawng hta na Lewi masha ni hte, Israela dap lakung ni a agyi salang ni hpe hpawng shangun nna, Yerusalem mare de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai dai shawa hpawng ting gaw Karai Kasang a nta hta hkawhkam wa hte ga shaka tawn da mu ai. Yehoiada gaw, “Yu mu, Yehowa gaw Dawi a kasha ni a lam tsun dan ai hte maren, hkawhkam wa a kasha gaw up na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nanhte galaw na amu gaw da ndai rai nga ai: laban nhtoi hta shang ai hkinjawng ni hte Lewi masha ni hpung masum hta na hpung mi gaw chyinghka sin na ma ai; hpung mi gaw hkawhkam htingnu hpe sin na ma ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />hpung mi gaw Npawt chyinghka makau e sin na ma ai: shawa masha ni chyawm gaw Yehowa nta na wang hta hpawng nga na mara ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkinjawng ni hte daw jau nga ai Lewi masha ni hta kaga, kadai mung Yehowa a nta de hkum shang mu ga: shanhte chyoi pra nga ai majaw shang lu na ma ai: mung masha ni gaw Yehowa matsun maroi ga hte maren hkan galaw na ma ai:
  </para>
  <para style="p">
    <verse number="7" style="v" />Lewi masha ni langai hte langai tinang a ri nhtu lang let, hkawhkam grup yin e tsap nga nna, nta de shang mashang kadai hpe mung sat kau mu: hkawhkam wa gaw shang wa pru wa yang, hkan sin nga mu,” ngu nna hkang da mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya Lewi masha ni hte Yuda amyu masha ni yawng, hkinjawng Yehoiada hkang da ai lam shagu hte maren galaw ma ai rai nna, langai hte langai gaw, laban nhtoi nta e shang wa ai ni hpe mung, pru wa ai ni hpe mung shaga la mu ai: kaning rai nme law hkinjawng Yehoiada gaw Lewi hpung ni hpe garai ndat dat mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai hkinjawng Yehoiada gaw, Karai Kasang a nta hta rawng nga ai, hkawhkam Dawi a ri nhtu ni, n-gang ni hte hpyen rai ni hpe, hpyen latsa up ai bu ni hpe ap ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai shi gaw masha ni yawng, tinang a ri nhtu lang let, nta a hkra maga kaw nna pai maga du hkra, tawn hkungri hte nta makau hku, hkawhkam wa grup yin e tsap nga shangun mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi shanhte gaw hkawhkam kasha hpe shapraw nhtawm ja janmau shagup ya let sakse ga jaw nna, shi hpe hkawhkam shatai mu ai: Yehoiada hte shi a kasha ni gaw, shi hpe namman chya ya nna, “Hkawhkam wa gaw asak galu u ga law,” nga nna jahtau ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya Ahtalia gaw mung masha ni gat hkawm nna, hkawhkam wa hpe mahkawn shakawn nga ai nsen na wu yang, shi gaw Yehowa nta kata e nga ai masha ni kaw sa du nna,
  </para>
  <para style="p">
    <verse number="13" style="v" />mada yu wu yang, yu u, hkawhkam wa gaw chyinghka lam na shadaw makau e tsap nga nna, hpyen du ni hte pahtau dum ai ni shi a makau e rai nga ma ai; mung masha ni nlang hte mung kabu gara nga ai hte pahtau dum ma ai: mahkawn mangoi chye ai ni mung dum ai baw amyu myu lang nna, mahkawn shakawn nga ma ai. Shaloi Ahtalia gaw shi a hpun nba gang je kau let, “Gumlau law, gumlau law,” nga nna jahtau nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hkinjawng Yehoiada mahtang, “Shi hpe Yehowa a nta kata e n sat u ga, nga nna mung, Dap shinggan de shapraw nna shi kaw hkan nang ai wa kadai hpe mung nhtu hte sat kau mu,” nga nna mung, hpyen luksuk ni a hpyen latsa up ai bu ni hpe hkang da mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai shanhte gaw shi hpe lam yen ya nna, hkawhkam a nta na gumra ni shang ai lam de du jang, dai yang e shi hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai Yehoiada gaw, mung masha ni mahkra hte hkawhkam wa gaw, Yehowa masha tai mu ga nga, shi hte ga shaka tawn da shangun mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mung masha ni mahkra gaw Bala nta de sa nna, dai hpe run kau mu ai: de a tawn hkungri ni hte sumla ni hpe agrawp kau nna, Bala a hkinjawng Matan hpe hkungri ni a man e sat kau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hta kaga, Yehoiada gaw, Mawshe tara hta ka da nna, Dawi hkan galaw ai lam hte maren, kabu gara ai hte mahkawn mangoi let, Yehowa hpe wan nat hkungga nawng ya na matu, Yehowa nta hta Dawi tawn da ai hkinjawng Lewi masha ni a lata npu e, Yehowa nta matu amu galaw na agyi ni hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa nta na chyinghka ni a makau e mung, sin ai masha shi tawn da nna, hpa lam hta mung n san n seng ai wa kadai mung shang lu na n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai shi gaw, hpyen latsa up ai bu ni, arawng lu ai ni, munggyi ni hte mung masha ni mahkra hpe shaga la nhtawm, Yehowa a nta hta na hkawhkam wa hpe woi bawp wa nna, shanhte gaw ntsa chyinghka lam hku e hkawhkam wa htingnu de shang nhtawm, hkawhkam wa hpe mungdan tingnyang hta shadun mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai mung masha ni nlang hte gaw kabu gara nga ma ai rai nna, mare gaw asim sha rai nga ai. Shanhte gaw Ahtalia hpe nhtu hte sat kau manu ai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yosha gaw hkaw dung hpang yang, asak sanit ning rai nga nna, Yerusalem mare hta mali shi ning up nga ai: shi a kanu gaw, Berasheba masha Zibia rai lu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yosha gaw hkinjawng Yehoiada a prat e Yehowa man e dingman ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehoiada gaw shi hpe num lahkawng la ya nna, shi shayi shadang sha hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hpang Yosha gaw Yehowa nta hpe galaw lajang na myit hkut nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna shi gaw hkinjawng ni hte Lewi masha ni hpe shaga la nna, “Nanhte gaw Karai Kasang a nta hpe laning mi hte laning mi galaw lajang na matu, Yuda mare ni hta jawt hkawm nna, Israela masha ni nlang hta na gumhpraw lahkawn mu: dai lam hpe lau galaw mu,” ngu nna hkang dat timung, Lewi masha ni gaw tin nga ma ai, n rai
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna hkawhkam wa gaw agyi Yehoiada hpe shaga nna, “Sakse sum a matu, Yehowa shangun ma Mawshe hte Israela shawa hpawng hpe tawn da ai alu hpe Yuda hte Yerusalem masha ni yawng hta na lahkawn la na matu, hpa majaw Lewi masha ni hpe n shadut mu ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai n hkru ai num Ahtalia kasha ni gaw, Karai Kasang a nta hpe run kau nna, Yehowa nta matu majai kau ai arai ni hpe, Bala hpara ni hpe nawng ya kau mu ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shing rai hkawhkam wa hkang da nna, shanhte gaw sumpu galaw nhtawm, Yehowa nta chyinghka lam shinggan e shadun da mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai shanhte gaw, Karai Kasang a shangun ma Mawshe gaw nam mali hkan e Israela masha ni kaw na lahkawn la ai alu kaumhpa hpe, Yehowa matu naw lahkawn la na, Yuda mung hte Yerusalem mare hta ga shabra mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Du salang ni hte mung masha ni gaw kabu gara let la sa nna, jaw ngut hkra dai sumpu hta bang da mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya dai sumpu hta gumhpraw law law rawng nga ai rai nna, Lewi masha ni gaw dai sumpu hpe hkawhkam a ali ama ni hpang de jashawn mu yang, hkawhkam a chyare wa hte hkinjawng agyi a ali ama ni gaw dai sumpu hta na gumhpraw shaw la nna, sumpu hpe myi na shara e bai tawn da mu ai. Shanhte shani shagu dai lam galaw nna, gumhpraw law law mahkawng da mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai hkawhkam wa hte Yehoiada gaw dai gumhpraw hpe Yehowa nta hta amu galaw yu ai ni hpe ap ya mu ai: shanhte gaw Yehowa nta galaw lajang na matu wut chye gaw ai ni, lasama ni, ndup ni hte janghkam ni hpe saw da nna karan ya mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai amu galaw ai ni gaw shaja nna, Karai Kasang a nta hpe shangang ai hte myi na hte maren galaw lajang ngut manu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai amu hpe galaw ngut jang, shanhte gaw dai ngam ai gumhpraw hpe hkawhkam wa hte Yehoiada hpang de la wa mu ai: dai hta na shan gaw Yehowa nta hta daw jau na hte shagu hkungga amyu myu nawng ya na matu chyaw ni, aja gumhpraw arai ni hpe galaw da mu ai. Yehoiada prat dingsa e shanhte gaw Yehowa nta hta tutnawng wan nat hkungga nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya Yehoiada gaw dingla ugut gu prat shanut nu nna si wa sai; shi a asak latsa sumshi ning rai lu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi gaw Israela amyu hta mung, Karai Kasang hte shi a nta matu mung kaja ai hku galaw nu ai majaw, Dawi mare hta hkawhkam ni hte rau, shi hpe makoi mayang di mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Yehoiada si ai hpang, Yuda du salang ni gaw hkawhkam wa hpe sa nawku nna, shi gaw shanhte a ga madat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte gaw, Yehowa a nta hte kaji kawa ni a Karai Kasang hpe kau da nna, Asherim sumla ni hte, kaga hpara ni hpe daw jau mu ai; dai rai nna, Yuda mung hte Yerusalem ntsa e, dai mara majaw, pawt sindawng ai du ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai timung, shanhte gaw Yehowa hpang de kayin wa mu ga, myihtoi ni hpe shi shangun dat nna, shanthe gaw sakse hkam ma timung, shanhte madat ma ai n rai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai, Karai Kasang a Wenyi gaw, hkinjawng Yehoiada kasha Zehkaria ntsa e du nna, shi gaw shawa hpawng ntsa e tsap let, Karai Kasang ning nga ai: “Nanhte gaw tinang a akyu hten hkra, hpa majaw Yehowa a tara hpe tawt lai kau myit ta? Nanhte gaw Yehowa hpe kau da mu ai majaw, shi nanhte hpe mung kau da manit dai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte mahtang shi hpe gumlau nna, hkawhkam wa hkang da ai hte maren, Yehowa nta a wang kata e nlung hte kabai nna sat kau mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai hkawhkam Yosha gaw, Zehkaria kawa Yehoiada chyeju hpe n dum ai, shi a kasha hpe sat kau ya nu hka. Zehkaria gaw si wa ningtawn e, “Yehowa dai hpe mada yu nna matai htang u ga,” nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai shaning ladu hkrum yang, Suri hpyen luksuk ni gaw shi hpang de lung wa nna, Yuda mung hte Yerusalem mare de sa du ai hte, mung masha ni a du salang ni mahkra hpe sat kau nhtawm, lanep yawng Damasku hkawhkam hpang de shagun dat mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yuda masha ni gaw, tinang a kaji kawa ni a Karai Kasang hpe kau da mu ai majaw, Yehowa gaw shanhte a law la ai luksuk laba ni hpe, n law nga ai Suri masha ni a lata hta ap ya kau mu ai rai nna, shanhte gaw Yosha hpe dawdan mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi hpe hpyen ai ni pru mat wa jang, shi gaw garai machyi hkrum let hti nga nna, hkinjawng Yehoiada kasha ni hpe sat kau ai mara majaw, shi a ali ama ni gaw shi hpe gumlau nna, yup ku ntsa e shi hpe sat kau mu ai; Dawi mare hta shi hpe makoi mayang di mu timung, hkawhkam ni a lup hta makoi mu ai n rai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi hpe gumlau ai ni gaw, Ammon shayi sha Shimeat a kasha Zaba, Moba shayi sha Shimrit a kasha Yehozaba yan rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya shi a kasha ni a lam, shi amu galu kaba wa ai hte Karai Kasang a nta hpe galaw lajang ai lam ni gaw, hkawhkam jahpan laika ni hta ka da nga ai. Shi a kasha Amazia gaw shi a malai hkaw dung nga ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amazia gaw hkaw dung hpang yang, asak hkun maga ning rai nga nna, Yerusalem mare hta hkun jahku ning up nga ai. Shi a kanu gaw Yerusalem numsha Yehoadan rai lu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw Yehowa man e dingman ai amu galaw timung, hkum tsup ai myit hte n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya shi gaw dai mungdan hta ahkang aya majing lu jang, shi gaw shi a kawa hpe sat kau ai ali ama ni hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung, “Kasha ni a majaw kawa, kawa a majaw kasha ni si ai hkrum lu na n rai; kadai mung tinang a mara hte sha si ai hkrum lu na rai nga ai,” nga nna Mawshe a tara laika hta ka da ai hku hkan nna, Yehowa hkang da ai hte maren, shan a kasha ni hpe sat kau mu ai nrai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai hta kaga Amazia gaw Yuda mung masha ni hpe jahpawng da nhtawm, kawa ni a dap lakung hkan nna, Yuda hte Ben-yamin masha ni hpe, hpyen hkying mi up ai bu, hpyen latsa up ai bu ni a npu e tawn da mu ai: asak hkun ning lai nna, ri hte n-gang lang lu ai, hpyen majan hta shang ram ai ni, marai sen masum rai nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hta n-ga, gumhpraw joi hkying mi hte nden ja ai Israela share sen mi hpe shap la wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai timung Karai Kasang a masha wa langai mi shi kaw sa nna, “Hkawhkam wa e, Israela hpyen luksuk ni nang hte rau n sa u ga; Yehowa gaw Israela masha ngu ai, Ehprim a kashu kasha ni hte rau nga ai, n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai timung nang sa mayu yang, sa gasat shaja nga u; Karai Kasang, chyawm gaw, hpyen ni a man e nang hpe jasum kau na ndai: Karai Kasang gaw, karum na mung, jasum kau na mung, n-gun atsam rawng nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai Amazia gaw, “Ataw, Israela dap hpe gumhpraw joi hkying mi jaw kau ai gaw, kaning di na rai ta?” ngu nna Karai Kasang a masha wa hpe san wu yang, shi gaw, “Yehowa dai hta grau nna nang hpe jaw lu ai,” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai rai nna Amazia gaw Ehprim mung na du sa ai hpyen masha ni hpe karan kau nna, tinang a shara de bai wa shangun mu ai; dai majaw shanhte gaw Yuda mung hpe ja ja hpawt bu nna, tinang a shara de n-yun bu let bai wa ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Amazia gaw n-gun shaja nna, shi a masha ni hpe woi awn let, Jum Kadit e du nna, Seira kashu kasha mun mi hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai Yuda kashu kasha ni gaw, masha mun mi hpe chyahkrung naw rim la nna, Sela lunghkrung ntsa de woi lung nhtawm, daw hten hkra dai lunghkrung kaw na kanawng jahkrat dat mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai, Amazia hte rau hpyen gasat na ahkang n lu ai, shi shabawn kau dat ai hpyen masha ni gaw, Samari mung kaw nna, Bet-horon de hkra Yuda mare ni hpe hpya sha ai hte, masha hkying masum sat kau nhtawm, lanep law law magawn la mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Amazia gaw Edom masha ni hpe gasat kau ngut jang, Seira kashu kasha ni a Hpara ni hpe la wa nna, tinang a Hpara shatai nhtawm, dai ni a man e gum dagup nawku let, manam pyaw ai baw nat nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai re ai majaw Yehowa gaw Amazia hpe pawt bu nna, myihtoi langai mi shi hpang de shangun dat nna, dai wa gaw, “Tinang a amyu hpe pyi na a lata na n shaw la lu ai Hpara tsasam ni hpe, nang hpa majaw hkan tam nga n ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai lam tsun ai majaw hkawhkam wa gaw, “Nang hkawhkam a salang bawng rai n ni? atsin sha nga u; hpa majaw nang hpe sat kau na rai ta?” ngu nna tsun wu yang, myihtoi wa gaw, “Ndai lam nang galaw ai hte, ngai hpaji daw ai gaw n madat ndai majaw, Karai kasang gaw nang hpe shamyit kau na maw nga ai, ngai chye nngai,” ngu nhtawm atsin sha nga nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai aten e Yuda hkawhkam Amazia gaw hpaji daw nna, Israela hkawhkam Yehu a kashu Yehoaza kasha Yosha hpang de kasa shangun dat nna, “An gaw shada myi man chyaw gasat hkying ga,” ngu nna tsun dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Israela hkawhkam Yosha gaw, Yuda hkawhkam Amazia hpang de kasa shangun dat na, “Lebanon bum e tu ai ju singwum gaw, lebanon bun na marau hpun hpe, Na a shayi sha hpe ngai sha hte ya sha gaw, ngu nna hpyi wu yang, Lebanon bum na matse langai mi gaw lai sa wa nna, ju singwum hpe kabye agrawp kau wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang gaw Edom masha ni hpe dang kau ai majaw, grang ai ga nang tsun nna myit kaba nga ndai: na nta e anga nga u; nang hkum nan hte Yuda mungdan gaw rau htum mat wa hkra, hpa majaw kajam galam amu sharaw nga n ta?” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rai timung, Amazia gaw dai ga hpe n madat wu ai: kaning rai nme law, Edom mung na Hpara ni hpe hkan tam ai majaw, hpyen ni a lata de shanhte hpe ap kau na, Karai Kasang jeyang nu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai re ai majaw Israela hkawhkam Yosha lung wa nna, Yuda mung hte seng ai Bet-sheme mare makau e Yuda hkawhkam Amazia hte shada myi man chyaw gasat hkat ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yuda masha ni mahtang Israela masha ni a man e sum wa nna, langai hte langai tinang a sum nta de hprawng wa ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai Israela hkawhkam Yosha gaw, Yuda hkawhkam Yehoaza kashu Yosha a kasha Amazia hpe Bet-sheme mare makau e rim la nna, Yerusalem de sa du yang, Ehprim chyinghka lam kaw nna jut chyinghka du hkra, Yerusalem mare a bunghku hpe dawng mali tsa run kau mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai hta kaga shi gaw, Karai Kasang a nta e rawng nna Obed-Edom sin ai aja gumhpraw rai ni mahkra hte, Hkawhkam nta na sutgan mahkra hpe, ama hkam masha hte hpawn, woi la nna, Samari mare de bai wa ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israela hkawhkam Yehoaza kasha Yosha si ai hpang, Yuda hkawhkam Yosha a kasha Amazia gaw shi manga ning naw hkrung nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ya naw gawn ra ai Amazia amu ni a lam npawt ndung hkren, Yuda hte Israela hkawhkam ni a laika hta ka da nga ai n rai ni?
  </para>
  <para style="p">
    <verse number="27" style="v" />Shi gaw Yehowa hpe kau da ai aten kaw nna Yerusalem mare hta shi hpe gumlau nna, shi gaw Lahkisha mare de hprawng wa ai: shanhte gaw Lahkisha de masha shangun nna, dai yang e shi hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shi a moi mang hpe gumra ntsa e la wa nhtawm, Yuda mare hta kaji kawoi ni hte rau makoi mayang di mu ai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Yuda mung masha ni nlang hte gaw asak shi kru ning kaba sai Uzia hpe san da nna, shi a kawa Amazia malai hkawhkam sahtai mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hkawhkam wa gaw kaji kawa ni hte rau yup pyaw wa ai hpang e shi gaw Elot mare hpe de da nhtawm Yuda mung hta bai shalawm la wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uzia gaw hkaw dung hpang yang asak shi kru ning rai nga nna, Yerusalem mare hta manga shi lahkawng ning up nga ai: shi a kanu gaw, Yerusalem numsha Yehkilia rai lu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw kaw Amazia lam shagu hte maren, Yehowa man e dingman ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw, Karai Kasang a shingran hpe chye na ai Zehkaria aprat e Karai Kasang hpe hkan tam nga nna, Yehowa hpe hkan tam ai laman e Karai Kasang gaw shi hpe awng shangun wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya shi gaw Hpilisti masha ni hpe sa gasat nna, Gat mare a bunghku, Yabne mare a bunghku hte Ashdod mare bunghku ni hpe run kau nhtawm, Ashdod ginwang hte Hpilisti mung hkan e mare nnan de da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hta kaga Hpilisti masha ni hpe mung, Gura-bala shara e nga ai Arabi masha ni hte Meunim masha ni hpe mung, gasat dang kau na matu, Karai Kasang shi hpe karum wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ammon masha ni mung Uzia hpe hkanse jaw mu ai: shi galu kaba wa nna shi hpe kajai gumhkawng ai gaw Egutu mung du hkra pri rai wa sai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hta kaga Uzia gaw Yerusalem mare na jut chyinghka e mung, kadit chyinghka e mung, bunghku jut e mung, langchyi galaw nna hpyen dap shatai wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nam mali hkan e mung shi langchyi de da nna, layang ga hte pa ga hkan e yamnga law law lu ai majaw, hka htung law law htu da wu ai: shi gaw sun hkauna amu hta grau sharawng ai majaw, bum ga hkan e mung, layang ga hkan e mung, yi hkauna galaw ai ni hte tsabyi sun chye lajang ai ni hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hta n-ga Uzia gaw, hpyen gasat chye ai luksuk lu nna, chyare wa Yeiela hte hpyen du Maseia jahpan la ai hte maren, hkawhkam wa hpyen du Hanania hkang ai hku hkan nna, hpung mi hte hpung mi pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kawa dap lakung ni a nambat hku hkan yang, nden ja ai share ni a agyi ni gaw, hkying lahkawng kru tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte up ai hpyen masha ni gaw, sen masum hkying sanit manga tsa rai nga nna, shanhte gaw hkawhkam wa matu, hpyen ni hpe dang kau hkra, nden ja ai hte hpyen majan gun ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Uzia mung hpyen luksuk ni mahkra a matu, n-gang, ri, hpri gup chyawp, hpri palawng, ndan hte nlung kabai na lakli ni hpe hkyen da wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai shi gaw Yerusalem mare na langchyi ni hte dap bunghku ni hta nna pala gap na hte nlung kabai na matu, hpaji rawng ai ni chye shachyaw ai gawng ni hpe tawn da wu ai. Shi a kajai gumhkawng ai gaw tsan tsan de pri rai wa sai; shi gaw hpung shingkang lu la hkra, mauhpa karum ai chyeju hkam la wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ya shi gaw hpung shingkang lu la jang, shi a akyu hten hkra myit kaba wa nna shi a Karai Kasang Yehowa hpe shut kau wu ai: kaning rai nme law, manam pyaw ai baw nat nawng ai hkungri ntsa e, manam pyaw ai baw nat nawng na matu, Yehowa a nawku htingnu kata de shi shang wa ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hkinjawng Azaria gaw, nden ja ai Yehowa a hkinjawng matsat shi hte rau, hkawhkam Uzia kaw hkan nang nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />shi hpe hkap hkum let, “Uzia e, nang gaw Yehowa hpe manam pyaw ai baw nat nawng ya na ahkang n lu ndai; manam pyaw ai baw nat nawng ya na matu, tinang hkum shachyoi shapra da ai, Arun a kashu kasha hkinjawng ni hkrai ahkang lu ma ai: ndai chyoi pra ai shara na pru wa u; nang tara hpe tawt lai kau nu ai; Karai Kasang Yehowa kaw na mung na a matu arawng sadang pru lu na n rai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Uzia chyawm gaw masin pawt nga ai; manam pyaw ai baw nat nawng na matu, manam pyaw ai baw a ban shi a lata hta lang nga ai: ya hkinjawng ni hpe masin pawt nga yang, Yehowa a nta kata na, manam pyaw ai baw nat ai hkungri makau e nga ai hkinjawng ni a man e, shi a lahtan hta manggang dan pru lu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hkinjawng Agyi Azaria hte hkinjawng ni mahkra gaw shi hpe mada yu yang, yu u, shi a lahtan hta manggang kap nga ai rai nna, shanhte shi hpe dai yang na alawan kanawng shapraw kau mu ai; Yehowa gaw shi hpe ari jaw wu ai majaw, shi hkum nan tin tin pru mat wa ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai hkawhkam Uzia gaw si ai shani du hkra manggang kap nna, de a majaw nta kaga hta a nga nga ai: Yehowa a nta na mung shinggan kau ai hkrum nga ai. Hkawhkam a kasha Yohtam gaw mung masha ni hpe up nga let, htingnu ntsa e mung madu nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Naw gawn ra ai Uzia galaw ai lam npawt ndung hkren, Amot a kasha, myihtoi Esaia ka da nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai Uzia gaw kaji kawa ni hte rau yup pyaw nga ai: shanhte hte rau makoi mayang hkrum timung, Shi gaw manggang kap ai wa re ai, nga nna tsun ai majaw, hkawhkam ni a lupwa hte seng ai ga dachyawk hta lup kau mu ai. Shi a kasha Yohtam gaw shi a malai hkaw dung nga ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yohtam gaw hkaw dung hpang yang, asak hkun manga ning rai nga nna, Yerusalem mare hta e shi kru ning up nga ai: shi a kanu gaw Zadok shayi sha Yerusha rai lu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw kawa Uzia a lam mahkra hpe hkan let, Yehowa a man e dingman ai amu galaw nga ai: rai timung, shi gaw Yehowa a nawku Htingnu de n shang wu ai. Mung masha ni chyawm gaw n shawp ai amu naw galaw nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw Yehowa a nta na ntsa chyinghka galaw ai hte, Ohpela bunghku hta law law gaw kahtap wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hta kaga shi gaw Yuda bum ga hkan e mare, maling dinggram hkan e hpyen dap hte langchyi, de da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ammon a kashu kasha ni a hkawhkam hpe mung shi gasat nna, shanhte hpe dang kau nu ai. Dai rai nna Ammon kashu kasha ni gaw dai shaning jang, gumhpraw joi hkying mi, hkaulan mam dang mun mi, muk-yaw mam dang mun mi shi hpe sak jaw mu ai: dai hte maren Ammon a kashu kasha ni gaw ni ning masum ning tup shi hpe sak jaw mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai Yohtam gaw shi a Karai Kasang Yehowa man e myit tsup nga ai majaw galu kaba wa nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Naw gawn ra ai Yohtam a amu a lam, shi hpyen gasat ai hte shi arawn alai lam nlang hte gaw, Israela hte Yuda hkawhkam laika ni hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw hkaw dung hpang yang, asak hkun manga ning rai nga nna, Yerusalem mare hta e shi kru ning up nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ya Yohtam gaw kaji kawa ni hte rau yup pyaw wa nna, Dawi mare hta e shi hpe makoi mayang di mu ai: shi a kasha Ahaza gaw shi a malai hkaw dung nga ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahaza gaw hkaw dung hpang yang, asak hkun ning rai nga nna, Yerusalem mare hta e shi kru ning up nga ai: shi gaw shi a kawa Dawi zawn Yehowa man e tengman ai amu n galaw ai hte,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela hkawhkam ni a arawn alai hta hkan hkawm nga ai rai nna, Bala hpara ni a matu sumla ni hpe jaw wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hta n-ga, Yehowa gaw Israela kashu kasha ni a myi man kaw na shachyut shaden kau ai maigan amyu ni a matsat shabat lam hkan let, Hinom kadit e manam pyaw ai baw nat nawng ya nna, shi a kasha ni hpe pyi wan nat hkungga shatai wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tsaw ai kawng ni a shara ni hta mung, kawng shagu a ntsa e mung, tsit lali ai hpun shagu a npu e mung, shagu hkungga hte manam pyaw ai baw nat nawng ya wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai re ai majaw, shi a Karai Kasang gaw Suri hkawhkam a lata hta shi hpe ap kau wu ai rai nna, shanhte gaw shi hpe ari jaw let, bawng law law wa rim la nna, Damasku mare de woi wa mu ai. Dai hta n-ga, Israela hkawhkam mung shi hpe dang kau nna, shi a masha law law hpe sat kau ya mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaning rai nme law shanhte gaw kaji kawa ni a Karai Kasang Yehowa hpe kau da ai majaw, Remalia kasha Peka gaw lani jan hta sha, nden ja ai Yuda masha sen me mun lahkawng sat kau mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai Ehprim wa-ngan Zihkri gaw, hkawhkam kasha Maseia, kunhting wa Azirkam hte hkawhkam malai Elkana hte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai, Israela kashu kasha ni gaw, tinang hte kahpu kanau daw ai ni hta na, kanu ni hte shayi shadang sha ni sen lahkawng rim la nhtawm, lanep law law hpyu kashun la let, samari mare de la wa mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung Oded mying ai Yehowa a myihtoi langai mi dai yang e nga ai: dai wa gaw Samari mare de bai wa ai luksuk ni hpe sa tau la nna, shanhte hpe, “Yu mu, nanhte a nji nwa ni a Karai Kasang Yehowa gaw Yuda amyu hpe pawt bu ai majaw, shanhte hpe nanhte a lata hta ap ya manit dai; nanhte mung lamu dep hkra, n-yun bu ai hte shanhte hpe sat kau manu hka.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya mung Yuda hte Yerusalem na kashu kasha ni hpe nanhte mayam num mayam la shatai na maw nga myit dai; ataw, nanhte nan nanhte a Karai Kasang Yehowa hpe shut kau ai ni, n rai nga myit ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai re ai majaw nye a ga madat mu: nanhte rim wa ai nanhte a nhpu nnau ni hpe dat dat mu: Yehowa a pawt sindawng ai gaw nanhte a ntsa e du na ra ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna, Ehprim a kashu kasha ni a agyi salang ni, Yehanan a kasha Azaria, Meshilemot a kasha Berehkia, Shalum a kasha Yezikia hte Hadlai a kasha Amaza hte gaw, hpyen gasat ai de na bai wa ai ni hpe hkap tau nna,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Nanhte rim wa ai masha ni hpe ndai mare de hkum woi wa myit: anhte a myi na mara hta bai shut kahtap hkra, nanhte a maw ai lam gaw, Yehowa hpe shut kau ai lam rai nga ai; anhte a yubak mahtang kaba la nna, Israela ntsa e pawt sindawng kahtet ai rai nga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shing rai hpyen masha ni gaw, bawng ni hte lanep rai ni hpe shawa hpawng a agyi ni a man e sa tawn da mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lahta e mying tsun sai masha ni gaw rawt nna, bawng ni hpe shaga la nhtawm, hpun palawng n lu ai ni hpe lanep hta na shabu jahpun ai hte, mawn sumli, kyepdin shadin, lu lu sha sha jaw nna, namman chya ya nhtawm, n-gun n ja ai ni hpe lawze hta sha jawn nna, kahpu kanau ni nga ai Yerihko mare ngu ai, ma-un hpun mare du hkra sa sa dat nna, Samari mare de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai aten e hkawhkam Ahaza gaw, shi hpe sa karum na matu, Asuri hkawhkam ni hpang de kasa shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaning rai nme law, Edom masha ni gaw Yuda mung hpe sa gasat nna, masha law law hpe bawng rim wa manu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpilisti masha ni mung Yuda mung na pa ga mare ni hte Dingda ginwang hpe sa gasat nna, Bet-sheme, Aiyalon, Gederot, Sohko mare hte de a ginwang kahtawng ni, Timna mare hte de a ginwang kahtawng ni, Gimzo mare hte de a ginwang kahtawng ni hpe kashun la nna, dai yang e nga nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaning rai nme law, Israela hkawhkam Ahaza majaw, Yehowa gaw Yuda mung hpe shagrit kau wu ai: shi gaw Yuda mung hta pagawn di wu ai rai nna, Yehowa hpe grai shut kau wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asuri hkawhkam Tiglat-pilnese shi kaw sa du timung, shi hpe karum ai n rai, garu na sharu shatsang wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kaning rai nme law, Ahaza gaw Yehowa nta hta na mung, hkawhkam nta hte hkawhkam kasha ni a nta hta na mung, sut rai karan la nna Asuri hkawhkam hpe jaw wu timung, shi a matu akyu n pru nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ndai hkawhkam Ahaza gaw, ndai aten e nde wa tsin-yam tsindam hkrum timung, Yehowa hpe grau nna shut kau nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kaning rai nme law, shi gaw, “Suri hkawhkam ni a Hpara ni gaw shanhte hpe karum ai majaw, ngai hpe mung karum mi ga, ngai shanhte hpe hkungga nawng ya na nngai,” nga nna Damasku mare a Hpara ni hpe shagu hkungga nawng ya timung, dai gaw shi a matu mung, Israela mung ting a matu mung, hten byak wa na lam rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahaza gaw Karai Kasang a nta na rai ni hpe shinggyin la na, dai ni hpe kahtum gadaw agrawp kau nhtawm, Yehowa nta chyinghka ni hpe la da nna, Yerusalem mare na njut nnaw hkan e tawn hkungri ni hpe galaw da wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hta kaga, Hpara tsasam ni hpe manam pyaw ai baw nat nawng na matu, Yuda mare shagu hta tsaw ai kawng ni a shara hpe de da nna, kaji kawa ni a Karai Kasang Yehowa hpe pawt bu shangun wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Naw gawn ra ai Ahaza amu a lam hte shi a arawn alai npawt ndung hkren, Yuda hte Israela hkawhkam laika hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya Ahaza gaw kaji kawa ni hte rau yup pyaw wa nna, Yerusalem mare kata e makoi mayang di timung, Israela hkawhkam ni a lup ni hta makoi mu ai n rai. Shi a kasha Hezekia gaw, shi a malai hkaw dung nga ai.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezekia gaw hkaw dung hpang yang asak hkun manga ning rai nga nna, yerusalem mare hta e hkun jahku ning up nga ai: shi a kanu gaw Zehkaria shayi sha Abiya rai lu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw kawa Dawi a lam mahkra hte maren, Yehowa man e dingman ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi hkaw dung ai shaning, shata langai hta, Yehowa nta chyinghka ni hpe hpaw nna, dai hpe galaw lajang wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw hkinjawng ni hte Lewi masha ni hpe shaga la nna, sinpraw maga na dam ai shara e jahpawng da nhtawm,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Lewi masha ni e, nye ga madat mara mu: tinang hkum hpe mung, nanhte a nji nwa ni a Karai Kasang Yehowa nta hpe mung, shachyoi shapra nna, ndai chyoi pra ai shara na shanut shanaw yawng yeng seng kau mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte a ji wa ni shut hpyit nna, anhte a Karai Kasang Yehowa a man e n shawp ai amu galaw masai; Yehowa hpe kau da nna shi shanu nga ai shara kaw na myi man kayin let, shingdu kayin mat wa masai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw Yehowa nta ndaw chyinghka ni hpe la da nna, pyengdin ni sat kau nhtawm, chyoi pra ai shara hta Israela Karai Kasang hpe manam pyaw ai baw hkungga mung n nat, wan nat hkungga mung n nawng ya manu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai re ai majaw Yehowa gaw Yuda mung hte Yerusalem mare npe pawt bu nna, nanhte mu nga ai hte maren, anhte ndi nda re ai hte shatan nhkan shara hte asawng asang shara tai saga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai rai nna anhte a ji wa ni gaw nhtu e si wa ai hte anhte a shayi shadang madu jan ni gaw bawng dung ai hkrum masai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya Israela Karai Kasang Yehowa a pawt bu ai gaw, anhte kaw na lai mat wa u ga, shi hte ga shaka tawn da na, ngai maw nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai sha ni e, hkum ganung nga myit; Yehowa a man e nanhte tsap nga nna, shi a shangun ma tai let, shi hpe daw jau na hte manam pyaw ai baw nat nawng na matu, nanhte hpe san da sai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai rai nna, Lewi masha, Kohat dap na Amasai a kasha Mahat, Azaria kasha Yoela; Merari a dap na, Abdai a kasha Kisha, Yehalela kasha Azari; Gershon dap na, Zimma kasha Yoa, Yoa kasha Eden;
  </para>
  <para style="p">
    <verse number="13" style="v" />Elizahpan a kasha Shimri yan Yeruela; Asap a kasha Zehkaria yan Matanna;
  </para>
  <para style="p">
    <verse number="14" style="v" />Heman a kasha Yehuela yan Shime; Yeduhtun a kasha Shemaia yan Uzela hte gaw rawt nna,
  </para>
  <para style="p">
    <verse number="15" style="v" />kahpu kanau ni hpe shaga nhtawm, tinang hkum shachyoi shapra ai hte, Yehowa a ga hkan nna, hkawhkam wa hkang da ai hte maren, Yehowa a nta jasan jaseng na matu shang wa masai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkinjawng ni gaw, Yehowa nta hpe jasan jaseng na matu, kata gawk ni hta shang nna, nbun nbaw shanut shanaw mahkra hpe seng kau nna, Yehowa a nta a wang e tawn da mu ai. Lewi masha ni gaw dai hpe Kidron hkaraw de htawm kau mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai nta hpe shachyoi shapra na matu, shawng na shata praw shani e shanhte galaw hpang nna, matsat ya shani e Yehowa nta jan de du ma ai; dai hpang matsat ya tup Yehowa nta hpe shachyoi shapra nna, shawng na sha ta shi kru ya e shangut mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi shanhte gaw hkawhkam Hezekia hpang de shang nna, “Yu u, anhte gaw Yehowa nta ting, wan nat tawn hkungri hte de a arai ni yawng, madun da ai muk mara ai ku hte de a arai ni yawng hte hpe jasan jaseng kau sagaw ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai hta n-ga, hkawhkam Ahaza gaw shi a prat e pagawn di kau ai arai ni mahkra hpe mung, anhte galaw lajang nna, shachyoi shapra nhtawm, Yehowa a tawn hkungri man e mara da sagaw ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna hkawhkam Hezekia gaw jau jau rawt nna, mare agyi salang ni hpe jahpawng la nhtawm, Yehowa a nta de lung wa ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai shanhte gaw, mungdan a matu mung, dai chyoi pra ai shara hte Yuda mung a matu mung, mara raw na hkungga nawng ya na nga, usu sanit, sagu la sanit, sagu kasha sanit, namla sanit la sa nna, Yehowa a tawn hkungri hta dai hpe nawng ya na matu, Arun a kashu kasha hkinjawng ni hpe hkang da mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai shanhte dai nsu ni hpe sat nna, hkinjawng ni gaw asai hpe hkap la nhtawm, tawn hkungri ntsa e lapri bun mu ai; sagu la ni hpe mung sat nna, asai hpe tawn hkungri hpe mung sat nhtawm, sai hpe tawn hkungri ntsa e lapri bun mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hpang shanhte gaw mara raw na hkungga matu, namla ni hpe mung hkawhkam wa hte shawa hpawng a man de shapraw la nna, namla ni a ntsa e tinang a lata mara da mu ai:
  </para>
  <para style="p">
    <verse number="24" style="v" />hkinjawng ni gaw dai hpe sat nna, Israela amyu ting a matu gawng malai hkungga nawng ya let, dai sai hte tawn hkungri ntsa e htingrai htingrat ya mu ai; kaning rai nme law, wan nat hkungga mung, mara raw hkungga mung, Israela amyu ting a matu tai wa u ga,” nga nna hkawhkam wa hkang da nu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai shi gaw, Yehowa shi a myihtoi ni hpe hkang da ai majaw, Dawi hte shi a myihtoi Gad yan Nahtan bai hkang da ai hte maren, shupsheng, sumpyi tingse dum ai Lewi masha ni hpe Yehowa nta hta san tawn da mu ai
  </para>
  <para style="p">
    <verse number="26" style="v" />Lewi masha ni gaw Dawi a dum ai baw lang nna, hkinjawng ni gaw pahtau lang let tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai, Hezekia gaw, dai tawn hkungri ntsa e wan nat hkungga nawng ya na hpe, hkang da mu ai. Ya wan nat hkungga hpe nawng ya hpang yang, pahtau dum ai ni hte Dawi a dum ai baw lang ai ni gaw dum let, Yehowa hpe mahkawn mangoi ga mung mahkawn hpang ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai, wan nat hkungga hpe nat nawng ya ngut hkra, shawa hpung ting nawku nna, mahkawn mangoi ai ni mahkawn mangoi ma ai hte, pahtau ni dum sumra nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shagu hkungga nawng ya ngut jang, hkawhkam wa hte hpawng nga ai masha ni yang, gum dagup nna nawku nga ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai hta kaga, Dawi hte myihtoi Asap jahtuk da ai mahkawn ga hte Yehowa hpe shakawn kungdawn na nga, hkawhkam Hezekia hte du salang ni gaw, Lewi masha ni hpe hkang da mu ai. Shanhte gaw kabu gara myit hte mahkawn mangoi let, gum dagup nna nawku nga ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Hezekia gaw, Ya nanhte tinang hkum nan Yehowa a matu shachyoi shapra ya manit dai; “Sa marit, Yehowa nta kata de shagu hkungga hte chyeju dum ai hkungga jashawn mu,” nga nna tsun ai majaw shawa masha ni gaw shagu hkungga hte chyeju dum ai hkungga la sa nna, myit hkut nga ai ni gaw wan nat hkungga mung nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shawa masha ni gaw Yehowa hpe wan nat hkungga nawng ya na matu la sa ai wan nat hkungga yawng, usu sanit shi, sagu la latsa, sagu kasha ni tsa rai nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai majai da ai hkungga yawng usu kru tsa, sagu hkying masum rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hkinjawng ni mahtang n law ma ai majaw, wan nat hkungga ni hpe hpyi n dang gaw mu ai: shing rai amu ngut wa nna, hkinjawng kaga ni tinang hkum hpe shachyoi shapra lu ai aten du hkra, hpunau Lewi masha ni shanhte hpe karum nga ma ai; Lewi masha ni chyawm gaw, tinang hkum hpe shachyoi shapra na matu, hkinjawng ni hta grau nna dinghpring nga ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Wan nat hkungga ni hte hpawn, mahku hkungga sau man ni hte, wan nat hkungga shagu hte lawm ai dumhpung hkungga ni mung law law nga ai. Shing rai Yehowa a nta na daw jau ai amu ni hpe hpajang da mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Karai Kasang gaw dai amu hpe mung masha ni a matu akajawng sha shabyin ai majaw, Hezekia hte mung masha ni gaw kabu gara shajang nga ma ai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai hpang Hezekia gaw, Israela hte Yuda mung ting hta shangun dat nhtawm, Ehprim yan Manashe mung de gaw laika ka shagun dat nna, Yerusalem mare na Yehowa a Shalai wa ai poi sha na matu, shaga dat mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, shata lahkawng ngu na hta, dai Shalai wa ai poi hpe sha na lam, hkawhkam wa, du salang ni hte yerusalem na shawa hpawng ting, bawng hkut nga masai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, tinang hkum hpe shachyoi shara lu ai hkinjawng garai n law ma ai hte, mung masha ni gaw Yerusalem mare hta garai n hpawng lu ai majaw, shata langai ngu na hta sha lu ai n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai lam gaw hkawhkam wa hte shawa hpawng ting a man e mai kaja ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai re ai majaw shanhte gaw, Yerusalem mare hta e, Israela a Karai Kasang Yehowa a shala wa ai poi sha na matu, yawng lung wa mu ga, Israela mung ting Berasheba kaw nna, Dan mare du hkra, shaga ai laika shagun dat na, ga tawn da masai: kaning rai nme law, Chyum laika hta ka da ai hku hte maren, na na wa dai poi hpe sha yu masai, n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai hkawhkam wa hte du salang ni ka dat ai laika sa sa ai ni gaw, Israela hte Yuda mung ting jawt hkawm ma ai: hkawhkam hkang dat ai hte maren ndai laika gaw, Israela kashu kasha ni e, Asuri hkawhkam a lata nna lawt lu ai hte, naw ngam nga ai ni nanhte hpang de, Abraham, Isak hte Israela Karai Kasang Yehowa kayin wa u ga, nanhte mung shi hpang de myit kayin wa mu law.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaji kawa ni a Karai Kasang Yehowa hpe tawt lai kau ai, nanhte nji nwa ni hte nhpu nnau ni zawn hkum rai myit; nanhte mu nga ai hte maren shi shanhte hpe hten byak ai de ap kau manu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nanhte a nji nwa ni zawn du ja ai amyu hkum tai myit; Yehowa man e myit nem nna, shi a pawt sindawng kahtet ai myit gaw, nanhte kaw na lai mat wa u ga, shi prat dingsa e shi a matu shachyoi shapra da ai nawku Htingnu de shang nna, nanhte a Karai Kasang Yehowa hpe daw jau mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte Yehowa hpang de kayin wa myit yang gaw, nanhte a nhpu nnau ni hte kashu kasha ni hpe bawng rim wa ai ni, shanhte hpe matsan dum nna, ndai mung de bai nhtang wa lu na mara ai: kaning rai nme law, nanhte a Karai Kasang Yehowa gaw myit galu kaba hte matsan dum nga ai majaw, nanhte shi hpang de kayin wa myit yang, shi a myi man nanhte kaw na kayin wa na, n rai, nga nna ka da ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai laika sa ai ni gaw Ehprim hte Manshe ginwang ting Zebulun ginwang du hkra, mare mi hte mare mi jawt hkawm ma ai: mung masha ni chyawm gaw shanhte hpe mani asawng ai hte n kaw n law di kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rai timung, Ashe, Manashe hte Zebulun ginwang hta na masha nkau mi gaw, tinang myit nem nna, Yerusalem de lung wa ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai hta kaga, Yehowa a ga hkan nna, hkawhkam wa hte du salang ni hkang dat ai hte maren, Yuda mung masha ni gaw myit langai sha hte hkan nang lu hkra, Karai Kasang a lata shanhte a ntsa e rai ngai ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai shata lahkawng ngu na hta, matsi n rawng ai muk sha na matu, masha law law wa Yerusalem mare e hpawng nga nna, shawa hpawng kaba rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte rawt nna, Yerusalem mare na tawn hkungri ni hte, manam pyaw ai baw nat ai hkungri ni mahkra hpe htawm kau nna, Kedron hkaraw de kabai kau mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya shata lahkawng a shi mali ya e, shanhte gaw Shalai wa ai poi hkungga sat ma ai: hkinjawng ni hte Lewi masha ni chyawm gaw kaya dum nna, tinang hkum hpe shachyoi shapra kau nhtawm, Yehowa nta kata de wan nat hkungga jashawn mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkinjawng ni gaw, Karai Kasang a masha wa Mawshe a tara hta hkang da ai hte maren, tinang a shara e tsap nga let, Lewi masha ni a lata na asai hkap la nna lapri bun mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaning rai nme law, tinang hkum hpe garai n shachyoi shapra ai masha law law wa dai shawa hpawng hta lawm nga ma ai majaw, shanhte hpe Yehowa a matu shachyoi shapra na nga, Lewi masha ni gaw n san n seng ai ni a Shalai wa ai poi hkungga ni, sat nawng nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ehprim, Manashe, yisahka hte Zebulun mung na masha wunawng wuwa, tinang hkum hpe garai n shachyoi shapra kau ai, Chyum lalika hta ka da ai tara ni hpe n hkan shatup ai, Shalai wa ai poi sha nga ma ai. Kaning rai nme law, Hezekia gaw, shanhte a matu,
  </para>
  <para style="p">
    <verse number="19" style="v" />Mai kaja ai Yehowa e, Chyoi pra ai shara a htung hte maren n san n seng timung, kaji kawa ni a Karai Kasang Yehowa hpe hkan tam na myit hkut nga ai ni mahkra a mara hpe raw dat kau ya mu, ngu nna hpyi ya mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa mung Hezekia ga hpe madat ya nna, mung masha ni hpe shamai ya mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yerusalem mare e hpawng nga ai Israela kashu kasha ni gaw, sanit ya tup. kabu gara ai myit hte, matsi n rawng ai muk poi sha nga ma ai. Lewi masha ni hte hkinjawng ni gaw, Yehowa matu dum let, dum ai baw amyu myu hte dum shangoi nna, shani shagu Yehowa hpe shakawn kungdawn mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai Hezekia gaw, Yehowa a daw jau ai amu hta chye chyang ai myit rawng ai Lewi masha ni hpe ngwipyaw ai ga tsun mu ai. Shing rai shanhte gaw sanit ya yup poi de nna lu lusha sha rai let, kaji kawa ni a Karai Kasang Yehowa hpe mahku hkungga nawng ya ai hte hpyi nem mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai, shawa hpawng ni gaw sanit ya poi bai de na lam bawng hkut nna, shanhte gaw kabu gara myit hte sanit ya tup poi bai de nga ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yuda hkawhkam Hezekia gaw, shagu hkungga nawng ya na matu, mung masha ni hpe usu hkying mi hte sagu la hkying sanit jaw da mu ai: du salang ni mung, usu hkying mi sagu la mun mi shanhte hpe jaw da mu ai: hkinjawng ni law law mung tinang hkum shachyoi shapra nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hkinjawng ni hte Lewi masha ni hte rau, Yuda shawa hpawng ni Israela mung nna du sa ai shawa hpawng ting, Israela hte Yuda mung e shingbyi nga ai tsasam manam ni gaw, kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shing rai Yerusalem mare hta e kabu gara kaba rai nga ai: Israela hkawhkam Dawi a kasha Shawlumon a aprat kaw nna, ya du hkra, dai zawn re ai kabu gara lam n nga yu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai rai nna hkinjawng ni hte Lewi masha ni gaw rawt nna, mung masha ni hpe shaman ya mu ai: Karai Kasang gaw shanhte a nsen madat ya nna, shanhte a akyu hpyi ai ga, shi shanu nga ai chyoi pra ai shara, sumsing lamu de hkrang pru wa sai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai amu yawng ngut wa ai hpang zuphpawng nga ai Israela masha ni nlang, Yuda mare ni de pru sa wa nhtawm, Yuda, Ben-yamin, Ehprim hte Manashe mung shara shagu hta nga ai, shadaw sumla ni hpe karan kau ai hte, tsaw ai kawng ni a tawn hkungri ni mahkra hpe shaza kau lu hkra, kahtum gadaw run kau mu ai. Shing rai Israela kashu kasha ni yang, langai hte langai tinang a mare buga de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai hpang Hezekia gaw, hkinjawng ni hte Lewi masha ni, langai hte langai tinang hpung ang ai hte maren, daw jau ai amu hkan nna, Yehowa a wang chyinghka kata e, wan nat hkungga hte mahku hkungga nawng ya nna, daw jau let mahkawn mangoi ai hte, shakawn kungdawn nga na matu, shanhte hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hta kaga, Yehowa a tara hta ka da nga ai hte maren, wan nat hkungga, jahpawt shana wan hkungga, laban nhtoi, shata praw hte madat da ai poi shani na wan nat hkungga matu, hkawhkam wa shi jaw ang ai sut rai hta daw mi san da wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai shi gaw, hkinjawng ni hte Lewi masha ni gaw, Yehowa a tara hpe sharin achyin ya lu na matu, shanthe hte seng ai daw mi jaw na lam, Yerusalem e nga ai ni hpe hkang dat mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israela kashu kasha ni dai ga hpe na ma yang, shanhte gaw shawng ngai ai nai mam, tsabyi jahku nnan, sau lagat jahku hte yi hkauna hkai nmai shagu hpe n daw n hta jaw mu ai hte, arai yawng hta na htamshi hta htammi, law law wa jaw da mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hta n-ga Yuda mung mare ni hta de nga ai Yuda hte Israela kashu kasha ni gaw, dumsu sagu hte shanhte a Karai Kasang Yehowa matu majai da ai arai ni hta na, htamshi hta htammi sa bang nna, amyu mi hte amyu mi sumpum tawn da mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw shata masum ngu na hta sumpum hpang nna, shata sanit hta shangut mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hezekia hte agyi salang ni Yehowa hte shi a amyu Israela hpe shaman shakawn ya mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi Hezekia gaw hkinjawng ni hte Lewi masha ni hpe, dai sumpum ni a lam san yu mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zadok a dap lakung na hkinjawng Agyi Azaria gaw, Mung masha ni gaw dai kumpaw kumhpa hpe, Yehowa nta hta jashawn ai shani kaw nna, anhte sha law ai hta n-ga, law law naw ngam nga ai: Yehowa gaw shi a amyu masha ni hpe shaman ya mu ai rai nna, naw ngam nga ai gaw, ndai arung arai ni rai nga ai, nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Hezekia gaw, Yehowa nta hta gawk ni lajang na hkang dat mu a rai nna, shanthe lajang nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai shanthe gaw kangka re ai myit hte, kumhpaw kam hpa ni, htamshi hta htammi hte majai da ai arai ni hpe jashawn da mu ai: Lewi masha Hkonania gaw dai hpe up nga nna, shi a kanau Shime gaw shi a shingtau wa rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkawhkam Hezekia hte Karai Kasang a nta hpe up ai Azaria hkang dat ai hte maren, Yehiela, Azazia, Nahat, Asahela, Yerimot, Yozaba, Eliela, Ismahkia, Mahat, Benaia hte gaw Hkonania hte shi a kanau Shime a npu e hkan up ai ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai sinpraw chyinghka sin ai Lewi masha Imna a kasha Kore gaw, Karai Kasang hpe sak jaw ai dingsa kumhpa ni hpe yu lajang nga nna, Yehowa hpe jaw da ai kumhpaw kumhpa hte chyoi pra htum ai arai ni hpe karan jaw mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi a lawu e Eden, Maniamin, Yeshua, Shemaia, Amaria, Shehkania hte rai ma ai: shanhte gaw hkinjawng mare ni hta aya hkam la ai ni hta kaji kaba mahkra hpe, karan jaw mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hta kaga, Yehowa nta hta shang nna, hpung mi hte hpung mi tawn da ai hte maren, shani shagu ang ai daw jau ai amu gun hpai na matu, jahpan hta lawm nna, asak masum ning lai ai lasha mahkra hpe mung;
  </para>
  <para style="p">
    <verse number="17" style="v" />Kawa ni a dap hkan nna, hpung mi hte hpung mi tinang a amu gun hpai ai hte, asak hkun ning lai nna, jahpan laika hta lawm ai hkinjawng ni hte Lewi masha ni hpe mung:
  </para>
  <para style="p">
    <verse number="18" style="v" />Shawa hpung ting hte seng nna, jahpan laika hta lawm ai, shanhte a ma kaji ni, num ni, shayi shadang sha ni nlang hte hpe mung, karan jaw na matu, shanhte hpe san da mu ai: kaning rai nme law, shanthe gaw tinang a chyoi pra ai aya hta tinang hkum hpe shachyoi shapra nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bai nam kahtawng hkan e mung, mare shagu a ginwang hkan e mung nga nga nna, Lewi masha ni hte seng ai, jahpan laika hta lawm ai. Arun a kashu kasha hkinjawng amyu lasha ni nlang hpe mung, karan jaw na matu lahta de amying tsun ai ni hpe san da mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hezekia gaw dai lam Yuda mung ting hta galaw da wu ai; shi gaw shi a Karai Kasang Yehowa a man e mai kaja ai, dingman ai hte kangka re ai amu galaw wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a Karai Kasang hpe hkan tam let, Karai Kasang a nta e daw jau ai amu, jep ai tara hte seng ai amu, hkang da ai ga hte seng ai amu, hpa lam mung galaw hpang yang, myit masin mahkra hte galaw nna, awng wa lu ai.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, ndai amu ni ngut wa ai hte, ndai kangka myit madun ai hpang, Asuri hkawhkam Senahkerib gaw Yuda mung hta shang nna, bunghku kum ai mare ni hpe wang tawn nhtawm, dai mare ni hpe shi la na maw nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Senahkerib gaw sa du nna, Yerusalem mare hpe gasat maw nga ai lam, Hezekia mu wu yang,
  </para>
  <para style="p">
    <verse number="3" style="v" />mare shinggan e nga ai hka hpawk ni hpe pat kau na nga nna, du salang ni arawng lu ai ni hte bawng nna shanhte gaw shi hpe karum mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai re ai majaw masha law law wa zuphpawng nna, Asuri hkawhkam ni sa wa yang, hpa majaw masha hka law law mu na ma ta? nga nna tsun let, hka hpawk yawng mayawng hte mung ka-ang e lwi ai hka shi hpe pat kau mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shi gaw myit maku rawt nna, rum mat ai mare bunghku ni hpe bai lajang ai hte, langchyi ni dep hkra shatsaw nhtawm, Dawi mare na Milo hpyen dap hpe shangang nna, hpyen rai hte n-gang law law wa galaw tawn da mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mung masha ni a ntsa e hpyen du ni hpe san tawn da nna, mare chyinghka ndaw na dam ai shara e shanhte hpe jahpawng tawn nhtawm, n-gun jaw ai ga tsun let.
  </para>
  <para style="p">
    <verse number="7" style="v" />N-gun ja nna da ting nga mu; Asuri hkawhkam hte shi kaw hkan nang ai wunawng kaba hpe hkum hkrit, myit hkum kahpra myit; anhte a maga de lawm ai wa gaw, shi a maga de lawm ai wa hta grau kaba nga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />shi a maga e masha lahpum hkrai rai nga ai; anhte a maga de chyawm gaw, hpyen majan hta anhte hpe makawp maga lu ai, anhte a Karai Kasang Yehowa rai nga ai, nga nna tsun ai ga majaw, mung masha ni gaw Yuda hkawhkam Hezekia ga hta shamyet shanat nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hpang Asuri hkawhkam Senahkerib gaw, hpyen luksuk ni hte rau Lahkisha mare hpe wang tawn let, shi a ali ama ni hpe, Yerusalem mare na Yuda hkawhkam Hezekia hte Yuda mung masha ni mahkra hpang de shangun dat nna,
  </para>
  <para style="p">
    <verse number="10" style="v" />Asuri hkawhkam Senanhkerib ning nga ai: Nanhte gaw, Yerusalem mare hta wang da ai hkrum hkra, hpa hpe shamyit shanat nga myit ta?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hezekia mahtang, Anhte a Karai Kasang Yehowa gaw Asuri hkawhkam a lata na anhte hpe hkye mawai la na ra ai, nga nna hku hku ai hte kawsi hpang gara si hkra, nanhte hpe hkalau kau ai, n rai nga a ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ndai Hezekia nan, Yehowa a tsaw ai kawng ni a nawku shara ni hte, shi a tawn hkungri ni hpe htawm kau nna, Nanhte gaw tawn hkungri langai sha a man e nawku na hte, dai ntsa e manam pyaw ai baw nat nawng ya lu na, nga nna Yuda hte Yerusalem masha ni hpe hkang da nu ai, n rai ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai hte nye a ji wa ni gaw, mung shagu a amyu ni hpe kaning rai galaw ai lam nanhte n chye nga myit ni? Maigan amyu ni a Hpara ni gaw, tinang a mung ni hpe, nye a lata na hkye mawai la lu na n-gun, rawng nga ma ni?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanthe a Karai Kasang gaw nanhte hpe nye a lata na hkye mawai la lu na, kam shara nga hkra, nye ji wa ni atsai awai di kau ai mung masha ni a Hpara ni mahkra hta, tinang amyu hpe nye a lata na hkye mawai la lu Hpara langai ngai nga a ni?
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai re ai majaw, Hezekia gaw nanhte hpe ndai lam hku n hkalau kau u ga, shi a ga hpe mung hkum kam myit; Hpara tsasam ni gaw, tinang a amyu ni hpe, nye a lata hte, ji wa ni a lata na, hkye mawai la lu ai n rai: dai hta grau nna nanhte a Karai Kasang gaw, nanhte hpe nye a lata na hkye mawai la lu na n rai, ngu nna htet dat mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a ali ama ni gaw, Karai Kasang Yehowa hpe mung, shi a shangun ma Hezekia hpe mung, ga nhkap law law naw tsun mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hta n-ga, maigan mung na amyu ni a Hpara ni gaw tinang a amyu ni hpe nye a lata na n hkye la lu ai hte maren, Hezekia a Karai Kasang mung, shi a amyu masha ni hpe nye a lata na hkye mawai la lu na n rai, nga nna Israela Karai Kasang Yehowa hpe shatan ai hte ga nhkap tsun na matu, laika mung ka dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yerusalem mare hpe htim gasat la na matu, dai mare bunghku ntsa e nga ai masha ni hpe jahkrit shama na hte sharu shatsang na nga, Yuda ga hku nsen kaba hte jahtau garu nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Masha lata hte galaw ai maigan amyu ni a Hpara ni a lam tsun kajai ai hte maren, Yerusalem na Karai Kasang hpe tsun shajang nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai rai nna, hkawhkam Hezekia hte Amot a kasha myihtoi Esaia gaw, dai lam majaw akyu hpyi nna, sumsing lamu de jahtau ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai Yehowa gaw lamu kasa shangun dat nna, Asuri hkawhkam a hpyen dap na nden ja ai share ni, hpyen gyi, hpyen du ni mahkra hpe shaza kau mu ai. Hkawhkam wa mung myi man sum let shi a mung de bai wa mat ai. Ya shi a Hpara a nawku shara de shang yang, shi nan shaprat ai shi a kasha ni gaw, nhtu hte shi hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai Yehowa gaw Hezekia hte Yerusalem masha ni hpe, Asuri hkawhkam Senahkerib a lata na mung, kaga hpyen ni mahkra a lata na mung, hkye mawai la nna, lam shagu hta shanhte hpe pau sin da mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Masha law law wa, Yehowa a matu, Yerusalem de kumhpaw kumhpa la sa nna, Yuda hkawhkam Hezekia hpe manu hpu ai baw sak jaw mu ai: dai rai nna shi gaw, dai aten kaw nna, masha amyu mahkra a man e daru magam rawng nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai aten hte yang Hezekia gaw si machyi hkrum nna, Yehowa hpe akyu hpyi wu ai: Yehowa mung htan nna, mau kumla shi hpe jaw wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rai timung Hezekia gaw shi hkam la ai chyeju hte maren n htang ya ai sha, myit kaba nga ai majaw, shi a ntsa e mung, Yuda hte Yerusalem ntsa e mung pawt sindawng ai pru nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hezekia chyawm gaw shi myit kaba ai yubak a majaw, Yerusalem masha ni hte rau myit nem nga nna, Yehowa a pawt sindawng ai gaw, shi a prat dingsa e, shanthe a ntsa e n du nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ya Hezekia gaw sutgan hte arawng sadang law law lu ai: dai rai nna, aja, gumhpraw, lungseng, manam pyaw ai baw, n-gang hte manu hpu ai arung arai mayu myu mahkawng da na matu sutdek;
  </para>
  <para style="p">
    <verse number="28" style="v" />nai mam, tsabyi jahku ningnan, sau, tawn da na, arai bang ai dum; yamnga amyu myu hte sagu hpung ni a matu ulawng gawk ni hpe, lajang da wu ai:
  </para>
  <para style="p">
    <verse number="29" style="v" />Karai Kasang gaw shi hpe grai lu su shangun ai majaw shi gaw shi a matu mare hte hpe de da ai hte, yamnga hpung amyu myu hpe mahkawng da wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai hta kaga, ndai Hezekia gaw, Gihon lahta na hka shi hpe pat kau nna, Dawi mare a sinna maga hku ang ang shalen dat wu ai. Shing rai Hezekia gaw shi galaw ai lam shagu hta awng wa lu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Rai timung, shi a mung hta mauhpa amu byin ai lam, Babelon du salang ni san yu na matu, kasa shangun dat yang, shi hpe chyam yu na hte, shi myit masin hta rawng ai lam mahkra hpe chye lu hkra, Karai Kasang gaw shi hpe dat tawn da wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Naw gawn ra ai Hezekia amu ni hte, shi mai kaja ai bungli ni a lam, Yuda hte Israela hkawhkam ni gawn ai, Amot a kasha, myihtoi Esaia shingra laika hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ya Hezekia gaw kaji kawa ni hte rau yup pyaw wa nna, Dawi a kashu kasha ni a lupwa lahta tsang e makoi mayang di ai hkrum wu ai: Yuda hte Yerusalem masha ni nlang, shi a mang bru ai hta, shi hpe shagrau sha-a ma ai. Shi a kasha Manashe gaw shi a malai hkaw dung nga ai.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manashe gaw hkaw dung hpang yang asak shi lahkawng ning kaba nga nna, Yerusalem mare hta manga shi manga ning up nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw Israela kashu kasha ni a man na, Yehowa shaden kau ai maigan amyu ni a matsat shabat lam hkan let Yehowa a man e n hkru ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a kawa Hezekia run kau ai tsaw ai kawng ni a shara ni hpe shi bai de da nna, Bala hpara ni a hkungri ni de da nna, Asherot sumla galaw ai hte sumsing lamu na shagan ni yawng hte hpe nawku nna daw jau wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw, Yerusalem mare hta e nye a amying ningsang tawn da na we ai, nga timung, shi gaw Yehowa a nta hta tawn hkungri shaje galaw da wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shi gaw, Yehowa a nta wang lahkawng hta sumsing lamu na shagan ni yawng a matu tawn hkungri galaw da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hta n-ga, shi gaw Hinom kasha a kadit hta e, shi a kasha ni hpe, wan nat hkungga shatai nna, shaba wawt ai hte, mandan lakle amu galaw nna, gumhpan hpan ai ni hte nat shung ai ni hte rau kanawn let, Yehowa hpe pawt sindawng shangun na nga, shi a man e n hkru ai amu law law galaw wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Israela amyu ni yawng hta na ngai lata la ai, ndai nta hta mung, Yerusalem mare hta mung, nye a amying hpe ngai tutnawng e tawn da nga ai rai nna,
  </para>
  <para style="p">
    <verse number="8" style="v" />ngai mung, Mawshe a lata hte mung, shanhte hpe htet da mada mahkra hkan galaw nna, a shatup nga ma yang gaw, shanhte a kaji kawa ni hpe ngai jaw da ai mung hta na, ngai shanhte hpe lam bai shadam na n rai,” nga nna Karai Kasang gaw Dawi hte shi a kasha Shawlumon hpe tsun da timung, shi gaw shi tawk ai sumla hpe Yehowa nta hta tawn da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai manashe gaw Yuda hte Yerusalem masha ni hpe lam shadam kau ai hte, Israela kashu kasha ni a man e Yehowa shaza kau ai maigan amyu ni hta grau n hkru ai amu galaw shangun mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Yehowa gaw Manashe hte shi a amyu masha ni hpe shadum jahprang timung, shanhte madat mara ma ai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Yehowa gaw shanhte a ntsa e Asuri hkawhkam a hpyen luksuk ni a bu ni hpe shangun dat nna, Manashe hpe hpri chyinghkyi hte magri sin-yu hte gyit nhtawm, Babelon mare de woi wa mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai ruyak hkrum yang, shi a Karai Kasang Yehowa hpe akyu hpyi nna, kaji kawa ni a Karai Kasang man e ja ja myit nem let,
  </para>
  <para style="p">
    <verse number="13" style="v" />shi kaw akyu hpyi ai hte tawngban nga ai majaw, Karai Kasang shi hpe madat mara ya nna, Yerusalem hte shi a mung de nhtang wa shangun wu ai. Dai rai nna Yehowa nan Karai Kasang rai nga ai gaw Manashe chye lu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang shi gaw, Gihon hka shi sinna maga a kadit hta e, nga chyinghka la du hkra, Dawi a mare a shinggan bunghku kum nna, Ohpela kawng shalawm let, ja ja tsaw hkra kum da wu ai: dai hta kaga Yuda mung na bunghku kum ai mare ni hta nden ja ai hpyen du ni hpe san da wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai shi gaw, Hpara tsasam ni hpe mung, Yehowa nta hta tawn da ai sumla hpe mung, Yehowa nta bum ntsa hte Yerusalem mare hta e gaw da ai tawn hkungri ni mahkra hpe mung, htawm kau nna mare shinggan de kabai kau mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa a tawn hkungri hpe shi bai lajang nna, de a nsa e mahku hkungga hte chyeju dum ai hkungga nawng ya nna, Yuda mung masha ni gaw Israela Karai Kasang Yehowa hpe daw jau na lam hkang da mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mung masha ni chyawm gaw, tsaw ai kawng ni a nawku shara e hkungga nawng ya timung, tinang a Karai Kasang Yehowa hpe hkrai, nawng ya mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Naw gawn ra ai Manashe a amu ni a lam, shi a Karai Kasang hpe akyu hpyi ai hte, Israela Karai Kasang Yehowa a amying gang let, myihtoi ni shi hpe shadum jahprang ai gaw, Israela hkawhkam ni labau hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi akyu hpyi nna, Karai Kasang hpe tawngban ai lam, shi myit garai n nem yang na, shi a yubak mara, shi shut hpyit ai hte tsaw ai kawng ni a shara ni de da nna, Asherim sumla ni hte tawk ka ai sumla ni hpe shadun ai lam, myihtoi ni a laika hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai Manashe gaw kaji kawa ni hte yup pyaw nna, shi a nta hta makoi mayang di mu ai. Shi a kasha Amon gaw shi a malai hkaw dung nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amon gaw hkaw dung hpang yang asak hkun lahkawng ning rai nga nna, Yerusalem mare hta ni ning up nga ai,
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi gaw shi a kawa Manashe hte maren, Yehowa a man e n hkru ai amu galaw nna, kawa Manashe galaw ai tawk ka ai sumla ni mahkra hpe hkungga nawng ya nna, daw jau nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw kawa Manashe zawn, Yehowa man e myit n nem ai sha, ndai Amon gaw grau nna je je shut hpyit nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai shi a ali ama ni gaw shi hpe gumlau nna, shi a nta kata e shi hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mung masha ni chyawm gaw hkawhkam Amon hpe gumlau ai ni nlang hte hpe sat kau nhtawm, shi a kasha Yoshia hpe kawa a malai hkawhkam shatai mu ai.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yoshia gaw hkaw dung hpang yang asak matsat ning rai nga nna, Yerusalem mare hta sumshi langai ning up nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw Yehowa a man e tengman ai amu galaw nna, pai de hkra de n yit ai sha, kawa Dawi a lam mahkra hta hkan hkawm nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, shi hkaw dung ai hpang, matsat ning hta e, shi shabrang naw rai nga yang, kawa Dawi a Karai Kasang hpe hkan tam hpang wu ai; shi lahkawng ning hta e Yuda mung hte Yerusalem mare hta nga ai, tsaw ai kawng ni nawku shara ni, Asherim sumla ni, tawk ka ai sumla ni hte jaw ai sumla ni hpe htawm kau hpang wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bala hpara ni a hkungri ni hpe shi a man e run kau nna, htaw ntsa e nga ai jan sumla ni hpe shi kran kau ai hte, Asherim sumla ni, tawk ka ai sumla ni hte jaw ai sumla ni hpe kahtum gadaw agrawp kau nna, ayun ayaw di kau nhtawm, shanhte hpe nawng ya ai ni a lup ntsa e ayai kau mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hkinjawng ni a nrut nra ni hpe, shanhte a hkungri ni a ntsa e shi ju kau nna, Yuda mung hte Yerusalem mare hpe jasan jaseng kau wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hte maren, Manashe, Ehprim, Simun mare ni kaw nna Naphtali ginwang du hkra, shanhte a nta ni hpe hkan sawk yu nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai shi gaw Israela mung hproi hkra, tawn hkungri ni hpe run kau nna Asherim sumla ni hte tawk ka ai sumla ni hpe ayun ayaw agrawp kau nna, jan sumla ni hpe kran kau nhtawm, Yerusalem mare de bai wa ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ya shi a hkaw dung ai shi matsat ning hta e, dai mungdan hte nta hpe jasan jaseng ngut jang, shi a Karai Kasang Yehowa a nta hpe galaw lajang na matu, shi gaw Azalia kasha Shahpan, mare up ai wa Masia hte chyare wa Yohaza a kasha Yoa hte hpe shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte gaw hkinjawng agyi Hilkia kaw sa nna, Karai Kasang a nta hta jashawn bang ai gumhpraw ngu ai, chyinghka sin ai Lewi masha ni gaw, Manashe, Ehprim mung hte naw ngam nga ai Israela masha ni hta na mung, Yuda, Ben-yamin mung hte Yerusalem masha ni kaw na mung, lahkawn la ai gumhpraw hpe, shi a lata hta ap ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai shanhte gaw Yehowa nta hta amu galaw ai ni hpe up nga ai ni a lata hta dai gumhpraw ap ya nna, shanhte gaw, nta hpe galaw lajang na matu jai kau mu ai;
  </para>
  <para style="p">
    <verse number="11" style="v" />Yuda hkawhkam ni run jahten kau ai tawk ai nlung ni hte ngau dingbat ni hpe mari na matu, lasama ni hte nta galaw ai ni a lata de bai ap ya mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amu galaw ai ni mung kangka ai myit hte galaw nga ma ai: amu galaw ai ni a ntsa e up nga ai ni gaw, Lewi amyu Merari a dap na Yahat yan Obadia; Kohat dap na Zehkaria yan Meshulam hte rai ma ai; shanhte gaw hpaawn ni rai nga nna, dum ai baw amyu myu dum let mahkawn mangoi chye ai Lewi masha ni mung lawm ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shanhte gaw lit gun hpai ai ni kaw nna, amu amyu myu galaw ai ni mahkra hpe yu hparan nga ma ai: Lewi masha ni hta na, chyare ni, agyi ni hte chyinghka sin ai ni pru ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya shanhte gaw Yehowa a nta na gumhpraw hpe shapraw mu yang, hkinjawng Hilkia gaw, Mawshe a lata hte ap ya ai Yehowa a tara laika hpe mu hkrup wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai Hilkia gaw, “Yehowa nta hta dai tara laika ngai mu hkrup se ai,” nga nna Shahpan hpe tsun let, dai laika hpe shi a lata hta ap ya wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Shahpan gaw hkawhkam wa hpang de dai laika hpe la sa ai hta n-ga, hkawhkam wa hpe, “Na a shangun ma ni hpe nang hkang da ai lam mahkra shanhte galaw nga masai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa nta hta rawng ai gumhpraw hpe shanhte shaw la nna, amu up ai ni hte amu galaw ai masha ni a lata hta ap da masai.”
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hta kaga Shahpan gaw, “Hkinjawng Hilkia laika langai mi ngai hpe ap ya sai,” nga nna hkawhkam wa a man e hti dan wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya hkawhkam wa gaw dai tara laika a mungga na ngut jang, shi a hpun palawng gang je kau wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai hkawhkam wa gaw, Hilkia, Shahpan a kasha Ahikam, Mihka a kasha Abdon, chyare wa Shahpan hte hkawhkam a shangun ma Asaia hpe hkang da nna,
  </para>
  <para style="p">
    <verse number="21" style="v" />Ndai mu hkrup ai laika a mungga a lam, nye a matu mung, Israela hte Yuda mung hta naw ngam nga ai ni a matu mung, Yehowa hpe sa san yu mu: kaning rai nme law, ndai laika hta ka da mada hte maren, anhte a ji wa ni Yehowa ga n hkan nga ai majaw, Yehowa a pawt sindawng ai gaw anhte a ntsa e ru bun nga ai, ngu dat mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai rai nna Hilkia hte hkawhkam wa hkang da ai ni gaw, Hasra a kashu Tokhat a kasha, hkawhkam wa hpun palawng sin ai Shalum a madu jan, num myihtoi Hulda hpang de sa shang nna, dai lam shi hte ga tsun mu ai: shi gaw mare wang lahkawng ngu na Yerusalem daw hta e nga nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai myihtoi num gaw, Israela Karai Kasang Yehowa gaw ning nga ai, “Ngai hpang de nanhte hpe shangun dat ai wa hpe ning ngu mu:
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa ning nga ai: Yu u, Yuda hkawhkam a man e hti dan ai hte, ndai laika hta rawng ai dagam ga mahkra hpe, ndai shara hte dai hta e nga ai ni mahkra a ntsa e, tsin-yam tsindam shapraw na we ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hpa majaw nga yang, shanhte ngai hpe kau da nna, shanhte a lata e galaw ai amu hte ngai hpe pawt sindawng shangun na nga, Hpara shaje ni a man e manam pyaw ai baw nat nawng ya ma ai; dai re ai majaw, ndai shara a lam nye a pawt sindawng ai wan grung nga nna, krip wa na n rai, nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai timung, Yehowa hpe san yu na nga, nanhte hpe shangun dat ai Yuda hkawhkam hpe ning ngu mu: Israela Karai Kasang Yehowa ning nga ai: Nang na yu ai mungga a lam, da ndai rai nga ai;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ndai shara hte dai hta e nga ai masha ni hpe ngai dagam ai gaw nang na ai shaloi, nang myit kya nna, Karai Kasang a man e myit shagrit nga ai hte, na a hpun palawng hpe gang je kau nna, nye a man e hkrap ngu hkrap ngoi nga ndai majaw, ngai Yehowa nan na a ga hpe madat mara ya sade ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yu u, ngai nang hpe na nji nwa ni hte rau jahpawng da nna, nang gaw ngwipyaw ai hte na a lup hta shang lu na rin dai; ndai shara ntsa e mung, dai hta e nga nga ai ni a ntsa e mung, ngai shapraw ai tsin-yam tsindam hpe na a myi hte mu lu na n rai, ngu mu,” ngu nna tsun dat mu ai. Shing rai shanhte bai wa nna, hkawhkam wa hpe dai ga htawn tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai rai nna, hkawhkam wa gaw Yuda mung hte Yerusalem mare na agyi salang ni nlang hte hpe shaga la nna,
  </para>
  <para style="p">
    <verse number="30" style="v" />hkawhkam wa gaw Yuda amyu masha ni hte Yerusalem mare masha ni mahkra hte hpawn, hkinjawng ni, Lewi masha ni hte mung masha kaji kaba mahkra hte rau, Yehowa nta de lung wa nna, shi gaw dai yang e mu hkrup ai laika ga shaka mahkra hpe shanhte a man e hti dan mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hta kaga hkawhkam wa gaw shi a shara e tsap nga let, ndai laika hta ka da nga ai ga shaka hpe shagrin da na hte Yehowa hpe hkan tam let shi hkang da ai ga, sakse ga hte matsun maroi ga hpe myit masin mahkra hte, n-gun lagaw mahkra hte hkan shatup na nga, Yehowa a man e ga shaka tawn da wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hpawng nga ai Yerusalem mare na masha ni hte, Ben-yamin masha ni gaw, dai ga shaka hpe shatup na matu hkang dat mu ai rai nna, Yerusalem mare na masha ni gaw, tinang a kaji kawa ni a Karai Kasang a ga shaka hte maren hkan galaw nga mai ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai hta kaga Yoshia gaw, Israela masha ni hte seng ai mung mahkra hta na matsat shabat re a arai ni mahkra hpe htawm kau nna, Israela mung e nga ai masha ni gaw, tinang a Karai Kasang Yehowa hpe nawku na lam hkang dat mu ai. Shanhte mung shi a prat tup kaji kawa ni a Karai Kasang Yehowa kaw na yit mat wa ma ai, n rai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yoshia gaw Yerusalem mare hta e Yehowa a matu Shalai wa ai poi galaw wu ai: shanhte gaw shawng na shata shi mali ya e Shalai wa ai poi hkungga hpe sat mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw hkinjawng ni hpe tinang a aya hta tawn da nna, Yehowa nta na daw jau ai amu a lam hta shanhte hpe shatsam mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israela amyu masha ni hpe sharin achyin ya ai hte, Yehowa matu chyoi pra nga ai Lewi masha ni hpe shaga nna, “Israela hkawhkam Dawi a kasha Shawlumon galaw da ai nta ka ta de Chyoi pra ai Sumpu hpe tawn da mu: ya kaw nna nanhte a lahpa hta lit mara sa na n rai: nanhte a Karai Kasang Yehowa hte, shi a amyu Israela hpe daw jau nga mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israela hkawhkam Dawi hte shi a kasha Shawlumon ka da nga ai hte maren, nji nwa ni a dap lakung hkan nna, tinang a hpung mi hte hpung mi daw jau nga mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amyu mi hte amyu mi seng ai, nanhte a nhpu nnau ni a dap lakung hkan nna, dai Chyoi pra ai shara hta tsap nga let, Lewi masha ni a kaji kawa ni a dap langai hte langai hte maren, hpung mi hte hpung mi rai nga mu ga:
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawshe a lata hte Yehowa hkang da ai hte maren, tinang a nhpu nna ni hpe daw jau na matu, shalai wa ai hkungga sat nna, tinang hkum hpe shachyoi shapra nga mu,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai Yoshia gaw hpawng nga ai amyu masha ni a Shalai wa ai poi hkungga matu, sagu bainam hpung hta na sagu kasha masum jaw mu ai: dai gaw hkawhkam a sut rai hta na rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a du salang ni mung, jaw mayu ai myit hte, mung masha ni, hkinjawng ni hte Lewi masha ni hpe hkungga jaw mu ai. Karai Kasang a nta up ai, Hilkia, Zehkaria, Yehiela hte gaw, hkinjawng ni hpe Shalai wa ai poi hkungga matu, sagu bainam hkying lahkawng kru tsa hte usu masum tsa shapraw ya mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkonia hte shi a kanau Shemaia yan Nehtanela mung, Lewi agyi ni Hashabia, Yeiela, Yozaba mung, Lewi masha ni hpe Shalai wa ai poi hkungga matu, sagu bainam hkying manga hte usu manga tsa shapraw ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai hkawhkam wa hkang da ai hte maren, dai daw jau na lam lajang shajin nna, hkinjawng ni gaw tinang a shara hta e, Lewi masha ni gaw tinang nang a hpung hte, tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw dai Shalai wa ai hkungga hpe sat nna, hkinjawng ni gaw tinang a lata hte sai lapri nna, Lewi masha ni hpyi gaw ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mawshe a laika hta ka da nga ai hte maren, Yehowa hpe hkungga nawng ya na matu, mung masha ni a dap lakung hkan nna, hpung mi hte hpung mi hpe karan jaw na nga, wan nat hkungga ni hpe karan tawn mu ai. Usu ni hpe mung dai hte maren galaw mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Htung hte maren, Shalai wa ai hkungga hpe wan hte kakang mu ai: chyoi ra ai hkungga daw ni hpe, dibu, sau di hte di pa hta shadu nna mung masha ni hpang de alawan htawn tawn matu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hpang shanhte gaw tinang hte hkinjawng ni a matu lajang mu ai; kaning rai nme law, Arun a kashu kasha hkinjawng ni gaw, wan nat hkungga ni nawng ya na matu, shana du hkra kyin nga ma ai: dai re ai majaw Lewi masha ni gaw, tinang a matu mung, Arun a kashu kasha hkinjawng ni a matu mung, lajang tawn mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dawi hte hkawhkam wa a myihtoi ni Asap, Heman, Yeduhtun hte hkang da ai hte maren, mahkawn mangoi ai Asap a kashu kasha ni gaw tinang a shara e nga nga ma ai: chyinghka sin ai ni mung chyinghka shagu hta tsap nga ma ai: shanhte a kahpu kanau Lewi masha ni gaw shanhte a matu lajang da ma ai majaw, tinang a amu hpe hprai kau shara n nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai hkawhkam Yoshia hkang da ai hte maren, Yehowa hpe daw jau ai amu mahkra gaw, Shalai wa ai poi galaw sha na mung, Yehowa a tawn hkungri ntsa e wan nat hkungga nawng ya na mung, lani jan hta sha lajang shajin mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rau hpawng nga ai Israela kashu kasha ni gaw, dai aten e Shalai wa ai poi hte matsi n rawng ai muk sha ai poi hpe sanit ya tup galaw nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Myihtoi Samuela aprat kaw nna dai ni du hkra dai zawn re ai Shalai wa ai poi Israela mung hta sha yu ai n rai; Yoshia hte hkinjawng ni, Lewi masha ni, rau nga ai Yuda mung na ni, Israela mung na ni hte Yerusalem masha ni lajang shachyip ai Shalai wa ai poi zawn, Israela hkawhkam ni kadai mung lajang shachyip yu ai n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yoshia hkaw dung ai shi matsat ning hta e, dai Shalai wa ai poi hpe galaw sha ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ya Yoshia gaw nawku Htingnu hpe galaw lajang ngut ai hpang, Egutu hkawhkam Niko gaw Uhprat hka kau Hkarahkeme mare gasat na matu lung wa nna, Yoshia gaw shi hpe hkum kau na pru sa wa ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Egutu hkawhkam mahtang, kasa shangun dat nna, “Yuda hkawhkam wa e, nang gaw ngai hte hpa daw n ta? Dai ni ngai nang hpe gasat ai, n rai; ngai hte hpyen ai ni hpe gasat na she pru nngai; ngai lawan nga na hpe Karai Kasang htet da sai; ngai hte rau nga ai Karai Kasang gaw nang hpe n jahten u ga, shi hte nhtan shai ai lam hkum galaw et,” ngu nna htet dat wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai timung, Yawshia gaw nhtang wa hkraw ai, n rai; Niko htawn tsun ai Karai Kasang a ga hpe n madat ai sha, hpyen gasat na nga, shi hkum hpe yu maya lak lai ai hpun palawng bu hpun let, Megido kadit na hpyen ginra de shang wa ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ndan gap ai ni gaw hkawhkam Yoshia hpe gap nna, hkra kau mu ai; dai rai nna shi gaw, “Ngai hkala nba hkrum ni ai; ngai hpe woi wa mi,” ngu nna shi a ali ama ni hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi a ali ama nni mung, shi a leng hta na shayu nhtawm, hpang na leng hta shi hpe shajawn nna, Yerusalem de woi wa mu ai; shaloi shi si wa nna kaji kawa ni a lup hta makoi mayang di mu ai. Yoshia si mat ai majaw, Yuda hte Yerusalem masha ni yawng hkrap ngu hkrap ngoi sharung shayawt nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yeremia mung Yoshia majaw sharung shayawt nga ai rai nna, mahkawn mangoi chye ai numsha lasha ni gaw tinang a sharung shayawt ai ga hte, dai ni du hkra Yoshia lam shagawp tsun nga ma ai; dai ga gaw Israela amyu hta tsun nga na htung tai wa nna, sharung shayawt laika hta ka da nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Naw gawn ra ai Yoshia amu ni a lam, Yehowa tara hta ka da nga ai hte maren,
  </para>
  <para style="p">
    <verse number="27" style="v" />shi galaw dan ai mai kaja ai amu, npawt ndung hkren, yu mu, dai hte gaw Israela hte Yuda hkawhkam ni a laika hta ka da nga ai.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya mung masha ni gaw Yoshia a kasha Yehoaha hpe shaga la nna, Yerusalem mare hta kawa a malai hkawhkam shatai mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yoahaza gaw hkaw dung hpang yang asak hkun masum ning rai nga nna, Yerusalem mare hta e, shata masum up nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaloi Egutu hkawhkam gaw Yerusalem mare na shi hpe gum-yu yu kau nna, Yuda mung masha ni hpe gumhpraw joi hkying mi hte ja joi shi shawa mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai Egutu hkawhkam gaw shi a kanau Eliakim hpe Yuda mung hte Yerusalem mare ntsa e hkawhkam shatai nna, shi a mying hpe Yehoiakim ngu nna lai kau ya wu ai: Niko gaw shi a kahpu Yoahaza hpe rim la nna Egutu mung de woi wa wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehoiakim gaw hkaw dung hpang yang asak hkun manga ning rai nga nna, Yerusalem mare hta shi langai ning up nga ai: shi gaw shi a Karai Kasang Yehowa man e n hkru ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai aten e Babelon hkawhkam Nebuhkadneza shi hpe lung gasat nna, Babelon mare de rim wa lu hkra magri sumri hte gyit wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hta kaga Nebuhkadneza gaw, Yehowa nta na arai nkau mi hpe la wa nna, Babelon mare na shi a nawku Htingnu e tawn da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Naw gawn ra ai Yehoiakim a amu ni, shi galaw ai matsat shabat lam ni hte mara shagun mai ai lam ni gaw Israela hte Yuda hkawhkam mi a laika hta ka da nga ai. Shi a kasha Yehoiahkin gaw shi a malai hkaw dung nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehoiahkin hkaw dung hpang yang asak shi matsat ning rai nga nna, Yerusalem mare hta shata masun e nhtoi shi ya up nga ai: shi gaw Yehowa man e n hkru ai amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ladu hkrum yang hkawhkam Nebuhkadneza gaw shi hpe rim la nna, Yehowa nta na manu hpu ai arai ni hte hpawn, Babelon mare de shi hpe rim wa nna, shi a kanau Zedekia hpe, Yuda hte Yerusalem ntsa e hkawhkam shatai wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zedekia gaw hkaw dung hpang yang asak hkun langai ning rai nga nna Yerusalem mare hta shi langai ning up nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw shi a Karai Kasang Yehowa man e n hkru ai amu galaw nga ai; Yehowa a ga htawn tsun ai myihtoi Yeremia man e shi myit nem nga ai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang a amying gang let shi hpe dagam shangun ai hkawhkam Nebuhkadneza hpe mung shi gumlau nna, Israela Karai Kasang Yehowa hpang de myit n kayin u ga, shi a du hpe mung, myit masin hpe mung, shaja da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hta kaga hkinjawng ni hte mung masha ni a agyi ni mung, maigan amyu ni a matsat shabat lam shagu hpe hkan nna grai wa shut hpyit nga ma ai; Yerusalem mare hta e Yehowa shachyoi shapra da ai, shi a nta hpe mung, shanhte awu asin di kau mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte a kaji kawa ni a Karai Kasang Yehowa gaw, shi a amyu hpe mung, shi shanu nga ai shara hpe mung matsan dum nga ai majaw, jau jau rawt nna, lang mi hte lang mi shi a kasa ni hpe shanhte hpang de shangun dat timung,
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte gaw Karai Kasang a kasa ni hpe aroi arip di nna, shi a myihtoi ni hpe n kaw n law di kau ai hte, shi aga hpe n kaw n law di nna, shi a myihtoi ni hpe asawng asang di kau mu ai; dai rai nna, hkye hkrang la na lam n hku hkra, Yehowa a pawt sindawng ai gaw dai amyu masha ni a ntsa e ka htet bu nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai re ai majaw shi gaw Hkalde a hkawhkam hpe shanhte hpang de shangun dat nna, dai wa gaw, shanhte a chyoi pra ai nta kata e shanhte a shabrang ni hpe sat kau nna, brang ram ni hte mahkawn ni hpe mung, aprat kaba ai hte gumgai dingla ni hpe pyi matsan n dum nga ai: shi gaw yawng mayawng hpe shi a lata hta ap kau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Karai Kasang a nta na wan ni kaji kaba mahkra hpe mung, Yehowa nta na sutgan, hkawhkam wa hte shi a agyi salang ni a sutgan mahkra hpe mung, Babelon mare de la wa mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw Karai Kasang a nta hpe nat kau ai hte, Yerusalem mare bunghku hpe run kau nna, hkawhkam htingnu ni mahkra hpe nat kau nhtawm, de a manu hpu ai arung arai nlang hte hpe shaza kau mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nhtu n hkrum ai ni hpe Babelon mare de bawng woi wa mu ai rai nna, shanhte gaw Persi mungdan grin wa ai du hkra, shi hte shi a kasha ni a mayam ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai, Yeremia htawn tsun ai Yehowa aga dik wa u ga, “Israela lamu ga gaw tinang hte seng ai laban shaning ni shagu shatup na mara ai: kaning rai nme law, dai mungdan gaw katsi katsang naw nga nga yang, dai gaw ban nga nna, sanit shi ning du hkra hkam nga ai.”
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya Yeremia htawn tsun ai Yehowa ga dik wa na matu, Persi hkawhkam Kuru hkaw dung ai shawng shaning hta e, Yehowa gaw shi a myit masin hpe shamu shamawt ya nna, shi gaw shi a mungdan ni mahkra hproi hkra hkang dat ai laika shabra dat nna,
  </para>
  <para style="p">
    <verse number="23" style="v" />Persi hkawhkam Kuru ning nga ai: “Sumsing lamu na Karai Kasang Yehowa gaw, ga ntsa mungdan ni mahkra hpe nye a lata hta ap ya ni ai; Yuda mung na Yerusalem mare hta e, shi a matu nta langai mi galaw na, shi ngai hpe hkang da ni ai. Ya shi hte seng ai amyu masha ni kadai hte mung, shi a Karai Kasang Yehowa shi hte rau nga nga nna, shi lung wa u ga,” ngu nna ka dat wu ai.
  </para>
</usx>
