<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Bu Hkawm</book>
  <para style="h">Bu Hkawm</para>
  <para style="toc1">Bu Hkawm</para>
  <para style="toc2">Bu Hkawm</para>
  <para style="mt">Bu Hkawm</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Israela kashu kasha ni Egutu mung na pru wa ai ni ning e, shata lahkawng ngu na a langai ya shani hta, Sina nam mali, shawa sum hta e Yehowa Mawshe hpe tsun wu ai gaw:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arun hte nan, Israela shawa hpung hta na asak hkun ning lai nna hpyen gasat lawm lu ai lasha nlang hte hpe, shanhte a amyu lakung hta na tinang dap hkan nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />ahpung ahpung di karan tawn nhtawm, jahpan hti la mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amyu lakung shagu hta na tinang amyu hta agyi tai ai wa langai langai, nan hte rau lawm lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nan hpe shingtau na ni a amying gaw ndai ni rai nga ma ai: Rubin amyu hta na Shedura a kasha Elizura;
  </para>
  <para style="p">
    <verse number="6" style="v" />Simun amyu hta na, Zurishadi a kasha Shelumila;
  </para>
  <para style="p">
    <verse number="7" style="v" />Yuda amyu hta na, Aminadab a kasha Nashon;
  </para>
  <para style="p">
    <verse number="8" style="v" />Yishahka amyu hta na, Zua a kasha Nehtanela;
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulun amyu hta na, Helon a kasha Eliaba;
  </para>
  <para style="p">
    <verse number="10" style="v" />Yawsep a amyu, Ehprim lakung hta na, Amihu a kasha Elishama; bai Manashe lakung hta na, Pedazura a kasha Gamalela;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ben-yamin amyu hta na, Gidoni a kasha Abidan;
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan a amyu hta na, Amishadi a kasha Ahiza;
  </para>
  <para style="p">
    <verse number="13" style="v" />Ashe amyu hta na, Ohkran a kasha Pagila;
  </para>
  <para style="p">
    <verse number="14" style="v" />Gad amyu hta na, Duela kasha Eliasap;
  </para>
  <para style="p">
    <verse number="15" style="v" />Naphtali amyu hta na Enan a kasha Ahira hte rai na rai ma ai.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Ndai ni gaw shawa hpung hta dang tawn ai, tinang baw lakung hta na agyi ni rai nga ma ai: shanhte gaw Israela amyu hta masha hkying mun a du ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai amying hte lata la ai dai ni hpe, Mawshe yan Arun shaga la nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />shata lahkawng ngu na langai ya hta e shawa hpung nlang hpe jahpawng nhtawm, amyu lakung ni hkan nna, hkun ning hta lai ai ni a mying yawng langai hte langai di nna hti la wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa Mawshe hpe hkang da wu ai hte maren, Sina nam e shanhte hpe hti wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ya, Israela kasha alat Rubin amyu hta, tinang lakung, tinang dap, tinang kawa a nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying, langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />shing rai Rubin amyu hta na hti lawm ai ni gaw mun mali e hkying kru manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simun amyu hta tinang lakung, tinang dap, tinang kawa a nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />shing rai, Simun amyu hta na hti lawm ai ni gaw, mun manga e hkying jahku masum tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gad amyu hta tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shing rai, Gad amyu hta na hti lawm ai ni gaw, mun mali e hkying manga, kru tsa manga shi rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yuda amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />shing rai Yuda amyu hta na hti lawm ai ni gaw, mun sanit hkying mali e kru tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yishahka amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="29" style="v" />shing rai, Yishahka amyu hta na hti lawm ai ni gaw, mun manga e hkying mali, mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="31" style="v" />shing rai Zebulun amyu hta na hti lawm ai ni gaw, mun manga e hkying sanit mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Yawsep amyu Ehprim lakung hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="33" style="v" />shing rai, Ehprim lakung hta na hti lawm ai ni gaw, mun mali e manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bai Manashe lakung hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="35" style="v" />shing rai Manashe lakung hta na hti lawm ai ni gaw, mun masum e hkying lahkawng ni tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ben-yamin amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="37" style="v" />shing rai, Ben-yamin amyu hta na hti lawm ai ni gaw, mun masum hkying manga e mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dan amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="39" style="v" />shing rai, Dan amyu hta na hti lawm ai ni gaw, mun kru e hkying lahkawng sanit tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ashe amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="41" style="v" />shing rai, Ashe amyu hta na hti lawm ai ni gaw, mun mali e hkying mi manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Naphtali amyu hta, tinang lakung, tinang dap, tinang kawa nta hkan nna, asak hkun ning lai ai hte hpyen gasat lawm lu ai lasha yawng a amying langai hte langai hpe hti mu ai:
  </para>
  <para style="p">
    <verse number="43" style="v" />shing rai, Naphtali amyu hta na hti lawm ai ni gaw, mun manga e hkying masum mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ndai hte gaw, Mawshe yan Arun hte, amyu langai hte langai hta na, Israela du shi lahkawng ni hti tawn ai jahpan rai nga ai:
  </para>
  <para style="p">
    <verse number="45" style="v" />shing rai, Israela kashu kasha ni hta na, tinang kawa nta hkan nna, asak hkun ning lai ai hte, Israela hpyen hpung hta hti lawm ai ni yawng hte gaw,
  </para>
  <para style="p">
    <verse number="46" style="v" />sen kru e hkying masum manga tsa manga shi rai nga ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Rai timung, Lewi amyu gaw, kaji kawa nta hkan nna hti ai jahpan hta n lawm ma ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kaning rai nme law, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="49" style="v" />Lewi amyu hpe nang hti kayau lu na n rai; Israela kashu kasha ni a jahpan hta shanhte hpe shalawm lu na n rai;
  </para>
  <para style="p">
    <verse number="50" style="v" />Lewi masha ni hpe dai sakse sum, de a arai ni hte dai hte seng maseng yawng a ntsa e san tawn da mu: shanhte gaw dai sum hte sum rai yawng hpai na rai ma ai: dai hta jaw jau ai amu shanhte gun hpai nna, dai sum a grup yin e but na rai ma ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Sum htawt na rai jang, Lewi masha ni gun run na rai mu ai; but na rai jang mung, Lewi masha ni sharawt shachyaw na rai mu ai: amyu kaga masha dai de sa htep yang sat kau ai hkrum lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Israela kashu kasha ni mung but ai shaloi, langai hte langai tinang hpung tinang dap hkan nna, tinang hte seng ai dawnghkawn makau e sum gap na rai mu ai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Israela kashu kasha ni a shawa hpung a ntsa e pawt ai myit n du malit ga, Lewi masha ni gaw dai sakse sum a makau grup e but nna, shanhte gaw dai sakse sum hte seng ai amu gun hpai na rai mu ai, ngu wu ai,”
  </para>
  <para style="p">
    <verse number="54" style="v" />Yehowa Mawshe hpe hkang da mada hte maren, Israela kashu kasha ni shing rai galaw ma ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa Mawshe yan Arun hpe tsun mu ai gaw:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni langai hte langai gaw tinang hpung hte seng ai dawnghkawn hte tinang dap ni hte seng ai dawnglap makau e, dai shawa sum de man yawng nna, dai hpe grup di dap de na rai mu ai.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai jan pru sinpraw man de but de na ni gaw Yuda dawnghkawn hte seng ai hpung daw wa ni rai na rai ma ai: Yuda amyu hta na agyi gaw Aminadab a kasha Nashon rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun sanit hkying mali e kru tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yuda dap makau e Yishahka amyu but de na rai nga ai: Yishahka amyu hta na agyi gaw Zua a kasha Nehtanela rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun manga e hkying mali mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />De a makau e Zebulun amyu but de na rai nga ai: Zebulun amyu a agyi gaw Helon a kasha Eliaba rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun manga e hkying sanit mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai Yuda dawnghkawn hte seng ai hpung daw wa hta hti lawm ai ni gaw, sen mi mun matsat e hkying kru mali tsa rai ma ai. Ndai ni gaw numshawn shawng na ni rai ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dingda maga man de, Rubin hpung daw wa ni, Rubin dawnghkawn hkan nna but de na rai ma ai: Rubin amyu hta na agyi gaw Shedura a kasha Elizura rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun mali e hkying kru manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />De a makau e Simun a amyu but de na rai nga ai: Simun amyu hta na agyi gaw, Zurishadi a kasha Shelumila rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw mun manga e hkying jahku masum tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />De a makau e Gad a amyu but de na rai nga ai: Gad a amyu hta na agyi gaw, Duela kasha Eleasap rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun mali e hkying manga kru tsa manga shi rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shing rai Rubin dawnghkawn hte seng ai hpung daw wa hta hti lawm ai ni gaw, sen mi mun manga e hkying mi mali tsa manga shi rai ma ai. Ndai ni gaw numshawn hpung a hpang tut na ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi dap ka-ang ngu na hta shawa sum hte hpawn, Lewi dap hkan na rai nga ai: but de yang na zawn, langai hte langai tinang hte seng ai dawnghkawn hte rau sa wa na rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sinna maga man de Ehprim hpung daw wa ni Ehprim dawnghkawn hkan nna but de na rai ma ai: Ehprim amyu hta na agyi gaw Amihu a kasha Elishama rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun mali e manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />De a makau e Manashe amyu but de na rai ma ai: Manashe amyu hta na agyi gaw Pedazura a kasha Gamalela rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun masum e hkying lahkawng ni tsa rai ma ai,
  </para>
  <para style="p">
    <verse number="22" style="v" />De a makau e Ben-yamin amyu but de na rai ma ai: Ben-yamin amyu hta na agyi gaw Gidoni a kasha Abidan rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw mun masum e hkying manga mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai Ehprim dawnghkawn hte seng ai hpung daw wa hta hti lawm ai ni gaw, sen mi hkying matsat e latsa rai ma ai. Ndai ni gaw masum ngu na hpung rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dingdung maga man de Dan hpung daw wa ni Dan dawnghkawn hkan nna but de na rai ma ai: Dan amyu hta na agyi gaw Amishadi a kasha Ahiza rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun kru e hkying lahkawng sanit tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />De a makau e Ashe amyu re ai ni but de na rai ma ai: Ashe amyu hta na agyi gaw Ohkran a kasha Pagila rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shi hte seng ai wunawng wuwa hta hti lawm ai ni gaw, mun mali e hkying mi manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />De a makau e Naphtali amyu but de na rai ma ai: Naphtali amyu hta na agyi gaw, Enan a kasha Ahira rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shi hte seng ai wunawng wuwa ni hta hti lawm ai ni gaw mun manga e hkying masum mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shing rai Dan hte seng ai hti lawm ai ni gaw sen mi mun manga e hkying sanit kru tsa rai ma ai. Ndai ni gaw tinang dawnghkawn hte rau hpang ningdim e hkan na rai nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shing rai tinang a kaji kawa lakung lama hkan nna hti lawm ai Israela kashu kasha hpung daw wa yawng hte gaw, sen kru e hkying masum manga tsa manga shi rai ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lewi masha ni hpe gaw, Yehowa Mawshe hpe hkang da ai hte maren, Israela kashu kasha ni hta n hti shalawm wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yehowa Mawshe hpe hkang da ai hte maren, Israela kashu kasha ni langai hte langai tinang a dawnghkawn makau e but de ai hte tinang kaji kawa ni a lakung lama hkan nna sa wa wa rai ma ai: shing rai Israela kashu kasha ni galaw ma ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Da ndai gaw Yehowa Mawshe hpe Sina bum e ga tsun ai shaloi, Arun yan Mawshe a amyu matu ni a lam gawn ai rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Arun a shadang sha ni a amying ni gaw, kasha alat Nadab hte, Abihu, Eleaza, Ihtama rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai ni gaw hkinjawng aya dang ai shani e, namman chya hkam la ai Arun a shadang sha hkinjawng ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nadab yan Abihu gaw Sina nam e naw rai nga yang, Yehowa a man e wan shaje hte jaw jau ai shaloi Yehowa a man e si mat ma ai: shan hta matu mara n nga ai rai nna, Eleaza yan Ihtama gaw kawa Arun a man e hkinjawng amu gun hpai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Lewi amyu hpe shaga la nna, hkinjawng Arun a amu hpe galaw shangun na matu, shi a man e shanhte hpe woi tawn ya u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw dai sumpan sum a amu shachyen na matu, Arun hte seng ai amu mung, shawa hpung ting hte seng ai amu mung, dai shawa sum a man e gun hpai na rai mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw shawa sum a arai yawng mayawng yu lajang nna, dai sumpan sum hta Israela kashu kasha ni a jaw jau ai amu gun hpai na rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lewi masha ni hpe Arun hte shi a shadang sha ni a lata hta ap da na rai ndai: shing rai, Israela kashu kasha ni hta na shanhte hpe lata la nna, shi hpe madu shangun na rai ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Arun hte shi a shadang sha ni hpe nang aya dang tawn nna, shanhte gaw tinang a hkinjawng amu sin nga na rai ma ai: dai de htep sa ai amyu kaga masha gaw sat kau ai hkrum lu na wu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Yu u, Ngai gaw Israela kashu kasha ni hta na kasha alat ngu na ni matu Lewi masha ni hpe lata la we ai rai nna, Lewi masha ni gaw nye a masha rai nga ma ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaning rai nme law, kasha alat yawng mayawng nye a rai nga ai; Egutu mung hta e kasha alat yawng hpe ngai sat kau ai shaloi, Israela kashu kasha ni hta, masha hpe rai timung, yamnga hpe rai timung, kasha alat nlang hte hpe, ngai nye a matu shachyoi shapra we ai; shanhte gaw nye a ni rai na rai nga ma ai: ngai gaw Yehowa rai nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai Yehowa, Sina bum e Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Lewi a kashu kasha ni hta na asak shata mi hta jan ai lasha ma nlang hte hpe tinang a lakung lama hte tinang kaji kawa dap hkan nna hti tawn nu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Mawshe gaw Yehowa hkang da ai hte maren shanhte hpe hti tawn mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ya Lewi hta na shadang sha ni a amying gaw, Gershon, Kohat, Merari tai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai, tinang a lakung lama ngu na Gershon a shadang sha ni a amying gaw, Libni hte Shimi rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tinang lakung lama ngu na, Kohat a shadang sha ni gaw, Amram, Izhara, Hebron, Uzela rai ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tinang lakung lama ngu na Merari a shadang sha ni gaw, Mali yan Mushi rai ma ai. Dai ni gaw tinang kaji kawa dap hkan nna, Lewi a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gershon hta na hkrat ai Libni dap hte Shimi dap gaw, Gershon lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte lakung hta na hti lawm ai asak shata mi hta jan ai lasha ma nlang hte gaw hkying sanit e manga tsa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gershon lakung ni gaw sumpan sum a sinna maga de but de na rai ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gershon lakung hta na agyi gaw Laela kasha Eliasap rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gershon a kashu kasha ni, dai shawa sum hta gun hpai na amu kumhtaw gaw shawa sum galup ai sumpan magap, de a ntsa na Sum hte ntsa jahtum na magap, shawa sum chyinghka na nba grang,
  </para>
  <para style="p">
    <verse number="26" style="v" />sumpan sum hte tawn hkungri grup na wanggrang, wang chyinghka na nba grang hte dai ni hte seng ai sumri ni nlang, yu lajang na rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai, Kohat hta na hkrat ai Amram dap, Izhara dap, Hebron dap, Uzela dap ni gaw, Kohat a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte lakung hta na hti lawm ai asak shata mi hta jan ai, sumpan sum sin ai lasha ma yawng hte gaw hkying matsat e kru tsa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kohat a lakung ni gaw sumpan sum a dingda maga e but de na rai ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kohat a lakung ni a agyi gaw, Uziela kasha Eliazahpan rai nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shanhte a amu kumhtaw gaw, sumpu, aku, pyengdin shadun, tawn hkungri ni, jaw jau yang chyoi pra ai shara e lang ai arai ni, nba shinggang hte dai hte seng ai yang mayawng yu lajang na rai ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hkinjawng Arun a kasha Eliaza gaw Lewi amyu hta na agyi ni a ntsa e agyi tai nna, dai nawku nta hta amu gun hpai ai ni hpe up na rai wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bai, Merari hta na hkrat ai Mali dap, Mushi dap ni gaw, Merari a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte lakung hta na hti lawm ai asak shata mi hta jan ai lasha ma yawng gaw, hkying kru e ni tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Merari lakung hta na agyi gaw, Abihila kasha Zurela rai nga ai: shanhte gaw sumpan sum a dingdung maga e but de na rai nga ai,
  </para>
  <para style="p">
    <verse number="36" style="v" />Merari kashu kasha ni a amu kumhtaw gaw, sumpan sum a hpunpyen ni, htinggrang ni, shadaw ni, machyaw ni hte dai hte seng ai rai nlang hpe mung;
  </para>
  <para style="p">
    <verse number="37" style="v" />wanggrang shadaw ni, de a machyaw ni, de a mailak ni hte sumri ni hpe mung, yu lajang na rai ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mawshe yan Arun hte Arun a shadang sha ni chyawm gaw, Israela kashu kasha ni a matu dai chyoi pra ai nta hpe sin let shawa sum a sumpan nta a sinpraw man e but de ai ni rai nga ma ai: amyu kaga masha dai de sa htep yang, sat kau ai hkrum lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Yehowa hkang da ai hte maren, Mawshe yan Arun hti nna Lewi kashu kasha ni hta kaji kawa dap hkan nna hti lawm ai asak shata mi hta jan ai lasha ma yawng hte gaw, mun lahkawng e hkying lahkawng rai nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw, “Israela kashu kasha ni hta na, asak shata mi hta jan ai lasha ma alat yawng hpe jahpan hti la u.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shing rai, Israela kashu kasha ni hta na kasha alat nlang a malai, Lewi masha ni hpe, nye a matu shatai na rai ndai: Israela kashu kasha ni a yamnga hta na kasha alat nlang a malai Lewi masha ni a yamnga ni hpe, nye a matu shatai na rai ndai: ngai gaw Yehowa rai nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shing rai Mawshe gaw, Yehowa hkang da ai hte maren, Israela kashu kasha ni hta na kasha alat yawng hpe hti wu ai rai nna,
  </para>
  <para style="p">
    <verse number="43" style="v" />asak shata mi hta jan ai hti lawm ai lasha ma alat yawng hte gaw, mun lahkawng e hkying lahkawng ni tsa e sanit shi masum rai nga ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Israela kashu kasha ni hta na, kasha alat nlang a malai Lewi masha ni hpe, shanhte a yamnga ni a malai Lewi masha ni a yamnga ni hpe la san da u: Lewi masha ni gaw nye a ni rai na, rai nga ma ai: ngai gaw Yehowa rai nga nngai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Lewi masha ni hta jan ai Israela kashu kasha ni hta na kasha alat ni tsa e sanit shi masum hte hpe gaw,
  </para>
  <para style="p">
    <verse number="47" style="v" />nawku nta na shekela khu hkan nna, masha langai mi hta, shekela manga hte hkrang la lu na rai nga ai; shekela langai mi gaw gera hkun rai nga ai:
  </para>
  <para style="p">
    <verse number="48" style="v" />jan ai ni jaw ai hkrang shaw gumhpraw gaw, Arun hte shi a shadang sha ni hpe jaw na rai ndai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shing rai mawshe gaw Lewi masha ni hta jan ai Israela kashu kasha ni hta na lasha ma alat ni a hkrang shaw gumhpraw hpe,
  </para>
  <para style="p">
    <verse number="50" style="v" />nawku nta shekela hku hkan nna, gumhpraw shekela hkying mi masum tsa e kru shi manga lahkawn la nhtawm,
  </para>
  <para style="p">
    <verse number="51" style="v" />Yehowa hkang da ai hte maren, Mawshe gaw dai hkrang shaw gumhpraw Arun hte shi a shadang sha ni hpe ap ya wu ai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa Mawshe yan Arun hpe tsun mu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />Lewi amyu Kohat lakung hta na asak sumshi ning kaw nna manga shi du ai ni du hkra,
  </para>
  <para style="p">
    <verse number="3" style="v" />dai shawa sum hta amu gun hpai lawm lu na ni yawng hte hpe, kaji kawa dap hkan nna jahpan hti la mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shawa sum hta na chyoi pra htum ai arai ni hte seng ai, Kohat a kashu kasha ni gun hpai na amu gaw ning rai nga ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />rawt na aten du jawng, Arun hte shi a shadang sha ni sa nna, kata gawk na nba shinggang shayu la nhtawm, dai sakse sumpu hpe magap na rai mu ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />de a ntsa e tahkisha hpyi ka-up nhtawm, sawm tsit ai nba bai magap nna dai kandang dinghkrawn da na rai mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai, dai madun dan ai muk ku a ntsa e sawm tsit ai nba nep nna de a ntsa e wan pa ni, chyaw ni, gawm ni hte ru hkaw na matu hka wan ni mara da na rai mu ai: tutnawng na muk mung dai hta nga nga na rai nga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />dai rai ni hpe hkyeng ai nba hte magap nna, tahkisha hpyi hte bai ka-up nhtawm kandang dinghkrawn da na rai mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai, dai pyengdin shadun, pyengdin wan ni, lakap ni, wan pa ni hte dai hta jaw jau ai namman yam ni hpe sawm tsit ai nba hte magap nhtawm,
  </para>
  <para style="p">
    <verse number="10" style="v" />dai arai yawng hpe tahkisha hpyi hte makai nna hpaichyau hta bang na rai mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai, dai ja hkungri hpe shanhte sawm tsit ai nba nep nhtawm, tahkisha hpyi hte ka-up nna, kandang dinghkrawn da na rai mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai chyoi pra ai nta na amu hta lang ai arai yawng mayawng hpe sawm tsit ai nba hte kayawp nna, tahkisha hpyi hte makai nhtawm, hpaichyau hta bang na rai mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tawn hkungri hpe mung, dai hta na dap hpe hte kau nna, de a ntsa e hkyeng mang ai nba nep nhtawm,
  </para>
  <para style="p">
    <verse number="14" style="v" />dai hkungri hte seng ai amu a arai ni ngu ai; ban pa ni, chyinghkyi ni, shingban ni, angdung ni hte dai tawn hkungri hte seng ai arai yawng hpe mara ngut jang, tahkisha hpyi ka-up nhtawm, kandang ni dinghkrawn da na rai mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai rawt na ten du jang, Arun hte shi a shadang sha ni dai chyoi pra ai nta hte de a arai yawng mayawng hpe magap ngut jang, Kohat a kashu kasha ni dai hpe hpai na matu sit sa na rai ma ai: rai timung, shanhte si ai n hkrum mu ga, chyoi pra ai arai ni hpe shum lu na n rai. Dai hte gaw shawa sum hta Kohat a kashu kasha ni a gun hpai na amu rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkinjawng Arun a kasha Eleaza a aya hte seng ai amu gaw, wan shatu na namman, wan nat na manam pyaw, tutnawng na shadung kumhpa, chya na namman, re ai hte, sumpan sum ting hte dai hta rawng ai arai ni yawng, chyoi pra ai shara hte de a arai ni yu lajang na rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai Yehowa Mawshe yan Arun hpe tsun mu ai gaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kohat a lakung lama ni hpe Lewi amyu hta na hkum jahtum kau myit;
  </para>
  <para style="p">
    <verse number="19" style="v" />shanhte hpe ning rai galaw mu: dai chyoi pra htum ai arai ni hpang de shanhte sit htep ai shaloi, si ai n hkrum ai sha, hkrung nga lu mu ga, Arun hte shi a shadang sha ni shawng shang nna, masha langai hte langai hpe tinang galaw na amu hte gun hpai na lit karan hpajang ya na rai mu ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />rai timung, dai chyoi pra ai shara hpe yu yu na nga, chyahkring mi muk shang lu na n rai; shang yang chyawm gaw si ai hkrum lu na mara ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Gershon lakung lama hta na
  </para>
  <para style="p">
    <verse number="23" style="v" />asak sumshi ning kaw nna manga shi du ai ni du hkra, dai shawa sum a amu gun hpai lawm lu ai ni yawng hte hpe, kaji kawa dap hkan nna jahpan hti la u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gershon lakung lama ni a galaw na amu hte gun hpai na lit ni gaw, dai rai nga ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shanhte gaw, sumpan sum a kata htap na nba grang ni hte, shawa sum ngu ai nba grang ni, ntsa sum hte seng ai tahkisha magap, shawa sum chyinghka grang,
  </para>
  <para style="p">
    <verse number="26" style="v" />sumpan sum hte tawn hkungri grup na wanggrang ni, wang chyinghka grang, dai ni a sumri ni hte, dai ni hta na jaw jau yang lang ai tinang a arai nlang hte hpe lajang gun hpai na rai ma ai: dai gaw shanhte a amu rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gershon a kashu kasha ni gaw, tinang galaw na hte gun hpai na amu shagu hta, Arun hte shi a shadang sha ni karan hpajang ya ai hte maren, lit gun hpai na rai ma ai: nanhte shanhte a matu tinang lit tawn da na rai mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai gaw shawa sum hta Gershon a lakung lama ni gun hpai na amu rai nga ai: hkinjawng Arun a kasha Ihtama shanhte hpe byeng na rai nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bai Merari lakung lama hta na mung, asak sumshi ning kaw nna manga shi du ai ni du hkra,
  </para>
  <para style="p">
    <verse number="30" style="v" />dai shawa sum a amu gun hpai lawm lu ai ni yawng hte hpe, kaji kawa dap hkan nna jahpan hti la u.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai shawa sum hta shanhte galaw na amu hte gun hpai na lit gaw, dai rai nga ai: dai sumpan sum a hpunpyen ni, de a htinggrang ni, shadaw ni hte de a machyaw ni;
  </para>
  <para style="p">
    <verse number="32" style="v" />wanggrang shadaw ni hte de a machyaw ni, de a mailak ni, de a sumri ni hte, dai ni hta jaw jau yang lang ai arai ni nlang hpe lajang gun hpai na rai ma ai: shanhte gun hpai na rai ni hpe amying shakap nna hti na rai ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai gaw hkinjawng Arun a kasha Ihtama byeng nna shawa sum hta Merari a lakung lama ni gun hpai ai amu yawng rai nga ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shing rai Mawshe yan Arun hte shawa hpung na agyi salang ni gaw, Kohat a kashu kasha ni hta na,
  </para>
  <para style="p">
    <verse number="35" style="v" />asak sumshi ning kaw nna manga shi du ai ni du hkra, shawa sum hta amu gun hpai lawm lu ai ni yawng hte hpe, kaji kawa dap hkan nna, jahpan hti la mu ai:
  </para>
  <para style="p">
    <verse number="36" style="v" />shanhte hta hti lawm ai ni yawng hte gaw, hkying lahkawng e sanit tsa manga shi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai ni gaw, Yehowa Mawshe hpe hkang da ai hte maren, Mawshe yan Arun hti la nna, shawa sum a amu gun hpai lawm ai Kohat a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Gershon a kashu kasha ni hta na, asak sumshi ning kaw nna manga shi du ai ni du hkra,
  </para>
  <para style="p">
    <verse number="39" style="v" />shawa sum hta amu gun hpai lawm lu ai ni yawng hte hpe, kaji kawa dap hkan nna, jahpan hti mu ai hte maren,
  </para>
  <para style="p">
    <verse number="40" style="v" />jahpan hta lawm ai ni yawng hte gaw hkying lahkawng kru tsa e sumshi rai ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Dai ni gaw, Yehowa hkang da ai hte maren, Mawshe yan Arun hti la nna, shawa sum a amu gun hpai lawm ai Gershon a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Merari a kashu kasha ni hta na, asak sumshi ning kaw nna manga shi du ai ni du hkra,
  </para>
  <para style="p">
    <verse number="43" style="v" />shawa sum hta amu gun hpai lawm lu ai ni yawng hte hpe, kaji kawa dap hkan nna, jahpan hti mu ai hte maren,
  </para>
  <para style="p">
    <verse number="44" style="v" />jahpan hta lawm ai ni yawng hte gaw, hkying masum e ni tsa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Dai ni gaw, Yehowa Mawshe hpe hkang da ai hte maren, Mawshe yan Arun hti la ai Merari a kashu kasha ni a lakung lama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ning rai Lewi masha ni hta asak sumshi ning kaw nna manga shi du ai ni du hkra,
  </para>
  <para style="p">
    <verse number="47" style="v" />shawa sum a amu hta shang nna, lit gun hpai lu na ni yawng hte hpe, kaji kawa dap hkan nna,
  </para>
  <para style="p">
    <verse number="48" style="v" />Mawshe yan Arun hte Israela agyi salang ni hti la ai jahpan hta lawm ai ni yawng hte gaw hkying matsat e manga tsa matsat shi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shing rai Mawshe gaw Yehowa hkang da ai ga hte maren, langai hte langai a galaw na amu hte gun hpai lu na lit hpe hkan nna, shanhte hpe jahpan hti la mu ai: Yehowa Mawshe hpe hkang da ai ga hte maren jahpan hti mu ai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ngai rawng nga ai dap hpe awu asin n rai mu ga, manggang gang ai, ari ri ai, si mang hkra nna n san n seng re ai numsha lasha yawng hpe,
  </para>
  <para style="p">
    <verse number="3" style="v" />dap shinggan e shapraw da mu, ngu nna Israela kashu kasha ni hpe hkang dat u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai Israela kashu kasha ni galaw nna, shanhte hpe dap shinggan de shapraw da mu ai: Yehowa Mawshe hpe hkang da ai hte maren Israela kashu kasha ni galaw mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Israela kashu kasha ni hpe ning ngu tsun mu: Masha shut hpyit chye ai lam hta shut hpyit nna Yehowa hpe shut kau ai majaw, mara lu ai numsha, lasha kadai mung,
  </para>
  <para style="p">
    <verse number="7" style="v" />tinang shut kau ai lam hpaw dan nna hpyi nem lu na rai wu ai: shut kau ai a matu htam manga hta htammi mung nawp nna, tinang shut kau ai wa hpe galaw lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai galaw jahkap la na kahpu kanau n nga yang gaw, hkinjawng wa a matu Yehowa hpe jaw jau na rai wu ai: dai hta kaga, shi a lam htingrai htingrat na matu, htingrai hkungga sagu la langai mi nawng jau na rai wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israela kashu kasha ni, hkinjawng wa kaw sa jau ai chyoi pra ai arai ni hta na manawt hkungga shagu gaw, shi a rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jau na matu shachyoi shapra ai arai gaw gade a rai timung hkinjawng wa a rai na rai nga ai: hkinjawng wa kaw sak ai hpa mung, shi a rai na ra nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Israela kashu kasha ni hpe ning ngu tsun mu: Madu wa lu ai num, kaga la hte shut nna, tinang madu wa hpe tawt kau ai lam hta shut hpyit nga yang,
  </para>
  <para style="p">
    <verse number="13" style="v" />masha kaga n mu hkrup, sakse mung n nga ai hte, shi hkum hpe shayuk kau nhtawm, dai lam hpe ip shadang ai majaw, madu wa n chye timung,
  </para>
  <para style="p">
    <verse number="14" style="v" />madu jan a hkum yuk nga sai nga nna myit machyi ai rai yang mung, madu jan hta yuk ai n yuk ai rai timung, madu wa n kam nna myit machyi nga ai rai yang mung;
  </para>
  <para style="p">
    <verse number="15" style="v" />madu wa gaw madu jan hpe muk-yaw shadung kam hpa uma mi hte hkinjawng wa hpang de woi sa na rai wu ai: shadung dai hta namman ru bun lu na n rai, lawban mung mara lu na n rai: kaning rai nme law, dai gaw yubak shapraw na kamang shadung rai nga ai rai nna, dai hpe myit machyi shadung kumhpa ngu na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hkinjawng wa mung dai numsha hpe woi la nna, Yehowa man e tawn da na rai wu ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />bai hkinjawng wa gaw dibu hta chyoi pra ai ntsin ru bang nhtawm, sumpan sum na ga nhpu la nna, dai ntsin hta bang na rai wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai hkinjawng wa gaw dai numsha hpe Yehowa man e woi tawn nna, kara hpyan ayai kau ya nhtawm, myit machyi shadung kumhpa ngu ai kamang shadung hpe shi a lata hta lang shangun na rai wu ai: ari jahkrum ai ntsin hka hpe gaw, hkinjawng wa shi a lata hta lang na rai wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi hkinjawng wa gaw dai numsha hpe ning ngu machyai jaw na rai wu ai: “Nang gaw na a la du hta tawt nna lasha gale hte n nga sha, nang hta awu asin n rai a yang gaw, ndai ari jahkrum ai ntsin hka hte nang lawt u ga law:
  </para>
  <para style="p">
    <verse number="20" style="v" />shing n rai, tinang la du hta tawt nna lasha gale hte nga sha ai majaw nang hta awu asin rai nga a yang gaw, Yehowa nang hpe deng nna na magyi latsi shangun ai hte na hkum shabum ya jang, amyu masha ni a dagam dala ai hte matsa mawa hkrum sha ai jan shatai u ga law:
  </para>
  <para style="p">
    <verse number="21" style="v" />ndai ari jahkrum ai ntsin hka gaw na a kan de shang nna, na a hkum bum wa ai hte magyi latsi shangun u ga law,
  </para>
  <para style="p">
    <verse number="22" style="v" />nga nna hkinjawng wa machyai jaw yang numsha gaw, dagam dala ai ga hkan tsun ngut jang, Amen, Amen,” ngu nna yin la na rai wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai hkinjawng wa gaw, dagam dala ga dai hpe laika hta ka da nna, dai ntsin hka hte bai shaprai kau nhtawm,
  </para>
  <para style="p">
    <verse number="24" style="v" />dai numsha hpe ari jahkrum na ntsin hka dai lu shangun na rai wu ai: ntsin dai gaw numsha kan de du nna hka na ra ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai hkinjawng wa gaw myit machyi shadung kumhpa hpe numsha a lata na la nna Yehowa a man e nwat let, tawn hkungri hta la tawn nhtawm,
  </para>
  <para style="p">
    <verse number="26" style="v" />dum ya na matu dai kamang shadung hta na hkinjawng wa latup mi la nna tawn hkungri hta nat na rai wu ai; dai hpang numsha hpe ntsin dai lu shangun na rai wu ai:
  </para>
  <para style="p">
    <verse number="27" style="v" />Num dai madu wa hta tawt nna awu asin re ai teng yang gaw, dai ntsin lu ngut ai hpang shi kan de ari jahkrum ai ntsin dai hka shang wa nna hkum bum wa ai hte magyi latsi wa jang, numsha dai gaw shi a amyu hta matsa mawa hkrum ai jan tai na ra ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing n rai, num dai awu asin n rai, asan aseng rai yang gaw, shi lawt lu nna kashu kasha kap na ra ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai gaw, num ni tinang madu wa hta tawt nna, la kaga hte nga sha ai majaw, awu asin hkrum ai rai yang mung;
  </para>
  <para style="p">
    <verse number="30" style="v" />lasha ni tinang num hpe n kam ai majaw, myit machyi shara rawng yang mung, hkan lu na tara rai nga ai: madu jan hpe Yehowa man e shi woi tawn da nna, hkinjawng wa gaw, dai tara hte maren shi hta jeyang na rai wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi la wa gaw mara lawt lu nna, num jan gaw tinang a yubak hkrum sha na rai wu ai,” ngu wu ai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe ning ngu tsun u: Numsha rai timung, lasha rai timung, Yehowa a matu tinang hkum hpe san da na, Naziri ngu ai ga shaka tawn da ai rai yang gaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />tsabyi jahku hte nang ai baw gam kau lu na rai wu ai: tsabyi jahku a ntsin hkri mung, nang ai baw hkri hpa jahku mung lu lu na n rai: tsabyi si shup la ai jahku mung lu mai na n rai; tsabyi si katsing raitim, chyahkraw raitim, sha lu na n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tinang hkum hpe san da ai nhtoi hte yang tsabyi hpun hta nna lu la ai hpa mung sha mai na n rai; tsabyi tum, tsabyi hpyi sha pyi sha lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai, Naziri tai na ga shaka tawn da ai nhtoi hte yang, tinang a baw shangun lu na n rai: Yehowa matu tinang hkum hpe san da ai nhtoi garai n gu gu gaw, shi hta chyoi pra nga na rai nna, tinang a kara hpe madat da na rai wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tinang hkum hpe Yehowa a matu san da nga ai nhtoi hte yang, si mang hpe htep lu na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a Karai Kasang a matu shi a baw hta san da ai ga shaka nga nga sai majaw, kanu, kawa, kahpu kanau, kayung kajan si timung, wu sin ai hkrum mai na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw san da nga ai nhtoi hte ting hta Yehowa a matu chyoi pra nga na rai wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a makau e masha langai ngai akajawng sha si nna, shi a san da nga sai baw hpe wu sin kau ai rai yang gaw, jasan jaseng nhtoi ngu ai sanit ya du ai shani hta baw shangun kau na rai wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Matsat ya ngu na nhtoi hta hkrudu lahkawng, shing n rai u ra kasha lahkawng, dai shawa sum chyinghka de hkinjawng wa kaw la sa na rai wu ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />hkinjawng wa mung, htingrai hkungga matu langai mi, wan nat hkungga matu langai mi di nna, si mang a majaw yubak lu ai wa a matu nawng ya na rai wu ai; shing rai dai wa gaw dai shani jang shi a baw hpe bai shachyoi shapra na rai wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shawng na san da sai nhtoi hte maren Yehowa a matu bai san da nna, ladu hkrum ai sagu la langai mi hte mara raw hkungga di nna nawng jau na rai wu ai: shi san da ai lam wu sin mat sai majaw, shawng na nhtoi ni hpe sawn lu sana n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Da ndai gaw, san da nna nga nga ai nhtoi gu jang, Naziri tai ai wa hkrang na tara rai nga ai: shi nan shawa sum chyinghka de sa nna,
  </para>
  <para style="p">
    <verse number="14" style="v" />wan nat hkungga matu ladu hkrum ai hte ra n rawng ai sagu la langai mi; htingrai hkungga matu ladu hkrum ai hte ra n rawng ai sagu yi kasha langai mi; mahku hkungga matu ra n rawng ai sagu la langai mi:
  </para>
  <para style="p">
    <verse number="15" style="v" />sau hte gumrin ai mani ai muk shadung hte galaw ai muk pa; sau hte galu ai matsi n rawng ai muk hkrawp, ngu ai matsi n rawng ai muk ka mi hte de a shadung kumhpa, ru hkaw kumhpa, Yehowa hpe sa sak na rai wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkinjawng wa gaw dai kumhpa ni hpe Yehowa kaw la shawn nna, htingrai hkungga hte wan nat hkungga nawng ya na rai wu ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />matsi n rawng ai muk ka hte rau mahku hkungga sagu la mung Yehowa hpe nawng na rai wu ai: dai hpang shadung kumhpa mung, de a ru hkaw kumhpa mung, hkinjawng wa nawng na rai wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai Naziri wa gaw shawa sum chyinghka makau e shi a san da ai baw kara shangun kau na rai wu ai; dai kara hpe mahku hkungga npu na wan dap hta ju kau na rai wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai Naziri wa shi a san da sai baw shangun kau ngut jang, hkinjawng wa gaw kaprawng kau sai sagu lahpa hkawn mi, ka hta na matsi n rawng ai muk pa mi, matsi n rawng ai muk hkrawp pa mi la nna, Naziri wa a lata hta lang shangun nhtawm,
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa a man e nwat kumhpa di nna nwat na rai wu ai: dai hte gaw nwat sinda hte manawt magyi hte nawng hkinjawng wa a matu chyoi pra na rai nga ai: dai hpang nna gaw Naziri wa tsabyi jahku lu mai sai rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hte gaw ga shaka da nna Naziri tai ai wa jaw jau lu ai made, jaw jau ai hta kaga tinang hkum hpe san da ai a matu Yehowa hpe sak jaw ra ai kumhpa a tara rai nga ai: ga shaka tawn da ai ga hte maren san da nga ai tara hku hkan nna galaw lu na rai awu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Arun hte shi a shadang sha ni hpe ning ngu tsun u: Nanhte Israela kashu kasha ni hpe ning ngu shaman ya mu:
  </para>
  <para style="p">
    <verse number="24" style="v" />“Yehowa nang hpe shaman ya nna, bau sin nga u ga;
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa nang hpe shi a myi man nhtoi jahtoi ya nna, matsan dum nga u ga;
  </para>
  <para style="p">
    <verse number="26" style="v" />Yehowa nang hpe mada mara nna, ngwipyaw shangun nga u ga law,” ngu na rai myit dai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shing rai shanhte gaw Israela kashu kasha ni a ntsa e nye a mying ningsang gang nna mara ya yang, ngai shanhte hpe shaman ai chyeju jaw na we ai,” ngu wu ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Mawshe gaw dai sumpan sum hpe sharawt shadun nhtawm, dai hpe namman chya ai hte shachyoi shapra nna, dai hte seng ai arai ni mahkra hpe mung, tawn hkungri hte dai hte seng ai arai ni mahkra hpe mung, namman chya ai hte shachyoi shapra ngut ai shani e,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela a du agyi ni gaw tinang kaji kawa dap hkan nna kumhpaw kumhpa sak jaw ma ai. Dai du gyi ni gaw amyu langai hte langai a du ni rai nga ma ai; shanhte gaw jahpan hta hti lawm ai ni a ntsa e up ai ni rai nga ma ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />du langai mi e utang langai ngai, du lahkawng pawng nna magap rawng ai law langai ngai rai nna, law kru hte utang shi lahkawng hpe sumpan sum a man de la sa nna Yehowa hpe kumhpa sak jaw ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa mung Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Rai dai ni hpe shawa sum a jaw jau ai amu hta lang na matu shanhte a lata na hkap la u: shing rai dai hpe Lewi masha ni hta langai hte langai a gun hpai ai amu hkan nna karan ya mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Mawshe gaw dai law ni hte utang ni hpe hkap la nna Lewi masha ni hpe karan ya wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai gun hpai ai amu hpe hkan nna, hkinjawng Arun a kasha Ihtama byeng ai, Gershon a kashu kasha ni hpe law lahkawng hte utang mali;
  </para>
  <para style="p">
    <verse number="8" style="v" />Merari kashu kasha ni hpe law mali hte utang matsat di nna karan ya mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai chyoi pra ai nta a amu yu lajang ai Kohat a kashu kasha ni gaw, tinang a lahpa hta hpai ra ai re ai majaw, shanhte hpe gaw law hte utang n jaw mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya dai tawn hkungri hpe namman chya ai shani e, dai hpe ap ya na matu, du agyi ni gaw dai tawn hkungri a man e tinang a kumhpaw kumhpa sak jaw ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa mung Mawshe hpe, “Dai tawn hkungri hpe ap ya na matu, du agyi langai hte langai gaw langai mi a lani ni rai nna, tinang a kumhpa sak jaw na rai ma ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ya nnan shani e kumhpa sak jaw ai gaw, Yuda amyu Aminadab a kasha Nashon rai nga ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />dai wa a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi; shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="14" style="v" />shekela shi li ai ja chyaw langai mi hte dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="15" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi:
  </para>
  <para style="p">
    <verse number="16" style="v" />htingrai hkungga matu bainam la langai mi hte hte,
  </para>
  <para style="p">
    <verse number="17" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga bainam la manga, ladu hkrum ai sagu la kasha manga, rai nga ai: dai gaw Aminadab a kasha Nashon sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lahkawng ngu na nhtoi hta Yishahka amyu na agyi Zua a kasha Nehtanela kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />shi sak jaw ai kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="20" style="v" />shekela shi li ai ja chyaw langai mi hte dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="21" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="22" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="23" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Zua kasha Nehtanela sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Masum ngu na nhtoi hta Zebulun amyu na agyi, Helon a kasha Eliaba kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi, shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="26" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="27" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="28" style="v" />htingrai hkungga matu bainam la langai mi hte
  </para>
  <para style="p">
    <verse number="29" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Helon a kasha Eliaba sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mali ngu na nhtoi hta Rubin amyu na agyi Shedura a kasha Elizura kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="31" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="32" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="33" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi
  </para>
  <para style="p">
    <verse number="34" style="v" />htingrai hkungga matu, bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="35" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Shedura a kasha Elizura sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Manga ngu na nhtoi hta Simun amyu na agyi, Zurishadi a kasha Shelumila kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="37" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="38" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="39" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="40" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="41" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Zurishadi a kasha Shelumila sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kru ngu na nhtoi hta, Gad a amyu na agyi, Duela a kasha Eliasap kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="43" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="44" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="45" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="46" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="47" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Duela a kasha Eliasap sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Sanit ngu na nhtoi hta, Ehprim amyu na agyi, Amihu a kasha Elishama kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="49" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="50" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="51" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="52" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="53" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Amihu a kasha Elishama sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Matsat ngu na nhtoi hta, Manashe amyu na agyi Pedazura a kasha Gamalela kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="55" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="56" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="57" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="58" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="59" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Pedazura a kasha Gamalela sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Jahku ngu na nhtoi hta, Ben-yamin amyu na agyi Gidoni a kasha Abidan kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="61" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="62" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="63" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="64" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="65" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Gidoni a kasha Abidan sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Shi ngu na nhtoi hta Dan amyu na agyi Amishadi a kasha Ahiza kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="67" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="68" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="69" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="70" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="71" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Amishadi a kasha Ahiza sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Shi langai ngu na shani e Ashe amyu na agyi Ohkran a kasha Pagila kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="73" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="74" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="75" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="76" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="77" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Ohkran a kasha Pagila sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="78" style="v" />Shi lahkawng ngu na shani e, Naphtali amyu na agyi Enan a kasha Ahira kumhpa sak jaw wu ai:
  </para>
  <para style="p">
    <verse number="79" style="v" />shi a kumhpa gaw, nawku nta na shekela shen ai hku hkan yang, shekela latsa e sumshi li ai gumhpraw ban langai mi, shekela sanit shi li ai gumhpraw gawm langai mi; shadung kumhpa matu dai yan hta jahpring dat ai namman hte gumrin ai mani ai muk shadung;
  </para>
  <para style="p">
    <verse number="80" style="v" />shekela shi li ai ja chyaw langai mi hte, dai hta jahpring dat ai manam pyaw ai baw;
  </para>
  <para style="p">
    <verse number="81" style="v" />wan nat hkungga matu usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha langai mi;
  </para>
  <para style="p">
    <verse number="82" style="v" />htingrai hkungga matu bainam la langai mi hte,
  </para>
  <para style="p">
    <verse number="83" style="v" />mahku hkungga nawng na matu, usu lahkawng, sagu la manga, bainam la manga, ladu hkrum ai sagu la kasha manga rai nga ai: dai gaw Enan a kasha Ahira sak ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="84" style="v" />Shing rai tawn hkungri hpe namman chya ai shani e, dai hpe ap ya na matu, Israela du agyi ni sak jaw ai kumhpa gaw: gumhpraw ban shi lahkawng, gumhpraw gawm shi lahkawng, ja chyaw shi lahkawng rai nga ai:
  </para>
  <para style="p">
    <verse number="85" style="v" />gumhpraw ban langai mi gaw shekela latsa e sumshi shi, gumhpraw gawm langai mi gaw sanit shi shi li nga ai rai nna, nawku nta na shekela hku shen yang, gumhpraw rai yawng gaw shekela hkying lahkawng e mali tsa rai nga ai:
  </para>
  <para style="p">
    <verse number="86" style="v" />manam pyaw ai baw hte hpring ai ja chyaw shi lahkawng mung, nawku nta na shekela hku shen yang, shekela shi shi rawng ai rai nna ja chyaw yawng ga shekela latsa e hkun rai nga ai:
  </para>
  <para style="p">
    <verse number="87" style="v" />wan hte nat nawng na matu mung shadung kumhpa ni hte hpawn, usu shi lahkawng, sagu la shi lahkawng, ladu hkrum ai sagu la kasha shi lahkawng; htingrai hkungga matu bainam la shi lahkawng:
  </para>
  <para style="p">
    <verse number="88" style="v" />mahku hkungga nawng na matu usu hkun mali, sagu la kru shi, bainam la kru shi, ladu hkrum ai sagu la kasha kru shi rai nga ai. Dai gaw tawn hkungri hpe namman chya ai shaloi, dai hpe ap ya na matu, sak jaw ai kumhpa rai nga ai.
  </para>
  <para style="p">
    <verse number="89" style="v" />Mawshe mung Yehowa hte ga jahkrum na nga shawa sum kata de shang wu yang, dai sakse sumpu a chyeju magap ntsa na Hkerubim lahkawng yan a lapran nna shi hpe shaga ai Nsen Mawshe na wu ai rai nna shi hte ga tsun nga ai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />Arun hpe ning ngu tsun u, “Pyengdin ni hpe nang shatu yang, dai pyengdin wan sanit hte hpe pyengdin shadun a man de shayawn nna shatu u, ngu nna tsun u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa Mawshe hpe hkang da ai hte maren Arun galaw nna, pyengdin wan ni hpe pyengdin shadun a man de shayawn nna shatu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai pyengdin shadun chyawm gaw aja hte dup ai rai nga ai; de a madung kaw nna nampan pu ni du hkra dup la ai hkrai rai nga ai: Yehowa Mawshe hpe madun ai kasi hte maren dai pyengdin shadun hpe galaw la ai rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Israela kashu kasha ni hta na Lewi masha ni hpe lata la nna, shanhte hpe jasan jaseng mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte hpe ning di jasan jaseng na rai ndai: htingrai ntsin hte shanhte hpe lapri bun nna, hkum ting na mun shangun kau ai hte, hpun palawng hkrut kau nna, tinang hkum jasan jaseng shangun na rai ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai hta kaga, namman hte gumrin ai mani ai muk shadung ngu ai shadung kumhpa hte hpawn, usu uram langai mi la nna,
  </para>
  <para style="p">
    <verse number="9" style="v" />Lewi masha ni hpe shawa sum a man e jahpawng tawn nhtawm, Israela kashu kasha ni a shawa hpung ting hpe jahpawng ngut jang,
  </para>
  <para style="p">
    <verse number="10" style="v" />Lewi masha ni hpe Yehowa man e jashawn na rai ndai. Israela kashu kasha ni mung, Lewi masha ni a baw hta lata mara ai hte,
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa hpe jaw jau ai amu gun hpai shangun na matu, Israela a kashu kasha ni a malai ngu na Lewi masha ni hpe, Arun gaw Yehowa kaw nwat hkungga hku sak jaw na rai wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lewi masha ni mung usu baw hta lata mara na rai mu ai: nang mung, Lewi masha ni a matu htingrai htingrat ya na usu langai mi hte htingrai hkungga, usu langai mi hte wan nat hkungga di nna nawng ya u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai Lewi masha ni hpe Arun hte shi a shadang sha ni a man e nang woi tawn nna, Yehowa kaw nwat hkungga hku sak jaw na rai wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israela kashu kasha ni hta na Lewi masha ni hpe nang jahka tawn na rai nna, Lewi masha ni gaw nye a ni rai na rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi she Lewi masha ni gaw shawa sum a amu shang gun lu na rai ma ai: nang shanhte hpe jasan jaseng nna, nwat hkungga hku sak jaw na rai ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaning rai nme law, Israela kashu kasha ni hta na shanhte gaw ngai hpe ap ya ai ni nan rai nga ma ai rai nna, Israela kashu kasha ni hta na shawng shaprat ai kasha alat ni a malai ngai shanhte hpe madu la we ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israela kashu kasha ni hta na kasha alat yawng hte gaw masha mung yamnga mung nye a rai nga ai: Egutu mung e kasha alat yawng hpe ngai sat kau ai shani e, ngai shanhte hpe nye a matu shachyoi shapra la se ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai rai nna, Israela kashu kasha ni hta na kasha alat nlang a malai ngai shanhte hpe madu la we ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai Israela kashu kasha ni dai chyoi pra ai nta de sit sa yang shanhte yubak ari n hkrum hkra, dai shawa sum hta Israela kashu kasha ni a matu jaw jau na amu gun hpai nna, shanhte a matu htingrai htingrat ya mu ga, ngu nna Israela kashu kasha ni hta na Lewi masha ni hpe Arun hte shi a shadang sha ni e kumhpa hku ngai jaw da we ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai Mawshe yan Arun hte Israela kashu kasha ni a shawa hpung nlang hte gaw, Lewi masha ni a lam Yehowa Mawshe hpe hkang da wu ai hte maren, Lewi masha ni hpe galaw mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lewi masha ni mung tinang hkum hpe yubak kaw na jasan jaseng nna tinang a hpun palawng hkrut ma ai: Arun mung shanhte hpe nwat hkungga hku Yehowa kaw sak jaw nna, shanhte hpe jasan jaseng na htingrai htingrat ya wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi she Lewi masha ni gaw Arun hte shi a shadang sha ni a man e, shawa sum a amu gun hpai na nga shang ma ai: Lewi masha ni a lam Yehowa Mawshe hpe hkang da wu ai hte maren, shanhte shing rai galaw ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Da ndai gaw Lewi masha ni hkan na lam rai nga ai: asak hkun manga ning lai jang she shawa sum a amu lit shang gun lu na rai ma ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />asak manga shi ning lai jang chyawm gaw amu lit raw sai rai nna lit n gun hpai ai sha, tinang kahpu kanau ni hte rau dai shawa sum hta ra ai amu gahti galai karum lu na rai mu ai; amu kaga gaw lawm ra na n rai. Ning rai Lewi masha ni a amu gun hpai na lam nang hpajang lu na rai ndai,” ngu wu ai.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Egutu mung na pru wa ai ni ning shaning shata langai hta Sina nam mali e Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Madat da ai ahkying hta Israela kashu kasha ni shalai dat ai poi galaw lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tawn da ai matsun maroi nga nga ai hte maren, ahtung ahking mahkra hte tup, madat da ai ahkying ngu ai ndai ta shi mali ya shana e galaw lu na rai myit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Mawshe gaw, Israela kashu kasha ni hpe shalai dat ai poi galaw na lam htawn shana wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte mung, Sina nam mali e langai ngu na shata shi mali ya shana hta shalai dat ai poi galaw ma ai: Yehowa Mawshe hpe hkang da mada hte maren Israela kashu kasha ni galaw ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Si mang a majaw wu sin mat nna, dai shani e shalai dat ai poi n lawm lu ai lasha nkau mi gaw, dai shani jang Mawshe yan Arun kaw sa nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ya anhte gaw si mang a majaw wu sin mat saga ai; dai rai yang, madat da ai ahkying hta, Israela kashu kasha ni hte rau Yehowa hpe kumhpa jaw na lam, anhte hpe hpa rai hkum da na rai ta?” ngu nna san mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Mawshe gaw, “Garai naw, nanhte a lam Yehowa tsun ai ga ngai naw madat yu se ga,” ngu nna shanhte hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israela kashu kasha ni hpe ning ngu tsun u, Nanhte hte nanhte a amyu hta na masha langai ngai si mang a majaw wu sin mat ai rai timung, sumtsan sa mat ai rai timung, Yehowa a matu shalai dat ai poi gaw galaw lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai gaw shata lahkawng ngu na shi mali ya shana e galaw na rai mu ai: matsi n rawng ai muk, hka ai shat mai lap hte sha na rai mu ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />dai hta na hpang jahpawt du hkra ngam da lu na n rai; nra mung shadaw lu na n rai: shalai dat ai poi a ahtung ahking mahkra shatup nna galaw lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Wu sin mat ai mung n rai, sumtsan sa mat ai mung n rai re ai mi, shalai dat ai poi n shang lawm ai nga nga ai wa gaw, shi a amyu hta na sumri dan kau ya ai hkrum lu na rai nga ai: madat da ai ahkying hta Yehowa matu kumhpa n la sa ai majaw, dai wa gaw shi a yubak hkrum sha na rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanhte kaw shingbyi nga ai amyu kaga wa Yehowa a matu shalai dat ai poi galaw mayu yang, tawn da nga sai matsun hte maren ahtung ahking mahkra hte tup galaw lu na rai wu ai: shing rai nanhte hta shingbyi nga ai amyu kaga masha a matu mung, nanhte amyu a matu mung tara langai sha rai na rai myit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya dai sumpan sum sharawt ai shani e dai sumwi gaw sumpan sum ntsa e jung nna sakse sum hpe ka-up nga ai: dai sumwi gaw shana de nna jahpawt du hkra dai sumpan sum ntsa e wan zawn htoi nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tutnawng shing rai nga nna, sumwi gaw ka-up nga ai hte, shana e wan zawn htoi nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sumwi dai Sum ntsa na dawm mat jang, Israela kashu kasha ni hkawm sa wa ma ai: sumwi yu jung ai shara shagu hta mung Israela kashu kasha ni but de ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa hkang dat ai hte maren Israela kashu kasha ni hkawm sa wa ma ai; Yehowa hkang dat jang shanhte but de ma ai: sumpan sum ntsa e sumwi jung nga dingsa shanhte mung ade nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sumwi dai sumpan sum ntsa e nhtoi na na jung nga jang, Israela kashu kasha ni mung Yehowa matsun maroi madat let, bu lam n hkawm ai nga nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kalang lang sumpan sum ntsa e sumwi dai gaw nhtoi gade ya n jung nga ai; shing rai shanhte Yehowa hkang dat ai hte maren but de ma ai; bai Yehowa hkang dat ai hte maren hkawm sa wa ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kalang lang sumwi dai gaw shana de nna jahpawt du hkra jung nga nna, jahpawt e dawm mat wa jang, shanhte hkawm sa wa ma ai: shani shana galoi rai timung sumwi dawm mat jang shanhte hkawm sa wa ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni ni sha rai timung, shata mi rai timung, shaning ting rai timung, sumwi dai sumpan sum ntsa e ajung nga dingsa, Israela kashu kasha ni gaw bu lam n hkawm ai sha, but de nga ma ai: sumwi dawm mat wa jang, shanhte hkawm sa wa ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa hkang dat ai hte maren shanhte but de ma ai; bai Yehowa hkang dat ai hte maren shanhte hkawm sa wa ma ai: Mawshe a n-gup hta Yehowa hkang dat ai lam madat let Yehowa a matsun maroi shanhte hkan nang ma ai.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Shawa hpung hpe jahpawng yang dum na matu mung, gumhpraw hte pahke lahkawng dup u: dai hpe n matut ai sha dup la na rai ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pahke lahkawng yan dum dat yang, shawa hpung ting gaw, shawa sum chyinghka de nang kaw sa zup lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pahke langai sha dum yang gaw, Israela amyu hta masha hkring mun a du agyi ni nang kaw sa zup na rai ma ai,
  </para>
  <para style="p">
    <verse number="5" style="v" />Awn ai hku dum dat jang sinpraw dap ni rawt na rai mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bai lahkawng lang na hta awn ai hku dum jang dingda dap ni rawt na rai ma ai: shing rai awn ai hku dum jang, dap langai hte langai rawt na rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shawa hpung ting hpe jahpawng na rai jang gaw awn ai hku n re ai sha dum na rai myit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Arun a shadang sha, hkinjawng ni gaw, dai pahke dum na rai mu ai: dai gaw nanhte a shu mashi shu masha prat dingsa hkan nga na tara rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte tinang a mungdan hta nga nga yang, nanhte hpe gasat sa ai hpyen ni hpang de hpyen rawt yang, dai pahke hpe awn ai hku nanhte dum na rai myit dai: shaloi nanhte a Karai Kasang Yehowa nanhte hpe myit dum nna, hpyen ni a lata na, nanhte hkye hkrang la ai lu la na rai myit dai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nanhte a kabu gara shani hta mung, madat da ai poi shani hta mung, shata praw shani hta mung, nanhte a Karai Kasang nanhte hpe dum nga na matu, nanhte a wan nat hkungga ni, nanhte nawng ai mahku hkungga ni hta pahke dum na rai myit dai: ngai gaw nanhte a Karai Kasang Yehowa rai nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ya ni ning shaning, shata lahkawng a nhtoi hkun ya du ai shani hta sumwi gaw sakse sumpan sum a ntsa na dawm mat wa ai rai nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />Israela kashu kasha ni gaw Sina bum kaw nna htawt hkawm sa wa ma ai; bai dai sumwi gaw Paran nam e jung nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shing rai shanhte hkawm ai gaw, Yehowa Mawshe hpe hkang da ai hku, shawng hkawm hpang ai lang rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yuda dap a hpung daw wa ni gaw tinang a dawnghkawn hte rau shawng e rawt sa wa ma ai: dai dap a agyi gaw Aminadab a kasha Nashon rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yishahka dap na hpung daw wa a agyi gaw, Zua a kasha Nehtanela rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zebulun dap na hpung daw wa a agyi gaw Helon a kasha Elisha rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang sumpan sum run nna, dai sumpan sum gun hpai ai Gershon a kashu kasha ni hte Merari a kashu kasha ni sa wa ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai Rubin dap a hpung daw wa ni gaw tinang dawnghkawn hte rau rawt sa wa ma ai, dai dap a agyi gaw Shedura kasha Elizura rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Simun dap na hpung daw wa a agyi gaw Zurishadi a kasha Shelumila rai nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gad dap na hpung daw wa a agyi gaw, Duela kasha Eliasap rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai hpang Kohat masha ni gaw, chyoi pra ai nta a arai ni hpai nna rawt sa wa ma ai: shanhte garai n du yang shawng na ni gaw sumpan sum sharawt shadun magang ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai Ehprim dap a hpung daw wa ni gaw tinang a dawnghkawn hte rau rawt sa wa ma ai: dai dap a agyi gaw Amihu a kasha Elishama rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Manashe dap na hpung daw wa agyi gaw Pedazura a kasha Gamalela rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ben-yamin dap na hpung daw wa agyi gaw Gidoni a kasha Abidan rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hpang, dap yawng a hpang jahtum dap ngu na Dan dap a hpung daw wa ni gaw tinang a dawnghkawn hte rau rawt sa wa ma ai: dai dap a agyi gaw Amishadi a kasha Ahiza rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ashe dap na hpung daw wa agyi gaw Ohkran a kasha Pagila rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Naphtali dap na hpung daw wa agyi gaw Enan a kasha Ahira rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai Israela kashu kasha ni gaw hpung mi a hpang hpung mi rai rawt nna, shanhte hkawm sa wa ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi Mawshe gaw shi a katsa Midian masha Reuela a kasha Hoba hpe, Ya anhte gaw Yehowa a ga hte maren anhte hpe jaw na nga ai mung de sa wa nga ga ai: nang mung anhte hte rau sa wa ga; anhte nang hpe chyeju jaw na ga ai: Yehowa gaw Israela hpe chyeju jaw na lam ga ndat tawn da nu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hoba chyawm gaw, “Ngai n hkan na nngai; nye a buga, nye a baw sang ni hpang de she ngai wa na nngai,” ngu nna Mawshe hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bai Mawshe gaw,” Anhte hpe kau da nna hkum wa mat et; dai nam mali hkan e anhte kanang kaning rai but na gaw nang she chye ndai; dai majaw nang sha anhte a myi tai na rai nga ai:
  </para>
  <para style="p">
    <verse number="32" style="v" />shing rai nang anhte hte rau sa n yang gaw, Yehowa anhte hpe chyeju jaw ai hte maren, nang hpe mung anhte gaja wa chyeju jaw na ga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shing rai shanhte gaw Yehowa a bum na pru nna, masum ya sat ai kaw du hkra hkawm sa wa ma ai: dai masum ya sat ai lam hta sa wa nga yang, Yehowa a sakse sumpu gaw shanhte but na shara tam let, shanhte a shawng e sa wa nga ai,
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte dap sharawt nna shani e sat sa wa nga yang, Yehowa a sumwi gaw shanhte a ntsa e anga nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ya dai sumpu sa wa jang Mawshe gaw, “Yehowa e, rawt u, nang hpe hpyen ai ni poi mat mu ga law; Nang hpe n dawng ai ni na a man e htaw mat mu ga law,” ngu nna tsun tsun rai wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Bai dai sumpu sa nga ai rai jang, shi gaw, “Yehowa e, Israela masha hkying mun nga ai de nhtang wa rit law,” ngu nna tsun tsun rai wu ai.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya dai amyu masha ni gaw aput apai nga nna, Yehowa a na hta n shawp ai ga tsun ma ai: Yehowa dai na jang masin pawt bu nna, Yehowa a wan shanhte hta grung wa ai hte dap shingnawm e hkru mat wa ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi amyu masha ni gaw Mawshe hpe jahtau mu ai rai nna, Mawshe mung Yehowa hpe hpyi ya ai hte wan si mat wa ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai yang e Yehowa a wan shanhte hta hkru wa ai majaw, dai shara hpe Tabera ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya shanhte hta lawm nang wa ai kayau kaya re ai amyu masha ni gaw grai marit nga ma ai: Israela kashu kasha ni mung bai hkrap nna, “Anhte sha na shan kadai jaw sana i?
  </para>
  <para style="p">
    <verse number="5" style="v" />Egutu mung e pagawn sha lu ai anga, kumgyin, gyinshau, gaubawng, shakau, hparaw re ai ni anhte dum ga ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />ya gaw anhte myit gawng run mat saga ai: ndai manna hta kaga hpa mung n mu yu saga ai,” nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Manna ngu ai gaw hpakgyi tum zawn rai nna ahpraw gaw bedela si a tum nsan nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amyu masha ni gaw dai sa tam magawn la nna, htumrin hta rin ai gaw rin, kaihtum hta htu ai gaw htu rai nhtawm dibu hta shadu nna muk pa galaw ma ai: dai gaw namman katsing zawn nga mu nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte but de ai shara e shana na mari hkrat ai hta manna hkrat kahtap htap rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ya amyu masha ni htinggaw shagu hta tinang a sum chyinghka lam e hkrap nga ma ai gaw Mawshe na wu ai: Yehowa mung masin grai pawt bu ai rai nna, Mawshe gaw myit yu machyi nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Mawshe Yehowa hpe, “Nang na a mayam wa ngai hpe hpa majaw ning rai shayak nga n ta? ndai amyu yawng a lit ngai gun hpai na gaw, ngai na a man e hpa myi man n pa shara nga a ta?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ndai amyu hpe shanhte a kaji kawa ni hta nang dagam da ai mung de, Ma kawa gaw ma chyangai hpe pawn ai zawn shanhte hpe pawn wa u, nga nna nang ngai hpe tsun na gaw, shanhte hpe nye a hkritung e gun we ni? ngai shanhte hpe shangai mawe ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ndai ni nlang hpe jaw sha na shan, ngai kanang na lu la na rai ta? Shanhte gaw, “Anhte sha na shan, jaw mi,” nga nna hkrap let ngai kaw hpyi nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ndai ni nlang hpe ngai hkrai sha n dang gun we ai; gun na lit nau li la li ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai hpe ndai hku she di na rai yang mung, na a man e myi man pa nngai rai yang mung, nye a ruyak hpe ngai n dum n ga, ngai hpe sat kau e,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Yehowa Mawshe hpe tsun wu ai gaw, “Nang chye ai salang hte amyu masha ni a du gyi ni marai sanit shi hte hpe Israela hta na jahpawng la nhtawm, shawa sum de woi wa nna nang hte rau shatsap tawn ru.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shaloi ngai yu sa nna, dai yang e nang hte ga matut na ring ngai: nang hta dung ai Wenyi hta na ngai la nna shanhte a ntsa e mara ya na we ai; ndai amyu a lit nang chyu sha gun hpai na n rai, shanhte nang hpe gun hpai karum na rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amyu masha ni hpe mung nang ning ngu tsun u: “Hpawt ni nhtoi na matu tinang hkum hpe shachyoi shapra da mu; nanhte shan lu sha na marin dai; kaning rai nme law, kadai wa anhte hpe shan jaw sha sana i? Egutu mung e nga yang gaw anhte mu mu mai mai nga lu ga ai le, nga nna Yehowa a na hta nanhte hkrap ai ga majaw, shi nanhte hpe shan jaw sha na ra ai rai nna, nanhte sha lu na marin dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lani, ni ni, manga ya, shi ya, hkun ya sha n rai,
  </para>
  <para style="p">
    <verse number="20" style="v" />nanhte a ladi hta manam pru nna ajin anang nga hkra shata mi tup sha lu na myit dai: kaning rai nme law, Nanhte hta rawng nga ai Yehowa hpe nanhte n hpu n lu nga nna, Egutu mung na anhte hpa rai pru wa ga ai i? nga nna shi a man e hkrap myit dai, ngu mi,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi Mawshe gaw, “Nye a masha ni wa-ngan hkrai sen kru ting rai ma ai mi, nang gaw, Shata mi tup na matu shanhte hpe ngai shan jaw sha na, nga lu n hka i?
  </para>
  <para style="p">
    <verse number="22" style="v" />shanhte hpe hkru hkra jaw sha na gaw, sagu bainam, dumsu hpung gade sat na rai ta? shing n rai, nammukdara na nga yawng ting wa shanhte hpe shajawng ya na wu ni?” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi Yehowa Mawshe hpe, “Yehowa a lata gadun li ni? nye a ga tup n tup gaw ya nang mu na rin dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Mawshe pru nna amyu masha ni hpe Yehowa a ga htawn tsun wu ai: amyu masha ni a agyi salang sanit shi hte hpe mung jahpawng la nhtawm dai Sum grup e shade tawn wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa mung dai sumwi hta yu hkrat nna shi hte ga tsun nga ai; Mawshe hta dung ai Wenyi hta na la nhtawm agyi salang sanit shi hte a ntsa e mara ya wu ai rai nna, dai Wenyi shanhte hta yu dung jang shanhte gaw myihtoi htoi ma ai; dai hta kaga hpa n tsun ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hpung hta lawm ai Eldad hte Medad mying ai marai lahkawng gaw, jahpan hta lawm timung Sum de n sa ai sha dap e anga nga ma ai; dai yan hta mung Wenyi yu dung nna, shan gaw dap kata e myihtoi htoi ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shaloi shabrang langai mi gat sa nna, “Eldad yan Medad gaw dap kata e myihtoi htoi nga ma ai,” ngu nna Mawshe hpe tsun dan wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai hpe, Mawshe san da sai shi a hkringmang Nun a kasha Yawshu gaw, “Nye a madu e, shan hpe hkum kau u,” ngu nna Mawshe hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mawshe chyawm gaw, “Nye a matu nang manawn ya nni? Yehowa a masha nlang hte gaw myihtoi hkrai rai nga mu ga, Yehowa gaw shi a Wenyi shanhte a ntsa e mara jaw mu ga law!” nga nna tsun ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Mawshe hte Israela agyi salang ni dap de bai wa ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Yehowa nbung shabung dat nna, nammukdara de na u preng shapoi la nhtawm, dai dap a grup yin lani sat sat gang ai shara du ai hte ga hta dawng lahkawng htat hkra jahkrat ya mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shaloi amyu masha ni gaw dai shani tup, dai shana tup, hpang shani tup u preng sa magawn ma ai: n law hta htum sai wa homa shi magawn la lu wu ai; dai dap grup yin shara shagu hkan e, dai u preng shan shanhte lam shajang da mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rai timung u preng shan dai garai n mayu yang, dai amyu masha ni hpe Yehowa pawt bu nna nachying yak ai zinli hte ari jaw mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai rai nna, myit marit ai masha ni hpe dai yang e lup makoi mu ai majaw, shara dai hpe Kibrot-hatawa ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ya, amyu masha ni gaw Kibrot-hatawa kaw na htawt nhtawm, Hazerot de du ma ai; shing rai shanhte Hazerot e nga nga ma ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Mawshe gaw Hkusha amyu num la wu ai rai nna, dai Hkusha num a majaw, Miriam yan Arun gaw Mawshe hpe mara shagun nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Gaja wa Yehowa gaw Mawshe hta sha ga tsun lu ai re a hka? an a n-gup hta mung tsun sai n rai ni?” nga ma ai. Ga dai hpe Yehowa na wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai Mawshe ngu ai wa chyawm gaw, ga ntsa ting na masha nlang hta myit grau sumnung ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Yehowa gaw, “Nanhte masum shawa sum de sa yu marit,” nga nna Mawshe, Arun, Miriam hte hpe alawan shaga wu ai rai nna, shanhte masum pru sa wa ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa mung sumwi hte yu sa nna, dai Sum a chyinghka lam e tsap let Arun yan Miriam hpe shaga wu ai: shan mung sit sa wa ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Yehowa gaw, “Nye a ga madat yu mu: nanhte hta myihtoi nga ai rai yang, ngai Yehowa dai wa hta shingran hte nye hkum madun na rai nngai;
  </para>
  <para style="p">
    <verse number="7" style="v" />rai timung, nye shangun ma Mawshe gaw dai hku n rai; shi gaw nye a nta ting hta kangka re ai wa rai nga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />shi hta ngai ga tsun yang gumwai ga hku ngai n tsun, ngai hkum nan hkra dan dan leng leng tsun na we ai; shi gaw Yehowa a hkrang mung mu lu na rai nga ai: dai rai nna, nye a shangun ma wa Mawshe hpe hpa rai mara shagun rip myit ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing nga nhtawm Yehowa shan hpe masin pawt nna lung mat wa ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sumwi mung Sum na dawm mat wa ai; shaloi jang, yu u, Miriam hta Manggang kap nna hkyen zawn hpraw nga ai; Arun mada yu nna Miriam hta manggang gang ai mu jang,
  </para>
  <para style="p">
    <verse number="11" style="v" />Arun gaw Mawshe hpe, “Nye a madu e, an ngawk nna shut kau ai majaw, an a shut ai mara an hta hkum mara ya mi ngai hpyi nem nga nngai;
  </para>
  <para style="p">
    <verse number="12" style="v" />shangai ai kaw nna hkum shan chyen mi yat mat ai chyasi zawn wa gaw shi hta hkum rai u ga law,” ngu nna nem wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Mawshe gaw, “Karai Kasang e, shi hpe shamai ya u,” ngu nna Yehowa hpe jahtau wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa mung, “Shi a kawa e shi a myi man hta mayen sha mahtaw bun ya ai hte pyi, sanit ya tup kaya hkrum nga na n rai ni? ya shi hpe sanit ya tup dap shinggan e sa nga shangun u; dai hpang she bai shang shangun u,” ngu nna Mawshe hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai, Miriam hpe dap shinggan e sanit ya tup tawn da kau mu ai; Miriam dap de garai n shang dingsa amyu masha ni mung bu n hkawm ai nga nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hpang amyu masha ni gaw Hazerot shara na htawt nna Paran mali e but de nga ma ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe ngai jaw na Hkanan mung hpe kin-yu sa yu na matu, amyu lakung shagu hta na du agyi tai ai ni hpe, amyu mi hta na langai langai lata la nna, shangun dat u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai Yehowa a ga hte maren, Mawshe gaw Paran mali kaw nna kin-yu masha shangun dat wu ai: shangun dat ai ni yawng gaw, Israela kashu kasha ni hta na du agyi ni hkrai rai ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a amying gaw, Rubin amyu hta na Zahkura a kasha Shammua.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simun amyu hta na Hori a kasha Shahpat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yuda amyu hta na Yehpuna a kasha Hkaleb.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yishahka amyu hta na Yawsep a kasha Igala.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ehprim amyu hta na Nun a kasha Hoshea.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ben-yamin amyu hta na, Rahpu a kasha Palti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebulun amyu hta na Sodi a kasha Gadiela.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yawsep amyu Manashe lakung hta na Susi a kasha Gadi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan amyu hta na, Gemali a kasha Amiela.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ashe amyu hta na Mihkaela a kasha Sehtura.
  </para>
  <para style="p">
    <verse number="14" style="v" />Naphtali amyu hta na Wopsi a kasha Nabi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad amyu hta na Mahki a kasha Guela hte rai ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai gaw Hkanan mung kin-yu sa yu na matu, Mawshe shangun dat ai ni a amying rai nga ai. Mawshe chyawm gaw Nun a kasha Hoshea hpe Yawshu ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing rai Mawshe gaw Hkanan mung hpe kin-yu sa yu na matu shanhte hpe shangun dat nna, Ya nanhte dingda maga lam hku sa wa nna, bum ga de lung wa masu:
  </para>
  <para style="p">
    <verse number="18" style="v" />dai mung gaw kaning re ai mung re ai yu da mu; mung masha ni n-gun ja ma ai, n ja ma ai; law ma ai, n law ma ai;
  </para>
  <para style="p">
    <verse number="19" style="v" />shanhte nga ai mung gaw kaja malu ai kun, n kaja malu ai kun; shanhte nga ai mare ni gaw kaning re ai mare rai malu ai kun; janghpang sum hta, shing n rai bunghku kum ai mare hta nga ma ai kun;
  </para>
  <para style="p">
    <verse number="20" style="v" />dai mung na lamu ga gaw hpun rawng malu ai kun, n rawng malu ai kun; nam maling law ai kun, n law ai kun, yu wa marit. Nden ja ai myit hte sa wa mu; dai mung na namsi loi mi mung la wa yu mi, ngu nna hkang dat mu ai. Dai ten gaw tsabyi si nnan myin wa ai aten rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai shanhte gaw Zin ngu ai mali kaw nna, Hamat mare pru ai lam na Rehab mare du hkra, Hkanan mung hpe kin-yu lung yu ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai shanhte dingda maga hku jawt hkawm wa nna, Hebron mare de du ma ai; dai yang e Anak a kashu kasha Ahiman, Sheshai, Talmai ni nga ma ai: Hebron mare chyawm gaw, Egutu mung na Zoan mare garai n de yang sanit ning a shawng e de sai rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi shanhte Eshkola kadit du nna, asi sumbaw ai tsabyi lakung langai mi dan la nna, marai lahkawng dai hpe shingtau hpai ma ai; hkainu si hte maihpang si mung shanhte la wa ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Israela kashu kasha ni dan la ai tsabyi sumbaw hpe hkan nna dai kadit hpe Eshkola ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya shanhte gaw, nhtoi mali shi ya rai jang, dai mung hpe kin-yu yu ngut nna bai wa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai wa ma yang shanhte gaw Mawshe yan Arun hte Israela kashu kasha hpung ting nga ai Paran mali Kadesha ngu ai shara de du wa nna, dai yan hte shawa hpung ting hpe shiga tsun dan let, dai mung na namsi ni madun dan mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shing rai shanhte gaw Mawshe hpe, “Nang anhte hpe shangun dat ai mung de anhte du saga ai; gaja wa dai mung gaw nga chyu hte lagat jahku lwi ai mung nan rai nga ai; namsi ndai ni gaw dai mung e si ai namsi rai nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Rai timung, dai mung na masha ni gaw n-gun ja ai hkrai rai ma ai: mare ni mung, bunghku kum ai hte grai kaba malu ai; dai hta n-ga Anak a amyu masha ni hpe mung anhte mu da sagaw ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amalek masha ni gaw dingda maga de; Hiti, Yebusi, Amori masha ni gaw bum ga hkan e; Hkanani masha ni gaw nammukdara makau hte Yawdan hkan kau hkan e nga nga ma ai,” ngu nna tsun dan mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shaloi Hkaleb gaw, “Sa, ya jang rawt nna dai mung hpe lung madu la sagaw; a dang kau lu na ga ai,” nga nna Mawshe a man e amyu masha ni hpe jasim wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi a manang gale ni chyawm gaw, “Dai mung masha ni hpe anhte n dang lu law; shanhte anhte hta n-gun grau ja nga ma ai mi,” nga ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bai shanhte gaw, “Anhte sa yu ai mung gaw, tinang a mung masha ni hpe sha kau ai mung rai nga ai: dai hta anhte mu ai masha yawng gaw hkumhkrang galu kaba ai hkrai rai ma ai:
  </para>
  <para style="p">
    <verse number="33" style="v" />Nehpelim ngu ai amyu hta na prat ai Anak a kashu kasha Nehpelim masha ni hpe mung anhte mu da sagaw ai: shanhte a man e anhte gaw hkagrit hkadawn zawn she nawn ai wa rai nga ai; shanhte mung anhte hpe dai zawn sha a nawn kau na mi ai,” nga nna tinang sa yu da ai mung a lam Israela kashu kasha ni hpe shiga chyahten wa tsun dan mu ai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi dai shawa hpung yawng tinang a nsen shaja nna jahtau shabam ma ai; amyu masha ni dai shana tup hkrap nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela kashu kasha ni yawng gaw Mawshe yan Arun hpe aput apai nga nna, dai shawa hpung ting shan hpe, “Anhte Egutu mung e si mat ga taw le: shing n rai, ndai nam mali hkan e si mat ga taw le:
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa gaw anhte hpe ri nhtu hta si hkra, hpa majaw ndai de woi wa mi ai i? anhte a num ni hte ma chyangai ni gaw lanep tai ma na masai; Egutu mung de bai nhtang wa yang grau mai ai n rai ni?” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai shanhte gaw, “Marai langai ngai hpe anhte agyi shatai la nna Egutu mung de nhtang wa saga,” nga nna shada da tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna Mawshe yan Arun gaw Israela kashu kasha ni a shawa hpung nlang a man e dingnyawm dagup nna nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai mung hpe kin-yu lung yu ai ni hta na Nun a kasha Yawshu hte Yehpuna a kasha Hkaleb chyawm gaw tinang a hpun palawng gang je kau nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />Israela kashu kasha ni a shawa hpung ting hpe, Anhte kin-yu lung yu ai mung gaw nachying kaja ai mung rai nga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa anhte hpe tsawra yang gaw, dai nga chyu hte lagat jahku lwi ai mung de, anhte hpe woi shawn nna madu shangun na mi ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai re ai majaw Yehowa hpe hkum gumlau myit; dai mung na masha ni hpe mung hkum hkrit myit; shanhte gaw anhte a shat sha tai na ra ai: shanhte hta makawp maga n nga malu ai; anhte hpang de chyawm gaw Yehowa nga nga ai; shanhte hpe hkum hkrit myit,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shawa hpung ting chyawm gaw shan hpe nlung hte kabai sat na maw ma ai. Shaloi jang Yehowa a hpung shingkang gaw, Israela kashu kasha ni yawng a man e dai shawa sum hta dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shaloi Yehowa Mawshe hpe, “Ndai amyu gaw gaten du hkra ngai hpe n gawn n sawn rai nga na ma ta? shanhte hta ngai madun ai lamik kumla ni hpe mu lu ninglen gaten du hkra ngai hpe naw n kam na ma ta?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ana zinli hte ngai shanhte hpe ari jaw nna shanhte a sali wunli dawm la ya nhtawm, shanhte hta grau kaba nna hpung shingkang grau rawng ai amyu ngai nang hpe shatai na de ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Mawshe Yehowa hpe, “Nang na a nsam kaba hte ndai amyu hpe Egutu masha ni a kata na shaw wa nit dai rai nna, shanhte ndai lam na yang, ndai mung na masha ni hpe bai htawn shana na maru ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />nang Yehowa ndai amyu a ka-ang e nga nga ndai mung, nang Yehowa anhte hte myi man chyaw rai nga ai mung, na a sumwi anhte a ntsa e ka-up nga ai mung, nang gaw shani e sumwi shadaw hta, shana e wan shadaw hta shanhte a shawng e sa wa ndai mung, ndai ga na masha ni na yu masai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ya ndai amyu hpe masha langai e sha zawn nang sat kau dam yang gaw, na a shi na yu sai masha amyu ni gaw,
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa dai masha ni hpe, shi jaw na nga nna dagam da ai mung de, n jashawn lu wu ai majaw, nam mali e shanhte hpe sat kau da wu ai, nga nna tsun shajang na mara ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai re ai majaw, Yehowa gaw myit galu kaba ai hte matsan dum n-gaw nwai rawng ai wa, yubak hte tara tawt lai ai lam hpe raw dat kau ya timung, mara lu ai wa hpe kaman san san n dat kau ai sha, kawa ni a yubak kasha ni hta prat masum prat mali du hkra, htang jaw nga ai wa,
  </para>
  <para style="p">
    <verse number="18" style="v" />rai nga ai hte maren, nang Madu a hpung shingkang galu kaba nga u ga:
  </para>
  <para style="p">
    <verse number="19" style="v" />na a galu kaba ai matsan dum myit hte mung, Egutu mung na ndai amyu hpe shapraw wa ai kaw nna ya du teng shanhte a mara raw dat kau ya nga ndai hte maren mung, ndai amyu a mara ya bai naw raw dat kau ya u,” ngu nna hpyi nem wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi Yehowa gaw, Nang hpyi ai hte maren ngai raw dat ni ai:
  </para>
  <para style="p">
    <verse number="21" style="v" />rai timung, ngai ahkrung nga nngai rai nna, Yehowa a hpung shingkang ga ntsa ting dan hkung nga ai hte maren,
  </para>
  <para style="p">
    <verse number="22" style="v" />Egutu mung kaw nna, ndai nam mali du hkra nye a hpung shingkang hte ngai madun ai lamik kumla ni hpe mu lu ai ni nlang hte gaw, nye a ga n madat ai, ya shi lang du hkra ngai hpe dinglik mi ai majaw,
  </para>
  <para style="p">
    <verse number="23" style="v" />shanhte a kaji kawa ni hpe ngai jaw na ngu dagam da ai mung hpe, gaja wa teng teng n mu lu na ma ai; ngai hpe n gawn n sawn re ai ni langai mi muk dai hpe mu lu na n rai.
  </para>
  <para style="p">
    <verse number="24" style="v" />nye a shangun ma Hkaleb chyawm gaw, kaga re ai myit masin rawng ai hte nye a hpang htep lahti hkan nang ai majaw, shi kabye yu sai mung de ngai woi shawn nna, shi a kashu kasha ni dai hpe madu lu na mara ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ya, Amalek masha ni hte Hkanani masha ni pa ga de nga nga ma ai majaw, hpawt ni rawt nna, nawng hkyeng lam hku nam mali de bai nhtang kayin sa wa mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai Yehowa Mawshe yan Arun hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Ngai hpe aput apai nga ai, ndai n hkru ai shawa hpung hpe galoi du hkra ngai sharang nga na rai ta? Israela kashu kasha ni ngai hpe aput apai nga ai gaw ngai na se ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte hpe ning ngu tsun u, ‘Yehowa da nga yang, ngai ahkrung nga nngai hte maren, nanhte ngai hpe na hkra tsun ai hku, nanhte hpe ngai di na made ai:
  </para>
  <para style="p">
    <verse number="29" style="v" />nanhte a si mang ni ndai nam mali hkan e hti nga mat na masalit dai; ngai hpe aput ai ni hta na, jahpan hta hti lawm ai asak hkun ning lai ai ni nlang hte gaw,
  </para>
  <para style="p">
    <verse number="30" style="v" />Nanhte hpe ngai madu shangun na ngu nna ngai dagam da ai mung de, Yehpuna kasha Hkaleb hte Nun a kasha Yawshu hta kaga kadai mung gaja wa du lu na n rai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Masha hpyen ni a lanep sha tai na masai, nga nna nanhte tsun ai ma chyangai ni hpe ngai woi shawn nna, nanhte yen kau da ai mung hpe shanhte chye na mara ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nanhte chyawm gaw, nanhte a si mang ni ndai nam mali hkan e hti nga mat na masalit dai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nanhte a si mang ni ndai nam mali e nyawp mat ma hkra, nanhte a kashu kasha ni gaw, nanhte gumlau ai yubak gun nna ndai nam e mali shi ning tup kayin hkawm nga na masai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai mung hpe kin-yu yu ai nhtoi mali shi ya re ai hte maren, lani mi hpe laning mi shatai nna, mali shi ning tup, tinang a yubak gun let, nye e kabai kau ai chye lu na manit dai.'
  </para>
  <para style="p">
    <verse number="35" style="v" />Ngai Yehowa ning nga nga nngai: gaja wa teng teng ngai hpe gumlau ai, ndai n hkru ai shawa hpawng hpe shing di na we ai; ndai nam mali hkan e shanhte si mat na masai; ndai yang e nyawp mat na masai, nga ai, ngu mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai mung hpe kin-yu yu na Mawshe shangun dat ai masha ni hta, bai wa nna dai mung a lam ga chyahten wa tsun ai hte shawa hpung nlang hpe aput shangun ai ni ngu ai,
  </para>
  <para style="p">
    <verse number="37" style="v" />Hkanan mung a shiga chyahten tsun ai ni gaw, Yehowa a man e ana zinli hte si mat ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dai mung hpe kin-yu sa yu ai ni hta na Nun a kasha Yawshu hte Yehpuna a kasha Hkaleb yan chyawm gaw hkrung nga ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ndai ga yawng hte hpe Mawshe gaw Israela kashu kasha ni hpe htawn shana wu ai rai nna, amyu masha ni grai wa yawn nga ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bai shanhte gaw jahpawt jau jau rawt nna, “Anhte shut saga ai; rai timung, anhte jin jin rai nga ga ai; Yehowa ndat da ai mung de anhte sa wa na ga ai,” nga nna bum de lung wa ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mawshe chyawm gaw, “Yehowa aga hpa rai tawt nga myit ta? nanhte galaw ai hku byin lu na n rai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hkum sa myit; Yehowa nanhte hte rau n rai malit dai; sa wa taw gaw, hpyen ni a man e nanhte sum na marin dai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amalek masha ni hte Hkanani masha ni, nanhte garai n du yang nna nga nga sai majaw, nanhte nhtu hte si na myit dai: Yehowa kaw na le mat wa ai majaw Yehowa nanhte hte rau n nga malit dai,” ngu mu timung,
  </para>
  <para style="p">
    <verse number="44" style="v" />shanhte gaw tinang myit shaja la nna bum de lung wa ma ai: rai timung Yehowa a ga shaka sumpu hte Mawshe gaw dap na n pru ai nga nga ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shaloi bum ga de nga ai Amalek masha ni hte Hkanani masha ni pru sa nna, shanhte hpe gasat dang kau ai hte Horma mare du hkra hkan shachyut mu ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela kashu kasha ni hpe ning ngu tsun mu, “Ngai nanhte hpe jaw na mung de nanhte du myit yang,
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa a matu wan nat hkungga, shing n rai hkungga amyu gale ngu na, ga shaka da yang jaw jau ai hkungga, mayu a jau ai hkungga, madat da ai poi hta jaw jau ai hkungga re ai ni hpe, dumsu hte rai timung, sagu bainam hte rai timung, Yehowa a manam pyaw sangau tai na matu jaw jau mayu myit yang;
  </para>
  <para style="p">
    <verse number="4" style="v" />hkungga jaw jau ai wa gaw, Yehowa a matu wan hte nat ai hku rai timung, gale hkungga hku rai timung, sagu kasha nawng jau ai rai yang hkungga hkum hte hpawn, shadung kumhpa ngu na namman loga mali hte kayau ai mani ai shadung uma mi ma,
  </para>
  <para style="p">
    <verse number="5" style="v" />ru hkaw hkungga di na tsabyi jahku loga masum ma, lajang nna la sa na rai wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sagu la rai yang gaw, Yehowa a matu manam pyaw ai baw ngu ai, shadung kumhpa di na, namman loga masum hte kayau ai mani ai shadung uma lahkawng ma;
  </para>
  <para style="p">
    <verse number="7" style="v" />ru hkaw kumhpa di na tsabyi jahku loga masum ma, lajang nna nawng na rai wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa hpe ga shaka da yang, shing n rai mahku hkungga jaw yang, Yehowa a matu manam pyaw sangau tai na,
  </para>
  <para style="p">
    <verse number="9" style="v" />wan hte nat jaw ai hku rai timung, gale lam hku jau na rai timung, usu langai mi nawng na rai yang gaw, dai usu hte hpawn shadung kumhpa di na namman loga kru hte kayau ai mani ai shadung uma masum ma;
  </para>
  <para style="p">
    <verse number="10" style="v" />ru hkaw kumhpa di na tsabyi jahku loga kru ma, lajang nna nawng jau na rai wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai usu raitim', sagu la raitim', sagu la kasha raitim', bainam kasha raitim', hkungga hkum mi nawng yang dai hku nawng jau na rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mazing shading tawn ai hkungga hkum gade rai yang, gade a matu shing rai nawng na rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mung masha ni yawng hte gaw Yehowa a matu manam pyaw sangau shatai na, wan hte nat jau yang, shing rai galaw na rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nanhte kaw sa manam ai tsasam wa rai timung, nanhte hta prat mi hte prat mi shingbyi nga ai wa kadai mung, Yehowa a matu manam pyaw sangau shatai na nga, wan hte nat jau mayu yang gaw, shi mung nanhte galaw ai hku galaw na rai wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shawa hpung shang ai lam hta, nanhte hte nanhte kaw sa shingbyi nga ai manam wa gaw, nanhte a shu mashi shu masha prat dingsa htung hking langai sha rai nga na rai nna, Yehowa a man e nanhte rai nga ai zawn, shingbyi nga ai wa mung rai nga na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanhte hkum nan hte nanhte kaw sa shingbyi nga ai wa gaw, tara langai sha, htung hking langai sha rai nga na rai myit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Israela kashu kasha ni hpe ning ngu tsun u, ‘Ngai nanhte hpe woi wa ai mung de nanhte du wa nna,
  </para>
  <para style="p">
    <verse number="19" style="v" />dai shaloi, Yehowa hpe manawt kumhpa sa jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shawng gumrin ai shadung katsing hte galaw ai muk pa hpe manawt kumhpa di nna, chyarang na manawt kumhpa manawt jau ai zawn, dai hpe manawt na rai mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nanhte a shu mashi shu masha prat dingsa hta shawng gumrin ai shadung katsing hta na manawt kumhpa Yehowa hpe sak jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bai, Yehowa Mawshe hta tara hkang dat ai shani kaw nna, nanhte a shu mashi shu masha prat dingsa,
  </para>
  <para style="p">
    <verse number="23" style="v" />Mawshe a n-gun hte nanhte hpe hkang da ai tara ni hpe nanhte tawt lai kau ai lam hta,
  </para>
  <para style="p">
    <verse number="24" style="v" />shawa hpung yawng hte gaw n dum shami shut hpyit kau nna mara rawng ai rai yang, shawa hpung nlang hte gaw, tawn da sai htung hking nga ai hte maren, Yehowa a matu manam pyaw sangau shatai na, shadung kumhpa hte ru hkaw kumhpa hte hpawn, usu uram hpe wan nat hkungga, bainam la hpe htingrai hkungga di nna nawng na rai mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shing rai hkinjawng wa mung Israela kashu kasha ni a shawa hpung nlang hte a matu htingrai htingrat ya na rai nna, shanhte n dum shami shut ai majaw yubak raw dat kau ya ai hkrum na rai ma ai: shanhte mung tinang a n dum shami shut ai mara matu, Yehowa e htingrai hkungga hte hpawn, wan hte nat jau na kumhpa, Yehowa hpang de la sa da na rai mu ai:
  </para>
  <para style="p">
    <verse number="26" style="v" />shing rai Israela kashu kasha ni nlang hte hte shanhte kaw shingbyi nga ai manam gaw yubak raw dat kau ya ai hkrum na rai ma ai; dai gaw amyu masha ni nlang a n dum shami shut ai mara sha rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai marai langai ngai n dum shami shut kau ai rai yang, htingrai hkungga di na matu ladu hkrum ai bainam yi langai mi nawng jau na rai wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai hkinjawng wa gaw, Yehowa a man e n dum shami shut ai wa a matu, htingrai htingrat ya na rai nna, shi gaw yubak raw dat kau ya ai hkrum na rai wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israela kashu kasha wa hte shanhte kaw shingbyi nga ai tsasam wa matu, n dum shami shut ai lam hta, tara langai sha rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Israela kashu kasha wa rai timung, amyu kaga wa rai timung, dingsa sa shut ai rai yang gaw, Yehowa hpe n gawn n sawn re ai rai nga ai majaw, dai wa gaw shi a amyu hta na sumri dan kau ya ai hkrum lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yehowa a mungga hpe n kaw n law di nna, shi a hkang da ai tara hpe tawt lai kau wu ai majaw, dai wa gaw shi a yubak hkam sha nna, teng teng gaja wa sumri dan kau ya ai hkrum na rai wu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ya, Israela kashu kasha ni nam e nga nga yang, laban nhtoi e hpun hta ai marai langai mi hpe mu hkrup mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mu ai ni gaw dai wa hpe Mawshe yan Arun hte shawa hpung nlang a man de woi wa mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rai timung, shi hpe jeyang na lam garai n dan ai majaw, naw hkum da mu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shaloi Yehowa Mawshe hpe, “Dai wa gaw teng teng sat kau ai hkrum na rai nga ai; dai shawa hpung ting, dap shinggan e nlung hte kabai sat na rai ma ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shing rai, Yehowa Mawshe hpe hkang da wu ai hte maren, shawa hpung nlang hte gaw dai wa hpe dap shinggan de woi shapraw nna, nlung hte kabai sat kau mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="38" style="v" />“Israela kashu kasha ni hpe ning ngu hkang dat mu; shanhte a shu mashi shu masha prat dingsa na ni gaw, tinang a hpun palawng matu gade de na jut a shingman hta sawm tsit ai ri hte banbyau byau na rai ma ai:
  </para>
  <para style="p">
    <verse number="39" style="v" />dai banbyau ni hpe nanhte mu jang, Yehowa tsun matsun dum ai hte hkan shatsup lu myit ga, shawng de tinang yit hte tinang ra ai hku hkan nna shut hkawm ai zawn, bai n hkan shut ai sha;
  </para>
  <para style="p">
    <verse number="40" style="v" />ngai hkang da mada dum ai hte hkan shatsup lu nna nanhte a Karai Kasang a matu chyoi pra nga lu hkra, shing rai galaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ngai gaw nanhte a Karai Kasang tai na ngu nna, nanhte hpe Egutu mung na woi shapraw wa ai nanhte a Karai Kasang Yehowa rai nga nngai: ngai nan nanhte a Karai Kasang Yehowa rai nga nngai,” ngu wu ai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Lewi amyu Kohat lakung hta na Izahara kasha Kora gaw, Rubin amyu Eliaba kasha Dahtan yan Abira hte, Pelet a kasha Ona hte hte bawng la nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />shawa hpung hta arawng sadang lu ai hte, dai hpung hta lawm ai, hpung agyi ngu na, Israela kashu kasha marai ni tsa e manga shi hte Mawshe hpe rawt gumlau mu ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />shanhte gaw Mawshe yan Arun kaw sa hpawng nna, “Nan gaw nau wa rai myit dai; dai shawa hpung ting na ni chyawm gaw chyoi pra ai hkrai rai nga ma ai; Yehowa mung shanhte hte rau rai nga ai: dai rai nna nan gaw Yehowa a shawa hpung ntsa e hpa rai tinang hkum shagrau la nga myit ta?” ngu mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mawshe gaw dai na jang dingnyawm dagup nga ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Kora hte shi hpang maga na ni hpe mung, “Kadai wa Yehowa a masha re ai mung, kadai wa chyoi pra nga ai mung, kadai wa hpe shi hpang de shani la na mung, hpawt de Yehowa madun na ra ai: shi lata la ai wa hpe shi hpang de shani la na ru ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />Kora hte shi hpang maga na ni yawng hte e, ning rai mu:
  </para>
  <para style="p">
    <verse number="7" style="v" />wan ban la nna, hpawt de Yehowa a man e wan hta lawban mara lang sa maru: shaloi Yehowa lata la ai wa gaw chyoi pra ai wa rai u ga; Lewi a kashu kasha ni e, nanhte nau wa rai nga myit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai Mawshe gaw Kora hpe, “Lewi a kashu kasha ni e, madat mu:
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte gaw Yehowa a sumpan sum a amu gun hpai lu nna, shawa hpung a man e tsap let shanhte a malai jaw jau ya lu hkra, Israela Karai Kasang gaw nanhte hpe shi hpang de shani la na nga, Israela shawa hpung hta na nanhte hpe jahka la nhtawm;
  </para>
  <para style="p">
    <verse number="10" style="v" />nang hkum hpe mung, na nhpu nnau Lewi masha yawng hte hpe mung, shi hpang de sit wa shangun ai chyeju hpe n gawn n sawn rai nga myit hka i? hkinjawng aya mung naw tam nga myit ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna, nang hte nang hpang maga na ni yawng, Yehowa hpe gumlau nga myit hka; Arun hpe shara na gaw shi hpa wa rai nga a ta?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi Mawshe gaw, Eliaba kasha Dahtan yan Abira hpe shaga na masha shangun dat wu ai: shan chyawm gaw, “An n lung na ga ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />ndai nam mali hta nang anhte hpe sat kau lu hkra, nga chyu hte lagat jahku lwi ai mung nna nang anhte hpe shapraw kau ai wa pyi n ram dum ai; ya mung anhte a ntsa e du agyi naw tai mayu n hka i?
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hta n-ga, nga chyu hte lagat jahku lwi ai mung de nang anhte hpe n woi wa; yi hkauna tsabyi sun sali mung n jaw re ai: ndai masha ni a myi baw kau ya mayu nni? an n lung na ga ai,” ngu nna htan dat mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi Mawshe masin grai pawt nna Yehowa hpe, “Ndai masha ni jau ai kumhpa hkum hkap la ya et; shanhte a lawze langai mi muk ngai n la ya nngai; shanhte hta na langai mi hpe muk ngai n zingri yu nngai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai Mawshe gaw Kora hpe, “Nang hte nang hpang maga na ni nlang hte gaw Arun hte rau hpawt de Yehowa man e nga nga mala:
  </para>
  <para style="p">
    <verse number="17" style="v" />nanhte langai hte langai tinang a wan ban la nna, lawban mara nhtawm, nanhte yawng a wan ban, ni tsa e manga shi Yehowa man de lang sa mu: nang hte Arun mung tinang a wan ban lang nga mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai shanhte langai hte langai tinang a wan ban la nna, wan hte lawban mara nhtawm, Mawshe yan Arun hte rau shawa sum chyinghka e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai Kora gaw, shan a man e shawa hpung nlang hte hpe shawa sum chyinghka e zuphpawng tawn mu ai: shaloi Yehowa a hpung shingkang gaw dai shawa hpung a man e dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Yehowa Mawshe yan Arun hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Ndai shawa hpung hpe ya jang ngai sat kau we ga, nan shanhte hte kaga kran rai nga mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shan chyawm gaw dingnyawm dagup let, “Karai Wa e, hkrung mahkrung a asak sumri shum ai Karai Kasang e, masha langai mi shut ai a majaw sha shawa hpung ting hpe masin pawt nga wu ni?” ngu nna hpyi nem mu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Kora, Dahtan, Abira hte a sum ni hpe hprawng yen mu, ngu nna shawa hpung hpe tsun u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Mawshe rawt nna Dahtan yan Abira hpang de sa wa ai: Israela agyi salang ni mung shi kaw hkan nang ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi shi gaw, “Ndai n hkru ai masha ni a sum ni hpe hprawng yen mu; shanhte a yubak hta nanhte n hten lawm myit ga, shanhte a arai lama mi hpe muk hkum hkra ya myit,” ngu nna shawa hpung hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai rai nna amyu masha ni mung, Kora, Dahtan, Abira hte a sum grup yin na hprawng yen mat ma ai: Dahtan yan Abira gaw shan a madu jan ni hte, shan a kasha kaji kaba ni hte rau pru nna, tinang nang a sum chyinghka e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi Mawshe gaw, “Ndai amu yawng mayawng nye a myit hte ngai galaw ai n rai; Yehowa shangun nna she galaw nngai gaw, nanhte kaning rai chye lu na nga yang:
  </para>
  <para style="p">
    <verse number="29" style="v" />shinggyim masha nga yawng danghta si wa ai hku she shanhte si, n-gawn shawa hkrum ai lam she shanhte hkrum yang gaw, Yehowa shangun dat ai wa ngai n rai nngai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai n rai, lam ningnan Yehowa hpan shapraw nna, lamu ga gaw tinang a n-gup hpaw mahka ai hte, ndai ni hte shanhte hte seng maseng hpe mayu kau nna, shanhte katsan ga de chyahkrung yu wa ma yang chyawm gaw, ndai masha ni Yehowa hpe n gawn n sawn di ai, nanhte chye lu na marin dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ga dai htum jang shanhte kabye nga ai ga gaw ga wa nna,
  </para>
  <para style="p">
    <verse number="32" style="v" />lamu ga n-gup hpaw ai hte shan a hkum hte shan a nta ni mung, Kora hte seng ai masha ni yawng hte hte shanhte a arai yawng mayawng hpe mung, mayu kau mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shing rai shanhte hkum dai hte shanhte hte seng maseng nawng katsan ga de chyahkrung yu hkrat wa ma ai: lamu ga mung shanhte a ntsa e bai chyip mat nna, shanhte gaw shawa hpung na jahtum kau ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte shabam ai nsen hpe dai grup na Israela masha ni na ma yang, “Anhte hpe mung mayu kau na ra ai,” nga nna hprawng ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lawban nat nawng ai masha ni tsa e manga shi hpe mung, Yehowa kaw na wan pru nna hkru kau mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="37" style="v" />“Dai wan ban ni chyoi pra nga ai majaw, wan hkru kaw na hta la nna, wan hpe wora de sa ru kau nhtawm,
  </para>
  <para style="p">
    <verse number="38" style="v" />tinang asak jasum na matu shut ai lam hkan ai ni a wan ban ni hpe tawn hkungri magap ai magri pa dup shangun na, hkinjawng Arun a kasha Eleaza hpe hkang dat u: dai wan ban ni gaw Yehowa man e nawng jau sai majaw, chyoi pra nga ai rai nna, dai hte gaw Israela kashu kasha ni hta kumla tai nga na rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shaloi hkinjawng Eleaza gaw wan hkru si ai ni nawng ai magri wan ban ni hpe la nna, tawn hkungri magap dup mu ai:
  </para>
  <para style="p">
    <verse number="40" style="v" />dai rai nna, Arun lakung n re ai, amyu lakung gale ni Yehowa man e lawban nat nawng ai hte, Kora hte shi hpang maga na ni zawn n rai mu ga nga, Yehowa Mawshe a n-gup hta tsun da ai hte maren, dai gaw Israela kashu kasha ni hta shadum jahprang nga na kumla rai nga ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hpang jahpawt e Israela shawa hpung ting gaw Mawshe yan Arun hpe, mara shagun let, “Nan Yehowa a masha ni hpe sat kau myit dai,” nga nna aput ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dai shawa hpung ting Mawshe yan Arun hpang de shing rai hpawng nga ma yang, shan gaw sum de mada yu mu ai rai nna, yu u, sumwi gaw dai hpe ka-up nna Yehowa a hpung shingkang dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mawshe yan Arun mung shawa sum de sit sa ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shaloi Yehowa Mawshe hpe,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Ndai shawa hpung hpe ya jang ngai sat kau we ga, shanhte kaw na yen mu,” ngu wu ai: shan gaw dingnyawm dagup nga ma ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Bai Mawshe gaw Arun hpe, “Na a wan ban la nna tawn hkungri na wan hta bang nhtawm, lawban mara lang let, shawa hpung de alawan gat nna shanhte a matu htingrai htingrat su: Yehowa a pawt ai sindawng pru ra ai; ana zinli mung du rau ra ai,” ngu nna shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mawshe a ga hte maren Arun mung dai la nna, shawa hpung de gat wu ai; yu u, masha ni hta ana zinli du rau sai rai nna, lawban mara lang let masha ni a matu shi htingrai htingrat ya wu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Shing rai hkrung ai ni hte si ai ni a lapran e shi tsap nga nna, ana zinli sim mat wa ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shing rai Kora a lam majaw si ai ni hta kaga, dai ana zinli hte si ai ni yawng, mun mi hkying mali e sanit tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Arun mung, dai ana sim jang she shawa sum chyinghka de Mawshe kaw bai wa ai.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe ga tsun nna, kaji kawa lakung lama hkan let, Israela amyu shi lahkawng hta na du agyi shagu a dawhkrawng mahkra shi lahkawng la nna, langai hte langai a amying tinang a dawhkrawng hta ka shakap mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lewi amyu a dawhkrawng hta Arun a amying ka shakap mu: shing rai amyu lakung du langai mi a dawhkrawng langai ngai rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai dawhkrawng ni hpe ngai nanhte hte jahkrum ai shara, dai shawa sum kata na sakse a man e nang tawn da na rai ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi ngai lata la ai wa a dawhkrawng gaw apu pu na ra ai: ning rai jang she, Israela Kashu Kasha ni nang hpe aput apai nga ai ga, ngai na pu shara n nga na sai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawshe mung Israela kashu kasha ni hpe tsun dat mu ai rai nna, du agyi ni yawng gaw, kaji kawa lakung hkan nna, du langai mi a dawhkrawng langai ngai la nhtawm dawhkrawng shi lahkawng sa ya mu ai. Arun a dawhkrawng mung shanhte a dawhkrawng ni hte rau rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mawshe gaw dawhkrawng dai ni hpe sakse sum a kata Yehowa man e tawn da wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpang jahpawt e dai sakse sum kata de Mawshe shang yu yang, yu u, Lewi nta ngu na Arun a dawhkrawng gaw alap lap ai hte pu majawm nna, pu lagra ai hte myin ai batan si si nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mawshe mung dai dawhkrawng mahkra Yehowa man na la shapraw nhtawm, Israela kashu kasha ni hpe madun mu ai: shanhte mung yu yu nna, langai hte langai tinang a dawhkrawng bai la ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Yehowa Mawshe hpe, “Aput apai nga nna nye a na shapu ai ga sim mat nna shanhte si ai n hkrum mu ga, gumlau ai masha ni a matu sakse kumla shatai na Arun a dawhkrawng dai hpe sakse a man e bai tawn da u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mawshe mung, Yehowa shi hpe hkang dat wu ai hte maren galaw wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Israela kashu kasha ni chyawm gaw Mawshe hpe, “Yu u, anhte si ma wa nga ga ai; anhte htum ma saga ai; gaja wa htum ma wa nga ga ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa a sumpan sum de sit sa ai hkum shagu teng teng si ma na ga ai; anhte yawng mayawng wa si htum mat wa na kun?” nga nna tsun ma ai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Arun hpe tsun wu ai gaw, “Dai chyoi pra ai nta hte seng ai shut hpyit mara gaw, nang hte na nshu nsha ni, na nwa a amyu dap na ni gun lu na rai myit dai; hkinjawng aya hte seng ai shut hpyit mara gaw, nang hte na nshu nsha ni gun lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na nji nwa, Lewi amyu dap na, nhpu nnau ni, nang hte shingtau nna nang hpe karum na matu, shanhte hpe sit sa shangun mu: rai timung sakse sum a man e gaw, nang hte na a shadang sha ni chyu sha jaw jau lu na rai myit dai:
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw nang hpe karum na hte dai Sum hpe yu lajang na rai ma ai: rai timung, nan wa ai hte shanhte si ai n hkrum myit ga dai chyoi pra nta a arai ni hte tawn hkungri de shanhte htep sa lu na n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw nang hpe karum nna, shawa sum hpe yu lajang ai hte, dai Sum hte seng ai yawng mayawng hpe gun hpai na rai ma ai: masha gale chyawm gaw nanhte kaw htep lu na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Htawm hpang de pawt bu ai Israela kashu kasha ni a ntsa e n pru hkra, dai chyoi pra ai nta hte tawn hkungri hpe, nanhte sin lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai na nhpu nnau Lewi masha ni hpe, Israela kashu kasha ni hta na ngai lata shaw la nna, shawa sum a amu gun hpai shangun na matu, Yehowa hpe sak jau ai kumhpa hku ngai nanhte hpe jaw made ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang hte na a shadang sha ni gaw, tawn hkungri hte nba shinggang kata na jaw jau ra ai hkinjawng amu yawng gun hpai na rai myit dai; dai gaw nanhte a amu rai nga ai: jaw jau na hkinjawng amu ngai nanhte hpe kumhpa zawn ap ya masade ai: dai de htep sa ai masha gale gaw sat kau ai hkrum na rai ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai, Yehowa Arun hpe tsun wu ai gaw, “Yu u, Israela kashu kasha ni shachyoi shapra sak ai kumhpa nlang hta na ngai e manawt jaw ai kumhpa gaw nang hpe ap ya sade ai; dai gaw, namman chya hkam ai a matu nang hte na a shadang sha ni hpe htani htana kumhtaw tai na, ngai jaw nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyoi pra htum ai arai ni hta na wan hta n shang ai gaw nanhte a kumhtaw tai na rai nga ai: shanhte ngai hpe sak jaw ai kumhpa nlang hta na ngu na, shadung kumhpa shagu, htingrai hkungga shagu, mara raw hkungga shagu gaw nang hte na a shadang sha ni a matu chyoi pra htum ai rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hpe chyoi pra htum ai ngu nna sha na rai myit dai; lasha nlang hte sha mai nga ai; dai gaw nanhte a matu chyoi pra nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai hta kaga, ndai gaw na a matu san san rai nga ai: Israela kashu kasha ni sak jaw ai kumhpa ni hta na manawt kumhpa hte nwat kumhpa shagu gaw, nang hte na a shayi shadang sha ni matu, htani htana kumhpa tai na ngai jaw nga nngai: na a nta na san seng ai ni nlang sha mai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte Yehowa hpe jaw jau ai shawng ngai ai nsi naisi a kaja htum ai namman, kaja htum ai tsabyi jahku hte nai mam, ngai nang hpe jaw sade ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa hpang de mung ting na la sa ai shawng myin ai namsi namsaw amyu myu mung na a rai nga ai: na a nta na san seng ai ni nlang sha mai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israela masha ni ga shaka da nna jaw jau ai yawng mayawng mung na a rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shinggyim masha rai timung, dusat dumyeng rai timung, Yehowa hpang de la sa ai alat yawng gaw na a rai na rai nga ai: rai timung masha alat hpe nang teng teng hkrang la na rai wu ai; dusat dumyeng alat hpe mung hkrang la na rai wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hkrang la na jahpu gaw, nang sawn yu nna, de a asak shata mi rai jang, chyoi pra ai nta a shakela hku hkan nna shekela manga hte hkrang lu na rai wu ai: shekela langai mi gaw gera hkun rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dumsu alat, sagu alat, bainam alat ni gaw, chyoi pra nga ai majaw hkrang la lu na nrai: de a asai hpe tawn hkungri hta lapri lu na rai nga ai; sau man mung Yehowa a matu manam pyaw sangau shatai nna, wan hte nat nawng na rai ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />De a ashan gaw, nwat sinda hte hkra magyi zawn, na a rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israela kashu kasha ni Yehowa hpe jaw jau ai chyoi pra ai kumhpa ni hta na manawt kumhpa yawng gaw, nang hte na a shayi shadang sha ni hpe htani htana kumhtaw shatai na matu ngai jaw da masade ai: dai gaw nang hte na amyu matu ni hte Yehowa a man e jum hte shangang da ai htani htana ga shaka rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Yehowa Arun hpe, “Israela kashu kasha ni madu ai mung hta e, nang gaw sali wunli ga lu na n rai, shanhte hta, na a kumhtaw lawm na n rai: ngai gaw shanhte hta, na a kumhtaw, na a sali wunli rai nga nngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lewi masha ni gaw, shawa sum a amu gun hpai nga ma ai majaw, shanhte a sali wunli shatai na, Israela kashu kasha ni lu ai hta na htamshi hta na htammi tup ngai jaw mase ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ya kaw nna Israela kashu kasha ni hta tinang a shut hpyit ai hte si ai yubak n hkrum hkra shawa sum de hkum htep sa manu ga.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lewi masha ni gaw shawa sum a amu gun hpai nna, tinang shut ai mara tinang gun lu na rai ma ai: Israela kashu kasha ni hta sali wunli ga mung madu lu na n rai; dai gaw nanhte a shu mashi shu masha prat dingsa hkan nga na matsun maroi rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kaning rai nme law, Israela kashu kasha ni Yehowa hpe manawt hkungga hku jaw jau ai htamshi hta htammi hpe, Lewi masha ni a sali wunli shatai na matu ngai shanhte hpe jaw se ai: dai rai nna shanhte gaw Israela kashu kasha ni hta sali wunli ga madu lu na n rai, nga nna shanhte hpe ngai tsun nga nngai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai, Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Dai hta kaga Lewi masha ni hpe ning ngu tsun u: Nanhte a sali wunli matu ngai jaw ai Israela kashu kasha ni kaw na htamshi hta htammi nanhte lu la jang, dai hpe htamshi bai karan nna htammi gaw Yehowa hpe manawt hkungga hku nawng jau lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nanhte a manawt kumhpa hpe chyarang hta na manawt mam zawn mung, tsabyi shup ai htumbyen hta na manawt tsabyi zawn mung, nanhte a matu nawn nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai, Israela kashu kasha ni kaw na nanhte lu la ai htamshi a htammi hta na, Yehowa hpe manawt kumhpa nawng na rai myit dai: dai Yehowa hte seng ai manawt kumhpa gaw, nanhte hkinjawng Arun hpe jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nanhte lu la ai kumhpa shagu hta na, kaja htum ai hte chyoi pra ngu na hte la nna, manawt kumhpa hku Yehowa hpe nawng jau na rai myit dai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai rai nna shanhte hpe ning ngu tsun u, ‘Lewi masha ni tinang a hta na kaja htum ai hte manawt jau ngut jang, nga ai hte gaw chyarang na lu la ai hpe zawn mung, tsabyi htumbyen hta na lu la ai hpe zawn mung, tinang a matu nawn nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai gaw tinang hte tinang a nta masha ni sha-ang ai shara shagu hta sha lu na rai ma ai: kaning rai nme law, shawa sum a amu gun hpai ai matu, dai gaw nanhte a shabrai rai nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai hta na kaja htum ai hpe manawt jau ngut jang, naw nga ai hta na majaw gaw nanhte hta mara rawng na n rai: nanhte si ai n hkrum myit ga, Israela kashu kasha ni a chyoi pra ai arai hpe awu asin hkum rai myit, ngu u,” ngu wu ai.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Mawshe yan Arun hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Da ndai gaw Yehowa hkang da ai tara matsun rai nga ai; Israela kashu kasha ni hpe ning ngu u: ra n rawng ai hte kandang garai n mara yu ai, hkrang hkum ai hte hkyeng ai dumsu upra langai mi la sa marit, ngu mu:
  </para>
  <para style="p">
    <verse number="3" style="v" />dai hpe hkinjawng Eleaza e nanhte ap ya nna, shi gaw dap shinggan de dai hpe shapraw nhtawm, shi a man e sat shangun na rai wu ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />shaloi hkinjawng Eleaza gaw shi a layung hte de a sai la nna, shawa sum maga de sanit lang lapri na rai wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bai shi a man e dai upra hkum ting hpe, de a ahpyi, ashan, asai hte ahkyi ni hte nawng nat shangun na rai wu ai:
  </para>
  <para style="p">
    <verse number="6" style="v" />hkinjawng wa mung, marau hpun, kungla pu matsun hte hkyeng mang ai sagu mun la nna, upra shan nat tawn ai hta kabai bang na rai wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpang hkinjawng wa gaw shi a hpun palawng hkrut nhtawm, hkum shin kau nna dap de shang wa na rai wu ai; shana de du hkra n san n seng naw rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai nat ai wa mung shi a hpun palawng hkrut nhtawm, hkum shin kau na rai wu ai; shana de du hkra n san n seng naw rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai upra a wan wu hpe san seng ai masha langai ngai sa magawn la nna, dap shinggan seng ai shara e tawn da na rai wu ai; dai hpe Israela kashu kasha ni a shawa hpung a shawan shasan ai ntsin hpaw la na matu kyem da na rai mu ai: dai gaw htingrai hkungga rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai upra wan wu sa magawn tawn ai wa mung, shi a hpun palawng hkrut na rai wu ai; shana de du hkra n san n seng rai nga ai: dai hte gaw Israela kashu kasha ni a matu mung, shingbyi nga ai amyu kaga ni a matu mung, prat dingsa hkan nga na matsun maroi rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Si mang hkra ai wa gaw nhtoi sanit ya tup n san n seng rai nga ai:
  </para>
  <para style="p">
    <verse number="12" style="v" />dai wa gaw masum ya du ai shani e tinang hkum hpe dai hte shawan shasan kau nna, sanit ya du ai shani e san seng na ra ai: masum ya e tinang hkum n shawan yang gaw, sanit ya du timung san seng na n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Si mang hkra da nhtawm, tinang hkum hpe n shawan kau ai wa gaw, Yehowa a sumpan sum hpe wu sin kau nu ai: dai zawn re ai wa hpe Israela amyu hta na sumri dan kau ya na rai myit dai; shawan shasan ai ntsin lapri n hkam ai majaw n san n seng rai nga ai; n san n seng ai gaw shi hta naw kap nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bai, sum kata e masha si yang hkan na lam gaw: dai sum kata de shang ai ni hte sum kata e rawng nga ai ni yawng, sanit ya tup n san n seng rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahka n htup ai yan nga manga mung n san n seng rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ri nhtu hte si wa wa rai timung, majoi si ai rai timung, masha nra rai timung, masha lup rai timung, pa hkan e katut nna hkra kau ai wa gaw, sanit ya tup n san n seng rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shing re ai rai yang, n san n seng ai wa a matu, wan hte nat la ai htingrai hkungga wan wu kau mi la nna, lwi ai hka na ntsin hpe wan hta kayau la nhtawm;
  </para>
  <para style="p">
    <verse number="18" style="v" />san seng ai wa langai mi kungla pu matsun hte dai ntsin hta kapru la nna, sum ntsa e mung, arai ni yawng hta mung, sum kata e rawng nga ai ni hpe mung, masha nra, ri nhtu hte si ai mang, majoi si ai mang, masha lup re ai ni hkra ai wa hpe mung, lapri bun na rai wu ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />shing rai dai san seng ai wa gaw, n san n seng ai wa hpe masum ya du ai shani mung, sanit ya du ai shani mung, lapri bun na rai nna, sanit ya du ai shani hta e dai wa hpe shawan shasan na rai wu ai: dai wa gaw shi a hpun palawng hkrut nhtawm, hkum shin kau nna, shana de du jang san seng na ra ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />N san n seng ai wa shi nan tinang hkum hpe shawan shasan na n galaw yang gaw, Yehowa a chyoi pra ai nta hpe shawu jasin wu ai majaw, shawa hpung hta na sumri dan kau ya ai hkrum lu na rai wu ai: shawan shasan ai ntsin a lapri bun ai n hkam wu ai majaw, shi hta n san n seng naw rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ndai gaw, shanhte a matu prat dingnawng na matsun rai nga ai: shawan shasan ai ntsin lapri ai wa mung, shi a hpun palawng hkrut na rai wu ai; ntsin dai hkra ai wa mung, shana de du hkra n san n seng rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />N san n seng rai nga ai; dai rai hpe bai hkra ai wa mung shana de du hkra n san n seng rai nga ai,” ngu wu ai.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Israela kashu kasha ni a hpung nlang hte gaw, shata langai ngu na hta Zin ngu ai nam mali de du nna, amyu masha ni gaw Kadesha shara e nga nga ma ai: dai yang e Miriam si nna lup makoi ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yang e, dai shawa hpung a matu ntsin n nga malu ai: dai majaw shanhte Mawshe yan Arun kaw sa nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />amyu masha ni Mawshe hte ndang kalang hkat let, “Yehowa a man e anhte a hpunau ni si rum ai shaloi e, anhte mung si a taw le:
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte hkum hte anhte a yamnga ni hpe nang e jasat kau na, Yehowa a hpung hpe ndai nam mali de hpa rai woi wa myit ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Egutu mung na anhte hpe shapraw la nhtawm, ndai ruyak ai shara de hpa majaw anhte hpe gawt wa myit ta? ya ndai yang yi hkauna galaw n mai; maihpang si, tsabyi si, hkainu si mung hkai sha n mai; lu na ntsin pyi n nga ai,” ngu nna aput mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna Mawshe yan Arun dai masha hpawng na pru nhtawm, shawa sum chyinghka de wa nna dingnyawm dagup nga ma ai: shaloi Yehowa a hpung shingkang shan kaw dan pru nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa mung Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Dai dawhkrawng la nna, na nhpu Arun hte sa nhtawm shawa hpawng hpe jahpawng tawn u: shing rai shanhte a man e dai nlung hpe, tinang a ntsin shapraw na tsun u; shaloi dai nlung hta na nang shanhte a matu ntsin shapraw lu na ra ai; shing rai, dai shawa hpung hta shanhte a yamnga ni hpe nang ntsin jaw lu lu na ra ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa hkang dat ai hte maren, Mawshe gaw Yehowa man na dai dawhkrawng la wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shing rai Mawshe yan Arun gaw dai shawa hpawng hpe, dai lunghkrung a man e jahpawng tawn nhtawm, “Gumlau masha ni e, madat mu: an nanhte a matu dai nlung hta na ntsin shapraw jaw na rai nga ga ni? nga nna shanhte hpe tsun let,
  </para>
  <para style="p">
    <verse number="11" style="v" />Mawshe gaw shi a lata sharawt nna, dai lunghkrung hpe dawhkrawng hte lahkawng lang kayat wu ai: shaloi ntsin law law wa pru wa nna, shawa masha ni hte shanhte a yamnga ni ntsin lu lu ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa, Mawshe yan Arun hpe tsun wu ai chyawm gaw, “Israela kashu kasha ni a man e ngai e shagrau sha a na hku, nan htai e n kam n sham myit dai majaw, ndai shawa hpawng hpe ngai jaw ai mung de, nan woi shawn lu na myit dai n rai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israela kashu kasha ni Yehowa hte ndang kalang hkat timung, shi shanhte hta shagrau sha a shara rawng nga ai majaw, hka dai hpe Meriba ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya Mawshe gaw Kadesha kaw nna Edom hkawhkam hpang de kasa shangun dat nna, “Na nnau Israela ning nga dat ai: Anhte hkrum ai nni nkri yawng hpe nang chye nga ndai;
  </para>
  <para style="p">
    <verse number="15" style="v" />anhte a ji wa Egutu mung de yu wa ma ai rai nna dai yang na na wa anhte nga kau saga ai; Egutu masha ni mung anhte hte anhte a ji wa ni hpe zingri zingrat di mi ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />dai rai nna, anhte Yehowa hpe jahtau shaga yang shi lamu kasa shangun dat nna Egutu mung na anhte hpe hkrang shaw la mi ai: ya, yu u, na lamu ga shingnawm Kadesha mare e anhte nga nga ga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna, na mung ka-ang hku ga lai wa n ga; na yi hkauna hte tsabyi sun anhte n kabye hkra na ga ai; hka htung ntsin mung n lu na ga ai: na a mung n tawng tawng gaw hkawhkam a nmaw lam sha anhte hkan nna pai de hkra de n yit na ga ai,” ngu nna htet dat wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Edom wa chyawm gaw, “Nang nye a mung ka-ang hku n ga lai lu na ndai; ga lai wa myit yang gaw nhtu hte hkap hpya na made ai,” ngu nna htan dat wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bai Israela kashu kasha ni gaw, “Nmaw lam hku sha anhte alung wa na ga ai; ngai hkum hte anhte a yamnga ni, na a ntsin lu ga yang gaw, manu jaw na nngai, lagaw hte hkawm lai na ahkang sha jaw e law,” ngu nna shi hpe hpyi wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Edom wa chyawm gaw, “Nang lai lu na n rai, nga nna, masha law law hte nsam kaba dat let, hkap hpya na nga pru sa wa ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing rai Edom wa Israela hpe shi a mung ga lai na ahkang n jaw wu ai rai nna, Israela gaw shi hpe yen da wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi shanhte gaw Kadesha kaw na htawt nna, Israela kashu kasha ni a shawa hpung ting gaw Hora bum de du ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ya, Edom mung a ga jarit makau na Hora bum e Yehowa Mawshe yan Arun hpe shaga la nna,
  </para>
  <para style="p">
    <verse number="24" style="v" />Arun gaw shi a amyu hpawng nga ai de wa na rai sai; Meriba ngu ai hka makau e nan nye a ga hpe nhtan jashai myit dai majaw, Israela kashu kasha ni hpe ngai jaw ai mung de, shi shang lu na n rai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai rai nna Arun hte shi a kasha Eleaza hpe shaga la nna, Hora bum de woi lung wa nhtawm,
  </para>
  <para style="p">
    <verse number="26" style="v" />Arun a hpun palawng raw la nna, shi a kasha Eleaza hpe jahpun u: Arun chyawm gaw dai yang e si nna, shi a amyu hpawng nga ai de wa na rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa hkang da ai hte maren Mawshe galaw nna, dai shawa hpung ting a man e shanhte Hora bum de lung ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shing rai Mawshe gaw Arun a hpun palawng raw la nna, shi a kasha Eleaza hpe jahpun wu ai: Arun chyawm gaw dai bum pungding e si mat ai; Mawshe yan Eleaza mung dai bum na yu hkrat wa ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Arun si mat sai hpe shawa hpung ting mu ma yang, Israela nta masha ni nlang Arun a majaw, nhtoi sumshi ya tup hkrap ngu hkrap ngoi rai nga ma ai.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Israela kashu kasha ni Ahtarim hku lung wa ma ai gaw, dingda maga na Hkanani masha Arad hkawhkam na wu yang, Israela kashu kasha ni hpe sa gasat nna, nkau mi hpe rim mat wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai rai nna Israela gaw, Yehowa hte ga shaka nna, “Nang ndai amyu hpe nye a lata hta ap ya n yang gaw, shanhte a mare ni hpe ngai akrin atsai di kau na we ai,” nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa mung Israela ga madat nna Hkanani masha ni hpe ap wu ai; shaloi Israela gaw shanhte hte shanhte a mare ni hpe akrin atsai di kau wu ai: shing rai shara dai hpe Horma ngu nna shamying mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ya shanhte Hora bum na htawt nna, Edom mung hpe hkawm kawai wa na matu, nawng hkyeng lam hku hkawm wa ma ai: dai lam hta hkawm sa yak ai majaw amyu masha ni myit htum shajang ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai rai nna amyu masha ni gaw, “Ndai nam mali e anhte si ma u ga nga, Egutu mung na hpa rai anhte hpe woi wa myit ta? muk mung n nga, ntsin mung kata; ndai asit n’ nga ai muk gaw anhte sha jin saga ai, nga nna Karai Kasang hte Mawshe hpe aput mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai majaw Yehowa Israela amyu masha ni hta wan lapu shangun dat wu ai rai nna, masha law law wa lapu kawa ai hte si mat ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi amyu masha ni gaw Mawshe hpang de sa nna, “Anhte gaw Yehowa hte nang hpe nhtan shai ai hku tsun kau ai majaw shut saga ai: Yehowa dai lapu ni hpe anhte kaw na seng kau ya mi ga, anhte a matu hpyi ya mi,” nga nna nem ma ai. Mawshe mung amyu masha ni a matu hpyi ya wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai rai nna Yehowa Mawshe hpe, “Wan lapu galaw nna dawnghkawn shadaw hte sharawt tawn u: lapu kawa hkrum ai wa kadai mung, dai hpe mada yu jang asak hkrung na ra ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai hte maren Mawshe gaw magri hte lapu galaw nna dawnghkawn shadaw hta sharawt tawn wu ai; shing rai lapu kawa hkrum ai kadai mung magri lapu dai hpe mada yu jang asak hkrung na nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bai Israela kashu kasha ni shara htawt nna, Obot ngu ai kaw but de nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Obot na bai htawt ai gaw, jan praw maga Moba mung makau e nam mali na Iye-Abarim kaw but de nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai yang na htawt ai gaw, Zered kadit e but de nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai yang na shanhte bai htawt ai gaw, nam mali hku pru nna, Amori lamu ga jarit na Arnon hka wora hkran e but de ma ai: Arnon hka chyawm gaw Moba mung hte Amori mung Lapran na Moba a lamu ga jarit rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hkan nna, Suhpa shara na Waheb, Arnon hka kadit ni hte, Moba lamu ga jarit makau sawt.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ara mare du hkra rawi rai dun hkrat ai, Kadit ni a malun ni, nga nna de a lam Yehowa a hpyen majan laika hta kajai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai kaw nna Bera de shanhte sa wa ma ai: dai hka htung gaw, Amyu masha ni hpe jahpawng u; ngai shanhte hpe ntsin jaw mawe ga, nga nna Yehowa Mawshe hpe tsun ai hka htung rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shaloi e Israela gaw ndai mahkawn mangoi ga, Hka htung ntsin e, pru u; dai hpe shakawn mu;
  </para>
  <para style="p">
    <verse number="18" style="v" />Hka htung dai hpe du agyi ni htu manu ai, Amyu masha ni hte arawng lu ai ni tawk manu ai, Sumdoi hte tinang dawhkrawng ni hte hpaw manu ai, nga nna mahkawn mangoi ma ai. Dai nam mali kaw nna Matana de;
  </para>
  <para style="p">
    <verse number="19" style="v" />Matana kaw nna Nahaliela de, Nahaliela kaw nna Bamot de,
  </para>
  <para style="p">
    <verse number="20" style="v" />Bamot kaw nna Moba pa a kadit na nam mali de yawng ai Pisga bum pungding du hkra htawt hkawm wa ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shaloi Israela gaw Amori masha ni a hkawhkam Sihon hpang de kasa shangun dat nna,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Na a mung ka-ang hku ngai ga lai wa n ga; yi hkauna, tsabyi sun anhte n kabye na ga ai; hka htung ntsin mung n lu na ga ai: na a lamu ga n tawng tawng gaw, hkawhkam a nmaw lam hku sha anhte ahkan na ga ai,” ngu nna htet dat wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sihon chyawm gaw, Israela hpe dai mung ga sa lai na ahkang n jaw wu ai: dai hta n-ga, shi a masha ni nlang hte hpe shinggyin la nhtawm Israela hpe hkap tau gasat na nga, dai nam mali de pru sa nna, Yahat mare du jang Israela hpe gasat wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi Israela shi hpe nhtu hte sat kau nna, shi a lamu ga hpe Arnon hka kaw nna Yabok hka du hkra, Amon kashu kasha ni a lamu ga hte htep madu la kau wu ai: Amon kashu kasha ni a lamu ga jarit chyawm gaw hkik nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Israela gaw dai mare ni nlang lu la mu ai: Amori masha ni a mare ni nlang hta mung, Hesbon hte de a ginwang kahtawng nlang hta mung Israela masha ni nga nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaning rai nme law Hesbon gaw, shawng na Moba hkawhkam hte gasat nna, Arnon hka du hkra lamu ga kashum la lu ai Amori masha ni a hkawhkam Sihon a shin mare rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai hkan nna ga shagawp laka ni, Hesbon mare de sa nna, Sihon a mare hpe bai de shangang mu:
  </para>
  <para style="p">
    <verse number="28" style="v" />Hesbon hta na wan pru nna, Sihon a mare na wan shinglet poi ai hte, Moba mung na Ara mare hte hpawn, Arnon kawng ni a Madu du ni hpe hkru kau manu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Moba e, nang hta dingnye nga nga ai, Hkemosha amyu e, nang hten mat nit dai; Shi a hprawng htaw wa ai shadang sha ni hte, Bawng dung nga ai shayi sha ni hpe, Amori hkawhkam Sihon a lata hta ap ya nu hka:
  </para>
  <para style="p">
    <verse number="30" style="v" />Anhte bai rai ra ai gaw shi hpe hkap gap nna, Hesbon gaw Dibon du hkra hten mat sai, Medeba mare hte htep na Nohpa shara du hkra, Akrin atsai di kau sagaw ai, nga nna jahta ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shing rai Israela gaw Amori mung e nga nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mawshe mung Yazera du hkra kin-yu yu shangun nna, dai mare ni hpe kashun la nhtawm, dai yang na Amori masha ni hpe shaden kau mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shaloi shanhte dai kaw na kayin nna Bashan mung de lung wa ma ai: Bashan hkawhkam Oga mung shi a masha ni nlang hte hte Edri shara e hkap gasat na pru sa wa ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi Yehowa Mawshe hpe, “Shanhte hpe hkum hkrit myit! shi hte shi a masha nlang hpe mung, shi a lamu ga mung, na a lata hta ngai ap sade ai: Hesbon mare na Amori hkawhkam Sihon hpe di ai zawn, ndai wa hpe mung di na rai myit dai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Shing rai shanhte gaw shi hte shi a kashu kasha ni hpe mung, shi a masha ni nlang hte hpe mung, langai mi muk n ngam hkra sat kau nna shi a lamu ga madu la kau ya mu ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Israela kashu kasha ni gaw hkawm sa wa nna, Moba pa, Yawdan hka hkran, Yerihko tawtap e but de nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela kashu kasha ni Amori masha ni hpe di ai lam yawng mayawng, Zipora kasha Balak mu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai rai nna, Israela kashu kasha ni law nga ai majaw, Moba masha ni nachying hkrit nga ma ai rai nna, shanhte gaw Israela kashu kasha ni majaw myit ru nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Moba masha ni gaw Midian agyi salang ni hpe, “Ndai wunawng wuwa gaw, dumsu ni pa na tsingdu sha shakrin wa ai zawn, anhte a grup yin nga manga hpe sha shakrin kau na maru ai,” nga ma ai. Dai hte yang, Zipora kasha Balak gaw, Moba masha ni a hkawhkam rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ya Balak gaw, Beora kasha Balam hpe shaga na matu, dai wa a amyu masha ni a nga ai mung na Hka makau e nga ai Petora mare de kasa shangun dat nna tsun dat wu ai gaw, “Yu u, Egutu mung na du lung wa ai masha amyu mi nga nga ai: shanhte ga ting pat rai nna nye a makau e but nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna, dai amyu hpe matsa sat na alawan sa rit; shanhte ngai hta n-gun grau ja ma ai: nang matsa ya yang gawm ngai shanhte hpe dang lu nna, nye a mung na shachyut kau lu hkra gasat lu a nhten: kaning rai nme law, nang shaman ai wa shaman chyeju lu ai mung, nang matsa kau ai wa hta matsa shang lu ai mung, ngai chye nngai,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai Moba salang ni hte Midian salang ni gaw, ma-un kumhpa gun let pru sa wa nna, Balam kaw du jang, Balak a ga htawn shana mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaloi Balam gaw, “Dai na nang e naw nga nga mu; Yehowa ngai hpe tsun na ra ai hte maren ngai tsun dan na made ai,” ngu wu ai: Moba du gyi ni mung Balam kaw nga nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang mung Balam kaw du nna, “Ndai nang kaw nga ai ni gaw kadai ni rai ma ta?” ngu nna san wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balam gaw Karai Kasang hpe, “Zipora kasha Moba hkawhkam Balak ngai kaw shangun dat nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />Egutu mung na du lung wa ai amyu gaw, lamu ga ting pat rai nga nga ai; dai rai nna, sa rit, nye a matu shanhte hpe matsa ya rit; shing rai yang, shanhte hpe ngai gasat lu nna shachyut kau lu a nhten, nga nna ngai e shaga shangun dat ai rai nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang chyawm gaw, “Nang dai ni hte rau hkan sa lu na n rai; dai amyu hpe nang matsa kau lu na n rai; dai gaw shaman chyeju lu ai amyu rai nga ai,” ngu nna Balam hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hpang jahpawt Balam gaw rawt nna, “Nanhte tinang buga de bai wa manu; nanhte kaw ngai hkan sa na Yehowa ahkang n jaw ai,” ngu nna Balak a du gyi ni hpe tsun dat mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shaloi Moba du gyi ni gaw Balak hpang de bai wa nna, “Balam gaw anhte hpang de n sa hkraw ai,” ngu nna wa tsun mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Balak gaw, shawng na hta grau law nna hpung grau rawng ai du gyi ni hpe shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte mung Balam kaw du nna, “Zipora kasha Balak ning nga ai: Nang ngai kaw du lu hkra, hpa hta mung hkum dang et;
  </para>
  <para style="p">
    <verse number="17" style="v" />ngai nang hpe grai di shagrau na de ai: nang hpyi mahpyi ngai jaw na de ai; dai rai nna, sa rit, dai amyu hpe nye a matu sa matsa ya rit, nga ai,” ngu mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Balam chyawm gaw, “Balak wa, ja gumhpraw hpring ai, shi a hkaw wa mi jaw lu timung, nye a Karai Kasang Yehowa a ga lai nna, amu kaji amu kaba, hpa mung ngai n galaw lu nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rai timung, Yehowa ngai e kaning nga naw tsun na chye lu n ga, dai na nang e naw nga mu,” ngu nna Balak a kasa ni hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shana e Karai Kasang Balam kaw du nna, “Dai masha ni nang hpe shaga ma yang gaw, rawt u, shanhte kaw hkan sa su; rai timung, ngai hkang da ai hku sha galaw lu na rai ndai,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jahpawt rai jang Balam gaw rawt nna, shi a lawze byau la nhtawm, Moba du gyi ni kaw hkan nang sa wa ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing rai hkan sa wa ai majaw, Karai Kasang masin pawt nna, Yehowa a lamu kasa gaw shi hpe ban shadang na nga lam e tsap nga ai. Shi chyawm gaw lawze jawn nna, shi a shangun ma lahkawng hte sa wa nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi Yehowa a lamu kasa, nhtu shachyen lang let, lam e tsap nga ai hpe lawze gaw mu nna, lam kau de yen ai hte yi de shang wa wu ai: Balam chyawm gaw dai lawze hpe kayat nna lam de hkrau la wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bai Yehowa a lamu kasa gaw, gade de na tsabyi sun nhpan a lapran e lam gyeng ai kaw tsap nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lawze gaw Yehowa a lamu kasa hpe bai mu jang, maga mi na nhpan de katut wa nna, Balam a lagaw anep kau wu ai: Balam mung lawze hpe bai kayat wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bai Yehowa a lamu kasa gaw bai htawt nna apai ahkra n yen mai hkra gyip ai kaw e tsap nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lawze dai mung Yehowa a lamu kasa hpe bai mu jang, Balam jawn nga ninglen hpum mat wu ai: Balam chyawm gaw masin pawt bu nna, shi a dawhkrawng hte dai lawze hpe kayat wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi Yehowa dai lawze a n-gup hpaw ya wu ai rai nna, lawze dai gaw, “Nang ngai e masum lang du hkra kayat na gaw, ngai nang hpe hpa di de ta?” ngu nna Balam hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balam gaw, “Nang ngai e shatu chyai nga ndai: ngai nhtu hpye taw gaw nang e ndai yang htau kau na de ai,” ngu nna lawze hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bai dai lawze gaw Balam hpe, “Ngai gaw ya du hkra nang tut a jawn nga ai na a lawze rai nga nngai, n rai ni? Ngai nang hpe galoi dai zawn rai yu de ta?” ngu nna san wu yang, Balam gaw, “N rai yu ndai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Yehowa Balam a myi hpaw ya wu ai rai nna, Yehowa a lamu kasa nhtu shachyen lang let tsap nga ai gaw shi mu wu ai: shaloi shi abaw gum nna dingnyawm dagup nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Yehowa a lamu kasa mung, “Na a lawze hpe hpa rai masum lang kayat wu ta?” yu u, nang sa wa ai lam ngai hte nhtan shai lit dai majaw, nang hpe ban shadang na ngai pru sa ring ngai:
  </para>
  <para style="p">
    <verse number="33" style="v" />na a lawze chyawm gaw ngai e mu nna masum lang nye a man e koi kau nu ai; shing rai n koi taw gaja wa teng teng ngai nang hpe sat nna, lawze e mahtang jahkrung da na se ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shaloi she Balam gaw, “Ngai shut ni ai; lam e nang ngai e hkap shadang ai hpe ngai n chye nngai: dai re ai majaw nang n hkraw n yang gaw, ngai bai nhtang wa na ni ai,” ngu nna Yehowa a lamu kasa hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yehowa a lamu kasa chyawm gaw, “Shanhte kaw hkan sa wa u; rai timung, ngai nang hpe tsun ai ga sha, nang tsun lu na rai ndai,” ngu nna Balam hpe tsun wu ai. Shing rai Balak a du agyi ni hte rau Balam sa wa ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Balam du ra ai gaw Balak na wu yang, shi hpe tau la na nga, Moba mung htum na lamu ga jarit Arnon hka kau e nga ai Moba mung na mare de pru sa wa ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shaloi Balak wa Balam hpe, “Nang hpe ngai kyin kyin shaga sade ai n rai ni? hpa rai lau n du n ta? ngai nang hpe n shagrau lu na rai nga a ni?” ngu wu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Balam chyawm gaw, “Nang kaw ngai du ring ngai; rai timung, nye myit hte ngai ga hkaw mi tsun lu na ahkang nga a ni? Karai Kasang nye a n-gup hta hti bang ai ga sha ngai tsun na rai nngai,” ngu nna Balak hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shing rai Balam Balak hte rau sa wa nna shan gaw Kiriat-huzot de du ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Balak mung dumsu hte sagu nawng ya nna, Balam hte shi hte sau nga ai du gyi ni hpe jaw dat wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hpang jahpawt e Balak gaw Balam hpe Bala hpara hte seng ai tsaw ai kawng ni de woi lung wu ai rai nna, shi gaw dai kaw nna Israela amyu mahkra hpe mada mu wu ai
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shaloi Balam gaw, “Nang e nye a matu tawn hkungri sanit gaw u; usu sanit hte sagu la sanit mung mazing tawn u,” ngu nna Balak hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balam tsun wu ai hte maren Balak galaw wu ai; shing rai Balak yan Balam gaw, hkungri shagu hta usu langai mi hte sagu la langai ngai nawng jau ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai Balam gaw, “Nang jaw ai wan nat hkungga makau e naw tsap nga la; ngai kaga de naw sa na nngai; Yehowa ngai hpe hkap tau ra nhten; shi ngai hpe madun ai made ngai nang e wa shana na de ai,” nga nna Balak hpe tsun da nhtawm, krin ai kawng langai mi de lung wa wu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Karai Kasang Balam hpe hkap tau ai rai nna, Balam gaw, “Ngai tawn hkungri sanit gaw da nna, tawn shagu hta usu langai mi hpe sagu la langai ngai nat nawng se ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai Yehowa Balam a n-gup hta ga hti bang nhtawm, “Balak hpang de wa nna ning ngu tsun u,” ngu nna hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Balam bai wa yang, Balak gaw Moba du gyi ni nlang hte rau, shi nawng ai wan nat hkungga a makau e tsap nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi Balam ga shagawp nna, “Balak du ngai hpe Aran mung na shaga ni ai, Moba hkawhkam sinpraw bum dinghkung na ngai e woi la ni ai: Shi gaw, Sa rit, nye a matu Yaku hpe matsa ya e, Sa rit, Israela hpe ahkrim ya e, nga nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang n matsa nga ai wa hpe, ngai kaning rai matsa na rai ta? Yehowa n hkrim nga ai wa hpe ngai kaning rai ahkrim lu na rai ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Lunghkrung ntsa na ngai shi hpe mu se ai, Kawng pungding nna ngai shi hpe yu se ai Amyu dai gaw kaga lak rai nga ai. Amyu gale hta lawm nga ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaku amyu ga nhpu hpe kadai hti lu na rai ta? Israela htam mali a htammi sha pyi, kadai chye lu a ta? Dingman ai wa si ai zawn ngai si n ga, Nye a jahtum gaw shi a jahtum zawn tai nu ga,” nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai rai nna Balak gaw, “Nang ngai hta hpa hku galaw nga n ta? Nye a hpyen ni hpe matsa ya e, nga nna she ngai nang e shaga yang me, nang gaw shanhte hpe gaja wa shaman ya nit dai,” ngu nna Balam hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Balam gaw, “Yehowa nye a n-gup hta hti bang ai ga tsun lu hkra, ngai n sadi na rai ni?” ngu nna htan wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai Balak gaw, “Sa rit, dai amyu hpe mu lu ai shara kaga de ngai hte rau htawt rit; shanhte mahkra hpe mu lu na n rai, shanhte a shingnawm daw sha mu lu na ndai: dai yang e nye a matu shanhte hpe matsa ya e,” nga nna
  </para>
  <para style="p">
    <verse number="14" style="v" />Pisga bum ntsa Zahpim pa de woi sa wa nhtawm, tawn hkungri sanit gaw ngut jang, tawn shagu hta usu langai mi hte sagu la langai ngai nat nawng wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai Balam gaw, “Ngai wora de Yehowa hte sa jahkrum ni ga, nang na a wan nat hkungga makau e naw tsap nga la,” ngu nna Balak hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa mung Balam hpe sa jahkrum nna, shi a n-gup hta ga hti bang ya nhtawm “Ya nang Balak hpang de bai wa nna ning ngu tsun u,” ngu nna hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi bai wa yang, Balak gaw shi nawng ai wan nat hkungga makau e tsap nga nna, Moba du gyi ni mung shi hte rau nga nga mala ai. Shaloi Balak gaw Yehowa kaning nga tsun a ta? ngu nna hkap san wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi Balam ga shagawp nna, “Balak du e, rawt u, madat u, Zipora kasha e, nye a ga na la u:
  </para>
  <para style="p">
    <verse number="19" style="v" />Karai Kasang masu na gaw, shi masha n rai, Myit malai lu na gaw masha kasha n rai: Tsun kau ngut sayang, n shagrin ai nga na a ni? Ndat da ngut sayang, n shatup ai nga na a ni?
  </para>
  <para style="p">
    <verse number="20" style="v" />Yu u, Shaman ya u, nga ai ga ngai lu ni ai; Shi shaman ya nu ai, ngai shabai lu na n rai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yaku hta yubak shi n mu wu ai, Israela hta mara shagun na n lu wu ai: Shi a Karai Kasang Yehowa shi hte rau rai nga ai, Hkawhkam garu ai nsen shanhte hta pru nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang Egutu mung na shanhte hpe shaw nna, Israela gaw dumbau zawn n-gun ja nga ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Gaja wa Yaku hpe matsa dat ai hte dang na n rai, Israela hta lawng shang lu na n rai: Karai Kasang shing di nu ai, nga nna, Ya e, Yaku hte Israela a lam kajai na mara ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yu u, dai amyu gaw hkanghkyi kanu zawn rawt na ra ai; Hkanghkyi zawn shingkang dat na ra ai: Htim la lu ai shan hpe garai n sha. Kawa tawn ai shan a sai garai n chyu lu lu gaw, shi hpum na ra ai n rai,” nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Balak gaw, “Shanhte hpe matsa mung hkum matsa, shaman mung hkum shaman,” ngu nna Balam hpe tsun wu yang,
  </para>
  <para style="p">
    <verse number="26" style="v" />Balam gaw, “Yehowa ngai e tsun matsun hte maren sha ngai galaw lu na nngai, ngu nna nang hpe ngai tsun sade ai n rai ni?” ngu nna Balak hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bai Balak gaw, “Sa rit, shara kaga de nang e naw woi sade ga: dai yang e nye a matu shanhte hpe matsa ya na, Karai Kasang hkraw dam a nhten,” nga nna Balam hpe tsun let,
  </para>
  <para style="p">
    <verse number="28" style="v" />Balak gaw, nam mali de man yawng ai Peora bum pungding de Balam hpe woi lung wu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balam mung “ndai yang e nye a matu tawn hkungri sanit gaw nna, usu sanit sagu la sanit lajang tawn u,” ngu nna Balam hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Balak mung Balam tsun wu ai hte maren galaw nna, tawn hkungri shagu hta usu langai mi hte sagu la langai ngai nawng ya wu ai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela kashu kasha ni hpe shaman ya na mahtang Yehowa ra nga ai gaw Balam chye wu jang, lawng hpaji tam na matu shawng de sa ai zawn bai n sa ai sha, nam mali de man yawng yu nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shing rai Balam gaw Israela masha ni tinang amyu lakung hkan nna dap mi hte dap mi rai but nga ma ai hpe mu mada wu ai; shaloi Karai Kasang a Wenyi shi hta du nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />ga shagawp hte shi tsun wu ai gaw, Beora kasha Balam gaw ning nga nga ai, “Shinggan myi htu hpaw ai wa tsun nga ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang a mungga na lu nna, N-gun chyalai rawng ai wa a shingran mu ai hte, Myit nawng yawng nna myi hpaw ai wa, ning nga tsun ra ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku e, na a janghpang ni, Israela e, na a sum ni, gade wa htap nga lit hka!
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai ni gaw dam lada re ai kadit ni hte, Hka kau na sun ni zawn; Yehowa hkai ai maza hpun ni hte, Hka kau e tu ai marau hpun ni zawn, ut rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a hka bung hta ntsin lwi na ra ai, Shi a hkai nli hka law ai shara hta hkrat na ra ai: Shi a hkawhkam gaw Agag hta shingkang grau rawng nna, Shi a mungdan galu kaba nga ai:
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang Egutu mung na shi hpe shaw nna, Israela gaw dumbau zawn n-gun ja nga ai: Shi hpe hpyen ai amyu ni hpe sha kau nna, Shanhte a nra ni hpe agrawp kau na wu ai; Shi a pala ni hte gap dinghkren kau na wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkanghkyi hte hkanghkyi kanu zawn, shi hpum let gyem nga ai: Kadai wa shi hpe shatu wam na a ta? Nang hpe shaman ai wa gaw shaman chyeju lu la u ga, Nang hpe matsa ai wa gaw, matsa hkrum sha u ga,” nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Balak gaw Balam hpe masin pawt bu nna, lata kahpret let, “Nye a hpyen ni hpe matsa ya rit ga, ngu nna she ngai nang hpe shaga yang me, ya masum lang du hkra shanhte hpe shaman hkrai a shaman ai gaw:
  </para>
  <para style="p">
    <verse number="11" style="v" />ya na a buga de hprawng wa u: nang hpe ngai grai shagrau na ngu nna myit nngai: rai timung, Yehowa gaw na a arawng jat na lam ban kau ya nit dai,” ngu nna Balam hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Balam chyawm gaw, “Balak wa, ja gumhpraw hte hpring ai shi a hkaw wa mi jaw timung, Yehowa a ga hta lai nna nye a myit hte kaja ai amu n kaja ai amu hpa mung ngai n galaw lu nngai: Yehowa tsun matsun hte sha ngai tsun na nngai,
  </para>
  <para style="p">
    <verse number="13" style="v" />ngu nna na a shangun kasa ni hpe ngai tsun se ai n rai ni?
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya chyawm gaw nye a amyu hpang de ngai wa na ni ai; madat la, ndai amyu masha ni htawm hpang de na a amyu hpe kaning di na maru ai gaw ngai madun de ga,” ngu nna Balak hpe htan wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi shi ga shagawp nna, Beora kasha Balam gaw ning nga nga ai, “Shinggan myi htu hpaw ai wa tsun nga ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang a mungga na lu nna, Tsaw Htum ai wa a chye chyang ai lam chye ai hte; N-gun chyalai rawng ai wa a shingran mu nna, Myit nawng yawng nna myi hpaw ai wa ning nga tsun ra ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai shi e mu se ai, rai timung, ya jang n rai, Ngai shi e yu se ai, rai timung, ani sha n rai: Yaku kaw na shagan langai mi pru nna, Israela hta na hkawhkam sumdoi paw pru na ra ai: Shi gaw Moba njut nnaw hkan du hkra gasat dang nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />Kabrawng ai nlang hte hpe agrawp kau na mu ai. Edom mung hpe madu la kau nna, Seira bum mung hpyen ni a lata hta rai na ra ai: Israela chyawm gaw nden ja ai hku dat na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yaku hta na madu Du langai mi pru nna, Naw ngam nga ai mare masha ni hpe hpya kau na wu ai,” nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bai Amalek mung de shi mada nna, ga shagawp hte tsun wu ai gaw, Amalek masha ni shawng na amyu rai nga ai, Jahtum e chyawm gaw hten bya hkrum na ra ai, nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai Keni masha nga ai de shi mada yu nna, ga shagawp hte tsun wu ai gaw, Na nga shara hkik nga lit dai, Lunghkrung ntsa e nan atsip tsip nit dai;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ashuri wa nang hpe rim mat wa ai nhtoi du hkra, Ka-in amyu akrin atsai di kau ai hkrum na ra ai,” nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bai, ga shagawp hte shi tsun wu ai gaw, “Aga! Karai Wa ndai nan shabyin dat yang, kadai wa lawt lu na i?
  </para>
  <para style="p">
    <verse number="24" style="v" />Rai timung Hkitim zunlawng na sanghpaw li sa nna, Ashuri mung hte Ebera mung hpe hpya kau na maru ai: Shaloi shi mung htum mat ai hkrum na ra ai,” nga nna tsun ngut jang,
  </para>
  <para style="p">
    <verse number="25" style="v" />Balam gaw rawt nna, shi a buga de bai wa mat ai; Balak mung wa mat ai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Israela gaw Shitim shara e nga nga ai; shaloi shanhte gaw Moba num ni hte shut hpyit ai lam galaw ma ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />dai num ni gaw shanhte a hpara ni hpe hkungga nawng ai poi de Israela masha ni hpe shaga mu ai rai nna, shanhte gaw dai sha lawm ai hte, Moba hpara ni a man e nawku ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shing rai Israela gaw Bala-Peora hte makyit mahkai re ai rai nna, Yehowa Israela hpe masin pawt bu nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Yehowa gaw, “Yehowa a pawt bu ai masin hpe Israela hta na shabai kau lu hkra, Israela du nlang hte hpe shaga la nna, jan mai ai shara Yehowa a man e noi jen kau u,” ngu nna Mawshe hpe tsun wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mawshe chyawm gaw, “Israela tara agyi ni hpe, Bala-Peora hte makyit mahkai ai ni hta na, langai hte langai tinang hte seng ai ni hpe sat kau mu,” ngu nna hkang dat mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai shaloi, Israela masha langai mi gaw Mawshe hte shawa sum a chyinghka makau e hkrap nga ai Israela shawa hpung nlang hte a man e, Midian numsha langai mi hpe, shi a kahpu kanau ni kaw woi shawn wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hpe Arun a kashu Eleaza a kasha Hpineha mu jang, shawa hpung na rawt nhtawm, ri la lang let,
  </para>
  <para style="p">
    <verse number="8" style="v" />dai Israela masha hpe shi a sum nhku de hkan nna, dai Israela la wa hpe hkrang nna num jan a kan baw hkra galun htinggrang kau wu ai. Shing di ai a majaw Israela kashu kasha ni hta na dai ana zinli sim mat ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi na ana zinli hte si ai ni gaw mun lahkawng e hkying mali rai nga ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Nye a manawn masham myit hte Israela kashu kasha ni hpe ngai n jahtum kau hkra, hkinjawng Arun a kashu Eleaza kasha Hpineha gaw, shanhte hta ngai hpang maga myit kaba ai majaw, nye a pawt bu ai masin hpe Israela kashu kasha ni hta na shabai kau ni ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai re ai majaw nang tsun lu na gaw, ‘Yu mu, nye a ngwipyaw ga shaka ngai shi hpe jaw we ai:
  </para>
  <para style="p">
    <verse number="13" style="v" />shi a Karai Kasang hpang maga shi myit kaba ai hte, Israela kashu kasha ni a matu htingrai htingrat nu ai majaw, shi hte shi a shu mashi shu masha ni gaw, dai ga shaka ngu ai, htani htana hkinjawng aya hte seng ai ga shaka lu la na manu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya, Midian numsha hte shut nna sat kau hkrum ai Israela la wa a amying gaw, Simun amyu hta na lakung langai mi a du agyi Salu a kasha Zimri rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sat kau hkrum ai Midian numsha a amying gaw, Midian amyu hta na lakung langai mi a agyi, Zura ngu ai wa a shayi sha Hkozbi rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi Yehowa Mawshe hpe,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Midian masha ni hpe shatsang nna sat kau mu:
  </para>
  <para style="p">
    <verse number="18" style="v" />kaning rai nme law, shanhte gaw, Peora hpara a lam hte mung, Peora hpara a majaw ana zinli du ai shani e sat kau hkrum ai shanhte a kajan kasha, Midian du agyi a shayi sha Hkozbi a lam hte mung, nanhte hpe gung lau nna hkalem kau ai hte shatsang kau manit dai,” ngu nna tsun wu ai.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai ana zinli hkoi mat ai hpang, Yehowa gaw Mawshe yan hkinjawng Arun a kasha Eleaza hpe, “Asak hkun ning lai nna Israela hta hpyen gasat lu ai, Israela kashu kasha ni a shawa hpung nlang hte hpe, kaji kawa dap hkan nna, jahpan hti la mu,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai hte maren Mawshe yan hkinjawng Eleaza gaw, “Moba pa, Yawdan hka hkran, Yerihko tawtap e shanhte hpe,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mawshe hte Egutu mung na pru wa ai Israela kashu kasha ni hpe Yehowa hkang da yang na zawn, asak hkun ning lai ai hpe jahpan la mu,” ngu nna hkang dat mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israela kasha alat Rubin: Rubin a kasha dap ni gaw, Hanuk hta na hkrat ai Hanuk dap; Hpalu hta na hkrat ai Hpalu dap;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezrun hta na hkrat ai Hezrun dap; Hkarmi hta na hkrat ai Hkarmi dap; hte rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai hte gaw Rubin a lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw, mun mali e hkying masum sanit tsa sumshi rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpalu a kasha Eliaba;
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliaba kasha ni Nemuela, Dahtan, Abiram rai ma ai. Dai Dahtan yan Abiram gaw, Kora masha ni Yehowa hpe gumlau yang, shawa hpung a baw mung tai nna, Mawshe yan Arun hpe gumlau ai yan rai ma ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />shan gaw, Kora manang ni tsa e manga shi hte hpe wan e hkru kau nna, kumla tai ma ai shaloi e, aga gaw shi a n-gup mahka nna Kora hte rau mayu kau hkrum ai hte dai ni hta si lawm mat ai yan rai ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kora a kasha ni chyawm gaw n si lawm ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Simun a kasha dap ni gaw; Nemuela hta na hkrat ai Nemuela dap; Yamin hta na hkrat ai Yamin dap; Yahkin hta na hkrat ai Yahkin dap;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zera hta na hkrat ai Zera dap; Sha-ula hta na hkrat ai Sha-ula dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hte gaw Simun lakung dap ni rai ma ai rai nna, marai mun lahkawng e hkying lahkawng ni tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad a kasha dap ni gaw: Zehpun hta na hkrat ai Zehpun dap; Hagi hta na hkrat ai Hagi dap; Shuni hta na hkrat ai Shuni dap;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ozni hta na hkrat ai Ozni dap; Eri hta na hkrat ai Eri dap;
  </para>
  <para style="p">
    <verse number="17" style="v" />Arod hta na hkrat ai Arod dap; Areli hta na hkrat ai Areli dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hte gaw Gad a lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw mun mali e manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yuda a kasha Era yan Onan rai ma ai: Era yan Onan gaw Hkanan mung e si mat masai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hpang na Yuda kasha dap ni gaw, Shela hta na hkrat ai Shela dap; Hparet hta na hkrat ai Hparet dap; Zera hta na hkrat ai Zera dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hparet a kasha Hezrun hta na hkrat ai Hezrun dap; Hamula hta na hkrat ai Hamula dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hte gaw Yuda lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw, mun sanit e hkying kru manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yishahka kasha dap ni gaw: Htula hta na hkrat ai Htula dap; Hpua hta na hkrat ai Hpua dap;
  </para>
  <para style="p">
    <verse number="24" style="v" />Yashub hta na hkrat ai Yashub dap; Shimrun hta na hkrat ai Shimrun dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dai hte gaw Yishahka lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw, mun kru e hkying mali masum tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zebulun a kasha dap ni gaw, Sered hta na hkrat ai Sered dap; Elun hta na hkrat ai Elun dap; Yelela hta na hkrat ai Yalela dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai hte gaw Zebulun lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw mun kru e manga tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yawsep a kasha Manashe yan Ehprim hta na, Manashe a kasha dap ni gaw, Mahkira hta na hkrat ai Mahkira dap; Mahkira gaw Gilead hpe shaprat wu ai rai nna, Gilead hta na hkrat ai Gilead dap rai nga ai;
  </para>
  <para style="p">
    <verse number="30" style="v" />bai Gilead kasha dap ni gaw, Izera hta na hkrat ai Izera dap; Helek hta na hkrat ai Helek dap;
  </para>
  <para style="p">
    <verse number="31" style="v" />Asriela hta na hkrat ai Asriela dap; Shehkim hta na hkrat ai Shehkim dap;
  </para>
  <para style="p">
    <verse number="32" style="v" />Shemida hta na hkrat ai Shemida dap; Hehpera hta na hkrat ai Hehpera dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hehpera kasha Zelohpa gaw shadang sha n lu ai, shayi sha hkrai rai lu ai; Zelohpa a shayi sha ni a amying gaw, Mala, Noa, Hogla, Milhka, Tirza rai ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai hte gaw Manashe lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw, mun manga e hkying lahkawng sanit tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ehprim a kasha dap ni gaw: Shuhtela hta na hkrat ai Shuhtela dap; Behka hta na hkrat ai Behka dap; Tahan hta na hkrat ai Tahan dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shuhtela kasha Eran hta na hkrat ai Eran dap mung lawm nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai hte gaw Ehprim lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni hte maren, mun masum e hkying lahkawng manga tsa rai ma ai. Dai gaw Yawsep a amyu matu dap ni rai ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ben-yamin a kasha dap ni gaw, Bela hta na hkrat ai Bela dap; Asbela hta na hkrat ai Asbela dap; Ahiram hta na hkrat ai Ahiram dap;
  </para>
  <para style="p">
    <verse number="39" style="v" />Shehpuhpam hta na hkrat ai Shehpuhpam dap; Huhpam hta na hkrat ai Huhpam dap rai ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bai, Bela kasha Arda yan Naman hta: Arda hta na hkrat ai Arda dap; Naman hta na hkrat ai Naman dap rai ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Dai hte gaw Ben-yamin a lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw, mun mali e hkying manga kru tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dan a kasha dap ni gaw, Shuham hta na hkrat ai Shuham dap rai nga ai. Dai gaw Dan a kasha lakung ni rai ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jahpan hta lawm ai Shuham lakung dap yawng gaw mun kru e hkying mali, mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ashe a kasha dap ni gaw, Imna hta na hkrat ai Imna dap; Iswi hta na hkrat ai Iswi dap; Beria hta na hkrat ai Beria dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Beria kasha Hebera hta na hkrat ai Hebera dap; Malhkela hta na hkrat ai Malhkela dap rai ma ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ashe a shayi sha a amying chyawm gaw Sera rai nga ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Dai hte gaw Ashe a lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai hte maren mun manga e hkying masum mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Naphtali a kasha dap ni gaw, Yazela hta na hkrat ai Yazela dap; Guni hta na hkrat ai Guni dap;
  </para>
  <para style="p">
    <verse number="49" style="v" />Yezera hta na hkrat ai Yezera dap; Shilem hta na hkrat ai Shilem dap hte rai ma ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Dai hte gaw Naphtali lakung dap ni rai ma ai rai nna, jahpan hta hti lawm ai ni gaw mun mali e hkying manga mali tsa rai ma ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Shing rai Israela kashu kasha ni hta na, jahpan hta hti lawm ai ni gaw, sen kru e hkying me sanit tsa sumshi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Bai Yehowa Mawshe hpe Dai hti lawm ai jahpan nambat amying rawng ai hte made hpe, sali mungdan dai karan jaw na rai mu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Masha law yang gaw law ai hku, n law yang gaw n law ai hku: jahpan nambat hkan nna langai hte langai hpe lamu ga sali karan jaw na rai mu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Rai timung, dai hpe hpaida hte karan na rai myit dai; kaji kawa amyu mying hkan nna lamu ga sali hkam la na rai mu ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Hpaida hta ang ai hte maren masha law n law hkan nna, lamu ga karan na rai myit dai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Da ndai kaji kawa dap hkan nna, jahpan hta hti lawm ai Lewi masha ni rai ma ai: Gershon hta na hkrat ai Gershon dap; Kohat hta na hkrat ai Kohat dap; Merari hta na hkrat ai Merari dap rai nga ai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Dai gaw Lewi dap ni rai ma ai: Libni dap, Hebron dap, Malit dap, Mushit dap, Kora dap lawm ma ai: Kohat gaw Amram hpe shaprat wu ai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amram a madu jan gaw, Egutu mung e Lewi a madu jan shangai ai Lewi a shayi sha Yohkebe rai nga ai: shi gaw Amram a matu Arun yan Mawshe hte shan a kajan Miriam hpe shangai wu ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Arun a kasha ni gaw Nadab, Abihu, Eleaza hte Ihtama rai ma ai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Nadab yan Abihu gaw, Yehowa man e wan shaje nawng ya ai shaloi, si mat masai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Shanhte hta na asak shata mi hta jan ai jahpan hta hti lawm ai lasha nlang hte gaw mun lahkawng e hkying masum rai ma ai: shanhte gaw Israela kashu kasha ni hte rau lamu ga sali n lu la na re ai majaw, Israela kashu kasha ni a jahpan hta n lawm ma ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Ndai gaw Mawshe yan hkinjawng Eleaza lata hte Moba pa Yawdan hka kau Yerihko tawtap e jahpan la ai Israela kashu kasha ni rai ma ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Dai ni hta Sina nam e Mawshe yan hkinjawng Arun hti la ai jahpan hta na ni marai langai mi muk n lawm ma ai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Kaning rai nme law, ‘Dai ni gaw nam e teng teng si mat na re ai,’ nga nna shanhte a lam Yehowa tsun nu ai. Dai rai nna Yehpuna a kasha Hkaleb yan Nun a kasha Yawshu hta kaga shawng na masha langai mi muk n ngam ma ai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dai shaloi Yawsep a kasha Manashe lakung hta na, Mahkira, Gilead, Hehpera hta nna hkrat ai Zelohpa a shayi sha, Mala, Noa, Hogla, Mihka, Tirza mying ai hte gaw sit sa nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />shawa sum chyinghka makau na, Mawshe yan hkinjawng Eleaza a man e mung, du agyi ni hte shawa hpung masha ni mahkra a man e mung tsap let:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Anhte a wa gaw nam mali e si mat sai; rai timung, shi gaw Yehowa hpe rawt gumlau ai Kora hpung masha ni hta lawm ai n rai: shi dai shi a mara hta si wa sai; shi hta shadang sha mung n nga lu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shing rai shadang sha n lu ai a majaw, anhte a wa a amying gaw anhte lakung hta na mat mai na rai ni? Anhte a wa a kahpu kanau ni hte rau anhte hpe mung lamu ga sali karan jaw mi,” ngu nna hpyi mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mawshe mung shanhte a lam Yehowa kaw jashawn wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi Yehowa mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zelohpa a shayi sha ni tsun ai ga htuk nga malu ai; gaja wa teng teng shanhte a kawa a kahpu kanau ni hte rau shanhte hpe lamu ga sali karan jaw lu na rai myit dai: shanhte a kawa a sali wunli gaw shanhte a lata hta nan lup di jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israela kashu kasha ni hpe mung nang ning ngu tsun na rai ndai, Masha langai ngai shadang sha n lu ai si mat yang, shi a sali wunli gaw shi a shayi sha madu lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shayi sha mung n lu ai rai yang gaw, sali dai gaw shi a kahpu kanau ni hpe jaw na rai mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kahpu kanau mung n nga ai rai yang gaw, sali dai gaw kawa di kawa doi nta ni hpe jaw na rai mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kawa di kawa doi mung n nga ai rai yang gaw shanhte dap hta na grau ni jahtum ai kahpu kanau wa hpe jaw na rai mu ai rai nna dai wa madu na rai wu ai: dai gaw, Yehowa Mawshe hpe hkang da wu ai hte maren, Israela kashu kasha ni hta tara matsun lam tai na rai nga ai, ngu u,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai Yehowa Mawshe hpe, “Ndai Abarim bum de lung wa ru; Israela kashu kasha ni hpe ngai jaw ai mung mada la u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hpe mada la ngut jang, na nhpu Arun tinang amyu hpawng nga ai de wa ai zawn, nang mung wa na rai ndai:
  </para>
  <para style="p">
    <verse number="14" style="v" />kaning rai nme law, Zin nam mali e shawa hpung gaw ngai hpe gumlau ai shaloi, nan mung nye a ga hte nhtan shai nna, dai hka kau shanhte a man e ngai hpe n shagrau n sha a ai yubak lu myit dai,” ngu nna tsun wu ai. Dai hka chyawm gaw, Zin nam mali, Kadesha shara na Meriba ngu ai hka rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai rai nna Mawshe gaw Yehowa hpe,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Yehowa a shawa hpung gaw madu n nga ai sagu zawn n rai mu ga, hkrung mahkrung a asak wenyi sumri shum ai Karai Kasang Yehowa gaw,
  </para>
  <para style="p">
    <verse number="17" style="v" />ndai shawa hpung a man e pru pru shang shang rai lu nna, shanhte hpe shapraw lu ai hte jashawn la lu ai wa langai ngai hpe, shanhte a ntsa e san da ya u ga law,” ngu nna hpyi wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shing rai Yehowa gaw Mawshe hpe, “Myit su Wenyi rawng ai Nun a kasha Yawshu hpe shaga la nna, shi a ntsa e na lata mara u:
  </para>
  <para style="p">
    <verse number="19" style="v" />hkinjawng Eleaza hte shawa hpung yawng a man e shi hpe tawn da nna, shanhte a man e ahkang aya ap da u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israela kashu kasha hpung ting shi a ga madat mu ga, na a arawng sadang shi hta mara ya u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai wa hkinjawng Eleaza a man e sa tsap jang, hkinjawng wa gaw shi a matu Yehowa a man e ra ai lam hpe Urim hte san ya na rai wu ai: dai wa a hpajang ai hte maren Israela kashu kasha ni hpung nlang hte gaw, shi hte rau pru wa shang wa rai na rai ma ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mawshe mung Yehowa hkang dat ai hte maren galaw wu ai: Yawshu hpe shaga la nna, hkinjawng Eleaza hte shawa hpung yawng a man e tawn da nhtawm,
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa Mawshe hpe hkang dat wu ai hte maren, shi a ntsa e lata mara ai hte ahkang aya jaw da wu ai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe ning ngu hkang dat u: ‘Nye a matu manam pyaw sangau shatai na, nye a shat ngu na wan hte nat nawng ai kumhpaw kumhpa ni hpe madat da ai ladaw hta nanhte nawng jau na rai myit dai.'
  </para>
  <para style="p">
    <verse number="3" style="v" />Bai, shanhte hpe ning ngu tsun u: ‘ndai gaw nanhte Yehowa hpe wan hte nat nawng na shagu hkungga rai nga ai: tutnawng na wan nat hkungga matu, shani shagu, ra n rawng ai hte ladu hkrum ai sagu la kasha lahkawng nawng na rai myit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sagu la kasha langai mi hpe jahpawt e, langai mi hpe shana de nawng na rai myit dai;
  </para>
  <para style="p">
    <verse number="5" style="v" />htu la ai sau loga masum hte kayau ai shadung mani uma mi mung, shadung kumhpa matu nawng na rai myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai gaw Sina bum e, hkang da nu ai hte maren, Yehowa a matu manam pyaw sangau shatai na wan hte nat nawng ai tutnawng na wan nat hkungga rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sagu la langai mi hte hpawn, ru hkaw kumhpa di na matu tsabyi jahku loga masum mung nang la sa nna, chyoi pra ai shara e, Yehowa a matu ru hkaw hkungga shatai na nang ai baw hte ru hkaw na rai wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bai sagu kasha langai mi gaw shana de nawng na rai wu ai; jahpawt na hta shadung kumhpa hte ru hkaw kumhpa lawm ai zawn nang shalawm nna, Yehowa a matu wan hte nawng ai manam pyaw sangau shatai na rai wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai, laban nhtoi hta, ra n rawng ai hte ladu hkrum ai sagu la kasha lahkawng nawng na rai wu ai; dai hta ru hkaw kumhpa hte nawng, shadung kumhpa matu sau hte kayau ai mani ai shadung uma lahkawng mung shalawm na rai wu ai:
  </para>
  <para style="p">
    <verse number="10" style="v" />dai gaw tutnawng na wan nat hkungga hte de a ru hkaw kumhpa hta kaga, laban nhtoi shagu jaw jau ai hkungga rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bai, nanhte a shata praw shani e, Yehowa a matu wan nat hkungga shatai na, usu uram lahkawng, sagu la langai mi, ra n rawng ai hte ladu hkrum ai sagu la kasha sanit nawng jau na rai myit dai:
  </para>
  <para style="p">
    <verse number="12" style="v" />shadung kumhpa matu, usu langai mi hta, sau hte kayau ai mani ai shadung uma masum sum; bai, shadung kumhpa matu, sagu la langai mi hta, sau hte kayau ai mani ai shadung uma lahkawng;
  </para>
  <para style="p">
    <verse number="13" style="v" />bai, shadung kumhpa matu, sagu kasha langai mi hta, sau hte kayau ai mani ai shadung uma langai ngai rai na rai nga ai: dai gaw Yehowa a matu wan hte nawng ai, manam pyaw ai wan nat hkungga rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ru hkaw kumhpa chyawm gaw, usu langai mi hta tsabyi jahku loga kru kru, sagu la langai mi hta loga mali, sagu kasha langai mi hta loga masum sum rai na rai nga ai; dai gaw shaning a shata ni hta praw shagu na wan nat hkungga rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bai, tutnawng na wan nat hkungga hte de a ru hkaw kumhpa hta kaga, htingrai hkungga di na matu bainam la langai mi Yehowa hpe nawng na rai wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai, shata langai ngu na a nhtoi shi mali ya e, Yehowa a shalai dat ai poi rai nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai shata shi manga ya e, poi rai na rai nga ai: dai kaw nna sanit ya tup matsi n rawng ai muk sha nga lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ningnan shani e chyoi pra ai zuphpawng hpawng na rai myit dai: amu bungli galaw lu na n rai:
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa a matu wan hte nawng ai wan nat hkungga ngu na, usu uram lahkawng, sagu la langai mi, ladu hkrum ai sagu la kasha sanit, nawng jau na rai wu ai: dai ni gaw ra n rawng ai sha rai na rai nga ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />shadung kumhpa gaw, usu langai mi hta sau hte kayau ai mani ai shadung uma masum sum; sagu la hta uma lahkawng,
  </para>
  <para style="p">
    <verse number="21" style="v" />sagu kasha sanit hta langai mi a matu uma langai ngai di nna nawng na rai wu ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />nanhte a matu htingrai htingrat na nga, htingrai hkungga bainam la langai mi mung nawng na rai wu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tutnawng na, jahpawt shagu jau ai wan nat hkungga hta kaga, dai hkungga ni hpe mung, kahtap nawng na rai myit dai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shing rai, tutnawng jau nga ai wan nat hkungga hte ru hkaw kumhpa hta kaga, Yehowa a matu manam pyaw sangau shatai na, dai sanit ya ting, shani shagu wan hte nawng ai shat ngu na kumhpa nawng jau na rai myit dai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sanit ya ngu na shani hta mung, chyoi pra ai zuphpawng hpawng na rai myit dai; amu bungli galaw lu na n rai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hta kaga bat sanit gu jang, Yehowa hpang de shadung kumhpa ningnan sak jaw ai shani ngu na shawng ngai ai asi a poi shani hta, chyoi pra ai zuphpawng hpawng na rai myit dai: amu bungli galaw lu na n rai:
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa a manam pyaw sangau shatai na, wan nat hkungga matu, usu uram lahkawng, sagu la langai mi, ladu hkrum ai sagu la kasha sanit hte,
  </para>
  <para style="p">
    <verse number="28" style="v" />dai ni a shadung kumhpa mung, usu langai mi hta sau hte kayau ai mani ai shadung uma masum sum, sagu la langai mi hta uma lahkawng,
  </para>
  <para style="p">
    <verse number="29" style="v" />sagu kasha sanit hta langai mi a uma langai ngai di nna nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="30" style="v" />htingrai htingrat na matu mung, bainam la langai mi nawng na rai myit dai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shing rai tutnawng jau ai wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa ni hta kaga, dai hkungga ni kahtap jaw na rai myit dai: dai ni gaw ra n rawng ai hkrai rai na rai nga ai.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, shata sanit na nhtoi langai ya hta chyoi pra ai zuphpawng hpawng na rai myit dai: amu bungli galaw lu na n rai: dai gaw nanhte a matu pahtau dum na shani rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi e, Yehowa a manam pyaw sangau shatai na, wan nat hkungga matu, usu uram langai mi, sagu la langai mi, ra n rawng ai hte ladu hkrum ai sagu la kasha sanit hte,
  </para>
  <para style="p">
    <verse number="3" style="v" />dai ni a shadung kumhpa mung, usu hta sau hte kayau ai mani ai shadung uma masum, sagu la hta uma lahkawng,
  </para>
  <para style="p">
    <verse number="4" style="v" />sagu kasha sanit hta langai mi a uma langai ngai di nna nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="5" style="v" />htingrai htingrat na matu mung, bainam la langai mi nawng na rai myit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai, htung hking nga ai hte maren, shata praw shani na wan nat hkungga hte de a shadung kumhpa, tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa re ai ni hta kaga Yehowa a manam pyaw sangau shatai na, wan hte nawng ai hkungga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bai, dai shata a nhtoi shi ya shani e chyoi pra ai zuphpawng hpawng nna tinang a myit masin shagrit nga na rai myit dai: hpa amu mung galaw lu na n rai:
  </para>
  <para style="p">
    <verse number="8" style="v" />dai shani e Yehowa a manam pyaw sangau shatai na, wan nat hkungga matu, usu uram langai mi, sagu la langai mi, ladu hkrum ai sagu la kasha sanit nawng na rai myit dai: dai ni gaw ra n rawng ai hkrai rai na rai nga ai:
  </para>
  <para style="p">
    <verse number="9" style="v" />shadung kumhpa mung, usu hta, sau hte kayau ai mani ai shadung uma masum, sagu la hta uma lahkawng,
  </para>
  <para style="p">
    <verse number="10" style="v" />sagu kasha sanit hta langai mi a uma langai ngai di na rai nga ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />htingrai htingrat na matu mung, bainam la langai mi nawng na rai myit dai: shing rai, htingrai htingrat na matu, htingrai ai hkungga hte, tutnawng na wan nat hkungga, de a shadung kumhpa hte ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bai, dai shata shi manga ya shani e chyoi pra ai zuphpawng hpawng na rai myit dai: amu bungli n galaw ai sha, sanit ya tup Yehowa a matu poi galaw na rai myit dai;
  </para>
  <para style="p">
    <verse number="13" style="v" />nnan shani e, Yehowa a manam pyaw sangau shatai na wan nat hkungga a matu, usu uram shi masum, sagu la lahkawng, ladu hkrum ai sagu la kasha shi mali wan hte nawng na rai myit dai: dai ni gaw ra n rawng ai hkrai rai na rai nga ai;
  </para>
  <para style="p">
    <verse number="14" style="v" />shadung kumhpa mung, usu shi masum hta langai mi a matu, sau hte kayau ai mani ai shadung uma masum sum, sagu la lahkawng hta langai mi a uma lahkawng hkawng;
  </para>
  <para style="p">
    <verse number="15" style="v" />sagu kasha shi mali hta langai mi a uma langai ngai rai na rai nga ai:
  </para>
  <para style="p">
    <verse number="16" style="v" />htingrai hkungga matu bainam la langai mi mung nawng na rai myit dai; shing rai, tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hpang shani hta, usu uram shi lahkawng, sagu la lahkawng, ra n rawng ai hte ladu hkrum ai sagu la kasha shi mali nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="18" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna htung hking hte maren lawm na rai nga ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />htingrai hkungga matu bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Masum ya du ai shani hta, usu uram shi langai, sagu la lahkawng, ra n rawng ai hte ladu hkrum ai sagu la kasha shi mali nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="21" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna htung hking hte maren lawm na rai nga ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />htingrai hkungga matu bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mali ya du ai shani hta, usu uram shi, sagu la lahkawng, ra n rawng ai hte ladu hkrum ai sagu la kasha shi mali nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="24" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna, htung hking hte maren lawm na rai nga ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />htingrai hkungga matu bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Manga ya du ai shani hta, usu uram jahku, sagu la lahkawng, ra n rawng ai hte ladu hkrum ai sagu la kasha shi mali nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="27" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna, htung hking hte maren lawm na rai nga ai:
  </para>
  <para style="p">
    <verse number="28" style="v" />htingrai hkungga matu bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kru ya du ai shani hta, usu uram matsat, sagu la lahkawng, ra n rawng ai hte ladu hkrum ai sagu la kasha shi mali nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="30" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna, htung hking hte maren lawm na rai nga ai:
  </para>
  <para style="p">
    <verse number="31" style="v" />htingrai hkungga matu, bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sanit ya du ai shani hta, usu uram sanit, sagu la lahkawng, ra n rawng ai hte ladu hkrum ai sagu la kasha shi mali nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="33" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna, htung hking hte maren lawm na rai nga ai:
  </para>
  <para style="p">
    <verse number="34" style="v" />htingrai hkungga matu, bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Matsat ya du ai shani hta chyoi pra ai zuphpawng hpawng na rai myit dai; amu bungli galaw lu na n rai;
  </para>
  <para style="p">
    <verse number="36" style="v" />dai shani e, Yehowa a manam pyaw sangau shatai na wan nat hkungga matu, usu langai mi, sagu la langai mi, ra n rawng ai hte ladu hkrum ai sagu la kasha sanit wan hte nawng na rai myit dai:
  </para>
  <para style="p">
    <verse number="37" style="v" />shadung kumhpa hte ru hkaw kumhpa mung, usu, sagu la, sagu kasha ni a nambat hkan nna, htung hking hte maren lawm na rai nga ai;
  </para>
  <para style="p">
    <verse number="38" style="v" />htingrai hkungga matu, bainam la langai mi mung nawng na rai myit dai; shing rai tutnawng na wan nat hkungga hte de a shadung kumhpa, ru hkaw kumhpa hta kaga kahtap jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai gaw, ga shaka da nna jau ai kumhpa, mayu e jau ai kumhpa ngu ai, wan nat kumhpa, shadung kumhpa, ru hkaw kumhpa re ai ni hta jan nna, nanhte a madat da ai poi ni hta, Yehowa hpe kahtap jaw na rai myit dai. ngu wu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mawshe mung Yehowa shi hpe hkang da mada yawng, Israela kashu kasha ni hpe htawn shana wu ai.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Mawshe gaw Israela amyu a agyi ni hpe, Da ndai gaw Yehowa hkang da ai lam rai nga ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />Lasha langai ngai Yehowa hpe ga shaka da ai rai yang mung, tinang myit masin hpe hkang shadang na nga dagam da ai rai yang mung, tinang n-gup hta tsun matsun hte maren hkan shatup lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tinang kawa a nta e naw nga ai mahkawn numsha gaw, tinang hkum hpe hkang shadang na nga, Yehowa hpe ga shaka da ai rai yang:
  </para>
  <para style="p">
    <verse number="4" style="v" />dai ga shaka hte hkang shadang ai ga hpe kawa gaw na ninglen atsin sha nga ai rai yang gaw, dai ga shaka mung, tinang hkum hpe hkang shadang ai lam shagu mung, grin nga lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na ai shani jang kawa hkum ai rai jang gaw, kaning nga shaka ai ga rai timung, tinang myit masin hpe kaning nga hkang shadang ai lam rai timung grin lu na n rai; kawa hkum ai majaw Yehowa mung dat kau na rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dinghku num langai ngai ga shaka da ai hte tinang a myit masin hkang shadang na hku tsun hkrup yang,
  </para>
  <para style="p">
    <verse number="7" style="v" />shi a madu wa dai hpe na ninglen, na ai shani e atsin sha nga ai rai yang gaw, dai numsha a ga shaka hte shi a myit masin hkang shadang ai lam grin nga lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai timung, na ai shani jang, madu wa shi hpe hkum kau ai rai yang gaw, dai ga shaka hte shi a myit masin hpe hkang shadang ai lam gaw, madu wa shabai kau nu ai rai nna, Yehowa mung dat kau na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gaida jan rai yang mung, madu wa hte hka sai num rai yang mung, tinang a ga shaka hte myit masin hpe hkang shadang ai lam shagu gaw, grin nga lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Madu wa hte naw rai yang, ga shaka ai rai yang mung, dagam ai hte tinang myit masin hkang shadang ai rai yang mung,
  </para>
  <para style="p">
    <verse number="11" style="v" />na ninglen madu wa n hkum ai sha atsin sha nga ai rai yang gaw, ga shaka da ai mung, shi a myit masin hpe hkang shadang ai lam shagu mung grin nga lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung, na ai shani jang madu wa shabai kau sai rai jang gaw, tinang a n-gup na pru ai ga shaka hte seng ai ga mung tinang a myit masin hpe hkang shadang ai hte seng ai lam shagu mung, grin nga lu na n rai: dai hpe madu wa shabai kau nu ai rai nna, Yehowa mung dat kau na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ga shaka lam magup hpe mung, tinang myit masin hpe shagrit nga na, hkang shadang ai dagam ga shagu hpe mung, madu wa shagrin yang grin, shabai yang bai, rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Madu wa mung, lani hte lani atsin sha nga nga ai rai yang gaw, madu jan da ai ga shaka yawng hte, madu jan hta hkang shadang ai lam shagu gaw shagrin ai rai nga ai: na ai shani jang nna atsin sha nga nga sai majaw, shagrin da sai rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai hpe madu wa gaw na da nhtawm, hpang e she shabai na maw ai rai yang gaw, madu jan a yubak madu wa gun lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai hte gaw, madu jan hte madu wa a laman na lam kawa a nta e naw nga ai mahkawn num shayi sha hte kawa a laman na lam, Yehowa Mawshe hpe hkang da ai matsun maroi rai nga ai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa Mawshe hpe,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe woi shut ai matu Midian masha ni hpe matai htang mu: shing rai nna she, nang na amyu hpawng nga ai de wa na rai ndai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawshe mung amyu masha ni hpe shaga nna, “Hpyen gasat sa na matu, ri nhtu lang ai masha nanhte hta na lata la nna, Yehowa a matai sa htang ya na, Midian masha ni hpe sa gasat ma su:
  </para>
  <para style="p">
    <verse number="4" style="v" />Israela amyu ting na amyu mi hta masha hkying hkying shinggyin nna sa gasat shangun mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte mung Israela masha hkying mun hta na, amyu mi hta marai hkying hkying shinggyin nna, hpyen gasat na matu ri nhtu lang ai masha mun me hkying lahkawng ap ya mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shing rai Mawshe gaw, hpyen gasat na matu, chyoi pra ai nta na arai ni hte dum garu na pahtau lang ai hkinjawng Eleaza a kasha Hpineha hte rau, amyu shagu hta na masha hkying hkying shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa Mawshe hpe hkang dat wu ai hte maren, Midian masha ni hpe shanhte gasat nna, lasha nlang hte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sat kau hkrum ai ni hta na, Ewi, Rekem, Zura, Hura, Reba ngu ai Midian hkawhkam manga lawm ma ai: Beora kasha Balam hpe mung nhtu hte sat kau mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israela kashu kasha ni gaw Midian numsha ni hte ma kaji ni hpe rim la mu ai: shanthe a nga dumsu yawng, sagu bainam hpung yawng hte arung arai yawng magawn wa ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte a nga shara mare kahtawng ni yawng hte, shanhte a dap ni yawng hpe nat kau ya mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai shanhte gaw masha hte yamnga lanep magawn la nna,
  </para>
  <para style="p">
    <verse number="12" style="v" />Moba pa, Yawdan hka kau, Yerihko tawtap e dap jung nga ai Mawshe yan hkinjawng Eleaza hte Israela kashu kasha shawa hpung hpang de bawng ni hte lu la ai lanep la wa ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Mawshe yan hkinjawng Eleaza hte shawa hpung na du agyi ni gaw, shanhte hpe tau la na nga, dap shinggan de pru sa ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mawshe chyawm gaw, hpyen gasat ai kaw na bai wa ai, masha hkying up, latsa up re ai luksuk bu ni hpe masin pawt nna,
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai numsha ni mahkra hpe nanhte jahkrung da mu ai?
  </para>
  <para style="p">
    <verse number="16" style="v" />Yu mu, shanhte Balam daw ya ai hpaji hkan nna, Israela kashu kasha ni hpe Peora lam hta Yehowa a man e shut hpyit shangun mu ai majaw, Yehowa a shawa hpung hta dai ari zinli du ai re.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai rai nna, ma kaji ni hta lasha ma nlang hpe mung, la hkrum yu sai numsha nlang hpe mung, sat kau mu.
  </para>
  <para style="p">
    <verse number="18" style="v" />La garai n hkrum yu ai numsha ma nlang hte hpe gaw nanhte a matu jahkrung da mu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nanhte gaw dap shinggan e sanit ya tup naw but nga mu: masha sat ai wa, si mang hkra ai wa kadai mung, bawng ni hte hpawn, masum ya shani hte sanit ya shani hta tinang hkum hpe jasan jaseng mu ga.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai hta kaga, hpun palawng yawng hte shanhpyi arai nlang; bainam mun hte da ai arai nlang, hpun hte galaw ai arai nlang hpe mung, jasan jaseng kau mu,” ngu nna hkang da wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bai, hkinjawng Eleaza mung hpyen sa gasat ai masha ni hpe, “Yehowa Mawshe hpe hkang da ai tara gaw dai rai nga ai:
  </para>
  <para style="p">
    <verse number="22" style="v" />rai timung, aja, gumhpraw, magri, ahpri, ajang, achyu re ai,
  </para>
  <para style="p">
    <verse number="23" style="v" />wan hta hkam lu ai arai ni hpe gaw, wan hta galip shalai kau na rai myit dai; shaloi san seng na ra ai; dai hta n-ga jasan jaseng ai ntsin hta mung; jasan jaseng na rai myit dai: wan hta n hkam lu ai arai ni hpe chyawm gaw ntsin hta sha kapruk shalai na rai myit dai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sanit ya nhtoi hta, tinang a hpun palawng nanhte hkrut kau nna, san seng na mara ai: shing rai nna dap de bai shang lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nang mung hkinjawng Eleaza hte shawa hpung na agyi salang ni mung, ya la wa ai masha hte yamnga lanep nlang hte hpe hti yu nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />hpyen sa gasat ai hpyen ma ni hpe ka-ang hkup, shawa hpung ting hpe ka-ang hkup di karan ya u.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bai, hpyen sa gasat ai hpyen ma ni hta na, Yehowa a kang matu shanhte lu ai masha hte dumsu, lawze, sagu bainam hkum manga tsa hta na hkum mi hta la nna,
  </para>
  <para style="p">
    <verse number="29" style="v" />shanhte lu ai ka-ang hkup ting na shaw la nhtawm, Yehowa a manawt hkungga di na hkinjawng Eleaza hpe ap ya mu.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bai, Israela kashu kasha ni lu ai ka-ang hkup hta na mung, masha hte dumsu, lawze, sagu bainam re ai yamnga hkum manga shi hta na hkum mi hta la nna, Yehowa a sumpan nta amu gun hpai ai Lewi masha ni hpe jaw mu,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yehowa Mawshe hpe hkang da wu ai hte maren, Mawshe yan hkinjawng Eleaza galaw ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ya, lanep rai gale hta kaga, hpyen masha ni magawn wa ai gaw, sagu bainam sen kru e mun sanit hkying manga;
  </para>
  <para style="p">
    <verse number="33" style="v" />nga dumsu mun sanit e hkying lahkawng;
  </para>
  <para style="p">
    <verse number="34" style="v" />lawze mun kru e hkying mi;
  </para>
  <para style="p">
    <verse number="35" style="v" />la garai n hkrum yu ai numsha yawng mun masum e hkying lahkawng rai nga ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai hta na hpyen sa gasat ai ni lu la ai ka-ang hkup gaw, sagu bainam sen masum e mun masum hkying sanit e manga tsa rai nga ai rai nna,
  </para>
  <para style="p">
    <verse number="37" style="v" />Yehowa a kang gaw sagu bainam kru tsa e sanit shi manga rai nga ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dumsu mun masum e hkying kru rai nga ai rai nna, Yehowa a kang gaw sanit shi lahkawng rai nga ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lawze mun masum e manga tsa rai nga ai rai nna, Yehowa a kang gaw kru shi langai rai nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Masha mun mi hkying kru rai nga ai rai nna, Yehowa a kang gaw marai sumshi lahkawng rai nga ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Yehowa Mawshe hpe hkang da wu ai hte maren, Yehowa a matu manawt hkungga di na kang hkinjawng Eleaza hpe Mawshe ap ya wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Bai, sa gasat ai ni a lata na, Israela kashu kasha ni hpe Mawshe karan ya ai kumhtaw gaw,
  </para>
  <para style="p">
    <verse number="43" style="v" />sagu bainam sen masum e mun masum hkying sanit e manga tsa:
  </para>
  <para style="p">
    <verse number="44" style="v" />nga dumsu mun masum e hkying kru;
  </para>
  <para style="p">
    <verse number="45" style="v" />lawze mun masum e manga tsa;
  </para>
  <para style="p">
    <verse number="46" style="v" />masha mun mi hkying kru rai nga ai rai nna,
  </para>
  <para style="p">
    <verse number="47" style="v" />Israela kashu kasha ni a kumhtaw hta na, masha hte yamnga hkum manga shi hta hkum mi Mawshe hta la nhtawm, Yehowa a sumpan nta amu gun hpai ai Lewi masha ni hpe jaw wu ai; dai gaw Yehowa Mawshe hpe hkang da ai lam rai nga ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Dai hpang hpyen luksuk na hpyen agyi ni ngu ai, hpyen hkying mi up, latsa up bu ni gaw Mawshe hpang de sit sa nna,
  </para>
  <para style="p">
    <verse number="49" style="v" />“Anhte a npu na hpyen ma ni hpe na a mayam ni hti yu yang, langai mi mung n yet ma ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Dai rai nna, anhte a asak matu Yehowa man e htingrai htingrat ya na, masha langai hte langai lu la ai, lagaw shanghkawng, lahkawn, dazik lachyawp, lakan, gumrit re ai aja rai, Yehowa hpe kumhpaw kumhpa sak jaw na anhte la sa ra ga ai,” ngu nna Mawshe hpe tsun mu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Shaloi Mawshe yan hkinjawng Eleaza gaw, shanhte a mawn sumli ai baw aja rai yawng hpe hkap la da mu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hpyen masha ni langai hte langai tinang nang a matu lanep lu la ma ai rai nna,
  </para>
  <para style="p">
    <verse number="53" style="v" />hpyen hkying up, latsa up bu ni Yehowa hpe sak jaw ai manawt kumhpa aja gaw, shekela mun mi hkying kru e sanit tsa manga shi rai malu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Shing rai Mawshe yan hkinjawng Eleaza gaw hpyen hkying up, latsa up bu ni jaw ai ja hpe hkap la nna, Israela kashu kasha ni a matu Yehowa a man e masat dingsat shatai na shawa sum kata e shawn da mu ai.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya Rubin a matu ni hte Gad a matu ni gaw, yamnga nachying law malu ai rai nna, Yazera mung hte Gilead mung hta yamnga a matu udat shara kaja nga ai hpe shanhte mu ma yang,
  </para>
  <para style="p">
    <verse number="2" style="v" />Gad hte Rubin matu ni gaw Mawshe yan hkinjawng Eleaza hte shawa hpung a du gyi ni kaw sa nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Israela hpung masha ni a man na Yehowa shaza kau ai,
  </para>
  <para style="p">
    <verse number="4" style="v" />Atarot, Dibon, Yazera, Nimra, Heshbon, Eleale, Sebam, Nebo, Beon mung ni gaw, yamnga rem na matu kaja la nga ai: na a mayam ni hta mung yamnga law nga mali ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />dai rai nna, na man e anhte myi man pa ga ai rai yang gaw, ndai lamu ga ni na a mayam ni hpe madu shangun mi, Yawdan hka wora hkran de anhte hpe hkum woi rap nit,” ngu nna hpyi mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawshe chyawm gaw Gad hte Rubin matu ni hpe, “Nanhte gaw ndai hkran e hti nga nna, nanhte a kahpu kanau ni gaw hpyen gasat sa wa na rai nga a ni?
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa jaw ai mung hpe Israela kashu kasha ni n rap la na hku, shanhte a myit hpe hpa rai jahten na myit ta?
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai mung hpe yu yu na matu, nanhte a kawa ni hpe Kadesha-barnea kaw nna ngai shangun dat ai shaloi mung, ndai zawn rai masai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte gaw Eshkola kadit du hkra sa nna, dai mung hpe mada yu da nhtawm, Yehowa jaw ai mung de Israela kashu kasha ni n shang sha na hku, shanhte a myit hpe jahten ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai shani e Yehowa pawt bu ai hte,
  </para>
  <para style="p">
    <verse number="11" style="v" />Gaja wa teng teng, Abraham, Isak, Yaku hte hte ngai dagam nna jaw ai mung de, Egutu mung na pru wa ai ni hta na kadai mung nye a lam htep lahti n hkan ma ai majaw, Keni lakung Yehpuna a kasha Hkaleb hte Nun a kasha Yawshu hta kaga, asak hkun ning lai ai ni langai mi muk shang lu na n rai;
  </para>
  <para style="p">
    <verse number="12" style="v" />dai yan chyawm gaw Yehowa a lam htep lahti hkan masai, nga nna dagam kau ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa mung Israela amyu hpe pawt bu ai rai nna, Yehowa a man e n shawp ai hku galaw ai ni nlang htum mat ga du hkra, shi shanhte hpe dai nam mali hkan e mali shi ning tup kayin hkawm shangun kau ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ya mung Yehowa, Israela kashu kasha ni hpe grau nna pawt bu na hku, grau n shawp ai ni nanhte gaw, nanhte a kawa ni a malai bai dawng pru marin hka i?
  </para>
  <para style="p">
    <verse number="15" style="v" />Nanhte shi a lam na mashe shang jang, shi shanhte hpe dai nam mali e bai kau da nna ndai amyu masha yawng hpe nanhte jahten kau na marin dai,” ngu nna hkap daru wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte chyawm gaw shi hpang de sit sa nna, “Anhte gaw nang e anhte a yamnga ni a matu ulawng, anhte a ma kaji ni a matu mare de da na ga ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />anhte hkum chyawm gaw Israela kashu kasha ni hpe, shanhte nga na shara de du ai du hkra, ri nhtu lang let shanhte a man e sa wa na ga ai: rai timung, ndai yang na mung masha ni a majaw, anhte a ma kaji ni bunghku kum ai mare ni hta nga ra na rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israela kashu kasha ni nlang shanhte a sali mungdan de garai n shang sha lu lu gaw, anhte mung tinang nta de n wa na ga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yawdan hka wora hkran e shanhte hte rau lamu ga sali anhte n madu na ga ai; anhte a lamu ga sali gaw Yawdan hka sinpraw hkran rai nga mali ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai Mawshe mung shanhte hpe, “Nanhte dai hku galaw nna, hpyen gasat na matu ri nhtu lang let Yehowa a man e nanhte sa wa ai hte,
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa gaw shi hpe hpyen ai ni e, shi a man na gawt kau nna dai mungdan hpe dang la lu ai du hkra, nanhte yawng ri nhtu lang let Yehowa a man e Yawdan hka wora hkran rap sa myit yang gaw;
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa a man e mung, Israela masha ni a man e mung, nanhte mara lawt lu ai hte, ndai de bai wa nna, Yehowa a ahkang hte ndai mungdan sali nanhte wa madu lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai hku n galaw myit yang chyawm gaw, nanhte Yehowa hpe shut myit dai rai nna, gaja wa teng teng nanhte a mara gaw nanhte hpe hkan dep na ra ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nanhte a ma kaji ni a matu mare mung, sagu bainam ni a matu ulawng mung, de da manu: ya tsun matsun hte maren wa galaw ma su,” ngu dat wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shaloi Gad hte Rubin matu ni Mawshe hpe, “Nang madu hkang dat ai hte maren, na a mayam ni galaw na ga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anhte a madu jan kasha ni hte sagu bainam, yamnga yawng gaw, ndai Gilead mare ni hta nga nga na rai ma ai;
  </para>
  <para style="p">
    <verse number="27" style="v" />na a mayam ni chyawm gaw, nang madu tsun ai hte maren, ri nhtu lang ai ni yawng, hpyen gasat na matu, Yehowa a man e rap sa wa na ga ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi Mawshe gaw, shanhte a lam majaw hkinjawng Eleaza yan Nun a kasha Yawshu hte Israela kashu kasha ni a amyu du salang ni hpe ga madat tsun da wu ai gaw:
  </para>
  <para style="p">
    <verse number="29" style="v" />Gad matu ni hte Rubin matu ni hta ri nhtu lang ai ni yawng hpyen gasat na matu Yehowa a man e nanhte hte rau Yawdan hka wora hkran rap nna, dai mungdan hpe nanhte dang la lu jang, shanhte hpe Gilead mung madu shangun na rai myit dai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai n rai, shanhte nanhte hte rau ri nhtu hte n rap ma yang gaw, Hkanan mung e nanhte hte rau lamu ga jawm madu lu na rai ma ai,” ngu nna tsun da wu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shaloi Gad hte Rubin matu ni mung, “Yehowa, na a mayam ni hpe tsun ai hte maren anhte hkan galaw na ga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anhte ri nhtu hte Yehowa man e Hkanan mung hkran de rap nang na ga ai; anhte a lamu ga sali chyawm gaw Yawdan hka sinpraw hkran de rai na rai nga ai,” ngu nna bai htan mu ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai rai nna Mawshe gaw, “Amori hkawhkam Sihon a mungdan hte seng ai lamu ga, Bashan hkawhkam Oga a mungdan hte seng ai lamu ga hte de a ginwang na mare kahtawng ni nlang Gad matu ni, Rubin matu ni hte Yawsep a kasha Manashe lakung na hkrat ai amyu chyen mi hpe ap ya mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shing rai Gad matu ni gaw, Dibon, Atarot, Aroera;
  </para>
  <para style="p">
    <verse number="35" style="v" />Atrot-shohpan, Yazera, Yogbeha;
  </para>
  <para style="p">
    <verse number="36" style="v" />Bet-nimra, Bet-haran mare ni hpe de ma ai; dai ni gaw bunghku kum ai sagu bainam lawng mare rai nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Rubin matu ni gaw, Heshbon, Eleale, Kiriatim,
  </para>
  <para style="p">
    <verse number="38" style="v" />amying lai ai Nebo, Bala-meon hte Sibma mare ni hpe de ma ai: shanhte gaw de da ai mare ni hpe mying ningnan galai shamying mu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Manashe hta na hkrat ai Mahkira matu ni mung Gilead ga de sa nhtawm, dai yang na Amori masha ni hpe htawk kau nna dai hpe madu la mu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mawshe mung Manashe a kasha Mahkirai matu ni hpe Gilead mung jaw mu ai rai nna, shanhte dai yang nga nga ma ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Manashe a lakung hta na Ya-ira ngu ai wa mung dai mung na mare ni hpe lu la nna, Hawot-Ya-ira ngu nna shamying wu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Noba ngu ai wa mung Kenat ginwang hte de a kahtawng ni hpe sa madu la nna, shi a amying hkan nna Noba ngu shamying wu ai.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Da ndai gaw, Mawshe yan Arun a lata hte Egutu mung na pru hkawm wa ai Israela kashu kasha wunawng wuwa ni a sat sa wa ai bu lam rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa hkang da ai hte maren, shanhte sat sa wa ai lam na dabang ni hpe Mawshe ka matsing da ai rai nna, ndai gaw shanhte sa wa ai lam na dabang jahpan rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw shata langai ngu na hta nhtoi shi manga ya e Ramese mare na pru wa ma ai: shalai dat ai poi galaw ngut ai hpang jahpawt e, Israela kashu kasha ni gaw Egutu masha ni nlang a man na gumrawng gumra rai pru wa ma ai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Egutu masha ni chyawm gaw, Yehowa sat kau ya ai shanhte a kasha alat ni hpe lup makoi nga ma ai: shanhte a hpara ni hpe mung Yehowa dawdan wu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Israela kashu kasha ni gaw Ramese kaw na pru nna Suhkut e but ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Suhkut na htawt ai gaw nam de jahtum ai Ehtam e, shanhte but ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ehtam na htawt ai gaw, Bala-zehpun tawtap na Hpi-hahirot de kayin nhtawm, Migdola ang e but ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpi-hahirot na htawt ai gaw nawng ka-ang hku shanhte ga rap wa nna dai nam mali de du ma ai: Ehtam nam mali e nhtoi masum ya sat hkawm nhtawm Mara e but ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mara na htawt ai gaw Elim de du ma ai: Elim shara e hka deng shi lahkawng hte namhtan hpun sanit shi tu nga ai rai nna, dai yang e shanhte but ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Elim na htawt ai gaw nawng hkyeng makau e but ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nawng hkyeng na htawt ai gaw Sin mali e but ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sin mali na htawt ai gaw Dophka shara e but ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dophka na htawt ai gaw Alusha e but ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alusha na htawt ai gaw Rehpidim e but ma ai; dai gaw amyu masha ni lu na ntsin n nga ai shara rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rehpidim na htawt ai gaw Sina nam e but ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sina nam na htawt ai gaw Kibrot-hatawa e but ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kibrot-hatawa na htawt ai gaw Hazerot e but ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hazerot na htawt ai gaw Ritma shara e but ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ritma shara na htawt ai gaw Rimon-pereza e but ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rimon-pereza na htawt ai gaw Libna e but ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Libna shara na htawt ai gaw Risa e but ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Risa na htawt ai gaw Kehelat e but ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kehelat na htawt ai gaw Shehpa bum e but ma ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shehpa bum na htawt ai gaw Harada e but ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Harada shara na htawt ai gaw Makhelot e but ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Makhelot na htawt ai gaw Tahat e but ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahat na htawt ai gaw Tera e but ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tera na htawt ai gaw Mithka e but ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mithka na htawt ai gaw Hasmona e but ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hasmona shara na htawt ai gaw Moserot e but ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Moserot na htawt ai gaw Bene-yakan e but ma ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bene-yakan na htawt ai gaw Hora-hagida e but ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hora-hagida na htawt ai gaw Yobahta e but ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yobahta na htawt ai gaw Abrona shara e but ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abrona shara na htawt ai gaw Ezion-gebera e but ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ezion-gebera shara na htawt ai gaw Kadesha ngu ai Zin nam mali e but ma ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kadesha shara na htawt ai gaw, Edom mung jarit na Hora bum e but nga ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ya, Israela kashu kasha ni Egutu mung na pru wa ai kaw nna mali shi ning du ai shaning, shata manga ngu na a langai ya shani e, Yehowa a ga hte maren hkinjawng Arun gaw Hora bum de lung nna si mat ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Arun gaw Hora bum e si mat ai shaloi, shi a asak latsa e hkun masum ning rai lu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Dai shaloi e, Hkanan mung a dingda maga e nga ai, Hkanan amyu masha Arad hkawhkam gaw, Israela kashu kasha ni du lung wa ai lam na wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Bai shanhte Hora bum na htawt ai gaw Zalmona e but ma ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zalmona shara na htawt ai gaw Punon e but ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Punon na htawt ai gaw Obut e but ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Obut na htawt ai gaw, Moba mung a lamu ga jarit na Iye-abarim e but ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Iye-abarim na htawt ai gaw Dibon-gad e but ma ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dibon-gad na htawt ai gaw Almon-diblatim e but ma ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Almon-diblatim na htawt ai gaw, Nebo bum tawtap na Abarim bum e but ma ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Abarim bum na htawt ai gaw, Moba pa, Yawdan hka hkran, Yerihko tawtap e but ma ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shing rai Moba pa, Yawdan hka hkran, Bet-yeshimot shara kaw nna Abela-shitim du hkra, shanhte but hkawm wa ma ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Shaloi Yehowa, Moba pa, Yawdan hka hkran Yerihko tawtap e Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="51" style="v" />“Israela kashu kasha ni hpe ning ngu tsun u, ‘Nanhte Yawdan hka rap nna Hkanan mung du jang,
  </para>
  <para style="p">
    <verse number="52" style="v" />dai mung na amyu masha ni mahkra hpe nanhte shachyut kau nna, shanhte a tawk ka ai nlung ni yawng hpe mung, shanhte jaw ai sumla ni yawng hpe mung, agrawp kau na hte, shanhte a tsaw ai kawng na shara ni yawng hte hpe hpya kau ya na rai myit dai:
  </para>
  <para style="p">
    <verse number="53" style="v" />ngai nanhte hpe dai mungdan madu shangun masade ai majaw, dai mungdan hpe nanhte madu lu nna dai hta e anga nga na rai myit dai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Nanhte a amyu lakung dap hkan nna, hpaida da ai hte dai lamu ga karan la na rai myit dai; law ai ni hpe law ai sali ga, n law ai ni hpe n law ai sali ga karan jaw na rai myit dai; langai hte langai hpaida ang ai hte maren lamu ga lu la na rai myit dai; kaji kawa amyu mying hkan nna, nanhte sali ga lu la na rai myit dai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Dai mung masha ni hpe nanhte atsai awai n shachyut kau myit yang, naw ngam nga ai ni gaw, nanhte a myi hta ju shingna zawn, nanhte a garep hta masawn zawn tai nna, nanhte nga nga ai mungdan hta e nanhte hpe shatsang na mara ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Shing rai, shanhte hpe ngai galaw na maw ai zawn, ngai nanhte hpe di na made ai,” ngu wu ai.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai, Yehowa Mawshe hpe,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe ning ngu hkang dat u: ‘Nanhte Hkanan mung de du ai shaloi, nanhte madu lu na Hkanan mung na lamu ga jarit gaw ndai hku rai na rai nga ai:
  </para>
  <para style="p">
    <verse number="3" style="v" />dingda maga de rai yang, Zin mali kaw nna Edom mung ret, dingda maga ngu na lamu ga jarit gaw, Jum nawng jut kaw nna sinpraw de hprat rai na rai nga ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />dai jut kaw nna matut ai jarit gaw Akrabim bum hpe dingda de hkan nna, Zin mali hku ret, Kadesha-barnea dingda de hprang, Hazarada hku hkrawn Azmon shara e byawn rai na rai nga ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />Azmon kaw nna dai jarit kayin nhtawm, Egutu hka shi hkan nna nammukdara e htum na rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sinna maga de na lamu ga jarit gaw, nammukdara kaba rai na rai nga ai; dai gaw nanhte a sinna maga ngu na rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dingdung ngu na lamu ga jarit gaw, nammukdara kaba kaw nna Hora bum hprat rai na rai nga ai;
  </para>
  <para style="p">
    <verse number="8" style="v" />bai Hora bum kaw nna Hamat hku hkrawn, Zedad shara e byawn;
  </para>
  <para style="p">
    <verse number="9" style="v" />bai Zehpron shara e hprang rai nna, Hazera-enan e htum na rai nga ai: dai gaw dingdung maga na nanhte a lamu ga jarit rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sinpraw maga de na lamu ga jarit gaw, Hazera-enan kaw nna Shehpam shara hku hkrawn;
  </para>
  <para style="p">
    <verse number="11" style="v" />bai Shehpam kaw nna Ain shara na sinpraw hku hprang, Ribla de byawn; bai dai kaw nna Genesaret ngu ai nawng a sinpraw hkran hku garet nhtawm,
  </para>
  <para style="p">
    <verse number="12" style="v" />Yawdan hka hkan nna Jum nawng e tut rai na rai nga ai: dai gaw nanhte madu lu ai mungdan a lamu ga jarit rai nga ai,” ngu nna tsun wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bai Mawshe Israela kashu kasha ni hpe, “Ndai hte gaw Yehowa hkang da ai hte maren, hpaida da ai hte dai amyu jahku e chyen mi hpe karan jaw na lamu ga rai nga ai:
  </para>
  <para style="p">
    <verse number="14" style="v" />Rubin amyu na lakung lama ni, Gad amyu na lakung lama ni hte Manashe amyu chyen mi gaw, tinang a lamu ga sali lu la masai:
  </para>
  <para style="p">
    <verse number="15" style="v" />dai amyu lahkawng e chyen mi gaw, Yawdan hka hkran, Yerihko tawtap na jan praw hkran ga madu manu ai,” ngu nna Israela kashu kasha ni hpe hkang dat wu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai Yehowa Mawshe hpe,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Da ndai gaw, hkinjawng Eleaza yan Nun a kasha Yawshu hpe tau nna, nanhte lu la na lamu ga sali karan jaw na ni a amying ni rai nga ai:
  </para>
  <para style="p">
    <verse number="18" style="v" />nanhte gaw amyu langai mi hta na du langai ngai, dai lamu ga sali karan jaw na matu lata la na rai myit dai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte a amying gaw ndai rai nga ai: Yuda amyu hta na Yehpuna a kasha Hkaleb.
  </para>
  <para style="p">
    <verse number="20" style="v" />Simun amyu hta na Amihuda kasha Shemuela;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ben-yamin amyu hta na Hkislon a kasha Elida;
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan amyu matu ni hta na Yogli a kasha, du Buki;
  </para>
  <para style="p">
    <verse number="23" style="v" />Yawsep a kasha yan hta na, Manashe amyu matu Ehpod a kasha, du Haniela;
  </para>
  <para style="p">
    <verse number="24" style="v" />Ehprim a amyu matu Shiphtan a kasha, du Kemuela;
  </para>
  <para style="p">
    <verse number="25" style="v" />Zebulun a amyu matu hta na, Parnak a kasha du Elizahpan;
  </para>
  <para style="p">
    <verse number="26" style="v" />Yisahka amyu matu ni hta na Azan a kasha, du Palatiela;
  </para>
  <para style="p">
    <verse number="27" style="v" />Ashe amyu matu ni hta na, Shelomi kasha, du Ahihuda;
  </para>
  <para style="p">
    <verse number="28" style="v" />Naphtali amyu matu ni hta na, Amihuda kasha, du Pedahela hte rai ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai hte gaw, Israela kashu kasha ni hpe Hkanan mung e sali ga karan jaw na matu, Yehowa san da ai ni rai ma ai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bai Yehowa, Moba pa, Yawdan hka hkran, Yerihko tawtap e Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israela kashu kasha ni hpe, shanhte lu la ai sali ga hta, Lewi masha ni nga na matu, mare karan jaw na lam, ning ngu hkang da u: ‘dai mare ni a grup yin ginwang ga mung, Lewi masha ni hpe nanhte karan jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai mare ni gaw, shanhte a nga shara tai nna, mare grup yin ginwang ga gaw shanhte a arung arai da shara hte sagu dumsu, yamnga ni a udat shara rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lewi masha ni hpe nanhte jaw na mare ginwang ga gaw, mare bunghku kaw nna shadawn yang, grup yin dawng hkying hkying gang na rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shing rai nanhte gaw dai mare shinggan ngu na de sinpraw maga dawng hkying lahkawng, sinna maga dawng hkying lahkawng, dingdung maga dawng hkying lahkawng, dingda maga dawng hkying lahkawng di nna shadawn nhtawm, de a ka-ang e mare de na rai nga ai: dai gaw shanhte a mare ginwang ga a shadawn rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lewi masha ni hpe nanhte jaw na mare ni gaw, masha sat hkrup ai wa hprawng shingbyi lu na, dai mare kru rai na rai nga ai: dai hta kaga mare mali shi lahkawng naw jat jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai Lewi masha ni hpe nanhte jaw na mare yawng gaw, mare mali shi matsat rai na rai nga ai; dai ni hpe ginwang ga hte nawng, nanhte jaw na rai myit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai mare ni hpe Israela kashu kasha ni madu ai sali ga hta na, lamu ga law ai ni law ai hku, n law ai ni n law ai hku, karan jaw na rai mu ai: langai hte langai tinang madu lu ai sali ga hkan nna, Lewi masha ni hpe mare jaw na rai mu ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bai Yehowa Mawshe hpe tsun wu ai gaw,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israela kashu kasha ni hpe ning ngu tsun mu: ‘Nanhte Yawdan hka rap nna Hkanan mung de du jang,
  </para>
  <para style="p">
    <verse number="11" style="v" />masha hkala sat ai wa hprawng shingbyi lu na mare, lata tawn na rai myit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai mare ni gaw, masha sat ai wa shawa hpung a man e tara garai n dara rau ai laman e, matai htang ai wa a lata na lawt lu hkra, hprawng shingbyi na mare ni rai na, rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nanhte jaw tawn da lu na mare ni, hprawng shingbyi mare kru rai na, rai nga ai,
  </para>
  <para style="p">
    <verse number="14" style="v" />Yawdan hka wora hkran de mare masum, Hkanan mung hta mare masum rai na rai malit dai: dai ni gaw hprawng shingbyi na mare ni rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai mare kru gaw, Israela kashu kasha ni a matu mung, tsasam manam hte sa shingbyi nga ai amyu kaga wa a matu mung, hprawng shingbyi na mare rai nga ai: masha hkala sat ai wa kadai mung, dai de hprawng lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rai timung, hpri arai hte masha hpe si hkra adup ai rai yang, dai wa gaw masha sat ai wa nan rai nga ai: masha sat ai wa gaw, sat kau ai teng teng hkrum lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Si ram ai nlung hte masha hpe kabai sat ai rai yang, dai wa gaw masha sat ai wa nan rai nga ai: masha sat ai wa gaw, sat kau ai teng teng hkrum lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Si ram ai hpuntawng hte masha hpe kayat sat ai rai yang, dai wa gaw masha sat ai wa nan rai nga ai: masha sat ai wa gaw, sat kau ai teng teng hkrum lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Matai htang ai wa gaw, masha sat ai wa hpe, shi nan sat na rai wu ai: shi hpe hkrum ai shaloi jang, shi hpe sat kau na rai wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Masha wa hpe n dawng ai myit hte kanawng jahkrat ai rai yang mung, gyam nna lama ma hte kabai sat ai rai yang mung,
  </para>
  <para style="p">
    <verse number="21" style="v" />n dawng ai myit rawng nna lata hte htwi sat ai rai yang mung, shing re ai wa gaw masha sat ai wa rai nga ai majaw, sat kau ai teng teng hkrum lu na rai nga ai: matai htang ai wa gaw masha sat ai wa hpe hkrum ai shaloi jang shi hpe sat kau na rai wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shing n rai, n dawng ai myit n rawng ai she, kanawng jahkrat hkrup ai rai yang mung, gyam ai n re ai she lama ma hte kabai sat hkrup ai rai yang mung,
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi hpe hpyen ai mung n rai, n dawng nna dingsa di ai mung n rai, shi hpe n mu nna she, si hkra nlung hta kabai hkra hkrup ai rai yang mung;
  </para>
  <para style="p">
    <verse number="24" style="v" />ndai tara lam hkan nna shawa hpung gaw, masha sat ai wa hte matai htang ai wa a lapran e hparan ya na rai mu ai:
  </para>
  <para style="p">
    <verse number="25" style="v" />dai shawa hpung gaw masha sat ai wa hpe matai htang ai wa a lata na shaw la nhtawm, shi hprawng shingbyi ai mare de bai sa da na rai mu ai; shaloi dai wa gaw, chyoi pra ai namman chya hkam ai hkinjawng agyi wa si ai shani du hkra, dai mare hta anga nga lu na rai wu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rai timung, masha sat ai wa gaw, shi hprawng shingbyi nga ai mare ginwang na pru lai nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />matai htang ai wa gaw dai mare a ginwang shinggan e shi hpe mu ai hte sat kau ai rai yang, dai wa hta bunglat hka nga na n rai:
  </para>
  <para style="p">
    <verse number="28" style="v" />kaning rai nme law, hkinjawng agyi wa si ai shani du hkra, shi a shingbyi mare hta anga nga lu na rai nga ai; hkinjawng agyi wa si yang she masha sat ai wa gaw shi a nga shara mare de nhtang wa lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ndai gaw nanhte a nga shara shagu hta, shu mashi shu masha prat dingsa hkan nga na tara matsun rai na rai nga ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Masha hpe sat ai wa kadai mung, sakse ni a ga hte sat kau ai hkrum lu na rai nga ai: rai timung, sakse langai a ga hte sha gaw sat kau ai hkrum lu na n rai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Masha sat nna si ging sai wa a asak jahpu nanhte hkap la lu na n rai: dai wa gaw sat kau ai teng teng hkrum na rai wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hkinjawng wa garai n si yang, shi a shingbyi mare e sa hprawng nga ai wa, tinang nga shara de wa lu hkra, shi a asak jahpu hkap la lu na myit dai n rai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai zawn re ai hte nanhte nga ai mung hpe wu sin lu na myit dai n rai: masha a sai ngu ai gaw mungdan hpe wu sin kau chye ai; dai mungdan hta hkaw kau ai asai hpe, jahkaw kau ya ai wa a asai hte n rai yang gaw, mungdan dai hpe kashin lu na n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nang madu nga ai mungdan hpe awu asin hkum rai et; dai hta ngai dung nga nngai: kaning rai nme law, ngai Yehowa Israela kashu kasha ni hta adung nga nngai,” ngu wu ai.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ya, Yawsep amyu na Manashe lakung hta Mahkira dap na hkrat ai Gilead kashu kasha ni a agyi salang ni gaw, Mawshe hte Israela kashu kasha ni hta na lakung lama dap ni a du agyi ni hpang de sa nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nang madu hpaida da ai hte Israela kashu kasha ni hpe dai sali ga karan jaw na lam, Yehowa hkang da nit dai; bai, anhte a hpunau Zelohpa a matu sali ga shi a shayi sha ni hpe jaw na lam, Yehowa nang Madu hpe hkang da nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ya dai numsha ni tinang amyu hta n re ai, Israela kashu kasha amyu gale kaw wa mat ma yang gaw, shanhte hte seng ai sali ga mung anhte a ji wa amyu matu ni a sali ga hta na shaw mat nna, shanhte shang wa ai amyu a sali ga hta lawm mat wa ai hte, anhte a sali ga yawm mat na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hta n-ga, Israela kashu kasha ni a pahtau garu shaning du jang, shanhte hte seng ai sali ga gaw shanhte shang wa ai amyu a sali ga hta grin mat nna, shanhte hte seng ai sali ga dai gaw anhte a ji wa amyu matu ni a sali ga hta na yawm nga dinggrin rai na ra ai,” ngu nna tsun mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi Mawshe, Israela kashu kasha ni hpe, Yehowa a ga hte maren hkang da wu ai gaw: “Yawsep amyu matu ni a ga htuk nga malu ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Zelohpa shayi sha ni a lam Yehowa ning nga hkang da ai: ‘shanhte tinang ra ai la kaw wa mu ga: rai timung, tinang kaji kawa amyu matu ni hta kaga gale kaw hkum wa mu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shing rai, Israela kashu kasha ni a sali ga gaw, amyu mi kaw na amyu mi de htawt lu na n rai: Israela kashu kasha ni nlang hte gaw, langai hte langai tinang kaji kawa amyu matu hte seng ai ga hta sha machyu lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israela kashu kasha amyu langai ngai hta sali ga lu ai numsha kadai mung, tinang kaji kawa amyu matu ni hta na la kaw wa lu na rai wu ai: ning rai Israela kashu kasha ni langai hte langai gaw tinang kaji kawa amyu matu hte seng ai sali ga madu sha lu na rai myit dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai, gade a sali ga mung amyu mi hta na amyu mi de htawt lu na n rai; kaning rai nme law, Israela kashu kasha amyu langai hte langai gaw tinang nang a sali ga hta machyu lu na rai ma ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa, Mawshe hpe hkang da wu ai hte maren Zelohpa shayi sha ni hkan galaw ma ai:
  </para>
  <para style="p">
    <verse number="11" style="v" />Mala, Tirza, Hogla, Milhka, Noa mying ai Zelohpa a shayi sha ni gaw kawa di kawa doi ni a kasha ni hte htinggaw rawn sha ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shing rai, Yawsep a kasha Manashe lakung lama hta na ni kaw shanhte wa ma ai rai nna, shanhte a sali ga gaw, shanhte a kaji kawa amyu matu ni hta grin nga malu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai hte gaw, Moba pa, Yawdan hka hkran, Yerihko tawtap e, Yehowa Mawshe a lata hte Israela kashu kasha ni hpe hkang da ai jep ai tara hte matsun maroi ga rai nga ai.
  </para>
</usx>
