<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PSA" style="id">Shakawn Kungdawn</book>
  <para style="h">Shakawn Kungdawn</para>
  <para style="toc1">Shakawn Kungdawn</para>
  <para style="toc2">Shakawn Kungdawn</para>
  <para style="mt">Shakawn Kungdawn</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tara n lang ai ni a bawng ai hku hta n hkawm, Yubak kap ai ni a lam e n tsap, Jahpoi ai ni a hpawng hta n dung lawm ai sha,
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa a tara hta awng nga nna, Shi a tara hpe shani shana myit mang ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai wa gaw hka kau e hkai ai, Shi a aten hta asi si nna, Alap mung n nyip ai hpun hte bung nga ai: Shi galaw ai yawng mayawng mung tai na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tara n lang ai ni chyawm gaw, dai zawn n rai; Nbung e shapoi ai mahkaw hte bung ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai majaw tara n lang ai ni, tara dara ai hta, Yubak kap ai ni, dinghpring ai ni a hpung hta, n rawt tsap lu na ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaning rai nme law, dinghpring ai ni a lam hpe Yehowa chye nga ai; Tara n lang ai ni a lam chyawm gaw, hten mat na ra ai.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha amyu ni hpa majaw n-yun bu nga nna, Amyu baw ni, hpa majaw lila maw nga ma hka?
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa hte shi a Namman chya ai wa hpe, Ga ntsa hkawhkam ni rau hpawng nga nna, Du salang ni jawm bawng nga ma ai gaw:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Shan a hkang hkyihkyang anhte gang dut gaw, shan a sumri anhte kabai kau gaw,” nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lamu hta dung nga ai wa gaw mani nga ai, Dai Madu shanhte hpe asawng kau mu ai:
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai shaloi, shi a masin pawt ai hte shi shanhte hpe ga tsun dan nna, Nachying myit kahtet ai hte shanhte hpe daru na mu ai gaw:
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ngai gaw, nye a chyoi pra ai Ziun bum hta e Nye a hkawhkam wa hpe tawn da ni ai,” ngu na mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ga madat ngai shana ya na nngai: “Ngai sha nang rai nga ndai, Dai ni ngai nang hpe shaprat sade ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai e hpyi nna, masha amyu myu na a sali wunli matu, Nang madu na arung arai, lamu ga htum hkra, ngai nang hpe jaw na de ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang shanhte hpe hpri sumdoi hte shabya kau nna, Wan galaw ai wa a wan zawn, ga kau na maru ai,” nga nna Yehowa ngai hpe tsun ni ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai majaw hkawhkam ni e, hpaji daw mu, Ga ntsa tara agyi ni e, sharin achyin la mu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa hpe hkungga lara ai hte daw mu, Hkrit gari ai hte kabu gara nga mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai kasha hpe pup mu: shing n rai yang, shi masin pawt nna nanhte lam e hten bya ai hkrum na myit dai: Kaning rai nme law, shi masin alawan pawt bu na ra ai: Shi hta shingbyi ai ni nlang hte gaw, a lu ma ai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nye a gumlau ni gade law wa nga ma hka! Masha law law wa nye a gumlau maga e rawt masai.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Karai Kasang hta shi a matu hkye la shara n nga ai,” nga nna, nye myit masin a lam, law law wa tsun ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, nang chyawm gaw, nye a n-gang, Nye a arawng sadang hte nye baw sharawt ya ai wa, rai nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a nsen hte ngai Yehowa hpe shaga nga nna, Shi gaw shi a chyoi pra ai bum hta nna ngai hpe htan ya ni ai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa ngai hpe shadaw ya ni ai majaw, Ngai kaleng taw nna, yup nhtawm, bai hprang lu nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai hpe grup grup kawan nga ma ai, Masha mun sen hpe ngai n hkrit nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, rawt u; nye a Karai Kasang e, ngai hpe hkye la e: Ngai hpe gumlau ai nlang hte a shabyi nang kahpret nna, Tara n lang ai ni a kawng hpe nang daw kau ya ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw hkye hkrang la ai lam rai nga ai; Na amyu a ntsa e, na a shaman ai gaw, anga nga u ga law. [Selah.]
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai hpe dinghpring shangun ai Karai Kasang e, ngai shaga yang htan ya e. Gyip ai shara e, nye a matu dam lada nang di ya ndai. Ngai hpe matsan dum nna, ngai hpyi ai ga madat ya e law.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaman lila tsaw nna, masu ai lam tam nga ai masha kasha ni e, Gaten du hkra nye a arawng sadang hpe shanut nga na myit dai kun? [Selah.]
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa gaw myit ding ai masha hpe shi a matu san da nu ai, chye mu. Yehowa hpe shaga yang, shi ngai hpe madat ya na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Myit kahtet nga timung, yubak hkum galaw myit, Yup ku hta tinang dai dai myit sumru yu nna atsin sha nga mu. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Dinghpring ai hkungga nawng jau nna, Yehowa hpe shamyet shanat nga mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Kaja ai gaw anhte hpe kadai madun lu na a kun?” nga nna law law wa tsun ma ai. Yehowa e, na a myi man a nhtoi, anhte a ntsa e jahtoi ya mi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte a mam hte tsabyi ngai ai aten e kabu gara ai hta, Nang nye a myit hpe grau nna kabu shangun ya ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngwipyaw ai hte ngai kaleng taw nna yup nga nngai: Kaning rai nme law, a katsi n nga ai shara e nga timung, Yehowa e, nang hkrai ngai hpe a sumnung sha nga nga shangun nngai.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nye a ga madat mara ya e, Nye a myit aru yu nga ai hpe, dum nga u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a Hkawhkam hte Karai Kasang e, ngai jahtau ai nsen matsing da u; Kaning rai nme law, nang kaw ngai akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, nang jau jau e nye a nsen na lu na ndai. Jahpawt manap e ngai na a matu hkungga lajang da nna, a mada nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />N tara ai hta awng nga ai Karai Wa, nang rai nga ndai n rai, N hkru ai amu nang hte rau nga lu na, n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gumrawng ai ni, na a man e grin nga lu na ma ai n rai, Yubak galaw ai ni nlang hte hpe nang n dawng nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masu ga tsun ai ni hpe nang jahten kau nga ndai, Sai kap ai hte hkalem sha ai wa hpe, Yehowa matsat nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai chyawm gaw, na a kaba ai chyeju majaw, na a nta hta shang lu nngai. Nang hpe hkrit hkungga ai hte, na a Htingnu de yawng let, nawku lu nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, ngai e gyam yu ai ni a majaw, Na a dinghpring ai lam de ngai hpe woi la e. Nye a man e na a lam shading ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a n-gup hta kamsham shara n rawng ai; Shanhte a kraw lawang n se nga malu ai; Shanhte a mayu hpaw nga ai lup rai nga malu ai, Shanhte a shinglet, bawk chye nga malu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, shanhte hpe ra baw shagun mu, Shanhte bawng ai hta shanhte hkrat mu ga. Shanhte a n hkru ai lam kaba hta shanhte hpe shaden kau mu; Kaning rai nme law, shanhte nang hpe gumlau nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang hpe shamyet shanat ai ni nlang kabu gara nga mu ga, Nang shanhte hpe maga da mu ai majaw, tutnawng e kabu jahtau nga mu ga: Na amying hpe tsawra ai ni mung, nang hta sharawng awng nga mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaning rai nme law, nang gaw dinghpring ai wa hpe shaman ya nga ndai; Yehowa e, nang shi hpe chyeju hte n-gang zawn, kawan da nga ndai.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, na a masin pawt ai hte ngai hpe ari hkum jaw e, Na a myit kahtet ai hte ngai hpe hkum sharin ya et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa e, ngai htum wa ni ai majaw, matsan dum la e, Yehowa e, nye a nra hkrit gari nga li ai majaw, shamai ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a myit masin nachying hkrit gari nga ai, Nang chyawm gaw, Yehowa e, gaten du hkra?
  </para>
  <para style="p">
    <verse number="4" style="v" />Bai wa rit, Yehowa e, nye myit masin mawai la ya e. Na a chyeju majaw ngai hpe hkye la ya e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Si ai hta kadai mung nang hpe dum nga ai n rai. Katsan ga hta nang hpe kadai chyeju jaw na ma ta?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai madai nna hki ba la nga nngai; Shana shagu hkrap ai hte nye yup ku madi nga ai, Nye myi prwi hta nye a yup ra hpe ngai shayawng dat nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a myi yawn hkyen ai hte a mam nga ai; Nye a gumlau ni a majaw, myi mak mat sai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a hkrap ngu hkrap ngoi ai hpe Yehowa na wu ai majaw, N shawp n kap galaw ai ni nlang, ngai kaw na hka mat wa manu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai shaga ai gaw, Yehowa madat mara ya sai; Ngai akyu hpyi ai gaw, Yehowa hta la ya na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a gumlau ni nlang kaya nna nachying hkrit gari ai hkrum na mara ai; Kaya kahpa hkrum let, shanhte akajawng sha kanut mat wa na ma ai.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Wa Yehowa e, nang hta ngai shingbyi nga nngai: Shi gaw hkanghkyi zawn nye a asak hpe n amya kau ai sha,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hkrang la ai wa n nga yang, dai hpe n ashin kau u ga, Hkan shachyut ai ni yawng kaw na ngai hpe hkye la nna shaw la e law.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a Karai Wa Yehowa e, ndai ngai galaw taw gaw, Nye a lata hta yubak kap nga taw gaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai hte hku ai wa hpe n kaja ai lam bai tai nna, Ngai hpe gumlau ai wa hpe pyi, pagawn di taw gaw:
  </para>
  <para style="p">
    <verse number="5" style="v" />Gumlau wa gaw nye a myit masin hpe hkan lep nna, Ga hta nye a asak kabye kau ya n ga, Nye a arawng ga nhpu hta a taw nga u ga. [Selah.]
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa e, masin pawt let rawt u; Nye a gumlau ni n-yun bu ma ai hpe, shabai ya mu. Nye a lam dum u; dawdan ai hku nang hkang da ngut sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masha hpawng amyu myu na a grup yin e jahpawng nhtawm, Dai ni a ntsa nna, tsaw ai shara de bai lung mat u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw masha amyu ni hpe jeyang nga ai. Yehowa e, ngai hta rawng ai dinghpring ai hte myit tsup ai hpe tau yu nna, ngai hpe tara dara ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tara n lang ai ni a n hkru ai lam sim mat malu ga; Dinghpring ai ni hpe mahtang shagrin mu. Dinghpring ai Karai Kasang gaw, Masin hte nhkyun ni hpe chyam yu ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang nye a n-gang lang ya nga ai; Myit malang ai ni a hkye la ai wa shi rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang gaw dingman ai tara agyi wa rai nga ai, Lani hte lani myit kahtet ai Karai Wa mung, rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Masha myit n kayin yang shi nhtu garang nna, Shi a ndan dawn nna, jin jin rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai wa hpe shi a jasi ai arai ni shi shading nna, Shi a pala ni hpe ju jahkyeng da nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yu mu, n hkru ai hpe shangai na, shi machyi nga ai; Gumlau gumle hte na-um nasin rai nga nna, Masu ai gaw shangai dat wu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi nhkun chye htu da nna, Shi htu ai hku hta hkrat nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi n hkru ai amu shi a baw hta bai wa lu ai. Shi a baw pungding hta shi a kashun kashe bai hkrat sa lu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai gaw Yehowa a dinghpring ai hte maren chyeju dum na nngai; Tsaw Htum ai Yehowa a amying hpe, ngai mahkawn mangoi na nngai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anhte a Madu Yehowa e, Lamu hta, na a hpung shingkang shapraw ai wa gaw, Aga ting hta, na a mying nsang gaw, gade wa dan hkung nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang hpe je hpre ai ni a majaw, Gumlau ni hte manawn ai ni hpe jasim kau mu ga, Ma chyangai hte chyu chyu ai ni a n-gup hta, nang hpung shingkang tawn da ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a sumsing lamu gaw, na a layung a amu, Nang tawn da ai shata hte shagan ni hpe ngai mada yu yang:
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang adum nga ai shinggyim masha hte, Nang kawan yu nga ai masha kasha gaw, hpa wa mi rai nga a hka?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang shi hpe Karai Kasang hte loi mi sha shagrit da nna, Arawng sadang hte hpung shingkang shi hpe ka-up ya nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a lata amu ntsa e, nang shi hpe up shangun wu ai; Sagu bainam hte yamnga nlang hte hpe,
  </para>
  <para style="p">
    <verse number="7" style="v" />Nam e nga ai ashu ashan hpe mung, Ntsa malen na u ni, hka hta rawng ai nga ni,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nammukdara a lam e pyau hkawm ai yawng hte hpe mung, Shi a lagaw npu e nang tawn da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a Madu Yehowa e, Aga ting hta, na a mying nsang gaw, gade wa dan hkung nga a hka!
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit mahkra hte, ngai Yehowa hpe shakawn na nngai, Na a mauhpa magam nlang hte hpe, ngai gawn dan na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a majaw ngai kabu nna, myit pyaw nga na nngai, Tsaw htum ai Wa e, na a amying hpe ngai mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a gumlau ni kanut mat wa yang, Shanhte na a man e kataw nna hten mat wa ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai hpang maga de nang tara dara nna dawdan ya nit dai; Dingman ai tara agyi nang rai nga ndai rai nna, dai tingnyang hta dung nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw masha amyu ni hpe daru kau nna, Tara n lang ai ni hpe jahten kau mu ai: Shanhte a amying hpe prat dingnawng, shaprai kau ya manu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gumlau ni mat mat wa nna, prat tup htinggaw htum mat masai. Mare ni hpe mung nang run kau nna, De a masat dingsat pyi hten mat sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa chyawm gaw, htani htana adung nga nna, Tara dara na matu shi a tingnyang hpe lajang da nu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw mungkan ga hpe dingman ai hte tara dara nna, Malang ai hku hkan let amyu baw ni hpe jeyang na mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa gaw zingri zingrat hkrum ai ni a langchyi, ru tsang hkrum ai aten e, tsaw ai langchyi, rai na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai majaw, na a amying chye ai ni nang hta hpa nga nna, Yehowa e, nang hpe tam ai ni hpe nang kau da ndai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ziun hta nga nga ai Yehowa hpe mahkawn mangoi mu; Amyu baw ni hpe shi a magam bungli shana ya mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sai matai dawp ai wa gaw shanhte hpe dum nga nna, Myit gyip ai ni a hpyi jahtau ai hpe malap kau ya mu ai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa e, ngai hpe matsan dum ya e: Si ai chyinghka na ngai hpe sharawt la ai wa e, Ngai hpe n dawng ai ni a zingri ai hpe, yu u.
  </para>
  <para style="p">
    <verse number="14" style="v" />shaloi na a akyu nlang hte gaw ngai gawn dan nna, Ziun shayi sha a chyinghka lam e, na a hkye la ai lam majaw, kabu gumlawt na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Masha amyu ni, tinang htu ai nhkun hta di hkrat bang nna, Shanhte makoi da ai mahkam hta tinang a lagaw ahkang nga malu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa shi hkum dan nga ai: tara dara ai amu galaw nu ai; Tara n lang ai ni gaw, tinang a lata a amu hta hkam nga ma ai. [Higayun, Selah.]
  </para>
  <para style="p">
    <verse number="17" style="v" />Tara n lang ai ni hte, Karai Kasang hpe malap mali kau ai amyu yawng mayawng hte gaw, Le katsan ga de di hkrat na mara ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Matsan mayan ni hpe tut tut malap kau na mu ai n rai, ru tsang hkrum ai ni a myit mada ai lam, Tutnawng hten mat nga na n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rawt u, Yehowa e, si ging ai wa hpe n dang shangun u ga, Masha amyu ni na a man e dawdan ai hkrum mu ga.
  </para>
  <para style="p">
    <verse number="20" style="v" />O, Yehowa e, shanhte hpe jahkrit mu; Masha amyu ni, si ging ai masha hkrai rai nga ma ai gaw, shanhte hpe shadum mu. [Selah.]
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, hpa rai nme, nang tsan tsan e tsap nga n ta? Ru tsang hkrum ai aten hta e, hpa rai nme makoi nga n ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Tara n lang ai ni a gumrawng ai myit majaw, matsan mayan ni hkru mat masai, Dai ni maw ai hku hta shanhte ahkang mat masai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai wa, shi myit masin ra ai hku shakawn nga ai, Lawhpa ai wa gaw Yehowa hpe kau da nna, asawng nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tara n lang ai wa myit kaba nna, “Shi ari jaw na n rai,” nga ai. Karai Kasang n nga ai, nga nna, myit mang nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi hkan ai hku, tutnawng e agrin nga lu ai; Na a tara dara ai lam ni, tsaw htum ai shara zawn, shi hte tsan gang nga ai: Shi a gumlau ni yawng hpe shi kawut kau mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ngai galoi mung htawt mat ai hkrum na nngai n rai, Prat dingsa e yubak n hkrum ai wa, ngai rai nga nngai,” nga nna shi a kraw e a tsun nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi n-gup, matsa mawa, hkalem sha ai, kashun kashe ai hte hpring nga lu ai. Shi a shinglet npu e n shawp ai hte shut hpyit ai rawng nga lu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kahtawng ni a gyam yu ai shara hta e shi dung nga ai, Makoi ai shara hta mara n kap ai ni hpe sat kau mu ai. Shi a myi nji nmu nga ai ni hpe azi yu nga mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkanghkyi gaw shi a lungpu hta zawn, makoi ai shara hta e shi gyem nga ai: Matsan mayan ni hpe kamu la na shi gyem nga ai; Shi a sumgawn gang karawt yang, matsan mayan wa mung lawm nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />shi lanyan nna gum nga ai rai nna, Nji nmu nga ai ni shi a lamyin hta hkrat ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Karai Wa malap mali kau nga ai; Shi myi man makoi da nga wu ai, Galoi mung mu mada nga na n rai,” nga nna shi a kraw e a tsun nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rawt u, Yehowa e; Karai Wa e, na a lata sharawt u, Matsan mayan ni hpe hkum malap kau et.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tara n lang ai wa gaw, hpa majaw Karai Kasang hpe asawng nna, “Shi ari jaw na n rai,” nga nna, shi a kraw e, a tsun nga lu ta?
  </para>
  <para style="p">
    <verse number="14" style="v" />Gaja wa nang mu mada nga ndai: na a lata hta matsing da na, N shawp ai hte shatsang ai hpe, nang a yu nga ndai; Nji nmu ai wa nang hta shamyet shanat nga ai; Jahkrai nmai ni a karum ai wa, nang tai nit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tara n lang ai wa a lahpum hpe daw kau u; N hkru ai wa a amu, n nga ai du hkra, ari hkan jaw u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa gaw htani htana hkawhkam rai nga ai; Maigan amyu ni shi a mung hta na hkoi mat wa masai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa e, myit gyip ai ni a ra ai lam, nang na yu nga ndai; Jahkrai nmai ni hte zingri zingrat hkrum ai ni hpe dawdan ya nna,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ga ntsa masha htawm hpang e n jahkrit lu mu ga, Shanhte a myit hpe nang shadaw ya nna, Na a na hte madat mara la ya nga ndai law.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hta ngai shingbyi nga nngai: “U zawn na a bum hta pyen htawt u;
  </para>
  <para style="p">
    <verse number="2" style="v" />Yu u, tara n lang ai ni ndan shachyen nna, Myit malang ai ni hpe nsin e gap na nga, Pala hpe ndan sumri hta bang da mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Npawt shadaw ni daw mat nga ma yang, Dinghpring ai wa hpa galaw lu a ta?” nga nna, Nye a myit masin hpe nanhte hpa majaw tsun nga myit ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw shi a chyoi pra ai Htingnu hta nga nga ai: Sumsing lamu hta e shi a tingnyang rai nga ai. Shi a myi a mada nga nna, Shi a myi hpyi shinggyim masha ni hpe azi yu nga mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa dinghpring ai ni hpe dinglik yu nna, Tara n lang ai wa hte kashun kashe tsaw ai wa hpe, Shi a myit masin n dawng nga mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tara n lang ai ni a ntsa e wan n-ga htu u ga, Shanhte a hkambum kan hte kahtet ai nbung, rai nga malu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, Yehowa dinghpring nga ai. Shi gaw dinghpring ai amu tsaw nga ai; Myit malang ai ni shi a myi man mu lu na mara ai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karum rit, Yehowa e; myit pra ai wa mat wa nna, Kangka re ai ni, masha kasha ni hta na, htum mat wa ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Langai hte langai tinang a htingbu wa hte masu ga tsun ma ai; Bawk ai nten hte, myit lahkawng hte shanhte tsun ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, “Anhte a shinglet n-gun sharawng ya mi ai. Anhte a nten anhte hte rau rai nga ai: Anhte a ntsa na Madu kadai wa rai nga a ta?”
  </para>
  <para style="p">
    <verse number="4" style="v" />Nga nna, bawk ai nten nlang hte hte, Ga kaba tsun ai shinglet hpe, gadoi kau u.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ru tsang hkrum ai ni a ru tsang ai hte, Matsan mayan ni a sharung shayawt ai a majaw, Ya ngai rawt wa na nngai rai nna, Ba galawp ai wa hpe shingbyi shara hta tawn da na nngai,” nga nna Yehowa tsun ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa a ga chyoi pra ai ga rai nga ai; Bunghkrawng kaw nna, ga de byawng hkrat ai, Sanit lang shabyawng ai gumhpraw hte bung nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, nang shanhte hpe makawp maga nga na ndai. Ndai amyu hta na, nang shanhte hpe galoi mung jahka nga na ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shinggyim masha ni hta n seng ai amu kaba wa ai shaloi, Tara n lang ai ni shara shagu hkan e tam hkawm nga ma ai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, gaten du hkra nang ngai hpe a malap kau nga na n ta? Gaten du hkra na a myi man, ngai kaw na makoi kau nga na wu ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Gade na hkra nye a myit masin hta ngai sumru yu nga nna, Lani hte lani nye a myit hta yawn hkyen nga na rai ta? Gade na hkra gumlau ni ngai hta grau nga na ma ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a Karai Kasang Yehowa e, mada yu nna htan ya e: Si ai hta ngai n yup nga n ga,
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai gumlau wa, “Ngai shi hpe dang kau nngai,” n nga lu u ga, Ngai kataw yang ngai hpe zingri ai wa n kabu nga lu u ga, Nye a myi jahtoi ya e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai chyawm gaw, na a chyeju hta shamyet nga nngai, Na a hkye la ai lam hta nye a myit kabu nga ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa ngai hpe chyeju kaba jaw nngai majaw, Ngai shi hpe mahkawn mangoi na nngai.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mana ai wa gaw, “Karai Kasang n nga ai,” nga nna shi a kraw e a tsun nga ai. Shanhte tsam mat nga ma ai rai nna, Matsat shabat lailen hkan nang ma ai: Kadai mung kaja ai amu n galaw ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zai byeng-ya rawng ai wa nga ai, n nga ai, Karai Kasang hpe tam ai wa nga ai kun? Mada yu na nga, Yehowa lamu de nna, masha kasha ni hpe gum yu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yawng dam mat wa masai; Shanhte rau brun mat wa masai. Kadai mung kaja ai amu n galaw ma ai: Gaja wa, langai mi muk n nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />N hkru ai amu galaw ai hte, Nye a amyu masha ni hpe muk hpe zawn sha kau nna, Yehowa hpe n hpyi jahtau ai ni mahkra gaw Hpa mung n chye nga ma hka!
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw dai dingman ai amyu hte nga nga ai majaw, Shanhte dai yang e hkrit kaba hte hkrit gari wa masai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zingri hkrum ai wa a bawng ai hku hpe, Nanhte kaya hpya mayu mu timung, Yehowa shi a shingbyi shara rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israela a matu Ziun kaw nna hkye hkrang la ai lam, kadai jaw na rai nga a ta? Yehowa shi a bawng dung ai amyu hpe hkrang la ai shaloi jang, Yaku awng wa nna, Israela kabu gara nga na ra ai.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, na a Sum hta kadai shanu lu na rai nga a ta? Na a chyoi pra ai bum hta kadai nga lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Tara hkan ai myit hte hkawm nna, dinghpring ai amu galaw let, Shi a myit hta dingman ai ga tsun ai wa;
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a shinglet hte baw law ai ga n tsun ai: Shi a jinghku wa hpe n shawp ai hku n galaw ai, Shi a htingbu wa hpe kaya kahpa n jahkrum ai wa;
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a myit hta shagrit ai hte kaya ging dum nga nna, Yehowa hpe hkrit kamyin ai ni hpe hkungga ai hte, Tinang a akyu hten timung, shi a dagam ai ga n lai ai wa;
  </para>
  <para style="p">
    <verse number="5" style="v" />Tinang a gumhpraw hpe ladu lai ai amyat hte n hkoi, Mara n kap ai wa a jaw e sake manawn n la ai wa gaw, Ndai galaw let, galoi mung shamu shamawt hkrum na n rai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Wa e, ngai hpe bau sin ya e; nang hta ngai shingbyi nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Nang nye a Madu rai nga ndai,” ngai Yehowa hpe tsun ni ai. Nang hta kaga nye a madu nga mai na lam n nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ga ntsa e nga ai chyoi pra ai ni hte, Hpung lu ai ni hpe hkrai, ngai ra nga nngai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Lam kaga hkan ai ni a tsin-yam law wa na ra ai. Shanhte a sai kumhpa hta, ngai ru jaw lawm na nngai n rai. Shanhte a amying nye a n-gup hte shamying na nngai, n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa gaw nye a sali wunli hte, lusha gawm na hkambum rai nga ai: Nang gaw nye a sali kumhtaw hpe sin nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a lamu ga jarit pyaw ai shara hta ang nga ai, Gaja wa, nye a sali wunli hkik hkik rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hpe hpaji daw ya ai Yehowa hpe ngai sha-a na nngai, Shana e pyi nye a myit masin ngai hpe sharin ya nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a man e ngai Yehowa hpe tut tut tawn da na nngai, Nye a hkra maga e shi anga nga ai majaw, ngai n shamu na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai majaw nye a myit masin kabu nga ai hte nye a arawng awng nga li ai; Nye a hkum shan mung asan apra sha nga lu li ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaning rai nme law, nang nye a myit masin hpe katsan ga de kau da ya na ndai n rai. Na a chyoi pra ai wa hten byak hkrum na, nang hkraw nga ndai n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang ngai hpe asak hkrung ai lam madun ya na ndai; Na a man e kabu gara htum nga ai: Na a hkra lata hta pyaw ai lam tut tut anga nga ai law.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, dinghpring ai ga madat u, Ngai jahtau ai ga hpe matsing ya e; Bawk ai n-gup hte n hpyi ai ga hpe, na la ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpe dawdan ai ga, nang kaw na pru u ga, Na a myi, malang ai lam hpe a mu nga lit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang nye a myit hpe dinglik ya yu nit dai; Shana e nang ngai hpe kawan yu nna, Ngai hpe chyam yu yang, hpa mung n mu ndai: Ngai myit ai lam nye a n-gup hte n shai li ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha a amu, na a n-gup ga hte nhtan shai nga ai, Ngai chyawm gaw, n hkru ai ni a lam hpe koi nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a lagaw na a lam hta a hkan nga li ai, Nye a lagaw lahpan kashawt nga li ai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Wa e, nang ngai hpe htan ya ndai majaw, Ngai nang hpe a shaga nga nngai: Ngai hpang de na kayin nna, nye a ga madat ya e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a hkra lata hte gumlau rawt ai ni kaw na Kamsham ai ni hpe hkye hkrang la ai wa e, Na a mauhpa chyeju madun dan mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai hpe zingri nga ai tara n lang ai ni hte, Nye a asak hpe grup grup kawan nga ai gumlau ni kaw na,
  </para>
  <para style="p">
    <verse number="9" style="v" />Myi sha hpe yu ai zawn ngai hpe yu yu nna, Na a singkaw a shingnip npu e ka-up da ya e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte matsan dum ai lam pat kau nna, Gumrawng gumtawng ga a tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anhte hkawm ai lam hpe shanhte ya kawan da nna, Anhte hpe ga de jahkrat kau na a maw nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw, shan hpe sha mayu ai hkanghkyi hte, Makoi ai shara e gyem nga ai hkanghkyi hkalung hte, bung nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Rawt u, Yehowa e, shi man e tsap u, shi hpe jahkrat kau u, N hkru ai ni kaw na, na a nhtu hte, nye a asak hpe shalawt ya e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa e, mungkan ga masha ni hte Ndai aprat hta sha matu mara lu ai ni kaw na, na a lata hte ngai hpe shalawt la e. Shanhte a kan hpe nang sutgan hte jahpring ya mu ai: Shanhte kashu kasha law law mayat maya nga ma ai rai nna, Shadang sha ni kaw sutgan htawng da lu ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai chyawm gaw, dinghpring ai hte, na a myi man hpe mu lu na ring ngai; Yup hprang wa ai shaloi, na a hkumhkrang hpe mu yang, ngai myit dik na ring ngai.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a n-gun Yehowa e, ngai nang hpe tsawra nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa gaw nye a lunghkrung, nye a hpyen dap, nye a hkye hkrang la ai Wa, Nye a Karai Wa, ngai shingbyi nga ai nye a lungpu, Nye a n-gang, nye a hkye la ai nrung, nye a langchyi, rai nga li ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mai shakawn ai Yehowa hpe ngai shaga nna, gumlau ni kaw na ngai hkye la ai hkrum ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Si ai sumri ni ngai hpe kawan nga nna, N hkru ai hka hpunla ni ngai hpe jahkrit mi ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Katsan ga a sumri ni ngai hpe kum da nna, Nye a man e si hkrung si htan mahkam nga nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai ru tsang ai hta ngai Yehowa hpe shaga nna, Nye a Karai Kasang hpe hpyi jahtau we ai. Shi a Htingnu hta nna shi nye a nsen madat nna, Ngai hpyi jahtau ai ga, shi a na hta shang lu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi lamu ga shamu nna a wam nga ai, Bum ni a npawt nhpang ni gari nga ai: Shi myit kahtet ai majaw, dai hte kangi kanga rai ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a ladi hta wan nhkut pru nna, Shi a n-gup na, wan hkru nga ai: Grung ai wan n-ga dai hta grung nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi shi gaw sumsing lamu hpe shanem nna yu wa ai, Shi a lagaw npu e, htat ai nsin sin nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkerub hta shi jawn nna pyen nga ai. Nbung a singkaw ntsa e pyen nang nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi gaw nsin hpe shi a makoi magap shara shatai nna, Hka kaba a nsin hte, htat ai sumwi ni, Shi a grup grup na sum tai nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi a shawng na htoi kabrim ai hte, Shi a htat ai sumwi hta na, sin hte wan n-ga poi nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi Yehowa gaw lamu de na mu shangoi nna, Tsaw Htum ai wa gaw, shi a nsen shapraw dat wu ai. Sin hte wan n-ga mung poi nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi a pala ni shi gap dat nna, shanhte hpe shabra dat mu ai. Myihprap law law hte shanhte hpe shamak kau mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa e, nang makan ai ga hte, Na a ladi na sa dat ai nsa majaw, Hka kaba ni a lam sumhkan wa nna, Ga npawt ni dawng pru wa ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Matsaw, ntsa de nna shi ladawn dat nhtawm, ngai hpe sai la ni ai. Hka kaba hta na ngai hpe shaw la ni ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nden ja ai gumle gumlau wa hte, Ngai hpe n dawng ai ni kaw na, shi ngai hpe mawai la ni ai: Kaning rai nme law, shanhte ngai hta n-gun grau ja ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tsin-yam hkrum ai nhtoi hta shanhte ngai hpe dim da timung, Yehowa nye a shadaw shara rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi ngai hpe dam lada ai shara de shapraw la nna, Ngai hta awng nga ai majaw, ngai hpe mawai la ni ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai dinghpring ai made Yehowa ngai hpe akyu jaw nna, Nye a lata san seng ai hpe bai htang ya ni ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kaning rai nme law, Yehowa a lam ngai hkan nang nna, Nye a Karai Kasang hpe shut kau nngai n rai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi dawdan ai lam nlang hte nye a man e nga nga nna, Shi htet da ai ga hpe ngai gang kau nga nngai n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi a man e ngai yubak n kap nna, N hkru ai lam hpe koi kau nga nngai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai majaw Yehowa nye dinghpring ai hte, Shi myi hte mu lu ai nye a lata san seng ai hte maren, ngai hpe bai htang ni ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Matsan dum chye ai wa hpe nang matsan dum ai madun dan ndai; Myit dik ai wa hpe, myit dik ai myit madun dan ndai:
  </para>
  <para style="p">
    <verse number="26" style="v" />Chyoi pra ai wa hpe, chyoi pra ai myit madun dan ndai, Myit magaw ai wa hpe, nhtan shai ai myit madun dan ndai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ru tsang hkrum ai amyu hpe nang hkye la nna, Gumrawng ai myi man hpe shagrit kau ndai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Gaja wa, nang nye a pyengdin shatu ya ndai: Nye a Karai Kasang Yehowa, nye a nsin hpe jahtoi ya ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang hte luksuk ni hpe ngai dang kau nna, Nye a Karai Kasang hte bunghku hpe shingtawt lu nngai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Karai Wa a lam ni chyip chyip rai nga ai; Yehowa a ga chyam yu yang teng nga lu ai; Shi hta shingbyi ai nlang hte a n-gang shi rai nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yehowa hta shaje kadai wa Karai Kasang rai nga a ta? Anhte a Karai Kasang hta kaga, kadai wa lunghkrung rai nga a ta?
  </para>
  <para style="p">
    <verse number="32" style="v" />Dai Karai Wa, ngai hpe n-gun hte shingkyit kyit ya nna, Nye a lam hpe shadik ya ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shi gaw nye a lagaw hpe shan lagaw zawn shatai nna, Nye a tsaw ai shara de ngai hpe mara da ni ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi nye lata hpe hpyen amu sharin ya nna, Nye a lahpum magri ndan shachyen lu li ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na a hkye la ai n-gang nang ngai hpe jaw nit dai; Na a hkra lata ngai hpe shadaw ya nna, Na a myit nem ai hku hta, ngai kaba wa nngai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ngai tsap shara nang nye a npu e dam lada di ya nna, Nye a hkarutum n kayaw nga li ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ngai gumlau ni hpe hkan shachyut nna, dep na mawe ai; Shanhte garai n hten mat mat, ngai bai nhtang wa na nngai n rai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shanhte n rawt lu hkra ngai shanhte hpe adup kau nna, Nye a lagaw npu e shanhte kataw nga ma ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nang ngai hpe majan gun na n-gun hte shingkyit kyit ya nna, Ngai hte nhtan shai ai ni, nye a npu e kadawng taw nga ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ngai hpe gumlau ai ni a shingdu de nang ngai hpe madun ya nna, Ngai e n dawng ai ni hpe ngai tsai tsai jahten kau mawe ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shanhte hpyi jahtau timung, hkye la ai wa n nga ai, Yehowa hpe shaga timung, shi shanhte hpe n htan ya mu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shaloi nbung e kamawng ai nhpu hpe zawn, ngai shanhte hpe a mani n di kau nna, Lam na hkumpup hpe zawn shanhte hpe ru kau mawe ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Dai amyu a ru hka hta na, nang ngai hpe shalawt la nna, Masha amyu ni a bawmung tai u ga, nang ngai hpe tawn da ni ai. Ngai n chye ai amyu gaw, nye a amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nye a lam na yang, shanhte madat nga nna, Tsasam ni a kasha ni nye a man e nem na ma ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Tsasam ni a kasha ni nyip mat ma ai rai nna, Shanhte a hpyen dap na gari let pru wa ma ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Yehowa ahkrung nga ai; nye a lunghkrung, a nga u ga law. Nye a hkye hkrang la ai Madu Karai Kasang, galu kaba nga u ga law.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ngai hpang maga e bai tai lu ai lam waw ya nna, Nye a npu e masha amyu ni hpe tawn da ai Karai Wa gaw, a nga u ga law.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ngai hpe gumlau ai ni hta na, shi ngai hpe hkye la nngai; Gaja wa, je hpre ai ni a ntsa e nang ngai hpe sharawt nngai: N shawp ai ni hta na mung, nang ngai hpe mawai la ni ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Dai majaw Yehowa e, masha amyu ni hta ngai nang hpe shakawn na nngai. Na a amying nsang hpe mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Shi gaw shi a hkawhkam wa hpe hkye hkrang la ai lam kaba shangun nna, Shi Namman chya ai Wa, ngu ai, Dawi hte shi a aru arat hpe, Htani htana chyeju a madun dan nga mu ai law.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sumsing lamu gaw Karai Wa a hpung shingkang gawn dan nna, Lamu madin gaw, shi a lata amu madun ya nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lani hte lani aga sumtu a ngoi pra nga nna, Lana hte lana chye chyang ai hku madun dan nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpa tsun ai lam hta mung, hpa ga ga ai hta mung, Dai hte a nsen n na yu ai, n nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mung shagu hta dai hte a ngoi ai gaw, Mungkan ting hta dai hte a mungga, pri rai sai: Shi gaw dai hte hta jan a matu sum lajang da nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ajan gaw hkungran ai gawk na pru ai la nnan hte, Gat shingjawng na wa-ngan zawn gumlawt pru wa ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lamu maga mi de nna shi pru wa nhtawm, Bai maga mi de htum hkra kayin hkawm dep wu ai: Hpa mung shi a kang kahtet ai hta na lawt lu ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa a tara ra n rawng ai rai nna, myit masin hpe shalan shabran ya ai. Yehowa a sakse tengman nga ai rai nna, myit n su ai ni hpe hpaji jaw mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa a jep ai tara dingman nga ai rai nna, myit masin hpe kabu shangun ya nga ai. Yehowa htet da ai ga asan apra rai nga nna, shinggan myi sha hpe jahtoi ya nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa hpe hkrit hkungga ai lam chyoi pra nga ai rai nna, htani htana anga nga ai. Yehowa a tara dara ai ga teng nga ai rai nna, ahkum ara dinghpring nga lu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai hte gaw aja hte jet htum ai aja hta grau mai ra nna, Lagat jahku hte gitbaw hta n-ga, grau dwi nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a mayam wa mung, de a majaw myit dum myit hprang nga nna, Dai hte hpe hkan nang ai majaw, akyu kaba lu la nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />N chye nna shut ai lam hpe kadai dum lu a ta? N dan ai yubak hta na mung, ngai hpe jasan la e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dingsa galaw ai yubak mung ngai hpe n up u ga, Dai hta na, na a mayam wa hpe shabai la u: Shaloi ngai myit tsup nga nna, mara kaba hte mung lawt na ring ngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a lunghkrung hte ngai hpe hkye hkrang la ai wa, Yehowa e, Nye a n-gup ga hte, nye a myit hta sumru yu ai lam gaw, Na a man e sharawng awng nga u ga law.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw ru tsang hkrum ai nhtoi hta nang hpe htan ya u ga, Yaku a Karai Kasang a mying gaw, nang hpe shatsaw ya u ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw chyoi pra Nta hta na nang hpe karum na shangun dat nna, Ziun bum nna nang hpe shadaw ya u ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a lusha hkungga nlang hte hpe dum ya nga nna, Na a wan nat ai hkungga hpe hkap la u ga. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a myit hta rawng ai hte maren shi jaw nna, Nang hpaji daw ai lam nlang hte hpe shabyin ya u ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a hkye la ai lam hta anhte awlaw nga na rai nna, Anhte Karai Kasang a mying nsang hte, Dawnghkawn hpe sharawt na ra ga ai: Nang hpyi ai hku nlang hte hpe shi shadik ya u ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa shi a namman chya ya ai wa hpe hkye la nga ai gaw, ya ngai chye nngai. Shi a hkra lata hte galaw ai nsam amu hte, Chyoi pra ai lamu de na shi hpe htan ya wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nkau mi gaw leng hta, nkau mi gaw gumra hta gumrawng nga ma ai; Anhte chyawm gaw, anhte a Karai Kasang a amying nsang hpe dum nga ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte kataw nna kadawng mat masai, Anhte chyawm gaw rawt nna ngang ngang tsap nga ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa e, hkawhkam wa hpe hkye la u: Anhte shaga ai nhtoi hta e, shi anhte hpe htan ya u ga law.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, hkawhkam wa gaw na a n-gun hte kabu nga nna, Na a hkye hkrang la ai lam hta gade wa kabu gara nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi myit ra ai hku nang shi hpe jaw nit dai rai nna, Shi a n-gup hte hpyi ai lam ndang kau ndai n rai. [Selah.]
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang shi hpe kaja ai wunli hte tau la nna, Shi a baw hta jet ai ja janmau gup ya nu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi nang kaw na asak galu hpyi nna, Nang shi hpe htani htana nhtoi jaw da nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a hkye la ai lam majaw, shi hpung kaba rawng nga nna, Hpung shingkang hte arawng sadang nang shi hpe jaw da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tut tut na akyu lu la hkra nang shi hpe san da nna, Na a myi man a kabu gara ai hta shi hpe sha-awng nu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkawhkam wa gaw Yehowa hta maju jung nga nna, Tsaw htum ai Wa a chyeju hte shamu shamawt lu na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a lata gaw, nang hpe gumlau ai ni nlang hte hpe dep lu nna, Nang hpe n dawng ai ni hpe na a hkra lata dep na mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a myi man madun dan ai ahkying hta e, Nang shanhte hpe wan htung zawn shatai na maru ai; Yehowa gaw shi a masin pawt ai hte shanhte hpe mayu kau nna, Wan mung shanhte hpe hkru kau na maru ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dinghta ga na, shanhte a arung arai, Shinggyim masha ni hta na, shanhte a aru arat hpe, nang shamyit kau na maru ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kaning rai nme law, shanhte gaw na a lam n hkru ai hku maw nna, N shawp ai hku hpaji daw timung, hpa mung n tai malu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang gaw na a ndan pala hte shanhte a myi man hpe shading ya nna, Shanhte a shingma hpe kayin ya na maru ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa e, na a atsam hte rawt u; Shaloi anhte gaw mahkawn mangoi let Na a daru magam hpe, shakawn kungdawn na ga ai.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Wa e, nye a Karai Wa e, nang hpa rai ngai hpe kau da nga n ta? Ngai hpyi jahtau ai ga gaw, ngai hpe karum na wa hte tsan nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a Karai Kasang e, shani e ngai jahtau nga timung, nang n htan ya ndai. Shana e jahtau nga timung, ban sa ai n hkrum nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang chyawm gaw chyoi pra nga ndai rai nna, Israela a shakawn ai ga hta adung nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a ji woi ni nang hpe kamsham nga ma ai; Shanhte kamsham nna, nang shanhte hpe mawai la mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte nang hpe shaga nna, lawt wa lu ma ai. Nang hpe kamsham nna, kaya kahpa n hkrum ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai chyawm gaw, masha n rai, shingtai rai nga nngai: Masha shatan shara, amyu masha ni a matsat shabat ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hpe mu ai ni nlang ngai hpe asawng kau nna, N-gup nhkyeng let baw kanga nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw “Yehowa hpe hpa u, shi gaw shi hpe hkye la u ga, Shi hta awng nga ai majaw, shi hpe mawai la u ga” nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, ngai hpe hkritung nna shaw la ai wa, nang rai nga ndai, Nye nu a chyu hta nang ngai hpe kamsham shangun nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkritung nna nang hta ngai mashum nga nngai, Nu a kan nna, nye a Karai Wa nang rai nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ru tsang ai gaw ni wa magang ra ai rai nna, Karum ai wa n nga ai majaw, Ngai hte tsan tsan hkum nga et.
  </para>
  <para style="p">
    <verse number="12" style="v" />Usu law law ngai hpe jawm da mi ai, Bashan a gwila ni ngai hpe kawan da mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amya maw nna shabam ai hkanghkyi zawn, Shanhte ngai hpe n-gup mahka nga ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ntsin zawn ru kau ai ngai hkrum nga nngai. Nye a nra hkrihkraw mahkra kashai mat sai: Nye a myit gitbaw zawn rai nga ai rai nna, Dai gaw nye a kraw e byaw mat nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a n-gun di chyen zawn hkraw mat nga ai, Nye a shinglet nye a gumra hta kap mat sai: Si ai nhpu hta nang ngai hpe tawn da nit dai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaning rai nme law, gwi ni ngai hpe jawm nna, N hkru ai shawa hpung ngai hpe grup ma ni ai: Nye a lagaw lata hpe mung jahpye ya ma ni ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a nra yawng ngai hti lu nngai; Shanhte ngai hpe mada nna azi yu nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a nba shanhte karan la mu ai rai nna, Nye a kata palawng hpe hpaida da ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang mahtang Yehowa e, hkum tsan nga et, nye a N-gun e, ngai hpe karum na lawan rit.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a myit masin hpe, nhtu kaw na, Nye a asak shingtai hpe, gwi a lata na hkrang la u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hkanghkyi a n-gup na ngai hpe hkye la ya e, Rai sa, hpawlam a nrung kaw nna pyi, nang ngai hpe htan ya nit dai,
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a amying hpunau ni hpe ngai shana ya na nngai. Hpawng shingra ka-ang e, nang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa hpe hkrit hkungga ai ni e, shi hpe shakawn kungdawn mu, Yaku a aru arat nlang hte e, shi hpe shagrau sha-a mu: Israela kashu kasha nlang hte e, shi a man e agam nga mu.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kaning rai nme law, ru tsang ai wa a ru tsang ai hpe, Shi n gawn n sawn di nna matsat kau ya wu ai, n rai: Shi kaw na shi a myi man hpe makoi kau wu ai, n rai. Shi hpe hpyi jahtau yang, shi madat mara ya wu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shawa hpawng kaba e, ngai shakawn ai ga gaw, nang kaw na pru nga ai. Nang hpe hkrit hkungga ai ni a man e, ngai dagam ai ga ngai shadik na nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Matsan mayan ni hkru kat hkra lu sha lu na mara ai, Yehowa hpe hkan tam ai ni, shi hpe shakawn na mara ai; Nanhte a myit masin tutnawng e ahkrung nga malit ga.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ga ting na yawng mayawng hte gaw Yehowa hpe dum nna, shi hpang de kayin na mara ai. Masha amyu baw nlang hte gaw, na a man e nawku na mara ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dai mungdan gaw Yehowa a mungdan rai nga ai; Masha amyu baw shagu ni hpe shi Madu nga mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ga ntsa na lu su ai ni nlang hte gaw, lu sha nna nawku na mara ai; Nhpu hta shang nna tinang a asak hpe n bau lu ai ni nlang hte mung, shi a man e, dingnyawm na mara ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte a kashu kasha ni shi hpe daw jau na mara ai: Htawm prat du hkra, dai Madu a lam shanhte shana ya na maru ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shanhte pru nna garai n shangai ai amyu hpe shi a dinghpring ai lam hte, “Dai shi galaw nu ai,” nga nna hkai dan na maru ai.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa ngai sagu hpe rem ai wa rai nga ai; Ngai hpa mung n ra nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsit lali ai udat shara e shi ngai hpe hpum shangun nna, Ngwi ai hka kau de woi sa wa nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a myit masin hpe shi shalan shabran ya nna, Shi amying nsang a matu mara, Dingman ai lam hta ngai hpe akawn wa nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Si ai hkaraw a shingnip hta e ngai hkawm sa wa timung, Nang ngai hte rau nga nga ai majaw, Ngai aru ara hpe n hkrit nngai: Na a sumdoi hte na a dawhkrawng gaw, ngai hpe shapyaw ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye gumlau ni a man e, nye a matu sha ku nang lajang da ya nga ndai; Nye a baw hpe namman hte nang chya ya ndai, Nye a gawm a kabrat nga li ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gaja wa, ngai ahkrung nga ai nhtoi nlang hte hta, Kaja ai hte chyeju ngai kaw hkan nang nna, Yehowa a nta hta ngai prat dingnawng, anga nga lu na ring ngai law.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lamu ga hte de a yawng mayawng hta, Mungkan ga hte dai hta shanu nga ai ni nlang hte hpe, Yehowa madu nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi dai hpe nammukdara ntsa e gaw da nna, Hka lam ni a ntsa e tawn da wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa a bum de kadai lung lu na rai nga a ta? Shi a chyoi pra ai shara e kadai tsap nga lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />San seng ai lata hte chyoi pra ai myit rawng nna, Tinang myit masin kaman lila hpe n nawn n sawn ai hte, Hkalem ai hku n dagam ai wa, rai lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dai wa gaw Yehowa kaw na shaman ai hte, Shi hpe hkye hkrang la ai Karai Kasang kaw na dinghpring ai, lu la na ru ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ndai amyu shi hpe tam ai amyu rai nga ai: Na a myi man hpe hkan tam ai ni Yaku rai nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="7" style="v" />Hpung shingkang rawng ai Hkawhkam wa shang lu u ga, Mare chyinghka ni e, tinang a baw hpe sharawt mu; Prat dingsa na chyinghka ni e, tinang a hkum sharawt mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpung shingkang rawng ai, ndai Hkawhkam wa gaw, kadai wa rai nga a ta? N-gun chyalai rawng ai, share kaba ngu ai Yehowa, Majan hta share kaba tai ai Yehowa rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hpung shingkang rawng ai Hkawhkam wa shang lu u ga, Mare chyinghka ni e, tinang a baw hpe sharawt mu; Prat dingsa na chyinghka ni e, tinang a hkum sharawt mu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hpung shingkang rawng ai, ndai Hkawhkam wa chyawm gaw, kadai wa rai nga a ta? Zaw nawng zaw wa up ai Yehowa Shi gaw hpung shingkang rawng ai Hkawhkam wa rai nga ai law.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nye a myit masin hpe ngai nang kaw sharawt nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a Karai Kasang e, nang hta ngai shingbyi nga nngai; Ngai kaya kahpa hkrum na nngai n rai: Nye a gumlau ni ngai hpe dang lu na mi ai, n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai sa, nang hpe myit mada ai ni nlang, kaya kahpa n hkrum lu ma ai. Myit magaw ai ni mahtang, kaya kahpa hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, na a lam ngai hpe madun ya e, Na a lai ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai hpe hkye hkrang la ai Karai Kasang nang rai nga ndai majaw, Na a sadi sahka ai hta ngai hpe woi wa nna sharin ya e; Shani tup ngai nang hpe myit a mada nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa e, na a n-gaw nwai ai hte na a chyeju hpe dum u. Dai hte gaw moi chyaloi nhkoi kaw nna rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Prat ram nga yang galaw ai yubak hte, Nye a shut hpyit ai hpe hkum matsing da ya et. Yehowa e, na a kaja htum ai myit majaw, Na a chyeju hte maren ngai hpe dum e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw mai kaja ai hte dingman ai wa rai nga ai: Dai majaw, shi gaw dai lam hta, yubak kap ai ni hpe sharin ya mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Myit gyip ai ni hpe tara lam de shi lau la nna, Myit gyip ai ni hpe shi a lam sharin ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa a ga shaka hte sakse ga hkam ai ni a matu, Shi a lam nlang hte gaw chyeju hte sadi sahka rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa e, na amying majaw, nye a yubak hpe dat kau ya e: Kaning rai nme law, dai gaw kaba nga li ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa hpe hkrit hkungga ai wa kadai rai nga a ta? Dai wa gaw gara hku mai hkan na, shi hpe madun ya na ru ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a myit masin ngamu ngamai ai hta nga lu nna, shi a kashu kasha ni mung, dai mungdan hpe madu lu na maru ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa hpe hkrit kamyin ai ni, shi a sung ai lam chye nga nna, shi shanhte hpe shi a ga shaka chye lu shangun mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a myi Yehowa hpe tut tut a yu nga ai rai nna, Shi nye a lagaw hpe sumgawn hta na shaw la ya nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai myit karen nna, nni nkri hkrum nga nngai majaw, Ngai hpang de kayin nna, matsan dum la e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a myit ru tsang ai gaw, kaba wa nga ai, Nye a tsin-yam tsindam hta na ngai hpe shaw la e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a nni nkri hte ruyak ai hpe yu u: Nye a yubak nlang hte hpe dat kau ya e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nye a gumlau ni hpe yu u; shanhte law nga ma ai: N-yun bu let shanhte ngai hpe n dawng n yawt nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a myit masin hpe bau sin ya nna, Ngai hpe hkye hkrang la e; Nang hta ngai shingbyi nga nngai majaw, Ngai kaya kahpa n hkrum n ga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang hpe ngai myit mada nga nngai majaw, Myit san ai hte dingman ai gaw, ngai hpe sin nga mi ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang e, Israela hpe tinang a ru tsang ai mahkra hta na, hkye hkrang la u law.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nye a myit san pra ai hte ngai hkawm nga nna, Myit n kashai let, Yehowa hpe shamyet shanat nga nngai majaw, Ngai hpe tara dara ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa e, ngai hpe dinglik yu nna chyam yu e, Nye a nhkyun ni hte masin salum hpe manaw yu u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a chyeju nye a myi man e anga nga nna, Na a sadi sahka hta ngai a hkawm nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Matu nhpang n hten ai ni hte rau ngai n dung nngai, Hpyi hpun ai ni kaw, ngai n shang nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />N hkru ai ni a hpawng hpe ngai n dawng nngai, Tara n lang ai ni hte rau, ngai n dung nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai nye a lata hpe dingman ai hte shin nga nngai: Yehowa e, shakawn ai nsen hte lawm lu nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a mauhpa amu nlang hte hpe gawn dan lu hkra, Na a hkungri grup yin e, ngai nga mayu nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, na a nta a htingra hte, Na a hpung shingkang dan hkung ai shara hpe, ngai tsawra nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yubak kap ai ni hte rau, nye a myit masin hpe, Asai kap ai ni hte rau, nye a asak hpe, hkum rawng da ya e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte a lata hta n hkru n hkra ai rawng nga nna, Hkra lata gaw sake manawn hte hpring nga malu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai chyawm gaw, nye a myit san pra ai hte hkawm nga nngai: Ngai hpe hkye hkrang la e, ngai hpe matsan dum la e law.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nye a lagaw dam lada ai shara hta e tsap nga ai: Shawa hpawng ni hta e, ngai Yehowa hpe shagrau sha-a na nngai.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw nye a nhtoi hte hkye hkrang la ai lam rai nga ai, Kadai wa hpe ngai hkrit nga n ta? Yehowa gaw nye a asak shingbyi shara rai nga ai, Ngai kadai wa hpe hkrit kajawng na rai nga a ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a hkum shan sha na, n hkru ai ni sa wa nna, Ngai hpe zingri ai ni hte gumlau ni, ni wa ma jang, Shanhte ahtu kataw nna hkrat mat ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Luksuk ni nye a man e dap jung nga ma timung, Nye a myit hpa n hkrit li ai; Majan pru wa nga timung, Dai hta she nye a myit grin nga na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lam langai mi ngai Yehowa hpe hpyi se ai: Ngai ahkrung nga ai nhtoi hte ting, Yehowa a nta hta nga nga lu nna, Yehowa a tsawm pra ai mu lu na hte, Shi a Htingnu e myit htang nga na, ngai ra nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw ruyak ai nhtoi hta shi a npan e ngai hpe makoi da ni ai; Shi sum a shingbyi shara hta ngai hpe magap da nngai: Lunghkrung ntsa e, shi ngai hpe shadun da ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya shi gaw, grup yin e nga ai, ngai hpe gumlau ai ni a ntsa e, Nye a baw hpe, sharawt ya ni ai. Shi a sum hta pahtau dum let ngai hkungga jaw na nngai. Ngai Yehowa hpe mahkawn mangoi nna, tingse dum na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, ngai jahtau yang, madat mara ya e, Ngai hpe matsan dum nna htan ya e.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Nye a myi man hpe tam mu,” nga nna, nye a myit masin hpe tsun ndai majaw, Yehowa e, na a myi man hpe ngai tam nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a myi man ngai kaw na hkum makoi kau u; Masin pawt ai hte na a mayam wa hpe hkum kau da et: Ngai hpe karum ai wa nang rai nga nit dai; Ngai hpe hkye hkrang la ai Karai Kasang e, Ngai hpe hkum gang kau et, ngai hpe hkum jahti da et.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye nu wa ni ngai hpe jahka kau rai timung, Yehowa ngai hpe pawn la na nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa e, na a lam ngai hpe madun ya e, Ngai hpe gyam yu ai ni a majaw, malang ai hku hta ngai hpe woi wa e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kashun kashe maw ai ni hte, N teng n man ai sakse ni nye a man e rawt nga ma ai majaw, Gumlau ni ra ai lam hta ngai hpe hkum ap kau da et.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkrung nga ai ni a shara hta e, Yehowa a kaja htum ai hpe ngai naw mu lu na nngai, ngai n kam taw gaw, myit htum ni ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa hpe myit mada nga u; Dakan nga nna, na a myit dakring nga u: Rai sa, Yehowa hpe myit mada nga u ga law.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nang hpe ngai jahtau nga nngai; Nye a lunghkrung e, na lahpang ai wa zawn hkum tai et: Nang atsin sha nga n yang gaw, nsung hku hta shang ai ni zawn, Ngai mung rai na rai nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a chyoi pra ai gawk de nye a lata ladawn let, Nang hpe hpyi jahtau ai shaloi jang, Nye a akyu hpyi ai nsen madat mara ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tinang a htingbu wa hte, mung pyaw ga jahta nna, Tinang a myit hta n hkru ai lam maw ai, N shawp ai amu galaw ai ni hte, tara n lang ai ni hte rau, Ngai hpe hkum dun gang kau et.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a amu hte n hkru ai lam hte maren shanhte hpe bai tai u; Shanhte a lata galaw ai hte maren, shanhte hpe bai jaw u; Shanhte a amu shanhte hpang de nhtang dat u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, shanhte gaw Yehowa a bungli hte, Shi a lata galaw ai amu hpe, hpa n nawn nga ma ai. Shi shanhte hpe run kau na mu ai, shagrin da na mu ai, n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa gaw ngai akyu hpyi ai nsen madat mara ya ai majaw, a nga u ga law.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa gaw nye a n-gun hte n-gang rai nga ai, Shi hta nye a myit shingbyi nga nna ngai karum ai hkrum ni ai. Dai majaw nye a myit awng nga nna, Mahkawn mangoi let ngai shi hpe chyeju jaw na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw shanhte a matu n-gun rai nga ai, Shi a Namman chya ai wa a matu, makawp maga ai bunghku, shi rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a amyu hpe hkye hkrang lu u, Na a sali wunli hpe shaman ya e; Tutnawng e shanhte hpe woi rem nna pawn la mu law.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Wa a kasha ni e, Yehowa hpe daw mu, Hpung shingkang hte daru magam, Yehowa hpe jaw mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa a mying nsang hpe hpung shingkang jaw mu, Chyoi pra ai hte mawn sumli nna Yehowa hpe naw mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa a nsen nammukdara ntsa e nga nga ai, Hpung shingkang dan hkung ai Karai Wa gaw ngoi wu nga ai: Yehowa gaw hka kaba ni a ntsa e anga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa a nsen, nsen kaba rai lu ai, Yehowa a nsen, hpung kaba rawng nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa a nsen arit hpun ni hpe daw kau lu ai, Rai sa, Yehowa gaw Lebanon arit maling hpe agrawp kau wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />shi dai ni hpe dumsu kasha zawn gumtawng shangun mu ai; Lebanon hte Sirion yan hpe hpawlam kasha zawn di mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa a nsen wan nli shabra dat mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa a nsen dai nam mali hpe ashun wu ai; Yehowa Kadesha nam mali hpe awam wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa a nsen tsu yi ni hpe kasha jahkai mu ai rai nna, Maling ni hpe ashin ashan di kau mu ai. Shi a Htingnu na arai yawng, “Hpung shingkang nga ai,” nga nna garu ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa gaw Sha-u sha-ing ai ntsa e, dung nga sai; Yehowa gaw htani htana Hkawhkam adung nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa shi a amyu hpe n-gun shaja na ru ai; Yehowa shi a amyu hpe ngwipyaw ai hte shaman ya na ru ai law.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, ngai nang hpe shagrau na nngai: Nang ngai hpe shaw la nit dai rai nna, gumlau ni awng wa na ahkang n jaw ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a Karai Wa Yehowa e, ngai nang hpe jahtau nna, Nang ngai hpe shamai ya nit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, Katsan ga na nye a myit masin hpe nang shaw la nna, Nsung hku de n shang u ga, ngai hpe shabran nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa a chyoi pra ai ni e, shi hpe shakawn mu, Shi a chyoi pra ai masat dingsat hpe mahkawn mangoi mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, shi hkring mi sha masin pawt nga ai, Shi a n-gaw nnyeng chyawm gaw, prat tup agrin nga ai; Shana e hkrap ngu hkrap ngoi gaw shang nga timung, Jahpawt e mahkawn mangoi shara rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ngai galoi mung shamu shamawt hkrum na nngai n rai,” nga nna, ngamai ai shaloi e ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, nang gaw na a n-gaw nnyeng hte nye a bum hpe shangang da nu ai; Na a myi man hpe makoi kau yang, ngai mak mak rai nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai gaw: “Dai nsung hku de ngai shang yang, Nye a asai hpa akyu nga lu na a ta? Ga nhpu nang hpe shakawn lu na a kun? Na a sadi sahka hpe shana ya lu na a kun?”
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngu nna Yehowa hpe ngai shaga nna, Nye a Madu hpe akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa e, madat mara ya nna, ngai hpe matsan dum la e, Yehowa e, ngai hpe karum ai wa tai nga u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a yawn hkyen ai hpe ka gumlawt ai hte nang galai ya ndai; Nye a lachyit nba hpe nang raw kau ya nna, Kabu gara ai hte ngai hpe shingkyit kyit ya ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai majaw galoi mung n sim n sa hkra, Nye a arawng nang hpe mahkawn mangoi na ra ai; Nye a Karai Kasang Yehowa e, Ngai nang hpe htani htana e shakawn kungdawn na nngai.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nang hta ngai shingbyi nga nngai; Ngai galoi mung kaya kahpa n hkrum n ga: Na a dinghpring ai hte ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a na ngai hpang de kayin dat u. Alawan ngai hpe hkye hkrang la e: Nye a matu grin ai lunghkrung tai nga u, Ngai hpe makawp maga na wahpang nta tai nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a lungpu hte wahpang nang rai nga ndai rai nna, Na a amying majaw ngai hpe woi wa nna, lakawn la e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a makam masham nang rai nga ndai majaw, Shanhte nye a matu hkam ai mahkam na, Ngai hpe gare shaw la e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a lata hta nye a wenyi hpe ngai ap ya de ai; Tengman ai Karai Wa Yehowa e, Nang ngai hpe hkrang la nit dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kaman lila hkan nang ai ni hpe ngai n dawng nngai: Ngai Yehowa hpe shamyet shanat nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a nni nkri hpe nang mu nga nna, Nye myit masin a ru tsang ai hpe chye nga ndai; majaw, Na a chyeju hta ngai kabu nna shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gumlau ni a lata hta nang ngai hpe ap kau ndai n rai, Dam lada ai shara e, nang nye a lagaw hpe shatsap ya ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa e, nye a matu ru tsang nga ai majaw, Ngai hpe matsan dum la e; Nye a myi, nye a myit masin hte hkumhkrang gaw, Sharung shayawt ai hte gyip mat masai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a asak ruyak ai hte htum mat sai, Shaning shanang madai ai hte lai mat wa nngai: Nye a mara majaw nye a n-gun yawm mat nna, Nye hkum a nrut nra ni tsam mat masai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gumlau ni law ma ai majaw, ngai shatan shara tai nga nna, Htingbu ni a matu myit ba shara rai nga nngai; Ngai hpe chye chyap ai ni a hkrit shara ngai tai nga nna, Shinggan e ngai hpe mu ai ni koi hprawng ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Si mat ai masha hpe zawn ngai malap kau ai hkrum nngai, dibu chyaga zawn ngai tai nga nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Masha ni tsun shatan ai ga ngai na lu nna, Grup yin e hkrit shara hkrai rai nga ai: Shanhte nye a lam jawm bawng ma yang, Nye a asak la kau na hpaji daw ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai chyawm gaw, nang hta shamyet nga nngai, Yehowa e; “Nang gaw nye a Karai Kasang rai nga ndai,” ngai nga nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a aten aprat na a lata hta rai nga li ai: Gumlau ni hte hkan shachyut ai ni a lata na ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a myi man gaw, na mayam a ntsa e, htoi nga u ga: Na a chyeju hte ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa e, ngai nang hpe shaga nga nngai majaw, Kaya kahpa ngai n hkrum na nngai. Tara n lang ai ni chyawm gaw, kaya kahpa hkrum nna, Katsan ga e atsin sha nga na mara ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />gumrawng nna shatan nhkan ai ga hte Dinghpring ai ni hpe, n gawn n sawn hku masu ai nten gaw, ma-a mat malu ga.
  </para>
  <para style="p">
    <verse number="19" style="v" />Masha kasha ni a man e, nang hta shingbyi ai ni a matu nang galaw dan nna, Nang hpe hkrit kamyin ai ni a matu nang kyem da ai chyeju gaw, gade wa kaba nga a hka!
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang shanhte hpe masha a gasat gala kaw nna, na a myi man a makoi shara hta e, makoi da nna, Masha a ru hka na, na a sum hta e, ka-up da na mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa gaw, a nga u ga law! ngang ai mare hta, Mauhpa sumnung ai myit, shi ngai hpe madun dan ni ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai chyawm gaw, “Na a man e ngai n shang lu nngai,” nga nna, myit kaji let tsun nga nngai; Rai timung, nang hpe hpyi jahtau yang, Ngai akyu hpyi ai nsen nang madat ya ndai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa a chyoi pra ai ni e, shi hpe tsawra mu: Yehowa gaw sadi sahka re ai ni hpe lanu lahku nga ai: Gumrawng ai amu galaw ai wa hpe chyawm gaw, shi gaja wa ari jaw wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa hpe ala nga ai ni nlang hte e, Dakan nga nna, nanhte a myit dakring rai nga mu law.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shut hpyit ai hta na raw dat kau ya ai hte, Yubak hpe makoi kau ya ai hkrum ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa e mara n shagun nna, shi a wenyi hta ra n rawng ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai atsin sha nga nga yang, Tut tut sharung shayawt nga nngai majaw, Nye a nrut nra ni tsam mat ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a lata gaw shani shana nye a ntsa e a li nga nna, Nye a salat, nlum ta hta na hkraw hkun ai hte galai mat sai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Shaloi ngai gaw nye a yubak nang hpe madun dan nna, Nye a mara hpe makoi da nngai n rai: “Ngai shut hpyit ai lam Yehowa hpe ngai nem kau na,” ngai a tsun nga nna, Nang gaw nye a yubak mara hpe raw kau ya nit dai. [Selah.]
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai re ai majaw nang hpe hkrum lu ai aten hta e, Chyoi pra ai ni nlang nang kaw hpyi mu ga; Gaja wa, hka kaba tung wa timung, Shanhte kaw du lu na n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw nye a makoi magap shara rai nga ndai, Ru tsang ai lawt u ga, nang ngai hpe sin nga ndai: Padang nlaw mahkawn ga hte nang ngai hpe kawan da ni ai. [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai nang hpe sharin ya nna, nang sa wa na lam madun ya na nngai, Nang hpe mada let hpaji daw ya na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Myit n rawng ai gumra hte lawze zawn hkum rai myit: Nang kaw ani sha n du hkraw ai majaw, Hpri makrang hte gumhtung sumri hte dai ni hpe dun la lu na rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tara n lang ai ni a matu atsu atsam law law nga timung, Yehowa hta shamyet shanat nga ai ni hpe, chyeju hte kawan da nga mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dinghpring ai ni e, Yehowa hta kabu gara let shakawn mu; Myit dinghpring ai ni nlang hte e, kabu gara let kungdawn mu law.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dinghpring ai ni e, Yehowa hpe shakawn mu; Myit dinghpring ai ni a kungdawn ga sut nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tingse dum let Yehowa a chyeju shakawn mu, Sumri shi rawng ai duria hte shi a matu dum mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a matu mahkawn ga nnan mahkawn mu, Kabu gara jahtau let pyaw pyaw dum mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, Yehowa a ga dingman nga ai, Shi a amu nlang hte gaw kangka rai nga lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dinghpring ai hte tara ding ai lam shi tsawra ai, Lamu ga ting Yehowa a chyeju hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa a mungga hte sumsing lamu tai nga nna, Shi a n-gup na nsoi nsa hte, de a zaw nawng zaw wa byin nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw nammukdara a hka hpe sumpum gumdin da nna, Sung htum ai shara hpe dum hta mahkawng da nu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa man e, aga ting hkrit kamyin nga u ga, Mungkan e nga ai ni nlang hte gaw agam nga mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaning rai nme law, shiga tsun nna byin nga ai, Shi htet da nna shi a ga grin nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Masha amyu ni a hpaji daw ai hpe, Yehowa shanut kau ya mu ai: Amyu baw ni a myit ai hku hpe, shi hkum da mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa hpaji daw ai lam htani htana anga nga ai. Shi myit ai hku prat mi hte prat mi agrin nga lu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang ngu ai, Yehowa hpe nawku ai amyu hte, Sali wunli matu shi lata la ai abaw gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa gaw lamu de nna mada yu nga ai, Shinggyim masha ni nlang hte hpe a mu nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi dung nga ai shara kaw nna, Ga ntsa masha nlang hte hpe a matsing nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi gaw shanhte a myit nga manga hte hpe hpan ya nna, Shanhte a amu nlang hte hpe, aru nga ya mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kadai hkawhkam mung, luksuk kaba hte lawt lu ai n rai, Gara share mung, tinang a n-gun kaba hte lawt lu ai n rai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nlaw na matu gumra lali rai nga ai. Kadai hpe mung de a n-gun kaba hte, shalawt lu na n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yu mu, Yehowa hpe hkrit kamyin ai ni hte, Shi a chyeju ala nga ai ni a ntsa e,
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte a myit masin hpe si ai kaw na mawai la ya na hte, Hku hku ai nhtoi hta shanhte shabran la na nga, Shi a myi a yu nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Anhte a myit masin Yehowa hpe a la nga ai; Shi gaw anhte hpe karum ai wa hte anhte a n-gang rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a chyoi pra ai amying hta anhte shamyet shanat nga ga ai majaw, Anhte myit masin shi hta kabu nga ga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa e, nang hpe a la nga ga ai hte maren, Na a chyeju anhte a ntsa e jahkrat ya mi law.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai Yehowa hpe prat tup sha-a nga na nngai, Shi a shakawn ga nye a n-gup hta tut e rawng nga u ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a myit masin Yehowa hta gumrawng na ra ai; Myit gyip ai ni, na lu nna kabu na mara ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai hte rau Yehowa hpe shagrau ga; Shi a amying hpe anhte jawm sharawt gaw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai Yehowa hpe tam nna, shi ngai hpe htan ya ni ai; Hkrit gari ai nlang hte hta na, shi ngai hpe mawai la nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw shi hpe mada yu nna, nhtoi mu lu ma ai, Shanhte a myi man kaya kahpa n hkrum na malu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ndai matsan mayan wa shaga nga yang, Yehowa madat mara nga nna, ru tsang ai nlang hta na shi hpe hkye la wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa hpe hkrit kamyin ai ni a grup yin e, Shi a Lamu kasa dap jung nga nna, shanhte hpe mawai la mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa mai kaja nga ai gaw, chyim yu nna chye mu; Shi hta shingbyi ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa a chyoi pra ai ni e, shi hpe hkrit hkungga mu: Shi hpe hkrit hkungga ai ni, hpa mung n ra ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hkanghkyi hkalung ni lusha kadawn nna, kawsi hkrum ma timung, Yehowa hpe tam ai ni kaja ai hpa mung n ra ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Wa marit, ma ni e, nye a ga madat mu: Yehowa hpe hkrit hkungga na lam, ngai nanhte hpe sharin ya made ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aprat galu na ra nga nna, kaja ai hkrum u ga. Nhtoi law law tsaw ai wa kadai mung,
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a shinglet hpe n hkru ai kaw na jahka la u, Na a n-gup hte hkalem ai ga, hkum tsun et:
  </para>
  <para style="p">
    <verse number="14" style="v" />N hkru ai hpe koi kau nna, kaja ai galaw u, Ngwipyaw ai hpe tam nna, hkan sa nga u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa a myi gaw dinghpring ai ni hpe yu nga nna, Shanhte a jahtau ai ga hpe shi a na madat nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />N hkru ai amu galaw ai ni a matsing shara, Ga ntsa na shaprai kau na, Yehowa a myi man da nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dinghpring ai ni jahtau yang Yehowa madat nga nna, Ru tsang ai nlang hta na, shanhte hpe mawai la mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa gaw myit maku daw ai ni hte ani sha rai nga ai rai nna, Wenyi htum ai ni hpe hkye la mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dingman ai wa gaw ru tsang law law hkrum nga timung, Yehowa shi hpe nlang hta na mawai la nu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi a nrut nra yawng hte hpe shi yu ya nga nna, Langai mi muk daw mat lu ai n rai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yubak gaw n hkru ai ni hpe sat kau na mu ai; Dingman ai wa hpe n dawng ai ni, mara kap na mara ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa gaw shi a ali ama ni a myit masin hpe hkrang la ya mu ai. Shi hta shingbyi ai ni nlang hte gaw mara n kap na mara ai.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, ngai hpe ndang kalang hkat ai ni hte, nang ndang kalang hkat u, Ngai hpe hpyen gasat ai ni hte, hpyen gasat u.
  </para>
  <para style="p">
    <verse number="2" style="v" />N-gang kaling hte n-gang galu la nna, Ngai hpe karum na, rawt u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ri mung dawn nna, Ngai hpe hkan shachyut ai ni a lam pat kau u. “Na a hkye hkrang la ai lam ngai rai nga nngai,” nga nna nye a myit masin hpe tsun u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a asak hpe tam ai ni, kaya kahpa hkrum nna myi man sum mu ga, Ngai hpe hkala kau na maw ai ni, kanut wa nna mak mat ai hkrum mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nbung e poi mat ai mahkaw zawn, shanhte rai mu ga, Yehowa a lamu kasa mung shanhte hpe ye kau mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte a lam nsin sin nna manen nga u ga, Yehowa a Lamu kasa mung shanhte hpe hkan shachyut mu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mara n nga ai mi, shanhte nye a matu mahkam up da nna, Mara n nga ai mi, nye a asak a matu nhkun htu ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />N dum shami e shi hten mat u ga; Shi up da ai mahkam hta shi dai lu u ga, Dai hta e rung rai u ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shing rai nye a myit masin Yehowa hta kabu nga nna, Shi a hkye hkrang la ai lam hta sharawng awng nga na li ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa e, “nang zawn kadai rai nga a hka? Nni nkri hkrum ai wa hpe, shi hta n-gun grau ja ai wa kaw na, Nni nkri hkrum ai wa hte matsan mayan wa hpe, Zingri zingrat ai wa kaw na, nang mawai la nga ndai,” nga nna nye a nrut nra nlang hte gaw tsun na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />N hkru ai sakse ni rawt ma ai: Ngai n chye ai lam shanhte ngai hpe san ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte kaja ai hpe n kaja ai hte htang ma ai. Nye a myit masin karut nga li ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai chyawm gaw, shanhte machyi nga ma yang, lachyit nba bu hpun nna, Lusha gam ai hte myit gawng run nga nngai. Ngai akyu hpyi ai ga nye a sinda e a htu nga li ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jinghku hte hpunau a matu zawn, ngai yawn hkawm nga nna, Kanu a majaw sharung shayawt ai wa zawn, Yawn palawng hte ngai karen hkawm nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai timung, ngai kataw yang, shanhte kabu nna hpawng ma ai: N hkaw ai ni hte ngai n chye ai ni, nye a man e hpawng nga ma ai. Shanhte asawng asang re ai n sim ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shat hpraw madoi ai ni hte rau, shanhte ngai hpe wa utik mi ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Madu e, gaten du hkra nang a yu nga na n ta? Shanhte a jahten ai hta na nye a myit masin hpe, hkanghkyi ni kaw na nye a asak shingtai hpe, shaw la ya e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi shawa hpawng kaba e ngai nang hpe shakawn na nngai, Masha law law a ka-ang e nang hpe kungdawn na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Masu ai lam hkan nna ngai hpe gumlau ai ni, n kabu lu mu ga, Mara n nga ai mi, ngai hpe n dawng ai ni, myi kunglau n rai lu mu ga.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kaning rai nme law, shanhte ngwipyaw ai ga n tsun nna, Dai mung e anu sha nga nga ai ni hpe, hkalem ai hku maw ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte ngai hpe n-gup mahka nga nna: “Da, da, anhte a myi hte mu lu sagaw ai,” nga ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa e, nang mu nga ndai; atsin sha hkum nga et: Madu e, ngai hte tsan tsan hkum nga et.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nye a Karai Kasang hte Madu e, ngai hpe tara dara na hte ngai hpe jeyang ya na nga, na hkum hpe jasu nna rawt u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nye a Karai Wa Yehowa e, na a dinghpring ai hte ngai hpe tara dara ya e. Shanhte mung nye a lam n kabu lu mu ga.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Ara, anhte ra ai hku rai sai,” nga nna shanhte a kraw e n tsun lu mu ga, “Anhte shi hpe mayu kau sagaw ai,” n nga lu mu ga.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ngai ru tsang hkrum ai majaw kabu ai ni, kaya kahpa hkrum nna mak mat mu ga; Nye a jaw e tinang hkum hpe shagrau ai ni, kaya kahpa hte myi man sum ai, dagrup nga mu ga.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nye a dingman ai lam tsawra ai ni chyawm gaw, Kabu jahtau nna sharawng awng nga mu ga: “Shi ali ama a ngwipyaw na lam yaw ya ai Yehowa gaw, galu kaba nga u ga,” nga nna shanhte tut tut a tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nye a shinglet, na a dinghpring ai lam hte, Nang hpe shakawn kungdawn ai lam, shani tup a tsun nga na li ai.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yubak gaw tara n lang ai wa hpe, “Nye a kraw lawang hta, Yehowa a man e, Hpa hkrit hkungga shara n nga ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, shi shut hpyit ai gaw, masha ni n mu hkrup nna, N dawng nga ai du hkra, shi hkum hpe maw kau wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a n-gup ga n hkru ai hte hkalem ai ga rai nga lu ai; Shi gaw hpaji byeng-ya hte kaja ai lailen kau da nu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a yup ku hta n hkru ai hku daw nga ai, N kaja ai lam hta shi a tsap nga ai: N shawp ai hpe shi matsat kau wu ai n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, na a chyeju sumsing lamu du hkra, na a sadi sahka sumwi du hkra, dep nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a dinghpring ai gaw Karai Wa a bum ni zawn rai nga ai, Nang dawdan ai hku nachying sung nga lit dai; Yehowa e, masha hte yamnga hpe, nang lanu lahku nga ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang e, na a chyeju gade wa hpu nga lit hka! Masha kasha ni, na singkaw a shingnip hta shingbyi nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a nta na sau hpum ai hte shanhte hkru kat nga ma ai, na a ngwipyaw ai hka hta na, nang shanhte hpe shalu mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang hte rau asak hka hpawk rai nga ai; Na a nhtoi majaw anhte nhtoi mu lu na ga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang hpe chye chyap ai ni a matu na a chyeju, Myit malang ai ni a matu na a dingman ai hpe, a madun nga u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gumrawng ai lagaw ngai hpe n dep u ga, Tara n lang ai ni a lata, ngai hpe n shamawt mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shut ai hku galaw ai ni dai yang e kataw nga ma ai; shanhte kanawng kau ai hkrum nna, n rawt lu ma ai.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />N shawp ai ni a lam myit hkum kahtet et, n hkru ai amu galaw ai ni hpe, hkum manawn et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsingdu zawn shanhte alawan dan kau ai hkrum nna, tsit lali ai maku zawn nyip mat na mara ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa hpe shamyet shanat nga nna kaja ai amu galaw u: Dai mung hta shanu nga nna, sadi sahka hpe tam u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa hta sharawng awng nga nna, na a myit hpyi ai hku shi nang hpe jaw na ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a lam Yehowa hpe ap yu u: shi hpe kamsham nga u, shi shabyin ya na rin dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw na a dinghpring ai hpe sawmrawm nhtoi zawn, na a dawdan ai hpe, jan pungding shingkang zawn, shapraw dan na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa a man e amu sha nga nna shi hpe ala nga u: myit magaw ai hku maw nna, shabyin lu ai hte, n hkru ai lam hta awng nga ai wa a jaw e, myit hkum kahtet et.
  </para>
  <para style="p">
    <verse number="8" style="v" />Masin pawt ai kau u, n-yun hkum bu et. Myit hkum kahtet et, yubak sha pru na ra ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />N shawp ai ni kran kau ai hkrum na mara ai; Yehowa hpe myit mada ai ni, lamu ga hpe madu lu na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gade n na yang, tara n lang ai wa nga nga lu na n rai, Shi shanu ai shara e tam yu yang, shi n nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Myit gyip ai ni mahtang lamu ga hpe madu lu nna, Angwi apyaw hta sharawng awng na mara ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tara n lang ai wa, dingman ai wa hpe n kaja ai hku maw nna, shi a wa utik da nga wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a nhtoi du na ra ai, dai Madu chye nga nna, shi hpe mani kau da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nni nkri hkrum ai ni hte matsan mayan ni hpe kataw mu ga, lam ding ding hkan ai ni hpe sat kau na nga, tara n lang ai ni nhtu shaw nna, ndan shachyen nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte a nhtu tinang a salum hta htinggrang wa nna, shanhte a ndan ni mung agrawp mat na malu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tara n lang ai ni a n taw n tsang lu ai hta, Dingman ai wa a kaji sha gaw, grau mai nga ai:
  </para>
  <para style="p">
    <verse number="17" style="v" />Tara n lang ai ni a lata hpe agrawp kau ai hkrum na ra ai, Dingman ai ni hpe chyawm gaw, Yehowa shadaw da nga mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mara n rawng ai ni a nhtoi hpe Yehowa chye nga ai; shanhte a sali wunli mung htani htana anga nga ai:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ruyak ai aten e shanhte kaya kahpa n hkrum nna, Hku hku ai nhtoi hta e hkru kat lu na ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tara n lang ai ni hten byak mat ai hkrum na mara ai; Yehowa hpe gumlau ai ni, prang na nampan zawn rai nga ma ai: Wan nhkut zawn shanhte hkoi mat na ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tara n lang ai wa, hkoi la nna bai n wa lu ai; Dingman ai wa chyawm gaw matsan dum chye nna, jaw lu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi a shaman ai lu la ai ni gaw lamu ga hpe madu lu na mara ai; Shi e dagam kau ai ni gaw, kran kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Yehowa gaw masha sa wa na hku san da nga ai rai nna, Shi a lam hta sharawng awng nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa shi a lata hpe shadaw ya wu ai majaw, shi kataw yang, taw nan nga na n rai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngai shabrang brang nna ya dingla ni ai: Rai timung, dingman ai wa kau tawn da ai hkrum nna, Shi a kashu kasha ni muk sa hpyi ai gaw, ngai n mu yu nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi tut tut matsan dum chye nna hkoi ya nga ai; shi a kashu kasha ni shaman ya ai hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />N shawp ai hpe koi kau u, kaja ai amu galaw nna, Prat dingsa e anga nga u.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yehowa gaw tara ding ai hku tsawra nga nna, Shi a chyoi pra ai ni hpe kau da mu ai n rai: Shanhte prat dingsa e anga nga na ma ai. Tara n lang ai ni a aru arat chyawm gaw, kran kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dinghpring ai ni gaw dai mungdan hpe madu lu nna, Dai hta e nan nawng e nga nga lu na mara ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dinghpring ai wa a n-gup gaw hpaji ga hkai dan nga nna, Shi a shinglet tara ding ai hku a tsun nga ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi a Karai Wa a tara gaw shi a kraw lawang hta e rawng nga ai; Shi a lagaw lahpan kashawt lu na n rai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tara n lang ai wa gaw dinghpring ai wa hpe gyam yu nna, Shi hpe sat kau na tam nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yehowa gaw shi a lata hta shi hpe ap kau na wu ai n rai, Tara dara ai hkrum yang, shi yubak hkrum na n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Yehowa hpe myit mada nga nna, shi a lam hpe dum u, Shaloi, dai mungdan hpe madu na, shi nang hpe shagrau na rin dai: Tara n lang ai ni hpe kran kau ai gaw, nang mu mada lu na rin dai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tara n lang ai wa gaw daru magam rai lu nna, Shi a shara e tu ai hpun zawn kaba wa ai gaw, Ngai mu lu nngai rai timung:
  </para>
  <para style="p">
    <verse number="36" style="v" />Marai mi lai wa yang, yu u, shi n nga ai, Ngai shi hpe tam we timung, n mu we ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mara n rawng ai wa hpe matsing u, Myit malang ai wa hpe mada yu u: Ngwi ai lam hkan ai wa a aru arat pra nga ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shut hpyit ai ni chyawm gaw, lang lata sha hten wa na mara ai; Tara n lang ai ni a aru arat, kran kau ai hkrum na mara ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dinghpring ai ni a hkye hkrang la ai lam gaw Yehowa kaw na rai nga ai, Ru tsang ai aten hta e shi shanhte a makawp maga rai nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Yehowa gaw shanhte hpe karum nga nna mawai la mu ai: shi hta shingbyi nga ma ai majaw, shi shanhte hpe tara n lang ai ni kaw na, mawai la nna, hkye hkrang la mu ai.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, na a masin pawt ai hte ngai hpe hkum daru et; na a myit kahtet ai hte, ngai hpe hkum sharin ya et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a pala ni nye a hkum hta jung nga nna, Na a lata gaw nye a ntsa e adip nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a sindawng kahtet ai majaw, nye a hkum shan hkam kaja nga ai n rai, Nye a yubak majaw, nye a nrut nra ni masa nga ma ai n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai shut hpyit ai gaw nye a baw lim nga nna, li ai lit zawn nye a matu nau wa li la nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai angawk angak ai amu majaw, Nye a nma ni manam nga nna a bya nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Du krung ai hte ja ja htingkung nna, ngai nga nga nngai; Shani tup yawn palawng hte ngai karen hkawm nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a mashi ting kahtet machyi nga nna, nye a ashan hkam kaja nga ai n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hpam mat ma nna, agrawp agrap ngai rai nga nngai; Nye a kraw lawang na madai ai majaw shabam nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, ngai ra ai nlang na a man e nga nga ai; Ngai madai ai mung, nang n chye ya nga ndai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a salum a duk nga ai, nye a n-gun yawm mat sali ai; Nye a myi a nhtoi pyi mat mat sai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a ana majaw, tsawra ai ni hte jinghku ni ngai hte daw hka wa nna, nye a htingbu ni tsan tsan e tsap nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nye a myit masin hpe tam ai ni, mahkam hkam nna, Ngai hpe n kaja ai maw ai ni, hkalem ai ga tsun nga ma ai: Shani tup myit magaw ai lam a daw nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai chyawm gaw, na lahpang ai wa zawn, hpa mung n na nngai; N-gup n hpaw chye ai ma-a ai wa zawn, ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Gaja wa, na n na ai wa hte, Ndang kalang ga n chye tsun ai wa zawn, ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai timung, Yehowa e, ngai nang hpe ala nga nngai, Nye a Madu Karai Kasang e, nang htan ya na ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaning rai nme law, “Nye a lagaw kashawt yang, Ngai hta grau mayu ai ni, nye a lam n kabu lu mu ga,” ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai kataw magang wa nga nngai, Ngai yawn hkyen ai nye a man e tut tut anga nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai shut hpyit ai gaw, ngai nem lu na rai nga nngai; Nye a yubak majaw, myit yawn nga na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nye a hpyen ni chyawm gaw, sek sek rai nna, n-gun rawng nga ma ai; Mara n nga timung, ngai hpe n dawng ai ni law wa ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shanhte kaja ai hpe n kaja ai hte htang ma ai; Ngai kaja ai lam hkan nga nngai majaw, Shanhte ngai hte nhtan shai nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa e, ngai hpe hkum kau da et. Nye a Karai Kasang e, ngai hte hkum tsan nga et.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai hpe hkye hkrang la ai Madu e, Ngai hpe karum na lawan rit law.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Nye a shinglet hte ngai n shut nga n ga, Nye a lam ngai sadi nga na nngai; Tara n lang ai wa nye a man e naw nga nga yang, Nye a n-gup ngai hkang da na we ai,” nga nna ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shaloi ngai atsin sha rai nga nna ma-a nga nngai; Mai kaja na hpe pyi ngai hpa mung n tsun nngai: Rai timung, nye a yawn hkyen ai kaba wa li ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a kraw kata na myit kahtet nga li ai, Myit yu nga yang wan grung nga ai. Shaloi nye a shinglet hte ngai ga tsun nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, nye a lam jahtum na hte, Nye a lagaw langa gade gadun nga ai gaw madun ya e: Ngai gade hten loi nga nngai gaw ngai hpe chye shangun ya e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a nhtoi lahpa mi daram nang tawn da ya nit dai; Nye a aprat na a man e hpa mung n rai nga ai: Gaja wa, masha gade reng nga rai timung, Shi kaman lila sha naw rai nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="6" style="v" />Gaja wa, masha wa gaw shingnip zawn hkawm nga ai, Nbung a matu sha, shanhte tsang nga ma ai: Shi mahkawng da nga timung, Kadai lu la na ru ai gaw n chye wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ya chyawm gaw, “Madu e, Hpa jaw ai me ngai la nga na rai nga a ta? Nye a myit mada shara nang hta rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a mara nlang hta na ngai hpe mawai la e: Angawk ai ni a shatan shara ngai hpe hkum shatai et.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang gaw ndai lam shabyin ndai majaw, Ngai n shaga, nye a n-gup n hpaw we ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang ngai hpe shakap ai ana ngai kaw na shapraw kau ya e; Na a lata anu ai majaw, ngai tsam mat ni ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yubak majaw nang daru nna, masha hpe ari jaw yang, nang shi a hpung hpe manut sha ai nba zawn, di kau ya wu ai: Masha mahkra gaw kaman lila sha rai nga ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa e, ngai akyu hpyi ai ga madat mara ya e, Ngai hpyi jahtau ai ga na la ya e; Nang kaw ngai manam rai nga nngai hte, Ngai ji wa ni zawn kaga buga masha rai nga nngai majaw, Nye a myi prwi hpe atsin sha hkum yu nga et.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai garai n pru nna, n mat mat ai hte yang, Gan ga lu n ga, ngai hpe matsan naw dum la e law.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe maja let ngai a la nga nngai; Ngai hpang de shi na kayin nna, Ngai hpyi jahtau ai ga madat ya ni ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />N seng ai nhkun hte kagam hkumpup hta na, Shi ngai hpe shaw la nhtawm, Nye a lagaw hpe lunghkrung ntsa e mara da nna, Nye a lahkam hpe shagrin da nu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte a Karai Kasang hpe shakawn na nga, Shi nye a n-gup hta mahkawn ga nnan jaw da ni ai; Masha law law wa dai mu nna, hkrit hkungga ai hte, Yehowa hpe shamyet shanat na mara ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa hpe shingbyi shara shatai nna, Gumrawng ai ni hte masu ai lam hkan nang ai ni hpe, n yu ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a Karai Kasang Yehowa e, Anhte a matu nang galaw da ai mauhpa hte hpaji daw ai amu, law la lit dai; Nang hte shadawn yu na gaw n nga ai: Dai ni a lam ngai tsun shana ya mayu yang, Dai ni gaw n dang hti hkra law la nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkungga hte lusha kumhpa nang n ra nit dai; Nye a na lashing nang hpaw ya nit dai: Wan nat hkungga hte htingrai hkungga nang n hpyi ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shaloi ngai gaw, “Yu u, ngai sa du ring ngai, Laika katsu hta nye a lam ka da nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a Karai Kasang e, na a myit hkan nang na ngai ra nga nngai; Nye a kraw lawang hta na a tara rawng nga ai,” nga nna ngai tsun ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai gaw dai shawa hpawng kaba a ka-ang e, Dinghpring ai lam a kabu gara shiga hkaw dan ni ai; Yu u, nye a n-gup hpe ngai pat da we ai n rai, Yehowa e, nang nan chye nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a dinghpring ai hpe nye a kraw e ngai ip da we ai n rai: Na a sadi sahka hte hkye la ai lam ngai hkai dan ni ai. Dai shawa hpawng kaba hta, Na a chyeju hte sadi sahka hpe ngai n makoi da nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang mung, Yehowa e, na a n-gaw nwai myit hpe ngai hta na hkum shadang da et. Na a chyeju hte sadi sahka ngai hpe tut tut shadaw nga u ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />N dang hti ai ru tsang ai ngai hpe kawan da ni ai, Ngai n mada yu lu hkra, nye a yubak ngai hpe lep ni ai: Dai ni gaw nye baw kara hta grau law nga ai rai nna, Nye a minla byaw mat sali ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa e, ngai hpe mawai la na, myit dum nga u, Yehowa e, ngai hpe karum na, lawan rit.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a sumri sumdam hpe dan na tam ai ni, Kaya kahpa jawm hkrum nna, myi man sum mu ga: Ngai hpe tsin-yam tsindam jahkrum mayu ai ni, kanut mat wa nna, arawng sum mat mu ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai hpe, “Da, da,” nga ai ni, Shanhte galaw ai kaya kahpa amu a majaw, hten byak hkrum mu ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang hpe tam ai ni nlang hte gaw, Nang hta awng nna, kabu gara nga mu ga: Na a hkye hkrang la ai lam tsawra ai ni gaw, “Yehowa galu kaba nga u ga,” nga nna tut tut a tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai nni nkri hte matsan mayan hkrum nga nngai, Rai timung, dai Madu gaw ngai hpe myit dum nga ai; Ngai hpe karum ai wa hte, mawai la ai wa nang rai nga ndai: Nye a Karai Wa e, hkum ganung nga et law.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Matsan mayan ni hpe dum ai wa gaw, a nga ai; Yehowa gaw dai wa hpe kyin dut ai nhtoi e shalawt dat na wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa shi hpe bau sin shabran la na wu ai, Dai mungdan hta shi apyaw sha nga lu na ra ai: Gumlau ni ra ai hku shi hpe ap kau na wu ai n rai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ali ahti hkrum yang, Yehowa shi hpe shadaw ya na wu ai; Machyi makaw hkrum yang, nang shi a yup ku galai ya na ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai gaw, “Yehowa e, ngai hpe matsan dum la e, Nye a myit masin hpe shamai shatsai ya e: Kaning rai nme law, nang hpe ngai shut ni ai,” nga nna hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gumlau ni nye a lam n hkru ai hku tsun nna, “Shi a amying mat mat lu ga, shi galoi si na ra ai kun?” nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi ngai hpe sa hpu yu yang, kaman ga shi tsun nga ai; Shi a myit shut ai lam matsing da nna, Shinggan de pru jang, dai hpe shabrawng dat wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hpe n dawng ai ni nlang hte gaw nye a lam kahte nga ma ai; Ngai hpe n hkru n hkra ai hku a maw nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />“N hkru ai ana shi hta kap nga ai rai nna, Lang mi kataw yang, shi bai rawt lu na n rai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai manoi nga ai nye a muk sha ai jinghku wa nan, Shi a lahtin hte ngai hpe shingdit nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa e, ngai shanhte hpe tai lu mawe ga, Ngai hpe matsan dum nna, sharawt la e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye hpyen ni ngai hpe n dang lu mi ai majaw, Nang ngai hpe tsaw nga ndai gaw, ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nye a myit malang ai hta nang ngai hpe shadaw ya nna, na a man e ngai hpe tut tut tawn da nga ndai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israela a Karai Kasang Yehowa gaw, Htani htana prat dingsa e, a nga u ga law. Amen, rai sa, Amen.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, shan nga gaw hka shi hka wam machyu ai zawn, Nye a myit masin nang hta machyu nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a myit masin Karai Kasang hpe, Hkrung nga ai Karai Wa hpe, shagroi gara nga ai: Ngai Karai Kasang kaw, galoi wa me dawng pru lu na rai nga ai kun?
  </para>
  <para style="p">
    <verse number="3" style="v" />“Na a Karai Kasang gaw kanang nga lit ta?” Nga nna tut tut a tsun nga ma ai majaw, Nye a myi prwi nye a shat shani shana tai nga li ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, shawa masha ni hte ngai lung wa nna, Poi galaw ai hpawng hpe kabu ai nsen hte mahkawn mangoi let, Karai Kasang a nta de woi sa sa di de ai gaw, Ngai dum nga nna, nye a myit masin ngai hta kabrawng nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a myit masin e, nang hpa majaw kanyung nga n ta? Hpa majaw ngai hta e kadau nga n ta? Karai Kasang hpe a la nga u; shi karum nga ai majaw, Ngai shi a chyeju naw shakawn na we ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a Karai Wa e, nye a myit gawng run nga li ai: Dai majaw Yawdan ginwang, Hermon bum hte, Dai bum kaji hkan nna ngai nang hpe dum nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a hka rum kadu yang, hkringbu langai hte langai wu nga ai: Na a hka leng kaba nlang hte hte, De a gumdin gumhkaw ni gaw, Nye a ntsa e hprwi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw shi a chyeju shani e jaw nga nna, shana e mung shi hpe mahkawn ai ga hte, Nye a asak daju Karai Wa hpe hpyi let, ngai nga nga na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai majaw Karai Wa hpe, Nye a lunghkrung e, Nang hpa rai ngai hpe malap kau nga n ta? Gumlau ni sharu shatsang ai majaw, Yawn hkrum ai wa zawn ngai hpa rai hkawm nga n hka? ngu na we ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Na a Karai Kasang gaw kanang nga lit ta?” nga nna tut tut a tsun nga ma ai majaw, Nye a nrut nra hpe a dup kau ai zawn, Gumlau ni ngai hpe shatan nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a myit masin e, nang hpa majaw kanyung nga n ta? Hpa majaw ngai hta e kadau nga n ta? Karai Kasang hpe a la nga u, Ngai shi a chyeju naw shakawn na we ai: Ngai hpe karum ai wa hte, nye a Karai Wa shi rai nga ai.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, n hkru ai amu a majaw, Ngai hpe dawdan nna jeyang ya e; Hkalem sha ai ni hte n shawp ai ni kaw na, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpe n-gun jaw ai Karai Kasang nang rai nga ndai: Nang hpa rai ngai hpe kau da nga n ta? Gumlau ni sharu shatsang ai majaw, Yawn hkrum ai wa zawn ngai hpa rai hkawm nga n hka?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a nhtoi hte sadi sahka hpe shangun dat mu; Dai yan ngai hpe lakawn la mi ga: Na a chyoi pra ai bum de mung, Na a sumpan nta de mung, ngai hpe woi shang mi ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shaloi Karai Kasang a tawn hkungri hte, Ngai nachying sharawng awng ai Karai Wa kaw, ngai shang wa nna, Karai Kasang e, nye a Karai Kasang e, Tingse hte nang hpe mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a myit masin e, nang hpa majaw kanyung nga n ta? Hpa majaw ngai hta e kadau nga n ta? Karai Kasang hpe a la nga u, ngai shi a chyeju naw shakawn na we ai: Ngai hpe karum ai wa hte, nye a Karai Wa shi rai nga ai.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, anhte na hte anhte na yu saga ai, anhte a ji woi ni anhte hpe hkai dan ma ni ai: Moi ji woi ni a lakhtak e, amu langai mi nang galaw nit dai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a lata masha amyu ni hpe shaden kau nna, Ji woi ni hpe hkai da mu ai: Amyu baw ni hpe nang zingri kau nna, Ji wa ni hpe shabran dat mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte a nhtu hte dai mungdan hpe shanhte madu lu mu ai n rai, Shanhte a lata gaw shanhte hpe hkye la mu ai n rai: Na a hkra lata, na a lahpum, na a myi man a nhtoi hte, shanhte hkye hkrang la ai hkrum mu ai; Kaning rai nme law, nang shanhte hpe tsawra mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang e, nang nye a Hkawhkam rai nga ndai, Yaku amyu a matu hkye hkrang la ai lam hpaw da u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a marang e anhte gumlau ni hpe kanawng kau lu ga ai, Na a amying majaw hpyen ni hpe kabye kau lu ga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a ndan hpe ngai n kam nngai, Nye a nhtu mung ngai hpe hkye la lu ai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang chyu sha gumlau ni kaw na anhte hpe hkye la nna, Anhte hpe n dawng ai ni hpe kaya jahkrum mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang hta anhte shani tup gumrawng nga nna, na a amying hpe prat tup shakawn na ga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung nang anhte hpe kau da nna, anhte a arawng jahpoi kau ya ndai: Anhte a luksuk ni hte rau nang n pru sa ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte a hpyen ni a man e, nang anhte hpe shabai dat nna, N dawng n yawt ai ni, anhte hpe hpya la mi ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sat na maw ai sagu hpe zawn nang anhte hpe ap kau nna, Amyu baw ni hta anhte hpe shabra kau mi ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a amyu hpe jahpu n hpyi ai sha nang dut kau nna, De a manu hte na a sutgan jat lit dai n rai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anhte a htingbu ni a man e shatan nhkan shara hte, Grup yin e nga ai ni a man e, roi nna asawng asang shara, nang anhte hpe shatai mi ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amyu ni a man e ga shadawn shara hte, Amyu baw ni a baw kanga shara, nang anhte hpe shatai mi ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Roi rip ai wa hte arawng jahpoi ai wa a ga majaw, Gumlau ai wa hte matai tai ai wa a man e,
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai hkrum ai shatan nhkan shani shagu ngai hte nga nga nna, Nye myi man a kaya kahpa ngai hpe htinggrum da nga nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hte wa anhte hkrum ga timung, Anhte nang hpe malap kau ga ai n rai: Na a ga shaka hpe mung n tawt n lai ga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte a myit bai n htak mali ai rai nna, Na a lam kaw na anhte n yit mat wa ga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang chyawm gaw chyahkyawn ni a shara e anhte hpe adup kau nna, Si ai shingnip hte anhte hpe ka-up da nit dai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Karai Kasang a amying hpe anhte malap kau nna, Hpara tsasam kaw lata ladawn ga yang gaw,
  </para>
  <para style="p">
    <verse number="21" style="v" />Kraw e makoi da ai hpe chye ai Karai Kasang, Dai hpe sawk yu na, n rai ni?
  </para>
  <para style="p">
    <verse number="22" style="v" />Gaja wa na a jaw e anhte shani shagu sat kau ai hkrum ga ai; Sat na san da ai sagu hpe zawn, anhte hpe nawn da mi ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Madu e, rawt u, nang hpa rai yup mu nga n ta? Rawt u, anhte hpe tut tut hkum kau da et.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nang hpa rai na a myi man hpe up da nga nna, Anhte a ru tsang ai hte tsin-yam tsindam hpe malap kau ya nga n ta?
  </para>
  <para style="p">
    <verse number="25" style="v" />Anhte a myit masin, ga nhpu e dagup nga nna, Anhte a sinda, ga hta kap nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anhte hpe karum na rawt u, Na a chyeju hte anhte hpe hkrang la mi law.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit masin kaja ai ga katu nga ai; Hkawhkam wa a gawp e ngai galaw ai amu hpe ngai tsun nga nngai: Nye a shinglet atsawm sha chye ka ai wa a kanyit rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Masha kasha ni hta nang ahpraw grau tsawm nga ndai. Na a n-gup hta chyeju ru bang ya nga ai. Dai majaw Karai Kasang gaw nang hpe tut tut shaman ya ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Share wa e, na a nhtu, na a arawng sadang, na a hpung shingkang hte hpe, hpye u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sadi sahka, myit nem ai, dinghpring ai a majaw, na a hpung shingkang dan hkung let jawn sa wa su. Na a hkra lata hkrithpa amu nang hpe sharin ya u ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a pala ni masen nga ma ai rai nna, Hkawhkam a gumlau ni a salum hta jung nga ai: Masha amyu ni, na a lagaw nhpang e kataw nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang e, na a tingnyang htani htana anga nga ai, Na a mungdan a sumdoi dingman ai sumdoi rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw dinghpring ai tsaw nna yubak hpe n dawng ndai: Dai majaw Karai Kasang gaw, na a Karai Kasang, Na a manang ni hta, kabu gara ai namman hte nang hpe grau chya ya nit dai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a hpun palawng gaw mura, achyaw, hpun maza mawng nga ai, Magwi kawng htingnu hta na tingse dum ai gaw, nang hpe shapyaw nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkawhkam ni a shayi sha ni, na a nja jan ni rai nga ma ai; Uhpira ja hte mawn nga ai hkawhkam jan gaw, Na a hkra maga de tsap nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shayi sha e, madat u, mada yu nna na la u, Na a amyu hte nwa a nta hpe, malap kau u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam wa gaw na a ahpraw tsawm ai ra a yang gaw, Na a madu wa shi rai nga ai majaw, shi hpe hkungga lara u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Turu shayi sha e, mung masha ni hta grau sut lu ai ni, Kumhpa hte na a myi man tam na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkawhkam wa a shayi sha gaw dinghku kata e arawng htak rai nga ai. Shi a hpun palawng ja hte kaboi ai rai nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Za hte ka ai hpun nba hte hkawhkam wa kaw sa sa nna, Shi a hpang hkan ai shingnan hkawnsek ni hpe mung, Nang kaw woi jashawn na maru ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kabu gara re ai hte shanhte woi sa mu ai, Hkawhkam a Hkaw de shanhte shang lu ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a nji ni a malai na nsha ni shang na mara ai, Mung shagu hta nang shanhte hpe du shatai na maru ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Prat mi hte prat mi na a amying nsang hpe ngai dum shangun na mawe ai: Dai rai nna, htani htana prat dingsa, masha amyu ni gaw nang hpe a shakawn nga na mara ai law.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw anhte a shingbyi shara hte n-gun rai nga ai, Ru tsang ai aten e karum na jin nga chyalu rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai majaw ginding aga galai mat wa nna, Nammukdara ka-ang na bum ni a wam nga timung;
  </para>
  <para style="p">
    <verse number="3" style="v" />Hka leng ni wung nga nna kanawng nga ai hte, Dai ni rawt hta ai a majaw, bum ni ashun nga ma timung, anhte n hkrit ra ga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Hka nu hte de a hka gai ni Karai Kasang a mare hte, Tsaw htum ai Wa a chyoi pra ai htingnu ni hpe, shapyaw nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw de a ka-ang e shanu nga ai: Dai mare gaw shamu shamawt nga ai n rai; Karai Kasang gaw shi hpe jau jau e karum na wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masha amyu ni kabrawng nga masai, mungdan ni shamu shamawt mat masai: Shi gaw shi a nsen dat dat nna, ginding aga byawng mat sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zaw nawng zaw wa up ai Yehowa, anhte hte rau nga nga ai, Yaku a Karai Kasang gaw anhte a langchyi rai nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Sa marit, Yehowa a amu hpe mada yu mu; Ga ntsa e shi akrin atsai di kau nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ga ting hta na hpyen majan shi jasim kau wu ai; Ndan pala hpe shi daw kau nna, Ri hpe kahtum kadaw di kau wu ai: Hpyen leng ni hpe wan hte nat kau mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amu sha nga mu, ngai Karai Kasang rai nga nngai, chye mu. Amyu baw ni hta ngai galu kaba wa nna, Ga ntsa e dan hkung nga na nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zaw nawng zaw wa up ai Yehowa anhte hte rau nga nga ai. Yaku a Karai Kasang gaw anhte a langchyi rai nga ai. [Selah.]
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha amyu shagu ta lahpawk dum nga mu, Karai Kasang hpe awng ai nsen hte garu mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, Yehowa gaw, Tsaw htum ai hte hkrithpa wa rai nga ai: Mungkan ting a hkawhkam kaba mung, shi rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw anhte a npu e masha amyu ni hpe, Anhte a lagaw kata e amyu baw ni hpe, dip da mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi tsawra ai Yaku a gumrawng shara, Anhte a sali wunli tai na, shi san da nu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw garu ai nsen hte, Yehowa gaw pahtau dum wu ai hte, lung wa sai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mahkawn mangoi mu, Karai Kasang hpe mahkawn mu, Mahkawn mangoi mu, anhte a hkawhkam wa hpe mangoi mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang gaw ga ting a hkawhkam rai nga ai, Hpaji ga hte mahkawn mangoi mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang gaw masha amyu ni hpe up nga ai, Karai Kasang gaw shi a chyoi pra ai tingnyang hta dung nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abraham a Karai Kasang a amyu hte rau, Amyu ni a du salang ni zuphpawng nga ma ai. Kaning rai nme law, mungkan a n-gang ni hpe, Karai Kasang up nga ai. Shi gaw nachying grau ai wa rai nga ai law.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anhte a Karai Kasang a mare hte, Shi a chyoi pra ai bum hta e, Yehowa gaw galu kaba nga ai rai nna, Shakawn ging ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngoi rai nna tsaw lung wa ai, Dingdung maga e nga ai Ziun bum gaw, Mungkan ting na ngwipyaw shara rai nga ai: Hkawhkam kaba a mare mung, dai rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang shawung shara rai nga ai gaw, De a htingnu ni hta e, shi madun dan ya mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yu mu, hkawhkam ni hpawng nga ma ai, Shanhte rau lai sa wa ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte mada yu nna amau nga ma ai, Shanhte kajawng nna hprawng mat ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai yang e shanhte hkrit gari ai hte, Shinggyim machyi ai num zawn, kawa machyi hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw sinpraw de na nbung laru hte, Tarshi a hpaga li ni hpe agrawp kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zaw nawng zaw wa up ai Yehowa a mare, Anhte a Karai Kasang a mare hta e, Na yu ga ai hte maren, anhte mu yu sagaw ai: Karai Kasang gaw dai hpe tutnawng e shagrin da na wu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, na a Htingnu kata e, Na a chyeju hpe anhte dum nga saga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, na a amying nsang grau nga ai hte maren, Nang hpe shakawn ai gaw ga ting e chyam nga ai: Na a hkra lata dingman ai hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang tara dara ai lam a majaw, Ziun bum kabu gara nga nna, Yuda a shayi sha ni sharawng awng nga mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ziun hpe grup kayin nna kawan hkawm yu mu, De a langchyi ni hpe hti yu mu:
  </para>
  <para style="p">
    <verse number="13" style="v" />Hpang prat na ni hpe hkai dan lu myit ga, De a bunghku ni hpe matsing da nna, De a htingnu ni hpe sawn yu mu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaning rai nme law, dai Karai Kasang gaw, Htani htana e anhte a Karai Kasang rai nga ai: Si hkra shi anhte hpe woi wa na mi ai law.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha amyu shagu ndai madat mu; Dinghta ga e nga ai ni nlang hte e, na la mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Du magam ni darat daroi ni Sut su ai hte matsan mayan ni yawng, na la mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a n-gup hpaji hparat shapraw dan nna, Nye a myit zai byeng-ya aru yu na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a na, ga shadawn na la na rai nna, Tingse dum let gumwai ga htai dan na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kyin dut ai nhtoi hta e, yubak ngai hpe kawan nga yang, Hpa majaw ngai hkrit na rai nga n ta?
  </para>
  <para style="p">
    <verse number="6" style="v" />Masha wa gaw tut tut ahkrung nga nna, Hten mat ai galoi mung n hkrum lu hkra,
  </para>
  <para style="p">
    <verse number="7" style="v" />Tinang a sutgan hpe kamsham nna, Tinang n taw n tsang lu su ai hpe shakawn nga ai ni;
  </para>
  <para style="p">
    <verse number="8" style="v" />Kadai mung tinang a kanau wa hpe hkrang la lu na n rai, Shi a matu htingrai ai ja Karai Kasang hpe jaw lu na n rai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte a gawng malai jahpu kaba nga nna, Prat dingsa e n law hkraw nga malu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gaja wa, hpaji hparat rawng ai wa si mat ai hte, Mana ai wa hte angawk ai wa rau hten mat nna, Tinang a sutgan hpang na ni hpe htawng da ya ma ai gaw, shi a mu lu nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte a nta ni prat tup agrin nga nna, Tinang a htingra ni prat dingnawng anga nga na re ai; nga nna, Shanhte gaw tinang a kraw e a myit nga ma ai rai nna, Mungdaw ni hpe tinang a amying shakap da mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung, hpung rawng ai wa gaw agrin nga ai n rai: Shi gaw hten mat ai ashu ashan hte bung nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai lam gaw shanhte ngawk ai lam rai nga timung, Hpang de na ni shanhte a ga hpe ra ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte hpe katsan ga a matu sagu zawn jahpawng da nna, Si du gaw shanhte hpe rem nga mu ai: Dai jahpawt e myit ding ai ni gaw shanhte hpe dang kau nna, Shanhte a hkum tsawp ni katsan ga hta e tsam mat malu ai: Nga shara kaga shanhte n lu ma ai:
  </para>
  <para style="p">
    <verse number="15" style="v" />Karai Kasang chyawm gaw katsan ga de na, Nye a myit masin hpe hkrang la na ru ai. Kaning rai nme law, shi ngai hpe gare la na nngai. [Selah.]
  </para>
  <para style="p">
    <verse number="16" style="v" />Masha wa gaw sutgan lu nna, Shi nta a arawng jat wa yang, nang hkum hkrit et.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi si wa yang hpa mung la wa lu na n rai, Shi a arawng sadang shi kaw hkan yu nang lu na n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Naw hkrung nga yang shi hpe shaman ya nna, Ngamai ai majaw shi hpe shakawn ya mu timung,
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaji kawoi ni kaw shi shang na ra ai: Shanhte galoi mung nhtoi n mu lu na ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hpung rawng timung, myit n gu ai wa gaw, Hten mat ai ashu ashan hte bung nga ai.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />N-gawn tawa Karai Kasang Yehowa gaw, Mungga jaw dat wu ai rai nna, Jan pru ai maga kaw nna, shang ai maga du hkra lamu ga hpe shaga wu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsawm htum ai Ziun bum kaw nna, Karai Kasang gaw htoi tu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte a Karai Kasang du ra ai rai nna, Shi atsin sha nga nga lu ai n rai; Shi a man e wan a hkru nga nna, Shi a grup yin e laru kaba ru nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw shi a amyu hpe jeyang na, aga hpe mung, Sumsing lamu hpe mung, shaga mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Hkungga nawng let ngai hte ga shaka tawn da ai, Nye a dingman ai ni e, ngai kaw hpawng marit,” nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang nan tara dara nga ai majaw, Sumsing lamu gaw shi a dinghpring ai hpe shana ya nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="7" style="v" />“Nye a amyu e, madat u, ngai ga tsun na nngai, Israela e, ngai nang hpe sakse jaw de ga: Ngai gaw Karai Kasang, na a Karai Kasang rai nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hkungga jaw ai lam a majaw ngai nang hpe n dara na nngai; Na a wan nat ai hkungga ni nye a man e tut tut nga nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Rai timung, na a nta na usu langai mi, Na a ulawng na bainam la langai mi, ngai n la na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nam maling hkan e nga ai ashu ashan nlang hte hte, Kawng hkying mi hta pra nga ai yamnga ni, nye a rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bum na u nlang hte hpe ngai chye nga nngai. Udat hkan e hkawm mahkawm ngai hte rau rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai kawsi hkrum yang, nang hpe shana na de ai n rai; Aga ting hte de a yawng mayawng nye a rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai gaw usu shan sha na kun? Bainam la a asai lu na kun?
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang hpe shakawn kungdawn hkungga jaw u, Tsaw htum ai Wa hpe na a ga ndat rap raw u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ru tsang ai nhtoi hta e ngai hpe shaga e; Ngai nang hpe hkye hkrang la nna, Nang ngai hpe shagrau sha-a na rin dai,” nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bai, tara n lang ai wa hpe Karai Kasang gaw, “Nye a arawn alai nang hpa rai hkai dan nga nna, Na a n-gup hte nye a ga shaka hpe hpa rai tsun nga n ta?
  </para>
  <para style="p">
    <verse number="17" style="v" />Sharin ai ga hpe nang n dawng nga nna, Nye a mungga hpe na a shingdu de kabai kau ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lagu lagut mu yang, nang shi hpe ra nga nna, Num shaw ai ni hte rau mazum nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a n-gup n hkru ai hpe nang ap ya nna, Na a shinglet hkalem ai lam mazing nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na nhpu nnau a lam n sun ai hku nang tsun nga nna, Na nnu a kasha hpe shara nga ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai nang galaw ai hpe ngai atsin sha nga nga ai majaw, Nang zawn ngai rai nga nngai, nang myit nga ndai: Rai timung, ngai nang hpe sharin ya nna, Na mara na a man e, hpyan dan na de ai,” ngu wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang hpe malap mali kau ai ni e, ndai lam myit yu mu: Shing n rai yang, mawai la ai wa n nga nna, Ngai nanhte hpe amya je kau na made ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shakawn kungdawn hkungga jaw ai wa gaw, Nye a arawng shapraw ai wa rai nga ai: Shi hkan sa ai lam yaw yu ai wa hpe, Karai Kasang a hkye hkrang la ai lam ngai madun na we ai.
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, na a chyeju hte maren, ngai hpe matsan dum la e, Na a n-gaw nnyeng myit kaba nga ai hte maren, nye a mara arut kau ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a shut hpyit ai hpe atsai awai kashin kau ya e, Nye a yubak kaw na ngai hpe jaseng la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a mara ngai chye nga nna, Nye a yubak nye a man e tut tut rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang tsun nga ai ga dinghpring nga u ga, Na a tara dara ai lam hta mara n kap u ga, Nang hpe chyu sha ngai yubak galaw nna, Na a man e n hkru ai amu galaw ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yu mu, shut hpyit ai hta ngai shangai wa nna, Nu a hkritung e pyi yubak kap nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Myit kata na sadi sahka hpe nang tsaw nga nna, Kraw lawang e ngai hpe hpaji sharin ya ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Husup hte ngai hpe jaseng ya nna, ngai san wa na nngai. Ngai hpe kashin ya nna, hkyen hta grau ngai hpraw wa na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang daw kau ai nrut nra ni bai kabu lu mu ga, Ga ngwi ga pyaw ngai hpe shana ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a yubak kaw na, na a myi man kayin kau nna, Nye a shut hpyit ai nlang hte hpe, arut kau ya e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, ngai hta san seng ai myit hpan tawn da nna, Agrin nga na Wenyi, nye a kata e shabai bang ya e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a myi man na ngai hpe hkum shaden kau e, Na a Chyoi pra ai Wenyi ngai hta na hkum dawm la ya e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a hkye hkrang la ai lam a kabu gara ai gaw, ngai hpe bai jaw nna, N wai ai Wenyi hte ngai hpe shadaw da e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi, tara tawt lai ai ni hpe na a lam ngai sharin ya nna, Yubak kap ai ni nang kaw bai kayin wa na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang e, ngai hpe hkye hkrang la ai Karai Kasang e, Bunglat hka hta na ngai hpe shalawt dat e: Shaloi nye a shinglet, na a dinghpring ai lam hpe marawn shakawn na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu e, nye a nten hpaw ya e. Shaloi nye a n-gup nang hpe shakawn na lam hkai dan na ra ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shagu hkungga nang tsaw nga ndai n rai; Dai n rai taw, ngai jaw na de ai: Wan nat ai hkungga hpe mung nang n ra ndai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang tsaw nga ai shagu hkungga gaw, Gawng run mat ai wenyi hpe rai nga ai. Karai Kasang e, gawng run nna htum mat ai myit hpe, Nang gang kau nga na ndai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na a n-gaw nwai myit hte Ziun hpe mai kaja ai galaw u, Yerusalem mare na bunghku hpe gaw da ya u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai nang gaw, dingman ai hkungga, Wan nat ai hte hkum dingyawng hkungga hta awng nga na rin dai: Na a hkungri ntsa e mung, shanhte usu nawng ya na mara ai.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Share wa e, nang hpa rai n hkru ai hta gumrawng nga n ta? Karai Wa a chyeju tut tut anga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lau sha ai wa e, na a shinglet, Dai ai kara nhkyi zawn hten byak ai maw nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaja ai hta n hkru ai hpe, Dingman ai hta masu ai ga hpe, Nang grau tsaw nga ndai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Hkalem sha chye ai shinglet e, Shabyak na ga nlang hte hpe nang tsaw nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Wa nang hpe tut tut agrawp kau na ndai: Na a sum hta na shi nang hpe gare kau dat nna, Dinghta ga de na, na a aru hpe baw kau ya na rin dai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dingman ai ni dai lam mu nna hkrit nga na mara ai; Shanhte gaw shi hpe mani kau nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Yu mu, Karai Kasang hta n shingbyi nga ai, Shi a sutgan hpe shamyet nna, Shi a n hkru ai hta ngang nga ai share wa gaw, ndai wa rai nga ai,” nga na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai chyawm gaw, Karai Kasang a nta na, Tsit lali ai tsanlun hpun zawn rai nga nngai: Karai Kasang a chyeju hpe ngai tutnawng a hpa nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai nang galaw ndai majaw, Ngai nang hpe tut tut shakawn nga na nngai: Na a amying gaw chyoi pra ai ni a man e mai kaja nga ai majaw, Dai hpe ngai ala nga na nngai law.
  </para>
  <chapter number="53" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mana ai wa gaw, “Karai Kasang n nga ai,” nga nna shi a kraw e a tsun nga ai. Shanhte tsam mat nga ma ai rai nna, Matsat shabat lailen hkan nang ma ai: Kadai mung kaja ai amu n galaw ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zai byeng-ya rawng ai wa nga ai, n nga ai, Karai Kasang hpe tam ai wa nga ai kun? mada yu na nga, Karai Kasang lamu de nna, masha kasha ni hpe gum yu nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yawng htak mat wa masai, Shanhte rau brun mat wa masai. Kadai mung kaja ai amu n galaw ma ai: Gaja wa, langai mi muk n nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />N hkru ai amu galaw ai hte, nye a amyu masha ni hpe muk hpe zawn sha kau nna, Karai Kasang hpe n hpyi jahtau ai ni gaw, Hpa mung n chye ma hka?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hkrit shara n nga timung, Shanhte hkrit kaba hte hkrit nga ma ai: kaning rai nme law, na a grup yin e dap jung ai ni a nrut nra hpe, Karai Kasang dumbru dumbra di kau ya mu ai. Karai Kasang shanhte hpe gang kau mu ai majaw! Nang shanhte hpe kaya kahpa jahkrum mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israela a matu Ziun kaw na hkye hkrang la ai lam kadai jaw na rai nga a ta? Karai Kasang shi a bawng dung ai amyu hpe hkrang la ai shaloi jang, Yaku awng wa nna, Israela kabu gara nga na ra ai.
  </para>
  <chapter number="54" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, na a amying hte ngai hpe hkye la e, Na a atsam hte ngai hpe jeyang ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Karai Kasang e, ngai akyu hpyi ai ga madat ya e, Nye a n-gup ga na la ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masha tsasam ni nye a gumlau maga e rawt nna, Mazut bu ai ni nye a asak hpe tam ma ai: Shanhte Karai Kasang hpe hpa n nawn ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Yu mu, Karai Kasang ngai hpe karum ai wa rai nga ai, Dai Madu, nye a asak shadaw ai ni hte lawm nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai hpe gyam yu ai ni hpe shi bai tai na mu ai; Na a sadi sahka hte shanhte hpe jahkoi kau mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mayu hkungga ngai nang hpe jaw na nngai: Yehowa e, na a amying mai kaja nga ai majaw, Ngai dai hpe shakawn kungdawn na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, ru tsang ai nlang hta na, Nang ngai hpe mawai la nna, Nye a myi gumlau ni a lam yu ra nga li ai.
  </para>
  <chapter number="55" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai hpyi ai ga na la ya e, Ngai akyu hpyi yang hkum makoi nga et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpe matsing da nna htan ya e: Gumlau wa a nsen hte, N hkru ai ni a kashun kashe a majaw, Ngai myit aru let kadau hkawm nna, a madai nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte ngai hpe mara sharawng la nna, Masin pawt ai hte ngai hpe zingri kau mi ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a myit nye a kraw e machyi nga nna, Si na hpe hkrit gari ai gaw, ngai kaw pru nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hkrit ai hte gari kawa ai gaw ngai kaw pru nna, Kajawng kaja ngai hpe htinggrum da nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai rai nna ngai gaw, “Hkrudu zawn singkaw lu n ga lè! Ngai pyen mat wa nna ban sa nga na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tsan tsan de ngai rai mat wa nna, Nam mali hkan e shanu nga na nngai. [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Nbung bung ai hte laru kaba kaw na, Shingbyi ai shara de ngai alawan hprawng mat wa na nngai” nga nna tsun nga nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, dai mare hta e ahkrim sha ai hte, Ga law ga la ngai mu se ai majaw, Shanhte a ga shanut ya nna shabra kau mu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shani shana de a bunghku ntsa e shanhte kawan hkawm nna, De a ka-ang e, ahkrip ahkrap kashun kashe rai nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />De a ka-ang e hpya sha ai hkrai hkrai rai nga nna, De a htingwang ni hta ahtu adep, hkalem sha ai n sim nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gumlau ga ai wa ngai hpe shatan taw gaw, ngai hkam lu na nngai; Ngai hpe n dawng ga ai wa gumrawng nga taw gaw, ngai koi lu na nngai:
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang chyawm gaw ngai zawn rai nga nna, Nye a manang hte nye a jinghku wa rai nga ndai.
  </para>
  <para style="p">
    <verse number="14" style="v" />An angwi apyaw rau bawng saga ai. Masha wunawng wuwa ni hte rai, an mung, Karai Kasang a nta de sa saga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte hten byak mat ai hkrum mu ga; Shanhte a shara e mung, kraw kata e mung, N hkru ai hkrai rai nga malu ai majaw, Katsan ga de jahkrung yu hkrat wa mu ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai chyawm gaw, Karai Kasang hpe shaga nga nna, Yehowa ngai hpe hkye hkrang la na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shana e, jahpawt e, jan pungding ga ai aten e, Ngai myit aru yu let madai nga nna, Shi nye a nsen hpe madat ya na ra ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai kaw ani sha du ai hpyen gasat hta na, Shi nye a asak hpe angwi sha hkrang la ya nngai: Ngai hpe hkap daw ai ni law nga ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte myit n galai ma ai hte, Karai Kasang hpe n hkrit ma ai majaw, Moi chyaloi nhkoi nna nga ai Karai Wa gaw, Shanhte hpe madat nga nna shagrit kau na mu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi hte hku ai wa hpe shi hkap gasat nga nna, Shi a ga shaka hpe wu kau wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a n-gup ga sau zawn manen lu timung, Shi a myit hta majan lawn nga ai; Shi tsun ai ga, namman hta grau kya nga timung, Dai gaw shaw ai nhtu rai nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a lit Yehowa hta mara da u. Shi nang hpe shadaw na re ai: Tutnawng e dinghpring ai ni hpe, Kataw shangun nga na n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang chyawm gaw Karai Kasang e, Hten byak hkrum na nhkun de shanhte hpe jahkrat kau na mu ai. Sai kap ai ni hte hkalem sha ai ni, Prat hpungngang ga na ma ai, n rai. Ngai chyawm gaw nang hta machyu nga na nngai.
  </para>
  <chapter number="56" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai hpe matsan dum la e, Masha ni ngai hpe mayu kau na ra nga ma ai: Shani tup gasat mi ai majaw, ngai myit ru nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shani tup a gyam yu nga ma ai ni, Ngai hpe mayu kau na ra nga ma ai: Myit kaba ai hte ngai hpe hpyen gasat ai ni, Law law wa rai nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hkrit ang ai nhtoi hta e chyawm gaw, Ngai nang hta hpa nga na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang hta shi a ga hpe ngai shakawn nga nngai, Karai Kasang hta ngai machyu nga nna, hpa mung n hkrit nga nngai: Masha ashan ngai hpe hpa di lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Shani tup shanhte nye a ga shanut kau nna, N hkru ai hku hkrai hkrai ngai hpe maw ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a asak hpe tam ma ai majaw, Shanhte zuphpawng nna gyam yu let, Nye a lagaw hkang hpe matsing nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />N hkru nga ma ai majaw shanhte lawt lu na kun? Karai Kasang e, masin pawt ai hte dai amyu ni hpe jahkrat kau mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai kahkrang hkawm ai hpe, nang matsing da nna, Nye a myi prwi na a ndum hta mahkawng da u: Dai hte na a laika hta rawng nga ai, n rai ni?
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai majaw ngai jahtau ai nhtoi hta e, Nye a hpyen ni kanut mat wa na ma ai: Karai Kasang ngai hte rau rai nga ai, dai ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang hta dai mungga hpe ngai shakawn na nngai. Yehowa hta dai mungga hpe ngai kungdawn na nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang hta ngai machyu nga nna, hpa mung n hkrit nngai: Masha wa gaw ngai hpe hpa di lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang e, nang hpe ndat ai ga, nye a ntsa e naw rai nga ai: Shakawn hkungga ngai nang hpe nawng ya na nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw si hkrung si htan kaw na, Nye a asak hpe mawai la ya nit dai: Hkrung nga ai ni a nhtoi hta e, Karai Kasang a man e hkawm lu n ga, Nye a lagaw kataw ai kaw na nang mawai la ya nit dai, n rai ni?
  </para>
  <chapter number="57" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai hpe matsan dum la e. Nye a myit masin nang hta shingbyi nga ai majaw, ngai hpe matsan dum la e. Dai jahten shabyak ai amu lai mat wa hkra, Na a singkaw a shingnip hta ngai shawung nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tsaw htum ai Karai Kasang ngu ai, Nye a amu shangut ya ai Karai Wa hpe, ngai shaga nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai hpe mayu kau maw ai wa a shatan nhkan hta na, Lamu de na shi ladawn nna, ngai hpe hkye la nngai; [Selah.] Karai Kasang gaw shi a chyeju hte sadi sahka hpe shangun dat na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a myit masin hkanghkyi ka-ang e rai nga ai, Wan hkru ai ka-ang e ngai kaleng nga nngai: Shinggyim masha ni a wa, ri pala hte, Shanhte a shinglet, dai ai nhtu rai nga malu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang e, sumsing lamu hta nang grau tsaw nga u ga; Aga ting hta e na a hpung shingkang dan hkung nga u ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw nye a lam hta mahkam hkam nna, Nye a myit masin du krung nga li ai: Shanhte nye a man e nhkun htu ma timung, Tinang dai, dai hta hkrat ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang e, nye a myit ngang kang nga ai. Rai sa, nye a myit ngang kang rai nga ai: Ngai mahkawn mangoi nna tingse dum na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a arawng sadang e, dum hprang u, Tingse hte sumpyi ni e, dum hprang mu: Jahpawt manap hpe mung ngai jasu na we ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, masha amyu ni hta, ngai nang hpe shakawn na nngai, Amyu baw ni hta ngai nang hpe tingse dum na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai rai nme law, na a chyeju lamu du hkra, Na a sadi sahka sumwi kaw du hkra, lep nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang e; sumsing lamu hta nang grau tsaw nga u ga; Aga ting hta e, na a hpung shingkang dan hkung nga u ga.
  </para>
  <chapter number="58" style="c" />
  <para style="p">
    <verse number="1" style="v" />Du ni e, nanhte kaja wa dinghpring ai ga tsun nga myit ni? Masha kasha ni hpe dingman ai hku dawdan ya nga myit ni?
  </para>
  <para style="p">
    <verse number="2" style="v" />Gaja wa, nanhte a kraw e, nanhte n shawp ai hku maw nna, Ga ntsa e, nanhte a lata na kashun kashe hpe shen karan nga myit dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai ni hkritung nna hpre nga ma ai, Masu ga tsun ai ni shangai kaw nna lam dam mat wa ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a tuk lapu a tuk hte bung nna, Tinang a na hpe pat kau nna, na n na ai pu htum zawn rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw lakle sara a nsen n na lu ai, Hpaji chye ai wa a Mandan ga pyi n na nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang e, shanhte a n-gup hta na wa baw kau ya mu; Yehowa e, hkanghkyi ni a kawng, daw kau ya mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lwi ai hka zawn shanhte hkyet mat nna, Ndan shading yang, pala jadaw zawn rai mat mu ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw, hkawm let mat mat ai lapawp hte, Jan galoi n mu ai nbya zawn, rai nga mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte a di ni ju hpun hte garai n kahtet yang, Katsing timung, hkut sai rai timung, Nbung laru e ahpawt kau na ru ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dinghpring ai wa gaw matai dawp ai mu lu yang, kabu na ra ai; Tara n lang ai ni a asai hta shi a lagaw hpe kashin na ru ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shing rai masha ni gaw, “Gaja wa, dinghpring ai ni a matu, sali wunli nga nga nna, Karai Kasang nan ga ting hta e, gaja wa tara dara nga ai,” nga nna tsun na mara ai.
  </para>
  <chapter number="59" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Kasang e, gumlau ni kaw na ngai hpe mawai la e, Nye a hpyen ni hta na ngai hpe makawp maga da e.
  </para>
  <para style="p">
    <verse number="2" style="v" />N hkru ai amu galaw ai ni kaw na ngai hpe mawai la e, Sai kap ai masha ni hta na ngai hpe hkye la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yu mu, nye a asak la na shanhte gyam nga ma ai, Ngai hpe jahten na, n-gun ja ai ni zuphpawng nga ma ai: Rai timung, Yehowa e, ngai mara n kap nngai, Ngai yubak mung n galaw nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mara n nga timung htim sa wa na, shanhte gat nga ma ai; Ngai hpe karum na rawt nna yu nga e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gaja wa, Israela Karai Kasang, Zaw nawng zaw wa up ai Karai Kasang Yehowa e, Amyu baw nlang hte hpe kawan yu na, rawt u: N shawp ai hku hkan ai ni hpe matsan hkum dum nga et. [Selah.]
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte shana e bai wa nna, Gwi zawn nying let, Mare grup yin e kayin hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />N-gup hte grang ai ga shanhte tsun ma ai; Shanhte a nten hta nhtu lawm nga malu ai: Shanhte gaw, “Kadai wa chye lu na kun?” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang chyawm gaw, Yehowa e, shanhte hpe mani kau nna, Amyu baw nlang hte hpe shatan nga mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />N-gun rawng nga ndai majaw nang hta ngai shamyet nga nngai: Karai Kasang gaw nye a langchyi rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang a chyeju ngai hpe tau la nngai, Ngai hpe gyam ai ni hpe Karai Kasang bai tai lu shangun nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Anhte a n-gang, Madu e, Nye a amyu n malap kau u ga, shanhte hpe hkum sat kau mu: Na a n-gun hte shanhte hpe shabra nna jahkrat kau mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte a n-gup na yubak hte nten e shut ai ga, Shanhte a matsa mawa hte masu ai ga majaw, Tinang a gumrawng ai hta ahkang nga mu ga.
  </para>
  <para style="p">
    <verse number="13" style="v" />N-yun bu ai hte shanhte hpe jahtum kau mu, Shanhte n nga lu mu ga, jahtum kau mu. Yaku hta mung, lamu ga htum hkra mung, Karai Kasang up nga ai, shanhte hpe shachye mu. [Selah.]
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte shana e bai wa nna, Gwi zawn nying let, Mare grup yin e kayin hkawm nga mu ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lu sha na matu shanhte kahkrang, hkawm nna, N hkru kat lu ai, shana tup nga nga ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai chyawm gaw, na a n-gun hpe mahkawn mangoi na nngai; Nye a langchyi hte ngai ru tsang ai nhtoi e, Nye a shingbyi shara nang rai nga ndai majaw, Na a chyeju hpe, ngai jahpawt e kungdawn nga na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a n-gun e, ngai nang hpe mahkawn mangoi na nngai: Karai Kasang gaw nye a langchyi hte Ngai hpe chyeju jaw ai Karai Kasang, rai nga ai.
  </para>
  <chapter number="60" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, nang anhte hpe kau da nit dai. Nang anhte hpe shabra kau nit dai. Nang masin pawt nga ndai; Anhte hpe bai shalan shabran la mi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang gaw dai mungdan hpe anawn dat nna, ga kau nu ai; Dai gaw gari awam nga ai majaw, De a kaprang ga ai hpe shapri ya u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a amyu hpe ru tsang nang jahkrum nna, Nang ai tsabyi anhte hpe jaw shalu mi ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tengman ai lam majaw sharawt na dawnghkawn gaw, Nang hpe hkrit kamyin ai ni hpe, nang jaw nit dai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a tsawra ai ni gaw lawt lu mu ga, Na a hkra lata hte hkye la nna, anhte hpe htan ya mi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang shi a chyoi pra ai hte tsun dan ai gaw, “Ngai kabu na nngai; Shehkem hpe ngai karan na we ai. Suhkot kadit hpe ngai shadawn na we ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Geliad hte Manashe nye a rai nga ma ai; Ehprim gaw nye a baw a magap, Yuda, nye a hkawhkam sumdoi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moba nye a lagaw kashin ai di rai nga ai, Edom hta nye a kyepdin ngai kabai tawn na we ai: Hpilisti mung e, nye a matu garu mu:
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai ngang ai mare hta e, Ngai hpe kadai jashawn na rai nga a ta? Edom de ngai hpe kadai woi shang na rai nga a ta?” nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, nang anhte hpe kau da nit dai, n rai ni? Karai Kasang e, anhte a luksuk ni hte rau nang n pru sa ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ru tsang ai hta na anhte hpe karum la mi, masha karum ai lam kaman sha rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang hte anhte nlaw lu na ga ai, Shi anhte a hpyen ni hpe, kabye kau na mu ai.
  </para>
  <chapter number="61" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai jahtau ai ga madat ya e, Ngai akyu hpyi ai ga matsing ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai myit kaji nga yang, ga htum ai kaw nna, Ngai nang hpe shaga na nngai: Nye a matu naw tsaw la ai lunghkrung ntsa e, ngai hpe shalun da e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, nye a shingbyi shara hte, Gumlau ni a man e ngang ai langchyi, nang tai nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a Sum hta ngai tutnawng e anga nga na nngai, Na a singkaw pawt ai kaw e ngai makoi na nngai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang e, nye a ga shaka nang na ndai, Nang hpe hkrit kamyin ai ni hpe nang sali wunli jaw ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hkawhkam wa a nhtoi hpe naw jat ya u ga, Shi a shaning prat mi hte prat mi grin nga lu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw Karai Kasang a man e tutnawng e anga nga u ga; Shi hpe bau sin na chyeju hte sadi sahka hpe san da u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shing rai jang, na a amying hpe ngai prat tup mahkawn mangoi na nngai, Shani shagu nye a ga shaka hpe raw na nngai.
  </para>
  <chapter number="62" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit masin Karai Kasang a man e amu sha rai nga ai; Shi kaw nna ngai hpe hkye hkrang la ai lam pru nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi chyu sha nye a lunghkrung, nye a hkye hkrang la ai lam, Nye a langchyi rai nga ai; ngai shamu shamawt ai law law n hkrum na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kayawt ai shakum hte, nga ai bunghku hpe zawn, Nanhte nlang hte gaw masha hpe sharun na, Gaten du hkra shi hpe htim nga na myit ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Gaja wa, shi a arawng hpe jahten na shanhte bawng nga ma ai; Shanhte masu matsa ai ga hpe sharawng nga ma ai; Tinang a n-gup hte shaman ya timung, Kraw lawang e, dagam dala ga tsun nga ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a myit masin e, Karai Kasang kaw asim sha nga u, Shi kaw nna nye a myit mada shara pru nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi chyu sha nye a lunghkrung, nye a hkye hkrang la ai lam, Nye a langchyi rai nga ai: ngai shamu shamawt ai n hkrum na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a hkye hkrang la ai lam hte, nye a arawng sadang Karai Kasang hta rai nga ai. Ngai hpe n-gun jaw ai lunghkrung hte nye a shingwung shara Karai Kasang rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amyu masha ni e, Karai Kasang hpe tut tut hpa nga mu; Nanhte a myit shi a man e hpaw dan mu: Karai Kasang gaw anhte a shingbyi shara rai nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaja wa, darat daroi masha ni nbung hkrai rai nga ma ai; Daru magam masha ni masu ai hkrai rai nga ma ai: Shanhte hpe joi hta shen yu yang, yawng hte wa nbung hta grau tsang ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kashun kashe ai hpe hkum machyu myit, Shanyen la lu ai majaw myit hkum gumrawng myit. Sut su yang dai hta myit hkum noi myit.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang lang mi ga jaw ni ai: Karai Kasang n-gun a npawt rai nga ai gaw, Lahkawng lang ngai na yu se ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, nang kaw nna chyeju pru nga ai: Kaning rai nme law, tinang galaw ai hte maren, Nang langai hte langai hpe bai htang na ndai.
  </para>
  <chapter number="63" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, nye a Karai Wa nang rai nga ndai, Jahpawt jau jau e, ngai nang hpe tam na nngai. Hka n rawng ai hkraw ai hte krin ai prang hta e, Nye a myit masin nang hpe shagroi gara nga nna, Nye a hkum shan nang hpe marit nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a atsam hte hpung shingkang mu lu n ga, Dai chyoi pra ai Nta hta e ngai nang hpe mada nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a chyeju gaw asak hta grau hpu nga ai, Nye a n-gup nang hpe shakawn na ra ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Naw hkrung nga yang, ngai nang hpe sha-a na nngai, Na a amying hte nye a lata hpe ngai sharawt na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nye a yup ku hta e nang hpe dum nna, Shana na ladaw hta e nang hpe myit nga yang,
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a myit masin sau ai hpum ai hte zawn hkru kat wa nna, Kabu gara ai nten hte nye a n-gup nang hpe shakawn nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai hpe karum ai wa nang rai nga ndai: Na a singkaw a shingnip hta e ngai awng nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a myit masin nang hpe hkan kanan nga nna, Na a hkra lata ngai hpe shadaw ya nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a asak hpe jahten na tam ai ni chyawm gaw, Ga sung htum ai shara de shang na ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nhtu hte si ai shanhte hkrum na mara ai, Chyahkyawn ni a matu shanhte tai na mara ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam wa chyawm gaw Karai Kasang hta kabu na ra ai; Shi hta manoi ai ni yawng gumrawng na ma ai: Kaning rai nme law, masu ga tsun ai ni a n-gup pat kau ai hkrum na ra ai.
  </para>
  <chapter number="64" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai lajin ai nsen madat ya e; Hpyen ni hpe hkrit ai kaw na, nye a asak bau sin ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />N kaja ai ni a bawng ai hku hte, Shut hpyit ai amu galaw ai shawa hpawng na, ngai hpe makoi magap la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw tinang a shinglet hpe nhtu zawn karang nga ma ai: Myit malang ai wa hpe mayun de nna gap na,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hka ai ga ngu ai tinang a pala hpe dawn nga ma ai; Hpa mung n hkrit n kang ai, akajawng sha shi hpe gap mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tinang a n kaja ai amu hpe shanhte shangang da nna, Mayun e mahkam hkam na bawng ma ai: “Anhte hpe kadai wa mi mu lu na rai hka?” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw n shawp ai lam daw ma ai: Anhte jin saga ai, amu chyip chyip rai nga ai rai nna, Masha a kraw mung, shi a myit mung sung nga ai, nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang chyawm gaw shanhte hpe gap mu ai; Ndum shami e pala gaw shanhte hpe hkra nna hkala ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tinang a shinglet shanhte hpe kataw shangun mu ai, Shanhte hpe mu ai ni nlang hte baw kanga na mara ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shaloi masha mahkra hkrit hkungga let, Karai Kasang a amu hpe shana ya nna, Shi galaw ai hku myit yu na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dingman ai ni Yehowa hta kabu gara nga nna, shi hta shingbyi nga na mara ai. Myit malang ai ni nlang hte gaw gumrawng na mara ai.
  </para>
  <chapter number="65" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, Ziun hta e, nang hpe angwi apyaw shakawn nna, Nang hpe ga shaka raw lu na, rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Akyu hpyi ai ga madat mara ai wa e, Masha nlang nang kaw du na mara ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />N hkru ai amu ngai hpe dang wa rai timung, Nang gaw anhte a mara hpe magap da na ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a wang hta e, nang hte ani sha nga lu hkra, Nang san da ai wa gaw, a nga ai; Na a chyoi pra ai htingnu hte na a nta na kaja ai hte, Anhte hkru kat lu na ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte hpe hkye hkrang la ai Karai Kasang e, Dingman ai hku hkan nna hkrithpa amu hte, Nang anhte hpe htan ya nga ndai; Aga ting hte tsan tsan e nga ai nammukdara a hpa shara nang rai nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />N-gun hpe shi kyit nga nna, Shi a atsam hte bum ni hpe shagrin da wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nammukdara a wu ngoi ai hpe mung, De a hka leng ni a kashaw ai hte, Amyu baw ni a kabring kabrawng ai hpe, Shi jasim kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai majaw lamu ga htum hkra nga ai ni gaw, Na a kumla ni hpe hkrit nga ma ai. Jahpawt pru, shana shang ai shara kabu gara nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aga hpe nang kawan yu nna, madit ya nga ndai; Nang dai hpe law law jasau wu ai; Karai Kasang a hka nu ntsin hte hpring nga ai; Shanhte a nai mam hpe nang shatut ya mu ai; Rai sa, nang shing rai lajang nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />De a htai hkang ni hpe nang madit ya nna, De a hkinbawng ni hpe ara sha di shangun wu ai: Marang shaya ai hte nang dai hpe shanyap wu ai, De a tu matu hpe nang shaman ya nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nang gaw shaning shanang hpe na a ngamai ai hte jahpring nna, Na a lagaw hkang ni sau lwi nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nam na udat ni hta mung lwi nga nna, Kawng ni kabu gara ai a kyit nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Prang ni hta sagu bainam chyam nga nna, Kadit ni hta nai mam ut rai nga ai: Dai hte gaw garu jahtau nga ma ai. Rai sa, mahkawn mangoi let nga ma ai.
  </para>
  <chapter number="66" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mung shagu Karai Kasang hpe garu mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi mying a hpung shingkang hpe mahkawn mu, Shi hpe shakawn yang, arawng sadang jaw mu:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Karai Kasang e, na a amu gade wa hkrithpa rai nga a hka; Na a chyalai n-gun majaw, Na a man e gumlau ni hkayawm na mara ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mung shagu nang hpe nawku nna mahkawn mangoi na mara ai, na a amying nsang hpe mahkawn mangoi na mara ai,” nga nna tsun mu. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Wa marit, Karai Kasang a magam amu hpe yu mu; Shinggyim masha ni hpe dan ai amu gaw, hkrithpa amu rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw nammukdara hpe hkarang hte galai wu ai; Shanhte dai hka hpe lagaw hte rap manu ai: Dai shaloi anhte shi hta kabu nga saga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw shi a n-gun hte prat tup up nga ai, Shi a myi, masha amyu ni hpe azi yu nga ai: Je hpre ai ni tinang hkum hpe shagrau lu na ma ai n rai. [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Masha amyu ni e, anhte a Karai Kasang hpe shagrau mu, Shi hpe shakawn ai nsen hte jahtau mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a myit masin hpe shi jahkrung ya nna, Anhte a lagaw hpe kashawt shangun mi ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rai tim Karai Kasang e, nang anhte hpe chyam yu nit dai, Gumhpraw hpe zawn, anhte hpe shabyawng yu nit dai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai htawng kata de nang anhte hpe jahkrat nna, Anhte a shingma hta li ai lit shagun nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte a baw ntsa e, masha hpe jawn shangun nna, Wan hta, hka hta, anhte shang ga timung, Nang anhte hpe apra asan sha lai kawt shangun mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Wan nat hkungga hte na a nta hta ngai shang na nngai: ru tsang hkrum ai shani e, nye a nten hpaw mahka nna,
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a n-gup ga shaka tawn da ai hte maren, Dai ga shaka hpe ngai raw na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hpum ai wan nat hkungga hte, sagu la hte rau manam pyaw ai baw, Ngai nang hpe nawng ya na nngai, Dumsu hte bainam la hpe mung ngai lang ya na nngai. [Selah.]
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang hpe hkrit kamyin ai ni nlang hte e, Wa marit, madat mara nga mu; Nye a myit masin hpe shi hpa galaw ai gaw, Ngai gawn dan na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nye a n-gup hte ngai shi hpe shaga nga nna, Nye a shinglet shi hpe shagrau ai ga chye tsun nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a myit hta shut hpyit ai kap yang gaw, Dai Madu madat ya na n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ya chyawm gaw Karai Kasang madat ya ni ai. Ngai akyu hpyi ai nsen shi matsing da nga wu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a akyu hpyi ai ga n gang kau ai hte, Shi a chyeju hpe n dawm la wu ai majaw, Karai Kasang gaw, a nga ai law.
  </para>
  <chapter number="67" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, anhte hpe matsan dum nna shaman ya mi: dinghta ga hta e na a lam,
  </para>
  <para style="p">
    <verse number="2" style="v" />Amyu shagu na a hkye hkrang la ai lam, chye na lu mu ga, na a myi man a nhtoi anhte hpe jahtoi ya mi. [Selah.]
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang e, masha amyu ni nang hpe shakawn mu ga, Rai sa, amyu shagu nang hpe kungdawn mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw masha amyu ni hpe dingman ai hku tara dara nna, Ga ntsa amyu baw ni hpe lakawn la mu ai majaw, Shanhte awng wa nna, kabu gara let jahtau nga mu ga. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang e, masha amyu ni nang hpe shakawn mu ga, Rai sa, amyu shagu nang hpe kungdawn mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aga gaw shi a nsi naisi dik hkra shapraw ya sai, Karai Kasang, anhte a Karai Kasang, anhte hpe shaman ya mi ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang anhte hpe shaman ya nna, Aga ting htum hkra shi hpe hkrit hkungga na mu ai.
  </para>
  <chapter number="68" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang rawt nna, shi hpe gumlau ai ni bra mat mu ga, Shi hpe n dawng ai ni shi a man na hprawng mu ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Wan nhkut mawng mat wa ai zawn, Shanhte hpe kamawng kau mu; Wan hta gitbaw byawng mat ai hte maren, Karai Kasang a man e, tara n lang ai ni hten byak mat mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dinghpring ai ni chyawm gaw kabu gara nga nna, Karai Kasang a man e, sharawng awng nga mu ga: Kabu gara ai hte ja ja pra pra rai nga mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Karai Kasang hpe mahkawn mu, Shi a amying nsang hpe mangoi mu; Nam prang e jawn ai wa a matu lam waw mu, Shi a amying Yehowa rai nga ai; Shi a man e sharawng awng nga mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang gaw shi a chyoi pra ai shara hta e, Jahkrai ma ni a kawa, gaida jan ni a jeyang ai wa, rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karai Kasang gaw gram nga ai ni hpe htinggaw sharawn nna, Bawng dung ai ni hpe ngamai ai de jashawn mu ai: Je hpre ai ni chyawm gaw zaibru jang hta nga nga ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang e, na a amyu a man e nang pru sa nna, Nam mali hta e hkawm langang ai shaloi e, [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Ginding aga gari kawa rai nga nna, Sumsing lamu Karai Kasang a man e yun nga ai: Karai Kasang, Israela a Karai Kasang a man e, Wora Sina bum mung, gari kawa rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, marang mana maga nang jahtu dat nna, Na a nyip mat ai sali wunli hpe shabran wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, na a hpung dai hta e zim nga nna, Nang gaw matsan mayan ni a matu ngamai ngamu lajang da nu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai Madu gaw mungga jaw dat mi ai; Shi ga htawn tsun ai num ni, hpung kaba rai nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Luksuk ni a hkawhkam ni hprawng mat wa ma ai, Rai sa, shanhte hprawng mat wa ma ai rai nna, Nta e hti nga ai num gaw, dai lanep karan na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ulawng ni a lapran e, nanhte taw nga myit yang gaw, Hkrudu a singkaw hpe gumhpraw hte kayawp nga nna, Shi a singkaw mun, tsit kabrim ai ja hte ala nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyahtum chyalai n-gun rawng ai Karai Kasang gaw, dai mung hta e hkawhkam ni hpe shabra kau mu ai shaloi, Zalmon hta e hkyen hkrat ai zawn, rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bashan bum gaw, Karai Kasang a bum rai nga ai, Bashan bum, pungding marawng ai bum rai nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pungding law law marawng ai bum ni e, Karai Kasang anga nga na matu shi lata la ai bum hpe, nanhte hpa rai lagyim yu nga myit ta? Yehowa gaw dai de prat dingsa e anga nga na ra ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang a hpyen leng ni mun lahkawng hte, hkying mi hte hkying mi rai nga lu ai; Dai Madu gaw dai ni hte rau rai nga ai: Chyoi pra ai Sina bum e zawn, bai rai nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Karai Kasang Yehowa gaw dai yang e nga lu n ga, Tsaw ai shara de nang lung wa nna, Bawng dung na ni hpe rim la wa mu ai; Masha ni hta na kumhpa lu la nga ndai, Rai sa, je hpre ai ni hta na pyi, nang lu la nga ndai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dai Madu gaw lani hte lani a nga u ga; Anhte a lit hpe shi gun hpai nga ai, Dai Karai Wa gaw anhte a hkye hkrang la ai lam rai nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="20" style="v" />Karai Wa gaw anhte hpe hkye hkrang la ai Karai Wa, rai nga ai, Madu Yehowa mung, si ai kaw na pru wa lu ai lam, hpaw ya nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gaja wa, Karai Kasang shi a hpyen ni a baw, Tinang a mara hte hkawm ai, njaw kaba tu ai pungding hpe a byen ga na wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai Madu gaw, “na a lagaw asai hta nang gumchya lu nna, Na a gwi ni a shinglet gumlau ni hpe mata lu mu ga;
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngai shanhte hpe Bashan de na shabai la nna, Nammukdara na hpungwai hta na nhtang dat na mawe ai,” nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Karai Kasang e, nang nawt sa wa ai hpe, nye a Karai Wa hte Hkawhkam chyoi pra ai lam hkan nna, Nawt sa wa ai hpe, shanhte mu ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mahkawn mangoi ai ni shawng sa wa nna, Tingse dum ai ni hpang hkan ma ai: Shupsheng dum let mahkawn ni ka-ang e sa ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israela a npawt manat ai ni e, shawa hpawng e Karai Kasang hpe sha-a mu; rai sa, dai Madu hpe sha-a mu.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dai yang e, kaji timung, shanhte hpe up ai Ben-yamin hte, Yuda agyi salang ni, mung damak rai nga ma ai: Zebulun a du salang ni hte, Naphtali a du salang ni mung, lawm nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na a Karai Kasang, na a n-gun atsam hpan ya sai; Karai Kasang e, anhte a matu nang galaw ai hpe shagrin da ya mi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yerusalem mare e nga ai, na a Htingnu majaw, Hkawhkam ni nang hpe kumhpa sak na ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mai-aw pa na matse labye, usu hpung ni hte Amyu ni a dumsu kasha ni, gumhpraw tawng lang let, Sa dingnyawm mu ga, shanhte hpe daru kau mu: Majan tsaw ai amyu ni hpe shabra kau mu.
  </para>
  <para style="p">
    <verse number="31" style="v" />Egutu mung na arawng lu ai ni, du na mara ai; Hkusha gaw Karai Kasang hpang de shi a lata ladawn na wu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dinghta ga na mungdan ni e, Karai Kasang hpe mahkawn mu, dai Madu hpe mahkawn mangoi mu. [Selah.]
  </para>
  <para style="p">
    <verse number="33" style="v" />Chyi nma kaw nna sumsing lamu hta jawn ai wa hpe mahkawn mu; Yu mu, shi gaw nsen kaba hte jahtau dat wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Karai Kasang hpe hkang na ahkang jaw mu: Shi a hpung shingkang Israela ntsa e, Shi a hpung shingkang sumwi hta, dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Karai Kasang e, na a htingnu ni hta, Hkrithpa wa nang rai nga ndai; Israela Karai Wa gaw shi a amyu hpe, N-gun lagaw hte atsam kaba jaw wu ai: Karai Kasang gaw, a nga u ga law.
  </para>
  <chapter number="69" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai hpe hkye hkrang la e; nye a asak du hkra hka lim nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sung ai hkumpup hta ngai chyat nga nna, kabye shara n hkap nga ai. Sung ai hka lam de ngai rai wa nna, hka hpuntun ni ngai hpe dip ni ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shaga ai hte ngai hki ba nga nngai, nye a mayu kasa mat sai; nye a Karai Kasang hpe ala nga let, nye a myi amam mat sai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mara n nga timung, ngai hpe n dawng ai ni, Nye baw a kara hta grau law nga ma ai: Ngai hpe jahten mayu ai, masu ai gumlau ni, n-gun ja nga ma ai. Ngai n kashun la ai arai hpe pyi, Ngai bai ya lu nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang e, ngai angawk ai amu nang chye nga ndai, nye a mara mung, na a man e up da lu ai n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zaw nawng zaw wa up ai Madu, Yehowa e, Nang hpe myit mada nga ai ni, Nye a majaw kaya kahpa n hkrum mu ga; Israela a Karai Kasang e, Nang hpe tam nga ai ni, Nye a majaw arawng n hpoi mu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kaning rai nme law, na a majaw, Ngai shatan nhkan ai hkrum nga nna, ngai myi man sum nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye hpunau ni hta tsasam wa zawn ngai rai nga nna, Nu a kasha ni hta sumtsan masha ngai rai mat ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na nta hta manoi ai nja nhpra myit ngai hpe sha kau nna, Nang hpe shatan ai ni a ga, nye a ntsa e mara nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a myit masin hkrap let lusha gam nga yang, Shatan nhkan hkrai hkrai hkrum sha nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a hpun palawng lachyit nba hpun we yang, Shanhte a jaw shara ngai tai nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mare chyinghka e dung ai ni, nye a lam kajai nna, Chyaru nang ai ni, laka ga hte ngai hpe asawng ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai chyawm gaw, Yehowa e, Kaja ai ladaw e, nang hpe akyu hpyi nga nngai; Karai Kasang e, na a chyeju kaba nga ai majaw, Hkye hkrang la lu ai sadi sahka ga hte, ngai hpe htan ya e.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dai hkumpup hta ngai n chyat n ga, Ngai hpe mawoi la e; Ngai hpe n dawng n yawt ai ni kaw na mung, sung la ai hka lam kaw na mung, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hka hpungtun ni ngai hpe n dip n ga, hka hpungwai ni ngai hpe n mayu kau nna, Dai hka htung mahka nye a ntsa e n pat u ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa e, ngai hpe htan ya e; Kaning rai nme law, na a chyeju kaja nga ai; Na n-gaw nwai ai myit kaba nga ai hte maren, ngai hpang de kayin wa rit.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ru tsang ai ngai hkrum nga nngai majaw, Na a mayam kaw na, na a myi man hkum kayin la et; alawan ngai hpe htan ya e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye myit masin hpe hkye la na, sit wa rit; Nye a gumlau ni a majaw, ngai hpe hkrang la e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nang chyawm gaw, ngai hkrum ai shatan nhkan, Kaya kahpa, aroi arip hpe, chye ya nga ndai: Ngai hpe hpyen ai ni nlang hte gaw, na a man e rai nga ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shatan nhkan ai hte ngai myit htum nngai, Si hkra ngai machyi nga nngai; Myit yu machyi ai masha, ngai tam timung, n nga ai, Shangwi shapyaw ai wa mung, ngai n mu nngai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a lusha hta shanhte shagri bang jaw nna, Hpang gara jang, ngai hpe ntsin hkri shalu mi ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte a sha ku tinang a matu sumgawn zawn, Hkrit na n dum ai shaloi, mahkam zawn, tai malu ga.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shanhte a myi n mu lu hkra, shinggang malu ga; Shanhte a nshang tut tut gari nga malu ga.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a n-yun bu ai shanhte a ntsa e ru bun nna, Na a sindawng kahtet ai shanhte hpe lep mu ga.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte a htingra a katsi katsang rai mat nna, Tinang a sum ni hta kadai mung n nga malu ga.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaning rai nme law, nang anu ai wa hpe, Shanhte htan shachyut ma ai rai nna, Nang galun nna nma shakap ai wa hpe, Shanhte bai shanan ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte a mara ntsa e, mara kahtap ya nna, Na a dingman ai shara hta e, Shanhte hpe hkum jashawn la mu.
  </para>
  <para style="p">
    <verse number="28" style="v" />Asak laika hta na shanhte hpe arut kau nna, Dingman ai ni a mying ka da yang, shanhte n lawm mu ga.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai chyawm gaw matsan mayan hte, nni nkri hkrum nga nngai. Karai Kasang e, na a hkye hkrang la ai chyeju ngai hpe shagrau n ga.
  </para>
  <para style="p">
    <verse number="30" style="v" />Karai Kasang a amying nsang hpe, mahkawn mangoi ga hte ngai shakawn na we ai: Chyeju dum let ngai shi hpe shagrau na we ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yehowa dai lam hpe, utang hte nrung tu nna, Lahkru ga ai usu hta, grau tsaw nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Myit nem ai ni dai lam hpe mu nna, kabu gara na mara ai. Karai Kasang hpe tam ai ni e, myit masin bran nga malit ga.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yehowa gaw matsan mayan ni hpe madat ya nga nna, Shi bawng dung ai ni hpe, n gawn n sawn di mu ai n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sumsing lamu hte ginding aga, nammukdara hte De a hkrung mahkrung hte gaw, shi hpe shakawn kungdawn nga mu ga.
  </para>
  <para style="p">
    <verse number="35" style="v" />Karai Kasang gaw Ziun hpe hkye hkrang la nna, Yuda a mare ni hpe de ya nga mu ai. Dai ni hta e shanhte nga nga nna, madu lu na mara ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shi a ali ama ni a matu mara mung, dai hte hpe lu la nna, Shi a mying nsang tsawra ai ni dai hta e, anga nga na mara ai.
  </para>
  <chapter number="70" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, ngai hpe mawai la na, Yehowa e, ngai hpe karum na, lawan rit.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a sumri sumdam hpe dan na tam ai ni, Kaya kahpa hte myi man sum ai hkrum mu ga; Ngai hpe tsin-yam tsindam jahkrum mayu ai ni, Kanut mat wa nna arawng sum mat mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Da, da,” nga nna tsun ai ni, Shanhte galaw ai kaya kahpa amu a majaw, kanut mat wa mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang hpe tam ai ni nlang hte gaw, Nang hta awng nna, kabu gara nga mu ga; Na a hkye hkrang la ai lam tsawra ai ni gaw, “Karai Kasang galu kaba nga u ga,” nga nna tut tut a tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai nni nkri hte matsan mayan hkrum nga nngai; Karai Kasang e, ngai kaw lawan rit, Ngai hpe karum ai wa hte, mawai la ai wa nang rai nga ndai: Yehowa e, hkum ganung nga et law.
  </para>
  <chapter number="71" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nang hta ngai shingbyi nga nngai: Kaya kahpa galoi mung, n hkrum na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a dinghpring ai hte ngai hpe mawai la nna raw dat e, Na a na ngai hpang de kayin nna ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a matu, ngai galoi mung shang lu na, grin ai lungpu tai u; Nye a lunghkrung hte ngang ai wahpang nang rai nga ndai majaw, Ngai hpe hkye hkrang la na ga nang hkang da nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a Karai Kasang e, tara n lang ai ni a lata hte, N shawp ai hte aja awa re ai ni a lata na, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, Madu, Yehowa e, Brang ram prat kaw nna nye a myit mada shara hte, Nye a makam masham nang rai nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyangai kaw nna nang hta ngai shamyet ni ai; Nu a hkritung na nang ngai hpe shapraw la nit dai: Ngai nang hpe tut tut shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Law law ni a man e, mauhpa zawn ngai rai nga nngai; Rai timung, nang gaw nye a ngang ai shingbyi shara rai nga ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a n-gup nang hpe shakawn ai ga hte, Shani tup na a arawng sadang hte, hpring nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai dingla jang ngai hpe hkum kabai kau et, Nye a n-gun yawm mat yang, ngai hpe hkum jahti da et.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kaning rai nme law, gumlau ni nye a lam tsun nga ma ai; Nye a asak hpe gyam yu ai ni rau bawng nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Karai Kasang shi hpe jahti da nu ai, Hkan rim la gaw, shi hpe hkrang la na wa n nga ai,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Karai Kasang e, ngai hte tsan tsan hkum nga et; Nye a Karai Wa e, ngai hpe karum na lawan rit.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nye a asak hpe gumlau na maw ai ni, Kaya hkrum nna htum mat wa mu ga; Ngai hpe n hkru ai hku galaw na tam ai ni, Shatan nhkan hte arawng hpoi ai ka-up nga mu ga.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai chyawm gaw tut tut myit mada nga nna, Nang hpe shakawn ai ga, a jat nga na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nye a n-gup shani tup na a dinghpring ai lam hte, Na a hkye hkrang la ai lam hpe, gawn nga na we ai: Dai gade law nga ai gaw, ngai n dang sawn nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Madu Yehowa a n-gun chyalai hte ngai sa du nna, Na a dinghpring ai hpe chyu sha, madun dan na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Kasang e, brang ram prat kaw nna, Nang ngai hpe sharin achyin ya nit dai; Ya du hkra na a lamik kumla hpe ngai madun dan nga nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai majaw Karai Kasang e, prat mi hte prat mi na a lata, Hpang na ni hpe na a atsam ngai madun dan ya ai du hkra, Dingla nna baw hpraw timung, ngai hpe hkum jahti da et.
  </para>
  <para style="p">
    <verse number="19" style="v" />Karai Kasang e, na a dinghpring ai gaw grai tsaw nga ai: Magam amu shachyen ai Karai Kasang e, Nang hte kadai wa bung lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="20" style="v" />Tsin-yam tsindam kaba law law anhte hpe madun ai wa e, Nang anhte hpe bai shalan shabran la nna, Ga a sung htum ai kaw na bai sharawt la na ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngai hpe arawng sadang shajat ya nna, Ngai hpe bai shangwi shapyaw la e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shaloi, Karai Kasang e, nang hte na a sadi sahka hpe, Tingse hte ngai shakawn kungdawn na nngai: Israela a chyoi pra ai Wa e, Tingse hte ngai nang hpe mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang hpe mahkawn mangoi nga yang, Nye a n-gup hte, nang hkye hkrang la ai nye a amyit masin gaw, Ja ja kabu nna jahtau na ra ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nye a shinglet mung, na a dinghpring ai lam hpe, Shani tup shana ya na ra ai; Kaning rai nme law, ngai hpe n hkru ai hku maw ai ni, Kaya kahpa hte myi man sum ai hkrum nga ma ai.
  </para>
  <chapter number="72" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, hkawhkam wa hpe na a tara dara ai lam, Hkawhkam a kasha hpe, na a dinghpring ai myit, jaw ya u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw na a amyu hpe dinghpring ai hku, Na a nni nkri hkrum ai ni hpe tara malang ai hku, jeyang nga u ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dingman ai hku majaw, bum ni hte kawng ni gaw, Amyu masha ni hpe ngwipyaw lam tawn da na mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nni nkri hkrum ai amyu masha ni hpe shi tara dara ya u ga; Matsan mayan ni a kashu kasha ni hpe shi hkye la nna, Zingri zingrat ai wa hpe a dup kau mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shu mashi shu masha, jan shata anga nga ai prat dingsa, Shanhte nang hpe hkrit hkungga mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Udat shara e, marang htu ai zawn, Aga hta marang n yit yang na zawn, shi yu wa ru ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a aprat e dingman ai ni awng wa mu ga, Shata mat mat ai du hkra ngwi kaba rai nga lu u ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nammukdara kaw nna nammukdara du hkra, Uhprat hka nu kaw nna lamu ga htum hkra, shi up nga u ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nam mali e nga ai ni shi a man e dingnyawm nna, Shi hpe gumlau ai ni, ga nhpu mata mu ga.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tarshi hte zunlawng ni a hkawhkam ni kumhpa sak nna, Sheba hte Seba hkawhkam ni kang bang nga mu ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hkawhkam yawng hte gaw shi hpe nawku nna, Masha amyu shagu shi hpe daw nga mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaning rai nme law, shaga nga ai matsan ai wa hte, Nrum ntau n lu ai nni nkri hkrum ai wa hpe, shi mawai la na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hti n mai ni hte, matsan mayan ni hpe shi matsan dum nna, Matsan mayan ni a myit masin hpe hkye hkrang la na nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zingri zingrat hte dip sha ai kaw na, shi shanhte a asak hpe shaw la nna, Shanhte a asai gaw shi a myi hta hpu la nga na malu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi shi hkrung nga nna, shi hpe Sheba a aja jaw mu ai rai nna, Shi a matu mara tut tut akyu hpyi ya na mara ai: Shani shanang shi hpe shaman ya na mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mungdan na bum ni a pungding du hkra, nai mam paw wa nna, Lebanon zawn, de a nsi naisi a hkung nga lu ga: mare masha ni mung, lamu ga na nam lap zawn prut wa mu ga.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi a mying nsang gaw tutnawng e anga nga lu ga; Jan grin nga ai zawn shi a amying pu nga lu ga: Shi a majaw masha ni a lu nga mu ga; Nlang hte gaw shi hta sharawng awng nga mu ga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israela a Karai Kasang, Yehowa Karai Kasang gaw, a nga u ga; Shi chyu sha mauhpa amu galaw nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi a dan hkung nga ai amying nsang prat dingsa e, a nga u ga; Mungdan ting gaw shi a hpung shingkang pri rai nga u ga law. Amen, rai sa, Amen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yese a kasha Dawi a akyu hpyi ai ga ngut sai.
  </para>
  <chapter number="73" style="c" />
  <para style="p">
    <verse number="1" style="v" />Gaja wa, Karai Kasang gaw Israela hta na Myit san seng ai ni hpe n-gaw nnyeng rai nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai chyawm gaw, lagaw ganoi noi kaprau nna, Kabye kashawt magang wa nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tara n lang ai ni a ngamai ai lam mu mada yang, Grang ai ga tsun ai ni hpe, ngai manawn nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte tsin-yam tsindam, galoi n hkrum ma ai, Shanhte a kan ahpum asau rai nga malu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Masha gale zawn shanhte ru tsang ai n hkrum ma ai, Masha kaga zawn machyi makaw n hkrum ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai majaw gumrawng ai gaw shanhte a du hta gali da nna, Shanhte bu hpun ai nba, kashun kashe re ai, rai nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte a myi hpum nna myi myi rai malu ai. Shanhte myit ai hku ladu lai nga malu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte roi nna kashun kashe na lam tsun ma ai. Gumrawng gumtawng ga a tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shanhte a n-gup lamu hte nhtan shai nna, Shanhte a shinglet aga hta len hkawm nga malu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai majaw, Karai Wa masha ni pyi shanang sa nna, Ntsin hpe chyup ai zawn, n hkru ai hpe law law chyup nga nna,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Karai Wa kaning rai chye lu na kun? Tsaw htum ai wa gaw chye chyang lu na a hka?” nga ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yu mu, tara n lang ai ni gaw shing rai nga ma ai; Galoi mung ngamai wa nna, shanhte a hpung kaba wa malu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gaja wa, ngai gaw nye a myit kaman sha shapra nga nna, Nye a lata hpe, mara n kap hkra, kashin kau we ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai gaw shani tup nni nkri hkrum nga nna, Jahpawt shagu sharin achyin ai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rai timung, “Kaman sha rai nga ai,” ngu nna ngai tsun taw gaw, Ndai prat na, na a kashu kasha ni hpe, Ngai shut kau ai wa rai na nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ndai amu hpe chye lu hkra myit aru yu yang, Dai gaw nye a matu nau yak la nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hpang e, Karai Wa a nta hta ngai shang nna, Shanhte a htum mat na hpe myit dum lu nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gaja wa, nang shanhte hpe manen ai shara hta tawn da nna, Le, hten mat na shara de jahkrat kau mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahkring sha shanhte hten mat wa ma hka! Tsin-yam kaba hte shanhte atsai awai hten mat masai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yup rawt yang, yup mang hpe hpa n nawn ai zawn, Madu e, nang hprang yang, shanhte a shingna hpe pyi matsat na ndai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a myit masin kahtet nga nna, Nye a nhkyun ni hpam nga li yang,
  </para>
  <para style="p">
    <verse number="22" style="v" />Hpa mung n chye ai angawk ai wa hte, Na man e yamnga zawn, ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung, ngai gaw tut tut nang hte rau nga nga nna, Nye a hkra lata hpe nang jum ya nga ndai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na hpaji daw ai hte nang ngai hpe woi la nna, Hpang jahtum e, hpung shingkang hte ngai hpe hkap la na rai nga ndai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sumsing lamu hta e, ngai kadai hpe lu nga n ta? Nang hpe lu yang ngai mungkan ga hpe hpa n ra nngai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nye a hkum shan hte myit masin mat wa timung, Karai Kasang gaw nye a myit lunghkrung hte, prat dingsa na sali wunli rai nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yu mu, nang hte tsan gang ai ni hten mat masai, Nang hte dingsa sa hka wa ai ni hpe, nang shaprai kau nga ndai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Karai Kasang kaw sit wa na, nye a ngamai shara rai nga ai: Na a magam amu nlang ngai gawn dan nga lu hkra, Yehowa hta nye a kamsham shara ngai tawn da se ai.
  </para>
  <chapter number="74" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, nang anhte hpe hpa rai tutnawng e, kau da nga n ta? Na a ndat na sagu hpung hpe, nang hpa rai myit kahtet nga n ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Moi moi e nang mari da ai na a hpung hpe, Nang dung nga yu ai Ziun bum hte, Nang hkrang shaw la ai sali wunli amyu hpe, dum nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tut tut marawng marang rai nga ai de sa yu u, Gumlau ni a chyoi pra ai shara hpe hpya kau manu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a tara jarawp kata e, hpyen ni shabam nga nna, shanhte a kumla ni dai yang e, tawn da nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Laja ai shalawng hpe nwa hte masha hkyen kau ai zawn, dai yang e rai mat sai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ya, shanhte gaw de a hpunpyen maka yawng hte hpe, Sumdu, nwa hte abyen grawp kau manu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a chyoi pra ai shara hpe shanhte nat kau mu ai; Na a mying nsang nga ai shara hpe, Shanhte ga du hkra awu asin di kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte gaw, “Yawng hte hpe jahten kau gaw,” nga nna kraw lawang e, tsun ma ai. Mung ting na Karai Wa a tara jarawp nlang hte hpe, shanhte nat kau mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a kumla ni hpe anhte n mu lu gaw ai: Ya aten e myihtoi n pru n nga ai; Anhte hta ladaw langa chye ai masha n nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang e, gaten du hkra, hpyen ni shatan lu na rai nga ma ta? Gumlau ni gaw na a amying nsang hpe, tut tut asawng nga lu na rai ma ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a hkra lata hpe nang hpa majaw dawm la wu ta? Dai gaw sinda na shaw nna, shanhte hpe jahten kau mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai timung Karai Kasang gaw moi nna nye a hkawhkam rai nga ai. Shi gaw dinghta ga hta e hkye hkrang la ai lam, hpaw nu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang gaw na a n-gun hte nammukdara hpe jahka nu ai; Hka kata na nga matse ni a baw, nang baw kau nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Baren ni abaw hpe nang agrawp kau nna, Nam mali na amyu ni a shahpa shatai nu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hka deng hte hka shi hpe nang shalwi nit dai; Tut tut a lwi nga ai hka nu ni hpe, nang shahkyet kau manu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shani hpe mung, shana hpe mung nang madu nga ndai, Shata hkum hte ajan hpe mung, nang hpan da nit dai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mung shagu a lamu ga jarit nang shadawn ya nna, Nlum ta hte ginhtawng ta tawn da ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa e, da ndai dum u: gumlau ni shatan nna, mana ai amyu gaw na a amying nsang hpe roi ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a hkrudu a asak hpe matse labye ni hpe hkum ap ya mu; Na a nni nkri hkrum ai ni hpe tutnawng e hkum malap kau et.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tawn da sai ga shaka hpe myit dum u: Dai mung na njut nnaw shagu hkan e, kashun kashe re ai shara hkrai rai nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zingri hkrum ai ni kaya kahpa hte n wa mu ga: nni nkri hte matsan mayan hkrum ai ni, Na a amying nsang hpe shakawn nga mu ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang e, rawt u, na amu hpe yu maga u: Mana ai wa gaw tut e nang hpe a shatan nga ai, dum u.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang hpe hpyen ai ni a nsen hkum malap kau et, Nang hte nhtan shai ai ni a ngoi wu ai nsen gaw, tutnawng e a jat wa nga ai law.
  </para>
  <chapter number="75" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, anhte nang hpe shakawn ga ai, anhte chyeju dum nna, na a amying ni nga ai: Na a mauhpa amu shanhte gawn dan ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Rai sa, ahkying ladaw ngai tawn da nna, Malang ai hku dawdan na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aga hte dai hta nga ai ni nlang run wa yang, De a shadaw ni hpe, ngai madi nga nngai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Grang ai ni hpe, grang ai ga hkum tsun myit, Tara n lang ai ni hpe, Nrung hkum sharawt myit,
  </para>
  <para style="p">
    <verse number="5" style="v" />Tsaw ai de nrung hkum sharawt da myit, Du ja ai hte ga hkum tsun nga myit,” nga nna ngai shanhte hpe tsun da ni ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gaja wa, sinpraw sinna de na mung, Nam mali hkan na bum ni hta nna mung, Dawdan shara n du lu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang chyu sha tara agyi rai nga ai: Langai mi hpe shi shagrit kau nna, Langai mi hpe shagrau wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa a lata hta gawm langai mi nga nna, Nsa ja ai tsabyi hte kayau ai tsi hte hpring nga ai: Dai hta na shi ru dat wu ai rai nna, Ga ntsa na tara n lang ai ni nlang hte gaw De a chyabu du hkra shup nna, lu lu na rai ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai chyawm gaw, tutnawng e hkai dan nna, Yaku a Karai Kasang hpe mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yubak kap ai ni a nrung nlang hte hpe, ngai daw kau na nngai; Dingman ai ni a nrung chyawm gaw, sharawt da ai hkrum na ra ai.
  </para>
  <chapter number="76" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yuda mung hta e, Karai Kasang hpe chye ma ai: Israela hta e, shi a amying galu kaba nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shalem hta e, shi a sum nga nga nna, Ziun bum hta e, shi a shanu shara rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai yang e, ndan myihprap ni hte, N-gang, nhtu hte hpyen rai ni hpe, Shi agrawp kau nu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang gaw lanep lu la ai bum ni a ntsa e, Shingkang hte arawng kaba lu nga ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nden ja ai ni hten byak re ai hkrum sha nna, Ndum shami yup taw nga ma ai; N-gun ja ai ni tinang a lata hpe pyi, n dum ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yaku a Karai Kasang e, nang daru nga ndai majaw, Gumra hte hpyen leng, yup kaba hta yup ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang gaw hkrithpa Wa rai nga ndai: Nang masin pawt bu nga yang, Na a man e kadai tsap lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw sumsing lamu de nna jeyang ai lam shana ya ndai; Karai Kasang gaw tara dara na hte,
  </para>
  <para style="p">
    <verse number="9" style="v" />Mungkan ting na myit gyip ai ni hpe hkye hkrang la na rawt wa ai shaloi e, Lamu ga hkrit nga nna atsin sha nga nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="10" style="v" />Gaja wa, na a masin pawt ai daw mi sha, Nang shingkyit zawn kyit nga yang, Masha wa a masin pawt ai gaw, Nang hpe shakawn kungdawn na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nanhte a Karai Kasang Yehowa hpe, Ga shaka tawn da nna raw dat mu: Grup yin e nga ai ni nlang hte gaw, Hkrit mai ai wa hpe kumhpa sa sak mu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Wa zep ai du ni a nsa hpe, shi jahtum kau ya mu ai. Ga ntsa hkawhkam ni a matu shi hkrithpa rai nga ai.
  </para>
  <chapter number="77" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a nsen hte ngai Karai Kasang hpe jahtau nga nngai; Karai Kasang kaw nye a nsen shapraw yang, shi ngai hpe madat ya na re ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai ru tsang ai nhtoi hta e, dai Madu hpe ngai tam nga nngai. Shana e pyi nye a lata hpe ngai a ladawn da nga nngai; Nye a myit masin ngwipyaw ai hpe kau da nu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang hpe dum yang, ngai madai nga nngai; Myit sumru nga yang, nye a wenyi htan wa li ai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a myi hpyi ni hpe nang jum shadang nga ndai, N di n da ngai rai nga nna, ga n chye tsun nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Moi na lai mat wa ai nhtoi ni hte, chyaloi nhkoi na prat ni hpe, ngai myit yu nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a shana na mahkawn mangoi ga hpe ngai dum nga nna, Nye a kraw hta e myit sumru nga nngai: Nye a wenyi mung Madu a lam a gawn yu nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Madu gaw tutnawng e kau da nga na kun? Shi a myi man bai n madun na sahka?
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a chyeju tutnawng e htum mat sahka? Shi a ga ndat prat mi hte prat mi hten mat lu na kun?
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Wa gaw matsan dum na malap kau a ni? Masin pawt let shi a sumnung ai myit hpe, Dawm la kau na nu ni? [Selah.]
  </para>
  <para style="p">
    <verse number="10" style="v" />Shaloi ngai gaw, “Dai lam ngai nan chyum sha ai hte, Tsaw htum ai Wa a hkra lata galai ai majaw rai nga ai,” nga nna ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa a amu bungli ngai shana ya nna, Chyaloi nhkoi na mauhpa bungli hpe, adum nga na nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang galaw ai lam nlang hte hpe ngai myit nga nna, Na a magam amu hpe myit aru yu na nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang e, na a lam chyoi pra ai lam rai nga ai; Karai Kasang zawn kaba ai hpara gaw, kadai rai nga a ta?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang gaw mauhpa amu galaw ai Karai Wa rai nga ndai, Masha amyu ni hta, na a atsam dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a amyu, Yaku hte Yawsep a kashu kasha ni hpe, Na a hkra lata hte nang shaw hkrang la mu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="16" style="v" />Karai Kasang e, hka hpung ni nang hpe mu ma ai. Hka hpung ni nang hpe mu nna, hkrit kawam nga ma ai: Sung htum ai shara ni mung, kanawng nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sumwi ni ntsin jahtu nna, lamu gaw mu ngoi nga ai; Na a pala ni mung, bra hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nbung laru hta e, na a mu ngoi ai ngoi nga nna, Myihprap ni mungkan ga hpe jahtoi ya nga ai: Lamu ga mung gari nna awam nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na a lam nammukdara hta e rai nga nna, Nang sa ai hku, hka kaba ni hta e rai nga ai: Na a lagaw hkang hpe kadai n chye lu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang gaw Mawshe yan Arun a lata hte, Na a amyu hpe sagu hpung hpe zawn, woi wa nu ai.
  </para>
  <chapter number="78" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a amyu e, nye a tara hpe na la mu, Nye a n-gup ga hpe madat mara la mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a n-gup, ga shagawp hte ngai hpaw nna, Chyaloi nhkoi na gumwai ga, htai dan na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte na la nna chye ga ai hte maren, Ji woi ni anhte hpe hkai dan mi ai gaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a kashu kasha ni a man e anhte makoi da na gaw ai n rai: Yehowa hpe mai shakawn ai lam hte, Shi a atsam, shi galaw sai mauhpa amu hpe, Anhte shu mashi shu masha du hkra gawn dan na ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, shi gaw Yaku hta e sakse ga, Israela hta e jep ai tara tawn da nna; Shanhte a kaji kawoi ni zawn, gumlau ai hte mung n yu nna,
  </para>
  <para style="p">
    <verse number="6" style="v" />Tinang a myit masin hpe n shading nna, Karai Wa a man e tinang a wenyi sadi n dung ai amyu n tai mu ga she:
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang hpe kamsham nga nna, Karai Wa a amu hpe n malap kau ai sha, Shi htet da mada hpe hkan mayu lu hkra,
  </para>
  <para style="p">
    <verse number="8" style="v" />Htawm hpang e du ai amyu ni a kashu kasha ni, Dai tara hpe chye na lu nna, Shanhte gaw tinang a kashu kasha ni hpe bai gawn dan nna, Dai lam ni kashu kasha ni hpe sharin ya mu ga, Shi anhte a ji woi ni hpe hkang da mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ndan shachyen nna gap chye ai Ehprim a kashu kasha ni, Hpyen shani hta e, hpang de kayin mat wa ma ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Kasang a ga shaka hpe shanhte n dum nna, Shi a tara hpe hkan nang na ndang nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte gaw shi a magam amu hte, Shanhte hpe madun dan ai mauhpa bungli hpe, malap mali kau mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi gaw shanhte a kaji kawoi ni a man e, Egutu mung na Zuan prang hta e, mauhpa amu galaw wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai nawng hpe shi jahka da nna, shanhte hpe shalai dat mu ai; Hka leng ni hpe sumpum zawn, tawn da wu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi shanhte hpe shani e sumwi hte, Shana tup wan nhtoi hte, woi wa mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nam na lunghkrung ni hpe shi jaga nna, Sung la ai hka hta na zawn, shanhte hpe shalu mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai nlung hta na hka shi shapraw dat nna, Hka nu zawn ntsin lwi shangun mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai timung, shanhte yubak naw galaw nna, Hkun hkraw ai shara e, Tsaw Htum ai Wa hpe gumlau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tinang a asak a matu shanhte lusha hpyi nna, Tinang a myit hta, Karai Wa hpe chyam yu mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte Karai Kasang hpe put nna tsun mu ai gaw: “Nam mali hkan e sha ku lajang da lu na a kun?
  </para>
  <para style="p">
    <verse number="20" style="v" />Yu mu, dai lunghkrung hpe shi kayat wu yang, Hka kahpawk pru wa nna, hka shi ni lwi ma ai. Muk mung, shi jaw lu na a kun? Shi amyu a matu ashan san ya lu na a kun?” nga ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shing nga ai ga Yehowa na wu ai majaw, Shi masin pawt bu nna, Yaku hta e wan chyi nga ai, Israela hpe mung masin pawt nga wu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Karai Kasang hpe shanhte n kam nna, Shi a hkye hkrang la ai lam hta, n hpa ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rai timung, ntsa na sumwi hpe shi htet da nna, Sumsing lamu a chyinghka ni hpe hpaw dat wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sha na matu, shi shanhte a ntsa e manna jahtu ya nna, Lamu na n-gu shanhte hpe jaw mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Du magam ni a shat masha ni sha nga nna, Lusha shahpa hkru kat hkra shi jaw da mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lamu na sinpraw nbung shi shapraw nna, Shi a n-gun hte dingda nbung woi wa wu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ashan hpe mung, ga a nhpu daram, Pyen ai u hpe, nammukdara a zaibru daram, Shi shanhte a ntsa e jahtu ya mu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte a dap ka-ang e, Shanhte a nga ai shara grup yin e, Shi dai hte hpe jahkrat ya mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shaloi shanhte sha nna hkru kat nga ma ai, Shanhte ra ai hku dik wa malu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte ra ai shat garai n jin nna, Tinang a n-gup e shahpa naw rawng nga yang,
  </para>
  <para style="p">
    <verse number="31" style="v" />Karai Kasang shanhte hpe masin pawt nna, Shanhte hta na hkum bawng ai ni hpe sat kau nhtawm, Israela shabrang ni hpe katawng kau mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Rai timung, shanhte yubak naw galaw nna, Shi a mauhpa amu n kam n sham ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dai majaw shi gaw shanhte a nhtoi ni hpe nbung zawn, Shanhte a shaning ni hpe hkrithpa hte e, jahtum ya mu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dai ni hpe sat kau mu yang, shanhte shi hpe dum nna, Karai Wa hpang de kayin wa let shi hpe tam ma ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Karai Kasang gaw shanhte a lunghkrung, Tsaw Htum ai Karai Wa shanhte a shaw hkrang la ai madu rai nga ai, shanhte dum lu nga ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Rai timung, tinang a n-gup hte shanhte shi hpe shapyaw nna, Tinang a shinglet hte shi hpe masu kau mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte a myit shi a man e n sadi nga malu ai rai nna, Shi a ga shaka hpe shanhte n hkan ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shi chyawm gaw, matsan dum nga nna, N jahten kau ai sha, mara magap ya mu ai: Shi a masin pawt ai law law lang shakawp kau nna, Shi a myit kahtet ai nlang n sharawt wu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shanhte gaw ashan hte, poi mat nna bai n wa lu ai bung shi hkrai rai nga ma ai gaw, shi adum nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nam mali hkan e shanhte gade lang gumlau nga nna, Hkraw krin ai shara e, shi hpe myit shayawn da mu hka!
  </para>
  <para style="p">
    <verse number="41" style="v" />Karai Wa hpe shanhte bai chyam yu yu di nna, Israela a Chyoi pra ai Wa hpe shapawt mu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shanhte gaw shi a lata hte, hpyen ni a lata na, Shanhte hpe shalawt la mu ai nhtoi hpe, Hpa mung n dum nga ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shi gaw, Egutu mung hta e shi a lamik, Zuan prang hta e shi a kumla, madun dan mu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shanhte ntsin n lu lu hkra, hka nu ni hte Hka shi ni hpe, asai shatai wu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shanhte hpe kawa na jinghkam hte, shanhte hpe jahten na shu hpe, shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shanhte a nsi naisi hpe shingchyut e, Nai mam hpe dinggam-yaw ni e, jaw kau mu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Shanhte a tsabyi ru hpe sin hte, Lakum hpun ni hpe hkyen hte, jahten kau ya mu ai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Shanhte a yamnga ni hpe sin hte, Yamnga hpung ni hpe myihprap hte, sat kau ya mu ai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Shi gaw sindawng pawt kahtet ai hte, Tsin-yam tsindam, nji nmu, ru tsang ai hpe, n hkru ai kasa hpung zawn, shangun dat wu ai.
  </para>
  <para style="p">
    <verse number="50" style="v" />Shi masin pawt ai pru na nga, shi lam lajang nna, Shanhte a asak hpe si ai de na n shabai ya mu ai: Ana ahkya hte shi shanhte hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Egutu masha ni a kasha alat nlang hte hte, Ham a sum ni hta n-gun rawng ai ni hpe, shi sat kau mu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Shi a amyu hpe chyawm gaw, sagu hpung zawn shi woi wa nna, Sagu hpung kaba hpe zawn, nam mali e, lakawn wa mu ai;
  </para>
  <para style="p">
    <verse number="53" style="v" />Shi shanhte hpe angwi sha woi wa nna, shanhte n hkrit ma ai; Gumlau ni hpe chyawm gaw dai nawng hta e ka-up kau mu ai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Shanhte hpe, shi a chyoi pra ai ga jarit hte, Shi a hkra lata madu ai bum de, woi wa mu ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Masha amyu ni hpe shi shanhte a man na shaden kau ya nna, Shanhte a sali wunli hpe karan ya mu ai: Shanhte a sum ni hta e, Israela amyu ni nga nga ma ai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Rai timung, shanhte gaw Tsaw Htum ai Karai Kasang hpe, Dinglik nna gumlau nga ma ai; Shi a sakse ga hpe mung n hkan ma ai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Kaji kawoi ni zawn shanhte kanut mat wa nna, htak mat ma ai; N ding ai ndan zawn, nhtang wa ma ai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Tsaw ai shara ni hte shi hpe shapawt nna, Sumla ni hte shi a nsu nnawn myit shapraw ya mu ai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Karai Kasang dai lam na la nna, myit kahtet bu nga ai, Israela hpe nachying matsat kau wu ai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Dai rai nna, shi gaw Shilo a sumpan hta, Masha a ka-ang e gap ai sum hpe, kau da wu ai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Bawng dung nga mu ga, shi a atsam hte, Gumlau ni a lata de shi a arawng hpe, ap ya mu ai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Shi a amyu hpe nhtu hta shi ap da nna, Shi a sali wunli hpe masin pawt bu nga wu ai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Shanhte a shabrang ni wan hkru ai hkrum nna, Mahkawn ni gaw hkungran laka ga n na lu ma ai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Hkinjawng ni nhtu hte si ma timung, Gaida jan ni n hkrap lu ma ai.
  </para>
  <para style="p">
    <verse number="65" style="v" />Shaloi dai Madu gaw, yup pyaw ai wa hte, Tsabyi majaw jahtau ai share zawn, hprang wa ai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Shi a gumlau ni hpe kanut wa shangun nna, Prat dingsa kaya kahpa jahkrum mu ai.
  </para>
  <para style="p">
    <verse number="67" style="v" />Yawsep a sum hpe shi gang kau nna, Ehprim a amyu hpe n san da wu ai.
  </para>
  <para style="p">
    <verse number="68" style="v" />Yuda amyu hte, shi tsawra nga ai, Ziun bum hpe, shi san da wu ai.
  </para>
  <para style="p">
    <verse number="69" style="v" />Matsaw matsang hte, htani htana dinggrin nga ai lamu ga hpe zawn, Shi a chyoi pra ai shara hpe shi dè da wu ai.
  </para>
  <para style="p">
    <verse number="70" style="v" />Shi a mayam Dawi hpe mung shi san da nna, Sagu hpung ni hta na shi hpe lata la wu ai.
  </para>
  <para style="p">
    <verse number="71" style="v" />Shi a amyu Yaku hte, shi a sali wunli Israela hpe lanu lahku ya mu ga, kasha hkrat ai sagu yi ni kaw na, shi hpe shaw la wu ai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Shi gaw shanhte hpe myit ding ai hte rem nga nna, Hpaji kung ai lata hte woi lakawn wa mu ai.
  </para>
  <chapter number="79" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, maigan amyu ni, Na a sali wunli hta shang nga nna, Na a chyoi pra ai htingnu hpe wu kau mu ai: Yerusalem mare hpe marawng marang di kau mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shanhte gaw na a ali ama ni a mang ni hpe, ntsa na u ni a shahpa shatai nna, Na a chyoi pra ai ni a hkum shan hpe, Nam na matse labye ni hpe, jaw kau mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yerusalem grup yin e shanhte a asai hpe, hka zawn, ru kau nna, Makoi mayang rai na masha mi n nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte a htingbu ni a man e shatan nhkan ai, Grup yin e nga ai ni a man e, roi nga ai hte Asawng asang re ai, anhte hkrum nga ga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, nang gaten du hkra masin a pawt nga na n ta? Na a supbun bun ai myit, wan zawn a hkru nga na rai ta?
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang hpe n chye ai maigan amyu ni hte, Na a amying hpe n shaga ai mungdan ni a ntsa e, Na a myit kahtet ai hpe ru bun dat u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw Yaku hpe makrut sha nna, Shi a nga shara hpe akrin atsai di kau mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ji woi ni a mara anhte hta hkum shagun mi; Na a matsan dum ai myit hte, anhte hpe alawan tau la mi: Anhte matsan mayan rai la nga ga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte hpe hkye hkrang la ai Karai Kasang e, Na amying a arawng majaw, anhte hpe karum la mi; Na amying nsang a gawp e, Anhte hpe mawai la nna, yubak magap kau ya mi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Shanhte a Karai Kasang kanang nga a hka?” Nga nna maigan amyu ni hpa rai tsun lu na rai ma ta? Na a ali ama ni a ru kau ai asai majaw, matai dawp ai lam, masha amyu ni hte anhte a man e, pra rai nga u ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bawng dung ai ni a madai ai gaw nang kaw hkrang shang u ga: Na a galu kaba ai lahpum hte, si ang ai ma ni hpe bau sin u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Madu e, anhte a htingbu ni, Nang hpe shatan nhkan di ma ai hpe, Shanhte a sinda hta, htam sanit bai tai mu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Anhte chyawm gaw, na a amyu hte Nang rem nga ai sagu ni, Nang hpe tutnawng e, chyeju dum na ga ai: Prat mi hte prat mi, na a shakawn ga, anhte gawn dan na ga ai.
  </para>
  <chapter number="80" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sagu hpung hpe zawn, Yawsep amyu hpe woi wa ai, Israela hpe rem ai wa e, madat u; Hkerubim ntsa e dung ai wa e, dan pru rit.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ehprim, Ben-yamin hte Manashe a man e, Na a share n-gun shapraw nna, Anhte hpe karum na sa wa rit.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang e, anhte hpe shalan shabran la mi: Na a myi man a nhtoi jahtoi ya nna, Anhte hkye hkrang la ai hkrum na ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zaw nawng zaw wa up ai Karai Kasang Yehowa e, Nang gaten du hkra na amyu a hpyi ai ga hpe pawt nga na n ta?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang shanhte hpe myi prwi shat jaw nna, Myi prwi law law wa lu shangun mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang anhte hpe htingbu ni hte ga lai shara shatai nna, Gumlau ni mung anhte hpe aroi arip rai ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zaw nawng zaw wa up ai Karai Kasang e, Anhte hpe shalan shabran la mi: Na a myi man a nhtoi jahtoi ya nna, Anhte hkye hkrang la ai hkrum na ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw Egutu mung na tsabyi ru langai mi la wa nna, Masha amyu ni hpe shaden kau nhtawm, dai hpe hkai da wu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />De a shara nang tsan kau wu ai rai nna, Shi a ru jung wa nna, mung ting e hkram nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a shingnip bum ni hpe hkung nga nna, Shi a lakung ni Karai Wa a arit hpun ni hpe htawng nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi a lakung ni hpe nammukdara du hkra, makrung ni hpe dai hka nu du hkra, shahkrawn dat wu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai yang hprang ai ni nlang de a asi hpe di kau lu mu ga, Nang hpa majaw de a bunghku ni hpe, run kau wu ta?
  </para>
  <para style="p">
    <verse number="13" style="v" />Maling na wa du dai hpe kanaw sha nna, Nam na ashu ashan ni dai hpe sha kau mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zaw nawng zaw wa up ai Karai Kasang e, Bai wa rit; lamu de na mada yu nna, Ndai tsabyi ru hpe sa kawan katsan yu u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a hkra lata hkai da nna, Na a matu nang lata la ai lakung hpe, lanu nga u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai gaw wan hkru ai hte kran kau ai hkrum sai; Nang daru kau ai majaw, shanhte hten byak mat masai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a hkra maga e dung nga ai wa hte, Na a matu nang lata la ai masha kasha a ntsa e, na a lata anga nga u ga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shaloi anhte nang kaw na n htak mat na ga ai: Anhte hpe jahkrung la mi, anhte na a amying nsang hpe shaga na ga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zaw nawng zaw wa up ai Karai Kasang Yehowa e, Anhte hpe shalan shabran la mi: Na a myi man a nhtoi jahtoi ya nna, Anhte hkye hkrang la ai hkrum na ga ai.
  </para>
  <chapter number="81" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anhte a n-gun lagaw rai nga ai Karai Kasang hpe jahtau mu, Yaku a Karai Kasang hpe kabu gara jahtau mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mahkawn mangoi nna, shupsheng dum mu, Pyaw ai tingse hte doria hpe dum mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shata praw shani e pahtau dum mu, Anhte a shata shagawng ai poi hta e, dum mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai gaw Israela a matu ga madat hte, Yaku a Karai Kasang a tara rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />N chye na lu ai ga ngai na yu se ai rai nna, Shi gaw Egutu mung ntsa e hkawm lai wa ai shaloi e, Yawsep hta e, dai jep ai tara hpe shi tawn da wu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw shi a lahpa dai lit hta na shaw la nna, Shi a lata ka ji hta na shalawt ya we ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ru tsang hkrum yang nang shaga nna, ngai nang hpe mawai la de ai; Mu ngoi ai nsen hte ngai nang hpe htan ya de ai: Meriba hka makau e, ngai nang hpe chyam yu de ai. [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a amyu e, madat u, ngai matsun tsun da na nngai. Israela e, nang nye a ga hpe chye madat taw e!
  </para>
  <para style="p">
    <verse number="9" style="v" />Hpara tsasam, na a ka-ang e n nga lu na re ai; Masha kaga a hpara, nang nawku lu na ndai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Egutu mung na nang hpe shapraw la ai, Na a Karai Kasang Yehowa ngai rai nga nngai: Na a n-gup mahka u, ngai jahpring ya na de ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a amyu chyawm gaw, nye a nsen n madat nna, Israela ngai hpe hpa mung n nawn nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dai majaw tinang myit ai hku shanhte hkan nang lu hkra, Tinang a myit ja ai hta ngai shanhte hpe dat dat mawe ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nye a amyu nye a ga madat nna, Israela nye a lam hta hkawm a taw gaw:
  </para>
  <para style="p">
    <verse number="14" style="v" />Gade n na yang, ngai shanhte a gumlau ni hpe shagrit kau nna, Shanhte hpe shatsang ai ni a ntsa e, nye a lata mara na we ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa hpe n dawng ai ni, shi a man e dingnyawm nga mu ga; Nye amyu a aten, gamhpa dinggrin anga nga na malu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sau ai hkaulan mam hte ngai shanhte hpe bau nna, nlung hku na lagat jahku hte shanhte hpe jahkru na mawe ai.
  </para>
  <chapter number="82" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang gaw Karai Wa a hpung hta e tsap nga ai; Karai daw ni a ka-ang e, shi tara dara nga ai:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Tara n lang ai ni a myi man hpe tau yu nna, Gaten du hkra, n tara ai hku hkan na myit ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Matsan mayan ni, jahkrai nmai ni hpe karum mu, Myit gyip ai ni hte hku hku ai ni hpe awlaw mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hpa n lu ai ni hte matsan mayan ni hpe shalawt dat mu; Tara n lang ai wa a lata na shanhte hpe shaw la mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte hpa mung n chye n chyang ma ai. Nsin e kahkrang hkawm nga ma ai: Lamu ga a npawt nhpang yawng shamu shamawt nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw, “Karai daw ni hte, Tsaw Htum ai Wa a kasha ni, nanhte rai nga myit dai, nga nna tsun ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rai timung, masha zawn nanhte si mat nna, Du langai mi zawn, kadawng mat na marin dai,” nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Karai Kasang e, dinghta ga hpe tara dara na rawt u; Amyu baw shagu na a sali wunli tai na mara ai law.
  </para>
  <chapter number="83" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, lukmu rai hkum nga et, Karai Wa e, atsin atsu hkum rai nga et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yu u, nang hpe gumlau ai ni kabrawng nga nna, Nang hpe n dawng ai ni baw sharawt ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a amyu hpe shanhte hpaji daw nna, Nang makawp maga ai ni a lam bawng nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw, “sa marit, amyu ni hta na, shanhte hpe tsan kau gaw; Israela amying hpe htawm hpang de kadai mung n dum mu ga,” nga nna tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte myit langai sha hte bawng nna, nang hpe gumlau ai ni a maga e ga shaka tawn da mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Edom amyu hte Ishmaela amyu, Moba hte Hagara amyu a sum ni,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gabala, Ammon, Amalek amyu ni, Hpilisti ni hte Turu mare na ni, lawm ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asuri masha ni mung shanhte hte myit hkrum ma ai; Shanhte gaw lawt na masha ni hpe sa karum ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="9" style="v" />Midian hte, Kishon hka makau na, Sisera hte Yabin hpe di ai zawn, shanhte hpe di mu.
  </para>
  <para style="p">
    <verse number="10" style="v" />Endora makau e, shanhte sum mat wa nna, Aga a namhpun zawn, rai mat ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shanhte a salang ni hpe Oreb yan Zeeb, Shanhte a du ni nlang Zeba yan Zalumuna hpe zawn, shatai u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaning rai nme law, shanhte gaw, “Karai Kasang a shanu shara hpe anhte madu la gaw,” nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nye a Karai Wa e, bungsha e shapoi ai ga nhpu zawn, Nbung hta poi ai yi hku hpe zawn, shanhte hpe shatai mu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Maling dinggram hpe hkru kau ai wan hte, Bum ni hpe jahkat kau ai sharaw zawn,
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a bunghpoi e shanhte hpe hkan shachyut nna, na a laru hte shanhte hpe jahkrit kau mu.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa e, shanhte gaw na amying hpe tam mu ga, Shanhte a myi man kaya kahpa hte jahpring ya mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa e, nang hte na a amying chyu sha, Ga ting hta e Tsaw Htum nga ai, shanhte chye mu ga.
  </para>
  <para style="p">
    <verse number="18" style="v" />Prat dingsa shanhte kaya kahpa hte hkrit gari nna, Myi man sum ai hte hten byak ai hkrum mu ga law.
  </para>
  <chapter number="84" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zaw nawng zaw wa up ai Yehowa e, Na a shanu shara ni gaw gade awng mai nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a myit masin Yehowa a wang ni hpe marit nna ndawt nga ai; Nye a myit hte hkum shan gaw, ahkrung nga ai Karai Wa hpe kabu gara jahtau nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a hkawhkam, nye a Karai Kasang, Zaw nawng zaw wa up ai Yehowa e, na a hkungri ni a makau e, u tsa gaw nta mu lu nna, Hkalung lung na matu, pilan gaw tsip tsip na shara mu nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a nta e nga ai ni gaw, a nga ma ai. Shanhte nang hpe shakawn kungdawn nga na ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang hta n-gun la ai wa gaw, a nga ai; Ziun a lam ni shi a myit hta hkrang nga ai;
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte gaw hkrap ngu hkrap ngoi ngu ai kadit lai wa yang, Dai shara hpe hka deng shatai mu ai. Marang nnan mung dai hpe sha-a wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte n-gun bai jat la la rai nna, Ziun bum na Karai Kasang a man e du lu ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zaw nawng zaw wa up ai Karai Kasang Yehowa e, Nye a akyu hpyi ai ga madat ya e: Yaku a Karai Kasang e, na la u. [Selah.]
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a n-gang Karai Kasang e, mada yu u, Na a namman chya hkam ai wa hpe matsing da u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a wang kata e lani mi sha nga lu ai gaw, nhtoi kaga hkying mi hta grau kaja nga ai. Tara n lang ai wa a sum hta nga lu ai hta, Karai Kasang a chyinghka hkinbawng sin na, ngai grau tsaw nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa Karai Kasang ajan hte n-gang rai nga ai, Yehowa gaw chyeju hte arawng sadang jaw lu ai; Dingman ai hku hkan ai ni hpe, shi kaja ai hpa mung ndang na n rai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zaw nawng zaw wa up ai Yehowa e, nang hta shamyet shanat ai wa gaw, a nga ai law.
  </para>
  <chapter number="85" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nang gaw na a mungdan hpe ra nit dai. Yaku a bawng dung ai ni hpe, nang shabai la nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a amyu a mara hpe, nang raw kau ya nna, Shanhte a yubak nlang hte hpe magap da nu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a masin pawt ai nlang nang dawm la kau nna, Na a myit kahtet ai hpe shayawm nu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Anhte hpe hkye hkrang la ai Karai Kasang e, Anhte hpe bai wa shangun nna, Anhte hpe n dawng n yawt ai myit jasim kau u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang anhte hpe tutnawng e a pawt nga na n ni? Prat mi hte prat mi masin a pawt nga na n ni?
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a amyu nang hta bai kabu gara nga lu mu ga, Nang anhte hpe bai jahkrung ya na ndai, n rai ni?
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, na a chyeju anhte hpe madun dan nna, Na a hkye la ai lam anhte hpe hpaw ya mi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa Krai Wa tsun ai ga hpe ngai madat na nngai; Shi gaw shi a amyu hte chyoi pra ai ni hpe, ngwipyaw ai ga a tsun nga ai: Shanhte gaw angawk ai lam hta bai n shang mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gaja wa, anhte a mungdan hta e arawng nga lu u ga; Shi a hkye hkrang la ai lam, shi hpe hkrit kamyin ai ni kaw ani sha nga nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyeju hte sadi sahka gaw hkrum nga masai, Dinghpring ai hte ngwipyaw ai gaw, shada da pup nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sadi sahka gaw lamu ga de na tu pru nna, Dinghpring ai gaw sumsing lamu de na mada yu na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa gaw mai kaja ai lam jaw ya nna, Anhte a lamu ga, de a nsi naisi jaw na mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a man e dinghpring ai gaw hkawm nga nna, Shi a lagaw hkang, lam shatai na ra ai.
  </para>
  <chapter number="86" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, na a na kayin nna, ngai hpe htan ya e; Nni nkri hte matsan mayan, ngai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hkrit hkungga ai myit rawng nga nngai majaw, Nye a myit masin hpe bau sin u: Nye a Karai Kasang wa, nang e, Nang hta shamyet nga ai, na a mayam wa hpe hkye hkrang la u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shani tup ngai nang hpe shaga nga nngai majaw, Madu e, ngai hpe matsan dum la e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Madu e, nye a myit masin nang hpe marit nga li ai majaw, Na a mayam wa a myit masin hpe, shapyaw ya e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Madu e, nang mai kaja nga nna, mara raw kau ya ndai; Nang hpe shaga ai ni nlang hte hpe, nang chyeju kaba madun nga ndai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa e, ngai hpyi ai ga madat u, Ngai akyu hpyi ai nsen hpe mung, matsing da u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang ngai hpe htan ya na ndai majaw, Ngai ru tsang ai nhtoi e, ngai nang hpe shaga na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Madu e, Hpara ni hta e nang hte bung ai mi, n nga ai, Na a amu zawn re ai mung n nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Madu e, nang hpan tawn da ai amyu nlang hte gaw, Na a man e shang nna nawku na mara ai: Na a amying hpe mung, shagrau na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang galu kaba nga ndai rai nna, Mauhpa amu galaw nga ndai: Nang chyu sha Karai Kasang rai nga ndai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa e, na a lam ngai hpe sharin ya e, Na a tengman ai hta e, ngai hkawm mayu nga nngai. Na a amying hpe hkungga nga n ga, nye a myit shadut ya e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nye a Madu Karai Kasang e, Ngai nang hpe myit yawng hte shakawn nga nna, Tutnawng e, na a amying hpe shagrau na nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaning rai nme law, na a chyeju kaba nga nna, Nye a myit masin hpe, sung htum ai katsan ga na, nang mawai la ya nit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Karai Kasang e, gumrawng ai ni nye a man e rawt wa nna, Damya hpung ni, nye a myit masin hpe tam nga ma ai: Shanhte nang hpe hpa n nawn nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Madu e, nang chyawm gaw, matsan dum chye ai, Sumnung re ai, myit galu ai, chyeju kaba hte, Sadi sahka rawng ai Karai Wa, rai nga ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai hpang de kayin nna, matsan dum la e; Na a n-gun lagaw, na a mayam wa hpe, Na a hkye hkrang la ai lam, na a nchyang jan a kasha hpe, jaw ya u.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai hpe n dawng ai ni mu nna, kaya kahpa hkrum mu ga, Kaja ai kumla ngai hpe madun ya e: Kaning rai nme law, Yehowa e, nang ngai hpe, Karum nna shangwi shapyaw ya nit dai law.
  </para>
  <chapter number="87" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shi a npawt nhpang gaw chyoi pra ai bum ni a ntsa e jung nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa gaw Yaku a htingra ni nlang hte hta, Ziun bum na chyinghka ni hpe, grau tsawra wu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Karai Kasang a mare, nang e, na a lam, Arawng rawng ai ga kaba pru nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai hpe chye chyap ai ni hta na, Rahab yan Babelon rai nga ma ai, ngai ngu na mawe ai. Hpilisti, Turu, Hkusha hpe yu yu mu: Ndai ni wonang e shangai wa masai.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Langai hte langai, Ziun mung hta shangai wa masai, Tsaw Htum ai Wa mung, dai hpe shadaw da wu ai,” Ngu nna Ziun a lam masha ni tsun na maru ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amyu baw ni hpe jahpan la ai shaloi e, “Ndai amyu gaw nang e shangai wa sai,” nga nna, Yehowa gawn yu na ra ai. [Selah.]
  </para>
  <para style="p">
    <verse number="7" style="v" />“Nye a hka htung ni nlang hte, nang hta nga nga ai,” nga nna, mahkawn mangoi ai hte ka manawt ai ni nga na mara ai.
  </para>
  <chapter number="88" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai hpe hkye hkrang la ai Karai Kasang Yehowa e, Shani shana ngai nang hpe shaga nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai hpyi ai ga nang kaw hkrang u ga, Ngai jahtau ai ga, nang na la ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a myit masin ru tsang ai hte hpring nga nna, Nye a asak katsan ga de ni wa sai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nsung hku hta shang ai ni hte ngai bung nna, N-gun n rawng ai wa zawn, ngai tai ni ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang galoi mung bai n dum ai, lasa si nna, Lup hta taw nga ai mang ni hta, ngai lawm nga nngai: Na a lata hte shanhte dawdan ai hkrum masai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang ngai hpe sung htum ai hku hte, Hka hpungla ni a nsin sin ai shara hta, kau da ni ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a myit kahtet ai nye a ntsa e dip nga nna, Na a hka leng ni yawng ngai hpe kamyet nga ma ai. [Selah.]
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang nye a jinghku ni hpe ngai hte shatsan kau nna, Shanhte a matsat shabat shara, ngai hpe shatai ni ai; Ngai sharen da ai hkrum nna n pru lu nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ru tsang ai majaw, nye a myi amam nga ai; Yehowa e, shani shagu ngai nang hpe shaga nga nngai; Nye a lata na a man e ngai ladawn nga nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Si mat ai ni hpe, mauhpa amu madun lu na n ni? Tsu ni bai rawt nna, nang hpe shakawn na ma hka? [Selah.]
  </para>
  <para style="p">
    <verse number="11" style="v" />Lup hta e, na a chyeju hte, ngarai mung e, Na a sadi sahka hpe, shanhte hkai na ma kun?
  </para>
  <para style="p">
    <verse number="12" style="v" />Nsin sin ai shara e na a mauhpa amu hte, Hten bya ai mung e, na a dingman ai hpe, shanhte chye lu na ma ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai chyawm gaw, Yehowa e, nang hpe shaga nga nngai; Jahpawt e, nye a akyu hpyi ai ga na a man e du nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa e, nang hpa rai nye a myit masin hpe kau da nga n ta? Na a myi man nang hpa rai kayin la kau n ta?
  </para>
  <para style="p">
    <verse number="15" style="v" />Brang ram kaw nna, nni nkri ngai hkrum nna, si na tik sha ra nngai. Na a hkrithpa hpe ngai gun nna myit htum nga nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a myit kahtet ai nye a ntsa e du nna, Na a hkrit gari ai baw ngai hpe jahten mi ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai gaw shani tup hka zawn ngai hpe kawan da nna, ngai hpe grup hkra di mi ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai hpe ra ai wa hte jinghku hpe, Ngai hte nang shatsan kau nna, Ngai hte hkau chyap ai ni, nsin zawn rai ma ai.
  </para>
  <chapter number="89" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa a chyeju hpe ngai galoi mung mahkawn mangoi nga na nngai. Nye a n-gup hte na a sadi sahka hpe Prat mi hte prat mi, shana ya na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, Chyeju gaw galoi mung agrin nga ai; Na a sadi sahka hpe sumsing lamu hta e nang tawn da nga ndai, nga nna ngai a tsun nga nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw, “Ngai san da ai wa hpe ga shaka ngai tawn da nna, Nye a mayam Dawi hpe ngai dagam da se ai:
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a aru arat hpe tutnawng e, ngai shagrin da nga nna, Na a tingnyang hpe prat mi hte prat mi shadun da na we ai,” nga nit dai. [Selah.]
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, sumsing lamu gaw na a mauhpa lam hpe, Chyoi pra ai ni a hpung gaw na a sadi sahka hpe, shakawn nga na ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lamu sumwi hta e Yehowa hte kadai wa bung nga a ta? Hpara kasha ni hta Yehowa hte kadai wa pre nga a ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw, chyoi pra ai ni a shawa hpawng hta e, Makrim hpa rai nga ai rai nna, Shi a grup yin e nga ai nlang hte hta, Hkrithpa Karai Wa rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zaw nawng zaw wa up ai Karai Kasang Yehowa e, Nang zawn n-gun rawng ai gaw, kadai wa rai nga a ta? Na a sadi sahka nang hpe shinggrup nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nammukdara gumrawng ai hpe nang up nga nna, De a hka leng ni kabrawng yang, jasim nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sat kau hkrum ai wa hpe zawn, nang Rahab hpe agrawp kau nna, na a n-gun rawng ai lahpum hte, gumlau ni hpe shabra kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sumsing lamu hte dinghta ga gaw, na a rai nga ai. Mungkan ga hte de a yawng mayawng hpe, nang gaw da nit dai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dingdung, dingda nang hpan da nit dai, Tabura hte Hermun, na a amying hta kabu nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a lahpum wa-ngan lahpum rai nga lit dai; Na a lata n-gun ja nga ai, na a hkra lata sharawt nga ndai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dinghpring ai hte tara dara ai lam, na a tingnyang a npawt rai nga ai; Chyeju hte sadi sahka na a man e a la nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pahtau dum ai nsen chye na ai amyu gaw, a lu nga ai; Yehowa e, na a myi man a nhtoi hta e, shanhte hkawm nga lu ma ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a amying hta e, shanhte shani tup kabu nga lu nna, Na a dingman ai hta shagrau ai hkrum nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte a n-gun lagaw a hpung nang rai nga nna, Na a n-gaw nnyeng hte anhte a nrung hpe sharawt nga ndai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte a n-gang Yehowa kaw na rai nga ai; Anhte a hkawhkam wa gaw, Israela a Chyoi pra ai wa kaw na rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kalang mi hta shingran hte nang tsun nna, Kamsham ai ni hpe tsun ndai gaw: “Share wa langai mi hpe ngai shadaw se ai, Dai amyu hta na shabrang wa hpe shagrau da se ai:
  </para>
  <para style="p">
    <verse number="20" style="v" />Nye a mayam Dawi hpe ngai mu da nna, Nye a chyoi pra ai namman hte shi hpe chya ya se ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a lata shi hte rau nga nga nna, Nye a lahpum shi hpe shangang na we ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gumlau wa gaw shi hpe n rim la lu nna, N hkru ai wa gaw shi hpe dip lu na wu ai, n rai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi hpe zingri ai ni hpe, ngai shi a man e nyap tawn nna, Shi hpe n dawng ai ni hpe, adup kau na mawe ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nye a chyeju hte sadi sahka shi hte rau anga nga nna, Nye a amying majaw shi a nrung rawt wa na lu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngai gaw shi a lata hpe nammukdara ntsa e, Shi a hkra lata dai hka nu ntsa e, mara da ya na we ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi gaw, ‘Nye a Wa, nye a Karai Wa, Ngai hpe hkye la ai lunghkrung, nang rai nga ndai,' nga nna ngai hpe shaga na ra ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai mung kasha alat shara shi hpe jaw da nna, Mungdan hkawhkam ni hta grau kaba ai wa shatai na we ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nye a chyeju shi hte tutnawng e anga nga nna, Nye a ga shaka shi hte hka wa na n rai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shi a aru arat tutnawng e anga nga na ra ai; Shi a tingnyang lamu a nhtoi zawn, agrin nga na lu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shi a kashu kasha ni nye a tara hpe kau da nna, Nye a tara ai lam n hkan ma ai;
  </para>
  <para style="p">
    <verse number="31" style="v" />Nye a ga madat hpe awu asin di kau nna, Ngai htet da ai ga hpe n dum ma yang gaw,
  </para>
  <para style="p">
    <verse number="32" style="v" />Ngai shanhte a mara hpe shingna hte, Shanhte a shut hpyit ai hpe kayat ai hte, ari jaw na mawe ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rai timung, nye a chyeju nlang ngai n dawm la nna, Nye a sadi sahka lam hpe masu kau na we ai, n rai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nye a ga shaka hpe ngai n wu kau nna, Nye a n-gup ga hpe shabai la na we ai n rai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nye a chyoi pra ai hte ngai lang mi dagam se ai; Dawi hpe ngai hkalem kau na we ai n rai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Shi a aru arat tutnawng e anga nga nna, Shi a tingnyang dai ajan zawn, nye a man e anga nga ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dai gaw, shata zawn tutnawng e agrin nga nna, Sumwi ntsa e nga ai sakse mung, teng nga ai,” nang nga nit dai. [Selah.]
  </para>
  <para style="p">
    <verse number="38" style="v" />Nang chyawm gaw kau da nna matsat kau nit dai. Na a namman chya hkam ai wa hpe, nang myit kahtet nga ndai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na a mayam hte tawn da ai ga shaka hpe nang kau da nna, Shi a janmau hpe ga hta e galu kau ya nu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shi a shakum nlang hte hpe nang run kau nna, Shi a bunghku ni hpe marawng marang di kau ya nu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lam e lai ai ni nlang hte shi hpe hpya la nna, Htingbu ni a matu kaya kahpa shara shi tai nga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shi hpe hpyen ai ni a hkra lata nang sharawt ya nna, Shi hpe gumlau ai ni nlang hte hpe kabu shangun mu ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Gaja wa shi a nhtu nshan hpe nang galau kau ya nna, Hpyen majan hta e, shi hpe n shadaw wu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi a shingkang hpe nang la kau ya nna, Shi a tingnyang hpe ga de jahkrat kau ya mu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shi a brang ram nhtoi hpe nang gadun ya nna, Kaya kahpa hte shi hpe htinggrum da nu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="46" style="v" />Yehowa e, gaten du hkra nang a makoi nga nna, Na a myit kahtet ai gaw wan zawn, a grung nga na lit ta?
  </para>
  <para style="p">
    <verse number="47" style="v" />Nye a aprat gade gadun nga ai gaw, dum u: Shinggyim masha ni hpe hpa lila majaw nang hpan da nga n hka!
  </para>
  <para style="p">
    <verse number="48" style="v" />Si htan n mu nna, katsan ga de na shi a myit masin hpe, Shalawt la lu ai wa gaw, kadai rai nga a ta? [Selah.]
  </para>
  <para style="p">
    <verse number="49" style="v" />Madu e, moi moi e, na a sadi sahka hte Dawi hpe, Nang dagam ai chyeju gaw, kanang rai nga a ta?
  </para>
  <para style="p">
    <verse number="50" style="v" />Yehowa e, na a ali ama ni hkrum ai shatan nhkan hpe dum u; Nye a sinda e, amyu law law ni a shatan ai ga hpe, ngai gun nga we ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Yehowa e, gumlau ni nang hpe shatan ma ai rai nna, Na a namman chya hkam ai wa a lagaw hkang hpe shatan nhkan di mu ai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Yehowa gaw htani htana e, a nga u ga law. Amen, rai sa, Amen.
  </para>
  <chapter number="90" style="c" />
  <para style="p">
    <verse number="1" style="v" />Madu e, nang gaw ji woi ni a lakhtak kaw nna, Anhte a nga nga shara rai nga ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bum ni hpe garai n shangai nna, Mungkan ga hte dinghta aga hpe garai n shaprat yang, Nang gaw chyi nma hpri nhpra kaw nna, Karai Wa, rai nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang gaw mungkan masha hpe ga nhpu de shabai dat nna, “Shinggyim masha ni e, wa ma su,” nga nna tsun nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai sa, na a man e shaning hkying mi gaw, Mani lai wa sai nhtoi hte shana na ladaw zawn, rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang shanhte hpe shayawng dat mu ai; Shanhte gaw yup pyaw ai zawn, rai nga ma ai: Shanhte jahpawt e tsingdu zawn tu nga ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai gaw jahpawt e pu wa nna lagra nga ai, Shana e, dan kau hkrum nna nyip mat nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gaja wa, na a masin pawt ai hte anhte tsam mat wa nna, Na a myit kahtet ai hte hkrit gari ai hkrum ga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw anhte a yubak hpe na a man e, tawn da ndai; Ndum shami re ai mara hpe pyi, na myi man a nhtoi hta shadan da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a n-yun bu ai hte, anhte a nhtoi nlang mat ma ai: Anhte a shaning ni madai nga let shalai dat gaw ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte a aprat a nhtoi ni sanit shi ning rai nga ai; Kalang lang, n-gun ja ai a majaw matsat shi ning du rai timung, De a gumrawng shara gaw, amu hte yawn hkyen ai hkrai rai nga ai: Dai gaw alawan lai wa nna, anhte pyen mat nga ga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na a ja la ai pawt sindawng ai hte, hkrit mai ai n-yun bu ai hpe, Kadai wa chye ya lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte gaw myit hpaji lu la hkra, Anhte a nhtoi chye hti lu na, sharin ya mi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa e, wa rit; gade na hkra? Na a ali ama ni hpe shangwi shapyaw ya mu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jahpawt e, na a chyeju hte anhte hpe jahkru ya mi; Shaloi anhte prat tup awng nga nna kabu nga na ga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang anhte hpe nni nkri jahkrum ai nhtoi hte, Ru tsang ai shaning anhte hpe madun ai hte maren, anhte hpe kabu shangun ya mi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a magam amu, na a ali ama ni hpe, Na a hpung shingkang, shanhte a kashu kasha ni hpe, madun ya mu.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anhte a Madu Karai Kasang a shawang myit gaw, anhte a ntsa e anga nga u ga; Anhte a lata a amu bungli, anhte a matu shangang ya mi; Rai sa, anhte a lata a amu bungli shakang ya mi law.
  </para>
  <chapter number="91" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tsaw Htum ai Wa a shim ai shara e dung nga ai wa gaw, Chyalai n-gun rawng ai Karai Wa a shingnip hta anga nga lu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai gaw Yehowa hpe, “Nye a shingbyi shara hte wahpang, Ngai hpa nga ai Karai Kasang nang rai nga ndai,” nga nna tsun nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, shi gaw u hkam ai wa a mahkam hte, Bya wa ai ana ahkya hta na, nang hpe mawai la na ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a singkaw mun hte shi nang hpe magap da nna, Shi a singkaw npu e, nang shim nga lu na ndai: Shi a sadi sahka gaw, n-gang hte hpyen palawng rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shana na hkrithpa hte, Shani e gap dat ai pala hpe;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nsin e kawan hkawm ai ana ahkya hte, Jan pungding e byin ai ali awaw hpe, nang n hkrit ra nga ndai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a makau e masha hkying mi, Na a hkra maga e mun mi, kataw timung, Dai nang hpe hkra lu na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gaja wa, na a myi hte nang mada yu nna, Tara n lang ai ni hta kap wa ai ari hpe mu lu na rin dai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa e, nye a shingbyi shara nang rai nga ndai! Nang gaw Tsaw Htum ai Wa hpe na a nga shara shatai nu ai;
  </para>
  <para style="p">
    <verse number="10" style="v" />Aru ara nang hta byin lu na n rai, Machyi makaw na a sum hta, ni wa lu na n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lam shagu hta e nang hpe bau sin na, Na a matu shi a lamu kasa ni hpe, shi hkang da mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nlung hta na a lagaw n ahtu u ga, Shanhte a lata hta nang hpe pawn la na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkanghkyi hte pu htum a ntsa e nang hkawm lu nna, Hkanghkyi hkalung hte baren hpe kabye lu na rin dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai hta shi kanan nang nga ai majaw, Ngai shi hpe mawai la na we ai; Nye a amying hpe chye nga ai majaw, Ngai shi hpe makawp maga na we ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi ngai hpe shaga yang, ngai htan na nngai, Ru tsang ai hte ngai shi hte rau nga na nngai; Ngai shi hpe sai la nna, shagrau na we ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Prat galu ai hte ngai shi hpe shakat ya nna, Nye a hkye hkrang la ai lam shi hpe madun dan na we ai.
  </para>
  <chapter number="92" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe shakawn kungdawn nna, Tsaw Htum ai Wa a amying hpe mahkawn mangoi na;
  </para>
  <para style="p">
    <verse number="2" style="v" />Sumri shi rawng ai dum ai baw hte tingse, Mahku pyaw ai tingse kaji hte,
  </para>
  <para style="p">
    <verse number="3" style="v" />Jahpawt manap e na a chyeju hpe, Shana ahkying e, na a sadi sahka hpe hkai dan na, mai kaja rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, Yehowa e, Na a amu hta nang ngai hpe kabu shangun nna, Na lata a bungli majaw, ngai awng wa na nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, na a amu gade kaba nga a hka! Nang myit ai hku nachying sung la nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai gaw karing karang masha n chye na lu ai, Angawk ai wa mung n myit hkawn lu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tara n lang ai ni tsingdu zawn tu wa nna, Shut hpyit ai hku galaw ai ni nlang pu wa ma yang, Dai gaw, shanhte a prat dingsa e hten mat hkrum na lam rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, nang chyawm gaw, Htani htana, a grau nga ai wa, rai nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaning rai nme law, yu u, nang hpe gumlau ai ni, Yehowa e, Nang hpe gumlau ai ni, hten wa na mara ai: Shut hpyit ai hku galaw ai ni nlang brun mat wa na mara ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a nrung hpe chyawm gaw, Hpawlam a nrung zawn, nang shatsaw da nna, Namman nnan hte ngai hpe chya ya ni ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai hpe gyam yu ai ni e, nye a myi lala mu lu nna, N hkru nna ngai hte nhtan shai ai ni a lam, Nye a na hte ngai na hkrup se ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dinghpring ai wa gaw umung hpun zawn tu lu nna, Lebanon a arit hpun zawn gung dam wa na ra ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa a nta e hkai tawn da ai ni, Anhte a Karai Kasang a wang e, kaba wa na mara ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa dingman nga ai gaw, shana ya lu na, Shanhte gaw prat nga ai shaloi e asi naw si nna, Sau rawng ai hte kat kat rai na mara ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi gaw, nye a lunghkrung rai nga ai. Shi hta e n ding ai, hpa mung n nga nga ai.
  </para>
  <chapter number="93" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw Hkawhkam rai nga ai; Hpung shingkang hpe shi bu hpun nga ai; Yehowa gaw n-gun hte mawn sumli nga ai, Dai hpe shingkyit zawn kyit da nu ai: Gaja wa, mungkan ga hpe shi tawn da nu ai: Dai gaw shamu shamawt nga ai n rai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyaloi nhkoi nna, na a tingnyang nga nga ai, Chyi nma hpri nhpra kaw nna, nang nga nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, hka nu ni hte hka shi ni, Nsen shapraw nga ma ai: Hka nu ni kadu kashaw nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hka sumhpa ni ngoi kaba ai hte, Nammukdara a n-gun ja ai hka leng ni hta, Tsaw ai shara de nga ai Yehowa gaw n-gun grau kaba nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a sakse ga nachying grin nga ai; Yehowa e, lamu ga aprat htum hkra, Na a nta gaw chyoi pra nga na, ging nga ai.
  </para>
  <chapter number="94" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mara bai tai htang ya ai Karai Wa, Yehowa e, Bai tai htang ya ai Karai Wa e, htoi kabrim nga u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lamu ga a tara agyi wa e, rawt pru u: Gumrawng ai ni hpe amu hte maren bai tai mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, tara n lang ai ni gaten du hkra? Tara nlang ai ni gaten du hkra, ninglaw nga lu na rai ma hka?
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte ga galu galang tsun nna, grang nga ma ai; Shut hpyit ai hku galaw ai ni nlang, lila ga tsun ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, shanhte gaw na a amyu hpe dip da nna, Na a sali wunli hpe zingri zingrat mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gaida jan hte masha tsasam wa hpe shanhte sat kau nna, Jahkrai ma ni hpe htau kau mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw, “Yehowa n mu mada na re ai, Yaku a Karai Kasang n dum nga ai,” nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amyu masha ni hta myit n kung ai ni e, dum nga mu; Angawk ai ni e, galoi wa mi she hpaji chye na myit ta?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na shatut ai wa gaw, n na lu na rai ni? Myi hpan da ai wa gaw, n mu lu na a hka kun?
  </para>
  <para style="p">
    <verse number="10" style="v" />Masha wa hpe chye chyang ai lam sharin ya nna, Amyu baw ni hpe ari jaw ai wa gaw, n daru lu na rai ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Masha a myit mang ai lam nbung sha rai nga ai gaw, Yehowa chye ya nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa e, nang shadum ya nna, Na a tara hpe sharin ya ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tara n lang ai ni a matu, nsung hku htu ngut hkra, Ru tsang ai nhtoi hta na shi lawt lu u ga, Nang shi hpe ban sa ai lam, madun ya nu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa gaw shi a amyu hpe kau da na n rai, Shi a sali wunli hpe jahti da na n rai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dingman ai lam gaw naw awlaw nga na rai nna, Myit malang ai ni yawng dai hku hkan nang na mara ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />N hkru ai ni hpe jet kau na, ngai hte rau kadai wa rawt na rai nga a ta? Shut hpyit ai ni hpe daru kau na, ngai hte rau kadai wa tsap na rai nga a ta?
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa ngai hpe n karum taw gaw, nye a myit masin ya e pyi, A katsi katsang nga ai kaw, nga mat na sali ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai gaw, “Nye a lagaw kashawt nga li ai,” nga ai shaloi, Yehowa e, na a chyeju ngai hpe shadaw ni ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nye a kraw lawang na myit law ai shaloi e, Nang shakawp ya nna, nye a myit masin hpe kabu shangun ya nngai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tara a malai, n hkru ai hku tawn da ai, kashun kashe re ai tingnyang gaw, Nang hte hku lu na rai ni?
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte dingman ai wa a asak hpe rau htim nna, Mara n lu ai asai hpe, ga dan kau mu ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rai timung, Yehowa gaw nye a wahpang rai nga ai, Nye a Karai Kasang, ngai shingbyi ai lunghkrung rai nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw shanhte a mara hpe, bai nhtang ya na mu ai, Yubak majaw shanhte hpe jahtum kau na mu ai: Anhte a Karai Kasang Yehowa, shanhte hpe jahtum kau na mu ai law.
  </para>
  <chapter number="95" style="c" />
  <para style="p">
    <verse number="1" style="v" />Wa marit, Yehowa hpe garu ga, Anhte hpe hkye hkrang la ai lunghkrung kaw, kabu gara jahtau ga!
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyeju dum let shi a man de anhte shang ga, Mahkawn mangoi ga hte shi hpe kabu gara jahtau ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, Yehowa gaw Karai Wa kaba hte, Hpara ni mahkra a ntsa e, Hkawhkam kaba, rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lamu ga sung ai shara ni, shi a lata hta rawng nga ai, Bum pungding ni mung shi a rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nammukdara hpe shi galaw nna up nga ai, Shi a lata gaw hkarang hpe mung hpajang da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sa marit, anhte a Hpan Wa Ningsang Yehowa a man e, Anhte dingnyawm let nawku nna lahput hput di nga ga!
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw, anhte a Karai Kasang rai nga ai; Anhte mung shi a udat a amyu hte, Shi a lata na sagu hpung rai nga ga ai. Nanhte dai ni shi a nsen madat myit ga!
  </para>
  <para style="p">
    <verse number="8" style="v" />Meriba hte, nam e nga ai Masa a makau na zawn, Nanhte a myit masin hpe hkum shaja myit.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nanhte a nji nwoi ni dai yang e, ngai hpe dinglik yu mi ai; Nye a amu hpe mu lu rai timung, ngai hpe chyam yu mi ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai gaw mali shi ning tup ndai amyu hpe n yawt nga nna; “Shanhte gaw tinang a myit hte lam dam mat ai amyu hte, Nye a lam hpe mung n chye ai ni, rai nga ma ai,” nga nna ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai majaw, “Nye a ban sa ai hta shanhte n shang lu mu ga,” nga nna masin pawt let, ngai dagam da nngai.
  </para>
  <chapter number="96" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe mahkawn ga nnan hte mahkawn mu, Aga ting Yehowa hpe mahkawn mangoi mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa hpe mahkawn mangoi mu, shi a amying hpe sha-a mu; Shi a hkye hkrang la ai lam hpe lani hte lani hkai dan mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Masha amyu ni hpe shi a hpung shingkang, Amyu baw shagu hpe shi a mauhpa amu, gawn dan mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw galu kaba nga ai rai nna, Nachying shakawn ging ai wa, rai nga ai: Hpara mahkra ni hta shi hpe grau hkrit mai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amyu baw ni a hpara ni, sumla hkrai rai nga ma ai; Yehowa chyawm gaw, sumsing lamu hpe hpan da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ndaw nsa hte hpung shingkang shi a man e nga nga ai, Atsam hte reng htum ai, shi a Chyoi pra ai shara e, nga nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Masha amyu dap ni e, anhte a Yehowa hpe, Rai sa, Yehowa hpe hpung shingkang hte atsam yin la mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa a amying nsang hpe hpung shingkang yin la mu; Lusha hkungga lang nna, shi a wang hta shang mu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyoi pra ai hpe mawn sumli nna, Yehowa hpe nawku mu; Mung shagu shi a man e hkrit gari nga mu ga.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Yehowa gaw Hkawhkam rai nga ai,” Ngu nna masha amyu ni hpe tsun dan mu; Gaja wa, mungkan ga hpe shi tawn da nna, Dai gaw shamu shamawt nga ai n rai; Amyu baw ni hpe malang ai hku, shi dawdan na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa a man e, sumsing lamu kabu gara nga nna, ginding aga garu jahtau na ra ai: Nammukdara hte dai hta rawng marawng, nsen kaba hte kashaw nga mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pa hte dai yang na nga manga kabu awng nga mu ga; Shaloi maling na hpun yawng hte awng sharawng nga na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaning rai nme law, lamu ga hpe tara dara na, shi du sa nna, Shi gaw mungkan ga hpe dingman ai hte, amyu baw ni hpe sadi sahka hte, tara dara na ra ai.
  </para>
  <chapter number="97" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw Hkawhkam rai nga ai; Ginding aga kabu jahtau nga u ga; Zunlawng law law ni mung, kabu gara nga mu ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sumwi hte nsin shi a grup yin e nga nga ma ai; Dingman ai hte tara dara ai gaw, shi a tingnyang a npawt nhpang rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a man e wan hkawm nga nna, Shi a grup yin hkan na hpyen ni hpe hkru kau mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a myihprap mungkan ga hpe jahtoi ya nga ai; Aga gaw dai hpe mu nna hkrit gari nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aga ting a Madu, Yehowa a man e, Bum ni gaw gitbaw zawn, byawng mat ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sumsing lamu gaw shi a dinghpring ai hpe shana ya nna, Amyu shagu shi a hpung shingkang hpe mu lu ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gawngngu hpuntawng daw jau ai ni nlang hte hte, Sumla hta gumrawng ai ni, kaya kahpa hkrum mu ga: Hpara yawng hte e, shi hpe nawku mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, na a tara ai lam majaw, Ziun na nna kabu nga ai; Yuda a shayi sha ni mung, kabu jahtau nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaning rai nme law, nang Yehowa e, Lamu ga ntsa e tsaw htum ai wa rai nga ndai; Hpara mahkra ni a ntsa e, nang nachying grau nga ndai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa hpe tsawra ai ni e, n hkru ai hpe n dawng kau mu; Shi hpe kamsham ai ni a myit masin hpe shi sin nga ai: Tara n lang ai ni a lata na, shi shanhte hpe mawai la mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dingman ai ni a matu, nhtoi htoi nga ai, Myit malang ai ni a matu kabu shara rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dingman ai ni e, Yehowa hta kabu gara nga mu, Shi a chyoi pra ai shingteng amying hpe shakawn nga mu.
  </para>
  <chapter number="98" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe mahkawn ga nnan hte mahkawn mu; Shi gaw, mauhpa amu galaw nu ai: Shi a hkra lata hte chyoi pra ai lahpum, shi a matu hkye hkrang la ai lam shapraw nu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa gaw shi a hkye hkrang la ai lam hpaw ya wu ai; Shi gaw shi a dinghpring ai lam, masha amyu ni a man e madun dan mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a chyeju hte sadi sahka, Israela a nta a matu shi dum nu ai: Lamu ga makau shagu hkan e mung, Anhte a Karai Kasang a hkye hkrang la ai lam mu lu masai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mung shagu e, Yehowa hpe kabu jahtau mu, Nsen kaba hte garu nna mahkawn mangoi mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tingse dum nna Yehowa hpe mahkawn mu, Tingse hte mahku ngwi ai nsen hte mangoi mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pahke hte ngoi ai pahtau hte, Hkawhkam Yehowa a man e kabu jahtau mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nammukdara hte dai hta na yawng mayawng, Mungkan ga hte de a nga manga ni, ngoi kashaw nga mu ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa a man e, hka nu ni lata lahpawk dum mu ga; Bum ni gaw jawm garu kabu nga mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaning rai nme law, lamu ga hpe tara dara na shi du sa nna, Mungkan ga hpe dingman ai hte, amyu baw ni hpe malang ai hku hte, tara dara na ra ai.
  </para>
  <chapter number="99" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw Hkawhkam rai nga ai; Amyu baw ni hkrit gari nga mu ga: Hkerubim ntsa e shi adung nga ai, Ginding aga awam nga u ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa gaw Ziun hta e kaba nga ai rai nna, Amyu baw shagu a ntsa e grau tsaw nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a kaba ai hte hkrit mai ai amying nsang hpe, Shanhte shakawn kungdawn nga mu ga: shi gaw chyoi pra nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dingman ai tara tsawra ai hkawhkam a atsam hpe, Tara npawt hta nang tawn da nu ai; Nang gaw Yaku hta e tara dara ai hte dingman ai lam, jashawn nu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte a Karai Kasang Yehowa hpe shagrau mu, Shi lagaw mara ai lahkum makau e nawku mu: Shi gaw chyoi pra nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi a hkinjawng ni hta lawm ai Mawshe yan Arun, Shi a amying hpe shaga ai ni hta lawm ai Samuela gaw, Yehowa hpe shaga ma ai rai nna, shi shanhte hpe htan ya mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi shanhte hpe sumwi shadaw hta nna ga tsun mu ai: Shanhte mung shi a sakse ga hte, shanhte e jaw ai tara hpe hkan nang ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Anhte a Karai Kasang Yehowa e, Nang shanhte hpe htan ya mu ai. Shanhte a mara raw kau ya ai Karai Wa nang rai nga timung, Shanhte a bungli hte maren matai bai dawp mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a Karai Kasang Yehowa hpe shagrau mu, Shi a chyoi pra ai bum hta e nawku mu: Anhte a Karai Kasang Yehowa gaw chyoi pra nga ai law.
  </para>
  <chapter number="100" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mung shagu Yehowa hpe kabu jahtau nga mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa hpe kabu gara ai hte daw jau nga mu, Shi a man de mahkawn mangoi let shang mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa gaw Karai Kasang rai nga ai, chye mu: Shi anhte hpe hpan da mi ai rai nna, Anhte shi a masha ni rai nga ga ai; Shi a amyu hte shi a udat na sagu hpung, anhte rai nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a chyinghka de chyeju dum let shang mu, Shi a wang hta e shakawn kungdawn let shang mu; Shi a chyeju dum nna shi a amying nsang hpe sha-a mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, Yehowa gaw mai kaja nga ai; Shi a chyeju htani htana anga nga nna, Shi a sadi sahka prat mi hte prat mi agrin nga ai law.
  </para>
  <chapter number="101" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chyeju hte tara dara ai lam ngai mahkawn mangoi na nngai: Yehowa e, ngai nang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Myit malang ai lam ngai matsing yu na nngai; Nang ngai kaw galoi e du na rin ta? Nye a nta hta hkum tsup ai myit hte ngai hkang nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />N hkru ai amu hpe ngai n yu na nngai, Shut hpyit ai ni a amu hpe ngai n dawng nga nngai: Dai gaw ngai hta kap lu na n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Magaw ai myit ngai hte tsan nga u ga, N shawp ai hpe ngai n dum nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a htingbu wa hpe mayun de nna shi htawn ai wa hpe, ngai atsai awai di kau na we ai: Gumrawng nna myit kaba ai wa hpe, ngai n dang hkam nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai mung na sadi sahka re ai ni, Ngai hte rau nga mu ga, ngai tam na nngai; Myit malang ai lam hta hkan ai wa gaw, Nye a amu gun hpai lu na ra ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkalem sha ai wa gaw, nye a nta hta rawng lu na n rai; Masu ai ga tsun ai wa gaw, nye a man e grin lu na n rai.
  </para>
  <para style="p">
    <verse number="8" style="v" />N hkru ai amu galaw ai ni nlang hte hpe, Yehowa a mare na jahkoi kau na, Dai mung na tara n lang ai ni yawng hte hpe, Ngai jahpawt shagu atsai awai di kau na mawe ai.
  </para>
  <chapter number="102" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, ngai akyu hpyi ai ga madat ya e, Ngai hpyi jahtau ai ga, nang kaw hkrang pru u ga.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai ru tsang hkrum ai nhtoi hta e, na a myi man ngai kaw na hkum makoi kau et; Na a na ngai hpang de kayin dat rit; Ngai shaga ai nhtoi e, alawan htan ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a nhtoi wan nhkut zawn hkoi mat sai, Nye a nrut nra ni wan nwu zawn hkru mat ma masai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a myit tsingdu zawn hkraw wa nna, nyip mat li ai, Lu sha na pyi, ngai malap kau nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai madai sharung nga nngai majaw, Nye a nrut nra ni hpyi hta kap mat wa masai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zaibru jang e nga mat ai wunpu u hte, Prang ga e nga ai u hku zawn, ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai yup n lu sha nga nngai rai nna, Nta magaw e dung ai u shingtai zawn, rai nga nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai hpe gumlau ai ni shani tup ngai hpe shatan mi ai; Ngai hpe n dawng n yawt ai ni ngai hpe dagam kau mi ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Wan dap hpe shat zawn ngai sha nna, Nye a luhpa myi prwi hte kayau nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai gaw na a masin pawt ai hte, myit kahtet bu ai a majaw rai nga ai; Kaning rai nme law, nang ngai hpe shagrau nhtawm, bai shagrit kau ni ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nye a nhtoi ni mat wa ai shingnip zawn rai nga nna, Tsingdu zawn ngai nyip mat nga nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang chyawm gaw, Yehowa e, htani htana anga nga nna, Na a amying shingteng prat mi hte prat mi agrin nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang rawt wa nna Ziun hpe matsan dum na ndai: Rai sa, shi hpe yu lahku na aten du ra ai rai nna, Shi a ladaw langa da ai, ya e rai sai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a mayam ni shi a nlung ni hpe sharawng nga nna, Shi a nhpu hpe pyi, ra la nga ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shaloi masha amyu ni Yehowa a amying nsang hpe, Ga ntsa hkawhkam ni nlang na a arawng sadang hpe, hkrit hkungga na mara ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaning rai nme law, Yehowa gaw Ziun hpe de da nu ai; Shi a hpung shingkang dan hkung nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Matsan mayan ni a akyu hpyi ai ga shi madat ya nna, Shanhte a akyu hpyi ai lam matsat kau ya mu ai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai gaw hpang na ni a matu ka da nga ai rai nna, Naw pru na ra ai amyu gaw, Yehowa hpe shakawn na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kaning rai nme law, shi gaw shi a chyoi pra ai, Tsaw Htum ai shara de nna, azi yu nga ai; Lamu de nna ga de, Yehowa a mada nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bawng dung ai ni a madai ai hpe shi madat nga ai, Si na wa a matu shi chyinghka hpaw ya nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dai majaw amyu baw ni zuphpawng nga nna, Mungdan na ni Yehowa hpe daw jau nga ai shaloi e,
  </para>
  <para style="p">
    <verse number="22" style="v" />Yehowa a amying hpe, Ziun hta e, Yerusalem mare e shi hpe shakawn ai gaw, masha ni gawn dan na mara ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shi gaw nye a n-gun hpe, lam hkan e shayawm nna, Nye a nhtoi ni hpe shagying ya ni ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shaloi ngai tsun ai gaw, Nye a Karai Wa e, Nye a prat hpungngang e, ngai hpe hkum la kau et; Na a shaning ni prat mi hte prat mi rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang gaw moi moi e, ginding aga hpe gaw da nna, Sumsing lamu, na a lata a amu rai nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai ni hten wa ma timung, nang agrin nga ndai; Yawng gaw hpun nba zawn dingsa mat ma ai; Nang dai hte hpe nba zawn galai kau nna, Dai ni galai mat ma ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang chyawm gaw dinggrin anga nga nna, Na a shaning ni htum ngu ai n nga ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na a ali ama ni a kashu kasha ni, anga nga na ma ai rai nna, Shanhte a matu mara ni, na a man e agrin nga na mara ai.
  </para>
  <chapter number="103" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit masin e, Yehowa hpe sha-a nga u, Nye kraw lawang mahkra e, shi a chyoi pra ai amying nsang hpe sha-a nga mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nye a myit masin e, Yehowa hpe sha-a nga u, Shi a chyeju yawng hte hpe hkum malap kau et.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a yubak yawng mayawng, shi raw kau ya ai, Na a ana ahkya mahkra hpe shamai ya nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a asak hpe nsung hku hta na shi hkye hkrang la nna, Chyeju hte n-gaw nwai ai nang hpe shagup ya nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw, kalang zawn, ram prat bai pra lu hkra, na a aprat hpe mai kaja ai hte shakat nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa gaw dingman ai bungli galaw nga ai rai nna, Zingri hkrum mahkrum ni hpe dawdan ya nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw shi a lam Mawshe hpe, shi a lai len ni, Israela kashu kasha ni hpe, madun dan ya manu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw matsan dum ai, sumnung ai, galu kaba nna, Nachying n-gaw nwai ai myit, rawng nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi tutnawng e a daru nga ai n rai, Shi prat dingsa e a pawt nga na n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anhte a yubak hte maren, shi bai tai mi ai n rai. Mara lu ai hte maren, anhte hpe ari jaw mi ai, n rai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lamu gaw aga hta tsaw nga ai hte maren, Shi a n-gaw nwai myit, shi hpe hkrit kamyin ai ni a ntsa e, a galu kaba nga lu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sinpraw maga gaw, sinna maga hte tsan nga ai hte maren, Shi anhte a yubak hpe anhte hte shatsan kau ya mi ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kawa gaw kasha ni hpe matsan dum lama ai zawn, Yehowa gaw shi hpe hkrit kamyin ai ni hpe matsan dum lama nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Anhte a hkum tsawp hpe shi chye ya nga ai, Anhte ga nhpu rai nga ga ai hpe, shi dum nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Masha a nhtoi gaw tsingdu zawn rai nga ai, Pa e tu ai nampan hte maren shi pu nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a ntsa e nbung ahpawt jang, shi n nga ai, Shi a shara pyi, shi hpe bai n chye lu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa hpe hkrit kamyin ai ni a ntsa e, Shi a chyeju gaw chyaloi nhkoi kaw nna prat dingsa du hkra, anga nga ai rai nna;
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi a ga shaka hpe hkan nang ai ni hte, Shi a ga matsun ni hpe dum galaw ai ni a ntsa e, Shi a dinghpring ai gaw, shu mashi shu masha prat du hkra, anga nga na ra ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Yehowa gaw lamu ntsa e, shi a tingnyang shadun tawn nna, Shi a mungdan shara shagu hkan e chyam nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />N-gun ja nna, shi a mungga nsen madat let, Shi a mungga hpe shadik ya ai lamu kasa ni e, Yehowa hpe sha-a mu.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi ra ai hku hkan nang nna, shi a magam bungli, gun hpai ai zaw nawng zaw wa yawng hte e, Yehowa hpe sha-a mu.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi a mungdan shara shagu hkan e, hpan hpajang da mada ni e, Yehowa hpe sha-a mu: Nye a myit masin e, Yehowa hpe sha-a nga u law.
  </para>
  <chapter number="104" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit masin e, Yehowa hpe sha-a nga u; Nye a Karai Kasang Yehowa e, Nang nachying galu kaba rai nga ndai; Arawng hte hpung shingkang nang bu hpun nga ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nhtoi hpe nba zawn nang hpun lawai nga ndai, Sumsing lamu hpe hpajawng zawn, nang kahpyen da nu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a gawk madung gaw hka hta shi tawn da nu ai; Sumwi hpe shi a leng ni shi shatai nu ai; Nbung a singkaw hta shi hkawm nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nbung hpe shi a kasa shi shatai nna, Shi a ali ama ni grung ai wan shinglet rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aga hpe de a npawt hta shi gaw da nu ai, Dai gaw htani htana e shamu shamawt rai na n rai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hpe nba hte zawn, hka hte nang magap da nna, Bum ni a ntsa e, hka lim nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang daru jang, dai ni hprawng mat ma ai, Na mu ngoi ai nsen majaw, dai ni lawan mat wa ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bum ni tsaw wa ma ai, kadit ni nem wa ma ai. Nang tawn da ai shara hta, dai ni grin nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dai ni nlai lu ai lamu ga jarit nang tawn da nna, Aga hpe magap na, dai ni nhtang wa lu ma ai n rai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw hkaraw ni hta, hka shi jahpaw dat nu ai: Bum ni a lapran e, dai ni lwi nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dai ni gaw pa na ashu ashan ni yawng hpe shalu mu ai. Nam na lawze ni hpang gara yang, hkru hkra lu lu ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ntsa malen na u ni dai ni a makau e shanu nga nna, Lakung lakying ni hta e, shaga kashai nga ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a gawk ni hta nna, bum ni hpe shi ntsin jaw mu ai; Na a bungli a asi hta e lamu ga hkru kat nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aga hta na lusha lu la mu ga, shi gaw, yamnga ni a matu tsingdu, Masha a matu nsi naisi, shatut ya mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tsabyi jahku masha a myit hpe shapyaw ya nga ai, Shi a myi man namman hte htoi nga ai: Ashat mung masha a myit hpe shadaw ya nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa a hpun ni, rai sa, shi hkai da nga ai, Lebanon a arit hpun ni, hkru kat nga ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai hta e u ni tsip tsip nga ma ai; U kawp ni marau hpun ntsa e shanu nga ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tsaw ai bum ni ya ni a shanu shara, Lungpu ni du dumsi ni a makoi shara, rai nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ladaw da nga na matu shata hpe tawn da wu ai. Jan mung, shi a shang na aten chye nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nsin hpe nang shasin nna shana tai nga ai, Dai shaloi maling na matse labye yawng, pru hkawm ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hkanghkyi hkalung ni shan amya na shabam nna, Karai Wa kaw tinang a shahpa tam ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jan bai pru jang, shanhte nhtang mat wa nna, Tinang a shanu ai shara hta, hpum nga ma ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi masha wa gaw, amu galaw na pru sa nna, Shana de du hkra, bungli hta noi nga nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa e, na a amu gade law la nga a hka! Nang mahkra hte hpe, hpaji hte galaw nu ai; Aga gaw, nang hpan da ai arai hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Wora kaba nna dam nga ai nawng hta e, Kadai n dang hti lu hkra kanawng hkawm ai baw, Nga amyu kaji kaba mung, nga nga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dai hta e sanghpaw li ni hkawm nna, Nang hpan da ai baren mung pyau nga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aten du jang, shanhte hpe shahpa jaw ru ga, Nga nna, nlang hte gaw nang hpe mada nga ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nang jaw nna shanhte hkap la ma ai, Nang lata hpaw nna, shanhte mai kaja ai hte hkru kat lu ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nang myi man kayin mat nna, shanhte myit ru ma ai, Shanhte a nsoi nsa nang dawm la jang, shanhte si wa nna, Tinang a nhpu hta bai nhtang mat wa ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na a nsoi nsa shapraw dat ai hte nang shanhte hpe hpan da nna, Lamu ga hpe bai gram nu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yehowa a arawng sadang htani htana anga nga u ga, Yehowa, shi a amu bungli hta, kabu nga u ga.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lamu ga hpe shi mada yu nna, dai gari nga ai, Bum ni hpe shi ahtawk nna, dai ni wan nhkut hku ma ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ngai hkrung nga ai hte yang, Yehowa hpe ngai mahkawn na nngai, Ngai naw nga yang, nye a Karai Wa hpe ngai mangoi na nngai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nye a myit htang ai ga hta, shi awng nga u ga, Ngai mahtang Yehowa hta kabu na nngai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yubak kap ai ni dinghta ga hta na htum mat nna, Tara n lang ai ni hpang de n pra lu mu ga! Nye a myit masin e, Yehowa hpe sha-a nga u. Halelu-Yah.
  </para>
  <chapter number="105" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa a chyeju hpe shakawn mu, Shi a amying nsang hpe shaga mu: Shi a amu bungli, amyu baw ni hpe tsun dan mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi hpe mahkawn mu, shi hpe mangoi mu, shi a mauhpa amu nlang hte hkai dan mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a chyoi pra ai amying hta kabu gumrawng nga mu: Yehowa hpe tam ai ni a myit masin kabu nga malu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa hte shi a n-gun atsam hpe tam san mu; Shi a myi man hpe tutnawng e hkan tam mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a mayam Abraham a aru arat hte e, Shi lata la ai Yaku a kashu kasha ni e,
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi galaw dan sai lamik kumla bungli hte, shi a mauhpa magam, shi n-gup na pru ai tara hpe, adum nga mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi Yehowa gaw anhte a Karai Kasang rai nga ai: Ga ting hta e shi a tara dara ai ga, pru nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham hte tawn da nga nna, Isak hpe dagam shagrin da ai ga shaka ngu ai,
  </para>
  <para style="p">
    <verse number="9" style="v" />Prat hkying mi a matu hkang da ai mungga hpe, Shi prat dingnawng e adum nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Hkanan mung hpe na a sali wunli jarit matu, Ngai nang hpe jaw na nngai,” nga ai ga gaw,
  </para>
  <para style="p">
    <verse number="11" style="v" />Yaku hte ga madat shi tawn da nna, Israela hta prat dingsa na ga shaka shatai nu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte hpe hti yu na mi garai n ra, Amyu kaji naw rai nga nna, dai mung e shingbyi nga ma yang,
  </para>
  <para style="p">
    <verse number="13" style="v" />Amyu mi hta na amyu mi de, Mung mi kaw nna mung mi de, htawt hkawm ma ai shaloi e,
  </para>
  <para style="p">
    <verse number="14" style="v" />Shanhte hpe zingri na shi n hkraw nga ai rai nna, shanhte a majaw hkawhkam hpe pyi ari jaw nu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Nye a namman chya hkam ai ni hpe hkum hkra myit, Nye a myihtoi ni hpe hkum shatsang myit,” nga nna shi tsun nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shaloi dai mung hta e n-gawn hku wa shabyin dat nna, lusha a npawt yawng hpe jahten kau mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shanhte a shawng e, marai langai mi hpe shi shangun dat wu ai; Mayam tai na, Yawsep gaw dut kau ai hkrum nu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa, shi hpe chyam yu ai ga hte, Shi htai dan ai ga dik wa ai aten du hkra,
  </para>
  <para style="p">
    <verse number="19" style="v" />Shanhte gaw shi a lagaw hpe hkang hkyihkyang hte, Shi a myit masin hpe hpri hte zingri zingrat mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shaloi hkawhkam wa gaw shi hpe raw kau nna, Amyu ni hpe up ai du, shi hpe dat dat wu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shi a hkringmang ni hpe gyit mayu yang gyit na, Shi a agyi salang ni hpe hpaji sharin ya na,
  </para>
  <para style="p">
    <verse number="22" style="v" />Shi a nta a madu shi hpe tawn da nna, Shi a sutgan yawng a ntsa e, du shatai nu ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shing rai Israela gaw Egutu mung de du nna, Yaku gaw Ham a mung hta e shingbyi nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shi a amyu hpe grai mayat maya wa shangun nna, shanhte a hpyen ni hta n-gun grau shaja mu ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bai shi shanhte hpe shi a ali ama ni hpe hkalem sha na, Shi a amyu hpe n dawng na, shadut mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shi a mayam Mawshe hte, Shi lata la ai Arun hpe, shi shangun dat mu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shanhte a man e shi a lamik kumla shan madun dan nna, Ham a mung hta e, mauhpa amu galaw ma ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nsin hpe shi dat nna shasin nu ai: shan gaw shi a ga hte shai lu ma ai n rai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hka hpe asai shatai nna, dai hta na nga ni hpe jasi kau wu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Shanhte a mung de shu li shawa dat nna, Hkawhkam a gawk hta pyi shang ma ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Shi tsun da jang, jinghkam du nna, mung ting hta machyi ut rai nga ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Marang a malai sin jahkrat dat nna, Shanhte a mung hta e, wan rawt nga ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Shanhte a tsabyi ru hte maihpang hpun ni hpe hkra nna, Mung ting na hpun shagu agrawp mat ma ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shi tsun jang, dinggam-yaw du nna, N dang hti lu ai nkangkawt chyat rai nga ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mung ting na shatmaw shatmai lap hpe, sha kau nna, Pa na nsi naisi hpe mung sha kau mu ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai hpang, shi gaw shanhte a shawng na n-gun, Mung na kasha alat yawng hte hpe, sat kau mu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shi a masha ni hpe aja, gumhpraw hte shapraw woi wa nna, Shi a amyu hta kataw ai mi n nga ma ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shanhte pru wa yang, Egutu masha ni kabu nga ma ai: kaning rai nme law, shanhte dai ni hpe hkrit da mu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Shingnip tai na shi sumwi hpe hpyan ka-up nna, Shana e, wan jahtoi ya mu ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shanhte hpyi nna shi u preng dat dat ya mu ai, Lamu na shat hte shanhte hpe shakat ya mu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lunghkung hpe shi hpaw nna, ntsin pru nga ai; Hkraw ai shara e hka zawn, dai lwi nga ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Kaning rai nme law, shi tsun da ai chyoi pra ai ga hte, Shi a mayam Abraham hpe shi dum nga ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shi a amyu hpe kabu gara ai hte, shi lata la ai ni hpe, Garu jahtau ai hte, shi shapraw wa mu ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shi a ga madat matsing nga nna, Shi a jep ai tara hkan nang nga mu ga,
  </para>
  <para style="p">
    <verse number="45" style="v" />Masha amyu ni a mungdan, shi shanhte hpe jaw da nna, Shanhte a sali wunli matu, amyu baw ni a bungli hta, shanhte shang lu ma ai. Halelu-Yah.
  </para>
  <chapter number="106" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe shakawn kungdawng mu: Yehowa gaw mai kaja nga ai majaw, chyeju dum mu; Shi a chyeju htani htana e anga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa a n-gun amu hpe, kadai gawn dan lu a ta? Shi hpe shakawn ai ga yawng hte, kadai madun lu a ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Dingman ai tara dara ai lam hkan nang nna, Ding ai bungli tut tut a galaw nga ai ni gaw, a nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang lata la ai ni a ngamai ai lam ngai mu lu na hte, Na a amyu a kabu gara ai hta ngai mung kabu lu nna, Na a sali wunli hte shakawn kungdawn nga lu n ga,
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, na a amyu hpe karum ai chyeju hte ngai hpe dum ya nna, Na a hkye hkrang la ai lam ngai hpe madun dan ya e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Anhte gaw ji woi ni hte rau yubak galaw ga ai, Anhte shut hpyit nna, tara tawt lai saga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Egutu mung na anhte a ji woi ni, Na a mauhpa bungli hpe, mung n yu nna, Na a kaba la ai chyeju hpe, n dum ma ai rai nna, Dai hkyeng ai Nawng makau e pyi gumlau nga ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai timung, shi a daru magam dan hkung wa u ga, Shi mying nsang a matu, shi shanhte hpe hkye hkrang la mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hkyeng ai Nawng hpe shi daru kau nna, dai gaw hkyet mat wa ai; Shi shanhte hpe hkarang e zawn, dai sung ai shara e, woi rap wa mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />N dawng ai ni a lata na, shi shanhte hpe hkye hkrang la nna, Gumlau ni a lata na, shanhte hpe mawai la mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hka leng ni shanhte a hpyen ni hpe ka-up kau mu ai, Langai mi muk n ngam mat ma ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shaloi shanhte gaw shi a ga hpe kamsham nna, Shi a arawng hpe shakawn kungdawn ma ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gade n na yang shanhte gaw shi a amu hpe malap kau ya mu ai, Shi hpaji daw ai lam hpe, n myit yu ma ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nam mali hkan e, shanhte myit marin la nga nna, Shingran katsi ai shara e, Karai Wa hpe dinglik yu ma ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shanhte hpyi ai lam, shi shadik ya mu timung, Shanhte hpe lasi lamun di shangun mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dai dap hkan e nga ai shaloi, shanhte Mawshe hte, Yehowa a chyoi pra ai Arun hpe manawn mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lamu ga mahka wa nna Dahtan hpe mayu kau wu ai; Abiram a hpung hpe makoi magap kau mu ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte a hpung hta e, wan nat mu ai rai nna, Wan nli gaw tara n lang ai ni hpe hkru kau mu ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Horeb makau e shanhte dumsu kasha hpe shachyaw nna, Jaw la ai sumla hpe nawku ma ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shing rai shanhte gaw tinang a arawng hpe, Tsingdu sha ai usu a sumla hte, galai kau mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Egutu mung hta e, amu kaba galaw ai, Ham a shara e, mauhpa bungli shapraw ai,
  </para>
  <para style="p">
    <verse number="22" style="v" />Hkyeng ai Nawng makau e, hkrithpa nsam shabyin ai, shanhte a hkye hkrang la ai Karai Wa hpe, shanhte malap mali kau mu ai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Shaloi shanhte hpe jahten na shi maw nga ai: Rai timung, shi lata la ai Mawshe gaw Shi a man e tsap nga nna, shanhte hpe n jahten mu ga, Shi a myit hpe shakawp ya wu ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai pyaw ai mungdan hpe, shanhte matsat kau mu ai, Shi a ga hpe mung n kam n sham ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tinang a sum hta, shanhte wu wu di di rai nga nna, Yehowa a nsen hpe n madat mu ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shaloi dai nam hkan e, shanhte hpe jahkrat kau na, masha amyu ni hta, shanhte a kashu kasha ni hpe shabra kau nna,
  </para>
  <para style="p">
    <verse number="27" style="v" />Mung shagu hta shanhte hpe shaden kau na, Nga nna shanhte hpe shi a lata sharawt da wu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bala Peura hpe shanhte manoi nna, Si ai wa hpe nawng ai hkungga sha ma ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Shanhte a amu majaw masin pawt pru nna, Shanhte hpe ana zinli e zingri mu ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai shaloi Hpinaha rawt dawdan nna, Dai ana zinli hkoi mat wa ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dai hpe tutnawng, prat mi hte prat mi, Shi hpe dinghpring ai zawn, nawn da mu ai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bai, Meriba makau e, shanhte gumlau nna, Shanhte a majaw Mawshe mung, ra rawng mat ai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kaning rai nme law, shi a wenyi hpe shanhte shatsang ya nna, Shi gaw shi a n-gup hte ga shut kau wu ai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shanhte gaw Yehowa htet da ai hte maren, Masha amyu ni hpe atsai awai n di kau mu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Masha amyu ni hte shanhte kayau kaya rai nga nna, Shanhte a htung hking hpe sharin la ma ai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Dai ni a sumla ni hpe mung shanhte nawku nna, Dai gaw shanhte a mahkam tai wa masalu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte gaw tinang a shayi shadang sha ni hpe, Nat ni hpe nawng ya kau mu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mara n rawng ai asai, shanhte ru kau mu ai: Hkanan a hpara sumla ni hpe ru jaw mu ai asai gaw, Tinang a shayi shadang sha ni a asai nan rai nga ai: Shing di nna mungdan hpe asai hte wu kau mu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tinang a bungli majaw, shanhte n san n seng wa ma ai, Shanhte a arawn alai majaw tinang dai shut hpyit nga ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shaloi Yehowa shi a amyu hpe myit kahtet nga nna, Shi a sali wunli hpe matsat kau wu ai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Masha amyu ni a lata hta, shi shanhte hpe ap ya nna, Shanhte hpe n dawng ai ni, shanhte a ntsa e up mu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shanhte hpe gumlau ai ni shanhte hpe zingri zingrat nna, Dai ni a lata npu e, shanhte gum nga ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shi law law lang shanhte hpe mawai la mu timung, Shanhte daw lu ai hpaji, gumlau hku hkrai rai nga ai: Dai majaw tinang a mara hta shanhte grit mat wa ma ai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Rai timung, shanhte a jahtau ai ga na ya mu yang, Shi shanhte a ru tsang ai hpe mu ya mu ai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shanhte hte tawn da ai ga shaka shi dum nna, Shi a chyeju kaba hte shanhte hpe, matsan bai dum mu ai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Shanhte hpe rim mat wa ai ni hpe mung, Matsan dum chye na lam, hpaw ya mu ai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Anhte a Karai Kasang Yehowa e, anhte hpe hkye hkrang la mi; Na a chyoi pra ai amying hpe shakawn kungdawn nna, Nang hpe shakawn ai hta nlaw nga lu hkra, Masha amyu ni hta na, anhte hpe shinggyin la mi law.
  </para>
  <para style="p">
    <verse number="48" style="v" />Israela Karai Kasang Yehowa gaw, Htani htana prat dingsa e, a nga u ga law! Masha amyu shagu, Amen, nga mu ga. Halelu-Yah.
  </para>
  <chapter number="107" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw mai kaja nga ai majaw, shi a chyeju dum mu; Shi a chyeju htani htana e anga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa a majaw mawai la ai hkrum ai ni, Gumlau ni a lata na mawai la ai hkrum nna,
  </para>
  <para style="p">
    <verse number="3" style="v" />Sinpraw sinna, dingdung dingda, Mung shagu hta na shinggyin la ai hkrum ai ni, Ning nga nna a tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte gaw nam mali hkan na katsi katsang re ai lam hta e, brak hkawm nga ma ai rai nna, Shanu nga lu na mare n mu mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kawsi hpang kara hkrum nna, Shanhte a myit masin htum mat ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi shanhte gaw tinang a ru tsang ai hta e, Yehowa hpe hpyi jahtau mu ai rai nna, Shi gaw nni nkri yawng hta na, shanhte hpe shaw dat mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte shanu nga lu na mare de, du lu mu ga, Malang ai hku e shanhte hpe woi wa mu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw shinggyim masha ni hpe galaw dan ai, mauhpa bungli hte, Shi a chyeju majaw, shi hpe shakawn kungdawn nga mu ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kaning rai nme law, hpang kara hkrum ai myit masin hpe, shi jahkru ya nna, Kawsi hkrum ai myit masin hpe, kaja ai hte shakat ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Karai Wa a ga hte nhtan shai nna, Tsaw Htum ai Wa a ga madat hpe roi kau mu ai majaw,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nsin hte si ai shingnip hta dung nga nna, Nni nkri hte, hpri sumri e gyit da ai hkrum nga yang,
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte a myit masin hpe yak la ai amu hta, Shi naw shagrit ya mu ai rai nna, Shanhte kataw yang, karum ai wa n nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shaloi shanhte gaw tinang a ru tsang ai hta e, Yehowa hpe hpyi jahtau mu ai rai nna, Shi gaw nni nkri yawng hta na, shanhte hpe shaw dat mu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nsin hte si ai shingnip hta na shi shanhte hpe shapraw dat nna, Shanhte hpe hkang ai sumri gang dut kau ya mu ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yehowa gaw shinggyim masha ni hpe galaw dan ai mauhpa amu hte, Shi a chyeju majaw, shi hpe shakawn kungdawn nga mu ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Magri chyinghka ni hpe shi agrawp kau nna, hpri htinggrang ni hpe kahtum kadaw di kau nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Myit n su ai ni, tinang a shut hpyit ai hte, Yubak galaw nga ma ai majaw, nji nmu hkrum ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shanhte hpa shahpa hpe mung matsat kau nna, Si hkrung si htan chyinghka de ni wa ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shaloi shanhte gaw tinang a ru tsang ai hta e, Yehowa hpe hpyi jahtau mu ai rai nna, Shi gaw nni nkri yawng hta na, shanhte hpe shaw dat mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi a mungga shi dat dat nna, shanhte hpe shamai mu ai, dai nhkun hta na shanhte hpe shalawt dat mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa gaw shinggyim masha ni hpe galaw dan ai mauhpa amu hte, Shi a chyeju majaw, shi hpe shakawn kungdawn nga mu ga.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shanhte gaw shakawn hkungga nawng jaw nna, kabu gara ai nsen hte shi a bungli hpe hkai dan nga mu ga.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nammukdara hta sanghpaw li hte hkawm ai ni, Hka kaba ni a ntsa e, amu galaw ai ni,
  </para>
  <para style="p">
    <verse number="24" style="v" />Yehowa a amu bungli hte, Sung ai shara na shi a mauhpa amu hpe, mu ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi htet da ai majaw, nbung laru ru wa nna, Hka leng ni rawt hta ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shanhte gaw htaw lamu de lung wa nna, Le sung ai de bai yu wa ma ai: yak la ai majaw, shanhte a minla byaw mat malu ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyaru nang ai wa zawn, shanhte ndi nda rai hkawm nna, shanhte a hpaji nlang mak mat malu ai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shaloi shanhte gaw tinang a ru tsang ai hta e, Yehowa hpe hpyi jahtau mu ai rai nna, Shi gaw nni nkri yawng hta na, shanhte hpe shaw dat mu ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai nbung laru hpe, bung li sha shatai dat nna, hka leng ni sim mat ma ai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dai sim mat ai majaw, shanhte kabu nna, Tinang ra ai daru de, shi shanhte hpe woi wa mu ai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Yehowa gaw shinggyim masha ni hpe galaw dan ai mauhpa amu hte, Shi a chyeju majaw, shi hpe shakawn kungdawn nga mu ga.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shawa masha ni a ka-ang e shi hpe shagrau nna, Salang ni a hpawng hta, shi hpe shakawn nga mu ga.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mung masha ni a n hkru ai amu majaw, Shi gaw hka nu ni hpe zaibru jang,
  </para>
  <para style="p">
    <verse number="34" style="v" />Hka hpaw ai shara hpe ga jahkraw, Sau rawng ai ga hpe krin ai shara, shatai nu ai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Bai shi gaw zaibru jang hpe hka hpung-ya, Hkraw ai shara hpe hka hpaw ai shara shatai nna,
  </para>
  <para style="p">
    <verse number="36" style="v" />Kawsi ai ni hpe dai yang e nga shangun mu ai: Nga na mare mung shanhte de manu ai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shanhte yi galaw nna tsabyi sun hkai da mu ai, Nsi naisi hpe mung, shu da mu ai.
  </para>
  <para style="p">
    <verse number="38" style="v" />Shi shanhte hpe shaman ya nna, shanhte nachying mayat maya ma ai: shanhte a yamnga ni mung jat wa malu ai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dai hpang zingri ai, ru tsang ai hte yawn hkyen hkrum ai majaw, shanhte yawm wa nna, grit mat wa ma ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Du ni hpe kaya kahpa jahkrum nna, Lam n hku ai katsi katsang nga ai shara e, Shanhte hpe brak hkawm shangun ai wa gaw,
  </para>
  <para style="p">
    <verse number="41" style="v" />Matsan ai ni hpe ru tsang ai hta na shalawt dat nna, Shanhte a dap ni hpe, sagu hpung zawn shatai mu ai.
  </para>
  <para style="p">
    <verse number="42" style="v" />Myit malang ai ni dai hpe mu lu nna kabu nga ma ai. N hkru ai ni mung tinang a n-gup pat kau ma ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hpaji rawng ai wa kadai rai timung, ndai amu hpe myit yu nna, Yehowa a chyeju hpe dum nga mu ga law.
  </para>
  <chapter number="108" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Kasang e, nye a myit ngang kang nga ai: ngai mahkawn mangoi nna, tingse dum na nngai; Rai sa, nye a arawng dai galaw na ra ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tingse hte sumpyi ni e, dum hprang mu, jahpawt manap hpe mung, ngai jasu na we ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, masha amyu ni hta, ngai nang hpe shakawn na nngai; Amyu baw ni hta, ngai nang hpe tingse dum na nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, na a chyeju lamu du hkra, Na a sadi sahka sumwi kaw du hkra, lep nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Karai Kasang e, sumsing lamu hta nang grau tsaw nga u ga; Aga ting hta e, na a hpung shingkang dan hkung nga u ga;
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a tsawra ai ni lawt lu mu ga, Na a hkra lata hte hkye la nna, anhte hpe htan ya mi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karai Kasang shi a chyoi pra ai hte tsun dan ai gaw, “Ngai kabu na nngai; Shehkem hpe ngai karan na we ai; Suhkot kadit hpe ngai shadawn na we ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Geliad hte Manashe nye a rai nga ma ai; Ehprim gaw nye a baw magap, Yuda, nye a hkawhkam sumdoi rai nga ma ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moba nye a lagaw kashin ai di rai nga ai; Edom hta nye a kyepdin ngai kabai tawn na we ai: Hpilisti mung a matu, ngai garu nga nngai.”
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai ngang ai mare hta e, ngai hpe kadai jashawn na rai nga a ta? Edom de ngai hpe kadai woi shang na rai nga a ta? nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Karai Kasang e, nang anhte hpe kau da nit dai, n rai ni? Karai Kasang e, anhte a luksuk ni hte rau, nang n pru sa ndai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ru tsang ai hta na anhte hpe karum la mi, Masha karum ai lam kaman sha rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Karai Kasang hte anhte nlaw lu na ga ai; Shi anhte a hpyen ni hpe kabye kau na mu ai.
  </para>
  <chapter number="109" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai shakawn kungdawn nga ai Karai Kasang e, atsin sha hkum nga nga et.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, tara n lang ai wa a n-gup hte, Hkalem sha ai wa a n-gup, hpaw nga malu ai; Masu ai shinglet ni nye a lam a tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw n dawng n yawt ai ga hte, ngai hpe kawan da mi ai rai nna, mara n nga timung, ngai hpe hpyen galaw ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a tsawra ai malai, ngai hpe nhtan shai ai hku hkan galaw ma ai: Ngai chyawm gaw akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte gaw kaja ai malai n kaja ai, Tsawra ai a malai, n dawng n yawt ai, ngai hpe bai htang ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi a ntsa e, tara n lang ai wa hpe san da u ga; Shi a hkra maga e, mara shagun ai wa tsap nga u ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi hpe dawdan ai shaloi, shi ari hkrum u ga; Shi a akyu hpyi ai ga, yubak tai u ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a nhtoi gadun lu ga, Shi a aya hpe masha kaga lu la u ga.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi a kashu kasha ni jahkrai nmai, Shi a madu jan mung, gaida gaina tai nga mu ga.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi a kashu kasha ni hpyi sha let brak hkawm mu ga. Shanhte a tsam mat ai nta hta nna, shahpa tam mu ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gumhpraw boi ai wa, shi a arai yawng kashun la nna, masha tsasam ni, shi galaw ai arai hpe shanyen la ya mu ga.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shi hpe chyeju madun ai wa n nga u ga: Shi a jahkrai nmai ni hpe matsan dum ai wa n nga u ga.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi a aru arat htum mat u ga, Hpang e pra wa ai ni hta, shanhte a amying mat mat malu ga.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi kaji ni a mara hpe Yehowa adum nga u ga; Shi kanu a yubak hpe n raw dat lu u ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dai gaw, Yehowa a man e tut tut anga nga nna, ga hta na shanhte a masat dingsat shaprai kau u ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi hkum nan matsan dum na lam n chye nna, Nni nkri hkrum nna matsan mayan ni hte, Gawng run hkrum ai ni hpe si hkra, zingri zingrat manu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rai sa, shi gaw dagam na lam tsawra nna, dai gaw shi hpang de, bai nhtang nga ai; shaman ai lam n tsaw ai majaw, dai gaw shi hte tsan gang nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi gaw dagam ai hpe hpun palawng zawn, bu hpun nna, Dai gaw ntsin zawn shi a kraw lawang kata e, Namman zawn, shi a nrut nra du hkra, hkawn nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shing rai, dai gaw, bu hpun ai hpun palawng hte, Tut tut kyit nga ai shingkyit zawn, rai nga u ga.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai hpe hpyen ai ni hte, nye a lam n hkru ai ga tsun ai ni, Yehowa kaw na, shing re ai shabrai lu la mu ga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a Madu Yehowa e, nang chyawm gaw, na a amying majaw, ngai hpe lanu lahku la e; Na a chyeju mai kaja nga ai majaw, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaning rai nme law, ngai nni nkri hkrum nna, matsan mayan rai nga nngai; Nye a kraw na myit achyaw machyi nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mat mat wa ai shingnip zawn ngai lai wa nna, Dinggam-yaw hpe zawn, gawn kau ai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lusha gam ai majaw, nye a lahput gari nga nna, Nye a hkum shan lasi lamun rai nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shanhte a matu shatan shara ngai rai nga nngai, Shanhte ngai hpe mu jang, baw kanga ma ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nye a Karai Kasang Yehowa e, ngai hpe karum la e, Na a chyeju hte maren, ngai hpe hkye la e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa e, dai gaw na a lata a bungli rai nga nna, dai nang galaw nit dai gaw, shanhte chye mu ga.
  </para>
  <para style="p">
    <verse number="28" style="v" />Shanhte dagam ma timung, nang gaw shaman ya e; Shanhte rawt ma yang shanhte kaya kahpa hkrum ma ai; na a mayam wa chyawm gaw, kabu gara rai nga ai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai hte nhtan shai ai ni, myi man sum ai bu hpun nna, Kaya kahpa nba zawn, shanhte hpe htinggrum mu ga.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nye a n-gup hte, Yehowa hpe ngai nachying shakawn nna, Masha hpawng hta e, shi hpe kungdawn na nngai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaning rai nme law, shi gaw matsan ai wa a asak hpe, dawdan ai ni a lata na hkye la na, Shi a hkra maga e, a tsap nga na ra ai.
  </para>
  <chapter number="110" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa nye a madu hpe tsun wu ai gaw, “Na a gumlau ni hpe, na a lagaw kabye ai lahkum ngai shatai ai du hkra, Nye a hkra maga e naw adung nga u,” nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa gaw na a up hkang na sumdoi, Ziun kaw nna jaw dat na ndai: Nang gaw, nang hpe gumlau ai ni a ka-ang e a up nga u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a hpyen majan shani e, na a amyu masha ni gaw Chyoi pra ai hte mawn sumli let, hkan nang mayu nga ma ai; jahpawt manap jau jau na mari zawn, Na a brang ram ni nang kaw du na mara ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa dagam da ndai gaw: “Nang gaw Melhkizekek a hkringhtawng lam hte maren, Htani htana hkinjawng rai nga ndai,” ngu ndai rai nna, myit bai kayin na n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a hkra maga e nga ai Madu gaw, Shi a masin pawt ai nhtoi hta e, Hkawhkam ni hpe shanyawp kau na mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw masha amyu ni hpe dawdan na mu ai; shanhte hta e moi mang hpring nga ai; Mung law law ni a baw hpe shi agrawp kau na wu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lam makau e lwi ai hka shi hta na shi lu na ra ai; Dai majaw shi gaw baw sharawt na ru ai.
  </para>
  <chapter number="111" style="c" />
  <para style="p">
    <verse number="1" style="v" />Myit malang ai ni a salang bawng hta e mung, Dai shawa hpawng hta e mung, nye a myit masin mahkra hte, Ngai Yehowa hpe shakawn kungdawn na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa a amu bungli kaba la nga ai, dai amu hta awng nga ai ni nlang, dai lam hkan tam gawn nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a bungli arawng sadang hte hpung shingkang rai nga ai; Shi a dinghpring ai gaw, prat dingsa e anga nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a mauhpa amu hpe matsing lu na matu, Shi gaw masat dingsat tawn da nu ai; Yehowa gaw matsan dum ai hte chyeju jaw na myit rawng nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi gaw shi hpe hkrit kamyin ai ni hpe lusha jaw mu ai; Shi a ga shaka hpe shi galoi mung adum nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masha amyu ni a sali wunli shi a amyu hpe jaw kau ai majaw, Shi gaw shi a amu a n-gun, shanhte hpe madun dan mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a lata a amu sadi sahka hte tengman ai, rai nga ai; Shi a ga matsun ni nlang tengman nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ni gaw htani htana agrin nga ai rai nna, Sadi sahka hte malang ai hku hkan nna a byin nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gaw shi a amyu hta hkye hkrang la ai lam shangun dat wu ai; Shi a ga shaka htani htana e dinggrin rai nga ai; Shi a amying chyoi pra ai hte hkrithpa rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa hpe hkrit hkungga ai myit gaw, Hpaji byeng-ya a npawt rai nga ai; Dai hpe hkan nang ai ni nlang hte gaw, myit su ai lam kaja chye lu ma ai: Shi hpe shakawn kungdawn ai lam, htani htana e agrin nga ai.
  </para>
  <chapter number="112" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe hkrit hkungga nna, Shi htet da ai ga hta e, awng nga ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a matu mara ni lamu ga hta e kaba wa na mara ai; Myit malang ai ni a aru arat, shaman ai lu la na maru ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aja, sutgan shi a nta e anga nga ai rai nna, Shi a dinghpring ai gaw gamhpa agrin nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Matsan dum chye ai, n-gaw nwai ai hte dinghpring ai nhtoi, Myit malang ai ni a matu mara nsin hta e dan pru na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Alu jaw nna, hkoi ya ai wa gaw, mai kaja nga ai, Tara dara ai nhtoi hta e, shi a amu tai na ra ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw prat dingsa e shamu shamawt hkrum na n rai; Dinghpring ai wa hpe galoi mung adum nga na maru ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />N kaja ai shiga hpe shi n hkrit wu ai; Shi a myit Yehowa hta hpa nga nna, ngang nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a myit ngang kang nga ai rai nna, Shi hpe gumlau ai ni yubak hkrum nga ai mu lu ai du hkra, shi n hkrit nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shi gat hkai nna matsan mayan ni hpe gam jaw mu ai, Shi a dinghpring ai gaw htani htana anga nga ai; Shi a nrung arawng hte rawt nga lu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tara n lang ai wa gaw dai hpe mu nna manawn nga ai; Wa utik let shi nga nna, byawng mat wa na ra ai. Tara n lang ai ni a ra ai hku hten mat na ra ai.
  </para>
  <chapter number="113" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa a ali ama ni e, shakawn mu, Yehowa a amying nsang hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ya kaw nna htani htana du hkra, Yehowa a amying ningsang, a nga lu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jan pru kaw nna jan shang kaw du hkra, Yehowa a amying hpe shakawn shara rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw masha amyu nlang a ntsa e, Shi a hpung shingkang lamu ntsa e, tsaw nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Htaw ntsa e shi a dung tingnyang rai nga timung, Lamu hte aga a arai guji guyang yu yu na,
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi a hkum hpe shagrit shanem wu ai, Anhte a Karai Kasang Yehowa zawn, kadai wa rai nga a ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi gaw sut n lu ai ni hpe nhpu hta na sharawt la mu ai; Matsan mayan ni gaw du salang ni a makau e,
  </para>
  <para style="p">
    <verse number="8" style="v" />Rai sa, shi a amyu a du salang ni a makau e, Dung nga mu ga, wan dap hta na, shanhte hpe sharawt la mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Maudung num gaw dinghku jan tai wa nna, Kabu gara ai myit hte shadang sha shangai na kanu, shatai wu ai. Halelu-Yah.
  </para>
  <chapter number="114" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israela masha ni Egutu mung hta na, Yaku a dap gaw gri magra ga ga ai amyu hta na, pru wa ma ai shaloi e;
  </para>
  <para style="p">
    <verse number="2" style="v" />Yuda ginwang shi a chyoi pra ai shara, Israela mung shi a ninghtawn, tai ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nammukdara gaw dai hpe mu nna hprawng wa ai. Yawdan hka mung, nhtang mat wa ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bum ni gaw sagu la zawn, Kawng ni sagu kasha zawn, shingtawt ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nammukdara e, nang hpa majaw hprawng wa n ta? Yawdan hka e, nang hpa majaw nhtang mat wa n ta?
  </para>
  <para style="p">
    <verse number="6" style="v" />Bum ni e, sagu la zawn, Kawng ni e, sagu kasha zawn, hpa rai shingtawt hkawm nga myit ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ginding aga e, dai Madu a man e, Yaku a Karai Kasang a man e, gari ashun nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw lunghkrung hpe hka lawng, Nhpai lung hpe, hka hpaw shara shatai wu ai.
  </para>
  <chapter number="115" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, anhte hpe n rai, anhte hpe n rai: na a chyeju hte sadi sahka a majaw, Na a amying nsang hpe sha, arawng jaw u.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Shanhte a Karai Kasang ya kanang nga malu hka?” nga nna, masha amyu ni, hpa rai tsun na ma ta?
  </para>
  <para style="p">
    <verse number="3" style="v" />Anhte a Karai Kasang gaw sumsing lamu e anga nga ai; Shi ra ai hku yawng mayawng shi galaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shanhte a sumla ni, aja, gumhpraw, Masha a lata hte galaw ai arai, rai nga malu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shanhte n-gup tu, timung, n chye shaga ma ai, Myi tu, timung, n mu lu ma ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na tu, timung, n na lu ma ai, Ladi tu, timung, n chye manam ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte gaw lata hte n chye jum ma ai, Lagaw hte n chye hkawm ma ai: Shanhte a mayu hte nsen n chye shapraw ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dai ni tawk tawn ai ni hte, Shanhte hpe shamyet shanat ai ni yawng, Shanhte hte maren rai na mara ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israela e, Yehowa hpe shamyet shanat nga u; Shi gaw, shanhte a karum ai wa hte n-gang rai nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Arun a dap e, Yehowa hpe shamyet shanat nga u: Shi gaw shanhte a karum ai wa hte n-gang rai nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa hpe hkrit hkungga ai ni e, Yehowa hpe shamyet shanat nga mu; Shi gaw, shanhte a karum ai wa hte n-gang rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa gaw anhte hpe adum nga ai; shi anhte hpe shaman ya mi ai: Shi gaw Israela dap hpe shaman ya nga ai; Arun a dap hpe mung shaman ya nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shi gaw Yehowa hpe hkrit hkungga ai ni, Kaji kaba yawng hpe, shaman ya nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa gaw nanhte hte, nanhte a kashu kasha ni hpe, Law htam wa shangun malit ga.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lamu hte aga hpe hpan da ai Yehowa gaw, Nanhte hpe shaman ya myit ga.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sumsing lamu gaw, Yehowa a lamu rai nga ai, Ginding aga hpe chyawm gaw, shinggyim masha ni hpe ap ya sai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Si mat ai ni hte, katsi katsang re ai shara de, yu hkrat wa ai ni, Yehowa hpe shakawn lu ma ai n rai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Anhte chyawm gaw, ya kaw nna, htani htana du hkra, Yehowa hpe shakawn kungdawn nga na ga ai. Halelu-Yah.
  </para>
  <chapter number="116" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw nye a akyu hpyi ai nsen, Madat ya nga ai majaw, ngai awng nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw ngai hpang de shi a na kayin dat wu ai rai nna, Ngai hkrung nga ai prat hte hta e, ngai shi hpe shaga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Si ai sumri ni ngai hpe kawan nga nna, Katsan ga na ru tsang ai ngai hpe lep ni ai: Ruyak ai hte nni nkri ngai hkrum nga nngai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai shaloi ngai gaw, O, Yehowa e, Nye a myit masin hpe mawai la ya e, Ngu nna, Yehowa a amying hpe, shaga we ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa gaw n-gaw nwai hte dinghpring nga ai, Anhte a Karai Kasang, matsan dum ai wa rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa gaw myit n su ai ni hpe bau sin nga ai; Ngai nni nkri hkrum yang, shi ngai hpe hkye la nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nye a myit masin e, Yehowa nang hpe chyeju madun nit dai majaw, Nang ban lu ai shara de bai wa su.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang gaw nye a myit masin hpe si ai kaw na, Nye a myi hpe myi prwi kaw na, Nye a lagaw hpe kashawt ai kaw na, shalawt dat ya ni ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Naw ahkrung nga ai ni a mung hta e, Ngai Yehowa a man e a hkawm nga na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Nni nkri ngai ja ja hkrum nga nngai,” nga nna tsun ai shaloi e pyi, ngai kamsham nga nngai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Masha nlang masu ai ni rai nga ma ai, Nga nna, n dum shami ngai tsun hkrup nngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa ngai hpe jaw ai chyeju nlang hte hpe, Ngai kaning di dang wa lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hkye hkrang la ngu ai gawm hpe ngai magra jum nna, Yehowa a amying hpe shaga na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nye a ga shaka, ngai Yehowa hpe raw na nngai, Shi a amyu masha ni a man e, ngai dai lam galaw na nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chyoi pra ai ni a si mat wa ai gaw, Yehowa a man e hpu la nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa e, na a shangun ma gaja wa ngai rai nga nngai: Na a nchyang jan a kasha ngu ai, Na a shangun ma ngai rai nga nngai: Ngai hpe gyit hkang ai sumri nang raw nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shakawn kungdawn hkungga ngai nang hpe jaw nna, Yehowa a amying ningsang hpe shaga na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nye a ga shaka, ngai Yehowa hpe raw na nngai: Shi a amyu masha ni a man e, Yehowa a nta a wang kata e,
  </para>
  <para style="p">
    <verse number="19" style="v" />Yerusalem e, na a ka-ang e, dai lam ngai galaw na nngai. Halelu-Yah.
  </para>
  <chapter number="117" style="c" />
  <para style="p">
    <verse number="1" style="v" />Masha amyu ni e, Yehowa hpe shakawn mu, Amyu baw nlang hte e, shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kaning rai nme law, shi a chyeju, Anhte a ntsa e kaba la nga ai rai nna, Yehowa a sadi sahka htani htana anga nga ai. Halelu-Yah.
  </para>
  <chapter number="118" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw mai kaja nga ai majaw, shi hpe shakawn kungdawn mu: Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a chyeju htani htana agrin nga ai, Nga nna Israela masha ni tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi a chyeju htani htana agrin nga ai, Nga nna Arun a dap ni tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a chyeju htani htana agrin nga ai, Nga nna Yehowa hpe hkrit kamyin ai ni tsun nga mu ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kyin dut ai shara kaw nna, ngai Yehowa hpe shaga nna, Dam lada re ai shara hta e, Yehowa ngai hpe htan ya nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa ngai hte rau rai nga ai: ngai hpa mung n hkrit nga nngai: Masha wa ngai hpe hpa di lu na a ta?
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa ngai hpe karum ai wa rai nga ai. Ngai hpe n dawng ai ni hta, ngai myit shatup lu na mawe ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa hta shingbyi nga ai gaw, Masha wa hpe shamyet nga ai hta, grau kaja nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa hta shingbyi nga ai gaw, Du ni hpe shamyet nga ai hta grau kaja nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Masha amyu ni yawng ngai hpe kawan da mi ai, Yehowa a amying hte ngai shanhte hpe manga kau na mawe ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shara shagu hkan e, shanhte ngai hpe wang da nga ma timung, Yehowa a amying hte ngai shanhte hpe manga kau na me we ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lagat zawn shanhte ngai hpe jawm mi ai; Ju hpun hkru ai wan zawn shanhte krip mat ma ai: Yehowa a amying hte ngai shanhte hpe manga kau na mawe ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai hpe jahkrat na, nang ngai hpe kanawng dat timung, Yehowa ngai hpe shadaw da nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa gaw, nye a n-gun hte mahkawn mangoi lam rai nga ai, Ngai hpe hkye hkrang la ai wa mung, shi rai nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dinghpring ai ni a sum ni hta e, Kabu gara ai hte hkye hkrang la ai nsen ngoi nga ai: Yehowa a hkra lata gaw nlaw nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yehowa a hkra lata sharawt da nga ai, Yehowa a hkra lata gaw nlaw nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai si wa na nngai n rai; Ngai naw ahkrung nga na rai nna, Yehowa a amu bungli hpe naw gawn dan na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa ngai hpe ari ahpri jaw timung, Si ai de ngai hpe ap kau ni ai, n rai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai shang lu nna, Yehowa a chyeju shakawn n ga, Nye a matu, dinghpring ai chyinghka ni hpaw da mu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ndai gaw, Yehowa a chyinghka rai nga ai: Dinghpring ai ni, shang lu na ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang ngai hpe htan ya nna, nye a hkye hkrang la ai lam, tai nga ndai majaw, Ngai nang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Wahpang gaw ai ni lata kau ai nlung gaw, Ningjut jahtum na nlung tai wa sai:
  </para>
  <para style="p">
    <verse number="23" style="v" />Dai gaw Yehowa a majaw byin nga ai: Anhte a man e mung mauhpa amu rai nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dai ni gaw, Yehowa tawn da ai nhtoi rai nga ai. Dai hta e, anhte kabu nna awng nga ga.
  </para>
  <para style="p">
    <verse number="25" style="v" />Yehowa e, ya hkye hkrang la mi law; Yehowa e, ya shaman ya mi law.
  </para>
  <para style="p">
    <verse number="26" style="v" />Yehowa a amying hte du sa ai wa gaw, a nga u ga; Yehowa a nta hta e, anhte nang hpe, sha-a nga ga ai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Yehowa gaw Karai Wa rai nga ai rai nna, anhte hpe jahtoi ya nga ai. Hkungri a nrung hta e, poi hkungga hpe, sumri hte gyit da mu.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nang gaw nye a Karai Wa rai nga ndai, Ngai nang hpe shakawn kungdawn na nngai; Nye a Karai Kasang e, Ngai nang hpe shagrau sha-a na nngai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Yehowa mai kaja nga ai majaw, Shi hpe shakawn kungdawn mu: Shi a chyeju htani htana agrin nga ai law.
  </para>
  <chapter number="119" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tinang a lam hta mara n rawng ai ni hte, Yehowa a tara hpe hkan nang ai ni, a lu ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a sakse ga hpe matsing nga nna, Myit yawng hte shi hpe hkan tam ai ni, a lu ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw n hkru ai amu n galaw ma ai, Shi a lam hta e, hkawm nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na a ga matsun hpe htep lahti hkan lu mu ga, Nang anhte hpe htet da nit dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a ga madat hpe hkan nang lu hkra, Nye a lam ding nga u ga!
  </para>
  <para style="p">
    <verse number="6" style="v" />Shaloi nang htet da mada hpe dum nga yang, Ngai kaya kahpa n hkrum na nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a dinghpring ai tara dara ai lam hpe sharin yang, Myit malang ai hku hkan nna, ngai nang hpe shakawn na nngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na a ga madat ngai hkan nang na nngai, Ngai hpe hkum kabai kau et.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shabrang wa gaw, shi a lam pra nga u ga, kaning rai na rai ta? Na a mungga hte maren sadi nga yang, rai na ra ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye myit mahkra hte, ngai nang hpe tam ni ai; Nang htet da ai ga hpe ngai n lai n ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai nang hpe n shut n hpyit n ga, Na a ga hpe, nye a myit hta, ngai bang da se ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yehowa e, nang a lu ndai, Na a ga madat, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na n-gup na tara dara ai hku yawng hte hpe, Nye a nten hte, ngai hkai dan na nngai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sutgan lu la ai hta grau nna, Na a sakse ga hta, ngai kabu nga nngai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na a ga matsun hpe, ngai myit aru nga nna, Na a lam shagu hpe yu nga na nngai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a ga madat hta e, ngai awng nga nna, Na a mungga hpe n malap kau na nngai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na a mayam wa hkrung nga u ga, shi hpe yu lahku u; Shaloi na a mungga hpe, ngai hkan nang na nngai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na a tara hta mauhpa lam mu lu n ga, Nye a myi hpe jahpaw ya e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ga ntsa e, manam sha ngai rai nga nngai, Na a htet da ai ga, nye a man e, hkum makoi da u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nang tara dara ai lam hpe, myit marit nga nngai majaw, Nye a myit masin ahkying shagu ndawt nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang gaw gumrawng ai ni hpe, daru kau nit dai; Nang htet da ai ga hpe tawt lai ai ni, dagam kau ai hkrum ma ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na a sakse ga hpe, ngai hkan nga nngai majaw, Shatan nhkan hte asawng asang re ai hta na, ngai hpe shalawt dat e.
  </para>
  <para style="p">
    <verse number="23" style="v" />Du salang ni nye a lam bawng ma timung, Na a mayam wa na a ga madat hpe a myit yu nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na a sakse ga, ngai awng shara hte, Ngai hpe hpaji daw ya ai ga, rai nga ma ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nye a myit masin ga nhpu hta a jung nga ai: Na a ga hte maren ngai hpe jahkrung ya e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nye a lam ngai hkai dan nngai rai nna, nang ngai hpe htan ya nit dai; Na a ga madat, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na a ga matsun ngai hpe chye na shangun e, Shaloi, na a mauhpa amu hpe ngai myit yu nga na nngai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Yawn la nngai majaw, nye a myit masin hkrap nga ai; Na a ga hte maren, ngai hpe sharawt la e.
  </para>
  <para style="p">
    <verse number="29" style="v" />Masu ai lam ngai hte shatsan kau ya nna, Matsan dum let, na a tara ngai hpe jaw e.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sadi sahka ai lam ngai lata la ni ai, Na a tara dara ai hku, ngai dum nga nngai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na a sakse ga hta ngai a noi nga nngai; Yehowa e, ngai hpe kaya kahpa hkum hkrum shangun et.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nye a myit hpe nang hpaw ya ndai majaw, Nang htet da ai lam de, ngai gat nga nngai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yehowa e, na a ga madat lam ngai hpe sharin ya e; Prat htum hkra, ngai dai hpe hkan nang na nngai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chye chyang ai myit ngai hpe jaw rit law; Shaloi na a tara hpe myit ting hte hkan nang na nngai.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nang htet da ai lam hku e, ngai hpe woi wa e; Dai hta e ngai awng nga na nngai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nye a myit lawhpa ai de n rai u ga, Na a sakse ga hpang de, dai hpe kayin ya e.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kaman lila hpe n mu n ga, nye a myi kayin la ya e: Na a lam hta ngai hpe jahkrung da e.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nang hpe hkrit hkungga na, nga ai ga sadi, Na a mayam a ntsa e, shadik ya e.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ngai hkrit nga we ai, shatan nhkan hpe la kau u; Na a tara dara ai lam mai kaja nga ai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Yu u, na a ga matsun ni hpe ngai marit nga nngai, Na a dingman ai hte ngai hpe jahkrung da e.
  </para>
  <para style="p">
    <verse number="41" style="v" />Yehowa e, na a chyeju hte hkye hkrang la ai lam, Na a ga hte maren, ngai kaw du u ga.
  </para>
  <para style="p">
    <verse number="42" style="v" />Shaloi, na a ga hta shamyet nga nngai majaw, Ngai e shatan ai wa hpe htan lu na we ai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Na a tara dara ai lam hpe kam nga nga nngai majaw, Nye a n-gup hta na, sadi sahka ai ga hpe hkum dawm la u.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shaloi htani htana prat dingsa e n hprai hkra, Na a tara hpe ngai hkan nga na nngai.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na a ga madat hpe ngai tam nga nngai majaw, Numdaw numdan n hkrum ai, ngai hkawm sa lu nngai.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hkawhkam ni a man e na a sakse ga hpe, Ngai hkai dan nna, kaya kahpa n hkrum na nngai.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ngai tsawra ai, na a jep ai tara hta, Ngai ngwipyaw nga na nngai.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ngai tsawra ai, na a jep ai tara hpe, Nye a lata ngai sharawt na we ai rai nna, Na a ga madat hpe a myit yu nga na nngai.
  </para>
  <para style="p">
    <verse number="49" style="v" />Ngai hpe myit mada shangun ai majaw, Na a mayam wa hpe nang tsun ai ga, adum nga u.
  </para>
  <para style="p">
    <verse number="50" style="v" />Na a ga hte ngai bran nga nngai, Dai gaw nye a nni nkri hta e, ngwipyaw shara tai wa ai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Gumrawng ai ni, ngai hpe ja ja jahpoi ma timung, Na a tara hpe ngai n lai nga nngai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Yehowa e, chyaloi nhkoi na, na a dawdan ai hpe, Ngai dum nga nna, ngwipyaw nga nngai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Na a tara hpe kau da nga ai n hkru ai ni a matu, Ngai myit ja ja kahtet nga nngai.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ngai manam rai nga ai nta hta e, Na a ga madat, nye a mahkawn ga tai nga ai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Yehowa e, shana aten e, na a amying hpe ngai dum nga nna, Na a tara hkan nga na nngai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Na a ga matsun hpe matsing nga nngai majaw, Dai hta ngai pyaw nga nngai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Yehowa e, nye a sali wunli nang rai nga ndai; Na a mungga hpe hkan nang na, ngai myit da ni ai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Nye a myit mahkra hte, ngai nang hpe hpyi nga nngai; Na a ga hte maren, ngai hpe matsan dum la e.
  </para>
  <para style="p">
    <verse number="59" style="v" />Nye a lam hpe ngai myit yu nga nna, Na a sakse ga hpang de, kayin wa nngai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Na a sakse ga hpe hkan nang nga na, Ngai n ganung, alawan rai nga nngai.
  </para>
  <para style="p">
    <verse number="61" style="v" />Tara n lang ai ni a sumri ngai hpe kawan nga timung, Na a tara hpe ngai n malap kau nngai.
  </para>
  <para style="p">
    <verse number="62" style="v" />Na a dingman ai tara dara ai lam majaw, Nang hpe shakawn na, ngai yuptung e rawt na nngai.
  </para>
  <para style="p">
    <verse number="63" style="v" />Nang hpe hkrit kamyin ai ni mahkra hte, Na a ga matsun hpe hkan ai ni a manang, ngai rai nga nngai.
  </para>
  <para style="p">
    <verse number="64" style="v" />Yehowa e, ga ntsa e, na a chyeju hte hpring nga ai; Na a ga madat ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="65" style="v" />Yehowa e, na a ga hte maren, Na a mayam wa hpe nang kaja ai lam galaw nit dai.
  </para>
  <para style="p">
    <verse number="66" style="v" />Nang htet da ai ga ngai kam nga nngai majaw, Kaja ai hpaji hte chye chyang ai lam, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="67" style="v" />Nni nkri garai n hkrum yu yang, ngai lam dam ni ai; Ya chyawm gaw, na a ga hpe ngai hkan nga nngai.
  </para>
  <para style="p">
    <verse number="68" style="v" />Nang kaja nga nna, kaja ai amu galaw nga ndai; Na a ga madat ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="69" style="v" />Gumrawng ai ni ngai hpe masu ai ga shatu ma timung, Ngai gaw myit mahkra hte na a ga madat a hkan nga nngai.
  </para>
  <para style="p">
    <verse number="70" style="v" />Sau zawn shanhte a myit ge mat malu ai; Ngai chyawm gaw na a tara hta e, awng nga nngai.
  </para>
  <para style="p">
    <verse number="71" style="v" />Na a ga madat ngai sharin la lu na, Nye a matu nni nkri hkrum na, mai nga ai.
  </para>
  <para style="p">
    <verse number="72" style="v" />Na n-gup hta na pru ai tara gaw, nye a matu Aja gumhpraw hkying mi hta grau kaja nga ai.
  </para>
  <para style="p">
    <verse number="73" style="v" />Na a lata ngai hpe hpan da nna hkrang shabyin nu ai; Nang htet da ai ga hpe, ngai sharin la lu hkra, Ngai hpe chye chyang ai myit jaw ya e.
  </para>
  <para style="p">
    <verse number="74" style="v" />Na a ga hpe ngai myit mada nga nngai majaw, Nang hpe hkrit kamyin ai ni, Ngai hpe mu yang, kabu lu na mara ai.
  </para>
  <para style="p">
    <verse number="75" style="v" />Yehowa e, na a tara dara ai lam, dingman nga ai rai nna, Sadi sahka hte nang ngai hpe sharin ndai hpe, ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="76" style="v" />Na a mayam wa hpe tsun da ai hte maren, Na a chyeju gaw, ngai hpe shapyaw ya u ga.
  </para>
  <para style="p">
    <verse number="77" style="v" />Na a tara, ngai awng wa na lam rai nga ai majaw, Ngai hkrung nga lu hkra, na a chyeju ngai kaw du u ga.
  </para>
  <para style="p">
    <verse number="78" style="v" />Gumrawng ai ni ngai hpe masu kau mi ai majaw, Shanhte kaya kahpa hkrum na mara ai; Ngai chyawm gaw na a ga matsun hpe myit yu nga nngai.
  </para>
  <para style="p">
    <verse number="79" style="v" />Nang hpe hkrit kamyin ai ni hte, na a sakse ga hpe chye lu ai ni, Ngai hpang de kayin wa maru ga.
  </para>
  <para style="p">
    <verse number="80" style="v" />Ngai kaya kahpa n hkrum n ga, Na a ga madat hta e nye a myit tsup nga li ga.
  </para>
  <para style="p">
    <verse number="81" style="v" />Nye a myit masin, na a hkye hkrang la ai lam hpe marit nga ai; na a mungga hpe ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="82" style="v" />“Nang ngai hpe galoi shapyaw na n kun?” nga nna, Na a ga ndat mada lu hkra nye a myi tsu nga li ai.
  </para>
  <para style="p">
    <verse number="83" style="v" />Wan nhkut hta garau ai shanhpyi htingpa zawn, ngai tai mat nngai rai timung, Na a ga madat hpe ngai n malap kau nngai.
  </para>
  <para style="p">
    <verse number="84" style="v" />Na mayam wa a nhtoi ni, gade gadun nga a hka! Ngai hpe zingri ai ni e, Nang galoi me dawdan na mu ta?
  </para>
  <para style="p">
    <verse number="85" style="v" />Gumrawng nna na a tara hpe n hkan nang ai ni, Nye a matu nhkun htu ma ai.
  </para>
  <para style="p">
    <verse number="86" style="v" />Na a jep ai tara nlang, sadi sahka rai nga ai: Masu let shanhte ngai hpe hkan shachyut ma ai; ngai hpe karum la e.
  </para>
  <para style="p">
    <verse number="87" style="v" />Shanhte gaw lamu ga hta e ngai hpe ganoi noi jahten ma timung, Na a ga matsun hpe ngai n kau da nngai.
  </para>
  <para style="p">
    <verse number="88" style="v" />Na a chyeju hte maren, ngai hpe shabran ya e, Shaloi na a sakse ga hpe ngai hkan nga na nngai.
  </para>
  <para style="p">
    <verse number="89" style="v" />Yehowa e, htani htana e na a mungga gaw, Sumsing lamu hta e agrin nga ai.
  </para>
  <para style="p">
    <verse number="90" style="v" />Na a sadi sahka prat mi hte prat mi anga nga ai, Aga hpe nang gaw da nna, dai anga nga ai.
  </para>
  <para style="p">
    <verse number="91" style="v" />Dai ni jang, na a tara hte maren, dai arai ni anga nga ma ai, Arai yawng mayawng na a ali ama ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="92" style="v" />Na a tara nye a kabu gara ai lam n rai taw gaw, Nye a nni nkri hta e, ngai hten byak na ni ai.
  </para>
  <para style="p">
    <verse number="93" style="v" />Na a ga matsun hte ngai shabran ai hkrum nngai majaw, Dai hte hpe ngai galoi mung n malap kau na nngai.
  </para>
  <para style="p">
    <verse number="94" style="v" />Na a ga matsun hpe ngai tam nngai majaw, Na a ma ngai rai nga nngai: ngai hpe hkye la e.
  </para>
  <para style="p">
    <verse number="95" style="v" />Tara n lang ai ni, ngai hpe jahten na hkap nga ma ai; Na a sakse ga hpe ngai myit yu nga nngai.
  </para>
  <para style="p">
    <verse number="96" style="v" />Lam magup hta e, tsup lu na hku ngai mu se ai; Nang htet da ai ga dam lada wa rai nga ai.
  </para>
  <para style="p">
    <verse number="97" style="v" />Na a tara hpe ngai kade wa tsaw nga n hka! Ngai shani tup dai hpe myit aru nga nngai.
  </para>
  <para style="p">
    <verse number="98" style="v" />Nang htet da ai ga majaw, ngai gaw gumlau ni hta grau nna hpaji lu nga nngai; Kaning rai nme law, dai gaw prat dingsa e ngai hta a rawng nga ai.
  </para>
  <para style="p">
    <verse number="99" style="v" />Na a sakse ga hpe ngai myit aru nga nngai majaw, Ngai sharin la ai sara ni yawng hta, ngai grau nna chye lu nngai.
  </para>
  <para style="p">
    <verse number="100" style="v" />Na a ga matsun ga hpe ngai hkan nga nngai majaw, Salang ni hta grau nna ngai myit su nga nngai.
  </para>
  <para style="p">
    <verse number="101" style="v" />Na a mungga hpe hkan nang lu na matu, Ngai n kaja ai lam yawng hpe koi kau nga nngai.
  </para>
  <para style="p">
    <verse number="102" style="v" />Nang ngai hpe sharin ya ndai majaw, Na a tara dara ai lam na ngai n lai nga nngai.
  </para>
  <para style="p">
    <verse number="103" style="v" />Na a mungga gaw gade dwi nga a hka! Nye a n-gup hta lagat jahku hta grau dwi nga ai.
  </para>
  <para style="p">
    <verse number="104" style="v" />Na a ga matsun hte ngai myit su nga nngai; Dai majaw masu ai lam shagu ngai n dawng nga nngai.
  </para>
  <para style="p">
    <verse number="105" style="v" />Na a mungga nye a lagaw a pyengdin hte, Nye a hkrun lam a nhtoi rai nga ai.
  </para>
  <para style="p">
    <verse number="106" style="v" />Na a dingman ai tara dara ai lam hpe hkan nang na, Ngai dagam da nna galaw ngut se ai.
  </para>
  <para style="p">
    <verse number="107" style="v" />Ngai nni nkri law law wa hkrum nga nngai, Yehowa e, na a ga hte maren ngai hpe shalan ya e.
  </para>
  <para style="p">
    <verse number="108" style="v" />Yehowa e, nye a n-gup a dingsa hkungga hpe hkap la u, Na a tara dara ai lam ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="109" style="v" />Nye a myit masin gaw nye a lata hta anga nga li timung, Na a tara hpe ngai malap mali kau na nngai n rai.
  </para>
  <para style="p">
    <verse number="110" style="v" />Tara n lang ai ni nye a matu mahkam hkam ma timung, Na a ga matsun hpe ngai n shut nga nngai.
  </para>
  <para style="p">
    <verse number="111" style="v" />Na a sakse ga nye a myit hpe shapyaw ya ai majaw, Dai gaw prat dingsa nye a sali wunli rai nga ai.
  </para>
  <para style="p">
    <verse number="112" style="v" />Na a ga madat htani htana a galaw nga na, Nye a myit masin hpe ngai saw da we ai.
  </para>
  <para style="p">
    <verse number="113" style="v" />Gale galau re ai ni hpe ngai n dawng nngai; Na a tara hpe chyawm gaw ngai tsawra nga nngai.
  </para>
  <para style="p">
    <verse number="114" style="v" />Nang gaw nye a makoi shara hte n-gang rai nga ndai; Na a mungga hpe ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="115" style="v" />N hkru ai ni e, ngai kaw na pru wa mu; Nye a Karai Kasang a htet da ai ga hpe ngai hkan nang na nngai.
  </para>
  <para style="p">
    <verse number="116" style="v" />Ngai hkrung nga lu nna, Nye a myit mada ai lam kaya kahpa n tai u ga, Na a ga hte maren ngai hpe shadaw ya e.
  </para>
  <para style="p">
    <verse number="117" style="v" />Ngai hpe shadaw yang, ngai mai wa na nngai; Shaloi na a ga madat hpe ngai tut tut a myit nga na nngai.
  </para>
  <para style="p">
    <verse number="118" style="v" />Na a ga madat hta na tawt lai ai ni hpe, nang n yawt nga ndai, Kaning rai nme law, shanhte a maw ai hku, masu ai hkrai rai nga ma ai.
  </para>
  <para style="p">
    <verse number="119" style="v" />Mung shagu na tara n lang ai ni hpe, Hkumpup hpe zawn, nang lai kau da mu ai: Dai majaw na a sakse ga hpe ngai tsawra nngai.
  </para>
  <para style="p">
    <verse number="120" style="v" />Nang hpe hkrit hkungga ai hte nye a ashan nshung si bun nga ai; Na a tara dara ai hpe mung ngai hkrit kamyin nga nngai.
  </para>
  <para style="p">
    <verse number="121" style="v" />Tara ai hte dingman ai lam ngai galaw se ai; Zingri ai ni kaw, ngai hpe hkum ap kau u ga.
  </para>
  <para style="p">
    <verse number="122" style="v" />Na a mayam wa a ngamai lu na matu ama hkam u; Gumrawng ai ni ngai hpe n zingri lu mi ga.
  </para>
  <para style="p">
    <verse number="123" style="v" />Na a hkye la ai lam hte dingman ai ga hpe, Nye a myi mada nna, atsu nga li ai.
  </para>
  <para style="p">
    <verse number="124" style="v" />Na a chyeju hte maren, na a mayam wa hpe galaw nna, Na a ga madat ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="125" style="v" />Ngai na a mayam wa rai nga nngai; Na a sakse ga hpe ngai chya lu n ga, Chye chyang ai myit ngai hpe jaw ya e.
  </para>
  <para style="p">
    <verse number="126" style="v" />Yehowa a matu amu galaw ai aten rai nga ai: Na a tara hpe shanhte hpa n nawn nga ma ai.
  </para>
  <para style="p">
    <verse number="127" style="v" />Dai majaw aja hte jet ai aja hta grau nna, Na a htet da ai ga hpe ngai tsaw nga nngai.
  </para>
  <para style="p">
    <verse number="128" style="v" />Dai majaw na a ga matsun nlang teng nga ai, ngai nga nna, Masu ai lam shagu hpe n dawng kau nngai.
  </para>
  <para style="p">
    <verse number="129" style="v" />Na a sakse ga mauhpa wa rai nga ai; Dai majaw nye a myit masin dai hta hkan nang nga ai.
  </para>
  <para style="p">
    <verse number="130" style="v" />Na a mungga hpe hpaw dan yang, nhtoi htoi wa nna, Myit n su ai ni hpe, kunghpan wa shangun mu ai.
  </para>
  <para style="p">
    <verse number="131" style="v" />Na a htet da ai ga hpe ngai marit la nga nngai majaw, Ngai n-gup mahka nga nna, sa dawn dawn nga nngai.
  </para>
  <para style="p">
    <verse number="132" style="v" />Na a amying hpe tsawra ai ni hpe nang di ang ai hte maren, Ngai kaw kayin nna, ngai hpe matsan dum la e.
  </para>
  <para style="p">
    <verse number="133" style="v" />Nye a lagaw hkang hpe na a ga hte shangang ya e; N shawp ai hpa mung, ngai hpe n up u ga.
  </para>
  <para style="p">
    <verse number="134" style="v" />Masha a kashun kashe hta na, ngai hpe shalawt dat e; Shaloi na a ga matsun hpe ngai hkan na nngai.
  </para>
  <para style="p">
    <verse number="135" style="v" />Na a mayam wa ntsa e, na a myi man jahtoi ya u ga; Na a ga madat hpe mung, ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="136" style="v" />Shanhte na a tara hpe n hkan ma ai majaw, Nye a myi kaw na hka zawn lwi nga ai.
  </para>
  <para style="p">
    <verse number="137" style="v" />Yehowa e, nang dinghpring nga ndai rai nna, Na a tara dara ai lam ni malang nga ai.
  </para>
  <para style="p">
    <verse number="138" style="v" />Na a sakse ga hpe dingman nga ai hte, Nachying sadi sahka rai nga u ga, nang htet da nu ai.
  </para>
  <para style="p">
    <verse number="139" style="v" />Ngai hpe hpyen ai ni na a mungga hpe malap kau ma ai majaw, Nye a nja nhpra ai myit ngai hpe shaza kau nngai.
  </para>
  <para style="p">
    <verse number="140" style="v" />Na a ga nachying jet nga ai rai nna, Na a mayam wa dai hpe tsawra nga ai.
  </para>
  <para style="p">
    <verse number="141" style="v" />Ngai gaw kaji nga nna hpa n ging nngai rai timung, Na a ga matsun hpe ngai n malap nngai.
  </para>
  <para style="p">
    <verse number="142" style="v" />Na a dingman ai gaw, prat dingsa e dingman nga ai rai nna, Na a tara gaw sadi sahka rai nga ai.
  </para>
  <para style="p">
    <verse number="143" style="v" />Ru tsang ai hte yawn hkyen ai ngai hkrum nngai rai timung, Na a htet da ai ga nye a kabu ga shara rai nga ai.
  </para>
  <para style="p">
    <verse number="144" style="v" />Na a sakse ga prat dingsa a teng nga lit dai; Ngai hkrung lu n ga, ngai hpe chye chyang ai myit jaw ya e.
  </para>
  <para style="p">
    <verse number="145" style="v" />Nye a myit mahkra hte ngai shaga nga nngai; Yehowa e, ngai hpe htan ya e; Na a ga madat hpe ngai hkan nang nga na nngai.
  </para>
  <para style="p">
    <verse number="146" style="v" />Na a sakse ga hpe ngai madat lu n ga, Nang hpe shaga yang, ngai hpe hkye hkrang la e.
  </para>
  <para style="p">
    <verse number="147" style="v" />Nhtoi garai n htoi yang, ngai jahtau nga nngai, Na a mungga hpe ngai myit mada nga nngai.
  </para>
  <para style="p">
    <verse number="148" style="v" />Shana na ladaw garai n lai lu yang, Na a ga hpe myit htang yu na ngai hprang nga nngai.
  </para>
  <para style="p">
    <verse number="149" style="v" />Na a chye hte maren, nye a nsen madat ya e; Yehowa e, na a tara dara ai hku hte maren, ngai hpe shalan shabran ya e.
  </para>
  <para style="p">
    <verse number="150" style="v" />N hkru ai myit rawng ai ni, sit ni wa ma timung, Na a tara hte shanhte tsan nga ma ai.
  </para>
  <para style="p">
    <verse number="151" style="v" />Yehowa e, nang gaw ni nga ndai; Na a htet da ai ga nlang tengman nga ai.
  </para>
  <para style="p">
    <verse number="152" style="v" />Na a sakse ga htani htana agrin nga ai hpe, Moi kaw nna ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="153" style="v" />Na a tara hpe ngai n malap kau nngai majaw, Nye a nni nkri yu nna, ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="154" style="v" />Nye a amu hpe jeyang nna ngai hpe hkye hkrang la e; Na a ga hte ngai hpe shalan shabran ya e.
  </para>
  <para style="p">
    <verse number="155" style="v" />Tara n lang ai ni, na a ga madat hpe n tam ma ai majaw, Hkye hkrang la ai lam shanhte hte tsan nga ai.
  </para>
  <para style="p">
    <verse number="156" style="v" />Yehowa e, na a chyeju law htam nga ai; Nang dawdan ai lam hte maren, ngai hpe shalan shabran ya e.
  </para>
  <para style="p">
    <verse number="157" style="v" />Ngai hpe zingri ai ni hte hpyen ni law nga ma ai; Na a sakse ga hte ngai shai nga nngai n rai.
  </para>
  <para style="p">
    <verse number="158" style="v" />Hkalem sha ai ni na a mungga hpe n hkan nang ai majaw, Ngai shanhte hpe mu mada nna, myit yu machyi nga nngai.
  </para>
  <para style="p">
    <verse number="159" style="v" />Na a ga matsun hpe ngai tsaw nga nngai, dum nu; Yehowa e, na a chyeju hte maren ngai hpe shalan shabran ya e.
  </para>
  <para style="p">
    <verse number="160" style="v" />Na a ga sumhpa, sadi sahka rai nga ai; Na a dingman ai tara dara ai lam, htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="161" style="v" />Mara n nga timung, du ni ngai hpe hkan shachyut ma ai; Rai timung, nye a myit na a ga hpe hkungga nga ai.
  </para>
  <para style="p">
    <verse number="162" style="v" />Lanep law law lu ai wa zawn, Na a ga hta ngai kabu gara nga nngai.
  </para>
  <para style="p">
    <verse number="163" style="v" />Masu ai ga hpe ngai ndang nna matsat nga nngai; Na a tara hpe ngai tsawra nga nngai.
  </para>
  <para style="p">
    <verse number="164" style="v" />Na a dingman ai tara dara ai lam majaw, Lani mi hta e sanit lang, ngai nang hpe shakawn ga nngai.
  </para>
  <para style="p">
    <verse number="165" style="v" />Na a tara hpe tsawra ai ni gaw ngwipyaw kaba chye nga ma ai. Shanhte hta kadai mung myit kataw shara n nga ai.
  </para>
  <para style="p">
    <verse number="166" style="v" />Yehowa e, na a hkye hkrang la ai lam hpe ngai myit mada nga nna, Na a htet da ai ga hpe hkan nang nga nngai.
  </para>
  <para style="p">
    <verse number="167" style="v" />Nye a myit masin na a sakse ga hpe madat nga ai; Rai sa, dai hpe ngai ja ja tsawra nga nngai.
  </para>
  <para style="p">
    <verse number="168" style="v" />Na a ga matsun hte sakse ga hpe ngai madat nga nngai; Nye a lam yawng hte gaw na a man e rai nga ai.
  </para>
  <para style="p">
    <verse number="169" style="v" />Yehowa e, ngai jahtau ai ga, nang kaw du hkrang u ga; Na a ga hte maren ngai hpe shachye shachyang ya e.
  </para>
  <para style="p">
    <verse number="170" style="v" />Ngai hpyi jahtau ai ga, na a man e hkrang pru ga; Na a ga hte maren ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="171" style="v" />Nang gaw na a ga madat ngai hpe sharin nga yang, Nye a n-gup shakawn kungdawn ga shapraw na ra ai.
  </para>
  <para style="p">
    <verse number="172" style="v" />Nang htet da ai ga nlang, dingman nga ai majaw, Nye a shinglet na a ga hpe mahkawn mangoi na ra ai.
  </para>
  <para style="p">
    <verse number="173" style="v" />Na a ga matsun hpe, ngai lata la nngai majaw, Na a lata ngai hpe karum nga n ga.
  </para>
  <para style="p">
    <verse number="174" style="v" />Yehowa e, na a hkye hkrang la ai lam hpe ngai marit nga nna, Na a tara gaw ngai kabu shara rai nga ai.
  </para>
  <para style="p">
    <verse number="175" style="v" />Nye a myit masin hkrung nga lu nna, nang hpe shakawn nga u ga, Nang tara dara ai lam ngai hpe karum nga n ga.
  </para>
  <para style="p">
    <verse number="176" style="v" />Ngai lam dam mat wa yang, Mat ai sagu kasha hpe zawn, na a mayam wa hpe hkan tam u; Kaning rai nme law, nang htet da ai ga hpe ngai n malap kau nngai law.
  </para>
  <chapter number="120" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai ru tsang ai hta e ngai Yehowa hpe shaga nga nna, shi ngai hpe htan ya ni ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa e, nye a asak hpe, masu ai n-gup hte, Hkalem sha ai shinglet hta na, mawai la ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hkalem sha ai shinglet e, shi nang hpe hpa jaw na a ta? Shi nang hpe hpa naw bai htang na a ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Share wa a dai ai pala hte, Marau hpun na wan n-ga, nang hkrum na rin dai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Meshek shara hta e ngai shingbyi nga nna, Kedera sum ni a makau e naw nga nngai majaw, ngai dingnye lu nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngwipyaw lam hpe n dawng ai ni hte rau, Nye a myit masin nau nan na hkra wa nga nga sai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai ngwi ai lam ra nga nngai rai timung, Ngai ga tsun jang e, shanhte majan baw na maw ma ai.
  </para>
  <chapter number="121" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai gaw bum lang de mada yu na nngai; ngai hpe karum na gaw, kanang na pru na a ta?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lamu hte aga hpe hpan tawn da ai Yehowa kaw na, Ngai hpe karum ai lam pru wa ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shi gaw na a lagaw hpe kashawt shangun na, n rai; Nang hpe bau sin ai wa gaw yup wa ai n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yu mu, Israela hpe bau sin ai wa gaw, Yup nga, yup pyaw wa nga ai, n rai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa gaw nang hpe bau sin ai wa rai nga ai; Yehowa na a hkra lata a shingnip rai nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shani na ajan, shana na shata, nang hpe hkra lu na ndai n rai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa gaw ru tsang yawng hta na, nang hpe bau sin na ra ai; Na a myit masin hpe shi bau sin na ra ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw ya kaw nna prat dingsa e, Na a pru wa ai hte shang wa ai lam bau sin ya na ra ai.
  </para>
  <chapter number="122" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa a nta de anhte lung wa saga, Nga nna ngai hpe tsun nga ma yang, ngai kabu nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yerusalem e, na a chyinghka ni hta e, Anhte a lagaw tsap nga lu ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yerusalem e, ngang ai mare zawn, Nang hpe de da nit dai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israela sakse tai lu na hte, Yehowa a amying hpe shakawn kungdawn na matu, Amyu baw ni, Yehowa a amyu baw ni, dai de lung wa na ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, dai yang e tara tingnyang ni, Dawi a nta na tingnyang ni, shadun da mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yerusalem a ngwipyaw na lam matu hpyi nga mu: Nang hpe tsawra ai ni awng wa lu mu ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a bunghku kata e, ngwipyaw ai, Na a htingnu ni a kata e, awng wa na lam, hku nga u ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nye a hpunau ni hte jinghku ni a matu mara, Nang hta e ngwipyaw nga lu u ga, ngai tsun na nngai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anhte a Karai Kasang Yehowa a nta a majaw, Na a mai kaja na lam ngai tam na nngai.
  </para>
  <chapter number="123" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sumsing lamu hta e dung nga ai wa e, Nye a myi nang hpe a mada yu nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yu mu, mayam ni a myi, madu a lata hpe, Shingnan num a myi, madu jan a lata hpe, mada nga ma ai hte maren, Anhte a Karai Kasang Yehowa gaw, Anhte hpe matsan dum nga ai du hkra, Anhte a myi shi hpe a mada nga mali ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, anhte hpe matsan dum mi, matsan dum mi law; Kaning rai nme law, anhte gaw kaya kahpa nau hkrum la nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nhpaw n-ya re ai ni a aroi arip hte, Gumrawng ai ni a shatan nhkan hpe, Anhte a myit masin nau nan wa hkrum la sai.
  </para>
  <chapter number="124" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa anhte hte rau n nga taw gaw,
  </para>
  <para style="p">
    <verse number="2" style="v" />Masha ni anhte hpe gasat na rawt ma yang, Yehowa anhte hte rau n nga taw gaw:
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw anhte hpe masin pawt nna, Naw hkrung nga yang pyi, mayu kau na mi ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai hka leng ni anhte hpe lim kau nna, Hka nu ni anhte a asak hpe kaput na mi ai;
  </para>
  <para style="p">
    <verse number="5" style="v" />Gaja wa anhte a asak ntsa e, Kabrawng la ai hka nu ni, kaput na mi ai, Nga nna Israela masha ni ya tsun nga mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte a wa anhte hpe sha na matu, N jaw kau ai Yehowa gaw, a nga u ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mahkam hta na lawt lu ai u zawn, Anhte a myit masin lawt lu mali ai. Mahkam gaw dut mat nna, anhte lawt lu saga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lamu hte aga hpe hpan tawn da ai Yehowa a amying hta e, Anhte hpe karum ai lam anga nga ai.
  </para>
  <chapter number="125" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe shamyet shanat ai ni, n shamu nga ai Ziun bum zawn rai nga ma ai; Dai gaw htani htana anga nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bum ni gaw Yerusalem hpe grup di da mu ai hte maren, Yehowa mung, ya kaw nna prat dingsa e, Shi a amyu hpe grup di da mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dingman ai ni, n hkru ai amu hpe, tinang a lata hte n galaw lu mu ga, Tara n lang ai ni a up ai sumdoi, Dingman ai ni a sali wunli a ntsa e, mara lu na n rai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, mai kaja ai ni hte, Myit malang ai ni hpe, mai kaja ai myit madun u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Magaw ai lam de shang mat wa ai ni hpe chyawm gaw, Yehowa gaw yubak galaw ai ni hte rau, jahten kau mu ga: Israela ntsa e, ngwipyaw ai gaw anga nga u ga law.
  </para>
  <chapter number="126" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw Ziun a bawng dung ai ni hpe nhtang dat mu ai shaloi e, Anhte wa yup mang mu ai ni zawn, rai nga ga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai shaloi anhte a n-gup mani ai hte, Anhte a shinglet shakawn ai hte hpring nga ai: “Yehowa shanhte a matu bungli kaba galaw nu ai.” nga nna amyu masha ni tsun nga ma ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Rai sa, Yehowa anhte a matu bungli kaba galaw nu ai; Dai rai nna anhte kabu gara nga ga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, dingda maga na hka shi ni zawn, Anhte a bawng dung ai ni hpe, nhtang dat mi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Myi prwi hte gat hkai ai ni, Kabu gara let bai shu lu na mu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nli noihpye hpye let hkrap nna pru wa ai wa gaw, Hkauling lahkawn hpai nna, kabu gara ai hte bai wa na ra ai law.
  </para>
  <chapter number="127" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw dai nta hpe n gap da yang, Nta gap da ai ni kaman sha galaw kau na mu ai: Yehowa gaw dai mare hpe n sin yang, Bau sin ai ni kaman sha sin kau na mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jahpawt jau jau e rawt nna, Shana aten lai hkra, n sim n sa re ai hte, Hki ba let shat sha timung, kaman lila rai nga ai: Shi gaw dai lam shi a tsawra ai ni hpe naw yup nga ma yang, a jaw nga mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yu mu, kashu kasha gaw Yehowa jaw ai sali wunli rai nga ai; Kan a nsi naisi shabrai zawn, rai nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Share wa a lata na pala zawn, Prat ram yang na shadang sha ni rai nga ma ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shi a pala ndum, dai hta jahpring lu ai wa gaw, a nga ai: Mare chyinghka e gumlau ni hte ga tsun yang, Shanhte kaya kahpa hkrum na ma ai n rai.
  </para>
  <chapter number="128" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe hkrit hkungga nna, shi a lam hta hkan nang ai ni yawng hte gaw, a nga ma ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a lata a amu nang sha lu na ndai, nang a lu nna ngamai lu na ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na a nta kata e, na a madu jan gaw si si ai tsabyi ru zawn, rai nga ai; Na a nsha ni, hkai ai tsanlun hpun zawn, Na a sha ku grup yin e rai nga ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yu mu, Yehowa hpe hkrit hkungga ai wa gaw, Teng teng ning rai hkrum lu na ra ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa gaw Ziun hta na, nang hpe shaman ya nna, Nang hkrung nga ai nhtoi tup, Yerusalem a ngamai ai hpe nang mu lu n ga;
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a kashu kasha ni hpe mung, nang mu lu n ga: Israela ntsa e, ngwipyaw ai gaw anga nga u ga law.
  </para>
  <chapter number="129" style="c" />
  <para style="p">
    <verse number="1" style="v" />Brang ram prat kaw nna shanhte ngai hpe ja ja shatsang mi ai, Rai sa, brang ram prat kaw nna ngai hpe ja ja shatsang mi ai;
  </para>
  <para style="p">
    <verse number="2" style="v" />Rai timung, shanhte ngai hpe n dang ma ai, Nga nna Israela masha ni ya tsun nga mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hkauna shawt ai ni nye a shingma hta shawt nna, Htai hkang galu jahkang ya mi ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw dingman nga ai rai nna, tara n lang ai ni a sumri hpe shadut kau ya mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ziun hpe n dawng n yawt ai ni nlang hte gaw, Kaya kahpa hkrum nna, kanut mat wa mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Garai n baw yang, hkraw mat ai hte, Dan ai masha mung latup mi muk n lu la nna,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hkauling gyit ai wa n lahkawn la lu ai, Nta magaw na tsingdu zawn, shanhte rai nga mu ga.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Yehowa a shaman ai gaw, nanhte a ntsa e nga nga u ga, Yehowa a amying hte anhte nanhte hpe shaman ya ga ai,” nga nna lai hprang ai ni mung n tsun lu mu ga.
  </para>
  <chapter number="130" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, sung la ai shara de nna, Ngai nang hpe shaga nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Madu e, nye a nsen hpe madat mara ya e: Ngai akyu hpyi ai nsen hpe, Na a na hte na la nna matsing ya e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, nang mara matsing nga yang gaw, Madu e, kadai tsap nga lu na rai ta?
  </para>
  <para style="p">
    <verse number="4" style="v" />Rai timung, nang hpe hkrit hkungga nga mu ga, Nang gaw mara hpe raw dat kau ya ndai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa hpe ngai myit mada nga nngai. Rai sa, nye a myit masin myit mada nga ai; Shi a mungga hpe ngai ala nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jahpawt manap hpe ala nga ai ni hta grau, Rai sa, jahpawt manap hpe ala nga ai ni hta grau nna, Nye a myit masin gaw, dai Madu hpe ala nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israela e, Yehowa hpe ala nga u; Yehowa gaw chyeju myit rawng nga ai rai nna, Hkye hkrang la ai lam kaba shi hte rau rai nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw Israela hpe tinang a yubak nlang hta na hkye hkrang la na maru ai.
  </para>
  <chapter number="131" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nye a myit kaba nga ai n rai, nye a myi man mung dap nga ai n rai. Ngai hte n ging ai amu hpe ngai n bawng nna, Ngai hta grau ai mauhpa bungli ngai n tam nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gaja wa, chyu hka ai ma, kanu hte rau nga ai zawn, Nye a myit masin hpe, ngai jasim kau nna, atsin sha di da we ai: Nye a myit masin gaw chyu hka ai ma zawn, ngai hta rai nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israela e, ya kaw nna prat dingsa e, Yehowa hpe ala nga u.
  </para>
  <chapter number="132" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, Dawi a jaw e shi a ruyak ai nlang hte hpe, adum nga u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw, “Yehowa a matu nga ai htingra, Yaku a hpung shingkang wa a matu nga ai nta, Ngai garai n mu lu lu gaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a sum a nta hta e ngai n shang, Nye a yup ku ntsa de ngai n lung,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a myi yup n lu sha nna, Nye a myi, myi di lu na li ai n rai,”
  </para>
  <para style="p">
    <verse number="5" style="v" />Nga nna Yehowa hpe shi dagam da nna, Yaku a hpung shingkang wa hpe ndat ga, tawn da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai gaw Ehpra hta e nga nga ai, anhte na ga timung, Yaara prang ga e, dai hpe mu lu sagaw ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shi a sumpan nta de, anhte shang nna, Shi a lagaw a kabye lahkum e, anhte nawku saga.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, nang hte na a n-gun a Sumpu, Nang ban nga ai shara de, rawt sa wa u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a hkinjawng ni dinghpring ai hpe bu hpun nna, Na a chyoi pra ai ni kabu gara let jahtau nga mu ga.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na a mayam wa Dawi a myi man tau nna, Na a namman chya hkam ai wa a myi man hpe, hkum kayin kau ya u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa gaw Dawi hpe teng teng dagam da nna, Dai hta na nhtang wa na n rai: Na a aru arat hpe tingnyang hta e, ngai shadun na nngai:
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a nshu nsha ni nye a ga shaka hte, Shanhte hpe ngai sharin ya ai sakse ga hpe, hkan nang ma yang gaw, Shanhte a kashu kasha ni prat dingsa, Na a tingnyang ntsa e, dung nga lu na mara ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaning rai nme law, Yehowa gaw Ziun hpe lata la nna, Dai hta e dung nga na a ra nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw, nang e prat tup nye a sa ban shara rai nga ai; Dai hpe ngai tsaw nga nngai majaw, nang e ngai adung nga na nngai;
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi a lusha hpe ngai teng teng shaman ya nna, Shi a matsan mayan ni hpe shat hte jahkru na mawe ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shi a hkinjawng ni hpe hkye hkrang la ai lam hte ngai jahpun na mawe ai: Shi a chyoi pra ai ni gaw kabu gara ai hte jahtau na ma ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dai yang e Dawi a matu ngai nrung shatut nna, Nye a namman chya hkam ai wa a matu pyengdin shadun se ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Shi hpe gumlau ai ni ngai kaya kahpa hte htinggrum da na mawe ai; Shi a janmau chyawm gaw, shi a ntsa e arawng pu na ra ai, nga nna tsun ai.
  </para>
  <chapter number="133" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yu mu, hpunau ni myit hkrum nga nna, Rau hpawng nga lu ai gaw, Gade ngwipyaw nga a hka!
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai gaw, baw kaw nna, nhka mun du hkra, Rai sa, Arun a nhka mun hte, Shi a palawng a du hkawp du hkra, Byawng hkrat ai jet ai namman hte,
  </para>
  <para style="p">
    <verse number="3" style="v" />Hermun bum kaw nna Ziun bum hta, hkrat ai mari hte, bung nga ai; Kaning rai nme law, Yehowa gaw dai yang e, Htani htana asak a shaman ai gaw, a jaw nga mu ai.
  </para>
  <chapter number="134" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yu mu, Yehowa a nta kata e, shana e daw jau nga ai, Yehowa a ali ama ni yawng hte e, Yehowa hpe sha-a mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai chyoi pra ai nta du hkra lata ladawn nna, Yehowa hpe sha-a mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lamu hte aga hpe hpan tawn da ai Yehowa gaw, Ziun kaw nna nang hpe shaman ya u ga.
  </para>
  <chapter number="135" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa a amying nsang hpe shakawn mu; Yehowa a nta e daw jau nga nna,
  </para>
  <para style="p">
    <verse number="2" style="v" />Anhte a Karai Kasang a nta a wang e nga ai, Yehowa a ali ama ni e, kungdawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa hpe shakawn kungdawn mu; Kaning rai nme law, Yehowa gaw mai kaja nga ai. Shi a amying nsang hpe mahkawn mangoi mu; kaning rai nme law, dai gaw ngwipyaw nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa gaw Yaku hpe lata la nna, Israela shi a sali wunli rai nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kaning rai nme law, Yehowa gaw galu kaba nga nna, Anhte a Madu, Hpara ni mahkra hta grau nga ai, ngai chye lu se ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sumsing lamu hte ginding aga hta e, Nammukdara hte sung la ai shara shagu e, Yehowa hpa mung galaw mayu ai hte maren, galaw nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lamu ga ting na shi salu sharawt wu ai; Myihprap hpe marang a matu shatai wu ai, Shi a dum hta na, nbung hpe shapraw dat wu ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw Egutu mung na kasha alat ni hpe, Masha kaw nna yamnga du hkra sat kau mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Egutu mung e, shi gaw na a ka-ang e, Hpara-u hte shi a ali ama ni a man e, Lamik kumla hte mauhpa amu shapraw dat wu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw amyu kaba law law hte, N-gun ja ai hkawhkam ni hpe sat kau mu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amori masha ni a hkawhkam Sihon, Bashan hkawhkam Oga hte, Hkanan a hkawhkam ni mahkra hte hpe, shi sat kau mu ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Shanhte a lamu ga hpe sali wunli tai u ga, Shi a amyu Israela hpe jaw da wu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa e, na a amying htani htana anga nga ai; Yehowa e, prat mi hte prat mi, na a masat dingsat agrin nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaning rai nme law, Yehowa gaw shi a amyu hpe, dawdan na mu ai rai nna, Shi a ali ama ni a matu, myit galai na ra ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Masha amyu ni a sumla ni aja, gumhpraw, Masha lata hte galaw ai arai rai nga malu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shanhte n-gup tu, timung, n chye shaga ma ai; Myi tu, timung, n mu lu ma ai;
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tu, timung, n na lu ma ai, Shanhte a n-gup hta nsoi nsa mi n rawng ma ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai ni hpe tawk ai ni hte, Shanhte hpe shamyet shanat ai ni yawng, Shanhte hte maren rai na mara ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israela a nta ni e, Yehowa hpe shakawn mu, Arun a nta ni e, Yehowa hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lewi a nta ni e, Yehowa hpe shakawn mu; Yehowa hpe hkrit kamyin ai ni e, Yehowa hpe shakawn kungdawn mu,
  </para>
  <para style="p">
    <verse number="21" style="v" />Yerusalem mare hta e, dung nga ai Yehowa gaw, Ziun hta e, a nga u ga law! Halelu-Yah.
  </para>
  <chapter number="136" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa gaw mai kaja nga ai majaw, shi hpe shakawn kungdawn mu; Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hpara ni a Karai Kasang hpe shakawn kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Madu ni a Madu hpe shakawn kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi chyu sha mauhpa kaba galaw ai wa hpe, shakawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hpaji hte sumsing lamu hpe hpan tawn da ai wa hpe, kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hka a ntsa e, ginding aga hpe nep da ai wa hpe, shakawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nhtoi hkum kaba ni shatai ai wa hpe kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw shani hpe up na matu ajan hpe shabyin nu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shana hpe up na matu, shata hte shagan ni shabyin nu ai: Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Egutu mung na kasha alat ni sat kau ai wa hpe shakawn mu, shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shi gaw shanhte a ka-ang na Israela hpe woi wa mu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />N gun ja ai lata, ladawn da ai lahpum hte shanhte hpe woi wa mu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dai Hkyeng ai Nawng hpe jahka kau ai wa hpe kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi gaw de a ka-ang hku Israela hpe shalai dat mu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hpara-u hte shi a luksuk ni hpe, Dai Hkyeng ai Nawng hta e, gumpye bang kau mu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nam mali hku e shi a amyu hpe lakawn wa ai wa hpe, shakawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hkawhkam kaba ni hpe sat kau ai wa hpe, kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hpung shingkang rawng ai hkawhkam ni hpe, sat kau mu ai wa hpe shakawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi gaw Amori hkawhkam Sihon hpe, sat kau nu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bashan a hkawhkam Oga hpe, sat kau nu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shanhte a lamu ga hpe shi jaw kau ya mu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dai hpe shi a mayam wa Israela a sali wunli shatai wu ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Anhte naw kaji nga yang, shi anhte hpe dum nga mi ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hpyen ni kaw na shi anhte hpe hkye hkrang la mi ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Shi gaw hkrung mahkrung yawng hte hpe shat a jaw nga ai, Shi a chyeju htani htana agrin nga ai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sumsing lamu na Karai Wa hpe shakawn kungdawn mu, Shi a chyeju htani htana agrin nga ai.
  </para>
  <chapter number="137" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babelon hka nu hka shi ni a makau e, anhte dung nga nna, Ziun hpe myit dum yang, hkrap nga ga ga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dai yang e tu ai, mu mahka hpun ni hta, Anhte a tingse ni anhte noi da ga ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaning rai nme law, dai yang e, Anhte hpe sharen da ai ni, mahkawn ga hpyi ma ai; Anhte hpe zingri ai ni, “Kabu nga nna, Ziun a mahkawn ga, anhte hpe mahkawn mangoi dan mi,” nga nna hpyi ma ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha tsasam a mung hta e, Yehowa a mahkawn mangoi ga hpe, Anhte kaning rai mahkawn mangoi lu na law e?
  </para>
  <para style="p">
    <verse number="5" style="v" />Yerusalem e, ngai nang hpe malap kau sayang gaw, Nye a hkra lata ngai hpe malap kau u ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang hpe ngai n dum nga nna, Yerusalem hpe nye a kabu htum ai shara, n shatai nga sayang gaw, Nye a shinglet nye a gumra hta kap mat u ga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, Yerusalem a nhtoi hta e, “Run kau mu, npawt du hkra run kau mu,” nga nna tsun ai Edom a kashu kasha ni hpe, dum nga u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Run kau hkrum ai Babelon shayi sha e, Nang anhte hpe di mi ai hte maren, Nang hpe bai tai lu ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na a ma chyangai ni hpe la nna, Nlung hta adit ai wa gaw, a nga ai.
  </para>
  <chapter number="138" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit masin mahkra hte, ngai nang hpe shakawn na nngai; Hpara ni a man e, Ngai nang hpe mahkawn mangoi na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a chyoi pra ai Htingnu a man e, Ngai nawku na nngai rai nna, Na a chyeju hte sadi sahka a majaw, Na a amying hpe shakawn na nngai: Kaning rai nme law, nang gaw na a mungga hpe, Na a amying ntsa e shagrau da nu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai shaga nga ai nhtoi hta e, Nang ngai hpe htan ya nit dai; Nang ngai hpe sharawng awng shangun ni ai; Nye a myit masin n-gun rawng nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, mungkan ga a hkawhkam ni nlang, Nang hpe shakawn kungdawn na mara ai: Kaning rai nme law, shanhte gaw na a n-gup ga na yu masai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa a lam hpe shanhte mahkawn mangoi na mara ai; Kaning rai nme law, Yehowa arawng sadang galu kaba nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa gaw tsaw htum nga timung, Myit gyip ai ni hpe mada yu nga ai; Gumrawng ai ni hpe chyawm gaw, shi tsan tsan kaw nna chye da mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ru tsang ai hta e, ngai hkawm nga timung, Nang ngai hpe shalan shabran ya na ring ngai: Ngai hpe gumlau ai ni a masin pawt ai hpe, Na a lata hpe nang ladawn dat nna, Na a hkra lata ngai hpe hkye hkrang la na ring ngai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw nye a lam shaboi ya na ring ngai; Yehowa e, na a chyeju htani htana agrin nga ai: Na a lata a amu hpe, hkum kau da u law.
  </para>
  <chapter number="139" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, nang ngai hpe manaw yu nna chye nga ndai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai dung nga ai hte rawt wa ai gaw nang chye nga ndai: Ngai myit mang ai hpe mung, Tsan tsan kaw nna pyi nang chye nga ndai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai hkawm wa ai hte taw nga ai hpe, Nang dinglik yu nga ndai rai nna, Nye a lam shagu hpe chye chyap nga ndai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, nye a shinglet hte ngai tsun ai ga hkaw mi muk, Nang n chye nga ai gaw, n nga lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang gaw nye a shawng de, hpang de ngai hpe kawan da nna, Nye a ntsa e, na a lata hpe mara da nu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai hte wa chye chyang ai lam, nye a matu mauhpa kaba rai nga ai; Dai gaw nau tsaw la nga ai rai nna, ngai n dang myit lu we ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a Wenyi hte ngai kanang e hka lu na n hka? Na a myi man kaw nna gade hprawng lu na ma?
  </para>
  <para style="p">
    <verse number="8" style="v" />Sumsing lamu de lung wa yang, dai yang e, nang nga nga ndai; Katsan ga e, ngai panep nep yang, dai hta e mung, nang nga nga ndai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jahpawt manap a singkaw hpe ngai la nna, Nammukdara a jahtum e dung nga yang,
  </para>
  <para style="p">
    <verse number="10" style="v" />Dai yang e mung, na a lata ngai hpe woi wa nna, Na a hkra lata ngai hpe a jum nga na ra ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gaja wa, nsin gaw ngai hpe ka-up da nna, Nhtoi gaw nye a grup yin e shana tai u ga, nga nna ngai tsun nga yang,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nsin mung na a man e nsin zawn n rai mat nna, Dai shana gaw shani zawn htoi mat ai: Nsin gaw nhtoi hte na a man e maren rai nga ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaning rai nme law, nye a nhkyun ni nang lajang da nna, Nye nu a kan hta e ngai hpe shachyaw ni ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hkrithpa hte mauhpa lam hkan nna, Ngai hpe hpan da ni ai majaw, Ngai nang hpe shakawn kungdawn nga nngai; Na a bungli mauhpa bungli rai nga ai rai nna, Dai hpe nye a myit masin nachying chye nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Makoi magap shara e ngai hpe hpan da nna, Aga a sung ai shara e shachyaw nu ai shaloi e, Nye a nrut nra hpe nang n malap kau da ndai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nye a hkumhkrang garai n kumla yang, Na a myi ngai hpe mu nga ai rai nna, Nye a matu tawn da ai nhtoi ni hta, Langai mi muk ngai garai n mu yang, Na a laika hta nlang hte hpe ka da nu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Karai Wa e, nye a lam nang myit mang ai hku, gade hpu nga a hka! Nlang hte gaw, gade law nga a hka!
  </para>
  <para style="p">
    <verse number="18" style="v" />Dai hte hpe hti yu yang, zaibru hta n-ga law nga ma ai: Ngai yup hprang wa yang, nang hte rau ngai naw nga na nngai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Karai Wa e, tara n lang ai ni hpe nang sat kau n ga; Sai kap ai ni ngai hte tsan nga mu ga.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dai ni, hkalem sha let nang hpe gumlau nna, Mara n nga timung, nang hte nhtan shai ma ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Yehowa e, nang hpe n dawng n yawt ai ni hpe, Ngai mung n dawng na mawe ai, n rai ni? Nang hpe gumlau na maga e rawt ai ni hpe, Ngai matsat kau na mawe ai, n rai ni?
  </para>
  <para style="p">
    <verse number="22" style="v" />N dawng n yawt ai myit yawng hte, Ngai shanhte hpe n dawng n yawt da mawe ai; Ngai hpe gumlau ai ni zawn, ngai shanhte hpe nawn da mawe ai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Karai Wa e, ngai hpe manaw yu nna, Nye a myit mang ai lam hpe chye ya e; Ngai hpe dinglik yu nna, ngai myit ai hku hpe chye ya e.
  </para>
  <para style="p">
    <verse number="24" style="v" />Yawn mai ai lam de, ngai hkan taw gaw, yu yu u; Htani htana grin nga ai lam de, ngai hpe woi wa e law.
  </para>
  <chapter number="140" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, tinang a myit hta n hkru ai hku daw nga nna, Shani shagu gumle gumlau sharawt nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />N hkru ai masha kaw na, ngai hpe mawai la e; Kashun kashe re ai wa kaw na, ngai hpe makawp maga la e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Shanhte gaw lapu zawn tinang a shinglet hpe mayoi da nna, Pu htum a tuk shanhte a nten npu e rawng nga ai. [Selah.]
  </para>
  <para style="p">
    <verse number="4" style="v" />Yehowa e, nye a lagaw kashawt u ga, myit daw nga ai tara n lang ai wa a lata kaw na, ngai hpe bau sin ya e. Kashun kashe re ai wa kaw na ngai hpe makawp maga la e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gumrawng ai ni nye a matu mahkam hte sumri up da nna, Nye a lam e, sumgawn nep da mu ai: Nye a matu ndaw mung jun da mu ai. [Selah.]
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai gaw, Nye a Karai Wa nang rai nga ndai; Yehowa e, ngai akyu hpyi ai nsen madat ya e, nga nna, Yehowa hpe ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai Madu Yehowa gaw, ngai hpe hkye hkrang la ai n-gun rai nga ai; Hpyen palawng bu hpun ai shani e, nang nye a baw hpe magap da ya ndai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa e, tara n lang ai wa a ra ai hku hpe hkum shabyin ya u; Shi a myit mang ai lam hpe hkum shadik ya et. [Selah.]
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a grup yin e, tinang a baw hpe sharawt mu ai ni, Shanhte a n hkru ai n-gup ga, shanhte hpe htinggrum nga mu ga.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shanhte a ntsa e, wan n-ga hkrat bun mu ga; Grung ai wan hta e, shanhte hpe jahkrat dat mu ga, Bai n pru lu ai sung la ai nhkun hta e, shanhte hpe jahkrat dat mu ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Baw law ai masha gaw ga ntsa e n grin lu u ga; Kashun kashe sha ai wa hpe mung, N hkru ai gaw shi hpe hkan jahten na ra ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nni nkri hkrum ai ni a jeyang na lam hte, Matsan mayan ni a tara dara ai lam hpe, Yehowa tawn da nga ai gaw, ngai chye nga nngai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gaja wa, dinghpring ai ni, na a amying hpe, shakawn na mara ai; Myit malang ai ni, na a man e anga nga lu na mara ai law.
  </para>
  <chapter number="141" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, ngai nang hpe shaga nga nngai; Ngai kaw alawan wa rit; Nang hpe ngai shaga nga yang, nye a nsen madat mara ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai akyu hpyi ai ga, na a man e, manam pyaw ai baw zawn, Ngai lata ladawn ai gaw, shana na hkungga zawn, rai nga u ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, nye a n-gup hpe sin ya e; Nye a nten chyinghka bau da ya e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a myit n shawp ai amu n maw u ga; Kaman lila galaw ai masha ni hte rau, Tara n hkan ai bungli ngai mung n galaw n ga; Shanhte a reng ai shat hpe, ngai n sha lawm n ga.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dinghpring ai wa gaw ngai hpe kayat u ga; dai gaw chyeju rai nga ai; Ngai hpe sharin ya u ga; dai gaw baw chya ai namman zawn rai nga ai; Nye a baw dai namman hpe n hkum kau u ga: Ngai wa masha ni a n hkru ai malai, akyu naw hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shanhte a tara agyi ni pyi, nlung hta agrawp kau ai hkrum ma yang, “Katsan ga a mahka e anhte a nrut nra ni ayai nga timung,
  </para>
  <para style="p">
    <verse number="7" style="v" />Dai gaw, aga hpe htu nna, galau kau ai hte bung nga ai,” nga nna, ngai shapyaw ai ga hpe, shanhte na ma ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaning rai nme law, nye a Madu Yehowa e, Nye a myi nang hpe a mada nga li ai; Nang hpe ngai myit mada nga nngai, Nye a asak sumri hpe hkum dawm kau ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nye a matu hkam ai mahkam hte, N hkru ai bungli galaw ai ni a nbyeng hta na, ngai hpe shalawt dat e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai gaw apra asan sha lai wa lu nna, Tara n lang ai ni tinang a mahkam hta, rung rai mu ga.
  </para>
  <chapter number="142" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a nsen hte ngai Yehowa hpe jahtau nga nngai: Nye a nsen hte ngai Yehowa hpe akyu hpyi nga nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a man e nye a aru ara ngai ru kau na nngai, Shi a man e ngai ru tsang ai lam ngai tsun dan na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nye a wenyi gawng run nga ai shaloi e, Nang nye a lam hpe chye nga ndai; Ngai sa wa ai hku hta e, shanhte mahkam up da mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nye a hkra maga de mada yu u, Ngai hte hkau chyap ai wa n nga ai; Ngai shingbyi shara hten wa sai, Nye a myit masin hpe lahpawt ai wa n nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, ngai nang hpe jahtau nga nngai; Ngai shingbyi shawung shara hte, Hkrung nga ai ni a ga hta e nye a hkambum, Nang rai nga ndai, nga nna ngai tsun nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai matsan mayan nachying hkrum nngai majaw, Ngai hpyi jahtau ai hpe matsing la ya e; Hkan shachyut ai ni kaw na ngai hpe mawai la e; Shanhte gaw ngai hta n-gun grau ja ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a amying nsang hpe ngai shakawn nga lu n ga, Dai htawng hta na nye a myit masin hpe shapraw dat u; Shing rai nang ngai hpe chyeju galaw ai majaw, Dingman ai ni ngai hpe bawp nga lu na mara ai.
  </para>
  <chapter number="143" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa e, ngai akyu hpyi ai ga na la ya e; Ngai tawngban ai ga madat ya e; Na a sadi sahka hte dingman ai hte maren ngai hpe htan ya e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na a man e hkrung mahkrung n ding n man rai nga ma ai majaw, Na a mayam wa hpe tara hkum dara et.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dai gumlau wa gaw nye a myit masin hpe hkan shachyut nu ai: Nye a asak hpe ga du hkra kabye kau wu ai: Moi moi na si mat ai ni zawn, Nsin sin ai shara e, shi ngai hpe nga shangun ni ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dai majaw nye a wenyi gawng run nga ai, Nye a myit kraw hta e, hten mat nga ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shawoi na nhtoi ni ngai dum nga nngai; Na a bungli yawng hpe ngai myit yu nga nngai: Na a lata a magam hpe, ngai aru yu nga nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nye a lata hpe nang kaw ngai ladawn da we ai: Hkraw mat ai ga zawn nye a myit masin nang hpe marit nga nngai. [Selah.]
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa e, ngai hpe alawan htan ya e, Nye wenyi htum mat sai; Nsung hku hta shang ai ni zawn, ngai n rai mat u ga, Na a myi man ngai kaw na hkum kayin la et.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang hpe ngai shamyet shanat nga nngai majaw, Jahpawt manap e, na a chyeju ngai hpe shana ya e. Nang kaw nye a myit masin hpe ngai sharawt nga nngai majaw, Ngai sa wa ai lam ngai hpe sharin ya e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa e, nang hpang de ngai hprawng wa nngai rai nna, Gumlau ni kaw na ngai hpe mawai la e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nye a Karai Kasang nang rai nga ndai majaw, Na a myit hkan nang na, ngai hpe sharin ya e. Na a mai kaja ai Wenyi gaw, Ngwipyaw ai mung de ngai hpe woi wa u ga.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa e, na a amying nsang a matu mara ngai hpe shalan shabran ya e; Na a dinghpring ai majaw, ru tsang ai hta na, nye a myit masin hpe shaw la ya e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a chyeju hte, ngai hpe gumlau ai ni hpe atsai awai di mu: Na a mayam wa ngai rai nga nngai majaw, Nye a myit masin hpe zingri ya ai ni nlang hte hpe, jahten kau mu.
  </para>
  <chapter number="144" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a lunghkrung rai nga ai Yehowa gaw, a nga u ga: Shi gaw nye a lata hpe hpyen amu, Nye a layung ni hpe majan amu, sharin ya mu ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi gaw nye a chyeju, nye a wahpang nta, Nye a langchyi hte ngai hpe shalawt ai wa, Nye a n-gang hte ngai shingbyi nga ai wa, rai nga ai: Nye a amyu hpe shi nye a npu e tawn da manu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa e, nang chye nga ai shinggyim masha hte, Nang ai mi nawn nga ai masha kasha gaw, hpa wa mi rai nga a hka?
  </para>
  <para style="p">
    <verse number="4" style="v" />Masha wa gaw nbung hte bung nga ai. Shi a nhtoi ni lai mat wa ai shingnip zawn rai nga lu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa e, na a sumsing lamu hpe shanem nna, yu hkrat wa rit; Bum ni hpe ahtawk nna, dai ni wan nhkut shapraw mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Myihprap galam dat nna, shanhte hpe shabra mu; Na a pala ni hpe dat dat nna, shanhte hpe shamak kau mu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tsaw htum ai shara kaw nna na a lata ladawn dat u; Hka kaba hte masha tsasam ni a lata na, Ngai hpe shaw la nna, mawai la e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shanhte a n-gup kaman ga tsun nga nna, Shanhte a hkra lata hkalem sha ai lata rai nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Kasang e, ningnan mahkawn ga, Ngai nang hpe mahkawn mangoi na nngai; Sumri shi rawng ai tingse hte e, Ngai nang hpe dum dan nna shakawn na nngai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shi gaw hkawhkam ni hpe nlaw shangun nu ai; Shi a mayam Dawi hpe n hkru ai nhtu hta na shalawt dat nu ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Masha tsasam ni a lata hta na, ngai hpe shaw la nna mawai la e; Shanhte a n-gup kaman ga tsun nga nna, Shanhte a hkra lata hkalem sha ai lata rai nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Anhte a shadang sha ni, brang ram ai aten e, nampan zawn kaba wa nna, Anhte a shayi sha ni, htingnu a kasi hkan nna, Tawk ka ai njut shadaw zawn, rai nga ma yang:
  </para>
  <para style="p">
    <verse number="13" style="v" />Anhte a mamdum ni hpring nga nna, Baw sumhpa hkum hkra rawng nga ai hte, Anhte a sagu bainam ni nachying mayat maya wa nna, Udat shara e kasha hkying mun mi hkrat wa nga yang:
  </para>
  <para style="p">
    <verse number="14" style="v" />Anhte a usu ni law law htaw lu na hte, Bunghku sharun shadaw lu ai, hpa mung n nga ai, Rim la nna pru wa ai mi, n nga ai, Anhte a mare lam ni hta sharung shayawt ai mi n nga nga yang,
  </para>
  <para style="p">
    <verse number="15" style="v" />Shing rai nga lu ai amyu gaw, a nga ai; Karai Kasang matu Yehowa lu ai amyu gaw, a nga ai.
  </para>
  <chapter number="145" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a Karai Kasang hte Hkawhkam wa e, Ngai nang hpe shagrau na nngai; Na a amying nsang hpe, htani htana sha-a nga na nngai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shani shagu ngai nang hpe a sha-a nga na de ai: Na a amying nsang hpe, htani htana Prat dingsa, ngai shakawn nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yehowa gaw galu kaba nga ai rai nna, Nachying shakawn ging ai wa, rai nga ai; Shi a galu kaba ai magam hpe, kadai mung n dang sawk yu nga ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shu mashi shu masha ni prat mi hte prat mi, Na a bungli hpe shagrau na mara ai; Na a daru magam hpe hkai dan nga na mara ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na a hpung shingkang a dan hkung ai arawng sadang hte, Na a mauhpa bungli hpe, ngai myit aru yu nga na nngai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na a hkrithpa nsam rawng ai magam hpe, shanhte tsun nga ma ai rai nna, Na a galu kaba ai lam hpe ngai gawn dan na mawe ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na a mai kaja ai masat dingsat hpe, shanhte kajai gumhkawng na mara ai; Na a dinghpring ai hpe mung, shanhte jahtau garu na mara ai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw sumnung ai, matsan dum ai, galu kaba ai hte nachying n-gaw nwai ai hte hpring nga ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa gaw nlang hte hpe mai kaja ai myit madun nga ai rai nna, Shi a arai yawng a ntsa e, shi a sumnung ai myit anga nga lu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa e, na a bungli nlang hte gaw, Nang hpe shakawn kungdawn nga ma ai; Na a chyoi pra ai ni mung, nang hpe sha-a let nga nga ma ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shinggyim masha ni hpe, shi a atsam bungli hte, Shi a mungdan dan hkung ai arawng sadang hpe chye na lu mu ga,
  </para>
  <para style="p">
    <verse number="12" style="v" />Na a mungdan a arawng sadang hpe, shanhte kajai gara nna, Na a atsam rawng ai bungli hpe tsun dan na mu ai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a mungdan gaw htani htana agrin nga ai mungdan rai nga ai rai nna, Nang hkang ai ahkang gaw, prat mi hte prat mi dinggrin anga nga lu ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Yehowa gaw kataw ai ni mahkra hpe, sharawt ai rai nna, Shagrit kau hkrum ai ni yawng hpe shadaw nga ai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yawng mayawng a myi nang hpe a mada nga nna, Aten du jang, nang shanhte hpe shat jaw mu ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na a lata hpe nang hpaw nga nna, Hkrung mahkrung ni hpe kaja ai hte shakat da mu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Yehowa gaw lam shagu hta dinghpring nga ai rai nna, Shi a amu yawng hte hta chyeju madun nga ai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Yehowa gaw shi hpe shaga ai ni nlang hte hte, Sadi sahka hte shi hpe shaga ai ni nlang hte hte, ni nga ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi hpe hkrit kamyin ai ni a ra ai hku shi shadik ya nna, Shanhte a jahtau ai hpe shi na la nna, shanhte hpe hkye la mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Yehowa, shi hpe tsawra ai ni nlang hte hpe bau sin nga ai; Tara n lang ai ni nlang hte hpe jahten kau mu ai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nye a n-gup Yehowa hpe shakawn kungdawn na ra ai; Hkrung mahkrung ni shi a chyoi pra ai mying nsang hpe, htani htana e a sha-a nga mu ga law.
  </para>
  <chapter number="146" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nye a myit masin e, Yehowa hpe shakawn kungdawn u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai asak hkrung nga ai hte yang, Yehowa hpe ngai shakawn nga na nngai; Ngai naw agrin nga ai hte yang, Nye a Karai Kasang hpe ngai kungdawn nga na nngai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hpa hta mung n karum lu ai, du ni hte, Shinggyim masha hpe, hkum hpa nga myit.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi a nsoi nsa hkyet mat yang, shi ga de bai nhtang mat wa ai rai nna, Dai shani jang, shi maw ai hku yawng hten mat wa ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaku a Karai Wa, karum ai wa rai nna, Shi a Karai Kasang Yehowa hpe, myit mada nga ai wa gaw, a nga ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shi gaw sumsing lamu hte ginding aga, Nammukdara hte dai hta rawng marawng a Hpan Wa Ningsang rai nga ai: Shi gaw htani htana sadi sahka adum nga ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nni nkri hkrum ai ni hpe shi tara dara ya mu ai, Hku hku hkrum ai ni hpe lusha shahpa jaw mu ai. Yehowa gaw bawng dung ai ni hpe raw dat mu ai;
  </para>
  <para style="p">
    <verse number="8" style="v" />Yehowa gaw myi kyaw ai ni hpe shamu ya mu ai; Yehowa gaw kataw ai ni hpe sharawt ya mu ai; Yehowa gaw dingman ai ni hpe tsawra nga mu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yehowa gaw bu hkawm ai ni hpe bau sin ya mu ai, Jahkrai nmai ni hte gaida gaina ni hpe shadaw ya mu ai. Tara n lang ai ni a lam hpe, shi shanut kau ya mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yehowa gaw htani htana Hkawhkam rai nga ai; Ziun e, na a Karai Kasang gaw prat mi hte prat mi a up nga ai. Halelu-Yah.
  </para>
  <chapter number="147" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe shakawn kungdawn mu: kaning rai nme law, anhte a Karai Kasang hpe, Mahkawn mangoi na mai kaja nga ai: Dai gaw ngwipyaw ai lam rai nga ai, Shakawn kungdawn ai lam sut nga ai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yehowa gaw Yerusalem mare hpe bai de da ai wa rai nga ai; Bra mat ai Israela amyu masha ni hpe, bai shinggyin la mu ai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Myit maku daw ai ni hpe shi shamai ya nna, Shanhte a nma hpe ahkang kayawp ya mu ai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shi gaw shagan ni hpe nambat jaw nu ai rai nna, Langai hte langai hpe amying shamying ya mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Anhte a Madu galu kaba nga ai rai nna, Shi a hpung shingkang mung galu kaba nga ai; Shi myit ai lam kadai n dang gawn lu ai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Yehowa gaw matsan mayan ni hpe sharawt dat nna, Tara n lang ai ni hpe ga de jahkrat kau mu ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Yehowa hpe, chyeju dum let mahkawn mu, Anhte a Karai Kasang hpe tingse hte mangoi mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi gaw lamu hpe sumwi hte magap da nna, Lamu ga a matu marang hpe san da nu ai: Bum ni hta tsingdu shatut da nu ai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yamnga ni hte, jawp nga ai u hka hkalung ni hpe, shahpa jaw mu ai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gumra a n-gun hpe shi n ra nga ai, Masha a laram ai hta shi n awng nga ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Yehowa gaw shi hpe hkrit kamyin ai ni hte, Shi a chyeju hpe myit mada ai ni hta, awng nga ai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yerusalem e, Yehowa hpe shakawn u, Ziun e, na a Karai Kasang hpe kungdawn u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na a mare chyinghka htinggrang ni hpe shi shangang da nna, Na a htingwang na nshu nsha ni hpe shaman ya nit dai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na a lamu ga jarit hpe shi shangwi ya nna, Sau ai mam hte nang hpe shakat nit dai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Shi gaw ga de shi a ga matsun hpe dat dat nna, Shi a mungga alawan gat pru nga ai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sagu mun zawn, hkyen gumdin shi jahkrat dat nna, Htat ai hkyen hpe wan dap zawn gat dat wu ai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shi a sin hpe lungja zawn jahkrat dat nna, Shi a kashung ai hpe kadai sharang lu na rai nga a ta?
  </para>
  <para style="p">
    <verse number="18" style="v" />Bai shi a mungga hpe shi dat dat nna, dai ni hpe shabyawng dat nu ai; Shi a nbung hpe shabung dat nna, hka shi ni lwi wa ma ai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shi gaw Yaku hta shi a mungga hpe, Israela hta shi a ga matsun hte, tara dara ai lam hpe, madun dan mu ai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shi gaw amyu kaga ni hpe, shing di galaw ya mu ai n rai: Shi a dara ai lam ni hpe, shanhte n chye na lu ma ai. Halelu-Yah.
  </para>
  <chapter number="148" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sumsing lamu de na, Yehowa hpe shakawn mu, Tsaw Htum ai shara e, shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a lamu kasa yawng hte e, shi hpe shakawn mu, Zaw nawng zaw wa yawng hte e, shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ajan hte shata, shi hpe shakawn mu, Nhtoi htoi ai shagan ni e, shi hpe kungdawn mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lamu lahta tang na lamu hte, Lamu ntsa e nga ai hka hpung ni e, shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yehowa htet da nu ai rai nna, dai ni hpe hpan da wu ai majaw, Shi a amying nsang hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dai ni gaw htani htana prat dingsa agrin nga ma ai: Ga madat shi tawn da nu ai rai nna, hpa mung dai hpe n lai lu ma ai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Baren ni hte, sung htum ai shara ni, Awan, asin, ahkyen hte salu,
  </para>
  <para style="p">
    <verse number="8" style="v" />Shi a mungga madat ai nbung laru, Bum ni hte kawng ni nlang hte hte,
  </para>
  <para style="p">
    <verse number="9" style="v" />Asi si ai hpun hte arit hpun ni, Matse labye hte yamnga nlang hte hte,
  </para>
  <para style="p">
    <verse number="10" style="v" />Gumrawt hkawm ai baw hte, pyen ai u ni; Ga ntsa hkawhkam ni hte amyu baw shagu,
  </para>
  <para style="p">
    <verse number="11" style="v" />Du ni hte tara agyi ni nlang hte hte, Shabrang ni hte mahkawn ni mung,
  </para>
  <para style="p">
    <verse number="12" style="v" />Dingla ni hte ma kaji ni e, Dinghta ga kaw nna Yehowa hpe shakawn mu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Yehowa a amying hpe dai ni shakawn nga mu ga; Kaning rai nme law, shi a amying chyu sha grau nga ai. Shi a hpung shingkang mung, ginding aga hte, Sumsing lamu a ntsa e chyam nga ai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shi a amyu masha ni nlang a matu, shi dai nrung hpe sharawt da nu ai; dai gaw, shi hte ni nga ai amyu, Israela kashu kasha ni hte, Shi a chyoi pra ai ni yawng a matu mara, Shakawn kungdawn ai lam rai nga ai. Halelu-Yah.
  </para>
  <chapter number="149" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yehowa hpe mahkawn ga nnan mahkawn mu; Chyoi pra ai ni a hpawng hta e, Shi hpe shakawn kungdawn ai ga, mahkawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israela gaw shi a Hpan Wa Ningsang hta kabu nga nna, Ziun a kashu kasha ni shanhte a Hkawhkam hta, sharawng awng nga mu ga.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka let shi a amying hpe shakawn mu: Shupsheng hte tingse dum let, shi hpe mahkawn mangoi nga mu ga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaning rai nme law, Yehowa gaw shi a amyu hta, awng nga ai rai nna, Myit gyip nga ai ni hpe hkye hkrang la ai hte, mawn sumli mu ai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyoi pra ai ni gaw hpung shingkang hta, sharawng awng nga mu ga; Shanhte a yup ku ni hta mung, kabu gara let jahtau nga mu ga.
  </para>
  <para style="p">
    <verse number="6" style="v" />Masha amyu ni hpe bai tai nna, Amyu baw ni hpe ari jaw na hte,
  </para>
  <para style="p">
    <verse number="7" style="v" />Shanhte a hkawhkam ni hpe hkang hkyihkyang hte, Shanhte a arawng lu ai ni hpe hpri sumri hte gyit nna,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka da nga ai hte maren, Shanhte hpe tara dara mu ga,
  </para>
  <para style="p">
    <verse number="9" style="v" />Karai Wa a matu shanhte a n-gup hta, mahkawn ga kaba rawng nga nna, Shanhte a lata hta nshan lahkawng dai ai nhtu lang nga mu ga: Dai gaw chyoi pra ai ni mahkra a matu, Hpung shingkang rai nga malu ai law. Halelu-Yah.
  </para>
  <chapter number="150" style="c" />
  <para style="p">
    <verse number="1" style="v" />Karai Wa a chyoi pra ai shara kaw e, shi hpe shakawn kungdawn mu; Shi a atsam dan hkung ai lamu madin a ntsa e, Shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shi a magam bungli majaw, Shi hpe shakawn kungdawn mu; Shi galu kaba nga ai hte maren, Shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pahtau a ngoi ai mahku hte, Shi hpe shakawn kungdawn mu; Tingse hte madum pyiman hte, Shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Shupsheng dum ai hte ka let, Shi hpe shakawn kungdawn mu; Tingse sumri hte sumpyi hte, Shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngwi ai shupsheng kaba hte, Shi hpe shakawn kungdawn mu; Grai ngoi ai shupsheng kaba hte, Shi hpe shakawn kungdawn mu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nsoi nsa rawng ai yawng hte gaw, Yehowa hpe shakawn kungdawn nga mu ga law. Halelu-Yah.
  </para>
</usx>
