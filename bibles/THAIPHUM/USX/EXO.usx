<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="EXO" style="id">Tâconae</book>
  <para style="h">Tâconae</para>
  <para style="toc1">Tâconae</para>
  <para style="toc2">Tâconae</para>
  <para style="mt">Tâconae</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izip ram vah Jakop hoi cungtalah, amamae imthungnaw ka phat awh e Isarelnaw teh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Reuben, Simeon, Levih hoi Judah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Issakhar, Zebulun hoi Benjamin,
  </para>
  <para style="p">
    <verse number="4" style="v" />Dan, Naphtali, Gad hoi Asher,
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakop canaw abuemlah tami 70 touh a pha awh. Joseph teh Izip ram vah yo la ao toe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Joseph hoi a hmaunawnghanaw senae taminaw pueng teh koung a due awh toe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Isarelnaw teh ca moi a pungdaw awh, a thao awh teh ram pueng dawk kho a sak awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hathnukkhu, Izip ram dawk Joseph ka panuek hoeh e siangpahrang katha a tâco.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hote siangpahrang ni hai Isarelnaw teh maimanaw hlak apap awh, a thasai awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tho awh, lungangcalah hoi ahnimouh lathueng hno sak awh sei. Nahoeh pawiteh, ahnimouh teh hoe pungdaw awh vaiteh, hmalah tarankâtuknae awm pawiteh, maimae tarannaw koe lah kambawng awh vaiteh, maimouh hah na tuk vaiteh ram dawk hoi a yawng awh han doeh telah a taminaw koe a dei pouh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hatdawkvah, Izip bawinaw ni puenghoi rektap hanelah kaukkung a ta pouh. Isarel taminaw teh hno pâtung nahanlah Pithom khopui hoi Raameses khopui hah a sak awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hateiteh, rektapnae hoehoe a khang awh e patetlah hoehoe a pungdaw awh. Ahnimouh kecu dawk Izipnaw teh a lungpuen awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pueng hoi hoe a rektap awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Talung bonae hoi amhru saknae koe, law thawnaw pueng dawk puenghoi a tawk sak awh teh a tawk e tangkuem dawk nget ka tawn lah a tawk sak awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Izip siangpahrang ni Hebru tami, camo ka khe sak roi e kahni touh, Siphrah hoi Puah koevah,
  </para>
  <para style="p">
    <verse number="16" style="v" />nangmouh roi ni Hebru napuinaw e camo khe sak roi nateh, a khenae hmuen koe na ring roi navah, ca tongpa khe pawiteh thet, napui khe pawiteh pâhlung roi haw telah atipouh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Camo kakhesak roi e ni Cathut a taki dawkvah, Izip siangpahrang e kâpoe e patetlah sak laipalah ca tongpa hah a pâhlung roi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izip siangpahrang ni hai camo kakhesak e roi a kaw teh, nangmouh roi ni bangkongmaw camo tongpanaw na pâhlung roi telah a pacei navah,
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahnimouh roi ni Hebru napuinaw teh Izip napuinaw patetlah awm awh hoeh. Ahnimouh teh cao a yawi dawkvah, camo kakhesak e a tho hoeh nah camo yo a la khe toe telah atipouh roi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hatdawkvah, Cathut ni camo kakhesak roi e lathueng vah, hawinae a sak pouh. Hote miphun haiyah a pungdaw awh teh a thao awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Camo kakhesak e napui roi ni Cathut a taki roi dawkvah ahnimae imthungkhunaw hah a khetyawt roi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Faro siangpahrang ni hai Isarelnaw dawk ca tongpa khe e pueng teh Nai palang dawk tâkhawng naseh, Napui pâhlung awh naseh, telah a taminaw pueng koe lawk a thui.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hatnae tueng nah, Levih tami tongpa buet touh ni Levih tami napui a yu lah a la.
  </para>
  <para style="p">
    <verse number="2" style="v" />Napui ni camo a vawn teh ca tongpa a khe. Hote ca tongpa teh meilam hawinae hah a manu ni a hmu dawkvah, thapa yung thum touh thung a hro.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hateiteh, a hro thai hoeh torei teh, lungpumkung hoi sak e thingkong hah a la teh tuipan hoi thingtapi hoi a patô hnukkhu, hote thingkong dawk camo a ta teh, Nai palang rai lah lungpum um vah a ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tawncanu ni bangtelah vaimoe ao han vaiyoe tie panue han a ngai dawkvah ahlahnawnnae koehoi a tuet.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hat toteh, Faro canu teh tui kamhluk hanlah a tho. A sannunaw hoi tuipui rai lah a kâhlai awh navah, sumpanaw rahak vah thingkong a hmu teh la hanlah a sannu buet touh a patoun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thingkong e a khuem a paawng awh navah, ka kap e camo hah a hmu. Pahrennae lungthin a tawn dawkvah hete camo teh Hebru camo doeh telah ati.
  </para>
  <para style="p">
    <verse number="7" style="v" />Camo e a tawncanu ni nang hanlah camo ka cun hane Hebru napui kai ni ka cei vaiteh, na kaw pouh han na ou telah Faro siangpahrang e canu koe a pacei navah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Faro canu ni cet loe telah kâ a poe dawkvah, napuica ni a cei teh camo e a manu hah a kaw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hathnukkhu, Faro siangpahrang e canu ni hete camo heh lat nateh kai hanlah na kawk pouh la a, aphu na poe han telah atipouh e patetlah hote napui ni camo hah a la teh a kawk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Camo a roung torei teh, Faro siangpahrang e canu koe a thak pouh teh, siangpahrang e canu ni a ca lah a ta teh, Mosi telah min a phung. Bangkongtetpawiteh, tui dawk hoi kai ni ka rasa e telah ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi teh a kum hruet a cue torei teh, amae a miphunnaw onae hmuen koe a cei teh, ahnimae thaw tawk e naw hah a khet. A miphun Hebru tami buet touh hah Izip tami ni a hem e a hmu navah,
  </para>
  <para style="p">
    <verse number="12" style="v" />A tengpam a khet teh apihai awm hoeh tie a panue navah, Izip tami hah a thei teh sadi dawk a pakawp.
  </para>
  <para style="p">
    <verse number="13" style="v" />Atangtho bout a tâco navah, Hebru tami kahni touh a kâyue roi e a hmu teh, nang ni namamouh roi reira hah bangkongmaw na hem telah ka yue e tami hah a pacei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hote tami ni apinimaw nang teh kaimouh lathueng vah lawkcengkung lah na ta. Izip tami na thei e patetlah kai hah na thei han na ngai maw telah atipouh. Hatnavah, Mosi ni amae hno a sak e hah a kamphawng toe telah a panue dawkvah a taki.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hote kamthang hah Faro siangpahrang ni a thai torei teh, Mosi thei hanlah a tawng. Mosi teh Faro siangpahrang koehoi a yawng teh, Midian ram vah kho a sak. Ahni teh, tuido teng a tahung navah,
  </para>
  <para style="p">
    <verse number="16" style="v" />Midian vaihma e canu sari touh teh a na pa e tu hoi hmaenaw tui pânei hanlah a tho awh teh tui a do awh hnukkhu, dokkonaw dawk tui a pakawi awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hatnavah, tukhoumnaw a tho awh teh, tu hoi hmaenaw hah a hrui awh. Hatnavah, Mosi ni a thaw teh, hote napuinaw koe lah ao teh tu hoi hmaenaw hah tui a pânei pouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hote napuinaw teh a na pa Reuel koe a pha awh navah, bangkong sahnin teh palang na tho awh bo telah atipouh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahnimouh nihaiyah Izip tami buet touh ni tukhoumnaw e kut dawk hoi na rungngang teh tui kakhoutlah a do teh tu hoi hmaenaw hah tui a pânei atipouh awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A na pa ni hai hote tami teh na maw ao. Bangkongmaw yout na ban takhai awh. Bu ca hanlah kaw awh, telah atipouh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hottelah hoiyah Mosi teh ahnimouh hoi cungtalah o hanelah, a hnâbo hnukkhu Reuel ni a canu Zipporah hah Mosi hoi a kâpaluen sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hote napui ni ca tongpa a khe toteh Mosi ni Gershom telah min a phung. Bangkongtetpawiteh, kai teh ramlouk dawk imyin lah ka o toe telah ati.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kumtha asaw toteh, Izip siangpahrang hai yo a due toe. Hattoteh Isarelnaw teh san lah ao awhnae koe a cingou khuika awh. Hottelah san lah onae koehoi khuika hramki e lawk teh Cathut koe a pha.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cathut ni ahnimae cingou khuika lawk teh a thai pouh. Hatnavah, Cathut ni Abraham, Isak, Jakop tinaw hoi lawkkam a sak e hah a pouk.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hatdawkvah, Cathut ni Isarelnaw hah a hmu teh, a panue.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi ni Midian vaihma, a masei Jethro e tu hoi hmaenaw a khoum navah, thingyeiyawn e kanîloumlah a ceikhai teh, Horeb tie Cathut e mon koe a pha.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hatnavah, BAWIPA e kalvantami teh buruk dawk hoi ka tâcawt e hmaito lahoi a kamnue. Mosi ni a khet navah, hmai a to ei, buruk teh a kak hoeh e hah a hmu navah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Bangkongmaw buruk kang laipalah ao. Hete kângairu e hno heh ka cei vaiteh ka khet han telah ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosi ni a khet e BAWIPA ni a hmu navah, Mosi, Mosi telah buruk thung hoiyah a kaw. Mosi ni hai ka o telah atipouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cathut ni hai hnai hanh. Na khokkhawm hah rading haw. Na kangduenae hmuen teh kathounge talai doeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai teh nange na pa e Cathut, Abraham e Cathut, Isak e Cathut, Jakop e Cathut, doeh telah atipouh. Mosi ni Cathut teh a khet ngam hoeh dawkvah a minhmai a ramuk.
  </para>
  <para style="p">
    <verse number="7" style="v" />BAWIPA ni hai Izip ram kaawm e ka taminaw e a khang e rektapnae hah kai ni khei ka hmu toe. Ahnimouh thaw ka tawksak e bawinaw kecu dawk ahnimae hramnae lawk ka thai teh, reithai khangnae hai ka panue.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahnimouh teh Izip ram, Izip taminaw e kut dawk hoi ratang vaiteh, Kanaannaw, Hitnaw, Amornaw, Periznaw, Hivnaw hoi Jebusitnaw onae ram, sanutui hoi khoitui a lawngnae ram dawk hrawi hanlah kai ka kum.
  </para>
  <para style="p">
    <verse number="9" style="v" />Atu haiyah, Isarelnaw khuika lawk kai koe a pha teh, Izipnaw ni ahnimouh rektapnae hai ka hmu toe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hatdawkvah, atu cet leih. Nang teh ka tami, Isarelnaw hah Izip ram hoi hrawi tâcokhai hanlah, nang teh Faro siangpahrang koe kai ni na patoun han telah atipouh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi nihai, kai teh bang patet e tami lah maw ka o teh, Faro siangpahrang koe ka cei vaiteh, Isarelnaw hah Izip ram hoi hrawi tâcokhai han telah Cathut koe atipouh navah,
  </para>
  <para style="p">
    <verse number="12" style="v" />Cathut ni atangcalah kai teh nang koe lah ka o han. Kai ni nang na patounnae mitnoutnae teh, nang ni hote taminaw hah Izip ram hoi hrawi tâcokhai hnukkhu, hete mon dawk Cathut na bawk han telah atipouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi nihai, kai ni Isarelnaw onae hmuen koe ka pha teh, nangmae mintoenaw e Cathut ni kai teh nangmouh koe na patoun toe telah kai ni ka dei pawiteh, ahnimouh ni hote Cathut e min teh apimaw telah kai bout na pacei awh navah, bangtelamaw bout ka dei pouh han telah Cathut koe a pacei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cathut ni hai KAI teh KAI doeh. KAI ka tet e ni kai teh nangmouh na onae hmuen koe na patoun toe telah Isarelnaw koe bout dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cathut ni Mosi koe bout a dei pouh e teh, nangmae mintoenaw e Cathut, Abraham e Cathut, Isak e Cathut, Jakop e Cathut lah kaawm e BAWIPA ni kai teh nangmouh koe na patoun toe, telah Isarelnaw koe na dei pouh han. Hote min teh a yungyoe e ka min lah ao teh catounnaw ni pahnim hoeh nahanelah ao.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cet nateh Isarel kacuenaw hah pâkhueng nateh, nangmae mintoenaw e Cathut, Abraham e Cathut, Isak e Cathut, Jakop e Cathut lah kaawm e BAWIPA ni kai koe a kamnue teh, nangmouh na khet awh navah, Izip ram vah nangmouh lathueng bangmaw a sak awh tie kamcengcalah ka hmu awh toe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Izip ram vah na khang a e rucatnae dawk hoi nangmouh na ratang vaiteh, Kanaannaw, Hit naw, Amor naw, Periznaw, Hiv naw hoi Jebusitnaw ram, sanutui hoi khoitui a lawngnae ram dawk hrawi kâenkhai hanlah kai ni lawk ka kam telah ahnimouh koe dei pouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahnimouh ni nange lawk a ngâi awh vaiteh, nang ni Isarel kacuenaw hoi Izip siangpahrang koe na kâen vaiteh, Hebrunaw e BAWIPA Cathut teh kaimouh ni kâhmo awh toe. Ramke dawk hnin thum touh lam cei koe kamamae BAWIPA Cathut thuengnae sak thai hanelah, kâ na poe haw, telah na ti pouh han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Izip siangpahrang ni a thaonae kut laipalah teh, cei nahane kâ na poe awh mahoeh tie ka panue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kai ni hai kut ka daw vaiteh, Izip ram dawk ka sak hane kaie kângairunae hoi hote ram teh runae ka poe han. Hathnukkhu, Izip siangpahrang ni nangmouh teh na tâco sak awh han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hote miphun teh Izipnaw koe minhmai kahawi a hmu sak vaiteh, nangmouh ni na tâco awh navah, kuthrawng hoi na tâcawt awh mahoeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bangkongtetpawiteh, napui pueng ni imri, amamae im dawk kaawm e koe sui ngun hoi khohnanaw a hei awh vaiteh, nangmae na canaw hah a pathoup awh vaiteh, Izipnaw e hnopai hah na lawp awh han telah Mosi koe a dei pouh.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi ni, ahnimanaw ni kai na yuem awh mahoeh, ka lawk hai ngâi awh mahoeh, BAWIPA ni nang koe kamnuek mahoeh telah a ti awh han doeh atipouh.
  </para>
  <para style="p">
    <verse number="2" style="v" />BAWIPA ni na kut dawk bang hno maw kaawm telah a pacei navah, sonron ao telah atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Talai dawk tâkhawng haw atipouh e patetlah a tâkhawng navah, sonron teh tahrun lah a coung teh, Mosi ni a yawng takhai.
  </para>
  <para style="p">
    <verse number="4" style="v" />BAWIPA ni na kut hoi a mai dawk man hottelah atipouh e patetlah Mosi ni a kut hoi a man navah, a kut dawk sonron lah bout a coung pouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hottelah, na sak pawiteh ahnimae mintoenaw e Cathut, Abraham e Cathut, Isak e Cathut, Jakop e Cathut lah kaawm e BAWIPA ni nang koe a kamnuenae hah hote taminaw ni a yuem awh han telah atipouh.
  </para>
  <para style="p">
    <verse number="6" style="v" />BAWIPA ni na kut na lungtabue thung tapu haw bout atipouh e patetlah a kut a lungtabue thung a tapu teh a rasa navah, a kut teh a hrikbei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na kut hah na lungtabue dawk bout tapu atipouh e patetlah a kut a lungtabue dawk bout a tapu teh a rasa navah, hmaloe e patetlah bout a coung.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hote taminaw ni na yuem awh hoeh, hmaloe e mitnoutnae hai ngai awh hoehpawiteh, apâhni e mitnoutnae teh a yuem awh han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hote mitnoutnae kahni touh e hah yuem awh hoeh, na lawk hai ngâi awh hoehpawiteh, Nai tui youn touh lat nateh a oung lah rabawk, hottelah tuipui dawk e la e tui teh talai kaphui dawk thi lah ao han telah atipouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hat navah Mosi ni BAWIPA koe Oe ka Bawipa, kai teh ha hoehnahlan hai na san koe lawk na dei hnukkhu hai lawk ka dei thai e lah kaawm hoeh. Lawkdei khokpakhak e lah ka o atipouh.
  </para>
  <para style="p">
    <verse number="11" style="v" />BAWIPA ni hai tami e pahni apinimaw a sak. Lawka, hnâpang, mitdawn, mitang hah apinimaw a sak. Kai, BAWIPA ni ka sak e nahoehmaw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hatdawkvah, atu cet leih. Na pahni dawk ka o vaiteh, nang ni bangtelamaw na dei han tie hah na cangkhai han telah atipouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi ni Oe ka Bawipa, na ngai e tami e kut dawk mah poe lawih telah atipouh navah,
  </para>
  <para style="p">
    <verse number="14" style="v" />BAWIPA ni Mosi koe a lungkhuek teh Levih tami Aron teh na hmau nahoehmaw. Ahni teh lawk a dei thai tie ka panue. Ahni teh nang dawn hanelah a tho lahun. Na kâhmo torei a lunghawi han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang ni ahni hoi kâpan nateh, ahni ni a dei hane lawk hah ka poe han. Nange pahni dawk thoseh, ahnie pahni dawk thoseh, Kai ka o vaiteh nangmouh roi ni bangtelamaw na sak han tie na cangkhai han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahni ni nange yueng lah a dei vaiteh, ahni teh nange pahni patetlah, nang hai ahnie Cathut patetlah na han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang ni mitnoutnaw na sak thai hanelah hete sonron haiyah, na kut dawk pou na sin han telah atipouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mosi ni a masei Jethro koe a cei teh, Izip ram kaawm e ka miphunnaw ni paroup a hring rah maw telah khet hanelah, ahnimouh onae hmuen koe ka cei han telah a kâhei navah, Jethro ni lungmawngcalah hoi cet lawi bout atipouh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hat navah BAWIPA ni, Izip ram lah bout ban leih, nang na ka thet hane taminaw teh koung a due awh toe telah midian ram dawk Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hat navah, Mosi ni a yu hoi capa kahni touh la a kâcui sak teh, Cathut e sonron hah a kut dawk a sin teh, Izip ram lah a ban.
  </para>
  <para style="p">
    <verse number="21" style="v" />BAWIPA ni hai nang ni Izip ram lah na ban teh na pha torei teh, na kut dawk Kai ni na poe e kângairu hnonaw pueng hah Faro siangpahrang hmalah sak pouh. Hottelah, na sak nakunghai, Kai ni ahni teh a lung ka pata sak vaiteh, ahni ni Isarel taminaw hah cetsak mahoeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hattoteh nang ni Faro siangpahrang koe BAWIPA ni Isarel teh ka camin doeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka ca ni Kai na bawk thai nahanlah cetsak loe, na cetsak hoehpawiteh, na camin hai Kai ni ka thei han telah na ti pouh han telah ati.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kahlawng a cei lahun nah, BAWIPA ni Mosi hah rim dawk a kâhmo teh thei hanlah a kâcai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hat navah, Zipporah ni lungtaw a la teh a capa e vuensom a a pouh hnukkhu, a vâ e khok a nep pouh hnukkhu, atangcalah nang teh thipaling ka lawngsakkung vâ lah doeh na o telah atipouh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hat navah, Mosi hah a ceisak. A yu ni vuensomanae yawhawinae kecu dawk nang teh kai koe thipaling na ka palawng e vâ lah na o telah atipouh nae doeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />BAWIPA ni hai Mosi dawn hanelah kahrawng lah cet loe telah Aron koe atipouh e patetlah Aron ni a cei teh, Cathut e mon dawk Mosi hah a kâhmo teh a paco.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosi ni hai ama ka patoun e BAWIPA e lawknaw pueng thoseh, lawk a thui e mitnoutnaw thoseh, Aron koe a dei pouh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hote hmaunawngha kahni touh roi ni Isarel tami kacuenaw a pâkhueng roi hnukkhu,
  </para>
  <para style="p">
    <verse number="30" style="v" />Aron ni Mosi koe BAWIPA e a lawknaw pueng bout a dei teh, taminaw e hmalah mitnoutnaw a kamnue sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hote taminaw ni hai a yuem awh. BAWIPA ni Isarel miphun hah a khetyawtnae thoseh, a khang awh e rektapnae thoseh, a hmu tie a thai awh toteh, a lûsaling awh teh a bawk awh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hathnukkhu, Mosi hoi Aron ni Faro siangpahrang koe a kâen teh Isarelnaw e BAWIPA Cathut ni ka taminaw teh kahrawng vah kai hane pawito hanlah patoun telah ati, atipouh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Faro siangpahrang ni hai BAWIPA lawk a ngâi teh Isarelnaw ka ceisak nahanlah hote Cathut teh apimaw. BAWIPA tie ka panuek hoeh. Isarelnaw ka cetsak mahoeh telah ati.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahnimouh roi ni hai Hebrunaw e Cathut teh kaimouh hoi kâhmo awh toe. Thingyeiyawn hnin thum lamcei koe, kaimae BAWIPA Cathut bawk nahan kâ na poe haw. Nahoeh pawiteh lacik, kâtheikârawngnae hoi maimouh na rek han telah atipouh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izip siangpahrang ni hai Mosi hoi Aron, nangmouh roi ni hete taminaw bangkongmaw thaw na pakak roi. Thaw koe cet nateh thaw tawk awh, atipouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hahoi, ram dawk hote taminaw moiapap awh. Thaw tawk hoeh hanlah nangmouh ni kâ na poe bo aw telah Faro siangpahrang ni ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hote hnin dawk, Faro ni thaw kakuennaw hoi kauknaw a kaw teh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Amhru sak nahane cakawng hmaloe e patetlah taminaw poe awh hanh. Ahnimouh ni cakawng hah amamouh hanlah tawng awh naseh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amhru teh hmaloe e yit touh na saksak han. Payoun sak hanh. Ahnimouh teh a pangak awh dawkvah, cei awh vaiteh maimae Cathut thuengnae ka sak awh han telah ouk a hram awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hatdawkvah, thaw nget ka tawn lah a tawk sak awh. Tami kahawihoehe lawk ngâi a hanh telah atipouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hahoi thaw kakuennaw ni a cei awh teh Faro siangpahrang ni cakawng na poe hoeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cakawng hah hmu thainae hmuen koe tawng awh. Hateiteh, na tawk hane thaw teh payoun mahoeh telah kâlawk ao telah taminaw a thaisak awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hatdawkvah, taminaw ni cakawng hanlah songnawng tawng hanelah Izip ram pueng dawk a kâkapek awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kauknaw ni hai cakawng hmuthainae a tue nah hnintangkuem a tawk awh e patetlah cum totouh tawk awh telah ahnimouh a hroecoe awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Faro siangpahrang e kaukkungnaw ni a rawi e Isarel kahrawikungnaw hah nangmouh ni hmaloe na tawk a e patetlah bangkongmaw paduem hoi sahnin amhru sak e na cum sak awh hoeh telah atipouh teh a hemkhai awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hat navah, Isarel kahrawikungnaw ni Faro siangpahrang koe a cei awh teh, bangkongmaw nang ni na sannaw hettelah na sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na sannaw heh cakawng na poe hoeh. Kaukkungnaw ni hai amhru sak awh, telah ati awh teh kaimouh na hem awh. Na taminaw koe yonnae ao telah a hram awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Faro siangpahrang ni hai nangmouh teh na pangak awh. Na pangak awh. Hatdawkvah, kaimouh ka cei vaiteh BAWIPA thuengnae ka sak awh han telah nangmouh ni na ti awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hatdawkvah, atu cet awh nateh tawk awh. Cakawng na poe awh mahoeh. Hateiteh, amhru teh ama mingming lah pou na sak awh han telah atipouh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hottelah, hnintangkuem a sak e amhru teh na payoun awh mahoeh telah kâ ao dawkvah Isarel kahrawikungnaw ni runae kâhmo awh toe tie a kâpanue awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Faro siangpahrang koehoi a cei awh navah lam vah ahnimouh ka ring e Mosi hoi Aron a hmu awh navah,
  </para>
  <para style="p">
    <verse number="21" style="v" />BAWIPA ni nangmouh roi na khet teh lawk na ceng naseh. Bangkongtetpawiteh, Faro siangpahrang hoi a thaw katawknaw ni kaimouh na panuet sak han hoi thei sak hanlah nangmouh roi ni na sak toe telah atipouh awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosi ni hai BAWIPA koe a cei teh, Oe Cathut, nang ni hete taminaw hah bangkongmaw na rektap. Bangkong kai hah na patoun.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai ni nange kâ lahoi ka dei nahanlah Faro siangpahrang koe kâen hnin hoi kamtawng teh, ahni ni hete taminaw thoe a bo. Nang ni na taminaw khoeroe na rungngang hoeh telah atipouh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koe, Kai ni Faro siangpahrang koe bangtelamaw ka sak han tie atu na panue han. Ahni ni thaonae kut a hmu vaiteh, ka taminaw a tâco sak han. Thaonae kut hmawt vaiteh ahnimouh teh a ram dawk hoi a pâlei han telah atipouh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cathut ni Mosi koe bout a dei pouh e teh, Kai teh Jehovah doeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai ni Abraham, Isak, Jakop tinaw koe, Athakasaipounge Cathut tie min lahoi ka kamnue pouh eiteh, ka min teh Jehovah lah ahnimouh ka panuek sak hoeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahnimouh ni a hmuen pueng koe a kâva awh teh, imyin lah onae Kanaan ram ahnimouh poe han ka tie lawkkam ka caksak toe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Izipnaw ni santoung sak e Isarelnaw e hramnae lawk ka thai toe. Ka lawkkam hah ka pahnim hoeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatdawkvah, Isarelnaw koe a dei pouh hane lawk teh; Kai teh BAWIPA doeh. Kai ni nangmouh, Izipnaw e kut dawk hoi na tâco sak vaiteh, ahnimae rektapnae dawk hoi na rasa han. Kutdawnae, ka patawpoung lah reknae lahoi nangmouh teh na ratang awh han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka tami hanlah na la han. Kai teh nangmae Cathut lah ka o han. Kai teh Izipnaw e kut dawk hoi na ka tâcawt sak e BAWIPA Cathut lah ka o e na panue awh han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kai ni Abraham, Isak, Jakop ti koe poe hanlah lawk ka kam e ram dawk na hrawi awh vaiteh, râw lah na pang sak awh han. Kai teh BAWIPA doeh telah atipouh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hottelah, Mosi ni Isarelnaw koe patuen a dei pouh eiteh, ahnimouh teh a lungthin puenghoi a pata awh teh, puenghoi rektapnae a khang awh dawkvah Mosi e lawk ngâi laipalah ao awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />BAWIPA ni Izip siangpahrang Faro koe cet nateh,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahni ni Isarelnaw hah a ram dawk hoi tâco sak hanlah dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosi ni hai Isarelnaw ni patenghai ka lawk hah ngâi laipalah ao awh teh, vuensoma hoeh naw e pahni dawk hoi dei e kaie lawk hah Faro siangpahrang ni a ngai han namaw telah BAWIPA hmalah atipouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hatdawkvah, BAWIPA ni Mosi hoi Aron teh Isarelnaw Izip ram hoi tâcokhai hanelah, a kaw teh Isarelnaw koe thoseh, Izip siangpahrang Faro koe thoseh a patoun.
  </para>
  <para style="p">
    <verse number="14" style="v" />Isarel kacuenaw e a minnaw teh; Isarel e camin Reuben e canaw teh Enok, Pallu, Hezron hoi Karmi. Het teh Reuben miphun lah ao.
  </para>
  <para style="p">
    <verse number="15" style="v" />Simeon e canaw teh Jemuel, Jamin, Ohad, Jakhin, Zohar hoi Kanaan napui e capa Saw, hetnaw teh Simeon miphun lah ao.
  </para>
  <para style="p">
    <verse number="16" style="v" />Levih e canaw teh Gershon, Kohath hoi Merari. Levih teh a kum 137 touh a hring.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gershon e a ca roi teh Libni hoi Shimei lah ao.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath e a canaw teh Amram, Izhar, Hebron hoi Uzziel lah ao. Kohath teh a kum 133 touh a hring.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari e a ca roi teh Mahli hoi Mushi lah ao. Hetnaw heh Levih miphunnaw lah ao.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amram ni a na pa e tawncanu Jokhebed a yu lah a la teh, Aron hoi Mosi a sak. Amram teh a kum 137 touh a hring.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izhar e a canaw teh Korah, Nepheg hoi Zikhri lah ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Uzziel e a canaw teh Mishael, Elzaphan hoi Sithri lah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aron ni Elisheba, Amminadab canu, Nahshon tawncanu, a yu lah a la teh, Nadab, Abihu, Eleazar, hoi Ithamar hah a sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Korah e a canaw teh Assir, Elkanah hoi Abiasaph lah ao. Hetnaw heh Korah miphunnaw lah ao.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aron capa Eleazar ni Putiel canu a yu lah a la teh, hot hoi Phinehas a sak pouh. Hetnaw heh Levih miphun dawk hoi e kacuenaw lah ao awh.
  </para>
  <para style="p">
    <verse number="26" style="v" />BAWIPA ni Isarelnaw Izip ram dawk hoi tâcawtkhai leih telah atipouh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Isarel miphunnaw Izip ram hoi ka tâcotakhai hanelah, Faro siangpahrang koevah ka dei pouh hane tami teh Mosi hoi Aron doeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />BAWIPA ni Izip ram vah Mosi koe a pâpho pouh e teh;
  </para>
  <para style="p">
    <verse number="29" style="v" />Kai teh Jehovah doeh. Kai ni lawk na thui e pueng hah Izip siangpahrang Faro koe na dei pouh han telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mosi ni, kai teh vuensoma hoeh e pahni ka tawn dawkvah, Faro siangpahrang ni ka lawk hah bangtelamaw a ngâi thai han telah BAWIPA hmalah atipouh.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koe, nang teh faro siangpahrang e cathut lah na o sak. Na hmau Aron teh na profet lah ao han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kâ na poe e naw pueng hah nang ni bout na dei han. Faro siangpahrang ni Isarelnaw hah a ram dawk hoi a tâco sak nahanlah na hmau Aron ni ahni koe a dei pouh han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai ni hai Faro e lung ka pata sak vaiteh, Izip ram dawk kaie kângairu mitnoutnaw hah ka pung sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hateiteh, Faro siangpahrang ni nangmae lawk hah ngâi laipalah ao han. Kai ni hai Izip ram lathueng ka kut ka dâw vaiteh, kalenpounge lacik hoi ka ransahu, ka tami Isarelnaw hah Izip ram hoi ka tâcokhai han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hottelah, Izip ram lathueng ka kut ka dâw vaiteh, Isarelnaw ahnimouh koehoi ka tâcokhai toteh, Kai teh BAWIPA doeh tie Izipnaw ni a panue awh han telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi hoi Aron ni BAWIPA e kâpoelawk patetlah a sak roi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Faro koe a dei pouh roi navah, Mosi teh a kum 80, Aron teh a kum 83 touh a pha roi.
  </para>
  <para style="p">
    <verse number="8" style="v" />BAWIPA ni Mosi hoi Aron koe bout a dei pouh e teh,
  </para>
  <para style="p">
    <verse number="9" style="v" />Faro siangpahrang ni nangmouh koe kângairuhno na patue haw tetpawiteh, na sonron hah lat nateh a hmalah tâkhawng pouh telah Aron koe a dei pouh. Sonron haiyah tahrun lah a kangcoung han telah atipouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosi hoi Aron ni Faro siangpahrang koe a kâen roi teh BAWIPA ni a dei e patetlah a sak pouh roi. Aron ni Faro siangpahrang hoi a sannaw e hmalah sonron a tâkhawng teh tahrun lah a kangcoung.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hat navah, Faro siangpahrang ni lungkaangnaw camkathoumnaw hah a kaw teh Izip ram e mitpaleikathoumnaw nihai, hot patetlah a sak awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A sin awh e sonronnaw hah a tâkhawng awh teh tahrun lah a kangcoung awh. Hateiteh, Aron e sonron ni ahnimae sonronnaw hah koung a payawp.
  </para>
  <para style="p">
    <verse number="13" style="v" />BAWIPA ni a dei e patetlah Faro siangpahrang teh a lungpata sak teh, ahnimae lawk hah ngâi laipalah ao.
  </para>
  <para style="p">
    <verse number="14" style="v" />BAWIPA nihai, Faro siangpahrang e lung a pata sak teh Isarelnaw hah tâcawt sak hoeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amom vah, Faro siangpahrang koe cet haw. Ahni ni tui namran lah a cei han. Ahni a pha hoehnahlan tuipui namran lah kangdout haw. Tahrun lah kangcoung e sonron hah na kut dawk sin haw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hebru miphunnaw e Cathut Jehovah ni kaie taminaw ni kahrawng vah Kai na bawk hanelah, ahnimouh hah tâcawt sak leih telah kai heh nang koe na patoun toe. Nang ni atu totouh ngâi laipalah na o awh rah.
  </para>
  <para style="p">
    <verse number="17" style="v" />BAWIPA ni Kai teh BAWIPA doeh tie hah nang ni bangtelamaw na panue thai han tetpawiteh, ka sin e sonron hoi tuipui ka hem vaiteh hote tui teh thi lah a coung han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuipui dawk kaawm e tanganaw a due awh han. Tuipui hai a hmui a tho han. Izipnaw ni tuipui tui a panuet awh han. Akong hah bout dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="19" style="v" />BAWIPA ni Mosi koe bout a dei pouh e teh, Aron koe, na sonron sin nateh Izip ram kaawm e palang, tuipui, tuikamuem tui, tuido hoi tuiphueknaw pueng e lathueng vah kut dâw haw. Izip ram pueng dawk thing manang, talung hlaamnaw pueng dawk thi ao hane kong hah dei pouh telah atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosi hoi Aron ni BAWIPA ni a dei e patetlah a sak roi teh, Aron ni Faro siangpahrang hoi a sannaw e hmalah sonron a pho teh tuipui a hem teh tui pueng teh thi lah a coung.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuipui dawk kaawm e tanganaw hai a due. Tuipui teh a hmui a tho dawkvah Izip taminaw ni tuipui hah net thai awh hoeh. Izip ram pueng dawk thi hah koung ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izip miphun camkathoumnaw ni hai camthoumnae lahoi hottelah a sak awh. BAWIPA ni a dei tangcoung patetlah Faro siangpahrang teh a lungpata teh ahnimae lawk ngâi laipalah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Faro teh a im a ban teh hote hnonaw hah a lungthin dawk tat hoeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hat navah, Izipnaw ni tuipui tui hah a nei thai awh hoeh dawkvah tui nei hane a hmu thai a nahanlah tuipui rai lah tui a tai awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />BAWIPA ni tuipui a hem hnukkhu hnin sari touh aloum sak.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koe, nang ni Faro siangpahrang koe cet nateh Ka taminaw ni Kai na bawk nahanelah tâcawt sak leih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka tâcawt sak mahoeh tetpawiteh na ram pueng ekka hoi bout ka rek han rah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuipui ni ekka moi a tâco sak vaiteh na im dawk, inae rakhan dawk, ikhun van thoseh, na sannaw e im dawk thoseh, na taminaw e a lathueng thoseh, na takhuen dawk thoseh, tavai na kanawknae kawlung dawk thoseh a luen han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangmouh koehoi kamtawng vaiteh na taminaw, na sannaw pueng lathueng vah a luen awh han telah BAWIPA ni a dei e hah thaisak loe telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />BAWIPA ni Mosi koe bout a dei pouh e teh, Aron ni palang, tuipui tui, talînaw e lathueng vah sonron a sin teh kut a dâw navah, Izip ram dawk ekkanaw luen sak hanelah dei pouh telah atipouh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aron ni Izip ram dawk kaawm e tuinaw lathueng kut a dâw teh ekkanaw ni a tho teh Izip ram pueng koung a ramuk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Camkathoumnaw ni hai camthoumnae lahoi hottelah a sak teh ekkanaw Izip ram dawk a thokhai awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hat navah, Faro siangpahrang ni Mosi hoi Aron a kaw teh, BAWIPA ni ekkanaw hah kai hoi ka taminaw koehoi takhoe hanelah dei pouh leih. Isarelnaw ni BAWIPA koe thuengnae kâ ka poe han toe telah atipouh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosi ni hai nang hoi na imnaw dawk hoi ekkanaw takhoe teh, tuipui dawk dueng o sak hanlah, nang hoi na sannaw, na taminaw hanlah, kai ni ngaithoumnae tueng na khoe atipouh eiteh,
  </para>
  <para style="p">
    <verse number="10" style="v" />tangtho ngaithoumnae het leih atipouh teh, Mosi ni kaimae Cathut Jehovah hoi kâvan e cathut awm hoeh tie na panue nahanlah na dei e patetlah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ekkanaw teh nang hoi na imnaw, na sannaw, na taminaw koehoi a tâco teh tuipui dawk dueng ao han telah Mosi ni a dei pouh hnukkhu,
  </para>
  <para style="p">
    <verse number="12" style="v" />Aron hoi cungtalah ahni koehoi a tâco roi teh, Faro siangpahrang e lathueng vah a pha sak e ekkanaw kecu dawk Mosi ni a ratoum.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi ni a hei e patetlah BAWIPA Cathut ni a sak pouh teh, ekkanaw teh imnaw, khonaw, ayawnnaw dawk a due awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ronaw a pâkhueng awh dawkvah ram pueng dawk a hmui a tho.
  </para>
  <para style="p">
    <verse number="15" style="v" />Faro siangpahrang ni ahawi toe ti a panue navah, BAWIPA ni a dei e patetlah a lungpata teh ahnimae lawk hah ngâi laipalah bout ao.
  </para>
  <para style="p">
    <verse number="16" style="v" />BAWIPA ni Mosi koe bout a dei pouh e teh, Izip ram e vaiphunaw pueng heh tangkarang lah o sak hanelah Aron ni sonron a pho teh vaiphu hah hem hanelah dei pouh atipouh e patetlah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Aron ni sonron a pho teh vaiphu hah a hem. Vaiphu teh tami dawk thoseh, saring koe thoseh, tangkarang lah ao. Izip ram pueng dawk kaawm e vaiphunaw pueng teh tangkarang lah a coung.
  </para>
  <para style="p">
    <verse number="18" style="v" />mitpaleikathoumnaw ni hai tangkarang lah coung sak hanelah a thoumnae lahoi hottelah a sak a eiteh sak thai awh hoeh. Hatdawkvah, tami hoi saringnaw pueng dawk tangkarangnaw ao.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hat navah, mitpaleikathoumnaw ni hote hno heh Cathut e kutdawn doeh telah Faro siangpahrang koe a dei pouh awh. Hateiteh, BAWIPA ni a dei e patetlah Faro siangpahrang teh a lungpata teh ahnimae lawk hah ngâi laipalah bout ao.
  </para>
  <para style="p">
    <verse number="20" style="v" />BAWIPA ni hai nang ni amom thaw haw. Tui namran lah ka cet e Faro siangpahrang hmalah kangdout nateh BAWIPA ni, ka taminaw ni Kai na bawk nahanelah cetsak leih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na cetsak hoehpawiteh, nang hoi na sannaw, taminaw, imnaw dawkvah bitsei hah kai ni ka patoun vaiteh Izipnaw onae im, kangduenae talai teh bitsei hoi akawi han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kai teh talai van pueng dawk BAWIPA lah ka o e na panue thai nahanelah kaie taminaw onae Goshen ram dawk teh hote hnin nah kapek vaiteh, hote ram dawk bitsei awm mahoeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hottelah ka taminaw hoi na taminaw rahak vah kapeknae ka o sak han. Tangtho vah hete mitnoutnaw teh ao han tie heh dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hottelah BAWIPA ni a sak dawkvah Faro im hoi a kamtawng teh a sannaw e im hoi Izip ram pueng dawk bitsei moikapap a tho teh, hote bitseinaw kecu dawk Izip ram a rawk.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hat navah, Faro siangpahrang ni Mosi hoi Aron a kaw teh, nangmouh ni hote ram dawk na Cathut koe thuengnae sak hanelah cet awh telah ati eiteh,
  </para>
  <para style="p">
    <verse number="26" style="v" />Mosi ni hettelah sak hane nahoeh. Ka sak awh pawiteh, Izipnaw ni a panuet e hno hoi BAWIPA Cathut koe thuengnae ka sak awh han nahoehmaw. Izipnaw e mithmu vah ahnimouh hanlah panuettho e hno hoi thuengnae ka sak awh boipawiteh, talung hoi na dei awh mahoeh na maw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hatdawkvah, kahrawng hnin thum lamcei koe, ka cei awh vaiteh kaimae BAWIPA Cathut ni a dei e patetlah thuengnae ka sak awh han telah a dei pouh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Faro siangpahrang ni hai nangmae BAWIPA Cathut hah kahrawng vah na thueng awh nahanelah na cei awh han. Hatei, kahlat lah na cet awh mahoeh. Kai hanlah na kâhet pouh ei telah ati.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koe, Faro siangpahrang koe cet nateh dei pouh, Hebrunaw e Cathut Jehovah ni, ka taminaw ni Kai koe thuengnae a sak awh hanelah tâcawt sak leih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka cetsak mahoeh telah na cakâ rah boi pawiteh,
  </para>
  <para style="p">
    <verse number="3" style="v" />BAWIPA e thaonae kut teh ayawn e kaawm saring, marang, la, kalauk, tu, hoi maitonaw lathueng ka patawpoung e lacik ka pha sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />BAWIPA ni Isarelnaw e saring hoi Izipnaw e saring rahak kapeknae a tawn vaiteh Isarelnaw e saring teh buet touh boehai dout mahoeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawipa ni tueng a khoe e patetlah tangtho vah BAWIPA ni hete ram dawk a sak han telah ati.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tangtho vah hote hno a sak teh, Izipnaw e saringnaw pueng koung a due. Hatei, Isarelnaw e saringnaw teh buet touh boehai dout hoeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Faro siangpahrang ni tami a patoun teh, Isarelnaw e saring buet touh boehai dout hoeh tie a panue. hat ei, a lung bout a pata teh Isarelnaw tâcawt sak hoeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bawipa ni takhuen dawk e hraba kut hoi pham nateh, Mosi ni Faro siangpahrang hmalah kahlun lah kahei naseh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hote hraba teh Izip ram pueng dawk vaiphu dikkaneng e lah ao vaiteh, ram pueng dawk e tami hoi moithangnaw koe parep hoi kakawi e patawnae kathout lah ao han telah Mosi hoi Aron koe a dei pouh e patetlah,
  </para>
  <para style="p">
    <verse number="10" style="v" />ahnimouh roi ni takhuen dawk e hraba hah a pham teh Faro hmalah kangdue teh kahlun lah Mosi ni a kahei. Hote hraba teh tami hoi moithangnaw dawk parep hoi kakawi e yako patawnae lah ao.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mitpaleikathoumnaw ni yako kecu dawk Mosi hmalah kangdout ngam awh hoeh. Hote yako teh mitpaleikathoumnaw koe thoseh, Izip taminaw koe thoseh, koung a kâkai.
  </para>
  <para style="p">
    <verse number="12" style="v" />BAWIPA ni Faro siangpahrang e lung a pata sak dawkvah, Mosi koe a dei pouh e patetlah ahnimae lawk hah ngâi laipalah ao.
  </para>
  <para style="p">
    <verse number="13" style="v" />BAWIPA ni Mosi koe, amom thaw nateh Faro hmalah kangdout nateh Hebrunaw e Cathut Jehovah ni, ka taminaw ni Kai na bawk thai nahanelah tâcawt sak leih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na hoehpawiteh, atu e tueng dawk teh, nang hoi na sannaw koe thoseh, na taminaw koe thoseh, Kaie reknae ka pha sak han. Kai patetlah e talai van pueng dawk awm hoeh tie hah na panue han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka kut ka dâw vaiteh nang hoi na taminaw hah lacik hoi ka rek han. Nang haiyah talai dawk hoi takhoe lah na o han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Atangcalah, ka hnosakthainae hah nang patue hanelah, talai van pueng dawk ka min kamsawng nahanelah Kai ni nang teh na tawm toe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nang ni ka taminaw tâcawt sak laipalah na rektap rah maw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khenhaw! Izip ram kamtawngnae koehoi atu totouh kabawt boihoeh e roun, tangtho atu e tueng dawk puenghoi ka rak sak han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hatdawkvah, kahrawng kaawm e saringnaw hoi kaawm e pueng pakhum sak leih. Im na pakhum hoehpawiteh ayawn dawk hmu e tami pueng hoi saringnaw pueng, roun ni bawt sin vaiteh, koung a due awh hane hah dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />BAWIPA e lawk ka taket e Faro siangpahrang e a sannaw teh a san hoi a saringnaw im lah a yawng sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />BAWIPA e lawk banglahai ka ngai hoeh e taminaw teh a sannaw hoi a saringnaw teh ayawn dawk a ta awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />BAWIPA ni Izip ram kho ka sak tami pueng lathueng thoseh, saringnaw pueng lathueng thoseh, ayawn dawk e thingkung pueng lathueng thoseh, roun a bo nahanelah na kut kahlun lah dâw telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosi ni a sonron kahlun lah a dâw navah, BAWIPA ni keitat hoi roun a patoun. Hmai hai talai dawk a bo. Hottelah BAWIPA ni Izip ram dawk, roun a bo sak dawkvah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Izip ram kamtawngnae koehoi vai touh hai ka bawt boihoeh e hmai hoi kâkalawt e roun puenghoi a bo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Izip ram pueng, ayawn dawk kaawm e tami hoi saringnaw, phonaw, thingkungnaw pueng teh roun ni reprep a dei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hateiteh, Isarelnaw khosaknae Goshen ram dawk dueng doeh roun bawt hoeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hat navah, Faro ni Mosi hoi Aron kaw hanlah tami a patoun. Hete hno dawk kai ka yon toe. BAWIPA teh a lan. Kai hoi ka taminaw teh ka yon awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A khout toe. Athakaawme keitat hoi roun puenghoi ka bawt e dap sak hanlah BAWIPA koe kâhet leih. Kai ni nangmouh ngang laipalah karanglah na ceisak han telah atipouh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosi ni hai khopui thung ka cei nah BAWIPA hmalah ka kut ka dâw han. BAWIPA ni talai pui a uk tie nang panue sak hanelah kei hoi roun ka bawt e a roum sak han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hateiteh, nang hoi na sannaw ni BAWIPA Cathut na taket awh hoeh rah tie ka panue telah atipouh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pahla hoi catun hai roun ni a dei. Catun teh a paw hoi akawi. Pahla haiyah a paw a tang toe.
  </para>
  <para style="p">
    <verse number="32" style="v" />Catun hoi cang teh a pâw hoeh rah dawkvah roun ni dêi hoeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosi ni Faro koe khopui alawilah a cei hnukkhu, BAWIPA hmalah kuttabei a na teh, keitat hoi roun teh a roum. Talai kho hai rak hoeh toe.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hottelah, kho a dep, keitat hoi roun ka bawt e hai a roum e Faro siangpahrang ni a hmu navah, bout a yon awh teh a sannaw hoi a lung bout a pata awh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Faro siangpahrang a lung bout a pata sak dawkvah, BAWIPA ni Mosi koe a dei pouh e patetlah Isarelnaw tâcawt sak laipalah bout ao.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi, Faro koe cet nateh Kai ni hete mitnoutnaw heh ahnie hmalah patue hane lah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Izip ram dawk ka sak e hnonaw hoi Izip taminaw koe ka sak e mitnoutnaw heh, na ca catounnaw koe na dei pouh teh, Kai teh Jehovah doeh tie nangmouh ni na panue awh nahanelah thoseh, ahni hoi a sannaw e lung teh Kai ni ka pata sak telah atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi hoi Aron ni Faro siangpahrang koe a kâen roi teh Hebrunaw e Cathut Jehovah ni, nang ni ka hmalah na kârahnoum laipalah na sittouh maw na o han rah. Ka taminaw ni Kai na bawk na hanelah tâcawt sak leih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka taminaw na tâcawt sak hoehpawiteh, khenhaw! na ram dawk tangtho samtongnaw ka patoun han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Talai kamnuek laipalah ahnimouh ni talai muen a ramuk awh han. Roun ni be a dêi hoeh e kaawm rae naw pueng thoseh, nangmouh hanlah talai dawk kapâw e a kung pueng thoseh a ca awh han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na mintoenaw talai dawk khosak kamtawngnae koehoi atu totouh a hmu awh boihoeh e hah na imnaw, na sannaw e imnaw, Izipnaw e imnaw dawk akawi awh han telah a dei pouh roi hnukkhu Faro koehoi a kamlang roi teh a tâco roi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Faro siangpahrang e a sannaw ni hai hete taminaw ni maimouh na totouh maw na tarawk awh han. Hote taminaw ni amamae Cathut Jehovah koe thueng hanelah tâcawt sak leih. Izip ram a rawk e heh na panuek hoeh rah maw telah a dei pouh navah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi hoi Aron hah Faro siangpahrang koe bout a kâen sak awh teh, nangmae Cathut Jehovah thueng hanelah tâcawt awh. Hateiteh, apipi maw na ka cet awh han telah a pacei navah,
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosi ni, kaimouh teh camo, matawng, ka capanaw, ka canunaw, tu hoi maitonaw hoi ka cei awh han. Bangkongtetpawiteh, BAWIPA koe pawito han ao telah bout atipouh navah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Faro siangpahrang ni nangmouh hoi na canaw teh kai ni na tâco sak e patetlah BAWIPA teh nangmouh koe awm naseh. Kâhruetcuet awh. Kahawi hoeh e pouknae na tawn awh boma.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hottelah mahoeh. Hmaloe na hei e patetlah tongpa dueng cet awh nateh BAWIPA Cathut bawk awh, telah atipouh teh ahnimouh teh ama koehoi a pâlei.
  </para>
  <para style="p">
    <verse number="12" style="v" />BAWIPA ni samtongnaw hah Izip ram dawk a patoun teh roun ni a dêi nawi e talai dawk kaawm rae akungnaw pueng ca sak hanelah, Izip ram lah na kut dâw telah Mosi koe atipouh e patetlah,
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi ni a sonron hah Izip ram lathueng vah a dâw teh, hote kanîruirui, karum tuettuet Kanîtholah hoi BAWIPA ni kahlî a tho sak teh, amom torei teh Kanîtholae kahlî ni samtongnaw hah a thokhai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hote samtong ni Izip ram pueng muen a ramuk teh ramrinaw pueng dawk a kâhat awh teh moiapap awh. Hote samtongnaw teh ayan hoi atu totouh awm boihoeh. Ao hnukkhu hai bout awm mahoeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Talai pueng muen ka tamang lah a ramuk teh ram pueng dawk e phovai kaawm pueng, roun ni a dêi nawi e a paw kaawm e naw pueng a ca dawkvah, Izip ram pueng dawk kaawm e thingkung phokungnaw dawk kahring e banghai awm hoeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hat toteh, Faro siangpahrang ni Mosi hoi Aron hah karanglah a kaw teh, nangmae Cathut Jehovah koe thoseh, nangmouh koe thoseh ka yon toe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hatdawkvah, atu vai touh ka yonnae ngaithoum ei. Nangmae BAWIPA Cathut ni het duenae lacik buet touh dueng kai koehoi takhoe hanelah na kâ pouh ei, atipouh e patetlah,
  </para>
  <para style="p">
    <verse number="18" style="v" />Mosi ni ahni koehoi a cei teh BAWIPA koe ngaithoumnae a hei.
  </para>
  <para style="p">
    <verse number="19" style="v" />BAWIPA ni a tha kaawm e kanîloumlae kahlî a patoun teh, hote kahlî ni samtongnaw hah a tawm teh thipaling talî dawk a pabo. Izip ram dawk samtong buet touh boehai awm hoeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hateiteh, BAWIPA ni Faro e a lung bout a pata sak dawkvah, Isarel canaw tâcawt sak laipalah bout ao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hahoi, BAWIPA ni Izip ram dawk rumram e hmonae tho laipalah thupthup payam e hmonae o sak hanelah na kut kahlun lah dâw haw telah Mosi koe a dei pouh e patetlah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosi ni a kut kahlun lah a dâw navah Izip ram pueng dawk kingkahmawt e hmonae hnin thum touh ao sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hat navah, buet touh hoi buet touh hai kahmawt awh hoeh. Hnin thum touh thung apihaiyah a onae hmuen koehoi thaw awh hoeh. Hatei, Isarelnaw teh a onae hmuen koe angnae a hmu awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hat navah, Faro siangpahrang ni Mosi hoi Aron a kaw teh BAWIPA bawk hanelah tâcawt awh leih. Hatei, camonaw hrawi awh nateh tu, maitonaw teh cettakhai awh naseh, telah atipouh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi ni hottelah boipawiteh, ka Cathut Jehovah ka thueng awh nahanelah satheinaw, hmaisawi thueng han hnopainaw hah nang ni poe hanelah a ngai han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kaimouh ni saringnaw hah ka hrawi awh han. Buet touh boehai ka tat awh mahoeh. Bangkongtetpawiteh, hotnaw thung dawk hoi kaimae Cathut Jehovah thueng nahanelah ka rawi awh han. BAWIPA bangpatet e saring hoi maw ka bawk awh han tie hote hmuen koe a pha awh hoehroukrak ka panuek awh hoeh telah atipouh navah,
  </para>
  <para style="p">
    <verse number="27" style="v" />BAWIPA ni Faro siangpahrang e a lung bout a pata sak dawkvah Isarelnaw tâcawt sak hoeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosi hanlah kai koehoi tâcawt leih. Ka minhmai bout na hmu hoeh nahanlah kâhruetcuet. Ka minhmai na hmunae hnin nah na due han atipouh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosi ni hai na dei e teh ahawi. Na minhmai bout kahmawt mahoeh atipouh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hat navah, BAWIPA ni Faro siangpahrang hoi Izip ram dawk lacik ka tho sak han. Hathnukkhu, nangmouh na tâco sak awh han. Na tâco sak awh toteh nangmouh pâlei lah na pâlei awh han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Isarel tami tongpa ni imri tongpa koe thoseh, napui ni imri napui koe thoseh, sui, ngun hoi khohnanaw hei hanlah, taminaw koe dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahnimouh ni a hei e patetlah Izip taminaw ni poe ngainae pahrennae lung hah BAWIPA ni a tawn sak. Mosi haiyah Izip ram dawk Faro siangpahrang e a sannaw hoi a taminaw hmalah bari kaawm e lah ao.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hat navah, Mosi koe BAWIPA ni a dei e teh karumsaning vah Izip ram ka kâva han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawitungkhung dawk ka tahung e Faro e capa camin koehoi cakang phawmnae koe kaawm e sannu e camin totouh, Izip ram kaawm e camin pueng hoi saringnaw e ca caminnaw pueng koung a due awh han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Izip ram pueng dawk ayan hoi kaawm boihoeh e hoi hmalah hai bout kaawm hoeh hane kalenpounge khuikanae ao han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hateiteh, BAWIPA ni Izipnaw hoi Isarelnaw kapeknae a tawn ti na panue thai nahanelah, Isarel tami buet touh boehai ui ni rauk mahoeh telah atipouh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na sannaw pueng ni hai kai koe tho awh nateh tabut laihoi cet ati han. Nang hoi na hnukkâbangnaw koung tâcawt telah a dei hnukkhu, kai ka cei han telah a dei pouh teh a lungkhuek teh Faro koehoi a tâco.
  </para>
  <para style="p">
    <verse number="9" style="v" />BAWIPA ni hai kângairu e hnonaw Izip ram dawk moiapap nahan, Faro siangpahrang ni nangmae lawkngai laipalah ao han telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosi hoi Aron ni Faro hmalah hete kângairunae a sak roi eiteh, BAWIPA ni Faro siangpahrang e a lungpata sak dawkvah Isarel canaw a ram dawk hoi tâconae kâ poe hoeh.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Izip ram vah Mosi hoi Aron koe a dei pouh e teh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hete thapa heh nangmouh hanelah a kum tangkuem dawk apasuekpoung e thapa lah ao han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangmouh roi ni Isarel rangpuinaw koe lawk na thui roi hane teh; Hete thapa hnin hra touh hnin vah nangmanaw pueng ni mae imthungkhu tangkuem dawk im touh ni tuca buet touh rip na sin awh han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Imthung kathoeng teh tuca buet touh hoi kâki hoehpawiteh imri kahnai e koe a bawng vaiteh tami nâyittouh maw tie a parei hnukkhu, boung cakhuem hane tuca hah a sin han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuca thoseh, hmaeca thoseh, nangmouh ni na sin e saring teh kacueme hoi âvâ ka cawt hoeh rae a tan han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hote tucanaw hah hote thapa hnin hra hlaipali totouh ring vaiteh, tangmin vah Isarel miphun, kamkhuengnaw ni a thei awh han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuca moi kacate im takhang tâphai hoi tangkhang dawk tu thi na hluk han.
  </para>
  <para style="p">
    <verse number="8" style="v" />A moi teh hmai pahai hnukkhu, hote tangmin dawk tonphuenhoehe, kakhat e anhna hoi na ca awh han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moi ka heng lah thoseh, thawng lahoi hai thoseh na cat awh mahoeh. A lû, a khok, a kosanaw hoi cungtalah hmai pahai hnukkhu na ca awh han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hote moi hah khodai totouh na tat mahoeh. Youn touh hai na cawi sak pawiteh, hmai na sawi han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bangtelamaw na ca awh han tetpawiteh, taisawm kâyeng hoi, khokkhawm hoi, sonron patuep lahoi karanglah na ca awh han. Hetteh, BAWIPA e ceitakhai pawi doeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bangkongtetpawiteh, hote karum dawk Izip ram pueng dawk ka cei vaiteh Izipnaw e camin hoi saringnaw e ca caminnaw pueng ka thei han. Izipnaw e cathutnaw hah lawk ka ceng han. Kai teh BAWIPA doeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuca e a thi teh nangmouh na onae im dawk nangmae mitnoutnae lah ao han. Hote a thi ka hmu navah, Kai ni nangmouh teh na ceitakhai awh han. Hottelah, Izip ram ka rek nah nangmouh karaphoekung lacik teh nangmouh koe phat mahoeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hete hnin teh nangmouh hanlah pahnim thai hoeh e hnin lah ao vaiteh na ca catoun totouh, hete hnin dawk Cathut koe pawi a to awh han. Kâlawk lah ao dawkvah hote pawiteh pou na to awh han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnin sari touh thung tonphuenhoehe na ca awh han. Apasuek hnin nah ton hah imnaw dawk hoi na takhoe awh han. Apasuek hnin koehoi hnin sari totouh ton phuen e vaiyei ka cat e tami teh Isarel miphun dawk hoi takhoe lah ao han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Apasuek hnin thoseh, asari hnin nah thoseh kathoung kamkhuengnae na sak awh han. Hote hnin dawkvah, taminaw ni canei hoi kâkuen e thaw hloilah alouke thaw tawk awh mahoeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hote tonphuenhoehe pawito ngainae teh, hote hnin dawk na taminaw Izip ram hoi ka tâco sak. Hatdawkvah, kâlawk ao e patetlah na ca catoun totouh hote hnin hah na ya awh han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thapa yung pasuek, hnin hra hlaipali hnin tangmin hoi kamtawng teh hnin 20 tangmin totouh, nangmouh ni tonphuenhoehe na ca awh han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hnin sari touh thung imnaw dawk ton na tat awh mahoeh. Ton phuen e vaiyei kacate ramlouk tami thoseh, khoca thoseh Isarelnaw koehoi takhoe lah ao han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangmouh na onae hmuen pueng koe ton phuen e vaiyei na cat awh mahoeh. Tonphuenhoehe vaiyei dueng na ca han atipouh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hot navah, Mosi ni Isarel tami kacuenaw hah a kaw teh, na imthung tangkuem ni tuca hah ceitakhai pawi hanlah thet awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dingsala dawn lat awh nateh kawlung dawk ta e a thi dawk ranup nateh takhang dawk hluk awh. Hathnukkhu hoi amom totouh apihai ma im takhang alawilah na tâcawt a mahoeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bangkongtetpawiteh, BAWIPA teh Izipnaw thei hanlah a kâhlai han. Im takhang dawk e thi a hmu toteh BAWIPA ni takhang a ceitakhai han. Karaphoekung teh nangmouh reknae poe hanlah imthung kâen sak mahoeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangmouh hoi na canaw koe lawkkamnae ao dawkvah hote hno heh pou na tarawi awh han.
  </para>
  <para style="p">
    <verse number="25" style="v" />BAWIPA ni poe hanlah kam e ram dawk na pha awh toteh, hete phunglam heh na sak awh han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmae ca catounnaw ni hete phung heh bang ngainae maw na sak telah na pacei pawiteh,
  </para>
  <para style="p">
    <verse number="27" style="v" />BAWIPA ni Izipnaw a thei navah maimae imthungnaw a hlout sak. Izip ram kho ka sak e Isarelnaw e imnaw a ceitakhai e, BAWIPA e ceitakhai pawi lah ao telah bout na dei pouh han telah Mosi ni a dei hnukkhu, ahnimouh ni a lûsaling awh teh a bawk awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />BAWIPA ni Mosi hoi Aron koe lawk a thui e patetlah Isarelnaw ni a sak awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Karumsaning vah, BAWIPA ni bawitungkhung dawk ka tahung e Faro e camin koehoi kamtawng teh thongkabawtnaw e camin totouh, Izipnaw e camin pueng thoseh, saringnaw e camin pueng thoseh koung a thei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hote tangmin vah, Faro siangpahrang hoi a sannaw, Izipnaw ni a thaw awh teh, im tangkuem tami a due dawkvah, Izip ram pueng dawk khuikanae puenghoi a pha.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hote tangmin vah, Mosi hoi Aron a kaw teh, nangmouh roi hoi Isarelnaw thaw awh nateh ka taminaw koehoi tâcawt awh. Na hei e patetlah cet awh nateh Jehovah hah bawk awh leih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangmouh ni na hei e patetlah tu, maitonaw hrawi awh nateh cet awh. Kai haiyah yawhawinae na poe awh, telah atipouh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Izipnaw ni maimouh pueng hai tami kadout lah doeh koung o awh toe telah ati awh teh, Isarelnaw Izip ram dawk hoi karanglah tâco sak hanlah a dei pouh awh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hote taminaw ni ton phuen hoeh rae tavai a la awh teh, tavai kanawknae kawlungnaw a la awh teh, hni hoi a tangoung awh teh a phu awh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mosi ni a dei e patetlah Isarelnaw ni Izipnaw koe suingun, khohnanaw hah a hei awh.
  </para>
  <para style="p">
    <verse number="36" style="v" />A hei awh e patetlah poe ngainae lungthin BAWIPA ni Izipnaw a tawn sak teh, Izipnaw e hnopainaw a lawp awh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Isarelnaw napui camo touk laipalah, tongpa ting taruk touh, Raameses khopui hoi a tâco awh teh Sukkoth lah a cei awh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Alouklouke taminaw haiyah a tawn e tu, maito hoi saringnaw pueng hoi a kâbang awh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Izip ram hoi a phu e tonphuenhoehe tavai a la awh teh, tonphuenhoehe a tau awh. Bangkongtetpawiteh, Izip ram hoi tang a pâlei awh dawkvah, canei kawi kârakueng mang awh hoeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Isarelnaw teh Izip ram vah kum 430 touh imyin lah ao awh.
  </para>
  <para style="p">
    <verse number="41" style="v" />A kum 430 akuepnae hnin dawk BAWIPA e ransanaw teh Izip ram hoi a tâco awh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Izip ram hoi a tâcokhai dawkvah hote tangmin teh BAWIPA hanlah a ya awh. Hatdawkvah, hote tangmin teh Isarelnaw ni pout laipalah pou a ya awh e tangmin lah ao.
  </para>
  <para style="p">
    <verse number="43" style="v" />BAWIPA ni Mosi hoi Aron koevah, ceitakhai pawi phunglam teh hettelah ao. Ceitakhai pawiteh alouke miphun ni cat mahoeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hateiteh, tangka hoi ran e san ni teh vuensoma hnukkhu a ca han.
  </para>
  <para style="p">
    <verse number="45" style="v" />Miphun alouke hoi san lah hno e naw ni teh cat mahoeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Im buet touh dawk na ca han. A moi im alawilah na sin mahoeh. A hru hai na khoe mahoeh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Isarelnaw pueng ni hote pawiteh na tarawi awh han.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hahoi, nangmouh koe kârayen e Jentelnaw ni BAWIPA hanlah ceitakhai pawi sak han ngai awh pawiteh, tongpanaw pueng vuensoma awh naseh. Hathnukkhu hote tami teh khoca patetlah ao dawkvah pawi kâen naseh. Vuensom ka a hoeh e teh hote pawi cat thai hoeh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Khocanaw hoi nangmouh koe kârayennaw hanlah phunglam buet touh dueng doeh kaawm telah BAWIPA ni Mosi hoi Aron koe a dei pouh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hottelah, BAWIPA ni Mosi hoi Aron koe a dei pouh e patetlah Isarelnaw ni a sak awh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hote hnin dawk BAWIPA ni Isarelnaw a ransanaw khue hoi Izip ram hoi a tâcokhai.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi a kaw teh Isarelnaw thung dawk hmaloe khe e,
  </para>
  <para style="p">
    <verse number="2" style="v" />tami thoseh, saring thoseh ca caminnaw pueng Kai hanlah thoung sak awh. Kaie hno lah ao telah atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi ni hai nangmouh santoungnae Izip ram hoi tâconae hete hnin heh pahnim awh hanh. BAWIPA ni nangmouh teh a thaonae kut lahoi hote ram dawk hoi na hrawi awh toe. Ton phuen vaiyei cat awh hanh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abib thapa atu e hnin dawk nangmouh teh na tâco awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />BAWIPA ni nangmouh poe hanlah mintoenaw koe lawk a kam e ram, Kanaannaw, Hitnaw, Amornaw, Hivnaw hoi Jebusitnaw e ram, sanutui hoi khoitui a lawngnae ram dawk na hrawi awh toteh, hete thapa dawk nangmouh ni hete hno heh na sak awh han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnin sari touh thung tonphuenhoehe na ca awh vaiteh, hnin sarinae dawk BAWIPA han pawi lah ao han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tonphuenhoehe vaiyei hnin sari touh thung na ca awh navah, nangmouh koe ton na tat awh mahoeh. Na onae hmuen pueng koehai hmu lah awm hanh naseh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaimouh ni BAWIPA lungmanae dawk Izip ram hoi ka tâconae tueng nah, hettelah ka sak awh, telah na ca catounnaw koe na dei pouh han.
  </para>
  <para style="p">
    <verse number="9" style="v" />BAWIPA e kâlawk teh na pahni dawk pou ao thai nahan, hote hno teh na kut dawk mitnout kapanuekkhaikung, na mit rahak vah pahnim hoeh nahanlah ao han. BAWIPA ni nang teh athakaawme a kut hoi Izip ram dawk hoi na hrawi awh toe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hatdawkvah, hete phunglam heh a kum tangkuem ama tueng nah na ya awh han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmouh hoi na mintoenaw koe thoseh lawk a kam e patetlah BAWIPA ni na hrawi awh teh, hote ram na poe awh torei teh,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmae ca caminnaw pueng hoi saringnaw e ca caminnaw pueng BAWIPA hanlah na hmoun awh han. A na tongpanaw pueng teh BAWIPA e lah ao han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hateiteh, La ni a khe e camin teh tuca hoi na ratang awh han. Ratang ngai hoehpawiteh, Laca e a lahuen na kapai pouh awh han. Taminaw dawk ca caminnaw na ratang awh han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na ca ni hmalah bangtelamaw telah na pacei pawiteh, BAWIPA ni santoungnae Izip ram hoi a kut tha kaawm hoi kaimouh na tâcokhai awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Faro siangpahrang ni kayawi lah na tâco sak awh hoeh torei teh, Izip ram dawk tami thoseh, saring thoseh, ca tongpa caminnaw pueng BAWIPA ni koung a thei. Hatdawkvah, hmaloe ka khe e saring a na tongpanaw pueng heh BAWIPA koe na poe han. Ca tongpa thung dawk tongpa caminnaw pueng teh ratang hanlah na dei pouh han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hete hno haiyah nange mitnout kapanuekkhaikung, na mit rahak vah mitnout lah ao han. Bangkongtetpawiteh, BAWIPA ni athakaawme a kut hoi kaimouh Izip ram dawk hoi na tâco sak awh toe telah taminaw koe a dei awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Faro ni Isarelnaw a tâco sak hnukkhu, Filistin lah ceinae lam kahnaica ao eiteh, Cathut ni hote lam dawk hrawi hoeh. Bangkongtetpawiteh, ahnimouh ni tarantuknae a kâhmo awh navah, a lungpout teh Izip ram lah a ban payon han doeh ti a panue.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hatdawkvah, Cathut ni ahnimouh teh tuipuipaling kahrawng lam lahoi a hrawi. Isarelnaw ni Izip ram hoi ahuhu lahoi a tâco awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Joseph ni hmaloe vah, Cathut ni na khet awh han. Ka hrunaw hete hmuen koe na sin awh han telah Isarelnaw koe lawk a kam e patetlah Mosi ni ahnie a hrunaw ama koe a sin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahnimouh ni Sukkoth hoi bout a tâco awh teh kahrawng teng, Etham khopui vah a roe awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahnimouh ni karum khodai a cei thai awh nahanelah, BAWIPA ni kanîthun lah lam ka patue hane tâmaikhom hoi thoseh, tangmin lah angnae ka poe hane hmaitokhom hoi thoseh, ahnimae hmalah a cei pouh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kanîthun lah tâmaikhom, tangmin lah hmaitokhom hah ahnimae hmalah hoi takhoe pouh hoeh.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA nihai,
  </para>
  <para style="p">
    <verse number="2" style="v" />Isarelnaw ban teh Pihahiroth khopui teng, Migedan khopui hoi tuipui rahak, Baalazephon khopui hmalah rim tuk hanlah dei pouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bangkongtetpawiteh, Faro siangpahrang ni Isarelnaw teh khikpacu awh toe. Ramke um lam awm hoeh toe telah ati han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai ni hai Faro e lungthin ka pata sak vaiteh, ahni ni Isarelnaw a pâlei han. Kai teh BAWIPA doeh tie Izipnaw ni a panue nahanlah hote siangpahrang hoi a ransanaw lahoi ka bawilennae a kamnue han telah Mosi koe atipouh e patetlah ahnimanaw ni a sak awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hote taminaw a yawng e kong Izip siangpahrang koe a thai sak awh navah, ahni koehoi a sannaw e lungthin bout a kamlang teh, maimouh ni hettelah sak awh teh Isarelnaw hah maimae thawtawknae koehoi bangkongmaw a hlout awh han telah ati awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hat navah, Siangpahrang ni rangleng coungkacoe a rakueng teh a taminaw hah akaw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rangleng kahawi e cum taruk touh hoi Izip marangransanaw pueng hoi cungtalah, bawinaw pueng haiyah a ceikhai.
  </para>
  <para style="p">
    <verse number="8" style="v" />BAWIPA ni Faro e lungthin bout a pata sak dawkvah, ahni ni Isarelnaw hah a pâlei awh. Hat ei, Isarelnaw teh kut dâw laihoi a cei awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hottelah, Faro siangpahrang e marangransanaw, rangleng ransanaw hoi Izip taminaw ni a pâlei awh teh, Pihahuroth khopui teng, Baalazephon khopui hmalah tuipui rai lah rim ka tuk e Isarelnaw hah a pha awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Faro ni a hnai nah Isarelnaw ni a khet awh teh Izipnaw ni pâlei e a hmu awh navah, pueng hoi a taki awh dawkvah BAWIPA koe a hramki awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi koe hai, Izip ram dawk phuenmon ao hoeh dawkvah maw, hi ramke um due hanlah kaimouh na hrawi awh. Kaimouh koe hettelah na sak teh, Izip ram hoi bangkong na hrawi awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaimouh teh Izipnaw koe san lah kaawm awh yawkaw nei telah Izip ram vah ka dei awh navah, hete hno khet laihoi ka dei awh hoeh na maw. Kaimouh hete kahrawngum due hlak teh Izipnaw koe san lah o e heh ahawihnawn telah ati awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi ni taket awh hanh. Lungmawngcalah awm awh. BAWIPA ni sahnin nangmouh hanlah rungngangnae a sak hane hah khenhaw. Sahnin nangmouh ni na hmu e Izipnaw heh bout na hmawt awh mahoeh toe.
  </para>
  <para style="p">
    <verse number="14" style="v" />BAWIPA ni taran na tuk pouh han. Nangmanaw teh lungmawngcalah na o awh han telah taminaw koe a dei pouh.
  </para>
  <para style="p">
    <verse number="15" style="v" />BAWIPA ni bangkongmaw KAI na kaw awh. Isarelnaw hmalah cei hanlah dei pouh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nang ni sonron na kut hoi tuipui van lah dâw nateh tuipui kâphi sak. Isarelnaw ni tui lungui, talai kaphui dawk a cei awh han.
  </para>
  <para style="p">
    <verse number="17" style="v" />KAI ni Izipnaw e a lungthin ka pata sak vaiteh, ahnimouh ni na pâlei awh han. Faro siangpahrang hoi a bawinaw, marang, marangransanaw lahoi ka lentoenae a kamnue han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hottelah, Faro siangpahrang hoi a marang, marangransanaw lahoi ka lentoenae a kamnue toteh, kai teh BAWIPA doeh tie hah Izipnaw ni a panue awh han telah Mosi koe a dei pouh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hat navah, Isarelnaw e hmalah ka cet e Cathut e kalvantami ni a hnuk a pâlei teh, tâmai khom teh ahnimae hmalah hoi hnuklah a kampuen teh a kangdue.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hottelah, Izip ransanaw hoi Isarel ransanaw rahak a pha nah, Izipnaw koe kahmawt sak e tâmai lah ao teh, Isarelnaw koe teh angnae ka poe dawkvah karum tuettuet buet touh hoi buet touh kâhnai thai awh hoeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosi ni tuipui lathueng a kut a dâw nah karum tuettuet BAWIPA ni Kanîtholae kahlî katang hoi tuipui hah hnuklah a pâban teh talai rem a phui sak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Isarelnaw ni tuipui lungui talai dawk a cei awh teh, tui teh ahnimae avoilah aranglah talung tapang patetlah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Izipnaw, Faro siangpahrang ni a hrawi e marang, marangransanaw teh tuipui lungui a kâen awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amom vah BAWIPA ni Izip ransanaw hah hmaikhom hoi tâmai dawk hoi a khet teh a tarawk.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahnimae rangleng cei a ru nahanlah a khok a kâhlehlawk sak. Izipnaw ni hai Isarelnaw koehoi yawng awh leih sei, BAWIPA ni Isarelnaw koe lahoi Izip taminaw a tuk, telah ati awh.
  </para>
  <para style="p">
    <verse number="26" style="v" />BAWIPA nihai, tuipui ni Izip taminaw, ranglengnaw, marangransanaw e lathueng vah tip sin hanelah, tupui lathueng na kut dâw atipouh e patetlah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Khodai toteh Mosi ni tuipui lathueng a kut a dâw teh, tuipui tui teh a thao teh bout a lawng. Izipnaw ni a yawng takhai ei, BAWIPA ni ahnimouh teh tuipui lungui vah a tâkhawng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hottelah, tuipui tui teh bout a lawng teh tuipui dawk a bo toteh, Faro siangpahrang e rangleng, marangransanaw pueng teh muen a ramuk dawkvah buet touh hai hlout awh hoeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Isarelnaw teh tuipui lungui talai kaphui dawk hoi a cei awh teh, tui teh ahnimae avoilah aranglah talung tapang patetlah ao.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hottelah, BAWIPA ni Isarelnaw teh Izipnaw e kut dawk hoi a rungngang teh tuipui rai lah Izipnaw e ronaw teh a hmu awh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hottelah, BAWIPA ni Izipnaw koe hno ka len poung a sak e hah Isarelnaw ni a hmu awh navah, BAWIPA hah a taki awh. BAWIPA hoi a san Mosi hah a yuem awh.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hat navah, Mosi hoi Isarelnaw ni BAWIPA koe la a sak awh e teh, BAWIPA ni a lentoenae hoi a tâ dawkvah ama pholennae la sak awh sei. Marang hoi marangransanaw tuipui thung koung a tâkhawng toe.
  </para>
  <para style="p">
    <verse number="2" style="v" />BAWIPA teh ka thaonae hoi ka la lah ao. Ama teh na ka rungngangnae lah ao. Hote Cathut teh kai ni ka bawk e Cathut lah ao dawkvah, ka pholen han. Ka mintoenaw e Cathut lah ao dawkvah ka oup han.
  </para>
  <para style="p">
    <verse number="3" style="v" />BAWIPA teh ransa lah ao. A min teh Jehovah doeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Faro siangpahrang e rangleng hoi a ransanaw teh tuipui dawk koung a tâkhawng. A rawi e bawinaw hai tuipui paling dawk koung a bo awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kadung poung e hmuen dawk muen a ramuk. Talung patetlah thung a bo awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Oe BAWIPA, Aranglae na kut teh hnosakthainae hoi a lentoe teh, Oe BAWIPA, aranglae na kut ni tarannaw koung a raphoe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang na ka tarannaw hah na lentoenae naw hoi koung na tâkhawng. A lungkhueknae a patoun teh songnawng patetlah ahnimouh teh a kak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na hnong dawk e kâha lahoi tui teh na kâcu sak teh, Kalawng e tui barukbaruk a phuen sak teh, tuipui thung kadung poung e tui hah a kamkak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Taran ni kai na pâlei han. ahnimouh ka pha han. Lawp e hno hah ka kârei vaiteh ahnimouh koe ka ngainae akuep han. Tahloi tabu dawk e ka rasa vaiteh, ka kut hoi ahnimouh teh koung ka thei han telah a dei.
  </para>
  <para style="p">
    <verse number="10" style="v" />BAWIPA ni kahlî a hmu teh, tuipui ni ahnimouh muen a ramuk teh katha kaawm poung e tui dawk talung patetlah a bo awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Oe BAWIPA, cathutnaw thung dawk nang patetlae Cathut apine kaawm. Thoungnae lahoi ka lentoe e, pholen nah, taki kaawm e, kângairu hno ka sak e, Nang hoi bang patet e cathut maw ka kâvan.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aranglae kut na dâw nah ahnimouh teh talai ni koung a payawp.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na taran e taminaw hah lungmanae lahoi na hrawi. Kathounge na onae hmuen koe tha onae lahoi na hrawi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miphunnaw ni kamthang a thai awh vaiteh a taki awh han. Filistin khocanaw teh a lungpuen awh han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Edom kahrawikungnaw kângairunae, Moab ram e ransanaw teh pâyawnae, Kanaan khocanaw pueng teh lungpoutnae koe a pha awh han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Oe BAWIPA, na taminaw ni a tapoung toteh, Na ran e taminaw ni a tapoung toteh, Hote miphunnaw pueng ni takinae lungthin, lungpuennae a tawn awh vaiteh, Na kut hno sakthainae dawk ahnimouh teh talung patetlah duem ao awh han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Oe BAWIPA, râw coe hane mon, Na o nahanelah na sak e hmuen koe na taminaw na kâenkhai han. Oe BAWIPA, na kut hoi sak e kathoung e hmuen koe hmuen na ta han.
  </para>
  <para style="p">
    <verse number="18" style="v" />BAWIPA ni a yungyoe uk na lawiseh telah la a sak awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bangkongtetpawiteh, Faro siangpahrang e marangnaw, ranglengnaw, marangransanaw teh tuipui dawk a kâen teh BAWIPA ni ahnimae lathueng tuipui hoi muenli sak. Isarel miphunnaw teh tuipui lungui vah talai dawk a cei awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aron e a tawn canu, profet napui Miriam ni cecak a sin teh, napuinaw pueng ni hai cecak khawng hoi a hnuk a kâbang awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Miriam ni hai BAWIPA teh a lentoe teh tânae a hmu dawkvah, Ama teh pholen awh sei. Marang hoi marangransanaw hah tuipui thungvah koung a pabo toe telah ahnimouh hoi cungtalah la a sak awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hahoi, Mosi ni Isarelnaw hah tuipui paling koe lahoi a hrawi teh, ahnimouh teh Sur kahrawngum vah a pha awh. Hote kahrawng dawk hnin thum touh kahlawng a cei awh teh tui hmawt awh hoeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Marah tie hmuen koe a pha awh navah, Marah tui teh akha dawkvah net thai awh hoeh. Hatdawkvah, Hote hmuen hah Marah telah a kaw awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Taminaw ni Mosi yonpen awh teh bangtelamaw nei han ti hoi a phuenang awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi ni BAWIPA a kaw teh BAWIPA ni thingkung buet touh a patue. Hote akung tui dawk a tâkhawng nah tui teh a radip. Hote hmuen koe ahnimouh a tanouk teh phunglam a sak pouh e teh,
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangmouh ni BAWIPA Cathut e lawk hah kahawicalah na ngai teh a ngai e hno na sak teh a kâpoelawknaw hah na ngai teh aphunglawknaw pueng na tarawi pawiteh, Izipnaw koe ka pha sak e Lacik hah nangmouh koe ka phat sak mahoeh. Bangkongtetpawiteh, nangmae patawnae kadamsakkung, BAWIPA lah ka o telah ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hat hnukkhu, tuido hlaikahni touh, samtue 70 touh a onae Elim kho a pha awh teh, Hote hmuen dawk tui onae koe tengpam vah rim a tuk awh.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi, Isarel rangpuinaw teh Elim hoi a tâco awh teh kahlawng bout a cei awh. Izip ram hoi a tâco hnukkhu, thapa yung hni, Hnin hrahlaipanga nah, Elim hoi Sinai mon rahak Sin kahrawng dawk a pha awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hote kahrawng dawk Isarel rangpuinaw ni,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kaimouh teh Izip ram moi thawngnae hlaam teng tahung teh, ka boum lah ka ca awh navah, BAWIPA e kut hoi kadout awh pawiteh ahawihnawn. Atu vah, ka kamkhueng e taminaw kamlum sak hanelah, Hete kahrawng dawk na hrawi awh vaw telah Mosi hoi Aron yonpen awh teh a phuenang awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hat navah, BAWIPA ni khenhaw! Kai ni nangmouh hanelah kalvan hoi vaiyei ka rak sak han. Taminaw ni hnin touh rawca rawi hanelah hnintangkuem a tâco awh han. Ka kâlawk patetlah a sak hoi, a sak hoeh e hottelah lahoi ahnimouh ka tanouk han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hnin tangkuem rawi e hlak kapap lah, hnin taruk hnin teh let hni touh hoi rawi hanelah kârakueng awh, telah Mosi koe a dei pouh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi hoi Aron nihai, BAWIPA ni nangmouh teh Izip ram hoi na hrawi a e hah atu tangmin vah na panue awh han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amom lahai BAWIPA e bawilennae na hmu awh han. BAWIPA koe na phuenangnae lawk teh a thai toe. Kaimouh yon na pen awh teh na phuenang sin hanelah, Kaimouh teh bang patet e tami lah maw ka o awh, telah Isarelnaw koe atipouh roi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hahoi, Mosi ni, BAWIPA ni tangmin na ca awh han e moi thoseh, Amom kaboumlah na ca awh han e vaiyei thoseh, na poe awh toteh, hete lawk heh kakuep han. Nangmouh ni na phuenangnae lawk teh BAWIPA ni a thai toe. Kaimouh teh bang patet e tami maw. Nangmouh ni na phuenangnae e heh kaimouh roi koe na hoeh, BAWIPA koe doeh na phuenang awh, telah atipouh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hahoi, nangmae phuenangnae lawk hah BAWIPA ni a thai dawkvah, Ama koe hnai awh, telah Isarel tamimaya pueng koe patuen dei pouh hanelah Aron koe lawkthui e patetlah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Aron ni Isarel tamimaya koe patuen bout a dei pouh navah, ahnimouh ni kahrawng lah a khet awh teh, tâmai dawk BAWIPA e bawilennae kamnuek e hah a hmu awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />BAWIPA ni hai Isarelnaw e phuenangnae lawk hah ka thai toe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tangmin lah nangmouh ni moi na ca awh han. Amom lahai vaiyei kaboumlah na ca awh han. KAI teh nangmae BAWIPA Cathut doeh tie hah na panue han telah ahnimouh koe dei pouh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tangmin lah tamuemnaw teh rim koe a tho awh. Amom lahai rim petkâtue lah tadamtui a bo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tadamtui a kâkayaw toteh, tadamtui kamkak e patetlah titica kamhluem e talai dawk ao.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hote hno Isarelnaw ni a hmu awh toteh, bangmaw ti a panue awh hoeh dawkvah, buet touh hoi buet touh a kâpacei awh. Mosi ni hete naw teh nangmouh na ca hanelah BAWIPA ni na poe e vaiyei doeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tami pueng ni amae rim dawk kaawm e tami yit touh ni cakhuem, tami buet touh hanlah Omer buet touh rip rawi hanlah BAWIPA ni a dei e patetlah patuen bout a dei pouh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Isarelnaw ni hottelah a sak awh teh, tami kayoun kapap e patetlah a rawi awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Omer hoi a nue awh navah, kapap ka rawi e ni hoe tawn hoeh. Kayoun ka rawi e ni hai hoe vout hoeh. Abuemlah cakhuem koung a rawi awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosi ni api nang hai amom totouh na tat awh mahoeh atipouh eiteh,
  </para>
  <para style="p">
    <verse number="20" style="v" />Tami tangawn ni Mosi e lawk ngai laipalah, amom totouh a ta awh dawkvah a pâri teh a hmui a tho dawk Mosi teh a lungkhuek.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hote tami tangkuem ni amamouh cakhuem hnintangkuem a rawi awh. Khumbeithoe nah atui lah a tho.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hnin taruk hnin navah, vaiyei let hni touh, tami buet touh hanelah Omer kahni touh rip a rawi awh. Hote akong hah tamimaya ka ukkungnaw ni Mosi koe a thai sak awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahni ni hai tangtho teh BAWIPA hmalah kathounge Sabbath hnin, Kâhatnae hnin lah ao. Vaiyei thawng hanlah na ngai e patetlah thawng awh. Bue hanlah na ngai pawiteh bue awh. Kacawie teh tangtho amom hanelah na ta awh han telah BAWIPA ni a dei e hah bout a dei pouh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi ni lawkthui a e patetlah atangtho amom hanelah hai a ta awh. Hotteh, a hmui tho hoeh. Pâri hai pâri hoeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi ni hai kacawie sahnin cat awh. Sabbath teh BAWIPA e hnin doeh. Hote hno kahrawngum sahnin vah na hmawt awh mahoeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hnin taruk touh thung a rawi awh. Sabbath hnin lah kaawm e hnin sari hnin nah awm hoeh, na hmawt hai na hmawt awh mahoeh telah ati.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hnin sari hnin nah, Tami tangawn ni rawi hanelah a tâco awh teh a tawng awh navah hmawt awh hoeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />BAWIPA ni hai nangmouh ni kaie kâpoelawknaw hoi kâlawknaw na totouh maw na pahnawt awh han rah.
  </para>
  <para style="p">
    <verse number="29" style="v" />BAWIPA ni Sabbath hnin teh nangmouh na poe awh. Hatdawkvah, hnin taruk hnin nah, hnin hni touh hane vaiyei hah na poe awh. Taminaw pueng ama onae hmuen koe awm naseh. Hnin sari hnin nah, a onae hmuen koehoi nahai cetsak hanh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Taminaw ni hnin sari hnin nah a kâhat awh han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Isarelnaw ni hote cakawi hah mana telah ati awh. Songsuenmu patetlah ao teh a pangaw. Khoitui hoi kalawt e vaiyei hoi a tuinae a kâvan.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mosi ni nangmouh Izip ram hoi na hrawi awh navah, Kahrawng na paca e vaiyei hah na ca catounnaw pueng ni a hmu a nahan e lah, Omer buet touh tat telah BAWIPA ni a dei e hah bout a dei pouh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosi ni Aron koevah hlaam lat nateh, mana Omer buet touh athung vah tat. Na ca catoun totouh ta hanelah, BAWIPA hmalah na kuem han atipouh.
  </para>
  <para style="p">
    <verse number="34" style="v" />BAWIPA ni Mosi koe lawkthui e patetlah hote mana hah Aron ni pou a kuem hanelah lawkpanuesaknae hmalah a hung.
  </para>
  <para style="p">
    <verse number="35" style="v" />Isarelnaw ni khosaknae ram dawk a pha awh hoeh roukrak, a kum 40 touh thung mana a ca awh. Kanaan ramri koe a pha hoeh roukrak mana a ca awh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Omer buet touh e teh ephah pung hra pung touh e kuk lah ao. (Omer buet touh teh ephah pung hra pung touh hoi a kâvan teh, ephah buet touh teh 22 liters hoi a kâvan)
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isarel rangpuinaw ni BAWIPA e kâ patetlah Sin kahrawng dawk hoi a tâco awh teh kahlawng bout a cei awh nah Rephidim vah rim a tuk awh. Hote hmuen koe taminaw nei hanelah tui awm hoeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hatdawkvah, taminaw ni Mosi koe nei hane tui na poe telah a titeh Mosi a yue awh. Mosi ni bangkongmaw kai koe thoenae na tawng awh. BAWIPA hah bangkongmaw na tanouk awh vaw telah atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Taminaw tui a kahran dawkvah, Mosi yon a pen awh teh a phuenang awh. Kamamouh khue hoi ka canaw, saringnaw pueng tui kahran sak hanelah, Izip ram hoi bangkongmaw na hrawi telah atipouh awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hat navah, Mosi ni BAWIPA hah a kaw teh, hete taminaw heh kai ni bangtelamaw ka ti han. Talung hoi kai dêi hanelah meimei coungkacoe ao awh toe telah atipouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />BAWIPA ni hai taminaw e hmalah cet nateh, Isarel tami kacuenaw hah kaw. Tuipui na hemnae sonron hah sin nateh Horeb mon lah cet.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hote hmuen koe kaawm e lungsong van vah kai ka kangdue han. Nang ni hote lungsong hah na hem han. Taminaw ni a nei hane tui hote lungsong dawk hoi a tâco han telah Mosi koe atipouh. Mosi ni Isarel kacuenaw e hmalah hottelah a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Isarelnaw ni BAWIPA teh kaimouh koe ao hoi ao hoeh e a tanouk awh dawkvah, hote hmuen teh Massah hoi Meribah telah ati awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hat navah, Amaleknaw ni a tho awh teh Isarelnaw Refidim vah a tuk awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosi ni taminaw hah a rawi teh Amaleknaw tuk hanelah cet awh. Tangtho vah, Cathut e sonron ka sin vaiteh, mon vah ka kangdue han telah Joshua koe atipouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosi ni a dei pouh e patetlah Joshua ni a sak teh Amaleknaw hah a tuk. Mosi, Aron hoi Hur tinaw mon vah a luen awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi ni a kut a dâw nah, Isarelnaw ni a tâ awh. A kut a pabo nah, Amaleknaw ni a tâ awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hatei, Mosi e kut tha a tawn dawkvah, ahnimouh ni talung a la awh teh, Mosi talung van a tahung sak hnukkhu, Aron hoi Hur ni avoivang lahoi a kut a tawm pouh roi. Hatdawkvah, Kanîloum totouh a kut teh ama paroup lah ao.
  </para>
  <para style="p">
    <verse number="13" style="v" />Joshua ni hai Amalek bawinaw hoi a taminaw hah tahloi hoi a thei.
  </para>
  <para style="p">
    <verse number="14" style="v" />BAWIPA ni hai hete hno dawk pahnim hoeh nahanlah ca thut nateh touk telah Joshua koe atipouh. Bangkongtetpawiteh, kalvan rahim vah Amalek pahnimhoehnae hah kai ni ka takhoe han telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi ni khoungroe a sak teh BAWIPA teh ka tânae (Jehovah-nissi) doeh telah ati.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bangkongtetpawiteh, Amaleknaw e kut ni BAWIPA e khoungroe e taran lah ao dawkvah, BAWIPA ni Amaleknaw teh a yungyoe hoi taran lah a tuk han telah ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cathut ni Mosi hoi a tami Isarelnaw hanelah a sak pouh e naw pueng thoseh, BAWIPA ni Isarelnaw Izip ram hoi a tâcokhainae thoseh, Midian Jethro, Mosi e a masei ni a thai nah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosi ni a patoun e a yu hoi,
  </para>
  <para style="p">
    <verse number="3" style="v" />A ca kahni touh a hrawi teh a cei. A capa buet touh e min teh Gershom ka phung. Bangkongtetpawiteh, ayâ ram vah imyin lah ka o atipouh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Alouk buet touh e min teh Eliezer ka phung. Bangkongtetpawiteh, Apa Cathut teh kai na kabawmkung lah ao. Faro e tahloi dawk hoi na rungngang telah atipouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi e a masei Jethro ni Mosi e capa roi hoi a yu a hrawi teh kahrawngum rim tuknae koe Cathut mon dawk Mosi koe a tho awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A masei Jethro hoi na yu, na capa roi teh nang koe a tho telah Mosi koe a dei pouh awh navah,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi ni a masei hah dawn hanelah a tâco teh a paco. Na dam maw telah buet touh hoi buet touh a kâpacei awh hnukkhu, rim thung vah a kâen awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />BAWIPA ni Isarelnaw hanelah Faro siangpahrang hoi Izipnaw koe hno a sak e naw pueng thoseh, lam a kâhmo awh e rucatnae naw pueng thoseh, hote rucatnae dawk hoi BAWIPA ni a rungngang e thoseh, Mosi ni a masei koe a dei pouh.
  </para>
  <para style="p">
    <verse number="9" style="v" />BAWIPA ni Isarelnaw teh Izipnaw e kut dawk hoi a rasa teh a sak e lungmanae kecu dawk Jethro teh a lunghawi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Izipnaw e kut dawk hoi thoseh, Faro siangpahrang e kut dawk hoi thoseh, nang hoi taminaw ka rungngang e BAWIPA teh yawhawinae awm naseh.
  </para>
  <para style="p">
    <verse number="11" style="v" />BAWIPA teh alouke cathutnaw pueng hlak, hoe a lentoe tie atu ka panue. Bangkongtetpawiteh, taminaw ni kâoupkâpawinaw thaw dawk BAWIPA ni a tâ telah ati hnukkhu,
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosi e a masei Jethro ni hmaisawi hane sathei hoi Cathut hanlah satheinaw hah a sin teh, Aron hoi Isarel tami kacuenaw ni Mosi e a masei hoi cungtalah Cathut hmalah rawca ca hanlah a tho awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Atangtho vah, Mosi ni taminaw lawkceng hanlah a tahung. Amom hoi tangmin totouh, taminaw Mosi hmalah ao awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mosi ni taminaw koe a sak e naw pueng hah a masei ni a hmu navah, hete taminaw koe bangtelamaw na sak Nang ni nama dueng na tahung teh taminaw pueng teh amom hoi tangmin lah totouh na hmalah bangkongmaw ao awh, telah atipouh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi ni hete taminaw teh Cathut e pouknae hei hanelah kai koe ka tho e doeh atipouh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hahoi, ahnimouh ni lawkpungnae tawn awh boipawiteh, kai koe a tho awh teh, ahnimae lawkpung hah kai ni lai ka dei pouh. Cathut e kâlawknaw hah kai ka cangkhai telah a masei koe atipouh navah,
  </para>
  <para style="p">
    <verse number="17" style="v" />A masei ni na sak e hno heh hawi hoeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang hoi nang koe kaawm e hete taminaw teh atangcalah a thayoun awh han. Hete thaw heh nang hanlah hnokari poung lah ao. Tami buet touh dueng ni sak thai kawi e nahoeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka lawk hah thai haw. Kai ni pouknae na poe han. Cathut ni na okhai han doeh. Nang ni Cathut hoi kâkuen e hno dawk taminaw e hnonaw hah Cathut koe na kâen vaiteh, na thai sak han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahnimouh hai kâlawknaw na cangkhai han. Ahnimouh ni a dawn hane lamthung, a sak awh han e kawinaw hai na patue han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hothloilah, Cathut ka taket e tami, kalan e tami, hounlounnae ka panuet e taminaw hah taminaw thung dawk hoi na rawi vaiteh, tami thongkhat kaukkung, tami cum touh kaukkung, tami 50 touh kaukkung, tami hra touh ka uk hanelah thaw na poe han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hote taminaw ni nâtuek haiyah taminaw hah lawkceng awh naseh. Lawkpung kalen dawk teh nang koe pouknae lat awh naseh. Kathoenge lawkpungnae teh ama ni lawkceng awh naseh. Hottelah boipawiteh, ahnimouh ni cungtalah thaw rei tawk awh vaiteh nang na tha a dam han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hottelah, Cathut ni kâ na poe pawiteh, nang teh na cak han. Hete taminaw pueng teh amamae hmuen koe karoumcalah a cei awh han telah atipouh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi ni a masei e lawk hah a ngai teh a dei pouh e patetlah a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi ni ka uk thai hane taminaw hah Isarelnaw thung dawk hoi a rawi teh tami thongkhat kaukkung, tami cum touh kaukkung, tami 50 touh kaukkung, tami hra touh kaukkung hanlah thaw a poe.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hote taminaw ni nâtuek haiyah taminaw hah lawk a ceng awh. Ka ru e lawkpung dawk teh Mosi e pouknae a la awh. Kayawi e lawkpung dawk teh amamouh lungpouk lawk a ceng awh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hathnukkhu, Mosi ni a masei ban hanlah a pasoung toung dawkvah ahni teh amae ram lah a ban.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isarelnaw ni Izip ram hoi a tâco awh hnukkhu, thapa yung thum, apasuek hnin nah Sinai mon dawk a pha awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Refidim hoi a tâco awh teh Sinai mon dawk a pha awh teh, hote kahrawng dawk mon hmalah rim a tuk awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi ni Cathut koe a luen nah BAWIPA ni mon hoiyah a kaw, nang teh Jakop e phun, Isarelnaw koe bout a dei e lawk teh,
  </para>
  <para style="p">
    <verse number="4" style="v" />Kai ni Izipnaw koe ka sak e thoseh, nangmouh langta rathei hoi na phu teh kama hanlah na la e thoseh, nangmouh ni na panue awh toe.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hatdawkvah, nangmouh ni atu ka lawk hah atanglah na ngai awh teh, ka lawkkam na tarawi pawiteh, alouke miphunnaw pueng hlak nangmouh teh ka tawn hane râw lah na o awh han. Talai pueng heh kaie doeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nangmanaw haiyah vaihma uknaeram, kathounge miphun lah kama koe na o awh han telah Isarelnaw koe patuen dei pouh atipouh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi ni bout a tho teh taminaw thung dawk hoi kacuenaw hah a kaw hnukkhu, BAWIPA ni lawkthui e naw pueng hah bout a dei pouh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Taminaw pueng ni hai BAWIPA ni a dei e pueng teh kaimouh ni ka sak awh han telah lungkânging lahoi bout ati awh. Mosi ni ahnimae lawk hah BAWIPA koe bout a thai sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />BAWIPA ni khenhaw! Nang hoi Kai ni dei nah taminaw ni a thai awh teh, nang pou na yuem thai awh nahanlah, tâmai khom dawk hoi nang koe Kai ka tho han telah Mosi koe atipouh. Mosi ni hai BAWIPA e lawk hah taminaw koe bout a dei pouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />BAWIPA ni hai taminaw aonae koe a cei teh, Sahnin hoi tangtho dawk ahnimouh thoung sak lah. Khohna hai pâsu sak awh teh,
  </para>
  <para style="p">
    <verse number="11" style="v" />Apâthum hnin dawk coungkacoe lah awm sak awh. Bangkongtetpawiteh, apâthum hnin nah, BAWIPA ni a taminaw hmalah Sinai mon dawk a kum han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Taminaw ni a tapuet awh hoeh hane ngangnae hah mon petkâtue lah sak nateh, nangmouh ni mon dawk luen awh hanh. Mon khok hah na kâbet awh hoeh nahanlah, kâhruetcuet telah dei pouh. Mon kâbet e taminaw teh atanglah dout awh naseh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hote tami hah kut hoi tek awh hanh. Atangcalah talung hoi dêi han. Nahoeh pawiteh, tahroe hoi thut han. Tami thoseh, saring thoseh, hring mahoeh. Mongka ueng lawk kasawlah a cai toteh, taminaw ni mon dawk a tho han telah Mosi koe a dei pouh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mosi ni mon hoi taminaw onae koe a kum teh, ahnimouh hah a thoungsak. Ahnimouh ni a khohnanaw a pâsu awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi ni hai apâthum hnin nah coungkacoe lah awm awh. Yu koe ip awh hanh telah taminaw koe atipouh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Apâthum hnin amom vah, mon dawk keitat, sumpa palik hoi kho tâmai muen a tabo teh, hramki lawk hoi mongka lawk a cai teh rim dawk kaawm e taminaw pueng a pâyaw awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mosi ni hai taminaw Cathut hoi kâhmo sak hanelah, rim dawk hoi a hrawi teh mon khok koe a kangdue awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />BAWIPA teh hmai hoi kâkayo teh Sinai mon dawk a kum dawkvah, Sinai mon teh hmai a khu. Hmaikhu haiyah takhuen dawk e hmaikhu patetlah a luen teh mon pueng hai a kâhuet.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mongka ueng e kasawlah hoe a cai toteh, Mosi ni a kaw teh Cathut ni lawk hoi a pato.
  </para>
  <para style="p">
    <verse number="20" style="v" />BAWIPA teh Sinai monsom dawk a kum. Mosi hah mon vah a kaw dawkvah, Mosi teh mon vah a luen.
  </para>
  <para style="p">
    <verse number="21" style="v" />BAWIPA ni hai taminaw ni khet hanelah, Kai koe tho payon awh vaiteh taminaw a due awh han e hah puennae a tawn dawkvah, kum nateh kâhruetcuetnae poe.
  </para>
  <para style="p">
    <verse number="22" style="v" />BAWIPA koe ka tho e vaihmanaw haiyah amahoima a kâthoung sak a han. Nahoeh pawiteh, BAWIPA ni a rek awh han telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosi nihai, taminaw ni Sinai mon dawk luen thai awh hoeh. Bangkongtetpawiteh, tapuet hoeh hane ngangnae naw hah mon petkalup lah ka sak teh, thoungsak awh loe telah lawk yo ka thui toe telah BAWIPA koe bout a dei pouh.
  </para>
  <para style="p">
    <verse number="24" style="v" />BAWIPA ni hai kum leih. Nang hoi Aron dueng doeh ka luen han. Vaihmanaw hoi taminaw teh BAWIPA koe luen hanelah tho awh hanh naseh. Nahoeh pawiteh, ahnimouh ka rek han telah ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi ni taminaw onae koe a kum teh a dei pouh.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hat navah, Cathut ni a dei e lawk teh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kai teh nangmouh santoungnae hmuen, Izip ram dawk hoi na ka tâcawtkhai e nangmae Cathut Jehovah doeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kai hloilah alouke cathut na bawk awh mahoeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lathueng kalvan thoseh, rahim talai dawk thoseh, talai rahim tui dawk thoseh, kaawm e hno hoi mei kâvan lah, meikaphawk bawk hanlah na sak mahoeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A hmalah tabo hoi na bawk mahoeh. Bangkongtetpawiteh, nange Cathut kai Jehovah teh nang dawk yon ao telah tang ka yuem e Cathut, kai na kahmuhmanaw e ca catoun se thum, se pali totouh a napanaw e yon hah a capanaw koe ka pathung e Cathut lah ka o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kai hah lungpataw ni teh ka kâpoelawknaw ka tarawi e a ca catoun, a se thongsang totouh lungmanae ka kamnuek sak e Cathut lah ka o.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nange Cathut Jehovah e min hah laithoe lah dei awh hanh. Bangkongtetpawiteh, A min laithoe lah ka dei e tami teh yon tawn hoeh telah BAWIPA ni pouk mahoeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sabbath hnin thoung sak hanelah, hote hnin hah pahnim awh hanh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hnin taruk touh thung thaw panki hoi tawk awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnin sari hnin teh na BAWIPA Cathut e Sabbath hnin lah ao. Hote hnin dawk, nang hoi na canaw, na sannu sanpanaw, saring, nange longkha thung kaawm e imyinnaw hai thaw tawk awh mahoeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bangkongtetpawiteh, BAWIPA ni kalvan, talai, hmuen pueng koe kaawmnaw pueng hah hnin taruk touh thung a sak teh, hnin sari hnin nah, a kâhat. Hatdawkvah, BAWIPA ni hnin sari hnin hah yawhawi a poe teh a thoungsak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na Cathut Jehovah ni na poe e ram dawk na hringsaw nahanelah, na manu hoi na pa barih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tami thet hanh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Uicuk hanh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ayâ e hno parawt hanh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na imri koe kalan hoeh e kapanuekkhaikung lah awm hanh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Imri e im, a yu, a sannu sanpa, maito, marang hoi hnopai buet touh haiyah lungthin radueknae tawn hanh telah atipouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Taminaw ni keitat lawk, sumpapalik, mongka ueng lawk, mon hoi hmaikhu a tâco e naw hah a hmu awh toteh, a taki awh dawkvah, a kâhnawn awh teh ahlanae koe vah a kangdue awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosi koevah Nang ni lawk dei lah ka ngai awh han. Kaimouh koe Cathut lawk dei han naseh. Kaimouh ka due hane hah puen ao telah atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosi ni hai na lungpuen awh hanh. Nangmouh tanouk hanelah thoseh, nangmouh teh sak payonnae dawk hoi hlout hanelah ama taki hanelah thoseh, Cathut a tho toe telah taminaw koe a dei pouh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Taminaw ni ahlanae koe vah a kangdue awh. Mosi teh Cathut onae koe kinghmonae koe lah a hnai.
  </para>
  <para style="p">
    <verse number="22" style="v" />BAWIPA ni Isarelnaw bout a dei pouh e teh, kai ni kalvan hoi nangmouh na pato e hah na panue awh toe.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kai bawknae dawk namamouh hno hanlah ngun cathut thoseh, sui cathut thoseh na sak awh mahoeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kai hanelah talai khoungroe hah na sak awh han. Hote khoungroe dawk nange hmaisawi sathei, yonthanae sathei lah kaawm e nange tu, maitonaw hah na thueng awh han. Ka min na bawknae hmuen pueng dawk nang koe ka tho vaiteh yawhawinae na poe han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang ni talung khoungroe hah kai hanlah na sak pawiteh, talung dei e hoi na sak mahoeh. Sum hoi thuk e talung hoi sak e khoungroe teh khinnae ao.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nang dawk kayanae ao hoeh nahanelah, khoungroe dawk khalai hoi na luen mahoeh telah ati.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA nihai, nang ni Isarelnaw koe lawk na ceng hane teh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Hebru tami san lah na ran pawiteh, kum taruk touh dueng san lah na ta han. Kum sari a pha toteh ratang laipalah na hlout sak han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Santoung nah tami buet touh dueng santoung pawiteh, buet touh dueng a tâco han. A yuvâ kahni touh hoi santoung pawiteh, a yu hoi cungtalah na tâco sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nahoeh pawiteh, a bawipa ni a yu a la pouh e awm pawiteh, hote a yu hoi canaw khe pawiteh, a yu hoi a canaw teh a bawipa ni a coe han. San teh ama dueng a tâco han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nahoeh pawiteh, san ni ka bawipa hoi ka yu ka canaw ka lungpataw, tâco hane ka ngai hoeh telah tet pawiteh,
  </para>
  <para style="p">
    <verse number="6" style="v" />A bawipa ni Cathut hmalah thoseh, im takhang koe thoseh, a hnâ caphuem hoi a kavi pouh hnukkhu, hote san teh a yungyoe san lah ao han.
  </para>
  <para style="p">
    <verse number="7" style="v" />A na pa ni a canu san lah yawt pawiteh, hote napui teh san tongpa patetlah hlout mahoeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A bawipa ni hote napui a la teh ngai hoehpawiteh, bout a ratang sak han. Ahni hah a dum dawkvah alouke miphunnaw koe yawt thai hoeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A capa hanlah lat boipawiteh, a canu patetlah a khetyawt han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Alouke napui bout lat pawiteh, hmaloe a la e napui e khohna hoi a yu lah onae hah raphoe pouh mahoeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hete hno kathum touh sak pouh hoehpawiteh, aphu het laipalah a hlout sak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tami hem boi lah dout pawiteh ama hai a due roeroe han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thei hanlah noenae awm laipalah Cathut ni a kut dawk hringnae poe boipawiteh, a yawng nahane hmuen hah na pouk pouh awh han.
  </para>
  <para style="p">
    <verse number="14" style="v" />A imri thei hanlah noenae a tawn teh, ka tuk e tami teh ka khoungroe kângue nakunghai, sawn vaiteh thei roeroe han.
  </para>
  <para style="p">
    <verse number="15" style="v" />A manu hoi a na pa ka hem e tami a due roeroe han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka parawt e tami ni a paru e hno a yo nakunghai thoseh, a kut dawk kaawm nakunghai thoseh, thei lah ao roeroe han.
  </para>
  <para style="p">
    <verse number="17" style="v" />A manu hoi a na pa thoe ka bo e tami teh thei lah ao han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tami hoi tami kâyue teh buet touh ni talung hoi a dêi nakunghai thoseh, a kut hoi a thâw nakunghai thoseh, hemnae ka khang e tami kadout hoeh nakunghai, ikhun dawk sut ka yan nakunghai thoseh,
  </para>
  <para style="p">
    <verse number="19" style="v" />bout a thaw teh sonron hoi ka cet nakunghai thoseh, ka hem e tami han a yonnae ngaithoum han. Hatei, ka pataw e tami thaw a kamkak dawkvah, a dam nahan kâsatnae aphu a poe han.
  </para>
  <para style="p">
    <verse number="20" style="v" />A bawipa ni a sannu hoi a sanpa hah bongpai hoi a hem teh hote san dout pawiteh, a bawipa teh reknae ka patawpoung lah poe roeroe han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hatei, san teh hnin touh, hnin hni a pataw hoi dout hoehpawiteh, hote san teh a bawipa e lah ao dawkvah reknae dawk hoi a hlout han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tami hoi tami kâyue teh camo ka vawn e napui a takit dawk camo a kamko teh alouke patawnae bang awm hoehpawiteh, a vâ ni a dei e patetlah rek lah ao han. Bawi ni a dei e patetlah a rawng han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Alouke patawnae awm pawiteh, hringnae hanlah hringnae thoseh,
  </para>
  <para style="p">
    <verse number="24" style="v" />Mit hanlah mit thoseh, hâ hanlah hâ thoseh, kut hanlah kut thoseh, khok hanlah khok thoseh,
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmai hanlah hmai thoseh, a hmâ hanlah a hmâ thoseh, hemnae hanlah hemnae thoseh a khang han.
  </para>
  <para style="p">
    <verse number="26" style="v" />A bawipa ni a sannu a sanpa e a mit a rawk totouh hem pawiteh, a mit a rawk dawkvah a hlout sak han.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hot patetvanlah, a sannu a sanpa e a hâ ka lawt lah hem pawiteh, a hâ a lawt dawkvah a hlout sak han.
  </para>
  <para style="p">
    <verse number="28" style="v" />Maito ni tami napui hoi tongpa a deng dawk dout pawiteh, hote maito hah atangcalah koung kadout lah dêi han. A moi hai cat mahoeh. Katawnkung teh ngaithoum lah ao han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hot patetvanlah, tami ouk ka deng e maito, katawnkung ni tami ouk a deng e kong a thai nahlangva, pâkhit laipalah tat pawiteh, hote maito ni tami napui tongpa koung kadout lah deng pawiteh, hote maito teh talung hoi koung kadout lah dêi han. Katawnkung hai thei lah ao han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nahoeh pawiteh, tangka rawng naseh telah dei pawiteh, dei e patetlah amae hringnae kâratang nahanlah a rawng han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ayânaw e canaw deng pawiteh, a dei e patetlah a khang han.
  </para>
  <para style="p">
    <verse number="32" style="v" />A sannu sanpa deng boipawiteh, maito katawnkung ni san katawnkung tangka 30 touh a rawng pouh han. Maito hai talung hoi koung kadout lah dêi han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tami ni tangkom khuem paawng teh a tanae dawk thoseh, tangkom a tai teh teng laipalah a ta e dawk thoseh, ayânaw e marang hoi maito bawt pawiteh,
  </para>
  <para style="p">
    <verse number="34" style="v" />Tangkom ka tai e ni marang hoi maito phu hah a rawng vaiteh a ro a la han.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tami buet touh e maito ni ayâ louk e maito koung kadout lah deng pawiteh, maito ka tawn roi ni kahring e maito hah a yo roi vaiteh aphu a kârei roi han. Kadout e maito hai a kârei roi han.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hot patetvanlah, maito ni ouk a deng tie katawnkung ni a panue nahlangva, pâkhit laipalah paktha pawiteh, maito ro ama ni a la han. Hote maito buet touh e a yueng lah maito buet touh a rawng han.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tami ni tu hoi maito hah a paru teh a thei nakunghai thoseh, a yo nakunghai thoseh, maito buet touh dawk maito panga touh, tu buet touh dawk tu pali touh hoi bout a patho han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tamru ni imthung a kun nah ayâ ni a hmu teh ka thet nakunghai, due yueng lah dout mahoeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hatei, kanî tâcawt pawiteh, duenae phu a due van han. Bangkongtetpawiteh, bout a poe thai. Hno awm hoehpawiteh a paru e hno patho nahanlah amahoima a kâyo han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tamru e kut dawk tu maito hah a hring lah hmawt pawiteh, let hni hoi a patho han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ayâ e laikawk hoi misur takha a ca sak nakunghai thoseh, saring ayâ e laikawk dawk khoum nakunghai thoseh, mae laikawk hoi misur dawk e kahawi poung e rasa vaiteh bout a poe han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmaisawi nah phovai a kak dawkvah cabong, cakung, laikawk dawk kaawm e hnonaw kang pawiteh, hmai kasawikung ni a rawng han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tami buet touh ni a imri buet touh koe suingun patet e hno buetbuet touh a hnawng teh, a hnawng e tami e im dawk hoi tamru ni parawt pawiteh tamru hah a hmu awh navah, tamru ni let hni hoi a rawng han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tamru pâphawng hoeh boipawiteh, katawnkung ni a imri hah hno a la hoi a la hoeh e Cathut hmalah a pacei han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ayâ e hno la payonnae dawk maito, la, tu, khohna patet e kahmat e hno buetbuet touh a hmu teh, hete hno heh kaie doeh telah tami buetbuet touh ni tetpawiteh, hote tami roi teh Cathut hmalah pacei vaiteh ka sung e ni let hni hoi a rawng han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tami ni a imri e laikawk dawk marang, maito, tu patet e saring buetbuet touh a hnawng teh hote saring dout nakunghai thoseh, a hmâtan a ca teh pataw nakunghai thoseh, kapanuekkhaikung awm laipalah ayâ ni oun ka hrawi nakunghai thoseh,
  </para>
  <para style="p">
    <verse number="11" style="v" />A hnawng e tami ni ka imri e hno ka lat hoeh telah kahni touh hoi hnâ a bo roi teh BAWIPA hmalah thoe kâ bo roi pawiteh hno katawnkung ni a hnâbo khai vaiteh, a hnawng e tami ni hai rawng mahoeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hat ei, ayâ ni oun parawt pawiteh, a hnawng e tami ni hno katawnkung bout a poe han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sarang ni kei pawiteh panuekhai nahanlah a ro patue naseh. A ro patue thai pawiteh rawng mahoeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tami ni a imri koe hno buetbuet touh a hlai teh katawnkung ao hoehnahlan, oun dout nakunghai thoseh, a hmâtan a ca teh pataw nakunghai thoseh, a rawng han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Katawnkung awm pawiteh kahlaikung ni rawng mahoeh. Aphu hoi hlai pawiteh, katawnkung ni a hlainae phu dueng a hei han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tongpa buet touh ni a yu hanlah ham hoeh e tangla pasawtpanep hoi ipkhai pawiteh, aphu a poe vaiteh a yu lah a la roeroe han.
  </para>
  <para style="p">
    <verse number="17" style="v" />A na pa ni vâ sak hanlah ngaikhai hoehpawiteh, a ikhainae phu teh a rawng roeroe han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmaui napui na hring sak awh mahoeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Saring hoi ka ip e tami teh thei lah ao han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jehovah hloilah, alouke cathut hmalah thuengnae ka sak e tami teh thei lah ao han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ram alouke imyin hah na pacekpahlek awh mahoeh. Nangmouh haiyah Izip ram dawk imyin lah ouk na o awh toe.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nara hoi lahmai hah pacekpahlek awh hanh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tami buetbuet touh na pacekpahlek awh teh ahnimouh ni kai koe tica hai hram awh boipawiteh, a hramnae lawk ka thai han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangmouh koe ka lung puenghoi a khuek vaiteh, tahloi hoi na thei awh han. Na yunaw hai lahmai lah ao vaiteh, na canaw hai nara lah ao awh han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka tami, ka roedeng e na imri koe tangka na cawi pawiteh, apung kacatnaw patetlah na cat mahoeh. Apung hai na het mahoeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na imri ni a hni nang koe pâhung pawiteh, kho a hmo hoehnahlan bout na poe han.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bangkongtetpawiteh, hni kâkhu hane alouke tawn hoeh. Ama a kâkhu hanelah a tho. Ahni teh bangtelamaw a i thai han. Kai na kaw pawiteh ka thai pouh han. Kai teh pahrennae ka tawn e lah ka o.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cathut hah kathout lah na dei mahoeh. Na miphun ka uk e bawi hah thoe na bo mahoeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aluepaw hmaloe kahmin e hoi kasu e ratui hah hrawk laipalah na poe han. Ca tongpa camin haiyah kai koe na poe awh han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hot patetvanlah, tu hoi maitonaw hai na sak awh han. Hnin sari touh thung tu maitoca hah a manu hoi rei na ta awh vaiteh, hnin taroe hnin nah na poe han.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nang ni laithoe e kamthang hah patuen na pathang mahoeh, na dei mahoeh. Tamikalanhoehnaw hoi lungkânging teh kapanuekkhaikung lah na awm mahoeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tamikathoutnaw e hnukkâbang mahoeh. Lawkceng navah tami kalen kambawng laihoi lamthung phensak hanlah na dei mahoeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mathoe koehai kapeknae na tawn mahoeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na taran e marang maito lam ka hmang e na hmawt pawiteh bout na thak pouh awh han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang na ka hmawt ngai hoeh e tami e la hah a hno ni a ratet e na hmawt pawiteh, na kabawp ngai hoeh hai na kabawp han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mathoe ni nang na oun nah kahawi hoeh lah ahni lawk na ceng mahoeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kahmanhoeh e hno na roun han. Yon ka tawn hoeh e tamikalan hah na thet mahoeh. Bangkongtetpawiteh, tamikathout teh kai ni ka ngaithoum mahoeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang ni tadawngnae na cat mahoeh. Tadawngnae ni tami lungkaangnaw hah mit a dawn sak teh tami kalannaw lawk a phen sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ram alouke imyin hah rektap awh hanh. Nangmouh teh Izip ram dawk imyin lah ouk na o awh toung dawkvah, imyin ni a tawn e lungthin hah na panue awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kum taruk touh thung laikawk na tawk vaiteh cakang na pâtung awh han.
  </para>
  <para style="p">
    <verse number="11" style="v" />A kum sari nah laikawk tawk laipalah na ta han. Hottelah, na sak pawiteh, mathoenaw ni a ca thai awh van han. Kacawie naw hai saringnaw ni a ca awh han. Hot patetvanlah, misur takha, olive takha hai na sak awh han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hnin taruk touh thung thaw na tawk awh han. A hnin sari nah na kâhat awh han. Hottelah, na sak pawiteh, na maito hoi lanaw ni kâhatnae tueng a tawn awh han. Na canaw, imyinnaw hai tha a dam awh han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka dei e lawknaw pueng hah pâkuem awh. Alouke cathut min hah dei awh hanh. Na pahni dawk hoi dei e lawk ayâ ni thai hanh naseh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kum touh dawk vai thum touh kai hanlah pawi na sak awh han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tonphuenhoehe vaiyei pawi na sak awh han. Kâ na poe tangcoung e patetlah hnin sari touh thung tonphuenhoehe na ca awh han. Bangkongtetpawiteh, hote thapa dawk nangmouh teh Izip ram hoi na tâco awh. Hote pawi na sak awh navah apihai kai koe a kuthrawng hoi tho hanh naseh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laikawk tawk teh cang a han nah, cang takhawknae thoseh, cakang koung kuem hoi kum abaw nah, cavanca pawi thoseh na sak awh han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmouh thung dawk tongpa pueng teh kum touh dawk vai thum touh Bawipa Jehovah e hmalah minhmai na patue awh han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kai e sathei e thi hah ton phuen e vaiyei kalawt laihoi na poe mahoeh. Kai e sathei e athaw hai amom totouh na tat awh mahoeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na law dawk e a pawhik kahawi poung e aluepaw hah na BAWIPA Cathut e im dawk na thokhai awh han. Hmaeca hah a manu e sanutui hoi na thawng mahoeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khenhaw! lam vah nang na ring vaiteh, ka rakueng e hmuen koe hrawi hanelah na hmalah kalvantami ka patoun han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hote kalvantami hah barinae tawn. A lawk hah ngai pouh. A kâ ek hanh. Kâ na tapoenae hah ahni ni na ngaithoum awh mahoeh. Kai e ka min teh ahni dawk ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang ni atangcalah a lawk na ngai teh, kaie kâlawk patetlah na sak pawiteh, nange tarannaw hah ka taran van han. Nang kangangnaw hah kai ni ka ngang van han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kaie kalvantami ni na hmalah a cei vaiteh Amor tami, Hit tami, Periz tami, Kanaan tami, Hiv tami hoi Jubusitnaw onae hmuen koe na hrawi awh vaiteh, ahnimouh teh koung ka pâlei han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahnimae cathut hah na bawk awh mahoeh. Ahnimae bawknae patet lahai na sak awh mahoeh. Koung na raphoe awh vaiteh kutsak cathutnaw hai phetrasei lah na dei pouh han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangmae BAWIPA Cathut hah na bawk awh han. Na vaiyei thoseh, tui thoseh yawhawinae a poe han. Lacik hai nange nathung hoi a takhoe han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na ram dawk camo ronae hoi carôenae awm mahoeh. Na hringyung ka vang sak han.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kai na takinae lungthin hah na hmalah ka patoun vaiteh, na phanae hmuen pueng koe e miphunnaw pueng hah ka raphoe han. Na tarannaw pueng hah hnuklah ka ban sak han.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khoingannaw hah na hmalah ka patoun vaiteh, Hitnaw, Kanaannaw, Hivnaw hah na hmalah a pâlei han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hote taminaw kum touh hoi na hmalah lahoi koung ka pâlei mahoeh. Koung ka pâlei pawiteh, ram dawk tami kingdi vaiteh sarang teh nang hanlah kapap han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nang ni na pungdaw teh ram dawk na kawi hoehnahlan pueng, ahnimouh teh payai lahoi ka pâlei han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Na ramri teh tuipui paling tui koehoi Filistin tuipui totouh, thingyeiyawn hoi tuipui totouh kai ni ka khoe han. Hote khocanaw teh na kut dawk na poe vaiteh nang ni na pâlei han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahnimouh hoi thoseh, ahnimae cathutnaw hoi thoseh, kâhuikonae na sak awh mahoeh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nang ni kai koe yonnae na sak hanelah, ahnimouh ni a sak han tie puennae ao dawkvah, ahnimouh teh na ram dawk awm awh mahoeh. Nang ni ahnimae cathut hah na bawk pawiteh, kamthuinae katang lah ao han telah Mosi koe atipouh.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi, BAWIPA ni Mosi koe, nang, Aron, Nadab, Abihu hoi Isarel kacue 70 touh hoi cungtalah, BAWIPA koe luen awh nateh ahnimouh teh ahlanae koehoi bawk awh naseh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang dueng ni BAWIPA hah na hnai han. Alouknaw ni na hnai han naseh. Taminaw teh nang hoi cungtalah rei na luen mahoeh telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi ni hai taminaw onae koe a tho teh, BAWIPA e lawknaw pueng thoseh, lawkcengnae naw pueng thoseh, a thai sak. Taminaw ni hai BAWIPA e lawk patetlah ka sak awh han telah rip bout ati awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosi ni BAWIPA e lawknaw pueng a thut hnukkhu, amom a thaw teh mon khok koevah khoungroe thoseh, Isarel miphun hlaikahni touh hanelah talung hlaikahni touh thoseh a ung awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isarel thoundounnaw a patoun e patetlah ahnimouh ni maitonaw a thokhai awh teh BAWIPA hmalah hmaisawinae sathei, roumnae sathei hah a thueng awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi ni a thi tangawn hah kawlung dawk a hlun hnukkhu, atangawn e hah khoungroe van vah a kathek.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lawkkamnae ca hah a la teh tamimaya hmalah a touk hnukkhu, ahnimouh ni hai BAWIPA ni a dei e patetlah kaimouh ni ka sak awh han, ka ngâi awh han telah ati awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi ni thi hah a la teh taminaw e lathueng vah a kâhei teh; hete thi teh hete hnonaw dawk BAWIPA ni nangmouh koe e lawkkamnae thi lah ao telah atipouh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hat navah, Mosi, Aron, Nadab, Abihu hoi Isarel kacue 70 touh a luen awh teh,
  </para>
  <para style="p">
    <verse number="10" style="v" />Isarel miphunnaw e Cathut hah a hmu awh. A khok rahim lah Sapphire talung rem e patetlah thoseh, thoungnae teh kalvan pinkâhin e patetlah thoseh a kamnue.
  </para>
  <para style="p">
    <verse number="11" style="v" />Isarel kahrawikungnaw koe a kut phat sak hoeh. Ahnimouh ni Cathut a hmu awh eiteh, a canei awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />BAWIPA ni ka onae monsom vah luen nateh awm haw. Taminaw cangkhai hanelah lungphen dawk thut e kâlawknaw heh nang koe na poe han telah Mosi koe atipouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi ni kabawmkung Joshua hoi a thaw teh Cathut e mon dawk a luen roi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kacuenaw koe kaimouh roi ka tho hoeh roukrak hete hmuen koehoi na ring awh. Aron hoi Hur teh nangmouh koe ao dawkvah rucat kâhmo e awm pawiteh ahnimouh roi koe cet naseh telah lawk a thui.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi ni mon vah a luen teh tâmai ni mon teh muen a kayo.
  </para>
  <para style="p">
    <verse number="16" style="v" />BAWIPA e bawilennae teh Sinai mon vah a kâhat teh tâmai ni hnin taruk touh thung muen a kayo. Hnin sari nah, tâmai thung hoi Mosi a kaw.
  </para>
  <para style="p">
    <verse number="17" style="v" />BAWIPA e bawilennae teh monsom vah hmai ka kang e patetlah kamnuek e Isarelnaw ni a hmu awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mosi teh tâmai thung a kâen teh mon a pha. A hnin 40 touh thung mon vah ao.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi hah a pato teh,
  </para>
  <para style="p">
    <verse number="2" style="v" />kai koevah pasoumhno poe hanelah, Isarelnaw hah dei pouh. Lungthocalah hoi ka poe e pueng kaie pasoumhno lah na la han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hetnaw heh ahnimouh koehoi na la hane pasoumhno lah ao han. Sui, ngun, rahum
  </para>
  <para style="p">
    <verse number="4" style="v" />kamthim hni, âthi hni, hnipaling, loukloukkaang e lukkarei, hmae muen,
  </para>
  <para style="p">
    <verse number="5" style="v" />tu pho âthi bu e, a pho kahawi phu kaawm e hoi, anri thing,
  </para>
  <para style="p">
    <verse number="6" style="v" />paang hane satui, kâhluk e satui hoi hmuitui,
  </para>
  <para style="p">
    <verse number="7" style="v" />vaihma angki hoi lungtabue bet hanelah onyx talung phu kaawm,
  </para>
  <para style="p">
    <verse number="8" style="v" />hahoi ahnimouh koe ka o thai nahanlah hmuen kathoung na sak pouh awh naseh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lukkareiim e mei hoi a puengcangnaw e mei pueng kai ni na hmu sak e patetlah na sak han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hahoi anri thing e thingkong ayung dong hni tangawn, adangka dong touh hoi a tangawn, arasang dong touh hoi tangawn hoi na sak han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Athung avan suikathoung hoi na hluk vaiteh, sui hoi pangkhek na sak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Laikaw pali touh sui hoi na sak vaiteh, a khok dawk na mahrawk han. Laikaw kahni touh hah avanglae a khok dawk, alouke kahni touh hah avanglae a khok dawk na mahrawk han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kâkayawtnae acung hah anri thing e na sak vaiteh, sui koung na hluk han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thingkong kâkayawt thai nahanelah, tapang dawk e laikaw dawk kâkayawtnae acung hah na hrawt han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thingkong e laikaw dawkvah kâkayawtnae acung teh pou na hrawt vaiteh, na rayu mahoeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thingkong thung vah lawkpanuesaknae kai ni na poe hane hah na ta han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lungmanae tungkhung hah ayung dong hni tangawn, adangka dong hni tangawn hoi na sak han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungmanae tungkhung apoutnae reira dawk cherubim kahni touh dei lah dei e sui hoi na sak han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Avang lae apoutnae dawk cherubim buet touh, avanglae apoutnae dawk hoi cherubim buet touh na sak han. Lungmanae tungkhung hoi kâkuen lah apoutnae roi koe cherubim kahni touh na sak han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hottelah cherubim kahni touh minhmai kadangka lahoi lungmanae tungkhung hah a rathei kadai hoi a khu vaiteh, lungmanae tungkhung koe lah cherubim ni a khet han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hote thingkong van vah lungmanae tungkhung teh na ta awh vaiteh, na poe hane lawkpanuesaknae hah thingkong thung vah na ta han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hote hmuen dawk nang koe ka tho vaiteh, cherubim kahni touh rahak e lawkpanuesaknae thingkong van lungmanae tungkhung lahoi Isarel taminaw koevah kâ na poe hane pueng dawk lawk ka dei han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hahoi anri thing hoi caboi ayung dong hni, adangka dong touh, a rasang dong touh hoi tangawn hoi na sak han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kathounge sui hoi na hluk vaiteh, pangkhek hah sui hoi na pacawp sin han.
  </para>
  <para style="p">
    <verse number="25" style="v" />A phen kuttabei tittouh e hoi petkâkalup lah a hna na bet vaiteh, sui hoi na pacawp sin han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Caboi hanlah sui laikaw pali touh na sak vaiteh, a khok pali touh onae takin pali touh dawk na ta han.
  </para>
  <para style="p">
    <verse number="27" style="v" />Caboi hah kâkayawt thai nahan, acung hrawt thai nahanelah, laikaw hah a hna hoi kamtawm lah na mawp han.
  </para>
  <para style="p">
    <verse number="28" style="v" />Caboi hah kâkayawt thai nahanlah anri thing e acung na sak vaiteh, sui tui hoi na hluk han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hote hno hanlah, tongben, pacen, kawlung hoi awi nahane manang haiyah sui hoi na sak han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Caboi van vah vaiyei hah ka hmaitung vah pou na pâhung han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hahoi hmaiimkhok hah sui hoi na sak vaiteh dei lah dei e han. Hmaikhom patet e kutnaw, manangnaw, a peimuemnaw, lili peinaw hah buet touh lah na dei han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hmaiimkhok avoivang lahoi kathum kathum touh a tâco vaiteh, a kut taruk touh ao han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hmaiimkhok dawk hoi ka tâcawt e a kut kathum touh dawk, a kut buet buet touh dawk a peimuem, lili pei, almond paw hoi mei kâvan e manang kathum touh ao han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hmaiimkhok dawk hai a peimuemnaw, lili peinaw, almond paw, mei kalmond paw hoi mei kâvan evan e manang pali touh ao han.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hmaiimkhok dawk hoi ka tâcawt e a kut taruk touh ao e patetlah a kut kahni touh e rahim haiyah a peimuem buet touh rip ao han. Hmaikhom abuemlah suikathoung hoi na dei han.
  </para>
  <para style="p">
    <verse number="36" style="v" />A peimuemnaw a kutnaw hah buet touh lah koung na kâkuetsak han. Abuemlah suikathoung hoi na dêi han.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hote hno hanlah hmaiim sari touh na sak vaiteh, a hmalah a ang thai nahanlah hmaiim hah na paang han.
  </para>
  <para style="p">
    <verse number="38" style="v" />Paitei hoi padounnae haiyah suikathoung lah ao han.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hmaiim tanae hoi a hnopai pueng saknae dawk suikathoung pong 100 touh na hno han.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mon vah meilam na patue e patetlah bangpueng sak hanelah pahnim hanh.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hothloilah, lukkareiim hah âthi hni, hnipaling, loukloukkaang e hni yung hra touh hoi sak e, cherubim em kahawicalah na la vaiteh, mek na sak sin han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Yaphni e teh ayung dong 28 touh rip a kâvan han. Adangka dong 4 touh rip han. Abuemlahoi yaphni koung a kâvan han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Yaphni e hah buet touh hoi buet touh koung kâbet han. Alouke panga touh hai buet touh hoi buet touh koung a kâbet han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Patawp e yaphni hah apasuek e a tâphai a poutnae dawk laikaw dik kamthim e hoi na sak han. Hottelah patawp e yaphni e apâhni e avanglae apoutnae dawk hai na sak han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Yaphni buet touh dawkvah, laikaw 50 touh na sak han. Hahoi patawpnae apasueke tâphai dawk hai laikaw 50 touh na sak vaiteh, phouk kadangka lah ao awh han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tarennae 50 touh sui hoi na sak han. Hote tarennae ni yaphni hah hmai na taren sin vaiteh, lukkareiim teh buet touh lah na o sak han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lukkareiim e a lemphu dawkvah, hmae muen hoi yaphni hah na sak han. Yaphni 11 touh hoi na sak han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Yaphni teh ayung dong 30 touh rip a pha han. Adangka dong pali touh vaiteh, yaphni 11 touh e hah koung a kâvan han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaphni panga touh e hah koung na patawp han. Hahoi yaphni taruk touh hah lukkareiim hma lae yaphni taruk touh e hmalah koung na patawp han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Patawp e yaphni pasuek e tâphai dawk laikaw 50 touh hoi na sak vaiteh, patawpnae apâhni e tâphai dawk laikaw 50 touh na sak han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hetsinnae 50 touh e hah rahum hoi na sak han. Rakhan buet touh lah ao thai nahanelah, hetsinnae hah tâphai lae laikaw dawk na bang han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lukkareiim e yaphni kacawie tangawn hah, lukkareiim e a hnuklah na bang han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hahoi lukkareiim avanlah kacawie yaphni som dong touh reira e hateh avangvanglah lukkareiim ramuknae a kahup lah a kâbang han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lukkareiim lemphu ramuk nahanelah tu pho paling bu e, hote tu pho van vah hmae pho hah na sak han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lukkareiim tungdum nahanelah thingpheknaw hah anri thing hoi na sak han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thingphek teh asaw e dong hra, akaw e dong touh hoi tangawn han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hote thingphek pueng dawk a khok kahni touh na sak han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lukkareiim akalah kalup nahanelah thingphek 20 touh na sak han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hote thingphek 20 touh dawk e buetbuet touh e rahim vah, a khok kahni touh mawp nahanelah ngun khokpacawp 40 touh na sak han. A tangkhang hanelah ngun khokpacawp kahni touh lengkaleng na sak han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hot patetvanlah, lukkareiim atunglah kalup nahanelah thingphek 20 touh ao han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngun khokpacawp 40 touh e hah thingphek buet touh hanelah kahni touh lengkaleng na sak han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lukkareiim a hnuk lae kalup nahanelah thingphek 6 touh na sak han.
  </para>
  <para style="p">
    <verse number="23" style="v" />A takin avoivang lah kalup nahane kahni touh na sak han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Takin kahni touh dawk, a rahim lahai a lathueng lahai laikaw hah na bang han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hahoi thingphek 8 touh hah na kangdue nahanelah ngun laikaw 16 touh ao han, thingphek buet touh hanelah tarik e kahni touh lengkaleng ao han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Anri thing hoi tapang e pangkhek hah na sak han. Lukkareiim avangvanglah hane thingphek panga touh lukkareiim avanglah hane thingphek panga touh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lukkareiim hnuklah kalupnae thingphek hrawt nahanelah tarennae acung yung panga touh na sak han.
  </para>
  <para style="p">
    <verse number="28" style="v" />A lungui tapang tâphai hah a tangkhang thingphek lungui hoi avanglah apoutnae koehoi avanglah a poutnae totouh na pha sak han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thingphek hah sui tui hoi na hluk han. Hahoi tapang e tâphai hrawtnae laikaw hah sui hoi na sak han, tapang tâphai hai sui tui hoi na hluk han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hottelah mon dawkvah, kai ni na patue e patetlah lukkareiim teh na sak han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kamthim hni, âthi hni, hnipaling loukloukkaang e hoi carouk e na sak han. A meikahawicalah cherubim mei na sak han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hote sui tui hluk e anri thing khom pali touh dawkvah yaphni hah na bang han. Hote khom teh sui hoi sak e hetnae hoi ngun khokpacawp pali touh dawk ung e lah ao han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kacakcalah na het vaiteh, yaphni hah na yap vaiteh, yaphni thung lah lawkpanuesaknae thing kong hah na ta han. Yaphni na yap e hah namamouh hane hmuen kathoung hoi hmuen kathoungpounge kapeknae lah ao han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lungmanae tungkhung hah hmuen kathoungpounge lawkpanuesaknae thingkong van na ta han.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yaphni alawilah caboi hah na ta vaiteh, lukkareiim akalae hmaiimkhok, atunglah caboi buet touh hoi buet touh kadangka lah na ta han.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hahoi lukkareiim takhang koe yaphni loukloukkaang e, carouk e lukkarei kamthim hni, âthi hni, hnipalingnaw, hoi, emlakathoum koe em la sak hoi na sak han.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hahoi anri thing hoi yaphni yap nahane hah khom panga touh na sak vaiteh, sui tui koung na hluk han. Bang nahanelah sui hoi na sak han. Hotnaw pâhung nahanelah, rahum khokpacawp panga touh na sak han.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Anri thing hoi khoungroe ayung dong panga, adangka dong panga, arasang dong thum, a takin pali touh lah na sak han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khoungroe hoi kâkuen lah a takin pali touh dawk a ki na sak vaiteh, rahum tui koung na hluk han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hraba kawnnae ampaikei, tawkso, ailo, cingco, hoi tawngben naw hah rahum e na sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hote khoungroe teh, rahum cuekkarue na sak vaiteh, a takin pali touh dawk rahum laikaw pali touh na sak han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tamlawk ni khoungroe tangawn a pha thai nahanlah, a lungui totouh khoungroe hna a rahim lah na ta han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khoungroe kâkayawtnae acung anri thing hoi na sak vaiteh, rahum tui na hluk han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hote kâkayawtnae acung teh, laikaw dawk na hrawt vaiteh, kâkayawtnae acung hoi kâkayawt thai nahanelah, khoungroe teng vah, reirei ta han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hote khoungroe teh thingphek hoi athunglah vukkâko lah na sak han. Athung avan kâpicalah na sak han. Mon vah na patue e patetlah na sak han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lukkareiim thongma hai na sak han. Akalah kalup nahanelah loukloukkaang e hni kawng e dong 100 touh kasaw na sak han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hote yaphni yap nahanelah khom 20, khokpacawp 20 touh hah rahum hoi na sak vaiteh, hetnae hoi pangkheknaw teh ngun hoi na sak han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hot patetlah, atunglae kalup nahanelah, ayung dong 100 touh ka phat e yaphni hoi cungtalah, ngun hetnae, ngun pangkhek, rahum khom 20, rahum khokpacawp 20 touh ao han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kalupnae a hnuklah kalup nahanelah ayung dong 50 touh e yaphni hoi khom hra touh, khokpacawp hra touh ao han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kalupnae a hma lae hai adangka dong 50 touh ao han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Longkha avangvanglah yap hane ayung dong hlaipanga touh kasawe yaphni hoi, khom kathum touh,
  </para>
  <para style="p">
    <verse number="15" style="v" />khokpacawp kathum touh ao han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kalupnae longkha koe yap hane dong 20 touh kasawe yaphni teh kamthim hni, âthi hni, hnipaling, loukloukkaang e lukkarei carouk e hoi, khom pali touh, khokpacawp pali touh ao han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kalupnae petkâkalup lah kaawm e pueng teh, hetnae hah ngun, pangkhek hah ngun, khokpacawp hah rahum han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kalupnae teh ayung dong cum, adangka dong 50, arasang dong panga touh a pha vaiteh, loukloukkaang e lukkarei hoi rahum khokpacawp lah ao han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lukkareiim dawk hnopai e naw pueng hoi lukkareiim dawk hno e hetnae hoi, kalupnae dawk hno e hetnae pueng teh rahum hoi sak e lah ao han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmaiim pou paang thai nahanelah, Olive paw phawm laihoi raci e olive satui kathoung hah, Isarelnaw ni a thokhai awh nahanlah kâ na poe han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lawkpanuesaknae yaphni yap e alawilah kamkhuengnae hmuen koe, Aron hoi a canaw ni tangmin hoi amom ditouh BAWIPA hmalah, hote thaw hah a tawk awh han. Hetheh, Isarel catounnaw ni catounnaw totouh a tarawi awh hane phunglam lah ao han.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aron hoi Aron capa Nadab, Abihu, Eleazar hoi Ithamar naw ni, kai koevah, vaihma thaw a tawk thai awh nahanelah, na hmau Aron hoi a capanaw hah Isarel catounnaw thung hoi lat haw.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hahoi na hmau Aron hanelah, kathounge khohna ka bawilen sakkung meikahawisakkung lah na o sak han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kutsakkathoume, lungangnae muitha lahoi, kakawisaknaw pueng hah dei pouh. Aloukcalah kapek e koehoi Aron ni vaihma thaw kai hanelah a tawk thai nahan a khohna hah sak pouh naseh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hetheh khohna hanelah a khui awh hanelah doeh. Saiphei, angki, angkidung, Ephod, lupawk hoi taisawm. Na hmau Aron hoi a capanaw ni kai han vaihma thaw a tawk thai awh nahan, kathounge khohna na sak pouh han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sui, kamthim, paling, loukloukkaang e pahla hoi na sak pouh han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vaihma angki teh kutsakkathoumnaw ni a sak e patetlah Sui, kamthim, âthi, paling, loukloukkaang e pahla hoi carouk e lahoi a sak han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Apoutnae koe vah a loung dawk pâbawk e arui kahni touh ao vaiteh, hothateh pâbawk e lah ao han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sui, kamthim, âthi, paling, opaou, hoi loukloukkaang e angki dawkvah, yeng hane taisawm kahawipoung lah kawng e angki hoi, aphu kaawmpoung e hno han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hahoi aphu kaawm e talung kahni touh na la vaiteh, avan vah Isarel catounnaw e min hah na thut han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Talung aphu kaawm e buet touh dawkvah, minnaw taruk touh, alouke talung dawkvah taruk touh, a tâconae lahoi na thut pouh han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Min na thutnae talung thuk kathoumnaw ni a thuk awh e patetlah Isarel catounnaw e min hah talung kahni touh dawk na thuk han. Suihlaam dawk na pâseng han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Isarel catounnaw pahnim hoeh nahanelah hote talung kahni touh hah angki rui dawk na bet han. Hottelah Aron ni ahnimae minnaw hah a loung roi dawk BAWIPA hmalah a bang han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Suipahla vei e hai na sak vaiteh,
  </para>
  <para style="p">
    <verse number="14" style="v" />Suidingyin kahni touh, rui karawn e patetlah na vei vaiteh, na vei e dingyin teh karawn e hoi a kamtawp han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lawkcengnae Ephod hah na sak han. Sui, kamthim pahla, dikpaling pahla, opaou pahla, loukloukkaang pahla hoi kahawicalah kawng e vaihma angki na sak e patetlah na sak han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Takin pali touh a tawn vaiteh bawkhni touh lah ao han. Ayung khap touh adangka khap touh han.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hahoi talung phu kaawm than pali touh na pâthit han. Apasueke than dawkvah, sardius, topaz, hoi carbuncle han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Apâhni e than dawkvah, emerald, sapphire hoi diamon han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Apâthum e than dawkvah, Jacinth, agate, hoi amethyst han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Apalinae than dawkvah, beril, onyx hoi jasper han. Hotnaw teh sui dawk koung bet e lah ao han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aphu kaawm talungnaw ni, Isarel catounnaw e minparui e patetlah hlaikahni touh ni min rip a tawn awh han. Min thutnae dawk thuk e patetlah miphun pueng hah a minnaw patetlah miphun hlaikahni touh hane doeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ephod a poutnae koevah, rui karawn e patetlah dingyin kathounge vei e hah sui hoi na sak han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hahoi Ephod hanelah suilaikaw kahni touh na sak han. Laikaw kahni touh hah Ephod a poutnae koe na bet han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Suidingyin kahni touh vei e hah Ephod apoutnae koe e laikaw kahni touh dawk na kan han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vei e dingyin hmo a vang lae hah suipahla kahni touh vei e dawkvah na kan han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hahoi suilaikaw kahni touh na sak han. Hot teh Ephod kahni touh a pawi koe vaihma angki e a thung lah na mawp han.
  </para>
  <para style="p">
    <verse number="27" style="v" />Suilaikaw kahni touh alouklah na sak vaiteh, hot teh a hma lae vaihma angki kannae rahim lae kâpatawpnae koe kahawicalah kawng e, vaihma angki kannae van lah na mawp han.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hahoi vaihma angki laikaw dawkvah, Ephod dawk e laikaw hah kamthim pahla hoi mekkhuisin han. Kahawicalah kawng e vaihma angki suinae teh avanlah ao thai nahane hoi Ephod hah vaihma angki hoi a kâphoi thai hoeh nahan,
  </para>
  <para style="p">
    <verse number="29" style="v" />hottelah Aron teh, hmuen kathoung koe a cei toteh, BAWIPA hmalah pou a kamnue nahanelah, a lungthin dawk lawkcengnae ephod dawkvah, Isarel catounnaw e min lah ao han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Urim hoi thummim hah lawkcengnae Ephod dawk na hruek vaiteh, BAWIPA hmalah a cei toteh, Aron e lungthin dawk ao han. Hottelah Aron ni BAWIPA hmalah Isarel catounnaw lawkcengnae hah a lung dawk pou ao han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hahoi vaihma angkidung hah kamthim pahla hoi dueng na kawng awh han.
  </para>
  <para style="p">
    <verse number="32" style="v" />A lungui vah lû mahrawk nahanelah na paaw pouh han. Ka aw e a vak hoeh nahanelah, angki lahuen patetlah arai na yep han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kamthim, dikpaling, loukloukkaang e hoi sak e talepawnaw hai angki petkâkalup lah na sak han. Hote rahak dawkvah, suidinghling hoi petkâkalup lah na sak han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hottelah angkidung dawkvah, suidinghling buet touh hoi talepaw, suidinghling hoi talepaw petkâkalup lah arai dawk na sak han.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aron ni thaw a tawk navah, hottelah a kamthoup han. Hottelah BAWIPA e hmalah hmuen kathoung dawk kâen tâconae tueng nah a pawlawk thai laipalah a due hoeh nahanelah na sak pouh han.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hahoi suikathoung phen na sak vaiteh, avan vah kutnoutthutnae ca tarik e patetlah BAWIPA KOE THOUNGNAE telah na thut han.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hot teh lupawk dawk ao nahanelah, lupawk e hmalah kamthim pahla rui hoi na bet han.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hot teh, Aron tampa dawk ao han. Isarel catounnaw ni kathounge a poehnonaw pueng a thoungsaknae, payonpakainae kaawm e hah Aron ni koung a phu han. Hot teh BAWIPA hmalah dâw han kamcu e lah ao thai nahanelah, a tampa dawk pou a ta han.
  </para>
  <para style="p">
    <verse number="39" style="v" />Angkidung teh loukloukkaang e hoi kahawicalah na carouk vaiteh na kawng han. Loukloukkaang e hni hoiyah vaihma lupawk hah na sak vaiteh, taisawm hai na sak pouh han.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aron capanaw hanlah, angkidung hah na sak pouh vaiteh, taisawm hai ahnimouh han na sak pouh han. A bawilen sak nahan hoi kahawisakkung lah a bawilakhung na sak pouh han.
  </para>
  <para style="p">
    <verse number="41" style="v" />Na hmau Aron hoi a capanaw hah na pathoup han, kai han vaihma thaw a tawk thai nahan satui na awi vaiteh, na hmoun vaiteh, na thoung sak han.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hahoi caici lah a onae na ramuk nahanelah, loukloukkaang e hnadung na sak pouh vaiteh, a keng koehoi a phai totouh a pha han.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hot teh Aron hoi a capanaw kamkhuengnae lukkareiim koe kâennae tueng dawk thoseh, hmuen kathoung koe thaw tawk nahanlah bawknae khoungroe teng a cei nah thoseh a kamthoup awh han. Nahoeh pawiteh, yonpen e lah awm vaiteh, dout awh langvaih. Hot teh amamouh hoi ka tho hane catounnaw totouh a yungyoe hanlah caksak e phunglam doeh toe.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kai hanlah vaihma thaw tawk thai nahan kamthoung sak hanelah, ahnimae lathueng na sak hane teh, hetheh doeh. Maitotan kanaw e buet touh, tutan kanaw e kahni touh toun han kaawm hoeh e,
  </para>
  <para style="p">
    <verse number="2" style="v" />tonphuenhoehe hoi, tonphuenhoehe satui hoi sak e vaiyei phen, satui hoi sak e kanem e vaiyei tonphuenhoehe naw hah na la han, kanui e tavai hoi na sak han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hotehah tangthung dawk na ta vaiteh, maitotan hoi tutan kahni touh hoi tangthung hah na thokhai han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aron hoi a canaw hah kamkhuengnae lukkareiim takhang koevah na thokhai vaiteh, tui na pâsu han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khohnanaw na la vaiteh, angki, hni, ephod hah Aron na kho sak vaiteh, ka talue e angkidung hah taisawm hoi kâyeng sak han.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lû dawk vaihmanaw e lupawk na kâmuk sak vaiteh, hote lupawk van vah kathoungnae lakhung na kâmuk sak han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hahoi awi hane satui na la vaiteh, a lû dawk na awi pouh vaiteh na hluk pouh han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hahoi, a capanaw na kaw vaiteh, na kho sak han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aron hoi a capanaw hah taisawm na kâyeng sak vaiteh, bawilakhung hai na kâmuk sak vaiteh, vaihma coungnae hah a yungyoe hanlah na caksak han. Hottelahoi Aron hoi capanaw teh na thoung sak han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hahoi, kamkhuengnae lukkareiim hmalah maitotan na thokhai vaiteh, Aron hoi a capanaw ni maito e lû dawk kut a toung awh han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hottelah, kamkhuengnae lukkareiim tho teng vah, BAWIPA hmalah maitotan hah na thei han
  </para>
  <para style="p">
    <verse number="12" style="v" />Maitotan e thi hah na la vaiteh khoungroe ki dawk na kutdawn hoi na nep han. Hahoi kacawie thi hah khoungroe kung koe koung na rabawk han.
  </para>
  <para style="p">
    <verse number="13" style="v" />A thung e a kosanaw hoi a thin dawk kaawm e a hmue, a kuen kahni touh hoi athawnaw na la vaiteh, khoungroe dawk hmai na sawi han.
  </para>
  <para style="p">
    <verse number="14" style="v" />Maitotan e a tak, a pho, a khoknaw teh rapan alawilah hmai na sawi han. Hot hah teh yon thuengnae doeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tutan buet touh na thokhai vaiteh, Aron hoi a capanaw ni a lû dawk kut a toung awh han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tutan na thei vaiteh, a thi teh khougroe tengpam vah abuemlahoi na kathek han.
  </para>
  <para style="p">
    <verse number="17" style="v" />A moi hah na tâtueng vaiteh, a ruenthin hoi a khok hoi a lûnaw hah na hruek han.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hahoi tutan e tak abuemlahoi khoungroe dawk hmai na sawi han. Hothateh, BAWIPA hanlah hmaisawi thuengnae, BAWIPA koe hmai hoi hmuitui hmaisawi thuengnae doeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hahoi tutan buet touh bout na thokhai han. Aron hoi a capanaw ni tutan e lû dawk a kut a toung awh han.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tutan hah na thei vaiteh, a thi hah na la vaiteh, Aron e aranglae hnârakong koe, a capanaw e aranglae hnârakong koe, aranglae kutpui hoi a capanaw e aranglae khokpuinaw dawk na nep pouh vaiteh, khoungroe lathueng lah a thi hah na kathek han.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hahoi khoungroe dawk e thi hoi hluk e satui hah na la vaiteh, Aron hoi a capanaw hoi, ahni koe kaawm e a capanaw e hninaw dawk na kathek han. Hahoi teh, a hni hoi ama hoi a capanaw hoi, ahnimouh koe kaawm e a capanaw e hninaw pueng teh, thoung sak lah ao han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hahoi tutan e thaw, mai, ruen ka kayo e thâw, thin dawk kaawm e hmue, kuen kahni touh e hoi, aranglae loung hah na la han. Bangkongtetpawiteh, hothateh, kapek e tuca doeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hahoi, tangthung dawk ta e tonphuenhoehe hah BAWIPA hmalah hung e vaiyei tueng buet touh hoi satui hoi sak e vaiyei phen, vaiyei ka rapam e kahni touh na la vaiteh,
  </para>
  <para style="p">
    <verse number="24" style="v" />Aron e kut hoi a capanaw e kut dawk na ta pouh han. BAWIPA hmalah kahek thueng nahanelah a kahek awh han.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hote hah ahnimae kut dawk hoi na la pouh vaiteh, BAWIPA hanlah hmuitui lah thuengnae hmaisawinae khoungroe dawk sawi han. Hothateh BAWIPA hanlah hmaisawi thuengnae doeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hahoi, Aron e kapeknae lah tu takuep hah na la vaiteh, BAWIPA hmalah kahek thueng nahanlah na kahek han. Hot teh na ham lah ao han
  </para>
  <para style="p">
    <verse number="27" style="v" />Aron hoi a capanaw e ham lah kapek e tutan takuep hah kahek thuengnae hoi tawm thuengnae lah a phai kahek tangcoung e hoi tawm tangcoung e hah na thoung sak han.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hothateh, Isarel catounnaw koe, Aron hoi a capanaw hanlah a yungyoe hoi kapek e lah ao han. Bangkongtetpawiteh, hothateh kahek thuengnae doeh. A loung kahek tangcoung e hoi tawm tangcoung e hah na thueng sak han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hote hnonaw hoi a kamthoup awh teh, satui hluk teh kathounge lah ao thai awh nahan, kathounge Aron e khohna teh, a capanaw ni râw lah a coe awh han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hahoi, a capanaw yueng lah vaihma thaw ka tawk hane tami ni hmuen kathoung koe tawk awh hanelah, kamkhuengnae lukkareiim dawk a kâen navah, hnin sari touh thung a khohna han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hahoi, kapeknae tutan hah la vaiteh, a moi hah hmuen kathoung dawk a thawng awh han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hottelah, Aron hoi a capanaw ni tutan moi hoi tangthung dawk e vaiyei hah kamkhuengnae lukkareiim takhang koe a ca awh han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Yonthanae, ama kapeknae hoi thoungnae dawk poe e moi hah a ca awh han. Kathounge lah ao dawkvah, alawilae taminaw ni cat thai mahoeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hote kapeknae moi hoi vaiyei hah a tangtho amom totouh cawi pawiteh, hmaisawi lah ao han. Hot teh kathounge lah ao dawkvah na cat mahoeh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hahoi kâ na poe e naw pueng patetlah Aron hoi a capanaw lathueng vah ka sak han, hnin sari touh thung na kapek awh han.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hnintangkuem yontha nahanlah maitotan buet touh pou na poe awh han. Hahoi yon ngaithoumnae na sak navah, khoungroe hah na thoungsak han. Thoungsak hanelah satui na awi han.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hnin sari touh thung khoungroe hanlah yonthanae na sak vaiteh, na thoung sak han. Hat toteh, khoungroe teh kathounge lah ao vaiteh, khoungroe ka tek e pueng teh, a thoung awh han.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hethateh, khoungroe dawk na poe hane naw doeh. Kathounge tuca kum touh e kahni touh na la vaiteh,
  </para>
  <para style="p">
    <verse number="39" style="v" />tuca buet touh e hah amom lah na poe vaiteh, alouke tuca buet touh e hah tangmin lah na poe han.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuca buet touh na poe e dawk e tavai ephah pung hra pung touh, satuium hin pung pali pung touh hoi na kalawt han ( hin teh galon buet touh doeh). Hahoi nei thueng hanelah misurtui hin pung pali pung touh na poe han.
  </para>
  <para style="p">
    <verse number="41" style="v" />Tuca buet touh e teh amom lah na poe vaiteh, hot teh amom vah ca hane poenae hoi nei hane poenae hmuitui, BAWIPA hanlah hmaisawi thuengnae lah na poe han.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hot teh na ca catounnaw totouh kamkhuengnae lukkareiim takhang koevah, BAWIPA hmalah hmaisawi thuengnae pou poe hane doeh. Hote hmuen koevah, nang koe lawk deinae lahoi na kâhmo han.
  </para>
  <para style="p">
    <verse number="43" style="v" />Isarel catounnaw hoi hawvah kâpato vaiteh, kamkhuengnae lukkareiim teh bawilennae hoi thoungsak lah ao han.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kamkhuengnae lukkareiim hoi khoungroe kathoung sak han. Aron hoi a canaw hoi kai hanelah vaihma thaw tawk laihoi ka thaw a tawk thai awh nahan ka thoung sak han.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hottelah Isarel catounnaw koevah, kho ka sak vaiteh, a cathut lah ka o han.
  </para>
  <para style="p">
    <verse number="46" style="v" />Izip ram hoi ka tâcawtkhaikung, kai teh ahnimae Cathut Jehovah lah ka o tie hah a panue awh han. Ahnimouh rahak vah kai Jehovah doeh ahnimae Cathut ka awm han.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi, hmuitui sawinae khoungroe anri thing hoi na sak han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ayung dong touh, adangka dong touh, a rasang dong touh hoi takin pali touh lah na sak vaiteh, a ki hateh khoungroe hoi a kâkuet han.
  </para>
  <para style="p">
    <verse number="3" style="v" />A lathueng lae hoi a tapang hoi a ki hah sui kathoung hoi na hluk awh vaiteh, petkâkalup lah sui hoi arai na pacawp han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Arai pacawpnae rahim vah suilaikaw kahni touh na sak han. Avangvanglah na ta vaiteh, hothateh kâkayawtnae acung hrawt nahane doeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Acung teh anri thing hoi na sak vaiteh, sui tui hoi na bu sin han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hothateh kai ni na pato nahane hmuen lawkpanuesaknae tanae thingkong ngue nahanelah yaphni hmalah hote khoungroe hah na hruek han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hottelah Aron ni hawvah, hmaisawi hane hmuitui hah a sawi han. Amom karawitawi hmaiim a rakueng navah a sawi han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aron ni tangmin lah hmaiim paangnae tueng dawkvah, hmuitui hah hmai a sawi han. Hothateh, na ca catounnaw totouh BAWIPA hmalah hmuitui lah ao han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hawvah hmuitui alouke thoseh, hmaisawi thuengnae thoseh, rawca thuengnae thoseh na poe mahoeh. Hawvah, nei hane na poe e hai na awi mahoeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aron ni kum touh dawk vai touh yonthanae sathei thi hah a la vaiteh, kinaw dawkvah yonthanae a sak han. Na ca catounnaw totouh kum touh dawk vai touh yonthanae a sak awh han, hot teh BAWIPA hanelah kathoungpounge doeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />BAWIPA ni Mosi koe,
  </para>
  <para style="p">
    <verse number="12" style="v" />Isarel catoun milu na touk toteh, milu na touk e yit touh tami pueng ni hringlu ratang nahanelah BAWIPA a poe awh han. Na touk toteh ahnimouh na touk dawkvah, ahnimouh koe lacik a pha hoeh nahanelah,
  </para>
  <para style="p">
    <verse number="13" style="v" />hetheh a poe awh hanelah ao. Touk tangcoung e naw pueng ni, hmuen kathoung koe hno khingnae a khing tangawn hah BAWIPA hanlah a poe awh han ( Khing touh teh gerah 20 touh doeh).
  </para>
  <para style="p">
    <verse number="14" style="v" />Touk tangcoung e kum 20 lathueng pueng ni, BAWIPA hanelah a poe awh han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na hringlu ratang nahanelah, BAWIPA hanelah na poe awh pawiteh, khing tangawn hlak kapap lah tami ka tawnta ni poe mahoeh. Hahoi ka mathoe ni hai hothlak kayoun lah poe mahoeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Isarel catounnaw yontha nahane tangka teh na la vaiteh, kamkhuengnae lukkareiim dawk thawtawknae lah na pouk han. Na hringlu yontha nahane BAWIPA hmalah Isarel catounnaw hanlah Pahnim hoeh nahanlah ao nahan, telah a dei.
  </para>
  <para style="p">
    <verse number="17" style="v" />BAWIPA ni Mosi koe,
  </para>
  <para style="p">
    <verse number="18" style="v" />kâpasu nahanlah rahum kawlung hoi pâhung nahanlah amkhoung na sak han. Lukkareiim hoi khoungroe rahak na ta han.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahnimouh teh kamkhuengnae lukkareiim thung a kâen awh nakunghai thoseh,
  </para>
  <para style="p">
    <verse number="20" style="v" />BAWIPA koe hmaisawi thuengnae thueng hanelah, khoungroe koe a hnai nah thoseh,
  </para>
  <para style="p">
    <verse number="21" style="v" />due hoeh nahanelah, amamae kut khok hah a pâsu awh han. Hottelah ahnimouh hoi ahnimae ca catounnaw ni tarawi hane kâlawk lah ao telah ati.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hothloilah BAWIPA ni Mosi koevah,
  </para>
  <para style="p">
    <verse number="23" style="v" />hmuituinaw thung dawk a hmui katuipounge murah sekel 500 touh hoi nakzik hmuitui khing 250,
  </para>
  <para style="p">
    <verse number="24" style="v" />nakzik phun louk khing 500, olive satui pong 12 touh (hin buet touh) na thokhai vaiteh,
  </para>
  <para style="p">
    <verse number="25" style="v" />hmuitui kasakkung ni a sak e patetlah hluk e satui hah kathounge satui lah na sak han.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kamkhuengnae lukkareiim, lawkpanuesaknae thingkong,
  </para>
  <para style="p">
    <verse number="27" style="v" />caboi hnopainaw, hmaiimkhok, hmuitui hmaisawinae khoungroe,
  </para>
  <para style="p">
    <verse number="28" style="v" />hmaisawi thuengnae khoungroe hoi hnopainaw, kawlung hoi pâhungnae amkhoung pueng hah hote hmuitui hoi koung na hluk han.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kathoung katang e lah ao awh nahan, na thoung sak vaiteh, hote hno ka tek e pueng teh a thoung awh han.
  </para>
  <para style="p">
    <verse number="30" style="v" />Haw hanelah, vaihma thaw tawk laihoi, ka thaw a tawk thai awh nahanelah, Aron hoi a capanaw hah satui na awi vaiteh, na thoung sak han.
  </para>
  <para style="p">
    <verse number="31" style="v" />Isarel catounnaw koe, hete satui heh na ca catounnaw koe totouh kaie hluk e satui kathoung lah ao han.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tami tak dawk na awi mahoeh. Hete sak e hoi saknae kâvan e alouke hai na sak mahoeh. Hethateh a thoung teh, nangmouh hanlah kathounge lah ao han.
  </para>
  <para style="p">
    <verse number="33" style="v" />Apipatethai het hoi kâvan lah a sak hai thoseh, ayâ alouk hanlah a hno hai thoseh, hote tami teh a miphun dawk hoi na takhoe han telah na dei han telah ati.
  </para>
  <para style="p">
    <verse number="34" style="v" />BAWIPA ni Mosi koe a hmui katuipounge hmuitui satacte hoi onycha hoi galbanum hah na la han. Hmuituipoung e ka pâcim e frankinsen hah suekâvan lah na khing vaiteh,
  </para>
  <para style="p">
    <verse number="35" style="v" />hmuitui kasakkungnaw patetlah palawi na phuen vaiteh, ka pâcim lah kathoungcalah na sak han.
  </para>
  <para style="p">
    <verse number="36" style="v" />A tangawn teh katipcalah phawm hane doeh. Kai ni na pato nahane lukkareiim thung e lawkpanuesaknae hmalah na ta han. Hothateh, nang hanelah kathounge lah ao han.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hote hmuitui na sak hane na pâtu e patetlah sak e teh, namamouh hanelah na sak mahoeh. BAWIPA hanelah kathounge lah na pouk awh han.
  </para>
  <para style="p">
    <verse number="38" style="v" />Tami bangpatet nihai, phunep rumram hanelah hot patet e sak pawiteh, hote tami teh a miphun thung hoi, takhoe lah ao han telah ati.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koevah,
  </para>
  <para style="p">
    <verse number="2" style="v" />Khenhaw! Judah miphun thung dawk hoi Hur capa Uri, hote capa Bezalel hah ka kaw toe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahni teh lungangnae, thoumthainae, panuenae hoi bangpueng dawk kutsakthoumnae hoi,
  </para>
  <para style="p">
    <verse number="4" style="v" />sak hane Lungkaangcalah poukthainae hoi,
  </para>
  <para style="p">
    <verse number="5" style="v" />talung phu kaawm ka ta teh, bawng thainae, kâpicalah thing a thainae hoi bangpueng dawk kutsakthoumnae a tawn hanlah Cathut Muitha hoi kakawi sak toe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khenhaw! ahni koe thaw tawk hanlah, Ahisamak e capa Oholiab teh kai ni yo ka pouk toe. Tawk hanelah kâ ka poe e naw,
  </para>
  <para style="p">
    <verse number="7" style="v" />tamimaya kamkhuengnae lukkareiim, lawkpanuesaknae thingkong, avan vah lungmanae tungkhung hoi lukkareiim dawk e hnopainaw pueng,
  </para>
  <para style="p">
    <verse number="8" style="v" />caboi hoi hnopai, kathounge sui hoi sak e hmaiimkhok hoi a hnopainaw pueng, hmuitui sawinae khoungroe,
  </para>
  <para style="p">
    <verse number="9" style="v" />hmaisawi thuengnae khoungroe hoi a hnopainaw pueng, hlaam,
  </para>
  <para style="p">
    <verse number="10" style="v" />khohna kahawicalah pathoupnae hoi vaihma thaw a tawk nah a khohna hanelah, vaihma Aron hanlah kathounge khohna,
  </para>
  <para style="p">
    <verse number="11" style="v" />Kâhluk e satui hoi hmuitui kathoung hanlah hmuitui sak thai nahanlah kutsakthoumnae, lungangnae pueng ka poe. Tawk hanlah kâ ka poe e naw pueng hah a sak awh han telah a dei.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hahoi BAWIPA ni Mosi koevah,
  </para>
  <para style="p">
    <verse number="13" style="v" />Isarelnaw koevah hettelah dei pouh, kaie sabbath hah na ya awh han, bangkongtetpawiteh na ca catounnaw totouh kai hoi nangmae rahak vah mitnoutnae lah ao. Kai teh nangmouh na kathoungsakkung Jehovah lah ka o tie hah na panuethai awh nahane doeh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hatdawkvah, sabbath heh na ya awh han. Bangkongtetpawiteh, hot teh nangmouh hanlah kathounge lah ao. Ka ek e pueng teh thei lah ao han. Hote hnin dawk Bangpatete thaw hai ka tawk e pueng teh a miphun koehoi takhoe lah ao han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnin taruk touh thung thaw tawk awh naseh. A sari hnin teh kâhatnae sabbath, BAWIPA hanlah hnin kathoung doeh. Apihai sabbath hnin vah thaw tawk pawiteh, thei lah ao roeroe han.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hatdawkvah, Isarelnaw ni sabbath teh a ca catoun totouh a yungyoe lawkkam lah awm seh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kai hoi Isarelnaw rahak vah, a yungyoe mitnoutnae doeh. Bangkongtetpawiteh, hnin taruk touh thung vah BAWIPA ni talai hoi kalvan a sak teh, asari hnin dawk a kâhat teh a thoung sak, na ti pouh han telah ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hottelah Sinai mon vah koung a kâpato hnukkhu, lawkpanuesaknae lungphen kahni touh, Cathut e kutdawn hoi thut e hah Mosi koe a poe.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi teh mon hoi kum laipalah ngailawi ao toe tie tamimaya ni a panue awh toteh, tamimaya teh Aron koe a kamkhueng awh teh ahni koe thaw haw, kai mouh han lah na kahrawikung cathut sak haw. Bangkongtetpawiteh, Izip ram hoi na katâcawtkhaikung Mosi e bang pawlawk hai thai hoeh toe, telah ati awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aron ni, na yunaw hoi na capanaw hoi na canunaw a pacap awh e suihnapacap hah rading awh nateh kai koe thokhai awh atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hottelah tami pueng ni suihnapacap a pacap awh lahun e hah a rading awh teh Aron koe a thokhai awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aron ni ahnimouh koe e a la teh, hreca hoi a thuk teh, maitoca meikaphawk lah a hlun. Hahoi ahnimouh ni Oe Isarelnaw, hetteh Izip ram hoi na katâcawtkhaikung nangmae cathut doeh, telah ati awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aron ni a hmu toteh, a hmalah khoungroe hah a sak. Aron ni, tangtho vah BAWIPA hanlah pawi awm naseh telah a oung sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hottelah a tangtho vah, amom a thaw awh. Hmaisawi thuengnae a poe awh, roum thuengnae hah a poe awh teh, tamimaya teh canei hanelah a tahung awh teh lamtu hanlah a thaw awh,
  </para>
  <para style="p">
    <verse number="7" style="v" />BAWIPA ni Mosi a pato teh, kum leih. Bangkongtetpawiteh, na taminaw Izip ram hoi na tâcokhai e naw hah amamouh hoi amamouh koung a kâraphoe awh toe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaie kâpoelawk hah tang a phen takhai awh toe. Maitoca meikaphawk a sak awh teh a bawk awh teh, hot koe thuengnae a sak awh teh, Oe Isarel hetheh Izip ram hoi na katâcawtkhaikung doeh ati awh telah ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />BAWIPA ni Mosi koe hete taminaw hah ka khet toe, a lung ka patak poung e miphun doeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hatdawkvah, ahnimouh hmai koung sawi hanelah, ahnimouh lathueng ka lungkhueknae heh kaman naseh, nang heh ka lentoe e miphun lah na sak han telah ati.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi ni, BAWIPA Cathut koe, BAWIPA bangkongmaw kalen e thaonae hoi thaonae kut hoi Izip ram hoi na tâcosak e na taminaw lathueng vah na lungkhueknae teh a kaman.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bangkongmaw Izipnaw ni monsom vah patawnae poe hane hoi, thei hanelah a tâcokhai awh, telah a dei awh han. Puenghoi na lungkhueknae hah roum sak nateh, na taminaw lathueng vah, hawihoehnae sak han na noe e heh kâhno lawih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na san Abraham hoi Isak hoi Isarel koevah kalvan e âsinaw yit touh na catounnaw ka pung sak vaiteh, ka dei tangcoung ram heh na catoun ka poe vaiteh, a yungyoe a coe awh han, telah amahoima noe lahoi lawk na kam tangcoung e hah pahnim hanh lah a telah a kâhei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hot patetlah BAWIPA teh, a taminaw lathueng vah thoenae ka sak han ati nakoehoi a kâhno.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi teh a kamlang teh monsom hoi a kum teh, a kut dawk lawkpanuesaknae lungphen kahni touh ao. Lungphen teh avoivang lah thut e doeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lungphen teh Cathut ni sak e lah ao teh, thut e naw teh Cathut ma roeroe ni lungphen dawk thut e doeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hahoi Joshua ni tamimaya pawlawk a thai toteh, Mosi koevah, roenae hmuen koe kâtuknae ao nahoehmaw telah ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hatei, ahni ni tânae pawlawk nahoeh, tâ e naw e hramki lawk hai nahoeh. Hateiteh, ka thai e heh la sak pawlawk doeh ati.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hahoi, roenae teng a pha tahma hoi maitoca meikaphawk hoi kalamtunaw hah a hmu. Hottelah Mosi lungkhueknae teh a kaman teh lungphen a sin e hah a tâkhawng teh mon khok koe a kâbawng.
  </para>
  <para style="p">
    <verse number="20" style="v" />A sak awh e maitoca hah a la teh, hmai a phum teh vitkatip lah a phom. Tui dawk a phuen teh Isarelnaw hah a nei sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosi ni Aron koevah, hettelah totouh yonnae kalen hah ahnimouh lathueng pha sak hanelah, hetnaw ni nang lathueng bangmaw a sak awh, telah atipouh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aron ni ka bawipa lungkhueknae heh kaman payon hanh naseh. Hete tamimayanaw heh hawihoehnae koe lah pou kangvawinaw doeh tie teh na panue toe.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bangkongtetpawiteh, kai koevah, kaimouh na ka hrawi hanelah cathut hah na sak pouh. Bangkongtetpawiteh, Mosi Izip ram hoi na kahrawikung heh a kamthang banghai thai e lah awm hoeh toe telah ati awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kai ni ahnimouh koe, sui katawnnaw ni rading awh naseh, ka ti pouh teh na poe awh. Hmai dawk ka phum toteh hete maitoca meikaphawk heh a tâco telah ati.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hahoi tamipueng khenyawn laipalah a ngai patetlah kho a sak awh tie hah a hmu teh, bangkongtetpawiteh, a tarannaw hmunae koe Aron ni khenyawn awh hoeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mosi teh roenae rim longkha koe a kangdue teh, BAWIPA koelah kampang e pueng kai koe tho awh naseh, telah ati. Hattoteh Levih capanaw pueng teh ahni koe a cei awh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahnimouh koe, BAWIPA Cathut ni, tami pueng ni na tahloi lat awh nateh, roenae hmuen koe kâennae longkha koehoi tâconae longkha koe totouh, na hmaunawngha thoseh, na huiko thoseh, na imri thoseh thet awh atipouh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hatdawkvah, Levih capanaw ni Mosi ni dei e patetlah a sak awh teh, hot hnin vah tami 3, 000 tabang a due awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hattoteh Mosi ni, sahnin yawhawinae na poe awh nahanelah, na mahmawk BAWIPA hanelah kâhmoun awh. Bangkongtetpawiteh, tami pueng ni a capa hoi a hmaunawngha hah a taran toe, telah ati.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hahoi, a tangtho vah Mosi ni tamimaya koevah, yonnae kalen na sak awh toe. Hatdawkvah, BAWIPA koe ka ceitakhang han. Na yonnae yontha thai han vaimoe, telah ati.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hottelah Mosi teh BAWIPA koe a ban teh, Oe hetnaw ni yonnae kalen a sak awh teh, sui cathut hah a sak awh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hatei nakunghai, a yonnae hah ngaithoum pouh haw. Hatei, na ngaithoum hoehpawiteh na cauk dawk na thut e ka min hah raphoe hanelah ka kâhei atipouh.
  </para>
  <para style="p">
    <verse number="33" style="v" />BAWIPA ni Mosi koevah, kai taranlahoi yonnae ka sak e pueng teh, ka cauk dawk hoi a min ka raphoe han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hatdawkvah cet nateh, ka dei e hmuen koe tamimaya hah cetkhaih. Khenhaw! kaie kalvantaminaw na hmalah a cei han. Hatei, rek hanelah ka hloe awh nah hnin vah, a yonnae dawk roeroe ka rek awh han telah ati.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hottelah Aron ni a sak e patetlah maitoca meikaphawk a sak awh dawkvah, BAWIPA ni tamimaya teh a rek.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hottelah BAWIPA ni Mosi hah a pato teh, hi hoi tâcawt awh nateh, Abraham, Isak hoi Jakop koevah, na catounnaw hanelah na poe han telah thoebo laihoi lawk ka kam e ram dawk, nang hoi Izip ram hoi na tâcokhai e naw hoi cet takhang awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmae hmalah kalvantami ka patoun vaiteh, Kanaan taminaw, Amor taminaw, Hit taminaw, Periznaw, Hivnaw hoi Jubusitnaw hah ka pâlei han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khoitui hoi maitosanutui a lawngnae ram dawk cet takhang awh. Bangkongtetpawiteh, kai teh nangmouh koe ka cet takhang van mahoeh. A lung ka patak poung e lah na o awh dawkvah, lamlak vah koung na pathup payon han doeh telah ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hottelah tamimaya ni hete kamthang kathout a thai awh toteh, a ka awh teh apihai kamthoup ngai awh hoeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bangkongtetpawiteh, BAWIPA ni Mosi koe Isarel catounnaw koe vah, a lung ka patak poung e miphun lah na o awh, nangmouh koe dongdeng ka o nakunghai, koung na pathup awh han. Hatdawkvah nangmouh koe ka sak hane ka panue thai nahanelah, na kamthoupnae pueng hah koung rading awh telah a dei toe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatdawkvah Isarelnaw ni a kamthoupnae hah Horeb mon vah a kârading awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi ni Lukkareiim hah a ceikhai teh, roenae lawilah betbet ahlanae koe ouk a yap. Hot hah kamkhuengnae lukkareiim ati awh. Hahoi BAWIPA tawng ka ngai e pueng teh, roenae lawilah kamkhuengnae lukkareiim dawkvah ouk a cei awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hahoi, Mosi teh lukkareiim pâtam hoi a cei lahun nah, tamimaya a thaw awh teh amamae rim takhang koe a kangdue awh teh, Mosi lukkareiim thung a kâen totouh a khet awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hahoi Mosi teh lukkareiim dawk a kâen tahma vah, tâmaikhom a kum teh lukkareiim takhang koe a kangdue teh BAWIPA ni Mosi hah a pato.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hahoi tamimaya ni lukkareiim takhang koe tâmaikhom a kangdue e hah a hmu awh. Hat toteh, tamimaya teh a thaw awh teh, amamae rim takhang koehoi lengkaleng a bawk awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tami ni a hui a pato e patetlah, BAWIPA ni Mosi hah minhmai kâhmo laihoi a pato teh, roenae hmuen koe lah a ban. A san Nun capa thoundoun Joshua hateh lukkareiim cettakhai boihoeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosi ni BAWIPA koevah, khenhaw! nang ni kai koevah hetnaw heh luenkhai loe ati. Hatei apimaw kai koe na patoun han tie teh na panuek sak hoeh rah. Hatei, nang ni na min lahoi na panue teh, ka mit dawk minhmai kahawi ka hmu, na ti pouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hatdawkvah, na mit dawk minhmai kahawi ka hmawt pawiteh, ka panue nahan hoi na mithmu vah pahrennae ka hmu thai nahanlah lamthung na panuek sak haw, telah ka kâhei. Hete miphun heh na tamimaya doeh tie hah pouk, telah ati.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahni ni, nangmouh koe ka o vaiteh, kâhatnae na poe awh han atipouh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahni ni, kai koevah na cet hoehpawiteh, hete hmuen koehoi na tâcawt sak hanh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bangkongtetpawiteh, kaimouh koe na cet laipalah kai hoi na taminaw teh na mithmu vah lungmanae ka hmu awh tie hah, bangtelamaw ka panue awh han. Hottelah talai van kaawm e taminaw pueng koehoi kai hoi na taminaw teh ka pek e lah ka o awh han, atipouh.
  </para>
  <para style="p">
    <verse number="17" style="v" />BAWIPA ni Mosi koevah, hot hai na dei e patetlah ka sak han. Bangkongtetpawiteh, ka mit dawk na kuep teh na min lahoi na panue telah atipouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahni ni na bawilennae teh pahren lahoi na hmawt sak haw atipouh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahni ni, ka hawinae pueng heh na hmalah ka kamnue sak vaiteh, Jehovah min hah na hmalah ka pâpho han. Pahren han ka ngai e hah ka pahren vaiteh, ka lungma han ka ngai e pueng hah ka lungma han, atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hatei ahni ni, ka minhmai teh na hmawt thai mahoeh, bangkongtetpawiteh na ka hmawt e tami hring boihoeh, ati.
  </para>
  <para style="p">
    <verse number="21" style="v" />BAWIPA ni khenhaw! ka teng vah hmuen buet touh ao, lungsong van na kangdue han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hahoi, ka bawilennae ni na ceihlawi navah, kâbawng e lungsong thungvah na ta han, na ceitakhai hoehroukrak ka kut hoi na tabuem han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hahoi ka kut hah bout ka la vaiteh ka hnukthun hah na hmu han, hatei, ka minhmai teh na hmawt mahoeh, atipouh.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koevah, lungphen kahni touh a hmaloe e patetlah sak nateh hote lungphen dawkvah ahmaloe e patetlah bout ka thut han.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tangtho vah coungkacoe lah awmh, amom Sinai mon dawk luen nateh, monsom ka hmalah kangdout.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang koe apihai tho awh hanh naseh. Mon vah apihai kamnuek awh nahanh seh. Tuhu hoi maitohu naw hai mon teng vah pâ awh nahanh seh ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hottelah lungphen kahni touh hmaloe e patetlah a sak. Hahoi Mosi teh amom vah a thaw teh BAWIPA ni kâ a poe e patetlah lungphen kahni touh hah a sin teh, Sinai mon dawk a luen.
  </para>
  <para style="p">
    <verse number="5" style="v" />BAWIPA teh tâmai hoi a kum teh, a teng vah a kangdue teh BAWIPA e min hah a pathang.
  </para>
  <para style="p">
    <verse number="6" style="v" />BAWIPA ni a ceihlawi teh Jehovah, Jehovah, lungmanae hoi kakawi e Cathut, pahrennae, lungsawnae lungmanae hoi lawkkatang hoi akawi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tami a thongsang koe pahrennae kamnueksakkung, payonnae hoi lawkeknae hoi, hawihoehnae kangaithoumkung, yonpennae ka tâcawtkhai boihoeh e, napanaw payonnae dawk canaw catoun totouh, se thum se pali totouh karekkung doeh telah a pâpho.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi ni karanglah talai dawk a tabo teh a bawk.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahni ni, Atuvah BAWIPA na mit dawk minhmai kahawi ka hmawt pawiteh, kai koevah kaie BAWIPA heh cet van naseh telah ka kâhei. A lung ka patak e miphun lah ka o awh nakunghai ka payonnae hoi ka yonnae hah na ngaithoum nateh, na râw lah na tawn lawih telah ati.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahni ni, khenhaw! lawkkamnae ka sak. Talai pueng hoi miphun pueng dawk sak boihoeh e kângairu hno hah na taminaw pueng hmalah ka sak vaiteh, nangmouh kaawm e na taminaw pueng ni BAWIPA ni sak e hah a hmu awh han. Bangkongtetpawiteh, nangmouh koe ka sak hane heh takikathopounge lah ao han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sahnin vah kâ na poe e naw heh pouk. Khenhaw! Amornaw, Kanaannaw, Hitnaw, Hivnaw, Periznaw hoi Jebusitnaw hah na hmalah hoi ka pâlei han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kâhruetcuet, hoehpawiteh na cei nahane ram dawk kaawmnaw hoi lawkkamnae na sak awh vaiteh, nangmouh hanlah karap lah awm payon vaih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hateiteh ahnimae khoungroe hah, koung na raphoe pouh han. Talung a ung awh e hai rekrek dei awh nateh, thing meikaphawk hah koung tâtueng pouh awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A min patenghai dipma Jehovah lah ao, Cathut teh a dipma thai dawkvah Cathut alouke roeroe na bawk awh mahoeh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hoehpawiteh hote ram dawk e taminaw hoi lawk na kam awh vaiteh, ahnimae cathut koe kâyo laihoi ahnimae cathut koe thueng laihoi buetbuet touh coun vaiteh, thuengnae moi hah ca hoi,
  </para>
  <para style="p">
    <verse number="16" style="v" />na capanaw hanelah ahnimae canunaw hah na paluen vaiteh, a canunaw ni a cathutnaw koe a kâyo awhnae koe, na capanaw hai kâyawt payon awh langvaih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thuk e meikaphawk cathut hah na sak awh mahoeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tonphuenhoehe vaiyei pawi na sak han. Kâ na poe awh e patetlah, hnin sari touh thung tonphuenhoehe hah Abib thapa dawk khoe e tueng nah na ca han. Bangkongtetpawiteh, Abib thapa dawkvah Izip ram hoi na tâco awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Camoim ka paawng e pueng kaie doeh. Na saring pueng maito hoi tu camin teh kaie doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hatei la camin teh tuca hoi na ratang han. Na ratang ngaihoeh pawiteh, a lahuen na kapai pouh han. Na capa camin teh na ratang han. Ka hmaitung vah apihai kuthrawng hoi na tâcawt awh mahoeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hnin taruk touh thung thaw na tawk han. Asari hnin dawk na kâhat han. Laikawk na tawk tue nah hoi canga tue nahai na kâhat han.
  </para>
  <para style="p">
    <verse number="22" style="v" />Yat pawi, takhawk pawi, cavanca pawi na to han.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tongpa pueng kum touh dawk vai thum touh Bawipa Jehovah Isarel Cathut hmalah a tâco awh han.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bangkongtetpawiteh, na hmalah miphunnaw ka pâlei vaiteh na ramri hah ka kaw sak han, kum touh dawk vai thum touh BAWIPA na Cathut hmalah na tâco awh nahanlah na cei toteh apinihai na ram hah noe awh mahoeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kai hanelah thuengnae thipaling teh ton phuen e vaiyei hoi na poe mahoeh. Ceitakhai pawi thuengnae haiyah atangtho totouh na awm sak mahoeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na law dawk e aluepaw teh BAWIPA im dawk na thokhai han. Hmaeca e moi hah a manu e sanutui hoi mek na thawng mahoeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />BAWIPA ni Mosi koe, hete lawknaw heh thun haw, bangkongtetpawiteh, hete lawknaw tarawi lahoi nang koehoi Isarel koevah lawkkamnae ka sak, telah ati.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hawvah BAWIPA koe hnin 40 rum 40 touh ao teh, rawca cat laipalah ao teh, tui hai net hoeh. Hahoi lungphen dawk lawkkam kâpoelawknaw hra touh a thut.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hahoi, Mosi teh lawkpanuesaknae lungphen kahni touh hah a kut hoi a sin teh Sinai mon hoi a kum navah, Mosi ni hottelah a kâpato dawkvah, ka minhmai vuen a ang tie hah panuek hoeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aron hoi Isarelnaw pueng ni Mosi a hmu awh toteh, khenhaw! minhmai vuen a ang teh hnai ngam awh hoeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosi ni ahnimouh teh a kaw teh, Aron hoi kamkhueng e lawkcengkungnaw pueng hah ahni koe a ban awh teh Mosi ni ahnimouh teh a pato.
  </para>
  <para style="p">
    <verse number="32" style="v" />Isarelnaw pueng ni a hnai awh hnukkhu Sinai mon vah BAWIPA hoi lawk a kâpato roi e naw pueng patetlah ahnimanaw hah kâ a poe.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosi ni lawk be a dei toteh, a minhmai teh minhmai ramuknae hoi a ramuk.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hatei ahni hoi lawk kâpato hanelah BAWIPA hmalah Mosi a luen nah tangkuem vah, bout a pato hoehroukrak a minhmai ramuknae hah ouk a hawng. Hahoi a pato teh kâ a poe e naw hah Isarelnaw koe ouk a dei pouh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Isarelnaw ni Mosi minhmai a khet awh nah tangkuem vah, Mosi minhmai vuen teh a ang. Hahoi Mosi teh Cathut hoi kâpato hanelah a kâen hoehroukrak a minhmai ramuknae hoi a minhmai teh ouk a ramuk.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi ni Isarelnaw koung a kamkhueng sak teh ahnimouh koe, BAWIPA ni tarawi hanelah kâlawk na poe e naw teh hetnaw hah doeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hnin taruk touh thung thaw na tawk awh toe. Asari hnin teh nangmouh hanelah hnin kathoung doeh. BAWIPA hanelah kâhatnae sabbath hnin doeh. Hot hnin vah thaw ka tawk e tami pueng teh na thei awh han.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sabbath hnin vah kho na sak awhnae koe hmai na patawi awh mahoeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hahoi Mosi ni Isarel kamkhuengnaw pueng koevah, hetheh BAWIPA ni na poe e kâlawknaw doeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />BAWIPA koe pasoumhno sin awh. A lungthung hoi poe han ka ngai e pueng ni BAWIPA hanelah thokhai seh. Sui, Ngun, Rahum,
  </para>
  <para style="p">
    <verse number="6" style="v" />kamthim hni, paling hni, âthi hni, loukloukkaang hni, hmaemuen,
  </para>
  <para style="p">
    <verse number="7" style="v" />paling bu e tu pho, saram pho, anri thing,
  </para>
  <para style="p">
    <verse number="8" style="v" />hmaiim hane satui hoi awi hane satui hoi hmaisawi hane hmuitui hoi,
  </para>
  <para style="p">
    <verse number="9" style="v" />ephod hoi saiphei nahanelah onyx talung hoi talungnaw sin hanelah poe awh naseh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmouh thung dawk kutsak ka thoum e pueng tho awh naseh. BAWIPA ni sak hanelah kâ a poe e hah sak awh naseh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lukkareiim hoi lukkarei, lemphu, pangkhek, thingphek, tapang, khom hoi ung nahane pacawpnae naw hai thoseh,
  </para>
  <para style="p">
    <verse number="12" style="v" />thingkong hoi kâkayawtnae acung, lungmanae tungkhung, hoi rakhan nahane yaphni hai thoseh,
  </para>
  <para style="p">
    <verse number="13" style="v" />caboi hoi kâkayawtnae acung hoi hnopainaw pueng hoi vaiyei tanae hai thoseh,
  </para>
  <para style="p">
    <verse number="14" style="v" />hmaiang hanlah hmaiimkhok hoi hnopainaw hoi hmaiim hoi paang hane satui hai thoseh,
  </para>
  <para style="p">
    <verse number="15" style="v" />hmuitui hmaisawinae khoungroe hoi kâkayawtnae acung hoi hluk e satui hoi hmaisawi hane hmuitui hoi lukkareiim takhang koe e yap hane yaphninaw hai thoseh,
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmaisawi thuengnae khoungroe rahum cuekkarue hoi kâkayawtnae acung hoi hnopainaw pueng, kawlung hoi pâhungnae hai thoseh,
  </para>
  <para style="p">
    <verse number="17" style="v" />Lukkareiim thongma yaphni, khom hoi a tapang ungnae pacawpnae naw hoi kalupnae longkha yaphninaw hai thoseh,
  </para>
  <para style="p">
    <verse number="18" style="v" />Lukkarei hetnae hoi thongma hetnae hoi ruinaw hai thoseh,
  </para>
  <para style="p">
    <verse number="19" style="v" />hmuen kathoung thaw tawknae koe, a meikahawicalah kawng e hnicu hoi vaihma thaw a tawk toteh kâkhu hane vaihma Aron hnicu kathoung hoi a capanaw hnicu hai thoseh BAWIPA ni lawk na thui e patetlah na sak awh han telah patuen a dei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hottelah Isarel catoun kamkhuengnaw pueng teh, Mosi koehoi a ban awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lungthonae katawnnaw hoi muitha lahoi pasoungnae ka tawn e pueng a tho awh teh, kamkhuengnae lukkareiim hanelah hno hane hoi thaw tawk nahanelah a panki e pueng, kathounge hnicu hanelah BAWIPA hanelah lengkaleng a poe awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Napui hoi tongpa hoi poe ngainae lung ka tawn e pueng a tho awh teh, laikaw, hnâpacap, kuthrawt, hnawngpacap, sui hoi sak e hnopai pueng hah a sin awh. Sui poe hane ka tawn e pueng ni BAWIPA hanelah a poe awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tami pueng ni, kamthim hni, âthi hni, paling hni, loukloukkaang hni, hmaemuen hoi tutan pho paling bu e hoi saram pho ka tawn e pueng ni a thokhai awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hahoi tangka hoi rahum ka thokhai e tami pueng ni, BAWIPA hanelah poe hane hah a thokhai awh. Tami pueng ni anri thing, hnopai hanelah hno kamcu e hah a thokhai awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kutsakkathoume napui pueng ni, pahla a san awh teh, a pakhit awh e pahla, kamthim, âthi hni, paling hni, Loukloukkaang e hah a thokhai awh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kutsakkathoume napui a lung a kathonaw ni hmaemuen hah a kawng awh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vaihma angki hoi angki akalae patawp hanelah ukkungnaw ni onyx talung hoi talung phu kaawmnaw hah a thokhai awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hmuitui hoi satui hoi, paang hane hoi hluk hane satui hoi hmuitui hmaisawi hane thoseh,
  </para>
  <para style="p">
    <verse number="29" style="v" />Isarel catounnaw ni BAWIPA hanelah ngainae hoi poe e hno hah a poe awh teh, napui hoi tongpa lungthonae ka tawn e pueng ni sak hanelah BAWIPA ni Mosi koe kâ a poe e patetlah tawk nahanelah hnopainaw thoseh a poe awh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mosi ni Isarel catounnaw koevah, Khenhaw! BAWIPA ni Judah miphun thung hoi Hur capa Uri, a capa Bezalel hah
  </para>
  <para style="p">
    <verse number="31" style="v" />lungangnae hoi thaipanueknae, panuenae hoi bangpueng koe kutsak thoumnae tawn hanelah Cathut Muitha hoi akawi sak toe.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sak hane lungangcalah poukthainae, sui, ngun, rahum dêi thainae,
  </para>
  <para style="p">
    <verse number="33" style="v" />talung phu kaawm pâthit hanelah bawng thainae, meikahawicalah thing a thainae, bangpueng dawk kutsak thoumnae tawn hanelah a kaw toe.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hahoi ama hoi Dan miphun thung e Ahisamak capa Oholiab hoi ayâ cangkhai thainae hah a lungthung vah a ta pouh toe.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahni teh bangpueng dawk kutsak thoumnae, ca thut thainae, mei thuk thainae, imthung pathoup thainae, kamthim, paling, âthi, Loukloukkaangnaw carouk thainae, hnikawngthainae, phunkuep tawk thainae, hoi tawk hane kahawicalah poukthainae tawn hanelah lungangnae hoi akawi sak toe.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bezalel hoi Oholiab tinaw ni kutsakkathoumnaw pueng BAWIPA ni kâ a poe e patetlah, hmuen kathoung dawk thaw a tawk thai awh nahanelah, thaw phunkuep a tawk thai awh nahanelah lungangnae hoi thaipanueknae a poe e naw pueng ni lengkaleng tawk hane doeh, telah ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosi ni Bezalel hoi Oholiab tinaw kutsakkathoume, BAWIPA ni ahnimae lungthin dawk lungangnae a poe teh a thaw tawk hanelah a lungthin dawk lungthonae a poe e naw pueng hah a kaw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Isarel catounnaw ni hmuen kathoung thawtawknae koe a tâcokhai awh e pueng hah Mosi koehoi a coe awh. Hahoi amom tangkuem ngainae lahoi poe e hah ahni koe pou a poe awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kutsakkathoumnaw pueng, hmuen kathoung thaw katawknaw pueng ni thaw a tawk awh lahun e hah lengkaleng a ceitakhai awh teh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi koevah, BAWIPA ni tawk han kâ a poe e thaw tawk hanelah taminaw ni acawilah hno a sin awh, telah a pathang awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi ni kâ a poe teh, hmuen kathoung hanelah poehno hah napui hai tongpa hai apihai poe hanelah kâcai awh nahanh lawiseh, telah roenae hmuen koe a oung sak. Hottelah taminaw ni a poe awh e hah pasoung hoeh toe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bangkongtetpawiteh, a tawn awh tangcoung e hah panki e pueng sak nahanelah a khout toe. Atangcalah apap poung toe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahnimouh thung dawk a lungkaangnaw pueng ni, lukkareiim teh yaphni hra touh hoi a sak awh. Hote yaphni teh Loukloukkaang e hoi carouk e kamthim, paling, âthi naw hoi kathoumnaw ni cherubim mei a sak awh e hah kamnuek lah sak e lah ao.
  </para>
  <para style="p">
    <verse number="9" style="v" />Yaphni teh dong 28 touh lengkaleng a saw teh, akaw e teh dong pali touh rip a pha. Yaphni pueng ayung adangka koung a kâvan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yaphni panga touh a kâbet teh, alouke panga touh hai koung a kâbet.
  </para>
  <para style="p">
    <verse number="11" style="v" />Patawp e yaphni rui a poutnae koe vah, laikaw kamthim lah sak e lah ao. Hot patetlah patawp e yaphni avanglae a poutnae koe haiyah sak e lah ao.
  </para>
  <para style="p">
    <verse number="12" style="v" />Yaphni buet touh dawk laikaw 50 touh a sak teh alouke patawp e dawk haiyah, laikaw 50 touh a sak. Hote laikawnaw teh minhmai kâhmo lah ao awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hahoi sui hetnae 50 touh a sak teh, hetnae naw ni yaphni hah a hetsin. Hottelah lukkareiim teh rakhan buet touh lah a coung.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hahoi lukkareiim lemphu ramuknae lah, Hmae muen yaphni hah hlaibun touh a sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Yaphni teh dong 30 touh saw sak lah ao teh, akaw e teh dong pali touh lengkaleng a pha. Yaphni hlaibun touh teh koung a kâvan.
  </para>
  <para style="p">
    <verse number="16" style="v" />Yaphni panga touh hah patawp e lah ao teh, yaphni taruk touh hai patawp e lah ao.
  </para>
  <para style="p">
    <verse number="17" style="v" />Patawp e yaphni buet touh a rai poutnae koe vah laikaw 50 touh a sak teh, yaphni patawp e avanglae arai dawk hai laikaw 50 touh a sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lukkareiim hah rakhan buet touh lah ao nahanelah, hetsin nahanelah hetsinnae 50 touh hah rahum hoi a sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hahoi tutan pho paling bu e hoi lukkareiim lemphu ramuknae hoi hot van ramuk nahanelah saram pho hoi a sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lukkareiim tapang thung hanelah anri thing hoi a sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thingphek teh dong hra touh asaw teh, dong touh hoi tangawn akaw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thingphek tangkuem dawk a khok kahni touh hoi a kâkuetsak. Hottelah lukkareiim tapang pueng teh a sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lukkareiim hanelah tapang thingphek hah a sak teh, akalae tapang hanelah thingphek 20 touh a sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hote thingphek 20 touh a kangdue nahanelah ngun pacawp 40 touh a sak. Thingphek buet touh dawk a khok kahni touh pâhung nahanelah pacawp kahni touh rip a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lukkareiim atunglae hanlah thingphek 20 touh hoi
  </para>
  <para style="p">
    <verse number="26" style="v" />ngun pacawp 40, thingphek buet touh hanelah pacawp kahni touh rip a sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lukkareiim kanîloumlah hane thingphek 6 touh a sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lukkareiim hnuk lae takin koe hanelah thingphek kahni touh hai a sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />A rahim hoi a lathueng lae laikaw totouh a kâkuetsak. A takin roi koe hot patetlah a sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thingphek taroe touh, pâhung nahane ngun pacawp 16 touh hoi ao. Thingphek buet touh pâhung nahanelah pacawp kahni touh rip ao.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hahoi lukkareiim tapang pangkhek hanelah anri thing panga touh,
  </para>
  <para style="p">
    <verse number="32" style="v" />lukkareiim avanglah hane panga touh a sak.
  </para>
  <para style="p">
    <verse number="33" style="v" />A lungui e tarennae hah avoivang lae takin koe rek a pâcue sak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thingpheknaw hah sui hoi a hluk. Tarennae hrawt nahanelah sui laikaw hai a sak teh, tarennae naw hah sui hoi a hluk.
  </para>
  <para style="p">
    <verse number="35" style="v" />Yaphni hanelah kamthim, âthi, paling, loukloukkaang e hni hoi cherubim meikahawicalah a sak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hot hanelah anri thing khom pali touh a sak teh sui tui hoi a hluk. Hahoi a bangnae naw teh sui hoi sak e doeh. Hotnaw pâhung nahanelah ngun pacawp pali touh a hlun.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hahoi lukkareiim takhang koe yap hanelah, kamthim, âthi, paling, Loukloukkaang e hoi carouk e kathoumnaw ni kahawicalah carouk e hoi a sak.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hotnaw yap nahanelah khom panga touh, bang nahane naw hoi a sak. Hote khom a som kacoumnaw hoi yapnae khomnaw teh, sui tui hoi hluk e lah ao. Hotnaw pâhung nahanelah pacawp e panga touh hateh rahum hoi sak e doeh.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bezalel ni anri thing e thingkong hah ayung dong hni tangawn, adangka dong touh hoi tangawn, arasang dong touh hoi tangawn hoi a sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thung hoi alawilah sui tui kathoung hoi hluk e lah ao teh, sui hoi a rai yep e lah ao.
  </para>
  <para style="p">
    <verse number="3" style="v" />A khok pali touh pâhung nahanelah, sui laikaw pali touh a hlun. Laikaw kahni touh e teh avanglah hane a tho teh, alouke kahni touh e teh avanglah hane a tho.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hahoi anri thing hoi kâkayawtnae acung hah a sak teh, sui tui hoi a hluk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thingkong hah kâkayawt thai nahanelah a tapang dawk e laikaw dawk a hrawt.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sui kathoung hoi lungmanae tungkhung hah a sak teh, ayung dong hni touh hoi tangawn, adangka dong touh hoi tangawn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hahoi cherubim kahni touh hah sui hoi a sak. Lungmanae tungkhung som dawk e roi teh dei lah a dei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Avang lae apoutnae koe cherubim buet touh, avanglae apoutnae koe cherubim buet touh, lungmanae tungkhung hoi kâbet sak hanelah avoivang lah apoutnae koe vah cherubim hah a ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cherubim hah minhmai kâhmo lah, lungmanae tungkhung hah a rathei a kadai teh a khu teh, lungmanae tungkhung koe lah a kangvawi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hahoi anri thing hoi caboi hah a sak teh, ayung dong hni touh, adangka dong touh, arasang dong touh hoi tangawn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hot teh suitui kathoung hoi hluk lah ao teh sui hoi a tâphai hah a pacawp.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kuttabei hlawk touh a tâphai a sak teh, sui hoi a pacawp.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hot hanelah sui laikaw pali touh a hlun teh, hote laikaw pali touh hah caboi khok pali touh dawk a bet.
  </para>
  <para style="p">
    <verse number="14" style="v" />Caboi teh kâkayawt thai nahanelah laikaw teh a tâphai teng vah a bang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Caboi teh kâkayawt thai nahanelah acung hah anri thing hoi a sak teh sui tui hoi a hluk.
  </para>
  <para style="p">
    <verse number="16" style="v" />Caboi van vah hno hane tongben, pacen, awi nahane manangkhom hah sui kathoung hoi a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hahoi hmaiimkhok teh suikathoung hoi a sak. Hmaiimkhok teh dêi lah a dêi. A kutnaw, manangnaw, a peinaw teh koung kâkuen lah a dêi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmaiimkhok avoivang lah a kang kathum touh reira a tâco teh, a kut taruk touh ao.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmaiimkhok dawk hoi e a kang kathum touh dawk e a kang buet buet touh dawkvah, a peimuem, hoi almond paw hoi mei kâvan e manang kathum touh ao.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmaiimkhok dawkvah a peimuem hoi almond paw hoi mei kâvan e manang pali touh ao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hmaiimkhok dawk a kut taruk touh ao e patetlah avoivang lae a kut kahni touh e rahim vah a peimuem buetbuet touh rip ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />A peimuem hoi a kutnaw hah buet touh lah koung a kâkuetsak teh abuemlahoi suikathoung hoi dei e doeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmaiim sari touh hoi, paitei, paitei tanae naw pueng hai suikathoung hoi a sak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmaiim hoi hmaiim hnopai pueng hah suikathoung talen buet touh hoi a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hahoi hmuitui sawi nahanelah anri thing hoi khoungroe hah a sak. Ayung dong touh, adangka dong touh. Takin pali touh ao. Arasang dong hni touh. A kinaw hoi koung a kâkuet.
  </para>
  <para style="p">
    <verse number="26" style="v" />A lathueng lae a tapang hoi a kinaw teh, suikathoung tui hoi hluk lah ao teh suikathoung hoi a tâphai hah a pacawp.
  </para>
  <para style="p">
    <verse number="27" style="v" />A tâphai a rahim lae a rai reira dawk sui laikaw kahni touh a sak teh, a hmo a voivang lah kahni reira koe sak lah ao. Hot hah teh kâkayawtnae acung hrawt nahane doeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hahoi anri thing hoi kâkayawtnae a sak teh suitui hoi hluk e lah ao.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hahoi kathounge satui hluk e, kathounge hmuitui sawi hanelah hmuitui ka sak thai e patetlah a sak.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi anri thing hoi hmaisawi thuengnae khoungroe hah a sak. Ayung dong panga touh, adangka dong panga touh, takin pali touh ao. Arasang dong thum touh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Takin pali touh som vah kinaw hah a sak. Hote kinaw teh khoungroe hoi koung a kâkuet teh, rahum tui hoi hluk e lah ao.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khoungroe hanelah hno e hnopainaw pueng, hlaam, ampaikei, kawlung, cingco, hmaisaan lanae hah a sak. Hote hnonaw pueng teh rahum hoi sak e seng doeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hahoi khoungroe hanelah rahum cuekkarue hah a sak teh khoungroe keng koe rahim vah a ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kâkayawtnae acung hrawtnae cuekkarue takin pali touh koe bang hanelah rahum laikaw pali touh a hlun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kâkayawtnae acung hah anri thing hoi a sak teh, rahum tui hoi a hluk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kâkayawt nahane khoungroe rai e laikaw dawkvah, acung hah a hrawt. Khoungroe teh a lûlahei pou a aw thai nahanlah thingphek hoi a sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hahoi rahum kawlung hoi pâhungnae a khok hah kamkhuengnae lukkareiim takhang koe thaw ka tawk awh e napuinaw e hlalang hoi a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hahoi lukkareiim thongma hah a sak teh, akalae yaphni teh loukloukkaang e hoi dong 100 touh hoi a sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hote yaphni hanelah khom 20 touh, rahum khomkhok pacawp 20 touh a sak teh, khom hetnae, pangkheknaw teh ngun hoi a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Atunglae yaphni teh dong 100 touh a pha. Khom 20 touh, rahum khomkhok pacawp 20 touh a sak teh, khom hetnae, pangkheknaw teh ngun hoi a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kanîloumlae yaphni teh dong 50 touh a pha. Khom hra touh, pacawpnae hra touh. Khom hetnae, pangkheknaw teh ngun hoi a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kanîtholae yaphni teh dong 50 touh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Longkha avoivang lae yaphni teh dong hlaipanga touh a pha.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khom kathum touh, pacawpnae kathum touh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kalupnae yaphni pueng teh loukloukkaang e hoi sak e seng doeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hahoi khom pacawpnae, hetnae, pangkheknaw teh rahum hoi sak e doeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hahoi kalupnae longkha koe e yaphni teh, kamthim, âthi, paling, loukloukkaang e hoi carouk e ayung dong 20, rasang dong panga touh a pha. Kalupnae yaphni hoi rei a kâvan.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kalupnae takhang khom teh pali touh, rahum khok pacawpnae pali touh, hetnae ngun, pangkhek ngun, ngun hoi sak e khom ramuknae naw ao.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hahoi Lukkareiim petkâkalup lah hetnae pueng teh rahum hoi sak e lah ao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hetheh lukkareiim hnopai, lawkpanuesaknae lukkareiim hanelah hno e, Mosi ni kâpoe e patetlah Aron capa Ithamar hoi Levih miphunnaw ni a touk awh e doeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Judah miphun thung e Hur capa Uri, ahnie capa Bezalel ni BAWIPA ni Mosi koevah sak hanelah kâ a poe e naw pueng teh, koung a sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahni koe Dan miphun Ahisamak capa Oholiab ca thut kathoum, kutsak kathoum, kamthim, âthi, paling, loukloukkaang meikahawicalah ka carouk thai e ni hai a tawk.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmuen kathoung a pankinae pueng koe hno hane suinaw pueng, a poe awh e teh hmuen kathoung thung khingnae patetlah pong 2, 195 touh a pha.
  </para>
  <para style="p">
    <verse number="25" style="v" />Touk tangcoung e tamimaya koe kabawknaw ni a poe awh e ngun hmuen kathoung koe khingnae patetlah pong 7, 550 touh a pha.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kum 20 lathueng touk tangcoung e tamimaya koe kacetnaw teh 603, 550 touh a pha teh, hmuen kathoung koe khingnae patetlah a poe awh e teh khing tangawn lengkaleng a pha.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hahoi ngun thung hoi pong 7, 500 touh teh hmuen kathoung khomnaw pacawp hane hoi ung nahanelah a hno awh. Pacawpnae hah 100 touh a pha teh, pacawpnae buet touh ramuk nahanelah hno e teh pong 75 touh a pha.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka cawi e ngun pong 50 touh hoi khom dawk bangnae hah a sak teh, khom ramuknae teh ngun tui hoi hluk e lah ao. Hahoi yapnae pangkhek hah a sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />A poe awh e rahum talen 70 touh hoi shekel 2,400 touh a pha.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hot teh kamkhuengnae takhang khom pâhungnae khom pacawp hoi rahum khoungroe hoi rahum cuekkarue hoi,
  </para>
  <para style="p">
    <verse number="31" style="v" />lukkareiim kamkhuengnae thongma petkâkalup lah khom pâhungnae khom pacawp hoi lukkareiim hetnae pueng lah koung a hno awh.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi kamthim, âthi, paling naw hoi hmuen kathoung thaw tawk nahanelah a meikahawicalah khohna hah a sak teh, BAWIPA ni Mosi koe kâ a poe e patetlah Aron hanelah kathounge khohna hah a sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sui, kamthim, âthi, paling loukloukkaang e hoi carouk e vaihma angki hah a sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sui hah ka rapamcalah a dêi teh ayung lahoi a bawng teh, kamthim, âthi, paling, loukloukkaang e kutsakkathoume ni a carouk teh a sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kâyeng e 20 touh lah a sak teh, angki a lathueng lae a rai roi a kâkuet nahanelah rui hoi a sui sin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angki van kâyeng hane taisawm meikahawicalah kawng e hah angki hoi kâvan e lah ao teh, BAWIPA ni Mosi koe kâ a poe e patetlah sui hoi kamthim, âthi, paling, loukloukkaang e carouk e hoi kawng e doeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Karnelian talung kahni touh a kata awh teh, sui tabu thung a bet awh. Kuthrawt dawk min thuk e patetlah Isarel miphunnaw e minnaw hah a thut.
  </para>
  <para style="p">
    <verse number="7" style="v" />BAWIPA ni Mosi koe lawk a thui e patetlah Isarel miphunnaw pahnim hoeh nahanelah, hote talung kahni touh hah vaihma angki kâyengnae dawk a bet awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Saiphei hah vaihma angki sak e patetlah sui, kamthim, âthi, paling, loukloukkaang e carouk e hoi a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bawkhni touh lah thep e lah ao teh, takin pali touh lah a o, ayung khap touh, adangka khap touh, takin pali touh hoi rei a kâvan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Saiphei dawk talung 40 touh lah a pâthit. Apasueke rui dawk Sardius, topaz, emerald doeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Apâhni e rui dawk emerald, sapphire hoi diamon doeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Apâthum e rui dawk Jacinth, agate hoi amethyst doeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Apali e rui dawk beril, onyx, hoi jasper doeh. Hotnaw teh sui tabu dawk a pâthit awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Isarelnaw miphun hlaikahni touh e hah noutnae min thut e patetlah, hote talungnaw dawkvah, hote hlaikahni touh e minnaw hah a thut teh, talung buet touh dawk min buet buet touh rip ao.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hahoi saiphei van vah, tangron patetlae dingyin sui kathoung hoi a sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sui pahla vei e kahni touh hoi sui laikaw kahni touh a sak teh, saiphei dawk laikaw kahni touh hah a bang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hahoi suibawtarui vei e kahni touh hah saiphei a tâphai lae rui dawk e laikaw dawkvah a sui.
  </para>
  <para style="p">
    <verse number="18" style="v" />A meikahawicalah vei e dingyin kahni touh avanglae asomnaw teh, sui pahla vei e kahni touh dawkvah, a patawp awh teh, vaihma angki a hma lae kâyengnae dawk a sui.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sui laikaw kahni touh a sak teh, ephod rahim lah kaawm e saiphei rahim lae taki kahni touh dawk a bang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Alouke sui laikaw kahni touh hai a sak teh, vaihma angki a hma lae rahimca hoi kâyengnae lathueng patawpnae koe angki hah avangvanglah a bet.
  </para>
  <para style="p">
    <verse number="21" style="v" />Saiphei sui laikaw kahni touh hah vaihma angki, sui laikaw kahni touh hoi mek sui teh, kamthim e pahlarui hoi a sak. Hottelah BAWIPA ni Mosi koe lawk a thui e patetlah saiphei teh kâyengnae dawkvah bang lah ao teh, vaihma angki hoi reirei pou ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hahoi vaihma angkidung teh kamthim hoi dueng kawng e hoi a sak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Angkidung lungui vah angki kutkaduem patetlah a aw sak. Ka aw e teh a kâphi hoeh nahanelah, a rai hah pou a yep.
  </para>
  <para style="p">
    <verse number="24" style="v" />Angkidung dawkvah, tale paw mei hah kamthim, âthi, paling, loukloukkaang e carouk e hoi a sak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hahoi sui kathoung hoi dinghlingnaw hah a sak teh, angki pawi dawk e talepaw rahak vah cakhout laihoi a bang.
  </para>
  <para style="p">
    <verse number="26" style="v" />BAWIPA ni Mosi kâ a poe e patetlah dinghling buet touh hoi tale paw buet touh rip hah angki pawi petkâkalup lah thaw tawk nahanelah kamthoupnae dawk a ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hahoi Aron hoi a capanaw hanelah loukloukkaang e hoi kawng e hah a sak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Loukloukkaang e hoi sak e vaihma lupawk hoi luhuem, loukloukkaang e hoi sak e hnadung hoi,
  </para>
  <para style="p">
    <verse number="29" style="v" />loukloukkaang e carouk e hoi kamthim, âthi, paling hoi meikahawicalah em la e hoi kathoumnaw ni em la e taisawm hoi BAWIPA ni Mosi koe kâ a poe e patetlah a sak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hahoi bawilakhung hanelah sui phen hah sui kathoung hoi a sak, BAWIPA KOE THOUNGNAE telah thut e hah a kamnue sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hahoi BAWIPA ni Mosi koe kâ a poe e patetlah vaihma lupawk a patunglah bet hanelah kamthim e rui hoi a sui.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hottelah kamkhuengnae lukkareiim, thaw pueng teh cum lah ao. BAWIPA ni Mosi koe sak hanelah kâ a poe e naw patetlah Isarelnaw ni a tarawi awh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hahoi lukkareiim teh Mosi koe a ceikhai awh. lukkareiim hoi hnopainaw pueng, hetsinnae, tapang thingphek, tapang nahane tâphai, khom hoi khom pâhungnae naw hoi,
  </para>
  <para style="p">
    <verse number="34" style="v" />Tutan pho kapaling bu e khunae hoi saram pho hoi sak e a kânguenae a kâkapek nahane yaphninaw hai thoseh,
  </para>
  <para style="p">
    <verse number="35" style="v" />Lawkpanuesaknae thingkong hai kâkayawtnae acung, lungmanae tungkhung hai thoseh,
  </para>
  <para style="p">
    <verse number="36" style="v" />caboi hoi hnopainaw pueng hoi vaiyei tanae hai thoseh,
  </para>
  <para style="p">
    <verse number="37" style="v" />suikathoung hoi sak e hmaiimkhok hoi hmaiim hoi, hnopai pueng hoi paang nahane satui hoi thoseh,
  </para>
  <para style="p">
    <verse number="38" style="v" />Sui khoungroe, hluk e satui, sawi hane hmuituinaw hoi yaphni takhang koe yap hane yaphninaw hai thoseh,
  </para>
  <para style="p">
    <verse number="39" style="v" />Rahum khoungroe, rahum cuekkarue, acung, hnopai pueng, kawlung hoi pâhungnae,
  </para>
  <para style="p">
    <verse number="40" style="v" />Lukkareiim thongma e yaphni, khom, khom pâhungnae khompacawp, kalupnae longkha yaphni hoi a rui, hetsinnae, kâpatonae, lukkareiim thung e hnopai pueng thoseh,
  </para>
  <para style="p">
    <verse number="41" style="v" />hmuen kathoung koe thaw tawk nahanelah hnicu meikahawicalah kawng e vaihma Aron hoi a capanaw ni vaihma thaw a tawk awh torei teh a kâkhu awh hanelah kathounge hnicunaw hoi thoseh,
  </para>
  <para style="p">
    <verse number="42" style="v" />BAWIPA ni Mosi koe tawk hanelah kâ a poe e pueng hah Isarelnaw ni a tawk awh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hahoi Mosi ni a tawk e pueng a khet teh, khenhaw! koung a cum awh toe. BAWIPA ni kâpoe e patetlah koung a cum awh teh, Mosi ni yawhawi a poe.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />BAWIPA ni Mosi koe a dei pouh e teh,
  </para>
  <para style="p">
    <verse number="2" style="v" />apasueke thapa, apasuek hnin vah kamkhuengnae lukkareiim hah na sak han.
  </para>
  <para style="p">
    <verse number="3" style="v" />A thung vah lawkpanuesaknae thingkong hah na hruek vaiteh, yaphni hoi na ngue sak han.
  </para>
  <para style="p">
    <verse number="4" style="v" />Caboi hah na kâenkhai vaiteh, avan kaawm e hnonaw hah na hruek han, hmaiimkhok hah na kâenkhai vaiteh, hmaiim hah na hruek han.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmuitui hmaisawinae sui khoungroe hah lawkpanuesaknae hmalah na hruek vaiteh, lukkareiim takhang yaphni hah na yap han.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmaisawi thuengnae khoungroe hah kamkhuengnae lukkareiim takhang hmalah na hruek han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kamkhuengnae lukkareiim hoi khoungroe rahak vah kawlung na hruek vaiteh, hawvah tui na hlun han.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lukkareiim petkâkalup lah kalupnae thungup thongma na sak vaiteh, kalupnae longkha dawk yaphni na yap han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hluk e satui hah la vaiteh, lukkareiim hoi a thung kaawmnaw pueng hah hluk vaiteh, na thoung sak han, hnopainaw pueng hai hottelah a thoung awh han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmaisawi thuengnae khoungroe hoi hnopai pueng hah satui hluk vaiteh, khoungroe hah na thoung sak han. Hottelah khoungroe teh kathoungpounge lah ao han.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kawlung hoi pâhungnae hah satui na hluk vaiteh na thoung sak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aron hoi a capanaw hah kamkhuengnae lukkareiim takhang koevah, thokhai vaiteh, tui hoi na pâsu han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aron hah kathounge khohna hah na kho sak vaiteh, vaihma thaw kai han a tawk thai nahanelah, satui na hluk vaiteh na thoung sak han.
  </para>
  <para style="p">
    <verse number="14" style="v" />A capanaw hai thokhai vaiteh, angki na kho sak han.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hottelah vaihma thaw kai han a tawk thai awh nahanelah a na pa satui na hluk e patetlah satui na hluk han. Satui hluk lah ao awh e heh a ca catounnaw totouh a yungyoe vaihma lah ao awh nahanelah pouk pouh e lah pou ao han telah ahnimouh hanlah mitnoutnae lah ao telah a dei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hottelah, Mosi ni BAWIPA ni kâ a poe e patetlah koung a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hahoi, apâhni kum, apasuek thapa, apasuek hnin vah, lukkareiim hah a sak awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mosi ni lukkareiim hah a sak teh, khompacawpnae naw hah a ung teh, thingpheknaw hah a kangdue sak teh, pangkheknaw hah a hrawt teh, khomnaw hah a kangdue sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />BAWIPA ni Mosi koe kâ a poe e patetlah lukkareiim van vah hni a padi teh, hote van vah patuen patuen a ramuk sin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lawkpanuesaknae hah a la teh, thingkong thung vah a hruek. Thingkong dawk acung hah a hrawt teh, Thingkong van lungmanae tungkhung hah a hruek.
  </para>
  <para style="p">
    <verse number="21" style="v" />BAWIPA ni Mosi kâ a poe tangcoung e patetlah thingkong teh lukkareiim thung vah a hruek. Rakhannae yaphni hah a yap teh, lawkpanuesaknae thingkong teh rakhan thung vah ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Caboi teh kamkhuengnae lukkareiim thung, atunglah yaphni lawilah a hruek.
  </para>
  <para style="p">
    <verse number="23" style="v" />BAWIPA ni Mosi kâ a poe tangcoung e patetlah BAWIPA hmalah caboi dawk vaiyei teh a pâhung.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmaiimkhok hah kamkhuengnae lukkareiim thung akalah, caboi hoi kadangka lah a hruek.
  </para>
  <para style="p">
    <verse number="25" style="v" />BAWIPA ni Mosi kâ a poe tangcoung patetlah hmaiim hah BAWIPA hmalah a hruek.
  </para>
  <para style="p">
    <verse number="26" style="v" />BAWIPA ni Mosi kâ a poe tangcoung patetlah sui khoungroe teh kamkhuengnae lukkareiim thung yaphni hmalah a hruek teh,
  </para>
  <para style="p">
    <verse number="27" style="v" />hot van hmuitui hmai a sawi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hahoi lukkareiim takhang yaphni hah a yap.
  </para>
  <para style="p">
    <verse number="29" style="v" />BAWIPA ni Mosi kâ a poe tangcoung patetlah kamkhuengnae lukkareiim takhang kung koevah, hmaisawi thuengnae khoungroe hah a hruek teh, hot van vah hmaisawi thuengnae hoi canei thuengnae hah a thueng.
  </para>
  <para style="p">
    <verse number="30" style="v" />BAWIPA ni Mosi kâ a poe tangcoung patetlah kawlung hah kamkhuengnae lukkareiim hoi khoungroe rahak vah a hruek teh, kâpasu nahanlah tui a hlun.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosi, Aron hoi a capanaw ni haw vah a kutnaw hoi a khoknaw hah a pâsu awh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kamkhuengnae lukkareiim thung a kâen han nah hoi, khoungroe teng a cei awh han nah ouk a pâsu awh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hahoi lukkareiim hoi khoungroe petkâkalup lah a kalup teh, thongma e longkha dawk yaphni hah a yap teh, hottelah Mosi ni thaw hateh a cum.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hottelah kamkhuengnae lukkareiim teh tâmai ni muen a kayo teh, lukkareiim teh BAWIPA bawilennae hoi a kawi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hot patetlah tâmai a pâyam teh, BAWIPA bawilennae hoi lukkareiim muen akawi dawkvah, Mosi teh kamkhuengnae lukkareiim thung kâen thai hoeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tâmai ni lukkareiim a kâtawm takhai torei vah, Isarelnaw teh a cei awh nahane koe lah ouk a cei awh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hatei, tâmai ni kâtawm takhai hoehpawiteh, a kâtawm hoehroukrak kampuen laipalah ao awh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Bangkongtetpawiteh, kahlawng a cei awh nah thung pueng, Isarelnaw pueng e mithmu vah, BAWIPA e tâmai teh kanîthun vah lukkareiim lathueng a pâyam teh, karum vah ahnimouh lathueng ouk a ang pouh.
  </para>
</usx>
