<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">1 Setouknae</book>
  <para style="h">1 Setouknae</para>
  <para style="toc1">1 Setouknae</para>
  <para style="toc2">1 Setouknae</para>
  <para style="mt">1 Setouknae</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam, Seth, Enosh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Kenan, Mahalalel, Jared,
  </para>
  <para style="p">
    <verse number="3" style="v" />Enok, Methuselah, Lamek,
  </para>
  <para style="p">
    <verse number="4" style="v" />Noah, Shem, Ham, hoi Japheth.
  </para>
  <para style="p">
    <verse number="5" style="v" />Japheth capanaw teh: Gomer, Magog, Madai, Javan, Tubal, Meshek hoi Tiras.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gomer capanaw teh: Ashkenaz, Riphath hoi Togarmah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Javan capanaw teh: Elishah, Tarshish, Kittim hoi Rodanim.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ham capanaw teh: Kush, Mizraim, Put hoi Kanaan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kush capanaw teh: Seba, Havilah, Sabtah, Raamah hoi Sabteka. Raamah capanaw teh: Sheba hoi Dedan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kush ni Nimrod a sak teh ahni teh talai van dawk athakaawme kamtawng pasuek e lah ao.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mizraim ni Ludim, Anamim, Lehabim, Naptuhim a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathrusim, Kasluhim teh Philistin hoi Kapthorim tâconae lah ao.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kanaan ni a camin Sidon hoi Kheth,
  </para>
  <para style="p">
    <verse number="14" style="v" />Jebusit, Amor, Girgashite,
  </para>
  <para style="p">
    <verse number="15" style="v" />Khivee, Arkit hoi Sinit,
  </para>
  <para style="p">
    <verse number="16" style="v" />Arvad, Zemarit hoi Hamathite naw hah a khe.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shem capanaw teh: Elam hoi Assyria, Arphaxad hoi Lud, Aram hoi Uz, Hul, Gether hoi Meshek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Arphaxad ni Shelah hah a khe teh Shelah ni Eber a khe.
  </para>
  <para style="p">
    <verse number="19" style="v" />Eber ni capa kahni touh a khe, buet touh e min teh Peleg doeh. Bangkongtetpawiteh, hatnae se nah talai a kârei awh e lah ao. A nawngha e min teh Joktan doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joktan ni Almodad hoi Sheleph, Hazarmaveth hoi Jerah,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hadoram, Uzal, Diklah,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ebal, Abimael, Sheba,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ophir, Havilah hoi Jobab. Hetnaw pueng teh Joktan e capanaw doeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shem, Arphaxad, Shelah,
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber, Peleg, Reu,
  </para>
  <para style="p">
    <verse number="26" style="v" />Serug, Nahor, Terah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Abram heh Abraham doeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham capanaw teh Isak hoi Ishmael doeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hetnaw teh Ishmael casaknaw doeh. Ishmael e camin teh Nebaioth doeh. Hahoi, Kedar, Adbeel hoi Mibsam,
  </para>
  <para style="p">
    <verse number="30" style="v" />Mishma, Dumah, Massa, Hadad, Tema,
  </para>
  <para style="p">
    <verse number="31" style="v" />Jetur, Naphish hoi Kedemah. Ahnimanaw teh Ishmael casaknaw doeh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abraham e ado Keturah ca sak naw teh Zimran hoi Jokshan, Medan hoi Midian, Ishbak hoi Shuah, Jokshan casak teh Sheba hoi Dedan.
  </para>
  <para style="p">
    <verse number="33" style="v" />Midian casak teh Ephah, Epher, Enok, Abida hoi Eldaah. Hetnaw teh Keturah casaknaw doeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abraham ni Isak a sak. Isak casaknaw teh, Esaw hoi Isarel.
  </para>
  <para style="p">
    <verse number="35" style="v" />Esaw casaknaw teh Eliphaz, Reuel, Jeush, Jalam hoi Korah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eliphaz casaknaw teh, Teman, Omar, Zepho, Gatam, Kenaz, Timna hoi Amalek.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuel casaknaw teh, Nahath, Zerah, Shammah hoi Mizzah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Seir casaknaw teh: Lotan, Shobal, Zibeon, Anah, Dishon, Ezer hoi Dishan.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lotan casak naw teh: Khori, Homam hoi Lotan tawncanu Timna.
  </para>
  <para style="p">
    <verse number="40" style="v" />Shobal casaknaw teh: Alvan, Manahath, Ebal, Shepho hoi Onam. Zibeon casaknaw teh: Aiah hoi Anah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anah casak teh: Dishon. Dishon casaknaw teh: Hamran, Eshban, Ithran hoi Keran.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ezer casaknaw teh: Bilhan, Zaavan, Jaakan. Dishon casaknaw teh: Uz hoi Aran.
  </para>
  <para style="p">
    <verse number="43" style="v" />Isarel catounnaw dawk siangpahrang ao hoehnahlan vah, Edom ram e siangpahrangnaw teh, Beor capa Bela ao teh a khopui min teh Dinnabah doeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bela a due hnukkhu teh Bozrah koehoi Zerah capa Jobab teh ahni yueng lah a uk.
  </para>
  <para style="p">
    <verse number="45" style="v" />Jobab a due hnukkhu ahni yueng lah Temani ram dawk hoi Husham ni a uk.
  </para>
  <para style="p">
    <verse number="46" style="v" />Husham a due hnukkhu ahni yueng lah Moab ram vah Midian ka thet e Bedad capa Hadad ni a uk. A khopui min teh Avith doeh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hadad a due hnukkhu ahni yueng lah Masrekah hoi Samlah ni a uk.
  </para>
  <para style="p">
    <verse number="48" style="v" />Samlah a due hnukkhu teh ahni yueng lah Rehoboth palang hoi Sawl ni a uk
  </para>
  <para style="p">
    <verse number="49" style="v" />Sawl a due hnukkhu teh ahni yueng lah Akbor capa Baalhanan ni a uk.
  </para>
  <para style="p">
    <verse number="50" style="v" />Baalhanan a due hnukkhu ahni yueng lah Hadad a bawi. A khopui min teh Pau doeh, a yu min teh Mezahab napui Matred canu Mehetabel doeh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hadad a due hnukkhu Edom khobawi lah kaawmnaw teh, khobawi Timna, khobawi Alvah, khobawi Jetheth,
  </para>
  <para style="p">
    <verse number="52" style="v" />khobawi Oholibamah, khobawi Elah, khobawi Pinon,
  </para>
  <para style="p">
    <verse number="53" style="v" />khobawi Kenaz, khobawi Teman, khobawi Mibzar,
  </para>
  <para style="p">
    <verse number="54" style="v" />khobawi Magdiel, khobawi Iram hetnaw teh Edom khobawi lah ao.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isarel imthung hateh Reuben, Simeon, Levih, Judah, Issakhar hoi Zebulun,
  </para>
  <para style="p">
    <verse number="2" style="v" />Dan, Joseph, Benjamin, Naphtali, Gad hoi Asher.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah casaknaw teh: Er, Onan hoi Shelah. Hate kathum touh teh Kanaan napui Bathshua hoi a sak e naw doeh. Er teh Judah e camin lah ao ei, BAWIPA mithmu vah tamikathout lah ao dawkvah a due sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />A langa Tamar ni hai ahni hanlah Perez hoi Zerah a khe pouh dawkvah, Judah casak heh abuemlah panga touh a pha awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Perez casaknaw teh: Khetsron hoi Hamul.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerah casaknaw teh: Zimri, Ethan, Heman, Khalkol hoi Dara hoi abuemlah panga touh a pha awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Karmi casak teh Akhar doeh. Isarelnaw runae ka poe e, thoebo e ka parawt e Akhan doeh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ethan casak Azariah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khetsron casak Jerahmeel ni ahni hanlah Ram hoi Khelubai a sak pouh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ram ni Amminadab a sak. Amminadab ni Judah casak khobawi Nahshon a sak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nahshon ni Salma hah a sak teh Salma ni Boaz hah a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Boaz ni Obed a sak teh Obed ni Jesi a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesi ni a camin Eliab a sak. Apâhni lah Abinadab, apâthum lah Shimea,
  </para>
  <para style="p">
    <verse number="14" style="v" />apali nah Nethanel, apanga nah Raddai,
  </para>
  <para style="p">
    <verse number="15" style="v" />ataruk nah Ozem, asari nah Devit a sak.
  </para>
  <para style="p">
    <verse number="16" style="v" />A tawncanu hai ao teh Zeruiah hoi Abigail heh a tawncanu doeh. Zeruiah casak Abishai, Joab, Asahel hoi kathum touh a pha awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abigail ni Amasa a sak. Amasa na pa teh Ishmael Jether doeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khetsron capa Kaleb ni a yu Azubah hoi Jerioth koehoi ca a sak. Ahnie canaw teh: Jesher, Shobab hoi Ardon.
  </para>
  <para style="p">
    <verse number="19" style="v" />Azubah a due hoi Kaleb ni Epharath hah ama koe a la teh ahni hanlah Hur a sak pouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hur ni Uri hah a sak teh Uri ni Bezalel a sak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hahoi Khetsron ni Gilead tami Makhir canu a ikhai teh, Khetsron hah a la teh kum 60 a pha toteh, Khetsron hanlah Segub a sak pouh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Segub ni Jair a sak teh Gilead ram e khopui 23 touh hah ahnie lah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hatei, Geshur, Aram khocanaw hoi Jair, hotnaw thung hoi Kenath hoi a khotenaw, khopui 60 touh a la sin. Hotnaw pueng teh Gilead na pa Makhir casaknaw e doeh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hahoi Khetsron teh Kalebephratha kho dawk a due. Khetsron yu Abijah ni ahni hanlah Tekoa na pa Ashhur a sak pouh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khetsron e camin Jerahmeel casaknaw a camin Ram hoi Bunah, Oren hoi Ozem hoi Ahijah naw doeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jerahmeel teh a yu bout a la teh, a min teh Onam manu Atarah doeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerahmeel camin Ram casaknaw teh Maaz, Jamin hoi Eker naw doeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Onam casak teh Shammai hoi Jada lah ao teh Shammai casak teh Nadab hoi Abishur lah ao.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abishur e yu min teh Abihail doeh, ahni ni Ahban hoi Molid a sak pouh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nadab casak teh Seled hoi Appaimnaw doeh, Seled teh ca sak laipalah a due.
  </para>
  <para style="p">
    <verse number="31" style="v" />Appaim casak teh Ishi, Ishi casak teh Sheshan, Sheshan casak teh Ahlai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Shammai e nawngha Jada casak teh Jether hoi Jonathan lah a o, Jether teh ca sak laipalah a due.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jonathan casak teh Peleth, Zaza. Hetnaw teh, Jerahmeel casak lah ao awh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sheshan teh ca tongpa awm hoeh, napuinaw dueng doeh kaawm. Sheshan koevah, Izip san, a min lah Jarha ao.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sheshan ni a canu teh a san Jarha koevah a yu lah a poe dawkvah ahni hanlah Attai a sak pouh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Attai ni Nathan a sak teh Nathan ni Zabad a sak.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zabad ni Ephlal a sak teh Ephlal ni Obed a sak.
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed ni Jehu a sak teh Jehu ni Azariah a sak.
  </para>
  <para style="p">
    <verse number="39" style="v" />Azariah ni Helez a sak teh Helez ni Eleasah a sak.
  </para>
  <para style="p">
    <verse number="40" style="v" />Eleasah ni Sismai a sak teh Sismai ni Shallum a sak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Shallum ni Jekamiah a sak teh Jekamiah ni Elishama a sak.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jerahmeel nawngha Kaleb casak Ziph na pa Mesha hah a camin teh Mareshah casak Hebron na pa lah ao.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hebron casak teh Korah, Tappuah, Rekem hoi Shema doeh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shema ni Jorkeam na pa Raham a sak teh Rekem ni Shammai a sak.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shammai casak Moan doeh, Maon teh Bethzur na pa doeh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kaleb e ado Ephah ni Haran, Moza hoi Gazez a sak. Haran ni Gazez a sak.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jahdai casak teh Regem, Jotham, Geshan, Pelet, Ephah hoi Shaaph doeh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kaleb e ado Maakah ni Sheber hoi Tirhannah a sak.
  </para>
  <para style="p">
    <verse number="49" style="v" />Madmannah na pa Shaaph, Makhbena na pa Sheva hoi Gibea na pa hai a sak. Aksah heh Kaleb canu doeh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hetnaw heh Kaleb casak lah ao awh. Hur casak a camin lah Epharath lah ao teh, Kiriathjearim na pa Shobal.
  </para>
  <para style="p">
    <verse number="51" style="v" />Bethlehem na pa Salma, Bethgader na pa Hareph hai ao.
  </para>
  <para style="p">
    <verse number="52" style="v" />Kiriathjearim na pa Shobal casak thung hoi Manahati tangawn, Haroehnaw hai ao rah.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kiriathjearim casak dawkvah Ithrite hoi Puthit, Shumati, Mishraitinaw ao awh teh, hetnaw koehoi Zorath hoi Eshtaol lah a tâco.
  </para>
  <para style="p">
    <verse number="54" style="v" />Salma casak Bethlehem, Netophah, Atrothbethjoab hoi Manahati tangawn Zorithnaw hah doeh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Cakathutkungnaw casak lah kaawm e teh Jabez, Tirathites, Shimeathi hoi Shukathi doeh. Hetnaw heh Rekhab imthung e a na pa Khammath koehoi ka tâcawt e Keninaw doeh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hetnaw heh Devit casaknaw lah ao awh. Ahni hanlah Hebron vah Jezreel Ahinoam ni a camin Amnon a sak pouh. Apâhni lah Karmel Abigail ni Daniel a sak pouh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Apâthum nah siangpahrang Geshur Talmai canu Maakah capa Absalom, apali nah Haggith capa Adonijah.
  </para>
  <para style="p">
    <verse number="3" style="v" />Apanga nah Abital capa Shephatiah, ataruk nah a yu Eglah capa Ithream,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hebron vah hete capa taruk touh heh a sak toe. Hawvah, kum sari touh hoi thapa yung taruk touh a uk teh, Jerusalem vah kum 33 touh a uk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jerusalem vah a sak e naw teh: Shimea, Shobab, Nathan, Solomon naw doeh. Ammiel canu Bathshua hoi pali touh a sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hathnukkhu, Ibhar, Elishama hoi Eliphelet,
  </para>
  <para style="p">
    <verse number="7" style="v" />Nogah, Nepheg hoi Japhia.
  </para>
  <para style="p">
    <verse number="8" style="v" />Elishama, Eliada hoi Eliphelet, tako touh a pha awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hetnaw pueng teh Devit casaknaw doeh, adonaw e casaknaw hai ao rah. Hahoi Tamar teh ahnimae tawncanu doeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Solomon casaknaw teh: Rehoboam, Rehoboam capa Abijah, Abijah capa Asa, Asa capa Jehoshaphat.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jehoshaphat capa Joram, Joram capa Ahaziah, Ahaziah capa Joash,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahaziah capa Amaziah, Amaziah capa Azariah, Azariah capa Jotham.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jotham capa Ahaz, Ahaz capa Hezekiah, Hezekiah capa Manasseh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh capa Amon, Amon capa Josiah.
  </para>
  <para style="p">
    <verse number="15" style="v" />Josiah casak teh a camin he Johanan, apâhni lah Jehoiakim, apâthum lah Zedekiah, apali lah Shallum.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jehoiakim casaknaw dawk, Jehoiakim capa Jekoniah, Jekoniah capa Zedekiah.
  </para>
  <para style="p">
    <verse number="17" style="v" />San lah kaawm e Jekoniah casak dawk, Jekoniah capa Shealtiel.
  </para>
  <para style="p">
    <verse number="18" style="v" />Malkiram, Pedaiah, Shenazzar, Jekamiah, Hoshama hoi Nedabiah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pedaiah casak teh Zerubbabel hoi Shimei, Zerubbabel casak teh Meshullam hoi Hananiah hoi a tawncanu Shelomith.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hashubah hoi Ohel, Berekhiah hoi Hasadiah, Jushabhesed hoi panga touh a pha awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hananiah casak teh Pelatiah hoi Isaiah, Rephaiah casak, Arnon casak, Obadiah casak, Shekaniah casak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shekaniah casak teh Shemaiah, Shemaiah casak teh Hattush, Igal, Bariah, Neariah, Shaphat hoi taruk touh a pha awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Neariah casak teh Elioenai, Hezekiah, Azrikam hoi kathum touh a pha awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Apâthum e Elioenai casak koehoi Hodaviah, Eliashib, Pelaiah, Akkub, Johanan, Delaiah, Anani hoi sari touh a pha awh.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah casak teh Perez, Khetsron, Karmi, Hur, Shobal.
  </para>
  <para style="p">
    <verse number="2" style="v" />Shobal capa Reaiah ni Jahath a sak. Jahath ni Ahumai hoi Lahad a sak. Hetnaw teh Zorath e casaknaw doeh
  </para>
  <para style="p">
    <verse number="3" style="v" />Etam na pa e canaw teh Jezreel, Ishma hoi Idbash doeh, a tawncanu min teh Hazzelelponi doeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gedor na pa Penuel hoi Hushah na pa Ezer. Hetteh Bethlehem na pa Epharath e camin Hur casak doeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tekoa na pa Ashhur heh a yu kahni touh, Helah hoi Naarah a tawn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahni hanlah Naarah ni Ahuzzam, Hepher, Temeni, Haahashtari a sak pouh. Hetnaw heh Naarah casak lah ao.
  </para>
  <para style="p">
    <verse number="7" style="v" />Helah casaknaw teh: Zereth, Zohar hoi Ethan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Koz ni Anub hoi Zobebah a sak teh Harum capa Aharhel casak lah ao.
  </para>
  <para style="p">
    <verse number="9" style="v" />Telah ao navah, Jabez teh a hmaunawnghanaw thung dawk minhmai khet e tami lah ao. A manu ni reithai nalaihoi ka khe e doeh ati teh, a min teh Jabez a phung.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jabez teh Isarel Cathut koevah, Yawhawi na poe roeroe haw, ka ram teh kaw sak haw, na kut hoi na awmkhai nateh, lungmathoenae kai koe a pha hoeh nahanelah, yonnae thung hoi na hlout sak haw, telah a hram teh, ahni ni a hei e hah a poe.
  </para>
  <para style="p">
    <verse number="11" style="v" />Shuhah e a nawngha Kelub ni Eshton na pa Mehir a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eshton ni Bethrapha, Paseah, Nahash khopui na pa Tehinah a sak. Hetnaw heh Rekah taminaw doeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kenaz casaknaw teh: Othniel, Seraiah. Othniel casak teh Hathath.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meonothai ni Ophrah a sak teh Seraiah ni Gekharashim na pa Joab a sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jephunneh capa Kaleb casak teh Iru, Elah hoi Naam, Elah e capa teh Kenaz doeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jehallelel casak teh Ziph, Ziphah, Tiria hoi Asarel.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ezrah casak teh Jether, Mered, Epher, Jalon doeh. Miriam ni Shammai hoi Eshtemoa na pa Ishbah a khe pouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahnie yu Jehudijah ni Gedor na pa Jered, Sokoh na pa Heber, Zanoah na pa Jekuthiel a sak. Hetnaw teh Mered ni a la e Faro canu Bithiah canaw doeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hodiah yu casak teh Karmi Keilah na pa Naham tawncanu hoi Maakath Eshtemoa doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Shimon casak teh Amnon, Rinnah, Benhanan, Tilon. Ishi casak teh Zoheth hoi Benzoheth.
  </para>
  <para style="p">
    <verse number="21" style="v" />Judah capa Shelah casak teh Lekah na pa Er, Mareshah na pa Laadah doeh. Ashbe imthung dawk teh loukloukkaang e lukkarei ka sak thai e hai ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jokim hoi Kozeba tami hoi Joash, Moab vah yu ka lat e Seraph hoi Jashubilehem. Palang thut e naw doeh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hetnaw teh Netaim hoi Gederah vah kho ka sak e hlaam ka bo e naw doeh, siangpahrang koe tawngtang kho a sak awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simeon casak teh Nemuel, Jamin, Jarib, Zerah, Sawl.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sawl capa Shallum, Shallum capa Mibsam, Mibsam capa Mishma.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mishma casak lah, Mishma capa Hammuel, Hammuel capa Zakkur, Zakkur capa Shimei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shimei te capa hlaitaruk touh hoi canu taruk touh ao awh ei, a hmaunawnghanaw teh ca moi tawn awh hoeh. Hatdawkvah, ahnimae canaw pueng teh Judah casak patetlah la pung awh hoeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Beersheba, Moladah, Hazarshual,
  </para>
  <para style="p">
    <verse number="29" style="v" />Bilhah, Ezem, Tolad,
  </para>
  <para style="p">
    <verse number="30" style="v" />Bethuel, Hormah, Ziklag,
  </para>
  <para style="p">
    <verse number="31" style="v" />Bethmarkaboth, Hazarsusim, Bethbiri, Shaaraim vah kho a sak awh. Hetnaw heh Devit a bawi nah totouh ahnimae khopui lah ao.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahnimae khotenaw teh Etam, Ayin, Rimmon, Tokhen, Ashan hoi kho panga touh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahnimae khote pueng teh khopui tengpam vah Baal totouh ao awh. Hetnaw teh khosaknae lah ao awh teh, a napanaw e konglam thut e hai a tawn awh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Meshobab, Jamlekh hoi Amaziah capa Joshah.
  </para>
  <para style="p">
    <verse number="35" style="v" />Joel hoi Asiel casak Seraiah, Joshibiah capa Jehu.
  </para>
  <para style="p">
    <verse number="36" style="v" />Elioenai, Jaakobah, Jeshohaiah, Asaiah, Adiel, Jesimiel hoi Benaiah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Shiphi capa Ziza, Allon capa Shiphi, Jedaiah capa Allon, Shimri capa Jedaiah, Shemaiah capa Shimri.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hete a min kaawm e naw teh casaknaw ka hrawi e lah ao teh, imthung teh moikapap a kamphung awh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahnimanaw teh Gedor kâennae tanghling kanîtholah totouh saringnaw pâ nahane tawng hanelah a cei awh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Saringnaw pâ nahane, hram ca hane kahawipoung e ram lah a hmu awh. A ram a kaw teh karoumcalah onae hmuen lah ao. Hmaloe la kaawm e teh Ham catounnaw doeh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hetteh Judah siangpahrang Hezekiah tue navah a min hoi a thut e naw doeh kamnuek. Hatnavah, ahnimae rimnaw hoi Mehunimnaw teh a thei awh teh atu totouh hote hmuen koe ao awh. Bangkongtetpawiteh, saringnaw a pâ nahanlah ao dawkvah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Simeon casak tami 500 touh hane Seir mon dawk a luen awh. Hatnavah Ishi canaw Pelatiah, Neariah, Rephaiah hoi Uzziel tinaw teh a lû lah ao awh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amalek miphun, ka yawng e naw dawk hoi kaawm e naw hah a tâ awh teh, atu totouh kho a sak sin awh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isarel e camin teh Reuben e capanaw katang doeh. Hateiteh, a na pa e ikhun a khin sak dawkvah, camin lah a onae hah Isarel e capa Joseph e capanaw koe poe e lah ao. Hatdawkvah, setouknae dawk camin lah a onae hah pakhum e lah awm hoeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah teh a hmaunawnghanaw hlak a tha a sai teh, ahni dawk hoi kaukkung a tâco. Camin lah a onae teh Joseph ni a coe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Isarel camin Reuben e casaknaw teh Hanok, Pallu, Hezron hoi Karmi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joel casak teh, a capa Shemaiah, Shemaiah capa Gog, Gog capa Shimei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shimei capa Maikah, Mikah capa Reaiah, Reaiah capa Baal.
  </para>
  <para style="p">
    <verse number="6" style="v" />Baal capa Beerah. Ahni teh Reuben e khobawi lah ao eiteh, Assyria siangpahrang Tiglathpileser ni san lah a hrawi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amae a nawngha Jeiel hoi Zekhariah, ahnimouh roi teh ca catoun separuinae pakhumnae dawkvah, imthungnaw kahrawikung lah ao.
  </para>
  <para style="p">
    <verse number="8" style="v" />Azaz capa Bela, Shema capa Azaz, Joel capa Shema ni Aroer hoi Nebo Baalmeon totouh kho a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kanîtholah Euphrates palang hoi kahrawng thung kâennae totouh, a coe awh. Bangkongtetpawiteh, Gilead ram dawk saringnaw hah a pungdaw toe.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sawl se navah Hagri miphunnaw hoi a kâtuk awh teh, Gilead kanîtholah totouh, rimnaw dawk kho a sak awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gad e casaknaw teh avangvanglah Bashan ram dawk Salkah totouh ao awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bashan vah a lû lah Joel, apâhni lah Shapham, Janai hoi Shaphat tinaw doeh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A na pa imthung hoi a hmaunawnghanaw Michael, Meshullam, Sheba, Jorai, Jakhan, Zia, Eber hoi sari touh a pha awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hetnaw teh Huri capa Abihail e capanaw doeh. Ahni teh Jaorah capa doeh. Gilead capa, Michael capa, Jeshishai capa, Jahdo capa, Buz capa lah ao.
  </para>
  <para style="p">
    <verse number="15" style="v" />Guni capa, Abdiel capa, Ahni teh imthung kahrawikung lah ao.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hatdawkvah, Gilead hoi Bashan khotenaw tengpam e ram pueng khori totouh kho a sak awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hote hnonaw pueng teh, Judah siangpahrang Jotham e se hoi Isarel siangpahrang Jeroboam e se teh setouknae dawk thut lah ao toe.
  </para>
  <para style="p">
    <verse number="18" style="v" />Reuben casak, Gad casak, hoi Manasseh miphun tangawn dawk hoi tarankahawinaw, bahling, tahloi ka patuem thai e naw, likathoumnaw, taran ka tuk thai e naw 44, 760 touh a pha awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hatnavah, Hagri, Jetur, Naphish hoi Nodabnaw hoi a kâtuk awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kâtuk nahaiyah Cathut koe a hram awh teh, ama a kâuep awh dawkvah, ahnimouh teh a kabawp awh. Hatdawkvah, Hagrinaw hoi ahnimouh koe kaawm e abuemlah a kut dawk hoi a rungngang awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Saringnaw a man pouh awh teh, kalauk 50000, tu 250000, hoi la 2000 hoi tami 100000 a la awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tarantuknae teh Cathut e lah ao dawkvah, tami moikapap a due awh. San toung totouh a onae hmuen koe ao awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Manasseh miphun tangawn teh, haw e ram dawk kho a sak awh. Bashan hoi Baalhermon hoi Senir hoi Hermon mon totouh tami teh a pungdaw awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hetnaw heh a imthungnaw kahrawikung lah a o: Epher, Ishi, Eliel, Azriel, Jeremiah, Hodaviah, Jahdiel. Ahnimanaw teh tami a thakaawme, min kamthang e, imthung kahrawikung lah ao awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mintoenaw e Cathut koe yuemkamcu awh hoeh dawkvah, ahnimae hmaitung Cathut ni a raphoe teh, hote ram dawk e cathutnaw koe a kâyo awh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hottelah Isarel Cathut ni Assiria siangpahrang Pul, Assiria siangpahrang Tiglathpileser e lungthin a tho sak teh, Reuben hoi Gad, Manasseh miphun tangawn hah san lah a man awh teh, Halah, Habor, Hara tinaw hah Gozan palang a ceikhai awh teh atu totouh ao awh.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levih casaknaw teh: Gershon, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kohath casaknaw teh: Amram, Izhar, Hebron hoi Uzziel.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amram casaknaw teh: Aron, Mosi hoi Miriam. Aron casaknaw teh: Nadab, Abihu, Eleazar hoi Ithamar.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eleazar ni Phinehas a sak teh Phinehas ni Abishua a sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abishua ni Bukki a sak teh Bukki ni Uzzi a sak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Uzzi ni Zerahiah a sak, Zerahiah ni Meraioth a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Meraioth ni Amariah a sak, Amariah ni Ahitub a sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahitub ni Zadok a sak, Zadok ni Ahimaaz a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahimaaz ni Azariah a sak, Azariah ni Johanan a sak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Johanan ni Azariah a sak. Ahni teh Solomon ni Jerusalem vah a sak e im dawk vaihma thaw a tawk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Azariah ni Amariah a sak teh Amariah ni Ahitub a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahitub ni Zadok a sak teh Zadok ni Shallum a sak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shallum ni Hilkiah a sak teh Hilkiah ni Azariah a sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Azariah ni Seraiah a sak teh Seraiah ni Jehozadak a sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />BAWIPA ni Judah hoi Jerusalem teh, Nebukhadnezar kut dawk a poe navah, Jehozadak hai a cei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Levih casaknaw teh: Gershom, Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gershom casaknaw e min teh, Libni hoi Shimei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath casaknaw teh: Amram, Izhar, Hebron hoi Uzziel.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari casaknaw teh: Mahli, Mushi naw doeh. Hetnaw teh Levih casaknaw e napanaw doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gershom casaknaw teh: Gershom capa Libni, Libni capa Jahath, Jahath capa Zimmah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zimmah capa Joah, Joab capa Iddo, Iddo capa Zerah, Zerah capa Jeatherai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kohath casaknaw teh: Kohath capa Amminadab, Amminadab capa Korah, Korah capa Assir.
  </para>
  <para style="p">
    <verse number="23" style="v" />Assir capa Elkanah, Elkanah capa Ebiasaph, Ebiasaph capa Assir.
  </para>
  <para style="p">
    <verse number="24" style="v" />Assir capa Tahath, Tahath capa Uriel, Uriel capa Uzziah, Uzziah capa Sawl.
  </para>
  <para style="p">
    <verse number="25" style="v" />Elkanah casaknaw teh: Amasai hoi Ahimoth.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahimoth capa Elkanah, Elkanah casaknaw teh: Elkanah capa Zuph, Zuph capa Nahath.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nahath capa Eliab, Eliab capa Jeroham, Jeroham capa Elkanah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Samuel casaknaw teh: a camin Joel, apâhni e teh Abijah doeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari casaknaw teh: Mahli capa Libni, Libni capa Shimei, Shimei capa Uzzah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Uzzah capa Shimea, Shimea capa Haggiah, Haggiah capa Asaiah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hetnaw teh lawkkam thingkong a ta hnukkhu, BAWIPA e im dawk kahrawikung hanelah Devit ni a ta e naw lah ao.
  </para>
  <para style="p">
    <verse number="32" style="v" />Solomon ni Jerusalem BAWIPA im a sak hoehroukrak, kamkhuengnae lukkareiim dawk la hoi thaw a tawk awh. A huhu lahoi thaw tawk a kâhlai awh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hotnaw teh thaw katawknaw lah ao awh. A canaw hoi Kohath catounnaw teh la ka sak e Heman doeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Elkanah capa Samuel, Jeroham capa Elkanah, Eliel capa Jeroham, Toah capa Eliel.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zuph capa Toa, Elkanah capa Zuph, Mahath capa Elkanah, Amasai capa Mahath.
  </para>
  <para style="p">
    <verse number="36" style="v" />Elkanah capa Amasai, Joel capa Elkanah, Azariah capa Joel, Zephaniah capa Azariah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tahath capa Zephaniah, Assir capa Tahath, Ebiasaph capa Assir, Korah capa Ebiasaph.
  </para>
  <para style="p">
    <verse number="38" style="v" />Izhar capa Korah, Kohath capa Izhar, Levih capa Kohath, Isarel capa Levih.
  </para>
  <para style="p">
    <verse number="39" style="v" />A hmaunawngha e aranglah ka tahung e Asaph, Berekhiah capa Asaph, Shimea capa Berekhiah.
  </para>
  <para style="p">
    <verse number="40" style="v" />Michael capa Shimea, Baaseiah capa Michael, Malkhijah capa Baaseiah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ethni capa Malkhijah, Zerah capa Ethni, Adaiah capa Zerah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ethan capa Adaiah, Zimmah capa Ethan, Shimei capa Zimmah.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jahath capa Shimei, Gershom capa Jahath, Levih capa Gershom.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hahoi avoilah kaawm e hmaunawngha Merari casak teh: Kishi capa Ethan, Abdi capa Kishi, Malluck capa Abdi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hashabiah capa Malluck, Amaziah capa Hashabiah, Hilkiah capa Amaziah,
  </para>
  <para style="p">
    <verse number="46" style="v" />Amzi capa Hilkiah, Bani capa Amzi, Shemer capa Amzi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mahli capa Shemer, Mushi capa Mahli, Merari capa Mushi, Levih capa Merari.
  </para>
  <para style="p">
    <verse number="48" style="v" />A hmaunawnghanaw thung dawk e Levih imthungnaw teh, Cathut onae lukkareiim dawk thaw ka tawk hanelah poe e lah ao awh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aron e casaknaw ni Cathut e san Mosi ni kâ a poe e naw pueng teh, hmuen kathoungpounge koe thaw tawk hane a coe awh. Isarelnaw yontha hanelah sathei hoi hmuitui hah hmaisawi thuengnae khoungroe dawk ouk a poe awh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Aron casaknaw teh: Aron capa Eleazar, Eleazar capa Phinehas, Phinehas capa Abishua.
  </para>
  <para style="p">
    <verse number="51" style="v" />Abishua capa Bukki, Bukki capa Uzzi, Uzzi capa Zerahiah.
  </para>
  <para style="p">
    <verse number="52" style="v" />Zerahiah capa Meraioth, Meraioth capa Amariah, Amariah capa Ahitub.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ahitub capa Zadok, Zadok capa Ahimaaz.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hetnaw teh amamae ram thung a onae hmuen a nepnae koe lengkaleng kho a sak awh. Aron e capa Kohath miphunnaw teh, cungpam a khoe awh e patetlah,
  </para>
  <para style="p">
    <verse number="55" style="v" />Judah ram hoi Hebron hoi a tengpam e pueng hah poe e lah ao awh.
  </para>
  <para style="p">
    <verse number="56" style="v" />Hateiteh, khopui hoi a tengpam e ramnaw hoi khotenaw teh Jephunneh e capa Kaleb hah a poe awh.
  </para>
  <para style="p">
    <verse number="57" style="v" />Aron capanaw teh, kângue e khopui, Hebron, Libnah hoi a tengpam hai, Jattir hoi Eshtemoa tengpam e khonaw hai.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hilen tengpam e khonaw hai, Debir tengpam e khonaw hai.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ashan tengpam e khonaw, Bethshemesh tengpam e khonaw hai.
  </para>
  <para style="p">
    <verse number="60" style="v" />Benjamin miphunnaw thung dawk hoi Geba hoi tengpam e khonaw, Alemeth tengpam hoi khonaw hai. Anathoth tengpam e khonaw hai a poe awh. A miphunnaw koe a poe awh e khonaw teh, kho 13 touh a pha.
  </para>
  <para style="p">
    <verse number="61" style="v" />Kohath miphun imthungnaw hanelah Manasseh miphun tangawn naw ni a coe awh e dawk hoi khopui 10 touh cungpam a khoe awh teh a poe awh.
  </para>
  <para style="p">
    <verse number="62" style="v" />Gershom casaknaw teh, a miphun lahoi Issakhar miphun ni a coe e dawk hoi, Asher miphun a coe e dawk hoi, Naphtali miphun coe e dawk hoi, Manasseh miphun coe e dawk hoi, Bashan ram Manasseh coe e naw dawk hoi khopui 13 touh a poe awh.
  </para>
  <para style="p">
    <verse number="63" style="v" />Merari casaknaw teh: amamae imthung lahoi Reuben coe e dawk hoi, Gad coe e dawk hoi, Zebulun coe e dawk hoi, cungpam khoe e lah kho 12 touh a poe awh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Isarelnaw ni Levih miphunnaw teh khopui hoi a tengpam e naw hah a poe awh.
  </para>
  <para style="p">
    <verse number="65" style="v" />Judah miphun coe e thung dawk hoi, Simeon miphun coe e thung dawk hoi, Benjamin miphun coe e thung dawk hoi, cungpam khoe e lahoi a poe awh.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kohath miphun coe e hoi Ephraim miphun coe e khopui hai a coe awh.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Issakhar casaknaw teh: Tola, Puvah, Jashub, Shimron hoi pali touh a pha awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tola casaknaw teh: Uzzi, Rephaiah, Jeriel, Jahmai, Ibsam hoi Samuel heh a na pa imthung dawk a lû lah ao awh. Tola teh catoun imthung dawk athakaawme lah ao. Devit a hring nah tami 22, 600 touh a pha awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uzzi casaknaw teh: Izrahiah, Izrahiah casaknaw teh: Michael, Obadiah, Joel, Isshiah hoi panga touh a pha awh, abuemlahoi a lû lah koung ao awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />A imthung milu separeinae lahoi 36, 000 a pha awh. A yucanaw moikapap a tawn awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Issakhar imthungnaw separuinae dawk parei sin e hmaunawnghanaw teh thakaawme tami 87, 000 a pha awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benjamin casaknaw teh: Bela, Bekher, Jediael hoi kathum touh a pha awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bela casaknaw teh: Ezbon, Uzzi, Uzziel, Jerimoth, Iri hoi panga touh a pha awh. A napanaw imthung dawk a lû lah kaawm e hoi athakaawme tami lah ao awh. Imthung separuinae dawk parei sin e hmaunawnghanaw teh 22, 034 touh a pha awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bekher casaknaw teh: Zemirah, Joash, Eliezer, Elioenai, Omri, Jerimoth, Abijah, Anathoth hoi Alemeth. Hetnaw teh abuemlahoi Bekher casaknaw doeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahnimouh teh imthung separuinae dawk parei sin e patetlah imthung dawk a lû lah kaawm e hoi athakaawme taminaw lah ao awh teh, 20, 200 touh a pha awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jediael casaknaw teh: Bilhan, Bilhan casaknaw teh: Jeush, Benjamin, Ehud, Kenaanah, Zethan, Tarshish hoi Ahishahar.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hetnaw pueng heh a na pa imthung dawkvah, lû lah kaawm e naw hoi a thakaawme taminaw lah ao awh teh 17, 200 touh a pha awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ir casaknaw teh: Shuppim hoi Huppim, Aher casak teh Hushim.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naphtali casaknaw teh: Jahziel, Guni, Jezer, Bilhah casak teh Shallum.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh e ado Aramaih tami ni Asriel hah a sak pouh teh Gilead na pa Makhir hai a sak pouh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Makhir ni a yu hah Huppim hoi Shuppim tami a yu lah a la. A tawncanu min teh Maakah doeh. Apâhni e min teh Zelophehad. Hatei Zelophehad koehoi ca napuinaw doeh kaawm.
  </para>
  <para style="p">
    <verse number="16" style="v" />Makhir yu Maakah ni capa a khe teh a min lah Peresh a phung. A nawngha min teh Sheresh doeh, ahnie ca roi teh Ulam hoi Rekem.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ulam casak teh Bedan. Hetnaw heh Manasseh capa Makhir e a ca Gilead casaknaw doeh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A tawncanu Hammoleketh ni Ishhod, Abiezer hoi Mahlah a sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Shemida casaknaw teh: Ahian, Shekhem, Likhi hoi Aniam doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim casak teh Shuthela doeh. Shuthela capa Bered, Bered capa Tahath, Tahath capa Eleadah, Eleadah capa Tahath.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tahath capa Zabad, Zabad casaknaw teh: Shuthela, Ezer hoi Elead. Hote ram dawk ka tâcawt e Gad taminaw ni saringnaw lawp hane a ngai awh dawkvah, a thei awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A na pa Ephraim ni ahnin moikasawlah a khui. A hmaunawnghanaw ni lungpahawi hanelah a tho sin awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hahoi a yu koe a i teh, a yu te camo a vawn. Capa a khe pouh toteh a imthung dawk yawthoe a kâhmo dawkvah a min teh Beriah a phung.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahnie canu teh Sheerah doeh, atunglah kaawm e Bethhoron kho hoi akalah kaawm e Uzzensherah kho ka thawng e doeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahnie casaknaw teh: Rephah hoi Resheph doeh. Resheph capa teh, Telah. Telah capa teh Tahan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tahan capa Ladan, Ladan capa Ammihud, Ammihud capa Elishama.
  </para>
  <para style="p">
    <verse number="27" style="v" />Elishama capa Nun, Nun capa Joshua.
  </para>
  <para style="p">
    <verse number="28" style="v" />A coe awh e hoi a khosaknae teh, Bethel hoi khotenaw hoi kanîtholae Naaran, kanîloumlae Gezer hoi khotenaw, Shekhem hoi khotenaw, Ai hoi khotenaw koe totouh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh casaknaw khori lungui vah, Bethshean hoi khotenaw, Taanakh hoi khotenaw, Megiddo hoi khotenaw, Dor hoi khotenaw heh Isarel capa Joseph casaknaw ni hawvah kho a sak awh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Asher casaknaw teh: Imnah, Ishua, Ishvi, Beriah hoi a tawncanu Serah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Beriah casaknaw teh: Heber, Birzaith na pa Malkhiel hoi Birzaith.
  </para>
  <para style="p">
    <verse number="32" style="v" />Heber ni Japhlet, Shomer, Hotham hoi a tawncanu Shua a sak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Japhlet casak Pasakh, Bimhal, Ashvath doeh, hetnaw heh Japhlet casaknaw doeh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Shemer casak Ahi, Rohgah hoi Hubbah Rohgah, Hubbah hoi Aram.
  </para>
  <para style="p">
    <verse number="35" style="v" />A hmaunawngha Helem casaknaw teh: Zophah, Imna, Shelesh hoi Amal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zophah casak Suah, Harnepher, Shual, Beri hoi Imrah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bezer, Hod, Shammah, Shilshah, Ithran hoi Beera.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jether casaknaw teh: Jephunneh, Pispah, Ara.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ulla casaknaw teh: Arah, Hanniel hoi Rizia.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hetnaw pueng teh Asher dawk hoi imthung dawk lû lah kaawmnaw, thakaawme taminaw doeh. Hottelah imthung separuinae hoi taran ka tuk thai naw parei navah tami 26, 000 touh a pha awh.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Benjamin ni a camin lah Bela, apâhni lah Ashbel, apâthum lah Aharah a sak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Apali lah Nohah, apanga lah Rapha.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bela casak teh: Addar, Gera, Abihud.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abishua, Naaman, Ahoah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gera, Shephuphan, Huram doeh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hetnaw teh Ehud capanaw doeh. Geba kho ka sak e imthungnaw kahrawikung lah Manahath kho dawk ngangngang ceisak e naw doeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Naaman, Ahijah, Gera tinaw heh ngangngang ceisak e naw doeh. Ahni ni Uzzah hoi Ahihud hah a sak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Shaharaim ni ahnimouh a bansak hnukkhu hoi a yu Hushim hoi Baara ni Moab ram dawk ca catounnaw moi a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />A yu Hodesh koehoi Jobab, Zibia, Mesha, Milkom,
  </para>
  <para style="p">
    <verse number="10" style="v" />Jeuz, Sakia, Mirmah a sak. Ahnie casaknaw teh napanaw e lû lah ao awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hushim koehoi Abitub hoi Elpaal a sak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elpaal casak teh: Eber, Misham, Shemmed. Ahni teh Ono, Lod hoi khotenaw kathawngkung lah ao .
  </para>
  <para style="p">
    <verse number="13" style="v" />Beriah hoi Shema teh Aijalon vah kho ka sak e napanaw e lû lah ao awh. Ahnimouh roi doeh Gath vah kho ka sak naw hai ka yawng sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hathnukkhu, Ahio, Shashak hoi Jerimoth.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebadiah, Arad hoi Eder.
  </para>
  <para style="p">
    <verse number="16" style="v" />Michael, Ishaph, Beriah casak Joha.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebadiah, Meshullam, Hizki hoi Heber.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ishmerai, Izliah hoi Elpaal casak Jobab tinaw doeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakim, Zikhri hoi Zabdi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Elienai, Zillethai hoi Eliel.
  </para>
  <para style="p">
    <verse number="21" style="v" />Adaiah, Beriah hoi Shimei casak Shimrath.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ishpan, Eber hoi Eliel.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abdon, Zikhri hoi Hanan.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hananiah, Elam hoi Anthothijah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Iphdeiah hoi Shashak casak Penuel.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shamsherai, Shehariah hoi Athaliah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jaareshiah, Elijah hoi Jeroham casak Zikhri.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amamae separuinae dawkvah imthung kahrawinaw lah ao awh teh, Jerusalem vah kho a sak awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gibeon vah Gibeon na pa ni kho a sak teh a yu min teh Maakah doeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ahnie casak teh: a camin teh Abdon doeh, Zur, Kish, Baal hoi Nadab.
  </para>
  <para style="p">
    <verse number="31" style="v" />Gedor, Ahio, Zeker.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mikloth ni Shimeah hah a sak. Ahnimouh hai Jerusalem vah a hmaunawnghanaw e teng vah kho a sak awh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ner ni Kish a sak, Kish ni Sawl a sak, Sawl ni Jonathan, Malkhishua, Abinadab, Eshbaal a sak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jonathan casak teh: Meribbaal doeh, Meribbaal ni Maikah a sak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Maikah casak teh: Pithon, Melek, Tarea hoi Ahaz.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahaz ni Jehoaddah a sak, Jehoaddah ni Alemeth, Azmaveth hoi Zimri a sak. Zimri ni Moza a sak.
  </para>
  <para style="p">
    <verse number="37" style="v" />Moza ni Binea a sak. Binea capa Rapha, Rapha capa Eleasah, Eleasah capa Azel.
  </para>
  <para style="p">
    <verse number="38" style="v" />Azel teh capa taruk touh ao teh, hotnaw e min teh Azrikam, Bokeru, Ishmael, Sheariah, Obadiah, Hanan. Ahnimanaw teh Azel casak seng doeh.
  </para>
  <para style="p">
    <verse number="39" style="v" />A hmaunawngha Eshek casak lah a camin te Ulam doeh, apâhni e teh Jeush, apâthum e teh Eliphelet.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ulam casaknaw teh a thakasai e, tarankahawi e, licung ka patuem thai e naw doeh. A canaw a pungdaw awh teh, a ca catounnaw abuemlah 150 touh a pha awh. Hetnaw pueng teh Benjamin casak seng doeh.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi teh, Isarelnaw pueng imthung lahoi separuinae teh, Isarel siangpahrangnaw cauk dawkvah a thut awh. Hateiteh, Judah teh yuemkamcu lah ao hoeh dawkvah, Babilon vah san lah a hrawi awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A coe awh e khonaw dawk hmaloe kaawm e naw teh Isarelnaw, vaihmanaw, Levihnaw, Nethinimnaw doeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem vah Judah casak, Benjamin casak, Ephraim hoi Manasseh casak naw hai kho a sak awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Judah capa Perez casak Bani, Benjamin capa Imri, Imri capa Omri, Omri capa Ammihud, Ammihud capa Uthai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Shiloh e a camin Asaiah hoi ahnie casaknaw,
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerah casak Jeuel hoi a hmaunawngha 690 touh a pha awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Benjamin casak Hassenuah capa Hodaviah, Hodaviah capa Meshullam, Meshullam capa Salu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jeroham capa Ibneiah, Uzzi capa Elah, Mikhri capa Uzzi, Shephatiah capa Meshullam, Reuel capa Sephatiah, Ibnijah capa Reuel.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahnimanaw teh a hmaunawnghanaw 956 a pha awh. Hetnaw pueng teh, miphun dawkvah imthung kahrawikungnaw doeh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vaihmanaw teh Jedaiah, Jehoiarib hoi Jakhin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cathut im dawk kahrawikung lah kaawm awh e Ahitub capa Meraioth, Meraioth capa Zadok, Zadok capa Meshullam, Meshullam capa Hilkiah, Hilkiah capa Azariah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jeroham capa Adaiah, Pashhur capa Jeroham, Malkhijah capa Pashhur, Adiel capa Maasai, Jahzerah capa Adiel, Meshullam capa Jahzerah, Meshillemith capa Meshullam, Immer capa Meshillemith.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahnimouh a hmaunawnghanaw hai a napanaw e imthung dawk a lû lah kaawmnaw doeh. Hotnaw teh Cathut im dawk thaw ka tawk thai awh e lah ao awh teh, tami 1760 touh a pha awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Levih, Merari casaknaw teh Hasshub capa Shemaiah, Azrikam capa Hasshub, Hashabiah capa Azrikam.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bakbakkar Heresh hoi Galal, Mikha capa Mattaniah, Zikhri capa Mikha, Asaph capa Zikhri.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shemaiah capa Obadiah, Galal capa Shemaiah, Jeduthun capa Galal, Asa capa Berekhiah, Elkanah capa Asa teh Netophah kho dawk kho a sak awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Longkha karingkungnaw teh Shallum, Akkub, Talmon hoi Ahiman. Shallum teh lû lah ao.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahni teh ha hoehnahlan vah, atunglah kaawm e lah ao. Ahnimouh teh Levih e catounnaw roenae hmuen longkha karingkungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kore capa Shallum, Ebiasaph capa Kore, Korah capa Ebiasaph hoi a hmaunawnghanaw. Mintoenaw e BAWIPA im dawk thaw katawknaw, kâennae longkha karingkungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Eleazar capa Phinehas teh BAWIPA ni a okhai teh kahrawikung lah ao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meshelemiah capa Zekhariah teh kamkhuengnae lukkareiim takhang ka ring e lah ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Longkha ka ring hanelah a rawi e naw teh, 212 touh a pha awh. Devit hoi Samuel ni a tawk awh hane a pouk e naw teh, mae kho lengkaleng a tâconae patetlah separuinae dawk thut e lah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hettelah amamouh hoi a catounnaw haiyah BAWIPA e lukkareiim longkha ka ring hanelah ao awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kanîtho, kanîloum, atunglah, akalah, petkâtue lah longkha karingkungnaw thaw poe lah ao.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khote lae a hmaunawnghanaw teh hnin sari touh thung hanelah hnin touh hoi hnin touh, a kâhlai awh vaiteh, meng a tho awh hane doeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bangkongtetpawiteh, longkha karingkungnaw pali touh teh Levihnaw doeh. Cathut e im dawk a hruek awh e hnopai karingkung lah ao awh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hottelah amom tangkuem longkha paawng e hah thaw poe e lah ao dawkvah, Cathut e im petkâkalup lah a roe awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tangawn ni thaw tawknae puengcangnaw a ring awh, a kuem awh, a la awh, ouk a touk awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tangawn teh hnopai hmuen kathoung dawk e puengcangnaw hah, tavai, misur, satui, hmuitui a kuemyawt awh teh a ring awh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Vaihma capa tangawn ni hmuitui hah ouk a sak awh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Korah tami Shallum e capa kacuepounge Levih tami Mattithiah teh vaiyei karê thaw a tawk.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kohath capanaw thung dawk hoi a hmaunawngha tangawn teh Sabbath hnintangkuem hanelah, vaiyei ka rakueng e lah ao.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hetnaw heh la ka sak e Levihnaw a na pa imthung kahrawikung, bawkim rakhan karingnaw, lah ao awh teh, alouke thaw kâbet awh hoeh. Bangkongtetpawiteh, karum khodai thaw katawknaw lah ao awh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Levih imthung kacuenaw teh, amamae se dawk kacue e lah Jerusalem vah pou ao awh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Gibeon na pa Jeiel, Jeiel teh Gibeon vah kho a sak teh, a yu min teh Maakah doeh.
  </para>
  <para style="p">
    <verse number="36" style="v" />A camin teh Abdon doeh. Hahoi Zur, Kish, Baal, Ner hoi Nadab.
  </para>
  <para style="p">
    <verse number="37" style="v" />Gedor, Ahio, Zekhariah hoi Mikloth naw a sak.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mikloth ni Shimeah a sak. Ahni hai Jerusalem vah a hmaunawnghanaw koe ao.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ner ni Kish a sak, Kish ni Sawl a sak, Sawl ni Jonathan, Malkhishua, Abinadab hoi Eshbaal a sak.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jonathan casak Meribbaal doeh, Meribbaal ni Maikah a sak.
  </para>
  <para style="p">
    <verse number="41" style="v" />Maikah casak teh Pithon, Melek hoi Tahrea.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahaz ni Jarah a sak, Jarah ni Alemeth, Azmaveth hoi Zimri a sak. Zimri ni Moza a sak.
  </para>
  <para style="p">
    <verse number="43" style="v" />Moza ni Binea a sak teh Binea capa Rephaiah, Rephaiah capa Eleasah, Eleasah capa Azel.
  </para>
  <para style="p">
    <verse number="44" style="v" />Azel teh capa taruk touh a tawn. A minnaw teh: Azrikam, Bokeru, Ishmael, Sheariah, Obadiah hoi Hanan doeh. Hetnaw teh Azel capanaw doeh.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Filistinnaw ni Isarelnaw a tuk awh teh, Isarelnaw teh tarannaw hmalah a yawng awh teh, Gilboa mon dawk thengpatheng lah a kamlei awh teh a due awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Filistinnaw ni Sawl hoi a capa hah, phat a pâlei awh teh, Sawl capa Jonathan, Abinadab, Malkhishua hah a thei awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sawl teh a tarannaw ni rek a pâlei awh teh, licung ka kathoum e ni pala hoi a ka awh teh hmâ a ca sak awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sawl ni amae senehmaica ka patuem e koevah, na tahloi hah rayu nateh, pawkkayawng lah na thun. nahoeh pawiteh, vuensom ka a hoehnaw ni lung na paroum nah awh langvaih atipouh. Hateiteh, amae senehmaica ka patuem e ni thun ngai hoeh. Bangkongtetpawiteh, a taki. Hatdawkvah, Sawl ni amahoima tahloi a vai teh a tabosin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Senehmaica ka patuem e ni Sawl a due toe tie hah, a hmu torei teh, ahni hai amahoima tahloi hoi a kâthei van.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sawl hoi a capanaw kathum touh a due awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tanghling dawk kaawm e Isarelnaw pueng teh, a yawng awh. Sawl hoi a capanaw a due toe tie a thai awh torei teh, kho a tâco takhai awh teh, a yawng awh. Hot dawkvah Filistinnaw ni ao na awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A tangtho vah Filistinnaw ni a thei awh e naw dawk, senehmaica hah la hanelah a cei awh navah, Gilboa mon dawk Sawl hoi a capanaw kadout e hah a hmu awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Senehmaica hah a rading awh teh, a lû hoi senehmaicanaw hah meikaphawk imnaw hoi a taminaw e meikaphawknaw koe pathang hanelah kamthang a pathang awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A senehmaica teh amamae cathut im dawk a hruek awh teh, a lû teh dagon im dawk a vo awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sawl dawk Filistinnaw ni a sak e naw hah Jabesh Gilead kaawmnaw pueng ni a thai awh torei teh,
  </para>
  <para style="p">
    <verse number="12" style="v" />tami tarankahawinaw ni a kamthaw sin awh teh, Sawl hoi a capa e ro hah a la awh teh, Jabesh kho lah a ceikhai awh teh, a hruhrawngnaw hah kathen kung rahim vah a pakawp awh. Hnin 7 touh thung rawcahai laihoi ao awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />BAWIPA taranlahoi a sak e, yuemkamcu lah ao hoeh kecu dawk Sawl teh a due. Bangkongtetpawiteh, BAWIPA e lawk hah tarawi laipalah, khueyuenu koe pouknae a hei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hateiteh, BAWIPA koe teh pouknae a hei hoeh dawkvah, ahni hah a due sak teh, a uknaeram hah Jesi capa Devit koe a poe pouh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isarelnaw pueng teh Hebron kho koe a tho awh. Khenhaw! kaimanaw teh na hru hoi na tak lah ka o awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hnuk lae atueng dawk Sawl a bawi nah haiyah, Isarelnaw ka tâcawtkhai e hoi kâenkhai e lah na o. BAWIPA Cathut ni nang koevah, ka tami Isarel tukhoumkung lah na o vaiteh, kahrawikung lah na o han ati telah atipouh awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hatdawkvah, Isarel kacuenaw pueng teh Hebron kho siangpahrang koe a tho awh teh, Devit ni Hebron kho BAWIPA e hmalah, ahnimouh hoi lawkkamnae a sak. Samuel hno lahoi BAWIPA e lawk patetlah Isarel siangpahrang hanelah Devit teh satui a awi awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Devit hoi Isarelnaw pueng teh Jubusitnaw khosaknae Jerusalem lah a cei awh. Jerusalem teh Jebusitnaw khosaknae doeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jebusit kho kaawmnaw ni Devit hi vah khoeroe kâen hanh, telah atipouh awh. Hateiteh, Devit ni Zion rapanim a lawp pouh teh Devit khopui tie lah ao.
  </para>
  <para style="p">
    <verse number="6" style="v" />Devit ni Jubusitnaw hmaloe ka tuk e teh, ransabawi hoi kahrawikung lah ao han telah ati. Hatdawkvah, Zeruiah capa Joab teh hmaloe poung lah a cei teh kahrawikung kacue lah a sak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Devit teh rapanim thung lah kho a sak dawkvah, Devit khopui ati awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Millo e hmuen koehoi khopui petkâkalup lah rapan teh a kangdue. Joab ni khopui pueng hah a pathoup.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hatdawkvah, Devit teh hoehoe a len teh, ransahu BAWIPA ahni koevah ao.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hetnaw teh Devit ni a tawn e thakaawme taminaw doeh. Isarelnaw pueng hoi ama hoi a uknaeram hanlah amamouh hoi amamouh tha a kâpoe awh teh, Isarel kong dawk BAWIPA e lawk patetlah siangpahrang o thai nahanelah kangdoutkhainaw doeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hetheh Devit ni a tawn e tami athakaawme taminaw doeh. Hakmonite tami e capa Jashobeam, tami 30 touh e hu kahrawikung, tahroe a patuep teh vai touh hoi tami 3,00 ka thet e doeh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahni hnukkhu hoi Aho tami Dodo e capa Eleazar tami athakaawme taminaw 3 touh dawkvah, buet touh lah ao.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahni teh Pasdammim e hmuen Devit koevah ao. Hawvah Filistinnaw teh, tarantuk hanelah a kamkhueng awh teh, hawvah catun hoi kakawi e tanghling ao. Taminaw pueng teh Filistinnaw e hmalah a yawng awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hatei, ahnimouh teh, law lungui hmuen a la teh Filistinnaw a thei awh. Hottelah BAWIPA ni kalentoenaw, tânae a kamnue sak.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ransa 30 touh thung dawk e tami a thakasai e tami 3 touh teh Adullam lungngoum, Devit onae lungsong koe a cathuk awh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hatdawkvah, Devit teh rapanim thungup ao. Filistin ransanaw teh Bethlehem vah ao awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Devit ni a rabuipoung teh, Bethlehem tuikhu dawk e tui, rapan longkha teng e hah ka nei hanelah na ka poe thai e awm pawiteh, ka ngaipoung eite telah a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ransa kathum touh ni Filistin ransanaw a roenae hah pat a rakan awh teh, rapan longkha teng e Bethlehem tuikhu dawk e tui hah a do awh teh, Devit koevah a thokhai awh. Hateiteh, Devit ni net ngai hoeh. BAWIPA hanelah a rabawk.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahni ni, Oe BAWIPA hethateh khoeroe ka net mahoeh. Athakaawme taminaw kathum touh ni a sak e hno doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joab e a nawngha Abishai teh, kathum touh thung dawk e kacue lah ao. Tami 300 touh hah tahroe hoi a thei dawkvah, tami kathum touh thung dawk e a min kamthang e lah ao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tami kathum touh thung dawk ahni teh kahni touh hlak oup hanelah ao. Hatdawkvah kacuepoung lah ao. Hateiteh, hmaloe e kathum touh dawkvah bawk hoeh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jehoiada e capa Benaiah teh, Kabzeel kho e tami thakaawme capa hno moikapap ka sak e lah ao. Ahni ni sendek patetlah athakaawme Moab tami tarankahawi e kahni touh a thei. Hahoi bout a cei teh, tadamtui a bo nah a khu dawk kaawm e sendek buet touh bout a thei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka rasang katang e Izip tami dong 5 touh e hah a thei. Izip tami e kut dawk hni kawng kalawng tittouh e tahroe hah a patuep. Benaiah sonron hoi a yawng sin teh, Izip tami e kut dawk e tahroe hah a lawp teh hote tahroe hoi letlang a thei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hete hnonaw hah Jehoiada e capa Benaiah ni a sak e, tami a thakasai kathum touh dawkvah barinae a poe awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tami 30 touh hlakvah bari kamcu lah ao katang. Hateiteh, hmaloe kathum touh koe bawk thai hoeh. Hahoi Devit ni ama karingkungnaw thung dawk kacuelah a ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Athakaawme ransanaw teh: Joab e hmaunawngha Asahel, Bethlehem kho e tami Dodo e capa Elhanan tinaw doeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Harorite tami Shammoth, Pelonit tami Helez.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tekoa tami Ikkesh capa Ira, Anathoth tami Abiezer.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hushath tami Sibbekhai hoi Ahoh tami Ilai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Netophah tami Maharai hoi Netophah tami Baanah capa Heled.
  </para>
  <para style="p">
    <verse number="31" style="v" />Benjamin casak Gibeah tami Ribai capa Ittai. Pirathon tami Benaiah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Gaash yawn e Hurai hoi Arbath tami Abiel.
  </para>
  <para style="p">
    <verse number="33" style="v" />Baharum tami Azmaveth hoi Shaalbim tami Eliahba.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gizon tami Hashem casaknaw dawkvah Hararite tami Shagee capa Jonathan.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hararite tami Sakar capa Ahiam, Ur capa Eliphal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mekerath tami Hepher hoi Pelonit tami Ahijah.
  </para>
  <para style="p">
    <verse number="37" style="v" />Karmel tami Hezro hoi Ezbai capa Naari.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nathan e hmaunawngha Joel hoi Hagri capa Mibhar.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ammon tami Zelek hoi Zeruiah capa Joab senehmaica ka sin pouh e Beeroth tami Naharai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ithrite tami Ira hoi Ithrite tami Gareb.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hit tami Uriah hoi Ahlai capa Zabad.
  </para>
  <para style="p">
    <verse number="42" style="v" />Reuben tami Shiza capa Adina hoi ama koe kaawm e tami 30 touh kahrawikung lah ao.
  </para>
  <para style="p">
    <verse number="43" style="v" />Maakah capa Hanan hoi Mithini tami Joshaphat.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ashtrarity tami Uzzia, Shamma, Jeuel hoi Jeiel. Aroerite tami Hotham casaknaw.
  </para>
  <para style="p">
    <verse number="45" style="v" />Shimri capa Jediael hoi a nawngha Tizit tami Joha.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mahavit tami Eliel, Jeribai, Elnaam casak Joshavi, Moab tami Ithmah.
  </para>
  <para style="p">
    <verse number="47" style="v" />Eliel, Obed hoi Mezobah tami Jaasiel.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kish capa Sawl koehoi Devit a yawng teh Ziklag kho ao nah, ahni koe ka tho e naw teh, hetnaw hah doeh. Ahnimouh teh tarantuknae koe lah ama kabawm e tami athakaawme taminaw doeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Likathoumnaw lah ao awh teh, samtang ka pathui thai e, tâyai ka dei thai e, avoilah aranglah hoi ka thoum e naw lah ao awh. Ahnimanaw teh Benjamin taminaw, Sawl e a imthungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahnimouh kahrawikung lah Ahiezer doeh. Ahni hnuk Gibeah tami Shemaah casak Joash, Jeziel, Azmaveth casak Pelet, Berakah, Anathoth tami Jehu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tami 30 lathueng hoi 30 rahak dawk e athakaawme Gibeon tami Ishmaiah, Jeremiah hoi Jahaziel, Johanan hoi Gederath tami Jozabad.
  </para>
  <para style="p">
    <verse number="5" style="v" />Eluzai, Jerimoth, Bealiah, Shemariah, Haruph tami Shephatiah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Elkanah, Isshiah, Azarel, Joezer hoi Korah tami Jashobeam.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joelah hoi Gedor tami Jeroham capa Zebadiah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gad taminaw dawk hoi athakaawme taminaw, taran ka tuk thai, saiphei hoi tahroe ka hno thai tangawn hah kahrawngum e rapanim dawk kaawm e Devit koe a kâhmoun awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Apasueke teh Ezer, apâhni e teh Obadiah, apâthum e teh Eliab.
  </para>
  <para style="p">
    <verse number="10" style="v" />Apali e teh Mishmannah, apanga e teh Jeremiah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ataruk e teh Attai, asari e teh Eliel.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ataroe e teh Johanan, atako e teh Elzabad.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hra e teh Jeremiah, a hlaibun e teh Makhbannai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hetnaw teh Gad casaknaw thung hoi e doeh. Ahnimouh thung dawk hoi a thakayoun e tami 100 tabang ao. A thakaawme 1000 tabang ao.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hotnaw teh thapa yung pasueknae dawk Jordan palang tuiko muenkawi nah ka rakat thai e naw, hahoi tanghling dawk kaawm e pueng kanîtholah hoi kanîloumlah ka yawng sak e naw doeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Benjamin hoi Judah casaknaw thung hoi rapanim koe Devit teng a tho awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Devit ni ahnimouh dawn hanelah a cei teh, roumnae hane dawkvah, kabawp hanelah na tho awh pawiteh, ka lungthin na poe awh han. Hateiteh, ka kut ni runae banghai sak hoeh tie na panue nalaihoi, kai pahnawt hanelah na tho awh pawiteh, mintoenaw e Cathut ni na khet vaiteh lawk na ceng awh naseh, telah atipouh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hottelah tami 30 touh thung dawk e kahrawikung Amasai tak dawk muitha a tho teh, Devit na tami lah ka o awh. Jesi capa nang koe lah kampang e naw doeh. Nang dawk roumnae awm naseh. Bangkongtetpawiteh, na Cathut ni na kabawp tet loe atipouh. Hatdawkvah, Devit ni ahnimouh a la teh ransahu ka hrawi e lah ao sak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Filistinnaw hai Sawl tuk hanelah a cei awh navah, Manasseh e tami tangawn hai Devit koelah a cei awh. Ama hoi a taminaw ni Filistinnaw koelah kabawm awh hoeh. Amamae bawi Sawl koelah kamlang awh vaiteh, maimae lû tâkhawng payon langvaih telah a kâpan awh teh a ban sak awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ziklag a cei awh navah, Manassehnaw thung hoi ransa 1000 ka hrawi e Adnah hoi Jozabad, Jediael hoi Michael, Jozabad, Elihu hoi Zillethai naw teh ahni koe ao awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hetnaw teh Devit taran tuk navah, kabawm e naw lah ao awh. Bangkongtetpawiteh, abuemlah hoi athakaawme taminaw teh, kahrawikungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hatnae tueng dawk hoi Devit kabawm hane hnin touh hoi hnin touh meng a tho awh teh, Cathut e ransahu patetlah kalenpounge ransahu lah a coung.
  </para>
  <para style="p">
    <verse number="23" style="v" />BAWIPA e lawk patetlah Sawl uknaeram hah Devit koe lah a kamlang teh, Hebron vah Devit koe e tarantuknae puengcang kâmahrawk hanelah kacetnaw teh, hettelah ao.
  </para>
  <para style="p">
    <verse number="24" style="v" />Judah capanaw puengcang kâmahrawknaw, saiphei hoi tahroe ka patuem e tami 6, 800 touh a pha awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Simeon e capanaw tarantuknae koe athakaawme taminaw teh 7, 100 a pha awh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Levih e casaknaw 4, 600.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jehoiada teh Aron imthung kahrawikung lah ao teh, ahni koe tami 3700 touh ao awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thoundoun Zadok teh tami athakaawme, a imthung dawk ransanaw kahrawikung 22 touh ao.
  </para>
  <para style="p">
    <verse number="29" style="v" />Benjamin e capanaw Sawl imthung lah kaawm e 3000 touh a pha. Ha hoehnahlan vah ka paphnawn teh Sawl koelah a kampang awh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ephraim capanaw tami athakaawme hoi tarankahawi imthung dawk hoi 20, 800 touh a pha awh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Manasseh casak tangawn dawk hoi Devit siangpahrang lah ao thai nahane ka tho e naw teh 18, 000 touh a pha.
  </para>
  <para style="p">
    <verse number="32" style="v" />Issakhar capa tueng navah, ka panuek thai e hoi, Isarel ni bangmaw a sak hane telah ka panuek thai e, kahrawikung 200 touh a pha. A hmaunawngha abuemlah amae uknae rahim vah ao awh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zebulun imthungnaw dawk hoi taran ka tuk thai e, senehmaica ka patuem ni teh ka bouk thai e 50, 000 a pha awh teh lungthin kacue e lah ao awh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Naphtalinaw imthung hoi ransa ka hrawi e 1, 000 touh, saiphei, tahroe ka patuem e 37, 000 touh a pha.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dan imthung dawk hoi senehmaica ka patuem e 28, 600 touh a pha.
  </para>
  <para style="p">
    <verse number="36" style="v" />Asher imthung dawk hoi taran ka tuk thai e, bouk ka thoum e 40, 000 touh a pha.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jordan namran e Reuben taminaw, Gad taminaw hoi Manasseh casak tangawn koehoi hai puengcang phunkuep hoi kamthoup e tami 120, 000 touh a pha.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hotnaw pueng teh taran ka tuk e, bouk ka thoum e naw lah ao awh. Devit teh Isarelnaw pueng dawkvah, siangpahrang lah ao hane lungthin buet touh lah a tawn teh, Hebron lah a cei awh. Isarel alouknaw pueng nihai, Devit teh siangpahrang lah o sak hanelah lungthin buet touh lah ao awh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Devit koevah, hnin thum touh thung a canei awh. Bangkongtetpawiteh, a hmaunawnghanaw ni a rakueng pouh e doeh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hothloilah, imthung hmaunawnghanaw, Issakhar, Zebulun hoi Naphtali la hoi kalauk hoi marang, maitotan naw, ca hane vaiyei, hoi thai pawnaw, misurtui hoi satuinaw, a phu awh teh, maitotan hoi tu, moikapap a thokhai awh. teh Isarel ram dawk lunghawinae a kawi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Devit ni kahrawikungnaw pueng koe, 1, 000 kaukkungnaw hoi, 100 touh kaukkungnaw koe pouknae a hei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Devit ni kamkhueng e Isarelnaw koe, ahawi na tet awh boilah, BAWIPA Cathut a ngainae awm pawiteh, Isarel ram thung e hmaunawngha kaawm e naw pueng, tengpam e kho kaawm e pueng, vaihmanaw hoi Levih taminaw hai maimouh koe cungtalah kamkhueng hanelah, coun awh sei atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cathut e thingkong hah maimouh koe bankhai awh sei. Bangkongtetpawiteh, Sawl a bawi hoi teh, a lawkpui lah pouk awh hoeh toe telah ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kamkhueng e pueng ni hottelah sak e hah hnâ rip a bo khai. Bangkongtetpawiteh, hot teh tami pueng pouknae dawk ka kalan e doeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hatdawkvah, Devit ni Izip palang Shihor, hoi Hamath kâennae totouh Isarelnaw hah Kiriathjeaream e Cathut e thingkong hah bankhai hanelah a kamkhueng sak awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatdawkvah, Devit hoi tami pueng teh, Judah ram e Baalah Kiriath-Jeaream ati awh e koevah, cherubim dawkvah, ka tahung e BAWIPA min a onae lawkkam thing kong la hanelah a cei awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cathut e thingkong teh, Abinadab im e hah leng ka tha hoi a ceikhai awh. Uzzah hoi a hui ni leng teh a mawng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Devit hoi Isarelnaw pueng ni la sak na laihoi ratoung hoi tamawi hoi mawngleng hoi cecak hoi mongka hoi Cathut hmalah a thaonae puenghoi a tumkhawng awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kidron cangkatinnae koe a pha awh navah, maitonaw ni thingkong a kâhuet sak dawkvah, Uzzah ni thingkong hah kuet hanelah a kut a kâyap.
  </para>
  <para style="p">
    <verse number="10" style="v" />BAWIPA e lungkhueknae teh Uzzah tak dawk vai touh hoi a pha teh, thingkong a kuet kecu dawkvah a thei teh, Cathut hanlah a due.
  </para>
  <para style="p">
    <verse number="11" style="v" />Uzzah tak dawk BAWIPA e lungkhueknae a pha dawkvah, Devit teh a lungkhuek. Hote hmuen teh sahnin totouh Perezuzzah telah a phung awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hat na hnin hoi Devit ni Cathut teh a taki. Bangtelah hoi maw Cathut e thingkong teh ka bankhai thai han telah ati.
  </para>
  <para style="p">
    <verse number="13" style="v" />Devit ni thingkong teh Devit khopui a ma koe hrueng laipalah Git tami Obededom im vah a hruek.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cathut e thingkong teh Git tami Obededom imthung vah thapa yung thapa yung thum touh ao. Obededom e a tawn e naw pueng teh BAWIPA ni yawhawinae a poe.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Taire siangpahrang Hiram ni, Devit koevah patounenaw a patoun. Ahni hane im sak pouh hanelah, Sidar thing hoi talungdêikathoum e, hoi im sak ka thoum e naw hah a patoun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Isarelnaw dawk siangpahrang lah BAWIPA ni a caksak tie hah Devit ni a kâpanue. Bangkongtetpawiteh, Isarelnaw kecu dawkvah, a uknaeram hah ka rasang poung lah tawmrasang e lah ao.
  </para>
  <para style="p">
    <verse number="3" style="v" />Devit ni Jerusalem vah a yu alouknaw hai a la teh, ca napui tongpa moi a sak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jerusalem vah a sak e a canaw teh Shammua, Shobab, Nathan hoi Solomon.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ibhar, Elishua hoi Eliphelet.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nogah, Nepheg hoi Japhia.
  </para>
  <para style="p">
    <verse number="7" style="v" />Elishama, Beeliada hoi Eliphelet.
  </para>
  <para style="p">
    <verse number="8" style="v" />Filistinnaw ni Devit teh Isarelnaw e siangpahrang lah satui awi lah ao toe tie a thai awh torei teh, Filistinnaw pueng ni Devit tawng hanelah a cei awh. Devit ni a thai toteh, ahnimouh tuk hanelah a kamthaw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Filistinnaw hah Rephaim tanghling dawk a yawng awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Devit ni Filistinnaw tuk hanelah ka cei han maw, ka kut dawk na poe han maw, telah BAWIPA a pacei. BAWIPA ni cet leih, ahnimouh teh na kut dawk na poe han telah atipouh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hatdawkvah, Baalperazim vah a cei awh teh, Devit ni ahnimouh teh a tuk teh a tâ awh. BAWIPA ni ka tarannaw teh tuicapa ka thaw e a roum sak e patetlah be a raphoe telah ati. Hatdawkvah, hote hmuen teh Baalperazim telah min a phung.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hete hmuen koe meikaphawknaw hah a cettakhai awh. Devit ni kâ a poe teh, hmai koung koung a sawi pouh awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Filistinnaw teh tanghling dawk bout a yawng awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hahoi Devit ni Cathut koe bout a pacei teh, ahnimanaw pâlei hanelah cet hanh. Kingkalup awh nateh, batuekung koe pawm awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hahoi hettelah ao han. Batuekung e a van a cei awh e a pâlawk na thai awh toteh, tuk hanelah na tâco awh han. Bangkongtetpawiteh, Filistinnaw roenae tuk hane na hmalah Cathut a tho tie hah na panue han atipouh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cathut ni kâ a poe e patetlah Devit ni a sak teh, Filistin e ransanaw hah, Gibeon hoi Gezer totouh a pâlei awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hottelah ram pueng dawk Devit e min a kamthang teh, BAWIPA ni ama takinae hah miphun tangkuem koe a kamthang sak
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Devit ni Devit khopui vah ama hane im a sak teh Cathut e thingkong ao nahane hmuen hah a rakueng pouh teh lukkareiim a yap pouh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Devit ni Cathut e thingkong heh Levihnaw hoeh laipalah teh, apinihai kâkayawn thai mahoeh. Bangkongtetpawiteh, Cathut e thingkong teh meng kâkayawt hane hoi a thaw ka tawk hanelah BAWIPA ni a rawi e naw doeh telah a ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Devit ni BAWIPA e thing kong ta nahane a rakueng pouh e hmuen koevah, ceikhai hanelah Jerusalem vah Isarelnaw pueng a pâkhueng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hatdawkvah, Devit ni Aron e casaknaw hoi Levih casaknaw hah a pâkhueng. awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kohath e casaknaw thung kacuepoung e Uriel hoi a hmaunawngha 120 touh a pha
  </para>
  <para style="p">
    <verse number="6" style="v" />Merari casaknaw thung kacuepoung e Asaiah hoi a hmaunawnghanaw 220 touh a pha awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershom e casaknaw thung dawk kacuepoung e Joel hoi a hmaunawnghanaw 130 touh a pha awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Elizaphan casaknaw thung dawk kacuepoung e Shemaiah hoi a hmaunawnghanaw 200 touh a pha awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hebron casaknaw thung dawk kacuepoung e Eliel hoi a hmaunawnghanaw 80 touh a pha awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uziel casaknaw thung dawk kacuepoung e Aminadab hoi a hmaunawnghanaw 112 touh a pha awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Devit ni vaihma Zadok, Abiathar, Levih, Uriel, Asaiah, Joel, Shemaiah, Eliel, hoi Aminadab tinaw hai a kaw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nangmanaw teh Levihnaw thung dawk kacuepoung lah na o awh. Isarel BAWIPA Cathut e thingkong hah ka rakueng e hmuen koevah, thokhai hanelah nama hoi na hmaunawnghanaw kamthoung awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahmaloe e dawk hai nangmouh ni na kâkayawt awh hoeh dawkvah BAWIPA Cathut ni mamouh dawk a lungkhueknae a pha sak. Bangkongtetpawiteh, amae lamthung patetlah sak hane hah ama koe pacei awh hoeh telah a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hatdawkvah, Isarel BAWIPA Cathut e thingkong hah kâkayawt hanelah vaihmanaw hoi Levihnaw hah a kamthoung awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />BAWIPA kâpoe e Mosi ni a dei e patetlah Levihnaw ni a loung dawk hoi thingkong teh a kâkayawt awh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Devit ni Levih kacuenaw hah a hmaunawngha thung dawk hoi la ka sak hane, ratoung ka tum hane, tamawi, cecak, hoi kacaipounglah tumkhawng vaiteh, lunghawi nalaihoi la sak hanelah a dei pouh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hatdawkvah, Levihnaw ni Joel capa Heman hoi a hmaunawngha thung hoi Berekhiah e capa Asaph, a hmaunawngha Merari e capanaw thung hoi Kushaiah capa Etham hah a rawi awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmaunawnghanaw thung hoi Zekhariah casak Jaaziel, Shemiramoth, Jehiel, Unni, Eliab, Benaiah, Maaseiah, Mattithiah, Eliphelehu, Mikneiah, Obededom hoi tho ka ring e Jeiel tinaw a rawi awh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hatdawkvah, la ka sak hane Heman, Asaph, Ethan, hah cecak kacaipounglah tumkhawng hanelah a rawi awh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zekhariah, Aziel, Shemiramoth, Jehiel, Unni, Eliab, Maaseiah, Benaiah teh Alamoth lawk hoi ratoung tum hanelah a rawi awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mattithiah, Eliphelehu, Mikneiah, Obededom, Jeiel, Azaziah teh Sheminith lawk lahoi tamawi hoi hrawi hanelah a rawi awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Levihnaw kacue e Kenaniah, teh la sak a thoum la kahrawikung lah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Berekhiah hoi Elkanah teh thingkong tho karingkung lah ao roi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vaihmanaw Shebaniah, Joshaphat, Nethanel, Amasai, Zekhariah, Benaiah hoi Eliezer naw ni Cathut e thingkong hmalah mongka a ueng awh. Hahoi, Obed-edom hoi Jehiah teh thingkong e longkha karingkung lah ao awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hahoi Devit hoi Isarel kacuenaw ransa 1000 kauknaw teh Obededom im e BAWIPA thingkong la hanelah, lunghawi nalaihoi a cei awh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hatdawkvah, BAWIPA thingkong kâkayawn e Levihnaw hah, Cathut ni a kabawp teh maitotan sari touh hoi, tutan sari touh hoi thuengnae a sak awh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Devit hoi thingkong kâkayawn e Levihnaw pueng, la kasaknaw, la ka hrawi e Kenaniah naw teh, lukkarei loukloukkaang e hoi a kamthoup awh. Devit hai lukkarei loukloukkaang e vaihma angki hah a kho.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hottelah mongka hoi tu ki hoi, cecak lawk hoi a parawi awh teh, Isarelnaw pueng ni, hramki nalaihoi, BAWIPA lawkkam thingkong a ceikhai awh teh, la puenghoi a sak awh teh, ratoung tamawi kacaipounglah a tumkhawng awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hahoi BAWIPA lawkkam thingkong Devit kho dawk a kâenkhai awh navah, Sawl e canu Mikhal ni hlalangaw koehoi a khet navah, siangpahrang Devit a lamtu laihoi a cawkdawk e hah a hmu teh, a lungthung hoi a panuikhai.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hottelah Cathut e thingkong teh a thokhai awh teh, hruek nahanelah Devit ni rim a yap pouh e dawkvah a hruek awh. Hmaisawi thuengnae, roum thuengnae naw hah Cathut koe e poe awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Devit ni hmaisawi thuengnae, roum thuengnae naw hah a poe hoiyah BAWIPA e min lahoi taminaw hah yawhawinae a poe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Isarelnaw pueng teh, napui tongpa abuemlah vaiyei atueng buet touh hoi moituen buet touh, misurphen buet touh rip a poe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Isarel BAWIPA Cathut pahnim hoeh nahan, lunghawilawk dei e, hoi pholen nahanelah, BAWIPA e thingkong hmalah, thaw ka tawk lah Levihnaw tangawn hah a rawi awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kahrawikung lah Asaph, apâhni lah ratoung ka kueng e Zekhariah, Jeiel, Shemiramoth, Jehiel, Mattithiah, Eliab, Benaiah, Obededom, Jeiel ni ratoung hoi tamawi a tum, Asaph cecak a khawng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vaihma Benaiah hoi Jahaziel ni Cathut e lawkkam thingkong e hmalah mongka kamrawicalah a ueng roi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hot nah hnin hoi BAWIPA koe lunghawilawk dei hane Devit ni hete la heh Asaph hoi a hmaunawngha koe hmaloe poung lah a poe.
  </para>
  <para style="p">
    <verse number="8" style="v" />Oe BAWIPA koevah lunghawilawk dei awh nateh, a min lahoi hram awh. Miphunnaw pueng koe a sak e hno hah panuek sak awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama koe la sak awh haw, oupnae hoi ama teh pholen awh. A sak e hno kângairunae pueng hah dei awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A min kathoung hah oup awh. BAWIPA ka tawng e naw a lungthinnaw teh hawi awh naseh.
  </para>
  <para style="p">
    <verse number="11" style="v" />BAWIPA e thasainae tawng awh haw, A minhmai hah hoe tawng awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A sak e kâgairu hnonaw hah pahnim awh hanh. A sak e kângairunae hoi a pahni dawk hoi lawkcengnae hai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Oe a san Isarel catounnaw, a rawi e tami Jakop catounnaw,
  </para>
  <para style="p">
    <verse number="14" style="v" />Ama teh BAWIPA Cathut lah ao. A lawkcengnae teh talai van abuemlah dawk kâ a tawn.
  </para>
  <para style="p">
    <verse number="15" style="v" />A lawk kam hah a yungyoe pâkuem awh haw, se 1000 totouh lawk a kam e naw hah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham koe lawk a kam e naw hah, Isak koe lawk a kam e naw hah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hot patetlah Jakop koe kâlawknaw a cak sak, Isarelnaw koe yungyoe e lawkkam pouh e hah a cak sak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kanaan ram teh na coe e râw lah na poe awh han telah a ti.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tami kayounca lah na o awh, Oe tami younca, imyin patetlah ka o awh navah,
  </para>
  <para style="p">
    <verse number="20" style="v" />miphun tangkuem koe hmanghmang kâva e lah, uknaeram tangkuem hoi miphun tangkuem koe,
  </para>
  <para style="p">
    <verse number="21" style="v" />Apinihai ka pacekpahlek hanlah pasoung hoeh. Ahnimouh kecu dawk siangpahrangnaw hai a yue awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Satui ka awi e hah tek awh hanh awh, kaie profetnaw hah patawnae poe awh hanh haw telah a ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Talai taminaw pueng ni BAWIPA pholennae la sak awh nateh, hnintangkuem vah rungngangnae lawk hah pathang awh haw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Miphun tangkuem koe a bawilennae hah dei awh nateh, tami tangkuem koe a sak e kângairunae pathang awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />BAWIPA teh a bawilen poung dawkvah, pholen hanelah ao. Ama teh Cathut pueng hlak vah taki hanelah ao.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bangkongtetpawiteh, miphun alouke cathutnaw teh, meikaphawknaw doeh. Hateiteh, BAWIPA ni kalvan teh a sak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Barinae hoi taluenae teh a hmalah ao. A thaonae hoi lunghawinae ama koe ao.
  </para>
  <para style="p">
    <verse number="28" style="v" />Oe miphunnaw hoi imthungnaw pueng BAWIPA koe poe awh, BAWIPA koe bawilennae hoi a thasainae hah poe awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />BAWIPA teh a min hoi kamcu e bawilennae poe awh. Poe hanlah kaawm e pueng sin awh nateh, a hmalah tâcawtkhai awh. A meihawinae thoungnae hoi BAWIPA teh bawk awh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Talai taminaw pueng amae hmalah pâyaw awh. Kâhuet thai hoeh nahanlah talaivan teh a cak sak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kalvannaw hai lunghawi naseh, talai hai lunghawi naseh, BAWIPA ni a uk telah miphun tangkuem koe pathang awh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuipui hoi a thung kaawm e pueng ni hram awh naseh, law hoi a thung kaawm e pueng ni lunghawi awh naseh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kahrawng e thing kaawm e pueng ni BAWIPA e hmalah lunghawi nalaihoi la a sak awh han. Bangkongtetpawiteh, talai dawk lawkceng hanelah a tho han.
  </para>
  <para style="p">
    <verse number="34" style="v" />Oe BAWIPA koevah, lunghawinae lawk dei awh. Bangkongtetpawiteh, ama teh ahawi. A lungmanae teh a yungyoe a kangning.
  </para>
  <para style="p">
    <verse number="35" style="v" />Oe kaimae Rungngangnae Cathut na rungngang haw, ka thoung e na min pholen hane hoi, na pholennae hoi tâ hanelah, Jentelnaw thung hoi na rungngang haw. Cungtalah na pâkhueng haw tet awh naseh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Yungyoe hoi yungyoe totouh Isarel BAWIPA Cathut teh, pholennae awm lawiseh, tami pueng ni Amen ati awh teh, BAWIPA teh a pholen awh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hatdawkvah, BAWIPA lawkkam thingkong hma lae hnintangkuem a panki e patetlah thaw ka tawk hane Asaph hoi a hmaunawnghanaw a ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Obededom hoi a hmaunawngha 68 touh ni a kabawp awh vaiteh, Jeduthun capa Obededom hoi Hosah teh longkha ka ring hanelah ao han.
  </para>
  <para style="p">
    <verse number="39" style="v" />BAWIPA ni Isarelnaw kâ a poe BAWIPA e kâlawk dawk thut e patetlah hmaisawi thuengnae khoungroe dawkvah, amom tangmin Gibeon hmuenrasang dawk,
  </para>
  <para style="p">
    <verse number="40" style="v" />BAWIPA e lukkareiim hmalah, sathei thuengnae meng ka poe hanelah, vaihma Zadok hoi a hmaunawngha vaihma lah a rawi awh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amae pahrennae teh, a yungyoe a kangning dawkvah, BAWIPA koe lunghawi lawk dei hanelah, Heman hoi Jeduthun, hoi alouke taminaw hoi rawi e lah ao awh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Heman hoi Jeduthun teh mongka cecak, kacai e phunkuepnaw hoi cungtalah tumkhawng hane ka khenyawn hanelah ao awh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hahoi tami pueng teh ama im lengkaleng a ban awh teh, Devit hai a imthungkhunaw yawhawi poe hanelah a ban van.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi Devit teh im ao nah profet Nathan koe Devit ni khenhaw! kai teh sidar thing im dawk ka o. Hateiteh BAWIPA lawkkam thingkong teh lukkarei rim dawk ao telah atipouh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nathan ni Devit koe, na lungthin dawk kaawm e patetlah sak yawkaw, bangkongtetpawiteh, nang koe Cathut ao telah atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hateiteh, hatnae karum dawkvah, Nathan koe Cathut e lawk teh a tho.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka san Devit hah dei pouh. BAWIPA ni hettelah ati. Ka o nahanelah nang ni im na sak pouh mahoeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bangkongtetpawiteh, Isarelnaw Izip ram hoi ka tâcokhai hnin hoi atu totouh im dawk awm laipalah lukkarei rim hoi buet touh hoi buet touh ka kampuen teh ouk ka o.
  </para>
  <para style="p">
    <verse number="6" style="v" />Isarelnaw hoi ka ceinae tangkuem dawk hai ka taminaw khoum hanelah kâ na poe e Isarelnaw lawkcengkungnaw koevah, bang dawk maw sidar thing im sak pouh hoeh telah ka ti boihoeh vaw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hatdawkvah, ka san Devit koe hettelah na dei pouh han. ransahu BAWIPA ni hettelah a dei. Tu pânae hmuen tu na khoumnae koehoi ka tami Isarelnaw dawk siangpahrang lah o hane na la teh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Na cei nah tangkuem dawk nang koe ka o. Na tarannaw hai na tâ pouh, talai dawk ka lentoe poung e na min ka lentoe sak han.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hothloilah, ka tami Isarelnaw hane hmuen ka rawi vaiteh, yuengyoe kampuen toung laipalah, amamae hmuen koe kho a sak thai nahanelah, ahnimouh teh ka ung han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Yampa hai ka tami Isarelnaw dawk lawkcengkung ka ta pouh nah hai, kahawihoehe canaw ni rep a coungroe awh e patetlah runae poe awh laipalah, na tarannaw pueng hai koung ka sung sak han. Hothloilah, BAWIPA ni na imthungnaw a kangdue sak han telah na dei pouh awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hahoi na hnin a pout torei na mintoenaw koe na cei navah, hettelah ao han. Nama dawk hoi ka tâcawt e na capa buet touh ni a kangdue vaiteh, a uknaeram ka caksak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahni ni im na sak pouh vaiteh, a bawitungkhung hai a yungyoe ka caksak han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hattorei a na pa lah ka o vaiteh, ahni hai ka capa lah ao han. Nang koe ka lungma e ka lae patetlah ahni koe e bout ka lat mahoeh toe.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka im hoi ka uknaeram teh ahni koe yungyoe ka caksak han. A bawitungkhung hai a yungyoe ka caksak han telah ati.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hete lawknaw pueng hoi vision pueng teh, Nathan ni Devit koe a dei pouh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hatdawkvah, siangpahrang Devit ni a kâen teh, BAWIPA e hmalah a tahung nah laihoi, Oe BAWIPA Cathut, bangpatet lae tami lah maw ka o teh, ka imthung hai bangpatet lae tami lah maw ao awh teh, hettelah totouh na tawm teh na hrawi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Oe Cathut hete hno heh na mit dawk hno kathoengcae doeh. Hahoi Oe BAWIPA Cathut, na san imthung hma lae kong hah kum moikasaw hane na dei toung dawkvah, kangduenae hmuen ka rasang e tami buet touh lah na pouk.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na san bari lah onae kong dawkvah, Devit ni nang koe bangmaw ka dei han rah, bangkongtetpawiteh, na san hah na panue.
  </para>
  <para style="p">
    <verse number="19" style="v" />Oe BAWIPA, na san kecu dawk na lungthin dawk kaawm e patetlah ka lentoe e hno na sak teh, tami pueng na panue sak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Oe BAWIPA, hnâ hoi ka thainae dawkvah, nama patetlae khoeroe awm hoeh. Nama laipalah Cathut alouke khoeroe awm hoeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izip ram hoi na ratang e taminaw e hmalah, Jentelnaw na pâlei e hnin ka lentoe e hah, kângairunae na sak e dawk hoi, namae min lentoenae kamnue sak hanelah, Cathut ni amae tami lah o thai nahanelah ratang han a ngai e Isarelnaw patet e talai van miphun alouke ao boimaw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bangkongtetpawiteh, na tami Isarelnaw teh yungyoe na tami lah o hane na sak e doeh. Hatdawkvah, nama teh ahnimae BAWIPA Cathut lah na o.
  </para>
  <para style="p">
    <verse number="23" style="v" />Oe BAWIPA, na san kong hoi na imthung kong dawkvah, na dei e teh, yungyoe hanelah caksak nateh, na dei e patetlah caksak yawkaw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hahoi, ransabawi Cathut, Isarel Cathut teh Isarel Cathut doeh telah na min teh, a yungyoe caksak nateh, pholennae awm seh. Na san Devit imthungnaw teh, na hmalah cak naseh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bangkongtetpawiteh, Oe ka Cathut, na san koevah na imthung ka kangdue sak han telah na kamnue sak toe. Hatdawkvah, na san ni nama koe ka ratoum ngamnae doeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Oe BAWIPA nama teh Cathut lah na o dawk na hawinae teh, na san koe lawk yo na kam toe.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na san imthungnaw heh na hmalah a yungyoe ao thai awh nahanelah, yawhawinae na poe toe. Bangdawk tetpawiteh, Oe BAWIPA nama ni yaw na hawi sak e teh, yungyoe yawhawinae doeh telah ati.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hathnukkhu hoi hettelah ao. Devit ni Filistinnaw a tuk teh a tâ. Gath hoi khotenaw hah Filistinnaw e kut dawk hoi a lawp.
  </para>
  <para style="p">
    <verse number="2" style="v" />Moabnaw bout a tuk teh, Moabnaw teh Devit e san lah ao awh teh, tamuk ouk a poe awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Euphrates palang teng e a uknae caksak hanelah, a cei nah Devit ni Zobah siangpahrang Hadadezer hai Hamath totouh a tâ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Devit ni rangleng 1, 000 hoi marangransanaw 7, 000, hoi ransa 20, 000 hah ahni koe e la a poe. Devit ni leng la sawn e marangnaw pueng hah be a raphoe pouh teh leng ka sawn e 100 touh dueng a pâhlung pouh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Damaskas, Assirianaw hah Zobah siangpahrang Hadadezer ka bawm hanelah a tho awh navah, Devit ni Sirianaw 22, 000 a thei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatdawkvah, Devit ni Siria ram Damaskas khovah, ransanaw a ta. Sirianaw ni hai Devit tamuk ka poe e lah ao awh. BAWIPA ni Devit teh a cei na tangkuem koe tânae a poe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Devit ni Hadadezernaw e sui saipheinaw a la pouh teh, Jerusalem vah a ceikhai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hadadezer khopui dawk e Tibhath kho hoi Kun kho dawk hoi, rahum moikapap a thokhai. Hote rahum hoi Solomon ni rahum tuiim, rahum khom, rahum puengcang aphunphun lah a sak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hamath siangpahrang Toi ni Zobah siangpahrang, Hadadezer, ransanaw pueng Devit ni a tâ tie hah a thai awh torei teh,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hadadezer hah a tuk teh a tâ dawkvah, kut man hanelah lunghawikhai hanelah, a capa Hadoram teh Devit koe a patoun. Bangkongtetpawiteh, Hadadezer ni Toi hah a tuk. Hahoi suingun rahum, hlaamnaw phunkuep hah a hni koe a patawn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hote hnonaw hoi miphunnaw pueng Edom, moab, Ammon, Filistin hoi Amaleknaw koe e sui ngun a la e naw hoi Devit ni BAWIPA koe a pathung.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hothloilah, Zeruiah capa Abishai ni Edomnaw 18, 000 touh hah palawi tanghling dawk a thei awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Edom hai ransa a ta teh, Edomnaw pueng teh Devit ni tamuk a cawngnae kho lah ao awh. BAWIPA ni Devit teh a ceinae tangkuem koe tânae a poe.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hottelah Devit ni Isarelnaw a uk teh, a taminaw dawkvah, kalancalah lawk a ceng.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zeruiah capa Joab teh ransahu ka hrawi e bawi lah ao. Ahilud e capa Jehoshaphat teh kamthang kathutkung lah ao.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahilud capa Zadok hoi Abiathar capa Abimelek teh vaihma lah ao awh teh, Shavsha teh cakathutkung lah ao.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jehoiada capa Benaiah teh Kerethnaw hoi Pheletnaw kahrawikung lah ao teh, Devit capanaw teh, siangpahrang thaw dawk kho kakhangkungnaw lah ao awh.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hathnukkhu, hettelah ao. Ammonnaw e siangpahrang Nahash a due hoi a capa ni a yueng lah a bawi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Devit ni Nahash e capa Hanun koevah, pahrennae kamnue sak han. Bangkongtetpawiteh, a na pa ni kai koe pahrennae a kamnue sak toe telah ati. Hatdawkvah, Devit ni a na pa e kong dawk lungpahawi hanelah, patounenaw a patoun teh. Ahni lungpahawi hanelah, Devit e a sannaw teh Ammon catounnaw e ram Hanun koe a pha awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hateiteh, Ammonnaw kahrawikung Hanun koevah, Devit ni nang lungpahawi hanelah a patoun e taminaw heh na pa barinae a poe katang dawk doeh, telah na pouk maw. A sannaw teh ram tuet hane hoi raphoe hane ngai dawk doeh a tho awh e nahoehmaw, telah ati awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hatdawkvah, Hanun ni Devit e sannaw hah a man teh, a pâkhamuen koung a ngaw pouh teh a khohna hah a laheibaw koe totouh a a pouh teh a ban sak.
  </para>
  <para style="p">
    <verse number="5" style="v" />A patoun e a sannaw kong hah Devit koe tami buet touh ni a dei pouh teh, hotnaw hah puenghoi yeirai a po sak dawkvah, ahnimanaw kâhmo hanelah laiceinaw a patoun. Siangpahrang ni, na pâkhamuen a sai hoehroukrak Jeriko kho dawk awm awh ei, pâkhamuen a sai torei ban awh telah atipouh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ammonnaw ni, Devit ni a hmuhma e sak awh toe tie a panue awh toteh, Hanun hoi Ammonnaw ni Mesoptamianaw hoi Sirianaw Maakah hoi Zobahnaw koe leng hoi marangransanaw hlai nahanlah ngun tangka talen 1, 000 a patawn awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hottelah leng 32, 000 Maakah siangpahrang hoi a taminaw hoi a hlai awh teh, Madeba kho e a hmalah a tungpup awh. Ammonnaw teh a kho tangkuem hoi a tâco awh teh, tuk hanelah a cei awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Devit ni hote kamthang a thai torei teh, Joab hoi athakaawme ransahu pueng hah a patoun.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ammonnaw a tâco awh teh, khopui longkha teng vah, tuk hanlah a kamkhueng awh. Kabawm hane siangpahrangnaw teh kahrawng dawk alouklouk lah ao awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hottelah hmalah hoi hnuk lahoi, tuk hanelah kaawm e hah Joab ni a panue torei teh, Isarelnaw thung dawk kahawipoung e a rawi teh, Sirianaw tuk hanlah a cei awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Alouke taminaw pueng teh a hmaunawngha Abishai kut dawk a poe teh Ammonnaw tuk hanelah a cei van awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joab ni, Sirianaw hah ka tâ thai mahoeh na tetpawiteh, na kabawp awh han. Hahoi Ammonnaw hah na tâ thai mahoeh pawiteh, na kabawp awh han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tarankahawi lah awm awh nateh, maimae taminaw hoi mamae Cathut, khopuinaw hanelah tongpatang lah awm awh sei. BAWIPA ni ahawi tie patetlah sak yawkaw seh ati awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hottelah Joab hoi ama koe kaawm e naw ni, tarantuk hane Sirianaw koe rek a hnai awh teh, a hmaitung koung a yawng awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ammonnaw ni Sirianaw koung a yawng awh tie hah a panue torei teh, ahnimouh hai a hmaunawngha Abishai e hmalah a yawng awh teh, kho thung a kâen awh. Hatdawkvah, Joab teh Jerusalem vah a ban.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sirianaw ni Isarelnaw e a hmalah kangdue e hmuen hawihoeh tie a panue torei teh, patounenaw a patoun awh teh, palang namran kaawm e Sirianaw hah a kaw awh. Hadadezer ransabawi Shophate ni hai ahnimouh a uk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hote kong teh Devit koe a dei pouh awh. Ahni ni Isarelnaw pueng a kaw teh, Jordan namran vah a cei awh teh, Sirianaw hah a tuk awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sirianaw teh, Isarelnaw e a hmalah, a yawng awh teh, Devit ni Sirianaw e leng 7, 000 touh dawk kâcui e naw hoi ransa 40, 000 touh a thei teh ransabawi Shophate hai a thei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hatdawkvah, Hadadezernaw ni Isarelnaw e a hmalah kangdout thai hoeh toe tie a panue torei teh, Devit koevah roumnae a sak awh teh, tamuk ka cawng e kho lah ao awh. Hatdawkvah, Sirianaw ni Ammonnaw teh kabawp han ngai awh hoeh toe.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kawmpoi e tueng a pha nah, siangpahrangnaw ni tarantuk hane ouk a tâco awh. Joab ni ransahu a ceikhai teh Ammonnaw e ram hah a tuk teh Rabbah kho a kalup awh. Devit teh Jerusalem vah ao Joab ni Rabbah kho a tâ teh a la.
  </para>
  <para style="p">
    <verse number="2" style="v" />Devit ni hote siangpahrang e bawilakhung hah a la pouh. Ai e teh sui talen buet touh a ri. talung phu kaawmnaw hai ao. Devit hah a kâmuk sak awh teh, khopui thung e hno moikapap a lawp awh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hote hmuen koehoi taminaw hah a ceikhai teh, thing a e kawi, laikawk kanawknae hnopainaw, cakânaw, hno nahanelah thaw a tawk sak awh. Hot patetlah Ammonnaw e khopui abuemlah Devit ni a sak hnukkhu, Devit hoi a taminaw pueng teh Jerusalem vah a ban awh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hathnukkhu, Filistinnaw hoi Gezer vah tarankâtuknae bout ao. Hushath Sibbekhai ni Rapha catoun thung dawk e Sippai hah a thei awh teh a sung sak awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Filistinnaw hoi bout kâtuk awh teh, Jair kho e Jair capa Elhanan ni Git tami Goliath e nawngha Lahmi hah a thei. A tahroecung teh hni kawng kalawng e patetlah ao.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gath khovah kâtuknae bout ao teh, hawvah, ka rasang poung e aranglae kut roi dawk kutcarei taruk touh, avanglae a khok roi dawk a khokcarei taruk, asumkum 24 touh ka tawn e ao. Filistin miphun tamikalen poung e miphunnaw e casak doeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahni ni Isarelnaw a ka pacekpahlek dawkvah, Devit e a nawngha Shimei capa Jonathan ni ahni hah a thei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hotnaw teh Gath kho dawk kaawm e Rapha tami kalenpounge casak lah ao teh, Devit hoi a sannaw e kut dawk hoi a due awh.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi Setan ni Isarelnaw taran lahoi a thaw teh, Isarelnaw milu touk sak hanelah Devit hah a tacuek.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hatdawkvah, Devit ni Joab hoi a taminaw kahrawikung koe, Isarel miphun pueng Dan kho hoi Beersheba kho totouh cet awh nateh, tami nâyittouh maw tie ka panue thai nahan touk awh nateh kai koe bout na dei awh han telah atipouh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hatei, Joab ni siangpahrang koevah, BAWIPA ni taminaw teh a let 100 touh haiyah pungdaw sak naseh, siangpahrang ka bawipa e misa lah koung kaawm nahoehmaw, ka bawipa ni bangkongmaw hot hah panue han na ngai, bangdawkmaw Isarelnaw kâtapoe sak hanelah na sak vaw atipouh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hateiteh siangpahrang e lawk teh Joab ni ek thai hoeh. Hatdawkvah, Joab ni Isarel ram pueng dawk a cei teh, Jerusalem vah bout a ban.
  </para>
  <para style="p">
    <verse number="5" style="v" />Joab ni tami kaawm e yit touh Devit koe bout a dei pouh. Isarel ram dawk tahloi ka patuem e 1, 100, 000 touh a pha awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hateiteh, Levihnaw hoi Benjaminnaw teh touk awh hoeh. Bangkongtetpawiteh, siangpahrang e lawk teh Joab hanelah panuet a tho.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hote kong teh Cathut ni a ngai hoeh dawkvah, Isarelnaw hah a thei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Devit ni Cathut koe hete ka sak e dawkvah puenghoi ka payon toe. Hatei nakunghai na sanpa kai ni ka payon, kai heh na pahren nateh, na ngaithoum yawkaw ei. Bangkongtetpawiteh, pathunae hno ka sak toe telah ati.
  </para>
  <para style="p">
    <verse number="9" style="v" />BAWIPA ni Devit e profet Gad koe vah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Cet nateh, Devit koe hettelah dei pouh. Hno kathum touh nang koe na patue. Nang dawk kai ni ka sak hane buetbuet touh kârawi leih telah dei pouh telah atipouh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gad teh Devit koe a cei teh, BAWIPA ni hettelah a dei, na ngai e kârawi leih.
  </para>
  <para style="p">
    <verse number="12" style="v" />BAWIPA ni a dei e teh, kum thum touh thung takang ka tho sak maw na ngai, Nahoeh pawiteh, thapa yung thum touh tarannaw ni na pâlei maw na ngai, Nahoeh pawiteh, hnin thum touh thung Lacik ka phasak maw na ngai. Na kapatounkung koe bangtelamaw ka dei pouh han, atu kâpouk nateh, dei haw telah atipouh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Devit ni Gad koevah, ka lung rei a thai, kho lah king a bing. BAWIPA e kut dawk ka bawt yawkaw naseh. Bangkongtetpawiteh, a lungmanae teh a len. Tami e a kut dawk teh na phat sak hanh telah atipouh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hatdawkvah, BAWIPA ni Isarelnaw thung lacik a pha sak teh, Isarelnaw tami 70, 000 touh a due awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hahoi Jerusalem raphoe hanelah, Cathut ni kalvantami a patoun teh, raphoe hane a kâcai navah, BAWIPA ni a khet teh, hawihoehnae sak han a noe e hah bout a kâhno. Ka raphoe e kalvantami koevah, a khout toe na kut dâw hanh lawi telah atipouh teh, BAWIPA e kalvantami teh Jebusit tami Ornan e cangkatinnae teng vah a kangdue.
  </para>
  <para style="p">
    <verse number="16" style="v" />Devit ni kho a radoung teh, BAWIPA kalvantami tahloi a rayu nalaihoi Jerusalem koelah a nue teh, talai hoi kalvan a rahak dawk a kangdue e hah a hmu. Hatdawkvah, Devit hoi kacuenaw ni buri a kâramuk awh teh, talai dawk a tabo awh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Devit ni Cathut koe taminaw touk hane kâ kapoekung teh kai nahoehmaw. Kai heh yonnae ka sak e, kahawihoehe poung lah hno ka sak e teh kai doeh. Hetnaw ni bangmaw a sak awh. Oe BAWIPA ka Cathut, kai hoi ka imthungnaw dawk na kut pho nateh, na taminaw ni lacik hah khang awh hanh naseh, telah ati.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hatdawkvah, BAWIPA kalvantami ni Jebusit tami Ornan e cangkatinnae koevah Devit a cei vaiteh, BAWIPA hanelah thuengnae khoungroe kangdue sak hanelah, Devit koe dei pouh hanelah Gad koe kâ a poe.
  </para>
  <para style="p">
    <verse number="19" style="v" />A dei e patetlah Gad ni BAWIPA min lahoi a dei pouh e patetlah Devit teh a cei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ornan ni a kamlang teh kalvantami hah a hmu. Ahni koe kaawm e a capa 4 touh a kâhro. Ornan ma teh cang a katin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hottelah Devit ni Ornan koe a pha teh, Ornan ni a khet navah, Devit hah a hmu. Cang a katin e pak a tha teh, Devit e hmalah talai dawk a tabo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Devit ni BAWIPA hanelah thuengnae khoungroe ka sak thai nahanelah cangkatinnae hmuen hah na poe haw. Taminaw koehoi lacik a kâkayaw thai nahanelah, ka kuepcalah a phu na poe han telah atipouh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ornan ni Devit koe lat yawkaw, siangpahrang ka bawipa ni ahawi na tie patetlah sak yawkaw, khenhaw! hmaisawi thuengnae sak nahanelah maitotan hoi thueng hanelah cakong, tavai hoi thueng nahanelah cakang hai na poe han. Abuemlahoi koung na poe telah atipouh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Siangpahrang Devit ni Ornan koevah, telah nahoeh. Aphu hoi kâran han. Bangkongtetpawiteh, BAWIPA hanlah nange ka lat mahoeh. Banghai baw laipalah thuengnae sathei hah ka poe mahoeh atipouh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hatdawkvah, Devit ni hote hmuen teh Ornan koe sui shekel 600 touh hoi a ran.
  </para>
  <para style="p">
    <verse number="26" style="v" />Devit ni hote hmuen koe BAWIPA hanlah khoungroe a sak teh, sathei thuengnae hoi roum thuengnae sathei poenae a sak. BAWIPA a kaw teh khoungroe dawkvah kalvan lahoi hmai hoi a pato.
  </para>
  <para style="p">
    <verse number="27" style="v" />BAWIPA ni kalvantaminaw hah kâ a poe teh, tahloi teh a tabu dawk bout a pâseng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Devit ni Jebusit tami Ornan e cangkatinnae koehoi BAWIPA ni na pato tie hah a panue torei teh, hawvah thueng a sak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hatnae tueng dawkvah, Mosi ni kahrawngum BAWIPA e lukkareiim hoi hmaisawinae khoungroe a sak e hah, Gibeon kho e hmuenrasang doeh ao rah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hateiteh, Cathut koe pouknae hei hanelah Devit ni a hmalah cet thai hoeh. Bangkongtetpawiteh, BAWIPA e kalvantami e tahloi hah a taki.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Devit ni hetteh BAWIPA Cathut e im lah ao teh, hethateh Isarelnaw hanelah hmaisawi thuengnae khoungroe doeh telah ati.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hatdawkvah, Devit ni Isarel ram e miphun alouke kaawm e naw hah, cungtalah pâkhueng teh, Cathut e im sak hanelah, talungdêikathoumnaw hah thaw a poe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Devit ni longkha, tho sak nahanelah sum moikapap hoi rahum moikapap a ta pouh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sidar thing hai moikapap a ta pouh. Sidonnaw hoi Tairenaw ni Devit koevah, Sidar thing moikapap a sin pouh awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Devit ni ka capa Solomon teh a camo rah dawkvah, banghai panuek hoeh rah. A sak hane BAWIPA im teh a raim kaawm poung e, a min kamthang poung e, hoi ka lentoe e, ram pueng dawk pathang hanelah ao han. Hatdawkvah, sut ka rakueng pouh han telah ati. Devit ni a due hoehnahlan vah sut a rakueng pouh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A capa Solomon a kaw teh, BAWIPA Isarel Cathut e im sak hanelah kâ a poe.
  </para>
  <para style="p">
    <verse number="7" style="v" />Devit ni a capa Solomon koevah, ka capa BAWIPA ka Cathut im hanelah im ka sak pouh hanelah ka kâcainae ao.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hatei, nang teh thi moikapap na lawng sak. Taran kalenpoungnaw hai na tuk. Kaie mithmu vah talai van thi moikapap na lawng sak. Ka min hane im na sak mahoeh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khenhaw! capa na tawn vaiteh, ahni teh roumnae tami lah ao han. A tengpam e tarannaw e thung hoi roumnae ka poe han. A min teh Solomon na ti han. Ahnie se dawk Isarelnaw teh lungmawngnae hoi roumnae hoi ao han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahni ni kaie min o nahane im a sak han. Ahni teh ka capa lah ao vaiteh, kai teh a na pa lah ka o han. Isarelnaw dawk uknaeram a bawitungkhung a yungyoe ka caksak han, telah BAWIPA e lawk teh kai koe a tho.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hatdawkvah, ka capa, BAWIPA teh nang koe ao teh, na lam a cawn sak vaiteh, na dei tangcoung e patetlah nang ni nange BAWIPA Cathut e im hah na sak han.
  </para>
  <para style="p">
    <verse number="12" style="v" />BAWIPA ni lungangnae hoi thoumthainae na poe seh. Isarelnaw dawk uknae na poe seh. BAWIPA na Cathut e phunglawk teh na tarawi thai han.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hottelah Isarel kong dawk phung hoi lawkcengnae BAWIPA ni Mosi koe a poe e naw hah na tarawi pawiteh, na lam a cawn han doeh. Na tha awm sak, na taranhawi sak, taket hanh, na lungpout sak hanh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khenhaw! sut ka rakueng tangcoung e BAWIPA e im hanelah sui talen 1, 000 hoi ngun talen 1, 000, 000 touh a ta pouh. Rahum hoi sumnaw hai moikapap lah ao toe. Thing hoi talungnaw hai ka rakueng toe. Youn na sak thai han toe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hahoi thaw ka tawk hane, thing ka a hane, talung ka dêi hane, imsakkathoumnaw koung ao toe.
  </para>
  <para style="p">
    <verse number="16" style="v" />Moikapap lah suinaw hoi ngunnaw, rahumnaw, sumnaw hai ao. Thaw nateh tawk hane youn kamtawng leih, BAWIPA teh nang koe ao atipouh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Devit ni Isarel kahrawikungnaw pueng teh a capa Solomon kabawp awh hanelah kâ a poe.
  </para>
  <para style="p">
    <verse number="18" style="v" />BAWIPA nangmae Cathut teh nangmouh koe ao nahoehmaw. Hmuen tangkuem vah roumnae na poe nahoehmaw. Hete ram dawk e taminaw teh ka kut dawk na poe teh a ram hai BAWIPA hoi a taminaw hmalah tâ lah ao toe.
  </para>
  <para style="p">
    <verse number="19" style="v" />BAWIPA na Cathut hah tawng hanelah, na hringnae hoi na lungthin dawk tat awh. Hatdawkvah, BAWIPA lawkkam thingkong hoi Cathut e hnopai kathounge naw hah BAWIPA min lahoi sak hane im dawkvah, kâenkhai hanelah, BAWIPA Cathut e hmuen kathoung teh thaw nateh sak awh telah ati.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Devit teh a matawng toung dawkvah, a capa Solomon teh Isarel siangpahrang lah a sak awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Isarel kahrawikungnaw pueng hoi vaihmanaw, Levihnaw hah koung a kamkhueng sak.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levihnaw teh kum 30 touh hoi lathueng e naw hah touk e lah ao teh, tongpa 38, 000 a pha.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hotnaw thung dawk hoi 24, 000 teh BAWIPA e im ka sak hane naw hoi ka ring hane naw lah ao awh teh, 6000 teh kahrawikungnaw hoi lawkcengkungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hahoi 4000 teh, longkha karingkungnaw lah ao awh. Alouke 4000 teh pholennae koe tumkhawng hanelah ka sak e naw, Devit ni a sak e hah a hno awh teh, BAWIPA kapholennaw lah ao awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levih e capanaw thung dawk hoi a hu louklouk lah a kâkapek awh. Gershon casaknaw Kohath hoi Merari.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershonnaw teh Ladan hoi Shimei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ladan casaknaw teh Jehiel, Zetham hoi Joel, abuemlah kathum touh a pha awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shimei casaknaw teh Shelomith hoi Haziel, Haran hoi abuemlah kathum touh a pha awh. Hetnaw teh Ladan catoun imthung kahrawikung lah ao awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shimei casaknaw teh Jahath, Zina, Jeush hoi Beriah. Hetnaw pali touh teh Shimei casaknaw doeh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jahath teh kacuepoung lah ao. Zizah teh apâhni e lah ao. Jeush hoi Beriah teh ca pung awh hoeh. Hatdawkvah, imthung buet touh e patetlah a pouk awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kohath casaknaw teh Amram, Izhar, Hebron, Uzziel hoi pali touh a pha awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amram casaknaw teh Aron hoi Mosi doeh. Aron hoi a catounnaw teh, yungyoe hanelah kathounge hnonaw hah thoung sak hane, BAWIPA hmalah hmuitui sawi e thaw hah tawk vaiteh, amae min lah hoi yawhawi ka poe hanelah aloukcalah kapek e lah ao.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cathut e tami Mosi e capanaw teh Levih miphun dawk hmai touksin e lah ao.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi casak teh Gershom hoi Eliezer.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gershom casak thung dawk hoi kacuepoung e teh Shubael doeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eliezer casak lah kaawm e thung hoi kacuepoung e Rehabiah doeh. Eliezer ni ca tongpa alouke tawn hoeh. Hateiteh, Rehabiah casak teh moi a pung awh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izhar casak thung dawk hoi kacuepoung e teh Shelomith doeh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hebron casaknaw thung dawk hoi kacuepoung e teh Jeriah doeh. Apâhni e teh Amariah doeh. Apâthum e teh Jahaziel doeh. Apali e teh Jekameam doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uzziel casak dawk hoi kacuepoung e teh Mikah, apâhni e teh Isshiah doeh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merari casak teh Mahli hoi Mushi, Mahli casak teh Eleazar hoi Kish.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eleazar teh ca tongpa tawn hoeh. Napui dueng doeh a tawn. Kish e capanaw ni ahnimouh teh yu lah a la awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mushi casaknaw teh Mahli, Eder, Jerimoth hoi kathum touh a pha awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hetnaw teh Levih capanaw dawk a imthung lah hoi touk awh e dawk, imthungnaw kahrawikung BAWIPA im sak hanelah kum 20 lathueng e thaw katawknaw lah ao awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bangkongtetpawiteh, Devit ni Jerusalem vah yungyoe kho a sak thai nahane Isarel BAWIPA Cathut ni a taminaw hah karoumcalah o thai nahan a poe e doeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Levihnaw ni hai lukkareiim hoi a thaw tawk nahanelah puengcangnaw kâkayawt hanelah ngai mahoeh toe, telah a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bangkongtetpawiteh, Devit ni kâpoe e ao dawkvah, Levihnaw kum 20 lathueng hah touk e lah ao awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hatdawkvah, Levihnaw teh Cathut e im dawk thaw ka tawk e Aron e capanaw thaw kabawp hane, longkha thung e, im khan thung e, kathounge hno pueng thoung sak hane, BAWIPA e im dawk thaw ka tawk e lah ao awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pâtoum hane vaiyei hoi tavai, thueng nahane tavai kanui e, tonphuenhoehe ka rapamca e, hmai pahai e thoseh, karê e thoseh, kathoung kalen pueng hai ao.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amom tangminlah hnintangkuem BAWIPA koe lunghawi lawk dei hanelah ao awh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sabbath hnin thoseh, thaparei hnin thoseh, pawi hnin thoseh, sak hane patetlah BAWIPA koe thuengnae pueng poe hanelah thaw katawknaw lah ao awh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hahoi, kamkhuengnae lukkareiim ka ring hane hoi, hmuen kathoung ka ring hane hoi, BAWIPA im dawk thaw ka tawk hane hmaunawngha Aron e capanaw ni sak hane pueng teh ahnimae thaw lah ao.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aron capanaw thaw reinae teh hettelah ao. Aron casaknaw teh Nadab, Abihu, Eleazar hoi Ithamar tinaw hah doeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nadab hoi Abihu teh a na pa a due hoehnahlan a due roi teh, capa tawn roi hoeh. Hatdawkvah, Eleazar hoi Ithamar ni vaihma thaw teh a tawk roi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Devit ni Eleazar casak Zadok hoi Ithamar casak Ahimelek tinaw hoi rei ka tawk hane thaw a kapek pouh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ithamar casaknaw hlak vah, Eleazar casaknaw ni kahrawikung kapap lah ao awh. Eleazar casak dawk hoi imthung kahrawikungnaw 16 touh a pha awh. Ithamar casak dawk hoi imthung kahrawikungnaw 8 touh a pha awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hottelah cungpam a khoe awh teh, suetalah a kârei awh. Bangkongtetpawiteh, Eleazar casaknaw hoi Ithamar casaknaw dawk hmuen kathoung dawk e kahrawikung hoi Cathut e im hanelah kahrawikung lah ao awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levih tami cakathutkung Nethanel capa Shemaiah ni siangpahrang hoi kahrawikungnaw hah vaihma Zadok hoi Abiathar capa Ahimelek, hoi vaihmanaw hah Levih imthung kahrawikungnaw e mithmu vah a thut. Imthung kahrawikung buet touh ni a coe e teh, Eleazar imthung dawk a bo. Buet touh e teh Ithamar imthung dawk a bo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hottelah cungpam apasuek e teh Jehoiarib dawk a bo. Apâhni e teh Jedaiah dawk a bo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Apâthum teh Harim dawk a bo. Apali e teh Seorim dawk a bo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Apanga e teh Malkhijah dawk a bo. Tangla, ataruk e teh Mijamin dawk a bo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Asari e teh Hakkoz dawk a bo. ataroe e teh Abijah dawk a bo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Atako e teh Jeshua dawk a bo, ahra e teh Shekaniah dawk a bo.
  </para>
  <para style="p">
    <verse number="12" style="v" />ahlaibun e teh Eliashib dawk a bo, ahlaikahni e teh Jakim dawk a bo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahlaikathum e teh Huppah dawk a bo, ahlaipali e teh Jeshebeab dawk a bo.
  </para>
  <para style="p">
    <verse number="14" style="v" />ahlaipanga e teh Bilgah dawk a bo, ahlaitaruk e teh Immer dawk a bo.
  </para>
  <para style="p">
    <verse number="15" style="v" />ahlaisari e teh Hezir dawk a bo, ahlaitaroe e teh Happozzez dawk a bo.
  </para>
  <para style="p">
    <verse number="16" style="v" />ahlaitako e teh Pethahiah dawk a bo, aruihni e teh Ezekiel dawk a bo.
  </para>
  <para style="p">
    <verse number="17" style="v" />aruihnibuet e teh Jakhin dawk a bo, aruihnikahni e teh Gamul dawk a bo.
  </para>
  <para style="p">
    <verse number="18" style="v" />aruihnikathum e te Delaiah dawk a bo, aruihnipali e teh Maaziah dawk a bo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hetteh BAWIPA Isarel Cathut ni na pa Aron koe a poe e BAWIPA e im dawk thaw a tawk awh hanelah a kâparei awh e lah a ao.
  </para>
  <para style="p">
    <verse number="20" style="v" />Levih casaknaw kaawm rae teh Amram casaknaw thung dawk hoi Shubael, Shubael casak thung dawk hoi Jedeiah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rehabiah casaknaw thung hoi Isshiah teh a camin lah ao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izharnaw thung hoi Shelomoth, Shelomoth casak thung hoi Jahath.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hebron casaknaw teh a camin Jeriah, apâhni e teh Amariah, apâthum e teh Jahaziel, apali e teh Jekameam.
  </para>
  <para style="p">
    <verse number="24" style="v" />Uzziel casak thung hoi Maikah, Maikah casak thung hoi Shamir.
  </para>
  <para style="p">
    <verse number="25" style="v" />Maikah nawngha Isshiah, Isshiah casak thung hoi Zekhariah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Merari casaknaw teh Mahli hoi Mushi doeh. Jaaziah casak thung hoi Beno,
  </para>
  <para style="p">
    <verse number="27" style="v" />Merari casaknaw teh Jaaziah thung hoi Shoham, Zakkur hoi Ibri.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mahli koehoi capa ka tawn hoeh e Eleazar doeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kish koehoi capa Jerahmeel.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mushi casak teh Mahli, Eder, Jerimoth doeh. Hetnaw teh Levih casaknaw dawk hoi imthung kahrawikungnaw doeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahnimouh ni hai Aron casaknaw teh a hmaunawngha patetlah siangpahrang Devit hoi Zadok hoi Ahimelek hoi vaihmanaw hoi, Levihnaw imthung kahrawikungnaw mithmu vah, cungpam a rayu van awh. Imthung kahrawikung kacuepoung ni a nawngha cahnoung ni a sak e patetlah a sak awh.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi teh, Asaph, Heman, Jeduthun casak tangawn ni ratoung hoi tamawi, cecaknaw hoi tumkhawng hanelah Devit hoi ransabawinaw ni lengkaleng thaw a poe awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thaw ka tawk hane naw teh, Asaph casak dawk hoi Zakkur, Joseph, Nethaniah hoi Asarelah. Ahnimouh teh Asaph casaknaw siangpahrang ni kâpoe e patetlah lawk kadeikung Asaph e kâ rahim vah kaawm e naw doeh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jeduthun dawk hoi Jeduthun casaknaw teh Gedaliah, Zeri, Isaiah, Hashabiah, Mattithiah hoi taruk touh a pha awh. Ratoung hoi BAWIPA koe lunghawinae lawk kadeikung a na pa e kâ rahim kaawm e naw doeh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Heman dawk hoi Heman casaknaw teh Bukkiah, Mattaniah, Uzziel, Shubael, Jerimoth, Hananiah, Hanani, Eliathah, Giddalti, Romamtiezer, Joshbekashah, Mallothi, Hothir, Mahazioth.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hotnaw pueng teh siangpahrang hanelah kahmawtkung Heman casak a ki ka tawmrasang e lah ao awh. Cathut ni Heman teh ca tongpa 14 touh hoi canu 3 touh a poe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hotnaw pueng teh, BAWIPA im dawk cecak, tamawi, ratoung hoi Cathut e im dawk thaw ka tawk nahanelah, la ka sak naw a na pa e kâ rahim kaawm e naw doeh. Asaph, Jeduthun hoi Heman naw teh, siangpahrang kâtawnnae rahim kaawm e naw doeh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahnimouh teh a hmaunawnghanaw hoi BAWIPA hanelah la ka cang naw, ka thoum tangcoung naw abuemlah 288 touh a pha awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kathoung kalen, kacangkhainaw hoi, kacangnaw, a coe awh hane suetalah cungpam a khoe pouh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hottelah cungpam a khoe e apasueke teh Asaph e capa Joseph tak dawk a bo. Apâhni e teh Gedaliah hoi a hmaunawnghanaw capa 12 dawk a bo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Apâthum e teh Zakkur, a capanaw hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Apali e teh Izri hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Apanga e teh Nethaniah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ataruk e teh Bukkiah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Asari e teh Jesharelah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ataroe e teh Isaiah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Atako e teh Mattaniah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahra e teh Shimei hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahlaibun e teh Azarel hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahlaikahni e teh Hashabiah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahlaikathum e teh Shubael hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahlaipali e teh Mattithiah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahlaipanga e teh Jerimoth hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahlaitaruk e teh Hananiah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahlaisari e teh Joshbekashah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahlaitaroe e teh Hanani hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahlaitako e teh Mallothi hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aruihni e teh Eliathah hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aruihnibuet e teh Hothir hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aruihnikahni e teh Giddalti hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aruihnikathum e teh Mahazioth hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aruihnipali e teh Romamtiezer hoi a capa hoi a hmaunawnghanaw 12 touh dawk a bo.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Longkha karingkungnaw thaw kâreinae teh, Korah koehoi Asaph casaknaw Kore capa Meshelemiah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meshelemiah casak koehoi Zekhariah teh a ca camin, apâhni e teh Jediael, apâthum e teh Zebadiah, apali e teh Jathniel,
  </para>
  <para style="p">
    <verse number="3" style="v" />apanga e teh Elam, ataruk e teh Jehohanan, asari e teh Elioenai,
  </para>
  <para style="p">
    <verse number="4" style="v" />Obededom casaknaw teh a camin Shemaiah, apâhni e teh Jehozabad, apâthum e teh Joah, apali e teh Sakar, apanga e teh Nethanel,
  </para>
  <para style="p">
    <verse number="5" style="v" />ataruk e teh Ammiel, asari e teh Issakhar, ataroe e teh Peulthai, ahni teh Cathut ni yawhawi a poe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Shemaiah casaknaw thung hoi hai imthung kahrawinaw ao van. Bangkongtetpawiteh, tarankahawi ni teh athakaawme taminaw lah ao awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Shemaiah capanaw teh Othni, Rephael, Obed, a hmaunawngha Elzabad, hno katetthai capa Elihu hoi Semakiah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hetnaw teh Obededom casaknaw doeh. A capanaw hoi a hmaunawnghanaw teh thaw ka tawk thai poung e lah ao. Obed-edomnaw teh 62 touh a pha awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meshelemiah casaknaw hoi a hmaunawngha a thakaawm capa 18 touh ao awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Merari casak koehoi Hosah ni hai capanaw a tawn. Shimri te camin la ao hoeh nakunghai a na pa ni kacuepoung lah a ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Apâhni e teh Hilkiah, apâthum e teh Tabaliah, apali e teh Zekhariah. Hosah casak hoi a hmaunawnghanaw abuemlah 13 touh a pha.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hetnaw teh a hmaunawnghanaw patetlah BAWIPA e im dawk thaw ka tawk e longkha ka ring hanelah ao awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kacue kanaw a imthungnaw lahoi longkha tangkuem ring hanelah cungpam a rayu awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kanîtholae cungpam teh Shelemiah a bo. A lungkaang poung e lawkcengkung capa Zekhariah hanelah cungpam a rayu awh teh tung lae hah a coe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Akalae Obededom a coe dawk hnopai tanae im teh a capanaw ni coe e lah ao.
  </para>
  <para style="p">
    <verse number="16" style="v" />Shuppim hoi Hosah ni coe e teh kanîloumlae takhangnae Shalleketh longkha hoi thongim a voivang lae hah doeh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kanîtholae Levihnaw 6 touh ao awh teh, hnin touh dawk atunglah 4, akalah 4, hahoi hnoim dawk 2, reirei ao.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kanîloumlae hoi rapan thung kâen nahanelah 4 touh, kalupnae thung 2 touh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hetnaw teh Korah e capanaw hoi Merari e capanaw, longkha ka ring hanelah a kapek e naw doeh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Levihnaw thung hoi Ahijah teh Cathut im dawk hnopai poe e karingkung lah ao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ladan e catounnaw teh Ladan koehoi Gershonnaw lah kaawm e lah ao. Gershonnaw ni Ladan imthung dawk kahrawikung lah ao awh. Hotnaw teh
  </para>
  <para style="p">
    <verse number="22" style="v" />Jehieli casak koehoi Zetham hoi a nawngha Joel teh BAWIPA im dawk e hnopai karingkung lah ao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amram koehoi hai, Izhar koehoi hai, Hebron koehoi hai, Uzziel koehoi hai ao awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi capa Gershom casak Shubael hai hnopai karingkungnaw dawk kacue lah ao.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eliezer dawk hoi a hmaunawnghanaw teh Eliezer capa Rehabiah, a capa Isaiah, a capa Joram, a capa Zikhri, a capa Shelmoth.
  </para>
  <para style="p">
    <verse number="26" style="v" />Shelomoth hoi a hmaunawnghanaw hai siangpahrang Devit hoi a imthung kahrawikung ransa 1000 kaukkung bawi, 100 touh kaukkung bawi lah ao awh. Ransabawinaw ni a poe e hnopai karingkung lah ao awh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Taran a tuknae koe e lawphno a sin awh e teh, BAWIPA e im pathoup nahanelah a poe awh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kahmawtkung Samuel hoi Kish capa Sawl, Ner capa Abner, Zeruiah capa Joab tinaw ni a poe tangcoung e naw hoi poe hanelah kaawm e hnonaw teh Shelomoth hoi a hmaunawnghanaw e kut dawk a kuem awh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Izharnaw dawk hoi Kenaniah hoi a capanaw teh Jerusalem rapan alawilae Isarelnaw dawk kahrawikungnaw hoi lawkcengkungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hebronnaw dawk hoi Hashabiah hoi a hmaunawnghanaw teh hno katetthai e tami 17000 touh teh Jordan namran kanîloumlah BAWIPA e thawnaw hoi siangpahrang e thawnaw dawk Isarel ram karingkungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hebronnaw koehoi Jerijah teh Hebronnaw e a na pa a tâconae patetlah kahrawikung lah ao. Devit a bawinae kum 40 touh a pha navah, Gilead ram e Jazer vah ahnimouh thung dawk e athakaawme hoi tarankahawi e moikapap a hmu awh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cathut hane hoi siangpahrang e thaw dawkvah, Reuben, Gad, Manasseh casaknaw tangawn lathueng kahrawikungnaw hah Devit ni a ta. Imthungnaw ka hrawi hane dawk hoi hno katetthai e a hmaunawnghanaw teh 2, 700 touh a pha. awh.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Isarel catounnaw ayoun a pap e dawk hoi a imthung kahrawikung hane ransa 1, 000 kaukkung, 100 kaukkung ransabawinaw, siangpahrang thaw katawknaw pueng kum touh thung hane thapa yung touh hoi yung touh a kâhlai awh teh, thaw a tawk awh. Ahu thung tami 24, 000 ao awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Apasueke thapa dawk ahu buet touh kahrawikung teh Zabdiel capa Jashobeam ni a hrawi teh ahu thung tami 24, 000 ao.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahni teh Perez casak lah ao teh hmaloe pasuek e thapa dawk e ransahu kahrawikungnaw hlak ransabawi kacue lah ao.
  </para>
  <para style="p">
    <verse number="4" style="v" />Apâhni e thapa dawk ahu kahrawikung teh Aho tami Donai doeh. Ahu dawk Mikloth hai kahrawikung lah ao. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Apâthum e thapa dawk ahu kahrawikung teh vaihma Jehoiada capa Jehoiada capa Benaiah doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benaiah teh tami 30 lathueng hoi 30 rahak dawk e tami athakaawme lah ao. A capa Ammizabad hai ahu thung a bawk van.
  </para>
  <para style="p">
    <verse number="7" style="v" />Apalinae thapa dawk ahu kahrawikung teh Joab e nawngha Asahel doeh. Ahnie a capa Zebadiah doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Apanga e thapa dawk ahu kahrawikung teh Izrah tami Shamhuth doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ataruk e thapa dawk ahu kahrawikung teh Tekoa tami Ikkesh capa Ira doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Asari e thapa dawk ahu kahrawikung teh Ephraim casak Pelonit tami Helez doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ataroe e thapa dawk ahu kahrawikung teh Zerahit catoun Hushath tami Sibbekhai doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Atako e thapa dawk ahu kahrawikung teh Benjamin casak Anathoth kho e Abiezer doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hra e thapa dawk ahu kahrawikung teh Zerahit catoun Netophah tami Maharai doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hlaibun e thapa dawk ahu kahrawikung teh Ephraim casak Pirathon tami Benaiah doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />A hlaikahni e thapa dawk ahu kahrawikung teh Othniel koehoi Netophah tami Heldai doeh. Ahu thung tami 24, 000 touh ao awh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Isarel miphunnaw dawkvah, Reuben miphun dawk hoi Zikhri capa Eliezer teh bawi kalen lah ao. Simeon miphunnaw hanelah Maakah capa Shephatiah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Levih miphunnaw hanelah Kemuel capa Hashabiah, Aron miphunnaw hanelah Zadok,
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah miphunnaw hanelah Devit e hmaunawnghanaw thung dawk hoi Elihu, Issakhar miphunnaw hanelah Michael capa Omri,
  </para>
  <para style="p">
    <verse number="19" style="v" />Zebulun miphunnaw hanelah Obadiah capa Ishmaiah, Naphtali miphunnaw hanelah Azriel capa Jerimoth,
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim casak miphunnaw hanelah Azaziah capa Hosi, Manasseh casak tangawn naw hanelah Pedaiah capa Joel,
  </para>
  <para style="p">
    <verse number="21" style="v" />Gilead ram e Manasseh miphun tangawn hanelah Zekhariah capa Iddo, Benjamin miphunnaw hanelah Abner capa Jaasiel,
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan miphunnaw hanelah Jeroham capa Azarel. Hotnaw teh Isarel miphun kahrawikungnaw lah ao awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hateiteh, Devit ni kum 20 rahim naw hah touk hoeh. Bangkongtetpawiteh, Isarel teh kalvan e âsi yit touh ka pung sak han telah BAWIPA ni yo a la dei toe.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeruiah capa Joab ni touk hanelah ati eiteh, boeba touk thai hoeh. Bangkongtetpawiteh, milu touk kecu dawkvah, Isarelnaw dawk a lungkhueknae a pha. A touk awh e yit touh siangpahrang Devit ni setouknae dawk thut e lah awm hoeh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Siangpahrang e hnopai ka ring e teh, Adiel capa Azmaveth doeh. Law dawk hai, khopui dawk hai, khote dawk hai, hnoim dawk hai, hnopainaw kakhenyawnkung teh Uzziah capa Jonathan doeh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laikawk kanawknaw ka khenyawnkung lah Kelub capa Ezri doeh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Misur takha kakhenyawnkung lah Ramathit tami Shimei doeh. Misur takha thung e misurkatin e kakhenyawnkung teh Shipmit tami Zabdi doeh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tanghling dawk kaawm e olive thing hoi thailahei kungnaw kakhenyawnkung lah Gaderi tami Baalhanan doeh. Satuinaw tanae kakhenyawnkung lah Joash doeh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sharon dawk ka pâ e saringnaw kakhenyawnkung lah Sharon tami Shitrai doeh. Tanghling dawk e saringnaw kakhenyawnkung lah Adlai capa Shaphat doeh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kalauknaw kakhenyawnkung lah Ishmael tami Obil doeh. Lanaw kakhenyawnkung lah Meronoth tami Jedeiah doeh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuhunaw ka khenyawnkung lah Hagri tami Jaziz doeh. Hotnaw pueng teh Devit e hnopai khenyawnkung lah ao awh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Devit e a napu Jonathan teh a lungkaang poung e hoi, cakathoum e, kho ka pouk thai e tami lah ao. Hakmonite capa Jehiel teh siangpahrang e capanaw kacangkhaikung lah ao.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahithophel teh siangpahrang khokhankhaikung lah ao. Arki tami Hushai teh siangpahrang e huiko lah ao.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahithophel hnukkhu teh Benaiah capa Jehoiada hoi Abiathar doeh. Joab te siangpahrang e ransanaw ka hrawi e doeh.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Devit ni Isarel kahrawikungnaw pueng, miphun tangkuem dawk e kahrawikungnaw hoi siangpahrang thaw tawknae dawk hoi ouk kâhlai e kahrawikungnaw ransa 1, 000 kauknaw, 100 kauknaw, siangpahrang hoi a canaw ni a tawn e hnopainaw pueng ka khenyawnnaw thakaawme taminaw hoi tami athakaawme taminaw pueng hah Jerusalem vah a kaw awh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Siangpahrang Devit ni a kangdue teh, ka hmaunawngha hoi ka taminaw ka lawk thai awh haw. BAWIPA lawkkam thingkong tanae hoi maimae Cathut khok tanae im ka sak han telah ka pouk e hah hote sak nahane hai moikapap ka tawn toe.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hateiteh, Cathut ni nang teh taran ka tuk e hoi thi ka lawng sak e lah na o dawkvah, kaie ka min onae im na sak mahoeh telah ati.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hat nakunghai Isarel BAWIPA Cathut ni apa imthungnaw dawk hoi Isarel siangpahrang lah o hane na rawi. Bangkongtetpawiteh, Judah teh kaukkung lah a rawi teh, Judah miphun thung dawk hoi, apa imthung e capanaw dawk hoi, Isarelnaw dawkvah siangpahrang lah o hane teh a ngainae doeh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hatdawkvah, ka capanaw thung dawk hoi BAWIPA ni ca tongpa moikapap na poe. Isarelnaw dawk BAWIPA e uknaeram bawitungkhung dawk tahung hanelah ka capa Solomon teh a rawi toe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hatdawkvah, kai koe ka imthung hoi ka thongma ka kangdout sak hane teh, na capa Solomon doeh. Ahni teh ka capa lah ao hane ka rawi toung dawkvah, a na pa lah ka o han.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hothloilah kâpoelawknaw hoi, ka lawkcengnae yuemkamcu lah awm pawiteh, a uknaeram hah a yungyoe ka caksak han. Sahnin e patetlah pou tarawi pawiteh telah ati.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hatdawkvah, hete kahawi e ram hah na coe han. Ca catounnaw hanelah yungyoe e râw lah na coe thai nahane BAWIPA e tamihu Isarelnaw pueng e mithmu hoi Cathut e hnâthainae dawk, BAWIPA na Cathut ni kâpoelawknaw hah tang nateh, pâkuem awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hahoi ka capa Solomon, na pa Cathut hah panuek nateh yuemkamcu e lungthin hoi lungthocalah hoi a thaw tawk pouh. Bangkongtetpawiteh, BAWIPA ni lungthin dawk pouknae naw pueng, noe e naw pueng hah be a panue thai. Ama hah na tawng pawiteh na hmu han. Hateiteh, na kamlang takhai pawiteh, yungyoe na pahnawt han.
  </para>
  <para style="p">
    <verse number="10" style="v" />Atu pouk haw, bangkongtetpawiteh, hmuen kathoung hane im sak hanlah BAWIPA ni na rawi e lah na o. Tha kâlat nateh, hot teh sak telah atipouh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hatdawkvah, Devit ni a capa Solomon teh Bawkim hoi alawilae im hoi hnoimnaw hoi, a thung e khan hoi lungmanae tungkhung meilamnaw hah a poe.
  </para>
  <para style="p">
    <verse number="12" style="v" />Muitha ni a tawn sak e lungngailawk a pâpho sak e naw pueng, BAWIPA e im kalup thung e thongma meilamnaw hoi tengpam rakhan kaawm e naw pueng e meilam hoi Cathut im e hnopai cawng nahane im meilamnaw hoi, ya e hnonaw ta nahane im meilam hah a poe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vaihmanaw hoi Levihnaw teh, amamae ahu thung lengkaleng ao awh nahanelah, im e meilam hoi BAWIPA e im dawk thaw tawk nahane pueng, puengcangnaw pueng meilam totouh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thaw tawk nahanelah hlaam phunkuep, sui hlaam hanelah hno hane sui hoi thaw tawk nahanelah ngun hlaam hanelah a panki e yit touh ngun hoi,
  </para>
  <para style="p">
    <verse number="15" style="v" />Sui hmaiimkhoknaw hoi sui hmaiimnaw a panki e yit touh sui hno hane hoi, hmaiimkhok hoi hmaiim hanelah a panki e yit touh hno hane hoi, hmaiimkhok nahanelah hno a panki e yit touh hno hane ngun hmaiimkhok a panki e yit touh hno hane yit touh hoi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vaiyei hung nahane caboi, buet touh rip hanelah sui a panki e yit touh hoi, ngun caboi hanelah a panki e yit touh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kathounge sui moi sonae sum kut hoi, rahum, manang, suimanang khom hoi manang khom buet touh rip dawk a panki e yit touh hoi,
  </para>
  <para style="p">
    <verse number="18" style="v" />kathounge sui hoi sak e hmuitui hmaisawinae khoungroe hane hoi cherubim ni a rathei kadai teh, BAWIPA lawkkam thingkong kayo e kamnuenae meilam patetlah sak hane a panki e yit touh suinaw hoi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Devit ni, a sakyoenaw hoi a pouk tangcoung e kamceng sak hanelah, BAWIPA ni amamae kut roeroe hoi a thut e roup lah ao telah atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Devit ni a capa Solomon koevah, tha kâlat nateh taran kahawicalah awm haw. Hot teh sak, taket hanh. na lungpout hanh. Bangkongtetpawiteh, Jehovah Cathut ka Cathut teh nang koe ao. BAWIPA im dawk e thaw hah a cum hoehroukrak teh, nang na cettakhai mahoeh atipouh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hahoi, khenhaw! Cathut e im dawk thaw phunkuep ka tawk e vaihmanaw hoi Levihnaw ao awh teh, thaw tawknae kathoumnaw, lungthocalah hoi kabawmnaw hah nang koe pou ao han. Kahrawikungnaw hoi tami pueng ni kâ na poe e pueng a tarawi awh han telah atipouh.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hahoi siangpahrang Devit ni taminaw koevah, Cathut ni a rawi e ka capa Solomon hah, a camo rah, a hmu thai e awm hoeh. A tawk hane teh a len poung. Bangkongtetpawiteh, bawkim teh tami hane tho hoeh niteh, BAWIPA Cathut hane doeh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hatdawkvah, ka Cathut im hane sui hnonae dawk sui, ngun hnonae dawk ngun, rahum hnonae dawk rahum, sum hnonae dawk sum, thing hnonae dawk thingnaw hah be ka rakueng toe. A mei pathoup nahanelah, onyx talung pangaw hoi a meikahawi e talungpangawnaw hoi, pathoup nahane talung a phukaawm e a phunphun hoi talungpangawnaw hai moikapap a ta toe
  </para>
  <para style="p">
    <verse number="3" style="v" />Hothloilah ka Cathut e im teh sak ngainae kalen poung lah ao dawkvah, kamae hnopai sui hoi ngunnaw hai im kathoung hanelah be ka rakueng e naw hloilah, ka Cathut im hanelah ka poe toe.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hahoi tapang sak nahane ophir sui talen 3,000 hoi kathounge ngun talen 7,000.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hnonae a phunphun dawk, kathoumnaw ni a hno hane, sui hno hane dawk sui, ngun hno nahane dawk ngun. Sahnin BAWIPA hanelah lunghawicalah poe pasoung e na yit touh maw ao telah a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hottelah imthungkhu kahrawikung Isarel miphun ka hrawi naw hoi, 1,000 kauknaw hoi, 100 touh kauknaw, siangpahrang thaw ka tawk e kahrawikungnaw hoi lunghawicalah hoi a poe awh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cathut e im saknae dawkvah sui talen 5,000 hoi Darik 10, 000 hoi rahum talen 18, 000, sum talen 100, 000 a poe awh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Talung phu kaawmnaw ni Gershon tami Jehiel ni a khetyawt e BAWIPA e hno dawk a ta awh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hatdawkvah, taminaw teh a lung hroung a hawi poung awh. Pouknae buet touh dawk lunghawinae, BAWIPA hno a poe awh dawkvah, Siangpahrang Devit hai a lung hroung ahawi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hatdawkvah, Devit ni tamipueng e hmalah BAWIPA a pholen. Kaimae BAWIPA Cathut, nang teh yungyoe hoi yungyoe totouh pholennae awm seh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Oe BAWIPA na lennae, na bahu, na bawilennae, na tânae, hoi na taluenae teh namae doeh. Bangkongtetpawiteh, kalvan hoi talai dawk kaawmnaw pueng, namae doeh. Oe BAWIPA uknaeram teh nama e doeh. Nang teh bangpuengpa dawk a Lathueng Poung lah na o.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tawntanae hoi barinae teh nama koehoi ka tho e naw doeh. Bangpuengpa na uk teh, na thaonae hoi hnotithainae naw hah na kut dawk ao. Na kut dawk tami pueng lentoe saknae hoi thasainae hah ao.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hatdawkvah, kaimae Cathut, nama koe lunghawinae lawk ka dei. Ka lentoe e na min teh ka pholen awh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hatei, tami bangpatet e lah maw ka o teh, ka taminaw hai bang lah maw ao awh teh, hete hnonaw heh lunghawicalah hoi a poe thai awh. Bangkongtetpawiteh, hnonaw pueng heh nama koehoi ka tâcawt e naw lah ao teh, nama koe e doeh kaimouh ni letlang na poe awh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kaimae mintoenaw patetlah kaimouh teh na hmalah imyin, tami koe kho ka sak e patetlah doeh ka o awh. Het talai van ka hring nathung e a hninnaw teh tâhlip thung e patetlah doeh ao. Ngaihawinae banghai awm hoeh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Oe Jehovah, kaimouh e Cathut na tamikathoungnaw hanlah im ka sak nahanelah, hete hno sut ka rakueng e hnonaw heh na kut dawk hoi ka tâcawt e lah ao teh namae lah koung ao.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka Cathut, nama ni lungthin ouk na tanouk teh lannae teh na lunghawinae lah ao tie hah ka panue. Kai ni hete hnonaw pueng heh lungthin katang hoi lunghawicalah hoi na poe. Atu hivah na taminaw ni lunghawicalah hoi a poe e naw hai ka hmu navah, ka lunghawi awh tangngak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Oe BAWIPA, kaimae na pa Abraham, Isak, Isarel Cathut, na taminaw ni het patet e lungthin pou a tawn thai nahanelah, a lungthin hah nama hanelah caksak haw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hahoi ka capa Solomon heh kâpoelawknaw, na panuesaknaenaw, hoi na phunglawknaw tarawi hane, hotnaw pueng teh sak hane hoi, ka rakueng tangcoung e im hah sak hane, yuemkamcu e lungthin poe ei telah Devit ni atipouh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hahoi Devit ni kamkhueng e taminaw pueng koe atuvah, BAWIPA na Cathut teh pholen awh telah ati. Hottelah tamihupui ni a mintoenaw e BAWIPA Cathut teh a pholen awh teh BAWIPA hoi siangpahrang e hmalah a lûsaling awh teh a tabut awh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hahoi a tangtho vah BAWIPA koe hmaisawi thuengnae sak hanelah maitotan 1000, hoi tutan 1000, tuca 1000, hoi sathei poenae hoi Isarelnaw pueng hane sathei poenae moikapap lah a poe awh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hatnah hnin vah lunghawinae kalen poung hoi BAWIPA e hmalah a canei awh. Apâhni e dawk Devit capa Solomon teh siangpahrang lah ao sak awh teh, kahrawikung lah ao nahanelah BAWIPA e hmalah satui a awi awh. Hahoi vaihma lah kaawm hane Zadok hah satui a awi awh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hottelah Solomon teh BAWIPA e bawitungkhung dawk a na pa Devit e a yueng siangpahrang lah a tahung. A lamcawn teh, Isarelnaw pueng ni a lawk teh a ngâi pouh awh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kahrawikungnaw pueng hoi athakaawme taminaw pueng hoi, siangpahrang Devit e capa alouknaw pueng hah siangpahrang Solomon koe a kâpoe awh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hottelah BAWIPA ni Solomon teh Isarelnaw pueng e mithmu dawk a kamsawng sak. Isarel ram dawk ahni hoehnahlan siangpahrangnaw thung dawk apinihai a coe boihoeh e taluenae hah a coe sak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesi capa Devit ni Isarelnaw pueng a uk.
  </para>
  <para style="p">
    <verse number="27" style="v" />Isarelnaw a uk nathung teh kum 40 touh a pha. Hebron vah kum 7 a uk teh Jerusalem vah kum 33 touh a uk.
  </para>
  <para style="p">
    <verse number="28" style="v" />A kum kacuepoung lah matawng totouh a hring teh a hring nathung a tawnta e hoi pholennae, oupnae hoi a due. A capa Solomon ni amae yueng lah a uk.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khenhaw! siangpahrang Devit kong teh, kamtawngnae koehoi a pout totouh kahmawtkung Samuel cauk dawk profet Nathan e cauk dawk, kahmawtkung Gad e cauk naw dawk hai a thut awh na a.
  </para>
  <para style="p">
    <verse number="30" style="v" />A uknaeram pueng hoi, a bawilennae naw pueng hoi, ama hai Isarelnaw, ramnaw pueng a uknae dawkvah, ka tho e hno pueng teh ka kuepcalah thut e lah ao.
  </para>
</usx>
