<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Biesozy</book>
  <para style="h">Biesozy</para>
  <para style="toc1">Biesozy</para>
  <para style="toc2">Biesozy</para>
  <para style="mt">Biesozy</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />He he Dâvi sawchapawpa, Izarei bei Sawlawmaw biesozy ta â chhuahpa a châ:
  </para>
  <para style="p">
    <verse number="2" style="v" />Sona nata pachuna pahno awpa ta, Pahnona biezy liata novâhna hnei awpa ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />Sona, siana, adona nata akhongâhna kyh zy liata Pachuna dao awpa ta;
  </para>
  <para style="p">
    <verse number="4" style="v" />Sona a phahlapazy hnohta sona pie awpa ta, Thyutliapazy hnohta pahnona nata hmia nata hnôh sai thaina pie awpa ta;
  </para>
  <para style="p">
    <verse number="5" style="v" />Asopazy ta theipa ta ama pahnona a pôh via nawpa ta, Novâhpazy ta pasopakâna bie ama dao thei nawpa ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />Bieso nata pakhona bie liata novâhna hnei awpa ta, Asopazy bie nata ama bie khiakhipazy liata novâhna hnei awpa ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abeipa china cha novâhna athaona châ ta, Ahrupazy ta sona nata pachuna ama mohnao tyh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ei sawchapawpa y, na paw chhoreina bie nathlie la, Na nô pachuna bie a heihsai khah y;
  </para>
  <para style="p">
    <verse number="9" style="v" />Na luh châta pawpi pachhih a ngia ngaitapa châ ei ta, Na rao châta pachhihzy ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ei sawchapawpa y, moleipazy ta ama cha reipasao khiahta cha, A pyh khah y.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Eima hnohta a vy la, Thisaih palo awpa ta a byh sih la, A chhâpa y leipa ta paraona a hnei leipazy a byh ei suh u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Athihkhih hawhta a hrohpa ta âmo cha palâ sih la, Khaohtlô liata a tlapazy hawhta ama pôhpa dua ta palâ ei suh u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmo sôhpazy hmô aw pi ta, Hraona sôh ta eima o eima pabie aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Eima hry liata miah a hlao hra la, Tâkâ sahria miakha eimâ hly aw,” Tahpa ta ama cha reipasao tita,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ei sawchapawpa y, ama lâpi a chhih hra leipa la, Ama lâpizy tawhta na phei a sysai ha mah y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Moleina lâta ama pheizy a râ ta, Thisaih palo awpa ta amâ para tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pavaw mohmô ta sao paraipa cha, Hraoleipa ta paraipa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />He chyhsazy heta âmo thisaih a byh ei ta, Âmo hrona amâ byh.
  </para>
  <para style="p">
    <verse number="19" style="v" />He he avyuhna ta athôhna a chadaipa karâypa chyhsa zydua chhâna a châ, Avyuhna ta hneipa sôh chata a hneituhpazy hrona a pahlei tyh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sona cha khiliah liata a paropa ta awh ta, Sôhdaoh suzy liata a aony a pasâh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khiliah lôhawh chaina su liata awh ta, Khihpi thokhy chhikaozy liata hetana heta a tah:
  </para>
  <para style="p">
    <verse number="22" style="v" />“Nâmo sona a phahlapazy saih u, So leipa ta ypa he khachâ ma nama pasô chy aw tly? Pasipasawh a thaipazy ta khachâ ma chyhsa pasipasawhpa paphasa aw ei ta, Ahrupazy ta khachâ ma pahnona amâ hao aw tly?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ei chhoreina lâ namâ vaw heih khiahta cha, Pachâ teh u, ei thlahpa cha hry aw ei na ta, Ei biezy ei cha pahnosa aw ei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cha aw ei na ta, Khoh leipa ei chi ta; Ei ku pazawh na ta, Ahy hmahta uasa leipa ei chi ta;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ei ryhraopa zydua hraoleipa ta tao ei chi ta, Ei chhoreina rai namâ pyh khoh leipa vâta,
  </para>
  <para style="p">
    <verse number="26" style="v" />Kei chhao ta chhiena namâ tyhna liata cha pahneisao aw ei na ta, Hmo chichhihpa ta a cha tla thlu ti ei ta ei cha pahneisao aw ei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hmo chichhihpa ta thlihpipa hawhta a cha chhei ti ei ta, Chhiena ta khisô hawhta a châ pahieh thlu ti ei ta, Nôpona nata pachârôhna a cha vaw tlô thlu ti ei ta, Ei cha pahneisao aw ei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cha tina chata na pado aw ei ta, Châhrasala a chhy aw veih ei na; Thata na tlua awh ei ta, Châhrasala na hmô aw veih ei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pahnona a hao ei ta, Abeipa china a tlyh leipa ei ta,
  </para>
  <para style="p">
    <verse number="30" style="v" />Ei ryhraopa miakha hmahta khoh leipa ei ta, Ei chhoreina zydua ama papeisa leipa vâta,
  </para>
  <para style="p">
    <verse number="31" style="v" />Âmo yzie thei nie aw ei ta, Âmo hmotaopazy ta lôhrâ amâ patlô aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sona a phahlapazy cha lâpi ama tleisaina ta âmo cha thie tyh ta, Ahrupazy chhao âmo hruna ta a pahleipadia tyh ei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ei bie a nathlietuhpa deikua cha â bohpa ta y aw ta, Chhiena chi leipa aw ta, Chhôhmohpa ta a y aw.”
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ei sawchapawpa y, ei biezy a pyhpa ta, Ei biepiepazy paso pha la;
  </para>
  <para style="p">
    <verse number="2" style="v" />Sona lâ na nah pachôhpa ta, Novâhna lâ na palôh pahei la;
  </para>
  <para style="p">
    <verse number="3" style="v" />Chatatly, pahno thaina padopa ta, Novâhna hnei awpa ta thata awh la,
  </para>
  <para style="p">
    <verse number="4" style="v" />Sona cha tâkâ tluapa hawhta tlua la, Ryubyh nyupa tluapa hawhta na tlua khiahta cha,
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa china kyh liata na novâh aw ta, Khazohpa pahnona nâ huah aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sona cha Abeipa piepa châ ta, A pakah tawhta pahnona nata novâhna a pua.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chyhsa dopa châta sona patapa pachôpa ta, Ngâchhihpa ta a ypazy châta ano cha vyhphao a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Adona lâpizy vaih ta, A mopathaihpazy hrozie a vaih tyh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chatanachata siana nata adona kyh liata na novâh aw ta, Akhongâhna nata lâpi phapa to kyh na no a vâh aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sona cha na palôh chhôh liata a ngia aw ta, Pahnona cha na hro châta kho â chhih kaw aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pahnona ta cha mokhâh aw ta, Novâhna ta a cha vaih aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Moleipa lâpi tawhta cha pachha aw ta, Chyhsa paviasana bie a reihpazy tawhta a cha pachha aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Âmo zohna lâpizy a chhih awpa ta, Siana lâpizy a tleisai hapa ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Moleina hmo taopa liata ama thapha ta, Molei chochhiena a lypazy ama châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama lâpi a kokaliepazy châ ei ta, Chyhsa dôvei khohna hro a hneipazy ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sona ta khichhai chanô tawhta cha pachha aw ta, Chihropa chanô reikah thaina tawhta a cha pachha aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha chanô cha a thyutlia nota â kaolâhpa siesai ta, A Khazohpa biehrai a my hapa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />A o cha thina liata a pamôh ta, Athipazy lâta a lâpizy a sie.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ano a pangai hapa cha ahy hmah kua heih khao leipa ei ta, Hrona lâpizy hmô heih thei khao veih ei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chavâta lâpi phapa a chhih la, Siana lâpi liata sie mah y.
  </para>
  <para style="p">
    <verse number="21" style="v" />Adopazy cha râh liata pahrâ aw ei ta, Phapakipazy cha râh liata ama y thlâh ha aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmoparaopazy deikua cha râh tawhta chhawh pathlahpa châ aw ei ta, Piehpiepazy cha râh tawhta phiapa ama châ aw.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ei sawchapawpa y, ei pachuna my leipa la, Na palôh ta ei biepiepazy a vao thlâh ha mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hro pasina cha pie aw ta, Kô hluhpi cha pahrosapa ta, Thlalôhna a cha pie aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngâchhihna nata biehmeiseihpa ta châ heihsai khah sy; Na rao liata chazei la, Na palôh lôphiapa liata roh ha mah y.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chatanachata Khazohpa nata chyhsa mohmô liata, Khokheina nata moh phana na hmô aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na pathipalôh tlokhuh ta Abeipa ngâ la, Nâma pahnona liata a pahnieh khah y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na lâpi zydua ano pahnosa lymâ la, Na lâpizy a patlâsa lymâ aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nâma pachâ ta a pasosa leipa la, Abeipa chi la, Moleina siesai mah y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha cha na sapa châta tlâhna châ aw ta, Na rupazy châta thohna a châ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na hneina ta Abeipa palyupalih la, Na kôvei a daih tuachaipa zydua ta Abeipa cha palyupalih mah y.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chatanachata na sawvâzy cha bie pakhô aw ta, Na kresawhti saohna lô beihzy cha, Kresawhti thiehpa ta a khô pathlah aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ei sawchapawpa y, Abeipa chhoreina cha, Papeisa leipa ta y leipa la; A cha ra tita, Na palôh pasa khah sy.
  </para>
  <para style="p">
    <verse number="12" style="v" />Paw ta sawchapaw â lypa a rapa hawhta, Abeipa chhao ta a kyhpachâpa cha a ra tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sona a hmôpa cha nohlaopa châ ta, Novâhna a hneipa chhao nohlaopa a châ hra.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sona tawhta athôhna cha tâkâ tawhta athôhna hlâta pha via ta, Sona papôhpa cha ngôh papôhpa hlâta a pha via.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sona cha lôsôhpa hlâta sôh via ta, Na kho kawpa hmo kheihawhpa nata hmah Pakhopâ thei rimâ awpa châ vei.
  </para>
  <para style="p">
    <verse number="16" style="v" />A ku chachâh lâta hro pasina y ta, A chavei lâta hneirôna nata zachhihna a y.
  </para>
  <para style="p">
    <verse number="17" style="v" />A lâpizy cha lâpi khochhihpazy châ ta, A lâthlôh zydua cha thlalôhna lâthlôh a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ano â patupa maih châta hrona tho châ ta, Â ipa ta ano a patupazy cha thaphapa ta ama y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abeipa ta sona ta alei he bô ta, Novâhna ta avâzy khi a padua.
  </para>
  <para style="p">
    <verse number="20" style="v" />A pahnona ta ti athupazy pasa ta, Meihdozy ta diati ama patlasa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ei sawchapawpa y, hezy he mopakhô leipa la, Sona patapa nata pahnona zy chhy lymâ mah y.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na hro châta hrona châ aw ta, Na rao châta atobina a châ aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chatanachata na lâpi liata â bohpa ta sie aw chi ta, Na phei a chapia aw vei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nâ zia tita chi leipa aw chi ta, A zia aw chi ta, mokuh pahâh kawpa ta nâ mô aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eikhapi ta chichhihpa a vaw tlô awpa a ngiaroh leipa la, Hmoparaopazy chô liata chhiena a vaw tlô awpa chhao a ngiaroh khah y.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abeipa cha na riahphana châ aw ta, Na phei khoheih liata a ao awpa tawhta a vaih aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tao theina na hnei khiahta cha, A to tlâhpazy châta hmo phapa pakhâ khah y.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na hnei thlâh hapa tlai ta, na vaih hnohta, “A di chy la, a vy heih mah y, Mylâ ei cha pie aw,” Na tah awpa châ vei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cha ngâ ta na kiapâh liata a pahrâpa, Na opa chô liata hmo chhiepa tao a chhuah khah y.
  </para>
  <para style="p">
    <verse number="30" style="v" />Châ pasasa leipa chyhsa cha, A chhâpa y leipa ta a dyuh khah y.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thachahra a hmâhpa chyhsa cha uahva leipa la, A lâpi kheihawhpa hmahta a tlyh khah y.
  </para>
  <para style="p">
    <verse number="32" style="v" />Palôh a kopa cha Abeipa châta pasichhihpa châ ta, Palôh patlâpazy deikua cha Abeipa ngâpa chyhsazy ama châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abeipa chhiesana cha hmoparaopa­ o liata y ta, Mosiapa pahrâna deikua cha byhnâ a pie tyh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mohnaotuhpazy cha mohnao ta, Areisipazy chô liata deikua ngiachhiena a palâsa tyh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Asopazy cha palyupalihna ryu to aw ei ta, Ahrupazy deikua cha nohzaona ama to aw.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ei sawchapawzy saih u, paw pachuna bie thei u la, Novâhna nama hnei thei nawpa ta nathlie teh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pachuna phapa ei cha pie ei hih, Ei ryhpa bie a heihsai khuh vy.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ei paw sawchapaw hâtipa ei châ nota, Ei nô ta a hmô chhôhpa nata a dao kawpa ei châ nota,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ei paw ta na pachu ta ei hnohta, “Na palôh ta ei biezy he khâchâ a vao sala, Ei biepiepazy he zyh la, hroh mah y.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sona tlua la, Novâhna tlua mah y; Ei pakah tawhta bie a puapazy my leipa la, Tleisai khah y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sona cha siesai khah y, A cha hrôbieh lymâ aw; A kyh pachâ mah y, A cha vaih lymâ aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sona thabypa cha he he a châ: Sona cha tlua la, Khâpa zydua hlâta novâhna tlua chai mah y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sona cha pasâhsa la, A cha cheihchalo aw; A pyhpahly la, A cha palyupalih aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngiachhiena pawpi na luh liata tawh aw ta, Lakho rônahpa a cha pakho aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ei sawchapawpa y, nathlie la, ei biezy a pyh mah y; Chatanachata na chhâ a pasi aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sona lâpi cha pachu na ta, Lâpi dopa liata ei cha chhihtha.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na sie nota châ pakhâpa y leipa aw ta, Nâ râ tita a chapia aw va chi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pachuna cha khâchâ patu la, Papua khao khah y; Na hrona châ ta, Liahsa a vao ha mah y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmoparaopa lâpi liata a ngia leipa la, Moleipa lâthlôh a chhih khah y.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cha lâpi liata sie leipa la, Khôkhâh ha mah y; Tleisai la, Sie lymâ mah y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmo ama parao ha tua leipa ta cha, A mô thei leipa ei ta; Chyhsa ama chapiasa ha tua leipa ta cha, Ama mo ku thei vei.
  </para>
  <para style="p">
    <verse number="17" style="v" />Paraona viahchhâ nie ei ta, Nôchhiena kresawhti ama doh tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mosiapazy lâpi deikua cha khihdei khaihpa hawh châ ta, Nohchhô locho a tlô hlâlei a khaih via lymâ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmoparaopazy lâpi cha zoh kaluh ha ta, Khâpa ma amâ chapia tahpa chhao pahno veih ei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ei sawchapawpa y, ei biezy nathlie la, Ei biereipazy lâta na nah pachôh mah y.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na mohmô tawhta pua leipa ei sala, Na palôh liata khâchâ a vao ha mah y.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sona nata novâhna cha a hmôtuhpazy châta hrona châ ta, Ama sapa zydua châta tlâhna a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na palôh pakhâta ta vaih mah y, Hrona tihnawh vaw puana châ tlôh ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bie hloh hneipa na pakah tawhta thy la, Dôveina bie chhao na hmao tawhta thy ha mah y.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na mo ta hmia lâ moh lymâ sala, Na mo vo chhao â dypa ta hmia lâ sai lymâ mawh sy.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na phei tlyna lâpi paraih la, Na lâsie a patlâ lymâ aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chachâh lâ tlyma chavei lâ tlyma tlei leipa la, Moleina hmo tawhta na phei pasie ha mah y.”
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ei sawchapawpa y, ei sona he nathlie la, Ei novâhna lâ he na nah pachôh mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chatanachata novâhna hnei aw chi ta, Na hmaozy ta pahnona â vao aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chanô ngâchhih leipa hmao cha kheihti hawhta a thlaoh ta, A pakah chhao sathaw hlâta a pahnia via.
  </para>
  <para style="p">
    <verse number="4" style="v" />Achhâna lâ deikua cha hmo khapa hawhta kha ta, Zaozi hâh nopa hawhta a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pheizy thina lâ zu ei ta, A pheizy ta Athihkhih lâpi amâ chhih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hrona lâpi kyh pachâ leipa ta, A lâthlôhzy pavia ta, Khataih lâ ma a sie tahpa pahno vei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chavâta ei sawchapawzy saih u, Tahmâ na nathlie u la, Ei pakah biezy he a heihsai khuh vy.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha hawhpa chanô cha a heihsai u la, A o chhikao chhao a hnia khuh vy.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chataleipatala na zachhihna mohropazy pie pathlei aw chi ta, Na hro chhôh kôzy chhao nôchhiepazy na pie pathlei aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khichhaipazy ta na thatlôna hmâpa ta lôhrâ a patlô pathlei aw ei ta, Na hriapasana chhao chihropa o lâ a sie pathlei aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na hro chhâna liata cha a hrô aw chi ta, Na sapa nata na pôhpa a rao khai tita cha,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Kheihtazieta ma chhoreina a hao na ta, Ei palôh ta rana kha a vaw papeisa vei tly!
  </para>
  <para style="p">
    <verse number="13" style="v" />Nâ pachutuhpazy ao vaw nathlie leipa na ta, Nâ chhihthatuhpazy lâ ei nah ei vaw pachôh vei tly?
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawpi ahmaohpakhyna liata, Maophyuh chhie ta ei maophyuh daihmâ hih,” na tah aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nâma tikhaoh tawhta ti doh la, Nâma tihnawh tawhta ti a lohpa doh mah y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tihnawhzy su to liata loh pathlahpa ta, Lâlaizy liata chavah tizy a loh awpa a châ ma?
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tihnawhzy cha nâma châ dei châ sala, Na hnohta a ypa khichhaipazy châta châ khah sy.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tihnawh cha byhnâ to sala, Na thyutlia no lapinô liata a ly mah y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ano cha sakhi chanôpa khochhih ngaitapa châ ta, Sathawh chanôpa pha ngaitapa a châ. A sâhpizy ta lôhrâ khâ cha patlôsa sala, A kyhpachâna iahzaipa ta khâ y mah y.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ei sawchapawpa y, khazia chanô ngâchhih leipa iahzaipa ta y aw chi ta, Apheinô hnôbia cha nâ pyhpahly aw?
  </para>
  <para style="p">
    <verse number="21" style="v" />Chyhsapa lâpizy cha Abeipa hmiakô liata y ta, A siena lâ maih Abeipa ta a moh tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmoparaopa cha a paraona khoheih liata a ao aw ta, A moleina chaori ta â ipa ta a chahry aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pachuna a phahlapa vâta thi aw ta, A hru tupa vâta a leidia aw.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ei sawchapawpa y, na vaih châta sôhkâ sopa la, Khichhaipa vyuhpa ta nâ dua khiahta cha,
  </para>
  <para style="p">
    <verse number="2" style="v" />Na pakah biezy liata a ao chi ta, Na pakah biezy ta a cha patu hapa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ei sawchapawpa y, Na vaih ku liata y ha chi ta, Chavâta he he tao la, Nâmasasyh ta a pachha mah y. A chatliepa ta vawh la, A panawh la, Na vaih cha a haw mah y.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mo a mô leipa sala, Na mo vo tla-uah hra khah sy.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sakathaipa tawhta sakhi â bohpa hawhta, Nâmasasyh ta a pachha la; Khoheih chôtuhpa ku tawhta pavaw â bohpa hawhta, Nâmasasyh ta a pachha mah y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nâ thathipa, hloia lâ vawh la, A hroziezy moh la, so ha mah y.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hloia ta abei hnei leipa ta, Hyutuhpa nata ryureituhpa hnei hra vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nopi daihti ta nie awpa pachô ta, Sâh hria daihti ta nie awpa a pahmaoh tyh
  </para>
  <para style="p">
    <verse number="9" style="v" />Hy thathipa, khachâ ma a zia aw chi ta, Khati ta ma nâ môpa tawhta na thyu aw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Buakha a môpa ta, Buakha tla-uah chi ta, Buakha ku chakhipa ta nâ pahâ chhôh ta;
  </para>
  <para style="p">
    <verse number="11" style="v" />Dyhchhiena ta hraotuhpa hawhta cha vaw tlô thlu aw ta, Phahlana ta chaihrai chhaopa chyhsa hawhta a cha vaw tlô thlu aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chyhsa dyutlai leipa, chyhsa moleipa cha, Pakah hloh chhaota â khie tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A mo ta mopasihpa ta, A phei ta hria ta, A kudy ta a dy tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyhsa parao khohna palôh phaopa ta, Hmo chhiepa tao a chhuah ta, Achhaihna chi a tu lymâ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chavâta chhiena ta eikhapi ta vaw tlô thlupa ta, Sôkha ta paraopa châ aw ta, Taopathi heih theipa châ khao aw vei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa â haopa hmo miacharu y ta, A châta pasichhihpa miasari a y.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chazy cha, â khotlâhpa mokhaohzy, Paleih haihthaipa, Paraona a hnei leipa thisaih a palopa kuzy,
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmo pha leipa tao a chhuahpa palôh, Paraona lâ a râpa ngiahly thatlôpa,
  </para>
  <para style="p">
    <verse number="19" style="v" />Haipa hu a sopa pahnokheituh pakheipa nata Unawhzy achhaihna chi tutuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ei sawchapawpa y, na paw biepiepa a ngiah la, Na nô pachuna a heihsai khah y.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na palôh liata khâ châh sala, Na rao liata khâ a ao mah y.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na sie nota cha chhihthapa ta, Nâ zia tita cha vaih aw ei ta, Na thyu tita bie ama châ chho aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Biepiepa cha meiôh châ ta, Pachuna cha khaihna châ ta, Chhoreina rana cha hrona lâpi a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chanô moleipa tawhta cha vaih aw ta, Apheinô paleih pahniapa tawhta a cha vaih aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />A chhithaina cha na palôh ta tlaichhai leipa sala, A mopadei ta a cha patu awpa a pasaih khah y.
  </para>
  <para style="p">
    <verse number="26" style="v" />Viahchhâ tlâ kha ta âzuahnô chalei theipa châ ta, Vahpa chhaopa chanô a châna a hro zachhihna deikua a pahlei aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyhsa ta a chachôhna liata mei soh sala, A chysiazy kâ leipa ta a y aw ma?
  </para>
  <para style="p">
    <verse number="28" style="v" />Chyhsa ta meihei iapa chô liata sie sala, A pheizy u leipa ta a y aw ma?
  </para>
  <para style="p">
    <verse number="29" style="v" />A vaih lapinô lâ a ngiapa chhao, cha hawhta y hra aw ta, Cha chanô a hriapa maih cha hrie leipa ta pua aw veih ei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Parutuhpa ta a nodipa papai nawpa ta a paru khiahta cha, Chyhsazy ta parutuhpa cha mohnao hlei veih ei;
  </para>
  <para style="p">
    <verse number="31" style="v" />Patupa a châ khiahta deikua cha, A lie sari ta a thô awpa châ ta, A hneipa zydua a pie khai awpa a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chanô liata a pheipa cha, Hmo a pahno thai leipa châ ta; Cha hawhpa hmo a taopa cha, Anosasyh â paraopa a châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hmaphaohpa nata maophyuhpa ta y aw ta, A nohzaona a hnao pathaih theipa châ aw vei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chanô vahpa cha hiatliana vâta a hie thata hâ aw ta, Phuh a lana noh liata ngiachhiena hnei aw vei.
  </para>
  <para style="p">
    <verse number="35" style="v" />Achatlaina sôh a pyh leipa aw ta, Kuhria hluhpi pie hra la, A palôh châ hlei aw vei.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ei sawchapawpa y, ei biezy zyh la, Ei biepiepazy a vao thlâh ha mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ei biepiepazy zyhpa ta hroh la, Ei pachuna cha na mosawpa hawhta a vao mah y.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na kuparozy liata a ky la, Na palôh lôphiapa liata roh mah y.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sonô hnohta, “Ei sietanô na châ,” tah la, Pahnona hnohta, “Ei viasa phapa,” tah mah y.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sona ta chanô sihryhpa tawhta cha vaih aw ta, Apheinô reikah pahniapa tawhta a cha vaih aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ei o opy samokaw tawhta, Khôtho lâ sai na ta,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmo a pahno thai leipa satlia pakha tlai cha, Sona a phahlapazy hry liata hmô na ta, Thyutliapazy hry liata a hmia ei siah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chanô yna kiapâh khiliah liata a khie laih ta, A o lâpi a chhihpa ta,
  </para>
  <para style="p">
    <verse number="9" style="v" />Zâlâ azo hrahri ta, Zâ zohna ry liata chanô cha a pangai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Moh teh u, âzuahnô hawhta a tobi ta, Achhuahna a hneipa chanô ta thlai a vaw dy.
  </para>
  <para style="p">
    <verse number="11" style="v" />Reih hluhpa nata lieluh pâpaw a zohpa châ ta, O liata a phei ngia a ryh leipa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thiapawh khiliah liata y ta, Tahmâ sôdaohna su liata y heih ta, Su to liata a byh ta a hâ tyhpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Satliapa cha thlai patupa ta sy ta, Hmia kai kawpa ta a hnohta,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Aryhna hlâna atheihnazy ei hlâ awpa châ ta, Tanoh kha ei bietai ei patlô haw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chavâta nâma a tyh awpa ta vaw pua na ta, Cha tlua chaimâh na ta, Tahmâ ei cha hmô ha hih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ei hmohphaw chhao khuna pohzy ta khu ha na ta, Izi pala rih dipa poh chapaipa tlai ta ei khu haw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Deiryh ropahâhpa ta ei rakhô roh pahâhsa na ta, Lilipaw nata lôiasoh ropahâhpazy ei hry haw.
  </para>
  <para style="p">
    <verse number="18" style="v" />A vy teh, azozâkhihdei kyhpachâna ti doh sih la, Kyhpachâna ta khiahlôh a patlâh tua ei si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ei vahpa lâhlapi lâ khitlyh ha ta, O liata y vei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tâkâ sykhao kha a phao ta, Thla pôlô hlâlei cha vaw tlô aw vei,” a tah.
  </para>
  <para style="p">
    <verse number="21" style="v" />A reikah thaina ta satliapa cha pahnie ta, A reih pahniana ta a sydie haw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Viahchao tôhpa thiena su lâ a siepa hawhta, Ahrupa cha thlai ama patupa hawhta, Satliapa ta chanô cha thlai a pazi haw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pavaw ta khoheih liata thlai â chohpa hawhta, Châtai ta a pathi a papyu hlâlei cha, A hmotaopa chata a hrona a pahlei aw tahpa pahno vei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chavâta sawchapawzy saih u, Tahmâ na nathlie u la, Ei biereipazy he a phapa ta pachâ teh u.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chanô hrozie lâ cha nama palôh a heih leipa sala, A lâpi lâ tlei khuh vy.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chyhsa hluhpi hmah paphao ha ta, Zasâh manôh a thie ha ei.
  </para>
  <para style="p">
    <verse number="27" style="v" />A o cha Athihkhih lâpi châ ta, Thina chhôhpadâhpa lâ a zupa a châ.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sona ta awh ta, Novâhna ta a ao ki a pasâh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lâthlôh kiah su a sâhpa liata zy, Lâpi atyhna su liata zy,
  </para>
  <para style="p">
    <verse number="3" style="v" />Khih thokhy chhikao kiah liata zy, Hawka liata zy a duah ta, Hetana heta ao paro ngaitapa ta a awh tyh:
  </para>
  <para style="p">
    <verse number="4" style="v" />“Hy nâmo, chyhsazy saih u, ei cha aw ei hih, Ei awna he chyhsa sawzy lâta a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hy nâmo, sona a phahlapazy saih u, Sona a chu u la; Nâmo, ahrupazy saih u, Pahnona a chu teh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nathlie teh u, bie phapazy reih aw na ta, Ei hmao tawhta bie dopa a vaw pua aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ei pakah ta biehmeiseihpa reih aw ta, Paraona cha ei hmao châta pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ei pakah bie zydua asiapa châ khai ta, Bie akopa tlyma, bie hloh hneipa tlyma y tlâ vei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsa novâhpa châta cha sia khai ei ta, Pahnona a hmôpazy châta chhao amâ do khai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tâkâ vyuhpa ta ei pachuna a la u la, Ngôh phapa vyuhpa ta pahnona tlao a la teh u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sona cha lôsôhpazy hlâta pha via ta, Na tlaichhai kawpa khâpa nata hmah Pakhopâ theipa châ vei.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Sona ta hetana heta a tah: Kei, sona he pahnona nata pahrâ khoh na ta, Novâhna nata pachâhpady thaina ei hnei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abeipa china cha moleina a haopa a châ. Apalaina nata apasâhsana a hao na ta, Moleina hro zy ei hao; Phichhyhpa bie chhao ei hao.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ryhrao thaina nata sona dopa zy cha kei eih châ ta, Novâhna hnei na ta, thatlôna ei hnei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keima baona ta beizy ryureih ei ta, Ryureituhpazy ta ryureina dopa ama siekhei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keima baona ta beimachâzy ryureih ei ta, Nôpawpa zydua ta â dopa ta ryu ama reih tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kyh nâ pachâtuhpazy cha ama kyh pachâ na ta, Palôh hmeiseihpa ta nâ tluapazy ta eina hmô ei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hneirôna nata zachhihna zy ei hnohta y ta, Hneirôna nata siana tlyuhpa chhao ei hnohta a y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Keima thei cha ngôh hlâta pha via ta, Ngôh suapa hlâ chhao ta a pha via; Ei kôvei chhao tâkâ suapa hlâta a pha via.
  </para>
  <para style="p">
    <verse number="20" style="v" />Siana lâpi a chhih na ta, Adona lâthlôh ei chhih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kyh nâ pachâtuhpazy hnohta ryuto pie ei na ta, Ama ryubyhzy ei pabiepa ei.
  </para>
  <para style="p">
    <verse number="22" style="v" />“ Abeipa ta hmo a tao tua nota na tao ta, Hlâno ta a tao tuachaipa ei châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tlyzaw ta a ypa châ na ta, Leilô y hlâta taopa châ na ta, Tao tuachaipa ei châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ti athupa y hlâta y ha na ta, Ti hluhpi a palipa tihnawhzy y hlâta ei y haw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tlâhpizy yzie a hnei hlâta pih ha na ta, Tlâhthlôhzy ama y hlâta ei pih haw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leilô nata lyurâhpazy a tao hlâta pih ha na ta, Khizaw dohlei hmiatuachaipa a y hlâta ei pih haw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Avâzy a padua nota y ha na ta, Ti athupa chô liata vâphuh a chhôh nota ei y haw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chô lâ avâzy a pa-i nota y ha na ta, Ti athupa tihnawhzy a tao nota ei y haw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tizy ta a biepiepa ama parao lei nawpa ta, Tilaipi râhrizy taopa ta leilô abôna a tao no khata ei y haw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rai a thaipa hawhta Abeipa kiapâh liata y na ta, A noh chareih ta â lyna châ na ta, A hmiakô liata khâ ei ly tyh.
  </para>
  <para style="p">
    <verse number="31" style="v" />A pahrâna khizaw liata thaphapa ta y na ta, Chyhsa sawzy chô liata ei ly kaw tyh.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Chavâta sawchapawzy saih u, Tahmâ na nathlie teh u: Ei lâpi a chhihpazy cha ama hu â hieh aw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pachuna nathliepa ta so u la, Dytha khuh vy.
  </para>
  <para style="p">
    <verse number="34" style="v" />Noh chareih ta ei chhikaozy lâ a vypa ta, Ei dôhpachhôh ochhizy liata hâ tyh ta, Ei bie a nathlie tyhpa cha a nohlao na.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nâ hmôpa maih hrona a hmôpa châ ei ta, Abeipa khokheina ama to aw.
  </para>
  <para style="p">
    <verse number="36" style="v" />Nâ hmô leipa deikua cha anosasyh ta hmah a paphao ta, Nâ haopa zydua chhao thina kyh a pachâpa ama châ.”
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sonô ta a o sa ta, Otôh tôh sari a bô.
  </para>
  <para style="p">
    <verse number="2" style="v" />A sahrohzy thiepa ta, A kresawhtizy pahlao ta, A tlâhkhai â chhuanoh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khihpi su sâh chaipazy tawhta awh awpa ta, A laihsazy tuah ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Sona a phahlapa cha he lâ a vy mawh sy,” tah ta; Pahnona a phahlapa hnohta,
  </para>
  <para style="p">
    <verse number="5" style="v" />“A vy la, ei viahchhâ nie la, Ei kresawhti pahlao chiehpa he doh mah y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hruna hrozy siesaipa ta hrona hnei la, Novâhna lâpi a chhih mah y,” a tah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chyhsa a khotlâhpazy a chhoreipa cha, Ano hmâchhâh taochhiena a tyh ta; Chyhsa moleipa a rapa chhao, Ano hmâchhâh hmah a phaoh tyh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Akhotlâh kawpa chyhsa la ra hlei khah y, A châ hao pathlei aw na; Chyhsa sopa ra la, Kyh a cha pachâ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsa sopa cha pachu la, So via rili aw ta; Chyhsa siapa chhao na pachu khiahta cha, A thaina a pôh rili aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa china cha sona athaona châ ta, Mo Pathaihpa pahnona cha novâhna a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na nohzy pasisa aw na ta, Na hro chhôh kôzy ei baichha aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na vaw sopa chhao ta, Nâma châta soh chi ta; Nâ khotlâh khiahta cha, Nâ pyly ta pasa na tao aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chanô hrupa cha a pyury ru kaw ta, Sona a phahla ta, khâpa hmah pahno vei.
  </para>
  <para style="p">
    <verse number="14" style="v" />A o ochhi liata a tyuh tyh ta, Khihpi su sâh chaipazy liata dyuchhai liata chhao a tyuh tyh ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama lâpi liata a sie haipa, Ano a chapiapa maih aw ta,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Sona a phahlapa cha he lâ a vy mawh sy!” tah ta. Pahnona a phahlapa hnohta,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Parupa ti cha thlôh ta, Arulâta viahchhâ niepa chhao a pahâh ngaita,” a tah.
  </para>
  <para style="p">
    <verse number="18" style="v" />Châhrasala ano a pangaipa ta, Athihpazy cha liata y ei ta, A chyhsa hruapazy chhao, Athihkhih a thu chaipa liata a ypa ama châpa pahno vei.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />He he Sawlawmaw biesozy a châ: Sawchapaw sopa ta a paw palysa ta, Sawchapaw hrupa deikua cha a nô pachârôhna a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Moleina ta sôh hmôpa cha athôhna y leipa ta, Siana deikua cha thina tawhta a pachha tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosiapa nodi awpa cha Abeipa ta pasaih leipa ta, Moleipa aohkhopa deikua cha a pakhâ ha tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ku thathipa ta dyhchhiena tlôkhei ta, Ku tiamapa deikua cha hneirôna a tlôkhei ty.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nopi daihti liata a pachô pakhypa cha sawchapaw sopa châ ta, Sâh hria nota a mô thlâh hapa sawchapawpa deikua cha nozana a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosiapa luh liata vânoh y ta, Moleipa pakah deikua cha nôchhiena ta a pahly.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosiapa atheithlâhna cha vânoh tona châ ta, Moleipa moh deikua cha a thuzao aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palôh sopa cha biepiepazy a pyh ta, Ahrupa reikah hluhpa deikua cha a pao aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Â dopa ta a siepa cha â bohpa ta sie ta, A lâpi a pakosapa deikua cha â lâ thlyu tyh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyhsa a mopasihpa cha nôpona tlôkhei ta, Ahrupa reikah hluhpa chhao a pao aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosiapa pakah cha hrona tihnawh châ ta, Moleipa pakah deikua cha nôchhiena ta a pahly.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahaona ta ahryuna papua ta, Kyhpachâna deikua cha paraona zydua a khu tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Novâhna a hneipa hmaozy liata sona hmôpa châ ta, Pahnona a phahlapa châta deikua cha a ky châta sôsi a y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Asopa cha pahnona pachô ta, Ahrupa pakah deikua cha raona a pahniasa tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chyhsa hneirôhpa sôh cha â bohna khihpi thokhy châ ta, Sipasapazy dyhchhiena cha ama raona a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosiapa hriapasana cha hrona tlôkhei ta, Moleipa athôhna deikua cha paraona a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pachuna a pyhtuhpa cha hrona lâpi liata sie ta, Rana a dythapa deikua cha mohropazy â chhi chhei tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahaona a phihtuhpa cha hmao haihthaipa hnei ta, Kyh reina bie a papuapa cha ahrupa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bie hluhpi a reihpa cha paraona a phahla leipa ta, A hmao a sohsi theipa deikua cha chyhsa sopa a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosiapa paleih cha tâkâ suapa châ ta, Moleipa palôh deikua cha khâpa hmah a phuh vei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosiapa hmao ta chyhsa hluhpi pasa ta, Ahrupa deikua cha pahnona a phahlapa ta a thi tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abeipa byhnâ cha chyhsa pahneirôhsa ta, Pachârôhna baichha tyh vei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahrupa châta hmo doleipa taopa cha saisopa hawh châ ta, Novâhpa châta deikua sona cha hmo sôhpa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Moleipa cha a chipa hawh tlai ta a chô liata vaw tlô aw ta, Mosiapa khopa deikua cha piepa a châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khisô vaw pathli ta, Moleipa y khao leipa ta, Mosiapa deikua cha chhâzaw lôbô a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hâh châta kresawhti thaopa nata mo châta meikhuh hawhta, Thathipa chhao ano a tuahtuhpa châta a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abeipa china cha hro pareihna châ ta, Moleipa kôzy deikua cha pachhohsapa a châ aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosiapa hnabeiseihna ta alyna tlôkhei ta, Moleipa saduthliena deikua cha a leidia aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abeipa china cha seina hnei leipa châta a thokhy châ ta, Moleina hmo a taotuhpazy châta deikua cha raona a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mosiapa cha râh tawhta papuapa châ leipa aw ta, Moleipa deikua cha râh liata pahrâ aw vei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosiapa pakah ta sona papua ta, Nôchhiepa paleih deikua cha taipa a châ aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mosiapa hmaozy ta a pyh tlâhpa pahno ta, Moleipa pakah deikua cha nôchhiena bie a reih tyh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khopathliahna doleipa cha Abeipa châta hmo pasichhihpa châ ta, Khopathliahna dopa deikua cha â ly tyh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Apalaina a vaw y nahta, Maophyuhna vaw y ta; Areisipa deikua cha, Sona a hneipa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chyhsa dopazy cha amâ dona ta âmo chhihtha ta, Piehpiepazy deikua cha âmo zietiahna ta a pahleipadia tyh ei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiehâhna noh liata cha, Hneirôna ta phahnaina hnei khao leipa ta; Siana deikua ta cha, Thina tawhta a pachha tyh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Phapakipa cha a siana ta a lâpi patlâsa ta, Moleipa deikua cha ano moleina ta a pao tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Adopazy cha amâ dona ta âmo pachha ta, Piehpiepazy deikua cha âmo aohraohna liata amâ ao tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moleipa cha a thi nahta, A hnabeiseihna lei pâ ta, Hneirôh awpa ta a saduthliepa chhao a lei ha tyh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosiapa cha nôpona tawhta pachhapa châ ta, Moleipa deikua cha nôpona lâ tlao â ngia tyh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khazohpa a pachâ leipa chyhsa cha, A pakah ta a vaih parao ta, Mosiapa deikua cha, A pahnona ta a vaih a pachha tyh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosiapa chô liata hmo pha a tlôh nahta, Khihpi a ly ta; Moleipa a leidia nahta, Thaphapa ta ama rahao tyh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosiapazy byhnâ ta khihpi cheihchalo ta, Moleipazy pakah ta khihpi a parao tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A vaih a mohnaopa cha pahnona a phahlapa châ ta, Chyhsa novâhpa deikua cha â chalih tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chyhsa kyhchhie a reih thaipa cha bieruzy phuah tyh ta, Ngâchhihna palôh a hneipa deikua cha bie a nyu thei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chhihthana y leina liata cha phopi pao tyh ta, Ryhrao thaipa hluhna liata deikua cha abohna a y tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khichhaipa châta sôhkâ a sokhâhpa cha pasa tao aw ta, Sôhkâ a sokhâh leipa deikua cha palôh pahâpa ta a y aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngiachhiena a hneipa chanô cha zachhihna hnei ta, Thachahra a hmâhpa chyhsazy ta hneirôna ama hnei.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zawngiah theipa chyhsa cha ano hro châta hmo phapa tao ta, Chyhsa chhiepa deikua cha ano sapa châta pasana a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Moleipa cha dôveina hmâpa ta hlao tyh ta, Siana chi a tupa deikua cha lymâ dopa a hmô tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Siana liata â ipa ta a duahpa cha hrona to aw ta, Moleina hmo a chadaituhpa deikua cha a thi aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palôh akopazy cha Abeipa châta pasichhihpa châ ei ta, Seina hnei leipazy hrozie deikua cha â lyna a châ tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hmeiseihta ta moleipa cha hrie leipa ta y leipa aw ta, Mosiapa pathlazy deikua cha pa­chhapa ta ama y aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chanô chhithaipa pachâna a hnei leipa cha, Vao hmaothy liata ngôh rahy pataohpa hawhta a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosiapa khopa cha phana ta chhâ tyh ta, Moleipa saduthliena deikua cha hiehâhna ta a chhâ tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A saipa ta hiepatlapa cha pôh rilina châ ta, Byuhpa hleikhô ta riakhiehpa deikua cha phahlana a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chyhsa riaphapa cha a dyh pha aw ta, Ti a baotuhpa cha anosasyh â baopa a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />A sâh a pasaih leipa cha chyhsa ta chhiesapa aw ei ta, A zuahtuhpa luh chô liata deikua cha byhnâ a y aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Phahnai khohpa ta phana a tluapa cha khokheina hmô ta, Chhiena a tluapa deikua cha chhiena ta a vaw tlô thlu aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />A hneirôna a ngâchhâpa cha pao aw ta, Mosiapa deikua cha sibiepa hrohpa hawhta a laiseih aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ano chhôhkha a patypamâtuhpa cha ziza ryu to aw ta, Ahrupa cha palôh sopa chakaotuhpa a châ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mosiapa thei cha hrona tho châ ta, Chyhsa hro a pahnietuhpa cha asopa a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosiapa hmahta alei liata viarithôpa ama châ khiahta cha, Moleipa nata hmoparaopa chhochhi cha, Khatlu ta pasa viapa ta viarithôpa ma ama châ aw tly!
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chhoreina a pasôpa cha pahnona a pasôpa châ ta, Rana a haopa deikua cha râhsa hawhpa a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyhsa phapa cha Abeipa kho­kheina hmô aw ta, Moleina palôh a phaohpa deikua cha thailei a pachâ aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Moleina hmo taona tawhta ahy hmah a duah leipa ei ta, Mosiapa thari deikua cha phiapa châ aw vei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chanô phapa cha a vahpa châta lakho châ ta, Nozana a vaw tlôkheipa chanô deikua cha, A vahpa ru a pahmytuhpa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosiapa pachânazy cha a do ta, Moleipa ryhraona deikua cha dôveina a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moleipa biezy cha thisaih palo awpa ta a byh ta, Adopa pakah deikua cha âmo a pachha tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moleipazy cha thypa châ ei ta, y khao veih ei; Mosiapa pathlazy deikua cha amâ duah lymâ aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pahnona phapa a hneipa chyhsa cha reithaina hlao ta, Palôh chhiepa chyhsa deikua cha mohnaona a hlao tyh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsa pipawpa hawhta â tao ta nie a phahla thlâh hapa hlâta cha, Chyhsa nawhpa châ ta chakaotuhpa hneipa a pha via.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosiapa cha a sahroh hrona pachâ peimawh ta, Moleipa zawngiahna deikua cha nôchhiena a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />A chhaohlei a palietuhpa cha, Nie awpa hluhpi hnei aw ta; Hraoleipa a chadaituhpa deikua cha, Pahnona â phahla.
  </para>
  <para style="p">
    <verse number="12" style="v" />Moleipa cha hmoparaopa hraona sôh uahva ta, Mosiapa thari deikua cha a pathei aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Moleipa cha ano hmao paraona liata a ao ta, Mosiapa deikua cha tymâna a khôkhâh tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyhsa cha a reikah thei tawhta hmo phapa ta a lôhrâ patlô ta, Ano ku hmotaopa tlai ta ano lâ a vaw lie thlu heih tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahrupa cha ano mokhaoh liata a lâpi a do ta, Asopa deikua cha chhosina a nathlie tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahrupa cha a ruchhôna thlai a lâ tyh ta, Asopa deikua cha hmia pachhiena pahno lei â pachâ tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pahnokheituh ngâchhihpa cha biedopa reih ta, Pahnokheituh pakheipa deikua cha haipa bie a reih tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zaozi chhôpa hawhta pasapa ta bie a reihpa y ei ta, Asopa paleih deikua cha tlâhna a châ tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Biedopa hmao cha chhâzaw a daih ta, Haipa paleih deikua cha buakha dei â daih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmo chhiepa tao a chhuahpazy palôh liata dôveina y ta, Adyhna a taotuhpazy deikua cha alyna ama hnei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosiapazy chô liata hmo chhiepa tlô leipa ta, Moleipazy deikua cha tymâna ta ama bie.
  </para>
  <para style="p">
    <verse number="22" style="v" />Paleih haihthaipa cha Abeipa châta pasichhihpa châ ta, Âdopa ta a taotuhpazy deikua cha â ly ei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Asopa cha a pahnopazy nyu ta, Ahrupa deikua cha hruna bie a phuah tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tiamapa ku ta ryureina chaba aw ta, Thathipa deikua cha ku rai hriatuhpa a châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Palôh rietheina ta chyhsa tha pachhâ ta, Bie phapa deikua ta a palysa tyh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mosiapa cha a vaih châta chhituhpa châ ta, Moleipa lâpi deikua cha ama paviana a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thathipa cha a sa kapa rao awpa hnei leipa aw ta, Tiamapa deikua cha dyhphana ryusôhpa a hnei aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Siana lâpi liata hrona y ta, Cha lâthlôh liata cha thina y vei.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sawchapaw sopa cha a paw pachuna nathlie ta, Chhorupa deikua cha chhoreina nathlie khoh vei.
  </para>
  <para style="p">
    <verse number="2" style="v" />A pakah thei tawhta chyhsa ta hmo phapa nie aw ta, Nôchhiepa khona deikua cha atudaina a châ tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pakah a sohsi theipa cha a hro pabohsa ta, A hmao a kawhpa deikua cha a hro a rao tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thathipa hro cha hmo khoh kaw ta, Châhrasala a hnei theipa y leipa ta; Tiamapa hro deikua cha, Lôhrâtlôna taihta a hnei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosiapa cha haipa a hao ta, Moleipa deikua cha nozana nata nohzaona a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siana ta adopa ta a ypazy hrôbieh ta, Moleina deikua cha moleipa a papao tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chyhsa pakha cha anosasyh hneirôhpa hawhta â tao ta, Châhrasala a hneipa y leipa ta; Chyhsa hropa ta sipasapa hawhta â tao ta, Châhrasala sôh hluhpi a hnei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyhsa ta a sôh ta a hrona a chatlai ta, Sipasapa deikua cha pachhiparyna a tyh vei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosiapa khaihna cha khaih pha ta, Moleipa meiôh deikua cha pachhaipa a châ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Apatahsana cha ahryuna dei papua ta, Pachâna a latuhpazy deikua cha sona ama hmô tyh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dôveina ta sôh hmôpa cha pai aw ta, Hriapasana ta hmôpa deikua cha a pôh aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hnabeiseihna pahawhsapa ta palôh pasasa ta, Saduthliepa a vaw tlôpa deikua cha hrona tho a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bie a mohnaopa chyhsa cha anosasyh ta raona a tao ta, Biepiepa a chizapa deikua cha lymâ a hmô aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chyhsa sopa pachuna cha hrona tihnawh châ ta, Thina khoheih ama khôkhâh thei aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pahnona phapa cha khokheina tona châ ta, Piehpiepazy lâpi deikua cha ama raona a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Asopa cha pahnona ta hmo tao ta, Ahrupa deikua cha a hruna a paziah tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lyuhchâpa moleipa cha tymâna a tyh ta, Vyuhtuapa ngâchhihpa deikua cha tlâhna a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pachuna a khoh leipa cha dyhchhiena nata nohzaona ta tlô thlu aw ta, Rana a pyhpa deikua cha palyupalihpa a châ tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khopa hmôpa cha hro châta thlôh ta, Moleina siesaipa deikua cha ahrupazy châta pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chyhsa sopa a pakyhpa cha ano chhao soh aw ta, Ahrupazy viasa deikua cha pasa a tao aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Moleipazy cha chhiena ta chadai ei ta, Mosiapazy deikua cha phana ama hmô tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsa phapa cha a samohzy to awpa taihta ryu siesai ta, Moleipa sôh deikua cha mosiapa châta pachôpa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sipasapa leipalie ta niedo hluhpi papua ta, Châhrasala ryurei doleipa vâta pahleipadiapa a châ tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sôsi a hmâh khoh leipa cha a sawchapawpa a haopa châ ta, A kyh a pachâpa deikua cha thlai a chhorei tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosiapa cha a hro lôhrâ patlôna khi hnei ta, Moleipa py deikua cha a rua aw.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chanô sopa cha a o sa ta, Chanô hrupa deikua cha ano ku tlai ta a o a parao.
  </para>
  <para style="p">
    <verse number="2" style="v" />Â dopa ta a hrohpa cha Abeipa a chipa châ ta, Hrozie akopa deikua cha Abeipa a mohnaopa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahrupa pakah liata apalaina sôsi y ta, Asopazy hmao deikua cha âmo a pabohsa tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Viahchao tôhpazy y leina liata cha sachâki pathaih ta, Châhrasala kôvei phana cha viahchao tôhpa thatlôna vâta a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pahnokheituhpa ngâchhihpa cha haipa bie reih leipa aw ta, Pahnokheituhpa pakheipa deikua cha hai­pa biezy a papua tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa a mohnaopa cha sona tlua ta hmô leipa ta, Novâhpa deikua cha a naosiapa ta a pahnona a hmô thei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahrupa cha a hlasai mah y, Ano tawhta nâ chu awpa biesozy y vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asopa sona cha a sie nawpa lâpi pahnosa ta, Ahrupazy hruna deikua cha dôveina a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahrupazy cha thaileichâna hlâna pahneisao ei ta, Adopazy deikua cha ngiahthaina liata amâ ly tyh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palôh cha ano ngâlâh ta a pasana pahno ta, Â lyna liata chhao khôtho chyhsa a lykheipa y veih ei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moleipa o cha paraopa châ aw ta, Adopa poh o deikua cha vânoh topa ta a y aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chyhsapa pachâ ta lâpi dopa a lyupa y ta, A chhâna lâta deikua thina lâpi a châ tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pahneina liata chhao palôh pasana y thei ta, Thaphana chhao a chhâna lâta cha pachârôhna lâta a pua thei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palôh hnôhsypa cha a hrozie theizy ta pabiepa châ aw ta, Chyhsa phapa chhao a hrozie theizy ta pabiepa a châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sona a phahlapa cha bie to zo ta, Chyhsa sopa deikua cha a lâpizy a pachâ tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Asopa cha a chado kaw ta, Hmo pha leipa tao vei; Ahrupa deikua cha a riah pha kaw ta, Pachâ tua leipa ta hmo a tao tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathi pachhohpa cha hru kawpa ta hmo tao ta, Hmo chhiepa tao â chhuahpa chhao a haopa a châ tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sona a phahlapazy cha hruna ryu to ei ta, Asopazy deikua cha pahnona lakho pakhopa ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chyhsa chhiepazy cha chyhsa phapazy hmiakô liata panawhsapa châ ei ta, Moleipazy chhao mosiapazy chhikao liata panawhsapa ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sipasapa cha a vaih chhao ta a hao ta, Hneirôhpa deikua cha viasa hluhpi a hnei.
  </para>
  <para style="p">
    <verse number="21" style="v" />A vaih a mohnaopa cha moleipa châ ta, Dyhchhiepazy chô liata a ria a phapa deikua cha vânoh a to aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmo pha leipa tao a chhuahpazy cha viavi tyh ei ta, Hmo pha tao a chhuahpazy deikua cha kyhpachâna nata biehmeiseihpa ama hlao tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hriapasana to liata athôhna y ta, Reih hluh thlâhthlipa deikua cha dyhchhiena a tlôkhei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Asopazy lakho cha hneirôna châ ta, Ahrupazy hruna deikua cha hruna dei a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pahnokheituhpa dopa cha hronazy pachha ta, Pahnokheituhpa pakheipa deikua cha haipa bie â duakhei tyh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abeipa a chipa chyhsa cha a riahpha ta, A sawzy ta a chhai awpa ama hnei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abeipa china cha hrona tihnawh châ ta, Abeipa a chituhpa cha thina khoheih a khôkhâh aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Phopi maluh hluhpa cha abei rônahna châ ta, Phopi a y vei khiahta cha ryureituhpa chhao a rao aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiehâhna kyh liata nainôsôpa chyhsa cha novâhna a hnei hluhpa châ ta, Thlai ta a hie a hâh thlâh ha tyhpa chyhsa deikua cha hruna a cheihchalo tyh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Palôh alyna cha sapa tlâhna châ ta, Hiatliana deikua cha ru hmyna a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sipasapa a tlybaipa cha a Taotuhpa palôh a pasasapa châ ta, Phahlapazy a ngiachhiepa deikua cha a Taotuhpa a palyupalih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Moleipa cha a hmo chhie taopa vâta pao ta, Mosiapa deikua cha thina liata hnabeiseihna a hnei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Novâhpa palôh liata cha sona a chalih thlâh ha ta, Ahrupazy hry liata deikua cha â chaluah lymâ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Siana ta râh cheihchalo ta, Moleina deikua cha phopi to châta nohzaona a châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />So kawpa ta hmo a taopa chakaotuhpa cha, Abei ta khokhei ta; Nozana a tlôkheituhpa chakaotuhpa chô liata deikua cha, Abei pathiiana ta a tla thlu tyh.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Achhyna naipa ta pathiiana padia ta, Reih chahrâhpa deikua ta hiehâhna a pathyu tyh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Asopa paleih ta pahnona papua ta, Ahrupa pakah deikua cha bie hrupa a reih tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa mo cha su to liata y ta, Hmo chhiepa nata hmo phapa zy a sai thlâh ha tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Paleih naipa cha hrona tho châ ta, Paleih haiphiahpa deikua cha palôh a pakeichheih tyh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahrupa cha a paw pachuna mohnao ta, Asopa deikua cha a paw rana a uasa tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosiapa o liata cha sôh hluhpi y ta, Moleipa sôh hmôpa deikua cha tymâna a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Asopazy hmao cha pahnona hiepatla ta, Ahrupazy palôh deikua cha cha hawhta châ vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moleipa atheihna hlâpa cha Abeipa châta pasichhihpa châ ta, Chyhsa dopa thlahchhâna deikua cha Abeipa ta â ly.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moleipa lâpi cha Abeipa châta pasichhihpa châ ta, Siana lâpi a chhituhpa deikua cha Abeipa ta kyh a pachâ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lâpi a heihsaituhpa châta chhoreina ru ngaitapa y ta, Rana a haotuhpa chhao a thi aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Athihkhih nata Chhokhih hmahta Abeipa hmiakô liata â lâ khai khiahta cha, Chyhsa sawzy palôh chhochhi cha khatlu ta ma a hmiakô liata â lâ aw tly!
  </para>
  <para style="p">
    <verse number="12" style="v" />Chyhsa mohnao a hmâhpa cha rana pasô leipa ta, Chyhsa sopa pangai aw vei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Palôh thaphapa ta hmia alyna tao ta, Palôh vâsâhna deikua cha thlahpa hro tha a pachhâ tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Novâhpa palôh cha pahnona tlua ta, Ahrupa pakah deikua cha hruna a nie tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dyhchhiepa châta cha noh zydua a pha leipa sai châ ta, Palôhtlâh a paohpa châta deikua cha kyhchhi â zao thlâh haw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa china chôta a chyhta hneipa cha, Sôh hluhpi hnei ta a tymâpa hlâta a pha via.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahaona chôta viahchao tôhpa thawhpa sa niepa hlâta cha, Kyhpachâna chôta âhna pati niepa a pha via.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chyhsa pathichhiepa cha ahryuna pathyu ta, Nônaipa deikua cha aeichhiana a padia tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thathipa lâpi cha ahloh thih hawhta châ ta, Adopa lâthlôh deikua cha lâlai a raih pha kawpa a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sawchapaw sopa cha a paw palysa ta, Ahrupa deikua cha a nô a mohnao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hruna cha sona a phahlapa châta â lyna châ ta, Chyhsa novâhpa deikua cha lâpi patlâpa liata a sie tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ryhraona phapa a y leina liata cha achhuahnazy a hlaotloh thei leipa ta, Pasopakâtuhpa ama hluhna liata deikua cha achhuahnazy a hlaotloh tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thlai ta achhyna pie tyhpa ta chyhsa palysa ta, A daihtita ta bie rei tyhpa cha a pha kaw dia!
  </para>
  <para style="p">
    <verse number="24" style="v" />Asopa châta cha hrona lâpi he â sâh lâta kiah lymâ ta, Chatanachata â hnai lâta Athihkhih lâpi a tleisai thei ha aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Apalaipa o cha Abeipa ta parao ta, Nôhmei râhri deikua cha a pa-i tyh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Moleipazy pachâna cha Abeipa châta pasichhihpa châ ta, Mopathaihpazy bie deikua cha khochhihpa a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Athôhna doleipa hmô khohpa ta karâypa chyhsa cha, A chhôhkha châta tymâna tlôkhei ta; Panaopapana a haopa deikua cha, A hro a pareih aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosiapa palôh cha â chhy hlâta pachâ tua tyh ta, Moleipa pakah deikua cha hmo pha leipazy a reih pôziah tyh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abeipa cha moleipa tawhta a hla ta, Mosiapa thlahchhâna deikua a thei tyh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mokhaoh khaihna ta palôh palysa ta, Thâtih pha ta ru a pathawh tyh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hrona chhoreina a nathliepa nakhaoh cha, Asopazy hry liata a pahrâ aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pachuna a uasa leipa cha a hro khâpasaw ta a reih leipa châ ta, Chhoreina a nathliepa deikua cha novâhna a to aw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abeipa china cha sona pachuna châ ta, Palyupalihna to awpa ta a reisi tua awpa a byuh.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Palôh achhuahna cha chyhsapa eih châ ta, Paleih achhyna deikua cha Abeipa tawhta a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ano mo liata cha chyhsa ta a hrozie zydua a pathaihpa hawhta hmô ta, Abeipa deikua cha palôh kho a pathliah tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na raizy Abeipa pavao sa la, Nâ chhuahpazy a hlaotloh aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abeipa ta hmo to a chhâpa hneipa ta tao ta, Moleipa chhao he chhiena noh châta a taopa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palôh laipa chyhsa cha Abeipa châta pasichhihpa châ ta, Hriena khôkhâh cheita aw vei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kyhpachâna nata ngâchhihna ta moleina chatlai ta, Abeipa chipa vâta chyhsa ta moleina a siesai tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hroziezy ta Abeipa a palysapa chyhsa cha, A chariahpazy taihta ano nata a ryh awpa ta Abeipa ta a taopa tyh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Adoleipa ta sôh hluhpi hneipa hlâta cha, A sia kawpa ta a chyhta hneipa a pha via.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsapa palôh ta a lâpi pachâhpady ta, A lâsie a chhituhpa deikua cha Abeipa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abei hmao liata Khazohpa bietapa y ta, Pachiana liata a pakah ta pachia chhei aw vei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khopathliahna dopa nata thliena dopa zy he Abeipa eih châ ta, Sykhao liata khopathliahna lô zydua chhao ano taopa sai a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Beidyuchhai cha siana ta paduapa a châpa vâta, Hmo pha leipa taopa cha beizy châta pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmao siapa cha abei alyna châ ta, Biedopa a reihpa cha a pasô tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abei pathiiana cha thina lyuhchâpa châ ta, Châhrasala chyhsa sopa ta cha a padia thei aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Abei hmia khaihpa liata hrona y ta, A khokheina cha châhvâ vâsua meihdo hawhta a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngôh hlâta sona hneipa pha via syulyu ta, Tâkâ vyuhpa ta novâhna tlao a tlyh awpa a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chyhsa dopa lâlai cha moleina chahrih ta, A lâpi a phapa ta a vaihpa cha a hrona a pabohsa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Apalaina cha raona hmia lâta sie ta, Akhotlâhna palôh chhao paona hmia lâta a sie.
  </para>
  <para style="p">
    <verse number="19" style="v" />Apalaipazy hry liata hraona sôh a raipa hlâta cha, Sipasapazy hry liata areisina palôh phaopa a pha via.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bie pakhâta ta a pachâpa cha hmo phapa hmôpapua aw ta, Abeipa a ngâpa cha byhnâ a to aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Palôh sopa cha hmo yzie a pahno thaipa tahpa châ aw ta, Reikah thlôhpa ta chyhsa a pahnie tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Novâhna cha a hneituhpa châta hrona tihnawh châ ta, Hruna deikua cha ahrupazy châta hriena a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Asopa palôh ta a pakah pasosa ta, A hmao liata thaina a baichha tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bie phapa cha kheihthlawh hawh châ ta, Hro châta thlôh ta, ru châta hnatlâna a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chyhsapa pachâ ta lâpi dopa a lyupa y ta, A chhâna lâta deikua thina lâpi a châ tyh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahriapasapa cha ano aohkhopa châta hriapasa ta, A pakah aohkhopa ta a pahriasa tyh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyhsa dyutlai leipa cha hmo pha leipa tao a chhuah tyh ta, A hmaozy cha mei sahpa hawhta a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ngâchhih leipa chyhsa cha ahryuna chi hie ta, Bieparu rei a hmâhpa chhao viasazy a pachhaih ty.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chyhsa hro chhiepa ta a vaih dôvei tyh ta, Lâpi pha leipa liata â chhi tyh.
  </para>
  <para style="p">
    <verse number="30" style="v" />A mo vo a chakhyhpa cha hmo doleipa tao â chhuahpa châ ta, A hmao a papiepa chhao hmo pha leipa a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Luh pawhpa cha rônahna lakho châ ta, Siana hro vâta hmôpa a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chyhsa palôh pasipa cha, Thatlôpa hlâta pha via ta; Ano palôh chô liata bie a hnei theipa chhao, Khihpi a latuhpa hlâta a pha via.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nuby cha byhpi chô liata a daopa châ ta, Biechhâna deikua cha Abeipa tawhta a châ tyh.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atudaih ngâna o liata kyhchhi pati niepa hlâta cha, Adyryh kawpa ta laochhohpa bawpa a pha via.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sei sopa cha maophyuhna a tlôkheituhpa sawchapaw chô liata ryureih aw ta, Unawhpa pakha hawhta a zibeipa ryu a to hra aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathaisana beih cha tâkâ châta châ ta, Patina mei chhao ngôh châta a châ; Abeipa deikua cha palôh a pasia tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmo pha leipa a taotuhpa cha moleipa hmaokah nathlie tyh ta, Haihthaipa chhao chochhiepa paleih lâ a nah a pachôh tyh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sipasapa a mohnaopa cha, Ano Taotuhpa palôh pasasa ta; Mohropa chhiena liata a lypa chhao, Hriena khôkhâh aw vei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Samohzy cha machâpazy lakho châ ei ta, Sawzy rônahna chhao ama pawzy a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Reih phapa cha ahrupa nata a khyh leipa ta, Hmao haihthaipa chhochhi abeisaw nata â khyh lei pachai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Panaopapana cha a pietuhpa châta dyu hawhta châ ta, Â heina lâ maihta a hlaotloh lymâ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kyhpachâna a tluapa cha, Paraona a khupa châ ta; Paraona a reih chanei ngâ thlâh hapa deikua cha, Viasazy a pachhaih tyh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahrupa ei za kha chheipa hlâta cha, Asopa ei kha rapa â ngia pathu via.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chyhsa moleipa cha chakhia nawpa sai tlua ta, Chavâta lyuhchâpa nô­chhiepa tua thlupa a châ aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahrupa a hru nota a tyh awpa hlâta cha, Chavyh a taw la hapa a tyh awpa ngâh â chhih via.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chhiena ta phana a thôtuhpa cha, Hmo phaleipa ta a o puasai aw vei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahryuna athaona cha ti pasapa hawhta châ ta, Chavâta ahryuna a pua hlâta a hneisai ha mah y.
  </para>
  <para style="p">
    <verse number="15" style="v" />Moleipa thai a pachâsatuhpa cha, Abeipa châta pasichhihpa châ ta; Mosiapa thailei a pachâsatuhpa chhao, Abeipa châta pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahrupa cha palôh a hnei leipa châ ta, Chavâta sona chalei nawpa ta a ku liata sôh sopa cha, Khâpa ma a phahnai aw?
  </para>
  <para style="p">
    <verse number="17" style="v" />Viasa cha khatino rai ta kyhpachâ ta, Unawhpa deikua cha tymâna daihti châta a pihpa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pahnona a phahlapa cha bie a taih ta, A vaihzy mohmô ta sôhkâ a sokhâh tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Moleina hmo taopa a pahâh kawpa cha, A hryuchhia a khohpa châ ta; A chhikao a pasâhpa chhao, Raona a tluapa a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palôh akopa chyhsa cha hmo phapa hmô leipa ta, Paleih haihthaipa chhao chhiena â tyh tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahrupa a satuhpa cha anosasyh ta pachâ a parôh ta, Ahrupa paw cha alyna hnei vei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Palôh thaphapa cha thohna phapa châ ta, Palôh pasapa deikua cha ruzy a pahi tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Moleipa cha arulâta panaopapana la ta, Adona lâpizy a parao tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sona cha novâhna a hneipa hmiakô liata y ta, Ahrupa mo deikua cha kaokih liata a y tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sawchapaw hrupa cha a paw pachârôhna châ ta, Ano a satuhpa nô palôh pasana a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mosiapa hriepa cha pha leipa ta, Nôpawpazy amâ dona vâta tupa chhao pha vei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bierei a chadopa cha chyhsa sopa châ ta, A reikah a sôhpa chhao chyhsa novâhpa a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahrupa chhao â chalih thlâh ha khiahta cha, Asopa hawhta pachâpa châ ta; A hmao a mo khiahta cha, Chyhsa novâhpa hawhta a ngiahpa a châ.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ano dei ta a y nanopa cha ano khopa sai a tluapa châ ta, Sona dopa zydua a dyuhpa a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahrupa cha novâhna liata alyna hnei leipa ta, Ano palôh reipapuana lia deita ta â ly tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Moleina a vaw y nahta, Papeisaleina vaw y tyh ta; Chyhsa za leina a y nahta, Nohzaona a y tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chyhsa pakah biezy cha ti athupa châ ta, Sona tihnawh cha vahtie loh zaolaopa hawhta a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Moleipa khokhei viapa pha lei­pa ta, Mosiapa adona chhupa chhao pha vei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahrupa hmao cha ahryuna tlôkhei ta, A pakah ta atuna a aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahrupa pakah cha ano raona châ ta, A hmao chhao a hro châta khoheih a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hohiahpa biezy cha pati pahâhpa hawhta châ ta, Py chhôh lâ a zu tyh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A raihria liata chyhsa thathipa cha, Paraotuhpa unawhpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa moh cha thokhy a sâhpa thatlôpa châ ta, Mosiapazy ta cha lâ a râ ei ta amâ boh tyh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chyhsa hneirôhpa sôh cha â bohna khihpi thokhy châ ta, Thokhy a sâhpa hawhta a mothlaw liata a y tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Palôh laina cha raona hmia lâta sie ta, Areisina deikua cha palyupalihna hmia lâta a sie.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bie thei pasia hlâta achhyna a piepa chyhsa cha, A hruna nata a maophyuhna a palâsa.
  </para>
  <para style="p">
    <verse number="14" style="v" />Palôh thatlôpa cha pasana tao thei ta, Palôh hmahphaopa deikua cha ahy ma a tao thei aw?
  </para>
  <para style="p">
    <verse number="15" style="v" />Palôh sopa cha pahnona hmô ta, Asopa nakhaoh chhao pahnona a tlua tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuhria piepa cha a pietuhpa châta lâpi tao ta, Chyhsa rônahpazy hmiakô liata â chhi tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />A vaihzy a vy ei ta ama padei hlâta cha, A thaichâna bie a reih tuapa cha adopa hawhta â lâ tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nuby a daopa ta ahryuchhiana pachhâsa ta, A hryuh haipa thatlôpazy a pachhaih tyh ei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Unawh pasasa hapa cha khihpi thatlôpa hlâta pahnie ru via ta, Cha hawpa ahryuna cha thokhy tlâh hawhta a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chyhsa pakah thei ta a rih pabie ta, A hmao kôvei ta lôhrâtlôpa ta a y.
  </para>
  <para style="p">
    <verse number="21" style="v" />Paleih hmotaotheina liata thina nata hrona y ta, A pasôtuhpazy ta a theizy ama nie aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lapinô a hmôpa cha hmo phapa a hmôpa châ ta, Abeipa khokheina a totuhpa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sipasapa cha â haw ta a haw tyh ta, Hneirôhpa deikua cha a chahrâh kawpa ta â chhy tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Viasa hluhpi hneipa cha raona châ thei ta, Châhrasala unawh hlâta â i viapa viasa a y.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chyhsa hrupa hmao haihthaipa châpa hlâta cha, Sipasapa ngâchhihpa châpa a pha via.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pahnona a phahlapa hro cha pha leipa ta, A phei a parapa chhao a sumiesumâ tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chyhsa ta ano hruna vâta a lâpi a raopa tlai cha, Abeipa chô liata palôh ruchhôna a hnei tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sôh ta viasa hluhpi pahneisa ta, Sipasapa deikua cha a viasapa taihta a pathlua.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pahnokheituh pakheipa cha hrie leipa ta y leipa aw ta, Haipa hu a sopa chhao pua aw vei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa hluhpi ta riaphapa khokheina tlua ei ta, Hmosaipa a pietuhpa cha chyhsa to viasa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />A unawhzy hmahta sipasapa cha amâ hao khiahta cha, A viasazy chhochhi ta cha khatlu ta ma amâ hla aw tly! Bie ta âmo cha a chadai ta, Châhrasala ama siesai syulyu haw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sona a hneipa cha a hro pasô ta, Novâhna a vaotuhpa chhao hmo phapa a hmô aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pahnokheituh pakheipa cha hrie leipa ta y leipa aw ta, Haipa bie a reihpa cha a leidia aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahrupa nata phasana hro a khyh leipa ta, Sei ta abeisawzy chô liata ryu a reipa awpa chhochhi â khyh lei pachai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sona ta chyhsa palôh pasisa ta, Pasasana mopakhôpa cha a rônahna a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abei hiehâna cha chakeibarôhneipa a rôhpa hawhta châ ta, A khokheina deikua cha sibiepa chôta diati a tlapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sawchapaw hrupa cha, A paw châta chhiena châ ta; Lapinô paphôh thaipa chhao, Ti di a thlaoh ngâ thlâh hapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />O nata sôh zy cha pawzy tawhta ryuto châ ta, Lapinô sopa deikua cha Abeipa tawhta a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thathina ta mokuhthuna liata pangiasa ta, Chyhsa a ychakhyhpa cha nodi a tao aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Biepiepa a vaopa cha a hro a vaopa châ ta, A lâpizy a uasa leipa deikua cha a thi aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dyhchhiepa chô liata a ria a phapa cha, A sôh Abeipa dyu a pacheisapa châ ta; Abeipa ta a dyuchei cha a thô aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na sawchapawpa cha chhorei teh, Hnabeiseihna a y lah y; A leidia thlâh ha awpa ta pachâ khah y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathi chhie ngaitapa chyhsa cha hriena â tyh aw, Na pachhapa chhao ta pachha chanei ngâ thlâh ha awpa a byuh aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pasopakâna bie nathlie la pachuna a pyh mah y, Achhâna liata sona na hmô aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chyhsapa palôh liata achhuahna hluhpi y ta, Châhrasala a duah awpa cha Abeipa ryhraopa a châ tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsapa khochhihna cha kyhpachâna a hneipa he châ ta, Haihthaipa hlâta cha sipasapa kho â chhih via.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa china cha hrona tlôkhei ta, A hneipa maih palôh pahâ kawpa ta a pahâ ei ta, Chhiena ta âmo cha tly aw vei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thathipa cha beikoh liata a ku ny ta, A pakah lâ chalo heih awpa dâhdei chhao hoh vei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chyhsa a pasipasawhpa cha tu la, Sona a phahlapa ta sona a chu aw ta; Chyhsa sovâhpa cha chhorei la, A pahnona a pôh aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />A paw chô liata kupathla ta a nô a papuapa sawchapaw cha, Nozana nata nohzaona a tlôkheituhpa a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ei sawchapawpa y, pachuna nathliepa na bâsai khiahta cha, Novâhna biezy na paviasai aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pahnokheituhpa leilôpa ta adona pahneisao ta, Moleipa pakah ta moleina a palâ tyh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chyhsa pasipasawh a hmâhpazy châta hriena a mâ chiehpa ta y ta, Ahrupazy hnôhky chhao tu awpa ta a mâ chiehpa ta a y.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kresawhti cha pahneisaotuhpa châ ta, Sahma cha tu a thyupa a châ; Chazy ta a dôvei theipa chyhsazy cha asopa châ veih ei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abei hiehâhpa cha chakeibarôhneipa a rôhpa hawhta châ ta, Abei hie a pahâhpa chyhsa cha a hro châta chi â chhih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahryuna a chalihsaipa cha zachhihna palâsa ta, Ahrupa deikua cha tu a thyu laih aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thathipa cha chasipaw nota lei a palie hoh leipa vâta, Sâh hria daihti liata khâpa hmah hmô aw vei; Kudaopa ta a y aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyhsa palôh liata saduthliena cha ti athupa hawhta châ ta, Châhrasala novâhna a hneipa chyhsa ta cha a sy papua thei aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mo hluhpi ta chyhsa phapa hawhta âmosasyh a reih ei ta, Chyhsa ngâchhihpa deikua ahy a hmô thei aw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosiapa cha â dona hrokhei lymâ ta, A vaw pazi awpa a pathlazy thlaochhipa ta ama y aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ryureina beidyuchhai liata a tyuhpa abei cha, A mo ta hmo pha leipa zydua a pahrua tyh.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ei palôh pathaihsa ha na ta, Ei moleina tawhta ei pathaih haw,” Ahy ma a tah thei tly?
  </para>
  <para style="p">
    <verse number="10" style="v" />Khopathliahna lô doleipa nata thliena ri doleipa zy cha, A miano ta Abeipa châta pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hawtipa chhao a hro a pathaih nata pathaih leizie zy, Â do nata do leizie zy, A hmotaopa liata anosasyh ta a palâsa tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Theina nah nata hmôna mo zy he, A miano ta Abeipa taopa sai a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amôpa tlaichhai khah y, Na dyhchhie pathlei aw na; Na mo padeih la, Niedo hluhpi na hnei aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmo chaleituhpa ta, “Pha vei, pha vei,” tah ta, Châhrasala chalei ta a pua tita cha â palaikhei kaw heih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngôh y ta lôsôhpazy chhao a hluh kaw, Châhrasala novâhna hmaozy he lôsôhpa sôhpazy cha ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khichhaipa châta sôhkâ a sohpa cha, A chysia lapa la; Chihropa châta sôhkâ a sohpa chhao, A bietai châta a chysia lapa mah y.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dôveina ta viahchhâ hmôpa cha chyhsa châta pahâh kaw ta, A hnôhlâ ta deikua cha lochapo ta a pakah a bie aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Achhuahna cha ryureina ta a pa-i awpa châ ta, Hrâsie awpa chhao pasopakâna sopa ta tao awpa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hohiahpa ta a khiekhâpa ta bieparu papua tyh ta, Chavâta pakah kawhpa chyhsa cha a pakyh khah y.
  </para>
  <para style="p">
    <verse number="20" style="v" />A paw tlyma a nô tlyma chhie a sapa cha, Zoh kaluhna su liata a meiôh pachhaipa a châ aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Âthaona liata tararuahna ta râh hneipa cha, Achhâna lâta byhnâ châ khao tyh vei.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Moleina cha viari ei thô aw,” tah khah y, Abeipa hâ la ano ta a cha pachha aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khopathliahna lô doleipazy cha Abeipa châta pasichhihpa châ ta, Thliena ri doleipazy chhao pha vei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chyhsapa keih chakânazy cha Abeipa raopa châ ta, Kheihta ma chyhsa ta a lâpi a pahno thei aw?
  </para>
  <para style="p">
    <verse number="25" style="v" />A chatlie baikhaipa ta Abeipa lâ hmo hlâ awpa bie a taihpa cha, Â taihtuhpa châta khoheih châ ta; Bietai tao khai tawhta pachâ pathi heihpa chhao, Â taihtuhpa châta khoheih a châ hra.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bei sopa cha moleipa pahrua thai ta, Ama chô liata tiaki a pahieh thlu tyh ei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyhsapa hrona hu cha Abeipa meiôh châ ta, A pôhpa chhôh liata a ypa zydua a palâsa tyh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kyhpachâna nata biehmeiseihpa ta abei cha hrôbieh ta, Ngâchhihna ta a beidyuchhai cha pabohsapa a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Satliapazy rônahna cha ama thatlôna châ ta, Pawpipazy angiana deikua cha ama luh pawhpa a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hmah yna taihta tupa ta moleina pathai ta; Chheinazy ta palôh chhôh chaipazy chhao a pathai tyh.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abei palôh cha Abeipa ku liata y ta, Vahtie ti hawhta a khona lâ maih a palosa tyh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyhsa cha ano mokhaoh liata a lâpi to â do tah ta, Abeipa deikua cha palôh kho a pathliah tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa châta cha siana nata adona ta hmo taopa he, Atheihna hlâta a pyh tlâh a châ via.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mo a sâhpa nata palôh laipa cha moleina châ ta, Cha cha moleipa meiôh a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Achhuahna phapa a hneipa chyhsa tiamapa cha a dyhpha aw ta, Palôh charâpa chyhsa deikua cha dyhchhiena lâ a pangai aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Paleih haihthaipa ta sôh hmôpa cha, Ti hu a lei haipa nata thina khoheih a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moleipazy cha adona ama tao khoh leipa vâta, Âmo nôchhiena ta a phi pathlah aw ei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thailei a châpa lâpi cha a ko ta, Chyhsa pathaihpa hro deikua cha â do.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hryu nawpa sai a tlua thlâh hapa lapinô nata o laipa liata y khohpa hlâta la, Vâphuh chaki liata ypa a pha via.
  </para>
  <para style="p">
    <verse number="10" style="v" />Moleipa hro cha moleina khoh ta, A vaihzy ta a mo liata khokheina hmô veih ei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mohnao a hmâhpa hriepa a châ nahta, Sona a phahlapa vaw so ta; Chyhsa sopa cha pachupa a châ nahta, A pahnona â baichha tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khazoh Siapa ta moleipa o cha mohpathli ta, Moleipazy cha raona lâta a thy tyh ei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sipasapa awna lâta a nah a chahupa cha, Ano chhao awh aw ta a chhypa châ aw vei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Arulâta hmosai piepa ta hiehâhna padia ta, Kalachhôh liata panaopapana nyupa ta pathiiana rupa a padia tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pachiana dopa cha mosiapa alyna châ ta, Moleipa châta deikua cha raona a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sona lâpi a tleisaipa cha, Athipazy ypakhyna liata â pahâ aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Haosai a tlaichhaipa cha sipasapa châ aw ta, Kresawhti nata sathaw a tlaichhaipa chhao hneirôh aw vei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Moleipa cha mosiapa châta chatlaina châ aw ta, Apaphasaituhpa chhao chyhsa dopa châta chatlaina a châ aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chanô paphôhthaipa nata pathichhiepa pahrâ lâhpa hlâta la, Râhchawhpa liata pahrâpa a pha via.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chyhsa sopa pahrâna liata cha ryu sôhpa nata sathaw y ta, Chyhsa hrupa deikua cha a palâ khai ha tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Siana nata ngâchhihna a chadaipa cha, Hrona, siana nata zana a hmô aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsa sopa cha pasaiphazy khihpi lâ kiah aw ta, Amâ pahniehna thokhy a pacho aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pakah paleih a vaihpa cha, Nôpona tawhta a hro a vaihpa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Akhotlâhpa nata apatahsapa moh cha “Mohnaotuh” châ ta, Apalaina nata atahtheina ta hmo a tao tyhpa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thathipa cha a ku ta rai a hria khoh leipa vâta, A hmo khohpa ta ano cha a thie aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thathipa cha noh y ta khohlei khona sai ta bie ta, Mosiapa deikua cha pahlôh leipa ta tlao a pie tyh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Moleipa atheihna hlâpa cha pasichhihpa châ ta, Moleina palôh chhaota a hlâpa chhochhi cha pasi â chhih via pachai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pahnokheituh pakheipa cha leidia aw ta, Bie a thei hmeiseihpa bie deikua cha â duah aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chyhsa moleipa cha hmiakawh kawpa ta y ta, Chyhsa dopa deikua cha a lâpizy a phapa ta a pachâ tyh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kheihawhpa sona, novâhna nata ryhraothaina hmahta Abeipa cha pahnie aw vei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Arâ cha adyuhna noh châta a mâ chiehpa ta y ta, Pahniena deikua cha Abeipa eih a châ.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hneirôna hlâta moh phana a tlyh via awpa châ ta, Tâkâ nata ngôh hlâta pasâhsapa a pha via.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hneirôhpazy nata sipasapazy a tyh ei ta, Ama zydua a taotuhpa cha Abeipa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Asopa cha chichhihpa hmô thaipa ta a nyusai ta, Sona a phahlapa deikua cha chatôh ta pasa a tao tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Areisina nata Abeipa china lymâzy cha, Hneirôna, zana nata hrona zy a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Palôh akopa lâpi liata ahlohzy nata khoheihzy y ta, A hro a vaihpa ta â hlasai aw ei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hawtipa cha a sie nawpa lâpi pachu la, A pitloh tita chhao siesai aw vei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hneirôhpa cha dyhchhiepa chô liata ryureih ta, Dyucheituhpa cha a pacheisatuhpa sei a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Adoleina chi a tupa cha chhiena hria aw ta, A hiehâhna chôchahrei chhao a tlie aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsa riaphapa cha sipasapazy niedo â chhaih tyhpa vâ ei ta, Vânoh a to aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyhsa a mohnaopa cha papua u la, Ahryuna nata atuna zy â chalih aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Palôh pathaihna pasô ta, A reikah a phapa cha, Abei chhao viasa ta â tao thei aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abeipa mo ta pahnona a hneipa chyhsa cha mokhâh ta, Piehpiepa bie deikua cha a thy pathlah tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thathipa cha, “Khôtho liata chakeibarôhneipa y ta, Lâlaizy liata eina thie aw,” a tah tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chanô sihryhpa pakah cha khaohtlô a thupa châ ta, Abeipa hie a pahâhpa cha cha liata a tla aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hawtipa palôh liata hruna a bai ha ta, Sôsi ta chhoreina ta hruna cha lâhla lâ â chadai pai aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ano hneirôna papôh nawpa ta dyhchhiepa tlybai ta, Hneirôhpa hnohta sôh nah thih a piepa cha, Dyhchhiena ta a tlô thlu aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na nah pachôhpa ta asopa biezy nathlie la, Ei sona a chuna châta na palôh hmâh mah y.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na chhôh liata a vao awpa châta pha ta, Na hmao liata a y awpa châta a pha khai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abeipa na ngâ thei nawpa ta, Chazy cha tanoh cha pahnosa na ta, Nâ lia tlai ta ei cha pahnosa haw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na châta bieso sythôh cha ropa na ta, Ryhraona nata pahnona zy ei cha ropa hih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chatanachata biedopa nata biehmeiseihpa pahno aw chi ta, Châ tuahtuhpazy hnohta biedopa na tlôkhei thei aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sipasapa hrao khah y, Sipasapa a châ khaw; Pasataopa chhao thokhy chhikao liata tu lao khah y.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa ta ama bie a duakhei tlôh aw ta, Âmo a hraotuhpazy hro a hrao hra aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiehâh naopa chyhsa a viasa leipa la, Pathichhiepa chyhsa chhao a pakyh khah y.
  </para>
  <para style="p">
    <verse number="25" style="v" />A hrozie hâ a la aw chi ta, Na hro châta khoheih a châ pathlei aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bie a taih thaipazy hry liata a hlao leipa la, Leibâh châta sôhkâ a sokhâhtuhpazy hry liata chhao a hlao khah y.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na pie awpa na hnei khao vei tita, Na rakhô ama châ daophi pâ pathlei aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Châ pathlatuhpazy ta ama vaw bô hapa râhri lôbô hlôpa cha, Pasi cheita khah y.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rai a thai kawpa chyhsa cha moh tua, Abei hmiakô liata a duah aw ta, Chyhsa zawrâpa hmiakô liata a duah aw vei.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ryureituhpa nata pati na dôh khoh tita, Na hmiakô liata ahy ma a y tahpa a phapa ta pachâ mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Niebaw a zoh kawpa na châ khiahta cha, Na rao liata chaizôh soh mah y.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pati pahâhpazy tlaichhai kaw khah y, Dôveina pati ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hneirôh awpa ta na rie a pathei tu leipa la, Â daihna rakha pahno awpa ta so thai kaw mah y.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sôh cha na hmôpa nahta thlai a pai tyh; A mathlaw kaw thao ta, Pahmôh hawhta avâ lâ â zaw syulyu ha tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa mochhihpa viahchhâ cha nie leipa la, A pati pahâhpazy chhao tlaichhai hlei khah y.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hryuh awpa sai pachâ ta, “Nie la, doh mah y,” cha tah taraw ta, A palôh hmeiseihpa liata deikua cha châ ly hlei vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />A chyhta na niepa chhao pali lilaw aw chi ta, Na bie phapa tlao na papâpahria.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahrupa theina liata bie reih khah y, Na sona biezy a mohnao pathlei aw na.
  </para>
  <para style="p">
    <verse number="10" style="v" />Râhri lôbô hlôpazy pasie leipa la, Paw hnei leipazy lyu liata a ngia khah y.
  </para>
  <para style="p">
    <verse number="11" style="v" />Âmo chatlaituhpa cha a thatlô tlôh ta, Âmo a duakheipa ta a châ dyuh pathlei aw na.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pachuna lâ na palôh pahei la, Na nah chhao pahnona biezy lâ pahei mah y.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sawnawh chhoreipa a chalihsai khah y, Sôsi ta na tupa chhao ta thi aw vei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sôsi ta na tu khiahta cha, Athihkhih tawhta a hrona na pachha aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ei sawchapawpa y, na palôh a so khiahta cha, Keima palôh chhao â ly aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na hmao ta hmo dopa a rei tita, Ei palôh â ly ngaita aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na palôh ta moleipazy uahva leipa sala, Noh y ta Abeipa chipa ta tlao y mah y.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmialâ daihti hnei aw chi ta, Na hnabeiseihna cha pahleipa châ aw vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ei sawchapawpa y, nathliepa ta so la, Lâpi dopa liata na palôh soh mah y.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kresawhti iahzaipazy hry liata a hlao leipa la, Sa zohpazy hry liata chhao a hlao khah y.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sahma paripa nata sa zohpa zy cha dyhchhiena lâ pangai aw ei ta, Tla-uahna ta âmo cha poh chypa a pabu aw ei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Châ satuhpa na paw bie nathlie la, Na nô a nôpi tita mohnao khah y.
  </para>
  <para style="p">
    <verse number="23" style="v" />Biehmeiseihpa chalei la zuah khao leipa la, Sona nata pachuna nata pahnona zy chalei mah y.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosiapa paw cha a ly ngaita aw ta, Sawchapaw sopa paw chhao a saw chô liata â ly kaw aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na paw nata na nô thaphapa ta y ei sala, Châ satuhpa na nô cha a lypa ta y mawh sy.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ei sawchapawpa y, na palôh na pie la, Na mozy ta ei lâpizy moh mawh sy.
  </para>
  <para style="p">
    <verse number="27" style="v" />Âzuahnô cha khaohtlô athupa châ ta, Apheinô chhao tikhaoh buahpa a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hraotuhpa hawhta chyhsa a byh ta, Chyhsapazy hry liata ngâchhih leina a papôhsa.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahy ma a hupo ta, ahy ma a pachâ a rôh? Ahy ma a hryuh ta, ahy ma a paphôh? Ahy ma a chhâpa y leipa ta hmah a phaoh? Ahy ma a mozy a saih khai haw?
  </para>
  <para style="p">
    <verse number="30" style="v" />Âmo cha kresawhti dona liata a y parei tupazy châ ei ta, Kresawhti pahlaopa do awpa ta a puapazy ama châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kresawhti a saih nota moh leipa la, Nyu liata a rôh â ngia kawpa chhao moh hra leipa la, A loh zaolao ngâpa chhao moh hra khah y.
  </para>
  <para style="p">
    <verse number="32" style="v" />A chhâna liata cha parih hawhta cha pachu aw ta, Vâzi hawhta a cha pachu aw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na mo ta hmo nano kawpazy hmô aw ta, Na palôh ta bie chhiepazy a reih pathlei aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tilaipi liah liata a ziapa hawhta châ aw chi ta, Balyh pohraina tôh pawhmao liata a ziapa hawhta na châ pathlei aw na.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Na tu ei ta, pasa leipa na ta, Na chhei ei ta, pahno va na. Ei kaw hrapa nahta, Ei doh heih aw,” A tahpa na châ pathlei aw na.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chyhsa moleipazy uahva leipa la, Ama hry liata a hlao awpa chhao tlaichhai khah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama palôh ta thachahra hmâna kyh patuapalua ei ta, Ama hmao ta tymâna bie a reihpa ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />O cha sona ta sapa châ ta, Novâhna ta paduapa a châ;
  </para>
  <para style="p">
    <verse number="4" style="v" />Chhôhpadâhpazy chhao pahnona ta taopa châ ta, Hmo ngiapa nata hmo sôhpazy ta pabiepa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyhsa sopa cha thatlôpa châ ta, Pahnona a hneipa ta a hmotaotheina a papôhsa tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ryhraona sopa tao khai tawhta hrâ na sie awpa châ ta, Ryhraokheituhpa hluhna liata pahniena a y tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahrupa châta sona cha a sâh tu ha ta, Thokhy chhikao liata a pakah â vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmo pha leipa tao awpa ta ryh a raopa cha, Paraopakeituhpa ama tah aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahrupa ryhraona cha moleina châ ta, Chyhsa mohnao a hmâhpa cha, Chyhsapa châta pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tymâna noh liata na panao thlâh ha khiahta cha, Na thatlôna a chyh kaw tahna a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thi awpa ta a chhipazy cha pachha la, Thie awpazy cha pachha thlyu teh.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Pachâ teh, he hmo he pahno ma pi,” Na tah khiahta cha, Palôh khopathliahtuhpa ta pahnopa ta, Na hro a vaotuhpa ta pahno thlâh ha ta, Chyhsa to ama hmotaopa lymâ hawhta viari a thô aw ei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ei sawchapawpa y, kheihti cha pha ta, nie la, Kheithlawh ti thlôhpa a thlaohpazy ta na pakah lôhrâ patlô mawh sy.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sona cha na hro châta a châ tahpa pahno la, Na hmô khiahta cha hmialâ daihti hnei chi ta, Na hnabeiseihna lei aw vei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hy moleipa, mosiapa pahrâna su a byh leipa la, A o liata thachahra hmâ thlu khah y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosiapa cha ei sari pao hra sala thyu heih tyh ta, Moleipazy deikua cha ei kha chhie atyhna liata amâ hluah tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na chariahpa a pao nota a ly leipa la, Â chapia nota na palôh thapha khah sy.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chataleipatala Abeipa ta hmô aw ta a ly leipa aw ta, A chô liata a pathiiana a lapa pathlei aw na.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmo pha leipa a taotuhpazy vâta na pachâ a parôh leipa la, Moleipazy uahva hra khah y.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chyhsa chhiepa châta hmialâ daihti y leipa ta, Moleipa meiôh cha pachhaipa a châ aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ei sawchapawpa y, Abeipa chipa ta abei chhao chi la, Cha hawhta a y leipazy cha a pahlao khah y.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abeipa nata abei ta ama chô liata raona eikhapi ta patlôsa aw ei ta, Kheihawhpa chhiena ma ama patlôsa thlu aw tahpa ahy a pahno aw?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hezy chhao he chyhsa sopa biereipazy a châ. Pachiana liata khokhei viapa hneipa pha vei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Moleipa hnohta, “Nâ do na,” a tahpa cha, Phopizy ta chhiesapa aw ei ta, Râhzy ta chyhuh ama sapa aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Moleipa thailei a pachâtuhpazy deikua cha a ly aw ei ta, Ama chô liata byhnâ phapazy a vaw tlô aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Achhyna dopa piepa cha, Hmao liata sypa hawhta a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khôtho lâta na rai a chhuanoh la, Lyu liata na raizy a ngoh tawhta, Na o cha sa mah y.
  </para>
  <para style="p">
    <verse number="28" style="v" />A chhâpa y leipa ta na vaih kyh liata pahnokheituhpa ta y leipa la, Na hmao ta dôvei khah y.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ei chô liata a taopa hawhta ano chô liata tao aw na ta, A hmotaopa viari ei thô aw,” tah khah y.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thathipa lyu chapia na ta, Pahnona a phahlapa kre sadô ei chapia.
  </para>
  <para style="p">
    <verse number="31" style="v" />Moh teh u, ahloh buhzy ta pahli khai ha ta, Thlahbeizy ta lyu hmia zydua khupa ta, A dôhna alô diahpai chhao a cho khai haw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cha cha ei hmô nahta pachâ na ta, Moh na ta hetana heta pachuna ei dao.
  </para>
  <para style="p">
    <verse number="33" style="v" />Buakha a môpa ta, Buakha tla-uah chi ta, Buakha ku chakhipa ta nâ pahâ chhôh ta,
  </para>
  <para style="p">
    <verse number="34" style="v" />Dyhchhiena ta hraotuhpa hawhta cha vaw tlô thlu aw ta, Phahlana ta chaihrai chhaopa chyhsa hawhta a cha vaw tlô thlu aw.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Sawlawmaw biesozy châ hra ei ta, Zudâh bei Hezekia chyhsazy ta ama ro pachhuahpazy a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bie nyupa cha Khazohpa rônahna châ ta, Abei rônahna deikua cha bie tluapapuapa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Avâzy â sâhpa nata alei â thupa hawhta, Abeizy palôh chhao a laichadai theipa châ vei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tâkâ tawhta a saiiepazy la ha la, Syudaihpa ta hmobaoh tao nawpa chhaichhi phapa hnei aw ta;
  </para>
  <para style="p">
    <verse number="5" style="v" />Abei mohmô tawhta moleipazy la ha la, A beidyuchhai cha siana ta paduapa a châ aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abei hmiakô liata nâmasasyh ta a chhaodaolaoh leipa la, Chyhsa rônahpazy su liata a duah khah y.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nôpawpazy mohmô ta â hnai lâ patyusapa hlâta, “He lâ a khy teh,” ama cha tahpa a pha via.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ryureina liata chyhsa leih awpa a para khah y, A chhâna lâta na vaih ta maoh cha paphyuh aw ta, Tao awpa pahno leipa ta na y pathlei aw na.
  </para>
  <para style="p">
    <verse number="9" style="v" />Biepeipa na hneipa cha na vaih nata reih khoh u la, Mohropa bieru phuah khah y.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chataleipatala a theituhpa ta maophyuhpa ta cha tao aw ta, Na moh chhiena chhâ thai khao leipa ta a y pathlei aw na.
  </para>
  <para style="p">
    <verse number="11" style="v" />A daihtita ta bie reipa cha, Tâkâ byh liata ngôh epuh hawhta a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngôh rahy nata ngôh suapa atobina kho â chhihpa hawhta, Chyhsa sopa chhoreina chhao, Reingiahpa nakhaoh liata kho â chhih.
  </para>
  <para style="p">
    <verse number="13" style="v" />A tuahtuhpa châta lyuhchâpa ngâchhihpa cha, Sâh hria daihti liata dâhaw chakuapa hawhta châ ta, A zibeipazy hro a palysa tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmo a pie leipa tlai ta piepa hawhta â reihpa cha, Vâsua ti a hnei leipa meihdo nata thlih hawhta a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Palôh pasina ta ryureituhpa pahnie theipa châ ta, Paleih naipa ta ru a pakei thei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kheihti na hmô khiahta cha, Â daihpa rakha ta nie mah y; Na nie hluh tu khiahta cha, Na pali pathlei aw na.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na vaih o tlykiah tu khah y, Cha ai aw ta a châ hao pathlei aw na.
  </para>
  <para style="p">
    <verse number="18" style="v" />A vaih chô liata pahnokheituhpa pakheipa ta a ypa chyhsa cha, Byuthô, zaozi nata châtai tiahpa hawhta a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tymâna daihti liata chyhsa ngâchhih leipa chô liata a pahniehpa cha, Hâh a charuapa nata phei a pahleihpa hawhta a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Palôh rietheipa châta hla sapa cha, Chasi noh ta chysia pahluhpa hawhta châ ta, Lôiah liata sahma thaopa baopa hawhta a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na chariahpa a no a di khiahta cha nie awpa pie la, A dâh a phi khiahta cha ti do awpa pie mah y.
  </para>
  <para style="p">
    <verse number="22" style="v" />A luh chô liata meihei iapa a pathlupa châ aw chi ta, Abeipa ta lymâ a cha pie aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Maw thlih ta vâsua vaw tlôkhei ta, Kyh rei a hmâhpa paleih ta hiehâhna hmia a tlôkhei.
  </para>
  <para style="p">
    <verse number="24" style="v" />A hryu nawpa sai a tlua thlâh hapa lapinô nata o laipa liata y khohpa hlâta la, Vâphuh chaki liata ypa a pha via.
  </para>
  <para style="p">
    <verse number="25" style="v" />Râh hlapi tawhta thâtih phapa cha, Dâhphipa châta ti chakuapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chyhsa siapa moleipa hmiakô liata a paopa cha, Vahtie panôpa nata tihnawh puapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kheihti nie hluh tupa pha leipa ta, Rônahna tluapa chhao rônah hlei vei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Anosasyh â pahnie leipa chyhsa cha, Khihpi chopa thokhy a hnei leipa hawhta a châ.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nopi noh nata dâhaw tlapa a khyh leipa ta, Sâh hria daihti nata vâsuapa â khyh leipa hawhta, Palyupalihna chhao ahrupa nata a khyh vei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Boby a viapa hawhta nata siviah â zawpa hawhta, A chhâpa y leipa ta chhiesapa cha a pai aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chheina ri cha arâ châta châ ta, Chhâri cha alâ châta châ ta, Sôsi cha ahrupa ky châta a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahrupa cha a hruzie hawhta a chhy khah y, Chataleipatala ano hawhta na châ pathlei aw na.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahrupa cha a hruzie hawhta a chhy teh, Chataleipatala asopa hawhta â pachâ pathlei aw na.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahrupa ku liata bietapa a paphaopa cha, Ano phei tai pachhô ta atudaina ti a dohpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ahrupazy hmao liata bieso cha, Pheisypa pheizy â pathliah thlâhthlipa hawhta a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahrupa hnohta palyupalihna hlâpa cha, Cheisiah liata cheichâ lô pataohpa hawhta a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahrupazy pakah liata bieso cha, Sahma paripa ku liata ahloh buh hawhta a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahrupa nata a khiekhâ a pahâhpa rai pahriasapa cha, Likathaipa ta chyhsa to hmah a paphaopa hawhta a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />I ta a palipa a nie heih tyhpa hawhta, Ahrupa chhao ta a hruzie a palâsa chanei heih tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ano mokhaoh liata â pasosa kawpa chyhsa na hmô tyh ma? Cha hawhpa chyhsa hlâta cha, Ahrupa châta hnabeiseihna a y via.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thathipa ta, “Lâpi liata chakeibarôhneipa y ta, Lâlaizy liata chakeibarôhneipa a y,” a tah ty.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ochhi a baolie liata â pahiehpa hawhta, Thathipa cha a rakhô liata â paliepatheih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thathipa cha a ku beikoh liata a ku ny ta, A pakah lâ chalo heih awpa dâhdei chhao hoh vei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmo a laichadai thaipa pasari hlâ chhao ta, Thathipa cha ano mo liata â pasosa via tyh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mohropazy ahryuna liata a chahraohpa cha, I a vaw râpa nakao liata patupa hawhta a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Meirei nata châtai nata thina hiepatlatuhpa ahrupa hawhta,
  </para>
  <para style="p">
    <verse number="19" style="v" />A vaih a dôveituhpa ta, “Sai na ei so bao!” a tah tyh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tho chhâ ta mei a thipa hawhta, Hohiahpa y leina liata cha ahryuna chhao â chalih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meihei cha meihô châta châ ta, Tho cha mei pati nawpa a châpa hawhta, A paphôh thaipa chyhsa cha ahryuna a pa-iatuhpa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hohiahpa biezy cha pati pahâhpa hawhta châ ta, Py chhôh lâ a zu tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Palôh chhiepa hnei ta a hmao a pahnia kaw heih tlôhpa cha, Alei beih tâkâ ta pahupa hawhta a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahaona a hneipa cha a hmao liata nyuthu tyh ta, A palôh liata deikua cha dôveina a paveih tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bie phapa a reipa chhao ta zo khah y, A palôh liata hmo pasichhihpa miasari a vaopa a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahaona a hneipa cha dôveina ta khupa a châpa chhao ta, A moleina cha tlâh pahnopa ta palâsapa a châ aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khaohtlô a chaopa cha a chhôh liata tla aw ta, Alô a pahluahpa chhao ano â vaw hlua thlu heih aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Paleih haihthaipa cha a pasasapazy a hao ta, Papyupahlyna pakheipa pakah chhao paraona rai a hria tyh.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mylâ ta hmo a vaw y awpa a palaikhei khah y, Cha noh chata khâpa ma a vaw tlôkhei aw tahpa pahno tlôh chi va.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nâma pakah ta a reithai leipa la, Mohropa ta tlao cha reithai sala; Nâma hmao ta châ leipa sala, Khichhaipa hmao ta tlao cha reithai mawh sy.
  </para>
  <para style="p">
    <verse number="3" style="v" />Alô cha a hri ta, Sadi chhao â hri; Châhrasala ahrupa ta chyhsa a patypamâpa cha, Cha miano hlâta â hri via.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiehâhna cha a nôchhie ta, pathiiana chhao â tlao, Châhrasala ahy ma hiatliana hmiakô liata a duah thei aw?
  </para>
  <para style="p">
    <verse number="5" style="v" />Kyhpachâna â nyupa hlâta cha, A lâhâh ta rapa a pha via.
  </para>
  <para style="p">
    <verse number="6" style="v" />Viasa ta hmah paphaopa cha ngâ lei nawpa y leipa ta, Chariahpa apahnâna deikua cha a pakheipa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rihbiepa châta cha kheihti chhao pasi a chhih ta, Nodipa châta deikua cha hmo khapa zydua chhao a thlôh khai.
  </para>
  <para style="p">
    <verse number="8" style="v" />A o a viavisaipa chyhsa cha, A bu a zaw saipa pavaw hawhta a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sathaw nata ropahâhpa ta palôh palysa ta, Viasa ryhraokheina bie phapa chhao a thlôh ngaita.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nâma viasa nata na paw viasa a paphasai leipa la, Chhiena nâ tyhna noh ta na unawhpa o pangai khah y. Lâhlapi liata unawhpa hlâta cha, Lâhnia liata a y pa na opa phapa a pha via.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ei sawchapawpa y, so la, ei palôh palysa mah y, Chatanachata nâ reipachhietuhpazy ei chhy thei aw ei.
  </para>
  <para style="p">
    <verse number="12" style="v" />Asopa cha chichhihpa hmô thaipa ta a nyusai ta, Sona a phahlapa deikua cha chatôh ta pasa a tao tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khichhaipa châta sôhkâ a sohpa cha, A chysia lapa la; Chihropa châta sôhkâ a sohpa chhao, A bietai châta a chysia lapa mah y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mydi kari ta thyu ta, A paro ngaitapa ta a vaih byhnâ a awpatuhpa cha, Ano châta chhie a sapa hawhta pachâpa a châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />A hryu a pahâh kawpa lapinô cha, Avâ neih nota avâ di a tla ngâ thlâhpa nata miakha a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha hawhpa lapinô pakhâ a chhuahpa cha, Thlih pakhâpa nata miakha châ ta; Ku chachâh lâta sathaw patupa nata miakha a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thua cha thua ta chatapa châ ta, Chyhsapa chhao chyhsa hropa ta a chata tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theiku kô a mohôhpa ta a thei nie aw ta, A zibeipa a chakaopa chhao palyupalihpa a châ aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ti liata hmia tyhpa â lapa hawhta, Chyhsapa palôh cha chyhsapa châna a palâsa tyh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Athihkhih nata Chhokhih zy ta â daih tahpa ama hnei leipa hawhta, Chyhsapa mo ta â dai tahna rai hnei vei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathaisana beih cha tâkâ châta châ ta, Patina mei chhao ngôh châta a châ; Chyhsapa deikua cha, Reithai a hlaona daihti liata pasiana â tyh tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahrupa sôkhaoh liata sâh chhaota Sôkhaih ta daih hra la, Ahruna ta ano cha siesai hlei aw vei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na mietaku zawzy duahmo pahno pasia la, Na sahroh zawzy a phapa ta vaih mah y.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hneirônazy cha chhâzaw châta châ leipa ta, Bei lakho chhao chhâ zydua châta châ vei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sibiepa raoh ta si panyupa kaw thaopa ta, Tlâhpizy liata âhnalasi pakhypa a châ tita,
  </para>
  <para style="p">
    <verse number="26" style="v" />Mietakutawzy ta na chysia châ tôh aw ei ta, Miezy ta lyu ty ama châ tôh aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na pati châta mie sâhpiti â daihpa ta hnei aw chi ta, Na chhôhkha châta nie awpa y aw ta, Na sawchanôzy mohôhna châta chhao â khi aw.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahy ta hmah ama chadai leipa chhao ta, Moleipazy cha a râpai ei ta; Mosiapazy deikua cha, Chakeibarôhneipa hawhta ama riah a pha.
  </para>
  <para style="p">
    <verse number="2" style="v" />Râh ta hmo a parao nahta, Ryureituhpa hluhpi vaw pua tyh ei ta; Pahnona nata novâhna a hneipa ryureituhpa ry liata deikua cha, Râh â ipa ta bohpi â duah tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dyhchhiepa ta dyhchhie hropa a tlybai pachhuah heihpa cha, Vâsua ta nie awpa rai pahlôh leipa ta, Chichei a phy pathlah khai hapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ryhpa a heihsaituhpazy cha moleipazy reithai tyh ei ta, Ryhpa a zyhtuhpazy deikua ta cha moleipazy amâ dyuh tyh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyhsa chhiepazy cha adona kyh ama novâh leipa ta, Abeipa a tluatuhpazy deikua cha adona kyh liata tlokhuh ama no a vâh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hrozie doleipa hneirôhpa hlâta cha, Â dona a hrokheipa dyhchhiepa a pha via.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ryhpa a zyhpa cha sawchapaw sopa châ ta, Azohpazy viasa deikua cha a paw no a paza tyh.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pôhna chadaipa ta a sôh a papôhsatuhpa cha, Dyhchhiepazy chô liata riaphapa châta a sôh cha a pachô.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ryhpa nathlie khoh leipa ta a nah su hro lâ a paheipa cha, A thlahchhâna chhao pasichhihpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lâpi doleipa liata chyhsa dopa a pasiesatuhpa cha, Ano khaohtlô chaopa lia tlai ta tla aw ta; Chyhsa phapakipazy deikua cha, Ryu phapa ama to aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hneirôhpa cha ano mokhaoh liata a pasosa kaw ta, Châhrasala novâhna a hneipa dyhchhiepa ta Hneirôhpa châna dopa a hmô pasia aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosiapazy ta pahniena ama to nahta, Palyupalihna rônahpa y ta; Moleipazy ama thyu nahta deikua cha, Chyhsazy amâ nyu tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A moleinazy a phihtuhpa cha vânoh to leipa aw ta, A moleinazy palâhâh ta a siesaipa deikua cha zawngiahna a hmô aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abeipa khâ a chipa chyhsa cha vânoh to aw ta, A palôh kuh khâ a pachhapa deikua cha chhiena lâ a tla aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Phopi dyhchhiepa chô liata ryureihtuh chhiepa cha, Chakeibarôhneipa a rôhpa hawhta châ ta, Chavyh a thyupa hawhta a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Novâhna a phahlapa ryureituhpa cha, Tlybaituhpa nôchhiepa châ ta; Adoleipa ta athôhna hmôpa a haotuhpa deikua cha, A hro chhôh kôzy a pasisa aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chyhsa thisaih maoh a phaohpa cha, Khaoh­tlô lâ a râ aw ta, Ahy ta hmah bao khah sy.
  </para>
  <para style="p">
    <verse number="18" style="v" />Adona ta a hrohpa cha pachhapa châ aw ta, A hroziezy adoleipa deikua cha eikhapi ta a pao aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />A chhaohlei a palietuhpa cha, Nie awpa hluhpi hnei aw ta; Hraoleipa a chadaituhpa deikua cha, A phahlapa hluhpi a hnei aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chyhsa ngâchhihpa cha byhnâ hluhpi to aw ta, Hneirôh patoh a chhuahpa deikua cha hrie leipa ta pua aw vei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khokhei viapa hneipa pha leipa ta, Châhrasala viahchhâ tlâ kha vâta, Chyhsa ta hmo a parao thei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsa riakhiehpa cha hneirôh awpa ta a para ta, Leina ta a vaw tlô thlu aw tahpa pahno vei.
  </para>
  <para style="p">
    <verse number="23" style="v" />A paleih ta a reithai pakheipa hlâta cha, Chyhsa a chhoreituhpa ta hnôhlâ ta khokheina a hlao via aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />A paw tlyma a nô tlyma hrao ta, “Paraona châ vei,” a tahtuhpa cha, Paraotuhpa viasa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Karâypa chyhsa cha ahryuna pathyu ta, Abeipa a ngâtuhpa deikua cha pathawhsapa a châ aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ano palôh a ngâtuhpa cha ahrupa châ ta, So thai kawpa ta a ypa deikua cha pachhapa a châ aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dyhchhiepa a pietuhpa cha a phahla leipa aw ta, A mo a pasopa deikua cha chhiesana thata â tyh aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Moleipazy ama thyu nahta, Chyhsazy a nyu ei ta; Moleipazy ama leidia nahta, Mosiapazy ama pôh tyh.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khâ chhoreipa chhao ta a kuh a chhapa cha, Eikhapi ta thliepa châ aw ta, Tlâh thei khao aw vei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosiapazy ta ryu ama rei nahta, Zawpi a ly ei ta; Moleipazy ta ryu ama rei nahta, Zawpi amâ hrô tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sona a pasôpa sawchapawpa cha a paw palysa ta, Âzuahnô a pakyhpa deikua cha a paw sôh a papai tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abei ta adona ta râh padua ta, Hmopiepa a latuhpa deikua ta cha a parao tyh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A vaih a reithai pakheipa cha, A phei sao â parai khâhpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moleipa cha a paraona liata a ao ta, Mosiapa deikua cha hla sa ta a tha a pha.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosiapa cha dyhchhiepazy adona pahno ta, Moleipa deikua cha, Cha hawhpa pahnona kyh liata a novâh vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mohnaotuhpazy ta khihpi pakâ ei ta, Asopazy deikua cha hiehâhna ama padia tyh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsa sopa ta chyhsa hrupa ryureina liata â ngiakhei khiahta cha, Ahrupa cha hiehâhpa nata pahneiparâpa ta y ta, Aryhna y thei vei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thisaih dâhphipazy cha chyhsa phapa a hao ei ta, Chyhsa dopazy hrona ama tei tyh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahrupa cha a hiehâhna zydua reih papua ta, Asopa deikua cha nyu ta â chalihkhei tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ryureituhpa ta haipa bie a nathlie khiahta cha, A beimachâ zydua chhao ama molei tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dyhchhiepa nata tlybaituhpa a tyh ei ta, Abeipa ta ama mo a pavâsa raihrie ei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dyhchhiepazy châta â dopa ta a pachiatuhpa abei cha, Chhâzaw ta a beidyuchhai â duah aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sôsi nata rana ta sona pie ta, Ano y ta paysapa hawti deikua cha, A nô châta nozana a tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Moleipazy ama pôh nahta, Moleina chhao pôh ta; Châhrasala mosiapazy ta ama paopa ama hmô aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na sawchapawpa cha chhorei la, Thlalôhpa ta cha paysa aw ta; Palôh lyna a cha pie aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmiasai y leina liata cha phopi leidia ei ta, Ryhpa a zyhpa deikua cha vânoh a to aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chakaotuhpa cha bie dei ta chhorei awpa châ vei, A novâh hra sala tao hlei aw vei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bie rei a chhaohdaolaohpa na hmô tyh ma? Cha chyhsa hlâta cha ahrupa châta hnabeiseihna a y via.
  </para>
  <para style="p">
    <verse number="21" style="v" />A hawti no tawhta a sei a dao palaopa cha, A chhâna lâta sâlâpa chyhsa ta a papua aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsa pathichhiepa cha ahryuna pathyu ta, Chyhsa hiehâhpa ta hmo hluhpi a parao tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chyhsa cha â palaina ta ano panawh aw ta, Chyhsa areisipa deikua cha palyupalihna a hlao aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Parutuhpa â pakaohpa cha ano hrona a haopa châ ta, Chhiesana bie thei ta, châhrasala reih vei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chyhsapa cha a china ta anosasy khoheih a chôkhâh ta, Abeipa a ngâtuhpa deikua cha â boh aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chyhsa hluhpi ta ryureituhpa khokheina tlua ei ta, Châhrasala Abeipa tawh deita ta chyhsa ta adona a hmô tyh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyhsa doleipa cha mosiapa châta pasichhihpa châ ta, Chyhsa dopa chhao moleipa châta pasichhihpa a châ hra.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Zake sawchapawpa Aku biesozy châ ta, Ithia hnohta reih ta, Ithia ta Ukâ hnohta a reipazy a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hru tu ha na ta, Chyhsapa a châ tlâh chhao châ va na, Chyhsapa novâhna hnei va na.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sona a vaw chu beih leipa na ta, Pathaihpa pahnona chhao a vaw chu beih va na.
  </para>
  <para style="p">
    <verse number="4" style="v" />Avâ lâ kiah ta a zâ chô heihpa cha ahy ma a châ tly? A ku ta thlih a chahupa cha ahy ma a châ tly? A poh ta ti a chatypa cha ahy ma a châ tly? Khizaw kaokih zydua a paduapa cha ahy ma a châ tly? A moh ahy ma a châ tly? A sawchapawpa moh ahy ma a châ tly? Na pahno mah tâh!
  </para>
  <para style="p">
    <verse number="5" style="v" />Khazohpa bie zydua â do tahpa pasiapa châ ha ta, Ano cha a chhaituhpazy châta vyhphao a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />A biezy baichha khah y, Chataleipatala cha ra aw ta, Haihthaipa ta hmôpa na châ pathlei aw na.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmo mia no cha hiah na ta, Ei thi hlâta na thlyu khah y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Adoleina nata haipa zy kei tawhta lâhlapi lâ pasie ha la, Dyhchhiena tlyma hneirôna tlyma na pie leipa la, Ei ngiahpa rakha ta na pasa lymâ mah y.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chataleipatala lôhrâtlôpa ta y aw na ta, “ Abeipa cha ahy ma a châ?” tahpa ta, Ei châ paphasai pathlei aw na. Dyhchhiepa ei châ khiahta cha paru aw na ta, Khazohpa moh ei pachhie pathlei aw na.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chakaotuhpa cha a zibeipa hnohta reipachhie beih khah y, Chataleipatala chhie cha sapa aw ta, Thailei pachâpa na châ pathlei aw na.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama pawzy chô liata chhie a sapazy y ei ta, Ama nôzy byhnâ a awpa leipazy chhao ama y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Âmo mokhaoh liata pathaih â tah kawpazy y ei ta, Châhrasala ama puana pathaipa châ hlei veih ei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama mo a sâh kawpazy chhao y ei ta, Ama mo vozy â sâh lâ sai ta a sai tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zaozi hâh a hneipazy y ei ta, Chaizôh naoh a hneipazy chhao ama y; Alei tawhta dyhchhiepazy palâ khai ei ta, Chyhsazy hry tawhta phahlapazy ama palâ tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chava ta sawchanô pano hnei ta, Ama moh cha, “Na pie teh” nata “Na pie teh” a châ. A lôhrâ a tlô beih leipa hmo mia thôh y ta, “Â daih” a tah beih leipa hmo mia palih a y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Athihkhih nata chhi chohpa zy cha ama lôhrâtlô beih leipa ta, Alei chhao ti ta a lôhrâtlô beih hra leipa ta, Mei ta, “Â daih,” tah beih vei.
  </para>
  <para style="p">
    <verse number="17" style="v" />Paw a mohnaopa mokhaoh nata Nô a nawhtawpa mokhaoh cha, Saikao raawhzy ta thaoh aw ei ta, Vâkhiehzy ta ama nie aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmo mia thôh ei châta noâhchhih ngaitapa y ta, Ei no a vâh thei leipa mia palih a y:
  </para>
  <para style="p">
    <verse number="19" style="v" />Avâ liata pahmôh lâpi, Lôpanô chô liata parih lâpi, Tilaipi liah khophie liata balyh lâpi nata Chapaw ta laihsa a pangaina lâpi zy ei novâh thei vei.
  </para>
  <para style="p">
    <verse number="20" style="v" />He he apheinô hro cha a châ: A nie khai tawhta a hmao a hru ta, “Moleina hmo khâpa hmah tao va na,” a tah tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hmo mia thôh vâta alei a chalyu ta, Mia palih ta a vi tita cha phaoh thei khao tyh vei:
  </para>
  <para style="p">
    <verse number="22" style="v" />Sei ta bei a châ tita, Ahrupa ta niedo lôhrâtlôpa ta a y tita,
  </para>
  <para style="p">
    <verse number="23" style="v" />Chanô khochhih leipa ta vahpa a hnei tita nata Seichanô ta a zibeinô su â thla tita alei â chalyu tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Alei chô liana heta hmo chyhpata mia palih y ta, Châhrasala ama so ngaita:
  </para>
  <para style="p">
    <verse number="25" style="v" />Hloia zaw cha thatlô lei kawpa châ ei ta, Châhrasala nopi nota nie awpa ama pachô.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tlâh pazupi zaw chhao pachyu lei kawpa châ ei ta, Châhrasala lôkâhpazy liata ama o ama tao.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khawsuzy ta bei hnei leipa ei ta, Châhrasala a hri hri ta ama sie.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zytôpuhpa chhao a kuzy ta a patu laih ta, Châhrasala abei ozy liata a pahrâ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hmo mia thôh cha ama lâ chakâzie mopa ta rônah ngaita ei ta, Ama keih raizie a rônah ngaitapa mia palih a y:
  </para>
  <para style="p">
    <verse number="30" style="v" />Chakeibarôhneipa cha râhsazy hry liata thatlô chaipa châ ta, Khâpa ta hmahta pasysa thei vei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Awhkhypa cha a khotlâh kawpa ta awhpanô a charia ta, Mie tôhpa chhao mie panô hmia liata cha hawhta tao ta, A siehnaopa a hnei leipa bei chhao rônah kawpa ta a sie tyh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hru kawpa ta nâmasasyh a pasâhsapa ta, Hmo chhiepa tao awpa nâ chhuah khiahta cha, Na pakah a chahu mah y.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sâhpiti patlaopa ta sâhpiti kuapa papua ta, Hnapasu chamiehpa ta thi papua ta, Hie pahâhpa ta ahryuna a papua tyh.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Bei Lemua hnohta a nô ta a pachupa biesozy a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hy ei sawchapawpa, khâpa ma na tao? Ei chhi tawhta a puapa y, khâpa ma na tao? Ei bietai sawchapawpa, khâpa ma na tao?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na thatlôna cha chanôzy pie leipa la, Na hroziezy chhao beizy a paraotuhpazy pie khah y.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hy Lemua y, kresawhti he beizy châta châ leipa ta, Beizy cha kresawhti ama do awpa châ vei; Ryureituhpazy chhao sahma ama do awpa châ vei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama do khiahta cha ryhpa my aw ei ta, Pasataopazy adona ama pahleipa pathlei aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leidia haipazy hnohta sahma pie u la, Palôh pasapazy hnohta kresawhti pie teh u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Doh ei sala ama dyhchhiena my ei sala, Ama pachârôhna amâ thei khao leina hâh ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Reihpathlie thei leipazy châta na pakah â la, Vâchhiepazy a duakheipa ta na pakah â mah y.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na pakah âpa ta siana ta ryureih la, Dyhchhiepa nata phahlapazy adona a duakhei mah y.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lapinô phapa ahy ma a hmô thei aw? Lapinô phapa cha lôsôhpazy hlâta a sôh via syulyu.
  </para>
  <para style="p">
    <verse number="11" style="v" />A vahpa palôh ta ano cha ngâ ta, Athôhna hmô leipa ta y aw vei.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hro chhôh noh zydua liata a vahpa châta Chhiena lâ châ leipa ta phana lâ sai ta hmo a taopa tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mietaku hmi nata pala rih dipa tlua ta, A ku ta palôhtlâhpa ta a hria tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sôhryhpa balyhzy hawhta châ ta, Lâhlapi tawhta niedozy a vaw tlôkhei tyh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Azo ta thyu ta, A chhôhkha nie awpa patohpatia ta, A chakaotuhpa laihsazy chhao ama nie awpa tovyuhzy a pie tyh ei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lyu hnei thei nawpa ta saduthliepa ta chalei ta, A hriapasana ta a hmôpa sôh hmâpa ta kre sadô a tao.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thatlôna ta a chai a saih ta, A bâh thazy a patlô tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A sôhpaliepa â thôh tahpa pahno ta, Zâ ta chhao a meiôh thi beih vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Raha ku liata a ku soh ta, A ku ta lahmi a patu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dyhchhiepazy lâta a ku pazawh ta, Phahlapazy lâta a ku a paza tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A chhôhkha châta dâhaw chi leipa ta, A chhôhkha zydua poh saihlawpa a pabu ei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ano châta chhao rakhô pohzy tao ta, A chysia cha pala rih dipa nata sainohpa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thokhy chhikaozy liata râh machâzy hnohta a vahpa â tyu nota, A vahpa cha zawpi pahnopa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pala rih dipa chysiazy taopa ta zuah ta, Chaisaihzy sôhdaohpa lâ a paphao tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />A chysia cha thatlôna nata rônahna châ ta, A ly kawpa ta daihti a vaw tlô awpa a mokhâh tyh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sona ta a pakah â ta, A paleih liata nôphana pachuna bie a y.
  </para>
  <para style="p">
    <verse number="27" style="v" />A chhôhkha khihsatôhtuna a phapa ta mohôh ta, Thathina viahchhâ nie vei.
  </para>
  <para style="p">
    <verse number="28" style="v" />A sawzy thyu ei ta, “Nohlaonô” tah ei ta, A vahpa chhao thyu ta a lapinô cha reithaipa ta,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Chanô hluhpi tao pha kaw sai ei ta, Châhrasala na ly khai ha ei,” a tah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khoiah hneina cha dôveina châ ta, Chhithaina chhao hraoleipa a châ; Abeipa a chituhpa chanô deikua cha reithaipa a châ aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />A hriapasana theilâpazy vâta lapinô cha palyupalih la, A hmotaopazy ta thokhy chhikaozy liata ano cha reithai mawh sy.
  </para>
</usx>
