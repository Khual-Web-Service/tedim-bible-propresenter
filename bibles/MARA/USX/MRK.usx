<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MRK" style="id">Thâtihpha Maka</book>
  <para style="h">Thâtihpha Maka</para>
  <para style="toc1">Thâtihpha Maka</para>
  <para style="toc2">Thâtihpha Maka</para>
  <para style="mt">Thâtihpha Maka</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />He he Khazohpa Sawchapawpa Zisu Krista thâtihpha athaona a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hrohsopa Isai châbu liata, “Moh teh, na lâpi a chhuahdy awpa ta, Ei lyuhchâpa na hmia lâta tuah na ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />Râhchawhpa liata awhpa ao ta, ‘Abeipa lâthlôh a chhuahdy u la, A lâpizy patlâsa teh u,’ a tah,” tahpa ta ropa hawhta,
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawhâna a vy ta, râhchawhpa liata bâti pachâsa ta, moleinazy ngiahthai nawpa ta rona bâtina bie phuah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zudia râh nata Zerusale khih tawhta chyhsa zydua ano lâ a vy ei ta, ama moleinazy palâhâh ei ta, Zawdâh chavah liata bâti a pachâsa lymâ ei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zawhâna cha râraoseihpa hmi chysia a tobi ta, a chai savo chaisaihna ta a saih ta, a pati cha khawsu nata kheihti a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zawpi hnohta, “Keima hlâta chyhsa rônah viapa ei hnôhlâ ta â vy hai. Kei cha a bôh ta, a pheiky ri a pathlâ tlâh awpa chhao châ va na.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei ta ti ta cha bâti ei na ta, ano ta la Thlahpa Pathaihpa ta a cha bâti aw ei,” tahpa ta phuah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha nohzy liata, Zisu cha Kâlili râh Nâzari khih tawhta a vy ta, Zawdâh chavah liata Zawhâna ta bâti pachâsa ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ti tawhta a kaw puapa nahta, avâ a pahypa hmô ta, Thlahpa cha vachhuh hawhta a chô liata a zâ choh ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Avâ tawhta ao za pua ta, “Ei Sawchapaw kyh ei pachâpa na châ, na chô liata ei ly ngaita,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thlahpa ta Zisu cha râhchawhpa lâ thlai a chhi ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Râhchawhpa liata noh sypalih chhôh Sâtâ reipasaopa ta y ta. Râhsazy hnohta pahrâ ta, vâlyuhchâpazy ta ano cha chakao ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawhâna ama patu tawhta, Zisu cha Kâlili lâ a vy ta. Khazohpa Thâtihpha chho ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />ama hnohta, “A daihti a ki ha ta, Khazohpa khinarâh â hnia haw. Ro u la, thâtihpha a ngiapâ teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kâlili Tipo kiah liata a sie hai nota, Saimaw nata a unawhpa Adaru cha tipo liata sao ama parai ngâpa hmô ta. Âmo cha nga patutuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta ama hnohta, “Na zi teh u, chyhsa patutuhpa ta ei cha tao aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama saozy thlai siesaipa ta Zisu cha zi ha ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bâhta a kei sie via nahta, Zebâdi sawchapawpa Zâmie nata a unawhpa Zawhâna cha balyh liata sao ama thei ngâpa hmô ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Âmo cha thlai aw ta, ama paw Zebâdi nata ama pahlaosapa chyhsazy cha balyh liata siesaipa ta, Zisu cha thlai zi ha ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chatawhcha Kâpynia khih lâ sie ei ta, Pahânoh ta pakhyna o liata thlai a ngia ta, zawpi pachu ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ryhpa pachutuhpazy hawhta châ leipa ta, biehneina chhaota a pachupa vâta, a pachuna kyh liata ama noâh kaw ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amâ pakhyna o liata thlahpa puapa a hneipa chyhsa pakha y ta, thlai vaw awh ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Nâzari Zisu, kheihta tao awpa ma miah na khoh? Miah pahleipadia awpa ta ma nâ vy? Khazohpa Chyhsa Pathaihpa na châ tahpa ei pahno,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zisu ta thlahpa cha ra ta, a hnohta, “A chalih la, a chhôh tawhta pua teh” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thlahpa puapa ta chyhsa cha thata padaosa ta, ao paro ngaitapa ta awh ta, a chhôh tawhta pua ha ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama zydua ta noâh tah ngaita ei ta, “He he khâpa ma a châ tly? Biehneina chhaota pachuna thiehpa a châ he! Thlahpa puapazy chhao taihta bie pie ta, a bie amâ ngiah thlâh hapa he,” tah ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chatanachata Kâlili râh chhôh zydua liata a thâtih thlai pathâh ha ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pakhyna o tawhta ama puapa nahta, Zâmie nata Zawhâna chhaota Saimaw nata Adaru o liata thlai a ngia ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Saimaw lapinô nô cha chasipa ta tlâh leipa ta, a zia thlâh ha ta. A thâtih cha Zisu thlai chho ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ano lâ vawh ta, a ku patupa ta pathyu ta, a chasipa cha pai ta, âmo cha chakao ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cha noh zâlâ noh a tla tawhta, tlâhleipa nata ahripa ta a patupa zydua ano lâ a vaw chhi ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />A khihpi ta ochhi thaby liata a vaw hmaohpakhy ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Tlâhleipa hluhpi, pasana hri nanopa a ohpazy patlâh ta, ahripa hluhpi papua hra ta. Ahripazy ta ano cha ama pahnopasiapa vâta, bie ama rei awpa pasaih leipa ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mydi kari khih a pavâ hlâta thyu ta, su dâhthlohpa lâ sie ta, cha liata thlahchhâ ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Saimaw nata a hnohta a ypazy ta ano cha tlua ei ta,
  </para>
  <para style="p">
    <verse number="37" style="v" />ama hmô nahta, a hnohta, “Chyhsa to ta ama cha tlua ngâ kaw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zisu ta ama hnohta, “A vaw daihpa khihzy lâ hao sie suh vy, hao khihzy liata bie ei chho thei hra nawpa ta; cha cha ei vyna chhâpa châ tlôh ta,” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kâlili râh zydua chahryh ta, amâ pakhyna ozy liata bie chho ta, ahripazy papua ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Phawhpa pakha ano lâ a vy ta, a hmiakô liata pakhu paneih ta, a hnohta, “Na khoh khiahta la, eina pathaisa thei chi na,” tahpa ta a haw ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Zisu cha a thapasa ngaita ta, a ku ta kei paza ta, ano cha hria ta, a hnohta, “Ei khoh na, pathaihpa ta y mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />A phawhpa cha thlai lei ta, a vaw pathaih haw.
  </para>
  <para style="p">
    <verse number="43" style="v" />Bie liahsa a taih khai tawhta pasiesa ta,
  </para>
  <para style="p">
    <verse number="44" style="v" />a hnohta, “Ahy hnohta hmahta khâpa hmah reih leipa la, sie la, theihthaipa a kei pamosa la, zawpi pahno awpa ta, Mawsi biepiepa hawhta nâ pathaisana châta atheihna kei hlâ mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Châhrasala cha chyhsa cha pua ta, a pathaih hana kyh cha reih lymâpa ta, thâtih tlao pathâhsa lymâ ta. Chavâta Zisu cha â lâhâhpa ta khihpi liata a ngia thei khao leipa ta, su dâhthlohpazy liata tlao y ta, su to tawhta ano cha ama pangai lymâ.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Noh khazie rakha ma a khô tawhta, Kâpynia khih lâ vaw kua heih ta. O liata a y tahpa chyhsazy ta pahno ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />O a tlôh khao leina taihta chyhsa hluhpi a vypakhy ei ta, ochhi thaby lia taihta yna y leipa ta. Âmo cha bie pachu ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chyhsa papalih ta pheisypa pakha ano lâ a vaw sy ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawpi ama hluh tupa vâta Zisu cha a hnia thei leipa ei ta, ano dady liata vâphuh phie ei ta, ama phie khai nahta, asypa cha a hmohphaw chhaota za pathliah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zisu ta amâ ngiapâna cha a hmô nahta, asypa hnohta, “Ei sawchapawpa, na moleinazy a ngiahthaipa a châ haw,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha liata ryhpa pachutuhpa thokha a tyuh hra ei ta, ama palôh liata,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Khazia he chyhsa heta cha hawhta bie a reih? Khazohpa a reipachhie he! Khazohpa dei leipa ta, ahy ma moleinazy a ngiahthai thei?” tahpa ta pachâ ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha hawhta ama palôh liata ama pachâpa cha Zisu ta a thlahpa ta thlai pahno ta, ama hnohta, “Cha bie cha khazia nama palôh liata nama pachâ?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pheisypa hnohna heta, ‘Na moleinazy a ngiahthaipa a châ haw,’ tahpa nata ‘Thyu la, na hmohphaw la la, phei ta sie teh,’ tahpa he a kheihawhpa ma a rei a nao via?
  </para>
  <para style="p">
    <verse number="10" style="v" />He hmo he, chyhsa Sawchapawpa he moleinazy a ngiahthai theina biehneina khizaw liata a hnei tahpa nama pahno nawpa ta taopa a châ,” tah ta. Asypa hnohta
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ei cha chho, thyu la, na hmohphaw la la, na o lâ a di teh,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama zydua mohmô ta thlai thyu ta, a hmohphaw la ta, pua ha ta. Zawpi zydua ta ama noâh ngaita ta, Khazohpa reithai ei ta, “He hawhpa he hmô beih ma pi,” tah ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tipo ngiahkâ lâ pua heih ta, zawpi zydua a hnohta a vy ei ta, âmo cha pachu ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />A sie hai nota, Alphu sawchapawpa Livai cha chhie kheina su liata â tyu thlâh hapa hmô ta, a hnohta, “Na zi teh,” tah ta, thyu ta, zi ha ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zisu cha Livai o liata pati a dôh hai nota, chhiekheituhpa hluhpi nata moleipazy chhao, Zisu nata a pachupazy hnohta pati dôh hra ei ta. Chyhsa hluhpi ta Zisu cha ama pazipa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Phârisaihzy hry liata ryhpa pachutuhpa thokhazy ta, Zisu ta chhiekheituhpazy nata moleipazy hnohta pati a dôhpa ama hmô nahta, a pachupazy hnohta, “Khazia chhiekheituhpa nata moleipazy hnohta niedopa ta a y?” tah ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta cha bie cha a thei nahta, ama hnohta, “Atlâhpazy ta dawhty a ngiah leipa ei ta, tlâhleipazy ta amâ ngiah. Mosiapazy pado awpa ta a zupa châ leipa na ta, moleipazy pado awpa ta a zupa tlao ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zawhâna pachupazy nata Phârisaihzy cha kâhvileipa ta y ei ta. Chyhsazy a vy ei ta, Zisu hnohta, “Khazia Zawhâna pachupazy nata Phârisaih pachuna a zyhpazy kâhvileipa ta y ei ta, na pachupazy he kâhvileipa ta ama y hra vei?” tah ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zisu ta ama hnohta, “Ahneina kyhchhi a hlaopazy ta myuhneituhpa ama hnohta a y chhôh cha, kâhvileipa ta ama y beih ma? Myuhneituhpa ama hnohta a y chhôh zydua cha, kâhvileipa ta y beih veih ei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Myuhneituhpa ama hry tawhta lana nohzy a vaw tlô aw. Cha nohzy liata deikua cha, kâhvileipa ta ama y aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahy hmahta chysia parohpa liata pohthâ thiehpa baithla beih veih ei. Ama bai khiahta cha, a baithlana ta tlao a daoparu aw ta, a thiehpa ta a parohpa cha hrie aw ta, tlao â hrie via ha aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahy hmahta savo titheih parohpa liata kresawhti thiehpa ryh beih hra veih ei. Ama ryh khiahta cha, kresawhti ta savo titheih cha tôhchheih aw ta, kresawhti a leih aw ta, savo titheih chhao a rao aw. Kresawhti thiehpa cha savo titheih thiehpa liata ama ryh tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pahânoh ta sâh thihzy chapiapa ta sie ta, a pachupazy ta ama sie pâ ta sâh suzy thlie ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Phârisaihzy ta a hnohta, “Moh tua, khazia Pahânoh ta tao awpa ryhpa ta a pasai leipa ama tao tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zisu ta ama hnohta, “Dâvi nata a hnohta a ypazy ta a phahlapa ta ama nodi nota ama hmotaopa kha reih beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="26" style="v" />Abiathâ theihthai beichaipa a châ nota, Khazohpa o liata a ngia ta, theihthaipazy deita nie pasaipa Ypâna Viahchhâ nie ta, a hnohta a ypazy chhao a pie hrapa kyh kha reih beih veih ei chi ma?” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama hnohta, “Pahânoh cha chyhsapa châta taopa châ ta, chyhsapa cha Pahânoh châta taopa châ vei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chyhsa Sawchapawpa he Pahânoh Beipa chhao a châ,” tah ta.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakhyna o liata a ngia heih ta, cha liata kusypa pakha y ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ano ama leih thei nawpa ta, Pahânoh ta a patlâh ma tahpa moh thlâh ha ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu ta kusypa hnohta, “A duah teh,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawpi hnohta, “Pahânoh ta khâpa tao awpa ma ryhpa ta a pasai? Hmopha tao awpa ma, pasasa awpa maw? Hrona pachha awpa ma, thie awpa maw?” tah ta. A thlih thlâh ha ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiehâhpa ta âmo cha moh ta, ama palôh kuhchhapa vâta a palôh pasa ngaita ta, kusypa hnohta, “Na ku pazawh teh” tah ta. A ku pazawh ta, a kusypa cha pha ha ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Phârisaihzy cha pua ei ta, ano ama thie thei nawpa pachâpa ta, Herawda pyzy nata thlai a chhohia ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zisu cha a pachupazy chhaota tipo lâ sie ta, Kâlili nata Zudia râhzy tawhta chyhsa hluhpi ta ano cha zi ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zerusale tawhta zy, Idumia râh tawhta zy, Zawdâh khô lâ tawhta zy, Tyre nata Sidaw khih chheipâh tawh zy ta ano cha zi ei ta. Zawpi hluhpi ta a hmotaopa rônahzie ama thei nahta, ano cha pangai lymâ ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zawpi ama hluh ngaitapa vâta, ano ama chadie lei nawpa ta, balyh chyhpa paruapa awpa ta a pachupazy chho ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyhsa hluhpi a patlâhpa vâta, hri ohpazy ta ano ama hria thei nawpa ta thata ama bypa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thlahpa chhiepazy ta Zisu ama hmô nahta, a hmiakô liata pao ei ta, “Khazohpa Sawchapawpa na châ,” tahpa ta awh ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Châhrasala a châna phuah lei awpa ta, âmo cha â i ngaitapa ta biepie ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chatawhcha tlâh lâ khy ta, ano ta a khopazy aw ta, ano lâ a vy ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pahrawh hleino a tlyh ta, âmo cha lyuhchâpazy ta rao ta. A hnohta y awpa nata bie chho awpa ta tuah awpa ta a raopazy châ ei ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />ahripazy papua theina biehneina a pie ei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chazy cha Pity tahpa ta moh a bipa Saimaw,
  </para>
  <para style="p">
    <verse number="17" style="v" />Tôkalôhpa sawzy tahpa ta ama moh a bipa Zebâdi sawchapawpa Zâmie nata a unawhpa Zawhâna,
  </para>
  <para style="p">
    <verse number="18" style="v" />Adaru, Phili, Bâthawlawmu, Mathai, Thawma, Alphu sawchapawpa Zâmie, Thâdia, Kâna chyhsa Saimaw nata
  </para>
  <para style="p">
    <verse number="19" style="v" />ano a patusatuhpa Zudâh Iskari zy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zisu cha o lâ a di ta. Chyhsa hluhpi a hnohta a vypakhy heih ei ta, chavâta Zisu nata a pachupazy cha pati chhao nie hmâ khao leipa ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />A chhôhkhazy ta cha thâtih cha ama thei nahta, “A palôh â ki khao ei vei chuh,” tah ei ta, a chhi awpa ta sie ei ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zerusale tawhta ryhpa pachutuhpa a zupazy ta, “Belzebu a hneipa a châ hih, ahripa bei a châpa vâta ahripazy a papua theipa a châ hih,” tah ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu ta âmo cha aw ta, ama hnohta pakhona bie hmâpa ta bie reih ta, “Kheihta ma Sâtâ ta Sâtâ a papua thei aw?
  </para>
  <para style="p">
    <verse number="24" style="v" />Khinarâh chhao anosasyh ta â dyuh khiahta cha kheihta â duah thei aw?
  </para>
  <para style="p">
    <verse number="25" style="v" />Chhôhkha nata chhôhkha a dyuh ei sala, cha chhôhkha cha a duah thei aw vei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sâtâ chhao anosasyh ta â dyuh khiahta cha, a pachhaih aw ta, a duah thei aw vei, a leidia aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahy hmahta chyhsa thatlôpa o liata a ngiapa ta a sôhzy hrao a chhuah sala, chyhsa thatlôpa cha a chahry ha tua leipa ta cha hrao thei aw vei. A chahry khai tawhta a o cha a hrao thei aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hmeiseihta ta ei cha chho ei, chyhsa sawzy moleina zydua nata reipachhiena bie ama reipa zydua a ngiahthai theipa a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thlahpa Pathaihpa a reipachhiepa deikua cha, khati nota hmahta a ngiahthaipa châ aw vei, tlyzaw moleina liata thaileichâpa ta a y,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Thlahpa chhiepa a hneipa a châ,” ama tahpa vâta, cha bie cha a reipa a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />A nô nata a unawhzy ano lâ a vy ei ta, khôtho liata a duah ei ta. Chyhsa tuapa ta, za paawsa ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />A kiapâh liata zawpi a tyuh hôlô ei ta, a hnohta, “Na nô nata na unawhzy ta cha tlua ei ta, khôtho liata ama y,” tah ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zisu ta âmo cha a chhy ta, “Ei nô nata ei unawhzy cha ahyzy ma ama châ?” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />A kiapâh liata a tyuhpa, ano a chadô thlâh hapazy cha moh ta, “Hezy he ei nô nata ei unawhzy cha ama châ!
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahy rai Khazohpa khopa a taopa maih, chazy tlai cha ei unawhzy, ei sietanôzy, ei nôzy ama châ,” tah ta.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tipo kiah liata pachu heih ta. Zawpi hluhpi a hnohta a vypakhy ei ta, tipo liata balyh liata kiah ta, a chô liata a tyuh ta, zawpizy deikua cha tipo kiah liata y ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pakhona bie hmâpa ta hmo hluhpi âmo cha pachu ta. A pachu lymâna liata ama hnohta,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Nathlie u la, moh teh u, chi hietuhpa cha chi hie awpa ta pua ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chi cha a hie nahta, thokha lâpi liata tla ei ta, pavawzy a vy ei ta, dyh khai ha ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thokha lôphiariapa, alei apana su liata tla ei ta, alei a chha leipa vâta thlai kaw pyuh ei ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />châhrasala noh a sa nahta vaw aih ei ta, thari ama hnei leipa vâta ama uah haw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chi thokha cha ahloh hry liata tla ei ta, ahloh cha kaw lai ta, chiriepazy cha disao ei ta, pathei thei veih ei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chi hropazy cha alei phapa liata tla ei ta, pyuh ei ta ama laiseih lymâ. Thei pathei ei ta, a lie sythôh, a lie sycharu nata a lie za kha ta ama pôh lymâ,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zisu ta, “Thei nawpa nakhaoh a hneipa maihta thei mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ano dei ta a y nota, a kiapâh ta a ypazy nata pahrawh hleinozy ta pakhona bie kyh hiahri ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu ta ama hnohta, “Khazohpa khinarâh bienyupa cha nama hnohta palâhâh hapa châ ta, khôtho chyhsazy châta deikua cha, ato pakhona bie ta reipa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chavâta, “Hmô cha hmô aw ei ta, Pahno thai aw veih ei; Thei cha thei aw ei ta, Ama novâh aw vei; Pahno thai ha ei sala cha, A palie aw ei ta, Ngiahthaipa ama châ ha awpa tlai!” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zisu ta ama hnohta, “Pakhona bie cha pahno thai veih ei chi ma? Kheihta ma pakhona bie hropa zydua nama pahno thei aw?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chi hietuhpa ta bie chi hie ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hezy he lâpi liata a tlapa bie chizy ama châ. Bie ama theipa nahta, Sâtâ a vy ta, ama palôh liata bie chi hiepa cha thlai a lapa ha tyh ei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hezy he lôphiariapa liata chi hiepazy ama châ. Bie ama theipa nahta, a ly ngaitapa ta thlai a pyh ei ta,
  </para>
  <para style="p">
    <verse number="17" style="v" />châhrasala âmo liata thari rai ama thla leipa vâta, bohpi leipa ta ama tha a zei ha tyh. Bie vâta rietheina tlyma, taolana tlyma a vaw y nahta, thlai ama pao ha tyh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahropazy cha ahloh thih liata chi hiepa ama châ. Bie cha thei ei ta,
  </para>
  <para style="p">
    <verse number="19" style="v" />châhrasala khizaw hmo pachâna nata hneirôna nata hmo hropazy tlaichhaina âmo liata a vaw ngia ta, cha chata bie cha disao ta, pathei thei leipa ta a y tyh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lei phapa liata chi hiepazy deikua cha, hezy he ama châ. Bie cha thei ei ta, a pyh ei ta, chi hiepazy cha a lie sythôh, a lie sycharu nata a lie za kha ta ama pathei tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta ama hnohta, “Meiôh cha a sona tôh liata so leipa ta, bai ry liata soh awpa ta tlyma, rakhô ry liata so awpa ta tlyma, ama vaw cheih beih ma?
  </para>
  <para style="p">
    <verse number="22" style="v" />Palâ lei awpa ta nyupa khâpa hmahta y leipa ta, a luah lei awpa bierupa khâpa hmah y vei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahy rai thei nawpa nakhaoh a hneipa ta thei mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu ta ama hnohta, “Nama bie theipa cha pakhâta ta pachâ teh u: nama panuana lilaw ta panuapa châ aw ei chi ta, cha hlâta hluh via chhao ta piepa nama châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />A hneipa cha pie baichhapa châ aw ta, a hnei leipa cha a hnei chhôhpa chhao lapa a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zisu ta, “Khazohpa khinarâh cha chyhsa ta alei liata chi a hiepa hawhta a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zâ ta a mô ta, nohchhô ta thyu ta, chi cha pyuh ta a laiseih lymâ. Kheihta ma cha hawhta a y tahpa pahno vei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Alei ta palaiseihsa ta a patheisa tyh. A hmiatua ta a kô, cha khai tawhta a suh, cha khai tawhta a suh liata sâh a vaw y tyh.
  </para>
  <para style="p">
    <verse number="29" style="v" />A thei cha a hmoh nahta, sâh hria daihti a châ hapa vâta, savâ ta thlai a tai tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zisu ta, “Khazohpa khinarâh cha khâpa nata ma eima pakho aw? A châ vei khiah, kheihawhpa pakhona ma eima hmâh aw?
  </para>
  <para style="p">
    <verse number="31" style="v" />Khazohpa khinarâh cha âhrâ chi hmô kha alei liata pariepa hawhta a châ. Alei liata chi zydua hlâta chi chyh chaipa châ ta,
  </para>
  <para style="p">
    <verse number="32" style="v" />châhrasala pariepa a châpa nahta, kaw pyuh ta, chichei hropa zydua hlâta lai chai ta, chiah lai ngaitapazy pachiah ta, vâ pavawzy ta a buh nohdi ry liata amâ rie tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ama pahno thei nawpa ta, cha hawhpa pakhona biezy hmâpa ta ama hnohta bie reih tyh ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pakhona bie hmâ leipa ta ama hnohta reih beih vei. A pachupazy hnohta deikua cha, arulâta ato a chhopasia tyh ei.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cha noh liata, zâlâ a vaw châ nahta, ama hnohta, “Haosâ lâ kei chaka ei suh u,” tah ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zawpizy cha siesaipa ta, ano cha a kiana balyh ualuapa ta siekhei ei ta, balyh hropazy chhao a hnohta y ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Thlihpi ru ngaitapa vaw pathli ta, tichatlaopazy ta balyh cha thata su ta, balyh cha ti ta bie daihmâ ha ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Châhrasala ano cha balyh chao lâ liata lahuah a huapa ta a mô thlâh ha ta. Kei pathyu ei ta, a hnohta, “Pachutuhpa, eima leidia awpa he pei tah va chi ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Zisu cha kaw thyu ta, thlih cha ra ta, tilaipi hnohta, “A chalih la, a thlih molo teh!” tah ta. Thlih cha a chalih ta, sidia ha ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Zisu ta ama hnohta, “Khazia nama chi? Ngiapâna hnei to veih ei chi ma?” tah ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chi ngaita ei ta, âmo nata âmo a hiahri ei ta, “He chyhsa he ahy ma a châ tly, thlih nata tilaipi chhao ta a bie amâ ngiahpa he?” tah ei ta.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tipo haosâ Kerâsene râh tlô ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balyh tawhta a pua nahta, thlahpa puapa a hneipa chyhsa pakha thlâ su tawhta thlai vaw pua ta, Zisu cha a vaw tyh ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha chyhsa cha thlâ su liata a pahrâ tyhpa châ ta, ahy ta hmahta ama chahry thei khao leipa, bâlia chhao ta ama chahry thei leipa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keihraizy daipa ta bâlia ta chahry tyh ei ta, châhrasala bâlia cha chhie ta, keihrai chhao a chaphie khai ha tyh. Ahy ta hmah kheihta hmah tao thei veih ei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chhô nah zâ ta thlâ su nata tlâh liata zy awh ngâ thlâh ha ta, anosasyh ta alôzy ta a â tyh ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lâhlapi tawhta Zisu a hmôpa nahta, a kei râ ta, a hmiakô liata pao ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ao paro ngaitapa ta awh ta, “Zisu, Khazohpa Chônôchaipa Sawchapawpa, ei chô liata khâpa tao awpa ma nâ chhuah? Khazohpa moh ta ei châ haw na, na taola khah y,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zisu ta a hnohta, “Nâ, thlahpa puapa, chyhsa tawhta pua teh!” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zisu ta, “Na moh ahy?” tah ta. Ano ta, “Ei moh cha Zahluh a châ, mo hluhpi eima châ,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cha râh tawhta papua lei awpa ta thata a haw ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tlâh baikhaihpa liata vao zaw ama lao chuahpa ta y ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thlahpa puapazy ta Zisu cha a haw ei ta, a hnohta, “Vaozy lâ hao miah papua la, âmo chhôh lâ miah pangiasa teh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zisu ta amâ hawna cha pasaih ta. Thlahpa puapazy cha pua ei ta, vaozy chhôh liana cha a ngia ei ta. Vao zaw cha sâh no dua châ ei ta, chhutla lâta tilaipi lâ a râ lymâ ei ta, tilaipi liata ama tlasao khai haw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vao pasatuhpazy cha a râ ei ta, cha thâtih cha khihpi liata nata khitaw zy liata reih ei ta. Hmo a tlôpa cha moh awpa ta zawpizy a vy ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zisu kô ama kei tlô nahta, ahripa patupa, Zahluh kha chysia a tobipa ta, palôh sopa ta â tyu thlâh hapa hmô ei ta, chi ngaita ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />A hmôtuhpazy ta ahripa patupa chô liata hmo a tlôpa nata vao thâtihzy cha âmo chho ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu cha ama râh puasai awpa ta a haw ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Balyh a kia nahta, ahripa patupa khata Zisu hnohta y awpa ta a haw ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Châhrasala Zisu ta pasaih leipa ta a hnohta, “Na chyhsazy lâ vawh la, Abeipa ta na châta hmo rônahpa a taopa nata a cha ngiachhiezie zy kha na chyhsazy kei chho mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chatanachata sie ta, Zisu ta a chô liata hmo a taopa rônahzie cha Dekâpôli liata pathâhsa ta, chyhsa to ama noâh ngaita ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu cha balyh ta haosâ lâ chaka heih ta, tipo ngiahkâ liata a y nota, zawpi hluhpi ta vaw by ei ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pakhyna o hyutuhpazy hry liata pakha, a moh Zairu ama tahpa a vy ta, Zisu a hmô nahta, a phei thaby liata pao ta,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Ei sawchanô hawtipa thi daihmâpa ta y ta. Tlâh sala, a hro thei nawpa ta, a vy la, a chô liata na ku vaw pahnieh mah y,” tahpa ta a haw chaimâh ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu cha Zairu hnohta vawh ta. Zawpi hluhpi ta pazi ei ta, ano cha chakho hôlô ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chanô pakha kô hrawh hleino thi lohpa y ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dawhty hluhpi ta mohôh ei ta, a hneina zydua a pahryuh khai tawh chhao ta pha viana hlâta tlao paru via rili ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cha chanô chata Zisu thâtih a thei nahta, zawpi hry liata a hnôh lâta pazi ta, a poh pai hria ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />“A poh pai chhâ ei hria khiahta cha, patlâhpa ta ei y aw,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />A thi lopa cha thlai a hâh ha ta, a hri ohpa tawhta patlâhpa a châ haw tahpa a pôhpa liata a vaw pahno ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zisu ta a chhôh tawhta hmotaotheina a pua tahpa a pahno nahta, zawpi hry liata thlai a vaw palie ta, “Ahy ei poh pai a hria?” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />A pachupazy ta a hnohta, “Zawpizy ta ama cha chakho hôlôpa hmô thlâh ha chi ta, cha hawhta a châpa tlai ta, ‘Ahy nâ hria?’ na tah thlâh hapa cha?” tah ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zisu cha ano a hriatuhpa hmô a chhuahpa ta a heihhâ ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chanô cha a chô liata hmo a tlôpa cha pahnopa ta, chipa nata achalyuna chôta a vy ta, a hmiakô liata pao ta, a hnohta ato â dopa ta chho khai ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zisu ta a hnohta, “Ei sawchanô, nâ ngiapâna ta a cha patlâh haw. Thlalôhpa ta sie la, na pasana tawhta tlâh ha mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />A rei hai nota, pakhyna o hyutuhpa o tawhta chyhsazy a vy ei ta, “Na sawchanô a thi haw. Khazia Pachutuhpa rie na pathei khoh tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zisu ta ama bie reipa cha a thei nahta, pakhyna o hyutuhpa hnohta, “Chi leipa la, a ngiapâ thlâh ha mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pity nata Zâmie nata Zâmie unawhpa Zawhâna zy dei leipa cha, ahy hmahta ano zi awpa pasaih leipa ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pakhyna o hyutuhpa o cha kei tlô ei ta, Zisu ta zawpizy a tymâpa ta cha ei ta, ama sâh awh ngâpa hmô ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />A kei ngia ta, ama hnohta, “Khazia a tymâpa ta nama cha? Hawtinô he thi vei, â môpa dei a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Zawpizy ta pahneisao ei ta. Châhrasala zawpi zydua cha khôtho lâ papua khai ta, hawtinô paw nata nô nata a hnohta a ypazy a chhi ta, hawti yna lâ cha a ngia ei ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hawtinô ku cha patu ta, a hnohta, “Tâlithâ kumi,” tah ta. Cha yzie cha, “Hawtinô, ei cha chho, thyu teh,” tahna a châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hawtinô cha thlai thyu ta, sie thei ha ta. Hawtinô cha kô hrawh hleinopa a châ. Zawpizy cha ama noâh ngaita ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Zisu ta cha thâtih cha ahy hnohta hmah pahnosa lei awpa ta zawpizy cha â i ngaitapa ta biepie ta. Hawtinô cha niepa pie awpa ta âmo cha chho ta.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha su tawhta pua ta, a khih lâ ngai ta, a pachupazy ta ano cha zi ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pahânoh ta pakhyna o liata pachu pathao ta. A bie a theituhpa hluhpizy cha ama noâh ngaita ta, “He chyhsa heta, he biezy he khataih tawhta ma a pahno tly? He chyhsa hnohta sona piepa he kheihawhpa sona ma a châ tly? Kha hawhpa hmonoâhpazy kha, kheihta ma a ku ta a tao thei tly?
  </para>
  <para style="p">
    <verse number="3" style="v" />He chyhsa he Zâmie, Zôse, Zudâh nata Saimaw zy unawhpa, Mâri sawchapawpa, tho zôthaipa kha châ vei ma? A sietanôzy chhao, he liata eima hnohta y thlâh ha veih ei ma?” tah ei ta. Chavâta a chô liata ama palôh châ leipa ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta ama hnohta, “Hrohsopa cha, a khih nata a chiheih nata a chhôhkha liata tah leipa ta la, palyupalihna hlao leipa ta y beih vei,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chavâta tlâhleipa chyhsa chyhtazy chô liata a ku pahnieh ta a patlâhpazy dei leipa ta cha, Nâzari khih liata hmonoâhpa tao thei vei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama zo leina kyh liata noâh a tah ngaita. Chatawhcha khihzy chahryhpa ta, pachu lymâ ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pahrawh hleinozy cha aw ta, pano lymâ ta tuah ta, thlahpa puapazy chô liata biehneina ama hnohta pie ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chôchahrei dei leipa ta cha, khâpa hmah, viahchhâ tlyma, sahria tlyma, ama chaisaihna liata tâkâ tlyma a phao lei awpa ta, âmo cha biepie ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pheiky deikua a kypa ta, viahkao zo no a ky lei awpa ta biepie hra ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama hnohta, “Khataih lia rai ta, nama tlôna o cha nama sie heih hlâlei puasai khuh vy.
  </para>
  <para style="p">
    <verse number="11" style="v" />Châ ly leipa nata nama bie a nathlie khoh leipa khihzy cha, nama puasai tita, ama thaileichâna pahnosana châta nama phei liata buchadoh chatho thlu teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chatanachata sie ei ta, ro awpa ta chyhsazy chho laih lymâ ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahripa hluhpi papua ei ta, tlâhleipa hluhpi sathaw thu ei ta, ama patlâh lymâ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zisu cha a moh a pathâh kawpa vâta, Bei Herawda chhao ta a thâtih vaw thei ta. Thokhazy ta, “Bâtituhpa Zawhâna kha athipa hry tawhta thyu heih ta, chavâta he hmonoâhpa tao theina biehneinazy he ano liata a ypa a châ,” tah ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahropazy ta, “Elaizâh a châ,” tah ei ta. Ahropazy heih ta, “Hrohsopa na a châ, hrohsopa parohpa hry liata pakha a lyu,” tah ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Herawda deikua ta a thei nahta, “A luh ei tai hapa Zawhâna a vaw thyu heihpa a châ chuh,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Herawdâ ta a unawhpa Phili lapinô Herawdi cha lapinô ta a hneipa kyh liata, chyhsa tuah ta Zawhâna cha patusa ta, patâhna o liata chahryna chôta a khôpa kha a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zawhâna ta Herawda hnohta, “Na unawhpa lapinô na hneipa he ryhpa ta pasaih vei,” tahpa ta a chhopa vâta a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chavâta Herawdi ta Zawhâna cha a hao kaw ta, thie awpa khoh ta, châhrasala tao thei leipa ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Herawda ta Zawhâna cha chyhsa siapa nata pathaihpa a châ tahpa a pahnopa vâta chi ta, a pabohsapa a châ. A bie a thei nahta, a nôpo kaw tyh ta, châhrasala a ly ngaitapa ta a nathlie pyly tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Herawdi châta daihti rypaohpa vaw y ta. Herawda ta a pina noh liata a beimachâzy, a pheisaih hyutuhpazy nata Kâlili râh liata molaipazy châta kyhchhi tao ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Herawdi sawchanônô a vaw ngia ta, lâh ta, Herawda nata a hnohta a tyuhpazy cha palysa ngaita ta. Abei ta laihsa hnohta, “Na khopa maih na hiah teh, ei cha pie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hnohta bie a taih ta, “Khâpa rai eina hiapa maih chi cha, ei râh khophie chhao châ sala, ei cha pie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Laihsa cha pua ta, a nô hnohta, “Khâpa ei hia aw?” tah ta. A nô ta, “Bâtituhpa Zawhâna luh,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Laihsa cha abei lâ thlai a ngia ta, a hnohta, “Bâtituhpa Zawhâna luh beikoh liata sopa ta thlai eina pie awpa chi ta ei khoh,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abei cha a pachârôh ngaita ta, châhrasala chyhsa peimawhpa a hruapazy hmiakô liata bie â taih hapa vâta, laihsa hnohta bie a rei hapa cha parao khoh leipa ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abei ta pheisaih thlai tuah ta, Zawhâna luh vaw chei awpa ta biepie ta. Pheisaih cha vawh ta, Zawhâna luh cha patâhna o liata kei tai ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Beikoh ta a luh cha vaw cheih ta, laihsa hnohta pie ta, laihsa ta a nô hnohta pie ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cha thâtih cha Zawhâna pachupazy ta ama pahno nahta, a ri la ei ta, thlâ liata ama pazia haw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lyuhchâpazy Zisu lâ vaw kua ei ta, ama hmotaopa nata pachupa kyh zydua Zisu chho ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zisu ta ama hnohta, “Nâmo dei ta su dâhthlohpa lâ a vy u la, buakha a pahâ chy teh u,” tah ta. Chyhsa hluhpi ta zu heih, khy heih ama tahpa vâta, pati dâhdei chhao nie hmâ leipa ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Âmo deita ta su dâhthlohpa lâ cha balyh ta sie ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chyhsa hluhpi ta ama siepa cha hmô ei ta, âmo ama châ tahpa pahno ei ta, khih to tawhta phei ta a vaw râ chyu ei ta, tlô khâh ha ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zisu cha ngiahkâ lâ a pua nahta, zawpi hluhpi hmô ta, vaituhpa hnei leipa mietaku hawhta ama châpa vâta, âmo cha a tha pasa ngaita ta. Âmo cha hmo hluhpi pachu ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zâlâ a vaw châ nahta, a pachupazy ano lâ a vy ei ta, a hnohta, “He he su dâhthlohpa châ ta, zâlâ a châ ha hih.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ama nie awpa khâpa chhâ ma amâ kei chalei thei nawpa ta, zawpizy he eima chheipâh khihzy nata lyuzy lâ pasiesa teh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zisu ta ama hnohta, “Nâmo ta nie awpa pie teh u,” tah ta. Âmo ta a hnohta, “Dinâri za no mâ ta viahchhâ kei chalei sih la ma, nie awpa cha âmo eima pie aw?” tah ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zisu ta ama hnohta, “Viahchhâ tlâ khazie nama hnei? Vawh u la, kei moh tua u,” tah ta. Ama hneipa zie ama pahno nahta, “Viahchhâ tlâ pangawh nata ngasa miano,” tah ei ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Zawpizy cha sibiepa su liata a py py ta patyusa awpa ta a pachupazy cha biepie ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chatanachata a py py ta, za kha py ta zy, sypangawh py ta zy a tyuh ei ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Zisu ta viahchhâ tlâ pangawh nata ngasa miano cha la ta, avâ lâ ua ta, byhnâ aw ta. Viahchhâzy cha eichheih ta, zawpizy rai awpa ta a pachupazy pie ta. Ngasa mianopa cha pachhaih ta ama zydua ta rai ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ama zydua ta nie ei ta, ama rih bie khai ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Viahchhâ nata ngasa ama nie bâhpa chhao hrâbyh hmo hrawh hleino tlai a huah ei ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />Viahchhâ a nietuhpazy cha paw tlohpa sai ta sâh pangawh ama châ.
  </para>
  <para style="p">
    <verse number="45" style="v" />Zawpizy a pasiesa chhôh ta, a pachupazy cha a hmia lâta, haosâ Besaidâ khih lâ balyh ta thlai pasiesa chhielie ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Âmo a pasiesa khai nahta, thlahchhâ awpa ta tlâh lâ kiah ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />Zâlâ a vaw châ nahta, balyh cha tipo liah liata y ta, ano cha tlâh liata ano dei ta y ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />Thlih ta thata a supa vâta, balyh ama hiapa ama rie a thei kawpa ta hmô ta. Zâ vaina ei palihna rachhôh liata, âmo cha chapia a chhuahpa ta, tipo chô liata phei ta siepa ta, âmo cha kei pangai ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tipo chô liata phei ta a siepa ama hmô nahta, thlahmihpa khiah ma tah ei ta, thata sâh ei ta.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ama zydua ta hmô khai ei ta, ama chi ngaita. Zisu ta a pachupazy cha bie thlai a chho ta, ama hnohta, “Thlalôhpa ta y teh u; keima na ei châ. Chi khah u,” tah ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Ama hnohta balyh liata a ngia ta, thlih cha a chalih ha ta. A pachupazy cha ama noâh ngaita ta.
  </para>
  <para style="p">
    <verse number="52" style="v" />Ama palôh kuhchhapa vâta, viahchhâ kyh liata hmo a tlôpa kha ama pahno thai leipa a châ.
  </para>
  <para style="p">
    <verse number="53" style="v" />Haosâ lâ ama chaka nahta, Kenesare râh kei tlô ei ta. Ngiahkâ liata ama balyh hraih ei ta.
  </para>
  <para style="p">
    <verse number="54" style="v" />Balyh tawhta ama pua nahta, chyhsazy ta ano cha thlai pahno ha ei ta.
  </para>
  <para style="p">
    <verse number="55" style="v" />Cha râh chaby zydua lâ thlai sie ei ta. A yna su ama pahnona lâ maih tlâhleipazy ama hmohphaw chhaota a vaw sy ei ta.
  </para>
  <para style="p">
    <verse number="56" style="v" />Khitaw liata zy, khihpi liata zy, lyu liata zy, khataih lia rai ta a siena maihta, tlâhleipazy cha sôhdaoh su liata zy pazia ei ta, a poh pai chhâ hria awpa ta Zisu cha a haw ei ta, a hriapa maihta tlâh lymâ ei ta.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Phârisaihzy nata Zerusale tawhta a vypa ryhpa pachutuhpa thokhazy Zisu lâ amâ vypakhy nahta,
  </para>
  <para style="p">
    <verse number="2" style="v" />a pachupa thokhazy cha ku a si leipa ta, ku puapa ta pati ama niepa hmô ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Phârisaihzy nata Zu chyhsa zydua cha, machâzy taozietyhpa zipa ta, ama ku a phapa ta amâ si ha tua leipa ta cha pati nie beih veih ei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chavâta sôhdaoh su tawhta o lâ amâ di tita, ama ngai amâ si ha tua leipa ta cha, pati nie veih ei. Taozietyhpa ama zyhpa hropa hluhpi y ta, nyuzy, beihzy, dawhbeihzy nata niena tlâhkhaizy pasinazie hawhpa taozietyhpa hluhpi ama chhypa a y hra.
  </para>
  <para style="p">
    <verse number="5" style="v" />Phârisaihzy nata ryhpa pachutuhpazy ta Zisu hnohta, “Khazia na pachupazy ta machâzy taozietyhpa zi leipa ta, ku puapa ta pati ama nie thlâh haw?” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zisu ta ama hnohta, “Isai ta nâmo, phapakheipazy kyh liata, “‘He phopi heta ama hmao ta na palyupalih ei ta, Ama pathipalôh deikua ta cha einâ hla kaw ei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chyhsapa biepiepazy cha, Biezyhpa hawhta pachu ei ta, Hraoleipa ta einâ chhy ei,’ tahpa ta a vaw chhochhieliepa kha â vaw do kaw tlai na.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khazohpa biepiepazy siesai ei chi ta, chyhsa taozietyhpa tlao namâ patu,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chatawhcha Zisu ta ama hnohta, “Nama taozietyhpa nama chhy lymâ thei nawpa ta, Khazohpa biepiepazy thy nawpa rypaohna nama pahno kaw!
  </para>
  <para style="p">
    <verse number="10" style="v" />Mawsi ta, ‘Na nô nata na paw palyupalih teh. Ahy rai a nô tlyma, a paw tlyma a reipachhipa cha a thi tlai awpa a châ,’ tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nâmo deikua ta, ‘Chyhsa ta a nô tlyma, a paw tlyma hnohta, “Keima tawhta na hmô awpa zydua cha, Khazohpa lâ ei hlâ khai haw,” a tah khiahta cha,
  </para>
  <para style="p">
    <verse number="12" style="v" />a nô châta tlyma, a paw châta tlyma, khâpa hmah taopa awpa pasaih khao veih ei chi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha hawhna chata nama taozietyhpa namâ pie pachhuah lymâpa hmâpa ta, Khazohpa bie hraoleipa ta nama tao tyh. Cha hawhpa cha hmo hluhpi nama tao,’” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chatawhcha zawpizy ano lâ awpakhy heih ta, ama hnohta, “Nama zydua ta ei bie nathlie u la, pahno teh u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khôtho lâ tawhta chyhsa chhôh lâ a ngiapa khâpa hmo hmahta chyhsapa papuapalei thei vei. Chhôh lâ tawhta a kaw puapa ta chyhsapa cha tlao a papuapalei tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nakhaoh a hneipa maihta thei mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zawpizy cha o chhôh lâ â ngiasai tawhta, a pachupazy ta pakhona bie a reipa kyh hiahri ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta ama hnohta, “Nâmo chhao taihta pahno thai veih ei chi mâ? Khôtho lâ tawhta chyhsapa chhôh lâ a ngiapa ta chyhsapa papuapalei vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Palôh liata a ngia leipa ta, pavyhpi liata a ngia ta, lyupâh puana lâta a pua ha tyh tahpa pahno veih ei chi ma?” tah ta. Cha hawhna chata Zisu ta niepa zydua a pathaih khaizie phuah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chatawhcha Zisu ta, “Chyhsa chhôh tawhta a kaw puapa ta chyhsapa a papuapalei tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chhôh tawhta, chyhsapa pathipalôh tawhta, pachâna moleipazy a kaw pua tyh. Apatlana, paruna, lianycheina, apheina,
  </para>
  <para style="p">
    <verse number="22" style="v" />uahvana, chhiena, dôveina, parâna, kiaphaona, reipachhiena, apalaina nata hruna zy he palôh tawhta a kaw pua tyhpa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cha hmo zydua cha chhôh tawhta a kaw puapa châ ta, chazy chata chyhsa a papuapalei tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cha su tawhta Zisu cha thyu ta, Tyre nata Sidaw biazy chahryh ta. O miakha liata a ngia ta, ahy hmahta ama pahno awpa khoh leipa ta, châhrasala nyu thei awpa châ leipa ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chanô pakha, thlahpa puapa ta a sawchanô hawti a patu hapa ta Zisu thâtih cha thei ta, ano lâ thlai a vy ta, a phei thaby liata kei pao ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cha chanô cha Krikâh chyhsa, Suria râh Phônisia liata a pihpa a châ. A sawchanô tawhta ahripa papua awpa ta a haw ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu ta a hnohta, “Sawzy ama rih bie tua mawh sy. Sawzy ku liata viahchhâ chhu ta, izy piepa cha hmo yzie châ vei,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chanô ta a chhy ta, “A châ na, Abeipa! Châhrasala tlâhkhai ry liata izy chhao ta sawzy viahchhâ zôhpa a tlapazy cha ama nie tyh mâh tâh,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta a hnohta, “Na bie reipa vâna chata na o lâ a di mah y. Ahripa cha na sawchanô chhôh tawhta a pua haw,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chanô cha o lâ a di ta, rakhô liata a zia thlâh hapa hawtinô cha hmô ta, ahripa chata puasai ha ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zisu cha Tyre nata Sidaw râh tawhta pua ta, Dekâpôli râh chapiapa ta Kâlili Tipo kei tlô ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chyhsa pakha nahpâpa nata reih pathlie thei leipa ano lâ a vaw chhi ei ta, a chô liata a ku pahnieh awpa ta a haw ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zawpi hry tawhta ânano ta a chhi ta, a kuparozy ta a nakhaohzy cha hria ta, a pachih ta pachhao ta, a paleih hria ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Avâ lâ moh ta, a hrô ta, a hnohta, “Ephâthâ,” tah ta, cha cha “A pahy teh,” tahna a châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />A nakhaohzy a vaw pahy ta, a paleih chahryna chhao a vaw pathlâ ta, a siapa ta bie reih thei ha ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zisu ta ahy hmahta chho lei awpa ta âmo cha biepie ta. Châhrasala a pakhâ via nahta, phahnai ngiah viapa ta pathâhsa via rili ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zawpizy cha rei thai leina taihta ama noâh ta, “Hmo to a tao phazie rimâ cha! Nahpâpa taihta patheisa ta, reih pathlie thei leipa taihta a pathliesa haw,” tah ei ta.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha nohzy liata, zawpi hluhpi a vypakhy heih ei ta, nie awpa khâpa hmah hnei leipa ei ta. Zisu ta a pachupazy aw ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Zawpizy he tahmâ noh thôh tlai ei hnohta y ha ei ta, nie awpa khâpa hmah ama hnei leipa vâta, tha ei pasa ngaita ei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nie leipa ta ama o lâ ei padisa khiah ei ta cha, thokhazy cha amâ vyna a hla tlôh ta, lâpi liata ama panao aw,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />A pachupazy ta a chhy ei ta, “He zie chyhsa nie awpa ta, he su dâhthlohpa liana heta kheihta ma viahchhâ eima hnei thei aw?” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zisu ta, “Viahchhâ tlâ khazie nama hnei?” tah ta. “Tlâ sari,” tah ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zawpizy cha alei liata patyusa ta. Viahchhâ tlâ sari cha la ta, alyna bie a rei khai nahta, eichheih ta, zawpizy rai awpa ta, a pachupazy cha pie ta. Pachupazy ta zawpizy cha rai ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nga dipa chhao a chyhta hnei ei ta. Byhnâ a aw khai nahta, cha chhao cha zawpizy rai awpa ta a pachupazy chho ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nie ei ta, ama rih bie khai ta. Nie laibâhpa azôhpa chhao hrâbyh hmo sari tlai a huah ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />A niepa zydua cha sâh palih rachhôh ama châ. Chatawhcha zawpizy cha pasiesa ha ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zisu cha a pachupazy chhaota balyh thlai kiah ta, Dalmanuthâ râh lâ sie ha ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Phârisaihzy vaw pua ei ta, Zisu bie cha ei ei ta. Ano pasia nawpa ta, avâ tawhta ngiana ano liata tlua ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zisu cha a thlahpa ta thata a hrô ta, “He chhâ heta khazia ngiana a tlua tly? Hmeiseihta ta ei cha chho ei, he chhâ hnohna heta ngiana piepa châ aw vei,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Âmo cha siesai ta, balyh liata kiah ta, haosâ lâ chaka ha ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pachupazy ta viahchhâ a phao awpa my ha ei ta, viahchhâ tlâ kha dei leipa ta cha, balyh liata ahropa rai hnei leipa ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zisu ta pachupazy cha zikyu a râ ta, ama hnohta, “A hrohrua u la, Phârisaihzy thinô nata Herawda thinô tawhta a vaih teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pachupazy ta viahchhâ ama hnei leipa kyh reih ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta ama biereipa cha pahno ta, ama hnohta, “Khazia viahchhâ nama hnei leipa kyh nama reih? Pahno thai to veih ei chi ma? Nama no a vâh to vei ma? Nama palôh kuh a chha thlâh ha chy ma?
  </para>
  <para style="p">
    <verse number="18" style="v" />Mokhaoh hnei ei chi ta, hmô veih ei chi ma? Nakhaoh hnei ei chi ta, thei veih ei chi ma? A thei khao veih ei chi ma?
  </para>
  <para style="p">
    <verse number="19" style="v" />Chyhsa sâh pangawh châta viahchhâ tlâ pangawh ei pachhaih nona khata, hrâbyh hmo khazie ma nie laibâhpa namâ huah khawh?” tah ta. Âmo ta, “Hmo hrawh hleino,” tah ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Cha khiahta la, chyhsa sâh palih châta viahchhâ tlâ sari ei pachhaih nona khata, a laibâhpa khazie namâ huah?” tah ta. Âmo ta, “Hmo sari,” tah ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta ama hnohta, “Pahno thai to veih ei chi ma?” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Besaidâ khih tlô ei ta. Mochaopa Zisu lâ a vaw chhi ei ta, hria awpa ta a haw ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mochaopa cha a ku ta patu ta, khih tawhta puakhei ta, a mo liata a pachih pachhao ta, a chô liata a ku a pahnieh khai nahta, hiahri ta, “Khâpa chhâ na hmô ma?” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chyhsa cha kaw ua ta, “Chyhsa hmô na ta, châhrasala tho a pasiepasâ ngâpa hawhta ei hmô,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />A mo liata a ku pahnieh heih ta, mohmia pasaih awpa ta chho ta, a mo vaw pavâpa ta, ato a sia ngaitapa ta hmô thei ha ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zisu ta, “Khih liata a ngia khah y,” tah ta, o lâta padisa ha ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu cha a pachupazy chhaota Kaisaria Philipi khihzy lâ sie ta. Lâpi liata ama sie nota, a pachupazy hnohta, “Chyhsazy ta ahy a châ eina tah ei?” tahpa ta hiahri ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Âmo ta a chhy ei ta, “Bâtituhpa Zawhâna a châ, cha tah ei ta; thokha ta Elaizâh a châ, cha tah ei ta; thokha ta hrohsopa ahy tlyma a châ, ama cha tah,” tah ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta, “Cha khiahta la, nâmo zaw ahy a châ eina tah ei chi?” tah ta. Pity ta a chhy ta, a hnohta, “Mesia na châ,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zisu ta a thâtih cha ahy hmah chho lei awpa ta pachupazy cha biepie ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zisu ta chyhsa Sawchapawpa cha hmo hluhpi pasa a tao awpa châ ta, machâzy, theihthai beizy nata ryhpa pachutuhpazy ta khoh leipa aw ei ta, thie aw ei ta, noh thôh khai tawhta a thyu heih awpa kyh a pachupazy pachu pathao ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cha bie cha a sia ngaitapa ta reih ta. Pity ta Zisu cha a chhi nano ta, ra ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zisu cha a vaw palie ta, a pachupazy moh ta, Pity cha ra ta, a hnohta, “Sâtâ, ei hnôh lâ y teh! Khazohpa hmozy pachâ leipa chi ta, chyhsapa hmozy tlao na pachâ via he,” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zawpizy cha a pachupazy chhaota ano lâ awpakhy ta, ama hnohta, “Ahy rai eina zi khoh khiahta cha, anosasyh a paky sala, a kraws a piapa ta na zi mawh sy.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahy rai a hrona pabohsa a chhuahpa cha, a hrona pahlei aw ta, keima vâta nata thâtihpha vâta a hrona a pahleipa deikua cha, a hrona a pabohsa aw.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chyhsa ta khizaw he a pôhpalôhpa ta hnei sala, a thlahpa a pahlei tlôh khiahta cha, a châta khâpa a phahnai aw?
  </para>
  <para style="p">
    <verse number="37" style="v" />Chyhsa ta a thlahpa vyuhpa ta khâpa a pie thei aw?
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahy rai, he apheihmâhpa nata moleipa chhâ liana heta, kei nata ei biezy a zakheipa maih cha, Paw rônahna nata vâlyuhchâpa pathaihpazy chhaota Chyhsa Sawchapawpa â zu tita, ano cha a zakhei hra aw,” tah ta.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu ta ama hnohta, “Hmeiseihta ta ei cha chho ei, he a duahpa sahlaozy hry liata, Khazohpa khinarâh hmotaotheina chhaota a vaw tlôpa ama hmô hlâlei cha, thina a padi lei awpa ama y,” tah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Noh charu khai tawhta Zisu ta Pity, Zâmie nata Zawhâna zy a chhi ta, âmo dei ta tlâh sâhpa lâ khykhei ta. A hmiaphao cha ama hmiakô liata a vaw nano ha ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />A chysiazy cha a thlaraw vaw sie ta, alei chô liata chysia pasutuhpazy ta ama padiehsa theipa hlâ syulyu ta vaw dieh via ha ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Elaizâh nata Mawsi ama hnohta a vaw luah ei ta, Zisu cha bie a chho ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pity ta Zisu hnohta, “Pachutuhpa, he liata ypa he eima châta a pha na. Byureih miathôh, nâma châta miakha, Mawsi châta miakha, Elaizâh châta miakha tu ei suh u,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chi kaw ei ta, Pity cha bie hropa rei awpa pahno leipa ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chatawhcha meihdo ta âmo cha vaw khu ta, meihdo tawhta ao vaw pua ta, “He he ei Sawchapaw, kyh ei pachâpa a châ. A bie nathlie teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thlai mohmia pasaih ei ta, Zisu dei leipa cha, ama hnohta ahy hmah hmô khao leipa ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlâh tawhta ama za chô nota, athihpa hry tawhta Chyhsa Sawchapawpa a thyu heih hlâlei cha, hmo ama hmôpazy ahy hmah chho lei awpa ta âmo cha biepie ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />A bie reipa cha a vao thlâh ha ei ta, athihpa hry tawhta thyuheihpa cha khâpa tahna ma a châ tly, tahpa ta a hiahri raihrie ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pachupazy ta a hnohta, “Khazia ryhpa pachutuhpazy ta Elaizâh â vy tua awpa a châ ama tah tly?” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zisu ta ama hnohta, “Hmo to zydua tao pathi awpa ta Elaizâh cha â vy tuapa tlai a châ. Cha khiahta la, Chyhsa Sawchapawpa cha pasana hluhpi tao aw ta, mohnaopa ta a y awpa kyh cha, khâpa vâta ropa ma a châ?
  </para>
  <para style="p">
    <verse number="13" style="v" />Châhrasala ei cha chho ei, Elaizâh cha a thâtih ropa hawh tlai ta a vy ha ta, ama khozie hawhta a chô liata ama taopa kha a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pachupa hropazy yna ama za tlô nahta, ama kiapâh liata zawpi hluhpi hmô ei ta. Ryhpa pachutuhpazy nata pachupazy cha bie a ei ngâ kaw ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zawpi zydua ta Zisu ama hmôpa nahta, noâh tah kaw ei ta. Ano lâ thlai a râpa ta, a naoh ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zisu ta ama hnohta, “Ryhpa pachutuhpazy nata khâpa bie ma namâ ei?” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zawpi hry liata pakha ta, “Pachutuhpa, ei sawchapawpa nâ lâ ei vaw chhi. Ei sawchapawpa he thlahpa hnei ta, cha thlahpa chata reih pathlie thei leipa ta a tao haw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thlahpa ta a patuna maihta, taikhy ta, a pakah buchaphy tla ta, a hâhzy charieh ta, a pôhpa a vaw pala khai ha tyh. Thlahpa puapa cha papua awpa ta, na pachupazy a haw ei na ta, châhrasala papua thei veih ei,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zisu ta âmo cha a chhy ta, “Hy ngiapâleipa chhâ saih u, khachâ ma nama hnohta ei y aw? Khachâ ma ei cha pachâ thai aw ei? Kei lâ a vaw chhi teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hawtipa cha ano lâ a vaw chhi ei ta. Zisu a hmôpa nahta, thlahpa ta hawtipa cha a rie thlai patheisa ta, alei liata pao ta, a hluah ta, a pakah buchaphy tla ngâ kaw ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta a paw hnohta, “He hawhta a vaw y pathaona he khachâ a châ haw?” tah ta. A paw ta, “A hawtita tawhta a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pahleipadia awpa ta ei hluhpi mei liata zy, ti liata zy a papaosa tyh. Khâpa chhâ na tao thei khiahta la, miah ngiachhie la, miah bao mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu ta a hnohta, “‘Na tao thei khiahta la,’ na tah ma! Ngiapâtuhpa châta cha, ato tao theipa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hawtipa paw cha thlai awh ta, “Ei ngiâpâ na, ei ngiapâleina liata na bao mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zawpi amâ vaw râpakhy haipa Zisu ta a hmô nahta, thlahpa puapa cha ra ta, a hnohta, “Nâ, reih pathlie thei leina nata nahpâna thlahpa, bie ei cha pie, a chhôh tawhta vaw pua la, a ngia heih khao khah y,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thlahpa puapa cha awsâh ta, hawtipa cha thata a taochhie khai tawhta pua ha ta. Hawtipa cha athipa hawhta vaw y ta, chyhsa hluhpi ta, “A thi hapa he,” tah ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu ta a ku patu ta, pathyu ta, a vaw duah ha ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />O chhôh lâ â ngia nahta, a pachupazy ta, “Khazia keimo ta thlahpa puapa eima papua thei vei?” tahpa ta arulâta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta ama hnohta, “He hawhpa he cha thlahchhâna nata kâhvileina dei leipa ta cha, khâpa ta hmahta papua thei vei,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cha su tawhta pua ei ta, Kâlili râh chapiapa ta sie ei ta. Ahy hmahta a sievawna ama pahno awpa khoh leipa ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />A pachupazy cha pachu ta, ama hnohta, “Chyhsa Sawchapawpa he chyhsazy ku liata hlâpa châ aw ta, thie aw ei ta, ama thie tawhta noh thôh noh ta a thyu heih aw,” tah ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Châhrasala a bie reipa cha a pachâ nawpa rai pahno veih ei. Ano hra cha hiahri ngâh tlôh leipa ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kâpynia khih tlô ei ta. O chhôh liata a y nota ama hnohta, “Lâpi liana kha khâpa bie ma namâ ei tly?” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahy ma a rônah chai aw tahpa lâpi liata amâ vaw ei laihpa vâta, phie a chalih khai ha ei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />A tyuh ta, pahrawh hleinozy cha aw ta, ama hnohta, “Ahy rai a hmiatua chaipa a châ khoh khiahta cha, chyhsa zydua hlâta hnôh chaipa ta a y awpa châ ta, chyhsa zydua chakaotuhpa ta a y awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hawtipa pakha la ta, ama hry liata paduasa ta, a bâh liata a pyh ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="37" style="v" />“Ahy rai ei moh ta he hawhpa hawti pakha chhao a lypa cha, keima nâ lypa a châ. Keima nâ lypa cha, keima nâ lypa châ leipa ta, nâ tuahtuhpa a lypa tlao a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zawhâna ta a hnohta, “Pachutuhpa, chyhsa pakha na moh ta ahripa a papuapa hmô pi ta, miah a pazi leipa vâta eima pakhâ haw,” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Zisu ta, “Pakhâ khuh vy. Chyhsa ahy rai ei moh ta hmonoâhpa a taopa cha, hnôhlâ ta thlai na reipachhie pazi aw vei.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ahy rai miah a dyuh leipa cha eima chhâh a châpa a châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hmeiseihta ta ei cha chho ei, ahy rai Krista moh vâta ti nyu kha châ padopa cha, a lymâ pahlei cheita aw vei.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Ahy rai, he nâ ngiapâtuhpa hawtizy hry liata pakha chhao a pahluasapa cha, a rao liata charona lô laipa paaopa ta tilaipi liata thypa châ sala ano châta a pha via aw.
  </para>
  <para style="p">
    <verse number="43" style="v" />Na ku ta a cha pamoleisa khiahta cha, tai ha mah y. Ku miano ta Kehenâ lâ sie awpa hlâta cha, ku miakha chôpa ta hrona liata a ngiapa na châta a pha via.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kehenâ liata cha ama lôpa thi beih leipa ta, mei chhao pachhaipa ta y beih vei.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na phei ta a cha pamoleisa khiahta cha, tai ha mah y. Phei no hneipa ta Kehenâ lâ thypa châ awpa hlâta cha, pheisypa ta hrona lâ a ngiapa na châta a pha via.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kehenâ liata cha ama lôpa thi beih leipa ta, mei chhao pachhaipa ta y beih vei.
  </para>
  <para style="p">
    <verse number="47" style="v" />Na mo ta a cha pamoleisa khiahta cha, thaoh ha mah y. Mo no hneipa ta Kehenâ liata thypa châ awpa hlâta cha, mo kha hneipa ta Khazohpa khinarâh lâ a ngiapa na châta a pha via.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kehenâ liata cha, ama lôpa thi beih leipa ta, mei chhao pachhaipa ta y beih vei.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chyhsa to mei ta pasiapa châ aw ei ta, atheihna to alôh ta pa-iahpa a châ aw.
  </para>
  <para style="p">
    <verse number="50" style="v" />Alôh cha a pha, châhrasala alôh cha a padâh ha khiahta cha, kheihta ma nama pa-iahsa heih thei aw? Alôh hawhta iah u la, a dyryh kawpa ta y muh vy,” tah ta.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu cha, cha su tawhta pua ta, Zawdâh haosâ Zudia râh lâ sie ta. Zawpizy ano lâ a vypakhy heih ei ta. A tao tyhpa hawhta, âmo cha pachu heih ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phârisaihzy ano lâ a vy ei ta, ano pasia nawpa ta, “Chapaw ta a lapinô ma awpa ryhpa ta a pasaih ma?” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu ta ama hnohta, “Mawsi ta kheihta ma bie a cha pie ei?” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Âmo ta, “Mawsi ta mana châ ropa ta lapinô ma awpa a pasaih,” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zisu ta ama hnohta, “Nama palôh kuhchhana vâta, he biepiepa he nama châta a ropa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Châhrasala leilô tao tua no tawhta, ‘Khazohpa ta âmo cha chapaw nata chanô ta a tao ei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chavâta chapaw ta a nô nata a paw siesai aw ta, a lapinô a patu aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chatanachata panozy cha pôhpa miakha ama vaw châ ha aw.’ Pano châ khao leipa ei ta, pôhpa miakha tlao ama châ haw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chavâta Khazohpa ta a pazaopa cha, chyhsa ta pachhaih khah sy,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />O liata ama y nota, a pachupazy ta cha bie cha Zisu hiahri heih ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu ta ama hnohta, “Ahy rai a lapinô ma ta, chyhsa hropa a hneipa cha, cha chanô chô liata a pheipa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chanô chhao ta a vahpa a chhaih sala, chyhsa hropa a hnei khiahta cha, cha chapaw chô liata â pheipa a châ hra,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hria awpa ta hawtizy ano lâ a vaw chhi ei ta, pachupazy ta âmo cha ra ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zisu deikua ta, cha cha a hmô nahta, a ly leipa ta, ama hnohta, “Hawtizy kei lâ a vaw chhi u la, dytha khah u. Khazohpa khinarâh cha, he hawhpa chyhsazy eih châ tlôh ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hmeiseihta ta ei cha chho ei, Khazohpa khinarâh cha, hawti a lypa hawhta a ly leipa maihta a ngia cheita aw veih ei,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hawtizy cha a bâh ta chalo ta, ama chô liata a ku pahnieh ta, byhnâ awpa ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sie awpa ta a pua nahta, chyhsa pakha ano lâ a vaw râ ta, a hmiakô liata pakhu paneih ta, a hnohta, “Pachutuh phapa, chhâzaw hrona ei hnei thei nawpa ta khâpa ei tao aw?” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta a hnohta, “Khazia phapa eina tah chi? Khazohpa dei leipa ta ahy hmahta phapa y veih ei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Biepiepazy na pahno: ‘Liany cheih kha, Aphei kha, Paru kha, Haipa ta chyhsa leih kha, Chyhsa dôvei kha, Na nô nata paw palyupalih teh,’ tahpazy na pahno,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ano ta Zisu hnohta, “Pachutuhpa, cha zydua cha ei hawti no tawhta ei zyh lymâ tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta ano cha moh ta, a kyhpachâ kaw ta, a hnohta, “Hmo miakha nâ phahla: sie la, na hneipa zydua zuah la, dyhchhiepazy pie mah y. Chatanachata vârâh liata ryu na hnei aw. Cha khai tawhta a vy la, na zi mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sôh hluhpi a hneipa a châpa vâta, cha bie vâna chata a hmia chhie kaw ta, pachârôhpa ta sie ha ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu cha mohmia pasaih ta, a pachupazy hnohta, “Hneirôhpazy châta la, Khazohpa khinarâh liata a ngia awpa a ru kaw aw tlai na” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pachupazy ta a bie reipa cha noâh tah kaw ei ta. Zisu ta âmo cha a chhy heih ta, “Saw saih u, Khazohpa khinarâh liata a ngia awpa cha a ru kaw tlai mâh tâh!
  </para>
  <para style="p">
    <verse number="25" style="v" />Chyhsa hneirôhpa Khazohpa khinarâh liata a ngia awpa hlâta cha, râraoseihpa chiephoh khaoh liata a ngia awpa tlao a nao via,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pachupazy cha ama noâh ngaita ta, a hnohta, “Chata khiahta cha, ahy ma pachha a châ thei aw tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu ta âmo cha moh ta, ama hnohta, “Cha cha chyhsapa châta la tao thei rimâ awpa châ leipa ta, Khazohpa châta deikua cha, tao thei leipa hmo châ vei. Khazohpa châta cha, ato tao theipa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pity ta a hnohta, “Moh tua, keimo he ato siesaipa ta eima cha zi hih,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta, “Hmeiseihta ta ei cha chho ei, keima vâta nata thâtihpha vâta, o tlyma, unawhzy tlyma, sietanôzy tlyma, nô tlyma, paw tlyma, sawzy tlyma, râhzy tlyma a siesaipa cha,
  </para>
  <para style="p">
    <verse number="30" style="v" />tahmâ hro chhôh tlai heta ozy, unawhzy, sietanôzy, nôzy, sawzy, râhzy a lie za kha ta hmô aw ei ta, taolana nata daihti vaw tlô awpazy liata chhâzaw hrona ama hnei aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Châhrasala hmiatua chaipa hluhpizy cha hnôh chaipa châ aw ei ta, hnôh chaipazy cha hmiatua chaipazy ama châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zerusale lâ khy ei ta, lâpi liata ama sie nota, Zisu cha hmia a sah ta. Pachupazy ta noâh tah kaw ei ta, ano a zituhpazy chhao ta chi ngaita ei ta. Pahrawh hleinozy cha anano ta a chhi ta, a chô liata hmo vaw tlô awpazy âmo chho ta,
  </para>
  <para style="p">
    <verse number="33" style="v" />ama hnohta, “Pachâ teh u, Zerusale lâ eima khy hai hih. Chyhsa Sawchapawpa he theihthai beizy nata ryhpa pachutuhpazy ku liata hlâpa châ aw ta, âmo ta thie awpa ta thailei pachâsa aw ei ta, Zenitaizy ku liata ama hlâ aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zenitaizy ta ano cha pasipasawh aw ei ta, ama pachih ta pachhao aw ei ta, chhei aw ei ta, ama thie aw. Noh thôh noh ta a thyu heih aw,” tah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zebâdi sawchapaw Zâmie nata Zawhâna cha Zisu lâ a vy ei ta, a hnohta, “Pachutuhpa, eima châ hawpa maih miah na taopa awpa ta eima khoh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zisu ta ama hnohta, “Khâpa cha taopa ei sah la nama khoh?” tah ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Âmo ta a hnohta, “Na rônahna liata na chachâh lâta pakha, na chavei lâta pakha, miah patyusa mah y,” tah ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zisu ta ama hnohta, “Nama hiapa pahno veih ei chi. Ei nyu dopa nama doh thei aw ma? Ei bâti châna liata namâ bâti thei hra aw ma?” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Âmo ta a hnohta, “Eima tao thei aw,” tah ei ta. Zisu ta ama hnohta, “Ei nyu dopa cha doh thei aw ei chi ta, ei bâtina liata chhao namâ bâti thei ngyu aw.
  </para>
  <para style="p">
    <verse number="40" style="v" />Châhrasala ei chachâh lâ tlyma, ei chavei lâ tlyma a tyuh awpa kyh cha, keima pie awpa châ vei. Âmo châta a chhuahdy chiehpazy châta tlao a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Pahrawhzy ta cha kyh cha ama vaw pahno nahta, Zâmie nata Zawhâna chô liata ama palôh châ lei kaw ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zisu ta pachupazy cha aw ta, ama hnohta, “Zenitaizy chô liata ryureituhpa ta raopazy ta cha, ama sahlaozy chô liata amâ bei ngaitazie nata ama molaipazy chhao ta ama sahlaozy chô liata bie ama hnei ngaitazie nama pahno.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nâmo hry liata deikua cha, cha hawhta a châ awpa châ vei. Ahy rai nama hry liata molaipa châ a khoh khiahta cha, châ chakaotuhpa ta a y awpa châ ta,
  </para>
  <para style="p">
    <verse number="44" style="v" />ahy rai nama hry liata hmiatua chaipa châ a khoh khiahta cha, chyhsa zydua sei ta a y awpa a châ.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chyhsa Sawchapawpa chhao tlai he, chyhsazy ta ano ama chakao awpa ta a zupa châ leipa ta, ano ta chyhsazy chakaopa ta, chyhsa hluhpi chatlaina châta a hrona pie awpa ta a zupa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Zerikô tlô ei ta. Zisu cha a pachupazy nata chyhsa hluhpi chhaota Zerikô tawhta pua ta. Timia sawchapawpa mochaopa kudaopa Bâtimia cha lâpi kiah liata a vaw tyuh thlâh ha ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nâzari Zisu a châ tahpa a thei nahta, awh ta, a hnohta, “Zisu, Dâvi Sawchapawpa, na ngiachhie mah y!” tah ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chyhsa hluhpi ta a chalih awpa ta ra ei ta, châhrasala “Dâvi Sawchapawpa, na ngiachhie mah y!” tahpa ta awh via rili ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Zisu cha a duah ta, “Kei aw teh u,” tah ta. Mochaopa cha kei aw ei ta, a hnohta, “Thlalôhpa ta y la, thyu teh, a cha aw chu,” tah ei ta.
  </para>
  <para style="p">
    <verse number="50" style="v" />Mochaopa cha a poh thypa ta, a kaw zaw ta, Zisu lâ thlai pangai ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Zisu ta a hnohta, “Khâpa cha taopa awpa ma na khoh?” tah ta. Mochaopa ta a hnohta, “Pachutuhpa, mo pavâ awpa ei khoh,” tah ta.
  </para>
  <para style="p">
    <verse number="52" style="v" />Zisu ta a hnohta, “Sie mah y, nâ ngiapâna ta a cha patlâh haw,” tah ta. Chatanachata a mo thlai vaw pavâ ta, lâpi liata Zisu cha zi pâ ha ta.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zerusale a hnia ei ta, Ôli tlâh liata Bethaphâ nata Bethâni khih ama tlô nahta, Zisu ta a pachupazy hry liata pano tuah ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />ama hnohta, “Nama hmia lâta khih lâ hao vawh u la, khih namâ ngia nahta, ahy hmah kia beih leipa alâtaw hraipa hmô aw ei chi ta, pathlâ u la, a vaw chhi muh vy.
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Khazia khata nama tao?’ châ tahpa ama y khiahta cha, ‘Abeipa ta a khoh, he liata thlai a vaw soh heih aw,’ nama tah aw,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pachupazy cha vawh ei ta, ochhi kiapâh, khôtho lâ lâlai liata alâtaw â hraih thlâh hapa hmô ei ta, pathlâ ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cha liata a duahpa thokhazy ta ama hnohta, “Khazia alâtaw kha nama pathlâ?” tah ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zisu bie reipa cha âmo chho ei ta, chatanachata pasiesa ha ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alâtaw cha Zisu lâ a vaw chhi ei ta, ama pohzy ta a ky padia ei ta, Zisu ta alâ cha kiah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyhsa hluhpi ta lâpi liata ama pohzy phaw ei ta, ahropazy ta lyurâhpa liata thobuh chiahzy chhawhpa ta phaw ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hmia lâta a siepazy nata a hnôh lâta a pazipazy ta, “Haozanâ! Abeipa moh ta a vypa cha reithaipa ta y mawh sy!
  </para>
  <para style="p">
    <verse number="10" style="v" />Eima paw Dâvi khinarâh a vaw tlô awpa cha reithaipa ta y mawh sy! Chônôchaipa liata Haozanâ!” tahpa ta awh ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zerusale â ngia nahta, Achhyna o lâ vawh ta. Hmo to a mo khai nahta, vaw zâlâ ha ta, pua ta, pahrawh hleinozy chhaota Bethâni lâ sie ha ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mylâ ta, Bethâni tawhta amâ vy nahta, a nodi kaw ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lâhla tawhta theiku kô buh rôhpa kei hmô ta, a thei hmô awpa hnabeiseihpa ta pangai ta. A kei tlô nahta deikua cha, a hna dei leipa cha khâpa hmah hmô leipa ta. Theiku pathei daihti a châ mâh leipa vâta a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zisu ta theiku kô hnohta, “Ahy hmahta na thei nie beih khao khah sy,” tah ta. Cha bie cha a pachupazy ta thei ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zerusale tlô ei ta. Achhyna o liata a ngia ta, Achhyna o liata hmo a zuahtuhpazy nata a chaleituhpazy papua ta, tâkâ rituhpa tlâhkhaizy nata pivaw zuahtuhpa dyuchhaizy chhao chati pathlah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Achhyna o chapiapa ta hmo phaopa chhao ahy hmah pasai khao leipa ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Âmo cha pachu ta, ama hnohta, “‘Ei o cha phopi zydua châta thlahchhâna o ama bi aw,’ tahpa ta ropa châ vei ma? Nâmo deikua ta cha, parutuhpazy lôpu ta nama tao ha he zaw,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theihthai beizy nata ryhpa pachutuhpazy ta cha bie cha thei ei ta. Zawpi zydua ta a pachuna noâh ama tah ngaitapa vâta, Zisu cha chi ei ta, ama pahleipadia thei nawpa lâpi tlua ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zâlâ a vaw châ nahta, khihpi tawhta pua ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />My ta ama sie nota, theiku kô kha chapia ei ta, a thari taihta a raoh khai hapa hmô ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pity ta a vaw thei ta, Zisu hnohta, “Pachutuhpa, moh tua! Theiku kô chhie na sapa kha a raoh ha huh,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zisu ta ama hnohta, “Khazohpa a ngiapâ teh u.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmeiseihta ta ei cha chho ei, ahy rai he tlâh hnohna heta, ‘A pasie la, tilaipi liata a kei thy teh,’ tah sala, a palôh liata a lôh leina hnei leipa ta, a bie reipa cha a vaw tlô aw tahpa â ngiapâ khiahta cha, a châta taopa a châ aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chavâta ei cha chho ei, khâpa rai thlahchhâna ta nama hiapa maih hmô hapa hawhta pachâ teh u. Chatanachata nama hiapa cha nâmo eih a châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thlahchhâpa ta namâ duana maihta, chyhsa chô liata kheihawhpa biepeipa nama hneipa maih a ngiahthai ha muh vy. Chatanachata nama Paw vârâh liata a ypa chhao ta nama paraonazy a châ ngiahthai aw ei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Namâ ngiahthai vei khiahta cha, nama Paw vârâh liata a ypa ta nama paraonazy châ ngiahthai aw veih ei,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zerusale lâ a lie heih ei ta. Achhyna o chhôh liata â hlaihlâ hai nota, theihthai beizy, ryhpa pachutuhpazy nata machâzy ano lâ a vy ei ta,
  </para>
  <para style="p">
    <verse number="28" style="v" />a hnohta, “Khâpa biehneina hmâpa ta ma he hmozy he na tao? He hmozy tao awpa ta ahy ma biehneina châ pie?” tah ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta ama hnohta, “Bie kawh kha ei cha hiahri hra aw ei. Nâ chhy u la, kei chhao ta he hmozy he ahy biehneina ta ma ei tao tahpa ei cha chho aw ei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zawhâna bâtina kha vârâh tawhtapa ma, chyhsapa tawhtapa maw? Nâ chhy teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />A chhohia ei ta, “‘Vârâh tawhtapa,’ tah mawh sih la, ‘Cha khiah khazia a bie nama zo vei?’ miah tah ha aw?
  </para>
  <para style="p">
    <verse number="32" style="v" />‘Chyhsapa tawhtapa,’ eima tah thlâh ha aw tlyma?” tah ei ta. Châhrasala chyhsa zydua ta Zawhâna cha hrohso hmeiseihpa hawhta ama pachâpa vâta, zawpi chi tlôh ei, tahpa ta noraihpa ta y ei ta,
  </para>
  <para style="p">
    <verse number="33" style="v" />Zisu cha a chhy ei ta, “Pahno ma pi,” tah ei ta. Zisu ta ama hnohta, “Kei chhao ta ahy biehneina ta ma he hmozy he ei tao tahpa cha chho hra aw veih ei na,” tah ta.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pakhona biezy ta ama hnohta reih heih ta. “Chyhsa pakha ta kre sadô tao ta. Sadô cha dôh ta, kre saohna khaoh chao ta, o sâhpa sa ta, lyutaotuhpazy hnohta thlyu hlao awpa ta pie ta, râh hlapi lâ sie ha ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thei lyu â daih nahta, lyutaopazy lâ chakaotuhpa tuah ta, kre sadô theilâpazy âmo lâ kei palasa ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chakaotuhpa cha vaw patu ei ta, chhei ei ta, ku ruapa ta pasiesa ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chakaotuh hropa âmo lâ tuah heih ta, ano chhao cha a luh liata alô ta vawh ei ta, hmah paphao ei ta, nozachhih ngaitapa ta tao ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahropa tuah heih ta, ano chhao cha thie ei ta. Chakaotuhpa hropazy chhao, cha hawhta vaw tao lymâ ei ta, thokha tu ei ta, thokha thie ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pakha deita hnei bâ ta, cha cha a sawchapaw kho ngaitapa a châ. ‘Ei sawchapawpa chhâ he cha ama za aw,’ tahpa ta pachâ ta. Ano cha a chhâ chaina ta âmo lâ tuah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Châhrasala lyutaotuhpazy ta, ‘He chyhsa he ryutotuhpa cha a châ hih. A vy u la, thie ei suh u. Chatanachata ryu a to awpa cha keimo châta a châ aw,’ tah ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />A sawchapawpa cha patu ei ta, thie ei ta, kre sadô khôtho lâ ama thy haw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kre sadô hneituhpa ta kheihta a tao aw? Vawh aw ta, lyutaotuhpazy pahleipadia aw ta, kre sadô cha chyhsa hropazy a pie aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Biehrai liata, “‘O satuhpazy alô kho leipa kha, A ki lô a vaw châ haw;
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha cha Abeipa taopa châ ta, Eima mo liata â ngia ngaita,’ tahpa ta ropa reih beih veih ei chi ma?” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha pakhona bie cha âmo a nuapa ta a reipa a châ tahpa ama pahnopa vâta, Zisu cha patu awpa khoh ei ta. Châhrasala zawpi ama chipa vâta, Zisu cha siesaipa ta, sie ha ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />A bie reipa liata patu a chhuahpa ta, Phârisaihzy nata Herawda py liata chyhsa thokha Zisu lâ tuah ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kô ama tlô nahta, a hnohta, “Pachutuhpa, chyhsa dopa châ chi ta, ahy pachâna hmahta a papeisa va chi tahpa eima pahno. Chyhsapa alânazie ta cha pahnie leipa ta, hmeiseihna kyh ta Khazohpa lâpi na pachu tyh. Kaisarâ lâ chhie piepa he ryhpa ta a pasaih ma, pasaih vei?
  </para>
  <para style="p">
    <verse number="15" style="v" />Eima pie aw ma, pie aw vei?” tah ei ta. Zisu ta ama pasuapachao tahpa pahno ta, ama hnohta, “Khazia eina pasia ei chi? Tâkâ dinâri miakha na vaw pie teh u, ei moh tua aw,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tâkâ cha vaw pie ei ta. Zisu ta ama hnohta, “He he ahy nothlahpa nata ahy moh maw?” tah ta. Âmo ta, “Kaisarâ,” tah ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta ama hnohta, “Kaisarâ hmozy cha Kaisarâ pie u la, Khazohpa hmozy cha Khazohpa lâ pie teh u,” tah ta. Ama noâh ngaita ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thyuheihna y vei a tahpa Saduasizy ano lâ a vy ei ta, a hnohta,
  </para>
  <para style="p">
    <verse number="19" style="v" />“Pachutuhpa, Mawsi ta châ miah ropa ta, ahy rai a unawhpa ta saw hnei leipa ta a lapinô a thisai khiahta cha, a unawhpa lapinô cha hnei aw ta, a unawhpa châta chi a pathlapa awpa a châ tahpa ta miah a chho.
  </para>
  <para style="p">
    <verse number="20" style="v" />Unawh pasari y ei ta, a uhthei chaipa ta lapinô hnei ta, chi pathla leipa ta thi ha ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Unawh panona ta a uhta lapinô cha hnei ta, ano chhao chi pathla leipa ta thisai ha hra ta. Unawh pathôhna chhao, cha hawhta châ hra ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Unawh pasarina chhao ta chi pathla leipa ta thi ha hra ta. Achhâna liata, chanô chhao cha thi pâ ha hra ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thyuheihna daihti liata, ama thyuheih tita ahy lapinô ma a châ aw? Ama pasari ta lapinô ta hnei chyu tlôh ei ta,” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu ta ama hnohta, “Cha vâna chata vei ma nama pachâpasi tyh vei? Biehrai pahno leipa ei chi ta, Khazohpa hmotaotheina chhao pahno veih ei chi?
  </para>
  <para style="p">
    <verse number="25" style="v" />Athihpa hry tawhta ama thyuheih tita la, nôvah ahneina y khao aw vei. Vârâh liata vâlyuhchâpazy hawhta tlao ama châ ha aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Athihpazy pathyupa ta ama y awpa kyh cha, Mawsi châbu liata thobuh kyh rona liana khata, Khazohpa ta, ‘Kei he Abarahâ Khazohpa, Aisika Khazohpa nata Zakaw Khazohpa ei châ,’ tahpa ta Mawsi a chhona bie kha reih beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="27" style="v" />Khazohpa cha athihpazy Khazohpa châ leipa ta, ahrohpazy Khazohpa a châ. Nama pachâ chhei haw,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ryhpa pachutuhpazy hry liata pakha ano lâ a vy ta. Bie amâ ei ngâpa cha thei ta, a phapa ta â chhy lymâpa a hmô nahta, Zisu hnohta, “Biepiepa zydua hry liata khâpa ma a peimawh chai?” tahpa ta hiahri ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta, “Biepiepa peimawh chaipa cha he he a châ, ‘Hy Izarei, nathlie teh: Abeipa eima Khazohpa, Abeipa cha pakha deita a y.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abeipa na Khazohpa cha na pathipalôh tlokhuh ta, na thlahpa tlokhuh ta, na pachâna tlokhuh ta nata na thatlôna tlokhuh ta kyh na pachâ awpa a châ,’ tahpa hih.
  </para>
  <para style="p">
    <verse number="31" style="v" />A pazipa cha, ‘Nâma kyh nâ pachâpa hawhta, na vaih kyh na pachâ awpa a châ,’ tahpa he a châ. He hlâta biepiepa rônah viapa y vei,” tahpa ta a chhy ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ryhpa pachutuhpa ta a hnohta, “Pachutuhpa, na reipa â do na. Biedopa tlai na na reih. Khazohpa pakha deita y ta, ano leipa ta Khazohpa hropa rai y veih ei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khazohpa cha pathipalôh tlokhuh ta, pahnona tlokhuh ta nata thatlôna tlokhuh ta kyhpachâpa nata sasyh kyh a pachâpa hawhta vaih kyhpachâpa cha, a pôhpa duata rao khaipa raopa hlânazy nata atheihnazy hlâta pha via syulyupa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />So ngaitapa ta â chhypa cha Zisu ta a hmô nahta, a hnohta, “Khazohpa khinarâh tawhta a hla va chi,” tah ta. Cha rakha tawhta cha, ahy hmahta bie hiahri ngâh khao veih ei.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zisu cha Achhyna o liata pachu ta, hiahrinazy a chhy lymâ ta, ama hnohta, “Kheihtazie ta ma ryhpa pachutuhpazy ta Krista cha Dâvi sawchapawpa a châ tahpa ta ama rei tyh tly?
  </para>
  <para style="p">
    <verse number="36" style="v" />“‘Abeipa ta ei Beipa hnohta, Na chariahpazy na phei ry liata ei so khai hlâlei cha, Ei chachâh lâta a tyuh mah y,’ a tahpa kha.
  </para>
  <para style="p">
    <verse number="37" style="v" />Dâvi ta ano cha Abeipa a tah tlôh khiahta cha, kheihta ma Krista cha Dâvi sawchapawpa a châ thai aw?” tah ta. Zawpizy ta a ly ngaitapa ta a bie cha nathlie ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />A pachu lymâna liata hetana heta reih ta: “Ryhpa pachutuhpazy tawhta a vaih teh u. Âmo cha viahkao pasipazy a kypa ta, sôdaohna suzy liata anaohna hnabeiseih ei ta,
  </para>
  <para style="p">
    <verse number="39" style="v" />pakhyna o liata dyuchhai pha chaipazy a hnaw ei ta, kyhchhina liata su pha chaipazy amâ haw tyh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nôhmei olyuzy nie khai ei ta, a chapuahchaluah nawpa ta a pasi pi ta thlah ama chhâ tyh. Cha hawhpa chyhsazy cha thailei ama châ pachai aw,” tah ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Zisu cha thyuna byh dady liata a tyuh ta, chyhsazy ta thyuna byh liata tâkâ ama pathlapa cha moh ta. Chyhsa hneirôhpa hluhpizy ta a hluhpi pathla ei ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nôhmei dyhchhiepa a vy ta, tâkâ dipa miano pathla ta. Cha cha phusâ miakha tlu a châ.
  </para>
  <para style="p">
    <verse number="43" style="v" />Zisu ta a pachupazy aw ta, ama hnohta, “Hmeiseihta ta ei cha chho ei, sôh thyuna byh liata a pathlapa zydua hlâta, he nôhmei dyhchhiepa heta a pathla hluh chai.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mohropa zydua cha ama hnei laikhôpa thyu ei ta, he chanô deikua he cha, dyhchhie kawpa châ hra sala, a khihsatôhtuna châta a hmâ awpa a hnei chhôhpa a thyu khai ha hih,” tah ta.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Achhyna o tawhta a pua nahta, a pachupazy hry liata pakha ta a hnohta, “Pachutuhpa, moh tua, alôzy nata ozy he a rônah kaw dia!” tah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zisu ta a hnohta, “He o rônahpazy he na hmô bao ma cha? Alô pachopazy he parao leipa ta miakha hmahta y aw vei,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Achhyna o dady ta Ôli tlâh liata â tyu thlâh ha nota, Pity, Zâmie, Zawhâna nata Adaru zy ta arulâta bie hiahri ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Cha hmozy cha khati ta a vaw tlô aw? Cha hmo zydua vaw tlô nawpa daihti ngiana khâpa a y aw? Miah chho teh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zisu ta ama hnohta, “Ahy hmahta ama cha dôvei lei nawpa ta a vaih teh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa hluhpi ta, ‘Krista ei châ,’ tahpa ta ei moh ta a vy aw ei ta, chyhsa hluhpi ama dôvei aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Adyuhnazy nata adyuhna bie pathâhpazy nama thei tita, nôpopa ta y khuh vy. Chazy cha a vaw tlô awpa rai a châ, châhrasala chhâna la châ mâh vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Phopi nata phopi a dyuh aw ei ta, khinarâh nata khinarâh amâ dyuh aw. Su hluhpi liata alozy a sih aw ta, chakâhnazy a tlô aw. Chazy cha sawzeih pasa athaona a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Châhrasala a hrohrua teh u. Ryureituhpazy cha patusa aw ei ta, pakhyna ozy liata cha chhei aw ei ta, keima vâta ryureituhpazy nata abeizy hmiakô liata a duah aw ei chi ta, ama hmiakô liata pahnotuhpa châ awpa ta namâ duah aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thâtihpha cha phopi zydua hnohta chho khai tua awpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha patupa ta ama châ chhi tita, khâpa eima reih aw tahpa ta pachâ chhie chhielie khuh vy. A daihtita liata bie vaw tlô aw ta, cha bie cha nama rei awpa a châ. A reihtuhpa cha nâmo châ leipa aw ei chi ta, Thlahpa Pathaihpa tlao a châ aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thie awpa ta, unawhpa ta a unawhpa patusa aw ta, paw ta a saw patusa aw ta, sawzy ta ama nôpawzy a dyuh aw ei ta, ama pathiesa aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chyhsa zydua ta ei moh vâta ama châ hao aw. Châhrasala achhâna taihta a tao hualuapa cha pachhapa ta a y aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Châhrasala roryhrana pasichhihpa cha â dua lei nawpa su liata â duapa nama hmô tita, Zudia liata a ypazy cha tlâh lâ a râ mawh ei sy. A reihtuhpa ta a yzie pahno thai mawh sy.
  </para>
  <para style="p">
    <verse number="15" style="v" />O chô liata a ypa ta o ry lâ chô leipa sala, a o liata hmo la awpa ta a ngia khah sy.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lyu liata a ypa ta a poh la awpa ta kua heih khah sy.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha nohzy liata chanô sawphaohpa nata hawsaih a pyh haipazy hupo awpa rimâ cha!
  </para>
  <para style="p">
    <verse number="18" style="v" />Cha hmo cha chasipaw nota a vaw tlô lei nawpa ta thlahchhâ teh u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cha nohzy cha riethei pasana noh châ aw ta, cha tlatlu ta rarôh ypa cha, Khazohpa taopa leilô y tua no tawhta tahmâ taihta y beih leipa ta, y heih khao aw vei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abeipa ta cha nohzy cha pachhosa leipa chhochhi sala, chyhsa ahy hmahta pachhapa ta y aw veih ei. Châhrasala chyhsa atlyhpa, a raopazy vâta nohzy cha a pachhohsapa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chyhsa ta nama hnohta, ‘Moh teh u, Mesia cha he liata a y,’ a tah khiahta tlyma, ‘Moh teh u, hao liata a y,’ a tah khiahta tlyma, zo khuh vy.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mesia pakheipazy nata hrohso pakheipazy vaw pua aw ei ta, ngiana nata hmonoâhpazy ama tao aw. Tao theipa châ sala, atlyhpazy taih ama dôvei aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nâmo deikua cha, a vaih teh u, ato ei cha chhochhielie ha ei hih.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Cha nohzy liata, riethei pasana a y khai tawhta, noh pazohsapa châ aw ta, thlâpâ khaih khao leipa aw ta,
  </para>
  <para style="p">
    <verse number="25" style="v" />avâ tawhta awhsizy za tla aw ei ta, avâ hmotaotheinazy cha chalyupa a châ aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chatawhcha Chyhsa Sawchapawpa cha hmotaotheina nata rônah ngaitapa ta meihdo hry liata â zupa ama hmô aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />A vâlyuhchâpazy tuah aw ta, â tlyhpazy cha kaokih miapalih tawhta, alei chy chhâna tawhta avâ chy chhâna taihta a pakhy aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Theiku kô tawhta a chu teh u. A chhyh panyupa kaw paka ta, a hna a vaw thao khiahta cha, nopi â hnia haw tahpa nama pahno.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cha hawhna hra chata, chazy a vaw tlôpa nama hmô tita, Chyhsa Sawchapawpa cha a vaw hnia ha ta, chhikao thaby liata a y tahpa pahno teh u.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hmeiseihta ta ei cha chho ei, cha hmo zydua a tlô paki khai hlâlei cha, he chhâ he lei aw vei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lei nata vâ a lei aw, ei biezy deikua lei aw vei.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Châhrasala cha noh nata dawh cha, Paw dei leipa ta cha, ahy hmahta pahno veih ei. Vârâh liata vâlyuhchâpazy ta pahno leipa ei ta, Sawchapawpa chhao ta pahno vei.
  </para>
  <para style="p">
    <verse number="33" style="v" />A daihti vaw tlô nawpa nama pahno leipa vâta, riavaihpa ta y u la, a hrohruapa ta thlahchhâ teh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cha daihti vaw tlô nawpa cha, chyhsa ta lâhlapi lâ khitlyh ta, a o a siesaipa cha a chakaotuhpazy ku liata soh ta, ama raihria awpa pie chyu ta, ochhi vaituhpa cha, khâ a hra thlâh ha awpa ta bie a piepa hawhta a châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chavâta a hrohrua teh u, o hneituhpa vaw tlô nawpa daihti cha, zâlâ ta ma, zâcho ta ma, awhkho ta ma, my ta ma a châ aw tahpa pahno tlôh leipa ei chi ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chataleipatala eikhapi ta a vy aw ta, namâ mô chhôh ta a cha vaw pachhai pathlei aw ei.
  </para>
  <para style="p">
    <verse number="37" style="v" />Nama hnohta ei reipa he chyhsa zydua hnohta a reihpa ei châ: Riavaihpa ta y teh u,” tah ta.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zawpakhô nata thinô pahlao leipa Viahchhâ Kyhchhi tlô hlâ noh nona liata, theihthai beizy nata ryhpa pachutuhpazy ta Zisu cha dôpakhei ta patupa ta, ama thie thei nawpa kyh tlua ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Châhrasala, “Kyhchhi chhôh ta la châ khah sy. Chataleipatala zawpi a patypamâ pathlei aw na,” tah ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bethâni liata phawhpa Saimaw o liata pati a dôh hai nota, chanô pakha ta spinâ suapa ta taopa alabastâ sathaw sôh ngaitapa ôh vaw cheih ta, sathaw ôh cha pakei ta, Zisu luh liata bao ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cha liata a ypa thokha cha ama hiehâh kaw ta, “Khazia ma sathaw ropahâhpa a pahryuh thlâhthli tly?
  </para>
  <para style="p">
    <verse number="5" style="v" />He sathaw he dinâri za thôh hlâta hluh via ta zuah theipa châ ta, cha cha dyhchhiepazy piepa châ sala, a pha via awpa tlai,” tah ei ta. Chavâta chanô cha thata reipachhie ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zisu ta, “Chanô he kheihta hmah tah khuh vy. Khazia nama patypamâ? Ei chô liata hmo phapa a taopa a châ hih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dyhchhiepazy cha nama hnohta khâ a ypa châ ei ta, nama khona maihta ama châta hmo pha nama tao thei. Kei deikua cha, nama hnohta khâ a y awpa châ va na.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chanô heta a tao theipa a tao hih. Pabu awpa ta ei pôhpa he sathaw a thu chhieliepa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmeiseihta ta ei cha chho ei, khizaw zydua liata thâtihpha ama chhona su lia maihta, he chanô hmotaopa he ano a thei thlâh nawpa ta ama reih lymâ hra aw,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pahrawh hleino hry liata a hlao hrapa Zudâh Iskari ta Zisu patusa awpa ta theihthai beizy lâ vawh ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha kyh cha theihthai beizy ta ama thei nahta, a ly kaw ei ta, Zudâh Iskari hnohta tâkâ pie awpa bie a taih ei ta. Zudâh cha Zisu patusa awpa ta rypaohna tlua ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thinô pahlao leipa Viahchhâ kyhchhi noh, noh hmiatua chaipa, zawpakhô mietakutaw ama thie tyhna noh liata, a pachupazy ta a hnohta, “Khataih liata ma Zawpakhô pati na nie nawpa châ chhuahdy paw sih la na khoh?” tah ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />A pachupazy hry liata pano tuah ta, ama hnohta, “Khihpi liata a kei ngia u la, chyhsa pakha tibeih a chabapa ta châ tyh aw ei ta, ano cha nama pazi aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Â ngiana o hneituhpa hnohta, ‘Pachutuhpa ta, “Ei pachupazy chhaota zawpakhô pati ei nie nawpa chhôhpadâhpa khataih liata a y?” a tah,’ nama tah aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />A o chô lâta chhôhpadâhpa laipa, tobi chiehpa nata a mâ chiehpa cha pahmô aw ei ta, cha liata eima châta zawpakhô pati cha namâ chhuahdy aw,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pachupazy cha pua ei ta, khihpi cha kei tlô ei ta, ama hnohta a reipa hawh tlai ta hmô ei ta, zawpakhô pati cha a chhuahdy ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zâlâ a vaw châ nahta, Zisu cha pachupa pahrawh hleinozy chhaota a vy ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tlâhkhai liata dôh ei ta, ama nie hai nota, Zisu ta, “Hmeiseihta ta ei cha chho ei, nama hry liata pakha, ei hnohta a nie hrapa tlai ta einâ paphasai aw,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama pachârôh kaw ta, pakha pakha ta a hnohta, “Kei ei châ ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zisu ta ama hnohta, “Pahrawh hleino hry liata pakha, beikoh ei chapaolâhpa he a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chyhsa Sawchapawpa cha, a thâtih ropa hawh tlai ta a sie aw. Châhrasala Chyhsa Sawchapawpa a patusatuhpa cha a hu a po na! Cha chyhsa cha pih leipa sala, a châta a pha via awpa tlai,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama nie hai nota, Zisu ta viahchhâ la ta, byhnâ a aw khai nahta, eichheih ta, ama hnohta pie ta, “Nie teh u. He he ei sapa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chatawhcha nyu la ta, alyna bie a rei khai nahta, ama hnohta pie ta, ama zydua ta doh ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu ta ama hnohta, “He he ei thisaih, chyhsa hluhpi châta a lohpa biehrai thiehpa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmeiseihta ta ei cha chho ei, Khazohpa khinarâh liata a thiehpa ta ei dona noh a tlô hlâlei la, kre zôh patheipa tawhta doh heih khao aw va na,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hla ama sa khai nahta, Ôli Tlâh lâ sie ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu ta ama hnohta, “‘Mietaku vaituhpa tu aw na ta, mietakuzy ama pai aw,’ tahpa ropa hawhta, nama zydua ta nama pao khai aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Châhrasala pathyupa ta ei y tawhta, nama hmia lâta Kâlili râh lâ ei sie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pity ta a hnohta, “Ama zydua ta pao khai hra ei sala, kei la pao aw va na,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zisu ta a hnohta, “Hmeiseihta ta ei cha chho, tazâ tlai heta, awh ei no a kho hlâta, ei thôh einâ paphasai aw chi,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pity ta pachyu ngaitapa ta, “Na thina liata thi hra awpa chhao ta, châ paphasai cheita aw va na,” tah ta. Ama zydua ta cha hawhta reih chyu ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kesemani ama tahpa lâ sie ei ta. A pachupazy hnohta, “Thlah ei kei chhâ chhôhta, he liata a vaw tyuh chy muh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />A hnohta Pity nata Zâmie nata Zawhâna a chhi ta, Zisu cha nôpopa ta a pachârôh ngaita ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama hnohta, “Ei thlahpa a pachârôh ngaita ta, thina taihta a châ. He liata vaw y u la, vaw vaih teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />A chyhta kei chakâ via ta, alei liata a khu lâta pao ta, tao theipa a châ khiahta cha, cha dawh chata ano khô awpa ta thlahchhâ ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Abâ, ei Paw, nâma châta la, ato tao theipa a châ. He nyu he kei tawhta pasie ha mah y. Châhrasala keima rei châ leipa sala, nâma rei tlao châ mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />A vy ta, Pity nata Zâmie nata Zawhâna zy cha a vaw mô thlâh ha ei ta. Pity hnohta, “Saimaw, nâ mô ha mâ? Dawh kha chhao vaih thei va chi ma?
  </para>
  <para style="p">
    <verse number="38" style="v" />Reipasaona liata namâ ngia lei nawpa ta a vaih u la, thlahchhâ teh u. Thlahpa ta la hoh ta, sapa deikua a dadieh,” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Vawh ta thlahchhâ heih ta, a rei hmopa pyly reih heih ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />A vy heih ta, mokuh ama saih thei leipa vâta, a vaw mô thlâh ha heih ei ta, â chhy nawpa chhao pahno veih ei.
  </para>
  <para style="p">
    <verse number="41" style="v" />A ei thôhna ta vaw kua heih ta, ama hnohta, “A pahâ ei chi ta ma namâ mô thlâh ha chy? Â daih ha bâ, a daihti a vaw tlô haw. Moh teh u, Chyhsa Sawchapawpa he moleipazy ku liata hlâpa a châ ha bâ hih.
  </para>
  <para style="p">
    <verse number="42" style="v" />Thyu teh u, sie ei suh u. Moh teh u, nâ patusatuhpa â vaw hnia ha huh,” tah ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Bie a rei hai no tlai ta, pahrawh hleino hry liata a hlao hrapa Zudâh cha vaw tlô pâ ha ta. A hnohta theihthai beizy nata ryhpa pachutuhpazy nata machâzy nata zawpizy cha zaozi nata thothu a cheipa ta vaw tlô hra ei ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />A patusatuhpa ta, “Ei pahnâpa cha nama patu khohpa cha a châ aw. Patu u la, a phapa ta vaihpa ta a chhi muh vy,” tahpa ta ama hnohta ngiana vaw pie chhielie ha ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />A vaw tlôpa nahta, Zisu cha thlai pangai ta, a hnohta, “Pachutuhpa!” tah ta, Zisu cha a pahnâ ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chatanachata Zisu cha chahnao chakhipa ta, patu ha ei ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />A kiapâh liata a duahpazy hry liata pakha ta a zaozi phia ta, Theihthai Beichaipa chakaotuhpa cha chhawh ta, a nakao pathai pathlah ha ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />Zisu ta ama hnohta, “Zaozi nata thothuzy a cheipa ta ma, hraotuhpa patupa hawhta na patu awpa ta nama vaw pua?
  </para>
  <para style="p">
    <verse number="49" style="v" />Achhyna o liata noh to pachupa ta nama hnohta y tyh na ta, na patu leipa ei chi ta. Châhrasala Biehrai bie a vaw tlô nawpa ta, he hmo he a ypa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chatawhcha pachupa zydua cha Zisu a paphasaipa ta, a râsai khai ha ei ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Satlia pakha cha, poh rih dipa chysia deita a tobipa ta Zisu cha zi ta. Ano cha patu ei ta,
  </para>
  <para style="p">
    <verse number="52" style="v" />châhrasala a poh rih dipa chysia cha siesaipa ta, thluahruapa ta a râ ha ta.
  </para>
  <para style="p">
    <verse number="53" style="v" />Zisu cha Theihthai Beichaipa lâ a chhi ei ta. Theihthai bei zydua, ryhpa pachutuhpa zydua nata machâ zydua a vypakhy ei ta.
  </para>
  <para style="p">
    <verse number="54" style="v" />Pity cha â hlapi ta Zisu cha pazi ta, Theihthai Beichaipa o dôhpachhôh tlyhmia taihta pazi ta. Vaituhpazy hry liata mei a aihpa ta a tyuh hra ta.
  </para>
  <para style="p">
    <verse number="55" style="v" />Zisu ama thie thei nawpa ta theihthai beizy nata ryureituhpa zydua ta ano leihna tlua ei ta, châhrasala hmô leipa ei ta.
  </para>
  <para style="p">
    <verse number="56" style="v" />Chyhsa hluhpi ta haipa ta leih ei ta, châhrasala ama leihna cha a lyu tlâ leipa ta.
  </para>
  <para style="p">
    <verse number="57" style="v" />Thokha a vaw duah ei ta, haipa ta vaw leih ei ta,
  </para>
  <para style="p">
    <verse number="58" style="v" />“He chyhsa heta, ‘He Achhyna o, ku ta sapa he phie aw na ta, noh thôh chhôh ta Achhyna o hropa ku ta sa leipa ei padua aw,’ a tahpa eima thei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="59" style="v" />He liana chhao heta, ama pahnona bie a raohâh leipa ta.
  </para>
  <para style="p">
    <verse number="60" style="v" />Theihthai Beichaipa cha ama hry liata a kaw duah ta, Zisu hnohta, “A chhy awpa hnei va chi ma? He chyhsazy ta ama cha leihna he khâpa ma a châ?” tah ta.
  </para>
  <para style="p">
    <verse number="61" style="v" />Châhrasala a chalih thlâh ha ta, khâpa hmah a chhy leipa ta. Theihthai Beichaipa ta hiahri heih ta, “Nohlaopa Sawchapawpa Krista cha na châ ma?” tah ta.
  </para>
  <para style="p">
    <verse number="62" style="v" />Zisu ta, “Ei châ na, Chyhsa Sawchapawpa he Hmotaotheina chachâh lâta a tyuhpa ta, vâ meihdo hry liata â zupa nama hmô aw,” tah ta.
  </para>
  <para style="p">
    <verse number="63" style="v" />Theihthai Beichaipa cha a poh hrie ta, “Leihna hropa khâpa eimâ ngiah khao?
  </para>
  <para style="p">
    <verse number="64" style="v" />Khazohpa a reipachhienazie nama thei haw. Kheihta nama pachâ?” tah ta. Ama zydua ta ano cha thie tlâh ta rao ei ta.
  </para>
  <para style="p">
    <verse number="65" style="v" />Thokha ta Zisu cha ama pachih ta pachhao ei ta, a hmia pahly ei ta, tu ei ta, a hnohta “Hrohsona bie cha phuah châh chi!” tah ei ta. Vaituhpazy ta amâ chhi pâ ta chabaih ei ta.
  </para>
  <para style="p">
    <verse number="66" style="v" />Pity cha dôhpachhôh tlyhmia liata arulâta a y nota, Theihthai Beichaipa chakaotuhpa laihsazy hry liata pakha a vy ta,
  </para>
  <para style="p">
    <verse number="67" style="v" />Pity mei â aihpa hmô ta, moh ta, a hnohta, “Nâ chhao he Nâzari chyhsa Zisu hnohta a ypa kha na châ hra,” tah ta.
  </para>
  <para style="p">
    <verse number="68" style="v" />Pity ta a papha ta, “Na reipa cha pahno va na, a yzie pahno va na,” tah ta. Chatawhcha aikah lâ kei pua ta, awh khoh pâ ha ta.
  </para>
  <para style="p">
    <verse number="69" style="v" />Chakaotuhpa laihsa ta hmô ta, a kiapâh liata â duahpazy hnohta “He chyhsa he ama hry liata a hlaopa a châ hra,” tah heih ta.
  </para>
  <para style="p">
    <verse number="70" style="v" />Châhrasala a papha heih ta. Buakha y ta, a kiapâh ta â duahpazy ta Pity hnohta, “Kâlili chyhsa châ tlôh chi ta, ama hry liata nâ hlao tlai hra,” tah ei ta.
  </para>
  <para style="p">
    <verse number="71" style="v" />Châhrasala chhie a sakhâh ta, bie a taih ta, “Cha chyhsa nama reipa cha pahno va na,” tah ta.
  </para>
  <para style="p">
    <verse number="72" style="v" />Cha nota awhkhypa cha a einona ta thlai vaw khoh ta. Pity cha Zisu ta a hnohta, “Awh ei no a kho hlâta, ei thôh einâ paphasai aw chi,” a tahpa bie kha a vaw thei ta. Palôh keichheihpa ta cha ta.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />My a vaw châpa nahta, theihthai beizy ta machâzy, ryhpa pachutuhpazy nata ryureituhpa zydua a chhohia ei ta. Zisu cha chahrypa ta a chhi ei ta, Pilâ lâ hlâ ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilâ ta a hnohta, “Zuzy Beipa na châ ma?” tah ta. Zisu ta a chhy ta, “Na reipa hawhta ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Theihthai beizy ta kyh hluhpi ta vaw leih ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilâ ta hiahri heih ta, a hnohta, “Khâpa hmah a chhy aw va chi ma? Pachâ tua, ama cha leihna zyzie hih,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Châhrasala Zisu ta khâpa hmah a chhy via khao leipa ta. Chavâta Pilâ cha a noâh kaw ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa atâhpazy hry liata zawpi ta amâ hawpa pakha cha, Zawpakhô kyhchhi noh ta Pilâ ta papua tyh ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />He daihti liata patâhna o liata chyhsa pakha, a moh Bârabâ ama tahpa y ta. Ano cha ryureina a dyuhpa ta liany a cheihpa vâta patâhpa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zawpizy khy ei ta, Pilâ cha ama châta a tao tyhpa hawhta tao heih awpa ta a haw ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pilâ ta ama hnohta, “Zuzy Beipa he cha papuapa aw ei sah la, nama khoh ma?” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zisu cha theihthai beizy ta hiatliana vâta ama patusapa a châzie pahno thlâh ha ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Châhrasala theihthai beizy ta Bârabâ papua hri awpa ta zawpi pasyu ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pilâ ta âmo cha a chhy ta, ama hnohta, “Cha khiah Zuzy Beipa nama bipa he zaw, kheihta ei tao aw?” tah heih ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zawpizy ta, “Khaipâ teh,” tahpa ta thata awh heih ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pilâ ta ama hnohta, “Khazia maw, khâpa moleina ma a tao haw?” tah ta. Châhrasala, “Khaipâ teh,” tahpa ta thata awh via rili ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilâ ta zawpi palysa khohpa ta, Bârabâ cha papua ta, Zisu cha a chhei khai nahta, khaipâ awpa ta hlâ ha ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zisu cha pheisaihzy ta râhvaotuhpa o dôhpachhôh, Pritôria ama tahpa lâ a ngiakhei ei ta. Ama py liata pheisaih zydua awpakhy ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Viahkao pasipa nohsaihpa paky ei ta, hloh lakho phiehpa a luh liata pakho ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Zuzy Beipa, hroh pareih mah y!” tahpa ta a naoh ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lohthi ta a luh liata chhei ei ta, ama pachih ta pachhao ei ta, ama pakhu paneihpa ta a naoh ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama pasipasawh khai nahta, poh nohsaihpa cha hlaipa ei ta, ano viahkao pasipa pakysa heih ei ta, khaipâ awpa ta a chhi ha ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lâpi liata amâ tyhpa Kurini khihpa Saimaw cha Zisu kraws papiasa raruah ei ta. Ano cha Alezandâ nata Rufu zy paw châ ta, khitaw lâ tawhta a vaw tlôpa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zisu cha Luh Ru Su ama tahpa Kalvari tlâh lâ a chhi ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Myrâ nata pahlaopa kresawhti pie ei ta, châhrasala doh khoh leipa ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chatawhcha khaipâ ei ta, a chysiazy a rai ei ta, nuby a daopa ta ama to awpa chyu a la ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zisu ama khaipâna daihti cha my dawh chakipa liata a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ano leihna bie a luh chô liata ama tawpa cha, “Zuzy Beipa,” tahpa a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu hnohta hraotuhpa pano, a chachâh lâta pakha, a chavei lâta pakha khaipâ hra ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chatanachata, “Moleipazy hry liata rei pâpa a châ,” tahpa Biehrai bie a vaw tlô paki haw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cha su a chapiapazy ta ama luh chahuahpa ta, “Âh! Nâ, Achhyna o phie ta, noh thôh ta a sa heih awpa chi,
  </para>
  <para style="p">
    <verse number="30" style="v" />nâmasasyh ta a pachha la, kraws tawhta za chô châh chi!” tahpa ta pasipasawh ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cha hawhna hra chata theihthai beizy nata ryhpa pachutuhpazy chhao ta pasipasawh hra ei ta, “Chyhsa hropazy pachha ta, ano hmâchhâh â pachha thei khao vei huh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Izarei Beipa Mesia cha tahmâ tlai heta kraws tawhta za chô bao sa! Cha cha eima hmô khiahta cha, eimâ ngiapâ aw,” tah ei ta. A hnohta khaipâ hrapazy chhao ta pasipasawh hra ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dawh hrawh hleino a vaw paro nahta, cha daihti tawhta zâlâ dawh thôhpa taihta, alei chô zydua vaw zoh kaluh ha ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dawh thôhpa liata, Zisu cha ao paro ngaitapa ta awh ta, “Elôi, Elôi, lâmâ sabakthâni?” tah ta, cha yzie cha “Ei Khazohpa, ei Khazohpa, khazia eina pathlua chi?” tahna a châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />A kiapâh liata a duahpa thokhazy ta cha bie cha ama thei nahta, “Nathlie tua u, Elaizâh a aw chu,” tah ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chyhsa pakha a râ ta, kresawhti thaopa liata ti pasysana ny ta, lohthi pawhmao liata pataoh ta, padosa ta, “Ano la awpa ta Elaizâh â zu ma tahpa hâ sih la, moh tua suh u,” tah ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zisu cha ao paro ngaitapa ta awh ta, a hu chhâ ha ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Achhyna o pohraipa cha a chô lâ tawhta a ry lâ taihta â khophie ta a hrie ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />A hmiakô liata a duahpa pheisaih za kha hyutuhpa ta, cha hawhta a hu chhâpa cha a hmô nahta, “He chyhsa he Khazohpa Sawchapawpa a châ hmeiseih tlai na,” tah ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Lâhla tawhta a saipa chanôzy chhao y ei ta, chazy hry liata Mâri Mâdali, Zâmie seihnai viapa nata Zôse zy nô Mâri nata Salômi zy amâ hlao hra.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kâlili liata Zisu a y no kha, âmozy heta zi ei ta, ama chakao tyh. A hnohta Zerusale lâ a khy hrapa chanô hropa hluhpi chhao amâ hlao hra.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zâlâ a vaw châ nahta, Pachyh noh a châpa vâta, cha cha Pahânoh a pazipa noh châ ta,
  </para>
  <para style="p">
    <verse number="43" style="v" />Arimathai khihpa Zawsi, ryureituh zachhihpa nata Khazohpa khinarâh vaw tlô awpa a hâ hrapa cha a vy ta, a riah a paphapa ta Pilâ lâ a ngia ta, Zisu ri cha hiah ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />Cha hawhta thlai a thi thlâh hapa cha Pilâ chhao ta noâh tah kaw ta, pheisaih za kha hyutuhpa cha aw ta, a thi ha tlai ma tahpa ta hiahri ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />A thi ha tlaipa kyh pheisaih za kha hyutuhpa tawhta a pahno nahta, a ri cha Zawsi hnohta pie ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Zawsi ta poh rih dipa chalei ta, Zisu ri cha la ta, poh rih dipa ta pahly ta, lôkhaoh khiepa thlâ liata pazia ta. Thlâ paka cha alô ta pamai ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mâri Mâdali nata Zôse nô Mâri ta a paziana su cha hmô ei ta.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pahânoh a chhâ nahta, Mâri Mâdali, Zâmie nô Mâri nata Salawmi zy cha, Zisu sathawthu awpa ta ropahâhpa chalei ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hâta noh hmiatuapa mydi ta, noh a chhi tawhta thlâ lâ vawh ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Thlâ pamaina alô kha ahy ma miah a pasiepa aw tly?” tahpa ta reih laih ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kaw moh ei ta, alô lai ngaitapa cha â pasie hapa hmô ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thlâ chhôh lâ a ngia ei ta, satlia pakha poh diehpa a bupa ta, a ri aziana chachâh lâta a tyuhpa hmô ei ta, ama noâh ngaita ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ano ta ama hnohta, “Nama noâh khah sy. Nâzari khihpa Zisu, ama khaipâpa kha nama tlua tahpa ei pahno. A thyu haw. He liata y khao vei. Moh teh u, ama paziana hih.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sie u la, a pachupazy nata Pity hnohta, ‘Nama hnohta a reipa hawhna tlai khata, nama hmia lâta Kâlili lâ a sie hai, cha liata nama hmô aw,’ tahpa ta kei chho teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Noâh ngaitapa nata achalyuna chôta pua ei ta, thlâ tawhta a râ ei ta, ama chipa vâta, ahy hnohta hmahta khâpa bie hmah reih leipa ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hâta noh hmiatuapa mydi ta a thyuheih nota, a chhôh tawhta ahripa pasari a papuapa Mâri Mâdali hnohta a luah tua chai ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mâri Mâdali cha Zisu hnohta a y tyhpazy lâ vawh ta, mâchhiesapa ta a cha ngâpazy hnohta Zisu a hmôna thâtih kei chho ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu cha hroh ta, Mâri Mâdali ta a hmô tahpa ama theipa chhao ta, zo leipa ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha hnôhlâ ta, ama hry liata chyhsa pano, khitaw lâ ama sie hai nota, hmia nanopa ta ama hnohta a luah heih ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Âmo cha kua ei ta, pachupa hropazy kei chho ei ta, châhrasala âmo chhao cha zo leipa ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha khai tawhta, pahrawh hleikhazy tlâhkhai liata pati ama dôh hai nota, ama hnohta a luah heih ta. A thyuheih tawhta a hmôtuhpazy bie ama zo leipa vâta nata amâ ngiapâleina nata ama palôh kuhchhana vâta âmo cha ra ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ama hnohta, “Khizaw zydua liata sie u la, hmotaopa zydua hnohta thâtihpha chho teh u.
  </para>
  <para style="p">
    <verse number="16" style="v" />A ngiapâ ta bâti a châpa cha pachhapa ta y aw ta, a ngiapâ leipa deikua cha thaileichâpa ta a y aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />He ngianazy heta ngiapâtuhpazy cha a zi lymâ aw: Ei moh ta ahripazy papua aw ei ta, reih thiehpa ta reih aw ei ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />ku ta parihzy patu aw ei ta, thina châmaih kheihawhpa rai doh hra ei sala, âmo pasasa aw vei. Tlâhleipazy chô liata ama ku pahnieh aw ei ta, ama tlâh lymâ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chatanachata Abeipa Zisu cha ama hnohta bie a reih khai nahta, vârâh lâ a chhipa ta y ta, Khazohpa chachâh lâta a kaw tyuh ha ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pachupazy cha sie ei ta, su to liata bie chho ei ta. Abeipa ta âmo cha hriakhei ta, ama bie chhopazy pa-i nawpa ta, ngiana hmonoâhpazy ta a pazi lymâ ei.
  </para>
</usx>
