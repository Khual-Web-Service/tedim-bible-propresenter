<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="TIT" style="id">Titu</book>
  <para style="h">Titu</para>
  <para style="toc1">Titu</para>
  <para style="toc2">Titu</para>
  <para style="mt">Titu</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kei, Pawla he Khazohpa ta â tlyhpa chyhsazy angiapâna châta nata Khazohpa pachâna lâ a chhihthapa biehmeiseihpa pahnona châta Khazohpa chakaotuhpa nata Zisu Krista lyuhchâpa ei châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Haipa bie a reih beih leipa nata khizaw y hlâ tawhta chhâzaw hrona bie a vaw taih hapa Khazohpa a ngiapâtuhpa ei châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />A daihtita liata a vaw luahpa chhâzaw hrona bie cha, Khazohpa miah Pachhatuhpa biepiepa ta pavaosapa châ na ta, cha bie a chhotuhpa, kei, Pawla heta,
  </para>
  <para style="p">
    <verse number="4" style="v" />ngiapâna miakhapa liata ei saw hmeiseihpa Titu ei châ naoh. Paw Khazohpa nata Krista Zisu miah Pachhatuhpa tawhta ngiachhiena nata thlalôhna na hnohta y mawh sy.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmo pasia khai leipazy pasia awpa nata bie ei cha piepa hawhta khi to liata Awnanopa chhituhpazy rao awpa ta, Krite liahpahlô liata ei cha siesaipa kha a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Awnanopa chhituhpa châ awpa ta cha, seina hnei leipa, lapinô pakha a hneipa, a sawzy nôchhiepa nata reingiah leipa châ leipa ta, ngiapâtuhpa ama châ awpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Awnanopa chhituhpa cha Khazohpa sôh mokhâhtuhpa a châpa vâta, seina hnei leipa a châ awpa a châ. Chyhsa apalaipa, pathichhiepa, kresawhti pari hmâhpa, thachahra a hmâhpa nata avyuhna ta athôhna a tluapa a châ awpa châ vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khichhai a pasôpa, phana a khohpa, a sohsi theipa, chyhsa siapa, chyhsa pathaihpa, sasyh a vao pahniepa a châ awpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Awnanopa chhituhpa cha biezyhpa dopa a pachu thei awpa châ ta, biezyhpa dopa chakhiatuhpazy a padei thei nawpa ta, pachuna dopa â ipa ta a patu awpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ryhpa a zyh khoh leipa, bie a reih chakhyhpa nata chyhsa dôvei hmâhpa hluhpi, a eih pachaipa ta, chopawtaipazy hry liata ama y.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha sahlao cha ama pakah chahu awpa a châ. Avyuhna nozachhihpa ama tao thei nawpa ta, pachu lei awpazy pachu ei ta, chhôhkha zydua ama patypamâ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Krite chyhsa, ama hrohsopa cheingei ta, “Krite chyhsazy cha haihthaipazy, sahrâh moleipazy, thathi rikawhpa zy ama châ zôzaw,” tahpa ta reih ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha bie cha â do. Chavâta ngiapâna liata â dopa ta ama y thei nawpa ta, a pasa kawpa ta âmo cha chhorei mah y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zuzy phôhpa nata biehmeiseihpa a heisaituhpa biepiepazy cha uasa lei awpa ta âmo cha chhorei hra mah y.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mopathaihpazy châta ato pathaih ta, chyhsa puapa nata ngiapâleipazy châta deikua cha, khâpa hmah pathaih vei. Ama palôh phaozie nata ama chhie nata pha pahnona a pua khai haw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khazohpa pahno a tah ei ta, châhrasala ama hmotaopazy ta Khazohpa cha amâ paphasai. Pasichhihpa nata reingiah leipa châ ei ta, hmopha tao awpa ta khâpa kyh liata hmahta a tlâh a châ leipazy ama châ.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nâ deikua cha, biezyhpa dopa nata a ryhpa ta pachu mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pawhrâhpazy cha palôh pasohpa, zachhihpa, a sohsi theipa, ngiapâna patapa, kyhpachâna a hneipa nata daotheipa chyhsazy châ awpa ta pachu mah y.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nôhrâhpazy chhao, ama yzie liata Khazohpa a chizapa, chyhsa kyh a reih leipa nata kresawhti sei ta y leipa ta, hmo phapa pachutuhpazy châ awpa ta pachu mah y.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nô laihsa viapazy cha ama vahpazy nata ama sawzy kyhpachâ awpa ta pachu la,
  </para>
  <para style="p">
    <verse number="5" style="v" />Khazohpa bie reipachhiepa ta a y lei nawpa ta, a sohsi theipa, chanô pathaihpa, o mohôhna rai a hriapa, nôphapa nata ama vahpazy rei a ngiahpa châ awpa ta pachu mah y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha hawhna chata chapaw thyutlia viapazy chhao, a sohsi theipa châ awpa ta pachu mah y.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kyh to liata hmo pha taona liata a mopâ awpa ta y la, na pachuna liata adona nata zachhihna palâsa mah y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na bie reipa â dozie reipasipasua thei awpa a châ leizie palâsa la, miah chakhiatuhpazy ta eima moleina rei awpa pahno leipa aw ei ta, maophyuhpa ta ama y aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Seizy cha kyh to liata ama zibeipazy rei a ngiahpa ta, ama zibeipazy ama palysa awpa châ ta, ama zibeipazy bie ama ei awpa châ vei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kusisuah hnei leipa ta, ngâ tlâhpa ama châna ama palâsa awpa a châ. Chatanachata miah pachhatuhpa Khazohpa biezyhpa cha kho â chhihzie kyh to liata ama palâsa thei aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khazohpa ngiachhiena cha a vaw luah ha ta, chyhsa zydua hnohta pachhana a vaw tlôkhei haw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha chata Khazohpa pachâ leina nata khizaw aohraohnazy bâhsaipa ta, tahmâhlâ khizaw liana heta asohsipa nata asiapa nata Khazohpa pachâna hro hrokhei awpa ta miah pachu ta,
  </para>
  <para style="p">
    <verse number="13" style="v" />eima Khazohpa rônahpa nata Pachhatuhpa Zisu Krista â vaw luahna hnabeiseihna lychhihpa hâ awpa ta miah a pachu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ano cha paraona zydua tawhta miah chatlaituhpa châ ta, hmo pha taona kyh liata phahnai a ngiahpa, a ryuto phopi châta miah pathaisa awpa ta, anosasyh ta keimo châta a hlâpa a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cha biezy cha pachupa ta, pasyu la, biehneina zydua chhaota chhorei mah y. Ahy hmahta cha mohnao khah ei sy.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngiapâtuhpazy cha ryureituhpazy nata biehneituhpazy liata a ngiarih ei sala, reingiahpa ta, hmo pha tao a mâ awpa ta chho chanei mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngiapâtuhpazy cha ahy hmah ama reipachhie awpa châ leipa ta, ahryusina amâ hneisai awpa a châ. Nônai kawpa ta y ei sala, chyhsa zydua chô liata areisina dopa ama palâsa awpa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kha hlâta cha keimo chhao chyhsa hrupa, chhorupa, dôvei naopa, aohraohna nata phasana to sei ta a ypa, moleina nata hnâchhaona ta a hrohpa, chyhsa ta amâ haopa nata keimo nata keimo a hao raihriepazy eima vaw châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Châhrasala miah Pachhatuhpa Khazohpa phana nata kyhpachâna â vaw luah nahta,
  </para>
  <para style="p">
    <verse number="5" style="v" />siana ta eima hmotaopa vâta châ leipa ta, a zawngiahna vâta miah a pachha. Cha pachhana cha pipathina ta miah pathaisa ta, Thlahpa Pathaihpa taopathina zawhzi ta eima hmôpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miah Pachhatuhpa Zisu Krista zawhzi ta eima chô liata Thlahpa Pathaihpa thata hrypa eima châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chatanachata a ngiachhiena vâta thai pachâsapa ta y aw pi ta, chhâzaw hrona a hnabeiseihpa ryutotuhpazy eima châ thei aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khazohpa a ngiapâpazy cha hmo pha taona liata a hmâh lymâ mawh ei sy, tahpa bie cha ngâ tlâhpa châ ta, cha bie cha na reih lymâ awpa ei khoh. Cha cha hmo phapa châ ta, chyhsazy ta amâ thôkhei aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aeina hrupazy, thyutônazy, achakhianazy nata ryhpa kyh liata ahryunazy a hneisai lymâ mah y. Athôhna a y leipa nata hraoleipa hmozy a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Achhaihna a papuatuhpa cha, ei kha ei no zikyu a râ la, a ro khoh vei khiahta cha, ano nata azaona khâpa hmah hnei khao khah y.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha hawhpa chyhsa cha sie chhei ha ta, moleipa châ ta, anosasyh ta thailei â pachâpa a châ tahpa pahno mah y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Atemâ tlyma, Tykiku tlyma, nâ lâ ei vaw tuah tita, ei yna Nikôpôli khih lâ a vy a chhuah lylia mah y. Cha liata chasipaw daihti hmâ awpa ei chhuah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dâhthaipa Zenâ nata Apawlôsâ zy kha, khâpa hmah a phahla lei awpa ta mokhei la, ama khitlyna a palâ thei nawpa ta na theina zydua ta bao mah y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Eima chyhsazy cha pathei leipa ta ama y lei nawpa ta, bao ngiahpazy bao ei sala, hmo pha taona liata a hmâ lymâ awpa ta a chu mawh ei sy.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ei hnohta a ypa zydua ta ama châ naoh. Ngiapâna liata kyh miah pachâtuhpazy kha miah a naohpa mah y. Nama zydua hnohta ngiachhiena y mawh sy.
  </para>
</usx>
