<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MAT" style="id">Mathai</book>
  <para style="h">Mathai</para>
  <para style="toc1">Mathai</para>
  <para style="toc2">Mathai</para>
  <para style="mt">Mathai</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />He he Zisu Krista thyutôna châbu a châ. Zisu Krista cha Dâvi pathla châ ta, Dâvi cha Abarahâ pathla a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abarahâ cha Aisika paw châ ta, Aisika cha Zakaw paw a châ. Zakaw cha Zudâh nata a unawhzy paw châ ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zudâh cha Pereza nata Zerâ paw châ ta, ama nô cha Tâmâri a châ. Pereza cha Hezrô paw châ ta, Hezrô cha Aramâ paw a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aramâ cha Aminadâ paw châ ta, Aminadâ cha Nâsô paw a châ. Nâsô cha Salmô paw châ ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />Salmô cha Bôaza paw a châ. Bôaza nô cha Rahâbi a châ. Bôaza cha Ôbedâ paw châ ta, Ôbedâ nô cha Ruthi a châ. Ôbedâ cha Zese paw châ ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />Zese cha Bei Dâvi paw a châ. Dâvi cha Sawlawmaw paw châ ta, Sawlawmaw nô cha Uria lapinô kha a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sawlawmaw cha Rehôbaw paw châ ta, Rehôbaw cha Abizah paw a châ. Abizah cha Âsâ paw châ ta,
  </para>
  <para style="p">
    <verse number="8" style="v" />Âsâ cha Zehôsaphâ paw a châ. Zehôsaphâ cha Zôrâ paw châ ta, Zôrâ cha Uzia paw a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Uzia cha Zôthâ paw châ ta, Zôthâ cha Ahâza paw a châ. Ahâza cha Hezekia paw châ ta,
  </para>
  <para style="p">
    <verse number="10" style="v" />Hezekia cha Manase paw a châ. Manase cha Amôsâ paw châ ta, Amôsâ cha Zôsia paw a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zôsia cha Zekôniah nata a unawhzy paw châ ta, âmo he Babylaw lâ a chhipa ta ama y no rachhôh ta a pihpa ama châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hezy he Babylaw lâ sei ta a chhipa ama châ tawhta a pihpazy ama châ: Zekôniah cha Salâtia paw châ ta, Salâtia cha Zerubâbe paw a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerubâbe cha Abinadâ paw châ ta, Abinadâ cha Eliakima paw a châ. Eliakima cha Azô paw châ ta,
  </para>
  <para style="p">
    <verse number="14" style="v" />Azô cha Zadô paw a châ. Zadô cha Akhi paw châ ta, Akhi cha Elidâ paw a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Elidâ cha Eliaza paw châ ta, Eliaza cha Mâthanâ paw a châ. Mâthanâ cha Zakaw paw châ ta,
  </para>
  <para style="p">
    <verse number="16" style="v" />Zakaw cha Zawsi paw a châ. Zawsi cha Mâri vahpa châ ta, Mâri cha Mesia ama bipa Zisu nô a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chatanachata chhâ zydua cha, Abarahâ tawhta Dâvi taihta chhâ hrawh hleipalih châ ta, Dâvi tawhta Babylaw lâ sei ta a chhipa ama châna taihta chhâ hrawh hleipalih châ ta, Babylaw lâ sei ta a chhipa ama châ tawhta Mesia pina taihta chhâ hrawh hleipalih a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu Krista vaw pinazie cha hetana heta a châ. Zawsi ta Zisu nô Mâri cha a pahawh ta, amâ pahlyh hlâta Thlahpa Pathaihpa ta saw paphaosa ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />A vahpa Zawsi cha chyhsa siapa a châpa vâta, Mâri noh pazao awpa khoh leipa ta, arulâta a chhaih a chhuah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Châhrasala he hmo he a pachâ hai nota, Abeipa vâlyuhchâpa cha a hnohta a mâ lâta a vaw luah ta, “Dâvi sawchapawpa Zawsi y, Mâri na lapinô ta hnei awpa chi khah y. A saw phaopa kha Thlahpa Pathaihpa ta a paphaosapa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sawchapaw sa aw ta, a chyhsazy ama moleinazy tawhta a pachha awpa vâta, a moh Zisu na bi aw,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha hmo zydua cha Abeipa ta hrohsopa pakah hmâpa ta,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Pachâ teh u, laihsa kôpa ta saw phaoh aw ta, Sawchapawpa sa aw ta, A moh Imanuel ama bi aw,” tahpa ta a reipa kha â ki thei nawpa ta a vaw tlôpa a châ. Imanuel cha “Khazohpa eima hnohta a y,” tahna a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zawsi cha a vaw hra ta, Abeipa vâlyuhchâpa ta bie a piepa hawhta tao ta, Mâri cha lapinô ta hnei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Châhrasala Mâri ta sawchapaw a sa hlâ via cha a zialâh vei. Zawsi ta a sawchapawpa moh cha Zisu a bi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Herawda â bei nota Zudia râh Bethlehe khih liata Zisu a vaw pi nahta, nochhi chyhsa sopazy Zerusale lâ a vy ei ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Zuzy bei a pihpa cha khataih liata a y? Nochhi lâta ano awhsi hmô pi ta, ano a naoh awpa ta eimâ vy,” tah ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha bie cha Bei Herawda ta a thei nahta, ano nata Zerusale liata chyhsa zydua cha ama nôpo kaw ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Theihthai beichaipazy nata ryhpa pachutuhpa zydua awpakhy ta, Mesia pina awpa cha khataih liata a châ tahpa ta âmo hiahri ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Âmo ta, “Zudia râh Bethlehe liata a châ. Hrohsopa ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />“‘Nâ, Bethlehe, Zudâh râh liatapa, Zudâh ryureituhpazy hry liata chyh chai cheita aw va chi; Ei phopi Izarei vaih awpa ta, Na chhôh tawhta ryureituhpa a vaw pua awpa vâta,’ tahpa ta a vaw roh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Herawda ta chyhsa sopazy cha arulâta aw ta, khatita ma awhsi cha â lâ tahpa âmo hiahri pasia ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bethlehe khih lâta âmo cha pasiesa ta, “Sie u la, hawsaih cha a phapa ta kei tlua teh u. Nama hmô nahta, a thâtih thlai na vaw chho muh vy. Chatanachata kei chhao sie aw na ta, ei kei naoh hra aw,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abei bie cha ama nathlie khai nahta, sie ha ei ta. Nochhi lâta awhsi ama hmôpa kha ama hmia lâta sie lymâ ta, hawsaih yna chô liata â dua hlâlei cha, âmo chhihtha lymâ ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Awhsi cha ama hmô nahta, thaphapa ta a ly ngaita ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />O chhôh lâ a ngia ei ta, hawsaih cha a nô Mâri hnohta hmô ei ta, a bôhpa ta a naoh ei ta. Ama ryubyhzy pahy ei ta, hmosaipa ngôh, deiryh nata myrâ zy pie ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama mâ lâta Herawda lâ kua lei awpa ta chhopa ama châpa vâta, lâpi hropa lâta ama râh lâ a lie ha ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama sie tawhta, Abeipa vâlyuhchâpa cha Zawsi hnohta a mâ lâta a vaw luah ta, a hnohta, “Thyu la, hawsaih nata a nô kha a chhi la, Izi râh lâ a râ teh. Herawda ta hawsaih kha pahleipadia awpa ta a tlua awpa vâta, ei cha chho heih hlâlei cha, cha liata y thlâh ha mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawsi cha thyu ta, hawsaih nata a nô cha a chhi ta, azo ta Izi râh lâ cha sie ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Herawdâ a thi hlâlei cha, cha liata y ei ta. Cha hmo cha Abeipa ta hrohsopa pakah ta, “Ei sawchapawpa cha Izi râh tawhta ei aw papua aw,” a tahpa kha a vaw tlô thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Herawda cha chyhsa sopazy ta ama dôpa a pahno nahta, a hiehâh ngaita ta, chyhsa tuah ta, chyhsa sopazy tawhta a daihti a pahnopa hawhta, Bethlehe khih nata a chheipâh zydua liata chapaw hawti kô no tawhta a ry lâ zydua cha thie khai awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hrohsopa Zeremiah ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Râmâ liata ao theipa châ ta, Chana nata mâchhiesana ao a châ; Râkheli ta a sawzy chakhei ta, Ama y khao leipa vâta, Thlapalôh thei awpa châ vei,” tahpa ta a reipa kha a vaw tlô hapa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Herawda a thi tawhta, Abeipa vâlyuhchâpa ta Izi râh liata Zawsi hnohta a mâ lâta a vaw luah ta,
  </para>
  <para style="p">
    <verse number="20" style="v" />a hnohta, “Thyu la, hawti nata a nô kha a chhi la, Izarei râh lâ sie mah y, hawti hrona la a chhuahpazy kha ama thi haw,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chatanachata Zawsi cha thyu ta, hawti nata a nô a chhi ta, Izarei râh lâ sie ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Châhrasala Akhelâ ta a paw Herawda vyuhpa ta Zudia râh chô liata â bei tahpa a thei nahta, cha lâ sie awpa cha chi ta, a mâ lâta chhopa a châpa hawhta, Kâlili lâ sie ha ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khihpi miakha, Nâzari ama tahpa lâ sie ta, cha liata kei pahrâ ta. Cha hmo cha, “Ano cha Nâzari chyhsa ama tah aw,” tahpa ta hrohsopazy pakah ta ama reipa kha a vaw tlô thei nawpa ta a châ.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha nohzy liata, Bâtituhpa Zawhâna cha Zudia râhchawhpa liata bie chho awpa ta a vy ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ro teh u, vârâh khinarâh cha â hnia haw,” tahpa ta bie chho ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hrohsopa Isai ta, “Râhchawhpa liata awhpa ao ta, Abeipa lâthlôh a chhuahdy u la, A lâpizy patlâsa teh u,” tahpa ta a vaw reichhieliepa kha, ano he a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawhâna cha râraoseihpa hmi chysia ta a tobi ta, savo chaisaihna ta a chai a saih ta, a pati cha khawsu nata kheihti a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zerusale nata Zudia râh liata chyhsa zydua nata Zawdâh chavah chheipâh liata chyhsa zydua puapa ta ano lâ a vy ei ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />ama moleinazy palâhâhpa ta Zawdâh chavah liata ano ta bâti pachâsa ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Phârisaih nata Saduasi hluhpi ta bâti châ awpa ta ano lâ amâ vypa a hmô nahta, ama hnohta, “Nâmo, vâzi pathlazy saih u! Hiehâhna vaw tlô awpa a râsai awpa ta ahy ma zikyu châ râ ei?
  </para>
  <para style="p">
    <verse number="8" style="v" />Rona moh phaoh tlâhpa ta pathei teh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />‘Abarahâ pathla eima châ,’ a tah khuh vy. Khazohpa ta he alôzy tawhna heta Abarahâ pathlazy a padua thei tahpa ei cha chho ei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tahmâ chhao tlai he, tho tharizy liata ahrei sopa a châ haw. Tho to thei pha a pathei leipa maih thlu ta mei liata thypa a châ aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Kei ta rona châta ti ta cha bâti ei na ta, ei hnôhlâ ta a vy awpa deikua cha, keima hlâta rônah viapa châ ta, kei la a pheiky chaba tlâh chhao châ va na. Ano ta Thlahpa Pathaihpa nata mei ta a cha bâti aw ei.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ku liata a barah y ta, a sawhri sâh zie aw ta, a sâh pâh liata a ryh aw. Asihpa deikua cha, mei pachhai thei leipa liata a rao aw,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha nona chata Zisu cha, Zawdâh chavah liata bâti châ awpa ta, Kâlili tawhta Zawhâna lâ a vy ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Châhrasala Zawhâna ta, “Nâ ta bâti eina pachâsa awpa chi tlao ei ngiah. Kheihtazieta kei lâ a vypa ma na châ?” tah ta, thlyu a chhuah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zisu ta a chhy ta, “Â ryh tah thlâh ha teh. Siana zydua pakipa cha eima châta a ngiahpa a châ,” tah ta. Chatanachata paryhsa ha ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zisu cha bâti a châ khaipa nahta, ti tawhta thlai kaw pua ta, avâ a vaw pahy ta, Khazohpa Thlahpa cha vachhuh hawhta za chô ta, a chô liata â chohpa hmô ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Avâ tawhta ao ta, “He he ei Sawchapawpa kyh ei pachâ ngaitapa, a chô liata ei ly ngaitapa a châ,” tah ta.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha khai tawhta Zisu cha ahripa ta a reipasao awpa ta, Thlahpa ta râhchawhpa lâ a chhi ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Noh sypalih nata zâ sypalih chaheihpa ta a y tawhta a no vaw di ha ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reipasaotuhpa a vy ta, a hnohta, “Khazohpa Sawchapawpa na châ khiahta cha, alôzy he viahchhâ lâta a vaw lie awpa ta biepie teh,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta a chhy ta, “‘Chyhsapa he viahchhâ dei ta hroh aw vei, Khazohpa pakah tawhta bie to a puapa ta tlao a hroh aw,’ Tahpa ta ropa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cha khai tawhta, ahripa ta khihpi pathaihpa lâ a chhi ta, Achhyna o laki pazaopa liata soh ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />a hnohta, “Khazohpa Sawchapawpa na châ khiahta cha, a zaw pathlah teh, “‘Khazohpa ta nâma kyh liata, A vâlyuhchâpazy biepie aw ta, Na phei alô liata nâ chhuh lei nawpa ta, Ama ku ta ama cha chalo aw,’ Tahpa ta ropa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zisu ta a hnohta, “‘Abeipa na Khazohpa na pasia awpa châ vei,’ tahpa ropa a châ hra,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahripa ta tlâh sâh ngaitapa lâ a chhi heih ta, khizaw khinarâh zydua nata ama rônahna zydua pamosa ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hnohta, “Â khu lâta pao la, einâ chhy khiah chi ta cha, he hmo zydua he ei cha pie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zisu ta a hnohta, “Sâtâ, a râ teh! ‘Abeipa na Khazohpa a chhy aw chi ta, Ano deita na chakao awpa a châ,’ Tahpa ta ropa châ tlôh ta,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chatawhcha ahripa ta Zisu cha siesai ha ta. Vâlyuhchâpazy a vy ei ta, ano cha ama chakao haw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zawhâna ama patu haw tahpa Zisu ta a thei nahta, Kâlili lâ a lie ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nâzari khih puasai ta, sie ta, tilaipi kiah liata Kâpynia khih, Zebulawna nata Nâthalai râh liata pahrâ ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha hmo cha hrohsopa Isai ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Zebulawna râh nata Nâthalai râh, Tilaipi pangaina, Zawdâh haosâ râh, Zenitaizy pahrâna Kâlili râh
  </para>
  <para style="p">
    <verse number="16" style="v" />Zohna liata a tyuhpazy ta Khaihna rônahpa ama hmô haw; Thina nohpahli râh liata atyuhpazy chô liata, Khaihpa a vaw khaih haw,” tahpa ta a reipa kha a vaw tlô thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha daihti tawhta Zisu ta, “Ro teh u, vârâh khinarâh cha â hnia haw,” tahpa ta pachu pathao ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kâlili Tipo kiah liata a sie hai nota, unawh pano, Saimaw, Pity ama tahpa nata a unawhpa Adaru zy cha tilaipi liata sao ama vaw ngâpa hmô ta. Âmo cha nga patutuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama hnohta, “Na zi teh u, chyhsa patutuhpa ta ei cha tao aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama saozy thlai siesaipa ta Zisu cha zi ha ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cha tawhtapa cha sie lymâ ta, unawh hropa pano, Zebâdi sawchapawpa Zâmie nata a unawhpa Zawhâna zy cha ama paw Zebâdi chhaota saozy balyh liata ama taopathi ngâpa hmô ta, âmo cha aw ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama balyh nata ama paw cha thlai siesaipa ta Zisu cha zi ha ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kâlili râh zydua chahryh ta, amâ pakhyna ozy liata pachupa ta, khinarâh thâtihpha chho lymâ ta, zawpi hry liata hri to nata pasana to a hneipazy patlâh ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Suria râh zydua liata a moh pathâh ta, chyhsa tlâhleipa zydua, pasana a hneipa nata hri ohpazy, ahripa patupazy, riapamiepazy nata asypazy a hnohta a vaw chhi ei ta, patlâh lymâ ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kâlili tawhta zy, Dekâpôli tawhta zy, Zerusale tawhta zy, Zudia tawhta nata Zawdâh haosâ râh tawh zy ta zawpi hluhpi ta ano cha zi ei ta.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu cha zawpizy a hmô nahta, tlâh lâ kiah ta, a tyuh ta, a pachupazy a hnohta a vy ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hetana heta âmo cha pachu ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Thlahpa sipasapazy ama nohlao na, vârâh khinarâh ama eih a châpa vâta.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Pachârôhpazy ama nohlao na, thlapalôhpa ta ama y awpa vâta.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Nônaipazy ama nohlao na, lei ryu ama to awpa vâta.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Siana khopa vâta nodi dâhphipazy ama nohlao na, ama aoh a vei awpa vâta.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zawngiah theipazy ama nohlao na, zawngiahna ama hmô awpa vâta.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Palôh pathaihpazy ama nohlao na, Khazohpa ama hmô awpa vâta.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Aryhna taotuhpazy ama nohlao na, Khazohpa sawzy bipa ama châ awpa vâta.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Siana vâta taola a taopazy ama nohlao na, vârâh khinarâh ama eih a châpa vâta.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Chyhsa ta keima vâta cha reipachhiepa ta nata cha taolapa ta, bie pha leipa to ta â doleipa ta ama cha tei tita, nama nohlao na.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ly u la, thaphapa ta y teh u, vârâh liata nama lymâ hluhpi a y. Cha hawhna chata, nâmo hlâta a vaw y tuapa hrohsopazy chhao ama vaw taola tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Chhaohlei alôh nama châ. Alôh cha a padâh ha khiahta cha, kheihta a iah thei khao aw? Khâpa châta hmah phahnai khao leipa aw ta, thy ta phei ta tlypâ awpa dei a châ aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Khizaw khaihpa nama châ. Tlâh laki liata khih a ypa cha nyu theipa châ vei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chyhsa ta meiôh pakhaih sala, bai ry liata soh beih veih ei. Meiôh tôh liata soh ei ta, o chhôh liata a ypa zydua khaihna a pie tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha hawhna chata, nama khaihna cha chyhsa mohmô ta khaih mawh sy. Chatanachata nama hmo pha taopa hmô aw ei ta, nama Paw avâ liata a ypa ama palyupalih thei aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Ryhpa nata hrohsopa biezy pahleipadia awpa ta â zupa hawhta na pangiasa khuh vy. Pahleipadia awpa ta â zupa châ leipa na ta, pakisa awpa ta â zupa tlao ei châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmeiseihta ta ei cha chho ei, avâ nata alei a lei hlâlei cha, Ryhpa bie liata ropa châsâ chyh chaipa tlyma, achôpa di chaipa tlyma, ato zydua a tlôpaki khai hlâlei cha lei aw vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chavâta ahy rai, he biepiepazy hry liata a chyh chaipa miakha chhao pahua ta, cha hawhta tao hra awpa ta mohropazy a pachupa cha, vârâh khinarâh liata a chyh chaipa ta reipa châ aw ta, ahy rai Ryhpa chyh chaipa chhao zyh ta, a pachupazy deikua cha, vârâh khinarâh liata rônahpa ta bipa ama châ aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ei cha chho ei, nama siana cha ryhpa pachutuhpazy nata Phârisaihzy siana hlâta a sia via vei khiahta cha, vârâh khinarâh a ngia thei aw veih ei chi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hlâno chyhsazy hnohta, ‘Liany na chei awpa châ vei, liany a cheihpa cha a thâtih pachiapa a châ aw,’ tahpa ta chhopa ama châpa kha nama pahno.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kei deikua ta cha ei cha chho ei. Ahy rai a unawhpa chô liata a hie a hâhpa cha, a thâtih pachia tlâh a châ. A unawhpa ‘Dyutlaileipa’ a tahpa cha ryureina liata tlôkhei tlâh châ ta, ‘Ahrupa’ a tahpa chhao, hriena su mei lâ sie tlâh a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chavâta na hmopiepa maisâh liata na hlâ hai nota, na unawhpa ta na chô liata palôh pha leina a hneipa nâ thei khiahta cha,
  </para>
  <para style="p">
    <verse number="24" style="v" />na hmopiepa cha maisâh hmiakô liata soh chy la, vawh la, na unawhpa cha a kei ryh ha tua la, cha khai tawhta a vy la, na hmopiepa cha hlâ mah y.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lyuh châ tuatuhpa nata ryureina su lâ nama sie hai nota, lâpi liata aryhna tao para ha mah y. Chataleipatala lyuh châ tuatuhpa ta ryureituhpa lâ cha hlâ aw ta, ryureituhpa ta vaituhpa lâ cha hlâ aw ta, patâhna o liata khôpa na châ pathlei aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hmeiseihta ta ei cha chho, na chei awpa phusâ dipa taihta na pie khai hlâlei cha, cha su tawhta pua aw va chi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“‘Nâ phei awpa châ vei,’ ama tahpa nama thei haw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Châhrasala ei cha chho ei, ahy rai aohraohpa ta chanô a mohpa cha, a palôh ta chanô liata â phei haw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na mo chachâh lâta a cha pahluasa khiahta la, khie la thy syulyu ha mah y. Na pôhpa duata hrienasu liata thypa hlâta cha, na sa pachiahpa miakha pahleipa cha a pha via.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na ku chachâh lâta a cha pahluasa khiahta la, tai la thy ha mah y. Na pôhpa duata hrienasu liata thypa hlâta cha, na sa pachiahpa miakha pahleipa cha a pha via.
  </para>
  <para style="p">
    <verse number="31" style="v" />“‘Ahy rai a lapinô a mapa cha, mana châ a hnohta pie mawh sy,’ tahpa a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Châhrasala ei cha chho ei, ahy rai, apheina kyh châ tlôh leipa ta, a lapinô a mapa cha, a lapinô a papheisatuhpa châ ta, ahy rai mapa chanô a hneipa cha apheipa a châ hra.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Hlâno chyhsazy hnohta, ‘Haipa ta bie nâ taih awpa châ vei, bie nâ taihpa cha Abeipa lâta na patlô awpa a châ,’ tahpa ta chhopa ama châpa nama pahno.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kei deikua ta cha ei cha chho ei, bie rai a taih khah u. Avâ reipa ta bie a taih khuh vy, avâ cha Khazohpa beidyuchhai châ tlôh ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Alei reipa ta bie a taih hra khuh vy, alei he a pheitlyna châ tlôh ta. Zerusale reipa ta bie a taih hra khuh vy, Zerusale cha Bei rônahpa khihpi châ tlôh ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Na luh reipa ta bie a taih hra khah y, sâbu miakha chhao papawhsa thei leipa chi ta, pavyhsa thei va chi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na biereipa cha, a châpa khiah ‘A châ’ tah la, a châ leipa khiah, ‘Châ vei’ tah mah y. Cha khô lâ cha moleipa tawhta a vypa a châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />“‘Mo vyuh ta mo, hâh vyuh ta hâh,’ ama tahpa nama pahno.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kei deikua ta cha ei cha chho ei, moleipa a dyuh khah u. Chyhsa ta na baih chachâh lâ a cha chabaih khiahta cha, hiakha lâ chhao dao mah y.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chyhsa ta lyuh cha tua sala, na viahkao rytho a cha lapa khiahta cha, na viahkao pasipa chhao pie pâ mah y.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chyhsa ta me kha a cha pasiesa raruah khiahta cha, a hnohta me no sie mah y.
  </para>
  <para style="p">
    <verse number="42" style="v" />Châ hiahpa maih pie la, dyu châ cheipa thlyu khah y.
  </para>
  <para style="p">
    <verse number="43" style="v" />“‘Na vaih kyhpachâ la, na chariahpa a hao mah y,’ ama tahpa nama pahno.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kei deikua ta cha ei cha chho ei, nama chariahpazy kyh pachâ u la, châ taolatuhpazy thlahchhâpa muh vy.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chatanachata nama Paw avâ liata a ypa sawzy nama châ aw. Ano cha chyhsa chhiepa nata phapa chô liata noh pachhisa ta, chyhsa siapa nata sialeipa chô liata chhao avâ a pasuasa tyh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kyh châ pachâtuhpazy deita kyh nama pachâ khiahta cha, khâpa lymâ nama hmô aw? Chhiekheituhpazy chhao ta cha hawhpa cha tao thlâh ha veih ei ma?
  </para>
  <para style="p">
    <verse number="47" style="v" />Nama unawhzy deita bie namâ chho khiahta cha, chyhsa hropazy hlâta nama tao viana khâpa a y? Zenitaizy chhao ta cha hawhpa cha tao thlâh ha veih ei ma?
  </para>
  <para style="p">
    <verse number="48" style="v" />Nama Paw avâ liata a ypa a sia pakipa hawhta, nâmo chhao nama sia paki awpa a châ.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Chyhsa hmô awpa ta hmo pha a taopa nama châ lei nawpa ta a chado teh u. Chataleipatala nama Paw vârâh liata a ypa tawhta lymâ hmô aw veih ei chi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Chavâta phahlapazy hmo na pie tita, phapakheipazy ta chyhsa reithaina ama hlao thei nawpa ta, pakhyna ozy liata nata lâlaizy liata ama taopa hawhta, na hmia lâta chiahmie tô laih khah y. Hmeiseihta ta ei cha chho ei, ama lymâ ama hmô haw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nâ deikua cha phahlapazy hmo na pie tita, na ku chachâh lâta a taopa cha na ku chavei lâta pahno khah sy.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chatanachata na hmopiepazy cha arulâta y aw ta, na Paw arulâta châ hmôtuhpa ta lymâ a cha pie aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Thlah nama chhâ tita, phapakheipazy hawhta tao khuh vy. Âmo cha chyhsa ta ama hmô thei nawpa ta, pakhyna ozy liata nata khiliah suzy liata a duahpa ta thlah ama chhâ tyh. Hmeiseihta ta ei cha chho ei, ama lymâ ama hmô haw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nâ deikua cha thlah na chhâ tita, na chhôhpadâhpa lâ a ngia la, ochhi khaw la, na Paw arulâta a ypa lâta thlahchhâ mah y. Na Paw arulâta a hmôtuhpa ta a cha pie aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Thlah nama chhâ tita, Zenitaizy taozie hawhta, hraoleipa biezy reih chanei ngâ thlâh ha khuh vy. Zenitaizy ta bie hluhpi ama reipa vâta ama thlahchhâpa nathliepa awpa hawhta ama pachâ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Âmo hawhta tao khuh vy. Namâ ngiahpazy cha nama hia hlâ chhao ta nama Paw ta a pahno.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chavâta nâmo la hetana heta thlahchhâ tyh muh vy: “‘Eima Paw vârâh liatapa, Na moh zachhih mawh sy.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na khinarâh vaw tlô mawh sy. Na khopa vârâh liata ama taopa hawhta, Alei liata taopa châ mawh sy.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noh chareih nie awpa miah pie mah y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eima chô liata hmo a paraopazy eimâ ngiahthaipa hawhta, Eima paraonazy miah ngiahthai mah y.
  </para>
  <para style="p">
    <verse number="13" style="v" />Reipasaona lâta miah a chhi khah y, Moleipa tawhta miah pachha mah y. Khinarâh zy, hmotaotheina zy, rônahna zy, Chhâzaw nata tlyzaw ta na eih châ tlôh ta. Amen.’
  </para>
  <para style="p">
    <verse number="14" style="v" />“Nama chô liata hmo a paraopazy namâ ngiahthai khiahta cha, nama Paw vârâh liata a ypa ta a châ ngiahthai hra aw ei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nama chô liata hmo a paraopazy namâ ngiahthai vei khiahta cha, nama Paw ta nama hmoparaopazy châ ngiahthai hra aw veih ei.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Kâhvileipa ta nama y tita, phapakheipazy hawhta thachhâna hmia phaoh khuh vy. Âmo cha kâhvileipa ta ama ypa chyhsazy ta ama pahno thei nawpa ta, thachhâna hmia ama palâsa tyh. Hmeiseihta ta ei cha chho ei, ama lymâ ama hmô haw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nâ deikua cha kâhvileipa ta na y tita, na luh sathaw a thu la, na hmia a pahlie mah y.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chatanachata kâhvileipa ta na ypa cha chyhsazy ta pahno leipa aw ei ta, na Paw arulâta a ypa deita ta pahno aw ta, na Paw arulâta châ hmôtuhpa ta lymâ a cha pie aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Chhoma-u nata saiiepa ta niepa ta, parutuhpazy ta a ngia ei ta ama paru theina alei liana heta ryuzy a pachô khuh vy.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chhoma-u nata saiiepa ta a nie thei leina, parutuhpazy ta amâ ngia thei leina nata paru thei leina vârâh liata ryuzy tlao a pachô muh vy.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na ryu yna liata na palôh chhao a y aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Mokhaoh cha pôhpa meiôh a châ. Na mo a sia khiahta cha, na pôhpa duata a khaih aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na mo a rao ha khiahta deikua cha, na pôhpa dua ta a zoh aw. Nâma liata khaihna cha zohna châ ha sala, zohna cha a zoh ngaita aw dia!
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ahy hmahta abei pano chakao pabaoh thei aw veih ei. Pakha a hao aw ta, ahropa cha kyh a pachâ aw. Cha leipa chhao ta, pakha rei a ngiah aw ta, ahropa cha a mopakhô aw. Khazohpa nata khizaw sôh chakao pabaoh thei veih ei chi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Chavâta ei cha chho ei, nama hrona kyh liata nôpopa ta y leipa u la, nama nie awpa nata nama doh awpa kyh liata nôpopa ta y hra khah u. Nama pôhpa kyh liata nôpopa ta y leipa u la, namâ bu sai awpa kyh liata nôpopa ta y hra khah u. Niepa hlâta hrona sôh via ta, chysia hlâta pôhpa sôh via vei ma?
  </para>
  <para style="p">
    <verse number="26" style="v" />“Vâ pavawzy khi moh tua u: Chi cheih leipa ei ta, hria hra leipa ei ta, sawvâ liata ryh hra veih ei. Châhrasala nama Paw vârâh liata a ypa ta a pasa lymâ ei. Nâmo cha âmo hlâta sôh via syulyu veih ei chi ma?
  </para>
  <para style="p">
    <verse number="27" style="v" />Nama hry liata ahy ma pachârôhpa vâta a doh dy kha a paseihsa via thei?
  </para>
  <para style="p">
    <verse number="28" style="v" />Khazia abu asai kyh liata nama nô a po? Râh liata lilipawzy pachâ tua u, kheihta ma ama laiseih? Hriapasa leipa ei ta, pala so hra veih ei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Châhrasala ei cha chho ei, Sawlawmaw tlai chhao kha a rônahna zydua liana khata, he pawpi miakha tlu ta a ngiapa ta a tobi vei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hy nâmo, ngiapâ chyhpa saih u, râh liata sibiepa tanoh hroh ta, mylâ mei liata thy thlâh ha awpa hmahta Khazohpa ta cha tlatlu ta a tobi khiahta cha, nâmo chhochhi cha, cha tobi via syulyu aw veih ei ma?
  </para>
  <para style="p">
    <verse number="31" style="v" />“Chavâta ‘Khâpa eima nie aw?’ ‘Khâpa eima doh aw?’ ‘Khâpa eimâ tobi aw?’ tahpa ta nôpopa ta y khuh vy.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zenitaizy ta cha hmo zydua cha ama tlua tyh. Cha zydua cha namâ ngiahpa a châ tahpa nama Paw vârâh liata a ypa ta a pahno.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khazohpa khinarâh nata a siana tlua tua u la, cha hmo zydua cha baichhapa nama châ aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Chavâta mylâ châta nôpopa ta y khuh vy. Mylâ cha anosasyh ta â pachâ chhyh aw. Noh kha châta noh kha nôpo â daih.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Sei khuh vy, seipa ta nama y lei nawpa ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nama seipa hawhta cha sei aw ei ta, nama panuapa hawhta ama cha panuapa aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khazia nâma mo liata pâkô a ypa hmô leipa chi ta, na unawhpa mo liata mobâ na hmô?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nâma mo liata pâkô a y thlâh ha nota, kheihta ma na unawhpa hnohta, ‘Mobâ kha cha vaw thaopa haw sah,’ na tah thei aw?
  </para>
  <para style="p">
    <verse number="5" style="v" />Nâ, phapakheipa, nâma mo liata pâkô kha la ha tua la, chatanachata na unawhpa mo liata mobâ cha a siapa ta hmô aw chi ta, na thaopa thei aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Izy cha hmo pathaihpa pie leipa u la, vaozy hmiakô liata nama taikuh lôsôhpazy thy hra khuh vy. Ama phei ta tly aw ei ta, ama châ liehnao pathlei aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Hiah teh u, piepa nama châ aw. Tlua teh u, nama hmô aw. Chakhyh teh u, pahypa nama châ aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hiahpa maihta piepa châ ei ta, a tluapa ta hmô ta, a chakhyhpa cha pahypa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nama hry liata ahy ma a sawchapawpa ta viahchhâ hiah sala, alô a pie aw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nga hiah sala, parih a pie aw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Nâmo, moleipazy chi hmahta, nama sawzy hmo phapa piena châh nama pahno khiahta cha, nama Paw vârâh liata a ypa chhochhi ta cha, kha tlu ta hluh viapa ta ma a hiahtuhpazy hnohta hmo phapa a pie aw tly!
  </para>
  <para style="p">
    <verse number="12" style="v" />Chavâta chyhsa ta nama chô liata ama tao awpa nama khopa hawhta, chyhsa chô liata tao hra muh vy. Cha cha ryhpa nata hrohsopazy bie a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Chhikao buahpa liata a ngia teh u. Leidiana lâta siena chhikao cha kawh ta, a sie nao ta, cha lâta â ngiapa cha ama hluh ngaita.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hrona lâ siena chhikao deikua cha buah ta, a sie ru ta, cha lâta a siepa cha ama chyhta.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Hrohso pakheipazy tawhta a vaih muh vy. Chazy cha mietaku vo a bupa ta nâmo lâ a vy ei ta, ama chhôh lâ deikua cha changie chahraochatôhpazy ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama thei tawhta nama pahno aw. Ahloh liata kre thei ama lyu beih ma? Diahsai liata theiku ama lyu beih ma?
  </para>
  <para style="p">
    <verse number="17" style="v" />Tho phapa ta thei phapa pathei ta, tho chhiepa ta thei chhiepa a pathei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tho phapa ta thei chhiepa pathei beih leipa ta, tho chhiepa ta thei phapa pathei beih vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thei phapa a pathei leipa tho maih cha thlupa châ ta, mei liata thypa a châ tyh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cha hawhna chata, hrohso pakheipazy chhao ama thei tawhta nama pahno aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />“ ‘Abeipa, Abeipa,’ nâ tahpa maihta, vârâh khinarâh a ngia leipa aw ei ta, ei Paw vârâh liata a ypa khopa a taotuhpa deita ta â ngia aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha noh liata chyhsa hluhpi ta ei hnohta, ‘Abeipa, Abeipa, na moh ta hrohsona bie phuah ma pi ma, na moh ta ahripazy papua ma pi ma, na moh ta hmonoâhpa hluhpi tao ma pi ma?’ ama tah aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cha tina chata ama hnohta, ‘Nâmo, moleina hmo a taopazy saih u, cha pahno beih veih ei na, na siesai teh u,’ ei tah aw ei.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ei biezy he thei ta a taopa maih cha, chyhsa sopa, lôpanô chô liata o a sapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Avâ suah ta, ti vaw lai ta, thlih ta o vaw su ta, châhrasala o cha cho vei, lôpanô chô liata bôpa a châpa vâta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ei biezy thei ta a tao leipazy deikua cha, chyhsa hrupa, sadi chô liata o a sapa hawhta ama châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Avâ vaw suah ta, ti vaw lai ta, thlih ta o cha vaw su ta, o cha a cho haw. O chopa cha a rarôh y ngaita,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cha biezy cha Zisu ta a reih khai nahta, zawpizy cha a pachuna bie vâta ama noâh kaw ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ryhpa pachutuhpazy hawhta châ leipa ta, biehneina a hneipa hawhta a pachupa vâta a châ.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu cha tlâh tawhta a za chô nahta, zawpi hluhpi ta ano cha zi ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phawhpa pakha a hnohta a vy ta, a hmiakô liata a bôh ta, a hnohta, “Abeipa, na khoh khiahta la eina pathaisa thei chi na,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu ta a ku ta kei paza ta, phawhpa cha hria ta, a hnohta, “Ei khoh na, pathaih mah y,” tah ta. Phawhpa cha thlai pathaih ha ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta a hnohta, “Ahy hmahta chho lei awpa ta a sohsi mah y. Anodeikuacha ama zo thei nawpa ta, sie la, theihthaipa a kei pamosa la, Mawsi ta hmo hlâ awpa a raopa kha kei hlâ mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zisu cha Kâpynia khih â ngia nahta, pheisaih za kha hyutuhpa a vy ta, a hnohta,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Abeipa, nâ chakaotuhpa asypa cha o liata a zia thlâh ha ta, a pasa ngaita,” tah ta, patlâh awpa ta a haw ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zisu ta a hnohta, “A vy aw na ta, ei patlâh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pheisaih za kha hyutuhpa ta, “Abeipa, ei o nâ ngia tlâh châ va na. Bie kawh kha reih la, nâ chakaotuhpa cha a tlâh aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kei chhao he biehneina a chabatuhpa châ na ta, ei ry liata pheisaihzy ama y hra. Pheisaih pakha hnohta, ‘Sie teh,’ tah na ta, sie ta, ahropa hnohta, ‘A vy teh,’ tah na ta, a vy ta, nâ chakaotuhpa hnohta, ‘He he tao teh,’ tah na ta, a tao tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zisu ta cha bie cha a thei nahta, a noâh kaw ta, a pachupazy hnohta, “Hmeiseihta ta ei cha chho ei, he tlu ta ngiapâna thatlôpa he Izarei liata pakha hmah hmô va na.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ei cha chho ei, nochhi notla tawhta chyhsa hluhpi a vy aw ei ta, Abarahâ, Aisika nata Zakaw zy hnohta vârâh khinarâh liata amâ tyuh aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khinarâh sawzy hawhta â pachâpazy deikua cha, khôtho lâ zohna liata thypa châ aw ei ta, cha liata chana nata hâh chariehna a y aw,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zisu ta pheisaih za kha hyutuhpa hnohta, “Sie mah y. Nâ ngiapâna hawhta na châta taopa a châ aw,” tah ta. Chatanachata chakaotuhpa cha, cha dawh liana tlai chata tlâh ha ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zisu Pity o liata â ngia nahta, a pihnô cha chasipa ta â zia thlâh hapa hmô ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />A ku hria ta, a chasipa cha pai ha ta, thyu ta Zisu cha chakao pâ ha ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zâlâ a vaw châ nahta, ahripa patupa hluhpi a vaw chhi ei ta, bie ta ahripazy cha papua ta, tlâh leipa zydua patlâh lymâ ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha hmo cha hrohsopa Isai ta, “Ano ta eima pasanazy a la ta, eima hriiahzy miah a phaopa,” tahpa ta a reipa kha a vaw tlô thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta a kiapâh liata zawpi hluhpi a hmô nahta, haosâ lâ chaka awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ryhpa pachutuhpa pakha a vy ta a hnohta, “Pachutuhpa, na siena lâ maih ei cha zi aw,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zisu ta a hnohta, “Changiezy ta khaoh hnei ei ta, vâ pavawzy ta bu ama hnei. Chyhsa Sawchapawpa deikua cha luh nyu nawpa su chhao hnei vei,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pachupa hropa pakha ta a hnohta, “Abeipa, ei paw kei pabu ha tua awpa na pasaih mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zisu ta a hnohta, “Na zi teh, athihpazy ta ama chyhsa athipazy cha pabu mawh ei sy,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu cha balyh liata a kiah nahta, a pachupazy ta ano cha pazi ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tipo liata thlihpi ru ngaitapa vaw pathli ta, ama balyh cha tichatlaopa ta vao ha ta. Zisu deikua cha a mô thlâh ha ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />A pachupazy a vy ei ta, Zisu cha pahra ei ta, “Abeipa, miah pachha teh, eima leidia hai hih,” tah ei ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zisu ta ama hnohta, “Ngiapâna chyhpa saih u, khazia nama chi?” tah ta. Thyu ta thlihzy nata tichatlaopa cha ra ta, sidia ha ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyhsazy cha ama noâh kaw ta, “He chyhsa he kheihawhpa chyhsa ma a châ tly, thlihzy nata tichatlaopazy taihta a rei amâ ngiahpa he,” tah ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Haosâ Kâdarene râh a tlô nahta, ahripa patupa pano thlâ tawhta vaw pua ei ta, Zisu cha a vaw tyh ei ta. A hrâh ngâsâ ei ta, chavâta cha lâpi liana cha ahy hmahta ama sie ngâh tyh leipa a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thata awh ei ta, “Khazohpa Sawchapawpa, kheihta miah tao awpa ma na khoh? Noh taihpa tlô hlâta riethei miah pataosa awpa ta ma nâ vy?” tah ei ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama yna tawhta a hla kawpa liata vao zaw hluhpi ama lao chuah ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ahripazy ta a haw ei ta, a hnohta, “Miah na papua awpa khiahta cha, vao zawzy py chhôh liata miah pangiasa mah y,” tah ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zisu ta ama hnohta, “Sie teh u,” tah ta. Chatawhcha vaw pua ei ta, vaozy chhôh liana cha a ngia ei ta, vao zaw zydua cha tilaipi ngiahkâ pâdawhpa lâ a râ ei ta, ti liata tlasao khai ha ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Vao pasatuhpazy cha a râ ei ta, khihpi a ngia ei ta, ato chho ei ta. Ahripa patupazy chô liata hmo a tlôpazy chhao chho ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />A khihpi ta Zisu a tyh awpa ta vaw pua ei ta, ama hmô nahta, ama bia puasai awpa ta a haw ei ta.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu cha balyh liata kiah ta, haosâ lâ chaka ta, ano khih lâ sie ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyhsa thokha ta asypa pakha a rakhô chhaota ano lâ a vaw sy ei ta. Zisu ta amâ ngiapâna a hmô nahta, asypa hnohta, “Ei sawchapawpa, thlalôhpa ta y mah y, na moleinazy a ngiahthaipa a châ haw,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ryhpa pachutuhpa thokhazy ta ama palôhrupa ta, “He chyhsa heta Khazohpa a reipachhie he,” tah ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta ama pachânazy cha pahnopa ta, “Khazia nama palôh liata hmo moleipa nama pachâ?
  </para>
  <para style="p">
    <verse number="5" style="v" />Kheihawhpa ma a rei a nao via aw, ‘Na moleinazy a ngiahthaipa a châ haw,’ tahpa ma, ‘Thyu la sie teh,’ tahpa maw?
  </para>
  <para style="p">
    <verse number="6" style="v" />He hmo he, chyhsa Sawchapawpa he moleinazy a ngiahthai theina biehneina khizaw liata a hnei tahpa nama pahno nawpa ta taopa a châ,” tah ta. Asypa hnohta, “Thyu la, na hmohphaw la la, na o lâ a di teh,” tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Asypa cha thyu ta, a o lâ a di ha ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zawpizy ta cha cha ama hmô nahta, chi ngaita ei ta, chyhsapazy hnohta cha hawhpa biehneina a pietuhpa Khazohpa cha reithai ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha su tawhta Zisu cha sie lymâ ta, chhie kheina su liata atyuhpa chyhsa pakha a moh Mathai ama tahpa hmô ta, a hnohta, “Na zi teh,” tah ta. Thyu ta, zi ha ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />O liata pati ama dôh hai nota, chhiekheituhpa nata moleipa hluhpi a vy ei ta, Zisu nata a pachupazy cha pati dôh lâh ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Phârisaihzy ta cha cha ama hmô nahta, a pachupazy hnohta, “Khazia nama pachutuhpa heta chhiekheituhpazy nata moleipazy pati a dôh lâh thlâh ha ei?” tah ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zisu ta cha bie cha a thei nahta, ama hnohta, “Atlâhpazy ta dawhty a ngiah leipa ei ta, tlâhleipazy ta amâ ngiah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vawh u la, ‘Atheihna khoh leipa na ta, zawngiahna ei khoh,’ tahpa bie yzie cha a kei chu teh u. Chyhsa siapazy pado awpa ta a zupa châ leipa na ta, moleipazy pado awpa ta a zupa tlao ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawhâna pachupazy a hnohta a vy ei ta, “Khazia keimo nata Phârisaihzy he kâhvileipa ta y tyh pi ta, na pachupazy he kâhvileipa ta ama y hra vei?” tah ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zisu ta ama hnohta, “Myuhneituhpa a y thlâh ha nota, ahneina kyhchhi a hlaopazy mâchhie ama sa aw ma? Ama hry tawhta myuhneituhpa lana daihti vaw tlô aw ta, cha tita deikua cha kâhvileipa ta ama y aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahy hmahta pohthâ thiehpa ta chysia parohpa baithla beih veih ei. Ama baithla khiahta cha, a baithlana ta chysia parohpa cha hrie aw ta, â hrie lao ha aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Savo titheih parohpa liata kresawhti thiehpa ryh beih hra veih ei. Ama ryh khiahta cha, savo titheih cha pa aw ta, kresawhti a leih aw ta, savo titheih cha a parao ha aw. Kresawhti thiehpa cha savo titheih thiehpa liata ama ryh tyh, chatanachata amâ boh raihrie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cha biezy cha Zisu ta ama hnohta a rei hai nota, ryureituhpa pakha a vy ta, a hmiakô liata a bôh ta, a hnohta, “Tahmâ tlai kha ei sawchanô thi ta, châhrasala a vy la, a chô liata na ku pahnieh la, a hroh heih aw,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zisu cha thyu ta, a pachupazy chhaota ryureituhpa cha pazi ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chanô pakha kô hrawh hleino thi lohpa ta tlâhleipa ta a hnôh lâta pazi ta, a poh pai hria ta,
  </para>
  <para style="p">
    <verse number="21" style="v" />“A poh pai chhâ ei hria khiahta cha, patlâhpa ta ei y aw,” tahpa ta pachâ ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zisu cha a vaw heih ta, chanô cha hmô ta, a hnohta, “Ei sawchanô, thlalôhpa ta y mah y. Nâ ngiapâna ta a cha patlâh haw,” tah ta. Cha dawh liana chata chanô cha patlâhpa ta y ha ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu cha ryureituhpa o a tlô nahta, ramo tôtuhpazy nata zawpi a tymâ ngaitapazy hmô ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />ama hnohta, “Pua teh u, hawtinô he thi vei, â môpa a châ hih,” tah ta. Zisu cha pahneisao ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Châhrasala zawpizy cha khôtho lâ ama pua khai nahta, a ngia ta, hawtinô cha a ku ta patu ta, kaw thyu ha ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cha thâtih cha, a chheipâh râh zydua liata pathâh ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cha su tawhta Zisu cha sie lymâ ta, mochaopa pano ta ano pazi ei ta, “Dâvi Sawchapawpa, miah ngiachhie teh,” tahpa ta ao paro ngaitapa ta awh ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />O chhôh lâ â ngia nahta, mochaopazy cha a hnohta a vy ei ta, Zisu ta ama hnohta, “He hmo he ei tao thei tahpa namâ ngiapâ ma?” tah ta. Âmo ta a hnohta, “Abeipa y, eimâ ngiapâ na” tah ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ama mo cha hria ta, ama hnohta, “Namâ ngiapâna hawhta nama chô liata vaw tlô mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama mo vaw pavâ ha ta. Zisu ta âmo cha zikyu a râ ta, ama hnohta, “Ahy hmahta pahno lei awpa ta a sohsi muh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Châhrasala sie ei ta, a thâtih cha, cha râh chhôh zydua liata tlao pathâhsa lymâ ha ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chyhsazy ama pua nahta, ahripa patupa reih pathlie thei leipa a hnohta a vaw chhi ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahripa a puapa nahta, reih pathlie thei leipa cha a reih pathlie thei ha ta. Zawpizy cha ama noâh ngaita ta, “He hawhpa he Izarei liata hmô beih ma pi,” tah ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Phârisaihzy deikua ta, “Ahripa bei a châpa vâta ahripazy a papua theipa a châ hih,” tah ei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zisu cha khihpi nata khitaw zydua chahryh ta, amâ pakhyna ozy liata pachupa ta khinarâh thâtihpha phuah lymâ ta. Hriiah to nata pasana to patlâh ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zawpizy a hmô nahta, vaituhpa hnei leipa mietakuzy hawhta, nôpopa nata baotuhpa hnei leipa ta ama ypa vâta, âmo cha a thapasa ngaita ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />A pachupazy hnohta, “Sâh hria awpa hluhpi y ta, hriatuhpazy deikua ama chyh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chavâta sâh hria awpa ta hriatuhpazy a vaw tuah thei nawpa ta, sâh hria Beipa lâ hiah teh u,” tah ta.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu ta a pachupa pahrawh hleinozy aw ta, thlahpa puapazy papua thei awpa nata hriiah to nata pasana to patlâh thei awpa ta âmo cha biehneina pie ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lyuhchâpa pahrawh hleinozy moh cha hezy he ama cha: A hmiatua chai ta, Saimaw, Pity ama bipa nata a unawhpa Adaru; Zebâdi sawchapawpa Zâmie nata a unawhpa Zawhâna;
  </para>
  <para style="p">
    <verse number="3" style="v" />Phili nata Bâthawlawmu; Thawma nata chhiekheituhpa Mathai; Alphu sawchapawpa Zâmie nata Thâdia;
  </para>
  <para style="p">
    <verse number="4" style="v" />Zilô py liatapa Saimaw nata a patusatuhpa Zudâh Iskari zy ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />He pahrawh hleinozy he Zisu ta tuah ta, ama hnohta hetana heta bie a pie ei: “Zenitaizy lâpi lâta sie leipa u la, Samâri khihpi liata chhao a ngia hra leipa u la,
  </para>
  <para style="p">
    <verse number="6" style="v" />Izarei phopi mietaku a leipazy lâta tlao sie teh u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nama siena liata, ‘Vârâh khinarâh cha â hnia haw,’ tahpa ta chho lymâ teh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tlâhleipazy patlâh u la, athipazy pathyu u la, phawhpazy pathaisa u la, ahripazy papua teh u. A saipa ta hmô ei chi ta, a saipa ta pie teh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nama chaisaihna liata ngôh tlyma, tâkâ tlyma, dawh tlyma a phao leipa u la,
  </para>
  <para style="p">
    <verse number="10" style="v" />nama khitlyna sahria tlyma, viahkao pasipa zo no tlyma, pheikyzy tlyma, chôchahrei tlyma a phao hra khah u. Raihriatuhpa cha a nie tlâh a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khihpi liata tlyma, khitaw liata tlyma namâ ngia tita, cha liata tlô tlâh a châpa chyhsa tlua u la, nama sie hlâlei cha, cha liata y teh u.
  </para>
  <para style="p">
    <verse number="12" style="v" />O namâ ngia tita a naoh teh u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha o liata chyhsazy cha a naoh tlâh ama châ khiahta cha, nama thlapalôhna bie ama chô liata tlô sala, a naoh tlâh ama châ vei khiahta deikua cha, nama thlapalôhna bie cha nâmo lâ vaw kua heih mawh sy.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahy rai châ ly leipa tlyma, nama biezy a nathlie leipa tlyma cha, cha o tawhta tlyma, cha khih tawhta tlyma nama pua tita, nama phei liata buchadoh chatho thlu teh u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hmeiseihta ta ei cha chho ei, ryureina noh liata, cha khih hlâta Sawdawmâ nata Kawmawrâ pasa taopa a zie a y via aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Pachâ teh u, changie hry liata mietaku hawhta ei cha tua ei hih. Chavâta parihzy hawhta so u la, vachhuhzy hawhta nônaipa ta y teh u.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chyhsazy tawhta a vaih teh u. Ryureina lâ cha hlâ aw ei ta, pakhyna ozy liata ama cha tu aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zenitaizy hmiakô liata bie pahnotuhpazy châ awpa ta, keima vâta ryureituhpazy nata abeizy hmiakô liata ama châ chhi aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ama cha patu tita, ‘Kheihta ma bie eima reih aw, khâpa bie ma eima reih aw,’ tahpa ta nama nôpo khah sy. Nama rei awpa cha a daihtita liata piepa nama châ aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bie a reih awpa cha nâmo châ veih ei chi, nama Paw Thlahpa ta nâmo hmâpa ta tlao a reih aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thie awpa ta, unawhpa ta a unawhpa patusa aw ta, paw ta a saw a patusa aw. Sawzy ta nôpawzy a dyuh aw ei ta, ama pathiesa aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ei moh vâta chyhsa to a haopa ta y aw ei chi ta, achhâna taihta â ipa ta a duahpa cha pachhapa ta a y aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khihpi miakha liata ama cha taola tita, khihpi hropa lâ a râ teh u. Hmeiseihta ta ei cha chho ei, Chyhsa Sawchapawpa â vy hlâta Izarei khihpi zydua chahryh khai hmâ aw veih ei chi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Pachupa cha a pachutuhpa chô lâta y leipa ta, sei chhao a zibeipa chô lâta y vei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pachupa cha ano pachutuhpa a lyupa a daih ta, sei ta a zibeipa a lyupa â daih. O hneituhpa hmahta Belzebu ama tah khiahta cha, a chhôhkhazy chhochhi cha khatlu ta ma ama reipachhie via aw tly!
  </para>
  <para style="p">
    <verse number="26" style="v" />“Chavâta âmo cha chi khuh vy. A lâ lei awpa ta khupa khâpa hmah y leipa ta, pahno lei awpa ta phihpa khâpa hmah y vei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zohna liata ei cha chhopa ei he, khaihna liata reih u la, bieparu ta nama theipa kha, vâphuh chô tawhta awh teh u.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pôhpa thie thei ta, thlahpa a thie thei leipazy chi leipa u la, hrienasu liata pôhpa nata thlahpa a pahleipadia theipa cha tlao chi teh u.
  </para>
  <para style="p">
    <verse number="29" style="v" />Boby pô no phusâ miakha ta zuapa châ vei ma? Ama hry liata pô kha chhao nama Paw paryhsana leipa ta alei liata tla aw vei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nama luh liata sâ zydua chhao reih khaipa a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chavâta chi khuh vy, boby hluhpi hlâta nama sôh via.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Ahy rai chyhsa hmiakô liata nâ châhkheipa cha, ei Paw vârâh liata a ypa hmiakô liata a châhkhei aw na ta,
  </para>
  <para style="p">
    <verse number="33" style="v" />ahy rai chyhsa hmiakô liata nâ paphapa cha, ei Paw vârâh liata a ypa hmiakô liata ei papha hra aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Khizaw liata adyhna chareisa awpa ta a vypa hawhta na pachâ khuh vy. Adyhna chareisa awpa châ leipa ta, zaozi chareisa awpa ta a vypa tlao ei châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sawchapaw ta a paw, sawchanô ta a nô, myuhnô a nohnô padyuhsa awpa ta a vypa ei châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chyhsa chariahpazy cha ano chhôhkhapa cheingei tawhta ama châ aw.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kei hlâta a paw tlyma, a nô tlyma kyh a pachâ viapa cha, ei chyhsa tlâh châ vei. Kei hlâta a sawchapaw tlyma, a sawchanô tlyma kyh a pachâ viapa chhao, ei chyhsa tlâh châ vei.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ahy rai a kraws a piapa ta nâ zi leipa cha, ei chyhsa tlâh châ vei.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahy rai a hrona a hmôpa ta a hrona pahlei aw ta, keima vâta a hrona a pahleipa ta a hrona a hmô heih aw.
  </para>
  <para style="p">
    <verse number="40" style="v" />“Ahy rai nâmo châ lypa cha keima nâ lypa châ ta, ahy rai kei nâ lypa cha nâ tuahtuhpa a lypa a châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ahy rai hrohsopa cha hrohsopa a châpa vâta a lypa cha, hrohsopa lymâ hmô aw ta, chyhsa siapa cha chyhsa siapa a châpa vâta a lypa chhao, chyhsa siapa lymâ a hmô aw.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahy rai, he chyhsa chyhpatazy hry liata pakha hnohta, ei pachupa a châpa vâta ti chakuapa nyu kha a piepa cha, hmeiseihta ta ei cha chho ei, a lymâ pahlei cheita aw vei.”
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu cha a pachupa pahrawh hleinozy bie a pie khai tawhta, ama khihpizy liata pachu awpa nata bie chho awpa ta, cha su tawhta pua ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Krista hmotaopazy cha, Zawhâna ta patâhna o tawhta a vaw pahno nahta, a pachupazy tuah ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu hnohta, “A vy awpa cha na châ ma, ahropa eima hâ aw ma?” tahpa ta pahiahrisa ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta âmo cha a chhy ta, “Sie u la, nama theipa nata hmôpazy he Zawhâna kei chho teh u:
  </para>
  <para style="p">
    <verse number="5" style="v" />Mochaopazy ama mo pavâ ta, pheisypazy phei ta sie ei ta, phawhpazy pathaisapa ta y ei ta, nahpâpazy ta thei ei ta, athipazy pathyupa ta y ei ta, dyhchhiepazy hnohta thâtihpha chhopa a châ haw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ei chô liata palôhchâ leina a hnei leipa chyhsa cha a nohlao na,” tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zawhâna pachupazy ama sie nahta, Zisu ta zawpi hnohta Zawhâna thâtih reih ta: “Khâpa mo awpa ta ma râhchawhpa lâ nama sie? Ziza ta lohthi a chalyupa mo awpa ta ma?
  </para>
  <para style="p">
    <verse number="8" style="v" />Khâpa mo awpa ta ma nama pua tly? Chysia naipa ta a tobipa chyhsa mo awpa ta ma? Chysia phapa ta a tobipazy cha abei ozy liata mah ama y tâh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha khiah, khâpa mo awpa ta ma nama pua? Hrohsopa mo awpa ta ma? Ano cha hrohsopa a châ tlai, ei cha chho ei, hrohsopa hlâta rônah viapa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />“‘Moh teh u, ei lyuhchâpa na hmia lâta tuah na ta, Ano ta na hmia lâta na lâpi â chhuahdy aw!’ tahpa ta a thâtih ropa kha, ano he a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmeiseihta ta ei cha chho ei, chanô sapazy hry liata Bâtituhpa Zawhâna hlâta rônah viapa pua veih ei. Chatahrasala vârâh khinarâh liata chyhsa nawh chaipa cha ano hlâta a rônah via.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bâtituhpa Zawhâna daihti tawhta tahmâ taihta vârâh khinarâh cha thachahra ta adyuhna vâta pasa tao lymâ ta, thachahra a hmâhpazy ta tararuahna ta ama la lymâ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zawhâna a vaw pua hlâna khata, hrohsopa zydua nata Ryhpa bie ta ama vaw chhochhielie haw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha cha nama zo khoh khiahta cha, ano he Elaizâh a vy awpa cha a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Theina nakhaoh a hneipa ta thei mawh sy.
  </para>
  <para style="p">
    <verse number="16" style="v" />“He chhâ he khâpa nata ma ei pakho aw tly? Hawtizy sôdaohna su liata a tyuh ei ta, ama viasazy ama awpa a lyu.
  </para>
  <para style="p">
    <verse number="17" style="v" />“‘Ramo cha tôpa pi ta, Lâh leipa ei chi ta; Chaphôh cha tupa pi ta, Mâchhiesa hlei veih ei chi.’
  </para>
  <para style="p">
    <verse number="18" style="v" />“Zawhâna a vy ta, nie leipa ta, doh hra leipa ta, ‘Ahripa a hnei,’ tah ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chyhsa Sawchapawpa a vy ta, nie ta, doh ta, ‘Moh tua u, azohpa nata kresawhti parâpa, chhiekheituhpazy nata moleipazy viasa huh!’ tah heih ei ta. Châhrasala sona cha a hmotaopazy tawhta â dozie â lâ tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmonoâhpa a tao hluh chaina khihpizy cha, ama ro leipa vâta ra ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Kôrâzi, na hu a po na! Besaidâ, na hu a po na! Nâmo liata hmonoâhpa taopazy kha, Tyre nata Sidaw liata taopa châ sala, latho poh a bupa ta, buchâh a mia aw ei ta, ama ro ha awpa tlai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Châhrasala ei cha chho ei, ryureina noh liata la nâmo pasa taopa hlâta Tyre nata Sidaw pasa tao awpa a zie a y via aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nâ, Kâpynia, avâ taihta palyupalihpa ta na y aw ma? Athihkhih lâ a daophi pathlahpa na châ aw. Nâma liata hmonoâhpa taopazy kha, Sawdawmâ liata taopa châ sala, Sawdawmâ kha tanoh taihta a y thlâh ha awpa tlai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Châhrasala ei cha chho ei, ryureina noh liata la, nâma pasa taopa hlâta Sawdawmâ râh pasa taopa a zie a y via aw,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cha daihti liata Zisu ta, “Hy ei Paw, lei nata vâ Beipa, nâ ta he hmozy he chyhsa sopa nata novâhpazy liata nyu chi ta, hawti chyhpazy hnohta na phuahpa vâta ei châ ly ngaita.
  </para>
  <para style="p">
    <verse number="26" style="v" />A châ na, ei Paw, cha hawhpa cha na khopa châ tlôh ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ei Paw ta ato zydua eina hlâ haw. Paw dei leipa ta cha, ahy hmahta Sawchapawpa he pahno leipa ei ta, Sawchapawpa nata ano ta a hnohta a palâhâhpa tah dei leipa ta cha, ahy hmahta Paw pahno veih ei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nâmo, hriapasapa nata phaohripa zydua saih u, kei lâ a vy u la, ei cha pahâsa aw ei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ei raopaky a ky u la, kei tawhta a chu teh u. Kei cha areisipa nata palôh nônaipa ei châ. Nama thlahpazy châta apahâna nama hmô aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ei raopaky cha pha ta, ei phao chhao â hua,” tah ta.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha daihti liata, Zisu cha Pahânoh ta sâh thihzy chapiapa ta sie ta. A pachupazy cha ama nodi kaw ta, sâh suhzy thliepa ta nie ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phârisaihzy ta ama hmô nahta, a hnohta, “Moh tua, na pachupazy ta Pahânoh ta tao lei awpa hmo ama tao,” tah ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu ta ama hnohta, “Dâvi nata a hnohta a ypazy ta ama nodi nota ama hmotaopa kha reih beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazohpa o liata a ngia ta, ano nata a hnohta a ypazy châta nie pasai leipa, theihthaipazy deita nie theipa Ypâna Viahchhâ ama niepa kyh kha thei beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="5" style="v" />Theihthaipazy ta Pahânoh ta Achhyna o liata Pahânoh parao ei ta thai ama châ thlâh hapa kyh Ryhpa bie liata ropa chhao kha, reih beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ei cha chho ei, Achhyna o hlâta hmo rônah viapa he liata a y.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Atheihna khoh leipa na ta, zawngiahna ei khoh,’ tahpa he a yzie a pahnopasiapa châ u la cha, thaileina a hnei leipa thailei nama pachâsa lei awpa tlai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chyhsa Sawchapawpa he Pahânoh Beipa châ tlôh ta,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zisu cha, cha su tawhta sie ta, amâ pakhyna o liata a ngia ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyhsa pakha ku sypa y ta, Zisu ama leih thei nawpa ta a hnohta, “Pahânoh ta chyhsa patlâhpa he Ryhpa ta a pasaih ma?” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu ta ama hnohta, “Chyhsa ta mietaku pô kha hnei sala, cha cha Pahânoh ta khaohtlô liata tla ha sala, nama hry liata ahy ma pazapa ta a thaoh leipa a y aw ei chi?
  </para>
  <para style="p">
    <verse number="12" style="v" />Mietaku hlâta chyhsapa cha sôh via syulyu vei ma? Chavâta Pahânoh ta hmo pha taopa cha Ryhpa ta a pasaih,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chatawhcha chyhsa hnohna chata, “Na ku pazawh teh,” tah ta. A ku pazawh ta, a ku hiakha lâtapa hawhta vaw tlâh ha ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Phârisaihzy deikua cha pua ei ta, ano ama pahleipadia thei nawpa ta bie a pachia ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amâ chhuahpa cha a pahno nahta, Zisu cha, cha su tawhta sie ha ta. Chyhsa hluhpi ta ano cha zi ei ta, ama zydua ta patlâh ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />A châna phuah lei awpa ta âmo cha biepie ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha hmo cha hrohsopa Isai ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Moh teh u, he he ei tlyhpa nâ chakaotuhpa châ ta, Ei kho ngaitapa nata a chô liata ei thlahpa â ly kawpa a châ. A chô liata ei Thlahpa soh aw na ta, Zenitaizy hnohta ryureina dopa a phuah aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chyhsa a hryuh leipa aw ta, Awhsâh hra leipa aw ta, Tlyliah liata a ao a theipa y aw veih ei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lohthi tliepa-ipa thlie lao leipa aw ta, Meiôh thi daihmâpa pachhai lao aw vei; Ryureina dopa pahniena a patosa hlâlei cha,
  </para>
  <para style="p">
    <verse number="21" style="v" />Ano moh liata Zenitaizy ama hnabei a seih aw,” tahpa ta a reipa a vaw tlô thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chatawhcha ahripa ta a patupa, mochaopa nata reih pathlie thei leipa pakha a hnohta a vaw chhi ei ta. Zisu ta ano cha patlâh ta, reih pathlie thei leipa cha reih pathlie theipa ta, a mo pavâ ha ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zawpi zydua cha ama noâh ngaita ta, “He he Dâvi Sawchapawpa a châ thei aw ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Phârisaihzy deikua ta cha thâtih cha ama thei nahta, “He chyhsa heta ahripazy hyutuhpa Belzebu vâta ahripazy a papua theipa a châ hih,” tah ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama pachâpazy a pahno nahta, Zisu ta ama hnohta, “Khinarâh a chhaihzaoh ta âmo nata âmo a dyuhpa maih cha rao tyh ei ta, khihpi tlyma, chhôhkha tlyma, a chhaihzaoh ta âmo nata âmo a dyuhpa maih a duah aw veih ei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sâtâ ta Sâtâ a papua khiahta cha, ano nata ano â dyuhpa châ ta, kheihta a khinarâh â duah thei aw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Kei ta Belzebu moh ta ahripazy ei papua khiahta cha, nama sawchapawzy kha ahy moh ta ma ahripazy ama papua tyh? Chavâta âmo cha châ pachiatuhpazy ama châ aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khazohpa Thlahpa vâta ahripazy a papuapa ei châ khiahta deikua cha, Khazohpa khinarâh cha nama chô liata a vaw tlô hapa a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chyhsa ta chyhsa thatlôpa o liata a ngia sala, cha chyhsa thatlôpa cha a chahry ha tua leipa khiahta cha, kheihta a hmozy a hrao thei aw? A chahry khai tawhta a o cha a hrao thei aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ei chhâh a châ leipa cha nâ dyuhtuhpa châ ta, nâ pahmaohkhei leipa cha a papaituhpa a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chavâta ei cha chho ei, chyhsa moleina to nata Khazohpa ama reipachhiena cha a ngiahthaipa châ aw ta, Thlahpa reipachhiepa deikua cha, a ngiahthaipa châ aw vei.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chyhsa Sawchapawpa a reipachhiepa cha a ngiahthaipa châ aw ta, Thlahpa Pathaihpa a reipachhiepa deikua cha, he chhâ nata chhâ vaw y awpa liata chhao, a ngiahthaipa châ aw vei.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Tho phapa cha a thei pha ta, tho chhiepa cha a thei a chhie. Tho cha a thei tawhta pahnopa a châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Vâzi pathlazy saih u, nâmo moleipazy ta kheihta hmo phapa nama reih thei aw? Palôh liata a bie pakhôpa cha pakah ta a reih papua tyh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chyhsa phapa ta a ryubyh phapa tawhta hmo phapa papua tyh ta, chyhsa chhiepa ta a ryubyh chhiepa tawhta hmo chhiepa a papua tyh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ei cha chho ei, chyhsazy ta bie pha leipa ama reipa maih cha, ryureina noh liata amâ reipasia awpa a châ.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na biezy vâta thai châ aw chi ta, na biezy lilaw ta thailei pachâsapa na châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chatawhcha ryhpa pachutuhpa nata Phârisaih thokhazy ta a hnohta, “Pachutuhpa, nâma tawhta ngiana hmô awpa eima khoh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Zisu ta âmo cha a chhy ta, “Chhâ moleipa nata apheipazy ta ngiana ama tlua tyh. Châhrasala hrohsopa Zawna ngiana dei leipa ta cha, ngiana hropa piepa châ aw vei.
  </para>
  <para style="p">
    <verse number="40" style="v" />Zawna ta nga laipa py chhôh liata noh thôh nata zâ thôh a ypa hawhta, Chyhsa Sawchapawpa chhao alei chhôh liata noh thôh nata zâ thôh a y aw.
  </para>
  <para style="p">
    <verse number="41" style="v" />“Pachiana noh liata, Ninivâ mo kha he chhâ nata vaw thyu khoh aw ei ta, he chhâ he thailei ama pachâsa aw. Âmo cha Zawna biechhopa vâta ro ei ta, moh teh u, Zawna hlâta rônah viapa he liata a y.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chho beinô chhao, pachiana noh liata, he chhâ nata vaw thyu khoh aw ta, he chhâ he thailei a pachâsa aw. Sawlawmaw sona nathlie awpa ta hmah, khizaw chhâna tawhta a vy ta, moh teh u, Sawlawmaw hlâta rônah viapa he liata a y.
  </para>
  <para style="p">
    <verse number="43" style="v" />“Thlahpa puapa cha chyhsa tawhta a pua nahta, apahâna su tluapa ta ti y leina suzy chahryh ta, châhrasala hmô leipa ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />‘Ei vaw puana o lâ kha ei kua heih aw,’ tah ta. A tlô nahta, o cha a ruapa ta, phi chiehpa nata paryh khaipa ta hmô ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Sie ta, thlahpa hropa pasari, ano hlâta molei viapazy a vaw chhi ta, cha liata a ngia ei ta, ama pahrâ haw. Hnôhlâ ta cha chyhsa duahmo cha, hmiatuapa hlâ khata a chhie via syulyu haw. Cha hawhna chata, he chhâ moleipa chhao he a vaw y hra aw,” tah ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Zawpizy hnohta bie a rei hai nota, a nô nata a unawhzy ta ano cha bie a chho khoh ei ta, khôtho liata a duah ei ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chyhsa pakha ta a hnohta, “Na nô nata na unawhzy ta bie châ chho khoh ei ta, khôtho liata amâ duah thlâh haw,” tah ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />Zisu ta bie a chhotuhpa cha a chhy ta, a hnohta, “Ei nô cha ahy maw, ei unawhzy cha ahyzy maw?” tah ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chatawhcha a pachupazy lâta a ku pazawh ta, “Hezy he ei nô nata ei unawhzy cha ama châ.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ahy rai ei Paw vârâh liata a ypa khopa a taopa maih cha, ei unawh nata ei sietanô nata ei nô zy ama châ,” tah ta.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha noh lilaw ta Zisu cha o tawhta pua ta, tipo kiah liata a tyuh ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyhsa hluhpi a hnohta a vypakhy ei ta, balyh liata kiah ta, a tyuh ta, zawpi zydua cha raphyu liata a duah ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pakhona biezy hmâpa ta âmo cha bie hluhpi chho ta, ama hnohta, “Chi hietuhpa cha chi hie awpa ta pua ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chi cha hie ta, chi thokha cha lâthlôh kiah liata tla ei ta, pavawzy a vy ei ta, dyh khai ha ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chi thokha cha lôphiariapa alei apapa liata tla ei ta, alei a chha leipa vâta thlai kaw pyuh ei ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />noh a vaw chhi nahta, nohsa ta aih ei ta, thari a hnei leipa vâta ama uah haw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chi thokhazy cha ahloh thih liata tla ei ta, ahloh buhzy kaw rôh ta, chi riepazy cha ama disao haw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chi hropazy cha, alei phapa liata tla ei ta, thokha a lie za kha ta, thokha a lie sycharu ta, thokha a lie sythôh ta thei ama pathei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nakhaoh a hneipa ta thei mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />A pachupazy a vy ei ta a hnohta, “Khazia pakhona biezy hmâpa ta ama hnohta bie na reih?” tah ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu ta âmo cha a chhy ta, ama hnohta, “Nâmo cha vârâh khinarâh bieparuzy pahno awpa ta piepa châ ei chi ta, âmo deikua cha piepa châ veih ei.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hneipa hnohta pie baichhapa châ aw ta, a hluhpi a hnei aw. A hnei leipa deikua cha, a hnei chhôhpa chhao, ano tawhta lapa a châ aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />He vâna heta ama hnohta pakhona biezy hmâpa ta ei reipa a châ. Hmô ei ta, hmô tlôh leipa ei ta, thei ei ta thei tlôh leipa ei ta, pahno thai hra veih ei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hrohsopa Isai ta, “‘Thei cha thei aw ei chi ta, Châhrasala nama novâh aw vei; Hmô cha hmô aw ei chi ta, Châhrasala pahno thai aw veih ei chi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cha phopi palôh cha a kuhchha ha ta, Ama nah ta bie thei thai khao leipa ta, Ama mo ama paso haw. Chata châ vei sala cha, Ama mo ta hmôpa ta, Ama nah ta thei aw ei ta, Ama palôh ta pahnopa ta, Kei lâ a vaw heih aw ei ta, Ei patlâh ha awpa ei tlai,’ tahpa ta hrohsona bie a reipa kha ama chô liata a vaw tlô hapa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Nâmo deikua cha nama nohlao kaw dia! Nama mozy ta hmô ta, nama nahzy ta a thei.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmeiseihta ta ei cha chho ei, hrohsopa hluhpi nata mosiapa hluhpi ta nama hmôpa he hmô byuh kaw ei ta, châhrasala hmô veih ei. Nama theipazy he thei byuh kaw ei ta, châhrasala thei veih ei.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Chi hietuhpa pakhona bie yzie he nathlie teh u:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ahy rai khinarâh bie thei ha tlôh ta, a pahno thai vei khiahta cha, moleipa a vy ta, a palôh liata chi hiepa cha a lapa ha tyh. Cha cha lâpi liata chi hiepa cha a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />He he lôphiariapa liata chi hiepa a châ. Bie a theipa nahta, a lypa ta thlai a pyh ta,
  </para>
  <para style="p">
    <verse number="21" style="v" />châhrasala ano liata thari a thla leipa vâta, bohpi leipa dei y thei ta, bie vâta rietheipasana tlyma, taolana tlyma a vaw y nahta, thlai a pao ha tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />He he ahloh thih liata chi hiepa cha a châ. Bie cha thei ta, châhrasala khizaw hmo pachâna nata hneirôna tlaichhaina ta bie cha disao ta, pathei leipa ta a y tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lei phapa liata chi hiepa deikua cha, bie cha thei ta a pahno thaipa a châ. Thei pathei ta, thokha a lie za kha, thokha a lie sycharu nata thokha a lie sythôh ta a pathei tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama hnohta pakhona bie hropa reih heih ta, “Vârâh khinarâh cha chyhsa ta a lyu liata chi phapa a hiepa nata pakhopa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />A chyhsazy amâ mô chhôh ta, a chariahpa a vy ta, sâh hry liata sâh pakheipa hie ta, sie syulyu ha ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chizy cha vaw laiseih ta, a suh a vaw tao nahta, sâh pakheipazy chhao cha a vaw lâ hra ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lyu hneituhpa chakaotuhpazy a vy ei ta, a hnohta, ‘Pâpuh, na lyu liata chi phapa ma na hie vei? Kheihtazie ta sâh pakheipazy he a vaw pua thlâh haw?’ tah ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ano ta ama hnohta, ‘Chariahpa ta a vaw taopa a châ chuh,’ tah ta. Chakaotuhpazy ta a hnohta, ‘Cha khiahta la, vawh sih la, kei phia ha awpa na khoh ma?’ tah ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ano ta, ‘Châ vei, sâh pakheipazy nama phiana liata sâhzy nama phia pâ pathlei aw na.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sâh hria daihti taih cha y khoh thlâh ha ei sala, sâh hria daihti liata hriatuhpazy hnohta, “Sâh pakheipazy kha pahmaoh tua u la, rao awpa ta a pia ta chahry u la, sâh deikua cha ei sawvâ liata pahmaoh teh u,” ei tah aw,’” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zisu ta pakhona bie hropa ama hnohta reih heih ta. “Vârâh khinarâh cha chyhsa ta âhrâ chi hmô kha lyu liata a pariepa hawhta a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Âhrâ chi cha chi zydua liata chi chyh chaipa châ ta, châhrasala a vaw laiseih tita cha, chicheipa zydua hlâta lai chai ta, thokô a vaw châ tyh. Chatanachata vâ pavawzy a vy ei ta, a chiahzy liata bu ama tu tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zisu ta pakhona bie hropa ama hnohta reih heih ta, “Vârâh khinarâh cha chanô ta thinô la ta, viahdie saikhua miathôh liata pabu ta a zydua ta a thyu khai hapa hawhta a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cha hmo zydua cha Zisu ta zawpizy hnohta pakhona biezy hmâpa ta reih ta. Pakhona bie hmâ leipa ta ama hnohta bie a reipa y vei.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cha hmo cha hrohsopa ta, “Pakhona biezy hmâpa ta ei pakah â aw na ta, Hmo nyupazy ei phuah aw, Khizaw y tua no tawhta nyu hapazy cha,” tahpa ta a reipa kha a vaw tlô thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zisu ta zawpizy cha siesai ta, o liata a ngia ta, a pachupazy ano lâ a vy ei ta, a hnohta, “Lyu liata sâh pakheipa pakhona bie kha miah chhopasia teh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zisu ta a chhy ta, “Chi phapa a hietuhpa cha Chyhsa Sawchapawpa a châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Lyu cha khizaw châ ta, chi phapa cha khinarâh sawzy ama châ. Sâh pakheipazy cha moleipa sawzy châ ei ta,
  </para>
  <para style="p">
    <verse number="39" style="v" />âmo a hietuhpa chariahpa cha ahripa a châ. Sâh hria daihti cha daihti chhâna châ ta, hriatuhpazy cha vâlyuhchâpazy ama châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Sâh pakheipazy cha pahmaohpa ta mei liata raopa ama châpa hawhta, daihti chhâna liata a châ hra aw.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chyhsa Sawchapawpa ta a vâlyuhchâpazy tuah aw ta, moleina a patlôsatuhpa zydua nata hmo pha leipa a taotuhpa zydua cha, a khinarâh tawhta la papua aw ta,
  </para>
  <para style="p">
    <verse number="42" style="v" />moleipazy cha patina meihô liata ama thy aw. Cha liata chana nata hâh chariehna a y aw.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chyhsa siapazy deikua cha, ama Paw khinarâh liata noh hawhta ama khaih aw. Nakhaoh a hneipa ta thei mawh sy.
  </para>
  <para style="p">
    <verse number="44" style="v" />“Vârâh khinarâh cha lyu liata ryubyh nyupa chyhsa pakha ta hmô ta, nyu heih ta, a ly ngaitapa ta sie ta, a hneina zydua zuah ta, cha lyu cha a chaleipa hawhta a châ.
  </para>
  <para style="p">
    <verse number="45" style="v" />“Vârâh khinarâh cha sôdaohpa ta taikuh lôsôhpa a tluapa hawhta a châ heih.
  </para>
  <para style="p">
    <verse number="46" style="v" />Taikuh lôsôh ngaitapa miakha a hmô nahta, sie ta a hneipa zydua zuah ta a chaleipa hawhta a châ.
  </para>
  <para style="p">
    <verse number="47" style="v" />“Vârâh khinarâh cha tilaipi liata sao paraipa, nga chi to a aopa hawhta a châ.
  </para>
  <para style="p">
    <verse number="48" style="v" />Sao cha a bie nahta, nga patutuhpazy ta ngiahkâ lâ a daophi ei ta, a tyuh ei ta, nga phapazy cha hrâbyh liata soh ei ta, a chhiepazy deikua cha ama thy tyh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Cha hawhna chata daihti chhâna liata a y hra aw. Vâlyuhchâpazy a zu aw ei ta, moleipazy cha mosiapazy tawhta pahrua aw ei ta,
  </para>
  <para style="p">
    <verse number="50" style="v" />moleipazy cha patina meihô liata ama thy aw. Cha liata chana nata hâh chariehna a y aw.
  </para>
  <para style="p">
    <verse number="51" style="v" />“Cha hmo zydua cha nama pahno thai khai ma?” tah ta. Âmo ta a hnohta, “Eima pahno,” tah ei ta.
  </para>
  <para style="p">
    <verse number="52" style="v" />Zisu ta ama hnohta, “Chavâta vârâh khinarâh châta pachusapa ryhpa pachutuhpa maih cha, o hneituhpa ta a ryubyh tawhta hmo thiehpa nata hmo parohpa a thao papuapa hawhta a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="53" style="v" />Cha pakhona biezy a rei khai nahta, Zisu cha cha su tawhta pua ta.
  </para>
  <para style="p">
    <verse number="54" style="v" />A khih kei tlô ta, amâ pakhyna o liata âmo cha pachu ta, ama noâh ngaita ta, “He chyhsa heta khataih tawhta ma he sona nata hmotaotheinazy he a hnei tly?
  </para>
  <para style="p">
    <verse number="55" style="v" />He chyhsa he zôthaipa sawchapawpa kha châ vei ma? A nô chhao Mâri ama tahpa kha châ vei ma? A unawhzy chhao Zâmie, Zawsi, Saimaw nata Zudâh zy châ veih ei ma?
  </para>
  <para style="p">
    <verse number="56" style="v" />A sietanôzy chhao eima hnohta y khai thlâh ha veih ei ma? He chyhsa heta, khataih tawhta ma he hmo zydua he a hmô tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="57" style="v" />Ano cha chhyh thai leipa ei ta. Zisu ta ama hnohta, “Hrohsopa cha a khih nata a chhôhkha liata tah leipa ta la, palyupalihna hlao leipa ta y beih vei,” tah ta.
  </para>
  <para style="p">
    <verse number="58" style="v" />Amâ ngiapâ leipa vâta, cha liata hmonoâhpa hluhpi tao vei.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha daihti liata, Kâlili râh ryureituhpa Herawda ta Zisu thâtih cha thei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />A chakaotuhpazy hnohta, “Cha chyhsa cha Bâtituhpa Zawhâna kha a châ. Athihpa hry tawhta pathyu heihpa a châ chuh. Chavâta hmonoâhpa taotheina ano liata a ypa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Herawdâ ta a unawhpa Phili lapinô Herawdi vâta Zawhâna cha patu ta, chahry ta patâhna o liata a vaw khô hapa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawhâna ta a hnohta, “He chanô na hnei awpa he ryhpa ta pasaih vei” tahpa ta a chho tyhpa vâta, patu ta a patâhpa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Herawda ta Zawhâna cha thie awpa khoh ta, châhrasala zawpi ta hrohsopa ta ama pachâ vâta, zawpi riah chipa ta thie ngâh leipa ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Herawda pina noh vaw tlô ta, alykheituhpazy hmiakô liata Herawdi sawchanônô ta lâh ta, cha chata Herawda cha palysa kaw ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hiapa maih pie awpa ta bie a taih ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />A nô ta a pasyupa hawhta, Herawda hnohta, “Bâtituhpa Zawhâna luh beikoh ta na vaw pie teh,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abei cha a pachârôh kaw ta, châhrasala a bietai vâta nata a hruapazy vâta, Herawdi sawchanônô hiapa cha pie awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyhsa tuah ta, Zawhâna luh cha patâhna o liata kei pataisa ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />A luh cha beikoh ta vaw cheih ei ta, laihsanô cha pie ei ta, ano ta a nô lâ vawkhei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha khai tawhta Zawhâna pachupazy a vy ei ta, a ri cha la ei ta, ama pabu haw. Sie ei ta, cha thâtih cha Zisu kei chho ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zisu ta Zawhâna thâtih cha a thei nahta, cha su tawhta pua ta, ano dei ta balyh ta sie ta, su dâhthlohpa lâ pangai ta. Cha thâtih cha zawpi ta ama pahno nahta, khihzy tawhta phei ta siepa ta ano cha pazi ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngiahkâ lâ a pua nahta, zawpi hluhpi hmô ta, âmo cha a thapasa ngaita ta, ama hry liata tlâhleipazy patlâh ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zâlâ a vaw châ nahta, a pachupazy ano lâ a vy ei ta, a hnohta, “Su dâhthlohpa liata y tlôh pi ta, zâlâ ha ta, nie awpa a chalei awpa ta zawpizy he khihzy lâta tahmâ pasiesa teh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zisu ta, “Ama sie awpa byuh vei. Nâmo ta nie awpa pie teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Âmo ta a hnohta, “Viahchhâ tlâ pangawh nata ngasa miano dei leipa ta cha, he liata khâpa hmah hnei ma pi,” tah ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta, “Cha cha kei lâ vaw cheih teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zawpizy cha sibiepa chô liata a tyuh awpa ta biepie ta, viahchhâ tlâ pangawh nata ngasa miano cha la ta, avâ lâ moh ta, byhnâ aw ta. Chatawhcha viahchhâ cha eichheih ta a pachupazy hnohta pie ta, pachupazy ta zawpizy cha rai ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ama zydua ta nie ei ta, ama rih bie khai ta. Nie laibâhpa chhao hrâbyh hmo hrawh hleino tlai a huah ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />A niepa zydua cha chanô nata hawtizy rei leipa ta, chapaw pitlohpa sai ta sâh pangawh rachhôh ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zawpizy a pasiesa chhôh ta, a pachupazy cha balyh ta haosâ lâ pasiesa chhielie ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zawpizy liahsa a pasiesa khai tawhta, ano dei ta thlahchhâ awpa ta tlâh lâ kiah ta. Zâlâ taihta Zisu cha ano dei ta cha liata y thlâh ha ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cha daihti liata cha, balyh chhao ngiahkâ tawhta â hlapi sie ha ta. Thlih ta a supa vâta, tichatlaopa ta balyh cha thata phaoh pahai ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zâ vaina ei palihna liata, tilaipi chô liata phei ta siepa ta a pachupazy lâ a vy ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pachupazy ta tipo chô liata phei ta a siepa ama hmô nahta, chi ngaita ei ta, “Thlahmihpa a châ huh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu ta âmo cha thlai bie a vaw chho ta, ama hnohta, “Thlalôhpa ta y teh u, keima na ei châ, chi khah u,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pity ta a hnohta, “Abeipa, nâma na châ khiahta cha, ti chô liata nâma lâ a vy awpa ta bie na pie teh,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta, “A vy châh chi,” tah ta. Pity cha balyh tawhta thlai pua ta, Zisu lâ pangaipa ta ti chô liata sie ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Châhrasala thlihpipa a hmô nahta, chi ngaita ta, a pamôh pathao ha ta, “Abeipa, na pachha teh,” tahpa ta awh ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zisu ta a ku thlai kei pazawh ta, Pity cha patu ta, a hnohta, “Hy nâ, ngiapâ chyhpa, khazia nâ lôh vei?” tah ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Balyh liata amâ ngia nahta, thlih cha a chalih ha ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Balyh liata a ypazy a vy ei ta, ano cha a chhy ei ta, a hnohta, “Khazohpa Sawchapawpa na vaw châ hmeiseih tlai na,” tah ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chatawhcha haosâ lâ kiah ei ta, Kenesare râh kei tlô ei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cha su liata chyhsazy ta ano a châ tahpa ama pahnopa nahta, a chheipâh râh chyhsa zydua bieta ei ta, tlâhleipa zydua ano lâ a vaw chhi ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />A poh pai chhâ hria awpa ta Zisu cha a haw ei ta, a hriapa maihta tlâh lymâ ei ta.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Phârisaihzy nata ryhpa pachutuhpazy cha, Zerusale tawhta Zisu lâ a vy ei ta, a hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Khazia na pachupazy ta machâzy taozietyhpa ama parao tly? Pati ama nie chy ta ama ku a si veih ei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu ta a chhy ta, ama hnohta, “Khazia nâmo chhao ta nama taozietyhpa a tlychakapa ta Khazohpa biepiepa nama parao?
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazohpa ta, ‘Na nô nata na paw palyupalih teh,’ tah ta, ‘A nô tlyma, a paw tlyma a reipachhietuhpa cha a thi thlyu awpa a châ,’ a tah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nâmo deikua ta, ‘Ahy rai a nô tlyma, a paw tlyma hnohta, “Keima tawhta baona na hmô awpa vyuhpa cha Khazohpa hnohta ei pie haw,”
  </para>
  <para style="p">
    <verse number="6" style="v" />a tahpa maih cha, hmopiepa ta a paw tlyma, a nô tlyma, a palyupalih awpa byuh khao vei,’ nama tah tyh. Nama taozietyhpa a tlychakapa ta, Khazohpa bie cha hraoleipa ta nama tao haw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nâmo, phapakheipazy saih u, nama yzie kyh liata Isai ta,
  </para>
  <para style="p">
    <verse number="8" style="v" />“‘He phopi heta, Ama hmao ta na palyupalih ei ta, Ama pathipalôh ta deikua einâ hla kaw ei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsapa biepiepazy cha, Biezyhpa hawhta pachu ei ta, Hraoleipa ta einâ chhy ei,’ tahpa ta â do ngaitapa ta a vaw chhochhielie haw,” tah ta
  </para>
  <para style="p">
    <verse number="10" style="v" />Chatawhcha zawpizy ano lâ awpakhy ta, ama hnohta, “Nathlie u la, pahno teh u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pakah liata a ngiapa ta chyhsa papuapalei leipa ta, pakah tawhta a puapa ta chyhsa a papuapalei tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha khai tawhta a pachupazy a vy ei ta, a hnohta, “Cha bie cha Phârisaihzy ta thei ei ta, ama palôh a tlâh lei kaw tahpa na pahno ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zisu ta a chhy ta, ama hnohta, “Tho to ei Paw vârâh liata a ypa ta a loh leipa maih cha phiapa a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Âmo y ta y thlâh ha ei sa. Chhituhpa mochaopazy ama châ. Mochaopa ta mochaopa a chhihtha khiahta cha, khaohtlô liata hmaohkhata ama tla aw,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pity ta a hnohta, “Cha pakhona bie yzie cha miah chhopasia teh,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zisu ta, “Nâmo chhao taihta a yzie pahno to veih ei chi ma?
  </para>
  <para style="p">
    <verse number="17" style="v" />Pakah liata a ngiapa cha pavyh lâ palâh ta, lyupâh puana lâta a pua tyh tahpa pahno veih ei chi ma?
  </para>
  <para style="p">
    <verse number="18" style="v" />Châhrasala pakah tawhta a puapa cha, pathipalôh tawhta a kaw puapa a châpa vâta, cha tlai chata chyhsa a papuapalei tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Moleina pachâna, lianycheina, apheina, apatlana, paruna, haipa bie reipa nata reipachhiena zy he palôh tawhta a kaw puapa a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chazy chata chyhsa a papuapalei tyh. Ku a si leipa ta pati niepa ta chyhsa papuapalei vei,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cha su tawhta Zisu cha pua ta, Tyre nata Sidaw bia liata a ngia ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha râh liata a ypa Kâna chanô pakha a vy ta, “Hy Abeipa, Dâvi Sawchapawpa, na ngiachhie teh. Ahripa ta ei sawchanô patu ta thata a pasa,” tahpa ta awh ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Châhrasala Zisu ta kawh kha hmahta a chhy leipa ta. A pachupazy a vy ei ta a hnohta, “Pasiesa ha mah y, miah a awsao laih ngâ thlâh haw,” tahpa ta a haw ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu ta, “Izarei phopi mietaku aleipazy hnoh dei ta tuapa ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Châhrasala chanô cha a vy ta, Zisu hmiakô liata a bôh ta, a hnohta, “Abeipa, na bao mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zisu ta a chhy ta, “Sawzy viahchhâ chhu ta, izy piepa cha hmo yzie châ vei,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chanô ta, “Abeipa, â do na. Châhrasala izy chhao ta ama zibeipa tlâhkhai tawhta azôhpa a tlapazy cha ama nie tyh hra mâh tâh,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zisu ta chanô cha a chhy ta, a hnohta “Hy chanô, nâ ngiapâna thatlô rimâ cha! Na khopa hawhta na chô liata vaw tlô mawh sy,” tah ta, cha dawh lia tlai ta a sawchanô cha tlâh ha ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu cha, cha su tawhta pua ta, Kâlili Tipo kiah tlô ta, tlâh lâ kiah ta, cha liata a tyuh ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zawpi hluhpi a hnohta a vy ei ta, pheisypazy, mochaopazy, pihpasipazy, reih pathlie theileipazy nata pasana hropa a hneipa hluhpi a phei thaby liata vaw soh ei ta, âmo cha patlâh lymâ ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Reih pathlie theileipazy ta reih pathlie ei ta, pihpasipazy tlâh ei ta, pheisypazy phei ta sie ei ta, mochaopazy ta ama hmô thei hapa zawpizy ta ama hmô nahta, ama noâh ngaita ta, Izarei Khazohpa cha reithai ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zisu ta a pachupazy aw ta, ama hnohta, “Zawpizy he tahmâ noh thôh tlai ei hnohta y ha ei ta, nie awpa khâpa hmah ama hnei leipa vâta, ei ngia eina chhie ngaita ei. Nodipa ta âmo pasiesa awpa hra cha, lâpi liata ama panao pathlei awpa vâta khoh leipa na ta,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pachupazy ta a hnohta, “He zie zydua zawpi rih pabie nawpa ta, he su dâhthlohpa liana heta kheihta ma viahchhâ eima hmô thei aw?” tah ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zisu ta ama hnohta, “Viahchhâ tlâ khazie nama hnei?” tah ta. Âmo ta, “Tlâ sari nata nga dipa chyhta eima hnei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zisu ta zawpizy cha alei liata a tyuh awpa ta biepie ta,
  </para>
  <para style="p">
    <verse number="36" style="v" />viahchhâ tlâ sari nata ngasazy cha la ta, alyna bie a rei khai nahta, eichheih ta, a pachupazy hnohta pie ta, pachupazy ta zawpizy cha rai ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ama zydua ta nie ei ta, ama rih bie khai ta. Nie laibâhpa azôhpa chhao hrâbyh hmo sari tlai a huah ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />A niepa zydua cha chanô nata hawtizy rei leipa ta, chapaw pitlohpa sai ta sâh palih ama châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Zawpizy a pasiesa khai tawhta, balyh liata kiah ta, Mâkadâ râh lâ sie ha ta.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Phârisaihzy nata Saduasizy a vy ei ta, ano pasia nawpa ta vârâh tawhta ngiana pahmôsa awpa ta hiah ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zisu ta âmo cha a chhy ta, “Zâlâ a vaw châ nahta, avâ a saih khiahta cha, ‘Noh a pha aw,’ tah ei chi ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />mydi ta avâ saih ta a panoh khiahta cha, ‘Tanoh la avâ a suah aw,’ nama tah tyh. Avâ yzie chhopasiana pahno ei chi ta, daihti ngianazy deikua cha pahno thei veih ei chi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chhâ moleipa nata apheipazy ta ngiana tlua tyh ei ta, châhrasala Zawna ngiana dei leipa ta cha, ama hnohta ngiana rai piepa châ aw vei,” tah ta. Âmo cha puasai ta, sie syulyu ha ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pachupazy cha haosâ lâ tlô ei ta, viahchhâ a phao awpa my ha ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zisu ta ama hnohta, “A hrohrua u la, Phârisaihzy nata Saduasizy thinô liata a vaih teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pachupazy ta, “Viahchhâ a vaw phao leipa pi ta,” tah ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zisu ta cha kyh cha a pahno nahta, “Ngiapâ chyhpa saih u, khazia ma viahchhâ nama hnei leipa kyh nama reih?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pahno to veih ei chi ma? Chyhsa sâh pangawh châta viahchhâ tlâ pangawh a daih ta, a laibâhpa hrâbyh khazie ma namâ huah tahpa kha a thei thlâh ha veih ei chi ma?
  </para>
  <para style="p">
    <verse number="10" style="v" />Chyhsa sâh palih châta viahchhâ tlâ sari a daih ta, a laibâhpa hrâbyh khazie ma namâ huah tahpa chhao kha a thei thlâh ha veih ei chi ma?
  </para>
  <para style="p">
    <verse number="11" style="v" />Viahchhâ kyh nama hnohta reih va na tahpa khazia nama pahno to vei tly? Phârisaihzy nata Saduasizy thinô liata a vaih teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chatanachata viahchhâ thinô liata a vaih awpa ta a chhopa ei châ leipa ta, Phârisaihzy nata Saduasizy pachuna liata a vaih awpa kyh tlao a châzie pahno ha ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zisu cha Philipi Kaisaria bia a vaw tlô nahta, a pachupazy hnohta, “Chyhsazy ta Chyhsa Sawchapawpa he ahy na a châ ama tah?” tahpa ta hiahri ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Âmo ta, “Thokha ta Bâtituhpa Zawhâna a châ, cha tah ei ta; thokha ta Elaizâh a châ, cha tah ei ta; thokha ta Zeremiah tlyma hrohsopa ahy tlyma a châ, ama cha tah,” tah ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zisu ta ama hnohta, “Cha khiahta la, nâmo zaw ahy a châ eina tah ei chi?” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Saimaw Pity ta, “Mesia, Khazohpa hrohpa Sawchapawpa na châ,” tahpa ta a chhy ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta a hnohta, “Saimaw, Zawna sawchapawpa, na nohlao na! Sapa nata thisaih ta a cha pahnosapa châ leipa ta, ei Paw vârâh liata a ypa ta a cha pahnosapa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chavâta ei cha chho, nâ cha Pity na châ. He lôpanô chô liana heta ei Awnanopa padua aw na ta, Athihkhih chhikaozy ta pahnie aw vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vârâh khinarâh châhbizy cha pie aw na ta, alei liata na chahrypa maih, vârâh liata chahrypa châ aw ta, alei liata na pathlâpa maih, vârâh liata pathlâpa a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zisu ta Mesia a châ tahpa cha ahy hmah chho lei awpa ta pachupazy cha â ipa ta zikyu a râ ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cha rakha tawhta cha Zisu ta a pachupazy hnohta Zerusale lâ a khy awpa nata machâzy, theihthai beizy nata ryhpa pachutuhpazy ta pasa thata ama pataosa awpa kyh nata, ama thie awpa nata noh thôh noh ta pathyupa ta a y awpa kyh zy reih pathao ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pity ta Zisu cha anano ta a chhi ta, ra ta, a hnohta, “Abeipa, Khazohpa ta pasaih khah sy! Cha cha na chô liata tlô cheita khah sy,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu cha Pity lâ a heih ta, a hnohta, “Sâtâ, ei hnôh lâ y teh! Ei châta ahluana na châ he. Khazohpa hmozy pachâ leipa chi ta, chyhsapa hmozy tlao na pachâ via he,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu ta a pachupazy hnohta, “Ahy rai eina zi khoh khiahta cha, anosasyh a paky sala, a kraws a piapa ta na zi mawh sy.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahy rai a hrona pabohsa a chhuahpa cha, a hrona pahlei aw ta; keima vâta a hrona a pahleipa deikua cha, a hrona a hmô heih aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chyhsa ta khizaw he a pôhpalôhpa ta hnei sala, a thlahpa a pahlei tlôh khiahta cha, a châta khâpa a phahnai aw? Cha leipa chhao ta, chyhsa ta a thlahpa vyuhpa ta khâpa a pie aw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Chyhsa Sawchapawpa cha a Paw rônahna ta a vâlyuhchâpazy chhaota a zu tlôh aw ta, chyhsa to ama hmotaopa hawhta a thô aw ei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hmeiseihta ta ei cha chho ei, he liata a duahpazy hry liana heta, Chyhsa Sawchapawpa he a khinarâh liata â zupa ama hmô hlâlei cha, thina a padi lei awpa ama y,” tah ta.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Noh charu khai tawhta Zisu ta Pity nata Zâmie nata a unawhpa Zawhâna zy a chhi ta, âmo cha anano ta tlâh sâhpa lâ kiakhei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama hmiakô liata a hmia a vaw nano ha ta, a hmia cha noh hawhta khaih ta, a chysiazy chhao khaihpa hawhta vaw dieh ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawsi nata Elaizâh ama hnohta a vaw luah ei ta, Zisu cha bie a chho ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pity ta Zisu hnohta, “Abeipa, he liata eima ypa he a pha na. Na khoh khiahta cha, he liata byureih miathôh, nâma châta miakha, Mawsi châta miakha, Elaizâh châta miakha ei tu aw,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />A rei hai no tlai chata, meihdo râhpa ta âmo cha vaw khu ta, meihdo tawhta ao vaw pua ta, “He he ei Sawchapawpa kho ngaitapa, a chô liata ei ly ngaitapa a châ, a bie nathlie teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha bie cha pachupazy ta ama thei nahta, â khu lâta pao ei ta, chi ngaita ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zisu a vy ta âmo cha hria ta, ama hnohta, “Thyu teh u, chi khuh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kaw moh ei ta, Zisu dei leipa cha ahy hmah hmô leipa ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlâh tawhta ama za chô hai nota, Zisu ta ama hnohta, “Chyhsa Sawchapawpa he athihpazy hry tawhta a thyu heih hlâlei cha, aluahna nama hmôpa kha ahy hmah chho khuh vy,” tahpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pachupazy ta a hnohta, “Khazia ryhpa pachutuhpazy ta Elaizâh â vy tua awpa na a châ ama tah tly?” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu ta a chhy ta, ama hnohta, “Elaizâh cha a vy tua tlai aw ta, ato zydua a paduapathi aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Châhrasala ei cha chho ei, Elaizâh cha a vy ha ta, ano cha pahno leipa ei ta, a chô liata ama khozie hawhta ama taopa kha a châ. Cha hawhna hra chata Chyhsa Sawchapawpa chhao he ama ku liata pasa a tao aw,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chatanachata Bâtituhpa Zawhâna kyh ama hnohta a reipa a châzie pachupazy ta pahno ha ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawpi yna ama za tlô nahta, chyhsa pakha ano lâ a vy ta, a hmiakô liata pakhu paneih ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />a hnohta, “Abeipa, ei sawchapawpa ngiachhie mah y. Riapamiepa châ ta, thata pasa taopa ta, ei hluhpi mei liata pao ta, ei hluhpi ti liata a pao.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na pachupazy lâ a vaw chhi na ta, âmo ta patlâh thei leipa ei ta,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta a chhy ta, ama hnohta, “Hy ngiapâleipa nata chhorupa chhâ saih u, khachâ ma nama hnohta ei y aw? Khachâ ma ei cha pachâ thai aw ei? Kei lâ a vaw chhi teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta ahripa cha ra ta, hawtipa chhôh tawhta pua ta, hawtipa cha thlai vaw tlâh ha ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pachupazy cha âmo dei ta Zisu lâ a vy ei ta, a hnohta, “Khazia keimo ta thlahpa puapa eima papua thei vei?” tah ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zisu ta ama hnohta, “Namâ ngiapâna a chyhpa vâta a châ. Hmeiseihta ta ei cha chho ei, âhrâ chi hmô kha tie chhâ ta ngiapâna nama hnei khiahta la, he tlâh hnohna heta, ‘He tawhta hao lâ a pasie teh,’ tah u la, â pasie thlâh ha aw. Nama châta tao thei leipa khâpa hmah y aw vei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Châhrasala he hawhpa he cha, thlahchhâna nata kâhvileipa deita ta papua theipa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kâlili râh liata ama ypakhy nota, Zisu ta ama hnohta, “Chyhsa Sawchapawpa he chyhsazy ku liata hlâpa ta a y daihmâ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thie aw ei ta, noh thôh noh ta pathyupa ta a y aw,” tah ta. Chavâta pachupazy cha ama pachârôh ngaita ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kâpynia ama tlô nahta, Achhyna o chhie kheituhpazy Pity hnohta a vy ei ta, “Nâmo pachutuhpa he chhie pie tyh hra vei ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ano ta, “A pie tyh,” tah ta. Pity cha o chhôh lâ â ngia nahta, Zisu ta ano cha bie a chho tua ta, a hnohta, “Saimaw, kheihta na pachâ? Lei beizy ta ahy tawhta ma leimâ nata chhiezy ama khei tyh? Ama sawzy tawhta ma, ahropazy tawhta?” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pity ta, “Ahropazy tawhta,” tah ta. Zisu ta a hnohta, “Cha khiahta la, sawzy cha amâ ei ha chuh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Châhrasala ama palôh pachhie lei nawpa ta, tilaipi lâ vawh la, keipa kei ny la, nga na paao tua chaipa la la, a pakah cha-ia la tâkâ tlaw no hmô aw chi ta, cha cha la la, keima nata nâma chhie châta ama hnohta pie mah y,” tah ta.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha nota pachupazy Zisu lâ a vy ei ta, a hnohta, “Vârâh khinarâh liata ahy ma a rônah chai aw?” tah ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zisu ta hawti pakha aw ta, ama hry liata paduasa ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />ama hnohta, “Hmeiseihta ta ei cha chho ei, nama yzie pananopa ta, hawtizy hawhta nama châ vei khiahta la, vârâh khinarâh a ngia cheita aw veih ei chi.
  </para>
  <para style="p">
    <verse number="4" style="v" />He hawti hawhta areisipa cha vârâh khinarâh liata a rônah chai aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ahy rai ei moh ta he hawhpa hawti pakha chhao a lypa cha, keima nâ lypa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Châhrasala nâ ngiapâtuhpa hawtizy hry liata pakha chhao a pahluasapa cha, a rao liata charona lô lai ngaitapa paaopa ta, tilaipi athupa liata pathla syulyupa a châta a pha via aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Molei reipasaonazy vâta khizaw he a hu a po kaw dia! Reipasaona cha a y awpa tlai châ ta, châhrasala reipasaona a paysatuhpa cha a hu a po na!
  </para>
  <para style="p">
    <verse number="8" style="v" />Na ku tlyma, na phei tlyma ta a cha pamoleisa khiahta cha, tai la, thy ha mah y. Ku no tlyma, phei no tlyma hneipa ta, chhâzaw mei liata thypa na châ awpa hlâta cha, pihpasipa ta tlyma, pheisypa ta tlyma, hrona liata a ngiapa na châta a pha via.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na mo ta a cha pamoleisa khiahta la, thaoh la, thy syulyu ha mah y. Mo no hnei ta hrienasu mei liata thypa ta na y awpa hlâta cha, mo kha hnei ta hrona liata a ngiapa na châta a pha via.
  </para>
  <para style="p">
    <verse number="10" style="v" />“He hawtitazy hry liata pakha chhao mopakhô lei awpa ta a sohsi teh u. Vârâh liata ama vâlyuhchâpazy ta ei Paw vârâh liata a ypa hmia khâ ama sai tyh tahpa ei cha chho ei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chyhsa Sawchapawpa cha leidiapazy pachha awpa ta a zupa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kheihta nama pachâ? Chyhsa pakha ta mietaku za kha hnei sala, pô kha lei ha sala, sychaki nata pô chakizy cha tlâhzy liata siesai chypa ta, a leipa cha tlua aw vei ma?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmeiseihta ta ei cha chho ei, a hmô heih khiahta cha, a lei leipa sychaki nata pô chaki hlâta, cha pô kha vâna chata tlao â ly via aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha hawhna hra chata, he hawtitazy hry liata pakha leidia awpa chhao he, nama Paw vârâh liata a ypa khozie châ vei.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Na unawhpa ta na chô liata hmo a parao khiahta cha, ano lâ charei la, ano nata nâma deita pahnopa ta â do leina cha chho mah y. A cha nathlie khiahta cha, na unawhpa cha na pahnie hapa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />A cha nathlie vei khiahta cha, bie to pahnotuhpa pano tlyma, pathôh tlyma pakah liata pa-ipa ta a y thei nawpa ta, chyhsa hropa pakha tlyma, pano tlyma, na hnohta a chhi mah y.
  </para>
  <para style="p">
    <verse number="17" style="v" />Âmo chhao cha a nathlie khoh vei khiahta cha, Awnanopa chho mah y. Awnanopa chhao taihta a nathlie khoh vei khiahta cha, ano cha na châta Zenitai nata chhiekheituhpa hawhta pachâ mah y.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Hmeiseihta ta ei cha chho ei, alei chô liata nama chahrypa maih vârâh liata chahrypa châ aw ta, alei chô liata nama pathlâpa maih vârâh liata pathlâpa a châ hra aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ei cha chho via ei, alei chô liata chyhsa pano ta rei a paraohpa ta hmo ama hia khiahta cha, ei Paw vârâh liata a ypa ta a taopa aw ei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pano tlyma, pathôh tlyma, ei moh ta amâ hmaohna maihta ama hry liata ei y tyh,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pity cha Zisu lâ a vy ta, a hnohta, “Abeipa, ei unawhpa ta ei chô liata hmoparao ngâ thlâh ha sala, ei khazie taih ei ngiahthai aw? Ei sari taih ma?” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zisu ta a hnohta, “Ei sari taih cha tah va na, ei sari su sysari taih tlao ei cha tah.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Chavâta vârâh khinarâh cha abei ta a chakaotuhpazy liata a sôh kyh pasia â chhuahpa nata pakho theipa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />A sôh kyh cha a pasia nahta, chyhsa pakha talent thy kha a bâhpa a hnohta a vaw chhi ei ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pie awpa a hnei leipa vâta, ano nata a lapinô nata a sawzy zuah sala, a leibâh cha thô awpa ta a zibeipa ta biepie ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chakaotuhpa cha a pakhu paneih ta, a zibeipa cha a naoh ta, a hnohta, ‘Zawh rie nâ ngiah chy mah y, a zydua ta ei cha thô khai aw,’ tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />A zibeipa ta ngiachhie ngaita ta, chakaotuhpa cha pathlie ta, a leibâh cha a ngiahthai ha ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cha chakaotuhpa cha pua ta, a chakaolâhpa pakha, ano liata dinâri za kha a bâhpa hmô ta, patu ta, a rao rie ta, a hnohta, ‘Na leibâh kha na thô teh,’ tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />A chakaolâhpa cha a pakhu paneih ta, a hnohta, ‘Zawh rie nâ ngiah chy mah y, a zydua ta ei cha thô khai aw,’ tahpa ta a haw ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Châhrasala khoh leipa ta, a leibâh a pie khai hlâlei patâhna o liata khô ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />A chakaolâhpazy ta a hmotaopa cha ama hmô nahta, ama vâ a sâh ngaita ta, a hmotaopa zydua cha ama zibeipa kei chho ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />A zibeipa ta ano cha aw ta, a hnohta, ‘Nâ, chakaotuhpa moleipa! Einâ hawpa vâ chi ta na leibâh zydua châ ngiahthai na ta,
  </para>
  <para style="p">
    <verse number="33" style="v" />nâma zawh ei châ ngiahpa hawhna khata, nâ chhao ta na chakaolâhpa cha zawh nâ ngiah hra awpa châ vei ma?’ tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />A zibeipa cha a hiehâh ngaita ta, a leibâh zydua a pie khai hlâlei riethei pataosa awpa ta patâhna o hyutuhpazy hnohta a hlâ haw.
  </para>
  <para style="p">
    <verse number="35" style="v" />Palôh hmeiseihpa ta nama unawhzy namâ ngiahthai vei khiahta cha, ei Paw vârâh liatapa ta, cha hawhna chata nama zydua chô liata a tao aw,” tah ta.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha biezy cha a rei khai nahta, Zisu cha Kâlili râh tawhta pua ta, Zawdâh haosâ Zudia râh a ngia ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zawpi hluhpi ta ano cha zi ei ta, cha liata âmo cha patlâh lymâ ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Phârisaihzy ano lâ a vy ei ta, ano pasia nawpa ta, “Chapaw ta khâpa kyh rai ta a lapinô ma awpa ryhpa ta a pasaih ma?” tahpa ta hiahri ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta a chhy ta, “Âthaona liata âmo taotuhpa khata, chapaw nata chanô ta âmo cha tao ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />ama hnohta, ‘Cha vâna chata chapaw ta a nô nata paw siesai aw ta, a lapinô a patu aw, chatanachata panozy cha pôhpa miakha ama châ ha aw,’ tahpa bie kha rei beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatanachata pano châ khao leipa ei ta, pôhpa miakha tlao ama châ haw. Chavâta Khazohpa ta a pazaopa cha, chyhsa ta pachhaih khah sy,” tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Âmo ta a hnohta, “Cha khiahta cha, khazia Mawsi ta lapinô cha mana châ piepa ta pasiesa theipa a châzie biepiepa a tao?” tah ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zisu ta ama hnohta, “Mawsi khata nama palôh kuhchhapa vâta nama lapinôzy ma a cha pasaipa ei a châ. Âthaona liata la, cha hawhta châ vei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ei cha chho ei, ahy rai apheina vâta châ leipa ta, a lapinô ma ta, chanô hropa a hneipa maih cha â pheipa a châ. Ma chiehpa chanô a hneipa chhao â pheipa a châ hra,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pachupazy ta a hnohta, “Lapinô kyh liata chapaw duahmo cha, cha hawhta a châ khiahta cha, dyhchâ leipa a pha via,” tah ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu ta ama hnohta, “He bie he chyhsa to ta a pyh thei veih ei. Ama hnohta piepazy deita ta amâ py theipa bie a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thaidao ta a pihpazy y ei ta, chyhsa ku ta hrilyupazy y hra ei ta, vârâh khinarâh châta âmosasyh ta hrilyupa ta â taopazy ama y hra. A pyh theipa ta, cha bie cha a pyh mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hawtizy chô liata a ku pahnieh ta thlahchhâpa awpa ta, chyhsa thokha ta hawtizy cha Zisu lâ a vaw chhi ei ta. Châhrasala pachupazy ta âmo cha ra ei ta,
  </para>
  <para style="p">
    <verse number="14" style="v" />Zisu ta, “Hawtizy kei lâ pavysa teh u, dytha khah u, vârâh khinarâh cha he hawhpa hawtizy eih châ tlôh ta,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chatanachata hawtizy chô liata a ku pahnieh ta, cha su tawhta sie ha ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chyhsa pakha Zisu lâ a vy ta, a hnohta, “Pachutuhpa, chhâzaw hrona ei hnei thei nawpa ta khâpa hmo phapa ma ei tao aw?” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu ta, “Khazia hmo phapa kyh eina hiahri chi? Phapa cha pakha deita a y. Hrona liata nâ ngia khoh khiahta cha, biepiepazy zyh mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ano ta a hnohta, “Kheihawhpa biepiepazy maw?” tah ta. Zisu ta, “Liany na cheih awpa châ vei, Nâ phei awpa châ vei, Na paru awpa châ vei, Haipa ta chyhsa na leih awpa châ vei,
  </para>
  <para style="p">
    <verse number="19" style="v" />Na nô nata na paw palyupalih teh, tahpa nata Nâma kyh nâ pachâpa hawhta na vaih kyh na pachâ awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thyutliapa ta Zisu hnohta, “Cha zydua cha ei tao khai haw, tao awpa khâpa ei hnei via chy?” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta a hnohta, “Phapaki na khoh khiahta la, sie la, na hneipa zydua zuah la, dyhchhiepazy hnohta pie teh, chatanachata vârâh liata ryu na hnei aw. Cha khai tawhta a vy la, na zi mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha bie cha thyutliapa ta a thei nahta, sôh hluhpi a hneipa a châpa vâta, pachârôhpa ta sie ha ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu ta a pachupazy hnohta, “Hmeiseihta ta ei cha chho ei, chyhsa hneirôhpa châta la, vârâh khinarâh a ngia awpa a ru kaw tlai na.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ei cha chho chanei ei, chyhsa hneirôhpa Khazohpa khinarâh â ngia awpa hlâta la, râraoseihpa chiephoh khaoh liata a ngia awpa tlao a nao via,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cha bie cha pachupazy ta ama thei nahta, ama noâh ngaita ta, a hnohta, “Cha hawhta châ sala, ahy ma pachha a châ thei aw tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zisu ta âmo cha moh ta, ama hnohta, “Cha hmo cha chyhsapa châta la, tao thei rimâ awpa châ vei. Khazohpa châta deikua cha, ato tao theipa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pity ta a chhy ta, a hnohta, “Moh teh, keimo he ato siesaipa ta cha zi pi ta, khâpa eima hmô aw?” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zisu ta ama hnohta, “Hmeiseihta ta ei cha chho ei, Chyhsa Sawchapawpa he khizaw thiehpa liata a rônahna beidyuchhai liata â tyu tita, nâmo, nâ zituhpa sahlaozy chi he, beidyuchhai miahrawh hleino liata a tyuh aw ei chi ta, Izarei chi hrawh hleinozy chô liata ryu nama reih aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahy rai ei moh vâta ozy, unawhzy, sietanôzy, paw, nô, sawzy nata râhzy a siesaipa cha, a lie za kha ta hmô aw ei ta, chhâzaw hrona ama to aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Châhrasala hmiatuapa hluhpizy cha hnôhchaipa châ aw ei ta, hnôhchaipazy cha hmiatuapa ama châ aw.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Vârâh khinarâh cha, lyu hneituhpa ta mydi ta pua ta, a kre sadô liata a hria awpa hriatuhpazy a tluapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Noh kha ta dinâri miakha hlao awpa ta, hriatuhpazy nata amâ paryh khai tawhta, âmo cha kre sadô lâ pasiesa ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dawh chakipa liata pua heih ta, sôdaohna su liata a y chakhyh thlâh hapazy hmô ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />ama hnohta, ‘Nâmo chhao kre sadô lâ sie hra teh u, â phuhpa ta hria hlao ei cha pie aw ei,’ tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chatanachata sie ei ta. Dawh hrawh hleinopa nata dawh thôhpa liata pua heih ta, a tao tuapa hawhna khata tao heih ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zâlâ dawh pangawhpa liata pua heih ta, chyhsa a y chakhyhpazy hmô heih ta, ama hnohta, ‘Khazia he liata noh y ta nama y chakhyh thlâh haw?’ tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Âmo ta a hnohta, ‘Ahy hmahta rai hria awpa miah ama pie leipa vâta a châ,’ tah ei ta. Ano ta ama hnohta, ‘Nâmo chhao kre sadô lâ sie hra teh u,’ tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />A vaw zâlâ nahta, kre sadô hneituhpa ta raihria mohôhtuhpa hnohta, ‘Hriatuhpazy aw la, ama hria hlao pie teh, a hnôh chaipa tawhta a thaopa ta a hmiatua chaipa taihta na pie aw ei,’ tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dawh pangawhpa tawhta a pahriasapazy amâ vy nahta, dinâri miakha sai hmô ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />A pahriasa tuachaipazy amâ vy nahta, a hluh via hmô awpa ta a pangiasa ei ta, châhrasala âmo chhao dinâri miakha chyu hmô hra ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama hria hlao ama dao nahta, lyu hneituhpa cha paphôh thlu ei ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />a hnohta, ‘A hnôh chai ta a hriapazy he dawh kha chhôh deita hria ei ta, keimo noh y ta hriapasa ta, nohsa a daohpazy nata kheihtazie ta miah na pakho thlâh haw?’ tah ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama hry liata pakha hnohta, ‘Viasa, na chô liata khâpa hmah tao chhei va na, dinâri miakha hlao awpa ta eimâ paryhpa kha châ vei ma?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nâma eih kha la la, sie thlâh ha mah y. Nâma ei cha piepa hawhta, a hnôhchaipa chhao he ei pie khoh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei eih châ ta, kei eih cha ei khozie hawhta tao thei va na ma? Ei riaphapa ma na hiatlia kaw?’ tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha hawhna chata hnôh chaipazy cha hmiatua chaipazy châ aw ei ta, hmiatua chaipazy cha hnôh chaipazy ama châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zisu cha Zerusale lâ a khy nota, lâpi liata pachupa pahrawh hleinozy cha anano ta a chhi ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Pachâ teh u, Zerusale lâ eima khy hai hih. Chyhsa Sawchapawpa he theihthaipa hyutuhpazy nata Ryhpa pachutuhpazy ku liata hlâpa châ aw ta, âmo ta thailei pachâsa aw ei ta, ama thie aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pasipasawh awpa nata chhei awpa nata khaipâ awpa ta Zenitaizy ku liata hlâpa châ aw ta, a noh thôhna noh ta pathyupa ta a y aw,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chatawhcha Zebâdi sawchapawzy nô cha, a sawchapawzy chhaota Zisu lâ a vy ta, Zisu cha a naoh ta, khokheina hiah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta a hnohta, “Khâpa na khoh?” tah ta. Ano ta Zisu hnohta, “Ei sawchapaw pano he, na khinarâh liata na chachâh lâ pakha, na chavei lâ pakha amâ tyuh thei nawpa ta biepie mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zisu ta âmo cha a chhy ta, “Nama hiapa pahno veih ei chi. Ei nyu do awpa nama doh thei aw ma?” tah ta. Âmo ta, “Eima doh thei aw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu ta ama hnohta, “Ei nyu cha nama doh thei ngyu aw, châhrasala ei chachâh lâ nata ei chavei lâta a tyuh awpa cha, kei ta ei pie awpa châ leipa ta, ei Paw ta â chhuahdypazy châta a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pahrawhzy ta cha thâtih cha ama thei nahta, unawh panozy chô liata ama palôh châ lei kaw ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zisu ta a pachupazy cha aw ta, ama hnohta, “Zenitaizy chô liata ryureituhpazy ta cha, ama chô liata a bei kaw ei ta, ama beimachâzy ta ama chô liata bie ama hnei ngaita tahpa nama pahno.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nâmo hry liata deikua cha, cha hawhta a châ awpa châ vei. Nama hry liata ahy rai chyhsa rônahpa châ a khohpa cha, nâmo châ chakaotuhpa ta a y awpa a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nama hry liata ahy rai hmiatua chaipa châ a khoh khiahta cha, nama sei ta a y awpa a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chyhsa Sawchapawpa tlai chhao he, chyhsa ta ama chakaopa châ awpa ta a zupa châ leipa ta, chakaotuhpa châ awpa nata chyhsa hluhpi chatlai nawpa ta a hrona pie awpa ta a zupa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zerikô tawhta pua ei ta, zawpi hluhpi ta ano cha zi ei ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mochaopa pano lâpi kiah liata a tyuh thlâh hapazy ta, Zisu ta a vaw chapia ei tahpa ama pahno nahta, “Abeipa, miah ngiachhie mah y, Hy Dâvi Sawchapawpa!” tahpa ta thata awh ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zawpi ta âmo cha ra ei ta, a chalih awpa ta chho ei ta. Châhrasala, “Abeipa, miah ngiachhie mah y, Hy Dâvi Sawchapawpa!” tahpa ta thata awh via rili ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zisu cha a duah ta, âmo cha aw ta, ama hnohta, “Khâpa cha taopa awpa ma nama khoh?” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Âmo ta a hnohta, “Abeipa, eima mo pavâ awpa eima khoh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zisu ta âmo cha ngiachhie kaw ta. Chatanachata ama mozy cha hria ta, thlai hmô thei ha ei ta, Zisu cha ama zi pâ haw.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zerusale amâ hnia nahta, Ôli tlâh liata Bethaphâ khih lâ vawh ei ta. Zisu ta pachupa pano tuah ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />ama hnohta, “Nama hmia lâta khih lâ hao vawh u la, alâ buhpa, a taw chhaopa hmô aw ei chi ta, pathlâ u la, kei lâ a vaw chhi muh vy.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kheih hawhpa bie rai nama hnohta a reihpa ama y khiahta cha, ‘Abeipa ta a khoh,’ tah aw ei chi ta, alâzy cha thlai a cha pie aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cha hmo cha hrohsopa ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Zaio sawchanô hnohta chho teh u, ‘Moh teh, na beipa cha nâ lâta â vy hai; Areisipa châ ta, Alâ kiah ta, Alâ taw kiahpa ta â vy huh,’” tahpa ta a reipa kha a vaw tlô thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pachupazy cha vawh ei ta, Zisu ta a chhopa hawhta tao ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Alâ nata a taw cha a vaw chhi ei ta, ama pohzy ta a ky padia ei ta, Zisu ta alâ cha kiah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zawpi hluhpi ta lâpi liata ama pohzy phaw ei ta, ahropazy ta thobuhzy chhawhpa ta lâpi liata phaw hra ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hmia lâta a siepa nata a hnôh lâta a pazipa zawpizy ta, “Dâvi Sawchapawpa hnohta Haozanâ! Abeipa moh ta a vypa cha reithaipa ta y mawh sy! Chônôchaipa liata Haozanâ y mawh sy!” tahpa ta awh ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zerusale â ngia nahta, a thâtih ta khihpi zydua chalyu ta, “He chyhsa he ahy ma a châ tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zawpizy ta, “He he hrohsopa Zisu, Kâlili râh Nâzari khihpa a châ,” tah ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zisu cha Achhyna o liata a ngia ta, cha liata hmo a zuahpa nata a chaleipa zydua papua ta, tâkâ rituhpazy tlâhkhai nata pivaw zuahtuhpazy dyuchhai chati pathlah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama hnohta, “‘Ei o cha thlahchhâna o tahpa a châ aw’ tahpa ta ropa châ ta, nâmo deikua ta parutuhpazy lôpu ta nama tao haw,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Achhyna o liana chata mochaopazy nata pheisypazy ano lâ a vy ei ta, âmo cha patlâh ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hmonoâhpa a taopazy nata hawtipazy ta Achhyna o liata, “Dâvi Sawchapawpa hnohta Haozanâ!” tahpa ta ama awhpa cha, theihthai beizy nata Ryhpa pachutuhpazy taama hmô nahta, ama palôh châ lei kaw ta,
  </para>
  <para style="p">
    <verse number="16" style="v" />a hnohta, “He sahlaozy biereipa he na thei ma?” tah ei ta. Zisu ta ama hnohta, “Ei thei mâh tâh; “‘Hawsaihzy nata sâhpi pazy haipazy pakah tawhta, Reithaina nâ chhuahdy haw,’ tahpa bie reih beih veih ei chi ma?” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Âmo cha siesai ta, khihpi tawhta Bethâni lâ sie ta, cha liata a rie ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />A mylâ mydi ta khihpi lâ â liena lâpi liata, Zisu cha a nodi kaw ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lâpi kiah liata theiku kô hmô ta, kei pangai ta, a hna dei leipa ta cha khâpa hmah hmô leipa ta. Theiku kô hnohta, “Chhâzaw ta pathei khao khah y,” tah ta. Theiku kô cha thlai uah pâ ha ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cha hmo cha pachupazy ta ama hmô nahta, ama noâh ngaita ta, “Kheihtazie ta ma theiku kô he thlai a uah thlâh ha tly?” tah ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zisu ta a chhy ta, “Hmeiseihta ta ei cha chho ei, a lôh leina hnei leipa ta namâ ngiapâ khiahta la, theiku kô chô liata taopa he nama tao thei hrapa dei châ leipa ta, he tlâh hnohna chhao heta, ‘A pasie la, tilaipi liata a thy teh,’ nama tah khiahta cha, nama reipa hawhta a y aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Namâ ngiapâ khiahta cha, thlahchhâna ta nama hiapa maih nama hmô aw,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu cha Achhyna o liata a ngia ta, a pachu hai no ta, theihthai beizy nata khitlâh machâzy ano lâ a vy ei ta, a hnohta, “Khâpa biehneina ta ma he hmozy he na tao? Ahy ma he biehneina he châ pie?” tah ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zisu ta âmo cha a chhy ta, “Kei chhao ta hmo miakha ei cha hiahri hra aw ei. Cha cha eina chho khiah ei chi ta cha, kei chhao ahy biehneina ta ma he hmozy he ei tao tahpa ei cha chho aw ei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zawhâna bâtina kha khataih tawhta â vypa ma a châ? Avâ tawhta ma, chyhsapa tawhta maw?” tah ta. A chhohia ei ta, “‘Avâ tawhta,’ tah mawh sih la, ‘Cha khiah, khazia a bie nama zo vei?’ miah tah aw,
  </para>
  <para style="p">
    <verse number="26" style="v" />‘Chyhsapa tawhta,’ tah mawh sih la, zawpi chi tlôh pi, chyhsa zydua ta Zawhâna kha hrohsopa ta ama pachâ khaipa châ tlôh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zisu cha a chhy ei ta, “Pahno ma pi,” tah ei ta. Zisu ta ama hnohta, “Kei chhao ahy biehneina ta ma, he hmozy he ei tao tahpa cha chho hra aw veih ei na,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Cha khiahta la kheihta ma nama pachâ? Chyhsa pakha ta sawchapawpa pano hnei ta. Pakha lâ vawh ta, a hnohta, ‘Ei sawchapawpa, sie la tanoh kre sadô liata rai kei hria mah y,’ tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chyhsa chata a chhy ta, ‘Sie aw va na,’ tah ta. Châhrasala taviapa ta a palôh a vaw nano ta, sie ha ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sawchapaw hropa lâ vawh ta, a hmiatuapa hnohta a chhopa hawhna khata kei chho ta. Ano ta a paw hnohta, ‘Y, ei zibeipa, ei sie aw,’ tah ta, châhrasala sie tlôh leipa ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cha pano liata ahy ma a paw khopa a tao?” tah ta. Âmo ta, “A hmiatuapa,” tah ei ta. Zisu ta ama hnohta, “Hmeiseihta ta ei cha chho ei, chhiekheituhpazy nata âzuahnôzy ta Khazohpa khinarâh ama châ ngia khâh aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zawhâna kha siana lâpi a chhihpa ta nâmo lâ a vy ta, châhrasala zo veih ei chi. Chhiekheituhpazy nata âzuahnôzy deikua ta la ama zo. Nâmo la siana lâpi nama hmôpa chhao ta, ro khoh leipa ei chi ta, zo khoh veih ei chi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Pakhona bie hropa nathlie teh u. Lyu a hneipa chyhsa pakha y ta, kre sadô tao ta, diahpai ta dôh ta, kre saohna khaoh chao ta, o sâhpa sa ta, a kre sadô cha lyutaopazy hnohta thlyu hlao awpa ta pie ta, râh hro lâ sie ha ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />A thei lyu daihti â daih nahta, ano tovyuh la awpa ta thlyuhlaotuhpazy lâ a chakaotuhpazy tuah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thlyuhlaotuhpazy ta a chakaotuhpazy cha vaw patu ei ta, pakha tu ei ta, pakha thie ei ta, pakha alô ta vawh ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />A hmiatuapa hlâta hluh viapa ta chakaotuhpa hropazy tuah heih ta. Âmo chhao cha hmiatuapazy ama taopa hawhna khata vaw tao heih ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />A chhâna ta, ‘Ei sawchapawpa he cha ama za aw,’ tahpa ta a sawchapawpa cha âmo lâ tuah ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Châhrasala thlyuhlaotuhpazy ta a sawchapawpa ama hmô nahta, a chhohia ei ta, ‘He chyhsa he ryutotuhpa a châ hih, a vy teh u, thie sih la, a ryu a la ei suh u,’ tah ei ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />A sawchapawpa cha patu ei ta, kre sadô tawhta papua ei ta, ama thie haw.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kre sadô hneituhpa â vy tita, thlyuhlaotuhpazy cha kheihta a tao aw ei?” tah ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Âmo ta a hnohta, “Cha moleipazy cha ama rie patheisapa ta thie aw ta, kre sadô cha, a thei â daihna maihta, ano tovyuh a pie lymâ awpa thlyuhlaotuh hropazy hnohta a pie aw ei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zisu ta ama hnohta, “Biehrai liata, “‘O satuhpazy alô kho leipa cha, A ki lô a vaw châ haw; Cha cha Abeipa taopa châ ta, Eima mo liata â ngia ngaita,’ tahpa bie reih beih veih ei chi ma?
  </para>
  <para style="p">
    <verse number="43" style="v" />“Chavâta ei cha chho ei, Khazohpa khinarâh cha nâmo tawhta lapa châ aw ta, a pathei awpa phopi hnohta piepa a châ aw.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ahy rai cha alô chô liata a paopa cha keichheih aw ta, alô ta a vipa cha a pazao khai aw,” tah ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Theihthai beizy nata Ryhpa pachutuhpazy ta pakhona bie a reipazy cha ama thei nahta, âmo thâtih a reih tahpa pahno ei ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Zisu cha patu a chhuah ei ta, châhrasala zawpi pachâ ta hrohsopa hawhta ama hmôpa vâta, zawpi chipa ta patu ngâh leipa ei ta.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu ta pakhona bie hmâpa ta ama hnohta bie reih heih ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Vârâh khinarâh cha abei ta a sawchapawpa châta ahneina kyhchhi a taopa nata pakho theipa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kyhchhi pati nie awpa ta a hruapazy aw awpa ta a chakaotuhpazy tuah ta, châhrasala a vy khoh tlâ leipa ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chakaotuhpa hropazy tuah heih ta, ama hnohta, ‘Hruapazy hnohta kei chho u la, “Kyhchhi cha â mâ haw, ei viahchao tôhpazy nata ei sahroh thawhpazy thie na ta, ato â mâ haw, kialao nie awpa ta a vy teh u,” tahpa ta kei chho teh u,’ tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Châhrasala vaw uasa leipa ei ta, tlao sie ha ei ta, pakha a lyu lâ sie ta, ahropa a sôdaohna lâ sie ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa hropazy ta a chakaotuhpazy cha vaw patu ei ta, noza chhih ngaitapa ta taopa ta, thie ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abei cha a hiehâh ngaita ta, a pheisaihzy tuah ta, cha liany cheituhpazy cha pahleipadia ei ta, ama khih chhao rao ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chatawhcha a chakaotuhpazy hnohta, ‘Kialao â mâ haw, hruapazy deikua cha a nie tlâh châ veih ei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chavâta lâlaizy lâta pua u la, nama hmôpa maih kialao nie awpa ta kei hrua teh u,’ tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chakaotuhpazy cha lâlaizy lâta pua ei ta, ama hmôpa maih, chyhsa chhiepa chhao, chyhsa phapa chhao pakhy ei ta, ahneina o cha kyhchhi a hlaopazy ta bie ha ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Abei cha kyhchhi a hlaopazy moh awpa ta a vaw ngia ta, cha liata chyhsa pakha ahneina chysia a tobi leipa hmô ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />a hnohta, ‘Viasa, kheihtazieta ahneina chysia a tobi leipa ta he liata nâ vaw ngia thlâh haw?’ tah ta. Cha chyhsa cha a thlih thlâh ha ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abei ta a chakaotuhpazy hnohta, ‘A ku nata phei chahry u la, khôtho lâ zohna liata thy teh u. Cha liata chana nata hâh chariehna a y aw,’ tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hruapazy hluh kaw ei ta, atlyhpazy deikua ama chyhta,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Phârisaihzy cha pua ei ta, a bie reipa liata ama paao thei nawpa ta a byh ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama pachupazy nata Herawda py liata chyhsazy ano lâ tuah ei ta, âmo ta a hnohta, “Pachutuhpa, chyhsa dopa na châpa pahno pi ta, Khazohpa lâpi â dopa ta pachu chi ta, chyhsa pachâna la hlei leipa chi ta, chyhsa pôraoh nata hmisâ zy moh va chi tahpa eima pahno.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kheihta na pachâ, miah chho teh, Kaisarâ lâ chhie piepa he ryhpa ta a pasaih ma, pasaih vei?” tah ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta amâ chhuahpa pha leipa pahnopa ta, ama hnohta, “Nâmo, phapakheipazy saih u, khazia eina pasia ei chi?
  </para>
  <para style="p">
    <verse number="19" style="v" />Chhie châta chei awpa tâkâ cha na vaw pahmô teh u,” tah ta. Dinâri miakha ano lâ vaw cheih ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zisu ta ama hnohta, “He he ahy nothlahpa nata moh ma a châ?” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Âmo ta, “Kaisarâ nothlahpa,” tah ei ta. Zisu ta ama hnohta, “Kaisarâ hmozy cha Kaisarâ pie u la, Khazohpa hmozy cha Khazohpa pie teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha bie cha ama thei nahta, ama noâh ngaita ta, ano cha puasaipa ta sie ha ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cha noh liata, thyuheihna y vei a tahpa Saduasizy ano lâ a vy ei ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />a hnohta, “Pachutuhpa, Mawsi ta, ‘Chyhsa ta saw hnei leipa ta thi sala, a unawhpa ta a lapinô cha hnei aw ta, a unawhpa châta chi a pathla awpa a châ,’ tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eima hry liata unawh pasari y ei ta, a uhthei chaipa ta lapinô hnei ta, thi ha ta, chipathla a hnei leipa vâta, a lapinô cha a unawhpa to awpa ta y ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />A panona nata a pathôhna chhao ta saw hnei leipa ta thi ha hra ei ta, a pasarina taihta cha hawhta châ ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ama zydua ta ama thi khai nahta, chanô chhao cha thi ha hra ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thyuheihna liata unawh pasarizy hry liana chata ahy lapinô ma a châ aw? Ama zydua ta ama lapinô ta hnei ha tlôh ei ta,” tah ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zisu ta âmo cha a chhy ta, “Biehrai nata Khazohpa hmotaotheina nama pahno leipa vâta nama pachâpasipa a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thyuheihna liata cha, nôvah ahneina y aw vei, vârâh liata vâlyuhchâpazy hawhta ama y khai aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Athihpa thyuheihna kyh liata Khazohpa ta nama hnohta,
  </para>
  <para style="p">
    <verse number="32" style="v" />‘Kei he Abarahâ Khazohpa, Aisika Khazohpa nata Zakaw Khazohpa ei châ,’ tahpa ta a reipa kha reih beih veih ei chi ma? Khazohpa cha athipa Khazohpa châ vei, ahrohpa Khazohpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zawpizy ta cha bie cha ama thei nahta, a bie pachupa cha noâh tah ngaita ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zisu ta Saduasizy a padei hapa kyh Phârisaihzy ta ama thei nahta, a hmaohpakhy ei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ama hry liata dâhthaipa pakha ta ano pasia nawpa ta bie miakha hiahri ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Pachutuhpa, Ryhpa liana heta kheihawhpa biepiepa he ma a rônah chai?” tah ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zisu ta a hnohta, “Abeipa na Khazohpa cha na pathipalôh tlokhuh ta, na thlahpa tlokhuh ta nata na pachâna tlokhuh ta kyh na pachâ awpa a châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />He he biepie rônahpa nata hmiatua chaipa a châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />A mianona cha he he a châ: Nâma kyh nâ pachâpa hawhta na vaih kyh na pachâ awpa a châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />He biepiepa miano liana heta Ryhpa bie nata hrohsopa bie zydua â pahnieh khai,” tah ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Phârisaihzy amâ hmaohpakhy nona chata, Zisu ta âmo cha bie hiahri ta,
  </para>
  <para style="p">
    <verse number="42" style="v" />“Mesia cha kheihta nama pachâ? Ahy sawchapawpa ma a châ?” tah ta. Âmo ta a hnohta, “Dâvi Sawchapawpa,” tah ei ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Zisu ta ama hnohta, “Cha khiah, kheihtazie ta Dâvi kha Thlahpa ta pareisapa ta, ano cha Abeipa a tah tly? Dâvi ta,
  </para>
  <para style="p">
    <verse number="44" style="v" />“‘Abeipa ta ei Beipa hnohta, “Na chariahzy na phei ry liata ei soh khai hlâlei cha, Ei chachâh lâta a tyuh mah y,”’ a tahpa kha.
  </para>
  <para style="p">
    <verse number="45" style="v" />Dâvi ta ano cha Abeipa a tah tlôh khiahta cha, kheihta ma a sawchapawpa a châ thei aw?” tah ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ahy hmahta kawh kha chhao a chhy thei leipa ei ta, cha noh tawhta cha, bie hropazy chhao a hiahri ngâhpa y khao veih ei.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu ta zawpizy nata a pachupazy hnohta bie reih ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ryhpa pachutuhpazy nata Phârisaihzy cha Mawsi dyuchhai liata a tyuhpa ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chavâta ama cha chhopa maih cha tao u la, zyh lymâ teh u. Ama hmotaopa hawhta deikua tao hra khuh vy. Pachu ei ta, châhrasala hrokhei hlei veih ei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Phaohri ngaitapa tao ei ta, chyhsa ngiatlâh liata ama pahnieh tyh. Âmo deikua ta cha, ama ku paro ta chhao pasie khoh veih ei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama hmotaopa zydua chyhsa hmô awpa ta ama tao tyh. Ama ku liata amâ kypa nata ama khiriena zy paphia ei ta, ama poh pai pasisa ei ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />kyhchhina liata su pha chaipazy, pakhyna o liata atyuna pha chaipazy,
  </para>
  <para style="p">
    <verse number="7" style="v" />sôdaohna su liata anaohna nata chyhsa ta pachutuhpa ama tahpa zy ama pasô ngaita.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nâmo deikua la, pachutuhpa tahpa ta bi awpa châ veih ei chi. Pachutuhpa cha pakha deita nama hnei. Nama zydua ta unawh sai nama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Alei chô liana heta ahy hmah nama paw ta aw hra khah u. Paw cha vârâh liata a ypa pakha deita nama hnei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chhituhpa tahpa ta awpa châ hra aw veih ei chi. Chhituhpa cha pakha deita nama hnei. Krista cha nâmo chhituhpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nama hry liata rônah chaipa cha, nâmo châ chakaotuhpa ta a y awpa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahy rai a pasâhsapa maih panawhpa châ aw ei ta, a panawhpa maih palyupalihpa ama châ aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Nâmo, ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Chyhsazy châta vârâh khinarâh khaw ei chi ta, nâmo hra a ngia tlôh leipa ei chi ta, chyhsazy a ngia awpa pasai pyly veih ei chi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Nâmo, ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Nôhmeizy o nie khai ei chi ta, a pakheipa ta a pasi pi thlah nama chhâ tyh. Chavâta thailei pachâsa via pachaipa nama châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Nâmo, Ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Ngiapâtuhpa pakha tao awpa ta, tilaipi nata tlâh padôpa ta sie ei chi ta, ngiapâtuhpa a vaw châpa nahta, ano cha nâmo topa lie no ta hriena su a to awpa saw ta nama tao tyh.
  </para>
  <para style="p">
    <verse number="16" style="v" />“‘Chyhsa ta Achhyna o reipa ta bie â taih khiahta cha, a bietai ta chahry leipa ta, chyhsa ta Achhyna o liata ngôh reipa ta bie â taih khiahta deikua cha, a bietai ta a chahry,’ a tahtuhpa nâmo, chhituhpa mochaopazy saih u, nama hu a po na!
  </para>
  <para style="p">
    <verse number="17" style="v" />Nâmo, ahrupa mochaopazy saih u, kheihawhpa ma a rônah via? Ngôh ma, ngôh a pathaisatuhpa Achhyna o maw?
  </para>
  <para style="p">
    <verse number="18" style="v" />‘Chyhsa ta maisâh reipa ta bie â taih khiahta cha, a bietai ta chahry vei, chyhsa ta maisâh chô liata hmopiepa reipa ta bie â taih khiahta deikua cha, a bietai ta a chahry,’ nama tah heih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nâmo, mochaopazy saih u, kheihawhpa ma a rônah via? Hmopiepa ma, hmopiepa a pathaisatuhpa maisâh maw?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahy rai maisâh reipa ta bie â taihpa cha, maisâh nata a chô liata a ypa zydua reipa ta bie â taihpa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahy rai Achhyna o reipa ta bie â taihpa cha, Achhyna o nata cha liata a pahrâpa reipa ta bie â taihpa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahy rai vârâh reipa ta bie â taihpa cha, Khazohpa beidyuchhai nata a chô liata a tyuhpa reipa ta bie â taihpa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Nâmo, ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Pudinâzy, sysadizy, sykathuzy su hrawh su kha pie ei chi ta, Ryhpa peimawh viapa ryureina siapa, ngiachhiena nata ngâchhihna zy uasa veih ei chi. Ahropazy tao pâna chôta, chazy cha nama tao awpa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nâmo, chhituhpa mochaopazy saih u, thlohmiazy a thli ei chi ta, râraoseihpa a palâ tyhpa tlao nama châ he!
  </para>
  <para style="p">
    <verse number="25" style="v" />“Nâmo, ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Nyu nata beikoh zy a chô lâ pasi ei chi ta, a chhôh lâ deikua cha, karâhneina nata asohsi thei leina ta a bie.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nâ, Phârisaih mochaopa, nyu nata beikoh zy kha a chhôh lâ pasi ha tua mah y. Chatanachata a chô lâ chhao a pathaih thei aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Nâmo, ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Hlyu râhpa hniapa thlâ, a chô lâ a ngia ngaitapa ta a lâ ta, a chhôh lâ deikua cha athipa rureih nata pathaih leipa to ta a biepa nata namâ lyu.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khôtho lâ chyhsa mohmô liata a sia ngaitapa ta a lâ ei chi ta, nama chhôh lâ deikua cha, phapakheina nata Ryhpa papeisa leina ta a bie.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Nâmo, Ryhpa pachutuhpa nata Phârisaih phapakheipazy saih u, nama hu a po na! Hrohsopazy thlâ o sapa ta, chyhsa siapa thlâzy tobi ei chi ta,
  </para>
  <para style="p">
    <verse number="30" style="v" />‘Miah pathlatuhpazy chhâ liana kha a vaw y hrapa châ sih la, hrohsopazy thisaih palona liana kha a hlao hra aw ma pi,’ nama tah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cha bie chata hrohsopazy a thietuhpa sawzy nama châ tahpa nâmosasyh ta thailei namâ pachâsa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Châ pathlatuhpazy taopa kha tlao patlô lâlao teh u.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nâmo, parihzy saih u, nâmo, vâzi pathlazy saih u, hrienasu lâ sie awpa ta pachiana cha kheihta ma nama khôkhâh thei aw?
  </para>
  <para style="p">
    <verse number="34" style="v" />Chavâta hrohsopazy, chyhsa sopazy nata ryhpa pachutuhpazy ei cha vaw tuapa ei. Thokha thie aw ei chi ta, thokha nama khaipâ aw. Thokha cha namâ pakhyna ozy liata chhei aw ei chi ta, khi kha tawhta khi hro lâta nama taola laih lymâ aw.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chatanachata chyhsa siapa Abela thisaih tawhta supathaihpa nata maisâh likawh ta nama thiepa Berakia sawchapawpa Zekaria thisaih taih ta, alei chô liata chyhsa siapa thisaih palopa zydua thisaih maoh cha nama chô liata a vaw tlô aw.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hmeiseihta ta ei cha chho ei, he zydua he, he chhâ chô liata a vaw tlô aw.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Hy Zerusale, Zerusale, hrohsopazy thie chi ta, nâ lâta tuapazy alô ta a vawhsaotuhpa khihpi! Awhpanô ta a tachhihzy a mathlaw ry liata a pahmaohpa hawhta, na sawzy pahmaoh a chhuah tyh na ta, châhrasala khoh va chi!
  </para>
  <para style="p">
    <verse number="38" style="v" />Moh tua u, nama o cha roryhrapa ta siesaipa a châ ha hih.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ei cha chho ei, ‘Abeipa moh ta a vypa cha reithaipa ta y mawh sy,’ nama tah hlâlei cha, tahmâ tawhta na hmô khao aw veih ei chi,” tah ta.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu cha Achhyna o tawhta pua ta, a sie chy ta, Achhyna o sanazie ano chho awpa ta a pachupazy a vy ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Âmo cha a chhy ta, “He zydua he nama hmô ma? Hmeiseihta ta ei cha chho ei, he liata alô pachopazy he lô kha hmah pahlôh leipa ta pacho pathlah khaipa a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zisu Ôli tlâh liata â tyu thlâh ha nota, pachupazy âmo dei ta ano lâ a vy ei ta, “Miah chho teh, he hmozy he khati ta ma vaw tlô aw ta, nâ vy heihna nata daihti chhâna cha khati ta a châ aw?” tah ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu ta âmo cha a chhy ta, “Ahy hmahta ama cha dôvei lei nawpa ta a vaih teh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyhsa hluhpi ei moh ta a vy aw ei ta, ‘Mesia ei châ,’ tahpa ta, chyhsa hluhpi ama dôvei aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Adyuhnazy nata adyuhna bie pathâhpazy nama thei aw. Châhrasala thlazohpa ta y khah u. Cha zydua cha a vaw y awpa châ ta, chhâna deikua châ mâh aw vei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Phopi nata phopi a dyuh aw ei ta, khinarâh nata khinarâh amâ dyuh aw. Su hluhpi liata chakâhnazy tlô aw ta, alozy â sih aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha zydua cha sawzeih pasa athaona deita a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Riethei tao awpa ta cha patusa aw ei ta, cha thie aw ei ta, ei moh vâta phopi zydua ta ama châ hao aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chavâta chyhsa hluhpi amâ ngiapâna pahlei aw ei ta, âmo nata âmo a patusa aw ei ta, amâ hao raihrie aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hrohso pakheipa hluhpi vaw pua aw ei ta, chyhsa hluhpi ama dôvei aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Moleina papôhsapa a châ awpa vâta, chyhsa hluhpi kyhpachâna a dia aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Achhâna taihta a tao hualuapa cha pachhapa ta a y aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />He khinarâh thâtihpha he phopi to pahno awpa ta khizaw zydua liata chhopa châ aw ta, cha khai tawhta chhâna cha a vaw tlô aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Chatawhcha hrohsopa Dâniah reipa, roryhrana patlôsatuh pasichhihpa kha, su pathaihpa liata â duapa nama hmô aw. He bie a reihtuhpa ta a yzie pahno mawh sy.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha tina cha, Zudia râh liata a ypazy cha tlâhzy lâta a râ mawh ei sy.
  </para>
  <para style="p">
    <verse number="17" style="v" />O chô liata a ypa ta o chhôh liata hmo la awpa ta chô leipa sala,
  </para>
  <para style="p">
    <verse number="18" style="v" />lyu liata a ypa ta a poh la awpa ta kua heih khah sy.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cha nohzy liata chanô sawphaohpa nata hawsaih a pyh haipazy hupo awpa rimâ cha!
  </para>
  <para style="p">
    <verse number="20" style="v" />Namâ râ nawpa daihti cha chasipaw nota tlyma, pahânoh ta tlyma, a vaw tlô lei nawpa ta thlahchhâ teh u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cha daihti liata, riethei pasataona rarôh y ngaitapa y aw ta, cha hawhpa cha leilô pi daihti tawhta tahmâ taihta y beih leipa ta, khati ta hmahta y heih khao aw vei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha nohzy cha pachyusapa châ leipa sala, chyhsa ahy hmah a hrohpa y aw veih ei. Châhrasala atlyhpazy vâta, cha noh cha pachyusapa a châ aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Chyhsa ta nama hnohta, ‘Moh teh u, Mesia cha he liata a y!’ a tah khiahta tlyma, ‘Hao liata a y!’ a tah khiahta tlyma, zo khuh vy.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mesia pakheipazy nata hrohso pakheipazy vaw pua aw ei ta, ngiana nata hmonoâh rônahpazy ama tao aw. Tao theipa châ sala, atlyhpazy taih ama dôvei aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nathlie teh u, ei cha chho chhielie ei hih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chyhsazy ta nama hnohta, ‘Moh teh u, ano cha râhchawhpa liata a y,’ ama cha tah khiahta cha, pua leipa u la; ‘Chhôhpadâhpa chhôh chaipazy liata a y,’ ama cha tahpa chhao ta, zo hra khuh vy.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nochhi lâ tawhta dôhla vaw pathlie ta, notla lâ taihta a khaihpa hawhta, Chyhsa Sawchapawpa a vy heihna cha a châ aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sawhsawpa yna liata vâkhiehzy amâ hmaoh tyh.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Cha nohzy liata rietheipasana a y khaipata nahta, noh pazohsapa châ aw ta, thlâpâ khaih khao leipa aw ta, avâ tawhta awhsizy tla aw ta, avâ hmotaotheinazy cha chalyupa ta a y aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chatawhcha Chyhsa Sawchapawpa ngiana avâ liata a vaw lâ aw ta, alei liata chi to mâchhiesapa ta y aw ei ta, Chyhsa Sawchapawpa cha hmotaotheina nata rônah ngaitapa ta vâ meihdo chô liata â zupa ama hmô aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chiahmie paro ngaitapa chhaota a vâlyuhchâpazy tuah aw ta, âmo chata â tlyhpazy cha kaokih miapalih tawhta pakhy aw ei ta, avâ chy chhâna tawhta hiakha lâ chhâna taihta ama pakhy aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Theiku kô tawhta a chu teh u. A chhyh panyupa kaw paka ta, a hna a vaw thao khiahta cha, nopi â hnia haw tahpa nama pahno tyh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cha hawhna hra chata, cha hmo zydua cha nama hmô tita, Chyhsa Sawchapawpa cha a vaw hnia ha ta, chhikao thaby liata a y tahpa pahno teh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hmeiseihta ta ei cha chho ei, cha zydua a tlô paki khai hlâlei cha, he chhâ he lei aw vei.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lei nata vâ a lei aw, ei biezy deikua lei aw vei.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Châhrasala cha noh nata dawh cha, Paw dei leipa ta cha ahy hmahta pahno veih ei. Vârâh liata vâlyuhchâpazy chhao ta pahno leipa ei ta, Sawchapawpa chhao ta pahno vei.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chyhsa Sawchapawpa a vy heihna cha, Nôah hro nota yzie hawhna khata a châ aw.
  </para>
  <para style="p">
    <verse number="38" style="v" />Cha nohzy liata, tipaua vaw tlô hlâ, Nôah balyh liata â ngiana noh taihta niedopa ta y ei ta, nôpi nôvahzy amâ pakia.
  </para>
  <para style="p">
    <verse number="39" style="v" />Tipaua vaw tlô ta, ama zydua ta a pahlei khai hlâlei cha, khâpa hmah ama pahno leipa hawhna khata, Chyhsa Sawchapawpa avyheihna cha a châ aw.
  </para>
  <para style="p">
    <verse number="40" style="v" />Lyu liata chyhsa pano y aw ei ta, pakha lapa châ aw ta, pakha siesaipa a châ aw.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chanô pano ta sâh daih aw ei ta, pakha lapa châ aw ta, pakha siesaipa a châ aw.
  </para>
  <para style="p">
    <verse number="42" style="v" />Khâpa nota ma nama Beipa cha â vy aw tahpa nama pahno leipa vâta, a hrohruapa ta y teh u.
  </para>
  <para style="p">
    <verse number="43" style="v" />Châhrasala he he pahno teh u: Kheihawhpa zâ daihti liata ma parutuhpa â vy aw tahpa o hneituhpa ta pahno ha sala cha, a hrapa ta vaih aw ta, a o pangiasa aw vei.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chavâta nâmo chhao a mâ chiehpa ta y teh u, nama pangiasa leina daihti liata Chyhsa Sawchapawpa cha a vy tlôh aw ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />“Cha khiahta la chakaotuhpa ngâchhihpa nata sopa, a zibeipa ta a o liata hyutuhpa ta a raopa, ama nie awpa a daihtita liata a pie lymâ tyh awpa cha ahy ma a châ tly?
  </para>
  <para style="p">
    <verse number="46" style="v" />A zibeipa â vy tita, rai hria haipa ta a hmôpa chakaotuhpa cha a nohlao kaw aw dia.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hmeiseihta ta ei cha chho ei, cha chakaotuhpa cha a hneipa zydua chô liata hyutuhpa ta a tao aw.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chakaotuhpa moleipa deikua cha, a palôh liata, ‘Ei zibeipa cha charâ ta a vy bao aw vei,’ tahpa ta,
  </para>
  <para style="p">
    <verse number="49" style="v" />a chakaolâhpazy tu sala, sahma paripazy hnohta niedopa ta a y khiahta cha,
  </para>
  <para style="p">
    <verse number="50" style="v" />cha chakaotuhpa zibeipa cha, a mokhâh leina noh nata a pahno leipa dawh liata a vy aw ta,
  </para>
  <para style="p">
    <verse number="51" style="v" />chakaotuhpa cha hriechheih aw ta, phapakheipazy to awpa a patosa aw. Cha liata chana nata hâh chariehna a y aw.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Cha noh liata, vârâh khinarâh cha laihsakôpa pahrawh, ama meiôh a cheipa ta myuhneituhpa dy awpa ta a puapazy hawhta a châ aw.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama hry liata papangawh ahrupa châ ei ta, papangawh asopa ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahrupazy ta ama meiôh dei a chei ei ta, meiti a chei pâ leipa ei ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />asopazy deikua cha ama meiôhzy dei châ leipa ta, meiti ôhzy chhao a chei pâ ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Myuhneituhpa charâ ta â vy leipa vâta, ama zydua ta tlauahpa ta, a mô ha ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zâcho ta, ‘Moh teh u, myuhneituhpa cha â vy haw! Dy awpa ta pua teh u,’ tahpa ta awhpa pyu vaw y ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Laihsakôpazy cha thlai thyu ei ta, ama meiôh zy rao ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahrupazy ta a sopazy hnohta, ‘Nama meiti miah pie hra teh u, eima meiôhzy a thi haw,’ tah ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Asopazy ta a chhy ei ta, ama hnohta, ‘Keimo nata nâmo châta a daih aw vei, meiti zuahtuhpazy lâ vawh u la, tlao kei chalei teh u,’ tah ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chalei awpa ta ama vawh chhôh ta myuhneituhpa cha vaw tlô ha ta, a mâ chiehpazy cha ano nata kialao nie awpa ta a ngia ei ta, ochhi khaw ha ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha khai tawhta laihsakôpa hropazy kha a vy ei ta, a hnohta, ‘Abeipa, Abeipa, miah pahypa teh,’ tah ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Myuhneituhpa ta âmo cha a chhy ta, ‘Hmeiseihta ta ei cha chho ei, cha pahno veih ei na,’ tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />A noh nata dawh pahno tlôh leipa ei chi ta, chavâta a hrohrua teh u.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Vârâh khinarâh cha chyhsa ta râh hro lâ a sie chy ta, a chakaotuhpazy aw ta, a sôhzy a pavaosapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chakaotuhpa pakha hnohta talent miapangawh pie ta, ahropa hnohta miano pie ta, ahropa hnohta miakha a pie. Ama tao theipa rakha chyu ta pie ta, sie ha ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Talent miapangawh a vaotuhpa cha thlai sie ta, talent â vaopazy hmâpa ta sôh palie ta, talent miapangawh hropa papôhsa ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha hawhna hra chata talent miano a vaotuhpa chhao, talent miano papôhsa ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Talent miakha a vaotuhpa deikua cha sie ta, alei chao ta, a zibeipa tâkâ cha tlao nyu ha ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bohpi a châ tawhta, chakaotuhpazy zibeipa cha vaw tlô ta, a sôh a pavaosapazy pasia ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Talent miapangawh a pavaosapa a vy ta, talent hropa miapangawh vaw cheih ta, a hnohta, ‘Ei zibeipa, talent miapangawh eina pavaosapa chi kha, moh tua, talent hropa miapangawh ei papôhsa,’ tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />A zibeipa ta a hnohta, ‘Chakaotuhpa phapa nata ngâchhihpa, na tao pha na. Hmo chyhta chô liata ngâchhih chi ta, a hluhpi chô liata ei cha paysa aw. Na zibeipa alyna liata a ngia teh,’ tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Talent miano a pavaosapa chhao kha a vy ta, a hnohta, ‘Ei zibeipa, talent miano eina pavaosapa chi kha, moh teh, talent hropa miano ei papôhsa,’ tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />A zibeipa ta a hnohta, ‘Chakaotuhpa phapa nata ngâchhihpa, na tao pha na. Hmo chyhta chô liata ngâchhih chi ta, a hluhpi chô liata ei cha paysa aw. Na zibeipa alyna liata a ngia teh,’ tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Talent miakha a pavaosapa chhao kha a vy ta, a hnohta, ‘Ei zibeipa, nâ cha chyhsa chakhiehchariehpa châ chi ta, na tu leina liata tai chi ta, na hie leina liata chhao a hria tyhpa na châ tahpa ei pahno.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chavâta chi na ta, sie na ta, na talent kha alei liata ei nyu haw. Moh teh, na eih ualua ta na hmô heih hih,’ tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />A zibeipa ta a hnohta, ‘Nâ, chakaotuhpa moleipa nata thathipa! Ei tu leina liata hria tyh na ta, ei hie leina liata chhao ei tai tyh tahpa cha na pahno ma?
  </para>
  <para style="p">
    <verse number="27" style="v" />Cha hawhta a châ hnohkua cha, ei tâkâ kha sôhpalietuhpazy liata na vaw soh ha awpa châ ta, ei vaw tlô tita a pôhna chhaota ei hmô heih awpa mah a châ tâh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A talent miakhapa kha lapa u la, talent miahrawh a hneituhpa pie teh u.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahy rai a hneipa cha, pie baichhapa châ aw ta, a hluhpi a hnei aw. A hnei leipa deikua cha, a hnei chhôhpa chhao lapa a châ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chakaotuhpa phahnai leipa kha, khôtho lâ zohna liata thy teh u. Cha liata chana nata hâh chariehna a y aw,’ tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Chyhsa Sawchapawpa he a vâlyuhchâpa zydua chhaota rônah ngaitapa ta â zu tita, a rônahna beidyuchhai liata a tyuh aw ta,
  </para>
  <para style="p">
    <verse number="32" style="v" />a hmiakô liata phopi zydua a vypakhy aw ei ta, mietaku vaituhpa ta miezy hry tawhta mietakuzy a pahruapa hawhta, chyhsazy a pahrua aw ei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mietakuzy cha a chachâh lâta soh aw ta, miezy deikua cha a chavei lâta a soh aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abeipa ta a chachâh lâta a ypazy hnohta, ‘Ei Paw ta byhnâ a piepazy saih u, a vy u la, khizaw tao tua no tawhta khinarâh a chhuahdypa cha to teh u.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ei nodi ta, nie awpa na pie ei chi ta; ei dâhphi ta, do awpa na pie ei chi ta; khichhaipa châ na ta, na patlôsa ei chi ta;
  </para>
  <para style="p">
    <verse number="36" style="v" />thluahruapa ta y na ta, chysia na pie ei chi ta, tlâh leipa na ta, na vaih ei chi ta; patâhna o liata y na ta, eina tly ei chi,’ a tah aw ei.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mosiapazy chata a chhy aw ei ta, a hnohta, ‘Abeipa, khati ta ma nodipa ta cha hmô pi ta, nie awpa eima cha pie? Khati ta ma dâhphipa ta cha hmô pi ta, do awpa eima cha pie?
  </para>
  <para style="p">
    <verse number="38" style="v" />Khati ta ma khichhaipa ta châ hmô pi ta, eima o liata eima cha patlôsa? Khati ta ma thluahruapa ta cha hmô pi ta, chysia eima cha pie?
  </para>
  <para style="p">
    <verse number="39" style="v" />Khatita ma tlâh leipa ta tlyma, patâhna o liata tlyma cha hmô pi ta, eima cha tly?’ ama tah aw.
  </para>
  <para style="p">
    <verse number="40" style="v" />Abeipa ta âmo cha a chhy aw ta, ama hnohta, ‘Hmeiseihta ta ei cha chho ei, he ei unawhpa chyh chaipazy hry liata pakha chô liata nama taopa cha, ei chô liata a taopa nama châ,’ a tah aw ei.
  </para>
  <para style="p">
    <verse number="41" style="v" />“Cha khai tawhta a chavei lâta a ypazy hnohta, ‘Chhiesapa ta a ypa saih u, ahripa nata a lyuhchâpazy châta a chhuahdypa chhâzaw mei lâ na siesai teh u.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ei nodi ta, nie awpa na pie leipa ei chi ta; ei dâhphi ta, do awpa na pie leipa ei chi ta;
  </para>
  <para style="p">
    <verse number="43" style="v" />khichhaipa châ na ta, na patlôsa leipa ei chi ta; thluahruapa ta y na ta, chysia na pie leipa ei chi ta; tlâh leipa nata patâhna o liata ei y nota, na tly veih ei chi,’ a tah aw ei.
  </para>
  <para style="p">
    <verse number="44" style="v" />Âmo ta a chhy aw ei ta, a hnohta, ‘Abeipa, khati ta ma nodipa ta tlyma, dâhphipa ta tlyma, khichhaipa ta tlyma, tlâh leipa ta tlyma, patâhna o liata tlyma cha hmô pi ta, eima cha chakao vei?’ ama tah aw.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ano ta a chhy aw ei ta, ama hnohta, ‘Hmeiseihta ta ei cha chho ei, he chyhsa chyh chaipazy hryta pakha chô liata nama tao leipa cha, ei chô liata a tao leipa nama châ,’ a tah aw ei.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chazy cha chhâzaw hriena lâ sie aw ei ta, mosiapazy deikua cha, chhâzaw hrona lâ ama sie aw,” tah ta.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zisu ta cha hmo zydua cha a rei khai nahta, a pachupazy hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Noh no khai tawhta zawpakhô kyhchhi a vaw y awpa nama pahno. Chyhsa Sawchapawpa he khaipâ awpa ta patusapa a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha nota Theihthai Beichaipa Kaiphâ ama tahpa o liata theihthai beizy nata khitlâh machâzy a hmaoh ei ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />Zisu cha dôveipa ta patu ta, ama thie thei nawpa ta a pachia ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Châhrasala, “Kyhchhi chhôh ta la châ khah sy. Chataleipatala zawpi hry liata tymâna a y pathlei aw na,” tah ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zisu cha Bethâni liata phawhpa Saimaw o liata a y nota,
  </para>
  <para style="p">
    <verse number="7" style="v" />chanô pakha sathaw ropahâh ngaitapa alabastâ ôh a vaw cheipa ta a vy ta, pati a dôh hai nota a luh liata bao ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pachupazy ta ama hmô nahta, ama hiehâh ngaita ta, “Khazia ma he hawhta a pahryuh thlâhthli tly?
  </para>
  <para style="p">
    <verse number="9" style="v" />He sathaw he a mâ hluhpi ta zuapa ta, dyhchhiepazy piepa châ sala a phahnai via awpa tlai,” tah ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zisu ta ama reipa cha a pahno nahta, ama hnohta, “Chanô he khazia nama patypamâ tly? Ei chô liata hmo phapa a taopa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dyhchhiepazy cha nama hnohta khâ ama y thlâh ha aw. Kei deikua cha nama hnohta khâ a y awpa châ va na.
  </para>
  <para style="p">
    <verse number="12" style="v" />He sathaw ropahâhpa ei pôhpa liata a baopa he, pabu awpa ta eina pachhuahpanohpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmeiseihta ta ei cha chho ei, khizaw zydua liata he thâtihpha ama chhona su lia maihta, he chanô hmotaopa he ano a thei thlâh ha nawpa ta ama reih lymâ hra aw,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha khai tawhta pahrawh hleino hry liata pakha, Zudâh Iskari ama tahpa cha, theihthai beizy lâ vawh ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />ama hnohta, “Ano cha, cha patusa aw ei sah la, khâpa eina pie aw ei chi?” tah ta. Tâkâ tlaw sythôh pie ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha noh tawhta, Zudâh Iskari cha Zisu patusa nawpa rypaohna tlua ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Viahchhâ thinô pahlao leipa noh, noh hmiatua chaipa liata, pachupazy cha Zisu lâ a vy ei ta, a hnohta, “Zawpakhô pati nie nawpa ta khataih liata châ chhuanohpa sih la na khoh?” tah ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu ta, “Khihpi liata chyhsa pakha lâ vawh u la, a hnohta, ‘Pachutuhpa ta ei daihti a hnia ha ta, ei pachupazy chhaota zawpakhô kyhchhi na o liata eima hmâh aw a tah,’ kei tah muh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zisu ta bie a piepa hawhta pachupazy ta tao ei ta, zawpakhô kyhchhi cha a chhuanoh ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zâlâ a vaw châ nahta, Zisu cha pachupa pahrawh hleinozy chhaota tlâhkhai liata pati dôh ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama nie hai nota ama hnohta, “Hmeiseihta ta ei cha chho ei, nama hry liata pakha ta eina patusa aw,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama pachârôh ngaita ta, pakha pakha ta, “Abeipa, kei ei châ ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zisu ta, “Beikoh liata a ku nâ chapaolâhpa ta eina patusa aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chyhsa Sawchapawpa he, a thâtih ropa hawh tlai ta a sie aw. Châhrasala Chyhsa Sawchapawpa a patusatuhpa chyhsa cha a hu a po na! Cha chyhsa cha pih leipa sala, a châta a pha via awpa tlai,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />A patusa awpa Zudâh ta a chhy ta, a hnohta, “Pachutuhpa, kei ei châ ma?” tah ta. Zisu ta, “Nâ ta na châpa na reih cha zaw,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ama nie hai nota, Zisu ta viahchhâ la ta, byhnâ a aw khai nahta, pachhaih ta, pachupazy pie ta, ama hnohta, “La u la, nie teh u, he he ei sapa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cha khai tawhta, nyu la ta, alyna bie a rei khai nahta, ama hnohta pie ta, “Nama zydua ta doh teh u.
  </para>
  <para style="p">
    <verse number="28" style="v" />He he ei thisaih, moleinazy a ngiahthai nawpa ta, chyhsa hluhpi châta a lohpa biehrai thiehpa a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ei cha chho ei, ei Paw khinarâh liata nâmo chhaota a thiehpa ta ei dona noh a tlô hlâlei cha, kre zôh thei he doh heih khao aw va na,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hla ama sa khai nahta, Ôli tlâh lâ sie ha ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zisu ta ama hnohta, “‘Mietaku vaituhpa thie aw na ta, mietaku zaw ama pai aw,’ tahpa ta ropa hawhta, tazâ tlai heta nama zydua ta eina paosai khai aw ei chi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Châhrasala pathyupa ta ei y tawhta, nama hmia lâta Kâlili râh lâ ei sie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pity ta a chhy ta, “Ama zydua ta cha paosai khai ha hra ei sala, kei la cha paosai beih aw va na,” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zisu ta Pity hnohta, “Hmeiseihta ta ei cha chho, tazâ tlai heta, awh kho hlâta ei thôh einâ paphasai aw chi,” tah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pity ta a chhy ta, “Na hnohta thi awpa a châpa chhao ta, châ paphasai cheita aw va na,” tah ta. Cha hawhna chata pachupa zydua ta reih chyu ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cha khai tawhta Zisu cha a pachupazy chhaota Kesemani ama tahpa su lâ sie ta, ama hnohta, “Hao liata thlah ei kei chhâ chhôh ta, he liata a vaw tyuh chy muh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />A hnohta Pity nata Zebâdi sawchapaw pano a chhi ta, pachârôhpa ta a nôpo ngaita ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ama hnohta, “Ei thlahpa a pachârôh ngaita ta, thina taihta a châ. He liata y u la, na vaihkhei teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />A chyhta vawh via ta, â khu lâta pao ta, thlahchhâ ta, “Hy ei Paw, tao theipa a châ khiahta la, he nyu he rie na khôsai mawh sy. Châhrasala keima rei châ leipa sala, nâma rei tlao châ mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Pachupazy yna lâ vawh ta, amâ mô thlâh hapa hmô ta. Pity hnohta, “Aw! Dawh kha chhôh chhao na vaihkhei thei veih ei chi ma?
  </para>
  <para style="p">
    <verse number="41" style="v" />Reipasaona liata namâ ngia lei nawpa ta, a vaih u la, thlahchhâ teh u. Thlahpa ta la hoh ta, sapa deikua a dadieh,” tah ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Chatawhcha a ei nona ta vawh ta, thlahchhâ heih ta, “Hy ei Paw, he nyu he doh leipa ta na khôsai thei awpa a châ vei khiahta cha, na rei sai châ mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />A vy heih ta, mokuh ama saih thei leipa vâta, a vaw mô thlâh ha heih ei ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />Âmo cha siesai heih ta, a ei thôhna ta thlah kei chhâ heih ta, a rei hmopa pyly reih heih ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Cha khai tawhta pachupazy yna lâ a vy ta, ama hnohta, “A pahâ ei chi ta ma namâ mô thlâh ha chy? Moh teh u, a daihti a tlô haw, Chyhsa Sawchapawpa cha moleipazy ku liata hlâpa a châ haw.
  </para>
  <para style="p">
    <verse number="46" style="v" />Thyu teh u, sie ei suh u. Moh teh u, nâ patusatuhpa â vaw hnia ha huh,” tah ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />A rei hai nota, pahrawh hleino hry liata pakha, Zudâh cha a vy ta, zawpi hluhpi chhao zaozi nata thothuzy a chabapa ta a hnohta a vy ei ta. Theihthai beizy nata khitlâh machâzy taihta a hlao ei ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />A patusatuhpa ta, “Ei pahnâpa chyhsa cha, nama patu khohpa cha a châ aw. Ano cha patu muh vy,” tahpa ta ama hnohta ngiana vaw pie chhielie ha ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Zisu cha thlai vaw pangai ta, a hnohta, “Ei châ naoh na, Pachutuhpa!” tah ta, Zisu cha a pahnâ ta.
  </para>
  <para style="p">
    <verse number="50" style="v" />Zisu ta a hnohta, “Viasa, nâ vyna chhâpa cha tao mah y,” tah ta. Chyhsazy vaw pua ei ta, Zisu cha chahnaochakhipa ta patu ei ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Zisu hnohta a ypa hry liata pakha ta a zaozi phia ta, theihthai beichaipa chakaotuhpa kei chhawh ta, a nakao pathai ha ta.
  </para>
  <para style="p">
    <verse number="52" style="v" />Zisu ta a hnohta, “Na zaozi kha a paih liata khô teh. Zaozi a hmâhpa maih zaozi ta ama leidia aw.
  </para>
  <para style="p">
    <verse number="53" style="v" />Tahmâ tlai he ei Paw lâ a haw aw sah la, vâlyuhchâpa hlao hrawh hleino hlâta hluh via eina vaw tuapa thei tahpa pahno veih ei chi ma?
  </para>
  <para style="p">
    <verse number="54" style="v" />Châhrasala cha hawhta tao aw sah la, he hawhta vaw châ awpa ta Biehrai ta a reipa kheihta â ki thei aw?” tah ta.
  </para>
  <para style="p">
    <verse number="55" style="v" />Cha dawh liata Zisu ta zawpi hnohta, “Hraotuhpa patupa hawhta patu awpa ta ma, zaozi nata byuhthô ta einâ vyhnao ei chi? Achhyna o liata noh chareih bie pachupa ta a tyuh tyh na ta, na patu tlôh ei chi va.
  </para>
  <para style="p">
    <verse number="56" style="v" />Châhrasala hrohsopazy ropa Biehrai â ki thei nawpa ta, he hmo zydua he a vaw tlôpa a châ,” tah ta. Cha khai tawhta, pachupa zydua ta ano cha siesaipa ta a râ khai ha ei ta.
  </para>
  <para style="p">
    <verse number="57" style="v" />Zisu patutuhpazy ta ano cha theihthai beichaipa Kaiphâ lâ a chhi ei ta, cha liata Ryhpa pachutuhpazy nata machâzy a hmaohpakhy ei ta.
  </para>
  <para style="p">
    <verse number="58" style="v" />Pity cha â hla kawpa ta Zisu cha pazi ta, theihthai beichaipa tlyhmia tlôna taih pazi ta. Achhâna pahno awpa ta a chhôh lâ a kei ngia ta, vaituhpazy hry liata a tyuh ta.
  </para>
  <para style="p">
    <verse number="59" style="v" />Zisu ama thie thei nawpa ta, theihthai beizy nata ryureituhpa zydua ta haipa ta ano leih nawpa tlua ei ta.
  </para>
  <para style="p">
    <verse number="60" style="v" />Pahnokheituh pakheipa hluhpi vaw pua hra ei sala, leih nawpa hmô leipa ei ta. Achhâna lâta chyhsa pano a vy ei ta,
  </para>
  <para style="p">
    <verse number="61" style="v" />“He chyhsa heta, ‘Khazohpa Achhyna o he phie thei na ta, noh thôh chhôh ta ei paduapathi thei,’ a tah,” tah ei ta.
  </para>
  <para style="p">
    <verse number="62" style="v" />Theihthai beichaipa cha a kaw duah ta, Zisu hnohta, “A chhy aw va chi ma? He chyhsazy ta ama cha leihna he khâpa ma a châ?” tah ta.
  </para>
  <para style="p">
    <verse number="63" style="v" />Châhrasala Zisu cha a chalih thlâh ha ta. Theihthai beichaipa ta, “Khazohpa hrohpa moh reipa ta bie a taih awpa ta bie ei cha pie. Khazohpa Sawchapawpa Mesia cha na châ ma, miah chho teh,” tah ta.
  </para>
  <para style="p">
    <verse number="64" style="v" />Zisu ta a chhy ta, “Na reipa hawhta ei châ. Châhrasala ei cha chho ei, he tawhta la, Chyhsa Sawchapawpa he Atotaotheipa ku chachâh lâta a tyuhpa ta, vâ meihdo chô liata â vypa nama hmô aw,” tah ta.
  </para>
  <para style="p">
    <verse number="65" style="v" />Cha khaipa nahta, theihthai beichaipa cha a poh hrie ta, “Khazohpa a reipachhie he zaw. Pahnokheituhpa hropa khazia eimâ ngiah khao aw? Pachâ teh u, tahmâ tlai kha Khazohpa a reipachhiena nama thei khai ha khaw.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kheihta ma nama pachâ?” tah ta. “Thi tlâh a châ,” tah ei ta.
  </para>
  <para style="p">
    <verse number="67" style="v" />A hmia liata ama pachih ta pachhao ei ta, tu ei ta, thokha ta chabaih ei ta,
  </para>
  <para style="p">
    <verse number="68" style="v" />“Hrohsona bie cha miah chho bao, Hy nâ, Mesia! Ahy ma châ tu?” tah ei ta.
  </para>
  <para style="p">
    <verse number="69" style="v" />Pity cha dôhpachhôh tlyhmia khôtho liata a tyuh ta. Laihsa pakha ano lâ a vy ta, “Nâ chhao he Kâlili chyhsa Zisu hnohta a ypa na châ hra,” tah ta.
  </para>
  <para style="p">
    <verse number="70" style="v" />Pity ta, “Na bie reipa cha pahno va na,” tahpa ta ama zydua mohmô ta a papha ta.
  </para>
  <para style="p">
    <verse number="71" style="v" />Pua awpa ta tlyhmia chhikao lâ a vaw hai nota, laihsa hropa ta vaw hmô ta, cha liata a ypazy hnohta, “He chyhsa he Nâzari chyhsa Zisu hnohta a ypa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="72" style="v" />Pity ta, “Cha chyhsa cha pahno va na,” tahpa ta chhie a sa khâhpa ta, a paphasai heih ta.
  </para>
  <para style="p">
    <verse number="73" style="v" />Buakha a châ nahta, cha liata a duahpazy a vy ei ta Pity hnohta, “Nâ chhao he ama hry liatapa na châ cheingei hra, na reih pathliezie liata â hno thlâh haw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="74" style="v" />Pity ta, “Cha chyhsa cha pahno va na,” tahpa ta chhie a sa khâh ta. Cha khaipa nahta, awh khoh pâ ha ta.
  </para>
  <para style="p">
    <verse number="75" style="v" />Zisu ta, “Awh kho hlâta ei thôh einâ paphasai aw chi,” a tahpa kha, Pity ta a thei ta. Pua ta, aoh tlili ta cha ta.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />My a vaw châ nahta, theihthai bei zydua nata khitlâh machâzy cha Zisu thie thei nawpa kyh ryhrao ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zisu cha chahrypa ta a chhi ei ta, râhvaotuhpa Pilâ lâ hlâ ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />A patusatuhpa Zudâh ta Zisu cha thailei pachâsapa a châ tahpa a pahno nahta, a ngiapachhi ta, tâkâ tlaw sythôh kha theihthai beizy nata machâzy lâ kei pakua ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama hnohta, “Pei hria leipa thisaih ei paphasaipa vâta, ei vaw molei haw,” tah ta. Âmo ta, “Cha cha keimo châta khâpa a pei aw? Nâma tao ta tao teh” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zudâh ta tâkâ cha Achhyna o chhôh liata thy ta, pua ta, sie ta a paaosao ha ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Theihthai beizy ta tâkâ cha la ei ta, “He tâkâ he thisaih ty a châpa vâta, Achhyna o tâkâ byh liata so awpa ta Ryhpa ta pasaih vei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ryhraona tao ei ta, cha tâkâ chata khichhaizy thlâ su châta beihvituhpa lyu chalei ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chavâta cha lyu cha tanoh taihta “Thisaih Lyu” tahpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chatanachata hrohsopa Zeremiah ta, “Tâkâ tlaw sythôh, Izarei saw thokhazy ta ano mâ ama thliepa cha la ei ta,
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa ta bie eina piepa hawhta, beihvituhpa lyu mâ ta ama pie,” tahpa ta a reipa kha a vaw tlô hapa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zisu cha râhvaotuhpa hmiakô liata a duah ta, râhvaotuhpa ta, “Zuzy Beipa na châ ma?” tahpa ta hiahri ta. Zisu ta a hnohta, “Na reipa hawhta ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Theihthai beizy nata machâzy ta ama leih nota deikua cha, khâpa hmah a chhy vei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilâ ta a hnohta, “Ama cha leihna zydua he thei va chi ma?” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Châhrasala a chhy leipa ta, ama leihna miakha chhao a chhy vei. Cha vâna chata râhvaotuhpa cha a noâh ngaita ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kyhchhi daihti maih liata râhvaotuhpa ta atâhpazy hry liata zawpi khopa pakha papua tyh ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha daihti liata, chyhsa molei ngaitapa pakha, Bârabâ ama tahpa a tâh hra ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amâ vaw pôhpakhy nahta, Pilâ ta ama hnohta, “Ahy ma cha papuapa aw ei sah la nama khoh, Bârabâ ma, Krista ama tahpa Zisu maw?” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ama hiatliapa vâta Zisu cha ama patupa a châ tahpa pahno thlâh ha ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cha dei châ vei. Pilâ cha ryureina dyuchhai liata â tyuh thlâh ha nota, a lapinô ta, “Kha chyhsa siapa chô liana khata kheihta hmah tah khah y. Tanoh ano vâta ei mâ liata pasa thata ei tao,” tahpa ta bieta ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Theihthai beizy nata machâzy ta Bârabâ papua awpa ta hiah ei ta, Zisu cha pahleipadia awpa ta zawpi pasyu ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Râhvaotuhpa ta ama hnohta, “He pano hry liana heta ahy ma cha papuapa aw ei sah la nama khoh?” tah ta. Âmo ta, “Bârabâ” tah ei ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pilâ ta ama hnohta, “Cha khiahta la, Krista ama tahpa Zisu he zaw, kheihta ei tao aw?” tah ta. Ama zydua ta, “Khaipâ teh,” tah ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pilâ ta, “Khazia maw, khâpa moleina ma a tao haw?” tah ta. Châhrasala, “Khaipâ teh,” tahpa ta thata awh via rili ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pilâ ta khâpa hmahta tao thei leipa ta, tlao â tymâ via rilipa a hmô nahta, ti la ta, zawpi hmiakô liata a ku a si ta, “He chyhsa siapa thisaih liana heta ei pathaih na, nâmo tao ta tao teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zawpi zydua ta, “A thisaih maoh cha keimo chô liata nata eima pathlazy chô liata y mawh sy!” tahpa ta a chhy ei ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chatanachata Bârabâ cha papua ta, Zisu deikua cha a pachheisa khai tawhta, khaipâ awpa ta hlâ ha ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Râhvaotuhpa pheisaihzy ta Zisu cha Pritôria lâ a chhi ei ta, pheisaih zydua a hmiakô liata awpakhy ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />A chysia pahluh ei ta, poh saihlawpa pabu ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hloh lakho phieh ei ta, a luh liata pakho ei ta, a ku chachâh lâta lohthi chabasa ei ta. A hmiakô liata pakhu paneihpa ta, “Zuzy beipa, hroh pareih mah y,” tahpa ta pasipasawh ei ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ama pachih ta pachhao ei ta, lohthi cha la ei ta, a luh liata tu ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama pasipasawh khai nahta, poh saihlawpa cha hlaipa ei ta, ano chysia pakysa heih ei ta, khaipâ awpa ta a chhi ha ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama pua nahta, Kurini chyhsa, a moh Saimaw ama tahpa hmô ei ta. Cha chyhsa cha Zisu kraws papiasa raruah ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Luh ru su ama tahpa Kalvari tlâh ama tlô nahta,
  </para>
  <para style="p">
    <verse number="34" style="v" />hmo khapa nata pahlaopa kresawhti padosa ei ta, pachâh ta, doh khoh leipa ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ama khaipâ khai nahta, nuby a daopa ta a chysiazy a rai ei ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cha liata a tyuh ei ta, ano cha vaih ei ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />A luh chô liata ano leihna, “He he Zisu, Zuzy Beipa a châ,” tahpa ta ropa bai ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zisu hnohta hraotuhpa pano, a chachâh lâta pakha, a chavei lâta pakha khaipâ hra ei ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cha su a chapiapazy ta ama luh hiepa ta, pahneisao ei ta,
  </para>
  <para style="p">
    <verse number="40" style="v" />“Nâ, Achhyna o phie ta, noh thôh chhôh ta a paduapathi awpa chi, nâma sasyh ta a pachha châh chi! Khazohpa Sawchapawpa na châ khiahta cha, kraws tawhta za chô châh chi!” tah ei ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Theihthai beizy, Ryhpa pachutuhpazy nata machâzy chhao ta pasipasawh ei ta,
  </para>
  <para style="p">
    <verse number="42" style="v" />“Chyhsa hropazy pachha ta, anosasyh a pachha thei vei. Izarei Bei mah a châ tâh, tahmâ he kraws tawhta za chô sala, ano eimâ ngiapâ aw.
  </para>
  <para style="p">
    <verse number="43" style="v" />Khazohpa ngâ ta, ‘Khazohpa Sawchapawpa ei châ’ a tah mâh tâh. Khazohpa ta a chô liata â ly tlai khiahta cha, tahmâ pachha bao sa,” tah ei ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />A hnohta khaipâpa hraotuhpazy chhao ta, cha hawhta pasipasawh hra ei ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nohchhô dawh hrawh hleino tawhta zâlâ dawh thôh taih alei chô zydua vaw zoh kaluh ha ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dawh thôh rachhôhpa liata, Zisu cha ao paro ngaitapa ta awh ta, “Eli, Eli, lâmâ sabakthâni?” tah ta, cha cha, “Ei Khazohpa, Ei Khazohpa, khazia eina pathlua chi?” tahna a châ.
  </para>
  <para style="p">
    <verse number="47" style="v" />Cha liata a duahpazy ta ama thei nahta, “Elaizâh a aw chu,” tah ei ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ama hry liata chyhsa pakha thlai a râ ta, ti pasysana la ta, kresawhti thaopa liata ny ta, lohthi pawhmao liata pataohpa ta, padosa ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Châhrasala ahropazy ta, “Tah mâh kha, pachha awpa ta Elaizâh â zu ma tahpa moh tua suh u,” tah ei ta.
  </para>
  <para style="p">
    <verse number="50" style="v" />Zisu cha ao paro ngaitapa ta awh heih ta, a thlahpa pathlie ha ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Achhyna o pohraipa cha, a chô lâ tawhta a ry lâ taihta â khophie ta a hrie ta, alo a sih ta, lôpanôzy a patlaw ta.
  </para>
  <para style="p">
    <verse number="52" style="v" />Thlâzy a pahy ta, mopathaihpa a mô hapa pôhpa hluhpi pathyupa ta y ei ta.
  </para>
  <para style="p">
    <verse number="53" style="v" />Zisu a thyuheih tawhta thlâ tawhta vaw pua ei ta, khihpi pathaihpa lâ sie ei ta, chyhsa hluhpi hnohta a luah ei ta.
  </para>
  <para style="p">
    <verse number="54" style="v" />Pheisaih za kha hyutuhpa nata a hnohta Zisu vaituhpazy ta, alo a sihpa nata hmo a ypazy cha ama hmô nahta, chi ngaita ei ta, “Hmeiseihta ta, he he Khazohpa Sawchapawpa a châ tlai na!” tah ei ta.
  </para>
  <para style="p">
    <verse number="55" style="v" />Cha liata chanô hluhpi, Zisu deichhy lymâpa ta Kâlili tawhta a vaw zipazy y ei ta, lâhlapi tawhta sai ei ta.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ama hry liata Mâri Mâdali, Zâmie nata Zawsi nô Mâri zy a hlao ei ta, Zebâdi sawchapawzy nô chhao â hlao hra.
  </para>
  <para style="p">
    <verse number="57" style="v" />Zâlâ a vaw châ nahta, chyhsa hneirôhpa Zawsi ama tahpa cha Arimathai khih tawhta a vy ta. Ano cha Zisu pachupa pakha châ hra ta.
  </para>
  <para style="p">
    <verse number="58" style="v" />Zawsi cha Pilâ lâ vawh ta, Zisu ri kei hiah ta. Pilâ ta pie awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="59" style="v" />Zawsi ta Zisu ri cha la ta, poh rih dipa pathaihpa ta pahly ta,
  </para>
  <para style="p">
    <verse number="60" style="v" />ano thlâ thiehpa, lôpanô khiepa ta a taopa liata pazia ta, thlâ chhikao cha alô lai ngaitapa ta pamai ta, siesai ha ta.
  </para>
  <para style="p">
    <verse number="61" style="v" />Mâri Mâdali nata Mâri hropazy chhao, cha liata y hra ei ta, a thlâ dady ta a tyuh ei ta.
  </para>
  <para style="p">
    <verse number="62" style="v" />A mylâ ta, cha cha Pachynoh mylâ châ ta, theihthai beizy nata Phârisaihzy Pilâ hmiakô liata a hmaohpakhy ei ta,
  </para>
  <para style="p">
    <verse number="63" style="v" />a hnohta, “Pâpuh, kha dôtuhpa khata a hro nota, ‘Noh thôh khai tawhta ei thyu heih aw,’ a tahpa eimâ thei thlâh haw.
  </para>
  <para style="p">
    <verse number="64" style="v" />Chavâta thlâ cha noh thôh noh taihta a phapa ta vaih awpa ta biepie teh. Chataleipatala a pachupazy ta ano cha paru aw ei ta, zawpi hnohta, ‘Thina tawhta a thyu haw,’ tah aw ei ta, cha dôveina hnôhchaipa cha dôveina hmiatuapa hlâ khata a pha lei via syulyu aw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="65" style="v" />Pilâ ta ama hnohta, “Vaituhpa pheisaihzy nama hnei kha zaw. Vawh u la, â boh thei chaipa hawhta kei tao teh u” tah ta.
  </para>
  <para style="p">
    <verse number="66" style="v" />Chatanachata vawh ei ta, â boh thei nawpa ta thlâ cha alô ta â i ngaitapa ta pamai ei ta, vaituhpazy soh ei ta.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pahânoh khai tawhta, hâta noh hmiatua chaipa khih a vaw pavâ pathao nahta, Mâdali nata Mâri hropa cha thlâ vaih awpa ta vawh ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Alo thata a vaw sih ta, vârâh tawhta Abeipa vâlyuhchâpa za chô ta, thlâ pamaina lô cha pasie ta, a chô liata a tyuh ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />A hmiaphao cha dôhla pathliepa hawhta châ ta, a chysia cha dâhaw hawhta dieh ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ano ama chipa vâta, vaituhpazy cha a chalyu ei ta, athipa hawhta y ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vâlyuhchâpa chata chanôzy hnohta, “Chi khah u, Zisu ama khaipâpa kha nama tlua tahpa ei pahno.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ano cha he liata y khao vei, a reipa hawhta a thyu haw. A vy u la, â ziana su he vaw moh tua u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tahmâ thlai sie u la, a pachupazy hnohta, ‘Athihpa hry tawhta a thyu haw. Nama hmia lâta Kâlili lâ sie ta, cha liata nama hmô aw,’ tahpa ta kei chho teh u. Nathlie teh u, ei cha chho ha ei chuh,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chanôzy cha china nata thaphana chôta thlâ tawhta thlai a lie ei ta, a pachupazy chho awpa ta a râ ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zisu ta âmo cha a vaw tyh ta, “Thlalôhna nama hnohta y mawh sy?” tah ta. A pachupazy cha a vy ei ta, a phei patu ei ta, Zisu cha a naoh ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zisu ta ama hnohta, “Chi khah u. Sie u la, ei unawhzy hnohta Kâlili lâ sie awpa ta kei chho teh u. Cha liata eina hmô aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chanôzy ama sie hai nota, thlâ vaituhpa thokha khihpi lâ vawh ei ta, hmo a tlôpa zydua cha theihthai beizy chho ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Theihthai beizy cha machâzy chhaota a hmaohpakhy ei ta, bie pachia ei ta, pheisaihzy hnohta tâkâ hluhpi pie ei ta,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Zawpi hnohta, ‘Zâ eimâ mô chhôh ta a pachupazy a vy ei ta, ama paru haw,’ tahpa ta nama chho aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha kyh cha râhvaotuhpa nakhaoh liata â ngia hapa chhao ta, a palôh patlâh aw pi ta, nâmo cha eima cha pabohsa aw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vaituhpazy ta tâkâ cha la ei ta, ama chhopa hawhta tao ei ta. Cha bie hawhna chata tanoh taihta Zuzy hry liata a pathâh lymâ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pachupa pahrawh hleikhazy cha Kâlili liata Zisu ta tlâh a raopa lâ sie ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ano ama hmô nahta, a naoh ei ta, thokha deikua cha a lôh leipa ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zisu cha âmo lâ a vy ta, ama hnohta, “Avâ nata alei liata biehneina zydua ei hnohta piepa a châ haw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chavâta sie u la, phopi zydua pachupazy ta tao u la, Paw nata Sawchapawpa nata Thlahpa Pathaihpa moh ta bâti pachâsa u la,
  </para>
  <para style="p">
    <verse number="20" style="v" />bie ei cha piepa zydua ei kha zyh awpa ta pachu teh u. Nathlie teh u, nama hnohta ei y thlâh ha aw, khizaw chhâna taih ta,” tah ta.
  </para>
</usx>
