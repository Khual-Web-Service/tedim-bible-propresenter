<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1TI" style="id">1 Timawthy</book>
  <para style="h">1 Timawthy</para>
  <para style="toc1">1 Timawthy</para>
  <para style="toc2">1 Timawthy</para>
  <para style="mt">1 Timawthy</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kei, Pawla, Khazohpa miah Pachhatuhpa nata Krista Zisu eima hnabeiseihna biepiepa hawhta Krista Zisu lyuhchâpa ta
  </para>
  <para style="p">
    <verse number="2" style="v" />ngiapâna liata ei sawchapaw hmeiseihpa Timawthy ei châ naoh. Paw Khazohpa nata Krista Zisu eima Beipa tawhta ngiachhiena, zawngiahna nata thlalôhna na hnohta y mawh sy.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mâsidônia râh lâ ei sie nota, nâ cha Ephesi khih liata châh ta, chyhsa thokhazy hnohta biezyhpa nanopa pachu lei awpa ta biepie awpa ta châ haw na ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Phôhpa nata thyutôna kyh a laichadai tiah leipazy reina liata ngosiah thlâh lei awpa ta biepie awpa ta ei châ haw hra. Cha hawhpa biezy reipa cha ngiapâna kyh liata Khazohpa raihria thapatlôtuhpa châ leipa ta, aeichhiana a taotuhpa tlao a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kha hawhta bie eima cha piena chhâpa cha, palôh pathaihpa, chhie nata pha pahnona pathaihpa nata ngiapâna hmeiseihpa tawhta a vaw puapa kyhpachâna ama hnei thei nawpa ta a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chyhsa thokha cha, chazy vâta pavia ei ta, hraoleipa biezy reina lâta ama tlei tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pahnopasia tlôh leipa ta bie reih ei ta, riahpha kawpa ta bie a duakheipa ta, ryhpa pachutuhpazy châ awpa ama khoh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ryhpa cha, chyhsa ta a phapa ta a hmâh khiahta cha, a pha tahpa eima pahno.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ryhpa cha chyhsa dopazy châta taopa châ leipa ta, ryhpa â papeisa leipa nata reingiah leipazy, Khazohpa a pachâ leipa nata moleipazy, pathaih leipa nata zyhna kyh a pachâ leipazy, nô nata paw a thiepazy, lianycheihpazy,
  </para>
  <para style="p">
    <verse number="10" style="v" />apatlana moleina a taopazy, chapaw nata chapaw a patlapazy, sei patupa nata zuapa ta sôhpaliepazy, haihthaipazy, haipa ta bie a taihpazy nata biezyhpa dopa a chakhiapa maih châta taopa a châ tahpa pahno teh u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha ryhpa cha reithai tlâh Khazohpa thâtihpha rônahpa, kei liata pavaosapa nata â hmiepa ta taopa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngâchhihpa ta na pachâ ta, ano chakao awpa ta na rao ta, thatlôna nâ pietuhpa eima Beipa Krista Zisu hnohta alyna bie ei reih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kha hlâta reipachhietuhpa, taolatuhpa nata pasipasawhtuhpa vaw châ hraw sah la, ngiapâleina vâta pahno leipa ta a taopa ei châpa vâta, zawngiahna ei hmô.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chatanachata eima Beipa ngiachhiena cha Krista Zisu liata a ypa ngiapâna nata kyhpachâna chhaota ei chô liata lei thlupa ta a y.
  </para>
  <para style="p">
    <verse number="15" style="v" />Krista Zisu cha moleipazy pachha awpa ta khizaw lâta â zu tahpa he, bie ngâchhihpa nata a pyh tlâh ngaitapa a châ. Kei he moleipazy hry liata molei chaipa ei châ hih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Châhrasala cha vâna tlai chata zawngiahna hmô na ta, Krista ta keima molei chaipa chô liata a nôphana pakipa palâsa ta, cha cha chhâzaw hrona hmô awpa ta ano a ngiapâpazy châta pamosana a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chhâzaw Beipa, thi thei leipa, hmô thei leipa nata Khazohpa a y chhôhpa hnohta chhâzaw nata tlyzaw ta palyupalihna nata rônahna y mawh sy. Amen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ei saw Timawthy y, nâma kyh liata hrohsona bie phuah chhieliepa hawhna khata, adyuhna phapa ta nâ dyuh thei nawpa ta, he biepiepa he na chô liata ei pahnieh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngiapâna nata chhie nata pha pahnona pathaihpa khâchâ patu mah y. Chyhsa thokha ta chazy cha dytha ei ta, balyh raopa hawhta, amâ ngiapâna ama parao haw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chazy hry liata Humenia nata Alezandâ a hlao ei ta, Khazohpa reipachhiepa a peizie amâ chu thei nawpa ta, Sâtâ hnohta ei hlâ ha ei.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hmiatua ta, hmo hiapa thlahchhânazy, thlahchhâna sôpipazy, chyhsa châta thlahchhâna nata alyna bie reina thlahchhânazy chyhsa zydua châta tao awpa ta ei châ haw ei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thlalôhpa nata chhôhmohpa ta ypa ta, Khazohpa a pachâpa nata zachhihpazy eima châ lymâ thei nawpa ta, beizy nata biehneituhpa zydua châta thlahchhâ tyh awpa ta ei châ haw ei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha cha miah Pachhatuhpa Khazohpa mohmô ta pha ta, â lyzie a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazohpa ta chyhsa zydua pachha ama châ khai awpa nata biehmeiseihpa ama pahno khai awpa a khoh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khazohpa cha pakha deita y ta, Khazohpa nata chyhsazy likah liata lyuhchâpa pakha deita a y. Ano cha chyhsapa ta a pihpa Krista Zisu a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Krista Zisu cha chyhsa zydua chatlai nawpa ta anosasyh ta a pie ta, a daihtita liata chatlaina bie a phuah haw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cha châna chata biechhotuhpa nata lyuhchâpa ta raopa châ na ta, biehmeiseihpa nata ngiapâna kyh liata Zenitaizy pachutuhpa ta raopa ei châ. Biedopa ei reih, haih va na.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chapawzy cha su to liata ku pathaihpa avâ lâ pazawhpa ta, hiehâh leipa nata a eichhia leipa ta thlah ama chhâ tyh awpa ei khoh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha hawhna chata chanôzy chhao â daihpa rakha ta a tobiepa ta, mongiapa nata zachhihpa ta y ei sala ei khoh. Sâ phiehpa ta tlyma, ngôh ta tlyma, taikulô ta tlyma, chysia mâ rupa ta tlyma a tobi leipa ta,
  </para>
  <para style="p">
    <verse number="10" style="v" />Khazohpa a uasapa chanôzy châta a tobi awpa rakhapa ta a tobipa ta, hmo pha taopa ta tlao amâ tobi awpa ei khoh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chanô cha reingiahpa nata a chalihpa ta a chu mawh sy.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chanô ta a pachu awpa tlyma, chapaw chô liata bie a hnei awpa tlyma pasaih va na. A chalihpa ta a y awpa tlao a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Âdâh kha tao tuapa châ ta, cha hnôhlâ ta Evâ kha taopa a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Âdâh kha dôpa ta y leipa ta, chanô kha dôpa ta y ta, paraona liata a paopa kha a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Châhrasala ngiapâna nata kyhpachâna nata pathaihna hneipa ta, hrozie ngiapa ta ama hroh khiahta cha, saw sana vâta pachhapa ama châ aw.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ahy rai Awnanopa chhituhpa châ awpa a khoh khiahta cha, raihria phapa a khoh, tahpa cha bie ngâ tlâhpa a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Awnanopa chhituhpa cha seina hnei leipa, lapinô pakha a hneipa, a sohsi theipa, sasyh a vao pahniepa, zachhihpa, chyhsa papyupahly a thaipa, a pachu theipa,
  </para>
  <para style="p">
    <verse number="3" style="v" />kresawhti pari hmâh leipa, thachahra hmâh leipa chyhsa nônaipa, ahryuchhiana a tao leipa nata tâkâ sôh liata karâ y leipa a châ awpa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />A chhôhkha khihsatôhtu a phapa ta mohôh thei ta, a sawzy ta zapa ta a rei amâ ngiahpa a châ awpa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ano chhôhkha khihsatôhtuna hmahta a phapa ta a mohôh thei vei khiahta cha, kheihta ma Khazohpa Awnanopa cha a mohôh thei aw?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngiapâ thiehpa chyhsa a châ awpa châ vei. Chataleipatala a palai aw ta, ahripa thailei pachâsana liata a pao pathlei aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cha dei châ vei, khôtho chyhsazy lia chhao ta moh phapa a châ awpa a châ. Chataleipatala reipachhiepa ta y aw ta, ahripa khoheih liata â ao pathlei aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha hawhna chata chakaotuhpazy chhao chyhsa zachhihpa, haipa bie a reih leipa, kresawhti parâ leipa nata avyuhna ta athôhna a tlua leipa ama châ awpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chhie nata pha pahnona pathaihpa hmâpa ta, ngiapâna bienyupa khâchâ a patupa ama châ awpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pasiapa châ tua ei sala, seina hnei leipa ama châ khiahta cha, chakaotuhpa rai cha hria mawh ei sy.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha hawhna chata chanôzy chhao chyhsa zachhihpa, chyhsa kyh a reih leipa, a sohsi theipa nata ato liata ngâchhihpa ama châ awpa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chakaotuhpazy cha lapinô pakha dei a hneipa ama châ awpa châ ta, ama sawzy nata ama chhôhkha khihsatôhtuna a phapa ta mohôh theipa ama châ awpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chakaona rai a phapa ta a hriapa chakaotuhpazy cha, moh phana to aw ei ta, Krista Zisu ngiapâna kyh liata riahphana thata ama hnei aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nâ lâ a vy patoh awpa ei chhuah. He hmozy kyh liata châpaphaopa ei vaw rona chhâpa deikua cha,
  </para>
  <para style="p">
    <verse number="15" style="v" />vaw hawh pathlei mawh sah la, Khazohpa chhôhkha liata kheihta y awpa ma a châ tahpa na pahno thei nawpa ta ei vaw ropa a châ. Khazohpa chhôhkha cha Khazohpa hrohpa Awnanopa châ ta, cha cha bie hmeiseihpa tôh nata abôna a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khazohpa pahnona bienyupa cha a rônah ngaita, reipasipasua awpa y vei: Sapa ta a vaw luah ta, Thlahpa ta thai pachâsa ta, Vâlyuhchâpazy ta ama hmô. Phopizy hry liata phuahpa châ ta, Khizaw ta a ngiapâ ta, Rônahpa ta chô lâ a chhipa a châ.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmialâ daihti vaw tlô awpa liata cha, chyhsa thokhazy ta dôveina thlahpa nata ahripazy pachuna bie zopa ta, ngiapâna ama bâhsai aw tahpa Thlahpa ta a siapa ta a reih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cha hawhpa pachunazy cha phapakheipa haihthaipazy tawhta vaw pua ta, ama chhie nata pha pahnona cha thua sahpa ta pakâ hapa hawhta a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nôvah ahneina pakhâ ei ta, biehmeiseihpa pahnotuhpa nata ngiapâtuhpazy ta alyna bie reina chôta nie awpa Khazohpa ta a taopa niedozy nie lei awpa ta bie ama pie.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazohpa hmotaopa to cha pha ta, alyna bie reina chôta daopa a châ khiahta cha, khâpa hmah dytha awpa châ vei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khazohpa bie nata thlahchhâna ta pathaisa hapa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chazy cha unawhzy na pahnosa khiahta cha, Krista Zisu chakaotuhpa phapa, ngiapâna bie nata biezyhpa phapa pachuna liata a laiseihpa na châ aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khazohpa nata a zao leipa phôhpa thlâhthlipazy nata nôpipazy biephôh liata pahâh leipa la, Khazohpa chyhsa châ awpa ta nâmasasyh ta a hrie mah y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pôhpa a hriepa he phahnaina rakha hnei ta, Khazohpa chyhsa châna deikua cha, tahmâ hro nata hro a vaw y awpa châta bietai a hneipa a châpa vâta, kyh to liata a phahnai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha bie cha ngâ a chhih ta, a pyh tlâh a châ ngaita.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khazohpa hrohpa liata eima hnabeiseihna eima sopa vâta, hriapasa pi ta, eima tei lylia. Ano cha chyhsa zydua Pachhatuhpa châ ta, ano ngiapâtuhpazy Pachhatuhpa a châ pachai.
  </para>
  <para style="p">
    <verse number="11" style="v" />He biezy he pie la, pachu mah y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thyutliapa na châpa vâta ahy hmahta cha mohnao khah ei sy. Bie rei kyh liata zy, yzie kyh liata zy, kyhpachâna kyh liata zy, ngiapâna nata pathaihna kyhzy liata ngiapâtuhpazy a mopâ awpa ta tlao y mah y.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ei vy hlâlei zawpi hry liata Biehrai reina, pasyuna nata pachuna raizy tiamapa ta vaw hria mah y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmopiepa na hneipa kha uasa leipa ta y khah y. Kha hmopiepa kha, hrohsona bie hawhta, machâzy ta na chô liata ama ku ama pahnieh nota piepa na châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chyhsa zydua ta na hmasiena ama hmô thei nawpa ta, hmopiepazy cha hmâh la, cha chakaona liata a hmâh khai mah y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na hro nata na pachuna biezy a phapa ta vaih mah y. Cha hawhta na tao khiahta cha, nâ nata na bie a theituhpazy na pachha aw ei.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pawhrâhpa cha ra leipa la, paw hawhta pasyu la, chapaw thyutliazy cha unawhzy hawhta moh mah y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nôhrâhpazy nô hawhta moh la, chanô thyutliazy cha sietanôzy hawhta pathaih kawpa ta moh mah y.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nôhmei hmeiseihpazy cha za mah y.
  </para>
  <para style="p">
    <verse number="4" style="v" />Châhrasala nôhmei cha sawzy tlyma, samohzy tlyma a hnei khiahta cha, Khazohpa chyhsa ama châna cha ama chhôhkha liata palâsa ei sala, ama nôpawzy chyh awpa ta a chu tua mawh ei sy. Cha cha Khazohpa alynazie a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nôhmei hmeiseihpa, ano dei ta a ypa cha, Khazohpa chô liata hnabeiseihna a sohpa châ ta, chhô nah zâ ta hiapa nata thlahchhâpa ta a y tyh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sapa lôhrâtlôna châta a hrohpa nôhmei deikua cha, a hroh thlâhpa chhao ta a thipa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Seina hnei leipa ta ama y thei nawpa ta, cha biezy cha pie hra mah y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sanawh a chyh leipa chyhsa, a eih pachaipa ta a chhôhkhazy a chyh leipa chyhsa cha, ngiapâna a paphasaipa châ ta, ngiapâleipa hlâ chhao ta a chhie via.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nôhmei cha kô sycharu chô lâ chanô châ sala, vahpa pakha dei a vaw hneipa,
  </para>
  <para style="p">
    <verse number="10" style="v" />a sawzy a mohôhpa, khichhai a pasôpa, mopathaihpazy phei a pasipa, chyhsa nôpopazy a deichhypa nata hmo pha to taona liata a hmâhpa, hmo pha taona kyh liata reithai a hlaopa a châ khiahta cha, nôhmeizy hry liata pahlaopa châ mawh sy.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nôhmei hawti viapazy deikua cha, nôhmei hry liata pahlao khah y. Krista châta amâ piena hlâta ama sapa khona a vaw lai via nahta, vahpa hnei awpa ama khoh tyh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amâ ngiapâ tuana ama siesaipa vâta thaileichâpa ta ama y tyh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha dei châ vei, thathipa ta y ei ta, o to ta amâ khiekhâ tyh. Ama thathipa dei châ leipa ta, chyhsa kyh reih ei ta, biethâhzy taopa ta, rei lei awpazy ama reih tyh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chavâta nôhmei hawti viapazy cha, dyhchâ ei sala, sawzy hneipa ta, ama chhôhkhazy mohôh ei sala, sei nawpa rypaohpa khakhaipa hnohta ama pie lei awpa ei khoh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tahmâ tlai chhao he thokha cha Sâtâ lâ ama tlei haw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngiapâtuhpa chanô ta sanawh nôhmeizy a hnei khiahta cha, âmo cha ano ta deichhy mawh sy. Awnanopa phao a pahri awpa châ vei. Chatanachata Awnanopa ta nôhmei hmeiseihpazy a deichhy thei aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Awnanopa chhituh phapa, a eih pachaipa ta biechhona nata pachuna liata hriapasapazy cha, a lie no ta palyupalih tlâh ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Biehrai ta, “Viahchao tôhpa ta sâh a tly nota a hmao nama hi awpa châ vei,” tah ta, “Raihriatuhpa cha hlao hmô tlâh a châ,” a tah hra.
  </para>
  <para style="p">
    <verse number="19" style="v" />Awnanopa chhituhpa leihna cha, pahnotuhpa pano tlyma, pathôh tlyma ama y leipa khiahta cha, nâ pyh awpa châ vei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Moleina taotuhpazy cha, zawpi hmiakô liata chhorei la, chatanachata mohropazy chhao ta ama chi aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />He ryhpazy he thailei pachâsa chhieliena y leipa ta, khokhei eih viapa hnei hra leipa ta hmâh awpa ta, Khazohpa nata Krista Zisu nata vâlyuhchâpa atlyhpazy mohmô liata bie ei cha pie.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsa chô liata ku pahnieh awpa ta a para leipa la, mohropazy moleina liata a hlao leipa la, pathaihpa ta y mah y.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ti deita doh khao leipa la, na pavyhpi châta nata na pasa tyhpa vâta, kresawhti chhao a chyhta do tyh mah y.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chyhsa thokha moleina cha a lâluah ta, ama hmia lâta pachiana lâ sie ta, thokha moleina deikua cha, hnôh lâta â vaw luah tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cha hawhna chata, hmo phapa cha a lâluah ta, a lâ mah leipazy chhao nyu theipa châ vei.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khazohpa moh nata a pachunazy reipachhiepa ta a y lei nawpa ta, sei raopaky a kypazy ta ama zibeipazy cha za tlâhpa ta ama pachâ awpa a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngiapâtuhpa zibeipa a hneipazy ta, Krista liata unawh ama châpa vâta, ama zibeipazy ama hno awpa châ leipa ta, ama chakaona a thôhkheituhpazy cha ngiapâtuhpa nata kho ngaitapazy ama châpa vâta, a pha viapa ta ama chakao rili awpa a châ. He biezy he pachu la pasyu mah y.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahy rai biezyhpa hropa pachupa ta, eima Beipa Zisu Krista biedopa nata Khazohpa khozie hawhta hroh awpa pachunazy â pyh vei khiahta cha,
  </para>
  <para style="p">
    <verse number="4" style="v" />apalaina ta a biepa châ ta, khâpa hmah a pahno leipa a châ. Aeichhiana nata ahryusina a y thei awpa biezy hrukhei ei ta, chazy chata uahvana, atudaina, reipachhiena nata ngâleina hmo pha leipazy a paysa tyh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chyhsa nata chyhsa likah liata bie pha leipa a tu tyhpa châ ei ta, cha hawhpa chyhsazy cha palôh chhiepa, biehmeiseihpa liata a duah leipa, Khazohpa lâ hmo pachâpa cha athôhna khiah ma a tahpazy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khazohpa khozie hawhta hroh ta, hneipa rakha liata palôhtlâh a paohpa he athôhna rônahpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khizaw liata khâpa hmah a ngiakhei leipa pi ta, khizaw tawhta khâpa hmah puakhei thei hra ma pi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nie awpa nata chysia a tao awpa eima hnei khiahta cha, chazy liana chata palôhtlâh a paoh ei suh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hneirôh a chhuahpazy ta reipasaona liata a ngia ei ta, khoheih liata amâ ao tyh. Âmo a parao thei awpa hmozy khoh ei ta, hru kawpa ta hmo taopa ta, ama pao tyh. Hneirôh khona ta chyhsazy cha raona nata leidiana liata a pamôh tyh ei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tâkâ sôh kyh liata karâyna cha moleina to thabypa a châ. Thokha sôh tlaichhaina vâta ngiapâna paviasai ei ta, pachârôhna hluhpi taopa ta, âmosasyh amâ pasasa tyh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nâ, Khazohpa chyhsa y, cha hmozy cha a râsai la, siana, Khazohpa pachâna, ngiapâna, kyhpachâna, daotheina nata nônaina zy a chadai lymâ mah y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngiapâna ta adyuhna phapa a dyuh la, chhâzaw hrona patu mah y. Cha cha to awpa ta awpa châ chi ta, pahnotuhpa hluhpi hmiakô liata a phapa ta nâ duakheipa kha a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmo to hrona a pietuhpa Khazohpa nata Pawtia Pilâ hmiakô liata biedopa a duakheituhpa Krista Zisu mohmô liata bie ei cha pie.
  </para>
  <para style="p">
    <verse number="14" style="v" />Eima Beipa Zisu Krista â vaw luah heih hlâlei cha, biepiepa kha apuapa kiah leipa nata seina hnei leipa ta zyh mah y.
  </para>
  <para style="p">
    <verse number="15" style="v" />Reithai tlâh Khazohpa nata ato chô liata biehneituhpa a y chhôhpa, beizy Beipa nata zibeizy Zibeipa ta eima Beipa Zisu Krista cha a daihtita liata a vaw paluahsa aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ano deita cha thi thei leina hnei ta, khaihpa a hnia thei rimâ leipa liata a pahrâ. Ano cha ahy hmah hmô beih leipa nata hmô thei leipa a châ. Khazohpa hnohta palyupalihna nata hmotaotheina chhâzaw ta y mawh sy. Amen.
  </para>
  <para style="p">
    <verse number="17" style="v" />He khizaw liata hneirôhpazy cha a palai lei awpa nata a leidia theipa sôh nata piah liata ama hnabeiseihna pachhô leipa ta, eimâ ly nawpa ta ato miah pietuhpa Khazohpa liata ama hnabeiseihna tlao pachhô awpa ta biepie mah y.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmopha ama tao awpa châ ta, hmopha taona liata hneirôhpa ta, riaphapa ta, ama hneina mohropazy amâ chhaih hra awpa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chatanachata daihti vaw tlô awpa liata ama ryuto châta lôbô phapa a bô aw ei ta, hrona hmeiseihpa cha ama patu thei aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hy Timawthy, na mohôh awpa ta nâ liata pavaosapa kha a phapa ta vaih mah y. Â doleipa ta “pahnona” ama tahpa Khazohpa a hlao leipa bie sisaw leipa reipa nata saizie a lyu leipa hmozy liata aeichhianazy a hneisai tyh mah y.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cha cha thokhazy ta zi ei ta, ngiapâna ama paviasai haw. Ngiachhiena na hnohta y mawh sy.
  </para>
</usx>
