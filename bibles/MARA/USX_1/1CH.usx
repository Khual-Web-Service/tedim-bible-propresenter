<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">1 Thâtih Zy Rona</book>
  <para style="h">1 Thâtih Zy Rona</para>
  <para style="toc1">1 Thâtih Zy Rona</para>
  <para style="toc2">1 Thâtih Zy Rona</para>
  <para style="mt">1 Thâtih Zy Rona</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Âdâh ta Sethâ sa ta, Sethâ ta Enawsâ sa ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />Enawsâ ta Kenâ sa ta, Kenâ ta Mâhalâle sa ta, Mâhalâle ta Zare sa ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />Zare ta Enawka sa ta, Enawka ta Methuselâ sa ta, Methuselâ ta Lâmeka sa ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />Lâmeka ta Nôah sa ta, Nôah ta Semâ, Hamâ nata Zaphethâ zy a sa ei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zaphethâ sawchapawzy cha Kôme, Mâkaw, Mâdai, Zavâ, Tubâ, Mese nata Tirâ zy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kôme sawchapawzy cha Askenâ, Ripha nata Tôkamâ zy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zavâ sawchapawzy cha Elisâ, Tâsi, Kiti nata Rôdâni zy ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hamâ sawchapawzy cha Kusi, Mizrai, Puti nata Kâna zy ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kusi sawchapawzy cha Sibâ, Havilâ, Sâbatâ, Râmâ nata Satekâ zy ama châ. Râmâ sawchapaw­zy cha Sebâ nata Dedâ ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kusi ta Nimraw sa ta, ano cha alei chô liata chyhsa thatlô riahphapa a y tuapa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mizrai ta Ludi, Anami, Lehâbi, Nâtuhi,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pârusi, Philistinâ mozy pathlatuhpa Kâluhi nata Kâftawri mozy sa ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kâna ta sawchapaw uhtheipa Sidaw nata a pazipa Hethâ sa ta,
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebu mo, Amawri mo, Kikâsi mo,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hivi mo, Araki mo, Sini mo,
  </para>
  <para style="p">
    <verse number="16" style="v" />Avâdi mo, Zemâri mo nata Hâmathi mozy pathlatuhpa a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Semâ sawchapawzy cha Elâmi, Asuria, Apasâ, Ludi nata Aramia zy châ ei ta, Aramia sawchapawzy cha Uzi, Hulâ, Kethe nata Mese zy ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Apasâ ta Selâh sa ta, Selâh ta Ebe a sa.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ebe ta sawchapaw pano sa ta, pakhapa moh cha Pele châ ta, alei liata phopizy he ano daihti liata pachhaihpa ama châ. A unawhpa moh cha Zawkatâ a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zawkatâ ta Almôdâ, Selepha, Hâzamâve, Zerâ,
  </para>
  <para style="p">
    <verse number="21" style="v" />Hadôrâ, Uzalâ, Dikalâ,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ôbâ, Abimelâ, Sebâ,
  </para>
  <para style="p">
    <verse number="23" style="v" />Ôphi, Havilâ, Zôbabi zy sa ta. Cha zydua cha Zawkatâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Semâ pathlazy cha Apasâ, Selâh,
  </para>
  <para style="p">
    <verse number="25" style="v" />Ebe, Pele, Reu,
  </para>
  <para style="p">
    <verse number="26" style="v" />Seru, Nâhaw, Terâ nata
  </para>
  <para style="p">
    <verse number="27" style="v" />Abarâ zy ama châ. Abarâ cha Abarahâ a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abarahâ sawchapawzy cha Aisika nata Ismela zy ama châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hezy he ama pathlazy ama châ: Ismela sawchapaw uhtheipa cha Nebaiô châ ta, a pazipazy cha Kedâ, Adabe, Mibasâ,
  </para>
  <para style="p">
    <verse number="30" style="v" />Mismâ, Dumâ, Mâsâ, Hadâ, Temâ,
  </para>
  <para style="p">
    <verse number="31" style="v" />Zetu, Nâphi nata Kedemâ zy ama châ. Chazy cha Ismela pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abarahâ nôtho Keturâ pathlazy cha Zimrâ, Zôkasâ, Medâ, Midia, Isbâ nata Suah zy ama châ. Zôkasâ sawchapawzy cha Sebâ nata Dedâ zy ama châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Midia sawchapawzy cha Epha, Ephe, Hanô, Abidâ nata Eldâ zy ama châ. Cha zydua cha Keturâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abarahâ ta Aisika sa ta. Aisika sawchapawzy cha Esaw nata Izarei ama châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />Esaw sawchapawzy cha Eliphâ, Rue, Zeu, Zalâ nata Kôrâ zy ama châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eliphâ sawchapawzy cha Temâ, Ômâ, Zephi, Kâtâ, Kenâza, Timnâ nata Amale zy ama châ.
  </para>
  <para style="p">
    <verse number="37" style="v" />Rue sawchapawzy cha Nâhâ, Zerâ, Sâmâh nata Miza zy ama châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Seirâ sawchapawzy cha Lôtâ, Sôbâ, Zibeô, Ânah, Disaw, Eza nata Disâ zy ama châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lôtâ sawchapawzy cha Hôri nata Hômâ châ ei ta, Lôtâ sietanô cha Timnâ a châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Sôbâ sawchapawzy cha Alvâ, Mânahâ, Ebâ, Sephô nata Ônami zy ama châ. Zibeô sawchapawzy cha Aihza nata Ânah ama châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ânah sawchapawpa cha Disaw châ ta, Disaw sawchapawzy cha Hedâ, Esbâ, Itharâ nata Kherâ zy ama châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Eze sawchapawzy cha Bilhâ, Zavâ nata Zakâ zy ama châ. Disâ sawcha­pawzy cha Uzi nata Aranâ ama châ.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hezy he Izarei sawzy chô liata ryureituhpa bei ama y hlâta Edômâ râh liata ryureituhpa beizy ama châ: Beô sawchapawpa Belâ a bei ta, a khihpi moh cha Dinhabâ a châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />Belâ a thi tawhta, Bôzrâ khihpa Zerâ sawchapawpa Zôbabi ta ano su liata a bei ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Zôbabi a thi tawhta, Temâni râh chyhsa Husâ ta ano su liata â bei.
  </para>
  <para style="p">
    <verse number="46" style="v" />Husâ a thi tawhta, Môabâ râh liata Midia mo a pahnietuhpa Bedâ sawchapawpa Hâdâ ta ano su liata a bei ta, a khihpi moh cha Avi a châ.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hâdâ a thi tawhta, Mâsrekâ chyhsa Samlâ ta ano su liata â bei.
  </para>
  <para style="p">
    <verse number="48" style="v" />Samlâ a thi tawhta, Ufrâti chavah kiah liata Rehôbô khihpa Sawla ta ano su liata â bei.
  </para>
  <para style="p">
    <verse number="49" style="v" />Sawla a thi tawhta, Akabaw sawchapawpa Bâlâhanâ ta ano su liata â bei.
  </para>
  <para style="p">
    <verse number="50" style="v" />Bâlâhanâ a thi tawhta, Hâdâ ta ano su liata a bei ta, a khihpi moh cha Pai a châ. A lapinô moh cha Mehetabe châ ta, ano cha Mâteri sawchanô châ ta, Mâteri cha Mezahâ sawchanô a châ.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hâdâ cha thi ta. Edômâ beizy cha Bei Timnâ, Bei Alvâ, Bei Zethe,
  </para>
  <para style="p">
    <verse number="52" style="v" />Bei Ôhôlibâmâ, Bei Elâ, Bei Pinaw,
  </para>
  <para style="p">
    <verse number="53" style="v" />Bei Kenâza, Bei Temâ, Bei Miza,
  </para>
  <para style="p">
    <verse number="54" style="v" />Bei Mâdie nata Bei Irâmâ zy châ ei ta, âmo cha Edômâ beizy ama châ.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Izarei sawchapawzy ama châ: Rubena, Simeôna, Livai, Zudâh, Iskâra, Zebulawna,
  </para>
  <para style="p">
    <verse number="2" style="v" />Dânâ, Zawsi, Benzami, Nâthalai, Kâdâ nata Asera zy ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hezy he Zudâh pathlazy ama châ: Zudâh ta Kâna zuah Bâsua chô liata sawchapaw pathôh, Erâ, Ônâ nata Selâh zy sa ta. Zudâh sawchapaw uhtheipa Erâ cha Abeipa mohmô liata moleipa châ ta, Abeipa ta a thie haw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zudâh cha a myuhnô Tâmâri liata Pereza nata Zerâ sa ta. Zudâh sawchapaw zydua cha papangawh ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pereza sawchapawzy cha Hezrô nata Hâmu ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerâ sawcha­pawzy cha Zimri, Ethâ, Hemâ, Kâkaw nata Dârâ zy châ ei ta, ama zydua ta papangawh ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kâmi sawchapawpa cha Âkhâ châ ta, Âkhâ cha Izarei sawzy a patypamâtuhpa, pahleipadia awpa hraona sôh a parutuhpa kha a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ethâ sawchapawpa cha Azariah a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hezrô sawchapawzy cha Zerame, Râmi nata Kelubai zy ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Râmi ta Aminadâ sa ta, Aminadâ ta Zudâh pathlazy chhituhpa Nâsô sa ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nâsô ta Salmô sa ta, Salmô ta Bôaza sa ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />Bôaza ta Ôbedâ sa ta, Ôbedâ ta Zese sa ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zese ta sawchapaw uhtheipa Eliabâ sa ta, panona Abinadâ, pathôhna Simia,
  </para>
  <para style="p">
    <verse number="14" style="v" />papalihna Nethane, papangawhna Râdai,
  </para>
  <para style="p">
    <verse number="15" style="v" />pacharuna Ôze nata pasarina Dâvi zy sa ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ama sietanôzy cha Zeru nata Abikai zy ama châ. Zeru sawchapawzy cha Abisai, Zôabâ nata Asahe zy châ ei ta, pathôh ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abikai ta Amâsâ sa ta, Amâsâ paw cha Ismela chyhsa Zethe a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hezrô sawchapawpa Kâlebâ ta a lapinô Azubâ nata Zeriô chô liata sawzy sa ta, a sawchapawzy cha Zeserâ, Sôbâ nata Adô zy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Azubâ a thi tawhta, Kâlebâ ta Epharâ hnei ta, ano ta Hurâ sapa ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hurâ ta Uri sa ta, Uri ta Bezale a sa.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cha khai tawhta Hezrô cha Kilia paw Mâkhi sawchanô hnei ta. Kô sycharu a châ nota a hneipa a châ. Ano ta Seku sapa ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Seku ta Zairâ sa ta, ano cha Kilia râh liata khihpi miakih nata miathôh a hneipa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Châhrasala Kesu nata Aramia ta Kilia râh liata Havôzairâ nata Kenathâ khihpizy nata ama khichapeihzy, khih sycharu cha âmo tawhta la ei ta. Ama zydua heta Kilia paw Mâkhi pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hezrô a thi tawhta Kâlebâ cha a paw Hezrô lapinô Epharâthâ cha lapinô ta hnei ta, ano ta Asahu sapa ta, Asahu cha Tekô paw a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hezrô sawchapaw uhtheipa cha Zerame châ ta, Zerame sawchapaw uhtheipa cha Râmi a châ. Hezrô sawchapaw hropazy cha Bunâ, Ôre, Ôze nata Ahiza zy ama châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zerame ta lapinô hropa hnei ta, a moh cha Atarâ châ ta, ano cha Ônami nô a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zerame sawchapaw uhtheipa Râmi sawchapawzy cha Mâza, Zami nata Eke zy ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ônami sawchapawzy cha Sâmai nata Zadâ ama châ. Sâmai sawchapawzy cha Nâdâ nata Abisu ama châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abisu lapinô moh cha Abihai châ ta, ano ta Abisu châta Abâ nata Môli a sapa.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nâdâ sawchapawzy cha Sele nata Apai châ ei ta, Sele cha saw hnei leipa ta a thi haw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Apai sawchapawpa cha Isi châ ta, Isi sawchapawpa cha Sesâ a châ. Sesâ sawchapawpa cha Ahlai a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sâmai unawhpa Zadâ sawchapawzy cha Zethe nata Zawnathâ zy châ ei ta, Zethe cha saw hnei leipa ta a thi haw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zawnathâ sawchapawzy cha Pele nata Zaze ama châ. Âmo cha Zerame pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sesâ cha sawchapaw hnei leipa ta, sawchanôzy dei hnei ta. Sesâ cha Izi chyhsa Zarahâ ama tahpa sei hnei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sesâ ta a sawchanô cha a sei Zarahâ pahneisa ta, ano ta Atai sapa ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Atai ta Nâthâ sa ta, Nâthâ ta Zabâdi sa ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Zabâdi ta Ephalâ sa ta, Ephalâ ta Ôbedâ sa ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ôbedâ ta Zehu sa ta, Zehu ta Azariah sa ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Azariah ta Helezi sa ta, Helezi ta Eliasâ sa ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Eliasâ ta Sismai sa ta, Sismai ta Sâluh sa ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Sâluh ta Zekamiah sa ta, Zekamiah ta Elisâmâ a sa.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zerame unawhpa Kâlebâ sawchapaw uhtheipa cha Mâresâ châ ta, ano cha Ziphi paw a châ. Mâresâ sawchapawpa cha Hebraw a châ.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hebraw sawchapawzy cha Kôrâ, Tâpuah, Reke nata Semâ zy ama châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />Semâ ta Zawkia paw Râha sa ta, Reke ta Sâmai a sa.
  </para>
  <para style="p">
    <verse number="45" style="v" />Sâmai sawchapawpa cha Maô châ ta, Maô cha Bezu paw a châ.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kâlebâ nôtho Epha ta Harânâ, Môza nata Kaze zy sa ta, Harânâ ta Kaze a sa.
  </para>
  <para style="p">
    <verse number="47" style="v" />Zadai sawchapawzy cha Reke, Zawthâ, Kesâ, Pele, Epha nata Sâpha zy ama châ.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kâlebâ nôtho Mâkâ ta Sebe nata Tihânâ sa ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mâmanâh paw Sâpha nata Mâbenâ nata Kibia paw Sevâ zy sa hra ta. Kâlebâ sawchanô cha Akasâ a châ.
  </para>
  <para style="p">
    <verse number="50" style="v" />Âmo cha Kâlebâ pathlazy ama châ. Ephrâthâ sawchapaw uhtheipa Hurâ sawchapawzy cha Kiriaziari paw Sôbâ,
  </para>
  <para style="p">
    <verse number="51" style="v" />Bethlehe paw Salmâ nata Bekade paw Harepha zy ama châ.
  </para>
  <para style="p">
    <verse number="52" style="v" />Kiriaziari mo pathlatuhpa Sôbâ ta pathla hropazy hnei ta, âmo cha Hârôe mo nata Menuhô mo khophie zy ama châ.
  </para>
  <para style="p">
    <verse number="53" style="v" />Kiriaziari phozy cha Ithari mo, Puthi mo, Sumathi mo nata Misrai mozy châ ei ta, âmo tawhna heta Zôrâ mo nata Estaw mozy ama vaw pua.
  </para>
  <para style="p">
    <verse number="54" style="v" />Salmâ pathlazy cha Bethlehe mo, Netôpha mo, Atôbezôabâ mo, Mânahâ mo khophie nata Zôri mozy ama châ.
  </para>
  <para style="p">
    <verse number="55" style="v" />Zabia liata chârohtuhpa phozy chhao âmo pathla châ ei ta, âmo cha Tirathi mo, Simiathi mo nata Sukuthi mozy ama châ. Âmo he Keni mo châ ei ta, Rekabâ pathlazy paw Hâmathi tawhta a vaw puapazy ama châ.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Dâvi sawchapaw Hebraw khi liata a pihpazy ama châ. A sawchapaw uhtheipa cha Zezari zuah Ahinô chô liata a sapa Amanaw châ ta, a pazipa cha Kâmel zuah Abikai chô liata a sapa Dâniah châ ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />pathôhna cha Kesu bei Tâmai sawchanônô Mâkâ sawchapawpa Absalaw châ ta, papalihna cha Haki sawchapawpa Adôniza châ ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />papangawhna cha Abitâ chô liata a sapa Sephatiah châ ta, pacharuna cha a lapinô Ekalâ chô liata a sapa Itharia a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hebraw liata pacharu pih ei ta. Dâvi cha Hebraw liata kô sari nata thla charu a bei ta, Zerusale liata kô sythôh nata kô thôh â bei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dâvi sawchapaw Zerusale liata a pihpazy cha Simia, Sôbâ, Nâthâ nata Sawlawmaw zy châ ei ta, ama papalih heta Amie sawchanô Bâsua chô liata a sapazy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sawchapaw hropa pachaki hnei via ta, chazy cha Ibâ, Elisâmâ, Eliphele,
  </para>
  <para style="p">
    <verse number="7" style="v" />Nôkâh, Nephe, Zaphia,
  </para>
  <para style="p">
    <verse number="8" style="v" />Elisâmâ, Eliadâ nata Eliphele zy ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Âmo cha a nôthozy chô liata a sapazy rei pâ leipa ta, Dâvi sawchapawzy châ ei ta, ama sietanô cha Tâmâri a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sawlawmaw sawchapawpa cha Rehôbaw châ ta, Rehôbaw sawchapawpa cha Abizah châ ta, Abizah sawchapawpa cha Âsâ châ ta, Âsâ sawchapawpa cha Zehôsaphâ châ ta,
  </para>
  <para style="p">
    <verse number="11" style="v" />Zehôsaphâ sawchapawpa cha Zôrâ châ ta, Zôrâ sawchapawpa cha Ahazia châ ta, Ahazia sawchapawpa cha Zôasâ châ ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />Zôasâ sawchapawpa cha Amazia châ ta, Amazia sawchapawpa cha Azariah châ ta, Azariah sawchapawpa cha Zôthâ châ ta,
  </para>
  <para style="p">
    <verse number="13" style="v" />Zôthâ sawchapawpa cha Ahâza châ ta, Ahâza sawchapawpa cha Hezekia châ ta, Hezekia sawchapawpa cha Manase a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manase sawchapawpa cha Amawna châ ta, Amawna sawchapawpa cha Zôsia a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hezy he Zôsia sawchapawzy ama châ: A sawchapaw uhtheipa cha Zôhanâ châ ta, panona Zehôki châ ta, pathôhna Zedekia châ ta, papalihna cha Sâluh a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zehôki sawchapawzy cha Zekôniah nata Zedekia zy ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sei ta amâ chhipa Zekôniah sawchapawzy cha Siatie,
  </para>
  <para style="p">
    <verse number="18" style="v" />Malkirâ, Pedai, Senâza, Zekamiah, Hôsamâ nata Nedabiah zy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pedai sawchapawzy cha Zerubâbe nata Simei ama châ. Zerubâbe sawchapawzy cha Mesulâ nata Hânaniah châ ei ta, ama sietanô cha Selômi a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zerubâbe ta sawchapaw hropa papangawh hnei ta, chazy cha Hâsubâh, Ôhe, Berekiah, Hâsadiah nata Zusâhese zy ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hânaniah sawchapawzy cha Pelatiah nata Zesai zy ama châ. Zesai sawchapawpa cha Rephiah châ ta, Rephiah sawchapawpa cha Ânâ châ ta, Ânâ sawchapawpa cha Ôbadia châ ta, Ôbadia sawchapawpa cha Sekaniah a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sekaniah sawcha­pawpa cha Semiah châ ta, Semiah sawchapawzy cha Hâtu, Ikâ, Bâriah, Niariah nata Saphâta zy châ ei ta, pacharu ama châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Niariah sawchapawzy cha Eliônai, Hizakiah nata Azrikâ zy châ ei ta, pathôh ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Eliônai sawchapawzy cha Hôdaviah, Eliasi, Peliah, Aku, Zôhanâ, Deliah nata Anani zy châ ei ta, pasari ama châ.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zudâh sawchapawzy cha Pereza, Hezrô, Kâmi, Hurâ nata Sôbâ zy ama châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sôbâ sawchapawpa Reai ta Zahâ sa ta, Zahâ ta Ahumai nata Lâhâ a sa ei. Âmo cha Zôrâ phozy ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Etamâ sawchapaw­zy cha Zezari, Ismâ nata Idabâ zy châ ei ta, ama sietanô moh cha Hâzelepôni a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Penia ta Kedaw sa ta, Eze ta Husah a sa. Âmo cha Bethlehe paw Ephrâthâ sawchapaw uhtheipa Hurâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tekô paw Asahu ta lapinô pano, Helâ nata Nârâ hnei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nârâ chô liata Ahuzamâ, Hepha, Temeni nata Hâhastâri zy sa ta. Âmo cha Nârâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Helâ sawchapawzy cha Zerethâ, Izah nata Ethanâ zy ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kôza ta Anu, Zôbebâ nata Hâru sawchapawpa Ahahe phozy pathla ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zabia cha a unawhzy hlâta zachhih viapa châ ta, a nô ta, “Riethei pasa ngaitapa ta ei sapa a châ,” tah ta a moh Zabia a bi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zabia ta Izarei Khazohpa pado ta, a hnohta, “Byhnâ na piepa ta, ei râh he na pakawhpa la ei tah kaw dia! Ei chô liata na ku y sala, riethei pasana ei chô liata a tlô lei nawpa ta, nâ pasasa thei awpa tawhta na pabohsa mah y!” tah ta. Khazohpa ta a hiapa cha pie ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Suhâ unawhpa Kheluh ta Mehi sa ta, Mehi ta Estaw sa ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Estaw ta Berâpha, Pâsia nata Inahâ paw Tehinâ zy sa ta. Âmo cha Rekâ mo ama châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kenâza sawchapawzy cha Ôthane nata Seriah châ ei ta, Ôthane sawchapawzy cha Hâthâh nata Menôthai ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Menôthai ta Ôpharâ sa ta, Seriah ta Keharâ mo pathlatuhpa Zôabâ sa ta. Âmo cha zôthaipa ama châpa vâta Keharâ mo tahpa a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zephune sawchapawpa Kâlebâ sawchapawzy cha Iru, Elâ nata Nâmi zy châ ei ta, Elâ sawchapawpa cha Kenâza a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zehalele sawchapawzy cha Ziphi, Ziphâ, Tiria nata Azre zy ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ezrah sawchapawzy cha Zethe, Meredâ, Ephe nata Zalô zy ama châ. Meredâ ta Phiraoh sawchanô Bithiah hnei ta, Bithiah cha saw phaoh ta, Miria, Sâmai nata Estemô paw Isbâ zy a sa ei.
  </para>
  <para style="p">
    <verse number="18" style="v" />A lapinô Zudâh zuah ta Kedaw paw Zere, Sôkô paw Hebe nata Zanô paw Zekuthie zy sa ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hôdiah ta Nâhamâ sietanô hnei ta, a sawchapawzy cha Kâmi mo pathlatuhpa Keilâh nata Mâkâ mo pathlatuhpa Estemô zy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Simô sawchapawzy cha Amanaw, Rinâ, Benhanâ nata Tilô zy ama châ. Isi sawcha­pawzy cha Zôhe nata Benzôhe ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zudâh sawchapawpa Selâh sawchapawzy cha Lekâ paw Erâ, Mâresâ paw Lâdâh nata Bethabia liata poh rih dipa taotuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zôki, Kôzebâ mo, Zôasâ nata Môabâ nata Zasubilahe liata ryureituhpa Sârâpha zy chhao Selâh sawchapawzy ama châ hra. Cha kyh cha hlâno châropazy tawhta hmôpa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Âmo cha Netai nata Kederâ liata a pahrâpa beihvituhpazy châ ei ta, bei châta rai hria awpa ta, cha liata a pahrâpazy ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simeôna sawchapawzy cha Nemua, Zami, Zari, Zerâ nata Sawla zy ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sawla sawchapaw­pa cha Sâluh châ ta, Sâluh sawchapawpa cha Mibasâ châ ta, Mibasâ sawchapawpa cha Mismâ a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mismâ sawchapawpa cha Hâmua châ ta, Hâmua sawchapawpa cha Zaku châ ta, Zaku sawchapawpa cha Simei a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Simei ta sawchapaw pahrawh hleicharu nata sawchanô pacharu hnei ta, a unawhzy deikua saw sa hluh veih ei. Ama pho chhao Zudâh mo hawhta pôh thei veih ei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bâsebâ, Môladâ, Hâzasua,
  </para>
  <para style="p">
    <verse number="29" style="v" />Bilhâh, Ezemâ, Tôlâ,
  </para>
  <para style="p">
    <verse number="30" style="v" />Bethua, Hômâ, Zikalâ,
  </para>
  <para style="p">
    <verse number="31" style="v" />Bemâkabô, Hâzasusi, Bethabiri nata Saraimi khihpizy liata ama pahrâ. Chazy cha Dâvi â bei hlâta ama khihpizy a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Khichapeih miapangawh hnei ei ta, chazy cha Etamâ, Ainâ, Rimô, Tôkhe nata Asanâ zy châ ta,
  </para>
  <para style="p">
    <verse number="33" style="v" />khihpizy chadôpa ta Bâlâ taihta khichapeih zydua chhao amâ hlao. Chazy cha ama pahrâna suzy châ ta, ama thyutôna rona châbu chhao amâ vao.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mesôbâ, Zamale, Amazia sawchapawpa Zôsâh,
  </para>
  <para style="p">
    <verse number="35" style="v" />Zôela nata Zôsibiah sawchapawpa Zehu zy chhao Simeôna pathlazy ama châ. Zôsibiah paw cha Seriah châ ta, Seriah paw cha Asie a châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eliônai, Zakôbâ, Zesôhai, Asiah, Adie, Zesimie, Benai nata
  </para>
  <para style="p">
    <verse number="37" style="v" />Siphi sawchapawpa Ziza zy chhao Simeôna pathlazy ama châ. Siphi paw cha Alaw châ ta, Alaw paw cha Zediah châ ta, Zediah paw cha Simri châ ta, Simri paw cha Semiah a châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />He liata ama moh paziahpazy he ama pho hyutuhpazy châ ei ta, ama pathlazy thata ama pôh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ama sahrohzy châta sibiepa yna suzy tlua laihpa ta, saikao nochhi lâta Kedaw angiana taihta sie ei ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cha liata sahroh lao pabâsa nawpa sibiepa hluhna nata phana su hmô ei ta, a râh chhao kawh ngaita ta, dâhthloh ta, thlalôh a chhih kawpa râh a châ. Cha liata a vaw pahra tuapazy cha Hamâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Zudâh pathla moh ropazy he Zudâh bei Hezekia â bei daihti liata a ngiapa châ ei ta, Hamâ mo poh ozy parao ei ta, cha liata a ypa Muni mo chhao ama pahleipadia khai haw. Pahleipadia khaipa ama châpa cha tanoh taihta hmô thei awpa ta a y. Sahroh châta sibiepa a ypa vâta, Muni mo su liata Simeôna mo ama pahrâ haw.
  </para>
  <para style="p">
    <verse number="42" style="v" />Simeôna pathlazy hry tawhta chyhsa za pangawh cha, Isi sawchapawpa Pelatiah, Niariah, Rephiah nata Uzie zy chhihthana ry liata Seirâ Tlâh lâ sie ei ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amale mo a râpaipa laibâhpazy pahnie ei ta, tanoh taihta cha liata ama pahrâ haw.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Izarei sawchapaw uhtheipa Rubena pathlazy ama châ. Rubena cha sawchapaw uhtheipa châ ta, châhrasala a paw rakhô a papuapaleipa vâta, sawchapaw uhthei châna tovyuh cha Izarei sawchapawpa Zawsi sawchapawzy hnohta piepa châ ha ta, chavâta pathlatuhpazy alaichadaina liata chhao, sawchapaw uhtheipa hawhta a laichadaipa châ khao vei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zudâh cha a unawhzy hry liata thatlô chaipa châ ta, ryureituhpa chhao ano tawhta pua ta, châhrasala sawchapaw uhtheipa tovyuh deikua cha Zawsi eih a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Izarei sawchapaw uhtheipa Rubena sawchapawzy cha Hanô, Pâluh, Hezrô nata Kâmi zy ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zôela sawchapawpa cha Semiah châ ta, Semiah sawchapawpa cha Kawkâ châ ta, Kawkâ sawchapawpa cha Simei châ ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />Simei sawchapawpa cha Mikâ châ ta, Mikâ sawchapawpa cha Reai châ ta, Reai sawchapawpa cha Bâlâ châ ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />Bâlâ sawchapawpa cha, Asuria bei Tikalâpilesa ta sei ta â chhipa Berâh kha châ ta, Rubena pathlazy hyutuhpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama chhâzy thyutôna ro nota, a pho pho ta a laichadaipa ta, Rubena pathla hyutuhpazy cha, Zeili, Zekaria nata
  </para>
  <para style="p">
    <verse number="8" style="v" />Azazi sawchapawpa Belâ zy ama châ. Azazi paw cha Semâ châ ta, Semâ paw cha Zôela châ ta, ano cha Arôerâ tawhta Nebô nata Bâlâmeô taihta a pahrâpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kilia râh liata ama sahroh thata a pôhpa vâta, nochhi lâta râhchawhpa angiana tawhta Ufrâti chavah notla baih lâ taihta ama pahrâ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sawla â bei daihti liata Hâkari mo a dyuh ei ta, ama pahnie haw. Chatanachata Kilia nochhi lâ râh zydua liata ama poh ozy liata ama pahrâ haw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kâdâ pathlazy cha Rubena pathlazy kiapâh Bâsanâ râh liata Sâlekâ taihta pahrâ ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama hyutuhpa cha Zôela châ ta, a pazipazy cha Saphâ, Zanai nata Bâsanâ râh liata Saphâta zy ama châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />A chhôh chhôh ta a laichadaipa ta ama unawh hropazy cha Mikaila, Mesulâ, Sebâ, Zôrai, Zakâ, Zia nata Ebe zy châ ei ta, pasari ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hezy he Huri sawchapawpa Abihai pathlazy ama châ. Huri cha Zarôh sawchapawpa châ ta, Zarôh cha Kilia sawchapawpa châ ta, Kilia cha Mikaila sawchapawpa châ ta, Mikaila cha Zesisai sawchapawpa châ ta, Zesisai cha Zâhdô sawchapawpa châ ta, Zâhdô cha Buzi sawchapawpa a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kuni sawchapawpa Abadie sawchapawpa Ahi cha ama phozy hyutuhpa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kilia liata pahrâ ei ta, Bâsanâ râh nata a khichapeihzy liata chhao pahrâ ei ta, si panyupa yna Saraw râh zydua liata ama râhri taihta ama pahrâ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha zydua cha Zudâh bei Zôthâ â bei nota nata Izarei bei Zerôbaw â bei nota thyutôna alaichadaina châbu liata ro khaipa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rubena chi, Kâdâ chi nata Manase chi khophiezy ta vyhphao nata zaozi a chaba theipa nata li a ka theipa pasaiphazy hnei ei ta, adyuhzie a thaipa nata adyuhna lâ a sie thei awpa pheisaih 44,760 ama hnei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hâkari mo, Zetu mo, Nâphi mo nata Nôdâ mozy siehnao ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adyuhna liata Khazohpa lâ thlahchhâ ei ta, ano ama ngâpa vâta, a para ngaitapa ta ama hiana cha Khazohpa ta chyh-ei ta, Hâkari mo nata ama hnohta a ypa zydua cha ama ku liata a pie ha ei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ama sahrohzy, râraoseihpa 50,000, mietaku 250,000 nata alâ 2,000 siekhei ei ta, chyhsa chhao ahrohpa ta 100,000 ama siekhei haw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Adyuhna cha Khazohpa eih a châpa vâta, Rubena chi, Kâdâ chi nata Manase chi khophiezy ta Hâkari mo nata ama hnohta a ypa hluhpi cha thiepa ta papao ei ta, Izarei sawzy seichâna lâ siekheipa ta ama yna daihti taihta Hâkari mo râh liana cha ama pahrâ haw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nochhi lâta a pahrâpa Manase chi khophiezy cha hluh kaw ei ta, Bâsanâ tawhta Bâlâhamaw, Seni nata Hâmaw Tlâh taihta ama pôh lymâ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ama chi pawhrâhpazy cha Ephe, Isi, Elie, Azarie, Zeremiah, Hôdaviah nata Zadie zy ama châ. Âmo cha pasaipha nata chyhsa mohpathâhpazy châ ei ta, ama chi pawhrâhpazy ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Châhrasala âmo pathlatuhpazy Khazohpa chô liata ngâchhih leipa ei ta, Khazohpa ta ama hmiakô liata a pahleipadiapa, cha râh phopizy khazohzy liata ama sihryh haw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chavâta Izarei Khazohpa ta Asuria bei Puli palôh nata Asuria bei Tikalâpilesa palôh pathyu ta, Rubena chi, Kâdâ chi nata Manase chi khophie zy cha sei ta a chhi ta, Hâlâ, Hâbaw nata Hârâ khihpizy nata Kôzani chavah liata âmo cha soh ta, tanoh taihta cha liata ama y.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Livai sawchapawzy cha Kesao, Kôhâ nata Merâri zy ama châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kôhâ sawchapawzy cha Amrâ, Iza, Hebraw nata Uzie zy ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amrâ pathlazy cha Arawna, Mawsi nata Miria zy ama châ. Arawna sawchapawzy cha Nâdâ, Abihu, Eliaza nata Ithamâ zy ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eliaza ta Phinehâ sa ta, Phinehâ ta Abisua sa ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />Abisua ta Buki sa ta, Buki ta Uzizi sa ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />Uzizi ta Zerahiah sa ta, Zerahiah ta Meraiô sa ta,
  </para>
  <para style="p">
    <verse number="7" style="v" />Meraiô ta Amaria sa ta, Amaria ta Ahitu sa ta,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahitu ta Zadô sa ta, Zadô ta Ahimazi sa ta,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahimazi ta Azariah sa ta, Azariah ta Zôhanâ sa ta,
  </para>
  <para style="p">
    <verse number="10" style="v" />Zôhanâ ta Azariah sa ta, ano cha Zerusale liata Sawlawmaw paduapa Achhyna o liata theihthaipa rai a hriapa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Azariah ta Amaria sa ta, Amaria ta Ahitu sa ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahitu ta Zadô sa ta, Zadô ta Sâluh sa ta,
  </para>
  <para style="p">
    <verse number="13" style="v" />Sâluh ta Hikia sa ta, Hikia ta Azariah sa ta,
  </para>
  <para style="p">
    <verse number="14" style="v" />Azariah ta Seriah sa ta, Seriah ta Zehôzadâ sa ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Abeipa ta Zudâh râh nata Zerusale khihpi Nebukaneza ku liata seichâna lâ a pasiesa nona khata, Zehôzadâ chhao sei­châna lâ a sie ha hra.
  </para>
  <para style="p">
    <verse number="16" style="v" />Livai sawchapawzy cha Kesao, Kôhâ nata Merâri zy ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kesao sawchapawzy moh cha Libani nata Simei a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kôhâ sawchapawzy cha Amrâ, Iza, Hebraw nata Uzie zy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merâri sawchapawzy cha Mâhli nata Musi ama châ. Hezy he ama pathlatuhpazy tawhta a laichadaipa ta Livai phozy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kesao sawchapawpa cha Libani châ ta, Libani sawchapawpa cha Zahâ châ ta, Zahâ sawchapawpa cha Zimâ châ ta,
  </para>
  <para style="p">
    <verse number="21" style="v" />Zimâ sawchapawpa cha Zôah châ ta, Zôah sawchapawpa cha Idô châ ta, Idô sawchapawpa cha Zerâ châ ta, Zerâ sawchapawpa cha Ziatherai a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hezy he Kôhâ pathlazy ama châ: Kôhâ sawchapawpa cha Aminadâ châ ta, Aminadâ sawchapawpa cha Kôrâ châ ta, Kôrâ sawchapawpa cha Asi châ ta,
  </para>
  <para style="p">
    <verse number="23" style="v" />Asi sawchapawpa cha Elkânâ châ ta, Elkânâ sawchapawpa cha Ebiasâ châ ta, Ebiasâ sawchapawpa cha Asira châ ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />Asira sawchapawpa cha Tahâ châ ta. Tahâ sawchapawpa cha Urie châ ta, Urie sawchapawpa cha Uzia châ ta, Uzia sawchapawpa cha Sawla a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Elkânâ pathlazy cha Amasai nata Ahimô châ ei ta,
  </para>
  <para style="p">
    <verse number="26" style="v" />Elkânâ sawchapawpa cha Zôphai châ ta, Zôphai sawchapawpa cha Nâhâ châ ta,
  </para>
  <para style="p">
    <verse number="27" style="v" />Nâhâ sawchapawpa cha Eliabâ châ ta, Eliabâ sawchapawpa cha Zerôhâ châ ta, Zerôhâ sawchapawpa cha Elkânâ a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Samuela sawchapaw uhtheipa cha Zôela châ ta, panona cha Abizah a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hezy he Merâri pathlazy ama châ: Merâri sawchapawpa cha Mâhli châ ta, Mâhli sawchapawpa cha Libani châ ta, Libani sawchapawpa cha Simei châ ta, Simei sawchapawpa cha Uza châ ta,
  </para>
  <para style="p">
    <verse number="30" style="v" />Uza sawchapawpa cha Simia châ ta, Simia sawchapawpa cha Hâkiah châ ta, Hâkiah sawchapawpa cha Asiah a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hezy he Zerusale liata Byh â pahâ tawhta Abeipa o liata hla chhituhpazy châta Dâvi ta a raopa­zy ama châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sawlawmaw ta Zerusale liata Abeipa Achhyna o a sa hlâta cha, ahmaohna poh o byureih liata hla sapa ta chakao tyh ei ta, taozie awpa raopa hawhta ama chakaona rai ama hria tyh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hezy he hla chhihthana rai hriatuhpazy nata ama sawchapawzy ama châ. Hezy he Kôhâ pathlazy tawhta hla sa thaipazy ama châ. Hlasathaipa Hemâ cha Zôela sawchapawpa châ ta, Zôela paw cha Samuela châ ta,
  </para>
  <para style="p">
    <verse number="34" style="v" />Samuela paw cha Elkânâ châ ta, Elkânâ paw cha Zerôhâ châ ta, Zerôhâ paw cha Elie châ ta, Elie paw cha Toâh châ ta,
  </para>
  <para style="p">
    <verse number="35" style="v" />Toâh paw cha Zupha châ ta, Zupha paw cha Elkânâ châ ta, Elkânâ paw cha Mâhâ châ ta, Mâhâ paw cha Amasai châ ta,
  </para>
  <para style="p">
    <verse number="36" style="v" />Amasai paw cha Elkânâ châ ta, Elkânâ paw cha Zôela châ ta, Zôela paw cha Azariah châ ta, Azariah paw cha Zephania châ ta,
  </para>
  <para style="p">
    <verse number="37" style="v" />Zephania paw cha Tahâ châ ta, Tahâ paw cha Asi châ ta, Asi paw cha Ebiasâ châ ta, Ebiasâ paw cha Kôrâ châ ta,
  </para>
  <para style="p">
    <verse number="38" style="v" />Kôrâ paw cha Izah châ ta, Izah paw cha Kôhâ châ ta, Kôhâ paw cha Livai châ ta, Livai paw cha Izarei a châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hlasathaipa Hemâ baotuhpa cha a unawhpa Asâpha châ ta, ano cha Hemâ chachâh lâta a duah tyhpa a châ. Asâpha paw cha Berekiah châ ta, Berekiah paw cha Simia châ ta,
  </para>
  <para style="p">
    <verse number="40" style="v" />Simia paw cha Mikaila châ ta, Mikaila paw cha Bâsiah châ ta, Bâsiah paw cha Mâkia châ ta,
  </para>
  <para style="p">
    <verse number="41" style="v" />Mâkia paw cha Ethâni châ ta, Ethâni paw cha Zerâ châ ta, Zerâ paw cha Adiah châ ta,
  </para>
  <para style="p">
    <verse number="42" style="v" />Adiah paw cha Ethâ châ ta, Ethâ paw cha Zimâ châ ta, Zimâ paw cha Simei châ ta,
  </para>
  <para style="p">
    <verse number="43" style="v" />Simei paw cha Zahâ châ ta, Zahâ paw cha Kesao châ ta, Kesao paw cha Livai a châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chavei lâta a duah tyhpa cha a unawhpa Merâri sawchapawpa Ethâ a châ. Ethâ paw cha Kisi châ ta, Kisi paw cha Abadi châ ta, Abadi paw cha Mâluh châ ta,
  </para>
  <para style="p">
    <verse number="45" style="v" />Mâluh paw cha Hâsabiah châ ta, Hâsabiah paw cha Amazia châ ta, Amazia paw cha Hikia châ ta,
  </para>
  <para style="p">
    <verse number="46" style="v" />Hikia paw cha Amazi châ ta, Amazi paw cha Bâni châ ta, Bâni paw cha Seme châ ta,
  </para>
  <para style="p">
    <verse number="47" style="v" />Seme paw cha Mâhli châ ta, Mâhli paw cha Musi châ ta, Musi paw cha Merâri châ ta, Merâri paw cha Livai a châ.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ama unawhpa Livai chizy cha Khazohpa achhyna byureih chakaona raihria zydua hria awpa ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="49" style="v" />Arawna nata a pathlazy deikua cha­, Khazohpa chakaotuhpa Mawsi ta bie a vaw piepa zydua hawhta, Su Pathaih Chaipa raihria zydua hriapa ta, Izarei châta chatlaina tao awpa ta, raopa hlâna maisâh liata nata ropahâhpa hlâna maisâh liata atheihna hlâna chakaona rai a hriatuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hezy he Arawna pathlazy ama châ: Arawna sawchapawpa Eliaza sawchapawpa cha Phinehâ châ ta, Phinehâ sawchapawpa cha Abisua châ ta,
  </para>
  <para style="p">
    <verse number="51" style="v" />Abisua sawchapawpa cha Buki châ ta, Buki sawchapawpa cha Uzizi châ ta, Uzizi sawchapawpa cha Zerahiah châ ta,
  </para>
  <para style="p">
    <verse number="52" style="v" />Zerahiah sawchapawpa cha Meraiô châ ta, Meraiô sawchapawpa cha Amaria châ ta, Amaria sawchapawpa cha Ahitu châ ta,
  </para>
  <para style="p">
    <verse number="53" style="v" />Ahitu sawchapawpa cha Zadô châ ta, Zadô sawchapawpa cha Ahimazi a châ.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hezy he ama râh chhôh liata ama khihsa nawpa su pachhaihzie hawhta ama pahrâna suzy a châ: Nuby amâ daopa cha Arawna pathla Kôhâ phozy chô liata tlu tua chai ta,
  </para>
  <para style="p">
    <verse number="55" style="v" />Zudâh râh liata Hebraw khihpi nata a chheipâh si panyuna suzy piepa ama châ.
  </para>
  <para style="p">
    <verse number="56" style="v" />Khihpi lyuzy nata a khichapeihzy deikua Zephune sawchapawpa Kâlebâ piepa a châ.
  </para>
  <para style="p">
    <verse number="57" style="v" />Arawna pathlazy cha Zudâh râh liata abohna khihpizy piepa châ ei ta, chazy cha Hebraw, Libnâ nata a chheipâh si panyuna suzy, Zati, Estemô nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="58" style="v" />Hile nata a chheipâh si panyuna suzy, Debi nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="59" style="v" />Asanâ nata a chheipâh si panyuna suzy nata Beseme nata a chheipâh si panyuna suzy a châ.
  </para>
  <para style="p">
    <verse number="60" style="v" />Benzami chi râh tawhta Kibiô khihpi, Kebâ khihpi nata a chheipâh si panyuna suzy, Aleme khihpi nata a chheipâh si panyuna suzy nata Anathô khihpi nata a chheipâh si panyuna suzy piepa ama châ. Arawna pathla phozy châta khihpi piepa zydua cha khi hrawh hleithôh a châ.
  </para>
  <para style="p">
    <verse number="61" style="v" />Kôhâ pathla hropazy châta nuby a daopa châ ta, Manase chi khophie ryuto râh liata khih hrawh piepa ama châ.
  </para>
  <para style="p">
    <verse number="62" style="v" />Kesao pathlazy cha Iskâra chi ryuto râh, Asera chi ryuto râh, Nâthalai chi ryuto râh nata Bâsanâ liata Manase chi ryuto râhzy tawhta a pho pho ta khihpi miahrawh hleithôh piepa ama châ.
  </para>
  <para style="p">
    <verse number="63" style="v" />Merâri pathlazy cha Rubena chi ryuto râh, Kâdâ chi ryuto râh nata Zebulawna chi ryuto râhzy tawhta, nuby a daopa ta a pho pho ta khih hrawh hleino piepa ama châ.
  </para>
  <para style="p">
    <verse number="64" style="v" />Cha hawhna chata Izarei sawzy ta Livai chizy cha khihpizy nata a chheipâh si panyuna suzy pie ei ta.
  </para>
  <para style="p">
    <verse number="65" style="v" />Zudâh chi ryuto râh, Simeôna chi ryuto râh nata Benzami chi ryuto râhzy tawhta khihpi moh palâsapazy he nuby a daopa ta piepa ama châ.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kôhâ pathla pho thokha cha Epharai mo ryuto râh liata khihpizy to ei ta.
  </para>
  <para style="p">
    <verse number="67" style="v" />Abohna khihpizy piepa châ ei ta, chazy cha Epharai tlâh râh liata Sekhe nata a chheipâh si panyuna suzy, Keze nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="68" style="v" />Zôkamia nata a chheipâh si panyuna suzy, Behôrô nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="69" style="v" />Aizalô nata a chheipâh si panyuna suzy nata Kâtharimô nata a chheipâh si panyuna suzy piepa ama châ.
  </para>
  <para style="p">
    <verse number="70" style="v" />Kôhâ pathla hropazy châta, Manase chi khophie ryuto râh liata Ane khihpi nata a chheipâh si panyuna suzy nata Bilia khihpi nata chhei­pâh si panyuna suzy ama pie.
  </para>
  <para style="p">
    <verse number="71" style="v" />Kesao pathlazy hnohta piepa khihpizy cha, Manase chi khophie ryuto râh Bâsanâ liata Kôlâ nata a chheipâh si panyuna suzy, Astarô nata a chheipâh si panyuna suzy;
  </para>
  <para style="p">
    <verse number="72" style="v" />Iskâra chi ryuto râh tawhta Kedesâ nata a chheipâh si panyuna suzy, Dâberâ nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="73" style="v" />Ramô nata a chheipâh si panyuna suzy, Anemi nata a chheipâh si panyuna suzy;
  </para>
  <para style="p">
    <verse number="74" style="v" />Asera chi ryuto râh liata Mâsalâ nata a chheipâh si panyuna suzy, Abadaw nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="75" style="v" />Hukô nata a chheipâh si panyuna suzy, Rehô nata a chheipâh si panyuna suzy;
  </para>
  <para style="p">
    <verse number="76" style="v" />Nâthalai chi ryuto râh liata Kâlili râh Kedesâ khihpi nata a chheipâh si panyuna suzy, Hâmô nata a chheipâh si panyuna suzy nata Kiriathai nata a chheipâh si panyuna suzy a châ.
  </para>
  <para style="p">
    <verse number="77" style="v" />Merâri pathla hropazy hnohta Zebulawna chi ryuto râh liata Rimaw nata a chheipâh si panyuna suzy, Tabaw nata a chheipâh si panyuna suzy;
  </para>
  <para style="p">
    <verse number="78" style="v" />Zerikô dady Zawdâh haosâ, Zawdâh nochhi lâta Rubena chi ryuto râh râhchawhpa liata Beze nata a chheipâh si panyuna suzy, Zazâh nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="79" style="v" />Kedemô nata a chheipâh si panyuna suzy, Mephâ nata a chheipâh si panyuna suzy;
  </para>
  <para style="p">
    <verse number="80" style="v" />Kâdâ chi ryuto râh liata Kilia râh Ramô khihpi nata a chheipâh si panyuna suzy, Mâhanai nata a chheipâh si panyuna suzy,
  </para>
  <para style="p">
    <verse number="81" style="v" />Hesbaw nata a chheipâh si panyuna suzy nata Zaze nata a chheipâh si panyuna suzy ama pie.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Iskâra ta sawchapaw papalih, Tola, Puah, Zasu nata Simrô zy sa ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tola sawchapaw­zy cha Uzizi, Rephiah, Zerie, Zamai, Ibasâ nata Semuela zy châ ei ta, âmo he Tola pathla pawhrâhpazy ama châ. Ama chhâzy liata pasaiphazy châ ei ta, Dâvi abeina daihti liata maluh 22,600 ama y.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uzizi sawchapawpa cha Izrâhia châ ta, Izrâhia sawchapawzy cha Mikaila, Ôbadia, Zôela nata Isiah zy châ ei ta, papangawh ama châ. Ama zydua ta ama pho pawhrâhpazy ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lapinô hluhpi hnei ei ta sawchapaw hluhpi ama sapa vâta, ama pathlazy cha a chhâ chhâ ta reipa ta, adyuhna lâ a sie theipa pheisaih 36,000 ama y.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thyutôna lâ tawhta a laichadaipa ta, Iskâra pathla pasaipha zydua cha maluh 87,000 ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benzami ta sawchapaw pathôh, Belâ, Bekhe nata Zedia zy hnei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Belâ sawchapawzy cha Ezbaw, Uzizi, Uzie, Zerimô nata Iri zy châ ei ta, papangawh ama châ. Âmo cha ama pathlazy pawhrâhpa nata pasaiphazy châ ei ta, thyutôna lâ tawhta a laichadaipa ta maluh 22,034 ama y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bekhe sawcha­pawzy cha Zemirâ, Zôasâ, Elieze, Eliônai, Ômri, Zeremô, Abiza, Anathô nata Aleme zy ama châ. Ama zydua ta Bekhe sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama pathla pawhrâhpazy chhâ thyutôna a laichadaipa ta, pasaipha maluh 20,200 ama y.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zedia sawchapawpa cha Bilhâ châ ta, Bilhâ sawchapawzy cha Zusi, Benzami, Ehu, Kenânâ, Zethâ, Tâsi nata Ahisahâ zy ama châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama pathla pawhrâhpazy tawhta a laichadaipa ta, ama zydua ta Zedia pathlazy châ ei ta, adyuhna lâ a sie theipa pasaipha maluh 17,200 ama y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Iri sawchapawzy cha Supi nata Hupi châ ei ta, Ahe sawchapawpa cha Husi a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nâthalai sawchapawzy cha Zazie, Kuni, Zeze nata Sâluh zy châ ei ta, âmo cha Bilhâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manase ta a nôtho Aramia zuah chô liata sawchapaw pano, Asrie nata Kilia paw Mâkhi sa ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mâkhi ta Hupi nata Supi mo tawhta lapinô hnei ta. A sietanô moh cha Mâkâ a châ. Mâkhi pathla hropa moh cha Zelôphehâ châ ta, ano cha sawchanôzy dei a hnei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mâkhi lapinô Mâkâ ta sawchapaw­ sa ta, a moh Peresi a bi. Peresi unawhpa moh cha Seresi châ ta, Peresi sawchapawzy cha Ulâ nata Rake ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ulâ sawchapawpa cha Bedâ a châ. Âmo cha Manase sawchapawpa Mâkhi sawchapawpa Kilia pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kilia sietanô Hâmôleke ta Isahô, Abieze nata Mâhlâ zy sa ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Semidâ sawchapawzy cha Ahiana, Sekhe, Likhi nata Ania zy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Epharai sawchapawpa cha Suthelâ châ ta, Suthelâ sawchapawpa cha Bere châ ta, Bere sawchapawpa cha Tahâ châ ta, Tahâ sawchapawpa cha Eliadâh châ ta, Eliadâh sawchapawpa cha Tahâ châ ta,
  </para>
  <para style="p">
    <verse number="21" style="v" />Tahâ sawchapawpa cha Zabâdi cha ta, Zabâdi sawchapawpa cha Suthelâ a châ. Epharai sawchapaw hropa Eze nata Elia zy cha, cha râh liata a pahrâpa Kâthâ khihsawzy ta ama sahroh zaw paru awpa ta a zu ei ta ama thie haw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ama paw Epharai cha noh hluhpi mâchhiesa ta, a unawhzy ano lâ sie ei ta, a thlah ama kei palôh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Epharai cha a lapinô lâ a ngia ta, saw phaoh ta, sawchapaw sa ta, ama ochhôh chhiena ta a tla thlupa vâta, a moh Beriah a bi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A sawchanô moh cha Serâ châ ta, ano ta Behôrô mathi nata Behôrô machhua zy padua ta, Uzeserâ khihpi chhao a padua.
  </para>
  <para style="p">
    <verse number="25" style="v" />Epharai sawchapaw hropa moh cha Repha châ ta, Repha sawchapawpa cha Resepha châ ta, Resepha sawchapawpa cha Telâ châ ta, Telâ sawchapawpa cha Tâhâ châ ta,
  </para>
  <para style="p">
    <verse number="26" style="v" />Tâhâ sawchapawpa cha Lâdâ châ ta, Lâdâ sawchapawpa cha Amihu châ ta, Amihu sawchapawpa cha Elisâmâ châ ta,
  </para>
  <para style="p">
    <verse number="27" style="v" />Elisâmâ sawchapawpa cha Nunâ châ ta, Nunâ sawchapawpa cha Zawsua a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama ryuto râh nata pahrânazy cha Bethel nata a khichapeihzy châ ta, nochhi lâta Nârâ, notla lâta Keze nata a khichapeihzy, Sekhe nata a khichapeihzy, Ai nata a khichapeihzy â hlao khai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Besai nata a khichapeihzy, Tânâ nata a khichapeihzy, Mekidô nata a khichapeihzy nata Daw nata a khichapeihzy chhao Manase pathlazy ryuto râh a châ hra. Cha suzy liata Izarei sawchapawpa Zawsi pathlazy ama pahrâ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Asera sawchapawzy cha Imnâ, Isvâ, Isvi nata Beriah zy châ ei ta, ama sietanô cha Serâ a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Beriah sawchapawzy cha Hebe nata Malkie châ ei ta, Malkie cha Bizai paw a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hebe ta Zaphâle, Sôme, Hôthâ nata ama sietanô Sua zy sa ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zaphâle sawchapawzy cha Pâsakâ, Bimhâ nata Asvâ zy ama châ. Âmo cha Zaphâle pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Seme sawchapawzy cha Ahi, Rôkâ, Zehubâ nata Aramia zy ama châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />A unawhpa Helema sawchapawzy cha Zôpha, Imnâ, Selesi nata Amâla zy ama châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zôpha sawchapaw­zy cha Suah, Hânephe, Suâ, Beri, Imrâh,
  </para>
  <para style="p">
    <verse number="37" style="v" />Beze, Hôdâ, Salmâ, Silsâh, Itharâ nata Beerâ zy ama châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zethe sawchapawzy cha Zephune, Pispâ nata Arâ zy ama châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ulâ sawchapawzy cha Arâh, Hânie nata Rizia zy ama châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ama zydua ta Asera pathla pawhrâhpa nata pasaipha ta pahnopa hyutuh chaipazy ama châ. Thyutôna a laichadaipa ta, adyuhna lâ a sie theipa maluh ropazy cha 26,000 ama châ.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Benzami ta a sawchapaw uhtheipa Belâ sa ta, panona Asabe, pathôhna Aharâh,
  </para>
  <para style="p">
    <verse number="2" style="v" />papalihna Nohâh, papangawhna Râhpha zy sa ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Belâ sawchapawzy cha Adarâ, Kerâ, Abihu,
  </para>
  <para style="p">
    <verse number="4" style="v" />Abisua, Nâmâ, Ahôh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kerâ, Sephupha nata Hurâ zy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezy he Ehu pathlazy ama châ. Âmo cha Kebâ liata a pahrâpa ama pathla pawhrâhpazy châ ei ta, Mânahâ lâ sei ta a chhipazy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chazy cha Nâmâ, Ahiza nata Kerâ zy ama châ. Kerâ cha Uza nata Ahihu paw a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sâharai ta a lapinô Husi nata Bârâ zy a padisa tawhta, Môabâ râh liata sawzy sa ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />A lapinô Hôde chô liata Zôbâ, Zibia, Mesâ, Malkâ,
  </para>
  <para style="p">
    <verse number="10" style="v" />Zuza, Sâchia nata Mimâh zy sa ta. Âmo cha Sâharai sawchapawzy châ ei ta, a chhôh chhôh ta pawhrâhpazy ama châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sâharai ta Husi chô lia chhao ta Abitu nata Elpâ sa ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elpâ sawchapawzy cha Ebe, Mismâ nata Seme zy châ ei ta, Seme he Ônô nata Lôdâ khihpizy nata ama khichapeihzy paduatuhpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Elpâ ta Beriah nata Semâ zy sa ta, âmo cha Aizalô liata pahrâpa ama pathla pawhrâhpazy châ ei ta, Kâthâ mo a papuatuhpazy kha ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahiô, Sâsakâ nata Zeremô zy chhao Elpâ sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebadiah, Aradâ, Ede,
  </para>
  <para style="p">
    <verse number="16" style="v" />Mikaila, Ispâ nata Zôha zy cha Beriah sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebadiah, Mesulâ, Hizki, Hebe,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ismerai, Izliah nata Zôbabi zy chhao Elpâ sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zaki, Zikari, Zabidi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Elienai, Zilethai, Elie,
  </para>
  <para style="p">
    <verse number="21" style="v" />Simei sawchapawzy cha Adiah, Berai nata Simrâ zy ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ispâ, Ebe, Elie,
  </para>
  <para style="p">
    <verse number="23" style="v" />Abadaw, Zikari, Hâna,
  </para>
  <para style="p">
    <verse number="24" style="v" />Hânaniah, Elâmi, Anatothizah,
  </para>
  <para style="p">
    <verse number="25" style="v" />Iphadiah nata Penia zy cha Sâsakâ sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Samserai, Sehariah, Athaliah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Zaresiah, Elaizâh nata Zikari zy cha Zerôhâ sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Âmo cha ama chhâ chyu liata ama pathla pawhrâhpazy châ ei ta, Zerusale liata a pahrâpazy ama châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kibiô mo pathlatuhpa Zeili cha Kibiô khihpi liata pahrâ ta, a lapinô moh cha Mâkâ a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />A sawchapaw uhtheipa cha Abadaw châ ta, a pazipazy cha Zuri, Kisâ, Bâlâ, Nâdâ,
  </para>
  <para style="p">
    <verse number="31" style="v" />Kedaw, Ahiô, Zekhe nata
  </para>
  <para style="p">
    <verse number="32" style="v" />Simiah paw Mikalô zy ama châ. Âmo cha Zerusale khihpi liata ama unawhzy kiapâh liata ama unawhzy nata hmaohkha ta ama pahrâ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nerâ ta Kisâ sa ta, Kisâ ta Sawla sa ta, Sawla ta Zawnathâ, Malkhisua, Abinadâ nata Esbâlâ zy sa ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zawnathâ sawchapawpa cha Meribâlâ châ ta, Meribâlâ ta Mikâ sa ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mikâ sawchapawzy cha Pithaw, Mele, Târia nata Ahâza zy ama châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahâza ta Zehôadâh sa ta, Zehôadâh ta Aleme, Azamâve nata Zimri zy sa ta, Zimri ta Môza sa ta,
  </para>
  <para style="p">
    <verse number="37" style="v" />Môza ta Binia sa ta, Binia ta Râphâ sa ta, Râphâ ta Eliasâ sa ta, Eliasâ ta Aze sa ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aze ta sawchapaw pacharu hnei ta, ama mohzy cha Azrikâ, Bôkeru, Ismela, Siariah, Ôbadia nata Hâna zy a châ. Cha zydua cha Aze sawcha­pawzy ama châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />A unawhpa Ese sawchapawzy cha, a sawchapaw uhtheipa Ulâ, panona Zeu nata pathôhna Eliphele zy ama châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ulâ sawchapawzy cha pasaipha thatlôpa nata likathaipazy châ ei ta, sawchapaw nata samoh hluhpi hnei ei ta, ama maluh 150 ama châ. Cha zydua cha Benzami pathlazy ama châ.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chatanachata Izarei saw zydua thyutôna cha roh khaipa châ ta, chazy cha Abeizy Châbu liata ropa a châ. Zudâh cha a paraona vâta Babylaw lâ sei ta a chhipa châ ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ama ryuto râh khihpizy liata a pahrâ pakhua heihpa hmiatuapazy cha Izarei saw thokhazy, theihthaipazy, Livai chizy nata Achhyna o liata chakaotuhpazy châ ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hezy he Zudâh, Benzami, Epharai nata Manase pathlazy hry tawhta Zerusale liata a pahrâpazy ama châ:
  </para>
  <para style="p">
    <verse number="4" style="v" />Amihu cha Uthai paw châ ta, Uthai cha Ômri paw a châ. Ômri cha Imri paw châ ta, Imri cha Bâni paw a châ. Âmo cha Zudâh sawchapawpa Pereza pathla­zy ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Silôni pathlazy cha, a sawchapaw uhtheipa Asiah nata a sawchapaw hropazy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerâ pathlazy cha Zue nata ama heinawh 690 zy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Benzami pathlazy cha, Salu paw Mesulâ, Mesulâ paw Hôdaviah nata Hôdaviah paw Hâsenuah zy ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ibaniah cha Zerôhâ sawchapawpa châ ta, Elâ cha Uzizi saw­chapawpa châ ta, Uzizi cha Mikari saw­chapawpa a châ. Mesulâ cha Sephatiah sawchapawpa châ ta, Sephatiah cha Rue sawchapawpa châ ta, Rue cha Ibenizah sawchapawpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />A chhâ chhâ ta reipa ta, heinawh 956 ama châ. Ama zydua ta ama pathla alaichadaina liata a chhôh chhôh ta pawhrâhpazy ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zerusale liata a pahrâ heihpa theihthaipazy cha Zediah, Zehôiari, Zaki nata
  </para>
  <para style="p">
    <verse number="11" style="v" />Hikia sawcha­pawpa Azariah zy ama châ. Hikia cha Mesulâ sawchapawpa châ ta, Mesulâ cha Zadô sawchapawpa a châ. Zadô cha Meraiô sawchapawpa châ ta, Meraiô cha Khazohpa o liata hyutuhpa Ahitu sawchapawpa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Adiah paw cha Zerôhâ châ ta, Zehôrâ cha Pâsu sawchapawpa châ ta, Pâsu cha Mâkia sawchapawpa a châ. Mâsai cha Adie sawchapawpa châ ta, Adie cha Zazerâh sawchapawpa châ ta, Zazerâh cha Mesulâ sawchapawpa a châ. Mesulâ cha Mesilemi sawchapawpa châ ta, Mesilemi cha Ime saw­chapawpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama heinawhzy rei pâpa ta, ama pho pawhrâhpa 1,760 y ei ta, Khazohpa o liata chakaona raihria liata a saomâ kawpazy ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hezy he Livai pathla Zerusale liata a pahrâ heihpazy ama châ: Hâsuba sawchapawpa cha Semiah châ ta, Hâsuba cha Azrikâ sawchapawpa a châ. Azrikâ cha Hâsabiah sawchapawpa châ ta, âmo cha Merâri pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Livai pathla hropazy cha Bâbakâ, Heresa, Kalâ nata Mâtaniah zy châ ei ta, Mâtaniah cha Mikhâ sawchapawpa a châ. Mikhâ cha Zikari sawchapawpa châ ta, Zikari cha Asâpha sawchapawpa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ôbadia cha Semiah sawchapawpa châ ta, Semiah cha Kalâ sawchapawpa châ ta, Kalâ cha Zeduthu sawchapawpa a châ. Berekiah cha Âsâ saw­chapawpa châ ta, Âsâ cha Netôpha mo khihzy liata pahrâpa Elkânâ sawchapawpa châ ta, âmo chhao Livai pathla ama châ hra.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chhikao vaituhpazy cha Sâluh, Aku, Talmaw, Ahimâ nata ama heinawhzy châ ei ta, Sâluh cha hyutuhpa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kha hlâta cha Livai mo riehmozy liata chhikao vaituhpa châ ei ta, nochhi lâta abei chhikao vaituhpazy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sâluh cha Kôre sawchapawpa châ ta, Kôre cha Ebiasâ sawchapawpa châ ta, Ebiasâ cha Kôrâ sawchapawpa a châ. Ebiasâ nata Kôrâ pathla a heinawhzy cha chakaona raihria kyh liata maophaohtuhpa ama châ. Âmo pathlatuhpazy cha Abeipa riehmo mohôhtuhpazy châ ei ta, chhikao vaituhpazy ama vaw châ tyhpa hawhta, âmo chhao poh o chhikao vaituhpazy ama châ hra.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kha hlâta cha Eliaza sawchapawpa Phinehâ cha ama hyutuhpa châ tyh ta, a hnohta Abeipa a y tyhpa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meselemia sawchapaw­pa Zekaria cha ahmaohna poh o chhikao vaituhpa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chhikao vaituhpa châta raopazy cha, ama zydua ta 212 ama châ. Ama thyutôna a laichadainazie hawhta, ama khih chyu liata ama moh ropa a châ. Âmo cha Dâvi nata hrohsopa Samuela ta ama maophaohna rai chyu liata ama padua.
  </para>
  <para style="p">
    <verse number="23" style="v" />Âmo nata ama sawzy cha Abeipa o chhikao vaina kyh liata maophaohtuhpa châ ei ta, achhyna byureih chhikaozy cha mohôhpa ta ama vaih tyh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chhikao vaituhpazy cha nochhi, notla, maw nata chho, kao palih liata ama y tyh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ama khihzy liata ama heinawhzy ta noh sari padai ta a thla tyh ei ta, ama rai ama bao tyh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chhikao vaituhpa hyutuh chaipa papalihzy cha Livai pathlazy châ ei ta, Khazohpa o chhôhpadâhpazy nata sôh sona mohôhna kyh liata maophaohnazy piepa ama châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Achhyna o mohôhna nata my chareih ta pahyna cha âmo maophaohna a châpa vâta, Khazohpa o chadôpa ta amâ riepâ tyh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thokha cha chakaona chhaichhi mohôhtuhpazy châ ei ta, amâ ngiakhei chy nata ama puakhei chy ta ama paki tyh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahropazy cha hmobaoh hropazy nata beiphiah pathaihpazy mohôh awpa nata viahdie dipa, kresawhti, sathaw, ropahâhpa nata ia-ôzy mohôh awpa ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Theihthaipa sawchapawpa thokhazy ta ia-ô pahlao awpazy ama pachhuapanoh tyh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kôrâ pho Sâluh sawchapaw uhtheipa Livai chi Mâtithiah cha viahchhâ phiapa taona liata maophaohtuhpa a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ama heinawh Kôhâ pathla thokha cha, viahchhâ chaluahpa taona liata maophaohtuhpazy châ ei ta, Pahânoh maihta amâ chhuanoh tyh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Livai pathla pawhrâhpa hlasathaipazy cha Achhyna o chhôhpadâhpazy liata y ei ta, chhô nah zâ ta hria awpa maophaohna ama hneipa vâta, rai hropazy tawhta pahuapa ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Âmo cha Livai pathla pawhrâhpa, ama chhâ chyu liata hyutuhpazy châ ei ta, Zerusale liata a pahrâpazy ama châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kibiô mo pathlatuhpa Zeili cha Kibiô khihpi liata pahrâ ta, a lapinô moh cha Mâkâ a châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />A sawchapaw uhtheipa cha Abadaw châ ta, a pazipazy cha Zuri, Kisâ, Bâlâ, Nerâ, Nâdâ,
  </para>
  <para style="p">
    <verse number="37" style="v" />Kedaw, Ahiô, Zekaria nata Mikalô zy ama châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mikalô cha Simia paw châ ta, âmo cha Zerusale liata ama heinawhzy kiapâh liata ama heinawhzy chhaota ama pahrâ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Nerâ ta Kisâ sa ta, Kisâ ta Sawla sa ta, Sawla ta Zawnathâ, Malkhisua, Abinadâ nata Esbâlâ zy sa ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Zawnathâ sawchapawpa cha Meribâlâ châ ta, Meribâlâ ta Mikâ sa ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mikâ sawchapawzy cha Pithaw, Mele, Târia nata Ahâza zy ama châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahâza ta Zarâh sa ta, Zarâh ta Aleme, Azamâve nata Zimri zy sa ta. Zimri ta Môza sa ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Môza ta Binia sa ta, Binia sawchapawpa cha Rephiah châ ta, Rephiah sawchapawpa cha Eliasâ châ ta, Eliasâ sawchapawpa cha Aze a châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />Aze ta sawchapaw pacharu hnei ta, ama mohzy cha Azrikâ, Bôkeru, Ismela, Siariah, Ôbadia nata Hâna zy a châ. Chazy cha Aze sawchapawzy ama châ.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Philistinâ mo ta Izarei a dyuh ei ta, Izarei mo cha Philistinâ mo hmiakô liata a râpai ei ta, Kibô Tlâh liata thiepa châ ei ta, ama pao haw.
  </para>
  <para style="p">
    <verse number="2" style="v" />Philistinâ mo ta Sawla nata a sawchapawzy cha a chadai ei ta, Sawla sawchapawpa Zawnathâ, Abinadâ nata Mekhisua zy thie ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Adyuhna cha ru ngaita ta, Sawla cha thata chadie ei ta, likathaipazy ta Sawla cha hmô ei ta hmah paphao ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sawla ta a chariah chhaichhi a chabatuhpa hnohta, “Na zaozi kha phia la, ei chhitlyuna taihta na vaw dy teh. Chataleipatala chopawtaileipazy a vy aw ei ta, einâ palai thlu pathlei aw ei na,” tah ta. Châhrasala a chariah chhaichhi a chabatuhpa cha a chi ngaitapa vâta tao ngâh leipa ta. Chatanachata Sawla cha a zaozi phia ta, a zaw thlu ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />A chariah chhaichhi chabatuhpa ta Sawla cha a thi haw tahpa a hmô nahta, ano chhao a zaozi a zaw thlu ta, thi ha hra ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha hawhna chata Sawla nata a sawchapaw pathôhzy cha thi ei ta, ama chhôhkha duata â raohpa ta ama thi khai haw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pheisaihzy a râpai ei ta, Sawla nata a sawchapawzy ama thipa cha, Saikao liata a ypa Izarei chyhsazy ta ama hmô nahta, ama khihpizy puasaipa ta â râpai khai ha ei ta. Philistinâ mo a vy ei ta, Izarei khihpizy liata ama vaw pahrâ haw.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mylâ ta, Philistinâ mo cha ama chariah thiepazy chysia pahluh awpa ta vawh ei ta, Kibô Tlâh liata Sawla nata a sawchapawzy ri a zawh thlâh hapa kei hmô ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sawla cha a chysia pahluh ei ta, a luh nata a chariah chhaichhizy la ei ta, thâtih phapa cha ama khazoh nothlahpazy nata chyh­sazy hnohta phuah awpa ta, Philistinâ râh zydua lâta chyhsa tuah ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sawla chariah chhaichhizy cha ama khazoh achhyna ozy liata soh ei ta, Dakao achhyna o liata a luh tawh ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zabekilia khihsaw zydua ta Philistinâ mo ta Sawla chô liata ama hmotaopa zydua ama thei nahta,
  </para>
  <para style="p">
    <verse number="12" style="v" />pasaipha zydua pua ei ta, Sawla nata a sawchapawzy ri kei la ei ta, Zabe khihpi lâ ama siekhei haw. Ama ruzy cha Zabe khihpi liata ôkâ tho ry liata pabu ei ta, noh sari chhôh kâhvileipa ta y ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sawla cha Abeipa châta ngâ â chhih leipa vâta a thi hapa a châ. Abeipa biepiepa zyh leipa ta, pachaothaipazy tlao a saohiah ta a pachaosa tyh ei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abeipa chhihthana tlua vei. Chavâta Abeipa ta Sawla cha thie ta, a khinarâh cha Zese sawchapawpa Dâvi hnohta a pie haw.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izarei saw zydua ta Hebraw liata Dâvi hnohta a hmaohpakhy ei ta, “Pachâ teh, na rupa nata na sapazy eima châ hih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sawla â beina daihti liana chhao khata, Izarei puakhei ta a ngiakhei tyhpa cha nâ na châ. Abeipa na Khazohpa ta na hnohta, ‘Ei phopi Izarei vaituhpa châ aw chi ta, ei phopi Izarei chô liata bei ta na y aw,’ a cha tah,” tah ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chatanachata Izarei machâ zydua cha Hebraw liata abei lâ a vy ei ta. Dâvi ta Hebraw liana cha Abeipa hmiakô liata ama hnohta bie hraih ta. Abeipa ta Samuela hmâpa ta a reipa hawhta, Dâvi cha Izarei bei châta sathawthu ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chatawhcha Dâvi nata Izarei saw zydua cha Zerusale lâ sie ei ta. Zerusale cha Zebu tah tyhpa châ ta, a râh liata a pahrâpa Zebu mo pahrâna khihpi a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zebu khihsawzy ta Dâvi hnohta, “He liata a vaw ngia thei aw va chi,” tah ei ta. Chatahrasala Dâvi ta Zaio thokhy cha la ta, cha cha Dâvi khihpi tahpa a vaw châ haw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dâvi ta, “Ahy rai Zebu mo a thie tuachaipa cha pheisaih hyutuh chaipa a châ aw,” tah ta. Zeru sawchapawpa Zôabâ khy tuachai ta, chatanachata ano cha pheisaih hyutuh chaipa ta taopa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dâvi cha thokhy chhôh liata pahrâ ta, chavâta cha khihpi cha Dâvi khihpi tahpa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Milô tawhta pathaopa ta khihpi zydua cha thokhy ta dôh ta, khihpi chhôh liata taopathi byuhpa hropazy cha Zôabâ ta taopathi ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dâvi cha Pheisaihzy Abeipa ta a hnohta a ypa vâta, rônah via lymâ ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hezy he Dâvi pasaiphazy châ ei ta, Abeipa bie ta Izarei thâtih a vaw reipa hawhta, Izarei zydua a paraohpa ta Dâvi bei ta taotuhpa nata a khinarâh liata thatlô ngaitapa ta baotuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />He he Dâvi pasaiphazy thâtih a châ: Hâkamôni chyhsa Zasôbia cha pasaipha pathôhzy hry liata hyutuh chaipa châ ta, chyhsa 300 chô liata asei pahieh ta, ei kha ta a thie khai theipa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pasaipha pathôhzy hry liata ano a pazipa cha, Ahôh chyhsa Dôdô sawchapawpa Eliaza a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ano cha Philistinâ mo ta a dyuh awpa ta amâ hmaohpakhyna su Pâsdâmi liata Dâvi hnohta a ypa kha a châ. Cha liata bâli sâh ta a biepa lyu y ta, Izarei pheisaihzy cha Philistinâ mo tawhta a râpai ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Eliaza deikua cha, lyu liah liata a duah ta, khâchâ vaih ta, Philistinâ mo cha thie ta, Abeipa ta pahniena rônahpa ta a pachha ei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pheisaih hyutuhpa sythôhzy hry liata hyutuh chaipa pathôhzy cha, lôpanô yna Adulâ lôpu liata a ypa Dâvi lâ zu ei ta, Philistinâ pheisaihzy cha Rephai Saikao liata riehmo paryh ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha nota Dâvi cha thokhy chhôh liata y ta, Philistinâ pheisaihzy cha Bethlehe liata y ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dâvi cha a dâhphi kaw ta, “Aw, Bethlehe liata tikhaoh ti, thokhy chhikao kiapâh liatapa kha doh awpa ta nâ piepa ama y mawh sala ei tah kaw dia!” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pasaipha pathôhzy ta Philistinâ pheisaihzy riehmo siepahliepa ta, thokhy chhikao kiapâh liata Bethlehe tikhaoh ti cha kei thaih ei ta, Dâvi lâ vaw cheih ei ta. Châhrasala doh ngâh khao leipa ta. Abeipa châta tlao patlai ta,
  </para>
  <para style="p">
    <verse number="19" style="v" />Dâvi ta, “He ti he ei Khazohpa hmiakô liata doh cheita aw va na. He chyhsazy heta ama hrona sokhâhpa ta he ti he kei thaih ei ta, ama hrona thisaih cha ei doh aw ma?” tah ta. Chavâta ti cha doh khao vei. Cha hmozy cha pasaipha pathôhzy ta ama tao.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zôabâ unawhpa Abisai cha pasaipha sythôh hry liata hyutuh chaipa châ ta, chyhsa 300 asei pahieh thlu ta, a thie khai hapa a châ. Chavâta pasaipha pathôhzy moh pha tona liata â hlao hra.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pasaipha pathôh hry liata pahlaopa a châ leipa chhao ta, âmo hlâta palyupalih tlâh viapa châ ta, Sythôh hry liata palyupalih tlâh chaipa châ ta, chavâta ama hyutuhpa ta ama tao.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zehôdâ sawchapawpa Benai cha Kâbaze chyhsa riahphapa châ ta, hmo rônahpazy a taotuhpa a châ. Môabâ chyhsa riahphapa pano thie ta, dâhaw tla daihti liata zu ta, khaohtlô liata chakeibarôhneipa a thiepa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Izi chyhsa pôh pahreihpa, dy pangawh a sâhpa chhao a thie haw. Izi chyhsa cha asei laipa, thaiphia hawhpa a chaba ta, Benai ta chôchahrei a chabapa ta za pangai ta, Izi chyhsa asei chabapa cha chhu ta, Izi chyhsa cha ano asei ta a dysao haw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cha hmozy cha Zehôdâ sawchapaw­pa Benai ta tao ta, chavâta pasaipha pathôhzy hawhta moh phana a to hra.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sythôhpazy hry liata cha palyupalih tlâh chaipa châ ta, châhrasala pasaipha pathôhzy hry liata deikua rei pâpa châ vei. Dâvi ta Benai cha abei vaituhpazy hyutuhpa ta a rao.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dâvi pasaiphazy cha Zôabâ unawhpa Asahe, Bethlehe khihpa Dôdô sawchapawpa Ehânâ,
  </para>
  <para style="p">
    <verse number="27" style="v" />Hârôri chyhsa Sâmô, Pelôni chyhsa Helezi,
  </para>
  <para style="p">
    <verse number="28" style="v" />Tekô khihpa Ike sawchapawpa Irâ, Anathô chyhsa Abieze,
  </para>
  <para style="p">
    <verse number="29" style="v" />Husâ chyhsa Sibekai, Ahôh chyhsa Ilai,
  </para>
  <para style="p">
    <verse number="30" style="v" />Netôpha chyhsa Mâharai, Netôpha chyhsa Bânâ sawchapawpa Heledâ,
  </para>
  <para style="p">
    <verse number="31" style="v" />Benzami pathla Kibia khihpa Ribai sawchapawpa Ithai, Pirathô chyhsa Benai,
  </para>
  <para style="p">
    <verse number="32" style="v" />Kâsi vahtiepa liata Hurai, Abâthi chyhsa Abie,
  </para>
  <para style="p">
    <verse number="33" style="v" />Bâharu chyhsa Azamâve, Salbôni chyhsa Eliabâ,
  </para>
  <para style="p">
    <verse number="34" style="v" />Kizô chyhsa Hâse, Hârâ chyhsa Saki sawchapawpa Zawnathâ,
  </para>
  <para style="p">
    <verse number="35" style="v" />Hârâ chyhsa Sâkhâ sawchapawpa Ahiama, Ur sawchapawpa Eliphâ,
  </para>
  <para style="p">
    <verse number="36" style="v" />Mekherâ chyhsa Hepha, Pelôni chyhsa Ahiza,
  </para>
  <para style="p">
    <verse number="37" style="v" />Kâmel chyhsa Hezrô, Ezbai sawchapawpa Nârai,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nâthâ unawhpa Zôela, Hâkari sawchapawpa Mibâ,
  </para>
  <para style="p">
    <verse number="39" style="v" />Amawna chyhsa Zele, Zeru sawchapawpa Zôabâ chariah chhaichhi chabatuhpa Berô chyhsa Nâharai,
  </para>
  <para style="p">
    <verse number="40" style="v" />Ithari chyhsa Irâ, Ithari chyhsa Kâre,
  </para>
  <para style="p">
    <verse number="41" style="v" />Hiti chyhsa Uria, Ahlai sawchapawpa Zabâ,
  </para>
  <para style="p">
    <verse number="42" style="v" />Rubena chyhsa Siza sawchapawpa Adinâ, Rubena chi hyutuhpa pakha nata a hnohta a ypa chyhsa sythôh,
  </para>
  <para style="p">
    <verse number="43" style="v" />Mâkâ sawchapawpa Hâna, Mithani chyhsa Zôsaphâ,
  </para>
  <para style="p">
    <verse number="44" style="v" />Asterâ chyhsa Uzia, Arôerâ chyhsa Hôthâ sawchapawpa Sâmâ nata Zeili,
  </para>
  <para style="p">
    <verse number="45" style="v" />Simri sawchapawpa Zedia nata a unawhpa Tizi chyhsa Zôha,
  </para>
  <para style="p">
    <verse number="46" style="v" />Mâhavi chyhsa Elie, Elnâ sawchapawpa Zeribai nata Zôsaviah, Môabâ chyhsa Ithamâh,
  </para>
  <para style="p">
    <verse number="47" style="v" />Mezôbâ chyhsa Elie, Ôbedâ nata Zasie zy ama châ.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi cha Kisâ sawchapawpa Sawla vâta puaei thei khao leipa ta a y nota, chyhsazy ta Zikalâ liata ano lâ a vy ei ta. Âmo cha adyuhna liata ano a baotuhpa pasaiphazy hry liata a hlao hrapazy ama châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Libaw a chabapazy châ ei ta, chavei chachâh ta li a ka thaipa nata cheisiah lô a siah thaipazy ama châ. Âmo cha Benzami pathla, Sawla heinawhzy ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hyutuh chaipa cha Ahieze châ ta, a pazipa cha Zôasâ a châ. Ama pano heta Kibia chyhsa Semâh sawchapawzy ama châ. Ahropazy cha Azamâve sawchapawpa Zezie nata Pele, Berâkâh, Anathô chyhsa Zehu,
  </para>
  <para style="p">
    <verse number="4" style="v" />sythôh hry liata pasaipha nata sythôh hyutuhpa Kibia chyhsa Isamai, Zeremiah, Zahâzie, Zôhanâ, Kederâ chyhsa Zôzabâ,
  </para>
  <para style="p">
    <verse number="5" style="v" />Eluzai, Zerimô, Bialiah, Semariah, Hâruphi chyhsa Sephatiah,
  </para>
  <para style="p">
    <verse number="6" style="v" />Kôrâ chyhsa Elkânâ, Isiah, Azare, Zôze nata Zasôbia,
  </para>
  <para style="p">
    <verse number="7" style="v" />Kedaw chyhsa Zerôhâ sawchapawpa Zôelâ nata Zebadiah zy ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kâdâ chi liata pasaipha thatlôpa nata chariah a dyuh thaipazy ta râhchawhpa thokhy liata a ypa Dâvi lâ amâ kei bai hra. Âmo cha vyhphao nata asei a hmâh thaipa châ ei ta, chakeibarôhneipa hmia phaoh ei ta, tlâh sakhihzy hawhta a chatliepa ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ama hyutuhpa cha Eze châ ta, panona Ôbadia, pathôhna Eliabâ,
  </para>
  <para style="p">
    <verse number="10" style="v" />papalihna Mismânâh, papangawhna Zeremiah,
  </para>
  <para style="p">
    <verse number="11" style="v" />pacharuna Atai, pasarina Elie,
  </para>
  <para style="p">
    <verse number="12" style="v" />pachariena Zôhanâ, pachakina Elzabâ,
  </para>
  <para style="p">
    <verse number="13" style="v" />pahrawhna Zeremiah nata hleikhana Mâkhabânai zy ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha Kâdâ pathlazy cha pheisaih hyutuhpazy châ ei ta, ama hry liata thatlô lei chaipa chhao ta za kha a tlu ta, thatlô chaipa cha sâh kha â tlu.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cha sahlao cha thla khana liata Zawdâh chavah a kao zydua a bie khai nota haosâ lâ kiah ei ta, saikao liata a pahrâpa zydua nochhi lâ nata notla lâ a parâpaisa khaipazy kha ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Benzami nata Zudâh chizy hry tawhta chyhsa thokha ta thokhy liata Dâvi lâ vawh ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dâvi cha âmo dy awpa ta pua ta, ama hnohta, “Na bao awpa ta adyhna bie rei awpa ta kei lâ a vypa nama châ khiahta cha, ei palôh ta châ pazao aw ei ta, ei ku liata hmo doleipa khâpa hmah y vei tahpa pahno thlâh hana chôta, ei khakhaipazy na patusa namâ chhuah khiahta deikua cha, miah pathlatuhpazy Khazohpa ta cha hmô ei sala, viari cha thô mawh ei sy,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sythôh chô liata hyutuhpa Amasai chô liata Thlahpa vaw tlô ta, ano chata, “Hy Dâvi y, na chyhsazy châ pi ta, Hy Zese sawchapawpa y, Na chhâh a châpazy eima châ hih! Thlalôhna, na chô liata thlalôhna y sala, Châ baotuhpazy chô liata thlalôhna y mawh sy! Na Khazohpa ta a cha bao lymâ hih,” tah ta. Chatawhcha Dâvi ta âmo cha a ly ta, a pheisaih hyutuhpazy ta a tao ha ei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sawla a dyuh awpa ta Philistinâ mo hnohta Dâvi a sie hra nota, Manase chi tawhta pheisaih thokhazy Dâvi lâ a vaw râ ei ta. Châhrasala Dâvi ta Philistinâ mo cha bao khao vei. Philistinâ ryureituhpazy ta reihpahmaoh ei ta, “A zibeipa Sawla chhâh a châpa ta, keimo luh tlao miah a la pathlei aw na,” tah ei ta, Dâvi cha ama pakuasa haw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zikalâ lâ a lie ta, Manase chi tawhta Adanâh, Zôzabâ, Zedia, Mikaila, Zôzabâ, Elihu nata Zilethai zy ta Dâvi cha amâ kei bai. Âmo cha pheisaih sâh kha hyutuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dâvi chariah a dyuhpazy amâ dyuhkhei tyh. Ama zydua ta pasaipha riahphapa nata pheisaih hyutuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Noh chareih ta Dâvi chhâh a châpa chyhsazy a vy lymâ ei ta, Khazohpa pheisaih hawhta, pheisaih hluh ngaitapa ama vaw châ haw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa bie hawhta, Sawla khinarâh cha Dâvi hnohta pie awpa ta, hezy he Hebraw liata Dâvi lâ a vypa, adyuhna chhaichhi atobipa pheisaih pyzy ama châ:
  </para>
  <para style="p">
    <verse number="24" style="v" />Zudâh pathla adyuhna chhaichhi atobipa, vyhphao nata asei a chabapa 6,800;
  </para>
  <para style="p">
    <verse number="25" style="v" />Simeôna pathla adyuhna liata pasaipha thatlô riahphapa 7,100;
  </para>
  <para style="p">
    <verse number="26" style="v" />Livai pathla 4,000;
  </para>
  <para style="p">
    <verse number="27" style="v" />Arawna pathla hyutuhpa Zehôdâ nata a hnohta a ypa 3,700;
  </para>
  <para style="p">
    <verse number="28" style="v" />thyutlia pasaipha riahphapa Zadô nata ano pho tawhta pheisaih hyutuhpa pakih nata pano;
  </para>
  <para style="p">
    <verse number="29" style="v" />Benzami pathla, Sawla heinawhpa, Sawla pathla chhâh a vaw châ tyhpazy tawhta 3,000;
  </para>
  <para style="p">
    <verse number="30" style="v" />Epharai pathla, ama phozy liata mohpathâhpa nata pasaipha riahphapa 20,800;
  </para>
  <para style="p">
    <verse number="31" style="v" />Manase chi khophie hry tawhta moh liahsa palâsapa ta, Dâvi bei ta tao awpa ta a vypa 18,000;
  </para>
  <para style="p">
    <verse number="32" style="v" />Iskâra pathla, noh nata daihti yzie pahno thai ei ta, Izarei ta a tao awpa a pahnopa hyutuhpa 200 nata ama chhihthana ry liata ama heinawh zydua;
  </para>
  <para style="p">
    <verse number="33" style="v" />Zebulawna pathla, adyuhna châta chariah chhaichhi pakipa ta a tobipa ta, achhuahna sianopa a hneipa pheisaih hlôpa 50,000;
  </para>
  <para style="p">
    <verse number="34" style="v" />Nâthalai pathla pheisaih hyutuhpa 1,000 nata vyhphao nata asei a chabapa pheisaih 37,000;
  </para>
  <para style="p">
    <verse number="35" style="v" />Dânâ pathla, chariah a dyuh awpa ta a mâ chiehpa 28,600;
  </para>
  <para style="p">
    <verse number="36" style="v" />Asera pathla, a dyuhzie thaipa nata a dyuh awpa ta a mâ chiehpa pheisaih 40,000;
  </para>
  <para style="p">
    <verse number="37" style="v" />Zawdâh haosâ lâta a ypa Rubena chi, Kâdâ chi nata Manase chi khophie zy tawhta adyuhna chhaichhi kipa ta atobipa pheisaih 120,000.
  </para>
  <para style="p">
    <verse number="38" style="v" />Cha pheisaih zydua cha chariah a dyuh thaipa châ ei ta, hrâsie awpa ta a mâ chiehpa ta a ypazy châ ei ta, Dâvi cha Izarei zydua chô liata bei ta tao awpa ta, palôh miakha phaohpa ta Hebraw lâ a siepazy ama châ. Cha hawh pyly ta, Izarei saw hropa zydua chhao ta, Dâvi bei ta tao awpa cha ama palôh â raoh khai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cha liata Dâvi hnohta niepa nata dopa ta ypa ta noh thôh châh ei ta. Ama unawhzy ta ama nie awpa nata do awpazy amâ vaw chhuahdy khai haw.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cha dei châ vei, lâhlapi ta a ypa ama heinawh Iskâra, Zebulawna nata Nâthalai râh tawh zy taihta, ama niedo awpazy cha alâzy, râraoseihpazy, arâzy nata viahchao tôhpazy paphaosapa ta ama vaw hlâ lymâ. Izarei liata thaphana y ta, chatanachata viahdie hluhpi, theiku viahchhâzy, kre sao pachawhpazy, kresawhtizy, sathawzy, viahchaozy nata mietakuzy phaopa ta, Hebraw khihpi lâ ama sie lymâ.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi ta hyutuhpa zydua, sâh kha hyutuhpazy nata za kha hyutuhpazy a saohiah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta Izarei zawpi ahmaohpakhypa zydua hnohta, “Nâmo ta a pha tah u la, Abeipa eima Khazohpa ta pha a tah khiahta cha, Izarei râh zydua liata eima unawh a ypazy nata khihpizy nata si panyuna su a hneipa khichapeihzy liata a ypa theihthaipazy nata Livai mozy lâ chyhsa tuah sih la, keimo lâ a vaw hmaoh awpa ta kei pahruasa ei suh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sawla daihti nona khata eima Khazohpa Byh pado leipa pi ta, tahmâ kei la heih ei suh u,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pahruana cha zawpizy ta a pha tah ei ta, Khazohpa Byh la awpa cha paryhsa ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dâvi ta Izi chavah Sihô tawhta Lebôhamâ taihta a ypa Izarei saw zydua cha, Kiriaziari khihpi liata a ypa Khazohpa Byh cha kei la awpa ta awpakhy ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatanachata Dâvi nata Izarei saw zydua cha, cherubizy luh chô beidyuchhai liata a tyuhpa Abeipa moh ta awpa Khazohpa Byh cha la awpa ta, Kiriaziari ama tahpa Zudâh râh liata Bâlâh khihpi lâ khy ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khazohpa Byh cha Abinadâ o tawhta talailih thiehpa ta siekhei ei ta, Uza nata Ahiô ta talailih cha haoh ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dâvi nata Izarei saw zydua cha hlasapa ta, totâzy, tlaipihzy, khoh chyhpazy, paotlâzy, chiahmiezy tôpa ta Khazohpa hmiakô liata ama theina zydua papuapa ta palyupalihna tao ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kidaw sawhri ama tlô nahta, viahchao tôhpazy amâ chapiapa vâta, Uza ta Byh cha patu a chhuahpa ta a ku kei paza ta,
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa cha Uza chô liata a hiehâh ta, Byh a patupa vâta tusao ta, cha liata Khazohpa hmiakô liata thi ha ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abeipa ta Uza chô liata ku a pathlapa vâta, Dâvi cha a hiehâh kaw ta. Chavâta cha su cha tanoh taihta Perezuza tahpa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha noh ta Dâvi ta Khazohpa cha chi ngaita ta, “Kheihta ma Khazohpa Byh he ei o ei tlôkhei thei aw?” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chavâta Dâvi ta Byh cha Dâvi khihpi lâ tlôkhei khao leipa ta, Kiti chyhsa Ôbededô o lâ tlao a tleikhei haw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khazohpa Byh cha Ôbededô o liata a chhôhkha hnohta thla thôh y ta. Abeipa ta Ôbededô chhôhkha nata a hneipa zydua cha byhnâ pie ta.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tyre bei Hirâ ta Dâvi lâ chyhsa tuah ta, a o sa nawpa ta sidy thozy paphao ta. Lô zôthaipa nata tho zôthaipazy chhao tuah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta Abeipa ta Izarei chô liata bei ta ano cha padua ta, a phopi Izarei vâta a khinarâh chhao thata cheihchalopa ta a y tahpa pahno ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dâvi cha Zerusale liata lapinôzy hnei viapa ta, sawchapawzy nata sawchanôzy hnei via ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zerusale liata a pihpa a sawzy cha Sâmua, Sôbâ, Nâthâ, Sawlawmaw,
  </para>
  <para style="p">
    <verse number="5" style="v" />Ibâ, Elisua, Elpele,
  </para>
  <para style="p">
    <verse number="6" style="v" />Nôkâh, Nephe, Zaphia,
  </para>
  <para style="p">
    <verse number="7" style="v" />Elisâmâ, Beliadâ nata Eliphele zy ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Philistinâ mo ta Dâvi cha Izarei râh zydua chô liata bei châta sathawthupa a châ tahpa ama thei nahta, Philistinâ mo zydua Dâvi tlua awpa ta khy ei ta. Cha thâtih cha Dâvi ta a thei nahta, âmo a dyuh awpa ta pua ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Philistinâ mo cha a vy ei ta, Rephai Saikao vaw chho ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dâvi cha Khazohpa a saohiah ta, “Philistinâ mo a dyuh awpa ta ei khy aw ma? Âmo cha ei ku liata eina pie aw chi ma?” tah ta. Abeipa ta a hnohta, “Khy mah y, âmo cha na ku liata ei cha pie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chatanachata Dâvi cha Bâlâperâzi lâ khy ta, cha liata Philistinâ mo cha pahnie ta. Dâvi ta, “Khazohpa ta ei ku hmâpa ta ei chariahzy cha tisaih hawhta a ly ha ei,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Philistinâ mo cha ama khazohzy a râsai ei ta. Dâvi ta biepie ta, khazohzy cha mei ta ama rao khai haw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Philistinâ mo ta saikao vaw chho heih ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dâvi ta Khazohpa a saohiah heih ta, Khazohpa ta a hnohta, “Na khyhnao awpa ei châ vei. Âmo cha sie chahlô la, malburi thih dady liata na vaw pua thlu aw ei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Malburi kôzy kithlao liata hrâsiepa pyu na thei nahta, a dyuh awpa ta na pua aw. Philistinâ pheisaihzy a dyuh awpa ta Khazohpa na hmia lâta a sie haw,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khazohpa ta bie a piepa hawhta Dâvi ta tao ta, Philistinâ pheisaihzy cha Kibiô tawhta Keze taihta thie lymâ ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chatanachata Dâvi moh cha râh to liata pathâh ta, Dâvi china cha Abeipa ta phopi zydua chô liata payasa ta.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi ta Dâvi khihpi liata ano châta ozy sa ta. Khazohpa Byh y nawpa su a chhuanoh ta, poh o raipa ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta, “Khazohpa Byh he Livai pathla dei leipa ta cha, ahy ta hmah amâ sy awpa châ vei. Âmo cha Khazohpa Byh chhâzaw ta a sytuhpa nata ano chakaotuhpa châta Abeipa ta a rao ei,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dâvi ta Abeipa Byh cha kei la ta, a so nawpa su â chhuanohpa liata so awpa ta, Zerusale liata Izarei saw zydua cha awpakhy ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dâvi ta Arawna pathlazy nata Livai pathlazy tawhta a awpakhypazy cha,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kôhâ pathla tawhta pawhrâh chaipa Urie nata a unawhzy 120;
  </para>
  <para style="p">
    <verse number="6" style="v" />Merâri pathla tawhta pawhrâh chai­pa Asiah nata a unawhzy 220;
  </para>
  <para style="p">
    <verse number="7" style="v" />Kesao pathla tawhta pawhrâh chaipa Zôela nata a unawhzy 130;
  </para>
  <para style="p">
    <verse number="8" style="v" />Elizaphâ pathla tawhta pawhrâh chaipa Semiah nata a unawhzy 200;
  </para>
  <para style="p">
    <verse number="9" style="v" />Hebraw pathla tawhta pawhrâh chaipa Elie nata a unawhzy 80;
  </para>
  <para style="p">
    <verse number="10" style="v" />Uzie pathla tawhta pawhrâh chaipa Aminadâ nata a unawhzy 112 ama châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chatawhcha Dâvi ta theihthaipa Zadô nata theihthaipa Abiathâ nata Livai pathla Urie, Asiah, Zôela, Semiah, Elie nata Aminadâ zy aw ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />ama hnohta, “Nâmo cha Livai chi pawhrâh chaipazy nama châ. Abeipa , Izarei Khazohpa Byh cha a su ei chhuanohpa lâ namâ vaw sy thei nawpa ta, nâmo nata nama unawhzy a pathai teh u.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hmiatuapa liana khata, bieraopa hawhta ano pado leipa pi ta, nâmo ta Byh namâ sy leipa vâna khata, Abeipa eima Khazohpa cha eima chô liata a hie a hâhpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chatanachata Abeipa , Izarei Khazohpa Byh a sy awpa ta theihthaipazy nata Livai pathlazy cha a pathai ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Abeipa ta Mawsi hnohta bie a piepa hawhta, Livai pathlazy ta Khazohpa Byh cha a lâ ta ama ngiatlâh ta a sy ei ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dâvi ta Livai pathla pawhrâhpazy cha ama unawhzy hry tawhta hlasathaipazy a tlyh ta, pyungiapa chhaichhi tlaipihzy, totâzy nata paotlâzy a paro ngaitapa ta patôsa ta, thaphana hla a paro ngaitapa ta pasasa awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chatanachata Livai pathlazy ta Zôela sawchapawpa Hemâ, a unawhzy hry tawhta Berekiah sawchapawpa Asâpha, ama unawhpa Merâri pathla tawhta Kusai sawchapawpa Ethâ,
  </para>
  <para style="p">
    <verse number="18" style="v" />chhâ nona liata ama unawhzy tawhta Zekariah, Zazie, Semiramô, Zehie, Uni, Eliabâ, Benai, Mâsei, Mâtithiah, Eliphelehu, Mikaniah nata chhikao vaituhpa Ôbededô nata Zeili zy a tlyh ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hlasathaipa Hemâ, Asâpha nata Ethâ zy cha dawh paotlâ tô awpa ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zekariah, Azie, Semiramô, Zehie, Uni, Eliabâ, Mâsei nata Benai zy cha Alamô siezie hawhta tlaipih tô awpa ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mâtithiah, Eliphelehu, Mikaniah, Ôbededô, Zeili nata Azaziah zy cha, Semini siezie hawhta totâ tô awpa ta raopazy ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khenaniah cha pyungiapa a thaipa châ ta, pyungiapa kyh liata Livai pathla chhituhpa a châ. Ano ta pyungiapa chakaona rai a chhihtha lymâ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Berekiah nata Elkânâ zy cha Byh châta chhikao vaituhpazy ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Theihthaipa sahlao, Sebaniah, Zehôsaphâ, Nethane, Amasai, Zekariah, Benai nata Elieze zy cha Kha­zohpa Byh hmiakô liata chiahmie tôtuhpazy ama châ. Obededô nata Zehiah cha Byh châta chhikao vaituhpazy ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chatanachata Dâvi nata Izarei machâzy nata pheisaih sâh kha hyutuhpazy ta Ôbededô o liata a ypa Abeipa Biehrai Byh cha la awpa ta, thapha ngaitapa ta zu ei ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khazohpa ta a baopa vâ ei ta, Abeipa Biehrai Byh a sytuhpa Livai pathlazy ta viahchao tôhpa pô sari nata mietaku tôhpa pô sari ta atheihna hlâ ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dâvi cha lini poh rih dipa ta a tobi ta. Byh a sytuhpa Livai pathlazy nata hlasathaipazy nata pyungiapa chhituhpa Khenaniah zy chhao lini poh rih dipa ta a tobi ei ta. Dâvi cha lini ephaw â ky pâ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Izarei saw zydua ta mietaku tôhpa ki, chiahmie nata paotlâ pyuzy chhaota thata rahaona chôta nata tlaipihzy nata totâzy a paro ngaitapa ta tôpa ta, Abeipa Biehrai Byh cha ama khykhei haw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abeipa Biehrai Byh cha Dâvi khihpi a kaw ngia ta. Sawla sawchanô Mikâli cha opy tawhta vaw sai ta, Bei Dâvi cha thapha ngaitapa ta a lâpa kei hmô ta, a palôh ta zakhei kaw ta.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khazohpa Byh cha a ngiakhei ei ta, a so nawpa ta Dâvi ta a paraipa poh o chhôh liata soh ei ta, raopa hlânazy nata aryhna hlânazy Khazohpa hmiakô liata hlâ ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta raopa hlânazy nata aryhna hlânazy a hlâ khai nahta, Abeipa moh ta zawpizy cha byhnâ awpa ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Izarei saw zydua cha a chanô chapaw ta, viahchhâ tlâ kha, sa tlo kha nata kre thei pachawhpa sao kha chyu rai ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dâvi ta Livai pathla thokhazy cha Abeipa Byh hmiakô liata chakao ta, Abeipa , Izarei Khazohpa lâ thlahchhâpa ta, alyna bie reih ta, reithai awpa ta rao ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hyutuh chaipa cha Asâpha châ ta, a pazipazy cha Zekariah, Zeili, Semiramô, Zehie, Mâtithiah, Eliabâ, Benai, Ôbededô nata Zeili zy châ ei ta, âmo cha tlaipih nata totâ a tô thaipazy ama châ. Asâpha cha paotlâ tôtuhpa châ ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />theihthaipa Benai nata Zahâzie cha Khazohpa Bieh­rai Byh hmiakô liata a daihtita ta chiahmie a tô tyh awpazy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chatanachata cha noh liata, Abeipa lâ alyna bie reina hla sa awpa ta, Dâvi ta Asâpha nata a unawhzy cha rao ta, he Dâvi hla phipa he Abeipa lâ ama hlâ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abeipa lâ alyna bie hlâpa ta a moh pado u la, Phopizy hry liata a hmotaopazy pahnosa teh u!
  </para>
  <para style="p">
    <verse number="9" style="v" />Ano lâ hla sapa ta, Ano cha reithai u la; A hmotao noâhpa zydua phuah teh u!
  </para>
  <para style="p">
    <verse number="10" style="v" />A moh pathaihpa parônahsa u la, Abeipa a tluatuhpazy palôh cha, Thaphapa ta y mawh sy!
  </para>
  <para style="p">
    <verse number="11" style="v" />Abeipa nata a thatlôna tlua u la, A hmia khâ tlua muh vy!
  </para>
  <para style="p">
    <verse number="12" style="v" />A hmotao noâhpazy a thei thlâh ha u la, A hmonoâhpazy a theipa ta, A pachiana biezy a thei thlâh ha teh u.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hy a chakaotuhpa Izarei pathla saih u, Hy â tlyhpa Zakaw sawzy saih u!
  </para>
  <para style="p">
    <verse number="14" style="v" />Ano cha Abeipa eima Khazohpa châ ta, A ryureina alei chô zydua liata a y.
  </para>
  <para style="p">
    <verse number="15" style="v" />A biehrai chhâzaw ta a thei thlâh ha u la, A biepiepa chhâ sâh hluhpi taihta a thei thlâh ha teh u.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha tlai cha Abarahâ hnohta a biehrai kha châ ta, Aisika hnohta a bietai châ hra ta,
  </para>
  <para style="p">
    <verse number="17" style="v" />Zakaw hnohta bieraopa ta pa-i ta, Izarei hnohta chhâzaw biehrai ta taopa ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kâna râh cha pie aw na ta, Cha cha na ryuto râh a châ aw,” a tah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Maluh chyhta dei châ ei chi ta, Rei khi chhao a tloh leipa, Khichhaipa dei nama châ nona kha,
  </para>
  <para style="p">
    <verse number="20" style="v" />Phopi miakha tawhta miakha lâta viavi ei chi ta, Khinarâh miakha tawhta miakha lâ nama viavi laih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahy ta hmah ama tlybai awpa pasaih leipa ta, Âmo vâta beizy ra ta,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Ei sathawthupazy hria leipa u la, Ei hrohsopazy pasasa khuh vy!” a tah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leilô zydua saih u, Abeipa lâ hla sa u la, A pachhana bie noh chareih chho teh u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Râhzy liata a rônahzie phuah u la, Phopi zydua hnohta a hmotao noâhpazy phuah teh u!
  </para>
  <para style="p">
    <verse number="25" style="v" />Abeipa cha rônah ta, Thata reithai awpa châ ta, Khazoh zydua hlâta chi chai awpa a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Phopizy khazoh zydua cha nothlahpazy dei châ ei ta, Abeipa deikua cha avâzy a taotuhpa a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />A hmiakô liata rônahna nata abeina y ta, A yna su liata thatlôna nata thaphana a y.
  </para>
  <para style="p">
    <verse number="28" style="v" />Phopizy liata chi to saih u, Abeipa cha reithai u la, Abeipa cha rônahna nata thatlôna patosa teh u!
  </para>
  <para style="p">
    <verse number="29" style="v" />Abeipa cha a moh rônahna patosa u la, Hmohlâpa cheipa ta a hmiakô liata a vy teh u! Rônahna nata pathaihna ta Abeipa cha a chhy u la,
  </para>
  <para style="p">
    <verse number="30" style="v" />Leilô zydua saih u, A hmiakô liata a chalyu teh u; Khizaw he â ipa ta paduapa châ ta, A chalyu beih aw vei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Avâzy ama thapha sala, Alei a ly mawh sy; Phopizy hry liata, “ Abeipa ta ryu a reih!” Tah mawh ei sy!
  </para>
  <para style="p">
    <verse number="32" style="v" />Tilaipi a rôh sala, A chhôh liata a ypazy a rôh mawh ei sy; Lyurâhpa a thapha sala, A chhôh liata a ypa to ama thapha mawh sy!
  </para>
  <para style="p">
    <verse number="33" style="v" />Abeipa cha alei pachia awpa ta a vy aw ta, Cha tita râhmâhpa thozy ta, A hmiakô liata thapha ta hla ama sa aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abeipa lâ alyna bie hlâ teh u; Ano cha pha ta, A kyhpachâna a tleih beih leipa a châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Hy eima pachhana Khazohpa y, Miah pachha la, Râh to tawhta miah pakhy la, Miah chatlai mah y; Chatanachata na moh pathaihpa lâ alyna bie reih aw pi ta, Na rônahna eima reithai aw.
  </para>
  <para style="p">
    <verse number="36" style="v" />Abeipa Izarei Khazohpa cha, Chhâzaw nata tlyzaw ta reithaipa ta y mawh sy!” Chyhsa zydua ta, “Amen!” tah ei ta, Abeipa cha ama reithai.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chatanachata Abeipa Biehrai Byh hmiakô liata â ngiahna hawhta noh chareih chakaona rai hria awpa ta, Bei Dâvi ta Asâpha nata a unawhzy soh ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ôbededô nata a unawh sycharu nata pachariezy chhao soh ta. Zeduthu sawchapawpa Ôbededô nata Hôsâ cha chhikao vaituhpazy ama châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kibiô su sâhpa liata Abeipa byureih liata chakaona raihria awpa ta, theihthaipa Zadô nata a unawhpa theihthaipazy soh hra ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Âmo cha Abeipa Ryhpa liata ropa, Abeipa ta Izarei sawzy bie a piepa zydua tao ta, my nata zâ ta raopa hlâna maisâh liata Abeipa lâ raopa hlâna a hlâ tyh awpazy ama châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />A zawngiahna cha chhâzaw châta a châpa vâta, Abeipa lâ alyna bie a reih tyh awpa ta, Hemâ nata Zeduthu nata mohropa ama moh ta a tlyhpazy chhao, ama hnohta chakaosapa ama châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hemâ nata Zeduthu cha pyungiapa châta chiahmiezy nata paotlâzy hnei ei ta, Khazohpa hla sa nawpa ta chhaichhizy ama hnei. Chhikao vaituhpazy châta Zeduthu sawchapawzy rao­pa ama châ.
  </para>
  <para style="p">
    <verse number="43" style="v" />Chatawhcha zawpi zydua ama o chyu lâta a di ei ta, Dâvi chhao a chhôhkhazy byhnâ awpa awpa ta a o lâ â di ha hra.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi cha a o liata a pahrâ tawhta, hrohsopa Nâthâ hnohta, “Moh tua, kei sidy tho o liata y na ta, Abeipa Bieh­rai Byh hmâchhâh poh o ry liata a y thlâh haw,” tah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nâthâ ta Dâvi hnohta, “Na palôh liata a ypa zydua tao mah y, Khazohpa na hnohta a y mâh tâh,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Châhrasala cha zâ lilaw ta Nâthâ hnohta Khazohpa bie vaw tlô ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Vawh la, nâ chakaotuhpa Dâvi kei chho teh, Abeipa ta hetana heta a tah: ‘Ei pahrâ nawpa o nâ sapa awpa cha nâma châ va chi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Izi râh tawhta Izarei ei kaw chhi papua noh tawhta tanoh taihta, o liata pahrâ leipa na ta, poh o miakha tawhta miakha lâ a pasie na ta, achhyna byureih miakha tawhta miakha lâ ei pasie lymâ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Izarei saw zydua hnohta ei pasie laihna su to liata, ei phopi chhihtha awpa ta bie ei piepa Izarei ryureituhpa ahy hnohta tlyma, “Khazia sidy tho ta o eina sapa veih ei chi?” tahpa ta kawh kha chhâ ei vaw reih beih ma?’
  </para>
  <para style="p">
    <verse number="7" style="v" />Chavâta tahmâ nâ chakaotuhpa Dâvi hnohta hetana heta kei chho teh, ‘Pheisaihzy Abeipa ta hetana heta a tah, ei phopi Izarei chô liata ryureituhpa châ awpa ta, sibiepa su tawhta nata mietakuzy na vaina tawhta cha la papua na ta,
  </para>
  <para style="p">
    <verse number="8" style="v" />na siena maih liata na hnohta y lymâ na ta, na chariah zydua na hmiakô tawhta ei chhawh pathlah ha ei. Alei chô liata chyhsa rônahpazy hawhta moh rônahpa ei cha taopa aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ei phopi Izarei châta su rao aw na ta, cha liata loh aw ei na ta, âmo su eihpa liata pahrâ aw ei ta, patypamâpa ta y khao aw veih ei. Eikhano hawhna khata, thachahra a hmâhpazy ta âmo cha parao khao aw veih ei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ei phopi Izarei chô liata ryureituhpazy ei raona daihti hawhna khata châ khao aw vei. Na chariah zydua ei panawhsa khai aw ei. Cha dei châ vei, Abeipa ta chipathla a cha paduapa aw tahpa na hnohta ei phuah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na nohzy a kipa ta, châ pathlatuhpazy hnohta na sie tita, châ thla awpa ta, na chipathla, na sawchapawzy hry tawhta pakha padua aw na ta, a khinarâh ei pa-i aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ano ta o na sapa aw ta, kei ta a beidyuchhai chhâzaw ta ei pa-i aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />A paw châ aw na ta, ei sawchapawpa a châ aw. Nâma hlâta a bei tuapa tawhta ei zawngiahna ei la hapa hawhna khata, ano tawhta ei zawngiahna la aw va na.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ei o liata nata ei khinarâh liata ano cha chhâzaw ta pa-i aw na ta, a beidyuchhai chhâzaw ta ei padua aw,’ tahpa ta,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cha bie zydua nata cha aluahna hawh tlai ta Nâthâ ta Dâvi cha chho ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chatawhcha Bei Dâvi cha a ngia ta, Abeipa hmiakô liata a tyuh ta, a hnohta, “Hy Zehôvâh Khazohpa, ahy ma châ na ta, ei chhôhkha he khâpa châ ta ma, he taih heta einâ vaw chhi chi tly?
  </para>
  <para style="p">
    <verse number="17" style="v" />Hy Khazohpa y, cha chhao cha na mohmô liata la, hmo chyhpata dei a châ. Hy Zehôvâh Khazohpa y, châ chakaotuhpa pathlazy kyh kô hluhpi châta reih ha chi ta, chyhsa rônahpa hawhta eina pachâ chi!
  </para>
  <para style="p">
    <verse number="18" style="v" />Châ chakaotuhpa na palyupalihna kyh liata, Dâvi heta reih awpa khâpa a hnei khao? Châ chakaotuhpa he pahno pasia tlôh chi ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Châ chakaotuhpa vâta, Hy Abeipa y, cha hmo rônahpa zydua cha na palôh hawh tlai ta tao chi ta, cha hmo rônahpazy cha na palâhâh haw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hy Abeipa y, eima nah theipa liata, nâ hawhpa he ahy hmah y leipa ei ta, nâ leipa ta Khazoh hropa y veih ei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na phopi Izarei hawhpa he alei chô liata khâpa phopi ma a y? Khazohpa ta ano phopi ta tao awpa ta, sie ta a kei chatlaipa phopi ahy ma a y? Izi râh tawhta na chatlaipa na phopi, ama hmiakô liata phopizy papuapa ta, na châta moh rônahpa nata noâhchhihpa hmozy châ awpa ta na taopa phopi hawhpa he ahy ma a y?
  </para>
  <para style="p">
    <verse number="22" style="v" />Chatanachata na phopi Izarei cha, chhâzaw ta nâma phopi châ awpa ta tao chi ta, nâma tlai cha, Hy Abeipa y, ama Khazohpa na vaw châ haw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chavâta tahmâ he, Hy Abeipa y, châ chakaotuhpa nata a pathlazy kyh na reipa kha, chhâzaw châta pa-i la, na reipa hawh tlai ta tao mah y.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chatanachata ‘Pheisaihzy Abeipa cha Izarei Khazohpa châ ta, ano cha Izarei Khazohpa a châ,’ tahpa ta, na moh cha chhâzaw ta pa-ipa nata pachônôsapa ta y aw ta, châ chakaotuhpa Dâvi pathlazy cha na hmiakô liata paduapa ama châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hy ei Khazohpa, nâma tlai ta, châ chakaotuhpa hnohna heta a pathlazy na paduapa awpa kyh palâhâh ha chi ta, chavâta châ chakaotuhpa heta riahphapa ta na hmiakô liata thlah ei chhâ ngâhpa a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hy Abeipa y, nâ cha Khazohpa châ chi ta, cha hmo phapa cha châ chakaotuhpa hnohta nâ taih haw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chavâta tahmâ, châ chakaotuhpa pathlazy cha chhâzaw ta na hmiakô liata ama y thei nawpa ta, âmo cha byhnâ pie mah y. Hy Abeipa , nâma tlai ta byhnâ aw ha chi ta, chhâzaw byhnâ châ mawh sy,” tah ta.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha hnôh lâta Dâvi ta Philistinâ mo a dyuh ta, pahnie ta, Kâthâ khihpi nata a khichapeihzy cha Philistinâ mo tawhta la ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Môabâ mo pahnie ta, chatanachata Môabâ mo cha Dâvi chakaotuhpa ta y ei ta, ano lâ râhpaw ama pie tyh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dâvi cha Ufrâti chavah kaozy liata a biehneina padua awpa ta a siena liata, Zôbâ bei Hadâdeze cha Hâmathi khihpi taihta a dyuh ta, pahnie ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hadâdeze talailih 1,000, arâ pheisaih 7,000 nata alei pheisaih 20,000 patu ta. Talailih a daophipa arâ zydua cha ama chazaw chhawh khai ta, talailih 100 a daophi awpa deita a pahlôh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dâmaskâ liata Aramia mo ta Zôbâ bei Hadâdeze pachha awpa ta a vy ei ta, Dâvi ta Aramia pheisaih 22,000 thie ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dâvi ta Dâmaskâ liata Aramia mo hry liata pheisaih suzy soh ta, chatanachata Aramia mo cha Dâvi chakaotuhpa ta y ei ta, ano lâ râhpaw ama pie lymâ. Abeipa ta Dâvi cha a siena maih liata pahniena pie lymâ ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dâvi ta Hadâdeze chakaotuhpazy ta ama siekheipa ngôh vyhphaozy la ta, Zerusale lâ phaoh ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dâvi ta Hadâdeze khihpi Tibâ nata Kunâ zy tawhta dawh hluhpi la ta. Chazy cha hmâpa ta Sawlawmaw ta dawh tipâh, dawh tôhzy nata dawh hmobaohzy tao ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dâvi ta Zôbâ bei Hadâdeze pheisaih zydua a pahnie khai hapa thâtih Hâmathi bei Tou ta a thei nahta,
  </para>
  <para style="p">
    <verse number="10" style="v" />Dâvi ta Hadâdeze cha a dyuh ta a pahnie hapa vâta, a naoh awpa nata a lykhei awpa ta, a sawchapawpa Hadôrâ cha ano lâ tuah ta. Hadâdeze nata Tou cha khâ a dyuh tyhpa châ ei ta. Tou ta ngôh, tâkâ nata dawh hmobaoh to Dâvi lâ paphao ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chazy cha Dâvi ta râh a pahniepa zydua, Edômâ mo, Môabâ mo, Amawna mo, Philistinâ mo nata Amale mozy tawhta tâkâ nata ngôh a lapazy chhaota Abeipa lâ hlâ ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zeru sawchapawpa Abisai ta Alôh Saikao liata Edômâ pheisaih 18,000 thie ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Edômâ râh liata pheisaihzy soh ta, chatanachata Edômâ mo zydua cha Dâvi chakaotuhpazy ta y ha ei ta. Abeipa ta Dâvi cha a siena maih liata pahniena pie lymâ ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chatanachata Dâvi cha Izarei saw zydua chô liata ryureih ta, a phopi zydua châta adona nata akhongâhna ta ryureih ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zeru sawchapawpa Zôabâ cha pheisaih hyutuh chaipa châ ta, Ahilu sawchapawpa Zehôsaphâ cha thâtih rohtuhpa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahitu sawchapawpa Zadô nata Abiathâ sawchapawpa Ahimele zy cha theihthaipazy châ ei ta, Sâvasâ cha chârohtuhpa a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zehôdâ sawchapawpa Benai cha Khere mo nata Pele mo hyutuhpa châ ta, Dâvi sawchapawzy cha bei chakaona rai liata hyutuh chaipazy ama châ.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha khai tawhta, Amawna bei Nahâsâ cha thi ta, a sawchapawpa ta ano su liata a bei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta, “Nahâsâ sawchapawpa Hânu cha, a paw ta ei chô liata phana a palâsa tyhpa hawhta, kei chhao ta chô liata phana ei palâsa hra aw,” tah ta. Chatanachata a paw thina kyh liata thlapalôh awpa ta, Dâvi ta Hânu lâ lyuhchâpazy tuah ta. Dâvi chakaotuhpazy cha Hânu thlapalôh awpa ta Amawna râh kei tlô ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Châhrasala Amawna pawhrâhpazy ta Hânu hnohta, “Dâvi heta na paw a zapa vâta thlapalôhtuhpazy nâ lâ a vaw tuapa a châ tahpa na pangiasa ma? Râh thâtih patluah ta, râh mohparu ta parao awpa ta, a chakaotuhpazy a vaw tuapa châ vei ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hânu ta Dâvi chakaotuhpazy cha patu ta, ama kâhhmizy ngyu ta, ama viahkaozy â khophie liata, ama chaosa dady ta tai ta, âmo cha pakuasa ha ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chakaotuhpazy hmo a tyhpa cha Dâvi chho ei ta. Chakaotuhpazy cha ama noza kaw ta, chavâta Dâvi ta âmo dy awpa ta chyhsazy tuah ta. Abei ta, “Nama kâhhmi a seih hlâlei Zerikô liata y chy u la, cha khai tawhta a vy lah vâ ei chi,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amawna mo ta Dâvi châta roh chhiepa ama châ haw tahpa amâ pahno nahta, Hânu nata Amawna mo ta talailih nata arâ pheisaihzy a hlâ nawpa ta Mesôpôtamia, Aramiamâkâ nata Zôbâ râhzy lâ tâkâ talent 1,000 paphao ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mâkâ bei nata a pheisaihzy nata talailih 32,000 a hlâh ei ta. Pheisaihzy cha Medebâ kiapâh liata riehmo paryh ei ta. Amawna mo cha ama khihpizy tawhta puapakhy ei ta, a dyuh awpa ta sie ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha thâtih cha Dâvi ta a thei nahta, Zôabâ nata pheisaih riahphapa zydua tuah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amawna mo cha vaw pua ei ta, a dyuh awpa ta khihpi chhikao liata a paziah ei ta. Adyuhna lâ a sie hrapa ama beizy cha âmo dei ta lyurâhpa liata y ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zôabâ ta a hmia a hnôh ta amâ vaw dyuhpa a hmô nahta, Izarei pheisaih pha chaipazy a tlyh ta, Aramia mo a dyuh awpa ta âmo cha paziah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pheisaih hropazy cha a unawhpa Abisai ku liata soh ta, Amawna mo a dyuh awpa ta paziah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zôabâ ta, “Ei châta Aramia mo ama tha a tlô tu khiahta cha, na vaw bao aw chi ta, Amawna mo na châta ama tha a tlô tu khiahta cha, ei cha vaw bao aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Riahphapa ta y u la, eima phopi nata eima Khazohpa khihpizy châta eima thatlônazy hmâh suh vy. Abeipa ta pha a tahpa hawhta tao mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zôabâ nata a pheisaihzy cha Aramia mo a dyuh awpa ta a kei hnia ei ta, Aramia mo cha Zôabâ hmiakô liata a râpai ha ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aramia mo amâ râpai hapa Amawna mo ta ama hmô nahta, âmo chhao cha Zôabâ unawhpa Abisai hmiakô liata a râpai ei ta, khihpi liata amâ ngia haw. Chatawhcha Zôabâ cha Zerusale lâ a lie ha ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aramia mo cha Izarei ta a pahnie hapa ei ama pahno nahta, Ufrâti chavah haosâ lâta a ypa Aramia mo aw awpa ta lyuhchâpazy tuah ei ta. Aramia mo cha Hadâdeze pheisaih hyutuhpa Sopha chhihthana ry liata a vy ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha thâtih cha Dâvi chho ei ta, Izarei pheisaih zydua awpakhy ta. Zawdâh chaka ei ta, Aramia mo yna kei tlô ei ta, a dyuh awpa ta a paziah ei ta. Dâvi ta Aramia mo a dyuh awpa ta a pheisaihzy a paziah khai nahta, ano chhaota Aramia mo cha a dyuh ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aramia mo cha Izarei sawzy hmiakô liata a râpai ha ei ta. Dâvi ta Aramia mo arâ pheisaih 7,000 nata alei pheisaih 40,000 zy thie ta, pheisaih hyutuhpa Sopha chhao a thie haw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hadâdeze chakaotuhpazy ta Izarei sawzy hmiakô liata pahniepa ta ama ypa ama hmô nahta, Dâvi nata aryhna tao ei ta, Dâvi ryureina ry liata y ha ei ta. Aramia mo ta Amawna mo cha pachha khoh khao veih ei.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Beizy hrâ ama sie tyhna châhvâ daihti liata, Zôabâ cha pheisaih hluhpi a chhipa ta hrâsiena lâ pua ta. Amawna râh parao ta, sie ta Râbâ khihpi dôh ta. Dâvi deikua cha Zerusale liata y ta. Zôabâ ta Râbâ khihpi cha a dyuh ta, pahnie ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta ama bei beilakho cha a luh tawhta la ta, ngôh talent miakha â hripa ta pahno ta. Lôsôhpazy chhao a chhôh liata y ta, cha cha Dâvi luh liata pakho ei ta. Khihpi hraona sôh hluhpi chhao vaw phaoh ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Râbâ khihsawzy cha puakhei ta, thoânazy, leipaliena thua pazaopazy nata ahreizy hmâpa ta raihriatuhpazy ta âmo cha hmâh ta. Cha hawhna chata Dâvi ta Amawna khihpi zydua cha tao ta. Cha khai tawhta Dâvi nata pheisaih zydua cha Zerusale lâ a lie ha ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cha khai tawhta Philistinâ mo nata adyuhna Keze khihpi liata y ta. Husâ chyhsa Sibekai ta Sipai thie ta. Sipai cha mopahreihpazy pathla hry liatapa a châ. Chatanachata Philistinâ mo cha panawhpa ta y ha ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Philistinâ mo nata adyuhna y heih ta. Zairâ sawchapawpa Ehânâ ta Kiti chyhsa Kôliathâ unawhpa Lâmi thie ta. Lâmi asei bih cha thaisana batlâh tlu ta a laipa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kâthâ liata adyuhna y heih ta. Cha khihpi liata chyhsa mopahreih ngaitapa, a ku chavei chachâh ta kuparo miacharu hnei ta, a phei chavei chachâh ta pheiparo miacharu a hneipa, a zydua ta kuparo nata pheiparo mia kih nata miapalih a hneipa y ta. Ano chhao cha mopahreihpazy pathla châ ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cha chyhsa chata Izarei sawzy cha pahao ta, Dâvi unawhpa Simia sawchapawpa Zawnathâ ta a thie haw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Âmo cha Kâthâ liata mopahreih­pazy pathla châ ei ta, Dâvi nata a chyhsazy ku liata a thipazy ama châ.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sâtâ ta Izarei a dyuh awpa ta thyu ta, Izarei maluhpi rei awpa ta Dâvi cha reipasao ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta Zôabâ nata pheisaih hyutuhpazy hnohta, “Sie u la, Besebâ tawhta Dânâ taihta Izarei sawzy maluh reih u la, ama maluh zie ei pahno thei nawpa ta, na vaw chho heih muh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zôabâ ta, “ Abeipa ta a phopi he a lie za hluhpi ta papôh mawh sy! Ei zibeipa abei y, râhsaw zydua he ei zibeipa chakaotuhpa sai châ veih ei ma? Khâpa vâta ma ei zibeipa heta he hmo he tao awpa a khoh tly? He hmo heta khazia Izarei chô liata thaileichâna a tlôkhei aw tly?” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Châhrasala abei bie ta Zôabâ cha pahnie ha ta. Chatanachata Zôabâ cha pua ta, Izarei râh zydua a chahryh khai tawhta Zerusale lâ a vaw lie ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zôabâ ta Izarei phopi maluh pahlyhpakhypa cha Dâvi chho ta. Izarei râh zydua liata, zaozi a chaba theipa chapaw 1,100,000 y ei ta, Zudâh râh liata 470,000 ama y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zôabâ cha bei biepiepa kyh liata a palôh a châ lei ngaitapa vâta, Livai chi nata Benzami chi deikua ama maluh rei pâ khao vei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cha hawhta Izarei maluhpi reipa cha Khazohpa a ly leipa ta, chavâta Khazohpa ta Izarei sawzy cha hrie ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dâvi ta Khazohpa hnohta, “Ei hmotaopa vâna heta ei vaw molei ngaita kaw na. Châhrasala tahmâ ei châ haw na, châ chakaotuhpa paraona he rie a ngiahthai mah y. Hru kawpa ta hmo ei vaw tao haw,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abeipa ta Dâvi hrohsopa Kâdâ hnohta,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Vawh la, Dâvi hnohta, ‘ Abeipa ta hetana heta a tah: A tlyh awpa hmo miathôh cha pie na ta, miakha a tlyh aw chi ta, cha cha ei cha taopa aw, a tah na,’ tahpa ta na kei chho aw,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kâdâ cha Dâvi lâ vawh ta, a hnohta, “ Abeipa ta hetana heta a tah, ‘Na khopa a tlyh teh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kô thôh chakâhna ma, thla thôh chhôh na chariahzy ta cha chadaipa ta ama zaozi ta ama cha pahleipadia awpa ma, noh thôh chhôh Abeipa zaozi ta potlana patlôsapa ta, Abeipa vâlyuhchâpa ta Izarei râh zydua a pahleipadia khai awpa ma?’ Tahmâ a tlyh teh, nâ vaw tuatuhpa hnohta kheihawhpa achhyna ma ei tlôkhei aw,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dâvi ta Kâdâ hnohta, “Ei nô a po ngaita. Abeipa ku liata ei pao thlu aw, ano cha zawngiah thei ngaitapa châ tlôh ta. Chyhsapa ku liata la na papaosa khah y,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chatanachata Abeipa ta Izarei chô liata potlana patlôsa ta, Izarei chyhsa 70,000 thi ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zerusale pahleipadia awpa ta Khazohpa ta vâlyuhchâpa tuah ta, châhrasala pahleipadia awpa â chhuah hai nota, Abeipa ta hmô ta, chhiena patlôsa â chhuahpa cha a pathleih haw. Abeipa ta pahleipadiana rai a hria haipa vâlyuhchâpa hnohta, “Â daih haw, na ku hy khao khah y,” tah ta. Abeipa vâlyuhchâpa cha Zebu chyhsa Ôranâ sawhri kiapâh liata a duah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dâvi cha mohmia pasaih ta, alei nata avâ likawh liata â duah thlâh hapa Abeipa vâlyuhchâpa hmô ta. A ku liata zaozi â chabapa cha Zerusale chô liata pazawh ta. Dâvi nata machâzy cha latho poh a bupa ta alei liata â khu lâta pao ei ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dâvi ta Khazohpa hnohta, “Phopi maluh reih awpa ta bie a piepa kha keima châ va na ma? A moleipa nata paraona lai ngaitapa a taotuhpa cha keima tlai he ei châ. He mietakuzy heta khâpa hmo ma ama parao tly? Hy Abeipa ei Khazohpa y, kei nata ei chhôhkha chô liata na ku tlao pathla la, potlana he na phopi chô liata rie chareisa khao khah y,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chatawhcha Abeipa vâlyuhchâpa ta Kâdâ hnohta, Dâvi cha khy sala, Zebu chyhsa Ôranâ sawhri liata Abeipa châta maisâh tao awpa ta Dâvi hnohta chho awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kâdâ ta Abeipa moh ta a reipa bie hawhta Dâvi cha khy ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ôranâ cha bâli sâh tly ngâ ta. A kei heih ta, vâlyuhchâpa kei hmô ta, a hnohta a ypa a sawchapaw papalihpazy cha a nyu ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dâvi ta Ôranâ kô a kei tlô nahta, Ôranâ cha a vaw heih ta, Dâvi cha hmô ta, sawhri tawhta pua ta, a hmia alei lâ a bôhpa ta Dâvi cha a naoh ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dâvi ta Ôranâ hnohta, “Potlana hri he zawpi tawhta a pai thei nawpa ta, he sawhrihmo he Abeipa châta maisâh ei tao nawpa ta na pie teh; a mâ dopa ei cha pie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ôranâ ta Dâvi hnohta, “Hnei mah y, ei zibeipa abei ta pha na tahpa hawhta tao mah y. Moh tua, raopa hlânazy châta viahchao tôhpazy cha pie pâ na ta, niepa hlâna châta sawhri chhaichhi thozy nata âtâ sâhzy ei cha pie pâ. A zydua ta ei cha pie khai,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Châhrasala Bei Dâvi ta Ôranâ hnohta, “Châ vei, a mâ dopa ei cha pie aw. Na eih cha Abeipa châta a saipa ta la leipa aw na ta, ei hryuhna rai y leipa ta raopa hlânazy hlâ aw va na,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chatanachata Dâvi ta sawhrihmo chaleina châta ngôh sekel 600 khopathliah ta, Ôranâ cha pie ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dâvi ta cha liata Abeipa châta maisâh tao ta, raopa hlânazy nata aryhna hlânazy hlâ ta. Abeipa pado ta, Abeipa ta avâ tawhta mei ta a zâ chhy ta, raopa hlâna chô liata mei za tla ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chatawhcha Abeipa ta vâlyuhchâpa cha biepie ta, a zaozi cha a paih liata khô ha ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dâvi ta Zebu chyhsa Ôranâ sawhrihmo liata Abeipa ta â vaw chhypa a hmô nahta, cha liata atheihna hlâ ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cha nona cha, Mawsi ta râhchawhpa liata Abeipa achhyna byureih nata raopa hlâna maisâh a taopazy kha Kibiô khihpi su sâhpa liata y thlâh ha chy ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Châhrasala Dâvi cha Abeipa vâlyuhchâpa zaozi a chipa vâta, Khazohpa a saohiah awpa ta, cha su lâ cha sie ngâh vei.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi ta, “He su liana heta Zehôvâh Khazohpa o y aw ta, he su liana heta Izarei châta raopa hlâna maisâh a y aw,” tah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta Izarei râh liata chihropa a ypazy awpakhy awpa ta biepie ta. Alô a khai thaipazy cha Khazohpa o sa nawpa châta alô khai awpa ta rao ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dâvi ta dôhna chhikaozy khaipâ nawpa nata a patusanazy châta thua hluhpi a chhuanoh ta. Dawh hluhpi a chhuanoh hra ta, â hrina zie pathliah tiah awpa chhao châ vei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sidaw mo nata Tyre mo ta Dâvi cha sidy tho hluhpi vaw pie ei ta, chavâta Khazohpa o sa nawpa ta, sidy tho chhao rei tiah lei â chhuanoh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dâvi ta, “Ei sawchapawpa Sawlawmaw cha hawtipa châ ta, hmo yzie pahno tu mâh leipa ta, Abeipa châta o sa awpa hra cha, râh zydua liata a pathâhpa o laipa nata rônahpa a châ awpa châ tlôh ta. Chavâta Khazohpa o sa nawpa cha kei ta ei chhuanoh chhielie aw,” tah ta. Chatanachata Khazohpa o sa nawpa chhaichhi zydua cha Dâvi ta a thi hlâta â chhuanoh khai haw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatawhcha Dâvi ta a sawchapawpa Sawlawmaw cha aw ta, Abeipa , Izarei Khazohpa o sa awpa ta biepie ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dâvi ta a sawchapawpa Sawlawmaw hnohta, “Ei sawchapawpa y, Abeipa ei Khazohpa moh châta o sa awpa ei palôh liata y ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Châhrasala Abeipa bie ei hnohta vaw tlô ta, ‘Nâ la thisaih thata palo chi ta, adyuhna ru ngaitapazy a dyuhpa ta, ei hmiakô liata alei chô liata thisaih thata na palopa vâta, ei moh châta o sa aw va chi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pachâ teh, sawchapawpa sa aw chi ta, ano cha adyhna a khohpa a châ aw. A chheipâh râhzy liata a chariah zydua nata a dyryhpa ta paysa aw na ta, apahâna ei pie aw. A moh cha Sawlawmaw châ aw ta, ano daihti liata la, Izarei râh liata thlalôhna nata abohna ei paysa aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ano ta ei moh châta o a sa aw. Ano cha ei sawchapawpa châ aw ta, kei a paw ei châ aw. Â beina beidyuchhai cha Izarei râh liata chhâzaw châta ei padua aw,’ tahpa ta na chho ha ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Chavâta ei sawchapawpa y, Abeipa na hnohta y mawh sy. Thlaochhipa ta y lymâ la, Abeipa ta na kyh a vaw rei chhielie hapa hawhta, hlaotloh kawpa ta Abeipa na Khazohpa o cha sa mah y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abeipa ta Izarei chô liata biehneina a cha pie tita, Abeipa na Khazohpa ryhpa na zyh thei nawpa ta, Abeipa ta sona nata novâhna cha pie mawh sy.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abeipa ta Mawsi hnohta Izarei châta bieraopa nata pachiana a piepazy kha na zyh khiahta cha, thlaochhipa ta na y lymâ aw. Thatlôpa nata riahphapa ta y mah y. Chi leipa la, ngiaroh khah y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Riethei thata taopa ta, Abeipa o châta ngôh talent thy hrawh nata tâkâ talent thy za kha a chhuanoh ha na ta, dawh nata thua chhao â hrina zie kho pathliah tiah lei ta hluhpa ta ei chhuanoh haw. Tho nata lô chhao ei chhuanoh khai haw. Chazy cha na vaw baichha aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Raihriatuhpa hluhpi na hnei. Alô a patlaw thaipazy, alô a khai thaipazy, tho zôthaipazy nata zôthaipa chi nanopazy rei tiah lei na hnei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngôh, tâkâ, dawh nata thua rai a hria thaipazy hluhpi na hnei hra. Thyu la, hria teh! Abeipa na hnohta y mawh sy!” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dâvi ta Izarei chhituhpa zydua cha a sawchapawpa Sawlawmaw bao awpa ta biepie ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“ Abeipa nama Khazohpa nama hnohta y vei ma? Su to liata apahâna cha pi ha veih ei ma? He râh liata a pahrâpazy cha Abeipa ta ei ku liata na pie ta, Abeipa nata a phopi hmiakô liata ama râh cha panawhpa ta a y haw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tahmâ nama pachâna nata nama palôh cha Abeipa nama Khazohpa padona lâta pahei u la, thyu u la, Zehôvâh Khazohpa supathaihpa cha sa muh vy. Chatanachata Abeipa Biehrai Byh nata Khazohpa hmobaoh pathaihpazy cha Abeipa moh châta sapa o liata a ngiakheipa a châ aw,” tah ta.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi cha hroh pareih kaw ta, chhâ â palo nawpa daihti â hnia nahta, a saw­chapawpa Sawlawmaw cha Izarei bei ta tao ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâvi ta Izarei chhituhpa zydua nata theihthaipazy nata Livai pathlazy awpakhy ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Livai pathla kô sythôh tawhta chô lâ maluh reipa châ ei ta, pitlohpa chapaw 38,000 ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dâvi ta, “Livai pathla 24,000 zy cha Abeipa o sana liata hyutuhpazy châ aw ei ta, 6,000 Abeipa o liata hyutuhpazy nata ryureituhpazy châ aw ei ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />4,000 chhikao vaituhpazy châ aw ei ta, 4,000 zy cha reithaina hla sa nawpa ta pyungiapa chhaichhi ei taopazy hmâpa ta Abeipa lâta reithaina hla satuhpazy ama châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatawhcha Dâvi ta Livai sawchapawzy, Kesao nata Kôhâ nata Merâri zy cha a py py ta pachhaih ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kesao sawchapawzy cha Lâdâ nata Simei ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lâdâ sawchapawzy cha, pawhrâh chaipa Zehie châ ta, a pazipa ta Zethâ nata Zôela châ ei ta, pathôh ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Simei sawchapawzy cha Selômô, Hâzi nata Harânâ zy châ ei ta, pathôh ama châ. Âmo cha Lâdâ pathla pawhrâhpazy ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simei sawchapawzy cha Zahâ, Zinâ, Zeu nata Beriah zy ama châ. Cha papalihzy cha Simei sawchapawzy ama châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zahâ cha pawhrâh chaipa châ ta, Zizah ta a pazi. Zeu nata Beriah deikua cha, sawchapaw hnei hluh veih ei. Chavâta chhôhkha miakhapa hawhta reipa ama châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kôhâ sawchapawzy cha Amrâ, Iza, Hebraw nata Uzie zy châ ei ta, papalih ama châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amrâ sawchapawzy cha Arawna nata Mawsi ama châ. Arawna cha hmo pathaihpazy hria awpa ta pananopa châ ta, ano nata a pathlazy cha ropahâhpazy Abeipa hmiakô liata a rao tyh awpazy châ ei ta, Abeipa chakaopa ta, a moh ta byhnâ a aw tyh awpazy ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khazohpa chyhsa Mawsi sawchapawzy chhao Livai chi hry liata pahlaopa ama châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawsi sawchapawzy cha Kesao nata Elieze ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kesao­ sawchapawzy hry liata uhthei chaipa cha Sebua a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Elieze sawchapaw uhtheipa cha Rehabiah a châ. Elieze cha sawchapaw hropa hnei leipa ta, Rehabiah deikua cha sawchapaw hluhpi a hnei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izah sawchapawzy hry liata pawhrâh chaipa cha Selômi a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hebraw sawchapawzy liata pawhrâh chaipa cha Zeriah châ ta, panona Amaria, pathôhna Zahâzie nata papalihna Zekamia zy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uzie sawchapawzy hry liata pawhrâh chaipa cha Mikâ châ ta, panona Isiah a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merâri sawchapawzy cha Mâhli nata Musi ama châ. Mâhli sawchapawzy cha Eliaza nata Kisâ ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eliaza cha sawchapaw hnei leipa ta, sawchanôzy deita hneipa ta thi ha ta. A sawchanôzy cha ama chiheihpa Kisâ sawchapawzy ta lapinô ta ama hnei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Musi sawchapawzy cha Mâhli, Ede nata Zeremô zy châ ei ta, pathôh ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Âmo cha a chhôh chhôh ta pawhrâhpazy tawhta a laichadaipa Livai pathlazy châ ei ta, kô kih tawhta chô lâ, Abeipa o liata chakaona rai a hria thei awpazy ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dâvi ta, “ Abeipa , Izarei Khazohpa ta a chyhsazy apahâna pie ta, Zerusale liata chhâzaw ta a pahrâ hapa vâta,
  </para>
  <para style="p">
    <verse number="26" style="v" />Livai pathlazy ta achhyna byureih nata a chakaona raihria nawpa hmobaoh kheihawhpa hmahta amâ sy awpa byuh khao vei,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dâvi biepiepa hnôhchaipa hawhta, kô kih tawhta chô lâ Livai pathla maluh cha reipa a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ama maophaohna cha Abeipa o chakaona raihria liata Arawna sawchapawzy bao awpa châ ta, tlyhmiazy nata chhôhpadâhpazy mohôh ei ta, hmo pathaihpa zydua pasi tyh ei ta, Khazohpa o liata chakaona rai hropazy ama hria tyh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tlâhkhai liata viahchhâ chaluah awpa patohpatiana kyh liata zy, niepa hlâna viahdie patohpatiana kyh liata zy, viahchhâ thinô pahlao leipa châta viahchhâ papa patohpatiana kyh liata zy, viahchhâ pakâhpa hlâ awpa patohpatiana kyh liata zy, sathaw pahlaopa hmohlâpa patohpatiana kyh liata zy, a hluhna nata a laina panuana kyh zy liata chhao, Arawna pathlazy baotuhpa ama châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />My chareih ta a duah ei ta, Abeipa lâ alyna bie reipa ta ano reithai ei ta, zâlâ chhao cha hawhta ama tao tyh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pahânohzy, thla thiehpazy nata kyhchhi noh hropazy liata raopa hlânazy hlâ tita, baotuh awpa raopa zie lymâ hawhta, Abeipa hmiakô liata khâ amâ duah tyh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ahmaohna poh o nata su pathaihpa mohôhna kyh liata chhao maophaohna piepa châ ei ta, Abeipa o chakaona raihria liata Arawna sawchapawzy nata ama unawhzy ama bao tyh.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Arawna pathlazy cha he hawhta a py py ta pachhaihpa ama châ. Arawna sawchapawzy cha Nâdâ, Abihu, Eliaza nata Ithamâ zy châ ei ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />Nâdâ nata Abihu cha ama paw thi hlâta thi ha ei ta, saw hnei veih ei. Chavâta Eliaza nata Ithamâ ta theihthaipa rai cha ama hria.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dâvi ta theihthaipazy cha ama maophaohna chyu hria awpa ta, a py py ta pachhaih ta, Eliaza pathla Zadô nata Ithamâ pathla Ahimele ta Dâvi cha ama bao.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ithamâ pathlazy lia hlâta Eliaza pathlazy liata pawhrâhpazy ama hluh viapa vâta, Eliaza pathlazy cha a chhôh chhôh ta pachhaihpa ta, pawhrâhpa pahrawh hleicharu raopa châ ei ta, Ithamâ pathlazy tawhta pacharie raopa ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Eliaza pathlazy nata Ithamâ pathlazy liata hyutuhpazy cha, hyutuhpa pathaihpa nata Khazohpa hyutuhpazy ama châ khaipa vâta, ama chakaona rai hria awpazy cha, nuby a daopa ta, â lyupa ta pachhaihpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama raihria awpa nata ama mohzy cha, Livai pathla chârohtuhpa Nethane sawchapawpa Semiah ta bei nata hyutuhpazy, theihthaipa Zadô, Abiathâ sawchapawpa Ahimele, theihthaipa chhôhkha pawhrâhpazy nata Livai pathla pawhrâhpazy mohmô liata ama moh roh ta, Eliaza nata Ithamâ châta chhôhkha miakha chyu a tlyhpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nuby miakhana cha Zehôiari chô liata tlu ta, mianona Zediah,
  </para>
  <para style="p">
    <verse number="8" style="v" />miathôhna Hâri, miapalihna Seôri,
  </para>
  <para style="p">
    <verse number="9" style="v" />miapangawhna Mâkia, miacharuna Mizami,
  </para>
  <para style="p">
    <verse number="10" style="v" />miasarina Hâkô, miachariena Abiza,
  </para>
  <para style="p">
    <verse number="11" style="v" />miachakina Zesua, miahrawhna Sekaniah,
  </para>
  <para style="p">
    <verse number="12" style="v" />hleikhana Eliasi, hleinona Zaki,
  </para>
  <para style="p">
    <verse number="13" style="v" />hleithôhna Hupâ, hleipalihna Zesebia,
  </para>
  <para style="p">
    <verse number="14" style="v" />hleipangawhna Bilkâ, hleicharuna Ime,
  </para>
  <para style="p">
    <verse number="15" style="v" />hleisarina Hezi, hleichariena Hâpize,
  </para>
  <para style="p">
    <verse number="16" style="v" />hleichakina Pethâhiah, miakihna Zeheke,
  </para>
  <para style="p">
    <verse number="17" style="v" />miakih nata miakhana Zaki, miakih nata mianona Kamu,
  </para>
  <para style="p">
    <verse number="18" style="v" />miakih nata miathôhna Delia nata miakih nata miapalihna Mâzai zy ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Âmo cha Abeipa , Izarei Khazohpa ta ama pathlatuhpa Arawna hnohta bie a piepa hawhta, ama nuby lymâ hawhta Abeipa o chhôh liata chakaona rai hria awpa ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hezy he Livai pathla pawhrâh hropazy ama châ: Amrâ sawchapawzy hry tawhta Subia cha pawhrâhpa châ ta, Subia sawchapawzy hry tawhta Zediah cha pawhrâhpa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rehabiah pho liata, Rehabiah sawchapawpa Isiah cha pawhrâh chaipa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izah pho liata Selômô cha pawhrâh chaipa châ ta, Selômô sawchapawzy hry liata Zahâ cha pawhrâh chaipa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hebraw sawchapawzy hry liata Zeriah cha pawhrâh chaipa châ ta, panona Amaria, pathôhna Zahâzie nata papalihna Zekamia zy ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Uzie sawchapawzy hry liata Mikâ cha pawhrâh chaipa châ ta, Mikâ sawchapawzy hry liata Sâmi cha pawhrâh chaipa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mikâ unawhpa cha Isiah châ ta, Isiah sawchapawzy hry liata pawhrâh chaipa cha Zekaria a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Merâri sawchapawzy cha Mâhli nata Musi ama châ. Zaziah sawchapawzy hry liata pawhrâh chaipa cha Benô a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Merâri pathla pawhrâh chaipazy cha Zaziah pho tawhta Benô, Sôhâ, Zaku nata Ibari zy châ ei ta,
  </para>
  <para style="p">
    <verse number="28" style="v" />Mâhli pho tawhta Eliaza châ ta, ano cha sawchapaw hnei vei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kisâ pho liata pawhrâh chaipa cha Kisâ sawchapawpa Zerame a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Musi sawchapawzy cha Mâhli, Ede nata Zerimô zy ama châ. Âmo cha a pho pho ta a laichadaipa ta Livai pathla pawhrâhpazy ama châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Âmo chhao cha ama unawhpa Arawna sawchapawzy hawhna khata, Bei Dâvi, Zadô, Ahimele, theihthaipazy nata Livai pathla chhôhkha pawhrâhpazy mohmô liata nuby a dao hra ei ta, chhôhkha pawhrâh chaipa nata a unawh seihnai viapazy chhao, â lyupa ta nuby amâ dao khai.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi nata pheisaih hyutuhpazy ta Asâpha, Hemâ nata Zeduthu pathlazy cha totâzy, tlaipihzy, paotlâzy tô ta, hrohsona hlazy sa awpa ta panano ei ta. Hezy he pyungiapa chakaona rai a hriapazy ama châ:
  </para>
  <para style="p">
    <verse number="2" style="v" />Asâpha sawchapawzy tawhta Zaku, Zawsi, Nethaniah nata Asrelâh zy raopa châ ei ta, âmo cha abei biepiepa hawhta hrohsona hla a satuhpa ama paw Asâpha ta a chhihtha ei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zeduthu pho tawhta pacharu raopa châ ei ta, chazy cha Zeduthu sawchapawpa Kedaliah, Zeri, Zesai, Simei, Hâsabiah nata Mâtithiah zy ama châ. Âmo cha totâ tôpa ta Abeipa lâta alyna bie a reihpa nata reithaina hla a sapa ama paw Zeduthu ta a chhihtha ei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hemâ pho tawhta Hemâ sawchapaw­pa Bukiah, Mâtaniah, Uzie, Sebua, Zerimô, Hânaniah, Hânani, Eliathâh, Kidâti, Rômatize, Zôbekasâ, Mâlôthi, Hôthi nata Mâhaziô zy raopa ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ama zydua heta abei hrohsopa Hemâ sawchapawzy châ ei ta, Khazohpa ta Hemâ cha sawchapaw pahrawh hleipalih nata sawchanô pathôh pie ta, âmo cha a bietai hawhta Khazohpa a cheihchalo awpazy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ama zydua ta Khazohpa o liata chakaona rai châta paotlâzy, tlaipihzy totâzy tôpa ta, ama paw chhihthana ry liata Abeipa o liata pyungiapa lâchhâh chakaona rai hriatuhpazy ama châ. Asâpha, Zeduthu nata Hemâ zy cha abei biepiepa ry liata a ypa ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ama maluh cha, Abeipa hla sa awpa ta pachupa, hlasathaipa ama unawhzy chhaota 288 ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chatanachata a lai a chyh, pachutuhpa nata achupa, ama zydua ta â lyupa ta ama tao awpa nuby amâ dao lymâ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nuby miakhana cha Asâpha sawchapawpa Zawsi nata a unawhzy nata a sawchapawzy chô liata tlu ta, pahrawh hleino ama châ. Mianona cha Kedaliah nata a unawhzy nata a sawchapawzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Miathôhna cha Zaku nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miapalihna cha Izri nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miapangawhna cha Nethaniah nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Miacharuna cha Bukiah nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miasarina cha Zesarelâh nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miachariena cha Zesai nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Miachakina cha Mâtaniah nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Miahrawhna cha Simei nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hleikhana cha Azare nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hleinona cha Hâsabiah nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hleithôhna Subia nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hleipalihna cha Mâtithiah nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hleipangawhna cha Zeremô nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hleicharuna cha Hânaniah nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hleisarina cha Zôsbekâsâh nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hleichariena cha Hânani nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hleichakina cha Mâlôthi nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Miakihna cha Eliathâh nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Miakih nata miakhana cha Hôthi nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Miakih nata mianona cha Kidâti nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Miakih nata miathôhna cha Mâhaziô nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Miakih nata miapalihna cha Rômatize nata a sawchapawzy nata a unawhzy chô liata tlu ta, pahrawh hleino ama châ.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he chhikao vaituhpa ta raopazy ama châ: Kôrâ pathla tawhta Asâpha sawchapawzy hry liata Kôre sawchapawpa Meselemiah raopa a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meselemiah ta sawchapawzy hnei ta. A sawchapaw uhtheipa cha Zekaria châ ta, panona Zedia, pathôhna Zebadiah, papalihna Zathânie,
  </para>
  <para style="p">
    <verse number="3" style="v" />papangawhna Elâmi, pacharuna Zehôhanâ nata pasarina Eliehônai zy ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ôbededô cha Khazohpa ta byhnâ pie ta, sawchapawzy sa ta, a sawchapaw uhtheipa cha Semiah châ ta, panona Zehôzabâ, pathôhna Zôah, papalihna Sâkhâ, papangawhna Nethane,
  </para>
  <para style="p">
    <verse number="5" style="v" />pacharuna Amie, pasarina Iskâra nata pachariena Pulethai zy ama châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />A sawchapawpa Semiah chhao sawchapawzy hnei ta, âmo cha ama pho pawhrâhpazy châ ei ta, chyhsa thatlôpazy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Semiah sawchapawzy cha Ôthani, Repha, Ôbedâ nata Elzabâ zy châ ei ta, ama unawhpa Elihu nata Semakiah zy cha chyhsa thatlôpazy ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ama zydua ta Ôbededô pathlazy châ ei ta, âmo nata ama sawchapawzy nata ama unawhzy cha chakaona rai a hria theipa chyhsa thatlôpazy ama châ. Ôbededô pathlazy cha ama zydua ta maluh sycharu nata pano ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meselemiah ta sawchapaw nata unawh pahrawh hleicharie hnei ta, âmo cha chyhsa thatlôpazy ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Merâri pathlazy hry liata Hôsâ chhao sawchapawzy hnei ta, Simri cha pawhrâh chaipa a châ. Ano cha sawchapaw uhtheipa a châ lei tarawpa ta, a paw ta pawhrâh chaipa ta a rao.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hôsâ sawchapaw panona cha Hikia châ ta, pathôhna Tebaliah châ ta, papalihna cha Zekaria a châ. Hôsâ sawchapawzy nata a unawhzy cha ama zydua ta pahrawh hleithôh ama châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chhikao vaituhpa pyzy cha, ama unawhzy taozie hawhta, ama pawhrâhpazy moh zipa ta, Abeipa o liata chakaona raihria châta maophaohna raipa ama châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />A lai a chyh â lyu khaipa ta, ama chhikao vai awpa chyu cha a chhôh chhôh ta nuby a dao ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nochhi chhikao a vaih awpa nuby cha Selemiah chô liata tlu ta. A sawchapawpa Zekariah, ryhraotuhpa so ngaitapa châta chhao, nuby a daopa châ ta, ano vai awpa cha maw chhikao a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ôbededô vai awpa cha chho chhikao châ ta, a sawchapawzy cha hmo sopakhyna o vaih awpa ta maophaohna piepa ama châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Notla chhikao a vaih awpa nuby cha Supi nata Hôsâ chô liata tlu ta, lâpi chakhâpa liata Salekhe chhikao a vaih awpazy ama châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nochhi chhikao cha noh chareih ta pacharu ta vaih ei ta, maw chhikao cha noh chareih papalih ta vaih ei ta, chho chhikao chhao noh chareih papalih ta vaih hra ei ta, hmo sopakhyna o vaituhpa châta pano lymâ ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Notla lâta dôhpachhôh tlyhmia vaituhpa châta lâpi liata papalih sopa châ ta, dôhpachhôh tlyhmia liata pano sopa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Âmo cha Kôrâ nata Merâri pathlazy tawhta chhikao vaituhpa py pachhaihpazy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Livai pathla Ahiza cha Khazohpa sôh sopakhyna o nata hmo pathaihpa sopakhyna o vaituhpa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kesao sawchapawzy cha Lâdâ pathlazy châ ei ta, Lâdâ pathla Kesao pho pawhrâhpa cha Zehieli a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zehieli sawchapawzy cha Zethâ nata a unawhpa Zôela châ ei ta, âmo cha Abeipa o liata sôh sopakhynazy a vaotuhpa ama châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amrâ pathla tawhta Izah pathlazy, Hebraw pathlazy nata Uzie pathlazy chhao Abeipa sôh mohôhtuhpazy ama châ hra.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mawsi sawchapawpa Kesao sawchapawpa Sebua cha sôh sopakhyna avaotuhpa hyutuh chaipa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />A unawhzy cha Elieze sawchapawpa Rehabiah, Rehabiah saw­chapawpa Zesai, Zesai sawchapawpa Zôrâ, Zôrâ sawchapawpa Zikari nata Zikari sawchapawpa Selômô zy ama châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Selômô nata a unawhzy cha Bei Dâvi, pho pawhrâhpazy, pheisaih sâh kha hyutuhpazy, pheisaih za kha hyutuhpazy nata pheisaih hyutuh chaipazy ta ama hlâpa, hmohlâpa pathaihpa sopakhyna zydua avaotuhpa ama châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Âmo cha adyuhna liata hraona sôh hmôpa, Abeipa o mohôhna nata taopathina châta ama hlâpa a vaotuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hrohsopa Samuela, Kisâ sawchapawpa Sawla, Nerâ sawchapawpa Abane nata Zeru sawchapawpa Zôabâ zy ta ama hlâpa hmo pathaihpazy a vaotuhpa châ ei ta, hmohlâpa pathaihpa zydua cha Selômô nata a unawhzy mohôhna ry liata sopa a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Izah pathlazy tawhta Khenaniah nata a sawchapawzy cha, Achhyna o raihriazy piepa châ leipa ei ta, Izarei râh chakaona rai hria awpa ta hyutuhpa nata ryureituhpazy ta raopa ama châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hebraw pathlazy tawhta Hâsabiah nata a unawhzy, chyhsa thatlôpa 1,700 zy cha, Zawdâh notla lâta Abeipa raihria zydua nata abei chakaona raihria kyh liata Izarei sawzy a vaotuhpa ama châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hebraw pathla chhâzy a laichadaina liata, Zeriza cha Hebraw pathlazy hry liata pawhrâh chaipa a châ. Dâvi abeina kô sypalihna kô ta Hebraw pathlazy cha tluapa châ ei ta, Kilia râh liata Zaze khihpi liata Hebraw pathla thatlô riahphapazy hmôpa ama châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bei Dâvi ta Zeriza nata a unawh 2,700 zy cha hyutuhpazy ta rao ta. Âmo cha chyhsa thatlôpa nata ama pho pawhrâhpazy châ ei ta, Khazohpa nata a zaopa hmo to nata abei raihria kyh zy liata Rubena chi, Kâdâ chi nata Manase chi khophie hyutuhpa châta raopazy ama châ.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Izarei pho pawhrâhpazy, pheisaih sâh kha hyutuhpazy, pheisaih za kha hyutuhpazy nata ama ry liata hyutuhpazy ama châ. Âmo cha kyh to liata bei chakao ta, kô chhôh zydua ta thla chareih ta a thla lymâ awpazy châ ei ta, py kha liata maluh 24,000 lymâ ama y.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zabadie sawchapawpa Zasôbia cha thla khana liata a chakao awpa py khana pheisaih hyutuhpa châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ano cha Pereza pathla châ ta, pheisaih hyutuhpa zydua hyutuhpa a châ. Thla khana liata a chakao tyh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahôh chyhsa Dôdai cha thla nona liata a chakaopazy pheisaih hyutuhpa châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thla thôhna châta pheisaih hyutuhpa pathôhna cha, Zehôdâ sawchapawpa Benai châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benai he pasaipha sythôh hry liata a hlaopa kha châ ta, pasaipha sythôhzy hyutuhpa a châ. A sawchapawpa Amizabâ cha ano py liata pheisaih hyutuhpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thla palihna châta pheisaih hyutuhpa papalihna cha, Zôabâ unawhpa Asahe châ ta, a sawchapawpa Zebadiah cha ano a pazipa châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thla pangawhna châta pheisaih hyutuhpa papangawhna cha, Izrâ chyhsa Sâmahu châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thla charuna châta pheisaih hyutuhpa pacharuna cha, Tekô chyhsa Ike sawchapawpa Irâ châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thla sarina châta pheisaih hyutuhpa pasarina cha, Epharai pathla Pelôni chyhsa Helezi châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thla chariena châta pheisaih hyutuhpa pachariena cha, Zerâ pathla Husâ chyhsa Sibekai châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thla chakina châta pheisaih hyutuhpa pachakina cha, Benzami pathla Anathô chyhsa Abieze châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thla hrawhna châta pheisaih hyutuhpa pahrawhna cha, Zerâ pathla Netôpha chyhsa Mâharai châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thla hrawh hleikhana châta pheisaih hyutuhpa pahrawh hleikhana cha, Epharai pathla Pirathô chyhsa Benai châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thla hrawh hleinona châta pheisaih hyutuhpa pahrawh hleinona cha, Ôthane pathla Netôpha chyhsa Hedai châ ta, a py liata pheisaih 24,000 ama y.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hezy he Izarei chizy hyutuhpazy ama châ: Rubena chi hyutuhpa cha Zikari sawchapawpa Elieze châ ta, Simeôna chi hyutuhpa cha Mâkâ sawchapawpa Sephatiah a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Livai chi hyutuhpa cha Kemua sawchapawpa Hâsabiah châ ta, Arawna pathlazy hyutuhpa cha Zadô a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zudâh chi hyutuhpa cha Dâvi unawhpa Elihu châ ta, Iskâra chi hyutuhpa cha Mikaila sawchapawpa Ômri a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zebulawna chi hyutuhpa cha Ôbadia sawcha­pawpa Ismiah châ ta, Nâthalai chi hyutuhpa cha Azarie sawchapawpa Zeremô a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Epharai chi hyutuhpa cha Azaziah sawchapawpa Zôela châ ta,
  </para>
  <para style="p">
    <verse number="21" style="v" />Kilia râh liata Manase chi khophiezy hyutuhpa cha Zekaria sawchapawpa Idô a châ. Benzami chi hyutuhpa cha Abane sawchapaw­pa Zasie châ ta,
  </para>
  <para style="p">
    <verse number="22" style="v" />Dânâ chi hyutuhpa cha Zerôhâ sawchapawpa Azare a châ. Âmo cha Izarei chizy liata hyutuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa ta Izarei sawzy cha avâ awhsi zie ta pôh awpa ta bie â vaw taih hapa vâta, kô kih ry lâ cha Dâvi ta ama maluh reih vei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeru sawchapawpa Zôabâ ta maluhpi reih ta, châhrasala patlô vei. Maluhpi reipa vâta Khazohpa pathiiana Izarei chô liata a vaw tlôpa vâna khata, maluh ziepa cha Bei Dâvi thâtih rona châbu liata ropa châ vei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abei sôh mohôhtuhpa cha Adie sawchapawpa Azamâve châ ta, lyuzy, khihpizy, khitawzy nata o sâhpazy liata abei sôh mohôhtuhpa cha Uzia sawchapawpa Zawnathâ a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lyu liata leipalie raihriatuhpazy mohôhtuhpa cha Kheluh sawchapawpa Ezri châ ta,
  </para>
  <para style="p">
    <verse number="27" style="v" />kre sadô mohôhtuhpa cha Râmâ chyhsa Simei châ ta, kre sadô liata kre saohpa sopakhyna môhôhtuhpa cha Siphami chyhsa Zabidi a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bypi kao liata ôli tho nata theiku kô zy mohôhtuhpa cha Kede chyhsa Bâlâhanâ châ ta, sathaw sopakhyna mohôhtuhpa cha Zôasâ a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Saraw si panyupa su liata sahroh zaw mohôhtuhpa cha Saraw chyhsa Sitai châ ta, saikao liata sahroh zaw mohôhtuhpa cha Adalai sawchapawpa Saphâta a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Râraoseihpazy mohôhtuhpa cha Ismela chyhsa Ôbi châ ta, alâzy mohôhtuhpa cha Merônô chyhsa Zediah a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mietaku zaw mohôhtuhpa cha Hâkari chyhsa Zazi a châ. Cha zydua cha Bei Dâvi hmohneipa mohôhtuhpazy ama châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Dâvi puhpa Zawnathâ cha chyhsa sopa nata châthaipa a châpa vâta, ryhraokheituhpa a châ. Ano nata Hâkamôni sawchapawpa Zehie cha abei sawchapawzy pachutuhpa ama châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahitôphe cha abei ryhraokheituhpa châ ta, Arakhi chyhsa Husai cha abei viasa a châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahitôphe cha Benai sawchapawpa Zehôdâ ta a thla ta, Zehôdâ cha Abiathâ ta â thla. Zôabâ cha abei pheisaihzy hyutuh chaipa a châ.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dâvi ta Izarei hyutuhpa zydua, chi hyutuhpazy, bei chakaotuhpa py hyutuhpazy, pheisaih sâh kha hyutuhpazy, pheisaih za kha hyutuhpazy, bei nata a sawchapawzy hmohneipa nata sahroh mohôhtuhpa zydua, pasaiphazy nata a dyuh thaipa pheisaih zydua Zerusale liata awpakhy ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bei Dâvi cha a kaw duah ta, ama hnohta, “Ei unawhzy nata ei chiheihzy saih u, ei bie nathlie teh u. Abeipa Biehrai Byh a pahâ nawpa nata eima Khazohpa phei tlyna châta o sapa awpa ei palôh liata y ta, sana awpa chhao ei pachhuahpanoh haw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Châhrasala Khazohpa ta ei hnohta, ‘Nâ la adyuhpa chyhsa, thisaih a palopa na châpa vâta, ei moh châta o sa aw va chi,’ na tah ha ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chatahrasala Abeipa Izarei Khazohpa ta, kei he Izarei bei ta chhâzaw ta y awpa ta, ei paw chhôhkha zydua hry tawhta nâ tlyh ta. Zudâh cha chhituhpa châta a tlyh ta, Zudâh chi tawhta ei paw chhôhkha a tlyh ta, ei paw sawchapawzy hry tawhta kei cha Izarei zydua chô liata bei châ awpa ta a ly kawpa ta nâ tlyh ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa ta sawchapaw hluhpi na pie ta, ei sawchapawpa Sawlawmaw cha Abeipa khinarâh beidyuchhai liata a tyuh ta, Izarei chô liata ryureih awpa ta a tlyh ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abeipa ta ei hnohta, ‘Ei o nata ei tlyhmiazy cha na sawchapawpa Sawlawmaw ta a padua aw. Ano cha ei sawchapaw châta a tlyh na ta, kei a paw ei châ aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ei biepiepazy nata ei pachianazy pachyu kawpa ta a zyh lymâ khiahta cha, tanoh ta a duahmo hawhna heta, chhâzaw châta a khinarâh ei pa-i aw,’ tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chavâta tahmâ Abeipa phopi Izarei saw zydua mohmô liata nata eima Khazohpa theina liana heta, Abeipa nama Khazohpa biepiepa zydua he zyh ta, pachâ awpa ta ei cha pasyu ei. Chatanachata he râh phapa he hnei aw ei chi ta, châ vaw pazi awpa nama pathlazy ta chhâzaw ta ama hnei awpa ryuto râh châta nama paryu pachhuah lymâ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nâ, Sawlawmaw, ei sawchapawpa y, na paw Khazohpa he pahno la, pathipalôh tlokhuh ta nata tao khona palôh hneipa ta ano cha chakao mah y. Abeipa cha palôh zydua mohtuhpa châ ta, achhuahna nata pachâna zydua pahnotuhpa a châ. Ano cha na tlua khiahta cha, hmô awh chi ta, nâ heihsai khiah deikua cha, chhâzaw ta a cha thy aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />A chado kaw mah y. Supathaihpa châta o sa awpa ta, Abeipa ta a cha rao. Thatlôpa ta y la, hria mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chatanachata Dâvi ta a sawchapawpa Sawlawmaw cha Achhyna o aikah, a ozy, sôh sopakhynazy, o chô chhôhpadâhpazy, o chhôh chhôhpadâhpazy nata zawngiahna dyuchhai chhôhpadâhpa sa nawpa ta a pachhuapanohziezy pie ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abeipa o dôhpachhôh tlyhmia, tlyhmia a chadôpa chhôhpadâhpa zydua, Khazohpa o sôh sopakhynazy nata hmohlâpa pathaihpa sopakhynazy châta a pachhuapanohnazy chhao pie ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dâvi ta Sawlawmaw cha theihthaipazy nata Livai pathlazy a py py ta pachhaihzie nata Abeipa o liata chakaona rai zydua hria nawpazie chho ta. Abeipa o liata chakaona rai hria nawpa hmobaoh kyh zydua chhao chho ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chakaona chi nanopazy châta ngôh hmobaoh taona liata ngôh hmâ awpa zie zy, tâkâ hmobaoh taona liata tâkâ hmâ awpa zie zy,
  </para>
  <para style="p">
    <verse number="15" style="v" />ngôh meiôh patyunazy nata meiôhzy taona châta ngôh hmâ awpa zie zy, meiôh patyuna miakha nata meiôh miakha châta ngôh hmâ awpa zie zy, tâkâ meiôh patyuna miakha nata a meiôhzy châta tâkâ hmâ awpa zie zy cha, chakaona châta meiôh patyuna tao nawpa ta hmâ byuhpa zie lymâ hawhta a chho khai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Viahchhâ chaluahpa tlâhkhai miakha châta ngôh hmâ awpa zie nata tâkâ tlâhkhaizy châta tâkâ hmâ awpa zie zy;
  </para>
  <para style="p">
    <verse number="17" style="v" />sa thaonazy, rahôzy nata nyuzy tao nawpa ta ngôh suapa hmâ awpa zie zy; ngôh biebuhzy tao nawpa ta biebuh miakha liata ngôh hmâ awpa zie zy, tâkâ biebuhzy tao nawpa ta biebuh miakha liata tâkâ hmâ awpa zie nata
  </para>
  <para style="p">
    <verse number="18" style="v" />ngôh suapa ta taopa ropahâhpa raona maisâh châta ngôh hmâ awpa zie zy chho ta. Ngôh cherubi talailih, ama mathlaw pakaipa ta Abeipa Biehrai Byh a khupa tao nawpa châta â chhuanohnazy chhao a chho hra.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dâvi ta, “He zydua he, Abeipa ta ano ku tlai ta a ropa na pie ta, â chhuahna nata a taozie awpa zydua eina pahnosapa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chatawhcha Dâvi ta a sawchapawpa Sawlawmaw hnohta, “Thatlôpa nata riahphapa ta y la, hria mah y. Chi leipa la, a ngiaroh khah y, Zehôvâh Khazohpa, ei Khazohpa tlai cha na hnohta a y mâh tâh. Abeipa o raihria zydua patlô khaipa a châ hlâlei, cha siesai leipa aw ta, cha pathlua aw vei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pachâ teh, Kha­zohpa o liata chakaona raihria zydua hria awpa ta theihthaipa nata Livai pyzy y ei ta, rai zydua liata palôh tlâh kawpa ta cha bao awpa ta, kao to liata a saomâpazy na hnohta ama y. Hyutuhpazy nata zawpi zydua chhao, na biehneina ry liata tlokhuh ama y khai aw,” tah ta.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chatawhcha Bei Dâvi ta zawpi ahmaohpakhypa zydua hnohta, “Ei sawchapawpa Sawlawmaw he, ano deita he Khazohpa ta â tlyhpa châ ta, châhrasala hawtipa a châ chypa vâta hmo pahno tu mâh vei. O rônahpa sa awpa cha chyhsapa châta châ leipa ta, Zehôvâh Khazohpa châta a châpa vâta rai lai ngaitapa châ ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chavâta ei tao theipa rakha liata cha, ei Khazohpa o châta ei pachhuahpanoh chhielie khai haw. Ngôh hmozy châta ngôh, tâkâ hmozy châta tâkâ, dawh hmozy châta dawh, thua hmozy châta thua, tho hmozy châta tho zy ei pachhuahpanoh khai haw. Chazy hleikhô ta, a pangia nawpa ta lôsôhpa cheihchapaipazy, thua rôh ngiapazy, alô rôh chi nanopazy, lôsôhpa to nata awlôteihpa zy chhao a hluhpi ei pachhuapanoh haw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha dei châ vei, o pathaihpa châta ei pachhuapanohpazy hleikhô ta, keima ngôh nata tâkâ zy chhao ei pie pâ hra. Ei Khazohpa o he ei pachâ peimawh ngaitapa vâta, ei Khazohpa o châta ei piepa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ôphi ngôh talent 3,000 nata tâkâ talent 7,000 cha o pâhchhôzy pahu nawpa ta pie na ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />zôthaipazy ta ngôh nata tâkâ ta tao awpa hmo zydua ama tao nawpa châta keima sôh tawhta ei pie. Tanoh he ahy ma Abeipa châta ano kho tlai ta a pie hra aw?” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatanachata chhôhkha pawhrâhpazy, Izarei chi hyutuhpazy, pheisaih sâh kha hyutuhpazy, pheisaih za kha hyutuhpazy nata abei raihria liata hyutuhpazy chhao ta âmo lôhthai ta pie chyu ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khazohpa o sa nawpa ta ama piepa a tlohpakhypa cha ngôh talent 5,000 nata dari 10,000, tâkâ talent 10,000, dawh talent 18,000, thua talent 100,000 a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lôsôhpa a hneipazy chhao ta, Abeipa o sôh châta thyu ei ta, chazy cha Kesao pathla Zehie ta a mohôh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Âmo khopasana tlai ta ama piepa a châpa vâta zawpizy cha amâ ly ngaita. Pathipalôh tlokhuh ta Khazohpa lâ âmo lôhthai ta ama piepa a châ. Bei Dâvi chhao â ly ngaita.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chavâta Dâvi cha zawpi zydua hmia­kô liata Abeipa reithai ta. “Hy Abeipa , miah pathlatuhpa Izarei Khazohpa y, chhâzaw nata tlyzaw ta reithaipa ta y mah y.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hy Abeipa y, rônahna zy, hmotaotheina zy, palyupalihna zy, pahniena zy, abeina zy na eih châ ta, avâzy nata alei liata a ypa zydua chhao na eih a châ. Hy Abeipa , khinarâh cha na eih châ ta, ato chô lâta a to luh châta cheihchalopa na châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hneirôna nata palyupalihnazy cha nâ tawhta a vypa châ ta, ato chô liata ryureituhpa na châ. Hmotaotheina nata thatlôna na ku liata y ta, chyhsa to parônahsa theina nata tha­tlôna pie theina chhao na ku liata a y.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chavâta eima Khazohpa y, tahmâ alyna bie cha hlâ pi ta, na moh rônahpa eima reithai.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Ahy ma châ na ta, ei chiheihzy chhao he ahyzy ma châ ei ta, he hawhta keimo kho tlai ta hmopiepazy eima vaw hlâ thei tly? Hmo to nâ tawhta eima hmôpa châ ta, na eih eima cha pie lilaw heihpa dei a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miah pathlatuhpazy hawhna khata, keimo cha na hmiakô liata khichhaipa nata khitlyhpa hawh dei châ pi ta, alei liata eima hro nohzy he nohpahlipa hawh dei châ ta, hnabeiseih awpa rai y vei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hy Abeipa eima Khazohpa y, na moh pathaihpa y nawpa o eima cha sapa awpa châta eima hmopiepa hluh ngaitapazy he, nâma ku tawhta eima hmôpazy châ ta, ato zydua he na eih sai a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ei Khazohpa y, nâ cha palôh mohpasia chi ta, adona liata nâ ly tahpa ei pahno. Palôh dopa phaopa ta, he hmozy he keima lôhthai tlai ta ei vaw hlâ. He liata a ypa na chyhsazy chhao heta âmo lôhthai tlai ta, a ly ngaitapa ta ama cha vaw hlâ tahpa ei hmô.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hy Abeipa , miah pathlatuhpa Abarahâ, Aisika nata Izarei Khazohpa y, he hawhpa achhuahnazy nata pachânazy he na phopi palôh liata khâ paysa la, ama pathipalôhzy nâ lâ khâ paheisa mah y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ei sawchapawpa Sawlawmaw he, na biepiepazy, na ryhpa biezy nata na bieraopazy zyhpa ta, a zydua ta tao khai sala, o rônahpa cha a chhaichhi hmobaohzy ei chhuanoh hapa hawhta a sa thei nawpa ta, palôh phapakipa paphaosa mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dâvi ta zawpi zydua hnohta, “ Abeipa nama Khazohpa cha reithai teh u,” tah ta. Zawpi zydua ta Abeipa , ama pathlatuhpazy Khazohpa cha reithai ei ta, a bôh ei ta, Abeipa nata abei cha a naoh ei ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Abeipa lâ atheihnazy hlâ ei ta. A mylâ ta Abeipa lâ raopa hlânazy hlâ ei ta, viahchao tôhpa 1,000, mietaku tôhpa 1,000, mietakutaw 1,000, niepa hlânazy chhaota hlâ ei ta, Izarei saw zydua châta atheihna hluhpi ama hlâ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha noh ta Abeipa hmiakô liata thapha ngaitapa ta niepa ta doh ei ta. Chatanachata Dâvi sawchapawpa Sawlawmaw cha bei ta ama pa-i chanei heih. Sawlawmaw cha Abeipa châta ryureituhpa châta sathawthu ei ta, Zadô cha theihthaipa châta sathaw ama thu.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chatana­chata Sawlawmaw cha a paw Dâvi su liata bei châ awpa ta Abeipa beidyuchhai liata a tyuh ta. Vânoh thata to ta, Izarei saw zydua ta a rei amâ ngiah lymâ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hyutuhpa zydua, pasaipha zydua nata Bei Dâvi sawchapaw hropa zydua chhao ta, Bei Sawlawmaw ryureina ry liata ngâchhihpa ta y awpa ta bie amâ taih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abeipa ta Sawlawmaw cha Izarei saw zydua mohmô liata thata parônahsa ta, Izarei râ liata ano hlâta a bei tuapa ahy hmahta ama to thei leipa, bei rônah ngaitapa châna a patosa.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zese sawchapawpa Dâvi cha Izarei saw zydua chô liata a bei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Izarei chô liata Dâvi â beina kô zydua cha kô sypalih a châ. Hebraw liata kô sari a bei ta, Zerusale liata kô sythôh nata kô thôh â bei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bei Dâvi cha chyhsa hneirôhpa nata zachhihpa châ ta, kô hluhpi hroh ta, chhâ a palopa ta thi ha ta. A sawchapawpa Sawlawmaw ta ano su liata â bei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bei Dâvi hmotaopazy cha âthaona tawhta achhâna taihta hrohsopa Samuela châbu liata zy, hrohsopa Nâthâ châbu liata zy, hrohsopa Kâdâ châbu liata zy ropa a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />A ryureina thâtih zydua, a thatlôna thâtihzy, ano nata Izarei chô liata hmo a tlôpa thâtihzy nata khizaw hropa lâta khinarâhzy liata hmo a tlôpa thâtihzy chhao ropa a châ hra.
  </para>
</usx>
