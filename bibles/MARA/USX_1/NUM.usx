<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Malu Reina</book>
  <para style="h">Malu Reina</para>
  <para style="toc1">Malu Reina</para>
  <para style="toc2">Malu Reina</para>
  <para style="mt">Malu Reina</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izi râh ama puasai tawhta kô nona, thla nona, noh khana noh ta, Sinai râhchawhpa liata ahmaohna poh o liata Abeipa ta Mawsi bie a chho ta, a hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy maluhpi reih la, a pho pho ta nata a chhôh chhôh ta chapaw maluh zydua paki teh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kô kih tawhta chô lâ Izarei saw adyuhna lâ sie thei awpa zydua cha, nâ nata Arawna ta a hlao hlao ta ama maluh nama reih khai awpa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chi kha tawhta pakha lymâ ta, chi hyutuhpazy ta ama cha bao aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hezy he châ bao awpa mohzy a châ: Rubena chi tawhta Seidia sawchapawpa Elizu;
  </para>
  <para style="p">
    <verse number="6" style="v" />Simeôna chi tawhta Zurisadai sawchapawpa Selumie;
  </para>
  <para style="p">
    <verse number="7" style="v" />Zudâh chi tawhta Aminadâ sawchapawpa Nâsaw;
  </para>
  <para style="p">
    <verse number="8" style="v" />Iskâra chi tawhta Zuâ sawchapawpa Nethane;
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulawna chi tawhta Helô sawchapawpa Eliabâ;
  </para>
  <para style="p">
    <verse number="10" style="v" />Zawsi pathla Epharai chi tawhta Amihu sawchapawpa Elisâmâ, Manase chi tawhta Pedazu sawchapawpa Kâmalia;
  </para>
  <para style="p">
    <verse number="11" style="v" />Benzami chi tawhta Kidiôni sawchapawpa Abidanâ;
  </para>
  <para style="p">
    <verse number="12" style="v" />Dânâ chi tawhta Amisadai sawchapawpa Ahieze;
  </para>
  <para style="p">
    <verse number="13" style="v" />Asera chi tawhta Okarâ sawchapawpa Pâkie;
  </para>
  <para style="p">
    <verse number="14" style="v" />Kâdâ chi tawhta Due sawchapawpa Eliasaphâ;
  </para>
  <para style="p">
    <verse number="15" style="v" />Nâthalai chi tawhta Enâ sawchapawpa Ahirâ.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Âmo cha zawpizy hry tawhta atlypazy châ ei ta, âmo pathlatuhpa chi liata hyutuhpa, Izarei pho luhpazy ama châ,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mawsi nata Arawna ta ama moh reipa sahlaozy cha a chhi ei ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />thla nona noh khana noh ta zawpi zydua awpakhy khai ei ta, a pho pho ta nata a chhôh chhôh ta ama pathlatuhpazy moh reih lymâ ei ta, ama moh hluhna zie ta, kô kih tawhta chô lâ zydua ama maluh reih khaipa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abeipa biepiepa hawhta, Mawsi ta Izarei sawzy maluh cha Sinai râhchawhpa liata reih ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Izarei sawchapaw uhtheipa Rubena pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="21" style="v" />Rubena pathla tawhta 46,500 ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simeôna pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="23" style="v" />Simeôna pathla tawhta 59,300 ama châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kâdâ pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="25" style="v" />Kâdâ pathla tawhta 45,650 ama châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zudâh pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="27" style="v" />Zudâh pathla tawhta 74,600 ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Iskâra pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="29" style="v" />Iskâra pathla tawhta 54,400 ama châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulawna pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="31" style="v" />Zebulawna pathla tawhta 57,400 ama châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zawsi pathla tawhta Epharai pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="33" style="v" />Epharai pathla tawhta 40,500 ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Manase pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="35" style="v" />Manase pathla tawhta 32,200 ama châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Benzami pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="37" style="v" />Benzami pathla tawhta 35,400 ama châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dânâ pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="39" style="v" />Dânâ pathla tawhta 62,700 ama châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Asera pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="41" style="v" />Asera pathla tawhta 41,500 ama châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nâthalai pathlazy ama chhâ yzie hawhta, a pho pho ta nata a chhôh chhôh ta moh pakipa châ ta, kô kih tawhta chô lâ adyuhna lâ sie thei awpa zydua cha,
  </para>
  <para style="p">
    <verse number="43" style="v" />Nâthalai pathla tawhta 53,400 ama châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chazy cha ama maluh rei theipa, Mawsi nata Arawna ta Izarei chi hrawh hleinozy vyuhpa ta atlypa hyutuhpazy chhaota ama reipa maluh a châ.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chatanachata Izarei saw kô kih tawhta chô lâ, Izarei pheisaih châpa ta adyuhna lâ sie thei awpa zydua maluh cha reih ei ta,
  </para>
  <para style="p">
    <verse number="46" style="v" />ama zydua ta 603,550 ama châ.
  </para>
  <para style="p">
    <verse number="47" style="v" />Livai chi deikua cha, âmo chi eih ta Izarei saw hry liata rei hrapa châ veih ei.
  </para>
  <para style="p">
    <verse number="48" style="v" />A chhâpa cha Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="49" style="v" />“Livai chi deikua cha ama maluh reih leipa aw chi ta, Izarei sawzy hry liata ama maluh na pahlao awpa châ vei.
  </para>
  <para style="p">
    <verse number="50" style="v" />Livai pathlazy cha Biehrai byureih mohôhtuhpa nata a hmobaoh zydua nata cha liata hmo a ypa zydua a mohôhtuhpa ta na rao awpa ei a châ. Achhyna byureih nata a hmobaoh zydua a sy tyh aw ei ta, mohôh aw ei ta, achhyna byureih kiapâh liata a rie aw ei ta, ama ypâ tyh aw.
  </para>
  <para style="p">
    <verse number="51" style="v" />Achhyna byureih pasie awpa a châ khiahta cha, Livai pathlazy ta phie aw ei ta, achhyna byureih parai awpa a châ tita chhao, Livai pathlazy ta ama parai tyh aw. Chyhsa zawrâpa ta achhyna byureih â hnia khiahta cha thie awpa a châ.
  </para>
  <para style="p">
    <verse number="52" style="v" />Izarei sawzy cha a py py ta, âmo riehmo chyu liata nata âmo pheisaih py su chyu liata ama poh o ama rai aw.
  </para>
  <para style="p">
    <verse number="53" style="v" />Livai pathlazy deikua cha, Izarei zawpi chô liata hiehâhna a vaw tlô lei nawpa ta, Biehrai byureih chheipâh liata ama poh o ama rai aw. Livai pathlazy cha Biehrai byureih mohôhtuhpa ama châ aw,” tahpa ta a rei hapa vâta a châ.
  </para>
  <para style="p">
    <verse number="54" style="v" />Cha hawhna chata Izarei sawzy ta tao ei ta, Abeipa ta Mawsi bie a piepa hawhta a zydua ta tao ei ta.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi nata Arawna hnohta hetana heta chho ta:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy ta ama chhôhkha ngiana poh chaluah chyupa ta, ahmaohna poh o nata a hnia tu leipa ta ahmaohna poh o chadôpa ta, a py py ta ama poh o ama rai aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Noh vaw chhina nochhi lâta poh o a rai awpazy cha Zudâh py châ aw ei ta, a py py ta poh o rai aw ei ta, Zudâh pathlazy hyutuhpa cha Aminadâ sawchapawpa Nâsaw châ aw ta,
  </para>
  <para style="p">
    <verse number="4" style="v" />pheisaih 74,600 a hnei aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pazipa ta poh o a rai awpazy cha Iskâra chi châ aw ei ta, Iskâra pathlazy hyutuhpa cha Zuâ sawchapawpa Nethane châ aw ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />pheisaih 54,400 a hnei aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zebulawna pathlazy hyutuhpa cha Helawnâ sawchapawpa Eliabâ châ aw ta,
  </para>
  <para style="p">
    <verse number="8" style="v" />pheisaih 57,400 a hnei aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zudâh py liata sopa pheisaih py nanopazy cha, ama zydua ta 186,400 ama châ. Âmo ta hmia amâ sah lymâ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Chho lâta Rubena py y aw ei ta, Rubena pathlazy hyutuhpa cha Seidia sawchapawpa Elizu châ aw ta,
  </para>
  <para style="p">
    <verse number="11" style="v" />pheisaih 46,500 a hnei aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pazipa ta poh o a rai awpa cha Simeôna chi ama châ aw. Simeôna pathlazy hyutuhpa cha Zurisadai sawchapawpa Selumie châ aw ta,
  </para>
  <para style="p">
    <verse number="13" style="v" />pheisaih 59,300 a hnei aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha khai tawhta Kâdâ chi ta pazi aw ei ta, Kâdâ pathlazy hyutuhpa cha Rue sawchapawpa Eliasaphâ châ aw ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />pheisaih 45,600 a hnei aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rubena py liata sopa pheisaih py nanopazy cha, ama zydua ta 151,450 ama châ. Âmo cha a py nona ta ama sie aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Ahmaohna poh o nata Livai pathlazy poh ozy a liah liata y aw ta, ama sie tita, ahmaohna poh o nata Livai pathlazy cha a liah liata ama sie aw. Chyhsa to ama su chyu liata ypa ta ama sie aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Notla lâta Epharai py y aw ei ta, Epharai pathlazy hyutuhpa cha Amihu sawchapawpa Elisâmâ châ aw ta,
  </para>
  <para style="p">
    <verse number="19" style="v" />pheisaih 40,500 a hnei aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />A pazipa ta Manase chi y aw ei ta, Manase pathlazy hyutuhpa cha Pedazu sawchapawpa Kâmalia châ aw ta,
  </para>
  <para style="p">
    <verse number="21" style="v" />pheisaih 32,200 a hnei aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha khai tawhta Benzami chi ta pazi aw ei ta, Benzami pathlazy hyutuhpa cha Kidiôni sawchapawpa Abidanâ châ aw ta,
  </para>
  <para style="p">
    <verse number="23" style="v" />pheisaih 35,400 a hnei aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Epharai py liata sopa pheisaih py nanopazy cha, ama zydua ta 108,100 ama châ. Âmo cha py thôhna ta a sie awpa ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Maw lâta Dânâ py y aw ei ta, Dânâ pathlazy hyutuhpa cha Amisadai sawchapawpa Ahieze châ aw ta,
  </para>
  <para style="p">
    <verse number="26" style="v" />pheisaih 62,700 a hnei aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />A pazipa ta poh o a rai awpa cha, Asera chi châ aw ei ta, Asera pathlazy hyutuhpa cha Okarâ sawchapawpa Pâkie châ aw ta,
  </para>
  <para style="p">
    <verse number="28" style="v" />pheisaih 41,500 a hnei aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cha khai tawhta Nâthalai chi ta pazi aw ei ta, Nâthalai pathlazy hyutuhpa cha Enâ sawchapawpa Ahirâ châ aw ta,
  </para>
  <para style="p">
    <verse number="30" style="v" />pheisaih 53,400 a hnei aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dânâ py liata sopa pheisaih py nanopazy cha, ama zydua ta 157,600 ama châ. Âmo cha a py py ta a hnôh chai ta a sie awpazy ama châ,” tah ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chazy cha Izarei sawzy maluh ama chhôhkha chyu ta reipazy cha châ ei ta, a py py ta reipa ta ama zydua ta 603,550 ama châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abeipa ta Mawsi hnohta bie a piepa hawhta, Livai chi deikua cha Izarei sawzy hry liata rei pâpa châ veih ei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cha hawhna chata Abeipa ta Mawsi bie a piepa zydua cha Izarei sawzy ta tao ei ta, a py py ta riehmo paryh ei ta, a pho pho ta nata a chhôh chhôh ta puapa ta ama sie lymâ.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Abeipa ta Sinai Tlâh liata Mawsi bie â chho nota, Arawna nata Mawsi pathla a ypazy ama châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hezy he Arawna sawchapawzy moh a châ: Sawchapaw uhtheipa cha Nâdâ châ ta, a pazipazy cha Abihu, Eliaza nata Ithamâ zy ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chazy cha Arawna sawchapawzy moh châ ta, âmo cha sathawthupa theihthaipazy châ ei ta, theihthaipa chakaona rai hria awpa ta chahnaopazy ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nâdâ nata Abihu cha, mei ta hlâlei awpa chi Sinai râhchawhpa liata Abeipa hmiakô ta ama hlâ nota, Abeipa hmiakô liata thi ha ei ta, saw hnei veih ei. Chavâta ama paw Arawna hro chhôh cha, Eliaza nata Ithamâ ta theihthaipa chakaona rai ama hria lymâ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Livai chizy a vaw chhi la, theihthaipa Arawna ama chakao thei nawpa ta âmo cha a hmiakô liata paysa mah y.
  </para>
  <para style="p">
    <verse number="7" style="v" />Âmo ta theihthaipa Arawna nata zawpi zydua chakaona rai ahmaohna poh o hmiakô liata hria aw ei ta, achhyna byureih chakaona rai ama hria aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahmaohna poh o hmobaoh zydua a vao aw ei ta, achhyna byureih chakaona rai hriapa ta Izarei sawzy ama mohôh aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Livai pathlazy cha Arawna nata a sawchapawzy hnohta na pie aw ei. Âmo cha Izarei sawzy hry tawhta Arawna hnohta pie khaipa ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Arawna nata a sawchapawzy cha theihthaipa châta rao aw chi ta, ama theihthai châna ama pazao lymâ aw. Khôtho chyhsa ta theihthaipa chakaona rai hria awpa ta achhyna byureih â hnia khiahta cha, thie awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Pachâ teh, Livai pathlazy cha Izarei sawzy hry liata chhi a pahy tuapa sawchapaw uhtheipazy vyuhpa ta Izarei sawzy tawhta ei lapazy ama châ. Chavâta Livai pathlazy cha kei eih ama châ aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sawchapaw uhtheipa zydua cha kei eih ama châ. Izi râh liata sawchapaw uhtheipa zydua ei thie khai nona khata, Izarei sawzy hry liata sawchapaw uhtheipazy deikua cha, chyhsapa chhao sahroh chhao, ei châta ei pathaisa ei. Chavâta kei eih ama châ aw. Kei he Abeipa ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abeipa ta Sinai râhchawhpa liata Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Livai pathlazy a pho pho ta nata a chhôh chhôh ta ama maluh reih la, chapaw thla kha tawhta chô lâ zydua reih khai mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chatanachata Mawsi ta Abeipa bie hawhta, a hnohta biepiepa hawh tlai ta, ama maluh cha reih ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hezy he Livai sawchapawzy moh a châ: Kesao, Kôhâ nata Merâri.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hezy he ama pho ta a laichadaipa ta Kesao sawchapawzy moh a cha: Libni nata Simei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kôhâ sawchapawzy cha ama pho ta a laichadaipa ta Amrâ, Iza, Hebraw nata Uzie zy ama châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Merâri sawchapawzy cha, ama pho ta a laichadaipa ta, Mâhli nata Musi zy ama châ. Chazy cha a chhôh chhôh ta a laichadaipa ta Livai phozy ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kesao cha Libni pho nata Simei phozy pathlatuhpa châ ta, hezy he Kesao pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chapaw thla kha tawhta chô lâ maluh reipa zydua 7,500 ama châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kesao phozy cha achhyna byureih hnôh lâta notla baih lâta ama poh o rai aw ei ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />Kesao pathlazy hyutuhpa cha Lâe sawchapawpa Eliasaphâ a châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kesao sawchapawzy ta ahmaohna poh o liata ama mohôh awpazy cha, achhyna byureih, poh o nata khuna pohzy, ahmaohna poh o chhikao pohraipazy,
  </para>
  <para style="p">
    <verse number="26" style="v" />dôhpachhôh tlyhmia pohraipazy, achhyna byureih kiapâh liata dôhpachhôh tlyhmia chhikao nata maisâh chadôpa ta pohraipazy nata chaorizy châ aw ta, chazy nata a zaokhipa chakaona rai zydua chhao ama hria khai aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kôhâ cha Amirâ pho zy, Izah pho zy, Hebraw pho nata Uzie phozy pathlatuhpa châ ta, hezy he Kôhâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chapaw thla kha tawhta chô lâ maluh zydua 8,600 châ ei ta, âmo cha su pathaihpa mohôhtuhpa ama châ aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kôhâ sawchapawzy tawhta pho a puapazy cha achhyna byureih chho lâ chhâh ta ama poh o rai aw ei ta,
  </para>
  <para style="p">
    <verse number="30" style="v" />Kôhâ pathla phozy hyutuhpa cha Uzie sawchapawpa Elizaphâ a châ aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ama mohôh awpazy cha Biehrai Byh, tlâhkhai, meiôh sona, maisâh, supathaihpa liata theihthaipa chakaona chhaichhizy nata pohraipa zy châ aw ta, chazy nata a zaokhipa chakaona rai zydua ama mohôh khai aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Theihthaipa Arawna sawchapawpa Eliaza cha Livai chi hyutuhpazy hyutuhpa châ aw ta, supathaihpa mohôhtuhpazy mohôhtuhpa a châ aw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Merâri cha Mâhli pho nata Musi phozy pathlatuhpa châ ta, hezy he Merâri pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chapaw thla kha tawhta chô lâ maluh reipa zydua 6,200 ama châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />Merâri pathlazy hyutuhpa cha Abihai sawchapawpa Zurie châ aw ta, âmo cha achhyna byureih maw lâ chhâh ta ama poh o ama parai aw.
  </para>
  <para style="p">
    <verse number="36" style="v" />Merâri sawchapawzy ta ama mohôh awpazy cha achhyna byureih thophiazy, a tlâhzy, a tôhzy, a patyunazy nata chazy châta a chhaichhi zydua châ aw ta, chazy nata a zaokhipa chakaona zydua ama mohôh aw.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tlyhmia dôhna tôhzy, a patyunazy, a khaipânazy nata a chaorizy chhao ama mohôh aw.
  </para>
  <para style="p">
    <verse number="38" style="v" />Nochhi lâ chhâh ta achhyna byureih hmia lâ, ahmaohna poh o laihmia lâta noh vaw chhi tyhna dady ta poh o a parai awpa cha, Mawsi nata Arawna nata a sawchapawzy châ aw ei ta, âmo ta supathaihpa mohôh aw ei ta, Izarei sawzy ama mohôh aw. Khôtho chyhsa theihthaipa chakaona rai hria awpa ta achhyna byureih a hniapa maih cha thiepa a châ aw.
  </para>
  <para style="p">
    <verse number="39" style="v" />Abeipa biepiepa hawhta, Mawsi nata Arawna ta Livai chizy cha a chhôh chhôh ta ama maluh reih ei ta, chapaw thla kha tawhta chô lâ ama reipa zydua cha 22,000 ama châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Abeipa ta Mawsi hnohta, “Izarei sawzy hry liata sawchapaw uhtheipa thla kha tawhta chô lâ zydua reih la, ama moh roh khai teh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Izarei pathla sawchapaw uhtheipazy vyuhpa ta Livai pathlazy na lapa aw chi ta, Izarei sawzy sahroh pataw tuapazy vyuhpa ta Livai sahrohzy eina lapa aw chi. Kei he Abeipa ei châ,” tah ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mawsi ta Abeipa biepiepa hawhta Izarei sawzy hry liata sawchapaw uhtheipa zydua reih ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Thla kha tawhta chô lâ sawchapaw uhtheipa zydua maluh, ama moh paziahpa tlai ta reipa zydua cha, 22,273 ama châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Izarei pathla sawchapaw uhtheipazy vyuhpa ta Livai pathlazy la la, ama sahroh vyuhpa ta Livai pathlazy sahroh la mah y. Livai pathlazy cha kei eih ama châ aw. Kei he Abeipa ei châ.
  </para>
  <para style="p">
    <verse number="46" style="v" />Izarei sawzy hry liata sawchapaw uhtheipazy maluh cha Livai chi maluh hlâta 273 ta a hluh viapa vâta, âmo chatlai nawpa ta,
  </para>
  <para style="p">
    <verse number="47" style="v" />pakha châta sekel tlaw pangawh lymâ la aw chi ta, sekel reizie cha supathaihpa sekel reizie châ aw ta, kerâ miakih ta sekel tlaw kha reizie hawhta a châ aw.
  </para>
  <para style="p">
    <verse number="48" style="v" />Izarei saw hluh viapazy chatlaina sôh cha Arawna nata a sawchapawzy na pie aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Livai chi maluh ta a chatlai theipa hlâta hluh viapa sawchapaw uhtheipazy chatlaina sôh cha Mawsi ta la ta.
  </para>
  <para style="p">
    <verse number="50" style="v" />Supathaihpa tâkâ reizie ta reipa ta, Izarei sawchapaw uhtheipazy chatlaina sôh sekel 1,365 pakhy ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Abeipa bie hawhta, Abeipa ta Mawsi bie a piepa hawh tlai ta, Mawsi ta chatlaina sôh cha Arawna nata a sawchapawzy hnohta hlâ ta.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi nata Arawna chho ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Livai pathlazy hry liata Kôhâ pathlazy cha, a pho pho ta nata a chhôh chhôh ta ama maluh reih u la,
  </para>
  <para style="p">
    <verse number="3" style="v" />kô sythôh tawhta chô lâ kô sypangawh taih, ahmaohna poh o liata chakaona rai a hria thei awpa maluh zydua nama reih khai awpa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hezy he ahmaohna poh o liata Kôhâ sawchapawzy hria awpa, hmo pathaih chaipazy mohôhna chakaona rai a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Riehmo a pasie awpa a châna maihta Arawna nata a sawchapawzy a ngia aw ei ta, pohraipa pathla aw ei ta, cha chata Biehrai Byh ama khu aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha cha tilaipi viahchao vo ta khu pachhuah aw ei ta, cha chô liata poh nohpa ta khu aw ei ta, a lâzy ama chahraoh aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ypâna viahchhâ tlâhkhai chô liata poh nohpa phaw aw ei ta, cha chô liata beikohzy, phiahthlazy, biebuhzy nata dopa hlâna patlai nawpa nyuzy soh aw ei ta, chiepadâh leipa ta viahchhâ so tyhpa chhao tlâhkhai chô liata a y awpa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chazy cha poh nohsaihpa ta khu aw ei ta, tilaipi viahchao vo ta khu pachhuah aw ei ta, a lâzy ama chahraoh aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Khaihna a pie awpa meiôh sona tôhzy, a meiôhzy, a chaikiezy, meipaoh sonazy nata sathaw ôh zydua poh nohpa ta ama khu khai aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cha cha nata a chhaichhi zydua cha tilaipi viahchao vo ta taopa khuna poh ta chaty aw ei ta, asyna lâzy chô liata ama soh aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ngôh maisâh chô liata poh nohpa phaw aw ei ta, tilaipi viahchao vo ta khu aw ei ta, a lâzy ama chahraoh aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Supathaihpa liata hmâpa chakaona hmobaoh zydua la aw ei ta, poh nohpa ta chaty aw ei ta, tilaipi viahchao vo ta khu aw ei ta, asyna lâ chô liata ama soh aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maisâh liata meipaoh hru aw ei ta, a chô liata poh nohpa ama phaw aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha chô liata maisâh liata chakaona châta hmâpa hmobaoh zydua soh aw ei ta, mei lanazy, sa thaona thuakuzy, buchâh linazy, rahôzy, maisâh hmobaoh zydua cha soh aw ei ta, chazy cha tilaipi viahchao vo ta khu aw ei ta, a lâzy ama chahraoh aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Arawna nata a sawchapawzy ta supathaihpa nata supathaihpa hmobaoh zydua ama khu khai tawhta, riehmo a pasie awpa a châ tita, Kôhâ pathlazy ta supathaihpa nata a hmobaohzy cha amâ sy tyh aw. Hmo pathaihpazy deikua ama hria awpa châ vei. Chataleipatala ama thi pathlei aw. Chazy cha Kôhâ sawchapawzy ta ahmaohna poh o liata ama chakaona rai hria awpazy a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Theihthaipa Arawna sawchapawpa Eliaza mohôh awpazy cha meiôh pakhaih nawpa sathaw, ropahâhpa, a daihtita ta niepa hlâna tao tyhpa nata sathaw pathaihpa zy châ aw ta, achhyna byureih nata a chhôh liata hmo a ypa zydua nata supathaihpa nata a hmobaohzy chhao a mohôh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abeipa ta Mawsi nata Arawna hnohta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kôhâ pathla chi nata phozy Livai chi tawhta chhawh pathlahpa ta ama y awpa châ vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chavâta hmo pathaih chaipazy amâ hnia nota thi leipa ta ama y thei nawpa ta, hetana heta âmo châta ryh nama rao aw: Arawna nata a sawchapawzy ta supathaihpa lâ a ngia aw ei ta, Kôhâ chizy hria awpa nata maophaohnazy ama rai aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khupa hmo pathaihpazy moh awpa ta deikua amâ ngia awpa châ vei. Chataleipatala ama thi pathlei aw,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Kesao pathlazy chhao a pho pho ta nata a chhôh chhôh ta ama maluh reih teh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kô sythôh tawhta a chô lâ kô sypangawh taih, ahmaohna poh o liata chakaona rai a hria thei awpa maluh zydua na reih khai awpa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kesao pathlazy hria awpa cha chakaona nata hmo phaona lâ a châ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Achhyna byureih nata ahmaohna poh o pohraipazy, a khuna poh nata a khu pachhuahna tilaipi viahchao vo nata ahmaohna poh o chhikao pohraipa,
  </para>
  <para style="p">
    <verse number="26" style="v" />dôhpachhôh tlyhmia pohraipazy, achhyna byureih kiapâh liata dôhpachhôh tlyhmia chhikao nata maisâh chadô pohraipazy nata chaorizy phaoh aw ei ta, chazy nata a zaokhipa chakaona rai zydua ama hria khai aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kesao pathlazy raihria awpa zydua cha, ama phao awpa nata ama hria awpa kyh zydua liata, Arawna nata a sawchapawzy biehneina ry liata a y khai aw. Hmo ama phao awpa zydua liata maophaohna chaba awpa ta, Arawna nata a sawchapawzy na rao aw ei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chazy cha ahmaohna poh o liata Kesao chi nata phozy chakaona rai hria awpa châ ta, theihthaipa Arawna sawchapawpa Ithamâ chhihthana ry liata ama hria aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Merâri pathlazy maluh chhao a pho pho ta nata a chhôh chhôh ta reih aw chi ta,
  </para>
  <para style="p">
    <verse number="30" style="v" />kô sythôh tawhta chô lâ kô sypangawh taih, ahmaohna poh o liata chakaona rai a hria thei awpa maluh zydua na reih khai awpa a châ.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hezy he ahmaohna poh o liata chakaona rai hria awpa ta ama hnohta maophaohna piepa a châ: Achhyna byureih thophiazy, thophia tlâhzy, thophia tôhzy nata thophia patyunazy,
  </para>
  <para style="p">
    <verse number="32" style="v" />dôhpachhôh tlyhmia dôhna tôhzy, a patyunazy, a khaipânazy, a chaorizy, a chhaichhi zydua nata a hmobaoh hropa zydua phaoh aw ei ta, ama phao awpazy cha ama moh ta na rai tyh aw ei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chazy cha ahmaohna poh o liata Merâri chi nata phozy chakaona rai hria awpa châ ta, theihthaipa Arawna sawchapawpa Ithamâ chhihthana ry liata ama hria aw,” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kôhâ pathlazy maluh cha, Mawsi nata Arawna nata zawpi hyutuhpazy ta a pho pho ta nata a chhôh chhôh ta reih ei ta,
  </para>
  <para style="p">
    <verse number="35" style="v" />kô sythôh tawhta chô lâ kô sypangawh taih, ahmaohna poh o liata chakaona rai a hria thei awpa,
  </para>
  <para style="p">
    <verse number="36" style="v" />a pho pho ta reipa Kôhâ pathla maluh cha 2,750 a châ.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chazy cha, Abeipa ta Mawsi hmâpa ta bie a piepa hawhta, ahmaohna poh o liata chakaona rai a hriapa Kôhâ pathlazy maluh, Mawsi nata Arawna ta ama reipazy a châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kesao pathlazy maluh chhao a pho pho ta nata a chhôh chhôh ta reipa châ ta,
  </para>
  <para style="p">
    <verse number="39" style="v" />kô sythôh tawhta chô lâ kô sypangawh taih, ahmaohna poh o liata chakaona rai a hria thei awpa,
  </para>
  <para style="p">
    <verse number="40" style="v" />a pho pho ta nata a chhôh chhôh ta reipa Kesao pathla maluh cha 2,630 ama châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chazy cha, Abeipa biepiepa hawhta, ahmaohna poh o liata chakaona rai a hriapa Kesao pathlazy maluh, Mawsi nata Arawna ta ama reipazy a châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Merâri pathlazy maluh chhao a pho pho ta nata a chhôh chhôh ta reipa châ ta,
  </para>
  <para style="p">
    <verse number="43" style="v" />kô sythôhpa tawhta a chô lâ kô sypangawhpa taih, ahmaohna poh o liata chakaona rai a hria thei awpa,
  </para>
  <para style="p">
    <verse number="44" style="v" />a pho pho ta reipa Merâri pathla maluh cha 3,200 ama châ
  </para>
  <para style="p">
    <verse number="45" style="v" />Chazy cha, Abeipa ta Mawsi hmâpa ta bie a piepa hawhta, ahmaohna poh o liata chakaona rai a hriapa Merâri pathlazy maluh, Mawsi nata Arawna ta ama reipazy a châ.
  </para>
  <para style="p">
    <verse number="46" style="v" />Livai chi maluh zydua cha, Mawsi nata Arawna nata Izarei hyutuhpazy ta a pho pho ta nata a chhôh chhôh ta reih ei ta,
  </para>
  <para style="p">
    <verse number="47" style="v" />kô sythôh tawhta chô lâ kô sypangawh taih, ahmaohna poh o liata chakaona rai a hria thei awpa nata ahmaohna poh o hmobaoh a phaoh thei awpa,
  </para>
  <para style="p">
    <verse number="48" style="v" />Livai chi maluh rei theipa cha 8,580 a châ.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mawsi hmâpa ta Abeipa biepiepa hawhta, chyhsa to chakaona raihria awpa nata hmo phao awpa zy rao khaipa a châ. Chatanachata Abeipa ta Mawsi bie a piepa hawhta, Livai chi maluh cha rei khaipa a châ.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy chho la, ama hnohta hetana heta reih teh: Phawhpa tlyma, thihniah lohpa tlyma, athihpa vâta tlyma, pathaih leipa zydua riehmo tawhta papua khai awpa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ama hry liata ei pahrâna ama riehmo ama papuapalei lei nawpa ta, chapaw chhao, chanô chhao, riehmo tawhta papua khai awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izarei sawzy ta cha hawhna chata tao ei ta, pathaih leipazy cha riehmo khôtho lâ paysa ei ta, Abeipa ta Mawsi hnohta a reipa hawh tlai ta Izarei sawzy ta tao ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Izarei sawzy chho la ama hnohta hetana heta reih teh: Chapaw tlyma, chanô tlyma, chyhsazy hmo parao tyhpa kheihawhpa tlyma paraopa ta, Abeipa chô liata ngâchhih leipa ta y sala, thailei a châ khiahta cha,
  </para>
  <para style="p">
    <verse number="7" style="v" />moleina hmo a taopa cha phuah aw ta, a hmo paraona mâ â kipa ta a thô aw. Cha thota, a paraopa mâ su pangawh su kha baichha aw ta, a hmo a paraopa chyhsa hnohta a pie aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmo paraona ty thô awpa chyhsa cha thi ha sala, a ryu a to awpa ama y vei khiahta deikua cha, moleina ty thôna sôh cha Abeipa eih châ aw ta, a molei chatlaina taona mietaku tôhpa chhaota theihthaipa hnohta a pie aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Theihthaipa lâta ama cheipa Izarei sawzy hmohlâpa pathaihpa zydua cha theihthaipa eih a châ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmohlâpa pathaihpazy cha a hlâtuhpa eih châ ta, theihthaipa hnohta a piepazy deikua cha theihthaipa eih a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Izarei sawzy chho la ama hnohta hetana heta reih teh: Chyhsa lapinô ta lâpi doleipa lâ tleipa ta, a vahpa châta ngâchhih leipa sala;
  </para>
  <para style="p">
    <verse number="13" style="v" />chapaw hropa ta ano cha a ziakheipa ta, chanô cha anosasyh ta â papuapalei hapa chhao ta, arulâta hmotaopa châ ta, a tao hai nota ku patupa a châ leipa vâta a pahnopa y leipa ei ta, chavâta a vahpa ta pahno leipa sala;
  </para>
  <para style="p">
    <verse number="14" style="v" />châhrasala a vahpa ta hiatliana palôh hneipa ta, a lapinô cha â papuapalei hapa vâ tlai ta a ngâ khao leipa châ sala tlyma, â papuapalei leipa chhao ta, hiatliana palôh vâta a lapinô cha a ngâ khao leipa khiahta cha,
  </para>
  <para style="p">
    <verse number="15" style="v" />a lapinô cha theihthaipa hnohta a chhi aw ta, a lapinô châta hmo hlâ awpa bâli sâh kachu su hrawh su kha a cheipa aw. Hiatliana niepa hlâna châ ta, paraona atheithlâhna niepa hlâna a châpa vâta, bâli sâh cha sathaw a bao awpa châ leipa ta, deiryh chhao a chô liata a soh awpa châ vei.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Theihthaipa ta chanô cha a chhi aw ta, Abeipa hmiakô liata a paduasa aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Theihthaipa ta alei beih chhôh liata ti pathaihpa ryh aw ta, achhyna byureih siphiah liata buchadoh la aw ta, ti liata a mia aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theihthaipa ta chanô cha Abeipa hmiakô liata paduasa aw ta, a sâ pathliahsa aw ta, atheithlâhna niepa hlâna cha a ku liata a chabasa aw. Cha cha hiatliana niepa hlâna châ ta, theihthaipa ta chhiesana a patlôsapa ti khapa a ku liata â chaba aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chatawhcha theihthaipa ta chanô cha bie pataihsa aw ta, a hnohta, ‘Nâ vahpa ry liata na y thlâh ha nota chapaw hropa ahy hmahta ama châ ziakhei leipa khiahta nata pathaih leipa ta na y leipa khiahta cha, he ti khapa, chhiesana a patlôsapa heta na chô liata biehnei aw vei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngâchhih leipa ta y chi ta, na vahpa ry liata na y thlâh ha nota, na vahpa a châ leipa chapaw ta châ ziakheipa ta, nâ papuapalei ha khiahta deikua cha,’
  </para>
  <para style="p">
    <verse number="21" style="v" />he liana heta theihthaipa ta chanô cha chhiesana bietai pahneisa aw ta, a hnohta, ‘ Abeipa ta na phopi hry liata chhiesapa nata dythapa ta cha tao mawh sy. Na byhpi pazaohsa sala, na py pathlohsa mawh sy.
  </para>
  <para style="p">
    <verse number="22" style="v" />He chhiesana a patlôsapa ti he na py chhôh lâ a ngia sala, na py pathlohsapa ta, na byhpi a pazaohsa mawh sy,’ tah aw ta, chanô ta, ‘Amen, Amen,’ a tah aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Cha khai tawhta theihthaipa ta chhiesana biezy cha châbu liata roh aw ta, ti khapa liata pachie aw ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />chhiesana a patlôsapa ti khapa cha chanô a padosa aw. Chhiesana a patlôsapa ti cha a py chhôh lâ a ngia aw ta, pasana thata a tao aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Theihthaipa ta hiatliana niepa hlâna cha chanô ku tawhta la aw ta, niepa hlâna cha Abeipa hmiakô liata chaluah aw ta, maisâh lâ â vy khei aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Theihthaipa ta atheithlâhna hmo châta niepa hlâna cha pazah kha la aw ta, maisâh liata rao aw ta, cha khai tawhta ti cha chanô a padosa aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ti a padosa khai tawhta hetana heta a vaw y aw: A papuapaleipa ta, a vahpa châta ngâchhih leipa ta a y ha tlai khiahta cha, chhiesana a patlôsapa ti cha a chhôh lâ a ngia aw ta, thata vaw pasa aw ta, a py vaw thloh aw ta, a byhpi a vaw zaoh aw. Chatanachata chanô cha a phopi hry liata chhiesapa ta a y aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chanô cha a papuapalei leipa sala, a pathaih khiahta cha, a chô liata khâpa hmah tlô leipa aw ta, chi chhao a pathla thei aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Cha cha hiatliana kyh liata ryhpa cha châ ta, lapinô ta a vahpa ry liata a y thlâh ha nota, ngâchhih leipa ta â papuapaleina kyh liata ryhpa a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chapaw ta hiatliana vaw hnei ta, a lapinô chô liata a hiatlia tita, theihthaipa ta chanô cha Abeipa hmiakô liata paduasa aw ta, cha ryhpa zydua hawhna chata a chô liata a tao aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chapaw cha paraona tawhta pathaih aw ta, chanô deikua cha a paraona maoh a phaoh aw,” tah ta.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chatawhcha Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy chho la ama hnohta hetana heta reih teh: Chapaw tlyma, chanô tlyma ta Abeipa châta panano eihpa Nâzarai chyhsa châ awpa ta bietai a ipa a tao khiahta cha,
  </para>
  <para style="p">
    <verse number="3" style="v" />kresawhti nata paritheipazy â taih awpa a châ. Kresawhti thaopa nata hmo thaopa tizy a doh awpa châ leipa ta, kre ti a doh awpa châ hra leipa ta, kre thei hrohpa nata chawhpazy a nie awpa châ vei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nâzarai a châ chhôh zydua cha kre zôh tawhta a puapa kheihawhpa rai a nie awpa châ leipa ta, kre hmô nata a hyh zy chhao a nie awpa châ vei.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Nâzarai châ awpa ta bie â taih chhôh zydua a luh â ngyu awpa châ vei. Abeipa châta â pananona noh â ki hlâlei a pathaih awpa châ ta, a luh sâ â paseih awpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />“ Abeipa châta â panano chhôh zydua athihpa ri â hnia awpa châ vei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khazohpa châta â pananona a luh liata a ypa vâta, a paw tlyma, a nô tlyma, a unawhpa tlyma, a sietanô tlyma ama thipa chhao ta, ama ri a hniapa ta â papuapalei awpa châ vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Â panano chhôh zydua Abeipa châta pathaihpa a châ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Chyhsa ta eikhapi ta a kiapâh liata thi sala, â pananona luh a papuapalei khiahta cha, ano pathaisana noh, a noh sarina noh ta a luh â ngyu awpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />A noh chariena noh ta theihthaipa hnohta vachhuh pô no tlyma, pivaw pô no tlyma ahmaohna poh o chhikao liata vaw cheih aw ta,
  </para>
  <para style="p">
    <verse number="11" style="v" />theihthaipa ta pô kha moleina hlâna châta hlâ aw ta, ahropa raopa hlâna ta a hlâ aw. Cha hawhna chata athihpa ri vâta a moleina cha chatlaina taopa aw ta, cha noh lia tlai ta a luh cha a pathaisa aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thaileichâna hlâna châta mietakutaw chapawpa kô khapa cheih aw ta, Nâzarai a châna nohzy Abeipa lâta a pazao heih aw. Â pananona papuapaleipa a châ hapa vâta, hmialâ ta â pananona nohzy reipa châ khao aw vei.
  </para>
  <para style="p">
    <verse number="13" style="v" />“He he Nâzarai chyhsa châta ryhpa, â pananona noh â ki tita tao awpa a châ. Ahmaohna poh o chhikao liata a chhipa châ aw ta,
  </para>
  <para style="p">
    <verse number="14" style="v" />Abeipa lâta a hmohlâpa a hlâ aw. Raopa hlâna châta mietakutaw chapawpa kô khapa seina hnei leipa pô kha, moleina hlâna châta mietakutaw chanôpa kô khapa seina hnei leipa pô kha, aryhna hlâna châta mietaku tôhpa seina hnei leipa pô kha a hlâ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Niepa hlâna nata dopa hlânazy chhao hlâ aw ta, cha liata thinô pahlao leipa viahchhâ nata viahdie dipa sathaw pahlaopa ta pakâhpa viahchhâzy nata thinô pahlao leipa viahchhâ apapa sathaw hniapa zy hrâbyh hmo kha a hlâ aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Theihthaipa ta chazy cha Abeipa hmiakô lâ cheih aw ta, moleina hlâna nata raopa hlâna cha a hlâpa aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thinô pahlao leipa viahchhâ hrâbyh chhaota mietaku tôhpa cha aryhna hlâna ta Abeipa lâ hlâ aw ta, amâ chakaihpa niepa hlâna nata dopa hlânazy chhao theihthaipa ta a hlâ aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nâzarai chyhsa ta â pananona luh cha ahmaohna poh o chhikao liata ngyu aw ta, â pananona luh liata a sâ la aw ta, aryhna hlâna atheihna ry liata mei liata a phôh aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nâzarai chyhsa ta â pananona luh â ngyuh khai tawhta, theihthaipa ta mietaku tôhpa palaih pasyu chiehpa la aw ta, hrâbyh liata thinô pahlao leipa viahchhâ tlâ kha nata thinô pahlao leipa viahchhâ apapa tlâ kha la aw ta, Nâzarai chyhsa ku liata a chabasa aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Theihthaipa ta chazy cha chaluahpa hlâna ta Abeipa hmiakô liata a chaluah aw. Chaluahpa palôh nata chalopa phei cha theihthaipa tovyuh pathaihpa a châ. Cha khai tawhta Nâzarai cha kresawhti a doh thei aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Chazy cha Nâzarai chyhsa châta ryhpa a châ. A hneina ta tloh sala, Nâzarai bietai a lapa hleikhô ta, Abeipa lâta hmohlâpa pie awpa bie â taih chhi khiahta cha, a bietai a patlô awpa châ ta, cha cha Nâzarai chyhsa tao awpa ryhpa hleikhô ta a tao chhi awpazy a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Arawna nata a sawchapawzy chho teh, Izarei sawzy châta hetana heta byhnâ aw awpa a châ,” tah ta:
  </para>
  <para style="p">
    <verse number="24" style="v" />“ Abeipa ta byhnâ cha pie ei sala, Cha vaih lymâ mawh ei sy!
  </para>
  <para style="p">
    <verse number="25" style="v" />Abeipa ta a hmia nama chô liata pakhaihsa sala, Cha ngiachhie mawh ei sy!
  </para>
  <para style="p">
    <verse number="26" style="v" />Abeipa ta nâmo lâ a vaw heih sala, Thlalôhna cha pie mawh ei sy!”
  </para>
  <para style="p">
    <verse number="27" style="v" />“Cha hawhna chata Izarei sawzy chô liata ei moh paysa aw ei ta, kei ta âmo cha byhnâ ei pie aw ei,” tah ta.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mawsi ta achhyna byureih a padua khai nahta, a hmobaoh zydua chhaota sathawthupa ta pathaisa ta. Maisâh nata a beiphiah zydua chhao sathawthupa ta a pathaisa.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chatawhcha Izarei chhituhpazy ta hmohlâpa hlâ ei ta. Âmo cha Izarei chi nata pho maluh reipazy chô liata chhituhpazy ama châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa hmiakô liata ama hmohlâpazy vaw cheih ei ta. Chhituhpa pano liata talailih chô khupa miakha lymâ nata chhituhpa pakha ta viahchao tôhpa pô kha lymâ ta, talailih mia charu nata viahchao tôhpa pô hrawh hleino achhyna byureih hmiakô liata ama hlâ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ama hmohlâpazy kha a hlâh mah y. Ahmaohna poh o raihria châta ama phahnai aw. Livai pathlazy hnohta ama chakaona raihria yzie lymâ hawhta hmâ awpa ta na pie aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawsi ta talailih nata viahchao tôhpazy cha la ta, Livai pathlazy pie ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kesao pathlazy hnohta ama raihria yzie lymâ hawhta, talailih miano nata viahchao tôhpa pô palih pie ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Merâri pathlazy hnohta ama raihria yzie lymâ hawhta, talailih miapalih nata viahchao tôhpa pô charie pie ta. Âmo cha theihthaipa Arawna sawchapawpa Ithamâ chhihthana ry liata a sie awpa ama châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kôhâ pathlazy deikua cha, hmo pathaihpazy mohôhna chakaona raihria ama tovyuh châ ta, hmo pathaihpazy a sy awpa ama châpa vâta, talailih nata viahchao tôhpazy pie vei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Maisâh sathawthu noh liata, chhituhpazy ta maisâh hlâna châta hmohlâpazy hlâ ei ta. Chhituhpazy ta ama hmohlâpazy cha maisâh hmiakô liata ama hlâ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abeipa ta Mawsi hnohta, “Noh kha ta chhituhpa pakha lymâ ta Maisâh hlâna châta ama hmohlâpazy ama hlâ awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Noh khana noh liata hmohlâpa a hlâpa cha, Zudâh chi Aminadâ sawchapawpa Nasô a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="14" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="15" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="16" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="17" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Aminadâ sawchapawpa Nasô hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Noh nona liata Iskâra chi chhituhpa Zuâ sawchapawpa Nethane ta hlâ ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="20" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="21" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="22" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="23" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Zuâ sawchapawpa Nethane hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noh thôhna liata Zebulawna pathlazy chhituhpa Helô sawchapawpa Eliabâ ta hlâ ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="26" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="27" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="28" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="29" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Helô sawchapawpa Eliabâ hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Noh palihna liata Rubena pathlazy chhituhpa Seidia sawchapawpa Elizu ta hlâ ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="32" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="33" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="34" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="35" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Seidia sawchapawpa Elizu hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Noh pangawhna liata Simeôna pathlazy chhituhpa Zurisadai sawchapawpa Selumie ta hlâ ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="38" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="39" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="40" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="41" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Zurisadai sawchapawpa Selumie hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />Noh charuna liata Kâdâ pathlazy chhituhpa Due sawchapawpa Eliasaphâ ta hlâ ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="44" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="45" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="46" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="47" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Due sawchapawpa Eliasaphâ hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="48" style="v" />Noh sarina liata Epharai pathlazy chhituhpa Amihu sawchapawpa Elisâmâ ta hlâ ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="50" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="51" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="52" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="53" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Amihu sawchapawpa Elisâmâ hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="54" style="v" />Noh chariena liata Manase pathlazy chhituhpa Pedazu sawchapawpa Kâmalia ta hlâ ta.
  </para>
  <para style="p">
    <verse number="55" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="56" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="57" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="58" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="59" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh zy a châ. Chazy cha Pedazu sawchapawpa Kâmalia hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="60" style="v" />Noh chakina liata Benzami pathlazy chhituhpa Kidiôni sawchapawpa Abidanâ ta hlâ ta.
  </para>
  <para style="p">
    <verse number="61" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="62" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="63" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="64" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="65" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Kidiôni sawchapawpa Abidanâ hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="66" style="v" />Noh hrawhna liata Dânâ pathlazy chhituhpa Amisadai sawchapawpa Ahieze ta hlâ ta.
  </para>
  <para style="p">
    <verse number="67" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="68" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="69" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="70" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="71" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Amisadai sawchapawpa Ahieze hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="72" style="v" />Noh hrawh hleikhana liata Asera pathlazy chhituhpa Okarâ sawchapawpa Pâkie ta hlâ ta.
  </para>
  <para style="p">
    <verse number="73" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="74" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="75" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="76" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="77" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Okarâ sawchapawpa Pâkie hmohlâpazy cha a châ.
  </para>
  <para style="p">
    <verse number="78" style="v" />Noh hrawh hleinona liata Nâthalai pathlazy chhituhpa Enâ sawchapawpa Ahirâ ta hlâ ta.
  </para>
  <para style="p">
    <verse number="79" style="v" />A hmohlâpa cha supathaihpa sekel reizie ta reipa ta, niepa hlâna châta sathaw pahlaopa viahdie dipa ta pabiepa tâkâ beikoh sekel 130 a hripa miakha nata tâkâ biebuh sekel sysari a hripa miakha;
  </para>
  <para style="p">
    <verse number="80" style="v" />ropahâhpa ta pabiepa ngôh phiahthla sekel miahrawh a hripa miakha;
  </para>
  <para style="p">
    <verse number="81" style="v" />raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô kha;
  </para>
  <para style="p">
    <verse number="82" style="v" />moleina hlâna châta mie tôhpa pô kha;
  </para>
  <para style="p">
    <verse number="83" style="v" />aryhna hlâna atheihna châta viahchao tôhpa pô no, mietaku tôhpa pô pangawh, mie tôhpa pô pangawh nata mietakutaw chapawpa kô khapa pô pangawh a châ. Chazy cha Enâ sawchapawpa Ahirâ hmohlâpazy a châ.
  </para>
  <para style="p">
    <verse number="84" style="v" />Hezy he maisâh sathawthu noh liata Izarei chhituhpazy ta maisâh châta ama hmohlâpazy a châ: Tâkâ beikoh mia hrawh hleino, tâkâ biebuh mia hrawh hleino, ngôh phiahthla mia hrawh hleino ama hlâ.
  </para>
  <para style="p">
    <verse number="85" style="v" />Tâkâ beikoh cha sekel 130 a hri ta, biebuh cha sekel sysari â hri. Tâkâ hmobaoh zydua cha supathaihpa sekel reizie ta reipa ta, sekel 2,400 a châ.
  </para>
  <para style="p">
    <verse number="86" style="v" />Ropahâhpa ta pabiepa ngôh phiahthla mia hrawh hleino cha, supathaihpa sekel reizie ta reipa ta, sekel miahrawh a hripa sai châ ta, ngôh phiahthlazy cha a zydua ta sekel 120 a châ.
  </para>
  <para style="p">
    <verse number="87" style="v" />Niepa hlâna chhaota hlâpa raopa hlâna zydua cha, viahchao tôhpa pô hrawh hleino, mietaku tôhpa pô hrawh hleino nata mietakutaw chapawpa kô khapa pô hrawh hleino châ ta, moleina hlâna atheihna châta mie tôhpa pô hrawh hleino hlâpa a châ.
  </para>
  <para style="p">
    <verse number="88" style="v" />Aryhna hlâna atheihna châta hmohlâpa cha a zydua ta viahchao tôhpa pô kih nata pô palih, mietaku tôhpa sycharu, mie tôhpa sycharu nata mietakutaw chapawpa kô khapa sycharu a châ. Chazy cha maisâh sathawthupa a châ khai tawhta maisâh hlâna hmopiepazy a châ.
  </para>
  <para style="p">
    <verse number="89" style="v" />Mawsi cha Abeipa bie a chho awpa ta ahmaohna poh o chhôh lâ â ngia nahta, Biehrai Byh chô liata a ypa zawngiahna dyuchhai chô lâta cherubi miano likawh tawhta ano bie a vaw chhopa ao thei ta. Abeipa ta Mawsi cha bie a chho ta.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arawna chho la, a hnohta, ‘meiôhzy na pakhaih tita, meiôh miasari ta meiôh tôh hmia lâ a khaih awpa a châ,’ tah teh,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa ta Mawsi bie a piepa hawhta Arawna ta tao ta, meiôhzy cha meiôh tôh hmialâ ta pakhaih ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />He he ngôh ta daipa meiôh tôh taozie a châ. A tôh thaby tawhta a pawzy taihta daipa ta taopa châ ta, Abeipa ta a taozie awpa Mawsi a pahmôsapa hawh tlai ta, meiôh tôh cha taopa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Izarei sawzy hry tawhta Livai pathlazy panano la, âmo cha pathaisa mah y.
  </para>
  <para style="p">
    <verse number="7" style="v" />Âmo pathaisa awpa ta, hetana heta ama chô liata na tao aw: Ama chô liata pathaisana ti thia aw chi ta, ama pôhpa hmi zydua a ngyu aw ei ta, ama chysiazy pasu aw ei ta, amâ pathai aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chatawhcha viahchao tôh dawpa pô kha, niepa hlâna viahdie dipa sathaw pahlaopa chhaota a chhi aw ei ta, moleina hlâna châta viahchao tôh dawpa pô kha nâ chhi pâ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Livai pathlazy cha ahmaohna poh o hmiakô lâ a chhi aw chi ta, Izarei zawpi zydua na awpakhy aw ei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Livai pathlazy cha Abeipa hmiakô lâ a chhi aw chi ta, Izarei sawzy ta Livai pathlazy chô liata ama ku ama pahnieh aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arawna ta Livai pathlazy cha, Izarei sawzy tawhta chaluahpa hlâna ta Abeipa hmiakô liata hlâ aw ta, chatanachata Abeipa chakaona rai ama hria thei aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Livai pathlazy ta viahchao tôhpazy luh liata ama ku pahnieh aw ei ta, âmo châta chatlaina tao nawpa ta, moleina hlâna châta pô kha hlâ aw chi ta, raopa hlâna ta pô kha na hlâ aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Livai pathlazy cha Arawna nata a sawchapawzy hmiakô liata paduasa aw chi ta, Abeipa lâta chaluahpa hlâna ta na chaluah aw ei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha hawhna chata Izarei sawzy hry tawhta Livai pathlazy cha panano aw chi ta, Livai pathlazy cha kei eih ama châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Âmo cha pathaisapa ta chaluahpa hlâna ta na chaluah khai tawh ei ta, Livai pathlazy cha chakaona rai hria awpa ta ahmaohna poh o liata amâ ngia aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Âmo cha Izarei sawzy hry tawhta kei lâta tlokhuh hlâpa châ ei ta, chhi a pahypa, Izarei pathlazy sawchapaw uhtheipa zydua vyuhpa ta kei eih châ awpa ta ei la ei.
  </para>
  <para style="p">
    <verse number="17" style="v" />Izarei sawzy hry liata sawchapaw uhtheipa zydua cha, chyhsapa chhao, sahroh chhao, kei eih ama châ. Izi râh liata sawchapaw uhtheipa zydua ei thie khai nota, âmo cha kei châta ei pathaisapazy ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chavâta Izarei sawzy hry liata sawchapaw uhtheipa zydua vyuhpa ta, Livai pathlazy cha kei eih ta ei la ei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Izarei sawzy châta ahmaohna poh o liata chakaona rai hria awpa nata Izarei sawzy ta supathaihpa amâ hnia tita ama hry liata potlana a y lei nawpa ta chatlaina taopa awpa ta, Izarei sawzy hry tawhta Livai pathlazy cha Arawna nata a sawchapawzy hnohta hmosaipiepa ta ei pie ei,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cha hawhna chata Mawsi nata Arawna nata Izarei zawpi zydua ta Livai pathlazy chô liata tao ei ta. Livai pathlazy kyh liata Abeipa ta Mawsi bie a piepa hawhta, Izarei sawzy ta ama chô liata ama tao.
  </para>
  <para style="p">
    <verse number="21" style="v" />Livai pathlazy cha ama moleina tawhta a pathai ei ta, ama chysiazy pasu ei ta, Arawna ta âmo cha chaluahpa hlâna ta Abeipa hmiakô liata hlâ ta, âmo pathaisa nawpa ta Arawna ta chatlaina a taopa ei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha khai tawhta Livai pathlazy cha Arawna nata a sawchapawzy hmiakô liata chakaona rai hria awpa ta ahmaohna poh o chhôh lâ a ngia ei ta, Livai pathlazy kyh liata Abeipa ta Mawsi bie a piepa hawhta ama chô liata ama tao.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="24" style="v" />“He he Livai pathlazy zyh awpa ryhpa a châ. Kô kih nata kô pangawh tawhta chô lâ Livai pathlazy ta ahmaohna poh o liata chakaona rai hria awpa ta amâ ngia aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kô sypangawh tawhta cha chakaona rai amâ pahâsai awpa châ ta, ama chakao awpa châ khao vei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahmaohna poh o mohôhna kyh liata ama unawhzy rai bao tyh aw ei ta, chakaona rai deikua cha hria khao aw veih ei. Cha hawhna chata Livai pathlazy cha ama raihria awpa na raopa aw ei,” tah ta.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izi râh ama puasai tawhta kô nona thla khana liata, Abeipa ta Sinai râhchawhpa liata Mawsi bie a chho ta, a hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy ta daihti raopa liata zawpakhô kyhchhi ama hnei tyh awpa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />He thla noh hrawh hleipalihna noh zâlâ nohtla daihti he, daihti raopa châta hnei aw ei chi ta, zawpakhô bieraopa nata ryhpa zydua hawhta nama chay tyh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cha hawhna chata Mawsi ta Izarei sawzy cha zawpakhô kyhchhi chay awpa ta chho ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chatanachata thla khana noh hrawh hleipalih noh zâlâ nohtla daihti liata, Sinai râhchawhpa liata zawpakhô kyhchhi cha chay ei ta. Abeipa ta Mawsi bie a piepa zydua hawhta Izarei sawzy ta ama tao.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thokha deikua cha athihpa ri vâta pathaih leipa châ ha ei ta, cha noh liata zawpakhô kyhchhi chay thei veih ei. Chavâta cha noh liata Mawsi nata Arawna hmiakô liata a vy ei ta,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mawsi hnohta, “Athihpa ri vâta pathaih leipa châ ha pi ta, châhrasala khazia daihti raopa liata Izarei sawzy hry liata Abeipa lâta hmohlâpa eima hlâ hra awpa cha pakhâpa ta eima y?” tah ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mawsi ta ama hnohta, “Vaw hâ chy teh u, nâmo kyh liata Abeipa ta kheihta ma bie a pie aw tahpa ei nathlie ha tua aw,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Izarei sawzy hnohta hetana heta chho teh: Nâmo tlyma, nama pathlazy hry liata ahy tlyma, athihpa ri vâta pathaih leipa nata khitlyhpazy ama y khiahta cha, Abeipa zawpakhô kyhchhi ama chay hra awpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thla nona, noh hrawh hleipalihna noh zâlâ nohtla daihti liata chay aw ei ta, viahchhâ thinô pahlao leipa nata âhnalasi khapazy chhaota ama nie awpa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mylâ my taihta khâpa hmah ama pahlôh awpa châ leipa ta, a rupa rai ama thlie awpa châ vei. Zawpakhô kyhchhi liata tao awpa raopa zydua hawhta ama chay awpa a châ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chyhsa pathaihpa châ ta, khitlyna hnei tlôh leipa ta, zawpakhô kyhchhi a chay leipa khiahta deikua cha, cha chyhsa cha a phopi tawhta chhawh pathlahpa a châ aw. Daihti raopa liata Abeipa lâta hmohlâpa a hlâ leipa vâta, cha chyhsa cha a moleina maoh a phaoh aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chihropa chyhsa nama hnohta a pahrâpa ta Abeipa zawpakhô kyhchhi a chay khoh hra khiahta cha, zawpakhô kyhchhi bieraopa nata ryhpa hawhta a chay hra aw. A râh chyhsa nata chihropazy châta ryhpa miakha nama hnei awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Achhyna byureih padua noh ta, pahnokheina poh o achhyna byureih cha meihdo ta vaw pahly ta. Zâlâ tawhta my taihta achhyna byureih chô liata mei hawhta a vaw luah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha hawhna chata y thlâh ha tyh ta. Nohchhô ta meihdo ta pahly ta, azo ta mei hawhta a luah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Meihdo ta poh o â pasâhsai nahta, Izarei sawzy cha a pasie ei ta, meihdo â duana su liata Izarei sawzy cha a rie tyh ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abeipa biepiepa ta Izarei sawzy cha sie lymâ ei ta, Abeipa biepiepa ta a rie ei ta, achhyna byureih chô liata meihdo â chhoh chhôh zydua cha amâ rie thlâh ha tyh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Meihdo ta achhyna byureih chô liata noh hluhpi a ypa chhao ta, Izarei sawzy cha Abeipa bie zyh ei ta a pasie veih ei.
  </para>
  <para style="p">
    <verse number="20" style="v" />A châh ta meihdo cha achhyna byureih chô liata noh chyhta dei y ta, chatanachata Abeipa biepiepa hawhta a rie ei ta, Abeipa biepiepa hawhta ama sie tyh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A châh ta meihdo cha zâlâ tawhta my taihta y ta, my ta meihdo â pasâh nahta sie ei ta, chhô nah zâ ta meihdo â chhoh ha khiahta cha, meihdo â pasâh nahta ama sie tyh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Achhyna byureih chô liata meihdo cha noh no tlyma, thla kha tlyma, kô kha tlyma rai y sala, cha liata â chhoh ngâ thlâh ha khiahta cha, Izarei sawzy cha riehmo liata y thlâh ha ei ta, sie veih ei. Meihdo â pasâh nahta ama sie tyh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa biepiepa ta a rie ei ta, Abeipa biepiepa ta sie ei ta, Mawsi hmâpa ta Abeipa biepiepa hawhta, Abeipa bie cha ama zyh lymâ.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta hetana heta Mawsi chho ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Tâkâ chiahmie miano tao teh. Daipa ta tao aw chi ta, zawpi awpakhyna châta nata pasiesana châta na hmâh aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chiahmie cha a miano ta tôpa a châ tita, zawpi zydua cha ahmaohna poh o chhikao kiapâh liata na hmiakô liata amâ vaw pakhy khai awpa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chiahmie miakha deita tôpa a châ khiahta cha, chhituhpazy, Izarei chizy hyutuhpazy deita na hmiakô liata amâ vaw hmaoh aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zikyurâna chiahmie a chyuta ta tôpa a châ khiahta cha, nochhi lâta poh o a raipazy ama pua aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zikyurâna chiahmie a einona tôpa a châ khiahta cha, chho lâta poh o a raipazy ama pua aw. Sie awpa daihti maihta zikyurâna chiahmie tô tyh awpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zawpi apakhy nawpa châta tôpa a châ khiahta cha, chiahmie cha a pasi pi ta tô awpa châ ta, zikyurâna chiahmie hawhta a chyuta ta tô awpa châ vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Arawna sawchapawpa theihthaipazy ta chiahmie cha ama tô awpa a châ. He he nama chhâ zydua châta ryhpa ta nama hnei lymâ awpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nama râh liata khakhaipa châ tlybaipazy a dyuh awpa ta nama sie tita, zikyurâna chiahmiezy nama tô awpa a châ. Chatanachata Abeipa nama Khazohpa hmiakô liata a thei thlâh hapa ta y aw ei chi ta, nama khakhaipazy tawhta pachhapa nama châ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nama thaphana noh liata zy, nama kyhchhi daihti raopa liata zy, nama thla thiehpa liata zy, nama raopa hlâna nata nama aryhna hlâna atheihna liata zy chiahmie nama tô awpa a châ. Hezy he nâmo châta nama Khazohpa hmiakô liata atheithlâhna châta a châ aw: Kei he Abeipa nama Khazohpa ei châ.”
  </para>
  <para style="p">
    <verse number="11" style="v" />Kô nona, thla nona, cha thla noh kih noh ta meihdo cha pahnokheina byureih chô tawhta a pasâh ha ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Izarei sawzy cha Sinai râhchawhpa tawhta a py py ta sie ei ta, meihdo cha Pârâ râhchawhpa liata a duah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mawsi hmâpa ta Abeipa biepiepa hawhta a ei khana châta amâ pasiena a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hmiatua chaipa ta Zudâh py liata a ypazy a py py ta pua ei ta, ama hyutuhpa cha Aminadâ sawchapawpa Nasô a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Iskâra chi hyutuhpa cha Zuâ sawchapawpa Nethane a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zebulawna chi hyutuhpa cha Helô sawchapawpa Eliabâ a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha khai tawhta achhyna byureih phie ei ta, Kesao sawchapawzy nata Merâri sawchapawzy ta achhyna byureih cha a sy ei ta, ama sie.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chatawhcha Rubena py liata a ypazy a py py ta pua ei ta, ama hyutuhpa cha Seidia sawchapawpa Elizu a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Simeôna chi hyutuhpa cha Zurisadai sawchapawpa Selumie a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kâdâ chi hyutuhpa cha Due sawchapawpa Eliasaphâ a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chatawhcha Kôhâ pathlazy ta hmobaoh pathaihpazy a sypa ta pua ei ta, zawpi ama tlô hlâta achhyna byureih cha padua khaipa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cha khai tawhta Epharai py liata a ypazy a py py ta pua ei ta, ama hyutuhpa cha Amihu sawchapawpa Elisâmâ a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Manase chi hyutuhpa cha Pedazu sawchapawpa Kâmalia a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Benzami chi hyutuhpa cha Kidiôni sawchapawpa Abidanâ a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />A hnôh chaipa ta Dânâ py liata a ypazy a py py ta pua ei ta, ama hyutuhpa cha Amisadai sawchapawpa Ahieze a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Asera chi hyutuhpa cha Ôkarâ sawchapawpa Pâkie a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nâthalai chi hyutuhpa cha Enâ sawchapawpa Ahirâ a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cha hawhna chata Izarei sawzy cha a py py ta pua ei ta, ama sie lymâ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mawsi puhpa Midia chyhsa Rue sawchapawpa Hôbâ hnohta Mawsi ta, “ Abeipa ta, ‘Ei cha pie aw ei,’ a tahpa su lâ eima pangai hai. Abeipa ta Izarei sawzy châta hmo phapa bie a taih ha ta, chavâta eima hnohta vaw sie hra teh, a pha ngaitapa ta na chô liata eima tao aw,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hôbâ ta Mawsi hnohta, “Vaw sie aw va na, ei râh nata ei chiheihzy lâ tlao ei lie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mawsi ta, “Rie miah siesai khah y. Râhchawhpa liata riehmo eima tao nawpa su a pahnopa châ chi ta, eima châta mokhaoh na châ aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Eima hnohta na sie hra khiahta cha, Abeipa ta eima chô liata hmopha a taopa hawhta na chô liata eima tao hra aw,” tah ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chatanachata Abeipa tlâh tawhta pua ei ta, noh thôh lâsie taih sie ei ta. Amâ pahâ nawpa su tlua awpa ta, Abeipa Biehrai Byh cha noh thôh chhôh ama hmia lâta sie ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama riehmo tawhta ama pua nahta, Abeipa meihdo cha nohchhô ta ama chô liata y ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Byh a puana maihta Mawsi ta, “Hy Abeipa , vaw thyu mah y; Na chariahpazy papaipa ta y ei sala, Châ haotuhpazy na hmiakô tawhta a râpai mawh ei sy,” tah ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Byh â pahâna maihta, “Hy Abeipa , vaw kua la, Izarei saw thysâh hluhpi lâ vaw kua heih mah y,” a tah tyh.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zawpi ta rairuna amâ tyhpazy vâta Abeipa theina liata paphôh ei ta. Cha cha Abeipa ta a thei nahta, a hiehâh ta. Chatanachata Abeipa mei ama hry liata vaw pua ta, ama riehmo chaki liata su thokhazy vaw kâ ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zawpi ta Mawsi awsao ei ta, Mawsi ta Abeipa lâ thlahchhâ ta, chatanachata mei cha dia ha ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa mei ama hry liata a vaw puapa vâta, cha su moh cha Tâberâ bipa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ama hnohta a sie hrapa chihropazy ta sa nie khona thata vaw hnei ei ta. Izarei mo chhao cha sa vâpa ta cha ei ta, “Sa eima nie byuh rimâ cha!
  </para>
  <para style="p">
    <verse number="5" style="v" />Izi râh liata ngasa a mâ leipa ta eima nie tyhpazy, atheizy, bokaihzy, khâchhao hrohpazy, khâchhao saihpa nata khâchhao râhpazy eima vâ rimâ cha!
  </para>
  <para style="p">
    <verse number="6" style="v" />Tahmâ cha eima tha chhao a chhâ khai ha hih. He mânâ dei leipa heta eima hmô hropa y tlôh va,” tah ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mânâ cha sysadi chi hawhta y ta, â lânazie cha kre thei chawhpa a lyu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cha cha zawpi ta a huah ei ta, charona liata charopa ta, sôkhaoh liata daih ei ta, cha khai tawhta beih liata chhoh ei ta, viahchhâ ta ama tao. A pahânazie cha viahdie sathaw pahlaopa ta taopa viahchhâ hawhta a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Riehmo liata zâ ta diati a za tla nahta, mânâ chhao diati chô liata a za tla tyh hra.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zawpizy a chhôh chhôh ta ama poh o chhikao chyu liata ama chapa Mawsi ta pahno ta. Abeipa cha thata a hiehâh ta, chavâta Mawsi cha a nôpo ngaita ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mawsi ta Abeipa hnohta, “Khazia châ chakaotuhpa chô liata hmo pha leipa na tao? Kheihawhpa liata ma na mody leipa ta y na ta, he zawpi zydua phaohri he ei chô liata na pahnieh tly?
  </para>
  <para style="p">
    <verse number="12" style="v" />He zawpi zydua he ei phaopa ma ama châ? Ei sapazy ma ama châ? Khazia nawh apyhpa ta sâhpi a bâhpa hawsaih â pyhpa hawhta, âmo cha ei kalachhôh liata a pyh laih ta, ama pathlatuhpazy hnohta bie nâ taihpa râh lâ siekhei awpa ta eina chho chi?
  </para>
  <para style="p">
    <verse number="13" style="v" />He zawpi zydua pie awpa heta khataih liata sa ma ei hnei aw? ‘Eima nie awpa sa miah pie teh,’ tahpa ta cha ei ta, eina patypamâ ngâ thlâh ha ei hih.
  </para>
  <para style="p">
    <verse number="14" style="v" />He zawpi zydua he kei dei ta phaoh thei veih ei na. Ei phao awpa he â hri tu haw.
  </para>
  <para style="p">
    <verse number="15" style="v" />He hawhta eina tao awpa chi khiahta cha, na ngiachhie la, â ryh na tah khiahta cha, na thie lâlao thlâh ha la, nôpo pachârôhna a tyh awpa na pakhôkhâhsa mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa ta Mawsi hnohta, “Izarei machâzy hry tawhta machâ nata chhituhpa ta na pahnopa sysari na awpakhypa la, âmo cha ahmaohna poh o lâ a vaw chhi la, cha liata na hnohta a duah mawh ei sy.
  </para>
  <para style="p">
    <verse number="17" style="v" />Za chô aw na ta, cha liata bie ei châ vaw chho aw. Nâ liata thlahpa a ypa kha la aw na ta, ama chô liata ei soh aw. Chatanachata zawpi phaohri cha, cha phaokhei aw ei ta, nâ dei ta phaoh khao aw va chi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zawpi hnohta, ‘Mylâ châta a pathai teh u, sa cha nama nie aw. Abeipa theina liata, “Sa nie awpa ahy ma miah a pie aw? Izi râh liana kha eima phasa viapa tlai,” tahpa ta cha ei chi ta. Chavâta Abeipa ta sa cha pie aw ei ta, nama nie aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Noh kha tlyma, noh no tlyma, noh pangawh tlyma, noh hrawh tlyma, noh kih tlyma dei nie aw veih ei chi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nama hry liata a ypa Abeipa dythapa ta, chana chôta Abeipa hmiakô liata paphôh ei chi ta, “Khazia ma Izi râh tawhta eima kaw pua tly?” nama tahpa vâta, thla kha chhôh tlai, aina taih nata apalithluna taihta nama nie aw,’ tahpa ta na chho aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mawsi ta a chhy ta, “Ei sielâhpa zawpi phei ta sie theipazy he chyhsa 600,000 châ ei ta, ‘Thla kha chhôh nie awpa sa ei pie aw ei’ tah chi ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mietaku zaw nata sahroh zawzy thie khaipa chhao ta, ama châta â daih aw ma? Tilaipi nga zydua patu khaipa hmah châ sala, ama châta â daih aw ma?” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa ta Mawsi hnohta, “ Abeipa cha a ku a chyuta ma? Ei bie hawhta na chô liata a vaw tlô nata tlô lei na pahno aw,” tah ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chatawhcha Mawsi cha pua ta, Abeipa bie cha zawpizy chho ta. Zawpi chhituhpa machâ sysarizy cha aw ta, poh o chadôpa ta paduasa ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abeipa cha meihdo hry liata a zu ta, Mawsi cha bie a chho ta, ano liata thlahpa cha la ta, machâ sysarizy chô liata soh ta. Thlahpa ama chô liata a ypa nahta, machâzy cha hrohsona bie phuah ei ta. Châhrasala cha hawhta tao pazao ngâ thlâh ha veih ei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Riehmo liata machâ pano a ngua ei ta, pakhapa moh cha Eldâ châ ta, a hropa moh cha Medâ a châ. Thlahpa cha âmo chô liata chhao y ta. Âmo cha machâ sysari atlyhpazy hry liata a hlao ei ta, châhrasala ahmaohna poh o lâ vawh leipa ta, riehmo liata hrohsona bie tlao phuah ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Satlia pakha a kei râ ta, Mawsi hnohta, “Eldâ nata Medâ ta riehmo liata hrohsona bie ama phuah,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nunâ sawchapawpa Zawsua, a thyutlia daihti tawhta Mawsi chakaotuhpa ta, “Ei zibeipa Mawsi, âmo cha pakhâ mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Châhrasala Mawsi ta a hnohta, “Ei chhâh a châpa ta hiatliapa ma na châ tly? Kei la Abeipa chyhsa zydua hrohsopa châ khai ei sala, Abeipa ta a Thlahpa ama chô liata soh khai sala tahpa tlao ei khoh,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cha khai tawhta Mawsi nata Izarei machâzy cha riehmo lâ a di ha ei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chatawhcha Abeipa tawhta thlih vaw pathli ta, tilaipi tawhta mamozy vaw phaoh ta, riehmo chheipâh liata vaw patlasa ta, riehmo hiakha lâ noh kha sie nata hiakha lâ noh kha sie zydua cha mamozy ta dy no chhapa ta bie ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zawpizy cha pua ei ta, noh y nata zâkhihdei mamozy cha a huah ei ta, a mylâ chhao noh y ta a huah ei ta. A huah chyh chaipa hmahta kaichhieh mia hrawh tlai a huah ta, riehmo chheipâh liata pachawh chyu ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sa cha nie ei ta, châhrasala sa cha ama palâ hlâta, ama hâh nata hâh likawh liata a y thlâh ha chy nota, Abeipa hiehâhna zawpi chô liata vaw tlô ta, Abeipa ta potlana rarôh y ngaitapa ta chyhsa hluhpi a thie ha ei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chavâta cha su moh cha Kibarôhâtavâ bipa a châ, chyhsa zohpazy cha liata pabupa ama châpa vâta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kibarôhâtavâ tawhta zawpizy cha Hazerô pangaipa ta sie ei ta, Hazerô liata y chy ei ta.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Miria nata Arawna ta Mawsi cha Kusi zuah lapinô ta a hneipa vâta reipachhie ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mawsi hnoh dei ta ma Abeipa ta bie a reih? Keimo hnohta chhao reih hra vei mâ?” tah ei ta. Cha cha Abeipa ta thei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawsi cha chyhsa nônai ngaitapa châ ta, alei chô liata chyhsa zydua hry liata nônai chaipa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abeipa ta Mawsi nata Arawna nata Miria zy cha bie thlai a chho ta, ama hnohta, “Nama pathôh ta vaw pua u la, ahmaohna poh o lâ a vy teh u,” tah ta. Ama pathôh ta vaw pua ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa cha ameih tôh liata za chô ta, poh o chhikao liata a vaw duah ta, Arawna nata Miria cha aw ta, ama pano ta hmia lâ vaw pua ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abeipa ta, “Ei bie nathlie teh u: Nama hry liata hrohsopa a y khiahta cha, kei, Abeipa ta aluahna ta a hnohta a pahnosa na ta, mâ lâta bie ei chho tyh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nâ chakaotuhpa Mawsi deikua cha, cha hawhta châ vei. Ano cha ei o liata ngâchhihpa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ano cha pakah ta bie a chho na ta, bie nyupa y leipa ta, a siapa ta bie ei chho tyh. Abeipa pizie chhao a hmô. Cha hawhta a châ tlôh khiahta cha, khazia nâ chakaotuhpa Mawsi reipachhiepa cha nama chi vei?” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chavâta Abeipa cha ama chô liata a pathi ia ta, a sie haw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Poh o chô tawhta meihdo â pasie nahta, pachâ tua u, Miria cha vaw phawh ta, dâhaw hawhta a vaw râh haw. Arawna ta Miria cha moh ta, phawhpa vaw châ thlâh ha ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arawna ta Mawsi hnohta, “Hy ei zibeipa, eima moleina vâta rie miah hrie khah y, hru ngaitapa ta tao pi ta, eima vaw molei haw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miria he thiruapa ta a pihpa hawsaih, a nô chhi tawhta a vaw pua nota a sapa khophie a y khao leipa hawhta rie châ khah sy,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mawsi ta Abeipa awsao ta, “Hy Khazohpa, Miria he ngiachhiepa ta patlâh mah y, ngiachhiepa ta,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abeipa ta Mawsi hnohta, “A paw ta a hmia liata a pachih pachhao sala, noh sari chhôh nozapa ta y aw vei ma? Riehmo khôtho lâ noh sari chhôh ânano ta khawhlôhpa ta y sala, cha khai tawhta a vaw ngiakhei heihpa châ mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chatanachata Miria cha noh sari chhôh khôtho liata khawhlôhpa châ ta, Miria a vaw ngiakhei heihpa a châ hlâlei cha, zawpi chhao a pasie veih ei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha khai tawhta zawpizy cha Hazerô tawhta pua ei ta, Pârâ râhchawhpa liata riehmo paryh ei ta.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy ei piepa Kâna râh mohparu awpa ta chyhsa tuah teh. Ama pathlatuhpa chizy tawhta chyhsa pakha chyu, ama hry liata chhituhpa pakha lymâ ta na tuah aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawsi ta, Abeipa bie piepa hawhta, âmo cha Pârâ râhchawhpa tawhta pasiesa ta. Ama zydua ta Izarei pathla chhituhpa ama châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hezy he ama moh a châ: Rubena chi tawhta Zaku sawchapawpa Samua;
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeôna chi tawhta Hôri sawchapawpa Saphâta;
  </para>
  <para style="p">
    <verse number="6" style="v" />Zudâh chi tawhta Zephune sawchapawpa Kâlebâ,
  </para>
  <para style="p">
    <verse number="7" style="v" />Iskâra chi tawhta Zawsi sawchapawpa Ikâ;
  </para>
  <para style="p">
    <verse number="8" style="v" />Epharai chi tawhta Nunâ sawchapawpa Hôsia;
  </para>
  <para style="p">
    <verse number="9" style="v" />Benzami chi tawhta Râphu sawchapawpa Pâti;
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebulawna chi tawhta Sôdi sawchapawpa Kâdie;
  </para>
  <para style="p">
    <verse number="11" style="v" />Zawsi pathla Manase chi tawhta Susi sawchapawpa Kâdi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Dânâ chi tawhta Kemâli sawchapawpa Amie;
  </para>
  <para style="p">
    <verse number="13" style="v" />Asera chi tawhta Mikaila sawchapawpa Sethu;
  </para>
  <para style="p">
    <verse number="14" style="v" />Nâthalai chi tawhta Vôphasi sawchapawpa Nâbi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Kâdâ chi tawhta Mâkhi sawchapawpa Keu.
  </para>
  <para style="p">
    <verse number="16" style="v" />Âmo cha râh mohparu awpa ta Mawsi ta a tuapazy ama châ. Nunâ sawchapawpa Hôsia cha Mawsi ta Zawsua tahpa ta a moh a bi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Âmo sahlao cha Mawsi ta Kâna râh mohparu awpa ta tuah ta, ama hnohta, “Chho lâ râh Neke lâta siepa ta, tlâh râh lâta kiah aw ei chi ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />râh cha kheihawhpa ma a châ tahpa zy, cha liata a pahrâpa chyhsazy cha thatlôpa ma, thatlô leipa ma ama châ tahpa zy, ama chyh ma ama hluh ma tahpa zy;
  </para>
  <para style="p">
    <verse number="19" style="v" />ama yna râh cha a pha ma, a chhie ma tahpa zy; kheihawhpa khihzy liata ma ama pahrâ, poh o khihzy ma, thokhy hneipa khihzy ma tahpa zy;
  </para>
  <para style="p">
    <verse number="20" style="v" />râh cha kôvei a pha ma, pha vei ma tahpa zy, a râh chhôh liata thozy a y ma, y vei ma tahpa zy nama kaw moh aw. Riahphapa ta y u la, cha râh liata theilâpazy za phaoh muh vy,” tah ta. Cha daihti cha Kre thei hmiatuapa hmoh daihti châ ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chatanachata pua ei ta, râh cha Zini râhchawhpa tawhta Lebô-hâmâ kiapâh ta Rehô taihta moh khai ei ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Neke lâta khy ei ta, Hebraw tlô ei ta, cha liata Anâki pathla Ahimâ mo, Sesai mo nata Tâmai mozy y ei ta. Hebraw cha Izi râh liata Zawâ â dua hlâta kô sari liata padua hapa a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chatawhcha Eskaw Saikao tlô ei ta, cha liata kre thei sao kha, a chiah duata chhawh ei ta, chyhsa pano ta alâ ta zâ sy ei ta. Pawmikarânâ nata theiku chhao za phaoh ei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Izarei sawzy ta cha liata kre sao ama chhawhpa vâta, cha su cha Eskaw Saikao bipa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Râh cha noh sypalih ama mohparu khai tawhta a zâ lie ei ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pârâ râhchawhpa Kâdesâ liata Mawsi nata Arawna nata Izarei zawpi zydua yna vaw tlô ei ta. Mawsi nata Arawna nata zawpi zydua hnohta bie vaw phaoh ei ta, a râh theilâpazy chhao pahmô ei ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mawsi hnohta, “Miah na tuana râh cha tlô pi ta, sâhpiti nata kheihti lona râh a vaw châ tlai. He he a râh liata theilâpa a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Râh liata phopi a pahrâpazy deikua cha, phopi thatlô ngaitapa châ ei ta, khihpizy chhao thokhy a hneipa, khih lai ngaitapazy a châ. Anâki pathlazy chhao, cha liata eima hmô.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amale mo chho lâ râh liata pahrâ ei ta, Hiti mo, Zebu mo nata Amawri mozy cha tlâh râh liata pahrâ ei ta, Kâna mo cha tilaipi kiah nata Zawdâh kao zy liata ama pahrâ,” tah ei ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kâlebâ ta zawpi cha Mawsi hmiakô liata chalihsa ta, “Khy para sih la, râh cha kaw la ei suh u, eima pahnie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Châhrasala a sielâhpazy ta “Cha phopi cha, keimo hlâta ama thatlô via ta, chavâta a kaw dyuh thei awpa châ ma pi,” tah ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Izarei sawzy hnohta râh ama kaw mohparupa kyh thâtih chhiepa za tlôkhei ei ta, zawpi hnohta, “Râh eima kaw mohparupa cha a chhôh liata a pahrâpazy a palâ khai hapa châ ta, a râh liata pahrâpa eima hmôpazy cha mo pahreihpazy ama châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cha liata Nephili mo pahreihpazy hmô pi ta, Anâki pathlazy cha Nephili tawhta a puapazy ama châ. Keimo cha khawsu hawh dei ta a hmô pi ta, âmo chhao ta khawsu hawh dei ta miah ama hmô hra,” tah ei ta.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cha zâ cha ahmaohpakhypa zydua ta ao paro ngaitapa ta awh ei ta, zawpizy cha aoh tlili ta ama cha.
  </para>
  <para style="p">
    <verse number="2" style="v" />Izarei saw zydua ta Mawsi nata Arawna chô liata paphôh ei ta, ama hnohta, “Izi râh liana kha vaw thi ha sih la a pha via awpa tlai, cha leipa chhao ta, he râhchawhpa liana heta thi sih la tlao a pha via aw!
  </para>
  <para style="p">
    <verse number="3" style="v" />Khazia ma zaozi ta thi awpa ta Abeipa ta he râh lâ he miah â chhi tly? Eima lapi sawzy he patupa ta y aw ei ta, Izi râh lâ kua awpa eima châta pha via vei ma?” tah ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chatanachata a chhohia ei ta, “Chhituhpa rao sih la, Izi râh lâ kua ha ei suh u,” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mawsi nata Arawna cha Izarei zawpi pôhpakhypa zydua hmiakô liana cha â khu lâta pao ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatawhcha râh mohparutuhpazy hry liata a hlao hrapa Nunâ sawchapawpa Zawsua nata Zephune sawchapawpa Kâlebâ cha ama chysia hrie ei ta,
  </para>
  <para style="p">
    <verse number="7" style="v" />Izarei zawpi zydua hnohta, “Mohparu awpa ta eima chahryhpa râh cha râh pha ngaitapa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Eima chô liata Abeipa â ly khiahta cha, cha râh lâ cha miah a chhi aw ta, miah a pie aw, sâhpiti nata kheihti lona râh cha.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abeipa chô liata a ty leipa u la, cha râh liata chyhsazy cha chi hra khah u, âmo cha eima châta viahchhâ hawh deita ama châ; amâ bohna cha âmo tawhta la hapa châ ta, Abeipa eima hnohta a y mâh tâh, âmo cha chi khah u,” tah ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Châhrasala zawpi pôhpakhypazy chata Zawsua nata Kâlebâ cha alô ta vaw awpa ta pahrua ei ta. Abeipa rônahna cha Izarei saw zydua hnohta ahmaohna poh o liata a zâ luah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abeipa ta Mawsi hnohta, “He chyhsazy heta khachâ ma eina mohnao aw ei? Ama hry liata ngiana hmonoâhpazy ei taona chôta khachâ ma na ngâ leipa ta ama y aw?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hri ta hrie aw ei na ta, ei pamua aw ei; chatanachata nâma liana heta âmo hlâta rônah viapa nata thatlô viapa phopi ei padua aw,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Châhrasala Mawsi ta Abeipa hnohta, “Cha kyh cha Izi mo ta ama pahno pathlei aw, he zawpizy he ama hry tawhta na hmotaotheina ta nâ chhi papuapazy châ tlôh ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Izi mo ta he râh liata a pahrâpazy he chho aw ei ta, pha aw vei. He râh liata a pahrâpazy heta nâ Abeipa cha Izarei sawzy hry liata na y tahpa pahno tlôh ei ta. Nâ, Abeipa cha hmiachhypa ta cha hmô ha ei ta, na meihdo cha Izarei sawzy chô liata a duah ta, nohchhô ta meihdo tôh ta, zâ ta mei tôh ta ama hmia lâta na sie tyhpa chhao ama pahno.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chavâta he zawpizy he chyhsa pakha thiepa hawhta na thie khai thlâh ha khiahta cha, na moh pathâhpa a theipa phopizy ta,
  </para>
  <para style="p">
    <verse number="16" style="v" />‘ Abeipa ta he zawpizy he ama hnohta pie awpa ta bie â taihpa râh lâ a tlôkhei thei leipa vâ ei ta, râhchawhpa liata a thie ha ei,’ ama tah pathlei aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chavâta tahmâ he Abeipa hmotaotheina cha rônahpa ta y mawh sy, nâma tlai ta,
  </para>
  <para style="p">
    <verse number="18" style="v" />‘ Abeipa cha hiehâhna kyh liata nainôsôpa châ ta, kyhpachâna hnei hluh ngaita ta, moleina nata hmoparaonazy a ngiahthai theipa a châ. Thailei a châpazy deikua cha, hrie leipa ta y beih vei. Pawzy hmoparaona ty sawzy chô liata patlôsa ta, chhâ thôhna nata chhâ palihna taihta a patlôsapa a châ,’ tahpa ta vaw reih ha chi ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na kyhpachâna rônah ngaitapa vâta, he chyhsazy hmoparaona he ngiachhiepa ta a ngiahthai la, Izi râh tawhta tahmâ taihta nâ ngiahthai lymâpa hawhta, he chyhsazy hmoparaona he a ngiahthai mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abeipa ta, “Na bie hawhta ei ngiahthai ei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Châhrasala ei hrona reipa ta ei reih; leilô zydua he Abeipa rônahna ta a bie aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izi râh nata râhchawhpa liata ei rônahna nata ei hmonoâhpa taopazy hmô ha ei ta, chatana chôta ei bie a zyh leipa chyhsa zydua heta, ei hrawh tlai na pasia ei ta, ei ao nathlie veih ei.
  </para>
  <para style="p">
    <verse number="23" style="v" />Âmo pathlatuhpazy hnohta bie ei taihpa râh cha hmô aw veih ei; nâ mohnaopazy chhao hmô hra aw veih ei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nâ chakaotuhpa Kâlebâ deikua he cha palôh nanopa phaoh ta, tlokhuh ta eina pazipa vâta, ano he cha a pangaipa râh tlôkhei aw na ta, a pathlazy ta râh cha ama hnei aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amale mo nata Kâna mozy saikao byzy liata pahrâ tlôh ei ta, chavâta nâmo cha mylâ a lie u la, Tilaipi Saihpa lâpi lâ tawhta râhchawhpa lâ a ngia teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abeipa ta Mawsi nata Arawna hnohta,
  </para>
  <para style="p">
    <verse number="27" style="v" />“He zawpi moleipa, ei chô liata a paphôh ngâ thlâh hapazy he, khachâ ma ei chhyh thai aw ei? Izarei sawzy paphôhna, ei chô liata ama paphôhnazy he ei thei haw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chavâta ama hnohta, ‘Ei hrona reipa ta ei reih, ei nah theina liata nama reipa hawh tlai ta, kei chhao ta nama chô liata ei tao hra aw:
  </para>
  <para style="p">
    <verse number="29" style="v" />he râhchawhpa liana he nama rizy pao aw ta, maluhpi nama reina liata kô kih tawhta chô lâ chyhsa, ei chô liata a paphôhpa zydua nama pao khai aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bâh pazawhpa tlai ta nama pahrâ nawpa tao awpa ta bie ei châ taihpa ei râh cha, Zephune sawchapawpa Kâlebâ nata Nunâ sawchapawpa Zawsua tah leipa ta cha ahy hmah a ngia aw veih ei chi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anodeikuacha patupa ta ama y aw nama tahpa nama sawzy he a chhi aw ei na ta, âmo heta nama dythapa râh cha ama pahrâ aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nâmo deikua cha he râhchawhpa liana heta nama rizy a pao aw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nama sawzy cha kô sypalih râhchawhpa liata viavi aw ei ta, nâmo ngâchhih leina vâta pasa ama tao aw, râhchawhpa liata nama rizy a pao khaina taih ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Râh nama mohparuna noh ziepa noh sypalih kha, noh kha vyuhpa ta kô kha lymâ ta, nama paraona vâta kô sypalih pasa nama tao aw; chatanachata ei ly leizie nama pahno aw.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kei Abeipa heta ei reih: he zawpi moleipa, keima nâ dyuh awpa ta a hmaohpakhypazy chô liana heta, he hmo he tao tlai aw na ta, he râhchawhpa liana heta leidia aw ei ta, he liata ama thi aw,’ tahpa ta chho teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chatanachata râh mohparu awpa ta Mawsi ta a tuapazy a zâ lie ei ta, râh thâtih a chhiena lâta a reihpa, Mawsi chô liata Zawpi a paphôhsatuhpa,
  </para>
  <para style="p">
    <verse number="37" style="v" />râh thâtih a chhiena lâta a vaw tlôkheituhpazy chô liata potlana tlô ta, Abeipa hmiakô liata thi khai ha ei ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Râh mohparu awpa ta a siepazy hry liata Nunâ sawchapawpa Zawsua nata Zephune sawchapawpa Kâlebâ deikua cha pahlôhpa ama châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mawsi ta cha biezy cha Izarei saw zydua chho ta, zawpizy cha pachârôhpa ta mâchhiesa ei ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chatanachata mydi ta thyu ei ta, tlâh laki lâ khy ei ta, Mawsi hnohta, “Moh teh, eimâ khy hih, Abeipa ta bie miah â taihpa su lâ cha eima khy aw, eima vaw molei haw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mawsi ta, “Khazia Abeipa biepiepa nama parao, nama hlaotloh khao aw vei.
  </para>
  <para style="p">
    <verse number="42" style="v" />Khy hlei khah u, nama hry liata Abeipa y khao tlôh leipa ta, nama chariahzy ta ama cha thie khai pathlei aw.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nama hmia liata Amale mo nata Kâna mozy y ei ta, zaozi ta nama pao aw; Abeipa nama tleisai hapa vâta, nama hnohta Abeipa y khao aw vei,” tah ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />Châhrasala Abeipa Biehrai Byh nata Mawsi cha riehmo tawhta ama pua leipa chhao ta, tlâh râh lâ cha khy raruah a chhuah ei ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Chatanachata tlâh râh liata a pahrâpa Amale mo nata Kâna mozy cha a zu ei ta, âmo cha thie ei ta, Hômâ tlâh taihta a chadai ei ta.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy chho la, ama hnohta hetana heta reih teh: Nama pahrâ nawpa râh ei cha piepa ei tlô aw ei chi ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa châta ropahâhpa tao nawpa ta, Abeipa lâta mei ta hmohlâpa raopa hlâna tlyma, bietai patlô nawpa ta atheihna tlyma, lôhthai hmohlâpa tlyma, nama châta kyhchhi raopazy liata hmohlâpa tlyma nama hlâ tita, viahchao hri tawhta tlyma, mietaku zaw tawhta tlyma nama hlâ awpa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abeipa lâta hmohlâpa a cheihpa maihta, niepa hlâna hlâ aw ta, cha cha viahdie dipa kachu su hrawh su kha nata sathaw chhiehraôh ôh kha pahlaopa a châ aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Raopa hlâta ta tlyma, atheihna châta tlyma hlâ awpa mietakutaw pô kha liata, dopa hlâna châta kresawhti ôh kha lymâ na hlâ awpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mietaku tôhpa pô kha hlâ awpa liata niepa hlâna châta na hlâ awpa cha, viahdie dipa kachu su hrawh su no nata sathaw chhiehraôh ôh kha nata khophie pahlaopa a châ aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dopa hlâna châta kresawhti chhiehraôh ôh kha nata khophie na hlâ aw. Cha cha Abeipa châta ropahâhpa a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Raopa hlâna châta tlyma, bietai patlô nawpa ta atheihna châta tlyma, aryhna hlâna châta tlyma, Abeipa lâta viahchao tôhpa na hlâ khiahta cha,
  </para>
  <para style="p">
    <verse number="9" style="v" />viahchao tôhpa na hlâ nona chata, viahdie dipa kachu su hrawh su thôh nata sathaw ôh no pahlaopa niepa hlâna na hlâ pâ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dopa hlâna châta kresawhti chhiehraôh ôh no na hlâ aw. Cha cha mei ta hmohlâpa châ ta, Abeipa châta ropahâhpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Cha hawhna chata viahchao tôhpa, mietaku tôhpa, mietakutaw nata mietaw zy hlâna maihta tao awpa a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sahroh nama hlâ awpa nata aziepa reipatipa ta, nama hlâ awpa ta â chakaihpa niepa hlâna nata dopa hlânazy nama hlâ khai aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Izarei râh liata a pihpa zydua ta, cha hawhna chata mei ta hmohlâpa ama hlâ awpa a châ. Cha cha Abeipa châta ropahâhpa a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chihropa chyhsa nama hnohta a pahrâpa tlyma, chhâ hluhpi nama hnohta a ypazy tlyma ta, Abeipa châta ropahâhpa, mei ta hmohlâpa a hlâ khoh khiahta cha, nâmo taozie hawhta a tao hra awpa a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nâmo nata nama hnohta chihropa a pahrâpazy ta bieraopa miakha a hly aw ei chi ta, cha cha chhâ vaw y lymâ awpa châta chhâzaw bieraopa a châ aw. Abeipa hmiakô liata cha, nâmo nata chihropazy namâ lyu khai aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nâmo nata nama hnohta chihropa a pahrâpazy ta ryhpa miakha nata bieraopa miakha namâ hly aw,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Izarei sawzy chho la, ama hnohta hetana heta reih teh: Ei cha siekheina râh kei tlô aw ei chi ta,
  </para>
  <para style="p">
    <verse number="19" style="v" />cha râh viahchhâ nama nie tita, Abeipa tovyuh tao aw ei chi ta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Viahchhâ nama nyh tua chaipa tawhta tlâ kha panano aw ei chi ta, chaluahpa hlâna ta nama hlâ aw. Sawhri liatapa chaluahpa hlâna ta nama hlâ tyhpa hawhta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nama chhâ zydua liata, viahchhâ nama nyh tua chaipa tawhta Abeipa tovyuh nama pie lymâ awpa a châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Châhrasala molei pathleina vâta, Abeipa ta Mawsi hnohta a reipa biepiepazy zyh leipa ta,
  </para>
  <para style="p">
    <verse number="23" style="v" />Mawsi hmâpa ta Abeipa ta bie a cha piepazy ei cha, bie a cha pie noh tawh ei ta nama chhâ vaw y lymâ awpa zydua liata,
  </para>
  <para style="p">
    <verse number="24" style="v" />tao pathleipa châ sala, zawpi pahno leipa a châ khiahta cha, viahchao hri hry tawhta viahchao tôh dawpa pô kha raopa hlâna châta zawpi ta ama hlâ aw. Cha cha Abeipa châta ropahâhpa a châ. Â chakaihpa niepa hlâna nata dopa hlâna chhao taozietyhpa hawhta hlâ aw ei ta, moleina hlâna châta mie tôhpa pô kha ama hlâ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chatawhcha theihthaipa ta Izarei zawpi zydua châta chatlaina tao aw ta, tao pathleipa châ ta, ama tao pathleipa châta Abeipa lâta mei ta hmohlâpa hlâ ei ta, Abeipa hmiakô liata moleina hlâna ama hlâ hapa vâta, a ngiahthaipa ama châ aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Izarei zawpi zydua nata ama hry liata chihropa a pahrâpazy chhao, zawpi tao pathleina liata amâ hlao khaipa vâta, ngiahthaipa ama châ aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Chyhsa ta pahno leipa ta hmo a parao khiahta cha, moleina hlâna châta mie chanôpa kô khapa pô kha a hlâ aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pahno leina vâta a molei pathleipa châna chata, theihthaipa ta Abeipa hmiakô liata chatlaina taopa aw ta, a ngiahthaipa a châ aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pahno leina vâta moleina kyh liata, a râh chyhsa Izarei sawzy nata chihropa ama hry liata a pahrâpazy châta ryhpa miakha a hly awpa a châ.
  </para>
  <para style="p">
    <verse number="30" style="v" />Moleina a châ tahpa pahno thlâh hana chôta a molei raruahpa deikua cha, a râh chyhsa a châpa chhao ta, chihropa a châpa chhao ta, Abeipa a reipachhiepa châ ta, cha chyhsa cha a phopi tawhta chhawh pathlahpa a châ aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Abeipa bie khâpasaw ta reih leipa ta, a biepiepa a paraopa vâta, cha chyhsa cha chhawh pathlahpa châ aw ta, a paraona maoh a phaoh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Izarei sawzy râhchawhpa liata ama y nota, chyhsa pakha cha Pahânoh ta tho a pakhypa hmô ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tho a pakhypa a hmôtuhpazy ta ano cha Mawsi nata Arawna nata zawpizy lâ a vaw chhi ei ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />A chô liata kheihta tao awpa ma tahpa pachiapa a châ mâh leipa vâta patâhna o liata khô chy ei ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abeipa ta Mawsi hnohta, “Cha chyhsa cha thie awpa a châ. Zawpi zydua ta riehmo khôtho liata alô ta ama vawhsao awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Abeipa ta Mawsi bie a piepa hawhta, zawpi zydua ta ano cha riehmo khôtho lâ a chhi ei ta, alô ta ama vawhsao haw.
  </para>
  <para style="p">
    <verse number="37" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="38" style="v" />“Izarei sawzy chho la, ama hnohta hetana heta reih teh: Ama chhâ vaw y lymâ awpa zydua liata, ama chysia paizy pangiasana ama tao awpa châ ta, chysia pai ki to liata pala ri nohpa ama pataoh khai awpa a châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chysia pai pangiasana cha moh tyh aw ei chi ta, Abeipa biepiepa zydua a theipa ta nama zyh lymâ nawpa châta châ aw ta, chatanachata nama palôh nata nama mo ta a khopa lâ sie leipa aw ei chi ta, nama sihryh tyhna lâ tlei leipa ta nama y thei aw.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ei biepiepa zydua a theipa ta zyh aw ei chi ta, nama Khazohpa châta pathaihpa nama châ aw.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kei he Abeipa nama Khazohpa, nama Khazohpa châ awpa ta Izi râh tawhta châ chhi papuatuhpa ei châ. Kei he Abeipa nama Khazohpa ei châ,” tah ta.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kôrâ, Dâthâ, Abirâ nata Ôni zy ta py tao ei ta. Kôrâ cha Izah sawchapawpa châ ta, Izah cha Kôhâ sawchapawpa châ ta, Kôhâ cha Livai sawchapawpa a châ. Dâthâ nata Abirâ cha Rubena pathla hry liata Eliabâ sawchapawzy châ ei ta, Ôni chhao Rubena pathla hry liata Pele sawchapawpa a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Âmo chata Mawsi a dyuh ei ta. Ama py liata Izarei sawzy hry liata zawpi chhituhpa nata ryureituhpa châta a tlyhpa chyhsa moh phapa 250 amâ hlao.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawsi nata Arawna chakhia awpa ta a awpakhy ei ta, ama hnohta, “Nama tah tu ha bâ! Zawpi pôhpakhypa sahlao he pathaih ei ta, ama zydua ta ama pathaih khai. Abeipa chhao ama hry liata a y. Khazia Abeipa chyhsa pôhpakhypa hlâta chônô viapa ta namâ tao?” tah ei ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cha cha Mawsi ta a thei nahta, â khu lâta pao ta,
  </para>
  <para style="p">
    <verse number="5" style="v" />Kôrâ nata a sahlaozy hnohta, “Mylâ my ta Abeipa ta ahy ma ano eih a châ tahpa a pasia aw. Ahy ma a pathaih tahpa pasia aw ta, a pathaihpa ta ano a hnia thei aw ta, Abeipa ta â tlyhpa tlai chata Abeipa cha â hnia thei aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hetana nama tao aw: Nâmo, Kôrâ nata a sahlao zydua ta ropahâhpa raona biebuh a chei aw ei chi ta,
  </para>
  <para style="p">
    <verse number="7" style="v" />cha liata mylâ Abeipa hmiakô liata mei soh aw ei chi ta, mei chô liata ropahâhpa nama soh aw. Abeipa ta â tlyhpa cha pathaihpa a châ aw. Nâmo, Livai pathlazy saih u, nama tah tu ha bâ!” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mawsi ta Kôrâ hnohta, “Nâmo, Livai pathlazy saih u, nathlie teh u:
  </para>
  <para style="p">
    <verse number="9" style="v" />Izarei Khazohpa ta nâmo cha Izarei zawpi hry tawhta cha panano ei ta, ano a hnia awpa ta a cha rao ei. Abeipa achhyna byureih liata chakao ta, zawpi hmiakô liata a duah ta zawpi chakao awpa ta a châ tlyhpa ei he, hmo chyhpa ta ma nama pachâ?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nâ nata na unawh Livai pathla zydua cha ano kiapâh liata y awpa ta a cha rao ei. Khazia theihthaipa châ awpa taihta namâ chhuhrao?
  </para>
  <para style="p">
    <verse number="11" style="v" />Nâ nata na sahlao zydua Abeipa a dyuh awpa ta namâ hmaohpakhypa a châ hih. Arawna cha khâpa hmo ma tao ta, a chô liata nama paphôh?” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chatawhcha Mawsi ta Eliabâ sawchapawpa Dâthâ nata Abirâ cha paawsa ta, âmo ta, “A khy aw ma pi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Râhchawhpa liata miah thie awpa ta, sâhpiti nata kheihti lona râh tawhta miah na kaw puakheipa he hmo chyhpa ma a châ? Tahmâ eima chô liata bei ta nâ tao heih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cha dei châ vei, sâhpiti nata kheihti lona râh lâ miah tlôkhei leipa chi ta, lyuzy nata kre sadôzy eima ryuto châta miah pie hra va chi. He chyhsazy he ama mo taihta thaoh awpa ma nâ chhuah? A khy aw ma pi,” tah ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawsi cha a hiehâh ngaita ta, Abeipa hnohta, “Ama hmohlâpa a pyh khah y. Âmo tawhta alâ pô kha hmah la leipa na ta, ama hry liata pakha hmah pasasa beih va na,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mawsi ta Kôrâ hnohta, “Mylâ nâ nata na sahlao zydua, nâ chhao, âmo chhao, Arawna chhao, Abeipa hmiakô liata namâ luah awpa a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ama ropahâhpa raona biebuh chaba chyu ei sala, a chhôh liata ropahâhpa soh ei sala, Abeipa hmiakô liata vaw cheih mawh ei sy. Ropahâhpa raona biebuh cha a zydua ta 250 châ aw ta, nâ chhao, Arawna chhao, chyhsa to ama ropahâhpa raona biebuh amâ chei chyu aw,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chatanachata chyhsa to ama ropahâhpa raona biebuh a chei chyu ei ta, a chhôh liata mei soh ei ta, mei chô liata ropahâhpa soh ei ta, Mawsi nata Arawna hnohta ahmaohna poh o chhikao liata a kei duah ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kôrâ ta zawpi zydua cha Mawsi nata Arawna chakhia awpa ta ahmaohna poh o chhikao liata pahmaoh ta. Zawpi zydua hnohta Abeipa rônahna a vaw luah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abeipa ta Mawsi nata Arawna hnohta,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Kha zawpi hry tawhna khata a panano teh u, âmo kha thlai ei pahleipadia aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mawsi nata Arawna cha â khu lâta pao ei ta, “Hy Khazohpa, sapa zydua thlahpa Khazohpa y, chyhsa pakha moleipa vâta zawpi zydua chô liata na pathi a ia aw mâ?” tah ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Zawpizy kha Kôrâ, Dâthâ nata Abirâ zy riehmo a hneisai khai ha awpa ta chho teh,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mawsi cha thyu ta, Dâthâ nata Abirâ yna lâ vawh ta, Izarei machâzy ta ano cha zi ei ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zawpi hnohta, “He chyhsa moleipazy poh o tawhna heta pua teh u. Ama hneipa chhao khâpa hmah hria khuh vy. Chataleipatala ama moleina zydua vâta pahleipadiapa nama châ pathlei aw,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chatanachata Kôrâ, Dâthâ nata Abirâ zy pahrâna su tawhta pua ei ta. Dâthâ nata Abirâ cha kaw pua ei ta, ama lapinôzy, ama sawchapawzy, ama hawtizy chhaota ama poh o chhikao liata a duah ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mawsi ta, “He liana heta Abeipa ta he raizy he hria awpa ta eina tuah tahpa pahno aw ei chi ta, keima kho ta ei taopa a châ leizie nama pahno aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />He chyhsazy he pihthi ta thi ei sala, chyhsa to chô liata a tlô tyhpa hawhta ama chô liata a vaw tlô khiahta cha, kei he Khazohpa ta eina tuah leipa a châ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Abeipa ta hmo thiehpa taopa ta, alei ta a pakah âpa ta, âmo nata ama hneipa zydua palâ khaipa ta, a hrohpa ta Athihkhih lâ amâ ngia khiahta deikua cha, he chyhsazy heta Abeipa ama mohnao tahpa nama pahno aw,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cha bie zydua cha Mawsi ta a rei khaipata nahta, ama ry liata chhaohlei a vaw patlaw ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Alei ta a pakah vaw â ta, ama ozy nata Kôrâ chyhsa zydua nata ama hneipa zydua a palâ khai haw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Âmo nata ama hneipa zydua ahrohpa ta Athihkhih lâ a ngia ei ta, alei ta âmo cha a pabieh khâh ta, zawpi hry tawhta ama leidia haw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ama awhsâhpa pyu vâta, ama chheipâh liata Izarei saw zydua cha, “Alei ta miah a palâ pathlei aw,” tah ei ta, amâ râpai khai haw.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chatawhcha Abeipa tawhta mei vaw pua ta, ropahâhpa a hlâ haipa chyhsa 250 cha a kâsao khai ha ei.
  </para>
  <para style="p">
    <verse number="36" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="37" style="v" />“Ropahâhpa raona biebuhzy kha mei a kâ haipa tawhta la awpa ta, theihthaipa Arawna sawchapawpa Eliaza kha chho teh. Hmo pathaihpa vaw châ ha ei ta, chavâta a meiheizy kha hiezâh khai ha mah y.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ama hrona pahleina taihta a moleipa chyhsazy ropahâhpa raona biebuh châ ta, maisâh khuna châta a phiapa ta daihpa châ mawh sy. Abeipa hmiakô liata hlâ hapa a châpa vâta, pathaihpa ama vaw châ haw. Cha cha Izarei sawzy châta ngiana a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mei ta a kâsaopa sahlaozy ta ama vaw cheipa, ropahâhpa raona dawh biebuhzy cha Theihthaipa Eliaza ta la ta, maisâh khuna châta a phiapa ta padaisa ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Abeipa ta Mawsi hmâpa ta Eliaza hnohta a reipa hawhta, cha cha Izarei sawzy zikyurâna châta taopa a châ. Arawna pathla a châ leipa chyhsa ahy hmahta Abeipa hmiakô liata ropahâhpa rao awpa ta amâ hnia awpa châ vei. A tao raruahpa cha, Kôrâ nata a sahlaozy hawhta ama châ aw.
  </para>
  <para style="p">
    <verse number="41" style="v" />A mylâ ta, Izarei zawpi zydua ta Mawsi nata Arawna chô liata, “ Abeipa phopi chyhsazy nama thie” tahpa ta paphôh ei ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mawsi nata Arawna chakhiapa ta zawpi amâ hmaoh hai nota, ahmaohna poh o lâ a kei heih ei ta, meihdo ta ahmaohna poh o cha vaw khu ta, Abeipa rônahna a vaw luah ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mawsi nata Arawna cha ahmaohna poh o hmia lâ vawh ei ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Zawpizy he thlai ei pahleipadia aw ei. Chavâta ama hry tawhta a hnei teh u,” tah ta. Chatawhcha Mawsi nata Arawna cha â khu lâta pao ei ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mawsi ta Arawna hnohta, “Ropahâhpa raona na biebuh kha la la, a chô liata maisâh liata mei kha soh la, ropahâhpa mia la, zawpi lâ a râkhei para la, âmo châta chatlaina tao teh. Abeipa tawhta hiehâhna pua ha ta, potlana â thao haw,” tah ta.
  </para>
  <para style="p">
    <verse number="47" style="v" />Arawna ta Mawsi reipa hawhta, ropahâhpa raona biebuh cha la ta, ahmaohpakhypa sahlao lâ a râ ta, potlana cha zawpi hry liata vaw tlô hmâ ha ta. Ropahâhpa rao ta, zawpi châta chatlaina tao ta.
  </para>
  <para style="p">
    <verse number="48" style="v" />Athihpa nata ahrohpa likawh liata a kei duah ta, chatanachata potlana cha pai ha ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kôrâ vâta athipazy hleikhô ta, potlana vâta a thipa zydua cha 14,700 ama châ.
  </para>
  <para style="p">
    <verse number="50" style="v" />Potlana a pai tawhta, Arawna cha ahmaohna poh o chhikao liata Mawsi lâta kua heih ta.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy hetana heta chho teh: Izarei chi hrawh hleino chhituhpazy tawhta, chi kha tawhta chôchahrei miakha lymâ ta, chôchahrei mia hrawh hleino la aw chi ta, ama chôchahrei chyu liata ama moh na roh khai aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Livai chi chôchahrei liata Arawna moh na roh aw. Cha hawhna chata chi chhituhpazy châta chôchahrei miakha chyu a y aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chazy cha ahmaohna poh o liata eimâ hmô tyhna Biehrai Byh hmiakô liata na soh aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ei tlyhpa chyhsa chôchahrei cha a chhyh kaw thao aw ta, chatanachata Izarei sawzy paphôhna, na chô liata ama paphôhna cha ei padia aw,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha hawhna chata Mawsi ta Izarei sawzy cha chho ta. Ama chhituhpazy ta chôchahreizy a hnohta vaw pie ei ta, chhituhpa pakha ta chôchahrei miakha lymâ ta, ama chi yzie hawhta chôchahrei mia hrawh hleino pie ei ta. Arawna chôchahrei chhao ama chôchahreizy hry liata â hlao hra.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mawsi ta chôchahreizy cha Biehrai Byh poh o chhôh liata Abeipa hmiakô ta soh ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mylâ ta Mawsi cha Biehrai Byh poh o lâ vawh ta, Livai chi Arawna chôchahrei cha a chhyh kaw thao ta, a pawzy pabyuh ta, a pawzy pakaipa ta, kuasâh thei hmohpazy a patheipa hmô ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mawsi ta chôchahrei zydua cha Abeipa hmiakô tawhta Izarei sawzy lâ pua khei ta, moh ei ta, chyhsazy ta ama chôchahrei chyu a la ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa ta Mawsi hnohta, “Arawna chôchahrei kha Biehrai Byh hmiakô liata soh pathi teh. Chyhsa chakhia hmâhpa sawzy ama châ tahpa ngiana châta châ aw ta, chatanachata eina chakhiana ei cha padia aw chi ta, thi aw veih ei,” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cha hawh chata Mawsi ta tao ta, Abeipa ta bie a piepa hawh tlai ta a tao.
  </para>
  <para style="p">
    <verse number="12" style="v" />Izarei sawzy ta Mawsi hnohta, “Moh teh, eima leidia ha hih! Paraopa châ pi ta, eima zydua ta paraopa eima châ ha hih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahy rai Abeipa achhyna byureih a vaw hniapa maih ama thi lymâ aw he zaw! Eima zydua ta thi khai dâhdei khiah pi maw?” tah ei ta.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Arawna hnohta, “Nâ nata na sawchapawzy nata na paw chhôhkhazy ta supathaihpa liata paraona maoh phaoh aw ei chi ta, nâ nata na sawchapawzy ta nama theihthaina raihria kyh liata paraona maoh nama phaoh aw.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nama hnohta chakao awpa ta Livai chi, na paw chipathla nama unawhzy a vaw chhi aw ei chi ta, Biehrai Byh poh o hmiakô liata nama chakao nota ama cha bao tyh aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na raihria cha bao aw ei ta, poh o liata rai zydua ama hria aw. Supathaihpa hmobaoh nata maisâh deikua amâ hnia awpa châ vei. Chataleipatala âmo chhao, nâmo chhao, nama thi pathlei aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chakaona rai na hriana liata a hlao hra aw ei ta, ahmaohna poh o mohôhna rai ama hria aw. Poh o rai zydua âmo hria awpa châ ta, chihropazy ta ama châ hnia awpa châ vei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Izarei sawzy chô liata hiehâhna a y khao lei nawpa ta, nâmo ta supathaihpa nata maisâh liata maophaohna zydua cha nama chaba khai aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pachâ teh u, kei tlai ta nama unawhpa Livai pathlazy cha Izarei sawzy hry tawhta a tlyh ei na ta, ahmaohna poh o liata chakaona rai hria awpa ta, âmo cha Khazohpa lâta hmosaipiepa châta nama hnohta ei cha pie ei.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nâ nata na hnohta a ypa na sawchapawzy ta maisâh nata pohraipa chhôh liata theihthaina rai hria awpa zydua hria thei aw ei chi ta, nama chakao aw. Theihthaipa chakaona raihria cha, hmosaipiepa ta nama hnohta cha pie ei na ta, chihropa a vaw hniapa maih cha thie awpa ama châ,” tah ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abeipa ta Arawna hnohta, “Moh teh, Izarei sawzy ta chalopa hlâna ta kei lâta hmohlâpa pathaihpa ama hlâpa zydua nâ nata na sawchapawzy châta chhâzaw tovyuh ta ei cha pie ei.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mei ta rao leipa hmohlâpa pathaihpazy cha na tovyuh a châ aw. Ama hmohlâpa to na tovyuh châ aw ta, ama niepa hlânazy, ama moleina hlânazy nata ama thaileichâna hlânazy cha nâ nata na sawzy châta nama tovyuh hmo pathaihpa a châ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Su pathaih chaipa liata nie aw chi ta, chapaw zydua ta ama nie thei aw. Na châta hmo pathaihpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Hezy chhao na tovyuh a châ: Ama chalopa hlâna hmopiepa nata Izarei sawzy chaluahpa hlâna zydua cha, nâ nata na hnohta a ypa na sawchapawzy nata na sawchanôzy hnohta chhâzaw ta nama tovyuh châta ei cha pie ei. Na o liata chyhsa pathaihpa maihta ama nie thei aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abeipa lâta ama hlâpa sathaw pha chaipa, kresawhti pha chaipa, sâh pha chaipa nata thei hmiatua chaipazy ei cha pie.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ama râh liata a ypa zydua hry liata theilâpa a hmoh tua chaipa, Abeipa châta ama vaw cheipa cha, nâ eih châ aw ta, na o liata chyhsa pathaihpa zydua ta ama nie thei aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Izarei râh liata hmohlâpa zydua nâ eih a châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chhi a pahypa, chyhsapa chhao, sahroh chhao, Abeipa lâta ama hlâpa maih nâ eih a châ aw. Chyhsapa sawchapaw uhtheipa deikua chatlai aw chi ta, sahroh pathaih leipa a pataw tua chaipa chhao na chatlai aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chatlai awpazy cha thla kha a châ nahta, supathaihpa sekel reizie ta reipa ta, sekel tlaw pangawh ta na chatlai aw ei. Sekel tlaw kha cha kerâ miakih a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Viahchao a pataw tuapa, mietaku a pataw tuapa nata mie a pataw tuapazy deikua cha, pathaihpa ama châpa vâta na chatlai awpa châ vei. Ama thisaih maisâh liata thia aw chi ta, mei ta hmohlâpa châta ama thawzy mei ta na rao aw. Cha cha Abeipa châta ropahâhpa a châ aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chaluahpa hlâna palôh nata phei chachâh lâ cha na tovyuh a châpa hawhta, sa pathaihpa a pataw tuapa atheihna sazy chhao na tovyuh a châ aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Izarei sawzy ta chalopa hlâna ta Abeipa lâta ama hlâpa hmo pathaihpa zydua cha, nâ nata na sawchapawzy nata na sawchanôzy hnohta chhâzaw ta nama tovyuh châta ei cha pie ei. Cha cha nâ nata na hnohta a ypa na sawchapawzy nata na sawchanôzy châta, Abeipa hmiakô liata chhâzaw alôh biehrai a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abeipa ta Arawna hnohta, “Ama râh liata ryuto hnei leipa aw chi ta, ama hry liata tovyuh hnei hra aw va chi. Izarei sawzy hry ta na tovyuh nata na ryuto cha kei he ei châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahmaohna poh o liata chakaona rai ama hriana lymâ châta, Izarei râh liata su hrawh su kha zydua Livai chizy hnohta ama ryuto châta ei pie ei.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tahmâ tawhta cha, Izarei sawzy ta ahmaohna poh o amâ hnia awpa châ khao vei. Chataleipatala ama moleina ty phaohpa ta ama thi pathlei aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahmaohna poh o chakaona rai cha, Livai pathlazy ta hria aw ei ta, ama paraona maoh âmo ta ama phaoh aw. He he nama chhâ zydua châta bieraopa a châ aw: Livai pathlazy cha Izarei sawzy hry liata ryuto hnei aw veih ei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Izarei sawzy ta su hrawh su kha Abeipa lâta chalopa hlâna ta ama hlâpa cha, Livai pathlazy hnohta ama ryuto châta ei pie. Chavâta ama hnohta ‘Izarei sawzy hry liata ryuto hnei aw veih ei’ ei tahpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Cha dei châ leipa ta, Livai pathlazy chho la, ama hnohta, ‘Nama ryuto châta Izarei sawzy su hrawh su kha ei cha piepa ei âmo tawhta nama dao tita, cha su hrawh su khapa tawhta su hrawh su kha Abeipa lâ nama hlâ pachhuah heih awpa a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cha hmohlâpa cha, sawhri liata sâh nata kresawhti saohna tawhta kresawhti a puapa hawhta nama châta pachâpa a châ aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cha hawhna chata Izarei sawzy tawhta su hrawh su kha nama topa zydua tawhta Abeipa lâta nama pie pachhuah awpa châ ta, cha su hrawh su kha tawhta Abeipa tovyuh nama pananopa cha theihthaipa Arawna nama pie aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nama hnohta hmopiepa zydua tawhta a pha chaipa nata a pathaih chaipazy cha Abeipa tovyuh châta nama hlâ lymâ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chavâta Livai pathlazy hnohta hetana heta na tah aw: “Nama daopa tawhta a pha chaipa nama hlâ tita, cha cha Livai pathlazy châta sawhri liata kôvei phana ta pachâpa châ aw ta, kresawhti saohna liata kôvei phana ta pachâpa a châ aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cha cha ahmaohna poh o liata nama hriana lymâ châ ta, nâmo nata nama chhôhkhazy ta khataih su lia rai ta nama nie thei aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />A pha chaipa nama hlâ khiahta cha, su hrawh su kha kyh liata moleina maoh phaoh leipa aw ei chi ta, Izarei sawzy hmohlâpa pathaihpa papuapalei hra leipa aw ei chi ta, thi aw veih ei chi,” tah mah y,’” tah ta.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi nata Arawna hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“He he Abeipa biepiepa ryhpa bieraopazy a châ: Izarei sawzy hnohta viahchao zeinô saihpa, pihpasina hnei leipa, seina hnei leipa nata raopaky a kyh beih leipa nâ lâ a vaw chhi awpa ta chho teh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Viahchao zeinô cha theihthaipa Eliaza pie aw chi ta, riehmo khôtho lâ a chhipa châ aw ta, theihthaipa hmiakô liata thie awpa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Theihthaipa Eliaza ta a kudy ta a thisaih la aw ta, ahmaohna poh o hmia lâta ei sari a thia aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cha khai tawhta viahchao zeinô cha a mohmô liata rao awpa châ ta, a vo, a sapa, a thisaih nata a ie zy rao khai ha awpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Theihthaipa ta sidy tho, hisaw nata pala nohsaihpa la aw ta, viahchao zeinô raona mei liata a phôh aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Theihthaipa cha a chysiazy pasu aw ta, ti liata a ngai a si aw ta, cha khai tawhta riehmo lâ â di aw. Châhrasala theihthaipa cha zâlâ taih pathaih leipa a châ aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />A raotuhpa chhao ti ta a chysiazy pasu aw ta, ti liata a ngai a si aw ta, zâlâ taih pathaih leipa a châ hra aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chyhsa pathaihpa pakha ta viahchao zeinô raona paoh cha la aw ta, riehmo khôtho liata su sithaipa liata a soh aw. Cha cha Izarei zawpizy châta apathaina ti ta hmâ awpa ta paso awpa châ ta, moleina tawhta pathaisana châta a châ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Viahchao zeinô raona paoh a pakhytuhpa chhao a chysiazy pasu aw ta, zâlâ taih pathaih leipa a châ aw. Cha cha Izarei sawzy nata chihropa ama hnohta a pahrâpazy châta chhâzaw bieraopa a châ aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Athihpa ri a hriapa maih noh sari chhôh pathaih leipa a châ aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Noh thôhna noh nata noh sarina noh liata apathaina ti ta a pathai aw ta, chatanachata a pathaih aw. Noh thôhna noh nata a noh sarina noh liata â pathai vei khiahta deikua cha, pathaih aw vei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Athihpa ri a hriapa maih, kheihawhpa chyhsa ri rai châ sala, â pathai vei khiahta cha, Abeipa achhyna byureih a papuapaleipa châ ta, cha chyhsa cha Izarei tawhta chhawh pathlahpa a châ aw. Apathaina ti a chô liata thiapa a châ leipa vâta, pathaih leipa châ ta, a pathaih leina a chô liata a y thlâh ha chypa a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />“He he poh o liata athipa ama y tita ryhpa awpa a châ: Poh o liata a ngiapa nata poh o chhôh liata a ypa maih noh sari chhôh pathaih leipa ama châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hmobaoh a pahypa, a chhiehru ta chhiehruh leipa maih pathaih leipa a châ hra.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahy rai lyurâhpa liata zaozi ta thiepa tlyma, pihthi ta a thipa tlyma, chyhsa rupa tlyma, thlâ tlyma a hriapa maih cha, noh sari chhôh pathaih leipa a châ aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathaih leipa châna chata raopa hlâna meipaoh la aw ei ta, beih liata soh aw ei ta, chavah ti pathaihpa ama bao aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chyhsa pathaihpa ta hisaw la aw ta, ti liata ny aw ta, poh o nata hmobaoh zydua chô liata nata a chhôh liata a ypa chyhsazy chô liata a thia aw. Rupa tlyma, thiepa ri tlyma, athihpa ri tlyma, thlâ tlyma a hriapazy chô liata a thia hra aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chyhsa pathaihpa ta chyhsa pathaih leipa chô liata, apathaina ti cha noh thôhna noh nata noh sarina nohzy liata thia aw ta, noh sarina noh ta a pathaisa aw. A chysiazy pasu aw ta, ti liata a ngai a si aw ta, zâlâ ta a vaw pathaih ha aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Chyhsa pathaih leipa cha â pathai leipa khiahta cha, cha chyhsa cha Abeipa supathaihpa a papuapaleipa a châpa vâta, zawpi tawhta chhawh pathlahpa a châ aw. Apathaina ti ta thiapa a châ leipa vâta pathaih leipa a châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />He he ama châta chhâzaw bieraopa a châ aw: Apathaina ti a thiatuhpa maih a chysiazy pasu aw ta, apathaina ti a hriapa cha zâlâ taih pathaih leipa a châ aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chyhsa pathaih leipa ta hmo a hriapa maih pathaih leipa châ aw ta, cha hmo pathaih leipa a hriapa cha zâlâ taih pathaih leipa a châ aw,” tah ta.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izarei sawzy cha, thla khana liata ama zydua ta Zini râhchawhpa tlô ei ta. Zawpizy cha Kâdesâ liata y ei ta. Cha liata Miria thi ta, cha liata ama pabu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zawpi châta ti y leipa ta. Chavâta Mawsi nata Arawna chakhia awpa ta zawpi a hmaohpakhy ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zawpi ta Mawsi cha a hryuh ei ta, a hnohta, “ Abeipa hmiakô liata eima unawhzy ama thi nona khata, keimo chhao vaw thi ha hra sih la a pha via awpa tlai!
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazia Abeipa chyhsa zawpizy he, keimo nata eima sahrohzy chhaota thi khai awpa ta, he râhchawhpa lâ he miah nâ vaw chhi?
  </para>
  <para style="p">
    <verse number="5" style="v" />Khâpa vâta ma Izi râh tawhta miah kaw puakhei chi ta, he râh pha leipa lâ he miah nâ kaw chhi? Sâhzy, theikuzy, kre zôhzy, pawmikarânâzy y leina su châ ta, ti do awpa chhao y vei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawsi nata Arawna cha zawpi mohmô tawhta pua ei ta, ahmaohna poh o chhikao lâ vawh ei ta, cha liata â khu lâta pao ei ta. Abeipa rônahna ama hnohta a vaw luah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Chôchahrei la la, nâ nata na unawhpa Arawna ta zawpizy pahmaoh u la, ti papua awpa ta, ama mohmô liata lôpanô chho mah y. Lôpanô tawhta ti a puapa cha âmo lâ cheih aw chi ta, zawpi nata ama sahrohzy cha ti do awpa na pie aw ei,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abeipa ta bie a piepa hawhta, Mawsi ta chôchahrei cha Abeipa hmiakô tawhta la ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mawsi nata Arawna ta zawpizy cha lôpanô hmiakô liata pahmaoh ei ta. Mawsi ta ama hnohta, “Nâmo, chhorupa saih u, tahmâ nathlie teh u, he lôpanô tawhna heta ma ti eima cha thaipa aw?” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mawsi cha a ku hy ta, a chôchahrei ta lôpanô cha ei no tu ta. Ti thata vaw pua ta, zawpi nata ama sahrohzy ta ti cha doh ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Châhrasala Abeipa ta Mawsi nata Arawna hnohta, “Na ngâ leipa ei chi ta, ei pathaihna hawhta Izarei sawzy mohmô liata eina palyupalih leipa vâ ei chi ta, he zawpizy he âmo ei piepa râh tlôkhei aw veih ei chi,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha cha Meribâ tizy châ ta, cha liata Izarei sawzy ta Abeipa a hryuh ei ta, Abeipa ta ti hmâpa ta ama hry liata â palyupalihna su a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mawsi ta Kâdesâ tawhta Edômâ bei lâ lyuhchâpa tuah ta, “Na unawhpa Izarei ta hetana heta a tah: Eima chô liata rairuna a tlôpa zydua na pahno khai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miah pathlatuhpazy Izi râh lâ zu ei ta, Izi râh liata bohpi pahrâ pi ta, Izi mo ta keimo nata miah pathlatuhpazy miah ama taochhiezie kha na pahno.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa pado pi ta, ano ta eima ao thei ta, vâlyuhchâpa vaw tuah ta, Izi râh tawhta miah â chhi papua haw. Tahmâ he na râh kiah liata Kâdesâ khihpi liata eima y.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngiachhiepa ta na râh siepahlie awpa miah pasai mah y. Lyu tlyma, kre sadô tlyma, siepahlie leipa aw pi ta, tikhaoh tizy doh hra aw ma pi. Abei Lâlai liata sie aw pi ta, na râh eima khô hlâlei cha, chachâh lâ tlyma, chavei lâ tlyma tlei aw ma pi,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Châhrasala Edômâ ta a hnohta, “Ei râh na siepahlie awpa châ vei. Na siepahlie khiahta cha, zaozi chhaota vaw thyu aw na ta, ei châ dyuh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Izarei sawzy ta Edômâ hnohta, “Lâlai a chhih aw pi ta, keimo nata eima sahrohzy ta na ti eima doh khiahta cha, a mâ eima cha pie aw. Hmo hropa khâpa hmah tao aw ma pi. Phei ta siepahlie awpa rie miah pasaih mah y,” tah ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ano ta, “Siepahlie aw veih ei chi,” tah ta. Chatanachata Edômâ cha Izarei sawzy a dyuh awpa ta pheisaih thatlôpa hluhpi chhaota vaw pua ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Edômâ ta Izarei cha a râh siepahlie awpa a pasai leipa vâta, Izarei cha Edômâ tawhta a lie ha ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izarei sawzy cha, ama zydua ta Kâdesâ tawhta pua ei ta, Hôri Tlâh kei tlô ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abeipa ta Mawsi nata Arawna cha Edômâ râhri khô liata a ypa Hôri Tlâh liata bie a chho ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Arawna cha a chiheihzy hnohta pahlyhpa a châ aw. Meribâ tizy liata ei biepiepa namâ dyuhpa vâna khata, Izarei sawzy ei piepa râh liata a ngia aw vei.
  </para>
  <para style="p">
    <verse number="25" style="v" />Arawna nata a sawchapawpa Eliaza kha a chhi la, Hôri Tlâh lâ khykhei teh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Arawna chysiazy kha pahluh la, a sawchapawpa Eliaza paky mah y. Arawna cha a chiheihzy hnohta pahlyhpa châ aw ta, cha liata a thi aw,” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abeipa biepiepa hawhta Mawsi ta tao ta. Zawpi zydua mohmô ta Hôri Tlâh lâ cha khy ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mawsi ta Arawna chysiazy cha pahluh ta, a sawchapawpa Eliaza paky ta. Chatanachata Arawna cha tlâh laki liata thi ha ta. Mawsi nata Eliaza cha tlâh tawhta za chô ei ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Arawna a thi haw tahpa zawpi ta ama pahno nahta, Izarei pathla zydua ta noh sythôh mâchhiesa ei ta.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Neke liata a pahrâpa Kâna chyhsa Aradâ bei ta Izarei cha Athari lâpi lâ tawhta a vaw sie tahpa thei ta. Aradâ bei ta Izarei cha a dyuh ta, Izarei saw thokha sei ta patu ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chatawhcha Izarei ta Abeipa lâta bietai tao ta, “He phopi he ei ku liata eina pie khiah chi ta cha, ama khihpizy tlokhuh ei pahleipadia khai aw,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abeipa ta Izarei ao cha thei ta, Kâna mo cha a ku liata pie ta. Chatanachata a chyhsazy nata ama khihpizy cha tlokhuh ama pahleipadia khai haw. Chavâta cha su moh cha Hômâ bipa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izarei sawzy cha Hôri Tlâh tawhta pua ei ta, Edômâ râh chahrihpa ta Tilaipi Saihpa pangaina lâpi lâta chahlô ei ta. Zawpizy cha lâpi liata ama palôh chhâ kaw ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zawpizy ta Khazohpa nata Mawsi chakhiapa ta bie reih ei ta, “Khazia râhchawhpa liata thi awpa ta Izi râh tawhta miah namâ kaw chhi papua? Viahchhâ y va, ti chhao y va, he pati pasichhihpa he miah a ai tu ha bâ,” tah ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chatawhcha Abeipa ta zawpizy hry liata parih châmaih thatlôpazy tuah ta, chyhsazy pachu ei ta, Izarei chyhsa hluhpi thi ei ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zawpizy cha Mawsi lâ vawh ei ta, a hnohta, “ Abeipa nata nâma chakhiapa ta bie reih pi ta, eima vaw molei ha na. Abeipa lâ thlah miah chhâpa la, parihzy he keimo tawhta la awpa ta miah hiapa teh,” tah ei ta. Chatanachata Mawsi ta zawpizy châta thlahchhâ ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abeipa ta Mawsi hnohta, “Parih châmaih thatlôpa nothlahpa tao la, atôh liata chaluah mah y. Parih pachupa maihta cha cha ama mo khiahta cha, ama hroh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha hawhna chata Mawsi ta dawh parih tao ta, atôh liata chaluah ta. Parih pachupa maihta dawh parih cha ama moh nahta, hroh lymâ ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Izarei sawzy cha sie lymâ ei ta, Ôbô liata riehmo paryh ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ôbô tawhta sie heih ei ta, Môabâ dady râhchawhpa liata nochhi lâ chhâh ta a ypa Iziabari liata riehmo paryh ei ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha tawhna chata sie heih ei ta, Zere saikao liata yna su paryh ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cha tawhna chata sie heih ei ta, Anaw chavah haosâ lâta riehmo paryh ei ta. Anaw chavah cha Amawri mo râh saoh patluapa râhchawhpa liata a ypa a châ. Anaw chavah cha Môabâ râhri, Môabâ nata Amawri mo likawh râhri chavah a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chavâta Abeipa Adyuhnazy châbu liata, “Supha liata Vâhe nata Anaw saikaozy cha,
  </para>
  <para style="p">
    <verse number="15" style="v" />A saikao pâdawhzy ta Ari su tlô ta, Môabâ râhri taih a kawh,” tahpa ta reipa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cha su tawhta Be khihpi lâ sie ei ta. Be cha tikhaoh tahna châ ta, Abeipa ta Mawsi hnohta, “Zawpizy awpakhy la, ti ei pie aw ei,” a tahna su kha a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chavâta Izarei ta hetana heta hla a sa: “Hy tikhaoh, ti kaw pali mah y! Tikhaoh lâ hla sa teh u!
  </para>
  <para style="p">
    <verse number="18" style="v" />Ryureina chôchahrei nata sômasi hmâpa ta, Beizy chaopa tikhaoh lâ hla sa u la, Râh chhituhpazy reipa tikhaoh lâ hla sa teh u!” Izarei sawzy cha râhchawhpa tawhta Matânâ lâ sie ei ta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Matânâ tawhta Nâhalie lâta, Nâhalie tawhta Bamô lâta,
  </para>
  <para style="p">
    <verse number="20" style="v" />Bamô tawhta Môabâ lyu liata saikao nata râhchawhpa lâ a heihpa Piskâ tlâh laki lâ ama sie.
  </para>
  <para style="p">
    <verse number="21" style="v" />Izarei ta Amawri bei Sihaw lâ chyhsa tuah ta,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Na râh siepahlie eina pasai awpa chi ta ei châ haw. Lyu lâ tlyma kre sadô lâ tlyma tlei leipa aw pi ta, tikhaoh ti chhao doh hra aw ma pi. Na râh eima khô hlâlei Abei Lâlai liata eima sie aw,” tahpa ta kei pachhosa ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Châhrasala Sihaw ta a râh siepahlie awpa ta Izarei cha pasai leipa ta. A pheisaih zydua awpakhy ta, Izarei a dyuh awpa ta râhchawhpa lâ tlao pua ha ta. Zahâza kei tlô ta, cha liata Izarei cha a dyuh ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Izarei ta zaozi ta Sihaw cha thie ta, Sihaw râh cha Anaw tawhta Zabaw taih la ta, Amawna mo râhri tlôna taih la ta, Amawna mo râhri cha â ipa ta dôhpa châpa vâta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Izarei ta khihpi zydua la khai ta. Chatanachata Izarei cha Amawri mo khihpi zydua nata Hesbaw nata a khitaw zydua liata pahrâ ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hesbaw cha Amawri bei Sihaw khihpi châ ta, Sihaw cha Môabâ bei parohpa a dyuh ta, Anaw chavah taihta a râh zydua a latuhpa kha a châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chavâta hla phituhpazy ta, “Hesbaw lâ a vy teh u, A khihpi paduapathipa châ sala, Sihaw khihpi cha paduapa châ mawh sy.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hesbaw tawhta mei pua ta, Sihaw khihpi tawhta meipaleih a pua; Môabâ râh Ari khih kâ khai ta, Anaw su sâhpazy a palâ khai haw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hy Môabâ, na hu a po kaw dia! Hy Khemô phopi, paraopa na châ haw! A sawchapawzy viavipa ta tao ta, A sawchanôzy Amawri bei Sihaw hnohta sei ta a pie ei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chavâta âmo cha tlokhuh parao pi ta, Hesbaw nata Dibô zy leidia ei ta; Nôpha tawhta Medebâ taihta roryhrapa ta eima tao haw,” tahpa ta hla ama phi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chatanachata Izarei cha Amawri mo râh liata pahrâ ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mawsi ta Zaze mohparu awpa ta chyhsa tuah ta, a khihzy la ei ta, cha liata a ypa Amawri mo cha ama pho haw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chatawhcha a lie ei ta, Bâsanâ lâpi lâta khy ei ta. Bâsanâ bei Ôkâ cha Izarei sawzy Edarei liata a dyuh awpa ta ano nata a chyhsa zydua chhaota pua ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abeipa ta Mawsi hnohta, “Ano kha chi khah y, ano nata a chyhsa zydua nata a râh na ku liata ei cha pie haw. Hesbaw liata a ypa Amawri bei Sihaw chô liata na taopa hawhna khata ano chô liata chhao na tao aw,” tah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chatanachata Bâsanâ bei Ôkâ nata a sawchapawzy nata a chyhsa zydua cha, pakha hmah pahlôh leipa ta ama thie khai haw. A râh chhao ama hnei haw.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izarei sawzy cha sie lymâ ei ta, Zawdâh khô lâ Zerikô dady liata Môabâ bypizy liata riehmo paryh ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zipô sawchapawpa Bâlâka ta Amawri mo chô liata Izarei hmotaopa zydua pahno ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Môabâ ta Izarei sawzy cha, ama hluh ngaitapa vâta chi ngaita ta. Izarei sawzy vâta Môabâ cha nôpopa ta y ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Môabâ mo ta Midia machâzy hnohta, “He phopi heta, viahchao tôhpa ta sibiepa a bâpa hawhta, eima chheipâh liata chyhsa zydua ama bâ khai aw,” tah ei ta. Zipô sawchapawpa Bâlâka cha, cha daihti liata Môabâ bei châ ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bâlâka ta a pina râh Chavah kiah Pethô khih liata a ypa Beô sawchapawpa Bâlâma lâ chyhsa tuah ta, a hnohta, “Izi râh tawhta phopi miakha kaw pua ei ta, leilô zydua bie khai ei ta, tahmâ keima dady liata ama pahrâ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngiachhiepa ta a vy la, he chyhsazy he chhie na vaw sapa mah y. Kei châta ama tha a tlô tu haw. Chatanachata âmo cha pahnie thei aw ei na ta, he râh tawhta ei papua thei ngyu aw ei. Byhnâ na awpa maih byhnâ to ei ta, chhie na sapa maih chhiesapa ta ama y tyh tahpa ei pahno,” tah ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Môabâ machâzy nata Midia machâzy cha pachaona ty a cheipa ta pua ei ta. Bâlâma kô ama tlô nahta, Bâlâka bietapa cha chho ei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bâlâma ta ama hnohta, “Tazâ he liata a rie u la, Abeipa ta eina chhopa hawhta nama hnohta bie ei vaw tlôkhei aw,” tah ta. Chatanachata Môabâ beimachâzy cha Bâlâma hnohta a rie ei ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khazohpa cha Bâlâma lâ a vy ta, “Na hnohta a ypa chyhsazy kha ahyzy ma ama châ?” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bâlâma ta Khazohpa hnohta, “Zipô sawchapawpa Môabâ bei Bâlâka ta ei hnohta,
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Izi râh tawhta phopi miakha kaw pua ei ta, leilô zydua ama bie khai haw. Chavâta tahmâ a vy la, âmo cha chhie na sapa mah y. Chatanachata âmo cha a dyuh thei aw na ta, ei papua thei ngyu aw ei,’ tahpa ta chyhsa a vaw tuah,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khazohpa ta Bâlâma hnohta, “Ama hnohta na sie awpa châ leipa ta, cha phopi cha chhie na sapa awpa châ hra vei. Âmo cha byhnâ a topa ama châ,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bâlâma cha my ta thyu ta, Bâlâka beimachâzy hnohta, “Nama râh lâ a lie teh u. Nama hnohta ei sie awpa Abeipa ta pasaih vei,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Môabâ beimachâzy cha thyu ei ta, Bâlâka lâ a lie ei ta, a hnohta, “Bâlâma cha eima hnohta a vy khoh vei,” tah ei ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bâlâka ta beimachâ hluh via, âmo hlâta zachhih viapazy tuah heih ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bâlâma kô kei tlô ei ta, a hnohta, “Zipô sawchapawpa Bâlâka ta hetana heta a tah: ‘Kei lâ a vy awpa ta khâpa ta hmah cha pakhâ khah sy.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chyhsa rônah ngaitapa ta cha tao aw na ta, ei hnohta na reipa maih ei tao aw. Chavâta a vy tlai la, he phopi he chhie na sapa mah y,’ a tah,” tah ei ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Châhrasala Bâlâma ta Bâlâka chakaotuhpazy cha a chhy ta, ama hnohta, “Bâlâka ta tâkâ nata ngôh ta a biepa a o taihta eina piepa chhao ta, Abeipa ei Khazohpa bie khô lâ cha, hmo chyhpa tlyma, hmo laipa tlyma, khâpa hmah tao thei va na.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chavâta Abeipa ta ei hnohta bie a rei via awpa a y ma tahpa ei pahno thei nawpa ta, tazâ chhao, he liata a rie heih chy muh vy,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cha zâ liata, Khazohpa cha Bâlâma lâ a vy heih ta, a hnohta, “Chyhsazy cha nâma dy awpa ta a vypa ama châ khiahta cha, thyu la, ama hnohta sie mah y. Anodeikua ei cha chhopa deita na tao awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bâlâma cha mydi ta thyu ta, alâ ky padia ta, Môabâ beimachâzy hnohta sie ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Châhrasala a siepa vâta Khazohpa cha a pathi ia ta. Chavâta Bâlâma a dyuh awpa ta, Abeipa vâlyuhchâpa ta lâpi liata a vaw duakhâh ta. Bâlâma cha a alâ kiahpa ta sie ta, a chakaotuhpa pano a hnohta sie ei ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />Alâ ta Abeipa vâlyuhchâpa cha zaozi chabapa ta lâpi liata â duapa hmô ta. Chavâta alâ cha lâpi tleipa ta lyurâhpa lâ sie ta. Bâlâma ta alâ cha lâpi lâ pakuasa a chhuahpa ta chhei ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abeipa vâlyuhchâpa cha kre sadô diahpai nata diahpai likawh lâpi buahpa liata a vaw duah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Alâ ta Abeipa vâlyuhchâpa a hmô nahta, diahpai cha kei chatôh ta, Bâlâma phei cha diahpai liata charieh ta. Chavâta Bâlâma ta alâ cha chhei heih ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abeipa vâlyuhchâpa cha a khô via lâ vawh ta, su buahpa, chachâh lâ tlyma, chavei lâ tlyma, tleina y leina liata a vaw duah heih ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Alâ ta Abeipa vâlyuhchâpa a hmô nahta, Bâlâma cha a byukhei ha ta. Bâlâma cha a pathi ia ta, a chôchahrei ta alâ cha chhei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abeipa ta alâ pakah pahy ta, Bâlâma hnohta, “Na chô liata khâpa hmo tao na ta ma, ei thôh dua eina chhei chi?” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bâlâma ta alâ hnohta, “Eina pasipasawhpa vâ chi ta a châ. Zaozi a chaba chhochhi aw sah la, ei cha thie ha aw,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Alâ ta Bâlâma hnohta, “Kei he na hro chhôh zydua ta na kiah chi ta, tahmâ taihta na kiapa na alâ châ va na mâ? Kha hawhta ei cha tao beih ma?” tah ta. Ano ta, “Tao beih va chi,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Abeipa ta Bâlâma cha a mo pavâsa ta, zaozi chabapa ta lâpi liata a duahpa Abeipa vâlyuhchâpa cha hmô ta. A bôh ta, a hmia alei lâ a khupa ta pao ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abeipa vâlyuhchâpa ta Bâlâma hnohta, “Khazia na alâ kha ei thôh dua na chhei? Pachâ teh, na siena chhâpa kha ei hmiakô liata raona a châpa vâta, cha pakhâ awpa ta ei vaw pua.
  </para>
  <para style="p">
    <verse number="33" style="v" />Alâ ta cha na hmô ta, ei hmiakô liata ei thôh dua a tlei. Kei tawhta tlei vei mawh sala, ano pahlôh aw na ta, nâ ei cha thie ha bâ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bâlâma ta vâlyuhchâpa hnohta, “Ei vaw molei ha na. Na pakhâ awpa ta lâpi liata nâ vaw duah tahpa ei pahno leipa vâta a châ. Chavâta ei sie awpa he na hmiakô liata hmo pha leipa a châ khiahta cha, tahmâ he ei kua aw,” tah ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abeipa vâlyuhchâpa ta Bâlâma hnohta, “Chyhsazy hnohta sie mah y. Anodeikua ei cha chhopa bie deita na reih awpa a châ,” tah ta. Chatanachata Bâlâma cha Bâlâka beimachâzy hnohta sie ta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Bâlâka ta Bâlâma â vy tahpa a thei nahta, Anaw lâta ama râhri chhâna Môabâ khihpi taih kei dy ta.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bâlâka ta Bâlâma hnohta, “Hmo chatliepa a châpa vâta ei cha vaw padysapa a châ. Khazia nâ vy khoh vei? Lymâ châ pie thei lei awpa hawhta ma eina pachâ chi?” tah ta.
  </para>
  <para style="p">
    <verse number="38" style="v" />Bâlâma ta Bâlâka hnohta, “Moh teh, nâ lâ ei vy ha hih! Châhrasala keima kho ta bie to rei theina biehneina hnei va na. Khazohpa ta ei pakah liata a sopa bie deita ei rei awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chatanachata Bâlâma cha Bâlâka hnohta sie ta, Kiria-huzô khihpi tlô ei ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bâlâka ta viahchao tôhpa nata mietaku ta atheihna hlâ ta. Atheihna sa cha Bâlâma nata a hnohta a ypa beimachâzy paphao ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />A mylâ my ta Bâlâka ta Bâlâma cha a chhi ta, Bâlâ su sâhpazy lâ khykhei ta. Cha su tawhta Izarei zawpi yna su thokha cha hmô theipa châ ta.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bâlâma ta Bâlâka hnohta, “He liata maisâh miasari na taopa la, viahchao tôhpa pô sari nata mietaku tôhpa pô sari nâ chhuanohpa teh,” tah ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bâlâka ta Bâlâma reipa hawhta tao ta. Bâlâka nata Bâlâma ta maisâh to liata viahchao tôhpa pô kha nata mietaku tôhpa pô kha lymâ hlâ ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bâlâma ta Bâlâka hnohta, “Raopa hlâna na hlâpa kiapâh liata a vaw duah la, kei deikua cha ânano ta kei y na ta, Abeipa a vy aw ta, einâ vaw tyh ngyu aw. Eina pahmôsapa maih ei cha chho aw,” tah ta. Chatanachata tlâh laki lâ khy ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazohpa ta Bâlâma cha a vaw tyh ta. Bâlâma ta a hnohta, “Maisâh miasari tao na ta, maisâh to liata viahchao tôhpa pô kha nata mietaku tôhpa pô kha lymâ ei hlâ haw,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abeipa ta Bâlâma pakah liata bie soh ta, “Bâlâka lâ a lie la, hetana heta kei reih teh,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bâlâma cha Bâlâka lâ a lie ta. Bâlâka cha Môabâ beimachâ zydua chhaota raopa hlâna kiapâh liata a vaw duah thlâh ha ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bâlâma ta a bie daopa cha reih ta: “Aramia tawhta Bâlâka ta nâ vaw chhi ta, Nochhi tlâhpizy tawhta Môabâ bei ta einâ vaw chhi; ‘A vy la, Zakaw chhie na sapa teh, A vy la, Izarei thailei pachâsa teh!’ eina tah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khazohpa ta chhie a sapa leipa cha, Kheihta chhiesapa thei aw na ta; Khazohpa ta thailei a pachâsa leipa cha, Kheihta thailei ei pachâsa thei aw?
  </para>
  <para style="p">
    <verse number="9" style="v" />Lôkâhpa khi tawhta Izarei cha hmô na ta, Tlâh laki tawhta ano cha ei sai; Moh tua, ano dei ta a ypa phopi châ ta, Phopi hropazy hawhta â pachâ leipa phopi a cha!
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahy ma Zakaw dohlei reih thei aw ta, Ahy ma Izarei doh khuh a paki thei aw? Mosiapa thipa hawhta thi sah la, Ano chhâna hawhta ei chhâna châ mawh sy!” tah ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bâlâka ta Bâlâma hnohta, “Ei chô liata khâpa na tao? Ei chariahzy chhiesapa awpa ta châ chhi na ta, châhrasala byhnâ tlao na awpa ei,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bâlâma ta a chhy ta, “ Abeipa ta ei pakah liata a sopa cha ei rei awpa châ vei mâ?” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bâlâka ta a hnohta, “Ngiachhiepa ta su hro lâ na vaw zi heih teh. Cha su tawhta na hmô thei aw ei. A rakhapa ta hmô aw chi ta, ama zydua ta deikua hmô aw va chi. Cha su tawhta âmo cha chhie na sapa mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zôphi lyu liata Piskâ tlâh laki lâ a chhi ta, maisâh miasari tao ta, maisâh to liata viahchao tôhpa pô kha nata mietaku tôhpa pô kha lymâ hlâ ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bâlâma ta Bâlâka hnohta, “Hao liata Abeipa bie ei kei chho chhôh ta, raopa hlâna kiapâh liana heta a vaw duah thlâh ha mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa ta Bâlâma cha a vaw tyh ta, a pakah liata bie soh ta, “Bâlâka lâ a lie la, a hnohta hetana heta kei reih teh,” tah ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bâlâma cha Bâlâka lâ vawh ta. Bâlâka cha raopa hlâna kiapâh liata a vaw duah thlâh ha ta. Môabâ beimachâzy a hnohta y ei ta. Bâlâka ta a hnohta, “ Abeipa ta khâpa ma a reih? tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bâlâma ta a bie daopa cha thaoh ta, “Hy Bâlâka, thyu la, nathlie teh, Zipô sawchapawpa y, ei bie he nathlie mah y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khazohpa cha chyhsapa a châ leipa vâta, Haih beih leipa ta; Chyhsa sawchapawpa a châ leipa vâta, A palôh panano beih vei. A rei hapa tao leipa ta a y aw ma? A chho hapa patlô leipa ta a y aw ma?
  </para>
  <para style="p">
    <verse number="20" style="v" />Pachâ teh, Byhnâ aw awpa ta biepiepa ei dao; Byhnâ awpa ha ta, Panano thei khao va na.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zakaw liata chhiena hmô leipa ta, Izarei liata tymâna hmô vei. Abeipa ama Khazohpa ama hnohta y ta, Ama Bei palyupalihna pyu ama hry liata a y.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izi tawhta âmo a kaw chhi papuapa Khazohpa cha, Âmo châta chaoliah tôhpa ki hawhta a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dyuthaina ta Zakaw tiah leipa aw ta, Pachaona ta Izarei hria thei aw vei; Zakaw nata Izarei thâtih rei tita, Khazohpa hmotaopa kyh reih tyhpa a châ aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Moh tua, hao phopi huh! Chakeibarôhneipa panô hawhta thyu ta, Chakeibarôhneipa tôhpa hawhta â pathlua huh. A sa taipa a nie hlâlei a byu leipa aw ta, A thiepa thisaih a doh hlâlei a byu aw vei,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bâlâka ta Bâlâma hnohta, “Âmo châta chhiesapa leipa la, byhnâ chhao awpa hra khah y,” tah ta.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bâlâma ta Bâlâka a chhy ta, “‘ Abeipa ta a reipa zydua ei tao aw,’ tahpa cha chho va na ma?” tah ta.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bâlâka ta Bâlâma hnohta, “A vy teh, su hro lâ ei châ chhi aw. Cha su chhâ ta cha Khazohpa palôh patlâh thei ngyu aw ta, cha tawhna chata âmo cha chhie eina sapa thei ngyu aw chi,” tah ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chatanachata Bâlâka ta Bâlâma cha râhchawhpa lâ a heihpa Peô tlâh laki lâ a chhi ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bâlâma ta Bâlâka hnohta, “He liata maisâh miasari na taopa la, viahchao tôhpa pô sari nata mietaku tôhpa pô sari nâ chhuanohpa teh,” tah ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bâlâka ta Bâlâma reipa hawhta tao ta, maisâh to liata viahchao tôhpa pô kha nata mietaku tôhpa pô kha lymâ hlâ ta.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Izarei châta byhnâ awpa cha Abeipa a palysa tahpa Bâlâma ta a pahno nahta, a noh hro ta a tao tyhpa hawhta pachao awpa ta sie khao leipa ta, râhchawhpa lâ tlao a pangai haw.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bâlâma cha mohmia pasaih ta, Izarei sawzy a chi chi ta riehmo ama paryhpa hmô ta. Khazohpa Thlahpa a chô liata vaw tlô ta,
  </para>
  <para style="p">
    <verse number="3" style="v" />chatanachata a bie daopa cha thaoh ta, “He he Beôrâ sawchapawpa Bâlâma bie daopa châ ta, Mo pavâsapa chyhsa bie daopa a châ.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khazohpa biezy thei ta, Atotaotheipa aluahna hmô ta, Pao ta, mâ lâ hawhta y ta, Châhrasala a mo a padeih thlâhpa bie daopa a châ:
  </para>
  <para style="p">
    <verse number="5" style="v" />Hy Zakaw, na poh ozy â ngia kaw dia, Hy Izarei, na byureihzy â ngia kaw dia!
  </para>
  <para style="p">
    <verse number="6" style="v" />Saikao dia zualuapazy lyu ta, Chavah kiah liata sadôzy a lyu; Abeipa lopa tlôma-uzy lyu ta, Tizy kiah liata sidy thozy a lyu.
  </para>
  <para style="p">
    <verse number="7" style="v" />A chiahzy tawhta ti loh aw ta, Ti hluhpizy liata a chi a y aw; A bei cha Akâ hlâta rônah via aw ta, Â beinarâh cheihchalopa a châ aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Izarei cha Khazohpa ta Izi tawhta a kaw chhi papua ta, Ano châta chaoliah tôhpa ki hawhta a châ; A chariahpa râhzy palâ khai aw ta, Ama ruzy a tlawh ta pakeichheihpa ta, A châtaizy ta âmo a chhô pahlie aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chakeibarôhneipa tôhpa hawhta a byu ta, Chakeibarôhneipa panô hawhta â zia; Ahy a pathyu ngâh aw? Byhnâ châ awpatuhpa cha byhnâ to sala, Chhie châ sapatuhpa cha chhiesapa châ mawh sy,” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chatawhcha Bâlâka cha Bâlâma chô liata a pathi ia ta, a ku nata a ku thata a chô ta, Bâlâka ta Bâlâma hnohta, “Ei chariahpazy chhiesapa awpa ta cha aw na ta, pachâ teh, ei thôh dua byhnâ na awpa ei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chavâta tahmâ na o lâ a râ teh. Rônah ngaitapa ta cha tao awpa a chhuah na ta, châhrasala Abeipa ta na rônah awpa a cha pakhâ haw,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bâlâma ta Bâlâka cha a chhy ta, “Kei lâta na vaw tuapa na chyhsazy hnohta,
  </para>
  <para style="p">
    <verse number="13" style="v" />‘Bâlâka ta tâkâ nata ngôh ta a biepa a o taihta eina piepa chhao ta, Abeipa bie khô lâ cha a phapa tlyma, a chhiepa tlyma, keima kho ta khâpa hmah tao thei va na. Abeipa ta a reipa deita ei reih aw,’ tah ha va na ma?
  </para>
  <para style="p">
    <verse number="14" style="v" />Tahmâ cha ei phopi lâ ei sie aw. A vy teh, noh a vaw tlô awpazy liata, he phopi ta na phopi chô liata ama tao awpa ei cha pahnosa aw,” tah ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chatanachata Bâlâma ta a bie daopa cha thaoh ta, “He he Beôrâ sawchapawpa Bâlâma bie daopa châ ta, Mo pavâsapa chyhsa bie daopa a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khazohpa biezy thei ta, Chônôchaipa pahnona pahno ta, Atotaotheipa aluahna hmô ta, Pao ta, mâ lâ hawhta y ta, Châhrasala a mo a padeih thlâhpa bie daopa a châ:
  </para>
  <para style="p">
    <verse number="17" style="v" />Ano cha hmô na ta, Châhrasala tahmâ châ vei; Moh na ta, Châhrasala a hnia vei; Zakaw tawhta awhsi vaw pua aw ta, Izarei tawhta bei a vaw pua aw. Môabâ râh zydua pahnie aw ta, Sethâ saw zydua a pahleipadia khai aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Edômâ cha pahniepa châ aw ta, A chariahpazy ta Seirâ ama tiah aw; Izarei deikua a chhyu rili aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zakaw tawhta bei vaw pua aw ta, Khihpizy liata laibâhpazy a pahleipadia aw,” tah ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chatawhcha Amale lâ a heih ta, a bie daopa thaoh ta, “Amale cha phopi hmiatuapa châ ta, A chhâna deikua tlokhuh leidiana a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Keni mo lâ a heih ta, a bie daopa thaoh ta, “Na pahrâna su a i ta, Lôpanô liata bu na tu.
  </para>
  <para style="p">
    <verse number="22" style="v" />Châhrasala Asuria ta sei ta a châ chhi tita, Keni cha mei ta rao khaipa a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />A bie daopa thaoh heih ta, “Cha hmo cha Khazohpa ta a tao tita, Ahy a hroh thei aw tly?
  </para>
  <para style="p">
    <verse number="24" style="v" />Kiti tawhta balyhzy vaw tlô aw ta, Asuria a panawh aw; Ebe chhao panawh aw ta, Chhâzaw ta a leidia aw,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cha khai tawhta Bâlâma cha thyu ta, a yna lâ sie ta, Bâlâka chhao cha a o lâ a di ha hra ta.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Siti liata Izarei a y nota, Izarei sawzy ta Môabâ chanôzy sihryhkhei ei ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chanôzy ta ama khazohzy lâta atheihna hlânazy liata Izarei sawzy cha hrua ei ta. Izarei sawzy ta atheihnazy cha niepa ta, Môabâ khazohzy lâta a bôh ei ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha hawhna chata Izarei ta Peô liata Bâlâ nata azaona tao ta. Chavâta Izarei chô liata Abeipa pathi ia ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abeipa ta Mawsi hnohta, “Izarei phopi chhituhpa zydua a chhi la, Abeipa pathiiana ru ngaitapa he Izarei chô tawhta a pai nawpa ta, âmo cha Abeipa hmiakô liata nohchhô sawhvaw ta paaosao teh,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chatanachata Mawsi ta Izarei ryureituhpazy hnohta, “Peô liata Bâlâ nata azaona a taopa nama chyhsazy kha, nâmo tlai ta thie khai teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ahmaohna poh o chhikao liata ama cha hai nota, Izarei chyhsa pakha ta Midia chanô pakha Mawsi mohmô nata Izarei zawpi mohmô liata a o lâ a vaw chhi ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Theihthaipa Arawna sawchapawpa Eliaza sawchapawpa Phinehâ ta a hmô nahta, thyu ta, asei a la ta, zawpi hry tawhta pua ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Izarei chyhsa cha poh o chhôh lâ a ngiahnao ta, Izarei chyhsa nata chanô cha ama pano ta ama py liata a chô ta. Chatanachata potlana cha Izarei sawzy tawhta a pai haw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Potlana liata a thipa zydua 24,000 ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Theihthaipa Arawna sawchapawpa Eliaza sawchapawpa Phinehâ ta Izarei chô liata ei hiehâhna a papai haw. Ama chô liata ei hiatliana liata ano chhao a hia eina tliakhei hrapa vâta, ei hiatliana ta Izarei sawzy cha pahleipadia khao aw va na.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chavâta a hnohta hetana heta chho teh, ‘A hnohta adyhna biehrai ei tao aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />A Khazohpa châta a hiatlia ta, Izarei sawzy châta chatlaina a taopa vâta, cha cha ano nata a hnôhlâ ta a pathlazy châta chhâzaw ta theihthaipa châna biehrai a châ aw,’” tah ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Izarei chyhsa ama thiepa, Midia chanô nata hmaohkha ama thiepa moh cha Salu sawchapawpa Zimri châ ta, Simeôna chi liata pho kha hyutuhpa a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Midia chanô ama thiepa moh cha Zuri sawchanô Kôzabi châ ta, Midia chi liata pho kha hyutuhpa sawchanô a châ.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Midia mo kha ama nô papo u la, thie teh u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Peô kyh liata cha dôveipa ta nama nô cha papo ei ta. Peô vâta potlana a y nota ama sietanô Kôzabi, Midia hyutuhpa sawchanô cha thiepa châ ta, cha kyh liata chhao piehpie ngaitapa ta châ dôveituhpa ama châ,” tah ta.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Potlana a pai tawhta Abeipa ta Mawsi nata theihthaipa Arawna sawchapawpa Eliaza cha bie a chho ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei chyhsa zydua maluh reih u la, kô kih tawhta chô lâ, a chhôh chhôh ta, Izarei râh liata a pahrâpa adyuhna lâ sie thei awpa zydua reih khai teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawsi nata theihthaipa Eliaza ta Zerikô dady ta a ypa Zawdâh kiah liata Môabâ bypi liata Izarei sawzy cha bie chho ei ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="4" style="v" />“ Abeipa ta Mawsi bie a piepa hawhta, kô kih tawhta chô lâ zydua maluh reih teh u,” tah ei ta. Hezy he Izi râh tawhta a kaw puapa Izarei sawzy ama châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Izarei sawchapaw uhtheipa cha Rubena châ ta, Rubena pathlazy cha, Hanô tawhta Hanô phozy, Pâluh tawhta Pâluh phozy;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezrô tawhta Hezrô phozy nata Kâmi tawhta Kâmi phozy ama châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Âmo cha Rubena pathla phozy châ ei ta, ama maluh rei theipa zydua cha 43,730 ama châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pâluh sawchapawpa cha Eliabâ a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliabâ sawchapawzy cha Nemua, Dâthâ nata Abirâ zy ama châ. Dâthâ nata Abirâ cha zawpi hry tawhta a tlyhpazy châ ei ta, Abeipa amâ dyuh nota, Kôrâ nata a pakaohpa ta Mawsi nata Arawna a chakhiapazy kha ama châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Alei ta a pakah â ta, âmo cha Kôrâ nata hmaohkha ta a palâ ha ei. Mei ta Kôrâ nata a py manôh 250 a kâsao nota, âmo chhao kâsao ta, zikyurâna ta ama vaw châ haw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kôrâ sawchapawzy deikua cha thi veih ei.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pho pho ta reipa ta, Simeôna pathlazy cha, Nemua tawhta Nemua phozy, Zami tawhta Zami phozy, Zakhi tawhta Zakhi phozy;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerâ tawhta Zerâ phozy nata Sawla tawhta Sawla phozy ama châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Âmo cha Simeôna pathla phozy châ ei ta, ama zydua ta 22,200 ama châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pho pho ta reipa ta, Kâdâ pathlazy cha, Zephô tawhta Zephô phozy, Hâki tawhta Hâki phozy, Suni tawhta Suni phozy;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ôzni tawhta Ôzni phozy; Eri tawhta Eri phozy;
  </para>
  <para style="p">
    <verse number="17" style="v" />Arô tawhta Arô phozy nata Areli tawhta Areli phozy ama châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Âmo cha Kâdâ pathla phozy châ ei ta, ama maluh rei theipa zydua cha 40,500 ama châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zudâh pathlazy cha Erâ nata Ônâ châ ei ta. Erâ nata Ônâ cha Kâna râh liata thi ha ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />A pho pho ta reipa ta, Zudâh pathlazy cha, Selâh tawhta Selâh phozy; Phare tawhta Phare phozy nata Zerâ tawhta Zerâ phozy ama châ.
  </para>
  <para style="p">
    <verse number="21" style="v" />Phare pathlazy cha, Hezrô tawhta Hezrô phozy nata Hâmu tawhta Hâmu phozy ama châ.
  </para>
  <para style="p">
    <verse number="22" style="v" />Âmo cha Zudâh pathla phozy châ ei ta, ama maluh rei theipa zydua cha 76,500 ama châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pho pho ta reipa ta, Iskâra pathlazy cha, Tola tawhta Tola phozy, Puvâ tawhta Puvâ phozy;
  </para>
  <para style="p">
    <verse number="24" style="v" />Zasu tawhta Zasu phozy nata Simrô tawhta Simrô phozy ama châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Âmo cha Iskâra pathla phozy châ ei ta, ama maluh rei theipa zydua cha 64,300 ama châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />A pho pho ta reipa ta, Zebulawna pathlazy cha, Sere tawhta Sere phozy, Elaw tawhta Elaw phozy nata Zali tawhta Zali phozy ama châ.
  </para>
  <para style="p">
    <verse number="27" style="v" />Âmo cha Zebulawna pathla phozy châ ei ta, ama maluh rei theipa zydua cha 60,500 ama châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />A pho pho ta reipa ta, Manase nata Epharai chizy tawhta a puapa Zawsi pathlazy cha, hezy he ama châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manase sawchapawpa Mâkhi tawhta Mâkhi pho vaw pua ei ta, Mâkhi ta Kilia sa ta, Kilia tawhta Kilia pho ama vaw pua.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kilia pathlazy châ, Izah tawhta Izah phozy, Hele tawhta Hele phozy;
  </para>
  <para style="p">
    <verse number="31" style="v" />Asrie tawhta Asrie phozy, Sekhe tawhta Sekhe phozy;
  </para>
  <para style="p">
    <verse number="32" style="v" />Semidâ tawhta Semidâ phozy nata Hepha tawhta Hepha phozy ama châ.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hepha sawchapawpa Zelôphehâ cha sawchapaw hnei leipa ta, sawchanôzy deita hnei ta, Zelôphehâ sawchanôzy moh cha Mâhlâ, Noâh, Hôkalâ, Milkâ nata Tizah zy ama châ.
  </para>
  <para style="p">
    <verse number="34" style="v" />Âmo cha Manase pathla phozy châ ei ta, ama maluh rei theipa zydua cha 52,700 ama châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />A pho pho ta reipa ta, Epharai pathlazy cha, Suthelâ tawhta Suthelâ phozy; Bekhe tawhta Bekhe phozy nata Tahâ tawhta Tahâ phozy ama châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Suthelâ pathla Erâni tawhta Erâni pho a vaw pua.
  </para>
  <para style="p">
    <verse number="37" style="v" />Âmo cha Epharai pathla phozy châ ei ta, ama maluh rei theipa zydua cha 32,500 ama châ. Chazy cha a pho pho ta reipa ta Zawsi pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />A pho pho ta reipa ta, Benzami pathlazy cha, Belâ tawhta Belâ phozy, Asbe tawhta Asbe phozy, Ahirami tawhta Ahirami phozy;
  </para>
  <para style="p">
    <verse number="39" style="v" />Sephupha tawhta Sephupha phozy nata Hupha tawhta Hupha phozy ama châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Belâ ta Aradâ nata Nâmâ sa ta, Aradâ tawhta Aradâ phozy vaw pua ta, Nâmâ tawhta Nâmâ phozy a vaw pua.
  </para>
  <para style="p">
    <verse number="41" style="v" />Âmo cha Benzami pathla phozy châ ei ta, ama maluh rei theipa zydua cha 45,600 ama châ.
  </para>
  <para style="p">
    <verse number="42" style="v" />A pho pho ta reipa ta, hezy he Dânâ pathlazy ama châ. Suhâ tawhta Suhâ phozy vaw pua ei ta, âmo cha a pho pho ta reipa ta, Dânâ pathlazy ama châ.
  </para>
  <para style="p">
    <verse number="43" style="v" />Suhâ pathla pho maluh rei theipa zydua cha 64,400 ama châ.
  </para>
  <para style="p">
    <verse number="44" style="v" />A pho pho ta reipa ta, Asera pathlazy cha, Imnâ tawhta Imnâ phozy, Isvi tawhta Isvi phozy nata Beriah tawhta Beriah phozy ama châ.
  </para>
  <para style="p">
    <verse number="45" style="v" />Beriah pathla Hebe tawhta Hebe phozy vaw pua ei ta, Malkie tawhta Malkie phozy ama vaw pua.
  </para>
  <para style="p">
    <verse number="46" style="v" />Asera ta sawchanô hnei ta, a moh cha Serâ a châ.
  </para>
  <para style="p">
    <verse number="47" style="v" />Âmo cha Asera pathla phozy châ ei ta, ama maluh rei theipa zydua cha 53,400 ama châ.
  </para>
  <para style="p">
    <verse number="48" style="v" />A pho pho ta reipa ta, Nâthalai pathlazy cha, Zazi tawhta Zazi phozy, Kuni tawhta Kuni phozy;
  </para>
  <para style="p">
    <verse number="49" style="v" />Zeze tawhta Zeze phozy nata Sile tawhta Sile phozy ama châ.
  </para>
  <para style="p">
    <verse number="50" style="v" />Âmo cha Nâthalai pathla phozy châ ei ta, ama maluh rei theipa zydua cha 45,400 ama châ.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chazy cha Izarei saw maluh rei theipazy châ ei ta, ama zydua ta 601,730 ama châ.
  </para>
  <para style="p">
    <verse number="52" style="v" />Abeipa ta Mawsi chho ta:
  </para>
  <para style="p">
    <verse number="53" style="v" />“He sahlaozy hnohna heta ama maluh hawhta ryuto râh rai awpa a châ.
  </para>
  <para style="p">
    <verse number="54" style="v" />Maluh hluh viapa hnohta ryuto râh lai viapa pie aw chi ta, maluh chyh viapa hnohta ryuto râh chyh via na pie aw. Chi to hnohta ama maluh hluhnazie hawhta ryuto râh pie chyu awpa a châ.
  </para>
  <para style="p">
    <verse number="55" style="v" />Nuby a daopa ta râh cha rai awpa châ ta, ama pathlatuhpa chi moh ta râh cha ryuto châta ama to awpa a châ.
  </para>
  <para style="p">
    <verse number="56" style="v" />Nuby a daozie hawhta chi lai viapa nata chi chyh viapazy hnohta ryuto râh rai awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="57" style="v" />Hezy he a pho pho ta reipa Livai pathlazy ama châ: Kesao tawhta Kesao phozy, Kôhâ tawhta Kôhâ phozy nata Merâri tawhta Merâri phozy ama châ.
  </para>
  <para style="p">
    <verse number="58" style="v" />Libni phozy, Hebraw phozy, Mâhli phozy, Musi phozy nata Kôrâ phozy chhao Livai phozy ama châ hra. Kôhâ cha Amrâ paw châ ta,
  </para>
  <para style="p">
    <verse number="59" style="v" />Amrâ lapinô moh cha Livai sawchanô Zôkebe châ ta, Izi râh liata Livai ta a sapa a châ. Ano chata Amrâ liata Arawna nata Mawsi nata ama sietanô Miria zy a sa ei.
  </para>
  <para style="p">
    <verse number="60" style="v" />Arawna ta Nâdâ, Abihu, Eliaza nata Ithamâ sa ta.
  </para>
  <para style="p">
    <verse number="61" style="v" />Nâdâ nata Abihu deikua cha Abeipa hmiakô liata pasai leipa mei ama hlâ raruah nota ama thi haw.
  </para>
  <para style="p">
    <verse number="62" style="v" />Livai chi maluh rei theipa chapaw thla kha tawhta chô lâ zydua cha 23,000 ama châ. Âmo cha Izarei sawzy hry liata ryuto râh pie leipa ama châpa vâta, Izarei sawzy maluh reina liata rei pâpa châ veih ei.
  </para>
  <para style="p">
    <verse number="63" style="v" />Chazy cha Mawsi nata theihthaipa Eliaza rei theipa maluhzy châ ei ta, chazy cha Zerikô dady Zawdâh chavah kiah Môabâ bypi liata ama reipazy ama châ.
  </para>
  <para style="p">
    <verse number="64" style="v" />Chazy hry liana chata Sinai râhchawhpa liata Mawsi nata theihthaipa Arawna ta maluh ama vaw reipa Izarei sawzy pakha hmahta a hlao khao veih ei.
  </para>
  <para style="p">
    <verse number="65" style="v" />Abeipa ta, “Râhchawhpa liata ama thi thlyu awpa a châ,” a tah hapa vâta, Zephune sawchapawpa Kâlebâ nata Nunâ sawchapawpa Zawsua dei leipa ta cha, pakha hmah ahrohpa y veih ei.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zelôphehâ sawchanôzy a vy ei ta. Zelôphehâ cha Hepha sawchapawpa châ ta, Hepha cha Kilia sawchapawpa châ ta, Kilia cha Mâkhi sawchapawpa châ ta, Mâkhi cha Manase sawchapawpa châ ta, Manase cha Zawsi sawchapawpa a châ. Zelôphehâ sawchanôzy cha Mâhlâ, Noâh, Hôkalâ nata Tizah zy ama châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mawsi nata theihthaipa Eliaza nata beimachâzy nata zawpi zydua hmiakô liata ahmaohna poh o chhikao liata a kei duah ei ta, ama hnohta,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Eima paw cha râhchawhpa liata thi ha ta, Abeipa a dyuh awpa ta a paraohpa ta a hmaohpakhypa Kôrâ py liata deikua a hlao vei. Ano moleina vâ tlai ta a thipa a châ. Sawchapaw hnei vei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sawchapaw a hnei leipa vâta, khazia eima paw moh cha a phoheihzy hry tawhta a lei aw? Eima paw unawhzy hry liata ryuto miah pie hra teh u,” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mawsi ta ama bie cha Abeipa hmiakô liata tlôkhei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zelôphehâ sawchanôzy reipa cha hmo dopa a châ. Ama paw unawhzy hry liata ama ryuto râh na pie hra awpa ei châ ta, ama paw ryuto râh cha âmo na pie awpa ei a châ.
  </para>
  <para style="p">
    <verse number="8" style="v" />Izarei sawzy hnohta, ‘Chyhsa ta sawchapaw hnei leipa ta a thi khiahta cha, a ryu cha a sawchanô nama pie awpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sawchanô a hnei vei khiahta cha, a ryu cha a unawhzy nama pie awpa a châ.
  </para>
  <para style="p">
    <verse number="10" style="v" />Unawh a hnei vei khiahta cha, a ryu cha a paw unawhzy nama pie awpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />A paw ta unawhzy a hnei vei khiahta cha, a ryu cha a pho liata a heinawh a hnia chaipa pie aw ei chi ta, ano ta a pakhy aw. Abeipa ta Mawsi bie a piepa hawhta, cha cha Izarei sawzy châta pachiana ryhpa a châ aw,’ tah mah y,” tah ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abeipa ta Mawsi hnohta, “Abari tlâh lâ khi khy la, Izarei sawzy ei piepa râh cha kaw sai mah y.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na hmô khai tawhta, na unawhpa Arawna a chiheihzy hnohta pahlyhpa a châpa hawhna khata, nâ chhao na chiheihzy hnohta pahlyhpa na châ aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zini râhchawhpa liata zawpi ta einâ dyuh no ei ta, nâmo pano chhao ei biepiepa a dyuh hra ei chi ta, tizy kiah liata zawpi hmiakô liata eina palyupalih leipa vâ ei chi ta a châ,” tah ta. Cha tizy cha Zini râhchawhpa liata Kâdesâ liata Meribâ tizy a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawsi ta Abeipa hnohta,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Zawpizy he chhihtha awpa ta, Abeipa , chyhsa zydua thlahpa Khazohpa ta chyhsa pakha rao mawh sy.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ano chata zawpizy hmia lâta pua aw ta, a tlôkhei aw ei. Zawpizy chhihtha aw ta, â ngiakhei aw ei. Chatanachata Abeipa chyhsa zawpizy cha vaituhpa hnei leipa mietaku hawhta y aw veih ei,” tah ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abeipa ta Mawsi hnohta, “Nunâ sawchapawpa Zawsua, thlahpa ta a ylâhpa chyhsa kha a chhi la, a chô liata na ku pahnieh mah y.
  </para>
  <para style="p">
    <verse number="19" style="v" />Theihthaipa Eliaza nata zawpi zydua hmiakô liata paduasa aw chi ta, ama mohmô liata biehneina na pie aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Izarei zawpizy ta a rei amâ ngiah thei nawpa ta, na biehneina ano hnohta na hlâ aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ano cha theihthaipa Eliaza hmiakô liata a duah aw ta, theihthaipa Eliaza ta Abeipa hmiakô liata Uri hmâpa ta pachiana bie a hiahripa tyh aw. Ano nata a hnohta a ypa Izarei zawpi zydua ano rei sai ta pua aw ei ta, ano rei sai ta amâ ngia aw,” tah ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mawsi ta Abeipa biepiepa hawhta tao ta. Zawsua cha a chhi ta, Eliaza nata zawpi zydua hmiakô liata paduasa ta.
  </para>
  <para style="p">
    <verse number="23" style="v" />A chô liata a ku pahnieh ta, Mawsi hmâpa ta Abeipa biereipa hawhta biehneina cha pie ta.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy biepie la ama hnohta hetana heta chho teh: ‘Kei lâta mei ta nama hlâ tyh awpa niepa hlânazy cha a daihti raopa liata nama hlâ tyh awpa a châ. Cha cha kei châta ropahâhpa a châ,’ tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />He he mei ta hmohlâpa Abeipa lâta nama hlâ awpa a châ: Noh kha ta mietakutaw chapawpa kô khapa seina hnei leipa pô no lymâ ta, noh chareih ta raopa hlâna châta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mietakutaw pô kha my ta hlâ aw ei chi ta, pô kha zâlâ ta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Niepa hlâna châta viahdie dipa kachu su hrawh su kha nata sathaw saohpa chhiehraôh ôh kha hlâ pâ awpa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cha cha tao lymâ awpa raopa hlâna, Abeipa lâta mei ta hmohlâpa ropahâhpa châ ta, Sinai Tlâh liata chahnao pa-ipa kha a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mietakutaw pô kha hlâna liata, dopa hlâna chhiehraôh ôh kha lymâ hlâ aw chi ta, Abeipa lâta dopa hlâna ta hlâ awpa kresawhti patapa cha su pathaihpa liata na patlai aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zâlâ ta mietakutaw hropa hlâ aw chi ta, my ta na hlâpa niepa hlâna nata â chakaihpa dopa hlâna hawhna khata, Abeipa châta ropahâhpa mei ta hmohlâpa cha na hlâ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Pahânoh ta mietakutaw chapawpa, kô khapa seina hnei leipa pô no hlâ aw chi ta, â chakaihpa niepa hlâna châta viahdie dipa kachu su hrawh su no sathaw pahlaopa nata dopa hlâna na hlâ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cha cha Pahânoh maihta hlâ tyhpa raopa hlâna châ ta, raopa hlâna hlâ tyhpa nata â chakaihpa dopa hlâna thota hlâ awpa a châ.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Nama thla thiehpa maihta, Abeipa lâta raopa hlâna, viahchao tôh dawpa pô no nata mietaku tôhpa pô kha nata mietakutaw chapawpa kô khapa seina hnei leipa pô sari nama hlâ tyh aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Viahchao tôhpa pô kha liata niepa hlâna châta viahdie dipa sathaw pahlaopa kachu su hrawh su thôh; mietaku tôhpa pô kha liata niepa hlâna viahdie dipa sathaw pahlaopa kachu su hrawh su no;
  </para>
  <para style="p">
    <verse number="13" style="v" />mietakutaw pô kha liata niepa hlâna châta viahdie dipa sathaw pahlaopa kachu su hrawh su kha zy cha raopa hlâna ropahâhpa, Abeipa lâta mei ta hmohlâpa ta nama hlâ tyh aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Raopa hlâna ta â chakaihpa dopa hlâna châta, viahchao tôhpa pô kha liata kresawhti chhiehraôh ôh no châ aw ta, mietaku tôhpa pô kha liata chhiehraôh ôh kha nata khophie châ aw ta, mietakutaw pô kha liata chhiehraôh ôh kha a châ aw. Cha cha kô chhôh thla thiehpa maihta raopa hlâna hlâ awpa cha a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Raopa hlâna hlâ tyhpa nata â chakaihpa dopa hlâna thota, Abeipa lâta moleina hlâna châta mie tôhpa pô kha nama hlâ aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Thla khana, noh hrawh hleipalihna noh cha Abeipa zawpakhô kyhchhi a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cha thla, noh hrawh hleipangawhna noh cha kyhchhi noh châ ta, noh sari chhôh viahchhâ thinô pahlao leipa nie awpa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Noh khana noh cha pakhypi pathaihpa châ aw ta, rai rupa nama hria awpa châ vei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mei ta hmohlâpa raopa hlâna deikua cha Abeipa lâ nama hlâ aw. Viahchao tôh dawpa pô no, mietaku tôhpa pô kha nata mietakutaw chapawpa kô khapa pô sari, seina hnei leipazy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Raopa hlâna ta â chakaihpa niepa hlâna châta viahchao tôhpa pô kha liata viahdie dipa sathaw pahlaopa kachu su hrawh su thôh, mietaku tôhpa pô kha liata su hrawh su no,
  </para>
  <para style="p">
    <verse number="21" style="v" />mietakutaw pô saripazy châta mietakutaw pô kha liata su hrawh su kha lymâ ta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nama châta chatlaina tao nawpa ta moleina hlâna châta mie tôhpa pô kha nama hlâ aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chazy cha my ta raopa hlâna nama hlâ tyhpa thota nama hlâ awpa a châ.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cha hawhna chata Abeipa lâta mei ta hmohlâpa niepa hlâna cha, noh sari chhôh, noh chareih ta nama hlâ aw. Cha cha Abeipa châta ropahâhpa châ ta, raopa hlâna hlâ tyhpa nata â chakaihpa dopa hlâna thota hlâ awpa a châ.
  </para>
  <para style="p">
    <verse number="25" style="v" />Noh sarina noh ta pakhypi pathaihpa hnei aw ei chi ta, rai rupa nama hria awpa châ vei.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nama hâta kyhchhi chhôh ta, Abeipa lâta niepa hlâna sâh thiehpa, thei hmiatuapazy nama hlâna noh ta, pakhypi pathaihpa hnei aw ei chi ta, rai rupa nama hria awpa châ vei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Raopa hlâna ta viahchao tôh dawpa pô no, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa pô sari nama hlâ aw. Cha cha Abeipa châta ropahâhpa a châ.
  </para>
  <para style="p">
    <verse number="28" style="v" />Raona hlâna ta â chakaihpa niepa hlâna châta viahdie dipa sathaw pahlaopa cha, viahchao tôhpa pô kha liata kachu su hrawh su thôh, mietaku tôhpa pô kha liata su hrawh su no,
  </para>
  <para style="p">
    <verse number="29" style="v" />mietakutaw pô saripazy châta mietakutaw pô kha liata su hrawh su kha lymâ ta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nama châta chatlaina tao nawpa ta, mie tôhpa pô kha nama hlâ pâ aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chazy cha raopa hlâna ta â chakaihpa dopa hlânazy chhaota pachhuahpanoh aw ei chi ta, raopa hlâna nata niepa hlâna hlâ tyhpazy thota hlâ awpazy a châ. Sahroh hlâ awpazy cha seina hnei leipazy ama châ awpa a châ.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Thla sarina noh khana noh liata pakhypi pathaihpa hnei aw ei chi ta, rai rupa nama hria awpa châ vei. Nama châta chiahmiezy tôna noh a châ aw.
  </para>
  <para style="p">
    <verse number="2" style="v" />Raopa hlâna châta viahchao tôh dawpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa seina hnei leipa pô sari nama hlâ aw. Cha cha Abeipa châta ropahâhpa a châ aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Â chakaihpa niepa hlâna châta viahchao tôhpa pô kha liata viahdie dipa sathaw pahlaopa kachu su hrawh su thôh, mietaku tôhpa pô kha liata su hrawh su no,
  </para>
  <para style="p">
    <verse number="4" style="v" />mietakutaw pô saripazy châta pô kha liata su hrawh su kha lymâ ta nama hlâ aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nama châta chatlaina tao nawpa ta, moleina hlâna mie tôhpa pô kha nama hlâ pâ aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chazy cha, thla thieh raopa hlâna nata â chakaihpa niepa hlâna, raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota, taozie awpa hawhta taopa ta, Abeipa châta ropahâhpa châta mei ta hmohlâpa hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Thla sarina noh hrawhna noh liata pakhypi pathaihpa nama hnei aw. Kâhvileipa ta y aw ei chi ta, khâpa rai hmah nama hria awpa châ vei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abeipa châta ropahâhpa raopa hlâna deikua cha hlâ aw ei chi ta, viahchao tôhpa pô kha, mietaku tôhpa pô kha, mietakutaw chapawpa kô khapa seina hnei leipa pô sari nama hlâ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Â chakaihpa niepa hlâna châta viahchao tôhpa pô kha liata viahdie dipa sathaw pahlaopa kachu su hrawh su thôh, mietaku tôhpa pô kha liata su hrawh su no,
  </para>
  <para style="p">
    <verse number="10" style="v" />mietakutaw pô saripazy châta mietakutaw pô kha liata su hrawh su kha nama hlâ aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha nama hlâ aw. Chazy cha chatlaina châta moleina hlâna nata raopa hlâna hlâ tyhpazy nata amâ chakaihpa niepa hlâna nata dopa hlânazy thota nama hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Thla sarina, noh hrawh hleipangawhna noh liata pakhypi pathaihpa hnei aw ei chi ta, rai rupa nama hria awpa châ vei. Abeipa châta noh sari chhôh kyhchhi nama hmâh aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abeipa châta ropahâhpa, mei ta hmohlâpa raona hlâna viahchao tôh dawpa pô hrawh hleithôh, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amâ chakaihpa niepa hlâna châta hlâ awpa viahchao tôhpa pô hrawh hleithôh châta viahchao tôhpa pô kha liata viahdie dipa sathaw pahlaopa kachu su hrawh su thôh, mietaku tôhpa pô no châta mietaku tôhpa pô kha liata su hrawh su no,
  </para>
  <para style="p">
    <verse number="15" style="v" />mietakutaw pô hrawh hleipalih châta mietakutaw pô kha liata su hrawh su kha nama hlâ aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Noh nona liata viahchao tôh dawpa pô hrawh hleino, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Noh thôhna noh ta viahchao tôhpa pô hrawh hleikha, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Noh palihna noh ta viahchao tôhpa pô hrawh, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Noh pangawhna noh ta viahchao tôhpa pô chaki, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Noh charuna noh ta viahchao tôhpa pô charie, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="31" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Noh sarina noh ta viahchao tôhpa pô sari, mietaku tôhpa pô no, mietakutaw chapawpa kô khapa seina hnei leipa pô hrawh hleipalih nama hlâ aw.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="34" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Noh chariena noh ta pakhypi pathaihpa hnei aw ei chi ta, rai rupa nama hria awpa châ vei.
  </para>
  <para style="p">
    <verse number="36" style="v" />Raopa hlâna ta viahchao tôhpa pô kha, mietaku tôhpa pô kha nata mietakutaw chapawpa kô khapa seina hnei leipa pô sari nama hlâ aw. Cha cha Abeipa châta ropahâhpa, mei ta hmohlâpa a châ.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amâ chakaihpa niepa hlâna nata dopa hlânazy cha, taozietyhpa nata sahroh hlâpa zie lymâ hawhta, viahchao tôhpa châta zy, mietaku tôhpa châta zy, mietakutaw châta zy nama hlâ aw.
  </para>
  <para style="p">
    <verse number="38" style="v" />Moleina hlâna châta chhao mie tôhpa pô kha hlâ aw ei chi ta, chazy cha raopa hlâna hlâ tyhpa nata â chakaihpa niepa hlâna nata dopa hlânazy thota hlâ awpazy a châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Nama bietai hmohlâpazy, nama lôhthai hmohlâpazy, nama raopa hlânazy, nama niepa hlânazy, nama dopa hlânazy nata nama aryhna hlânazy thota, chazy cha nama kyhchhi raopazy liata Abeipa lâ nama hlâ awpa a châ.”
  </para>
  <para style="p">
    <verse number="40" style="v" />Cha hawhna chata Mawsi ta Abeipa biepiepa zydua cha Izarei sawzy chho ta.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mawsi ta Izarei chi hyutuhpazy chho ta, “He he Abeipa biepiepa a châ:
  </para>
  <para style="p">
    <verse number="2" style="v" />Chyhsa ta Abeipa liata bietai a tao khiahta tlyma, hmo tao awpa ta anosasyh â chahry khiahta tlyma, a bie a phie awpa châ vei. A pakah tawhta a puapa zydua hawhta a tao awpa a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Chanô laihsa ta a paw o liata a y thlâh ha nota, Abeipa liata bietai a tao khiahta tlyma, tao awpa ta anosasyh â chahry khiahta tlyma,
  </para>
  <para style="p">
    <verse number="4" style="v" />a bietai nata tao awpa ta anosasyh ta â chahrypa kyh cha a paw ta thei sala, â chalihsai thlâh ha khiahta cha, a bietai zydua nata tao awpa ta anosasyh ta â chahrypa zydua â duah aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Châhrasala a paw ta a thei nahta, a pakhâ ha khiahta cha, a bietai nata tao awpa ta anosasyh ta â chahrypazy miakha hmah a duah aw vei. A paw ta a pakhâ hapa vâta Abeipa ta â ngiahthai aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Chanô ta a chô liata bietai a y thlâh ha nota tlyma, a hmao ta bie â taih chatlie tupa vâta anosasyh â chahryna daihti chhôh liata tlyma vahpa hnei sala,
  </para>
  <para style="p">
    <verse number="7" style="v" />a vahpa ta a bietai thâtih cha thei sala, a thei noh ta â chalihsai thlâh ha khiahta cha, a bietai cha a duah aw ta, tao awpa ta anosasyh â chahrypazy chhao â duah aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Châhrasala a vahpa ta a thei noh ta a pyh leipa sala a pakhâ ha khiahta cha, a lapinô chô liata bietai a ypa nata a hmao ta bie a taih chatlie tupa vâta anosasyh â chahrypazy cha, a vahpa ta pachhâsa aw ta, Abeipa ta â ngiahthai aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nôhmei tlyma, vahpa nata a chhaihpa chanô tlyma ta bietai a taopa nata tao awpa ta anosasyh â chahrypazy deikua cha, a chô liata â duah aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Chanô ta a vahpa o liata a y thlâh ha nota bietai a tao khiahta tlyma, tao awpa ta anosasyh â chahry khiahta tlyma,
  </para>
  <para style="p">
    <verse number="11" style="v" />a vahpa ta thei sala, a chalihsaipa ta, a pakhâ leipa khiahta cha, a bietai zydua a duah aw ta, anosasyh ta â chahrypa zydua chhao â duah aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Châhrasala a vahpa ta a pahno noh ta, bie tloh leipa ta taopa ta, a pachhâsa ha khiahta cha, a hmao tawhta a puapa bietai tlyma, tao awpa ta anosasyh ta â chahrypa hmo tlyma a duah aw vei. A vahpa ta bie tloh leipa ta tao ha ta, Abeipa ta â ngiahthai aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chanô bietai kheihawhpa tlyma, sasyh apakyna bietai chhao rai châ sala, a vahpa ta pa-i thei ta, a pachhâsa thei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Châhrasala a vahpa ta, bietai kyh liata noh chareih â chalihsai thlâh ha khiahta cha, a lapinô bietai zydua nata tao awpa ta â chahrypa zydua cha a pa-ipa a châ. A pahno noh ta â chalihsai hapa vâta a pa-ipa a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />A thei noh tawhta daihti khachâ rakha ma a sie tawhta bie tloh leipa ta taopa ta, a pachhâsa khiahta cha, a vahpa ta a lapinô paraona maoh a phaoh aw,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chazy cha chapaw nata a lapinô likah nata paw nata a sawchanô laihsa a paw o liata a y thlâh ha chypa likah liata bieraopa, Abeipa ta Mawsi hnohta bie a piepazy cha a châ.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Midia mo chô liata Izarei sawzy phuh la teh. Cha khai tawhta na chiheihzy hnohta pahlyhpa na châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mawsi ta zawpizy hnohta, “Midia mo chô liata Abeipa phuh lana patlôsa awpa ta sie awpa ta, nama hry liata chapawzy cha adyuhna chariah chhaichhi ta tobi teh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izarei chi zydua ta chi kha tawhta sâh kha lymâ ta adyuhna lâ nama pasiesa awpa a châ,” tah ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chatanachata Izarei saw sâh hluhpi hry tawhta chi kha tawhta sâh kha chyu papua ei ta, pheisaih thy kha nata sâh no cha, adyuhna lâta sie awpa ta chariah chhaichhi ta tobi ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawsi ta âmo cha adyuhna lâ pasiesa ta, chi to hry tawhta sâh kha chyu pua ei ta, theihthaipa Eliaza sawchapawpa Phinehâ chhao, hmobaoh pathaihpazy nata biepie nawpa ta chiahmiezy chabapa ta adyuhna lâ sie hra ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abeipa ta Mawsi bie a piepa hawhta, Midia mo cha a dyuh ei ta, chapaw zydua ama thie khai haw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Midia beizy chhao, ama chyhsa thiepazy hry liata thie pâ hra ei ta, Midia bei papangawh, Ivi, Reke, Zuri, Hurâ nata Rebâ nata Beô sawchapawpa Bâlâma chhao zaozi ta ama thie haw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Izarei sawzy ta Midia chanôzy nata ama hawtizy cha sei ta a chhi ei ta, ama viahchao zydua, ama mietaku zydua nata ama hmobaoh zydua hraona sôh ta la ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ama pahrâna khihpi zydua nata ama riehmo zydua mei ta rao khai ei ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ama hraopa nata lapa zydua, chyhsapa chhao, sahroh chhao, ama siekhei haw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Seizy, sahrohzy nata hraopazy cha, Zerikô dady Zawdâh kiapâh ta Môabâ bypi riehmo liata a ypa Mawsi nata theihthaipa Eliaza nata Izarei zawpizy lâ vaw tlô khei ei ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mawsi nata theihthaipa Eliaza nata zawpi hyutuhpa zydua ta riehmo khôtho lâ kei dy ei ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mawsi cha adyuhna chakaona rai lâ tawhta a vaw tlôpa pheisaih hyutuhpa, sâh kha chô liata hyutuhpazy nata za kha chô liata hyutuhpazy chô liata a pathi ia ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mawsi ta ama hnohta, “Chanôzy cha ahrohpa ta ma nama pahlôh khai haw?
  </para>
  <para style="p">
    <verse number="16" style="v" />Pachâ teh u, âmo kha Bâlâma ryhraona ta Peô liata Izarei sawzy Abeipa chô liata paraona a pataosatuhpazy châ ei ta, âmo vâta Abeipa chyhsazy chô liata potlana a vaw tlôpa kha.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chavâta tahmâ he chapaw hawti zydua kha thie khai u la, chapaw a ziakhei ta, a pahnopathei hapa chanô zydua chhao thie khai teh u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chapaw a ziakhei beih leipa nata a pahno pathei beih leipa chanô hawti zydua deikua cha, namâ pahlôh aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Riehmo khôtho lâ noh sari a rie aw ei chi ta, ahy rai chyhsa a thiepa nata ama thiepa a hriapa maih, nâmo chhao, nama seizy chhao, noh thôhna noh nata noh sarina noh ta namâ pathaisa aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chysia to, savo ta taopa hmo to, mie hmi ta taopa hmo zydua nata tho ta taopa hmo zydua nama pathaisa khai aw,” tah ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Theihthaipa Eliaza ta adyuhna lâ a siepa pheisaihzy hnohta, “He he Abeipa ta Mawsi hnohta bie a piepa ryhpa bieraopa a châ:
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngôh, tâkâ, dawh, thua, râhvâ nata ky zy,
  </para>
  <para style="p">
    <verse number="23" style="v" />mei ta a parao thei leipa maih cha, mei liata pasiesa aw ei chi ta, chatanachata a vaw pathaih aw. Cha thota pathaisana ti ta pathaisa pâ awpa a châ. Mei ta a parao theipazy deikua cha, ti liata nama pasiesa aw.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noh sarina noh ta nama chysiazy pasu aw ei chi ta, chatanachata nama pathaih ha aw. Cha khai tawhta riehmo lâ namâ ngia thei aw,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abeipa ta Mawsi chho ta,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nâ nata theihthaipa Eliaza nata zawpi hry tawhta chipho hyutuhpazy ta hraona sôh lapazy reih u la, chyhsapa chhao, sahroh chhao, reih khai teh u.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hraona sôhzy cha adyuhna lâ a siepa pheisaihzy nata zawpi zydua rai awpa ta su no ta nama pachhaih aw.
  </para>
  <para style="p">
    <verse number="28" style="v" />Adyuhna lâ a siepa pheisaihzy tawhta Abeipa châta thyuna khei aw ei chi ta, za pangawh liata miakha lymâ ta, chyhsapazy, viahchaozy, alâzy, mietakuzy nama khei aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nama kheipa khophie cha Abeipa tovyuh châ ta, theihthaipa Eliaza hnohta nama pie aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Izarei sawzy ta khophie ama topa tawhta, sypangawh liata miakha lymâ ta, chyhsapazy, viahchaozy, alâzy, mietakuzy, miezy nata sahroh zydua khei aw ei chi ta, Abeipa achhyna byureih mohôhtuhpa Livai chizy nama pie aw,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Abeipa ta Mawsi bie a piepa hawhta, Mawsi nata theihthaipa Eliaza ta tao ei ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pheisaihzy ta amâ lapa hraona sôh rei leipa ta, zawpi ta amâ lapa hraona sôh zydua cha, mietaku 675,000,
  </para>
  <para style="p">
    <verse number="33" style="v" />viahchao 72,000,
  </para>
  <para style="p">
    <verse number="34" style="v" />alâ 61,000 nata
  </para>
  <para style="p">
    <verse number="35" style="v" />chyhsa 32,000 a châ. Chyhsazy cha chapaw a ziakhei beih leipa nata a pahnopathei beih leipa chanôzy ama châ.
  </para>
  <para style="p">
    <verse number="36" style="v" />Adyuhna lâ a siepazy tovyuh awpa hraona sôh khophie liata mietaku 337,500 y ta,
  </para>
  <para style="p">
    <verse number="37" style="v" />cha tawhta Abeipa râhpaw cha mietaku 675 a châ.
  </para>
  <para style="p">
    <verse number="38" style="v" />Viahchao 36,000 y ta, cha tawhta Abeipa râhpaw cha viahchao 72 a châ.
  </para>
  <para style="p">
    <verse number="39" style="v" />Alâ 30,500 y ta, cha tawhta Abeipa râhpaw cha alâ 61 a châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chyhsapa 16,000 y ei ta, cha tawhta Abeipa râhpaw cha 32 ama châ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Abeipa ta Mawsi bie a piepa hawhta, Abeipa châta thyupa râhpaw cha, Mawsi ta theihthaipa Eliaza hnohta a pie.
  </para>
  <para style="p">
    <verse number="42" style="v" />Cha hawhna chata Mawsi ta hraona sôhzy cha, adyuhna lâ siepa pheisaihzy nata zawpizy châta khophie ta pachhaih ta, zawpi tovyuh cha,
  </para>
  <para style="p">
    <verse number="43" style="v" />mietaku 337,500,
  </para>
  <para style="p">
    <verse number="44" style="v" />viahchao 36,000,
  </para>
  <para style="p">
    <verse number="45" style="v" />alâ 30,500 nata
  </para>
  <para style="p">
    <verse number="46" style="v" />chyhsapa 16,000 a châ.
  </para>
  <para style="p">
    <verse number="47" style="v" />Abeipa ta Mawsi bie a piepa hawhta, Izarei sawzy ta khophie ama topa tawhta, Mawsi ta chyhsapa nata sahrohzy tawhta, sypangawh liata miakha lymâ ta la ta, Abeipa achhyna byureih mohôhtuhpa Livai chizy hnohta a pie ei.
  </para>
  <para style="p">
    <verse number="48" style="v" />Pheisaih sâh hluhpi chô liata hyutuhpazy, sâh kha hyutuhpazy nata za kha hyutuhpazy ta Mawsi a kei hnia ei ta,
  </para>
  <para style="p">
    <verse number="49" style="v" />Mawsi hnohta, “Châ chakaotuhpazy ta eima biehneina ry liata a ypa pheisaihzy maluh reih pi ta, eima hry liata pakha hmah a ki leipa y veih ei.
  </para>
  <para style="p">
    <verse number="50" style="v" />Tahmâ he eima hmôpa chyu tawhta, Abeipa châta eima thyuna ngôh hmobaohzy, karuzy, lâkyuzy, moh chahnaona kusadizy, rahyzy, pachhihzy cha eimâ chatlaina châta Abeipa hmiakô liata eima vaw cheih,” tah ei ta.
  </para>
  <para style="p">
    <verse number="51" style="v" />Mawsi nata theihthaipa Eliaza ta ngôh ta daipa hmobaoh zydua cha âmo tawhta a hlâh ei ta.
  </para>
  <para style="p">
    <verse number="52" style="v" />A sâh chô liata hyutuhpazy nata a za chô liata hyutuhpazy ta Abeipa lâta ngôh ama vaw hlâpa zydua cha sekel 16,750 a châ.
  </para>
  <para style="p">
    <verse number="53" style="v" />Pheisaihzy ta hraona sôh cha âmo châ chyu ta amâ vaw la hapa a châ.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chatanachata Mawsi nata theihthaipa Eliaza ta a sâh chô liata hyutuhpazy nata a za chô liata hyutuhpazy tawhta ngôh cha a hlâh ei ta, Izarei sawzy ta Abeipa hmiakô liata amâ thei thlâh ha nawpa ta, ahmaohna poh o chhôh liata a ngiakhei ei ta.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rubena nata Kâdâ pathlazy cha sahroh hluhpi hnei ei ta. Zaze râh nata Kilia râh hmô ei ta. A su cha sahroh châta su pha ngaitapa châ ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kâdâ pathlazy nata Rubena pathlazy ta Mawsi nata theihthaipa Eliaza nata zawpi chhituhpazy hnohta,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Atarô, Dibô, Zaze, Nimrâ, Hesbaw, Eliale, Sebâ, Nebô nata Biô râhzy cha,
  </para>
  <para style="p">
    <verse number="4" style="v" />Izarei zawpi hmiakô liata Abeipa ta a panawhpa râh, sahroh châta a pha ngaitapa râh a châ. Châ chakaotuhpazy he sahroh hnei pi ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chavâta na mo eimâ dy khiahta cha, Zawdâh miah chakasa leipa la, ngiachhiepa ta he râh he eima pahrâ nawpa ta miah pie mah y,” tah ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mawsi ta Kâdâ pathlazy nata Rubena pathlazy hnohta, “He liata nâmo a tyuh aw ei chi ta ma, nama unawhzy adyuhna lâ ama sie aw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Khazia Abeipa ta âmo a piepa râh liata a ngia lei awpa ta Izarei sawzy palôh nama padua aw?
  </para>
  <para style="p">
    <verse number="8" style="v" />Châ pathlatuhpazy chhao ta, râh moh awpa ta Kâdesbânia tawhta ei tua no ei ta, cha hawhta ama tao hra.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eskaw saikao ama tlô nahta, râh cha hmô ei ta, Abeipa piepa râh liata amâ ngia lei nawpa ta, Izarei sawzy palôh padua ei ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cha noh liata, Abeipa cha a pathi ia ta, chhie sa ta,
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Izi râh tawhta a kaw puapa, kô kih tawhta chô lâ chyhsazy cha, palôh tlokhuh ta eina zi leipa vâ ei ta, ahy hmah Abarahâ, Aisika nata Zakaw zy hnohta pie awpa ta bie ei taihpa râh hmô aw veih ei.
  </para>
  <para style="p">
    <verse number="12" style="v" />Keni chi Zephune sawchapawpa Kâlebâ nata Nunâ sawchapawpa Zawsua deikua cha, palôh tlokhuh ta Abeipa ama zipa vâta ama hmô aw,’ tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abeipa cha Izarei chô liata a pathi ia ta, chavâta Abeipa mohmô ta hmo pha leipa a taotuhpa chhâ zydua ama leidia khai hlâlei, râhchawhpa liata kô sypalih chhôh a paviavisa ei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Châ pathlatuhpazy kha moleipa pathlazy châ ei ta, nâmo chhao âmo su a thlapa ta, Izarei chô liata Abeipa pathiiana chichhihpa nama baichha via rili he zaw!
  </para>
  <para style="p">
    <verse number="15" style="v" />Abeipa pazina tawhta nama tleisai khiahta cha, Abeipa ta zawpizy he râhchawhpa liata siesai heih aw ta, he chyhsa zydua he nâmo ta nama pahleipadia khaipa a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kâdâ pathlazy nata Rubena pathlazy ta Mawsi cha a kei hnia ei ta, a hnohta, “He liata eima sahroh châta mietaku sadôzy nata eima sawzy châta khihpizy eima padua aw.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keimo deikua cha, chariah chhaichhizy a tobi aw pi ta, Izarei sawzy ama pahrâ nawpa su eima tlôkhei hlâlei cha, ama hmia lâta eima sie aw. He râh liata a pahrâpa chyhsazy vâta, eima sawzy cha, thokhy ta dôhpa khihpizy liata ama pahrâ aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izarei saw zydua ta ama ryuto râh ama to khai hlâlei eima o lâ a vaw lie aw ma pi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zawdâh hesâ nochhi lâ liana heta eima to awpa râh a ypa vâta, keimo cha Izarei sawzy hnohta Zawdâh haosâ nata a khô lâ râh to hra aw ma pi,” tah ei ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mawsi ta ama hnohta, “Cha hawhta tao u la, chariah chhaichhi a tobipa ta Abeipa hmiakô ta adyuhna lâ sie teh u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chariah chhaichhi a tobipa maihta a chariahpazy a hmiakô tawhta papuapa a châ hlâlei cha, Abeipa hmiakô liata Zawdâh haosâ lâ y mawh sy.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abeipa hmiakô liata râh nama la khai hlâlei namâ dyuh aw. Cha khai tawhta a vaw lie aw ei chi ta, Abeipa chô liata nata Izarei chô liata nama maophaohna nama chô liata y khao aw vei. Chatanachata he râh he Abeipa hmiakô liata nama ryuto râh a châ aw.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cha hawhta nama tao leipa khiahta deikua cha, pachâ teh u, Abeipa chô liata moleipa châ aw ei chi ta, nama moleina ta a cha hmô papua aw ei tahpa pahno muh vy.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nama sawzy châta khihpizy cha padua u la, nama mietakuzy châta sadôzy chhao cha tao u la, bie namâ taihpa hawhta tao teh u,” tah ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kâdâ pathlazy nata Rubena pathlazy ta Mawsi hnohta, “Châ chakaotuhpazy heta eima zibeipa biepiepa hawhta eima tao aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Eima sawzy, eima lapinôzy, eima mietaku zawzy nata eima viahchao hri zydua Kilia khihpizy liata vaw y aw ei ta,
  </para>
  <para style="p">
    <verse number="27" style="v" />châ chakaotuhpazy deikua pi cha, eima zibeipa biepiepa hawhta, Zawdâh chaka aw pi ta, chariah chhaichhi a tobipa maihta Zawdâh cha Abeipa hmiakô liata eima chaka aw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chatanachata Mawsi ta Kâdâ nata Rubena pathlazy kyh liata, theihthaipa Eliaza nata Nunâ sawchapawpa Zawsua nata Izarei chi chhôhkha pawhrâhpazy biepie ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mawsi ta ama hnohta, “Kâdâ pathla nata Rubena pathla, chariah chhaichhi a tobipa maih Abeipa hmiakô liata nama hnohta Zawdâh chaka hra aw ei ta, râh cha pahniepa a châ khiahta cha, Kilia râh he âmo ryuto châta nama pie aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chariah chhaichhi a tobipa ta nama hnohta ama chaka hra vei khiahta deikua cha, Kâna râh liata nama hry liata ryuto ama hnei hra aw,” tah ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kâdâ pathlazy nata Rubena pathlazy ta, “ Abeipa ta châ chakaotuhpazy hnohta a reipa hawhta eima tao aw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chariah chhaichhi a tobipa ta, Abeipa hmiakô liata Zawdâh cha chaka aw pi ta, Kâna râh liata eimâ ngia aw. Râh eima to awpa deikua cha Zawdâh hesâ lâ he a châ aw,” tahpa ta a chhy ei ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chatanachata Mawsi ta Kâdâ pathlazy, Rubena pathlazy nata Zawsi sawchapawpa Manase pathla khophiezy hnohta Amawri bei Sihaw khinarâh nata Bâsanâ bei Ôkâ khinarâhzy cha, a khihpizy, khihpi râhzy nata a chheipâh râh khihpizy chhaota a pie ei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kâdâ pathlazy ta Dibô, Atarô, Arôe,
  </para>
  <para style="p">
    <verse number="35" style="v" />Atarôsôpha, Zaze, Zôbehâ,
  </para>
  <para style="p">
    <verse number="36" style="v" />Benirâ nata Beharâ khihpizy ama padua. Chazy cha thokhy nata mietaku sadô a hneipa khihpizy a châ.
  </para>
  <para style="p">
    <verse number="37" style="v" />Rubena pathlazy ta Hesbaw, Eliale, Kiriathai,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nebô, Bâlâmeô nata Sibmâ khihpizy padua ei ta, khihpi ama paduapa thokha mohzy cha pananopa ta moh hropa ama bi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Manase chi Mâkhi pathlazy ta Kilia râh siehnao ei ta, râh cha la ei ta, cha liata a pahrâpa Amawri mo papua ei ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mawsi ta Kilia râh cha Manase chi Mâkhi pathlazy pie ta, cha liata ama pahrâ.
  </para>
  <para style="p">
    <verse number="41" style="v" />Manase pathla Zairâ ta cha râh liata khitawzy siehnao ta, la ta, a moh Havôzairâ a bi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nôbâ ta Kenathâ khihpi nata a khichapeihzy siehnao ta, la ta, ano moh pachyuhpa ta Nôbâ a bi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezy he Izarei sawzy ta Izi râh ama puasai nota, Mawsi nata Arawna chhihthana ry liata a chhâh chhâh ta nata a py py ta ama siena su mohzy a châ.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abeipa biepie hawhta, Mawsi ta a chhâh chhâh ta ama siena su mohzy cha roh ta, hezy he a chhâh chhâh ta ama siena su mohzy cha a châ.
  </para>
  <para style="p">
    <verse number="3" style="v" />Izarei sawzy cha thla khana liata Râmese tawhta pua ei ta. Thla khana, noh hrawh hleipangawhna noh, Zawpakhô noh mylâ ta, Izarei sawzy cha Izi mo zydua mohmô liata hmiakai kawpa ta ama pua.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izi mo ta Abeipa ta ama sawchapaw uhtheipa a thie khai hapazy ama pabu hai nota, Izarei sawzy cha pua ei ta. Abeipa ta Izi mo khazohzy chô liata chhao hriena a patlôsa ha hra.
  </para>
  <para style="p">
    <verse number="5" style="v" />Izarei sawzy cha Râmese tawhta pua ei ta, Sukô liata riehmo paryh ei ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sukô tawhta pua ei ta, râhchawhpa tytuapa Ethamâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ethamâ tawhta pua ei ta, Bâlâzephô nochhi lâta a ypa Pihahirô lâ kua ei ta, Mikadô kiapâh liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pihahirô tawhta pua ei ta, tilaipi liah liata siepahliepa ta râhchawhpa lâ a ngia ei ta, Ethamâ râhchawhpa liata noh thôh sie ei ta, Marâh liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Marâh tawhta pua ei ta, tihnawh hnawh hrawh hleino nata thiahrâ kô kô sysari yna Elima tlô ei ta, cha liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Elima tawhta pua ei ta, Tilaipi Saihpa kiapâh liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tilaipi Saihpa tawhta pua ei ta, Sini râhchawhpa liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sini râhchawhpa tawhta pua ei ta, Dôpakâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dôpakâ tawhta pua ei ta, Alusa liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alusa tawhta pua ei ta, Rephidi liata riehmo ama paryh. Cha cha zawpi do awpa ti y leina su kha a châ.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rephidi tawhta pua ei ta, Sinai râhchawhpa liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sinai râhchawhpa tawhta pua ei ta, Kibarôhâtavâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kibarôhâtavâ tawhta pua ei ta, Hazerô liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hazerô tawhta pua ei ta, Rithamâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rithamâ tawhta pua ei ta, Rimôpere liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rimôpere tawhta pua ei ta, Libnâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Libnâ tawhta pua ei ta, Risâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Risâ tawhta pua ei ta, Kehelathâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kehelathâ tawhta pua ei ta, Sephe Tlâh liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sephe Tlâh tawhta pua ei ta, Hâradâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hâradâ tawhta pua ei ta, Mâkhelô liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mâkhelô tawhta pua ei ta, Tahâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahâ tawhta pua ei ta, Terâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Terâ tawhta pua ei ta, Mithakâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mithakâ tawhta pua ei ta, Hasmônâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hasmônâ tawhta pua ei ta, Môserô liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Môserô tawhta pua ei ta, Benezakâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Benezakâ tawhta pua ei ta, Hôhakikâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hôhakikâ tawhta pua ei ta, Zôbathâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zôbathâ tawhta pua ei ta, Abarônah liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abarônah tawhta pua ei ta, Eziôkebe liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eziôkebe tawhta pua ei ta, Zini râhchawhpa liata riehmo ama paryh. Cha cha Kâdesâ tahpa a châ hra.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kâdesâ tawhta pua ei ta, Edômâ râh pai liata Hôri Tlâh liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Theihthaipa Arawna cha Abeipa biepiepa hawhta, Hôri Tlâh lâ kiah ta, Izarei sawzy Izi râh tawhta ama kaw pua tawhta kô sypalihna, thla pangawhna, noh khana noh ta, cha liata a thi haw.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hôri Tlâh liata a thi nota Arawna cha kô 123 uhtheipa a châ.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kâna râh Neke liata a ypa, Kâna chyhsa Aradâ bei ta, Izarei sawzy ama vaw tlôpa thei ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />Izarei sawzy cha Hôri Tlâh tawhta pua ei ta, Zalmônâ liata riehmo paryh ei ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zalmônâ tawhta pua ei ta, Punô liata riehmo ama paryh heih.
  </para>
  <para style="p">
    <verse number="43" style="v" />Punô tawhta pua ei ta, Ôbô liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ôbô tawhta pua ei ta, Môabâ râh Iziabari liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Iziabari tawhta pua ei ta, Dibôkadâ liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dibôkadâ tawhta pua ei ta, Almawdibalâthai liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Almawdibalâthai tawhta pua ei ta, Nebô kiapâh liata Abari tlâhzy liata riehmo ama paryh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Abari tlâhzy tawhta pua ei ta, Zerikô dady Zawdâh kiah liata Môabâ bypi liata riehmo paryh ei ta,
  </para>
  <para style="p">
    <verse number="49" style="v" />Zawdâh kiah Bezesimô tawhta Abesiti taihta Môabâ bypi liata riehmozy ama paryh lymâ.
  </para>
  <para style="p">
    <verse number="50" style="v" />Zerikô dady Zawdâh kiah Môabâ bypi liata, Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="51" style="v" />“Izarei sawzy chho la, ama hnohta, ‘Zawdâh chakapa ta Kâna râh namâ ngia tita,
  </para>
  <para style="p">
    <verse number="52" style="v" />a râh chyhsa zydua nama hmiakô tawhta nama papua khai awpa a châ. Ama lô nothlahpa zydua parao khai aw ei chi ta, ama thua nothlah leihpa zydua chhao parao khai aw ei chi ta, ama su sâhpa zydua nama phie khai aw.
  </para>
  <para style="p">
    <verse number="53" style="v" />Râh cha hnei aw ei chi ta, cha liata nama pahrâ aw. Cha râh cha hnei awpa ta ei cha piepa ei a châ.
  </para>
  <para style="p">
    <verse number="54" style="v" />A pho pho ta nuby a dao aw ei chi ta, râh cha ryuto châta namâ rai aw. Chi lai viapazy cha ryuto râh lai via pie aw ei chi ta, chi chyh viapazy cha ryuto râh chyh via nama pie aw. Nuby ta a tlupa hawhta ama tovyuh a châ lymâ aw. Ryuto râh cha châ pathlatuhpazy chi yzie lymâ hawhta nama to awpa a châ.
  </para>
  <para style="p">
    <verse number="55" style="v" />A râh liata a pahrâpazy nama hmiakô tawhta nama papua khai vei khiahta deikua cha, nama paysapazy cha nama mo liata mobâ hawhta châ aw ei ta, nama kâ liata ahloh hawhta cha chho aw ei ta, nama pahrâna râh liata châ patypamâtuhpazy ama châ lymâ aw.
  </para>
  <para style="p">
    <verse number="56" style="v" />Ama chô liata tao awpa ei pachâpa cha, nama chô liata ei tao aw,’ tah mah y,” tah ta.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy chho la, ama hnohta hetana heta biepie teh: Kâna râh nama tlô tita, nama ryuto râh a châ awpa Kâna râhri cha he hawhta a châ aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chho lâta Zini râhchawhpa tawhta Edômâ râh a ripa ta sie aw ta, chho lâta nama râhri cha Tilaipi Iahpa chhâna tawhta nochhi lâta a sie aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nama râhri cha Akarâbi lâ kiana chho lâ chhâh ta pako aw ta, Zini lâ sie aw ta, Kâdesbânia chho lâta pua aw ta, Hâzarâdy chapiapa ta, Azmaw lâta a sie aw.
  </para>
  <para style="p">
    <verse number="5" style="v" />Râhri cha Azmaw tawhta Izi Chavah lâ pako aw ta, tilaipi liata a chhâ aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Notla lâ cha Tilaipi Kawhpa taih châ aw ta, cha cha notla lâta nama râhri a châ aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />“He he Maw lâta nama râhri a châ aw: Tilaipi Kawhpa tawhta Hôri Tlâh lâta sie aw ta,
  </para>
  <para style="p">
    <verse number="8" style="v" />Hôri Tlâh tawhta Lebô-hâmâ lâ sie aw ta, Zedâ liata a chhâ aw.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cha tawhna chata râhri cha Ziparaw lâta sie aw ta, Hâzarenâ liata a chhâ aw. Cha cha maw lâta nama râhri a châ aw.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Nochhi lâta nama râhri cha Hâzarenâ tawhta Sephe taih a châ aw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Râhri cha Sephe tawhta Aina nochhi lâta Riblâ taih a zu aw. Râhri cha zu lymâ aw ta, Chinere Tipo nochhi lâ tlôna taihta a sie aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cha tawhna chata râhri cha Zawdâh lâta zu aw ta, Tilaipi Iahpa liata a chhâ aw. Cha râhri pakhâhpazy chhôh cha nama râh a châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mawsi ta Izarei sawzy biepie ta, ama hnohta, “Cha râh cha Abeipa ta chi chaki nata chi khophiepa pie awpa ta bie a piepa, nuby a daopa ta nama to awpa ryuto râh a châ.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rubena pathla nata Kâdâ pathla chizy deikua cha a chhôh chhôh ta ryuto râh to ha ei ta, Manase chi khophie chhao ama to ha hra.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chi nopazy nata chi khophie cha, ama ryuto râh châta Zerikô dady ta a ypa Zawdâh haosâ, nochhi baih lâta râhzy ama to haw,” tah ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abeipa ta Mawsi hnohta,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Hezy he ryu ta nama to awpa râh châ rai awpa chyhsazy moh a châ: Theihthaipa Eliaza nata Nunâ sawchapawpa Zawsua ta ryuto râh cha ama cha rai aw.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ryuto râh raina liata âmo bao awpa ta, chi to tawhta chhituhpa pakha chyu nama rao aw.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cha chyhsazy moh cha, Zudâh chi tawhta Zephune sawchapaw Kâlebâ;
  </para>
  <para style="p">
    <verse number="20" style="v" />Simeôna chi tawhta Amihu sawchapaw Samuela;
  </para>
  <para style="p">
    <verse number="21" style="v" />Benzami chi tawhta Kislaw sawchapaw Eliadâ;
  </para>
  <para style="p">
    <verse number="22" style="v" />Dânâ chi tawhta Zôkali sawchapaw Buki;
  </para>
  <para style="p">
    <verse number="23" style="v" />Zawsi pathla Manase chi tawhta chhituhpa pakha, Ephô sawchapaw Hânie;
  </para>
  <para style="p">
    <verse number="24" style="v" />Epharai chi tawhta chhituhpa pakha, Siphatâ sawchapaw Kemua;
  </para>
  <para style="p">
    <verse number="25" style="v" />Zebulawna chi tawhta chhituhpa pakha, Pânâ sawchapaw Elizaphâ;
  </para>
  <para style="p">
    <verse number="26" style="v" />Iskâra chi tawhta chhituhpa pakha, Azani sawchapaw Pâtie;
  </para>
  <para style="p">
    <verse number="27" style="v" />Asera chi tawhta chhituhpa pakha, Selômi sawchapaw Ahihu nata
  </para>
  <para style="p">
    <verse number="28" style="v" />Nâthalai chi tawhta chhituhpa pakha, Amihu sawchapaw Pedahe zy ama châ aw,” tah ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Âmo cha Kâna râh liata Izarei sawzy ryuto râh rai awpa ta Abeipa ta bie a piepazy ama châ.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zerikô dady Zawdâh kiapâh Môabâ bypi liata Abeipa ta Mawsi bie a chho ta, a hnohta,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Izarei sawzy hnohta, ryuto râh ama hneipa tawhta Livai chi pahrâ nawpa khihpizy châta râh a chhaih awpa ta biepie teh. Khihpizy chaby liata sibiepa suzy chhao sahroh pasana châta nama pie pâ aw.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khihpizy cha ama pahrâ nawpa châta châ aw ta, sibiepa suzy cha ama viahchao, ama sahroh nata ama sa zydua châta a châ aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Livai chi na pie awpa sibiepa suzy cha khihpi thokhy tawhta dy sâh kha a kawh awpa a châ.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khihpi cha a liah liata sopa ta, khihpi thokhy tawhta thlie aw chi ta, nochhi lâta dy sâh no, chho lâta dy sâh no, notla lâta dy sâh no, maw lâta dy sâh no a châ aw.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Livai chi nama pie awpa khihpizy hry liata khihpi miacharupazy cha abohna khihpizy châ aw ta, lianycheihpazy a râ nawpa khihpizy a châ aw. Cha khihpizy thota khihpi sypalih nata miano nama baichha aw.
  </para>
  <para style="p">
    <verse number="7" style="v" />Livai chi nama pie awpa khihpi zydua cha, ama sibiepa suzy chhaota, khihpi sypalih nata miacharie a châ aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Izarei sawzy nama pie awpa ryuto râhzy tawhta, ama ryuto râh lai nata chyh mopa ta, chi lai viapazy tawhta râh lai via la aw ei chi ta, chi chyh viapazy tawhta râh chyh via la aw ei chi ta, Livai chi hnohta khihpizy ama pie chyu aw,” tah ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abeipa ta Mawsi bie a chho ta, a hnohta,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Izarei sawzy chho la, ama hnohta hetana heta reih teh: Zawdâh chakapa ta Kâna râh namâ ngia tita,
  </para>
  <para style="p">
    <verse number="11" style="v" />chyhsa a thie tlamawpa lianycheihpa a râ nawpa ta, khihpi thokha cha abohna khihpizy ta nama rao aw.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lianycheihtuhpa cha a thâtih pachia awpa ta zawpi hmia liata â duah hlâta a thi lei nawpa ta, cha khihpizy cha phuh latuhpazy tawhta namâ bohna a châ aw.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khihpi nama pie awpazy tawhta abohna khihpi miacharu nama rao aw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawdâh haosâ lâ khih thôh rao aw ei chi ta, Kâna râh liata khih thôh châ aw ta, chazy cha abohna khihpizy a châ aw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cha khihpi miacharupazy cha, Izarei sawzy châta abohna khihpizy châ aw ei ta, chihropa nata ama hnohta a pahrâpazy châta abohna khihpizy châ hra aw ta, chyhsa a thie tlamawpa maihta amâ râ nawpa khihpizy a châ aw.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Thua chhaichhi hmâpa ta chyhsa phy sala, cha chyhsa cha a thi khiahta deikua cha, liany a cheihpa châ ta, lianycheihtuhpa cha thie thlyu awpa a châ.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chyhsa thi theina alô chhaichhi hmâpa ta chyhsa phy sala, cha chyhsa cha a thi khiahta cha, liany a cheihpa châ ta, lianycheihtuhpa cha thie thlyu awpa a châ.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chyhsa thi theina tho chhaichhi hmâpa ta phy sala, cha chyhsa cha a thi khiahta cha, liany a cheihpa châ ta, lianycheihtuhpa cha thie thlyu awpa a châ.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thisaih phuh latuhpa ta lianycheihtuhpa cha a thie awpa châ ta, a hmô tita a thie aw.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Chyhsa ta ahaona vâta chyhsa chatitha sala tlyma, a byhkhâhpa ta khâpa tlyma ta vawh sala tlyma, cha chyhsa cha a thi khiahta tlyma,
  </para>
  <para style="p">
    <verse number="21" style="v" />cha leipa chhao ta, ahaona vâta a ku ta a chôpa ta, cha chyhsa cha a thi khiahta tlyma, kupathlatuhpa cha thie thlyu awpa a châ. Liany a cheihpa châ ta, thisaih phuh latuhpa ta a hmô tita a thie aw.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Châhrasala ahaona vâta châ leipa ta, chatitha tlamawpa vâta tlyma, a byhkhâh leipa ta khâpa tlyma ta vawh tlamawpa vâta tlyma,
  </para>
  <para style="p">
    <verse number="23" style="v" />hmô leipa ta, chyhsa thi theina alô pathla thlu tlamawpa vâta tlyma, cha chyhsa cha thi sala, a chariahpa châ leipa sala, pasasa â chhuahpa a châ vei khiahta cha,
  </para>
  <para style="p">
    <verse number="24" style="v" />he ryhpazy he hmâpa ta, lianycheihtuhpa nata thisaih phuh latuhpa likah liata zawpi ta ama pachiapa aw.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zawpizy ta lianycheihtuhpa cha thisaih phuh latuhpa ku tawhta pachha aw ei ta, a boh awpa ta â râna, â bohna khihpi liata ama paysa aw. Sathaw pathaihpa ta sathawthupa theihthai beichaipa a thi hlâlei, cha liata a y thlâh ha awpa a châ.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khatino rai ta, lianycheihtuhpa ta â râna abohna khihpi râhri khô lâ pua sala,
  </para>
  <para style="p">
    <verse number="27" style="v" />thisaih phuh latuhpa ta ano cha abohna khihpi râhri khô lâta hmô sala, thisaih phuh latuhpa ta lianycheihtuhpa cha a thie khiahta deikua cha, thisaih phuh latuhpa chô liata thisaih maoh y aw vei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Liahnycheihtuhpa cha, theihthai beichaipa a thi hlâlei abohna khihpi liata pahrâ aw ta, theihthai beichaipa a thi tawhta deikua cha, a ryuto râh lâ â lie thei aw.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Cha hmozy cha, nama pahrâna su zydua liata nama chhâ zydua châta bieraopa nata pachianazy a châ aw.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chyhsa ta chyhsa a thie khiahta cha, pahnotuhpazy pakah tawhta bie a puapa ta thie awpa a châ. Châhrasala pahnotuhpa pakha bie dei ta chyhsa ahy hmah thie awpa châ vei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cha dei châ vei, liahnycheihtuhpa chatlaina sôh nama la awpa châ vei. Thina taihta thailei a châpa châ ta, thie thlyu awpa a châ.
  </para>
  <para style="p">
    <verse number="32" style="v" />Abohna khihpi lâ a râpa châta chhao, theihthai beichaipa a thi hlâta a râh lâ â lie thei nawpa ta chatlaina sôh nama lapa awpa châ vei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nama pahrâna râh nama papuapalei awpa châ vei. Thisaih ta râh papuapalei ta, thisaih palotuhpa thisaih dei leipa ta cha, khâpa chatlaina ta hmah râh chô liata thisaih palo thlupa cha pathaisa thei vei.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kei Abeipa he Izarei sawzy hry liata pahrâ tlôh na ta, chavâta nama hnohta ei yna râh, nama pahrâna râh he nama papuapalei awpa châ vei,” tah ta.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zawsi sawchapawpa Manase chi Mâkhi pathla Kilia pho hyutuhpazy a vaw hnia ei ta, Mawsi nata Izarei pathla chhituhpazy hmiakô liata bie reih ei ta,
  </para>
  <para style="p">
    <verse number="2" style="v" />ama hnohta, “ Abeipa ta ei zibeipa hnohta, nuby padaosapa ta Izarei sawzy ama ryuto râh pie awpa ta bie cha pie ta, eima unawhpa Zelôphehâ ryuto râh chhao a sawchanôzy hnohta pie awpa ta Abeipa ta ei zibeipa hnohta bie a cha pie hra.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cha chanôzy chata Izarei chihropa sawchapawzy ama hnei khiahta deikua cha, ama ryuto râh cha miah pathlatuhpazy ryuto râh tawhta lapa châ aw ta, ama dyhchâna chi ryuto râh liata pahlyhpa a châ aw. Chatanachata eima ryuto râh châta nuby eimâ daopa eima pahlei aw.
  </para>
  <para style="p">
    <verse number="4" style="v" />Izarei sawzy zubili kô a vaw tlô tita, Zelôphehâ sawchanôzy ryuto râh cha, ama dyhchâna chi ryuto râh liata pahlyhpa a châ aw. Ama ryuto râh cha lapa châ aw ta, miah pathlatuhpazy ryuto râh cha pachhaihpa a châ aw,” tah ei ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mawsi ta Abeipa bie hawhta Izarei sawzy cha piepa ta, ama hnohta, “Zawsi pathla chi bie reipa he bie dopa a châ.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zelôphehâ sawchanôzy kyh liata Abeipa biepiepa cha hetana heta a châ: ‘Ama kho chaipazy hnei aw ei ta, anodeikua ama paw chi pho liata chapawzy ama hnei awpa a châ.
  </para>
  <para style="p">
    <verse number="7" style="v" />Izarei sawzy ryuto cha chi kha tawhta chihropa lâ pasie awpa châ vei. Izarei saw zydua ta ama pathlatuhpa chi ryuto râh ama hnei pazao lymâ aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Izarei saw ahy rai ta a pathlatuhpazy ryuto râh a hnei lymâ thei nawpa ta, Izarei chizy liata ryuto râh a hneipa sawchanô maih cha, a paw chi nata pho chyhsa lapinô a châ awpa a châ.
  </para>
  <para style="p">
    <verse number="9" style="v" />Izarei chi ryuto râh cha, chihropa lâ â pasie awpa châ vei. Izarei saw chi to ta ama ryuto râh chyu ama hnei lymâ awpa a châ’” tah ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abeipa ta Mawsi bie a piepa hawhta, Zelôphehâ sawchanôzy ta tao ei ta,
  </para>
  <para style="p">
    <verse number="11" style="v" />Mâhlâ, Tizah, Hôkalâ, Milkâ nata Nôah zy ta ama paw unawhzy sawchapawzy cha vahpa ta ama hnei chyu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zawsi sawchapaw Manase pathlazy cha vahpa ta hnei ei ta, chatanachata ama ryuto râhzy cha ama paw chi nata pho ryuto râh ta a y lymâ.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chazy cha Abeipa ta Mawsi hmâpa ta Zerikô dady Zawdâh haosâ Môabâ bypi liata Izarei sawzy hnohta a piepa biepiepazy nata ryhpazy a châ.
  </para>
</usx>
