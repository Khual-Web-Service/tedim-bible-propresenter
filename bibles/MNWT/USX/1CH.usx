<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">၁ ရာဇဝင်ချုပ်</book>
  <para style="h">၁ ရာဇဝင်ချုပ်</para>
  <para style="toc1">၁ ရာဇဝင်ချုပ်</para>
  <para style="toc2">၁ ရာဇဝင်ချုပ်</para>
  <para style="mt">၁ ရာဇဝင်ချုပ်</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />အာဒံ၊ ရှေသ၊ ဧနုတ်၊
  </para>
  <para style="p">
    <verse number="2" style="v" />ကေနန်၊ မဟာလေလ၊ ယာရက်၊
  </para>
  <para style="p">
    <verse number="3" style="v" />ဧနောက်၊ မသုရှလ၊ လာမက်၊
  </para>
  <para style="p">
    <verse number="4" style="v" />နောဧ၊ ရှေမ၊ ဟာမ၊ ယာဖက်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ယာဖက်ရဲ့သားတွေက ဂေါမာ၊ မာဂေါဂ၊ မာဒဲ၊ ယာဝန်၊ တုဗလ၊ မာရှက်၊ တိရတ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဂေါမာရဲ့သားတွေက အာရှကေနတ်၊ ရိဖတ်၊ တောဂါမ။
  </para>
  <para style="p">
    <verse number="7" style="v" />ယာဝန်ရဲ့သားတွေက ဧလိရှ၊ တာရှိ၊ ခိတိမ်၊ ရောဒနိမ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဟာမရဲ့သားတွေက ကုရှ၊ မိဇရိမ်၊ ဖုတ၊ ခါနန်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ကုရှရဲ့သားတွေက သေဘ၊ ဟဝိလ၊ သာဗတ၊ ယာဂမ၊ သတေခါ။ ယာဂမရဲ့သားတွေက ရှေဘနဲ့ ဒေဒန်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ကုရှရဲ့သားက နိမ်ရောဒ။ သူဟာ ကမ္ဘာပေါ်မှာ ဦးဆုံးပေါ်လာတဲ့ အစွမ်းခွန်အားကြီးသူပဲ။
  </para>
  <para style="p">
    <verse number="11" style="v" />မိဇရိမ်ရဲ့ သားတွေက လုဒိမ်၊ အာနမိမ်၊ လဟာဗိမ်၊ နတုဟိမ်၊
  </para>
  <para style="p">
    <verse number="12" style="v" />ပါသရုသိမ်၊ ကာသလုဟိမ်၊ ကတ္တောရိမ်။ (ကာသလုဟိမ်ကနေ ဖိလိတိလူမျိုး ဆင်းသက်လာတယ်။)
  </para>
  <para style="p">
    <verse number="13" style="v" />ခါနန်ရဲ့ သားတွေက သားဦးဆိုင်ဒုန်နဲ့ ဟေသ။
  </para>
  <para style="p">
    <verse number="14" style="v" />ခါနန်ဟာ ယေဗုသိ၊ အာမောရိ၊ ဂိရဂါရှိ၊
  </para>
  <para style="p">
    <verse number="15" style="v" />ဟိဝိ၊ အာကိ၊ သိနိ၊
  </para>
  <para style="p">
    <verse number="16" style="v" />အာဝဒိ၊ ဇေမရိ၊ ဟာမသိလူတွေရဲ့ ဘိုးဘေးပဲ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ရှေမရဲ့သားတွေက ဧလံ၊ အာရှုရ၊ အာဖာဇဒ်၊ လုဒ၊ အာရံ။ ပြီးတော့ ဥဇ၊ ဟုလ၊ ဂေသာ၊ မာရှ။
  </para>
  <para style="p">
    <verse number="18" style="v" />အာဖာဇဒ်ရဲ့သားက ရှေလ။ ရှေလရဲ့သားက ဧဗာ။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဧဗာမှာ သားနှစ်ယောက် ရှိတယ်။ တစ်ယောက်က ဖာလက်။ သူ့လက်ထက်ရောက်တော့ ကမ္ဘာပေါ်မှာ လူတွေကွဲလွင့်သွားလို့ အဲဒီနာမည်ကို ရခဲ့တယ်။ နောက်တစ်ယောက်ကတော့ ယုတ္တန်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ယုတ္တန်ရဲ့သားတွေက အာလမောဒန်၊ ရှေလပ်၊ ဟာဇာမာဝက်၊ ယေရ၊
  </para>
  <para style="p">
    <verse number="21" style="v" />ဟဒေါရံ၊ ဥဇလ၊ ဒိကလ၊
  </para>
  <para style="p">
    <verse number="22" style="v" />ဩဗာလ၊ အဘိမေလ၊ ရှေဘ၊
  </para>
  <para style="p">
    <verse number="23" style="v" />သြဖိရ၊ ဟဝိလ၊ ယောဗပ်။ သူတို့အားလုံးဟာ ယုတ္တန်ရဲ့သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="24" style="v" />ရှေမ၊ အာဖာဇဒ်၊ ရှေလ၊
  </para>
  <para style="p">
    <verse number="25" style="v" />ဧဗာ၊ ဖာလက်၊ ရာဂေါ၊
  </para>
  <para style="p">
    <verse number="26" style="v" />စေရတ်၊ နာခေါ်၊ တေရ၊
  </para>
  <para style="p">
    <verse number="27" style="v" />အာဗြဟံလို့ခေါ်တဲ့ အာဗြံ။
  </para>
  <para style="p">
    <verse number="28" style="v" />အာဗြဟံရဲ့သားတွေက အိဇက်နဲ့ အိရှမေလ။
  </para>
  <para style="p">
    <verse number="29" style="v" />မျိုးနွယ်စုအလိုက် သူတို့ကနေ ဆင်းသက်လာသူတွေကတော့ အိရှမေလရဲ့ သားဦး နဗာယုတ်၊ ကေဒါ၊ အာဒဗေလ၊ မိဗသံ၊
  </para>
  <para style="p">
    <verse number="30" style="v" />မိရှမ၊ ဒုမာ၊ မာစ၊ ဟာဒဒ်၊ တေမ၊
  </para>
  <para style="p">
    <verse number="31" style="v" />ယေတုရ၊ နာဖိရှ၊ ကေဒမာ။ အဲဒီ ၁၂ ယောက်ဟာ အိရှမေလရဲ့ သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="32" style="v" />အာဗြဟံရဲ့မယားငယ် ကေတုရမွေးတဲ့သားတွေက ဇိမရံ၊ ယုတ်ရှန်၊ မေဒန်၊ မိဒျန်၊ အိရှဘတ်၊ ရှုအာ။ ယုတ်ရှန်ရဲ့သားတွေက ရှေဘနဲ့ ဒေဒန်။
  </para>
  <para style="p">
    <verse number="33" style="v" />မိဒျန်ရဲ့သားတွေက ဧဖာ၊ ဧဖေရ၊ ဟာနုတ်၊ အဘိဒ၊ ဧလဒါ။ သူတို့အားလုံးဟာ ကေတုရရဲ့သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="34" style="v" />အာဗြဟံက သားအိဇက်ကို ရတယ်။ အိဇက်ရဲ့သားတွေက ဧသောနဲ့ အစ္စရေး။
  </para>
  <para style="p">
    <verse number="35" style="v" />ဧသောရဲ့သားတွေက ဧလိဖတ်၊ ရွေလ၊ ယုရှ၊ ယာလံ၊ ကောရ။
  </para>
  <para style="p">
    <verse number="36" style="v" />ဧလိဖတ်ရဲ့သားတွေက တေမန်၊ ဩမရ၊ ဇေဖော၊ ဂါတံ၊ ကေနတ်။ ပြီးတော့ တိမနနဲ့ရတဲ့သား အာမလက်။
  </para>
  <para style="p">
    <verse number="37" style="v" />ရွေလရဲ့သားတွေက နာဟတ်၊ ဇေရ၊ ရှမ္မာ၊ မိဇာ။
  </para>
  <para style="p">
    <verse number="38" style="v" />စိရရဲ့သားတွေက လောတန်၊ ရှောဗလ၊ ဇိဘောင်၊ အာန၊ ဒိရှုန်၊ ဧဇာ၊ ဒိရှန်။
  </para>
  <para style="p">
    <verse number="39" style="v" />လောတန်ရဲ့သားတွေက ဟောရိနဲ့ ဟောမံ။ လောတန်ရဲ့နှမက တိမန။
  </para>
  <para style="p">
    <verse number="40" style="v" />ရှောဗလရဲ့သားတွေက အာလဝန်၊ မနာဟတ်၊ ဧဗလ၊ ရှေဖော၊ ဩနိမ်။ ဇိဘောင်ရဲ့သားတွေက အာယနဲ့ အာန။
  </para>
  <para style="p">
    <verse number="41" style="v" />အာနရဲ့သားတစ်ယောက်က ဒိရှုန်။ ဒိရှုန်ရဲ့သားတွေက ဟင်ဒန်၊ ဧရှဗန်၊ အိသရန်၊ ခေရန်။
  </para>
  <para style="p">
    <verse number="42" style="v" />ဧဇာရဲ့သားတွေက ဗိလဟန်၊ ဇာဝန်၊ အာကန်။ ဒိရှန်ရဲ့သားတွေက ဥဇနဲ့ အာရန်။
  </para>
  <para style="p">
    <verse number="43" style="v" />အစ္စရေးလူမျိုးကို ဘုရင်တစ်ပါးမှ မအုပ်စိုးခင် ဧဒုံပြည်ကို အုပ်စိုးတဲ့ ဘုရင်တွေကတော့- ဗောရရဲ့သား ဗေလက ဒင်နဗာမြို့မှာ နန်းထိုင်တယ်။
  </para>
  <para style="p">
    <verse number="44" style="v" />ဗေလမင်း ကွယ်လွန်တော့ ဗောဇရမြို့က ဇေရရဲ့သား ယောဗပ် နန်းတက်တယ်။
  </para>
  <para style="p">
    <verse number="45" style="v" />ယောဗပ်မင်း ကွယ်လွန်တော့ တေမန်နယ်သား ဟုရှံ နန်းတက်တယ်။
  </para>
  <para style="p">
    <verse number="46" style="v" />ဟုရှံမင်း ကွယ်လွန်တော့ ဗေဒဒ်ရဲ့သား ဟာဒဒ် နန်းတက်တယ်။ မြို့တော်က အာဝိတ်မြို့။ ဟာဒဒ်က မောဘပြည်မှာ မိဒျန်လူမျိုးတွေကို အနိုင်ရခဲ့သူဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="47" style="v" />ဟာဒဒ်မင်း ကွယ်လွန်တော့ မာသရက်အရပ်သား စာမလ နန်းတက်တယ်။
  </para>
  <para style="p">
    <verse number="48" style="v" />စာမလမင်း ကွယ်လွန်တော့ ရဟောဘုတ်မြို့သား ရှောလ နန်းတက်တယ်။ အဲဒီမြို့က မြစ်နားမှာ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="49" style="v" />ရှောလမင်း ကွယ်လွန်တော့ အာခဗော်ရဲ့သား ဗာလဟာနန် နန်းတက်တယ်။
  </para>
  <para style="p">
    <verse number="50" style="v" />ဗာလဟာနန်မင်း ကွယ်လွန်တော့ ဟာဒဒ် နန်းတက်တယ်။ မြို့တော်က ပေါမြို့ပဲ။ မိဖုရားက မေဇဟပ်ရဲ့မြေး၊ မာတရေဒရဲ့သမီး မဟေတဗေလလို့ ခေါ်တယ်။
  </para>
  <para style="p">
    <verse number="51" style="v" />နောက်တော့ ဟာဒဒ်မင်း ကွယ်လွန်သွားတယ်။ ဧဒုံစော်ဘွားတွေကတော့ စော်ဘွားတိမန၊ စော်ဘွားအာလဝ၊ စော်ဘွားယေသက်၊
  </para>
  <para style="p">
    <verse number="52" style="v" />စော်ဘွားအဟောလိဗာမ၊ စော်ဘွားဧလာ၊ စော်ဘွားပိနုန်၊
  </para>
  <para style="p">
    <verse number="53" style="v" />စော်ဘွားကေနတ်၊ စော်ဘွားတေမန်၊ စော်ဘွားမိဗဇာ၊
  </para>
  <para style="p">
    <verse number="54" style="v" />စော်ဘွားမာဂဒေလနဲ့ စော်ဘွားအိရံ။ သူတို့ဟာ ဧဒုံစော်ဘွားတွေပဲ။
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />အစ္စရေးရဲ့သားတွေက ရုဗင်၊ ရှိမောင်၊ လေဝိ၊ ယုဒ၊ အိသခါ၊ ဇာဗုလုန်၊
  </para>
  <para style="p">
    <verse number="2" style="v" />ဒန်၊ ယောသပ်၊ ဗင်ယာမိန်၊ နဿလိ၊ ဂဒ်၊ အာရှာ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ယုဒရဲ့သားတွေက ဧရ၊ ဩနန်၊ ရှေလ။ သူတို့သုံးယောက်ဟာ ရှုအရဲ့သမီးဖြစ်သူ ခါနန်အမျိုးသမီးနဲ့ရတဲ့ သားတွေပဲ။ ယေဟောဝါက ယုဒရဲ့သားဦး ဧရကို မနှစ်သက်လို့ အဆုံးစီရင်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ချွေးမတာမာနဲ့ရတဲ့ ယုဒရဲ့သားတွေက ဖာရက်နဲ့ ဇေရ။ ယုဒမှာ စုစုပေါင်း သားငါးယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဖာရက်ရဲ့သားတွေက ဟေဇရုံနဲ့ ဟာမုလ။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဇေရရဲ့သားတွေက ဇိမရိ၊ ဧသန်၊ ဟေမန်၊ ခါလကောလ၊ ဒါရ။ စုစုပေါင်း ငါးယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ကာမိရဲ့သားတစ်ယောက်က အာခါ လို့ခေါ်တယ်။ အာခါဟာ အစ္စရေးလူမျိုးအပေါ် ဘေးဒုက္ခရောက်စေတဲ့သူ၊ ဖျက်ဆီးပစ်ရမယ့်အရာနဲ့ပတ်သက်တဲ့ အမိန့်ကို မနာခံတဲ့သူပဲ။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဧသန်ရဲ့သားတစ်ယောက်က အာဇရိ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဟေဇရုံရဲ့သားတွေက ယေရမေလ၊ ရာမ၊ ကာလုဘိုင်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ရာမရဲ့သားက အမိနဒပ်။ အမိနဒပ်ရဲ့သားက ယုဒအနွယ်ရဲ့ မျိုးနွယ်စုခေါင်းဆောင် နာရှုန်။
  </para>
  <para style="p">
    <verse number="11" style="v" />နာရှုန်ရဲ့ သားက စာလမာ။ စာလမာရဲ့သားက ဗောဇ။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဗောဇရဲ့သားက ဩဗက်။ သြဗက်ရဲ့သားက ယေရှဲ။
  </para>
  <para style="p">
    <verse number="13" style="v" />ယေရှဲရဲ့ သားတွေက သားဦး ဧလျာဘ၊ ဒုတိယသား အဘိနဒပ်၊ တတိယသား ရှိမ၊
  </para>
  <para style="p">
    <verse number="14" style="v" />စတုတ္ထသား နာသနေလ၊ ပဉ္စမသား ရဒဲ၊
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆဋ္ဌမသား သြဇင်၊ သတ္တမသား ဒါဝိဒ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />သူတို့ရဲ့ နှမတွေက ဇေရုယာနဲ့ အဘိဂဲလ။ ဇေရုယာရဲ့ သားသုံးယောက်က အဘိရှဲ၊ ယွာဘ၊ အာသဟေလ။
  </para>
  <para style="p">
    <verse number="17" style="v" />အဘိဂဲလရဲ့သားက အာမသ၊ အာမသရဲ့အဖေက အိရှမေလအမျိုးသား ယေသာလို့ခေါ်တယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဟေဇရုံရဲ့သား ကာလက်က အဇုဘနဲ့ လက်ထပ်ပြီး သားတွေရတယ်။ ယေရုတ်နဲ့လည်း သားတွေရတယ်။ အဇုဘရဲ့သားတွေက ယေရှာ၊ ရှောဗပ်၊ အာဒုန်။
  </para>
  <para style="p">
    <verse number="19" style="v" />အဇုဘ သေဆုံးတော့ ကာလက်က ဧဖရတ်နဲ့ လက်ထပ်ပြီး သားဟုရကို ရတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဟုရရဲ့သားက ဥရိ။ ဥရိရဲ့သားက ဗေဇလေလ။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဟေဇရုံက အသက် ၆၀ အရွယ်မှာ မာခိရ ရဲ့သမီးနဲ့ လက်ထပ်ပြီး သားစေဂုပ်ကို ရတယ်။ မာခိရဟာ ဂိလဒ်ရဲ့အဖေပဲ။
  </para>
  <para style="p">
    <verse number="22" style="v" />စေဂုပ်ရဲ့သားက ယာအိရ။ ယာအိရက ဂိလဒ်ပြည်မှာ မြို့ ၂၃ မြို့ ပိုင်တယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သူတို့ဟာ ဂိလဒ်အဖေ မာခိရရဲ့ သားမြေးတွေပဲ။ နောက်ပိုင်းမှာ ဂေရှုရိလူတွေနဲ့ ဆီးရီးယားလူတွေက ဟာဝုတ်ယာအိရ ကျေးရွာတွေ၊ ကေနတ်မြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ မြို့ပေါင်း ၆၀ ကို သူတို့ဆီကနေ သိမ်းပိုက်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ကာလက်ဧဖရတ်သာအရပ်မှာ ဟေဇရုံ သေဆုံးပြီးနောက် သူ့ဇနီးအဘိယက သားအာရှုရကို မွေးတယ်။ အာရှုရက တေကောရဲ့ဖခင် ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဟေဇရုံရဲ့ သားဦး ယေရမေလရဲ့ သားတွေက သားဦးရာမ၊ ဗုန၊ ဩရင်၊ သြဇင်၊ အဟိယ။
  </para>
  <para style="p">
    <verse number="26" style="v" />ယေရမေလမှာ အာတရလို့ခေါ်တဲ့ ဇနီးတစ်ယောက် ရှိသေးတယ်။ သူနဲ့ရတဲ့သားက ဩနိမ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ယေရမေလရဲ့သားဦး ရာမရဲ့သားတွေက မာဇ၊ ယာမိန်၊ ဧကာ။
  </para>
  <para style="p">
    <verse number="28" style="v" />သြနိမ်ရဲ့သားတွေက ရှမဲနဲ့ ယာဒ။ ရှမဲရဲ့သားတွေက နာဒပ်နဲ့ အဘိရှုရ။
  </para>
  <para style="p">
    <verse number="29" style="v" />အဘိရှုရက အဘိဟဲလနဲ့လက်ထပ်ပြီး အာဗန်နဲ့ မောလိကို ရတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />နာဒပ်ရဲ့သားတွေက သေလက်နဲ့ အာပိမ်။ သေလက်က သားသမီးမရှိဘဲ သေဆုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />အာပိမ်ရဲ့သားတစ်ယောက်က အိရှိ၊ အိရှိရဲ့သားတစ်ယောက်က ရှေရှန်၊ ရှေရှန်ရဲ့မျိုးဆက်က အာလဲ။
  </para>
  <para style="p">
    <verse number="32" style="v" />ရှမဲရဲ့ညီ ယာဒရဲ့သားတွေက ယေသာနဲ့ ယောနသန်။ ယေသာက သားသမီးမရှိဘဲ သေဆုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="33" style="v" />ယောနသန်ရဲ့သားတွေက ပိလက်နဲ့ ဇာဇ။ သူတို့အားလုံးဟာ ယေရမေလရဲ့ သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="34" style="v" />ရှေရှန်ဆီမှာ သားမရှိဘူး၊ သမီးတွေပဲ ရှိတယ်။ ယာဟလို့ခေါ်တဲ့ အီဂျစ်ကျွန်တစ်ယောက်တော့ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="35" style="v" />ရှေရှန်က သူ့သမီးကို ကျွန်ယာဟနဲ့ ပေးစားလိုက်တဲ့အတွက် သမီးက သားအတ္တဲကို မွေးတယ်။
  </para>
  <para style="p">
    <verse number="36" style="v" />အတ္တဲရဲ့သားက နာသန်။ နာသန်ရဲ့သားက ဇာဗဒ်။
  </para>
  <para style="p">
    <verse number="37" style="v" />ဇာဗဒ်ရဲ့သားက ဧဖလာ။ ဧဖလာရဲ့သားက ဩဗက်။
  </para>
  <para style="p">
    <verse number="38" style="v" />သြဗက်ရဲ့သားက ယေဟု။ ယေဟုရဲ့သားက အာဇရိ။
  </para>
  <para style="p">
    <verse number="39" style="v" />အာဇရိရဲ့သားက ဟေလက်။ ဟေလက်ရဲ့သားက ဧလာသ။
  </para>
  <para style="p">
    <verse number="40" style="v" />ဧလာသရဲ့သားက သိသမဲ။ သိသမဲရဲ့သားက ရှလုံ။
  </para>
  <para style="p">
    <verse number="41" style="v" />ရှလုံရဲ့သားက ယေကမိ။ ယေကမိရဲ့သားက ဧလိရှမာ။
  </para>
  <para style="p">
    <verse number="42" style="v" />ယေရမေလရဲ့ညီ ကာလက်ရဲ့သားတွေထဲမှာ သားဦးက မေရှ။ မေရှဟာ ဇိဖရဲ့ဖခင်ပဲ။ ဟေဗြုန်ရဲ့ဖခင် မရေရှရဲ့သားတွေလည်း ရှိတယ်။
  </para>
  <para style="p">
    <verse number="43" style="v" />ဟေဗြုန်ရဲ့သားတွေက ကောရ၊ တာပွာ၊ ရေကင်၊ ရှေမာ။
  </para>
  <para style="p">
    <verse number="44" style="v" />ရှေမာရဲ့သားက ရာဟံ။ ရာဟံက ယောကင်ရဲ့ဖခင်ပဲ။ ရေကင်ရဲ့သားက ရှမဲ။
  </para>
  <para style="p">
    <verse number="45" style="v" />ရှမဲရဲ့သားက မောန။ မောနဟာ ဗက်ဇုရရဲ့ဖခင်ပဲ။
  </para>
  <para style="p">
    <verse number="46" style="v" />ကာလက်ရဲ့မယားငယ် ဧဖာက ခါရန်၊ မောဇ၊ ဂါဇက်တို့ကို မွေးတယ်။ ခါရန်ရဲ့သားက ဂါဇက်။
  </para>
  <para style="p">
    <verse number="47" style="v" />ယာဒဲရဲ့သားတွေက ရေဂင်၊ ယောသံ၊ ဂေရှံ၊ ပေလက်၊ ဧဖာ၊ ရှာဖ။
  </para>
  <para style="p">
    <verse number="48" style="v" />ကာလက်ရဲ့မယားငယ် မာခါက ရှေဗာနဲ့ တိရဟာနကို မွေးတယ်။
  </para>
  <para style="p">
    <verse number="49" style="v" />နောက်ပိုင်းမှာ မာခါက ရှာဖကိုမွေးတယ်။ ရှာဖက မာဒမေနရဲ့ဖခင်ပဲ။ မာခါက ရှိဘကိုလည်း မွေးတယ်။ ရှိဘက မာခဗေနနဲ့ ဂိဗာရဲ့ ဖခင်ပဲ။ ကာလက်ရဲ့ သမီးက အာခသလို့ခေါ်တယ်။
  </para>
  <para style="p">
    <verse number="50" style="v" />သူတို့အားလုံးဟာ ကာလက်ရဲ့သားမြေးတွေပဲ။ ဧဖရတ်သာရဲ့သားဦး ဟုရရဲ့သားတွေက ကိရယတ်ယာရိမ်ရဲ့ဖခင် ရှောဗလ၊
  </para>
  <para style="p">
    <verse number="51" style="v" />ဘက်သလီဟင်ရဲ့ဖခင် စာလမာနဲ့ ဗက်ဂါဒါရဲ့ဖခင် ဟာရပ်တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="52" style="v" />ကိရယတ်ယာရိမ်ရဲ့ဖခင် ရှောဗလရဲ့ သားမြေးတွေက ဟာရောနဲ့ မနဟေသိအမျိုးတစ်ဝက်ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="53" style="v" />ကိရယတ်ယာရိမ်မြို့မှာ နေထိုင်တဲ့ ဆွေမျိုးစုတွေက အိသရိ၊ ဖုဟိ၊ ရှုမသိနဲ့ မိရှရိဆွေမျိုးစုတွေ ဖြစ်တယ်။ သူတို့ဆီကနေ ဇောရာသိဆွေမျိုးစုနဲ့ ဧရှတောလိဆွေမျိုးစု ဆင်းသက်လာတယ်။
  </para>
  <para style="p">
    <verse number="54" style="v" />ဘက်သလီဟင်မြို့၊ နေတောဖရွာ၊ အတရုတ်ဗက်ယွာဘမြို့နဲ့ ဇောရာမြို့မှာ နေထိုင်သူတွေအပြင် မနာဟတ်အမျိုးတစ်ဝက်ကလည်း စာလမာရဲ့ သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="55" style="v" />တိရသိ၊ ရှိမသိနဲ့ စုခသိဆွေမျိုးစုတွေဟာ ယာဗက်မြို့မှာ နေထိုင်တဲ့ စာရေးတွေ ဖြစ်တယ်။ သူတို့ဟာ ရေခပ်အမျိုးရဲ့ အဖေ ဟာမတ်ကနေ ဆင်းသက်လာတဲ့ ကေနိတ်လူမျိုးတွေပဲ။
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဟေဗြုန်မြို့မှာ ဒါဝိဒ်ရတဲ့သားတွေက သားဦးအာမနုန်၊ သူ့မိခင်က ယေဇရေလမြို့သူ အဟိနောင်။ ဒုတိယသား ဒံယေလ၊ သူ့မိခင်က ကရမေလမြို့သူ အဘိဂဲလ။
  </para>
  <para style="p">
    <verse number="2" style="v" />တတိယသား အဗရှလုံ၊ သူ့မိခင်က ဂေရှုရိဘုရင် တာလမဲရဲ့သမီး မာခါ။ စတုတ္ထသား အဒေါနိယ၊ သူ့မိခင်က ဟဂိတ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ပဉ္စမသား ရှေဖတိ၊ သူ့မိခင်က အဘိတလ။ ဆဋ္ဌမသား အိသရံ၊ သူ့မိခင်က ဧဂလာ။
  </para>
  <para style="p">
    <verse number="4" style="v" />အဲဒီသားခြောက်ယောက်ကို ဟေဗြုန်မြို့မှာ ရတယ်။ ဒါဝိဒ်က ဟေဗြုန်မြို့မှာ ၇ နှစ်နဲ့ ၆ လ၊ ဂျေရုဆလင်မြို့မှာ ၃၃ နှစ် နန်းစံတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဂျေရုဆလင်မြို့မှာ ဒါဝိဒ်ရတဲ့သားတွေက ရှိမ၊ ရှောဗပ်၊ နာသန်၊ ရှောလမုန်။ သူတို့လေးယောက်ရဲ့မိခင်က အမျေလရဲ့သမီး ဗာသရှေဘ။
  </para>
  <para style="p">
    <verse number="6" style="v" />နောက်ထပ် သားကိုးယောက်က အိဗဟာ၊ ဧလိရှမာ၊ ဧလိဖလက်၊
  </para>
  <para style="p">
    <verse number="7" style="v" />နောဂ၊ နေဖက်၊ ယာဖျာ၊
  </para>
  <para style="p">
    <verse number="8" style="v" />ဧလိရှမာ၊ ဧလျာဒ၊ ဧလိဖလက်။
  </para>
  <para style="p">
    <verse number="9" style="v" />သူတို့အားလုံးဟာ ဒါဝိဒ်ရဲ့သားတွေပဲ။ မောင်းမတွေနဲ့ရတဲ့ သားတွေလည်း ရှိသေးတယ်။ သူတို့ရဲ့နှမက တာမာ လို့ခေါ်တယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ရှောလမုန်ရဲ့သားက ရောဗောင်၊ ရောဗောင်ရဲ့သားက အဘိယ၊ အဘိယရဲ့သားက အာသ၊ အာသရဲ့သားက ယောရှဖတ်၊
  </para>
  <para style="p">
    <verse number="11" style="v" />ယောရှဖတ်ရဲ့သားက ယဟောရံ၊ ယဟောရံရဲ့သားက အာခဇိ၊ အာခဇိရဲ့သားက ယောရှ၊
  </para>
  <para style="p">
    <verse number="12" style="v" />ယောရှရဲ့သားက အာမဇိ၊ အာမဇိရဲ့သားက အာဇရိ၊ အာဇရိရဲ့သားက ယောသံ၊
  </para>
  <para style="p">
    <verse number="13" style="v" />ယောသံရဲ့သားက အာခတ်၊ အာခတ်ရဲ့သားက ဟေဇကိ၊ ဟေဇကိရဲ့သားက မနာရှေ၊
  </para>
  <para style="p">
    <verse number="14" style="v" />မနာရှေရဲ့သားက အာမုန်၊ အာမုန်ရဲ့သားက ယောရှိ။
  </para>
  <para style="p">
    <verse number="15" style="v" />ယောရှိရဲ့သားတွေက သားဦးယောဟနန်၊ ဒုတိယသား ယောယကိမ်၊ တတိယသား ဇေဒကိ၊ စတုတ္ထသား ရှလုံ။
  </para>
  <para style="p">
    <verse number="16" style="v" />ယောယကိမ်ရဲ့သားတစ်ယောက်က ယေခေါနိ၊ ယေခေါနိရဲ့သား ဇေဒကိ။
  </para>
  <para style="p">
    <verse number="17" style="v" />အကျဉ်းစံဘဝမှာ ယေခေါနိရတဲ့သားတွေက ရှာလသေလ၊
  </para>
  <para style="p">
    <verse number="18" style="v" />မာလခိရံ၊ ပေဒါယ၊ ရှေနဇာ၊ ယေကမိ၊ ဟောရှမ၊ နေဒဘိ။
  </para>
  <para style="p">
    <verse number="19" style="v" />ပေဒါယရဲ့သားတွေက ဇေရုဗဗေလနဲ့ ရှိမိ။ ဇေရုဗဗေလရဲ့သားတွေက မေရှုလံနဲ့ ဟာနနိ။ (သူတို့ရဲ့နှမက ရှေလောမိတ်။)
  </para>
  <para style="p">
    <verse number="20" style="v" />နောက်ထပ်သားငါးယောက်က ဟရှုဘ၊ သြဟေလ၊ ဗေရခိ၊ ဟသဒိ၊ ယုရှသေသက်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ဟာနနိရဲ့သားတွေက ပေလတိနဲ့ ယေရှာယ။ ယေရှာယရဲ့သားက ရေဖာယ၊ ရေဖာယရဲ့သားက အာနန်၊ အာနန်ရဲ့သားက သြဗဒိ၊ သြဗဒိရဲ့သားက ရှေခနိ။
  </para>
  <para style="p">
    <verse number="22" style="v" />ရှေခနိရဲ့သားက ရှေမာယ၊ ရှေမာယရဲ့သားတွေက ဟတ္တုတ်၊ အိဂါလ၊ ဗာရိ၊ နာရိ၊ ရှာဖတ်။ သားမြေးစုစုပေါင်း ခြောက်ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />နာရိရဲ့သားတွေက ဧလိသြနဲ၊ ဟေဇကဲ၊ အာဇရိကံ။ စုစုပေါင်း သုံးယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဧလိသြနဲရဲ့သားတွေက ဟောဒါယ၊ ဧလျာရှိပ်၊ ပေလာယ၊ အက္ကုပ်၊ ယောဟနန်၊ ဒလာယ၊ အာနိ။ စုစုပေါင်း ခုနစ်ယောက်ရှိတယ်။
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />ယုဒရဲ့သားတွေက ဖာရက်၊ ဟေဇရုံ၊ ကာမိ၊ ဟုရ၊ ရှောဗလ။
  </para>
  <para style="p">
    <verse number="2" style="v" />ရှောဗလရဲ့သားက ရာယ၊ ရာယရဲ့သားက ယာဟတ်၊ ယာဟတ်ရဲ့သားတွေက အဟုမဲနဲ့ လာဟဒ်။ သူတို့ဟာ ဇောရာသိဆွေမျိုးစုတွေပဲ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဧတံဖခင်ရဲ့ သားတွေက ယေဇရေလ၊ အိရှမ၊ အိဒဗတ်၊ (သူတို့ရဲ့နှမက ဟာဇလေလပေါနိ)၊
  </para>
  <para style="p">
    <verse number="4" style="v" />ဂေဒေါ်ရဲ့ဖခင် ပေနွေလ၊ ဟုရှရဲ့ဖခင် ဧဇာ။ သူတို့က ဧဖရတ်သာရဲ့သားဦး ဟုရရဲ့ သားမြေးတွေပဲ။ ဟုရဟာ ဘက်သလီဟင်ရဲ့ဖခင်လည်း ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />တေကောရဲ့ဖခင် အာရှုရမှာ ဟေလနဲ့ နာရလို့ခေါ်တဲ့ ဇနီးနှစ်ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />နာရရဲ့သားတွေက အဟုဇံ၊ ဟေဖာ၊ တေမနိ၊ ဟာဟရှတာရိ။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဟေလရဲ့သားတွေက ဇေရက်၊ အိဇဟာ၊ ဧသနန်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ကောဇရဲ့သားတွေက အာနုပ်နဲ့ ဇောဗေဒ။ ကောဇဟာ ဟာရုံရဲ့သား အဟာရေလဆွေမျိုးစုတွေရဲ့ ဘိုးဘေးပဲ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ယာဗက်ဟာ ညီအစ်ကိုတွေထက် ဂုဏ်သရေရှိသူ ဖြစ်တယ်။ သူ့မိခင်က “ဒီကလေးကို ဝေဒနာခံစားပြီး မွေးခဲ့ရတယ်” ဆိုပြီး ယာဗက် လို့နာမည်ပေးခဲ့တာ။
  </para>
  <para style="p">
    <verse number="10" style="v" />ယာဗက်က အစ္စရေးတို့ရဲ့ဘုရားသခင်ကို “ကျွန်တော့်ကို ကောင်းချီးပေးလှည့်ပါ။ ကျွန်တော့်ပိုင်နက်ကို ကျယ်ဝန်းစေပါ။ ကျွန်တော်နဲ့အတူ ရှိပြီး ဘေးဆိုးမကြုံရအောင် ကာကွယ်စောင့်ရှောက်ပေးပါ” လို့ဆုတောင်းတယ်။ သူတောင်းတဲ့အတိုင်း ဘုရားသခင် လုပ်ဆောင်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ရှုဟာရဲ့ညီ ခိလက်ရဲ့သားက မဟိရ၊ မဟိရရဲ့သားက ဧရှတုန်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဧရှတုန်က ဗက်ရာဖ၊ ပါသာ၊ တေဟိန်နရဲ့ဖခင်။ တေဟိန်နက အိရနာဟတ်ရဲ့ဖခင်။ သူတို့ဟာ ရေခါအရပ်သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="13" style="v" />ကေနတ်ရဲ့သားတွေက သြသံယေလနဲ့ စရာယ။ သြသံယေလရဲ့သားတစ်ယောက်က ဟာသတ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />သြဖရရဲ့ဖခင်က မောနောသဲ။ စရာယရဲ့သားက ယွာဘ။ ယွာဘဟာ ဂေဟရာရှိမ် ရဲ့ဖခင်ပဲ။ ဂေဟရာရှိမ်မှာ နေထိုင်သူတွေက လက်မှုပညာ ကျွမ်းကျင်သူတွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ယေဖုန်နာရဲ့သား ကာလက်မှာ အိရု၊ ဧလာ၊ နာမလို့ခေါ်တဲ့သားတွေ ရှိတယ်။ ဧလာရဲ့သားတစ်ယောက်က ကေနတ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ယေဟလလေလရဲ့သားတွေက ဇိဖ၊ ဇိဖာ၊ တိရိ၊ အာသရေလ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဧဇရာရဲ့သားတွေက ယေသာ၊ မေရက်၊ ဧဖေရ၊ ယာလုန်။ သူက မိရိအံနဲ့ ရှမဲကို မွေးဖွားတယ်။ ဧရှတမောရဲ့ဖခင် အိရှဘကိုလည်း မွေးဖွားတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />သူတို့ဟာ မေရက်ရဲ့ဇနီး၊ ဖာရောသမီး ဗိသယာရဲ့သားတွေဖြစ်တယ်။ (မေရက်ရဲ့ဇနီး ဂျူးအမျိုးသမီးက ဂေဒေါ်ရဲ့ဖခင် ယေရက်၊ စောခေါရဲ့ဖခင် ဟေဗာ၊ ဇာနော်ရဲ့ဖခင် ယေကုသေလတို့ကို မွေးဖွားတယ်။)
  </para>
  <para style="p">
    <verse number="19" style="v" />နာဟံရဲ့နှမ၊ ဟောဒိယဇနီးရဲ့ သားတွေက ကိလာရဲ့ဖခင်နဲ့ ဧရှတမောရဲ့ဖခင်။ ကိလာဆိုတာ ဂါမိလူတွေရဲ့မြို့၊ ဧရှတမောဆိုတာ မာခါသိပြည်သားတွေရဲ့ မြို့ပဲ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ရှိမုန်ရဲ့သားတွေက အာမနုန်၊ ရိန္န၊ ဗင်ဟာနန်၊ တိလုန်။ အိရှိရဲ့သားတွေက ဇောဟက်နဲ့ ဗင်ဇောဟက်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ယုဒရဲ့သားဖြစ်တဲ့ ရှေလရဲ့ သားတွေက လေကာရဲ့ဖခင် ဧရ၊ မရေရှရဲ့ဖခင် လာဒ။ ပိတ်ချောထည်ရက်တဲ့ အာရှဗာဆွေမျိုးစုတွေကလည်း ရှေလရဲ့သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="22" style="v" />ယာရှုဗိလင်၊ မောဘအမျိုးသမီးတွေနဲ့ အိမ်ထောင်ပြုကြတဲ့ ယောကိမ်၊ ခေါဇေဘအရပ်သားတွေ၊ ယောရှနဲ့ သာရပ်တို့လည်း ရှေလရဲ့သားမြေးတွေပဲ။ ဒါဟာ ရှေးခေတ်မှတ်တမ်းတွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သူတို့ဟာ အိုးထိန်းသမားတွေပဲ။ နတိမ်အရပ်နဲ့ ဂေဒရမြို့မှာနေထိုင်ပြီး ဘုရင့်အမှုတော်ကို ထမ်းဆောင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ရှိမောင်ရဲ့သားတွေက နေမွေလ၊ ယာမိန်၊ ယာရိပ်၊ ဇေရ၊ ရှောလ။
  </para>
  <para style="p">
    <verse number="25" style="v" />ရှောလရဲ့သားက ရှလုံ၊ ရှလုံရဲ့သားက မိဘသံ၊ မိဘသံရဲ့သားက မိရှမ၊
  </para>
  <para style="p">
    <verse number="26" style="v" />မိရှမရဲ့သားတွေက ဟမွေလ၊ ဟမွေလရဲ့သားက ဇက္ကုရ၊ ဇက္ကုရရဲ့သားက ရှိမိ။
  </para>
  <para style="p">
    <verse number="27" style="v" />ရှိမိမှာ သား ၁၆ ယောက်၊ သမီး ၆ ယောက်ရှိတယ်။ သူ့ညီအစ်ကိုတွေမှာတော့ သားသမီး သိပ်မရှိဘူး။ ယုဒအနွယ်လောက် သားသမီး မများဘူး။
  </para>
  <para style="p">
    <verse number="28" style="v" />သူတို့က ဗေရရှေဘ၊ မောလဒ၊ ဟာဇာရှုအာ၊
  </para>
  <para style="p">
    <verse number="29" style="v" />ဗိလဟာ၊ ဧဇင်၊ တောလဒ်၊
  </para>
  <para style="p">
    <verse number="30" style="v" />ဗေသွေလ၊ ဟောမာ၊ ဇိကလတ်၊
  </para>
  <para style="p">
    <verse number="31" style="v" />ဗက်မာကဗုတ်၊ ဟာဇာသုသိမ်၊ ဗက်ဗိရိနဲ့ ရှာရိမ်ဆိုတဲ့မြို့တွေမှာ နေထိုင်ကြတယ်။ ဒါဝိဒ်မင်းလက်ထက်အထိ အဲဒီမြို့တွေမှာ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="32" style="v" />သူတို့က ဧတံ၊ အအိန်၊ ရိမုန်၊ တောခင်၊ အာရှန်ဆိုတဲ့ မြို့ငါးမြို့နဲ့၊
  </para>
  <para style="p">
    <verse number="33" style="v" />ပတ်ဝန်းကျင်ကျေးရွာတွေအပြင် ဗာလမြို့အထိ နေထိုင်ကြတယ်။ ဒါဟာ သူတို့နေထိုင်တဲ့မြို့တွေနဲ့ ဆွေစဉ်မျိုးဆက်စာရင်းပဲ။
  </para>
  <para style="p">
    <verse number="34" style="v" />ရှိမောင်ရဲ့ နောက်ထပ်သားမြေးတွေက မေရှောဗပ်၊ ယာမလက်၊ အာမဇိရဲ့သား ယောရှာ၊
  </para>
  <para style="p">
    <verse number="35" style="v" />ယောလ၊ ယေဟု (ယေဟုရဲ့အဖေက ယောရှိဘ၊ ယောရှိဘရဲ့အဖေက စရာယ၊ စရာယရဲ့အဖေက အာသေလ)၊
  </para>
  <para style="p">
    <verse number="36" style="v" />ဧလိသြနဲ၊ ယာကောဘ၊ ယေရှောဟာယ၊ အသာယ၊ အဒေလ၊ ယေသိမေလ၊ ဗေနာယ၊
  </para>
  <para style="p">
    <verse number="37" style="v" />ဇိဇတို့ ဖြစ်တယ်။ (ဇိဇရဲ့အဖေက ရှိဖိ၊ ရှိဖိရဲ့အဖေက အယ်လုန်၊ အယ်လုန်ရဲ့အဖေက ယေဒါယ၊ ယေဒါယရဲ့အဖေက ရှိမရိ၊ ရှိမရိရဲ့အဖေက ရှေမာယ။)
  </para>
  <para style="p">
    <verse number="38" style="v" />နာမည်စာရင်းမှာပါတဲ့ အဲဒီလူတွေဟာ ဆွေမျိုးစုတွေထဲမှာ ခေါင်းဆောင်တွေပဲ။ သူတို့ဘိုးဘေးတွေရဲ့ ဆွေမျိုးစုတွေလည်း တိုးများလာတယ်။
  </para>
  <para style="p">
    <verse number="39" style="v" />သူတို့က သိုးအုပ်တွေအတွက် စားကျက်ရှာဖို့ ချိုင့်ဝှမ်းအရှေ့ဘက် ဂေဒေါ်မြို့ အဝင်လမ်းအထိ သွားကြတယ်။
  </para>
  <para style="p">
    <verse number="40" style="v" />နောက်ဆုံးတော့ စားကျက်ကောင်းကို တွေ့သွားတယ်။ ကျယ်ပြန့်ပြီး ငြိမ်းချမ်းသာယာတဲ့ပြည်ပဲ။ အရင်တုန်းက အဲဒီမှာ ဟာမအမျိုးသားတွေ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="41" style="v" />နာမည်စာရင်းမှာပါတဲ့ အဲဒီလူတွေက ယုဒဘုရင် ဟေဇကိလက်ထက်မှာ ရောက်လာပြီး ဟာမအမျိုးသားတွေရဲ့တဲတွေ၊ အဲဒီနယ်မြေမှာရှိတဲ့ မဟုနိမ်လူတွေကို အခုလို အစအနမကျန်အောင် ဖျက်ဆီးလိုက်တယ်။ ပြီးတော့ သိုးအုပ်တွေအတွက် စားကျက်မြေရှိတဲ့ အဲဒီနယ်မြေမှာ ဝင်ရောက်နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="42" style="v" />အိရှိရဲ့သားတွေဖြစ်တဲ့ ပေလတိ၊ နာရိ၊ ရေဖာယ၊ သြဇေလတို့က ရှိမောင်အမျိုးသား ၅၀၀ ကို ဦးဆောင်ပြီး စိရတောင်ကို သွားကြတယ်။
  </para>
  <para style="p">
    <verse number="43" style="v" />သူတို့က လွတ်မြောက်သွားတဲ့ အာမလက်လူမျိုး အကြွင်းအကျန်ကို ချေမှုန်းပြီး အဲဒီမှာနေထိုင်ကြတာ အခုချိန်အထိပဲ။
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />ရုဗင်ဟာ အစ္စရေးရဲ့သားဦးပဲ။ သူဟာ သားဦးဖြစ်ပေမဲ့ ဖခင်ရဲ့အိပ်ရာကို ညစ်ညူးစေခဲ့တဲ့အတွက် သားဦးအခွင့်အရေးကို အစ္စရေးရဲ့သားဖြစ်သူ ယောသပ်ရဲ့သားတွေ ရသွားတယ်။ ဒါကြောင့် ဆွေစဉ်မျိုးဆက်စာရင်းမှာ ရုဗင်ကို သားဦးအခွင့်အရေး ရသူအဖြစ် စာရင်းမသွင်းထားဘူး။
  </para>
  <para style="p">
    <verse number="2" style="v" />ယုဒက ညီအစ်ကိုတွေထက် သာလွန်ပြီး သူ့ဆီကနေ ခေါင်းဆောင် ပေါ်ထွက်လာမှာ ဖြစ်ပေမဲ့ သားဦးအခွင့်အရေးကိုတော့ ယောသပ်ပဲ ရတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အစ္စရေးရဲ့သားဦး ရုဗင်ရဲ့ သားတွေက ဟာနုတ်၊ ဖာလု၊ ဟေဇရုံ၊ ကာမိ။
  </para>
  <para style="p">
    <verse number="4" style="v" />ယောလရဲ့သားက ရှေမာယ၊ ရှေမာယရဲ့သားက ဂေါဂ၊ ဂေါဂရဲ့သားက ရှိမိ၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ရှိမိရဲ့သားက မိက္ခာ၊ မိက္ခာရဲ့သားက ရာယ၊ ရာယရဲ့သားက ဗာလ။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဗာလရဲ့သားက အဆီးရီးယားဘုရင် တိဂလတ်ပိနေသာ ဖမ်းခေါ်သွားတဲ့ ရုဗင်မျိုးနွယ်စုခေါင်းဆောင် ဗေရာဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဆွေမျိုးစုအလိုက် ဆွေစဉ်မျိုးဆက်စာရင်းဝင်တဲ့ ဗေရာရဲ့ညီအစ်ကိုတွေက ခေါင်းဆောင်ယေယေလ၊ ဇာခရိ၊
  </para>
  <para style="p">
    <verse number="8" style="v" />ယောလရဲ့မြစ်၊ ရှေမာရဲ့မြေး၊ အာဇတ်ရဲ့သား ဗေလဖြစ်တယ်။ သူတို့က အာရော်မြို့ကနေ နေဗောမြို့၊ ဗာလမုန်မြို့အထိ၊
  </para>
  <para style="p">
    <verse number="9" style="v" />အရှေ့ဘက် ယူဖရေးတီးမြစ်နားက တောကန္တာရအစပ်အထိ အခြေချနေထိုင်တယ်။ ဂိလဒ်ပြည်မှာ သူတို့ရဲ့တိရစ္ဆာန်တွေ တိုးများလာလို့ပဲ။
  </para>
  <para style="p">
    <verse number="10" style="v" />သူတို့က ရှောလုမင်းလက်ထက်မှာ ဟာဂရိလူမျိုးကို တိုက်ခိုက်အနိုင်ယူလိုက်တယ်။ ပြီးတော့ ဂိလဒ်ပြည်အရှေ့ဘက်နယ်မြေ တစ်လျှောက်လုံးက ဟာဂရိလူမျိုးရဲ့တဲတွေမှာ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဂဒ်ရဲ့သားမြေးတွေက ရုဗင်သားမြေးတွေရဲ့ နယ်မြေနဲ့ ကပ်လျက်မှာရှိတဲ့ ဗာရှန်ပြည် သာလကမြို့အထိ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဗာရှန်ပြည်မှာ ယောလက အကြီးအကဲ၊ ရှာဖံက လက်ထောက်၊ ယာနဲနဲ့ ရှာဖတ်လည်း ခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူတို့နဲ့ဆွေမျိုးတော်စပ်တဲ့ ညီအစ်ကိုတွေက မိက္ခေလ၊ မေရှုလံ၊ ရှေဘ၊ ယောရဲ၊ ယာခန်၊ ဇယာ၊ ဧဗာဖြစ်ပြီး စုစုပေါင်း ခုနစ်ယောက် ရှိတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />သူတို့ရဲ့ဖခင်က အဘိဟဲလ၊ အဘိဟဲလရဲ့ဖခင်က ဟုရိ၊ ဟုရိရဲ့ဖခင်က ယာရော်၊ ယာရော်ရဲ့ဖခင်က ဂိလဒ်၊ ဂိလဒ်ရဲ့ဖခင်က မိက္ခေလ၊ မိက္ခေလရဲ့ဖခင်က ယေရှိရှဲ၊ ယေရှိရှဲရဲ့ဖခင်က ယာဒေါ၊ ယာဒေါရဲ့ဖခင်က ဗုဇဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆွေမျိုးစုခေါင်းဆောင်ကတော့ ဂုနိရဲ့မြေး၊ အာဗဒျေလရဲ့သား အဟိဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />သူတို့က ဂိလဒ်ပြည်၊ ဗာရှန်ပြည်နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ ရှာရုန်စားကျက်မြေတစ်လျှောက်လုံးမှာ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />သူတို့အားလုံးဟာ ယုဒဘုရင် ယောသံနဲ့ အစ္စရေးဘုရင် ယေရောဗောင် လက်ထက်မှာ ပြုစုခဲ့တဲ့ ဆွေစဉ်မျိုးဆက်စာရင်းထဲမှာ ပါဝင်သူတွေပဲ။
  </para>
  <para style="p">
    <verse number="18" style="v" />ရုဗင်အနွယ်၊ ဂဒ်အနွယ်၊ မနာရှေအနွယ်တစ်ဝက်ရဲ့ စစ်တပ်မှာ စစ်ရေးကျွမ်းကျင်သူ၊ ဒိုင်းလွှား၊ ဓား၊ လေးကိုင်ဆောင်သူ ခွန်အားကြီး စစ်သည်အင်အား ၄၄,၇၆၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />သူတို့က ဟာဂရိလူမျိုး၊ ယေတုရ၊ နာဖိရှ၊ နောဒပ်အမျိုးသားတွေနဲ့ စစ်ဆင်နွှဲတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />အဲဒီလူတွေနဲ့ စစ်တိုက်တဲ့အခါ ဘုရားသခင်ကို အကူအညီတောင်းတဲ့အတွက် ဟာဂရိလူမျိုးနဲ့ မဟာမိတ်တွေကို အနိုင်ရခဲ့တယ်။ ဘုရားကို ယုံကြည်ကိုးစားတဲ့အတွက် သူတို့ အသနားခံတဲ့အတိုင်း ဘုရားလုပ်ဆောင်ပေးခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ရန်သူတွေရဲ့ ကုလားအုတ် ၅၀,၀၀၀၊ သိုး ၂၅၀,၀၀၀၊ မြည်း ၂,၀၀၀၊ လူ ၁၀၀,၀၀၀ ကို လက်ရဖမ်းမိတယ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />စစ်မှန်တဲ့ဘုရားသခင် ဆင်နွှဲတဲ့တိုက်ပွဲဖြစ်လို့ ရန်သူတွေ အတုံးအရုံး ကျဆုံးခဲ့တယ်။ သူတို့က ပြည်နှင်ဒဏ်ခံရချိန်အထိ အဲဒီမှာပဲ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />မနာရှေအနွယ်တစ်ဝက်ရဲ့ သားမြေးတွေဟာ လူဦးရေ သိပ်များတယ်။ ဗာရှန်ပြည်ကနေ ဗာလဟေရမုန်တောင်၊ စိနဲတောင်၊ ဟေရမုန်တောင်အထိ အနှံ့အပြား နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />သူတို့ရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေက ဧဖာ၊ အိရှိ၊ ဧလျလေ၊ အာဇရေလ၊ ယေရမိ၊ ဟောဒဝိ၊ ယာဒျေလတို့ဖြစ်ပြီး ခွန်အားကြီးစစ်သည်တွေ၊ နာမည်ကျော်ကြားသူတွေ၊ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="25" style="v" />သူတို့က ဘိုးဘေးတို့ရဲ့ ဘုရားသခင်ကို သစ္စာဖောက်ကြတယ်။ သူတို့ရှေ့ကနေ ဘုရားသခင် အစတုံး ဖျက်ဆီးခဲ့တဲ့ ပြည်သားတွေရဲ့ ဘုရားတွေကို ဝတ်ပြုကြတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဒါကြောင့် အစ္စရေးတို့ရဲ့ ဘုရားသခင်က အဆီးရီးယားဘုရင် (တိဂလတ်ပိနေသာ လို့ခေါ်တဲ့) ပုလရဲ့စိတ်ကို လှုံ့ဆော်လိုက်တဲ့အတွက် သူက ရုဗင်အနွယ်၊ ဂဒ်အနွယ်၊ မနာရှေအနွယ်တစ်ဝက်ကို ဖမ်းဆီးပြီး ဟာလအရပ်၊ ဟာဗော်အရပ်၊ ဟာရအရပ်၊ ဂေါဇန်မြစ်နားမှာ နေထိုင်စေတယ်။ ဒီနေ့အထိ အဲဒီမှာပဲ သူတို့နေထိုင်ရတယ်။
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />လေဝိရဲ့သားတွေက ဂေရရှုန်၊ ကောဟတ်၊ မေရာရိ။
  </para>
  <para style="p">
    <verse number="2" style="v" />ကောဟတ်ရဲ့သားတွေက အာမရံ၊ အိဇဟာ၊ ဟေဗြုန်၊ သြဇေလ။
  </para>
  <para style="p">
    <verse number="3" style="v" />အာမရံရဲ့သားတွေက အာရုန်နဲ့ မောရှေ၊ သမီးက မိရိအံ။ အာရုန်ရဲ့သားတွေက နာဒပ်၊ အဘိဟု၊ ဧလာဇာ၊ ဧသမာ။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဧလာဇာရဲ့သားက ဖိနဟတ်၊ ဖိနဟတ်ရဲ့သားက အဘိရွှ၊
  </para>
  <para style="p">
    <verse number="5" style="v" />အဘိရွှရဲ့သားက ဗုကိ၊ ဗုကိရဲ့သားက ဩဇေ၊
  </para>
  <para style="p">
    <verse number="6" style="v" />သြဇေရဲ့သားက ဇေရဟိ၊ ဇေရဟိရဲ့သားက မေရာယုတ်၊
  </para>
  <para style="p">
    <verse number="7" style="v" />မေရာယုတ်ရဲ့သားက အာမရိ၊ အာမရိရဲ့သားက အဟိတုပ်၊
  </para>
  <para style="p">
    <verse number="8" style="v" />အဟိတုပ်ရဲ့သားက ဇာဒုတ်၊ ဇာဒုတ်ရဲ့သားက အဟိမတ်၊
  </para>
  <para style="p">
    <verse number="9" style="v" />အဟိမတ်ရဲ့သားက အာဇရိ၊ အာဇရိရဲ့သားက ယောဟနန်၊
  </para>
  <para style="p">
    <verse number="10" style="v" />ယောဟနန်ရဲ့သားက အာဇရိ။ အာဇရိက ဂျေရုဆလင်မြို့၊ ရှောလမုန်တည်ဆောက်တဲ့ အိမ်တော်မှာ ပုရောဟိတ်အဖြစ် အမှုဆောင်တယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />အာဇရိရဲ့သားက အာမရိ၊ အာမရိရဲ့သားက အဟိတုပ်၊
  </para>
  <para style="p">
    <verse number="12" style="v" />အဟိတုပ်ရဲ့သားက ဇာဒုတ်၊ ဇာဒုတ်ရဲ့သားက ရှလုံ၊
  </para>
  <para style="p">
    <verse number="13" style="v" />ရှလုံရဲ့သားက ဟိလခိ၊ ဟိလခိရဲ့သားက အာဇရိ၊
  </para>
  <para style="p">
    <verse number="14" style="v" />အာဇရိရဲ့သားက စရာယ၊ စရာယရဲ့သားက ယောဇဒက်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ယေဟောဝါက နေဗုခဒ်နေဇာကိုသုံးပြီး ယုဒပြည်နဲ့ ဂျေရုဆလင်မြို့မှာရှိတဲ့ လူတွေကို ပြည်နှင်ဒဏ်ပေးတဲ့အခါ ယောဇဒက်လည်း ပါသွားတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />လေဝိရဲ့သားတွေက ဂေရရှုံ၊ ကောဟတ်၊ မေရာရိ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဂေရရှုံရဲ့သားတွေက လိဗနိနဲ့ ရှိမိ။
  </para>
  <para style="p">
    <verse number="18" style="v" />ကောဟတ်ရဲ့သားတွေက အာမရံ၊ အိဇဟာ၊ ဟေဗြုန်၊ သြဇေလ။
  </para>
  <para style="p">
    <verse number="19" style="v" />မေရာရိရဲ့သားတွေက မဟာလိနဲ့ မုရှိ။ လေဝိအနွယ်ရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေက–
  </para>
  <para style="p">
    <verse number="20" style="v" />ဂေရရှုံရဲ့ သားမြေးတွေထဲမှာ ဂေရရှုံရဲ့သား လိဗနိ၊ လိဗနိရဲ့သား ယာဟတ်၊ ယာဟတ်ရဲ့သား ဇိမ၊
  </para>
  <para style="p">
    <verse number="21" style="v" />ဇိမရဲ့သား ယောအာ၊ ယောအာရဲ့သား အိဒေါ၊ အိဒေါရဲ့သား ဇေရ၊ ဇေရရဲ့သား ယာတရဲ။
  </para>
  <para style="p">
    <verse number="22" style="v" />ကောဟတ်ရဲ့သားမြေးတွေထဲမှာ ကောဟတ်ရဲ့သား အမိနဒပ်၊ အမိနဒပ်ရဲ့သား ကောရ၊ ကောရရဲ့သားတွေဖြစ်တဲ့ အသိရ၊
  </para>
  <para style="p">
    <verse number="23" style="v" />ဧလကာနနဲ့ ဧဗျာသပ်၊ ဧဗျာသပ်ရဲ့သား အသိရ၊
  </para>
  <para style="p">
    <verse number="24" style="v" />အသိရရဲ့သား တာဟတ်၊ တာဟတ်ရဲ့သား ဥရေလ၊ ဥရေလရဲ့သား ဩဇိ၊ သြဇိရဲ့သား ရှောလ။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဧလကာနရဲ့သားတွေက အာမသဲနဲ့ အဟိမုတ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဧလကာနရဲ့ သားမြေးတွေက ဧလကာနရဲ့သား ဇောဖဲ၊ ဇောဖဲရဲ့သား နာဟတ်၊
  </para>
  <para style="p">
    <verse number="27" style="v" />နာဟတ်ရဲ့သား ဧလျာဘ၊ ဧလျာဘရဲ့သား ယေရောဟံ၊ ယေရောဟံရဲ့သား ဧလကာန။
  </para>
  <para style="p">
    <verse number="28" style="v" />ရှမွေလရဲ့ သားတွေက သားဦးယောလ၊ ဒုတိယသား အဘိယ။
  </para>
  <para style="p">
    <verse number="29" style="v" />မေရာရိရဲ့ သားမြေးတွေထဲမှာ မေရာရိရဲ့သား မဟာလိ၊ မဟာလိရဲ့သား လိဗနိ၊ လိဗနိရဲ့သား ရှိမိ၊ ရှိမိရဲ့သား ဩဇ၊
  </para>
  <para style="p">
    <verse number="30" style="v" />သြဇရဲ့သား ရှိမ၊ ရှိမရဲ့သား ဟဂိယ၊ ဟဂိယရဲ့သား အသာယတို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />သေတ္တာတော်ကို နေရာတကျ ထားပြီးနောက် ယေဟောဝါရဲ့ အိမ်တော်မှာ သီချင်းဆိုတာကို ညွှန်ကြားဖို့ ဒါဝိဒ်ခန့်အပ်သူတွေက အောက်ပါအတိုင်း ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="32" style="v" />သူတို့ဟာ ဂျေရုဆလင်မြို့မှာ ယေဟောဝါရဲ့ အိမ်တော်ကို ရှောလမုန် တည်ဆောက်ချိန် မတိုင်ခင်အထိ တွေ့ဆုံရာတဲတော်ရှေ့မှာ သီချင်းဆိုဖို့ တာဝန်ရသူတွေ ဖြစ်တယ်။ ညွှန်ကြားထားတဲ့အတိုင်း သူတို့ တာဝန်ထမ်းဆောင်ရတယ်။
  </para>
  <para style="p">
    <verse number="33" style="v" />သားမြေးတွေနဲ့အတူ အမှုဆောင်သူတွေကတော့– ကောဟတ်အမျိုးသားတွေမှာ သီချင်းသည်က ဟေမန်လို့ ခေါ်တယ်။ ဟေမန်ရဲ့ဖခင်က ယောလ၊ ယောလရဲ့ဖခင်က ရှမွေလ၊
  </para>
  <para style="p">
    <verse number="34" style="v" />ရှမွေလရဲ့ဖခင်က ဧလကာန၊ ဧလကာနရဲ့ဖခင်က ယေရောဟံ၊ ယေရောဟံရဲ့ဖခင်က ဧလျေလ၊ ဧလျေလရဲ့ဖခင်က တောအာ၊
  </para>
  <para style="p">
    <verse number="35" style="v" />တောအာရဲ့ဖခင်က ဇုဖ၊ ဇုဖရဲ့ဖခင်က ဧလကာန၊ ဧလကာနရဲ့ဖခင်က မာဟတ်၊ မာဟတ်ရဲ့ဖခင်က အာမသဲ၊
  </para>
  <para style="p">
    <verse number="36" style="v" />အာမသဲရဲ့ဖခင်က ဧလကာန၊ ဧလကာနရဲ့ဖခင်က ယောလ၊ ယောလရဲ့ဖခင်က အာဇရိ၊ အာဇရိရဲ့ဖခင်က ဇေဖနိ၊
  </para>
  <para style="p">
    <verse number="37" style="v" />ဇေဖနိရဲ့ဖခင်က တာဟတ်၊ တာဟတ်ရဲ့ဖခင်က အသိရ၊ အသိရရဲ့ဖခင်က ဧဗျာသပ်၊ ဧဗျာသပ်ရဲ့ဖခင်က ကောရ၊
  </para>
  <para style="p">
    <verse number="38" style="v" />ကောရရဲ့ဖခင်က အိဇဟာ၊ အိဇဟာရဲ့ဖခင်က ကောဟတ်၊ ကောဟတ်ရဲ့ဖခင်က လေဝိ၊ လေဝိရဲ့ဖခင်က အစ္စရေးဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="39" style="v" />ဟေမန်ရဲ့ညာဘက်မှာ ဆွေမျိုးသားချင်းဖြစ်တဲ့ အာသပ်က နေရာယူရတယ်။ အာသပ်ရဲ့ဖခင်က ဗေရခိ၊ ဗေရခိရဲ့ဖခင်က ရှိမ၊
  </para>
  <para style="p">
    <verse number="40" style="v" />ရှိမရဲ့ဖခင်က မိက္ခေလ၊ မိက္ခေလရဲ့ဖခင်က ဗာသေယ၊ ဗာသေယရဲ့ဖခင်က မာလခိယ၊
  </para>
  <para style="p">
    <verse number="41" style="v" />မာလခိယရဲ့ဖခင်က ဧသနိ၊ ဧသနိရဲ့ဖခင်က ဇေရ၊ ဇေရရဲ့ဖခင်က အဒါယ၊
  </para>
  <para style="p">
    <verse number="42" style="v" />အဒါယရဲ့ဖခင်က ဧသန်၊ ဧသန်ရဲ့ဖခင်က ဇိမ၊ ဇိမရဲ့ဖခင်က ရှိမိ၊
  </para>
  <para style="p">
    <verse number="43" style="v" />ရှိမိရဲ့ဖခင်က ယာဟတ်၊ ယာဟတ်ရဲ့ဖခင်က ဂေရရှုံ၊ ဂေရရှုံရဲ့ဖခင်က လေဝိဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="44" style="v" />ဟေမန်ရဲ့ဘယ်ဘက်မှာ ဆွေမျိုးသားချင်းတွေဖြစ်တဲ့ မေရာရိရဲ့ သားမြေးတွေနဲ့အတူ ဧသန်က နေရာယူရတယ်။ ဧသန်ရဲ့ဖခင်က ကိရှိ၊ ကိရှိရဲ့ဖခင်က အာဖဒိ၊ အာဖဒိရဲ့ဖခင်က မာလုတ်၊
  </para>
  <para style="p">
    <verse number="45" style="v" />မာလုတ်ရဲ့ဖခင်က ဟာရှဘိ၊ ဟာရှဘိရဲ့ဖခင်က အာမဇိ၊ အာမဇိရဲ့ဖခင်က ဟိလခိ၊
  </para>
  <para style="p">
    <verse number="46" style="v" />ဟိလခိရဲ့ဖခင်က အံဇိ၊ အံဇိရဲ့ဖခင်က ဗာနိ၊ ဗာနိရဲ့ဖခင်က ရှမေရ၊
  </para>
  <para style="p">
    <verse number="47" style="v" />ရှမေရရဲ့ဖခင်က မဟာလိ၊ မဟာလိရဲ့ဖခင်က မုရှိ၊ မုရှိရဲ့ဖခင်က မေရာရိ၊ မေရာရိရဲ့ဖခင်က လေဝိဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="48" style="v" />ကျန်တဲ့ဆွေမျိုးသားချင်း လေဝိအနွယ်ဝင်တွေက စစ်မှန်တဲ့ဘုရားသခင့် အိမ်တော်ဖြစ်တဲ့ တဲတော်မှာ အမှုဆောင်ဖို့ ခန့်အပ်ခံရတယ်။
  </para>
  <para style="p">
    <verse number="49" style="v" />အာရုန်နဲ့ သူ့သားမြေးတွေက ဘုရားသခင်ရဲ့ကျွန် မောရှေ မှာထားတဲ့အတိုင်း အစ္စရေးလူမျိုးအတွက် အပြစ်ဖြေပေးဖို့ ပလ္လင်ပေါ်မှာ မီးရှို့ရာအလှူတွေကို မီးရှို့ပူဇော်ရတယ်။ နံ့သာပေါင်းပလ္လင်ပေါ်မှာ နံ့သာပေါင်းတွေ မီးရှို့ရတယ်။ အသန့်ရှင်းဆုံးအရာတွေနဲ့ဆိုင်တဲ့ တာဝန်တွေကို ထမ်းဆောင်ရတယ်။
  </para>
  <para style="p">
    <verse number="50" style="v" />အာရုန်ရဲ့သားမြေးတွေကတော့- အာရုန်ရဲ့သား ဧလာဇာ၊ ဧလာဇာရဲ့သား ဖိနဟတ်၊ ဖိနဟတ်ရဲ့သား အဘိရွှ၊
  </para>
  <para style="p">
    <verse number="51" style="v" />အဘိရွှရဲ့သား ဗုကိ၊ ဗုကိရဲ့သား ဩဇေ၊ သြဇေရဲ့သား ဇေရဟိ၊
  </para>
  <para style="p">
    <verse number="52" style="v" />ဇေရဟိရဲ့သား မေရာယုတ်၊ မေရာယုတ်ရဲ့သား အာမရိ၊ အာမရိရဲ့သား အဟိတုပ်၊
  </para>
  <para style="p">
    <verse number="53" style="v" />အဟိတုပ်ရဲ့သား ဇာဒုတ်၊ ဇာဒုတ်ရဲ့သား အဟိမတ် ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="54" style="v" />နယ်မြေအတွင်းမှာ စခန်းချပြီး နေထိုင်ကြတဲ့ လေဝိအနွယ်ရဲ့ ကျေးရွာတွေ ရှိတယ်။ ကောဟတ်ဆွေမျိုးစုဖြစ်တဲ့ အာရုန်ရဲ့သားမြေးတွေ ဦးဆုံးမဲကျတဲ့အတွက်၊
  </para>
  <para style="p">
    <verse number="55" style="v" />သူတို့ကို ယုဒနယ်မြေမှာရှိတဲ့ ဟေဗြုန်မြို့နဲ့ ပတ်လည်က စားကျက်မြေတွေ ပေးလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="56" style="v" />ဟေဗြုန်မြို့ရဲ့ လယ်မြေတွေနဲ့ ကျေးရွာတွေကိုတော့ ယေဖုန်နာရဲ့သား ကာလက်ကို ပေးတယ်။
  </para>
  <para style="p">
    <verse number="57" style="v" />အာရုန်ရဲ့သားမြေးတွေကိုတော့ ခိုလှုံရာမြို့တွေ ထဲက ဟေဗြုန်မြို့အပြင် လိဗနမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ယတိရမြို့၊ ဧရှတမောမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="58" style="v" />ဟိလိန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဒေဗိရမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="59" style="v" />အာရှန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဗက်ရှေမက်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="60" style="v" />ဗင်ယာမိန်အနွယ်ရဲ့ နယ်မြေထဲက ဂေဘမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ အာလမက်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ အာနသုတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေကို ပေးတယ်။ သူတို့ကို ဆွေမျိုးစုအလိုက် မြို့ပေါင်း ၁၃မြို့ ခွဲဝေပေးတယ်။
  </para>
  <para style="p">
    <verse number="61" style="v" />ကျန်တဲ့ကောဟတ်အမျိုးသားတွေကို တခြားအနွယ်ရဲ့ ဆွေမျိုးစုနဲ့ မနာရှေအနွယ်တစ်ဝက်ရဲ့ နယ်မြေထဲက မြို့ပေါင်း ၁၀ မြို့ကို ခွဲဝေပေးတယ်။
  </para>
  <para style="p">
    <verse number="62" style="v" />ဆွေမျိုးစုအလိုက် ဂေရရှုံအမျိုးသားတွေကို အိသခါအနွယ်၊ အာရှာအနွယ်၊ နဿလိအနွယ်တွေရဲ့နယ်မြေနဲ့ ဗာရှန်ပြည်မှာရှိတဲ့ မနာရှေအနွယ်ရဲ့နယ်မြေထဲက မြို့ပေါင်း ၁၃ မြို့ကို ခွဲဝေပေးတယ်။
  </para>
  <para style="p">
    <verse number="63" style="v" />ဆွေမျိုးစုအလိုက် မေရာရိအမျိုးသားတွေကို ရုဗင်အနွယ်၊ ဂဒ်အနွယ်၊ ဇာဗုလုန်အနွယ်တွေရဲ့နယ်မြေထဲက မြို့ပေါင်း ၁၂ မြို့ကို ခွဲဝေပေးတယ်။
  </para>
  <para style="p">
    <verse number="64" style="v" />အစ္စရေးတွေက အဲဒီမြို့တွေနဲ့ ဆိုင်ရာစားကျက်မြေတွေကို လေဝိအနွယ်ကို ပေးတယ်။
  </para>
  <para style="p">
    <verse number="65" style="v" />ဒါ့အပြင် ယုဒအနွယ်၊ ရှိမောင်အနွယ်၊ ဗင်ယာမိန်အနွယ်တွေရဲ့နယ်မြေထဲက နာမည်နဲ့တကွ ဖော်ပြထားတဲ့မြို့တွေကို မဲချပြီး ခွဲဝေပေးတယ်။
  </para>
  <para style="p">
    <verse number="66" style="v" />ကောဟတ်ဆွေမျိုးစုတချို့ကို ဧဖရိမ်အနွယ်ရဲ့ နယ်မြေထဲက မြို့တွေ ပေးတယ်။
  </para>
  <para style="p">
    <verse number="67" style="v" />သူတို့ကို ဧဖရိမ်တောင်တန်းဒေသက ခိုလှုံရာမြို့တွေ ထဲက ရှေခင်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေအပြင် ဂေဇာမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="68" style="v" />ယောကနန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဗေသောရုန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="69" style="v" />အာယလုန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဂါသရိမုန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေတို့ကို ပေးတယ်။
  </para>
  <para style="p">
    <verse number="70" style="v" />ကျန်တဲ့ကောဟတ်ဆွေမျိုးစုတွေကို မနာရှေအနွယ်တစ်ဝက်ရဲ့ နယ်မြေထဲက အာနေရမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဗိလံမြို့နဲ့ ဆိုင်ရာစားကျက်မြေတွေ ပေးတယ်။
  </para>
  <para style="p">
    <verse number="71" style="v" />ဂေရရှုံအမျိုးသားတွေကို ပေးတဲ့ မြို့တွေကတော့ မနာရှေအနွယ်တစ်ဝက်ရဲ့ နယ်မြေထဲက ဗာရှန်ပြည်မှာရှိတဲ့ ဂေါလန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ အာရှတရုတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="72" style="v" />အိသခါအနွယ်ရဲ့ နယ်မြေထဲက ကေဒေရှမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဒါဗရတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="73" style="v" />ရာမုတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ အာနင်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="74" style="v" />အာရှာအနွယ်ရဲ့ နယ်မြေထဲက မာရှလမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ အာဗဒုန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="75" style="v" />ဟုကတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ရဟောဘမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="76" style="v" />နဿလိအနွယ်ရဲ့ နယ်မြေထဲက ဂါလိလဲနယ်မှာရှိတဲ့ ကေဒေရှမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ဟာမုန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ကိရယသိမ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေတို့ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="77" style="v" />ကျန်တဲ့မေရာရိအမျိုးသားတွေကို ဇာဗုလုန်အနွယ်ရဲ့ နယ်မြေထဲက ရိမနောမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ တာဗော်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေကို ပေးတယ်။
  </para>
  <para style="p">
    <verse number="78" style="v" />ပြီးတော့ ယေရိခေါမြို့အနီး ဂျော်ဒန်မြစ်အရှေ့ဘက် ဂျော်ဒန်မြစ်ဝှမ်းဒေသမှာရှိတဲ့ ရုဗင်အနွယ်ရဲ့ နယ်မြေထဲကနေ တောကန္တာရထဲက ဗေဇာမြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ယာဟတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="79" style="v" />ကေဒမုတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ မေဖတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="80" style="v" />ဂဒ်အနွယ်ရဲ့ နယ်မြေထဲက ဂိလဒ်ပြည်မှာရှိတဲ့ ရာမုတ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ မဟာနိမ်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊
  </para>
  <para style="p">
    <verse number="81" style="v" />ဟေရှဘုန်မြို့နဲ့ ဆိုင်ရာစားကျက်မြေ၊ ယာဇာမြို့နဲ့ ဆိုင်ရာစားကျက်မြေတွေကိုလည်း ပေးလိုက်တယ်။
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />အိသခါရဲ့သားတွေက တောလ၊ ပုအာ၊ ယာရှုပ်၊ ရှိမရုန်၊ စုစုပေါင်း လေးယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />တောလရဲ့သားတွေက ဩဇေ၊ ရေဖာယ၊ ယေရေလ၊ ယာမဲ၊ ယိဗသံ၊ ရှေမွေလ။ သူတို့ဟာ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။ တောလရဲ့သားမြေးတွေဟာ ခွန်အားကြီး စစ်သည်တွေဖြစ်ပြီး ဒါဝိဒ်မင်းလက်ထက်မှာ အရေအတွက် ၂၂,၆၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />သြဇေရဲ့သားမြေးတွေက သား အိဇရဟိ၊ အိဇရဟိရဲ့သားတွေဖြစ်တဲ့ မိက္ခေလ၊ သြဗဒိ၊ ယောလ၊ အိရှယ။ သူတို့ငါးယောက်စလုံးဟာ ခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="4" style="v" />သူတို့မှာ ဇနီးတွေ၊ သားတွေ အများကြီးရှိတဲ့အတွက် သူတို့သားမြေးတွေထဲမှာ ဆွေမျိုးစုအလိုက် စာရင်းဝင်တဲ့ စစ်သည်ပေါင်း ၃၆,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />အိသခါရဲ့ ဆွေမျိုးစုတွေထဲက ကျန်တဲ့ညီအစ်ကိုတွေလည်း ခွန်အားကြီးစစ်သည်တွေ ဖြစ်တယ်။ ဆွေစဉ်မျိုးဆက်စာရင်းအရ စုစုပေါင်း ၈၇,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဗင်ယာမိန်ရဲ့သားတွေက ဗေလ၊ ဗေခါ၊ ယေဒယေလ၊ စုစုပေါင်း သုံးယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဗေလရဲ့သားတွေက ဧဇဗုန်၊ ဩဇေ၊ သြဇေလ၊ ယေရိမုတ်၊ အိရိ၊ စုစုပေါင်း ငါးယောက် ရှိတယ်။ သူတို့ဟာ ဆွေမျိုးစုခေါင်းဆောင်တွေ၊ ခွန်အားကြီးစစ်သည်တွေပဲ။ ဆွေစဉ်မျိုးဆက်စာရင်းအရ စုစုပေါင်း ၂၂,၀၃၄ ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဗေခါရဲ့သားတွေက ဇေမိရ၊ ယောရှ၊ ဧလျာဇာ၊ ဧလိသြနဲ၊ သြမရိ၊ ယေရမုတ်၊ အဘိယ၊ အာနသုတ်၊ အာလမက်။ သူတို့ဟာ ဗေခါရဲ့သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="9" style="v" />သူတို့ရဲ့ သားမြေးတွေထဲမှာ ဆွေစဉ်မျိုးဆက်စာရင်းဝင်တဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေဟာ ခွန်အားကြီးစစ်သည်တွေ ဖြစ်ပြီး စုစုပေါင်း ၂၀,၂၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ယေဒယေလရဲ့ သားမြေးတွေက သား ဗိလဟန်၊ ဗိလဟန်ရဲ့သားတွေဖြစ်တဲ့ ယုရှ၊ ဗင်ယာမိန်၊ ဧဟုဒ၊ ခေနာနာ၊ ဇေသန်၊ တာရှိ၊ အဟိရှဟာ။
  </para>
  <para style="p">
    <verse number="11" style="v" />သူတို့အားလုံးဟာ ယေဒယေလရဲ့ သားမြေးတွေ၊ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။ စစ်တိုက်ဖို့ အသင့်ရှိတဲ့ ခွန်အားကြီး စစ်သည်ပေါင်း ၁၇,၂၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />အိရကနေ ရှုပိမ်နဲ့ဟုပိမ် ဆွေမျိုးစုတွေ ဆင်းသက်လာတယ်။ အာဟေရကနေ ဟုရှိမ်ရဲ့သားမြေးတွေ ဆင်းသက်လာတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />နဿလိရဲ့သားတွေက ယာဇိလ၊ ဂုနိ၊ ယေဇာ၊ ရှလုံ။ သူတို့ဟာ ဗိလဟာရဲ့ သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="14" style="v" />မနာရှေကနေ ဆင်းသက်လာသူတွေကတော့- ဆီးရီးယားသူ မယားငယ်နဲ့ရတဲ့ အသရေလ။ (အဲဒီမယားငယ်က ဂိလဒ်ရဲ့ဖခင် မာခိရကိုလည်း မွေးတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />မာခိရက ဟုပိမ်နဲ့ ရှုပိမ်အတွက် ဇနီးရှာပေးတယ်။ သူတို့ရဲ့နှမက မာခါလို့ခေါ်တယ်။) နောက်တစ်ယောက်က ဇလောဖဒ်။ ဇလောဖဒ်မှာ သမီးတွေပဲ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />မာခိရရဲ့ဇနီး မာခါက သားလေးမွေးလာတော့ ပေရက်လို့ နာမည်ပေးတယ်။ ပေရက်ရဲ့ညီက ရှေရက်။ ရှေရက်ရဲ့သားတွေက ဥလံနဲ့ ရေကင်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဥလံရဲ့သားတစ်ယောက်က ဗေဒန်။ သူတို့ဟာ ဂိလဒ်ရဲ့သားမြေးတွေ ဖြစ်တယ်။ (ဂိလဒ်ရဲ့ဖခင်က မာခိရ၊ မာခိရရဲ့ဖခင်က မနာရှေ။)
  </para>
  <para style="p">
    <verse number="18" style="v" />ဂိလဒ်ရဲ့နှမက ဟမောလေကက်။ ဟမောလေကက်က အိရှောဒ၊ အဗျေဇာ၊ မာလာတို့ကို မွေးတယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ရှမိဒရဲ့သားတွေက အဟိအန်၊ ရှေခင်၊ လိကဟိ၊ အနိအံတို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဧဖရိမ်ရဲ့ သားမြေးတွေက– ဧဖရိမ်ရဲ့သား ရှုသေလ၊ ရှုသေလရဲ့သား ဗေရက်၊ ဗေရက်ရဲ့သား တာဟတ်၊ တာဟတ်ရဲ့သား ဧလာဒ၊ ဧလာဒရဲ့သား တာဟတ်၊
  </para>
  <para style="p">
    <verse number="21" style="v" />တာဟတ်ရဲ့သား ဇာဗဒ်၊ ဇာဗဒ်ရဲ့သား ရှုသေလ။ ဧဖရိမ်မှာ ဧဇာနဲ့ဧလဒ်ဆိုတဲ့ သားနှစ်ယောက် ရှိသေးတယ်။ ဂါသမြို့သားတွေက ဧဖရိမ်ရဲ့သားတွေဆီ ဆင်းလာပြီး ခြံမွေးတိရစ္ဆာန်တွေကို လုယူရုံမက ဧဇာနဲ့ဧလဒ်ကိုပါ သတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဒါကြောင့် ဧဖရိမ်က သားတွေအတွက် ရက်ပေါင်းများစွာ ငိုကြွေးတယ်။ အဲဒီအခါ ညီအစ်ကိုတွေ လာပြီး နှစ်သိမ့်ပေးကြတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />နောက်တော့ သူက ဇနီးနဲ့အတူ နေတဲ့အတွက် ဇနီးမှာ ကိုယ်ဝန်ရှိလာပြီး သားလေးမွေးလာတယ်။ မိသားစု ဒုက္ခရောက်နေချိန်မှာ မွေးလာလို့ အဲဒီသားကို ဗေရိယ လို့နာမည်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />သမီးဖြစ်သူ ရှေရာက အထက်ဗေသောရုန်မြို့၊ အောက်ဗေသောရုန်မြို့နဲ့ သြဇင်ရှေရမြို့ကို တည်ဆောက်သူပဲ။
  </para>
  <para style="p">
    <verse number="25" style="v" />ရေဖနဲ့ ရေရှပ်လည်း ဧဖရိမ်ရဲ့သားမြေးတွေပဲ။ ရေရှပ်ရဲ့သားက တေလ၊ တေလရဲ့သားက တာဟန်၊
  </para>
  <para style="p">
    <verse number="26" style="v" />တာဟန်ရဲ့သားက လာဒန်၊ လာဒန်ရဲ့သားက အမိဟု၊ အမိဟုရဲ့သားက ဧလိရှမာ၊
  </para>
  <para style="p">
    <verse number="27" style="v" />ဧလိရှမာရဲ့သားက နုန်၊ နုန်ရဲ့သားက ယောရှု။
  </para>
  <para style="p">
    <verse number="28" style="v" />သူတို့ပိုင်ဆိုင်တဲ့ နေရာတွေကတော့ ဗေသလမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ အရှေ့ဘက်မှာ နာရန်မြို့၊ အနောက်ဘက်မှာ ဂေဇာမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ ရှေခင်မြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ အေယမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေပဲ။
  </para>
  <para style="p">
    <verse number="29" style="v" />မနာရှေသားမြေးတွေက နယ်စပ်တစ်လျှောက်မှာရှိတဲ့ ဗက်ရှန်မြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ တာနက်မြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ မေဂိဒေါမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေ၊ ဒေါရမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေကို ပိုင်တယ်။ အဲဒီမြို့တွေမှာ အစ္စရေးရဲ့သား ယောသပ်ရဲ့ သားမြေးတွေ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />အာရှာရဲ့ သားတွေက အိမနာ၊ အိရှဘာ၊ အိရှဘိ၊ ဗေရိယ။ သမီး စေရာ။
  </para>
  <para style="p">
    <verse number="31" style="v" />ဗေရိယရဲ့သားတွေက ဟေဗာနဲ့ မာလချေလ။ မာလချေလရဲ့သားက ဗိရဇာ။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဟေဗာရဲ့ သားတွေကတော့ ယာဖလက်၊ ရှောမာ၊ ဟောသံ။ သမီး ရှုအ။
  </para>
  <para style="p">
    <verse number="33" style="v" />ယာဖလက်ရဲ့သားတွေက ပါသက်၊ ဗိမဟာလ၊ အာရှဝတ်။ သူတို့ဟာ ယာဖလက်ရဲ့သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="34" style="v" />ရှမေရရဲ့ သားတွေက အဟိ၊ ရောဂ၊ ယေဟုဗ၊ အာရံ။
  </para>
  <para style="p">
    <verse number="35" style="v" />ညီဖြစ်သူ ဟေလင်ရဲ့ သားတွေက ဇောဖ၊ အိမန၊ ရှေလက်၊ အာမလ။
  </para>
  <para style="p">
    <verse number="36" style="v" />ဇောဖရဲ့ သားတွေက သုအာ၊ ဟာနေဖာ၊ ရွှာလ၊ ဗေရိ၊ အိမရ၊
  </para>
  <para style="p">
    <verse number="37" style="v" />ဗေဇာ၊ ဟောဒ၊ ရှမ၊ ရှိလရှ၊ အိသရန်၊ ဗေရ။
  </para>
  <para style="p">
    <verse number="38" style="v" />ယေသာရဲ့ သားတွေက ယေဖုန်နာ၊ ပိသပ၊ အာရ။
  </para>
  <para style="p">
    <verse number="39" style="v" />ဥလရဲ့ သားတွေက အာရာ၊ ဟံယေလ၊ ရေဇိယ။
  </para>
  <para style="p">
    <verse number="40" style="v" />သူတို့အားလုံးဟာ အာရှာရဲ့သားမြေးတွေ ဖြစ်တယ်။ ဆွေမျိုးစုခေါင်းဆောင်တွေ၊ လက်ရွေးစင် ခွန်အားကြီးစစ်သည်တွေ၊ အထင်ကရ ခေါင်းဆောင်တွေ ဖြစ်ပြီး ဆွေစဉ်မျိုးဆက်စာရင်းအရ စစ်မှုထမ်းနိုင်သူ စုစုပေါင်း ၂၆,၀၀၀ ရှိတယ်။
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဗင်ယာမိန်ရဲ့ သားတွေက သားဦး ဗေလ၊ ဒုတိယသား အာရှဗေလ၊ တတိယသား အဟာရာ၊
  </para>
  <para style="p">
    <verse number="2" style="v" />စတုတ္ထသား နောဟ၊ ပဉ္စမသား ရာဖ။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဗေလရဲ့သားတွေက အာဒါ၊ ဂေရ၊ အဘိဟုတ်၊
  </para>
  <para style="p">
    <verse number="4" style="v" />အဘိရွှ၊ နေမန်၊ အာဟော၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ဂေရ၊ ရှေဖုဖံ၊ ဟုရံ။
  </para>
  <para style="p">
    <verse number="6" style="v" />မနာဟတ်အရပ်ကို ဖမ်းခေါ်ခံရတဲ့ ဂေဘမြို့သားတွေရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေဖြစ်တဲ့ ဧဟုဒရဲ့သားတွေကတော့၊
  </para>
  <para style="p">
    <verse number="7" style="v" />နေမန်၊ အဟိယ၊ ဂေရ။ ဂေဘမြို့သားတွေ ဖမ်းခေါ်ခံရချိန်မှာ ဂေရက ဦးဆောင်ခေါ်သွားခဲ့တာဖြစ်တယ်။ ဂေရရဲ့သားတွေက သြဇနဲ့ အဟိဟု။
  </para>
  <para style="p">
    <verse number="8" style="v" />ရှဟာရိမ်မှာ ဟုရှိမ်နဲ့ဗာရာလို့ခေါ်တဲ့ ဇနီးတွေရှိတယ်။ သူက မောဘလူတွေကို အဲဒီနယ်မြေကနေ မောင်းထုတ်ပြီးနောက် သားသမီးတွေ ရလာတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဇနီးဟောဒေရှနဲ့ရတဲ့ သားတွေက ယောဗပ်၊ ဇိဘိ၊ မေရှ၊ မာလခံ၊
  </para>
  <para style="p">
    <verse number="10" style="v" />ယုဇ၊ ရှာခိ၊ မိရမ။ သူတို့ဟာ ရှဟာရိမ်ရဲ့သားတွေ၊ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဇနီးဟုရှိမ်နဲ့ရတဲ့ ရှဟာရိမ်ရဲ့သားတွေက အဘိတုပ်နဲ့ ဧလပါလ။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဧလပါလရဲ့သားတွေက ဧဗာ၊ မိရှဟံ၊ (သြနောမြို့၊ လောဒမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေကို တည်ထောင်သူ) ရှာမက်၊
  </para>
  <para style="p">
    <verse number="13" style="v" />ဗေရိယ၊ ရှေမာတို့ဖြစ်ပြီး အာယလုန်မြို့သားတွေရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေ ဖြစ်တယ်။ သူတို့က ဂါသမြို့သားတွေကို နှင်ထုတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />အဟိသြ၊ ရှာရှက်၊ ယေရမုတ်၊
  </para>
  <para style="p">
    <verse number="15" style="v" />ဇေဗဒိ၊ အာရဒ်၊ ဧဒါ၊
  </para>
  <para style="p">
    <verse number="16" style="v" />မိက္ခေလ၊ အိရှပ၊ ယောဟတို့ဟာ ဗေရိယရဲ့သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဇေဗဒိ၊ မေရှုလံ၊ ဟိဇကိ၊ ဟေဗာ၊
  </para>
  <para style="p">
    <verse number="18" style="v" />အိရှမေရဲ၊ ယေဇလိ၊ ယောဗပ်တို့ဟာ ဧလပါလရဲ့သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="19" style="v" />ယာကိမ်၊ ဇိခရိ၊ ဇာဗဒိ၊
  </para>
  <para style="p">
    <verse number="20" style="v" />ဧလျေနဲ၊ ဇိလသဲ၊ ဧလျေလ၊
  </para>
  <para style="p">
    <verse number="21" style="v" />အဒါယ၊ ဗေရာယ၊ ရှိမရတ်တို့ဟာ ရှိမိရဲ့သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="22" style="v" />အိရှပန်၊ ဟေဗာ၊ ဧလျေလ၊
  </para>
  <para style="p">
    <verse number="23" style="v" />အာဗဒုန်၊ ဇိခရိ၊ ဟာနန်၊
  </para>
  <para style="p">
    <verse number="24" style="v" />ဟာနနိ၊ ဧလံ၊ အန်တောသိယ၊
  </para>
  <para style="p">
    <verse number="25" style="v" />အိဖဒိယ၊ ပေနွေလတို့ဟာ ရှာရှက်ရဲ့သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="26" style="v" />ရှံရှရဲ၊ ရှေဟာရိ၊ အာသလိ၊
  </para>
  <para style="p">
    <verse number="27" style="v" />ယာရရှိ၊ ဧလိယ၊ ဇိခရိတို့ဟာ ယေရောဟံရဲ့ သားမြေးတွေပဲ။
  </para>
  <para style="p">
    <verse number="28" style="v" />သူတို့ဟာ ဆွေစဉ်မျိုးဆက်စာရင်းအရ ဆွေမျိုးစုခေါင်းဆောင်တွေ ဖြစ်ပြီး ဂျေရုဆလင်မြို့မှာ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ယေယေလက ဂိဗောင်မြို့ကို တည်ထောင်ပြီး အဲဒီမှာ နေထိုင်တယ်။ သူ့ဇနီးက မာခါ။
  </para>
  <para style="p">
    <verse number="30" style="v" />သားတွေက သားဦး အာဗဒုန်၊ ဇုရ၊ ကိရှ၊ ဗာလ၊ နာဒပ်၊
  </para>
  <para style="p">
    <verse number="31" style="v" />ဂေဒေါ်၊ အဟိသြ၊ ဇာခါ။
  </para>
  <para style="p">
    <verse number="32" style="v" />မိကလုတ်မှာ ရှိမာလို့ခေါ်တဲ့ သားရှိတယ်။ သူတို့က ဂျေရုဆလင်မြို့မှာရှိတဲ့ ညီအစ်ကိုတွေအနားမှာပဲ တခြားဆွေမျိုးသားချင်းတွေနဲ့အတူ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="33" style="v" />နေရ ရဲ့သားက ကိရှ၊ ကိရှရဲ့သားက ရှောလု၊ ရှောလုရဲ့သားတွေက ယောနသန်၊ မေလခိရွှ၊ အဘိနဒပ်၊ အိရှဗာလ။
  </para>
  <para style="p">
    <verse number="34" style="v" />ယောနသန်ရဲ့သားက မေရိဗာလ၊ မေရိဗာလရဲ့သားက မိက္ခာ၊
  </para>
  <para style="p">
    <verse number="35" style="v" />မိက္ခာရဲ့သားတွေက ပိသုန်၊ မေလက်၊ တာရာ၊ အာခတ်။
  </para>
  <para style="p">
    <verse number="36" style="v" />အာခတ်ရဲ့သားက ယေဟောဒါ၊ ယေဟောဒါရဲ့သားတွေက အာလမက်၊ အာဇမာဝက်၊ ဇိမရိ။ ဇိမရိရဲ့သားက မောဇ၊
  </para>
  <para style="p">
    <verse number="37" style="v" />မောဇရဲ့သားက ဗိနာ၊ ဗိနာရဲ့သားက ရာဖာ၊ ရာဖာရဲ့သားက ဧလာသ၊ ဧလာသရဲ့သားက အာဇေလ။
  </para>
  <para style="p">
    <verse number="38" style="v" />အာဇေလမှာ အာဇရိကံ၊ ဗောခေရု၊ အိရှမေလ၊ ရှရိယ၊ သြဗဒိ၊ ဟာနန်လို့ခေါ်တဲ့ သားခြောက်ယောက်ရှိတယ်။ သူတို့အားလုံးဟာ အာဇေလရဲ့သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="39" style="v" />သူနဲ့ညီအစ်ကိုတော်တဲ့ ဧရှက်ရဲ့ သားတွေက သားဦးဥလံ၊ ဒုတိယသား ယုရှ၊ တတိယသား ဧလိဖလက်။
  </para>
  <para style="p">
    <verse number="40" style="v" />ဥလံရဲ့သားတွေဟာ ခွန်အားကြီးစစ်သည်တွေ၊ လေးသည်တော်တွေ ဖြစ်တယ်။ သူတို့မှာ သားနဲ့မြေးချည်းပဲ ၁၅၀ ရှိတယ်။ အားလုံးဟာ ဗင်ယာမိန်ရဲ့ သားစဉ်မြေးဆက်တွေပဲ။
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />အစ္စရေးအားလုံးကို ဆွေစဉ်မျိုးဆက်အလိုက် စာရင်းပြုစုပြီး အစ္စရေးဘုရင်တွေရဲ့ ရာဇဝင်ကျမ်းမှာ ရေးထားတယ်။ ယုဒအမျိုးက သစ္စာမဲ့တဲ့အတွက် ဗာဗုလုန်ကို ပြည်နှင်ခံခဲ့ရတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ပုရောဟိတ်တွေ၊ လေဝိအမျိုးသားတွေ၊ ဗိမာန်တော်ကျွန်တွေ၊ တချို့အစ္စရေးတွေက ကိုယ့်မြို့ကိုယ့်ရွာဆီ ဦးဆုံးပြန်လာကြတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဂျေရုဆလင်မြို့မှာ လာနေကြတဲ့ ယုဒ၊ ဗင်ယာမိန်၊ ဧဖရိမ်နဲ့ မနာရှေအနွယ် သားမြေးတချို့ကတော့-
  </para>
  <para style="p">
    <verse number="4" style="v" />ယုဒရဲ့သား ဖာရက်ကနေ ဆင်းသက်လာတဲ့ ဥသဲ (ဥသဲရဲ့ဖခင်က အမိဟု၊ အမိဟုရဲ့ဖခင်က ဩမရိ၊ သြမရိရဲ့ဖခင်က အိမရိ၊ အိမရိရဲ့ဖခင်က ဗာနိ)၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ရှေလရဲ့ သားမြေးတွေထဲက သားဦးအသာယနဲ့ သူ့သားတွေ၊
  </para>
  <para style="p">
    <verse number="6" style="v" />ဇေရရဲ့သားမြေးတွေထဲက ယွေလနဲ့ ညီအစ်ကို ၆၉၀ တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဗင်ယာမိန်ရဲ့ သားမြေးတွေထဲမှာတော့ စာလု (စာလုရဲ့ဖခင်က မေရှုလံ၊ မေရှုလံရဲ့ဖခင်က ဟောဒဝိ၊ ဟောဒဝိရဲ့ဖခင်က ဟာသေနွာ)၊
  </para>
  <para style="p">
    <verse number="8" style="v" />ယေရောဟံရဲ့သား အိဗနေယ၊ မိခရိရဲ့မြေး သြဇေရဲ့သား ဧလာ၊ မေရှုလံ (မေရှုလံရဲ့ဖခင်က ရှေဖတိ၊ ရှေဖတိရဲ့ဖခင်က ရွေလ၊ ရွေလဖခင်က အိဗနိယ) တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဆွေစဉ်မျိုးဆက်စာရင်းအရ သူတို့ရဲ့ညီအစ်ကို စုစုပေါင်း ၉၅၆ ယောက်ရှိတယ်။ အားလုံးဟာ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="10" style="v" />ပုရောဟိတ်တွေထဲမှာ ယေဒါယ၊ ယောယရိပ်၊ ယာခိန်၊
  </para>
  <para style="p">
    <verse number="11" style="v" />ဘုရားသခင့်အိမ်တော်ရဲ့ ခေါင်းဆောင် အာဇရိ (အာဇရိရဲ့ဖခင်က ဟိလခိ၊ ဟိလခိရဲ့ဖခင်က မေရှုလံ၊ မေရှုလံရဲ့ဖခင်က ဇာဒုတ်၊ ဇာဒုတ်ရဲ့ဖခင်က မေရာယုတ်၊ မေရာယုတ်ရဲ့ဖခင်က အဟိတုပ်)၊
  </para>
  <para style="p">
    <verse number="12" style="v" />အဒါယ(အဒါယရဲ့ဖခင်က ယေရောဟံ၊ ယေရောဟံရဲ့ဖခင်က ပါရှုရ၊ ပါရှုရရဲ့ဖခင်က မာလခိယ)၊ မာရှဲ (မာရှဲရဲ့ဖခင်က အဒေလ၊ အဒေလရဲ့ဖခင်က ယာဇေရ၊ ယာဇေရရဲ့ဖခင်က မေရှုလံ၊ မေရှုလံရဲ့ဖခင်က မေရှိလမတ်၊ မေရှိလမတ်ရဲ့ဖခင်က အိမေရ) တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူတို့ညီအစ်ကိုတွေဖြစ်တဲ့ ဆွေမျိုးစုခေါင်းဆောင် ၁,၇၆၀ လည်းပါတယ်။ သူတို့ဟာ ဘုရားသခင့်အိမ်တော်မှာ အမှုဆောင်ဖို့ အရည်အချင်း ပြည့်မီသူတွေ ဖြစ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />လေဝိအနွယ်မှာ မေရာရိကနေ ဆင်းသက်လာတဲ့ ဟာရှဘိရဲ့မြစ် အာဇရိကံရဲ့မြေး ဟာရှုပ်ရဲ့သား ရှေမာယ ပါတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဗာကဗက္ကာ၊ ဟေရက်၊ ဂါလာ၊ အာသပ်ရဲ့မြစ် ဇိခရိရဲ့မြေး မိက္ခာရဲ့သား မသနိ၊
  </para>
  <para style="p">
    <verse number="16" style="v" />ယေဒုသုံရဲ့မြစ် ဂါလာရဲ့မြေး ရှေမာယရဲ့သား သြဗဒိ၊ ဧလကာနရဲ့မြေး အာသရဲ့သား ဗေရခိတို့လည်း ပါတယ်။ သူက နေတောဖရွာသားတွေရဲ့ ကျေးရွာတွေမှာ နေထိုင်ခဲ့တဲ့သူပဲ။
  </para>
  <para style="p">
    <verse number="17" style="v" />တံခါးစောင့်တွေက ရှလုံ၊ အက္ကုပ်၊ တာလမုန်၊ အဟိမန်တို့သားချင်းတစ်စုပဲ။ ခေါင်းဆောင်က ရှလုံ။
  </para>
  <para style="p">
    <verse number="18" style="v" />အရင်တုန်းကတော့ သူက ဘုရင်ဝင်ထွက်တဲ့ အရှေ့တံခါးမှာ စောင့်ကြပ်ရတယ်။ သူတို့ဟာ လေဝိအမျိုးသားတွေရဲ့ စခန်းမှာ တံခါးစောင့်တွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ကောရရဲ့မြစ် ဧဗျာသပ်ရဲ့မြေး ကောရေရဲ့သား ရှလုံနဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေဖြစ်တဲ့ သူ့ညီအစ်ကို ကောရအမျိုးသားတွေဟာ အလုပ်ကြီးကြပ်သူတွေ၊ တဲတော်တံခါးစောင့်တွေပဲ။ သူတို့ရဲ့ဘိုးဘေးတွေလည်း ယေဟောဝါရဲ့ စခန်းကို ကြီးကြပ်သူတွေ၊ အဝင်လမ်းကို စောင့်ကြပ်သူတွေ ဖြစ်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />အရင်တုန်းက သူတို့ရဲ့ ခေါင်းဆောင်ဟာ ဧလာဇာရဲ့သား ဖိနဟတ်ဖြစ်ပြီး ယေဟောဝါလည်း သူနဲ့အတူရှိခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />မေရှလမိရဲ့သား ဇာခရိဟာ တွေ့ဆုံရာတဲတော် ဝင်ပေါက်ရဲ့ တံခါးစောင့်ပဲ။
  </para>
  <para style="p">
    <verse number="22" style="v" />တံခါးစောင့်တွေအဖြစ် ရွေးချယ်ခံရသူ စုစုပေါင်း ၂၁၂ ယောက် ရှိတယ်။ သူတို့က ဆွေစဉ်မျိုးဆက်စာရင်းမှာ ပါတဲ့အတိုင်း ကျေးရွာတွေမှာ နေထိုင်ရတယ်။ ဒါဝိဒ်နဲ့ အကြားအမြင်ရသူ ရှမွေလက ယုံကြည်စိတ်ချရတဲ့ တာဝန်ခံတွေအဖြစ် သူတို့ကို ခန့်အပ်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သူတို့နဲ့ သားမြေးတွေက တဲတော်ဖြစ်တဲ့ ယေဟောဝါအိမ်တော်ရဲ့ တံခါးတွေကို စောင့်ကြပ်ဖို့ တာဝန်ယူရတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />တံခါးစောင့်တွေက အရှေ့၊ အနောက်၊ တောင်၊ မြောက် လေးမျက်နှာစလုံးမှာ စောင့်ကြပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သူတို့ရဲ့ညီအစ်ကိုတွေကလည်း ကျေးရွာတွေကနေ မကြာမကြာ ရောက်လာပြီး ခုနစ်ရက်ကြာ ကူညီပေးရတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ယုံကြည်စိတ်ချရတဲ့ တာဝန်ခံ လေဝိအမျိုးသား တံခါးမှူးလေးယောက် ရှိတယ်။ ဘုရားသခင့်အိမ်တော်မှာရှိတဲ့ အခန်းတွေနဲ့ ဘဏ္ဍာတိုက်တွေကို စောင့်ကြပ်ဖို့ သူတို့ တာဝန်ယူရတယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဘုရားသခင့်အိမ်တော်ပတ်လည် ကိုယ်တာဝန်ကျတဲ့နေရာမှာ တစ်ညလုံး နေရတယ်။ သူတို့ဟာ စောင့်ကြပ်ဖို့ တာဝန်ရထားသူတွေ၊ မနက်တိုင်း အိမ်တော်တံခါး ဖွင့်ပေးရတဲ့ သော့ကိုင်တွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />သူတို့ထဲကတချို့ဟာ ဝတ်ပြုရေးအသုံးအဆောင် ပစ္စည်းတွေကို တာဝန်ယူထိန်းသိမ်းရတယ်။ ပစ္စည်းထုတ်ယူသွားချိန်၊ ပြန်ယူလာချိန်တွေမှာ စာရင်းမှတ်ရတယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />တချို့ကျတော့ တခြားအသုံးအဆောင်တွေ၊ သန့်ရှင်းတဲ့အသုံးအဆောင်တွေ၊ ဂျုံနု၊ စပျစ်ဝိုင်၊ ဆီ၊ လောဗန်၊ ဗာလစံဆီတို့ကို တာဝန်ယူထိန်းသိမ်းဖို့ ခန့်အပ်ခံရတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ပုရောဟိတ်တချို့က ဗာလစံဆီမွှေး ဖော်စပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />လေဝိအမျိုးသား ကောရကနေဆင်းသက်လာတဲ့ ရှလုံရဲ့သားဦး မာတသိဟာ မုန့်ပြားဖုတ်တာကို ကြီးကြပ်ပေးရတဲ့ ယုံကြည်စိတ်ချရသူ တာဝန်ခံဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="32" style="v" />သူတို့ညီအစ်ကို ကောဟတ်အမျိုးသားတချို့က အဆင့်ဆင့်တင်ထားတဲ့မုန့်ကို ဥပုသ်နေ့တိုင်း ပြင်ဆင်ဖို့ တာဝန်ယူရတယ်။
  </para>
  <para style="p">
    <verse number="33" style="v" />လေဝိအနွယ်ထဲမှာ သီချင်းသည်တွေလည်း ရှိတယ်။ သူတို့က ဆွေမျိုးစုခေါင်းဆောင်တွေ ဖြစ်ပြီး အိမ်တော်အခန်းတွေမှာ နေရတယ်။ နေ့ရောညပါ တာဝန်ထမ်းဆောင်ရတဲ့အတွက် တခြားတာဝန်တွေကနေ ကင်းလွတ်ခွင့်ရတယ်။
  </para>
  <para style="p">
    <verse number="34" style="v" />သူတို့ဟာ ဆွေစဉ်မျိုးဆက်စာရင်းအရ လေဝိအနွယ်ရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေဖြစ်ပြီး ဂျေရုဆလင်မြို့မှာပဲ နေထိုင်ရတယ်။
  </para>
  <para style="p">
    <verse number="35" style="v" />ယေယေလက ဂိဗောင်မြို့ကို တည်ထောင်ပြီး အဲဒီမှာပဲ နေထိုင်တယ်။ သူ့ဇနီးက မာခါ။
  </para>
  <para style="p">
    <verse number="36" style="v" />သားတွေက သားဦး အာဗဒုန်၊ ဇုရ၊ ကိရှ၊ ဗာလ၊ နေရ၊ နာဒပ်၊
  </para>
  <para style="p">
    <verse number="37" style="v" />ဂေဒေါ်၊ အဟိသြ၊ ဇာခရိ၊ မိကလုတ်။
  </para>
  <para style="p">
    <verse number="38" style="v" />မိကလုတ်မှာ ရှိမံလို့ခေါ်တဲ့ သားရှိတယ်။ သူတို့က ဂျေရုဆလင်မြို့မှာရှိတဲ့ ညီအစ်ကိုတွေအနားမှာပဲ တခြားဆွေမျိုးသားချင်းတွေနဲ့အတူ နေထိုင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="39" style="v" />နေရ ရဲ့သားက ကိရှ၊ ကိရှရဲ့သားက ရှောလု။ ရှောလုရဲ့သားတွေက ယောနသန်၊ မေလခိရွှ၊ အဘိနဒပ်၊ အိရှဗာလ။
  </para>
  <para style="p">
    <verse number="40" style="v" />ယောနသန်ရဲ့သားက မေရိဗာလ၊ မေရိဗာလရဲ့သားက မိက္ခာ။
  </para>
  <para style="p">
    <verse number="41" style="v" />မိက္ခာရဲ့သားတွေက ပိသုန်၊ မေလက်၊ တာရာ၊ အာခတ်။
  </para>
  <para style="p">
    <verse number="42" style="v" />အာခတ်ရဲ့သားက ယာရာ၊ ယာရာရဲ့သားတွေက အာလမက်၊ အာဇမာဝက်၊ ဇိမရိ။ ဇိမရိရဲ့သားက မောဇ၊
  </para>
  <para style="p">
    <verse number="43" style="v" />မောဇရဲ့သားက ဗိနာ၊ ဗိနာရဲ့သားက ရေဖာယ၊ ရေဖာယရဲ့သားက ဧလာသ၊ ဧလာသရဲ့သားက အာဇေလ။
  </para>
  <para style="p">
    <verse number="44" style="v" />အာဇေလမှာ အာဇရိကံ၊ ဗောခေရု၊ အိရှမေလ၊ ရှရိယ၊ သြဗဒိ၊ ဟာနန်လို့ခေါ်တဲ့ သားခြောက်ယောက် ရှိတယ်။ သူတို့ဟာ အာဇေလရဲ့သားတွေပဲ။
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဖိလိတိလူတွေက အစ္စရေးတွေနဲ့ စစ်တိုက်တယ်။ အစ္စရေးစစ်သည်တွေ ထွက်ပြေးရပြီး ဂိလဗောတောင်မှာ အတုံးအရုံး ကျဆုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဖိလိတိလူတွေက ရှောလုမင်းနဲ့ သားတော် ယောနသန်၊ အဘိနဒပ်၊ မေလခိရွှတို့ကို သဲကြီးမဲကြီး လိုက်တိုက်တယ်။ သားတော်သုံးယောက် အသတ်ခံလိုက်ရတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ရှောလုကိုလည်း ပြင်းပြင်းထန်ထန် တိုက်ခိုက်တဲ့အတွက် လေးသမားပစ်လိုက်တဲ့မြား ထိမှန်ပြီး ဒဏ်ရာရသွားတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဒါနဲ့ ရှောလုက သူ့လက်နက်ကိုင်ကို “မင်းရဲ့ဓားကို ထုတ်ပြီး ငါ့ကို ထိုးသတ်လိုက်စမ်း။ နို့မို့ဆိုရင် အရေဖျားမဖြတ်တဲ့ အဲဒီလူတွေ ငါ့ကို ရက်ရက်စက်စက် သတ်လိမ့်မယ်” လို့ အမိန့်ပေးတယ်။ ဒါပေမဲ့ လက်နက်ကိုင်က ကြောက်လွန်းလို့ မလုပ်ရဲဘူးဖြစ်နေတော့ ရှောလုက ဓားကိုထောင်ပြီး ဓားပေါ် မှောက်ချလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ရှောလု သေဆုံးတာကို မြင်တော့ သူ့လက်နက်ကိုင်လည်း ဓားပေါ်မှောက်ချပြီး သေသွားတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ရှောလုနဲ့ သားတော် သုံးယောက်အပြင် သူနဲ့အတူပါလာတဲ့ လူတွေအားလုံး သေဆုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ချိုင့်ဝှမ်းမှာရှိတဲ့ အစ္စရေးတွေလည်း စစ်သည်တွေ ထွက်ပြေးတာ၊ ရှောလုနဲ့ သားတော်တွေ တိုက်ပွဲကျသွားတာတွေကို ကြားသိတဲ့အခါ ကိုယ့်မြို့ကိုယ့်ရွာကို စွန့်ပြီး ထွက်ပြေးရတော့တယ်။ အဲဒီအခါ ဖိလိတိလူတွေက အဲဒီမြို့တွေမှာ ဝင်နေကြတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />နောက်တစ်နေ့မှာ ဖိလိတိလူတွေက ကျဆုံးသူတွေရဲ့ ပစ္စည်းတန်ဆာတွေကို ချွတ်ယူဖို့ လာတဲ့အခါ ဂိလဗောတောင်ပေါ်မှာ ရှောလုနဲ့ သားတော်တွေ သေဆုံးနေတာကို တွေ့တယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဒါနဲ့ ရှောလုရဲ့ ခေါင်းကို ဖြတ်ပြီး သူ့ချပ်ဝတ်တန်ဆာတွေကို ချွတ်ယူကြတယ်။ ပြီးတော့ ဖိလိတိတစ်ပြည်လုံးကို တမန်တွေ လွှတ်ပြီး သူတို့ရဲ့ ဘုရားကျောင်းတွေမှာ၊ လူတွေအလယ်မှာ သတင်းပျံ့သွားအောင် လုပ်တယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အဲဒီနောက် ရှောလုရဲ့ ချပ်ဝတ်တန်ဆာကို သူတို့ရဲ့ ဘုရားကျောင်းမှာ ထားပြီး ခေါင်းကိုတော့ ဒါဂုန်ဘုရားကျောင်းမှာ ချိတ်ဆွဲထားလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ရှောလုကို ဖိလိတိလူတွေ အဲဒီလိုလုပ်လိုက်မှန်း ဂိလဒ်ပြည်၊ ယာဗက်မြို့သားတွေ ကြားတဲ့အခါ၊
  </para>
  <para style="p">
    <verse number="12" style="v" />စစ်သည်တွေက ရှောလုနဲ့ သားတော်တွေရဲ့ အလောင်းကို သွားသယ်ပြီး ယာဗက်မြို့ကို ယူလာကြတယ်။ အရိုးတွေကို ယာဗက်မြို့မှာရှိတဲ့ အပင်ကြီးအောက်မှာ မြှုပ်လိုက်တယ်။ ပြီးတော့ ခုနစ်ရက် အစာရှောင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ရှောလုဟာ ယေဟောဝါရဲ့စကားကို မနာခံဘဲ ယေဟောဝါကို သစ္စာဖောက်တဲ့အတွက်၊ နတ်ကတော်ကို တိုင်ပင်မေးမြန်းတဲ့အတွက် သေဆုံးခဲ့ရတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />သူက ယေဟောဝါကို မမေးမြန်းခဲ့ဘူး။ ဒါကြောင့် ဘုရားသခင်က သူ့ကို အဆုံးစီရင်ပြီး ထီးနန်းကို ယေရှဲရဲ့သား ဒါဝိဒ်ဆီ လွှဲပြောင်းပေးလိုက်တယ်။
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />နောက်ပိုင်းမှာ အစ္စရေးအားလုံးက ဒါဝိဒ်ရှိတဲ့ ဟေဗြုန်မြို့ကို စုရုံးလာပြီး “ကျွန်တော်တို့ဟာ ခင်ဗျားရဲ့ သွေးသားရင်းချာတွေပါ။
  </para>
  <para style="p">
    <verse number="2" style="v" />ရှောလုမင်း လက်ထက်ကတည်းက ခင်ဗျားဟာ အစ္စရေးတပ်ကို ဦးစီးပြီး တိုက်ပွဲဝင်ခဲ့သူပါ။ ယေဟောဝါဘုရားကလည်း ‘ငါ့လူမျိုး အစ္စရေးကို မင်း ထိန်းကျောင်းရမယ်။ မင်းဟာ အစ္စရေးခေါင်းဆောင် ဖြစ်လာမယ်’ လို့ မိန့်မှာထားတာပဲ” ဆိုပြီး ပြောကြတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဒါနဲ့ ဒါဝိဒ်ရှိတဲ့ ဟေဗြုန်မြို့ကို အစ္စရေးအကြီးအကဲအားလုံး ရောက်လာတယ်။ ဒါဝိဒ်လည်း ဟေဗြုန်မြို့၊ ယေဟောဝါရှေ့မှာ သူတို့နဲ့ ကတိသစ္စာပြုတယ်။ ရှမွေလကတစ်ဆင့် ယေဟောဝါ ပြောခဲ့တဲ့အတိုင်း ဒါဝိဒ်ကို အစ္စရေးဘုရင်အဖြစ် သူတို့ ဘိသိက်ပေးကြတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />နောက်တော့ ဒါဝိဒ်နဲ့ အစ္စရေးတွေက ယေဗုတ်လို့ခေါ်တဲ့ ဂျေရုဆလင်မြို့ကို ချီတက်သွားတယ်။ အဲဒီမှာ ယေဗုသိလူမျိုးတွေ နေထိုင်တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ယေဗုတ်မြို့သားတွေက “ဒီမြို့ထဲကို မင်း လုံးဝ မဝင်ရဘူး” ဆိုပြီး ဒါဝိဒ်ကို ခနဲ့တဲ့တဲ့ ပြောကြတယ်။ ဒါပေမဲ့ ဒါဝိဒ်က ဇိအုန်ခံတပ်ကို သိမ်းပိုက်ခဲ့တယ်။ အခုတော့ အဲဒီနေရာက ဒါဝိဒ်မြို့လို့ နာမည်တွင်နေပြီ။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဒါဝိဒ်က “ယေဗုသိလူတွေကို ဦးဆုံးတိုက်နိုင်တဲ့သူ ဗိုလ်ချုပ်ဖြစ်စေ” လို့ပြောတော့ ဇေရုယာရဲ့သား ယွာဘက ဦးဆုံးတိုက်ခိုက်တဲ့အတွက် ဗိုလ်ချုပ်ဖြစ်လာတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />နောက်တော့ ဒါဝိဒ်က ဇိအုန်ခံတပ်မြို့မှာ နေထိုင်တယ်။ ဒါကြောင့် အဲဒီမြို့ကို ဒါဝိဒ်မြို့လို့ခေါ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဒါဝိဒ်က တောင်ကုန်း ပေါ်မှာရော ပတ်ဝန်းကျင်ဒေသတွေမှာပါ မြို့ရိုးနဲ့ တခြားအဆောက်အအုံတွေ ဆောက်လုပ်တယ်။ မြို့ထဲက ကျန်တဲ့နေရာတွေကိုတော့ ယွာဘပြုပြင်တယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဒီလိုနဲ့ ဒါဝိဒ်ဟာ အင်အားကြီးသည်ထက် ကြီးလာတယ်။ ဗိုလ်ခြေတို့ရဲ့အရှင် ယေဟောဝါလည်း သူနဲ့အတူရှိတယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အစ္စရေးတွေကို ယေဟောဝါ ကတိပေးထားတဲ့အတိုင်း ဒါဝိဒ်ကို မင်းမြှောက်ဖို့ အစ္စရေးအားလုံးနဲ့အတူအစွမ်းကုန် ထောက်မကူညီခဲ့တဲ့ ခေါင်းဆောင်သူရဲကောင်းတွေ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />သူတို့ရဲ့နာမည်တွေကတော့– သူရဲကောင်းသုံးယောက်ထဲမှာ ခေါင်းဆောင်ဖြစ်တဲ့ ဟခမောနိအမျိုးသား ယာရှောဗံ။ သူက လှံကိုကိုင်ပြီး တစ်ချီတည်းနဲ့ လူ ၃၀၀ ကို သတ်ပစ်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />နောက်တစ်ယောက်က သူရဲကောင်းသုံးယောက်အဝင်ဖြစ်တဲ့ အဟောဟိအမျိုးသား ဒေါဒေါရဲ့သား ဧလာဇာ။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဖိလိတိတွေ စစ်တိုက်ဖို့ စုရုံးခဲ့တဲ့ ပါဒမိမ်အရပ်မှာ သူက ဒါဝိဒ်နဲ့အတူရှိခဲ့တယ်။ အဲဒီမှာ မုယောစပါး စိုက်ထားတဲ့ လယ်တစ်ကွက် ရှိတယ်။ ဖိလိတိတွေကြောင့် လူတွေ ထွက်ပြေးတဲ့အခါ၊
  </para>
  <para style="p">
    <verse number="14" style="v" />ဧလာဇာက လယ်ကွက်အလယ်မှာရပ်ပြီး ဖိလိတိလူတွေကို ခုခံတိုက်ခိုက်တယ်။ ဒါကြောင့် ယေဟောဝါက အကြီးအကျယ် အောင်ပွဲခံစေခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဖိလိတိတပ်က ရေဖိမ်ချိုင့်ဝှမ်းမှာ စခန်းချနေတဲ့အခါ ခေါင်းဆောင် ၃၀ ထဲက သုံးယောက်ဟာ ဒါဝိဒ်ရှိတဲ့ အဒုလံလိုဏ်ဂူကို ဆင်းသွားကြတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဒီအချိန်မှာ ဒါဝိဒ်က သူ့ရဲ့ခံတပ်မှာ ရောက်နေပြီး ဖိလိတိမြို့စောင့်တပ်ကတော့ ဘက်သလီဟင်မြို့မှာ ရှိနေတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒါဝိဒ်က “ဘက်သလီဟင်မြို့ တံခါးနားမှာရှိတဲ့ ရေလှောင်ကန်ထဲက ရေကို သောက်ချင်လိုက်တာ” လို့ တောင့်တပြီးပြောတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အဲဒီအခါ သူရဲကောင်းသုံးယောက်က ဖိလိတိတပ်ကို ထိုးဖောက်ပြီး ဘက်သလီဟင်မြို့ တံခါးနားမှာရှိတဲ့ ရေလှောင်ကန်ထဲက ရေကို ခပ်ယူလာတယ်။ ဒါပေမဲ့ ဒါဝိဒ်က မသောက်ဘဲ ယေဟောဝါရှေ့မှာ သွန်ချလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />“ဘုရားသခင်ရဲ့ရှုထောင့်ကနေ ကြည့်ရင် ဒီရေကိုသောက်ဖို့ ကျွန်တော် စဉ်းတောင် မစဉ်းစားဝံ့ပါဘူး။ သူတို့က အသက်ကို ရင်းပြီး ဒီရေကို ယူလာခဲ့တာ။ အဲဒီလို အသက်ကိုရင်းပြီး စွန့်စားခဲ့သူတွေရဲ့ သွေးကို ငါမသောက်ဘူး” လို့ပြောပြီး မသောက်ဘဲ နေလိုက်တယ်။ ဒါတွေဟာ သူရဲကောင်း သုံးယောက်ရဲ့ စွမ်းဆောင်ချက်တွေပဲ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ယွာဘရဲ့အစ်ကို အဘိရှဲကလည်း လူစွမ်းကောင်း သုံးယောက်ထဲမှာ ခေါင်းဆောင်ပဲ။ သူက လှံကိုကိုင်ပြီး လူ ၃၀၀ ကိုသတ်ပစ်ခဲ့တယ်။ သူရဲကောင်း သုံးယောက်လိုပဲ ဂုဏ်သတင်း ကျော်စောတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />သူက လူစွမ်းကောင်း သုံးယောက်ထဲမှာ ကျန်တဲ့နှစ်ယောက်ထက် ထင်ပေါ်ပြီး သူတို့ရဲ့ခေါင်းဆောင်ဖြစ်ပေမဲ့ သူရဲကောင်း သုံးယောက်ကိုတော့ မမီဘူး။
  </para>
  <para style="p">
    <verse number="22" style="v" />ယောယဒရဲ့သား ဗေနာယဟာ ရဲစွမ်းသတ္တိရှိသူ ဖြစ်ပြီး ကပ်ဇေလမြို့မှာ စွန့်စားတဲ့လုပ်ရပ် အများကြီး လုပ်ဆောင်ခဲ့တယ်။ မောဘလူမျိုးဖြစ်တဲ့ အေရေလရဲ့ သားနှစ်ယောက်ကို သတ်ခဲ့တယ်။ နှင်းကျတဲ့နေ့တစ်နေ့မှာ ရေတွင်းထဲ ဆင်းပြီး ခြင်္သေ့တစ်ကောင်ကို သူသတ်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />အရပ်ငါးတောင် ရှိတဲ့ အီဂျစ်လူထွားကြီးတစ်ယောက်ကိုလည်း သတ်ခဲ့တယ်။ အီဂျစ်လူက ရက်ကန်းလိပ်တုံးလောက် ကြီးတဲ့ လှံကို ကိုင်ထားပေမဲ့ ဗေနာယကတော့ တုတ်တစ်ချောင်းနဲ့ပဲ တိုက်ခိုက်တယ်။ ပြီးတော့ အီဂျစ်လူရဲ့လက်ထဲက လှံကို လုယူပြီး အဲဒီလှံနဲ့ပဲ ထိုးသတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဒါတွေဟာ ယောယဒရဲ့သား ဗေနာယရဲ့ စွမ်းဆောင်ချက်တွေ ဖြစ်တယ်။ သူရဲကောင်းသုံးယောက်လိုပဲ သူလည်း ဂုဏ်သတင်းကျော်စောတယ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သူက ခေါင်းဆောင် ၃၀ ထက် ထင်ပေါ်ပေမဲ့ သူရဲကောင်းသုံးယောက်ကိုတော့ မမီဘူး။ ဒါပေမဲ့ ဒါဝိဒ်က သူ့ကို ကိုယ်ရံတော် ခန့်ထားတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />အစ္စရေး တပ်မှာရှိတဲ့ တခြားသူရဲကောင်းတွေကတော့ ယွာဘရဲ့ညီ အာသဟေလ၊ ဘက်သလီဟင်မြို့သား ဒေါဒေါရဲ့သား ဧလဟာနန်၊
  </para>
  <para style="p">
    <verse number="27" style="v" />ဟာရုတ်အရပ်သား ရှမုတ်၊ ပေလောနိလူ ဟေလက်၊
  </para>
  <para style="p">
    <verse number="28" style="v" />တေကောမြို့သား အိကေရှရဲ့သား အိရာ၊ အာနသုတ်မြို့သား အဗျေဇာ၊
  </para>
  <para style="p">
    <verse number="29" style="v" />ဟုရှအမျိုးသား သိဗေခဲ၊ အဟောဟိအမျိုးသား အိလဲ၊
  </para>
  <para style="p">
    <verse number="30" style="v" />နေတောဖရွာသား မဟာရဲ၊ နေတောဖရွာသား ဗာနာရဲ့သား ဟေလက်၊
  </para>
  <para style="p">
    <verse number="31" style="v" />ဂိဗာမြို့သား ဗင်ယာမိန်အနွယ် ရိဘဲရဲ့သား အိတ္တဲ၊ ပိရသုန်မြို့သား ဗေနာယ၊
  </para>
  <para style="p">
    <verse number="32" style="v" />ဂါရှသဲချောင်းတွေမှာနေတဲ့ ဟုရဲ၊ ဧရဗာမြို့သား အဗျေလ၊
  </para>
  <para style="p">
    <verse number="33" style="v" />ဗာဟုရိမ်ရွာသား အာဇမာဝက်၊ ရှာလဗိမ်မြို့သား ဧလျာဘာ၊
  </para>
  <para style="p">
    <verse number="34" style="v" />ဂိဇောနိမြို့သား ဟာရှိမ်ရဲ့သားတွေ၊ ဟာရာရိအမျိုးသား ရှာဂဲရဲ့သား ယောနသန်၊
  </para>
  <para style="p">
    <verse number="35" style="v" />ဟာရာရိအမျိုးသား စာကာရဲ့သား အဟိအံ၊ ဥရရဲ့သား ဧလိဖလ၊
  </para>
  <para style="p">
    <verse number="36" style="v" />မေခေရာအရပ်သား ဟေဖာ၊ ပေလောနိအမျိုးသား အဟိယ၊
  </para>
  <para style="p">
    <verse number="37" style="v" />ကရမေလမြို့သား ဟေဇရဲ၊ ဧဇဗဲရဲ့သား နာရဲ၊
  </para>
  <para style="p">
    <verse number="38" style="v" />နာသန်နဲ့ ညီအစ်ကိုတော်တဲ့ ယောလ၊ ဟေဂရိရဲ့သား မိဗဟာ၊
  </para>
  <para style="p">
    <verse number="39" style="v" />အမ္မုန်အမျိုးသား ဇေလက်၊ ဇေရုယာရဲ့သား ယွာဘရဲ့ လက်နက်ကိုင်ဖြစ်တဲ့ ဗေရုတ်မြို့သား နဟာရဲ၊
  </para>
  <para style="p">
    <verse number="40" style="v" />အိသရိဆွေမျိုးစုထဲက အိရာနဲ့ ဂါရက်၊
  </para>
  <para style="p">
    <verse number="41" style="v" />ဟိတ္တိလူမျိုးဥရိယ၊ အာလဲရဲ့သား ဇာဗဒ်၊
  </para>
  <para style="p">
    <verse number="42" style="v" />ရုဗင်အမျိုးသား ရှိဇရဲ့သား ခေါင်းဆောင် အဒိနတို့ဖြစ်တယ်။ အဒိနလက်အောက်မှာ ရုဗင်အမျိုးသား ၃၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="43" style="v" />မာခါရဲ့သား ဟာနန်၊ မိသနိအမျိုးသား ယောရှာဖတ်၊
  </para>
  <para style="p">
    <verse number="44" style="v" />အာရှတရုတ်မြို့သား သြဇိယ၊ အာရော်မြို့သား ဟောသံရဲ့သားတွေဖြစ်တဲ့ ရှာမနဲ့ ယေယေလ၊
  </para>
  <para style="p">
    <verse number="45" style="v" />ရှိမရိရဲ့သား ယေဒယေလ၊ သူနဲ့ညီအစ်ကိုတော်တဲ့ တိဇိမြို့သား ယောဟ၊
  </para>
  <para style="p">
    <verse number="46" style="v" />မဟာဝိအမျိုးသား ဧလျလေ၊ ဧလနန်ရဲ့သားတွေ ဖြစ်တဲ့ ယေရိဗဲနဲ့ ယောရှဝိ၊ မောဘအမျိုးသား အိသမ၊
  </para>
  <para style="p">
    <verse number="47" style="v" />ဧလျေလ၊ ဩဗက်၊ မေဇောဗိတ်အရပ်သား ယာသေလတို့ဖြစ်တယ်။
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်က ကိရှရဲ့သား ရှောလုရဲ့ရန်ကြောင့် ထွက်ပြေးပြီး ဇိကလတ်မြို့မှာ ပုန်းရှောင်နေတယ်။ အဲဒီအချိန်မှာ အတူတိုက်ပွဲဝင်ဖို့ ဒါဝိဒ်ဆီ ရောက်လာတဲ့ သူရဲကောင်းတွေရှိတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />သူတို့ဟာ ဗင်ယာမိန်အနွယ် ရှောလုရဲ့အမျိုးတွေပဲ။ လေးသည်တော်တွေ၊ ဘယ်လက်နဲ့ရော ညာလက်နဲ့ပါ လောက်လွှဲတွေ၊ လေးတွေကို ပစ်နိုင်သူတွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဂိဗာမြို့သား ရှေမာရဲ့သားတွေဖြစ်တဲ့ ခေါင်းဆောင် အဟေဇာနဲ့ ယောရှ၊ အာဇမာဝက်ရဲ့ သားတွေဖြစ်တဲ့ ယေဇေလနဲ့ ပေလက်၊ ဗေရာခ၊ အာနသုတ်မြို့သား ယေဟု၊
  </para>
  <para style="p">
    <verse number="4" style="v" />ခေါင်းဆောင် ၃၀ ကို ကြီးကြပ်ရတဲ့ သူရဲကောင်း ဂိဗောင်မြို့သား အိရှမာယ၊ ယေရမိ၊ ယဟာဇေလ၊ ယောဟနန်၊ ဂေဒရအရပ်သား ယောဇဗတ်၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ဧလုဇဲ၊ ယေရိမုတ်၊ ဗာလျာ၊ ရှေမရိ၊ ဟာရိပ်အမျိုးသား ရှေဖတိ၊
  </para>
  <para style="p">
    <verse number="6" style="v" />ကောရအမျိုးသားတွေဖြစ်တဲ့ ဧလကာန၊ အိရှယ၊ အာဇာရေလ၊ ယောဇာ၊ ယာရှောဗံ၊
  </para>
  <para style="p">
    <verse number="7" style="v" />ဂေဒေါ်မြို့သား ယေရောဟံရဲ့သားတွေဖြစ်တဲ့ ယောလာနဲ့ ဇေဗဒိတို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဂဒ်အမျိုးသားတချို့လည်း တောကန္တာရထဲက ခံတပ်မှာရှိနေတဲ့ ဒါဝိဒ်နဲ့ လာပူးပေါင်းကြတယ်။ သူတို့ဟာ ဒိုင်းလွှားကြီးနဲ့ လှံရှည်ကို အသင့်ဆောင်ထားတဲ့ စစ်ရေးကျွမ်းကျင်သူတွေ၊ ခြင်္သေ့လို မျက်နှာမျိုးရှိတဲ့သူတွေ၊ တောင်တန်းပေါ်ကဒရယ်လို လျင်မြန်တဲ့ သူရဲကောင်းတွေပဲ။
  </para>
  <para style="p">
    <verse number="9" style="v" />စစ်မက်ရေးရာမှာ အကျွမ်းကျင်ဆုံးက ဧဇာ၊ ဒုတိယ သြဗဒိ၊ တတိယ ဧလျာဘ၊
  </para>
  <para style="p">
    <verse number="10" style="v" />စတုတ္ထ မိရှမန္န၊ ပဉ္စမ ယေရမိ၊
  </para>
  <para style="p">
    <verse number="11" style="v" />ဆဋ္ဌမ အတ္တဲ၊ သတ္တမ ဧလျေလ၊
  </para>
  <para style="p">
    <verse number="12" style="v" />အဋ္ဌမ ယောဟနန်၊ နဝမ ဧလဇာဗဒ်၊
  </para>
  <para style="p">
    <verse number="13" style="v" />ဒသမ ယေရမိ၊ ဆယ့်တစ်ယောက်မြောက် မာခဗာနဲ။
  </para>
  <para style="p">
    <verse number="14" style="v" />သူတို့ဟာ ဂဒ်အမျိုးသား စစ်ဗိုလ်တွေပဲ။ သူတို့ထဲက အညံ့ဆုံးတောင် လူအင်အား အယောက် ၁၀၀ နဲ့ညီပြီး အတော်ဆုံးက လူအင်အား အယောက် ၁,၀၀၀ နဲ့ညီတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />သူတို့က ဂျော်ဒန်မြစ်ကမ်း တစ်လျှောက် မြစ်ရေလျှံတဲ့ ပထမလမှာ ဖြတ်ကူးပြီးနောက် မြေနိမ့်ဒေသမှာ နေထိုင်သူတွေကို အရှေ့ဘက်နဲ့ အနောက်ဘက်ဆီ ကွဲလွင့်သွားအောင် မောင်းထုတ်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဗင်ယာမိန်အမျိုးသားတချို့နဲ့ ယုဒအမျိုးသားတချို့လည်း ဒါဝိဒ်ရဲ့ခံတပ်ဆီ ရောက်လာတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒါဝိဒ်က ထွက်လာပြီး “ငါ့ကို တကယ် ကူညီပေးချင်လို့ ရောက်လာတာဆိုရင် ငါလည်း မင်းတို့နဲ့ တစ်စိတ်တစ်ဝမ်းတည်းပါပဲ။ ဘာအမှားမှ မလုပ်တဲ့ ငါ့ကို ရန်သူတွေလက်ထဲ အပ်ဖို့ လာတာဆိုရင်တော့ ဘိုးဘေးတို့ရဲ့ ဘုရားသခင်ပဲ တရားစီရင်ပါစေ” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အဲဒီအခါ လူ ၃၀ ရဲ့ခေါင်းဆောင် အာမသဲအပေါ် စွမ်းအားတော် သက်ရောက်လာတယ်။ ဒါကြောင့် အာမသဲက “ဒါဝိဒ်၊ ကျွန်တော်တို့ဟာ ခင်ဗျားရဲ့လူတွေပါ။ ယေရှဲရဲ့သား၊ ခင်ဗျားဘက်မှာ ကျွန်တော်တို့ ရှိပါတယ်။ ဘုရားသခင် ကူညီနေတဲ့အတွက် ခင်ဗျားဆီမှာ ငြိမ်သက်ခြင်း ရှိပါစေ။ ခင်ဗျားကို ကူညီတဲ့သူလည်း ငြိမ်သက်ခြင်းရှိပါစေ” လို့ပြောတယ်။ ဒါဝိဒ်လည်း သူတို့ကို လက်ခံပြီး စစ်ဗိုလ်တွေအဖြစ် ခန့်အပ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ရှောလုကို တိုက်ဖို့ ဖိလိတိတွေ ချီတက်လာတဲ့အခါ ဒါဝိဒ်လည်း အတူလိုက်လာတယ်။ အဲဒီအချိန်မှာ မနာရှေအမျိုးသားတချို့ ဒါဝိဒ်နဲ့ လာပူးပေါင်းကြတယ်။ ဖိလိတိမင်းတွေက “ဒီလူ သူ့သခင်ရှောလုနဲ့ ပြန်ပူးပေါင်းမှာ။ အဲဒီအခါ ငါတို့ ခေါင်းပြတ်နေဦးမယ်” လို့တိုင်ပင်ပြီးနောက် ပြန်လွှတ်လိုက်တဲ့အတွက် ဒါဝိဒ်လည်း ဖိလိတိတွေကို မကူညီတော့ဘဲ၊
  </para>
  <para style="p">
    <verse number="20" style="v" />ဇိကလတ်မြို့ကို ပြန်လာတယ်။ အဲဒီအခါ မနာရှေအနွယ်ထဲက လူတစ်ထောင်အုပ်တွေဖြစ်တဲ့ အာဒန၊ ယောဇဗတ်၊ ယေဒယေလ၊ မိက္ခာ၊ ယောဇဗတ်၊ ဧလိဟု၊ ဇိလသဲတို့က ဒါဝိဒ်နဲ့ လာပူးပေါင်းကြတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />သူတို့အားလုံးက ရဲစွမ်းသတ္တိရှိသူတွေ ဖြစ်တဲ့အတွက် ဓားပြတွေကို တိုက်ခိုက်ရာမှာ ဒါဝိဒ်ကို ကူညီပေးကြတယ်။ နောက်ပိုင်းမှာ သူတို့ဟာ စစ်ဗိုလ်တွေ ဖြစ်လာတယ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ကူညီမယ့်သူတွေ တစ်ရက်ပြီးတစ်ရက် တဖွဲဖွဲ ရောက်လာတဲ့အတွက် ဒါဝိဒ်ရဲ့တပ်က ဘုရားသခင်ရဲ့ တပ်မဟာလို အင်အားကြီးလာတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />ယေဟောဝါရဲ့ အမိန့်အတိုင်း ရှောလုရဲ့ ထီးနန်းကို လွှဲပြောင်းပေးဖို့ ဒါဝိဒ်ရှိရာ ဟေဗြုန်မြို့ကို လက်နက်ကိုင် စစ်သည်တွေ ရောက်လာတယ်။ သူတို့ရဲ့အရေအတွက်ကတော့၊
  </para>
  <para style="p">
    <verse number="24" style="v" />ယုဒအနွယ်မှာ ဒိုင်းလွှားကြီးနဲ့ လှံရှည်ကိုင်ဆောင်တဲ့ စစ်သည် ၆,၈၀၀၊
  </para>
  <para style="p">
    <verse number="25" style="v" />ရှိမောင်အနွယ်မှာ ခွန်အားကြီးပြီး သတ္တိရှိတဲ့ စစ်သည် ၇,၁၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />လေဝိအနွယ်မှာ ၄,၆၀၀၊
  </para>
  <para style="p">
    <verse number="27" style="v" />အာရုန်သားမြေးတွေရဲ့ခေါင်းဆောင် ယောယဒနဲ့ သူ့လူ ၃,၇၀၀၊
  </para>
  <para style="p">
    <verse number="28" style="v" />ခွန်အားကြီးပြီး သတ္တိရှိတဲ့ လူငယ်ဇာဒုတ်နဲ့ သူ့ရဲ့ဆွေမျိုးစုခေါင်းဆောင် ၂၂ ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ရှောလုရဲ့အမျိုး ဗင်ယာမိန်အနွယ်မှာ ၃,၀၀၀ ရှိတယ်။ သူတို့အနွယ်ထဲက အများစုဟာ အရင်တုန်းက ရှောလုအမျိုးအပေါ် သစ္စာစောင့်သိခဲ့ကြတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဧဖရိမ်အနွယ်ရဲ့ ဆွေမျိုးစုတွေထဲမှာ ၂၀,၈၀၀ ရှိတယ်။ သူတို့ဟာ ခွန်အားကြီးပြီး သတ္တိရှိတယ်လို့ ဂုဏ်သတင်းကြီးတဲ့သူတွေပဲ။
  </para>
  <para style="p">
    <verse number="31" style="v" />မနာရှေအနွယ်တစ်ဝက်မှာ ဒါဝိဒ်ဆီလာပြီး မင်းမြှောက်ဖို့ နာမည်နဲ့တကွ ရွေးချယ်ခံရသူပေါင်း ၁၈,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="32" style="v" />အိသခါအနွယ်မှာ အချိန်အခါကို နားလည်ပြီး အစ္စရေးတွေ လုပ်သင့်လုပ်အပ်ရာကို သိမြင်တဲ့ ခေါင်းဆောင် ၂၀၀ နဲ့ သူတို့လက်အောက်မှာရှိတဲ့ ညီအစ်ကိုတွေ။
  </para>
  <para style="p">
    <verse number="33" style="v" />ဇာဗုလုန်အနွယ်မှာ လက်နက်အမျိုးမျိုးနဲ့ တပ်ကို ခင်းကျင်းနိုင်ပြီး စစ်မှုထမ်းနိုင်သူ၊ ဒါဝိဒ်အပေါ် အကြွင်းမဲ့ သစ္စာစောင့်သိသူ ၅၀,၀၀၀။
  </para>
  <para style="p">
    <verse number="34" style="v" />နဿလိအနွယ်မှာ စစ်ဗိုလ် ၁,၀၀၀၊ ဒိုင်းလွှားကြီးနဲ့ လှံရှည်ကိုင်ဆောင်သူ ၃၇,၀၀၀။
  </para>
  <para style="p">
    <verse number="35" style="v" />ဒန်အနွယ်မှာ တပ်ကို ခင်းကျင်းနိုင်သူ ၂၈,၆၀၀။
  </para>
  <para style="p">
    <verse number="36" style="v" />အာရှာအနွယ်မှာ တပ်ကို ခင်းကျင်းနိုင်ပြီး စစ်မှုထမ်းနိုင်သူ ၄၀,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="37" style="v" />ဂျော်ဒန်မြစ်တစ်ဖက်က ရုဗင်အနွယ်၊ ဂဒ်အနွယ်နဲ့ မနာရှေအနွယ်တစ်ဝက်မှာ လက်နက်အမျိုးမျိုး ကိုင်ဆောင်သူ စစ်သည် ၁၂၀,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="38" style="v" />သူတို့အားလုံးဟာ စစ်သည်တွေ၊ တိုက်ပွဲဝင်နိုင်သူတွေပဲ။ ဒါဝိဒ်ကို အစ္စရေးဘုရင်အဖြစ် မင်းမြှောက်ဖို့ အခိုင်အမာ စိတ်ပိုင်းဖြတ်ပြီး ဟေဗြုန်မြို့ကို ရောက်လာကြတယ်။ ကျန်တဲ့အစ္စရေးတွေလည်း တစ်စိတ်တစ်ဝမ်းတည်းဖြစ်ပြီး ဒါဝိဒ်ကို မင်းမြှောက်ချင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="39" style="v" />သူတို့ဟာ ညီအစ်ကိုတွေ ပြင်ဆင်ပေးထားတာတွေကို စားသောက်ပြီး ဒါဝိဒ်နဲ့အတူ သုံးရက်နေကြတယ်။
  </para>
  <para style="p">
    <verse number="40" style="v" />ရပ်နီးမှာ နေထိုင်သူတွေရော အိသခါ၊ ဇာဗုလုန်နဲ့ နဿလိနယ်မြေစတဲ့ ရပ်ဝေးမှာ နေထိုင်သူတွေပါ စားစရာတွေ အများကြီး သယ်လာကြတယ်။ ဂျုံနဲ့လုပ်တဲ့ မုန့်တွေ၊ သဖန်းသီးပျဉ်နဲ့ စပျစ်သီးပျဉ်တွေ၊ ဆီနဲ့ စပျစ်ဝိုင်တွေကို နွား၊ မြည်း၊ ကုလားအုတ်နဲ့ လားတွေပေါ် တင်ပြီးသယ်လာတယ်။ သိုးနွားတွေလည်း ပါတယ်။ ဒီလိုနဲ့ အစ္စရေးပြည်မှာ ရွှင်လန်း ဝမ်းမြောက်နေကြတယ်။
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်က လူတစ်ထောင်အုပ်တွေ၊ လူတစ်ရာအုပ်တွေ၊ ခေါင်းဆောင်တွေနဲ့ တိုင်ပင်ပြီးနောက်၊
  </para>
  <para style="p">
    <verse number="2" style="v" />အစ္စရေးလူစုကြီးကို “ခင်ဗျားတို့ သဘောတူမယ်၊ ယေဟောဝါဘုရားလည်း နှစ်သက်မယ်ဆိုရင် အစ္စရေးနယ်မြေအသီးသီးက ကျန်တဲ့ညီအစ်ကိုတွေ၊ စားကျက်မြေပါတဲ့ မြို့တွေမှာ နေထိုင်တဲ့ ပုရောဟိတ်တွေ၊ လေဝိအမျိုးသားတွေကို ကျွန်တော်တို့နဲ့ လာပူးပေါင်းဖို့ အကြောင်းကြားရအောင်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဘုရားသခင်ရဲ့ သေတ္တာတော်ကိုလည်း ပြန်သယ်လာရအောင်” ဆိုပြီး ပြောတယ်။ ဘာကြောင့်လဲဆိုတော့ ရှောလုလက်ထက်မှာ သေတ္တာတော်ကို ဂရုမစိုက်ခဲ့ကြလို့ပဲ။
  </para>
  <para style="p">
    <verse number="4" style="v" />လူအားလုံးက အဲဒီအကြံပေးချက်ကို နှစ်သက်တဲ့အတွက် အဲဒီအတိုင်းလုပ်ဖို့ သဘောတူကြတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဒါဝိဒ်လည်း စစ်မှန်တဲ့ဘုရားသခင်ရဲ့ သေတ္တာတော်ကို ကိရယတ်ယာရိမ်မြို့ကနေ သယ်လာဖို့ အီဂျစ်ပြည်မှာရှိတဲ့ မြစ် ကနေ ဟာမတ်လမ်းဝ တစ်လျှောက်မှာရှိတဲ့ အစ္စရေးတွေကို စုဝေးခိုင်းတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />အဲဒီနောက် ဒါဝိဒ်နဲ့အစ္စရေးတွေက ခေရုဗိမ်တွေပေါ် စံမြန်းတဲ့အရှင် စစ်မှန်တဲ့ ဘုရားသခင်ရဲ့ သေတ္တာတော်ကို ပြန်သယ်လာဖို့ ယုဒနယ်မြေမှာရှိတဲ့ ဗာလာမြို့ လို့လည်းခေါ်တဲ့ ကိရယတ်ယာရိမ်မြို့ကို သွားကြတယ်။ လူတွေက သေတ္တာတော်ရှိတဲ့နေရာမှာ ယေဟောဝါရဲ့နာမည်ကို ခေါ်ပြီး ဆုတောင်းလေ့ရှိတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />သူတို့က ဘုရားသခင့် သေတ္တာတော်ကို လှည်းအသစ်ပေါ် တင်ပြီး အဘိနဒပ်ရဲ့အိမ်ကနေ သယ်သွားတယ်။ သြဇနဲ့ အဟိသြက လှည်းကို မောင်းတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဒါဝိဒ်နဲ့ အစ္စရေးတွေက ဘုရားသခင်ရှေ့မှာ အားပါးတရ ပွဲခံပြီး စောင်း၊ လင်းကွင်း၊ ချူတပ်ဗုံ၊ ခရာတွေ၊ ကြိုးတပ်တူရိယာတွေ တီးမှုတ်ရင်း သီချင်းဆိုကြတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဒါပေမဲ့ ခိဒုန်ကောက်နယ်တလင်းကို ရောက်လာတဲ့အခါ နွားတွေကြောင့် ပြုတ်ကျမလို ဖြစ်သွားတဲ့ သေတ္တာတော်ကို ဩဇ လှမ်းထိန်းလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />သေတ္တာတော်ကို လှမ်းကိုင်လိုက်လို့ သြဇကို ယေဟောဝါ အမျက်ထွက်ပြီး ဒဏ်ခတ်လိုက်တယ်။ ဘုရားသခင်ရှေ့၊ အဲဒီမှာတင် ဩဇ သေဆုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />သြဇကို ယေဟောဝါ အမျက်ထွက်တဲ့အတွက် ဒါဝိဒ် စိတ်ဆိုးတယ်။ အဲဒီနေရာကို ပေရက်သြဇ လို့ခေါ်ကြတာ ဒီနေ့အထိပဲ။
  </para>
  <para style="p">
    <verse number="12" style="v" />အဲဒီနေ့မှာ ဒါဝိဒ်က ဘုရားသခင်ကို ကြောက်ပြီး “ဘုရားသခင်ရဲ့ သေတ္တာတော်ကို ငါ့ဆီ ဘယ်လိုသယ်ရပါ့မလဲ” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />အဲဒီနောက် သေတ္တာတော်ကို သူနေထိုင်တဲ့ ဒါဝိဒ်မြို့ကို သယ်သွားမယ့်အစား သြဗက်ဧဒုံရဲ့အိမ်ဆီ သယ်သွားခိုင်းတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />သေတ္တာတော်ဟာ သြဗက်ဧဒုံရဲ့အိမ်မှာ အိမ်သားတွေနဲ့အတူ သုံးလ ရှိနေတယ်။ ယေဟောဝါလည်း သြဗက်ဧဒုံရဲ့ အိမ်သားတွေနဲ့ သူပိုင်ဆိုင်သမျှကို ကောင်းချီးပေးတယ်။
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />တိုင်ရာဘုရင် ဟိရံက ဒါဝိဒ်ဆီ တမန်တွေ စေလွှတ်ပြီး နန်းတော်တည်ဆောက်ဖို့ သစ်ကတိုးသားတွေ၊ ကျောက်ဆစ်သမားတွေ၊ လက်သမားတွေကို ပို့လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ယေဟောဝါက လူမျိုးတော် အစ္စရေးတွေရဲ့ အကျိုးအတွက် ဒါဝိဒ်ရဲ့ တန်ခိုးအာဏာကို ကြီးမားစေတယ်။ ဒါကြောင့် ဒါဝိဒ်က အစ္စရေးဘုရင်အဖြစ် မိမိကို မင်းမြှောက်တာ ဘုရားသခင်ပဲဆိုတာ သိတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဒါဝိဒ်က ဂျေရုဆလင်မြို့မှာ မိဖုရားတွေ ထပ်ပြီးသိမ်းပိုက်တဲ့အတွက် သားသမီးတွေ ထပ်ရလာတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဂျေရုဆလင်မြို့မှာ ဒါဝိဒ်ရတဲ့ သားသမီးတွေက ရှမွာ၊ ရှောဗပ်၊ နာသန်၊ ရှောလမုန်၊
  </para>
  <para style="p">
    <verse number="5" style="v" />အိဗဟာ၊ ဧလိရွှ၊ ဧလိပလက်၊
  </para>
  <para style="p">
    <verse number="6" style="v" />နောဂ၊ နေဖက်၊ ယာဖျာ၊
  </para>
  <para style="p">
    <verse number="7" style="v" />ဧလိရှမာ၊ ဗေလျာဒ၊ ဧလိဖလက်တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဒါဝိဒ်ကို အစ္စရေးဘုရင်အဖြစ် ဘိသိက်ပေးလိုက်ပြီဆိုတာ ဖိလိတိတွေ ကြားတဲ့အခါ ဒါဝိဒ်ကို ရှာဖို့ ချီတက်လာတယ်။ ဒီအကြောင်းကို ဒါဝိဒ်ကြားတော့ သူတို့ကိုတိုက်ဖို့ ထွက်လာတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဖိလိတိတွေလည်း ချီတက်လာပြီး ရေဖိမ်ချိုင့်ဝှမ်းမှာ နေထိုင်သူတွေကို တိုက်ခိုက်လုယက်တယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အဲဒီအခါ ဒါဝိဒ်က “ဖိလိတိတွေဆီ တက်သွားပြီး တိုက်ခိုက်ရမလား။ ကျွန်တော့်လက်ထဲ အပ်မှာလား” ဆိုပြီး ယေဟောဝါကိုမေးတော့ “တက်သွား။ သူတို့ကိုမင်းလက်ထဲငါဆက်ဆက်အပ်မယ်” လို့ဖြေတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဒါဝိဒ်လည်း ဗာလပေရဇိမ်အရပ်ကို တက်သွားပြီး သူတို့ကို ချေမှုန်းတယ်။ အဲဒီနောက် “အဟုန်ပြင်းပြင်းနဲ့ ဖြိုခွင်းတဲ့ရေလို စစ်မှန်တဲ့ဘုရားသခင်က ငါ့ကိုသုံးပြီး ရန်သူတွေကို ဖြိုခွင်းလိုက်ပြီ” လို့ပြောတယ်။ ဒါကြောင့် အဲဒီအရပ်ကို ဗာလပေရဇိမ် ဆိုပြီး သမုတ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဖိလိတိတွေက သူတို့ရဲ့ ဘုရားရုပ်တုတွေကို အဲဒီအရပ်မှာ ထားရစ်ခဲ့တယ်။ ဒါဝိဒ်ရဲ့အမိန့်နဲ့ အဲဒီဘုရားရုပ်တုတွေကို မီးရှို့လိုက်ကြတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />နောက်ပိုင်းမှာ ဖိလိတိတွေက ချိုင့်ဝှမ်းဒေသကို တိုက်ခိုက် လုယက်ပြန်တယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဒါကြောင့် ဒါဝိဒ်က ဘုရားသခင်ကို ထပ်မေးကြည့်တဲ့အခါ “သူတို့ဆီ တည့်တည့်မတက်သွားဘဲ အနောက်ဘက်ကနေ ပတ်သွားပြီး ဘာကာချုံတောရှေ့မှာ တိုက်ခိုက်ပါ။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဘာကာချုံပင်ရဲ့ ထိပ်ဖျားကနေ ထွက်ပေါ်လာတဲ့ စစ်ချီသံကို ကြားတာနဲ့ စတိုက်ပေတော့။ ဘုရားသခင်က မင်းရှေ့ကနေ သွားပြီး ဖိလိတိတပ်ကို ချေမှုန်းမယ်” လို့ဖြေတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဒါဝိဒ်လည်း ဘုရားသခင် မိန့်မှာတဲ့အတိုင်း လိုက်နာတယ်။ ဖိလိတိတပ်ကို ဂိဗောင်မြို့ကနေ ဂေဇာမြို့အထိ ချေမှုန်းတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒီလိုနဲ့ တိုင်းပြည်အသီးသီးမှာ ဒါဝိဒ်ရဲ့ဂုဏ်သတင်း ကျော်စောသွားတယ်။ လူမျိုးအားလုံး ဒါဝိဒ်ကို ကြောက်လာအောင် ယေဟောဝါ လုပ်ဆောင်ပေးတယ်။
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်က နန်းဆောင်တွေကို ဒါဝိဒ်မြို့မှာ ထပ်ပြီးတည်ဆောက်တယ်။ စစ်မှန်တဲ့ဘုရားသခင်ရဲ့ သေတ္တာတော်ထားဖို့ နေရာပြင်ဆင်ပြီး တဲတစ်ဆောင် တည်ဆောက်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />အဲဒီနောက် ဒါဝိဒ်က “ယေဟောဝါရဲ့ သေတ္တာတော်ကို ထမ်းဖို့၊ ယေဟောဝါရှေ့မှာ အမြဲအမှုဆောင်ဖို့ ရွေးချယ်ခံရသူတွေဟာ လေဝိအမျိုးသားတွေပဲ။ ဒါကြောင့် သေတ္တာတော်ကို လေဝိအမျိုးသားတွေကလွဲလို့ ဘယ်သူမှ မသယ်ရဘူး” ဆိုပြီး အမိန့်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ပြီးတော့ သူပြင်ဆင်ထားတဲ့ နေရာဆီ ယေဟောဝါရဲ့ သေတ္တာတော်ကို သယ်လာဖို့ အစ္စရေးအားလုံးကို ဂျေရုဆလင်မြို့မှာ စုရုံးလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဒါဝိဒ်စုရုံးလိုက်တဲ့ အာရုန်ရဲ့သားမြေးတွေနဲ့ လေဝိအမျိုးသားတွေကတော့၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ကောဟတ်အမျိုးသားတွေထဲမှာ ခေါင်းဆောင်ဥရေလနဲ့ ဆွေမျိုးသားချင်း ၁၂၀၊
  </para>
  <para style="p">
    <verse number="6" style="v" />မေရာရိရဲ့ သားမြေးတွေထဲမှာ ခေါင်းဆောင်အသာယနဲ့ ဆွေမျိုးသားချင်း ၂၂၀၊
  </para>
  <para style="p">
    <verse number="7" style="v" />ဂေရရှုံအမျိုးသားတွေထဲမှာ ခေါင်းဆောင်ယောလနဲ့ ဆွေမျိုးသားချင်း ၁၃၀၊
  </para>
  <para style="p">
    <verse number="8" style="v" />ဧလိဇာဖန်ရဲ့ သားမြေးတွေထဲမှာ ခေါင်းဆောင်ရှေမာယနဲ့ ဆွေမျိုးသားချင်း ၂၀၀၊
  </para>
  <para style="p">
    <verse number="9" style="v" />ဟေဗြုန်ရဲ့သားမြေးတွေထဲမှာ ခေါင်းဆောင်ဧလျေလနဲ့ ဆွေမျိုးသားချင်း ၈၀၊
  </para>
  <para style="p">
    <verse number="10" style="v" />သြဇေလရဲ့ သားမြေးတွေထဲမှာ ခေါင်းဆောင်အမိနဒပ်နဲ့ ဆွေမျိုးသားချင်း ၁၁၂ ယောက်တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဒါ့အပြင် ဒါဝိဒ်က ပုရောဟိတ်တွေဖြစ်တဲ့ ဇာဒုတ်နဲ့ အဗျာသာ၊ လေဝိအမျိုးသားတွေဖြစ်တဲ့ ဥရေလ၊ အသာယ၊ ယောလ၊ ရှေမာယ၊ ဧလျလေ၊ အမိနဒပ်တို့ကို ခေါ်ပြီး၊
  </para>
  <para style="p">
    <verse number="12" style="v" />“ခင်ဗျားတို့ဟာ လေဝိအမျိုးရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။ ကိုယ်တိုင်ရော၊ ဆွေမျိုးသားချင်းတွေရော ကိုယ်ကိုသန့်ရှင်းအောင် လုပ်ပြီးတဲ့နောက် အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါရဲ့ သေတ္တာတော်ကို ကျုပ်ပြင်ဆင်ထားတဲ့ နေရာဆီ သယ်လာခဲ့ပါ။
  </para>
  <para style="p">
    <verse number="13" style="v" />အရင်တစ်ခေါက်တုန်းက သေတ္တာတော်ကို ခင်ဗျားတို့ ထမ်းပြီး မသယ်ခဲ့ဘူး။ နည်းမှန်လမ်းမှန်သိအောင် မမေးမြန်းမိလို့ ကျုပ်တို့ကို ယေဟောဝါဘုရား အမျက်ထွက်ခဲ့တယ်” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဒါနဲ့ ပုရောဟိတ်တွေ၊ လေဝိအမျိုးသားတွေလည်း အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါရဲ့ သေတ္တာတော်ကို သယ်လာဖို့ ကိုယ်ကို သန့်ရှင်းစေကြတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />အဲဒီနောက် လေဝိအမျိုးသားတွေက မောရှေကတစ်ဆင့် ယေဟောဝါ မိန့်မှာထားတဲ့အတိုင်း ဘုရားသခင့် သေတ္တာတော်ကို ထမ်းပိုးတွေနဲ့ ထမ်းကြတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ကြိုးတပ်တူရိယာတွေ၊ စောင်းတွေ၊ လင်းကွင်းတွေ တီးခတ်ရင်း တပျော်တပါး သီဆိုဖို့ သီချင်းသည်တွေကို တာဝန်ပေးပါဆိုပြီး လေဝိအနွယ်ရဲ့ ခေါင်းဆောင်တွေကို ဒါဝိဒ် မှာထားတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒါနဲ့ လေဝိအမျိုးသားတွေလည်း ယောလရဲ့သား ဟေမန်၊ ဆွေမျိုးသားချင်းထဲက ဗေရခိရဲ့သား အာသပ်၊ ဆွေမျိုးသားချင်းထဲက မေရာရိအမျိုးသားတွေမှာ ကုရှာယရဲ့သား ဧသန် တို့ကို တာဝန်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />သူတို့နဲ့အတူ ဒုတိယအုပ်စုအဖြစ် ဆွေမျိုးသားချင်းတွေထဲက ဇာခရိ၊ ဗာနိ၊ ယာဇေလ၊ ရှေမိရာမုတ်၊ ယေဟေလ၊ ဥနိ၊ ဧလျာဘ၊ ဗေနာယ၊ မာသေယ၊ မာတသိ၊ ဧလိဖလေ၊ မိတ်နေယ၊ တံခါးစောင့်တွေဖြစ်တဲ့ သြဗက်ဧဒုံနဲ့ ယေယေလတို့ကို တာဝန်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />သီချင်းသည် ဟေမန်၊ အာသပ်၊ ဧသန်တို့က ကြေးနီလင်းကွင်းကို တီးရတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ဇာခရိ၊ အဇေလ၊ ရှေမိရာမုတ်၊ ယေဟေလ၊ ဥနိ၊ ဧလျာဘ၊ မာသေယ၊ ဗေနာယတို့က အာလမုတ်သံ ညှိထားတဲ့ ကြိုးတပ်တူရိယာတွေကို တီးခတ်ရတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />မာတသိ၊ ဧလိဖလေ၊ မိတ်နေယ၊ သြဗက်ဧဒုံ၊ ယေယေလ၊ အာဇဇိတို့က ရှေမိနိတ်သံ ညှိထားတဲ့ စောင်းတွေကို တီးရတဲ့အပြင် ဂီတမှူးလည်း လုပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />လေဝိအကြီးအကဲ ခေနနိက သေတ္တာတော် သယ်ဆောင်တာကို ကြီးကြပ်ပေးရတယ်။ သူက ဒီအလုပ်ကို ကျွမ်းကျင်တယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />ဗေရခိနဲ့ ဧလကာနက သေတ္တာတော်ကို စောင့်ကြပ်ရတဲ့ တံခါးစောင့်တွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ပုရောဟိတ် ရှေဗနိ၊ ယောရှာဖတ်၊ နာသနေလ၊ အာမသဲ၊ ဇာခရိ၊ ဗေနာယ၊ ဧလျာဇာတို့က ဘုရားသခင်ရဲ့ သေတ္တာတော်ရှေ့မှာ ခရာတွေကို အကျယ်ကြီး မှုတ်ရတယ်။ သြဗက်ဧဒုံနဲ့ ယေဟိလည်း သေတ္တာတော်ကို စောင့်ကြပ်ရတဲ့ တံခါးစောင့်တွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />အဲဒီနောက် ဒါဝိဒ်နဲ့ အစ္စရေးအကြီးအကဲတွေ၊ လူတစ်ထောင်အုပ်တွေက ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာကို သြဗက်ဧဒုံရဲ့အိမ်ကနေ သယ်လာဖို့ ဝမ်းသာအားရ သွားကြတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ယေဟောဝါဘုရားက ပဋိညာဉ်သေတ္တာ ထမ်းတဲ့ လေဝိအမျိုးသားတွေကို ကူညီပေးတဲ့အတွက် သူတို့က နွားထီးပျို ခုနစ်ကောင်နဲ့ သိုးထီး ခုနစ်ကောင်ကို ပူဇော်ကြတယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဒါဝိဒ်က ပိတ်ချောလက်ပြတ်ဝတ်ရုံကို ဝတ်ထားတယ်။ သေတ္တာထမ်းတဲ့ လေဝိအမျိုးသားတွေ၊ သီချင်းသည်တွေ၊ သေတ္တာသယ်ဆောင်ရေးနဲ့ သီချင်းသည်တွေကို ဦးဆောင်ရတဲ့ ခေနနိလည်း အဲဒီအတိုင်း ဝတ်ဆင်ထားကြတယ်။ ဒါဝိဒ်က ချည်ထည်သင်တိုင်းကိုပါ ဝတ်ဆင်ထားတယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />အစ္စရေးအားလုံး တံပိုး၊ ခရာ၊ လင်းကွင်း၊ ကြိုးတပ်တူရိယာတွေ၊ စောင်းတွေကို အကျယ်ကြီး တီးမှုတ်ပြီး တပျော်တပါး ဟစ်ကြွေးရင်း ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာကို သယ်လာကြတယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ဒါဝိဒ်မြို့ထဲ ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာ ဝင်လာတဲ့အခါ ရှောလုရဲ့သမီး မိခါလက ပြတင်းပေါက်ကနေ ကြည့်နေတယ်။ ဒါဝိဒ်မင်း ကခုန်ပြီး ပွဲခံနေတာကို မြင်တော့ သူ့စိတ်ထဲမှာ အထင်သေးသွားတယ်။
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />လူတွေက စစ်မှန်တဲ့ဘုရားသခင်ရဲ့ သေတ္တာတော်ကို သယ်လာပြီး ဒါဝိဒ်ဆောက်ထားတဲ့ တဲထဲမှာ ထားလိုက်တယ်။ အဲဒီနောက် ဘုရားသခင်ရှေ့မှာ မီးရှို့ရာအလှူတွေ၊ မိတ်သဟာယ ပူဇော်သက္ကာတွေ ဆက်သကြတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဒါဝိဒ်က မီးရှို့ရာအလှူတွေ၊ မိတ်သဟာယ ပူဇော်သက္ကာတွေကို ဆက်သပြီးတဲ့အခါ ယေဟောဝါရဲ့ နာမည်ကို အမှီပြုပြီး လူတွေကို ကောင်းချီးပေးတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဒါ့အပြင် အစ္စရေးအားလုံးကို ကျားမ,မရွေး မုန့်တစ်ချပ်စီ၊ စွန်ပလွံပျဉ်နဲ့ စပျစ်သီးပျဉ် တစ်ချပ်စီ ဝေပေးတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />အဲဒီနောက် ဒါဝိဒ်က ယေဟောဝါရဲ့ သေတ္တာတော်ရှေ့မှာ အမှုဆောင်ဖို့၊ အစ္စရေးတို့ရဲ့ ဘုရားသခင် ယေဟောဝါကို ဂုဏ်တင်ဖို့၊ ကျေးဇူးတင်ချီးမွမ်းဖို့ လေဝိအမျိုးသားတချို့ကို ခန့်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />သူတို့ရဲ့ခေါင်းဆောင်က အာသပ်၊ လက်ထောက်က ဇာခရိ။ ယေယေလ၊ ရှေမိရာမုတ်၊ ယေဟေလ၊ မာတသိ၊ ဧလျာဘ၊ ဗေနာယ၊ သြဗက်ဧဒုံ၊ ယေယေလတို့က ကြိုးတပ်တူရိယာနဲ့ စောင်းတွေ တီးရတယ်။ အာသပ်က လင်းကွင်းတီးရတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ပုရောဟိတ်တွေဖြစ်တဲ့ ဗေနာယနဲ့ ယဟာဇေလက ဘုရားသခင်ရဲ့ ပဋိညာဉ်သေတ္တာရှေ့မှာ ခရာ အမြဲမှုတ်ရတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />အဲဒီနေ့မှာ ဒါဝိဒ်က ယေဟောဝါကို ကျေးဇူးတင်ချီးမွမ်းတဲ့ သီချင်းတစ်ပုဒ်ကို ဦးဆုံး ရေးစပ်ပြီးနောက် အာသပ်နဲ့ သူ့ညီအစ်ကိုတွေ သီဆိုတီးမှုတ်ဖို့ ပေးလိုက်တယ်-
  </para>
  <para style="p">
    <verse number="8" style="v" />“ယေဟောဝါကို ကျေးဇူးတင်ကြ၊ နာမတော်ကို ခေါ်ပြီး ဆုတောင်းကြ။ ဘုရားရဲ့ လုပ်ဆောင်မှုတွေအကြောင်း လူတွေကို ကြားသိစေကြ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဘုရားအတွက် သီချင်းဆိုကြ။ ချီးမွမ်းသီဆိုကြ။ အံ့ဖွယ်လုပ်ဆောင်မှုတွေအကြောင်း စဉ်းစားဆင်ခြင်ကြ။
  </para>
  <para style="p">
    <verse number="10" style="v" />သန့်ရှင်းမြင့်မြတ်တဲ့နာမတော်ကို ချီးမွမ်းရတာ ဂုဏ်ယူပါ။ ယေဟောဝါကို ရှာတဲ့သူတွေ စိတ်ရွှင်လန်းပါစေ။
  </para>
  <para style="p">
    <verse number="11" style="v" />ယေဟောဝါနဲ့ အစွမ်းတန်ခိုးတော်ကို ရှာကြပါ။ မျက်နှာသာတော်ရဖို့ ကြိုးစားကြပါ။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဘုရားလုပ်ဆောင်ခဲ့တဲ့ အံ့ဖွယ်ရာတွေ၊ အံ့ဖွယ်လုပ်ရပ်တွေ၊ ချမှတ်ထားတဲ့ တရားစီရင်ချက်တွေကို သတိရကြ။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဘုရားကျွန် အစ္စရေးရဲ့ မျိုးနွယ်တို့၊ ဘုရားရွေးချယ်ထားတဲ့ ယာကုပ်ရဲ့ သားမြေးတို့။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဘုရားသခင်ဟာ ငါတို့ရဲ့ဘုရား ယေဟောဝါပဲ။ ကမ္ဘာတစ်ခွင်လုံးကို တရားစီရင်တယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဘုရားရဲ့ပဋိညာဉ်ကို ထာဝစဉ်သတိရကြ။ ပေးခဲ့တဲ့ကတိကို လူမျိုးဆက်တစ်ထောင်တိုင်အောင် သတိရကြ။
  </para>
  <para style="p">
    <verse number="16" style="v" />အာဗြဟံနဲ့ဖွဲ့ခဲ့တဲ့ ပဋိညာဉ်၊ အိဇက်ကိုပေးခဲ့တဲ့ ကျိန်ဆိုချက်ကို သတိရကြ။
  </para>
  <para style="p">
    <verse number="17" style="v" />အဲဒီကျိန်ဆိုချက်ကို ယာကုပ် အတွက် အမိန့်အဖြစ် တည်စေခဲ့တယ်။ အစ္စရေးအတွက် ထာဝရပဋိညာဉ်အဖြစ် တည်စေခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />‘ခါနန်ပြည်ကို အမွေအဖြစ် ငါခွဲဝေပေးမယ်’ လို့ ဘုရားကျိန်ဆိုခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />အဲဒီတုန်းက သူတို့ လူဦးရေ နည်းနည်းလေးပဲ။ ခါနန်ပြည်မှာ တိုင်းတစ်ပါးသားတွေအဖြစ် နေထိုင်ခဲ့ရတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />လူတစ်မျိုးကနေ တစ်မျိုး၊ တစ်နိုင်ငံကနေ တစ်နိုင်ငံ လှည့်လည်သွားလာခဲ့ရတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />သူတို့ကိုဖိနှိပ်ဖို့ ဘယ်သူ့ကိုမှ ဘုရားခွင့်မပြုခဲ့ဘူး။ သူတို့အတွက် ဘုရင်တွေကို ဆုံးမပြီး၊
  </para>
  <para style="p">
    <verse number="22" style="v" />‘ငါဘိသိက်ပေးထားသူတွေကို မထိကြနဲ့။ ငါ့ပရောဖက်တွေကို မကောင်းတာတစ်ခုမှ မလုပ်ကြနဲ့’ လို့ပြောခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />မြေကြီးသားအပေါင်းတို့၊ ယေဟောဝါကို ချီးမွမ်းသီချင်းဆိုကြ။ ကယ်တင်ခြင်းအကြောင်း နေ့စဉ်ရက်ဆက် ကြေညာကြ။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဘုန်းတန်ခိုးတော်အကြောင်း လူမျိုးတွေအလယ်မှာ ကြေညာကြ။ အံ့ဖွယ်လုပ်ဆောင်မှုတွေကို လူတွေအလယ်မှာ ကြေညာကြ။
  </para>
  <para style="p">
    <verse number="25" style="v" />ယေဟောဝါဟာ ကြီးမြတ်ပြီး ချီးမွမ်းခံထိုက်ဆုံးအရှင်ပဲ။ တခြားဘုရားတွေထက် ရိုသေခန့်ညားဖွယ် ကောင်းလှတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />လူမျိုးခြားတွေရဲ့ ဘုရားတွေဟာ အသုံးမဝင်တဲ့ ဘုရားတွေပါ။ ယေဟောဝါကတော့ ကောင်းကင်ကို ဖန်ဆင်းတဲ့ အရှင်ပဲ။
  </para>
  <para style="p">
    <verse number="27" style="v" />ရှေ့တော်မှာ ဘုန်းတန်ခိုးနဲ့ ခမ်းနားမှု ရှိနေတယ်။ စံမြန်းရာအရပ်မှာ အစွမ်းတန်ခိုးနဲ့ ဝမ်းမြောက်ခြင်း ရှိနေတယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />လူမျိုးနွယ်တို့၊ ယေဟောဝါ ရထိုက်တာကို ပေးကြ။ ယေဟောဝါဟာ ဘုန်းအသရေနဲ့ အစွမ်းတန်ခိုးရှိတဲ့အတွက် ဘုရားရထိုက်တာကို ပေးကြ။
  </para>
  <para style="p">
    <verse number="29" style="v" />ယေဟောဝါရဲ့ ဘုန်းအသရေနဲ့ပြည့်စုံတဲ့ နာမည်ကို ဂုဏ်တင် ချီးမွမ်းကြ။ လက်ဆောင်တွေယူပြီး ရှေ့တော်ကို လာကြ။ သန့်ရှင်းတဲ့အဝတ် ဝတ်ပြီး ယေဟောဝါကို ဦးချကြ။
  </para>
  <para style="p">
    <verse number="30" style="v" />မြေကြီးသားအပေါင်းတို့၊ ရှေ့တော်မှာ ကြောက်ရွံ့ တုန်လှုပ်ကြ။ ကမ္ဘာမြေကို ရွှေ့လို့မရနိုင်အောင် အခိုင်အမာ တည်ထားတယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />မိုးကောင်းကင် ပျော်ရွှင်ပါစေ။ ကမ္ဘာမြေ ရွှင်လန်းပါစေ။ ‘ယေဟောဝါ ဘုရင်ဖြစ်ပြီ’ လို့ လူမျိုးတွေအလယ်မှာ ကြေညာကြ။
  </para>
  <para style="p">
    <verse number="32" style="v" />ပင်လယ်နဲ့ ပင်လယ်ထဲမှာရှိသမျှ မြည်ဟည်းကြပါစေ။ လယ်ပြင်နဲ့ လယ်ပြင်မှာရှိသမျှ ဝမ်းမြောက်ကြပါစေ။
  </para>
  <para style="p">
    <verse number="33" style="v" />တစ်ချိန်တည်းမှာ တောသစ်ပင်တွေလည်း ယေဟောဝါရှေ့ ရွှင်လန်းစွာ သီချင်းဆိုကြပါစေ။ ကမ္ဘာမြေကို တရားစီရင်ဖို့ ဘုရားကြွလာပြီ။
  </para>
  <para style="p">
    <verse number="34" style="v" />ယေဟောဝါကို ကျေးဇူးတင်ကြပါ။ ဘုရားသခင်ဟာ ကောင်းမြတ်တယ်။ ခိုင်မြဲတဲ့မေတ္တာတော် ထာဝစဉ် တည်မြဲတယ်။
  </para>
  <para style="p">
    <verse number="35" style="v" />‘ကယ်တင်ရှင် ဘုရားသခင်၊ ကျွန်တော်တို့ကို ကယ်တင်လှည့်ပါ။ သန့်ရှင်းမြင့်မြတ်တဲ့ နာမတော်ကို ကျေးဇူးတင်ချီးမွမ်းနိုင်ဖို့၊ ကိုယ်တော့်ကို အားပါးတရ ချီးမွမ်းနိုင်ဖို့ တခြားလူမျိုးတွေရဲ့ လက်ထဲကနေ ကယ်တင်ပြီး စုသိမ်းလှည့်ပါ။
  </para>
  <para style="p">
    <verse number="36" style="v" />အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါကို အစဉ်ထာဝရ ချီးမွမ်းကြပါစေ’ လို့ ပြောကြပါ။” လူအားလုံးကလည်း “အာမင်” လို့ပြောပြီး ယေဟောဝါကို ချီးမွမ်းကြတယ်။
  </para>
  <para style="p">
    <verse number="37" style="v" />အဲဒီနောက် ဒါဝိဒ်က ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာရှေ့မှာ လုပ်ရိုးလုပ်စဉ်အတိုင်း အမြဲအမှုဆောင်ဖို့ အာသပ်နဲ့ သူ့ညီအစ်ကိုတွေကို သေတ္တာတော်ရှေ့မှာ နေခိုင်းတယ်။
  </para>
  <para style="p">
    <verse number="38" style="v" />သြဗက်ဧဒုံနဲ့ ဆွေမျိုးသားချင်း ၆၈ ယောက်ကိုလည်း နေခိုင်းတယ်။ ယေဒုသုန်ရဲ့သား သြဗက်ဧဒုံနဲ့ ဟောသကို တံခါးစောင့်အဖြစ် တာဝန်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="39" style="v" />ပုရောဟိတ် ဇာဒုတ်နဲ့ အပေါင်းပါ ပုရောဟိတ်တွေက ဂိဗောင်မြို့၊ အထွတ်အမြတ်နေရာမှာရှိတဲ့ ယေဟောဝါရဲ့တဲတော်ရှေ့မှာ အမှုဆောင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="40" style="v" />ပူဇော်ရာပလ္လင်ပေါ်မှာ မီးရှို့ရာအလှူတွေကို ယေဟောဝါဆီ မနက်ရော ညပါ ပုံမှန်ပူဇော်ဖို့၊ အစ္စရေးတွေကို မိန့်မှာတဲ့ ယေဟောဝါရဲ့ ပညတ်ကျမ်းမှာ ရေးထားသမျှအတိုင်း လုပ်ဆောင်ဖို့ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="41" style="v" />သူတို့နဲ့အတူ ဟေမန်နဲ့ ယေဒုသုန် ရှိတယ်။ “ခိုင်မြဲတဲ့မေတ္တာတော် ထာဝစဉ်တည်မြဲ” တဲ့အတွက် ယေဟောဝါကို ချီးမွမ်းဖို့ နာမည်နဲ့တကွ ရွေးချယ်ခံရတဲ့ ကျန်တဲ့လူတွေလည်း ရှိနေတယ်။
  </para>
  <para style="p">
    <verse number="42" style="v" />သူတို့နဲ့အတူ ဟေမန်နဲ့ ယေဒုသုန်က ခရာတွေ၊ လင်းကွင်းတွေ၊ တခြားတူရိယာတွေ တီးမှုတ်ပြီး ဘုရားသခင်ကို ချီးမွမ်းကြတယ်။ ယေဒုသုန်ရဲ့ သားတွေကတော့ တံခါးစောင့် လုပ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="43" style="v" />အဲဒီနောက် လူတွေအားလုံး ကိုယ့်အိမ်ကိုယ့်ရာဆီ ပြန်သွားကြတယ်။ ဒါဝိဒ်လည်း သူ့အိမ်သားတွေကို ကောင်းချီးပေးဖို့ ပြန်သွားတယ်။
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်မင်းက နန်းတော်မှာ စံမြန်းနေရတဲ့အခါ ပရောဖက်နာသန်ကို ခေါ်ပြီး “ငါက သစ်ကတိုးသားနဲ့ ဆောက်တဲ့ နန်းတော်မှာ စံနေရပေမဲ့ ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာကျတော့ တဲမှာပဲ ရှိနေတယ်” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />နာသန်က “စစ်မှန်တဲ့ဘုရားသခင်ဟာ မင်းကြီးနဲ့အတူ ရှိတဲ့အတွက် ဆန္ဒရှိတဲ့အတိုင်းသာ လုပ်ပါ” လို့ ပြန်ပြောတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အဲဒီညမှာပဲ ဘုရားသခင်က နာသန်ကို မှာတယ်–
  </para>
  <para style="p">
    <verse number="4" style="v" />“ငါ့ကျွန်ဒါဝိဒ်ကို သွားပြောလိုက်။ ‘ယေဟောဝါ မိန့်မှာတာက “ငါ့အတွက် စံအိမ်ကို တည်ဆောက်ပေးမယ့်သူဟာ မင်း မဟုတ်ဘူး။
  </para>
  <para style="p">
    <verse number="5" style="v" />ငါက အစ္စရေးတွေကို ခေါ်ထုတ်လာတဲ့နေ့ကစပြီး ဒီနေ့အထိ စံအိမ်ထဲမှာ မနေခဲ့ဘူး။ တဲမှာပဲနေပြီး တစ်နေရာပြီး တစ်နေရာ သွားလာခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />အစ္စရေးတွေနဲ့အတူ သွားလာချိန်တစ်လျှောက်မှာ သူတို့ကို ထိန်းကျောင်းဖို့ ငါခန့်အပ်ခဲ့တဲ့ အစ္စရေးတရားသူကြီးတွေကို ‘ငါ့အတွက် သစ်ကတိုးသားစံအိမ် ဘာလို့ မဆောက်ပေးတာလဲ’ ဆိုပြီး တစ်ခွန်းလောက် ငါပြောခဲ့ဖူးသလား။”’
  </para>
  <para style="p">
    <verse number="7" style="v" />“အခု ငါ့ကျွန်ဒါဝိဒ်ကို ပြောလိုက်ပါ။ ‘ဗိုလ်ခြေတို့ရဲ့အရှင် ယေဟောဝါ ပြောတာက– “မင်းကို ငါ့လူမျိုးအစ္စရေးရဲ့ ခေါင်းဆောင်အဖြစ် ခန့်အပ်ဖို့ သိုးကျောင်းရာ စားကျက်မြေကနေ ငါခေါ်ထုတ်ခဲ့ပြီ။
  </para>
  <para style="p">
    <verse number="8" style="v" />မင်းသွားလေရာမှာ မင်းနဲ့အတူ ငါရှိမယ်။ မင်းရဲ့ရန်သူအားလုံးကို ရှေ့ကနေ ငါဖယ်ရှားမယ်။ ကမ္ဘာပေါ်က ထင်ပေါ်ကျော်ကြားသူတွေလို မင်းရဲ့နာမည်ကို ကျော်ကြားစေမယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ငါ့လူမျိုးအစ္စရေးတွေအတွက် နေရာတစ်နေရာကို သတ်မှတ်ပြီး နေရာချပေးမယ်။ သူတို့ အဲဒီနေရာမှာ နေထိုင်ကြမယ်။ ဘယ်တော့မှ နှောင့်ယှက်ခံရမှာ မဟုတ်ဘူး။ လူဆိုးတွေက ငါ့လူမျိုးအစ္စရေးတွေကို ဟိုးအရင်တုန်းကလို၊
  </para>
  <para style="p">
    <verse number="10" style="v" />တရားသူကြီးတွေ လက်ထက်တုန်းကလို ဖိနှိပ်တော့မှာ မဟုတ်ဘူး။ မင်းရဲ့ရန်သူအားလုံးကို ငါနှိမ်နင်းမယ်။ အဲဒီအပြင် ငါထပ်ပြောမယ်– ‘မင်းရဲ့ မင်းဆက်ကို ငါယေဟောဝါ တည်မြဲစေမယ်။’
  </para>
  <para style="p">
    <verse number="11" style="v" />“‘“မင်းကွယ်လွန်ပြီး ဘိုးဘေးတွေရှိရာကို ရောက်သွားတဲ့အခါ မင်းရဲ့မျိုးနွယ်၊ မင်းရဲ့ရင်သွေးကို ငါ မင်းမြှောက်မယ်။ သူ့ရဲ့မင်းအာဏာကို ငါတည်မြဲစေမယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />သူက ငါ့အတွက် အိမ်တော်ကို တည်ဆောက်လိမ့်မယ်။ သူ့ရာဇပလ္လင်ကို ထာဝစဉ် ငါတည်မြဲစေမယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ငါဟာ သူ့ဖခင် ဖြစ်လာမယ်။ သူဟာ ငါ့သားဖြစ်လာမယ်။ မင်းမတိုင်ခင် နန်းထိုင်ခဲ့သူဆီကနေ ငါ့ရဲ့ခိုင်မြဲတဲ့မေတ္တာကို ရုပ်သိမ်းသလိုမျိုး မင်းရဲ့သားဆီကနေ ငါရုပ်သိမ်းမှာ မဟုတ်ဘူး။
  </para>
  <para style="p">
    <verse number="14" style="v" />သူ့ကို ငါ့ရာဇပလ္လင်မှာ ထာဝစဉ် နန်းထိုင်စေမယ်။ သူ့ရဲ့အာဏာနဲ့ မင်းဆက်ဟာ ထာဝစဉ် တည်လိမ့်မယ်။”’”
  </para>
  <para style="p">
    <verse number="15" style="v" />နာသန်က မြင်ခဲ့ရတဲ့ စိတ်အာရုံအကြောင်း၊ ကြားခဲ့ရတဲ့စကားတွေအကြောင်း တစ်ခုမကျန် ဒါဝိဒ်ကို ပြန်ပြောပြတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />အဲဒီအခါ ဒါဝိဒ်မင်းက ယေဟောဝါရှေ့ ဝင်လာပြီး ထိုင်နေတယ်။ ပြီးတော့ “ယေဟောဝါဘုရား၊ ကျွန်တော်နဲ့ ကျွန်တော့်အမျိုးဟာ ဘယ်သူတွေမို့လို့ ဒီလောက်အထိ ကျေးဇူးပြုရတာလဲ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဘုရားသခင်၊ ဒါနဲ့တင် အားမရသေးဘဲ ဟိုးအနာဂတ်ကာလအထိ ကျွန်တော့်အမျိုး တည်တံ့မယ်လို့တောင် မိန့်မှာပါပြီ။ ယေဟောဝါဘုရား၊ ကိုယ်တော်က ကျွန်တော့်ကို ထပ်ဆင့် ချီးမြှောက်ခံထိုက်သူလို ယူမှတ်ပါပြီ။
  </para>
  <para style="p">
    <verse number="18" style="v" />ကျွန်တော့်ကို ကိုယ်တော် ကောင်းကောင်း သိပါတယ်။ အခုလို ချီးမြှောက်တာနဲ့ ပတ်သက်ပြီး ကျွန်တော်မျိုးဒါဝိဒ် ဘာများထပ်ပြောနိုင်မှာလဲ။
  </para>
  <para style="p">
    <verse number="19" style="v" />ယေဟောဝါဘုရား၊ ကိုယ်တော်က ကြီးမြတ်တဲ့ ဒီအရာအားလုံးကို ကျွန်တော့်အကျိုးအတွက်၊ စိတ်သဘောတော်အတိုင်း လုပ်ဆောင်ပြီး ကိုယ်တော့်ကြီးမြတ်မှုကို ဖော်ပြခဲ့ပါပြီ။
  </para>
  <para style="p">
    <verse number="20" style="v" />ယေဟောဝါဘုရား၊ ကိုယ်တော်နဲ့တူတဲ့ဘုရား မရှိဘူး၊ ကိုယ်တော်ကလွဲလို့ တခြားဘုရား မရှိဘူး ဆိုတာကို ကြားသိသမျှအရာတွေက ထောက်ခံနေပါတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />ကမ္ဘာပေါ်မှာ ကိုယ်တော့်လူမျိုးကို ဘယ်လူမျိုးက ယှဉ်နိုင်ပါသလဲ။ ဘုရားသခင်က အစ္စရေးတွေကို မိမိရဲ့လူမျိုးအဖြစ် ရွေးယူခဲ့ပြီ။ ကြီးမြတ်တဲ့ အံ့မခန်းဖွယ်လုပ်ရပ်တွေအားဖြင့် နာမတော်ကို ထင်ရှားစေခဲ့ပြီ။ အီဂျစ်ပြည်ကနေ ရွေးယူခဲ့တဲ့ မိမိရဲ့လူမျိုးရှေ့ကနေ လူမျိုးခြားတွေကို နှင်ထုတ်ခဲ့ပြီ။
  </para>
  <para style="p">
    <verse number="22" style="v" />ကိုယ်တော်က အစ္စရေးလူမျိုးကို အစဉ်အမြဲပိုင်ဆိုင်တဲ့ လူမျိုးတော်အဖြစ် သတ်မှတ်လိုက်ပြီ။ ယေဟောဝါဘုရား၊ ကိုယ်တော်ဟာ သူတို့ရဲ့ဘုရားသခင် ဖြစ်လာပါပြီ။
  </para>
  <para style="p">
    <verse number="23" style="v" />ယေဟောဝါဘုရား၊ အခု ကျွန်တော်နဲ့ ကျွန်တော့်အမျိုးကို ပေးခဲ့တဲ့ ကတိတော်ကို အစဉ်အမြဲတည်စေပါ။ ကတိတော်အတိုင်း လုပ်ဆောင်ပေးပါ။
  </para>
  <para style="p">
    <verse number="24" style="v" />နာမတော် ထာဝစဉ်တည်တံ့ပါစေ။ လူတွေက ‘အစ္စရေးတို့ရဲ့ဘုရား၊ ဗိုလ်ခြေတို့ရဲ့အရှင် ယေဟောဝါဟာ အစ္စရေးတို့ရဲ့ ဘုရားသခင်ပဲ’ လို့ပြောပြီး နာမတော်ကို ချီးမြှောက်ကြပါစေ။ ကျွန်တော်မျိုးဒါဝိဒ်ရဲ့ မင်းဆက်ဟာ ရှေ့တော်မှာ အမြဲတည်တံ့ပါစေ။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဘုရားသခင်၊ ကိုယ်တော်က ကျွန်တော့်မင်းဆက်ကို တည်စေမယ်ဆိုတဲ့ ရည်ရွယ်ချက်ကို ဖော်ပြခဲ့ပါပြီ။ ဒါကြောင့် အခုလို ယုံကြည်စိတ်ချမှုအပြည့်နဲ့ ဆုတောင်းရတာပါ။
  </para>
  <para style="p">
    <verse number="26" style="v" />ယေဟောဝါဘုရား၊ ကိုယ်တော်ဟာ စစ်မှန်တဲ့ ဘုရားသခင်ပါ။ ကျွန်တော့်ကို ဒီဆုကျေးဇူးတွေ ပေးသနားမယ်လို့ ကတိပြုထားပါပြီ။
  </para>
  <para style="p">
    <verse number="27" style="v" />ဒါကြောင့် ကျွန်တော့်မင်းဆက်ကို အလိုတော်အတိုင်း ကောင်းချီးပေးပြီး ရှေ့တော်မှာ ထာဝစဉ်တည်မြဲစေပါ။ ယေဟောဝါဘုရား၊ ကိုယ်တော်တိုင် ကောင်းချီးပေးခဲ့ပြီဖြစ်လို့ ကျွန်တော့်မင်းဆက်ဟာ ထာဝစဉ် ကောင်းချီးခံစားရပါစေ” လို့ဆုတောင်းတယ်။
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />နောက်ပိုင်းမှာ ဒါဝိဒ်က ဖိလိတိလူတွေကို တိုက်ခိုက်နှိမ်နှင်းပြီး ဂါသမြို့နဲ့ ပတ်ဝန်းကျင်မြို့ငယ်တွေကို သိမ်းယူလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />မောဘလူတွေကိုလည်း အနိုင်ရတဲ့အတွက် မောဘလူတွေဟာ ဒါဝိဒ်ရဲ့လက်အောက်ခံတွေ ဖြစ်လာပြီး ဆက်ကြေးပေးရတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဇောဘဘုရင် ဟာဒဒေဇာက အာဏာပြန်ရအောင် လုပ်ဖို့ ယူဖရေးတီး မြစ်ဝှမ်းဒေသကို သွားတဲ့အခါ ဒါဝိဒ်က ဟာမတ်မြို့မှာ သူ့ကိုနှိမ်နင်းပြီး၊
  </para>
  <para style="p">
    <verse number="4" style="v" />မြင်းရထား ၁,၀၀၀၊ မြင်းစီးသူရဲ ၇,၀၀၀၊ ခြေလျင်တပ်သား ၂၀,၀၀၀ ကို ဖမ်းခေါ်လာတယ်။ မြင်းအကောင် ၁၀၀ ကို ချန်ထားပြီး ကျန်တဲ့မြင်းအားလုံးကို တံကောက်ကြော ဖြတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဇောဘဘုရင် ဟာဒဒေဇာကို စစ်ကူဖို့ ဒမတ်စကတ်မြို့သား ဆီးရီးယားလူတွေ ရောက်လာတဲ့အခါ ဒါဝိဒ်က ဆီးရီးယားတပ်သား ၂၂,၀၀၀ ကိုနှိမ်နင်းပြီး၊
  </para>
  <para style="p">
    <verse number="6" style="v" />ဆီးရီးယားပြည်၊ ဒမတ်စကတ်မြို့မှာ မြို့စောင့်တပ်တွေ ချထားလိုက်တယ်။ ဒါကြောင့် ဆီးရီးယားတွေဟာ ဒါဝိဒ်ရဲ့လက်အောက်ခံတွေ ဖြစ်လာပြီး ဆက်ကြေးပေးရတယ်။ ယေဟောဝါက ဒါဝိဒ်စစ်ချီသွားတဲ့အခါတိုင်း အောင်ပွဲခံစေတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဒါဝိဒ်က ဟာဒဒေဇာရဲ့ မင်းမှုထမ်းတွေဆီကနေ ရွှေဒိုင်းဝိုင်းတွေကို သိမ်းယူပြီး ဂျေရုဆလင်မြို့ကို သယ်လာတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဟာဒဒေဇာပိုင်တဲ့ တိဗဟတ်မြို့နဲ့ ခုန်မြို့ကနေ ကြေးနီအမြောက်အမြားကိုလည်း သိမ်းယူခဲ့တယ်။ အဲဒီကြေးနီတွေကိုသုံးပြီး ရှောလမုန်က ကြေးနီရေကန်၊ တိုင်တွေ၊ ကြေးနီအသုံးအဆောင်တွေကို လုပ်ခဲ့တာ။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဇောဘဘုရင် ဟာဒဒေဇာရဲ့ တပ်မကြီးတစ်ခုလုံးကို ဒါဝိဒ် ချေမှုန်းလိုက်တဲ့အကြောင်း ဟာမတ်ဘုရင်တောအိ ကြားတဲ့အခါ၊
  </para>
  <para style="p">
    <verse number="10" style="v" />သားတော်ဟဒေါရံကို ဒါဝိဒ်မင်းဆီ ချက်ချင်း စေလွှတ်တယ်။ ဟာဒဒေဇာကို တိုက်ခိုက်အနိုင်ယူတဲ့အတွက် ဂုဏ်ယူဝမ်းမြောက်ကြောင်း ပြောပြီး နှုတ်ခွန်းဆက်ခိုင်းတယ်။ (ဟာဒဒေဇာက တောအိကို မကြာခဏ တိုက်ခိုက်ဖူးတယ်။) ဟဒေါရံက ရွှေထည်ငွေထည်၊ ကြေးထည်တွေကိုလည်း ယူလာပေးတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဒါဝိဒ်မင်းက အဲဒီပစ္စည်းတွေအပြင် ဧဒုံ၊ မောဘ၊ အမ္မုန်၊ ဖိလိတိနဲ့ အာမလက်လူမျိုး တွေဆီကနေ သိမ်းယူလာတဲ့ ရွှေငွေတွေကိုလည်း ယေဟောဝါအတွက် ဆက်ကပ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ဇေရုယာရဲ့သား အဘိရှဲက ဆားချိုင့်ဝှမ်းမှာ ဧဒုံလူ ၁၈,၀၀၀ ကို နှိမ်နင်းတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဧဒုံပြည်မှာလည်း မြို့စောင့်တပ်တွေ ချထားလိုက်တဲ့အတွက် ဧဒုံပြည်သားအားလုံး ဒါဝိဒ်ရဲ့လက်အောက်ခံတွေ ဖြစ်လာတယ်။ ယေဟောဝါက ဒါဝိဒ် စစ်ချီသွားတဲ့အခါတိုင်း အောင်ပွဲခံစေတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />အစ္စရေးတစ်ပြည်လုံးကို ဒါဝိဒ် အုပ်စိုးတယ်။ ပြည်သူပြည်သားအားလုံးကို တရားမျှတစွာ၊ ဖြောင့်မတ်စွာ စီမံအုပ်ချုပ်တယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဇေရုယာရဲ့သား ယွာဘက ဗိုလ်ချုပ်၊ အဟိလုတ်ရဲ့သား ယောရှဖတ်က အတွင်းဝန်၊
  </para>
  <para style="p">
    <verse number="16" style="v" />အဟိတုပ်ရဲ့သား ဇာဒုတ်နဲ့ အဗျာသာရဲ့သား အဟိမလက်က ပုရောဟိတ်၊ ရှဘာရှက စာရေးတော်ကြီး ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ယောယဒရဲ့သား ဗေနာယက ခေရသိလူနဲ့ ပေလသိလူတွေကို အုပ်ချုပ်ရတယ်။ ဒါဝိဒ်ရဲ့သားတွေကတော့ ဘုရင်ပြီးရင် ရာထူးအကြီးဆုံးပဲ။
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />နောက်တော့ အမ္မုန်ဘုရင်နေဟက် ကွယ်လွန်သွားပြီး သူ့သား နန်းတက်လာတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဒါဝိဒ်က “နေဟက်မင်းက ငါ့ကို ခိုင်မြဲတဲ့မေတ္တာ ပြခဲ့တဲ့အတွက် ငါလည်း သူ့သားဟာနုန်ကို ခိုင်မြဲတဲ့မေတ္တာပြမယ်” ဆိုပြီး ဖခင်ကွယ်လွန်လို့ ဝမ်းနည်းနေတဲ့ ဟာနုန်ကို နှစ်သိမ့်စကား ပြောကြားဖို့ တမန်တွေ စေလွှတ်လိုက်တယ်။ ဒါဝိဒ်ရဲ့တမန်တွေ အမ္မုန်ပြည်ကို ရောက်လာတဲ့အခါ၊
  </para>
  <para style="p">
    <verse number="3" style="v" />အမ္မုန်မှူးမတ်တွေက “ဒါဝိဒ်က ခမည်းတော်ကို လေးစားတဲ့အနေနဲ့ တမန်တွေ လွှတ်ပြီး နှစ်သိမ့်ပေးတာလို့ မင်းကြီး ထင်နေပါသလား။ တကယ်တော့ တိုင်းပြည်ကို ဖျက်ဆီးဖို့ တမန်တွေလွှတ်ပြီး ထောက်လှမ်းခိုင်းလိုက်တာပါ” လို့ ဟာနုန်မင်းကို လျှောက်တင်တယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဒါကြောင့် ဟာနုန်က ဒါဝိဒ်ရဲ့တမန်တွေကို ဖမ်းဆီးပြီး မုတ်ဆိတ်မွေးကိုရိတ်၊ ဝတ်ရုံကို တင်ပါးအထိဖြတ်ပြီး ပြန်လွှတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဒီသတင်းကို ဒါဝိဒ်ကြားတာနဲ့ တမန်တွေဆီ လူလွှတ်ပြီး ကြိုခိုင်းလိုက်တယ်။ သူတို့ အကြီးအကျယ် အရှက်ခွဲခံလိုက်ရတာကိုး။ ဒါဝိဒ်က “မင်းတို့ မုတ်ဆိတ်တွေ ပြန်ရှည်လာတဲ့အထိ ယေရိခေါမြို့မှာ နေကြ။ ပြီးမှ ပြန်လာခဲ့ကြပါ” လို့မှာလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />အမ္မုန်လူတွေက သူတို့ကို ဒါဝိဒ်မုန်းနေမှန်း သိသွားတယ်။ ဒါကြောင့် ဟာနုန်မင်းနဲ့ အမ္မုန်လူတွေက မက်ဆိုပိုတေးမီးယားပြည်၊ အာရံမာခါပြည်၊ ဇောဘပြည်ကနေ မြင်းရထားတွေ၊ မြင်းစီးသူရဲတွေကို ငွေတဲလင့် ၁,၀၀၀ ပေးပြီး ငှားရမ်းတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />မြင်းရထား ၃၂,၀၀၀ အပြင် မာခါဘုရင်နဲ့ သူ့လူတွေကိုပါ ငှားလိုက်တဲ့အတွက် သူတို့ ချီတက်လာပြီး မေဒဘအရပ်ရှေ့မှာ တပ်ချကြတယ်။ အမ္မုန်လူတွေလည်း မြို့တွေထဲကနေ တစုတစည်းတည်း ထွက်လာတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဒီသတင်းကို ဒါဝိဒ်ကြားတဲ့အခါ ခွန်အားကြီး စစ်သည်တွေအပါအဝင် ယွာဘနဲ့ တပ်မကြီးတစ်ခုလုံးကို လွှတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />အမ္မုန်လူတွေ ထွက်လာပြီး မြို့အဝင်မှာ စစ်ခင်းထားတယ်။ စစ်ချီလာတဲ့ ဘုရင်တွေကတော့ လွင်ပြင်မှာ စစ်ခင်းထားတယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အရှေ့နဲ့ အနောက် စစ်မျက်နှာနှစ်ဖက် ဖွင့်ထားတာကို ယွာဘမြင်တဲ့အခါ အစ္စရေးလက်ရွေးစင် စစ်သည်တချို့ကို ရွေးချယ်ပြီး ဆီးရီးယားတွေနဲ့တိုက်ဖို့ စစ်ခင်းတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ကျန်တဲ့စစ်သည်တွေကို အမ္မုန်လူတွေနဲ့ စစ်ခင်းဖို့ အစ်ကိုအဘိရှဲလက်ထဲ အပ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ပြီးတော့ ယွာဘက “ဆီးရီးယားတွေ ငါ့ကို အသာစီးရရင် မင်းလာကူရမယ်။ အမ္မုန်လူတွေ မင်းကို အသာစီးရရင် ငါလာကူမယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဒို့လူမျိုးအတွက်၊ ဒို့ဘုရားသခင်ပိုင်တဲ့ မြို့တွေအတွက် ရွပ်ရွပ်ချွံချွံ တိုက်ခိုက်ကြစို့။ ယေဟောဝါဘုရားကလည်း အလိုရှိတဲ့အတိုင်း လုပ်ဆောင်ပေးမှာပါ” လို့မှာတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ယွာဘနဲ့ စစ်သည်တွေ တိုက်ဖို့ ရှေ့တိုးလာတဲ့အခါ ဆီးရီးယားတွေ ထွက်ပြေးကြတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆီးရီးယားတွေ ထွက်ပြေးတာကို မြင်တော့ အမ္မုန်လူတွေလည်း ယွာဘအစ်ကို အဘိရှဲရှေ့ကနေ ထွက်ပြေးပြီး မြို့ထဲ ပြန်ဝင်သွားကြတယ်။ အဲဒီနောက် ယွာဘက ဂျေရုဆလင်မြို့ကို ပြန်လာတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဆီးရီးယားတွေက အစ္စရေးတွေလက်ချက်နဲ့ သူတို့ အရေးနိမ့်မှန်း သိတဲ့အခါ တမန်တွေလွှတ်ပြီး မြစ်ကြီး အနီးမှာနေတဲ့ ဆီးရီးယားတွေကို ခေါ်လိုက်တယ်။ ဟာဒဒေဇာရဲ့ဗိုလ်ချုပ် ရှောပက်က သူတို့ကို ဦးဆောင်လာတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒီသတင်းကို ကြားတာနဲ့ ဒါဝိဒ်မင်းက အစ္စရေးစစ်သည်တွေကို စုရုံး၊ ဂျော်ဒန်မြစ်ကို ဖြတ်ပြီး ချီတက်လာတယ်။ ပြီးတော့ ဆီးရီးယားတွေနဲ့ တိုက်ခိုက်ဖို့ စစ်ခင်းတဲ့အခါ သူတို့လည်း ပြန်တိုက်ခိုက်ကြတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဒါပေမဲ့ ဆီးရီးယားတွေ အရေးနိမ့်ပြီး ထွက်ပြေးရတယ်။ ဒါဝိဒ်က ဆီးရီးယားစစ်ရထားမှူး ၇,၀၀၀၊ ခြေလျင်တပ်သား ၄၀,၀၀၀ ကို ကွပ်မျက်တယ်။ ဗိုလ်ချုပ်ရှောပက်ကိုလည်း ကွပ်မျက်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဟာဒဒေဇာမင်းရဲ့ လူတွေက သူတို့ ရှုံးနိမ့်မှန်းသိတဲ့အခါ ချက်ချင်းပဲ စစ်ပြေငြိမ်းဖို့ ကမ်းလှမ်းပြီး ဒါဝိဒ်ဆီမှာ လက်အောက်ခံကြတယ်။ အဲဒီအချိန်ကစပြီး ဆီးရီးယားတွေဟာ အမ္မုန်လူတွေကို စစ်ကူ မပေးတော့ဘူး။
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />နှစ်ဆန်းပိုင်းမှာ ဘုရင်တွေ စစ်တိုက်ထွက်ချိန် ရောက်တဲ့အခါ ယွာဘက စစ်တပ်ကို ဦးဆောင်ပြီး အမ္မုန်ပြည်ကို တိုက်ခိုက်ဖျက်ဆီးတယ်။ ဒါဝိဒ်ကတော့ ဂျေရုဆလင်မြို့မှာ နေရစ်ခဲ့တယ်။ ယွာဘက ရဗာမြို့ကို ချီတက်လာပြီး ဝိုင်းထားတယ်။ ပြီးတော့ မြို့ကို တိုက်ခိုက်ချေမှုန်းတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />အဲဒီနောက် ဒါဝိဒ်က မာလကုံနတ်ရုပ်တုရဲ့ သရဖူကို ချွတ်ယူတယ်။ ရွှေအလေးချိန် တစ်တဲလင့် ရှိပြီး ကျောက်မျက်တွေ စီခြယ်ထားတဲ့ အဲဒီသရဖူကို ဒါဝိဒ်ရဲ့ခေါင်းပေါ် ဆောင်းပေးကြတယ်။ ဒါဝိဒ်က အဲဒီမြို့ကနေ တိုက်ရာပါဥစ္စာအများကြီး ယူလာတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />မြို့သားတွေကို ဖမ်းခေါ်လာပြီး ကျောက်ဖြတ်တဲ့အလုပ်၊ အသွားထက်တဲ့ သံထည်ကိရိယာတွေ၊ ပုဆိန်တွေ သုံးရတဲ့အလုပ်တွေ လုပ်ခိုင်းတယ်။ တခြားအမ္မုန်မြို့သားတွေကိုလည်း အဲဒီအလုပ်တွေ လုပ်ခိုင်းတယ်။ နောက်ဆုံး၊ ဒါဝိဒ်နဲ့ စစ်သည်အားလုံး ဂျေရုဆလင်မြို့ကို ပြန်လာကြတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />အဲဒီနောက် ဂေဇာမြို့မှာ ဖိလိတိလူတွေနဲ့ စစ်ဖြစ်တယ်။ ဒီတစ်ချီမှာတော့ ဟုရှအမျိုးသား သိဗေခဲက ရေဖိမ်လူမျိုးကနေ ဆင်းသက်လာသူ သာဖကို သတ်လိုက်တယ်။ ဒါနဲ့ ဖိလိတိတွေ စစ်ရှုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />နောက်ပိုင်းမှာ ဖိလိတိလူတွေနဲ့ စစ်ဖြစ်ပြန်တော့ ယာအိရရဲ့သား ဧလဟာနန်က ဂါသမြို့သား ဂေါလျတ်နဲ့ ညီအစ်ကိုတော်တဲ့ လာခမိကို သတ်လိုက်တယ်။ လာခမိရဲ့လှံရိုးက ရက်ကန်းလိပ်တုံးလောက် ရှိတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဂါသမြို့မှာ နောက်တစ်ကြိမ် စစ်ဖြစ်ပြန်တယ်။ အဲဒီမြို့မှာ ရေဖိမ်လူမျိုးကနေ ဆင်းသက်လာတဲ့ လူထွားကြီးတစ်ယောက်ရှိတယ်။ သူ့လက်တစ်ဖက်မှာ လက်ချောင်း ၆ ချောင်းစီ၊ ခြေတစ်ဖက်မှာ ခြေချောင်း ၆ ချောင်းစီ၊ စုစုပေါင်း ၂၄ ချောင်းရှိတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />သူက အစ္စရေးတွေကို မပြတ်စိန်ခေါ်နေတဲ့အတွက် ဒါဝိဒ်ရဲ့အစ်ကို ရှိမာရဲ့ သား ယောနသန်က သတ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />သူတို့ဟာ ရေဖိမ်လူမျိုးကနေ ဆင်းသက်လာတဲ့ ဂါသမြို့သားတွေပဲ။ ဒါဝိဒ်နဲ့ မင်းမှုထမ်းတွေရဲ့ လက်ချက်ကြောင့် သူတို့ ကျဆုံးသွားကြတယ်။
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />စာတန်က အစ္စရေးတွေကို တိုက်ခိုက်ဖို့ ဆုံးဖြတ်ပြီး အစ္စရေးလူဦးရေကို စာရင်းကောက်ချင်စိတ်ပေါ်လာအောင် ဒါဝိဒ်ကို လှုံ့ဆော်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဒါကြောင့် ဒါဝိဒ်က ယွာဘနဲ့ ဗိုလ်ချုပ်တွေကို “ဗေရရှေဘမြို့ကနေ ဒန်မြို့အထိ သွားပြီး အစ္စရေးလူဦးရေစာရင်း ကောက်ပါ။ လူဘယ်လောက်ရှိမှန်း သိနိုင်ဖို့ ငါ့ဆီ သတင်းပို့ပါ” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဒါပေမဲ့ ယွာဘက “ယေဟောဝါဘုရားက မိမိလူမျိုးကို အခုထက် အဆ ၁၀၀ တိုးများအောင် လုပ်ပေးပါစေ။ သူတို့အားလုံးဟာ မင်းကြီးရဲ့လူတွေပဲ မဟုတ်လား။ ဒီကိစ္စကို မင်းကြီး ဘာလို့လုပ်ချင်ရတာလဲ။ အစ္စရေးတွေကို အပြစ်သင့်စေတဲ့သူ ဘာလို့ ဖြစ်ချင်ရတာလဲ” ဆိုပြီးပြောတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဒါပေမဲ့ ဒါဝိဒ်မင်းရဲ့စကားဟာ ယွာဘကို လွှမ်းမိုးနိုင်ခဲ့တယ်။ ဒါကြောင့် ယွာဘက အစ္စရေးတစ်ပြည်လုံးအနှံ့ ခရီးလှည့်လည်ပြီးတဲ့နောက် ဂျေရုဆလင်ကို ပြန်လာတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ပြီးတော့ ဒါဝိဒ်မင်းကို လူဦးရေစာရင်း ပေးလိုက်တယ်။ အစ္စရေးအမျိုးမှာ ဓားကိုင်တပ်သား ၁,၁၀၀,၀၀၀၊ ယုဒအမျိုးမှာ ဓားကိုင်တပ်သား ၄၇၀,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ယွာဘက ဒါဝိဒ်မင်းရဲ့စကားကို လုံးဝမကြိုက်တဲ့အတွက် လေဝိအနွယ်နဲ့ ဗင်ယာမိန်အနွယ်ကိုတော့ စာရင်းမကောက်ဘူး။
  </para>
  <para style="p">
    <verse number="7" style="v" />စစ်မှန်တဲ့ဘုရားသခင်က ဒီလုပ်ရပ်ကို လုံးဝမနှစ်သက်တဲ့အတွက် အစ္စရေးလူတွေကို ဒဏ်ခတ်တယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />အဲဒီအခါ ဒါဝိဒ်က “ကျွန်တော်လုပ်ခဲ့တဲ့ အပြစ်ဟာ ကြီးလေးလွန်းပါတယ်။ မိုက်မဲတဲ့လုပ်ရပ်ကို ကျူးလွန်မိပါပြီ။ ကျွန်တော့်အပြစ်ကို ခွင့်လွှတ်ပေးပါ” ဆိုပြီး ဘုရားသခင်ကို အသနားခံတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဒါနဲ့ ဒါဝိဒ်ကို စိတ်အာရုံတွေ အသိပေးရတဲ့ ဂဒ်ကို ယေဟောဝါ မှာတယ်–
  </para>
  <para style="p">
    <verse number="10" style="v" />“ဒါဝိဒ်ကို သွားပြောပါ၊ ‘“မင်းကို ငါဒဏ်ခတ်မယ်၊ ဒီဘေးဒဏ်သုံးခုထဲက တစ်ခုကို ရွေးပါ” လို့ယေဟောဝါ ပြောတယ်။’”
  </para>
  <para style="p">
    <verse number="11" style="v" />ဂဒ်လည်း ဒါဝိဒ်မင်းဆီ ရောက်လာပြီး “ယေဟောဝါဘုရား ပြောတယ်– ‘ဒီဘေးဒဏ်သုံးခုထဲက ဘယ်တစ်ခုကို ရွေးမလဲ။
  </para>
  <para style="p">
    <verse number="12" style="v" />တိုင်းပြည်မှာ သုံးနှစ် အငတ်ဘေး ကျရောက်တာ၊ သုံးလလုံးလုံး ရန်သူတွေရဲ့ ဓားဘေးကြောင့် ဖျက်ဆီးခံရတာ၊ သုံးရက်လုံးလုံး ယေဟောဝါရဲ့ ဓားဖြစ်တဲ့ ကပ်ရောဂါ ကျရောက်ပြီး အစ္စရေးနယ်မြေအားလုံးကို ယေဟောဝါရဲ့ ကောင်းကင်တမန် ဖျက်ဆီးတာဆိုတဲ့ ဘေးဒဏ်တွေပဲ။ ကျွန်တော့်ကို လွှတ်လိုက်တဲ့အရှင်ကို ပြန်ပြောရမှာမို့လို့ မင်းကြီး စဉ်းစားပါ” ဆိုပြီး လျှောက်တင်တယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />အဲဒီအခါ ဒါဝိဒ်က “ငါတော့ ဘေးကျပ်နံကျပ်ဖြစ်နေပြီ။ ယေဟောဝါရဲ့ ကရုဏာကြီးမားတဲ့အတွက် ကိုယ်တော့်လက်ထဲမှာပဲ ကျရောက်ပါစေ။ လူ့လက်ထဲမှာတော့ မကျရောက်ပါစေနဲ့” ဆိုပြီးပြောတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />အဲဒီအခါ ယေဟောဝါက အစ္စရေးပြည်မှာ ကပ်ရောဂါ ကျရောက်စေတဲ့အတွက် အစ္စရေးလူ ၇၀,၀၀၀ သေဆုံးသွားတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဒါ့အပြင် ဂျေရုဆလင်မြို့ကို ဖျက်ဆီးဖို့ ကောင်းကင်တမန်ကို လွှတ်လိုက်တယ်။ ဒါပေမဲ့ ကောင်းကင်တမန် ဖျက်ဆီးတော့မယ်ဆိုတာကို ယေဟောဝါ မြင်တဲ့အခါ စိတ်မကောင်းဖြစ်ပြီး “တော်ပြီ။ လက်ပြန်ရုပ်လိုက်တော့” လို့တားတယ်။ အဲဒီအချိန်မှာ ယေဟောဝါရဲ့ ကောင်းကင်တမန်က ယေဗုသိလူမျိုး သြရနန်ရဲ့ ကောက်နယ်တလင်းနားမှာ ရပ်နေတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဒါဝိဒ် လှမ်းကြည့်တဲ့အခါ ယေဟောဝါရဲ့ ကောင်းကင်တမန်က မိုးနဲ့မြေကြားမှာ ရပ်နေပြီး ဓားကိုင်ထားတဲ့ လက်ကို ဂျေရုဆလင်မြို့ဘက် ဆန့်ထားတာ တွေ့ရတယ်။ အထည်ကြမ်း ဝတ်ထားတဲ့ ဒါဝိဒ်နဲ့ အကြီးအကဲတွေလည်း ချက်ချင်းပဲ ဦးညွှတ်ပျပ်ဝပ်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ပြီးတော့ ဒါဝိဒ်က ဘုရားသခင်ကို “လူဦးရေစာရင်းကောက်ဖို့ ပြောခဲ့တာ ကျွန်တော်ပါ။ ပြစ်မှားသူဟာ ကျွန်တော်ပါ။ ကျွန်တော် အမှားလုပ်ခဲ့တာပါ။ ဒီလူတွေ ဘာလုပ်မိလို့လဲ။ ယေဟောဝါဘုရား၊ ကျွန်တော်နဲ့ အဖေ့အိမ်သားတွေအပေါ်မှာပဲ ကိုယ်တော့်လက် ကျရောက်ပါစေ။ လူမျိုးတော်အပေါ်မှာတော့ ဒီဘေးဆိုး မကျရောက်ပါစေနဲ့” ဆိုပြီး အသနားခံတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အဲဒီအခါ ယေဟောဝါရဲ့ ကောင်းကင်တမန်က ယေဗုသိလူမျိုး သြရနန်ရဲ့ ကောက်နယ်တလင်းကို တက်သွားပါ၊ အဲဒီမှာ ယေဟောဝါအတွက် ပူဇော်ရာပလ္လင် တည်ပါဆိုပြီး ဒါဝိဒ်ကိုပြောဖို့ ဂဒ်ကို မှာလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဒါဝိဒ်လည်း ပရောဖက်ဂဒ်ကတစ်ဆင့် ယေဟောဝါ မိန့်မှာတဲ့အတိုင်း တက်သွားတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />သြရနန် ဂျုံစပါးနယ်နေတုန်း လှမ်းကြည့်တော့ ကောင်းကင်တမန်ကို တွေ့သွားတယ်။ အဲဒီအခါ သူနဲ့အတူရှိနေတဲ့ သားလေးယောက် ပုန်းနေကြတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />သြရနန်က သူ့ဆီ ဒါဝိဒ်လာနေတာကို မြင်တာနဲ့ ကောက်နယ်တလင်းကနေ ထွက်လာပြီး ဒါဝိဒ်ရှေ့မှာ ဦးညွှတ်ပျပ်ဝပ်တယ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဒါဝိဒ်က “ယေဟောဝါဘုရားအတွက် ပူဇော်ရာပလ္လင် တည်ချင်လို့ မင်းရဲ့ကောက်နယ်တလင်းကို ရောင်းပေးပါ။ တန်ရာတန်ကြေး ပေးပါ့မယ်။ ဒါမှ လူတွေအပေါ် ကျရောက်နေတဲ့ ဘေးဒဏ် ရပ်တန့်သွားမယ်” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />သြရနန်က “ဒီကောက်နယ်တလင်းကို ယူပြီး အရှင်မင်းကြီး အလိုရှိတဲ့အတိုင်းသာ လုပ်ပါ။ မီးရှို့ရာအလှူတွေအတွက် နွားတွေ၊ ကောက်နှံအလှူအတွက် ဂျုံစပါးတွေနဲ့ ထင်းဆိုက်ဖို့ ကောက်နယ်ပြားကို ပေးပါ့မယ်။ ဒါတွေအားလုံးကို ကျွန်တော်ပေးပါတယ်” လို့ ဒါဝိဒ်ကို ပြောတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဒါပေမဲ့ ဒါဝိဒ်မင်းက “မဖြစ်ဘူး။ တန်ရာတန်ကြေးပေးပြီး ဝယ်မှဖြစ်မယ်။ မင်းရဲ့ဥစ္စာတွေကို ယူပြီး ယေဟောဝါဘုရားကို မပေးချင်ဘူး။ အဖိုးအခမပေးဘဲရတဲ့ မီးရှို့ရာ ပူဇော်သက္ကာတွေကို ငါမပူဇော်ချင်ဘူး” လို့ပြောပြီး၊
  </para>
  <para style="p">
    <verse number="25" style="v" />အဲဒီကောက်နယ်တလင်းအတွက် ရွှေရှယ်ကယ် ၆၀၀ ကိုချိန်ပြီး သြရနန်ကို ပေးလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဒါဝိဒ်က အဲဒီမှာ ယေဟောဝါအတွက် ပူဇော်ရာပလ္လင်တည်ပြီး မီးရှို့ရာပူဇော်သက္ကာတွေနဲ့ မိတ်သဟာယ ပူဇော်သက္ကာတွေကို ပူဇော်တယ်။ ပြီးတော့ ယေဟောဝါဆီ ဆုတောင်းတဲ့အခါ ပူဇော်ရာပလ္လင်ပေါ် ကောင်းကင်ကနေ မီးကျလာတယ်။ ဒီနည်းနဲ့ ကိုယ်တော် ဖြေကြားပေးတယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ယေဟောဝါက ကောင်းကင်တမန်ကို ဓားအိမ်ထဲ ဓားပြန်သွင်းဖို့ အမိန့်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဒါဝိဒ်က ယေဗုသိလူမျိုး သြရနန်ရဲ့ ကောက်နယ်တလင်းမှာ ယေဟောဝါ ဖြေကြားမှန်း သိတဲ့အခါ အဲဒီမှာ အမြဲ ပူဇော်တော့တယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />တောကန္တာရမှာ မောရှေဆောက်ခဲ့တဲ့ ယေဟောဝါရဲ့ တဲတော်နဲ့ မီးရှို့ပူဇော်ရာပလ္လင်ကတော့ အဲဒီတုန်းက ဂိဗောင်မြို့၊ အထွတ်အမြတ်နေရာမှာ ရှိနေတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဒါပေမဲ့ ဒါဝိဒ်က ယေဟောဝါရဲ့ ကောင်းကင်တမန် ကိုင်ထားတဲ့ ဓားကို ကြောက်လို့ ဘုရားသခင်ကို မေးမြန်းဖို့ အဲဒီနေရာကို မသွားရဲဘူး။
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />အဲဒီနောက် ဒါဝိဒ်က “ဒီနေရာမှာ စစ်မှန်တဲ့ဘုရားသခင် ယေဟောဝါရဲ့ အိမ်တော် ရှိရမယ်။ ဒီနေရာမှာတော့ အစ္စရေးတွေရဲ့ မီးရှို့ပူဇော်ရာပလ္လင် ရှိရမယ်” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ပြီးတော့ ဒါဝိဒ်က အစ္စရေးပြည်မှာနေတဲ့ တိုင်းတစ်ပါးသားတွေကို ခေါ်ပြီး ဘုရားသခင့်အိမ်တော် တည်ဆောက်ရာမှာ သုံးဖို့ ကျောက်တွေကို ဖြတ်ရ၊ ထုဆစ်ရတဲ့ ကျောက်ဆစ်သမားတွေအဖြစ် ခန့်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />မချိန်တွယ်နိုင်လောက်အောင် များတဲ့ ကြေးနီတွေအပြင် တံခါးမှာသုံးမယ့် သံချောင်းတွေ၊ ပတ္တာတွေအတွက် သံတွေအများကြီးကိုလည်း စုဆောင်းထားတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဆိုင်ဒုန်လူတွေနဲ့ တိုင်ရာလူတွေက ဒါဝိဒ်ဆီ သစ်ကတိုးသားတွေ အများကြီး ယူလာပေးတဲ့အတွက် သစ်ကတိုးသားတွေလည်း တောင်ပုံရာပုံ ဖြစ်နေတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဒါဝိဒ်က “ယေဟောဝါဘုရားအတွက် ငါ့သားရှောလမုန် ဆောက်ရမယ့် အိမ်တော်ဟာ သိပ်ကိုခမ်းနားထည်ဝါပြီး လှပတင့်တယ်ရမယ်။ ဒါမှ တိုင်းနိုင်ငံအသီးသီးမှာ အိမ်တော်ရဲ့ ဂုဏ်သတင်း ကျော်စောလိမ့်မယ်။ ဒါပေမဲ့ ရှောလမုန်ဟာ အသက်ကလည်းငယ်၊ အတွေ့အကြုံလည်း မရှိတော့ သူ့အတွက် အသင့်ပြင်ထားပေးမှ ဖြစ်မယ်” ဆိုပြီး မသေဆုံးခင်မှာ လိုအပ်တဲ့ပစ္စည်းတွေ အများကြီး ပြင်ဆင်ပေးခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဒါဝိဒ်က သားတော်ရှောလမုန်ကို ခေါ်ပြီး အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါအတွက် အိမ်တော်တည်ဆောက်ဖို့ ညွှန်ကြားတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ပြီးတော့ ရှောလမုန်ကို “ငါကိုးကွယ်တဲ့ဘုရား ယေဟောဝါရဲ့ နာမတော်အတွက် အိမ်တော်တည်ဆောက်ဖို့ ငါဆန္ဒပြင်းပြခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဒါပေမဲ့ ယေဟောဝါဘုရားက ‘မင်းဟာ တိုက်ပွဲကြီးတွေ ဆင်နွှဲပြီး လူအမြောက်အမြား သတ်ခဲ့တယ်။ ငါ့ရှေ့မှာ၊ မြေကြီးပေါ်မှာ လူအမြောက်အမြား သတ်ခဲ့တဲ့သူဖြစ်လို့ ငါ့နာမည်အတွက် အိမ်တော်ကို မင်း မဆောက်ရဘူး။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဒါပေမဲ့ မင်းရဲ့သားတစ်ယောက်ဟာ ငြိမ်းချမ်းတဲ့သူ ဖြစ်လိမ့်မယ်။ သူ့လက်ထက်မှာ အစ္စရေးပြည်ကို ငါငြိမ်သက်အေးချမ်းစေပြီး ပတ်ဝန်းကျင် ရန်သူတွေရဲ့ ဘေးရန်ကနေ ကင်းဝေးစေမယ်။ ဒါကြောင့် သူ့ကို ရှောလမုန် လို့ခေါ်ရမယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />သူက ငါ့နာမည်အတွက် အိမ်တော် တည်ဆောက်လိမ့်မယ်။ သူဟာ ငါ့သားဖြစ်လာပြီး ငါဟာ သူ့ဖခင်ဖြစ်လာမယ်။ အစ္စရေးပြည်မှာ သူ့ရာဇပလ္လင်ကို ထာဝစဉ် ငါတည်မြဲစေမယ်’ လို့မိန့်မှာထားတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />“ဒါကြောင့် ငါ့သား၊ မင်းနဲ့အတူ ယေဟောဝါဘုရား ရှိပါစေ။ မင်းနဲ့ပတ်သက်ပြီး ယေဟောဝါဘုရား ပြောခဲ့တဲ့အတိုင်း အိမ်တော်ကို အောင်မြင်စွာ တည်ဆောက်နိုင်ပါစေ။
  </para>
  <para style="p">
    <verse number="12" style="v" />အစ္စရေးတွေကို မင်းအုပ်ချုပ်တဲ့အခါ မြော်မြင်ချင့်ချိန်နိုင်စွမ်းနဲ့ သိနားလည်နိုင်စွမ်းကိုလည်း ယေဟောဝါ ပေးပါစေ။ ဒါမှ ယေဟောဝါဘုရားရဲ့ ပညတ်ကို မင်းလိုက်နာနိုင်မယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />မောရှေကတစ်ဆင့် အစ္စရေးတွေကို ယေဟောဝါပေးခဲ့တဲ့ စည်းမျဉ်းတွေ၊ တရားစီရင်ချက်တွေကို ဂရုတစိုက် လိုက်နာမယ်ဆိုရင် မင်း အောင်မြင်မယ်။ ဒါကြောင့် ရဲစွမ်းသတ္တိရှိပါ။ မကြောက်နဲ့။
  </para>
  <para style="p">
    <verse number="14" style="v" />ယေဟောဝါရဲ့ အိမ်တော်အတွက် ရွှေတဲလင့် ၁၀၀,၀၀၀၊ ငွေတဲလင့် ၁,၀၀၀,၀၀၀၊ မချိန်နိုင်လောက်အောင် များတဲ့ ကြေးနီနဲ့သံတွေကို ငါအပင်ပန်းခံပြီး စုဆောင်းထားတယ်။ သစ်သားတွေ၊ ကျောက်တွေလည်း အဆင်သင့်ပဲ။ ဒါပေမဲ့ မင်း ထပ်ဖြည့်ရဦးမယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />မင်းဆီမှာ ကျောက်ဆစ်သမားတွေ၊ ပန်းရန်သမားတွေ၊ လက်သမားတွေ အများကြီးပဲ။ အတတ်ပညာရှင်မျိုးစုံလည်း ရှိတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />ရွှေ၊ ငွေ၊ ကြေးနီ၊ သံတွေလည်း တောင်ပုံရာပုံ ရှိနေတာပဲ။ ဒါကြောင့် လုပ်ငန်းစပေတော့။ မင်းနဲ့အတူ ယေဟောဝါဘုရား ရှိပါစေ” လို့ ပြောတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒါဝိဒ်က သားတော် ရှောလမုန်ကို ဝိုင်းကူကြဖို့ အစ္စရေးမှူးမတ်တွေကို မှာကြားပြီး၊
  </para>
  <para style="p">
    <verse number="18" style="v" />“ယေဟောဝါဘုရားက မင်းတို့နဲ့အတူ ရှိတယ်၊ အရပ်ရပ်မှာလည်း ငြိမ်သက်အေးချမ်းစေခဲ့တယ်။ ယေဟောဝါက ဒီပြည်သူပြည်သားတွေကို ငါ့လက်ထဲ အပ်တဲ့အတွက် ကိုယ်တော့်ရှေ့၊ လူမျိုးတော်ရှေ့မှာ ဒီပြည်ကို အနိုင်ရခဲ့ပြီ။
  </para>
  <para style="p">
    <verse number="19" style="v" />အခု ယေဟောဝါဘုရားကို စိတ်စွမ်းရှိသမျှ၊ ကိုယ်စွမ်းရှိသမျှ ဝတ်ပြုဖို့ စိတ်ပိုင်းဖြတ်ထားပါ။ ယေဟောဝါရဲ့ သန့်ရှင်းရာဌာနတော်ကို စပြီးတည်ဆောက်ကြတော့။ ဒါမှ ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာနဲ့ ဘုရားသခင်ရဲ့ သန့်ရှင်းတဲ့ အသုံးအဆောင်တွေကို ယေဟောဝါရဲ့ နာမတော်အတွက် ဆောက်ထားတဲ့ အိမ်တော်ထဲ သွင်းထားနိုင်မှာ” လို့ပြောတယ်။
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်ဟာ အသက်ကြီးပြီး ဘဝနေဝင်ချိန် ရောက်လာတဲ့အခါ သားတော် ရှောလမုန်ကို အစ္စရေးဘုရင်အဖြစ် နန်းတင်လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ပြီးတော့ အစ္စရေးမှူးမတ်တွေ၊ ပုရောဟိတ်တွေ၊ လေဝိအမျိုးသားတွေကို စုရုံးတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />အသက် ၃၀ ပြည့်တဲ့ လေဝိအမျိုးသားတွေကို ရေတွက်တဲ့အခါ ၃၈,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />သူတို့ထဲမှာ ၂၄,၀၀၀ က ယေဟောဝါရဲ့ အိမ်တော်လုပ်ငန်းကို ကြီးကြပ်ရတယ်။ ၆,၀၀၀ က လက်ထောက်ခေါင်းဆောင်နဲ့ တရားသူကြီးတွေ လုပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />တံခါးစောင့် ၄,၀၀၀ ရှိတယ်။ ကျန်တဲ့ ၄,၀၀၀ က “ချီးမွမ်းသီဆိုတဲ့အခါ တီးမှုတ်ဖို့ ငါလုပ်ထားတာ” ဆိုပြီး ဒါဝိဒ်ပြောခဲ့တဲ့ တူရိယာတွေ တီးမှုတ်ပြီး ယေဟောဝါကို ချီးမွမ်းသီဆိုရတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဒါဝိဒ်က ဂေရရှုန်၊ ကောဟတ်၊ မေရာရိဆိုတဲ့ လေဝိသားသုံးယောက်ရဲ့ နာမည်အလိုက် အုပ်စုတွေ ဖွဲ့လိုက်တယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဂေရရှုန်အမျိုးသား နှစ်ယောက်က လာဒန်နဲ့ ရှိမိ။
  </para>
  <para style="p">
    <verse number="8" style="v" />လာဒန်ရဲ့သားသုံးယောက်က ခေါင်းဆောင်ယေဟေလ၊ ဇေသံ၊ ယောလ။
  </para>
  <para style="p">
    <verse number="9" style="v" />လာဒန်ကနေ ဆင်းသက်လာတဲ့ ဆွေမျိုးစုခေါင်းဆောင် သုံးယောက်က ရှေလောမုတ်၊ ဟာဇေလ၊ ခါရန်။ သူတို့ရဲ့အဖေက ရှိမိ။
  </para>
  <para style="p">
    <verse number="10" style="v" />ရှိမိ ရဲ့သားတွေက ယာဟတ်၊ ဇိန၊ ယုရှ၊ ဗေရိယ။ သူတို့လေးယောက်ဟာ ရှိမိရဲ့သားတွေပဲ။
  </para>
  <para style="p">
    <verse number="11" style="v" />ခေါင်းဆောင်က ယာဟတ်။ ဒုတိယက ဇိဇ။ ယုရှနဲ့ ဗေရိယမှာတော့ သားအများကြီး မရှိတဲ့အတွက် နှစ်ယောက်ပေါင်း အိမ်ထောင်တစ်စုလို့ သတ်မှတ်ပြီး တာဝန်တစ်မျိုးတည်း ရကြတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ကောဟတ်မှာ အာမရံ၊ အိဇဟာ၊ ဟေဗြုန်၊ သြဇေလ ဆိုတဲ့ သား ၄ ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />အာမရံရဲ့သားတွေက အာရုန်နဲ့ မောရှေ။ အာရုန်နဲ့ သူ့သားမြေးတွေကိုတော့ အသန့်ရှင်းဆုံးအခန်းကို သန့်ရှင်းမြင့်မြတ်စေဖို့၊ ယေဟောဝါရှေ့မှာ ပူဇော်သက္ကာဆက်သပြီး ဘုရားအတွက် အမှုဆောင်ဖို့၊ ဘုရားရဲ့နာမည်ကို အမှီပြုပြီး အမြဲကောင်းချီးပေးဖို့ သီးသန့်ဖယ်ထားလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />စစ်မှန်တဲ့ဘုရားသခင်ရဲ့လူ မောရှေရဲ့သားတွေက လေဝိအနွယ်ဝင် စာရင်းထဲမှာ ပါတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />မောရှေရဲ့သားတွေက ဂေရရှုံနဲ့ ဧလျာဇာ။
  </para>
  <para style="p">
    <verse number="16" style="v" />ဂေရရှုံရဲ့သားတွေထဲမှာ ခေါင်းဆောင်က ရှေဗွေလ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဧလျာဇာရဲ့ သားမြေးတွေထဲမှာ ခေါင်းဆောင်က ရေဟဘိ။ ဧလျာဇာမှာ တခြားသားတွေ မရှိပေမဲ့ ရေဟဘိမှာတော့ သားတွေအများကြီး ရှိတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အိဇဟာရဲ့သားတွေထဲမှာ ခေါင်းဆောင်က ရှေလောမိတ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဟေဗြုန်ရဲ့သားတွေထဲမှာ ခေါင်းဆောင်က ယေရိ၊ ဒုတိယက အာမရိ၊ တတိယက ယဟာဇေလ၊ စတုတ္ထက ယေကမံ။
  </para>
  <para style="p">
    <verse number="20" style="v" />သြဇေလရဲ့သားတွေထဲမှာ ခေါင်းဆောင်က မိက္ခာ၊ ဒုတိယက အိရှယ။
  </para>
  <para style="p">
    <verse number="21" style="v" />မေရာရိရဲ့သားတွေက မဟာလိနဲ့ မုရှိ။ မဟာလိရဲ့သားတွေက ဧလာဇာနဲ့ ကိရှ။
  </para>
  <para style="p">
    <verse number="22" style="v" />ဧလာဇာကတော့ ကွယ်လွန်သွားတယ်။ သားတစ်ယောက်မှ မရှိဘဲ သမီးတွေပဲရှိတာကြောင့် ဆွေမျိုးတွေဖြစ်တဲ့ ကိရှရဲ့သားတွေက သူတို့နဲ့ လက်ထပ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />မုရှိမှာတော့ မဟာလိ၊ ဧဒါ၊ ယေရမုတ်လို့ခေါ်တဲ့ သားသုံးယောက် ရှိတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />ယေဟောဝါရဲ့ အိမ်တော်လုပ်ငန်း လုပ်ဆောင်ဖို့ အသက် ၂၀ ပြည့်ပြီးသူတွေကို စာရင်းကောက်တဲ့အခါ နာမည်စာရင်းဝင်သူတွေ ရှိတယ်။ သူတို့ဟာ ဖခင်မျိုးရိုးအလိုက် လေဝိရဲ့သားမြေးတွေ၊ ဆွေမျိုးစုခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="25" style="v" />ဒါဝိဒ်က “အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါက မိမိလူမျိုးကို အေးချမ်းစွာ နေထိုင်ခွင့်ပေးပြီ။ ဂျေရုဆလင်မြို့မှာ ဘုရား ထာဝစဉ် စံမြန်းလိမ့်မယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />လေဝိအမျိုးသားတွေလည်း တဲတော်နဲ့ တဲတော်အသုံးအဆောင်တွေကို သယ်စရာ မလိုတော့ဘူး” လို့ပြောခဲ့တဲ့အတွက်၊
  </para>
  <para style="p">
    <verse number="27" style="v" />သူ့ရဲ့ နောက်ဆုံးညွှန်ကြားချက်တွေအရ အသက် ၂၀ ပြည့်တဲ့ လေဝိအမျိုးသားတွေကို ရေတွက်တယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />သူတို့ရဲ့တာဝန်က ယေဟောဝါရဲ့ အိမ်တော်လုပ်ငန်းမှာ အာရုန်ရဲ့သားမြေးတွေကို ကူညီပေးဖို့၊ အိမ်တော်ဝင်းတွေ၊ စားသောက်ခန်းတွေကို ကြီးကြပ်ဖို့၊ သန့်ရှင်းမြင့်မြတ်ရာတွေကို စင်ကြယ်စေဖို့နဲ့ ဘုရားသခင်ရဲ့ အိမ်တော်လုပ်ငန်းအတွက် လိုအပ်သမျှ လုပ်ဆောင်ပေးဖို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />အဆင့်ဆင့်တင်ထားတဲ့မုန့်၊ ကောက်နှံအလှူအတွက် ဂျုံနု၊ တဆေးမဲ့မုန့်ပြားတွေ၊ ဒယ်ပြားမှာလုပ်တဲ့ မုန့်တွေ၊ နယ်ထားတဲ့ မုန့်စိမ်း၊ အလေးချိန် အခြင်အတွယ်တွေနဲ့ ပတ်သက်ပြီးတော့လည်း သူတို့ ကူညီပေးရတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />မနက်တိုင်း ယေဟောဝါကို ကျေးဇူးတင်ချီးမွမ်းဖို့ ရပ်နေရတယ်။ ညနေပိုင်းမှာလည်း ရပ်နေရတယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />ဥပုသ်နေ့တွေ၊ လဆန်းနေ့တွေ၊ ပွဲတော်ရာသီတွေမှာ ယေဟောဝါအတွက် မီးရှို့ရာ ပူဇော်သက္ကာတွေကို ပူဇော်တဲ့အခါတိုင်း ကူညီပေးရတယ်။ ပူဇော်သက္ကာတွေနဲ့ပတ်သက်ပြီး သတ်မှတ်ထားတဲ့ အရေအတွက်အတိုင်း ယေဟောဝါရှေ့မှာ ပုံမှန် ပူဇော်ရတယ်။
  </para>
  <para style="p">
    <verse number="32" style="v" />တွေ့ဆုံရာတဲတော်နဲ့ သန့်ရှင်းရာအရပ်မှာ သူတို့ရဲ့ တာဝန်တွေကို ထမ်းဆောင်ရတယ်။ ယေဟောဝါရဲ့ အိမ်တော်မှာ ညီအစ်ကိုတွေဖြစ်တဲ့ အာရုန်ရဲ့သားမြေးတွေကိုလည်း ကူညီပေးရတယ်။
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />အာရုန်ရဲ့သားမြေးတွေကို အုပ်စုတွေ ခွဲထားတယ်။ အာရုန်ရဲ့သားတွေက နာဒပ်၊ အဘိဟု၊ ဧလာဇာ၊ ဧသမာ။
  </para>
  <para style="p">
    <verse number="2" style="v" />နာဒပ်နဲ့ အဘိဟုက ဖခင် မကွယ်လွန်မီ သေဆုံးခဲ့ကြတယ်။ သူတို့မှာ သားတစ်ယောက်မှ မရှိဘူး။ ဒါပေမဲ့ ဧလာဇာနဲ့ ဧသမာကတော့ ပုရောဟိတ်တွေအဖြစ် ဆက်အမှုဆောင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဒါဝိဒ်က အာရုန်ရဲ့သားမြေးတွေကို လုပ်ငန်းတာဝန်အလိုက် အုပ်စုတွေ ခွဲပေးတယ်။ ဧလာဇာအမျိုးထဲက ဇာဒုတ်၊ ဧသမာအမျိုးထဲက အဟိမလက်က ဒါဝိဒ်ကို ဝိုင်းကူပေးတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဧလာဇာအမျိုးက ဧသမာအမျိုးထက် ခေါင်းဆောင် ပိုများတာကြောင့် ခေါင်းဆောင်တွေကို ခွဲလိုက်တဲ့အခါ ဧလာဇာအမျိုးမှာ ဆွေမျိုးစုခေါင်းဆောင် ၁၆ ယောက်၊ ဧသမာအမျိုးမှာ ဆွေမျိုးစုခေါင်းဆောင် ၈ ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ဒါ့အပြင် ဧလာဇာအမျိုးမှာရော၊ ဧသမာအမျိုးမှာရော သန့်ရှင်းရာအရပ်မှာ ကြီးကြပ်တဲ့ ခေါင်းဆောင်တွေ၊ စစ်မှန်တဲ့ ဘုရားသခင်အတွက် အမှုဆောင်တဲ့ ခေါင်းဆောင်တွေ ရှိတယ်။ ဒါကြောင့် အုပ်စုတွေကို မဲချပြီး တာဝန်ခွဲဝေပေးလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဧလာဇာအမျိုးထဲက ဆွေမျိုးစုတစ်စု၊ ဧသမာအမျိုးထဲက ဆွေမျိုးစုတစ်စုကို အလှည့်ကျ မဲချပြီး ရွေးတယ်။ အဲဒီနောက် နာသနေလရဲ့သား လေဝိအမျိုးသားတွေရဲ့ စာရေးတော် ရှေမာယက ဘုရင်နဲ့ မှူးမတ်တွေရှေ့မှာ၊ ပုရောဟိတ်ဇာဒုတ်၊ အဗျာသာရဲ့သား အဟိမလက်၊ ပုရောဟိတ်တွေနဲ့ လေဝိအမျိုးသား ဆွေမျိုးစုခေါင်းဆောင်တွေရှေ့မှာ သူတို့ရဲ့နာမည်ကို ရေးမှတ်တယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ဦးဆုံးမဲကျတဲ့သူက ယောယရိပ်၊ ဒုတိယ ယေဒါယ၊
  </para>
  <para style="p">
    <verse number="8" style="v" />တတိယ ဟာရိမ်၊ စတုတ္ထ စောရိမ်၊
  </para>
  <para style="p">
    <verse number="9" style="v" />ပဉ္စမ မာလခိယ၊ ဆဋ္ဌမ မိယာမိန်၊
  </para>
  <para style="p">
    <verse number="10" style="v" />သတ္တမ ဟက္ကုတ်၊ အဋ္ဌမ အဘိယ၊
  </para>
  <para style="p">
    <verse number="11" style="v" />နဝမ ယေရွှာ၊ ဒသမ ရှေကနိ၊
  </para>
  <para style="p">
    <verse number="12" style="v" />ဆယ့်တစ်ယောက်မြောက် ဧလျာရှိပ်၊ ဆယ့်နှစ်ယောက်မြောက် ယာကိမ်၊
  </para>
  <para style="p">
    <verse number="13" style="v" />ဆယ့်သုံးယောက်မြောက် ဟုပါ၊ ဆယ့်လေးယောက်မြောက် ယေရှေဗပ်၊
  </para>
  <para style="p">
    <verse number="14" style="v" />ဆယ့်ငါးယောက်မြောက် ဗိလဂ၊ ဆယ့်ခြောက်ယောက်မြောက် အိမေရ၊
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆယ့်ခုနစ်ယောက်မြောက် ဟေဇိရ၊ ဆယ့်ရှစ်ယောက်မြောက် အပ်ဇစ်၊
  </para>
  <para style="p">
    <verse number="16" style="v" />ဆယ့်ကိုးယောက်မြောက် ပေသဟိ၊ အယောက်နှစ်ဆယ်မြောက် ယေဇကဲ၊
  </para>
  <para style="p">
    <verse number="17" style="v" />နှစ်ဆယ့်တစ်ယောက်မြောက် ယာခိန်၊ နှစ်ဆယ့်နှစ်ယောက်မြောက် ဂါမုလ၊
  </para>
  <para style="p">
    <verse number="18" style="v" />နှစ်ဆယ့်သုံးယောက်မြောက် ဒေလာယ၊ နှစ်ဆယ့်လေးယောက်မြောက် မာဇိတို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဘိုးဘေးအာရုန် ချမှတ်ခဲ့တဲ့ လုပ်ထုံးလုပ်နည်းအတိုင်း၊ အာရုန်ကို အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါ မိန့်မှာခဲ့တဲ့အတိုင်း ယေဟောဝါရဲ့ အိမ်တော်ကို လာပြီး အမှုဆောင်ဖို့ အဲဒီလို စီစဉ်ထားတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ကျန်တဲ့လေဝိအမျိုးသားတွေကတော့– အာမရံရဲ့ သားမြေးတွေထဲမှာ ရှုဗွေလ၊ ရှုဗွေလရဲ့ သားမြေးတွေထဲမှာ ယေဒေယ၊
  </para>
  <para style="p">
    <verse number="21" style="v" />ရေဟဘိရဲ့ သားမြေးတွေထဲမှာ ခေါင်းဆောင် အိရှယာ၊
  </para>
  <para style="p">
    <verse number="22" style="v" />အိဇဟာရဲ့ သားမြေးတွေထဲမှာ ရှေလောမုတ်၊ ရှေလောမုတ်ရဲ့ သားမြေးတွေထဲမှာ ယာဟတ်၊
  </para>
  <para style="p">
    <verse number="23" style="v" />ဟေဗြုန်ရဲ့ သားမြေးတွေထဲမှာ ခေါင်းဆောင်က ယေရိ၊ ဒုတိယ အာမရိ၊ တတိယ ယဟာဇေလ၊ စတုတ္ထ ယေကမံ၊
  </para>
  <para style="p">
    <verse number="24" style="v" />သြဇေလရဲ့ သားမြေးတွေထဲမှာ မိက္ခာ၊ မိက္ခာရဲ့ သားမြေးတွေထဲမှာ ရှမိရ။
  </para>
  <para style="p">
    <verse number="25" style="v" />မိက္ခာနဲ့ ညီအစ်ကိုတော်တဲ့ အိရှယ။ အိရှယရဲ့ သားမြေးတွေထဲမှာ ဇာခရိဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />မေရာရိရဲ့ သားတွေက မဟာလိနဲ့ မုရှိ။ ယာဇိရဲ့သားမြေးတွေထဲမှာ ဗေနောဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />မေရာရိရဲ့ သားမြေးတွေကတော့– ယာဇိရဲ့သားမြေးတွေထဲမှာ ဗေနော၊ ရှောဟံ၊ ဇက္ကုရ၊ အိဗရိတို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />မဟာလိရဲ့သား ဧလာဇာမှာတော့ သားတစ်ယောက်မှ မရှိဘူး။
  </para>
  <para style="p">
    <verse number="29" style="v" />ကိရှရဲ့သားမြေးတွေထဲမှာ ယေရမေလ။
  </para>
  <para style="p">
    <verse number="30" style="v" />မုရှိရဲ့သားတွေက မဟာလိ၊ ဧဒါ၊ ယေရိမုတ်တို့ဖြစ်တယ်။ သူတို့ဟာ ဖခင်မျိုးရိုးအလိုက် လေဝိအမျိုးသားတွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />သူတို့လည်း ညီအစ်ကိုတွေဖြစ်တဲ့ အာရုန်ရဲ့သားမြေးတွေ လုပ်သလိုပဲ ဒါဝိဒ်မင်း၊ ဇာဒုတ်၊ အဟိမလက်၊ ပုရောဟိတ်တွေနဲ့ လေဝိအမျိုးသားတွေရဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေရှေ့မှာ မဲချကြတယ်။ ကြီးတာငယ်တာကို ထည့်မတွက်ဘဲ မဲချကြတယ်။
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါ့အပြင် ဒါဝိဒ်နဲ့ အုပ်စုခေါင်းဆောင်တွေက ယေဒုသုန်၊ ဟေမန်နဲ့ အာသပ်ရဲ့သားတချို့ကို စောင်းတွေ၊ ကြိုးတပ်တူရိယာတွေ၊ လင်းကွင်းတွေ တီးပြီး ဘုရားကို ချီးမွမ်းဖို့၊ ပရောဖက်ပြုဖို့ သီးသန့်ခွဲထားတယ်။ အဲဒီလိုအမှုဆောင်ဖို့ တာဝန်ရထားသူတွေရဲ့ စာရင်းကတော့–
  </para>
  <para style="p">
    <verse number="2" style="v" />အာသပ်ရဲ့သားတွေထဲမှာ ဇက္ကုရ၊ ယောသပ်၊ နာသနိ၊ အာရှရေလ။ သူတို့က အာသပ် ညွှန်ကြားတဲ့အတိုင်း လုပ်ဆောင်ရတယ်။ အာသပ်က ဘုရင် ညွှန်ကြားတဲ့အတိုင်း ပရောဖက်ပြုရတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ယေဒုသုန်ရဲ့ သားတွေထဲမှာ ဂေဒလိ၊ ဇေရိ၊ ယေရှာယ၊ ရှိမိ၊ ဟာရှဘိ၊ မာတသိ။ အဲဒီသားခြောက်ယောက်က ယေဟောဝါကို ကျေးဇူးတင်ချီးမွမ်းသူ၊ စောင်းတီးပြီး ပရောဖက်ပြုသူ ဖခင်ယေဒုသုန် ညွှန်ကြားတဲ့အတိုင်း လုပ်ဆောင်ရတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဟေမန်ရဲ့သားတွေထဲမှာ ဗုကိယ၊ မသနိ၊ သြဇေလ၊ ရှေဗွေလ၊ ယေရိမုတ်၊ ဟာနနိ၊ ဟာနေနိ၊ ဧလျာသာ၊ ဂိဒါလတိ၊ ရောမန်တေဇာ၊ ယောရှဗေကရှ၊ မေလောသိ၊ ဟောသိရ၊ မဟာဇုတ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />သူတို့အားလုံးဟာ ဟေမန်ရဲ့သားတွေပဲ။ ဟေမန်ဟာ ဘုရားကို ဂုဏ်တင်တဲ့ သတင်းစကားပါတဲ့ စိတ်အာရုံကို ဘုရင်ဆီ အသိပေးသူဖြစ်တယ်။ ဘုရားသခင်က ဟေမန်ကို သား ၁၄ ယောက်၊ သမီး ၃ ယောက် ပေးတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />သူတို့အားလုံးက ဖခင်ညွှန်ကြားတဲ့အတိုင်း ဘုရားသခင့်အိမ်တော်လုပ်ငန်းအတွက် လင်းကွင်း၊ ကြိုးတပ်တူရိယာ၊ စောင်းတွေ တီးပြီး ယေဟောဝါရဲ့ အိမ်တော်မှာ သီချင်းသီဆိုကြတယ်။ အာသပ်၊ ယေဒုသုန်နဲ့ ဟေမန်တို့လည်း ဘုရင်ညွှန်ကြားတဲ့အတိုင်း လုပ်ဆောင်ကြတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />သူတို့ရော သူတို့ညီအစ်ကိုတွေပါ ယေဟောဝါကို ချီးမွမ်းသီဆိုဖို့ လေ့ကျင့်ထားသူတွေ၊ တီးမှုတ်သီဆိုရာမှာ ကျွမ်းကျင်သူတွေဖြစ်တယ်။ စုစုပေါင်း ၂၈၈ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ကြီးသူငယ်သူ၊ ကျွမ်းကျင်သူ၊ မကျွမ်းကျင်သူ မခွဲခြားဘဲ မဲနှိုက်ပြီး တာဝန်ခွဲဝေယူရတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ဦးဆုံးမဲကျသူကတော့ အာသပ်ရဲ့သား ယောသပ်၊ ဒုတိယက ဂေဒလိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="10" style="v" />တတိယက ဇက္ကုရနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="11" style="v" />စတုတ္ထက အိဇရိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="12" style="v" />ပဉ္စမက နာသနိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="13" style="v" />ဆဋ္ဌမက ဗုကိယနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="14" style="v" />သတ္တမက ယေရှရေလနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="15" style="v" />အဋ္ဌမက ယေရှာယနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="16" style="v" />နဝမက မသနိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="17" style="v" />ဒသမက ရှိမိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="18" style="v" />ဆယ့်တစ်ယောက်မြောက်က အာဇာရေလနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="19" style="v" />ဆယ့်နှစ်ယောက်မြောက်က ဟာရှဘိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="20" style="v" />ဆယ့်သုံးယောက်မြောက်က ရှုဗွေလနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="21" style="v" />ဆယ့်လေးယောက်မြောက်က မာတသိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="22" style="v" />ဆယ့်ငါးယောက်မြောက်က ယေရမုတ်နဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="23" style="v" />ဆယ့်ခြောက်ယောက်မြောက်က ဟာနနိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="24" style="v" />ဆယ့်ခုနစ်ယောက်မြောက်က ယောရှဗေကရှနဲ့ ညီအစ်ကိုတွေ၊ သားတွေ အပါအဝင်၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="25" style="v" />ဆယ့်ရှစ်ယောက်မြောက်က ဟာနေနိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="26" style="v" />ဆယ့်ကိုးယောက်မြောက်က မေလောသိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="27" style="v" />အယောက်နှစ်ဆယ်မြောက်က ဧလျာသာနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="28" style="v" />နှစ်ဆယ့်တစ်ယောက်မြောက်က ဟောသိရနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="29" style="v" />နှစ်ဆယ့်နှစ်ယောက်မြောက်က ဂိဒါလတိနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ ယောက်၊
  </para>
  <para style="p">
    <verse number="30" style="v" />နှစ်ဆယ့်သုံးယောက်မြောက်က မဟာဇုတ်နဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်၊
  </para>
  <para style="p">
    <verse number="31" style="v" />နှစ်ဆယ့်လေးယောက်မြောက်က ရောမန်တေဇာနဲ့ ညီအစ်ကိုတွေ၊ သားတွေအပါအဝင် ၁၂ယောက်ဖြစ်တယ်။
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />တံခါးစောင့်အုပ်စုတွေကတော့– ကောရအမျိုးသားတွေထဲမှာ အာသပ်ရဲ့သားမြေးတွေထဲက ကောရေရဲ့သား မေရှလမိ။
  </para>
  <para style="p">
    <verse number="2" style="v" />မေရှလမိရဲ့ သားတွေက သားဦးဇာခရိ၊ ဒုတိယ ယေဒယေလ၊ တတိယ ဇေဗဒိ၊စတုတ္ထ ယာသနေလ၊
  </para>
  <para style="p">
    <verse number="3" style="v" />ပဉ္စမ ဧလံ၊ ဆဋ္ဌမ ယေဟောဟနန်၊ သတ္တမ ဧလျောနဲ။
  </para>
  <para style="p">
    <verse number="4" style="v" />သြဗက်ဧဒုံရဲ့သားတွေဖြစ်တဲ့ သားဦးရှေမာယ၊ ဒုတိယ ယဟောဇဗတ်၊ တတိယ ယောအာ၊ စတုတ္ထ စာကာ၊ ပဉ္စမ နာသနေလ၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ဆဋ္ဌမ အမျေလ၊ သတ္တမ အိသခါ၊ အဋ္ဌမ ပုလသဲ။ ဒီသားတွေဟာ သြဗက်ဧဒုံကို ဘုရားသခင် ပေးသနားတဲ့ ကောင်းချီးတွေပဲ။
  </para>
  <para style="p">
    <verse number="6" style="v" />သြဗက်ဧဒုံရဲ့သား ရှေမာယလည်း သားတွေရတယ်။ သူတို့ဟာ ခွန်အားကြီးသူတွေ၊ လုပ်ရည်ကိုင်ရည်ရှိသူတွေဖြစ်လို့ ဆွေမျိုးစုခေါင်းဆောင်တွေ ဖြစ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />ရှေမာယရဲ့သားတွေက ဩသနိ၊ ရေဖေလ၊ ဩဗက်၊ ဧလဇာဗဒ်။ ဧလဇာဗဒ်ရဲ့ညီအစ်ကို ဧလိဟုနဲ့သေမခိတို့လည်း လုပ်ရည်ကိုင်ရည်ရှိသူတွေပဲ။
  </para>
  <para style="p">
    <verse number="8" style="v" />သူတို့အားလုံးဟာ သြဗက်ဧဒုံရဲ့ သားမြေးတွေ ဖြစ်တယ်။ သူတို့ရဲ့သားတွေ၊ ညီအစ်ကိုတွေလည်း လုပ်ရည်ကိုင်ရည်ရှိသူတွေ၊ အမှုဆောင်ဖို့ အရည်အချင်းပြည့်မီသူတွေ ဖြစ်တယ်။ သြဗက်ဧဒုံရဲ့ သားမြေး စုစုပေါင်း ၆၂ ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />မေရှလမိမှာလည်း လုပ်ရည်ကိုင်ရည်ရှိတဲ့ သားတွေ၊ ညီအစ်ကိုတွေ စုစုပေါင်း ၁၈ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />မေရာရိအမျိုးသား ဟောသမှာ သားတွေရှိတယ်။ ခေါင်းဆောင်က ရှိမရိ။ သူက သားဦးမဟုတ်ပေမဲ့ ဖခင်က သူ့ကို ခေါင်းဆောင် ခန့်ထားတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ဒုတိယက ဟိလခိ၊ တတိယက တေဗလိ၊ စတုတ္ထက ဇာခရိ။ ဟောသရဲ့သားတွေ၊ ညီအစ်ကိုတွေ စုစုပေါင်း ၁၃ ယောက်ရှိတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />တံခါးစောင့်အုပ်စုရဲ့ ခေါင်းဆောင်တွေက သူတို့ရဲ့ ညီအစ်ကိုတွေလိုပဲ ယေဟောဝါရဲ့ အိမ်တော်မှာ အမှုဆောင်ဖို့ တာဝန်ရကြတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />သူတို့က ဆွေမျိုးစုအလိုက် အုပ်စုအကြီးအငယ် မခွဲဘဲ တာဝန်ကျမယ့် တံခါးကို မဲနှိုက်ရတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />အရှေ့ဘက်ခြမ်းကို မဲကျတဲ့သူက ရှေလမိ။ မြောက်ဘက်ခြမ်းကို မဲကျတဲ့သူက ရှေလမိရဲ့သား ပညာရှိအတိုင်ပင်ခံ ဇာခရိ။
  </para>
  <para style="p">
    <verse number="15" style="v" />တောင်ဘက်ခြမ်းကို မဲကျတဲ့သူက သြဗက်ဧဒုံ။ သူ့သားတွေကတော့ သိုလှောင်ရုံတွေကို စောင့်ကြပ်ဖို့ တာဝန်ရတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />အနောက်ဘက်ခြမ်းကို မဲကျတဲ့သူက ရှုပိမ်နဲ့ ဟောသ။ သူတို့က ရှေလခက်တံခါးနဲ့ အတက်လမ်းနားမှာ စောင့်ကြပ်ရတယ်။ အစောင့်အုပ်စုတွေက တစ်စုနဲ့တစ်စု ဘေးချင်းယှဉ်ပြီး စောင့်ကြတယ်။
  </para>
  <para style="p">
    <verse number="17" style="v" />အရှေ့ဘက်မှာ လေဝိအမျိုးသား ခြောက်ယောက် စောင့်တယ်။ မြောက်ဘက်မှာ တစ်ရက်ကို လေးယောက်၊ တောင်ဘက်မှာ တစ်ရက်ကို လေးယောက်၊ သိုလှောင်ရုံတွေကို နှစ်ယောက်တစ်တွဲစီ စောင့်ကြတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />အနောက်ဘက် ဆင်ဝင်အတွက်တော့ အတက်လမ်းမှာ လေးယောက်၊ ဆင်ဝင်မှာ နှစ်ယောက် စောင့်တယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဒါတွေဟာ ကောရအမျိုးသားတွေနဲ့ မေရာရိအမျိုးသားတွေထဲက တံခါးစောင့်အုပ်စုတွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ကျန်တဲ့လေဝိအမျိုးသားတွေထဲမှာ အဟိယက စစ်မှန်တဲ့ဘုရားသခင်ရဲ့ အိမ်တော်ဘဏ္ဍာတိုက်နဲ့ ဆက်ကပ်ထားတဲ့ပစ္စည်း သိုလှောင်ရာ ဘဏ္ဍာတိုက်တွေကို ကြီးကြပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />လာဒန်ရဲ့သားမြေးတွေဖြစ်တဲ့ ဂေရရှုန်ကနေ ဆင်းသက်လာတဲ့ သားမြေးတွေထဲမှာ လာဒန်ရဲ့အမျိုး ဆွေမျိုးစုခေါင်းဆောင် ယေဟေလိအပြင်၊
  </para>
  <para style="p">
    <verse number="22" style="v" />သူ့သား ဇေသံနဲ့ ယောလဆိုတဲ့ ညီအစ်ကိုနှစ်ယောက်က ယေဟောဝါရဲ့အိမ်တော် ဘဏ္ဍာတိုက်တွေကို ကြီးကြပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />အာမရံအမျိုး၊ အိဇဟာအမျိုး၊ ဟေဗြုန်အမျိုး၊ သြဇေလအမျိုးထဲမှာ၊
  </para>
  <para style="p">
    <verse number="24" style="v" />မောရှေရဲ့မြေး၊ ဂေရရှုံရဲ့သား ရှေဗွေလဟာ သိုလှောင်ရုံတွေကို ကြီးကြပ်တဲ့ ခေါင်းဆောင်ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />သူ့ညီအစ်ကိုတွေကတော့ ဧလျာဇာကနေ ဆင်းသက်လာသူတွေဖြစ်တဲ့ ရေဟဘိ၊ ယေရှာယ၊ ယောရန်၊ ဇိခရိ၊ ရှေလောမုတ်တို့ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ဒါဝိဒ်မင်းနဲ့ ဆွေမျိုးစုခေါင်းဆောင်တွေ၊ လူတစ်ထောင်အုပ်တွေ၊ လူတစ်ရာအုပ်တွေ၊ ဗိုလ်ချုပ်တွေ ဆက်ကပ်ထားတဲ့ ဘဏ္ဍာတွေကို ရှေလောမုတ်နဲ့ သူ့ညီအစ်ကိုတွေ ကြီးကြပ်ရတယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />တိုက်ပွဲတွေကနေသိမ်းယူခဲ့တဲ့ တိုက်ရာပါဥစ္စာတချို့ကိုတော့ ယေဟောဝါရဲ့ အိမ်တော် ပြုပြင်ထိန်းသိမ်းရာမှာ သုံးဖို့ ဆက်ကပ်ထားတယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />ဒါ့အပြင် ရှေလောမိတ်နဲ့ သူ့ညီအစ်ကိုတွေက အကြားအမြင်ရသူ ရှမွေလ၊ ကိရှရဲ့သား ရှောလု၊ နေရရဲ့သား အာဗနာ၊ ဇေရုယာရဲ့သား ယွာဘတို့ ဆက်ကပ်ထားတဲ့ ပစ္စည်းတွေကိုလည်း ကြီးကြပ်ရတယ်။ လူတွေ ဆက်ကပ်ထားတဲ့ ပစ္စည်းမှန်သမျှကို ထိန်းသိမ်း စောင့်ရှောက်ရတယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />အိဇဟာအမျိုးမှာ ခေနနိနဲ့ သူ့သားတွေက အစ္စရေးပြည်မှာ လက်ထောက်ခေါင်းဆောင်တွေ၊ တရားသူကြီးတွေအဖြစ် ဘုရားသခင့်အိမ်တော်နဲ့ မဆိုင်တဲ့ စီမံခန့်ခွဲရေးတာဝန်တွေကို ထမ်းဆောင်ရတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဟေဗြုန်အမျိုးမှာ ဟာရှဘိနဲ့ လုပ်ရည်ကိုင်ရည်ရှိတဲ့ ဆွေမျိုးသားချင်း ၁,၇၀၀ တို့ဟာ ဂျော်ဒန်မြစ် အနောက်ဘက်ဒေသမှာ အစ္စရေးတွေကို စီမံအုပ်ချုပ်ပြီး မင်းမှုရေးရာတွေကိုရော ယေဟောဝါရဲ့ အမှုတော်တွေကိုပါ ဆောင်ရွက်ရတယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />ဟေဗြုန်ဆွေမျိုးစုကနေ ဆင်းသက်လာသူတွေထဲမှာ ယေရိယက ခေါင်းဆောင်ပဲ။ ဒါဝိဒ်မင်း နန်းစံ အနှစ် ၄၀ မြောက်မှာ ဟေဗြုန်အမျိုးထဲက ခွန်အားကြီးသူ၊ လုပ်ရည်ကိုင်ရည်ရှိသူတွေကို ရှာဖွေကြည့်တော့ ဂိလဒ်ပြည် ယာဇာမြို့မှာ အဲဒီလိုလူတွေကို တွေ့တယ်။
  </para>
  <para style="p">
    <verse number="32" style="v" />ယေရိယရဲ့ ဆွေမျိုးသားချင်း ၂,၇၀၀ တို့ဟာ လုပ်ရည်ကိုင်ရည်ရှိသူတွေ၊ ဆွေမျိုးစုခေါင်းဆောင်တွေ ဖြစ်တယ်။ ဒါကြောင့် ဒါဝိဒ်မင်းက သူတို့ကို ရုဗင်အနွယ်၊ ဂဒ်အနွယ်၊ မနာရှေအနွယ် တစ်ဝက်ကို အုပ်ချုပ်ဖို့ ခန့်အပ်ပြီး မင်းမှုရေးရာကိုရော စစ်မှန်တဲ့ဘုရားသခင်ရဲ့ အမှုတော်တွေကိုပါ ဆောင်ရွက်စေတယ်။
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဘုရင့်တပ်မှာ အမှုထမ်းတဲ့ အစ္စရေးတပ်ဖွဲ့တွေထဲမှာ ဆွေမျိုးစုခေါင်းဆောင်တွေ၊ လူတစ်ထောင်အုပ်တွေ၊ လူတစ်ရာအုပ်တွေ၊ တပ်ဖွဲ့တွေကို ကြီးကြပ်ရတဲ့ ခေါင်းဆောင်တွေ ပါဝင်တယ်။ အဲဒီတပ်ဖွဲ့တွေဟာ တစ်နှစ်မှာ တစ်လစီ အလှည့်ကျ တာဝန်ထမ်းဆောင်ရတယ်။ တစ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />တစ်လပိုင်းမှာ တာဝန်ကျတဲ့ ပထမတပ်ဖွဲ့ကို ဇာဗဒေလရဲ့သား ယာရှောဗံက ကြီးကြပ်ရတယ်။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဖာရက်ရဲ့ သားမြေးတွေထဲမှာ ယာရှောဗံဟာ ပထမလမှာ တာဝန်ထမ်းဆောင်ရတဲ့ တပ်မှူးအားလုံးရဲ့ ခေါင်းဆောင်ပဲ။
  </para>
  <para style="p">
    <verse number="4" style="v" />နှစ်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်ဖွဲ့ကို အဟောဟိအမျိုးသား ဒေါဒဲက ကြီးကြပ်ပြီး မိကလုတ်က ခေါင်းဆောင်ဖြစ်တယ်။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />သုံးလပိုင်းမှာ တာဝန်ထမ်းဆောင်ရတဲ့ တပ်ဖွဲ့ရဲ့ တပ်မှူးက ပုရောဟိတ်မင်း ယောယဒရဲ့သား ဗေနာယ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />ဗေနာယဟာ သူရဲကောင်း ၃၀ ရဲ့ အဖွဲ့ဝင်ဖြစ်ပြီး ခေါင်းဆောင်လည်း ဟုတ်တယ်။ သူ့တပ်ဖွဲ့ကို သူ့သား အမိဇဗဒ်က ကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />လေးလပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက ယွာဘရဲ့ညီ အာသဟေလဖြစ်ပြီး သူ မရှိတဲ့နောက်မှာ သူ့သား ဇေဗဒိက ဆက်တာဝန်ယူတယ်။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ငါးလပိုင်းမှာ တာဝန်ကျတဲ့တပ်မှူးက အိဇရဟိအမျိုးသား ရှံဟုတ်။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />ခြောက်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက တေကောမြို့သား၊ အိကေရှရဲ့သား အိရာ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />ခုနစ်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက ဧဖရိမ်အမျိုးသား ပေလောနိလူ ဟေလက်။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />ရှစ်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက ဇေရမိသားစုဝင် ဟုရှအမျိုးသား သိဗေခဲ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ကိုးလပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက ဗင်ယာမိန်အမျိုးသား အာနသုတ်မြို့သား အဗျေဇာ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဆယ်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက ဇေရမိသားစုဝင် နေတောဖရွာသား မဟာရဲ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />ဆယ့်တစ်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက ဧဖရိမ်အမျိုးသား ပိရသုန်မြို့သား ဗေနာယ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="15" style="v" />ဆယ့်နှစ်လပိုင်းမှာ တာဝန်ကျတဲ့ တပ်မှူးက သြသံယေလမိသားစုဝင် နေတောဖရွာသား ဟေလဒဲ။ သူ့တပ်ဖွဲ့မှာ အင်အား ၂၄,၀၀၀ ရှိတယ်။
  </para>
  <para style="p">
    <verse number="16" style="v" />အစ္စရေးအနွယ်တွေရဲ့ ခေါင်းဆောင်တွေကတော့– ရုဗင်အနွယ်မှာ ဇိခရိရဲ့သား ဧလျာဇာ၊ ရှိမောင်အနွယ်မှာ မာခါရဲ့သား ရှေဖတိ၊
  </para>
  <para style="p">
    <verse number="17" style="v" />လေဝိအနွယ်မှာ ကေမွေလရဲ့သား ဟာရှဘိ၊အာရုန်အမျိုးမှာ ဇာဒုတ်၊
  </para>
  <para style="p">
    <verse number="18" style="v" />ယုဒအနွယ်မှာ ဒါဝိဒ်ရဲ့အစ်ကို ဧလိဟု၊ အိသခါအနွယ်မှာ မိက္ခေလရဲ့သား ဩမရိ၊
  </para>
  <para style="p">
    <verse number="19" style="v" />ဇာဗုလုန်အနွယ်မှာ သြဗဒိရဲ့သား အိရှမာယ၊ နဿလိအနွယ်မှာ အာဇရေလရဲ့သား ယေရိမုတ်၊
  </para>
  <para style="p">
    <verse number="20" style="v" />ဧဖရိမ်အနွယ်မှာ အာဇဇိရဲ့သား ဟောရှာ၊ မနာရှေအနွယ်တစ်ဝက်မှာ ပေဒါယရဲ့သား ယောလ၊
  </para>
  <para style="p">
    <verse number="21" style="v" />ဂိလဒ်ပြည်က မနာရှေအနွယ်တစ်ဝက်မှာ ဇာခရိရဲ့သား အိဒေါ၊ ဗင်ယာမိန်အနွယ်မှာ အာဗနာရဲ့သား ယာသေလ၊
  </para>
  <para style="p">
    <verse number="22" style="v" />ဒန်အနွယ်မှာ ယေရောဟံရဲ့သား အာဇာရေလ။ သူတို့ဟာ အစ္စရေးအနွယ်တွေရဲ့ ခေါင်းဆောင်တွေပဲ။
  </para>
  <para style="p">
    <verse number="23" style="v" />ယေဟောဝါက အစ္စရေးလူမျိုးကို ကောင်းကင်ကြယ်တွေလို များပြားစေမယ်ဆိုပြီး ကတိပေးထားတဲ့အတွက် ဒါဝိဒ်က အသက် ၂၀ မပြည့်သူတွေကို မရေတွက်ဘူး။
  </para>
  <para style="p">
    <verse number="24" style="v" />ဇေရုယာရဲ့သား ယွာဘက လူဦးရေစာရင်း စတင်ကောက်ယူခဲ့ပေမဲ့ အပြီးမသတ်ခဲ့ဘူး။ အဲဒီလို စာရင်းကောက်တဲ့အတွက် အစ္စရေးလူတွေကို ဘုရားသခင် အမျက်ထွက်ခဲ့တယ်။ အဲဒီစာရင်းကို ဒါဝိဒ်မင်းလက်ထက်က ရာဇဝင်မှတ်တမ်းမှာ မထည့်သွင်းဘူး။
  </para>
  <para style="p">
    <verse number="25" style="v" />အဒေလရဲ့သား အာဇမာဝက်က ဘုရင့်ဘဏ္ဍာတွေကို ကြီးကြပ်တယ်။ သြဇိရဲ့သား ယောနသန်က အစွန်အဖျားဒေသတွေ၊ မြို့တွေ၊ ရွာတွေ၊ မျှော်စင်တွေမှာရှိတဲ့ သိုလှောင်ရုံတွေကို ကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ခိလက်ရဲ့သား ဧဇရိက ထွန်ယက်စိုက်ပျိုးသူ လယ်သမားတွေကို ကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />ရာမမြို့သား ရှိမိက စပျစ်ခြံတွေကို ကြီးကြပ်တယ်။ စပျစ်ဝိုင်လုပ်ဖို့အတွက် စပျစ်ခြံကထွက်တာတွေကို ရှိဖမုတ်မြို့သား ဇာဗဒိက ကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />ရှဖိလာအရပ်မှာရှိတဲ့ သံလွင်ခြံတွေနဲ့ သဖန်းပိုးစာပင်တွေကို ဂေဒါမြို့သား ဗာလဟာနန်က ကြီးကြပ်တယ်။ ဆီသိုလှောင်ရုံတွေကို ယောရှကကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ရှာရုန်လွင်ပြင်မှာ ကျက်စားတဲ့ နွားအုပ်တွေကို ရှာရုန်အရပ်သား ရှိတရဲက ကြီးကြပ်တယ်။ ချိုင့်ဝှမ်းလွင်ပြင်တွေမှာ ရှိတဲ့ နွားအုပ်တွေကို အာဒလဲရဲ့သား ရှာဖတ်က ကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ကုလားအုတ်တွေကို အိရှမေလအမျိုးသား သြဗိလက ကြီးကြပ်တယ်။ မြည်းတွေကို မေရောနုတ်အရပ်သား ယေဒေယက ကြီးကြပ်တယ်။
  </para>
  <para style="p">
    <verse number="31" style="v" />သိုးအုပ်တွေကို ဟာဂရိအမျိုးသား ယာဇဇ်က ကြီးကြပ်တယ်။ သူတို့အားလုံးဟာ ဒါဝိဒ်မင်းရဲ့ ဥစ္စာဘဏ္ဍာတွေကို ကြီးကြပ်သူတွေပဲ။
  </para>
  <para style="p">
    <verse number="32" style="v" />ဒါဝိဒ်ရဲ့တူ ယောနသန်က သိနားလည်နိုင်စွမ်းရှိတဲ့ အတိုင်ပင်ခံ၊ စာရေးတော်ဖြစ်တယ်။ ဟခမောနိရဲ့သား ယေဟေလက ဘုရင့်သားတော်တွေကို စောင့်ရှောက်ရတယ်။
  </para>
  <para style="p">
    <verse number="33" style="v" />အဟိသောဖေလက ဘုရင့်အတိုင်ပင်ခံ၊ အာခိလူမျိုး ဟုရှဲက ဘုရင့်မိတ်ဆွေ ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="34" style="v" />အဟိသောဖေလ မရှိတော့တဲ့နောက် ဗေနာယရဲ့သား ယောယဒနဲ့ အဗျာသာက ဘုရင့်အတိုင်ပင်ခံတွေ ဖြစ်လာတယ်။ ယွာဘကတော့ ဘုရင့်တပ်ရဲ့ဗိုလ်ချုပ် ဖြစ်တယ်။
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်က မျိုးနွယ်စုခေါင်းဆောင်တွေ၊ မင်းမှုထမ်းတပ်ဖွဲ့တွေရဲ့ တပ်မှူးတွေ၊ လူတစ်ထောင်အုပ်တွေ၊ လူတစ်ရာအုပ်တွေ၊ ဘုရင်နဲ့ သားတော်တွေရဲ့ ဥစ္စာဘဏ္ဍာနဲ့ တိရစ္ဆာန်တွေကို ကြီးကြပ်ရသူတွေစတဲ့ အစ္စရေးမှူးမတ်တွေအပြင် နန်းတွင်းအရာရှိတွေ၊ ခွန်အားကြီးပြီး လုပ်ရည်ကိုင်ရည်ရှိသူတွေကို ဂျေရုဆလင်မြို့မှာ စုရုံးလိုက်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />အဲဒီနောက် ဒါဝိဒ်မင်းက သူတို့အားလုံးရှေ့မှာ ရပ်ပြီး “ငါ့ညီအစ်ကိုတို့၊ ငါ့လူမျိုးတို့၊ နားထောင်ကြပါ။ ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာကို ထားမယ့်နေရာ၊ ဘုရားသခင်ရဲ့ ခြေတင်ခုံဖြစ်တဲ့ အိမ်တော်ကို တည်ဆောက်ဖို့ ငါဆန္ဒပြင်းပြခဲ့တယ်။ အဲဒီလိုတည်ဆောက်ဖို့ ပြင်ဆင်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />ဒါပေမဲ့ စစ်မှန်တဲ့ဘုရားသခင်က ‘မင်းဟာ လူတွေကိုသတ်ခဲ့တဲ့ စစ်သည်ဖြစ်နေလို့ ငါ့နာမည်အတွက် အိမ်တော်ကို မင်းမဆောက်ရဘူး’ ဆိုပြီး ငါ့ကို မိန့်မှာထားတယ်။
  </para>
  <para style="p">
    <verse number="4" style="v" />အစ္စရေးတို့ရဲ့ဘုရား ယေဟောဝါက ငါ့အဖေရဲ့ အမျိုးတွေထဲကနေ ငါ့ကိုရွေးချယ်ပြီး အစ္စရေးတွေကို ထာဝစဉ်အုပ်ချုပ်ဖို့ မင်းမြှောက်ခဲ့တယ်။ ကိုယ်တော်က ယုဒကို ခေါင်းဆောင်အဖြစ် ရွေးချယ်ခဲ့တယ်။ ယုဒအနွယ်ထဲမှာ ငါ့အဖေရဲ့အမျိုးကို ရွေးချယ်ခဲ့တယ်။ ငါ့အဖေရဲ့သားတွေထဲမှာ ငါ့ကို နှစ်သက်တဲ့အတွက် အစ္စရေးဘုရင်အဖြစ် မင်းမြှောက်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="5" style="v" />ပြီးတော့ ယေဟောဝါဘုရားက ငါ့ကို သားတွေအများကြီး ပေးသနားတယ်။ အဲဒီသားတွေထဲကနေ သားတော် ရှောလမုန်ကို ရွေးချယ်ပြီး အစ္စရေးတွေကို အုပ်ချုပ်ဖို့ ယေဟောဝါရဲ့ ရာဇပလ္လင်ပေါ်မှာ နန်းထိုင်စေခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />“ဘုရားသခင်က ‘မင်းရဲ့သား ရှောလမုန်ဟာ ငါ့အိမ်တော်နဲ့ အိမ်တော်ဝင်းတွေကို တည်ဆောက်မယ့်သူပဲ။ သူ့ကို ငါ့သားအဖြစ် ရွေးချယ်လိုက်ပြီ။ ငါကလည်း သူ့ဖခင်ဖြစ်လာမယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />သူသာ အခုလိုပဲ ငါ့ရဲ့ပညတ်ချက်တွေ၊ တရားစီရင်ချက်တွေကို စွဲစွဲမြဲမြဲ လိုက်နာမယ်ဆိုရင် သူ့ထီးနန်းကို ထာဝစဉ် တည်မြဲစေမယ်’ လို့လည်း ပြောသေးတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ဒါကြောင့် ယေဟောဝါရဲ့ လူမျိုးတော် အစ္စရေးတွေရှေ့မှာ၊ ဘုရားသခင်ရှေ့မှာ ငါပြောမယ်– ယေဟောဝါဘုရားရဲ့ ပညတ်ချက်တွေကို ရှာဖွေလေ့လာပြီး ဂရုတစိုက် လိုက်နာကြပါ။ ဒါဆိုရင် မင်းတို့က သာယာလှပတဲ့ပြည်ကို အပိုင်ရမယ့်အပြင် သားမြေးတွေကိုလည်း တည်မြဲတဲ့အမွေအဖြစ် လက်ဆင့်ကမ်းနိုင်မယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />“ငါ့သား ရှောလမုန်၊ ခမည်းတော်ကိုးကွယ်တဲ့ ဘုရားသခင်ကို သိကျွမ်းအောင် လုပ်ပါ။ ဘုရားကို ရွှင်လန်းတဲ့စိတ်နဲ့ စိတ်နှလုံးအကြွင်းမဲ့ ဝတ်ပြုပါ။ ယေဟောဝါဘုရားက လူအားလုံးရဲ့ စိတ်နှလုံးကို စစ်ဆေးပြီး တွေးတောကြံစည်သမျှကို သိမြင်တယ်။ ဘုရားကို ရှာဖွေမယ်ဆိုရင် အတွေ့ခံမယ်။ ဘုရားကို စွန့်ခွာမယ်ဆိုရင်တော့ ဘုရားကလည်း မင်းကို ထာဝစဉ် ပစ်ပယ်မယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />သန့်ရှင်းရာဌာနတော်အဖြစ် အိမ်တော်ကို တည်ဆောက်ဖို့ မင်းကို ယေဟောဝါဘုရား ရွေးချယ်လိုက်ပြီဆိုတာ မှတ်ထားပါ။ ဒါကြောင့် သတ္တိရှိရှိနဲ့ စလုပ်ဆောင်ပေတော့” လို့မှာတယ်။
  </para>
  <para style="p">
    <verse number="11" style="v" />အဲဒီနောက် ဒါဝိဒ်က သားတော် ရှောလမုန်ကို မုခ်ဦးနဲ့ အခန်းတွေ၊ သိုလှောင်ခန်းတွေ၊ အိမ်မိုးအထက်ခန်းတွေ၊ အတွင်းခန်းတွေအပြင် ပဋိညာဉ်သေတ္တာအဖုံး နဲ့ပတ်သက်တဲ့ ဗိသုကာပုံစံကို ပေးတယ်။
  </para>
  <para style="p">
    <verse number="12" style="v" />ယေဟောဝါရဲ့ အိမ်တော်တံတိုင်းတွေ၊ ပတ်လည် စားသောက်ခန်းတွေ၊ ဘုရားသခင့်အိမ်တော် ဘဏ္ဍာတိုက်တွေ၊ ဆက်ကပ်ပစ္စည်းတွေထားရာ ဘဏ္ဍာတိုက်တွေနဲ့ပတ်သက်ပြီး စွမ်းအားတော်ကတစ်ဆင့် ရတဲ့ ဗိသုကာပုံစံကိုလည်း ပေးတယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ဒါ့အပြင် ပုရောဟိတ်အုပ်စုတွေ၊ လေဝိအမျိုးသားအုပ်စုတွေ၊ ယေဟောဝါရဲ့အိမ်တော် လုပ်ငန်းတာဝန်တွေ၊ ယေဟောဝါရဲ့ အိမ်တော်လုပ်ငန်းမှာသုံးမယ့် ပစ္စည်းတွေနဲ့ပတ်သက်တဲ့ ညွှန်ကြားချက်တွေကိုလည်း ပေးတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />လုပ်ငန်းအမျိုးမျိုးမှာ သုံးမယ့် ရွှေထည်တွေအတွက် ရွှေအလေးချိန်၊ လုပ်ငန်းအမျိုးမျိုးမှာ သုံးမယ့် ငွေထည်တွေအတွက် ငွေအလေးချိန်၊
  </para>
  <para style="p">
    <verse number="15" style="v" />ရွှေဆီမီးတိုင်တွေနဲ့ မီးခွက် အမျိုးမျိုးအတွက် ရွှေအလေးချိန်၊ ငွေဆီမီးတိုင်တွေနဲ့ မီးခွက် အမျိုးမျိုးအတွက် ငွေအလေးချိန်၊
  </para>
  <para style="p">
    <verse number="16" style="v" />အဆင့်ဆင့်တင်ထားတဲ့မုန့် ထားမယ့် စားပွဲတစ်ခုစီအတွက် ရွှေအလေးချိန်၊ ငွေစားပွဲတွေအတွက် ငွေအလေးချိန်၊
  </para>
  <para style="p">
    <verse number="17" style="v" />ရွှေစင်နဲ့လုပ်တဲ့ ခက်ရင်းခွတွေ၊ ဇလုံတွေ၊ ရေတကောင်းတွေ၊ ရွှေဖလားငယ်တစ်ခုစီအတွက် ရွှေအလေးချိန်၊ ငွေဖလားငယ်တစ်ခုစီအတွက် ငွေအလေးချိန်တို့ကို သတ်မှတ်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />နံ့သာပေါင်းပလ္လင်အတွက် ရွှေစင်အလေးချိန်၊ ရထားတော်နဲ့ တင်စားတဲ့ တစ်နည်းအားဖြင့် ယေဟောဝါရဲ့ ပဋိညာဉ်သေတ္တာကို အတောင်ဖြန့်မိုးထားတဲ့ ရွှေခေရုဗိမ်ရုပ်တွေအတွက် ရွှေစင်အလေးချိန်ကိုလည်း သတ်မှတ်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="19" style="v" />ဒါဝိဒ်က “ငါ့အပေါ်မှာ ယေဟောဝါဘုရားရဲ့ လက်တော် သက်ရောက်တယ်။ ဒီဗိသုကာပုံစံမှာပါတဲ့ အသေးစိတ်အချက်အလက်တွေကို ရေးသားနိုင်ဖို့ ငါ့ကို ဘုရားက ထိုးထွင်းဉာဏ်ပေးတယ်” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="20" style="v" />ပြီးတော့ ဒါဝိဒ်က သားတော်ရှောလမုန်ကို “ရဲစွမ်းသတ္တိရှိရှိနဲ့ လုပ်ငန်းစပေတော့။ ငါကိုးကွယ်တဲ့ဘုရား ယေဟောဝါက မင်းနဲ့အတူ ရှိတဲ့အတွက် မကြောက်နဲ့။ ဘုရားသခင်က မင်းကို ပစ်ထားမှာ မဟုတ်ဘူး။ စွန့်ခွာမှာ မဟုတ်ဘူး။ ယေဟောဝါရဲ့ အိမ်တော်လုပ်ငန်းအားလုံး ပြီးစီးသွားတဲ့အထိ မင်းကို ကူညီမယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />အခု ဘုရားသခင့်အိမ်တော် လုပ်ငန်းတွေအတွက် ပုရောဟိတ်အုပ်စုတွေနဲ့ လေဝိအမျိုးသားအုပ်စုတွေ ရှိတယ်။ အလုပ်အမျိုးမျိုး လုပ်ဆောင်နိုင်ပြီး စေတနာစိတ်ရှိတဲ့ အတတ်ပညာရှင်တွေ မင်းဆီမှာရှိတယ်။ မှူးမတ်တွေနဲ့ လူအားလုံးကလည်း မင်းညွှန်ကြားတဲ့အတိုင်း လုပ်ဆောင်ကြလိမ့်မယ်” လို့မှာကြားတယ်။
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />ဒါဝိဒ်မင်းက အစ္စရေးလူထုကြီးကို “ဘုရားသခင်ရွေးချယ်တဲ့ ငါ့သားရှောလမုန်ဟာ ငယ်သေးတယ်။ အတွေ့အကြုံလည်း မရှိဘူး။ ဒါပေမဲ့ လုပ်ရမယ့်လုပ်ငန်းက ကြီးမားလွန်းတယ်။ အခုဆောက်ရမယ့် ဗိမာန်တော်ဟာ လူအတွက်မဟုတ်ဘဲ ယေဟောဝါဘုရားအတွက် ဖြစ်တယ်။
  </para>
  <para style="p">
    <verse number="2" style="v" />ဒါကြောင့် ငါကိုးကွယ်တဲ့ဘုရားရဲ့ အိမ်တော်အတွက် ငါအစွမ်းကုန်ပြင်ဆင်ခဲ့တယ်။ ရွှေထည်တွေအတွက် ရွှေ၊ ငွေထည်တွေအတွက် ငွေ၊ ကြေးထည်တွေအတွက် ကြေးနီ၊ သံထည်တွေအတွက် သံ၊ သစ်သားထည်တွေအတွက် သစ်သား၊ မဟူရာကြောင်ဝင်ကျောက်တွေ၊ အင်္ဂတေကိုင်ဖို့ ကျောက်တုံးတွေ၊ ရောင်စုံကျောက်စရစ်ခဲတွေ၊ ကျောက်မျက်အမျိုးမျိုးနဲ့ ကျောက်ဖြူအမြောက်အမြားကို စုဆောင်းခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="3" style="v" />သန့်ရှင်းရာ အိမ်တော်အတွက် ငါပြင်ဆင်ခဲ့တာအားလုံးအပြင် ငါ့ပိုင်ဆိုင်ရာထဲက ရွှေငွေတွေကိုလည်း အိမ်တော်အတွက် ငါပေးလှူတယ်။ ဘုရားသခင်ရဲ့ အိမ်တော်ကို သိပ်မြတ်နိုးလို့ပါ။
  </para>
  <para style="p">
    <verse number="4" style="v" />ဗိမာန်တော်နံရံတွေကို မွမ်းမံဖို့ သြဖိရရွှေ တဲလင့် ၃,၀၀၀၊ ငွေစင်တဲလင့် ၇,၀၀၀၊
  </para>
  <para style="p">
    <verse number="5" style="v" />ရွှေထည်တွေအတွက် ရွှေ၊ ငွေထည်တွေအတွက် ငွေ၊ လက်မှုပညာသည်တွေလုပ်ဖို့ လိုအပ်သမျှကိုလည်း ငါပေးလှူတယ်။ အခု ယေဟောဝါဘုရားအတွက် စေတနာစိတ်နဲ့ ပေးလှူချင်တဲ့သူ ဘယ်သူရှိသလဲ” လို့ပြောတယ်။
  </para>
  <para style="p">
    <verse number="6" style="v" />အဲဒီအခါ ဆွေမျိုးစု ခေါင်းဆောင်တွေ၊ အစ္စရေးအနွယ် ခေါင်းဆောင်တွေ၊ လူတစ်ထောင်အုပ်တွေ၊ လူတစ်ရာအုပ်တွေနဲ့ ဘုရင့်အမှုကို ကြီးကြပ်သူတွေက စေတနာစိတ်နဲ့ ပေးလှူကြတယ်။
  </para>
  <para style="p">
    <verse number="7" style="v" />စစ်မှန်တဲ့ဘုရားသခင်ရဲ့ အိမ်တော်လုပ်ငန်းအတွက် ရွှေတဲလင့် ၅,၀၀၀၊ ဒဲရစ် ၁၀,၀၀၀၊ ငွေတဲလင့် ၁၀,၀၀၀၊ ကြေးနီတဲလင့် ၁၈,၀၀၀၊ သံတဲလင့် ၁၀၀,၀၀၀ ပေးလှူကြတယ်။
  </para>
  <para style="p">
    <verse number="8" style="v" />ကျောက်မျက်ရတနာရှိသူတွေကလည်း ဂေရရှုန်အမျိုးသား ယေဟေလ ကြီးကြပ်မှုအောက်မှာရှိတဲ့ ယေဟောဝါရဲ့အိမ်တော် ဘဏ္ဍာတိုက်ဆီ ပေးလှူကြတယ်။
  </para>
  <para style="p">
    <verse number="9" style="v" />စေတနာအလျောက် အဲဒီလိုလှူဒါန်းရတာကို လူတွေ ဝမ်းသာပီတိ ဖြစ်ကြတယ်။ ယေဟောဝါအတွက် စိတ်နှလုံးအကြွင်းမဲ့ စေတနာရှိရှိ ပေးလှူကြလို့ပဲ။ ဒါဝိဒ်မင်းလည်း သိပ်ကို ဝမ်းသာကြည်နူးသွားတယ်။
  </para>
  <para style="p">
    <verse number="10" style="v" />အဲဒီနောက် ဒါဝိဒ်က လူထုကြီးရှေ့မှာ ယေဟောဝါကို ချီးမွမ်းတယ်။ “ကျွန်တော်တို့ရဲ့ဘိုးဘေး အစ္စရေး ကိုးကွယ်တဲ့ ဘုရားသခင် ယေဟောဝါ၊ ကိုယ်တော့်ကို အစဉ်ထာဝရ ချီးမွမ်းကြပါစေ။
  </para>
  <para style="p">
    <verse number="11" style="v" />ယေဟောဝါဘုရား၊ ကိုယ်တော်ဟာ ကြီးမြတ်မှု၊ တင့်တယ်မှု၊ ခမ်းနားမှု၊ အစွမ်းသတ္တိ၊ ဘုန်းတန်ခိုးနဲ့ ပြည့်စုံပါတယ်။ ယေဟောဝါဘုရား၊ ကောင်းကင်နဲ့ မြေကြီးပေါ် ရှိသမျှကို ပိုင်တယ်။ မင်းအာဏာတော်ကိုလည်း ပိုင်တယ်။ ကိုယ်တော်ဟာ အရာခပ်သိမ်းရဲ့အထွတ်အဖြစ် ကိုယ့်ကိုယ်ကိုယ် ချီးမြှောက်တဲ့အရှင်ပါပဲ။
  </para>
  <para style="p">
    <verse number="12" style="v" />စည်းစိမ်ဥစ္စာနဲ့ ဂုဏ်ကျက်သရေဟာ ကိုယ်တော်ပေးသနားတဲ့ အရာတွေပါ။ အရာခပ်သိမ်းကို ကိုယ်တော် အုပ်စိုးတယ်။ လက်တော်ဟာ တန်ခိုး၊ အစွမ်းသတ္တိနဲ့ ပြည့်စုံပြီး လူတွေကို ကြီးမြတ်စေနိုင်သလို ခွန်အားလည်း ပေးနိုင်တယ်။
  </para>
  <para style="p">
    <verse number="13" style="v" />ကျွန်တော်တို့ရဲ့ ဘုရားသခင်၊ ကျေးဇူးတင်ပါတယ်။ တင့်တယ်လှတဲ့ နာမတော်ကို ချီးမွမ်းပါတယ်။
  </para>
  <para style="p">
    <verse number="14" style="v" />“တကယ်တော့ ကျွန်တော်နဲ့ ကျွန်တော့်လူတွေဟာ စေတနာအလျောက်ပေးတဲ့ အလှူတွေကို ဒီလောက်အထိ လှူနိုင်စွမ်း မရှိပါဘူး။ အရာခပ်သိမ်းကို ကိုယ်တော့်ဆီက ရထားတာပါ။ ကိုယ်တော် ပေးသနားထားတာတွေကိုပဲ ပြန်ပြီး ပေးလှူနေကြတာပါ။
  </para>
  <para style="p">
    <verse number="15" style="v" />ကျွန်တော်တို့ဟာ ဘိုးဘေးတွေလိုပဲ ရှေ့တော်မှာ တိုင်းတစ်ပါးသားတွေ၊ လာရောက်အခြေချသူတွေ ဖြစ်ပါတယ်။ ကမ္ဘာမြေပေါ်မှာ အသက်ရှင်ရတဲ့နေ့ရက်တွေဟာ အရိပ်လိုပါပဲ။ မျှော်လင့်ချက် မရှိပါဘူး။
  </para>
  <para style="p">
    <verse number="16" style="v" />ယေဟောဝါဘုရား၊ ကိုယ်တော့်အတွက်၊ သန့်ရှင်းမြင့်မြတ်တဲ့ နာမတော်အတွက် အိမ်တော်တည်ဆောက်ဖို့ ကျွန်တော်တို့ ပြင်ဆင်ထားတဲ့ ဒီပစ္စည်းဥစ္စာအားလုံးဟာ ကိုယ်တော် ပေးသနားထားတာတွေ၊ ကိုယ်တော် ပိုင်ဆိုင်တာတွေပါပဲ။
  </para>
  <para style="p">
    <verse number="17" style="v" />ဘုရားသခင်၊ ကိုယ်တော်ဟာ စိတ်နှလုံးကို စစ်ဆေးပြီး သမာဓိရှိသူကို နှစ်သက်မှန်း ကျွန်တော် ကောင်းကောင်း သိပါတယ်။ ဒီပစ္စည်းဥစ္စာအားလုံးကို ရိုးဖြောင့်တဲ့စိတ်နဲ့၊ စေတနာအပြည့်နဲ့ လှူဒါန်းပါတယ်။ ဒီမှာရှိနေတဲ့ ကိုယ်တော့်လူတွေ စေတနာအပြည့်နဲ့ ပေးလှူနေတာကို မြင်ရတဲ့အတွက် ကျွန်တော် သိပ်ဝမ်းသာပါတယ်။
  </para>
  <para style="p">
    <verse number="18" style="v" />ဘိုးဘေး အာဗြဟံ၊ အိဇက်၊ အစ္စရေးတို့ရဲ့ ဘုရားသခင် ယေဟောဝါ၊ လူမျိုးတော်ရဲ့ နှလုံးသားထဲမှာ ဒီလိုစိတ်ဆန္ဒတွေ၊ သဘောထားတွေ အမြဲရှိနိုင်ဖို့၊ ကိုယ်တော့်ကို စိတ်နှလုံးအကြွင်းမဲ့ ဝတ်ပြုနိုင်ဖို့ သူတို့ကို ကူညီပေးပါ။
  </para>
  <para style="p">
    <verse number="19" style="v" />ပညတ်ချက်တွေ၊ သတိပေးချက်တွေနဲ့ စည်းမျဉ်းတွေကို စိတ်နှလုံးအကြွင်းမဲ့ လိုက်နာနိုင်ဖို့ သားတော် ရှောလမုန်ကို ကူညီပေးပါ။ ဒါတွေအားလုံးကို သူလုပ်ဆောင်နိုင်ဖို့၊ ကျွန်တော် ပြင်ဆင်ပေးထားတဲ့အတိုင်း ဗိမာန်တော်ကို တည်ဆောက်နိုင်ဖို့လည်း ကူညီပေးပါ။”
  </para>
  <para style="p">
    <verse number="20" style="v" />အဲဒီနောက် “ယေဟောဝါဘုရားကို ချီးမွမ်းကြ” လို့ ဒါဝိဒ် ပြောလိုက်တဲ့အခါ လူထုကြီးက ဘိုးဘေးတို့ရဲ့ဘုရား ယေဟောဝါကို ချီးမွမ်းပြီး ယေဟောဝါနဲ့ ဘုရင်ကို ဦးညွှတ်ပျပ်ဝပ်ကြတယ်။
  </para>
  <para style="p">
    <verse number="21" style="v" />နောက်တစ်နေ့မှာ ယေဟောဝါအတွက် ပူဇော်သက္ကာတွေ၊ ယေဟောဝါအတွက် မီးရှို့ရာအလှူတွေအဖြစ် နွားထီးပျို ၁,၀၀၀၊ သိုးထီး ၁,၀၀၀၊ သိုးသငယ်အထီး ၁,၀၀၀ နဲ့ သွန်းလောင်းရာ အလှူတွေကို ဆက်ပြီးပူဇော်ကြတယ်။ အစ္စရေးတစ်မျိုးလုံးအတွက် ပူဇော်သက္ကာတွေ အများကြီး ပူဇော်ကြတယ်။
  </para>
  <para style="p">
    <verse number="22" style="v" />အဲဒီနေ့မှာ ယေဟောဝါရှေ့ သူတို့စားသောက်ပြီး အကြီးအကျယ် ရွှင်လန်းကြတယ်။ ပြီးတော့ ဒါဝိဒ်ရဲ့သား ရှောလမုန်ကို ဘုရင်အဖြစ် ဒုတိယအကြိမ် ကြေညာပြီး ယေဟောဝါရှေ့မှာ ခေါင်းဆောင်အဖြစ် ဘိသိက်ပေးတယ်။ ဇာဒုတ်ကိုလည်း ပုရောဟိတ်အဖြစ် ဘိသိက်ပေးတယ်။
  </para>
  <para style="p">
    <verse number="23" style="v" />ရှောလမုန်လည်း ခမည်းတော်ဒါဝိဒ်ရဲ့ ထီးနန်းကို ဆက်ခံပြီး ယေဟောဝါရဲ့ ရာဇပလ္လင်ပေါ်မှာ ထိုင်တယ်။ သူဟာ အောင်မြင်တဲ့ ဘုရင်တစ်ပါးဖြစ်ပြီး အစ္စရေးအားလုံး သူ့ကို နာခံကြတယ်။
  </para>
  <para style="p">
    <verse number="24" style="v" />မှူးမတ်တွေ၊ သူရဲကောင်းတွေ၊ ဒါဝိဒ်မင်းရဲ့ သားတော်တွေလည်း ရှောလမုန်မင်းကို လက်အောက်ခံကြတယ်။
  </para>
  <para style="p">
    <verse number="25" style="v" />ယေဟောဝါက ရှောလမုန်ကို အစ္စရေးအားလုံးရှေ့မှာ အတိုင်းထက်အလွန် ကြီးမြတ်စေတယ်။ အရင်က အစ္စရေးဘုရင်တစ်ပါးမှ မရဖူးတဲ့ ဘုန်းအသရေကိုလည်း ပေးသနားတယ်။
  </para>
  <para style="p">
    <verse number="26" style="v" />ယေရှဲရဲ့သား ဒါဝိဒ်က အစ္စရေးတစ်နိုင်ငံလုံးကို အုပ်ချုပ်ခဲ့တယ်။
  </para>
  <para style="p">
    <verse number="27" style="v" />အစ္စရေးတွေကို နှစ်ပေါင်း ၄၀ အုပ်ချုပ်တယ်။ ဟေဗြုန်မြို့မှာ ၇ နှစ်၊ ဂျေရုဆလင်မြို့မှာ ၃၃ နှစ် အုပ်ချုပ်တယ်။
  </para>
  <para style="p">
    <verse number="28" style="v" />နောက်ဆုံးတော့ သူဟာ စည်းစိမ်ချမ်းသာ၊ ဂုဏ်ကျက်သရေ၊ ကျေနပ်စရာကောင်းတဲ့ဘဝနဲ့ အသက်ရှည်ရှည် နေပြီးတဲ့နောက် သေဆုံးသွားတယ်။ သားတော်ရှောလမုန်က ထီးနန်းဆက်ခံတယ်။
  </para>
  <para style="p">
    <verse number="29" style="v" />ဒါဝိဒ်မင်းရဲ့ရာဇဝင် အစအဆုံးကို အကြားအမြင်ရသူ ရှမွေလ၊ ပရောဖက် နာသန်၊ စိတ်အာရုံမြင်ရသူ ဂဒ်တို့ရဲ့ ကျမ်းစောင်မှာ ရေးသားထားတယ်။
  </para>
  <para style="p">
    <verse number="30" style="v" />ဒါဝိဒ်မင်း နန်းစံချိန်မှာ ဖြစ်ပျက်ခဲ့တာတွေ၊ စွမ်းဆောင်ချက်တွေ၊ အစ္စရေးပြည်နဲ့ ပတ်ဝန်းကျင်တိုင်းပြည်တွေမှာ ဖြစ်ပျက်ခဲ့တာတွေကိုလည်း ရေးသားထားတယ်။
  </para>
</usx>
