<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Nambar</book>
  <para style="h">Nambar</para>
  <para style="toc1">Nambar</para>
  <para style="toc2">Nambar</para>
  <para style="mt">Nambar</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu Sinai ramlak ah, tonnak thlam chungah cun, Izipt ram in an chuah hnu kum hnihnak kum thla hnihnak thla ni khatnak ni ah cun, a chawnh i hitin a ti:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mibu vialte hna cu an milu rel tuah hna, a chungchung in, a phunphun in, an min zat ningin, pa paohpaoh, pakhat hnu pakhat;
  </para>
  <para style="p">
    <verse number="3" style="v" />kum kul ri in a cunglei, Israel mi chung i phawnam tlai kho vialte, a phu a phu in Aaron le nangmah nih nan rel hna lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun nan sinah phun khat chungin mi pakhat cio an um lai i cu hna cu an chung lak i a lu cio an si lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mah hna hi nanmah an umpitu hna ding an min cu a si. Reuben phun chungin, Shedeur fapa Elizur;
  </para>
  <para style="p">
    <verse number="6" style="v" />Simeon phun chungin, Zurishaddai fapa Shelumiel;
  </para>
  <para style="p">
    <verse number="7" style="v" />Judah phun chungin Amminadab fapa Nahshon;
  </para>
  <para style="p">
    <verse number="8" style="v" />Issakhar phun chungin, Zuar fapa Nethanel;
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulun phun chungin, Helon fapa Eliab;
  </para>
  <para style="p">
    <verse number="10" style="v" />Josef fapa hna chungin, Efraim chungin Ammihud fapa Elishama, cun Manasseh chungin Pedahzur fapa Gamaliel;
  </para>
  <para style="p">
    <verse number="11" style="v" />Benjamin phun chungin Gideoni fapa Abidan;
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan phun chungin, Ammishaddai fapa Ahiezer:
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher phun chungin Okhran fapa Pagiel;
  </para>
  <para style="p">
    <verse number="14" style="v" />Gad phun chungin, Deuel fapa Eliasaf;
  </para>
  <para style="p">
    <verse number="15" style="v" />Naftali phun chungin Enan fapa Ahira.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Mah hna hi mibu chungin thimmi, an thawhkehnak phun hruaitu hna. Israel mi chung i miphun hna an lu cu an si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Moses le Aaron nih minthlak a simi hna hi an lak hna i
  </para>
  <para style="p">
    <verse number="18" style="v" />Bawipa nih Moses cu nawl a pek bangin, thla hnihnak thla ni khatnak ni ah cun, a chungchung in, a phunphun in, kum kul ri in a cunglei an min zat ningin, pakhat hnu pakhat in, min aa thlami hna cu, Israel mibu cu a ning piin an pumh hna.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cu bangin Sinai ramlak ah a rel hna.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel fapa upa bik Reuben mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, pakhat hnu pakhat in, kum kul ri in a cunglei pa paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben phun mi cu sang li le thong ruk le za nga an si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simeon mi hna cu, an tefa hna, an chungchung in, an phunphun in, min thlakmi hna cu, an min zat ningin, pakhat hnu pakhat in, kum kul ri in a cunglei pa paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="23" style="v" />Simeon phun mi cu sang nga thong kua le za thum an si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gad mi hna cu, an tefa hna, an chungchung in an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="25" style="v" />Gad phun mi cu sang li, thong nga, za ruk le sawm nga an si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="27" style="v" />Judah phun mi cu sang sarih, thong li le za ruk an si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Issakhar mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="29" style="v" />Issakhar phun mi cu sang nga, thong li le za li an si.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ning in, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="31" style="v" />Zebulun phun mi cu sang nga, thong sarih le za li an si.
  </para>
  <para style="p">
    <verse number="32" style="v" />Josef mi hna chungin Efraim mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="33" style="v" />Efraim phun mi cu sang li le za nga an si.
  </para>
  <para style="p">
    <verse number="34" style="v" />Manasseh mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="35" style="v" />Manasseh phun mi cu sang thum, thong hnih le za hnih an si.
  </para>
  <para style="p">
    <verse number="36" style="v" />Benjamin mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="37" style="v" />Benjamin phun mi cu sang thum, thong nga le za li an si.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dan mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ning in, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="39" style="v" />Dan phun mi cu sang ruk, thong hnih le za sarih an si.
  </para>
  <para style="p">
    <verse number="40" style="v" />Asher mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="41" style="v" />Asher phun mi cu sang li, thong khat le za nga an si.
  </para>
  <para style="p">
    <verse number="42" style="v" />Naftali mi hna cu, an tefa hna, an chungchung in, an phunphun in, an min zat ningin, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte:
  </para>
  <para style="p">
    <verse number="43" style="v" />Naftali phun mi cu sang nga, thong thum le za li an si.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mah hna hi relmi cu an si, Moses le Aaron nih Israel mi hruitu hleihnih, anmah le an phun cio airawl hna he i bawmh in an relmi hna cu.
  </para>
  <para style="p">
    <verse number="45" style="v" />Cucaah Israel mi cu an ning piin, an phunphun in, kum kul ri in a cunglei paohpaoh, phawnam tlai kho vialte: —
  </para>
  <para style="p">
    <verse number="46" style="v" />an ning piin sing ruk, thong thum, za nga le sawm nga an si.
  </para>
  <para style="p">
    <verse number="47" style="v" />Sihmanhsehlaw Levi mi hna cu an chuahkehnak phun in annih sinah relchih an si lo.
  </para>
  <para style="p">
    <verse number="48" style="v" />Zeicahtiah, Bawipa nih Moses sinah,
  </para>
  <para style="p">
    <verse number="49" style="v" />“Levi phun lawnglawng hi na rel hna lai lo i annih cu Israel mi hna lakah min relnak na tuah hna lai lo;
  </para>
  <para style="p">
    <verse number="50" style="v" />sihmanhsehlaw Levi mi cu hngalhternak puan biakinn le a thilthuam vialte le a chung i a ummi thil vialte zohkhenhtu ah na chiah hna lai; annih nih puan biakinn le a thilthuam vialte an put awk le an zohkhenh awk a si lai i puan biakinn velchum ah cun riah hmun an khuar lai.
  </para>
  <para style="p">
    <verse number="51" style="v" />Puan biakinn cu kalpi awk a si tikah Levi mi nih an ṭheh lai i puan biakinn cu bunh awk a si tikah Levi mi nih an bunh lai; midang ahohmanh nih a ra naih ahcun, amah cu thah a si lai.
  </para>
  <para style="p">
    <verse number="52" style="v" />Israel mi hna nih an thlam cu an bu ning cio ah an bunh hna lai, mi kip nih mah le bu cio ah, cun mah le hmelchunhnak cio ah;
  </para>
  <para style="p">
    <verse number="53" style="v" />sihmanhsehlaw Levi mi hna cu hngalhternak puan biakinn velchum ah riahhmun an khuar lai, Israel mi an bu cungah thinhunnak a um nakhnga lo; cun Levi mi nih hngalhternak puan biakinn cu an zohkhenh lai,” a ti.
  </para>
  <para style="p">
    <verse number="54" style="v" />Cu bangin Israel mi nih an tuah; Bawipa nih Moses nawl a pekmi dihlak bang khan an tuah.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses le Aaron cu a chawnh hna i hi bangin a ti.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi hna cu anmah le an alan pawng cio ah, an pupa hmelchunhnak i tar in an um awk a si lai; tonnak thlam cu a zeilei kap paoh in hoih cio ah riahhmun cu an khuar lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nichuahlei, ni a hung chuahnak lei kam i a um hngami hna cu Judah riahhmun alan a si lai, an bubu in, Judah mi a hruitu hna cu Amminadab fapa Nahshon a si,
  </para>
  <para style="p">
    <verse number="4" style="v" />amah bu cu an relning ah sang sarih, thong li, za ruk a si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah chang ah riahhmun a khuar hnga ding cu Issakhar phun an si lai, Issakhar mi a hruitu hna cu Zuar fapa Nethanel a si,
  </para>
  <para style="p">
    <verse number="6" style="v" />amah bu cu an rel ning ah sang nga, thong li, le za li a si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cu hnuah Zebulun phun an si lai, Zebulun mi a hruitu hna cu Helon fapa Eliab a si,
  </para>
  <para style="p">
    <verse number="8" style="v" />amah bu cu an relning ah sang nga, thong sarih le za li a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah riahhmun cu a ning piin, an bubu in, sing khat, sang riat, thong ruk le za li a si. Kal tikah anmah hi a pok hmasa bik an si lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Thlanglei kam i a um hnga ding cu Reuben riahhmun alan a si lai, an bubu in, Reuben mi a hruitu hna cu Shedeur fapa Elizur a si,
  </para>
  <para style="p">
    <verse number="11" style="v" />amah bu cu an relning ah sang li, thong ruk le za nga a si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun amah a hun chang ah riahhmun a khuar hnga ding cu Simeon phun an si lai, Simeon mi a hruitu hna cu Zurishaddai fapa Shelumiel a si,
  </para>
  <para style="p">
    <verse number="13" style="v" />amah bu cu an relning ah sang nga, thong kua le za thum a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cu hnuah Gad phun a si lai, Gad mi a hruitu hna cu Reuel fapa Eliasaf a si;
  </para>
  <para style="p">
    <verse number="15" style="v" />amah bu cu an relning ah sang li, thong nga, za ruk le sawm nga a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Reuben riahhmun cu a ning piin, an bubu in, sing khat, sang nga, thong khat, za li le sawm nga a si. Anmah hi a pokmi a pahnihnak an si lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Cun tonnak thlam cu a pok lai, riahhmun hna laifang i Levi mi hna riahhmun he cun; riahhmun an khuar ning te khan an pok lai, anmah le an umnak ning ciote khan, alan pakhat hnu pakhat in.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Nitlaklei kam i a um hnga ding cu Efraim riahhmun alan a si lai, an bubu in, Efraim mi a hruitu hna cu Ammihud fapa Elishama a si,
  </para>
  <para style="p">
    <verse number="19" style="v" />amah bu cu an rel ning ah sang li le za nga a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun amah chang ah cun Manasseh phun an si lai, Manasseh mi a hruitu hna cu Pedahzur fapa Gamaliel a si,
  </para>
  <para style="p">
    <verse number="21" style="v" />amah bu cu an relning ah sang thum, thong hnih le za hnih a si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun Benjamin phun an si lai, Benjamin mi a hruitu hna cu Gideoni fapa Abidan a si,
  </para>
  <para style="p">
    <verse number="23" style="v" />amah bu cu an relning ah sang thum, thong nga le za li a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Efraim riah hmun cu a ning piin, an bubu in, sing khat, thong riat le za khat a si. Anmah hi kal tikah a pokmi a pathumnak an si lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Chaklei kamah Dan riahhmun alan, an bubu in, a si lai, Dan mi a hruitu hna cu Ammishaddai fapa Ahiezer a si,
  </para>
  <para style="p">
    <verse number="26" style="v" />amah bu cu an relning ah sang ruk, thong hnih le za sarih a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun amah chang ah riahhmun a khuar hnga ding cu Asher phun an si lai, Asher mi a hruitu hna cu Okhran fapa Pagiel a si,
  </para>
  <para style="p">
    <verse number="28" style="v" />amah bu cu an relning ah sang li, thong khat le za nga a si.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cun Naftali phun an si lai, Naftali mi a hruitu hna cu Enan fapa Ahira a si,
  </para>
  <para style="p">
    <verse number="30" style="v" />amah bu cu an relning ah sang nga, thong thum le za li a si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dan riahhmun cu a ning piin sing khat, sang nga, thong sarih le za ruk a si. Anmah hi a pokmi a hmanung bik an si lai; alan pakhat hnu pakhat in.”
  </para>
  <para style="p">
    <verse number="32" style="v" />Mah hihi Israel mi hna cu an phun cio ah rel tikah an si; riahhmun hna ah a ummi vialte an bu cio ah relmi cu sing ruk le thong thum, za nga le sawm nga an si.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sihmanhsehlaw Bawipa nih Moses nawl a pek bangin Levi mi hna cu Israel mi lakah rel an si lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cu bangin Israel mi nih an tuah. Bawipa nih Moses nawl a pekmi vialte bantukin, cu bangin an bu cio ah riahhmun an khuar, cun cu bangin an pok, anmah le an chungkhar cio ah, anmah le an phun ning cio ah.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Sinai Tlang ah Moses kha a chawnh tikah, mah hna hi Aaron le Moses tefa cu an si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mah hna hi Aaron fapa hna min cu an si: a upa bik ah Nadab, cun Abihu le Eleazar, cun Ithamar;
  </para>
  <para style="p">
    <verse number="3" style="v" />mah hihi Aaron fapa hna min cu an si, chiti thuhmi tlangbawi, tlangbawi rian ṭuan awkah a thleidanmi hna cu.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sihmanhsehlaw Nadab le Abihu cu, Sinai ram lakah Bawipa hmaiah a thiang lomi mei an pekchanh tikah khan an thi, fa an ngei lo. Cu caah Eleazar le Ithamar nih an pa Aaron a nun lio khan tlangbawi rian cu an ṭuan.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Levi phun cu nai ah ratpi hna law, tlangbawi Aaron hmaiah chia hna, amah cu bultawl hna seh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puan biaknak inn ah rian an ṭuanpah in amah ca le aa pummi dihlak caah tonnak thlam hmaiah rian an ṭuan lai;
  </para>
  <para style="p">
    <verse number="8" style="v" />tonnak thlam thil thuam vialte cu an zohkhenh lai i puan biakinn ah rian an ṭuanpah in Israel mi caah rian an ṭuan lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Levi mi hna cu Aaron le a fapa hna kha na pek hna lai; annih cu Israel mi chung in amah sinah an ning piin pekmi an si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Aaron le a fapa hna cu rian na pek hna lai i an tlangbawi rian cu an ṭuan lai; sihmanhsehlaw midang ahohmanh nih a ra naih ahcun, amah cu thah a si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Zohhmanh, Levi mi hna cu Israel mi hna lak in Israel mi hna lak i fater, nu paw chungchuak hmasa bik hna, can-ai ah ka lak cang hna. Levi mi cu keimah ta an si lai,
  </para>
  <para style="p">
    <verse number="13" style="v" />zeitintiah fater vialte cu keimah ta an si; Izipt ram chung i fater vialte ka thah hna ni ah khan Israel mi hna lak i fater vialte cu, minung siseh, saram siseh, keimah ca hrimhrim ah ka thianter hna; annih cu keimah ta an si lai: keimah cu Bawipa ka si,” tiah a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun Bawipa nih Moses cu Sinai ramlak ah a chawnh i,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Levi fapa cu rel tuah hna, an phun ningin le an chung ningin; pa paohpaoh, thla khat ri in a cunglei na rel hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cucaah Moses nih, Bawipa bia bangin, nawl pek a si bangin, a rel hna.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mah hihi Levi fapa hna cu an min in an si: Gershon le Kohath le Merari.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cun mah hihi Gershon fapa hna cu an chung cio ningin an si: Libni le Shimei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun Kohath fapa hna cu an chung ning cio ah: Amram, Izhar, Hebron, le Uzziel.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Merari fapa hna cu an chung cio ningin: Mahli le Mushi. Mah hna hi Levi chungkhar hna cu an si, an phun ning cio ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gershon cu Libni chung le Shimei chung thlatu a si; mah hna hi Gershon chung hna cu an si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thla khat ri in a cunglei pa vialte relmi hna cu thong sarih le za nga an si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gershon chung hna cu puan biakinn hnu lei, nitlaklei ah khan riahhmun khuar awk an si lai;
  </para>
  <para style="p">
    <verse number="24" style="v" />Gershon mi hna phun an lu ah cun Lael fapa Eliasaf a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Gershon fapa hna nih tonnak thlam chungah an zohkhenh awk hnga cu puan biakinn cu a si lai, a thlam he, a khuhnak he, tonnak thlam innka zar,
  </para>
  <para style="p">
    <verse number="26" style="v" />tual kulhnak puanzar, tual innkazar puan biakinn le biakṭheng velchum i a ummi cu le a hri hna; hi hna he aa tlaimi rian vialte.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kohath cu Amram chung le Izhar chung le Hebron chung le Uzziel chung thlatu a si; mah hna hi Kohath chung hna cu an si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thla khat ri in a cunglei pa vialte relmi hna, hmunthiang a zohkhenhtu ding hna cu, thong riat le za ruk an si.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kohath fapa hna cu an chungchung in puan biakinn thlanglei kamah riahhmun an khuar awk a si lai,
  </para>
  <para style="p">
    <verse number="30" style="v" />Kohath mi hna a chungchung in a ummi an phun lu cu Uzziel fapa Elizafan a si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cun annih nih an zohkhenh awk hnga cu kuang le cabuai le meiinn tung le biakṭheng hna le, tlangbawi nih an hmanmi hmunthiang umkheng hna cu le puanzar an si lai; mah hna he aa tlaimi rian vialte.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun tlangbawi Aaron fapa Eleazar cu Levi mi hna a hruitu hna lak i upa bik a si lai i, hmunthiang zohkhenh awk an rian a simi hna a hruitu a si lai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Merari cu Mahli chung le Mushi chung thlatu a si: mah hna hi Merari chung cu an si.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thla khat ri in a cunglei pa vialte relmi hna cu thong ruk le za hnih an si.
  </para>
  <para style="p">
    <verse number="35" style="v" />Merari chung hna an phun lu cu Abihail fapa Zuriel a si; annih cu puan biakinn a chaklei kamah riahhmun khuar awk an si.
  </para>
  <para style="p">
    <verse number="36" style="v" />Merari fapa hna zohkhenh awk caah ruahmi cu puan biaknak inn a tungtlang hna le, a fung hna le, a tung hna le, a hram hna le hman awk a thilri vialte an si lai; mah hna he aa tlaimi rian vialte.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tual velchum i tung hna zong, an hram le an khenhteo le an hri hna he tiah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Cun puan biakinn hmailei nichuahlei, nichuak hoih tonnak thlam hmailei i riahhmun a khuar hnga ding cu Moses le Aaron le a fapa hna an si lai, Israel mi hna ca i tuah awk a simi paoh, hmunthiang chung i phunglam hna cu anmah rian a si lai; midang ahohmanh a ra naihmi paoh cu thah a si lai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Bawipa nih nawl a pek hna bangin Moses le Aaron nih, a chungchung in, thla khat ri in a cunglei pa paohpaoh an relmi, Levi mi vialte hna cu sang hnih le thong hnih an si.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cun Bawipa nih Moses cu a chawnh i, “Israel mi hna an fater pa, thla khat ri in a cunglei vialte cu rel hna, zeizat an si cu an min in na lak lai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Cun Levi mi cu keimah caah na lak hna lai — keimah cu Bawipa ka si — Israel mi hna lak i fater vialte hna can ah na lak hna lai, cun, Levi mi saṭil hna cu Israel mi hna saṭil hna lak i later fa can ah na lak hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="42" style="v" />Cu caah Bawipa nih nawl a pek bangin Moses nih Israel mi hna lak i fater vialte cu a rel dih hna.
  </para>
  <para style="p">
    <verse number="43" style="v" />Fater pa vialte, an min zat ningin, thla khat in a cunglei relmi hna cu sang hnih thong hnih, za hnih le sawm sarih pathum an si.
  </para>
  <para style="p">
    <verse number="44" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Levi mi hna cu Israel mi hna lak i fater vialte can ah la hna law, Levi mi saṭil hna cu an saṭil can ah la hna; cun Levi mi cu keimah ta an si lai: keimah cu Bawipa ka si.
  </para>
  <para style="p">
    <verse number="46" style="v" />Cun Levi mi pa hna nakin, Israel mi hna fater an tam deuhnak za hnih le sawm sarih le pathum hna tlanhnak caah khan,
  </para>
  <para style="p">
    <verse number="47" style="v" />pakhat ah shekel panga lengmang na lak lai; hmunthiang shekel ning i rel in, shekel pakhat i gerah pakul a simi kha, na lak hna lai;
  </para>
  <para style="p">
    <verse number="48" style="v" />cun a hlei a simi hna tlanhnak tangka cu Aaron le a fapa hna cu na pek hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="49" style="v" />Cucaah Levi mi nih an tlanhmi hna cung i a hlei a simi hna tlanhnak tangka cu Moses nih a lak;
  </para>
  <para style="p">
    <verse number="50" style="v" />Israel mi hna fater hna sin cun, hmunthiang shekel ning i rel in shekel thong khat, za thum le sawm ruk panga a lak;
  </para>
  <para style="p">
    <verse number="51" style="v" />cun Moses nih tlanhnak tangka cu, Bawipa bia bangin, Bawipa nih nawl a pek bangin, Aaron le a fapa hna kha a pek hna.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses le Aaron cu a chawnh hna i hi bangin a ti,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Levi fapa hna lak i Kohath fapa hna kha rel tuah hna u, an chung ning cio le an phun ning cio ah,
  </para>
  <para style="p">
    <verse number="3" style="v" />kum sawm thum ri in kum sawm nga tiang, rian ah a lut khomi vialte, tonnak thlam chung i rianṭuan awkah rel hna u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kohath fapa hna i tonnak thlam chung i an rian cu, a thiang bik thil hna cu an si lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Riahhmun cu pawh aa timh tikah, Aaron le a fapa hna nih an lut lai i phenhnak puanzar kha an ṭhumh lai i biahngalhternak kuang kha mah cu cun an tuam lai;
  </para>
  <para style="p">
    <verse number="6" style="v" />cun a cungah meheh phaw in sermi zualnak in an zual lai, cun cu cungah cun a dihlak in a dummi puan an khuh lai i a laang cu an hrolh hna lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun umcamcin changreu cabuai cungah cun a dummi puan an phah lai i a cungah pakan hna le rimhmui khanghnak kheng tete le kanto hna le thlet thawinak ca i awi-um hna cu an chiah hna lai; umcamcin changreu zong cu a cungah cun a um ve lai;
  </para>
  <para style="p">
    <verse number="8" style="v" />cun an cungah puan sen an khuh hna lai i mah cucu meheh phaw in sermi zualnak in an zual hna lai i a laang cu an hrolh hna lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun puan dum an lak lai i ceunak ca meiinn tung cu a meiinn hna le a hmihnak hna le a pakan hna le chiti an peknak um vialte he tiah an khuh lai:
  </para>
  <para style="p">
    <verse number="10" style="v" />cun a thilthuam vialte he meheh phaw in sermi zualnak chungah cun an sanh lai i putnak laang cungah cun an chuan lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun sui biakṭheng cungah khan puan dum an khuh lai i meheh phaw in sermi zualnak in an zual lai i a laang kha an hrolh hna lai;
  </para>
  <para style="p">
    <verse number="12" style="v" />cun rianṭuannak umkheng vialte, hmunthiang chung i hmanmi kha an lak hna lai i puan dum chungah an chiah hna lai i meheh phaw in sermi zualnak in an zual hna lai i putnak laang cungah an chuan hna lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun biakṭheng vutcam kha an luah lai i a cungah puan senduk an khuh lai;
  </para>
  <para style="p">
    <verse number="14" style="v" />cun a cungah biakṭheng thilthuam vialte mah ka rianṭuannak i hmanmi, meilaknak kheng hna le thir zum hna le cawhlek hna le khengkuar hna le, biakṭheng thilthuam vialte hna cu an chiah lai; cun a cungah meheh phaw in sermi khuhnak an phah lai i a laang cu an hrolh hna lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun Aaron le a fapa hna nih hmunthiang le hmunthiang thilthuam vialte cu an khuh dih tikah, riahhmun cun aa thawh lioah, cu hnuah Kohath fapa hna cu mah hna hi zawnh awkah an ra lai, sihmanhsehlaw thil thiang kha an tawng hrimhrim hna lai lo, an thi sual hnga. Mah hna hi tonnak thlam thilri Kohath fapa hna nih an i zawnh awk hnga cu an si.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Cun tlangbawi Aaron fapa Eleazar cu van awk ca i chiti, rimthawmi zihmui, hun camcinmi changvut thawinak le thuhnak chiti cu a zohkhenhtu a si lai, puan biakinn a dihlak in le a chung i a ummi thil vialte le, hmunthiang le a thilthuam vialte zohkhenh zong a si lai.”
  </para>
  <para style="p">
    <verse number="17" style="v" />Bawipa nih Moses le Aaron cu a chawnh hna i,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kohath chung hna phun cu Levi mi hna chungin lohter hna hlah u;
  </para>
  <para style="p">
    <verse number="19" style="v" />thil thiang bik pawng an rat tikah an nun i an thih nakhnga lo, annih cu hitihin nan va ti hna lai: Aaron le a fapa hna kha an lut lai i an rian cio le an phorh ding thil cio kha an thiah hna lai,
  </para>
  <para style="p">
    <verse number="20" style="v" />sihmanhsehlaw a thiangmi thil hna zoh awkah, caan tawite ca hmanh a si ah, annih an lut lai lo, an thi sual lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Gershon fapa hna zong kha rel tuah hna, an chung ning cio le an phun ning cio ah;
  </para>
  <para style="p">
    <verse number="23" style="v" />kum sawm thum ri in kum sawm nga tiang, na rel hna lai, rianṭuannak ah a lut khomi vialte, tonnak thlam chung i rian ṭuan awkah.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mah hihi Gershon chung hna an rian cu a si lai, rianṭuannak le thil phorhnak ah:
  </para>
  <para style="p">
    <verse number="25" style="v" />puan biakinn puanzar le tonnak thlam a khuh he, cun a cung i a ummi tuu phaw in sermi khuhnak, cun tonnak thlam innka zar,
  </para>
  <para style="p">
    <verse number="26" style="v" />tual kulhnak puanzar, cun puan biakinn le biakṭheng velchum i a ummi tual kutka luhnak puanzar, cun an hri le an rianṭuannak ca i thilthuam vialte; cun cu hna he aa pehtlai in a herhmi vialte cu an tuah lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gershon fapa hna an rian vialte cu Aaron le a fapa hna nawl in a si lai, an phorh awk hnga vialte ah siseh, an tuah awk hnga vialte ah siseh; cun an phorh awk hnga vialte cu anmah rian ah na hluai lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mah hihi Gershon mi hna an fapale hna i an chung cio in, tonnak thlam chungah an rian cu a si, cun an rian cu tlangbawi Aaron fapa Ithamar nih a zoh lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari fapa hna tu cu an chung ning cio le an phun ning cio in na rel hna lai;
  </para>
  <para style="p">
    <verse number="30" style="v" />kum sawm thum ri in kum sawm nga tiang, na rel hna lai, rianṭuannak chungah a lut khomi paoh tonnak thlam rianṭuan awkah cun, na rel hna lai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mah hihi phorh awkah annih thiahmi cu a si, tonnak thlam chung i an rianṭuannak a ning khan ah: puan biakinn a tungtlang hna, a fung hna le, a tung hna le a hram hna he tiah,
  </para>
  <para style="p">
    <verse number="32" style="v" />cun tual velchum i a ummi tung hna, an hram hna he an khenhteo hna he an hri hna he, an thilthuam vialte le an thilri vialte he tiah; cun annih kha phorh awk fialmi thil hna cu an min in na thiah hna lai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tlangbawi Aaron fapa Ithamar kut tangah Merari fapa hna chunglei i an rian, tonnak thlam chung i an rianṭuanmi cu a dihlak in, mah hihi a si,” tiah a ti.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cun Moses le Aaron le mibu a hruaitu hna nih cun Kohath fapale hna cu an chung ning cio le an phun ning cio ah an rel hna,
  </para>
  <para style="p">
    <verse number="35" style="v" />kum sawm thum ri in kum sawm nga tiang, tonnak thlam chung i rianṭuan awkah, rianṭuannak chung i a lut khomi paohpaoh;
  </para>
  <para style="p">
    <verse number="36" style="v" />cun a chungchung in an relmi hna cu thong hnih, za sarih le sawm nga an si.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bawipa nih Moses in nawl a pekmi bangin Moses le Aaron nih an relmi hna, tonnak thlam chung i rian a ṭuanmi vialte, Kohath mi hna chungle hna cu mah zat hi an si.
  </para>
  <para style="p">
    <verse number="38" style="v" />Gershon fapa hna, an chung ning cio le an phun ning cio ah,
  </para>
  <para style="p">
    <verse number="39" style="v" />kum sawm thum ri in kum sawm nga tiang, tonnak thlam chung rianṭuan awk ca i rianṭuannak i a lut khomi paohpaoh,
  </para>
  <para style="p">
    <verse number="40" style="v" />an chung cio le an phun ning cio in rel ah thong hnih, za ruk le sawm thum an si.
  </para>
  <para style="p">
    <verse number="41" style="v" />Bawipa nawl peknak bangin Moses le Aaron nih an relmi hna, tonnak thlam chung i rian a ṭuanmi vialte, Gershon fapa hna i chungle hna cu mah zat hi an si.
  </para>
  <para style="p">
    <verse number="42" style="v" />Merari i fapa hna chungle hna cu an chung ning cio le an phun ning cio in,
  </para>
  <para style="p">
    <verse number="43" style="v" />kum sawm thum ri in kum sawm nga tiang, tonnak thlam chung i rianṭuan awk ca i rianṭuannak i a lut khomi paohpaoh,
  </para>
  <para style="p">
    <verse number="44" style="v" />a chungchung in rel ah thong thum le za hnih an si.
  </para>
  <para style="p">
    <verse number="45" style="v" />Bawipa nih Moses in nawl pekmi bangin Moses le Aaron nih an relmi hna Merari fapa hna chungle cu mah zat hi an si.
  </para>
  <para style="p">
    <verse number="46" style="v" />Levi mi hna chung i relmi vialte, Moses le Aaron le Israel mi hna hruaitu hna nih an relmi, an chung cio ningin le an phun cio ningin,
  </para>
  <para style="p">
    <verse number="47" style="v" />kum sawm thum ri in kum sawm nga tiang, tonnak thlam chung i ṭuan awk rian le phorh awk rian ṭuan awk ca i a lut khomi,
  </para>
  <para style="p">
    <verse number="48" style="v" />annih lak i relmi hna cu thong riat le za nga le sawm riat an si.
  </para>
  <para style="p">
    <verse number="49" style="v" />Moses in pekmi Bawipa nawlbia bangin thiah an si, anmah le an rian cio ah khan, rian ṭuan siseh, thil phorh siseh; cu bangin annih cu a rel hna, Bawipa nih Moses nawl a pek bang khan, a rel hna.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Riahhmun lengah thinghmui zawtnak a ngei paoh le, thil chuak a ngei paoh le miruak he i tawnghnak in a thiang lomi vialte cu an chuah hna nakhnga nawl pe hna;
  </para>
  <para style="p">
    <verse number="3" style="v" />pa siseh nu siseh na chuah hna lai, riahhmun lengah na chuah hna lai, zeitintiah a laifang i ka umnak an riahhmun cu an thurhhnawmh nakhnga lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cu bangin Israel mi nih an tuah i riahhmun lengah an chuah hna; Bawipa nih Moses a chimh bangin, cu bangin Israel mi nih an tuah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Israel mi cu va chim hna, Pa nih siseh nu nih siseh a minung hawi cungah ṭhat lonak a tuah i cu a tuahmi thawngin Bawipa he bia i kamnak kha a rawk i a tuahtu nih cun a sualnak kha a hngalh tikah,
  </para>
  <para style="p">
    <verse number="7" style="v" />sualnak a tuahmi cu a phuan lai i a sualnak caah cun tling tein rulhnak a tuah lai; cheu nga cheu khat a chap lai i a cung i sualnak a tuahnak mi kha a pek lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asinain, sualnak tuahmi ca rulhnak cohlangtu ah mipa nih khan rualchan a ngeih lo ahcun, sualnak tuahmi ca rulhnak kha Bawipa sinah tlangbawi caah a kal lai, remnak tuukawng, amah ca i remnak sernak hleiah khan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun pekchanhmi thil vialte, Israel mi hna thil thiang vialte, tlangbawi sin i an rak putmi hna cu, amah ta an si lai;
  </para>
  <para style="p">
    <verse number="10" style="v" />mi kip i an thil thiang hna cu amah ta an si lai; mi zeihmanh nih tlangbawi an pekmi thil cu a zeihmanh amah ta a si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Israel mi cu va chim hna, Mipa pakhatkhat cu a nupi nih hei pialtak seh law, a cungah zumhawktlak loin thil tuah seh law,
  </para>
  <para style="p">
    <verse number="13" style="v" />mipa pakhatkhat nih pum duhnak in ihpi seh law, a va nih hngal ṭung hlah seh law, amah cu aa thurhhnawmh cang nain puang ṭung loin a um lioah khan, tlaih a si lo caah amah cungah tehte um ṭung hna hlah seh law;
  </para>
  <para style="p">
    <verse number="14" style="v" />cun a va cungah lunghrinnak lungthin a tlun i aa thurhhnawmh cangmi a nupi kha a lunghrinh ahcun, asiloah lunghrinnak lungthin cu a cungah a tlung i a nupi cu aa thurhhnawmh lo nain a lunghrinh ahcun,
  </para>
  <para style="p">
    <verse number="15" style="v" />khi tikah mipa nih a nupi cu tlangbawi sinah a ratpi lai i amah kongah a herhmi pekchanhnak kha a rak put lai, cucu barli dip ephah cheu hra cheu khat a si lai; chiti a toih lai lo, frankinsen zong a toih lai lo, zeicahtiah lunghrinh changvut thawinak, hngalh ṭhannak changvut thawinak a si; ṭhat lonak hngalh ṭhanternak caah a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Cun tlangbawi nih nu cu hmaiah a ratpi lai i Bawipa hmaiah khan a dirter lai;
  </para>
  <para style="p">
    <verse number="17" style="v" />cun tlangbawi nih tlak um in ti thiang kha a lak lai i puan biakinn ṭuang i leidip kha tlawmpal in a lak lai i ti chungah cun a paih lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cun tlangbawi nih minu kha Bawipa hmaiah a dirter lai, a sam kha a phoih lai i a kut chungah hngalh ṭhannak changvut thawinak kha a chiah lai, mah cucu lunghrinnak changvut thawinak kha a si. Cun a kut in tlangbawi nih cun khaatnak ti, chiatnak a tluntertu cu, aa put lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun tlangbawi nih minu cu chiat hi bangin a serter lai i, ‘Nangmah nih na va nawlngeihnak toiah na um lioah ahohmanh nih an in ihpi lo i thurhhnawmhnak leiah naa mer lo ahcun, hi khaatnak ti, chiatnak a tluntertu hin luat ko.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sihmanhsehlaw na va nawlngeihnak toiah na um nain, na rak pial i na rak i thurhhnawmh i na va hleiah mipa pakhatkhat nih an ihpi ahcun,
  </para>
  <para style="p">
    <verse number="21" style="v" />cu ti a si ahcun, (tlangbawi nih minu cu chiat cu serter seh law, minu sinah chim seh) ‘Na mi hna lakah Bawipa nih nangmah cu chiathrutnak in inter seh, Bawipa nih na phei kha a tlonghter i na pum kha a phinter tikah;
  </para>
  <para style="p">
    <verse number="22" style="v" />hi chiathrutnak a tlunhtu ti hi na paw chungah lut seh law, na pum cu phinter seh law, na phei cu tlonghter seh,’ tiah a ti lai. Cun minu nih cun, ‘Amen, Amen,’ a ti lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Cun tlangbawi nih hi chiatsernak bia hna cu cauk chungah a ṭial lai i khaatnak ti chungah khan a tlengh hna lai;
  </para>
  <para style="p">
    <verse number="24" style="v" />cun minu kha chiatnak a tlunhtu khaatnak ti kha a dinter lai i chiatnak a tluntertu ti kha a chungah a lut lai i nganfahnak a pek lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun tlangbawi nih minu kut chung khan lunghrinh changvut thawinak kha a lak lai i changvut thawinak cu Bawipa hmaiah a hninh lai i biakṭheng ah a rak put lai;
  </para>
  <para style="p">
    <verse number="26" style="v" />cun tlangbawi nih, cu changvut thawinak hngalh camcinnak caah cun, changvut thawinak cu pei khat in a lak lai i biakṭheng cungah a khangh lai i a hnuah nu cu ti kha a dinter lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun minu kha ti cu a dinter tikah, amah kha a rak i thurhhnawmh i a va toiah zumh awk tlak loin a rak um ahcun, chiatnak a tlunhtu ti cu a chungah a lut lai i a ngan a fahter lai i a pum cu a phing lai i a phei cu a tlong lai i, cu nu cu a mi hna lakah chiathrutnak a ingmi ah a cang lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sihmanhsehlaw minu cu a rak i thurhhnawmh lo i a thian ko ahcun, cu ti a si ahcun amah cu a luat lai i fa a hrin hna lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Mah hihi lunghrinhnak kong i phungbia cu a si, nu nih a va nawl ngeihnak toiah a um nain a pial i aa thurhhnawmh tikah siseh,
  </para>
  <para style="p">
    <verse number="30" style="v" />asiloah, pa cungah lunghrinnak thinlung a tlun i a nupi kha a lunghrinh tikah siseh; khi tikah minu cu Bawipa hmaiah a dirter lai i tlangbawi nih mah phungbia vialte hi minu cungah cun a tuah lai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pa cu ṭhat lonak in a luat lai, sihmanhsehlaw nu nih cun a ṭhat lonak cu a in lai,” tiah a ti.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Bawipa nih Moses cu a chawnh i hi bangin a ti,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi cu va chim tuah hna, pa nih siseh, nu nih siseh a si khunmi biakamnak, Nazir biakamnak, Bawipa sin i i thleidan awkah a tuah tikah,
  </para>
  <para style="p">
    <verse number="3" style="v" />zu le zureu din awk kha a hrial lai; zu in siseh, zureu in siseh, sermi a thormi zong kha a ding lai lo, cun mitsur hang zong a ding lai lo, mitsur thei zong a ei lai lo, a hring in siseh, a car in siseh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aa thleidan chung vialte cu mitsur ruang in a chuakmi thil zeihmanh a ei lai lo, a ci le a hawng hmanh a ei hna lai lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />“I thleidan awk i bia aa kam chung vialte cu a lu cu namte zeihmanh nih a tawng lai lo; Bawipa ca i aa thleidannak a caan a tlin hlantiang cu a thiang lai; a sam kha aa zuah lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“ Bawipa sinah aa thleidan chung vialte cu miruak pawngah a kal lai lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />A pa siseh a nu siseh, a unau siseh a far siseh, cu hna an thih hmanh ahcun, aa thurter lai lo; zeicahtiah Pathian sin i aa thleidannak cu a lu cungah a um.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aa thleidan chung vialte Bawipa caah a thiang.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Cun mi pakhatkhat cu a pawngah duak tiah a thih sual i a thiantermi a lu kha a buar ahcun, aa thianh ni ah a lu kha aa meh lai; ni sarihnak ni ah aa meh lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni riat ni ah ṭhuro pahnih maw, laileng no pahnih dik, tonnak thlam innka ah, tlangbawi sinah a rak put lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun tlangbawi nih pakhat cu sual thawinak caah a thawi lai i pakhat cu khangh thawinak caah a thawi lai, cun remnak a serpiak lai, zeitintiah miruak thawngin a sual cang. Cun cu ni theng ah cun a lu kha a thianter lai i
  </para>
  <para style="p">
    <verse number="12" style="v" />aa thleidan caan kha Bawipa sinah aa thleidang ṭhan lai; cun tuufa a pa pakhat, kum khat a timi phungbuar thawinak caah a rak put lai; sihmanhsehlaw a caan hmasa deuh kha cu pakpalawng a si lai, zeicahtiah aa thleidannak kha a buar.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Cun mah hihi Nazir caah phungbia a si, aa thleidannak caan kha a dih tikah: amah cu tonnak thlam innka ah khan ratpi a si lai i
  </para>
  <para style="p">
    <verse number="14" style="v" />a laksawng cu Bawipa sinah a pekchanh lai, khangh thawinak caah tuufa pakhat a pa kum khat a ti i do a tlami, cun sual thawinak caah tuufa pakhat a nu kum khat a ti i do a tlami, cun daihnak thawinak caah do a tlami tuutum pakhat,
  </para>
  <para style="p">
    <verse number="15" style="v" />cun thilnu telh lo changreu bawm khat, chiti he cawhmi changvut dip in sermi changreu hlum hna le changreu a per tete chiti thuhmi le an changvut thawinak hna le an thlet thawinak hna an si lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun tlangbawi nih Bawipa hmaiah a chuahpi hna lai i a sual thawinak le a khangh thawinak cu a thawi hna lai,
  </para>
  <para style="p">
    <verse number="17" style="v" />tuukawng cu Bawipa sin i daihnak pekchanh thawinak caah a thawi lai, thilnu telh lo changreu bawm khat he khan; tlangbawi nih a changvut thawinak le a thlet thawinak zong kha a thawi hna lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cun Nazir mi nih a thiantermi a lu cu tonnak thlam innka ah aa meh lai i thiantermi a lu cun sam cu a lak lai i daihnak pekchanh thawinak tang i a ummi mei ah khan a paih lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun tlangbawi nih chumh hnuah tuukawng a liang cu le bawm chungin thilnu telh lo changreu pakhat le changreu pante thilnu telh lomi pakhat cu a lak hna lai i Nazir mi kut chungah khan a chiah hna lai, aa thianhnak a sam aa meh dih hnuah khan,
  </para>
  <para style="p">
    <verse number="20" style="v" />cun tlangbawi nih Bawipa hmai i hninh thawinak ah a hninh hna lai; annih cu tlangbawi ca i a thiangmi covo an si, a ii hninhmi le a phei thawimi he khan; cu hnuah cun Nazir mi nih cun mitsur hang a din khawh lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Mah hihi biakamnak a tuahmi Nazir caah phungbia a si. Nazir a si ca i biakamnak a tuahning khan Bawipa sin i a pekchanhnak cu a si lai, zei dang a ti khawhmi hleiah; biakamnak a tuahmi ning khan, cu bantukin Nazir mi a si ca i aa thleidannak phungbia ning khan a tuah lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Aaron le a fapa hna cu, ‘Hi bangin Israel mi cu thluachuah nan pek hna lai, nannih nih annih sinah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Bawipa nih thluachuahnak in pe hna in, in zohkhenh ko hna seh;
  </para>
  <para style="p">
    <verse number="25" style="v" />Bawipa nih nan cungah a hmai tlanter seh law, vel in ngeih ko hna seh;
  </para>
  <para style="p">
    <verse number="26" style="v" />Bawipa nih mithmai ṭha in pe hna seh law, daihnak in pe ko hna seh, tiah nan chim lai,’ tiah chim hna.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Cu bangin ka min cu Israel mi hna cungah an chiah lai i thluachuahnak ka pek hna lai,” tiah a ti.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses nih puan biakinn cu a dirter dih i a thilri vialte he chiti a thuh i a thianter hna i biakṭheng le a umkheng vialte zong chiti a thuh i a thianter dih hna ni ah,
  </para>
  <para style="p">
    <verse number="2" style="v" />relmi chung i a ummi Israel hruaitu hna, phun khat chung i lu a si ciomi hna, hrin khat chung i hruaitu a si ciomi hna nih cun pekchanhnak an tuah i
  </para>
  <para style="p">
    <verse number="3" style="v" />an pekchanhnak cu Bawipa hmaiah an ratpi, khuh ngeimi leng paruk le cawtum hlei hnih, hruaitu pahnih caah leng khat lengmang, cun pakhat caah cawtum pakhat lengmang; mah hna cu puan biakinn hmaiah an pekchanh hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Annih sinin mah hna hi cohlang hna, tonnak thlam rianṭuannak caah khan hman an si nakhnga, cun Levi mi kha pe hna, anmah le an rianṭuanning cio khan,” tiah a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cu caah Moses nih leng le cawtum cu a lak hna i Levi mi kha a pek hna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershon fapa hna kha leng pahnih le cawtum pali a pek hna, an rianṭuanning bantukin;
  </para>
  <para style="p">
    <verse number="8" style="v" />cun leng pali le cawtum pariat cu Merari fapa kha a pek hna, tlangbawi Aaron fapa Ithamar zohkhenhnak tang i an rianṭuanning in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sihmanhsehlaw Kohath fapa cu zeihmanh a pe hna lo, zeicahtiah annih cu thil thiang, liang i put awk a simi hna zohkhenh kha thiah an si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun hruaitu hna nih cun biakṭheng thianternak ca i pekchanhnak cu an pek, chiti thuh a si ni ah cun; cun hruaitu hna nih cun an pekchanhnak cu biakṭheng hmaiah an pek.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun Bawipa nih Moses sinah, “Annih nih an pekchanhnak cu an pek awk an si, ni khat ah hruaitu pakhat lengmang nih, biakṭheng pekchanhnak caah,” tiah a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ni hmasa bik ah a pekchanhmi thil a pemi cu Amminadab fapa Nahshon, Judah hrin, kha a si;
  </para>
  <para style="p">
    <verse number="13" style="v" />a pekchanhmi thil cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin; an pahnih in changvut thawinak ca i chiti cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="14" style="v" />cun sui pakan pakhat shekel pahra a ritmi, zihmui a khatte in,
  </para>
  <para style="p">
    <verse number="15" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="16" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="17" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Amminadab fapa Nahshon i a pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni hnihnak ni ah Issakhar a hruaitu hna Zuar fapa Nethanel nih pekchanhnak a tuah;
  </para>
  <para style="p">
    <verse number="19" style="v" />a pekchanhnak ca i a pekmi cu mah hi an si, ngun kheng pakhat shekel za le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="20" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khatte in;
  </para>
  <para style="p">
    <verse number="21" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="22" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="23" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga, le tuufa a pa kum khat a timi panga. Mah hihi Zuar fapa Nethanel pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni thumnak ni ah Zebulun mi hna hruaitu Helon fapa Eliab cu a si:
  </para>
  <para style="p">
    <verse number="25" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="26" style="v" />sui pakan shekel pahra a ritmi, zihmui a khatte in;
  </para>
  <para style="p">
    <verse number="27" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="28" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="29" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Helon fapa Eliab pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ni linak ni ah cun Reuben mi hruaitu Shedeur fapa Elizur kha a si:
  </para>
  <para style="p">
    <verse number="31" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in,
  </para>
  <para style="p">
    <verse number="32" style="v" />sui pakan pakhat, shekel pahra a ritmi, zihmui a khatte in;
  </para>
  <para style="p">
    <verse number="33" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat,
  </para>
  <para style="p">
    <verse number="34" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="35" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Shedeur fapa Elizur i a pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni nganak ni ah cun Simeon mi hna a hruaitu Zurishaddai fapa Shelumiel a si:
  </para>
  <para style="p">
    <verse number="37" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="38" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="39" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="40" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="41" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Zurishaddai fapa Shelumiel pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ni ruknak ni ah Gad mi a hruaitu hna Deuel fapa Eliasaf a si:
  </para>
  <para style="p">
    <verse number="43" style="v" />a pekchanhmi cu, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat, shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="44" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="45" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="46" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="47" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga, le tuufa a pa kum khat a timi panga. Mah hihi Deuel fapa Eliasaf pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ni sarihnak ni ah Efraim mi a hruaitu hna Ammihud fapa Elishama a si:
  </para>
  <para style="p">
    <verse number="49" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi, changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="50" style="v" />sui pakan pakhat, shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="51" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="52" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="53" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Ammihud fapa Elishama pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ni riatnak ni ah Manasseh mi a hruaitu hna Pedahzur fapa Gamaliel a si:
  </para>
  <para style="p">
    <verse number="55" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="56" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="57" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="58" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="59" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Pedahzur fapa Gamaliel pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="60" style="v" />Ni kuanak ni ah Benjamin mi a hruaitu hna Gideoni fapa Abidan a si:
  </para>
  <para style="p">
    <verse number="61" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="62" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="63" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="64" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="65" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Gideoni fapa Abidan i a pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="66" style="v" />Ni hranak ni ah Dan mi a hruaitu hna Ammishaddai fapa Ahiezer a si:
  </para>
  <para style="p">
    <verse number="67" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="68" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="69" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="70" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="71" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Ammishaddai fapa Ahiezer pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="72" style="v" />Ni hlei khatnak ni ah Asher mi a hruaitu hna Okhran fapa Pagiel a si:
  </para>
  <para style="p">
    <verse number="73" style="v" />a pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="74" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khat tein;
  </para>
  <para style="p">
    <verse number="75" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="76" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="77" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Okhran fapa Pagiel pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="78" style="v" />Ni hlei hnihnak ni ah, Naftali mi a hruaitu hna Enan fapa Ahira a si:
  </para>
  <para style="p">
    <verse number="79" style="v" />amah pekchanhmi cu mah hi an si, ngun kheng pakhat shekel za khat le sawm thum a ritmi, ngun pakan kuar pakhat shekel sawm sarih a ritmi, hmunthiang shekel ningin, an pahnih in changvut thawinak ca i chiti he cawhmi changvut dip a khat veve in;
  </para>
  <para style="p">
    <verse number="80" style="v" />sui pakan pakhat shekel pahra a ritmi, zihmui a khatte in;
  </para>
  <para style="p">
    <verse number="81" style="v" />khangh thawinak ca i cawtum no pakhat, tuukawng pakhat, tuufa a pa kum khat a timi pakhat;
  </para>
  <para style="p">
    <verse number="82" style="v" />sual thawinak ca i meheh a pa pakhat;
  </para>
  <para style="p">
    <verse number="83" style="v" />cun daihnak pekchanhnak thawinak ca i cawtum pahnih, tuukawng panga, meheh a pa panga le tuufa a pa kum khat a timi panga. Mah hihi Enan fapa Ahira pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="84" style="v" />Biakṭheng cu chiti thuh a si ni ah, Israel mi hruaitu hna sinin biakṭheng ca i pekchanhmi thil cu mah hihi a si: ngun kheng hleihnih, ngun pakan kuar hleihnih, sui pakan hleihnih,
  </para>
  <para style="p">
    <verse number="85" style="v" />ngun kheng cu shekel za khat le sawm thum cio an rit, pakan kuar cu shekel sawm sarih cio, umkheng chung ngun vialte cu shekel thong hnih le za li, hmunthiang shekel ningin, a si,
  </para>
  <para style="p">
    <verse number="86" style="v" />sui pakan hleihnih hna kha, zihmui a khat cio ah, pakhat ah shekel pahra cio, hmunthiang shekel ningin, pakan chung i sui vialte cu shekel za khat le kul a si;
  </para>
  <para style="p">
    <verse number="87" style="v" />khangh thawinak ca i ṭilva vialte kha cawtum hleihnih, tuukawng hleihnih, tuufa a pa kum khat a timi hleihnih, an changvut thawinak cio he; cun meheh a pa hleihnih, sual thawinak caah;
  </para>
  <para style="p">
    <verse number="88" style="v" />cun daihnak pekchanhnak thawinak ca i ṭilva vialte cawtum kul le pali, tuukawng sawm ruk, meheh a pa sawm ruk, tuufa a pa kum khat a timi sawm ruk. Mah hihi biakṭheng ca i pekchanhmi thil cu a si, chiti thuh a si hnuah khan.
  </para>
  <para style="p">
    <verse number="89" style="v" />Cun Moses nih tonnak thlam chungah Bawipa he i chawnh awk i a luh tikah khan biahngalhternak kuang cung i a ummi velngeihnak ṭhutdan cung khan, cherubim pahnih hna karlak khan amah a run chawntu aw cu a theih i cuticun amah cu a run chawnh.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aaron sinah, ‘Meiinn na van hna tikah, meiinn pasarih hna nih khan meiinn tung hmailei kha an ceuh awk a si lai,’ tiah va chim,” tiah a ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aaron nih cu bangin a tuah; cu ka meiinn hna cu meiinn tung hmailei kha ceuh dingin a van hna, Bawipa nih Moses nawl a pek bang khan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun mah hihi meiinn tung an serning kha a si, denmi sui i sermi cu; a hram in a pangpar tiang a den in denmi a si; Bawipa nih Moses a hmuhsakmi sawisam ning khan, cu bang cun meiinn tung cu a ser.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Israel mi hna sin khan Levi mi kha la hna law, thianh hna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun annih cu thianh awkah hi bangin na tuah hna lai: tlenghnak ti kha na theh hna lai i namte in an pum a dihlak in i met hna seh, cun an thilpuan su hna seh law, i tleng hna seh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun cawtum no pakhat le chiti he cawhmi changvut dip a changvut thawinak kha la hna seh, cun cawtum no a dang pakhat sual thawinak caah na lak lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Levi mi cu tonnak thlam hmaiah khan na chuahpi hna lai i Israel mibu an ningpi in na pumh hna lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Levi mi cu Bawipa hmaika ah na chuahpi hna tikah, Israel mi nih Levi mi hna cungah an kut an chuan lai,
  </para>
  <para style="p">
    <verse number="11" style="v" />cun Israel mi hna hninh thawinak caah Aaron nih Levi mi hna cu Bawipa sinah a pekchanh hna lai. Bawipa rianṭuan cu annih ta a si naklai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun Levi mi hna nih cun cawtum hna lu cungah cun an kut an chuan lai; Levi mi hna ca i remnak sernak ah, pakhat cu sual thawinak caah, pakhat cu khangh thawinak caah, Bawipa sinah na pekchanh lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun Levi mi hna cu Aaron le a fapa hna hmaiah na umter hna lai i, Bawipa sin i hninh thawinak caah na pekchanh hna lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Cu bangin Levi mi cu Israel mi hna lakin na thleidan hna lai i Levi mi cu keimah ta an si lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun cu hnuah cun tonnak thlam i rianṭuan awkah, Levi mi hna cu na tlengh hna i hninh thawinak ca i na pekchanh hna hnuah an lut lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zeicahtiah annih cu an ningte in Israel mi hna lakin keimah sin i pekmi an si; paw chungin a chuakmi vialte, Israel mi vialte hna fater hna can ah keimah nih kaa lak cang hna.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zeitintiah Israel mi hna lak i fater vialte cu minung i a si ah, saram i a si ah, keimah ta an si; Izipt ram chung i fater vialte ka rak thah hna ni ah khan keimah caah annih cu ka thianter cang hna i,
  </para>
  <para style="p">
    <verse number="18" style="v" />Levi mi hna cu Israel mi hna lak i fater vialte can ah khan ka lak cang hna.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun Israel mi hna lakin Levi mi hna cu tonnak thlam chung i Israel mi hna ca i rian ṭuan awkah le Israel mi hna ca i remnak ser awkah Aaron le a fapa hna sinah laksawng ah ka pek cang hna, zeicahtiah Israel mi nih hmunthiang pawng i an rat sual zongah Israel mi hna lakah rai a um nakhnga lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cu bangin Moses le Aaron le Israel mibu nih an ningpi in, Levi mi hna cungah cun an tuah; Levi mi hna kong he aa peh in Bawipa nih Moses nawl a pekmi vialte bangin Israel mi nih an cungah an tuah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun Levi mi hna nih cun sualnak in an i thianh i an hnipuan kha an suk hna; cun Aaron nih Bawipa hmaiah hninh thawinak bantuk ah a pekchanh hna i annih kha thianh awkah Aaron nih remnak a tuahpiak hna.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun cu hnuah cun Levi mi hna cu tonnak thlam chung i Aaron le a fapa hna hmai i an rianṭuan awkah an lut; Bawipa nih Levi mi hna kongah Moses nawl a pek bangin, cu bangin annih cungah an tuah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun Bawipa nih Moses sinah,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Mah hihi Levi mi hna covo cu a si: kum kul le kum nga ri in a cunglei nih tonnak thlam chung i rian kha ṭuan awkah an lut lai;
  </para>
  <para style="p">
    <verse number="25" style="v" />cun kum sawm nga an ti in rian an i tlaihmi kha an ngol lai i an ṭuan ti lai lo,
  </para>
  <para style="p">
    <verse number="26" style="v" />sihmanhsehlaw tonnak thlam chung rian, a zohkhenhnak rian ah khan, an unau hna cu ṭuan an bawmh hna lai, asinain rian tu cu an ṭuan ti lai lo. Mah bantuk hin Levi mi hna an rian thiahnak ah cun na tuah lai,” tiah a ti.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Bawipa nih, Izipt ram in an chuah hnu a kum hnihnak thla khatnak thla ah khan Moses cu Sinai ramlak ah a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi hna nih Lanhtak Puai cu a caan khiahmi te ah khan ul hna seh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Atu thla ni hleili ni ah, zan lei ah, a caan khiahmi te ah khan nan ulh lai; a nawlbia vialte le a phunglam vialte ning khan nan ulh lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cucaah Moses nih Israel mi hna cu lanhtak puai ul dingin a chimh hna.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun lanhtak puai cu thla khatnak thla, a ni hleili ni ah cun, zanlei ah Sinai ramlak ah an ulh; Bawipa nih Moses nawl a pekmi dihlak bang khan Israel mi nih an tuah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun mi zeimaw miruak a tawng i a thurmi, cucaah cu ni i lanhtak puai a ul kho lomi an um i, cu ni ah cun Moses le Aaron hmaiah an ra i,
  </para>
  <para style="p">
    <verse number="7" style="v" />cu hna nih cun a sinah, “Miruak tawnghnak in kannih cu kan thur cang; zeicahdah Israel mi hna lak i a caan khiahmi Bawipa sin i pekchanhnak pek cu nan kan thlauh?” tiah an ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Moses nih annih sinah, “Um rih tuah u, nannih kongah Bawipa nawl peknak zeidah a si kha thei hmasa rih tuah ning,” tiah a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel mi cu va chim hna, nannih lak i mi pakhatkhat maw, nan tefa hna lak i pakhatkhat cu, miruak tawnghnak in a thur ahcun khual lam hla a tlawn ah maw, Bawipa sin lanhtak puai cu a ulh ṭhiamṭhiam ko lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thla hnihnak thla ni hleili ni zanlei ah an ulh lai; thilnu cawh lo changreu le a khami an he an ei lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zinglei tiang a zeihmanh an taanter lai lo, cun a ruh zong pakhat hmanh an khiak lai lo; lanhtak puai ca i nawlbia vialte ning khan an ulh lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sihmanhsehlaw a thiang a si i khual a tlawng lo nain lanhtak puai ulh loin a um menmi cu, cu mi cu a mi hna sinin hlonh a si lai, zeicahtiah Bawipa sin pekchanhnak cu a caan khiahmi te ah khan a pek lo caah; mah mi nih cun a sualnak cu a phorh ko lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun nan lakah khual pakhat a pem i Bawipa sin lanhtak puai cu a nawlbia le a phunglam ning in ulh a duh ve ahcun, cu bantuk cun tuah ko seh; mipem ca le mah ram mi caah nawlbia pakhat lawng nan ngeih awk a si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puan biakinn an dirter ni ah cun, minmei nih puan biakinn, bia hngalhternak thlam cu a zelh i, zanlei ah cun puan biakinn cungah cun mei alh mui bantukin zinglei tiang a um.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cuticun a um camcin ko; chun ah minmei nih, zan ah meialh mui bantuk nih a zelh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cun minmei cu puan biakinn cung cun cunglei i aa ṭhial chel paoh ah, Israel mi hna cu kal ah an i thawh; cun minmei a ṭumnak hmun paoh ah, cu ka ah cun Israel mi nih riahhmun an khuar tawn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bawipa nawl pek in Israel mi hna cu an i thawh tawn i Bawipa nawl pek in riahhmun an khuar tawn; minmei cu puan biakinn cungah a cam chung paohpaoh an riahhmun ah cun an cam.
  </para>
  <para style="p">
    <verse number="19" style="v" />Minmei cu puan biakinn cung i a um kha ni tampi a si hmanh ah Israel mi nih Bawipa nawlbia cu an zulh ko i an i thawh lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Voi khatkhat cu minmei cu puan biaknak inn cungah ni tlawmte lawng a um i Bawipa nawlbia bangin riahhmun ah an cam; cun Bawipa nawlbia bangin an i thawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun voi khatkhat cu minmei cu zanlei in zinglei tiang a cam; cun minmei cu zinglei i aa ṭhial tikah annih nih an i thawh, asinain ni khat le zan khat hoi hna a cam zongah minmei cu aa ṭhial tik paoh ah annih cu an i thawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni hnih a si ah, thla khat a si ah, caan sau deuh zong a si ah, minmei cu puan biaknak inn cung i a um, cu ka i a cam chung cu, Israel mi hna cu an riahhmun ah an cam ko i an i thawh lo; sihmanhsehlaw aa ṭhial tikah annih cu an i thawh tawn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawipa nawlbia in riahhmun an khuar i Bawipa nawlbia in an i thawh tawn; Moses sinin Bawipa nawlbia an hmuh bangin Bawipa bia cu an zulh.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ngun muko pahnih in ser tuah; a den in denmi an si lai; mi zapi kawhnak le riahhmun in thawhter hnanak caah na hman lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun an pahnih in tum an si tikah mi zapi cu an dihlak in tonnak thlam innka ah khan nangmah sinah an i pum lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sihmanhsehlaw pakhat lawng an tum ahcun, hruaitu hna, Israel phun i an lu hna kha nangmah sinah an i pum lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ralrinnak na tum tikah nichuahlei kap i a ummi riahbuk hna cu an i thawh lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun ralrinnak a voi hnihnak na tum tikah thlanglei kap ah a ummi riahbuk hna cu an i thawh lai. An i thawh lai paoh ah ralrinnak tum lengmang a si lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sihmanhsehlaw mi zapi cu hmun khat i pumh awk an si tikah na tum lai, asinain ralrinnak cu na tum lai lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Aaron fapa, tlangbawi hna nih khan muko cu an tum hna lai. Muko cu nannih caah nan tefa chin tiangin zungzal nawlbia caah an si lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun nannih an hremtu hna nan ral he nan ram chung i nan i doh tikah muko cun ralrinnak nan tum lai, Bawipa nan Pathian hmaiah hngalh nan si camcin i nan ral hna sinin khamh nan si nakhnga.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nan i lawmh ni le a caan khiahmi nan puai hna le nan thla hramthawknak hna zongah nan khangh thawinak hna le nan daihnak pekchanhnak thawinak cungah muko cu nan tum hna lai; nan Pathian hmai i nannih cu theihhngalh an sitertu hna an si lai: keimah cu Bawipa nan Pathian ka si,” tiah a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kum hnihnak kum, thla hnihnak thla, cu thla a ni kul ni ah cun, minmei cu hngalhternak puan biakinn cung cun aa ṭhial i
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel mi hna cu Sinai ramlak khan an i thawh i riahhmun riahhmun lengmang in an kal i, minmei cu Paran ramlak ah khan a dir.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bawipa nih Moses sinin nawl a pekmi hna bangin an i thawh a hmasa bik a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Judah mi hna riahhmun hmelchunhnak cu aa thawh hmasa bik, an bubu in; cun an bu cung i a ummi cu Amminadab fapa Nahshon kha a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Issakhar mi hna phun an bu cung i a ummi cu Zuar fapa Nethanel kha a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun Zebulun mi hna phun an bu cung i a ummi cu Helon fapa Eliab kha a si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cun puan biakinn cu an ṭheh tikah, puan biakinn a putu hna Gershon fapa hna le Merari fapa hna kha an i thawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cun Reuben riahhmun hmelchunhnak kha an bubu in aa thawh i an bu cung i a ummi cu Shedeur fapa Elizur kha a si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun Simeon mi hna phun an bu cung i a ummi cu Zurishaddai fapa Shelumiel kha a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Gad mi hna phun an lu i a ummi cu Deuel fapa Eliasaf kha a si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun Kohath mi cu an i thawh i thil thiang kha an zawnh i an phanh hlanah puan biakinn kha an rak dirter cang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun Efraim mi hna riahhmun hmelchunhnak kha an bubu in aa thawh i an bu cung i a ummi cu Ammihud fapa Elishama kha a si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun Manasseh mi hna phun an bu cung i a ummi cu Pedahzur fapa Gamaliel kha a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cun Benjamin mi hna phun an bu cung i a ummi cu Gideoni fapa Abidan kha a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Dan mi hna riahhmun hmelchunhnak cu an bubu in aa thawh, riahhmun vialte hnulei ralvengtu a si; an bu cung i a ummi cu Ammishaddai fapa Ahiezer kha a si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun Asher mi hna phun an bu cung i a ummi cu Okhran fapa Pagiel kha a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun Naftali mi hna phun an bu cung i a ummi cu Enan fapa Ahira kha a si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mah hihi Israel mi hna nih an i thawh tikah an bubu cio in an kalning cu a si.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cun Moses pu Hobab, Midian miphun Reuel i a fapa sinah khan Moses nih, “ Bawipa nih, ‘Kan pek hna lai,’ a timi hmun i kal awkah kan i thawh; kan sinah ra law, ṭhatnak kan in tuah lai; zeitintiah Bawipa nih Israel kha ṭhatnak a kamh,” tiah a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sihmanhsehlaw amah nih, “Ka kal lai lo; keimah ka ram le ka rualchan hna sinah ka kal lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cun anih nih, “Kan kaltak sawh hlah, zeicahtiah ramlak ah zeitindah riahhmun kan khuar lai kha na hngalh i kannih caah mit bantuk na si lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun kannih sin i na kal ahcun Bawipa nih kan cung i ṭhatnak a tuahmi paoh cu, mah cucu nangmah cungah kan tuah ve lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cu bangin Bawipa tlang in ni thum kal ah an kal i Bawipa biakamnak kuang kha annih ca i, i dinhnak hmun kawl awkah annih hmaiah ni thum lamkal a rak kal chung.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cun Bawipa minmei cu, an riahhmun in an i thawh fate chun ah annih cungah a um.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cun kuang cu aa thawh fate Moses nih, “Tho tuah, maw Bawipa, na ral kha i ṭhek dih hna seh law, nangmah an huatu hna cu na hmaiah zaam hna seh,” tiah a ti.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cun aa dinh tikah, “Ra kir tuah, maw Bawipa, Israel mi a thong a sang hna sinah hin,” tiah a ti.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun mi hna nih cun Bawipa theih ah sifah retheih an innak ruangah khan an zai; mah cucu Bawipa nih a theih tikah a thinhunnak cu a alh i Bawipa mei cu annih lakah a kang i riahhmun kikam i a ummi riahbuk a cheu khat hna cu an kang dih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cu tikah mi nih Moses cu an auh i, Moses nih Bawipa sinah thla a cam i mei cu a dai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cucaah cu ka hmun min cu, Bawipa mei cu annih lakah a kangh caah Taberah ti a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun annih lak i phun dang mi he aa cawhmehmi hna cu sa an haw ciammam i Israel mi hna zong cu an ṭap ṭhan i, “Sa ei awk hei ngei u si law mu!
  </para>
  <para style="p">
    <verse number="5" style="v" />Man lo i Izipt ram i ngasa kan ei le zil le phazeti le purun le piat le vankhawng kha kan hei ngai hna dah;
  </para>
  <para style="p">
    <verse number="6" style="v" />sihmanhsehlaw atu cu kan thazang a car dih i hi manna hi dah ti lo cu zeihmanh zoh awk a um lo,” tiah an ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Manna cu koriander mu bantuk a si i a mui cu rili lungvar bantuk a si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi nih an char hna i rialnak lung in an rial hna, asiloah sum ah an phomh hna i um in an chuan hna i chang ah an ser hna; ei ah hin chiti he rawhmi chang bantuk a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zan i riahhmun i dap a tlak ah hin manna cu a tla ve.
  </para>
  <para style="p">
    <verse number="10" style="v" />Moses nih mi hna cu an innchungkhar cio i an ṭah i an pale hna an thlam innka i an ṭah kha a theih i Bawipa thinhunnak cu a alh in a alh i Moses cu a lung a lawm lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Moses nih Bawipa sinah, “Zeicahdah na sal hi ṭhalo in na ka tuah? Zeicahdah na mit ka tlin lo i hi mi vialte hna phorhrit hi ka cungah na ka khinh?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hi mi vialte hi ka rak pawi hna maw? ‘Nau cawnghramtu nih nau hnuktlai lio a cawi bangin na ṭang ah cawi hna law, an pupa hna sinah pek awkin chiat ka sermi ram ah kalpi hna,’ na ti cu keimah nih maw ka hrin hna?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hi mi vialte pek awkah hin khuazei in dah sa cu ka hmuh lai? Zeitintiah an ka ṭahhnawh i, ‘Kan ei awk caah sa kan pe,’ tiah an ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hi mi hna hi keimah lawng nih ka pua kho hna lo, mah thil hi ka caah a rit tuk.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahtihin na ka tuah ding a si ahcun, hmakhatte ah ka that ko, na mithmai ah velngeihnak ka hmuh a si ahcun, ka retheihnak kha ka hmuhter hlah,” tiah a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun Bawipa nih Moses sinah cun, “Israel upa hna lakin pa sawm sarih, nangmah nih mi hna cung i upa le bawi an si ti i na hngalhmi cu ka sinah ratpi tuah hna; cun tonnak thlam ah ratpi hna law, khika ah nangmah sinah dirter hna.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cun ka rung ṭum lai i khika ah nangmah he kan i chawn lai; cun nangmah cungah a ummi thlarau cu tlawmpal in ka lak lai i an cungah ka chiah lai i nangmah lawng nih na phorh nakhnga lo, mi hna thil cu an in phorhpi lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cun mi hna cu, ‘Thaizing caah i thianh u law, sa nan ei lai; zeicahtiah Bawipa theih ah nan ṭap i, “Aho nih dah ei awk sa a kan pek lai? Izipt ram vial ah khan kan va nuam ṭung,” ti i nan ti caah. Cucaah Bawipa nih sa an pek hna lai i nan ei lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni khat lawng maw, ni hnih lawng maw, ni nga lawng maw, ni hra lawng maw, ni kul lawng maw, nan ei lai lo,
  </para>
  <para style="p">
    <verse number="20" style="v" />sihmanhsehlaw thla khat ning piin nan ei lai, nan hnarkua i a chuah i nan ca i fihnung a si tiangin, zeicahtiah nan lak i a ummi Bawipa cu nan hlawt i a hmaiah, “Zeicahhen Izipt ram khan kan rak chuah,” tiin nan ṭah caah,’ tiah ti hna,” tiah a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sihmanhsehlaw Moses nih, “Keimah zong kaa tel venak mi hna hi, ke kal lawngte hmanh sing ruk an si; cun nang nih, ‘Sa ka pek hna lai, thla khat pumte an ei lai,’ tiah na ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuu runrun le caw runrun maw an i zat awkah thahpiak an si lai? Asiloah, rili chung nga vialte maw an i zat awkah pumhpiak an si lai?” tiah a ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun Bawipa nih Moses sinah cun, “ Bawipa kut cu a tawi hlah maw? Nannih ca i ka bia bangin a tlin le tlin lo cu na hmuh ko lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cucaah Moses cu a chuak i Bawipa bia kha, mi cu a chimh hna; cun Israel upa hna chungin sawm sarih kha a pumh hna i thlam velchum ah khan a chiah hna.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cu tikah Bawipa cu minmei khan a rung ṭum i amah cu a chawnh i amah cung i a ummi thlarau kha tlawmpal in a lak i upa sawm sarih cungah khan a chiah; cun thlarau nih annih cungah a um tikah annih nih bia an chim cukmak. Sihmanhsehlaw cu bantuk cun an tuah ṭhan ti lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Riahhmun ah mi pahnih an rak tang i pakhat cu a min ah Eldad a si i pakhat cu a min ah Medad a si i, annih cungah thlarau kha a um; annih cu minthlakmi lakah khan aa telmi an si ve nain thlam ah khan an kal lo i cucaah riahhmun ah khan bia an chim cuahmah ko.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tlangval pakhat nih a va tli i Moses kha, “Eldad le Medad nih riahhmun chungah bia an chim cuahmah ko,” tiah a chimh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nun fapa Joshua, a tlanval lio in Moses rian a ṭuantu nih khan, “Ka bawipa Moses, thlauh hna,” tiah a ti.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sihmanhsehlaw Moses nih anih cu, “Keimah ca lawngin dah ra na ruah hi? Bawipa mi vialte hi profet si dih in, annih cungah Bawipa nih a thlarau chia seh law ka hei tinak lakah cun!” tiah a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cun Moses le Israel upa hna cu riahhmun ah an kir.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cun Bawipa sinin thli a hrang i rili in nimte kha a ratpi hna i riahhmun pawngah cun a tlakter hna, hika leiah ni khat kal tluk, khika lei ah ni khat kal tluk, riahhmun cu a velchum in, vawlei ah dong hnih tluk chah in a tlakter hna.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun cu ni cu chun nitlak, zan khuadei, cun a thaizing zong, mi cu an tho i nimte cu an char hna; a tlawm bik a charmi nih homer pahra an char i anmah ca cio ah riahhmun a velchum ah cun an car hna.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sa cu an ha karlak i a um lioah, an ei dih hlanah mi hna cungah cun Bawipa thinhunnak a alh i, Bawipa nih mi hna cu rai ṭhalo in a hrem hna.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cucaah cu ka hmun min cu Kibroth-hattaavah, tiah ti a si; zeicahtiah khika ah khan sa a hawmi kha an vui hna.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kibroth-hattaavah in Hazeroth ah an kal i Hazeroth ah cun an cam.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hezeroth i an um lioah khan, Miriam le Aaron nih Moses cu a ṭhitmi Kush minu ruangah khan an thangchiat; zeitintiah Kush minu cu a ṭhit caah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Annih nih, “Moses sin lawng in maw Bawipa nih bia a chim? Kanmah sin zongin a chim ve lo maw?” tiah an ti. Mah cucu Bawipa nih a theih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Moses cu vawleicung mi vialte lakah lungnem bik a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun Bawipa nih chikkhatte ah Moses le Aaron le Miriam sinah cun, “Ra chuak tuah u, nan pathum in, tonnak thlam ah cun,” tiah a ti. An pathum in an ra chuak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Bawipa cu minmei tung in a rung ṭum i thlam innka ah cun a dir i, Aaron le Miriam kha a kawh hna i an pahnih in hmailei ah an ra.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun amah nih, “Ka bia ngai tuah u: Nannih lakah profet an um tikah Bawipa keimah nih langhnak in an sinah kaa hngalhter i mang in ka chawnh hna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sihmanhsehlaw ka sal Moses cu, cu bantuk cun a si lo; ka inn cu a dihlak in a kut chungah ka chiah;
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah cu hmaitonh in ka chawnh, holh thup in si loin fiang tein ka chawnh; cun amah cu Bawipa mui zong a hmumi a si. A si kun ahcun zeicahdah ka sal Moses bia al cu nan ṭih kun lo? tiah a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Bawipa thinhunnak cu annih cungah a alh i a kal;
  </para>
  <para style="p">
    <verse number="10" style="v" />cun minmei cu thlam cung cun aa ṭhial tikah, zohhmanh, Miriam cu thinghmui zawtnak ngeimi a si ko, hawhra bantukin a rang. Cun Aaron cu Miriam leiah a hei i mer i zohhmanh, mithinghmui a si ko ai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun Aaron nih Moses sinah, “Maw, ka bawipa, dan kan tat sawh hlah, zeicahtiah hruh bu piin kan tuah i kan sual cang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah cu a nu paw chungin a chuah tikah a titsa a cheu a dih cangmi a thimi bantuk cu, siter sawh hlah,” tiah a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun Moses nih Bawipa cu a auh i, “Maw Pathian, amah cu damter ko, tiah kan nawl,” tiah a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sihmanhsehlaw Bawipa nih Moses sinah cun, “A pa nih a hmaiah a cil chak seh law, cu hmanh ah cun ni sarih chung cu ningzak in a um lai lo mei? Amah cu riahhmun lengah ni sarih chuah si seh law, cu hnuah cun luhter a si ṭhan te lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cu bangin Miriam cu riahhmun lengah ni sarih chuah a si i mi cu Miriam luh a si ṭhan hlantiang cu i thawh loin an um.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cu hnuah cun Hazeroth in an i thawh i Paran ramlak ah khan riahhmun an khuar.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses sinah cun,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi ka pekmi hna Kanaan ram va ngiatthlai awkah mi thlah hna; an pa le phun, phun khat cio khan, pakhat cio na thlah hna lai, anmah lak i hruaitu cio an si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cucaah Moses nih Paran ramlak khan Bawipa nawl pek bang khan a thlah hna, an dihlak in Israel mi hna an lu kha an si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun mah hihi an min a si: Reuben phun in, Zakkur fapa Shammua;
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon phun in Hori fapa Shafat;
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah phun in Jefunneh fapa Kaleb;
  </para>
  <para style="p">
    <verse number="7" style="v" />Issakhar phun in Josef fapa Igal;
  </para>
  <para style="p">
    <verse number="8" style="v" />Efraim phun in Nun fapa Hoshea;
  </para>
  <para style="p">
    <verse number="9" style="v" />Benjamin phun in Rafu fapa Pali;
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebulun phun in Sodi fapa Gaddiel;
  </para>
  <para style="p">
    <verse number="11" style="v" />Josef phun in (mah cucu Manasseh phun in) Susi fapa Gaddi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan phun in Gemalli fapa Ammiel;
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher phun in Mikhael fapa Sethur;
  </para>
  <para style="p">
    <verse number="14" style="v" />Naftali phun in Vofsi fapa Nahbi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad phun in Makhi fapa Geuel.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mah hihi Moses nih ram va ngiatthlai awk i a thlahmi hna min cu an si. Nun fapa Hoshea cu Moses nih Joshua tiah min a sak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Moses nih Kanaan ram va ngiatthlai awkah cun a thlah hna i annih sinah, “Negeb ah khin hung kal u law, cun tlangram ah nan hung lut lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ram cu zeidah a lawh kha nan hung zoh lai, a chung i a ummi hna cu an ṭhawng maw an der, an tlawm maw an tam,
  </para>
  <para style="p">
    <verse number="19" style="v" />cun an umnak ram cu a ṭha maw a chia; cun an umnak khua hna cu riahbuk men maw an si kulh ngei dah an si,
  </para>
  <para style="p">
    <verse number="20" style="v" />ram cu a rum maw a pam, a chungah thing an um maw um lo. Cun nan ral ṭha ko u, cuka ram theitlai cu tlawmpal in run phor u,” tiah a ti hna. Cu caan cu mitsur thei a hmin hmasa bik pawl hmin caan a si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cu bangin an hung kal i ram cu an hung ngiat, Zin ramlak in Hamath luhnak Rehob tiang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Negeb ah an hung lut i Hebron kha an phan i cuka ah cun Anak tefa hna Ahiman, Sheshai le Talmai kha an rak um. (Hebron cu Izipt ram i Zoan hlan kum sarih ah rak tlakmi a si.)
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun Eskhol Nelrawn an phan i cuka ah cun mitsur tlai bor khat a nge in an sah i lang in pahnih nih an put; taleti le theipi zong an rak phorh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cuka hmun cu Eskhol Nelrawn tiah ti a si, zeitintiah cu ka ah cun Israel mi nih mitsur bor cu an sah hna.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni sawm li ram an va ngiatthlai hnuah cun an rung kir.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun Paran ramlak i Kadesh ah cun Moses le Aaron le Israel mibu vialte sinah khan an ra phan i, an sin le zapi vialte sinah bia an rak phorh i cu ram theitlai cu an hmuhsak hna.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun annih nih amah cu, “Na kan thlahnak ram cu kan va phan; cawhnuk le khuaihliti in a luang i mah hihi a theitlai cu an si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Asinain cuka ram i a ummi hna cu an ṭhawng i an khua hna cu kulhmi an si i an ngan ngaingai; cun cu hleiah Anak tefa hna kha cu ka ah cun kan hmuh hna.
  </para>
  <para style="p">
    <verse number="29" style="v" />Negeb ram ah Amalek mi an um; tlangram ah Hit mi le Jebus mi le Amor mi an um; cun rili pawng le Jordan tiva kam thluahmah ah Kanaan mi an um,” tiah an ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sihmanhsehlaw Kaleb nih mizapi cu Moses hmaiah a daihter hna i, “Khulrang in hung kal u sih law, hung umhnawh u sih; zeitintiah ṭha tein kan tei khawh ko lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cu tikah a sin i a kalmi hna nih khan, “Kan do kho hna lai lo, zeitintiah kanmah nakin an ṭhawng deuh,” tiah an ti.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cuticun an hung ngiatthlaimi ram kong cu a ṭhalo lei in Israel mi hna sinah an chim i, “Ngiatthlai awkah kan hung ṭolmi ram cu a chung i a ummi hna a eitu a si; cun cu ram chung i kan hmuhmi hna cu mi ngan pipi an si.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cuka ah cun Nefilim mi (Nefilim in a chuakmi Anak fapa hna kha) kan hmuh hna i kanmah le kanmah cu khaubawk bantuk ceo ah khin kan i hmu i annih sin zongah cu bantuk cu kan si ko,” tiah an ti.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun aa pummi vialte hna cu fak piin an ṭap i cu zan cu mi hna cu an ṭap dih.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun Israel mi vialte nih Moses le Aaron cu an zaihnawh hna; an bu ningin annih sinah, “Izipt ram ah khan rak thi u si law, a ṭha deuh hnga! Asiloah ramcar chungah hin hei thi dih ko u si law, a ṭha deuh hnga!
  </para>
  <para style="p">
    <verse number="3" style="v" />Zeicahdah Bawipa nih hi ram chungah hin vainam in thih awkah a kan luhpi hnga? Kan nupile hna le kan ngakchia hna hi tlaihkhih awk men an si lai; Izipt ah kir ṭhan u si law, kan caah a ṭha deuh hnga lo maw?” tiah an ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun pakhat le pakhat cu, “Hruaitu pakhat i thim u si law, Izipt ah kir ṭhan u sih,” tiah an i ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Moses le Aaron cu Israel mibu aa pummi hmaiah cun an bawk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun Nun fapa Joshua le Jefunneh fapa Kaleb, ram a hung ngia thlaitu hna lak i aa tel vemi hna nih khan an puan an thleh i,
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel mibu ningpi sinah khan, “Ngiatthlai awkah kan hung ṭolmi ram cu ram ṭha hringhran a si ko.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bawipa cu kan cungah aa lawmh ahcun hi ram chungah cun a kan luhpi lai i a kan pek lai, cawhnuk le khuaihliti in a luangmi ram a si ko.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bawipa cu a doh bel do sawh hlah u; cun cu rammi cu ṭih hna hlah u, zeitintiah kan caah rawl pei an si ko cu; annih an himnak cu an sinin ṭhial a si cang, Bawipa cu kanmah he pei a um cu, ṭih hna hlah u,” tiah an ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sihmanhsehlaw an bu ning piin, lung in cheh an zalh hna. Cun Bawipa sunparnak cu tonnak thlam ah khan Israel mi vialte sinah a lang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bawipa nih Moses cu, “Mah mi hna nih hin zei can dah an ka zawmhtaih lai? Cun zei can dah zum loin an ka um lai, anmah lak i hmelchunhnak mah vialte ka tuah ko ṭung?
  </para>
  <para style="p">
    <verse number="12" style="v" />Rai in ka hrem hna lai i ka hlawt hna lai, nangmah chung hin annih nak i a ngan deuh le a ṭhawng deuh miphun ka ser lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sihmanhsehlaw Moses nih Bawipa kha a chawnh i, “Cu ti a si ahcun, Izipt mi nih an theih lai i hi ram i a ummi hi an chimh hna lai,
  </para>
  <para style="p">
    <verse number="14" style="v" />zeitintiah hi miphun hi annih lakin na chuahpimi an si. Annih nih, maw Bawipa, nang cu hi hna lakah na um kha an theih; zeitintiah maw Bawipa, nang cu hmaitonh tein an in hmuh i na minmei nih an cungah a dir i nangmah nih an hmaiah na kal, chun ah minmei tung in, cun zan ah mei alh tung in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun mah mi hna hi mi pakhat men bantukin na thah hna ah cun, na minthannak a rak theimi miphun hna nih khan,
  </para>
  <para style="p">
    <verse number="16" style="v" />‘ Bawipa nih hi mi hna hi chiatser tein a kamhmi hna ram ah khan a luhpi khawh hna lo caah ramcar chungah a thah hna,’ an ti lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cucaah Bawipa, nangmah nih, ‘ Bawipa cu a thin a fual i a fekmi dawtnak tampi a ngei, ṭhat lonak le phung buarnak cu a ngaihthiam khawh, sihmanhsehlaw a sualmi cu zei ti hmanh in a luatter men lai lo; an pale ṭhat lonak cu an fale cungah a tlunter lai, chan thum chan li tiangin,’ ti i bia na rak kamnak a lianhngan tluk khan na ṭhawnnak cu lianngan ko seh tiah kan nawl.
  </para>
  <para style="p">
    <verse number="19" style="v" />A fekmi na dawtnak a ngan rup le hi mi hna cu Izipt ram in atu tiang na ngaihthiam hna bangin, hi mi hna an ṭhat lonak hi ngaithiam ko hna,” tiah a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Bawipa nih, “Nangmah bia bangin ka ngaihthiam hna,
  </para>
  <para style="p">
    <verse number="21" style="v" />sihmanhsehlaw biangai tein, keimah ka nun le vawlei cung vialte Bawipa sunparnak in a khah dih lai bantukin,
  </para>
  <para style="p">
    <verse number="22" style="v" />ahohmanh, Izipt ram chung le ramcar chung i ka tuahmi ka sunparnak le ka hmelchunhnak a hmu i, sihmanhsehlaw hi voi hra tiang a ka hneksak i ka aw a ngai lomi cu,
  </para>
  <para style="p">
    <verse number="23" style="v" />an pupa sin i kan pek hna lai ti i chiat ka sermi ram kha an hmu lai lo, ahohmanh a ka zawmtaimi nih cun an hmu lai lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sihmanhsehlaw ka sal Kaleb cu lungthin dang a ngei i tling tein a ka zulh caah, a va kalnak ram ah khan ka luhpi lai i a tefa hna nih an co lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kha, Amalek mi hna le Kanaan mi hna cu nelrawn chungah an um caah thaizing cu i mer u law, Rili Sen lam lei in ramcar ah kal tuah u,” tiah a ti.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun Bawipa nih Moses le Aaron sinah hitin a chim i,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Zei can dah hi a ṭha lomi bu nih hin an ka zaihnawh lai? Israel mi an phunzainak, keimah cung i an phunzainak cu ka theih cang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Annih sinah hi bangin va chim tuah, Bawipa nih, ‘Ka nun bangin, keimah theih hngan i nan chimmi cu nan cungah ka tuah lai:
  </para>
  <para style="p">
    <verse number="29" style="v" />Nan ruak hna cu ramcar chungah an um lai; cun nannih lak i rel ciami vialte, kum kul ri in a cunglei keimah cungah a phunzaimi vialte kha,
  </para>
  <para style="p">
    <verse number="30" style="v" />Jefunneh fapa Kaleb le Nun fapa Joshua dah ti lo cu, kan umter hna lai ti i chiat ka sermi ram ah khan pakhat hmanh nan lut lai lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sihmanhsehlaw nan ngakchia hna, annih cu tlaih khih awk men an si lai, nan timi hna kha ka luhpi hna lai i nannih nih zei i nan rel lomi ram kha an umhnawh lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sihmanhsehlaw nannih tu cu nan ruak cu hi ramcar ah hin an um lai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cun nan fale hna cu mah ramcar chungah hin kum sawm li tuukhal an si lai i nan ruak a hmanung bik cu hi ramcar chung i a ciam dih hlantiang zumhawktlak lo nan si caah khan sifah an in lai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ram kha nan hung ngiatthlai ni zat khan, ni sawm li, ni khat caah kum khat, nan ṭhat lonak kha nan in lai, kum sawm li, cun ka lunglawmh lonak kha zeidah a lawh ti kha nan hngalh lai,’ a ti.
  </para>
  <para style="p">
    <verse number="35" style="v" />Keimah, Bawipa, nih ka chim cang; keimah doh awkah aa pummi, hi miṭhalo hna hi an dihlak cungah mah hihi ka tuah hrimhrim lai: hi ramcar chungah hin an donghnak taktak cu an phan lai i khika ah khan an thi lai,” a ti.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cun Moses nih ram kha hung ngiatthlai awkah a thlah i a hung kir ṭhan i mi zapi vialte kha ram kong thawngchia an run phorhnak thawngin a cungah a zaitermi hna,
  </para>
  <para style="p">
    <verse number="37" style="v" />ram kong thawng ṭhalo a run phormi hna cu, Bawipa hmaiah rai in an thi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Sihmanhsehlaw Nun fapa Joshua le Jefunneh fapa Kaleb cu, ram ngiatthlai awkah a hung kalmi hna lakah khan, a nung in an tang.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cun Moses nih mah bia hna hi Israel mi vialte kha a chimh hna i an ngaih a chia ngaingai.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cun zingka tein an tho i tlangram a sannak ah an kai i, “Zohhmanh, mahka ah hin kan um hi, Bawipa biakammi hmun ah cun kan hung kal lai; zeitintiah kan sual cang,” tiah an ti.
  </para>
  <para style="p">
    <verse number="41" style="v" />Sihmanhsehlaw Moses nih, “Zeicaahdah atu ah Bawipa nawlbia kha nan buar, zeitintiah mah cucu santlai ding a si ṭung lo?
  </para>
  <para style="p">
    <verse number="42" style="v" />Hung kal hlah u, nan ral nih a thah lam an in thah sual hna lai, zeitintiah Bawipa cu nan sinah a um lo.
  </para>
  <para style="p">
    <verse number="43" style="v" />Zeitintiah khika ah Amalek mi le Kanaan mi hna cu nan hmaiah an um i vainam in nan tlu lai. Bawipa cu nan kirtak cang caah Bawipa nih nan sinah a um lai lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="44" style="v" />Sihmanhsehlaw Bawipa biakamnak kuang siseh, Moses siseh, riahhmun in an chuak lo nain, tlangram a sannak i hung kai cu an i tim ṭhiamṭhiam.
  </para>
  <para style="p">
    <verse number="45" style="v" />Cun cu tlangram i a ummi Amalek mi le Kanaan mi hna nih an rung ṭum i an rung tei hna i an dawi hna, Hormah tiangin.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi hna sinah hi bangin va chim tuah, Nannih nih nan umhnawh laimi ram nannih kan pekmi hna nan phak tik le,
  </para>
  <para style="p">
    <verse number="3" style="v" />Bawipa sinah tuurun in siseh, cawrun in siseh, mei in pekchanhnak maw, khangh pekchanhnak maw, raithawinak maw, biakamnak tlinternak maw, mah lungtho tein pekchanhnak caah maw, a caan khiahmi nan puai hna ah maw, Bawipa sinah rimthaw nan ser tikah,
  </para>
  <para style="p">
    <verse number="4" style="v" />cu tikah Bawipa sinah a pekchanhnak a petu paoh nih changvut pekchanhnak i changvut dip ephah cheu hra cheu khat, chiti hin cheu li cheu khat he cawhmi kha a pek lai;
  </para>
  <para style="p">
    <verse number="5" style="v" />cun khangh thawinak ah siseh, raithawinak ah siseh, tuufa pakhat cio caah mitsur hang hin cheu li cheu khat na timh lai, cucu thlet thawinak caah a si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun tuukawng a si ahcun, changvut thawinak caah changvut dip ephah cheu hra cheu hnih, chiti hin cheu thum cheu khat he cawhmi cu na timh lai i
  </para>
  <para style="p">
    <verse number="7" style="v" />thlet thawinak caah cun mitsur hang hin cheu thum cheu khat na pek lai, Bawipa caah rimthaw a si lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun khangh thawinak caah siseh, biakam tlinternak ca i raithawinak caah siseh, Bawipa sin i daihnak thawinak hna caah siseh cawtum na timh tikah,
  </para>
  <para style="p">
    <verse number="9" style="v" />cu tikah cu cawtum he cun changvut thawinak changvut dip ephah cheu hra cheu thum, chiti hin cheu he cawhmi cu, na pekchanh lai i,
  </para>
  <para style="p">
    <verse number="10" style="v" />thlet thawinak caah mitsur hang hin cheu, mei in pekchanhnak caah, na pek lai, Bawipa caah rimthaw a si lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Hi bangin cawtum siseh, tuukawng siseh, tuufa a pa siseh, meheh fa siseh, pakhat cio caah tuah a si lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nan timhmi hna an tam an tlawmning in, cu bantukin an tam an tlawmning in nan tuah lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mei in thawinak, Bawipa sin i rimthaw cu, pekchanh tikah, mah miphun a si taktakmi vialte nih hi thil hna hi, hi bangin an tuah lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun khual pakhatkhat nih an tlawn hna ah siseh, nan tefa chin tiangin mi pakhatkhat nan sinah a um ah siseh, cu pa nih cun mei in thawinak, Bawipa sin i rimthaw cu, pekchanh a duh ahcun nanmah tuah bangin a tuah ve lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hi mibu chungah, nannih caah le nannih an pemmi hna khual caah nawlbia pakhat a si lai, nan tefa chin tiangin a dong lo nawlbia a si lai. Bawipa hmaiah mipem zong cu nanmah bantuk an si ve lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nanmah le nan sin i a ummi phundang mi hna caah phungbia aa khat phunglam aa khat a si lai,” tiah a chimh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Israel mi sinah hitin va chim tuah, nannih kan kalpi hnanak ram chungah nan luh tikah,
  </para>
  <para style="p">
    <verse number="19" style="v" />cun cu ram rawl nan ei tikah, Bawipa sinah pekchanhnak nan tuah lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nan hmuh hmasa bikmi fang chungin pekchanhnak caah changreu hlum khat nan pek lai; phuhri chung i pekchanhmi bantukin nan pek lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nan hmuh hmasa bikmi fang chungin nan techin fapar tiangin Bawipa sinah pekchanhnak nan tuah lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Sihmanhsehlaw nan palh i Bawipa nih Moses sinah a chimmi nawlbia vialte,
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawipa nih nawlbia an pek ni hna thawk khan nan tefa chin tiang ca in Bawipa nih Moses in nawl an pekmi vialte hna cu nan ulh lo i
  </para>
  <para style="p">
    <verse number="24" style="v" />mibu nih hngalh loin tuah sual a si ahcun, a pummi vialte nih khangh thawinak, Bawipa sin i rimthaw caah cawtum no pakhat nan pek lai; a phunglam ningin a changvut thawinak le a thlet thawinak he, cun meheh a pa pakhat sual thawinak caah nan pek lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Palhnak a si ca i Bawipa sinah mei in thawinak le Bawipa hmaiah an sual thawinak, an palhnak caah an rak put cang caah, tlangbawi nih Israel mibu ningpi caah cun remnak a ser lai i ngaihthiam an si lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun Israel mi cu an bu ningin ngaihthiam an si lai, anmah lak i a pemmi khual zong, zeicahtiah cu palhnak ah cun an zapi in an i tel dih.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Mi pakhatkhat nih hngalh loin a sual sual ahcun, sual thawinak caah meheh a nu kum khat a timi a pekchanh lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cun tlangbawi nih, palhnak a tuahmi caah khan Bawipa hmaiah remnak a ser lai; cu pa nih hngalh loin a sual tikah remnak a serpiak lai i ngaihthiam a si lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hngalh loin palhnak a tuahmi caah phungbia pakhat lawnglawng nan ngei lai, amah cu Israel mi taktak a si ah siseh, an lak i a pemmi khual a si ah siseh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sihmanhsehlaw ahohmanh nih, Israel mi taktak a si ah siseh, mipem a si ah siseh, lungpuam in sualnak a tuah ahcun, Bawipa kha a thangchiat a si, cu pa cu a mi hna lakin hlonh a si lai.
  </para>
  <para style="p">
    <verse number="31" style="v" />Bawipa bia kha a nautat caah le a nawlbia kha a buar caah cu pa cu hlonh hrimhrim a si lai; a ṭhat lonak cu amah cungah a si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel mi hna cu ramlak ah an um lioah khan sabbath ni ah thing a khawmmi pakhat an hmuh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cun thing a khawmh lio a hmutu hna nih khan Moses le Aaron le a pummi vialte sinah khan an ratpi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thong ah an thlak, zeicahtiah a cungah zeidah tuah awk a si lai ti kha a fiang rih lo.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cun Bawipa nih Moses cu a chawnh i, “Mipa cu thah a si lai; a pummi vialte nih riahhmun lengah lung in an cheh lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cun a pummi vialte nih riahhmun lengah an chuahpi i Bawipa nih Moses nawl a pek bangin lung in thi lakin an cheh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="38" style="v" />“Israel mi hna sinah hi bangin va chim law, an puan ki ah a hmumbor serter hna, an tefa chin tiangin, cun a ki kip i a hmumbor cu la dum in thlaih hna seh;
  </para>
  <para style="p">
    <verse number="39" style="v" />cun nannih nih hmumbor kha nan zoh lai i Bawipa nawlbia vialte kha tuah awkah nan hngalh ṭhan lai, i sum loin zulh nan duh tawnmi nanmah nan lung duhnak le mit duhnak kha nan zul ti lai lo.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cucaah nannih nih ka nawlbia vialte cu nan hngalh camcin lai i nan tuah lai i nan Pathian sinah nan thiang lai.
  </para>
  <para style="p">
    <verse number="41" style="v" />Nan Pathian si awkah Izipt ram in an chuahpitu hna Bawipa nan Pathian cu ka si: keimah cu Bawipa nan Pathian ka si,” tiah a ti.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Levi fapa Kohath i fapa Izhar i fapa Korah le, Reuben fapa Eliab i fapa hna Dathan le Abiram le, Reuben fapa Peleth i fapa On nih
  </para>
  <para style="p">
    <verse number="2" style="v" />mi kha an pumh hna; Israel mi za hnih le sawm nga, mizapi hruaitu a simi hna, aa pummi chungin thimmi, mi minthang deuhdeuh hna he khan Moses cu an va chuahhnawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Moses le Aaron kha an pumhhnawh hna i annih cu, “Nan luan cang! Mi zapi cu an thiang cio ko i Bawipa cu an lakah a um ve ko. A si kun ahcun zeicahdah Bawipa mibu cungah cun nan i hlorh?” tiah an ti hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moses nih a theih tikah a bawk i
  </para>
  <para style="p">
    <verse number="5" style="v" />Korah le a hawile vialte cu, “Zinglei ah Bawipa nih ahodah amah ta a si i ahodah a thiang ti kha a langhter lai i a pawngah a ratter lai. Amah nih a thimmi cu amah naih ah a ratter lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mah hihi tuah u, Korah le a hawile vialte hna:
  </para>
  <para style="p">
    <verse number="7" style="v" />mei laknak kheng hna kha i lak u law, thaizing ah an chungah mei chia u law, an cungah Bawipa hmaiah zihmui chia u, Bawipa nih a thimmi cu a thiangmi cu a si lai. Levi fapa hna, nan luan cang!” tiah a ti hna.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Moses nih Korah cu a chawnh i, “Levi fapa hna, ngai tuah u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel Pathian nih nannih cu Israel mibu hna chungin amah sin naih i umter awk, Bawipa puan biakinn chung i rianṭuan awk le aa pummi hmai i dir i an rianṭuan awkah an thleidan hna hi nannih caah a hme tukmi thil maw a si?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah naih ah nanmah le nan unau Levi fapale hna cu nanmah he an kalpi hna hi, thil tetuai maw a si? Tlangbawi rian zong nan banh rih lai maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Cucaah nangmah le na hawile vialte nih nan pumhhnawhmi cu Bawipa pei a si tiah; Aaron cu mi zeidah a si, a cung i nan phunzai hi?” tiah a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun Moses nih Eliab fapa Dathan le Abiram kha auh awkah mi a thlah hna i, annih nih, “Kan hung lai lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ramcar chung i kannih kha thah awkah cawhnuk le khuaihliti in a luangmi ram in na kan chuahpi hi, thil hme tuai a si maw, kannih cung i bawi i naa ser zong hi?
  </para>
  <para style="p">
    <verse number="14" style="v" />Cu hleiah cawhnuk le khuaihliti in a luangmi ram ah na kan luhpi fawn ṭung lo, mitsur dum zong ro caah na kan pe fawn lo. Mah mi hna hi an mit na khoih hna lai maw? Kan hung lai lo” tiah an ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun Moses cu a thin a hung ngai-ngai i Bawipa sinah, “An pekchanhnak cu hmaizah hlah. Annih sinin laa pakhat hmanh ka la lo i annih kha pakhat hmanh ka fahter hna lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun Moses nih Korah cu, “Thaizing ah nangmah le na hawile vialte, nangmah le annih le Aaron cu, Bawipa hmaiah hung chuak tuah u.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nannih nih nan meilaknak cio kha nan i lak lai i an cungah zihmui nan chiah cio hna lai i Bawipa hmaiah nan meilaknak cio cu nan chuahpi lai, meilaknak za hnih le sawm nga cu; nangmah zong Aaron zong nan meilaknak veve he nan chuak lai, a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cu caah an meilaknak cio cu an i lak i an chungah mei an chiah i zihmui an phulh hna i tonnak thlam innka ah cun Moses le Aaron he tiah an dir.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun Korah nih mi zapi vialte cu tonnak thlam innka ah cun a pumhter hna i, Bawipa sunparnak cu mizapi vialte sinah cun a lang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Bawipa nih Moses le Aaron cu,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hi aa pummi hna sin hin i ṭhen u, chikkhatte ah ka khangh dih khawh hna nakhnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun an bawk i, “Maw Pathian, titsa vialte i thlarau hna Pathian, mi pakhat nih a sual caah, nangmah cu mi zapi vialte cungah hin na thin a hung lai maw?” tiah an ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Mi zapi sinah, Korah le Dathan le Abiram umnak pawngkam in va ṭian u, tiah va chim hna,” tiah a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Moses cu a tho i Dathan le Abiram sinah a kal i Israel mi upa hna nih khan an zulh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun aa pummi hna sinah cun, “Hi miṭhalo hna thlam hna hin ṭian u, tiah kan nawl hna, cun an thil zong zeihmanh tawng hlah u, an sualnak chungah fenh chih nan si sual lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cucaah Korah, Dathan, le Abiram hna umnak pawngkam khan an ṭian i Dathan le Abiram cu an nupile he, an fapale he, an ngakchiale he tiah, an ra chuak i an thlam innka ah cun an dir.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cun Moses nih, “Keimah thinlung i a chuak chom in si loin, Bawipa nih pei mah rianṭuan awkah hin a ka thlah tiah ti kha mah hi hin nannih nih nan hngalh lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mah hna hi mi vialte thih kel cio ah an thih le mi vialte sifah in kel cio an in ve a si ahcun, cu ti a si ahcun Bawipa nih a ka thlah lo a si lai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sihmanhsehlaw, Bawipa nih thil thar zeimaw a ser i vawlei nih a kaa a an i an ngeihmi thil vialte he a dolh hna i Sheol ah a nung in an vung kal ahcun, cu tikah cun nannih nih mah hna nih hin Bawipa kha an zawmhtaih tiah nan hngalh lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hi bia vialte a chim dih tikah, an tang vawlei cu a kak i
  </para>
  <para style="p">
    <verse number="32" style="v" />vawlei nih a kaa a an i anmah le an innchungkhar hna le Korah mi vialte le an thilri vialte kha a dolh dih hna.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cu caah annih le anmah ta a simi vialte cu Sheol ah a nung in an vung tla i vawlei nih a khuh hna i aa pummi chung cun an thi dih.
  </para>
  <para style="p">
    <verse number="34" style="v" />An ai thawng cun an pawngkam ah a ummi Israel mi vialte hna cu an zam i, “Vawlei nih kannih zong a kan dolh ve sual lai!” tiah an ti.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cun Bawipa sinin mei a chuak i zihmui a pechan liomi minung za hnih le sawm nga kha a kangh dih hna.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="37" style="v" />“Tlangbawi Aaron fapa Eleazar kha, meialh chungin meilaknak kha la hna law, mei cu thai dih tuah.
  </para>
  <para style="p">
    <verse number="38" style="v" />Sualnak ruang i nunnak a hlomi hna meilaknak hna kha cu an thian caah, cucaah biakṭheng khuhnak ca i denmi kheng ah serter hna, zeitintiah Bawipa hmaiah an pekchanh hna; cucaah an thiang. Cu bangin Israel mi caah hmelchunhnak an si lai, tiah chim tuah,” tiah a ti.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cucaah tlangbawi Eleazar nih, mei nih a kanghmi hna nih an pekchanhmi dar meilaknak hna cu a lak i biakṭheng khuhnak caah cun an den hna.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cun tlangbawi a si lo i Aaron tefa a si lomi ahohmanh nih Bawipa hmai i zihmui khangh awkah an ra naih nakhnga lo, Israel mi hna caah mah cucu hngalhtertu a si lai, Korah le a hawile hna bang khan an si sual ve nakhnga lo — Bawipa nih Moses in Eleazar sinah a chim bangin.
  </para>
  <para style="p">
    <verse number="41" style="v" />Sihmanhsehlaw a thaizing ah Israel mi nih an bu ningin Moses le Aaron cungah an zai i, “ Bawipa mi kha nan thah hna,” tiah an ti.
  </para>
  <para style="p">
    <verse number="42" style="v" />Cun mibu nih khan Moses le Aaron cu an pumhhnawh hna tikah, tonnak thlam lei kha an hoih i, zohhmanh, minmei nih a khuh i Bawipa sunparnak kha a lang.
  </para>
  <para style="p">
    <verse number="43" style="v" />Cun Moses le Aaron nih tonnak thlam hmailei ah khan an ra i
  </para>
  <para style="p">
    <verse number="44" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Hi mibu chung hin va chuak tuah u, chikkhatte ah ka khangh dih hna nakhnga,” tiah a ti. Cun an bawk.
  </para>
  <para style="p">
    <verse number="46" style="v" />Cun Moses nih Aaron sinah, “Na meilaknak kha i lak law, biakṭheng cung mei kha a chungah chia tuah, zihmui phulh law, zokzok tein mibu sinah kalpi law, annih caah remnak serpiak hna; zeitintiah thinhunnak cu Bawipa sinin a chuak cang i rai kha a tlung cang,” tiah a ti.
  </para>
  <para style="p">
    <verse number="47" style="v" />Moses nih a chim bangin Aaron nih a lak i aa pummi hna chungah khan a le; cun, zohhmanh, mi hna lakah khan rai cu tlun hram a rak thawk cang; cun zihmui kha a phulh i mi kha remnak a serpiak hna.
  </para>
  <para style="p">
    <verse number="48" style="v" />Cun a thimi le a nungmi karlak ah a dir i rai cu a ṭian.
  </para>
  <para style="p">
    <verse number="49" style="v" />Cun Korah kongah a thimi hleiah, rai in a thimi cu sang khat thong li le za sarih an si.
  </para>
  <para style="p">
    <verse number="50" style="v" />Cun rai kha a ṭian tikah, Aaron cu Moses sinah tonnak thlam innka ah khan a kir ṭhan.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi cu va chim hna law, annih sinin ṭhiangṭhunh, phun khat caah pakhat in, an phun ning cio ah an hruaitu hna sin cio ah, ṭhiangṭhunh hleihnih va la hna. An min cio cu an ṭhiangṭhunh cio ah na ṭial hna lai i
  </para>
  <para style="p">
    <verse number="3" style="v" />Levi ṭhiangṭhunh cungah cun Aaron min na ṭial lai. Zeitintiah, phun khat lu cio caah khan ṭhangṭhunh pakhat a si lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun, tonnak thlam chung hngalhternak hmai nangmah kan tonnak hmun ah khan na chiah hna lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun ka thimmipa i a ṭhiangṭhunh cu a corh lai; cu bangin Israel mi hna phunzainak, nangmah cung i an phunzainak cu, ka sinin ka daihter lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moses nih Israel mi cu a chimh hna i an hruaitu vialte nih ṭhiangṭhunh cu an pek, hruaitu pakhat caah pakhat, an phun cio ning in, ṭhiangṭhunh hleihnih; Aaron ṭhiangṭhunh cu an ṭhiangṭhunh hna lakah a tel ve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun Moses nih hngalhternak thlam chungah khan Bawipa hmaiah ṭhiangṭhunh cu a chiah hna.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun, a thaizing ah Moses nih hngalhternak thlam chungah a lut i zohhmanh, Levi phun ca i Aaron ṭhiangṭhunh cu a rak corh i a kuhkulul an chuak i an par i almond thei a hminmi an rak tlai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Moses nih Bawipa hmaika cun ṭhiangṭhunh vialte cu Israel mi vialte hna sinah a rak chuahpi hna i an zoh i an ṭhiangṭhunh cio kha an i lak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Bawipa nih Moses cu, “Aaron ṭhiangṭhunh cu hngalhternak hmaiah khan va chia ṭhan law, ralchanh hmangmi hna caah hmelchunhnak caah chiah a si lai i keimah cungah an phunzainak cu na donghter lai, an thi sual ai hnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cu bangin Moses nih a tuah; Bawipa nih nawl a pek bang khan a tuah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun Israel mi hna nih Moses sinah, “Zohhmanh, kan lo dih ai, kan rawk dih ai, kan rawk dih cikcek ko hi ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />A ra naihmi paoh cu, Bawipa puan biakinn a ra naihmi paoh cu, an thi lai. Kan dihlak in kan thi ko lai maw?” tiah an ti.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cucaah Bawipa nih Aaron cu a chawnh i, “Nangmah le na fapale hna le na phunhawi hna nih hmunthiang he a pehtlai in ṭhat lonak cu nan in lai; cun nangmah le na fapale hna nih tlangbawi nan sinak he aa pehtlai in ṭhat lonak cu nan in lai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun nangmah sinah na unau hna, Levi phun, na pa phun kha, ratpi hna law, nangmah kha an in fonh lai i nangmah he a ummi na fapa hna le nangmah cu hngalhternak thlam hmaiah nan um lioah an in bawmh hna lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nangmah kha an in bultawl lai i thlam rian vialte zong kha an bultawl lai; sihmanhsehlaw hmunthiang umkheng si hna seh, biakṭheng siseh, an naih lai lo, anmah le nangmah zong nan thi sual hnga.
  </para>
  <para style="p">
    <verse number="4" style="v" />An in fonh lai i tonnak thlam cu thlam chung rian vialte ah an bultawl lai; cun a dang ahohmanh nan pawngah an ra lai lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun nannih nih hmunthiang rian le biakṭheng rian cu nan bultawl lai, Israel mi cungah thinhunnak a um ti nakhnga lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun zohhmanh, nan unau Levi mi hna cu Israel mi hna chungin ka lak cang hna; annih cu tonnak thlam rianṭuan awk i Bawipa sin le nan sin i pekmi laksawng an si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun nangmah le na fale hna nih biakṭheng le puanzar chung i a ummi thil he aa pehtlaimi vialte ah nan tlangbawi rian cu nan ṭuan lai; nannih nih nan bultawi lai. Nan tlangbawi rian hi laksawng ah kan pek hna; midang ahohmanh a pawngah a rami paoh cu thah a si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Bawipa nih Aaron cu, “Zoh-hmanh, keimah sin i pekchanhmi thil hna chungin khangh lomi paoh cu nangmah kan pek, Israel mi hna an thil thiang vialte cu; mah thil hna cu na vo ah nangmah kan pek i an hmuh camcin awkah na fapale kha ka pek hna.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mei i khangh hlei thil thiang bik hna chungin mah hihi na ta an si lai: an pekchanhmi paohpaoh, an changvut thawinak paohpaoh, an sual thawinak paohpaoh le an phungbuar thawinak paohpaoh keimah an ka pekmi cu nangmah le na fapale hna caah thil thiang bik an si lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmun thiang bik ah nan ei lai; pa paohpaoh nih an ei lai; na caah thil thiang a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mah zong hi na ta a si lai, an laksawng an pekchanhmi, Israel mi hna hninh thawinak vialte cu; mah hna hi nangmah le na fapa hna le na fanu hna sinah nan hmuh camcin awkah kan pek cang hna; na inn chung i a thiangmi paoh nih an ei khawh lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chiti lakah a ṭha bik le mitsur hang le tirawl lakah a ṭha bik, Bawipa sinah an pekmi thei tlaiter hna cu, nangmah kan pek.
  </para>
  <para style="p">
    <verse number="13" style="v" />An lo chung i theitlai a hmin hmasa bik, Bawipa sin i an rak putmi hna cu, na ta an si lai; na inn chung i a thiangmi paoh nih an ei khawh lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel mi hna chungah ulh amhmi thil paohpaoh cu na ta a si lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bawipa sinah an pekchanhmi fater paohpaoh cu, minung siseh saram siseh, nangmah ta an si lai; asinain, minung fater le a thiang lomi saram fater hna cu na tlanh hna lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun an tlanhnak man cu (thla khat an ti tikah na tlanh hna lai) gerah pakul a simi hmunthiang shekel ningin ngun shekel panga ah na khiah lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sihmanhsehlaw caw fater siseh, tuu fater siseh, meheh fater siseh, na tlan hna lai lo; annih cu an thiang. An thi cu biakṭheng cungah na theh lai i an thau cu mei in thawinak caah, Bawipa ca i rimthaw ah, na khangh lai;
  </para>
  <para style="p">
    <verse number="18" style="v" />sihmanhsehlaw an sa cu nangmah ta a si lai, hninhmi ii le orhlei phei cu na ta an si bantuk khan.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel mi nih Bawipa sinah an pekmi a thiangmi pekchanhnak vialte cu nangmah le na fapa hna le na fanu hna he nan hmuh camcin awkah kan pek; nangmah le na tefa hna caah cite in biakamnak Bawipa hmaiah a si zungzal lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Bawipa nih Aaron cu, “An ram chungah ro na ngei lai lo, annih lakah covo zong na ngei lai lo, keimah cu Israel mi hna lakah na vo le na ro ka si.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Levi mi cu tonnak thlam chung i an rian, cu rianṭuan man ah cun Israel mi hna lak i cheu hra cheu khat cu ro caah ka pek hna.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun atu thawk in Israel mi hna cu tonnak thlam pawngah an ra ti lai lo, an sualnak mawh phor in an thi sual hnga.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sihmanhsehlaw Levi mi nih tonnak thlam rian cu an ṭuan lai i palhnak a um ahcun anmah nih an in lai; nan tefa chin tiangin mah hihi nawlbia a si camcin lai; Israel mi hna lakah ro cu an ngei lai lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeitintiah Israel mi hna nih Bawipa sinah pekchanhnak ca i an pekmi cheu hra cheu khat cu Levi mi hna kha ro ah ka pek cang hna; cucaah Israel mi hna lakah ro an ngei lai lo, tiah ka rak ti kha,” tiah a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Cu hleiah, hi bangin Levi mi cu na chimh hna lai, ‘Israel mi hna sinin cheu hra cheu khat nan ro caah kan pekmi hna cu nan lak tikah, cu chung cun Bawipa sinah pekchanhnak nan pek lai, cheu hra cheu khat cungin cheu hra cheu khat kha.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun nan pekchanhnak cu phuhri i rawl le mitsur hang nennak mitsur hang bantuk ah relpiak nan si lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cucaah Israel mi hna sinin nan hmuhmi cheu hra cheu khat vialte chungin nanmah zong nih Bawipa sinah pekchanhnak nan tuah lai; Bawipa sin pekchanhmi cu tlangbawi Aaron kha nan pek lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Laksawng nan hmuhmi vialte chungin, a ṭha bik a thiang bik hna, Bawipa sinah pekchanh awk a simi hna cu, nan pek lai.’
  </para>
  <para style="p">
    <verse number="30" style="v" />Cucaah annih sinah hi bangin na chim lai, ‘A ṭha bik kha nan pekchanh dih in, a tangmi cu Levi mi hna caah phuhri in a chuakmi rawl le mitsur nennak chung chuakmi mitsur hang ah rel a si lai i,
  </para>
  <para style="p">
    <verse number="31" style="v" />nanmah le nan innchungkhar hna nih khuazeika hmanh ah nan ei khawh lai. Zeitintiah tonnak thlam chung i nan rianṭuan man a si.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ṭha bikmi cu nan pekchanh tikah, sualnak mawhnak cu nan phor lai lo. Cun Israel mi hna thil thiang cu nan thurhhnawmh lai lo, nan thi sual hnga,” tiah a ti.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Bawipa nih Moses le Aaron cu a chawnh hna i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mah hihi Bawipa pekmi phungbia i a nawlbia cu a si: Israel mi kha nannih sinah cawla sen, soi awk zeihmanh a ngei lo i do a tlami, hngawngkual hlinh bal lomi cu, rak pu hna seh tiah chim hna u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun tlangbawi Eleazar cu nan pek lai i riahhmun lengah an hruai lai i amah hmaiah an thah lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun tlangbawi Eleazar nih a thi kha a kutdong in tlawmpal a lak lai i cu thi chung cun tlawmpal in tonnak thlam hmailei cu voi sarih a theh lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun cawla cu amah mithmuh ah an khangh lai; a phaw le a sa le a thi cu a ek he khangh a si lai i
  </para>
  <para style="p">
    <verse number="6" style="v" />tlangbawi nih cun sidar thing le husop le thil sen kha a lak hna lai i cawla khanghnak mei chungah cun a paih hna lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun tlangbawi nih a hnipuan kha a suk hna lai, a pum cu ti in aa kholh lai i cu hnuah riahhmun chungah cun a ra lut lai. Cun tlangbawi cu zanlei tiang thianglo a si lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cawla a khangmipa nih a hnipuan cu ti in a suk hna lai i a pum cu ti in aa kholh lai i zanlei tiang thianglo a si lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun a thiangmi pa nih cawla vutcam kha a ruh lai i riahhmun lengah hmun thiang pakhat ah a chiah lai; cun Israel mibu hna sual tlenghnak, i thianhnak ti caah, an chiah lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun vutcam a ruttupa nih khan a hnipuan a suk hna lai i zanlei tiang thianglo a si lai. Mah hihi Israel mi ca le an sin i a pemmi khual caah nawlbia a si camcin lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Miruak zeipaoh a tawngtu cu ni sarih chung thianglo a si lai;
  </para>
  <para style="p">
    <verse number="12" style="v" />ni thumnak ni le ni sarihnak ni ah i thianhnak ti khan aa thianh lai i cu bangin a thiang lai; sihmanhsehlaw ni thumnak ni le ni sarihnak ni ah aa thianh lo ahcun a thiang lai lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahohmanh nih mithi aho ruak hmanh siseh, a tawngh i aa thianh lo ahcun, Bawipa puan biakinn kha a thurter; cu pa cu Israel mi sinin hlonh awk a si lai; thianhnak ti kha a cungah theh a si lo caah amah cu thianglo a si lai; a thian lonak cu a cungah a tang rih.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Mah hihi mi pakhatkhat nih thlam chungah a thih tik i phungbia a si: thlam chungah a lutmi paoh le thlam chungah a ummi paoh cu ni sarih thianglo an si lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun aa hungmi um, a chin chinh lomi paoh cu, thianglo a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahohmanh nih lo i a um lioah nam in thahmi siseh, miruak siseh, miruh siseh, thlan siseh a tawngh ahcun ni sarih thianglo a si lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />A thiang lomi caah cun khanghmi sual thawinak vutcam kha tlawmpal in an lak lai i ti luangmi tlawmpal he um chungah an rawn lai;
  </para>
  <para style="p">
    <verse number="18" style="v" />cun a thiangmi pakhatkhat nih husop kha a lak lai i ti chungah cun a hnim lai i thlam le a thilri vialte le cuka i a ummi hna le, ruh siseh, thahmi siseh, mithi siseh, thlan siseh, a tawngmi pa cungah cun a theh lai;
  </para>
  <para style="p">
    <verse number="19" style="v" />cun a thiangmi pa nih a thiang lomi cu ni thumnak ni le ni sarihnak ni ah a theh lai; cu bangin ni sarihnak ni ah khan a tlengh lai i a hnipuan a suk hna lai i ti in a kholh lai i zanlei ah a thiang lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Sihmanhsehlaw thianglo a si i aa tleng lomi cu, cu mi cu aa pummi hna lakin hlonh a si lai, Bawipa hmunthiang kha a thurhhnawmhter caah; thianhnak ti kha a cungah theh a si lo caah amah cu thianglo a si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun mah hihi annih caah nawlbia a si camcin lai. Tlenghnak ti a thehtu nih khan a hnipuan a suk lai; cun tlenghnak ti a tawngmi kha zanlei tiang thianglo a si lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun a thiang lomi nih a tawnghmi thil paoh kha thianglo a si lai i, cu thil a tawngmi paoh cu zanlei tiang thianglo a si lai,” tiah a ti.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Israel mi hna cu, an bu ningin, thla khatnak thla ah Zin ramlak ah an lut i Kadesh ah an um; cu ka ah Miriam cu a thi i cu ka ah cun an vui.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun cu mibu caah cun ti a um lo i Moses le Aaron cu an pumhhnawh hna.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun mi nih Moses cu bia an chuah i, “Kan unau hna Bawipa hmai i an rak thih ah khan zeicahdik kan rak thih ve ko lo!
  </para>
  <para style="p">
    <verse number="4" style="v" />Zeicaahdah Bawipa mibu cu ramlak ah hin na kan luhpi i hika ah hin kanmah he kan saṭil he kan thih ko lai?
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun zeicaahdah hi hmun ṭhalo i phakpi awkah Izipt ram in na kan chuahter? Mah hmun hi rawl siseh, theipi siseh, mitsur ruang siseh, taleti siseh a umnak a si lo i din awk ti zong a um fawn lo,” an ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun Moses le Aaron cu aa pummi bu sin cun tonnak thlam innka ah an kal i an bawk. Cun Bawipa sunparnak cu an sinah a lang i,
  </para>
  <para style="p">
    <verse number="7" style="v" />Bawipa nih Moses sinah cun,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ṭhiangṭhunh kha i lak law, mibu kha pum tuah hna, nangmah he na u Aaron he, cun lungpi kha a ti chuahter dingin an hmaiah chim; cu bangin lungpi chungin an caah ti na chuahter lai; cu bangin mibu le an saṭil cu din awk na pek hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moses nih Bawipa hmai i ṭhiangṭhunh cu nawl a pek bang khan a lak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Moses le Aaron nih mibu cu hmunkhat ah lungpi hmaiah cun an pumh hna i annih sinah, “Nannih ralchanh hmangmi hna, ngai tuah u; hi lungpi chung hin nan caah ti kan chuahter lai maw?” tiah a ti.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun Moses nih a kut a hler i lungpi cu a ṭhiangṭhunh khan voi hnih a tuk i ti tampi a chuak i mibu le an saṭil nih an din.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun Bawipa nih Moses le Aaron cu, “Nan ka zumh lo i Israel mi hna mithmuh ah nan ka thianter lo caah, cucaah nannih nih cun hi mirun hi ka pekmi hna ram chungah nan luhpi hna lai lo,” tiah a ti hna.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mah hihi Meribah ti cu an si, Israel mi hna nih Bawipa cu bia an chuah i annih lak i a thiannak a langhternak hmun kha, a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Moses nih Kadesh in Edom siangpahrang sinah lamkal a hei thlah hna i, “Hi bangin nan unau Israel mi nih an ti: Kan cung i vanchiatnak a tlungmi vialte cu na hngalh ko:
  </para>
  <para style="p">
    <verse number="15" style="v" />kan pupa nih Izipt ram ah an vung kal i Izipt ram ah saupi kan um i Izipt mi hna nih fak piin kanmah le kan pupa hna kha an kan hrem;
  </para>
  <para style="p">
    <verse number="16" style="v" />cun kannih nih Bawipa kha kan auh tikah kan aw kha a theih i vancungmi pakhat a run thlah i Izipt ram in a kan chuahpi; atu cu hika ah hin na ramri i a ummi Kadesh khua ah kan um.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cucaah na ram hi kan tanter ko sawh. Lo siseh mitsur dum siseh kan tanpah hna lai lo, tikhor ti zong kan ding lai lo; Siangpahrang Lampi kha kan zulh lai i orhlei ah siseh kehlei ah siseh kan i mer lai lo, na ram kan tan dih hlantiang cu,” tiah a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sihmanhsehlaw Edom nih, “Na lan kho hnga lo, vainam he kan chuahhnawh sual hnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun Israel mi hna nih amah cu, “Lampi kha kan zul ko lai i kanmah le kan saṭil nih na ti kan din ahcun a man kan in pek lai; ke in a lanh lawng kan lanhter ko, thil dang zeihmanh kan ti lai lo,” tiah an ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sihmanhsehlaw anih nih, “Na lan kho hnga lo,” tiah a ti. Cun Edom nih mi tampi le a ṭhawngmi ralkapbu he a chuahhnawh hna.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cu bangin Edom nih Israel cu a ram chung i lanh kha a thlauh; cu caah Israel nih amah kha a hrial.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun Kadesh in Israel mi hna cu an bu ning piin an chuak i Hor Tlang kha an phan.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawipa nih Moses le Aaron cu, Edom ramri ah a ummi Hor Tlang ah khan a chawnh hna i,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Aaron cu a mi hna sinah pumh a si cang lai; Meribah ti ah khan ka nawlbia nan doh caah, Israel mi hna ka pekmi ram ah khan a lut lai lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aaron le a fapa Eleazar cu la hna law, Hor Tlang ah hunpi hna law,
  </para>
  <para style="p">
    <verse number="26" style="v" />Aaron cu a puan phoih hna law, a fapa Eleazar kha hruk hna; cun Aaron cu a mi hna sinah pumh a si cang lai i khika ah a thi lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bawipa nih nawl a pek bangin Moses nih a tuah i mibu vialte mithmuh ah Hor Tlang ah cun an hung kai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cun Moses nih Aaron cu a puan kha a phoih hna i a fapa Eleazar kha a hrukter hna. Khika ah tlangpar ah cun Aaron cu a thi. Cun Moses le Eleazar cu tlang cungin an rung ṭum.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mibu nih an dihlak in Aaron kha a thi cang ti an hngalh tikah, Israel innchungkhar vialte nih Aaron cu ni sawm thum a zuun an ngaih.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kanaan miphun Arad ram siangpahrang, Negeb i a ummi nih Israel mi hna cu Atharim lam in an ra ti kha a theih tikah, Israel cu a doh i tlawmpal cu sal ah a tlaih hna.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun Israel mi nih Bawipa sinah biakamnak an ser i, “Hi mi hna cu kan kut chungah na kan pek ahcun, an khua kha kan hrawh cikcek hna lai,” tiah an ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun Bawipa nih Israel mi hna aw cu a ngaih i Kanaan mi hna cu an kut ah a pek hna; anmah le an khua hna cu an hrawh cikcek hna; cucaah cuka hmun cu Hormah tiah ti a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hor Tlang in, Edom ram kha hrial awkah Rili Sen lam kha an tlaih i lam ah mi hna cu an ing a puang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun mi hna nih cun Pathian le Moses kha an zaihnawh hna i, “Zeicaahdah ramlak i thih awkah hin Izipt ram in nan kan chuahpi? Zeitintiah rawl a um lo, ti a um lo i, hi rawl ṭhalo hi cu kan fih,” tiah an ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khi tikah Bawipa nih meirul kha mi lakah cun a thlah hna i mi kha an cuk hna caah Israel mi tampi an thi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun annih nih Moses sinah an ra i, “ Bawipa le nangmah kha kan in mawhchiat hna caah kan sual cang; kannih sinin rul kha a lak hna nakhnga, Bawipa sinah thlacam tuah,” tiah an ti. Cucaah Moses nih annih caah thla a cam.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Bawipa nih Moses cu, “Meirul pakhat in ser law, tung cungah tar tuah; rul cukmi paoh nih an zoh tikah an nung lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cucaah Moses nih dar rul pakhat a ser i tung cungah a tar; cun, rul nih pakhatkhat a cuk hna tikah, dar rul cu an zoh ahcun an nung.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Israel mi hna cu an i thawh i Oboth ah an riak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun Oboth in an i thawh i Moab ral, nichuahlei i a ummi ramlak chung i Iyeabarim ah an riak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cuka cun an tho ṭhan i Zered Nelrawn ah an riak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cuka cun an tho i Arnon tiva khattelei ral ah an riak; mah hmun cu Amor mi hna ramri in aa thawkmi ramlak chungah a si, zeitintiah Arnon tiva cu Moab ramri a si, Moab le Amor mi hna karlak ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cucaah Bawipa Raldohnak Cauk chungah hi bangin an ti. “Sufah i Waheb le Arnon nel hna le
  </para>
  <para style="p">
    <verse number="15" style="v" />Ar khua umnak tiang a phan i Moab ramri tiang a ṭum mi Nel hna tlangpang cu,”
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun cuka cun Beer tiang an kal; mah cucu Bawipa nih Moses sinah, “Mi kha hmunkhat ah pum hna law, ti ka pek hna lai,” tiah a timi tikhor kha a si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cu tikah Israel nih mah hla hi an sa: “Maw tikhor, ti hung chuak tuah! Hla in hloi tuah u!
  </para>
  <para style="p">
    <verse number="18" style="v" />Bawi nih an cawhmi tikhor, Mi hna lak i milian nih An bawifung le an ṭhiangṭhunh in An cawhmi tikhor cu.” Cun ramlak cun Mattanah tiang an kal i,
  </para>
  <para style="p">
    <verse number="19" style="v" />Mattanah in Nahaliel tiang, cun Nahaliel in Bamoth tiang,
  </para>
  <para style="p">
    <verse number="20" style="v" />cun Bamoth in Moab ram chung i a ummi nelrawn tiang an kal; cu nelrawn cu thetse rawn a vun zohtu Pisgah tlangpar pawngah a um.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun Israel nih Amor mi siangpahrang Sihon sinah lamkaltu an thlah hna i,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Na ram kan tanter tuah; lo ah siseh, mitsur dum ah siseh kan pial pah lai lo; tikhor ti zong kan ding lai lo; na ram chungin kan chuah hlantiang Siangpahrang Lampi kan zul ko lai,” tiah an ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sihmanhsehlaw Sihon nih Israel cu a ram tanter kha a awnh duh hna lo. A mi vialte kha a pumh hna i ramlak ah Israel doh awkah cun a kal i Jahaz a phan i Israel kha a tuk.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cun Israel nih vainam in an sam hna i a ram kha Arnon in Jabbok tiang, Ammon mi hna ramri tiang, an lak; zeitintiah Jazer cu Ammon mi hna ramri ah a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Israel nih mah hi khua vialte hna kha an lak i Amor mi khua vialte ah Israel cu an um, Heshbon le a khuate vialte hna ah cun an um.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zeitintiah Heshbon cu Amor mi siangpahrang Sihon khua kha a si; Sihon nih cun Moab siangpahrang hmasa deuh kha a rak doh i Arnon tiangin a ram kha a kut chungin a rak lak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cucaah pupa hla a rak satu hna nih, “Heshbon ah ra tuah u, remh tuah u, Sihon khua cu fehter si seh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zeitintiah Heshbon in mei a chuak i Sihon khua in meizik a chuak. Moab siangpahrang Ar kha a kangh, Arnon hmunsang bawi hna zong.
  </para>
  <para style="p">
    <verse number="29" style="v" />Maw Moab, ngaihchiat awk na va si dah! Maw Khemosh biami hna, nannih cu nan lo cang ai! A fapa hna cu ralzam ah a ser hna i, A fanu hna cu Amor mi siangpahrang Sihon sinah cun sal ah a ser hna.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cucaah an tefa hna cu Heshbon in Dibon tiang an rawk i Medeba tiang mei a kangh hlantiang kannih nih kan ṭhio,” tiah an ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cu bantukin Israel nih Amor mi hna ram ah cun an um.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun Moses nih Jazer cu va ngiat awkah a thlah hna i a khuate kha an lak hna i khika ah a ummi Amor mi hna kha an pawnchuah hna.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cun an i mer i Bashan lei lam kha an zulh. Bashan siangpahrang Og nih Edrei ah anmah doh awkah amah le a mi vialte he an hung chuak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Sihmanhsehlaw Bawipa nih Moses cu a chawnh i, “Amah kha ṭih hlah, zeitintiah amah cu a mi vialte le a ram he na kut chungah kan pek cang; Heshbon ah a ummi Amor mi hna siangpahrang Sihon cungah na tuah bantuk khan, amah cungah na tuah lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cucaah a fapa hna le a mi vialte hna he, amah caah a taangmi pakhat hmanh um lo tiangin, amah cu an thah i a ram cu an rawlh.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Israel mi cu an i thawh i Jordan khattelei ral Moab ramrawn ah, Jeriko zawn ah khan, an riak.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun Zippor fapa Balak nih khan Amor mi cungah Israel nih an tuahmi vialte kha a hmuh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cu mi cu an tampi caah; Moab nih an ṭih ngaingai hna. Moab mi hna cu Israel mi an ṭih hnanak nih cun a tei hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun Moab nih Midian upa hna sinah, “Cawtum nih lo chung ram a ṭam dih bantukin, hi bupi nih hin kan pawngkam i a ummi thil vialte a ṭam dih lai,” tiah a ti. Cucaah Zippor fapa Balak, cu caan lio i Moab siangpahrang a simi nih cun,
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaw ram i a ummi, Tiva pawng i a ummi Pethor khuami Beor fapa Balaam cu kawh awkah lamkal a hei thlah hna i, “Zohhmanh, Izipt ram in miphun pakhat an ra chuak i vawlei an khat dih i keimah zawn ah an um cang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ra tuah law, mah mi hna hi chiat ka serhpiak hna, keimah caah an ṭhawng tuk; ka tei hna in hi ram hin ka hei dawi khawh hna hmanh hnga maw; zeitintiah thluachuah na pekmi cu thlua an chuak i, chiat na serhmi cu a chiat hna ti kha ka hngalh,” tiah a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cucaah Moab upa hna le Midian upa hna cu an kut ah litin man i put in an kal i Balaam sinah an phan i Balak biacahmi cu an chimh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun anih nih annih cu, “Tuzan cu hika ah hin riak u law, Bawipa nih ka sinah a chim bantuk paoh in, bia cu ka rak in phorh ṭhan hna lai,” tiah a ti. Cucaah Moab bawi hna cu Balaam sinah an riak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Pathian cu Balaam sinah a ra i, “Na sinah a ummi hna hi ahodah an si?” tiah a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Balaam nih Pathian sinah, “Zippor fapa Balak, Moab siangpahrang nih cun, a run ka cah i,
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Zohhmanh, Izipt ram in miphun pakhat an chuak i vawlei kha an khat dih. Ra tuah law, annih kha chiat ka serhpiak hna; annih kha ka doh khawh hna in ka thawl khawh hna hmanh hnga maw,’ a ti,” tiah a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian nih Balaam cu, “An sinah na kal hnga lo; cu mi hna cu chiat na serh hna hnga lo, zeitintiah thluachuakmi an si,” tiah a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cucaah Balaam cu zinglei ah a tho i Balak bawi hna cu, “Nanmah ram ah va kir ko u, zeitintiah nanmah sin kal cu Bawipa nih a ka sianh lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun Moab bawi hna cu an tho i Balak sinah an kal i, “Balaam nih kan sin i rat cu a duh lo,” tiah an ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Balak nih annih nakin hmaizah awk deuh a simi bawi kha tam deuh in a thlah ṭhan hna.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun annih nih Balaam sinah an ra i, “Hi bangin Zippor fapa Balak nih, ‘Keimah sin rat cu zeihmanh i donhter hlah;
  </para>
  <para style="p">
    <verse number="17" style="v" />zeitintiah upatnak nganpi kan pek hrimhrim lai i na ka chimhmi paoh kha ka tuah lai; ra law, mah mi hna hi chiat ka serhpiak ko hna,’ a ti,” tiah an ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sihmanhsehlaw Balaam nih a leh hna i Balak sal hna sinah cun, “Balak nih a inn cu sui le ngun a khat in ka pe hmanh seh law, Bawipa ka Pathian nawlbia lengah cun zeihmanh ka tuah kho lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuzan zong hika ah hin riak tuah u, tiah kan nawl hna, Bawipa nih zeidah ka sinah a chim rih lai kha ka hngalh nakhnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Pathian nih Balaam sinah zan ah a ra i, “Hi mi hna nih nangmah kawh awkah an rat ahcun, tho law, an sinah va kal ko; sihmanhsehlaw kan chimhmi lawnglawng kha na tuah lai,” tiah a sinah a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cucaah zinglei ah Balaam cu a tho i a laa cu a danh i Moab bawi hna sinah khan a kal.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sihmanhsehlaw a kal caah Pathian thinhunnak cu a alh i Bawipa vancungmi pakhat nih amah dawntu ah lam ah a dir. Amah cu laa cungah cun aa cit i a sal pahnih cu amah sinah an um.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun laa nih cun Bawipa vancungmi cu lamkalai ah vainam phawi cia i put in a dir ko kha a hmuh i, laa cu lam in a pial i lo chungah a kal; cun Balaam nih laa cu lam lei i mer ṭhan awkah a tuk.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cun Bawipa vancungmi cu mitsur dum le mitsur dum karlak i lam bi ah a dir i a kap hnih in hau a um veve.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun laa nih Bawipa vancungmi kha a hmuh tikah, hau cu a hei en i Balaam ke cu hau ah khan a rial chih; cucaah a tuk ṭhan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun Bawipa vancungmi cu hmailei ah a kal ṭhan i orhlei ah siseh, kehlei ah siseh, i mernak a um lonak hmun, hmun ceprep pakhat ah, a dir.
  </para>
  <para style="p">
    <verse number="27" style="v" />Laa nih Bawipa vancungmi kha a hmuh tikah Balaam cu a bawhpi i Balaam thinhunnak cu a alh i a ṭhiangṭhunh in laa cu a tuk.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cu tikah Bawipa nih laa cu a holhter i Balaam sinah cun, “Na cungah zeidah ka tuah i voi thum tiang na ka tuk?” tiah a ti.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cun Balaam nih laa cu, “Nihchuak capo ah na ka ser caah a si. Nam rak i put ning law, ka ti pei tiah, ka rak in thah ko hnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cun laa nih Balaam cu, “Keimah cu na hmette in atu tiang i naa citmi na laa ka si lo mei? Hi bantukin na cungah ka tuah bal maw?” tiah a ti. Cun anih nih, “Na tuah bal lo,” a ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cu tikah Bawipa nih Balaam cu a mit a auter i, Bawipa vancungmi, vainam zuh cia a kut ah i put in, lamkalai ah a dir ko kha a hmuh, cun a lu a khun i a bawk.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun Bawipa vancungmi nih amah sinah cun, “Zeicaahdah hi voi thum tiang na laa kha na tuk? Zohhmanh, na tuahnak cu ka hmaiah a ṭha lomi a si caah nangmah kha donh awkah ka ra chuak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Laa nih khan a ka hmuh i voi thum tiang hin ka hmaiah a pial. Ka hmai in rak pial hlah seh law, amah cu thah loin nangmah kha ka rak in thah cang hnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cun Balaam nih Bawipa vancungmi sinah cun, “Ka sual cang, zeitintiah keimah donh awkah lam ah na rak dir ti kha ka hngal lo. Cucaah na mithmuh ah thil ṭhalo a si ahcun ka kir ṭhan ko lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="35" style="v" />Cun Bawipa vancungmi nih Balaam cu, “Mi hna sinah cun va kal ko, sihmanhsehlaw kan chimhmi bia lawnglawng na chim lai,” tiah a ti. Cucaah Balaam cu Balak bawi hna sinah cun a kal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Balaam a ra cang tiah Balak nih a theih tikah, Arnon tiva nih a thlehmi an ramri, cu ramri a donghnak bik i a ummi Moab khua tiangin va don awkah a kal.
  </para>
  <para style="p">
    <verse number="37" style="v" />Cun Balak nih Balaam cu, “Nangmah kawh awkah mi ka rak thlah hna, a si lo mei? Zeicaahdah ka sinah na rat lo? Upatnak an pe kho lo maw ka si?” tiah a ti.
  </para>
  <para style="p">
    <verse number="38" style="v" />Balaam nih Balak sinah cun, “Zohhmanh, nangmah sin ka ra phan cang! Keimah thamtham cu zeihmanh chim khawhnak nawl ka ngei i mei? Pathian nih ka ka chung i a chiahmi bia lawng pei ka chim khawh ko lai cu,” tiah a ti.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cun Balaam cu Balak sinah cun a kal i Kiriath-huzoth an phan.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cun Balak nih cawtum hna le tuu hna in rai aa thawi i Balaam le a sinah a ummi bawi hna kha a hei hleh hna.
  </para>
  <para style="p">
    <verse number="41" style="v" />Cun a thaizing ah Balak nih Balaam cu Bamoth-baal ah a hun kalpi i cuka cun a naih bik i a ummi hna cu a hmuh hna.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />A hramthawk ah, Pathian nih van le vawlei a ser hna tikah,
  </para>
  <para style="p">
    <verse number="2" style="v" />vawlei cu mui zong a ngei lo, pungsan zong a ngei lo. Rilipi cu muihnak nih a khuh i ti cungah cun Pathian ṭhawnnak cu aa chawk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun Pathian nih, “Ceunak um seh,” tiah a ti i ceunak cu a hung um.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ceunak cu a zoh i aa lawm. Cun ceunak le muihnak cu a ṭhen hna i
  </para>
  <para style="p">
    <verse number="5" style="v" />ceunak cu “Chun” tiah min a sak i muihnak cu “Zan” tiah a ti. Zanlei cu a hung dih i zinglei kha a hung um — cucu ni khatnak ni cu a si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun Pathian nih cun, “Ti le ti a ṭhentu hna ding caah aa kuaimi van pakhat in um seh law, ti cu hmun hnih ah um hna seh,” tiah a ti i cu tining cun a hung si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cuticun Pathian nih cun van kuai cu a ser i a tang i a ummi ti le a cung i a ummi ti cu a ṭhen hna;
  </para>
  <para style="p">
    <verse number="8" style="v" />van kuai cu a min ah “Van” a sak. Zanlei cu a hung dih i zinglei kha a hung um, cucu ni hnihnak ni cu a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Pathian nih cun, “Van tang i a ummi ti cu hmun khat ah i pum hna seh law vawlei kha hung lang seh,” tiah nawl a pek i cu bang cun a hung si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vawlei cu a min ah “Vawlei” a sak i a pumhtermi ti cu “Rili” tiah a ti. A tuahmi kha a zoh i a lung a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun aa thawh i, “Vawlei cungah hin thingram a phunphun kho hna seh, a tlaimi kung hna le rawl a phunphun thei a phunphun a vuimi rawlkung hna,” tiah a ti i cu bang cun a hung si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cucaah cun vawlei cungah cun thingram a phunphun an kho, rawl a vuimi rawlkung hna le thei a tlaimi thingkung hna an si. Pathian nih a tuahmi cu a zoh i a lung a si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zanlei cu a hung dih i zinglei kha a hung um, cucu ni thumnak ni cu a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun Pathian nih cun, “Chun le zan a ṭhentu ding le ni le kum le caan kha zeitik in dah an i thawk cio ti hngalhtertu dingah van ah khin ceunak um hna seh;
  </para>
  <para style="p">
    <verse number="15" style="v" />cun cu ceunak hna nih cun vawlei hi ceuh hna seh,” tiah a ti i cu bang cun a hung si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cucaah Pathian nih cun ceunak ngan pipi pahnih hi a ser hna, ni hi chun uktu dingah a ser i thlapa hi zan uktu dingah a ser; arfi zong khi a ser hna;
  </para>
  <para style="p">
    <verse number="17" style="v" />ceunak hna cu van ah khin vawlei a run ceuhtu dingah a chiah hna,
  </para>
  <para style="p">
    <verse number="18" style="v" />chun le zan a uktu hna ding le ceunak le muihnak a ṭhentu hna dingah a chiah hna. A tuahmi kha a zoh i a lung a si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zanlei cu a hung dih i zinglei kha a hung um, cucu ni linak ni kha a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Pathian nih cun aa thawh i, “Ti nih hin thilnung phun tampi a hrin hna lai i va hi thli lakah hin an zuang lai,” a ti i cu bang cun a hung si.”
  </para>
  <para style="p">
    <verse number="21" style="v" />Cuticun Pathian nih cun rili chung i a ummi sahrang ṭihnung pipi le ti lak i a tlongmi thilnung a phunphun le va a phunphun kha a ser hna. A tuahmi kha a zoh i a lung a si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun thluachuah a pek hna i, “Ti chung i a ummi thilnung hi karh u law rili hi khat u, va hi tampi in karh u,” tiah a ti hna.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zanlei cu a dih i zinglei kha a hung um, cucu ni nganak ni a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cun Pathian nih cun, “Vawlei nih hin inn zuat saṭil a phunphun le ramlak saram a phunphun, a hme he a ngan he, hring hna seh,” a ti i cu bang cun a hung si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cuticun inn zuat saṭil a phunphun le ramlak saram a phunphun a hme he a ngan he a ser hna. A tuahmi kha a zoh i a lung a si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Cun Pathian nih cun, “Atu cu minung kan ser cang hna lai; kanmah mui an keng lai i kanmah he kan i lo lai. Nga si hna seh, va si hna seh, inn zuat saṭil si hna seh, ramlak i a ummi saram a hme he a ngan he si hna seh, an uk dih hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cuticun Pathian nih minung cu amah mui lo in a ser, minung cu Pathian mui in a ser hna. Mipa le minu kha a ser hna.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thluachuahnak a pek hna i, “Tefa tampi in ngei u law nan tefa cu vawlei cung khuazakip ah khat hna seh, cun annih nih vawlei cu uk hna seh. Nannih cu nga cung le va cung le ramlak saram a hme he a ngan he an dihlak cung i nawlngeihnak kan pek hna,” a ti.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nan ei awk caah thlai phun kip le thei phun kip kan pek hna;
  </para>
  <para style="p">
    <verse number="30" style="v" />Sihmanhsehlaw ramsa vialte hna le va vialte hna le vawlei ah a lawn in a lawnmi vialte nunnak thaw a ngeimi vialte hna caah ram hring le thlaihnah borbor ka pek hna,” a ti i cu bang cun a hung si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian nih a sermi thil vialte cu a zoh i a lung a si ngaingai. Zanlei cu a hung dih i zinglei kha a hung um, cucu ni ruknak ni cu a si.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel mi hna thluachuah pek cu Bawipa lawmhmi a si ti kha Balaam nih a hngalh tikah, voi dang bang khan litin ah kal ti loin ramlak lei kha a hoih peng.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun Balaam nih khua a hei zoh i Israel mi cu an hrin an hrinning cio in riahhmun an khuar kha a hmuh hna. Pathian thlarau nih a cungah a rung i,
  </para>
  <para style="p">
    <verse number="3" style="v" />a konglam chim cu a thawk i, “Beor fapa Balaam i a bia, A mit ceuter a simipa bia,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian bia a theimi le A Lianngan Bik langhnak a hmu i a tlu nain A mit hunpiak a simipa bia cu hihi a si:
  </para>
  <para style="p">
    <verse number="5" style="v" />Maw Jakob, zeitluk in dah na thlam cu an i dawh, Maw Israel, zeitluk in dah na riahhmun hna cu an i dawh!
  </para>
  <para style="p">
    <verse number="6" style="v" />A kau diahduahmi nelrawn hna le tiva pawng dum hna le, Bawipa nih a phunmi hna inhliam le tipawng sidar thing bantuk an si.
  </para>
  <para style="p">
    <verse number="7" style="v" />A balin chungin ti a luang lai i Ti tampi chungah a ci cu a um lai, A siangpahrang cu Agag nakin a sang deuh lai i A pennak cu hlorh a si lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian nih Izipt ram in a chuahpi; Fungtum ki bantuk a ngei, A ral miphun dang hna kha a ei dih hna lai i An ruh kha a khuai dih cikcek lai, Cun a thal in a chunh hna lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kun i chiandeih bangin a bawk, Chiandeihpi a lo; aho nih dah an thawh ngam lai? Nanmah thluachuah an petu hna paoh cu thluachuakmi si ve hna seh law, Chiat an serhtu hna paoh cu chiat serh si ve hna seh,” tiah a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Balaam cungah cun Balak thinhunnak cu a alh i a kut aa tum i Balak nih cun Balaam cu, “Ka ral hna chiatserh awkah kan kawh i zohhmanh, hi voi thum tiang thluachuah na pek hna.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cucaah na umnak ah zam ko kun; ‘Kan hlorh hrimhrim lai,’ tiah ka rak in ti, sihmanhsehlaw Bawipa nih cu upatnak hmuh cu an sianh lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun Balaam nih Balak cu, “ ‘Balak nih a inn cu sui le ngun a khat in ka pe hmanh seh law, keimah nawl in a ha siseh a chia siseh tuahnak dingah Bawipa bia cu ka lonh kho lai lo; Bawipa nih a chimmi paoh ka chim ko lai,’ tiah ka sinah na rak thlahmi na lamkal hna kha ka rak chimh hna, a si lo mei?
  </para>
  <para style="p">
    <verse number="14" style="v" />Zohhmanh, ka miphun sinah ka kal cang lai; ra ve law, mah miphun nih hin na mi hna cungah hi hnu i an tuah hnga ding cu kan hngalhter lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun a konglam chim cu a thawk i, “Beor fapa Balaam bia, A mit auter a simipa bia cu,
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian bia a thei i Cung Nung Bik hngalhnak a hngal i, A Lianngan Bik langhnak a hmu i a tlu i, Sihmanhsehlaw a mit huh a si lomi bia cu hihi an si:
  </para>
  <para style="p">
    <verse number="17" style="v" />Amah cu ka hmuh, sihmanhsehlaw atu i a si bantuk hi a si lo, Amah cu ka zoh, sihmanhsehlaw atu naite i a si bantuk hi a si lo: Jakob chungin arfi pakhat a chuak lai i Israel chungin bawifung pakhat a chuak lai; Moab cal cu a khuai lai i Sheth fapale hna cu a den dih hna lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel vial cu ral ha ngaiin an um lioah, Edom cu pawnchuah a si lai, Seir, a ral hna zong cu, pawnchuah a si ve lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob thawngin uknak a si lai i Khua chungah a tangmi hna cu hrawh an si lai!” tiah a ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Amalek lei cu a hei zoh i a konglam chim cu a thawk i, “Amalek cu miphun hna lakah pakhatnak a si, Sihmanhsehlaw a donghnak ah cun rawknak a phan lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ken mi hna lei cu a hei zoh i a konglam chim cu a thawk i, “Na umnak hmun cu a fekmi a si, Na bu cu lungpi chungah a si;
  </para>
  <para style="p">
    <verse number="22" style="v" />Sihmanhsehlaw Kain cu a iao dih lai. Zei tik tiang dah Asshur nih sal ah an kalpi lai?” tiah a ti.
  </para>
  <para style="p">
    <verse number="23" style="v" />Cun a konglam chim cu a thawk i “Aize! Pathian nih mah hi a tuah tikah ahodah a nung kho lai?
  </para>
  <para style="p">
    <verse number="24" style="v" />Sihmanhsehlaw Kittim in sangphawlawng an ra lai i Asshur le Eber kha an hrem hna lai i Amah zong rawknak kha a phan lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Balaam cu a tho i a umnak hmun ah khan a kal i Balak zong a tlung ve.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel nih Shittim ah an um lioah Moab fanu hna he khan hlawh an hlang ṭi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mah mi hna nih hin Israel mi hna cu an pathian sin i rai an thawinak ah khan an sawm hna i an ei ve i an pathian hmaiah khan an kun.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cu bangin Peor i Baal he cun Israel mi cu an i khitbanh i, Bawipa thinhunnak cu Israel cungah a alh;
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawipa nih Moses cu a chawnh i, “An haotu vialte kha la hna law, Bawipa hmaiah ni tlang ah thlai hna, Bawipa thinhunnak ṭihnung a simi cu Israel sinin aa mer nakhnga,” tiah a ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Moses nih Israel mi biaceihtu hna sinah cun, “Nan mi hna lakah Peor i Baal he aa khitbanh chihmi paoh cu nan thah hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun zohhmanh, Israel mi pakhat cu a ra i Midian minu pakhat cu a innchungkhar hna sinah aa luhpi; mah cucu Moses hmuh le Israel mibu an ningpi hmuh ah a si, tonnak thlam innka i an ṭah lioah khan.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun tlangbawi Aaron fapa Eleazar i fapa Phinehas nih mah cucu a hmuh tikah a tho i aa pummi sin khan a chuak i a kut in fei a put i
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel mipa cu innchung chin dal pakhat ah khan a hei zulh i, an pahnih in a chunh hna, Israel mipa le cu minu cu, minu cu a paw ah. Cucaah Israel mi sinin rai cu kham khawh a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Asinain cu rai in a thimi cu sang hnih le thong li an si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Tlangbawi Aaron fapa Eleazar i fapa Phinehas nih Israel mi sinin ka thinhunnak cu a mer cang, zeitintiah annih cu keimah nih ka ṭanh hna bangin a ṭanh ve hna, cucaah ka nahchuahnak nih Israel mi cu a that dih hna lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cucaah hi bangin, ‘Zohhmanh, amah cu ka daihnak biakamnak ka pek;
  </para>
  <para style="p">
    <verse number="13" style="v" />mah cucu amah ca le a hnu i a tefa hna caah dong lo tlangbawi sinak biakamnak a si lai, zeicahtiah a Pathian kha a ṭanh i Israel mi caah remnak a ser,’ tiah va chim tuah,” tiah a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Midian nu he thahmi Israel mipa min cu Salu fapa Zimri a si; amah cu Simeon phun chung i hrin pakhat lu a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cun thahmi Midian minu cu Zur fanu Kozbi a si; Zur cu Midian miphun chung i hrin pakhat lu a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Midian mi hna cu awlokchonh hna u law, that hna u,
  </para>
  <para style="p">
    <verse number="18" style="v" />zeitintiah Peor ruang i rai a tlun ni i thahmi Midian bawi fanu, an far, Kozbi kong le Peor kong i an in hlen hnanak khan annih nih awlok an in chonh hna,” tiah a ti.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rai a tlun hnuah Bawipa nih Moses le Aaron fapa tlangbawi Eleazar cu a chawnh hna i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mibu cu a ningpi in rel tuah u, kum kul ri in a cunglei an phunphun in, Israel mi chungah phaw nam tlai kho vialte,” tiah a ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun Moses le tlangbawi Eleazar nih Moab nelrawn Jordan tivakam Jeriko zawn ah khan an chimh hna i,
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawipa nih Moses nawl a pek bang khan, “Kum kul ri in a cunglei paoh mi kha rel hna u,” tiah an ti hna. Izipt ram in a chuakmi Israel mi cu mah hi an si:
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel fater cu Reuben; Reuben fapa hna cu: Hanok, Hanok chung hna pa; Pallu, Pallu chung hna pa;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezron, Hezron chung hna pa; Karmi, Karmi chung hna pa an si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mah hihi Reuben mi chungkhar hna cu an si i an minung cu sang li thong thum za sarih le sawm thum an si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pallu fapa hna cu: Eliab.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliab fapa hna cu: Nemuel, Dathan le Abiram an si. Mah hna hi Dathan le Abiram, mibu chungin thimmi, Korah he i komh in Moses le Aaron a dohtu kha an si. Bawipa kha an doh tikah
  </para>
  <para style="p">
    <verse number="10" style="v" />vawlei nih khan a ka a an i Korah he khan hmunkhat ah a dolh hna i, mei i minung za hnih le sawm nga a kangh hna tikah khan cu bu cu a thi; annih cu ralrinnak ah an cang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Asinain, Korah fapa hna cu an thi lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Simeon fapa hna cu an chung ning cio in: Nemuel, Nemuel chung hna pa; Jamin, Jamin chung hna pa; Jakin, Jakin chung hna pa;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerah, Zerah chung hna pa; Shaul, Shaul chung hna pa an si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mah hna hi Simeon mi chungkhar hna cu an si, sang hnih thong hnih le za hnih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad fapa hna cu an chung ning cio in: Zefon, Zefon chung hna pa; Haggi, Haggi chung hna pa; Shuni, Shuni chung hna pa;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ozni, Ozni chung hna pa; Eri, Eri chung hna pa;
  </para>
  <para style="p">
    <verse number="17" style="v" />Arod, Arod chung hna pa; Areli, Areli chung hna pa.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mah hna hi Gad fapa hna chungkhar cu an si, an minung cu sang li le za nga an si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Judah fapa cu Er le Onan an si i Er le Onan cu Kanaan ram ah an thi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun Judah fapa hna cu an chung ning cio in: Shelah, Shelah chung hna pa; Perez, Perez chung hna pa; Zerah, Zerah, chung hna pa an si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun Perez fapa hna cu: Hezron, Hezron chung hna pa; Hamul, Hamul chung hna pa an si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mah hna hi Judah mi chungkhar hna cu an si, an minung cu sang sarih thong ruk le za nga an si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Issakhar fapa hna cu an chung ning cio in: Tola, Tola chung hna pa; Puvah, Puvah chung hna pa;
  </para>
  <para style="p">
    <verse number="24" style="v" />Jashub, Jashub chung hna pa; Shimron, Shimron chung hna pa an si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mah hna hi Issakhar chungkhar hna an si, an minung cu sang ruk thong li le za thum.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zebulun fapa hna cu an chung ning cio in: Sered, Sered chung hna pa; Elon, Elon chung hna pa; Jahleel, Jahleel chung hna pa an si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mah hna hi Zebulun chungkhar hna cu an si, an minung cu sang ruk le za nga.
  </para>
  <para style="p">
    <verse number="28" style="v" />Josef fapa hna cu an chung ning cio in: Manasseh le Efraim an si.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh fapa hna cu: Makhir, Makhir chung hna pa; Makhir cu Gilead pa a si; Gilead cu, Gilead chung hna pa a si.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mah hna hi Gilead fapa cu an si: Iezer, Iezer chung hna pa; Helek, Helek chung hna pa;
  </para>
  <para style="p">
    <verse number="31" style="v" />Asriel, Asriel chung hna pa; Shekhem, Shekhem chung hna pa;
  </para>
  <para style="p">
    <verse number="32" style="v" />Shemida, Shemida chung hna pa le Hefer, Hefer chung hna pa an si.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cun Hefer fapa Zelofehad cu fapa a ngei lo, fanu lawng a ngeih hna: Zelofehad fanu hna an min cu Mahlah, Noah, Hoglah, Milkah le Tirzah an si.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mah hna hi Manasseh chungkhar hna cu an si, an minung cu sang nga thong hnih le za sarih an si.
  </para>
  <para style="p">
    <verse number="35" style="v" />Efraim fapa hna cu an chung ning cio in: Shuthelah, Shuthelah chung hna pa; Bekher, Bekher chung hna pa; Tahan, Tahan chung hna pa an si.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cun Shuthelah fapa hna cu: Eran, Eran chung hna pa an si.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mah hna hi Efraim fapa hna chungkhar hna cu an si, a minung sang thum thong hnih le za nga an si. Mah hna hi an chung ning cio in Josef fapa hna cu an si.
  </para>
  <para style="p">
    <verse number="38" style="v" />Benjamin fapa hna cu an chung ning cio in: Bela, Bela chung hna pa; Ashbel, Ashbel chung hna pa; Ahiram, Ahiram chung hna pa;
  </para>
  <para style="p">
    <verse number="39" style="v" />Shefufam, Shefufam chung hna pa; Hufam, Hufam chung hna pa an si.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bela fapa hna cu Ard le Naaman an si: Ard cu Ard chung hna pa; Naaman cu Naaman chung hna pa.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mah hna hi an chungkhar ning cio in Benjamin fapa hna cu an si, an minung cu sang li thong nga le za ruk an si.
  </para>
  <para style="p">
    <verse number="42" style="v" />Dan fapa hna cu an chung ning cio in: Shuham, Shuham chung hna pa cu an si. Mah hna hi an chung ning cio in Dan chungkhar hna cu an si.
  </para>
  <para style="p">
    <verse number="43" style="v" />Shuham chungkhar vialte hna cu an minung sang ruk thong li le za li an si.
  </para>
  <para style="p">
    <verse number="44" style="v" />Asher fapa hna cu an chung ning cio in: Imnah, Imnah chung hna pa; Ishvi, Ishvi chung hna pa; Beriah, Beriah chung hna pa an si.
  </para>
  <para style="p">
    <verse number="45" style="v" />Beriah fapa hna cu: Heber, Heber chung hna pa; Malkhiel, Malkhiel chung hna pa an si.
  </para>
  <para style="p">
    <verse number="46" style="v" />Asher fanu min cu Serah a si.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mah hna hi Asher fapa hna cu an chung ning cio in an si, an minung cu sang nga thong thum le za li an si.
  </para>
  <para style="p">
    <verse number="48" style="v" />Naftali fapa hna cu an chung ning cio in: Jahzeel, Jahzeel chung hna pa; Guni, Guni chung hna pa;
  </para>
  <para style="p">
    <verse number="49" style="v" />Jezer, Jezer chung hna pa; Shillem, Shillem chung hna pa an si.
  </para>
  <para style="p">
    <verse number="50" style="v" />Mah hna hi Naftali chungkhar hna cu an chung ning cio ah an si, an minung cu sang li thong nga le za li an si.
  </para>
  <para style="p">
    <verse number="51" style="v" />Mah hihi Israel mi hna an minung cu an si, sing ruk, thong khat, za sarih le sawm thum.
  </para>
  <para style="p">
    <verse number="52" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="53" style="v" />“Ram cu mah hna hi ro caah cheuh awk an si lai, an min relnak bangin.
  </para>
  <para style="p">
    <verse number="54" style="v" />Phun ngan deuh cu vo ngan deuh na pek lai i phun hme deuh cu vo hme deuh na pek lai; an phun dihlak in an minung rel ning cio ah an ro cu na pek hna lai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Sihmanhsehlaw ram cu camcawh fung khiah in phawt a si lai; an pupa hna phun min ning cio ah an co lai.
  </para>
  <para style="p">
    <verse number="56" style="v" />An vo cu camcawh fung khiah ningin a ngan deuh siseh a hme deuh siseh phawt an si lai.
  </para>
  <para style="p">
    <verse number="57" style="v" />Mah hna hi an chung ning cio ah relmi Levi mi cu an si: Gershon, Gershon chung hna pa; Kohath, Kohath chung hna pa; Merari, Merari chung hna pa.
  </para>
  <para style="p">
    <verse number="58" style="v" />Mah hna hi Levi innchungkhar hna cu an si: Libni chung, Hebron chung, Mahli chung, Mushi chung, Korah chung, Kohath cu Amram pa a si.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amram nupi min cu Levi fanu Jokhebed a si i Izipt ram ah Levi nih a hrinmi a si; cun Amram cu Aaron le Moses le an far Miriam a hrinpiak.
  </para>
  <para style="p">
    <verse number="60" style="v" />Cun Aaron nih Nadab, Abihu, Eleazar, le Ithamar a hrin hna.
  </para>
  <para style="p">
    <verse number="61" style="v" />Sihmanhsehlaw Nadab le Abihu cu Bawipa hmai i mei thianglo an pekchanh tikah khan an thi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Cun annih lak i relmi, thla khat ri in a cunglei pa hna cu, sang hnih le thong thum an si; annih cu Israel mi lakah rel an si lo, zeitintiah Israel mi lakah annih cu ro pek an si lo.
  </para>
  <para style="p">
    <verse number="63" style="v" />Moab nelrawn, Jordan tiva kam, Jeriko zawn ah Israel mi cu a reltu hna, Moses le tlangbawi Eleazar nih an relmi hna cu mah hna hi an si.
  </para>
  <para style="p">
    <verse number="64" style="v" />Sihmanhsehlaw mah hna lak ah hin Sinai ramlak i Israel mi a rak reltu hna Moses le tlangbawi Aaron nih an rak relmi hna cu pakhat hmanh an i tel lo.
  </para>
  <para style="p">
    <verse number="65" style="v" />Zeitintiah annih cu Bawipa nih, “Ramlak ah an thi lai,” ti ah khan a rak ti. Jefunneh fapa Kaleb le Nun fapa Joshua dah ti lo cu annih lakah pakhat hmanh an taang lo.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cun Josef fapa Manasseh innchungkhar hna chung i Manasseh fapa Makhir i fapa Gilead i fapa Hefer i fapa Zelofehad fanu hna cu an ra, a fanu hna an min cu Mahlah, Noah, Hoglah, Milkah, le Tirzah an si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun Moses le tlangbawi Eleazar le mi bupi le an hruaitu hna hmaiah cun, tonnak thlam innka ah cun an dir i,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Kan pa cu ramlak ah khan a thi; amah cu Bawipa doh in aa pummi hna Korah bu chungah khan aa tel lo, sihmanhsehlaw amah sualnak ruangte ah khan a thi ko; cun fapa a ngei lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zeicaahdah kan pa min cu amah hrin chungin a loh lai, fapa a ngeih lo ruangah? Kan pa unau hna lakah vo kan pe ve tuah u,” tiah an ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Moses nih an kong cu Bawipa hmaiah a chuahpi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zelofehad fanu hna cu an dik ko; an pa unau hna lakah ro na coter ve hna lai i, an pa ro cu annih kha na pek hna lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Israel mi hna cu, ‘Mipa pakhatkhat cu a thih i fapa a ngeih lo ahcun, a ro cu a fanu kha nan pek lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Fanu a ngeih lo ahcun, a ro cu a unau hna kha nan pek hna lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Unau pa a ngeih lo ahcun, a ro cu a pa unau hna kha nan pek hna lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Cun a pa nih unau a ngeih lo ahcun, a ro cu a rualchan lakah a nai bikmi rualchan kha nan pek lai i amah nih cun a co lai. Bawipa nih Moses nawl a pek bangin, Israel mi hna caah nawlbia le phunglam a si lai,’ tiah na chimh hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bawipa nih Moses cu a chawnh i, “Abarim tlang ah khin hung kai law, Israel mi hna ka pekmi ram cu hung cuan tuah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun na hmuh dih in nangmah zong na mi hna sinah pumh na si ve lai, na u Aaron kha pumh a si bang khan,
  </para>
  <para style="p">
    <verse number="14" style="v" />zeitintiah Zin ramlak i mibu nih an zai lioah khan, an mithmuh ah, ti ah khan, keimah thangṭhat awk i ka bia kha na doh,” tiah a ti. (Hi ti cu Zin ramlak i a ummi Kadesh khua i Meribah ti kha an si.)
  </para>
  <para style="p">
    <verse number="15" style="v" />Moses nih Bawipa sinah cun,
  </para>
  <para style="p">
    <verse number="16" style="v" />“ Bawipa, titsa vialte thlarau hna i Pathian nih mibu zohkhenhtu ah mipa pakhat
  </para>
  <para style="p">
    <verse number="17" style="v" />an hmaiah a kal ding le an hmaiah a ra ding le, a chuahpitu hna le a luhpitu hna ah chia ko seh; Bawipa mibu cu tuukhal ngei lo tuu hna bantukin an si nakhnga lo,” tiah a ti.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cun Bawipa nih Moses cu, “Nun fapa Joshua, ruahnak a ngei ngaingaimi kha, la law, a cungah na kut chuang tuah;
  </para>
  <para style="p">
    <verse number="19" style="v" />tlangbawi Eleazar le mibu a dihlak hmaiah khan dirter law, an mithmuh ah nawlngeihnak kha pe tuah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nangmah nih amah cu na nawlngeihnak tlawmpal in na thuamh lai, Israel mibu dihlak nih a bia a ngaih nakhnga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun tlangbawi Eleazar hmaiah khan a dir lai i amah nih Bawipa hmaiah Urim in bia a halpiak lai; amah bia in an chuak lai i amah bia in an lut lai, amah le amah sinah a ummi Israel mi an dihlak in, mibu cu a ning piin,” tiah a ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Cun Bawipa nih nawl a pek bangin Moses nih a tuah; Joshua cu a lak i tlangbawi Eleazar le mibupi hmaiah khan a dirter i
  </para>
  <para style="p">
    <verse number="23" style="v" />a cungah a kut a chuan i Bawipa nih Moses a chimh bang khan nawlngeihnak kha a pek.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi cu nawl pe hna law, hi bangin chim hna, ‘Keimah sinah pekchanhmi thil, mei in keimah sin i pekchanhnak ca i ka rawl rimthaw cu, amah caan te ah keimah sin i pekchanh awk kha nan i ralring lai.’
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun annih cu hi bangin na chimh hna lai, Mah hihi Bawipa sinah mei in nan pekchanhmi thawinak cu a si lai: tlaihlan thawinak caah ni khat hnu ni khat in kum khat a timi tuufa dotla a pa pahnih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuufa pakhat cu zinglei ah nan thawi lai i a dang tuufa pakhat cu zanlei ah nan thawi lai;
  </para>
  <para style="p">
    <verse number="5" style="v" />changvut thawinak caah ṭhuatmi chiti hin cheu li cheu khat he cawhmi changvut dip ephah cheu hra cheu khat zong.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sinai Tlang i rimthaw ca i fehtermi tlaihlan khangh thawinak, Bawipa sinah mei in pekchanhmi cu a si.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thlet thawinak cu tuufa pahnih caah khan, hin cheu li cheu khat veve a si lai; hmunthiang ah khan Bawipa caah thlet thawinak mitsur hang cu na thlet lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tuufa dang pakhat cu zanlei ah na thawi lai; zinglei i changvut thawinak le a thlet thawinak bang khan, mei in thawinak Bawipa sin i rimthaw bantuk khan na thawi lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Sabbath ni ah kum khat a timi tuufa dotla a pa pahnih le changvut thawinak caah chiti he cawhmi changvut dip ephah cheu hra cheu hnih le a thlet thawinak:
  </para>
  <para style="p">
    <verse number="10" style="v" />tlaihlan khangh thawinak le a thlet thawinak hleiah mah hihi sabbath kip i khangh thawinak cu a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Cun nan thla a det tik paoh ah Bawipa sinah khangh thawinak nan pekchanh lai: cawtum no pahnih, tuukawng pakhat, kum khat a timi tuufa dotla a pa pasarih:
  </para>
  <para style="p">
    <verse number="12" style="v" />cun cawtum pakhat veve caah changvut thawinak ca i chiti he cawhmi changvut dip ephah cheu hra cheu thum zong; cun tuukawng pakhat caah cun changvut thawinak ca i chiti he cawhmi changvut dip cheu hra cheu hnih;
  </para>
  <para style="p">
    <verse number="13" style="v" />tuufa hna caah cun changvut thawinak ca i chiti he cawhmi changvut dip cheu hra cheu khat cio; mah hihi rimthaw khangh thawinak Bawipa sin i mei in pekchanhmi cu an si.
  </para>
  <para style="p">
    <verse number="14" style="v" />An thlet thawinak hna cu cawtum caah mitsur hang hin cheu, tuukawng caah hin cheu thum cheu khat, tuufa caah hin cheu li cheu khat an si lai; mah hihi kum chuak in thla kip i khangh thawinak cu a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bawipa sin i sual thawinak ca zongah mehehtum pakhat; mah hihi tlaihlan khangh thawinak le a thlet thawinak hlei ah khan pekchanh a si lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thla khatnak thla a ni hleilinak ni ah Bawipa lanhtak a si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cun hi thla ni hleinga ni ah hin puai a si; ni sarih chung thilnu telh lo changreu ei a si lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ni khatnak ni ah a thiangmi pumhnak a si lai: rian fak nan ṭuan lai lo,
  </para>
  <para style="p">
    <verse number="19" style="v" />sihmanhsehlaw Bawipa sin i khangh thawinak mei in thawinak cu nan pekchanh lai; cawtum no pahnih, tuukawng pakhat, kum khat a timi tuufa a pa pasarih an si lai; dotla an si kha ṭha tein zoh hna u;
  </para>
  <para style="p">
    <verse number="20" style="v" />chiti cawhmi changvut dip an changvut thawinak zong kha nan pekchanh lai; cawtum caah ephah cheu hra cheu thum, tuukawng caah cheu hra cheu hnih,
  </para>
  <para style="p">
    <verse number="21" style="v" />tuufa pasarih caah cheu hra i cheu khat cio nan pekchanh lai;
  </para>
  <para style="p">
    <verse number="22" style="v" />cun nannih ca i remnak ser awkah, sual thawinak caah meheh a pa pakhat zong.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zinglei khangh thawinak, tlaihlan khangh thawinak hleiah cun, mah hihi nan thawi hna lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hi bantuk ṭhiamṭhiam in ni sarih chung cu nifate in mei in pekchanhmi rawl, Bawipa ca i rimthaw cu, nan pekchanh lai; tlaihlan khangh thawinak le a thlet thawinak hleiah khan mah hihi nan pekchanh lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun ni sarihnak ni ah a thiangmi pumhnak nan ngei lai; rian fak nan ṭuan lai lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Theipar hmasa bik hna ni ah, zarh hna puai ah Bawipa sin i rawl thar changvut thawinak nan pekchanh tikah, a thiangmi pumhnak nan ngei lai; rian fak nan ṭuan lai lo,
  </para>
  <para style="p">
    <verse number="27" style="v" />sihmanhsehlaw Bawipa sinah khangh thawinak rimthawmi cu nan pekchanh lai: cawtum no pahnih, tuukawng pakhat, kum khat a timi tuufa a pa pasarih;
  </para>
  <para style="p">
    <verse number="28" style="v" />chiti he cawhmi changvut dip in sermi an changvut thawinak zong, cawtum hna caah ephah cheu hra cheu thum cio, tuukawng caah cheu hra cheu hnih,
  </para>
  <para style="p">
    <verse number="29" style="v" />tuufa pasarih caah cheu hra cheu khat cio;
  </para>
  <para style="p">
    <verse number="30" style="v" />nan ca i remnak ser awkah meheh a pa pakhat he.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tlaihlan khangh thawinak le a changvut thawinak hleiah khan mah hihi an thlet thawinak he nan thawi hna lai. Dotla an si kha ṭha tein zoh hna u.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Thla sarihnak thla a ni khatnak ni ah a thiangmi pumhnak nan ngei lai; rian fak nan ṭuan lai lo. Nannih caah muko tumnak ni a si lai i,
  </para>
  <para style="p">
    <verse number="2" style="v" />khangh thawinak, Bawipa ca rimthaw cu, nan pekchanh lai: cawtum no pakhat, tuukawng pakhat, kum khat a timi tuufa dotla a pa pasarih;
  </para>
  <para style="p">
    <verse number="3" style="v" />chiti he cawhmi changvut dip an changvut thawinak zong, cawtum caah ephah cheu hra cheu thum, tuukawng caah ephah cheu hra cheu hnih le,
  </para>
  <para style="p">
    <verse number="4" style="v" />tuufa pasarih hna caah cheu hra cheu khat cio;
  </para>
  <para style="p">
    <verse number="5" style="v" />cun nannih ca i remnak ser awkah sual thawinak ca i meheh a pa pakhat he;
  </para>
  <para style="p">
    <verse number="6" style="v" />mah hna hi, thlapa thar i khangh thawinak le a changvut thawinak le tlai hlan khangh thawinak le a changvut thawinak le an thlet thawinak an phunglam ningin, rimthaw Bawipa sin i mei in pekchanhmi hleiah an si.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Hi thla sarihnak thla a ni hra a ni ah hin a thiangmi pumhnak nan ngei lai nan i temhinter lai; rian nan ṭuan lai lo,
  </para>
  <para style="p">
    <verse number="8" style="v" />sihmanhsehlaw Bawipa sinah rimthaw khangh thawinak nan pekchanh lai: cawtum no pakhat, tuukawng pakhat, kum khat a timi tuufa a pa pasarih; nannih caah do a tlami kha an si lai;
  </para>
  <para style="p">
    <verse number="9" style="v" />cun chiti he cawhmi changvut dip an changvut thawinak, cawtum caah ephah cheu hra cheu thum, tuukawng caah cheu hra cheu hnih,
  </para>
  <para style="p">
    <verse number="10" style="v" />tuufa pasarih caah cheu hra cheu khat cio:
  </para>
  <para style="p">
    <verse number="11" style="v" />remnak ca i sual thawinak le tlaihlan khangh thawinak le a changvut thawinak le an thlet thawinak hna hleiah sual thawinak caah mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Thla sarihnak thla a ni hleinganak ni ah a thiangmi pumhnak nan ngei lai; rian fak nan ṭuan lai lo i ni sarih chung Bawipa caah puai nan ulh lai;
  </para>
  <para style="p">
    <verse number="13" style="v" />mei in pekchanhmi khangh thawinak Bawipa ca i rimthaw cu nan pekchanh lai, cawtum no hleithum, tuukawng pahnih, kum khat a timi tuufa a pa hleili; dotla an si lai;
  </para>
  <para style="p">
    <verse number="14" style="v" />cun chiti he cawhmi changvut dip in sermi an changvut thawinak cawtum hleithum hna caah khan ephah cheu hra cheu thum cio, tuukawng pahnih hna caah khan cheu hra cheu hnih cio,
  </para>
  <para style="p">
    <verse number="15" style="v" />tuufa hleili hna caah khan cheu hra cheu khat cio;
  </para>
  <para style="p">
    <verse number="16" style="v" />cun tlaihlan khangh thawinak le a changvut thawinak le a thlet thawinak hleiah sual thawinak caah mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Ni hnihnak ni ah cawtum no hleihnih, tuukawng pahnih, kum khat a timi tuufa a pa dotla hleili,
  </para>
  <para style="p">
    <verse number="18" style="v" />a phunglam ning le an tlawmtam ningin cawtum hna le tuukawng hna le tuufa hna sa i changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="19" style="v" />tlaihlan khangh thawinak le a changvut thawinak le an thlet thawinak hna hleiah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ni thumnak ni ah cawtum hleikhat, tuukawng pahnih, kum khat a timi tuufa a pa dotla hleili,
  </para>
  <para style="p">
    <verse number="21" style="v" />a phunglam ning le an tlawmtam ningin cawtum hna le tuukawng hna le tuufa hna ca i changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="22" style="v" />tlaihlan khangh thawinak le a changvut thawinak le a thlet thawinak hleiah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Ni linak ni ah cawtum pahra, tuukawng pahnih, kum khat a timi tuufa a pa dotla hleili,
  </para>
  <para style="p">
    <verse number="24" style="v" />a phunglam ning le an tlawmtam ningin cawtum hna le tuukawng hna le tuufa hna ca i changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="25" style="v" />tlai hlan khangh thawinak le a changvut thawinak le a thlet thawinak hleiah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Ni nganak ni ah cawtum pakua, tuukawng pahnih, kum khat a timi tuufa a pa dotla hleili,
  </para>
  <para style="p">
    <verse number="27" style="v" />a phunglam ning le an tlawmtam ning in cawtum hna le tuukawng hna le tuufa hna ca i changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="28" style="v" />tlaihlan khangh thawinak hna le a changvut thawinak le a thlet thawinak hleiah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ni ruknak ni ah cawtum pariat, tuukawng pahnih, kum khat a timi tuufa a pa dotla hleili,
  </para>
  <para style="p">
    <verse number="30" style="v" />a phunglam ning le an tlawmtam ningin cawtum hna le tuukawng hna le tuufa hna ca i changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="31" style="v" />tlaihlan khangh thawinak le a changvut thawinak le an thlet thawinak hna hlei ah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Ni sarihnak ni ah cawtum pasarih, tuukawng pahnih, kum khat a timi tuufa a pa dotla hleili,
  </para>
  <para style="p">
    <verse number="33" style="v" />a phunglam ning le an tlawmtam ningin cawtum hna le tuukawng hna le tuufa hna ca i changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="34" style="v" />tlaihlan khangh thawinak le a changvut thawinak le a thlet thawinak hleiah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Ni riatnak ni ah a liannganmi pumhnak nan ngei lai: rian fak nan ṭuan lai lo,
  </para>
  <para style="p">
    <verse number="36" style="v" />sihmanhsehlaw mei in pekchanhmi, Bawipa ca i rimthaw khangh thawinak cu nan pekchanh lai: cawtum pakhat, tuukawng pakhat, kum khat a timi tuufa a pa dotla pasarih,
  </para>
  <para style="p">
    <verse number="37" style="v" />a phunglam ning le an tlawmtam ning in cawtum le tuukawng le tuufa hna caah changvut thawinak le thlet thawinak hna he khan;
  </para>
  <para style="p">
    <verse number="38" style="v" />tlaihlan khangh thawinak le a changvut thawinak le a thlet thawinak hleiah sual thawinak ca i mehehtum pakhat zong.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Nan biakam thawinak hna le nan lung tho tein thawinak hna hlei ah, mah hna hi nan khangh thawinak hna le nan changvut thawinak hna le nan thlet thawinak hna le nan daihnak thawinak hna caah a caan khiahmi puai hna ah Bawipa sinah nan pekchanh hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bawipa nih Moses cu nawl a pekning te khan Moses nih Israel mi kha zeizong vialte cu a chimh hna.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Moses nih Israel mi hna i an phun hna lu hna sinah cun, “Mah hihi Bawipa nawl pekmi cu a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipa pakhatkhat nih Bawipa sinah biakamnak a tuah ah maw, biakamnak in amah le amah cu i ṭem awkah chiat a ser ah maw, a bia cu a hrawk lai lo; a kaa chungin a chuakmi vialte bang khan a tuah lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Asiloah, minu pakhatkhat nih a ngaknut lio a pa inn i a um lioah biakamnak in amah le amah cu i ṭem awkah biakamnak a tuah tikah,
  </para>
  <para style="p">
    <verse number="4" style="v" />a pa nih a biakamnak le a biahrennak amah le amah aa ṭemnak cu a theih i zeihmanh amah sinah a chim lo ahcun, a biakamnak vialte cu a dir lai i amah le amah aa ṭemnak biahrennak vialte zong a dir ve lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sihmanhsehlaw, a pa nih a theih ni ah a hnatlak lonak kha a langhter ahcun, a biakamnak kha siseh, aa ṭemnak bia kha siseh, zeihmanh a dir lai lo i a pa nih a al caah Bawipa nih a ngaihthiam lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Cun a biakamnak tangah a um lioah siseh, ruah set loin a hmur nih a chimmi in amah le amah aa ṭem lioah siseh, va a ngeih ahcun,
  </para>
  <para style="p">
    <verse number="7" style="v" />cun a va nih a theih i a theih ni ah amah sinah zeihmanh a chim lo ahcun, a biakamnak cu a dir lai i amah le amah aa ṭemnak biahrennak zong kha a dir lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sihmanhsehlaw a va nih a theih ni ah a hnatlak lonak kha a langhter ahcun, a cungah a ummi biakamnak le ruah set loin a hmur nih a chimmi in aa ṭemnak kha a hrawh lai i Bawipa nih a ngaihthiam lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sihmanhsehlaw nuhmei maw makmi maw a si ahcun, bia aa kamnak nih siseh, amah le amah aa ṭemnak nih siseh, a nenh ko lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun a va inn ah bia aa kam ah siseh, chiatser in amah le amah aa ṭem ah siseh,
  </para>
  <para style="p">
    <verse number="11" style="v" />a va nih a theih i a sinah zeihmanh a chim lo i a al lo ahcun, a biakamnak vialte cu a dir lai i aa ṭemnak bia vialte zong a dir lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sihmanhsehlaw a va nih a theih ni ah a hrawh hna ahcun, a biakamnak kong ah a hmur in a chuakmi zeipaoh siseh, amah le amah aa hrennak bia siseh, a dir lai lo; a va nih a hrawh hna i Bawipa nih a ngaihthiam lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amah le amah i temhinter awkah biakamnak le chiatsernak a tuahmi paohpaoh cu a va nih a fehter khawh lai i a va nih a hrawh zong a hrawh khawh lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sihmanhsehlaw ni khat hnu ni khat a va nih zeihmanh a chim hlei lo ahcun, a cung i a ummi a biakamnak vialte siseh, a biahrennak vialte siseh a fehter a si; a theih ni ah amah sinah zeihmanh a chim lo caah a fehter hna a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sihmanhsehlaw a theih hnuah a hrawh hna ahcun a nupi ṭhat lonak kha amah nih a in lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mah hihi mipa le a nupi karlak kongah siseh, pa le a fanu a ngaknut lio i a pa inn ah a um lio i an karlak kongah siseh, Bawipa nih Moses nawl a pekmi nawlbia cu an si.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Midian mi hna cungah Israel mi hna phu cu va hlam tuah; cu hnuah na mi hna sinah pumh na si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Cun Moses nih mi hna sinah cun, “Midian cungah Bawipa phuhlamnak tuah awkah annih nih Midian kha an doh nakhnga nannih lak in raldohnak caah mi thim hna u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Raldohnak ah cun Israel miphun vialte chungin mi thong khat cio nan thlah hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cucaah Israel mi thong tampi chungin, phun khat chungin thong khat cio, thong hleihnih cu raldoh awk caah hriamnam an tlai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Moses nih phun khat chungin thong khat cio cu le, tlangbawi Eleazar fapa Phinehas a kut in hmunthiang umkheng le ralrin peknak muko aa putmi cu, raldohnak ah a thlah hna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bawipa nih Moses nawl a pek bangin, Midian cu an doh; pa vialte kha an thah hna.
  </para>
  <para style="p">
    <verse number="8" style="v" />An thahmi hna lakah Midian mi siangpahrang hna, Evi, Rekem, Zur, Hur, le Reba, zong an i tel; Beor fapa Balaam zong nam in an thah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Israel mi nih Midian nu hna le an ngakchia hna cu sal ah an tlaih hna; an caw vialte le an tuurun le an thilri vialte hna cu hranchaw ah an lak hna.
  </para>
  <para style="p">
    <verse number="10" style="v" />An umnak hmun i an khua vialte hna le an riahnak hmun vialte hna cu mei in an khangh i
  </para>
  <para style="p">
    <verse number="11" style="v" />thil le hranchaw vialte cu, mi siseh, saram siseh, an lak dih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Cun sal hna le hranchaw hna le thilri hna cu Moses le tlangbawi Eleazar le Israel mibu sinah cun, Moab nelrawn i Jordan tiva kam Jeriko zawn i an riahhmun ah khan an rak put hna.
  </para>
  <para style="p">
    <verse number="13" style="v" />Moses le tlangbawi Eleazar le mibu hruaitu vialte hna nih khan riahhmun leng i va don hna awkah an chuak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun Moses cu ralbawi hna, thong cung i nawlngeimi hna le za cung i nawlngeimi hna, raldohnak in a rami hna cungah khan a thin a hung.
  </para>
  <para style="p">
    <verse number="15" style="v" />Moses nih annih cu, “Mah nu vialte hi nan zuah ko hna mu?
  </para>
  <para style="p">
    <verse number="16" style="v" />Zohhmanh, hi mi hrimhrim hna hi Balaam fimchimhnak thawng in Peor kongah khan Israel mi cu Bawipa nawl a buartertu an si, cu caah rai kha Bawipa mibu cungah khan a tlung.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cu a si caah ngakchia hna lak i pa vialte kha that hna u law, pa a hngal cangmi nu vialte kha that hna u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sihmanhsehlaw pa a hngal rih lomi ngaknu vialte hna cu nanmah caah i zuah hna u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Riahhmun lengah ni sarih riak u; nannih lakah mi a thatmi paoh le miruak a tawngmi paoh nih nanmah le nan sal hna cu ni thumnak ni le ni sarihnak ni ah nan i thianh lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Puan paohpaoh le saphaw in sermi thil paohpaoh le meheh hmul in sermi thil vialte le thing in sermi paohpaoh cu nan thianh hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cun tlangbawi Eleazar nih raldohnak ah a kalmi ralkap hna sinah cun: “Mah hihi Bawipa nih Moses nawl a pekmi phungbia i nawlbia cu a si:
  </para>
  <para style="p">
    <verse number="22" style="v" />sui, ngun, dar, thir, canphio le suan,
  </para>
  <para style="p">
    <verse number="23" style="v" />mei a ing khomi hna lawnglawng cu, mei chungah nan hliau hna lai i an thiang lai. Asinain tlenghnak ti zongin thianter an si ve lai i mei a ing kho lomi thil paoh cu, ti in nan tlengh hna lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni sarihnak ni ah nan thil kha nan suk hna lai i nan thiang lai; cu hnuah riahhmun chungah nan lut lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nangmah le tlangbawi Eleazar le mibu chung i phun cio lu hna nih khan hranchaw lakmi cu minung he saṭil he rel hna u.
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun hranchaw cu raldohnak i a kalmi ralkap hna le aa pummi vialte hna caah cheu hnih ah nan cheu lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cun raldohnak ah a kalmi ralkap hna sinin Bawipa caah vo na lak lai, mi si hna seh, cawtum si hna seh, laa si hna seh, tuurun si hna seh, za nga ah pakhat in;
  </para>
  <para style="p">
    <verse number="29" style="v" />hnarcheu an covo a simi chung khan na lak lai i Bawipa sin i pekchanhnak caah tlangbawi Eleazar kha na pek lai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Cun Israel mi nih an covo a simi hnarcheu chung khan, minung si hna seh, cawtum si hna seh, tuurun si hna seh, saṭil vialte si hna seh, sawm nga ah pakhat in na lak lai i Bawipa puan biakinn a zohkhenhtu Levi mi kha na pek hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cun Bawipa nih Moses nawl a pek bangin Moses le tlangbawi Eleazar nih an tuah.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ralkap nih an lakmi hranchaw chungin a taang rihmi cu tuu sing ruk sang sarih le thong nga,
  </para>
  <para style="p">
    <verse number="33" style="v" />caw sang sarih le thong hnih,
  </para>
  <para style="p">
    <verse number="34" style="v" />laa sang ruk le thong khat,
  </para>
  <para style="p">
    <verse number="35" style="v" />minung, pa a hngal lomi nu, an dihlak in sang thum le thong hnih an si.
  </para>
  <para style="p">
    <verse number="36" style="v" />Cun raldohnak ah a kalmi hna i an covo a simi hnarcheu cu tuu sing thum sang thum thong sarih za nga a si i,
  </para>
  <para style="p">
    <verse number="37" style="v" />Bawipa vo cu tuu za ruk sawm sarih panga an si.
  </para>
  <para style="p">
    <verse number="38" style="v" />Caw cu sang thum thong ruk an si i Bawipa vo cu sawm sarih le pahnih an si.
  </para>
  <para style="p">
    <verse number="39" style="v" />Laa cu sang thum le za nga an si i Bawipa vo cu sawm ruk le pakhat an si.
  </para>
  <para style="p">
    <verse number="40" style="v" />Minung cu sang khat le thong ruk an si i Bawipa vo cu sawm thum le pahnih an si.
  </para>
  <para style="p">
    <verse number="41" style="v" />Cun Moses nih Bawipa pekchanh awk a simi vo kha tlangbawi Eleazar cu, Bawipa nih Moses nawl a pek bang khan, a pek.
  </para>
  <para style="p">
    <verse number="42" style="v" />Cun Israel mi nih an covo a simi hnarcheu, Moses nih raldohnak ah a kalmi hna ta in a ṭhenmi —
  </para>
  <para style="p">
    <verse number="43" style="v" />mibu covo hnarcheu cu tuu sing thum sang thum thong sarih le za nga,
  </para>
  <para style="p">
    <verse number="44" style="v" />caw sang thum thong ruk,
  </para>
  <para style="p">
    <verse number="45" style="v" />laa sang thum za nga le
  </para>
  <para style="p">
    <verse number="46" style="v" />minung sang khat thong ruk an si —
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel mi covo a simi hnarcheu chung cun sawm nga ah pakhat lengmang, minung siseh, saṭil siseh, Moses nih a lak hna i Bawipa puan biakinn a zohkhenhtu Levi mi kha Bawipa nih Moses kha nawl a pek bangin a pek hna.
  </para>
  <para style="p">
    <verse number="48" style="v" />Cun ralkap bu a thongthong pawl cung i bawi hna, a thong pawl haotu hna le a za pawl haotu hna nih, Moses an va naih i
  </para>
  <para style="p">
    <verse number="49" style="v" />Moses sinah cun, “Na sal hna nih kan kut tang i a ummi ralkap hna cu kan rel hna i kannih sinin a baumi pakhat hmanh an um lo.
  </para>
  <para style="p">
    <verse number="50" style="v" />Bawipa hmaiah kannih caah remnak ser awkah Bawipa pekchanhmi thil kannih cio nih kan hmuhmi thil cu kan rak put, sui in sermi thil, bankhih le kutkhih tehna, min khenhnak kutdonghrolh tehna, hnatonh le ṭhi tehna,” tiah an ti.
  </para>
  <para style="p">
    <verse number="51" style="v" />Cun Moses le tlangbawi Eleazar nih annih sinin thil ah ser cangmi sui vialte cu an rak lak.
  </para>
  <para style="p">
    <verse number="52" style="v" />A thong pawl haotu hna le a za pawl haotu hna sin in Bawipa sinah an pekchanhmi sui cu shekel sang khat thong ruk za sarih le sawm nga a si.
  </para>
  <para style="p">
    <verse number="53" style="v" />(Ralkap nih hranchaw cu anmah ca cio ah an i lak).
  </para>
  <para style="p">
    <verse number="54" style="v" />Cun Moses le tlangbawi Eleazar nih a thong pawl le a za pawl haotu hna sinin sui kha an lak i Bawipa hmai i Israel mi hngalh camcinnak caah tonnak thlam chungah an luhpi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Reuben fapa hna le Gad fapa hna cu saṭil tampi an ngei. Jazer ram le Gilead ram cu an hmuh i zohhmanh, cu hmun cu saṭil ram a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cucaah Gad fapa hna le Reuben fapa hna cu Moses le tlangbawi Eleazar le mibu hruaitu hna sinah khan an ra i,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ataroth, Dibon, Jazer, Nimrah, Heshbon, Elealeh, Sebam, Nebo, le Beon,
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawipa nih Israel mibu hmaiah a teimi ram hi, saṭil ram a si, cun na salle hna nih hin saṭil kan ngei,” tiah an ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun annih nih, “Nangmah hmaiah mithmai ṭha kan hmuh a si ahcun, hi ram hi na sal hna cu kan coter tuah; Jordan tiva ral ah cun kan kalpi hlah,” tiah an ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sihmanhsehlaw Moses nih Gad fapa hna le Reuben fapa hna sinah cun, “Nan unau hna cu ral an doh lioah nanmah nih hika ah hin nan ṭhu ko lai maw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Bawipa nih a pekmi hna ram chung i vung luh awk kha zeicaahdah Israel mi cu an lung nan donghter hna lai?
  </para>
  <para style="p">
    <verse number="8" style="v" />Hi bantuk ṭhiamṭhiam hin nan pale nih khan an rak tuah, ram va zoh awkah Kadesh-barnea in ka thlah tik hna ah khan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zeitintiah Eshkol Nelrawn ah an hung kal i ram kha an hmuh tikah Israel mi hna cu Bawipa nih a pekmi hna ram chung i luh awk kha an lung an donghter hna.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun cu ni ah cun Bawipa thinhunnak cu a alh i chiatser in,
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Izipt ram in a chuakmi, kum kul in a cunglei paohpaoh nih, an ka zulh taktak lo caah, Abraham, Isak, le Jakob sinah pek awk i chiat ka sermi ram cu an hmu hrimhrim lai lo;
  </para>
  <para style="p">
    <verse number="12" style="v" />Keniz phun Jefunneh fapa Kaleb le Nun fapa Joshua lawnglawng nih, Bawipa kha an zulh taktak caah an hmuh lai,’ tiah a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun Bawipa thinhunnak cu Israel cungah a alh i ramlak ah khan kum sawm li a vaihter hna, Bawipa hmai i ṭhat lonak a tuahmi chan an thih dih hlantiang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Cun, zohhmanh, Israel cungah Bawipa thinhunnak ṭihnung cu karhter chinchin awkah, nannih misual bu, nan pale can ah atu nan tho!
  </para>
  <para style="p">
    <verse number="15" style="v" />Nannih Reuben mi hna le Gad mi hna nih Bawipa kha zul loin nan pial ahcun, ramlak ah hi mi hna hi a kaltak ṭhan ko hna lai i hi mi vialte hi nan hrawh ko hna lai pei,” tiah a ti hna.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cun an ra naih i, “Hika ah hin kan tuurun hna caah tuukawm le kan ngakchia hna caah khua kan ser hna lai,
  </para>
  <para style="p">
    <verse number="17" style="v" />sihmanhsehlaw Israel mi hna hmaiah kal awk i tim in an umnak hmun kan phakpi hna hlantiang hriamnam kan tlai lai; cun hi ram mi hna ruangah hin kan fale hna cu ralhruang ngeimi khua ah cun an um lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel mi nih an ro cio an co hlantiang kan inn ah kan kir lai lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Cun Jordan khattelei ral le a pin khi cu kan copi hna lai lo, zeicah tiah kannih kan ro cu Jordan tiva hi lei kam nichuahlei ah hin a si cang,” tiah an ti.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cucaah Moses nih annih cu, “Hi bangin nan tuah i raldoh awkah Bawipa hmai i kal awkah hriamnam nan tlaih i
  </para>
  <para style="p">
    <verse number="21" style="v" />nanmah lakah hriamnam tlaimi paohpaoh nih Bawipa mithmuh ah Jordan nan tan i Bawipa nih amah hmai in a ral kha a dawi hna i
  </para>
  <para style="p">
    <verse number="22" style="v" />a hmaiah ram cu tei a si hlantiang nan doh ahcun, cu hnuah cun nan kir lai i Bawipa sin le Israel sinah leiba zeihmanh nan ngei lai lo; cun hi ram cu Bawipa hmaiah nan vo a si lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sihmanhsehlaw cu bangin nan tuah lo ahcun, zohhmanh, Bawipa cungah nan sual cang; nan sualnak nih an langh hna lai kha vaa hngalh ko u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nan ngakchia hna caah khua ser u law, nan tuu hna caah kawm kulh ko u; cun bia nan i kammi cu tuah ko u,” tiah a ti.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cun Gad fapa hna le Reuben fapa hna nih Moses sinah cun, “Ka bawipa nawl pek bangin na salle nih kan tuah lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kan ngakchia hna le kan nupi hna le kan tuurun hna le kan saṭil vialte hna cu khika ah khin Gilead ram khua hna ah khin an rak um ko lai;
  </para>
  <para style="p">
    <verse number="27" style="v" />sihmanhsehlaw na salle hna, Bawipa hmai i raldoh awkah hriamnam a tlaimi vialte cu, ka bawipa nih a chim bangin kan lan ko lai,” tiah an ti.
  </para>
  <para style="p">
    <verse number="28" style="v" />Cucaah Moses nih anmah kong ah cun tlangbawi Eleazar le Nun fapa Joshua le Israel miphun hna chung i hrin hna an lu cio cu nawl a pek hna.
  </para>
  <para style="p">
    <verse number="29" style="v" />Cun Moses nih annih sinah, “Gad fapa hna le Reuben fapa hna, Bawipa hmai i raldoh awkah hriamnam a tlaimi vialte cu, nanmah le Jordan kha an tan i nannih hmaiah ram cu tei a si ahcun, Gilead ram cu annih kha covo ah nan pek hna lai;
  </para>
  <para style="p">
    <verse number="30" style="v" />sihmanhsehlaw annih nih hriamnam tlaih in nannih he an lanh lo ahcun Kanaan ram chungah nanmah lakah covo an ngei ve lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cun Gad fapa hna le Reuben fapa hna nih an leh i, “Na sal hna sinah Bawipa nih a chim bangin kan tuah lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bawipa hmaiah hriamnam put in Kanaan ram chungah kan lan lai i kan co hngami ram cu Jordan tiva ral ah hin a si ko lai,” tiah an ti.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cun Moses nih annih Gad fapa hna le Reuben fapa hna le Josef fapa Manasseh phun a cheu cu Amor mi Siangpahrang Sihon ram le Bashan Siangpahrang Og ram, cu ram le a khuapi hna le an pawngkam ram le cu ram chung i a ummi khua vialte he, a pek hna.
  </para>
  <para style="p">
    <verse number="34" style="v" />Cun Gad fapa hna nih cun Dibon, Ataroth, Aroer,
  </para>
  <para style="p">
    <verse number="35" style="v" />Atroth-shofan, Jazer, Jogbehah,
  </para>
  <para style="p">
    <verse number="36" style="v" />Beth-nimrah le Beth-haran, ralhau ngeimi khua hna le tuukawm cu an ser hna.
  </para>
  <para style="p">
    <verse number="37" style="v" />Cun Reuben fapa hna nih Heshbon, Elealeh, Kiriathaim,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nebo le Baal-meon (an min cu thlen a si cang) le Sibmah an ser hna; khua an sermi hna cu min dang an bunh hna.
  </para>
  <para style="p">
    <verse number="39" style="v" />Cun Manasseh fapa Makhir i fapa hna cu Gilead ah an kal i an lak i a chungah a ummi Amor mi kha an pawnchuah hna.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cun Moses nih Gilead cu Manasseh fapa Makhir kha a pek i cuka ah cun a um.
  </para>
  <para style="p">
    <verse number="41" style="v" />Cun Manasseh fapa Jair nih a kal i an khuate cu a lak hna i Havvoth-jair tiah min a sak hna.
  </para>
  <para style="p">
    <verse number="42" style="v" />Cun Nobah nih a kal i Kenath le a khuate kha a lak hna i amah min chuankhan in Nobah tiah min a sak.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel mi cu Izipt ram in Moses le Aaron nih an hruai hna i an bubu in an chuah tikah, mah hihi an riahhmun lengmang cu an si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bawipa nawlbia bangin, Moses nih an i thawhnak hmun hna cu aa chang lengmang in a ṭial hna i, mah hna hi an i thawhnak hmun hna ning in an riahnak hmun hna cu an si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thla khatnak thla, cu thla khatnak thla a ni hleinga ni ah, Rameses in an i thawh; lanhtak a thaizing ah Israel mi hna cu Izipt mi vialte hmuh ah teinak in an kal.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cu lioah cun Izipt mi hna cu annih lak i Bawipa nih a thahmi an fater hna kha an vui hna; an pathian hna cung zongah Bawipa nih biaceihnak a tuah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cucaah Israel mi cu Rameses in an i thawh i Sukkoth ah an riak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sukkoth in an tho i ramlak ri i a ummi Etham ah an riak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Cun Etham in an tho i Baal-zefon in nichuahlei ah a ummi Pi-hahiroth ah an kir i Migdol hmaiah an riak.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Hahiroth hmai cun an tho i rili cu an tan i ramlak ah cun an lut i Etham ramlak ah cun ni thum an kal i Marah ah an riak.
  </para>
  <para style="p">
    <verse number="9" style="v" />Marah cun an chuak i Elim an phan; Elim ah cun cerh hleihnih le ung kung sawm sarih an um i cuka ah cun an riak.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun Elim in an tho i Rili Sen pawngah an riak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rili Sen cun an tho i Sin ramlak ah an riak.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sin ramlak cun an tho i Dofkah ah an riak.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun Dofkah in an tho i Alush ah an riak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alush in an tho i Refidim ah an riak; cuka ah cun mi caah din awk ti a um lo.
  </para>
  <para style="p">
    <verse number="15" style="v" />Refidim cun an tho i Sinai ramlak ah an riak.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sinai ramlak cun an tho i Kibroth-hattaavah ah an riak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kibroth-hattaavah cun an tho i Hazeroth ah an riak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hazeroth in an tho i Rithmah ah an riak.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rithmah in an tho i Rimmon-perez ah an riak.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rimmon-perez in an tho i Libnah ah an riak.
  </para>
  <para style="p">
    <verse number="21" style="v" />Libnah in an tho i Rissah ah an riak.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rissah in an tho i Kehelathah ah an riak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kehelathah in an tho i Shefer Tlang ah an riak.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shefer Tlang in an tho i Haradah ah an riak.
  </para>
  <para style="p">
    <verse number="25" style="v" />Haradah in an tho i Makheloth ah an riak.
  </para>
  <para style="p">
    <verse number="26" style="v" />Makheloth in an tho i Tahath ah an riak.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahath in an tho i Terah ah an riak.
  </para>
  <para style="p">
    <verse number="28" style="v" />Terah in an tho i Mithkah ah an riak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mithkah in an tho i Hashmonah ah an riak.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hashmonah in an tho i Moseroth ah an riak.
  </para>
  <para style="p">
    <verse number="31" style="v" />Moseroth in an tho i Bene-jaakan ah an riak.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bene-jaakan in an tho i Hor-haggidgad ah an riak.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hor-haggidgad in an tho i Jotbathah ah an riak.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jotbathah in an tho i Abronah ah an riak.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abronah in an tho i Ezion-geber ah an riak.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ezion-geber in an tho i Zin ramlak ah an riak (mah cucu Kadesh a si).
  </para>
  <para style="p">
    <verse number="37" style="v" />Cun Kadesh in an tho i Hor Tlang, Edom ramri ah khan an riak.
  </para>
  <para style="p">
    <verse number="38" style="v" />Cun tlangbawi Aaron cu Bawipa nawl pek bangin, Hor Tlang ah cun a hung kai i, Izipt ram in Israel mi nih an chuah hnu kum sawm linak, thla nganak thla, ni khat ni ah cun khika ah a thi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Aaron cu Hor Tlang cung i a thih tikah kum za khat le kum kul le kum thum a si.
  </para>
  <para style="p">
    <verse number="40" style="v" />Cun Kanaan miphun Arad siangpahrang, Kanaan ram chung Negeb i a ummi nih Israel mi an rat thawng kha a theih.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hor Tlang in an tho i Zalmonah ah an riak.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zalmonah in an tho i Punon ah an riak.
  </para>
  <para style="p">
    <verse number="43" style="v" />Punon in an tho i Oboth ah an riak.
  </para>
  <para style="p">
    <verse number="44" style="v" />Oboth in an tho i Moab ram chung i a ummi Iye-abarim ah an riak.
  </para>
  <para style="p">
    <verse number="45" style="v" />Iyim in an tho i Dibon-gad ah an riak.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dibon-gad in an tho i Almon-diblathaim ah an riak.
  </para>
  <para style="p">
    <verse number="47" style="v" />Almon-diblathaim in an tho i Nebo hmai i a ummi Abarim tlang ah an riak.
  </para>
  <para style="p">
    <verse number="48" style="v" />Abarim tlang in an tho i Moab nelrawn Jordan tiva kam Jeriko zawn ah an riak;
  </para>
  <para style="p">
    <verse number="49" style="v" />Jordan tiva kamah cun Beth-jeshimoth in Abel-shittim tiang, Moab nelrawn ah cun an riak.
  </para>
  <para style="p">
    <verse number="50" style="v" />Cun Bawipa nih Moses cu, Moab nelrawn Jordan tiva kam Jeriko zawn ah cun a chawnh i,
  </para>
  <para style="p">
    <verse number="51" style="v" />“Israel mi sinah hi bangin va chim tuah, Jordan tiva nan tan i Kanaan ram chungah nan luh tikah,
  </para>
  <para style="p">
    <verse number="52" style="v" />nan hmai in cu ram i a ummi vialte cu nan dawi hna lai i an lung ṭial vialte kha nan hrawh lai i, thletmi an siasal vialte kha nan hrawh lai i, an khuahrum bo vialte kha nan chimh dih lai.
  </para>
  <para style="p">
    <verse number="53" style="v" />Cun ram cu nan co lai i a chungah nan um lai, zeitintiah, co awkah cu ram cu kan pek cang hna.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ram cu nan hrinning cio in camcawh fung khiah in nan co lai; phun ngan deuh cu ro ngan deuh nan pek lai i phun hme deuh cu ro hme deuh nan pek lai; ahohmanh nih camcawh fung khiah in a hmuhmi hmun paoh cu, cu hmun cu amah ta a si lai; nan pupa hna phun ning cio ah nan co lai.
  </para>
  <para style="p">
    <verse number="55" style="v" />Sihmanhsehlaw cu ram i a ummi hna cu nan hmai in nan dawi hna lo ahcun, nan taantermi hna cu nan mit chungah hling le nan hrappang ah chuntu bantuk an si lai i nannih nan umnak ram chungah cun harnak an in pek hna lai.
  </para>
  <para style="p">
    <verse number="56" style="v" />Cun an cung i tuah awk ka ruahmi kha nan cungah ka tuah lai,” tiah a ti.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi cu nawl pe hna law, hi bangin chim hna, Kanaan ram ah nan luh tikah (mah ram hi nan co awk hnga ram cu a si, Kanaan ram hi a ning piin),
  </para>
  <para style="p">
    <verse number="3" style="v" />nan thlanglei kam cu Zin ramlak in Edom kam hrawn in a si lai i, thlanglei nan ramri cu nichuahlei ah Cite Rili donghnak in a si lai;
  </para>
  <para style="p">
    <verse number="4" style="v" />cun nan ramri cu Akrabbim hung kainak thlanglei ah khan aa mer lai i Zin tiang a phan lai i a donghnak cu Kadesh-barnea thlanglei ah a si lai; cun Hazar-addar ah a hei kal lai i Azmon tiang a lan lai;
  </para>
  <para style="p">
    <verse number="5" style="v" />cun ramri cu Azmon in Izipt Tiva tiang aa mer lai i a donghnak cu Rili ah a si lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Nitlaklei ramri caah cun Rili Ngan le a kam kha nan tin lai; mah cucu nitlaklei nan ramri a si lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Mah hihi chaklei nan ramri cu a si lai: Rili Ngan in Hor Tlang tiang nan rin lai;
  </para>
  <para style="p">
    <verse number="8" style="v" />Hor Tlang in Hamath luhnak tiang nan rin lai i ramri a donghnak cu Zedad ah a si lai;
  </para>
  <para style="p">
    <verse number="9" style="v" />cun ramri cu Zifron tiangin a hei kal rih lai i a donghnak cu Hazar-enan ah a si lai; mah hihi chaklei nan ramri a si lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Nichuahlei nan ramri cu Hazar-enan in Shepham tiang nan rin lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ramri cu Shepham in Ain nichuahlei i a ummi Riblah tiang a vung kal lai; ramri cu a vung kal lai i nichuahlei ah Khinnereth rili a liang tiang a vung phan lai;
  </para>
  <para style="p">
    <verse number="12" style="v" />cun ramri cu Jordan tiang a vung kal lai i a donghnak cu Cite Rili ah a si lai. Mah hihi nan ram le a velchum dihlak in a ramri cu an si lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Moses nih Israel mi cu nawl a pek hna i, “Mah hihi nannih nih camcawh fung khiah in nan co hnga mi, Bawipa nih phun kua le phun cheu hna sinah pek awk i nawl pekmi ram cu a si;
  </para>
  <para style="p">
    <verse number="14" style="v" />zeitintiah Reuben fapa hna phun nih an chung ning cio ah, cun Gad fapa hna phun nih an chung ning cio in vo an co cang i Manasseh phun cheu zong nih an co ve cang;
  </para>
  <para style="p">
    <verse number="15" style="v" />phun hnih le phun cheu hna nih khan Jordan tiva ral, Jeriko zawn, nichuahlei ah khan an vo an co cang, nichuahnak lei kamah khan,” tiah a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Mah hna hi nan co awkah ram an phawtu hna an min cu a si lai: tlangbawi Eleazar le Nun fapa Joshua.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ram cu co awk i a phawtu ah phun khat in hruaitu pakhat na lak lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mah hihi an min cu a si: Judah phun in Jefunneh fapa Kaleb.
  </para>
  <para style="p">
    <verse number="20" style="v" />Simeon fapa hna phun in Ammihud fapa Shemuel.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin phun in Khislon fapa Elidad.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan fapa hna phun in hruaitu pakhat, Jogli fapa Bukki.
  </para>
  <para style="p">
    <verse number="23" style="v" />Josef fapa hna chungin: Manasseh fapa hna phun in hruaitu pakhat Efod fapa Hanniel.
  </para>
  <para style="p">
    <verse number="24" style="v" />Cun Efraim fapa hna phun in hruaitu pakhat Shiftan fapa Kemuel
  </para>
  <para style="p">
    <verse number="25" style="v" />Zebulun fapa hna phun in hruaitu pakhat Parnak fapa Elizafan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Issakhar fapa hna phun in hruaitu pakhat, Azzan fapa Paltiel.
  </para>
  <para style="p">
    <verse number="27" style="v" />Asher fapa hna phun in hruaitu pakhat, Shelomi fapa Ahihud.
  </para>
  <para style="p">
    <verse number="28" style="v" />Naftali fapa hna phun in hruaitu pakhat, Ammihud fapa Pedahel.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mah hna hi Kanaan ram chungah Israel mi nih an covo a phawtu dingah Bawipa nih nawl a pekmi hna cu an si,” tiah a ti.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bawipa nih Moses cu Moab nelrawn Jordan tiva kam Jeriko zawn ah khan a chawnh i,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi cu nawl pe hna law, an comi ram chungin Levi mi cu umnak khua pe hna seh; cun Levi mi hna cu khua velchum i phong ram cu nan pek hna lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khua cu annih umnak caah an si lai i an phong ram hna cu an caw le an ṭilva le an saṭil vialte caah an si lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Levi mi hna sinah nan pek laimi khua i an phong ram hna cu khua kulhnak hau in dong thong khat a velchum in an phan lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun khua lengah cun nichuahlei kamah dong thong hnih, thlanglei kamah dong thong hnih, nitlaklei kamah dong thong hnih, chaklei kamah dong thong hnih nan tah lai i khua cu a laifang ah a um lai; mah hihi an khua hna ca i phong ram caah an ta a si lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi mi nan pekmi hna khua cu himnak khua paruk kha an si lai, cuka ah cun mi that paoh zamnak nan awnh hna lai, cun cu hna hleiah khua sawm li le khua hnih nan pek hna lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Levi mi nan pekmi khua vialte hna cu sawm li le pariat, an phong ram cio he, an si lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Cun Israel mi hna ngeihmi chungin nan pek laimi khua hna cu, phun ngan deuh in tam deuh nan lak lai i phun hme deuh in tlawm deuh nan lak lai; anmah le an covo a tlawm a tam ningin an khua hna cu Levi mi sinah an pek cio hna lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cun Bawipa nih Moses cu a chawnh i,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel mi cu hi bangin chim tuah hna, Jordan tiva nan tan i Kanaan ram nan luh tikah,
  </para>
  <para style="p">
    <verse number="11" style="v" />timhnak ngei loin mi a thatmi paoh nih an zamnak dingah nannih caah himnak khua caah khua nan i thim lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Biaceih awkah mibu hmaiah a dir hlanah mithattu cu a thih nakhnga lo, cu khua hna cu nannih caah phuhlamtu sinin himnak an si lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cun nan pekmi khua hna cu nan himnak khua paruk an si lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himnak khua caah Jordan tiva ral ah khua pathum, Kanaan ram chungah khua pathum nan pek lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hi khua paruk hna hi Israel mi ca le phun dangmi le an sinah a pemmi khual hna caah an si lai, timhnak ngei loin mi a thatmi paoh nih cuka ah an zam khawh nakhnga.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Sihmanhsehlaw thir hriamnam in a tuk i a thih ahcun, amah cu lainawng a si; lainawng cu thah awk a si lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Cun minung a that khomi lung aa putmi in a den i a thih ahcun amah cu lainawng a si; lainawng cu thah awk a si lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Asiloah minung a that khomi thing hriamnam aa putmi in a tuk i a thih ahcun, amah cu lainawng a si; lainawng cu thah awk a si lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thisen phuhlamtu amah theng nih lainawngmi cu a thah lai; a ton tikah a thah lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cun huatnak ruangah a nam ah siseh, a bawh i a cheh ah siseh, a thih ahcun,
  </para>
  <para style="p">
    <verse number="21" style="v" />cun ralnak ruangah a kut in a thongh i a thih ahcun, a thongtu cu thah a si lai; amah cu lainawng a si; thisen phuhlamtu nih lainawng cu a thah lai, a ton tikah.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Sihmanhsehlaw huatnak um loin a nam sual ah siseh, bawh loin a cheh sual ah siseh,
  </para>
  <para style="p">
    <verse number="23" style="v" />a ral a si lo i a ṭhat lonak a kawl lo nain mi thih khawhnak lung a hman i hmuh loin amah cu a thlakhnawh i a thih ah siseh,
  </para>
  <para style="p">
    <verse number="24" style="v" />cu tikah mi thatpa le thisen phuhlamtu karlak ah cun, hi phunglam hna ning hin, mibu nih bia an ceih lai;
  </para>
  <para style="p">
    <verse number="25" style="v" />cun mibu nih cun mi thattu cu thisen phuhlamtu kut chungin an khamh lai i, mibu nih cun a zamnak khua himnak khua ah khan an kirter ṭhan lai i, a thiangmi chiti thuhmi tlangbawi ngan kha a thih hlantiang cu ka ah cun a um lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sihmanhsehlaw mi thattu kha zeitik caan hmanh ah a zamnak himnak khua ramri lengah khan a chuah i
  </para>
  <para style="p">
    <verse number="27" style="v" />cu a himnak khua ramri lengah cun thisen phuhlamtu nih khan a hmuh i mi thattu cu thisen phuhlamtu nih khan a thah ahcun, amah cungah thisen mawhnak a um lai lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zeitintiah cu pa cu a himnak khua ah cun tlangbawi ngan kha a thih hlantiang um awk a herh; sihmanhsehlaw tlangbawi ngan a thih hnuah cun mi thattu kha amah ram ah a kir kho lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Cun mah thil hna hi nan caah nan tefa chin tiangin nan umnak kip ah nawlbia le phunglam an si lai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi pakhatkhat nih mi a thah ahcun lainawngtu cu hngaltu hna chimmi bia ningin thah a si lai; sihmanhsehlaw hngaltu pakhat lawng chimmi bia cu thah awk biakhiahnak caah a za lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cu hleiah thih awk a tlakmi lainawngtu caah cun tlanh man zeihmanh nan cohlang lai lo; amah cu thah awk a si ko.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun a himnak khua ah a zam i amah ram chung i um awkah kir a duhmi caah, tlangbawi ngan a thih hlanah cun, tlanh man zeihmanh nan cohlang lai lo.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cu bantukin nan umnak ram cu nan thurhhnawmh lai lo, zeitintiah thi nih ram cu a thurhnawmter i cu thi a chuahtertu thi lila dah ti lo nih cun, cu ram chung thletmi thi caah tlenghnak a tuah khotu zeihmanh a um lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nan umnak ram, ka umnak hi nan thurhnawmter lai lo; zeitintiah Bawipa keimah cu Israel mi lakah ka um,” tiah a ti.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Josef fapa hna phun cung i a ummi Manasseh fapa Makhir i fapa Gilead fapa hna i chungkhar hna chung i phun lu cio a simi hna nih an ra naih i Moses hmai le hruaitu hna, Israel miphun lu cio a simi hna, hmaiah khan an chim;
  </para>
  <para style="p">
    <verse number="2" style="v" />annih nih, “ Bawipa nih ka bawipa kha camcawh fung khiah in Israel mi cu ram kha ro ca i pek awkah nawl an pek; cun ka bawipa cu Bawipa nih kan unau Zelofehad ro cu a fanu hna sinah pek awkah nawl an pek.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sihmanhsehlaw Israel miphun chung i hrin dang sinah va an ngeih ahcun, an ro cu kan pupa hna ro chungin lak a si lai i an fonhmi hrin hna ro ah khan chap a si hnga. Cucaah kannih kan ro kan covo chungin mah cucu lak a si hnga.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cun Israel mi jubili a phak tikah, an ro cu an fonhmi hna hrin i ro ah chap a si lai i kan pa hrin ro chungin an ro cu lak a si lai,” tiah an ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun Moses nih Israel mi cu Bawipa bia ningin nawl a pek hna i, “Josef fapa hna phun hi an dik ko.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mah hihi Zelofehad fanu hna kong ah Bawipa nawl pekmi cu a si, ‘A ṭha bik tiah an ruahmi kha va hna seh; sihmanhsehlaw an pa phun innchungkhar chung mi lawnglawng va hna seh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel mi an ro cu hrin khat in hrin dang ah ṭhial si hlah seh, zeitintiah Israel mi vialte nih an pupa phun ro cio kha an i tlaih lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel mi vialte nih an pupa ro cio an ngeih khawh nakhnga, Israel miphun chung i ro a ngeimi fanu paohpaoh cu a pa phun innchungkhar chung mi kha a vat awk a si lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Cucaah hrin khat in hrin dang ah ro zeihmanh ṭhial a si lai lo, zeitintiah Israel miphun vialte nih anmah le an ro cio kha an i tlaih lai,’ ” tiah a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bawipa nih Moses nawl a pek bangin Zelofehad fanu hna nih an tuah;
  </para>
  <para style="p">
    <verse number="11" style="v" />Mahlah, Tirzah, Hoglah, Milkah le Noah, Zelofehad fanu hna nih an pa unau le fapa kha an vat hna.
  </para>
  <para style="p">
    <verse number="12" style="v" />Josef fapa Manasseh i fapa hna chungkhar kha an vat hna i an ro cu an pa innchungkhar phun chungah khan a tang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mah hihi Bawipa nih Moab nelrawn Jordan tiva kam Jeriko zawn ah khan Moses sinin Israel mi kha a pekmi hna nawlbia le phunglam cu an si.
  </para>
</usx>
