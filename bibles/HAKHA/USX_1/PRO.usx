<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Phungthlukbia</book>
  <para style="h">Phungthlukbia</para>
  <para style="toc1">Phungthlukbia</para>
  <para style="toc2">Phungthlukbia</para>
  <para style="mt">Phungthlukbia</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />David fapa Solomon, Israel siangpahrang phungthlukbia:
  </para>
  <para style="p">
    <verse number="2" style="v" />Hi phungthlukbia thawng hin Mi nih fimnak le cawnpiaknak kha an hngalh lai i Ruahnak thuk bia kha an hngalhthiam lai i
  </para>
  <para style="p">
    <verse number="3" style="v" />Umtuzia thiamnak le dinnak le biading ca le i ruannak ding ca i cawnpiaknak kha an hmuh lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lungtlawm mi nih fimnak an hmuh lai i Seino mi nih hngalhnak le ruahthiamnak an hmuh lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Cun mifim zong nih an ngaih ahcun an fimnak a ṭhang lai i Hngalhthiamnak a ngeimi nih thiamnak an hmuh chin lai i
  </para>
  <para style="p">
    <verse number="6" style="v" />Phungthluk bia hna le tahchunhnak bia hna le Mifim mi hna an bia le an biahar kha an hngalh khawh hna lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bawipa ṭih hi hngalhnak hramthawknak a si; Sihmanhsehlaw mihrut nih cun fimnak le cawnpiaknak kha zei ah an rel lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka fapa, na pa cawnpiaknak cu ngai law Na nu ṭhithruainak cu hlaw hlah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zeicahtiah na lu caah aa dawhmi pangpar ṭhi rual an si lai i Na hngawng caah pumṭek ṭhi an si lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka fapa, misual mi nih an in lem ahcun, na hna tlakpi hna hlah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Annih nih an in thawh i, “Kan sinah ra ve, thisen chuah awkah bawh hna u sih, A sual lomi cu thlachiat ruat loin lamhruang ah hna u sih;
  </para>
  <para style="p">
    <verse number="12" style="v" />Sheol bantukin an nung na bu in dolh hna u sih; Sualnak an ngei lo nain khor chung i a vung kalmi hna bantuk khi si hna seh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thil man sung vialte cu kan lak dih hna lai i Kan inn cu hranchaw in kan khahter hna lai;
  </para>
  <para style="p">
    <verse number="14" style="v" />Kan sinah i tel ve ko, Tangka bawm kan i hrawm lai,” an in ti tikah,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka fapa, an sinah cun kal ve hlah, An lam kha zul hlah;
  </para>
  <para style="p">
    <verse number="16" style="v" />Zeicahtiah an ke cu ṭhat lonak leiah a tlik in an tli i Thisen chuah awkah a nam in an i nam.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vate hmuhhngan i chiahmi rap cu pakpalawng a si tawn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sihmanhsehlaw hi mi hna nih an bawhmi cu anmah thisen lila kha a si i Lamhruang an ahmi cu anmah nunnak lila kha a si ko.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zaang-ennak in miaknak hmuh a duhmi hna lam cu hi bantuk hi a si. Hakkauhnak nih an nunnak kha a hloh tawn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khuachung lam ah khan fimnak cu a au, Chawdawrnak hmun ah khan a au;
  </para>
  <para style="p">
    <verse number="21" style="v" />Kulhnak vampang cung khan a au i Khua chung luhnak kutka hna ah khan bia a chim:
  </para>
  <para style="p">
    <verse number="22" style="v" />“Zei can dah maw mihrut rual hna, hruh kha nan duh rih ko lai? Zei can dah, mi nihsawh hmangmi hna, mi nihsawh kha a nuam nan ti lai i mihrut nih fimnak kha nan huat lai?
  </para>
  <para style="p">
    <verse number="23" style="v" />Kan chimhhrin hnanak kha nan ngaih ahcun ruahnak kha kan cheuh hna lai i Ka bia kha kan cawnpiak hna lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sihmanhsehlaw kan kawh hna i ngaih nan duh lo, Ka kut kha ka samh i ahohmanh nih zei ah nan rel lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Fim kan chimhmi hna vialte kha nan hnon i Kan chimhhrin hnanak vialte cu zeihmanh nan duh lo caah,
  </para>
  <para style="p">
    <verse number="26" style="v" />Kei zong nih vanchiatnak nan ton ni ah le Launak nih an den hna tikah kan nihsawh men ve hna lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Launak nih thlichia bangin an den hna tik le Nan vanchiatnak cu phuchim bangin a rat i Harnak le vansang aunak nih an tlunhnawh hna tikah, a nih in kan nih men ko hna lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khi tikah cun an ka auh lai, sihmanhsehlaw ka let hna lai lo; An ka kawl len lai, sihmanhsehlaw an ka hmu lai lo.
  </para>
  <para style="p">
    <verse number="29" style="v" />Annih nih hngalhnak kha an huat i Bawipa ṭihnak kha an i thim lo caah
  </para>
  <para style="p">
    <verse number="30" style="v" />Lungthin ka cheuhmi hna kha pakhat hmanh an cohlang duh lo i Ka chimhhrin hnanak cu zeihmanh ah an rel lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Cucaah annih nih an ziaza theitlai cu an ei lai i Anmah khuakhannak lila nih cun a nor cikcek hna lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Zeicahtiah lungtlawm pawl cu anmah pialnak nih khan a thah hna i Mihrut hna cu zei ruat khak loin an umnak nih khan a hrawh hna,
  </para>
  <para style="p">
    <verse number="33" style="v" />Sihmanhsehlaw ka bia a ngaimi cu him tein an um lai i Vanchiatnak zeihmanh ṭih loin, zalong tein an um lai,” tiah a ti.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa ka bia kha naa lak hna i ka nawlbia kha na lung chungah naa khon hna i
  </para>
  <para style="p">
    <verse number="2" style="v" />Fimnak leiah na hna na chit i hngalhthiamnak leiah na lungthin na pek ahcun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahmaan le hmaanlo thleidan khawhnak lungthin kha na auh i hngalhthiamnak kha na kawh ahcun,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngun bantukin na kawl i thuhmi ro bantukin na kawl ahcun,
  </para>
  <para style="p">
    <verse number="5" style="v" />khi tikah Bawipa ṭihnak cu na hngalh lai i Pathian hngalhnak cu na hmuh lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zeicahtiah Bawipa nih cun fimnak kha a pek hna i hngalhnak le hngalhthiamnak kha a cawnpiak hna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miding mi hna caah fimnak ṭha kha a khon i ding tein a kalmi hna caah amah cu phaw a si i
  </para>
  <para style="p">
    <verse number="8" style="v" />Biading lam kha a ven i a mithiang mi hna lam kha a congh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khi tikah dinnak le biading cu na hngalh lai i miṭha mi hna lam kha na zulh lai;
  </para>
  <para style="p">
    <verse number="10" style="v" />Zeicahtiah fimnak cu na lung chungah a lut lai i na lungthin caah hngalhnak cu a nuammi a si lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Fimnak nih an ven lai, hngalhthiamnak nih an zohkhenh lai;
  </para>
  <para style="p">
    <verse number="12" style="v" />Miṭhalo hna lam chung khan an khamh lai i holh ṭhalo hmangmi hna sin khan an luatter lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Annih cu muihnak lam zulh awkah dinnak lam a hlawt i
  </para>
  <para style="p">
    <verse number="14" style="v" />Ṭhat lonak tuah ah aa lawm i hlenthawinak ah cun aa nuammi an si;
  </para>
  <para style="p">
    <verse number="15" style="v" />Annih lam cu a kawi i an thil tining ah midepde an si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nu zuangzam sinin an khamh lai i nu ralṭha, bia thlumthlum a hmang i
  </para>
  <para style="p">
    <verse number="17" style="v" />A no lio caan a hawikom kha a hlawt i a Pathian biakamnak a philhmi sin khan an khamh lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zeicahtiah a lam cu thihnak leiah a vung kal i mithi mi hna ram leiah khan a vung lan.
  </para>
  <para style="p">
    <verse number="19" style="v" />A sin i a va kalmi paoh cu ahohmanh an kir ti lo, nunnak lam zong an hmu ṭhan ti lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Cucaah miṭha mi hna lam cu zul law miding mi hna lam cu i tlaih tuah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zeicahtiah miding mi hna cu hi ram chungah hin khua an sa kho lai i ding tein khua a sami hna cu hi ram chungah hin an um lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sihmanhsehlaw miṭhalo hna cu ram chung khan hlonh an si lai i mi rawi hmangmi hna cu ram chung cun phawi an si lai.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, kan cawnpiaknak cu philh hlah, Sihmanhsehlaw na lung nih ka nawlbia cu i cinken ko hna seh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Zeicahtiah nun saunak le chan saunak le duhdim nunnuamhnak cu an in pek lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Felnak le zumh awk tlakmi sinak kha i chuahtakter hna hlah, Na hngawng ah i ngerh hna law na lung tlap cungah i ṭial hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cuticun Pathian le minung mithmuh ah Mithmai ṭha le thangṭhatnak na hmuh lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawipa kha na lung chung dihlak in i bochan law Nangmah fimnak kha i rinh hlah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na kalnak lam kip ah amah kha hngal law Amah nih na lam kha a tluanter hna lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mah mithmuh i a fimmi va si hlah; Bawipa kha ṭih law ṭhat lonak kha mertak ko.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na taksa caah damnak a si lai i na ruh caah si a si lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bawipa cu na chawva le na thilri theitlai hmasa bik hna in upat tuah;
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun na rawl inn cu khat thluahmah in an um lai i Na mitsur nennak khor cu mitsur hang in an liam lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka fapa, Bawipa chimhhrinnak cu zei rel loin um hin hlah. An mawhchiatnak nih cun in nor hlah seh,
  </para>
  <para style="p">
    <verse number="12" style="v" />Zeicahtiah pa nih a duhmi a fapa cu a chimhhrin bangin Bawipa nih a dawtmi kha a chimhhrin ve hna.
  </para>
  <para style="p">
    <verse number="13" style="v" />Fimnak a hmumi cu a lung aa lawm, hngalhthiamnak a ngeimi zong aa lawm ve;
  </para>
  <para style="p">
    <verse number="14" style="v" />Zeicahtiah fimnak cu ngun nakin a ṭha deuh i miaknak a chuahpimi cu sui nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Fimnak cu rubi lungvar man sungmi nakin a sung deuh, na hlawn vialte ah amah tluk zeihmanh an um lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nun saunak cu a orhlei kut chungah a um i a kehlei kut ah rumnak le upatnak an um.
  </para>
  <para style="p">
    <verse number="17" style="v" />A lam cu lam nuam an si i rumnak phakpitu lam an si.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah aa tlaihmi hna caah cun nunnak thingkung a si i amah kha fek tein aa tlaihmi cu him tein an um.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bawipa nih fimnak in vawlei kha a rak dirh; hngalhthiamnak in van kha a hmunhter hna;
  </para>
  <para style="p">
    <verse number="20" style="v" />A thiamnak thawngin ti thuk hna cu an i sat i khuadawm nih dap kha a thlak hna.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka fapa, fimnak ṭha le ruahthiamnak cu i ken hna, na mit hmuhnak chungin liamter hna hlah;
  </para>
  <para style="p">
    <verse number="22" style="v" />Annih cu na thlarau caah nunnak an si lai i na hngawng caah ṭamhnak an si lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khi tikah himbawm tein na kal lai i na ke cu an i chuihpah lai lo;
  </para>
  <para style="p">
    <verse number="24" style="v" />Na ṭhut ah na thin a phang lai lo, na ih tikah na mitkuh a thaw lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihrut mi hna cung i a tlungmi launak ruangah khan na thin va phang hlah; miṭhalo cung i a tlungmi rawhralnak ruang zongah khan na thin va phang hlah;
  </para>
  <para style="p">
    <verse number="26" style="v" />Zeicahtiah Bawipa cu na hnangamnak a si lai i na ke cu aa awh nakhnga lo amah nih an zohkhenh lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangmah kut chungah ṭhatnak tuah khawhnak kha a um tikah, a hmu hnga ding a simi sinin ṭhatnak kha va kham hlah.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangmah sinah naa chiah ko nain, “Va kal law ra ṭhan te, thaizing ah kan pek lai,” tiah na hawi kha ti hna hlah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangmah kha bochan in na pawngah khua a sa khirkhiarmi na innpa caah ṭhat lonak khua va khang hlah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na cungah ṭhat lonak zeihmanh a tuah lo ahcun, zei ruang lo ah aho he hmanh vaa si len hlah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zaang en hmangmi cu va hngar hna hlah, a lam zong kha zeihmanh vaa thim hlah;
  </para>
  <para style="p">
    <verse number="32" style="v" />Zeicahtiah mi lungthin ṭhalo cu Bawipa caah fihnung an si i miding mi cu Pathian nih a zumhmi an si.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bawipa chiatserhnak cu miṭhalo mi hna inn cungah a tlung i sihmanhsehlaw miding mi hna umnak cu thluachuahnak a pek.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mi zei ah a rel lomi hna cu zei ah a rel ve hna lo i mi toiah aa dormi hna cu duhdawtnak a pek hna.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mifim mi nih upatnak cu an co lai, sihmanhsehlaw mihrut mi nih zohchuknak kha an hmuh lai.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Maw ka fapale hna, nan pa cawnpiaknak hi ngai u law, hngalhnak nan ngeih khawh nakhnga ṭha tein ngai tuah u;
  </para>
  <para style="p">
    <verse number="2" style="v" />Zeicahtiah nunchimhnak kan pekmi hna cu a ṭhami nunchimhnak an si i Kan cawnpiaknak hna hi hlaw hlah u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka pa caah ngakchia ka rak si i ka nu caah fapa dawt, a nomi ka rak si tikah khan,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka pa nih cun a ka cawnpiak i, “Ka bia hi na lung in fek tein i tlaih hna, ka nawlbia hi zul hna law nung tuah;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka chimmi bia hi philh hna hlah law i theihter duh loin um hna hlah.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hmasa bik ah a herhmi cu fimnak hmuh hi a si; hngalhthiamnak kha na ngeihmi vialte na hloh dih ding a si zongah i cawk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Fimnak cu hlaw hlah, amah nih cun him tein an zohkhenh lai; amah cu daw law an huhphenh lai;
  </para>
  <para style="p">
    <verse number="8" style="v" />Na lung chungah i chiah law sangpi ah an cawi lai, i pom law upatnak an phakter lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aa dawhmi pangpar rual na lu cungah a chiah lai i nangmah cu sunparnak luchin an pek lai,” tiah a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka fapa, ka bia cu ngai law pom hna, na nunkhua a sau lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Fimnak lam kha kan cawnpiak lai i dinnak lam ah khan kan hruai lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na kal tikah na ril lai lo i na tlik zongah zeihmanh nih an tlukter lai lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Cawnpiaknak kha i tlaih peng law thlah hlah; Cucu zul peng tuah, na nunnak a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miṭhalo hna lam ah cun lut hlah, miṭhalo hna lam cu zul hlah;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hrial law a cungah cun kal hlah, pialtak law kaltak ko.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zeicahtiah annih cu thil sual pakhat tal an tuah lo ahcun an it kho lo i mi pakhat tal an tlukrilhter hna lo ahcun an i hngilh kho lo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ṭhat lonak changreu kha an ei i zaang-ennak zu kha an din.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sihmanhsehlaw miding mi hna lam cu zingka ceunak, chun laicer tiangin a ceu chin lengmangmi bantuk a si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Miṭhalo hna lam cu zan muihnak bantuk a si, Zei cungah dah kan tluk i kan rilh ti kha an hngal lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa ka bia cu ngai hna law ka chimmi cu na hna chi tuah hna.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lung chungah i chiah hna law lohter hna hlah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zeicahtiah aa hmuhmi caah cun nunnak an si i a pum dihlak damnak an si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na lung kha ṭha tein veng tuah, Zeicahtiah cuka cun nunnak cerhti kha a put.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hrokhrawl bia cu na kaa chungin chuahter hna hlah law Depdetnak bia cu hlaw diam ko hna.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na mit nih ding tein hmailei kha zoh ko hna seh, Na hmai i a ummi thil cu fek tein i zohchih ko.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na ke nih a lamhmi lam kha ṭha tein zoh law cuticun him tein na kal kho lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Orhlei ah siseh, kehlei ah siseh, pial hlah; Ṭhat lonak vialte kha hrial dih hna.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka fimnak kha ṭha tein i ngaih law lungthin kan cheuhmi kha ṭha tein na hna chi tuah;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ruahthiamnak kha na ngei kho lai i na chimmi cu hngalhnak in chimmi a si lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nu zuangzam hmur in khuaihliti dor an tla i a biachimmi cu chiti nakin a nal deuh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sihmanhsehlaw a donghnak ah cun anfangkha bantukin a kha i kap hnih har nam bantukin a har.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ke cu thihnak ah an vung kal i a kehlan cu Sheol lei lam kha an zul;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nunnak lei lam kha zei ah a rel lo; a lam cu a kenkip ah an vak i cucu a hngal lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Atu cu, ka fapa, ka bia kha ngai law ka kaa chung chuak bia hi zeirel lo in um hna hlah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nu zuangzam kha lamhlat piin hrial law a inn innka pawngah va kal hlah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hmaizahnak na hmuhmi kha midang mithmuh ah na thlau sual lai i zaangfahnak ngei lomi hna sinah na upatnak kha na hloh sual lai;
  </para>
  <para style="p">
    <verse number="10" style="v" />Ramdangmi kha na ṭhawnnak in an khim sual lai i na rianṭuanmi man cu na hngalh lomi miding innchungkhar sinah a kal sual lai;
  </para>
  <para style="p">
    <verse number="11" style="v" />A donghnak ah cun rawlṭam in na um lai i na ruh lawngin khua na sa lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khi tikah naa thawh lai i, “Zeicahdah chimhhrinnak kha ka rak huat i mawhchiatnak kha ka lung nih a rak duh hnga lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka sayate aw kha ka rak ngai lo i a ka cawnpiaktu hna an bia kha zei ah ka rak rel hna lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aa pummi mibu chungah khan, minchiatnak ka rak hmu ciaomau ko lo mei?” na ti lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmah tikuang ti te ding law na tikhor chungin a luangmi ti te kha ding tuah.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tiput hna cu a kenkip ah ṭhekter hna hlah law khualak lam ah tiva cu i ṭhek hna hla seh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Annih cu nangmah ca lawngah si ko hna seh, na sin i a ummi khual hna caah cun si chih hna hlah seh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tikhor cu thluachuahnak hmu seh law na tlanval lio i na nupi ah khan i lawm ko;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah cu sazuk duhnung ngai le aa dawhmi sakhi bantuk a si; a hnuk nih cun zeitik paoh ah na lung in riamhter seh law a dawtnak nih cun in lawmhter zungzal ko seh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, zeicahdah mi zuangzam cu na duh i nu ralṭha cu na pom?
  </para>
  <para style="p">
    <verse number="21" style="v" />Zeicahtiah mi nih a zulhmi a lam vialte cu Bawipa nih a hmuh dih ko i Bawipa nih cun a lam vialte cu a zoh dih ko.
  </para>
  <para style="p">
    <verse number="22" style="v" />Miṭhalo cu amah ṭhat lonak ah aa foih i a sual rianṭuannak ah khan a tang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chimhhrinnak a um lo caah a thi i a hruhnak a ngan caah a tlau.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, na innpa caah biahrennak i na can i Khualpa caah aamahkhannak na tuahpiak i
  </para>
  <para style="p">
    <verse number="2" style="v" />aa bia chimmi ah naa foih i na kaa in a chuakmi bia ah na tan ahcun,
  </para>
  <para style="p">
    <verse number="3" style="v" />Khi tikah, ka fapa, nangmah cu na innpa kut chungah na tlak cang caah Mah hihi tuah law i khamh tuah: Khulrang in va kal law mipa cu va nawl hranhram ko.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mit cu ihter hlah, na mit cuar zong cu hngilhter hlah;
  </para>
  <para style="p">
    <verse number="5" style="v" />Sakap kut chungin sazuk a luat bantuk le mihriam kut chungin vate a luat bantukin nangmah kha i khamh tuah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Maw zaangthupa, hngerhte sinah khin va kal tuah; an umtuzia khi va ruat hna law fimnak i lak tuah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bawi le upa le uktu zeihmanh an ngei lo nain,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ṭhal caan ah an rawl kha a timh hna i rawl ṭuan caan i an i cawmnak ding kha an pumh an khawmh hna.
  </para>
  <para style="p">
    <verse number="9" style="v" />Maw zaangthupa, zei can dah na ih ko lai? zeitik ah dah na ihnak in na thawh lai?
  </para>
  <para style="p">
    <verse number="10" style="v" />Tlawm tein it ko rih ning, tlawm tein i hngilh ko rih ning, ka kut cu i dinh awkah tlawm tein i sih ko rih ning, na ti lengmang caah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pamnak nih mifir bantukin an tlunhnawh lai i herhbaunak nih hriamnam aa putmipa bantukin an chuahhnawh lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hrokhrawl bia he aa chawkmi cu mizeiruaramlo, miṭhalo an si;
  </para>
  <para style="p">
    <verse number="13" style="v" />An mit kha an ṭheh depmap i an ke in bia an chim i an kutdong in an sawh i
  </para>
  <para style="p">
    <verse number="14" style="v" />An lungthin a kawi caah ṭhat lonak khua kha an khan lengmang i rem lonak thlaici kha an tuh thluangthluan;
  </para>
  <para style="p">
    <verse number="15" style="v" />Cucaah chikkhatte ah ṭhat lonak nih a tlunhnawh hna lai i damter khawh ti loin an rawk lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bawipa nih a huatmi thil paruk a um, A fihmi thil pasarih an um:
  </para>
  <para style="p">
    <verse number="17" style="v" />Porhlawtnak mit, lihchim hmangmi lei, a sual lomi thisen chuahtu kut,
  </para>
  <para style="p">
    <verse number="18" style="v" />Ṭhat lonak khua a khangtu lungthin, ṭhat lonak lei i khulrang in a tlimi ke,
  </para>
  <para style="p">
    <verse number="19" style="v" />Lih a chim lengmangmi tehte le U le nau karlak i rem lonak thlaici a tuhtu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, na pa nawlbia kha zul hna law na nu cawnpiaknak kha hlaw hna hlah:
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lung ah i hren chih zungzal hna law na hngawng ah i khih hna.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na kal tikah an in hruai lai, na ih tikah an in ven lai, naa hlauh tikah bia an in ruah lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zeicahtiah nawlbia cu meiinn a si i cawnpiaknak cu ceunak a si,
  </para>
  <para style="p">
    <verse number="24" style="v" />Chimhhrinnak cu nu ṭhalo sinin na him nakhnga ding caah le nu ralṭha lei nal sinin khamh na si nakhnga ding caah a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aa dawhnak cu na lung chungin duh hlah, a mithmul nih nangmah cu in hreng hlah seh;
  </para>
  <para style="p">
    <verse number="26" style="v" />Zeicahtiah hlawhhlangnu cu changreu hlum khat in hlan khawh a si ko, sihmanhsehlaw a va cungin pa aa duhmi nih cun mipa nunnak hrimhrim kha tlaih aa tim.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi nih a puan kang loin a ṭang ah meiṭil kha a pom kho maw?
  </para>
  <para style="p">
    <verse number="28" style="v" />Asiloah a linmi meiṭil cungah a ke duah loin aho tal a kal khomi an um maw?
  </para>
  <para style="p">
    <verse number="29" style="v" />Cu bantuk cu a innpa nupi sin i a va kalmi cu a si; Ahohmanh amah a tawngtu cu dantat loin an luat lai lo.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mifir nih a rawl a ṭam tikah a rawl ṭamnak damter awkah thil a fir ahcun, Mi nih an nihsawh ṭhiamṭhiam lo mei?
  </para>
  <para style="p">
    <verse number="31" style="v" />Cun amah cu tlaih a si ahcun a let sarih in a liam lai; A innchung i a ngeihmi thil vialte cu a pek dih lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi nupi he a sualmi cu ruahnak ngei lomi a si; Cu a tuahtu cu amah le amah aa hrawk ko.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hma le minchiatnak kha a hmuh lai i a thangchiatnak kha a lo lai lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Zeicahtiah lunghrinnak nih hin mi cu an thin a phawh hna i Teirul an i cham tik ciammam ah cun zeihmanh an i ngan hna lo.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chamnak cu an i cohlanpiak duh lai lo i Laksawng tampi i pek hmanh ah an thin a dam hlei lai lo.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka bia cu i ken hna law ka nawlbia cu na sinah i chiah hna;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka nawlbia cu i ken hna law na nung lai, kan cawnpiaknak cu na mit falai bangin i ken hna;
  </para>
  <para style="p">
    <verse number="3" style="v" />Na kutdong ah i khih hna law na lung tlap ah i ṭial hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Fimnak cu, “Ka far na si,” tiah ti law, hngalhnak cu, “Ka hawikom ṭha na si,” tiah ti tuah;
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah nih cun nu zuangzam sin khan an khamh lai i nu ralṭha, a bia a nal ngaimi sin khan an khamh lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka inn i thlalangawng khan ka hei zoh i
  </para>
  <para style="p">
    <verse number="7" style="v" />Seino lungmawng rual hna lakah khan, ruahnak a ngei lomi tlangval pakhat kha ka hmuh;
  </para>
  <para style="p">
    <verse number="8" style="v" />Zanlei sang, mui chupchap, zan caan le muih caan ah cun, Hlawhhlangnu umnak lei zalam ah cun a kal i an inn lei lam cu a hei tlai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Cun zohhmanh, minu pakhat nih a rak don; Cu nu cu hlawhhlangnu thuam in aa thuam i hmaikhuh puan kha aa khuh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Inn tang loin chawh lengmang a duhmi nu a si, Lamṭe kip khan mi kha a bawh hna.
  </para>
  <para style="p">
    <verse number="12" style="v" />Atute ah khan zalam ah a um, atute ah khan chawdawrnak hmun ah a um.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tlangvalpate cu a tlaih i a hnamh i ningzah hngal loin amah cu,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Raithawinak pekchanh awk ka ngei i nihin ah hin ka biahrennak ka tlinter cang lai;
  </para>
  <para style="p">
    <verse number="15" style="v" />Cucaah nangmah ton awkah le nangmah cu hngahhlang ngaiin kawl awkah ka ra chuak i atu cu kan hmuh cang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka ihkhun ah ihphah dawh ngai ka phah i Izipt ram la hmangṭhia in ṭamhmi ihphah khuh dawh ngaiin ka khuh;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka ihkhun cu mura le aloes le nakzik zihmui in ka thuh cang hna.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ra law zinglei tiang cim tein dawtnak ah cun i phum u sih; dawtnak in i nuam u sih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zeicahtiah ka va cu inn ah a um lo, lamhlapi ah khual a tlawng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangka zal khat in aa phorh i thlapa a lai tik ceo ah khin inn ah cun a tlung te lai,” a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lemsoinak bia tam piin a lem i a biathlum in a hnek khawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihrut bantukin a zulh i cawtum thahnak hmun i a kalmi bantuk khi a si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nengpi, rap ah aa foihmi bantuk, vate rap coktarh a vun zuanhnawhmi bantuk, a si; ka nunnak a ka hlotu a si lai, ti kha a hngal lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Atu cu, maw ka fapale hna, ka bia ngai tuah u, ka ka chungin a chuakmi bia kha ṭha tein ngai tuah hna u.
  </para>
  <para style="p">
    <verse number="25" style="v" />Minu lam lei kha nan lung nih hoih hlah seh, A lam chungah khan va tlau sual hlah u;
  </para>
  <para style="p">
    <verse number="26" style="v" />Zeicahtiah mi tampi a tlakter hna i a thahmi cu tampi an si.
  </para>
  <para style="p">
    <verse number="27" style="v" />A inn cu Sheol i vung kalnak lam, thihnak khan chung i a vung lutmi a si.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fimnak cu a au i hngalhthiamnak nih a kui kha ngai tuah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lam pawng hmun sang ah khan, lam tonnak ah khan a dir;
  </para>
  <para style="p">
    <verse number="3" style="v" />Khua hauka kutka pawngah, luhnak kutka ah khan a au i,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Maw mi hna, nanmah cu kan auhmi hna nan si, mi vialte, nan dihlak in kan nawlmi hna cu nan si:
  </para>
  <para style="p">
    <verse number="5" style="v" />Maw mihrut rual hna, fimnak cawng tuah u; maw lungtlawmmi hna, ṭha tein ngai tuah u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngaihmanh u, thil ṭha kha ka chim lai, ka hmur in ahmaanmi bia kha a chuak lai;
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka kaa nih biatak a chim lai, holh ṭha lo hi ka hmur caah fihnung a si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka kaa chungin a chuakmi bia vialte cu a dingmi bia an si dih; bia cikngerh le hrokhrawl bia pakhat hmanh an um lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hngalthiammi caah cun biading an si dih i hngalhnak a ngeimi caah cun ahmaanmi bia an si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Keimah cawnpiaknak cu ngun nakin i lak deuh u, hngalhnak cu sui ṭha nakin i lak deuh u;
  </para>
  <para style="p">
    <verse number="11" style="v" />Zeicahtiah fimnak cu lungvar nakin a ṭha deuh i na duhmi vialte nih khan an tluk naisai lai lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei cu fimnak ka si i fimnak kha ka pek hna hngalhnak le ruahthiamnak lam kha ka hmuhsak hna.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bawipa ṭihzah cu sualnak huat khi a si. Porhlawtnak, ruamkainak le sualnak lam le biadik lo kha ka huat hna.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hngalhthiamnak le ṭhawnnak zong keimah ta an si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keimah thawngin siangpahrang nih uktu bawi an si i keimah thawngin uktu hna nih a dingmi phunglam kha an ser hna.
  </para>
  <para style="p">
    <verse number="16" style="v" />Keimah thawngin bawi nih bawi bantukin an um kho i vawleicung uktu bawi a simi vialte hna nih khan uktu bantukin an um kho.
  </para>
  <para style="p">
    <verse number="17" style="v" />A ka dawmi cu ka dawt hna i fel tein a ka kawlmi nih cun an ka hmuh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rumnak le upatnak kha ka sinah an um, a tlomi chaw le duhdimnak hna zong kha an um fawn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka theitlai cu sui nakin a ṭha deuh, sui thiang nak hmanh in a ṭha deuh, ka chuahpimi theitlai cu ngun ṭha phun nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dinnak lam ah khan ka kal i biading lam ah khan ka kal,
  </para>
  <para style="p">
    <verse number="21" style="v" />A ka dawmi cu rumnak ka pek hna i an ngun kuang ka khahter.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bawipa nih a rian hramthawknak ah a ka ser, hlanlio i a tuahmi hna lakah hmasa bik ka si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hlan lio piin a ka hmunhter cang, vawlei hramthawk hlanah, a hmasa bik ah a ka ser.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ti thuk pipi an um hlanah khan a ka ser, ti a khatmi cerhti an rak um rih hlanah khan a ka ser cang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Fing le tlang a ser hna hlanah keimah cu ka chuak cang;
  </para>
  <para style="p">
    <verse number="26" style="v" />Vawlei le a chung i a ummi lo hna a ser hna hlan le Vawlei cung leidip hmasa bik a um hlanpi ah khan a ka ser diam cang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Van hna khi a fehter hna tikah khan ka rak um cang, ti thuk cung i a kual, a pum in a rin tikah khan ka rak um ko cang;
  </para>
  <para style="p">
    <verse number="28" style="v" />Cunglei van hna khi fek tein a ser hna tikah le ti thuk cerhti hna cu a fehter hna tikah khan
  </para>
  <para style="p">
    <verse number="29" style="v" />Ti nih khan a nawlbia cu an buar nakhnga lo rili cu ri a serpiak hna; vawlei hram kha a hmelchunh tik ah khan,
  </para>
  <para style="p">
    <verse number="30" style="v" />A pawngah khan rian thiam ngaimi bantukin ka rak um; keimah cu nifate in aa lawmhnak ka rak si i amah hmaiah khan kaa lawm zungzal.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vawlei kha a ser dih tikah a cungah lente kaa celh i kaa nuamhnak cu minung hna chungah khan a si.
  </para>
  <para style="p">
    <verse number="32" style="v" />Atu cu ka fapale hna, ka bia ngai tuah u: Ka lam a zulmi cu lunglawmmi an si.
  </para>
  <para style="p">
    <verse number="33" style="v" />Cawnpiaknak kha ngai u law fim tuah u, cun zeirello in um hlah u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka bia kha a ngai i ka kutka ah nifa a um i ka innka pawngin a ka hngakmi cu milunglawm an si.
  </para>
  <para style="p">
    <verse number="35" style="v" />Zeicahtiah keimah a ka hmutu nih cun nunnak kha a hmuh i Bawipa sinin duhdawtnak kha a hmuh;
  </para>
  <para style="p">
    <verse number="36" style="v" />Sihmanhsehlaw keimah a ka hmu lomi nih cun amah le amah kha aa hliam ko; a ka huatu vialte cu thihnak he aa duhmi an si,” tiah a ti.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fimnak nih a inn kha a sak cang, a tung pasarih kha a phun cang hna.
  </para>
  <para style="p">
    <verse number="2" style="v" />A sa kha a thah cang hna i a mitsur hang zong kha a cawh cang hna i a cabuai zong kha a ser cang hna.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khuachung hmun sang bikbik khan au awkah a sinum kha a thlah hna i,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Lungthin a tlawm deuhmi paoh cu hika ah hin ra tuah u,” an ti. Ruahnak a ngei set lomi cu a thawh hna i,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ra u law changreu kha ei u law mitsur hang ka cawhmi kha ding tuah u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hruhnak lam kha kaltak u law nung cang tuah u, fimnak lam kha zul tuah u,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miruamkai a chimhringtu nih cun rak nihsawhnak kha a in tawn, miṭhalo nun a chimtu nih cun hma a in tawn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Miruamkai cu nun chim hlah, an huat sual lai, mifim cu nun chim law an dawt lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mifim cu cawnpiak law a fim chin lai, miding cu cawnpiak law a thiamnak aa chap lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bawipa ṭih cu fimnak hramthawknak a si, A Thiangmi Mi hngalh cu a thukmi thil hmuh khawhnak a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zeicahtiah keimah thawngin na ni hna cu an karh lai i na nunnak ah kum tampi chap an si lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na fim ahcun nangmah ca ṭhatnak a si ko, miruamkai na si ahcun mawhchiat awk cu nangmah na si ko.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nu hrut cu a lung duh ning paoh khan a um i ngakchia bantuk a si i zeihmanh a hngal lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />A inn innka ah khan a ṭhu, khua chung hmun sang bik hmun i ṭhutdan ah khan a ṭhu i,
  </para>
  <para style="p">
    <verse number="15" style="v" />Lam i a kalmi, anmah lamte i ding tein a kal komi hna kha,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Lungthin a tlawm deuhmi paoh cu hika leiah hin ra tuah u,” a ti hna. Ruahnak a ngei set lomi kha a thawh hna i,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Firmi ti cu a thlum i a thli tein eimi changreu cu a thaw,” tiah a ti hna.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sihmanhsehlaw khika ah thihnak a um ti kha an hngal lo i a sawmmi a hawile hna cu Sheol a thuknak i a ummi an si kha an i hngal lo.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solomon phungthluk bia hna: Fapa fim nih a pa a lawmhter, sihmanhsehlaw fapa hrut cu a nu caah ngaihchiatnak a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ṭhat lonak in hmuhmi chawva cu a miak lo, sihmanhsehlaw dinnak cu thihnak chungin chuahtertu a si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bawipa nih miding cu rawlṭam in umter a siang hna lo, sihmanhsehlaw miṭhalo duhnak cu a donh tawn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kut thathu nih cun pamnak a chuahter, sihmanhsehlaw miteima kut nih cun rumnak a chuahter.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ṭhal caan lioah thil aa khonmi cu fapa fim a si, sihmanhsehlaw rawlṭuan caan lio i a it komi fapa cu ningzahnak a chuahtertu a si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thluachuahnak cu miding hna lu cungah a um, sihmanhsehlaw miṭhalo hna kaa nih cun zaang-ennak kha an i hmawm.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miding cu thluachuahnak an si tiin hngalh camcin an si, sihmanhsehlaw miṭhalo hna min cu philh zau a si.
  </para>
  <para style="p">
    <verse number="8" style="v" />A fimmi nih cun nawlbia kha a lung chungah aa ken, sihmanhsehlaw mihrut mikatam cu ngaihchiatnak a phan lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ding tein a kalmi cu him tein a kal, sihmanhsehlaw a lam kha a ningcang loin a tuahmi cu a langh lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palhnak a um tikah tla dedep tein a mit a ṭhepmi cu harnak chuahtertu a si, sihmanhsehlaw ralṭhat in mi a chimhringmi cu daihnak umtertu a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miding kaa cu nunnak cerhti a si, sihmanhsehlaw miṭhalo hna kaa nih cun zaang-ennak kha an i hmawm.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huatnak nih rem lonak kha a thawhter, sihmanhsehlaw dawtnak nih cun i tisualnak vialte kha a khuh dih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hngalhthiamnak a ngeimipa hmur ah cun fimnak a um, sihmanhsehlaw fungfek cu ruahthiamnak a ngei lomipa keng caah a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mifim nih cun hngalhnak kha an i khon, sihmanhsehlaw mihrut nih bia an chim hluahmah tikah khan rawknak kha a nai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mirum hna an ralhruang cu an chawva a si, misifak hna an rawhnak cu an sifahnak hi a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Miṭha nih an hmuhmi laksawng cu nunnak a si, sihmanhsehlaw sualnak nih cun sualnak lawng a chuahpi lengmang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chimhhrinnak a ngaimi paoh cu an nung lai, sihmanhsehlaw ka palh a ti duh lomi cu lamping ah an kal.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huatnak a paw chungah a thupmi nih a hmur in lih a chim, hawi thangchiatnak a chimmi cu mihrut an si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bia tam deuh na chim paoh ah tam deuh in na sual ve sual ko lai, cucaah na fim ahcun bia naa sum lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miṭha hna bia cu ngun ṭha bantuk an si, sihmanhsehlaw miṭhalo hna lungthin cu hnawmtam bantuk an si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Miṭha bia nih cun mi tampi a cawm hna, sihmanhsehlaw mihrut cu a hruh ruangah a thi tawn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bawipa thluachuahnak cu rumtertu a si i ngaihchiatnak zeihmanh a ratter chih hna lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ṭhat lonak tuah hi mihrut caah cun lentecelh bantuk a si i sihmanhsehlaw hngalhthiamnak a ngeimi caah cun fimnak hi a nuammi a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Miṭhalo cu a ṭihmi thil kha a cungah a tlung lai, sihmanhsehlaw miding nih cun a saduhthah kha a co lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thlichia nih miṭhalo cu a choih hna, sihmanhsehlaw miding cu an him.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ha ca i a thormi bantuk le mit ca i meikhu bantuk khi mithathu cu a bawipa caah a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bawipa ṭihnak nih hin chan a sauter, Sihmanhsehlaw miṭhalo hna chan cu a tawi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Miding hna ruahchannak cu lunglawmhnak a phan, Sihmanhsehlaw miṭhalo hna nih an i ruahchihmi cu pakpalawng ah a cang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Bawipa nih a sual lomi cu a huhphenh hna, sihmanhsehlaw ṭhat lonak a tuahmi cu a hrawh hna.
  </para>
  <para style="p">
    <verse number="30" style="v" />Miding cu hlonh an si bal lai lo, sihmanhsehlaw miṭhalo cu ram chungah hin khua an sa kho lai lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Miding kaa nih cun fimnak kha a chim, sihmanhsehlaw lei ṭhalo cu tan a si lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Miding nih cun hi caan he hin zei bia hi dah chim awkah aa tlak ti kha an hngalh, sihmanhsehlaw miṭhalo nih cun mi ca i fahnak a chuahtertu bia lawnglawng kha a chim zungzal.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Cuai deu a hmangmi cu Bawipa nih a huat hna, sihmanhsehlaw tahnak khing ahmaanmi cu a lawmhmi a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aa porhlawmi nih cun mi nihsawhnak tuan ah an hmuh lai. Cucaah mi toidorte i um a ṭha deuh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Miding cu an dinnak nih a hruai hna, sihmanhsehlaw mihrokhrawl cu an hrokhrawlnak nih a hrawh hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thihnak nih aan phak ni ah cun rumnak hi a ṭhahnem lo, sihmanhsehlaw dinnak cu thihnak chungin michuahtu a si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miṭha cu a dinnak nih khan a lam kha a fawiter, sihmanhsehlaw miṭhalo cu amah ṭhat lonak nih khan a tlukter.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dinnak nih miding cu a chuah hna, sihmanhsehlaw mirawi hmang cu anmah duhfahnak lila ah khan an i foih
  </para>
  <para style="p">
    <verse number="7" style="v" />Miṭhalo cu a thih tikah aa ruahchanmi vialte cu amah sinah khan an lo, rumnak i bochan cu zeihmanh a ṭhahnem lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Miding cu harnak chungin chuah a si, sihmanhsehlaw miṭhalo cu cu chungah cun a paih in an i paih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian zei ah a rel lomi hna an bia nih mi kha a hrawh tawn hna, sihmanhsehlaw miding hna fimnak nih cun a khamh hna.
  </para>
  <para style="p">
    <verse number="10" style="v" />Miding hna huncho tikah khua cu aa lawm, miṭhalo hna an thih tikah lawmhnak au thawng a um.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miding hna an um thawngin khua cu a lianngan, sihmanhsehlaw miṭhalo hna bia nih khua cu a hrawh tawn.
  </para>
  <para style="p">
    <verse number="12" style="v" />A innpa a zawmhtaihmi cu mihrut a si, sihmanhsehlaw hngalhthiamnak a ngeimi cu dai tein a um tawn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aa chawk lengmangmi mihmursau cu biathli phuan hmangmi an si, sihmanhsehlaw zumh awk tlak a simi nih cun thil kha a lung chungah a thuh hna.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hruainak a um lo tikah miphun kha an tlu tawn, sihmanhsehlaw fimchimtu tamnak hmun ah cun himnak kha a um.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na hngalh lomipa kha a leiba champiak awkah bia naa kam ahcun na lungre a thei lai, naa tel lo ahcun na caah a ṭha deuh lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vel a thiammi nu cu hmaizahnak a hmu, sihmanhsehlaw ziaza a thiang lomi cu ningzahnak a si. Chawlehnak le chawhrawlnak ah na ral a chiat ahcun awkhlawh na si ko lai, na ral a ṭhat ahcun na rum ko lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zaangfah a thiammi na si tikah nangmah le nangmah ṭhatnak naa pek a si, cun na puar ahcun nangmah le nangmah harnak naa pe ko.
  </para>
  <para style="p">
    <verse number="18" style="v" />Miṭhalo nih ahmaan loin miaknak a hmuh tawn, ṭhatnak a tuhtu nih cun laksawng taktak cu a hmuh lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dinnak tuah awk aa rialchih pengmi cu a nung lai, sihmanhsehlaw dinlonak tuah aa sehchih pengmi cu a thi lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungthin ṭhalo a ngeimi cu Bawipa nih a huat hna, sihmanhsehlaw dinnak a tuahmi cu a lawmh hna.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hnadai tein um ko, miṭhalo cu dantatnak hmu loin a um lai lo, sihmanhsehlaw miding hna le an tefa hna cu an luat lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aa dawh ngai nain ruah thiamnak a ngei lomi nu cu vok hnar sui tumbul tonh bantuk a si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Miṭha duhnak cu ṭhatnak ah a chuak tawn, sihmanhsehlaw miṭhalo nih an duhmi kha an hmuh tikah mi vialte an thin a hung dih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi pakhatkhat nih siang tein a ṭhenh lengmang hna i a rum chin, a dang pakhat nih tinsih in a um i herhbaunak lawng kha aa miak ko.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nun va siang law na rum lai, midang kha va bawm hna law an in bawmh ve lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />A rawl kha zuar a siang lomi cu mi nih chiat an serh, sihmanhsehlaw zuar a siangmi cu mi nih thluachuahnak an pek.
  </para>
  <para style="p">
    <verse number="27" style="v" />Naa tinhmi kha an ṭhat ahcun hmaizahnak na hmuh lai, Sihmanhsehlaw hnahnawhnak kha na kawl ahcun na hmuhmi cu cucu a si ko lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />A rumnak kha aa bochanmi cu a ṭil lai, sihmanhsehlaw miding cu thinghnah hring bantukin an hninghno lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amah innchungkhar cungah harnak a tluntermi cu a donghnak ah cun zeihmanh a ngei lai lo, mihrut cu mifim hna sinum an si zungzal lai.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dinnak theitlai cu nunnak thingkung a si, sihmanhsehlaw zaang-ennak cu nunnak thah kha a si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Miding hna nih vawlei cungah hin an hmuh awk hnga kha an hmuh ahcun miṭhalo hna le misual hna nih cun zeitluk in dah an hmuh chinchin lai.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hngalhnak a duhmi nih cun a palh tikah na palh tiah chimh kha a duh, palhnak chimh huat cu hruh a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Bawipa nih miṭha cu a lawmh hna, sihmanhsehlaw ṭhat lonak khua a khangtu cu sual a phawt hna.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi hi ṭhat lonak nih a fehter kho lo, sihmanhsehlaw miṭha hna hram cu ṭhial khawh lomi hram an si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nupi ṭha cu a va caah bawi luchin a si, sihmanhsehlaw ningzahnak a tluntertu nupi cu ruh chung i khensar zawtnak bantuk a si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miding hna tinhmi cu mi cung i ding tein tuah kha a si, sihmanhsehlaw miṭhalo hna khuakhannak cu hlennak in a khat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miṭhalo hna bia nih cun thisen chuah ding kha a bawh, sihmanhsehlaw miṭha hna bia nih cun khamhnak kha a umter.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miṭhalo cu an tla i cucu an donghnak a si, sihmanhsehlaw miding hna tefa cu an i peh lengmang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na fim ahcun thangṭhatnak na hmuh lai, na hruh ahcun mi nih an in zohchuk lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mah nunnak caah rian a ṭuan ciahmahmi, mi sawhsawhte si cu, mingan bantuk i um i rawlṭam ṭung nakcun a ṭha deuh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Miṭha nih cun an saṭil kha an zawn an ruah hna, sihmanhsehlaw miṭhalo cu an saṭil cungah cun an puar.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah a lote a thlo lengmangmi cu ei awk a za in a ngei, sihmanhsehlaw san a tlai lomi rian i caan pakpalawng i hman cu hruh a si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miṭhalo hna ralhau cu tlak bantukin a cim, sihmanhsehlaw miding hna hram cu fek tein a dir.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi ṭhalo cu amah chimmi bia lila nih khan rap ah a foihter, sihmanhsehlaw miding cu harnak chungin an luat.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi cheukhat nih an bia thawngin hlawh tlinnak an hmuh, sun a cheu nih an kut rian ṭuannak thawngin an hmuh awk hnga kha an hmuh ve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihrut nih cun ka ding tiah a ruah zungzal, lungthin cheuhmi a ngaimi cu mifim an si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihrut thinhun cu aa hngal zau, sihmanhsehlaw mifim nih cun serhsatnak kha zei ah rel duh loin a umtak men ko.
  </para>
  <para style="p">
    <verse number="17" style="v" />Biatak a chimmi nih cun ding tein tehte a khan, sihmanhsehlaw tehte ding lo cu hlennak bia in a khat.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ruah set loin chimmi bia nih cun nam chunh bangin mi a chunh, sihmanhsehlaw mifim bia nih cun hma kha a damter.
  </para>
  <para style="p">
    <verse number="19" style="v" />Biatak cu zungzal in amah ningte a si ko, sihmanhsehlaw lih cu caan tawite lawnglawng a nung.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ṭhat lonak khua a khangtu hna cu anmah le anmah an i hleng ko, sihmanhsehlaw zapi ca ṭhatnak a kawlmi hna caah cun lunglawmhnak a um.
  </para>
  <para style="p">
    <verse number="21" style="v" />Miding hna cungah cun ṭhat lonak a tlung lo, sihmanhsehlaw miṭhalo hna nih cun harnak lawnglawng kha an hmuh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bawipa nih lihchim hmangmi cu a huat hna, Sihmanhsehlaw miding cu a lawmh hna.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mifim nih cun a fimnak kha a langhter lo, Sihmanhsehlaw mihrut nih cun a hruhnak kha a thanh in a thanh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Miteima cu uktu an si lai, sihmanhsehlaw mithathu cu an thathutnak nih mi sal ah a canter hna lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lung retheihnak nih minung cu lunglawm loin a tuah, Sihmanhsehlaw dawtnak bia nih cun lunglawmhnak in a khahter.
  </para>
  <para style="p">
    <verse number="26" style="v" />Miding nih cun ṭhat lonak kha an hrial, Sihmanhsehlaw miṭhalo nih cun a pialtertu hna lam kha an zulh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ramvai thathu nih sa an kap kho bal lo, Sihmanhsehlaw teimami nih cun a sungmi chawva kha an hmuh lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dinnak cu nunnak lei kalnak lam a si, Hruhnak cu thihnak lei kalnak lam a si.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fapa fim nih cun a pa nih a chimhhrinnak kha a ngaih, Sihmanhsehlaw mi lungpuam nih cun ka palh tiah a ti bal lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Miṭha nih cun dinnak theitlai kha an ei, sihmanhsehlaw mirawihmang hna nih cun zaang-ennak kha buh le sa tlukin an duh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na biachimmi kha i ralring law na nunnak kha naa veng kho lai, ralrin loin bia a chimmi nih cun amah lila kha aa hrawk ko.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mizaangthu pa nih cun zeilo pakhatkhat kha a duh ngaingai ko hnga, sihmanhsehlaw cucu a hmu bal lai lo, rian fak piin a ṭuanmi tu nih cun a duhmi paohpaoh kha a hmuh lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miding nih cun lihbia kha an huat; Sihmanhsehlaw miṭhalo hna rian ṭuannak cu fihnung le ningzak an si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dinnak tuahnak nih khan miding cu a ven hna, sihmanhsehlaw ṭhat lonak cu mi sual mi hna tluknak a si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi a cheukhat cu mirum bantukin an i umter, sihmanhsehlaw zeihmanh an ngei lo, a cheukhat cu sifak bantukin an i um ter, sihmanhsehlaw chawva tampi an ngei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mirum nih a nunnak khamh awkah tangka hman a hau. Sihmanhsehlaw misifak cu ahohmanh nih an tlerh lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Miding hna cu ceu ngaiin a ceumi meiceu bantuk an si. Sihmanhsehlaw miṭhalo cu a mit cuahmahmi meiinn bantuk an si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uahfaihnak nih cun rem lonak lawng kha a chuahter. Sihmanhsehlaw aa nawl thiammi hawikom hna bu chungah cun fimnak a um.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khulrang in hmuhmi rumnak cu a ziam zau, sihmanhsehlaw tlawmpal, tlawmpal tein khonmi cu a karhcho.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ruahchannak cu a nikhua rauhter tikah hin lung a fak, sihmanhsehlaw saduhthahmi cu a tlin tikah hin nunnak thingkung a si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chimhhrinnak bia zei ah a rel lomi nih amah cungah harnak a tlunter, sihmanhsehlaw a zulmi nih cun laksawng a hmuh lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mifim hna cawnpiaknak cu nunnak cerhti a si, mah cucu thihnak rap chungin an luatter khotu a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Fimnak ṭha nih duhdawtnak a hlawh, Sihmanhsehlaw hlennak cu rawhralnak lei lam kalnak a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mifim cu a fim i zei thil paoh kha a thuhphenh, Sihmanhsehlaw mihrut nih cun a hruhnak kha a zar in a zar.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lamkaltu ṭhalo nih harnak chungah a luhpi tawn hna, Sihmanhsehlaw zumh awk tlak lamkaltu nih cun zeizong vialte kha an ṭhatter ṭhan tawn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cawnpiaknak zei ah a rel lomi cu sifahnak le ningzahnak nih a phak hna, sihmanhsehlaw chimhhrinnak zei ah a relmi cu upatnak an hmu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Saduhthah tlin hi zeitluk in dah a ṭhat! Sihmanhsehlaw ṭhat lonak mertak hi mihrut caah cun fihnung a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mifim hna sinah i chawk ve lengmang law na fim lai, mihrut hna he i kom law a ping ah an in hruai lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Misual mi cu vanchiatnak nih a zulh hna, sihmanhsehlaw miding cu ṭhatnak laksawng an hmu lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Miṭha nih cun an fa fa chin tiangin ro an chiahpiak hna, sihmanhsehlaw misual mi nih an pumh luaimaimi chawva cu miding hna sinah a kal ko lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thlawh lomi vawlei nih misifak mi hna caah rawl a za in a chuah ko lai, sihmanhsehlaw cu zong cu dinlonak thawngin a lo dih ko lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na fa cu dan na tat lo ahcun na huat a si, na dawt ahcun amah kha chimhring tuah.
  </para>
  <para style="p">
    <verse number="25" style="v" />Miding cu ei awk a za in an ngei, sihmanhsehlaw miṭhalo cu an rawl a ṭam zungzal ko.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nu fim nih an inn kha an sak, sihmanhsehlaw nu hrut nih anmah kut lila in an ṭheh dih hna.
  </para>
  <para style="p">
    <verse number="2" style="v" />Miding nih cun Bawipa kha an ṭih, sihmanhsehlaw midepde nih cun zei ah an rel lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihrut biachimmi cu amah keng ca fungfek a si, sihmanhsehlaw mifim cu an hmurka nih a huhphenh hna.
  </para>
  <para style="p">
    <verse number="4" style="v" />Cawtum um lonak ah cun buk cu a lawngin an um ko, sihmanhsehlaw cawtum thazang chungin rawl tampi a chuak.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zumh awk tlakmi tehte nih cun lih kha a chim lo, sihmanhsehlaw tehte dinglo nih cun lih kha a thaw ah aa chuahchih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miporhlaw nih cun fimnak kha a kawl nain a hmu lo, sihmanhsehlaw hngalhthiamnak a ngeimi caah cun fimnak cu a fawitemi thil a si ko.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihrut cu hrial ko hna, zeihmanh an in cawnpiak khawh ding a um lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zeicahdah mifim cu a fim? Zeidah ka tuah lai ti kha aa hngalh caah a fim. Zeicahdah mihrut cu a hruh? Ka hngalh tiah aa ruah caah a hrut.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihrut cu an sual ah an zei a poi lo, sihmanhsehlaw miṭha nih cun ngaihthiamnak hmuh kha an duh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na lunglawmhnak cu nangmah tate a si, na ngaihchiatnak zong nangmah tate a si, Ahohmanh na hrawm kho hna lai lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miṭhalo inn cu hrawh a si lai, sihmanhsehlaw miding inn cu a hungcho lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lam dik tiah na ruahmi kha thihnak lei kalnak lam a si kho ko.
  </para>
  <para style="p">
    <verse number="13" style="v" />Minung cu a nih len ko zongah a lungchung tein a ngaih a chia ko hnga, lunglawmhnak a loh cang ahcun, ngaihchiatnak a um zungzal ko.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miṭhalo nih a hmuh awk hnga a simi kha a hmuh lai, miṭha nih a tuahmi thawng khan laksawng a hmuh lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi lungthin tlawm nih cun zei paoh kha a zumh, sihmanhsehlaw mifim nih cun a lamh ding kha ṭha tein a zoh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mifim cu ralring tein a um i ṭhat lonak kha a hrial, sihmanhsehlaw mihrut cu aa ralring lo i khulrang tuk in a tuah tawn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi thin tawi nih cun thil hrut kha an tuah tawn, sihmanhsehlaw mifim deuhmi cu an lung a sau.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihrut nih cun an hruhnak nih a hmuh awk hnga a simi kha an co. Mifim cu hngalhnak kha bawi luchin ah chinhter an si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Miṭhalo cu miṭha hna hmaiah khan an bawk, miṭhalo cu miding hna kutka ah khan an kun.
  </para>
  <para style="p">
    <verse number="20" style="v" />Misifak cu ahohmanh nih an duh lo, sihmanhsehlaw mirum cu hawikom tampi a ngei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lunglawmmi si na duh ahcun misifak kha va zaangfah hna, mi zeihmanh zeirello i um kha sualnak a si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ṭhatnak caah rian na ṭuan ahcun mi nih an in zumh lai i an in upat lai, sihmanhsehlaw chiatnak caah na tuah ahcun na palh hrimhrim ko.
  </para>
  <para style="p">
    <verse number="23" style="v" />Rianṭuan harnak nih hin ṭhathnemnak a chuahpi, kaa chim men lawng nih cun sifahnak lawng a chuahpi ko.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mifim hna bawi luchin cu thil a chunglei an hmuh khawhnak hi a si, mihrut hna pangpar ṭhirual cu an hruhnak hi a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Biatak a chimmi tehte nih nunnak kha a khamh, sihmanhsehlaw lih a chimmi cu mi rawitu a si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bawipa ṭihnak aa bochanmi miṭhawng cu, A tefa hna caah himnak a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thihnak in luat na duh maw? Bawipa ṭihnak hi nunnak cerhti a si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Siangpahrang cu ukmi tampi a ngeih tikah a lianngan, ukmi a ngeih lo ahcun a bawinak cu a lo ko.
  </para>
  <para style="p">
    <verse number="29" style="v" />Dai tein a um khomi cu mifim a si, sihmanhsehlaw mithintawi nih cun zeitluk in dah a hruh ti lawng kha a langhter.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lung daihnak nih pum kha a ngan a damter, sihmanhsehlaw nahchuahnak cu khensar zawtnak bantuk a si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Misifak kha nan serhsat hna ahcun anmah a Sertu Pathian nan serhsat kha a si, nan zaangfah hna ahcun cucu Pathian biak a si.
  </para>
  <para style="p">
    <verse number="32" style="v" />Miṭhalo cu amah ṭhat lonak nih a thluk, sihmanhsehlaw miding cu a dinnak nih khan a huhphenh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Fimnak a ngeimi hna lung chungah cun fimnak cu nuam tein a cam, sihmanhsehlaw mihrut hna lung chungah cun aa nuam lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Miphun a lianhngantertu cu dinnak a si, sualnak cu zei miphun paoh caah ningzahnak a si.
  </para>
  <para style="p">
    <verse number="35" style="v" />Siangpahrang nih a felmi rianṭuantu kha an lawmh hna, sihmanhsehlaw an rian a tlolhmi cu dan a tat hna.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lehnak nem nih thinhunnak a damter, sihmanhsehlaw biahrang nih cun thin a phawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mifimpa lei nih hngalhnak kha a karhter, sihmanhsehlaw mihrut nih cun pakpalawng bia kha a chim.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bawipa nih khuazei ka i thil a ummi hmanh kha a hmuh dih, ṭhatnak kan tuah ah siseh, chiatnak kan tuah ah siseh, a kan hmuh dih ko.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bia nem cu nunnak thingkung a si, sihmanhsehlaw ṭhat lonak a tuahtu lei nih lungthin kha a khuai tawn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihrut nih a pa chimhhrinnak kha zei ah a rel lo, sihmanhsehlaw mawhchiatnak zei ah a relmi cu mifim a si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miding nih an chawva kha an i chiah khawh, sihmanhsehlaw harnak caan a phak tikah miṭhalo nih cun an thlau hna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mifim hmurka nih hngalhnak kha an ṭhanter, mihrut lungthin tu cu, cu bantuk a si lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Miṭhalo hna raithawinak cu Bawipa caah fihnung a si, sihmanhsehlaw miṭha hna thlacamnak cu a lawmhmi a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Miṭhalo hna ziaza cu Bawipa caah fihnung a si, sihmanhsehlaw dinnak a kawlmi kha a dawt hna.
  </para>
  <para style="p">
    <verse number="10" style="v" />Palhnak kha na tuah ahcun fak piin dantatnak na hmuh lai, chimhhrinnak kha na duh lo ahcun na thi lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sheol le Abaddon hmanh Bawipa hmaiah cun an lang ko, minung lungthin chinchin cu zeitluk in dah a langh lai!
  </para>
  <para style="p">
    <verse number="12" style="v" />Miporhlaw nih cun chimhhrinnak kha a duh lo, mifim hna sinah khan ruahnak va hal awkah a kal bal lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungchung lawmhnak nih hmai a panhter, sihmanhsehlaw lungfahnak nih lungthin a khuai tawn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mifim nih cun hngalh chin lengmang kha an duh, sihmanhsehlaw mihrut cu an hruhnak ah khan an i za ko.
  </para>
  <para style="p">
    <verse number="15" style="v" />Harnak a ingmi hna caah cun nifate hi ni har an si dih ko, sihmanhsehlaw lung aa lawmmi hna caah cun nunnak hi a nuam zungzal ko.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bawipa ṭih bu tein tlawmte ngeih hi tampi ngeih i hnahnawk ngai i um nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dawtnak aa telnak zanriah cu an hringso he lawng hmanh siseh law, a thaumi caw sa in tuahmi zanriah, huatnak aa telmi nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thintawi nih siknak a chuahter, sihmanhsehlaw lungsaunak nih rem lonak a damter.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mithathu lam cu hling nih a buathnawh, sihmanhsehlaw teimami lam cu lampheipi a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Fapa fim nih a pa kha a lawmhter, sihmanhsehlaw a hrutmi mino nih a nu kha a nehsawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihrut cu an hruhnak ah khan an i lawm ko, sihmanhsehlaw mifim nih cun ahmaanmi thil kha an tuah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ruahnak i cheuhnak a um lo ahcun khuakhannak kha a pingah a kal tawn, sihmanhsehlaw ruahnak cheutu an tam ahcun a hlawh a tling tawn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mipa nih a lehnak kha a lunghmuih ko lai, sihmanhsehlaw a caan he ahmaanmi bia fang khat cu zeitluk in dah a ṭhat deuh!
  </para>
  <para style="p">
    <verse number="24" style="v" />Mifim cu nunnak lam leiah khin an hung kal, thihnak lam leiah cun an vung kal lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Bawipa nih aa porhlawmi inn cu a ṭheh, sihmanhsehlaw nuhmei thilri kha a humhak hna.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bawipa nih miṭhalo hna ruahnak cu a huat, mithiang hna bia cu a lawmhmi an si.
  </para>
  <para style="p">
    <verse number="27" style="v" />A hak a kaumi nih a innchungkhar cungah harnak a tlunter, sihmanhsehlaw nawhthuh a duh lomi cu saupi a nung lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Miṭha nih cun bialehnak an tuah hlanah an ruah hmasa, miṭhalo nih cun khulrang in an leh, sihmanhsehlaw an lehnak nih cun harnak a chuahter.
  </para>
  <para style="p">
    <verse number="29" style="v" />Miṭha nih thla an cam tikah Bawipa nih a ngaihpiak hna, sihmanhsehlaw miṭhalo cu zei ah a rel hna lo.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hmaipanh nih mi a lawmhter, thawngṭha nih mi a lawmhter chinchin.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chimhhrinnak a ṭhami kha ṭha tein a ruatmi cu mifim hna bu chungah khan aa tel ve lai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chimhhrinnak zei ah na rel lo ahcun nangmah le nangmah harnak naa pe, sihmanhsehlaw chimhhrinnak kha na cohlan duh ahcun na fim chin lai.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bawipa ṭih hi fimnak ding caah cawnpiaknak a si, upatnak phaknak lam cu toidornak a si.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Minung nih khua cu an khan ko lai, sihmanhsehlaw a donghnak bia a ngeitu cu Pathian a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na tuahmi cu a ṭha dih in na ruah ko lai, sihmanhsehlaw Bawipa nih naa tinhnak na lungthin cu a hngalh dih.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na tuahmi vialte cu Bawipa sinah pe law Na khuakhannak cu a tling kho lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawipa nih zeizong vialte hi anmah ca i tinh ciomi caah khan a ser hna, miṭhalo hna hmanh hi, harnak ni caah a ser hna.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miruamkai cu Bawipa caah fihnung an si, hnadai tein um ko, dantatnak hmu loin an um lai lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian leiah felte le zumhawktlak tein um ko law na sualnak cu an ngaihthiam lai. Cun Bawipa kha ṭih law ṭhat lonak nih an tlunhnawh lai lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi cu a umtuning kha Bawipa duhning a si ahcun, a ral hna hmanh kha amah he i rem tein a umter hna.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dinlonak in hmuhmi thil tampi nakcun dinnak in hmuhmi tlawmte a ṭha deuh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Minung nih hin a khualtlawnnak ding khua kha a khan, sihmanhsehlaw a kephau a hruaitu cu Bawipa a si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian chimhmi biakhiahnak cu siangpahrang hmur ah cun a um, biaceih tikah a kaa nih sualnak a tuah lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />A dikmi tahnak le khing hna cu Bawipa duhmi an si, zal chung i a ummi cuaithlainak lung vialte hna zong amah nih a tuahmi an si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siangpahrang caah cun ṭhat lonak tuah hi fihnung a si, zeicahtiah bawi ṭhutdan cu dinnak in fehter a si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bia hmaan chim cu siangpahrang lawmhmi a si, cun biatak a chimmi cu a dawt hna.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mifim nih cun siangpahrang cu a lung lawmhter aa zuam, siangpahrang cu a thin a hun ahcun pakhatkhat thah an si sual lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Siangpahrang hmai ceunak chungah nunnak a um, cun a zaangfahnak cu ṭhal ruah a hun ratpitu khuadawm bantuk a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Fimnak ngeih hi sui nakin a ṭha deuh, hngalhthiamnak ngeih hi ngun nakin thim deuh awk a si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Miding hna nih cun ṭhat lonak a hrialtu lam kha an zulh, cucaah khuazei i na kal kha zoh tuah, na nunnak an khamh khawh lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Porhlawtnak nih hin rawknak ah mi a kalpi tawn i uanthlarnak lungthin nih hin tluknak ah a hruai tawn hna.
  </para>
  <para style="p">
    <verse number="19" style="v" />Misifak hna he toidornak lungthin in um cu, miporhlaw hna he hranchaw i ṭhenh nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="20" style="v" />An in cawnpiakmi kha ṭha tein ruat law khuaawng na tong lai, Bawipa kha i bochan law na lung aa lawm lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />A fim i nutling patling lungthin a ngeimi cu, thil a thleidang khomi ti a si i a awka a thlum deuh paoh ah mi a lem khawh chin hna.
  </para>
  <para style="p">
    <verse number="22" style="v" />Fimnak cu a ngeitu caah cun nunnak cerhti a si, sihmanhsehlaw mihrut cu a hruhnak nih dantatnak a inter.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mifim nih cun bia a chim hlanah a ruah hmasa, cucaah a chimmi cu hmual a ngei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Biathlum cu khuaihliti bantuk a si, nunnak caah a thlum i pum caah damnak a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na ruahnak i lam ding a si na timi kha thihnak lei kalpitu lam a si ko hnga.
  </para>
  <para style="p">
    <verse number="26" style="v" />Rianṭuantu cu a rawl duhnak nih khan fak deuh in a ṭuanter, zeicahtiah a rawlṭamnak kha daihter a duh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mizeiruaramlo nih, congoihnak kha a vahpi, a bia cu kanghtu mei bantuk a si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi lungthin ṭhalo nih rem lonak kha an karhter i Mi dupdap nih hawikom ṭha kha an ṭhen hna.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zaang-ennak a hmangmi nih a innpa kha a hlen i A ṭhalo lam ah khan a kalpi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A mit curcudup in aa aumi cu a lungthin chung i dawtnak a ngei lomi a si, a hmur aa iapmi nih cun thil ṭhalo kha a tlunter tawn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ṭuakpar hi sunparnak bawiluchin a si, nun a dingmi nih an hmuh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thinhun leiah a khul a nuarmi cu thazang a ṭhawngmi nakin a ṭha deuh. A lungthin aa uk khomi cu khuapi a latu nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Camcawhfung cu phei cungah hrilh a si tawn, sihmanhsehlaw biakhiahnak taktak cu Bawipa sin lawnglawng in a si.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />I sik lengmang bu i puai tuahnak inn i um nakcun daite i buhṭhing pei khat ei a ṭha deuh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A fimmi sal nih a bawipa fapa, zeiruaramlo a simi kha a uk lai i unau pakhat ve bantukin ro kha a co ve lai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sui le ngun cu mei in hneksak an si, minung lung cu Bawipa nih a hneksak.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihrokhrawl cu hrokhrawl bia lawng kha a thlingthla, lihchim hmang nih cun thangchiatnak bia lawng kha a ngai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Misifak nihsawh cu a Sertu nehsawh kha a si, Mi nih van chiat an ton tikah a di a riammi cu dantat loin a luat lai lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu le fa hi tar hna bawiluchin an si, Fapa hna an sunparnak cu an pale hi an si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bia ṭha chim le mihrut an i tlak lo, bia lih chim le bawi an i tlak lo chinchin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi a cheu nih, nawhthuh nih cun camh bantukin rian a ṭuan khawh, tiah an ruah, zeipaoh a tuah khawh tiah an zumh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midang sualnak a thup khotu nih kha pa dawtnak kha a hmuh lai. Sihmanhsehlaw kha thilte kha hlasak in a sa lengmangmi nih cun hawikom he ṭhennak a ser.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihrut voi za khat tuk nakin, mifim voi khat chimhhrin cu thuk deuh a pil.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miṭhalo nih cun ralthawhnak lawng kha an kawl, annih cu a puarmi lamkaltu kha an thlahhnawh hna lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihrut a hruh lio i ton nakcun a fa chuhmi vompi ton a ṭha deuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi nih ṭhatnak cu ṭhat lonak in a lehrulh ahcun, ṭhat lonak cu a inn chungin aa ṭhial bal lai lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sik hram i thawk hi ti khamnak a pem hramthawk bantuk khi a si. A kauh chin hlanah ngol ko.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miṭhalo thiamcoh le miding sualphawt hi, an pahnih in Bawipa mithmuh ah fihnung an si veve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihrut caah cun tangka hi zei san dah a tlaih? Fimnak a ngeih lo ahcun fimnak cu a cawk khawh lai maw?
  </para>
  <para style="p">
    <verse number="17" style="v" />Hawikom nih cun zei tik paoh ah dawt zungzal a si, u le nau cu harnak i hrawm awkah hrin kan si.
  </para>
  <para style="p">
    <verse number="18" style="v" />Midang caah aamah aa khaang i biakamnak caah aa pemi cu mihrut a si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Remlonak a duhmi nih cun sualnak a duh, a inn kulhnak innka sang piin a sermi nih cun rawhralnak kha a sawm ko hna.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ruahnak kawi a ngeimi cu khuaawng an pem lo, lei ṭhalo a ngeimi cu vanchiatnak chungah an tla tawn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Fapa hrut cu a pa caah ngaihchiatnak a si, a pa cu lunglawmhnak a ngei lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungthin lawmh hi si ṭha a si, sihmanhsehlaw lungthin ngaihchia nih ruh kha a roter.
  </para>
  <para style="p">
    <verse number="23" style="v" />Biaceihtu ṭhalo nih ziknawh an lak tawn i dinnak in bia an ceih lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lungthin a tlamtling cangmi nih cun thil ṭha tuah awk kha an hngalh, sihmanhsehlaw a tlam a tling lomi nih cun an lungthin an thlek kho lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Fapa hrut nih cun a pa kha awlokchong in a tuah i a hringtu a nu caah lungretheihnak a si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Miding mi dantat cu a ṭha lo, miṭha mi hna fung in tuk cu palh a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah aa zum vemi nih cun bia tampi a chim lo, dai tein a ummi cu thil thuk piin a hmu khomi an si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihrut hmanh hi daite in a um ahcun mifim ah rel a si, a hmur aa cip peng ahcun mifim ah ruah a si.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi dang he aa rem lomi cu amah duhnak lawng zulh a duhmi a si, midang nih a hmaan an timi paoh kha a hnatlakmi a um lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihrut nih cun a hngalh set le hngalh set lo kha biapi in a ruat lo, zeitluk in dah ka fim ti langhter lawng kha a duh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ṭhat lonak le ningzahnak cu a kal ṭimi an si, upatnak kha na thlau ahcun nihsawhnak kha na hmuh ko lai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Minung holh hi fimnak hram a si kho, rili bantukin a thuk kho i a luang lengmangmi tiva bantukin a thar lengmang kho.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miṭhalo sin i duhdanh ngeih cu a ṭha lo, miding mi biading coh lo zong a ṭha lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihrut mi hmur nih cun siknak a chuahpi, a kaa nih fung tuknak a sawm.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihrut cu a kaa kha amah rawhnak a si, a hmur kha amah lila caah rap a si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi congoihnak bia chim cu a thlummi changreu bantukin a thaw i pum chung chungchin ah khan kan lemh riahmah ko hna.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mahle rian ah a daithlangmi cu hrawkhraltu unau a si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bawipa min cu a fekmi innsang a si, miding cu khika ah khan an va tli i an him.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mirum mi nih a chawva cu, a fekmi khua le a sangmi ralhau a si tiah a ruah.
  </para>
  <para style="p">
    <verse number="12" style="v" />Harnak phak hlanah cun mi cu an lung a puam tawn, sihmanhsehlaw upatnak phaknak lam cu toidornak a si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bia na leh hlanah ngai hmasa, cu ti na tuah lo ahcun na hruh a si hleiah bia na lehmipa zei i na rel lo zong a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi cu lungthin ṭhawng nih a zawt lio ah thazang a pek khawh, sihmanhsehlaw lungthin cu hma a in ahcun, aho nih dah a tuar khawh lai?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ruahnak a fimmi nih cun hngalhnak kha an i lak chin lengmang i mifim mi nih an hna in hngalhnak kha an kawl.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laksawng nih laksawng petu caah khan lam a hun i mingan hna sinah khan a phakpi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Biaceihnak zung ah bia a chim hmasami paoh cu a hmaan a lo zungzal, sihmanhsehlaw cu a lawhnak cu a dang a rat ve i amah kha a vun hlathlai tiang lawng khi a si tawn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pa ṭhawng pahnih cu biaceihnak zung ah bia an i al ahcun, camcawhfung lawng nih an bia kha a khiah khawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />U le nau i bawmh hi a fekmi khua bantuk a si, sihmanhsehlaw i sik cu ralhau kharkanh bantuk a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi cu a kaa chungin a chuakmi bia theitlai in a khim tawn, a hmur in a chuakmi in cawmnak kha a hmuh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lei nih hin thah khawhnak le nunh khawhnak ṭhawnnak a ngei, cucaah na bia chimmi theitlai cu na co a herh lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nupi aa hmuhmi cu thil ṭha aa hmuhmi a si, Bawipa cu na cungah a ṭha ti kha a langhter.
  </para>
  <para style="p">
    <verse number="23" style="v" />Misifak nih cun bia an chim ah a nawl tein an nawl tawn hna, sihmanhsehlaw mirum nih cun an leh hna tikah a hrilh in an hrilh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hawikom a cheu khat cu pakpalawng biachim lawngah an ṭhahnem, sihmanhsehlaw unau nakin a fek deuhmi hawikom zong an um ve.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lungthin a ṭhami misifak cu hrokhrawl in bia a chimmi mirum nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hngalhnak um ṭung lo duhnak lawng hi a ṭha lo, Namhnaw in a kalmi nih a lam kha a thlau tawn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Minung cu a hruhnak nih khan rawhnak ah a phakter i Cu tikah Bawipa cungah khan a lung chungin a thin a hung.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rumnak nih hawi thar tampi a chuahpi, Sihmanhsehlaw misifak cu a hawi cia nih khan an chuahtak.
  </para>
  <para style="p">
    <verse number="5" style="v" />A dinglo tehte cu dantat loin a luat lai lo, Lih a chimtu cu a luat ve lai lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tampi nih mi lian he hawikom sinak kha an kawl, Laksawng a pe lengmang tu caah cun aho paoh hawikom an si ko.
  </para>
  <para style="p">
    <verse number="7" style="v" />Misifak cu a unau vialte nih an huat tawn, Zeitluk in dah a hawile chinchin nih cun hrial loin an um lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Fimnak ngeih hi mah le mah dawt a si, Cun na hngalhmi kha i chingchiah law khuaawng na tong lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />A dinglo tehte cu dantat loin a luat lai lo, Lih lawng a chim lengmangmi cu a rawk lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihrut cu nunnuam in um awkah aa tlak lo, Sal nih bawi uk cu aa tlak lo chinchin.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lungsau thinfual hi fim a si, Palhnak i hmaimilh cio hi minung sunparnak a si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siangpahrang thinhunnak cu chiandeih ngur bantuk a si, Sihmanhsehlaw a duhdawtnak cu ram cung i a tlami dap bantuk a si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Fapa hrut nih a pa cu rawhnak ah a phakpi, Nupi phunzai cu ruah-it khuachiat bantuk a si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inn le chawva cu pale sinin hmuhmi ro an si, Sihmanhsehlaw nupi fim cu Bawipa sinin hmuhmi laksawng a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thathutnak nih mitkuh thu chungah a paih tawn hna, Mithathu cu rawlṭamnak a ing lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nawlbia kha zul hna law sau deuh na nung lai, zeirello in um hna law na thi lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Misifak cungah zaangfahnak na ngeih ahcun Bawipa kha chaw na coih bantuk a si. Bawipa nih tling tein an cham lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na fale cu an no rih lioah chimhring hna, cu ti na tuah lo ahcun an rawhnak dingah na bawmh hna a si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Minung cu a ingchiatnak nih khan dantatnak a inter tawn, harnak chungin voi khat na chuahter zongah, na tuah ṭhan a hau ṭhiamṭhiam ko lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungthin cheuhnak le cawnpiaknak kha ngai tuah, ni khatkhat cu na fim ve te ko lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Minung lung chungah khuakhannak tampi a um ko lai, sihmanhsehlaw Pathian tinhmi lawng kha a hmun lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hakkauh hi ningzahnak a si, misifak si hi lihchimmi sinak in a ṭha deuh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawipa ṭihnak hi nunnak a si, cuti in na um ahcun, hnangam tein na um lai i harnak nih an tawng lai lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mithathu nih cun a kut kha kheng chungah hnim i a kaa i hun i tuh hmanh kha a zuam lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Miporhlaw cu na velh ahcun mihrut bantukin an huat lai, hngalhthiamnak a ngeimi tu cu chimhring law na duhnak kha a hngalh lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />A pa kha a vel i a nu kha a dawimi cu, ningzahnak a chuahtertu le hmaichiatnak a phortu a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka fapa, cawnnak kha na ngol ahcun na hngalh ciami kha na philh zau ko lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tehte ṭhalo nih biading kha zei ah a rel lo, miṭhalo mi hna bia nih ṭhat lonak kha a chuahter.
  </para>
  <para style="p">
    <verse number="29" style="v" />Miporhlaw mi hna caah fungfek cu chiah cia a si ko i Mihrut hna keng caah tuknak cu timhcia a si ko.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zu hi nihsawhnak mi a phorhtu a si, Ritnak zu hi i siknak a si; zu rit cu hruh a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thin a hungmi siangpahrang cu a ngur hluahmahmi chiandeih bantukin ṭih tuah, amah a thin hunter cu mah le mah i thah a si ko;
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihrut aho paoh nih siknak kha a thawhter khawh, sihmanhsehlaw siknak hrial cu upat awk tlak thil a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thathu nih cun leithuan caan ah lei a thuang lo, rawlṭuan caan a phak tikah a kawl i zeihmanh a hmu lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Minung nih a lung chung i a ngeihmi ruahnak cu a thukmi tikhor ti bantuk a si, sihmanhsehlaw thuk piin a hmu khomi nih cun a than khawh lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi kip nih zumh awk tlak ka si an ti cio, sihmanhsehlaw hei hneksak tuah hna law, aho fang khi dik zumh awk tlak taktak cu an hei si!
  </para>
  <para style="p">
    <verse number="7" style="v" />Mipa cu a nunning kha a din i a ṭhat ahcun, a hnu i a tefa hna cu thluachuakmi an si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Biaceihnak ṭhutdan cungah a ṭhumi siangpahrang nih cun ṭhat lonak vialte kha a thleidan khawh dih.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aho tal nih, “Ka lung cu ka thianter i ka sualnak in ka thiang cang,” an ti kho lai maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Cuai deu le rel deu hman hi Bawipa caah fihnung an si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngakchia hmanh nih a tuahmi a ṭhat le a din kha a tuahnak in amah lila nih a langhter ko.
  </para>
  <para style="p">
    <verse number="12" style="v" />Theihnak hna hna le hmuhnak mit hna hi Bawipa sermi an si dih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ih hi duh hlah, sifahnak na phan sual lai, na mit i au law rawl tampi na ngei ko lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thil cawtu nih cun a man a fak tuk, a ti zungzal, sihmanhsehlaw a kal hnuah cun ka det khawh tiah aa porhlaw ṭhan ṭung.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sui tampi a um ko, a man a tammi lung zong tampi an um ko, sihmanhsehlaw fimnak bia cu a tlawmte i a man a sung cikmi lungvar a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hngalh lomipa leiba caah amah le amah aamahkhan tiangin a hrutmi cu, a thilri kha aamahkhannak ah cun tlaih a si lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lihchim in hmuhmi rawl cu a thlum, sihmanhsehlaw luklak ah a kaa ah lungtekem bantuk an si.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lungthin i cheuhnak in khuakhanmi kha a hmun, i timh ciammam loin raltuknak hmun chungah lut cutmat hlah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi hmursau nih biathli kha a phuan tawn, Cucaah a holh tukmi cu kom hlah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahohmanh nih a nu siseh a pa siseh a vawlhpamh hna ahcun, Muihnak a rat tikah a mei-inn kha a mit lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khulrang tuk in hmuhmi chawva cu, a donghnak ah thlua a chuak lai lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Ṭhat lonak cu ṭhat lonak in ka rulh lai,” tiah va ti hlah, Bawipa kha va hngak law, amah nih an bawmh lai
  </para>
  <para style="p">
    <verse number="23" style="v" />Cuai deu cu Bawipa caah fihnung a si, tahnak deu cu a ṭha lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Minung lam a kan hruaitu cu Bawipa a si, zeitindah mi nih a lam cu a hngalh khawh lai?
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathian sin pek awk laksawng naa kam hlanah ṭha tein ruat hmasa, a hnuah naa ngaichih sual lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Siangpahrang fim nih cun miṭhalo kha a hngalh hna i zaangfahnak ngei loin dan a tat hna.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bawipa nih ruahnak le a chia le a ṭha thleidan khawhnak lungthin a kan pek. Kanmah sinin kan i thup kho lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zumhawktlak sinak le zumhnak ṭha nih siangpahrang cu a kilven i a bawi ṭhutdan cu dinnak nih a dirter.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tlangval hna an sunparnak cu an thazang hi a si, tar hna an i dawhnak cu an sam par hi a si.
  </para>
  <para style="p">
    <verse number="30" style="v" />A zei maw caan ahcun, kan ziaza i thlen awkah harnak ton kha a herh tawn.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Siangpahrang lungthin cu Bawipa kut chungah a ummi a si, tilaknak tilam bantukin a duhnak lei paoh ah a mermi a si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi kip nih mahle umtuning cio hi mahle mit cio ah cun a dik in hmuh a si, Sihmanhsehlaw lungthin cuai a thlaitu cu Bawipa a si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dinnak le biading tuah kha, raithawinak nakin Bawipa nih a cohlan deuhmi a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Miṭhalo cu ruamkainak le porhlawtnak nih a uk hna i hihi sual a si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Teimaknak le a hlankan in ṭha tein thil rak ruahchungnak nih duhdimnak kha a chuahter i cu bantuk ṭhiamṭhiam in namchan in thil a timi paoh cu sifahnak an tong hrimhrim ve ko lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lihchim in hmuhmi chawva cu a zuangmi tikhu le thihnak rap an si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miṭhalo cu anmah nih an tuahmi zaang-ennak chung lila ah khan an i foih, zeicahtiah a dingmi thil tuah kha an duh lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />A sualmi nih cun lam kawi kha an zulh, sihmanhsehlaw a sual lomi nih cun a hmaanmi kha an tuah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi phunzai nupi he innpi i hrawm nakcun, inncung a ken ken khatte i um a ṭha deuh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Miṭhalo nih cun ṭhat lonak kha a duh zungzal ko, A innpa cungah zaangfahnak a ngei lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miporhlaw cu dantat a si tikah mihrut kha an lung a fim, Mifim cu cawnpiak an si tikah, hngalhnak kha an i chap.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miding mi nih cun miṭhalo mi nih zei an ruah le zei nih dah an tluknak kha a chuahter ti kha an hngalh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Misifak hna an au tikah a hna aa chehmi cu, amah a au ve tikah ahohmanh nih an theihpiak ve lai lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />A thli tein pekmi laksawng nih thinhunnak kha a damter, puan tangin pekmi nawhthuh nih thinlinhnak ṭhawngpi kha a daihter.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bia cu ding tein ceih a si tikah miding mi hna caah lawmhnak a si, sihmanhsehlaw thil ṭhalo tuahtu hna caah cun vansang auhnak a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hngalhthiamnak lam zul loin a pialmi cu thihnak nih a bawh ko.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nuamhnak a duhmi cu misifak a si lai, zu le sa a duhmi cu a rum bal lai lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Miṭhalo nih miṭha hna cungah temhnak tlunter an timhmi kha, anmah cung lila ah an tlunter tawn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nu phunciar sik duh he um nakcun, thetse ram i va um ziar khi a ṭha deuh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mifim umnak ah cun ro le rah kha a tang, sihmanhsehlaw mihrut nih cun nih cun a sawksam dih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dinnak le zaangfahnak zulh aa zuammi nih cun Nunnak le upatnak a hmuh lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />A fimmi ralbawi nih cun miṭhawng hna khuapi kha a lak khawh i An i bochanmi ralhruang kha a chimh khawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A ka le a lei aa veng khomi cu harnak chungin aa veng khomi a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aa porhlaw i a ruam a kai i ninghngal in mi zei ah a rel lomi cu a min ah “Nihsawhtu” ti a si.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rianṭuan zuam loin a ummi mithathu cu amahle amah kha aa that ko.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chun nitlak in a ruahmi cu zei khi dah hei ngei ning law ti lawng khi a si ko. Sihmanhsehlaw miding nih cun mi kha a pek hna i sianh loin a um hna lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Miṭhalo raithawinak cu Bawipa, caah fihnung a si, Tinhmi ṭhalo he a rak put ahcun zeitluk in dik fihnung a si chinchin.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tehte deu cu a rawk lai, Sihmanhsehlaw thil ṭha tein a ruat dildelmi pa bia cu cohlanpiak a si lai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Miṭhalo nih cun miralṭha hmai aa putter, Sihmanhsehlaw miding nih cun cun amah le amah kha aa zum ko.
  </para>
  <para style="p">
    <verse number="30" style="v" />Fimnak siseh, hngalhnak siseh, chunglei thil purh khawhnak siseh, Bawipa hmaiah cun zeihmanh an si lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Raltuknak ni caah rangtum cu timh a si, Sihmanhsehlaw teinak cu Bawipa sinin a rami a si.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Min ṭhat maw chawva tampi dah naa thim lai, ti na si ahcun, min ṭhat kha vaa thim deuh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mirum le misifak hna cu an i dang lo zeicahtiah Bawipa sermi cio an si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mifim nih cun harnak a rat kha a hmuh tikah hrial khawhnak aa zuam, sihmanhsehlaw mihrut nih cun a pahchih thluahmah ko i a hnuah aa ngaichih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawipa kha ṭih, mi toiah i dor law rumnak le upatnak le nunsaunak kha na hmuh lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miṭhalo mi hna lam ah cun hling le rap an um; aa ralringmi nih cun a hrial in a hrial hna.
  </para>
  <para style="p">
    <verse number="6" style="v" />A zulh awk a simi lam kha ngakchia cu cawnpiak law, a upat tikah mah cucu a pialtak ti lai lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mirum nih misifak kha an uk hna, cawitu cu coihtu sal a si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dinlonak thlaici kha na tuh ahcun harnak kha na zun lai i na rian theitlai cu fungfek kha a si lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Siannak lungthin a ngeimi cu thlua a chuak lai, zeicahtiah a rawl kha sifakmi a hrawm hna.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi lungpuam kha dawi u law rem lonak a lo lai, siknak le holh ṭhalo a dong lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Siangpahrang cu faknak in na hawikom ah na ser khawh lai, sihmanhsehlaw Bawipa nih lungthiangmi kha a duh hna.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lihchimmi bia kha lih an si tiah Bawipa nih a langhternak thawngin biatak cu him tein a kilven.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mithathu cu inn ah aa benh ko, lengah ka chuah ahcun chiandeih nih a ka seh lai, a ti.
  </para>
  <para style="p">
    <verse number="14" style="v" />Va cungin pa aa duhmi bia cu khor thuk bantuk a si, Bawipa nih chiat a serhmi hna cu cuka ah cun an tla lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngakchia nih hin hruhnak thil le thil ṭhalo hi an tuah tawn phung a si, Sihmanhsehlaw chimhhrinhnak fung nih cun ṭha deuh in a cawnpiak hna lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sifak mi hrem cu miaknak a si sawk ko lai, sihmanhsehlaw mirum sin, i ser cu sifahnak a si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na hna chi law mifim mi bia hi kan cawnpiak lai. Cun na lungthin cu ka fimnak na hmuh nakhnga caah hmang tuah;
  </para>
  <para style="p">
    <verse number="18" style="v" />Zeicahtiah na lung chung i chiah cu a nuammi a si lai i Na duh chel paoh ah khan na vun lak khawh hna lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bawipa kha i bochan tiah nangmah cu kan duh caah Nihin ah hin hi thil hna hi nangmah ca ṭhatnak ding caah kan chimh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hika ah hin nangmah caah fimnak bia sawm thum kan ṭialpiak, hi bia hna cu hngalhnak in a khatmi le lungthin cheuhnak ṭha in a khatmi an si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Cu bia hna nih cun biatak kha zeidah a si taktak ti kha an in cawnpiak lai i nangmah an fialtupa sinah khan ahmaanmi bia cu na kirpi ṭhan khawh lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sifakmi cu sifak an si ruangah zeitikhmanh ah va ramh hna hlah, Retheimi zong zung chungah va hrial hlah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Zeicahtiah annih cu Bawipa nih a dirpi hna lai i anmah an nunnak ca i a simi an thilri a lakpiaktu hna kha an thilri a chuh ve hna lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thinhun a hmang lengmangmi cu va kom hlah, thin tawimi zong va kom hlah,
  </para>
  <para style="p">
    <verse number="25" style="v" />A lam kha naa cawn sual lai i nangmah le nangmah rap ah naa foih lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi leiba ruangah aamah vaa khang hlah,
  </para>
  <para style="p">
    <verse number="27" style="v" />Na cham khawh lo sual ahcun na ihkhun zong an in lakpiak lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nan pupa hna nih an rak chiahmi ramri tung kha ṭhial hna hlah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amah a rian ah a thiammipa cu siangpahrang hna hmaiah a dirmi a si lai, mi sawhsawh hna hmai men ah a dirmi a si lai lo.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uktu bawi hna he rawl ei ah na ṭhut tikah, aho an si kha ṭha tein va ruat.
  </para>
  <para style="p">
    <verse number="2" style="v" />Cun pawkaumi na si ahcun na or kha i sum.
  </para>
  <para style="p">
    <verse number="3" style="v" />An in pekmi rawl thawthaw kha hakkau tuk in ei hna hlah, Zeicahtiah hlen an in timh a si kho ko.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rumnak hmuh awkah i hre tuk hlah, ngol awkah fimnak a za ngei tuah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na tangka cu mitṭhep ah an lo kho ko, Thla kha i serh duak in mupi bangin an zuang kho ko.
  </para>
  <para style="p">
    <verse number="6" style="v" />A khiar mipa zanriah cu va ei hlah, a rawl thawthaw zong kha na mit va thi hna hlah;
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ei tuah hen, ding tuah hen,” an ti lai, Sihmanhsehlaw cucu a chim duh taktakmi a si lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah cu na hrom ah sam bantuk ah a cang lai i Na eimi vialte kha na luak dih lai i na faknak bia vialte cu santlailo ah a cang lai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihrut theihhngan ah cun bia va chim len hlah, Fimnak bia na chimmi cu zeihmanh ah a rel ṭung lai lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlanlio ramri tung kha ṭhial hna hlah, Ngakṭah kha an lo chut hna hlah;
  </para>
  <para style="p">
    <verse number="11" style="v" />Zeicahtiah annih nih a ṭhawngmi hupphengtu an ngei i Amah nih cun nangmah kha taza an in cuai tikah an bia a chimpiak hna lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na saya nih an cawnpiakmi kha ṭha tein ngai law Fimnak kha naa lak khawh chungin i lak tuah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngakchia chimhhrin cu i sum hlah, fung in na tuk ahcun a thi lai lo,
  </para>
  <para style="p">
    <verse number="14" style="v" />Bia ngaingai ti ahcun, Sheol chungin na khamh a si lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka fapa mifim na si ahcun keimah zong ka lung aa lawm lai.
  </para>
  <para style="p">
    <verse number="16" style="v" />Fimnak bia na chim kha ka theih tikah keimah zong ka rak i lawm ngaingai lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Misual kha tluk i zuam hna hlah, nifate in Bawipa a ṭihmi bel kha hngar ko hna;
  </para>
  <para style="p">
    <verse number="18" style="v" />Cu bantukin na tuah ahcun hmailei ah ceunak na hmuh lai i na nun khua zong a sau lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka fapa, ngai law fim tuah, ahmaanmi lam zulh awk kha i sehchih tuah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zuri hna he i kom hlah, sarammi hna he zong i kom hlah;
  </para>
  <para style="p">
    <verse number="21" style="v" />Zeicahtiah zurimi le sarammi cu sifahnak an phan lai, ei le ih lawng na rianh ahcun puanchia he na vak tuan ko lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmah an hringtu na pa kha a bia va ngai, na nu kha a tar tikah va serhsat hlah.
  </para>
  <para style="p">
    <verse number="23" style="v" />Biatak kha vaa cawk law zuar ti hlah, fimnak, cawnpiaknak le hngalhthiamnak kha i cawk hna.
  </para>
  <para style="p">
    <verse number="24" style="v" />Miṭha mi hna an pa cu aa lawm ngaingai lai; fapa fim a hringmi pa cu a fapa hna cungah khan aa lawm lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na nu le na pa cu lawmhter hna, nangmah an hringtu cu lawm tein um seh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka fapa, ka bia cu i chingchiah hna law ka nunning hi i zohchunh tuah.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hlawhhlangnu cu khor thuk a si, ralṭha nu cu a bimi tikhor a si.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mifir bangin mi a bawh hna i a va kha pa pakhat hnu pakhat sinah a rawi lengmang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahodah chimpit vansang in a um tawn? Ahodah a ngaih a chia tawn? Ahodah mi he aa si tawn? Ahodah bia a ngei tawn? Ahodah zei ruang lo ah hma a ing tawn? Ahodah mit sen remrum in a um tawn?
  </para>
  <para style="p">
    <verse number="30" style="v" />Zu a camhmi, rim thar he cawhmi zureu a hneksak lengmangmi kha an si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hrai chungah sen kirker tein a um i tleu dildel tein a lang i vun dolh ah nal ngaiin lanh dawh a simi zu khi va zoh hlah.
  </para>
  <para style="p">
    <verse number="32" style="v" />A donghnak ah cun rul bantukin mi a cu i ping-er sivai bantukin mi a henh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khi tikah na mit nih thil khuaruahhar a hmuh hna lai i. Fiang tein khua na ruat kho lai lo i aa ningcang loin bia na chim lai.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rili ah lawngin a kal i a rimi bantukin na um lai i aa hnin lengmangmi lawng puanzar ah khin i awk law cu ko cu na lo lai.
  </para>
  <para style="p">
    <verse number="35" style="v" />“An ka tuk an ka den i a si ṭheo lai, sihmanhsehlaw zeihmanh ka hngal lo, Zeicahdah kaa hlauh khawh lo ee? Din ṭhan ka herh rih i a si ko hi ta,” na ti lai.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Miṭhalo hna tluk kha i zuam hlah, annih cu hawikom i i ser zong kha i zuam hlah.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zeicahtiah annih an ruahmi cu zaang-ennak lawng kha a si i an kaa an an paoh ahcun pakhatkhat cungah harnak an tlunter zungzal.
  </para>
  <para style="p">
    <verse number="3" style="v" />Fimnak nih inn cu a sak, hngalhthiamnak nih a fehter;
  </para>
  <para style="p">
    <verse number="4" style="v" />Hngalhnak nih a khaan vialte hna cu a sungmi le aa dawhmi thilri in a khahter.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mifim cu miṭhawng nakin a ṭhawng deuh, hngalhnak a ngeimi cu thazang a ngeimi nakin a ṭhawng deuh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Zeicahtiah ral cu ṭha tein khuakhannak thawngin tei a si i saupi timhtuahnak theitlai cu teinak a si.
  </para>
  <para style="p">
    <verse number="7" style="v" />Fimnak hi mihrut caah cun a sang tuk i a hngalh khawhmi a si lo, thil pipa ceih tikah zeihmanh chim awk a hngal lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ṭhatlo tuahnak khua a khang lengmangtu cu a min ah Harnak Sertu ti a si lai,
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihrut nih khua an khanmi cu sualnak kha a si tawn i mi nihsawh a hmangmi cu huatnak kha an tong zungzal.
  </para>
  <para style="p">
    <verse number="10" style="v" />Harnak caan i na der a si ahcun na der taktak a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thah awk i an kalpi liomi hna cu va chanh hna, Thah awk i an hnuhchih lenmi hna cu va khamh hna.
  </para>
  <para style="p">
    <verse number="12" style="v" />Naa thawh i, “Hi pa hi ka rak hngalh bal ṭung lo,” na ti ahcun, na lungthin a hngaltu Pathian nih khan an chingchiah lai. Nangmah an zohkhenhtu Pathian nih a hngalh kha hngal ko law mi cu an tuahning khan a cham cio ko hna lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka fapa, khuaihliti cu ei tuah, a thaw; a thlar chungin a tlami khuaihliti cu na lei cungah a thlum bangin
  </para>
  <para style="p">
    <verse number="14" style="v" />Fimnak le hngalhnak cu na nunnak caah an ṭha. cucu na ngeih hna ahcun hmailei ah ceunak na hmu lai i na nunkhua a sau lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miṭha mi cu a inn ah miṭhalo nih an bawh bangin va bawh hlah, a lo zong kha va chut hlah;
  </para>
  <para style="p">
    <verse number="16" style="v" />Zeicahtiah miṭha mi cu voi sarih tiang tlu hmanh seh law a tho ṭhan zau lai, sihmanhsehlaw miṭhalo cu vanchiatnak nih a hrawh hna.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na ral kha a tluk tikah i lawm hlah, a rilh tikah na di riam hlah,
  </para>
  <para style="p">
    <verse number="18" style="v" />Cu bantukin na um ahcun Bawipa nih a hngalh lai i na cungah a lung aa lawm lai lo i amah kha dantatnak in a luatter sual lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ṭhat lonak tuahtu hna kha zuam hna hlah, miṭhalo kha tluk i tim hna hlah;
  </para>
  <para style="p">
    <verse number="20" style="v" />Zeicahtiah miṭhalo cu i ruahchanmi hmailei caan an ngei lo i an meiinn kha hmih an si lai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka fapa, Bawipa le siangpahrang cu ṭih hna, anmah a dohtu hna he khan i kom hlah;
  </para>
  <para style="p">
    <verse number="22" style="v" />Zeicahtiah cu bantuk mi hna cu chikkhatte ah an rawk kho i Annih nih zei bantuk rawhnak dah an chuahter lai kha aho nih dah a hngalh lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mah hihi mifim mi hna bia a dang an si rih: biaceih i duhdanh ngeih cu a ṭha lo,
  </para>
  <para style="p">
    <verse number="24" style="v" />A sual komi, a sual lo, tiah a titu biaceihtu bawi cu miphun zakip nih chiat an serh i mi vialte nih an huat.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sihmanhsehlaw miṭhalo sual a phawtu biaceihtu bawi hna cu khua awng an tong lai i an cungah thluachuahnak ṭha a um lai.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lihchim lo tein bia i leh cu hawikom ṭha taktak sinak langhnak a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lenglei thil vialte kha ṭha tein tim dih hmasa hna, Cun na lo kha sersiam hna law cu hnuah cun nupi ṭhit le innlo khuasak tintuk cu a si lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zei ruang setsai lo ah na innpa cungah tehte va si hlah, Amah kong ah thil a ping i a kalter khotu ding bia zong va chim hlah.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ka cungah a tuah bantukin ka tuah ve lai, a tuahmi kha ka lehrulh ve lai,” ti hlah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mizaangthupa lo kha ka tan i ruahnak ruahnak a ngei lomipa mitsur dum kha ka pal,
  </para>
  <para style="p">
    <verse number="31" style="v" />Zohhmanh, hling nih a zual dih i vawlei cu thahau nih a khuh dih, a kulhnak lung hau cu an cim dih.
  </para>
  <para style="p">
    <verse number="32" style="v" />Cun ṭha tein cucu ka zoh i khua ka ruat i hi cawnpiaknak hi kaa hmuh:
  </para>
  <para style="p">
    <verse number="33" style="v" />Cu cawnpiaknak kaa hmuhmi cu hihi a si: “Tlawm tein it ko rih ning, tlawm tein i hngilh ko rih ning, tlawm tein ka kut cu i din ko rih seh ti chungah hin,
  </para>
  <para style="p">
    <verse number="34" style="v" />Sifahnak cu mifir bantuk le herhbaunak cu hriam aa putmi miramhtu bangin na cungah a phan lai.”
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hi zong hi Solomon phungthluk bia, Judah siangpahrang Hezekiah mi hna nih an ṭial chinmi cu an si.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian nih thil a thuh hi a sunparnak a si; Sihmanhsehlaw siangpahrang hna sunparnak tu cu thil fianter hi a si.
  </para>
  <para style="p">
    <verse number="3" style="v" />San leiah van, thuh leiah rili, cu bantuk cun siangpahrang lungthin cu purh khawh lo a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngun kha a ek hlonh law cu tikah zungthiam nih thil dawh ah a ser lai;
  </para>
  <para style="p">
    <verse number="5" style="v" />Siangpahrang hmaika in miṭhalo cu ṭhial hna u law a bawiṭhutdan cu dinnak in a fek lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siangpahrang hmaika ah vaa hmanh len hlah, Mi ngan hna sin zongah va ṭhu hlah;
  </para>
  <para style="p">
    <verse number="7" style="v" />Zeicahtiah “Hika ah hin hung kai,” ti cu “Nangmah nakin a ngan deuhmi kha ṭhutnak kian tuah,” ti nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na mit nih a hmuhmi kha khulrang in zung ah chuahpi hlah, Zeicahtiah tehte dang nih na palhnak kha a hnuah a langhter khawh ahcun zeitindah na um lai?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na innpa he nan ruahnak aa dan ahcun cucu nanmah pahnih i ceih hmasa u, Sihmanhsehlaw midang biathli bel kha phuang hlah;
  </para>
  <para style="p">
    <verse number="10" style="v" />Na phuan ahcun a theih tikah taza an cuai lai i Naa chuahsualnak kha let ṭhan khawh a si ti lai lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />A caan hmaante ah chimmi bia fang bia khat cu ngun bawm chung i sui theitlai bantuk a si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chimhringtu a fimmi cu, a bia ngaih a duhmi caah cun, Sui kutdonghrolh le sui hlawn bantuk a si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zumh awk tlak a simi lamkaltu cu, a thlahtu hna caah, facang ṭuan caan i a kikmi hawhra bantuk a si, A bawile lungthin kha a hrimhter.
  </para>
  <para style="p">
    <verse number="14" style="v" />Laksawng kan pek lai a ti lengmang i a pe taktak ṭung lomi cu Ruahti pawi lo khuadawm le thli bantuk a si.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thinfualnak in uktu bawi cu lem khawh a si lai, Awka nem nih ruh hmanh a khiah khawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khuaihliti kha tam tuk in ei hlah, na luak sual lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na innpa inn ah leng tuk hlah, na nor lai i an huat sual lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hawikom cungah a hmaan lomi tehte a simi cu thingtan le vainam le a harmi cantiang bantuk a si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Harnak caan i zumhtlak lomi zumh cu, ha ṭhalo in rawl khai bantuk le a fakmi ke in kal i zuam bantuk a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngaih a chiami caah cun hlasak thiam bik hna hmanh khi Khuasik ni i puan i phoih bantuk le hma i a thormi thuh bantuk a si.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na ral kha a rawl a ṭam ahcun ei awk rawl va pe, A ti a hal ahcun din awk ti va pe;
  </para>
  <para style="p">
    <verse number="22" style="v" />Cu ti na tuah ahcun a lu cungah meiṭil kha na pumh hna a si lai i Bawipa nih nangmah cu an rulh lai.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chaklei thli nih ruah a ratpi, congoihnak nih thinhunnak a chuahpi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi sik duh nupi he innpi i hrawm nakcun, Inncung a ken ken khatte i um a ṭha deuh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ram hla piin theihmi thawngṭha cu, na ti a hal, na dang a car i tikik na vun din bantuk khi a si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Miṭhalo mi lam a piantu miding cu, a nawimi tikhor bantuk, a thurmi tiput bantuk a si.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khuaihliti tam tuk ei cu a ṭha lo, cu bantukin mi sinin thangṭhatnak tam tuk hmuh i timh cu thilrit a si.
  </para>
  <para style="p">
    <verse number="28" style="v" />A thin aa sum kho lomi cu, Baohmi khua, kulhnak vampang a ngei ti lomi bantuk a si.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ṭhal caan i hawhra bantuk le rawlṭuan caan i ruah bantukin, upatnak cu mihrut caah cun aa tlak lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hram ngei loin chimmi chiatserhnak cu, aa chawk lengmangmi pithlung bantuk le a zuang lengmangmi vanva bantuk a si, chiatserhmi kha a futhnawh kho lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuknak fung cu rang caah a si, chak cu laa caah a si, fungfek cu mihrut keng caah a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihrut cu a hruhning in let hlah, amah bantuk na si ve sual lai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihrut cu a hruhnak nih hmuh awkah aa tlakning in let tuah, cu ti a si lo ahcun, ka fim tiah aa ruat sual lai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihrut kha lamkal a fialtu cu amah ke aa tanmi bantuk a si, harnak kha aa sawm a si ko.
  </para>
  <para style="p">
    <verse number="7" style="v" />Phungthluk bia cu mihrut kaa chungah cun, kebeimi ke aa thlai sawhsawh bantukin aa thlai sawhsawh ko.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihrut kha upatnak pek cu, chai i lungpum tete ṭem chih bantuk khi a si ko.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihrut nih phungthluk bia a vun lak i a chim ve cu, Zuri nih a kut i a chuntu hling coih aa zuam bantuk khi a si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihrut siseh, zuri siseh, rianṭuan ah aa sawmmi cu, A rami paoh a rak kap tawntu thalkah thiam bantuk a si.
  </para>
  <para style="p">
    <verse number="11" style="v" />A hruhnak a nolh ṭhan lengmangmi mihrut cu, A luak a kirhnawh ṭhantu uico bantuk a si.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah aa hmuhnak ah ka fim aa timi nakcun, mihrut caah ruahchannak a um deuh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mithathu cu zeicahdah a inn in chuah a duh lo? Zeidah a ṭihmi an si? Chiandeih an si maw?
  </para>
  <para style="p">
    <verse number="14" style="v" />Innka nih a kapza ah aa mer lengmang bantukin mithathu zong a ihkhun cungah aa let lengmang ve.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mithathu nih cun a kut kha kheng chungah a hnim, a kaa i hun i tuh zong kha a zuam lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Fim tein bia lehnak a chim khomi minung pasarih nakin, Mithathu cu amah aa ruahnak ahcun a fim deuh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aa thlak ve awk a si lomi siknak ah aa thlakmi cu a kal liomi uico a hnakhaw in a tlaimi bantuk a si.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi kha a hleng i, “Kan capo ko hen cu,” a timi cu, mei alh tom le thal le thihnak hriamnam hna he lente aa celhmi mimolh bantuk a si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing a um lo ahcun mei cu a mit, a thli tein a chim depmaptu um lonak hmun ah cun siknak a dai.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meihol cu meiṭil a vaamtertu le thing cu mei a nuntertu a si bantukin, Hnahnawhnak chuahtertu cu rem lonak mei kautu a si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Din tein bia a chim depmaptu bia cu rawl thaw bantuk a si, pum chung chungchin ah khan a lut kho.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmurka thlum i lungthin ṭha ṭung lo cu, tlak-um cung i nalhmi sinal bantuk a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na ral nih cun a kaa cun na thangṭhatnak a chim ko lai. sihmanhsehlaw a lung chung cun hlennak aa pawi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Cu pa nih cun, ṭha ngaiin bia a chim tikah zum hlah, zeicahtiah a lung chungah cun fihnungmi thil pasarih an um.
  </para>
  <para style="p">
    <verse number="26" style="v" />A lung chung i huatnak a ummi cu hlennak in a thup lai nain a ṭhat lonak cu zapi pumhnak ah a lang lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Midang tlaknak caah khor a comi cu cuka ah cun amah a tla lai. Midang nenhnak caah lung a hriltu cu lung nih cun amah cu a nenh lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lihchim hmangmi lei nih cun a sual lomi kha a sual a lawhter hna, Nalbia nih cun rawhralnak lawng kha a chuahpi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thaizing kong kha i porhlaw hlah, cu ni nih zei a chuahpi lai kha na hngal lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmah kaa nih si loin midang tu nih in thangṭhat deuh hna seh, nangmah hmur nih si loin khual tu nih in thangṭhat deuh hna seh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lung hi a rit i thetse zong hi a khing a rit ko, sihmanhsehlaw mihrut nih hnahnawhnak an chuahpimi cu cu hna pahnih nakcun a rit deuh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thinhunnak hi a puar i thinlinhnak hi a hrang ko, sihmanhsehlaw nahchuahnak he cun tahchunh awk tlak hmanh an si lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thuhmi dawtnak nakin lenglang sik a ṭha deuh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kan hawikom nih cun an kan hliam sual hmanh ah kan ca i ṭhatnak an duh ruangah a si, sihmanhsehlaw ral nih an kan hnamh cu leirawi duh ah a si.
  </para>
  <para style="p">
    <verse number="7" style="v" />A vuai cangmi nih cun khuaihliti kha a fih, sihmanhsehlaw a rawl a ṭammi caah cun a kha mi thil hmanh kha an thlum dih.
  </para>
  <para style="p">
    <verse number="8" style="v" />A inn in a tlaumipa cu a bu in a tlaumi va bantuk a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chiti le zihmui nih lung an lawmhter, sihmanhsehlaw harnak nih lungthin kha a cheu a hmal dih tawn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na hawikom siseh, na pa hawikom siseh, hlaw hna hlah; na vanchiat ni ah na unaupa kha bawmh hal hlah, lam hlat i a ummi unau nakin lamnai i a ummi innpa nih an bawmh khawh deuh lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka fapa, fim law ka lung ka lawmhter tuah, cuticun a ka soitu kha ka leh khawh hna lai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mifim nih cun harnak a rat kha a hmuh tikah hrial khawh aa zuam, sihmanhsehlaw mihrut nih cun a pahchih thluahmah ko i a hnuah aa ngaihchih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi pakhatkhat nih khual pakhatkhat caah biahrennak a tuah tikah a puan kha va tlai, cun cu puan cu hngalh lomipa ca aamahkhannak caah khan va tlai ko.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zingka tein na thawh i na innpa kha aw thang tuk in thluachuahnak na pek ahcun, chiatserhnak bantuk ah an relpiak sual lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ruah it ni i a tla thliahmah lengmangmi ruah le nu phunciar cu ang khat an si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Cu nu kham timh cu thli kham timh bantuk a si, orhlei kut in chiti hum bantuk a si.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thir nih thir a harter, mi zong nih midang fimnak kha a harter ve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theipi kung a zohkhenhtu nih a thei a ei lai. A bawipa a kilvengtu nih upatnak a hmuh lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ti chungah hmai cu hmai in a langh bantukin, Minung cu a lungthin nih khan zei bantuk mi dah a si ti kha a langhter.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sheol le Abaddon cu zeitikhmanh ah an vuai bal lo. Minung mit zong zeitikhmanh ah a vuai bal ve lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Titnak um cu ngun caah a si, somei cu sui caah a si, Cu bantukin mi cu thangṭhatnak a hmuhmi in hneksak a si lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihrut cu sum ah sumkhal in su hmanh law a hruhnak cu a thlah hlei lai lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na tuurun an umtuning kha ṭha tein hngal law na cawrun kha ṭha tein zohkhenh hna;
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeicahtiah rumnak hi zungzal in a hmun lo i Bawi luchin zong hi chan vialte tiangin a hmun kho lai lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ram cu an hung thi i an hung lo, ramhno cu an hung corh, Cun tlang cung ram hna cu pumh an si tikah,
  </para>
  <para style="p">
    <verse number="26" style="v" />Tuufa nih na hnipuan ca kha an in rin lai i meheh nih lo man ca kha an in rin lai;
  </para>
  <para style="p">
    <verse number="27" style="v" />Cun na rawl caah a za ding le na innchungkhar hna rawl caah le na ngaknu hna caah a za ding meheh hnuk cu a um lai.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Miṭhalo cu ahohmanh nih dawi loin an zam, sihmanhsehlaw miding mi cu chiandeih bantukin an ral a ṭha.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ram cu a fimmi le khuaruah a thiammi hruaitu a ngeih hna tikah saupi a dir kho, sihmanhsehlaw uktu kha atu le atu an i thlen lengmang cu ram kha a sual caah a si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Misifak a hremtu hna bawi cu, rawl zeihmanh a ngan lotu ruah bantuk a si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Phung a zul lomi nih cun miṭhalo kha an thangṭhat hna, sihmanhsehlaw phung kha a zulmi nih cun an doh hna.
  </para>
  <para style="p">
    <verse number="5" style="v" />Miṭhalo nih biading hi zeidah a si kha an hngal lo, sihmanhsehlaw Bawipa a kawlmi hna nih cun tling tein an hngalh cikcek.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sifak te i nun i lihchim lo tein um hi lihchim i rum nakin a ṭha deuh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Phungbia a zulmi cu fapa fim a si, sihmanhsehlaw ei din leiah sumnak a ngei lomi hna hawikom a simi cu a pa caah ningzahnak a si.
  </para>
  <para style="p">
    <verse number="8" style="v" />A miak le a karh in a rumnak a chap chintu nih, misifak hna cung i zaangfahnak a ngeimi pa caah khan a khon a si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Phungbia kha ngai duh loin a mertakmi cu a thlacamnak hmanh kha fihnung a si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Miding mi kha ṭhat lonak lei kal awkah a lemtu cu, amah nih a cawhmi khor lila ah khan a tla lai; Lihchim lomi nih cun a ṭhami ro kha a hmuh lai i Sihmanhsehlaw miṭhalo nih cun zeihmanh an hmu lai lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mirum nih cun ka fim tiah an i ruat zungzal, sihmanhsehlaw hngalhthiamnak a ngeimi misifak nih khan anmah nakin a hngalh deuh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miding mi nih uknak an co tikah conglawmhnak tampi a um, sihmanhsehlaw miṭhalo an kai tikah mi cu an i thup dih.
  </para>
  <para style="p">
    <verse number="13" style="v" />A palhnak kha a thupmi cu khua-awng a tong lai lo, sihmanhsehlaw a phuang i a hlawmi nih cun zaangfahnak a hmuh lai.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bawipa a ṭih zungzalmi cu mi thluachuak an si, sihmanhsehlaw a lung a hahtermi cu vanchiatnak chungah an tla lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Uktu ṭhalo cu misifak hna caah, a rawl a ṭammi chiandeih le a ti a halmi vom bantuk a si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil ruahning a thiam lomi uktu cu mihremtu a si tawn, ai hmanh seh law dinlonak kha a huami cu a chan a sau tawn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi thisen a chuahtu cu tlaihnak luatnak caah tikhor chung hmanh ah khan a zuang lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ningcang tein khua a sami cu him tein an um lai, sihmanhsehlaw ningcang loin khua a sami cu lam khatkhat in a sung ṭhiamṭhiam lai.
  </para>
  <para style="p">
    <verse number="19" style="v" />A vawlei ṭha tein a thlomi cu rawl tampi a ngei lai, sihmanhsehlaw santlailo rian pakpalawng a dawi lengmangmi cu a si a fak lai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zumh awk tlakmi cu thluachuahnak tampi a hmu lai, sihmanhsehlaw khulrang in rum aa zuammi cu dantatnak hmu loin a um lai lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Duhdanh ngeih hi a ṭha lo, sihmanhsehlaw changreu tlang khat ruangah mi nih ṭhat lonak kha an tuah ko lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mikhiar nih cun khulrang in rum aa hnawh, sihmanhsehlaw herhbaunak nih a ka tlunh lai ti kha a hngal lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />A lei in mi a fakmi nakin a situ nih khan hmailei ah cun duhdawtnak a hmuh deuh lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nu le pa thil fir cu a poi lo a timi cu mifir taktak he zeihmanh an i dannak a um lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hakkauhnak nih cun rem lonak lawng kha a chuahter ko, cucaah Bawipa i bochan cu a ṭha deuh suaumau.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mah ruahnak i rinh cu hruh a si, sihmanhsehlaw fimnak lam a zulmi cu him tein a lan ko lai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sifakmi a pechan lengmangmi cu a chambau bal lai lo, sihmanhsehlaw a mit a chinhkanhtu hna cu chiatserhnak tampi a hmu lai.
  </para>
  <para style="p">
    <verse number="28" style="v" />Miṭhalo nih uknak an tlaih tikah mi cu an i thup dih, sihmanhsehlaw an loh tikah miding mi nih khan uknak cu an co ve.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atu le atu chimhhrin a si ko nain a lung a ṭhawng rih komi cu, Damh khawh ti loin chikkhatte ah a kiak lai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Miding mi hna cu nawl ngeimi an si tikah mi cu an i lawm, Sihmanhsehlaw miṭhalo hna kha uktu an si tikah mi cu an hrum tawn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Fimnak a duhmi nih a pa cu a lawmhter, Sihmanhsehlaw hlawhhlangnu a kommi nih cun a chaw kha a hlohlak tawn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dinnak thawngin siangpahrang nih ram cu a fehter, Sihmanhsehlaw hneknak in tangka hmuhnak kha a ruah tikah a ram cu a rawk tawn.
  </para>
  <para style="p">
    <verse number="5" style="v" />A innpa a fakmi cu a ke caah sur rap a chiahpiak a si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miṭhalo cu amah sualnak nih khan a foih, Sihmanhsehlaw miding cu an i lawm i an luat.
  </para>
  <para style="p">
    <verse number="7" style="v" />Miṭha nih cun, sifakmi hna nih zeidah an covo si awk a si ti kha a hngalh, Sihmanhsehlaw miṭhalo nih cun cu bantuk zawnruahnak cu a hngal lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi nihsawh hmangmi nih khua chungah mei an thawhter tawn, Sihmanhsehlaw mifim mi nih cun mi thinlinhnak kha an daihter.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mifim nih mihrut kha taza a cuai ahcun, Mihrut cu a thin lawng a hung lai i a nih lawng a chuak men lai i daihnak zeihmanh a um hlei lai lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thisen chuah a duhmi hna nih cun a sual lomi kha an huat, Sihmanhsehlaw miding mi nih cun a nunnak kha an humhakpiak.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihrut nih cun a thinhunnak kha a langhter, Sihmanhsehlaw mifim nih cun dai tein a um i aa sum.
  </para>
  <para style="p">
    <verse number="12" style="v" />Uktu nih lihbia kha a ngaih ahcun, a kut toi ummi bawi vialte kha miṭhalo an si lai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Misifak le anmah a hremtu hna nih khan aa khat in an ngeihmi cu hihi a si: Bawipa nih an pahnih in mit a pek veve hna.
  </para>
  <para style="p">
    <verse number="14" style="v" />Siangpahrang nih misifak hna bia zong kha ruannak in a ceih ahcun a bawi ṭhutdan cu zungzal in a hmun lai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Fungfek le chimhhrinnak nih fimnak an pek, sihmanhsehlaw ngakchia anmah duh in thlahdorhmi nih cun an nule kha ningzahnak an phorh hna.
  </para>
  <para style="p">
    <verse number="16" style="v" />Miṭhalo hna nawl ngeitu an si tikah sualnak a karh, sihmanhsehlaw an tluk kha miding mi hna nih cun an hmuh lai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na fapa cu chimhring law hnangamnak an pek lai; na lung an lawmhter lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian nih a hruai lomi miphun cu ningcang loin khua an sa. Pathian nawlbia a zulmi cu lunglawmmi an si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bia lawngin sinum cu nunchimh khawh a si lo, a hngal ko nain zei ah a rel lai lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ruah hmasa loin bia a chim zauzaumi nakcun, mihrut caah ruahchannak a um deuh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na sinum kha a ngakchiat lio in a duhmi paoh na pek ahcun ni khatkhat cu nangmah thil kha an chuh dih te ko lai.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thin a tawimi nih rem lonak an chuahter, Thin aa sum lomi nih palhnak an tuah zungzal tawn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi cu aa porhlawtnak nih tangah a ṭhumh lai, sihmanhsehlaw toi dornak lungthin a ngeimi cu upatnak a hmu lai.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mifir hawikom a simi cu amah le amah kha a ral cu a si ko, a hmaanmi kha a chim ahcun dantatnak a hmuh lai, a chim lo ahcun Pathian nih chiat a serh lai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Midang nih zeitindah an ka ruah hnga ti hi thil ṭihnung a si, sihmanhsehlaw Bawipa i bochan hi himnak a si.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi kip nih uktu bawi duhdawtnak hmuh kha an duh, Sihmanhsehlaw mi nih biading cu Bawipa sin lawngin an hmuh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Miding mi nih miding lomi kha an huat hna, miṭhalo nih miding mi kha an huat ve hna.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Massa khuami Jakeh fapa Agur bia: Hi pa bia cu hitin a si: Ka re a thei tuk, maw Pathian, ka re a thei tuk i ka ba tuk cang;
  </para>
  <para style="p">
    <verse number="2" style="v" />Holh thiam lomi saram men ka si ko, minung hmanh ka si lo; minung nih hngalhthiamnak an ngeihmi hi ka ngei lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Fimnak hi ka cawng bal lo i A Thiang Mi sinin hngalhnak zeihmanh ka hmu bal lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Van ah khin ahodah a hung kai i a ṭum ṭhan? Aho nih dah a kut chungah thli kha a hum hna? Aho nih dah ti kha a puan in a fun hna? Aho nih dah vawlei cu a ramri kha a ser hna? A min cu ahodah a si i a fapa min cu ahodah a si? Na hngalh ahcun chim tuah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian nih biakamnak a sermi paohpaoh cu biatak a si tiah a fiang cang; amah chung i aa dormi hna caah cun amah cu phaw a si.
  </para>
  <para style="p">
    <verse number="6" style="v" />A bia zeihmanh chap hlah, an sik sual lai i lihchim na sinak kha a lang sual lai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thil pahnih kan hal, ka thih hlanah pe loin ka um sawh hna hlah:
  </para>
  <para style="p">
    <verse number="8" style="v" />Lihchim le hrokhrawl cu ka sinin lamhlapi ah ṭhial ko hna; Chamhbaunak siseh, rumnak siseh, ka pe hlah; ka ca i a herhmi rawl in ka cawm ko.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zeicahtiah tam tuk ka ngeih ahcun kan hlawt sual lai i, “ Bawipa cu aho hen dah a si?” ka ti sual lai; ka si a fah ahcun ka fir sual lai i ka Pathian min cu ka thurhhnawmh sual lai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sinum cu a bawipa sinah congoih hlah, chiat an serh sual lai i mawh na phor sual lai.
  </para>
  <para style="p">
    <verse number="11" style="v" />An pale kha chiat a serh i an nule kha a thangṭhat lomi an um tawn,
  </para>
  <para style="p">
    <verse number="12" style="v" />Anmah an i hmuhnak ah cun a thiang i, an fihnunnak aa thianh ṭung lomi an um fawn;
  </para>
  <para style="p">
    <verse number="13" style="v" />A ṭha hringhran i aa ruatmi zong an um, aize, a ṭha tuk hringhran ah khin pei an i ruah cu!
  </para>
  <para style="p">
    <verse number="14" style="v" />Sifakmi kha ṭam dih awkah le chambaumi kha ei dih awkah, a ha vainam a si i a khabe ah kawngthun aa bunhmi an um.
  </para>
  <para style="p">
    <verse number="15" style="v" />Cangvat nih fanu pahnih a ngeih hna; pakhat nih, “Ka pe,” a ti i a dang pakhat nih, “Ka pe,” tiah a ti ve. thil pathum cim hngal lo an um; thil pali “A za cang” a ti bal lomi an um:
  </para>
  <para style="p">
    <verse number="16" style="v" />Cu hna cu Sheol le a cingmi chul le a ti a hal zungzalmi vawlei le “A za cang,” a ti bal lomi mei an si.
  </para>
  <para style="p">
    <verse number="17" style="v" />a pa kha a nihsawh i a nu kha a tar tikah zei ah a rel lomi cu, a mit kha nelrawn langak nih an khoih lai i langta nih an ei lai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka caah khuaruahhar tuk a simi thil pathum an um; Ka hngalh khawh lomi thil pali an si:
  </para>
  <para style="p">
    <verse number="19" style="v" />Cu hna cu van i a zuangmi mupi lam, lung cung i a kalmi rul lam, rili cung i a kalmi sangphawlawng lam le pa nih ngaknu he an kalnak lam an si.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zumh awk tlak lomi nupi lam cu mah hihi a si: a ei i vaibar lote bangin, “Thil sual zeihmanh ka tuah lo,” a ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thil pathum ruangah vawlei hi a ther tawn; thil pali hna hi, in khawh lomi an si:
  </para>
  <para style="p">
    <verse number="22" style="v" />Cu hna cu sal siangpahrang ah a can le Mihrut a duhduh in ei awk a hmuh le
  </para>
  <para style="p">
    <verse number="23" style="v" />Duh lomi nu nih va a ngeih le Sinum nu nih a bawinu ro a co hi an si.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thil hme tete pali vawlei cungah hin an um, Sihmanhsehlaw cu hna cu, a fim bikmi nak hmanh in an fim deuh:
  </para>
  <para style="p">
    <verse number="25" style="v" />Cu hna cu hihi an si: Hngerhte, a ṭhawngmi an si lo na i an rawl ṭhal caan i aa khonmi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Saveh, a der ngaimi a si ko na i lungkua chung i a inn a sami;
  </para>
  <para style="p">
    <verse number="27" style="v" />Khaubawk, siangpahrang ngei a si lo na i a rualrual in a kalmi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Ṭekral, kut in tlaih khawh a si ko na i siangpahrang inn ah khua a sami.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hi thil pathum hna hi an kephau ah rumra an ngei, Hi thil pali hna hi an kal ah rumra an ngei:
  </para>
  <para style="p">
    <verse number="30" style="v" />Saram lak i a ṭhawng bik chiandeih, zeihmanh a ṭih lomi,
  </para>
  <para style="p">
    <verse number="31" style="v" />I zum ngaiin aa chawkmi arhli, mehehtum le a mi hna hmai i aa chawkmi siangpahrang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na rak hruh i na rak i porhlawt i holh fihnung a rak duhmi na si ahcun, na lei cu i sum.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zeicahtiah hnuk hang cu cawh lengmang ahcun a khal i hnar cu thongh ahcun thisen a chuak, Cu bantukin thinhunnak cu chuahter lengmang ahcun rem lonak a chuak.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Massa siangpahrang Lemuel bia, a nu nih a cawnpiakmi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmah cu ka dawtmi ka fapa, ka thlacamnak lehnak i ka hmuhmi ka fapa na si, zeidah kan chimh lai?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na thazang cu nu sinah va pe hlah, siangpahrang a hrawktu hna kha va kom hna hlah.
  </para>
  <para style="p">
    <verse number="4" style="v" />Maw Lemuel, siangpahrang nih cun zu din awk a si lo, uktu bawi hna caah cun zureu hi din awk a si lo;
  </para>
  <para style="p">
    <verse number="5" style="v" />Annih nih an din tikah upadi kha an philh i harnak a ingmi hna nih an hmuh awk hnga thil a simi kha zeirello in an um.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lung a dong cang i ngaihchia lungrethei in a ummi kha zu cu pe hna u,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ding hna seh law an sifahnak kha i philh hna seh, an harnak kha hngal ti loin um hna seh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aa chim kho lomi kha chimpiak hna, bawmtu a ngei lomi kha humhak hna;
  </para>
  <para style="p">
    <verse number="9" style="v" />Annih cu an bia chimpiak hna law an caah a dingmi biaceihtu va si ko; sifakmi le retheimi kha dirkamh hna.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nupi ṭha cu hlawn nakin tampi in a sung deuh, cu bantuk mi hmuh bel cu a har hringhran!
  </para>
  <para style="p">
    <verse number="11" style="v" />A va nih aa bochan i a va cu a si a fak bal lai lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />A nupi nih cun a nun chung vialte a va caah khan chiatnak si loin ṭhatnak kha a tuah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuuhmul le khumla in puan kha a tah lengmang hna.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thilri in a khatmi sangphawlawng nih thilri an rak phorh bantukin lamhlat piin rawl kha a rak phorh hna.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dei hlan in a tho i a innchungkhar caah khan rawl a chuan i a sinum ngaknu hna kha rian a chimh hna.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ṭha tein a ruah hnuah mitsur dum caah tangka a hmuhmi in lo pakhat kha a cawk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thazang tlung ngaiin le lungtho ngaiin rian kha a ṭuan i a ngan zong a dam.
  </para>
  <para style="p">
    <verse number="18" style="v" />A rianṭuanmi a hlawhtling ti kha a hngalh i zan ah a mei inn kha a mit bal lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amahte nih laa kha aa kher i amahte nih puan kha aa tah.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sifak retheimi sinah nun a siang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hawhra a tlak tikah a lungre a thei lo, Zeicahtiah a innchungkhar mi cu tling tein thil lum an ngei cio.
  </para>
  <para style="p">
    <verse number="22" style="v" />Puanbu aa ser hna i a thilpuan cu lahmangṭhia le maimaw in tahmi an si.
  </para>
  <para style="p">
    <verse number="23" style="v" />A va cu ram chung upa hna sinah a ṭhut tikah, hauka ah khan theihhngalhmi a si.
  </para>
  <para style="p">
    <verse number="24" style="v" />La hmangṭhia puan kha a tah hna i taisawm kha a ser hna i chawlettu sinah khan a zuar tawn hna.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amah cu a ṭhawngmi a si i hmaizahmi a si i hmailei caan kha a ṭih lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />A kaa cu fimnak in a pau i a lei cungah zaangfah cawnpiaknak kha a um.
  </para>
  <para style="p">
    <verse number="27" style="v" />A innchungkhar umkalning kha ṭha tein a zoh i an herh an baunak kha ṭha tein a hmuh.
  </para>
  <para style="p">
    <verse number="28" style="v" />A fale nih khan, thluachuak nu, an ti i a va zong nih khan a ti ve i a thangṭhat i,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Nupi ṭha tampi an um, sihmanhsehlaw nangmah nih na lonh dih hna,” a ti.
  </para>
  <para style="p">
    <verse number="30" style="v" />Iang hi hlen a hmang, dawh hi a ziam kho, Sihmanhsehlaw Bawipa a ṭihmi nu cu thangṭhat awk a si.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah cu a kut theitlai ruangah khan thangṭhat u, Hauka ah khan amah cu a rianṭuannak nih khan upatnak hmuhter seh.
  </para>
</usx>
