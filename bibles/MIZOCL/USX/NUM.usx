<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Numbers</book>
  <para style="h">Numbers</para>
  <para style="toc1">Numbers</para>
  <para style="toc2">Numbers</para>
  <para style="mt">Numbers</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel-ten Aigupta ram an chhuahsan aṭanga kum hnihna, thla hnihna, ni khat niin thlalêra Inbiakna bûkah chuan Lalpan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona nên Israel mipui hi a chi leh a chhûngkuaa thliarin mipa zawng zawng chhiar ula.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mipa, râlkai chin, kum sawmhnih chung lam chu upat dân indawtin an hming ziak vek rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hnam tina chhûngkaw hotu pakhat zêlin an pui tûr che u a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hêng mite hi a puitu tûr che u chu an ni: “Reuben hnama mi Sedeura fapa Elizura te,
  </para>
  <para style="p">
    <verse number="6" style="v" />Simeona hnama mi Zurisadaia fapa Selumiela te,
  </para>
  <para style="p">
    <verse number="7" style="v" />Juda hnama mi Aminadaba fapa Nasona te,
  </para>
  <para style="p">
    <verse number="8" style="v" />Isakara hnama mi Zuara fapa Nathanela te,
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulun hnama mi Helona fapa Eliaba te,
  </para>
  <para style="p">
    <verse number="10" style="v" />Josefa thlah Efraim hnama mi Amihuda fapa Elisama te, Manasea hnama mi Pedazura fapa Gamaliela te,
  </para>
  <para style="p">
    <verse number="11" style="v" />Benjamin hnama mi Gideonia fapa Abidana te,
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan hnama mi Amisadaia fapa Ahiezera te,
  </para>
  <para style="p">
    <verse number="13" style="v" />Aser hnama mi Okrana fapa Pagiela te,
  </para>
  <para style="p">
    <verse number="14" style="v" />Gad hnama mi Deuela fapa Eliasafa te,
  </para>
  <para style="p">
    <verse number="15" style="v" />Naftali hnama mi Enana fapa Ahira te hi.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Hêng mite hi mipui zîng aṭanga hotua thlan, hnam hruaitu, Israel chhûngkaw chunga rorêltute chu an ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mosia leh Arona chuan hming ziakte khi an hruai a;
  </para>
  <para style="p">
    <verse number="18" style="v" />thla hnihna, ni khat ni chuan mipui an ko khâwm a, a chi leh a chhûngkuaa thliarin mipa kum sawmhnih a chin chung lam zawng zawng chu an upat dân indawtin an hming an rawn inziaktîr a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosia hnêna Lalpa thupêk angin Sinai thlalêrah chuan mite chu an chhiar ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jakoba fapa upa ber Reubena thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu an upat dân indawtin an hming an ziak a,
  </para>
  <para style="p">
    <verse number="21" style="v" />Reubena thlah chu mi sîngli leh sângruk leh zanga an ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simeona thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Simeona thlah chu mi sîngnga leh sângkua leh zathum an ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gada thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gada thlahte chu sîngli leh sângnga leh zaruk leh sawmnga an ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Juda thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Juda thlah chu mi sîngsarih leh sângli leh zaruk an ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isakara thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Isakara thlahte chu mi sîngnga leh sângli leh zali an ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebuluna thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zebulun thlahte chu sîngnga leh sângsarih leh zali an ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Josefa thlahte: Efraim thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a,
  </para>
  <para style="p">
    <verse number="33" style="v" />Efraim thlahte chu sîngli leh zanga an ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Josefa fa Manasea thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Manasea thlahte chu mi sîngthum leh sânghnih leh zahnih an ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Benjamina thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Benjamina thlahte chu mi sîngthum leh sângnga leh zali an ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dana thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dana thlahte chu mi sîngruk leh sânghnih leh zasarih an ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Asera thlahte chu a chi leh a chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Asera thlahte chu mi sîngli leh sângkhat leh zanga an ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Naftalia thlahte chu a chi leh chhûngkuaa thliarin mipa râlkai chin, kum sawmhnih chung lam chu a upat dân indawtin an hming an ziak a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Naftalia thlahte chu mi sîngnga leh sângthum leh zali an ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Israel hnam hruaitu sâwm leh pahnih, mahni hnam ṭheuh hotute nên, Mosia leh Arona chuan mipui hming chu an ziak chhuak a.
  </para>
  <para style="p">
    <verse number="45" style="v" />Israel mi zawng zawng, a chi leh a chhûngkuaa thliarin râlkai chin, mipa kum sawmhnih chung lam zawng chu an chhiar a.
  </para>
  <para style="p">
    <verse number="46" style="v" />An vai chuan mi nuairuk leh sângthum leh zanga leh sawmnga an ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />Levia thlahte erawh chu chhiar tûr an ni ve lo.
  </para>
  <para style="p">
    <verse number="48" style="v" />Lalpa chuan Mosia hnênah:
  </para>
  <para style="p">
    <verse number="49" style="v" />‘Levia, chi zawng chhiar ve suh, Israel mite khawchhiar bu-ah telh ve tûr an ni lo.
  </para>
  <para style="p">
    <verse number="50" style="v" />Levia thlahte chu Biakbûk chhûngah Thuthlung Bâwm te, bûk cheina leh a chhûnga thil awm zawng zawng enkawltuah hmang ang che. Inbiakna bûk leh a bungrua zawng zawng chu an zâwn ṭhîn ang a, an enkawl ang. Inbiakna bûk vêlah an awm ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="51" style="v" />Inbiakna bûk chu in sawn dâwn apiangin Levia chite hian an ṭhiat ang a, in zâr leh dâwn pawhin Levia chite hian an zâr ṭhîn tûr a ni; mi dang lo inrawlh ve tum chu tihhlum tûr an ni.
  </para>
  <para style="p">
    <verse number="52" style="v" />Israel mite chuan mahni hnam puanzâr zârna bul ṭheuhvah bûk an rem ang a,
  </para>
  <para style="p">
    <verse number="53" style="v" />Levia chite erawh chuan Inbiakna bûk vêlah bûk an rem tûr a ni. Inbiakna bûk chu an vêng ang a, chutilo zawng miin an rawn hnaih ang a, Israel-te chungah thinurna a lo thleng dah ang e,’ a ti a.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chutiang chuan Israel-te chuan an ti a; Mosia hnêna Lalpa thupêk ang chuan an ti ta a.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia leh Arona hnênah chuan,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel mite chu a pâwl leh chhûngkaw chhinchhiahna puanzâr târin Inbiakna bûk hawia bûk rem tûrin a hrilh a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khawchhak lamah chuan Juda pâwl an awm ang: Juda thlahten an chhûngkaw puanzâr an târ ang a, a bulah an bûk an rem ang; an hruaitu chu Aminadaba fapa Nasona a ni,
  </para>
  <para style="p">
    <verse number="4" style="v" />mi sîngsarih leh sângli leh zaruk an tling.
  </para>
  <para style="p">
    <verse number="5" style="v" />An dawta bûk rem tûr chu Isakar thlahte an ni; an hruaitu chu Zuara fapa Nathanela a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi sîngnga leh sângli leh zali an tling.
  </para>
  <para style="p">
    <verse number="7" style="v" />Anni dawt leha bûk rem tûr chu Zebulun thlahte an ni, an hruaitu chu Helona fapa Eliaba a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi sîngnga leh sângsarih leh zali an tling.
  </para>
  <para style="p">
    <verse number="9" style="v" />Anni pâwl hi Juda pâwla chhiar an ni, mi nuaikhat leh sîngriat leh sângruk leh zali an tling. Anniho hi kal hmasa zêl tûr an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chhim lamah chuan Reubena pâwlho an awm ang. Reubena thlahte chuan an chhûngkua leh an pâwl puanzâr zârnaah bûk an rem ang, an hotu chu Sedeura fapa Elizura a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi sîngli leh sângruk leh zanga an tling.
  </para>
  <para style="p">
    <verse number="12" style="v" />An dawta bûk rem tûr chu Simeona thlahte an ni, an hotu chu Zurisadaia fapa Selumiela a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi sîngnga leh sângkua leh zathum an tling.
  </para>
  <para style="p">
    <verse number="14" style="v" />An dawta bûk rem tûrte chu Gada thlahte an ni, an hotu chu Reuela fapa Eliasafa a ni;
  </para>
  <para style="p">
    <verse number="15" style="v" />mi sîngli leh sângnga zaruk leh sawmnga an tling.
  </para>
  <para style="p">
    <verse number="16" style="v" />Anniho hi Reubena pâwla chhiar an ni; mi nuaikhat leh sîngnga leh sâng khat leh zali leh sawmnga an ni. Anni hi Juda pâwl dawta kal ṭhîn tûr an ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Inbiakna bûk chu zâwn a hunah Levia chite chu a laiah an kal ang a, an awmna zir zêlin pâwl dangte chu an kal ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khawthlang lam pangah Efraim pâwlho an awm ang a, an pâwl chhinchhiahna puanzâr an zâr ang a, a bulah Efraim-ho chuan bûk an rem ang; an hruaitu chu Amihuda fapa Elisama a ni,
  </para>
  <para style="p">
    <verse number="19" style="v" />mi sîngli leh zanga an tling.
  </para>
  <para style="p">
    <verse number="20" style="v" />An dawta bûk rem tûrte chu Manasea thlahte an ni, an hruaitu chu Pedazura fapa Gamaliela a ni;
  </para>
  <para style="p">
    <verse number="21" style="v" />mi sîngthum leh sânghnih leh zahnih an tling.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anni dawta bûk rem tûr chu Benjamina thlahte an ni, an hruaitu chu Gideona fapa Abidana a ni;
  </para>
  <para style="p">
    <verse number="23" style="v" />sîngthum leh sângnga leh zali an tling.
  </para>
  <para style="p">
    <verse number="24" style="v" />Anniho hi Efraim pâwla chhiar an ni, mi nuaikhat leh sângriat leh za an ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hmâr lam pangah Dan pâwlho an awm ang. An pâwl chhinchhiahna puanzâr an zâr ang a, a bulah Dan-ho chuan bûk an rem ang. An hotu chu Amisadaia fapa Ahiezera a ni;
  </para>
  <para style="p">
    <verse number="26" style="v" />mi sîngruk leh sânghnih leh zasarih an tling.
  </para>
  <para style="p">
    <verse number="27" style="v" />An dawta bûk rem tûr chu Asera thlahte an ni, an hruaitu chu Okrana fapa Pagiela a ni;
  </para>
  <para style="p">
    <verse number="28" style="v" />mi sîngli leh sângkhat leh zanga an tling.
  </para>
  <para style="p">
    <verse number="29" style="v" />A dawt leha bûk rem tûr chu Naftalia thlahte an ni; an hruaitu chu Enana fapa Ahira a ni,
  </para>
  <para style="p">
    <verse number="30" style="v" />mi sîngnga leh sângthum leh zali an tling.
  </para>
  <para style="p">
    <verse number="31" style="v" />Anniho hi Dan pâwla chhiar an ni, mi nuaikhat leh sîngnga leh sângsarih leh zaruk an ni. Anni hi hnu dâla kal tûr an ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hêng hi Israel mi, a chhûngkuaa thliara hming an ziakte chu an ni, an zaa fin khâwmin mi nuairuk leh sângthum leh zanga leh sawmnga an tling.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosia hnêna Lalpa thupêk angin Levia thlahte chu Israel-te chhiarnaah an telh ve lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mosia hnêna Lalpa thupêk angin Israel-te chuan an ti a, a pâwl pâwlin bûk an rem a, chhûngkaw indawtin an kal ṭhîn.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sinai tlânga Lalpan Mosia a biak lai khân Arona leh Mosia thlahte chu hêng hi an ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Arona fapa upa ber chu Nadaba a ni, a dangte chu Abihua te, Eleazara te, Ithamara te an ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Puithiam atâna hriakthih, serh hran an ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nadaba leh Abihua erawh hi chu Sinai thlalêra mei thiang lo hmanga rimtui an hâl avângin, Lalpa hmaah an thi a, fa an nei lo; Eleazara leh Ithamara chauh chu an pa Arona dam laia puithiam hna thawk chu an ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Levia chite chu han hruai la, puithiam Arona rawngbâwlsaktuah dah rawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Inbiakna bûka hna thawh tûr awm apiang an thawk ang a, puithiam leh mipuite rawng an bâwl tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Inbiakna bûk chhûnga thil awm zawng zawng an enkawl ang a, Inbiakna bûka Israel mite an lo kalin an lo dawngsawng tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Levia chite chauh hi Arona leh a fate chhawr atân Israel hnam zînga mi ka pêkte chu an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Arona leh a fate chauh hian puithiam hna an thawk ang a, mi dang lo inrawlh ve chu tihhlum tûr an ni,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Israel-te thlah, an fa tîr, piang hmasa, ka ta tûrte aiah Levia chite hi ka la ta a ni, anni chu ka ta, ka pual an ni ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aigupta mite fa tîr ka thah ni aṭang khân fa hrin hmasa berte hi ka ta an ni; Israel-te chu an fa tîr, an ran piang hmasate nên ka zuah a, ka ta tûr vek an ni, Lalpa ka nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sinai thlalêrah Lalpan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Levia thlahte chu a chi leh a chhûngkuaa thliarin an hming ziak rawh; mipa chu thla khat a chin chung lam chu telh vek ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosia chuan Lalpa thupêk ang chuan a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Levia fapate chu Gersona te, Kohata te, Meraria te an ni, an hming hi an thlahte chuan hnam hmingah an pu a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gersona fate chu Libnia leh Simeia an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kohata fate chu Amrama te, Izara te, Hebrona te, Uzela te an ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Meraria fate chu Malia leh Musia an ni. Hêngho hming hi an thlahte chuan hnam hmingah an pu a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gersona chia chhiarte chu Libni chi leh Simei chite hi an ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mipa zawng zawng thla khat a chin chung lam chu sângsarih leh zanga an tling.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gersona chite chuan Inbiakna bûk khawthlang lamah bûk an rem tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />An hruaitu chu Laela fapa Eliasafa a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Inbiakna bûka Gersona chite tih tûr chu Inbiakna bûk enkawltu ber an ni a, a in chung te, a thuahna te, a pindan puanzâr te,
  </para>
  <para style="p">
    <verse number="26" style="v" />a tual hungna puanzâr te, a tual luhna puanzâr te an kutah a awm ang a, hêng thil chungchângah tih tûr awm apiang titu an ni ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kohata chia chhiarte chu Amram chi te, Izar chi te, Hebron chi te, Uziel chite hi an ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mipa zawng zawng, thla khat a chin chung lam chu sângriat leh zaruk an tling, Hmun Thianghlim enkawltu tûrte an ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kohata thlahte chu bûk chhim lamah an awm tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />An hruaitu chu Uziela fapa Elizafana a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />An enkawl tûr chu Thuthlung Bâwm te, dawhkân te, khâwnvâr dahna te leh Hmun Thianghlim Ber luhna puanzâr te a ni ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Puithiam Arona fapa, Eleazara chu Levia chite hotu a ni; Hmun Thianghlim enkawltute thu lâkna tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Merari chia chhiarte chu Mali chi te leh Musi chite hi an ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mipa zawng zawng, thla khat a chin chung lam chu mi sângruk leh zahnih an tling.
  </para>
  <para style="p">
    <verse number="35" style="v" />An hruaitu chu Abihaila fapa Zuriela a ni, Inbiakna bûk hmâr lamah bûk an rem tûr a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Meraria chite enkawl tûr chu Inbiakna bûk ban rem khâwm te, a kaihna hrui te a ni ang. Hêng thila tih tûr awm zawng zawng chu an tih tûr a ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />A hungna ban te, a bulṭhut te, a khen nghehna te, a kaihna hruite pawh an enkawl tûr a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Inbiakna bûk khawchhak lam, a kawtah Mosia te, Arona te leh an fate chuan bûk an rem tûr a ni. Anni chauh hi a ṭûl hun apianga Israel-te aiawha Hmun Thianghlima rawngbâwltu tûr an ni; mi dang lo tel ve chu tihhlum tûr a ni,’ a ti a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lalpa thupêk ang chuan Mosia leh Arona chuan Levia chite chu, an chhûngkuaa thliarin an chhiar a, mi sînghnih leh sânghnih an tling.
  </para>
  <para style="p">
    <verse number="40" style="v" />Lalpa chuan Mosia hnênah, “Israel thlah fa tîr zawng zawng, mipa thla khat a chin chung lam hming ziak chhuak rawh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Levia thlahte chu Israel-te fa tîr zawng zawng aiah ka ta an ni ang. Israel-te ran piang hmasa ber aiah Levia chite ran chu ka tân dah bawk rawh, Lalpa chu ka nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Lalpa thupêk angin Mosia chuan a ti a. Israel-te fa tîr zawng zawng chu a chhiar a,
  </para>
  <para style="p">
    <verse number="43" style="v" />a upat dân indawtin thla khat a chin chung lam mipa zawng zawng hming chu a ziak chhuak a, sînghnih leh sânghnih leh zahnih leh sawmsarih leh pathum an tling.
  </para>
  <para style="p">
    <verse number="44" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="45" style="v" />“Israel-te fa tîr zawng zawng aiah Levia chite chu ka ta an nih tâk thu puang rawh. Israel-te ran no piang hmasa ber aiah pawh Levia thlahte ran chu ka ta a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Israel-te fa tîrho hi Levia chite ai chuan mi zahnih leh sawmsarih leh pathumin an tam a, chûngho zât tlanna chu Israel-te chuan an pe tûr a ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mi pakhat tlanna man chu sekel nga a ni ang, sekel chu Tempula hman lai ang chiaha rit tûr a ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />Tangka chu Arona leh a fate pe ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mosia chuan intlanna tangka an lo lâk chuante chu a la khâwm a.
  </para>
  <para style="p">
    <verse number="50" style="v" />Israel zînga fa tîr aṭangin tangkarua biakbûk tehna anga sekel sângkhat leh zathum leh sawmruk leh panga a la khâwm a.
  </para>
  <para style="p">
    <verse number="51" style="v" />Lalpan thu a pêk angin Arona leh a fapate a pe a.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Levia chi zînga Kohata thlahte a chi leh chhûngkuaa thliarin,
  </para>
  <para style="p">
    <verse number="3" style="v" />kum sawmthum aṭanga kum sawmnga inkâr, Inbiakna bûka hna thawk tlâk zawng zawng hming ziak chhuak rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Inbiakna bûka Kohata thlahte thawh tûr chu thil thianghlim berte enkawl a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Awmhmun sawn dâwn apiangin Arona leh a fate chu bûk chhûngah an lût ang a, Hmun Thianghlim Ber pindan puanzâr chu an hlîp ang a, chu chuan Thuthlung Bâwm kha an khuh tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Savun ṭha chiin an khuh leh ang a, chu chu puan dumpâwlin an khuh leh tûr a ni; chumi zawhah a zâwnfung an vuah ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chhang serh dahna dawhkân chungah puan dumpâwl an phah ang a, chutah chuan thlêng te, bêl te, berhbu te, uain thâwl leh a bun chhuahna tûr note chu an dah ang a; chatlak lova chhang serh dah ṭhin chu chutah chuan an dah tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Puan sendukin an khuh ang a, savun ṭha chiin an khuh leh ang a, a zâwnfung an vuah ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />khâwnvâr zâr kha a bâwrin chaicheh te, dawnthlêng te, hriak bûr zawng zawng nên puan dumpâwlin an khuh tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />A hmanrua zawng zawng nên savun ṭha chiin an khuh ang a, a zâwnnaah an dah tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Rangkachaka luan maichâm chu puan dumpâwlin an khuh ang a, savun ṭha chiin an khuh leh ang a, a zâwnfung an vuah tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmun Thianghlima rawngbâwlna bungbêl zawng zawng chu puan dumpâwlin an fûn ang a, a zâwnnaah an dah tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maichâma meivâp chu an lâwk fai ang a, puan sendukin an khuh ang a;
  </para>
  <para style="p">
    <verse number="14" style="v" />a chungah chuan an rawngbâwlna bungbêl zawng zawng, meilawh te, thîrkut te, vutlawh te, chawhtawlh te leh maichâm bungbêlte an dah vek ang a, savun ṭha chiin an khuh ang a, a zâwnfung an vuah tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Awmhmun sawn hunah Arona leh a faten hêng hmanrua leh bungbêl thianghlimte hi an khuh fel hunah Kohata fate chuan an zâwn tûr a ni; mahse, thil thianghlimte hi an khawih tûr a ni lo, an thi ang e. Chu chu Inbiakna bûka Kohata fate thawh tûr chu a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chhit tûr hriak te, rimtui te, buhbâl thilhlan te, hriak thih mi te, Inbiakna bûk pum leh a chhûnga thil awm zawng zawng, Lalpa tâna serh hrante chu Eleazara kutah a awm ang.”
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kohata thlahte chu,
  </para>
  <para style="p">
    <verse number="19" style="v" />thil thianghlimte hi an khawih palha Levia chite zîng ata an thih fai mai loh nân, Arona leh a fate chuan an tih tûr leh an zâwn tûr ṭheuh an kawhhmuh ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Puithiamin thil thianghlim zâwn tûra an buatsaih lai en tûrin Kohata thlahte chu Inbiakna bûk chhûngah an lût tûr a ni lo, an thi mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Gersona thlahte pawh, a chi leh a chhûngkuaa thliarin
  </para>
  <para style="p">
    <verse number="23" style="v" />kum sawmthum aṭanga kum sawmnga inkâr mi, Inbiakna bûka rawngbâwl tlâk zawng zawng hming ziak vek rawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gersona thlahte chuan hêng hi an enkawl ang a, an zâwn ṭhîn ang:
  </para>
  <para style="p">
    <verse number="25" style="v" />Inbiakna bûk puanzâr te, a chung khuhna te, a thuahna te, a khuhna savun ṭha chi te, kawngka puanzâr te,
  </para>
  <para style="p">
    <verse number="26" style="v" />bûk leh maichâm tual hungna puanzâr te, bûk luhna kawngka puanzâr te, a hrui te leh a hmanrua zawng zawng an zâwn ang a; tih ṭûl apiang an ti tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Arona leh a faten tih tûra an ruatsak apiang chu Gersona thlahte chuan an ti ang a, zâwn tûr chu an zâwn ang a, in enpui ṭhîn dâwn nia.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hêng hi Inbiakna bûk chungchânga Gersona thlahte tih tûr pual chu a ni; an tih tûr ṭheuh chu puithiam Arona fapa Ithamaran a kawhhmuh ṭhîn ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Meraria thlahte chu a chi leh a chhûngkuaa thliarin
  </para>
  <para style="p">
    <verse number="30" style="v" />kum sawmthum aṭanga kum sawmnga inkâr mi, Inbiakna bûka rawngbâwl tlâk zawng zawng hming ziak chhuak vek rawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Inbiakna bûk chungchânga an tih tûr pual leh an thil phurh tûr te chu hêng hi a ni: Bûk hmanrua, a bangrel te, a ban leh a bulṭhut te,
  </para>
  <para style="p">
    <verse number="32" style="v" />tual hungna ban te leh a bulṭhut te, bûk kilh behna te, a kaihna hrui te leh a hmanrua zawng zawng te a ni; mi tin phurh tûr hming hmerha ruatsak ṭheuh tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chûng chu Meraria thlahte tih tûr chu a ni, puithiam Arona fapa Ithamaran an tih tûr chu a kawhhmuh ṭhîn ang,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mosia te, Arona te leh mipui hruaitu te chuan Kohata thlahte chu a chi leh a chhûngkuaa thliarin,
  </para>
  <para style="p">
    <verse number="35" style="v" />Inbiakna bûka rawngbâwl tlâk, kum sawmthum aṭanga kum sawmnga inkâr mi zawng zawng hming chu an ziak chhuak a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hêng an hming ziakte hi mi sânghnih leh zasarih leh sawmnga an tling.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mosia hnêna Lalpa thupêk zâwmin Mosia leh Aronan Kohata thlahte, Inbiakna bûka rawngbâwl tlâk an ziak zât chu heti hi a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Gersona thlahte chu a chi leh a chhûngkuaa thliarin,
  </para>
  <para style="p">
    <verse number="39" style="v" />Inbiakna bûka rawngbâwl tlâk kum sawmthum aṭanga kum sawmnga inkâr mi zawng zawng hming chu an ziak chhuak a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hming ziak hi mi sânghnih leh zaruk leh sawmthum an tling.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lalpa thupêk zâwma Mosia leh Aronan Gersona thlahte, Inbiakna bûka rawngbâwl tlâk an ziak zât chu heti hi a ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Meraria thlahte chu a chi leh a chhûngkuaa thliarin,
  </para>
  <para style="p">
    <verse number="43" style="v" />Inbiakna bûka rawngbâwl tlâk, kum sawmthum aṭanga kum sawmnga inkâr mi zawng zawng hming an ziak chhuak a.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hming ziak zawng chu mi sângthum leh zahnih an tling.
  </para>
  <para style="p">
    <verse number="45" style="v" />Mosia hnêna Lalpa thupêk awiha Mosia leh Aronan Meraria thlahte an ziak zât chu heti hi a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Levia chite chu a chi leh a chhûngkuaa thliarin Mosia leh Arona leh Israel hruaitute chuan,
  </para>
  <para style="p">
    <verse number="47" style="v" />kum sawmthum aṭanga kum sawmnga inkâr, Inbiakna bûka rawngbâwl tlâk, thil phur thei te
  </para>
  <para style="p">
    <verse number="48" style="v" />hming chu an ziak chhuak a, mi sângriat leh zanga leh sawmriat an tling.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mosia hnêna Lalpa thupêk angin Mosia chuan mi tin an thawh tûr leh phurh tûr ṭheuh a ruatsak a, an hming pawh a chhinchhiah vek a.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel-te chu hrilh rawh: vuna phâr natna vei te, thipût lai te, mitthi ruang khawih vânga bawlhhlawhte chu riahhmun ata an hnawt chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chutianga bawlhhlawhna nei chu hnawt chhuak vek rawh u; riahhmunah kei pawh ka awm ve si a, an tibawrhbâng ang e”, a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel mite chuan Mosia hnêna Lalpa thu sawi chu an awih a, daipâwnah an hnawt chhuak ta vek a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Israel-te chu hrilh rawh: Lalpa thu bawhchhiain tu pawhin mi chungah thil sual ti sela, thupha a chawi tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thil sual tih man chu kim takin a rûl ang a, tihsualna pa chu hmun ngaa ṭhena hmun khat a pêk belh tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pêk tûra chu thi sela, laichîn hnai a neih bawk si loh chuan a rulhna tûr sum chu puithiam chanpual atân Lalpa hnêna pêk tûr a ni. Hei hi sual thawina thilhlana berâmchal bâka pêk tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel miten chutiang thilpêk chu an rawn hlan chuan a dawngtu puithiam chuan a nei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Puithiamte chuan thilhlan an lo dawn rêng rêng an nei zêl tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Israel-te chu hetiang hian thu hrilh rawh: Tu nupui pawh rinawm lovin
  </para>
  <para style="p">
    <verse number="13" style="v" />mi dangin mutpuiin uire sela, a pasal chuan a hriat chiah lohva, chesual ngei si, inpuang si lo, kut man ni bawk si lo chu,
  </para>
  <para style="p">
    <verse number="14" style="v" />a pasalin a rinhlelha, a thîka, a nupui chu a chesual emaw, sual lo emaw a rinhlelh tlat si chuan,
  </para>
  <para style="p">
    <verse number="15" style="v" />a nupui chu puithiam hnênah a hruai ang a, barli chhangphut kg. khat thilhlan tûra tuk zât chu, hriak telh loh, rimtui hâl tûr pawh tel lovin a rawn keng bawk tûr a ni; chu chu nupui rinhlelhawmte fiah nân thilhlan, an pasalten an rawn ken ṭhin tûr chu a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Puithiam chuan hmeichhia chu a hruai ang a, Lalpa hmaah a dintîr ang a,
  </para>
  <para style="p">
    <verse number="17" style="v" />hlumbêlin tui thianghlim a la ang a, Biakbûk chhuata vaivut chu a sâwk ang a, tuiah chuan a phul tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmeichhia chu Lalpa hmaah chuan a dintîr ang a, a sam thlahin thîkthu avânga fiahna tûr chhangphut thilhlan ṭhenkhat chu a hûmtîr tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Puithiam chuan hmeichhia chu chhia a chhamtîr tûr a ni. ‘Tu man an mutpui loh chea, i pasal laka thil bawlhhlawh i tih loh chuan ânchhe thlentu tui chhe lak ata hi i fihlîm ang;
  </para>
  <para style="p">
    <verse number="20" style="v" />amaherawhchu, i pasal laka khaw dang i hawia, i pasal ni lo mipain an mutpui chea, an tihbawrhbân che chuan i fihlîm lo vang,’ a ti ang a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Puithiam chuan hmeichhia chu a vau ang a, chhia a chhamtîr ang a, a hnênah, ‘ Lalpa chuan i chipuite ânchhe dawngah siam che rawh se;
  </para>
  <para style="p">
    <verse number="22" style="v" />ânchhe tuichhia i in tûr hian, i pum tipuar sela, i malpui inkâr tisâwng rawh se,’ a ti ang a, hmeichhia chuan, ‘Amen, Amen,’ a lo ti ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Puithiam chuan ânchhe dawn tûr a chhamte chu lehkhaah a ziak ang a, tui chhiaah chuan a tleuh fai tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />A pum tina mai thei tui chhia chu a intîr hmain,
  </para>
  <para style="p">
    <verse number="25" style="v" />thîkthu avânga fiahna tûr thilhlan chhangphut a hûmtîr kha puithiam chuan a lâksak ang a, Lalpa hmaah a thên ang a, maichâmah a rawn dah tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chhangphut thilhlan kha a vaia hlan vek a nih entîr nân a thên a thên ang a, maichâmah a hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chumi zawhah chuan hmeichhia chu tui chhia kha a intîr tawh ang, a bawrhbâna a lo uire ngei a nih chuan tui chhia a in veleh a pum a na ang a, a dul a puar ang a, a mal inkâr a sâwng ang; mi ânchhedawngtu a ni ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hmeichhia chu a bawrhbân lohva, a thianghlim chuan eng mah a ti lo vang: nau a pai leh mai tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hetiang hi nupui, pasalte laka khaw dang hawi intibawrhbângte chungthu rêl dân tûr chu a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />A pasalin mi dang laka a nupui chu a thîk miau si chuan puithiamin hmeichhia chu Lalpa hmaah a dintîr ang a, hêng thil hi a lo ti ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />A pasal chuan thiam lohna a nei lo vang a, a hmeichhia chuan thiam lohna a neih chuan a tuar tûr a ni,” a ti a.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel-te chu heti hian hrilh rawh: Mipain emaw, hmeichhiain emaw Nazarit-ho thutiam anga Lalpa hnênah a inhlan chhûng chuan,
  </para>
  <para style="p">
    <verse number="3" style="v" />uain leh zu a nghei tûr a ni; uain thûr leh zu thûrte pawh a in tûr a ni lo, grep rah sâwr tui pawh a in tûr a ni lo, a rah pawh, a tharlâm emaw, pho ro emaw pawh a ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nazarit thutiama a inphuar chhûng chu grep aṭanga siam eng mah, a sâwr fu pawh a ei tûr a ni lo va.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nazarit thutiama a inphuar chhûng chu a lu pawh ziah kâwn tûr a ni hek lo; Lalpa tâna a inhlan chhûng chuan serh hran a ni a, a samte pawh a ṭhan ṭhanin a ṭhang mai tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa tâna a inhlan chhûng hian mitthi ruang a khawih tûr a ni lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />A nu leh pa ruang pawh, a unaupa leh a farnu ruang pawh khawihin a intibawlhhlawh tûr a ni lo, a inserh hran lai a ni si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nazarit mi a nih chhûng chu Lalpa tâna serh hran a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />A bula mi thi thut sela, a ruangin a sam chu khawih palhin tibawlhhlawh sela, ni sarih a nghâk ang a, a sam chu a ziat kawlh vek tûr a ni; tichuan, a thianghlim leh thei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />A ni riat ni chuan ṭhuro pahnih emaw, pârva no pahnih emaw Inbiakna bûkah puithiam hnênah a rawn keng ang a,
  </para>
  <para style="p">
    <verse number="11" style="v" />ani chuan sual thawi nân pakhat chu a lo hlansak ang a, pakhat chu hâlral thilhlanah a hâl ang a, mitthi ruangin a khawih avânga amah thenna chu a tihsak ang a, chumi ni vek chuan a sam chu a serh thar leh tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nazarit mi atân Lalpa hnênah a inhlân thar leh ang a, kum khat vêla upa berâmno, a pa, bawhchhiat man thilhlanah a hlân ang. A inserhhranna kha tihbawlhhlawh a nih avângin tûn hmaa Nazarit mi a nih chhûng kha a thlâwn mai a ni ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Nazarit miin a hun a tlâk hnuin hetiang hian thil a ti tûr a ni: Inbiakna bûkah a lo kal ang a,
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa hnêna thilhlan atân hêngte hi a rawn keng tûr a ni: hâlral thilhlan atân berâmno, a pa, kum khat vêla upa, hmêlhem lo; sual thawina thilhlan atân berâmno, a nu, kum khat vêla upa, hmêlhem lo; remna thilhlan atân berâmchal hmêlhem lo;
  </para>
  <para style="p">
    <verse number="15" style="v" />buhbâl thilhlan atân kho chhûngah dawidim telh loh, chhangphut ṭha chia siam, hriak nêna hmeh, chhang tlang te, hriaka tâl chhang pan te, in tûr thilhlan atân uain te hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Puithiam chuan Lalpa hmaah a rawn keng ang a, sual thawina te, hâlral thilhlan te chu a hlân ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Berâmchal chu remna thilhlanah a hlân ang a, a rual chuan buhbâl thilhlanah dawidim telh loh chhang kho khat chu in tûr thilhlan uain nên chuan a hlân bawk ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tin, Nazarit mi chuan a sam serh chu Inbiakna bûk kawngka bulah chuan a ziat fai ang a, remna thilhlan hâlnaah chuan a rawh tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Puithiam chuan berâmchal dâr chhum hmin leh khova dah dawidim telh loh chhang tlang pakhat leh chhang pan pakhat chu a la ang a, Nazarit mi hnênah chuan, a lu a meh fai hnuah, a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chu chu puithiam chuan thên thilhlanah a thên ang a, puithiam tâna serh hran a ni ang, a bawp leh a irno, puithiam chan tûra serh hran ṭhinte nên. Chumi zawh chuan Nazarit mi khân uain a in thei tawh ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hei hi Nazarit mi tih tûr chu a ni; mahse, chu mi chuan tih tûr tuk bâk thilhlan pêk a lo tiam chuan, a tiam ang chu a ti ngei tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa chuan Mosia hnênah:
  </para>
  <para style="p">
    <verse number="23" style="v" />“Arona leh a fate chu hrilh rawh, hetiang hian mipui tân malsâwmna an dîl tûr a ni:
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa chuan malsâwm che uin vêng che u rawh se,
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpa hmêl chu in chungah êng sela, khawngaih che u rawh se.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa chuan in lam lo hawi sela, thlamuanna pe che u rawh se.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutiang chuan Israel mite chungah ka hming in chham ang a, keiin mal ka sâwm ang,” a ti a.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosian Biakbûk a din zawh chuan, Biakbûk leh a bungrua zawng zawng chu maichâm leh a bungbêl zawng zawng nên hriak a hnawih a, a thian thianghlim a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel hnam hruaitu, hotua an neih, chhiarpui titute kha, an lo kal a, thilhlan an rawn keng a.
  </para>
  <para style="p">
    <verse number="3" style="v" />An thilhlan chu bâwngtawlailîr chung nei paruk leh bâwngpa sâwm leh pahnih a ni, hruaitu pahnihin bâwngtawlailîr pakhat an thawh ṭâwm a, hruaitu tinin bâwngpa pakhat ṭheuh an tum a ni; Biakbûk kawtah chuan an rawn kai a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Inbiakna bûk rawngbâwlna atân a ṭangkai ang, lo dawnsak la, an hna tam dân athuin Levia chite hnênah sem ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia chuan tawlailîrte leh bâwngpate chu a lo dawng a, Levia chite chu a sem a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tawlailîr pahnih leh bâwng pali chu Gersona thlahte hnênah, an hna azirin a pe a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tawlailîr pali leh bâwng pariat chu Meraria thlahte hnênah, an hna azirin a pe a; puithiam Arona fapa Ithamara kutah hêng hi dah a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kohata thlahte erawh chuan chan an nei lo; thil thianghlimte chu anmahni ko ngeia zâwn tûra tih an nih avâng khân.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hruaitute chuan maichâm serh thianghlim lawm nân thilhlan tûr an rawn la a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa chuan Mosia hnênah, “Hruaitu pakhat zêl hian, a ni indawtin maichâm serh hran lawm nân an thilpêkte chu rawn dah thliah thliah rawh se,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ni hmasa berah chuan Juda thlah hruaitu Aminadaba fapa Nasona chuan a thilpêkte chu a rawn dah a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tangkaraw thlêng, kg. khat leh a chanvea rit leh tangkaraw chawhtawlh gram zariata rit, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="14" style="v" />rangkachak berhbu gram za leh sâwm bûk, rimtui hâl tûra khat nên - hêng hi Tempula bûkna hman laia bûk vek a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno pakhat;
  </para>
  <para style="p">
    <verse number="16" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="17" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Aminadaba fapa Nasona thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ni hnih ni chuan Isakara thlah hruaitu, Zuara fapa Nethanelan a thilpêk chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="19" style="v" />hêng hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="20" style="v" />rangkachak berhbu gram za leh sâwm bûk rimtui hâl tûra khat, hêng hi Tempula hman lai bûknaa bûk vek a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat,
  </para>
  <para style="p">
    <verse number="22" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="23" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Nathanela, Zuara fapa thilpêkte chu a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni thum ni chuan Zebulun thlah hruaitu Helona fapa Eliaba chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="25" style="v" />hêng hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="26" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk; hêng hi Tempula hman lai bûknaa bûk vek a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="28" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="29" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga hêngte hi Helona fapa Eliaba thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ni li ni chuan Reubena thlah hruaitu Sedeura fapa Elizura chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="31" style="v" />hêng hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="32" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk; hêng hi Tempula hman lai bûknaa bûk vek a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hâlral thilhlan atân bâwngtuai pakhat berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="34" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="35" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêng hi Sedeura fapa Elizura thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni nga ni chuan Simeona thlah hruaitu Zurisadaia fapa Selumiela chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="37" style="v" />hêng hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh, gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="38" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêng hi Tempula hman lai bûknaa bûk vek a ni;
  </para>
  <para style="p">
    <verse number="39" style="v" />hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="40" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="41" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Zerusadaia fapa Elizura thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ni ruk ni chuan Gada thlah hruaitu Deuela fapa Eliasafa chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="43" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="44" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêngte hi Tempula hman lai bûknaa bûk vek a ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="46" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="47" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Deuela fapa Eliasafa thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ni sarih ni chuan Efraima thlah hruaitu Amihuda fapa Elisama chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="49" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="50" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêngte hi Tempula hman lai bûknaa bûk vek a ni.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno, a pa pakhat,
  </para>
  <para style="p">
    <verse number="52" style="v" />sual thawina thilhlan atân kêl pakhat,
  </para>
  <para style="p">
    <verse number="53" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Amihuda fapa Elisama thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ni riat ni chuan Manasea thlah hruaitu Pedazura fapa Gamaliela chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="55" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="56" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêng hi Tempula bûkna hman laia bûk vek a ni;
  </para>
  <para style="p">
    <verse number="57" style="v" />hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat,
  </para>
  <para style="p">
    <verse number="58" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="59" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Pedazura fapa Gamaliela thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="60" style="v" />Ni kua ni chuan Benjamina thlah hruaitu Gideona fapa Abidana chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="61" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="62" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêng hi Tempula bûkna hman laia bûk vek a ni.
  </para>
  <para style="p">
    <verse number="63" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="64" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="65" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Gideona fapa Abidana thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="66" style="v" />Ni sâwm ni chuan Gada thlah hruaitu Amisadaia fapa Ahiezera chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="67" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng, kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="68" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêngte hi Tempula hman lai bûknaa bûk vek a ni.
  </para>
  <para style="p">
    <verse number="69" style="v" />Hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat,
  </para>
  <para style="p">
    <verse number="70" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="71" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Amisadaia fapa Ahiezera thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="72" style="v" />Ni sâwm leh ni khat ni chuan Asera thlah hruaitu Okrana fapa Pagiela chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="73" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="74" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêngte hi Tempula bûkna hman laia bûk vek a ni;
  </para>
  <para style="p">
    <verse number="75" style="v" />hâlral thilhlan atân bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="76" style="v" />sual thawina thilhlan atân kêl pakhat;
  </para>
  <para style="p">
    <verse number="77" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Okrana fapa Pagiela thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="78" style="v" />Ni sâwm leh pahnih ni chuan Naftalia thlah hruaitu Enana fapa Ahira chuan a thilpêkte chu a rawn keng a;
  </para>
  <para style="p">
    <verse number="79" style="v" />hêngte hi a thilpêkte chu a ni: tangkaraw thlêng kg. khat leh a chanve bûk, tangkaraw chawhtawlh gram zariat bûk, buhbâl thilhlan tûr chhangphut ṭha chi hriaka hmeh, a vûm thâr ve ve;
  </para>
  <para style="p">
    <verse number="80" style="v" />rimtui hâl tûra khat rangkachak berhbu gram za leh sâwm bûk - hêngte hi Tempula bûkna hman laia bûk vek a ni;
  </para>
  <para style="p">
    <verse number="81" style="v" />hâlral thilhlan tûr bâwngtuai pakhat, berâmchal pakhat, kum khat vêla upa berâmno a pa pakhat;
  </para>
  <para style="p">
    <verse number="82" style="v" />sual thawina thilhlan tûr kêl pakhat;
  </para>
  <para style="p">
    <verse number="83" style="v" />remna thilhlan atân bâwngtuai pahnih, berâmchal panga, kêl panga leh berâmno a pa kum khat mi vêl panga - hêngte hi Enana fapa Ahira thilpêk rawn kente chu a ni.
  </para>
  <para style="p">
    <verse number="84" style="v" />Hriak hnawiha maichâm hlan ni chuan a lawm nân hruaitute chuan hêng thilpêk hi an rawn keng a ni: a vaiin tangkaraw thlêng sâwm leh pahnih, tangkaraw chawhtawlh sâwm leh pahnih, rangkachak berhbu sâwm leh pahnih;
  </para>
  <para style="p">
    <verse number="85" style="v" />thlêng hi kg. khat leh a chanve zêl bûk a ni; chawhtawlh hi gram zariat zêla rit a ni; Tempula hman lai bûknaa bûkin tangkarua hi kg. sawmhnih leh pasarih leh gram zaruk a tling a ni.
  </para>
  <para style="p">
    <verse number="86" style="v" />Rimtui hâl tûra khat rangkachak berhbu sâwm leh pahnih, gram za leh sâwm bûk zêl, a vaiin Tempula hman lai bûknaa bûkin kg. khat leh gram za leh sawmhnih a ni.
  </para>
  <para style="p">
    <verse number="87" style="v" />Hâlral thilhlana hlan tûr bâwngtuai sâwm leh pahnih, berâmchal sâwm leh pahnih, kum khat vêla upa berâmno a pa sâwm leh pahnih leh chûng ruala telh tûr tuk zât buhbâl thilhlan chhangphut ṭha chi nên; sual thawina thilhlan atân kêl sâwm leh pahnih;
  </para>
  <para style="p">
    <verse number="88" style="v" />remna thilhlan atân bâwngtuai sawmhnih leh pali, berâmchal sawmruk; kêl sawmruk, kum khat vêla upa berâmno a pa sawmruk. Hêng hi hruaituten hriak hnawiha maichâm hlan nia an thilpêkte chu a ni.
  </para>
  <para style="p">
    <verse number="89" style="v" />Mosia chu Lalpa be tûrin Inbiakna bûkah chuan a lût a. Thuthlung Bâwm chhîn, cherub pahnih aṭang chuan Lalpa ṭawng chu a hria a.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona chu hrilh rawh, khâwnvâr a hâlin a khâwnvâr pasarih chuan a hma lam a ên tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Arona chuan chutiang chuan a ti a, Mosia hnêna Lalpa thupêk ang chuan hma lam ên tûr chuan khâwnvârte chu a chhi a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khâwnvâr dahna chu a bul vâwng leh a zâr, pangpâr lema chei te nên chuan, rangkachaka chher a ni; siam dân tûr Mosia hnêna Lalpa sawi ang chiaha chher a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Israel mite zîng aṭangin Levia chite hi tihrang la, thian thianghlim rawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hetiang hian thian ang che: tlenfaina tui theh la, an hmul zawng zawng ziat fai rawh se, an puan su sela, inbualtîr rawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bâwngtuai rawn la sela, a ruala hlan tel tûr buhbâl thilhlan atân chhangphut ṭha chi hriaka hmeh rawn la tel rawh se; sual thawina thilhlana hlan tûr bâwngtuai dang la bawk ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel-ho chu pung khâwm tûrin ko la, Levia chite chu Inbiakna bûk hmaah chuan dintîr ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel mite chuan Levia chite lu-ah chuan an kut an nghat ang a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa rawngbâwltu an nih theih nân Arona chuan Levia chite chu Israel-te zîng ata chu ka ta ni tûrin thên thilhlanah a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Levia chite chuan bâwngtuai lu-ah chuan an kut an nghat ang a, an sual thawina tûrin bâwngtuai pakhat chu sual thawina thilhlanah hlansak tûr a ni, pakhat chu hâlral thilhlana hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Levia chite chu Arona leh a fate kaihhruai tûrin Lalpa tân thên thilhlanah i hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel mite zîng aṭang chuan Levia chite chu i tihrang ang a, ka ta an lo ni tawh ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />I tihthianghlima i hlan hnu chuan Levia chite chu Inbiakna bûka rawngbâwl tlâk an ni tawh ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel-te fa tîr, chhûl keuho, ka neih tûrte aiah anni hi ka nei dâwn a ni, anni neitu chu keimah chauh hi ka ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aigupta mite fa tîr ka tihhlum lai khân Israel mite fapa upa berte leh an ran piang hmasa berte chu ka tân ka zuah a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tûnah Israel-te fa tîr aiah Levia chite hi ka nei dâwn a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Arona leh a fate puitu atân an hnêna Israel-te thilpêk an ni; Israel mite tân Hmun Thianghlimah rawng an bâwl ang a; Israel mite chungah thil ṭha lo a thlen loh nân Inbiakna bûka an kal tûr anni hian an lo vêng ṭhîn ang,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosia hnêna Lalpa thupêk ang chuan Mosia te, Arona te leh Israel pungkhâwmho chuan Levia chite chu an hlân a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Levia chite chu an intifai a, an puante an su a, Arona chuan Lalpa hnêna thên thilhlanah anni chu a hlân a. Sual thawina thilhlan pawh chu a tihsak a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Levia chite chungchânga Lalpa thupêk zawng zawng chu mite chuan an ti a. Tichuan, Levia chite chu Hmun Thianghlima Arona leh a fate hnuaia rawngbâwltu an ni ta a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Kum sawmhnih leh panga an tlinin Levia chite chu Inbiakna bûkah hna an thawk ṭheuh tûr a ni;
  </para>
  <para style="p">
    <verse number="25" style="v" />kum sawmnga an tlin chuan an châwl tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hemi hnu hi chuan an Levia chipui, Inbiakna bûka hna thawk an pui ve thei ang: anmahni pual chuan eng mah an ti tûr a ni tawh lo; Levia chite thawh dân tûr chu hetianga rel tûr a ni,” a ti a.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aigupta an chhuahsan hnu kum hnihna, thla khatnaah chuan Sinai thlalêrah Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel-te chuan Kalhlên kût a hun takah hmang rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tûn thla ni sâwm leh pali ni hian ni tlâk aṭangin tih dân tûr rêl diam tawh angin in hmang tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, Mosia chuan mipui chu Kalhlên kût hmang tûrin a hrilh a,
  </para>
  <para style="p">
    <verse number="5" style="v" />thla khatna, ni sâwm leh pali tlaiah, Sinai thlalêrah chuan an hmang ta a. Mosia hnêna Lalpa thupêk ang chiah zêl chuan mite chuan engkim an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi ṭhenkhat, mitthi ruang an khawih avânga bawlhhlawh an awm a, chûng mite chuan a ni tak chuan Kalhlên kût chu an hmang ve thei lo va.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosia leh Arona hnênah an lo kal a, “Mitthi ruang kan khawih a ṭûl avânga bawlhhlawh kan ni a; Israel mi dangte ang bawkin Lalpa hnênah thil kan hlân ve thei dâwn lâwm ni?” an rawn ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosia chuan, “ Lalpa thu ka dawn hma chu lo nghâk teh u,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel mite chu hrilh rawh. In zînga mi emaw, in thlahte emaw mitthi ruang an khawih avânga an bawlhhlawhin emaw, ram hla taka an zinin emaw, Kalhlên kût hman an duh ve si chuan,
  </para>
  <para style="p">
    <verse number="11" style="v" />thla khat hnuah, thla hnihna ni sâwm leh pali ni tlai lamah an hmang ve thei ang. Chhang dawidim telh loh leh lambak nên hmang ang che u.
  </para>
  <para style="p">
    <verse number="12" style="v" />A sa in ei bâng chu a tûk thlengin dah tûr a ni lo, a ruhte pawh pakhat mah titliak suh u; Kalhlên kût hman dân tûr tuk ang takin in hmang tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bawlhhlawh ni lo, ram hla taka zin pawh ni si lovin Kalhlên kût hi a hman duh loh chuan a mite zîng ata hnawh chhuah tûr a ni, a hun ruatah ka hnêna thilhlan a rawn hlan duh loh avângin a thil sual tih mawh chu a phur tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />“In zînga chêng hnam dangin Kalhlên kût hi a hman ve duh chuan a dân ang thlapin a hmang tûr a ni. Tu tân pawh, a khual a tualin, a hman dân tûr a thuhmun a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Biakbûk an din zawh ni chuan chhûmin a rawn khuh a, tlaiah chuan a tûk zîng thlengin mei anga êng a awm a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutiang chuan chhûmin a khuh a, zânah mei anga êng chu a awm ziah a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chhûm a kian apiangin Israel-te chuan awmhmun an sawn a, chhûmin a rawn khuhna hmunah chuan awmhmun an khuar leh ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpa thupêk ang zêlin bûk an sawn a, a thu vêkin bûk an khuar a. Chhûmin Biakbûk a khuh chhûng chu an awmna ngaiah an awm reng ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chhûm chuan rei tak chhûng Biakbûk chu a khuh pawhin Lalpa thu chu an awih a, an insawn lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />A châng chuan Biakbûk chu chhûmin ni rei lo tê chauh a khuh pawhin Lalpa thupêk angin an insawnin an insawn lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zan khat chauh, tlai aṭanga a tûk zîng thleng chauhva a awm châng a awm a, chhûm a kian veleh an insawn mai ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni hnih khat mai emaw, thla khat dâwn lai emaw, kum khat emaw, a aia rei emaw Biakbûk chunga chhûm a awm chhûng chu an insawn lo, a kian veleh an insawn ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosia hnêna Lalpa thupêk ang zêlin bûk an khuar a, awmhmun an insawn ṭhîn.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />‘Tangkaraw tawtawrâwt pahnih chher rawh; mipui koh khâwm nân leh kal chhuah a hunah in hâm dâwn nia.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ruala an ham chuan Israel-ho chu Inbiakna bûkah, i bulah an lo pung khâwm ang a,
  </para>
  <para style="p">
    <verse number="4" style="v" />pakhat chauh an ham erawh chuan hruaituho, sâng chunga hotute chauh khân an rawn pan tûr che a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rang taka an ham sek sek chuan khawchhak lama bûk neiho kha tawlh chhuak rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rang taka an ham nawn leh hunah chhim lama bûk neiho kha an tawlh chhuak tûr a ni. An ham sek sek chuan tawlh chhuah tûr tihna a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rei tak thlûka an ham chuan kal khâwm tûr tihna a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Arona leh a thlahte hi tawtawrâwt hâmtu tûrte chu an ni. Hetiang hi kumkhaw tih dân tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />“In ramah indona a awma, in hmêlma rawn beitute laka lo ṭang zâwk in nih chuan, tawtawrâwt chu hâm sek sek ula, kei Lalpa hian ka lo hria ang a, in hmêlmate lak ata ka rawn chhan ang che u.
  </para>
  <para style="p">
    <verse number="10" style="v" />In lâwmna nikhuaah, thla thar kûtahte leh hun serh in hman ṭuma hâlral thilhlan in hlantein hâm bawk ang che u, chu chu ka lo hria ang a, ka ngaihven ang che u, Lalpa , in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aigupta an chhuahsan kum hnihna, thla hnih, ni sawmhnih ni chuan Inbiakna bûk chunga Lalpa chhûm chu a kiang a,
  </para>
  <para style="p">
    <verse number="12" style="v" />Sinai aṭang chuan zawi zawiin an inchhawp sawn a; Paran thlalêr an thlen chuan chhûm chu a ding leh ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosia hnêna Lalpa thupêk angin a pâwl indawtin an chhuak a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Juda pâwla chhiarho chu an puanzâr nên an chhuak hmasa ber a, Juda thlahte chu Aminadaba fapa Nasonan a ho va.
  </para>
  <para style="p">
    <verse number="15" style="v" />Isakara thlahte chu Zuara fapa Nethanelan a ho va.
  </para>
  <para style="p">
    <verse number="16" style="v" />Zebuluna thlahte chu Helona fapa Eliaban a ho va.
  </para>
  <para style="p">
    <verse number="17" style="v" />Biakbûk chu an ṭhiat a, Gersona fate leh Meraria faten an zâwn a, an zui a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Reubena pâwla chhiarte pawh chu an puanzâr nên an chhuak a, Reubena thlahte chu Sedeura fapa Elizuran a ho va.
  </para>
  <para style="p">
    <verse number="19" style="v" />Simeona thlahte chu Zurisadaia fapa Selumielan a ho va.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gada thlahte chu Deuela fapa Elisafan a ho va.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kohata thlahte chuan bûk chhûnga thil thianghlimte an zâwn a, a dawtah an kal a, an bûk khuarna tûr hmun an va thlen ve chuan bûk chu an lo zâr zo tawh ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Efraim pâwlhova chhiarte chuan an puanzâr nên an zui a. Efraima thlahte chu Amihuda fapa Elisaman a ho va.
  </para>
  <para style="p">
    <verse number="23" style="v" />Manasea thlahte chu Pedazura fapa Gamalielan a ho va.
  </para>
  <para style="p">
    <verse number="24" style="v" />Benjamina thlahte chu Gideonia fapa Abidanan a ho va.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dana pâwla chhiarte chu an puanzâr nên an chhuak hnuhnûng ber a. Dana thlahte chu Amisadaia fapa Abiezeran a ho va.
  </para>
  <para style="p">
    <verse number="26" style="v" />Asera thlahte chu Okrana fapa Pagielan a ho va.
  </para>
  <para style="p">
    <verse number="27" style="v" />Naftalia thlahte chu Enana fapa Ahiran a ho va.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chutianga pâwl indawt thliah chuan Israel fate chu awmhmun an insawnin an kal ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosia puzawn, Midian mi, Reuela fa Hobaba hnênah Mosia chuan, ‘ Lalpa chuan ram min pêk a tiam a; chu ram chu kan thleng ṭhelh ṭhelh tawh a ni. Israel mite chu tihhmuingîl a tiam a, lo tel ve la, kan zâr i zo dâwn nia,’ a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hobaba chuan, ‘Tel ve lo ve, kan ram lamah ka haw leh dâwn,’ a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosia chuan, ‘Min hâwnsan lo hrâm teh. Nang chuan thlalêra bûk khuarna hmun ṭha i hre vek a.
  </para>
  <para style="p">
    <verse number="32" style="v" />I lo tel ve phawt chuan Lalpa malsâwmna kan dawn zawng zawng kan sem ve zêl ang che,’ a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa tlâng aṭang chuan ni thum an kal a, Lalpa Thuthlung Bâwm chu an hmaah, an riahna tûr hmun zawngin a kal zêl a.
  </para>
  <para style="p">
    <verse number="34" style="v" />An riahhmun ata an chhuah chuan Lalpa chhûm chu an chungah a awm zêl a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thuthlung Bâwm a chêt sawn dâwn apiangin Mosia chuan, ‘Aw Lalpa , tho la, i hmêlmate chu ûm darh la, a hawtu che chu tlânchhe rawh se,’ a ti ṭhîn a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Bâwm chu an nghah veleh, ‘Aw Lalpa , Israel chhûngkaw sâng tam tak zîngah hian lo haw leh rawh,’ a ti ṭhîn.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mipui chu an hahin an mangang a, Lalpa chungah an vui a. Lalpa chuan a lo hriatin a thinur hle a, mipui zîngah chuan mei a chhuahtîr a, an riahhmun hmâwrtawng ber thlêr khat chu a kâng chhe vek a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mite chuan Mosia an au va, ani chuan Lalpa hnênah a dîl a, mei chu a rêm ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa mei an zînga a chhuah avângin chu hmun hmingah chuan Tabera an vuah a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel-te zîngah hnam dang tel ve zêl an awm a, chûng chuan sa an châk hle a, Israel mite pawh chuan, “Sa kan va châk ve le:
  </para>
  <para style="p">
    <verse number="5" style="v" />Aigupta ramah lah khân duh duhin sangha kan ei a, a man sawi tham a ni si lo; fanghma te, dawnfawh te, zo-purûn te, vai-purûnsen te, vai-purûnvâr te tak kha aw:
  </para>
  <para style="p">
    <verse number="6" style="v" />Kan va râwp ta ve, mana mai lo hi chu thil dang lah a awm si lo,” an ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mana chu chhibung vâr ang deuh, tuikeplung anga vâr hi a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />An chhar khâwm a, râwt lungah te an râwt dip a, sumah te an dêng a, a chângin an chhûm a, a chângin chhangah an siam a, an ur a, a tui dân chu oliv hriaka hmeh chhang kan ang a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zânah dai tlâk rualin mana chu a lo tla ve ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />A chhûng chhûngin an phun a, an bûk kawngka bula an âng sup sup chu Mosian a lo hria a. Lalpa chu an chungah a thinur viau tih a hriat chuan Mosia chu a mangang ta hle a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa hnênah, “Engtizia nge min va timangang ve? Hêng mite mawh hi engtizia nge min phurhtîr, min va khawngaih lo ve?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hêng mite hi ka fate pawh an ni lo va, engtizia nge nau hnute hne lai nuin a pua ang hrima an pate hnêna pêk i tiam ram paw thleng tûra min tih le?
  </para>
  <para style="p">
    <verse number="13" style="v" />Khawi lama sa nge kei tehlulin ka pêk ang? ‘Sa kan châk êm mai, min pe rawh,’ tiin ṭap chungin min rawn nawr buai hi?
  </para>
  <para style="p">
    <verse number="14" style="v" />Keimah mai zawngin hêng mite hi ka tuar dâwn lo, a hahthlâk lutuk.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hetianga min tih dâwn zawngin min khawngaih la, min tihlum zâwk mai teh, heti taka tihretheih hi zawng ka peih ta lo,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa chuan Mosia hnênah, “Mipui zînga hruaitu deuh deuh mi sawmsarih han khâwm la, Inbiakna bûkah rawn hruai la, i bulah lo ding teh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka lo chhuk ang a, ka rawn be dâwn che nia. I chunga thlarau awm kha ka sem ve ang, mipui enkawlna mawh chu nangmah maiin i phur tawh lo vang a, an phurhpui tawh ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mipui hnênah, ‘Naktûk atân inserh thianghlim rawh u, sa in ei dâwn e; ‘sa ei tûr nei teh ila aw, Aigupta rama a tam ṭhin vei nên,’ tia in sa châk ṭap thâwm chu Lalpa beng a thleng a ni; Lalpa chuan sa a pe ngei dâwn a che u, in ei mawlh ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni hnih khat mai ni lo, ni nga emaw, ni sâwm emaw, ni sawmhnih emaw mai pawh ni lo,
  </para>
  <para style="p">
    <verse number="20" style="v" />a thlaa thla khat pumhlûm, luakchhuak hlui khawpin in ei ang a, a ngei hluah hluah ang che u, ‘Engtiziaa Aigupta ram chhuahsan ta mai nge maw kan nih le?’ tiin in zînga awm Lalpa chu in hnâwl a, ṭapin in nawr buai si a,’ ti ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosia chuan, “Ka mi hruaite hi, mahni kea kal thei ngawt pawh, mi nuairuk zet an ni a, ‘thla khat pumhlûm an ei tûr sa ka pe dâwn’ i ti a,
  </para>
  <para style="p">
    <verse number="22" style="v" />berâm leh ran rual zawng zawng pawh talh ila, an ei khawp a tling dâwn em ni? Tuifinriat sangha zawng zawng pawh man ila, an kham dâwn em ni?” a ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa chuan Mosia hnênah, “Tih theih loh ka nei ta em ni? Ka sawi anga thil a awm dâwn leh dâwn loh i hre mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosia chu a chhuak a, Lalpa thu chu mipuite a hrilh a, an upa sawmsarihte chu a hruai a, Biakbûk vêlah chuan a dintîr a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpa chu chhûmah a lo chhuk a, a rawn bia a; a chunga thlarau dah ṭhenkhat chu a la a, mi sawmsarihte chungah chuan a dah a; chutia an chunga thlarau a lo awm veleh chuan zâwlnei angin thu an sawi ta a, rei erawh chu an sawi lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sawmsarih zînga tel mi pahnih Eldada leh Medada chu Biakbûk kal ve lovin an riahhmunah an awm a, anni pawh chuan zâwlnei angin thu an sawi ve bawk a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tlangvâl pakhat hi Mosia hnênah a lo tlân a, “Eldada leh Medadan riahhmunah thu an sawi bual bual mai,” a rawn ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosia puitu Josua, Nuna fapa chuan, “Ka pu, khap teh,” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosia chuan, “Ngaimawh viauvin mi ring a ni maw? Lalpa chuan a thlarau chu mi zawng zawng pe se, zâwlnei ni vek se tih nâk alai a,” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mosia leh upa sawmsarihte chu riahbûk lamah an haw a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa chuan thli a tlehtîr a, tuifinriat aṭang chuan vahmîm a rawn lên a, tawng hnih vêl leka sânga thlâwkin an bûkah leh a vêl ni khat kal hual chhûngah chuan an ṭum a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chumi ni leh a tûkah chuan nilêng zânkhuain vahmîm chu an man khâwm a, a man tlêm ber pawhin kuintal sâwm vêl an man a ni; an bûk vêlah chuan ni sa-ah an rêp a.
  </para>
  <para style="p">
    <verse number="33" style="v" />A sa an ei mêk lai chuan Lalpa thin an tiur a, an zîngah hri na tak a lêng ta a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mi râwp tak takte chu chutah chuan an phûm avângin chu hmun chu Kibrot-hatava an vuah a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kibrot-hatava aṭang chuan Hazaroth-ah an insawn a, chutah chuan an châm rei ta deuh va.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Miriami leh Arona chuan Mosian Kus mi nupuia a neih avângin an hmusit a.
  </para>
  <para style="p">
    <verse number="2" style="v" />“ Lalpa hian Mosia hnênah chauh em ni thu a sawi bîk? Keini pawh min be lo vem ni?” an ti a. Lalpa chuan chu chu a lo hria a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosia chu mi inngaitlâwm tak a ni a, khawvêla mi inngaitlâwm thei ber a ni hial ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chuan Mosia te, Arona te leh Miriami te chu a ko va, “Inbiakna bûkah in pathumin lo kal teh u,” a ti ta thut mai a, an kal ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chu chhûm dingah chuan a lo chhuk a, bûk kawngkaah chuan a ding a. Arona leh Miriami chu a ko va, an va pan a.
  </para>
  <para style="p">
    <verse number="6" style="v" />An hnênah, “Ka thu hi ngaithla teh u, in zînga zâwlneite chuan zêlin emaw min hmu a, mumangah emaw an hnênah thu ka sawi chauh ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka chhiahhlawh Mosia hnênah chuan chutiangin ka ti ve ngai lo, a kutah ka mi Israel-te ka dah a,
  </para>
  <para style="p">
    <verse number="8" style="v" />inhmatawnin kan inbe ṭhîn a ni, fiah takin thu ka sawi a, tehkhin thu leh thu awmze rûk neiin ka be ngai lo, ka riruang pawh a hmu a ni. Engtizia nge ka chhiahhlawh Mosia hi in hmuhsit ngam le?” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />An chungah chuan a thinur hle a, a kalsan ta mai a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Biakbûk aṭanga chhûm a kian chuan Miriami chu vûr anga vârin a phâr vâr ta uar a. Arona chuan Miriami chu a han en a, a lo phâr reng mai a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arona chuan Mosia hnênah, “Ka pu, kan ât leh kan sual mawh hi min phurhtîr lo hrâm ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thi leh dam kâra lêng, piangsual saa piang ang êm chuan awm lul suh se,” tiin a ngên a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosia chuan Lalpa a au va, “Aw Pathian, tidam hrâm teh, ka ngên a che,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa chuan Mosia hnênah, “A pain a hmaiah chil chhâk sela, zakin ni sarih chu a biru dâwn lâwm ni? Ni sarih chhûng chu daipâwnah dah rawh, chutah in hruai lût leh dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Miriami chu daipâwnah ni sarih an dah a, a lo luh leh hma chu an insawn lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hazerot chu an chhuahsan a, Paran thlalêrah bûk an khuar a.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hnam tin aṭangin mi fel tak pakhat zêl thlang chhuak la, Israel mite ka pêk tûr Kanan en thlithlai tûrin tîr rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel mite zînga hotu deuh deuh chu Lalpa thupêk angin hêng mite hi Paran thlalêr aṭang chuan a tîr a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Reubena thlah aṭangin Zakura fapa Samua;
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeona thlah aṭangin Horia fapa Safata;
  </para>
  <para style="p">
    <verse number="6" style="v" />Juda thlah aṭangin Jefunea fapa Kaleba,
  </para>
  <para style="p">
    <verse number="7" style="v" />Isakara thlah aṭangin Josefa fapa Igala;
  </para>
  <para style="p">
    <verse number="8" style="v" />Efraima thlah aṭangin Nuna fapa Hosea;
  </para>
  <para style="p">
    <verse number="9" style="v" />Benjamina thlah aṭangin Rafua fapa Paltia;
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebuluna thlah aṭangin Sodia fapa Gadiela;
  </para>
  <para style="p">
    <verse number="11" style="v" />Josefa fa Manasea thlah aṭangin Susia fapa Gadia;
  </para>
  <para style="p">
    <verse number="12" style="v" />Dana thlah aṭangin Gemalia fapa Amiela;
  </para>
  <para style="p">
    <verse number="13" style="v" />Asera thlah aṭangin Mikaela fapa Sethura;
  </para>
  <para style="p">
    <verse number="14" style="v" />Naftalia thlah aṭangin Vopsia fapa Nabia;
  </para>
  <para style="p">
    <verse number="15" style="v" />Gada thlah aṭangin Makia fapa Geuela.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hêng mite hi ram en thlithlai tûra a mi tirhte chu an ni. Nuna fapa Hosea hming hi a thlâksak a, Josua a vuah a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mosia chuan Kanan ram en thlithlai tûrin a tîr a, “Heta ṭangin hmâr lamah kal ula, tlângramah khian chho vang che u,
  </para>
  <para style="p">
    <verse number="18" style="v" />eng ang ram nge en thlithlai ula, mi an tam nge tam lo, an chak nge chak lo tih te,
  </para>
  <para style="p">
    <verse number="19" style="v" />an ram chu a ṭha nge ṭha lo, khawpui kulh neiahte nge an chên bûk mai maiah;
  </para>
  <para style="p">
    <verse number="20" style="v" />ram chu a chênghnâwng nge chênghnâwng lo tih te, ngaw a ṭha nge ṭha lo tihte han en thlithlai rawh u, an thei rah ṭhenkhat chu han hâwn ngei ang che u,” a ti a. Grep rah vânglai a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zin thlalêr aṭangin Hamath kalkhân bul Rehob thlengin an fang a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chhim lam an tlawh chhuak hmasa a, Hebron-ah an kal a. Hetah hian Anaka thlah Ahiman hnam te, Sesai hnam te, Talmai hnam te an la awm a. Hebron khua hi Aigupta khawpui pakhat Zoan khua aiin kum sariha din hmasak a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Eskol phai an thleng a, grep bâwr khat chu a ṭang nên an hlep a, pahnihin an zâwn a, theibuhfai te, theipui rahte pawh an lo va.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chu hmun chu an grep rah bâwr chawiin Eskol an vuah a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni sawmli an thang a, ram an en thlithlai hnu chuan an kîr leh ta a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mosia te, Arona te leh Israel mipui awmna hmun Paran thlalêra Kades chu an lo thleng a, an thei lawhte chu an entîr a.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Min tirhna ramah chuan kan han kal a, khawizu leh hnutetuia luang ram a lo ni teh meuh mai; thei rahte hi en teh u.
  </para>
  <para style="p">
    <verse number="28" style="v" />A mi chêngte erawh chu mi kawlhsen tak tak an ni, khaw lian tak tak, kulh ṭha deuh deuhvah an awm a, Anak thlah miliante pawh kan hmu ṭeuh mai.
  </para>
  <para style="p">
    <verse number="29" style="v" />Chhim lamah Amalek-ho an awm a, thlang lam ramah Hit mi te, Jebus mi te, Amor mi te an awm a, Mediteranean tuipui kamah leh Jordan lui ruamah Kanan mite an awm,” an ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kaleba chuan Mosia hmaa mipui phun mur mur chu a tingawi ṭhuap a, “I rûn nghâl ang u, an ram chu kan luahlân mai ang, kan tam tâwk a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kaleba kalpuite chuan, “Keini aiin an tam a, kan ngam hauh lo vang,” an ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel mite zîngah chuan a ṭha lo lamin ram chanchin chu an sawi a.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Kan ram han en thlithlai chu ei khawp thar theihna pawh a ni lo, kan mi hmuhte lah pa lian pui pui an ni. Milian chi, Anak thlahte pawh kan hmu; an lakah khau ang lek kan ni a, anni pawhin khau ang lekin min hmu âwm e,” an ti a.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel pungkhâwmho chu mangangin an ṭap zânkhua a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosia leh Arona chu an dem a, “Aigupta ramah khân lo thi ta zâwk ila a ṭha tûr, he thlalêrah pawh hian thi mai ila a ziaawm zâwk ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Engtizia nge Lalpa hian indonaa thi tûr leka he rama min hruai le? Kan nupui fanau tê tê pawh hian an tuar ngei dâwn; Aigupta ramah kîr leh zâwk mai ila a ṭha ang,” an ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />An inrâwn tlâng a, “Aigupta ramah min kîrpui thei tûr hruaitu i ruat ang u,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosia leh Arona chu Israel pungkhâwmho hmaah chuan hmaia lei siin an kûn a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ram en thlithlaitute zînga mi Nuna fapa Josua leh Jefunea fapa Kaleba pawh chuan pawi an ti a, an puan an pawtthlêr a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel pungkhâwmho hmaah chuan, “Kan ram en chu ram ṭha tak asin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kan chungah Lalpa a lungnih phawt chuan min hruai ang a, khawizu leh hnutetui luanna ram chu min pe ngei ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa lakah nuar lo hrâm rawh u: chûng ram mite chu hlau hek suh u, Lalpa chuan an rinchhan pathian lemte chu a hneh tawh a, bêl chhûnga sa ang mai an ni; hlau suh u,” an ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mahse, pungkhâwmho chuan lunga den hlum an tum a, chutih lai chuan Israel mi zawng zawng hmuh tûrin Lalpa êng chu Inbiakna bûk chungah chuan a êng ta pum a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa chuan Mosia hnênah, “Eng chen nge maw hêng mite hian min hmuhsit reng dâwn le? Thil mak heti zozai ka tihsak hnu pawhin min la ring lo fo em ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hri ka lêntîr ang a, ka tiboral vek mai dâwn e; i fate aṭangin an aia tam zâwk leh thil ti thei zâwk ka din mai teh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosia chuan Lalpa hnênah, “Aigupta ram aṭangin ropui takin i hruai chhuak a, Aigupta miten an chunga thil tih i tum chu an hriat chuan,
  </para>
  <para style="p">
    <verse number="14" style="v" />he rama awmte hi heti hian an hrilh ngei ang. Hêng mite hian nang, Lalpa hi kan zîngah i tel ve zêl a, chhûma bûk i rawn khuh apiangin nang pawh an hmu ṭhîn che a, chhûnah chhûm dingin i hruai a, zânah pawh mei dingin an hma i hruai ṭhîn tih an lo hre daih tawh a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />I mite hi i tihhlum vek mai chuan, i hming ṭhatzia hretute chuan,
  </para>
  <para style="p">
    <verse number="16" style="v" />‘Pêk a tum ramah a hruai thleng thei lo va, an thi zo ta a ni,’ an ti ngei ang le!
  </para>
  <para style="p">
    <verse number="17" style="v" />Tichuan, aw Lalpa , i thiltihtheihzia han tilang la, i thutiam angin han ti teh.
  </para>
  <para style="p">
    <verse number="18" style="v" />‘Kei, Lalpa hi thinnel tak ka ni a, ngilnei tak, an sualna leh bawhchhiatna ngaidam ṭhîntu ka ni; amaherawhchu, thil tisual ngeite chu ka chhuah lo vang, an pate sualna avângin an fate, an tûte, chhuan thum chhuan li thleng thlengin ka hrem ang,’ i tih kha.
  </para>
  <para style="p">
    <verse number="19" style="v" />I ngilneih avâng leh hêng mite hi Aigupta ram ata tawh i ngaihdam ṭhîn ang khân tûnah pawh ngaidam leh tûrin ka ngên a che,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpa chuan, “Mi dîl angin ka ngaidam ang e,
  </para>
  <para style="p">
    <verse number="21" style="v" />Kei, Lalpa hi mi nung ka nih hi, ka ropuina leiah a khat a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka ropuina hmutu, Aigupta ramah leh thlalêra ka thiltih mak hmututen vawi sâwm chuang min fiah a, ka thu ngaithla duh lotute leh
  </para>
  <para style="p">
    <verse number="23" style="v" />min pawisa lotute hian an pate hnêna pêk ka tiam ram chu an lût ve tawp lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka chhiahhlawh Kaleba hi chuan rilru dang a pu a, ka thu a awih êm avângin a va en thlithlai ramah chuan ka hruai ang a, a thlahte chuan chu ram chu an nei ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chu ram phaiah chuan Amalek leh Kanan mite an awm avângin naktûkah chuan Tuipui Sen panin kîr rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Hêng mi sual tak tak, phunchiar êm êmte hi eng chen nge ka dawh theih ang? Ka laka an phunchiarzia ka hria.
  </para>
  <para style="p">
    <verse number="28" style="v" />An hnênah, ‘Mi nung ka nih hi, in duh ang chu ka tihsak ang che u, kei Lalpa hian ka sawi tawh hi,
  </para>
  <para style="p">
    <verse number="29" style="v" />in thi ang a, in ruang chu thlalêrah hian a let pheng phung ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />In phunchiar êm avângin Nuna fapa Josua leh Jefunea fapa Kaleba te chauh lo hi chuan, kum sawmhnih a chin chung lam rêng rêng chu in hnêna pêk ka tiam ramah chuan in lût tawp lo vang.
  </para>
  <para style="p">
    <verse number="31" style="v" />‘Kan fanau tê tê hian an tuar ang a’ in tihte hi chu ka hruai lût ang a, a chanchin chauh in hriat ram chu an luah ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nangni erawh hi zawng thlalêrah in ruang a thal rem rum dâwn a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />In fate chu thlalêrah kum sawmli an vâkvai ang a, in thih zawh hma chu in suahsual man in tuar dâwn a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ram en thlithlai tûrin ni sawmli an thang a, ni khat aiah kum khat, a vaiin kum sawmli an vâkvai dâwn a ni, ka lâwm lo a ni tih in hria ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nangni mi sual pungkhâwmho, min kalh min kalh vei ṭhînte u, thlalêrah hian in thi phiar ang; kei, Lalpa hian ṭawng ka thlah tâk hi,” a ti a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ram en thlithlai tûra tirh an lo kîra a ṭha lo zawnga ram chanchin sawia, mipui tilunghnûrtute chu,
  </para>
  <para style="p">
    <verse number="37" style="v" />Lalpa hmaah hri veiin an thi ta a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ram en thlithlaitute zîngah Nuna fapa Josua leh Jefunea fapa Kaleba chauh chu a dam chhun an ni ta a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mosian chûng thu chu Israel mite a hrilh a; an lungawi lo hle a.
  </para>
  <para style="p">
    <verse number="40" style="v" />A tûk zîngah chuan an tho va, tlângram lam pan an tum a, “Heti thleng hi kan lo kal tawh a, tûnah zawng Lalpa sawi rama luh kan inpeih ta, kan lo tisual a ni,” an ti a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mosia chuan, “In hlawhtling dâwn lo tih hre reng chungin engtizia nge Lalpa thupêk in awih loh?
  </para>
  <para style="p">
    <verse number="42" style="v" />Lalpa chuan a awmpui lo vang che u; in hmêlmate lo thah mai mai tûrah chho duh ting suh u.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amalek mite leh Kanan mite in beih ni chuan an khawlaiah in thi ngei ang, Lalpa in zui duh si lo va, a pui lo vang che u,” a ti a.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mahse, tlângram chu bei tûrin an pan lui hrâm a. Thuthlung Bâwm leh Mosia erawh chu an kal ve lo.
  </para>
  <para style="p">
    <verse number="45" style="v" />Amalek leh Kanan mi, chu laia awmte chuan an rawn bei a, an hneh a, Horma thlengin an ûm a.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh. In awmna atân ka pêk tûr che u ram ka hruai thlen hunah che u chuan,
  </para>
  <para style="p">
    <verse number="3" style="v" />bâwngpa te, berâmchal te, berâmpui te, kêl te, Lalpa hnênah hâlral thilhlan atân te, mahni duh thu-a thilhlanah te, kût nikhuaa thilhlanah te in hmang tûr a ni, hêng thil hlan rim hi Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hâlral thilhlan atân berâm emaw kêl emaw in rawn hlan chuan pakhat zêlah buhbâl thilhlan atân chhangphut ṭha chi kg. khat leh oliv hriak litar khat in rawn keng tûr a ni, in tûr thilhlanah uain litar khat nên.
  </para>
  <para style="p">
    <verse number="6" style="v" />Berâmchal in hlan dâwn chuan buhbâl thilhlan atân chhangphut ṭha chi kg. hnih leh Oliv hriak litar khat leh a chanve in rawn keng tel tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />In tûr thilhlanah uain litar khat leh a chanve han keng tel bawk ang che u. Hêng thilhlan hâl hi Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hâlral thilhlan atân Lalpa hnêna bâwngpa in rawn hlanin emaw, tiamkam tlâkna thilhlan atân emaw, remna thilhlan atân emaw inhlan rualin
  </para>
  <para style="p">
    <verse number="9" style="v" />chhangphut ṭha chi kg. thum, oliv hriak litar hnih in rawn keng tel tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Uain litar hnih pawh in rawn keng tel tûr a ni. Hêng thilhlan rim hi Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Bâwngpa te, berâmchal te, berâmpui te leh kêlte in rawn hlan rualin pakhat hisâp zêla in rawn hlan tel tûr chu hêng zât hi a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />In ran hlan a tam dân azirin hêng thil dang pawh hi in telh tam tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel mi tawh phawt chuan ei tûr thilhlan Lalpa lawmzâwng hâl tûr a rawn lâk chuan khitiang khian tih tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hnam dang, in zînga piangin emaw, lo awm ve zawkin emaw ei tûr thilhlan Lalpa lawmzâwng an hlan chuan khitiang bawk khian an ti tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mikhual leh khawtual pawhin in thlahte thleng pawhin tih dân thuhmun in hmang tûr a ni. Lalpa hmaah in thuhmun vek si a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangni leh in zînga hnam dangte pawhin chûng chu kumkhuain in zâwm tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Israel mite chu hrilh rawh: ram ka pêk tûr che u in lo thlena,
  </para>
  <para style="p">
    <verse number="19" style="v" />in buh thar hmasa in ei hunah chuan Lalpa hnêna hlan tûr a ṭhen in dah hrang tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />In barli thar aṭanga in chhang siam hmasak ber tlang khat pawh Lalpa hnênah in hlân tûr a ni; in buh vuak hmasa Lalpa hnêna in pêk ang bawk khân pêk tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kumkhuain in chhang siam hmasak tlang khat chu Lalpa hnênah in pe ziah tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Mosia hnêna Lalpa thil tuk hi tuin emaw ti lo palh se emaw,
  </para>
  <para style="p">
    <verse number="23" style="v" />hnam pum puiin Mosia hnêna thupêk zawng zawng hi an tih loh palhin emaw,
  </para>
  <para style="p">
    <verse number="24" style="v" />an thil tihsual palh chu chinchâng an hriat loh vâng a nih chuan hâlral thilhlan atân bâwngpa an hlân tûr a ni; a telh tûr bituk zât buhbâl thilhlan leh in tûr thilhlan uain nên; chu chu Lalpa lâwmzâwng chu a ni si a. Sual thawina thilhlan atân kêlpa an hlân tel bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Puithiam chuan hnam pum sual chu a thawi ang a, an thil tihsual chu an tih palh tak tak a ni si a; sual thawina thilhlan Lalpa hnêna an hlan tawh avângin ngaihdam an ni tawh ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel hnam pum pui chu, an zînga hnam dang awm vete nên lam ngaihdam an ni ang, an za-in thil an tisual palh a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi mal pawhin hre lova thil sual a tihpalh chuan, sual thawina thilhlan atân kêlno, a nu, kum khat vêla upa, a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Puithiam chuan maichâmah chu mi sual thawina thilhlan chu a tihsak ang a, ngaihdam a ni tawh ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi malin emaw, a hnam pumin emaw thil tihsual palh thu-ah Israel-te zîngah chuan a khual a tualin he dân hi an zâwm tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Tu pawh, hre reng chunga thil tisual chu khawtual pawh, mikhual pawh, Lalpa sawichhia a ni: in tihlum ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa thu chu a pawisak lova, a thupêkte a bawhchhiat luih avângin tihhlum daih tûr a ni, a sual mawh chu a phur ang.”
  </para>
  <para style="p">
    <verse number="32" style="v" />Vawi khat chu Israel-te thlalêra an awm lai khân mi pakhatin sabat ni-ah thing a fawm a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosia te, Arona te leh pungkhâwmho hnênah chuan an hruai a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Engtia tih tûr nge tih a chian mai loh avângin ripah an khung a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lalpa chuan Mosia hnênah, “Tihhlum tûr a ni, vântlângin daipâwnah lunga den hlum tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Lalpa thupêk angin vântlâng chuan daipâwnah an hruai a, lungin an dêng hlum ta a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="38" style="v" />“Israel-te chu hrilh rawh: In silhfên tlâng kilah pehbuk siam ṭhîn rawh u, la dumpâwlin siam ula, thil chîn kumkhuaah in neih dâwn nia.
  </para>
  <para style="p">
    <verse number="39" style="v" />Chu pehbuk chuan ka thupêkte a hriat chhuahtîr ang che u a, in zâwm ṭhîn ang; tichuan, min hawisan lo vang a, mahni duh thu leh mahni châk zâwng angin in khawsa dâwn lo nia.
  </para>
  <para style="p">
    <verse number="40" style="v" />Pehbuk chuan ka thupêk zawng zawng zâwm tûr in ni tih te, ka tâna invawng thianghlim tlat tûr in nih te a hriat chhuahtîr ṭhîn ang che u.
  </para>
  <para style="p">
    <verse number="41" style="v" />In Pathian ni tûrin, kei, Lalpa in Pathian hi Aigupta ram aṭanga hruai chhuaktu che u kha ka ni. Lalpa in Pathian ka nih hi,” a ti a.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levia chi, Kohata thlah, Izara fapa Kora chuan Mosia luahlan a tum a. Reubena thlah Dathana leh Abirama, Peleta fa, Eliaba leh Ona fate chuan an thlâwp a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel mi, hruaitua an thlan, pa fel tak tak mi zahnih leh sawmngain an thlâwp bawk a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosia leh Arona hnênah a rualin an lo thawk a, “I inlek lu ta, mi tin Lalpa ta kan ni vek a, Lalpa chuan min awmpui ve ṭheuh alâwm. Chuvângin, nang Mosia, eng vangin nge Lalpa mite zînga lal bika i indah?” an rawn ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosian a lo hriat chuan a bawkkhup a, a ṭawngṭai a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kora leh a ṭhiante hnênah chuan, “Naktûk zîngah Lalpa chuan ama ta te chu a rawn tifiah mai ang; a mi thlante chauh maichâma an lo kal a phal dâwn a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kora, i ṭhiante nên hian in meilawh keng ula, meiling dah ula, naktûk zîngah Lalpa hmaah rimtui hâl ang che u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa chuan tu nge a thlan kan hre mai ang. Nangni Levia thlahte hi a ni inlek lu ta chu,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosia chuan Kora hnênah, “Levia thlahte u, ngaithla teh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel mipui zîng ata a bula awma, Lalpa Biakbûka rawngbâwl tûr te, thil ṭûl apiang mipui lo tihsak tûr tea a serh hrang che u hi thil nêp tak em ni?
  </para>
  <para style="p">
    <verse number="10" style="v" />Chu chanvo ropui tak chu nang leh Levia thlah dangte hi a chantîr che u a, puithiam nih leh zêl in tum a ni maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Arona chunga i hote nên in vui hi Pathian laka vui in ni asin” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosia chuan Eliaba fa Dathana leh Abirama chu a ko va, anni chuan, “Kan lo kal lo vang,
  </para>
  <para style="p">
    <verse number="13" style="v" />khawizu leh hnutetuia luang ram ata hetiang thlalêr hmuna thi mai tûra min hruai chhuak hi thil nêp tak em ni? I intilal hle lehnghâl a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khawizu leh hnutetuia luang ram awzâwngah min hruai loh hi; lo te, grep hmun te lah kan nei teuh si lo. Meng ve reng si min bum i tum a nih hi, kan lo kal lo vang,” an ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosia chu a thinur hle a, Lalpa hnênah, “An thilhlan eng mah lo pawm suh ang che; an chungah eng mah tihsual ka nei lo va, tu sabengtung mah ka lâksak ngai hlei nêm,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosia chuan Kora hnênah, “Naktûkah i hote nên, Inbiakna bûkah lo kal ula, Arona pawh a lo kal ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mahni meilawh rawn keng ṭheuh ula, meiling dah ula, rimtui hâl tûr chu phul ula, maichâmah han keng ang che u, Arona pawhin a rawn keng ang,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tichuan, mahni meilawhah meiling an dah ṭheuh va, rimtui chu an phul a, Inbiakna bûk luhnaah chuan Mosia leh Arona te nên an ding tlâng a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kora chuan a hote lo kal khâwm chu Inbiakna bûk kawngkaah chuan Mosia leh Arona te chu a hmachhawntîr a, Lalpa ropuina chu mi tin hmuhah a lo lang ta thut a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hêng pungkhâwmho hi inthiar fihlîmsan teh u, ka han tiboral phiar teh ang,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Anni chu an bawkkhup a, “Aw Pathian, mi tin nunna hnâr i ni a, mi pakhat sual avângin mi zawng zawng chungah i thinur dâwn em ni?” an ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Mipui chu Kora te, Dathana te Abirama te bûk aṭanga insaseng tûrin hrilh rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosia chu Israel hruaitute chuan an zui a, Dathana leh Abirama hnênah chuan an kal a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mosia chuan mipui hnênah, “Hêng mi sualho bûk bulah hian tu mah awm suh u, an thil eng mah khawih hek suh u, an sual avângin nangni pawh in ral mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tichuan, Kora te, Dathana te leh Abirama te bûk aṭang chuan an insaseng a; Dathana leh Abirama pawh an bûk aṭang chuan an lo chhuak a: kawngka bulah chuan an nupui leh an fanau te nên chuan an ding a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosia chuan mipui hnênah, “Pathianin hêng thil hi ti tûrin min tîr a ni tih in hria ang, ka duh thu-a ti ka ni lo ve.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hêng mite hi thih dân pangngaia an thiha, danglam deuhva hrem an nih loh chuan min tîr a ni lo vang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lalpa hian thil la hriat ngai loh a rawn tiha, lei a khîk phuka, an thil neih zawng zawng nên a nung chunga mitthi khuaa an chhuk chuan hêng mite hian Lalpa chu an hnâwl ngei tihna a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />A sawi zo hman chiah a, Dathana leh Abirama awmna lei chu a kak phuk a,
  </para>
  <para style="p">
    <verse number="32" style="v" />an chhûngte leh Kora ho mi dangte pawh chu an neih zawng zawng nên an tla pil ta vek a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tichuan, an neih zawng zawng nên mitthi khuaah an chhuk ta a ni: lei kak chu a ping leh a, anni chu an pil bo ta a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chuta awm ve Israel mi zawng zawng chuan ṭê teng tung thâwm an hriat chuan an tlânchhia a, “Tlân rawh u, kan tla pil ve mai ang e,” an ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lalpa chuan mei a rawn tîr a, rimtui hâltu mi zahnih leh sawmngate chu a rawn kâng hlum ta vek a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="37" style="v" />“Puithiam Arona fapa Eleazara hrilh rawh: Kâng hlum tate dâr meilawh ken kha chhar khâwm sela, a meihawlte chu daipâwnah paih rawh se; dâr meilawh zawng zawng kha serh hran tawh a ni si a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Lalpa maichâma hlan an nih khân thil thianghlim an lo ni ta si a.
  </para>
  <para style="p">
    <verse number="39" style="v" />An sual vânga kâng hlum tate meilawh chu la khâwm la, chhu pêr la, maichâm chhînah siam rawh, Israel mite tân ṭihkhai a ni dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Puithiam Eleazara chuan meilawh chu a la khâwm a, a chher phêktîr a, maichâm chhîn chu a siam ta a. Arona thlahte tih loh chuan maichâmah Lalpa tân tu man rimtui an rawn hâl tûr a ni lo tih Israel-ten an hriatna tûr a ni ta a. Kora leh a fate angin an thi ve mai ang. Eleazara hnêna thupêk, Mosia hnêna Lalpa sawi ang chuan hêng hi an ti a.
  </para>
  <para style="p">
    <verse number="41" style="v" />A tûkah chuan Israel pungkhâwmho zawng zawng chuan Mosia leh Arona chu an dem a, “ Lalpa mite in tihlum vei a,” an ti a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mipuiin Mosia leh Arona an zim luai luai lai chuan Inbiakna bûk an han en a, chhûmin a lo khuh a, Lalpa ropuina chu an hmu a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mosia leh Arona chu bûk kawtah an kal a.
  </para>
  <para style="p">
    <verse number="44" style="v" />Lalpa chuan Mosia hnênah:
  </para>
  <para style="p">
    <verse number="45" style="v" />“Mipui zîng ata kha lo kal hrang teh, ka han tihlum phiar teh ang,” a ti a. An pahnih chuan hmai lei siin an kûn a.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosia chuan Arona hnênah, “I meilawh kha keng la, maichâm mei saw va rût la, mipui zîngah, an sual thawi nân rimtui va hâl thuai teh; Lalpa thinurna chu a lo thleng dêr tawh a nia; hmanhmawh rawh, hri an vei ṭan e,” a ti a.
  </para>
  <para style="p">
    <verse number="47" style="v" />Arona chuan Mosia thu chu a awih a, mipui zîngah a va kal chuan hri an lo vei nual tawh a; rimtui chu a hâl a, mipui sualna chu a thawi ta a.
  </para>
  <para style="p">
    <verse number="48" style="v" />A thi leh a la damte inkârah chuan a ding a, hri chu a kiang ta a.
  </para>
  <para style="p">
    <verse number="49" style="v" />Kora helna avânga thite chu an vaiin mi sîngkhat leh sângli leh zasarih an ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hri a reh hnu chuan Arona chu Inbiakna bûkah Mosia hnênah chuan a kal leh ta a.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite hrilh rawh: tiang sâwm leh pahnih, hnam tin hruaitu tân pakhat zêl rawn la teh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levia chite tiangah chuan Arona hming ziak ang che; hnam khat hruaitu hming an tiangah chuan a chuang zêl tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Inbiakna bûkah, Thuthlung Bâwm hma, kan inbiakna ṭhinah, i dah dâwn nia.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka mi thlan chu tu ber hi nge in hriata, tu mah in vui tawh loh nân ka mi thlan tiang chu ka chawrtîr dâwn a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia chuan Israel-te chu a hrilh a, hnam hruaitute chuan tiang pakhat ṭheuh an rawn pe a, a vaiin sâwm leh pahnih a ni; Arona tiang pawh a tel ve.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosia chuan bûk chhûng Thuthlung Bâwm hmaah chuan a dah a.
  </para>
  <para style="p">
    <verse number="8" style="v" />A tûk zîngah chuan Mosia chu Inbiakna bûkah chuan a lût a, Arona tiang Levia thlahte hminga dah chu a lo chawr a, a kuhmûm a, a pâr a, theitê a lo rah a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosia chuan tiang zawng zawng chu Lalpa hma ata chu a la chhuak a, Israel-te chu a entîr a, mahni tiang tiang an la ta sang sang a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa chuan Mosia hnênah, “Thuthlung Bâwm hmaah Arona tiang chu dah leh rawh; Israel mi, hel chîngho hi an vui leh chuan an thi mai ang tih hriatna tûrin dah reng ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa thupêk ang chuan Mosia chuan a ti ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel mite chuan Mosia hnênah: “Chuti chu kan va thi rem rum mai âwm ve?
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa Biakbûk bul hnaihtu ngawt pawh an thih chuan kan va mang mai âwm ve!” an ti a.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Arona hnênah, “Nang leh i fate leh Levia chite hian Inbiakna bûka rawngbâwl hna tihdik lohvah mawh in phur ang; puithiam rawngbâwlna bîka tihsual mawh chu nang leh i fate chauhvin an phur ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />In laichîn, Levia chite chu, bûka in rawngbâwl hna thawh ṭanpui tûr che uin pun rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />An puibâwm ang che u a, bûk enkawl hna hi an mawhphurhna a ni ang; amaherawhchu, hmun thianghlim leh maichâm thil serh chu an khawih ve tûr a ni lo, an khawih hlauh chuan nangni pawh, anni pawh in thi mai ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bûka rawngbâwl hna zawng zawngah an pui ang che u a, an hna chu anmahni ngeiin an tifel tûr a ni; mi dang mi narânin an pui tûr che u a ni lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang leh i fate chauhvin Hmun Thianghlim leh maichâm chu in enkawl tûr a ni, Israel-te chungah ka thinur leh thut loh nân.
  </para>
  <para style="p">
    <verse number="6" style="v" />I laichîn Levia chite hi nangmah ṭanpui tûra Israel-te zîng ata ka thlang chhuak a, thilpêka petu che kei hi ka ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Inbiakna bûka thawk tûrin ka tâna serh hran an ni tawh, Hmun Thianghlim Bera awm leh maichâma puithiam rawngbâwl hna erawh hi chu nang leh i fate chauhvin in ti tûr a ni. Puithiam hna hi ka pe che u a; chuvângin, hêng hi in mawhphurhna a ni, mi narânin an tih ve chuan tihhlum tûr an ni,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chuan Arona hnênah, “Israel miten ka hnênah thên thilhlan an rawn hlan, serh hran tawh rêng rêng chu nang leh i fate hnênah puithiam sa atân kumkhuain ka pe a che u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Buhbâl thilhlan te, sual thawina thilhlan te, bawhchhiat man thilhlan te an rawn hlân a, maichâma hâl bâng zawng zawng chu in chan tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hmun Thianghlimah ngei chûng sa chu in ei tûr a ni, mipa chauhvin ei tûr a ni: thil serh a ni e.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Israel mite thilhlan chi hrang hrang, thêna hlan rêng rêng chu, in fapate in fanute nêna kumkhuaa in chanpual atân ka pe a che u, in chhûng zînga mi thiang apiang chuan in ei thei ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Oliv hriak fîm ber te, uain thlum ber te, vaimîm ṭha ber te Israel miten min pêk ṭhin tûr chu ka pe a che u, in ta tûr a ni;
  </para>
  <para style="p">
    <verse number="13" style="v" />An ram chhûnga an theirah hmin hmasa Lalpa hnêna an rawn hlante pawh in chan tûr a ni. In chhûng zînga a thiang apiangin in ei thei ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel-te zînga kawh bîk nei thilhlan tih loh chu in ta vek tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Mihring pawh, ran pawh, a piang hmasa ber, chhûl keutu, Israel-ten Lalpa an pêk ṭhin chu, in ta tûr a ni; mihring leh ei thiang lo ran chu, tlan theih a ni ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Naupang thla khat chin tlanna tûr chu biakbûka an hman lai mêk tangkaraw sekel nga bûk a ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bâwng no te, berâmno te, kêlno te, hrin hmasak chu tlan theih a ni lo vang, serh hran an ni. Talh tûr a ni a, a thisen chu maichâma theh tûr a ni a, a thau pawh maichâma hâl ral tûr a ni: chu chu Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thên thilhlan angin a irno leh a bawp chu in ei ve tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Israel-ten ka hnêna thên thilhlan an rawn ken chu in fanu leh in fapate nêna in chan kumkhua atâna ka ruat a ni. Hei hi nang leh i thlahte nêna ka kumkhaw thuthlung bawhchhiat loh tûr chu a ni.”
  </para>
  <para style="p">
    <verse number="20" style="v" />Arona hnênah Lalpa chuan, “Ro atân ram i nei ve tûr a ni lo va, Israel miten ram an sem ve tûr che a ni hek lo. Kei hi i ro, Israel-te zînga i chanvo chu ka ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Levia chite chu Inbiakna bûk an enkawl hah manah Israel miten sâwma pakhat an pêk hi an chanvo atân ka ruatsak a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tûn chinah chuan Israel-te hi Inbiakna bûk bulah an lo kal tûr a ni tawh lo, thil sual an tipalh ang a, an thi dah ang e. He dân hi in thlahte tân pawh a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israel ramah Levia chite hian in-lo-ram nghet an nei ve tûr a ni lo. Israel miten sâwma pakhat ka hnêna an pêk chu,
  </para>
  <para style="p">
    <verse number="24" style="v" />an tân dah hran a ni; chuvângin alâwm, ‘ram insemnaah chan in nei ve tûr a ni lo’ tia ka sawi ni,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Levia chite chu hrilh rawh: Israel mite hnên aṭanga in dawn, in chan atâna Lalpa ruat aṭanga sâwma pakhat chu Lalpa tân in pe ve tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chu chu hruiha an buh vuakte leh uain khura an uain tling an pe ṭhîn ang bawkin in pe ve ang a, pawmsak in ni ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Israel mite hnên aṭanga sâwma pakhat in dawn, Lalpa hnêna sâwma pakhat in pêk ve chu, puithiam Arona hnênah in pe ve tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />In thil dawn zînga a ṭha berte chu Lalpa tân hlân ve leh zêl rawh u; buh thar leh uain thar anga ngaih a ni ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lo neituin a ṭhen a nei ta angin nangni pawhin in pêk bâng chu in nei ve dâwn nia.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chûng chu Biakbûk enkawl hna in thawh hlawh a ni a, in chhûngte nên in duh duhnaah in ei thei ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ṭha ber Lalpa hnêna in hlan tawh chuan a bâng chu ei mah ula, in tisual lo ve; in hlan loh erawh chuan Israel-te thilpêk thianghlim tibawrhbâng in ni ang a, in thi mai ang,” a ti a.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel-te hnênah Lalpa thupêk hi hrilh rawh u. Bâwngla sen, hmêlhem lo, leileta la chhawr ngai loh, in hnêna rawn kai tûrin hrilh rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Puithiam Eleazara pe sela, ani chuan riahhmun pâwn, daiah a kalpui ang a, a hmuh ngeiah a talhtîr tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Puithiam Eleazaran a thisenah chuan a zungṭang a chiah ang a, Inbiakna bûk kawt lam hawiin vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bâwngla chu a vun te, a sa te, a thisen te leh a ek te nên a hmuh ngeiah a hâltîr tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puithiam chuan sidar thing te, husop te, la sen te a la ang a, bâwngla hâlna meiah chuan a rawh tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puithiam chuan a silhfênte chu a su ang a, a inbual tûr a ni; chumi zawhah riahhmunah a lo lût thei ang; mahse, tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bâwngla hâltu pawh khân a silhfênte chu a su ang a, a inbual tûr a ni: tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi thiang, bawlhhlawh lovin, bâwngla vâp chu a rût khâwm ang a, Israel pungkhâwmho tâna hman tûrin hmun serhah chuan a dah ṭha ang; sual tlenfaina tui theh tûrah phul ṭhin tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Bâwngla vâp rût khâwmtu pawh chuan a silhfên a su ang a, tlai thlengin a bawlhhlawh ang. Hei hi Israel mite leh an zînga hnam dang chêng vete tân kumkhaw dânah neih tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Tu ruang pawh ni se, mitthi ruang rêng rêng khawih chu, ni sarih chhûng an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chu mi chuan a ni thum ni-ah leh a ni sarih ni-ah thenfaina tui khân a inthehtîr tûr a ni; tichuan, a lo thiang tawh ang; a ni thum ni-ah leh a ni sarih ni-ah tuia theh thianghlim a nih loh chuan a bawlhhlawh reng ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tu ruang pawh ni se, mitthi ruang rêng rêng khawih chuan tui hmang hian a intithianghlim tûr a ni; tui hi theh a nih loh chuan a bawlhhlawh a, a bawlhhlawhna chu a la reh lo a ni; Lalpa hmun thianghlim chu a tibawrhbâng a, Israel mite zîng ata ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Bûk chhûngah mi a thihin a chhûnga awmte leh a bula lo lût apiang ni sarih chhûng an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bungbêl te, tuibêlte pawh chhin loh chu ni sarih chhûng a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Indonaa thi ruang te, tâmlaka tlu hlum ruang te, mihring ruh te, thlân te khawih apiang chu ni sarih chhûng an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Chutiang bawlhhlawh chu hetianga then fai tûr a ni: Novin tui luang lai an suak ang a, sual thenna tûr bâwngla vâp kha phul tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi thiangin tuiah chuan husop a chiah ang a, chu chuan bûk te, a chhûnga thil awm zawng zawng te, a chhûnga mi zawng zawng te a theh ang a; chutiang bawkin râl thi ruang te, tlu hlum ruang te, mihring ruh leh thlân khawihtute chu a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi thiang chuan mi bawlhhlawh chu a ni thum ni leh a ni sarih ni-in tui chuan a theh tûr a ni; ani chuan a silhfên a su ang a, a inbual bawk ang a, tlaiah a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chutianga bawlhhlawh chu a inthen fai duh lohva, thenfaina tuia theh a nih loh chuan a bawlhhlawhna chu a reh lo va, Lalpa Hmun Thianghlim a tibawrhbâng a ni a, Israel miten an ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tui theh tûr thehtu pawh chuan a silhfên a su tûr a ni, tui theh tûr khawihtute chu tlai thlengin an bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi bawlhhlawhin a khawih apiang a bawlhhlawh ve a, chu mi bawlhhlawh khawihtu pawh chu tlai thlengin a bawlhhlawh a ni.”
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thla khatnaah chuan Israel mite chu an za-in Zin thlalêr an thleng a. Kades-ah chuan an châm a, Miriami chu a thi a, an phûm ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel mite chuan tui an nei lo va, Mosia leh Arona chu an rawn hual a,
  </para>
  <para style="p">
    <verse number="3" style="v" />Mipui chuan Arona chu an chhâl a, “Kan unaute thih rual khân Biakbûk kawtah khân lo thi ve ila a ṭha zâwk tûr.
  </para>
  <para style="p">
    <verse number="4" style="v" />Engtizia nge kan rante nêna thi mai tûra he thlalêra Lalpa mite hi min hruai luh le?
  </para>
  <para style="p">
    <verse number="5" style="v" />Engah nge Aigupta ram ata hetiang ram ro takah hian min hruai le? Buh chîn theihna tûr pawh a nih loh hi, theipui te, grep te, theibuhfaite han ṭha rual a ni hlei nêm, in tûr takngial pawh tui a awm loh hi,” an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia leh Arona chuan mipui chu an kalsan a, Inbiakna bûk kawngkaah lei siin an kûn a, Lalpa ropuina chu an hmuhah a lo lang a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa chuan an hnênah,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Tiang kha la la, Israel-te chu i u Arona nên ko khâwm rawh u; an hmaah, saw lungpui saw, tui tichhuak tûrin hrilh ang che u; lung aṭang chuan pungkhâwmho leh an rante in tûr tui a lo chhuak mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa thupêk angin Mosia chu a kal a, tiang chu a la a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Arona nên Israel pungkhâwmho chu lungpui bulah chuan a ko khâwm a, Mosia chuan, “Hel hmangte u, in in tûr tui lungpui aṭang hian kan lâk chhuahsak dâwn che u em ni?” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosia chuan a bân a phar a, tiang chuan lungpui chu vawi hnih a vua a, tui a lo chhuak ta hawk hawk a; pungkhâwmho leh an rante chuan an in ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa chuan Mosia leh Arona hnênah, “Min ring lo va, Israel-te hmaah min chawimawi loh avângin ka pêk tûr ramah chuan hêng mite hruai lûttu in ni dâwn lo ve,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel miten Lalpa an chhuahchhalhna hmuna tui hi Meriba tui an vuah ta a ni; anmahni avâng chuan a thianghlimzia a tilang ta a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kades aṭang chuan Edom lal hnênah Mosian palai a tîr a, “In unau Israel-ten hrehawm tam tak an tuar thu in lo hre tawh châwk ang a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Min thlahtute chu Aigupta ramah an pêm lût a, kum tam fe kan awm a, Aigupta mite chuan kan pate nên min tiduhdah hle a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kan mangangin Lalpa kan au va, anin kan aw a lo ngaithla a, Aigupta ram aṭangin min hruai chhuak tûr vântirhkoh a rawn tîr a; ngai teh, in ram chhim tâwp Kades kan lo thleng ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kan ngên a che, in ram hi kalkawngah ka rawn hmang ang e; lovah te, grep hmunahte kan kal lo vang a, in tuikhur pawh kan rawn ṭâwm lo vang che u. Lamlianpuiah kan kal ang a, in ram kan kal pelh hma chu ding lamah emaw, vei lamah emaw kan pêng hauh lo vang,” tiin thu a chah a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Edom lal chuan, “Ka rama in lo luh vaih chuan khandaihin ka bei ang che u,” a lo ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel mite chuan, “Lamlianpuiah kein kan kal ang, kan rante nên in tui kan in chuan a man kan pe ang che u, in pawi kan khawih hauh lo vang,” an tih pawhin
  </para>
  <para style="p">
    <verse number="20" style="v" />Edom lal chuan, “In kal ka phal lo,” a ti tlat a. Anni lo dang tûrin Edom lal chu mi tam fe nên a lo thawk chhuak a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Edom lal chuan an rama an kal tlang a phal tâk loh avâng chuan Israel-te chu an kîr ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Israel fate chu an vaiin an kal leh ta a, Hor tlâng an va thleng a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Edom ramri bul a la ni a, tah chuan Mosia leh Arona hnênah Lalpa chuan,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Israel mite hnêna pêk ka tiam ramah chuan Arona hi a lût ve dâwn lo, in pahnihin Meriba-ah khân ka thupêk in awih loh avâng khân.
  </para>
  <para style="p">
    <verse number="25" style="v" />Arona leh a fapa Eleazara chu Hor tlângah hruai la,
  </para>
  <para style="p">
    <verse number="26" style="v" />chutah chuan Arona puithiam kawr chu hlihsak la, Eleazara hâktîr ang che, Arona chu a thi mai dâwn a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpa thupêk ang chuan Mosia chuan a ti a, mipui hmuhah tlângah chuan an chho va.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosia chuan Arona puithiam kawr chu a hlihsak a, Eleazara chu a hâktîr a. Tlângchhîpah chuan Arona chu a thi ta a; Mosia leh Eleazara chu an lo chhuk a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israel pungkhâwmho chuan Arona thih thu chu an hria a, ni sawmthum an sûn a.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kanan ram chhim lama Kanan mi Arad lal chuan Israel-te chu Atharim lamah an lo kal tih a hriatin a lo bei a, mi ṭhenkhat chu a man a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel-ho chuan Lalpa hnênah thu an intiamkam a. “Hêng mite hi min hnehtîr chuan i tân an khuate lamin kan hlân vek ang a, kan tiboral vek ang,” an ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa chuan a lo hria a, chûng Kanan mite chu a hnehtîr a. Israel-te chuan an that vek a, an khuate pawh chu an tichhe vek a, a hmun hmingah Horma an vuah a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hor tlâng aṭang chuan an kal zêl a, Edom ram hêlna, Tuipui Sen kawng lamah chuan an kal a, a kawng a kual avângin an ning a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipui chu Pathian leh Mosia lakah an vui a, “Engah kher nge Aigupta ram ata he thlalêra thi mai tûra min hruai chhuah? Chaw a awm si lo, tui lah a awm hek lo, he mana chhang teivet lah hi kan ning hlui tawh si,” an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chuan rûl chuk na tak a tipuang a, Israel mi tam tak chu an chu hlum a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mipui chu Mosia hnênah an lo kal a, “Thil sual kan ti a ni, Lalpa chungah leh i chungah kan vai hian thil dik lo kan ti a ni; rûl tirêm tûr hian Lalpa min ngensak rawh,” an ti a. Mosian mipui chu a ṭawngṭaisak a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chuan Mosia hnênah, “Dârin rûl lem siam la, mi tin hmuh theih tûrin thingtlâwn lêrah khai rawh; rûl chuk apiangin chu chu an en chuan an dam zêl ang,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosia chuan dârin rûl lem a siam a, thingtlâwn lêrah a khai a, rûl chuk apiangin dâr rûl chu an en phawt chuan an dam ta zêl a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel-te chu an kal zêl a. Obot-ah bûk an khuar a; chu hmun chu an chhuahsan a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Moab ram chhak lam thlalêrah Abarim khaw ramah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zered ruamah bûk an khuar leh a,
  </para>
  <para style="p">
    <verse number="13" style="v" />chuta ṭang chuan an insawn leh a, Arnon lui hmâr lamah bûk an khuar leh a; Arnon lui chu Amor ram dep thlenga awm a ni, Amor leh Moab ramri lui a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />He lai ram hi ‘ Lalpa indona’ tih lehkhabu-ah chuan ‘Sufa ruama Vahep khua Arnon ruam te,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ar khaw lama thluang, Moab ri dep ram awihtlân pangpêr,’ tih a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chuta ṭang chuan Beer an tih chu an thleng a; chu hmun chu tuichhunchhuah awmna a ni. Lalpa chuan, “Mipui ko khâwm rawh, tui ka pe dâwn,” a ti a, chu tuichhunchhuah chu a pe a nih kha.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israel-te chuan he hla hi an sa a, ‘Aw tuichhunchhuah, lo chik chhuak teh, Zaiin kan lo awi ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi lian leh hnam hruaitute laih Lal tiang leh talhfiak leka an laih chu,’ tiin. Thlalêr aṭang chuan Matana-ah an insawn a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nahaliel-ah an kal zêl a, Bamot an thleng a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bamot aṭang chuan Moab ram phai, Pisga tlâng ṭhut an thleng a. Chu tlângchhîp aṭang chuan thlalêr chu a lang vek a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel fate chuan Amor lal Sihona hnênah palai an tîr a.
  </para>
  <para style="p">
    <verse number="22" style="v" />“I ramah kan kal tlang ang e, kan rante nên in lovah te, in grep hmunahte kawngpui ata kan pêng lo vang a, in tuichhunchhuah tui pawh kan chawi lo vang, in ram kan pelh hma chu Lamlianpuiah chauh kan kal ang,” an ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sihona chuan Israel-ten an ram an kal tlang chu a lo phal bîk awzâwng lo va, lo dang tûrin a mite a khâwm a, thlalêr Jahaz hmunah a lo kal a, Israel-te chu a lo bei a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Israel-te chuan an lo that ṭeuh va, an ram hmâr lam, Arnon lui aṭanga Jabok lui thlengin an neihsak ta a. Jabok hmâr lam chu Amon mite ram a ni; anni chuan an ramri chu an lo vêng hneh hle a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel-te chuan Amor-ho khawpuite chu an la vek a; khawpuiahte chuan Israel-te chu an awm ta a. Hesbon leh a chhehvêl khuate pawh an luahsak vek a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hesbon chu Amor lal Sihona khawpui a ni. Tûn hmain Moab lal nên an inbei a, Arnon lui thlengin Moab ram chu a lo chhuhsak tawh a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chuvângin, hetiangin hla an phuah a: Sihona khawpui Hesbon-ah lo kal ula, I din ṭhain i sa ṭha leh ang u;
  </para>
  <para style="p">
    <verse number="28" style="v" />Hesbon aṭangin mei a chhuak a, Sihona khawpui chu a kâng a, Moab ram Ar khua a kai a, Arnon lui hmârthlang ramte chu a kâng fai e.
  </para>
  <para style="p">
    <verse number="29" style="v" />Moab mite tak chu aw! Khemosa betute chu an chhe zo ta, A betute chu an râltlân a; A fanute chu salah an man, Amor lal Sihona hote chuan.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hesbon chu a chhe ta, Dibon thlengin thalin kan kâp; Nofa thlengin kan tiram, Medeba bula awm chu.
  </para>
  <para style="p">
    <verse number="31" style="v" />Israel-te chu Amor ramah chuan an awm ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jazer khaw beih dân tûr en thlithlai tûrin Mosian mi a tîr a. Israel-te chuan a chhehvêl khuate nên an la a, chûng khuaa awm Amor mite chu an hnawt chhuak vek a.
  </para>
  <para style="p">
    <verse number="33" style="v" />An lo kual a, Basan lal Oga chuan lo dan a tum a, a mite a pun ṭeuh va. Edrei hmunah Israel-te chu a va bei a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lalpa chuan Mosia hnênah, “Ani chu hlau suh, a mi zawng zawngte leh a ram chu i kutah ka pe tawh a che; Hesbon khaw lal Sihona chunga i tih ang khân a chungah pawh ti ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tichuan, ani chu a fate nên an that a, a mite pawh bâng awm miah lovin an tihlum a, a ram chu an neihsak ta a.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel mite chu an insawn zêl a, Moab ram phai, Jordan lui chhak lam Jeriko zâwnah bûk an khuar ta a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zipora fapa Balaka chuan Amor mite chunga Israel-te thil tih chu a hmu a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel mite chu an tam êm avângin Moab mite chuan an hlau hle a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moab-ho chuan Midian hotute hnênah, “Bâwngin hnim a pet duak duak ang hian hêng mite hian kan chhehvêl mi zawng zawng hi min ei zo vek dâwn alâwm,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutih laia Moab lal chu Zipora fapa Balaka a ni. Eufretis lui kama Pethor khua, a laichînte awmna rama awm, Beora fapa Balaama ko tûrin mi a tîr a.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Aigupta ram aṭangin mi tam deuh an lo chhuak a, ram an dâp a ni ngawt mai. Kan ram min chhuhsak vek dâwn alâwm; khawngaih takin lo kal la, hêng mite hi ngam rual an ni si lo va, ânchhia min lawhsak teh, kan ngamin kan ram ata kan ûm bo thei mial mahna, mal i sâwmsakte chu an nihlawh ṭhîn a, ânchhia i lawhte chu an chan a chhe ṭhîn tih ka hre si a,” ti tûrin a tîr a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Moab upate leh Midian upate chu aien man tûr kengin an kal ta a. Balaama hnên an thleng a, Balaka thu chu an hrilh a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ani chuan an hnênah, “Zânin chu riak ula, Lalpa thu ka dawng mahna, ka hrilh ang che u,” a ti a. Moab miliante chu Balaama inah chuan an riak ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Balaama hnênah Pathian a lo kal a, “I mikhualte khu tute nge ni?” a rawn ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balaaman Pathian hnênah chuan, “Moab lal Zipora fapa Balaka mi tirhte an ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Aigupta ram aṭangin mi tam deuh an lo chhuak a, ram an dâp a ni ngawt mai; lo kal la, ânchhia mi han lawhsak teh, kan hneh theiin kan ram ata kan ûm bo thei mahna, an rawn ti,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian chuan Balaama hnênah, “Kal suh, chûng mite chu ânchhia i lawh tûr a ni lo, ka mi duhsakte an ni e,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zînga an thawh chuan Balaaman Balaka miliante hnênah, “In ramah haw leh mai rawh u, Lalpa chuan ka kal a phal lo ve,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Moab miliante chu an tho va, Balaka hnênah an kîr a, “Balaama chu a lo kal duh lo,” an ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Balaka chuan mi zahawm zâwk mi dang a tirh belh leh a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Balaama hnên an lo thleng a, “Zipora fapa Balaka chuan heti hian a ti.
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Eng mahin ka hnêna i lo kal dâl suh se. Nasa takin ka chawimawi ang chia, i sawi apiang ka ti zêl ang, hêng mite hi ânchhia min lawhsak phawt mai teh’ a ti,” an ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Balaka ṭhuihruaite chu Balaama chuan a chhâng a, “Balaka chuan a in khat tangka leh rangkachak mi pe mah sela, ka Pathian Lalpa thu chu, a tê emaw, a lian emaw, ka bawhchhe thei lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zânin chu riak phawt mai teh u, Lalpa chuan eng nge a sawi ka han ngaichâng ang e,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zânah chuan Pathian chu Balaama hnênah a lo kal a, “Hêng mite hi ko tûr che-a lo kal an nih chuan, zui mai rawh; mahse, ka hrilh che chauh i ti tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zîngah Balaama chu a tho va, a sabengtung a siam a, Moab miliante chu a zui ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />A kal ve tâk mai avâng chuan Pathian chu a thinur hle a, lo dang tûrin Lalpa vântirhkoh chu kawngah a lo ding a. Sabengtung chunga chuang a ni a, a chhiahhlawh pahnihin an zui bawk a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sabengtung chuan Lalpa vântirhkoh khandaih kenga kawnga a ding chu a hmu a; rampalailêngah hêl a tum a; kawnga kîr leh tûrin Balaama chuan a vua a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa vântirhkoh chu grep huanpal leh pal inkârah, kawng laiah a lo ding a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sabengtung chuan Lalpa vântirhkoh chu a hmu a, pal nêkin a kal a, Balaama ke chu palah chuan a nghêng bet a, Balaama chuan a vaw leh a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa vântirhkoh chu a insawn a, kawng zîm lai, inpelh theih hauh lohna laiah chuan a lo ding leh a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sabengtung chuan Lalpa vântirhkoh chu a hmu a, Balaama chu a bawhpui ta ngawt a. Balaama chu a thinur hle a, sabengtung chu a vaw ta ṭhuai ṭhuai a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lalpa chuan sabengtung chu a ṭawngtîr a, “Thil sual eng nge ka tih vawi thum tlawng mi vuak tâk le?” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balaama chuan sabengtung hnênah, “Min pawisa lo êm alâwm, khandaih phei chu keng ila, ka sât hlum hial tawh ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sabengtung chuan Balaama hnênah, “I sabengtung, tûn thleng pawha i chuanna reng ṭhin ka ni a, hetiang hian ka ti ngai em ni?” a ti a. Ani chuan, “Ti ngai lo ve,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa chuan Balaama mit chu a tihvârsak a, khandaih kenga Lalpa vântirhkoh kawnga ding chu a hmu ve ta a, a kûn a, lei siin a bawkkhup ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lalpa vântirhkoh chuan, “Engtizia nge ṭum thum ngawt i sabengtung i vuak le: Ka duh loh anga i kal luih avângin kawnga dang tûr chein ka lo thawk chhuak a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sabengtung chuan min hmu a, ṭum thum min pelh a tum a, pêng ṭhîn lo se ka lo that mai ang che, ani erawh chu ka zuah ang,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Balaama chuan Lalpa vântirhkoh hnênah, “Thil ka tisual a ni e, mi lo dang tûrin kawngah i ding tih ka hre lo a ni; chuvângin, i lâwm loh zâwng ti ka nih chuan ka kîr leh mai ang,” a ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lalpa vântirhkoh chuan Balaama hnênah, “Hêng mite hi zui rawh, i hnêna ka sawi chauh i sawi chhâwng tûr a ni,” a ti a. Tichuan, Balaama chu Balaka miliante rual chuan a kal ve ta zêl a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Balaama a lo kal tih a hriat chuan Balakan an ramri tâwp, Arnon lui kama Ir-Moab khuaah hmuak tûrin a kal a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Balaka chuan, “Ṭhahnemngai takin ka rawn kohtîr che a, engtizia nge i lo kal duh mai loh le? Mi ropui takah ka siam thei lo che em ni?” a ti a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Balaama chuan Balaka hnênah, “Ngai teh, ka lo kal na a, thu dang sawi thei em ka nih? Pathian min sawitîr chauh ka sawi ang,” a ti a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Balaama chu Balaka rual chuan a kal ve ta a, Kiriat-huzot an thleng a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Balaka chu bâwngpate leh berâmtein a inthawi a. Balaama leh a kalpui miliante chu a sa ei atân a sâwm a.
  </para>
  <para style="p">
    <verse number="41" style="v" />A tûkah chuan Balaka chuan Balaama chu a hruai a, Bamot-baal-ah a kalpui a; chuta ṭang chuan Israel mite chu an hmu thei a.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Balaama chuan Balaka hnênah, “Maichâm pasarih mi siamsak teh, bâwngchal pasarih leh berâmchal pasarih han la bawk ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balaama sawi ang chuan Balaka chuan a ti a; an pahnih chuan maichâm tinah bâwngchal leh berâmchal pakhat zêl an hlân a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Balaama chuan Balaka hnênah, “Mi be tûrin Lalpa a lo kal dâwn nge dâwn lo ka va ngaichâng ang e. Hâlral thilhlan hi in lo vil dâwn nia, min hrilh apiang ka hrilh leh ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian chu a lo kal a, Balaama chuan a hnênah, “Maichâm chu ka siam a, bâwngchal pakhat leh berâmchal pakhat pawh ka hlan ta e,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chuan Balaka hnêna sawi tûr Balaama chu a hrilh a. Balaka hnênah chuan a kîr a,
  </para>
  <para style="p">
    <verse number="6" style="v" />a zu thlen chuan Balaka leh Moab miliante chu hâlral thilhlan maichâm bulah chuan an lo la ding reng a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Balaama chuan hetiang hian thu a chham ta a: “Aram tlângram ata Moab lal Balakan min ko va, ‘Jakoba hi ânchhia min lawhsak teh Israela hi min hausak rawh,’ min ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa ânchhe lawh loh keiin engtin nge ânchhia ka lawh theih ang? Lalpa huat loh, engtin nge ka huat theih ang?
  </para>
  <para style="p">
    <verse number="9" style="v" />Anni chu lungpui aṭangin ka hmu pha a, Tlângchhîp aṭangin an lang vek a ni. A hlanga awm tûr hnam an ni a, Hnam dang ang mai an ni lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel thlahte chu ṭiauvaivut anga tam an ni a, Chhiar sên rual an ni lo; Thil dik tih vânga thi ka nih chuan Thlamuang takin a ni ka thih dâwn ni,” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Balaka chuan Balaama hnênah, “Engtizia nge chutianga min tih le? Ka hmêlmate ânchhia lawh tûrin ka pun che a, mal i sâwmsak tâk hlauh mai le?” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ani chuan, “ Lalpa min hrilh ang chiah ka sawi tûr a ni dâwn lâwm ni?” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Balaka chuan, “Ti rawh, hmun dangah i kal teh ang, an vaia i hmuh vek theih lohna hmun, a ṭhen chauh i hmuh theihna tûrah i kal ang; tichuan, ânchhia i lawh ngam ang,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pisga tlângchhîpa Zofim hmunah chuan a hruai a; maichâm pasarih a siam a, bâwngchal leh berâmchal maichâmah chuan a hlân ṭheuh va.
  </para>
  <para style="p">
    <verse number="15" style="v" />Balaka hnênah chuan, “Hâlral thilhlan hi lo vil la, saw laiah sâwn Pathian ka va hmu tâng e,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa chuan Balaama chu a rawn tâwk a, sawi tûr a hrilh a, “Balaka hnênah kîr la, ka hrilh che kha hrilh rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />A hnên a lo thleng a, Moab miliante nên chuan maichâm bulah an la ding reng a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Balaka chuan, “ Lalpan eng nge a lo sawi?” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Balaama chuan hetiang hian a chham a: “Balak, tho la, ngaithla teh, Zipora fapa, ka thu hi bengkhawn teh: Pathian hi daw mai mai ṭhîn mihring ang a ni lo va, Lamlêt leh hni hne hringfa ang a ni hek lo. A sawi tawh chu a ti dâwn lâwm ni? A ṭawng tawh chuan a hlen dâwn lâwm ni?
  </para>
  <para style="p">
    <verse number="20" style="v" />Mal sâwmsak tûrin min tîr a, Mal a sâwm tawh chu keia sût rual em ni?
  </para>
  <para style="p">
    <verse number="21" style="v" />Jakoba hian thil ṭha lo a tawng dâwn lo, Israelan harsatna a tâwk lo vang. Lalpa , an Pathian chuan a awmpui a, Lalah an neih tlat si a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aigupta ram aṭanga hruai chhuaktu Pathian chu An tân vêngtu ṭha tak, selechal ang a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jakoba chu dawi hneh rual a ni lo va, Israela chu ânchhe ngam loh a ni. Miten Israel mite an hmuhin, ‘Pathian hian a va ti mak em!’ an ti ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sakeibaknei zîng tho, Sapêl tûra thawk chhuak, Sa a seh a ei zawha, A thisen a liah fai hma chu Bawk leh ngai lo ang hi a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Balaka chuan Balaama hnênah, “Ânchhia i lawh ngam loh pawhin mal chu sâwmsak lul teh suh,” a ti a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Balaama chuan Balaka chu a chhâng a, “ Lalpa min hrilh ang chiah ka sawi ang tih ka hrilh che kha,” a ti a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Balaka chuan Balaama hnênah, “Ngawi teh, hmun dangah i kal teh ang, chuta ṭang chuan Pathianin hêng mite hi ânchhia i lawh a remti mahna,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peor tlângchhîpah Balaka chuan Balaama chu a hruai a, chuta ṭang chuan thlalêr chu a lang thei vek a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balaama chuan, “Maichâm pasarih mi siamsak leh rawh, bâwngchal pasarih leh berâmchal pasarih pawh han la leh bawk ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Balaka chuan Balaama thu ang chuan a ti a, maichâmah chuan bâwngchal pakhat leh berâmchal pakhat a hlan ta ṭheuh va.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel-te chu Lalpa chuan mal a sâwm duh tlat a ni tih Balaaman a hriat chuan a hma ang khân aien tûrin a kal hrang duh ta lo va. Thlalêr lam chu a thlîr a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel-ten a chi chi-a bûk an inzâr dul chu a hmu a, Pathian thlarau chu a chungah a lo thleng a,
  </para>
  <para style="p">
    <verse number="3" style="v" />hetiang hian a chham ta a: “Beora fapa Balaama thu: Mit tihvâra thu chu,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian thu ngaithlatua thu Engkimtitheia inlârna dawngtu, Tlua, mit vâr taa thu chu:
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Jakob, in puan inte chu a va mawi êm! Aw Israel, in bûkte chu a mawi mang e!
  </para>
  <para style="p">
    <verse number="6" style="v" />Tûm thing tlar ṭhut ang mai, Lui kama huan hring dup; Lalpa phun thingrai hmun chu, Lui kam sidar hmun ang a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ruahtui tam tâwk an dawng ang a, Tui ṭhatna hmunah thlai an chîng ang. An lal chu Agaga aiin a ropui a, A ram chu a ropui hle ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aigupta ram aṭanga hruaichhuaktu Pathian chu An tân ki ṭha tak nei sele ang a ni. A hmêlma, hnamte chu a phîn darh ang a, A thalte chuan a chhun hlum ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sakeibaknei angin chhûnah a bawk a, Tu nge titho ngam ang? Mal sâwmsaktu che chu an nihlawh e, ânchhe lawhtu che chuan ânchhia an dawng ve ang,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balaka chu Balaama chungah chuan a thinur ta hle a, a inhûm ruh a, “Ka hmêlma ânchhe lawh tûrin ka pun che a, vawi thum lai mal i sâwmsak vei maw?” a ti a.
  </para>
  <para style="p">
    <verse number="11" style="v" />“In khaw lamah haw vat rawh, ropui taka chawimawi che ka lo tum a, Lalpa chuan a phalsak lo che a nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Balaama chuan Balaka hnênah, “I mi tirhte hnênah, ‘Balaka chuan a in khat tangka leh rangkachak
  </para>
  <para style="p">
    <verse number="13" style="v" />min pe mah se, Lalpa thu chu a chhia ka tih angin emaw, a ṭha ka tih angin emaw ka tidanglam thei lo, Lalpa min hrilh ang chu ka sawi ang,’ ka tih rêng kha. Ka haw tâng e” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Balaama chuan Balaka hnênah, “En teh, ka chhûngte hnênah ka haw dâwn; ka kal hmain hêng mite hian nakin lawka i mite chunga an thil tih tûr ka hrilh ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Heti hian a chham ta a: “Beora fapa Balaama thu: Mit tihvâra thu chu,
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian thu ngaithlaa thu, Chungnungbera thurûk hriaa thu, Engkimtitheia inlârna dawngtu, Tlua, mit vâr taa thu chu:
  </para>
  <para style="p">
    <verse number="17" style="v" />Ani chu ka hmu, tûnah zawng ni lovin, Ka han en a, a hnaih zawng a hnai lo. Jakoba aṭangin arsi a lo lang ang a, Israela aṭangin lal tiang a lo chawr ang. Moab ram kil tin a hâwl nek ang a, Setha thlahte a vaw hrep ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Edom ram chu a ta tûr a ni a. A hmêlma, Seir-ho chu, a nei ang, Israel chu tu man an ngam lo vang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakoba laka chhuak lal chuan, Khuaa thi bângte chu a nuai bo vang.”
  </para>
  <para style="p">
    <verse number="20" style="v" />Amalek lam a hawi a, hetiang hian a chham a: “Amalek chu hnam ropui tak ni ṭhîn mah se, A tâwpah an chhe hlen ang,” tiin.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ken mite lam a hawi a, hetiang hian a chham a: “In chênna chu him hle mah se, Khâm sângah bu nei mah ula,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ken mite u, in boral ang, Asuria lalin salah a man lawk dâwn a che u,” a ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hetiang hian thu a chham bawk: “Pathian a chêt hunah tu nge dam khawchhuak awm ang?
  </para>
  <para style="p">
    <verse number="24" style="v" />Kitim aṭangin lawngin an lo kal ang a, Asuria te, Eber te an tirethei ang, Anmahni pawh an la boral ang,” tiin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Balaama chu a tho va, a haw ta a; Balaka pawh a haw ta a.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel-te Sitim ruama an awm lai chuan Moab nulate an ngai a,
  </para>
  <para style="p">
    <verse number="2" style="v" />chûng chuan an pathian biakna ruai ṭhehahte an sâwm a, an kîl ve a, milemte chibai an bûk ve ta mai a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel miten Peor-a Baal an be ve ta mai chu Lalpa chuan a haw hle a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosia hnênah, “Israel hruaitu zawng zawng ko la, thu ka pêk che angin hêng mite hi chhûn êngah khai hlum rawh; tichuan, Lalpa thinur na tak chu Israel-te hian an pumpelh dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosian Israel hotute hnênah chuan, “In hote zînga Peor-a Baal be vete kha that vek rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Inbiakna bûk kawngkaa pawiti taka an ṭah lai chuan Mosia leh Israel pungkhâwmho hmuhah, Israel mi pakhatin Moab nula a bûkah a rawn hruai lût a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Arona tupa Finehasa, Eleazara fapa chuan a hmu a, pungkhâwmho zîng aṭang chuan a chhuak a, fei a la a,
  </para>
  <para style="p">
    <verse number="8" style="v" />Moab nula hruaitu, Israel tlangvâl chu, a bûkah a zui lût a, an pahnih chuan an dulah a chhun tlang a. Tichuan, Israel-te zîngah hri lêng chu a tâwp ta a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hri vei avânga thi chu mi sînghnih leh sângli an tling hman a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Eleazara fapa Finehasa chuan ka tân ṭhahnem a ngaih êm avângin kei pawh Israel mite laka ka thinur a dai ta a; chuvângin, ka tiboral vek ta lo a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, a tân leh a thlahte tân inṭhianna thu ka thlung ta e;
  </para>
  <para style="p">
    <verse number="13" style="v" />a thlahte nên ka puithiam an ni kumkhua ang a; ka tân ṭhahnem a ngai êm a, Israel-te an sual avânga thi tûr a chhanhim tâk avâng hian,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel tlangvâl Moab nula avânga thi ta chu Simeona thlah zînga hotu Salua fapa Zimria a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Moab nula chu Midian hnam lal pakhat, Zura fanu, Kusii a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Midian-ho hi bei ula, tu tlâwm dêr rawh u;
  </para>
  <para style="p">
    <verse number="18" style="v" />Peor-ah an bum che u a, hri lên laia an chhun hlum, an lal fanu Kusii hmangin in chungah thil ṭha lo tak an tih kha,” a ti a.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hri lêng a reh chuan Lalpa chuan Mosia leh Arona fapa puithiam Eleazara hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel pungkhâwmho zînga râlkai chin, kum sawmhnih chung lam chu a chhûng chhûnga thliarin chhiar rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tichuan, Mosia leh Eleazara chuan Moab phai, Jeriko zâwn, Jordan lui kamah chuan mipui hnênah,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosia hnêna thupêk ang khân, Israel mi, kum sawmhnih chin chung lam, Aigupta ram aṭanga lo kalte kha chhiar rawh u,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israela fa tîr chu Reubena a ni; Reubena thlahte: Hanoka, Hanok hnam thlahtu; Palua, Palu hnam thlahtu;
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezrona, Hezron hnam thlahtu; Karmia, Karmi hnam thlahtu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hêng hi Reubena thlahte chu an ni, an za-in mi sîngli leh sângthum leh zasarih leh sawmthum an ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Palua hian fapa Eliaba a nei a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliaba hian Nemuela te, Dathana te, Abirama te a nei a. Dathana leh Abirama chu Kora pâwla mite kha an ni. Anniho hi Lalpa lakah an hel a, Mosia leh Arona beitute kha an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lei kakah Kora hovin an tla hlum a, mi dang zahnih leh sawmnga pawh meiin a kan hlum kha. Chu chu Israel-te ṭihkhai atân a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kora fate erawh chu an thi ve lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />A chhûngkua diat diatin Simeona thlahte chu: Nemuela, Nemuel hnam thlahtu; Jamina, Jamin hnam thlahtu; Jakina, Jakin hnam thlahtu;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zera, Zer hnam thlahtu; Saula, Saul hnam thlahtu;
  </para>
  <para style="p">
    <verse number="14" style="v" />hêngho hi Simeona thlahte chu an ni, mi sînghnih leh sânghnih leh zahnih an ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />A chhûngkua diat diatin Gada thlahte chu: Zefona, Zefon hnam thlahtu; Hagia, Hagi hnam thlahtu; Sunia, Suni hnam thlahtu;
  </para>
  <para style="p">
    <verse number="16" style="v" />Oznia, Ozni hnam thlahtu; Eria, Eri hnam thlahtu;
  </para>
  <para style="p">
    <verse number="17" style="v" />Aroda, Arod hnam thlahtu; Arelia, Areli hnam thlahtu.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hêngho hi Gada thlahte chu an ni, mi sîngli leh zanga an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Juda chuan fapa Era leh Onana a nei a; Era leh Onana chu Kanan ramah an thi a.
  </para>
  <para style="p">
    <verse number="20" style="v" />A chhûngkua diat diatin Juda thlahte chu: Sela, Sela hnam thlahtu; Pereza, Perez hnam thlahtu; Zera, Zer hnam thlahtu.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tin, Pereza thlahte chu: Hezrona, Hezron hnam thlahtu; Hamula, Hamul hnam thlahtu.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hêngho hi Juda thlahte chu an ni, mi sîngsarih leh sângruk leh zanga an ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />A chhûngkua diat diatin Isakara thlahte chu: Tola, Tol hnam thlahtu; Pua, Pu hnam thlahtu;
  </para>
  <para style="p">
    <verse number="24" style="v" />Jasuba, Jasub hnam thlahtu; Simrona, Simron hnam thlahtu.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hêngho hi Isakara thlahte chu an ni, mi sîngruk leh sângli leh zathum an ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A chhûngkua diat diatin Zebuluna thlahte chu: Sereda, Sered hnam thlahtu; Elona, Elon hnam thlahtu; Jaleela, Jaleel hnam thlahtu.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hêngho hi Zebuluna thlahte chu an ni, mi sîngruk leh zanga an ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />A chhûngkua diat diatin Josefa thlahte; Josefa chuan fapa Manasea leh Efraima a nei a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasea thlahte: Makira, Makir hnam thlahtu; Makira chuan fapa Gileada a nei, Gilead-ho thlahtu chu.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hêngho hi Gileada thlahte chu an ni: Iezera, Iezer hnam thlahtu; Heleka, Helek hnam thlahtu;
  </para>
  <para style="p">
    <verse number="31" style="v" />Asriela, Asriel hnam thlahtu; Sekema, Sekem hnam thlahtu;
  </para>
  <para style="p">
    <verse number="32" style="v" />Semida, Semid hnam thlahtu; Hefera, Hefer hnam thlahtu.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hefera fapa Zelofehada chuan fapa a nei lo; a fanute chu Malaii te, Novaii te, Hoglaii te, Milkaii te, Tirzaii te an ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hêngho hi Manasea thlahte chu an ni, mi sîngnga leh sânghnih leh zasarih an ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />A chhûngkua diat diatin Efraima thlahte chu: Suthela, Suthel hnam thlahtu; Bekera, Beker hnam thlahtu; Tahana, Tahan hnam thlahtu;
  </para>
  <para style="p">
    <verse number="36" style="v" />Suthela chuan Eran hnam thlahtu fapa Erana a nei a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hêngho hi Efraima thlahte chu an ni, mi sîngthum leh sânghnih leh zanga an ni. Chûng zawng zawng chu Josefa thlahte an ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />A chhûngkua diat diatin Benjamina thlahte chu: Bela, Bel hnam thlahtu; Asbela, Asbel hnam thlahtu; Ahirama, Ahiram hnam thlahtu;
  </para>
  <para style="p">
    <verse number="39" style="v" />Sefufama, Sefufam hnam thlahtu; Hufama, Hufam hnam thlahtu.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tin, Bela hian fapa Arda leh Naamana a nei a. Arda chu Ard hnam thlahtu a ni; Naamana chu Naaman hnam thlahtu a ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hêngho hi Benjamina thlahte chu an ni, mi sîngli leh sângnga leh zaruk an ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />A chhûngkua diat diatin Dana thlahte chu: Suhama, Suham hnam thlahtu;
  </para>
  <para style="p">
    <verse number="43" style="v" />Hêngho hi Dana thlahte chu an ni, mi sîngruk leh sângli leh zali an ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />A chhûngkua diat diatin Asera thlahte chu: Imnaa, Imna hnam thlahtu; Isvia, Isvi hnam thlahtu; Beria, Beri hnam thlahtu;
  </para>
  <para style="p">
    <verse number="45" style="v" />Beria thlahte chu: Hebera, Heber hnam thlahtu; Malkiela, Malkiel hnam thlahtu.
  </para>
  <para style="p">
    <verse number="46" style="v" />Asera fanu chu Seri a ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hêngho hi Asera thlahte chu an ni, mi sîngnga leh sângthum leh zali an ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />A chhûngkua diat diatin Naftalia thlahte: Jazeela, Jazeel hnam thlahtu; Gunia, Guni hnam thlahtu;
  </para>
  <para style="p">
    <verse number="49" style="v" />Jezera, Jezer hnam thlahtu; Silema, Silem hnam thlahtu.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hêngho hi Naftalia thlahte chu an ni, mi sîngli leh sângnga leh zali an ni.
  </para>
  <para style="p">
    <verse number="51" style="v" />Israela thlah chhiar tling chin chu mi nuairuk leh sîngkhat leh zasarih leh sawmthum an ni.
  </para>
  <para style="p">
    <verse number="52" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="53" style="v" />“Ram chu an ro atân a chhûngkua diat diatin, an tam dân athuin sem rawh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Chhûng tam deuh chu ram i pe zau deuh vang a, a tlêm deuh chu i pe zîm deuh dâwn nia, tûna hming ziak hi an tam lam chhûtna tûr a ni.
  </para>
  <para style="p">
    <verse number="55" style="v" />“An thlahtu hmingin an chan tûr ram chu ṭhumvâwra sem tûr a ni.
  </para>
  <para style="p">
    <verse number="56" style="v" />A hnam tam deuh leh tlêm deuh athuin ram chu ṭhumvâwra sem tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="57" style="v" />A chhûngkua diat diatin Levia chia chhiarte chu hêng hi an ni: Gersona, Gerson hnam thlahtu; Kohata, Kohat hnam thlahtu; Meraria, Merari hnam thlahtu.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hêng chite pawh hi Levia thlahte an ni: Libna chi te, Hebron chi te, Mahlia chite, Musia chi te, Kora chi te. Tin, Kohata khân fapa Amrama a nei a.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amrama nupui Jokebedi chu Levia thlah, Aigupta rama piang a ni; ani chuan Arona te, Mosia te leh an farnu Miriami te chu Amrama a hrinsak a.
  </para>
  <para style="p">
    <verse number="60" style="v" />Arona chuan fapa Nadaba te, Abihua te, Eleazara te, Ithamara te a nei a.
  </para>
  <para style="p">
    <verse number="61" style="v" />Nadaba leh Abihua hian hman thiang lo mei, rimtui hâl nân an hmang a, an thih phah a nih kha.
  </para>
  <para style="p">
    <verse number="62" style="v" />Levia thlahte hi mipa, thla khat chin chung lam an chhiar chin chu: mi sînghnih leh sângthum an ni; Israel hnam zîngah ro atân ram sem ve an nih loh avângin an hming hi Israel khawchhiarbu-a telh ve loh a ni.
  </para>
  <para style="p">
    <verse number="63" style="v" />Moab ram, Jeriko khaw zâwn, Jordan chhak lam lui kama an awm laia Mosia leh puithiam Eleazaran Israel-te an chhiar khân khiti zât khi an ni.
  </para>
  <para style="p">
    <verse number="64" style="v" />Sinai thlalêra Mosia leh puithiam Aronan Israel mi an chhiarte kha dam an awm tawh lo.
  </para>
  <para style="p">
    <verse number="65" style="v" />Lalpa chuan, ‘Thlalêrah an thi ngei ang,’ tia a sawi ang khân Jefunea fapa Kaleba leh Nuna fapa Josua chauh lo chu tu mah dam an awm tawh lo.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Josefa thlah, Manasea chuan fapa Makira a nei a; chu mi fa chu Gileada a ni; Gileada chuan fapa Hefera a nei a, chu mi fa Zelofehada chuan fanu hêngte hi a nei: Malaii te, Novaii te, Hoglaii te, Milkaii te, Tirzaii te.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anni chu Inbiakna bûk kawngkaah Mosia te, puithiam Eleazara te, hruaitute leh pungkhâwmho hmaah an lo kal a.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Kan pa chu Kora ho, Lalpa laka helte zîngah khân a tel ve lo va; mahse, thlalêrah a thi ta a, fapa a nei lo va, ama sual vânga thi a ni a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Fapa a neih loh avângin kan pa hming hi chhungkaw chhiarna zîngah a bo bîk tûr em ni? Kan pa chhûngte zîngah chanvo atân ram min pe ve rawh u,” an rawn ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosia chuan chu thu chu Lalpa hnênah a thlen a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zelofehada fanute thu hi a dik e, an pa unaute zîngah chanvo tûr ram in pe ve tûr a ni; an pa chan ai chu chang rawh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel-te chu hrilh rawh: Mi fapa nei lovin thi sela, a ram chu a fanuin a chang tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Fanu a neih loh chuan a unauten an nei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Unau a neih loh chuan a pamiten an chang ang;
  </para>
  <para style="p">
    <verse number="11" style="v" />pami a neih loh chuan a laichîn chhûng hnaiin a chang ang a, a nei hlen ang. Mosia hnêna Lalpa thupêk angin he dân hi Israel-te tân dân nghet a ni ang,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa chuan Mosia hnênah: “Abarim tlângah chho la, Israel mite ka pêk tûr ram chu thlîr rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />I thlîr zawhah i u Arona ang khân i chipuite hnênah hruai i ni ve ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zin thlalêrah, ka thupêk ang chiaha in tih loh avâng leh ka chunga Israel pungkhâwmho Meriba hmuna an vui khân, in pahnihin, an hmuhah min chawimawi lo a nih kha. Meriba tui hi Zin thlalêr, Kades bula awm kha a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosia chuan Lalpa hnênah,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Mi zawng zawng nunna petu Lalpa chuan Israel pungkhâwmho hruaitu tûr mi ruat teh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ani chuan an hma hruaiin an hnung dâl ṭhîn sela, Lalpa mi, Israel pungkhâwmho hi vêngtu nei lo berâm ang mai ni suh se,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpa chuan Mosia hnênah, “Nuna fapa Josua, pa rilru nei tak chu hruai la, a lu-ah i kut nghat ang che.
  </para>
  <para style="p">
    <verse number="19" style="v" />Puithiam Eleazara hnênah hruai la, a hmaah leh Israel pungkhâwmho hmaah, an hma ngeiah, i aiawhtuah ruat rawh.
  </para>
  <para style="p">
    <verse number="20" style="v" />I thuneihna chu hlân rawh; tichuan, Israel mi, pungkhâwmho chuan a thu an zâwm dâwn nia.
  </para>
  <para style="p">
    <verse number="21" style="v" />Urim leh Thumim hmanga Pathian râwn hi puithiam Eleazara tih tûr a ni ang a; a thu ngaichângin Josua chuan Israel pungkhâwmho chu bûk khuar tûrin emaw, insawn tûrin emaw a hrilh ṭhîn ang,” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa thupêk ang chuan Mosia chuan a ti a, Josua chu puithiam Eleazara leh Israel pungkhâwmho hmaah a dintîr a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa thupêk ang chuan Josua lu-ah Mosia chuan a kut a nghat a, a aiawhtu atân a ruat ta a.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh: a hun ruat takah Pathian hnêna buhbâl thilhlante chu hlan ṭhin tûr a ni, a lâwmzâwng tak chu hlân ṭhîn rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Buhbâl thilhlan, Lalpa hnêna hlan ṭhin tûr chu hetiang hi a ni: Ni tin hâl ral atân berâmno a pa pahnih, kum khat vêla upa, hmêlhem lo hâlral thilhlan hlan tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Berâm pakhat chu zîngah hlân ula, pakhat chu tlaiah.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pakhat rual chuan buhbâl thilhlanah chhangphut ṭha chi kg. khat, oliv hriak thlit fîm litar khat nêna pawlh hlan tel tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hei hi Sinai tlâng ata ni tina hâl ral vek tûra an buhbâl thilhlan ṭhin chu a ni; chu chu Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Berâm pakhat hlan rualin in tûr thilhlan uain litar khat maichâmah bun ṭhin tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tlaiah berâm pakhat pawh chu, zîng lama mi ang chiah khân hlan tûr a ni, in tûr thilhlan uain nên. Hei hi ei tûr thilhlan, Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Sabat ni chuan berâmno a pa pahnih, kum khat vêla upa, hmêlhem lo te, buhbâl thilhlan, chhangphut ṭha chi kg. hnih, Oliv hriak nêna chawhpawlh te, uain thilhlante hlan tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sabat ni apiangin hâlral thilhlan pangngai bâkah he hâlral thilhlan hi uain nên hlan ṭhin tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Thla thar ni apiangin Lalpa hnêna hâlral thilhlanah hêngte hi han keng ṭhîn ang che u: bâwngtuai pahnih, berâmchal pakhat, berâmno a pa pasarih, kum khat vêla upa, hmêlhem lo vek.
  </para>
  <para style="p">
    <verse number="12" style="v" />Buhbâl thilhlanah chhangphut ṭha chi oliv hriak nêna pawlh in rawn hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bâwngtuai pakhatah chhangphut kg. thum, berâmchal pakhatah kg. hnih; berâmno pakhatah kg. khat; hêng hâlral leh buhbâl thilhlante hi Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />In tûr thilhlan chu bâwngtuai pakhatah uain litar hnih, berâmchal pakhatah litar khat telh zêl tûr a ni. Hei hi kum tluanin thla thar ni apianga hâlral thilhlana hlan ṭhin tûr chu a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni tina in tûr thilhlan uain nên hâlral thilhlan in hlan ṭhin bâkah sual thawina thilhlan atân Lalpa hnênah kêlpa pakhat in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />“ Lalpa chawimawi nân Kalhlên kût chu thla hmasa ber, ni sâwm leh pali niin hmang ṭhîn ang che u.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ni sâwm leh panga niin kûtpui chu ṭan a ni ang a, ni sarih chhûng chhang dawidim telh loh chauh ei tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni hmasa berah chuan inkhâwmpui urhsûn in nei tûr a ni, in hna pangngai in thawk hauh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ei tûr thilhlan atân bâwngtuai pahnih, berâmchal pakhat, berâmno a pa pasarih, kum khat vêla upa, hmêlhem lo vek in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hêng rual hian buhbâl thilhlan bâwngtuai pakhatah kg. hnih,
  </para>
  <para style="p">
    <verse number="21" style="v" />berâmno pakhat zêlah kg. khat hlan tel bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sual thawina thilhlanah kêlpa pakhat hlân ula, chutiangin in sual chu thian fai ṭhîn ang che u.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hêng hi tûk tin thil hlan ṭhin bâka hlan tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutiangin ni sarih chhûng chu Lalpa hnênah ei tûr thilhlan hi hlan ziah tûr a ni; chu chu Lalpa lâwmzâwng tak chu a ni. Ni tin hâlral leh in tûr thilhlan ṭhin bâkah hêng hi hlan tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />A ni sarih ni chuan inkhâwmpui urhsûn nei leh ula, mahni hna pangngai in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />“In barli thar, buhbâl thilhlana Lalpa hnêna in rawn hlan hun, Chawlhkâr Kûtah pawh inkhâwmpui urhsûn, in nei tûr a ni: in hna pangngai in thawk hauh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hâlral thilhlanah bâwngtuai pahnih, berâmchal pakhat, kum khat vêla upa berâmno a pa pasarih, hmêlhem lo vek, hlân ang che u; chu chu Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Buhbâl thilhlanah chhangphut ṭha chi, oliv hriak pawlh, bâwngtuai pakhatah kg. thum, berâmchal pakhatah kg. khat leh a chanve,
  </para>
  <para style="p">
    <verse number="29" style="v" />berâmno pakhatah kg. khat hlan tel zêl tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sual thawina thilhlanah kêlpa pakhat hlân bawk ang che u, chutiang chuan mipui sual in thian fai dâwn nia.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ni tina hâlral thilhlan bâkah hêng hi uain thilhlan nên in hlân ṭhîn tûr a ni.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Thla sarihna, ni khat ni chuan, inkhâwmpui urhsûn nei ang che u. In hna pangngai in thawk tûr a ni lo. Hemi ni hian tawtawrâwt in hâm ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hâlral thilhlanah bâwngtuai pakhat, berâmchal pakhat, berâm a pa pasarih, kum khat vêla upa, hmêlhem lo vek hlân ang che u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Buhbâl thilhlanah chhangphut ṭha chi oliv hriak nêna pawlh, bâwngtuai pakhatah kg. thum, berâmchal pakhatah kg. hnih,
  </para>
  <para style="p">
    <verse number="4" style="v" />berâmno pakhatah kg. khat hlân tel bawk ang che u.
  </para>
  <para style="p">
    <verse number="5" style="v" />In sual thawina tûr kêlpa, sual thawina thilhlanah hlân ang che u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chûng chu thla thar hâlral leh buhbâl thilhlan ṭhin leh ni tina hâlral leh buhbâl thilhlan ṭhin leh a dân tûr anga in tûr uain hlan ṭhinte bâka hlan tûr a ni. Chûng chu meia thilhlan, Lalpa tâna rimtui a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Thla sarihna, ni sâwm ni chuan inkhâwmpui urhsûn in nei tûr a ni; chaw nghei ula, in hna pangngai thawk suh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa hnênah hâlral thilhlanah bâwngtuai pakhat, berâmchal pakhat, berâmno a pa pasarih, kum khat vêla upa, hmêlhem lo vek, hlân ang che u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Buhbâl thilhlanah chhangphut ṭha chi oliv hriak nêna pawlh, bâwngtuai pakhatah kg. thum, berâmchal pakhatah kg. hnih,
  </para>
  <para style="p">
    <verse number="10" style="v" />berâmno pakhatah kg. khat hlân bawk ang che u.
  </para>
  <para style="p">
    <verse number="11" style="v" />In sual thawina tûr kêlpa, sual thawina thilhlanah in hlân bawk tûr a ni; mipui sual thenfaina tûr kêlpa hlan ṭhin bâkah leh ni tin hâlral thilhlan, buhbâl leh in tûr thilhlan ṭhin bâkah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Thla sarihna, ni sâwm leh ni nga ni chuan inkhâwmpui urhsûn nei ṭhîn rawh u; in hna pangngai in thawk tûr a ni lo, ni sarih chhûng chu Lalpa chawimawiin kût in hmang tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />A ni khat ni chuan hâlral thilhlanah bâwngtuai sâwm leh pathum, berâmchal pahnih, kum khat vêla upa berâmno a pa sâwm leh pali, hmêlhem lo vek, Lalpa lâwmzâwng tak chu in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chûng rual chuan buhbâl thilhlanah chhangphut ṭha chi, Oliv hriak pawlh, bâwngtuai pakhatah kg. thum,
  </para>
  <para style="p">
    <verse number="15" style="v" />berâmchal pakhatah kg. hnih, berâmno pakhatah kg. khat in hlân tel bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sual thawina thilhlanah kêlpa pakhat pawh in hlân tûr a ni. Ni tina hâlral leh buhbâl thil hlan ṭhin, in tûr thil hlan nên tiam lovin in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />A ni hnih ni chuan hâlral thilhlanah bâwngtuai sâwm leh pahnih, berâmchal pahnih, berâmno a pa sâwm leh pali, kum khat vêla upa, hmêlhem lo vek, Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bâwng tuai te, berâmchal te leh berâmno rual chuan buhbâl thilhlan tûr tuk zât chhangphut ṭha chi, oliv hriak pawlh in hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni tina hâlral leh buhbâl thilhlan leh in tûr thilhlan bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />“A ni thum ni chuan hâlral thilhlanah bâwngtuai sâwm leh pakhat, berâmchal pahnih, berâmno a pa sâwm leh pali, kum khat vêla upa, hmêlhem lo vek, Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bâwngtuai te, berâmchal te, leh berâmno rual chuan buhbâl thilhlan tûr tuk zât chhangphut ṭha chi, oliv hriak pawlh in hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni tina hâlral leh buhbâl thilhlan leh in tûr thilhlan ṭhin bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />“A ni li ni chuan hâlral thilhlanah bâwngtuai sâwm, berâmchal pahnih, berâmno a pa sâwm leh pali, kum khat vêla upa, hmêlhem lo vek, Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bâwngtuai te, berâmchal te leh berâmno rual chuan buhbâl thilhlan tûr tuk zât chhangphut ṭha chi, oliv hriak pawlh in hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni tina hâlral leh buhbâl thilhlan leh in tûr thilhlan ṭhin bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />“A ni nga ni chuan hâlral thilhlanah bâwngtuai pakua, berâmchal pahnih, berâmno a pa sâwm leh pali, kum khat vêla upa, hmêlhem lo vek, Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bâwngtuai te, berâmchal te leh berâmno rual chuan buhbâl thilhlan tûr tuk zât chhangphut ṭha chi, oliv hriak pawlh in hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ni tina hâlral leh buhbâl thilhlan leh in tûr thilhlan ṭhin bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />“A ni ruk ni chuan hâlral thilhlanah bâwngtuai pariat, berâmchal pahnih, berâmno a pa sâwm leh pali, kum khat vêla upa, hmêlhem lo vek, Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Bâwngtuai te, berâmchal te leh berâmno rual chuan buhbâl thilhlan tûr tuk zât chhangphut ṭha chi, oliv hriak pawlh in hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ni tina hâlral leh buhbâl thilhlan leh in tûr thilhlan ṭhin bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Ni sarih ni chuan hâlral thilhlanah bâwngtuai pasarih, berâmchal pahnih, berâmno a pa sâwm leh pali, kum khat vêla upa, hmêlhem lo vek, Lalpa hnênah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bâwngtuai te, berâmchal te leh berâmno rual chuan buhbâl thilhlan tûr tuk zât chhangphut ṭha chi oliv hriak pawlh in hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ni tin hâlral leh buhbâl thilhlan leh in tûr thilhlan bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />“A ni riat ni chuan inkhâwmpui urhsûn in nei leh ang a, in hna pangngai in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hâlral thilhlanah bâwngchal pakhat, berâmchal pakhat, berâmno a pa pasarih, kum khat vêla upa, hmêlhem lo vek, Lalpa lâwmzâwng tak chu in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Bâwngchal te, berâmchal te, berâmno te chu buhbâl thilhlan leh in tûr thilhlan, ran chi hrang hrang pakhat ruala telh tûr tuk zât in hlân tel zêl bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ni tina hâlral leh buhbâl leh in tûr thilhlan ṭhin bâkah sual thawina thilhlanah kêlpa in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Intiamkam hlen thilhlan te, mahni duh thu-a thilhlan te, hâlral thilhlan te, buhbâl thilhlan te, in tûr thilhlan te, remna thilhlan te in hlan ṭhin bâkah khîng khi in hlân ngei tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Lalpa thupêk zawng zawng chu Mosian Israel-te chu a hrilh a.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosia chuan Israel hnam hruaitute hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Miin Lalpa hminga thil eng emaw a hnêna pêk a intiamkamin emaw, thil eng emaw ti lo tûra a intiamkamin emaw a thu chu a bawhchhe tûr a ni lo, a sawi ang chuan a hlen ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Nula pate ina la awm pawhin Lalpa hnênah eng emaw pêk intiamkamin emaw, eng emaw ti lo tûra a intiamkamin emaw,
  </para>
  <para style="p">
    <verse number="4" style="v" />a pain a lo hriata, a ngawihsan mai chuan a thu chu a hlen ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pain a thu chu hlen a phalsak loh tlat chuan, a fihlîm mai ang. A pain a thutiam hlen a phalsak loh avângin Lalpa chuan a ngaihhnathiam ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Hmeichhia pasal nei lovin tum lui rânin emaw, ngaihtuah chiang mang lovin emaw, thil eng emaw pêk intiamkamin emaw, thil eng eng emaw ti lo tûra intiamkam chungin emaw pasal nei ta sela,
  </para>
  <para style="p">
    <verse number="7" style="v" />a pasalin a hriata, a ngawihsan mai chuan, a thu chu a hlen ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pasalin a hriata, hlen a phalsak loh chuan a intiamkamna ata chu a fihlîm ang. Lalpa chuan a ngaihhnathiam ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Hmeithaite leh mâkchhiat tâwkte erawh chuan pêk an tiam chu an pe tûr a ni a, ti lo tûra an tiam chu an ti lo tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Pasal nei laiin eng emaw pêk te, eng emaw ti lo tûr tein intiamkam sela,
  </para>
  <para style="p">
    <verse number="11" style="v" />a pasalin a hriata a hnial loh chuan a thu chu a hlen vek tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pasalin a hriata, a khapsak chuan a fihlîm mai ang. A pasalin a thutiam chu a khapsak tlat avângin Lalpa chuan a ngaihhnathiam ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmeichhiain thil pêk, tih loh tûr emaw, intiamkamna a neih rêng rêng chu a pasalin a phalin a phal lo thei a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pasalin a intiamkam tih a hriat ni ngeia a hnial loh chuan pêk a tiam emaw, tih loh a tiam emaw chu a hlân ngei tûr a ni, a pasalin a intiamkamna thu a nemnghehsak tihna a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />A hnu deuhvah a pasalin a intiamna chu a sûtsak chuan a hlen loh mawh chu a pasal chuan a phur ang.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Hei hi pasal nei lo, pate ina la awm emaw, pasal nei laiin emaw intiamkamna an neiha tih dân tûr Lalpan Mosia a hrilh chu a ni.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel-te phuba chu Midian-ho chungah la zet la, i laichînte hnêna hruai i ni dâwn nia,” a ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosia chuan mipui hnênah, “Midian-ho do tûrin râlthuam inbel rawh u; Midian-ho chungah Lalpa phuba in la tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel hnam tin aṭangin mi sâng ṭheuh, indonaa kal tûr, indâwk chhuak rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Israel hnam tin aṭangin mi sâng ṭheuh an indâwk chhuak a, an vaiin sîngkhat leh sânghnih an ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Indonaa kal tûr chuan hnam tin zînga mi sâng dawh chhuah chu puithiam Eleazara fapa Finehasa hovin indo tûr chuan a tîr ta a, bungbêl thianghlimte leh tawtawrâwt ham tûr chu an keng a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosia hnênah Lalpa sawi ang khân Midian-ho chu an bei a, mipa zawng zawng an that a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi dang rualin Midian lal panga Evia te, Rekema te, Zura te, Hura te, Reba te pawh hi an that a, Beora fapa Balaama pawh indonaah chuan an that a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel mite chuan Midian hmeichhiate chu an fate nên an man a, an bâwng te, berâm leh kêl rualte leh an thil neih dang pawh an lâksak vek a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chûng rama an chênna khuate leh an bûkte chu an hâlsak vek bawk a.
  </para>
  <para style="p">
    <verse number="11" style="v" />An thil lâk leh man, mihring leh ran nên, an kawi vek a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosia te, puithiam Eleazara te leh Israel pungkhâwmho hnênah, an riahhmun Moab phaizâwl Jeriko zâwn Jordan lui kamah chuan an rawn hâwn a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosia te, puithiam Eleazara te leh Israel pungkhâwmho te chu riahhmun pâwnah anni chu hmuak tûrin an lo chhuak a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Indona aṭanga lo haw sipai sâng hotute leh za hotute chungah Mosia chu a thin a ur ta hle a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosia chuan an hnênah, “Hêng hmeichhiate hi engati nge in la zuah?
  </para>
  <para style="p">
    <verse number="16" style="v" />Balaama fuihpawrhin Peor-ah khân Israel mite chu Lalpa lakah thil sual a tihtîr a nih kha.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mipa tawh phawt chu, naupang tê pawh that vek ula, hmeichhia pawh mipa pâwl tham tawhho zawng chu that vek rawh u.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmeichhe naupang, mipa la pâwl tham lohho kha erawh chu zuah ula, nei mai rawh u.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi that leh mitthi ruang khawih zawng zawng chu riahhmun pâwnah riak rawh u; ni thum ni-ah leh ni sarih ni-ah in mi mante nên inthianfai ang che u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Silhfên te, savuna siam thil rêng rêng te, kêl hmula siam zawng zawng te, thinga siam zawng zawngte nên tihthianghlim zet tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Puithiam Eleazara chuan indonaa kalte hnênah, “Mosia hnêna Lalpa thupêk chu hei hi a ni:
  </para>
  <para style="p">
    <verse number="22" style="v" />Rangkachak te, tangkarua te, dar te, thîr te, ṭin te, suan te,
  </para>
  <para style="p">
    <verse number="23" style="v" />meia rawha chhe mai thei lo chu meiah in rawh ang a, a thianghlim ang, tlenfaina tui erawh chu theh tûr a ni. Meia rawh theih loh chu sil tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />In silhfênte pawh a ni sarih niin in su ang a, in thianghlim ang a, chumi hnuah riahhmunah in lo lût thei ang,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nang nên, Puithiam Eleazara nên, Israel pungkhâwmho hruaitute nên râllâk thil an rawn hawn, mihring leh ran te chu chhiar ula,
  </para>
  <para style="p">
    <verse number="27" style="v" />inzâtin hmun hnihah ṭhen phawk ula, ṭhen khat chu indonaa kalte pe ang che u; a dang chu Israel pungkhâwmho hnênah pe ang che u.
  </para>
  <para style="p">
    <verse number="28" style="v" />Indonaa kalhote chan aṭangin mihring te, bâwng te, sabengtung te, berâm leh kêl te, zanga zêlah pakhat Lalpa tân lâksak la,
  </para>
  <para style="p">
    <verse number="29" style="v" />Lalpa tâna serh hran chu Eleazara pe ang che.
  </para>
  <para style="p">
    <verse number="30" style="v" />A zâtve, Israel pungkhâwmho chan aṭang chuan mihring te, bâwng te, sabengtung te, berâm leh kêl te, sawmngaa pakhat zêl lâksak la, Lalpa biakbûk enkawltu Levia chite pe ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa thu ang chuan Mosia leh puithiam Eleazara chuan an ti a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Anmahni puala an thil lâk chhiar lovin indonaa kalte thil rawn hawn chu heti zât hi a ni: Berâm leh kêl nuairuk leh sîngsarih leh sângnga;
  </para>
  <para style="p">
    <verse number="33" style="v" />bâwng sîngsarih leh sânghnih,
  </para>
  <para style="p">
    <verse number="34" style="v" />sabengtung sîngruk leh sângkhat,
  </para>
  <para style="p">
    <verse number="35" style="v" />hmeichhe naupang mipa la pâwl loh sîngthum leh sânghnih;
  </para>
  <para style="p">
    <verse number="36" style="v" />a zâtve indonaa kalte chan chu berâm leh kêl nuaithum leh sîngthum leh sângsarih leh zanga a ni;
  </para>
  <para style="p">
    <verse number="37" style="v" />Lalpa tâna lâk chu zaruk leh sawmsarih leh panga a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Bâwng chu sîngthum leh sângruk a ni a, Lalpa tâna lâk chu sawmsarih leh pahnih a ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />Sabengtung chu sîngthum leh zanga a ni a, Lalpa tâna lâk chu sawmruk leh pakhat a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hmeichhe naupang chu sîngkhat leh sângkhat an ni, Lalpa tâna lâk chu mi sawmthum leh pahnih an ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lalpa thupêk angin Lalpa tâna serh hran chu puithiam Eleazara chu an pe a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Indonaa kalte thil hawn zâtve,
  </para>
  <para style="p">
    <verse number="43" style="v" />Israel mipuite hnêna Mosian a sem chu kêl leh berâm nuaithum leh sîngthum leh sângsarih leh zanga a ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bâwng chu sîngthum leh sângruk a ni;
  </para>
  <para style="p">
    <verse number="45" style="v" />sabengtung chu sîngthum leh zanga a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Hmeichhe naupang chu sîngkhat leh sângruk an ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel mipuite chan aṭang chuan sawmngaa pakhat zêl, ran pawh mihring pawh a la a; Lalpa Biakbûk enkawltu Levia chite hnênah Lalpa thu ang chuan a pe a.
  </para>
  <para style="p">
    <verse number="48" style="v" />Sipai sâng hotute leh za hotute chu Mosia hnênah an lo kal a,
  </para>
  <para style="p">
    <verse number="49" style="v" />Mosia hnênah, “Kan hote kan han chhiar a, pakhat mah kan inhloh lo.
  </para>
  <para style="p">
    <verse number="50" style="v" />Rangkachaka siam incheina: bânbun te, ngûn te, khaidiat ṭhi te, nemna zungbun te, bengbeh te, kâwnghrên te, mahni pual atâna kan lâkte hi, Lalpa chuan kan nun min vênhimsak manah Lalpa hnênah kan rawn hlân a ni,” an ti a.
  </para>
  <para style="p">
    <verse number="51" style="v" />Mosia leh Eleazara chuan rangkachak chher sa chu an lo dawng a.
  </para>
  <para style="p">
    <verse number="52" style="v" />Sipai hotuten Lalpa hnêna thilpêk an rawn ken rangkachak chu kg. zathum lai a ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />Sipai narânho erawh chuan mahni puala an lâk chu an nei mai a.
  </para>
  <para style="p">
    <verse number="54" style="v" />Mosia leh puithiam Eleazara chuan rangkachak chher sate chu Lalpa chuan a mite a hriat reng theih nân Biakbûkah chuan an dah a.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Reubena leh Gada thlahte chuan kêl leh berâm an ngah hle a. Jazer leh Gilead ram chu ran tlat nâna ṭha tak a ni tih an hmuhin
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosia te, puithiam Eleazara te leh Israel pungkhâwmho hruaitu te hmaah an lo kal a,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Atarot te, Dibon te, Jazer te, Nimra te, Hesbon te, Elealeh te, Sebam te, Nebo te, Beon ram te,
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa min hnehsak ramte hi, ran tlatna chi a ni a, keini lahin ran kan ngah a,
  </para>
  <para style="p">
    <verse number="5" style="v" />rem in tihzâwng a nih chuan Jordan lui râl kai ve lovin he ram hi kan chanvo atân min pe mai teh u” an ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosian Reubena leh Gada thlahte hnênah chuan, “In unauten râl an bei ang a, nangni he laiah in lo ṭhu mai mai bîk ang maw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Engtizia nge Israel mite hi Lalpa ram pêka an kal tûr rilru in tihhnual le?
  </para>
  <para style="p">
    <verse number="8" style="v" />Kades-barnea aṭanga ram en thlithlai tûra mi ka tirh pawh khân in paten mi dang rilru an tihnual a nih kha.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eskol ruam an han thlena ram chu an han hmuh chian khân Lalpa pêk rama kal ngam lo tûrin Israel mite rilru an tizâm a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutah Lalpa chu a thinur ta hle a.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Aigupta ram aṭanga lo chhuak kum sawmhnih aia upaho chuan Abrahama te, Isaka te, Jakoba te hnêna pêk ka tiam ram chu an thleng ve tawp lo vang, mi zui tak tak lo a ni;
  </para>
  <para style="p">
    <verse number="12" style="v" />Keniz mi Jefunea fapa Kaleba leh Nuna fapa Josua-te pahnih chauh hi an thleng ve ang, anni hi chuan min zui tak tak a ni,’ tiin thu a tiam hial a nih kha.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa chu a thinur tâk êm avângin thil ṭha lo titute an thih mang hma chu thlalêrah kum sawmli zet kan vâkvai a nih hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />In pate ang hlauh kha in nih hi, mi sual rual, Israel-te chunga Lalpa thinur tizualtu in nih hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ani chu tûnah in zui duh lo tak tak a nih chuan thlalêrah min hnutchhiah leh ang a, nangni hian Israel mite hi in tihlum vek dâwn a nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosia lam chu an hawi a, “Kan berâm rual tân huang kan siam ang a, kan fanaute awmna tûr kulh nei khua kan din ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keiniho hian hriamhrei kengin kan unau Israel-te hma kan hruai zêl ang a, an awmna tûr hmun chu kan thlen ang. Kan nupui fanaute erawh chu hêng lai mite avângin kulh nei khuaahte chuan lo awm mai rawh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel mi tinin an ram neih tûr an luah hma chu, in lamah kan kîrsan lo vang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jordan lui râl ram chu kan neihpui ve lo vang e, Jordan he lam kamah kan chanvo tûr zawng a awm hi,” an ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosia chuan, “Chutiangin in ti meuh ang maw? Indo peiha Lalpa hmaa hriamhrei in kena,
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpa hmaa Jordan lui kânin hmêlmate a hnawh chhuah hma chu in tel ve zêla,
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpan ram chin a hneh hnua kîr leh chauh tûr in nih chuan, Lalpa leh Israel-te chungah thiam lohna in nei lo vang a, he lai ram hi Lalpa chuan in neih a remti ngei ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />In duh loh erawh chuan Lalpa chungah thil in tisual a ni ang; in sual mawh chu in phur ngei ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />In fanaute tân khawpui kulh neite chu din ula, berâm huangte siam ula, in duh ang chuan ti ta che u,” a ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gada leh Reubena thlahte chuan Mosia hnênah, “Ka pu, i thu ang chuan i chhiahhlawhte hian kan ti ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kan nupui fanau te, kan bâwng te, kan berâm leh kêlte chu Gilead ram khaw kulhahte hian an awm ang a.
  </para>
  <para style="p">
    <verse number="27" style="v" />I chhiahhlawh te, indonaa hriamhrei keng tlâk zawng zawng te hi chuan i thu angin Jordan lui kan kai ve vek ang,” an ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosia chuan puithiam Eleazara te, Nuna fapa Josua te leh Israel hnam hruaitu te chu thu a chah a.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Gada leh Reubena thlah indonaa hriamhrei keng tlâkte hian Lalpa hmaa Jordan an kaipui che ua, ram chu in hnehpui chuan Gilead ram hi an chanvo-ah pe ang che u.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hriamhrei kenga Jordan an kânpui duh loh che u erawh chuan Kanan ramah, in zîngah, chanvo an nei ve mai tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Gada leh Reubena thlahte chuan, “I chhiahhlawhte hnêna Lalpa sawi ang chuan kan ti ang a, Kanan ramah,
  </para>
  <para style="p">
    <verse number="32" style="v" />Lalpa hmaah chuan hriamhrei kan keng ang a, kan ram chanvo ve tûr erawh chu khawchhak lama mi hi ni rawh se,” an ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosia chuan Gada leh Reubena thlahte chu Manasea thlah zâtvete nên Amor lal Sihona leh Basan lal Oga ram chu an khawpui leh a chhehvêl ramte nên chuan a sem a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gada thlahte chuan kulh nei khua - Dibon khua te, Atarot khua te, Aroer khua te,
  </para>
  <para style="p">
    <verse number="35" style="v" />Atrot-sofan khua te, Jazer khua te, Jogbeha khua te,
  </para>
  <para style="p">
    <verse number="36" style="v" />Bethnimra khua te, Beth-haran khaw kulh te chu an din ṭha leh a, berâm huangte pawh an siam a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reubena thlahte chuan Hesbon khua te, Elealeh khua te, Kiriathaim khua te,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nebo khua te, Baal-meon khua te, Sibma khaw kulh te an siam ṭha a, hming an sa thar a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Manasea fa, Makira thlahte chu, Gilead khuaah an kal a, an la a. Chuta awm Amor mite chu an hnawt chhuak a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mosian Gilead khua chu Manasea fa, Makira chu a pe a, chutah chuan a awm ta a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Manasea fa vêk, Jaira chu a thawk chhuak a, a chhehvêl khuate chu a la a, Havot-jair a vuah a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Noba pawh a thawk chhuak a, Kenat leh a chhehvêl khuate chu a la a, ama hming chawiin Noba a vuah a.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosia leh Arona hovin Aigupta ram aṭanga Israel mite, a huhova an kal zêl dân chu hetiang hi a ni:
  </para>
  <para style="p">
    <verse number="2" style="v" />Mosia chuan Lalpa thupêk angin an chhuahna aṭanga an kalna apiang kha a indawtin a ziak zêl a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thla khatna, ni sâwm leh panga niin Rameses aṭangin Israel-te chu Kalhlên Kût tûk khân Aigupta mite hmuh ngeiah anmahni thamlo takin an chhuak hlawm a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aigupta mite lah chu an fa tîr Lalpa tihhlumte kha phûmin an ṭûl a, an pathian pawhin Lalpa chu a ngam lo a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel mite chu Ramases aṭang chuan Sukot-ah an riak a,
  </para>
  <para style="p">
    <verse number="6" style="v" />thlalêr dep Etham-ah an riak leh a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Etham aṭang chuan Baal-zefon ep Pi-hahirot-ah an kual a, Migdol depah bûk an khuar a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pi-hahirot aṭang chuan tuipui an kân a, Etham thlalêrah ni thum an kal a, Mara-ah bûk an khuar a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mara aṭang chuan tuihna sâwm leh pahnih awmna, tûm thing sawmsarih ṭona Elim an thleng a, bûk an khuar a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Elim aṭangin Tuipui Sen kamah an riak a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuta ṭangin Sin thlalêrah bûk an khuar a,
  </para>
  <para style="p">
    <verse number="12" style="v" />Sin thlalêr aṭang chuan Dofka-ah an riak a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Alus-ah an riak leh a,
  </para>
  <para style="p">
    <verse number="14" style="v" />chuta ṭang chuan tui in tûr awm lohna, Refidim-ah bûk an khuar a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Refidim aṭang chuan Sinai thlalêr an thleng a,
  </para>
  <para style="p">
    <verse number="16" style="v" />an kal zêl a, Kibrot-hatava-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hazerot-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chuta ṭangin Ritma-ah an riak a,
  </para>
  <para style="p">
    <verse number="19" style="v" />Rimon-perez-ah an riak leh a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chuta ṭangin Libna-ah bûk an khuar a,
  </para>
  <para style="p">
    <verse number="21" style="v" />Risa-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="22" style="v" />An kal zêl a, Kehela-ah an riak a,
  </para>
  <para style="p">
    <verse number="23" style="v" />Sefer tlângah an riak leh a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chuta ṭangin Harada-ah bûk an khuar a,
  </para>
  <para style="p">
    <verse number="25" style="v" />Mekhelot-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="26" style="v" />An kal zêl a, Tahat-ah an riak a,
  </para>
  <para style="p">
    <verse number="27" style="v" />Tera-ah an riak leh a.
  </para>
  <para style="p">
    <verse number="28" style="v" />An kal zêl a, Mitka-ah an riak a,
  </para>
  <para style="p">
    <verse number="29" style="v" />Hasmona-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="30" style="v" />An kal zêl a, Moserot-ah an riak a,
  </para>
  <para style="p">
    <verse number="31" style="v" />Bene-jaakan-ah an riak leh a,
  </para>
  <para style="p">
    <verse number="32" style="v" />An kal zêl a, Hor-hagidgad-ah bûk an khuar a,
  </para>
  <para style="p">
    <verse number="33" style="v" />Jotbata-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="34" style="v" />An kal zêl a, Abrona-ah an riak a,
  </para>
  <para style="p">
    <verse number="35" style="v" />Ezion-geber-ah an riak leh a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chuta ṭangin Zin thlalêr Kades-ah bûk an khuar a.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kades aṭang chuan Edom ramri Hor tlâng an thleng a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Lalpa thu angin Aigupta ram Israel-ten an chhuahsan aṭangin kum sawmli, thla ngana, ni khat ni chuan he tlângah hian Arona chu a thi ta a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Arona a thih chuan kum za leh sawmhnih leh pathuma upa a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kanan ram chhim lama awmho, Kanan mi, Arad lal chuan Israel mite lo kal thâwm chu a lo hria a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hor tlâng aṭang chuan an kal zêl a, Zalmon-ah bûk an khuar a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Punon-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="43" style="v" />An kal zêl a, Obot-ah an riak a,
  </para>
  <para style="p">
    <verse number="44" style="v" />Moab ramria Iye-abarim hmunah an riak leh a.
  </para>
  <para style="p">
    <verse number="45" style="v" />An kal zêl a, Dibon-gad-ah bûk an khuar a.
  </para>
  <para style="p">
    <verse number="46" style="v" />Almon-diblathaim-ah bûk an khuar leh a.
  </para>
  <para style="p">
    <verse number="47" style="v" />An kal zêl a, Nebo tlâng bul Abarim tlâng an thleng a.
  </para>
  <para style="p">
    <verse number="48" style="v" />Chuta ṭangin Jordan lui kam, Jeriko khaw zâwnah, bûk an khuar ta a.
  </para>
  <para style="p">
    <verse number="49" style="v" />Jordan lui dung, Moab phairuamah chuan Beth-jesimot aṭanga Abel-sitim thlengin an inzâr a.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jordan lui kam Jeriko khaw zâwn, Moab phaiah Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="51" style="v" />“Israel mite chu hrilh rawh: Jordan lui kâna Kanan ram an thlen hun chuan,
  </para>
  <para style="p">
    <verse number="52" style="v" />chuta awmte chu in hnawt chhuak vek ang a, an lung milim te, an phun milim te tihchhiatsak vek tûr a ni; an hmunsângte pawh ṭhiat vek ang che u.
  </para>
  <para style="p">
    <verse number="53" style="v" />Chûng rama chêngte chu hnawt chhuak vek ula, in luahlân tûr a ni, in neih atâna ram ka pêk che u chu a ni.
  </para>
  <para style="p">
    <verse number="54" style="v" />In chhûngkaw tam dân athuin in insem ang. Ṭhumvâwrin sem ula, in chan chu in nei zêl ang, chhûngkaw tam deuh chuan an chang zau deuh vang a, a tlêm deuh chuan an nei zîm deuh vang.
  </para>
  <para style="p">
    <verse number="55" style="v" />Chûnga lo awmte chu in hnawh chhuah vek duh loh chuan in tân hlîng ang an ni ang a, an kâp reng ang che u a, in ramah chuan an tibuai fo dâwn che u a ni.
  </para>
  <para style="p">
    <verse number="56" style="v" />Anni chu hnawh bo daih ka tiam a, in hnawh bo duh loh chuan nangni pawh ka hnawt bo vang che u,” a ti a.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh. Kanan ram in thlen hun chuan in ram atâna ka pêk tûr che u ram chin chu hetiang hi a ni ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chhim lam ri chuan Zin thlalêr aṭangin Edom ram a chhun ang a, khawchhak lam ri chu Tuipui Thi tâwpah a inṭan ang a,
  </para>
  <para style="p">
    <verse number="4" style="v" />chhim zâwngin Akrabim kalkhânah kal tlangin Zin thlalêra Kades-barnea a chhun ang. Hmâr zawngin Hazar-adar thlengin a kal ang a, Azmon a pan ang a,
  </para>
  <para style="p">
    <verse number="5" style="v" />Aigupta ramri luite hawiin a inher ang a, Mediteranean tuipui a chhun ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Khawthlang lam ri chu Mediteranean tuipui a ni ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hmâr lam ramri chu Mediteranean tuipui aṭangin Hor tlâng chhunin a kal ang a,
  </para>
  <para style="p">
    <verse number="8" style="v" />chuta ṭangin Hamath kalkhânah a kal ang a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Zedad leh Zefron kal tlangin Hazar-enan a chhun ang, chu chu hmâr lam ramri chu a ni ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Khawchhak lam ramri chu Hazar-enan aṭangin Sefam-ah a kal ang a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ain chhak lam Ribla panin a chhuk ang a, Galili dîl chhak lam tlâng pangah a chhuk zêl ang a;
  </para>
  <para style="p">
    <verse number="12" style="v" />Jordan luidungah, Tuipui Thi a chhun ang. Ramri hual chhûng ram hi in ram tûr chu a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosia chuan Israel mite chu a hrilh a, “He ram hi a ni in insem tûr ram, hnam kua leh a chanve hnêna Lalpa pêk chu.
  </para>
  <para style="p">
    <verse number="14" style="v" />Reubena leh Gada thlahte leh Manasea thlah zâtve te chuan an chhûngkaw tam dân azirin ram an insem tawh a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Jordan lui, Jeriko zâwn, khawchhak lam ram chu an nei tawh a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Puithiam Eleazara leh Nuna fapa Josua chuan i ai awhin ram chu an sem tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hnam tin aṭangin hruaitu thlang chhuak la, chûng mite chuan sempui rawh se.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chûng mite chu hêngte hi an ni ang: Juda hnamah Jefunea fapa Kaleba;
  </para>
  <para style="p">
    <verse number="20" style="v" />Simeona hnam aṭangin Ammihuda fapa Semuela;
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamina hnam aṭangin Kislona fapa Elidada;
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan hnam aṭangin Joglia fapa hotu Bukia;
  </para>
  <para style="p">
    <verse number="23" style="v" />Josefa thlah Manasea hnam aṭangin Efoda fapa hotu Haniela,
  </para>
  <para style="p">
    <verse number="24" style="v" />Efraim hnam aṭangin Siftana fapa hotu Kemuela;
  </para>
  <para style="p">
    <verse number="25" style="v" />Zebulun hnam aṭangin Parnaka fapa hotu Elizafana;
  </para>
  <para style="p">
    <verse number="26" style="v" />Isakara hnam zîng aṭangin Azana fapa hotu Paltiela,
  </para>
  <para style="p">
    <verse number="27" style="v" />Asera hnam aṭangin Selomia fapa hotu Ahihuda;
  </para>
  <para style="p">
    <verse number="28" style="v" />Naftali hnam aṭangin Amihuda fapa hotu Pedahela,” a ti a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hêng mite hi Lalpa chuan Kanan ram Israel-ten an chan ṭheuh tûra semtu atân a ruat a ni.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jeriko zâwn, Jordan râlah, Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh: an ram chan chhûngah Levia chite tân khaw ṭhenkhat, a chhehvêla ran tlatna tûr nên an pe tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chûng khuate chu Levia chite ta a ni ang a, chutah chuan an awm khâwm tûr a ni. Ran tlatna tûr ramah chuan an bâwng te, kêl te, berâmte an tlattîr tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Levia chite in hleh tûr ram âwl chu khua aṭanga tawng sângkhat thleng tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ram âwl zawng zawng chuan kil li a nei ang a, kil tin tawng sânghnih a ni ang a, a laiah khua chu a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levia chite in pêk khaw ruk chu tualtlânna khuaah hman tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hêng khaw paruk bâkah khaw dang sâwm li leh pahnih, a chhehvêl ram âwl nên, in pe bawk tûr a ni, a vaiin khaw sawmli leh pariat a nih chu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hnam tinin, an ram chan a zau leh zau loh athuin Levia chite awmna tûr khua an siamsak tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel mite chu hrilh rawh: Jordan lui in kaia, Kanan ram in thlen hun chuan,
  </para>
  <para style="p">
    <verse number="11" style="v" />tual that palhte humhimna tûr tualtlân lehna khua ruat ang che u;
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel pungkhâwmhovin an thu an rêl fel hmain chûng khuaahte chuan an tlân ang a, thisen phuba latuin a that mai dâwn lo nia.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutianga tualtlânna tûr khua paruk ruat ang che u,
  </para>
  <para style="p">
    <verse number="14" style="v" />Jordan ral chhak lamah khaw thum in ruat ang a, Kanan ramah khaw thum bawk in ruat dâwn nia, chûng chu tualtlânna khua a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel mi te, ram dang mi te leh in zînga lo pêm te tân hêng khaw rukte hi an tualtlânna tûr a ni, mi that palh chu, tu pawh chutah chuan an tlân thei ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Miin thîr hmanga mi a beiha a tihhlum chuan tual that a tling a, tual that chu tihhlum ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lunga chhu hlum a nih pawhin tual that a ni, tual that chu tihhlum ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Talhtuma vaw hlum a nih chuan tual that a ni, tual that chu tihhlum ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />A laichîn hnai, thisen phuba latu tûr chuan a hmuhna apiangah tualthattu chu a that ve thei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />A huat avângin mi a namthlu chawrh thei a, lo chângruin engin emaw a vawm thei a,
  </para>
  <para style="p">
    <verse number="21" style="v" />an inhuat avângin a hnek chawrh thei bawk a, chutianga mi a tih chu a thih chuan tual a that a ni: tual that chu tihhlum ngei tûr a ni; thisen phuba latu chuan a hmuhna apiangah a that thei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Huat vâng ni lovin mi a nêk thut thei a, chângru lêm lovin mi a vawm palh thei a,
  </para>
  <para style="p">
    <verse number="23" style="v" />hmu lovin a lung vawm chuan mi a dêng palh thei a; inhmêlmâkna pawh an nei ngai lo va, tihnat pawh a tum ngai lo va; mahse, a mi tih chu a thi hlauh thei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chutiang thilah chuan dân angin an ngaihtuah ang a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Phuba latu lakah an hum tûr a ni; a tualtlânna khuaah khân an tlântîr ang a, puithiam lalber ṭang lai thih thlengin chutah chuan a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tihlumtu chuan a tualtlânna khua chu a kalsan vaih chuan
  </para>
  <para style="p">
    <verse number="27" style="v" />thisen phuba latuin a lo thah pawhin a thisen mawh chu a phur lo vang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Puithiam lalber ṭang lai a thih erawh chuan ama in leh lovah a haw leh thei ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />He dân hi in awmna apiangah i hmang kumkhua tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Mihring that chu hretu eng emaw zât thu avâng chauhva tihhlum tûr a ni; thuhretu pakhat chauh thu avângin mi tihhlum tûr a ni lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tual that, tihhlum ngei tûr chu tlan theih a ni lo, a thi ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tualtlânna khuaa tlân chu puithiam lalber ṭang lai a thih hma chuan an khaw lamah haw duh mah se, a nun humna tûrin a intlanchhuah phal tûr a ni lo.
  </para>
  <para style="p">
    <verse number="33" style="v" />In awmna ram chu tibawrhbâng suh u: thisen chhuah hian ram a tibawrhbâng a ni; thisen luanna ram chu thisen chhuahtu thisen ngawt lo chuan tihthianghlim leh theih a ni lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka ram, in chên vena ram chu, in tibawrhbâng tûr a ni lo; kei Lalpa hi, ka mi Israel-te zîngah ka awm zêl ṭhîn a ni,” a ti a.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Josefa thlah, Manasea fa, Makira fapa Gileada thlahte chhûngkaw hotute chu an lo kal a. Mosia leh hruaituho, Israel chhûngkaw puipate hnênah chuan,
  </para>
  <para style="p">
    <verse number="2" style="v" />“ Lalpa chuan kan pu hi Israel mite zîngah ṭhumvâwra ram sem tûrin a ti che a. Lalpa vêkin kan pu chu kan unaupa Zelofehada chan ai a fanute hnêna pe tûrin a ti bawk che a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel hnam dang zînga mi pasalah nei ta se, an ram chu an chhawm ang a, an pasalte hnam ramah a bei dâwn a, kan hnam chanpual aṭangin an ram chu hnam dang chanah suan tûr tihna a ni ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel-te tâna Jubili kumah pawh an ram chu kan rama belh ni lovin an pasalte hnam rama bei tûr a ni ta si a, kan hnam ram chan chu kan hloh hlen dâwn a ni,” an ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosia chuan Lalpa thupêk chu Israel-te a hrilh a, “Josefa thlahte hian an sawi dik a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zelofehada fanute chungchânga Lalpa thupêk chu hetiang hi a ni: An chi zînga mi chauh pasalah duh duh an nei thei ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, Israel hnam khat ram chu hnam dang ramah suan theih a ni lo vang. Israel-te chuan an hnam ram chu, chu hnam ngei chuan an nei reng tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu fanu pawhin ram chu rochung sela, a ram neitu hnam zînga mi pasalah a nei ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hnam khat ram chu hnam dang ramah suan tûr a ni lo, mahni hnam ram chu an nei tlat tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosia hnêna Lalpa thupêk ang chuan Zelofehada fanu Malaii te, Tirzaii te, Hoglaii te, Milkaii te, Novaii te chuan an pa chipui pasalah an nei ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Josefa fa, Manasea fate zînga mi an neih avângin an ram chu an pate ram a ni ta reng a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Moab phai, Jeriko zâwn, Jordan lui kamah hêng thupêkte leh dânte hi Israel-te tân Mosia hnêna Lalpa pêk chu a ni.
  </para>
</usx>
