<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Thufingte</book>
  <para style="h">Thufingte</para>
  <para style="toc1">Thufingte</para>
  <para style="toc2">Thufingte</para>
  <para style="mt">Thufingte</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel lal Davida fapa Solomona thufing hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Miten finna leh kaihhruaina dik an hriata, Thu rilte an hriat fuh theih nân a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmangchâng hriaa, thil dik tih leh rorêl thiamna neiin Tluang taka nung tûrin a kaihruai ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi mâwlte chu a tifingvâr ang a, Tleirâwlte pawhin fîmkhur dân an hria ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi fingten ngaithla se an fing sawt ang, Hre zaute chuan chinchâng an hriat belh ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thufing inthupte hrethiamin, Mi fing thu ril leh thu khirh an hre thei ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa ṭih hi hriatna thûk ber a lo ni, Mi â-te chuan finna an hmusit a, Kaihhruai theih an ni lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka fapa, i pa kaihhruaina ngaithla la, I nu thu zirtîr che pênsan hauh suh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Diar mawi tak khima, Ṭhi mawi tak awrh angin I nun a timawi ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka fapa, mi sualten an thlêm hunah che An thu zâwm suh ang che.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Ti rawh, thah tûr i zawng ru ang, Pawi sawi lo pawh ni se a rûkin bei mai ila,
  </para>
  <para style="p">
    <verse number="12" style="v" />A nung chunga phûm ang mai leh Seol-a chhuk tate angin i awmtîr ang,
  </para>
  <para style="p">
    <verse number="13" style="v" />Thil hlu tak kan lâksak ṭeuh vang a, Kan thil lâk chu inah kan chhêk dâwn nia,
  </para>
  <para style="p">
    <verse number="14" style="v" />Kan zîngah tel ve la Kan inṭawm vek dâwn nia,’ an tih che chuan,
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka fapa, an zîngah chuan tel ve hauh suh, An kawngah chuan pên lût hek suh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil sual ti tûr chuan an tlân chak hle a, Thisen chhuah pawh an nghâkhlel êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Savaten an hmuh reng laia, An awhna tûr lên zâr a sâwt lo,
  </para>
  <para style="p">
    <verse number="18" style="v" />Hêng mite erawh hi chu mahni awh nâna thang kam an ni, An awh hlum nâna kam ru an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chutiang chu suamhmangte awm dân tûr chu a ni, An nun an chân ngei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kawtthlêrahte leh tual zau laiahte, Finna chu a au va,
  </para>
  <para style="p">
    <verse number="21" style="v" />Mipui lunna laiahte pawh a au bawk a, Kulh kawngkhâr bulahte thu a sawi ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />‘Mi mâwlte u, mâwl reng in duh em ni, Eng chen nge finna hi in hmuhsit anga, Mi â pawhin hriatna hi a hmuhsit ang?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka zilhna hi rawn ngaihven ṭha ula, Tihtakzetin thu ka hrilh ang che u. Ka thu ka hriatthiamtîr dâwn a che u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka ko che u a, in chhâng duh lo, Bân ka phar a, in pawisa lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka remruat apiang in ngaihsak duh lo va, Ka zilhna chu in pawm duh bawk hek lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />In vânduaiin kei chu ka nui ang a, In râlkhêl hunah chuan ka nuihzat ang che u.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thlipui anga hlauhawm a lo thawhin, Ṭhâwngaleivir anga vânduainain a nuai che uin, Manganna leh hrehawmna in tuar hun chuan,
  </para>
  <para style="p">
    <verse number="28" style="v" />Min au vang a, ka chhâng lo vang che u, Min zawng min zawng ang a, min hmu lo vang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hriatna in hua a, Lalpa ṭih in tum si lo.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka remruat chu in pawisa duh lo va, Ka zilhna apiang chu in hmusit a,
  </para>
  <para style="p">
    <verse number="31" style="v" />In awm dân rah chu in seng ngei dâwn, In remruat chu in kham hlui ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi mâwlte chu an lêlohna avângin an thi ang a, Mi â-te chu an ngaihsam avângin an chhe bawk ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka thu ngaithlatute erawh chu him takin an awm ang a, Thil ṭha lo hlau lovin thlamuang takin an awm ang.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka thu hi ngun takin ngaithla la, Ka thupêkte hi pawm tlat rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thufing chu ngaihven la, Hriatthiam tum tlat ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ni, hriatthiam ngên la, Hriat fuh châkin au rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tangka angin zawng la, Ro phûm zawng ang maiin hai rawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, Lalpa ṭih dân i hria ang a, Pathian hriatna i chhar chhuak ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Finna petu Lalpa a ni, Hriatna leh hmuh fuhna a hnên aṭanga chhuak a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi ngîlte tân hlawhtlinna a chhêk khâwm a, Dik taka awmte tân phaw a ni bawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dik taka rorêl ṭhînte chu a vêng tlat a, Amah ngaihsaktute chu an awm dân tûr a enzui ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, a fel leh dik i hria ang a, Ngîl taka chet dân kawng ṭha chu i hre thei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Finna chuan a rawn luhchilh ang che a, Hriatna neih chu i tân a nuam hle ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmangchâng hriatna chuan a hualhim ang che a, Hriat fuhna chuan a vêng ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sual kawng ata a chhan chhuak ang che a, Thu veivir chîng te,
  </para>
  <para style="p">
    <verse number="13" style="v" />Kawng ṭha ata pênga, Thim zînga kal tate,
  </para>
  <para style="p">
    <verse number="14" style="v" />Thil sual tih lâwm viauva, Mi bum châkte,
  </para>
  <para style="p">
    <verse number="15" style="v" />Kawhmawh bâwl ṭhîn, Rin tlâk hauh lohte lakah a hum ang che.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kam thlum taka thlêm ṭhîntu che Hmeichhe sual lakah chuan a vêng ang che.
  </para>
  <para style="p">
    <verse number="17" style="v" />A tleirâwl chhuah pasal tlânsana, Pathian hmaa thutiam theihnghilhtu a ni e.
  </para>
  <para style="p">
    <verse number="18" style="v" />A in pan chu thihna a ni, A kawng chuan mitthi khua a chhun.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hnêna kal tawh chu an kîr leh ngai lo va, Nunna kawngah an lo kal tawh ngai lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi ṭhate awm dân angin awm la, Mi dikte kawng chu zawh ang che.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi ngîlte chu he ramah hian an awm ang a, Mi felte chu an chêng reng ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi sualte erawh chu he ram ata hnawh chhuah an ni ang a, Bum hmangte chu hnuh chhuah vek an ni ang.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka zirtîrna theihnghilh suh la, Ka thupêkte vawng tlat ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, rei tak i dam ang a, I hmuingîl zêl bawk ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngilneihna leh rinawmna hi thlah hlek suh la, I nghâwngah chuan zem tlat langin, I thinlung phêkah chuan ziak lût ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian leh mihring hnên ata Khawngaihna te, duhsakna te i dawng dâwn nia.
  </para>
  <para style="p">
    <verse number="5" style="v" />I thinlung zawng zawngin Lalpa ring la, Nangma hriatnaah innghat hauh suh,
  </para>
  <para style="p">
    <verse number="6" style="v" />I thiltih apiangah Lalpa hre reng ṭhîn la, I kawng a tihtluansak ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mahni fing inti hle suh la, Lalpa ṭih la, sual kalsan rawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />I taksa tân hrisêlna a ni ang a, I na atân damna a ni bawk ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />I sumin Lalpa chawimawi ṭhîn la, I neih pung hmasate nên chuan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tichuan, i buh inte a khat ang a, I uain sâwrkhur a liam bawk ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka fapa, Lalpa kaihhruaina hmusit suh la, A zilhna pawh ngainêp hek suh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pain a fa duh tak a thunun angin, Lalpan a hmangaihte a thunun ṭhîn asin.
  </para>
  <para style="p">
    <verse number="13" style="v" />Finna hmu chhuaka, Hriatna neitu chu a nihlawh e;
  </para>
  <para style="p">
    <verse number="14" style="v" />Tangka neih aiin hlâwkna a tam zâwk a, Rangkachak hlu tak aiin a duhawm zâwk.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lunghlu aiin a hlu zâwk a, A tluka hlu duhthu sâm tûr a awm lo ve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dam reinate a ding lamah a awm a, A vei lamah hausakna leh ropuinate a awm.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kawng chu a nuam a, A kalkawng chu hahdam tak a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah vuantute tân nunna thing a ni a, Amah zuitute chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpan finna hmangin lei a siam a, Hriatna hmangin vân khi a din.
  </para>
  <para style="p">
    <verse number="20" style="v" />A finna chuan tuithûkpuite a tiṭhen a, Chhûm chuan ruah a tlâktîr.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka fapa, finna leh hriat fuh theihna hi kawl tlat ang che, I hmuh phâk lohvah kal sawn suh se.
  </para>
  <para style="p">
    <verse number="22" style="v" />I tân nunna a ni ang a, I nghâwng atân mawina.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thlamuang takin i kal ang a, Eng mah i chhuih lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />I mut hunah hlauh rêng i nei lo vang, I mu ang a, tui takin i muhîl ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi sualte chunga thleng ṭhîn chhiatna ang hi, Hlauhawm a thlen thut hlau suh la,
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpan a vêng him tlat ang che, I ke thanga awh a phal lo vang.
  </para>
  <para style="p">
    <verse number="27" style="v" />I theih phawt chuan mamawhte tân i thil ṭhate ui suh,
  </para>
  <para style="p">
    <verse number="28" style="v" />Nei reng siin i ṭhenawm hnênah chuan, ‘Kal ta rih la, naktûk lamah lo kal leh rawh, Ka lo pe tawh ang che,’ ti suh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngaihngam taka i bula awm I ṭhian chungah thil sual phiar suh.
  </para>
  <para style="p">
    <verse number="30" style="v" />I pawi khawih lo chu chhan awm lovin khing suh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi nunrâwng chu awt suh ang che, A awm dân pawh zui suh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kawhmawhbâwlte chu Lalpan a ten a, Nun ngîlte erawh chu a rinzâwng tak an ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mi sual chhûngkua chu Lalpan ânchhia a lawh ṭhîn a, Mi dik chhûngkua erawh chu mal a sâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chapote chu a hmusit a, Pachhiate erawh chu a duhsak ṭhîn.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi fingte chuan chawimawi an hlawh ang a, Mi â-te chan tûr erawh chu mualphona mai a ni.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fate u, pa kaihhruaina ngaithla rawh u, Ngaihven ula, hriatthiam theihna in nei dâwn nia.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zir tûr ṭha chu ka hrilh che u a, Ka zirtîrna hi ngaihthah suh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka pa fapa neihchhun ka ni a, Ka nu’n min duat hle ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka pa chuan hetiang hian min zirtîr ṭhîn: ‘Ka thu hi vawng tlat la, Ka thupêkte zâwm la, i nung dâwn nia.
  </para>
  <para style="p">
    <verse number="5" style="v" />Finna leh hriatthiamna neih tum la, Ka thu hrilh che hi theihnghilh suh la, Ngaihthah bawk hek suh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tlânsan suh la, a vêng ang che, Pawm tlat la, a hum ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Finna neih hi thil pawimawh ber a ni, Thil dang zawng aiin hriatthiamna neih tum rawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngaisâng la, a chawisâng ang che, Pawm tlat la, a chawimawi ngei ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />I tân diar mawi tak a ni ang a, Lallukhum ropui tak a ni bawk ang,’ tiin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka fapa, ka thu hi ngaithla la, Ka thu sawi hi pawm rawh, Tichuan, i dam rei ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Finna kawng ka zirtîr che a, Kawng ngîlah chuan ka hruai ṭhîn che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tah chuan kal la, dîptu eng mah i tawng lo vang, Tlân vak mah la, i tlu lo vang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaihhruaina hi pawm tlat la, inthlahdah suh, Zawng reng rawh aw, i nunna tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi sualte kawngah chuan kal ve suh la, Mi suaksualte awm dân zui suh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hawisan daih la, inhnamhnawih suh, Pênsan daih la, kalsan vang vang ang che.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pawi an khawih phawt loh chuan an mu thei lo, Tu emaw tal an tihbuai zet loh chuan an mut a chhuak thei lo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Suahsual hi an chaw a ni a, Nunrâwn hi an uain a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi dikte awm dân erawh chu zîng êng ang hi a ni, A lo êng tial tial a, ni a lo chhuak ta ang hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi sualte kawng chu zân thim ang hi a ni, An inchhuih tlûkna tûr pawh an hre thei lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, ka thu hi ngaihven la, Ka thu sawi hi bengkhawn rawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A bosan che phal suh la, I thinlungah vawng tlat ang che.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hmutute tân nunna a ni a, An taksa tân damna a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />I thil ngaihtuah dânah fîmkhur hle la, I ngaihtuah chuan i nun a kaihruai ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chaltlai taka ṭawng chîng suh la, Bum chîng hek suh.
  </para>
  <para style="p">
    <verse number="25" style="v" />I hma lam thlîr ngun la, Dîng takin en tlat rawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />I kalna tûr en ngun la, I tih tawh chu a hlawhtling ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ding lamah emaw, vei lamah emaw pêng suh, Sual lakah i ke vêng ṭha rawh.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka finna hi ngaihven ṭha la, Ka hriatna hi bengkhawn ṭha rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tichuan, awm dân ṭha chu i hria ang a, I thu-ah chuan hriatna i neih a lang bawk ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmeichhe sual chu a ṭawng a thlum êm êm a, Sahriak aiin a dang a nâl a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />A hnuah chuan a ṭawng a bak ang a, Khandaih hriam tawn angin a hriam bawk ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thihna panin a ni a kal, A kalkawng chuan Seol a chhun.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nunna kawng rêng zawh a tum lo, Kawng dik lo a zawh a, Amah lah chuan a hre si lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chuvângin, ka fapate u, ngaithla ula, Ka thu sawi hi pênsan suh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />A lak aṭang chuan inthiarfihlîm ula, A kawngka pawh hnaih suh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi dangin i zahawmna an chang ang a, Nunrâwng kutah i thi mai dah ang e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi dang daihin i hausakna an chên ang a, I thawhrim rah hnam dangin an nei ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />I thi tûr chu i rûm ang a, I chêrin i chak lo hle bawk ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘Kaihhruai ka hreh ṭhînzia tak kha aw, Zilhna ka hmusit êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi kaihruaitute aw ka hre duh lo vei a, Min zirtîrtute thu ka ngaihsak ngai hek lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pung khâwm zîngah ka mualpho ṭêp tawh a lo ni,’ i la ti ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangma tuizêma tui ngei in la, I tuikhuah ata lo chhuak chu.
  </para>
  <para style="p">
    <verse number="16" style="v" />I tuihna chu engah nge a chik darh anga, Kawtlaiahte a luan ral mai mai ang?
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangma tân chauh ni se, Mi dang tân ni suh se,
  </para>
  <para style="p">
    <verse number="18" style="v" />I tuihna chuan malsâwmna dawng sela, I tawn tirh nupui chu hlim nân hmang rawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zukla nalh tak, saza tuai ang a ni, A ṭang nêmah tlei la, A hmangaihna chuan zial che rawh se.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, mi dang nupui zûnah engah nge i uai ang, Hmeichhe dang ṭâng engah nge i vawn ang?
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpan i thiltih zawng zawng a hmu vek a, I nun zawng zawng a enfiah ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi sualte chu an sualna ngeiin a âwk a, An sualna chuan a phuar tlat ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />An insûm theih loh avângin an thi ang a, An ât em avângin an bo daih ang.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />I ṭhenawm aia tuar i intiama, Hmêlhriat loh leiba rûl
  </para>
  <para style="p">
    <verse number="2" style="v" />tûra i insawi awh tawha, I thutiama i inhlin bawk si chuan;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka fapa, i ṭhenawmpa kutah chuan i âwk ta a ni. Ti hian intihchhuah tum ang che, A hnênah kal thuai la, ngaihdam dîl rawh, I thu i sût a phal theih nân ngên chiam ang che,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mutsan hauh suh ang che, Chawlh hahdamsan hek suh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sakhi âwk chhuak a tlân ang leh, Sava âwk chhuak a thlâwk daih ang mai hian, A thang ata chhuak vang vang rawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang, thatchhepa, fanghmîr hnênah kal la, An awm dân hi en rawh, I fin phah mial mahna.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lal an nei lo, hotu leh hruaitu pawh an nei lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nipui lai chuan chaw an zawng a, Buhseng hunah ei tûr an khâwl khâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thatchhepa, eng chen nge i mut dâwn? Engtikah nge i ṭhanharh ang?
  </para>
  <para style="p">
    <verse number="10" style="v" />‘Mu leh hlek ang, chhîng hlek ila, Kut kuangkuahin zâl hlek teh ang,’ i tih chhûngin
  </para>
  <para style="p">
    <verse number="11" style="v" />Retheihna chu mikhual angin a lo thleng thut ang a, Tlâkchhamnain râl ang maiin a rawn nang thut ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi bengtlalo, mi chimawm chu, Thu veivirin a hmanhlel a,
  </para>
  <para style="p">
    <verse number="13" style="v" />A mit siaiin a ke a phût a, A kut a lek vêl ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />A rilru kawi tak chuan thil sual a ruahman ṭhîn, Innghirnghona a tichhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chuvângin, manganna chuan a nang thut ang a, Siam ṭhat rual loh chhiatna a tâwk ngei ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil paruk-pasarih Lalpa huatzâwng, A ten êm êm a awm:
  </para>
  <para style="p">
    <verse number="17" style="v" />Mit chapo te, dâwt sawi chîng te, Pawi khawih lo thattu te,
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil sual ngaihtuah chhuah chîng ṭhîn te, Sual ti tûra ngal chak hle te,
  </para>
  <para style="p">
    <verse number="19" style="v" />Thuhretu der, dâwt phuh chhuak te, Unau innghirnghotîrtu te.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka fapa, i pa thupêkte vawng tlat la, I nu zirtîrna pawh hawisan hek suh.
  </para>
  <para style="p">
    <verse number="21" style="v" />I thinlungah châm rêng sela, I nghâwngah zem tlat rawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />I kalna apiangah a hruai ang che a, I mut hunah a vêng ang che, I thawh hunah kawng ṭha a hrilh ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />An thupêkte chu khâwnvâr a ni a, An zirtîrna chu êng a ni, An hruaina chuan nun dân ṭha chu a kawhhmuh ang che.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmeichhe sual lakah a vêng ang che, Mi dang nupui kam thlum tak lakah nên.
  </para>
  <para style="p">
    <verse number="25" style="v" />A tîtuai ṭha ît suh ang che, A mitmei chuan man che suh se.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chhang tlang khatin nawhchizuar a lei theih a, Uirenu erawh chuan i nun hlu tak a veh a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kawr kâng lovin mei hi a pawm theih em ni?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ke kâng lovin meiling a dai theih em ni?
  </para>
  <para style="p">
    <verse number="29" style="v" />Ṭhenawmpate nupui chhaih chu chutiang bawk chu a ni; Khawihsak phei chuan an tuar ngei ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rilṭâm avânga thil rutu chu Miten an hmusit lem lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />An man hlauh erawh chuan A lêt sarih a chawi ang a, A neih zawng zawng a chân mai ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi nu uiretu chu a â hle a ni, Ama nun a tichhia a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />An hêm hrep ang a, a mualpho hle ang, A hming a chhe kumkhua bawk ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thîkthu avânga thinrim hi a tluka na a awm thei lo, Dîm lêk lovin phuba a la ngei ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thlêm lungawina eng mah a duh lo vang a, Thamna pe ṭeuh la, a lungawi chuang lo vang.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka fapa, ka thu hi awih la, Ka thupêkte hi vawng tlat ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka thupêk hi zâwm la, i nung dâwn nia, Ka zirtîrna hi i mitnaute angin hum rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />I zungṭangah bun la, I thinlung phêkah chuan ziak rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Finna chu, ‘Ka farnu,’ ti la, Hriatthiamna chu, ‘Ka laichînnu,’ ti rawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi dang nupui, hmeichhe kam thlum tak lakah A vêng dâwn che nia.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kan tukverh âwng kârah ka han bih a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tlangvâl mâwl tak tak mai ka hmu hlawm a, An zînga â fâl pakhat ka en zui a,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nu pakhat awmna vêng hnaiah a kal ta a, A in lam chu a pan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlai lam ni tlâk hnuah khua a thim ta maw tihah,
  </para>
  <para style="p">
    <verse number="10" style="v" />Nawhchizuar anga inchei hlar, Mi lêm thiam takin a lo ko va.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zah bosal tawh, ti hawm hawm mai, Awm hle hle thei tawh lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kawtthlêrah te, tuallaiah te, Kil tin kil tanga tlangvâl châng ṭhîn chuan,
  </para>
  <para style="p">
    <verse number="13" style="v" />A lo pawm a, a han fâwp a, Tlângnêl takin ti hian a han ti a:
  </para>
  <para style="p">
    <verse number="14" style="v" />‘Remna thilhlan hlân tûr ka ni a, Vawiin chiah hian ka thutiam chu ka hlen ta a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmah zawng tûr chein ka lo chhuak a ni e, Ka melh ka melh che a, ka hmu ta che a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aigupta ram puan ṭial mawi Ka khumah ka phah diam tawh a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mura te, Aloe te, thakthing te chuan Khum chu ka tirimtui tawh a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tirawh, khawvâr hma chu nui dûn ila, Hmangaihna chu i chên dûn ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka pasal lah ina a awm loh lai tak a ni, Ram hla takah a zin daih a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangka ip a keng a, Thla vânglaiin a lo hâwng leh chauh vang,’ a ti a.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ṭawnghmang thiamin a lêm thlu a, A kam thlum tak chuan a zial â ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bâwngpain an talhna tûr hmun a pan ang leh Thalin a thin a rawn chhun zawk hma chu, Kar hmaa sakhi a ter et et ang leh Thang lam pana sava a thlâwk ang hian, A zui lût ta a, A nun a chân phah dâwn tih rêng a hre hauh lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khai le, fate u, ka thu ngaithla ula, Ka thu sawi hi ngaihven rawh u.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangni chuan chutiang hmeichhe lam chu hawi suh u, A kawngah chuan pêng hek suh u.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tam tak chu a tichhe tawh a, Mi tam tak chuan an thih phah tawh a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A in i pan vaih chuan Seol i thleng ang a, Mitthi khaw kawng pumpelh tawi ber a ni.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Finna chu a au a ni lâwm ni? Hriatna pawh chuan aw achhuah e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kawng sîr hmun sângahte leh Kawng pêng ṭhuam laiahte chuan a ding.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khawpui tawntirh kulh kawngkaa, Khaw luhnaahte chuan a au chiam ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangni mihringte u, in hnênah thu ka sawi a ni, Hringfate u, in hriat atân ka au a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi mâwlte u, fîmkhur zir ula, Mi â-te u, fin zir rawh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thu tak tak ka sawi dâwn a, ngaithla ula, Ka thu hi zawng a dik a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thu dik ka chhâk chhuak a, Suahsualna hi ka ten a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka sawi apiang thu dik tak zêl a ni, Thu veivir leh thu kawi a awm lo ve.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hriatthiamna nei tân chuan a tluangtlam a, Hre zau tân pawh a chiang hle ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tangka aiin ka kaihhruaina thlang rawh u, Rangkachak thlan chhuah ai pawhin hriatna hi duh rawh u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lunghlu aiin finna a hlu zâwk a, Duhthusâm ber pawh hian a hen zo lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei, finna hian fîmkhur ka thiam a, Hriatna neiin rem ka hre hle a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa ṭih dân chu sual huat hi a ni, Chapo leh intihvei, awm khawloh leh verther, Ka huatzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rem ka ruat a, ka tihlawhtling bawk ṭhîn, Ka hrethiam a, thiltithei tak ka ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Keimah avângin lalte an lal a, Rorêltuten dân ṭha an zam a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rorêltuten ro an rêl a, Mi liante leh thuremtute pawhin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Min ngainate ka ngaina a, Ngun taka min zawngtuten min hmu.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hausakna leh zahawmna hi ka ta a ni, Hlawhtlinna leh hmuingîlna nên.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka hnên aṭanga dawn tûr chu Rangkachak ṭha mi aiin a ṭha. Tangkaraw thianghlim ber ai pawhin a hlu.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kawng dik takah ka kal ṭhîn a, Dik takin ro ka rêl ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi ngainate hnênah hausakna ka pe a, An ro bâwmte ka chhûn khahsak bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpan min siam hmasa ber a, Thil siam a ṭan hmaa,
  </para>
  <para style="p">
    <verse number="23" style="v" />A tîr bera a siam ka ni, Khawvêl siam hma daih khân.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuithûkpui awm hma khân ka piang tawh a, Tuihna rêng rêng a awm hma khân.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tlângte a din ṭan hma daih khân; Mualte a pian hma khân ka piang tawh a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lei leh khawmual siam hma Vaivut vei khat pawh a awm hma khân,
  </para>
  <para style="p">
    <verse number="27" style="v" />Vân khi a dah hmain ka awm tawh a, Tuithûkpui hual tûra kâwlkil a rin kual hma te khân.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chung lam vân dum khi a dah ngheha, Tuithûkpui hna a siam hma khân,
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuiin a thupêkte a pelh loh nân Tuipui chîm chin tûrte a ruat hmaa, Lei nghahna tûr a ruahman hma khân ka awm tawh a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />A bula awm, themthiam tak chu ka ni. Ni tin tilâwm ṭhîntu ka ni a, Kei pawh a hmaah ka hlim ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />A lei siam, a chênna tûrah Hlim takin ka lêng a, Mihringte chu ka hlimpui ṭhîn
  </para>
  <para style="p">
    <verse number="32" style="v" />Khai le, fate u, ka thu hi ngaithla teh u, Ka thu zâwmtute chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kaihhruaina zâwm ula, Fin phah rawh u, thlahthlam suh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ni tin, ka kawngkhâr bula min nghâktu, Kawngka sîra min châng ṭhîna, Ka thu ngaithlatu chu a nihlawh e.
  </para>
  <para style="p">
    <verse number="35" style="v" />Min hmutu chu a nung ang a, Lalpa duhsakna a dawng ang.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mi hêltute chu mahni pawi khawih an ni. Min huate chuan thih an thlang tihna a ni.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Finna chuan in a sa a, Lung chher ban pasarih a phun.
  </para>
  <para style="p">
    <verse number="2" style="v" />A lawmna tûr ran a talh a, Uain pawh a bun chhuak a, Ruai chu a peih tawh e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khaw chhûng hmunsâng berahte au tûr, A chhiahhlawh nulate a tîr a.
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Mi mâwlte chu lo haw rawh se,’ tiin.
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Ti teh u, ka chaw hi ei ula, Ka uain pawh hi in teh u,
  </para>
  <para style="p">
    <verse number="6" style="v" />Mâwlna kalsan ula, nung rawh u, Hriatna kawngah kal tawh rawh u,’ a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi induhte i zilh chuan hau i tuar ang, Mi sual i zilhhau chuan kut i tuar ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Induhte chu zilh suh, an hua ang che, Mi fing zilh la, a ngaina hle ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi fing hnêna i sawi chu a fin phah ang, Mi dik zirtîr la, a hriatna a pung ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa ṭih hi finna ṭobul a ni a, Mi Thianghlima hriat hi finvârna chu a ni
  </para>
  <para style="p">
    <verse number="11" style="v" />Chu chuan a tidamrei ang che a, I dam chhûng kum a tipung ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chu finna chu nei la, i tâna fing i ni ang a, I duh loh chuan nangman i tuar ngei ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmeichhe â chu a intârlang a, Dâwn a nei lo, zah rêng a hre hek lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />A in kawngkaah chuan a ṭhu chhuak a, Khawpui hmun langsâr laiahte ṭhuthmun a rem a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Kawnga lo kal apiang a lo ko va, Veivâk apiang a lo au ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />‘Mi mâwlte u, lo kal teh u,’ a ti. Mi â-te hnênah chuan,
  </para>
  <para style="p">
    <verse number="17" style="v" />“A rûka tui in chu a tui bîk a, A rûka chhang ei pawh a tui bîk ṭhîn,” a ti a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tah chuan thihna a awm tih an hre lo, A koh luh tâkte chu Seol khurah an awm a ni.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fapa fingin a pa a tilâwm a, Fapa â erawh chuan a nu a tirethei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dik lo taka sum lâk luh chu a hlâwk chuang lo, Dik taka thil tih chuan nun a hum ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa chuan mi dikte ṭâm a phal lo va, Mi sualte duhthusâm chu a tithlâwn ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thatchhia chu a rethei ang a, Mi taima chu a hausa ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Fapa fing chuan a hun takah buh a seng ṭhîn a, Buh seng huna mut chîngte chu zahpuiawm tak an ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi dik chuan malsâwmna a dawng ang a, Mi sual thu chuan inpâwngnêkna a keng ru ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi dikte hriat reng hi anmahni chawimawina a ni a, Mi sualte hming erawh chu hriat reng a ni lo vang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thinlung fing chuan thupêk a pawisa ang, Â taka ṭawng ṭhînte chu an tluchhia ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dik taka awmte chu an thlamuang ṭhîn. Mi rinawm lote chu man chhuah an la ni ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thu dik sawi tlang ngam lo chuan buaina a tichhuak a, Huai taka sawisêltu chuan remna a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi dik tak thu chu nunna hnâr a ni, Mi sual thu chuan inpâwngnêkna a keng ru ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Inhuatna hian innghirhona a thlentîr a, Hmangaihna erawh chuan bawhchhiatna a haider ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi vengvâten thu fing an sawi ṭhîn a, Finna tlachhamte chuan vuak an tuar ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi fingte chuan hriatna an khâwl khâwm a, Mi â an ṭawng ve chuan chhiatna a lo hnai ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hausate chu an hausaknain a hum ṭhîn a, Retheite chuan an pachhiat avângin an tuar ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil ṭha tih rah chu nunna a ni a, Sual chuan sual a hrin belh ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kaihhruaina dik zâwmtu chu a nung ang a, Zilhna pawisa lotu erawh chu thil tisual a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huatna zêptu chu mi dawthei a ni a, Mi rêl chîng chu mi â a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ṭawng tam poh leh tihsual a tam a, Mi fing erawh chu a insûm ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi dik ṭawng chu tangkaraw ṭha mi anga hlu a ni a, Mi sual rilru erawh chu nêp tak a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi dik thu chuan mi tam tak a titlai ṭhîn a, Mi â erawh chu finna tlachhamin a thi ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa malsâwmna chuan mi a tihausa a, Lungngaihna a tel lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thil sual tih hlimpui hi mi â awm dân a ni a, Mi fingte erawh chuan finna an ngaisâng ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi sualte chuan an hlauh ang ngei an tawng ang a, Mi dikte erawh chuan thil an duh chu an hmu ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thlipui a lo tleh a, mi sualte chu a nuai bo va, Mi dikte erawh chu an nghet tlat ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thatchhe tirh chu Thil thûrin hâ a tihṭima, Meikhuin mit a tithîp ang hi a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpa ṭih hi dam reina a ni a, Mi sualte damchhûng erawh chu a tawi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi dikte thil nghah chu lâwmna a ni a, Mi sualte hmabâk erawh chu boralna a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi ngîlte chu Lalpan a hum ṭhîn a, Thil sual titute erawh chu a tiboral ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi dikte chu an nghîng ngai lo vang a, Mi sualte erawh chu he ramah hian an awm ve reng lo vang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mi dikte chuan thufing an sawi chhuak a, Thu sual sawina lei erawh chu hleh a ni ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi dikte kam chhuak chu a duhawm ṭhîn a, Mi sualte thu sawi erawh chuan mi a khêng ṭhîn.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bûkna dik lo chu Lalpa tenzâwng tak a ni a, Bûklung dik erawh chu a lawmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chapote chu an mualpho thuai dâwn a, Inngaihtlâwm hi a fing zâwk e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi ngîlte chu rinawmnain a kaihruai a, Bum hmangte erawh chu an sualnain a tichhia ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausak hi thinurna ni-ah chuan a ṭangkai lo va, Dikna erawh chuan thihna ata a chhan chhuak ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi ṭhate chu an dik avângin an kawng a tluang a, Mi sualte erawh chu an sualnain a tichhe ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi ngîlte chu an diknain a chhan ṭhîn a, Bum hmangte erawh chu an châknain a man tlat ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi sualte an thihin beisei tûr a awm tawh lo, Hausaknaa innghah hi sâwtna a awm lo ve.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi dikte chu manganna ata chhan chhuah an ni a, Mi sualte chungah a thleng thung ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Serh leh sâng nei lote thu sawi chuan an ṭhiante a tichhe ṭhîn a, Mi fingte chu an finnain a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi dikte an tluan chuan khua an lâwm a, Mi sualte an tlâwm chuan lâwmin an au chiam ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi ngîl zârah khua a mawi a, Mi sual ṭawngin a tihmingchhia.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi dang hmuhsit hi a âtthlâk a, Mi fing erawh chu a ngawi mai ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi kamtam chuan thurûk a zêp thei lo va, Rin tlâkte erawh chuan thu an zêp thei ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaihruaitu ṭha an awm loh chuan mite an tlu ṭhîn a, Remruat thiam an tam chuan an him ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hriat chian loh tâna dahkhama ṭan chu inchhîrawm tak a ni, Ṭan loh law law a hahdamthlâk zâwk.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nu ngilnei chuan chawimawi a hlawh a, Hmeichhe sual chu zahpuiawm tak a ni. Mi thatchhia chu a hausa ngai lo vang a, Mi hrât tak erawh chu a hausa ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi ngilnei chuan a ngilneihna a hlâwkpui a, Mi nunrâwng chu amah a intichhe ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi sual thiltihah hlâwkna rêng a awm lo va, Mi dik thil tih erawh chu a hlâwk ngei ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thil dik tih tum tlatte chu an nung ang a, Thil sual ûmtute chu an tlu ngei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpan rilru kawi a ten a, Rilru ngîlte erawh chu a ngaina.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi sual chuan hrem a pumpelh hauh lo vang a, Mi dikte erawh chuan an pumpelh ngei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nula hmêlṭha fîmkhur nachâng hre lo chu Vawk hnâra rangkachak khâng vuah ang hi a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi dikte duhthusâm chu thil ṭha hlîr a ni a, Mi sualte hmabâk chu Pathian thinurna tuar a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sem darh chîn chu ngah lehzualna a ni, Mi kawm tak nih chu tlâkchham ngahna a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thilphal hle la, i hausa ang, Mi ṭanpui la, an ṭanpui ve ang che.
  </para>
  <para style="p">
    <verse number="26" style="v" />A to nghâka buh chheprelhtu chu ânchhia an lawh ang a, Phal taka hralh zêltu chu miin an fak ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thil ṭha i duh tlat chuan duhsakna i dawng ang. Thil sual i zawn chuan i tawng ngei ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hausakna rinchhante chu hnah angin an ṭîl ang a, Mi dikte erawh chu an duah hluah ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mahni chhûngkaw tibuaitu chuan eng mah a nei lo vang, Mi â-te chu mi fing chhiahhlawh an ni ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dikna rah chu nunna a ni a, Nunrâwn chu thihna a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khawvêlah mah mi dikten lâwmman an dawn chuan Thil sual titute leh mi sualte chuan hrem an tuar ngei ang.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaihhruaina ngaina chuan hriatna a ngaina a, Thununna hawtu chu a â hle a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ṭhate chu Lalpan a duhsak a, Sual tih chîngte thiam loh a chantîr ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sual avângin tu mah an dingchang lo vang a, Mi dikte erawh chu an nghîng lo vang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nu ṭha chu a pasal tân lallukhum a ni a, Pasal timualphotu chu ngalngêt ang hi a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi dikte chuan thil dik an ngaihtuah a, Mi sualte remruat chu bumna hlîr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi sualte kam chhuak chu tual thah thu a ni a, Mi ngîlte thu chuan mi a chhanhim ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi sualte chu an tluchhia a, an boral a, Mi dik chhûngkua chu an dingchang ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi an fin leh fak an hlawh ṭhîn a, An ât leh an hmusit ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Intihmilena ei tûr tlâkchham ai chuan, Mahni hna thawka mi narân nih a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi dikte chuan an rante lam an khawngaih a, Mi sualte erawh chu an nun a râwng a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mahni lo enkawltu chuan ei tûr a ngah ṭhîn a, Eng mah ni hlei lo ûm ruak ruak hi a âtthlâk e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi sualte kulh chu a chhe ṭhîn a, Mi dikte erawh chuan nghet takin zung an kaih ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi sual chu amah a inṭawngâwk ṭhîn a, Mi dik erawh chuan buaina a pumpelh ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ṭawnghmang thiam miin a thiam man a tlai phah ang a, A thil tih rah a seng bawk ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi â chuan dik a inti hle ṭhîn a, Mi fingte erawh chuan thurâwn an ngaichâng ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi â lungni lo chu a lang nghâl ṭhîn a, Mi fing chuan chêksawlhna a ngaihthah ṭhîn,
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi rinawm chuan thu dik a sawi ṭhîn a, Thuhretu der chuan dâwt a sawi ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ṭawng thlahdah hian ngûnhnâm angin mi a chhun na thei a, Mi fing thu erawh chuan mi a thawi dam ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu fing chuan a daih rei a, Dâwt erawh chuan rei lo tê chauh a daih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thil ṭha lo tih tumtuten mahni an inbum a, Remna zawngtuten hlimna an chang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi dikte chu thil ṭha lovin a tlâkbuak lo, Mi sualte erawh chuan manganna an tâwk ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpan dâwt hmang a ten a, Rinawm taka thil ti ṭhîn erawh chu a ngaina.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi fîmkhur chuan a hriatzia a thup a, Mi chhawihte erawh chuan an âtzia an târlang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Taima apiangin thu an nei ang a, Thatchhiate erawh chu chhiahhlawh an ni mai ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lungkham neih avângin mi an ngui a, Thu ṭha erawh chuan mi a tihlim ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi dik chu a ṭhiante kaihruaitu a ni a, Mi sualte kawng erawh chu bona a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi thatchhia chuan a duhzâwng a nei ngai lo vang a, Taima erawh chu a pung thûr thûr ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dikna hi nunna kawng a ni a, Chumi kawngah chuan thihna a awm lo.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Fapa fing chuan a pa kaihhruaina a zâwm a, Pawisak nei lo chuan zilhna a ngaithla duh ṭhîn lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ṭha chuan a ṭhat man a chên ang a, Bum hmang chuan râwng taka chêt hi a nuam tihzâwng a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ṭawng fîmkhur hi mahni invênna a ni a, Mi ṭawng tlahawlh chuan ama chhiatna a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thatchhiain eng mah a nei lo; Mahse, a vîr êm êm, Mi taima erawh chuan a nei le lu ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi dik chuan dâwt thu a hua a, Mi sual thu erawh chu a tenawm a, a zahpuiawm.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dikna chuan pawi sawi lote a vêng tlat a, Suahsualna erawh chuan mi sualte chhiatna a thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hausa hlea inngai eng mah nei lo an awm a, Pachhiaa inngai hausa hle an awm bawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hausa chuan intlanna tûr sum a nei a, Pachhia erawh chuan vau a tâwk ve lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi dikte chu mei êng tak ang an ni a, Mi sualte chu khâwnvâr tihmih ang an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chapona chuan inhauna a tichhuak ṭhîn a, Mi râwn ṭhin hi a finthlâk zâwk a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Awlsam taka sum neih chu a ral thuai a, Harsa taka thawh chhuah chu a pung zêl ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Beisei a bo chuan thin a na a, Duh anga kan hlawhtlin chuan kan hlim ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thurâwn hmusittu chuan a chhiat phah ang a, Thupêk zâwmtu chu a him ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi fing zirtîrna chu nunna hnâr a ni a, Thihna thang pumpelhna a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Finna ṭha chuan mi a timawi a, Rinawm lohna erawh chu boralna a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi fing chuan fîmkhur takin engkim a ti a, Mi mâwl erawh chuan a âtzia a târlang ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi tirh rinawm loten buaina an tichhuak a, Palai rinawmten remna an thlen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kaihhruai duh lotu chu a pachhiain a mualpho vang a. Zilhna zâwmtu chu chawimawi a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Duhthusâm hlawhtlin hi nuam tak a ni, Mi sualte chuan thil sual an hawisan duh tlat lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi fing kâwm la, i fing ve ang; Mi mâwl i kawmngeih chuan i tuar ngei ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi sualte chu mangannain a tlâkbuak ṭhîn a, Mi dikte erawh chuan thil ṭha an dawng ngei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi ṭha chuan a tute thlenga rochun tûr sum a hnutchhiah a, Mi sual sum khâwl erawh chu mi dikten an nei ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi retheite tân buh thar ṭeuhna tûr ram a awm diai duai a, Mahse, mi dik loten an neih an phal si lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Talhfiak hmang lo chuan a fa a hua a ni, A hmangaih chuan tuk tin zilh rawh se.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi dikte chuan kham tâwk ei tûr an nei ang a, Mi sualte chu an ril a ṭâm fo vang.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmeichhe fing chuan chhûngkua an din a, A â-te chuan an kut ngeiin an ṭhiat.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngîl taka nung chuan Lalpa a ṭih a ni; Kawi taka awm chuan a hmusit a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi â chu chapo takin a ṭawng ṭhîn a, Mi fing chu a thuin a hum ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bâwng chhawr tûr a awm loh chuan buh in a ruak a, Bâwng tha chhawr avângin buh a hlâwk ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thuhretu rinawm chuan dâwt a sawi ngai lo va, A rinawm loh erawh chuan dâwt a phuahchawp ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi inchhuangte chu an fing ngai lo vang a, Mi rilru nei rên râwnte chuan thil an hre thuai ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi â chu kalsan vat rawh, Eng mah hrilh tûr che a nei lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mahni nihna hriat hi mi fing finna chu a ni a, Mi â âtna chu finga a inhriatna hi a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathianin mi â-te a hmusit a, Mi ngilneite erawh chu a duhsak ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kan lungngaihna chu mahni chauhvin kan hria, Kan lâwmna pawh mi dangin min ṭâwmpui thei lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi sual chhûngkua an tlûkchhiat pawhin, Mi ṭha chhûngkua chu an dingchang ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kawng dik nia i hriat chu Thihna a la ni mai thei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nuih lai pawhin thinlung a na ṭhîn a, Lâwmna chu lungngaihnain a zui fo ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi sualte chuan an sual man an hmu ang a, Mi ṭhate chuan an thiltih lâwmman an dawng bawk ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi sualte chuan eng pawh an ring mai a, Mi fîmkhur chuan a kalna tûr a thlîr ngun ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi fingte chu an fîmkhur a, Thil ṭha lo an hawisan a, Mi sualte erawh chuan ngampa takin thil an ti buan buan ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thinchhiate chuan â takin thil an ti rum rum ṭhîn a, Mi fîmkhurte chu an hua.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi mâwlte chuan an mâwl man an hmu a, Mi fingte chuan hriatna an dawn belh ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi sualte chu mi ṭha hmaah an kûn ang a, Mi dikte hmaah chuan an ṭhingṭhi ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pachhiate chu an ṭhenawmte pawhin an hua a, Hausate erawh chuan ṭhian an ngah hle.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ṭhenawmte hmusittu chu mi sual a ni a, Retheite lainattu chu mi nihlawh a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thil ṭha lo ngaihtuahtu chuan thil sual a ti a ni; Thil ṭha tih tumtute chu miin an ring ang a, an lainat ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thawhrim chuan rah a nei ṭhîn a, A sawia sawi ringawt chuan tlâkchhamna a thlen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi fingte chu hausakna vûr an ni a, Mi sualte âtzia chu chhah tak a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thuhretu dik chuan mi nun a chhan ṭhîn a, Dâwt a sawi chuan mi a phat ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa ṭih hi him taka awmna a ni a, Fate tân pawh belh tlâk a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpa ṭih hi nunna hnâr a ni a, Thihna thang pumpelhna a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lalin khualehtui a ngah chuan a ropui a, Mi a neih loh chuan a chan a chau ta ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi thinnel chuan thil a hrethiam ṭhîn a, Mi thinram chuan a âtzia a tilang ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thlamuanna hian taksa a tihrisêl a, Îtsîkna hi ngalngêt ang a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Retheite nêkchêp hi siamtu hmuhsitna a ni; Pachhiate lainattu chuan a chawimawi a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi sualin a thil sual tih a chhiat phah a, Mi dik chu a diknain a hum zâwk ṭhîn.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mi rilru nei rên râwn chu an fing ṭhîn a, Mi sualte erawh chuan thufing an hre thei lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dikna chuan hnam a tiropui a, Sual hi hnam tin tân mualphona a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chhiahhlawh fing chu lalin a duhsak ṭhîn a, A mit tlung lo chungah a thinur ṭhîn.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chhânna nêmin thinrim a tireh a, Aw vînin thinur a titho.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi fing thu sawi chuan hriatna a tiduhawm a, Mi mâwlten thu â an phuh chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpan hmun tin a hmu a, Mi sual leh mi ṭha a thlîr kim vek a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw dam chuan mi a tiharh a, Thu veivir chuan mi a tingui.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi â chuan a pa kaihhruaina a hmusit a, Mi fing chuan a pa zirtîrna a pawisa ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi dik inah sum leh pai a tling khâwm a, Buaina a lo thlenin mi sualte an chhe mai ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hriatna hi mi fingten an tidarh a, Mi mâwlte erawh chuan an ti ve lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpan mi sualte inthawina chu a ten a, Mi ngîlte ṭawngṭaina chu a lawmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpan mi sualte awm dân chu a ten a, Dik taka thiltite chu a ngaina ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kawng dik pênsantu chu na taka hrem a ni ang a, Zirtîrna hawtu chu a thi ngei ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Seol leh boralna hmun chu Lalpan a hmu tlang vek a, Mihring thinlung phei chu a va hmu chiang dâwn êm!
  </para>
  <para style="p">
    <verse number="12" style="v" />Chapote chuan kaihhruai an duh lo va, Mi fing an pan duh bawk hek lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thinlung hlim chu hmêlah a lang a, Thinlung ngui chuan rilru a tichau.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi fingte chuan hriat belh an duh a, Mi mâwlte chuan mâwl renga awm an duh tâwk.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rethei nun chu hahthlâk tak a ni, Mi hlim thei chuan nuam an ti ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Buai phîlîa neih ṭeuh ai chuan, Tlêm tê chauh pawh neiha Lalpa ṭih hi a ṭha.
  </para>
  <para style="p">
    <verse number="17" style="v" />Inhaw chunga sa tui tak tak ei ai chuan, Hmangaihte nên anhnah mai mai ei pawh a nuam.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi thinramin buaina an chawk chhuak a, Mi thinnelin buaina an tidai ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thatchhe kawng chu hlîngin a khat a, Mi ngîlte kawng chu a fai hliau ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Fapa fing chuan a pa a tilâwm a, A â erawh chuan a nu a hmusit ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi mâwlte chuan an ât an hlimpui a, Mi fingte erawh chu kawng ngîlah an kal ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Remruat lâwk a nih loh chuan thiltum a tlawlh ṭhîn a, Remhria an tam erawh chuan a hlawhtling ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hun taka chhânna dik hriat hi, A hlimawmin a va ṭha êm!
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi fingte chuan nunna kawng chu an zawh chho va, Seol chhukna kawngah an kal duh lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpan chapote in a ṭhiatsak a, Hmeithaite ramri chu a humsak ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpan mi sualte ngaihtuahna chu a ten a, Mi thianghlimte thu chu a lâwm.
  </para>
  <para style="p">
    <verse number="27" style="v" />Dik lo taka hlêp ṭeuh tum chu chhûngkaw buaina a ni a, Thamna lâk duh loh hi nun hlimna a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi dikte chuan an chhân hmain an ngaihtuah ngun ṭhîn a, Mi sualte chuan thu ṭha lo an phuh chhuak pheng phung ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lalpa chuan mi sualte a hlat a, Mi dikte ṭawngṭai a ngaithla ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hlim hmêlin mi a tilâwm a, Thu lâwmawmin mi a tiharh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zilhna pawisak hi mi fing zînga telvena a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kaihhruaina pawisa lo chu mahni intichhia a ni a, Zilhna pawisak hi finna a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa ṭih hi fin zirna a ni a, Chawimawina hlawh hmain tlâwm a ṭûl ṭhîn.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mihringin rem a ruat a, A hlawhtlinna chu Lalpa thu thu a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kan awm dân apiang ṭha hlein kan ngai ṭhîn a, Mahse, Lalpan kan thiltum a ni a thlîr ber.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa -a innghatin thil ti la, I thiltum chu a tihlawhtling ngei ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tum bîk neiin Lalpan engkim a ti a, Mi sualte pawh chhiat tâwk tûra a siam an ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chapote chu Lalpa tenzâwng tak an ni a, Hrem an pumpelh hauh lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi rinawmte chu khawngaihnain an bawhchhiatna ngaihdam a ni a, Lalpa ṭih hi thil ṭha lo hawisanna a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa lawmzâwnga mi a awm chuan, A hmêlmate nên pawh an inrem ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dik lo taka neih ṭeuh ai chuan Dik taka tlêm tê neih a ṭha.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihringin a awm dân tûr a ruahman a, Mahse, amah kaihruaitu chu Lalpa a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian kaihhruaiin lalin thu a sawi a, A thu rêl chu a sual ngai lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bûkna dik leh a lung dik chu Lalpa lâwmzâwng a ni, Bâwma bûklung zawng zawng hi a siam a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Suahsualna hi lalten an ngaithei lo va, Dikna avâng chauhvin an lalna hi a nghet a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalten thu dik sawi an lâwm a, Thu dik sawi ṭhînte chu an ngaina ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lal a thinur chuan mi a that mai thei a, Mahse, mi fing chuan a thlêm dai thei.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lal hmêl a hlim chuan nun a nuam a, A duhsakna chu ṭhâl chhûm ruah pai ang hi a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Finna hi rangkachak aiin a hlu a, Hriatna pawh hi tangkarua aiin a thlanawm zâwk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi ngîlte chuan sual pumpelhna lamlian an zawh a, Fîmkhur taka kal chuan a nun a humhim ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chapona chuan boralna a thlen a, Inchhuanna chuan chhiatna a thlen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Retheite nên tlâwm taka awm hi, Chapote nêna râllâk sum insem aiin a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="20" style="v" />Remhre taka thil titu chu a hlawhtling ṭhîn a, Mahse, Lalpa -a innghah chu a hlu zâwk.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi fing chu thil hrethiam an ti ang a, Ṭawngkam thlum chu awih a nahawm ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Finna neih hi nunna hnâr a ni a, Mi sual zirtîr tum chu a âtthlâk e.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngun taka ngaihtuahin mi fing chuan thu a sawi a, A sawi chu a awihawm bîk ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ṭawngkam thlum chu a thlâra khawizu ang hi a ni, Mi a tilâwmin a tihahdam ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kawng dik nia i hriat chu, Thihna kawng a la ni mai thei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi an ṭâm chuan hna an thawk nasa a, An ril a ṭâm loh nâna thawk an ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi sual chuan thil ṭha lo a ngaihtuah chhuak a, A thu chhâk chhuah pawh mei sa ang hi a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi kawi chuan innghirnghona a tichhuak a, Se sea thu lâk chîng chuan ṭhian ṭha a tiṭhen ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi nunrâwngten an ṭhiante an bum a, Kawng dik lovah an hruai daih ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mit siaitu chuan thil ṭha lo a ngaihtuah a, Heh pettu chuan thil ṭha lo a ti dâwn a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lu ṭuak hi lallukhum mawi tak ang a ni. Mi dikte chuan an nei ngei ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi thinnel chu pasalṭha aiin a duhawm a, Khawpui hnehtu nih ai chuan mahni inhneh a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="33" style="v" />Chinchâng hriat nân ṭhum an vâwr ṭhîn a. Mahse, thu titâwptu chu Lalpa a ni.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Buh leh sa neih rei ruia chhûngkaw inngeih si loh ai chuan, Inngeih taka chaw ṭhing ei a hlu zâwk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chhiahhlawh fing chu fapa tlâktlailo ai chuan a lal zâwk ang, Unau zînga mi ang maiin pa ro a chang ve ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tangka leh rangkachak thukah an rawh thianghlim angin, Lalpan mihring thinlungte a fiah ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi sualte chuan thil sual an ngaihven a, Dawtheite chuan dâwt thu an ngaithla ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rethei nuihzattu chuan Siamtu a hmusit a ni; Chhiat a tawha diriamtu chuan hrem a pumpelh lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tu leh fate hi pate tiropuitu an ni a, Fate timawitu chu pate hi an ni bawk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi chhawih tân mawi taka ṭawng a âwm lo va, Milian tân dâwt sawi a mawi hek lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thamna hi dawi anga thiltithei nia ngai an awm a, An lekna lam apiangah hlawhtlingin an hria.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sual ngaihdam hi ngainat hlawhna a ni, Kam tam erawh chu ṭhian ṭhenna a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi â vawi za ben ai chuan, Mi fing vawi khat zilh a sâwt zâwk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi sual chuan vuivaina ngawt a zawng a, Mi nunrâwng a hnênah an tîr ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi â-in thil â tak a tih lai va tawn ai chuan, Savawm no ngai tawhchilh a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thil ṭha suala thungrûltu chu, Thil ṭha lovin an chhûngkua a chhuahsan lo vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inhnial hi tuikhuah sah tûr khi ṭan ang hi a ni a, A zual hmain titâwp ang che.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi sual thiam chantîra, Mi ṭha thiam loh chantîr chu Lalpan a haw ve ve.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi â kuta tangka awm chu eng nge a ṭangkaina? Rilru nei si lo chuan finna a lei thei dâwn em ni?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ṭhian chuan eng lai pawhin min hmangaih a, Unaute hi mangan hun atâna lo piang an ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi leiba mawhphurhsaka, Ṭhenawmte tân dahkhama ṭang chu A â hle a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thil sual lâwmtu chuan buai a duh a ni; Mi uangthuang chuan chhiatna a tâwk ngei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi kawi chuan thil ṭha a tawng lo vang a, Mi ṭawngtlahawlh chuan chhiatna a tâwk ngei ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Fa â tak neitute chu an lungngai ṭhîn, Chutiang pa chu an hlim ngai lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hlim hi hrisêlna a ni a, Ngui renga awm hi chauhna a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi sual chuan puan hnuaiah thamna a dawng a, Dik takin ro a rêl thei lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi fing chuan thil fing a ti ṭhîn a, Mi â erawh chuan kil tin a hâwl dûm ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Fa â chuan a pa a timangang a, A nu tân pawh inchhîrawm tak a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi dik lei chawitîr hi a dik lo va, Dik lohna nei si lo milian vuak lah a dik hek lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />Thil hre tam chu a ṭawng mai mai lo va, Thil hrethiam tawh rilru chu a nghet a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi â chu a ṭawng loh chuan finga ngaih a ni a, I hmui chîp la, fin i hlawh ang.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mal tlat chîng chuan amaduhzâwng chauh a ngaihtuah a, Mi dang a thurualpui thei lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi â chuan hriatna a ngaina lo va, A ngaih dân chauh sawi a duh ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sual chu mualphonain a rawn zui a, Hmingchhiate chu hmuhsit zui an ni bawk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kan thuchhuak chu lui luang ang hi a ni a, Finna tuikhur erawh chu thûk tak a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi dik chan tûr lâksaka, Mi sual duhsak a ṭha lo ve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi â ṭawng chuan inhnialna a tichhuak a, A thu chuan invuak a chawh a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi â chuan a thu a chhiat phah a, A inṭawngâwk tlat ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi rêl ser ser hi thil tui tak ang a ni, Tui kan va ti ṭhîn êm!
  </para>
  <para style="p">
    <verse number="9" style="v" />Mahni hnaa dâwngdah chîng chu Tichhetua unaupa a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa hming chu kulhpui ang a ni a, Mi dikte an tlân lût a, an him ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hausa tân a hausakna chu kulhpui ang a ni a, Lung bang sâng tak angin a ngai.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chapona chu chhiatnain a zui a, Ropui hmain tlâwm a ṭûl ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngaihthlâk hmaa chhân chu, A âtthlâkin a zahthlâk ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dam loh pawhin dam duhna hian beisei min neihtîr a, Dam duhna a bo tawh chuan tu nge dam thei ang?
  </para>
  <para style="p">
    <verse number="15" style="v" />Rilru nei rên râwnten hriatna an neih belh a, Mi fingte chuan hriatna an ngaihven ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thilpêkin kawng a tikaw thei a, Milian hmaah pawh awlsam taka luh theihna a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thubuai sawi hmasatu chu thiam hlein a lang ṭhîn, A rawn chhâl lêt an awm hma chu.
  </para>
  <para style="p">
    <verse number="18" style="v" />Milian an inkhin chuan ṭhum vâwr ila, Ṭhen theih an ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />I unau ṭanpui la, kulhpui angin a hum ang che, In inhau erawh chuan kawng a kalh hnan ang che.
  </para>
  <para style="p">
    <verse number="20" style="v" />I thu sawi avângin i puar ang a, I thu azirin i tlai ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nunna emaw, thihna emaw a hring thei a, I thu sawi mawh chu i phur ngei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nupui zawng hmu chuan thil ṭha tak a hmu a ni, Lalpa duhsakna a dawng ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi rethei chuan khawngaih thla la takin thu a sawi ṭhîn a, Mi hausa erawh chu a ṭawng chaltlai hle ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ṭhian ṭha ni âwm taka lang an awm a, Unau aia ṭhian nghet an awm bawk ṭhîn.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi â dawthei tak nih ai chuan, Mi rethei, ngîl taka nung nih a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hriatna nei si lova phûr viau hi a ṭha lo ve, Hmanhmawh chuan a dai sual ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi ṭhenkhatin an ât an chhiat phah a, Lalpa an dem leh si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausak hi ṭhian ngahna a ni a, Retheihna hian ṭhian a tiṭhen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thuhretu der chu hrem a ni ang a, Dâwt sawi chuan hrem a pumpelh lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Milian tlawntu an tam hle a, Mi thilphalten ṭhian an ngah ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi rethei chu a unau zawng zawng pawhin an nin chuan, Ṭhian a nei zo lo pawh a mak lo ve. Neih tum chiam mah se, a hmu zo lo vang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Finna neih tum hi mahni induhsakna a ni a, Hriatna ngaihlu chuan a ṭhatpui ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thuhretu der chu hrem a ni ang a, Mi dawthei chu a boral ngei ngei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sâng taka khawsak hi mi â tân a mawi lo va, Chhiahhlawh tân milian chunga thuneih a âwm hek lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi fing chu a thinur duh lo va, Chêksawlhna a haider hi amah tiropuitu a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lal thinrim chu sakeibaknei rûm ang hi a ni a, A duhsakna erawh chu hnim chunga dai tla ang hi a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Fapa â chu a pa tân chhiatna a ni a, Nupui âncheh chu in chung far reng ang hi a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />In leh lote hi pate ta kan rochun a ni a, Nupui fing erawh chu Lalpa min pêk a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi thatchhia chuan mut an duh a, Mi dâwngdah chu a ṭâm ngei ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thupêk zawm hi mahni inhumhimna a ni a, Thu awih lo chu a thi ngei ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Rethei khawngaih hi Lalpa hnêna thil pûktîr ang a ni, I thiltih ang chu a rûl leh ngei ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Beiseiawm a la nih laiin i fa chu thunun rawh, Chutilo chu, a chhiat i duh tihna a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi thinchhia chuan a thinchhiat rah a seng ang a, Chhan ṭhîn mah la, chhan leh ṭhin a ṭûl ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thurâwn ngaithla la, kaihhruaina zâwm rawh. Engtikah emaw chuan i la fing ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihringin thil tam tak an ruahman a; Mahse, Lalpa remruat chauh a dingchang ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihring hi rinawm taka awm tûr a ni, Dâwttheih ai chuan retheih a ṭha.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa ṭih hi nunna a ni a, A lungawithlâk a, Thil ṭha lovin a tlâkbuak lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thatchhia chuan thlêng zen chu a peih a, Mahse, a bâr peih lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pawisak nei lo chu vua la, mi mâwlin a fin phah ang. Mi fing zilh la, hriatna a ngah sawt ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pate rawka nute hnawtchhuaktu chu, Fa zahpuiawm, mualphona tâwpkhâwk thlentu a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka fapa, thununna i zir zawm loh chuan, I hriat sa pawh i theihnghilh mai ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thuhretu sual chuan dik taka rorêl a ngainêp a, Mi sualte chuan dik lohna hi an duhzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pawisak nei lote chu thiam loh chang sa an ni a, Mi â-te chu an hnungzânga vuak tûr an ni.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zuin mi a tiuang a, Rakzuin buaina a tichhuak. Zu rui mi fing an awm ngai lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lal thinur chu sakeibaknei rûm ang a ni a, Tithinurtu chuan a nun a chân ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Intihbuainaa tel loh hi pa zahawm nihna a ni a, Mi â-te chu an inrawlh zen ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thatchhia chuan a hunah lei a rît peih lo va, Buh seng tûr zawng mah se a nei lo vang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihring ngaihtuahna hi li thûk tak ang a ni a, Mahse, mi fing chuan a dâwp chhuak thei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rinawm tak nia insawi an tam hle a, Rinawm tak tak tu nge hre chhuak thei ang?
  </para>
  <para style="p">
    <verse number="7" style="v" />Dik tak leh ngîl taka nung ṭhîn Fate chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rorêl tûra lal a ṭhutin Thil dik lo chu a hmu nghâl ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />‘Ka thinlung a thianghlim a, sual lakah ka fihlîm,’ Tu nge ti thei?
  </para>
  <para style="p">
    <verse number="10" style="v" />Bûklung rit hlei te, Tehna no lian hlei te Lalpa tenzâwng a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naupang pawh a thiltihah a zia a lang, Mi ṭha a ni emaw, mi dik a ni emaw a hriat theih ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Beng thil hre thei, mit thil hmu theite hi Lalpa siam an ni e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mut heh hle suh, i rethei dah ang e, I mit meng la, ei tûr i nei ṭeuh vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />‘A to mang e,’ thil leitu chuan a ti ṭhîn a, Mual an liam a, an lei tlâwmzia an uanpui ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rangkachak leh lunghlu chu a tam hle a, Thu fing tak chu lungmawi vâng tak ang a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmêlhriat loh leiba rulhsak tiamtu kawr chu Dahkham atân lâksak mai rawh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thil ei rûk chu a tui hle a, Mahse, kâa ṭiaulung khat ṭûn ang hi a la ni ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil ruahman laiin ngun taka ngaihtuah tûr a ni, Remruat diam hnuah chuan indo ṭan tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi ṭawng duh, lên heh chuan thurûk a puang ṭhîn a, Mi kamtam chu kâwm suh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nu leh pa ânchhe lawhtu chu Thima khâwnvâr mit ang hi a la ni ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Awlsam taka sum leh pai neih mai theihte hi A tâwpah chuan a hlâwk lem lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />‘Thil sual ka thungrûl ang,’ ti mai teh suh, Lalpa chu ngaichâng la, a rawn chhan ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bûklung inang lo hi Lalpan a ten a, Bûkna dik lo a ṭha hek lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kan ke pênte hi Lalpa ruat a ni, Tu nge kan kalna tûr hre thei ang?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngaihtuah chiang lovin thilhlan Pathian hnêna pêk tiam suh, I tiam hnuah i la inchhîr leh dah ang e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lal fing chuan mi sual a hmu thuai a, Tawlailîr a la chîltîr ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpan mihring chhûngah khâwnvâr a dah a, Thinlung chhûngril a chhun chhuak vek a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ngilneihna leh zahawmna hi lal humhimtu a ni a, Dikna avângin a lalṭhutthlêng a nghet a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tlangvâl ropuina chu an chakna hi a ni a, Upa mawina pawh an lu vâr hi a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na taka vuakna hian sual simna a thlen a, Vuak nek hian chhûng lam a tithianghlim thei.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lal rilru hi Lalpa thu-a awm a ni a, Lui tui a duh duha a luantîr ang hian a tidanglam ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mahni awm dân hi ṭha hlein kan hria a, Mahse, Lalpa chhui chu thinlung hi a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thil dik tih leh dik taka rorêl hi, Inthawina aiin Lalpan a duh zâwk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Induhna te, chaponate hi mi sual kaihruaitu a ni a, Chu chu thil sual a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi taima thiltum chu a hlawhtling ṭhîn a, Thil ti rum rum mi chu a hlawhchham ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dâwta intihhausak chu chhûm Ral mai ang hi a ni, thih a chawh bawk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi sual nunrâwnna chu an chungah a tla ang, Thil dik an tih duh loh avângin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thiam loh changte rilru chu a kawi a, Mi ṭhate chuan thil dik an ti ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nupui âncheh tak nêna in khata chên ai chuan, In chung zâwl kila awm a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sualte chuan thil sual an duh reng a. Lainatna an neih rêng an ṭhenawmte pawhin an hmu lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hmusittuten hrem an tuarin, mi mâwlten an fin phah a, Zirtîrna dawngtu mi fing chuan a hriat belh ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi Dika chuan mi sual chhûngkua a hmu reng a, Mi sualte chungah chhiatna a thlentîr ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi rethei thu ngaithla duh lotu chu, A mangang au an ngaithla bîk lo vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thilpêkin thinrim a thawi dam a, Thinur viau pawh a rûka thamnain a beng dai ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dik taka rorêl a nihin mi ṭha an lâwm a, Mi sualte tân chuan hnâra khawn ang a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pianpui finna hmang duh lotu chu Mitthi zîngah a awm thuai ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nawmchen thlahlel chu a pachhia ang a, Zu leh sa ngaina chu a hausa lo vang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi sual chu mi dik tlan nân an hmang ang a, Mi bum hmang pawh mi nun ngîl tlan nân.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nupui âncheh leh thinchhe tak bula awm ai chuan, Thlalêra awm a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi fing inah chuan sum leh pai hlu tak tak a awm ṭeuh va, Mi â-te erawh chuan an ei zo zêl.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi ngilnei, dik taka thil ti ṭhîn chu, A dam rei ang a, a hmuingîlin miin an zah ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hotu fing chuan mi huaisente kulh a la mai thei a, Inhumhim nâna an hman chu a chhu chhe ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />I hmui leh i lei vêng la, Buaina i pumpelh ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi chapo leh mi inchhuang chu ‘Hmusittua,’ an ti, Chapo takin a inluling ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi thatchhia chuan eng mah a thawk peih lo va, Rualawt rêng rêngin a thi ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nilêngin mi thil a awt ngawih ngawih reng a, Mi ṭha erawh chuan ui nei lovin thil a pe ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi sual inthawina chu a tenawm a, A inthawi chhan a sual phei chuan a tenawm lehzual ṭhîn.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thuhretu der chu hnâwl a ni ang a, Chîk taka ngaihtuah mi thu chu pawm a ni fo vang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi sual chu a meng rum ṭhîn a, Mi dik erawh chu a nghet chat ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Finna te, thiamna te, remruatna te, Lalpa kalh zawng chu eng mah a ni lo vang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sakawr chu indona atân buatsaih a ni a, Mahse, hnehna chu Lalpa thu a ni.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hausak viau ai chuan hmingṭhat duh zâwk tûr a ni. Tangka leh rangkachak aiin mi ngaihsân nih a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hausak leh retheih inanna chu, Pathian kutchhuak an ni ve ve.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi fing chuan hlauhawm a hmuhin a biru a, Mi mâwl erawh chuan a tâwn mai a, a tuar phah ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Inngaitlâwm la, Lalpa ṭih rawh, Hausakna te, ropuina te, nunna te i nei ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi kawite kawng chu hlîng leh thangin a khat a, Invêng ngun la, hawisan daih rawh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naupang chu awm dân ṭha zirtîr la, A upat hnuah pawh a thlah lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hausaten retheite chungah thu an nei a, Pûktu chu pûktîrtu chhiahhlawh a ni mai.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hleih neih chîng chuan buaina a tâwk ang a, Thinura mi chunga tiang lek ṭhîn chu a tliak ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi ngilnei, retheite ei tûr pe ṭhîn chuan Malsâwmna a dawng a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi chimawm chu hnawt bo la, Inhnialna te, buaina te, inhauna te a reh mai ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpan thinlung thianghlim a ngaina a, Hawihhâwm taka ṭawng ṭhin hi lal ṭhian nihna a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpan hriatna dik nei mi chu a hum tlat a, Dawtheite thu erawh chu a paihthla ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thatchhia chuan, ‘Pâwnah sakeibaknei a awm, Ka chhuah chuan min seh mai ang,’ a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hmeichhe sual thu chu hum thûk tak ang a ni a, Lalpa huatzâwngte chu an tla lût ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Naupangte hi â hle mah se, Tianga vuak reh hlauh theih a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hausak duh vânga mi rethei tiduhdaha, Mi hausa tlawn chu tlâkranna a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi fingte thu sawi hi bengsikin ngaithla la, Ka zirtîr ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />I hriat reng chuan i lâwm hle ang a, A ṭûl hunah i sawi chhâwng thei ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa rin tlat theih nân, Vawiinah hêng hi ka hrilh che a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hêng zilhna thu leh hriat tûr sawmthum hi Ka ziak chhuahsak che a, Hetah hian remruat dân ṭha a chuang a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thu dik hi eng nge a nih tih a zirtîr ang che; Thu dik hmu chhuak tûra an tirh hunah che, A chhânna tûr dik tak i hre thei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi rethei chu an pachhiat avângin an thil chhuhsak suh, Rorêlnaa ṭanpuitu tûr nei lo chu rapbet suh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpan a rawn ṭan ang a, Rapbettu chu a rawn rapbet ve ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thinchhia kâwm suh la, Mi thinram ṭhian hek suh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chutilo chu, an awm dân i la ang a, I inâwk buai mai ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi leiba rulhsak tiam suh la, Dahkhamah ṭang hek suh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pêk tûr i neih loh hlauh chuan, I mutna khum chenin an lâksak ang che.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hmânlaia in puten ramri an kham chu sawn suh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi themthiam chu lalin a ruai ang a, Mi narânin an chhawr phâk ve lo vang.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Milian nên chaw in kîl dâwnin, I hmaa ṭhu chu en ngun rawh,
  </para>
  <para style="p">
    <verse number="2" style="v" />I ril a ṭâm hle pawhin insûm deuh la,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ei tûr tuihnai a hlui che chu, A bum tumna che a ni mai thei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausak tumin inhmang zo suh, Inkhêk deuh la, a fing zâwk ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hausakna chu i hmuh veleh a bo mai ang, Thla a nei ta emaw tih tûr a ni ang a, Mupui angin vân lamah khian a thlâwk bo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khawhringneite chawhlui kîl suh la, Ei tûr tuihnai a neih chu ît hek suh.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Ei la, in teh,’ a ti ang che a, Duhsak tak tak si lo chein, Tum nei ru râna thil ti a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />I thil ei chu i luak chhuak leh ang a, Amah i fakna chu a thlâwn mai a ni ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi â zilh suh, i thu fing chu Engah mah a ngai lo vang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ramri awm sa chu sawn suh la, Fahrahte ram chhuhsak hek suh.
  </para>
  <para style="p">
    <verse number="11" style="v" />An tlantu chu ropui tak a ni a, Anni chu a ṭan ang a, a khing ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />An zirtîrna che chu ngai ngun la, Thil hriat tûr chu ngaihven rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naupang chu thunun lohvin zuah suh, I vuak avângin a thi lo vang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tiang i lek ṭhin chuan, A nunna chu Seol aṭangin i chhan chhuak dâwn a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka fapa, i fin chuan kei hi mi lâwm ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thufing i phuh chhuah leh ka lâwm êm êm ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi sualte chu awt rilru suh, Ni tin Lalpa ṭih i chîn chuan
  </para>
  <para style="p">
    <verse number="18" style="v" />I tân a la ṭha ang a, I beisei chu a thlâwn lo vang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka fapa, ngaithla teh, fing la, I awm dân hi ngaihtuah ngun teh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zu heh mi zîngah awm suh la, Sa heh mi kâwm hek suh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zu heh leh sa heh mi chu an pachhia ang a, Ruih chîng chuan kawr ṭet a ha ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hringtu che i pa thu chu awih la, I nu a tar hnuin hmusit hek suh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thu dik te, finna te, kaihhruaina te, hriatna te lei rawh, Hralh leh tawh suh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi dikte pa chu a hlim ang a, Fapa fing neitu chu a lâwm hle ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />I nu leh pain chhuang hle che sela, A paitu che tihlim ṭhin rawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka fapa, ka thu hi awih la, Ka nun dân hi entawn ang che.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi hur leh nawhchizuarte hi Thang hlauhawm tak an ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Suamhmang angin mi an châng a, Mihring zîngah mi rinawm lo an pun phah ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tute nge ninawm tak, che pawr hle ṭhîn, Buaipuiawm tak, vui reng mai si, A ṭûl lova pem pheng phunga, Meng sen rêm rûm ṭhîn le?
  </para>
  <para style="p">
    <verse number="30" style="v" />Zu in reng mai, Zu chi hrang hrang chawhpawlh hrâtte hi an ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zu sen lang mai, îtawm taka nova tling, Lem nuam âwm tak ni mah se, Melh duh hauh suh ang che.
  </para>
  <para style="p">
    <verse number="32" style="v" />A tûkah chuan rûl tûr neiin A chu ta che emaw i ti ang a,
  </para>
  <para style="p">
    <verse number="33" style="v" />Thil mak pui pui i hmu ang a, I rilru a buai ang a, i riat nuah nuah ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lawng ngul lêra awm, inthên inthên, Lawng rui angin i inhria ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />‘Min tithal dêr mah se, pawi ka ti lo, Leiah let dêr mah ila a pawi hlei nêm, Ka ṭhanharh hunah chuan, Ka in leh bawk ṭhîn ang,’ i ti ang.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi sualte awt suh la, An zînga tel châk bawk hek suh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Buaina tihchhuah dân an ngaihtuah ber a ni, Pawi khawih dân tûr tui takin an sep ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Finna leh inhriatthiam tawnnaah Chhûngkua chu a indin nghet a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Hriatna avângin thil hlu leh mawi tak tak, Pindan chhûngah a khat vek ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Fin hi chak ai chuan a ṭha, Hriatna hi âwmkhauh aiin a ṭha bawk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Indo hmain ngun taka râlrêl a ṭûl a, Remhria an tam chuan hmêlma an hneh nge nge ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi chhawih tân thufing a ril lutuk a, Thupui vainaah sawi tûr a nei phâk lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil ṭha lo hlîr suangtuahtute chu, ‘Pawi khawih hmang’ an ti ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi â remruat apiang thil sual a ni zêl a, Mi dang hmusittu chu mi tenawm a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mangan nia i chauh mai chuan, Chakna rêng i lo nei lo a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dik lo taka tihhlum tûrte chu chhan la, Thah mai tûra an hruai hlawk hlawkte chu ensan mai suh.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘Ka hriat ve chi a ni lo ve,’ ti suh, Thinlung entu chuan a hria a ni lâwm ni? Vêngtu che chuan a hre vek a, Mi tin an thil tihsual ang zêlin a thungrûl ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka fapa, khawizu in rawh, a ṭha a ni, A thlâra luang a thlum bîk ang hian,
  </para>
  <para style="p">
    <verse number="14" style="v" />I tân finna pawh a thlum ang, Finna nei la, i tân a la ṭha ang, I beisei pawh a thlâwn lo vang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi sualte angin mi dikte in suam tum suh la, An chênna in tihchhiatsak bawk hek suh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi dik zawng vawi sarih tlu mah se a tho leh ang, Mi sualte erawh chu thil ṭha lovin a titlu hlen vang vang ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I hmêlmate an tlûkin lâwm suh la, An petekin hlim bawk hek suh,
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpan a hmu hlauh dah ang che a, a lâwm lo vang e, An chunga a thinurna a hnûk kîr ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi sualten i rilru tibuai suh se, An sualna chu awt hek suh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi sualte chuan ṭhat ni an nei lo vang a, An khâwnvâr chu tihmihsak a ni ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka fapa, Lalpa ṭih la, lal zah thiam rawh, An laka hel duhte kawp suh,
  </para>
  <para style="p">
    <verse number="22" style="v" />An chungah chhiatna a lo thleng thut mai ang, Chhiatna thlen theitu an ni ve ve si a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hêng pawh hi mi fing thu sawi a ni, Rorêlnaa mi zahzâwng neih hi a ṭha lo ve,
  </para>
  <para style="p">
    <verse number="24" style="v" />‘I ti dik e,’ mi sual hnêna titu chu Ânchhia an lawh ang a, mi tinin an hua ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi sual kamkhattu chu miin an lâwm ang a, Malsâwmna a dawng ang a, a hming a ṭha bawk ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thu dik taka min chhâng ṭhîntu chu Ṭhian ṭha a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pâwn lama i hna tifelin i lo lam te tifel hmasa la, Tichuan, i in tûr chu sa rawh.
  </para>
  <para style="p">
    <verse number="28" style="v" />I ṭhenawmte dâwtin hêk suh la, Ngaih kawih theihin an chungthu sawi hek suh.
  </para>
  <para style="p">
    <verse number="29" style="v" />‘Min tih angin a chungah ka ti ve ang, A sualna chu ka thungrûl dâwn,’ ti bawk hek suh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi thatchhe lovah ka va kal a, Mi tlawktlaw grep huan chu ka va fang a,
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngai teh, hlîng a lo khat vek a, Kângṭhaiin a khuh lûk a, A lung palte a lo chim rem rum mai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chûng chu ka han en chuan ka ngaihtuah a, Zir tûr ka chhar ta a.
  </para>
  <para style="p">
    <verse number="33" style="v" />I duh chuan han mu hlek ta che, Han châwl hahdam hlekin Kut hûmin zâl teh rêng:
  </para>
  <para style="p">
    <verse number="34" style="v" />Retheihna chu rûkru angin a lo kal thuai ang a, Pachhiatna chuan sipai angin a rawn nang vat ang che.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hêng pawh hi Solomona thufing, Judai ram lal Hezekia hoten an ziak chhâwn a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil thup hi Pathian ropuina a ni a, Thil hmuh chhuah hi lal ropuina a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vân sânzia te, tuifinriat thûkzia te angin, Lal rilru pawh hriat chhuah rual a ni lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tangkaraw êkchhia paih la, Thil chhertuin thil mawi tak a chher thei tawh ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lal kiang aṭangin mi sual hnawt bo la, A ramah dik taka rorêl a ni ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lal hmaah intivei suh la, Milian zîngah tel chîng hek suh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aia milian ṭhutna kian tûra tih nih ai chuan, Ṭhutna ṭha zâwka ṭhu tûra sâwm nih a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="8" style="v" />I thil hmuh thubuaiah thlen mai suh, Thu hre chiang zâwkten an rawn sawi leh si chuan, Engtin nge i tih tâk ang?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ṭhenawmte nên inhnial inhnial mah ula, Mi dang thurûk chu puangzâr suh,
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutilo chu, a lo hriaten an dem ang che a, I hmingchhiat a reh lo vang.
  </para>
  <para style="p">
    <verse number="11" style="v" />A hun taka thu sawi chu, Rangkachak mûm tangkaruaa phûm ang a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi fing zilhna chu ngaithla duhtu tân chuan, Rangkachak ṭha ber zungbun leh ṭhi aiin a ṭha.
  </para>
  <para style="p">
    <verse number="13" style="v" />A tîrtu tân palai rinawm tak chu, Ni sen sat laia vûr tui ang hi a ni. A tîrtu chu a tiharh sawng sawng ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pêk tiam si-a pe si lotu chu, Ruah pai lo chhûm, thli chhêm lên ang hi a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zai dawh taka thlêm heuh heuhvin lalte an tilungawi a, Khauh hle mah se, thu nêmin a hneh thei.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khawizu i tawn chuan a tâwk chauh in rawh, Chutilo chu, a ngei ang che a, i luak mai ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ṭhenawm inah lêng lutuk suh, A ning ang che a, a haw hlauh dah ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mahni ṭhenawm dâwta hêktu chu Tuboh leh khandaih ang a ni, thal zum tak nên.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mangan nia mi bum chîng chunga innghah chu, Ha nghînga thil ṭhial leh ke na chunga kal ang a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi lungngai bula hla sak chu, Khaw vawh nia kawr hâk phelh leh chingala pem sil ang a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />I hmêlma a rilṭâm chuan ei tûr pe la, A tuihâl chuan in tûr pe rawh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tichuan, sen awp awp khawpin i tizak ang a, Lalpan a rûl ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmâr thliin ruah a rawn thlen ang hian, Inrêl rûk hian thinrim a tichhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nupui phunchiar tak nêna in zau taka awm aiin, In chung zâwl kila awm a ṭha.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ram hla tak aṭanga thu lâwmawm hriat chu, Mi chau tân tuisik ang a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi sual hmaa mi dik tlâwm chu, Tuihna nu leh tuikhur bawlhhlawh ang hi a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khawizu in tam lutuk a ṭha lo ve, Fak hlawh tum luattuk pawh a ṭha hek lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mahni inthunun thei lo chu, Khaw kulh bang chim ang hi a ni.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipuia vûr tla leh buh seng laia ruah sûr a inhmeh lo angin, Mi âten chawimawi an inhmeh lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sava thlâwk leh vamûr lêng lai an fu lo ang hian, A chhan awm lovin ânchhia pawh i dawng lo vang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sakawr chu vuak a ngai a, Sabengtung lakam barh a ngai a, Mi â hnungzâng pawh vuak a ṭûl a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawhna â tak tak i chhân zêl chuan, Nang pawh a zâwttu ang bawka â i ni ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi â chu a ât dân ang lekin chhâng la, Chutilo chu, fing hlein a inngai ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi â zualkova tîrtu chu, Mahni ke tan ang mai a ni, a tuar ngei ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi â tân chuan thufing hi, Ke zeng, thên mai mai ang hi a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi â chawimawi chu a sâwt lo, Sairawkherha saihlum ṭâwn beh ang a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi â tân thufing phuh chhuah chu, Zu ruiin a kuta hlîng khei a tum ang hi a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi â veivâk nazawng leh zu rui ruaitu chu, A hmuh apiang thala kâp hliamtu ang hi a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi â-in thil â tak a tih nawn chuan, Ui-in a luak a ei leh ang hi a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Fing si lova fing hlea inhria ai chuan, Mi â tak chan a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thatchhia chuan, ‘Kawngah sakei a awm, Tualah sakeibaknei a awm,’ tiin a pâwnchhuak ngam lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kawngkhâr kawpzaa a her ang hian, Thatchhia chu khumah a her vêl ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thatchhia chuan chawthlêng a zen a, A bâr leh peih si lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil chhût thiam mi pasarih aiin thatchhia chuan fingin a inhre ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tel ve lohna tûra lo inrawlh chu, Ui tual lêng benga man tum ang a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi â-in meichher te, thal te, hriam te A khawih a khawih chuan thih theihna mai a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mahni ṭhenawmte buma, ‘Ka fiamthu a nih kha,’ titu ang hi a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thing a awm loh chuan mei a thi a, Se se-a thu lâk chîng an awm loh chuan buaina a reh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Meihawl a tam leh a ling a nasa a, Thing a tam leh a alh ṭha ṭhîn, Mi phunchiar tamnaah buaina a punlun ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi rêl hi thil tuihnai tak ang hi a ni, Tui kan va ti ṭhîn em!
  </para>
  <para style="p">
    <verse number="23" style="v" />Kam ṭha êm êm thinlung sual si chu, Hlumbêl an hnawih tlêt ang hi a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi vervêkin a huatzâwng chu, Ṭawng ṭhain a khuh ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />A ṭawngkam a tihthlum hle chuan ring suh, A thinlungah tenawm pasarih a awm a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A rilru chhia chu thup mawi mah se, A sualzia chu pung khâwm zîngah a la lang ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />A hum laihah chuan amah a tla ang a, A lung lum chuan amah a la delh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi dawthei chuan a bumte a lo haw hle ṭhîn a ni, Fak der chîng chuan chhiatna a thlen.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Naktûka i awm dân tûr uanpui lâwk suh, Eng nge lo thleng dâwn i hre si lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi dangin fak che rawh se, Nangmah zawng infak suh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lung leh ṭiauvut hi a rit hle a, Mi â thinur chu a tawrhhlelhawm zâwk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thinurna tuar hi a hrehawmin a rit a, Îtsîkna erawh hi chu tu nge tuar zo vang?
  </para>
  <para style="p">
    <verse number="5" style="v" />A langa inzilhhau hi A rûka hmangaih ai chuan a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmangaihtu ben chu ṭhatna tûr a ni a, Hmêlmaten min lawm hûrh chuan fîmkhur a ṭha.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puar hle lai chuan khawizu pawhin min ngei a, Rilṭâm tân chuan thil kha tak pawh a thlum.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mahni bu awplum lo sava leh Mahni in leh lo ngaihsak lo chu an inang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hriak leh têl rimtuiin mi a tilâwm a, Ṭhian ṭha thurâwn fing pawh a lâwmawm ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />I pa ṭhian leh nangma ṭhian chu thlauhthla suh, Buaina a lo thlenin unaute kher pan suh, Unau hla taka awm aiin ṭhenawm hnai an ṭangkai zâwk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka fapa, fing la, kei ka lâwm ang, Min deutute ka chhâng let ve thei dâwn nia.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi fing chuan hlauhawm a hmu lâwk a, Mi â erawh chuan a tâwn mai a, a tuar phah ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmêlhriat loh ba rulhsak tiamtu kawr chu, Dahkham atân lâksak mai rawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zîng taka mi kaithova, Ring taka chibai bûk chîng chu, Ânchhia anga ngaih a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nupui âncheh tak chu, Khawchhiat ni-a in far reng ang hi a ni a,
  </para>
  <para style="p">
    <verse number="16" style="v" />Tihreh tum chu thli tleh lo dan tum leh Sahriak hûm tum ang hi a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thîrin thîr a tihriam a, Mihring pawhin mi dang hnên aṭangin a zir ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Theipui kûng chu enkawl ṭha la, a rah i ei ang, Chhiahhlawh, a pu thu awih chu, chawimawi a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuiah thla kan hmu ṭhîn angin, Mihring thinlung pawh a nunah a lang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Seol leh Abadon chuan tâwk tih lêm an nei lo angin, Mihring mit pawhin tâwk tih a nei lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thukah tangka leh rangkachak an rawh thianghlim angin, Mihring hmingṭhatna pawh fiah a ngai ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi â âtna chu sumah buh nên dêng nek mah la, A âtna chu a kiang chuang lo vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />I berâm rual chu fîmkhur takin enkawl la, I ran rual chu ngaihven ṭha rawh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hausakna hian a daih kumkhua lo va, Lalna pawh hian chhuan tam a daih lo asin.
  </para>
  <para style="p">
    <verse number="25" style="v" />Buhpâwl ât la, a chawr leh hma ang a, Tlâng hnimte zai bawk ang che.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tichuan, i berâm hmulte i sin ang a, I kêl man chuan ramte i lei thei ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />I kêl hnutete chu a tam ang a, i tlân ang a, I chhûngte leh i awmpui nulate ei khawp a tling bawk ang.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi sual chu ûm lohvin a tlânchhia a, Mi dikte erawh chu sakeibaknei angin an ngam.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ramin thil a tihsual chuan hruaitu an inthlâk zut a, Hruaitu fing leh remhriate avângin hnam a ding chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lal sual, rethei tiduhdahtu chu, Ruahpuivânâwn, buh nan chhetu ang hi a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dân pawisa lotu chuan mi sual a ṭan a, Pawisatu erawh chuan a kalh a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi sual chuan dik taka rêl dân a hre lo va, Lalpa zawngte erawh chuan engkim an thliar thiam ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rethei mah ila ngîl taka nun hi, Hausa hlea kawi taka nun ai chuan a ṭha.
  </para>
  <para style="p">
    <verse number="7" style="v" />Fapa fing chuan Dân a zâwm a, Mi vîr kâwmtu chuan a pa a tizak ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />A pung ûma hlêp ṭeuh ṭeuhva intihausate chuan, Rethei khawngaih ṭhîntute tân an khâwlsak mai a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dân thu ngaithla duh lotu chu, A ṭawngṭaina pawh tenawm a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi ngîl thil sual tihtîrtu chu, Ama hum laihah chuan a tla ang a, Mi ṭha erawh chuan thil ṭha a dawng ngei ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hausa chuan fing a inti hle a, Rethei fing chuan a hmu tlang ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi dik an lal chuan mi an hlim êm êm ṭhîn a, Mi sual an lal chuan an bibo dial ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />A bawhchhiatna zêptu chu a hmuingîl lo vang a, Inpuanga sim erawh chuan zahngaihna a hmu ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa ṭih fotu chu a nihlawh e, Mi luhlul erawh chu a vânduai ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rorêltu sual chu mi rethei tân, Sakeibaknei rûm leh savawm vâk ruai ang hi a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hruaitu hriatna tlachham chu a râwng hle ṭhîn, Duhâmna hawtu chu a dam rei ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tualthattu chu a tualtlân vat ṭhîn, Tu man lo hum suh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi rinawm chu a him ang a, Mi rinawm lo chu a tluchhe thuai ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mahni lo thlo taima chuan buh a ngah ang a, Awm mai mai chu an pachhe ngei ngei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi rinawmte chuan malsâwmna an dawng ṭeuh vang a, Hausak thut tumte erawh chuan an tuar ngei ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Duhsak bîk neih hi a dik lo va, Mahse, thamna chhetê vânga thil dik lo tih duh an awm.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi huamhap chuan hausak thuai an tum ṭhîn a, Tlâkchham hun tûr a awm thei tih an dâwn pha lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi fak der ai chuan zilh la, A la lâwm zâwk ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nu leh pate thil rûksaka, pawiti si lo chu, Suamhmang ṭhian a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi duhâm chuan innghirnghona a tichhuak a, Lalpa ringtu chu a hmuingîl ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mahni inrin viau hi a âtthlâk hle, Mi fing thu zâwmtu erawh chu a him ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Rethei ṭanpui la, tlâkchham i nei ngai lo vang, Pachhia maimitchhînsantu chu ânchhia an lawh huai huai ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi sual an dinchan chuan mi an ṭi dêk a, An chhiat erawh chuan mi dik chan a ṭha ṭhîn.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zilh fo tawh pawha luhlullui zêl chu, Dan rual lohva tihchhiat rup a ni ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi dik an lalin mi an hlim a, Mi sualin ro an rêlin mi an rûm ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Finna ngaina chuan an pate an tilâwm a, Nawhchizuar kawptu chu an intlakral ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dik taka lalin ro a rêl chuan ram a ding chhuak a, Thamna ngawt a ngaihtuah chuan ram chu a tluchhe ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ṭhenawm fak der chîng chuan, Mahni awhna tûr thang a kam a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi sual chu a sualnain a âwk ṭhîn a, Mi dik erawh chu hlim takin a zai ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi dik chuan rethei ngaihsak nachâng a hria a, Mi sual erawh chuan a hre ve lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pawisak nei lote chuan khua an chawk buai a, Mi fingte erawh chuan an vawng dai ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi fingin mi â a khin chuan, Mi â chuan a ânkhum a, Bâng lêk lovin a nuihzat ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thisen chhuah chîng chuan mi dik a hua a, Mi ngîl erawh chuan mi dik nunna hum a tum ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi â chuan a thinur a thup thei lo va, Mi fing chu a insûm a, a pal dai ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rorêltuin dâwt a bengkhawn zêl chuan. A ṭhuihruaite chuan dâwt an chîng mai ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi rethei leh amah tiduhdahtu chuan inanna an nei, Lalpan hmuh theihna mit a neihtîr ve ve.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi rethei chungthu dik taka rêl ṭhîn lal chuan, A lalna chu kumkhuain a tinghet ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Talhfiak leh thununna hian mi a tifing a, Naupang, duh duha tla chuan a nu a tizak ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi sual an lal chuan sual a pung a, Mi dikte chuan an tlûkchhiat hun an hmu ngei ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I fa chu thunun ṭha la, i hahdam ang a, I thinlung tilâwmtu a la ni ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian hruai loh hnam chu an boral ṭhîn, Pathian Dân zâwm hnam erawh chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chhiahhlawh chu thu maia siam ṭhat theih a ni lo, Hre kur mah se, a zâwm chuang lo vang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pâwng ṭawng zung zung chîng mi ai chuan, Mi mâwl chan a la ṭha ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />A naupan têt ata chhiahhlawh chu i duat lutuk chuan, I chungah thu a la nei mai ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thinchhia chuan buaina a chawk chhuak a, Thinram chuan pawi a khawih rem rum ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chapona hian mi a titlâwm a, Inngaihtlâwmna hian mi a chawimawi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rûkru kawptu chuan mahni hmêlmaah a insiam a, Chhia a chham a, thu dik a sawi leh si lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihring hlauhna hian mi a phuar ṭhîn a, Lalpa rin erawh chu a muanawm a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tam takin rorêltu duhsak nih an duh a, Lalpa erawh chuan mi ro dik takin a rêlsak ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi dikte chuan mi sual an ten a, Mi sualte chuan mi dik an hua.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakea fapa Agura thuchah : Chu mi thuchhuak chuan heti hian a ti: Pathianin min awmpui lo, Pathianin min awmpui lo va, eng mah ka ti thei lo,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi azawngah ka mâwl a, An fin angin ka fing ve lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Finna ka zir lo va, Mi Thianghlima ka hre hek lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tu nge thli hum khâwm theia, Puana tui fûn thei awm? Lei huam chin hi tu nge ri siam? A hming i hria em? A fapa hming pawh i hria em ni?
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian thu tinrêng hi a rin tlâk a, Amah bêltute tân phaw a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thute chu belhchhah hauh suh, Chutilo chu, a hau ang che a, Mi dawthei i ni dah ang e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka thih hma hian thil pahnih ka dîl a che, Mi hnial lul suh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Thu lawilo leh dâwt lakah min hum la, Min tihausa lo la, min tipachhe hek suh, Ka ei tûr tâwk min pe ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka tlai luat chuan ka phat ang che a, ‘ Lalpa in tih hi tu nge ni?’ ka ti vei dah ang e. Ka pachhiat luat lahin rûk ka ru ang a, ka Pathian hming ka tihliau dah ang e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chhiahhlawh chu a pu hnênah rêl suh, Ânchhia a lawh ang che a, thiam loh i chang dah ang e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mahni pate ânchhe lawh duh an awm a, Mahni nute duhsak nachâng hre lo an awm.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mahni ngaiha fel inti hle an awm a, Mahse, an inhrufai kim si lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ṭhenkhat chapo tak an awm a, An va meng sâng kher êm!
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi retheite ei nân an hâ chu khandaih ang a ni a, Pachhiate ṭhial nân an hapui chu chemte angin a hriam.
  </para>
  <para style="p">
    <verse number="15" style="v" />‘Khawi, khawi,’ ti châmchi ṭhîn, Fanu pahnih vangvatin a nei. Thil pathum pali-a lungawi thei lo, Tâwk tih nei ngai lo an awm:
  </para>
  <para style="p">
    <verse number="16" style="v" />Thlân, chhûl ching, Tui khawpkham lo leichâr leh ‘A tâwk ta e,’ ti ngai lo mei.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mahni pa nuihzata, nu zilhna hmusittu mit chu, Luidung choakin kher sela, Mulukawlh novin ei rawh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil pathum pali mak ka tih lutuk, Ka hriatthiam theih loha awm:
  </para>
  <para style="p">
    <verse number="19" style="v" />Vânlaizâwla mupui lên dân, Lungpui chunga rûl tleng dân, Tuifinriat chunga lawng kal dân, Nula hmaa mipa chêt dân.
  </para>
  <para style="p">
    <verse number="20" style="v" />Nupui rinawm lo tih dân chu hetiang hi a ni: A uire a, a inbual fai a, ‘Thil sual eng mah ka ti lo ve,’ a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thil pathum pali, khawvêlin a ngaihtheih loh, Tawrhhlelhawm tak thil tih a awm:
  </para>
  <para style="p">
    <verse number="22" style="v" />Lal ngai lo lal, mi â tlaipuar,
  </para>
  <para style="p">
    <verse number="23" style="v" />Hmeichhe huatthlala pasal nei, Chhiahhlawh nula, a pi lântu.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khawvêlah thil tê tak tê si fing hle si an awm:
  </para>
  <para style="p">
    <verse number="25" style="v" />Fanghmîr: chak lo hle mah se Nipui laiin chaw an chhêk ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sangawi, an viak a ṭha lo hle a, Lungpui hnuaiah bu an nei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khau, lal nei lovin a rualin an awm ṭhîn.
  </para>
  <para style="p">
    <verse number="28" style="v" />Daidêp: khawiah pawh man mai theih a ni, Mahse, lal inah pawh an chêng.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thil pathum pali kal vêl mit la tak tak a awm:
  </para>
  <para style="p">
    <verse number="30" style="v" />Ramsa zawng zawng aia huai, Hlauh nei lo sakeibaknei,
  </para>
  <para style="p">
    <verse number="31" style="v" />A rual zînga kêlchal: ârpa kal luah luah; A sipai zînga lal vei vêl.
  </para>
  <para style="p">
    <verse number="32" style="v" />I ât êma, chapo taka thil sual i tih dâwn chuan, Invêng ang che.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hnutetui i chawh i chawh chuan a khal a lo chhuak ang a, Mi hnâr i chumsak chuan a lo thi ang, Chutiang bawkin thinur i chawh thawh chuan, Insualna a thleng ang.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hêng hi lal Lemuela thuchah, A nu’n a zirtîr chu a ni:
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka fapa, ka rîla rah, Ka ṭawngṭai chhânna ngaithla rawh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalte tichhe ṭhîn hmeichhe sual hnênah I chakna chu pe suh la, intlakral suh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lemuel, lal tân zawng uain in tûr a ni lo ve, Rorêltuten zu hi lam chhên tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zu an in chuan Dân an theihnghilh a, Mi dik chan tûr an ngaihthah ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Retheite chuan zu in ta se, Rilru mangangte chuan uain lo in ang hmiang;
  </para>
  <para style="p">
    <verse number="7" style="v" />An retheihna theihnghilhin, An rilru hah a chhâwk mahna.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mahni tâna sawi thei lo chu sawisak la, Baihvaite pawh chhan rawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Retheite leh pachhiate thu chu Dik takin rêlsak ṭhîn ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nupui ṭha hmuh hi har tak a ni a, Lungmantam aiin a hlu zâwk asin.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pasal chu ngaihngam takin a awm thei a, Kawng engkimah a hlâwkpui êm êm.
  </para>
  <para style="p">
    <verse number="12" style="v" />A dam chhûng zawngin thil ṭha a tihsak a, Thil ṭha lo a ti ngai lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Berâm hmul leh la a zawng khâwm a, Hlim takin a dek ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ram hla tak aṭanga buh tawlh sumdâwng lawng angin, Ei tûr a la khâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khawvâr hmaa thovin an chhûngkaw tân rawng a bâwl a, Chhiahhlawh nulate tih tûr a rêl fel ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ram ṭha en thlithlaiin a lei a, Ama kutkawih ngeiin grep huan a siam.
  </para>
  <para style="p">
    <verse number="17" style="v" />Taima tak a ni a, thahrui nei tak a ni, A che reng mai.
  </para>
  <para style="p">
    <verse number="18" style="v" />A sumdâwnnaa hlâwk tûr chu a hre êm êm a, Zân rei tak tak thlengin a men phah ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmui thlûr a thlûr a, La a kai a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rethei tân a thilphal a, Tlachhamte a chhawmdâwl ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Vûr tla mah se a hlauthâwng lo, A chhûngte chuan puan lum an nei vek si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Puan chhuatphah mawi tak a tah a, Maimaw puan te, puan senduk te a sin.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pasal chu mi tinin an hria a, Kulh kawngkaa upa ṭhu khâwm zîngah a tel ve ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Puan zai sîn a tah a, a hralh ṭhîn a, A kâwnghrên tah chu sumdâwngte hnênah a hlân ṭhîn.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thil ti thei tak, ngaihsânawm tak a ni a, Lungkham tûr eng mah a nei lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thu fing tak tak a chhâk chhuak a, A thu a dam êm êm.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chhûngkaw khawsak a rêl fel ṭhîn a, A awm mai mai ngai lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />A fate chuan lâwmthu an hrilh a, A pasal pawhin a fak bawk a.
  </para>
  <para style="p">
    <verse number="29" style="v" />‘Nutling tak tak an tam a, Nang zawng i lawr lak e,’ tiin.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngaihnobeina hi engmahlo mai a ni; Hmêlṭhatna pawh a chuai mai ṭhîn. Lalpa ṭihtu hmeichhia erawh chu, Chawimawi tûr a ni e.
  </para>
  <para style="p">
    <verse number="31" style="v" />A thil tih avângin fak ula, A taihmâk avângin mi tinin chawimawi rawh se.
  </para>
</usx>
