<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LEV" style="id">Leviticus</book>
  <para style="h">Leviticus</para>
  <para style="toc1">Leviticus</para>
  <para style="toc2">Leviticus</para>
  <para style="mt">Leviticus</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Inbiakna bûk aṭangin Mosia chu Lalpa chuan a ko va.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel fate hnênah heti hian ti rawh: ‘ Lalpa hnêna thilhlan in rawn kenin in ran vulh, bâwng zînga mi emaw, berâm leh kêl zînga mi emaw in rawn la ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thilhlan chu hâlral thilhlan tûr a nih chuan ranrual zînga a pa, hmêlhem lo a ni ang a, Lalpa lo pawm atân Inbiakna bûk kawtah a hlântu chuan a rawn la tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hâl ral tûr ran lu-ah a kut a nghat ang a, a sual thawina atân pawm a ni ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bâwngpa chu Lalpa hmaah a talh ang a, Arona fa, puithiamte chuan a thisen chu an hlân ang a, Inbiakna bûk luhna bula maichâm chu an theh kual chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />A vun chu a lip ang a, a sa chu a chan sawm ang a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Arona fa puithiamte chuan maichâmah thing an lo dah ang a, mei an chhêm ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />A sa chu a thau leh a lu nên puithiam chuan meiah chuan an rawh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kawchhûng leh a bawpte chu sil fai tûr a ni a, a hlântu puithiam khân maichâmah a vaiin a hâl ral tûr a ni. Hei hi hâlral thilhlan tih dân tûr chu a ni; chu chu Lalpa lâwmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />‘Berâm emaw, kêl emaw hâl rala a hlan dâwn chuan a pa, hmêlhem lo a ni ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa hmaah, maichâm hmâr lamah chuan a talh ang a, a thisen chu puithiamin maichâm a theh kual chhuak ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />A sa chu a chan darh ang a, maichâm chunga thing alh hluah hluahah chuan puithiamin a lu leh a thau nên a rawh ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />A kawchhûng leh a bawpte erawh chu sil fai phawt tûr a ni; a vai chuan puithiam chuan a hâl ral vek tûr a ni, hâlral thilhlan a ni a, Lalpa lâwmzâwng a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />‘ Lalpa hnêna thilhlan tûr chu sava hâlral thilhlan a nih chuan ṭhuro emaw, pârva emaw rawn keng sela,
  </para>
  <para style="p">
    <verse number="15" style="v" />puithiam chuan a lo la ang a, maichâmah a hlân tûr a ni; a ring a ṭhuai chhum ang a, a thisen chu maichâm sîrah a far kangtîr ang a, a hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />A chawkchaweng leh a chaw pai chu maichâm khawchhak lama vut dahnaah paih tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pawt thla lovin a thla ki-ah keu phel tûr a ni, maichâmah hâl ral vek rawh se, hâlral thilhlan a ni a, Lalpa lâwmzâwng tak a ni.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />‘ Lalpa hnêna Buhbâl thilhlan pe chuan chhangphut ṭha chi han la sela, oliv hriak leh beraw telh rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />Puithiam chuan chhangphut chu a ṭhâm ang a, hriak tlêm leh beraw zawng zawng nên chuan maichâmah a hâl ral tûr a ni, chu chu a vaia hâl ral a ni tih entîrna a ni; hâlral thilhlan a ni a, Lalpa lâwmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thilhlana hâl bâng chu puithiam chanpual tûr a ni a, Lalpa hnêna hlan tawh, serh hran tlat a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Buhbâl thilhlanah thuka hem hmin a rawn ken chuan dawidim telh loh chhang a ni tûr a ni, hriak nêna hmeh a nih loh pawhin pan taka nuai, hriak chulh ni rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Thîr thlêng kuma kan, buhbâl thilhlan chu chhangphut ṭha chi, dawidim telh loh, hriak nêna hmeh a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlan dâwnah tihsawma hriaka tâl tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Buhbâl thilhlan chu, chhangphut ṭha chi, thîrbêla hriaka kan a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutiang thil chu Lalpa hnêna i hlan dâwn chuan puithiam pe la, ani chuan maichâmah a keng ang a,
  </para>
  <para style="p">
    <verse number="9" style="v" />a ṭhen a sâwk thla ang a, a sawh thlâk chu a hâl ral tûr a ni; chu chu a vaia hâl ral entîrna a ni ang. Hei hi hâlral thilhlan a ni a, Lalpa lâwmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hlan bâng la awm chu, puithiamte ta tûr a ni, Lalpa hnêna hlan a ni tawh a, serh hran tlat a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Buhbâl thilhlan, Lalpa hnêna hlan rêng rêng chu dawidim telh tûr a ni lo; dawidim leh khawizu telh rêng rêng Lalpa hnênah hâl ral atân hlan tûr a ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />In buhbâl seng hmasak ber erawh chu Lalpa hmaah kum tin in rawn hlân tûr a ni, maichâmah hâl ve tûr a ni lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Buhbâl thilhlanah hian chi a tel zêl tûr a ni, chi hi Pathian nêna in thuthlung entîrna a ni a, in thil hlanah telh zêl tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />‘In buhbâl thar hmasa in rawn hlan hunah chuan chhangpêr hlan tel ṭhin tûr a ni a,
  </para>
  <para style="p">
    <verse number="15" style="v" />oliv hriak leh beraw telh bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Puithiam chuan chhangpêr leh hriak tlêm, a vai aiawh tûrin, a la ang a, beraw nên chuan buhbâl thilhlanah Lalpa tân a hâl ral tûr a ni.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />‘Remna thilhlan tûr miin an ran zînga mi an rawn hlan chuan a nu emaw, a pa emaw, hmêlhem lo, Lalpa hmaah an rawn hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />A ran hlan lu-ah chuan a kut a nghat ang a, Inbiakna bûk tual luhna kawngka bulah a talh ang a, puithiamin a thisen chu maichâm a theh kual chhuak ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Remna thilhlan aṭang chuan Lalpa tân hêngte hi hlan tûr a ni; a rîlbawh thau zawng zawng,
  </para>
  <para style="p">
    <verse number="4" style="v" />a kal te, a bawhtu thau te, a thin hlâwm ṭha lai hleh te.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chûng chu puithiamin maichâmah hâlral thilhlan dang a hâl rualin a hâl ral tûr a ni; chu chu Lalpa lâwmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />‘Remna thilhlan tûr miin a berâm emaw, a kêl emaw zînga mi a rawn hlan chuan a nu pawh, a pa pawh, hmêlhem lo a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Berâm a rawn hlân a nih chuan
  </para>
  <para style="p">
    <verse number="8" style="v" />a lu-ah a kut a nghat ang a, Inbiakna bûk kawtah Lalpa hmaah a talh tûr a ni; puithiam chuan a thisen chuan maichâm a theh kual chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Remna thilhlan aṭang chuan Lalpa tân hêngte hi a hlân tûr a ni; a mei thau, a bul rêta tan, a rîlbawh thau zawng zawng,
  </para>
  <para style="p">
    <verse number="10" style="v" />a kalte leh a bawhtu thau, a thin hlâwm ṭha lai hleh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chûng chu puithiamin maichâmah, Lalpa hnênah ei tûr thilhlanah a hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘ Lalpa hnêna a thilhlan chu kêl a nih chuan,
  </para>
  <para style="p">
    <verse number="13" style="v" />a lu-ah a kut a nghat ang a, Inbiakna bûk kawtah a talh ang a, a thisen chuan puithiamin maichâm a theh kual chhuak tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hêng hi ei tûr thilhlan atân Lalpa hnêna a hlan tûr chu a ni; a rîlbawh thau zawng zawng,
  </para>
  <para style="p">
    <verse number="15" style="v" />a kal te, a bawhtu thau te, a thin hlâwm ṭha lai hleh te.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hêng hi ei tûr thilhlan atân puithiam chuan maichâmah Lalpa lo lawm atân a hâl ral tûr a ni. A thau zawng zawng hi Lalpa ta tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Israel mi tu mahin sa thau leh thisen an ei tûr a ni lo. Israel mite chuan khawiah pawh awm se he dân hi an zâwm kumkhua tûr a ni,’ ” a ti a.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia chu a bia a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel fate hrilh rawh, mi tu pawhin Lalpa thupêk an bawhchhiat palh chuan hetia tih tûr hi a ni:
  </para>
  <para style="p">
    <verse number="3" style="v" />Thil tisual palhtu chu puithiam lalber a nih a, mipuiin a sual mawh an phurh dâwn chuan, a sual thawi nân bâwngtuai, hmêlhem lo, Lalpa hnênah a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa hmaah, Inbiakna bûk kawtah, bâwngtuai chu a rawn kai ang a, a lu-ah a kut a nghat ang a, a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />A thisen ṭhen chu a keng ang a, Inbiakna bûk chhûngah a luhpui ang a,
  </para>
  <para style="p">
    <verse number="6" style="v" />a kutzungchalin Hmun Thianghlim puanzâr chu thisen chuan vawi sarih a theh ang a;
  </para>
  <para style="p">
    <verse number="7" style="v" />rimtui hâlna maichâm kila ki-ah chuan thisen ṭhen chu a tât ang a, a bâng zawng chu bûk kawta thilhlan hâlna maichâm bulah a leihbaw vek tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bâwng thau, a rîlbawh thau zawng zawng te,
  </para>
  <para style="p">
    <verse number="9" style="v" />a kal te leh a bawhtu thau te, a thin hlâwm ṭha lai hlehte chu
  </para>
  <para style="p">
    <verse number="10" style="v" />puithiam chuan a la ang a, a thaute chu remna thilhlan tih dân ang khân hâlral hlanna maichâmah a hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />A vun te, a sa te, a lu te, a ke te, a kawchhûng zawng zawng leh a rîl te nên
  </para>
  <para style="p">
    <verse number="12" style="v" />riahhmun daipâwnah hmun serh, maichâm vut paih khâwmnaah meipui a chhep ang a, a hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Israel hnam pumin thil sual an tih palh a, hre chhuak mai si lovin Lalpa thupêk an bawhchhiat chuan,
  </para>
  <para style="p">
    <verse number="14" style="v" />an thil sual tih chu an hriat chhuah veleh hnam pum chuan sual thawi nân bâwngtuai Inbiakna bûk kawtah an rawn la tûr a ni;
  </para>
  <para style="p">
    <verse number="15" style="v" />hnam hotute chuan a lu-ah kut an nghat zet ang a, talh tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Puithiam lalber chuan bâwng thisen chu Inbiakna bûkah a keng lût ang a,
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmun Thianghlim Ber puanzâr chu vawi sarih a zungchalin thisen chu a tât tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bûk chhûnga rimtui hâlna maichâm kila ki-ah chuan a tât bawk ang a; bûk kawta thilhlan hâlna maichâm bulah a bâng zawng chu a leihbaw tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />A thaute chu maichâmah chuan a hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sual thawina bâwngtuai a cheibâwl ang khân a ti ve vek ang a, mipui sual thawina chu a hlân tûr a ni; tichuan, an sual chu ngaihdam a ni tawh ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bâwngtuai chu riahhmun daipâwnah, ama sual thawina ang bawk khân a hâl ral tûr a ni. Hei hi hnam pum sual thawina atâna thilhlan ṭhin tûr chu a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Rorêltuin thil sual a tih palh a, Lalpa thupêk a bawhchhiat chuan,
  </para>
  <para style="p">
    <verse number="23" style="v" />a thil sual tih chu an hrilh a, a hriat chhuah veleh, a sual thawi nân kêlpa, hmêlhem lo a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kêl lu-ah a kut a nghat ang a, maichâm hmâr lam, hâlral thilhlan an talhna hmunah chuan a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Puithiamin a thisen chu a la ang a, maichâm kila ki-ahte chuan a tât ang a, a tah bâng chu maichâm bulah chuan a leihbaw tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A thau zawng zawng chu Remna thilhlan a tih angin maichâmah chuan a hâl ral tûr a ni; chutiang chu rorêltu sual thawina puithiamin a hlan dân tûr chu a ni; tichuan, a sual chu ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Mi narânin thil sual a tih palh a, Lalpa thupêk a bawhchhiat chuan
  </para>
  <para style="p">
    <verse number="28" style="v" />a thil sual tih a hriat chhuah veleh kêlnu, hmêlhem lo, a sual thawi nân a rawn hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kêl lu-ah a kut a nghat ang a, hâlral maichâm hmâr lamah hâlral thilhlan an talhna hmunah chuan a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />A thisen chu puithiamin maichâm kil kiahte chuan a zungchalin a tât ang a, a tah bâng chu maichâm bulah a leihbaw tûr a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />A thau zawng zawng chu remna thilhlan a tih ang chiah khân maichâmah a hâl ral tûr a ni; chu chu Lalpa lâwmzâwng tak a ni. Chutiang chuan thil sual titu sual thawina chu a hlân ang a, ngaihdam a ni tawh ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Sual thawi nân berâm a rawn ken chu, a nu, hmêlhem lo a ni ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Berâm lu-ah chuan a kut a nghat ang a, hâlral thilhlan an talhna hmun, maichâm hmâr lamah chuan a talh tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />A thisen chu hâlral maichâm kila ki-ahte chuan a zungchalin puithiam chuan a tât ang a, a tah bâng chu maichâm bulah a leihbaw tûr a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Remna thilhlan berâm ang khân a thau zawng zawng chu a la ang a, Lalpa tâna buhbâl thilhlan nên khân a hâl ral tûr a ni. Chutiang chuan sual thawina chu puithiam chuan a hlansak ang a, a sual chu ngaihdam a ni tawh ang.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Hetiang thilah hian sual thawina hlan a ngai. Rorêlna hmuna thuhretua koh chuan a thil hmuh emaw, a thil hriat emaw puang tûra tih a nih a, a puan duh loh chuan thil sual a ti a ni, a mawh a phur tûr a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Miin thil thiang lo, ran ruang te, a lian emaw, a te emaw, ramsa tlaw ruang te emaw a khawih palh chuan thil sual a ti a ni a; a hriat chhuah chuan a mawh chu a phur tûr a ni, a bawlhhlawh ve ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihring aṭanga chhuak, thil thiang lo rêng rêng a khawih palh chuan a thiltih chu a dik lo tih a hriat veleh a thiang lo ve nghâl a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Miin thil ṭha emaw, ṭha lo emaw ti tûrin ngaihtuah chiang lovin chhia chham sela, a thiltih chu a ngaihtuah chian hnuah chauh a tihsual mawh chu a phur tawh ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Miin thil sual a tih chuan, a thil sual tih chu a inpuang ang a,
  </para>
  <para style="p">
    <verse number="6" style="v" />a thil sual tih hrem nân Lalpa hnênah berâm emaw, kêl emaw, a nu a rawn hlân tûr a ni. Puithiam chuan chu mi sual thawina chu a hlansak tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Berâm emaw, kêl emaw a neih loh chuan a sual mana pêkah Lalpa hnênah ṭhuro pahnih emaw, pârva pahnih emaw a rawn hlân tûr a ni. Pakhat chu sual thawina thilhlan a ni ang a, pakhat chu hâlral thilhlan atân a ni ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Puithiam hnênah a rawn dah ang a, sual thawina chu a hlân hmasa tûr a ni. Ṭhuai bung lovin a ring a elh tliak ang a,
  </para>
  <para style="p">
    <verse number="9" style="v" />a thisen ṭhen chu maichâm pangah a theh ang a, maichâm bulah a thisen chu a far kang tûr a ni. Hei hi sual thawina thilhlan a ni. Pakhat chu dân angin hâlral thilhlanah a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chutiangin Puithiam chuan mi thil sual tih thawina chu a hlân ang a, ngaihdam a ni tawh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ṭhuro pahnih emaw, pârva pahnih emaw pawh a nei zo lo a nih chuan sual thawina thilhlan chhangphut ṭha chi kg. khat a rawn hlân tûr a ni. Oliv hriak emaw, beraw emaw a rawn telh tûr a ni lo; hâlral thilhlan a ni lo va, sual thawina thilhlan a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Puithiam hnênah a rawn dah ang a, ei tûr thilhlan angin Lalpa hnêna hlan vek a nih entîr nân a ṭhen a lo ṭhâm ang a, maichâmah ei tûr thil hlan angin a hâl ral ang. Sual thawina thilhlan a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chutiang chuan thil sual titu tân puithiam chuan a lo hlansak ang a, ngaihdam a ni ang. Buhbâl thilhlan ang bawk khân a hâl bâng chhangphut chu puithiam chanpual tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa chuan Mosia hnênah:
  </para>
  <para style="p">
    <verse number="15" style="v" />“Miin Lalpa chanpual thil serh chu pe lo palh sela, a sual a ni. A sual manah thilhlan Lalpa hmaah berâm emaw, kêl emaw, a pa, hmêlhem lo a rawn keng tûr a ni, ran man zât chu biakbûk dân hman lai anga chhût tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />A pêk loh zât hu chu a pe ang a, chu bâkah hmun ngaa ṭhena hmun khat a pêk belh tûr a ni. Puithiam hnênah a pe ang a, berâmno chu anin bawhchhiat man thilhlanah a lo hlansak ang a, ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Tih loh tûr thu-a Lalpa thupêk lo ti palh chuan thil sual a ti a ni, a mawh chu a phur ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Puithiam hnênah bawhchhiat man thilhlan atân berâm emaw, kêl emaw a pa, hmêlhem lo a rawn kai tûr a ni, ran man bi zât chu biakbûka dân hman lai anga chhût tûr a ni. Puithiam chuan bawhchhiat man thilhlan chu a thiltih sual palh thawi nân a lo hlansak ang a, a sual chu ngaihdam a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa laka a bawhchhiat man thilhlan a ni,” a ti a.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mi tu pawhin a chipui hnêna thil a kawltîr te, a dahkham te pe kîr duh lo ta se, rûk ṭhensakin emaw, bum emaw ta sela;
  </para>
  <para style="p">
    <verse number="3" style="v" />tin, thil bo a chhar si chhar lo angin chhia a chham chuan,
  </para>
  <para style="p">
    <verse number="4" style="v" />hetiang thil sual, a eng a pawh hi ti sela; Lalpa laka thil tisual a ni a; a rûk te, a bum te, a dahkham kîr duh loh te, thil bo a chhar te, dâwta chhia a chham hnan thil te chu a rûl kim vek tûr a ni; chu bâkah chuan hmun ngaa ṭhena hmun khat a pêk belh tûr a nî; thil sual a ti tih hmuh chhuah niah a neitu hnênah a pe tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bawhchhiat man Lalpa hnêna hlan atân puithiam hnênah berâm emaw, kêl emaw, a pa, hmêlhem lo, a rawn kai tûr a ni; a man chu Hmun Thianghlima hman lai tangka hisâpa chhût tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puithiam chuan Lalpa hnênah sual thawina chu a hlansak ang a, a sualna chu ngaihdam a ni tawh ang.” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chuan Mosia a bia a:
  </para>
  <para style="p">
    <verse number="9" style="v" />“Arona leh a fate chu hâlral thilhlan chungchânga tih dân tûr hi hrilh rawh. Hâlral thilhlan chu zankhuain maichâmah chuan dah tûr a ni a, mei chu tihnun reng tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tûkah puithiam chuan a puan zai sîn kawr leh kekawr hnuai ha-in thuka thil rawh vâpte chu a rût ang a, maichâm sîrah chuan a dah tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />A thawmhnaw chu a thlâk ang a, riahhmun daipâwn hmun serhah vut chu a paih tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Maichâma mei chu chhawm nun reng tûr a ni, a mit tûr a ni lo. Puithiam chuan tûk tin thing a tuah belh ang a, hâlral thilhlan tûrte chu a hâl ang a; remna thilhlan thaute pawh chu a hâl ral nghâl ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maichâma mei chu chhawm nun reng tûr a ni; a mit hauh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Hetiang hi buhbâl thilhlan tih dân tûr chu a ni: Arona thlah puithiamin buhbâl thilhlan chu maichâmah Lalpa hmaah a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hriak leh chhangphut veikhat a la ang a, beraw nên maichâmah a hâl ang; chu chu a vaiin Lalpa hnêna hlan a ni tih entîrna a ni, Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hlan bâng chu puithiamho ei tûr a ni. Inbiakna bûk tual hmun thianghlimah dawidim tel lova ei tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dawidim nêna hmeh pawlha kan tûr a ni lo. Buhbâl thilhlan aṭanga an chanpual atân ka pêk a ni. Sual thawina leh bawhchhiat man thilhlan anga thil serh, serh hran tlat tawh chu a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Arona thlah mipa tawh phawt chuan an ei thei ang. Lalpa hnêna ei tûr hlan kumkhuaa an chanpual tûra ruat a ni. Mi dang tu pawhin ei tûr thilhlan chu an khawih ve chuan an thiang lo nghâl ang,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="20" style="v" />“Arona leh a fate hriak thih ni chuan Lalpa hnênah chhangphut ṭha chi kg. khat, ni tina buhbâl thilhlan hlan tel zât, zîngah kg. chanve, tlaiah kg. chanve rawn hlân ṭheuh rawh se.
  </para>
  <para style="p">
    <verse number="21" style="v" />Oliv hriak nên hmeh pawlha chhang ur thlênga ur hmin tûr a ni a, sih sawma buhbâl thilhlan anga hlan tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Arona thlah, a aiawhtu tûra hriakthih, Puithiam lalber chuan he thilhlan hi a hlân ṭhîn tûr a ni; hei hi kumkhuaa tih dân tûr a ni, Lalpa tân hâl ral vek tûr a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Puithiamin buhbâl thilhlan a hlan hi ei tûr a ni lo, hâl ral vek tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="25" style="v" />“Arona leh a fate chu hrilh rawh: ‘Hetiang hi sual thawina thilhlan hlan dân tûr chu a ni: hâlral thilhlan tûr talhna hmunah sual thawina thilhlan chu Lalpa hmaah talh tûr a ni, thil serh tlat a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A hlântu puithiam chuan a sa hi Inbiakna bûk tual hmun thianghlimah a ei tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />‘He sa hi a khawih apiang an thiang lo nghâl ang. Thawmhnaw eng pawh a thisenin a per chuan hmun thianghlima sûk tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />A sa chhumna bêl chu hlumbêl a nih chuan tihkeh tûr a ni; dârbêl a nih erawh chuan nawh fai hliauva tuia sil tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Puithiam thlah mipa tawh phawt chuan a sa hi an ei thei ang, thil serh a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Inbiakna bûk hung chhûng hmun thianghlimah thisen chu sual thawina atân lâk luh a nih chuan a sa chu hâl ral vek tûr a ni.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />‘Hei hi Bawhchhiat man thilhlan tih dân tûr chu a ni:
  </para>
  <para style="p">
    <verse number="2" style="v" />Hâlral thilhlan ran talhna hmunah ran chu talh tûr a ni a, a thisen chu maichâma theh tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A mei thau te, a rîlbawh thau te,
  </para>
  <para style="p">
    <verse number="4" style="v" />a kal te leh a bawhtu thau te, a thin hlâwm ṭha lai hleh te chu
  </para>
  <para style="p">
    <verse number="5" style="v" />Puithiamin maichâmah a hâl ral tûr a ni, bawhchhiat man thilhlan a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puithiam chi, mipa tawh phawt chuan a sa chu an ei thei ang, serh hran tlat a nih avângin hmun thianghlima ei tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Sual thawina thilhlan leh bawhchhiat man thilhlan hi a hlan dân a inang reng tûr a ni; a hlântu puithiam hian a sa hi a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hâlral thilhlana hman ran vun chu a hlântu puithiam neih tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Buhbâl thilhlan thuka hem hmin te, chhang ur thlênga ur hmin te, thîrbêla kan te chu a hlântu puithiam neih tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Buhbâl thilhlan la tihhmin loh, hriak telh pawh, telh loh pawh Arona thlah puithiamte ta tûr a ni: an insem zêl tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘ Lalpa hnêna remna thilhlan chu hetianga hlan tûr hi a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Remna thilhlan chu Pathian hnêna lâwmthu sawina atân miin a rawn hlan chuan, ran hlan rualin chhang, dawidim telh loh leh oliv hriak nêna hmeh emaw, chhang pan oliv hriaka tâl emaw, oliv hriaka kan emaw a rawn hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chûng bâkah chuan dawidim telh chhang tlang ur hmin a pe tel tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chhang chi hrang hrang a hlan zînga pakhat zêl chu Lalpa tân a pe tûr a ni, maichâma ran thisen thehtu puithiam neih tûr a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />A sa chu a hlan nia ei zawh vek tûr a ni; a tûk atân dah tûr a ni lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />‘Remna thilhlan chu thutiam hlawhtlinna avâng emaw, mahni duh thu-a thilhlan hrim hrim emaw a nih chuan, a sa chu a hlan niâ ei vek kher tûr a ni lo, a tûkah pawh ei theih a la ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ei sên loh, a ni thum ni pawha la awm ta cheu chu hâl ral tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ni thum nia an la ei chuan Pathianin a thilhlan chu a pawm lo vang, a hlântu thil tih ṭhatah chhiar ahnêkin bawlhhlawhnaa ngaih a ni ang a, a eitu chuan a mawh a phur ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />A sa-in thil bawlhhlawh a khawih chuan ei tûr a ni lo, hâl ral tûr a ni. Mi bawlhhlawh lai lo chuan a sa chu an ei thei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi bawlhhlawh laiin remna thilhlan sa hi a ei ve chuan ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihring emaw, ran aṭangin emaw thil bawlhhlawh chhuak khawihtu chuan he sa hi a ei ve chuan ensan tûr a ni,’ ” a ti a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="23" style="v" />“Israel fate chu hrilh rawh: Berâm te, bâwng te, kêl te, a eng thau mah an ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ran tlaw emaw, sa seh emaw thau chu ei tûr a ni lo; thil dangah erawh chuan hman theih a ni ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ei tûr thilhlan Lalpa hnêna a thau hlan tawh ei chu ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel fate chu khawiah pawh awm se ran thisen emaw, sava thisen emaw an ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="27" style="v" />He dân hi bawhchhia apiang ensan tûr an ni,” a ti a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Israel mite chu hrilh rawh. Remna thilhlan Lalpa hnêna hlântu chuan a ṭhen Lalpa hnêna thilpêkah an pe tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amah ngeiin ei tûr thilhlan chu a rawn hlân tur a ni. Ran thau leh a irno chu a thên ang a, Lalpa hnênah a rawn hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Puithiamin a thau chu maichâmah a hâl ang a, a irno erawh chu puithiam neih tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Remna thilhlanah chuan a bawp ding lam chu puithiam pêk tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Remna thilhlan thau leh thisen hlântu puithiam chuan a bawp ding lam chu a nei ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Israel-ten Lalpa hnêna remna thilhlan an hlanin a irno an thên leh a bawp hi puithiamte kumkhaw chanpual tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hei hi ei tûr Lalpa hnêna pêk aṭanga Arona leh a fate, puithiama ruat ngheh hnua an chanpual atâna pêk tûr chu a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chumi ni chuan a ni Lalpa chuan Israel mite hnênah he thên thilhlan hi an hnêna pe ṭhîn tûra thu a pêk ni. He dân hi Israel miten kumkhuain an zâwm tûr a ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tichuan, hâlral thilhlan te, buhbâl thilhlan te, sual thawina thilhlan te, bawhchhiat man thilhlan te, Puithiam nemngheh thilhlan te leh remna thilhlante chu chutianga hlan ṭhin tûr chu a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Thlalêra Sinai tlângah Israel-te thilhlan dân tûr a hrilh ṭuma Mosia hnêna Lalpa thupêkte chu chûng chu a ni.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona leh a fate chu Inbiakna bûk luhnaah lo kal sela, puithiam thawmhnaw te, thih tûr hriak te, sual thawina tûr bâwngpatuai te, berâmchal pahnih leh dawidim telh loh chhang, fawngin han keng rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel pungkhâwmho chu ko vek ang che,” a ti a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa thupêk ang chuan Mosia chuan a ti a, an lo pun khâwm hnu chuan an hnênah,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Kan tih tûr hi Lalpa thupêk a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia chuan Arona leh a fate chu a rawn hruai a, dân angin a insiltîr a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kawrhnuai te, kawrfualte chu a hâktîr a, kâwnghrên pawh a hrêntîr a. Efod a hâktîr bawk a, a hrênna mawi taka tah chuan a kâwngah a hrêng bet a,
  </para>
  <para style="p">
    <verse number="8" style="v" />âwmbel chu a bel a, tah chuan Urim leh Thumim pawh chu a dah a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Diar chu a khimtîr a, a chalah rangkachak phêk ‘ Lalpa Pual’ tih ziakna kha a inbel a. Chûng chu Lalpa thupêk angin a ti vek a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosia chuan hriak thih mi chu a la a, Biakbûk leh a chhûnga awm zawng zawng chu a chulh a, a tithianghlim a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hriak ṭhen chuan maichâm leh a bungbêl te, dâr chawhtawlh leh a hûnna te chu tihthianghlim nân vawi sarih a theh a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hriak ṭhenkhat chu Arona lu-ah a leih a, a serh hrang ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Arona fate pawh chu Mosia chuan a hruai a, kawr ṭial a hâktîr a, kâwnghrên a hrêntîr a, lukhum a khumtîr bawk a; chûng chu Lalpa thupêk angin a ti a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mosia chuan sual thawina bâwng chu a kai a, Arona leh a fate chuan a lu-ah an kut an nghat a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosia chuan a talh a, a thisen ṭhen chu zungchalin maichâm kila ki-ahte chuan tihthianghlim nân a tât a. A tah bâng chu maichâm bulah a leihbua a; chutiang chuan maichâm chu a serh hrang a, a tithianghlim a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosia chuan a rîlbawh thau zawng zawng te, a thin hlâwm ṭha lai hleh te, a kal te leh a bawhtu thau te chu maichâmah chuan a hâl a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa thupêk angin a vun te, a sa te, a rîlte chu riahhmun pâwnah a hâl a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hâlral thilhlan tûr berâm pawh chu Mosia chuan a kai a, Arona leh a fate chuan a lû-ah an kut an nghat a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosia chuan a talh a, maichâm chu thisen chuan a theh kual a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpa thupêk angin berâm chu a chan sawm a, a rîl te leh a bawp te chu a sil a, a lu te, a thau te leh a sa te chu maichâmah a hâl ta vek a. Hâlral thilhlan a ni a, chu chu Lalpa lâwmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosia chuan berâm pakhat zâwk, puithiam nemnghehna chu a kai a. Arona leh a fate chuan a lu-ah an kut an nghat a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosia chuan a talh a, a thisen ṭhenkhat chu Arona beng ding lam tengengah a hnawih a, a kutzungpui leh kezungpui ding lam hmâwr ve ve-ah a hnawih a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arona fate pawh chuan an rawn pan a, an beng ding lam tengengah te, an kut leh an kezungpui ding lam hmâwr ve ve-ah te a lo hnawih bawk a; a hnawih bâng chuan maichâm chu a theh kual a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Berâm thau, a mei thau tak te, a rîlbawh te, a thin hlâwm ṭha lai hleh te, a kal te leh a bawhtu thau te leh a bawp ding lam chu a la a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa hnênah Buhbâl thilhlan, dawidim telh loh chhang tlang khat leh chhang, hriak nêna hmeh te, hriaka chhang pan tâl te chu ran thau leh a bawp chungah chuan a dah a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Arona leh a fate kutah a hlân a, Lalpa hmaah chuan an thên a, an hlân a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosia chuan chûng chu a la leh a, hâlral thilhlan chungah nemnghehna thilhlanah a hâl ta a. Hei hi ei tûr thilhlan a ni; chu chu Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosia chuan a irno chu a la a, Lalpa hmaah chuan a thên a, a hlân a; chu chu puithiam nemnghehna berâm aṭanga Mosia chanpual ve chu a ni. Lalpa thupêk ang chuan Mosia chuan engkim a ti a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mosia chuan hriak thih tûr ṭhen chu maichâma theh thisen ṭhen nên chuan a la a, Arona leh a fate chu an kawrah nên a theh a. Chutiang chuan an kawrte nên Lalpa tân a serh hrang ta a.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosia chuan Arona leh a fate hnênah, “Inbiakna bûk kawngka bulah a sa hi la ula, chhûm ula, fawnga nemnghehna thilhlan chhang nên khân Lalpa thupêk angin ei rawh u.
  </para>
  <para style="p">
    <verse number="32" style="v" />In ei bâng chu, sa pawh, chhang pawh hâl vek tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nemnghehnaa tih tûr tih kim a nih hnu, ni sarih chhûng chuan Inbiakna bûk aṭangin pâwnah in chhuak tûr a ni lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lalpa thupêk angin khâng thil kha in sual thawina tûrin ka ti a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lalpa thupêk ang chuan ni sarih leh zan sarih Inbiakna bûk luhna bulah in awm tûr a ni. In awm duh loh chuan in thi ang, chu chu Lalpa thupêk a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tichuan, Arona leh a fate chuan Mosia hnêna Lalpa thupêk zawng zawng chu an ti ta vek a.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ni riat ni chuan Mosian Arona leh a fate chu Israel upate nên a ko va,
  </para>
  <para style="p">
    <verse number="2" style="v" />Arona hnênah, “Bawngpatuai leh berâmchal hmêlhem lo kai la, bâwng chu sual thawina thilhlanah Lalpa hnênah hlân la, berâm chu hâlral thilhlanah hlân ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel mite chuan sual thawina thilhlanah kêlpa rawn kai sela; bâwngno leh berâmno, kum khat vêla upa, hmêlhem lo, hâlral thilhlan atân rawn kai bawk rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bâwngchal leh berâmchal, remna thilhlan atân rawn kai sela, buhbâl thilhlan hriak nêna pawlh Lalpa hnênah rawn hlân bawk rawh se. Vawiin hian kei, Lalpa hi, in hmaah ka rawn inlan dâwn a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosia thupêk ang chuan Inbiakna bûk kawtah chûng chu an rawn kai a, hnam pum chu Lalpa chibai bûk tûrin an pung khâwm a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia chuan an hnênah, “Hei hi ti tûrin Lalpa chuan thu a pe che u a ni: Lalpa ropuina êng chu a lo lang dawn si a,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tin, Arona hnênah chuan, “Maichâmah i sual thawina tûr leh hâlral thilhlan hlân ang che, mipui sual thawina tûr pawh hlân bawk ang che, Lalpa thupêk angin mipui sual thawina chu hlansak rawh,” a ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Arona chu maichâmah a kal a, ama sual thawina bâwngpatuai chu a talh a.
  </para>
  <para style="p">
    <verse number="9" style="v" />A fate chuan a thisen an rawn lâksak a, a zungchal a chiah a, maichâm kila ki-ah chuan a tât a, a tah bâng chu maichâm bulah a leihbua a.
  </para>
  <para style="p">
    <verse number="10" style="v" />A thau te, a kal te, a thin hlâwm ṭha lai hleh te chu Mosia hnêna Lalpa thupêk ang khân maichâmah chuan a hâl a.
  </para>
  <para style="p">
    <verse number="11" style="v" />A vun leh a sa erawh chu riahhmun pâwnah a hâl ral a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ama puala hâlral thilhlan pawh chu a talh a, a thisen chu a faten an rawn lâksak a, maichâm a theh kual chhuak a.
  </para>
  <para style="p">
    <verse number="13" style="v" />A lu leh a sa dangte pawh an rawn la a, maichâmah a lo hâl a.
  </para>
  <para style="p">
    <verse number="14" style="v" />A rîlte leh a bawp chu a sil fai a, maichâmah chuan a dang chunga dahin a hâl ta bawk a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chumi hnu chuan mipui thilhlan chu a hlân ve ta a. Mipui sual thawina thilhlan chu a talh a, ama sual thawina a hlan ang chiah khân a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hâlral thilhlana hlan tûr ran pawh chu a tih dân tûr tuk angin a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Buhbâl thilhlan chhangphut chu a ṭhâm a, maichâmah chuan ni tin hâlral thilhlan zîngah chuan a hâl tel a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Remna thilhlanah bâwngpa leh kêlchal mipuiin an rawn ken chu a talh a, ran thisen chu a faten an rawn la a, maichâm chu a lo theh kual chhuak a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Arona chuan bâwng leh berâm thau, berâm mei thau tak leh a rîlbawh thau te, a kal te, a thin hlâwm ṭha lai hleh te chu,
  </para>
  <para style="p">
    <verse number="20" style="v" />a irno chungah a dah a, maichâmah a rawn hlân a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosia sawi angin a irno leh a bawp chu Lalpa hmaah a thên a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aronan hêng hi a hlan zawh chuan mipui chungah a kut a phar a, malsâwmna a sawi a, maichâm ata chu a lo chhuk a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosia leh Arona chu Inbiakna bûkah chuan an lût a, an lo chhuah chuan mipui tân malsâwmna an sawi a. Lalpa ropuina êng chu mite hmuhah a lo lang ta a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa hnên aṭang chuan mei a lo chhuak a, maichâma hâlral thilhlan leh sathaute chu a rawn kâng ral ta a. Mipuiin chu chu an hmuhin an au va, an hmaia lei siin an bawkkhup ta a.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nadaba leh Abihua, Arona fate chuan, an meilawhin meiling an rût a, rimtui hâl chi an phul a, Lalpa hmaah mei thiang lo chu an hmang a. Chutiang hman chu Lalpan a khap a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa hnên aṭangin mei a lo chhuak zawk a, Lalpa hmaah an pahnih chuan an kâng hlum ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosia chuan Arona hnênah, “ Lalpa chuan hemi thu-ah hian heti hian a ti, ‘Ka rawngbâwltute chuan ka thianghlimna hi an pawisa tûr a ni. Ka mite hmaah ka ropuizia ka tilang dâwn,’ a tih rêng kha,” a ti a. Arona chu a ngawi reng a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosia chuan Arona pami Uziela fa Misaela leh Elzafana te chu a ko va, an hnênah, “Lo kal ula, in unaute ruang hi bûk thianghlim aṭang hian la chhuak ula, riahhmun pâwnah dah chhuak rawh u,” a ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tichuan, an lo kal a, Mosia sawi angin an ruang chu an puithiam kawr fual chuan riahhmun pâwnah an zâwn chhuak ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia chuan Arona leh a fa Eleazara leh Ithamara hnênah, “Lu in sûnin in sam thlah suh ula, in puan pawh pawtthlêr ve hek suh u; chutianga in tih chuan in thi ngei ang a, Lalpa chu hnam pum chungah a thinur ang. Lalpa meiin a kan hlumte chu in unau Israel dangte erawh chuan an ṭah thei ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangni chuan Inbiakna bûk hi chhuahsan suh u, in thi dah ang e, Lalpa hriak thih in nih tawh kha,” a ti a. Mosia sawi ang chuan an ti ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chuan Arona hnênah
  </para>
  <para style="p">
    <verse number="9" style="v" />“Inbiakna bûka in lo luh dâwnin nang leh i fate hian uain leh zu in in tûr a ni lo, in in chuan in thi ang. Hei hi inthlah zawng zawngten an zâwm tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thil serh leh serh loh, thiang leh thiang lo in thlei thiam tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosia hnêna dân ka pêk zawng zawng che u chu Israel mite chu in zirtîr tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosia chuan Arona leh a fapa pahnih la dam, Eleazara leh Ithamara-te hnênah, “Buhbâl thilhlan aṭanga Lalpa hnêna hlan bâng kha la ula, maichâm bulah ei rawh u: serh hran tlat a ni tawh si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmun thianghlimah chuan ei ula, Lalpa hnêna ei tûr hlan aṭanga in fate nêna in chanpual a ni. Hei hi Lalpa thupêk a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />A irno leh a bawp, Lalpa hmaa thên kha chu hmun thianghlimah chuan in fapate leh in fanute nên in ei thei ang. Hêng thilhlante hi in fate nêna in ei atân remna thilhlan aṭanga in chanpual tûr chu a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa hmaa a bawp leh a irno an thên kha meia thilhlan Lalpa hnêna a thau an hlan rualin an rawn la tûr a ni. Lalpa thupêk angin hêng hi in fate nêna in kumkhaw chanvo tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosia chuan sual thawina thilhlan kêl chungchâng thu chu dîlchhût takin a zâwt a, an lo hâl dêr tawh tih a hre ta a. Eleazara leh Ithamara chungah chuan a thinur ta hle a.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Engtizia nge sual thawina thilhlan kêlpa sa chu hmun thianghlimah in ei loh, serh hran tlat tawh a nih kha; mipui sual thawina aṭanga in chan tûra Lalpa pêk che u a nih kha.
  </para>
  <para style="p">
    <verse number="18" style="v" />Inbiakna bûkah a thisen chu lâk luh a ni si lo va, ka hrilh tawh che u ang khân chutah chuan a sa in ei tûr alâwm,” a ti a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Arona chuan a chhâng a, “Vawiin hian sual thawina sa chu ei ila, Lalpa chuan a remti meuh ang maw? Mipuite chuan Lalpa hnênah sual thawina chu an rawn hlân a, chuti chung pawhin hêng thil râpthlâk tak hi ka chungah a thleng a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chûng chu Mosian a han hriat chuan a lungawi ta a.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hetiang hian hrilh rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Khawmuala chêng hêng sate hi in ei thei ang: a tin kâk chhuak, chaw ṭhial nawn sa tawh phawt chu in ei thei ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sanghâwngsei te, sangawi te, sazupuite chu in ei tûr a ni lo; hêngho sa hi sa bawlhhlawh a ni; chaw chu an ṭhial nawn a, an tin a kâk chhuak lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vawksa ei suh u, sa bawlhhlawh a ni, a ketin chu a kâk chhuak a; mahse, chaw chu a ṭhial nawn lo a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hêng ran sate hi ei suh u, a thi ruang pawh khawih suh u, a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />‘Sangha chi tinrêng, luia awm te, tuifinriata awm te, dîla awm te, phuhlip leh pângparh neite chu in ei thei ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuia chêng si phuhlip leh pângparh nei lo chu ei loh tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chûng chu an tenawm a ni: an sa in ei tûr a ni lo va, a khawih pawh in khawih tûr a ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuia chêng, phuhlip leh pângparh nei lo chu in ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />‘Hêng savate hi sava tenawm an ni, an bawlhhlawh a, ei loh tûr a ni: mupui te, lungdûp te,
  </para>
  <para style="p">
    <verse number="14" style="v" />mutê te, ngawihûp chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="15" style="v" />choak chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="16" style="v" />sava sâng te, vabak te, tuifinriat sava te, mu chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="17" style="v" />hrângkir te, luidung mu te, chingpirinu te,
  </para>
  <para style="p">
    <verse number="18" style="v" />chhimbuksialki nei te, mulukawlh te,
  </para>
  <para style="p">
    <verse number="19" style="v" />kânghlai te, dîl sava chi rêng rêng te, chhuangtuarte leh bâk te.
  </para>
  <para style="p">
    <verse number="20" style="v" />‘Rannung thla nei, ke pali-a vâk chi rêng rêng chu in tân a tenawm a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zuankah theihna tûr bawppui nei chi erawh chu in ei thei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khaukhuap chi te, khauchher chi te, perhpâwng chi te, khau ṭial chi te in ei thei ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thla nei, ke pali-a vâkte chu in tân a tenawm a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />A thi khawih apiang tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />A thi sa pawh silhfênin a khawih chuan sûk tûr a ni, tlai thlengin a neitu chu a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />‘Ran eng pawh tin kâk mah se chaw ṭhial nawn lo emaw, a tin kâk chhuak lo emaw chu a bawlhhlawh a ni, a ruang khawih apiang chu a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />‘Ke pali nei, ke bâwr nei chi chu an bawlhhlawh a ni, an ruang khawih chu tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />An ruang latu chuan a thawmhnaw a su tûr a ni, tlai thlengin a bawlhhlawh ang; hêng ruangte hi in tân a tenawm a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />‘Leia a vaha vâkho hi in tân a bawlhhlawh bawk a ni: bui te, sazu te, tangkeu chi rêng rêng te,
  </para>
  <para style="p">
    <verse number="30" style="v" />chawke te, daidêp te, laikîng te, laitel te, kâwlchawr te;
  </para>
  <para style="p">
    <verse number="31" style="v" />hêng bawkvâka kalte hi in tân a bawlhhlawh a ni. A thi khawih chu tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tin, a thi chuan thing emaw, thawmhnaw emaw, savun emaw, ip emaw, thil dahnaa hman tawh phawt chu a delh chuan a bawlhhlawh ang a; tuia hnim tûr a ni, tlai thlengin a bawlhhlawh ang a, a thianghlim leh mai ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hlumbêl chhûnga a tlâk chuan a chhûnga awm zawng zawng chu a bawlhhlawh ang a, a bêl chu vuak keh tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thil ei theih chi rêng rêngah chutiang bêla tui lo awm chu leih a nih chuan a bawlhhlawh ve ang; chutiang bêla in theih chi awm rêng rêng pawh a bawlhhlawh ve a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hêngho thi ruang hi chhang ur bêlah emaw, khuhhriangah emaw a tlâk chuan a bawlhhlawh a, tihkeh sawm tûr a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />A thi ruang chu eng pawhin khawih se a khawihtu chu a bawlhhlawh a; mahse, tuikhuahah te, tuizêmahte tla se a bawlhhlawh ve lo.
  </para>
  <para style="p">
    <verse number="37" style="v" />Chîn atân thlai chi dah chungah tla pawh ni se thlai chi chu a bawlhhlawh ve lo.
  </para>
  <para style="p">
    <verse number="38" style="v" />Thlai chi chu tuia an chiah laiin hêng thi ruang hi a tlâk chuan a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />‘Sa ei thiang thi sela, a ruang khawih apiang tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="40" style="v" />A sa ei chuan a thawmhnaw a su tûr a ni: tlai thlengin a bawlhhlawh ang. A sa phurtu pawhin a thawmhnaw a su tûr a ni: tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="41" style="v" />‘Rannung, leia bawkvâk chi te hi in ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="42" style="v" />A tlenga tleng te, ke pali emaw, a aia tam emaw nei leia vâk chi rêng rêng hi in ei tûr a ni lo, a tenawm a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hêng hi in ei chuan in tenawm ve ang a, in bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kei Lalpa hi in Pathian ka ni a, invawng uluk ula, kei hi ka thianghlim a, nangni pawh in thianghlim ve tûr a ni. Leia vâk chi rêng rêng hian intibawlhhlawh suh u.
  </para>
  <para style="p">
    <verse number="45" style="v" />‘In Pathian ni tûrin Aigupta ram aṭanga hruai chhuaktu che u Lalpa ka ni. In thianghlim tûr a ni, kei ka thianghlim ang hian.
  </para>
  <para style="p">
    <verse number="46" style="v" />‘Hei hi ramsa te, sava te, tui chhûngte leh lei chunga vâkte chungchânga dân chu a ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />A bawlhhlawh leh bawlhhlawh lo, ei thiang leh thiang lo in thliar tûr a ni.’ ”
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel-te chu hrilh rawh, ‘Hmeichhiain nau a paia, mipa a hrin chuan ni sarih chhûng a bawlhhlawh ang, thi neih chhûnga a bawlhhlawh ang khân.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ni riat ni chuan nausên serh chu tan tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />A thisen chhuak avângin nu chu ni sawmthum leh pathum dang a ral hma chu a thiang lo vang a, a inthen thianghlim hma chu thil thianghlim eng mah a khawih tûr a ni lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Fanu hring chu ni sâwm leh pali chhûng, thi neih lai ang bawkin, a bawlhhlawh ang a, a thisen chhuak avâng chuan ni sawmruk leh paruk dang a ral hma chu a thiang lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mipa fa emaw, hmeichhe fa emaw avânga inthen fai hun a tlingtlâk hnuah Inbiakna bûk luhnaah kum khat vêla upa berâmno hâlral thilhlanah a rawn la ang a, sual thawina atân pârva emaw, ṭhuro emaw puithiam hnênah a rawn keng tel tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puithiam chuan Lalpa hnênah thilhlan chu a hlân ang a, bawlhhlawh inthenna chu a lo tihsak ang. Hei hi hmeichhiain fa a neiha a tih tûr chu a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />‘Hmeichhia chuan berâmno a neih zawh loh chuan ṭhuro pahnih emaw, pârva pahnih emaw a rawn hlân tûr a ni; pakhat chu hâlral thilhlan a ni ang a, pakhat chu sual thawina thilhlan a ni ang. Puithiam chuan a bawlhhlawh thenna chu a hlansak ang a, a lo thianghlim tawh ang,’ ” a ti a.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Vuna pân emaw, bawl emaw, vûng emaw a awma, dam mai thei lo tûr chi anga a lan chuan puithiam entîr tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Puithiamin pân chu ngun takin a han en ang a, a pân laia hmul chu a vâr a, a pân dân chu a vêl vun aia thûk hlea a lan chuan phâr natna chi a ni a, puithiam chuan mi bawlhhlawh a nih a puang ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />A pân chu a vâr a, pâwnlâng hlea a lan a, a hmul pawh a vâr loh bawk chuan puithiamin ni sarih chhûng a awm hrantîr ang a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ni sarih hnuah puithiam chuan a en leh ang a, a pân chu a ngai reng a niha, a darh loh chuan ni sarih dang a awm hrantîr leh ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ni sarih ral hnuah a en leh ang a, pân chu a lo hila, a darh loh chuan mi bawlhhlawh a ni lo tih puithiam chuan a puang ang. Pân narân mai a ni a, a silhfênte chu a su ang a, a thiang ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puithiamin a ena, a thiang tia a puan tawh hnuin pân chu darh sela, a inentîr leh tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Puithiam chuan a en leh ang a, a lo darh zau chuan mi bawlhhlawh a nih a puang ang: phâr natna chi a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tu pawhin phâr natna chi hi an vei chuan puithiam hnêna hruai ngei tûr a ni;
  </para>
  <para style="p">
    <verse number="10" style="v" />ani chuan ngun takin a lo en ang a, pân chu a vâr piapa, a hmul a vâr a, a hnai a awm bawk chuan
  </para>
  <para style="p">
    <verse number="11" style="v" />phâr dam har chi a ni: puithiam chuan mi bawlhhlawh a ni tih a puang ang, en leh tûra awm hrantîr a ngai lo vang: a bawlhhlawh tih a chiang sa a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chu natna chu a darha, puithiam hmuh phâk chin, a ke aṭanga a chhîp thleng a awh chhuah tawh chuan,
  </para>
  <para style="p">
    <verse number="13" style="v" />puithiamin ngun takin a en ang a, a taksa puma a darh chhuah zawh tawh chuan chu mi chu a thiang tawh tih a puang ang: a vun chu a vâr chhuah vek chuan a thianghlim tawh a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaherawhchu, lâwng a lo awm chuan a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puithiam chuan a en leh ang a, lâwng lai a hmuh chuan bawlhhlawh a ni tih a puang ang. Taksaa lâwng awm hi phâr natna a ni a, a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lâwng chu a reha, a lo vâr chuan puithiam a entîr tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Anin a lo en ang a, lâwng kha a lo vâr chuan chu mi chu a thianghlim a ni tih a puang ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Khawihli dam tawh,
  </para>
  <para style="p">
    <verse number="19" style="v" />a lo vûnin emaw, a sen a a lo durhin emaw puithiam entîr tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Puithiam chuan a bawlhhlawh tih a puang ang: khawihli aṭangin phâr natna a insiam a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />A hmul chu a vâr lohva, a vêl vun aṭanga thûk lêm lova puithiamin a hriat chuan chu mi chu ni sarih chhûng khung hran tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chu thil chu a ṭaidarh chuan puithiam chuan a bawlhhlawh a ni tih a puang ang: hri ṭha lo a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />A danglam lohva, a darh bawk loh chuan, khawihli aṭanga ser satliah a ni: puithiam chuan a thiang tih a puang ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Kângmei tuar chu a kâng lai a sen vêt emaw, a sendâng emaw a nih chuan
  </para>
  <para style="p">
    <verse number="25" style="v" />puithiamin a lo ensak ang a, a hmul a lo vâra, a vun pâwn aṭanga thûk viauva a lan chuan, a kâng hliam lai kha phâr natnaah a insiam ta a ni. Puithiamin chu mi chu a bawlhhlawh tih a puang ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />A hmul a vâr lohva, thûk tehchiam pawh niin lang lo mah se, a duk deuh chuan puithiamin ni sarih chhûng a khung hrang tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />A ni sarih niin puithiam chuan a en leh ang a, a ṭaidarh chuan phâr natna a ni: puithiam chuan chu mi chu a bawlhhlawh tih a puang ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />A ngai reng a niha, a ṭaidarh lohva, a duk bawk loh chuan phâr natna a ni lo; kang ser satliah a ni a: puithiamin chu mi chu a thiang tih a puang ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Mipa pawh hmeichhia pawh, an lû-ah emaw, an khabeah emaw pân a awm chuan
  </para>
  <para style="p">
    <verse number="30" style="v" />puithiamin a en ang a, a vêl vun aṭanga thûk hlea a lana, a hmulte chu a en deuh piap chuan phâr natna a ni: chu mi chu a bawlhhlawh tih a puang ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pân chu thûk tehchiamin lang lo mah se, a hmul te chu a dum ṭhat lêm loh chuan ni sarih chhûng khung hran tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ni sarih ni-ah puithiam chuan a pân chu a en leh ang a, a ṭaidarh lohva, thûk tehchiama a lan bawk loh chuan,
  </para>
  <para style="p">
    <verse number="33" style="v" />a pân bul vêla sam chu ziah kâwn tûr a ni, puithiam chuan ni sarih chhûng a khung hrang leh tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ni sarih niin puithiam chuan a pân chu a en leh ang a, a ṭaidarh lohva, thûk tehchiama a lan loh chuan, a thianghlim tih a puang ang; chu mi chuan a silhfên chu a su ang a, a thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />A thianghlim tih puan hnuah pân chu a ṭaidarh chuan
  </para>
  <para style="p">
    <verse number="36" style="v" />puithiamin a en leh ang a, pân chu a lo ṭaidarh ngei a nih chuan chu mi chu a bawlhhlawh a ni; a hmul a eng nge eng lo tih en a ngai lo vang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pân chu a ṭaidarh lohva, sam chu sam dum ṭha nia puithiamin a hriat chuan pân chu a dam ta tihna a ni; puithiam chuan a thianghlim ta tih a puang ang.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Mipa pawh, hmeichhia pawh, an vuna vâr a lo awm chuan,
  </para>
  <para style="p">
    <verse number="39" style="v" />puithiamin a ensak ang a, a vâr lai chu a thîm deuh chuan thil mawi lo satliah mai chauh a ni: amah chu a thianghlim tho a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />A tukkhum lam leh a chal lam sam tla fai sela, lukawlh satliah mai a ni a, a thianghlim tho a ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />A chal leh beksam tla fai sela, chalkawlh satliah a ni, a thianghlim tho.
  </para>
  <para style="p">
    <verse number="42" style="v" />A kawlh laiah eng emaw sendâng deuh emaw a awm chuan phâr natna a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Puithiamin a lo en ang a, sendâng deuh a awm chuan,
  </para>
  <para style="p">
    <verse number="44" style="v" />chu mi chu a lu-a phâr natna a awm avâng chuan a bawlhhlawh tih a puang ang.
  </para>
  <para style="p">
    <verse number="45" style="v" />“Phâr natna vei chuan kawr ṭet a ha ang a, a sam a thlah ang a, a hmai chanve, a khabe lam chu a tuam ang a, “Bawlhhlawh, bawlhhlawh,” tiin a au ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Chu phâr natna thak chu a neih chhûng chuan a bawlhhlawh a, mi dang bula awm ve lovin daipâwnah a awm tûr a ni.
  </para>
  <para style="p">
    <verse number="47" style="v" />“Sahmul puanah emaw, puan zai sînah emaw,
  </para>
  <para style="p">
    <verse number="48" style="v" />la phiarah emaw, sahmul la phiarah emaw, savunah emaw, savuna siam thil dangah emaw hmuar a kaia,
  </para>
  <para style="p">
    <verse number="49" style="v" />hring deuh emaw, sen deuh emaw nia a lan chuan hmuar darh chi a ni a, puithiam entîr tûr a ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />Puithiam chuan a en ang a, ni sarih chhûng a dah hrang ang a,
  </para>
  <para style="p">
    <verse number="51" style="v" />ni sarih ni chuan a en leh ang a; hmuar chu a lo darh chuan chu thil chu a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="52" style="v" />Puithiam chuan a hâl tûr a ni; hmuar, meia hâl tûr chi a ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />A ena, a lo darh loh chuan
  </para>
  <para style="p">
    <verse number="54" style="v" />a sûk faitîr ang a, ni sarih dang a dah leh ang a,
  </para>
  <para style="p">
    <verse number="55" style="v" />a en leh ang a, hmuar chu darh lo mah se a hmuar rawng chu a danglam loh chuan a la bawlhhlawh tho a ni; a hmuar chu a pâwn lam chauhvah emaw, a chhûng lam chauhva awm emaw a nih pawhin.
  </para>
  <para style="p">
    <verse number="56" style="v" />A han en leh a, hmuar chu a lo nêp chuan a awmna lai chu puan aṭangin emaw, savun aṭangin emaw chuan a hlep thla ang.
  </para>
  <para style="p">
    <verse number="57" style="v" />Hmuar kha a lo lan leha, darh zêla a lan chuan puan neitu khân a hâl mai tûr a ni.
  </para>
  <para style="p">
    <verse number="58" style="v" />A han sûka a reh mai chuan a su nawn leh ang a, a thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="59" style="v" />La zai sîn puan emaw, sahmul puan phiarah emaw, savuna siam thil rêng rêngah emaw hmuar a kai a, a thianghlim leh thianghlim loh thliar dân tûr chu chutiang chu a ni,” a ti a.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Phâr dam leh then fai dân tûr chu hetiang hi a ni. A thianghlim ta tih puan ni chuan puithiam hnênah a kal ang a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Puithiamin daipâwnah a hruai ang a, ngun taka a en hnuah a dam ngei a ni tih a hriat chuan
  </para>
  <para style="p">
    <verse number="4" style="v" />sava thiang pahnih, sidar thing leh lazai senduk leh husop têl nên rawn keng tûrin a hrilh ang a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khuhhriangin tui luang lai suak sela, chumi chungah chuan sava pakhat chu talh tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thisen farna tuiah chuan sava pakhat zâwk kha sidar thing te, lazai senduk te, husop têl te nên chuan a chiah ang a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tihthianghlim tûra chu thisen chuan vawi sarih a theh ang a, a thianghlim ta tih a puang ang a, sava chu ramhnuaiah a chhuah ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chu mi chuan a silhfênte chu a su ang a, a lu a mêt ang a, a inbual hnuah a thianghlim mai ang a, riahhmunah a lût ve thei tawh ang; amaherawhchu, ni sarih chhûng ama bûk pâwnah a riak tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ni sarih hnuah a lu te, a hmuihmul te, a mitko hmul te leh a hmul dang te pawh a ziat fai ang a, a thawmhnaw a su ang a, a inbual hnu chuan a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Ni riat ni chuan berâmno, a pa pahnih leh a nu pakhat, kum khat vêla upa, hmêlhem lo leh chhangphut kg. thum, hriak telh loh oliv hriak litar hmun thuma ṭhena hmun khat a rawn la ang a,
  </para>
  <para style="p">
    <verse number="11" style="v" />puithiam chuan chu mi chu a thilhlante nên Inbiakna bûk kawngkaah chuan a hruai tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Berâmno pakhat, a pa chu, oliv hriak litar hmun thuma ṭhena hmun khat nên chuan bawhchhiat man thilhlanah a hlansak ang a, Lalpa hmaah a thên ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Berâmno chu sual thawina leh hâlral thilhlan tûr talhna hmun thianghlimah a talh ang a, hetiang bawhchhiat man thilhlan hi sual thawina thilhlan angin puithiam tân serh hran tlat a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Puithiam chuan berâmno thisen chu a hlântu beng ding lam tengengah te, a kut leh kezungpui ding lam hmâwrah ve ve te a tahsak ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puithiam chuan oliv hriak ṭhenkhat chu a kutphah vei lamah a bun ang a,
  </para>
  <para style="p">
    <verse number="16" style="v" />a kut ding lam zungchal a hnim ang a, Lalpa hmaah hriak chu vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kuta hriak leh berâmno thisen ṭhenkhat chu a chawhpawlh ang a, a beng ding lam tengengah te, a kut leh a kezungpui hmâwrahte a hnawihsak ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />A kuta hriak la awm chu tihthianghlim tûra lu-ah chuan a thih ang a, chutiang chuan inthenna chu a tihsak ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sual thawina thilhlan chu a hlansak ang a, chu mi chu a thian thianghlim ang. Chumi zawhah chuan hâlral thilhlan chu a talh ang a,
  </para>
  <para style="p">
    <verse number="20" style="v" />buhbâl thilhlan nên maichâmah a hlân ang a, chutiang chuan a thian thianghlim ang a, chu mi chu a thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Chutiang zât nei zo lo pachhia chuan inthenna berâmno pakhat, bawhchhiat man thilhlan atân a rawn la ang a, sual thawi nân thên tûr a ni; chumi rual chuan chhangphut hriak nêna pawlh kg. khat leh oliv hriak litar hmun thuma ṭhena hmun khat a hlân tel tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />A neih theih zâwk zâwk, ṭhuro pahnih emaw, pârva pahnih emaw, pakhat chu sual thawina thilhlanah, pakhat chu hâlral thilhlanah a rawn hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />A inthen ni riat ni chuan Lalpa hmaah Inbiakna bûk kawngkaah a rawn la tûr a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Puithiam chuan berâm leh oliv hriak chu a la ang a, Lalpa hmaah a thên tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Berâmno chu a talh ang a, a thisen ṭhenkhat chu a beng ding lam tengengah te, a kut leh a kezungpui ding lam hmâwrah te a tahsak ang a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Puithiam chuan oliv hriak ṭhenkhat chu a kutphah vei lamah a bun ang a,
  </para>
  <para style="p">
    <verse number="27" style="v" />a kut ding lam zungchal a chiah ang a, Lalpa hmaah vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hriak ṭhenkhat chu, chu mi beng ding lam tengengah te, a kut leh a ke ding lam zungpui hmâwrah te a tât tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />A kuta hriak la awm chuan chu mi lu chu a thih tûr a ni. Chutiang chuan inthenna chu a tihsak tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chumi zawhah chuan ṭhuro emaw, pârva emaw pakhat chu,
  </para>
  <para style="p">
    <verse number="31" style="v" />sual thawina atân, buhbâl thilhlan nên a hlân ang a, chutiang chuan a thian thianghlim ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hetiang hi phâr natna, inthenna tûr tuk zât nei zo lo tân inthen ve dân tûr chu a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="34" style="v" />“In neih atâna ka pêk tûr che u Kanan ram in thlen hunah, in ram neiha in in chhûnga hmuar ka kaitîr chuan,
  </para>
  <para style="p">
    <verse number="35" style="v" />in neitu chuan puithiam a ko vang a, ‘Ka in chhûngah hmuar ni âwm tak a kai e,’ a ti ang a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Puithiam chuan in chhûnga a luh hmain a chhûnga thil awm zawng zawngte chu a bawlhhlawh tih a puan hnan loh nân a thiar chhuahtîr zet ang a, en chiang tûrin in chhûngah chuan a lût ang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hmuar hri chu ngun takin a en ang a, a hring emaw, a sen ṭhip ṭhep emaw a awm a, bang chu mawih ṭana a hriat chuan,
  </para>
  <para style="p">
    <verse number="38" style="v" />in chu a chhuahsan ang a, ni sarih chhûng a kalhtîr ang.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ni sarih ni chuan in chu a tlawh leh ang a, bangah a lo ṭaidarh chuan,
  </para>
  <para style="p">
    <verse number="40" style="v" />hmuar kaina lung chu khaw pâwn bawlhhlawh paihnaah a paihtîr ang.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chumi hnu chuan in chhûng lam bang bel mâmna zawng zawng chu a ziah khawhtîr ang a, a khawk chu khaw pâwn bawlhhlawh paihnaah paih tûr a ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Lung paih kha a thara thlâk tûr a ni, a lung bang pawh a thara zût mâm tûr a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hêng hi paih a niha, zût mâmna ziah khawh vek hnua a thara thlâk a nih hnua hmuar kai leh a nih chuan,
  </para>
  <para style="p">
    <verse number="44" style="v" />puithiam chuan a va en leh ang a, a lo ṭaidarh chuan a reh thei lo chi a ni a, in chu a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ṭhiat vek tûr a ni, lung te, thing te, a zût mâmna te chu paih tûr a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />In chu kalh a nih chhûnga lût an awm chuan tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chu in chhûnga mu emaw, thil ei emaw chuan a silhfên chu a su ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="48" style="v" />“In chhûng lung chu an zût mâm thar hnu chuan puithiamin a va en leh ang a, hmuar kai chu a awm tawh lohva, a reh fel tawh chuan in chu a thianghlim tih a puang ang.
  </para>
  <para style="p">
    <verse number="49" style="v" />Chu in thian thianghlim tûr chuan sava pahnih a man ang a, sidar thing te, la senduk te leh husop têl a inchhawp bawk ang a.
  </para>
  <para style="p">
    <verse number="50" style="v" />Sava pakhat chu lui tui dahna khuhhriang chungah,
  </para>
  <para style="p">
    <verse number="51" style="v" />sava pakhat zâwk chu sidar thing te, la zai senduk te leh husop têl te nên chuan khuhhrianga lui tui, sava pakhat thisen farnaah chuan a chiah ang a, in chhûng chu vawi sarih a theh ang.
  </para>
  <para style="p">
    <verse number="52" style="v" />Sava thisen leh tui luang lai te, sidar thing te, la senduk te leh husop têl te hmang chuan in chu a thian thianghlim ang.
  </para>
  <para style="p">
    <verse number="53" style="v" />Sava la nung zâwk chu khua aṭangin ramhnuaiah a chhuah ang a, chutiang chuan in then faina chu a ti ang a, a lo thianghlim tawh ang.
  </para>
  <para style="p">
    <verse number="54" style="v" />“Hêng hi taksaa phâr tih dân tûr a ni.
  </para>
  <para style="p">
    <verse number="55" style="v" />Thawmhnaw emaw, in chhûng emawa phâr hri te,
  </para>
  <para style="p">
    <verse number="56" style="v" />taksa vûng emaw, durh emaw, bâwk emaw, a thiang nge thiang lo thlei dân tûr chu a ni.”
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia leh Arona hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh u; mipa tu pawh, an zahmawh aṭanga thil pût a awm chuan a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pût zui zêl emaw, a tâwp leh mai emaw pawh ni se, a bawlhhlawh tawh a, hetianga tih tûr a ni:
  </para>
  <para style="p">
    <verse number="4" style="v" />Chutiang mi mutna khum leh a ṭhutna apiang chu a bawlhhlawh ve a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />A khum khawihtu pawh, a ṭhutnaa ṭhu pawh chuan an silhfên an su ang a, an inbual tûr a ni; tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />A taksa khawihtu pawhin a thawmhnaw a su ang a, a inbual tûr a ni, tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chu mi chuan mi bawlhhlawh ni lo chil chhâk se, a chhâka chu a bawlhhlawh ve ta a, a silhfên a su ang a, a inbual tûr a ni; tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chu mi chuanna sakawr zîn chu a bawlhhlawh ang a,
  </para>
  <para style="p">
    <verse number="10" style="v" />a ṭhut hnan tawh phawt khawihtu pawh chu tlai thlengin a bawlhhlawh ang; chûng thil chawi sawntu pawh chuan a silhfên a su ang a, a inbual tûr a ni: tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thil pût neitu chuan kut sil zet lovin mi dang a khawih chuan, a khawiha chuan a silhfên a su ang a, a inbual tûr a ni: tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hlumbêl a khawih chu tihkeh tûr a ni, thing thlêng erawh chu ngun taka sil tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />“A thil pût vei chu a dam aṭangin a thianghlim leh nân ni sarih a nghâk ang a, a silhfênte a su ang a, tui luang laiah a inbual tûr a ni; tichuan, a lo thianghlim thei ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />A ni riat ni chuan ṭhuro pahnih emaw, pârva no pahnih emaw Lalpa hmaah Inbiakna bûk kawngkaah a rawn la ang a, puithiam a pe ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pakhat chu sual thawina thilhlanah, pakhat chu hâlral thilhlanah, a hlansak ang a; chutiang chuan a bawlhhlawhna chu a tihthianghlimsak ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Mipa chu a chi a tlâk ringawt chuan a inbual tûr a ni; tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />A chi tlâkna puan emaw, savun emaw a thil siam tawh phawt chu sûk ngei tûr a ni: tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Mipa leh hmeichhiain inpâwlna an neih zawhin an inbual fai ziah tûr a ni: tlai thlengin an bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmeichhia, thi nei chu, ni sarih chhûng a bawlhhlawh ang. Amah khawih apiang tlai thlengin an bawlhhlawh ve ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />A thi neih laia a ṭhutna te, a mutna te chu a bawlhhlawh vek a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />A mutna emaw, a ṭhutna emaw khawihtu chuan a silhfên a su ang a, a inbual tûr a ni: tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />A mutna emaw, a ṭhutna emaw rêng rêng khawihtu chu tlai thlengin a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Hmeichhe thi nei lai pâwltu chuan a bawlhhlawhna chu a kai ve a, ni sarih chhûng a bawlhhlawh ve ang, a mutna khum pawh a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Hmeichhia chu a thi neih hun pangngai ni lovah, a thi a pût emaw, a thi neih ṭhin chhûng aia rei emaw thi a neih chuan, a thî a chhuah chhûng chu a bawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />A thî â puh chhûnga a mutna leh a ṭhutna chu a bawlhhlawh a ni, a thi neih pangngai lai ang chiah khân.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hêng khawihtu chuan a silhfên a su ang a, a inbual tûr a ni: tlai thlengin a bawlhhlawh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />A thi pût chu a tâwp hunah ni sarih chhûng a inenthla ang a, a thianghlim thei ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />A ni riat ni-ah ṭhuro pahnih emaw, pârva pahnih emaw Inbiakna bûk kawngkaah puithiam hnênah a rawn dah ang a;
  </para>
  <para style="p">
    <verse number="30" style="v" />puithiam chuan pakhat chu sual thawina thilhlanah, pakhat chu hâlral thilhlanah a hlansak ang a, Lalpa hmaa inthen thianghlimna chu a tihsak ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Israel mipuite bawlhhlawh laiin an inkiltawih tûr a ni; Inbiakna bûk bul maia awm an ni a, an rawn tibawlhhlawh hlauh ang e, an thi mai ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Hei hi, mipa, a zahmawha thil pût nei emaw, a chi a tlâkin emaw,
  </para>
  <para style="p">
    <verse number="33" style="v" />hmeichhia pawh a thla tin thi neih leh a bawlhhlawh laia pâwltu chungchâng tih dân tûr chu a ni.”
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Arona fate pahnihin Lalpa hmaa mei thiang lo hmanga rimtui an hâl avânga an thih tâk hnu khân Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“I u Arona chu hrilh rawh: Thuthlung Bâwm chhîn chunga chhûma ka lo kal ṭhin avângin Hmun Thianghlim Ber pindan zâr chhûngah a lo lût mai mai tûr a ni lo; chu chu a pawisak loh chuan a thi mai ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmun Thianghlim Berah chuan bâwngpatuai, sual thawina thilhlanah leh berâm hâlral thilhlan rawn hlân tûrin a lo lût thei ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />A inbual zet ang a, silhfên thianghlim a inbel tûr a ni; puan zai sîn kawr te, kekawr te a ha ang a, puan zai sîn kâwnghrên a hrêng ang a, puan zai sîn diar a khim bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel pungkhâwmho chuan sual thawina thilhlan tûr kêlpa pahnih leh hâlral thilhlan tûr berâm pachal pakhat an pe tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Arona chuan bâwngpa chu amah leh a chhûngte sual thawi nân sual thawina thilhlanah a hlân ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Inbiakna bûk luhnaah kêl pahnih chu a kai ang a,
  </para>
  <para style="p">
    <verse number="8" style="v" />a eng zâwk nge Lalpa tân ni ang a, a eng zâwk nge Azazela tân ni ang tih hriat nân ṭhum a vâwr ang a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa thlan zâwk chu sual thawina thilhlanah a hlân ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Azazela tâna thlan kêl chu Lalpa hnênah a nung chunga hlan phawta, mipuite sual lâk bo nân Azazela hnênah thlalêrah chhuah tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Arona chuan bâwngpa chu a hlân ang a, amah leh a chhûngte sual thawi nân sual thawina thilhlan a hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Meilawhin maichâma meiling chu a lâwk ang a, rimtui hâl chi ṭhûm khat nên Hmun Thianghlim Berah a rawn dah tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa hmaah rimtui chu meiah chuan a phul ang a, rimtui khu chuan Thuthlung Bâwm chhîn chu a hliah dawn nia; tichuan, a hmu thei lo vang a, a thi mai dâwn lo nia.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bâwngpa thisen chu a kutzungchalin Thuthlung Bâwm chhîn chhak lamah chuan a theh ang a, Thuthlung Bâwm hmaah pawh vawi sarih a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chumi hnuah chuan kêl kha mipui sual thawina thilhlanah a talh ang a, a thisen chu Hmun Thianghlim Berah chuan a rawn dah ang a, bâwngpa thisen a tih ang khân Thuthlung Bâwm hma lamah leh a chhînah a theh tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chutiang chuan Hmun Thianghlim Ber chu Israel mipuite bawhchhiatna leh an sualna aṭangin a thian thianghlim tûr a ni. Inbiakna bûk chu riahhmun bul maia awm a ni a, riahhmun bawlhhlawhna avângin chutia tihthianghlim chu a ṭûl a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Hmun Thianghlim Ber thian fai tûra Arona a luh leh a lo chhuah leh inkârah Inbiakna bûk chhûngah tu mah an awm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah leh a chhûngte sual leh Israel pungkhâwmho sual thawina a tih zawh chuan pâwnah a lo chhuak ang a, maichâmah hâlral thilhlan a hlân ang a, a thian thianghlim ang. Bâwngpa thisen leh kêl thisen ṭhenkhat chu maichâm kila ki-ahte chuan a tât tûr a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />A zungchalin thisen ṭhenkhat chu maichâmah vawi sarih a theh ang, Israel mite sualna avângin a thian thianghlim tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmun Thianghlim Ber te, Inbiakna bûk chhûng zawng zawng te, maichâm te a then thianghlim hnu chuan Azazela tâna kêl kha Lalpa hmaah a hlân ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kêl lu-ah chuan a kut khing hnih a nghat ang a, Israel miten thil ṭha lo leh sual an tihte leh an khawlohna zawng zawng chu a puang ang a, kêl lu-ah chuan a nghat ang; a ti tûra mi ruat chuan thlalêrah kêl chu a kalpui ang a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kêl chuan an bawhchhiatna zawng zawng chu a phur ang a, thlalêrah chuan a chhuah ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Chumi zawhah Arona chu Biakbûk chhûngah a lût ang a, Hmun Thianghlim Bera a luh dâwna puithiam kawr a hâkte kha a hlîp ang a, a hnutchhiah ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hmun Thianghlimah chuan a inbual ang a, ama thawmhnaw a inbel leh ang a, hâlral thilhlan, ama pual leh mipui pualin a hlân ang a, ama sual leh mipui sual chu a thawi dâwn a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sual thawina thilhlan ran thaute chu maichâmah a hâl ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Thlalêra Azazela tâna kêl va thlahtu kha a lo haw hunah a thawmhnaw a su ang a, a inbual bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Bâwngpa leh kêl, sual thawina thilhlan atâna talh, sual lâk bo nâna an thisen, Hmun Thianghlim Bera lâk luhte sa chu, a vun te, a kawchhûngte nên daipâwnah hâl vek tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Va hâl raltu chuan a silhfên a su ang a, bûk lama a kîr hmain a inbual tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />“He dân hi zawm kumkhua tûr a ni. Thla sarihna, ni sâwm ni chuan Israel mi zawng zawng leh an zînga hnam dang awm vete chuan chaw an nghei ang a, hna rêng an thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hemi ni hian a ni, an lo thianghlim theih nân an sual zawng zawng thawina thilhlan an hlan ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />“He ni hi ni serh, serh tlat tûr, chaw ngheia hna pawh thawh lohna tûr ni a ni. He dân hi kumkhuaa zawm tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Puithiam lalber tûra hriakthih, a pa aiawh tûra nemngheh chuan puithiam kawr thianghlim ha-in hêng thil hi a ti tûr a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hmun Thianghlim Ber te, Inbiakna bûk chhûng te, maichâm te, puithiamte leh pungkhâwmho then faina hna chu a tih tûr a ni.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hêng dânte hi kumkhua a zawm tûr a ni. Israel mite sualna zawng zawng then faina hna hi kum tin vawi khat tihsak ngei tûr a ni,” a ti a. Mosia chuan Lalpa thupêk ang chuan a ti ta a.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona leh a fate leh Israel mite chu hrilh rawh, hei hi Lalpa thupêk a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel miin riahhmunah pawh, daipâwnah pawh bâwngpa emaw, berâm emaw, kêl emaw a talha,
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa hnêna hlan tûr si Inbiakna bûk kawngka-a a talh loh chuan dân bawhchhia a ni. Thisen chhuah ang a ngaih tûr a ni a, a chipuiten an ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ramhnuaia inthawina ran talh an chîn ṭhin te hi Lalpa hnêna hlân tûrin puithiam hnênah Inbiakna bûk kawngkaah an rawn kai ang a, Lalpa hma-a remna thilhlanah an rawn hlân tawh ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puithiam chuan a thisen chu Inbiakna bûk luhna bula maichâmah a theh ang a; a thaute chu a hâl ral tûr a ni, chu chu Lalpa duhzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kêl hmêl pu ramhuai an be tawh tûr a ni lo; chutiang bia chu Lalpa lakah an uire a ni. He dân hi Israel miten an zâwm kumkhua tûr a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Israel mi emaw, hnam dang an zînga awm emaw, tu pawhin Lalpa hnênah hâlral thilhlan pawh, thilhlan chi dang rêng rêng pawh,
  </para>
  <para style="p">
    <verse number="9" style="v" />Inbiakna bûk kawngka bulah chauh an hlân tûr a ni; hmun danga hlan chu Pathian miten an ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel chhûngkaw zînga mi emaw, an zînga hnam dang awm emaw, a thisen chawpa sa ei tawh phawt chungah Lalpa a ṭuan ang. Pathian mite zîng ata hnawh chhuah tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thil nung rêng rêng, an nunna chu an thisenah a awm a; chuvâng chuan, mite sual la botu tûr thisen chu maichâma leihbuak tûr, Lalpan a ti a ni. Thisen chu nunna a ni a, chu chuan sual chu a la bo va ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chuvângin a ni, Lalpa chuan Israel mite leh an zînga hnam dang awm vete chuan a thisen chawpin sa an ei tûr a ni lo a tih ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Israel miin emaw, an zînga hnam dangin emaw, sa thiang pawh, sava thiang pawh ramvahnaah man sela, a thisen chu leiah a far kangtîr ang a, vaivutin a chhilh leh tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thil nung tinrêng nunna chu a thisenah hian a awm si a; chuvângin Lalpa chuan Israel mite chu a thisen chawpa sa eng mah ei lo tûrin a ti a ni. Tu pawh, ei lui chu, Israel zîng ata ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel mi emaw, an zînga chêng hnam dang mi emaw, tu pawhin ran thisâwn sa emaw, sa seh sa emaw a ei chuan an silhfên an su ang a, an inbual ngei tûr a ni, tlai thlengin an bawlhhlawh ang; chutah an thiang chauh vang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Insu duh lo emaw, inbual duh lo emaw chuan an tuar ang,” a ti a.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu in Pathian, Lalpa ka nih hi hrilh rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />In chên tawhna Aigupta mite tih dân chîng ve suh ula, ka hruai luhna tûr che u Kanan ram mite awm dân pawh la hek suh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka dânte hi in zâwm ang a, ka thupêk angin in awm zâwk tûr a ni. Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka dânte hi zâwm ula, tih tûra ka tihte hi ti rawh u; chu chu mihring tân nunna tûr a ni; Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Tu man mahni laichîn hnai pâwl tûr a ni lo, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />I pa timualpho tûrin i nu i pâwl tûr a ni lo, i nu a ni a, ani pawh i timualpho tûr a ni lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />I pa nupui dang tu pawh pâwlin i pa i timualpho tûr a ni lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />In khata awm ho in ni emaw, ni lo emaw i farnu, nu hrang emaw, pa hrang emaw hrin pawh i pâwl tûr a ni lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />“I fapaa fanu te, i fanu hrin i tunute pâwl suh, mahni intimualpho i ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />I pa nupui fanu chhawm pawh i pâwl tûr a ni lo, i farnu a ni tho asin.
  </para>
  <para style="p">
    <verse number="12" style="v" />“I ni i pâwl tûr a ni lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />I nu laizâwn pawh i pâwl tûr a ni lo, inlaichîn hnai in ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />I pami nupui pawh pâwl suh, ani pawh i nu bawk a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />I fapa nupui, i mo chu pâwl suh.
  </para>
  <para style="p">
    <verse number="16" style="v" />I unaupa nupui pawh pâwl suh.
  </para>
  <para style="p">
    <verse number="17" style="v" />“I hmeichhe pawl tawh fanu emaw, tunu emaw pâwl suh, thil sual a ni; i laichîn hnai an ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />I nupui dam chhûngin a laizâwn nupuiah nei suh.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Hmeichhe thi nei lai pâwl suh, a bawlhhlawh lai a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi nupui pâwl suh, mahni i intibawlhhlawh a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Moleka biak nâna hâl ral tûrin i fa i pe rêng rêng tûr a ni lo, i Pathian hming i tibawrhbâng ang e, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Mipain mipa vêk a mutpui tûr a ni lo, a tenawm a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mipa pawhin, hmeichhia pawhin ran an mutpui tûr a ni lo; chutiang chîng chu piangsual an ni a, intibawlhhlawh ve suh u.
  </para>
  <para style="p">
    <verse number="24" style="v" />In hmaa ka ûm chhuah tûr hnamte kha hêng thil hian an intibawlhhlawh ṭhîn a, hêng thil hian intibawlhhlawh ve suh u.
  </para>
  <para style="p">
    <verse number="25" style="v" />An thil chîn avangin ram chu an tibawrhbâng a, an sual avâng chuan ram chu ka hrem ang a, anniho chu ka hnawt chhuak dâwn a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangni chuan ka dânte leh ka thupêkte hi zâwm ula, in zînga tu mahin, in zînga chêng hnam dangte lam pawhin, hêng thil tenawm hi ti ve suh u.
  </para>
  <para style="p">
    <verse number="27" style="v" />In awm hmaa hêng rama awmte hian hêng thil tenawm hi an ti ṭhîn a, ram chu an tibawlhhlawh ta a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chumi rama awm in hmaa mite hnawh chhuaha an awm ang khân, ram chu in tihbawlhhlawh ve chuan hnawh chhuah in ni ve ngei ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />In zînga hêng thil ti ve chu ensan ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hêng thil tenawm in hmaa mite chîn ṭhin hi ti ve lo tûrin ka ti che u a ni, intibawlhhlawh ve rêng rêng suh u, Lalpa in Pathian ka nih hi,” a ti a.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mipui pungkhâwmho chu hrilh rawh: In thianghlim tûr a ni, kei Lalpa in Pathian hi ka thianghlim si a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mahni nu leh pa in zah ṭheuh tûr a ni, ka thupêk angin ka sabat ni in serh tûr a ni, Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milem lamah thle suh u, biak atân milem chhûn siam hek suh u, Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“ Lalpa hnêna remna thilhlan in hlanin tih dân tûr ka sawi ang hian ti ula, ka lo pawm ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />A sa chu in talh ni-in emaw, a tûkah emaw ei zawh tûr a ni a; a ni thum ni thlênga la awm chu hâl tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />A ni thum nia in ei chuan, a bawlhhlawh tawh avângin in thil hlan chu ka pawm lo vâng.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chutiang ei chuan thil thianghlim an tibawrhbâng a, a mawh an phur tûr a ni, an chipuite chuan an ensan tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Buh in sengin vau fêm chenin seng suh u, in lâk hmaih vai tûrin kal leh hêk suh u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Grep vawi khat lawh hnu emaw, a rah tla emaw vai suh u, mi retheite leh hnam dangte tân hnutchhiah rawh u, Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ru suh, bum suh, dâwt sawi hek suh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka hming chhâlin dâwt sawi suh, i Pathian hming i tihliau tûr a ni lo, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“I vêngte nêkchêp suh la, an thil neih chhuhsak hek suh. I hnêna inhlawhfa hlawh chu zan khat pawh hrênsak suh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bengngawng bechhawhchhi suh; mitdel hmaah inchhuih tlûk theihna tûr eng mah dah suh. In Pathian hi ṭih rawh u, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Dik takin i vêngte thu rêlsak ṭhîn la, mi rethei duhsak bîk lo la, mi hausa hlau chuang hek suh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi chungchâng, dâwt thu pudarhtu ni suh; thi mai thei dinhmuna ding chu chhan tûrin i thu hriat ang ang sawi hreh suh: Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tu mah haw rilru suh, tlang taka thu sawi chhuakin in inkâr thu tifel ang che; chutichuan, thil sual i ti dâwn lo nia.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tu ma chungah phuba la suh, haw reng hek suh; i vêngte chu nangmah i inhmangaih ang bawkin hmangaih ve rawh. Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Ka thupêkte hi zâwm rawh. Ran chi hrang hrang no thlah pawlhtîr tum lui suh. Lo pakhatah thlai chi hrang hrang chîng suh. Thil chi hnih kaih pawlha tah kawr ha suh.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Bawih nula chu miin hmei atân hual sela, a man la pêk loh emaw, la chhuah loh emaw a nih chuan mi dangin lo ngai mah se, bawih mai an ni a, tihhlum tûr a ni lo, hrem tûr erawh chu an ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />A mipa chuan bâwhchhiat man thilhlan, Inbiakna bûkah a rawn hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chu mi sual thawina tûr inthenna chu puithiamin a lo hlansak ang a, Pathianin a ngaidam ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Kanan ram in lo thlen hunah, thei in phun rêng rêng a rah tirh aṭanga kum thum chhûng bawlhhlawha ngaih tûr a ni a, ei suh ang che u.
  </para>
  <para style="p">
    <verse number="24" style="v" />A kum linaah theirah zawng zawng chu Lalpa in Pathian hnêna lâwmthu hrilh nân in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kum nganaah erawh chuan theirah chu in ei thei tawh ang; chutianga in tih chuan in thei chu a rah duh hle ang; Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Sa rêng rêng a thisen chawpin ei suh u. Mitthi thlûk te, aien te chîng suh u.
  </para>
  <para style="p">
    <verse number="27" style="v" />Bak sam ziah kawlh te, hmuihmul meh te,
  </para>
  <para style="p">
    <verse number="28" style="v" />inziak ṭial te, inzai kak te lusûn entîr nân chîng ve suh u.
  </para>
  <para style="p">
    <verse number="29" style="v" />“I fanu chu Tempul nawhchizuara pein tihmingchhe suh; hnam dang pathian lam i hawi hlauh vang a, ram chu suahsualnain a khat dah ang e.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sabat ni serh la, chibai mi bûkna hmun chu zah rawh, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Ramhuaizâwl emaw, mitthi thlûk thiam emaw râwn tûrin kal suh; chutiang i tih chuan i bawlhhlawh ang. Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lu-a kêlsam ṭo tawhte hmaah din nachâng hria la, upate chu zah rawh. In Pathian ṭih rawh u, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“In rama hnam dang awm ve te chu tinawmnah suh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />In Israel-puite angin en ula, mahni in inhmangaih angin hmangaih ve rawh u. Nangni pawh Aigupta ramah mikhual in nih ṭhin kha hre reng rawh u. Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Tehna dik lote, bûklung dik lote, tehkhâwng dik lote hmangin mi bum suh u.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tehna dik tak, bûklung dik tak, tehkhâwng dik tak hmang ṭhîn rawh u. Aigupta ram aṭanga hruai chhuaktu che u Lalpa , in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Ka dân zawng zawng leh ka thupêkte hi zâwm rawh u, Lalpa ka nih hi” ti in.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite hrilh rawh; Israel miin emaw, in zînga chêng ram dang miin emaw Moleka hnêna mahni fa a hlan chuan tihhlum tûr a ni, pungkhâwmho chuan lungin an dêng hlum tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mahni fa Moleka hnêna hlâna ka Hmun Thianghlim tibawrhbânga, ka hming thianghlim tichhetu chu ka hawisan ang a, ka ensan ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel mipuiten chu thil chu an ngaihthaha, an tihhlum duh loh chuan,
  </para>
  <para style="p">
    <verse number="5" style="v" />keimah ngei hi chu mi chungah leh a chhûngte chungah ka ṭuan ang a, Moleka bia-a ka laka rinawm lo zawng zawng chu ka mite zîngah ka telh tawh lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ramhuaizâwl leh mitthi thlûk thiam râwntute chu ka hawisan ang a, ka mite zîngah ka telh tawh lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa in Pathian ka nih avângin invawng thianghlim rawh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka dânte hi zâwm ula, ti ṭhîn rawh u. Lalpa in Pathian chu ka ni, a tihrangtu che u ka ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Mahni nu leh pa ânchhe lawhtu chu tihhlum tûr a ni; a thisen mawh chu amahin a phur ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />“A Israel-pui nupui uiresaktu chu a hmeichhia nên tihhlum tûr an ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Miin a pa nupui zînga pakhat pawh a lo pâwl chuan a pa a timualpho a ni a, a hmeichhia nên tihhlum tûr an ni a, an thisen mawh chu anmahniin an phur ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Miin a mo a mutpui chuan a hmeichhia nên tihhlum tûr an ni. Laichîn hnai inngai an ni a, an thisen mawh chu anmahniin an phur ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mipain mipa dang a pâwl chuan thil zahthlâk tak an ti a ni, an pahnihin tihhlum tûr an ni, an thisen mawh chu anmahniin an phur ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Miin nufa nupuia a neih kawp chuan thil zahthlâk tak an ti a ni, an pathum chuan hâl hlum tûr an ni; hetiang thil hi in zîngah ti an awm tûr a ni lo.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Miin ran a pâwl chuan ran nên chuan tihhlum tûr an ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmeichhia pawh ran pâwl tuma mutpui chu ran nên chuan tihhlum tûr a ni, an thisen mawh chu anmahniin an phur ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Miin a farnu, nu hrang hrin emaw, pa hrang hrin emaw nupuia a neih chuan vântlâng zînga tihmualpho tûr a ni; khua ata hnawh chhuah tûr a ni. Mahni farnu a ngai a, a mawh chu a phur tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Miin hmeichhe thi nei lai a pâwl chuan an pahnihin ensan tûr an ni, bawlhhlawh lai chungthu-a dân an bawhchhia a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Miin mahni ni emaw, nute laizâwn emaw a pâwl chuan an pahnihin an sual mawh chu an phur tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Miin a pami nupui a pâwl chuan a pami chu a timualpho va, a hmeichhia nên chuan an sual mawh chu an phur ang, fa rêng an nei lo vang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mahni unau nupui chhuhsaktu chuan fa rêng a nei lo vang, thil bawlhhlawh tak a ti a, a unaupa a timualpho a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Ka dân leh ka thupêk zawng zawngte hi zâwm ula, ti ṭhîn rawh u; tichuan, in awmna tûr ram ka hruai thlen hunah che u chuan chu ram ata chu hnawh chhuah in ni dâwn lo nia.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chûng hmuna lo awm, ka hnawh chhuahsak tûr che u te awm dân la ve suh ang che u; hêng hi tih an chîng a, ka tenzâwng tak an ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />He ram, khawizu leh hnutetuia luang ram hi, in neih atân pêk che u ka lo tiam tawh a, ka pe ngei ang che u; Lalpa , in Pathian ka ni, hnam dang zîng ata ka la hrang che u a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chuvângin, rante leh savate chu a thiang leh thiang lo thliar ngun ula, ran thiang lo emaw, sava thiang lo emaw ei suh u; thiang lo ka tih in ei chuan in thiang lo ve ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka ta bîk in ni a, kei Lalpa hi ka thianghlim a, nangni pawh in thianghlim tûr a ni, ka pual bîk atân hnam dang zîng ata ka thlang chhuak che u a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Mipa pawh, hmeichhia pawh, ramhuai zâwl leh mitthi thlûk chîng chu lunga den hlum tûr an ni, an thisen mawh chu anmahniin an phur ang,” a ti a.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah, “Arona fa, puithiamte chu hrilh rawh, an zînga mite chu tu mah an chipuite ruang khawihin an intibawlhhlawh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mahni nu emaw, pa emaw, fapa emaw, fanu emaw, unau emaw,
  </para>
  <para style="p">
    <verse number="3" style="v" />farnu emaw pasal nei lo; in khata awmpui ruang erawh chu an khawih thei ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nupuia chhûngte ruang pawh khawihin an intibawlhhlawh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Puithiam tu mahin lusûn entîr nân an lu pangkhing an ziat kawlh tûr a ni lo, an hmuihmul an mêt tûr a ni lo va, an inzai kak tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />An thianghlim tûr a ni, ka hming an tihliau tûr a ni lo; hâlral thilhlan hâltu an ni a, ka hnêna ei tûr hlântu an ni bawk a, an invawng thianghlim tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puithiam chu an thianghlim a, nawhchizuar hnu te, mâk hnu te, tlangvâl ngai tawh te nupuiah an nei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />In Pathian hnêna ei tûr hlântu, ka mite zîng ata ka tihhran an ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Puithiam fanu nawhchizuar chuan a pa a timualpho va, hâl hlum tûr a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Puithiam lalber chu hriakthih a ni a, puithiam thawmhnaw inbel tûra serh hran a ni; chuvângin, lusûn entîr nân khuih lovin a sam a thlah tûr a ni lo va, a puan a pawtthlêr tûr a ni hek lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mitthi ruang awmnaah a kal tûr a ni lo; a nu leh a pa ngei ruang pawh khawihin a intibawlhhlawh tûr a ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chutianga ti tûrin ka hmun thianghlim chhuahsanin a intibawlhhlawh tûr a ni lo, ka tâna serh hran tawh, hriak thih a ni, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nula thianghlim chauh nupuiah a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pasal sûn te, mâk hnu te, tlangvâl ngai tawh te, nawhchizuarte nupuiah a nei tûr a ni lo, ama chipui zînga mi nula thianghlim a nei tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutilo chu, a fate an bawlhhlawh ang e; anni pawh an thianghlim tûr a ni. Lalpa ka nih hi, kei hian ka puithiam lalber chu ka serh hrang tawh a ni.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa chuan Mosia a hrilh a;
  </para>
  <para style="p">
    <verse number="17" style="v" />“Arona hrilh rawh; in thlah zînga mi piangsual tu mahin ei tûr thilhlan hi eng lai mahin an rawn hlân tûr a ni lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Piansualna nei chuan thilhlan a rawn hlân tûr a ni lo; mitdel te, kebai te, hmêl tihchhiat te, ruhrel danglam bîk pu te,
  </para>
  <para style="p">
    <verse number="19" style="v" />kut bûl te, ke bûl te,
  </para>
  <para style="p">
    <verse number="20" style="v" />êlkûn te, tawngchham te, mit terh te, uithak vei phuhlip neite leh tilmu keh te chuan thilhlan an hlân tûr a ni lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Puithiam Arona thlah, taksaa piansualna nei chuan hâlral thilhlan hâl tûrin emaw, ei tûr thilhlan hâl tûrin emaw a lo kal tûr a ni lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />Chutiang mi chuan Pathian tâna thilhlan thianghlim leh puithiam chanvo thil thianghlim chu a ei ve thei chauh vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Piansualna a neih avângin Hmun Thianghlim Ber puanzâr bulah a lo kal tûr a ni lo; maichâm a rawn hnaih tûr a ni hek lo. Hêng thil thianghlim hi a tibawrhbâng tûr a ni lo, Lalpa ka nih hi, ka tihthianghlim tawh a ni si a.” a ti a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hêng thu hi Mosia chuan Arona leh a fate chu a hrilh a, Israel mite pawh a hrilh a.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Arona leh a fate chu hrilh rawh; Israel miten ka hmaa thil serh an rawn hlante chu urhsûn takin lo dawng sela, ka hming timualpho suh se, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel miten ka tâna thil thianghlim an rawn hlan chu in thlah zêlte tu pawhin an bawlhhlawh laia an khawih chuan puithiama bân tûr an ni; Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Arona thlah, vuna phâr natna vei emaw, a zahmawh aṭanga thil pût nei emaw chuan a bawlhhlawhna a reh hma chu thilhlan thianghlim hi a khawih tûr a ni lo. Puithiamin mitthi ruang khawihtu a khawihin emaw, ama chi a tlâkin emaw a bawlhhlawh ve ta a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawkvâka kal ran bawlhhlawh emaw, mi bawlhhlawh emaw a khawih pawhin a bawlhhlawh a ni; a inbual hma chu thilhlan thianghlim a ei ve thei lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puithiam chutianga bawlhhlawh tawh phawt chu tlai thlengin a bawlhhlawh a, a inbual hma chu thilhlan serh thianghlimte chu a ei ve thei lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ni a tlâk hnu chuan a thianghlim ang a, thilhlan thianghlim chu a ei ve thei tawh ang, a chanpual tûra tih a ni si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ran thisâwn emaw, sa seh emaw a ei tûr a ni lo, a bawlhhlawh phah dâwn a ni, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Thil tih dân tûr ka sawite hi an zâwm vek tûr a ni, an zawm duh loh chuan a mawh an phur ang a, an thi ang; anmahni tihrangtu Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Puithiam chhûngte chauhvin thilhlan thianghlim hi an ei thei ang; puithiam awmpui emaw, a mi rawih emaw, mi dang tu mahin an ei ve tûr a ni lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Puithiam bawih, ama pawisa ngeia a lei emaw, a in chhûnga piang ngei emaw te chuan an ei ve thei ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Puithiam fanu pawh ni se, puithiam ni lo pasala a neih chuan thilhlan thianghlim hi a ei ve thei lo vang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pasal sûn emaw, mâk emaw, fa nei lova a pa ina tlulût leh emaw chuan a ei ve thei ang; puithiam thlah chauhvin ei thian a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Puithiam thlah ni lovin puithiam chanvo thil thianghlim chu lo ei palh sela, a rûl vek tûr a ni, hmun ngaa ṭhena hmun khat a pêk belh tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Puithiamte chuan thilhlan thianghlim hi an tibawrhbâng tûr a ni lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ei ve thiang loho an eitîr tûr a ni lo; an eitîr chuan thiam loh an chang ang a, an tuar ang. Hêng thilhlan tithianghlimtu Lalpa chu ka ni,” a ti a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Arona te, a fa te leh Israel mi te chu hrilh rawh: Israel mi pawhin, an zînga chêng hnam dang pawhin, thutiam hlen thilhlan emaw, mahni duh thu-a thilhlan emaw Lalpa hnêna hâl ral tûr an rawn hlan dâwn chuan,
  </para>
  <para style="p">
    <verse number="19" style="v" />a lo pawm theih tûr chu bâwngpa emaw, berâm emaw, kêl emaw, a pa hmêlhem lo a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hmêlhemna nei chu hlân mah se Lalpa chuan a pawm lo vang.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Miin thutiam hlen nâna thilhlan emaw, mahni duh thu-a thilhlan emaw remna thilhlan atân Lalpa hnêna an rawn hlan chuan an ran hlan chu hmêlhem lo a ni tûr a ni; tichuan, a lo pawm thei ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ran mitdel te, a kebai te, a silawng te, pânhnaila nei te, a tangseh te, a phâr te Lalpa hnênah hlân suh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mahni duh thu-a thilhlanah chuan bâwng emaw, berâm emaw, fere deuh pawh hlan theih a ni; thutiam hlen nâna thilhlanah erawh chuan pawm a ni lo vang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ran til lâk te, sawhkeh te, tihthlêr palh te, hleh te emaw chu Lalpa hnênah hlan tûr a ni lo. In ram chhûngah hei hi tih khap a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hnam dang ran chu ei tûr thilhlanah hlan loh tûr a ni; chutiang hlan chu hmêlhemna neia chhiar tûr a ni, pawm theih a ni lo vang.”
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Berâm emaw, bâwng emaw, kêl emaw, a pa chu a pui bulah ni sarih a awm ang a, a ni riat ni aṭang chuan hâl ral atân hman theih a ni tawh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Bâwng pui leh a notê, berâm pui leh a notê, kêl pui leh a notê; ni thuhmunah thilhlana hlan tûr a ni lo.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lâwmthu sawina thilhlan i hlanin dân ang takin engkim ti rawh, pawm theih a ni ang,
  </para>
  <para style="p">
    <verse number="30" style="v" />ei zo vek ula, a tûk atân ei bâng suh u.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Ka thupêkte hi zâwm ula, ti rawh u, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka hming hi in tibawrhbâng tûr a ni lo, Israel mite chuan ka thianghlim tih an hre tûr a ni; Lalpa , a tihrangtu che u ka ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />In Pathian ni tûrin Aigupta ram aṭangin ka hruai chhuak che u a ni, Lalpa chu ka ni,” a ti a.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh: Lalpa chawimawina kût atâna hun ruatah awmni khamin in hmang ho ṭhîn tûr a ni. Chûng chu hêngte hi a ni:
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni ruk chhûng hna in thawk ang a, a ni sarih ni chu sabat a ni a, chawlh dêr tûr a ni. Hna thawk lovin Pathian chibai bûkin in inkhâwm tûr a ni. Sabat ni hi Lalpa pual a ni, in awmna apiangah in serh tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa tâna kût ruatte chu hêng hi a ni, a hun ruatah in hmang ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Thla hmasa ber ni sâwm leh pali ni tlai lam hi Lalpa Kalhlên kût a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chumi thla vêk ni sâwm leh panga ni chu chhang dawidim telh loh kût inṭan ni a ni, ni sarih chhûng dawidim telh loh chhang in ei tûr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />A ni khat ni chuan inkhâwmpui in nei ang a, hna pangngai eng mah in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni sarih chhûng chu ni tin Lalpa hnênah ei tûr thilhlan in hlân tûr a ni. Ni sarih ni chuan inkhâwmpui in nei leh ang a, hna pângngai eng mah in thawk tûr a ni lo,” a ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Israel mite chu hrilh rawh: ka pêk tûr che u ram in thlen hun chuan puithiam hnênah in buh thar hmasa phal chu in rawn dah tûr a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ani chuan Lalpa hmaah a thên ang a, a lo pâwm dâwn che u nia. Sabat ni a nih chuan a tûkah puithiam chuan a thên ṭhîn tûr a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Buhphal thên ni chuan berâmno, a pa, hmêlhem lo, kum khat vêla upa, hâlral thilhlanah in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chumi rual chuan buhbâl thilhlanah chhangphut ṭha chi kg. hnih, oliv hriak pawlh in hlân tel tûr a ni; chu chu Lalpa lâwmzâwng tak chu a ni; uain litar khat pawh in tûr thilhlanah in hlân tel bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />In buh thar, puithiamho hnêna in rawn hlan hma chu in ei tûr a ni lo. In thlahte pawhin he dân hi an zâwm kumkhua tûr a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Buhphal, Lalpa hmaa in thên ni, sabat zawh aṭanga chhiar ṭanin hapta sarih a ral ang a,
  </para>
  <para style="p">
    <verse number="16" style="v" />sabat vawi sarih zawh tûk, ni sawmnga ni chuan buhbâl thilhlanah in thlai thar chu in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chhûng tinin mahni hmun ṭheuhvah dawidim telh chhang in ur tûr a ni. Lalpa hmaa thên tûr tlang hnih in rawn keng tûr a ni, chhang tlang khat chu kg. hniha rit, chhangphut thar ṭha chi-a in siam hmasak ber a ni tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chumi rual chuan kum khat vêla upa berâmno pasarih, bâwngpa pakhat, berâmchal pahnih, hmêlhem lo vek, vântlângin Lalpa tân an thawh ang a, an buhbâl thilhlan nên, in tûr thilhlan nên, hâlral thilhlanah an hlân tûr a ni; chu chu Lalpa lâwmzâwng tak chu a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sual thawina thilhlanah kêl pakhat in hlân ang a, remna thilhlanah berâmno pahnih, kum khat vêla upa ve ve, in hlân bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Puithiamin chhang leh berâmno pahnih chu Lalpa hmaah a thên ang a, puithiam chan tûr chu serh hran a ni ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Chumi ni chuan tu man in hna pangngai in thawk tûr a ni lo, Pathian chibai bûk tûrin in inkhâwm tûr a ni. He dân hi in thlahte pawhin an awmna apiangah an zâwm kumkhua tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Buh in sengin vau fêma mi hlep zo vek suh u, lâk hmaih in neih pawh vai leh suh u. Mi retheite leh hnam dangte tân dah rawh u, Lalpa in Pathian chu ka ni.”
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Israel mite chu hrilh rawh; thla sarihna, ni khat ni chuan awmni kham ula, tawtawrâwt hâm ula, inkhâwmpui nei ang che u.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lalpa hnênah buhbâl thilhlan in hlân tûr a ni, in hna pangngai tu man in thawk tûr a ni lo.”
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Thla sarihna, ni sâwm ni hi kum tina hnam pum sual thawina ni ropui a ni a, chaw ngheiin in inkhâwm tûr a ni. Lalpa hnênah hâlral thilhlan in hlân tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hemi ni hian hna thawh loh tûr a ni, in sual thawina hlan ni a ni si a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hemi nia thil eng emaw lo ei chu a chipuite zîng ata hnawh chhuah tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hemi nia hna thawk chu Lalpa ngei chuan a tihlum ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />He dân hi in awmna apiangah in thlahte pawhin an zâwm kumkhua tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ni kaw tlai, ni tlâk aṭanga ni sâwm tlai ni tlâk thlengin chawlh ni-ah in hmang tûr a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Thla sarihna, ni sâwm leh panga ni aṭangin ni sarih chhûng Bâwkte kût in hmang tûr a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />A ni hmasa ber ni chuan khâwmpui urhsûn in nei ang a, in hna pângngai in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni sarih chhûng chu ni tin buhbâl thilhlan in hlân ṭhîn ang a, a ni sarih ni chuan khâwmpui in nei leh ang a, buhbâl thilhlan pawh in hlân tûr a ni, Pathian chibai bûk ni a ni, hna in thawk tûr a ni lo.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hêngte hi Lalpa chawimawi nâna kût in hman tûrte chu a ni, khâwmpui in nei ang a, ei tûr thilhlan te, hâlral thilhlan te, buhbâl thilhlan te leh inthawina chi dang leh in tûr thilhlan te, a hunbi tak a in hlan tûr chu a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hêng kût hi sabat serh bâka serh tûr a ni; tin, hêng thilhlante hi Lalpa hmaa in thil hlan ṭhin thutiam hlen thilhlan te, mahni duh thu-a thilhlan te bâka tih tûr a ni.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Buh in seng zawhah, thla sarihna ni sâwm leh panga ni aṭangin kût hi ni sarih chhûng in hmang tûr a ni. A ni hmasa ber chu chawlh dêrna ni a ni ang.
  </para>
  <para style="p">
    <verse number="40" style="v" />Chumi ni chuan in thlairah ṭha ber te han la ula, tûmkau te leh thingbuk ṭha chhâwl te sât ula, Lalpa hmaah hlim takin awm ang che u.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chutiang chuan ni sarih chhûng ti ang che u. He dân hi in thlahte pawhin kumkhuain an zâwm tûr a ni.
  </para>
  <para style="p">
    <verse number="42" style="v" />Israel mi zawng zawng chu hemi ni sarih chhûng hian chhâwlbûkah an awm tûr a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Israel mite Aigupta ram aṭanga Lalpa chuan a hruai chhuah khân bâwkte chhe tê tê-ah a awmtîr ṭhîn tih in fate pawhin an hre dâwn nia, Lalpa , in Pathian ka nih hi.”
  </para>
  <para style="p">
    <verse number="44" style="v" />Chutiang tak chuan Mosian Israel mite chu Lalpa chawimawina kût hmang tûrin dân a siamsak a ni.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chuan oliv hriak thlitfîm khâwnvâr tui atân rawn dah sela, a hun takah chhit ziah tûr a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Inbiakna bûk chhûnga Hmun Thianghlim Ber, thuthlung dahna, puanzâr pindan pâwnah tlai tin Arona chuan a chhî ang a, a tûk khawvâr thlengin a chhi reng tûr a ni. He thil hi tih kumkhua tûr a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rangkachak hlîr hlaka siam khâwnvâr dahna-a khâwnvârte chu Arona chuan a chei ang a, Lalpa hmaah chuan a hun takah a chhi ziah tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Chhangphut ṭha chiin chhang tlang sâwm leh pahnih, kg. khat zêla rit siam ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rangkachak hlîr hlaka luan dawhkânah chuan tlar hnih, paruk zêlin dah ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Beraw hlîr hlak, eng emaw zât chhang dah tlarah chuan dah ve ve ang che, chu chuan chhang chu Lalpa hnêna ei tûr thilhlan a nih a entîr ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sabat ni apiangin Lalpa hmaah chhang thar dah ziah tûr a ni. Hei hi Israel-te tân kumkhua-a tihmâkmawh a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chhang chu Arona leh a thlahte ei tûr, an chanpual a ni, hmun thianghlimah chuan an ei ṭhîn tûr a ni, Lalpa hnêna thilhlan, puithiamte tâna serh hran tlat chu a ni.”
  </para>
  <para style="p">
    <verse number="10" style="v" />Aigupta mi laka Israel nu pakhat fapa leh Israel mi an insual a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chu hmeichhia chu Selomiti fanu a ni, Dan hnam Dibria tunu a ni. Israel nu fapa chuan Lalpa hming a sawichhia a, ânchhia a lawh bawk a. Mosia hnênah an rawn hruai a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Engtia tih tûr nge tih Lalpa an râwn a, a rawn chhân hma chu an vêng tlat a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Kha mi kha daipâwnah hruai la, Pathian ânchhia a lawh lai hretute khân a lu chungah an kut nghat sela, mipuiin lungin dêng hlum rawh se.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel mite chu hrilh rawh: Pathian ânchhelawhtu chuan a tuar ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian pawi sawi chu tihhlum tûr a ni; Israel pungkhâwmho zawng zawng chuan lungin an dêng hlum tûr a ni; Israel mi pawh, an zînga hnam dang chêng ve pawh, Pathian pawi sawi chu tihhlum tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Tual that chu tihhlum ve tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi dang ran talhsaktu chuan a rûl tûr a ni, nun aiah nun.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi dang tihmêlhemtu chu a tih ang chiahin a chungah tih ve tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ruh pakhat a tihtliah chuan a ruh pakhat tihtliah ve tûr a ni: Mit aiah mit, hâ aiah hâ, tihhmêlhem aiah tihhmêlhem ve,
  </para>
  <para style="p">
    <verse number="21" style="v" />ran talh rutu chuan a rûl ang a, mihring thattu chu thah ve tûr a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />He dân hi Israel mi zawng zawng tân a ni: in zînga chêng hnam dangte pawh a huam ang, Lalpa , in Pathian ka nih hi,” a ti a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hêng thu hi mite a hrilh hnu chuan Pathian ânchhelawhtu kha riahhmun ata an hruai chhuak a, an dêng hlum ta a. Mosia hnêna Lalpa thupêk ang chuan Israel mite chuan an ti ta a.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sinai tlângah Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh: ka pêk tûr che u ram in thlen hun chuan Lalpa chawimawi nân a kum sarihna zêlah ram chu chawlhtîr ang che u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kum ruk chhûng thlai in chîng ang a, in grep te in sât ang a, a rah in seng ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kum sarih kum erawh chuan Lalpa chawimawi nân chawlhtîr tûr a ni, in lovah te thlai chîng suh u, in grep sât no hek suh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />In buh hli pawh hlep suh u. In grep sah no loh rahte pawh lo suh ang che u, ram tân chawlh dêr kum a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ram chu chawlhtîr mah ula in bawih tân te, hlawhfa in chhawr tân te, hnam dang in awmpui tân te leh in tân te ei tûr chu a awm tho vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />In ran vulh te, in rama ramsate tân pawh ei tûr a awm tho vang.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Kum sarih vawi sarih, kum sawmli leh pakaw ral hnu kum,
  </para>
  <para style="p">
    <verse number="9" style="v" />thla sarihna ni sâwm ni, sual thawina ni ropuiah chuan mi tîr ula, ram pum puiah tawtawrâwt hâm rawh se.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kum sawmngana chu in lâwm ang a, ram chhûnga awm zawng zawng tân zalênna thu in puang tûr a ni: in tân Jubili kum a ni ang. In leh lo hralh tawh zawng zawng chu a neitu bul hnênah emaw, a thlahte hnênah emaw pêk kîr leh tûr a ni, bawiha hralh pawh an chhuak vek tûr a ni, mahni in leh lovah an kîr leh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chumi kum chuan eng mah in chîng tûr a ni lo, a hli in seng tûr a ni lo va, in grep sah no loh rah pawh in lo tûr a ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kum tluanin chu kum chu in tân kum serh a ni ang a, in lova hâwng kha in ei tûr a ni lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />He Jubili kum hian mahni ram ṭheuh in nei kîr leh tûr a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chuvângin, ram in hralhin emaw, in leiin emaw, i chipui Israel mi chu âwm lo takin i ti tûr a ni lo.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jubili kum a thlen hmaa rama thlai haw thei zât tûr hisâpin a ram man chu chhût tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kum a la tam chuan a man a sâng ang a, kum tlêm tê chauh la awm a nih leh a man a tlêm tûr a ni; ram kha hralh tak tak a ni lo va, thlai thar thei chauh kha hralh tûr a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />In Israel-puite bum suh u, Pathian ṭih rawh u, Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“ Lalpa dân hi zâwm ula, a thupêkte hi awih ula, ramah chuan mangang lovin in awm dâwn nia.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ramah thlai a haw ṭha ang a, in duh tâwk tâwk ei tûr in nei ang a, thlamuang takin in awm thei ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />‘A kum sarih kum chuan eng mah kan chin lohva, kan seng bawk si loh chuan eng nge kan ei tâk ang?’ in ti a ni thei a.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kum ruknaah ram chu mal ka sâwm ang a, kum hnih ei tûr a haw ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kum riatna a in thlai chîn rah in seng hma chu kum rukna a haw kha in tla tâwk tûr a awm dâwn a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />In ram chu in hralh hlen thei lo, ram chu ka ta a ni; nangni hi mikhual mai in ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ram chu in hralh a nih pawhin a neitu bul khân a lei kîr leh thei ngei tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel mi chu a lo retheih hle a, a ram hralh hial a ṭûl a nih pawhin a laichîn hnaiin a tlan tûr a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tlansaktu laichîn hnai nei lo chu, amah a lo hmuingîl leh thei a, amah ngeiin a lei kîr leh thei tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutiang thilah chuan Jubili kum thlen hmaa thlai thar thei zât man hisâpin lei kîr theih tûr a ni, Jubili kum chuan a nei kîr leh tho dâwn si a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ram lei kîrna tûr pawisa a neih zawh loh chuan a leitu khân Jubili kum thlengin a nei ang a, Jubili kum chuan a neitu bul chu a pe kîr leh tûr a ni.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Kulh nei khawpuia in neiin a in chu a hralh chuan a hralh aṭanga kum khat chhûng chuan a tlan leh thei ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kum khat chhûnga a lei kîr leh theih loh chuan lei kîr leh theih a ni tawh lo ang a, leitu khân a thlahte thlengin a in chu a nei thei tawh ang; Jubili kumah pawh pêk kîr tûr a ni lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Khua kulh nei lo, thingtlâng khuaa in chu ram inlei anga ngaih tûr a ni, a neitu bul chuan a lei kîr leh thei ang a, Jubili kumah pêk kîr leh tho tûr a ni.
  </para>
  <para style="p">
    <verse number="32" style="v" />Levia chite erawh chuan an awmna tûr ruat khuaa an thil neih chu eng lai pawhin an lei kîr leh thei ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hêng khuaa awm Levia chiten in an hralh chu lei kîr leh thei lo mah se, Jubili kum chuan pêk kîr leh tûr a ni; Levia chiten an awmna tûr ruat khuaa an in neih chu Israel-te zînga an kumkhaw thil neih ngheh ve chu a nih avângin.
  </para>
  <para style="p">
    <verse number="34" style="v" />Levia chite khaw bula ran tlatna hmun chu eng lai mahin hralh tûr a ni lo: thil neih ngheh an neih ve chhun a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />“In unau Israel, i bula awm chu, a lo retheih viauva, mahni pawh a inchâwm theih loh chuan inhlawhfa angin emaw, mikhual angin emaw i enkawl tûr a ni; tichuan, i bulah a awm ve reng thei dâwn nia.
  </para>
  <para style="p">
    <verse number="36" style="v" />A hnên aṭangin a pung ûm suh, Pathian ṭih la, i unaupa chu amahin a khawsa ve thei dâwn nia.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pawisa i pûktîr pawhin a pung neihtîr suh la, i buh a leiin eng mah hlêp suh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kanan ram hi ka pe che u a, in Pathian ni tûrin Aigupta ram aṭanga hruai chhuaktu che u Lalpa in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />I chipui Israel chu a lo retheih êm avângin i bawihah rawn inhralh mah se, bawih angin i chhawr tûr a ni lo.
  </para>
  <para style="p">
    <verse number="40" style="v" />Inhlawhfa leh mikhual angin i enkawl ang a, Jubili kumah i chhuah leh tûr a ni.
  </para>
  <para style="p">
    <verse number="41" style="v" />Chumi hnuah chuan a fate nên an chhuahsan ang chia, an chhûngte hnênah an awm leh tawh ang a, an in leh lo chu an luah leh ang.
  </para>
  <para style="p">
    <verse number="42" style="v" />Israel mite hi ka bawih an ni, Aigupta ram aṭangin ka lei chhuak a, bawihah hralh tûr an ni lo.
  </para>
  <para style="p">
    <verse number="43" style="v" />Dim lo baksakin an chungah in che tûr a ni lo, Pathian chu ṭih rawh u.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mipa emaw, hmeichhia emaw bawih in mamawh chuan in vêla hnam zînga mi lei ang che u.
  </para>
  <para style="p">
    <verse number="45" style="v" />In zînga awm hnam dang fate chu in lei thei ang; chutiang mi fa, in ina piangte chu in ta an ni zêl ang.
  </para>
  <para style="p">
    <verse number="46" style="v" />In faten an rochung thei ang, an nei ang a, an dam chhûng chu an bawih an ni ang. Amaherawhchu, in chipui Israel chu in tinawmnah tûr a ni lo.
  </para>
  <para style="p">
    <verse number="47" style="v" />“In zînga chêng hnam dang chu lo hausa ta hle sela, in chipui Israel mi ve thung chu a rethei hle a; chu hnam dang mi hnênah emaw, ama chipui hnênah emaw bawihah a inhralh a;
  </para>
  <para style="p">
    <verse number="48" style="v" />inhralh tawh pawh ni se, lei kîr leh theih a ni, ama unau zînga pakhatin emaw,
  </para>
  <para style="p">
    <verse number="49" style="v" />a pamiin emaw, a pami fapain emaw, a laichîn hnai mi dangin emaw a lei kîr thei ang.
  </para>
  <para style="p">
    <verse number="50" style="v" />Amah leitu nên an inbia ang a, a inhralh kum aṭanga Jubili kum thlengin inhlawhfa pangngaiin eng zât nge a hlawh hman ang tih hisâpin a intlanna tûr man chu tuk a ni ang.
  </para>
  <para style="p">
    <verse number="51" style="v" />A rei emaw, rei lo emaw, Jubili thlen thlenga a hlawh theih zât tûr chu a leitu hnên aṭanga intlan chhuahna man zât tûr chu a ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />Inhlawhfa, kum khat atâna rawih ang zêlin an inchhawr tûr a ni. A pu chuan a tinawmnah tûr a ni lo.
  </para>
  <para style="p">
    <verse number="54" style="v" />Engti kawng maha lei chhuah a nih loh pawhin Jubili kum chuan chhuah ngei tûr a ni, a fate nên.
  </para>
  <para style="p">
    <verse number="55" style="v" />Israel mi rêng rêng, tu ma bawihah an tâng kumkhua tûr a ni lo; Israel mite chu Lalpa bawih, Aigupta ram aṭanga a lei chhuahte an ni si a; Lalpa , an Pathian chu ka ni.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Eng mah ni hlei lo, milem chher te, lung milem te, chibai bûk atân in insiam chawp tûr a ni lo, Lalpa , in Pathian ka nih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chawlh tûr ka tih nite serh ula, chibai mi bûkna hmun chu zah rawh u, Lalpa ka nih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka dânte hi in zawma, ka thupêkte in awih chuan
  </para>
  <para style="p">
    <verse number="4" style="v" />a hun takah ruah ka sûrtîr ang a, in lo a hlâwk ang a, in theite pawh a rah duh êm êm ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Grep rah lawh hun thlengin buh seng a ṭûl ang a, buh tuh hun thlengin in grep rah lawh a ṭûl bawk ang. Duh tâwk tâwka ei tûr in nei ang a, in ramah chuan thlamuang takin in chêng ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />In ramah remna ka lêntîr ang a, hlauh nei lovin in mu siai siai ang a, ram sakawlhte in ram ata ka tirêm ang a, hmêlmain an rawn rûn hek lo vang che u.
  </para>
  <para style="p">
    <verse number="7" style="v" />In hmêlmate chu in ûm ang a, khandaihin in that ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi pangain mi za in hneh ang a, mi za chuan mi sîng in hneh thei ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mal ka sâwm ang che u a, fanaute ka pe ṭeuh ang che u; ka thuthlung angin keiin ka tih tûr ka tihsak zêl ang che u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Buh hlui in ei sên loh chu a thar dah nân paih a ngai ang a.
  </para>
  <para style="p">
    <verse number="11" style="v" />In zîngah ka chêng a, ka thlahthlam tawh lo vang che u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka awmpui ang che u a, in Pathian ka ni ang a, ka mite in ni ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei Lalpa , in Pathian hian, bawih ni tawh lo tûrin Aigupta ram ata ka hruai chhuak che u a, in nghâwngkawlte chu ka tihtliahsak che u a, thawveng takin in lêng thei ta a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Ka thu in ngaihthlâk duh lohva, ka thupêkte in awih duh lohva,
  </para>
  <para style="p">
    <verse number="15" style="v" />ka dânte in hnâwla, awm dân tûr ka tih hmusita tih tûr ka tihte in tih duh lohva ka thuthlung in bawhchhiat chuan,
  </para>
  <para style="p">
    <verse number="16" style="v" />in chungah chhiatna ka rawn thlen ang, ngawr leh khawsikpuiin in na ang a, in mitte pawh a tichhia ang a, in dam khawchhuak thei lo vang. Thlai chite pawh chîng mah ula in chîng thlâwn mai mai a ni ang; in hmêlmate ei tûr lek a ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka hawisan ang che u a, nangmahni hawtute chu in chunga rorêltute an ni ang a, ûm loh pawhin in tlânchhe dâwr dâwr ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chutiang pawha ka thu in la ngaihthlâk duh loh fo chuan, a lêt sarihin ka hrem ang che u.
  </para>
  <para style="p">
    <verse number="19" style="v" />In chhuan êm êm, in chakna chu, ka tihchhiatsak ang che u; in tân vân chu thîr anga ruah pai lovin ka siam ang a, in lote pawh dâr angin a châr ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />In thawk hah thlâwn dâwn a ni, in lovah seng tûr a awm lo vang, in thei kûngte lah a rah hek lo vang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi do zâwnga in awma, ka thu in la pawisak duh loh fo chuan in sual phû tâwk lêt sarihin ka hrem ang che u.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ramsa nghal tak tak ka rawn tîr ang a, in fate leh in rante an rawn seh ang, kawngṭum zawh bel tham pawh in awm lo vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Hêng hremna in tawh hnu pawha ka lam hawi lova min la do fo chuan,
  </para>
  <para style="p">
    <verse number="24" style="v" />in chungah ka ṭuan ang a, a leh sariha nain ka hrem leh ang che u.
  </para>
  <para style="p">
    <verse number="25" style="v" />In zîngah hmêlma ka rawn tîr ang a, thuthlung in bawhchhiatna phuba an rawn la ang. In khawpui kulh chhûngahte in bîk pawhin hri ka lentîr ang a, hmêlmate chuan an rawn la tho vang.
  </para>
  <para style="p">
    <verse number="26" style="v" />In ei tûr lâkna ka tiping ang a, thuk sâwm hmanga eirawng bâwl ṭhîn nuho khân thuk khat chauh hmangin eirawng an bâwl tawh ang. An sem ker ker ang a, an chan ai an ei zawh hnuah pawh an ril a la ṭâm tho vang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chutichung pawha ka thu in ngaihthlâk duh lohva, min la do luih zêl chuan,
  </para>
  <para style="p">
    <verse number="28" style="v" />thinurin in chungah ka ṭuan ang a, a lêt sariha nâin ka hrem ang che u.
  </para>
  <para style="p">
    <verse number="29" style="v" />In fapate leh in fanute sa in ei hial ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />In pathian biakna hmunsângte chu ka tichhia ang a, in rimtui hâlna maichâmte chu ka ṭhiat ang a, in milemte chu ka titlu ang a, an chungah in ruang chu ten takin ka paih ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />In khawpuite chu ka tiram ang a, in pathian biakna te chu ka tichhia ang a, in inthawinate chu ka lo pawmsak lo vang che u.
  </para>
  <para style="p">
    <verse number="32" style="v" />In ram chu ka tichereu vek ang a, a luahtu in hmêlmate chuan mak an ti êm êm ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Indona a lo thleng ang a, hnam dang ramah an hruai darh ang che u, in khawpuite chu a chim rem rum ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />In hmêlmate rama in awm chhûngin in ram chu a châwl dêr dâwn a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />In awm chhûngin in ram chu in chawlhtîr duh lo va, in awm loh chhûng chu a châwl dâwn ta a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />In hmêlmate rama la awmte chu an ṭi êm êm ang a, hnahthel lêng maiah pawh an tlânchhia ang a, khandaiha ûm ang hialin tu ma ûm loh pawhin an tlu ang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Khandaiha ûm ang maiin an inpaltlu rem rum ang a, hmêlma lo do lêt tûr tu mah in awm lo vang.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mi ramah in thi ang a, chûngah chuan an phûm ang che u.
  </para>
  <para style="p">
    <verse number="39" style="v" />In hmêlmate rama la dam chhunte chu in sualna avâng leh in pate sualna avângin an zuih ral ang.
  </para>
  <para style="p">
    <verse number="40" style="v" />“Chûng mite chuan an pate nên mi do va, mi hawisanin thil an tisual a ni tih an inhre chhuak ang a,
  </para>
  <para style="p">
    <verse number="41" style="v" />anmahni avângin ka hawisan a, an hmêlmate ramah ka hnawt chhuak a ni tih an hria ang a; tichuan, an inphahhniam ang a, an suahsual man an tlâk hnu chuan,
  </para>
  <para style="p">
    <verse number="42" style="v" />Jakoba te, Isaka te leh Abrahama te hnêna ka thutiam kha ka hre reng ang a, ka mite chu he ram hi ka pêk tûr thu ka hrilh thar leh ang.
  </para>
  <para style="p">
    <verse number="43" style="v" />Amaherawhchu, ram chu a chawlh dêr theih nân ram ata mite chu lâk chhuah zet tûr a ni. Ka dânte leh ka thupêkte hnâwla an thil sual tih man chu an tuar zet tûr a ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Chuti tak chuan hrem mah ila an hmêlmate rama an awm chu ka hlamchhiah dêr lo vang a, ka tiral vek hek lo vang.
  </para>
  <para style="p">
    <verse number="45" style="v" />An thlahtute nêna ka thuthlung chu ka tithar leh ang. Aigupta ram aṭang khân hnam tin hmuhah ka mite chu, kei Lalpa hi an Pathian ka nih theihna tûra Aigupta ram ata hnam tin mit hmuha ka mite hruai chhuaktu ka nih hi. Kei hi Lalpa chu ka nih hi.”
  </para>
  <para style="p">
    <verse number="46" style="v" />Hêng hi Sinai tlânga Mosia hnêna Lalpa dân leh a thupêk, Israel mite tâna a pêk chu a ni.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chuan Mosia hnênah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel mite chu hrilh rawh: Miin Lalpa hnêna pêkah mihring pêk tiam sela, chu mihring tlanna man chu hetianga hisâp tûr a ni:
  </para>
  <para style="p">
    <verse number="3" style="v" />Mipa, kum sawmhnih chin, kum sawmruk thlengin, tangkarua sekel sawmnga bûk a ni ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hmeichhe puitling tawh chu tangkarua sekel sawmthum bûk a ni ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipa naupang, kum nga chin kum sawmhnih thlengin tangkarua sekel sawmhnih bûk a ni ang, hmeichhia a nih chuan tangkarua sekel sâwm bûk a ni ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nausên thla khat chin kum nga thlengin mipa chu tangkarua sekel nga bûk a ni ang a; hmeichhia chu tangkarua sekel thum bûk a ni ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kum sawmruk chung lam mipa chu tangkarua sekel sâwm leh panga bûk a ni ang a, hmeichhia chu tangkarua sekel sâwm bûk a ni ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />“A petu chu a retheih êm avângin a tlan chhuahna man tuk zât khi a pêk theih loh chuan pêk a tiam mihring kha puithiam hnênah a rawn hruai ang a, puithiam chuan bituk aia tlêm deuh, a pêk theih tâwk âwm, a lo tuk ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />“ Lalpa hnêna thilhlana hman tlâk miin ran pêk a lo tiam chuan Lalpa hnêna pêk chu serh hran tlat a ni tawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A petu chuan a pêk thlâkna tûr emaw, a aiah thil dang emaw a pe thei tawh lo vang; chutianga tih a tum chuan a pahnihin Lalpa ta tûr a ni ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ran, ei thiang lo, Lalpa hnêna thilhlan atâna hman tlâk loh pe a nih chuan puithiam hnênah a rawn kai ang a,
  </para>
  <para style="p">
    <verse number="12" style="v" />Puithiam chuan a man âwm zât bi a lo tuk ang a, chumi zât chu a manah chhiar tûr a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />A petu chuan tlan a duh chuan a man tuk zât leh chumi hmun ngaa ṭhena hmun khat belhin a tlan thei ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Miin ama in Lalpa hnêna pêk tiam sela, puithiamin a in chu a ṭhat leh ṭhat loh athuin a man a tuk ang a; a tuk zât chu in man atân chhiar a ni ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />A in chu tlan a duh chuan a man tuk zât chu a pe ang a, hmun ngaa ṭhena hmun khat a pêk belh bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Miin ama ram ṭhenkhat Lalpa tân pêk a tiam chuan thlai haw thei zât aṭangin a man chu tuk a ni ang; barli ṭin sawmli hâwnna chu tangkarua sekel sâwm bûk mana chhiar a ni ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jubili kum zawh chiaha pe a nih chuan a man puitling chhiar tûr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kum danga pêk a nih chuan puithiamin Jubili thlengin eng zât nge ramah haw thei tih a chhût ang a, chu ang chuan a man chhiar a ni ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />A neituin ram chu a tlan duh chuan a man chhiar zât chu a pe ang a, hmun ngaa ṭhena hmun khat a pêk belh bawk tûr a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />A lo chu amahin a tlan duh loh emaw, mi dang leitîr emaw a nih chuan tlan theih a ni tawh lo vang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jubili kumah chu ram chu Lalpa tân serh hran a ni ang a, pêk a nih avângin puithiam ta tûr a ni tawh ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />“A ram lei, a rochan ram ni lo a pêk chuan,
  </para>
  <para style="p">
    <verse number="23" style="v" />puithiamin Jubili thlengin a man a chhût ang a, chumi ni ngei chuan a zât chu a pe ang a, a pawisa chu Lalpa ta a ni.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jubili kum chuan a neitu bul hnênah emaw, a thlahte hnênah emaw pêk kîr leh tûr a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hêng thil man chhût hi Tempul bûklung hman lai anga chhût tûr a ni. Sekel khat chu Gera sawmhnih tluk a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Ran piang hmasa ber chu Lalpa ta a ni sa a, mahni duh thu-a thilhlanah emaw pêk tûr a ni lo: bâwngno pawh, kêlno pawh Lalpa ta sa a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ran ei thiang lo no hmasa ber erawh chu a man tuk zât leh hmun ngaa ṭhena hmun khat belhin tlan leh theih a ni; a petuin a tlan duh loh chuan mi dang hnênah a man bituk ang chuan hralh tûr a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />“ Lalpa tân liau liauva miin a neih ang ang, mihring emaw, ran emaw, a rochun ram emaw a serh hran tawh chu hralh theih a ni lo va, tlan theih a ni hek lo, Lalpa ta a ni kumkhua tawh ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Mihring pawh ni se, chutianga pêk tawh chu tlan chhuah theih a ni tawh lo, tihhlum mai tûr a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Ram chhûnga thil thar chhuah rêng rêng, buh pawh, thei pawh, sâwma pakhat chu Lalpa ta a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Miin chu chu a tlan duh chuan a man pangngai bâkah hmun ngaa ṭhena hmun khat pêk belhin a tlan thei ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ran vulh rêng rêng sâwma pakhat chu Lalpa ta a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ran neitu chuan a chhe deuh apiang a sâwmnaah a dah tûr a ni lo, a ṭha deuh chu a chhe deuhvin thlâk tûr a ni hek lo, thlâk a tum chuan Lalpa ta ve ve a ni ang a, tlan pawh a tlan thei lo vang,” a ti a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hêng thupêkte hi Sinai tlângah Mosia hnêna Israel-te tân Lalpa pêk a ni.
  </para>
</usx>
