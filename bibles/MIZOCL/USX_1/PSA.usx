<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PSA" style="id">Sam</book>
  <para style="h">Sam</para>
  <para style="toc1">Sam</para>
  <para style="toc2">Sam</para>
  <para style="mt">Sam</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi suaksual thurâwnna lam ngaithla duh lo va, Mi sualte tih dân pawh la duh lo va, Lalpa hmusittute zînga tel duh ngai lo mi chu a nihlawh e.
  </para>
  <para style="p">
    <verse number="2" style="v" />A lâwmzâwng chu Lalpa dân zawm a ni a, A dân thu chu a chhûn a zânin a ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ani chu lui kama thing phun, A hun taka rah ṭhîn, A hnah vuai ngai lo ang hi a ni a, A thiltih apiangah a hmuingîl zêl ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi suaksualte erawh chu chutiang an ni lo va, Thliin a len bo buhsi ang hi an ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuvângin, mi suaksualte chu rorêlnaah chuan an ding zo lo vang a, Mi dikte zîngah chuan mi sualte chu an tel thei hek lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chuan mi dikte chu a hum ṭhîn a. Mi suaksualte erawh chu an boral ang.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Engati nge hnamte chu an pun khâwm chiama, Miten thil sâwt lo chu a rûka an ngaihtuah ṭhin?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa leh a hriakthiha dovin Lei lalte chu an inhâwrkhâwma, Thuneitute pawh an inrâwn khâwm a?
  </para>
  <para style="p">
    <verse number="3" style="v" />“Min phuarna hrui hi i tichat ang u khai, An hruihrual kan bah hi i paih daih ang u,” tiin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vâna ṭhu-a chuan a nuihsan a, Lalpa chuan anni chu a nuihzatbûr a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chutichuan, thinurin an hnênah thu a sawi a, A thinrimna chuan a tihlau va.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Keimah ngeiin ka tlâng thianghlim Zion-ah chuan, Ka lal thlan chu ka ṭhuttîr ta a ni,” a ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa thupêk chu ka puang teh ang, “Ka Fapa i ni e, Vawiinah hian Fa-ah ka nei ta che.
  </para>
  <para style="p">
    <verse number="8" style="v" />I duh apiang dîl la, ka pe ang che, Hnamte pawh hi i rochan an ni ang a, Lei pum pui hi i ta tûr a ni bawk ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lei lalte chu thîrtiangin i vaw darh ang a, Hlumbêl angin i sawh keh sawm bawk ang,” a ti a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lei lalte u, fîmkhur rawh u, Rorêltute u, zilhna pawisa rawh u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ṭih chungin Lalpa rawng bâwl ula, Khûr chungin a hmaah kûn rawh u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Fapa hi lâwm ula, chutilo chuan a thinur ang a, A tiboral hlauh dah ang che u, Amaha himna zawngte chu an nihlawh e.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , ka hmêlmate an pung chakin, Min eptute chu an va tam ta êm!
  </para>
  <para style="p">
    <verse number="2" style="v" />“Pathianin a chhan hauh lo vang,” Min titu an va tam êm!
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , nang chu kumkhuain ka phaw i ni a, Ka lu hi i chawisâng ṭhîn a, Min tiropuitu chu i ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Awrâwl chhuaha Lalpa ka han auh chuan, A tlâng thianghlim aṭangin min lo chhâng ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka han mu a, ka muhîl a, Ka han harh leh a, Lalpa chuan min lo chelh reng ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Min hmusittute tam hle mah se, Ka hlau hlek lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Lalpa , tho la, aw ka Pathian, mi chhanhim teh, Ka hmêlmate biang hi bensak langin, Mi suaksualte hâ chu tihbalsak ngei ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Lalpa , i mite hi chhandamin malsâwm ang che.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka felna Pathian, Ka koh che chuan mi chhâng ang che. Mangan hunin mi tithawveng la, Mi khawngaih la, ka dîlna hi lo ngaithla ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw mihringte u, eng chen nge, Thil lawilo leh dâwt ngainaa, ka ropuina hi in hmuhsit dâwn?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian ngaihsak mi chu Lalpan a tân a thlang tih hria ula, Lalpa chuan ka au aw hi a lo hria a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thinrim mah ula, thil sual chu ti suh u, In khumlaizâwlah inngaihtuahin ngawi ṭhiap rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Inthawina dik tak chu hlânin Lalpa chu ring rawh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tam takin, “Tu nge thil ṭha min pe ta ang le? Lalpa , i hmêl êng chu kan chungah rawn êntîr ta che,” an ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />An buh leh bâl a hlâwk laia an hlim aia Nasa zâwkin min tilâwm a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thlamuang taka muin ka muhîl ang a, Nangmah ngei hi i ni, Lalpa , him taka min awmtîr ṭhîntu chu.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , ka thu hi lo ngaithla la, Ka rûm thâwm hi lo hria ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Lal leh ka Pathian, Ka mangang authâwm hi min ngaihthlâksak ang che. I hnêna ṭawngṭai ka ni si a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Lalpa , zîng takah ka aw i lo hria ang a, Min lo ngaithla ṭhîn ang che. Zîng aṭangin ka ṭawngṭai ṭhîn a, Nghâkhlel takin ka lo thlîr ṭhîn che.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sualnaa lâwm ṭhîn Pathian i ni lo va, I bulah chuan thil sual a leng hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Inchhuangte chu i hmaah an ding thei lo vang a, Thil sual titute chu i huatzâwng an ni si.
  </para>
  <para style="p">
    <verse number="6" style="v" />Dâwt sawi chîngte tiboral la, Tualthat leh bum chîngte chu, Lalpa tenzâwng tak an ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kei zawng i ngilneih êm vângin I inah hian ka lo lût a, Aw Lalpa , i tempul thianghlimah, Nangmah ṭih chungin ka lo kûn e.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Lalpa , min beitute avângin, I felnaah min hruai la, I kawngte chu ka tân titluang ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thutak rêng an sawi ngai lo va, An thinlung chu mi tihchhiat duhnain a khat a; An hrawk chu thlân inhawng a ni a, An kâin mi an fak der ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Pathian, anniho hi hrem la, An remruat chu chhiat phah rawh se; An bawhchhiatna tam tak avângin paih daih ang che, I lakah hian an hel ta si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nangmah bêltute erawh chu an hlim ang a, Lâwmin an au kumkhua dâwn si; Anmahni chu i hum ang a, I hming ngainatute chuan an chhuang ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Lalpa , mi dikte chu mal i sâwm ṭhîn a, Phaw ang maiin duhsakna chuan i hual vêl ṭhîn.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , thinrimin min zilh suh la, Thinurin min thunun hek suh ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa , min khawngaih teh, ka chauh êm hi, Ka ruh lamin a na zo ta, min tidam ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka mang a va ang êm! Lalpa , eng chen nge mi ngawihsan dâwn?
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa , lo hawi kîr la, min rawn chhan la, I ngilneih êm vângin min hum ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thi tawhte, tu mah hre reng che an awm lo va, Seol aṭang pawhin tu nge fak che?
  </para>
  <para style="p">
    <verse number="6" style="v" />Rûmin ka chau zo ta, Zan tin ka mittuiin ka mutna chu a far ṭhîn a, Ka khum a huh vek ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lungngaih vângin ka mit a thim zo va, Ka hmêlmate avângin ka chau zo ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thil sual ti zawng zawngte u, min kalsan rawh u. Lalpa chuan ka ṭap thâwm chu a lo hre ta si a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa chuan khawngaih ka dîlna chu a ngaithla a, Lalpan ka ṭawngṭaina chu a lo pawm ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka hmêlmate zawng zawng chu zak takin an chiai ang a, Mualpho takin an tlânchhe nghâl ang.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , ka Pathian, ka rawn bêl a che, Mi ûmtute lakah hian min lo chhan la, min humhim ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chutilo chuan, sakeibaknei angin min pawt thlêr ang a, Chhantu nei lovin, min pawt sawm dah ang e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Lalpa , ka Pathian, Hêng thil hi ka tiha, Ka kut hian thil sual a khawiha,
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka ṭhiante chu phatsana, Ka hmêlmate chhan awm lova ka tihchhiat bawk chuan,
  </para>
  <para style="p">
    <verse number="5" style="v" />Min dotuten min ûm sela, min man rawh se. Leiah min chîl thlu sela, Ka ruang pawh chu vaivutah zalh dêr rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa , thinurin lo thawk la, Ka hmêlmate thinrim sosâng hi han hmachhawn teh, Aw ka Pathian, harh la, min pui rawh, Dikna hi i duhzâwng a ni si a.
  </para>
  <para style="p">
    <verse number="7" style="v" />I vêlah hian mipui lo pung khâwm sela, Chung lam aṭangin ro han rêlsak ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Lalpa , mi tin rorêlsaktu i ni, Aw Chungnungber, mi dik leh mi ngîl ka nih ang zêlin ro mi rêlsak ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi suaksualte sualna chu han titâwp la, Mi ṭhate erawh chu tinghet ang che. Nang chu rilru leh thinlung fiahtu, Pathian dik i ni si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian Chungnungbera chu ka phaw a ni, Mi nun tluangte chhandamtu chu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian chu dik taka rorêltu a ni a, Mi sual chunga thinur reng ṭhîn Pathian a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />An sim loh chuan khandaih a tât hriam ang a, A thalngul chu kuaiin a tin bawk ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thihna hriamhrei lain, A thal alh thei a hmang ngei ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sual ngaihtuah chhuah an thiamzia hi en teh, A chimawm zâwnga awm an thiam hle a, Thil khawlo tak an tichhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khur an lai a, an zauh zêl a, An hum laihah ngei chuan an tla ta zâwk.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mahni chunga pawi khawih an ni a, an nunrâwnna ngei chuan a vaw lêt ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa chu a dik avângin lâwmthu ka hrilh ang a, Lalpa , Chungnungbera hming chu fakin ka zai bawk ang.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , kan Lalpa , Lei pum puiah hian i hming a va ṭha êm! I ropuina vân chung sânga awm chu, Naupangte leh nausênten an hril a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phuba latute leh nangmah dotu, I hmêlmate tihdaihna tûr chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />I kutchhuak vânte khi ka han thlîr a, Thla leh arsi i dahte khi,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihring hi eng nge maw a niha, i hriat renga, Mihring fapa pawh engtiziaa rawn kan ṭhîn nge i nih le?
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian aia hnuai deuh chauhvin i siam a, Ropuina leh chawimawina chu i khumtîr a.
  </para>
  <para style="p">
    <verse number="6" style="v" />I kutchhuak chungahte i laltîr a, An ke hnuaiah engkim i dah vek a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Berâm leh ran rual zawng zawng, Ramsate leh chunglêng savate,
  </para>
  <para style="p">
    <verse number="8" style="v" />Sangha tinrêng leh tuifinriat chhûnga chêngte nên.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Lalpa , kan Lalpa , Lei pum puiah hian i hming a va ṭha êm!
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , theihtâwpin ka fak ang chia; I thil mak tih zawng zawng ka hril vêl ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nangmah vângin hlimin ka lâwm ang a, Aw Chungnungber, i hming fakin ka zai bawk ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />I hmaah chuan ka hmêlmate an tlânchhia a, An tlu a, an boral zo ta e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rorêltu dik, lalṭhutthlênga ṭhu-a chuan, Ka chungthu chu dik takin i rêl si a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hnamte zilhin mi suaksualte chu i tiboral a, Kumkhua atân an hming thai bo vang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmêlmate chu tihchhiat dêr an ni a, An khuate chu a ram zo va, Tu man an hre tawh lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa erawh hi zawng chatuana lal a ni a, Rorêl tûrin a lalṭhutthlêng a hûng nghet ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Dik takin khawvêlah ro a rêl ṭhîn a, Mi tin chungah rual takin a rêl ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hnehchhiahte tân Lalpa chu himna kulh a ni a, Mangan huna inhumhimna kulhbîng a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />I hming ngainatute rinchhan i ni a, Lalpa , nangmah zawngtute chu I thlahthlam ngai si lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zion-a ṭhu Lalpa tân chuan fak hla sa ula, Mite hnênah a thiltihte chu puang rawh u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thisen phuba lâksaktu chuan a ngaihven a, a hre reng ṭhîn a, Tuartute au thâwm a ngaihthah ngai hek lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Lalpa , min khawngaih la, Min hawtute laka ka tuar tamzia hi en teh: Thihna kawngka ata hi mi la chhuak ang che.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zion fate kulh kawngkaahte chuan ka fak chhan che ka sawi theiha, Min chhandamna ka chawimawi theih nân.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnamte chu anmahni hum laihah chuan an tla a, An lên zâr rûkah chuan an kete chu a âwk ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dik taka rorêlin Lalpa chu a inhriattîr a, Mi suaksualte chu anmahni thiltihah ngei an âwk ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi suaksualte chu Seol-ah an chhuk ang a, Pathian ngaihthahtu hnamte nên.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mangangte chu thlahthlam an ni fo lo vang a, Retheite beisei pawh a bo hlen hek lo vang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Lalpa , lo tho teh, mihringin ngam che suh se, Hnamte chungah ro han rêl ang che.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpa , anniho hi han tithlabâr la, Hnam tin hi mihring mai an nihzia hriattîr ang che.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , engati nge hla taka i awma, Mangan nia i bihrûk daih ṭhin le?
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi suaksualte chuan chapo takin retheite an tiduhdah ṭhîn a, An thang kam rûkah chuan anmahni âwk rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi suaksual chuan a duhzâwng chu a uanpui a, Mi duhâm chuan Lalpa hnâwlin a hmusit a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi suaksual chu a rilru a chapo va, Pathian a zawng lo va, A rilruin, “Pathian rêng a awm lo,” a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />A thiltihte a hmuingîl zêl ṭhîn a, Pathian thil rêl dân a hre phâk lo va, A hmêlmate a nuihsawh ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />A rilruin, “Ka nghîng lo vang, Thil ṭha lo rêng ka tâwk hek lo vang,” a ti.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ânchhia te, dâwt te, vauna te a chhâk chhuak a, A ṭawng a chaltlai a, a hrâm tlahawlh hle.
  </para>
  <para style="p">
    <verse number="8" style="v" />Khaw chhûng hmun kilkhâwrahte chuan mi a châng ṭhîn, Hmun fianrialah pawi khawih lote a that a, Chhantu nei lo a melh ru reng ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sakeibaknei angin bihrûkna remchângah a châng ru a, Retheite man tûrin a châng reng a, Retheite chu lêna manin a hnûk bo ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kûn a, a bawkvâk ṭhum ṭhum a, Vânduaite chu a hnehlâk ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />A rilruin, “Pathianin pawi a ti lo vang, A inhup a, mi hmu hek lo vang,” a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , tho la, aw kan Pathian, i kut lek la, Retheite hi ngaihthah teh suh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Engtizia nge mi suaksualin Pathian a hmuhsita, “A rawn ngaihsak lo vang,” a tih rilrûk ṭhin le?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang chuan i lo en reng si a, Tuar leh mangang i hmu vek a, Ṭanpui tûrin i inpeih reng si a. Rethei leh fahrah, i hnêna tlulûtte ṭanpui ṭhîntu i ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi sualte bân chu tihtliahsak la, An sualna chu chhui chhuak vek la, Hmuh tûr awm tawh suh se.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa hi zawng, kumkhaw Pathian a ni, A ram ata ring lote chu bo daih rawh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Lalpa , retheite duhthusâm chu hria la, Rawn tiharh la, ngaihven ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Fahrahte leh hnehchhiahte chu dik takin rêlsak la, Lei mihringte zînga tu mahin an tihthlabâr tawh loh nân.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu him nân ka bêl ta a, Engtizia nge ka hnênah hetianga in tih ni: “Sava angin tlâng lamah khian thlâwk bo mai rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />En teh, mi sualte chuan an thalngul an kuai a, A hruiah chuan thal an vuah a, Thim aṭangin mi ngîlte chu kah an tum hi;
  </para>
  <para style="p">
    <verse number="3" style="v" />An innghahna lungphûmte pawh a chhiat tawh si chuan, Mi dikte chuan eng nge an tih theih tâk ang?” min tih ni?
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu a Tempul thianghlimah a awm a, Lalpa lalṭhutthlêng chu vânah a awm; A rawn thlîr a, Mihring fate hi a rawn en thlithlai ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpan mi felte chu a fiah ṭhîn a, Mi suaksualte leh nunrâwngte erawh chu a hua.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi suaksualte chungah chuan mei leh kât a sûrtîr a, Thli lum takin a hrem a, Chûng chu an chanpuala ruat a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa chu a dik a, dikna a ngaina a, Mi ngîlte chu a bulah chuan an chêng reng ang.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , min ṭanpui rawh, Pathian ngaihsak mite chu an bo zo va, Mihring zîngah mi rinawmte an ral ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mahni ṭhiante dâwt inhrilh tawnin, Ṭawng thlum takin an inbum ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpan bum hmangte hmui chu hlep sela, Chapo taka ṭawngna leite nên chuan.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ṭawnghmang thiamah kan hneh a, Kan duh apiang kan sawi ang a, Tu nge kan chungah hian lêng ang?” an ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Retheite hnehchhiahna avâng leh Pachhiate rûm thâwm avângin Ka tho vang a, an nghahhlelh ang ngeiin Tûnah ka chhan chhuak dâwn,” Lalpan a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa thu tiamte chu a thianghlim a, Tangkarua rawh thianghlimna khura meipuia rawh thianghlim, Vawi sarih rawh thianghlim tawh hnu ang hi a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , nang chuan min vêng ṭhîn a, Tûnlai mite lakah hian min hum kumkhua ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi suaksualte chu kil tinah an vei a, Mihring zîngah pâwngnêk an uar tâk hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , eng chen nge min thlahthlam anga, Ka lakah hian i hmêl i thup reng dâwn?
  </para>
  <para style="p">
    <verse number="2" style="v" />Eng chen nge ka inngaihtuah buai anga, A chhûn a zâna mangang rêng rênga ka awm anga, Ka hmêlmate hi ka chungah hian an inlulin dâwn le?
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Lalpa , ka Pathian, min han en la, min chhâng ang che, Ka mit han tivâr la; chutilo chuan, ka tlu hlum dah ang e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hmêlma chuan, “Ka hneh ta,” min ti suh se, Ka chan chhiat avângin min dotute lâwm hek suh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kei zawng i ngilneihnaah hian ka innghat a, Min chhandam dâwn vângin ka lâwm a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chu fakin ka zai ang, Ka chunga a ṭhat êm avângin.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi â chuan “Pathian rêng a awm lo ve,” a ti rilru ṭhîn. Hlemhle takin an che ṭhîn a, thil tenawm tak an ti a, Thil ṭha ti rêng an awm lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian zawnga fing taka thil ti an awm nge awm lo tiin, Vân aṭangin Lalpan mihringte chu a zuk thlîr a;
  </para>
  <para style="p">
    <verse number="3" style="v" />Pêng bo, rilru chhe pu an lo ni vek si a, Thil ṭha ti rêng an awm lo va, Pakhat tê mah an awm hauh lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi hlemhle zawng zawngte hian, ka mite ei tûr chu An eisak ṭhîn a ni tih hi an hre na nge? Lalpa hming lah chu an ko si lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi dikte chu Pathianin a awmpui avângin, Anni chuan an hlau êm êm ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Retheite remruat chu an timualpho ṭhîn a, Mahse, anni lo humtu chu Lalpa a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel-te chhandamna chu Zion ata lo thleng sela, Lalpan a mite a tihhmuingîl hunah chuan Jakoba thlahte chu an va hlimin an va lâwm dâwn tak êm!
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , i puan inah tu nge lo thleng anga, I tlâng thianghlimah chuan tu nge lo chêng ang?
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi nun ngîl, dik taka thil ti ṭhîn, Thinlung taka thu dik sawi ṭhîntu chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ani chuan mi a sawichhe ngai lo va, A ṭhian chungah thil sual a ti ngai hek lo va, Ṭhenawmte a rêl ngai bawk hek lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi sualte chu a hmusit a, Lalpa ṭihtute erawh chu a ngaisâng ṭhîn. A tâna pawi tûr pawh ni se, A thutiam a sût ngai hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pung ûmin tangka a pûktîr ngai lo va, Pawi khawih lote thiam loh chantîr tûrin tham theih a ni hek lo; Chutianga titu chu engtikah mah a chhe lo vang.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, i hnênah ka lo tlulût ta a, Min lo hum rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa hnênah, ‘Ka Lalpa chu i ni, Nang chauh hi ka tân i ṭha,’ ka ti a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Leia mi thianghlim awmte chu ropui ka ti a, ka duhzâwng tak an ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian dang thlangtute chuan An thil tuar tûr an tipung lek a ni. In tûr thil hlana, thisen an hlannaah ka tel lo vang a, An pathian hming ka lam ve hek lo vang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpan ka chanpual tûr, ka no mi ruatsak a, Nang hi i ni ka awm dân tûr mi rêlsaktu chu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ram ṭha min rochuntîr a, a ri min khamsak a, Ka chan tûr chu a duhawm hle a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rem mi ruatsaktu Lalpa chu ka fak ang a, Zânahte pawh aman min zirtîr ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka hmaah hian Lalpa a awm fo va, Ka ding lamah a awm ṭhîn a, ka nghîng lo vang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chuvâng tak chuan, thinlung lâwmin ka hlim ta êm êm a, Ka taksa pawh thlamuang takin a awm hle hle tawh ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka thlarau hi Seol-ah chuan i hnutchhiah lo vang a, I tâna inserh hi a ṭawih rala hmuh i phal hek lâwng.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nunna kawng chu mi kawhhmuh a, Hlimna kim chu i bula awm a ni, I ding lamah chatuan nawmna a awm bawk si a.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , ka dikzia hi hria la, Ka au thâwm hi lo ngaithla teh. Dâwt sawi ngai lo dîlna hi ngaihven ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />I hmaah chuan ka thiamna hi târlan ni se, I mit chuan thil dik chu hmu ngei rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka thinlung hi fiah la, Zânah mi rawn tlawhin mi fiah ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />I hnathawh an sawisêl angin ka sawisêl ve lo va, I thu ka zâwm zâwk a, inpâwngnêk ka chîng ngai lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />I kawng sialah zêl ka kal a, Ka tlu ngai lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Pathian, ka koh chein mi chhâng la, I beng dawhin ka thu hi ngaithla ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />I ngilneihna mak chu han tilang la, Aw, nangmah bêltute lo hum ṭhîntu, I ding lamin an hmêlmate lakah chhan ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />I mitnaute angin min vêng tlat la, I thla hnuaiah min thukru ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi suaksualten min hnehchhiah a, min thah tumtu hmêlmaten Min hual si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khawngaihna rêng an nei lo va, Chapo takin an ṭawng ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kan kalna lam apiangah min hual ṭhîn a, Kan tlûkna tûr remchâng an melh reng a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Min pawh sawm vek châkin hmun fianrialah Sakeibaknei angin min châng ru ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa , tho la, anmahni hmachhawnin titlâwm la, Mi sual lakah i khandaih chuan min chhandam ang che.
  </para>
  <para style="p">
    <verse number="14" style="v" />Khawvêl mite lakah min chhandam la, An duh tâwk tâwk nei ṭhînte lakah chuan. Hremna i khâwlsak chuan hrem la, An fate pawh hrem la, An tuchhuan thlengin hrem zêl ang che.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei zawng mi dik ka nih vângin I hmêl ka hmu ang a, Nangmah anna neia ka ṭhanharh hunah chuan, Ka lungawi takzet ang.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , mi tichaktu, Ka hmangaih che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa chu ka lungpui leh ka kulhpui, Min chhandamtu a ni. Ka Pathian, ka himna lungpui, Min chhandamtu ropui, ka phaw leh kulhbîng sâng a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Fak tlâk Lalpa chu ka ko va, Hmêlma lakah min hum ta a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thihna hlauhawm tak chuan min hual vêl a, Chhiatna tuiliante chuan min chîm bawk a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Seol hruihrualte chuan min phuar vêl a, Thihna thangah ka âwk ṭêp tawh a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka mangang chuan Lalpa ka han au va, Pathian hnênah ṭanpuina ka dîl a, A tempul aṭang chuan ka aw a lo hria a, Ka au thâwm chuan a beng a thleng ta e.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, lei chu khûrin a insâwi hlawk hlawk a, Tlâng chu a nghahchhante lamin a nghîng ta dur dur a, A thinur nasa tak avâng chuan.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hnâr aṭangte chuan meikhu a lo chhuak a, A ka aṭang pawh chuan kan ral hmang mei a alh chhuak a, Meilingte pawh a lo chhuak bawk a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vân khi a hai hawng a, Chhûm dum chunga dingin a lo chhuk a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Cherub chunga chuangin a thlâwk vêl a, Thlain a thlâwk ta thuak thuak a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thimin a inkhuh a, Ruah pai chhûm chhah tak chuan a hual vêl bawk a.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hmaa êng awm chuan chhûm chu a chhun tlang a, Ṭêk te, rial te a tla ta dur dur a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vânah Lalpan khawpui a tiri a, Chungnungberan a aw a chhuah a ni, Ṭêk te, rial te a tla ta dur dur a.
  </para>
  <para style="p">
    <verse number="14" style="v" />A thal a han kâp a, an darh ta a, Kâwl a phêttîr zawr zawr a, an tlânchhe ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa , i hnâra thaw chhuak meuhva i chhêma, I han hau zet chuan, Tuifinriat chu a mawng thlengin a kang zo va, Lei innghahnate pawh a lang zo ta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vân aṭangin a han ban a, min rawn vuan a, Tui thûk ata min hnûk chhuak ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hmêlma chak tak kut ata chu min chhan chhuak a, Ka hneh rual loh min hawtute lak ata chu.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chhiatna ka tawh laiin mi rawn bei a, Mahse, ka nghenchhan chu Lalpa a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmun thâwl takah min hruai chhuak a, Ka chungah hian a lâwm avângin min chhandam ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpa chuan dik taka ka tih avângin lâwmman min pe a, Pawi ka khawih loh avângin mal min sâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpa kawng chu ka zawh ṭhîn a, Pathian lakah thil sual ka ti hek lo.
  </para>
  <para style="p">
    <verse number="22" style="v" />A rêl apiang ka zâwm zêl a, A thupêkte ka bawhchhe ngai lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />A tân mi ngîl tak nih ka tum fo ṭhîn a, Thil sual ti lo tûrin ka invêng reng bawk a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dik taka ka tih ṭhin avângin Lalpan lâwmman min pe a, Pawi ka khawih lo tih a hria.
  </para>
  <para style="p">
    <verse number="25" style="v" />I laka rinawmte tân i rinawm a, Mi ṭhate tân i ṭha êm êm.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi thianghlimte tân chuan i thianghlim a, Mi suaksualte erawh chu i haw ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi tlâwmte chu i chhan ṭhîn a, Chapote erawh chu i titlâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka khâwnvâr chu mi hâlsak a, Lalpa ka Pathian chuan ka thimna chu min tihênsak ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nangma zârah hmêlmate ka ûm a, Ka Pathian zârah chuan an kulh ka lâksak ta.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pathian hi zawng a kawngte a tluang a, Lalpa thu chuan fiah a dâwl ṭhîn a, Amah bêltu zawng zawngte tân phaw a ni.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa lo hi tu nge Pathian dang awm? Kan Pathian chauh lo chu tu nge belh tûr dang awm?
  </para>
  <para style="p">
    <verse number="32" style="v" />Chaknaa min thuama, Ka kawng titluangtu chu Pathian a ni.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka ke te pawh sazuk ke ang maiin min siamsak a, Tlângah himin min dintîr a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka kutte chu indo a thiamtîr a, Dâr thalngulte ka kuai kûl thei hial a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />Inhumhim nân phaw min pe a, I kut ding lam ngei chuan min kai ta a, Min puihna chuan min tiropui ta bawk.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka pênte chu i tisau va, Ka kête lah a tleu si lo.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hmêlmate chu ka han ûm a, ka ûm phâk a, An thih vek hma loh chu ka kîrsan duh lo.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ka sât thlu a, an tho thei tawh lo, Ka ke hnuaiah an thal phung mai.
  </para>
  <para style="p">
    <verse number="39" style="v" />Indo nikhua atân chaknain min thuam a, Min dotute min hnehtîr ṭhîn.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ka hmêlmate mi ûmtîr a, Min hawtute ka that zo ta.
  </para>
  <para style="p">
    <verse number="41" style="v" />An au chûl a, chhantu an nei si lo, Lalpa chu an au va, a chhâng si lo.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka râwt sawm a, thli len vaivut ang mai hi an ni, Kawtthlêr diak angin ka thian fai ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hel hmangte lakah chuan min chhan chhuak a, Hnamte hotu-ah min siam a, Ka hriat ngai loh hnamten ka rawng an bâwl ta.
  </para>
  <para style="p">
    <verse number="44" style="v" />An hriat veleh ka thu an awih zêl a, Ka hmaah an kûn ta.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hnam dangte chu an zâm zo va, An kulh ata khûrin an lo chhuak ta.
  </para>
  <para style="p">
    <verse number="46" style="v" />Lalpa hi zawng Pathian nung a ni, Ka lungpui chu fak rawh u, Min chhandamtu Pathian chu ropui rawh se.
  </para>
  <para style="p">
    <verse number="47" style="v" />Pathianin phuba min lâksak a, Mite ka hnuaiah hian a dah.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hmêlma lakah min chhanhim a, hnuaichhiahtute chungah min awmtîr a, Mi nunrâwngte lakah min chhan chhuak ta.
  </para>
  <para style="p">
    <verse number="49" style="v" />Lalpa , hnam tin zîngah ka fak ang che, I hming fakin ka zai bawk ang.
  </para>
  <para style="p">
    <verse number="50" style="v" />A Lal thlan chu hnehna ropui tak a pe ṭhîn a, A hriakthiha chu a khawngaihin, Davida leh a thlahte chu a lainat kumkhua ang.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vânte khian Pathian ropuizia an tilang a, Vân dumah khian a themthiamzia a lang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chhûn hian chhûn hnênah thu a hlân chhâwng a, Zân pawhin zân hnênah hriat tûr a puang chhâwng ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thu rêng an sawi lo va, an ṭawng ri bawk hek lo va, An aw te chu hriat tûr a awm hek lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mahse, an aw chuan lei a fang chhuak a. An thu chu kâwlkil thlengin a thang chhuak ta. Tah chuan ni chu puan in a zârsak a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ni chu, moneitu a pindan ata hlim taka a chhuak ang leh, Mi chak phûr taka a tlân ang hi a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kâwlkil chhak lamah a lo chhuak a, Kâwlkil thlang lam panin a kal kual a, A lum hre lova thuhrûk eng mah a awm lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa Dân chu a famkim a, nun a tiharh ṭhîn, Lalpa thu hriattîr chu a rinawm a, mi mâwl a tifing ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa thuruatte chu a dik vek a, thinlung a tilâwm ṭhîn. Lalpa thupêkte chu a thianghlim a, mit a tivâr ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa ṭih chu a ṭha a, a daih kumkhua ṭhîn. Lalpa thurêl chu a dik a, a fel vêl vek a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rangkachak aiin a duhawm a, Rangkachak thianghlim ber ai pawhin. Khawizu aiin a thlum zâwk a, A thlâra luang khawizu aiin.
  </para>
  <para style="p">
    <verse number="11" style="v" />A ni, chûng chuan i chhiahhlawh hi min zirtîr ṭhîn, A zâwmtu tân lâwmman a tam êm êm.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mahni dik lohna tu nge hre thei? Sual inthup lakah te min tifihlîm ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />I chhiahhlawh hi chapona lakah min vêng la, Ka chungah hian thu neihtîr suh, Tichuan, ka lo famkim ang a, Bawhchhiatna sual lakah ka fihlîm ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Lalpa , ka lungpui leh mi tlantu, Ka thu sawite leh ka ngaihtuahte hi I tân pawm tlâk lo ni rawh se.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mangan ni-ah Lalpan chhângin, Jakoba Pathian chuan hum che rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmun Thianghlim aṭanga ṭanpui chein, Zion aṭang chuan pui che rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />I thil hlan apiangte lo pawmin, I hâlral inthawina lo lâwm rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />I duh apiang pe che sela, I thil ruahmante chu tipuitling ṭhîn rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hnehtu i nih hunah lâwmin kan au vang a, Kan Pathian hmingin hnehna puanzâr kan zâr ang. Lalpan i dîl apiang tihlawhtling ngei rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpan a hriakthiha a chhanhim ṭhîn tih ka hre ta. A hmun thianghlim vân aṭang chuan a rawn chhâng ta, A ding lam chuan ropui takin a hnehtîr ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ṭhenkhatin an tawlailîr an ring a, Mi dangin an sakawrte an ring bawk a, Keini zawngin Lalpa kan Pathian hming kan lam zâwk ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chûng mite chu tluin an thal dêr ang a, Keini chu kan tho vang a, kan ding nghet leh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , lal hi han chhandam teh, Kan koh che chuan min chhâng ang che.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , i chaknaah lal chu a hlim êm êm a, I hnehtîr avângin a va lâwm êm!
  </para>
  <para style="p">
    <verse number="2" style="v" />A duhzâwng chu i pe zêl a, A ngen apiang i hnial ngai lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thil ṭha tinrêngin i hmuak a, Rangkachak thianghlima siam lallukhum chu i khumtîr a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nunna a dîl che a, i lo pe a, Kumkhuaa damna chu i pe ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />I chhandam avângin a ropui ta êm êm a, Chawimawina leh zahawmna chu i khumtîr ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mal i sâwm kumkhua a, I hmêlin i tilâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lal hian Lalpa chu a ring tlat a, Chungnungbera ngilneihna avângin a nghîng lo vang.
  </para>
  <para style="p">
    <verse number="8" style="v" />I kut chuan i hmêlmate i dap chhuak a, I ding lam chuan nangmah hawtute chu i kawi chhuak ta.
  </para>
  <para style="p">
    <verse number="9" style="v" />I lo lan hunah i thinurna meipuiah i paih ang a, Lalpa , i thinurnain a ei zo vang a, Mei chuan a kâng ral ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />An thlahte chu lei aṭangin an chimit ang a, An tuchhuante pawh mihring zîngah an ral vek ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />I lakah chuan thil sual tih an tum a, An thil phiarrûk chu a hlawhtling lo vang.
  </para>
  <para style="p">
    <verse number="12" style="v" />I thal chuan an hmai i tin ang a, Tukkhum chhawnin an tlânchhiatsan ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa , i chakna avângin chawimawiin awm la, I thiltihtheihzia hi fakin kan zai ang.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka Pathian, ka Pathian, engah nge mi kalsan? Engati nge ṭanpuina dîla ka rûm laia hla taka i awm le?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Pathian chu chhûnahte ka au va, mi chhâng lo va, Zân a lo ni, ka ngawi thei chuang si lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang zawng i thianghlim a, lalṭhutthlênga ṭhu, Israel-ten an fak ṭhîna chu i ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kan pi puten an ring che a, An rin vângin i chhan chhuak a.
  </para>
  <para style="p">
    <verse number="5" style="v" />An au che a, i hum ṭhîn a, Nangmahah chuan an innghat a, nangin i lo chhanhim ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kei zawng changpât ang lek, mihring tling lo ka ni a, Mî chhawnchhaih leh hmuhsit ka ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Min hmu apiangte chuan min nuihzat a, An lu thingin min chhiatkhum a.
  </para>
  <para style="p">
    <verse number="8" style="v" />“ Lalpa hnênah a tlulût alâwm, rawn chhan ang hmiang: A mi duhzâwng a ni a, rawn chhan chhuak rawh se!” an ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chhûl aṭanga mi la chhuaktu, Ka nu hnute ringa mi awmtleitu i ni a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka pian ata nangmah chauhva innghat ka ni a, Ka nu pum chhûng aṭang tawhin ka Pathian i ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmêlma an lo hnai e, min hlat lul suh, Ṭanpuitu dang rêng rêng an awm si lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bâwng kawlhte chuan min hual tuau va, Basan bâwng huaite chuan min hual vêl e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sakeibaknei koham rûm angin An kâ min ânkhum a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tui leih buak ang ka ni, Ka ruhte pawh a pelh zo ta. Ka thinlung chu khawihnûn tui ang a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tha lah chu hlumbêl keh them angin a ro zo va, Ka dangah hian ka lei a bet: Thi ang dêrin vaivutah chuan min mut a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ui angin min hual vêl a, Mi sual rualin min zîm a, Ka kutah leh ka ke-ah an chhun a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka ruhte chu ka chhiar thei e. Anni lah chuan min en mai a, min thlîr reng mai.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka silhfênte an insem a, Ka kawr atân ṭhum an vâwr bawk.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa , nang chuan min hlat lul suh, Aw, min ṭanpuitu, lo hmanhmawh teh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khandaih lakah min rawn chhan la, Hêng ui lakahte hian ka nunna chhanhim rawh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sakeibaknei kâ ata hi min chhandam la, Ramsial ki kâr ata min la chhuak ang che.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tichuan, ka unaute hnênah i hming ka hril ang a, Pung khâwm zîngah chuan ka fak ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa ṭihtute u, amah chu fak rawh u, Jakoba thlahte u, chawimawi ula, Israela fate u, a hmaah kûn rawh u.
  </para>
  <para style="p">
    <verse number="24" style="v" />Retheite chu a hmusit ngai lo va, a ten hek lo. Ṭanpui an dîlin a lo hria a, a hawisan ngai hek lo.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pung khâwm ropui tak zîngah ka fak ang chia, Nangmah ṭihtute hmaah chuan Ka thutiamte ka hlen bawk ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Retheite chuan tlai takin ei sela, Lalpa zawngtute chuan amah chu fak rawh se. An thinlung chu tihharh ni kumkhua bawk rawh se.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lei pum puiin Lalpa an hria ang a, a hnênah chi tin an kîr ang a. A hmaah chuan hnam tin an ṭhingṭhi ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lalpa chu lalber a ni a, Hnam tin chungah ro a rêl ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Inei thaute chu a hmaah an kûn ang a, Inchâwm nung zo lo, vaivuta chang tûrte pawh A hmaah chuan an ṭhingṭhi ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ṭhangtharten a rawng an bâwl ang a, An thlahte hnênah pawh Lalpa thu hi an hril zêl ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />“ Lalpan a mite a chhanhim,” tiin, La piang lote pawh an la hrilh ang.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu min vêngtu a ni a, Ka tlachham lo vang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ani chuan hlobet hring dup hmunahte min chawlhtîr a, Chawlhna tui kamahte chuan min hruai ṭhîn
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka nun a tiharh thar leh a, A hming avângin kawng dikah min kalpui ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />A ni, thihna hlim kawrruam zawh mah ila, Ka hlau lo vang, Nangin min awmpui si a, I talhtum leh i vêntiangin min thlamuan ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka hmêlmate hmuhah ruai min siamsak a, Duhsakna hriak min thih a, Ka no in lai i chhûng khat reng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Matheilovin ngilneihna leh thil ṭhate chuan Ka dam chhûng zawng min zui zêl ang a, Tichuan, Lalpa inah ka awm kumkhua tawh ang.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Leilung leh a chhûnga thil awmte hi Lalpa ta a ni a, Khawvêl leh a chhûnga chêngte nên hian.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuifinriat chungah a nghat a, Tuipui chungah te a hûng ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa tlângah tu nge chho vanga, A hmun thianghlimah tu nge ding ang?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kut fai leh thinlung thianghlim pu mi, Milem be ngai lo leh, Dâwta chhechham ngai lo mi chu!
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa hnên aṭangin malsâwmnate an dawng ṭeuh ang a, Anmahni humhimtu Pathian ngei chuan Thiam a chantîr bawk ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa pantute chu chutiang mi chu an ni, Aw, Jakoba Pathian, nangmah zawngtute chu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw, kulh kawngkhârte u, in hawng zau ula, Lal ropui chu a lo lût dâwn a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tu nge Lal ropui chu? Lalpa , mi chak leh thiltithei, Indonaa huaisena hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw, kulh kawngkhârte u, inhawng rawh u, Nangni kawngkhâr hlunte u, inhawng zau rawh u, Tichuan, Lal ropui chu a lo lût dâwn nia.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tu nge Lal ropui chu? Lalpa , Engkim Lalpa hi, Amah ngei hi Lal ropui chu a ni.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , i lam ka lo hawi a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw ka Pathian, ka ring che a, ka mualpho hi phal suh, Ka hmêlmaten min uankhum hek suh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ni, nangmah nghâktute chu tu mah an mualpho lo vang a, Bum hmangte erawh chu an mualpho vang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Lalpa , i kawngte chu min hriattîr la, I duhzâwng chu min zirtîr rawh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rinawm taka ka awm theih nân min zirtîr la, Nang chu min chhandamtu Pathian i ni si a, Nilêngin ka nghâk ṭhîn che a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Lalpa , hmasâng aṭang tawha i lainatna leh ngilneihna kha, hre reng ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka tleirâwl lai sual leh bawhchhiatnate kha, hre reng suh la, Aw Lalpa , i ṭhatna leh i ngilneihna avângin Min hre reng zâwk ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chu a ṭhain a dik a, Mi sualte pawh kawng dik a zirtîr ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Retheite chu dik takin ro a rêlsak a, Mi tlâwmte chu a kawng a zirtîr ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />A thuthlung leh a thu hriattîr zâwmtute tân chuan Lalpa kawngte chu a rinawm a, ngilneihnain a khat.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Lalpa , ka thiam lohna a nasa êm a, I hming avângin mi ngaidam rawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa ṭihtute chu An kawng zawh tûr thlan dân a zirtîr ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thil ṭha tinrêng an nei ang a, An thlahte chuan ram hi an rochung ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amah ṭihtute chu Lalpa ṭhian an ni a, A thuthlung pawh a hrilh chiang ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa lam chu ka thlîr reng a, lêna ka ke âwk chu mi phelhsak ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka lam hi lo hawi la, min khawngaih ang che, Khawharin ka chau a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka thinlung hah tak hi min chhâwk la, Ka buaina zawng zawng ata hi min chhan chhuak ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka retheih leh ka manganzia hi en la, Ka sual zawng zawng hi la bo vang che.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai teh, ka hmêlmate an va tam ta êm! Huat tak têin mi hua a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Min humhim la, min chhan chhuak rawh, Ka rawn bêl che a, ka mualpho hi phal suh ang che.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ṭhatna leh dikna chuan min hum rawh se, Ka nghâk reng si che a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Pathian, Israel-te hi an manganna zawng zawng ata, chhan chhuak ang che.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , ka dikzia hi tilang chiang teh, Lalpa ka ring tlat a, ka nghîng lo vang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi en ngunin mi chhui chhuak la, Ka thinlung leh ka rilru hi fiah ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />I ngilneihna chu min hruaitu a ni si a, I rinawmnain min kaihruai ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thil lawilo betute ka ṭhutpui ngai lo va, Mi vervêkte ka kâwm ngai bawk hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil sual titu pung khâwmte chu ka huatzâwng tak an ni a, Mi sualte lah ka kâwm ngai bawk hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pawi ka khawih lo va, Lalpa maichâm ka bêl fo ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lâwmthu sawina hla ka sa a, I thil mak tihte chu ka hril bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Lalpa , i chênna in chu ka ngaina a, I ropuina awmna hmun chu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi sual zîngah min tiboral suh la, Tualthat zîngah min telh hek suh.
  </para>
  <para style="p">
    <verse number="10" style="v" />An vei lamin thil sual an ti a, An ding lamin thamna an la vak vak ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kei zawngin thil dik ka ti ṭhîn a, Min khawngaih la, min chhandam rawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmun zâwla dingin Pung khâwm zîngah, Lalpa , ka fak ang che.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu ka êng leh ka chhandamna a ni a, Tu nge ka hlauh vang? Lalpa chu ka nun humhimtu kulh a ni a, Hlauh rêng ka nei lo ve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka hmêlma leh mi dotu mi sualten Tihboral tuma min beih lai khân, An inchhuih a, an tluchhe ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi sual rualin min hual mah se, Ka hlau lo vang. Min do rawn mah sela, Ka zâm chuang hek lo vang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa hnênah thil pakhat ka dîl a, Chu mawlh chu ka zawng ang; Lalpa mawizia hmu tûra zînga amah pâwlin, Ka dam chhûng zawng Lalpa ina ka chên theihna tûr chu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mangan ni chuan a bûktê-ah min thukru ang a, A puan in chhûngrilah min bihrûktîr ang a, Lungpui chungah min hlâng daih ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Min hualtu hmêlmate chungah ka lêng ang a, A inah chuan tawtawrâwt ri nên inthawina ka hlân ang a, Lalpa fakin ka zai bawk ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , ka auh che hi, lo ngaithla teh, Mi khawngaih la, mi chhâng ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Lalpa , nangin, “Mi zawng rawh u,” i ti a, Kei chuan ka zawng ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka lakah hian inthup suh la, I thinrimin i chhiahhlawh hi hawisan suh ang che; Min puitu ber i ni, min thlahthlam suh la, Min chhandamtu Pathian, min kalsan suh ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka nu leh pate chuan min kalsan tawh a, Mahse, Lalpan min enkawl ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa , i duhzâwng chu min zirtîr la, Min chângtute avângin I kawng tluangah min hruai ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka hmêlmate duh duha tihah min hlân suh la, Mi nunrâwng leh dâwta hêk chîngte chuan min bei a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi nung ramah hian Lalpa ṭhatna hmuh beisei lo ila chuan, Ka chau daih tawh ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa chu nghâk reng la, insangmarin intichak la. Lalpa chu nghâk fan fan rawh.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , ka lungpui, ka au va che, Min ngawihsan suh. I ngawih reng chuan Leilâwta tlate ang ka ni mai ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khawngaih dîla ka au hi ngaithla la, I hmun thianghlim lama pharin ka koh che hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi sualte leh thil sual titute zîngah chuan Min la bo tel suh ang che. An ṭhiante chu remthu an sawipui a, Thil sual an ngaihtuah nghâl si ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />An thiltihte a sualzia ang zêlin hrem la, An kut thiltih phu tâwk zêlin thungrûl ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa thiltih leh a thilsiam chu An hriatthiam duh loh avângin Anniho chu a tichhe vek ang a, a tungding leh tawh lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa hi zawng fak tlâk a ni, Khawngaih ka dîlna aw a lo ngaithla si ṭhîn a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa chu mi tichaktu ka phaw a ni, Amah ka rinchhan a, min ṭanpui ṭhîn; Ka lâwm êm êm a, amah fakin ka zai bawk ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mite tân Lalpa chu kulhpui a ni, A hriakthiha tân pawh chhandamna kulhbîng sâng a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />I mite chhandam la, I rochante hi mal sâwm la, Vêngin, enkawl kumkhua ang che.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian fate u, Lalpa chu fak ula, Lalpa ropuina leh a chakna chu fak rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa hming ropui tak chu fak ula, Thianghlimna silhfên inbelin Lalpa hmaah lo kûn rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tui chungahte chuan Lalpan aw a chhuah a, Pathian ropui chuan khawpui a tiri a, Tuifinriat chungahte chuan a ri dur dur a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa aw chu thiltithei tak a ni, Lalpa aw chu a ropui ngei mai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa aw chuan sidar thingte a titliak a, A ni, Lalpan Lebanon sidar thingte chu a titliak rem rum mai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lebanon chu bâwng notê ang maiin a zuantîr a, Sirion tlâng chu ramsial notê angin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa aw chuan kâwl a tiphe zawr zawr a,
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa aw chuan thlalêr a tinghîng a, Lalpan Kades thlalêrte chu a tinghing a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa aw chuan zukpuite no a chhiattîr a, Ngawa thinghnahte a tiṭîl vek ṭhîn a, A tempul-ah chuan, “A va ropui em!” an ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa chu Tuilêt chungah a ṭhu a, A ni, Lalpa chuan kumkhuain ro a rêl ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpan a mite chu a tichak ang a, Lalpan a mite chu muanna a pe bawk ang.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , min chhan chhuah avângin ka fak ang che, Ka chungah hian hmêlma an hlim i phal si lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Lalpa , ka Pathian, Ka au che a, min lo tidam ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , Seol ata min la chhuak a, Thlâna chhuk tûr min tihdam leh tâk hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A mi thianghlimte u, Lalpa chu fakin zai ula, A hming thianghlim chu fak rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />A thinur chu a dai thuai a, A duhsakna chuan dam chhûng a daih. Zânah mittui nên mu mah ila, Zîngah lâwmna a lo thleng ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kei chuan ngaihṭha taka awmin, Ka nghîng ngai lo vang, ka ti ṭhîn a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , ka chunga i ṭhatna avângin tlâng angin mi tinghet a, Mahse, i hmêl i han thup chuan Ka mangan leh mai ṭhin kha.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , ka au va che, Lalpa hnênah khawngaih ka dîl a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thi ta ila, leilâwtah tla ila, I tân eng nge hlâwk ang? Mitthite chuan an fak thei che em ni? I ṭhatzia pawh an puang ang maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa , lo ngaithla la, min khawngaihin Lalpa , min ṭanpui ang che.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka ṭah hi lâwmah chantîr la, Hlimna min sintîr zâwk ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tichuan, ngawi mai lovin Nangmah fakin ka zai ang a, Lalpa ka Pathian i ni a, Ka fak kumkhua ang che.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , ka rawn bêl che a, Eng lai mahin ka mualpho hi phal suh ang che. I rinawm a, min hum ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />I beng chhi la, min chhan thuai rawh. Ka tân phen tûr lungpui ni la, Ka himna kulh lo ni ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang chu ka lungpui leh ka kulhbîng sâng i ni, I hming avângin min kaihruai ṭhîn ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />An lên zâr rûk ata min hnûk chhuak ang che. Nang zawng ka tân himna i ni si.
  </para>
  <para style="p">
    <verse number="5" style="v" />I kutah ka thlarau ka kawltîr e, Aw Lalpa , Pathian rinawm, min tlan ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Eng mah ni lo milem betute chu ka huatzâwng tak an ni a, Kei zawngin Lalpa ka ring a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />I ngilneihna avângin hlimin ka lâwm ang a, Ka tuarnate i rawn hmu a, Ka manganzia pawh i hre vek si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka hmêlmaten min man i phal lo va, Zalên takin min awmtîr ta a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka mang a ang êm e, Lalpa , min khawngaih rawh, Lungngaihna avângin ka mit a vai zo va, Ka taksa leh ka thinlung pawh a chau zo ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lungngai rêng rêngin ka awm a, Ka hunte chu rûm nân ka hmang zo va, Ka bawhchhiatna avângin tha pawh ka nei ta lo, Ruh hlîr ruh hlîr ka ni ta e.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka hmêlmaten min hmusit a, Ka ṭhenawmten min deu hle a, Ka hmêlhriatte lahin min hlau va, Khawlaia min hmututen min tlânsan bawk.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thi tawh angin min theihnghilh zo ta a, Hlumbêl keh paih ang mai ka ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi tam tak phun ru ka hria a, Hlauhawmin min hual vêl a, An inrâwn a, ka nunna lâk an tum a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kei zawngin, Lalpa , ka ring che a, “Pathian chu i ni,” ka ti a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka hunte chu i kutah a awm a, Mi tiduhdahtute leh min ûmtute lakah min chhanhim rawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />I chhiahhlawh chungah hian khawngaihna lantîr la, Khawngaihna tâwp lovin mi chhanhim ang che.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa , ka au va che, min timualpho lul suh, Mi sualte chu mualphovin awm sela, Seol-ah chuan chhuk nghiai nghiai mai rawh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dâwt sawi chîngte hmui chu chîp hmiah rawh se, Chapo leh hmusit taka Mi dikte ṭawng khum thâr thârte chu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangmah ṭihtute tân thil ṭha i va khâwl khâwm tam êm! Mi dang hmuha nangmah bêltute tân i tihsak chu:
  </para>
  <para style="p">
    <verse number="20" style="v" />Miten an phiar laiin i ângchhûngah i dah a, An sawichhiat dâwn pawhin i bûk chhûngah i thukru ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpa chu fak rawh u, Râlin min hual laia A khawngaihna mak tak avângin.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kei chuan “I hmuh lohvah min hnawt chhuak ta,” Ka lo ti hmanhmawh a; Mahse, khawngaih dîla ka auh che chuan I lo ngaithla var ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa ngaihsaktute u, amah hmangaih rawh u, Lalpan mi rinawmte a vêng tlat ṭhîn a ni. Chapo taka khawsate erawh chu hneh takin a thungrûl ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa nghâktu zawng zawngte u, insangmar ula, intihuai rawh u.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />An bawhchhiatna ngaihdama awma, An sualna thai bosakte chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpan khawlohna nei lova a ngaih, Bum tumna reng nei lo mi chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka ngawih tlat lai khân, Nilênga ka rûmna lamah, Ka chau zo ta a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />A chhûn a zânin i kut ka tuar ṭhîn a, Ṭhâl rum lai ram ro angin ka ro zo ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka sualna chu i hmaah ka rawn puang a, Ka khawlohna ka zêp hek lo. “ Lalpa hnênah ka bawhchhiatna thupha ka chawi teh ang,” ka ti a. Tichuan, ka sualna zawng zawng chu i lo ngaidam ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hei vâng tak hian, hmuh awla i awm lai hian Pathian ngaihsak mite chu, Tuite lo lian bulh bulh mah se, a chîm pha hauh lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka tân bihrûkna i ni a, Hmêlma lakah min hum ang che. Min vên him avângin ka fak ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ka zirtîr dâwn che a, I kalna tûr ka kawhhmuh bawk ang che. Ka en reng che a, Ka kaihruai zêl ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eng mah hre lo sabengtung leh sakawr ang hian awm suh u; Anni chu i thununa, i duhna lama duh duha i kaih theih nân lakam barh an ngai asin,” Lalpan a ti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sualte tuarna chu a va tam êm! Amah ringtute erawh chu Lalpan a khawngaihnain a enkawl ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi dikte u, Lalpa -ah chuan hlimin lâwm fo ula, Rilru ngîl tak pu zawng zawngte u, Hlimin au rawh u.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi dikte u, Lalpa -ah lâwmin au ula, Mi ngîlte tân amah fak hi a âwm a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ṭingṭang nên Lalpa chu fak ula, Perhkhuang hrui sâwm nei nên a fakna hla sa rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />A tân hla thar sa ula, Thiam taka remin, hlimin au rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa thu chu a dik ṭhîn a, A thiltihte a rin ngam bawk a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpan dikna leh rorêl ṭha a ngaina a, Lei hi a ngilneihnain a khat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vân khi Lalpa thu-a siam a ni a, Engkim mai khi a thu-a awm a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuipui tuite chu bêlah a chhêk khâwm a, Tuifinriat tuite chu zêmah a khung khâwm bawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />Leia awmten Lalpa chu ṭih sela, Khawvêla chêng zawng zawngten ani chu hlau rawh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thu a han sawi a, khawvêl hi a lo awm ta mai a, Thu a han pe a, a awm hlen ta a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpan hnamte remruat chu a hlawhchhamtîr a, Mite thiltum chu a dâl bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa remruatte chu chatuanin a ding a, A thiltum chu kumkhuaa awm atân a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa Pathiana neih hnam chu an nihlawh e, A rochana a thlan, a mite chu.
  </para>
  <para style="p">
    <verse number="13" style="v" />Vân aṭangin Lalpan a zu thlîr a, Mihring zawng zawng a hmu vek a,
  </para>
  <para style="p">
    <verse number="14" style="v" />A ṭhut hmun aṭangin Leia chêng zawng zawng hi a rawn en ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />An rilrute chu a siamsak a ni a, An thiltihte pawh chu a hre fai vek a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sipai ngah avâng ngawtin lal chu an him lo vang a, Mi chak pawh an chak avâng ngawtin an him hek lo vang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sakawr chu inchhanhim nân a rin tlâk loh va, Chak hle mah se, tu mah a chhan chhuak thei lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah ṭihtute chungah Lalpa mit a fu, A khawngaihna nghâktute chungah chuan;
  </para>
  <para style="p">
    <verse number="19" style="v" />Thihna laka chhan chhuak tûr leh, Ṭâmpui laka an nun humhim tûrin.
  </para>
  <para style="p">
    <verse number="20" style="v" />Keinin Lalpa kan nghâk reng a, Min ṭanpuitu, kan phaw a ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amahah chuan kan thinlung a lâwm a, A hming thianghlim kan ring a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa , i ngilneihna kan chungah awm rawh se, Nang hi kan beisei chu i ni si a.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Eng lai pawhin Lalpa chu ka fak ang a, Tâwp lo tawpin ka fak zêl ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa chu ka chhuang êm êm a, Retheite chuan chu chu hria se, lâwm ve rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa chu min chawimawipui ula, A hming i tiropui ang u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu ka zawng a, min lo chhâng a, Ka hlauh zawng zawng lakah min chhan chhuak ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah an han en a, an hmêl a hlim ta a, An zak ngai tawh lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />He mi rethei tak hian Lalpa chu a au va, Anin a lo ngaithla a, A manganna zawng zawngah a rawn chhan chhuak ta a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vântirhkohte chuan Lalpa ṭihtute chu An hual tlat a, an humhim ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa ṭhatzia hi tem chhin ula, Han hre chiang teh rêng u. Lalpa hnêna tlulûtte chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="9" style="v" />A mi thianghlimte u, Lalpa chu hlau ula, Amah ṭihtute chuan tlâkchham rêng an nei lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sakeibaknei vânglaite chuan ei tûr an tlachham a, An ril a ṭâm bawk ṭhîn. Lalpa zawngtute erawh chuan thil ṭha eng mah an tlachham lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naute u, lo kal ula, Ka thu ngaithla rawh u, Lalpa ṭih dân ka zirtîr ang che u.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tu pawh nun thlahlela, Thil ṭha hmua dam rei duh chuan,
  </para>
  <para style="p">
    <verse number="13" style="v" />Sual lakah chuan a lei vêng ṭha sela, Bumna thu sawi lo tûrin fîmkhur rawh se.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sual hawisan la, thil ṭha ti rawh, Remna zawng la, ûm zêl ang che.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi dikte chu Lalpan a en reng a, Ṭanpui dîla an au a ngaithla ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil sual titute chu Lalpan a lawm loh avângin Leiah pawh hriat reng an ni lo vang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi dikte chuan Lalpa an au va, anin a lo hria a, An manganna zawng zawngah a chhan chhuak a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thinlung taka lungchhiate chu Lalpan a hnaih ṭhîn a, Rilru taka inchhîrte chu a chhandam ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi dik chuan thil ṭha lo tam tak a tuar ṭhîn a, Mahse, chûng zawng zawng ata chu Lalpan a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />A ruh zawng zawng a vênsak a, Pakhat mah tihtliah a ni lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi sualte chu thil ṭha lovin a tihlum ang a, Mi dik hawtute chuan thiam loh an chang bawk ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpan a chhiahhlawhte a tlan ta a, Amah pantu apiangte chuan thiam loh an chang lo vang.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , nangin min beitutebei la, Min dotute do ve ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />I phaw kengin i âwmphaw pawh ha la, Min pui tûrin lo thawk ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />I fei lekin i khandaih chu phawi la, Min ûmtute lo dang tlat la, “Ka chhan him dâwn a che,” min ti ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />Min thah tumtute chu tihmualphova tihzahin awm sela, Min tihchhiat tumtute chu tlânchhiain, hrilhhai takin awm zâwk rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Buhsi, thli lên angin, Lalpa vântirhkohvin anni chu ûm bo rawh se,
  </para>
  <para style="p">
    <verse number="6" style="v" />Thim zînga kawng nâlah Lalpa vântirhkohvin ûm nek rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />A chhan awm lovin ka awh nân lên an zâr ru a, Ka tlâk nân khur an lai.
  </para>
  <para style="p">
    <verse number="8" style="v" />An hriat loh hlânin chhiatna an chungah thleng se, An thang kam rûkah anni chu âwk sela, An khur laihah tla hlawm rawh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa -ah chuan ka lâwm ang a, Min chhandam avângin ka hlim bawk ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka thinlung zawng zawngin Lalpa hnênah, “Nang chuan an aia thiltithei lakah retheite i chhan ṭhîn, Pachhiate leh chanhaite pawh an neih lâksaktute lakah i hum bawk ṭhîn, Nang ang rêng hi tu nge awm le?” ka ti ngei ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hretu derte an lo thawk a, Ka hriat loh thilahte min chhâl.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka thil ṭha tih sualin min thungrûl a, Ka bei a dawng a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei chuan an dam lohvin Saiip puan ka sin a, Chaw ngheiin ka tuarpui a, Lu kûn rengin ka ṭawngṭai ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka ṭhian emaw, ka unaupa emaw tuarpui angin Ka vei ka vei ṭhîn a, Mahni nu sûn ni awm takin ka kun reng ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nimahsela, kei ka tlûk chuan hlimin an pung khâwm a, Min sawisa tûrin, ka hriat ngai lohte pawh An lo pung khâwm bawk a, Min sawisak an bâng duh lo.
  </para>
  <para style="p">
    <verse number="16" style="v" />Piangsualte pawh hmusit duh ṭhîn mi sualte chuan An hâ min ṭhial khum hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa , eng chen nge min en mai mai dâwn le? Min tichhe tûrte lakah min rawn chhan la, Hêng sakeibakneite lakah hian ka nunna hi chhanhim ang che.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pungkhâwm ropui tak hmaah lâwmthu ka hrilh ang che a, Mi tam tak zîngah chuan ka fak ang che.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dik lo taka min hmêlmâktute chu, Ka chungah lâwm suh se; Engmahlova min hawtute chu ka chungah hian meng sâng suh se
  </para>
  <para style="p">
    <verse number="20" style="v" />Nêlawm takin an ṭawng ngai lo va, Khualehtui ṭhate bum dân tûr an ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Min bei tûrin an ka an âng a, “I hi! Kan mit ngeiin kan hmu ta alâwm,” an ti.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa , i hmu reng a, ngawi mai teh suh; Lalpa , min hlat lul suh ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tho la, min chhan tûrin lo thawk ta che, Lalpa ka Pathian, min chhanhim teh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa Pathian, i dikzia tilang tûrin ro min rêlsak la, Min diriam lul suh se.
  </para>
  <para style="p">
    <verse number="25" style="v" />Anni chuan, “Kan duhthusâm a thleng ta le!” ti rilruin “Kan lem zo ta alâwm,” ti hek suh se.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka chan chhiat laia lâwm ṭhînte chu Zakin mualpho rawh se; Ka chunga intilalte chu Zak ngawih ngawihin kun reng rawh se.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka thiamchannaa lâwmte chu hlim takin awm sela; “ Lalpa chu a ropui e, A chhiahhlawh chan ṭha duhsaktu chu,” ti rawh se.
  </para>
  <para style="p">
    <verse number="28" style="v" />Tichuan, i dikzia hi ka hril ang a, Nilêngin ka fak ang che.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi sual thinlung chhûngah sualin thu a sawi. a, Pathian ṭih ṭûlna rêng a hmu lo.
  </para>
  <para style="p">
    <verse number="2" style="v" />A ngaih dân chuan, A sualna chu Pathianin a hmuh a ring lo va, A huat a ring hek lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi bumna thu sual a chhâk chhuak reng a, Thil ṭha leh fing a ti lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />A khumlaizâwlah chuan thil sual a suangtuah ṭhîn, Kawng sualah chuan a kal lui a, Thil ṭha lo tih a hnial ngai lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , i ngilneihna chuan vân a tawng a, I rinawmna pawhin vân dum a thleng.
  </para>
  <para style="p">
    <verse number="6" style="v" />I dikna chu tlâng lian tak ang a ni a, I rorêl dikzia pawh tuithûkpui ang a ni. Aw Lalpa , mihring leh ramsate i humhim ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Pathian, i ngilneihna chu a va hlu êm! Mihringte hian i thla hnuai hlim an pan ṭhîn a.
  </para>
  <para style="p">
    <verse number="8" style="v" />I inah chuan thil ṭha eiin an tlai puar a, I lâwmna lui tui chu i intîr ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nang chu nunna tuikhur i ni a, I êngah chuan êng kan hmu ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmah hretute chungah chuan i ngilneihna thla chu zâr la, I dikzia pawh mi ngîlte chungah chuan lantîr zêl rawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chapote ke chuan min chîl lo sela, Mi sualte kut chuan min vai lêng bawk suh se.
  </para>
  <para style="p">
    <verse number="12" style="v" />Saw! Mi sualte an tlu e, An thal dêr mai, an tho thei lo.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi sualte avângin intihrehawm suh la, An thil dik lo tihte awt bawk hek suh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlobet angin an vuai ang a, Hnimhring angin an ro mai dâwn si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa ring la, thil ṭha ti rawh, He ramah hian awm la, A hausakna tlân rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu nêl la, I dîl apiang a pe ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />I awm dân tûr chu Lalpa chungah nghat la, Amah ring la, a tihsak vek ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />I dikna chu ni angin a êntîr ang a, I rorêlna dik pawh chhûn êng ang a ni ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa -ah chuan châwl la, Amah chu nghâk fan fan rawh. Hausa thutte awt suh ang che, Thil sual titute thîk hek suh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thinrim bân la, thinur sim rawh, Intihrehawm duh suh, thil sual i tih phah dah ang e.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi sualte chu hnawh chhuah an ni ang a, Lalpa nghâktute erawh chuan ram hi an chang ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rei lo têah mi sualte chu an bo ta phiar a, An awmna chu en en mah la, i hmu zo lo vang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thuhnuairawlhte chuan ram hi an rochung ang a. Râlmuang takin an awm hle hle bawk ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi sualte chuan mi dik an phiar ṭhîn a, Thinurin an hâ an ṭhial khum ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpan anni chu a nuihzat ang a, An thi mai dâwn tih a hre vek si.
  </para>
  <para style="p">
    <verse number="14" style="v" />Retheite leh pachhiate tihchhiat nân, Mi suaksual chuan ngûnhnâm an phawi ṭhîn a, Mi ngîlte tihhlum nân, An thalngul chu an kai kûl ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />An ngûnhnâm chuan anmahni zâwk chu a chhun ang a, An thalngul pawh a tliak vek ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi dik thil neih chu tlêm mah se, Mi sual thil neih ṭeuhte ai chuan a ṭha.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi sualte chakna chu Lalpan a lâk bosak ang a, Mi dikte chu a hum tlat ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi nun tluangte chu Lalpan a en zui a, An rochan chu an nei kumkhua tawh ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hun harsaah an mualpho lo vang a, Ṭâm kumah pawh an puar bawk ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi sualte chu an boral thuai ang a, Lalpa hmêlmate pawh inthawina berâm thau angin meikhu-ah an zâm ral ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi sualte chuan an pûkin an pe leh ngai lo va, Mi ṭhate erawh chuan a thlâwnin an pe ṭhîn.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mal a sâwmte chuan ram hi an luah ang a, Ânchhia a lawhte chu an boral ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />An kalna tûr Lalpan a ruatsak a, An nun dânah a lâwm bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tlu ṭhîn mah se, an tlu hlen lo vang, Lalpan an kut a chelh zui ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka naupan lai ata ka lo tar hnu thleng hian, Lalpan mi dik a thlahthlam tâk ka hre ngai lo, An fate pawh chaw khawn ka hmu hek lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ni tin a thlâwnin an pe a, an pûktîr ṭhîn, An fate chuan malsâwmna pawh an dawng zêl bawk.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sual hawisanin thil ṭha ti la, He ramah hian i chêng kumkhua dâwn nia.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dik taka rorêl hi Lalpan a ngaina a, Amah ṭihtute chu a ensan ngai hek lo. A vêng kumkhua ang a, Mi suaksual thlahte erawh chu an boral ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi dikte chuan ram hi an nei ang a, An awmchilh kumkhua ang.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi dik chuan thufing a chhâk chhuak a, Dik takin ro a rêl bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian dân chu a thinlungah a châm tlat a, A pênsan ngai hek lo.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi suaksual chuan mi dik a châng ru a, Tihhlum dân kawng a zawng reng ṭhîn.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mahse, Lalpan mi sual kutah a hnutchhiah duh lo va, Rorêlnaah thiam loh an chan a phal hek lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lalpa chu thlîr reng la, a kawng zawh rawh. A chawimawi ang chia, ram chu a pe ang che a, Mi sualte boral lai i hmu bawk ang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi sual inchhek lai ka hmu a, Lei ṭhaa thing angin a duah hluah mai.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ka tlawh leh chuan a lo awm tawh lo va, Ka va zawng a, hmuh tûr a awm tawh lo.
  </para>
  <para style="p">
    <verse number="37" style="v" />Mi ṭhate awm dân chu ngaihtuah ula, Mi ngîlte chu en teh mah u, Remna duh mite chuan tu leh fa an nei ṭhîn.
  </para>
  <para style="p">
    <verse number="38" style="v" />Thil sual titute erawh chu an ral tlâng ang a, An zîk a bûl bawk ang.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mi dikte chu Lalpan a rawn chhandam ṭhîn a, Mangan ni chuan an himna kulh a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Lalpan a pui ṭhîn a, a chhan chhuak ṭhîn, Mi sual lakah a hum tlat a, A hnêna an tlûkluh avângin a chhandam ṭhîn.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , thinrim chungin min zilh suh la, Thinur chungin min hrem hek suh.
  </para>
  <para style="p">
    <verse number="2" style="v" />I thal chuan min chhun a, I kut ka tuar tâk hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />I lungnih loh avângin ka taksaah dam lai rêng a awm lo va, Ka sual avângin ka na ṭhêm ṭhûm a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka khawlohnain mi chîm pil a, Phurh rual lohvin a rit a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka hliamte chu a pân pûn a, Ka lo â êm a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na tuarin ka kun tlawk tlawk ṭhîn a, Nilêngin ka mangang chu ka vân ruai ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka taiah hian a sa huai huai ṭhîn a, Ka taksaah dam lai rêng a awm lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka â chuai a, ka sil ûrh a, Thinlung nâin ka rûm ka rûm ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , ka duhzâwng chu ka rawn thlen e, Ka rûm thâwm pawh i hai hek lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka phu dêp dêp ṭhîn a, tha rêng ka nei ta lo, Ka mitte pawh a thim zo ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka pân avângin ka ṭhen leh rualte chuan min hnaih duh lo va; Ka laichînte pawh an hla zo ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Min thah tumtute chuan ka tân thang an kam a, Ka chhiatna zawngtute chuan min vau reng a, Eng lai pawhin min phiar ru ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bengngawng angin eng mah ka hre ṭhîn lo va, Ṭawngtheilo ang maiin eng mah ka sawi ngai lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Eng mah hre thei lote chuan Tu mah an chhâng ngai lo ang hian ka awm.
  </para>
  <para style="p">
    <verse number="15" style="v" />A ni, Lalpa , nangmah ka nghâk che a, Lalpa , min chhâng ang che, aw ka Pathian.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka tawlhthlûkin min diriam anga, An lâwm viau dah ang e, ka ti a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka chau lek lek a ni, Ka tuar reng si a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka bawhchhiatna ka zêp lo ve, Ka sual avângin ka mang a ang si a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka hmêlmate chu an thothâng a ṭhain an chak hle a, Dik lo taka min hawtute an pung tulh tulh,
  </para>
  <para style="p">
    <verse number="20" style="v" />Thil ṭha suala thungrûltuten Thil ṭha ka tih ṭhin avângin min er,
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpa , min kalsan suh, Aw ka Pathian, min hlat lul suh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Min pui tûrin lo hmanhmawh rawh, Lalpa , min chhandamtu.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />‘Ka kalna tûr ka en ngun ang, Thu sual ka sawi loh nân, Mi sual bulah ka hmui Ka chîp tlat ang,’ ka ti a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ngawi reng a, eng mah ka sawi lo va, A ṭha lam pawh ka sawi hek lo, Ka tuarna chu a zual tulh tulh bawk si.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka thinlung a sahâl a, Ka inngaihtuah nasat poh leh ka buai a zual, Tichuan, ka ṭawng chhuak ta hial a:
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa , ka tâwpna tûr min hriattîr ang che, Ka dam chin tûr nên, ka nun tawizia ka hriat theih nân.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai teh, kan dam chhûng nite chu i va han titawi êm! Kan hunte hi i tân eng tham mah a ni lo, Mi tin an ṭhat lai ber pawhin eng an ni lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hlimthla ang chauh an ni; An buaipui ber pawh engmahlo mai a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , beisei tûr eng dang nge ka neih? Nang hi i ni ka rinchhan ber chu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka sual zawng zawng ata min chhan chhuak la, Mi â-te nuihzatbûrah min siam lul suh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nangin min tuartîr a nih avângin, Ka ngawi mai a, ka ṭawng hek lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Min hrem tawh suh, I kut tuarin ka thi mai dâwn alâwm.
  </para>
  <para style="p">
    <verse number="11" style="v" />An sualnaah mihringte chu i zilh a, i thunun ṭhîn, Thîm ei angin an mawinate i tichhe ṭhîn. Mihring hi zawng eng mah an lo ni lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , ka ṭawngṭai hi lo ngaithla la, Ṭanpui ka dîlna hi lo hria ang che. Ka mittui hi ngawihsan suh la, Kan pi leh pute ang khân, Rei lo tê châm, mikhual mai ka nih hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka kal bova ka awm loh hlen hma hian. Ka hlimna tûr hun min siamsak ang che.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu ka nghâk fan fan a, Min ngaihven a, ṭanpui ka dîlna chu a ngaithla ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khuarkhurum chirhdûp thûk ata min khai chhuak a, Lungpui chungah min dintîr a, Hmun nghetah chuan min awmtîr ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hla thar min saktîr a, kan Pathian fakna hla chu, Mi tam takin an hmu ang a, an hlau vang a, Lalpa chu an ring ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi nihlawhte chu Lalpa ringtute hi an ni, Milem be duh lova, Pathian lem lam Hawi duh ngai lote chu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Lalpa , kan Pathian, kan tân thil tam tak i ti a, Thil mak tak tak tiin min ngaihtuah êm êm ṭhîn a ni. Nangmah ang rêng tu mah an awm lo va, Chhiarin hril dâwn ila, Hril sên rual a ni lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Inthawina leh hâlral thilhlan i ngaisâng lo va, Sual thawina leh pum hâl i phût hek lo, I thu ka hriat theih nân beng min pe ta zâwk a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tichuan, “Hei le, ka rawn pan che; Dân bu-ah chuan i zirtîrna Ka tân ziak a ni e,” ka ti a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw ka Pathian, i duhzâwng tih ka va châk êm! I dânte chu ka thinlungah a châm reng ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Min chhan chhuah thu lâwmawm hi, Pungkhâwm ropui zîngah ka hril ṭhîn a, Lalpa , nangmah ngeiin i hria, Ka kâ hi ka ui ngai lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Min chhan chhuah thu hi ka thup lo va, I rinawmna leh i chhandamna thu hi Ka hril fo ṭhîn. Pungkhâwm ropui zîngah, I ngilneihna leh i rin tlâkzia ka zêp ngai lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa , i lainatna ka tân ui suh, I ngilneihna leh i rinawmna chuan min hualhim fo vang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thil ṭha lo chhiar sên lohte chuan min hual tlat a, Ka bawhchhiatnate chuan min chîm ta a, Ka chhiar sêng lo, Ka sam aiin a tam zâwk a, Ka bei a dawng ta a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa , khawngaih takin min chhan chhuak la, Lalpa , min rawn ṭanpui var rawh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Min thah tumtute chu Mualphovin, mangang hle hlawm rawh se. Ka chhiatna chunga lâwmte chu Zak takin tlânchhe rawh se.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Chei! Chei!” min tihkhumtute chu Zakin kun tlawk tlawk bawk rawh se.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nangmah zawngtu zawng zawngte chu, Hlimin au dur dur sela, I chhandamna ngaihlute chuan, “ Lalpa chawimawi rawh u,” ti fo rawh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei pachhia leh rethei tak hi, Lalpan min ngaihtuah ṭhîn; Min puitu leh min chhandamtu i ni, Aw ka Pathian, muangchâng lul suh.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi rethei ngaihtuahtutechu an nihlawh e, Mangan ni-ah Lalpan a chhanhim dâwn si a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpan a vêng ang a, an dam reng ang, An ramah chuan engthâwl takin an awm ang a, An hmêlmate kutah a pe lo vang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpan an dam lohvin a enkawl ang a, An natna a tidam ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kei chuan, “ Lalpa , i chungah thil ka tisual a, Min khawngaih la, min tidam rawh,” ka ti a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka hmêlmaten na tak takin min ṭawng khum a, “Engtikah tak thi-in boral ang maw,” an ti ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Min tlawh lahin a chhe zâwngin an sawi chhâwng a, A chhe lam hlîr an la khâwm, An kal chhuak a, an sawi darh ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Min hawtute an inbe ru ṭhîn a, Ka chhiatna tûr hlîr an ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />“A na êm a, A thokâng leh tawh lo vang,” an ti a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka ṭhian bul ber, ka rin êm êm, Ka chaw kîlpui ngei chu Ka chungah a inlek ta.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa , nang chuan min khawngaih la, min tidam leh ang che, Ka hmêlmate hi ka han thungrûl teh ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka hmêlmaten min hneh loh chuan, Min duhsak hle tih ka hria ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka dik avângin nangin min chelh tlat la, I hmaah chuan min awmtîr kumkhua ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa , Israel-te Pathian chu fak rawh u, Chatuan chatuanin amah chu fak rawh u. Amen, Amen.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sakhiin luite tui a châk êm êm ṭhîn ang hian, Aw Pathian, kei pawhin ka ngai êm êm ṭhîn che a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka nun hi Pathian châkin, Pathian nung châkin a tuihâl a ni. Pathian hmaa kalin engtikah nge ka inlan ang?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka mittui avângin chaw rêng ka ei thei lo, Ka hmêlmate lah chuan, “Khawiah nge i Pathian chu?” min lo ti chhên a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tûn hma ka ngaihtuahin ka lung a chhe hle ṭhîn, Pathian in pana mipui ka hruai ṭhin te, Hlim taka fak hla saa kan kût ṭhin laite kha:
  </para>
  <para style="p">
    <verse number="5" style="v" />Engtizia nge ka ngui êma, Ka rilru a hah tâk êm le? Pathianah chuan ka innghat ang a, Min chhandamtu hmêl chu hmuin ka la fak ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Pathian, ka rilru a ngui hle mai, Hermon tlâng te, Mizar tlâng te, Jordan ram aṭangte hian ka hre reng ṭhîn a che.
  </para>
  <para style="p">
    <verse number="7" style="v" />I tui luang ri hum hum angin, Tui thûk takte chu a phûl bulh bulh mai a, I tuifâwn inchhawkte chuan min tuam tâk hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpan a ngilneihna chu chhûnah a tilang a, Zânah a fak hlain min awi. Mi tinungtu Pathian hnênah ka ṭawngṭai ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian, ka lungpui hnênah, “Engati nge min thlahthlama, Ka hmêlmate kut tuara ka rûm le?” ka la ti ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ruh vuak sawmsak ang maia nain Ka hmêlmaten min diriam a, “Khawiah nge i Pathian chu?” Min lo ti chhên bawk si.
  </para>
  <para style="p">
    <verse number="11" style="v" />Engtizia nge ka ngui êma, Ka rilru a hah tâk êm le? Pathianah chuan ka innghat ang a, Min chhandamtu hmêl chu hmuin ka la fak ang.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, ro min rêlsak rawh, Pathian pawisa lo hnam dang min khingtute khing ve la, Mi sual leh bum hmang lakah min chhanhim ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Min tichaktu Pathian i ni, Engati nge min thlauhthlâk tâka, Ka hmêlmate kut tuara ka rûm ka rûm le?
  </para>
  <para style="p">
    <verse number="3" style="v" />I êng leh i thutak chu han tîr la, I tlâng thianghlim, i chênnaah chuan Min hruai thleng ngei rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Pathian, i maichâmah ka kal ang a, Nang hi min tihlimtu ber Pathian i ni, Aw Pathian, ka Pathian, ṭingṭang tumin ka fak ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Engtizia nge ka ngui êma, Ka rilru a hah tak êm le? Pathianah chuan ka innghat ang a, Min chhandamtu hmêl chu hmuin ka la fak ang.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, hmasânga anhun laia i thiltihte, Kan pi puten min hrilh a, Kan bengin kan hria.
  </para>
  <para style="p">
    <verse number="2" style="v" />I kutin hnam dangte chu i hnawt chhuak a, An hmunah anni chu i phun a, Mi dangte chu i tidarh a, Anni chu i tipung ta a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ram chu khandaiha an lâk a ni lo va, An chak avânga inhumhim an ni hek lo; I kut ding lam, i bân pharin i awmpui a, I duhsak êm avânga la an ni zâwk si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Pathian, nang zawng ka Lal i ni, Jakob-ho, an dote hnehtîr ṭhîntu chu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nangmah avângin min dotute kan nawr tawm a, I hming avângin min beitute kan chîl nek ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka thal ka ring lo va, Ka khandaih hian mi chhan hek lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka hmêlmate lakah nangin min chhanhim ṭhîn a, Min hawtute i timualpho bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni tin Pathian kan chawimawi a, I hming kan fak kumkhua bawk ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tûnah hi zawng min thlauthla ta, Min timualpho ta a, Kan sipai rual zîngah i tel ve tâk loh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Min dotute hmaah min tlânchhiattîr ta a, Min hawtuten min rawk tâk hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Berâm anga talhah min dah a, Hnam tin zîngah min tihdarh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />I mite chu tlâwm takin i hralh a, An man lah chu i phût sâng duh hek lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kan kianga awmte hmuhsitah min siam ta a, Kan vêla chêngte diriam leh nuihzat kan ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hnam dangte chuan fiamthu nuihzaah min hmang a, An lu min thin khum ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni tin mualpho takin kan awm ṭhîn a, Zakin kan kûn reng mai;
  </para>
  <para style="p">
    <verse number="16" style="v" />Min sâwta min diriamtute aw avâng leh Hmêlma leh phuba latute avângin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hêng hi lo thleng mah se kan theihnghilh lo che a, I thuthlung pawh kan bawhchhe lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kan hawisan ngai lo che a, I kawng ata kan pêng hek lo.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sihal chênna hmunah min lum reng a, Thim chhah takin min khuh ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kan Pathian hming kan theihnghilha, Kan kutte hi hnam dang pathian lama kan phar ṭhin chuan,
  </para>
  <para style="p">
    <verse number="21" style="v" />Rilru ngaihtuah rûkte hre theitu, Chung Pathian chuan a hre lo vang maw?
  </para>
  <para style="p">
    <verse number="22" style="v" />Nangmah avângin ni tin min that reng a, Berâm talh tûr dah khâwm ang lekin min ngai a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lalpa , tho teh, engtizia nge i muthilh reng? Intiharh la, min ngaihsak lo reng suh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Engati nge min bihrûksana, Ka tuar nasatzia leh min tihduhdahzia hi i theihnghilh le?
  </para>
  <para style="p">
    <verse number="25" style="v" />Lei siin kan kûn renga, Kan bawh phêk reng hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Min pui tûrin lo thawk chhuak la, Ngil i neih êm avângin min tlan ang che.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Thu mawi tak tak ka rilruah a lang uar uar a, Lal chungchâng thu ka hril dâwn e. Rang taka lehkha an ziak angin Ka sawi zung zung dâwn e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi azawngah i hmêl a ṭha ber e, I ṭawngkam lah a duhawm si, Chuvângin, Pathian pawhin mal a sâwm che hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw mi huaisen, i khandaih chu pai la, Ropui leh mawi takin inthuam rawh le.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ropui taka inthuama, Thutak leh dikna ṭan tûrin Sakawr chunga chuangin tluang takin kal la, I chaknain hneh zêl ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />I thalte chu a zum êm êm, I hmêlmate a chhun tlang a, I hmaah chuan mite an tlu phung mai.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian pêk che i lalna chu I nei reng ang a, I mite chungah diknain ro i rêl ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dikna i ngainata, sualna i huat avângin, Pathian, i Pathian chuan a thlang ta che a ni; Lal dangte aia nasa zâwkin hlimna hriak chu a thih ta che.
  </para>
  <para style="p">
    <verse number="8" style="v" />I silhfênah Mura leh Aloe rim, Thakthîng rim nên a nam rum rum, Sainghova chei in ropui tak aṭangin Ṭingṭang tumtuten an awi che.
  </para>
  <para style="p">
    <verse number="9" style="v" />I kianga ding ṭhîn tûra thlante chu lal fanute an ni, I ding lamah, Ofir rangkachak puan sinin lalnu a ding.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mami, ka thu hi ngaithla la, I beng chhiin ngaihven ang che: I laichînte leh i pa in chu theihnghilh daih rawh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tichuan, lalin hmêlṭha tiin a duh ang che a, Ani chu i Lalpa a ni si a, a thu zâwm rawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tura khuaa mi hausaten an tlawn ang che a, Thilpêk an rawn hlân dâwn a che.
  </para>
  <para style="p">
    <verse number="13" style="v" />A pindana lal nula ṭhu chu a va ṭha êm! Rangkachak zaia ṭial puan a sin saw.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mawi taka incheiin lal hnênah an hruai, Amah zuitu nula rualte nên, I hnênah an rawn hruai e.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hlim leh lâwmin an rawn hruai a, Lal inah chuan an lo lawi e.
  </para>
  <para style="p">
    <verse number="16" style="v" />I pate hmun chu i faten an luah ang a, Ram tina rorêltuah i siam bawk ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I hming hi chhuan zawng zawnga hriat reng tûrin ka siam ang a, Tichuan, miten an fak kumkhua ang che.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian chu kan inhumhimna leh kan chakna, Mangan laia ṭanpui var ṭhîntu hnai reng a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chuvângin, leilung hi lo danglamin, Tlângte hi tuifinriat thûk laiah pil mah sela, Kan hlau lo vang.
  </para>
  <para style="p">
    <verse number="3" style="v" />A tuite chu ri hum humin phûl bulh bulh mah sela, A fâwnte chuan tlângte tinghîng dur dur mah sela, Kan hlau chuang hek lo vang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lui pakhat a awm a, Chumi pêngte chuan Pathian khawpui a tilâwm ṭhîn; Chungnungbera awmna Hmun Thianghlim chu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian chu a chhûngah a chêng a, A nghîng lo vang a, Pathian chuan khawfîngchah hunah a ṭanpui ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnamte an buai zo va, Ramte a nghîng bawk a, Ani chuan aw a chhuah a, lei chu a tui zo ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Engkim Lalpan min awmpui a, Jakoba Pathian chu kan kulhbîng sâng a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hawh u, Lalpa thiltihte hi han en teh u, Leia thilte a tihchhiat nasatzia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Indonate chu kâwlkil thlengin a tireh a, Thalte a titliak a, feite a tibung a, Phawte meiah a rawh ral ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngawi ula, Pathian ka ni tih hi hre rawh u, Hnam tin chunga lal ka ni a, Lei chunga rorêltu ka nih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Engkim Lalpan min awmpui a, Jakoba Pathian chu kan kulhbîng sâng a ni.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi zawng zawngte u, in kut bêng ula, Hlim takin Pathian fakin au rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa , Chungnungbera chu a va hlauhawm em! Lei chungah lal ropui tak a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kan hnuaiah mite a kûntîr a, Kan ke hnuaiah hnamte a awmtîr hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kan ro luah tûr min thlansak a, A hmangaih Jakoban a chhuan êm êm ram hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian chu au thâwm nên a chho va, Lalpa chu tawtawrâwt ri nên a chho ta.
  </para>
  <para style="p">
    <verse number="6" style="v" />Fakin zai rawh u, Pathian fakin zai rawh u, Fakin zai rawh u, Kan Lalber hi fakin zai rawh u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian hi khawvêl zawng zawng Lal a ni si a, Fakna hla mawiin amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hnam tin chungah Pathian chuan ro a rêl a, A lal ṭhutthlêng thianghlimah chuan a ṭhu.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi tin zînga mi liante chu an pung khâwm a, Abrahama Pathian mite chu. Pathian chu lei chunga Lalber a ni, Ropui taka chawimawi tûr a ni e.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu a ropui a, fak chiam tûr a ni e, Kan Pathian khawpuiah, a tlâng thianghlimah hian.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zion tlâng chu a mawi chungchuang mang e, Ram pum pui timawitu a ni. Zion tlâng hi Zafan tlâng ang a ni, Lal ropui tak khawpui chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kulh chhûngah chuan Pathian chu a chêng a, Humhimtu a nih a lang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalte an pung khâwm a, Rawn bei tûrin an lo kal khâwm.
  </para>
  <para style="p">
    <verse number="5" style="v" />An han hmu a, mak an ti a, An hlau ta a, thlabârin an tlânchhia.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tah chuan an thauvah a man ta a, Nau vei na tuar ang mai an ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khawchhak thliin Tarsis lawng rual A tichhe vek bawk a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Engkim Lalpan awm reng tûra a din, Kan Pathian khawpuiah chuan, Kan hriat ṭhin kha kan hmuh tâk hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Pathian, i Tempul chhûngah chuan, I ngilneihzia kan chhui kan chhui ṭhîn,
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw kan Pathian, i hming an chawimawi a, Ram tinah a thang ta e, Dik takin ro i rêl ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zion tlâng chu lâwm hle sela, Judai ram mite chu hlim bawk rawh se, Dik taka ro i rêl avângin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zion tlâng hi vêlin kal hual ula, In sângte chu chhiar vek rawh u.
  </para>
  <para style="p">
    <verse number="13" style="v" />A kulh bangte chu en ngun ula, A thlêrte chu fang vek rawh u, Ṭhangthar zêl hnêna in hrilh atân.
  </para>
  <para style="p">
    <verse number="14" style="v" />He Pathian hi, kumkhuaa kan Pathian a ni, Aman min hruai kumkhua dâwn si.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi tinrêngin hei hi ngaithla ula, Khawvêla chêng zawng zawngten in beng lo chhi rawh u,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mitê leh milian, Hausa leh rethei, in zavaiin,
  </para>
  <para style="p">
    <verse number="3" style="v" />Thufing ka chhâk chhuak dâwn e, Ka ngaihtuah ṭhinte chu ka tilang dâwn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thu ril ka ngaihven ang a, Ṭingṭang tumin thu khirh ka sawi fiah ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hun ṭha lo chu engah nge ka hlauh vang? Min beitute sualna chuan min hual mah se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chûng mite chuan an hausakna ringin An sum ngahzia an chhuang a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu mah mahni an intlan thei lo asin: Pathian hnênah intlanna man an pe thei hek lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihring nunna man chu a tam êm a, Eng mahin a daih lo vang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thlâna liam lova, An dam reng theih nân chuan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi fingte pawh an thi a hmu, Mi â te leh mi mâwlte ang bawkin, An sumte chu mi dang tân an hnutchhiah.
  </para>
  <para style="p">
    <verse number="11" style="v" />An inte chu awm reng tûrin an ngai, An chênna chu kumkhaw daih tûr emaw an ti. An ram hmingah an hming an chawi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihring hi a hlu reng lo, Ramsa, boral mai tûr ang hi a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi â-te awm dân chu hetiang hi a ni e, An hnung zuia, an thu lâwmtute pawh:
  </para>
  <para style="p">
    <verse number="14" style="v" />Berâm anga thi tûr an ni, Anmahni vêngtu chu Thihna a ni, Zîngah mi dikte chuan an chungah ro an rêl ang a, An taksa chu thlânah a ral ang, Seol-ah an awm dâwn tawh si a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei erawh chu, mitthi khua ata, Pathianin min tlan chhuak dâwn a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi an hlâwkin awt suh, An chhûngkaw sum a pun thûr thûrte hian,
  </para>
  <para style="p">
    <verse number="17" style="v" />An thih hun chuan chhawm theih rêng an nei lo vang, An sum neih chuan a zui dâwn lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />An dam laiin nihlawh an inti hle ṭhîn a, An chêt fuhin miten an fak bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />An pate kalnaah an chhuk ve tho vang, Êng awm lohna hmun thimah chuan.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihring hlutna hi ramsa boral ṭhîn ang mai a nihzia An hrethiam thei lo.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , pathiante Pathian chuan thu a sawi a, Ni lo chhuahna aṭanga a tlâk lehna thlengin Leilung hi a ko va.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khaw mawi famkim Zion aṭang chuan Pathian a êng chhuak ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kan Pathian chu a lo kal ang a, a ngawi mai mai dâwn lo, Meialh hluah hluahin a hma a hruai ang a, A vêlah chuan thlipui a tleh hum hum ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chung lam vân khi a ko, lei nên, A mite tân ro a rêl dâwn a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Pathian ngaihsakte chu ko khâwm ula, Inthawina hlâna thu min thlunpuitute chu,” a ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vân khian a dikzia chu a puang a, Pathian ngei hi rorêltu chu a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ka mite u, ngaithla ula, thu ka sawi dâwn, Israel mite u, ka khing dâwn che u a ni, Pathian, in Pathian chu ka nih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Inthawina avângin ka dem lo che u a, Hâlral thil hlan in rawn lâk fo avâng hian ka dem hek lo a che u,
  </para>
  <para style="p">
    <verse number="9" style="v" />In ina mi bâwngpa ka phût lo va, In ran huanga mi kêlpa pawh ka ngên hek lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ramhnuaia sa tinrêng hi ka ta asin, Tlâng tina chêng ramsate pawh ka ta a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tlânga sava tinrêngte pawh ka hria a, Thil nung zawng zawng pawh ka ta a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rilṭâm mah ila, ka hrilh lo vang che u, Khawvêl leh a chhûnga awmte hi ka ta a ni si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bâwngpa sa ka eiin Kêlpa thisen ka in dâwn em ni?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian hnênah lâwmthu sawi inthawina hlân ula, Chungnungbera hnêna in thutiam chu hlen zâwk rawh u.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mangan ni-ah min ko ula, Ka chhanhim ngei ang che u, Tichuan, min chawimawi ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi sual hnêna Pathian thu sawi chu hei hi a ni: “Ka dânte chu engah nge i lam chhêna, Ka thuthlung pawh engah nge i sawi fo?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka thununna i duh lo va, Ka thupêkte i hnâwl bawk a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Rûkru i hmuhin i thurualpui a, Uire chîngte i kawp bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thil sual sawi pawh i chîng hle a, Dâwt sawi i hreh hek lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi zîngah i unau rêl i chîng a, I pianpui ngei i hêk bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hêng thilte hi tih i chîng a, Ka ngawi mai dâwn em ni? Nangmah ang leka mi ngai hi ka dem che a, A chhan pawh i mit hmuhah ka tilang dâwn a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian theihnghilhtute u, ngaithla rawh u, Chutilo chu, ka pawt sawm hlauh dah ang che u, Chhanhimtu rêng in nei lo vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lâwmthu sawi inthawina hlântu chuan min chawimawi a ni. A awm dân vawng diktu chu, Pathian chhandamna chu ka hmuhtîr ang,” a ti a ni.
  </para>
  <chapter number="51" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, mi ngilnei tak i nih avângin min khawngaih la, Lainatna ngah tak i nih avângin, ka bawhchhiatnate hi thai bo vang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka khawlohnate hi min sil faisak la, Ka sualna hi min tlen faisak ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka bawhchhia tih ka hre ta si a, Ka sualzia pawh ka hre reng mai.
  </para>
  <para style="p">
    <verse number="4" style="v" />I chungah, i chungah ngei thil sual ka ti a, I mit hmuha sual chu ka ti a ni. Ka chungthu i sawi hi a dik e, Thiam loh min chantîr pawh a dik a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ni, sualin ka lo piang a, Ka nu min pai tirh aṭang rêngin mi sual ka ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai teh, nang chuan chhûngril lamahte hian Takna i duh ṭhîn a. I finna chuan min tikhat ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Husop-in tui min theh la, ka thiang ang a, Min sil fai la, vûr aiin ka vâr ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hlim leh lâwm ri mi hriattîr ang che, Ka ruhte hi i titliak na a, Hlimna ka nei leh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka sualna hi haider la, Khawlohna zawng zawng thai bo vang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Pathian, keimahah hian thinlung thianghlim siam la, Rilru thar nghet tak min pe ang che.
  </para>
  <para style="p">
    <verse number="11" style="v" />I hnên ata hi min hnawt bo suh la, I Thlarau thianghlim hi min lâksak hek suh ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />I chhandam hlimna chu min pe leh la, Thlarauvin dawhthei takin min chelh reng ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tichuan, i kawngte chu bawhchhetute ka kawhhmuh ang a, Mi sualte chuan i lam an lo hawi ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Pathian, min chhandamtu Pathian, Thisen chhuahna lakah min hum la, I felzia hi lâwm takin ka puang ang,
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa , ka hmuite hi hawng la, Tichuan, ka fak dâwn che nia.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Inthawina hi i lâwm lo va, Lâwm la chu ka rawn hlân tûr, Hâlral thilhlan pawh i duhzâwng ber a ni hek lo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian hnêna inthawina dik tak chu thinlung keh hi a ni, Aw Pathian, lungchhiaa inchhîr ngawih ngawih hi I hmusit ngai lo ve.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Pathian, Zion khua chu duhsakin thil ṭha tihsak la, Jerusalem kulh bangte pawh din thar ang che.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tichuan, hâlral leh pumhlan inthawina dik takah chuan i lâwm ang a, I maichâmah bâwngpa an rawn hlân tawh ang.
  </para>
  <chapter number="52" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw, nang mi chak, engtizia nge thil sual i uanpui tâk? Pathian ngilneihna zawng a ngai reng ṭhîn asin.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi dang sawichhiat i tum ṭhîn a, I lei lah chu chemte hriam tak ang hi a ni a, Dâwt phuah pawh i thiam ngei mai.
  </para>
  <para style="p">
    <verse number="3" style="v" />A ṭha aiin a chhia i ngaina a, Thu dik aiin dâwt sawi i chîng bawk si.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang, dâwt sawi hmang, Mi rilru hliam zâwnga thu sawi i hrât hle mai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chuvângin, Pathian pawhin a tichhe hlen ang che, A man ang che a, i in ata a hnûk chhuak ang che a, Mi nung ram ata a pawt chhuak daih ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi dikte chuan chu chu an hmu ang a, an hlau vang a, An nuihzat bawk ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />“En rú, Pathiana innghat duh lo pa hi, A hausakna a rinchhan a, Suahsual bâwla inhum a tum hi,” an ti ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei zawng Pathian ina oliv duah hluah hluah ang hi ka ni, Pathian ngilneihna hi ka rinchhan kumkhua chu a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thil min tihsak avâng hian ka fak kumkhua ang che. Mi inserhte hmaah pawh i ṭhatzia hi ka puang fo vang.
  </para>
  <chapter number="53" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi â chuan “Pathian rênga awm lo ve,” an ti rilruṭhîn a, Hlemhle takin an che a, thil sual tenawm an ti ṭhîn. Thil ṭha ti rêng an awm lo ve.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian zawngtu mi fing an awm emaw tiin vân aṭangin Pathianin mihringte chu a zu thlîr a,
  </para>
  <para style="p">
    <verse number="3" style="v" />An zavaiin hnungtawlh, rilru chhe pu an ni a, Thil ṭha ti rêng an awm lo va, Pakhat tê mah an awm hauh lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hlemhlete hian ka mite ei tûr chu an eisak ṭhîn a ni tih hi an hre na nge? Pathian lah chu an lam si lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai teh, hlauh lohna tûrah pawh an hlau êm êm ang a, Amah hre lo mite ruh chu Pathianin a theh darha, A thlauhthlâk tâk avângin i timualpho thei ta si a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel-te chhandamna chu Zion ata a lo thleng a, Pathian ngei chuan a mite chu a tihhmuingîl hunah, Jakoba thlahte chu an va hlimin an va lâwm dâwn tak êm!
  </para>
  <chapter number="54" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, i thiltihtheihnain min chhandam la, I chaknain ka thu min rêlsak rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Pathian, ka dîlna hi lo ngaithla la, Ka thute hi lo bengkhawn teh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hnam dangte chu min bei tûrin an lo thawk a, Mi hlauhawm pui puiten min thah an tum, Pathian pawisa ngai lote chuan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mahse, Pathian chu min ṭanpui ṭhîntu a ni a, Lalpa chu min tungding ṭhîntu a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Min tihchhiat tumtute sualna chu Pathianin thungrûl rawh se, Ani chu a rinawm a, anni chu a tiboral ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Phal takin inthawina ka rawn hlân a che, Lalpa , i ṭha êm a, i hming ka chawimawi ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka manganna tinrêng ata min chhan chhuak a, Ka hmêlmate tlâwm ta chu ka hmuh tâk hi.
  </para>
  <chapter number="55" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, ka ṭawngṭaina ngaithla la, Khawngaih ka dîl a che, min bihrûksan lul suh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi ngaihven la, min chhâng ang che, Manganga vân ruaiin ka rûm ka rûm a ni:
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka hmêlmate thâwm avâng leh Mi suaksualte min nêkchêpna avângin. Min tibuai ta si a, An thinur a, min hua a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka thin a phu dêp dêp a, Thih ka hlau reng a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka thauvah min man a, ka khûr zawih zawih ta a, Ka chechâng thei ta lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ṭhuro angin thla nei ila, Hahchawlhna tûr zawngin ka thlâwk daih ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ram hla takah ka thlâwk ang a, Thlalêr hmunah ka awm daih ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thlipui ruahpui laka himna panin ka kal sawk sawk tûr,” ka ti.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , an ṭawng tihbuaisak rawh, Khawpuiah hian khawlohna leh innghirnghona, Ka hmu ṭeuh si.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chhûn zân zawmin an vâk vêl a, Kulh vêngtute zîngah bawhchhiatna leh buaina a khat.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khawpui chhûngah suahsualna a tam a, Kawtthlêr zau laiah lah inpâwngnêkna leh Inbumnate a reh hek lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka hmêlmaten min nuihzat chu ni se, Ka tuar thiam ang. Min hawtute ka chunga inlek chu ni se, Ka bihrûksan thei ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mahse, nangmah i lo ni reng si a, Keimah ang maia ka ngaih, ka ṭhian ka kawmngeih tak,
  </para>
  <para style="p">
    <verse number="14" style="v" />Tui taka ka titipui ṭhin, Mipui ruala Pathian ina ka lawipui ṭhin kha.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hmêlmate chu a hun hmain thi se, A nung chungin Seol-ah chhuk rawh se. An inah leh an zîngah chuan sualna a châm tlat si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kei erawh chuan Pathian ka au vang a, Lalpan min chhandam ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tûk tin, tlai tin, chhûn laiah pawh, Ka chau rûm thâwm a thleng chho va, Ka aw a hre ngei ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Min beitute lakah min chhanhim a, An tam hle chungin.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hmasâng ata rorêltu Pathian chuan, A hria ang a, a titlâwm ang, An lamlêt duh lo va, Pathian an ṭih hek lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Inrem taka a awmpui chungah chuan A kut a thawh ṭhîn a, An thuthlun chu a bawhchhe ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hnutetui ang maiin a kam chhuak chu a thlum a, Insual peih reng thinlung a pu si, A thuchhuak chu hriak ang maiin a tlawr a, Khandaih hriam tak ang a ni si.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa chungah i phurrit chu nghat la, Anin a chhâwk ang che, Mi dikte chu an nghîn a phal lo vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aw Pathian, khuarkhurum thûkah chuan chhuktîr ang che, Thisen chhuah chîngte leh dâwt hehte chu, An dam tûr chanve pawh an dam lo vang, Kei erawh chu, nangmahah chuan ka innghat ang.
  </para>
  <chapter number="56" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, min khawngaih rawh, Miten min veh min veh mai a, Min dotuten min zim reng hi!
  </para>
  <para style="p">
    <verse number="2" style="v" />Min beituten min veh nilêng ṭhîn a, Aw Chungnungber, an va tam êm!
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka thla a phân laiin Kei chuan ka ring ṭhîn che.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian thu chu ka chhuang ang a, Pathian chu ka ring a, ka hlau lo vang, Mihringte chuan eng nge min tih theih ang?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka chungthu-ah an inrawlh châmchi a, Ka chhiatna tûr an ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmun kilkhâwrah an inhâwr khâwm ṭhîn a, Ka hnu an chhui ru a, min thah an tum.
  </para>
  <para style="p">
    <verse number="7" style="v" />An khawlohna avângin chhan chhuah an ni ang maw? Aw Pathian, chûng mite chu thinurin tudawl ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka vahvaih zinzia hi i hre vek a, Ka mittui luangte pawh i chhinchhiah a, I lehkhabu-ah chuan ziak vek a ni lâwm ni?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka koh hun che chuan ka hmêlmate an tlânchhia ang, Pathian chu ka lama ṭang a nih ka hre si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian thu chu ka chhuang ang a, Lalpa thu chu ka chhuang bawk ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian chu ka ring a, ka hlau lo vang, Mihring maiin eng nge min tih theih ang?
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Pathian, i hnêna ka thutiam chu ka hlen ang a, Lâwmthu sawi inthawina ka hlân ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thihna lakah min chhan chhuak a, Ka kête lung chhuih bah palh lakah min vêng, Tichuan, Pathian hmaah ka lêng thei a, Mi nungte êngah chuan.
  </para>
  <chapter number="57" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, min khawngaih rawh, min khawngaih rawh, I hnên ka rawn pan a, I thla hnuai hlimah chuan ka lo bi ang, Thil ṭha lo hi a kian hma chu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian Chungnungbera chu ka au. Engkim min tihsak ṭhîntu Pathian chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Vân aṭangin min chhâng ang a, min chhandam ang, Min vehtute hmuhsitna ata chu, Pathianin a rinawmna leh ngilneihna A rawn lantîr ngei ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sakei zînga awm ang ka ni, Ka chunga thinrimte zînga ka chên hi, An hâte chu fei leh thal anga hriam a ni, An leite lah khandaih hriam tak ang hi a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vânahte khian i ropuizia han tilang la, Aw Pathian, lei pumah hian tilang ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka awh nân lên an zâr duai a, Ka mangang êm êm mai, Ka kalkhânah hum an lai a, Anmahni ngei an tla ta zâwk.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka ring tlat che a ni, aw Pathian, ka ring tlat che, Hla ka sa ang, a ni, i fak hla ka sa ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka nunna hi ṭhangharh sela, Ṭingṭang leh khuang te u, inpeih rawh u, Khua i han au vâr teh ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , i mite zîngah chuan ka fak ang che, Mipui zîngah i fak hla ka sa ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />I ngilneihna chuan vân a tawng a, I thutak chuan vân khi a thleng si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vânahte khian i ropuizia han tilang la, Aw Pathian, leiah pawh hian tilang ang che.
  </para>
  <chapter number="58" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hotute u, thu dik in sawimeuh maw? Mite chungah dik takin ro in rêl em?
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil ṭha lo tih tûr ngawt in ngaihtuah thung si a, Ka ram hi pâwngnêknain in tikhat.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pum chhûng aṭang rêngin mi sualte chu an hel sa a, An pian tirh aṭangin dâwt lamah an thle daih tawh a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Rûl angin tûr an nei ṭeuh va, Chawngkawr bengngawng ang hi an ni,
  </para>
  <para style="p">
    <verse number="5" style="v" />Rûl thlêm thiamte aw hre duh lo, Dawithiam dawi hla ngaithla duh lo ang hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Pathian, an hâte chu chhut balsak la, Lalpa , sakeibaknei kawlhho ngho hi tihtliahsak rawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tui anga pûtin luang ral sela, Thal fang nei lo ang hi ni hlawm rawh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chêngkawl thi angin râwp ral sela, Hlamzuih, êng hmu hman lo ang hi ni hlawm rawh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />An hriat loh hlânin hlobet anga ah chhum an ni, A thi leh dam, Pathian thinurnain a lên bo vang,
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sual chunga phuba lo thleng chu an hmuhin, Mi dikte chu an hlim ang a, Mi sualte thisen chu an dai ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Mi dikte chuan lâwmman an la hmu ngei dâwn e, Pathian pawhin khawvêl a lo enkawl ngei hi,” Miten an la ti ang.
  </para>
  <chapter number="59" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka Pathian, hmêlma lakah min chhanhim la, Min beitute lakah min hum tlat rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil sual titute lakah chuan min chhan chhuak la, Thisen chhuah chîngte kut ata min chhandam rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai teh, min thah tumin min châng reng a, Mi nunrâwng pui puite an pung khâwm e; Ka bawhchhiat leh ka sual vâng a ni lo, Lalpa .
  </para>
  <para style="p">
    <verse number="4" style="v" />Thil ṭha lo ka tih vâng a ni hek lo, An tlân khâwm a, min hual tâk hi, Min pui tûrin lo tho harh la, en teh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , Engkim Pathian, Israel-te Pathian i ni; Hnam dangte hi hrem tûrin lo thawk la, Vervêk taka che ṭhîn mi sualho hi khawngaih hauh suh ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tlaiah an lo pung khâwm leh ṭhîn, Ui ang maiin min ngur min ngur, Khawpui chhûngah an vâk vêl ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Min vau nasatzia hi ngai teh, An hmuite chu khandaih hriam tak ang hi a ni, “Tu nge hria ang?” an ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , nang chuan i nuihzat ang; Hnam tinrêng hi i nuihzatbûr bawk ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Min tichaktu, ka thlîr reng che, Min hum ṭhîntu Pathian i ni si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka chunga ngilnei ṭhîn Pathianin min lo hmuak ang a, Min dotute chau hmêl min entîr ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Pathian, hêngho hi thah zawng that suh la, Ka mite hian an theihnghilh dah ang e, Vahvaihtîr la, i chaknain titlâwm dêr rawh, Lalpa , kan phaw i ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />An ka chu sualin a khat a, An thu sawi pawh sual hlîr a ni. An chapona chhiat phah rawh se, ânchhe lawha dâwt sawi an chîng êm mai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thinrimin tiboral la, ral vek rawh se, Jakoba chungah chuan Pathianin ro a rêl tih Kâwlkil thlengin hre vek rawh se.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tlaiah an lo pung khâwm leh ṭhîn, Ui ang maiin min ngur min ngur, Khawpui chhûngah an vâk vêl ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ei tûr zawngin an vâk ruai a, Kham tâwk an ei hma chu an vâk zankhua ta ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kei chuan i chakzia ka hril ang a, Zîng tak takah i ngilneihzia ka hril bawk ang, Ka tân mangan nia kulhpui i ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Min tichaktu, zaiin ka fak ang che, Mi khawngaihtu chung Pathian hi Ka tân kulhbîng sâng chu a ni.
  </para>
  <chapter number="60" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, min thlauthlâka, Min tihdarh zawh tâk hi; I thinur hle na a, kan lam lo hawi leh teh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ram chu i sâwi nghîng a, a phel tâk hi, A chhe laite chu thawm la, A tlu mai dâwn alâwm.
  </para>
  <para style="p">
    <verse number="3" style="v" />I mite hi thil khirh tak i tuartîr a, Pai pai khawpin uain min intîr hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangmah ṭihtute chu an inhâwr khâwm theih nân, Thal kâptute lakah flag pe ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />I chaknain min rawn chhan la, Kan dîlna hi lo ngaithla teh, I mi duh takte hi an him theih nân.
  </para>
  <para style="p">
    <verse number="6" style="v" />A hmun thianghlim aṭangin Pathianin thu a sawi: “Sekem khua chu ka sem darh lêng ang a, Sukot ruam chu ka ṭhen darh vek bawk ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gilead leh Manase ram chu ka ta a ni, Efraim ram pawh ka inhumna lukhum a ni a, Judai ram lah ka laltiang a ni si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Moab ram chu ka insilna chawhtawlh a ni a, Ka ta a nih hriat nân, Edom ram chu ka ta a ni tih hriat nân, Ka pheikhawkin ka vawm ang, tiin. Ka chungah hian Filistia mite chu lâwmin an au ang maw?”
  </para>
  <para style="p">
    <verse number="9" style="v" />Tu nge kulh nei khuaah mi hruai anga, Edom ramah min kalpui ang?
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Pathian, min thlauthla ta em ni? Kan sipaite zîngah, aw Pathian, i tel ve tâk loh hi?
  </para>
  <para style="p">
    <verse number="11" style="v" />Hmêlma lakah min ṭanpui teh, Mihring ṭanpuina zawng engmahlo mai a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian zârah huai takin kan che ang, Kan hmêlmate a chîl hrep ang.
  </para>
  <chapter number="61" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, ka au thâwmhi ngaithla la, Ka ṭawngṭaina ngaihven ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hla tak aṭangin mangang takin ka auh che hi, Ka kai phâk loh lungpuiah chuan min hlâng ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang chu ka tân himna i ni, Hmêlma laka kulhbîng sâng nghet tak chu.
  </para>
  <para style="p">
    <verse number="4" style="v" />I puan inah ka awm kumkhua ang a, I thlazâr hnuaiah chuan ka tlulût ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Pathian, ka thutiamte i ngaithla a, I hming ṭihtute chan tûr chu min pe.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lal dam chhûng hi tihseisak la, Tu mawng bêngin dam bawk rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Pathian, i hmaah chuan lal reng sela, I ngilneih leh i rinawmnain vêng ṭhîn ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tichuan, i hming ka fak kumkhua ang a, Ka thutiamte ni tin ka hlen bawk ang.
  </para>
  <chapter number="62" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian chu ka nghâk fanfan ṭhîn a, Amah chauh hi min chhandamtu a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amah chauh hi ka tân himna lungpui a ni, Min hum ṭhîntu a nih avângin ka nghîng mai mai lo vang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bang âwn leh pal tlu ṭêp ang lek hi, Nangni hian tihchim tumin eng chen nge min beih dâwn?
  </para>
  <para style="p">
    <verse number="4" style="v" />A dinhmun sâng ata hnuh thlâk zai in rêl a, Dâwt sawi in lâwmzâwng tak a ni. In ṭawng chhuak chu a thlum hle a, In rilruin ânchhia in lawh si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian chu ka nghâk fan fan ṭhîn a, Amah chauh hi ka innghahna a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amah chauh hi ka tân himna lungpui a ni, Min hum ṭhîntu a nih avângin ka nghîng mai mai lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian chu min chhantu leh min tiropuitu a ni, Ka lungpui nghet tak, ka belh Pathian a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mite u, eng lai pawhin ani chu ring ula, Engkim hrilh ṭhîn rawh u, Kan belh Pathian a ni si a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihringte hi thaw ang lek an ni a, Milian, mitê, engmahlo mai an ni; Han bûk mah la, an zâng heih a, Boruak ang leka zâng an ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chuhhelh taka thil neih innghah nân hmang suh la, Mi thil chhuhsaka hausak tum hek suh. Hausa thûr thûr mah la, Rilru innghah nân chuan hmang suh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vawi hnih vawi thum Pathianin a sawi ka hre tawh, Thiltihtheihna hi zawng Pathian ta chauh a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , ngilneihna hi nangma ta chauh a ni, An thiltih ang zêla mite rûltu i ni.
  </para>
  <chapter number="63" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, ka Pathian i ni a, Ṭhahnemngai takin ka zawng ka zawng che a, Ram ro, tâmlak, tui vânna hmunah hian Nangmah châkin ka tuihâl a, Ka taksa hian a ngai êm êm a che.
  </para>
  <para style="p">
    <verse number="2" style="v" />I hmun thianghlimah chuan hmu che ila, I chakzia leh i ropuizia han hmu teh ila aw!
  </para>
  <para style="p">
    <verse number="3" style="v" />I ngilneihna hi zawng nunna aiin a hlu, Ka hmuite hian a fak ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka dam chhûng zawngin ka fak ang che a, I hming lamin ka bân ka rawn phar ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />A sa tui tui tlân ang maiin ka tlai ang a, Hlim takin i fak hla ka sa ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khumlaizâwlah ka dâwn ṭhîn che a, Zânkhua khuain ka lam ṭhîn che.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Min ṭanpuitu nang hi ni la, I thla hnuai hlimah chuan zaiin,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangmahah chuan bei tlat ila, I kut ding lamin min chelh tlat la,” ka ti fo ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Min thah tuma mi zawngtute, Leilâwtah an tla ang a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Khandaiha sah hlum an ni ang a, Sihalte chuan an sa an tlân bawk ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lal chu, Pathianah chuan a hlim ang a, A hming chhâltute chuan Ani chu an chawimawi ang, Dâwt sawi chîngte ka erawh chu huhsak a ni ang.
  </para>
  <chapter number="64" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka mangang au hi, aw Pathian lo ngaithla la, Hmêlma hlauhawm lakah ka nun hi hum ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi sual pung khâwm lakah min thukru la, Thil dik lo titute kal khâwmho lakah chuan.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khandaih angin an lei an tât hriam a, Thu huatthlala tak chuan thal angin min tin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi pawi sawi lo kah hlum tumin an châng ru a, An kâp thut ṭhîn, hlauh rêng an nei lo ve.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil sual ti tûrin an intêl ruh a, Thang kam rûk zai an rêl. “Tu nge hmu ang?” an ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thil sual an rawt chhuak a, “Hmuh chhuah rual loh kan rawt tâk hi,” an ti. An ngaihtuahna chu a thûk a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathianin a kâp ve thung ang a, An tlu nghâl phung ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />An thu sawi ngei chu an chhiat phah ang a, A hmu apiangte chuan an lu an thin khum ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi tinin an hlau vang a, “Pathian tih a ni,” an ti ang a, A hna thawhte an hrethiam ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi dikte chu Lalpa -ah chuan an lâwm ang a, Amahah chuan an tlulût ang, Mi ngîlte chuan amah an chhuang bawk ang.
  </para>
  <chapter number="65" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, Zion-ah chuan fak tûr i ni, Thutiamte pawh i tân hlen tûr a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ṭawngṭai ngaithlatu i ni a, Mi tinrêng i hnênah an lo kal ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kan sualna chu sawi sên a ni lo va, Nang chuan kan bawhchhiatnate i ngaidam ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />I chênnaa awm ve tûra i thlan, I kianga awm tûra i tihte chu an nihlawh e. I ina thil ṭhate chênin kan tlai ang a, I tempul thianghlima i malsâwmnate chuan.
  </para>
  <para style="p">
    <verse number="5" style="v" />Min chhandamtu Pathian, Dik tak leh mak taka thil tiin min chhâng a, Khawvêl pum puia mi leh tuifinriat râl hla taka Awmte pawh hian, an ring ta che.
  </para>
  <para style="p">
    <verse number="6" style="v" />I chaknain tlângte i hûng mup a, I thiltihtheihzia i lantîr hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuipui rûm hum hum te, Tuifâwn ri hlup hlup te, Mipui sa mur mur te i tidai a,
  </para>
  <para style="p">
    <verse number="8" style="v" />Hmun hla taka awmte pawhin I thil tih makte chu mak an ti a, Zîng leh tlai lo thleng chuan lâwmna a rawn thlen ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lei hi i ngaihsak a, ruahtuiin i châwm a, Nasa takin i titui a, Luikawrte chu tuiin i tikhat a, Tichuan, buh hmun atân lei chu i buatsaih ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lei rih thlûr chu tui i leih a, A pâwng laite a tla muk a, Ruahtuiin a tinêm a, Thlai thar i chawrtîr ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kum a lo vei chuan a tawntawin thlai i thartîr a, I kalna apiangah chuan a awm rei rui ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thlalêr ram rovahte hnim a duah hluah hluah a, Mualte pawh chu a hring dup mai.
  </para>
  <para style="p">
    <verse number="13" style="v" />Phûlahte chuan ran an tla noh noh va, Ruamahte chuan buh hlîr a tlim hmur mai, Hlima auvin hla an sa.
  </para>
  <chapter number="66" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khawvêl pum puia chêng zawng zawngte u, Pathian chu fak chiam rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />A hming ropui tak hi fak ula, Ropui takin chawimawi rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />“I thiltihte a va mak êm! I chak êm avângin hmêlmate chu an kimki a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi zawng zawngin chibai an bûk a che. I fakna hla sa-in I hming an fak,” Pathian hnênah ti rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lo kal ula, Pathian thiltihte hi han en teh u, Mihring zînga a thil tih mak râpthlâk tak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuipui thûk chu leichâr a chantîr a, Lui chu kêin an kal kai ta. A thiltih avângin, tah chuan kan hlim êm êm a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />A chaknain ro a rêl reng a, Hnamte a enthla reng a ni. Luhlulte chu lo induh mai suh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi zawng zawngte u, kan Pathian hi fak rawh u, Hriat thamin in awte chhuah rawh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dam takin min awmtîr a, Kan tlûkchhiat lah a phal hek lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Pathian, nang chuan min enfiah a, Tangkarua meia an fiah angin Nang chuan min fiah a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thangah min awhtîr a, Manganna chuan min delh ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kan lu chungah mi an chuang a, Mei leh tui lian kan pal tlang bawk, Mahse, hmun chênghnâwngah min dah tâk hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />I inah chuan hâlral thilhlan ka rawn keng ang a, Ka thutiam pawh ka hlen ngei ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka sawi tawh kha ka rawn ti ang, Mangan laia ka sawi ang khân.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ran châwm thau hâlral ka rawn hlân ang che a, Berâm hâl rimtui khute nên, Bâwngpa leh kêlchalte ka hlân bawk ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian ṭihtute u, lo kal ula, ngaithla teh u, A thil min tihsak chu ka hril dâwn e.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ani chu ka au va, Ka leiah hian fak hla a khat.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka thinlunga sualna khawi ka nih chuan Lalpan ka thu a ngaithla lo vang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian chuan ka thu a ngaithla ngei asin, Ka dîlna chu a lo ngaihven tak tak a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathian chu fakin awm rawh se, Ani chuan ka ṭawngṭaina a hlawhchhamtîr lo va, Ka tân a ngilneihna a dai hek lo.
  </para>
  <chapter number="67" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian chu kan chungah ngilneiin Mal min sâwm sela, A hmêl pawh chu kan chungah lo êng rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />I duhzâwng chu khawvêlin a hriata, Hnam tinrêngin i chhandamna an hmuh theih nân.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Pathian, miten fak che sela, Mi tinrêngin fak che rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hnam tin hlima lâwmin au se, Hnam tinrêng chungthu chu dik taka rêlsakin, Mi tin i kaihruai si ṭhîn a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Pathian, mi tinin fak che rawh se, Mi tinrêngin fak che rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leiah hian thlai lo tharin, Pathian, kan Pathian chuan mal min sâwm rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian chuan mal min sâwm sela, khawvêl pum puia mite hian, Pathian chu ṭih rawh se.
  </para>
  <chapter number="68" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian lo thawk sela, hmêlmate darh rawh se, A hmaah chuan amah hawtute chu tlânchhe rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meikhu a zâm darh ang hian lên darh ang che, Mei lum bula khawihnûn a tui ang hian, Pathian hmaah mi sualte chu tui ral rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi dikte erawh chu Pathian hmaah hlimin an lâwm ṭhîn a, Hlim takin an au chêl chûl ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian hnênah hla sa ula, A hming fakin zai ula, Chhûm chunga chuanga tân kawng buatsaih rawh u; A hming chu Lalpa a ni, Amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmun thianghlima chêng kan Pathian chu, Fahrahte tân Pa a ni a, Hmeithaite ngaihtuahtu a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tlahlangte chu chhûngkua a dinsak a, Tângte a hruai chhuak a, an hamṭha ta, Luhlulte erawh chu ram rovah a awmtîr ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Pathian, i mite hma hruaia, Thlalêr rama i kal lai khân,
  </para>
  <para style="p">
    <verse number="8" style="v" />Sinai tlâng Pathian hmaah, Lei a nghîng a, vân aṭangin ruah a lo sûr a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Ruahte i sûrtîr tlâwrh tlâwrh a, I ro, ram châr tawh chu i tiduah leh ta a.
  </para>
  <para style="p">
    <verse number="10" style="v" />I mite chuan awmhmun an khuar ta a, Aw Pathian, i ṭhat avângin retheite i buatsaihsak a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpan thu a pe a, Hmeichhe tam takin chanchin ṭha chu an puang a,
  </para>
  <para style="p">
    <verse number="12" style="v" />“Lalte leh an sipai rualte chu An tlânchhe zêl mai e,” tiin. In nghâk hmeichhiate chuan râllâk sum an insem a,
  </para>
  <para style="p">
    <verse number="13" style="v" />Mei vil mai maite pawhin, Ṭhuro lim, a thla tangkaruaa siam, A thla hmâwr rangkachaka tuam chu an chang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Engkimtitheian lalte a tihdarh khân Zalmon tlângah vûr a tlâktîr.
  </para>
  <para style="p">
    <verse number="15" style="v" />Basan tlâng hi tlâng ropui tak a ni a, Chhîp sâng pui a nei thluah mai.
  </para>
  <para style="p">
    <verse number="16" style="v" />I tlângchhîp aṭangte chuan A chên nâna Pathian duhthlan tlâng hi, Engtizia nge i er mai le? Kumkhuaa Lalpa chênna tûr asin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian tawlailîr sâng tam tak nên, Sinai tlâng aṭangin a hmun thianghlimah chuan Lalpa chu a lo kal e.
  </para>
  <para style="p">
    <verse number="18" style="v" />A tlâng sângah a lâwn chho va, Sal man a hruai duah duah bawk a, Mihringte thilpêk a lo dawng a, Hel hmangte pawhin an rawn hlân ve; Tah chuan Lalpa Pathian a chêng tawh ang.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa chu fak rawh u, Min chhandamtu kan Pathian hian, Ni tin kan phurritte min chhâwk ṭhin hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kan Pathian hi chhandam ṭhîntu Pathian a ni a, Kan Lalpa hi Lalpa , thihna ata min humtu a ni e.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathian chuan hmêlmate lu a vaw keh ang, Suahsual chîng lu chhîp bukte chu.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Basan ram aṭangin in hmêlmate ka rawn hruai ang a, Tuifinriat mawng ata ka rawn khâwm ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />An thisen chu in dai ang a, In uite chuan an duh tâwk an liak ang,” Lalpan a ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aw Pathian, i lo kal kha mi tinin an hmu che, A hmun thianghlim pana ka lal, Ka Pathian kal chu.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hla sa pâwlten hma an hruai a, A hnung lamah ṭingṭang tum miten an zui a, A laiah chuan nula rualin benchhek an bêng.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Pungkhâwm zîngah Pathian chu fak ula, Jakoba thlahte u, Lalpa chu fak rawh u,” an ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />A hnam tlêm ber Benjamin chu hmahruaitu an ni a, Juda hnam puipaten an dawt a, Zebulun leh Naftali hruaituten an zui leh a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aw Pathian, kan tân thil mak min tihsak ṭhinna, I thiltihtheihna kha han tilang teh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jerusalem khuaa i tempul aṭangin, Lalten thilpêk an rawn pêkna hmun aṭang khân.
  </para>
  <para style="p">
    <verse number="30" style="v" />Phairuang hmuna awm ṭhîn sa hrâng Aigupta khu zilh la, Khu hnam, bâwng kawlh leh an note awm khâwm khuan, Tangka duhin mi an chîl a. Indo châkho khu ûm darh rawh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aigupta ram aṭangte chuan palai an lo kal ang, Kus mite pawh Pathian hmaah an kut an rawn phar ang.
  </para>
  <para style="p">
    <verse number="32" style="v" />Khawvêla lalramte u, Pathian hnênah hla sa ula, Lalpa fakna hla sa rawh u.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hmasânga awm, Vân chunga chuanga chu, Ring takin a au ve, ngaithla rawh u.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pathian thiltihtheihzia puang chhuak ula, A ropuina, Israel-te chungah a awm ṭhîn a. A chakna chu vânah a awm a ni.
  </para>
  <para style="p">
    <verse number="35" style="v" />A hmun thianghlima awm Israel-te Pathian chu ṭih tûr a ni, A mite chu chakna leh thiltihtheihna a pe a, Pathian chu fak rawh u.
  </para>
  <chapter number="69" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, min chhan chhuak rawh, Tuite chuan min chîm pil lek lek a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Chirhdûpah chuan ka tâng ta a, Rah chhan tûr rêng a awm si lo. Tui thûkah chuan ka awm ta a, A fâwnah chuan ka pil dâwn hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ṭanpui dîla ka auna lamah chuan ka chau ta a, Ka dangte pawh a ro zo va, Pathian thlîrin ka mit a vai zo ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Chhan awm lova min hawtute chu Ka sam aiin an tam tâk hi. Mi chak pui puite chuan mi nuai bo an tum a, Dâwta min bei ṭhîntute chuan Ka rûk loh pawh min pêk kîrtîr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw ka Pathian, ka âtzia hi i hre vek a, Ka thiam lohnate i lakah thup a ni hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa , Engkim Lalpa , Keimah avângin nangmah nghâktute chu zak suh sela, Israel-te Pathian, Keimah avângin nangmah zawngtute chu mualpho suh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangmah avângin hau ka tuar a, Men ngaihna pawh ka hre ta lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka unaute tân mikhual ang ka ni a, Ka pianpuite tân pawh ram dang mi ang ka ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />I in tâna ka ṭhahnemngaihna chuan Mi luah tlat a, An chêksawlhna che chu Ka phur zêl ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ṭapa chaw ka nghei leh miten min hmusit zui a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Saiip puan ka sin leh min nuihzat a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kulh kawngkhâra ṭhuten min rêl zui a, Zu ruite chuan hlaah min chham.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei zawng, Lalpa , i hnênah chuan ka ṭawngṭai ang, Ṭha i tih hunah mi chhâng ang che. Aw Pathian, i ngilneihna nasa tak leh I chhandamna rin tlâk tak chuan min chhâng ang che.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chirhdûp ata min chhan chhuak la, Ka pil mai chu phal suh ang che. Min hawtute leh tui thûk tak ata chu Min chhan chhuak bawk ang che.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tui lian chu min len botîr suh la, Tui thûkah ka tlâk phal lo la, Thlân kotlângah min liamtîr suh ang che.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa , i ngilneihna a ṭha si a, min chhâng ang che, I lainatna nasa tak chu ka chungah lantîr ang che.
  </para>
  <para style="p">
    <verse number="17" style="v" />I chhiahhlawh lakah hian i hmêl thup suh, Ka mangang êm a ni, min chhâng thuai rawh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lo kal hnai la, min tlan ang che, Hmêlma lakah min chhan chhuak rawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Min chêksawlh dânte hi nangin i hre reng a, Ka zahzia te, ka mualpho dânte pawh Ka hmêlmate i hmu vek bawk.
  </para>
  <para style="p">
    <verse number="20" style="v" />Min hmuhsitna chuan ka lung a tichhia a, Na ka ti êm êm a ni. Khawngaih ka beisei a, tu man min khawngaih lo, Thlamuantu tûr tu mah ka hmu zo lo.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka ei tûrah tûr an pawlh a, Ka tuihâl chu zu ṭâwng min pe.
  </para>
  <para style="p">
    <verse number="22" style="v" />An ruai ṭheh chu chhiat phah sela, An inremna ruai pawh chu an tân fal chang rawh se.
  </para>
  <para style="p">
    <verse number="23" style="v" />An mitte chu tihdelsak la, Eng mah hmu thei suh se, An kâwngte chu khûr zawih zawih bawk rawh se.
  </para>
  <para style="p">
    <verse number="24" style="v" />I thinurna chu an chungah leih la, I thinrimna chuan nangchîng rawh se.
  </para>
  <para style="p">
    <verse number="25" style="v" />An chênna chu ram sela, An puan inah tu mah chêng hek suh se.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nangin vuak i tuartîrte chu an sawisa a, Hliam i tuartîrte natzia chu sawi nuam an ti.
  </para>
  <para style="p">
    <verse number="27" style="v" />I hremna tûr chu tihpunsak la, I chhandamna chu chang ve suh se.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nunna bu ata chu an hming thai chhia la, Mi dikte zîngah chuan an hming ziak suh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kei zawng na tuarin ka rûm hi, Aw Pathian, min chhan la, Hmun râlmuangah min hlâng ang che.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pathian hming chu fakin ka zai ang a, Lâwmthu hrilin ka chawimawi ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa tân chuan ran hlan aiin chu chu a ṭha, Bâwngchal, ki leh tin sei tak nei hlan ai pawhin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tihretheihten an hmuh hun chuan an lâwm ang a, Pathian zawngtu thinlung chu a nung thar ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Retheite thu Lalpan a ngaithla a, A ni, saltângte chu a zahpui lo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lei leh vânten amah fak rawh u, Tuifinriat leh a chhûnga chêngte chuan fak rawh u.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pathian chuan Zion khua chu a hum ang a, Judai ram khuate chu a din leh ang. A mite chuan an luah ang a, Ram chu an nei tawh ang.
  </para>
  <para style="p">
    <verse number="36" style="v" />A chhiahhlawh thlahte chuan an rochung ang a, A hming ngainatute chu tah chuan an chêng bawk ang.
  </para>
  <chapter number="70" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, min chhan chhuak thuai la, Lalpa , min rawn ṭanpui ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Min thah tumtute chu mualphovin mangang sela, Ka chhiatna chunga lâwmte chu Zak takin tlânchhe rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Chei! Chei!” min tihkhumtute chu Zak tak maiin tlânchhe rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nangmah zawngtu zawng zawngte chu Hlimin au dur dur rawh se. I chhandamna ngaitute chuan “Pathian chawimawi rawh u,” ti fo rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kei pachhia leh rethei tak hi, Aw Pathian, min rawn pan thuai ang che. Min puitu leh chhandamtu i ni, Lalpa , muangchâng lul suh ang che.
  </para>
  <chapter number="71" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , i hnênah chuan ka lo tlulût ta a, Engtikah mah mualpho takin min awmtîr suh ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi fel i ni a, min chhan chhuak la, min hum ang che, I beng chhi la, min chhandam rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka awm nân lungpui nghet ni la, I thu angin lo kal ngei rawh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw ka Pathian, mi sual kut ata min chhan chhuak la, Mi suaksual leh mi nunrâwng kut ata chu.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , nang chu ka thlîr ber i ni ṭhîn a, Lalpa , ka tleirâwl chhuah ata ka ring che a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka pian tirh aṭangin ka rinchhan ber i ni a, Ka nu pum chhûng ata min lachhuaktu i ni. Ka fak kumkhua ang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi tam tak thlîr rawn ka ni a, Mahse, ka tân tlûkluhna nghet tak i ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Eng lai pawhin ka fak fo ṭhîn che a, Ni tin ka chawimawi ṭhîn che a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka lo tar ta a, min hnâwl suh la, Ka lo chak lo ta a, min thlahthlam suh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka hmêlmaten ka chungthu an sawi a, Min vehtute an inrâwn khâwm.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Pathian pawhin a kalsan ta, I ûm ang u, kan man dâwn nia, Chhantu tûr rêng a nei lo ve,” an ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Pathian, min hlat lul suh, Aw ka Pathian, min rawn ṭanpui thuai rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Min beitute chu chauvin mualphovin mangang sela, Ka chhiatna tûr zawngtute chu Zakin mangang hle rawh se.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kei chuan nangmah chauh hi ka beisei i ni a, Ka fak deuh deuh vang che.
  </para>
  <para style="p">
    <verse number="15" style="v" />I dikzia hi mi tin hnênah ka sawi ang a, Ka hril sêng lo nâng a, I chhandamna thu chu ka puang bawk ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa , i ropuizia ka puang ang a, Lalpa , i dikzia chauh hi ka hril ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Pathian, ka tleirâwl chhuah ata min zirtîr a, Tûn thleng pawhin i thil mak tih ka hril zêl ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka lo tarin ka lu a ṭuak ta a, Aw Pathian, min kalsan suh. I ropuizia leh i thiltihte hi, Ṭhangthar lo awm tûrte Ka hrilh hma chu min awmpui rawh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Pathian, i dikna chuan vân khi a tawng, Thil ropui tak i tih ṭhin hi, Nangmah ang hi tu mah rêng an awm lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Manganna leh thil ṭha lo tam tak min tuartîr a, Mahse, nangin min tiharh leh ṭhîn a, Khur thûk ata min la chhuak ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Min chawisâng lehzual sauh ang a, Min thlamuan leh dâwn e.
  </para>
  <para style="p">
    <verse number="22" style="v" />Perhkhuang tumin ka fak ang che a, I rinawmzia, aw ka Pathian, ka fak bawk ang. Israel Mi Thianghlima chu, ṭingṭang nên ka fak ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Min chhandam avângin Ṭingṭang tuma lâwmin ka au chiam ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />I dikzia chu nilêngin ka sawi ang a, Mi tihchhiat tumtute an mualpho ta si a.
  </para>
  <chapter number="72" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, i rorêl thiamna chu lal hi pe la, I dikna pawh pe bawk ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />I mite chungthu hi fel taka a rêl theiha, Mi retheite ro pawh dik taka a rêl theih nân.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tlângten malsâwmna thlen sela, Mualten dikna thlen bawk rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi retheite ro chu dik takin rêl sela, Pachhiate pawh chhan ṭhîn sela, Hnehchhiahtute erawh chu sawisa hrep rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ni leh thla khi a ên chhûng chu, Chhuan tam tak thlengin ṭih che rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnim chunga ruahsûr ang ni se, Lei ro chunga ruahpuivânâwn a sûr ang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A dam chhûngin dikna hi lal sela, Thla khi a ên chhûng chu malsâwmna pung rawh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ram chuan tuifinriat râl kai sela, Khawchhak luipui aṭang khian kâwlkil khu thleng rawh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thlalêra chêngte chuan chibai rawn bûk sela, A hmêlmate a hmaah chuan bawkkhup rawh se.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tarsis lal leh thliarkâra lalte chuan, Lâwmman rawn hlân sela, Arab lal leh Seba lalte pawhin Thilpêk rawn keng rawh se.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lal zawng zawngte a hmaah kûn sela, Hnam tinrêngin a rawng rawn bâwl rawh se.
  </para>
  <para style="p">
    <verse number="12" style="v" />Manganga aute chu a chhan ang a, Chhantu nei lo retheite pawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Retheite leh pachhiate chu a khawngaih ang a, Mangangte nunna chu a humhim ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nêkchêpte leh râwng taka sawisakte a hum ang a, An nunna chu a tân a hlu a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lal chu dam reng sela, Seba ram rangkachak rawn pe rawh se. Ṭawngṭaisak fo sela, Malsâwmna pawh dawng reng rawh se.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ram pum puiah a tawntawin buh hâwng sela, Lebanon tlânga thei a rah tup ṭhîn angin Tlâng chhîpahte rah tiar tuar bawk rawh se. Ram ṭhaa hnim a bit angin, Khuaahte chuan mi khat rawh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kumkhua pawhin a hming a dai lo vang, Ni khi a ên chhûng chu a hming thang zêl rawh se. Hnam tinrêngin a zâr zo se, Duhsak rawh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpa Pathian, Israel-te Pathian chu fak ula, Ani chauh hian a ni, hêng thil mak hi ti ṭhîn ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hming ropui tak chu chawimawi kumkhua ula, Lei pum pui hi a ropuina chuan khat rawh se. Amen, Amen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesaia fapa Davida ṭawngṭaina chu a tâwp ta.
  </para>
  <chapter number="73" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel-te chungah hian Pathian a lo ṭha ngei mai e, Thinlunga thianghlimte chungah chuan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kei chuan ka ringhlel lek lek ṭhîn a, Ka tlu ṭhelh ṭhelh fo mai.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi sualte vânneihzia ka han hmuh hian, Chapote chu ka awt hle ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />An thih pawhin na an tuar lo va, An thau mûm kûng bawk si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mite angin an thawk rim ve lo va, Mi dang tuar ang hrehawm an tuar hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />An chapo êm êm a, An nun a râwng êm êm bawk.
  </para>
  <para style="p">
    <verse number="7" style="v" />An thau avângin an mit a pâwng a, An duhsâm chuan chin lêm a nei hek lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi dang an nuihzat a, thil sual an sawi ṭhîn a, Chapo takin mi dang an vau bet a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vâna Pathian tlukin an insawi a, An thuin mihringte an hneh zêl a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian mite meuh pawhin an lam an hawi a, An sawi apiang an awih zêl a.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Pathianin a hre lo vang, Chungnungberan a hmu hek lo vang,” an ti.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hei hi mi sualte awm dân chu a ni: An awm der der a, an hausa tulh tulh si.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka lo invawng thianghlim thlâwn mai em ni? Thil sual eng mah ka khawih lo chung hian,
  </para>
  <para style="p">
    <verse number="14" style="v" />Nilêngin ka tuar ṭhîn a, Tûk tina min zilh ṭhin hi?
  </para>
  <para style="p">
    <verse number="15" style="v" />“An tih angin ka ti ve ang,” ti ila chuan, I fa, tûnlai mite hi ka bum a ni dâwn si.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hêng hi hriatthiam ka han tum ṭhîn a, Harsa ka ti ngei mai.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mahse, Pathian hmun thianghlima ka han luh chuan, An tâwp dân tûr ka hmu chiang ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hmun nâl takah i dah reng a lo ni a, Chhiatnaah chuan an tlulût ngei ngei dâwn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mit khap kâr lek chhûngin an ral ang a, Râpthlâk takin an chhe vek ang.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zînga mumang ral ta ang hi an ni, Lalpa , nang meuh i lo thawh chuan, I tân hlimthla ang lek an ni.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka lung a chhiat hlea, Ka thin a nat êm êm lai chuan,
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka rilru a buai a, ka hrethiam thei lo, I hmaah chuan ramsa ang mai ka ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mahse, i bulah chuan awm ka chuh tlat a, Ka kut ding lam hi min lo chelhsak ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nangin min fuihin, min kaihruai a, Nakinah chuan ropui takin min lo lâwm ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang lo chu vânah khian tu nge ka neih? Leiah pawh hian nang lo chu tu mah duh ka nei lo ve.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka taksa leh ka rilru hi a lo chau ṭhîn a, Mahse, Pathian chu ka tân lungpui nghet tak a ni, Ani chu eng lai pawhin ka awmna tûr a ni.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nangmah hlattute erawh chu an ral ang a, Nangmah tlânsantute chu i tiboral ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Keia tân zawng Pathian hnaih hi a ṭha a ni, Lalpa Pathian chu tlûkluh nân ka hmang a, A thil mak tih zawng zawng hi ka hril zêl ang.
  </para>
  <chapter number="74" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, engtizia nge min kalsan tâk daih a, I rama mite ngei chungah i thinur reng dâwn em ni?
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmasâng ata i mi tûra i neihho, I rochan, i tlan hnamte hi, I chênna ṭhîn Zion tlâng nên han hre reng ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />A chhe rem rum tawh chu han tlawh la, Hmêlmate chuan i hmun thianghlim an tihchhiat zawh tâk hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />I mite punkhâwmnaah hmêlmate chu an haw haw dur dur a, An puanzârte chu an târ thluah mai.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngawpui ṭhiat tûr ang maiin, An hreikawl chu an lek tâk hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thing suih mawi zawng zawngte, Hrei leh tubohvin an chhu chhe ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />I hmun thianghlim an hâl chim a, I chênna hmun chu an tibawrhbâng zo ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Min tihdarh vek an rilrûk a, Kan ram chhûnga Pathian biakna hmun apiang chu, An hâl zêl mai.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kan hnam puanzâr târ hmuh tûr a awm lo va, Zâwlneite lah an awm tawh lo, Engtia rei nge hetia kan awm dâwn Hria pawh kan awm ta lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Pathian, hmêlmate hian eng chen nge an deu ang che? I hming an hmusit reng dâwn em ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Engtizia nge i kut i lâk kîra, I kuangkuah tâk tlat le? Tiboral hlawm rawh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Pathian, hmasâng ata kan Lal i ni, Leia i mite chhandam ṭhîntu i ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuifinriat chu i chaknain i tiṭhen a, Tuipui chhûnga rûlpui lu chu i tikeh ta,
  </para>
  <para style="p">
    <verse number="14" style="v" />Leviathan lu i chhu keh bawk. Thlalêra chêngte ei atân a sa i pe.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuihna i chhun chhuak a, a luankawr i siam a, Luipui luang laite chu i tikang bawk.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chhûn leh zân hi i ta a ni a, Êntu leh ni te khi i dah a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leilung ramri i kham chhuak a, Nipui leh thlasik hi i siam a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpa , hmêlmate deuna hi hre reng ang che, Hnam â-te chuan i hming an sawichhiat hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sakawlhho kutah chuan i mite hi pe suh ang che, I mi, retheite hi theihnghilh reng suh.
  </para>
  <para style="p">
    <verse number="20" style="v" />I thuthlung kha ngai pawimawh la, Ram chhûnga hmun thim laite chu Nunrâwnnain a khah tâk hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hnehchhiahte chu mualpho takin awmtîr suh la, Pachhiate leh retheite chuan i hming hi fak rawh se.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aw Pathian, lo thawk chhuak la, I thu han kengkawh teh, Mi â-te chuan ni tin an deu che hi hre reng ang che.
  </para>
  <para style="p">
    <verse number="23" style="v" />I hmêlmate thâwm hi theihnghilh suh la, Nangmah beitute au thâwm chu a rîk hluah hluah reng hi.
  </para>
  <chapter number="75" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, lâwmthu kanhrilh a che, I lo hnaih avângin lâwmthu kan hrilh a che. I thiltih ropui takte chu kan hril ṭhîn e.
  </para>
  <para style="p">
    <verse number="2" style="v" />“A hun ka ruatah chuan Dik takin ro ka rawn rêl ang,
  </para>
  <para style="p">
    <verse number="3" style="v" />Lei leh a chhûnga awmte sîksawi mah se, Kei hian a innghahna ka phûm a ni,” Lalpan a ti.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Chapote u, inchhuang suh u, Mi sualte u, inluling sú.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vâna awma lakah indahsâng lo ula, Dâk âwr chungin ṭawng thâwr thâwr hek suh u,” ka ti.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chhak leh thlang aṭangin emaw, Chhim leh hmâr aṭangin emaw, Rorêlna hi a lo thleng si lo va.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rorêltu chu Pathian a ni: Ṭhenkhat a titlâwm a, ṭhenkhat a chawimawi ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpan a thinurna no chu a keng reng a, Uain chi tinrêng chawhpawlha khat a ni, a phûl pâwng thûr mai, Chu chu a bun chhuak a, Mi sualte chuan an in ta a, A mawngnawi lam an lem zo vang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kei chuan chatuanin ka chawimawi ang a, Jakoba Pathian chu fakin ka zai ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sual thiltihtheihna a tichhia ang a, Mi dik thiltihtheihna erawh chu a pung zêl ang.
  </para>
  <chapter number="76" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judai ram chuan Pathian an hria a, Israel-te chuan a hming an chawimawi ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jerusalem-ah chuan a awm a, Zion-ah chuan a chêng a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tah chuan hmêlma thalte leh, An phaw leh khandaihte, An râlthuamte a tihchhiatsak a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Pathian, i ropui e, Hmêlma i hnehna tlâng ata i lo haw chu i ropui ngei mai e.
  </para>
  <para style="p">
    <verse number="5" style="v" />An mi huaite râlthuam an hlihsak vek a, An thal ta rem rum mai! Mi chak tu mah kut lek thei an awm ta lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jakoba Pathian, nangin i han hau chuan, Sakawr leh a chungchuangte chu an thal dêr mai.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang zawng, i lo hlauhawm ngei mai, I thinurin i hmaah chuan tu nge ding ngam awm ang?
  </para>
  <para style="p">
    <verse number="8" style="v" />Vân aṭanga i thu rêl chu i rawn puan chuan, Lei chu hlauvin a ngawi reng a;
  </para>
  <para style="p">
    <verse number="9" style="v" />Khawvêla mi retheite chhan tûra, Rorêla i lo thawh chhuah lai khân.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi kawlhsente chuan an la fak ngei ang che a, I thinurna pumpelhte chuan an bêl ang che,
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa , in Pathian hnêna in thutiam chu hlen ula, A vêla awmte chuan Hlauhtûra hi An thilpêkte rawn hlân rawh se.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hruaitute chapona a tihtâwpsak a, Lei lalte tân hlauhawm tak a ni.
  </para>
  <chapter number="77" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw chhuah meuhvin, Pathian chu ka ngên ang a, Ka au vang a, ka aw a lo hria ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mangan laiin Lalpa chu ka zawng a, Bân phar chungin ka ṭawngṭai zânkhua ṭhîn, Mahse, ka thla a muang thei lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian ka ngaihtuahin ka rûm ṭhîn a, Ka suangtuahin ka chau hnêp ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi timuhîl thei lo va, Ka vei ka vei ṭhîn a, sawi tûr rêng ka nei lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmânlai ka ngaihtuah a, Hun liam ta zawng zawng ka hre chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zânah ka ngaihtuah neuh neuh va, Ka dâwn vêl a, ka inkhâpthlu dêr ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpan min thlauhthla reng dâwn em ni le? Ka chungah hian a lâwm dâwn tawh lo em ni aw!
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi khawngaih tawh lovin, A thutiam kha a titâwp hlen dâwn em ni?
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathianin min lainatna kha a theihnghilhin, Thinur vângin a ngilneihna a titâwp dâwn em ni?
  </para>
  <para style="p">
    <verse number="10" style="v" />Chungnungbera kut chuan ngai a ang ta lo hi, Ka thin tinatu ber chu a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa thiltihte chu ka hre reng ang a, Hmasânga thil mak tak tak a tihte pawh ka hre reng ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />I thiltih ṭhinte chu ka ngaihtuah fo vang a, Thil ropui tak i tihte pawh ka chhui bawk ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Pathian, i kawng chu a thianghlim a, Nangmah ang rênga ropui hi pathian an awm lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang zawng thil mak ti ṭhîn Pathian i ni a, I chakzia hi hnam tin i hriattîr ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />I bân chak chuan i mite chu i tlan a, Jakoba leh Josefa thlahte chu.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw Pathian, tuite chuan an hmuh che chuan, An hlau va, tui thûkte pawh an khûr.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chhûmin ruah a sûrtîr ṭhîn a, Vân aṭangin khawpui a ri dur dur bawk a, Kâwlphete chu a de zawr zawr a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ṭhâwngaleivirah chuan khawpui chu a ri a, Khawvêl hi kâwlphe chuan a ên chhuak a, Lei chu a nghîng dawt dawt a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuipuiah chuan i kal ṭhîn a, Tuifinriat pawh i fang chhuak a, Mahse, i hniak hmuh tûr a awm si lo.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosia leh Arona kut hmangin I mite chu berâm angin i kaihruai ṭhîn.
  </para>
  <chapter number="78" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka mite u, ka zirtîrna hi ngaithla ula, Ka thute hi lo ngaihven rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tehkhin thu ka sawi ang a, Hmasâng thu rilte chu ka phuh chhuak dâwn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kan ngaihthlâk ṭhin, kan thu hriat te, Kan pi puten min hrilh ṭhin kha,
  </para>
  <para style="p">
    <verse number="4" style="v" />An fate hnênah chuan kan zêp lo vang, Lalpa ropuina leh a chakna te, Thil mak a tih ṭhin thute kha kan hril zêl ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakob-ho chu hriat tûr a siamsak a, Israel-ho tân dân chu a pe; An thlahte hrilh chhâwng zêl tûrin, kan pute chu thu a pe bawk;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ṭhang lo thar zêlte chuan an zir theiha, La piang tûrte pawhin an fa leh te An zirtîr chhâwn tûrin.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian chu an rina, a thiltihte theihnghilh lova, A thupêkte an zawm theih nân.
  </para>
  <para style="p">
    <verse number="8" style="v" />An pi pute anga awm tûr an ni lo va, Luhlul chhuaha hel chîng, Thinlung nghet lo, Pathian laka Rinawm lo an nih ve loh nân.
  </para>
  <para style="p">
    <verse number="9" style="v" />Efraim-ho chu thal nên an inthuam a, Inbeih ni chuan an tlânchhiat kha.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian thuthlung an zâwm lo va, A Dân angin an awm duh lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />A thiltihte an theihnghilh a, Thil mak a hmuhtîrte an hre reng lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aigupta ram Zoan phaiah An pute hmuh atân thil mak tak tak a ti.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuipui a tiṭhen a, a kal kaitîr ta a, Tui chu bang ang maiin a dintîr kha.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chhûnah chhûmin a hruai ṭhîn a, Meialh êngin a hruai zankhua bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thlalêrah khân lungpui a vaw khi a, Luipui tui anga tam tui a pe a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lungpui ata tui a luan chhuahtîr chu Luipui angin a luang ta dur dur a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chuti pawhin a lakah chuan an sual lui a, Thlalêrah khân Chungnungbera lakah an hel.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian an fiah ta ngat mai a, An ei châkzâwng an dîl.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian an sawi hnâwm a, “Thlalêr rovah Pathianin ruai a ṭheh thei dâwn em ni?
  </para>
  <para style="p">
    <verse number="20" style="v" />Lungpui vuain tui a luan chhuahtîr ngei a, Chaw meuh min pe thei dâwn em ni? A mite hi sa a pe thei ang emaw chu!” an ti.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpan a han hriat chuan a thinur a, Jakoba chungah chuan mei a thawh a, Israela chungah chuan a thinur chu a na ta hle a ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian an ring lo va, A chhan theiin an ring hek lo.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mahse, chung lam vân khi thu a pe a, Vân kawngkhârte a hawng a,
  </para>
  <para style="p">
    <verse number="24" style="v" />An ei atân mana a sûrtîr a, Vân chaw a pe ta a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihring mai chuan vântirhkohte chaw an ei ta a, Hnianghnar taka ei tûr a pe a ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khawchhak ata vâna thli a tlehtîr a, A thiltihtheihnain chhim thli a hâwntîr bawk.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vaivut angin sa a sûrtîr a, Tuifinriat ṭiau anga tam sava a pe.
  </para>
  <para style="p">
    <verse number="28" style="v" />An bûk tualah a lo tla a, An chênna bûk bul maiah chuan.
  </para>
  <para style="p">
    <verse number="29" style="v" />Duh tâwkin an ei a, an tlai hle a, An châk ngei chu a pe a ni.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sa ṭhial ṭawn ṭawn chungin Phunnawi an bâng chuang lo.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian an chungah chuan a thinur a, An ṭhalaite a thahsak a, Israel tlangvâl chhuanvâwrte chu an thi zo ta.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chuti pawhin an sual lui zêl a, A thil mak tih an hmu na a, amah an ring duh chuang lo.
  </para>
  <para style="p">
    <verse number="33" style="v" />An dam chhûng nite chu ho takin a tiral a, An dam chhûng kumte pawh râpthlâk takin a liam.
  </para>
  <para style="p">
    <verse number="34" style="v" />A thah hnu chuan amah an zawng ṭan leh ta a, Sima ṭhahnemngaiin Pathian lam an hawi ta.
  </para>
  <para style="p">
    <verse number="35" style="v" />An himna lungpui chu Pathian a nih an hre chhuak a, Anmahni tlantu chu Chungnungbera a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mahse, an hmuiin an bum a, An leiin dâwt an hrilh bawk si.
  </para>
  <para style="p">
    <verse number="37" style="v" />An thinlung chu a nghet lo va. A thuthlungah an rinawm bawk hek lo.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ani lah chuan a khawngaih a, An bawhchhiatna a ngaidam a, a tiboral lo, A thinur chu a insûm fo ṭhîn a, A thin thawk chu a che duh mai ngai lo.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mihring chak lo an nih a hre reng a, Thli tleh liam ang lek hi an ni si a.
  </para>
  <para style="p">
    <verse number="40" style="v" />Thlalêrah khân an hel fo va, Ram rovah khân a thin an va tina zing em!
  </para>
  <para style="p">
    <verse number="41" style="v" />Pathian an fiah an fiah mai a, Israel-te Mi Thianghlima chu an timangang.
  </para>
  <para style="p">
    <verse number="42" style="v" />A thiltihtheihzia kha an hre reng duh lo va, An hmêlmate laka a chhan laite kha an hre duh bawk hek lo.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aigupta ram Zoan phaia A thil mak tih ropui tak kha an hre reng lo.
  </para>
  <para style="p">
    <verse number="44" style="v" />An luite chu thisenah a chantîr a, Lui tui tu man an in thei lo.
  </para>
  <para style="p">
    <verse number="45" style="v" />Thosi a puantîr a, a seh nek a, Chungu a tipung a, an ramah chuan a khat.
  </para>
  <para style="p">
    <verse number="46" style="v" />An thlaite chu khau rual a eitîr a, An hnathawh rah a ngêt zo bawk.
  </para>
  <para style="p">
    <verse number="47" style="v" />An grep hruite rialin a chhu chat a, An theipui kûngte chu vûrin a hmet hlum bawk.
  </para>
  <para style="p">
    <verse number="48" style="v" />An rante chu rialin a chhu hlum a, An ran rualte ṭêkin a dêng hlum bawk.
  </para>
  <para style="p">
    <verse number="49" style="v" />An chungah chuan a thinurna râpthlâk tak chu A leihbua a, a sawisa ta nek a, Chûng chu an chhiatna thlen tûra a tirh an ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />A thinur hrîkthlâk nân an nun a zuah lo va, Hripui a lêntîr kha.
  </para>
  <para style="p">
    <verse number="51" style="v" />Aigupta mite fa tîr chu a that vek a, An in chhûnga sei lian an vânglai fate chu.
  </para>
  <para style="p">
    <verse number="52" style="v" />A mite chu berâm angin a hruai chhuak a, Thlalêrah chuan a kalpui ta.
  </para>
  <para style="p">
    <verse number="53" style="v" />A hualhim a, hlauh rêng an nei lo va, An hmêlmate erawh chu tuiin a chîm pil ta.
  </para>
  <para style="p">
    <verse number="54" style="v" />A ram thianghlimah chuan a hruai thleng a, He tlângram, a kut ngeia a lâkah hian.
  </para>
  <para style="p">
    <verse number="55" style="v" />An hmaah chuan hnam dangte chu a hnawt chhuak a, Israel-te neih atân an ram chu a sem a, An inte chu an luah ta a.
  </para>
  <para style="p">
    <verse number="56" style="v" />Pathian, Chungnungbera an fiah leh a, an hel ta a, A thu hriattîr an zâwm duh lo.
  </para>
  <para style="p">
    <verse number="57" style="v" />An hawi kîr a, an pute ang bawkin vervêk takin an khawsa a, Thalngul kawi ang an ni, rin tlâk an ni ta lo.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hmunsâng an siamte chuan an tithinur ta a, An milem chherte chuan a thin an titâwt.
  </para>
  <para style="p">
    <verse number="59" style="v" />Chûng chu a han hmuhin Pathian a thinur a, Israel-te chu a ten ta êm êm a.
  </para>
  <para style="p">
    <verse number="60" style="v" />Silo hmuna a chênna ṭhin chu a rauhsan ta a, Mihring zînga a chênna in ṭhîn chu.
  </para>
  <para style="p">
    <verse number="61" style="v" />A chakna leh a ropuizia lanna Thuthlung Bâwm chu, Hmêlmate a mantîr a.
  </para>
  <para style="p">
    <verse number="62" style="v" />A mite chu khandaihin a sâmtîr a, A rochante chungah a thinur a ni.
  </para>
  <para style="p">
    <verse number="63" style="v" />Tlangvâlte chu an kâng hlum zo va, Nulate chuan pasal tûr an nei lo.
  </para>
  <para style="p">
    <verse number="64" style="v" />Puithiamte pawh khandaihin an that a, An nupuiten an ṭah ngam lo.
  </para>
  <para style="p">
    <verse number="65" style="v" />Mi chak, zu rui muhîl anga, Ngawi renga a awm chu a lo harh a.
  </para>
  <para style="p">
    <verse number="66" style="v" />Hmêlmate chu a ûm lêt a, A timualpho ta vek a ni.
  </para>
  <para style="p">
    <verse number="67" style="v" />Josefa thlahte chu a hnâwl ta a, Efraim hnamte chu a thlang ta lo,
  </para>
  <para style="p">
    <verse number="68" style="v" />Juda hnam chu a thlang ta a, A ngaihnat tak Zion tlâng nên.
  </para>
  <para style="p">
    <verse number="69" style="v" />Vâna a chênna ang hmun thianghlim chu a sa ta a, Nghet taka leia hûn angin Kumkhuaa awm tûrin a hûng nghet ta.
  </para>
  <para style="p">
    <verse number="70" style="v" />A chhiahhlawh Davida chu a thlang ta a, Ran rual vêng lai a la chhuak a.
  </para>
  <para style="p">
    <verse number="71" style="v" />Berâm no hruai a enkawl lai chu, A rochan Israel-te leh Jakob-ho châwmtu atân a ruat ta a.
  </para>
  <para style="p">
    <verse number="72" style="v" />Theihtâwp chhuahin a enkawl a, Thiam takin a kaihruai ta a ni.
  </para>
  <chapter number="79" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, hnam dangini ram ro an rûn a, I tempul thianghlim pawh an tihbawrhbân tâk hi. Jerusalem khua chu a chim rem rum ta mai!
  </para>
  <para style="p">
    <verse number="2" style="v" />I chhiahhlawhte ruang chu Mulukawlhte eiah an hnutchhiah a, I tâna inserhte sa pawh ramsate tlan atân.
  </para>
  <para style="p">
    <verse number="3" style="v" />I mite thisen chu tui ang maiin an luantîr a, Jerusalem khawlaiah chuan a luang zuih a, Phûmtu tu mah an awm lo ve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kan bula awmte chuan min diriam hle a, Kan vêla awmte chuan min nuihzatin min hmusit a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , eng chen nge maw i thinur anga, I thinrim chu mei anga sa a nih reng dâwn?
  </para>
  <para style="p">
    <verse number="6" style="v" />I thinur chu nangmah hre lo hnamte chungah, I hming lam lohna ramahte chuan leih rawh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakoba chhûngte chu an that zo va, An khuate chu an tiram zo ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kan pute sual mawh min phurhtîr suh la, I ngilneihzia han lantîr thuai ang che. Kan chan a chauh tak êm hi le.
  </para>
  <para style="p">
    <verse number="9" style="v" />Min chhandamtu Pathian, min rawn pui la, I hming ropui avângin min chhandam la, I hming avângin min ngaidam rawh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnam dangte chuan engtizia nge “I Pathian chu khawiah nge?” min tih chhên le? I chhiahhlawhte thisen chhuahtu hnam chungah chuan, Kan hmuh ngeiah phuba han la ang che.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lung in tângte rûm chu i hnên lo thleng sela, I chakna ropui chuan, thi tûra tihte chu chhan chhuak ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , kan chhehvêla chêngten an chêksawlhna che chu, A lêt sarih ngawtin rûl rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keini hi zawng i ta kan ni, i rama tla i berâm rualte chu, Lâwmthu kan hrilh kumkhua ang che, Eng lai pawhin kan fak ang che.
  </para>
  <chapter number="80" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel-te vêngtu, i beng lo chhi ang che, Berâm anga Josefa hruai ṭhîntu, lo ngaithla teh, Cherub-ho chunga ṭhu i hmêl êng chu:
  </para>
  <para style="p">
    <verse number="2" style="v" />Efraim te, Benjamin te, Manase hnamte chungah chuan han tilang la, I chakzia chu han lantîr rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Pathian, min din leh la, I hmêl êng chu min hmuhtîr rawh. Tichuan, kan him dâwn nia.
  </para>
  <para style="p">
    <verse number="4" style="v" />Engkim Lalpa , Pathian, eng chen nge I mite ṭawngṭaina hi i thinursan dâwn le?
  </para>
  <para style="p">
    <verse number="5" style="v" />Chaw atân mittui i rintîr a, No lian puiin i intîr hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kan vêla awmte chuan neih tumin min chuh a, Kan hmêlmaten min nuihzat hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Engkim Pathian, min din leh la, I hmêl êng chu min hmuhtîr rawh, Tichuan, kan him dâwn nia.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aigupta rama mi grep hrui bul i pawt chhuak a, Hnam dangte ûm chhuakin i phun ta a;
  </para>
  <para style="p">
    <verse number="9" style="v" />A vêlte chu i thian fai a, Nghet takin zung a thlâk ta a, Ram pum a awh ta e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tlângte a tihlim duai a, Sidar lian pui puiah a zâm lûk a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Khawthlang tuipui a zâm kai a, Khawchhak luipui thlengin a zâm ta a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Engtizia nge a hungna pal i ṭhiah tâka, Veivâkte chuan a rah an lawh theih tâk hi le?
  </para>
  <para style="p">
    <verse number="13" style="v" />Sanghalte chuan an nawr chhum a, Ramsate chuan an tlân.
  </para>
  <para style="p">
    <verse number="14" style="v" />Engkim Pathian, kan lam lo hawi leh la, Vân aṭanga rawn thlîrin min han en la, I grep hrui hi han ngaihven teh.
  </para>
  <para style="p">
    <verse number="15" style="v" />I kut ngeia i phun, I tân i chawrtîr hluah hluah kha a ni si a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hmêlmaten min hâl a, min tan chhum a, I hmêl dur chuan tiboral rawh.
  </para>
  <para style="p">
    <verse number="17" style="v" />I mi duhsaka chungah chuan i kut nghat la, Mihring fapa, nangin i tihchaka chungah ngei chuan.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tichuan, kan hawikîrsan lo vang che, Min tiharh la, i hming kan lam dâwn nia.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa , Engkim Lalpa , min din leh la, I hmêl êng chu min hmuhtîr rawh. Tichuan, kan him dâwn nia.
  </para>
  <chapter number="81" style="c" />
  <para style="p">
    <verse number="1" style="v" />Min tichaktu Pathian fakin in aw chhuah rawh u, Jakoba Pathian chu fakin zai rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hla sa ula, benchhek kha khâwng rawh u, Perhkhuang leh ṭingṭang rimawite rem bawk rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thla tharah chuan tawtawrâwt hâm ula, Kût ni, thlahleinga zânah chuan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hei hi Israel ramah chuan tih ṭhin tûr a ni, Jakoba Pathian thupêk a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Josefa thlahte tih tûra ruat a ni. Aigupta ram a fan lai khân, “Ka la hriat ngai lohte aw ka ngaithla a,
  </para>
  <para style="p">
    <verse number="6" style="v" />An rit phurhte ka lâk kiansak a, An thil chawina kho pawh ka paihsak kha.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mangangin min au va, ka chhâng ta a, Khawpui rîkna, ka bihrûkna hmun aṭang ngei chuan. Meriba tui bula ka fiah che u kha,
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka mite u, ka zilhna hi ngaithla ula, Aw Israel, ka thu hi ngai ula ka va ti êm:
  </para>
  <para style="p">
    <verse number="9" style="v" />Ram dang pathian be suh ula, Hnam dang pathian hmaah kûn hek suh u.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei hi Lalpa , in Pathian chu ka ni, Aigupta ram ata hruai chhuaktu che u ka ni. In kâ kha âng rawh u, ka châwm dâwn a che u.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nimahsela, ka mite chuan ka aw an hre duh lo, Israel chuan engah mah min ngai ta lo.
  </para>
  <para style="p">
    <verse number="12" style="v" />An luhlul êm êm a, An thu thuin ka awmtîr ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka mite chuan ka thu hi ngaithlain Israel-te chuan ka kawng hi zawh teh sela aw!
  </para>
  <para style="p">
    <verse number="14" style="v" />An dote chu ka han titlâwm ang a, An hmêlmate chungah ka kut ka thlâk thuai tûr.
  </para>
  <para style="p">
    <verse number="15" style="v" />A hmaah chuan an dawl ang a, Lalpa hawtute chu An chan a chau hlen ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Buh tui berin ka châwm ang a, Lungpuia khawizu-in ka titlai tûr che u a ni.”
  </para>
  <chapter number="82" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian chu pathianho zîngah a ṭhu a, An zîngah chuan ro a han rêl a.
  </para>
  <para style="p">
    <verse number="2" style="v" />‘Dik lo takin eng chen nge ro in rêl anga, Mi sualte chu in duhsak zêl dâwn le?
  </para>
  <para style="p">
    <verse number="3" style="v" />Retheite leh fahrahte chu chhan ṭhîn ula, Pachhiate leh baihvaite chungah pawh ṭhat chhuah rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pachhiate leh vâkvaite chu hum ṭhîn ula, Mi sualte kut ata chhan chhuak rawh u.’
  </para>
  <para style="p">
    <verse number="5" style="v" />Eng mah an hre lo va, eng mah an ngaihtuah bawk hek lo, Thimah an tei mai mai a, khawvêl innghahna ber dikna a bo zo ta e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chungnungbera fate niin Pathian fate in ni emaw ka ti a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihring zînga milian, mitê ang lek Thi tûra ruat in ni si a.’
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Pathian, lo thawk chhuak la, Lei chungah hian ro han rêl rawh, Hnam zawng zawng hi i ta an ni.
  </para>
  <chapter number="83" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, ngawi reng teh suh, Reh reng lo la; aw Pathian, awm hle hle suh.
  </para>
  <para style="p">
    <verse number="2" style="v" />I hmêlmate an inhrosa a ni, Nangmah hawtute chu an dâk hrâw hrâw ta mai.
  </para>
  <para style="p">
    <verse number="3" style="v" />I mite chu vervêk taka beih dân tûr te, I duhsakte chungchâng phiarin an inrâwn a,
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Hawh u, he hnam hi i nuai bo vang, Israel hming hi bo hlen rawh se,’ an ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />An inthurual ta a, Nangmah bei tûr chein thu an thlung ta,
  </para>
  <para style="p">
    <verse number="6" style="v" />Edom mi te, Ismael mi te, Moab leh Hagar mi te,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gebal leh Amon mi te, Amalek leh Filistia-ho, Tura khaw mi te nên an inthurual.
  </para>
  <para style="p">
    <verse number="8" style="v" />Asuria pawh an zîngah chuan a tel ve, Lota thlahte ṭanpui tûrin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midian chunga i tih ang khân, Kison luia Sisera leh Jabina ang khân ti la,
  </para>
  <para style="p">
    <verse number="10" style="v" />Endor khuaa i tihhlumte ang khân, An ruang chu lei chungah ṭawih hlawm rawh se.
  </para>
  <para style="p">
    <verse number="11" style="v" />An mi liante Oreba leh Zeeba angin siam la, An lalte chu Zeba leh Zalmuna angin.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘Pathian ram duh lai chu I luahlân ang u,’ an ti vei a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw ka Pathian, ṭhâwngaleivir lâktîr ang che, Thliin buhpâwl a len ang hi ni hlawm rawh se.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ramhnuai a kâng ang leh Tlâng hnim a kâng hluah hluah ang hian,
  </para>
  <para style="p">
    <verse number="15" style="v" />Thlipuiin nuai nek la, I thli hrâng chuan tichiai rawh.
  </para>
  <para style="p">
    <verse number="16" style="v" />An hmêlte chu sen awp awp khawpin tizak ang che, Lalpa , i hming an lam theih nân.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mualpho leh beidawngin awm kumkhua sela, Zak takin boral rawh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />I hming chu Lalpa a ni a, Nang chauh hi khawvêl pum puia Chungnungbera i nih hre rawh se.
  </para>
  <chapter number="84" style="c" />
  <para style="p">
    <verse number="1" style="v" />Engkim Lalpa , i chênna chu a va duhawm em!
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa , i tualzâwl hi ka ngai ṭhîn a, A ni, ka lung a lêng hle ṭhîn. Ka nun pum hi Pathian nung Fakin hlim takin a au va ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />I maichâm bulahte chuan chawngzawng pawhin bu chhehna tûr a hmu a, Vamûrte chuan an note dahna tûr bu an chhep bawk. Engkim Lalpa , ka lal leh ka Pathian.
  </para>
  <para style="p">
    <verse number="4" style="v" />I ina chêngte chu an nihlawh e, An fak fo thei ṭhîn che a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />I hnên ata chakna dawng ṭhînte chu an nihlawh e, Zion lamlian zawh châk ṭhînte chu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Baka ruam ro an kalna chu kal tlang mah se, Tui hna awmnaah a chantîr a, Ruah hmasa chu a tling lung ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />An kal chu an tha a zâng tawlh tawlh a, Zion-a Pathian hnên an thleng ngei ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , Engkim Pathian, ka dilna hi lo ngaithla la, Aw Jakoba Pathian, i beng lo chhi ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Pathian, kan phaw, en teh, I hriakthiha hi duhsak ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />I biak in tuala ni khat awm chu Hmun danga ni sângkhat awm aiin a ṭha zâwk. Kan Pathian in kawngkhâr vêngtu nih chu, Mi sual puan ina awm ai chuan ka thlang zâwk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tân Lalpa hi ni leh phaw a ni, Aw Pathian, min khawngaih la, min chawimawi rawh. Lalpan a ṭhatna chu a ui lo vang, Dik taka ti ṭhînte lakah chuan.
  </para>
  <para style="p">
    <verse number="12" style="v" />Engkim Lalpa , nangmah ringtute chu an nihlawh e.
  </para>
  <chapter number="85" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , i ram i duhsak a, Jakoba chu i tihmuingîlleh ta a,
  </para>
  <para style="p">
    <verse number="2" style="v" />I mite bawhchhiatna i hlîp a, An sual zawng zawng i ngaidam bawk.
  </para>
  <para style="p">
    <verse number="3" style="v" />I thinurna i hnûk kîr a, I thinrim nasa tak chu i la kîr ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Min chhandamtu Pathian, kan lam lo hawi leh la, Kan chunga i lungnihlohna chu tidai ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kan chungah hian i thin a ur rengin, Rei tak i thin a rim zêl dâwn em ni?
  </para>
  <para style="p">
    <verse number="6" style="v" />I mite hi i chungah kan hlim theih nân, Min tiharh leh tawh dâwn lâwm ni?
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , i ngilneihna chu lantîr leh la, Min rawn chhandam ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , Pathian chuan eng nge a sawi ka ngaithla teh ang, A mi, amah ngaihsaktute tân remthu a sawi a, A mi rinawm, thinlung taka amah pantute hnênah chuan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amah ṭihtute chu a chhandam duh ngei ang, kan ramah hian a ropuina a chêng bawk ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngilneihna leh rinawmna chu an awm dûn ang a, Dikna leh remna pawh an inkuah ang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lei aṭangin rinawmna chu a chawr ang a, Vân aṭangin dikna a lo zâm thla bawk ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa pawhin thil ṭha a pe ang a, Kan ramah hian buh leh thlaite a thar ṭeuh vang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Diknain a hma a hruai ang a, A kalna tûr kawng chu a buatsaih ang.
  </para>
  <chapter number="86" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , i beng chhi la, min chhâng ang che, Rethei leh pachhe tak ka ni si a.
  </para>
  <para style="p">
    <verse number="2" style="v" />I tân ka inpe a, min vêng ang che, I chhiahhlawh hi chhanhim la, ka rin Pathian i ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , min khawngaih rawh, Nilêngin ka auh che hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />I chhiahhlawh hi min tihlim la, Lalpa , i lamah ngawt ka lo hawi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , nang chu i ṭha a, ngaihdam i peih reng a, I hming lamtu chungah chuan ngil i nei êm êm a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa , ka ṭawngṭaina i lo ngaithla ṭhîn a, Khawngaih dîla ka au i bengkhawn ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mangan laiin ka au che a, Min lo chhâng ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , nang ang Pathian an awm lo va, I thil tih ang tu man an ti thei lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />I siam hnam tinrêngte an lo kal dâwn, i hmaah an kûn ang, Lalpa , i hming an chawimawi ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nang hi i ropui a, thil mak tam tak i ti, Nangmah chauh hi Pathian i ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa , i duhzâwng min zirtîr la, Rinawm takin ka awm dâwn nia, I hming ṭih reng tûrin thinlung thianghlim min pe ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , ka Pathian, Ka theihtâwpin ka fak ang che, I hming ka chawimawi kumkhua ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Min lainatna a nasa a, Seol-a chhuk tûr min chhan chhuah hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Pathian, mi chapoten min rawn bei a, Mi râwng pui pui, nangmah pawisa lote chuan Min thah an tum.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa , nang chu Pathian ngilnei tak leh zahngai thei tak i ni, Thinnel, khawngaihna leh rinawmna ngah i ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka lam hi lo hawi la, min khawngaih rawh. I chhiahhlawh hi i chakna pe ve la, I chhiahhlawhnu fapa hi chhandam ang che.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka chungah i ṭhatzia han tilang la, Min hawtuten hmu se, zak hle rawh se, Min ṭanpuia min thlamuan ṭhîntu chu Lalpa , nang hi i ni.
  </para>
  <chapter number="87" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tlâng thianghlimah chuan Lalpan khua a din a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpan Jerusalem khawpui hi, Jakoba thlahte khua zawng zawng aiin a ngaina zâwk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw Pathian khawpui, i chanchin An sawi ropui hle a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />‘Min pawmtute zîngah Aigupta leh Babulon chu, Ka chhiar tel ang. Filistia leh Tura, Kus mite nên, Jerusalem-a piang zîngah ka chhiar tel ang.’
  </para>
  <para style="p">
    <verse number="5" style="v" />Zion hnênah chuan, ‘He mi pawh hi, saw mi pawh saw - heta piang a ni e,’ an ti ang a, Chungnungberan chu chu a nemnghet ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa hming ziakna bu-ah chuan, ‘Hei pawh heta piang hi a ni,’ tiin a ziak lût ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Zion aṭang vek hian a ni Malsâwmna kan dawn ṭhin,’ tiin An zai ang a, an lâm bawk ang.
  </para>
  <chapter number="88" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalpa , min chhandamtu Pathian, Chhûnah ka au che a, zânah ka rawn pan che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ṭawngṭaina i hnên lo thleng sela, Ka mangang au lo bengkhawn teh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thil ṭha lo hi ka ning ta e, Ka thi ṭhelh ṭhelh a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thlân khura liam tûrte anga ngaih ka ni a, Chhan tlâk ni tawh lo ang ka ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mitthi zînga chhiar tel, thlâna zalh tawh, Mitthi ang mai ka ni. Chûng mite chu i hre tawh lo va, Ṭanpui phâk pawh an ni tawh lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khur thûk tak mawngah chuan min dah ta a, Hmun thim thûk takah chuan.
  </para>
  <para style="p">
    <verse number="7" style="v" />I thinurna chuan min delh tlat a, Min vaw na êm êm a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka ṭhiante min lâk sawnsak daih a, An tân tenawm ka ni ta a, Min khuahkhirh tlat a, ka vâk chhuak thei lo.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka tuar a na êm a, ka mit a vai zo va, Lalpa , ni tinin ka au che a, I lamah ka kut ka phar fo ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mitthite tân thil mak i tihsak ngai em ni? An lo thovin an fak dâwn che em ni?
  </para>
  <para style="p">
    <verse number="11" style="v" />Thlâna zalh tawhte chuan i ngilneihzia an hril theiin, Chhiatna tâwk tawhte chuan i rinawmzia an puang thei dâwn em ni?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmun thimah chuan i thiltih mak hmuh theih em ni? Hriat reng tawh lohte ramah chuan I dikzia hi hriat phâk em ni?
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Lalpa , kei chuan ka au che a, Tûk tin ka ṭawngṭai ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa , engati nge min thlauhthlâka, Ka lakah hian i hmêl i thup tâk hi?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tleirâwl chhuah ata hrehawm ka tuar reng a, Ka thi lek lek ṭhîn a, I ṭihbaiawmna chuan ka thauvah hian min man a.
  </para>
  <para style="p">
    <verse number="16" style="v" />I thinur chuan min nuai ṭhîn a, Nangmah hlauvin ka chau chhe ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tui lian angin ni tin min chîm reng a, Min hual vêl tlat ṭhîn a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka ṭhian bul leh ka lainate min lâk sawnsak daih a, Thim hi ka ṭhian ber a ni ta.
  </para>
  <chapter number="89" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , i ngilneihzia zaiin ka chawi ang a, I rinawmzia ka hril kumkhua bawk ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />I ngilneihna a hlun dâwn tih ka hria, I rinawmzia lah vân anga nghet a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Ka mi thlan hnênah thu ka thlung a, Ka chhiahhlawh Davida hnênah thu ka tiam kha.
  </para>
  <para style="p">
    <verse number="4" style="v" />A thlahte chu lal an ni zêl ang a, An thlah zêlte pawh chuan i lalṭhutthlêng an luah zêl ang.’
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , vânten i thil mak tih an aupui a, Mi thianghlimte pung khâwm zîngah i rinawmzia an fak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa , vânah nangmah tluk hi tu mah an awm lo va, Lalpa ang hi vân mite zîngah tu nge awm?
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi thianghlimte awm khâwm zîngah Pathian hlauhawm tak i ni, I bula awmte tân Pathian ṭihbaiawm tak i ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , Engkim Pathian, nang anga thiltithei tu nge awma, Lalpa , rinawmnaa khat tu dang nge awm?
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuifinriat so bulh bulh chungah ro i rêl a, A fâwnte chu i hau reh ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Rahab chu i vua a, a thi dêr mai, I bân chakin hmêlmate chu i vai darh ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vân khi i ta a ni a, lei pawh hi i ta a ni, Lei leh a chhûnga awm zawng zawng hi i siam a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chhim leh hmâr i siam a, Tabor leh Hermon tlâng i hming fakin an au.
  </para>
  <para style="p">
    <verse number="13" style="v" />I bân tha chu a va chak êm! I vei lam pawh chak tak a ni, I ding lam chu a chak lehzual.
  </para>
  <para style="p">
    <verse number="14" style="v" />Dik taka tih leh rorêlna fel hi I lalṭhutthlêng nghahchhan a ni. Ngilneihna leh rinawmnain hma i la ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa , nangmah faka zai nachâng hriate chu an nihlawh e, I hmêl ênga lêng ṭhînte chu.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nilêngin i hming vângin an lâwm ṭhîn a, I dik êm avângin an hlim takmeuh ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ropui taka hnehtîrtu i ni a, I duhsakna avângin an chak zâwk ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kan phaw hi Lalpa ta a ni, Kan lal pawh hi Israel Mi Thianghlima ta a ni.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nangmah ngaihsaktu hnênah zêlin thu i sawi a, “Pasalṭha tân ṭanpuitu ka siamsak a, Mipui zînga ka duha chu ka chawisâng ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka chhiahhlawh Davida ka chhar ta a, Hriak thianghlim chu ka thih ta e.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka chaknain ka thuam ang a, Ka thiltihtheihna chuan a tichak ang.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmêlmate chu a chungah an inlek ngam lo vang, Mi sualte chuan an timangang hek lo vang.
  </para>
  <para style="p">
    <verse number="23" style="v" />A hmêlmate chu ka vaw nek ang a, A hawtute ka vuak chauhsak bawk ang.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka ngilneihna leh rinawmna a chungah ka tilang ang a, Ka hming avângin hnehtu ka nihtîr ang.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuifinriatah khuan thu a nei ang a, Luipui thleng khian a lal bawk ang.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ani chuan, ‘Ka Pa, ka Pathian i ni a, min humtu lungpui, Min chhandamtu i ni,’ min la ti ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Keiin fa tîrah ka neih ang a, Khawvêla lal ropui berah ka siam bawk ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />A chungah ngil ka nei kumkhua ang a, Ka thuthlung pawh ka vawng tlat ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />A thlahte chu ka laltîr zêl ang a, A ram chu vân awm chhûng chuan a kin lo vang.
  </para>
  <para style="p">
    <verse number="30" style="v" />A fate chuan ka Dân hi an pawisak lohva, Ka duh anga ro an rêl duh lohva,
  </para>
  <para style="p">
    <verse number="31" style="v" />Ka thutak an ngaihnêpa, Ka thupêkte an awih loh chuan,
  </para>
  <para style="p">
    <verse number="32" style="v" />An sual avângin tiangin ka vua ang a, An bawhchhiatna avângin ka sawisa ang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mahse, ka ngilneihna a dai hlen chuang lo vang a, Ka rinawmzia a nêp chuang hek lo vang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka thuthlung chu ka bawhchhe lo vang a, Ka sawi tawh chu ka tidanglam hek lo vang.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ka hming chhâla ka tiam tawh ang khân, Davida chu ka thlahthlam ngai lo vang.
  </para>
  <para style="p">
    <verse number="36" style="v" />A thlahte chu eng lai mahin an mang lo vang a, Ni khi a awm chhûng chu a ram ka tungding ang.
  </para>
  <para style="p">
    <verse number="37" style="v" />Vâna thla a awm chhûng chu A ram a kin lo vang,” tiin.
  </para>
  <para style="p">
    <verse number="38" style="v" />I hriakthiha chungah nang chu i thinur a, I hawisan a, i thlauhthla a.
  </para>
  <para style="p">
    <verse number="39" style="v" />I chhiahhlawh hnêna i thuthlung chu i palzût a, A lallukhum leiah i paihsak ta.
  </para>
  <para style="p">
    <verse number="40" style="v" />A khaw kulh bangte chu i ṭhiahsak a, A kulhbîng chu a chim ta a.
  </para>
  <para style="p">
    <verse number="41" style="v" />A fang apiangte chuan an duh duh an la a, Khaw ṭhenawmte nuihzat a ni ta e.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amah dotute chu i tichak a, A hmêlma zawng zawng i tihlim ta.
  </para>
  <para style="p">
    <verse number="43" style="v" />A khandaih chu i tibil a, Inbeihnaah a chak i phal hek lo.
  </para>
  <para style="p">
    <verse number="44" style="v" />A ropuina i lâksak a, A lalṭhutthlêng leiah i paih thla dêr.
  </para>
  <para style="p">
    <verse number="45" style="v" />A tlangvâl chhûng i tihtawisak lehnghal a, Zakin a kun tlawk tlawk a ni.
  </para>
  <para style="p">
    <verse number="46" style="v" />Lalpa , eng chen nge i bihrûk reng dâwna, I thinur chu mei anga a alh dâwn le?
  </para>
  <para style="p">
    <verse number="47" style="v" />Ka dam chhûng tawizia hi hre reng ang che, Mihringte hi thi mai theiin i siam si a.
  </para>
  <para style="p">
    <verse number="48" style="v" />Mihring piang tawh tu nge thi lo tûr awm? Tu nge Seol pumpelh thei ang?
  </para>
  <para style="p">
    <verse number="49" style="v" />Lalpa , tûn hma lama i ngilneihnate leh Davida hnêna rinawm i tiamte kha khaw nge ni ta?
  </para>
  <para style="p">
    <verse number="50" style="v" />Lalpa , i chhiahhlawh an thamlohzia hi hre reng ang che. Mi tam takin min sawichhiat hi theihnghilh lul suh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Lalpa , i hmêlmaten i hriakthih hi an hmusit a, A kalna apiangah an nuihzat zui.
  </para>
  <para style="p">
    <verse number="52" style="v" />Lalpa chu fak kumkhua rawh u; Amen, Amen.
  </para>
  <chapter number="90" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hmasâng ata, Lalpa , Nang chu kan chênna in i ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tlângte a din chhuah hma, Lei leh khawvêl a pian hma daih tawh khân, Nang chu chatuan chatuana awm Pathian i ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Hringfate u, kîr tawh rawh u,’ i han tih chuan, Leiah an kîr mai ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />I ngaihah chuan kum sâng pawh hi Nimin ral ta ang chauh kha a ni a, Zân vên khat ang lek hi a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tui lian angin i hnâwl liam a, Ṭhangkhat mu ang lek hi a ni. Zînga hnim chawr ang hi a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zîngah a lo chawr a, a lo pâr a, An han sâm a, tlaiah a vuai mai ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />I thinurna chuan min tichau dêr a, I thin a rim avângin kan mangang chhe ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kan bawhchhiatnate chu i hmu vek a, Kan sual tih rûkte pawh i hmu thei reng a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kan dam lai nite chu i thinurna avângin a tla thuai a, Kan dam chhûng kumte chu a thâmral ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kan dam chhûng chu kum sawmsarih emaw a ni a, A chak deuh chu kum sawmriat pawh an dam. Mahse, kan dam rei leh a hahthlâk thlâwn mai a, A ral thuai a, kan bo ta vang vang ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />I thinur natzia hi tu nge hre phâk? Nangmah ṭih tûr anga hlau che tu nge awm?
  </para>
  <para style="p">
    <verse number="12" style="v" />Kan dam chhûng ni tlêmzia min zirtîr la, Kan lo fin zâwk theih nân.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa , engtikah nge i lo lamlêt ang? I chhiahhlawh hi rawn hnêm ta che:
  </para>
  <para style="p">
    <verse number="14" style="v" />I ngilneihna nasa tak chuan zîngah min titlai la, Kan dam chhûngin hlim takin kan zai tawh ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hrehawm leh thil ṭha lo min tuartîr chenin Min tihlim leh ang che.
  </para>
  <para style="p">
    <verse number="16" style="v" />I chhiahhlawhten i thiltihte hmu sela, An fate chuan i ropuizia hmu bawk rawh se.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa , kan Pathian mawizia hi kan chungah lang sela, Kan kut hnathawhte hi tinghet la, Kan kut hnathawhte hi malsâwm ang che.
  </para>
  <chapter number="91" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chungnungbera thla hnuaia chênga, Engkimtitheia hlima awm chuan,
  </para>
  <para style="p">
    <verse number="2" style="v" />“ Lalpa , ka tlûkluhna, ka himna kulhpui, Ka Pathian, ka rin chhan ber i ni,” a ti ngei ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thang ata chu a chhan chhuak ang che a, Hripui hlauhawm lakah a hum ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />I chungah chuan thla a zâr ang a, A thla hnuaiah i tlulût ang, Rinawm takin a vêng ang che a, a hum ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zâna thil hlauhawmte, Chhûna thal lêng ṭhînte i hlau lo vang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thima hri lêng ṭhîn leh Chhûna lêng ṭhîn chhiatna i hlau hek lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sâng têl i sîrah an tluin I vêlah chuan sîng têl thal phung mah se, A khawih ve hauh lo vang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />I mit zawngin i hmu ngei ang, Mi sual chunga phuba lâk chu a hmuhin i hmu chauh vang.
  </para>
  <para style="p">
    <verse number="9" style="v" />I tlûkluhna chu Lalpa a ni a, Chungnungbera bula chêng i nih hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thil ṭha lo chuan a nang lo vang che a, I awmnaah hri chhia a lo hnai lo vang.
  </para>
  <para style="p">
    <verse number="11" style="v" />I kalna apianga vêng tûr chein Vântirhkohte chu a tîr ang a;
  </para>
  <para style="p">
    <verse number="12" style="v" />An kutin an dâwm ang che a, Lungah i ke i chhuih lo vang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sakeibaknei leh rûl i rap ang a, Sakeibaknei vânglai leh rûlngân i chîl bawk ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Min ngainat êm avângin ka chhan ang che, Ka hming a pawm tâk avângin ka chawisâng ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Min au vang a, ka lo chhâng ang, A mangan leh ka awmpui ang a, Ka chhan chhuak ang a, ka chawimawi ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />A duh chen chen a dam ka phal ang a, Ka chhandamna ka hmuhtîr ang.
  </para>
  <chapter number="92" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa hnêna lâwmthu hrilhi a va ṭha em! Aw Chungnungber, i hming faka zai te,
  </para>
  <para style="p">
    <verse number="2" style="v" />Tûk tin i ngilneihzia hril te, Zâna i rinawmzia puan te,
  </para>
  <para style="p">
    <verse number="3" style="v" />Ṭingṭang hrui sâwm nei leh perhkhuangte leh, Bengbung rimawite nêna fak che hi a va nuam êm!
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa , i thiltihin min tihlim a, I kut hnathawh lâwmin ka au.
  </para>
  <para style="p">
    <verse number="5" style="v" />I thiltih chu, Lalpa , a va ropui tak êm! I ngaihtuahte chu a va thûk êm!
  </para>
  <para style="p">
    <verse number="6" style="v" />Hêng hi mi nazawngin an man pha lo, Mi â-te hriat rual lah a ni hek lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi suaksualte chu hnim angin an chawr hluah hluah a, Thil sual titute pawh an vul hle si ṭhin hi; Mahse, boral vang vang tûr an ni si.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang erawh chu, Lalpa , Kumkhuaa chungnung ber i ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai teh, Lalpa , i hmêlmate, Nangmah dotute chu an boral ang; Thil sual titute pawh an darh vek ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sele pachal angin mi tichak a, Hriak thar min thih bawk a;
  </para>
  <para style="p">
    <verse number="11" style="v" />Min châng rutute lah ka hmu thei zêl a, Mi sual, min beitute thâwm pawh ka hre thuai ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi dikte chu tûmthing angin an duah ang a, Lebanon tlâng sidar angin an ṭhangduang ang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa ina phun, kan Pathian in tuala awm tate chu an chawr hluah hluah ang a,
  </para>
  <para style="p">
    <verse number="14" style="v" />Upa hle mah sela, an rah thliah thluah ang a, An tuaiin an hring hluah ang.
  </para>
  <para style="p">
    <verse number="15" style="v" />Min humtu Lalpa chu mi ngîl a ni a, Sualna rêng rêng a nei lo tih an hril ṭhîn ang.
  </para>
  <chapter number="93" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu Lalber a ni a, Ropuina leh chaknain ainthuam a, Khawvêl hi nghîng lo tûrin a hûng tlat bawk a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmasâng ata i lalṭhutthlêng chu a ding nghet êm êm a, Nang chu chatuana awm i ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , tuifinriat chu a lo fâwn a, A fâwnte chu a ri hlup hlup mai a, A inchhawk ulh ulh mai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuifâwn ri hum hum te, Tuifinriat fâwn inchhawk ulh ulhte ai hi chuan, Vân sânga awm Lalpa chu a ropui zâwk daih e.
  </para>
  <para style="p">
    <verse number="5" style="v" />I thu hriattîrte chu a rin tlâk êm êm a, Aw Lalpa , kumkhua atân, I chênna leh thianghlimna hi a inmawi hle a ni.
  </para>
  <chapter number="94" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , phuba latu Pathiani ni, Phuba latu Pathian, lo lang tawh rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lei chungah hian ro han rêl la, Chapote chu an phu tâwkin han thungrûl rawh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , mi sualte hi Eng chen nge an inchhuan dâwn le?
  </para>
  <para style="p">
    <verse number="4" style="v" />Chapo takin an ṭawng thâwr thâwr ṭhîn a, Thil sual titu zawng zawngte chu an uang hle ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , i mite hi an sawisa nek a, I rochante an tiduhdah.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hmeithaite leh kan zînga hnam dangte, Fahrahte pawh an that zêl mai.
  </para>
  <para style="p">
    <verse number="7" style="v" />“ Lalpan a hmu lo vang, Jakoba Pathian chuan a ngaihsak lo vang,” an ti.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi mâwlte u, ngaihtuah ngun hle ula, Mi â-te u, engtikah nge in fin ang aw?
  </para>
  <para style="p">
    <verse number="9" style="v" />Beng siamtu chuan a hre thei dâwn lo vem ni le? Mit siamtu chuan a hmu thei lo vang maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnam tin thununtu chuan a hrem thei lo vang maw? Mihring zirtîrtu chuan hriatna a nei lo vang maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpan an ngaihtuahte chu a hre vek a, Engmahlo mai a nih a hria.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpan mi a thununte leh A Dân a zirtîrte chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hmêlma lakah rilru hahchawlhna a pe ṭhîn, mi sualte tlâkna tûr hum laih a nih laiin.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpan a mite chu a kalsan ngai lo va, A rochante chu a thlahthlam ngai hek lo.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi felte tân rorêlna dik a awm leh ang a, Thinlung ngîlte pawhin an ṭâwmpui ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi sual laka min chhan tûrin tu nge lo ding chhuak ang? Thil sual titu lakah tu nge min rawn ṭan ang?
  </para>
  <para style="p">
    <verse number="17" style="v" />Min ṭanpuitu chu Lalpa ni suh sela chuan, Ngawih vang vangna ramah ka kal daih tawh âwm e.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka tlu dâwn emaw ka tih laiin Lalpa ngilneihna chuan min chelh ṭhîn.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka mangan êm êm laite chuan Min thlamuan a, min tihlim ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rorêlna dik lo chu i ngaithei lo, Dik lo taka rêl hi tih dân tûra neih ṭhîntu nên,
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi dikte nun lâk tuma beia, Pawi khawih lo a rûka thiam loh chantîrtu chu.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lalpa chu min humtu a ni, Ka Pathian chu ka tlûkluhna lungpui a ni.
  </para>
  <para style="p">
    <verse number="23" style="v" />An suahsualna avângin a nuai bo vang; Lalpa , kan Pathian chuan a tiboral vek ang.
  </para>
  <chapter number="95" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hawh u, Lalpa fakin hlimtakin i zai ang u, Min humhimtu Pathian fakin i au chiam ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lâwmthu sawiin a hmaah kal ila, Hlim takin a fak hla i sa ang u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa hi zawng Pathian ropui tak a ni a, Hnam dang pathiante chunga Lalber a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei chhûngril thûk takte a kuta awm a ni, Tlâng sângte pawh a ta a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuifinriat hi a ta a ni, a siam a ni si a, Khawmual pawh hi a kutchhuak a ni e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lo kal ula, chibai bûkin a hmaah chuan i kûn ang u, Lalpa min siamtu hmaah chuan i ṭhingṭhi ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ani chu kan Pathian a ni a, Keini pawh hi a rama tla, a kuta awm berâmte chu kan ni. Vawiin ngei hian a thu hi ngaithla teh ula aw!
  </para>
  <para style="p">
    <verse number="8" style="v" />“Meriba-a an tih ang khân in thinlung chu tikhauh suh u, Masa thalêra an tih ang khân.
  </para>
  <para style="p">
    <verse number="9" style="v" />In pute khân tah chuan min chian a, Ka thiltihte an hmu chungin min fiah lui a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anni chu kum sawmli chhûng khân ka kham hle a, Mi luhlul tak an ni. ‘Ka duhzâwng pawh an hre thei lo,’ ka ti ṭhîn a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka thinur a, thu ka tiam ta tlat a, ‘Ka pêk tûr, hahchawlhna ram chu, an thleng lo vang,’ ” tiin.
  </para>
  <chapter number="96" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa fakin hla sa ula, hlathar sa rawh u, Leia mi tinrêngin Lalpa fakin hla sa rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa chawimawia hla sa-in, a hming fak ula; Min chhandamna thu lâwmawm hi ni tin puang rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hnam tin hnênah hril darh ula, Mi tin hnênah a thil mak tih chu puang rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu a ropui a, fak chiam tûr a ni, Pathian dang zawng aiin ṭih tûr a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hnam dang pathiante chu a lem mai an ni a, Lalpa hi zawng vân siamtu a ni e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ropuina leh chawimawina chuan a hual vêl a, Thiltihtheihna leh mawina chu a Hmun Thianghlimah a awm.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khawvêl hnam tinrêngte u, Lalpa chawimawi ula, Lalpa ropuina leh chakna chu fak rawh u
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa hming ropui chu fak fo ula, Thilpêk kengin a inah lo haw rawh u.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thianghlim leh mawi taka inthuamin,. Lalpa hmaah lo kûn rawh u, Leia chêng zawng zawng pawh hlauvin khûr rawh se.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnam tin hnênah, “ Lalpan ro a rêl e,” ti rawh u, Nghîng lo tûrin lei hi a hûng tlat a, Mi tin chungah dik takin ro a rêl dâwn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vânte u, hlim ula, lei pawh hi lâwm rawh se, Tuifinriat leh a chhûnga awmte chu au dur dur rawh se.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa hmaah chuan Lo leh a chhûnga awm zawng zawng hi Lâwm takin awm sela, Ngaw thing zawng zawngte chu Hlimin au hluah hluah bawk rawh se.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa chu lei chungah rorêl tûrin a lo kal e, Khawvêl chungah dik takin ro a rêl ang a, Rinawm takin mi tinrêng thu a rêlsak dâwn si a.
  </para>
  <chapter number="97" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpan ro a rêl e, lei hi lâwm se, Thliarkârte u, hlim bawk rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chhûm leh thim mup a vêlah chuan a awm a, Dik taka tih leh tluang taka rorêl hi A lalṭhutthlêng nghahchhan a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A hmaah mei a alh reng a, Amah hualtu hmêlmate chu a kâng ral ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kawlphe chuan khawvêl a ên zawr zawr a, Leiin a han hmuh chuan a khûr.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa hmaah khawihnûn angin tlângte an tui a, Khawvêl pum pui hi Lalpa hmaah chuan.
  </para>
  <para style="p">
    <verse number="6" style="v" />Vânte khian a dikzia an tlângaupui ṭhîn a, Mi zawng zawngin a ropuizia an hmu.
  </para>
  <para style="p">
    <verse number="7" style="v" />Milem betute chu an zak ang a, Milem chhuangtu zawng zawngte leh Pathian dang zawng zawng pawh a hmaah an kûn ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zion tlâng chuan a lo hria a, a lâwm hle a, Judai ram mite chu hlim takin an au va, Lalpan a chhan chhuah tâk avângin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , nang chu khawvêl pum puia chungnung ber i ni, Pathian dang zawng aiin i chungnung zâwk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpan sual hawtute chu a hmangaih a, Inserhte chu a vêng reng a, Mi sual kut ata chu a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi dik tân khua a lo êng a, Mi ngîlte tân hlimna a lo thleng bawk.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi dikte u, Lalpa -ah lâwm ula, A hming thianghlim chu fak rawh u.
  </para>
  <chapter number="98" style="c" />
  <para style="p">
    <verse number="1" style="v" />A thil mak tih ropui tak avângin, Lalpa chu fakin hla thar sa rawh u, A kut ding lam leh a bân thianghlim ngei chuan Chhandamna a rawn thlen ta.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpan a hnehna chu a rawn lantîr a, Hnam tin hmaah thil a tihdikzia a tilang ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel chhûngte chunga a ngilneihzia leh a rinawmzia a hre reng a, Pathian chhandamna chu khawvêl pum hian an hmu ta e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khawvêla mi zawng zawng hian Lalpa chu fak ula, Hlima auvin hla sa rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ṭingṭangte nên Lalpa fakna hla sa ula, Perhkhuang ri mawi tum bawk rawh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tawtawrâwt leh seki tumin Kan Lalber, Lalpa hi fak chiam rawh u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuifinriat leh a chhûnga awmte chu au dur dur se, Lei leh a chhûnga chêngte pawh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Luipuite chuan a hmaah an kut bêng sela, Tlângte pawh hi hlimin au rual rawh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khawvêl rorêl tûrin Lalpa a lo kal e, Mi tin dik tak leh fel takin a rêlsak ang.
  </para>
  <chapter number="99" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpan ro a rêl a, mi tin an khûr, Cherub chungah ṭhuin ro a rêl a, Leilung hi a nghîng dur dur mai.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zion-a Lalpa chu a ropui êm a, Mi zawng zawng aia chungnung daih a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />A hming ropui leh hlauhawm tak chu mi tinin fak rawh se, Mithianghlima a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw, Lal chak ber, dikna i ngaina a, Thu dik i kengkawh ṭhîn, Jakoba chhûngte zîngah rorêlna ṭha leh dik I rawn awmtîr ta a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , kan Pathian hi chawimawi ula, A ke bulah ṭhingṭhi rawh u. Mi Thianghlima a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosia leh Arona chu a puithiam an ni a, A hming lamtu Samuela a ni. Lalpa an au va, a lo chhâng ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chhûm ding aṭangin Pathianin a sawi a, A thu hrilh leh a thupêk chu an zâwm.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , kan Pathian, anni chu i chhâng a, An thil sual tih phuba latu i ni na a, Ngaidam ṭhîntu i nih pawh i hriattîr ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , kan Pathian hi chawimawi ula, A tlâng thianghlimah hian chibai rawn bûk rawh u. Lalpa , kan Pathian hi a thianghlim e.
  </para>
  <chapter number="100" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ram zawng zawngte u, Lalpa chawimawiin au chiam rawh u;
  </para>
  <para style="p">
    <verse number="2" style="v" />Hlim takin a rawng bâwl ula, Lâwma zaiin a hmaah lo kal rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa hi Pathian chu a ni tih hria ula, Min siamtu chu amah ngei hi a ni. A rama tla ṭhîn a berâmte kan ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lâwmthu sawi chungin a kawngkhârah lo lût ula, A tualzâwlah fak hla rawn sa rawh u, Lâwmthu hrilh ula, a hming chu fak rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chu a ṭha si a, A ngilneihna a ngai reng a, A rinawmzia pawh kumkhuain a pangngai reng a ni.
  </para>
  <chapter number="101" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngilneihna leh rorêl dik thu, hlain ka sa dâwn e, Aw Lalpa , i hnênah ka hril dâwn a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Fîmkhur takin kawng dik chu ka zawh ṭhîn a, Engtikah nge i lo lên ang? Thinlung dik tak puin ka khawsa ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka inah chuan thil sual ka ngaithei lo va, Hnungtawlh chîngte chu ka huatzâwng tak an ni, Mi kawp thei bawk hek lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi rilru kawite chuan min hlat ṭhîn a, Thil sual eng mah ka ti duh lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />A rûka ṭhiante rêl chîng chu ka ngawihsan a, Chapo leh inngaisângte ka ngaithei lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ram chhûnga mi rinawmte ka duhsak a, Ka bulah chuan ka awmtîr a, Rinawm taka thil ti ṭhînte chu ka rawngbâwltuah ka hmang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bum chîngte ka in chhûnga an awm ka phal lo va, Dâwt sawi chîng pawh ka hmuh phâka an awm ka phal hek lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tûk tinin mi sualte chu kan ram ata ka ûm bo va, Lalpa khua ata hi thil sual tih chîngte pawh ka hnawt chhuak ṭhîn.
  </para>
  <chapter number="102" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , ka ṭawngṭai ngaithla la, Ka au thâwm hian i hnên lo thleng rawh se;
  </para>
  <para style="p">
    <verse number="2" style="v" />Mangan laiin ka lakah hian i hmêl thup suh, I beng chhi la, ka au veleh min lo chhâng var ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka dam chhûng nite chu meikhu angin a zâm ral a, Thuk sa angin ka sa huai huai a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hnim ah chhum vuai angin ka awm ta a, Chaw pawh ka ei thei lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mangang taka ka rûm ka rûm avângin Ruh hlîr ruh hlîr ka ni ta e.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thlalêra tuivalawng ang ka ni ta a, Khaw ram chhimbuk ang mai ka ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />In chung chhîpa chawngzawng fu fâl angin Ka hawi ka hawi a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka hmêlmaten min deu ni tin mai a, Min hualtute chuan an kamchhe tleuh nân tak min hmang.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chawa ka rin ber chu vut a ni a, Ka thil in pawh chu ka mittuiin a pawlh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka chungah hian i thinur chu a so nasa ta êm êm a, Min la lawk a, min paih sawn ta a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka nunna chu tlaia hlim ral lam ang mai hi a ni, Hlobet angin ka vuai zo ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , nang chuan chatuanin ro i rêl ang a, Ṭhangthar zêlten an hre reng bawk ang che.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tho la, Zion hi khawngaih ang che, Khawngaih a hun ta e, Hun tiam a lo thleng ta si a.
  </para>
  <para style="p">
    <verse number="14" style="v" />I chhiahhlawhten a lungbangte an ngaina a, A chim rem rumte hi an lainat bawk a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnam dangte chuan Lalpa hming hi an hlau vang a, Leia lal zawng zawngin i ropuina an ṭih bawk ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpan Zion chu a din ṭha leh ang a, Ropui takin a lo lang ang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpan pachhiate ṭawngṭaina a ngaihsak ang a, An dîlna chu a hmusit lo vang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hei hi ṭhang lo thar zêlte tân ziak la, La piang tûrten Lalpa an fak theih nân.
  </para>
  <para style="p">
    <verse number="19" style="v" />A hmun thianghlim sâng tak aṭang khian Lalpan a han thlîr a, Vân aṭangin lei hi a en a,
  </para>
  <para style="p">
    <verse number="20" style="v" />Lung in tângte rûm chu a han hria a, Thi tûra tihte chu a rawn chhan ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zion-ah Lalpa hming hi hril ula, Jerusalem-ah pawh a fakna hla sa bawk rawh u.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tichuan, mipui an lo pung khâwm ang a, Hnam tinrêngin Lalpa rawng an bâwl ang.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka vânglai hun a titawi a, Ka nite chu a titlêm ta,
  </para>
  <para style="p">
    <verse number="24" style="v" />‘Aw ka Pathian, ka vânglaiin min la bo suh, Nang zawng kumkhuaa awm i ni si a,’ ka han ti a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nangin lei hi hmâna i siam a ni, Vân pawh i kutchhuak a ni e.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mahse, an boral ang, nang erawh chu i awm kumkhua dâwn a, I hmaah chuan silhfên angin an chul ang a, Puan ang maiin i hluihlâwn ang a, An ral vek ang.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang erawh chu a ngai reng i ni a, I kumte chuan kin ni a nei lo vang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kan fate chu nangin i vêng ang a, An thlahte pawh him takin an awm ang.
  </para>
  <chapter number="103" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka thlarau, Lalpa chu fak la, Ka chhûnga awm zawng zawng hian a hming thianghlim chu fak rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw ka thlarau, Lalpa chu fak rawh, A ṭhatna zozai hi theihnghilh suh ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />I bawhchhiatna tinrêng a ngaidam a, I natna zawng zawng pawh a tidam a,
  </para>
  <para style="p">
    <verse number="4" style="v" />I nunna chu khur thûk ata a tlan chhuak a, Ngilneihna leh lainatnain min hual vêl ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil ṭha tinrêng ka duh tâwk min pe a, Mupui angin kei pawh ka tuai thar ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpan dik takin thil a ti a, Hnehchhiahte ro a rêlsak ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosia hnênah a duhzâwng a hrilh a, A thiltihtheihzia Israel-te a entîr kha.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chu mi lainat ṭhîn, khawngaih thei tak a ni, Thinnel, ngilneihna ngah a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi sawisêl chîng tak a ni ngai lo va, A thinur lah a pai reng ngai hek lo.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kan sual angin kan chungah a ti lo va, Kan bawhchhiatna angin min thungrûl duh hek lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lei aiin vân a sâng ang hian, Amah ṭihtute chungah chuan a ngilneihna a sâng a ni.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khawchhak leh khawthlang a inhlat ang hian, Kan khawlohna min dah sawnsak ta daih a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pain a fate a lainat ṭhîn ang hian, Lalpan amah ṭihtute chu a lainat ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kan derthâwnzia a hre chiang a, Vaivut mai kan nih a hre reng a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihring nun hi zawng hlobet ang chauh a ni, Ram hnim pâr a lo vul ve a,
  </para>
  <para style="p">
    <verse number="16" style="v" />Thliin a han chhêm a, A bo ta daih mai a, Hmuh tûr a awm tawh lo ang hi a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa ṭihtute tân a ngilneihna a ngai reng a, A ṭhatna lah an tuchhuan thleng pawhin a ngai reng ṭhîn,
  </para>
  <para style="p">
    <verse number="18" style="v" />A thuthlung vawng rengtute leh A thupêk zâwm ṭhînte tân.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpan vânah a lalṭhutthlêng a han rem a, Engkim chungah ro a rêl ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />A thupêkte zâwma, a thute ngaithla ṭhîn, Vântirhkoh chak takte u, Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="21" style="v" />A rawngbâwla, a duhzâwng ti ṭhîn Vâna mite u, Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="22" style="v" />A thuhnuaia awm zawng zawng leh A thilsiamten Lalpa chu fak rawh se, Aw ka thlarau, Lalpa chu fak rawh.
  </para>
  <chapter number="104" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw ka thlarau, Lalpa chu fak rawh, Aw Lalpa , ka Pathian, i va ropui tak em! Ropuina leh chawimawinain i inthuam hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Puan angin êng i sin a, Vân khi puan in angin i kai pharh a,
  </para>
  <para style="p">
    <verse number="3" style="v" />I in chu chung lam tuiah khian i sa a, chhûm chu tawlailîrah i hmang a, Thli chungahte chuan i chuang bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thli hi i tirhkoh a ni a, Kâwlphe de zawr zawr hi i chhiahhlawh a ni bawk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nghîng lo tawp tûrin Lei hi i nghat tlat a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Puana tuam angin tui thûk takin a tuam vêl a, Tlâng chhîpte chu tuiin a chîm vek bawk.
  </para>
  <para style="p">
    <verse number="7" style="v" />I han hau va, tui chu a tlânchhia a, I râwl i han chhuah chuan a liam zo ta vek a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tlângahte a luang liam a, Kawrahte chuan a luang thla a, A awmna tûr i ruatah chuan.
  </para>
  <para style="p">
    <verse number="9" style="v" />A pelh loh tûr ramri i khamsak a, Lei hi a chîm pil leh loh nân.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuihna leh lui i tichhuak a, Tlâng kârahte an luang ta a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ramsa tinrêngte chuan an lo tlân a, Ram sabengtung tuihâlte chuan an dâwt.
  </para>
  <para style="p">
    <verse number="12" style="v" />A kamah chuan chunglêng savaten bu an chhep a, Hnimbuk zîngahte chuan an hrâm bawk a.
  </para>
  <para style="p">
    <verse number="13" style="v" />I chênna hmunsâng aṭangin Tlângah ruahpui i sûrtîr a, Lei chu malsâwmnain i tikhat ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ran peh atân hnim a lo chawr a, Mihring tân thlaite a lo ṭiak a, Leiah ei tûr buh a lo awm ta.
  </para>
  <para style="p">
    <verse number="15" style="v" />A intihhlimna tûr uain a thar bawk a, Hriak pawh a sa timâm tûrin, A rin tûr chaw a nei ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpan a phun Lebanon tlâng sidar thing chuan A duhtâwk tui a hmu.
  </para>
  <para style="p">
    <verse number="17" style="v" />A zârah savaten bu an chhep a, Vachate chuan fâr lêrah bu an nei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sathârte chu khâm sângah an chêng a, Khâm pûkah chuan sangawite an biru.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thla chu a hun bi-ah a de ṭhîn a, Ni pawh a hun takah a tla bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khua a thim a, zân a lo ni a, Ramsa tinrêng an tla chhuak a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sakeibaknei vânglai sa seh tûr chu a hâhum a, Pathian hnênah ei tûr a ngên.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ni a lo chhuak a, an ṭîn dial a, An awmna ṭheuhvah chuan an bawk leh ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hna thawk tûrin mihring a lo chhuak a, Tlai thlengin hna a thawk ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa , i thil siam hi a va tamin I va siam thiam tak em! Lei hi i thilsiamin a khat a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tuifinriat saw a ropuiin a va zau tak êm! Thil nung chhiar sên lohte an awm a, Lian tak tak te, tê tak takte an ni.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tah chuan lawngte an lêng noh noh bawk a, I siam Leviathan chu a lêng zuai zuai bawk a.
  </para>
  <para style="p">
    <verse number="27" style="v" />An vaiin i mitmei an en a, A hun takah ei tûr i pe ziah ṭhîn.
  </para>
  <para style="p">
    <verse number="28" style="v" />An chaw tûr i pe a, an ei a, Thil ṭha tinrêng i kut ata an duhtâwk an dawng ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />I hmêl i han thup chuan an mangang a, An thaw i tihtâwp chuan an thi mai a, Vaivutah bawk an kîr leh ṭhîn.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nangin i han thâwkkhum a, an nung ta mai a, Ram pawh hi i titui ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa chu chatuanin ropui sela, Lalpa chu a thilsiamah hlim bawk rawh se.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lei hi a han melh chuan a khûr ṭhîn a, A han khawih chuan tlângte a tuiral ṭhîn.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka dam chhûngin Lalpa fakin ka zai ang a, Pathian chu, ka nun chhûng zawng ka fak bawk ang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka ngaihtuahte hi a lâwmzâwng ni sela, Lalpa -ah chuan ka lâwm si a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi sualte chu lei aṭang hian boral sela, Mi suaksualte awm tawh suh se, Aw ka thlarau, Lalpa fak rawh. Lalpa chu fak rawh u.
  </para>
  <chapter number="105" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu lâwmthu hrilh ula, A hming lam rawh u, A thiltih hi hnam tinrêng hrilh rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amah fakin zai ula, Thil mak a tih zawng zawng hi hril rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />A hming thianghlim hi chhuang ula, Lalpa zawngtute chu hlim hle rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu zawng ula, a chakna dîl rawh u, Ani chu pan fo rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />A thiltih ropui tak te, A thil mak tih leh a rorêl dân te,
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw, a chhiahhlawh Abrahama thlahte u, A thlan Jakoba fate u, hre reng rawh u.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ani chu Lalpa kan Pathian a ni a, Khawvêl pum puia rorêltu a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />A thuthlung chu a hre reng a, Chhuan sâng thlengin a thupêk pawh a hre reng bawk.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abrahama hnêna a thuthlun leh Isaka hnêna a thutiam chu a hre reng a ni.
  </para>
  <para style="p">
    <verse number="10" style="v" />Chûng chu Jakoba thlahte tân dânah a nemnghet a, Israel-te kumkhaw thuthlung atân.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Khai le, Kanan ram hi ka pe ang che u, Ro atân in nei thliah ang,” a ti a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eng tham ni lo, mi tlêm tê Mikhual mai an la nih lai pawh khân.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hnam tinrêng zîngah vâkvaiin Ram tinah an pêm lâwr a,
  </para>
  <para style="p">
    <verse number="14" style="v" />Mahse, tu ma nêkchêp a phal lo va, Anmahni avângin lalte a zilh zâwk a.
  </para>
  <para style="p">
    <verse number="15" style="v" />‘Ka hriakthiha khawih suh ula, Ka zâwlnei hi a pawi khawih hek suh u,’ a ti.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ram pum puiah ṭâmpui mitthi a thlentîr a, An buh zawng zawng a tihchhiatsak vek kha.
  </para>
  <para style="p">
    <verse number="17" style="v" />An hmaa kal tûrin mi a tîr a, Bawiha an hralh Josefa kha.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ke-ah chuan kawl an buntîr a, A nghâwng thîr khaidiatin an hrêng.
  </para>
  <para style="p">
    <verse number="19" style="v" />A sawi lâwk ang ngei khân a thleng ta a, Lalpa thu chu a dikzia a lang ta.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aigupta lalber chuan a chhuahtîr ta a, Chu hnam hotu ngei chuan a chhuahtîr ta.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ram hotu-ah a siam a, A neih zawng zawng chunga thuneituah a dah ta a.
  </para>
  <para style="p">
    <verse number="22" style="v" />A mi liante a duh duha thunun tûr leh An upate finna zirtîr tûrin.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israela chu Aigupta ramah a chhuk ve a, Chumi ram chuan Jakoba chu a lo mikhual.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa mite chu an pung chak ta hle a, Anmahni ertute ai chuan an chak ta a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chûng mite rilru chu a inthlâk a, A mite chu an haw ta a, A chhiahhlawhte chu vervêk takin an chawk nawmnah ta a.
  </para>
  <para style="p">
    <verse number="26" style="v" />A chhiahhlawh Mosia chu a tîr thla a, A mi thlan Arona nên.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathian thil mak tih chu an entîr a, Aigupta ramah thil mak tak tak an ti.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khua a tithim a, ai mit thlawn ang mai a ni ta. An thiltihte an hmu thei ta lo va.
  </para>
  <para style="p">
    <verse number="29" style="v" />An luite thisena chantîrin An sanghate a tihlum zo ta a.
  </para>
  <para style="p">
    <verse number="30" style="v" />An ramah chuan chungu a puantîr a, Lal in chhûngahte pawh an awm noh noh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thu a pe a, thosi a puang a, An ram chhûngah thophurh a khat ta a.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ruah aiah rial a tlâktîr a, An ram pumah ṭêk a tla bawk.
  </para>
  <para style="p">
    <verse number="33" style="v" />An grep leh theipui chu a chhu chhia a, An ram chhûnga thingte a dêng tliak zo.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thu a pe a, khau a puang a, Chhiar sên loh khauphâr rual an kat noh noh.
  </para>
  <para style="p">
    <verse number="35" style="v" />An ram chhûnga hnimhnah an ei zo va, An thlai chînte an ei kawlh vek.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ram pum puiah an fa tîrte a tihhlumsak vek a, An vânglai fate chu.
  </para>
  <para style="p">
    <verse number="37" style="v" />Tangka leh rangkachak nên a hruai chhuak a, An zînga mi tu mah sil an awm lo.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aigupta mite chuan an hlau va, An chhuak ta chu an lâwm hle a.
  </para>
  <para style="p">
    <verse number="39" style="v" />A hliap tûrin chhûm a zîntîr a, Zâna ên tûrin mei a chhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />An ngen angin vahmîm rual a lo ṭum a, An tlai tâwkin vân chaw a pe.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lungpui a tikhi a, Tui a lo luang chhuak ta a, Ram rovah chuan lui a luang ta.
  </para>
  <para style="p">
    <verse number="42" style="v" />A chhiahhlawh Abrahama hnêna, A thutiam thianghlim chu a la hre reng a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Tichuan, a mite chu a hruai chhuak a, Hlim leh lâwmin an au va.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hnam dangte lo awmna ram chu a pe a, Chûng mite thawh rah chu an rochung ta:
  </para>
  <para style="p">
    <verse number="45" style="v" />A thupêkte an zâwma, A Dânte chu an zawm theih nân. Lalpa chu fak rawh u.
  </para>
  <chapter number="106" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Lalpa chu a ṭhat êm avângin lâwmthu hrilh rawh u, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tu nge Lalpa thiltih ropuizia hi sawi thei anga, A fakawmzia hril sêng ang le?
  </para>
  <para style="p">
    <verse number="3" style="v" />Eng lai pawha dik taka awma, Thil ṭha ti ṭhînte chu an nihlawh e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa , i mite chunga ṭhat i chhuah hunah min hre reng la, I chhan chhuah hunah chuan min telh ve ngei ang che;
  </para>
  <para style="p">
    <verse number="5" style="v" />I thlante nihlawhna hmua, I hnam thlante lâwma ka hlimpui theih nân leh, I rochanten an chhuan che anga Ka chhuan ve theih nân che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kan pute ang bawkin thil kan tisual a, Kan khawlo va, kan sual a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aigupta ramah khân kan pute chuan, I thil mak tih an hrethiam duh lo va, I ngilneih nasatzia pawh an hre duh lo, Tuipui Sen kamah khân an hel tâk kha.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mahse, i hming avângin i chawimawi a, I thiltihtheihziate i hriattîr tho a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuipui Sen chu thu a pe a, a chat ta a, A mite chu leichârah chuan a kal tlangtîr ta a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Anmahni hawtute kut ata chu a chhan chhuak a, An hmêlmate kut ata ngei chu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tui chuan an hmêlmate a chîm pil a, Pakhat tê mah dam chhuak an awm loh kha.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mite chuan a thu an ring ta a, A fak nân hla an sa.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mahse, a thiltihte an theihnghilh leh ta thuai a, A remruat chu an ngaichâng duh leh ta lo.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thlalêrah an râwp ta êm êm a, Ram rovah chuan Pathian an fiah ta a.
  </para>
  <para style="p">
    <verse number="15" style="v" />An dîl ngei chu a han pe a, An râwp a tihrehsak ta a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mahse, Mosia leh mi thianghlim Arona chu, An riahna hmunah chuan an îtsîk ta a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lei a khi chat phuk a. Dathana chu a tla ta a, Abirama pawh, a hote nên, an pil zo ta.
  </para>
  <para style="p">
    <verse number="18" style="v" />An zîngah chuan mei a lo chhuak a, Mi sualte chu an kâng hlum ta vek a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Horeb tlângah pawh khân bâwngno lem an din a, An thil chhûn chu an be ta a.
  </para>
  <para style="p">
    <verse number="20" style="v" />An ropuina Pathian chu Hnim pet, bâwng ang lekah an chan ta a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aigupta rama thil ropui tak tak titu, An chhandamtu Pathian an theihnghilh ta.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aigupta ram chhûnga a thil mak tih te leh, Tuipui Sena thil râpthlâk tak a tihte pawh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A mi thlan Mosia chuan, A thinur tireh tûrin An kâra bân pharin ngensak lo se chu Tihboral vek a tum tâk kha.
  </para>
  <para style="p">
    <verse number="24" style="v" />A thutiam chu an rin tâwk loh avângin, Ram duhawm tak chu an ngainêp a.
  </para>
  <para style="p">
    <verse number="25" style="v" />An puan inah chuan an phunnawi a, Lalpa aw chu an ngaithla duh ta lo.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bân phar meuhvin thu a tiam a, “Thlalêrah in tlu hlum ang a,
  </para>
  <para style="p">
    <verse number="27" style="v" />Ram dang daihah ka tidarh ang che u a, Hnam dang zîngah in thlahte an thi ang,” A ti ta hial a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peor-ah khân Baal an bia a, Milem pathian hnêna inthawina sa an ei ve ta.
  </para>
  <para style="p">
    <verse number="29" style="v" />An thil tih chuan ani chu a tithinur a, An zîngah chuan hripui a lêng ta a.
  </para>
  <para style="p">
    <verse number="30" style="v" />Finehasa chu a tho va, ngaihdam a dîlsak a, Hri chu a reh thei ta.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chu chu a thil tih ṭhaa ngaih a ni ta a, Kumkhuaa ṭhangtharten an hriat zêl tûrin.
  </para>
  <para style="p">
    <verse number="32" style="v" />Meriba tuiah Lalpa an tithinur leh a, Anmahni avângin Mosia meuh pawh a buai ta a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ani chu an tithinur a, Thu hnu dâwn lovin a ṭawng ta a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lalpan tihlum tûra thu a pêk angin Chûng rama awmte chu an tihlum duh lo.
  </para>
  <para style="p">
    <verse number="35" style="v" />Chûngho nên chuan an inneih pawlh ta a. An tih dânte chu an zir ve ta zâwk a ni.
  </para>
  <para style="p">
    <verse number="36" style="v" />An milemte an be ve ta a, Thangah an âwk ta a ni.
  </para>
  <para style="p">
    <verse number="37" style="v" />An fanu te, an fapa te, Ramhuai hnêna inthawi nân an hmang ta a.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pawi khawih lo thisen chhuah an chîng a, Kanan mite milem hnênah thisen an hlân a, An fanu te, an fapa te thisen chuan Ram chu an tibawrhbâng zo ta.
  </para>
  <para style="p">
    <verse number="39" style="v" />An thiltih avâng chuan an bawlhhlawh zo ta a, An thil chîn avâng chuan an uire zo ta a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />A mite chungah Lalpa thin a thawk a, A rochante chu a ten ta êm êm a.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hnam dang hnênah a pe a, Anmahni hawtuten an chungah ro an rêl ta a,
  </para>
  <para style="p">
    <verse number="42" style="v" />Hnam dangten an rap bet a, An thuhnuaiah an kûn ta a ni.
  </para>
  <para style="p">
    <verse number="43" style="v" />Vawi tam tak chu a chhan chhuak a, Mahse, an hel lui zêl a, An sualnaah chuan an pil ta a ni.
  </para>
  <para style="p">
    <verse number="44" style="v" />Mahse, an han mangan meuh chuan a ngaihsak a, An au thâwm chu a lo ngaithla ṭhîn.
  </para>
  <para style="p">
    <verse number="45" style="v" />Anmahni avângin a thuthlung a hre reng a, Ngil a neih êm avângin pawi a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="46" style="v" />Sala mantu zawng zawngte chu Anmahni a khawngaihtîr fo ṭhîn.
  </para>
  <para style="p">
    <verse number="47" style="v" />Aw Lalpa , kan Pathian, min chhan chhuak la, Hnam dang zîng ata hi min hruai khâwm leh ang che. I hming thianghlim kan fak ang a, Ropui takin kan chawimawi bawk ang che.
  </para>
  <para style="p">
    <verse number="48" style="v" />Lalpa , Israel-te Pathian chu fak rawh u, Chatuan chatuanin fak ula, Mi zawng zawngin, ‘Amen,’ ti rawh se. Lalpa chu fak rawh u.
  </para>
  <chapter number="107" style="c" />
  <para style="p">
    <verse number="1" style="v" />“ Lalpa chu a ṭhat êm avângin lâwmthu hrilh rawh u, Ngil a nei kumkhua si a,”
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa tlanten ti fo rawh se. Hmêlma kut ata chu a tlan chhuak ta si a;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ram tina mi a hruai khâwm a, Chhak leh thlang, Chhim leh hmâr aṭangte chuan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thlalêr ram rovah te an vâk an vâk a, An chênna tûr khua chu an hmu zo lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Rilṭâm leh tuihâlin An beidawng êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Harsatna an tawhin Lalpa an au ṭhîn a, An manganna ata a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kawng dik takah a hruai ta a, An chênna tûr khua chu an thleng thei ta.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chu a ngilneih êm avângin fak rawh u, Mihringte tân thil mak a tih ṭhin avângin.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuihâlte chu an duh tâwkin a intîr a, Rilṭâmte pawh ei tûr tui tak takin a hrai puar ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ṭhenkhatte chu thim zîngah ngui takin an awm a, Hrehawm tuarin thîr kawl an bun.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian thu awih lova, Chungnungbera remruat an hmuhsit avângin.
  </para>
  <para style="p">
    <verse number="12" style="v" />Rim takin a thawhtîr a, a tudawl ta a, An tlûk pawhin ṭanpuitu an nei lo.
  </para>
  <para style="p">
    <verse number="13" style="v" />Harsatnate an tawhin Lalpa an au ṭhîn a, An manganna ata a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thim zînga ngui taka an awm chu a hruai chhuak a, An khaidiat bunte chu a tihchahsak bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lalpa chu a ngilneih êm avângin fak rawh u, Mihringte tân thil mak a tih ṭhin avângin.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dâr kawngkhârte a chhu chhia a, A kalhna thîr tlâwnte a tibung bawk.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ṭhenkhatte chu an â hle a, An sual avâng leh an bawhchhiatna avânga tuar an ni.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ei tûr tinrêngin a ngei a, Thlân kotlângah an dâk.
  </para>
  <para style="p">
    <verse number="19" style="v" />Harsatna an tawhin Lalpa an au ṭhîn a, An manganna ata a chhandam ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu a pe a, a tidam a, Thlân ata chu a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalpa chu a ngilneih êm avângin fak rawh u, Mihringte tân thil mak a tih vângin.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hnênah lâwmthu sawi inthawina hlân ula, A thiltihte hlain hril vêl rawh u.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ṭhenkhatte chu tuifinriatah lawnga chuangin, Tuipui zauvah ei an zawng a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lalpa thiltihte chu an han thlîr a, Tui thûk taka a thil mak tihte chu.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thu a pe a, thlipui a tleh ta a, Tuifinriat chu nasa takin a tifâwn a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lawng chu sâng tak takah a vawrh chho va, A chhuk leh vung vung ṭhîn, A hlauhawm êm avângin an thlabâr ṭhîn.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zu rui pai pai, thle thle ang hi an ni, A tihngaihna rêng an hre ṭhîn lo.
  </para>
  <para style="p">
    <verse number="28" style="v" />Harsatna an tawhin Lalpa an au ṭhîn a, An manganna ata a chhan chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="29" style="v" />Thlipui tleh chu a tibâng a, Tuifâwnte chu a reh ta a.
  </para>
  <para style="p">
    <verse number="30" style="v" />A reh tâk avângin an hlim ta êm êm a, An thlen châk hmun nuamah chuan a hruai thleng ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpa chu a ngilneih êm avângin fak rawh u, Mihring tân thil mak a tih avângin.
  </para>
  <para style="p">
    <verse number="32" style="v" />A mite pung khâwm zîngah chawimawi ula, Upa rual ṭhu khâwm zîngah amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpan luite chu thlalêrah a chantîr a, Tuihna awmna pawh ram rovah a chantîr bawk.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ram ṭha tak chu a mi chêngte sual avângin, Ram chhiaah a chantîr a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Thlalêr chu dîlah a chantîr a, Ram ro chu tuihna awmnaah a chantîr bawk.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tah chuan mi ṭâmte chu awmhmun a khuartîr a, An chênna tûr khawpui an din.
  </para>
  <para style="p">
    <verse number="37" style="v" />Thlai an chîng a, grep an phun a, A rah ta tiar tuar mai a ni.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mal a sâwm a, an pung chak êm êm a, An rante pawh a riral ve ngai lo.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hnehchhiahna nasa tak leh tihduhdahna avângin An ral tial tial a, an kun ta tlawk tlawk a ni.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mahse, miliante hmusita, Kawng awm lova vahvaihtîrtu chuan,
  </para>
  <para style="p">
    <verse number="41" style="v" />An tihretheih mangangte chu a chawi kâng a, An chhûngkuate a tipung leh ta a.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mi dikte chuan an han hmuhin an hlim ta êm êm a. Mi sualte erawh chu an ngawi hmak mai.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mi â lo chuan hêng hi chhût ngun sela, Lalpa ngilneihzia hi hre chiang teh se.
  </para>
  <chapter number="108" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Pathian, ka ring tlat che a ni: Hla ka sa ang, a ni, i fak hla ka sa ang; Thinlung takin ka fak ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ṭingṭang leh perhkhuangte u, inpeih ula, Khua i han au vâr teh ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , i mite zîngah chuan ka fak ang che, Mipui zîngah i fak hla ka sa ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />I ngilneihna chuan vân a khûm daih a, I thutak chuan vân khi a thleng si a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vânahte khian i ropuizia han tilang la, Aw Pathian, leiah pawh hian tilang ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />I chaknain min rawn chhan la, Ka dîlna hi lo ngaithla teh, I mi duh takte hi an him theih nân.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hmun thianghlim aṭangin Pathianin thu a sawi, ‘Sekem khua chu ka sem darh vek ang a, Sukot ruam chu ka ṭhen vek bawk ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gilead leh Manase ram chu ka ta a ni a, Efraim ram pawh ka inhumna lukhum a ni, Judai ram pawh ka laltiang a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Moab ram chu ka insilna chawhtawlh a ni, Ka ta a nih hriat nân Edom ramah ka pheikhawk ka vawm e, Filistia-ho chu ka aukhum.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tu nge kulh nei khuaah min hruai ang a, Edom ramah min kalpui ang?
  </para>
  <para style="p">
    <verse number="11" style="v" />Aw Pathian, min thlauhthla ta em ni? Kan sipaite zîngah, aw Pathian, i tel ve tâk loh hi?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hmêlma lakah min ṭanpui teh, Mihring ṭanpuina zawng engmahlo mai a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian zârah huai takin kan che ang, Kan hmêlmate a chîl hrep ang.
  </para>
  <chapter number="109" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw, ka fak Pathian, ngawi reng teh suh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi sual leh bum hmangten min bei luai luai a, Dâwtin min hêk min hêk si a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thu huatthlala pui pui min sawi khum a, Chhan awm lovin min bei.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keiin ka hmangaih a, annin min do, An tân ka ṭawngṭai ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thil ṭha chu sualin min thungrûl a, Ka hmangaih a, annin min haw thung a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ani chungah chuan rorêltu tûr mi sual ruat la, A ding lamah Setana ding rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />A chungthu rêl sela, thiam loh chang ngei rawh se, A ṭawngṭaina chenin suala ngaih ni rawh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />A dam chhûng nite chu tihtawi ni se, A hotu nihna chu mi dangin chang rawh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />A fate chu fahrahin awm sela, A nupui chu hmeithai rawh se.
  </para>
  <para style="p">
    <verse number="10" style="v" />A fate chu vâkvaiin kutdawh sela, An in ram aṭangin hnawh chhuah ni rawh se.
  </para>
  <para style="p">
    <verse number="11" style="v" />A neih zawng zawng a ba aiah pûktîrtuten la vek sela, A thawhrim rah pawh ram dang miten rawk bawk rawh se.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lainattu rêng tu mah nei lo sela, A fa, pa nei ta lote chu tu man khawngaih suh se.
  </para>
  <para style="p">
    <verse number="13" style="v" />A thlahte pawh mang vek sela, Ṭhangthar lo awm tûr zîngah a hming dai hlen daih se.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pa bawhchhiatna chu Lalpan hre reng sela, A nu suahsualna pawh thai bo ni hek suh se.
  </para>
  <para style="p">
    <verse number="15" style="v" />An sualna chu Lalpan chhinchhiah sela, Khawvêlah hian anmahni hriatrengna eng mah awm hauh suh se.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngilneih nachâng rêng a hre lo va, Rethei, pachhia leh mangang te, An thih thlengin a ûm zui ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ânchhe lawh chîng tak a ni, ama chungah tla zâwk rawh se. Mi dang a duhsak ngai lo va, duhsakna dawng suh se.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ânchhia chu kawr angin a ha a, Tui ang maiin a taksa a fan chhuak a, Hriak ang maiin a ruhte pawh a fan chhuak a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Puana tuam ang maiin ani chu tuam sela, Kâwnghrên angin a taiah hrêng rawh se.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hêng hi min hêktute, Lalpan a thungrulhna chu ni sela, Min sawichhetute chan chu ni rawh se.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aw Lalpa , nang chu ka Lalpa i ni a, I hming avângin min ṭanpui la, Ngil i neiin i ṭha si a, min chhan chhuak ang che.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kei zawng rethei tak leh tlachham tak ka ni, Ka thinlung hi a na êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tlai lam hlim angin ka ral tial tial a, Khau anga len bovin ka awm a, Ka vânglai a liam a, ka lo tar ta.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chaw nghei vângin ka tha a khûr ta a, Thau viau ṭhîn kha ka chêr zo ta.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi nuihzatbûr ka ni a, Min han hmuhin an lu min thin khum ṭhîn.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aw Lalpa , ka Pathian, min ṭanpuitu i ni, I ngilneih êm avângin min chhandam rawh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Chu chu i tih a nih hriattîr hlawm la, Lalpa , nangma tih ngei a ni.
  </para>
  <para style="p">
    <verse number="28" style="v" />Annin ânchhia min lawh mah se, Nangin mal min sâwm a, Min bei mah se an mualpho vang a, I chhiahhlawh hi ka hlim thung ang.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mi khingtuten mualphona kawr ha se, Zahna puanin inkhuh rawh se.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lalpa chu lâwmthu ka hrilh mawlh mawlh ang a, Mipui zîngah ka fak bawk ang.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lalpan pachhia chu a ṭan a, Ani chu thiam loh chantîrtute lakah a chhan chhuak ṭhîn.
  </para>
  <chapter number="110" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa thuchhuak chuan ka Lalpa hnênah, ‘Ka ding lamah lo ṭhu rawh, I hmêlmate i ke nghahchhanah ka han siam ang e,’ a ti.
  </para>
  <para style="p">
    <verse number="2" style="v" />I laltiang chu Lalpan Zion aṭangin a tîr chhuak a, I hmêlmate chungah ro rêl rawh le.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hmêlma i beih ni chuan I tlangvâlte an rawn inpe tup tup ang, I tlâng thianghlimah chuan Zîngah dai tla angin an lo kal khâwm bawk ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpan thu a tiam ta, a sût lo vang, ‘Chatuan Puithiam i ni, Melkisedeka ang chi kha.’
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chu i ding lamah a awm a, A thin a ur hunah lalte a titlâwm ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hnam tinrêng chungah ro a rêl ang a, An ruangte chu a vûm thûr ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kalkawng lui tui chu a in ang a, a lo harh thar leh ang.
  </para>
  <chapter number="111" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , chu fak rawh u. Mi dikte pung khâwm zîngah chuan, Theihtâwp chhuahin Lalpa chu lâwmthu ka hrilh dâwn e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa thiltihte chu a ropui êm êm a, A lâwmtute chuan hriat nuam an ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />A thiltih chu a makin a zahawm a, A dikzia pawh a pangngai reng a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />A thil mak tih kan theihnghilh mai a phal lo va, Lalpa chu khawngaihna leh lainatnaa khat a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah ṭihtute chu ei tûr a pe ṭhîn a, A thuthlung chu eng lai mahin a theihnghilh lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thiltihtheihzia chu a mite hnênah a lantîr a, Hnam dangte ram chu an hnênah a pe.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thiltih chu a rinawmin a dik a, A thupêk pawh a rin tlâk zêl a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chûng chu kumkhua atâna ruat a ni a, Rinawm tak leh ṭha taka zawm tûr a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />A mite chu a rawn chhandam ta a, A thuthlung chu kumkhuaa zawm tûrin thu a pe. A hming chu a thianghlimin a hlauhawm e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa ṭih hi finna bulpui a lo ni, A thu zâwmtute chu Hriatthiamna ṭha tak a pe. Amah chu kumkhuaa fak tûr a ni.
  </para>
  <chapter number="112" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Lalpa ṭihtute chu an nihlawh e, A thupêk ngaisâng êm êmtute chu.
  </para>
  <para style="p">
    <verse number="2" style="v" />An fate chu leiah hian mi ropui an ni ang, Mi nun ngîl thlahte chu malsâwmin an awm ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />An chhûngkuain an hausa hle ang a, Mi dik tak chhûng an ni reng ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi nun ngîlte tân thimah khua a vâr ang, Khawngaihna leh ngilneihna nei, mi dik takte tân chuan.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi ṭha chu a ngilnei a, phal takin a pûktîr ṭhîn a, Engkim dik takin a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi ṭha chu eng lai mahin a nghîng lo vang a, Hriat reng a ni bawk ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Chanchin ṭha lo hre mah sela, a hlau lo vang. Lalpa a ring a, a nghet tlat mai.
  </para>
  <para style="p">
    <verse number="8" style="v" />A rilru a nghet a, a zâm lo va, A hmêlmate tlâwm chu a la hmu ang.
  </para>
  <para style="p">
    <verse number="9" style="v" />A sem darh a, tlachhamte a pe a, A ngilneihna chu kumkhuain a pangngai reng a ni, Ropui taka chawimawi a ni bawk ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sualten an hmuh chuan an thinur ang, An ha an ṭhial ang a, an boral ang, Mi sualte tân beisei a bo hlauh vang.
  </para>
  <chapter number="113" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Aw Lalpa chhiahhlawhte u, fak ula, Lalpa hming chu chawimawi rawh u,
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa hming chu fakin awm rawh se, Tûn aṭanga chatuan thlengin.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni chhuahna aṭanga a tlâkna thlengin, Lalpa hming chu chawimawi ni zêl rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu hnam tinrêngte aia chungnung daih a ni, A ropuina chu vân chungah khian a awm.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hmunsâng taka awm, Lalpa kan Pathian ang hi tu nge awm?
  </para>
  <para style="p">
    <verse number="6" style="v" />Lei leh vân en tûrin a intihniam a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Vaivut ata retheite chu a kai tho va, Vut zînga ṭhu pachhiate chu a tungding ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Miliante zîngah chuan a ṭhuttîr a, A ni, miliante zîngah chuan,
  </para>
  <para style="p">
    <verse number="9" style="v" />Nu chingte chu chhûngkua a dinsak a, Fate neihtîrin a tihlim ṭhîn. Lalpa chu fak rawh u.
  </para>
  <chapter number="114" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel-ten Aigupta ram an kalsana, Jakoba faten awze mite ram chu an chhuahsan khân,
  </para>
  <para style="p">
    <verse number="2" style="v" />Judai ram chu a hmun thianghlim a ni ta a, Israel ram chu a lalna ram a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuipuiin a han hmuh chuan a tlânchhia a, Jordan lui pawh a luang kîr a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Berâm angin tlângte an zuang ṭum a, Berâm notê angin mualte an tualchai bawk.
  </para>
  <para style="p">
    <verse number="5" style="v" />Engati nge, tuipui, i tlânchhiata, Nang Jordan lui, i luan lêt le?
  </para>
  <para style="p">
    <verse number="6" style="v" />Engtizia nge tlângte berâm anga an zuana, Berâm notê angin mualte in tualchai tak?
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang, leilung, Lalpa hmaah khûr rawh, Jakoba Pathian hmaah chuan.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungpui chu dîlah a chantîr a, Meilung chu tuihnaah a chantîr bawk.
  </para>
  <chapter number="115" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , keini ni lovin, keimahni ni hek lovin, I hming chauh hi chawimawi ang che. I ngilneih leh i rinawm êm avâng hian.
  </para>
  <para style="p">
    <verse number="2" style="v" />Engati nge hnam dangte chuan, ‘An Pathian chu khaw nge a awm?’ an tih vei ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kan Pathian chu vânah a awm, A duh apiang a ti mai ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Milemte chu tangka leh rangkachaka siam an ni a, Mihring kutchhuak mai an ni e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kâ an nei a, an ṭawng thei si lo va, Mit an nei a, an hmu thei bawk hek lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Beng an nei a, an hre thei miah lo va, Hnâr an nei a, thil rim an hre thei lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kut an nei a, an khawih thei si lo va, Ke an nei a, an kal thei bawk hek lo, Aw pawh an chhuah thei lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />Milem siamtute chu milem ang lek an ni a, Milem ringtute pawh milem ang chauh an ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Israel-te u, Lalpa hi ring rawh u, Ṭanpuitu leh phaw a ni e.
  </para>
  <para style="p">
    <verse number="10" style="v" />Arona thlahte u, Lalpa hi ring rawh u, Nangmahni ṭanpuitu leh in phaw a ni.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpa ṭihtute u, Lalpa hi ring rawh u, ṭanpuitu leh phaw a ni e.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpan min hre reng a, mal min sâwm ang, Israela thlahte mal a sâwm ang a, Arona chhûngte pawh a sâwm bawk ang;
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpan amah ṭihtute chu, a lian a têin, Mal a sâwm ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpan nasa takin tifing che u rawh se, Nangmahni leh in fate nên.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lei leh vân siamtu Lalpa chuan Malsâwm che u rawh se.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vân khi Lalpa vân a ni a, Lei hi mihringte tân a pêk a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mitthite chuan Lalpa an fak thei lo, Ngawih rengna rama chhuk tâte chuan.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keini zawngin Lalpa kan fak ang a, Tûn aṭanga chatuan thlengin, Lalpa chu fak rawh u.
  </para>
  <chapter number="116" style="c" />
  <para style="p">
    <verse number="1" style="v" />Khawngaih ka dîlna aw a ngaihthlâk avângin Lalpa chu ka ngaina a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka koh apiangin a lo ngaithla ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thih hlauhna chuan min rawn chîm a, Seol hlauhawmna chuan mi rawn tuam a, Mangang leh lungngai takin ka awm.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tichuan, Lalpa hming chu ka han lam a, Aw ‘ Lalpa , min chhan chhuak teh,’ tiin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chuan ngil a nei a, a ṭha a ni, Pathian hi zawng, mi lainat thei tak a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpan ṭanpui ngaite a pui ṭhîn a, Ka chan a chauh laiin min rawn chhan chhuak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw ka nunna, thlamuang takin awm leh tawh rawh, Lalpa chu ka chungah a ṭha êm êm si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka nunna hi thihna lakah, Ka mitte hi mittui lakah, Ka kete hi tlûkna lakah I chhan chhuak ta si a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tichuan, Lalpa hmaah ka lêng thei ta, Mi nungte ramah chuan.
  </para>
  <para style="p">
    <verse number="10" style="v" />‘Ka va rethei tak êm!’ ka tih lai pawhin, Amah ka ring tlat a.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Tu mah rin tlâk an awm lo ve,’ Thlaphâng taka ka tih laite pawh khân.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka tân a ṭhat êm avang hian Lalpa chu eng nge ka pêk ve ang?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chhandamna no ka keng ang a, Lalpa hming chu ka lam ang.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa hnêna ka thutiam chu ka hlen ngei ang, A mite zawng zawng hmaah chuan.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amah ngaihsaktute thihna chu, Lalpa ngaihin hlu tak a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aw Lalpa , kei zawng, i bawih, i chhiahhlawh ka ni a, I bawihnu fapa ka ni, Min phuarnate i rawn phelh ta.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lâwmthu sawi inthawina ka hlân ang che a, Lalpa , i hming ka lam bawk ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpa hnêna ka thutiam chu ka hlen ngei ang, A mite zawng zawng hmaah chuan.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lalpa biak in tualzâwl, Jerusalem laiah ka hlen ngei ang. Lalpa chu fak rawh u.
  </para>
  <chapter number="117" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hnam zawng zawngte u, Lalpa chu fak ula, Mi tinrêngte u, amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kan chungah hian ngil a nei êm êm a, Lalpa rinawmna chu kumkhuain a pangngai reng a ni. Lalpa chu fak rawh u.
  </para>
  <chapter number="118" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu a ṭhat êm avângin fak rawh u, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel mite chuan, ‘Ngil a nei kumkhua si a,’ ti ngei rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Arona thlahte chuan, ‘Ngil a nei kumkhua si a’ ti hlawm rawh se.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa ṭihtute chuan, ‘Ngil a nei kumkhua si a,’ ti bawk rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka mangang a, Lalpa chu ka han au va, Lalpa chuan min lo chhâng a, min tizalên ta a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chu ka lamṭang a ni a, ka hlau lo vang, Mihringin eng nge min tih theih ang?
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa chu ka lama ṭang, min ṭanpuitu a ni, Min hawtute diriam takin ka la en ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihring rinchhan ai chuan Lalpa hnêna tlûkluh a ṭha zâwk a,
  </para>
  <para style="p">
    <verse number="9" style="v" />Milian rinchhan ai chuan Lalpa hnênah tlûkluh a ṭha zâwk.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hnam dangte chuan min rawn hual a, Mahse, Lalpa hmingin ka titlâwm ta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Min rawn hual tuau tuau va, Mahse, Lalpa hmingin ka titlâwm ta.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khuai rual angin min rawn bawh a, Mahse, Lalpa hmingin ka titlâwm ta.
  </para>
  <para style="p">
    <verse number="13" style="v" />Min rawn nawr sawk sawk a, Ka tlu ṭhelh a; mahse, Lalpan min ṭanpui ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa chu ka chakna leh ka hla, Min chhandamtu a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />An bûka Pathian mite hnehna lâwma au thâwm chu ngai rawh u, ‘ Lalpa kut ding lam chuan a hneh ta a,
  </para>
  <para style="p">
    <verse number="16" style="v" />Lalpa kut ding lam chawimawi a ni a, Lalpa kut ding lam chuan thil ropui tak a tih tâk hi,’ an ti.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka thi lo vang, ka dam ang a, Lalpa thil tih ka hril ngei ang.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lalpan min thunun na hle a, Mahse, ka thih êm zawng a phal lo ve.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tempul kawngkhâr chu mi hawn rawh u, Ka lût ang a, Lalpa hnênah lâwmthu ka sawi dâwn a ni.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hei hi Lalpa kawngkhâr chu a ni, Mi dikte chu an lût thei ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Min chhan avângin ka fak a che, Min chhanchhuaktu i ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Insatute lung hnâwl tâk kha, A kil lung pawimawh ber a lo ni si.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chu chu Lalpa tih a ni e, kan hmuhin a mak kan ti.
  </para>
  <para style="p">
    <verse number="24" style="v" />Vawiin hi Lalpa ni ruat chu a ni, Hlimin i lâwm ang u.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aw Lalpa , min chhandam teh, Aw Lalpa , min hlawhtlintîr ang che.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lalpa hminga lo kal chu an nihlawh e, Lalpa in aṭang hian mal kan sâwm a che u,
  </para>
  <para style="p">
    <verse number="27" style="v" />Lalpa chu Pathian a ni a, kan chungah a lo êng ta! Chhâwl keng ila, maichâm thlengin kawng i zawh ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka Pathian i ni a, lâwmthu ka hrilh ang che, Aw ka Pathian, ka chawimawi chiam ang che.
  </para>
  <para style="p">
    <verse number="29" style="v" />Lalpa chu a ṭhat avângin fak rawh u, Ngil a nei kumkhua si a.
  </para>
  <chapter number="119" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sawisêlbote chu an nihlawh e, Lalpa Dân zâwmtute chu.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thupêk zâwmtute chu an nihlawh e, Tihtakmeuhva zawngtute chu.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anni chuan thil sual an ti ngai lo va, A kawngah an kal ṭhîn.
  </para>
  <para style="p">
    <verse number="4" style="v" />I thuruatte chu min pe a, Zâwm ngei tûrin min ti.
  </para>
  <para style="p">
    <verse number="5" style="v" />I dânte chu Rinawm taka zâwmtu ni thei teh ila aw!
  </para>
  <para style="p">
    <verse number="6" style="v" />I thupêk zawng zawng zâwm ila, Ka mualpho tawp lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />I rorêl dikzia ka hriat hunah Thinlung dik takin ka fak ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />I dân chu ka zâwm ang a, Min kalsan suh ang che.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tleirâwlten engtin nge an awm dân an vawn thianghlim ang? I thute zâwmin.
  </para>
  <para style="p">
    <verse number="10" style="v" />Theihtâwp chhuahin ka zawng che a, I thute ka pênsan phal lul suh.
  </para>
  <para style="p">
    <verse number="11" style="v" />I chungah thil sual ka tih loh nân, I thu ka thinlungah ka vawng tlat a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , fak tlâk i ni, I dânte min zirtîr rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />I kâa thu chhuakte chu Ka sawi ka sawi dâwn e.
  </para>
  <para style="p">
    <verse number="14" style="v" />I thu târlante zawm hi ka hlimna a ni a, Sum tam tak neiha ka hlim ang maiin.
  </para>
  <para style="p">
    <verse number="15" style="v" />I thuruatte ka ngaihtuah a, I kawngte chu ka chhui bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />I thutak chu ka lawmzâwng a ni a, I thute chu ka theihnghilh ngai lo vang.
  </para>
  <para style="p">
    <verse number="17" style="v" />I chhiahhlawh chungah hian ṭha takin ti la, I thu zâwma ka nun theih nân.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka mit mi tihvârsak ang che, I Dân makzia ka hmuh chian theih nân.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leiah hian khualzin mai ka ni a, I thupêk chu ka lakah hian zêp suh ang che.
  </para>
  <para style="p">
    <verse number="20" style="v" />I rorêl hriat châkin Eng lai pawhin ka vân ruai ṭhîn.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi chapo, ânchhe dawngte chu i zilhhau va, I thupêk pawisa lotute chu.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hmusit taka min sawichhiatna hi la bo vang che, I thu hriattîr ka zâwm si a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Miliante chuan ṭhu khâwmin min phiar a, Kei, i chhiahhlawh hi chuan i Dânte ka ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="24" style="v" />I thu hriattîr chu ka lâwmzâwng a ni a, Rem min ruatsak ṭhîntu a ni.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vaivutah ka tlu reng mai a, I tiam angin min tiharh rawh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka awm dânte i hnênah ka puang a, nangin min lo chhâng a, I dânte chu min zirtîr ang che.
  </para>
  <para style="p">
    <verse number="27" style="v" />I thuruatte chu min hriatthiamtîr la, I thil mak tihte chu ka ngaihtuah ang.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lungngaiin ka chau dêr a, I tiam angin min tichak rawh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kawng dik lo chu ka zawh phal suh ang che, Khawngaih takin i dân min zirtîr rawh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kawng dik tak chu ka thlang ta a, I rorêlte ka zâwm bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="31" style="v" />I thu hriattîrte chu ka zâwm tlat a, Aw Lalpa , min timualpho lul suh.
  </para>
  <para style="p">
    <verse number="32" style="v" />I thupêk chu châk takin ka zâwm a, Ka rilru hi a tizau ta.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lalpa , i dân thute min zirtîr rawh, A kip a kawiin ka zâwm dâwn nia.
  </para>
  <para style="p">
    <verse number="34" style="v" />I Dân ka zawm theih nân hriatthiamna min pe la, Ka theih tâwkin ka zâwm ang e.
  </para>
  <para style="p">
    <verse number="35" style="v" />I thupêkte min zawmtîr la, Chu chu ka lâwmzâwng tak a ni si a.
  </para>
  <para style="p">
    <verse number="36" style="v" />I thu hriattîr lamah min hawitîr la, Awhna lamah ni lovin.
  </para>
  <para style="p">
    <verse number="37" style="v" />Thil lawilo en lo tûrin ka mit min lâktîr ang che, I kawnga kal tûrin min tiharh rawh.
  </para>
  <para style="p">
    <verse number="38" style="v" />I chhiahhlawh hnêna i thutiam chu hlen la, Nangmah ṭihtute hnêna i tiam chu.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ka hlauh êm êm, min sawichhiatna hi la bo vang che, I rorêl chu a va ṭha êm!
  </para>
  <para style="p">
    <verse number="40" style="v" />I thuruatte chu ka ngaina takzet a ni. I ṭhatnain min tiharh rawh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Lalpa , i ngilneihzia ka chungah a lang, I tiam angin min chhandam rawh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Min sawichhetute ka chhân theih nân, I thu ka ring si a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Eng lai pawhin thu dik min sawitîr rawh, I rorêl chu ka innghahna a ni si a.
  </para>
  <para style="p">
    <verse number="44" style="v" />I Dânte chu ka zâwm fo vang, Chatuan chatuanin.
  </para>
  <para style="p">
    <verse number="45" style="v" />Engthâwl takin ka lêng teh ang, I thuruat chu ka zawn ber a ni si.
  </para>
  <para style="p">
    <verse number="46" style="v" />Lalho hmaah i thu hriattîrte chu ka hril ang a, Ka zak lo vang.
  </para>
  <para style="p">
    <verse number="47" style="v" />I thupêkte zawm nuam ka ti a, Ka châkzâwng tak a nih avângin.
  </para>
  <para style="p">
    <verse number="48" style="v" />I thupêkte ka ngainain ka ngaisâng a, I dânte chu ka ngaihtuah ang.
  </para>
  <para style="p">
    <verse number="49" style="v" />I chhiahhlawh hnêna i thutiam hre reng ang che, Chu chuan beiseina min neihtîr a ni.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chu chu ka tuar laia min thlamuantu a ni, I thu chuan min tiharh ṭhîn.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chapote chuan min hmusit êm êm a, Mahse, i Dân ka pên bosan ngai lo.
  </para>
  <para style="p">
    <verse number="52" style="v" />Lalpa , hmasânga i rorêl chu ka hre reng a, Min tithlamuang a ni.
  </para>
  <para style="p">
    <verse number="53" style="v" />Mi sualten i Dân an pawisa lo tih ka hmuhin, Ka thin a ur êm êm a ni.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ka dam chhûng rei lo tê-ah hian I dânte chu zaiin ka chawi ang.
  </para>
  <para style="p">
    <verse number="55" style="v" />Lalpa , zânah i hming ka hre reng a, I Dânte chu ka ngaihtuah ṭhîn.
  </para>
  <para style="p">
    <verse number="56" style="v" />I dân zawm hi, Ka lâwmna chu a ni.
  </para>
  <para style="p">
    <verse number="57" style="v" />Lalpa , ka chanvo i ni a, I thu zawm ka tiam ta e.
  </para>
  <para style="p">
    <verse number="58" style="v" />Theihtâwpin i duhsakna ka zawng a, I tiam angin min khawngaih rawh.
  </para>
  <para style="p">
    <verse number="59" style="v" />Ka awm dânte ka ngaihtuah a, I thu hriattîrte zâwm tûrin ka ke ka pên ta e.
  </para>
  <para style="p">
    <verse number="60" style="v" />I thupêkte chu muangchâng lovin Ka zâwm ta vat a ni.
  </para>
  <para style="p">
    <verse number="61" style="v" />Mi sual rualin min hual vêl a, Mahse, i Dânte chu ka theihnghilh lo.
  </para>
  <para style="p">
    <verse number="62" style="v" />Zânlaiah te fak tûr chein ka tho ṭhîn a, I rorêlte a dik avângin.
  </para>
  <para style="p">
    <verse number="63" style="v" />Nangmah ṭihtute zawng zawng ṭhian ka ni, I dân zâwmtute chu.
  </para>
  <para style="p">
    <verse number="64" style="v" />Lalpa , lei hi i ngilneihnain a khat a, I dânte chu min zirtîr rawh.
  </para>
  <para style="p">
    <verse number="65" style="v" />I chhiahhlawh chungah hian, Lalpa , I thu angin thil ṭha i ti ṭhîn a.
  </para>
  <para style="p">
    <verse number="66" style="v" />Finna leh hriatna ṭha min zirtîr rawh, I thupêk hi ka ring si a.
  </para>
  <para style="p">
    <verse number="67" style="v" />Ka tuar hma khân ka vâk bo ṭhîn, Mahse, tûnah i thu ka zawm tâk hi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Nang zawng i ṭha a, thil ṭha titu i ni, I dânte chu min zirtîr rawh.
  </para>
  <para style="p">
    <verse number="69" style="v" />Chapote chuan min hêk ṭhîn a, Kei chuan theihtâwp chhuahin i dân ka zâwm a ni.
  </para>
  <para style="p">
    <verse number="70" style="v" />An thinlung a sak a, Kei zawng i Dân ka lâwmna a ni ṭhîn.
  </para>
  <para style="p">
    <verse number="71" style="v" />Min tuartîr kha ka tân a lo ṭha e, I dânte chu ka zir phah ta.
  </para>
  <para style="p">
    <verse number="72" style="v" />I Dân min pêkte hi, Tangka leh rangkachak sâng tam tak aiin a hlu zâwk a ni.
  </para>
  <para style="p">
    <verse number="73" style="v" />I kutin min siam a, min din nghet a, Hriatthiamna min pe la, i thupêkte ka zir ang e.
  </para>
  <para style="p">
    <verse number="74" style="v" />Nangmah ṭihtuten min hmu ang a, an lâwm ang, I thu ka rin tlat avângin.
  </para>
  <para style="p">
    <verse number="75" style="v" />Lalpa , i rorêl chu a dik tih ka hria, Dik takin min zirtîr ṭhîn a lo ni e.
  </para>
  <para style="p">
    <verse number="76" style="v" />I chhiahhlawh hnêna i tiam ang khân, Aw, i ngilneihna chuan min tithlamuang teh se:
  </para>
  <para style="p">
    <verse number="77" style="v" />Min khawngaih la; tichuan, ka nung ang a, I Dân hi ka lâwm si a.
  </para>
  <para style="p">
    <verse number="78" style="v" />Chapote chu mualpho rawh se, dâwta min hêk avângin, Kei chuan i thuruatte ka ngaihtuah ang.
  </para>
  <para style="p">
    <verse number="79" style="v" />Nangmah ṭihtute chu ka lam lo hawi rawh se, I thu hriattîr hretute chu.
  </para>
  <para style="p">
    <verse number="80" style="v" />I dânte chu zâwm vek ila, Ka mualpho ngai lo vang.
  </para>
  <para style="p">
    <verse number="81" style="v" />Min chhanchhuahna nghâkin ka chau ta e, I thu ka ring si a.
  </para>
  <para style="p">
    <verse number="82" style="v" />I thutiam thlîr nân ka mit a vai zo va, ‘Engtikah nge min thlamuan ang?’ tiin.
  </para>
  <para style="p">
    <verse number="83" style="v" />Ip hluihlâwn ung tawh ang ka ni; Mahse, i dânte chu ka theihnghilh lo.
  </para>
  <para style="p">
    <verse number="84" style="v" />I chhiahhlawh hi eng chen nge ka la dam ang? Engtikah nge min tiduhdahtute chungah ro i rêl dâwn?
  </para>
  <para style="p">
    <verse number="85" style="v" />Mi chapo, i Dân zâwm duh lote chuan, Ka tlâk nân khur an lai a.
  </para>
  <para style="p">
    <verse number="86" style="v" />I thupêkte a rin tlâk êm êm a, Dâwtin min bei a ni - min ṭanpui rawh.
  </para>
  <para style="p">
    <verse number="87" style="v" />Lei ata hi min tiboral ṭhelh ṭhelh a ni; Mahse, i thuruatte chu ka thlahthlam chuang lo ve.
  </para>
  <para style="p">
    <verse number="88" style="v" />Ngil i neih êm avângin min tiharh la, I thu hriattîr ka zâwm dâwn nia.
  </para>
  <para style="p">
    <verse number="89" style="v" />Aw Lalpa , vânahte khian I thu chu a awm kumkhua ang.
  </para>
  <para style="p">
    <verse number="90" style="v" />I rinawmna chu chhuan zawng zawng thlengin a pangngai reng a, Lei i din nghet a, a awm ta reng a ni.
  </para>
  <para style="p">
    <verse number="91" style="v" />I rorêl angin tûn thleng hian engkim an awm a, An za vaiin i chhiahhlawh vek an ni.
  </para>
  <para style="p">
    <verse number="92" style="v" />I Dân hi ka lâwmzâwng tak ni suh sela chuan, Hrehawm tuarin ka boral daih tawh ang.
  </para>
  <para style="p">
    <verse number="93" style="v" />I thuruatte ka theihnghilh ngai lo va, Nangin chûng chuan min tiharh ṭhîn.
  </para>
  <para style="p">
    <verse number="94" style="v" />I ta ka ni, min chhandam rawh, I thuruat zawngtu ka ni si a.
  </para>
  <para style="p">
    <verse number="95" style="v" />Mi sualte chuan min thah tumin min châng mah se, I thu hriattîrte chu ka ngaihtuah ang.
  </para>
  <para style="p">
    <verse number="96" style="v" />Engkim mai hian tâwp chin a nei tih ka hre ta a, I thupêk erawh chu zau tak a ni.
  </para>
  <para style="p">
    <verse number="97" style="v" />Aw, I dân chu ka va ngaina êm, Ni tin ka ngaihtuah ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="98" style="v" />I thupêk chuan ka hmêlmate aiin mi tifing a, Kumkhuaa min chênchilh reng avângin.
  </para>
  <para style="p">
    <verse number="99" style="v" />Min zirtîrtu zawng zawng aiin ka fing zâwk e, I thu hriattîr ka ngaihtuah fo avângin.
  </para>
  <para style="p">
    <verse number="100" style="v" />Tarte aiin ka hre zau va, I thuruatte ka vawn ṭhin avângin.
  </para>
  <para style="p">
    <verse number="101" style="v" />Kawng sual rêng rêng ka dai ngai lo, I thu ka zawm theih nân.
  </para>
  <para style="p">
    <verse number="102" style="v" />I rorêl chu ka pênsan ngai lo va, Nangmah ngeiin min zirtîr avângin.
  </para>
  <para style="p">
    <verse number="103" style="v" />I thute chu ka kâah hian a va tui êm! Khawizu aiin a thlum zâwk e.
  </para>
  <para style="p">
    <verse number="104" style="v" />I thuruat chuan min tifing a, Awm dân dik lo tinrêng ka hua a ni.
  </para>
  <para style="p">
    <verse number="105" style="v" />I thu hi ka ke atân khâwnvâr a ni a, Ka kawng atân êng a ni bawk.
  </para>
  <para style="p">
    <verse number="106" style="v" />I rorêl dik tak chu Zawm ka tiam a, ka nemnghet e.
  </para>
  <para style="p">
    <verse number="107" style="v" />Ka tuar nasa êm mai, Lalpa , I thu angin min tiharh rawh.
  </para>
  <para style="p">
    <verse number="108" style="v" />Lalpa , khawngaih takin ka fakna hi lo lâwm la, I rorêl chu min zirtîr rawh.
  </para>
  <para style="p">
    <verse number="109" style="v" />Ka nunna hi i kuta awm a ni a, I Dân ka theihnghilh ngai lo ve.
  </para>
  <para style="p">
    <verse number="110" style="v" />Mi sualte chuan ka awh nân thang an kam a; Mahse, i thuruat chu ka pênsan lo.
  </para>
  <para style="p">
    <verse number="111" style="v" />I thu hriattîrte chu ka kumkhaw rochan a ni a, Ka thinlung pawh a tihlim êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="112" style="v" />Kumkhuaa i dân zâwm tûrin Ka rilru ka siam fel ta.
  </para>
  <para style="p">
    <verse number="113" style="v" />Mumal nei lote chu ka hua a, I Dânte erawh chu ka ngaina e.
  </para>
  <para style="p">
    <verse number="114" style="v" />Nang chu ka bihrûkna, ka phaw i ni, I thu ka ring tlat e.
  </para>
  <para style="p">
    <verse number="115" style="v" />Thil sual titute u, min kalsan rawh u; Pathian thupêk ka zâwm dâwn a ni.
  </para>
  <para style="p">
    <verse number="116" style="v" />I tiam angin min dawm ding la, ka nung dâwn nia, Ka beisei hi tithlâwn lul suh ang che.
  </para>
  <para style="p">
    <verse number="117" style="v" />Mi chelh tlat la, ka him ngei ang, I dânte chu ka zâwm fo vang.
  </para>
  <para style="p">
    <verse number="118" style="v" />I dân pênsantute chu i duh lo va, Mi bum an tumna chu engmahlo mai a ni.
  </para>
  <para style="p">
    <verse number="119" style="v" />Leia mi sualte chu a êkchhia ang maiin i hnâwl zêl a, Chuvângin, i thu hriattîr ka ngaina ta a ni.
  </para>
  <para style="p">
    <verse number="120" style="v" />Ka hlauh che avângin ka tisa a khûr a, I rorêlte hlauvin ka khat.
  </para>
  <para style="p">
    <verse number="121" style="v" />Dik tak leh fel takin thil ka ti ṭhîn, Min tiduhdahtute kutah min pe lul suh.
  </para>
  <para style="p">
    <verse number="122" style="v" />I chhiahhlawh hi ṭanpui tiam la, Mi chapoten min nêkchêp hi phal suh.
  </para>
  <para style="p">
    <verse number="123" style="v" />I chhandamna thlîr nân ka mit a vai zo va, Chhandam i tiam kha hmuh tumin.
  </para>
  <para style="p">
    <verse number="124" style="v" />I chhiahhlawh chungah hian ngilnei takin ti la, I dânte chu min zirtîr bawk ang che.
  </para>
  <para style="p">
    <verse number="125" style="v" />I chhiahhlawh ka ni a, hriatthiam theihna min pe ang che, I thu hriattîrte chu ka hriat theih nân.
  </para>
  <para style="p">
    <verse number="126" style="v" />Lalpa , i chêt a hun ta e, I Dân an bawhchhiat hi.
  </para>
  <para style="p">
    <verse number="127" style="v" />Chuvângin, i thupêkte chu rangkachak aiin ka ngaina a, A ni, rangkachak thianghlim ber ai pawhin.
  </para>
  <para style="p">
    <verse number="128" style="v" />Tichuan, i thuruat zawng zawngte chu a zavaiin ka zâwm a, Awm dân dik lo tinrêng ka hua a ni.
  </para>
  <para style="p">
    <verse number="129" style="v" />I thu hriattîrte chu a va mak êm! Chuvâng chuan, ka zâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="130" style="v" />I thu hrilhfiahna chuan mite a tiêng a, Mi mâwlte pawh a tifing ṭhîn.
  </para>
  <para style="p">
    <verse number="131" style="v" />I thupêkte hriat châk takin, Ka âng meuhvin ka thaw huam huam a ni.
  </para>
  <para style="p">
    <verse number="132" style="v" />Ka lamah lo hawi la, min khawngaih rawh, I hming ngainatute chunga i tih fo ṭhin ang khân.
  </para>
  <para style="p">
    <verse number="133" style="v" />I tiam angin ka ke pênte hi tinghet ang che, Sualin ka chunga thu a neih phal suh ang che.
  </para>
  <para style="p">
    <verse number="134" style="v" />Min nêkchêptute kut ata hi min chhan chhuak la, I thuruatte ka zâwm dâwn nia.
  </para>
  <para style="p">
    <verse number="135" style="v" />I chhiahhlawh chungah hian i hmêl lo êng sela, I dânte chu min zirtîr bawk ang che.
  </para>
  <para style="p">
    <verse number="136" style="v" />I dânte chu an zawm duh loh avângin, Lui tui angin ka mittui hi a luang fo ṭhîn.
  </para>
  <para style="p">
    <verse number="137" style="v" />Lalpa , nang chu mi dik i ni a, I rorêl pawh a dik a ni.
  </para>
  <para style="p">
    <verse number="138" style="v" />I thu hriattîrte chu a dik a, A rin tlâk êm êm bawk.
  </para>
  <para style="p">
    <verse number="139" style="v" />Ka ṭhahnemngaihna chuan mi ei zo va, Ka hmêlmaten i thu an theihnghilh tâk avângin.
  </para>
  <para style="p">
    <verse number="140" style="v" />I thute chu finfiah vek tawh a ni, I chhiahhlawh hian a ngaina êm êm e.
  </para>
  <para style="p">
    <verse number="141" style="v" />Eng mah tham lo, hmuhsitawm tak ka ni; Mahse, i thuruatte ka theihnghilh ngai si lo.
  </para>
  <para style="p">
    <verse number="142" style="v" />I dikna hi a awm kumkhua ang a, I Dân pawh hi a ṭha reng ang.
  </para>
  <para style="p">
    <verse number="143" style="v" />Manganna leh buainain min rawn nang a; Mahse, i thupêk hian min tilâwm ṭhîn.
  </para>
  <para style="p">
    <verse number="144" style="v" />I thu hriattîrte chu a dik kumkhua dâwn a, Hriatthiamna min pe la, ka nung dâwn nia.
  </para>
  <para style="p">
    <verse number="145" style="v" />Theihtâwp chhuahin ka au che a, Lalpa , min chhâng ang che, I dânte chu ka zâwm dâwn nia.
  </para>
  <para style="p">
    <verse number="146" style="v" />Ka koh che hi, min chhandam rawh, I thu hriattîrte chu ka awih dâwn nia.
  </para>
  <para style="p">
    <verse number="147" style="v" />Khawvâr hmain ṭanpui dîlin ka au ṭhîn che, I thu ka beisei ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="148" style="v" />Ka meng tlaivâr ṭhîn e, I thu ngaihtuahin.
  </para>
  <para style="p">
    <verse number="149" style="v" />I ngilneihna avângin ka aw lo ngaithla la, Lalpa , i tih fo ṭhin ang khân min khawngaih rawh.
  </para>
  <para style="p">
    <verse number="150" style="v" />Thil sual tih chîngte chuan min rawn hnaih hi, I thu zâwm duh ngai lote chuan.
  </para>
  <para style="p">
    <verse number="151" style="v" />Lalpa , nang ka kiangah i awm a, I thupêk zawng zawngte a rin tlâk si.
  </para>
  <para style="p">
    <verse number="152" style="v" />I thu hriattîrte chu kumkhua atân i tinghet tih Hmân aṭangin ka lo hre tawh a ni.
  </para>
  <para style="p">
    <verse number="153" style="v" />Ka tuarna hi en la, min chhan chhuak teh, I Dân ka theihnghilh ngai si lo.
  </para>
  <para style="p">
    <verse number="154" style="v" />Mi sawipui la, min tlan ang che, I tiam angin min tiharh rawh.
  </para>
  <para style="p">
    <verse number="155" style="v" />Mi sualte tân chhandamna chu hla tak a ni, I dânte chu an zir duh si lo va.
  </para>
  <para style="p">
    <verse number="156" style="v" />Lalpa , ngil i nei êm êm a, I tih fo ṭhin angin min tiharh rawh.
  </para>
  <para style="p">
    <verse number="157" style="v" />Hmêlma, min ûmtute an tam hle a; Mahse, i thu hriattîr ka pênsan ngai lo ve.
  </para>
  <para style="p">
    <verse number="158" style="v" />Phattute ka hmuhin ka ten êm êm, I thu an awih duh loh avângin.
  </para>
  <para style="p">
    <verse number="159" style="v" />I thuruatte ka ngaihnatzia hi, min han en teh, Lalpa , i ngilneihna avângin min tiharh rawh.
  </para>
  <para style="p">
    <verse number="160" style="v" />I thu laipui chu thutak hi a ni, I rorêl zawng zawng chu a dik kumkhua a ni.
  </para>
  <para style="p">
    <verse number="161" style="v" />Hotute chuan chhan awm lovin min tiduhdah a, Mahse, i thu ka ngaisâng e.
  </para>
  <para style="p">
    <verse number="162" style="v" />I thu vângin ka hlim êm êm ṭhîn a, Sum tam tak chhartu ang maiin.
  </para>
  <para style="p">
    <verse number="163" style="v" />Dâwt ka hua a, ka ten a ni, I Dân erawh hi chu ka ngaina e.
  </para>
  <para style="p">
    <verse number="164" style="v" />Ni khatah vawi sarih ka fak ṭhîn che, I rorêl chu a dik êm avângin.
  </para>
  <para style="p">
    <verse number="165" style="v" />I Dân ngaihtuahtute an thlamuang êm êm ṭhîn, Eng mahin a titlu thei si lo.
  </para>
  <para style="p">
    <verse number="166" style="v" />Lalpa , i chhandamna ka nghâk reng a, I Dânte chu ka zâwm zêl a.
  </para>
  <para style="p">
    <verse number="167" style="v" />I thu hriattîrte chu ka zâwm ziah a, Ka ngaina êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="168" style="v" />I thuruat leh i thu hriattîrte chu ka zâwm zêl ṭhîn, Ka awm dân zawng zawngte i hre vek bawk.
  </para>
  <para style="p">
    <verse number="169" style="v" />Lalpa , ka au aw hi i hnên lo thleng sela, I tiam angin hriatthiamna min pe ang che.
  </para>
  <para style="p">
    <verse number="170" style="v" />Khawngaih ka dîlna hi i hnên lo thleng sela, I tiam angin min chhandam rawh.
  </para>
  <para style="p">
    <verse number="171" style="v" />Nangmah fakin ka zai ang a, I dânte chu min zirtîr ta si a.
  </para>
  <para style="p">
    <verse number="172" style="v" />Ka lei hi i thu fakin zai rawh se, I thupêk zawng zawng chu a dik a ni.
  </para>
  <para style="p">
    <verse number="173" style="v" />Min ṭanpui tûrin inpeih reng la, I thuruatte ka thlang ta si.
  </para>
  <para style="p">
    <verse number="174" style="v" />Aw Lalpa , i chhandamna ka nghâkhlel a, I dânte chu ka lâwmzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="175" style="v" />Min tinung la, ka fak ang che, I rorêl chuan min pui rawh se.
  </para>
  <para style="p">
    <verse number="176" style="v" />Berâm angin ka vâk bo va, i chhiahhlawh hi min rawn zawng teh, I thupêkte ka theihnghilh ngai si lo.
  </para>
  <chapter number="120" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka manganin Lalpa chu ka au va, Min lo chhâng ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dâwt sawi chîng leh bum hmangte lakah chuan, Lalpa , min hum ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bum hmangte u, engtianga nasain nge A sawisak ang che u?
  </para>
  <para style="p">
    <verse number="4" style="v" />In dopuite thal zum tak leh Thing chang lingin a hrem dâwn a che u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mesek-ho zînga awm ang leh Kedar-ho zînga chêng ang ka ni, A va vânduaithlâk êm!
  </para>
  <para style="p">
    <verse number="6" style="v" />Remna duh lote zîngah hian Ka chêng rei lutuk ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kei chuan inremna thu ka sawi ṭhîn a; Mahse, indo an thlang zâwk ṭhin.
  </para>
  <chapter number="121" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tlâng lamahte khian ka mit ka lên chho vang, Khawi aṭangin nge ṭanpuina ka hmuh ang?
  </para>
  <para style="p">
    <verse number="2" style="v" />Min ṭanpuina chu Lalpa , Lei leh vân Siamtu hnên aṭangin a lo thleng ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ani chuan i tlûk a phal lo vang a, Nangmah vêngtu chu a muhîl ngai lo ve.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai teh, Israel-ho vêngtu chu, A muhîl ngai lo va, a muthlu ngai hek lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpan a vêng che a, Lalpan a hliahkhuh zêl ang che.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chhûnah ni sa i tuar lo vang a, Zânah thlain a em â hek lo vang che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thil ṭha lo tinrêng lakah Lalpan a vêng ang che a, A hum tlat dâwn a che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chuan i chhuak leh lût a vêng ang che, Tûn aṭanga kumkhuain.
  </para>
  <chapter number="122" style="c" />
  <para style="p">
    <verse number="1" style="v" />‘ Lalpa inah i kal ang u,’ Ti-a min sâwm lai khân ka lâwm hle a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aw Jerusalem, i kulh chhûngah Kan kête chu a din tâk hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem, khawpui din thar, Fel taka remah chuan.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tah chuan a ni, hnamte an chhoh ṭhin ni, Lalpa hnamte chu, Israel-te thu a pêk anga a hming han fak tûrin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tah chuan a ni, Davida thlahten, Rorêlna lalṭhutthlêng an hûn ṭhin ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jerusalem khaw tân thlamuanna dîl ula, Nang ngainatute chu hmuingîl rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />I kulh chhûngah râlmuanna awm sela, I lal inahte pawh thawvenna awm rawh se.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka unaute leh ka ṭhiante avângin, ‘I chungah thlamuanna awm rawh se,’ ka ti a ni.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , kan Pathian in avângin, I ṭhatna tûr ka zawng zêl ang.
  </para>
  <chapter number="123" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw nang, vân aṭanga rorêl ṭhîntu, I lam ka rawn thlîr e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chhiahhlawhten an pu an ngaichâng ang leh, Bawihnuten an pite an nghâk ang hian, Min khawngaih hma loh chu, Kan mit pawhin Lalpa kan Pathian chu a thlîr reng dâwn a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Min khawngaih rawh, Lalpa , min khawngaih rawh, Mi min hmuhsitna kan ning ta e.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi nuamsaten min hmuhsitna leh Chapote min diriamna kan ning lutuk ta e.
  </para>
  <chapter number="124" style="c" />
  <para style="p">
    <verse number="1" style="v" />“ Lalpa chu kan lama ṭang ni suh sela chuan,
  </para>
  <para style="p">
    <verse number="2" style="v" />Miten min beih lai khân Kan lama ṭang chu Lalpa ni suh sela,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kan chunga an thinur a sosân laite khân, A nung chungin min dawlh tawh ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tui lianin min lain Lui lian chuan min chîm pil tawh ang,
  </para>
  <para style="p">
    <verse number="5" style="v" />Tui lian so bulh bulh chuan Min vûr pil tawh ngei ang,” Israel-te chuan ti ngei rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa i fak ang u, Hmêlmaten min sehsawm a phal lo va,
  </para>
  <para style="p">
    <verse number="7" style="v" />Thangkamtu thang ata sava angin min chhuah ta, Thang chu a tichhia a, keini kan chhuak ta a ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lei leh vân Siamtu Lalpa chuan, A hming avângin min rawn pui ta.
  </para>
  <chapter number="125" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa ringtute chu, Zion tlâng tihnghîn rual loh, Kumkhuaa awm rêng tûr ang hi an ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jerusalem khua chu tlângin a hual ang hian, A mite chu Lalpan a kal hual ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi sualte chu mi dikte ramah chuan An lal reng dâwn si lo, Mi dikte chuan thil sual an tih ve loh nân.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aw Lalpa , mi ṭhate leh thinlung ngîlte chungah chuan, Thil ṭha ti ve ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sual kawng zawhtute Lalpan a hruai bo hunah chuan, Thil sual titute chu a hruai tel ang. Israel-te hnênah rem lêng rawh se.
  </para>
  <chapter number="126" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpan Zion-a min hruai kîr leh lai khân, mumang emaw kan ti.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kan nui hawm hawm a, Hlimin kan au chêl chûl bawk a. ‘ Lalpan an tân thil ropui tak a tihsak a nih hi,’ Hnam dangte chuan an ti.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpan thil ropui tak min tihsak a, Kan hlim êm êm a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpan sala kan tâng min hruai kîr leh ta a, Thlalêra lui tui a luang leh ta ang hian.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mittui tla chunga tuhtute chuan Hlim takin an seng a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ṭap chungin buh chi feh chhuahpui mah sela, An buhphalte kengin hlim takin an lo haw leh ang.
  </para>
  <chapter number="127" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpan in a sak loh chuan, A satute an hah thlâwn mai a ni. Lalpan khawpui a vên loh chuan, A vêngtute an meng thlâwn mai a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ei tûr zawnga zîng tak taka thawha, Tlai tak taka mut hi a hahthlâk thlâwn a ni. Lalpan a hmangaihte chu Malsâwmna a pe mai ṭhîn a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Fanaute hi Lalpa hnên ata kan rochan an ni a, Rîla rahte hi kan lâwmman dawn a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kan vânglai fate chu indo mite thal ang hi an ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thal bâwm chutianga khat nei chu an nihlawh e, Kulh kawngkaa hmêlma an tawn hunah An mualpho hauh lo vang.
  </para>
  <chapter number="128" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa ṭihtu zawng zawngte chu an nihlawh e, A kawng zawh ṭhînte chu.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thawhrim rah i ei ang a, I hlimin i hmuingîl ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />I nupui chu i in chhûngrilah, Grep rah duh tak ang hi a ni ang a, I fate pawh oliv tuai ang, Chawhlui kîla ṭhu kual pup tham an ni bawk ang.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hetiang hian Lalpa ṭihtute chuan, Malsâwmna an dawng ngei ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zion aṭangin Lalpan mal a sâwm ang che a, I dam chhûng zawng Jerusalem hmuingîlna chu i chang ve ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />I tute hmêl hmuin i dam bawk ang. Israel-te hnênah rem lêng rawh se.
  </para>
  <chapter number="129" style="c" />
  <para style="p">
    <verse number="1" style="v" />‘Ka naupan lai ata miten min va tiduhdah ṭhîn tak êm!’ Israel-hovin ti rawh se.
  </para>
  <para style="p">
    <verse number="2" style="v" />‘Ka naupan lai ata miten min va tiduhdah ṭhîn tak êm! Mahse, tu man min titlâwm thei si lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Leilettuin lei a rîn thlûr angin, Ka hnungzâng hi an rîn thlûr seng sung mai.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa chu a dik a, Mi sualte hruihrual chu mi zai chahsak ta e,’ Israel-ten ti ngei rawh se.
  </para>
  <para style="p">
    <verse number="5" style="v" />Zion hawtu zawng zawngte chu Mualphovin, tlânchhe haw daih rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />A ṭhan sân hmaa vuai mai ṭhîn, In chung zâwla hlobet ang hi ni vek rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu man chu chu an la khâwm ngai lo va, Seng tûr pawhin an têl hek lo.
  </para>
  <para style="p">
    <verse number="8" style="v" />A bul hnaia kalte pawhin, ‘ Lalpan malsâwm che u rawh se, Lalpa hmingin mal kan sâwm a che u,’ An ti ngai bawk hek lo.
  </para>
  <chapter number="130" style="c" />
  <para style="p">
    <verse number="1" style="v" />Manganna khur thûk tak aṭangin, Lalpa , ka au va che, Lalpa , ka aw hi ngaithla teh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khawngaih ka dîlna hi, Min ngaihthlâksak ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , sualnate i chhinchhiah zêl chuan, Lalpa , tu nge thiam chang zo vang?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang chuan sual i ngaidam ṭhîn a; Tichuan, miten an zah ṭhîn che a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa chu ka nghâk ṭhîn, A ni, ka nghâk reng ṭhîn a ni. A thu pawh ka ring a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Râlvêngtuten khawvâr an nghahhlelh aia nasain, A ni, râlvêngtuten khawvâr an nghahhlelh aia nasa mahin, Nghâkhlel takin Lalpa ka thlîr a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel-te u, Lalpa hi ring rawh u, Lalpa chu ngilnei tak a ni a, Chhandam a peih reng bawk.
  </para>
  <para style="p">
    <verse number="8" style="v" />An bawhchhiatna zawng zawng ata, Israel-te a chhan chhuak ang.
  </para>
  <chapter number="131" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , ka rilru a chapo ta lo va, Ka inngaihlu hek lo. Thil lian thamah ka intelh duh lo va, Ka phu loh thilahte chuan.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka lung a awi ta a, Ka hah a dam ta e. Nausên hnute hne lai a nuin a pawm hle hle ang hian, Kei pawh thlamuang takin ka awm ta e.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel-te u, Lalpa chu ring rawh u, Tûn aṭanga kumkhuain.
  </para>
  <chapter number="132" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , Davida hi a hrehawm tuarna zawng zawng Hriatpui ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa hnênah thu a tiam a, Jakoba Mi Chaka hnêna a intiamkam kha Hriatpui ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />‘Ka in chhûngah ka lût lo vang a, Ka khumah pawh ka kai hek lo vang;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka muhîl lo vang a, Ka maimitchhîng hek lo vang,
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa tân hmun ka hmuh hma leh, Jakoba Mi Chaka chênna tûr hmun ka neih hma chu,’ A tih kha.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai teh u, Efrata-ah a awm tih kan hria a, Jaar phûlah kan va hmu ta.
  </para>
  <para style="p">
    <verse number="7" style="v" />A awmnaah kal ila, A ke bulah i kûn ang u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , tho la, i chawlhna tûr hmunah kal rawh. I chakzia lanna Bâwm nên chuan.
  </para>
  <para style="p">
    <verse number="9" style="v" />I puithiamte chu diknain inthuam se, Nangmah ngaihsaktute chu lâwmin au chiam rawh se.
  </para>
  <para style="p">
    <verse number="10" style="v" />I chhiahhlawh Davida hnênah thu i tiam tawh si a, I hriakthiha hi tilunghnûr suh ang che.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lalpan Davida hnênah thu a tiam tlat tawh chu, A rinawm a, a sût lo vang.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘I fate chuan ka thuthlung an pawma, Ka thu zirtîrte an zawm bawk chuan, An fate pawh i lalṭhutthlêngah chuan An ṭhu zêl ang,’ a tih kha.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpan Zion tlâng hi a thlang ta a, A chênna hmun atân a duh a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />‘Hei hi ka kumkhaw chawlhna tûr a ni, Ka awm reng nân ka duhzâwng tak a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ei leh bâr kawngah mal ka sâwm ngei ang che a, A mi, retheite pawh ka hrai tlai ang.
  </para>
  <para style="p">
    <verse number="16" style="v" />A puithiamte chhandamnain ka thuam ang a, A mi thianghlimte pawh hlim takin an au vang.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tah chuan, Davida thlah lal ropui tak ka ṭhuttîr ang, Ka hriakthiha tân chuan khâwnvâr ka chhi ta e.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hmêlmate ka timualpho vang a, A lallukhum ka tihtlêtsak bawk ang.’
  </para>
  <chapter number="133" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ngai teh, unau inngeihdial diala awm khâwm hi A va ṭhain, a va nuam êm!
  </para>
  <para style="p">
    <verse number="2" style="v" />Hriak rimtui, lu-a thih, Khabehmula luang thla ang hi a ni. Arona khabehmula luang thla, A kawrfual nghâwng thlenga luang thla ang kha.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hermon dai fîm, Zion tlânga tla ṭhîn ang hi a ni. Chutah chuan a ni Lalpan malsâwmna a thlen ṭhin ni, Kumkhuaa nunna tûr chu.
  </para>
  <chapter number="134" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hawh u, Lalpa chhiahhlawh zawng zawng, Zâna Lalpa ina rawngbâwl ṭhînte u, Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hmun Thianghlimah in bânte phar ula, Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lei leh vân siamtu Lalpa chuan, Zion aṭangin malsâwm che u rawh se.
  </para>
  <chapter number="135" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u; Lalpa hming chu fak ula, Lalpa chhiahhlawhte u, fak rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa ina rawngbâwla, Kan Pathian in hung chhûnga che ṭhînte u, Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa chu fak rawh u, ani chu a ṭha si a. A hming fakin zai rawh u, a nuam si a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpan Jakoba chu a thlang ta a, Israela chu a ta bîk atân a nei ta e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa ropuizia hi ka hre ta e, Kan Lalpa hi Pathian dang zawng zawng aia ropui zâwk a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lei leh vânah te, tuipuiah leh tuifinriatah te, Lalpan a duh apiang a ti ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kâwlkil aṭangin chhûm a chhohtîr a, Ruah sûr nân kâwl a phêttîr a, A bâwm ata thli a rawn chhuah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aigupta rama mihringte leh rante chu, An fa tîr a tihhlumsak a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aigupta ramah, Farawa leh a chhiahhlawhte hrem nân, Chhinchhiahna leh thil mak tak tak a tih kha.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ani chuan hnam tam tak a tichhia a, Lal ropui tak takte a that bawk.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amor lal Sihona te, Basan lal Oga te, Kanan ram lal zawng zawngte nên.
  </para>
  <para style="p">
    <verse number="12" style="v" />An ramte chu a mite a pe a, A ni, Israel-te rochan atân a pe.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa , i hming chu kumkhuain a dai lo vang, Chhuan zawng zawngin, Lalpa , an hria ang che.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa chuan a mite chu thiam a chantîr a, A chhiahhlawhte chungah khawngaihna a lantîr ta,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hnam dangte pathian chu mihring kutchhuak, Rangkachak leh tangkaruaa siam an ni e.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka an nei a, an ṭawng thei si lo va, Mit an nei a, an hmu thei bawk si lo.
  </para>
  <para style="p">
    <verse number="17" style="v" />Beng an nei a, eng mah an hre thei lo va. Thâwk pawh an thaw thei hek lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chûng ringtu leh siamtu zawng zawngte chu, Chûng milem ang lek chu ni hlawm rawh se.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw, Israel chhûngte u, Lalpa chu fak rawh u, Aw, Arona chhûngte u, Lalpa chu fak rawh u,
  </para>
  <para style="p">
    <verse number="20" style="v" />Aw, Levia chhûngte u, Lalpa chu fak rawh u, Lalpa ṭihtute u, Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zion-ah chuan Lalpa chu fak ula, Jerusalem-a chêng Lalpa chu fak rawh u.
  </para>
  <chapter number="136" style="c" />
  <para style="p">
    <verse number="1" style="v" />A ṭhat avângin Lalpa chu lâwmthu hrilh rawh u, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathiante Pathian chu lâwmthu hrilh rawh u, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalte lal chu lâwmthu hrilh rawh u, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mahni chauhva thil mak ropui tak titu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="5" style="v" />A finnaa vân siamtu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tui chunga lei dah duaitu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Êng lian pui puite siamtu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ni khi chhûna êng tûra siamtu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thla leh arsite zâna êng tûra siamtu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aigupta mite fa tîr thattu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Chuta ṭanga Israel fate hruai chhuaktu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bân phar meuhva a kut lektu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuipui Sen pawh tiṭhentu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel-te hruaikaitu chuan, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuipui Sena Farawa leh a sipaite tihlumtu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="16" style="v" />A mite thlalêra hruaitu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lal tam tak thattu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lal hmingthang tak takte thattu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amor lal Sihona thattu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Basan lal Oga thattu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="21" style="v" />An ram, a mite petu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="22" style="v" />A chhiahhlawh Israel-te hnêna rochana petu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kan baihvai laia min hruaitu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kan hmêlmate laka min chhantu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thil nung tinrêng hnêna ei tûr pe ṭhîntu khân, Ngil a nei kumkhua si a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vâna Pathian chu lâwmthu hrilh rawh u, Ngil a nei kumkhua si a.
  </para>
  <chapter number="137" style="c" />
  <para style="p">
    <verse number="1" style="v" />Babulon lui kamahte kan ṭhu a, Zion ngaiin kan ṭap ṭhîn.
  </para>
  <para style="p">
    <verse number="2" style="v" />A kam tuipuisuthlahahte chuan Kan ṭingṭangte kan bâng ṭhîn a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tah chuan sala min mantuten Hla sa tûrin min phût a, Min tiretheituten hlima hla sa tûrin min ti, ‘Zion hla min saksak ta che u,’ tiin.
  </para>
  <para style="p">
    <verse number="4" style="v" />Engtin nge mi ramahte chuan Lalpa tân hla kan sak theih ang?
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Jerusalem, ka theihnghilh che chuan, Ka kut ding lam hian a thil thiamte theihnghilh rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aw Jerusalem, ka hriat reng loh che-a, Ka hlimna ber aia ka thlan zâwk loh che chuan, Ka lei pawh hi ka dangah hian bet tlat rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jerusalem a chhiat nia, Edom miten, ‘Tichim rawh u, tichim rawh u, A lungphûm chenin tichhe rawh u,’ an tih kha, Aw Lalpa , a chhe lamin hre reng ang che.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw nang Babulon, mi dang tichhe ṭhîntu, Ka chunga i tih ang taka thungrûltu che chu A va hlim dâwn êm!
  </para>
  <para style="p">
    <verse number="9" style="v" />I fa sênte chhuhsaka, lungpui vuak nâna hmangtu chu A va hlim dâwn êm!
  </para>
  <chapter number="138" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka thinlung zawng zawngin Lalpa , lâwmthu ka hrilh a che, Hnam dang pathian hmaah nangmah fakin ka zai ang.
  </para>
  <para style="p">
    <verse number="2" style="v" />I Tempul thianghlim lam hawiin chibai ka rawn bûk a che, I ngilneihna leh i rinawmna avângin I hming ka fak a ni. I thu leh i hming chu, I chawisâng ta ber a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka koh che khân min lo chhâng a, Min tihuaiin min tichak ta.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa , lei lal zawng zawngte hian an fak a che, I thu an hriat tâk avângin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa thil tihte fakin hla sa rawh u, Lalpa ropuina hi a nasa êm si a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chu ropui hle mah se, Mi tlâwmte chu a ngaihsak a, Chapote erawh chu hla tak aṭang pawhin a hmu a ni.
  </para>
  <para style="p">
    <verse number="7" style="v" />Buainaten min chîm vêl mah sela, Ka nun i humhim ṭhîn. Ka hmêlmate thinur lo thawk chu i dang kîr a, I kut ding lamin min chhan ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , ngil i nei kumkhua a, Lalpa , i kut hnathawh bânsan lo la, Ka tân i thiltih tum hlen zâwk ang che.
  </para>
  <chapter number="139" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , nangmah ngeiinngun takin mi en fiah a. Min hre chhuak vek a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ṭhut leh ka din i hre vek a, Hla tak aṭang pawhin ka ngaihtuahte i hria.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka kalna te, ka chawlhna te i hre chiang a, Ka awm dân zawng zawng hi i hre fai vek a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ngai teh, Lalpa , ka sawi hma pawhin ka sawi tûr zawng zawng chu i hre vek si.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka hma hruaiin ka hnu i dâl a, I kutphahin min hûm tlat ṭhîn.
  </para>
  <para style="p">
    <verse number="6" style="v" />Min hriatzia hi a mak lutuk a, Ka tân hriat phâk rual a ni lo.
  </para>
  <para style="p">
    <verse number="7" style="v" />I hnên ata khaw nge ka kal anga, I hmuh lohvah khaw nge ka tlân bo vang?
  </para>
  <para style="p">
    <verse number="8" style="v" />Vânah han lâwn ila, i lo awm a, Seol-ah mutna zu siam ila, i lo awm reng bawk si.
  </para>
  <para style="p">
    <verse number="9" style="v" />Chhaktiangah khian thlâwk chho ila, Tuifinriat râl daihah pawh zu awm ila,
  </para>
  <para style="p">
    <verse number="10" style="v" />I kut chuan min lo vuan ang a, I kut ding lam chuan min lo chelh dâwn si.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Thimin min khuh tlat se, Ka vêl êng hi zânah chang se,’ ti mah ila,
  </para>
  <para style="p">
    <verse number="12" style="v" />Thim hi i tân a thim ve si lo, Zân pawh chhûn angin a êng a, Thim leh êng hi i tân thuhmun reng a ni.
  </para>
  <para style="p">
    <verse number="13" style="v" />A ni, ka taksa pêng tin hi i siam a ni, Ka nu pum chhûngah min rem khâwm a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aw Chungnungber, ka fak a che, Hlauhawm tak i ni si a, Mak taka siam ka ni; I thiltih hi a mak êm êm a, Ka hre chiang hle a ni.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka ruhrel hi i lakah thup a ni lo, A rûka siam ka nih lai leh Lei chhûngrila min rem khâwm lai pawh khân.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kutke ka neih hma pawhin mi hmu vek a, Ka dam chhûng ni tûrte a inṭan hma daihin, I lehkhabu-ah chuan ziak vek a ni.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Pathian, i mi ngaihtuahnate chu ka tân a va hlu êm! Chhiar sên rual a ni lo.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chhiar dâwn ila, ṭiauvaivut aia tam a ni a, Ka han harh chuan i kiangah ka lo awm reng si.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Pathian, mi sualte hi that mai teh, Thisen chhuah mite u, min kalsan daih rawh u.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chûng chuan an sawichhe ṭhîn che a, Nangmah dotute chuan an tinawmnah ṭhîn che.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aw Lalpa , nangmah hawtute chu ka va haw êm! I chunga helte chu ka va ten êm!
  </para>
  <para style="p">
    <verse number="22" style="v" />Huat tak têin ka hua a, Ka hmêlmaah te ka chhiar hlawm a.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aw Pathian, mi en fiah la, Ka rilru hi hre tlang ang che. Mi en ngun la, ka ngaihtuahte hi hre vek ang che.
  </para>
  <para style="p">
    <verse number="24" style="v" />Keimahah hian dik lohna rêng a awm emaw en la, Chatuan kawngah min hruai ang che.
  </para>
  <chapter number="140" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , mi sual lakah mi chhan chhuak la, Mi nunrâwng lakah mi humhim ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil sual tih an rilrûk reng a, Ni tin buaina an chawk chhuak ṭhîn.
  </para>
  <para style="p">
    <verse number="3" style="v" />An lei chu rûl tûr ang hian a hlauhawm a, An thu chu rûlrial tûr ang hi a ni.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lalpa , mi sual lakah min vêng la, Tihtlûk tuma min bei ṭhîntu Mi nunrâwngte lakah min hum ang che.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chapote chuan ka awh nân hruihrualin thang an kam a, Ka kalkhânah lên an zâr a, Kawng tluanin thang an kam a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa hnênah, ‘ka Pathian i ni e, Lalpa , khawngaih ka dîlna hi lo ngaithla teh,’ ka ti a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aw Lalpa , ka Lalpa , chhandamtu chak, Indo nia min humhimtu i ni.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa , mi sualte duhthusâm chu hlawhtlintîr suh la, An thiltum chu puitlin suh se.
  </para>
  <para style="p">
    <verse number="9" style="v" />Min hualtute lu chungah chuan, Min vauna chu tla zâwk rawh se.
  </para>
  <para style="p">
    <verse number="10" style="v" />An chungah meiling sûr se, Leilâwtah tla sela, Lo chhuak leh tawh suh se.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dâwta mi hêk chîngte chu hlawhtling suh se, Nunrâwngte chu thil ṭha lovin nangchîng sela, Nuai nek hlawm rawh se.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lalpa , retheite chu i ṭan ṭhîn tih ka hria, Pachhiate tân dik takin ro i rêl ṭhîn.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi dikte chuan i hming an fak ang a, Mi nun ngîlte chu i bulah an chêng reng ang.
  </para>
  <chapter number="141" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , ka koh che hi, lohmanhmawh la, Ka auh che hi, i beng lo chhi ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka ṭawngṭaina hi rimtui hâl angin lo chho sela, Ka kut phar hi tlai lam thilhlan angin lo pawm ang che.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , ka kâ vêngtu tûr ruat la, Ka hmui vêng tûr min pe ang che.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ṭhil ṭha lo tih châkna lakah min vêngin, Mi sualte zînga thil sual ka tih ve phal suh la, Thil sual tih chîngte ruai ṭheh ka kîl ve phal hek suh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi dik chuan min khawngaih avângin Min vua-in, min zilh rawh se, Chu chu hriak ṭha ber a ni, Ka lu hian hnar suh se. Mi sualte thiltih do erawh chuan ka ṭawngṭai reng a ni.
  </para>
  <para style="p">
    <verse number="6" style="v" />An rorêltute chu khâma nam thlâk an nih hunah, Ka thu chu pawm nuam an ti ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Leilettuin lei a tisawm nuai ang hian Ka ruhte pawh thlân kotlângah a darh tâk hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Lalpa , ka Lalpa , kei chuan ka thlîr rêng che a ni, Ka rawn bêl che a, saruakin min kalsan suh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thil sual titute thang lakah te, Ka awh nâna lên an zâr lakah te chuan min hum ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sualte chu anmahni thang kamah chuan âwk sela, Kei chu him thên ila ka va ti êm!
  </para>
  <chapter number="142" style="c" />
  <para style="p">
    <verse number="1" style="v" />Râwl chhuah meuhvin Lalpa chu ka au va, Lalpa hnênah khawngaih dîlin ka au va ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka manganna a hnênah ka thlen a, Ka rilru buaina pawh ka hrilh vek bawk.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka beidawn êm êm lai pawhin Nang chuan ka awm dân tûr i hria, Ka kalna tûrah chuan, Ka hmêlmaten thang an kam ru.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka vêl hi han thlîr la, Tu mah mi ngaihsak rêng an awm lo ve, Belh tûr ka hmu lo va, Tu mah mi ngaihven an awm lo.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lalpa , ṭanpui dîlin ka au che a, ‘Nang chauh hi ka himna, Ka dam chhûnga ka duh ber chu i ni,’ tiin.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka au thâwm chu ngaithla ang che, Ka chau êm êm a ni, Mi ûmtute lakah min chhanhim rawh, Kei aiin an chak zâwk si a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tân in ata min hruai chhuak la, I hming ka chawimawi ang. Ka chunga i ṭhat êm avângin Mi dikte chuan min din hual ang.
  </para>
  <chapter number="143" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa , ka ṭawngṭaina hi lo ngaithla la, I rinawm êm avângin khawngaih ka dîlnaah I beng lo chhi ang che. I dik êm avângin min chhâng ang che.
  </para>
  <para style="p">
    <verse number="2" style="v" />I chhiahhlawh chungah hian rorêl mai suh, I hmaah tu mah thiam chang thei an awm lo.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka hmêlmaten min ûm ṭhîn a, Thi chhâwngin leiah min theh thlu a, Hmânlaia thi tawhte angin Hmun thimah chuan min awmtîr hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka bei a dawng êm êm a, Ka mangang tâwp a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hun kal tate ka thlîr kîr a, I thil tih zawng zawngte ka ngaihtuah a, I hna thawhte ka chhûtin
  </para>
  <para style="p">
    <verse number="6" style="v" />I lam hawiin ka bân ka phar tâk hi, Lei ro, tui châk angin ka ngai a che.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lalpa , min chhâng thuai teh, Ka chau chhe mai dâwn e; Ka lakah hian i hmêl thukru suh la, Leilâwta tlate ang ka ni hlauh dah ang e.
  </para>
  <para style="p">
    <verse number="8" style="v" />I ngilneihzia tûk tin min hmuhtîr ṭhîn la, Ka rinchhan ber nang i ni si a, I hnênah ka rawn ṭawngṭai hi, Ka kalna tûr min kawhhmuh rawh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa , ka hmêlmate kut ata hi min chhan chhuak la, Him nân ka rawn pan che.
  </para>
  <para style="p">
    <verse number="10" style="v" />I duhzâwng tih min zirtîr rawh, Ka Pathian i ni si. Dawh thei takin kawng dikah chuan i Thlarauvin min hruai ang che,
  </para>
  <para style="p">
    <verse number="11" style="v" />I hming avângin, Lalpa , min chhandam la, I ṭhatna avângin ka manganna ata min chhan chhuak ang che.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka chunga i ngilneihna avângin ka hmêlmate tiboral la, Min beitu zawng zawngte tichhia ang che, I chhiahhlawh ka ni si a.
  </para>
  <chapter number="144" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka lungpui, Lalpa hi fak rawh u, Râl kah min zirtîr a, Indo dân tûr min thiamtîr bawk a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka tân kulhpui rinawm, Ka himna tûra kulhbîng sâng a ni. Ka phaw ka inhumhimna chu a ni, Ka mite ka hnuaia kûntîrtu a ni.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa , mihringte hi eng nge maw an niha, i hriata, Hringfate hi eng nge maw an niha i ngaihtuah ṭhin?
  </para>
  <para style="p">
    <verse number="4" style="v" />Thli thaw ang lek an ni a, An dam chhûng nite chu hlim ral mai ṭhîn ang hi a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw Lalpa , i vânte chu rawn tihniam la, Lo chhuk ta che. Tlângte khawih la, khu luih luih bawk rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kâwl phêttîr la, hmêlmate chu darh vek sela, Thalin kâp la, tlânchhe rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Vân sâng aṭangin i kutin rawn ban la, Tui thûk tak ata min chhan chhuakin, Hnam dang kut ata hi min chhanhim teh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Chûng mite chuan dâwt an heh a, Dâwtin chhia an chham ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aw Pathian, i tân hla thar ka sa ang a, Perhkhuang hrui sâwm neiin ka fak ang che.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalte hnênah hnehna i pe a, I chhiahhlawh Davida chu khandaih hriam lakah I chhanhim ta si a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hnam dang kut ata hi min chhan chhuakin, Min humhim ang che. Chûng mite chuan dâwt an heh a, Dâwtin chhia an chham ṭhîn.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kan fate chu an vânglai hian, Thing ṭhang duang tak ang hi ni se, Kan fanute pawh chu Lal ina a kil bang cheimawi ang hi lo ni rawh se.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kan buhzêmte chu thlai tinrêngin khat thûr thûr se, Kan ram chhûnga kan berâm vulh te pawh, A sâng têl te, a sîng têl tein pung bawk rawh se.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kan ran rualte chuan no chhiat lovin hring sup sup sela, Riral bawk hek suh se. Kan kawtthlêrahte pawh mangang au thâwm awm hek suh se.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chutiang taka malsâwmna dawng hnam chu an nihlawh e. Pathian, Lalpa neitu hnam chu a nihlawh e.
  </para>
  <chapter number="145" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aw Lalber, ka Pathian, ka chawimawi ang che a, I hming ka fak kumkhua dâwn e.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni tin ka fak ang che a, I hming ka chawimawi kumkhua ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lalpa chu a ropui a, chawimawi chiam tûr a ni; A ropuizia chu chhui chhuah rual a ni lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />I thil tihte chu chhuan zawng zawngin an fak ang a, I hna thawhte an hril zêl ang.
  </para>
  <para style="p">
    <verse number="5" style="v" />I ropui nasatzia an hril ang a, I thiltih makzia hi ka chhût bawk ang.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miten i thiltihtheihzia hi nasa takin an sawi ang a, I ropuizia ka hril bawk ang.
  </para>
  <para style="p">
    <verse number="7" style="v" />I ṭhatzia hi an sawi bawrh bawrh ang a, I dikzia hi hlim takin an aupui ang.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpa chuan lainatna a ngah a, mi a khawngaih ṭhîn, Thinnel tak a ni a, ngil a nei êm êm ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa chu mi tin chungah a ṭha a, A thil siam zawng zawng chu a lainat ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw Lalpa , i thil siamten an chawimawi chia, Nangmah ngaihsaktute chuan an fak a che.
  </para>
  <para style="p">
    <verse number="11" style="v" />I ram ropuizia chu an sawi ang a, I thiltihtheihzia pawh an hril bawk ang.
  </para>
  <para style="p">
    <verse number="12" style="v" />I thiltih ropuizia mihringte hnêna hriattîr tûr leh I ram mawi ropuizia tilang tûrin.
  </para>
  <para style="p">
    <verse number="13" style="v" />I ram chu ram hlun tûr a ni a, Kumkhuain thu i nei dawn si. Lalpa chu a thutiamah a rinawm a, A thiltih apiangah ngil a nei ṭhîn.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lalpa chuan tlute a tungding a, Lungngaia kûnte pawh a tiharh ṭhîn.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmah nghâktute mit chu i chungah a fu a, A hun takah ei tûr i pe ziah ṭhîn.
  </para>
  <para style="p">
    <verse number="16" style="v" />I kut i han phar a, Thil nung tinrêng an chaw duhzâwngin i hrai ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lalpa chu a thil tih zawng zawngah a dik a, A thiltih apiangah ngil a nei ṭhîn.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah kotute chu Lalpan a hnaih ṭhîn a, Tihtakzeta amah autu zawng zawngte chu.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah ṭihtute duhzâwng chu a tihsak a, An au thâwm a hria a, a chhanhim ṭhîn.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lalpa chuan amah hmangaihtute a vêng ṭhîn a, Mi sualte erawh chu a tiboral ang.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka kâ hian Lalpa fakna thu a hril ang a, Thilsiam zawng zawngin a hming thianghlim chu Kumkhuain fak rawh se.
  </para>
  <chapter number="146" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Aw ka nunna, Lalpa chu fak rawh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka dam chhûngin Lalpa ka fak ang a, Ka nun chhûng zawng Pathian fakin ka zai ang.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihring zînga miliante chu ring duh suh u, Tu mah an chhandam thei si lo.
  </para>
  <para style="p">
    <verse number="4" style="v" />An thi a, leiah an kîr ta a, Chumi ni chuan an thiltum zawng zawng pawh a ral nghâl ṭhîn.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakoba Pathian, ṭanpuitua neihte chu an nihlawh e, Lalpa Pathiana beiseina nghattute chu.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ani chuan lei leh vân a siam a, Tuifinriat leh a chhûnga awmte nên; A thutiam pawh a hlen zêl ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hnehchhiahte chu dik takin ro a rêlsak a, Rilṭâmte chu chaw a pe a, Lalpa chuan mi tângte a chhuah bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lalpan mitdelte mit a tivâr a, Lalpa chuan lungngaia kûnte pawh a tiharh ṭhîn.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalpa chuan mi dikte a hmangaih a, Lalpa chuan mikhualte pawh a vêng bawk ṭhîn. Fahrahte leh hmeithaite chu a chhawmdâwl ṭhîn a, Mi sualte erawh chu a tiboral ang.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalpa chu kumkhuain a lal ang a, Aw Zion, i Pathian chu a lal reng ang. Lalpa chu fak rawh u.
  </para>
  <chapter number="147" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Kan Pathian faka zai hi a ṭha si a; Amah fak hi a nuam a ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalpa chuan Jerusalem a din leh a, Israel mi, an hnawh darhte chu a hruai khâwm leh ta.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lungchhiate chu a thlamuan a, An hliamte pawh a tuamsak bawk.
  </para>
  <para style="p">
    <verse number="4" style="v" />Arsite khi a chhiar vek a, An hming pawh a sa ṭheuh a ni.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kan Lalpa hi a ropui a, chak tak a ni, A finna pawh sawi sên rual a ni lo.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lalpa chuan inngaitlâwmte a chawisâng a, Mi sualte erawh chu leiah a paih thlu ṭhîn.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lâwm hla sa-in Lalpa chu fak ula, Ṭingṭang nên kan Pathian fakin zai rawh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vân khi chhûm a hliahtîr a, Leiah ruah a sûrtîr ṭhîn a, Tlângahte chuan hnim a ṭotîr ṭhîn, Mihring ei tûr thlai hringte nên.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ramsate chu chaw a pe a, Choak no rilṭâmte a châwm bawk ṭhîn.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sakawr chakna a ngaihlu lo va, Mihring chakna pawh a ngaisâng hek lo.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah ṭihtute hi a ni Lalpa lâwmzâwngte chu, A ngilneihnaa innghat tlatte chu.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aw Jerusalem, Lalpa -ah hian lâwm la, Aw Zion, i Pathian hi fak rawh.
  </para>
  <para style="p">
    <verse number="13" style="v" />I kulh kawngkhâr kalhnate chu a tinghet a, I chhûnga awm i fate chu mal a sâwm ta.
  </para>
  <para style="p">
    <verse number="14" style="v" />In ramrite chu a tirâlmuang a, Buh tui chi in duh tâwkin a pe che u.
  </para>
  <para style="p">
    <verse number="15" style="v" />A thupêk chu lei chungah a puang a, A sawi ang chuan tih nghâl a ni.
  </para>
  <para style="p">
    <verse number="16" style="v" />Puan vâr phah ang maiin vûr a tlâktîr a, Meivâp lêng angin a tlâktîr chem chem ṭhîn.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lung tê angin rial a tlâktîr a, A vawhzia chu tu nge tuar zo vang?
  </para>
  <para style="p">
    <verse number="18" style="v" />Thu a pe a, vûr chu a tui ta a, Thli a tlehtîr a, tui chu a luang ta a.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakoba hnênah thu a puang a, A Dân leh a thurêl chu Israela a hriattîr a;
  </para>
  <para style="p">
    <verse number="20" style="v" />Chûng chu hnam dang tân a ti ngai rêng rêng lo va, A thurêlte pawh an hre ve ngai hek lo.
  </para>
  <chapter number="148" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Vân aṭangin Lalpa chu fak ula, Chung lamahte khian amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Vântirhkohte u, amah chu fak ula, A ṭhuihruai zawng zawngte u, amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni leh thlate u, amah chu fak ula, Arsi êng zawng zawngte u, amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vân sângte u, amah chu fak ula, Vân chunga tuite u, amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Chûngho chuan Lalpa hming chu fak rawh se, Ani chuan thu a pe a, siam an lo ni ta si a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thu a pêk ang ngeiin An awmna tûr ṭheuhvah an awm ta reng a, Kumkhua pawhin an insawn lo vang.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuifinriat leh a chhûnga chêng sa lian hlauhawmte u, Lei aṭang hian Lalpa chu fak rawh u.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mei leh rial te, vûr leh chhûm te, Thlipui na tak, a thu awihtu te leh
  </para>
  <para style="p">
    <verse number="9" style="v" />Tlâng leh mual te, Thei kûng leh sidar thing zawng zawng te,
  </para>
  <para style="p">
    <verse number="10" style="v" />Ramsa te leh ran zawng zawng te, Rannung te leh chunglêng sava te,
  </para>
  <para style="p">
    <verse number="11" style="v" />Lei lal te leh mi tinrêng te, Milian te leh leia rorêltu zawng zawng te,
  </para>
  <para style="p">
    <verse number="12" style="v" />Nula leh tlangvâl te, Naupang leh tar te nên,
  </para>
  <para style="p">
    <verse number="13" style="v" />Lalpa hming hi fak ṭheuh rawh se, Hming dang zawng aiin a hming chu a ropui zâwk a, A ropuina chu lei leh vân aiin a sâng zâwk daih a ni.
  </para>
  <para style="p">
    <verse number="14" style="v" />A mite chu thiltihtheihnain a thuam a, A ni, amah ngaihsaktute chu chawimawina a khumtîr a, A duh tak Israel mite chu. Lalpa chu fak rawh u.
  </para>
  <chapter number="149" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Lalpa chawimawiin hla thar sa ula, A ni, amah ngaihsaktute pung khâwm zîngah fak hla sa rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />Anmahni Siamtu chungah Israel-te lâwm sela. Zion tlâng chu an Lalber chungah hlim rawh se.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lâmin a hming chu fak ula, Khuangtê leh ṭingṭang nên amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />A mite chu Lalpa lâwmzâwng tak an ni a, Mi tlâwmte chu a chhanhim a, a chawimawi ta.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah ngaihsaktute chu an ropuinaah lâwm sela, An khumlaizâwlah chuan hlim takin zai rawh se.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khandaih hriam tawn keng sela, Pathian fakin ring takin au rawh se.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hnam dang chungah phuba a la a, Mite a hrem ta a.
  </para>
  <para style="p">
    <verse number="8" style="v" />An lalte chu khaidiatin a hlîng a, An hotute chu thîr kawl a buntîr bawk.
  </para>
  <para style="p">
    <verse number="9" style="v" />An chungchâng thu rêl tawh angin a thlentîr a, Chu chu a ni amah ngaihsaktute ropuina chu. Lalpa chu fak rawh u.
  </para>
  <chapter number="150" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lalpa chu fak rawh u, Pathian chu a Hmun Thianghlimah fak ula, A thiltihtheihzia lanna vân sâng takah khian, Amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="2" style="v" />A thiltih ropui takte avângin amah chu fak ula, A ropui êm avângin amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tawtawrâwt hâmin amah chu fak ula, Perhkhuang leh ṭingṭang nên amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khuangtê bênga lâmin amah chu fak ula, Phênglâwng leh phaiphulêngin amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="5" style="v" />Darbenthek têin amah chu fak ula, Darbenthek lianin amah chu fak rawh u.
  </para>
  <para style="p">
    <verse number="6" style="v" />Engkim, thaw thei tawh phawt chuan Lalpa chu fak rawh se. Lalpa chu fak rawh u.
  </para>
</usx>
