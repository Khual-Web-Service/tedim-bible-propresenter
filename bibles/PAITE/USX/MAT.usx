<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MAT" style="id">Matthai</book>
  <para style="h">Matthai</para>
  <para style="toc1">Matthai</para>
  <para style="toc2">Matthai</para>
  <para style="mt">Matthai</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />David tapa, Abraham tapa, Jesu Khrist khangthu bu:
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham in Isak a suang; Isak in Jakob a suang; Jakob in Judas leh a unaute a suang hi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Judas in Tamar apan Perez leh Zerah a suang; Perez in Erom a suang; Erom in Aram a suang hi,
  </para>
  <para style="p">
    <verse number="4" style="v" />Aram in Aminadab a suang, Aminadab in Nashon a suang hi; Nashon in Salmon a suang;
  </para>
  <para style="p">
    <verse number="5" style="v" />Salmon in Rahab apan Boaz a suang; Boaz in Ruth apan Obed a suang; Obed in Jesse a suang hi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesse in kumpipa David a suang; kumpipa David in Uria zi apan Solomon a suang;
  </para>
  <para style="p">
    <verse number="7" style="v" />Solomon in Rehoboam a suang, Rehoboam in Abijah a suang, Abijah in Asa a suang hi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Asa in Jehosaphat a suang, Jehosaphat in Jeram a suang, Jeram in Uzzia a suang;
  </para>
  <para style="p">
    <verse number="9" style="v" />Uzzia in Jotham a suang; Jotham in Ahaz a suang; Ahaz in Hezekiah a suang hi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Hezekiah in Manasseh a suang; Manasseh in Ammon a suang; Ammon in Josiah a suang;
  </para>
  <para style="p">
    <verse number="11" style="v" />Babulon sal a a pilai un Josiah in Jekoniah leh a unaute a suang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan, Babulon sal a a pinung un Jekoniah in Salathiel a suang; Salathiel in Zerubbabel a suang hi;
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerubbabel in Abiud a suang; Abiud in Eliakim a suang hi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Eliakim in Azer a suang; Azer in Zadok a suang, Zadok in Akim a suang, Akim in Eluid a suang hi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Eliud in Eleazar a suang, Eleazar in Mathan a suang, Mathan in Jakob a suang hi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Jakob in Joseph, Mari pasal a suang; huai Mari lak ah, Jesu Khrist a hong piangta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in suan tengteng Abraham apat David chiang suan sawmlehli ahi, David apat Babulon a sal a a pitan un, suan sawmlehli ahi, Babulon a sal a a pi ua pat Khrist tan suan sawmlehli ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu Khrist hong piandan hichibang ahi; A nu Mari leh Joseph kikham lai, a omkhawm ma un, Kha Siangthou in a gaisak chih a theita uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in, a pasal Joseph, mi diktak ahi a, amah daisak a utkei a, a guk in tawpsan a tum hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh, huai thute a ngaihtuahlai in, ngai in, a mang in Toupa angel a kiang ah a hong kilak a, “Joseph, nang David tapa, na zi Mari neih lau ken, a naupai Kha Siangthou a ahi,
  </para>
  <para style="p">
    <verse number="21" style="v" />Tapa a nei dia, a min ding in Jesu na sa ding, aman a mite a khelhna ua kipan a hotdam ding ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa’n zawlnei kam a:
  </para>
  <para style="p">
    <verse number="23" style="v" />“Ngai in, nungak siangthou a gai dia, tapa a nei dia, a min Immanuel a sa ding uh” chi a a gen a hongtun theihna ding in huai tengteng a hongom hi. Huai tuh, “I kiang uah, Pathian a om” chihna ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in, Joseph ihmu a thoukhia a, Toupa Angel in a kiang a thu a piak bang in a hih a, a zi a neita hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh, tapa a neih masiah a kithuahpih kei; huan a min Jesu a sata hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan kumpipa Herod vaihawm lai a Judia gam a, Bethlehem khua a Jesu a hong pianlai in, ngai in, suahlam a kipan mipilte Jerusalem khua ah a hongpai uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Koi ah ahia Judate Kumpipa a hong pian? Suahlam ah a Aksi ka mu ua, amah be dia hongpai ka hi uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kumpipa Herod in huai a zakphet in a lungzing a, Jerusalem tengteng leng a lung uh a zing sam uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in, siampu liante leh mite Laigelhmi tengteng a samkhawm a, Khrist pianna ding thu a dongta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan, amau a kiang ah “Judia gam a Bethlehem khua ah; zawlnei in hichi in a gelh a kei hiam:
  </para>
  <para style="p">
    <verse number="6" style="v" />‘Nang, Judia gam a Bethlehem aw, Judia khopite lak ah na neupen kei hial, na sung a kipan ukpa hongsuak ding ahi ngal a, ka mi Israelte vengpa ding in’ ” chih, a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai nung in Herod in a guk in mipilte a sam a, ngentel tak in Aksi kilat lai a dongkheta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan amau Bethlehem khua ah a paisak a, “Paita unla, naungek thu ngenteltak in dongkhia un, ken leng amah ka hong biak theihsamna ding in, na muhtak un, honghilh un,” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan kumpipa thu a zak un; a paita ua; ngai in suahlam a Aksi a muh uh naungek omna tung zawn a tun a a khawl masiah a ma uah a pai zel hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aksi a muh un, a kipak law mahmah uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Inn sung ah a valut ua, a nu Mari kiang a naungek om a muh un, a bokkhup ua, a bia uhi; a goubawm uh a hong ua, a kiang ah kipahna dangkaeng, begaw leh murra a lan uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Herod kiang a kik nawnlou ding in a mang ua vauhilh a a om ziak un, amau kholam ah lamtuam ah a paita uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a painung un, ngai in, Toupa angel Joseph kiang ah a mang in a kilak a, “Thou inla; naungek leh a nu pi inla, Aigupta gam ah taipih in, k’on hilh nawn masiah huai ah om gige in; Herod in naungek hihsiat dia zong ding a hih ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in, a thou a, a zanzan in naungek leh a nu a pi a, Aigupta gam ah a paita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Herod sih mateng huai ah a om gige hi; Toupa’n zawlnei kam a, “Ka tapa Aigupta gam a pan ka samkhia” chi a a gen a hongtun theihna ding in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchih lai in Herod in mipilte khem a hih a kitheihtak in a heh mahmah a, mi a sawl a, a hun laitak thu ngenteltak a mipilte a dotkhiak bang in, Bethlehem khua leh a kim tengteng a pasal naupang kum nih chiang nuai lam avek un a thatta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchihlai in zawlnei Jeremiah in:
  </para>
  <para style="p">
    <verse number="18" style="v" />“Ramah khua ah husa a za uh, sunna, kah thawm, misi ngai a mau vengvungte, Rakil in a tate a kah a, a om nawnlouh ziak un a khamuan theih kei” chi a a na gen a hongtungta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh Herod a sih nung in, Ngai in, Aigupta gam a Joseph kiang ah Toupa Angel a mang in a kilak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Thou inla, naungek leh a nu pi inla, Israel gam ah pai in; naungek thahtumte a sihtak ziak un” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in a thou a, naungek leh a nu a pi a, Israel gam ah a paita uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh Arkelaus, a pa Herod sik in Judia gam ah vai a hawm chih a zak in, huailam a pai a lau a; a mang a vauhilh a a om ziak in Galili gam ah a paita hi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Nazaret kichi khua khat ah a tengta hi. “Amah zaw Nazaret mi a chi ding uh” chi a zawlneite na gen a hongtun theihna ding in.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchihlai in Baptispa Johan in,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Kisik un! van gam a naita” chi in, Judia gamdai ah thugen in a hongpai hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah ahi, zawlnei Isai in: “Gamdai a mi kikou aw in, Toupa lamlian sial unla a lampite tangsak un, a chi” chi a a na genpen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan in sangawngsau mul puan a silh a, savun kawnggak a gak a, a an khaukhup leh khuaizu ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchihlai in Jerusalem khua, Judia gam tengteng, Jordan luidung kim tengteng a hong paikhawm uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A khelhna uh thupha tawi in a kiang honzuan ua, Jordan lui ah a Baptisma a tang uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh, Pharisaite leh Saddukaite tampi a ma a baptisma tang ding a hongpai a muh in, a kiang uah, “Gulsuante! thangpaihna hongtung ding taisan ding in kuan hon thuhilh ahia?
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in kisikna toh kilawm gah hon suangkhia un;’
  </para>
  <para style="p">
    <verse number="9" style="v" />Abraham ka pu uh ahi, chi in, kingaihtuah kei un, Pathian in hiai suangte Abraham suante in a dingsak thei hi k’on chi ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tua kipan in heipi singbul teng ah a koihta uh; huchi in, singchih gah hoih a gahlou peuhpeuh a phuk ua, mei ah a pailut zel uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ken zaw kisikna ding in tui in k’on baptist ngei a, himahleh, amah ka nung a hongpai keimah sang in a thupizaw a, a khedap tawitak leng ka hi kei, Aman zaw Kha Siangthou leh mei in noute a hon baptist ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A khut in phazah a tawi a, a phual a zapsiang sipsip ding a, buhpang ah a buh asung ding, a si bel mei mittheilou in a haltum ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchihlai in a kiang a baptisma tang ding in Jesu Galili gam a kipan Jordan lui ah Johan kiang ah a hongpai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Johan in, “Nang kei n’on baptist kiphamoh zawpi a, ka kiang ah na hong zawsop ahi maw?” chi in, a kham hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh Jesu’n a kiang ah, “Tuin lemsak teitei in, hichibang a diktatna tengteng hih tangtun ei dia kilawm ahi” chi in, a dawng a, huchi in lem a sata hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Jesu baptisma a tantak in tui a kipan a pawtpah ngal a, ngai in, amah ading in van kihong a, Pathian Kha, vakhu bang a hongsuk in, a tung a hongtu a mu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan ngai in, van a kipan aw in, “Hiai ka Tapa deihtak, ka kipahna mahmah ahi” a chi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaikhit in Diabol khem a om ding in Jesu gamdai ah Kha pilut in a omta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan ni sawmli leh zan sawmli an a ngolh nung in a gil hong kialta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khempa a hongpai a, a kiang ah, “Pathian Tapa na hihleh hiai suangte tanghou suak ding in thu pia in” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh aman, “Mihing tanghou kia in a hingkei ding, Pathian kam a thupawtte in a hingzaw ding” chih gelh ahi, chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaizoh in, Diabol in khaw siangthou ah a pilut a, Pathian biakin tungzum ah a koih hi,
  </para>
  <para style="p">
    <verse number="6" style="v" />A kiang ah: “Pathian Tapa na hihleh ki kesak in; ‘Na tungthu ah angelte thu a pe ding a, a khut un hondom ding ua, huchilou in zaw na khe in suang na sui khading’ chih gelh ahi ngal a,” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu’n a kiang ah, “Toupa na Pathian ze-et ken chih gelh ahizaw,” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Diabol in tang sangtak ah a pi nawn a, khovel gam tengteng leh a thupina a ensak hi,
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan a kiang ah, “Khupboh in hon bia in, hiai tengteng k’on pe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huaitak in Jesu’n a kiang ah, “Setan, hiai a kipan paimang in, Toupa na Pathian na biak ding a amah nna kia nasep ding ahi chih gelh ahi,” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaizoh in Diabol in a paisanta a, ngai in, angelte’n amah nna a hong sepsak uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Johan a man uh chih Jesu’n a zakphet in, Galili ah a kihemkhia hi,
  </para>
  <para style="p">
    <verse number="13" style="v" />Nazaret khua a paisan a, Kapernaum khua ah a om nilouh a, huai tuh Zebulun leh Naphtali uk, dilgei a om ahi,
  </para>
  <para style="p">
    <verse number="14" style="v" />Zawlnei Isai kam a thugenkholh a tangtunna ding ahi:
  </para>
  <para style="p">
    <verse number="15" style="v" />“Dil lam a, Jordan gal a, Zebulun gam leh Naphtali gam, Jentelte Galili gam a,
  </para>
  <para style="p">
    <verse number="16" style="v" />mial nuai a tute’n vak thupi a mu ua, sihna lim nuai a tute tung ah vak a hongsuakta” chi a a gen a hongtun theihna ding in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai nung in Jesu’n, “Kisik un! Van gam a naita” chi’n thu a genta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Galili dilgei a a vakkawm in, unau nih Simon Peter kichi a unau Andru toh, dil ah lenpailai a mu a; amaute ngamanmi ahi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman a kiang uah, “Honzui un, mihing man ding in k’on bawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in a lente uh nuse pah in amah a zuita uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan huai a kipan a pai zel a unau dang nih, Zebedai tapa Jakob leh a unau Johan, a pa uh Zebedai kiang a long a a lente uh bawlpha in a mu a; amau a samta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in, long leh a pa uh nusia pah in amah a zuita uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a kikhopnain ua thuhilh in, gam Tanchinhoih gen in, mite natna chiteng leh hatlouhna chiteng hihdam in Galili gam tengteng ah a pai vialvial hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Suria gam tengteng ah a tanchin a thangta hi; mi damlou tengteng damlouhna leh natna chih thuakte, dawimatte, kaihveite, zawte, a kiang ah a honpi ua, a na hihdam hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Galili gam a kipan, Dekapolis khua a kipan, Jerusalem leh Judia a kipan leh Jordan gal a kipan in mipi tampi tak in amah a zui uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in mipite a muh in tang ah a paitou a, a tu a, a nungzuite a kiang ah a hongpai uhi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan thu a gen a, amau thu a hilh hi:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Lungsim a gentheite a hampha uh van gam amau a ahi ngal a.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Lungkhamte a hampha uh; khamuan a om ding ahi ngal ua.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Thunuailutte a hampha uh; leigou luah ding ahi ngal ua.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Diktatna lunggulh a gilkial a dangtakte a hampha uh, tai ding ahi ngal ua.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zahngaitheite a hampha uh; zahngaihna mu ding ahi ngal ua.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Lungsim a siangthoute a hampha uh; Pathian mu ding ahi ngal ua.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Lemna bawlte a hampha uh; Pathian’ tate chih ding ahi ngal ua.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Diktakna ziak a sawina thuakte a hampha uh, van gam amau a ahi ngal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Min keimah ziak a hontai ua, a honsawi ua, zuau a gilou chiteng a a honhek hun chiang un, na hampha uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kipak unla, nakpitak in nuam un; van ah na kipahman uh a thupi ngal a: Tuamah bang in na ma ua zawlnei omte leng a na sawi zel uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Lei chi na hi uh: himahleh chi peng leh, bang in ahia a hih al nawn ding? Paihkhiak a mihingte chilgawp loungal ding in, bangmah din a phatuam kei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Khovel vak na hi uh. Tang tung a khopi om selguk theih ahi kei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Min khawnvak de in lawh nuai ah a koih ngeikei ua, a koihna ah a koih zaw uhi. Huchi in insung a om tengteng a tanvak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi mah bang in, na vak uh mi mitmuh ding in vak hen, huchi in na thil hoih hihte uh a mu ding ua, na Pa uh van a om a pahtawi thei ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Dan hiam, zawlneite thu hihmang ding a hongpai ka hih um kei un; hihmang ding a hongpai ka hi kei, hih tangtung ding a hongpai ka hi zaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chihtaktak in k’on hilh ahi, lei leh van a man masiah danthu a sutvom neuchik hiam, thaivom neuchik hiam, khat leng a mang keihial ding, avek a a tunkim masiah uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in kuapeuh hiai thupiak neupente lak a khat bohsia a, huai zui dia mite thuhilh peuhmah, van gam ah mi neupen a kichi ding; himahleh kuapeuh zui a thuhilh behlapte, van gam ah milian a kichi ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na diktatna un laigelhmite leh Pharisaite diktatna a khup kenzaw van gam ah na lut kei hial ding uh chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Nidanglai a mite kiang ah, ‘Tual na that ding ahi kei’ kichi leh, ‘kuapeuh tualthat vaihawmna adin lauhthawn huaitak in a om ding uh,’ ki chi na zata uhi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ken zaw, kuapeuh a unau tung a heh vaihawmna adin lauhthawn huaitak in a om ding. Kuapeuh a unau selphou vaihawmmite hawmsak a om lauthawn huaitak in a om ding; kuapeuh, ‘Nang mihai’ chi Gehenna mei a paih lauhthawn huaitak in a om ding uh” chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huaiziak in, maitam a na thilpiak na lat lai a na unau in na tung ah lung hihlouhna a nei chih na theihkhiak leh,
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai maitam ma ah na thilpiak nusia inla, pai inla, na unau kilempih in, huaizoh in na thilpiak lan in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na langpa toh vaihawmna inn zuan a lampi a na paikhawmlai un kilempih in, huchilou in zaw na langpa’n thukhenmi khut ah a honpe dia, thukhenmi’n mimanpa kiang ah a honpe dia; suangkulh ah a honkhum ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Chihtaktak in k’on hilh ahi, paihsa san khat nangawn na piakkim masiah huai a kipan in na pawtkhe kei hial ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Nidanglai mite’n ‘Ang na kawm ding ahi kei’ a chih uh na zata uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh ken zaw kuapeuh etlahna lungsim toh numei en in, a lungsim in angkawm ahi chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na mit taklam in a hon hihpuk leh, khelkhia inla paimang in, na sapumpi Gehenna a paisang in na sapum a hiang khat manthat nang ading in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na khut taklam in a hon hihpuk leh, tankhia inla paimai in; na sapumpi a Gehenna a paisang in, na sapum a hiang khat manthat nang ading in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Kuapeuh zi ma in kimakna lai a kiang ah pia heh, leng a kichi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ken zaw kuapeuh kingaihna ziak hilou a, zi ma in amah angkawm sak ahi, kuapeuh maksa neinawn angkawm ahi chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Nidanglai in mite kiang ah, Zuau in kichiam kenla, Toupa kiang ah na kichiamnate tangtun zaw in, a kichi chih leng na zata uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ken zaw, k’on hilh ahi, chiam himhim kichiam kei un; van lou in kichiam kei un, huai Pathian mangtutphah ahi ngal a; lei lou in kichiam sam kei un, huai a khengakna ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jerusalem lou in kichiam sam kei un, huai Kumpipa thupitak khopi ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Na lu lou in na kichiam ding ahi sam kei, samzang khat lel leng na hihngou in, na hih vawm thei ngalkei uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na thugen uh, ‘ahi, hi,’ ‘hilou, hilou,’ hi vanglak hen;” a kan a valzaw gitlouhna a suak ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Mit sik in mit, ha sik in ha, a kichi chih na zata uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ken zaw k’on hilh ahi. Migilou nang kei un; na taklam biang bengte, a lehlam leng doh zaw un.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kuapeuh in na lak ah thusia bawl in, na puanak lak a tup leh, na puanza leng lasak ngal in.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan mel khat pai dia hon phut kiang ah mel nih pai in.
  </para>
  <para style="p">
    <verse number="42" style="v" />A hon ngen kiang ah pia inla, na lak a leitawi nuam kiheisan ken.
  </para>
  <para style="p">
    <verse number="43" style="v" />“Na vengte it inla, na melmate hua in, a kichi chih na zata uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Ken zaw k’on hilh ahi, na melmate it unla, a honsawite thumsak un.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na Pa uh van a omtate na hih theihna ding un. Aman migiloute leh mi hoihte tung ah a ni a suaksak a, mi diktatte leh diktatloute tung ah leng vuah a zusak hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nou hon itte kia na it un, kipahman bang ahia na muh ding uh? Siahkhonmite’n leng huchibang in a hihsam kei ua hia?
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan na unaute kia uh chibai na buk un bang na hihtam tuan ua ahia? Jentelte’n leng hichibang in a hih sam kei ua hia?
  </para>
  <para style="p">
    <verse number="48" style="v" />Huchi in na Pa uh van a om a hoihkim sipsip bang in na hoihkim sipsip ding uh ahi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Na thilpiakte uh mi muh ding in, mihing mitmuh a hihlou ding in pilvang un; huchilou in zaw na Pa uh van a om kiang ah kipahman na neikei ding uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Huchi in, mi kiang a thilpiak na piak in, mi lepchiahte’n miphat a loh theihna ding ua kikhopnain leh kongzing a a hihnak bang un na ma uah pengkul mutkei un. Chihtaktak in k’on hilh ahi, a kipahman uh a mu ta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang zaw mi kiang a thilpiak na piak in, na khut taklam in a hih na khut veilam in theikei hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na thilpiak a guk a a omtheihna din: huchi in na Pa a guk a mupa’n a hondin ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Huan na thum chiang un milepchiah te bang in na hih ding uh ahi kei; min a muh theihna ding un, kikhopnain leh kongzing kathuam laitak ah ding kawm in thum a utse uhi. Chihtaktak in k’on hilh ahi, a kipahman uh a muta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang zaw na thum in, na dantan sunggil ah lut inla, na kongkhak khak inla, na Pa a guk a om kiang ah thum in. Huchi in na Pa a guk a om in honmu in, a hondin ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Huan, na thum un, Jentelte bang in gentuan mawkmawk kei un: a pau tam ziak ua zaka om ding a kisa uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huaiziak in, amau bang in omkei un, amah na nget ma ua na Pa un bangbang ahia na poimawh uh a theigige hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in nou zaw hichibang in thum un: “Ka Pa uh van a om, na min ki zahtak hen.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na gam hongtung hen. Na deihlam van a a kihih bang in, lei ah leng kihih hen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuni’n ka nek khop uh an honpia in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kabatte uh hon ngaidam in, kou leng ka leibate uh ka ngaihdam tak bang un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khemna ah hon pilut kenla, gilou lak ah hon huzaw in, Gam leh thilhihtheihna leh thupina Tangtawn a nang a a hih ziak in, Amen” chi in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi a tatleknate uh na ngaihdam uleh, na Pa uh van a om in leng a hon ngaidam sam ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh mite tatleknate na ngaihdam kei ngal un, na Pa un na tatleknate uh a ngaidam sam kei ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“An na ngolh un leng, milepchiahte bang in nguimel pawkei un: amau zaw mi mitmuh a anngawl a a kilat theihna ding un, a mel uh a nguisak nak uhi. Chihtaktak in k’on hilh ahi, a kipahman uh a muta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nou zaw, an na ngolh chiang un na lu uh sathau nilh unla, na mai uh phiat un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in, na Pa uh a guk a om mitmuh loungal ah mihing mitmuh ah anngawl na bang kei ding ua; huchi in, na Pa uh a guk a mu pa’n a hondin ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Lei a, leikha leh tuiek in a neksiatna ah, gutate’n phenvang a a gukna uah gou kikhol kei un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Van ah, leikha leh tui ek in a neksiatlouhna ah, gutate’n a phen ua a guk samlouhna uah, gou kikhol zaw un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na gou omna peuh uah na lungtang uh leng a om ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Sapum khawnvak mit ahi; huchi a na mit a chim leh na sapum avek in a tansuak ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na mit a siat leh na sapum avek in a mial khin vek ding. Huchi in na sung a vak om pen mial hileh nak mial natel in chia!
  </para>
  <para style="p">
    <verse number="24" style="v" />“Kuamah in heutu nih nna a semkop theikei; khat hua in khat a it ding; ahihkeileh, khat gum in khat a simmawh ding. Pathian leh sumna na semkop theikei ding uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Huaiziak in, k’on hilh ahi. Bang ahia ka nekding, bang ahia ka dawn ding, chi in, na hinna thu uh leh, bang ahia ka silh ding, bang ahia ka ten ding, chi in na sapum thu uh lunghimawh kei un. Nekding sang in hinna a thupizaw ka hia? Silhlehten sang in sapum leng a thupizaw ka hia?
  </para>
  <para style="p">
    <verse number="26" style="v" />Tungleng vasate en un; buh a tuh kei uh, a at kei uh, buh in ah leng a seklut sam kei uh. Himahleh na Pa uh van a om in amau a vak hi. Noute amau sang a nakpitak a manpha zaw hilou na hi umaw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan noute lak ah lunghihmawh ziak a kuan ahia amah dunglam tong khat a hihsang tuan thei?
  </para>
  <para style="p">
    <verse number="28" style="v" />“Huan silhlehten thu bang ding a lunghimawh na hi ua? Gamlak lili pak khandan hoihtak in ngaihtuah un; na a sem kei ua, khau leng a khek kei uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Himahleh, k’on hilh ahi, Solomon hial leng a thupina tengteng a a kizep in hiai lili pak khat bang in zep in a omkei hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in gamlak loupa, tuni a hing a, a zing a thuk a khulmai ding bawn Pathian in huchi lawmlawm a a zep leh aw nou gintawmte, silhlehten ding honpe tawk lou ding hiam?
  </para>
  <para style="p">
    <verse number="31" style="v" />“Huchi in bang ahia i nekding, ahihkeileh bang ahia i dawn ding? Ahihkeileh bang silh in ahia i om ding chi in lunghimawh kei un.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jentelte’n huai tengteng a zong uhi. Huai tengteng na poimawh uh chih na Pa uh van a om in a theigige hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A gam leh a diktatna zong masa un, huchi in huai tengteng a honpiak behlap ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Huchi in a zing ading lunghimawh kei un, a zing in amah ading a ki lunghimawh tawm ding ziak in. Ni khat ading in ni khat gimthuak a hun hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Vai hawmsak kei un, vai hawmsak na hihlouhna ding un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na vai hawmsak mah bang in hawmsak in na om ding uh, na tehna ngeimah un a hon tehsak nawn ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan bangdia, nangmah mit a singtum om ngaihtuahlou a, na unau mit a ninneng neuchik mu na hia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Bangchi’n na unau kiang ah, Na mit a kipan huai ninneng neuchik hon lakhe sak ve, na chih theih ding? Ngai in, nangmah mit mahmah ah singtum a om nilouh ngal a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Milepchiah, na mit a kipan singtum lakhe masa in; huchi in na unau mit a kipan ninneng neuchik lakkhiak ding kichiantak in na mu thei ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ui kiang ah thil siangthou pekei un; vok ma ah na tuikepsuang uh pai kei un, a chilse kha ding ua, huan kihei in a hon balzak kha ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ngen un, piak in na om ding uhi; zong un, na mu ding uh; kiu un, a hon honsak ding uhi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Kuapeuh a ngen in a mu a; kuapeuh a zong in a mu a; kuapeuh a kiu honsak in a om ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahihleh noute kuapeuh na tapa un tanghou ngen leh, kuan suang na pe ding ua?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ahihkeileh ngasa ngen leh kuan gul na pe ding ua?
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi hileh nou migilou in bawn, na tate uh thil hoih piak dan na theih un, na Pa uh van a om in a ngente thil hoih pe zawsem louding hia?
  </para>
  <para style="p">
    <verse number="12" style="v" />“Huaiziak in, thil bangkim min na tung ua a hih ua na deih bang uh, mi tung ah leng hihsam un; huai Dan leh zawlneite thu ahi him hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Kong kawchik ah lut un; manthatna a paina kong a za a, a lam leng a lian a, huai a lut tam leng a tam mahmah uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hinna a paina kong a kawchik a a lam a neu hi, a tawnte tawmchik ahi uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Zawlnei takloute lak ah pilvang un, amaute belam vun silh in na kiang uah a hongpai nak ua, a sunglam uh nge duhgawl pipi ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amau a gah uah na thei ding uh. Khaulingnei gui ah grep gah a lou ngei ua hia?
  </para>
  <para style="p">
    <verse number="17" style="v" />Lenling ah leng theipi a lou ngei ua hia? Huchi mah bang in sing hoih peuhmah a gah hoih a; sing sia a gah se nak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sing hoih a gah se theikei, sing sia gah a hoih theisam kei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Singchih gah hoihlou a phuk ua mei ah a pai uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaiziak in, amaute a gah uah na theimai ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Toupa, Toupa, honchi napeuh van gam ah a lut kei ding uh; ka Pa van a om deihlam hihte a lut ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai ni chiang in mi tampi in, Toupa, na min in thute ka gen ua, na min in dawite ka delhkhia ua, na min in thillamdang tampi ka hihzel uh hilou hiam? a chi ding uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai hun chiang in, ‘Nou thil gilou hihte aw, k’on thei ngeikei, ka kiang a kipan paimang un, chi in amau ka hilh ding hi.’
  </para>
  <para style="p">
    <verse number="24" style="v" />“Huchi in michih hiai ka thuza a, zui peuhmah, mi pil suangpi tung a inn lammi toh ka teh ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vuahpi a hongzu a, tui a hong khang a, huih a hongnung a, huai inn a honmut zialzial hi; himahleh a chimkei; suangpi tung a lepkip a hih ziak in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan michih, hiai ka thuza a zomlou peuhmah, mihai piaunel tung a inn lammi toh ka teh ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vuah a hongzu a tui a hong khang a, huih a hongnung a, huai inn a honmut zialzial a; a chimta a, huai inn a nakchip ngel hi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan hichi ahi a, Jesu’n huai thu a gen zoh in, mipi’n a thuhilh lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />laigelhmite banglou a, thuneihna neitak a amaute thu a hilh ziak in.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan tang a kipan a a hong paisuk nung in mipi thupitak in amah a zuita uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai in, a kiang ah phak khat a hongpai a, “Toupa, na ut leh n’on hihsiangthou thei hi” chi in, a bia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu’n a sawk a, a khoih a, “Ka ut hi, na siangthouta in” a chi hi. Thakhat in phak a hong siangthou pah hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n a kiang ah, "kuamah hilhlou ding in pilvang in, himahleh siampu kiang ah vakilak inla, Mosi in thilpiak ding a chihte lan in amau a hon theihchet na ding un," a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kapernaum khua a lut in, a kiang ah sepaih zaheutu a hongpai hi,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Toupa, ka naupang zaw, inn ah a lum maimah a, nakpitak a hihnat in a om” chi in a na ngen hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan aman a kiang ah, “Ka hongpai dia, ka hihdam ding” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sepaih zaheutu’n, “Toupa, ka inn sung na lutna tak ahi kei, thu kia gen lechin, ka naupang a dam ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Keileng mi thunuai a om ka hi a, ka nuai ah sepaihte a om ua, ‘nang, pai in,’ ka chih leh, a pai zel; midang kiang ah, ‘nang hongpai in,’ ka chih leh, a hongpai zel; ka sikha kiang ah leng, ‘hiai hih in’ ka chih leh, a hihzel” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Jesu’n huai thu a zak in lamdang a sa a, amah zuite kiang ah, “Chihtaktak in, k’on hilh ahi, Israelte lak ah leng hichitel a ginna thupi ka mu kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />K’on hilh ahi, suahlam leh tumlam apat mi tampi a hongpai ding ua, van gam ah Abraham, Isak leh Jakob kiang ah a tu ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gam tate zaw pawlam mial ah paihkhiak in a om ding uh; huai ah kah leh hagawi a om ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Jesu’n sepaih zaheutu kiang ah, “Paita in; na gin bang in na tung ah tung hen” a chi a, huchi in naupang a damta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu Peter inn ah a lut a, a zi nu khosik a lum a mu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A khut a khoihsak a, a khosik a daita; a thou a, a na a sepsakta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan nitaklam a hong hih in a kiang ah dawimatte tampi a honpi ua; thu in dawite a delhkhia a, damlou tengteng a hihdam hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zawlnei Isai in, “Amah ngei in i hatlouhnate a la a, i natnate a pua” chi a a gen a hongtun theihna ding in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu’n a kimvel a mipi thupitak a muh in, galkhat lam a pai ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laigelhmi khat a hongpai a, a kiang ah, “Heutupa, na paina peuh ah k’on zui ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu’n a kiang ah, “Sehalte’n kua a nei ua, tungleng vasate’n leng bu a nei uh, himahleh Mihing Tapa in zaw lungakna ding mun a neikei” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a nungzuite lak a midang khat in, “Toupa, ka pa hon vuisak phot in” a chi hi,
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh aman a kiang ah, “Honzui in; misi in amau misi kivui uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan long sung ah a lut a, a nungzuite’n a zui uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai in, dil ah huihpi thupitak a hongnung a, huchi in tuikihawt in long hontum tou a; amah lah a ihmu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan a kiang ah a hongpai ua, a phawng ua, “Toupa, hon hondam in, mangthang ding ka kei uhiam” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman a kiang uah, “Ginglahte aw, bangdia lau na hi ua?“ a chi hi. Huchi in a thou a, huih leh dil a tai a; huan a hong dai sipsipta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan mite’n lamdang a sa mahmah uhi. “Hiai mi bangchidan ahia, huih leh dil nangawn in a thu a man uh?” a chi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan galkhat lam Gadara mite gam a tun in dawimat nih, han a kipan a hongpawt in, a hontuak ua; a hang mahmah ua, huchi in, huai lampi ah kuamah a pai theikei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai in, amau “Pathian Tapa kou leh nang bang ahia i kizolhna om? Hunchiam tunma a koute hongawt dia hongpai na hi maw?” chi in, a kikou uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan a omna ua kipan gamla khop ah vokhon tampi a gamta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan dawite’n, “N’on delhkhiak a leh huai a vokhonte sung ah hon lutsak in” chi in, a kiang ah nakpi’n a ngen uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman a kiang uah, “Pai un” a chi a, huchi in, a hong pawtkhia ua, vok sung ah a lut uhi; ngai in, vokhon tengteng tuigei ken ah a taisuk ua, dil ah a tailut ua, tui ah a mangthangta uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan a vulte a tai ua, khua ah a pai ua, dawimatte tung a thil hongtungte bangkim a hilhta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ngai in, a khua in Jesu mu ding in a hongpawt ua; amah a muhtak un a gam ua kipan a pawtkhe ding in nakpi’n a ngen uhi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan long ah a lut a, a galkah a, a khua a hongtung kiknawn hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai in, mi zeng khat damlou, lupna a lum a honzawng ua; huchi in Jesu’n a ginna uh mu in, zeng damloupa kiang ah, “Tapa, khamuangtak in om in, na khelhnate ngaihdam hi hen” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai in, Laigelhmi kuate hiam a kingaihtuah ua, “Hiai mi’n Pathian a gensia” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Jesu’n a ngaihtuahte uh a thei a, “Bangdia na lungtang ua gilou ngaihtuah na hi ua? a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Na khelhnate ngaihdam hi hen’ chih leh, ‘thou inla, khe in pai in, chih koi a baihlam zaw?’
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh Mihing Tapa in leitung ah khelhnate ngaihdam theihna a nei chih na theihna ding un” zeng damloupa kiang ah “Thou in, na lupna la inla, na inn ah pai in” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in a thou a, a inn ah a paita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh, mipi’n a muh un, lamdang a sa ua huchibang hihtheihna mihingte kiang a pepa, Pathian a pahtawita uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu huai a kipan a pai zel a, siah piakna mun a tu, mi khat, a min Matthai a mu a; a kiang ah, “Honzui in” a chi a, huchi in, a thou a, a zuita hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichi ahi a, a inn a Ankuang a umlai in, ngai in, siahkhawnmite leh mikhial tampi a hongpai ua, Jesu leh a nungzuite a umpih uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharisaite’n huai a muh un, a nungzuite kiang ah, “Bangdia na heutupa un siahkhawnmite leh mikhialte kiang a ne ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh Jesu’n huai a zaktak in, “Mi damtheite’n daktor a kiphamoh kei ua, mi damtheiloute’n a kiphamoh zaw uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in, ‘kithoihna deihlou in zahngaihna ka deih hi,’ chih, a omdan vazil un, mi diktatte sam dia hongpai ka hi kei, mikhialte sam dia hongpai ka hizaw” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchihlai in Johan nungzuite a kiang ah a hongpai ua, “Bangdia kou leh Pharisaite’n anngawl gige a, na nungzuite’n ngawllou uh ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu’n a kiang uah, “Moupite kiang a a pasal a omlai teng moupite’n a sun thei ua hia? Himahleh, a pasal a kiang ua kipan a pimang nite a hongtung ding a, huai hun chiang in an a ngawl ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan kuamah in puan lui puan tuikhai louh them in a thuap ngeikei uh; a thuapna in puan a kaihkek ding ziak in, a hong nakkek zawsem ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuamah in uain thak savun uain thawl lui ah a thun ngeikei uh; huchilou in zaw savun thawlte a puakkek dia, uain a baw dia, savun thawl leng a hong seding; huaiziak in uain thak savun uain thawl thak ah a thun zaw ua, huchi in hoihtak in a om tuaktuak” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan a kiang ua a genlai tak in, ngai in, vaihawmpa khat a hongpai a, Amah bia in, “Tu tak in ka tanu a si a; himahleh hongpai inla, a tung ah na khut koih lechin a hong hingnawn ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in, Jesu a thou a, a zuita a, nungzuite’n leng a zui uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai in, numei khat kum sawm leh kum nih si pawt damlou, a nung ah a hongpai a, a puanmong a khoihsak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“A puan mongkai khoihlel leng, hihdam in ka om mai ding” a lungsim in a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Jesu a kihei a, amah a mu a, “Ka tanu, khamuangtak in om in; na ginna na dampih hi” a chi hi. Huchi in numeinu huai dakkal a kipan a damta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu vaihawmpa inn ah a lut a, tamngai tumte leh mipi thawm ngaih vengvungte a va muh in,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Pawt un: naupang a si kei, a ihmu ahizaw,” a chi hi. Amau bel amah a nuihsan maimah uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh mipite pawlam a a pawtsak zoh in amah a lut a, naupang khut ah a len a, a hong thou maimah hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai tanchin huai gam tengteng ah a thangkheta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesu huai a kipan a pai zel a, mittaw nih in, “David Tapa, ka tung uah zahngai in” chi a kikou in a zui uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan inn a a lut leh mittawte a kiang ah a hongpai ua; Jesu’n a kiang uah, “Hiai hihthei din n’on gingta ua hia?” a chi hi. Amau a kiang ah, “Gingta e, Toupa” a chi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman a mit uh a khoih a, “Na gintak bang un na tung uah tung hen,” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in a mit uh a hongvakta hi. Jesu’n a kiang uah, “Kuamah theihlouh ding in pilvang un” a chi bilbel hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh amau a pawt ua, huai gam tengteng ah a tanchin a genthangta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huai apan a pawtlaitak un, ngai in, dawimat pautheilou khat a kiang ah a honpi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai dawi a delhkhiak tak in pautheilou a hong pauta a; mipite’n lamdang a sa mahmah uhi, “Israelte lak ah hichibang a kimu ngeikei hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pharisaite’n bel “Dawi kumpipa ziak in ahi, dawite a delhkhiak nak,” a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Jesu’n a kikhopnain ua hilh in, gam Tanchinhoih gen in, damlouhna chiteng leh natna chiteng hihdam in, kholian leh khoneu tengteng a tawn vialvial hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in mipite a muh in, chingtu neilou belamte bang a gimthuak leh dalh a a om ziak un a lainat mahmah hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A nungzuite kiang ah, “Buhlak ding a tam mahmah a, himahleh a semmite a tawm uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huaiziak in a buhla dia semdingte sawl ding in buhneipa kiang ah ngen un” a chi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai zoh in a nungzui sawm lehnihte a kiang ah a samkhawm a, a kiang uah khaninte tung leh amau hawlkhe ding, damlouhna chiteng leh natna chiteng hihdam ding in a thuneihna a pia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai sawltak sawmlehnihte min hiaite ahi: A masapen in Simon Peter, leh a unau Andru; Zebedai tapa Jakob leh a unau Johan,
  </para>
  <para style="p">
    <verse number="3" style="v" />Philip leh Bartholomai; Thomas leh siahkhawn Matthai: Alphai tapa Jakob leh Thaddai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kanan mi Simon leh zuausan a mansakpa Judas Iskariot.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiai sawmlehnihte Jesu’n a sawlkhia a, a kiang uah huchi in thu a pia hi. “Jentelte lam ah paikei unla, Samari mite khua ah leng lut kei un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh Israel inkuan belam mangte kiang ah paizaw un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan, na pai un, van gam a naita, chi in, thu genzel un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Damloute hihdam unla, misite kaithou unla, phakte hihsiangthou unla; dawite hawlkhia un, a thawn in na mu ua, a thawn in pia un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na kawnggak uah dangkaeng hiam, dangka hiam, dal dangka hiam tawi kei un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zinna ading in kawlzal hiam, puanak nih hiam, khedap hiam, chiangkhun hiam tawisam kei un; nasemmi nekding mutak ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Huan kholian hi in khoneu hitaleh na lutna peuh uah nou hon tungsaktak mi zongkhia unla, na pawtnawn mateng uh huai inn ah tungden un.
  </para>
  <para style="p">
    <verse number="12" style="v" />A inn ua na lutpeuh chiang un, chibai buk un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai inn a mite chibai buktak a hih uleh na khamuanna uh a tung uah a tung dia; a takkei ua leh na khamuanna uh nou tung ah hong kiknawn ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kuapeuh nou hon kipahpihlou a, na thu uh leng a ngaihkhiak kei uleh, huai inn a kipan leh huai khua a kipan na pawt chiang un, na khepek ua leivui tatkhia un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chihtaktak in k’on hilh ahi, thukhen ni chiang in huai khua sang in Sodom leh Gomorrah gam thuak ding a dan a omzaw ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Ngai dih ua, ngia lak a belam om bang in k’on sawlkhia hi: gul bang a pilvang, vakhu bang a poi khoihlou in om un.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh mihing lak ah pilvang un: vaihawmmite a hon mansak ding ua, kikhopnain ah a hon vuak ding ziak un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Keimah ziak in gamukte leh kumpipate ma ah amaute leh Jentelte theihsakna ding in a honpi ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh a hon matsak chiang un, bangchih ding ahia, bang thu ka gen dia? chi in lungkham kei un; na gen ding uh a huntak in a hon theisak ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A genpa noumau na hi kei ding ua, na Pa uh Kha in noumau ah a genzaw ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan hihlup ding in unaupa leh unaupa a kimansak ding ua, pa’n leng a ta a mansak ding; tate’n leng a nu leh a pate uh a dou ding uh, a hihlumsak ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka min ziak in mi tengteng huat na hi ding uh; himahleh a tawppha a thuakngap peuhmah hotdam in a om ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in hiai khua a hon gawt chiang un, khaw dang ah taisan un; chihtaktak in k’on hilh ahi, Mihing Tapa hongpai ma in Israel gam a khopite na siksuak kei ding uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Nungzui a heutu tung ah a omkei; sikha leng a pu tung ah a omkei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Nungzui a heutu bang a a hongom leh sikha a pu bang a a hongom tuh a hun e. Inn neipa bawn Beelzibul a chih uleh, a inkuanpihte nak chihna tel un chia!
  </para>
  <para style="p">
    <verse number="26" style="v" />“Huaiziak in amaute kihta kei un; langlou ding a sel bangmah a omkei, theihlouh ding a im bangmah a omkei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mial a nou k’on hilh vak ah na gen ding ua; bilbul a na zak uh intung a tuang in tangkoupih un.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan sapum that a kha that theiloute kihta kei unla; Gehenna a kha leh sapum hihmang theipa kihta zaw un.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kawlgit nih dal dangka khat in a zuakzel uh hilou hiam? Himahleh a lak ua khat leng na Pa uh theihlouh in lei ah a ke kei ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na samzangte uh nangawn leng simvek ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in lau kei un; kawlgit tampi sang in na manpha zaw uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Huchi in mite ma a hon gum peuhmah, ka Pa van a om ma ah ka gum sam ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Himahleh kuapeuh mite ma a hon kitheihmohbawl, ka Pa van a om ma ah ka kitheihmohbawl sam ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Leitung a lemna lengsak ding a hongpai honsa kei un; lemna lengsak ding hilou in namsau lengsak ding a hongpai ka hi zaw.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi a pa dousak ding in, tanu a nu dousak ding in, mou a nu dousak ding a hongpai ka hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mi a melma amah inkuanpihte lak a mi mah ahi ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kuapeuh a nu hiam, a pa hiam, kei sang a it zaw tuh ka mi hitak ahi kei; kuapeuh a tanu hiam a tapa hiam kei sang a it zaw leng, ka mi hitak ahi kei.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kuapeuh a Kros pua a hon zuilou ka mi hitak ahi kei.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kuapeuh a hinna mu in a tan ding a, keimah ziak a a hinna tan in a mu ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />“Kuapeuh nou hon kipahpih in kei hon kipahpih ahi a, kuapeuh kei hon kipahpih a hon sawlpa kipahpih ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Zawlnei kua hiam, zawlnei a hih ziak a kipahpih in zawlnei kipahman a mu ding; kuapeuh mi diktat kua hiam mi diktat a hih ziak a kipahpih in mi diktat kipahman a mu ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan kuapeuh hiai mi neuchikte lak a khat kiang a, nungzui a hih ziak a tuisik nou khat kia pia leng, chihtaktak in k’on hilh ahi, a kipahman a tan kei hial ding” a chi hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, Jesu’n a nungzui sawmlehnihte thu a piakzawh in huai apan in a khopite ua sinsak ding leh thugen ding in a paita uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Johan in suangkulh sung a Khrist thilhihte a na zak in a nungzuite sawl in a kiang ah,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Hongpai dingpa na hi hia, ahihkeileh midang hungaih lai ding ka hi uhia?” a chisak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Jesu’n a kiang uah, “Painawnta unla, thil na muh uh leh na zak uh Johan kiang ah vahilh un:
  </para>
  <para style="p">
    <verse number="5" style="v" />Mittawte a mit uh a hongvakta, khebaite khe in a hongpai ua, phakte a hong siangthouta ua, bengngongte leng a bil uh a hongvakta, misite leng kaihthoh in a omta ua; a mizawngte’n leng Tanchinhoih hilh a dongta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kuapeuh ka tung a lunghihlouhna mulou a hampha uhi” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai mite a paitak un, Jesu’n mipite kiang ah Johan thu a genta hi: “Bang ending a gamdai a paikhia neita ua? Sialluang huihmut ling maw?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahihkeileh bang ending pen a paikhia neita ua? Puannem silh maw? Ngai un, puannem silhte zaw kumpipate in ah eive a om uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahihkeileh bang ziakpen in ahia na paikhiak uh? Zawlnei ending in maw? Ahi tawk vaw oi, k’on chi ahi, zawlnei sang a leng thupizaw.
  </para>
  <para style="p">
    <verse number="10" style="v" />‘En dih ka thangkou na ma ah ka sawl ahi, aman na ma ah na lampite a bawl ding chih a tanchin a gelh uh hiai mipa ahi.’
  </para>
  <para style="p">
    <verse number="11" style="v" />Chihtaktak in, k’on hilh ahi, numei suan lak ah baptispa Johan sang a thupizaw a piang kei; himahleh van gam a mi neupen amah sang in a thupizaw uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Baptispa Johan om a kipan tutan in van gam in hiamgamna a tuaknak, hiamgamte’n hat thu in a la hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zawlneite tengteng leh danthu in Johan a hongom tanpha in a na genkhol zel uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na pom nop uleh, huai zaw Elijah hongpai dingpa mah ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kuapeuh zakna ding a bilnei in za hen!
  </para>
  <para style="p">
    <verse number="16" style="v" />“Himahleh tulai khangte bang toh ka tehpih dia? Naupang dawlmun a tu a, a lawmte sam a,
  </para>
  <para style="p">
    <verse number="17" style="v" />Tamngai hontum sak ung a, lam lou uchin a, kap huphup ung a, sunlou uchin a, chite bang ahi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Johan a hongpai a, ne in a dawn kei a, dawizawl, a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mihing Tapa a hongpai a, ne in a dawn a, En dih ua, anhaipa, uain haipa, siahkhonte leh mikhialte lawm, a chi uhi. Himahleh pilna a tate’n siam a tan uh” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan a kisiklouh ziak un, a thil thupi hihtamna khopite a tai hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Korazin, na tung gik e; Bethsaida, na tung gik e; noumau a thil thupi kihihte Tura leh Sidon khua a hih hileh, saiip puansilh a vutlak a tu in a kisikta ding uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh k’on hilh ahi, thukhen ni chiang in nou thuak ding sang in Tura leh Sidon khua thuak ding a dan a omzaw ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan nang Kapernaum, van tan a tawisang na hidia hia? Misi khua tan a paisuk ding neive, nangmah a thil thupitak kihihte Sodom khua a hih hileh, tutan in a omlai ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh k’on hilh ahi, thukhen ni chiang in na thuak ding sang in Sodom gam thuakding a dan a omzaw ding” a chi hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchihlai in Jesu’n a houpih a, “Pa aw, leitung leh van Toupa, nang mi pil leh mi bengvakte kiang ah hiai thu na im a, naungekte kiang a na theihsak ziak in k’on phat hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahi, Pa, tua bang hih, nang ngaih in a hoih ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka Pa’n thilbangkim hon kemsakta; Pa lou in kuamah in Tapa a theikei; Tapa leh a kiang ua Tapa in a kitheihsak utnate kia loungal in kuamah in Pa a theikei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Nou semgim leh puakgik paw tengteng aw, ka kiang ah hongpai un, keiman khawlna k’on pe ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka hakkol pua unla, kei a kipan zil un; thunuailut leh lungtang kingainiamtak ka hi; huchi in, na kha ua ding in khawlna na mu ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka hakkol a nuam a, ka puak leng a zang hi” a chi hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchihlai in, Jesu khawlni’n buhlei kantan in a pai hi; nungzuite a gilkial ua, buhvuite khiak in, a neta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pharisaite’n huai a muh un, a kiang ah, “En dih, na nungzuite’n khawlni’n hihsianglou a hih uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu’n a kiang uah, “David in a gilkial lai a a lawmte toh a thilhih uh na simkei ua hia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi a Pathian inn a a lut a, amah leh a lawmte’n nek sianglouh, siampute kia neksiang tanghou koihtuam a nek thu uh?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ahihkeileh khawlni’n Pathian biakin a siampu omte’n khawlni a bohsiat un leng siamtang in a om uh chih danthu na simkei ua hia?
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi a hih ngal leh, Pathian biakin sang a thupizaw hiai ah a om chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh ‘kithoihna deihlou in, zahngaihna ka deih’ chih a omdan na thei hile uchin, mi siamtangte siamlouh tangsaklou ding hive uchin.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing Tapa zaw khawlni Toupa ahi,” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan huai a kipan a pai a, a kikhopnain uah a valut hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai dih, mi khat khutzaw a na om a, amah a hektheihna ding un, “Khawlni a hihdam a siang hia?” chi’n Jesu a dong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a kiang uah, “Noute lak ah kuapeuh in belam khat nei unla, khawlni’n kawkhuk ah keta leh kua ahia len a kaikhelou ding?
  </para>
  <para style="p">
    <verse number="12" style="v" />Belam khat sang in mihing khat bangchilel a manpha zaw ahia? Huaiziak in khawlni’n hihhoih a siang hi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huaizoh in, huai mi kiang ah, “Na khut zan in” a chi hi, huchi in a zan a, a langkhat bang in a damsiangta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pharisaite bel a pawt ua, amah a hihlup theihna dan ding uh ngaihtuah in a kihou uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu’n huai thu a theih in huai mun a kipan in a kihemmang hi. Himahleh mitampi in amah a zui ua, a damloute a na hihdam vek hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A tanchin genthang hetlou ding in a kiang uah a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai zawlnei Isai thugenkholh a tangtunna ding ahizaw hi:
  </para>
  <para style="p">
    <verse number="18" style="v" />“En dih, ka sikha ka tel, ka deihtak, ka lungsim in a pahtak mahmah, a tung ah ka Kha ka koih dia, huchi in, Jentelte kiang ah dik a vaihawmna a ensak ding hi;
  </para>
  <para style="p">
    <verse number="19" style="v" />A selkei ding a, a kikou sam kei ding a, kongzing ah kuamah in a aw a za sam kei ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Dik a vaihawmna a vualzohsak mateng sialluang kigawpsa a hihtan khekei ding a, meivak kuang liakliak a hihmit sam kei ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amah min ah Jentelte’n lametna a ngah ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchihlai in dawimat mittaw pautheilou khat a kiang ah a honpi ua; aman a hihdam a, pautheilou hongpau in, a hon muthei ta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in mipi tengteng in lamdang a sa mahmah ua, “Hiai mipa, David Tapa hilou ahi maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh Pharisaite’n huai a zakphet un, “Hiai mi’n dawite kumpipa, Beelzibul ziaklou in dawite a delhkhe kei ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n amaute ngaihtuahte a thei a, a kiang uah, “Koi gam leng amah kidou a mangthang nak; koi khua hiam, inkuan khat leng amah kidou, a khosuak kei ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Setan in Setan mah a delhkhiak in amah leh amah kidou hi ding hi a; a gam bangchi’n ading dia le?
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan kei Beelzibul ziak a dawite delhkhia ka hihleh, na tate un kua ziak in ahia leh a delhkhiak uh? Huaiziak in, amaute noute tung a thukhenmite ahi ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh, ken Pathian Kha ziak a dawite delhkhia ka na hihleh, Pathian gam na kiang uah hongtungta ahi ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi ahihkei ngal in, min mi hat a gak masak phot kei leh bangchi’n ahia mi hat inn a lut a, a sum a laksak theih ding? Huai nung in a inn a lok mai ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kuapeuh kei lam a panglou, hondou ahi; kuapeuh hon lakkhawm pihlou in a thehzak ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in k’on hilh ahi, mi a khelhna chiteng uah leh Pathian a gensiatna chiteng uh ngaihdam a hi ding ua: Kha hilhial a gensiatna ngaihdamsak ahi kei ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kuapeuh Mihing Tapa kalh, a kalhna uh ngaihdamsak ahi ding: kuapeuh Kha Siangthou hilhial kalh zaw huai a kalhna uh, tu damsung leh hun hongtung ding ah leng, ngaihdam a hi kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Sing hoih a gah leng a hoih na chih kei ngal uleh, sing sia a gah leng a sia, chi vanglak un: sing a gah a a kitheih ziak in.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gul suante aw, nou gilou napi in bangchi’n ahia thuhoih na gen theih ding uh? Lungtang a dimval kam in a genzel hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi hoih in a goubawm hoih a kipan thil hoihte a hon lakhia a, migilou in a goubawm hoihlou a kipan thil hoihlou a hon lakhe zel hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan k’on hilh ahi. Mite’n thuginalou a gen peuhmah uh huai thu tanchin mah vaihawm nichiang in a gen ding uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Na thu in siam a hon tangsak dia, na thu mah in siamlouh a hon tangsak ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huailai in laigelhmite leh Pharisaite lak a mi kuate hiam in amah a houpih ua a kiang ah, “Heutupa, nang a kipan chiamtehna muh ka ut uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Aman a kiang uah, “Khang gilou leh angkawmte’n chiamtehna a zong ua, himahleh zawlnei Jonah chiamtehna loungal a kiang uah chiamtehna piak ahi kei ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jonah ni thum leh zan thum ngapi gilsung a a om bang in, Mihing Tapa ni thum leh zan thum lei gilsung ah a omsam ding hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ninevi khomite thukhen ni chiang in tulai khangte kiang ah ading sam ding ua, siamlouh a tangsak ding uh. Jonah thugen ziak in a kisik ua: ngai dih ua, Jonah sang a thupizaw hiai ah a om hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Simlam kumpinu thukhen ni chiang in hiai khangte kiang ah a thou ding a, siamlouh a tangsak ding hi, Solomon pilna ngaikhe ding in kawlmong a kipan a hongpai ngal a; ngai dih ua, Solomon sang a thupizaw hiai ah a om hi!
  </para>
  <para style="p">
    <verse number="43" style="v" />“Huan dawinin mihing sung a kipan a pawt in, khawlna zong in tui omlouhna mun ah a vakvaka, a mu kei hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan ‘ka pawtna inn mah ah ka kiknawn mai ding’ a chi a: a vatun leh a hawm a zephoihsa in a va mu hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huaitak in a vapai a, amah sang a gilou zaw dawi dang sagih a honpi a, huai mi sung ah a lut ua, a tengta uhi: huai mihing omdan nanung amasa sang in a hong hoihkei zaw hi. Tuabang mah in, tulai khang giloutakte tung a a hongom ding” chi’n a dawng hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mipite kiang a thu a genlai in ngai dih, a nu leh a unaute amah houpih tum in, inn pua ah ading uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mi khat in a kiang ah, “Ngai dih, na nu leh na unaute nang hon houpih tum in inn pua ah ading nilouh uh” a chi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Aman a hilhpa kiang ah, “Ka nu kua ahia? Ka unaute leng kuate ahia ua?” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huan nungzuite lam a a khutzan in, “En un, ka nu leh ka unaute:
  </para>
  <para style="p">
    <verse number="50" style="v" />Kuapeuh ka Pa van a om deihlam hihphot ka unau, ka sanggam nu leh ka nute ahi uh” a chi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai ni’n Jesu inn a kipan a paikhia a, dilgei ah a tu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan a kiang ah mipi thupitak a hong kikhawm ua, huchi in long ah a tuang a, a tu a, mipi tengteng piautak ah ading uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gentehna in thu tampi a kiang uah a gen hi: “Ngai dih ua, buhchithehpa buhchi theh in a kuan hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Buhchi a thehlai in a khen lamsik ah a kia a, vasate’n a nezou uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A khen suangsilei lak ah a kia a: lei a sahlouh ziak in a hong poupah hi:
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh ni a suah in haivuai in a om a: zung a neih louh ziak in, a vuai maimah hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a khen loulingnei lak ah a kia a, loupa a hong pousang a: a depmangta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A khen leihoih ah a kia a, khenkhat a leh za, khenkhat a leh sawmguk, khenkhatte a leh sawmthum in a honggah uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kuapeuh bil nei in, za hen!” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan nungzuite a hongpai ua, a kiang ah, “Bangdia gentehna a thu gen na hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a dawng a a kiang uah, “Van gam thuguk noute theih phal ahi a, amau theihzaw phal ahi kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kuapeuh a nei piak behlap ahi ding a, a hau ding; kuapeuh a neilou a neihsun leng laksak ahi ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi a hih ziak in a kiang uah gentehna in thu ka gen ahi; ‘mu napi’n a mu kei nak ua, za napi’n a theisiamkei nak uhi.’
  </para>
  <para style="p">
    <verse number="14" style="v" />Isai thugenkholh a tung uah a tung hi: ‘Bil in zaw na za ding ua, a theih zaw na theisiam kei ding uh; muh zaw na mu ding ua, theihzaw na theikei ding uh;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiai chite lungtang a nang gawpta a bilte uh a ngong a, a mitsi ua, huchilou in zaw a mit un a mu ding ua, a bil un a zakha ding ua, a lungtang un a theisiam ding ua, a hong kiknawn kha ding ua, amau ka na hihdam kha ding’ a na chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nou mitte zaw a hampha hi, a muh ziak in; na bil uh leng a hampha hi, a zak ziak in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chihtaktak in k’on hilh ahi, zawlnei tampi leh mi diktat tampi’n leng na thilmuhte uh muh a ut ua, himahleh a mu kei uh; na thilzakte uh zak a ut ua, himahleh a zakei uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Huaiziak in, buhchithehpa gentehna thu za un;
  </para>
  <para style="p">
    <verse number="19" style="v" />Kuapeuh in kumpi gam thu bil a a zak a, a theihsiamkei leh migilou a hongpai a, a lungtang a thehsa a laksak nak hi. Huai tuh lamsik a theh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Suangsilei a theh bel, thu za a kipaktak a pom bang ahi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh amah ah zung a omkei a, sawtlouchik kia a om a, thu ziak a gimthuakna leh sawina a hongom tak in a pukpah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan loulingnei lak a thehte tuh thu za a, himahleh khovel awlmohna leh hauhsakna khemna in thu a dep a, gahlou in a hongom hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan leihoih tung a theh tuh thu bil a za a, theisiam ahi; huai tuh a gah ngei a, khenkhat a leh za, khenkhat a leh sawmguk, khenkhat a leh sawmthum in a pung” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gentehna dang a kiang uah a gen nawn a; “Van gam tuh mi a lou a chi hoih thehpa toh teh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh mi a ihmut kal in melma a hongpai a, buh lak ah buhlem a theh a, a paimang nawnta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan buh a hongpou a a hongvuih in buhlem leng a hong kilang sam hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in inneipa sikhate a hongpai ua, a kiang ah, Pu, na lou a chi hoih thehlou na hi maw? Buhlemte koi a kipan a hongom ahia? a chi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman a kiang uah, melma in na theh eive, a chi hi. Sikhate’n a kiang ah ahihleh ‘huaite va lakhawm le ung hoih na sa hia?’ a chi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman bel, ‘salou e, buhlem na lakkhawmna lam uah buh na botkhawm kha ding uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Buhlak dong in poukhawm uheh; buhlak hun chiang in buh atte kiang ah, buhlem lakhawm masa phot unla, hal ding in lomgak un; buh pen bel ka buh in ah seklut un, ka chi ding’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Gentehna dang a kiang uah a gen nawn a; “Van gam tuh ankam chi tang khat min a lak a, a lou a a theh bang ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huai chi laklak ah a neupen a; himahleh a hongpou sang chiang in loupa lak ah a lianpen a, sing a honghi a, huchi in tungleng vasate a hongpai ua, a hiang ah a giak uh” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Gentehna dang a kiang uah a gen nawn a; “Van gam tuh numei in silngou anbuang tehna thum lak a a bilh a, avek a a thoh mateng a phum bang ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n huai tengteng gentehna in mipite kiang ah a gen a, gentehna lou in a kiang uah bangmah a genkei hi;
  </para>
  <para style="p">
    <verse number="35" style="v" />Zawlnei in, “Gentehna in ka kam ka ka ding a, leilung pian tung a kipat thil kisel ka genkhe ding” chi a a gen a hongtun theihna ding in.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huailai in mipite a paisan a, inn ah a lut a, nungzuite a kiang ah a hongpai ua, “Lou a buhlem gentehna thu hon hilhchian in” a chi uhi
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman a dawng a, “Chi hoih thehpa Mihing Tapa ahi a; lou bel khovel ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Chi hoihte gam tate ahi ua; buhlemte migilou tate ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Melma buhlem thehpa Diabol ahi a, buhlak hun khovel tawpna ding ahi; a atte angelte ahi uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in buhlemte a lakhawm ua mei a a hal bang un khovel tawpna ah a om ding hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mihing Tapa in angelte a sawlkhe ding a, gam a kipan hihkhial sakte leh thil hihkhialte tengteng a khawmkhe ding uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amaute haltuina mei ah a pai ding ua, huailai ah kah leh hagawi a om ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huai hun chiang in mi diktatte a Pa uh gam ah ni bang in a tang ding uhi. Zakna ding a bil nei peuh in za hen!
  </para>
  <para style="p">
    <verse number="44" style="v" />“Van gam tuh lou a gou phumguk bang ahi; huai min a mu a, a sel a, a kipah ziak in a neih tengteng a zuak a, huai lou a leita hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />“Huan Van gam tuh sumsinmi tuikepsuang hoihtak zawngmi bang ahi nawn hi;
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan aman tuikepsuang manpha tak khat a mu a, a neih tengteng zuak in a leita hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />“Van gam tuh lenpi, tuipi a paih, chichih tunkhawmna bang ahi nawn hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />A dimtak in a gei ah a kaikhia ua, a tu ua, a hoih teng bawm ah a lakhawm ua, a hoihloute a paih uh bang ahi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Khovel tawp hun chiang in huchi bangmah in a om ding, angelte a hongpawt ding ua, mi diktatte lak ah migiloute a khenkhe ding uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huchi in haltuina mei ah a pai ding uh, huai ah kah leh hagawi a om ding, a chi hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />“Jesu mah in a kiang uah, “Huai tengteng na theisiam uhia?” a chi a, amau a kiang ah, “Thei e” a chi uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huan aman a kiang uah, huaiziak in Laigelhmi van gam thuhilh a om peuhmah, inn neipa, a goubawm a kipan a thilthakte leh thilluite pholhkhepa bang ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huan hichi ahi a, Jesu’n huai gentehnate a genkhit in huai a kipan a paita hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />A omna kholam a tung a, a kikhopnain uah amaute thu a hilh a, huchi in lamdang a sa mahmah uhi, “Hiai min hiai pilna leh hiai nasep thupi hihtheihnate koi a pat a a muh ahia?
  </para>
  <para style="p">
    <verse number="55" style="v" />Hiai mi singlem bawlpa tapa hilou hia? A nu Mari kichi hilou hia? A unaute Jakob, Joseph, Simon, Judas kichite hilou uhia?
  </para>
  <para style="p">
    <verse number="56" style="v" />Hiai mi phiangsan in koi a kipan a hiai tengteng mu ahia? A sanggamnute leng i kiang ua omvek hilou uhia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huchi in, a tung ah a lungkim kei uhi. Himahleh Jesu’n a kiang uah, “Zawlnei amah kholam leh amah inn lam loungal ah pahtawilouh in a om ngeikei” a chi hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />A ginlouh ziak un huai ah nasep thupi dang tam ahihkei hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai tak in kumpipa Herod in Jesu tanchin a naza hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A sikhate kiang ah thu a gen a, “Hiai Baptispa Johan ahi; misi lak a kipan thounawn ahi; huaiziak in huai thilhihtheihnate’n amah a sem ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Herod in a unau Philip zi, Herodia ziak in Johan a man a, a hen a, suangkulh ah a na khum hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan in a kiang ah amah na neih a siangkei, a chih ziak in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Johan hihlup ut mahleh mipi a kihta a, zawlnei a a bawl ziak un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh Herod pianni a hongtun in Herodia tanu a lai ah a lam a, Herod a kipaksak hi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai phet in a nget peuhmah pe ding in thu a kichiam hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman a nu thuhilh in, hiai kuang ah Baptispa Johan lutang honpia in, a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kumpipa a lungkhamta a, himahleh a thuchiamte leh a Ankuang umpihte ziak in piak ding thu a pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in mi a sawl a, Johan lutang a tansak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan kuang in a lutang a honla ua, numei naupang kiang ah a pia ua, aman a nu kiang ah a paipihta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Johan nungzuite’n a luang a hongla ua, a vui ua, huchi in Jesu a va hilh uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu’n huai a zak in, hiai a kipan long in gamkeu lam ah a paituamta hi. Himahleh mipi’n a zaktak un khua a kipan khe a pai in a zuita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in amah a hong paikhiak leh mipi thupitak a mu a, a hehpih mahmah a, a damloute uh a hihdam sak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nitaklam a hong hih in, nungzuite a kiang ah a hongpai ua, “Hiai mun gamkeu ahi a, ni a kaita a, mipite khuate a pai a, amau ading nek ding a lei theihna ding un paisakta in” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu’n a kiang uah, “A paimang uh kiphamoh kei, noumau nekding pia un” a chi hi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Amau a kiang ah, “Hiai ah tanghou phel nga leh ngasa nih kia i nei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman “Huaite ka kiang ah honla un” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in loupa tung a tu ding in mipite thu a pia a, tanghou phel nga leh ngasa nihte a la a, vanlam en in a vualzawl a, a balkham a, tanghoute nungzuite kiang ah a pia a, nungzuite’n mipite kiang ah a pesawn uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan avek un a ne ua, a vah chiatta ua; a khamval uh bawmpi sawmlehnih dim a ngah uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A nete numei leh naupang simlouh in, piching ngen sang nga vel ahi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan mipite a sawlmang khit in a paima a galkhat a na pai masa ding in nungzuite long ah a tuangsak teitei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mipite a paimang nung in thum ding in tang ah a tuam in a paitou a, nitaklam a hong hih in huai ah amah kia in a omta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Long dil laitak ah a omta a; huih in a hilou lam a a sawn ziak in tuikihawt in a septa hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zan ven lina ah Jesu dil tung ah khe a pai a, a kiang lam uh honzuan in a mu uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nungzuite’n amah dil tung a khe a pai a muh un, “Sikha ahi” chi in a buai ua, lau in a kikou ta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Himahleh Jesu’n amau a houpih paha, “Khamuangtak in om un, keimah ka hi, lau kei un,” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peter in a dawng a, “Toupa, nang na hihleh tui tung ah nang kiang a hongpai thu honpia in” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan aman, “Hong paive” a chi a, Peter long a kipan a kum a, Jesu kiang zuan in tui tung ah khe in a paita hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh huihnung a muh in a lau a, tum din a kisa a, “Toupa, hon hondam in” chi in a kikou hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu’n a sawkpah a, amah a len a a kiang ah, “Nang gintawm, bangdia ginglah na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan long a a tuan uleh huih a daita hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Long a omte’n, “Pathian Tapa na hi taktak hi” chi’n, amah a bia uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan galkhat lam a kai uleh, Gennesaret gam a hongtung uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai mun a mite’n amah a theihtak un, huai kim gam tengteng ah mi a sawl ua, damlou tengteng a kiang ah a honpi ua;
  </para>
  <para style="p">
    <verse number="36" style="v" />A puanmong bek khoih theih a ngen ngutngut ua; huan a khoih peuhmah a dam zel uhi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai in, Jerusalem khua a om Pharisaite leh laigelhmite Jesu kiang ah a hongpai ua,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Bangdia na nungzuite upate thugousiah a talek nak uh ahia? Tanghou a nek chiang un a khut uh a sil ngeikei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu’n a kiang uah, “Nou leng bangdia na thugousiah ziak ua Pathian thupiak a talek na hi ua?
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in, ‘Na nu leh na pa zahtak in, kuapeuh a nu hiam a pa hiam gensia si ngeingei heh’ a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nou bel, ‘kuapeuh a nu hiam a pa hiam kiang a, n’on zatna ding Pathian kiang a piak a hih peuhmah chiang in,
  </para>
  <para style="p">
    <verse number="6" style="v" />a nu leh a pa a zah ding ahi nawnkei’ na chi uhi. Huchi in na thugousiah ziak un Pathian thu bangmahlou na suah uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nou lepchiahte, Isai in na tungtang thu uh a na genkhol dik mahmah hi:
  </para>
  <para style="p">
    <verse number="8" style="v" />‘Hiai mite’n a kam un a honzah ua, a muk un a honphat ua, himahleh a lungtang un a hon gamlat uhi chi in,
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh, a thuhilhna ua mihing thupiak a hilh ziak un a hon biak uh a thawn mai ahi.’ ” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan mipi a sam a a kiang uah, “Ngaikhia unla, theisiam un;
  </para>
  <para style="p">
    <verse number="11" style="v" />Kam a lut in mihing a hihnin kei a; himahleh kam a pawt, huai ngei in mihing a hihnin zaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huailai in a nungzuite a hongpai ua, a kiang ah, “Pharisaite’n huai thu a zak ua a lungkimlouh dan uh na thei hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman, “Kung tengteng ka Pa van a om suanlouh bohkhiak in a om ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaute awlmoh kei un: mittaw makai ahi uh; huchi in mittaw in mittaw mah a pi leh kawkhuk ah a ke khawm ding uh” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan Peter in a kiang ah, “Huai gentehna thu hon hilhchian in, chi in a dong hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman, “Tutan a nou leng thei nailou lai na hi umaw?
  </para>
  <para style="p">
    <verse number="17" style="v" />Kam a lut peuhmah gil ah a lutsuk a, dailenna ah paihkhiak in a om chih na theikei ua hia?
  </para>
  <para style="p">
    <verse number="18" style="v" />Kam a pawtte bel lungtang a kipan a hongpawt ahi ua: huaite ngeingei in mihing a hihnin nak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lungtang a kipan ngaihtuahna giloute, tualthahna, angkawmna, kingaihna, guktakna, hekna, gensiatna a hongpawt nak hi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaite ahi mihing hihnin; khut sillou a annek in mi a hihnin kei” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu hiai a kipan pawt in Tura leh Sidon uk ah a paita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan ngai dih, huai gam a kipan Kanan numei khat a hongpai hi, “Toupa, David Tapa, ka tung ah zahngai in, ka tanu dawi in lungkhamhuaipi in a man” chi’n, a kikou hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman bel kam khat in leng a dawng kei hi. A nungzuite’n, “I nung ah a kikou kou a, paisak mai in” chi in a hong gen uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman bel, “Israel inkaw nam lak a belam mangte kiang loungal ah sawl ka hi kei” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh numei a hongpai a, “Toupa honhuh in” chi in, a bia hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan aman, “Tate tanghou laksak a, uite kiang a paih a kilawm kei” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Numei in, “Toupa, hihzaw ahi tham hi; himahleh, uite’n leng a pu uh dohkan a kipan a tanghou nen kia a nezel sam ve ua oi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huaitak in Jesu’n a kiang ah, “Numei, na ginna thupi na tel e; na deih bangtak in na tung ah om hen” a chi a, a dawng a, huchi in a tanu huai hun ngei in a damta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu huai a kipan a pai a, Galili dil kiang a hongtung a: tang ah a paitou a, huai ah a tuta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in mipi tampi a kiang uah a hong ua, khebaite, mittawte, pautheiloute, piangsualte leh midang tampi a honpi ua aman amaute a na hihdam chiat hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mipite’n pautheiloute hong pau a, piangsualte hong hoih a, khebaite khe a pai a, mittawte’n hon mutheita uh chih a muh un lamdang a sa mahmah ua; huchi in Israelte Pathian a phatta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in Jesu’n a nungzuite a sam a, “Mipite ni thum ka kiang ah a omta ua, nekding bangmah a neihlouh ziak un, ka lainat mahmah; anngawl in ka paikik sak utkei hi, huchilou in zaw lamkal ah a bahse kha ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nungzuite’n a kiang ah, “Mipi hiai zahzah vahna khop tanghou huai zahzah gamdai ah koi a kipan i mu dia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan Jesu’n a kiang uah, tanghou phel bangzah na nei ua? a chi hi. Amau a kiang ah, phel sagih, nga neu tawmchik toh” a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan aman lei a tu ding in mipite thu a pia a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan tanghou phel sagih leh ngate a la a, kipahthu a gen in, a balkham a, nungzuite kiang ah a pia a, huan nungzuite’n mipite kiang ah a pe sawn uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan avek un a ne ua, a vah chiatta ua; a khamval nen uh bawmpi sagih a dim hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A nete tuh numei leh naupang simlouh in, piching ngen sang li ahi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan mipite a sawlmang nung in Jesu long ah a tuang a, Magadan gam a hongtungta hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaizoh in Pharisaite leh Saddukaite a hongpai ua, amah ze-etna ding in van a kipan chiamtehna amaute ensak ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman a kiang uah, “Nitaklam a hong hih in, khua a pha dia ading meisan a suak, na chinak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan zingsang in, tuni’n khua se dia ading e, meisan a suak a, a niamkai, na chinak uh. ‘Van omdan na theisiam ngal ua, himahleh, hun chiamtehnate na theisiam theikei uhi.’
  </para>
  <para style="p">
    <verse number="4" style="v" />Khang gilou leh angkawmte’n chiamtehna a zong ua, himahleh, Jonah chiamtehna loungal a kiang uah chiamtehna piak a hi kei ding” chi in, a dawng hi. Huan amaute paisan in a pawtkheta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan nungzuite galkhat lam a tun un tanghou a paw mangngilh ua,
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu’n a kiang uah, “Pharisaite leh Saddukaite silngou lak ah kiveng unla, pilvang un” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amau, “Tanghou i puaklouh ziak uh eive” chi’n a kingaihtuah uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu’n huai a thei a, “Ginglahte aw, bang a chia tanghou na neihlouh ziak ua kingaihtuah na hi ua?
  </para>
  <para style="p">
    <verse number="9" style="v" />Tu nangawn in na lungsim un na thei naikei lailai umaw? Mi sang nga nek tanghou phel nga leh, a khamval uh bawmpi bangzah na dimsak zah uh na theigige kei ua hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi sang li nek tanghou phel sagih leh, a khamval uh bawmpi bangzah hiam na luahdim uh chih theilou maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Tanghou thu na kiang ua genlou in, Pharisaite leh Saddukaite silngou apan pilvang un, chih gen ka hizaw chih bang a chia theilou na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huaitak in tanghou silngou lak a pilvang ding in a sawlkei a, Pharisaite leh Saddukaite thuhilhna apan pilvang ding in amau a sawlzaw chih a theita uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaisaria uk a Philippi mun a hongtun in Jesu’n a nungzuite kiang ah, “Mite’n Mihing Tapa kua ahi a chi ua?” chi in, a dong hi,
  </para>
  <para style="p">
    <verse number="14" style="v" />Amau, “khenkhat in, Baptispa Johan ahi, a chi ua; khenkhat in, Elijah ahi, a chi ua; khenkhat in, Jeremiah hiam zawlnei kuahiam ahi” a chi uh, a chi uhi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman a kiang uah, “Ahihleh, nou kua ka hi n’on chi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Simon Peter in, “Khrist Pathian Hing Tapa na hi” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu’n a kiang ah, “Simon, Bar Jonah, hampha chia; sa leh sisan in a hon theihsak na hi kei a, ka Pa van a om hon theihsak na hizaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />K’on hilh ahi, nang Peter na hi, hiai suangpi tung ah ka saptuam ka lamtou ding a, misi khaw kulh kongkhakte’n hiai a zoukei ding uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Van gam tahbite k’on pe ding a, leitung ah bangpeuh na hen van ah leng hen ahi ding a, leitung ah bangpeuh na phel van ah leng phel ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaizoh in Khrist ahi chih kuamah hilhlou ding in nungzuite a chi bikbek hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huai nung in Jerusalem a a pai ding dan, upate, siampu liante, laigelhmite apan thil tampi a thuak ding dan leh hihlup a a om ding dan, ni thum ni a kaihthoh a a om ding dan Jesu’n a nungzuite a theisak panta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai phet in Peter in amah a pituam a; “Toupa, hi kei hen! Huaite na tung ah tung ngeikei hen!” chi in, a taihilh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu a kihei a, Peter kiang ah, “Setan, ka nung ah pai in; kei a di’n pukna na hi; Pathian thilte ngaihtuahlou in mihing thilte na ngaihtuah zaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu’n a nungzuite kiang ah, “Kuapeuh in a hon zuihnop leh amah ki mangngilh in, a Kros pua in honzui hen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuapeuh a hinna humbit ut in a tan ding a; kuapeuh keimah ziak a a hinna tan in a humbit ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Min khovel a pum in nei henla, a hinna tan leh amah ading in bang a phatuam dia? Ahihkeileh min a hinna sik in bang a pethei dia?
  </para>
  <para style="p">
    <verse number="27" style="v" />“Mihing Tapa a angelte toh, a Pa thupina a kizem a a hongpai ding ziak in. Huai hun chiang in michih a nasep bang un a dinchiat ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chihtaktak in k’on chi hi, hiai a ding akhente, Mihing Tapa a gam a hongpai a muh masiah uh, sihna chiamlou hial ding a om uh” a chi hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan ni guk nung in Peter, Jakob, leh a unau Johan a tuam in Jesu’n tang sangtak ah a paitouh pih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan a ma uah a mel omdan a hong lamdangta a; a mai ni bang in a hong tang a, a puansilh te vuk bang in a hong ngouta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan ngai dih, Mosi leh Elijah, amah kihoupih in a kiang uah a kilak uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Peter in Jesu a houpih a, “Toupa, ei din hiai a om a hoih, na ut leh hiai ah aidakbuk thum ka bawl ding a; nang ading in khat, Mosi ding in khat, Elijah ding in khat” a chi hi;
  </para>
  <para style="p">
    <verse number="5" style="v" />A genlai tak in, Ngai dih, mei ngoutak in amau a hon liahta a; ngai dih, mei a kipan aw in, “Hiai ka Tapa deihtak, ka kipahna mahmah ahi: amah thu ngai un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan nungzuite’n huai a zak un khupboh in a puk ua, a lau mahmah uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu’n amau a hong khoih a, “Thou unla, lau kei un” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a dak khia ua, Jesu kia loungal kuamah a muta kei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan tang a kipan a kumlai un, Jesu’n a kiang uah, “Mihing Tapa misi lak a kipan a thohnawn masiah na thilmuh uh kuamah hilhkei un” chi in thu a pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan a nungzuite’n a kiang ah, “Laigelhmite’n, Elijah hongpai masa ding ahi, bangchidan a chi ahi ua?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman, “Elijah a hongpai ding him ahi, bangkim a siam hoih ding hi
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh k’on hilh ahi, Elijah zaw a hong paikhinta, amah a theikei ua, a tung ah a utut un a hihzawta uhi. Huchi mah bang in Mihing Tapa in leng a lak uah a thuaksam ding” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huaitak in, nungzuite’n, Baptispa Johan thu a kiang uah a gen ahi chih a hon theita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan mipi kiang a hongtun un, mi khat a kiang ah a hongpai a, a ma a khukdin in,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Toupa ka tapa tung ah zahngai in, kaihvei ahi, a nak thuak telmai; tamveipi mei ah a puklut a, tamveipi tui ah leng a puknak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na nungzuite kiang ah konpi a, a hihdam theikei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu’n, “Ginna neilou leh khang genhakte aw, bang tan ahia k’on thuakzoh ding, amah ka kiang ah honpi un” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Jesu’n dawi a tai a, asung a kipan a pawt a; huai dak in naupang a damta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai zoh in, nungzuite a tuam in, Jesu kiang ah a hongpai ua, “Bang a chia kou delhkhe theilou ka hi ua?” a chi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman a kiang uah, “Na gintak louh ziak un ahi. Chihtaktak in k’on hilh ahi, ankam tang khat bang ginna na neih uleh, hiai tang kiang ah, Hiai a kipan huai a pam ah va kisuan in, na chi ding ua, a kisuan mai ding; nou ding in hihtheih louh bangmah a omkei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Akoi abang hileh, hichibang zaw thumna leh anngawlna loungal in a paikhe kei ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Galili gam a a omlai un, Jesu’n a kiang uah, “Mihing Tapa zaw mihingte khut a matsak in a om ding; a that ding ua:
  </para>
  <para style="p">
    <verse number="23" style="v" />Ni thum ni’n kaihthoh in a om ding hi” a chi a, huchi in a lungkham mahmah uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kapernaum khua a hongtun un, Pathian biakin sumkhonte Peter kiang ah a hongpai ua, “Na pu un biakin sum pe zel lou hia? a chi uhi,
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman, “Pezel e” a chi hi. Huan insung a a valut in, Jesu’n a kiang ah, “Simon, bangchi’n na ngai a? Lei a Kumpipate’n siah leh leiman sumte kua apan ahia a lak zel uh? A tate ua pan hia, mituam apan? chi in, a na gen tuh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Peter in, “Mituam apan” a chihtak in, Jesu’n a kiang ah, “Huchi ahihleh tate awl uh ahi vaw oi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Himahleh nang dil ah vahoh inla, ngakuai diah inla, nga a hongsuak masapen man in, a kam kek lechin dangka nih na mu ding; huaite la inla kei leh nang ading in a kiang uah pia in, huchilou in zaw amaute i hih lungkim kei kha ding,” a chi hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai tak in nungzuite Jesu kiang ah a hongpai ua, “Van gam ah kua a thupipen dia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan aman naupang neuchik a sam a; a lak uah a dingsak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Chihtaktak in k’on chi ahi, na lamdan ua, naupang neuchik bang n’ong hih kei uleh, van gam ah na lut kei hial ding uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in kuapeuh hiai naupang neuchik bang a kingainiam, huai mi van gam ah a thupipen ding a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan kuapeuh ka min ziak a hichibang naupang neuchik khat kipahpih keimah hon kipahpih ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Himahleh hiai hon gingta neuchikte lak a khat leng hihpuk, a ngawng ah buhgawizanna suang lianpi oksak in tuipi thuklai ah khemang le uh amah ading in a hoihzaw ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Puknate ziak in khovel tung a gik hi; puknate bel om ding him ahi a; himahleh pukna omsakpa tung a gik hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Huan na khut hiam, na khe hiam, in hon hihpuk leh, tankhia inla, paimang in; khut nih leh khe nih nei a tangtawn mei a paih a om sang in, piangsual hiam khebai hiam a hinna a lut nang ding in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan na mit in a hon hihpuk leh khelkhia inla, paimang in; mit lang nih nei a Gehenna mei a paih a omsang in, mit langkhat nei a hinna a lut nang ading in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Hiai mineute lak a khat leng simmohlou ding in pilvang un, a angelte un van ah ka Pa van a om mel a en gige uh chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihing Tapa mangthangte zong ding a hongpai ahi him ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bangchi na sa ua? Mi kuapeuh in belam za nei henla, a lak ua khat vakmangta leh sawmkua leh kuate nusia in, tang a pai in, a mang pen a zong kei dia hia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Chihtaktak in k’on hilh ahi, a muhnawn zenzen leh sawmkua leh kua vakmangloute tung ah sang in, tua belam tung ah a kipak zaw ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi mah bang in hiai mineute lak a khat manthat na Pa uh van a om deihlam a hi kei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Huan na unau in na tung ah thil a hihkhelh leh pai inla, amah leh nang kia theih in a khelhna hilh in; a hon ngaihkhiak leh na unau na zou ahi ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />A hon ngaihkhiak kei leh midang khat hiam nih hiam na kiang ah na pi dia, huchi in thu chiteng theihpih mi nih hiam thum hiam kam a hihkip a a om theihna ding in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan amau leng a ngaihkhiak nopkei lai leh, saptuamte kiang ah tun in. Huan saptuamte leng a ngaihkhiak nopkei leh, amah tuh nang ding in Jentel leh siahkhawnmi bang hi hen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Chihtaktak in k’on hilh ahi, leitung ah bangpeuh na hen uh, van ah hen ahi ding. Huan leitung a na phel uh, van ah leng phel ahi ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Chihtaktak in k’on hilhnawn hi. Leitung ah na lak ua mi nih a thil nget ua a kithutuah uleh, ka Pa van a om hihsak in a om ding uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi nih hiam thum hiam ka min a a kikhopna peuh uah a lak uah ka om zel hi” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huailai in Peter a hongpai a, “Toupa, ka unau in bangzah vei ahia ka tung ah hihkhial leh ka ngaihdam ding? Sagihvei tan in ahi diam?” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu’n a kiang ah, Sagihvei tan k’on chikei a, “Sagihvei mun sawmsagih tan,” k’on chi zaw ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Huaiziak in, van gam kumpipa kuahiam a sikhate kiang a a sumthu saifel tum toh tehpih ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi a sumthu honsai pattak in, mi khat talent sing khat ba a kiang ah a honpi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan piak ding a neihlouh ziak in, a pu in amah toh, a zi toh, a tate toh, a neih tengteng toh zuak a dit ding thu a pia hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in, sikha in Toupa, ‘ka tung ah zahngai tadih inla, avek in k’on pe ding, chi in khupboh in a bia hi.’
  </para>
  <para style="p">
    <verse number="27" style="v" />Huai sikhapa pu’n a hehpihta mahmah a, a khah a, a bat a ngaidamta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh huai sikha a paikhia a, a sikha hihpihte lak a khat a makhai za khat ba a va mu a; amah a man a, na bat honpia in, chi in a gawlmek hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in a sikha hihpihpa’n khupboh in, ka tung ah zahngai tadih inla, k’on pe ding, chi in a ngen ngutngut hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh a utkei a; a bat a piak zoh masiah suangkulh ah a khumta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in, a sikha hihpihte’n a thilhih a muh un, poi a sa mahmah ua, a thilhih tengteng a Toupa uh a hilhta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huaitak in a toupa’n amah a sam a, a kiang ah, sikha gilou, n’on nget ngutngut ziak a, n’on bat tengteng hon ngaidam ing a:
  </para>
  <para style="p">
    <verse number="33" style="v" />K’on hehpih bang in nang leng na sikha hihpih na hehpih sam ding hilou hia? a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in a Toupa a thangpaita a, a bat tengteng a piak zoh masiah migawtte kiang ah a peta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Michih in na lungtang tak ua na unaute uh na ngaihdam kei uleh ka Pa van a om in leng huchi mah bang in na tung uah a hih sam ding” a chi hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichi ahi a, Jesu’n huai thute a gen zoh in, Galili gam a kipan a pawt a, Jordan luigal Judia gam ah a hoh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipi thupitak in a zui ua; amaute a hihdam zel hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan Pharisaite a kiang ah a hong ua, amah ze-etna ding in, “Bangziak peuh in min a zi mak a siang hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman, “A tung a kipan amau bawlpa’n numei leh pasal a bawl leh,
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiai ziak in pasal in a nu leh a pa a paisan ding a, a zi a len ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in, a nih un sa pumkhat a hong hita ding uh, a chi chih na simkei ua hia? Huchi in nih ahita kei ua, sa pumkhat ahi zawta uhi. Huaiziak in Pathian in a gawmsa mihing in khenkei hen” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amau bel a kiang ah “Ahihleh, bangdia Mosi in kimakna laipiak a mak ding chi a thupia ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman a kiang uah, “Mosi in na lungtang uh khauh ziak in eive na zite uh mak a phal; himahleh a tung a kipan huchibang ahi ngeikei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ken zaw k’on chi ahi, kuapeuh kingaihna ziak hilou a, zi ma a midang nei angkawm ahi: maksa nei peuhmah leng angkawm ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nungzuite’n a kiang ah, “A zi lam thu a pasal huchibang ahihleh kiten hoihkei” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a kiang uah, huai thu ahihleh, a piaknate kia loungal, mi napeuh in a pom theikei ding uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi chilgeh, a nu gilsung ua kipan huchibang a piang himte a om ua; michilgeh, mihing khut a gehte leng a omsam ua; michilgeh van gam ziak a chilgeh a kibawltawmte leng a omsam uhi. Kuapeuh a pom thei in pom hen” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huailai in a tung ua a khutkoih a, a thumsak ding in, a kiang ah naupang neute a honpi ua; nungzuite’n a na tai uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu’n, “Naupang neute ka kiang ah honsawl unla, khamkei un; van gam hichibang mite a ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan a tung uah a khut a koih a, huai apan in a paita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan mi khat a kiang ah a hong a, “Pu, tangtawn hinna ka neih theihna ding in thil hoih bang ka hih ding? a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman a kiang ah, “Thil hoih thu bangdia hon dong? Hoih khat kia a om; himahleh, hinna a na lut utleh thupiakte zui in” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman a kiang ah, “A koipen maw?” a chi hi. Jesu’n, “Tual na thah ding ahi kei; Ang na kawm ding ahi kei; Na gu ding a hi kei; Na hek ding ahi kei;
  </para>
  <para style="p">
    <verse number="19" style="v" />Na nu leh na pa zahtak in, chihte leh nangmah na ki-it bang in na vengte na it ding ahi chih” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangval in a kiang ah, “Huaite teng ka zui zel; bang ka samlai a?” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu’n a kiang ah, “Hoihkim a om na ut leh, pai inla, na neih tengteng zuak inla, mizawngte kiang ah pia in, huchi in, van ah gou na nei ding; huan, hongpai inla, honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tangval bel huai thu a zak in lungkhamtak in a paimangta a, mi hausa a hih ziak in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a nungzuite kiang ah, “Chihtaktak in k’on hilh ahi, mi hausa dia van gam lut haksa pi ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan k’on hilh ahi, mi hausa Pathian gam a lut sang in sangawngsau phim bil a lutsuak a baihlam zaw” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan nungzuite’n huai a zak un, lamdang a sa mahmah ua, “Kua hotdam in a om zou dia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu’n amau a en a, a kiang uah, “Huai mihing hihvual a hi kei, Pathian a di’n bangkim hihtheih ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Peter in a kiang ah, “Ngai dih, kou bangkim paisan in k’on zuita ua; bang ka mu ding ua?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu’n a kiang ah, chihtaktak in k’on hilh ahi, “Khovel thak ah, Mihing Tapa a thupina tutphah a a tut chiang in, nou kei hon zuite, Israel nam sawmlehnihte tung a vaihawm in, mangtutphah sawmlehnih ah na tu sam ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan michih a innte, a unaute, a sanggamnute, a pa, a nu, a tate, a gamte ka min ziak a paisan peuhmah tuh a leh za a mu ding ua, tangtawn hinna a tang ding uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh mi tampi, masapen a omte, nanungpen in a om ding uh; nanungpen a omte leng masapen in a om ding uh” a chi hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Van gam tuh inn neipa grephuan a semdingte chial ding a zing a pawtkhia bang ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman nasemte toh ni khat a makhai loh dia a kituahtak un a grephuan ah a sawl chiat hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan dak thumna ding vel in a vapawt a, midang dawlmun ading maimaite a mu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kiang uah, ‘nou leng grephuan ah vapai sam ve ua, a kilawm hun k’on pe ding,’ a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in a paita uhi. Huan, dak gukna ding leh dak kua na ding vel in a va pawtnawn a, huchi mah bang in a hih nawn hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan dak sawmlehkhatna ding in a va pawt a, midang dingte a mu a; a kiang uah, ‘Bangdia nitum a hiai lai ading maimai na hi ua?’ a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amau a kiang ah, ‘kuamah in a hon chiallouh ziak un,’ a chi uhi. Aman a kiang uah, ‘nou leng grephuan ah vahoh sam un,’ a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan, nitaklam a hong hih in, grephuan neipa’n, a sumkempa kiang ah, nasemte sam inla, a nanungpen a kipan a masapen tan in a loh uh pia in, a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan dak sawmlehkhatna ding khong in a chialte a hong uh leh makhai a mu chiat uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A masapente a hong ua, muh tamdeuh a kigingta ua; himahleh amau leng makhai mah a mu chiat uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A loh uh a santak un, inn neipa tung ah a phun uhi,
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiai nanungpente’n dakkal khat kia a sem ua, kou sun haksa leh kho-ul thuakte toh kibang in na bawl a, chi in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman bel, a lak ua mi khat kiang ah, ‘Lawm, na tung ah bangmah ka hihkhial sam a; makhai loh ding in i kituak ka hia?
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang a la inla paimai in; nang ka honpiak bangmah hiai nanungpen kiang ah ka pe nuam ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei a hiven, ka utut a ka hih a siang ka hia? Ahihkeileh kei ka hoih ziak in nang na haza ahia?’ chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in a nanungpente a masapente a honghi ding ua, a masapente leng a nanungpente a honghi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jerusalem khua a a hohtouh lai in Jesu’n a nungzui sawmlehnihte a pituam a, lampi ah a kiang uah,
  </para>
  <para style="p">
    <verse number="18" style="v" />“Ngai dih uh, Jerusalem khua ah i paitou dia, Mihing Tapa siampu liante leh laigelhmite khut a matsak in a om ding; amau si ding in a tung ah thu a hihpuk ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nuihzabawlna dia zatding leh Kros a kilhden ding in Jentelte kiang ah a pe ding uh; huan, ni thum ni a kaihthoh in a om ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huailai tak in, Zebedai tapate nu, a tate pi in, a kiang ah a hong a, amah bia in, thil banghiam a ngen hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan aman a kiang ah, “Bang ahia na deih?” a chi hi. Aman, “Hiai ka tapa nihte na gam ah na taklam ah khat, na veilam ah khat a tut theihna ding un thupia in” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu’n, “Na nget uh theilou hi uteh. Ka nou dawn ding na dawn thei ua hia? Ka baptisma tan ding na tangthei ding ua hia?” chi in, a dawng hi. Amau a kiang ah, “Thei e” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman a kiang uah, “Ka nou na dawn ngei ding ua; ka baptisma tan ding na tangthei ding uhi. Himahleh ka taklam leh ka veilam a tut ding thu zaw kei piak ding a hi kei, ka Pa bawlsakte ading ahizaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in sawmte’n huai a zak un unau nihte tung ah a hehta uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n amaute a sam a, “Jentelte vaihawmte a tung uah a thunei mahmah ua, a miliante un a tung uah thu a nei mahmah lai uh chih leng na thei uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh nou lak ah zaw huchi a hi kei ding; kuapeuh na lak ua milian hih ut na nasem un a omzaw ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuapeuh na lak ua masapen hih ut na nasem un a omlai ding ahi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihing Tapa nasepsak a om ding in a hong paikei a, nasem ding leh mi tampi tatna dia a hinna pe ding a hongpai ahizaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jeriko khua a kipan a pawtlai un mipi tampitak in amah a zui uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngai dih, mittaw nih lamgei a tute’n Jesu a pai chih a zak un, “Toupa Nang David Tapa, ka tung uah zahngai in” chi in, a kikou uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mipite’n dai ding in a tai ua; himahleh, amau, “Toupa Nang David Tapa, ka tung uah zahngai in” chi in, a ki nakkou semsem uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu ading a, amau a sam a, “Na tung uah bang ka hih na ut ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amaute’n a kiang ah, “Mitvak ka ut uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n amau a hehpih mahmah a, a mit uh a khoih a; huchi in, a muthei pah ngal ua, amah a zuita uhi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Jerusalem khua a tunding kuan un, Bethphage khua, Olive tang a tun un Jesu’n nungzuite nih a sawl a, a kiang uah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Na mazawn khua uah vahoh unla, sabiltung khih, a kiang a a nou toh, na mu ding ua; phel unla, ka kiang ah honkai un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan kuapeuh in na kiang ua banghiam a gen uleh, ‘Toupa’n a deih a ahi,’ na chi ding uh; aman a honsawl pah maiding” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiai tengteng zawlnei kam a gen a hongtun theihna ding in a hong omta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“En dih, na Kumpipa, thunuailut tak in, Sabiltung tung ah, Sabiltungnou tung ngei a tuang in na kiang ah a hongpai, chi in, Zion tanu hilh in,” a chih.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in nungzuite a vapai ua, Jesu’n a kiang ua thu a piak bang ngei in a hihta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sabiltung leh a nou a honkai ua, a tung uah a puante uh a phah ua, huai ah a tuangta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan mipi lak a tamzaw in lampi ah a puante uh a phah ua, midang in singsawl sat in, lampi ah a phah uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipi a malam a paite leh a zuite’n, “David Tapa kiang ah Hosanna! Toupa min a hongpai a hampha hi; tungnungpen ah Hosanna!” chi in, a kikou uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jerusalem khua a honglut in a khua in, “Hiai mi kua ahia?” chi in, a ling souhsouh uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mipite’n, hiai mi zawlnei Jesu, Galili gam a Nazaret khua a ahi, a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian biakin ah Jesu a valut a, biakin a zuakmite leh leimite tengteng a delhkhia a, dangka khengte dohkante leh vakhu zuakte tutphahte leng a sawnpaih sak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A kiang uah, “Ka inn thumna in a chi ding uh chi a gelh ahi; nou bel suamhatte khuk in na bawlzaw uh” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Pathian biakin ah mittawte leh khebaite a kiang ah a hong ua; amau a na hihdam hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh siampu liante leh laigelhmite’n a thillamdang hihte leh biakin a, David Tapa Hosanna: chi a naupang kikoute a muh un, a lungkimkei mahmah uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kiang ah, hiaite thugen na za hia? a chi uhi. Jesu’n a kiang uah, “Za e, ‘naungekte leh nawi nelaite kam a pawt in pahtawina na hihkimta,’ chih na sim ngeikei ua hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan amau a paisan a , khopi apat a pawt a, Bethani ah a pai a; huai ah a giakta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A zing a khopi lam a a kiknawn lai in a gil a kialta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lampi sik ah theipi kung a mu a, a vanaih leh a nah kia loungal muh ding a omkei hi. Huan, a kiang ah, “Tangtawn in na gah nawn ken” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in theipi a vuaipah hi. Nungzuite’n huai a muh un, “Bangchidan ahia theipi a vuaipah tel?” chi in lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu’n a kiang uah, “Chihtaktak in, k’on hilh ahi, ginna na neih ua, na ginlah kei uleh, theipi tung a hih bangphet leng na hihkei ding ua, hiai tang kiang ah leng, na kisuan inla, tuipi ah na kipailut in, chi le uchin, na chih bang un, a om maiding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bangpeuh gingta a thum a na nget uh na mu ding uh” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan Pathian biakin a lutnung a thu a hilhlai in, siampu liante leh vantang upate a kiang ah a hong ua, a kiang ah, “Kua thu in ahia hiai thil na hih? Kuan thu honpia ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu’n a kiang uah, “Ken leng thu kamkhat k’on dongsam ding a, huai n’on hilh uleh, kua thu in hiam hiai thilte ka hih chih k’on hilh sam ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Johan baptisma koi a kipan ahia? Van a kipan hia, ahihkeileh mihing a kipan?” chi in a dong hi. Amau a kingaihtuah ua, ‘Van a kipan chile hang, bangdia amah ginglou na hi ua leh?’ a honchi ding a;
  </para>
  <para style="p">
    <verse number="26" style="v" />Mihing a kipan chi lehang, mipi i kihta ngal a; mi tengteng in lah Johan zawlnei in a pom ngal ua” a chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in Jesu a dawng ua, “Theikei ung” a chi uhi. Aman leng a kiang uah, “Ken leng kua thu in ahia hiai thilte ka hih k’on hilh sam kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Himahleh nou bangchi na sa ua? Mi kuahiam in tapa nih a nei a, a khatna pen kiang ah a vahoh a, ‘Tapa aw, tuni’n ka grephuan ah vasem ve,’ a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman, ‘ka utkei’ chi in a dawng hi. Himahleh a denchiang in a lungsim a kheng a, a kuanta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan a nihna pa kiang ah leng a vahoh a, tua bangmah in a vachi hi. Aman ‘Pu, ka kuan ding’ chi a dawng na pi in a kuanta kei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huai mi nihte a kua zaw in a pa uh deihlam a hih a leh?” a chi hi. Amau “A masapen in” a chi uhi. Jesu’n a kiang uah, “Chihtaktak in k’on hilh ahi, siahkhawnmite leh kizuakte’n Pathian gam ah nou a hon lutsan ding uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Johan diktatna tawn in na kiang uah a hong a, amah na gingta kei uhi: siahkhawnmite leh kizuakte’n amah a gingta uhi; noute’n huai na muh nung un leng amah na gintakna ding un na kisik nuam tuankei uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Gentehna thu dang ngaikhia un: Mi kuahiam inn neitu a om a, huai min grephuan a bawl a, dai in a umsuak a, grep sukna khuk a tou a, inn sang a lam a; loukemte kiang ah khohloh ding a pia in gamdang ah a paita hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan a gahloh hun in a gah lakhawm ding in loukemte kiang ah a sikhate a sawl hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Loukemte’n tua sikhate a na man ua, khat a vua ua, khat a that ua, khat suang in a deng uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huaizoh in sikha dang amasa pawl sang a tamzaw a sawlnawn hi; amau tung ah leng a ma ua mite a hih bangmah un a na hih nawn uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huai nung in, ‘Ka tapa a zahtak ding uh,’ chi in, a tapa a kiang uah a sawl hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Himahleh loukemte’n a tapa a na muhtak un, hiai mipa gouluahdingpa ahi; that ni e: a gouluah ding tansak ni, a kichi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huchi in amah a man ua, grephuan a kipan a paikhia ua, a thatta uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in grephuan neipa a hongpai chiang in huai loukemte tung ah bang chin a honhih dia le?” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amau tuh a kiang ah, “Huai migiloute haksatak in a hih mangthang ding a, grephuan loukem midang a loh hun teng a a gahte a kiang a pe zel dingte kiang ah khohloh ding in a pe ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu’n a kiang uah, “Inlammite suang deihlouhpen huai ngeingei a ning a suang phatuampen a hong hita. Huai Toupa hih ahi, i mit muh in a lamdang ahi, chih Laisiangthoute na sim ngeikei ua hia?”
  </para>
  <para style="p">
    <verse number="43" style="v" />Huaiziak in Pathian gam na kiang ua kipan laksak ahi dia, a gahsuah ding namdang kiang ah piak ahi ding, chih, k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huai suang tung a puk tuh a kitam gawp dia; a delhkhakmi a gawizan ding” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan siampu liante leh Pharisaite’n a gentehna thute a zak un amau tungthu a gen chih a theita uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huchi in amah mat a tum ua; himahleh mipi’n zawlnei a a pom ziak un a kihta uhi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu’n amaute houpih in a kiang uah gentehna thu a gen nawn hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Van gam tuh kumpipa kuahiam a tapa adia kitenna Ankuanglui toh teh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan kitenna Ankuang um dia a chialte sam ding in a sikhate a sawl a, himahleh a hong nuam kei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman, ka chialte kiang ah, ‘ngai dih ua, ka Ankuang a manta; ka bawngtalte leh ka ganvakthaute ka gouta a, bangteng a manta hi; kitenna Ankuang um ding in hongpaita un,’ chi un, chi in, sikha dang a sawlnawn hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh a na limsak kei ua, khat a lou ah a kuan a, khat a sumsinna ah a paimang hi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Midangte’n a sikhate a man ua, zumhuaitakin a bawl ua, a hihlumta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in, kumpipa a thangpaita a; a sepaihhon a sawl a, tualthatte a hihmang a, a khua uh leng a halsakta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A sikhate kiang ah, ‘kitenna Ankuang man ahita, ka chialte netak a hi kei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huaiziak in lamlian ah pai unla, mi na muh peuhpeuh uh kitenna Ankuang um ding in chial un,’ a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in huai sikhate a pawt ua, lamlian a vapai in, a muh peuhmah uh, migilou leh mi hoihte leng a pikhawm vek uhi: huchi in kitenna dantan michialte in a hong dimta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Himahleh kumpipa michialte enkhe ding a a honglut leh kitenna puan silhlou mi khat huai ah a mu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in a kiang ah, ‘Lawm, bangchidan a kitenna puan silhlou a hiai a honglut na hia?’ a chi hi. Amah a daidide hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kumpipa’n a sikhate kiang ah, ‘a khut leh a khe gak unla, pawlam mial ah paikhia un; huai ah kah leh hagawi a om ding,’ a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chialte tampi ahi ua, telte zaw tawmchik ahi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huailai in Pharisaite a thugen a a mat theihna ding dan a kikum uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan amau a nungzuite uleh Herod pawlte a kiang ah a sawl ua, huai mite’n, “Sinsakpa, mi diktak na hi a, diktak in Pathian thu na hilh a, kuamah deihsak tuam leh maivil tuam na neikei chih ka thei uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huaiziak in bangchi na sa a, honhilh in? Kaisar kiang a siah piak a siang hia sianglou?” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu’n a gitlouhdan uh a zetheih a, “Lepchiahte aw, bangdia hon ze-et na hi ua?
  </para>
  <para style="p">
    <verse number="19" style="v" />Na siahsum uh hon ensak un” a chi hi. Huan a kiang ah makhai a honla uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman a kiang uah, “Hiai kua lim leh kua min ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau a kiang ah, “Kaisar a” a chi uhi. Aman a kiang uah, huchi ahihnung Kaisar thilte Kaisar kiang ah pia unla, Pathian thilte Pathian kiang ah pia un, a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiai thute a zaktak un lamdang a sa mahmah ua, amah nusia in, a paimangta uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai ni mah in, Saddukaite, thohnawnna a omkei chite, a kiang ah a hongpai ua;
  </para>
  <para style="p">
    <verse number="24" style="v" />A kiang ah, “Sinsakpa, Mosi in, mi taneilou in sileh, a unaupa’n a zi luah in a unaupa a di’n chi a khahsak ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahi a, koute lak ah sal sagih a om ua; a upapen in zi a nei a, a si a, chi a khahlouh ziak in a zi a unaupa luah ding in a nutsiat hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi mah bang in a nihna in a luah a, a thumna in a luah lai a, a sagihna tan in a luah chiat uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A tawp in avek ua a sih nung un numei mah leng a sita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in thohnawnna ah amau sagihte lak ah kuapen zi ahi dia? Avek un lah a neichiat ua? chi in” a dong uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n a kiang uah, “Laisiangthou leh Pathian thilhihtheihna na theihlouh ziak un na ngaikhial nak uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thohnawn hun ah zi leh pasal a kitenna a om nawn kei a, van a angelte bang ahi zawta ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh, misi thohnawnna thu Pathian in na kiang ua a gen na simkei ua hia?
  </para>
  <para style="p">
    <verse number="32" style="v" />‘Kei Abraham Pathian, Isak Pathian, Jakob Pathian ka hi,’ Pathian zaw misi Pathian a hi kei a, mihing Pathian ahizaw” chi in dawng hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mipite’n huai a zak un a thuhilh lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pharisaite’n Jesu’n Saddukaite a selkhia chih a zak un a kikhawm uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in a lak ua dansiammi khat in, amah ze-et in thu a dong hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Sinsakpa, dan ah bang thupiak pen ahia thupipen? a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman a kiang ah, “Toupa na Pathian tuh na lungtang tengteng in, na kha tengteng in, na lungsim tengteng in na it ding ahi, chih.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huai thupiak thupipen leh poimawh pen ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan a zom in, a kibatpih hiai ahi, ‘Nangmah na ki-it bang in na inveng leng na it ding ahi chih’
  </para>
  <para style="p">
    <verse number="40" style="v" />Huai thupiak nihte ah dan leh zawlneite thu tengteng a kikhaikhawm vek hi” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan Pharisaite a kikhoplai un, Jesu’n amaute thu a dong hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Khrist bangchi na sa ua? Kua tapa ahia?” a chi hi. Amau a kiang ah, “David tapa” a chi uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aman a kiang uah, “Bangchidan in ahia David in Kha a amah Toupa, a chih?
  </para>
  <para style="p">
    <verse number="44" style="v" />‘Toupa’n, ka Toupa kiang ah, “Na melmate na khepek nuai a ka koih masiah ka taklam ah tu in” a chih?’
  </para>
  <para style="p">
    <verse number="45" style="v" />David in amah Toupa, a chih ngal leh, bangchi’n a tapa ahi dia?” a chi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Kuamah in kam khat in leng a dawng theikei ua, huai ni a kipan kuamah in thu dang a dong ngam nawnta kei uhi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu’n mipite leh a nungzuite kiang ah thu a gen hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Laigelhmite leh Pharisaite Mosi tutphah ah a tu uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in a honhilh peuhmah uh hih unla zuizel unla; amau thilhih bang zaw hih tuankei un, genzaw a gen ua, a hih tuankei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Puakgik haksatak a bawl ua, mite a suan ua, amau lah a khutzung un leng a suan nuam kei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A thilhih tengteng uh mihing muh ding in ahi, a hihzawk uh, a thilbuh uleh a khipte uh a liansak ua, a puanmongkai uh a sausak ua,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ankuangluina ah mun hoihpen leh kikhopnain ah tutphah hoihpen leh,
  </para>
  <para style="p">
    <verse number="7" style="v" />Dawlmun a chibai buk leh min, ‘Rabbi, Rabbi,’ a chih bang uh a deihtuamse uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nou zaw, Rabbi chih in omkei un; sinsakpa khat na nei ua, nou tengteng unaute na hi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan leitung ah kuamah Pa, chi kei un: na Pa uh khat kia van a om ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Heutute chih in omsam kei un, heutu khat na nei ua amah Khrist ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na lak ua thupipen na sikha ua a om zawk ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kuapeuh kiliansak a dai ding, kuapeuh kingaineu pahtawi in a om ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Himahleh nou Laigelhmi leh Pharisai lepchiahte aw, na tung uh a gik hi: van gam lampi mite na khaksak ngal ua: nou lah na lut ngalkei uh, mi a lut dingte lut ding leng na phalkei zel uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Laigelhmi leh Pharisai lepchiahte aw, na tung uh a gik hi: meithai’ innte na negai ngal ua, thumna saupi mikhemna ding in na nei ua: huaiziak in mawhna liansem na mu ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nou Laigelhmi leh Pharisai lepchiahte aw, na tung uh a gik hi: phungkai khat lel bawl ding in tuipi leh gam na pai kimvel ngal ua, huchibang a a hongom tak in, amah noumau lehnih in gawtmun ta in na bawl uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Nou makai mittaw, kuapeuh Pathian biakin lou a kichiam bangmah ahi kei; kuapeuh Pathian biakin a dangkaeng lou a kichiam zaw tangtunsak ding ahi, chite aw, na tung uh a gik hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nou mihai leh mittawte aw: a bang a thupizaw a dangkaeng hia, dangkaeng siangthousak Pathian biakin?
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuapeuh maitam lou a kichiam bangmah ahi kei: a tung a thilpiak omlou a kichiam in a tangtunsak ding ahi, na chi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nou mittawte aw, a bang a thupizaw a, thilpiak hia thilpiak siangthousak maitam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in ‘maitam lou a kichiam peuhmah zaw maitam leh a tung a om tengteng lou a kichiam ahi.’
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Pathian biakin lou a kichiam peuhmah zaw Pathian biakin leh asung a tengpa lou a kichiam ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan van lou a kichiam peuhmah leng Pathian mangtutphah leh a tung a tupa lou a kichiam ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Nou Laigelhmi leh Pharisai lepchiahte aw, na tung uh a gik hi: pudina, mohuri, zira sawm a khat na pia ua, dan khawkzaw, diktatna, hehpihna, ginomna na limsak ngalkei uhi; himahleh hiaite eive na hih ding uh, a dangte hihlou tuanlou in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nou makai mittawte, thousi khisiang a sangawngsau nawmvalhte aw!
  </para>
  <para style="p">
    <verse number="25" style="v" />“Laigelhmi leh Pharisai lepchiahte aw, na tung uh a gik hi: nou leh kuang pawlam na hihsiang ua, asung lah lepgukna leh kideklouhna in a dim uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nou Pharisai mittaw, nou leh kuang sunglam hihsiang masa un, a pawlam leng a hongsiang theihna ding in.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Laigelhmi leh Pharisai lepchiahte aw, na tung uh gik hi: hansuang nuhngou, pawlam a kilawmtak a kilang, a sunglam misi guhte leh nin chiteng a dim bang na hi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nou leng huai bang in pawlam ah mihing mitmuh in diktattak in na kilang ua, na sunglam u bel lepchiahna leh gitlouhna in na dim uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Nou Laigelhmi leh Pharisai lepchiahte aw, na tung uh a gik hi: zawlneite han na lam ua, mi diktat hante leng na zem uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />‘I pipute damlai a na om hitaleng, zawlneite sisan suahna ua panglou ding hi hang a,’ na chi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in zawlneite thatte suante na hi uh chih na kitheisak uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na pipute uh hih bang in semzawm tou ngal un.
  </para>
  <para style="p">
    <verse number="33" style="v" />Gulte leh gulsuante aw, Gehenna vaihawmna bangchi’n na pelthei ding ua?
  </para>
  <para style="p">
    <verse number="34" style="v" />Ngai dih ua, huaiziak mah in na kiang uah, zawlneite, mipilte, laigelhmite k’on sawl ding; khenkhat na that ding ua, Kros ah na kilhden ding uh, khenkhat na kikhopnain uah savun khau in na zep ding ua, khoteng ah na sawi zel ding uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in Abel mi diktattak sisan a kipan, Pathian biakin leh maitam kikal a Barak tapa Zekariah na thah uh sisan tan in, leitung a mi diktat sisan na suah tengteng uh noumau tung ah a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Chihtaktak in k’on hilh ahi, huai tengteng tu khang tung ah a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Aw Jerusalem, Jerusalem, zawlneite that, na kiang ua a honsawlte uh suang a na denglum a, akpi in a noute a khanuai a a opkhum bang in na tate bangzah vei opkhum ka tum a, himahleh na utkei uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />En un, na inn uh a vuak a taisan in a omta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />K’on hilh ahi, ‘Toupa min a hongpai a hampha hi na chih masiah uh tuban n’on mu nawn takei ding uh’ ” a chi hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu Pathian biakin a kipan a pawtkhia a; a pailai in, a nungzuite Pathian biakin ensak ding in a kiang ah a hongpai uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Himahleh aman a kiang uah, “Hiai tengteng na mu umaw? Chihtaktak in k’on hilh ahi, hihchip louh a suang kichiang hiai ah a omkei ding” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Olive tang a a tutlai in nungzuite amau kia in a kiang ah, a hong ua: “Huaite chikchiang in a hongom dia? Na hong painawnna leh khovel tawpna ding chiamtehna bang ahi dia? honhilh in” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n amau a dawng a, “Kuamah in a hon khemzoh louhna ding in pilvang un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi tampi’n, ‘Khrist ka hi, chi in, keimah minlou in a hongpai ding uh, mi tampi a khemzoh ding ziak un.’
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan kidou thu leh kidou thuthang na za ding ua; na mangbat louhna ding un pilvang un; huaite a hongom ding him ahi; himahleh tawpna zaw ahi nai tadih kei ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nam tuam leh nam tuam a kidou ding ua, gam tuam leh gam tuam a kidou ding ua, mun tuamtuam ah kial a ke dia, zin a ling ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai tengteng nauvei kipatna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Huai hun chiang in gimthuak ding in a hon mansak ding ua, a honthat ding uh. Ka min ziak in nam tengteng huat na hi ding uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai hun chiang in mi tampi a puk ding ua, a kimansak tuah ding ua, a kihaw tuah ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Zawlnei taklou tampi a hongpawt ding ua, mi tampi a khempuk ding uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan hihkhelhna a punding ziak in mi tamzaw itna a hong dai ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh, a tawptan a thuakngap peuhmah, huai mingei hotdam in a om ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan hiai gam Tanchinhoih nam tengteng theihsakna ding in khovel tengteng ah hilh in a om ding; huai khitchiang in tawpna a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Huchi in hihmangbangpa kihhuai, zawlnei Daniel gen, Mun Siangthou ading na muh chiang un, a sim peuhmah in a omdan thei hen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Judia gam a omte tangsang ah taimang uhen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Inn tung a om in a inn a banghiam la ding in kum kei uhen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan, lou a om inn a puan la ding in kiknawn kei hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai ni’n gaite leh naunou pawmte tung a gik ding hi!
  </para>
  <para style="p">
    <verse number="20" style="v" />Na taimang hun ding uh phalbi lai hiam, khawlni hiam a hong tunlouhna ding in thum un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huai hun chiang in gimthuakna thupi a om ding ziak in, hichibang a thupi leilung piantung a kipan tutan in a om ngei naikei a, chikmah chiang in a hongom n’on sam kei ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai nite hihtom hi kei leh mihing dam in a pawtkei ding uh; himahleh, telte ziak in huai nite hihtom ahi ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Huai hun chiang in kuapeuh in na kiang ua, ‘En dih, Khrist hiai ah hiam, ‘huai ah, hiam,’ a chih uleh, gingta kei un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khrist taklou leh zawlnei takloute a hongpawt ding ziak un, huaite’n hithei liai leh telte nangawn leng a khempuk theihna ding un chiamtehna leh thillamdang thupitakte a hih ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngai un k’on hilhkholta ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Huchi in, na kiang uah, ‘ngai un, gamdai ah a om’ a honchih uleh, ‘paikhe kei un; dantan sunggil ah a om, a honchih uleh, taksang sam kei un’.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khua, suahlam a a hongphiat a, tumlam tan a a kilat zel bang in, Mihing Tapa a hong painawnna huchibang ahi ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sapul omna mun peuh ah musanete leng a omkhawm ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Himahleh huai gimthuakna nite nungzek in, ni hihmial in a om ding a, kha a vak nawnta kei dia, van a kipan aksite a hong ke ding ua, van thilhihtheihnate hihlin in a om ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai hun chiang in Mihing Tapa chiamtehna van ah a honglang ding a, huai hun chiang in leitung a nam tengteng in a sun ding ua, ‘Mihing Tapa thilhihtheihna leh thupina lian toh van meitung a hongpai a mu ding uh.’
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan, a angelte pengkul ging thupi toh, a sawlkhe ding, amau a telte lei ning lite a kipan, vantawp a kipan a lehlam tawppha in, a kaikhawm ding uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Huchi in, theipi kung ah gentehna thu zil un: a hiang a hongnou a, a nah a hongsel in nipi a nai chih na thei uh;
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi mah bang in nou leng huai tengteng na muh chiang un, amah a hongnaita a, kongkhak bul ah a om chih thei un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Chihtaktak in k’on hilh ahi, huai tengteng a tunkim masiah tulai khang a mangkei ding.
  </para>
  <para style="p">
    <verse number="35" style="v" />Lei leh van a mang dia, ka thu ahihleh a mang kei ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Himahleh, huai ni leh hun thu Pa kia loungal kuamah in, van a angelte’n leng, Tapa in leng, a theikei uh,
  </para>
  <para style="p">
    <verse number="37" style="v" />Noah damlai bang in Mihing Tapa hong painawnna ah ahi ding.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huai ni, tuichim tunma in, Noah long a a lut ni tan in, a ne un a dawn ua, zi leh pasal in a kinei ua;
  </para>
  <para style="p">
    <verse number="39" style="v" />Tuichim a hongtung a, avek ua a lakmang masiah bangmah a theikei uh; Mihing Tapa hongpai nawnna huchi mah bang ahi ding.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huai hun chiang in lou ah mi nih a om ding ua; khat paimangpih in a om dia, khat nutsiat in a om ding.
  </para>
  <para style="p">
    <verse number="41" style="v" />Numei nih buh gawinelna ah buh gawinel in a om ding ua, khat paimangpih in a om dia, khat nutsiat in a om ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huaiziak in kiging un, bang ni’n ahia na Toupa uh a hongpai ding na theihlouh ziak un.
  </para>
  <para style="p">
    <verse number="43" style="v" />Himahleh, hiai thei un, guta a hongpai hunding inn neitu in thei leh, a veng dia, a inn a phenvangsak kei ding hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huaiziak in nou leng kiging gige in om un, na ginlouh dak ua Mihing Tapa a hongpai ding ziak in.
  </para>
  <para style="p">
    <verse number="45" style="v" />“Sikha muanhuai, piltak, a pu’n a hunteng a a tanding uh hawmsak ding a a inkuanpihte tung a heutu dia a koih, kuapen ahi dia le?
  </para>
  <para style="p">
    <verse number="46" style="v" />A pu a hongpai chiang a sikha huchibang hih a a muhpen a hampha ding hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chihtaktak in k’on hilh ahi, a neih tengteng tung ah heutu di’n a koih ding.
  </para>
  <para style="p">
    <verse number="48" style="v" />Himahleh sikha gilou in, a lungtang in, ka pu a hong zok kei ding, chi in,
  </para>
  <para style="p">
    <verse number="49" style="v" />A sikha hihpihte na vua henla, nekham takhamte kiang ah ne in dawnta leh:
  </para>
  <para style="p">
    <verse number="50" style="v" />Huai sikha pu a gintak louh ni’n, a theihlouh lai in, a hongpai ding a,
  </para>
  <para style="p">
    <verse number="51" style="v" />Tum nih a suah ding a, mi lepchiahte tan bangbang a tangsak ding; huai ah kah leh hagawi a om ding hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Huai hun chiang in van gam tuh nungak siangthou sawm, a khawnvak uh tawi a mouneipa dawn ding a pawtte toh teh ahi ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in a lak ua nga a hai ua, nga a pil uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A haite’n a khawnvak uh a tawi ua, a tui a tawikei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A pilte’n bel a khawnvakte uh a tawi in, a um ah a tui leng a tawi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan mouneipa a hong zekai ziak in avek un a lusu ua, a na ihmuta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai dih uh! zanlai in, ‘mouneipa a hong e: a dawn ding in hongpawt un’: chi in, kikou ging a hong omta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaitak in nungak siangthoute a thouvek ua, a khawnvakte uh a hahsiang uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan, a haite’n, a pilte kiang ah, na khawnvaktui uh hon pesam un; ka khawnvak uh mit ding in a kisa, a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh, a pilte’n, kou leh nou ading in a kiching kei ding; a zuakte kiang ah pai unla, lei zaw un, chi in, a dawng uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan, lei ding a a paimang kal un mouneipa a hongtungta a; huchi in, a mansate amah toh kitenna Ankuang um ding in a lut ua; huan, kongkhak a khakta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai nung in nungak siangthou dangte leng a hongtung ua, “Toupa, Toupa, hon hon in” a chi uhi:
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh aman, chihtaktak in k’on hilh ahi, k’on thei ngeikei, chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huaiziak in, kiging un, a ni leh a hun na theihlouh ziak un.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Van gam tuh mi gamdang a pai dia kisa, a sikhate sam a, a sumte a kiang ua kemsak bang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sikha khat kiang ah talent nga a pia a, sikha dang kiang ah talent nih a pia a, sikha dang kiang ah talent khat a pia a; a hihtheih hun ding dan chiat ua pia in a paita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Talent nga mupa huai in a va sumsin paha, talent nga dang a mukheta hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi mah bang in talent nih mupa’n leng talent nih dang a mukhia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Talent khat mupa bel a vakuan a, lei a tou a, a pu dangka a phumgu zawta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Hun sawtpi nung in huai sikhate pu amau toh a sum tungtang hihfel ding in a hongpai ta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Talent nga mupa a hongpai a, talent nga dang a hontawi a, ‘Pu, nang talent nga n’on kemsak a; en dih, talent nga dang ka mukhia,’ a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A pu’n a kiang ah, sikha hoih leh muanhuai, na hihhoih hi, tawmchik tung ah na muanhuai a, tampi tung ah k’on omsak ding; na pu kipahna ah lut in, a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Talent nih mupa leng a hongpai a, ‘Pu, nang talent nih n’on kemsak a; en dih, talent nih dang ka mukhia,’ a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pu’n a kiang ah, ‘Sikha hoih leh muanhuai, na hihhoih e, tawmchik tung ah na muanhuai a, tampi tung ah k’on omsak ding; na pu kipahna ah lut in,’ a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Huan talent khat mupa leng a hongpai a, ‘Pu, mi chihhakpi na hi chih k’on thei a; na tuhlouhna ah leng na at a, na thehlouhna ah leng na khawm hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Huaiziak in ka lau a, ka vapai a, na talent lei ah ka selgu a; en in, nang a ngei na mu nawn hi,’ a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“A pu’n a kiang ah, ‘Sikha gilou leh zongzaw, ka tuhlouhna a ka at a, ka thehlouhna ah leng ka khawm chih na thei maw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi ahihngal leh ka dangka sumsinte kiang a na koih ding hi a, huchi a ka hongpai a kei a a pung toh ka muhnawn ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huaiziak in a talent khat laksak unla, talent sawm neipa kiang ah pia un.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kuapeuh a nei piak behlap ahi ding a, a honghau ding; kuapeuh a neilou a neihsun nangawn laksak ahi ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan sikha phatuamlou pawlam mial ah paikhia un, huai ah kah leh hagawi a om ding,’ chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Himahleh, Mihing Tapa, a angelte tengteng toh, a thupina a kivan a a hongpai hun chiang in, a thupina mangtutphah ah a tu ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ma ah namchih a kikhawm ding ua; belamchingpa’n kel lak apan belamte a khenkhia bang in amaute a khenkhe ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Belamte a taklam ah a koih ding a, kelte a veilam ah a koih ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huai hun chiang in Kumpipa’n a taklam a mite kiang ah, ‘Ka Pa deihsakte aw, hongpai un, khovel siamchil apan nou adia gam bawlsa luah un.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ka gil a kial in, nekding n’on pia ua; ka dang a tak in, dawn ding n’on pia uh; mikhual ka hih in n’on zintun ua;
  </para>
  <para style="p">
    <verse number="36" style="v" />Vuaktang ka hih in, puan n’on silhsak uh; ka chi a nat in, ka kiang a na hong ziak un,’ a chi ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Huai hun chiang in, mi diktatte’n, Toupa, chik in ahia gilkial a k’on muh ua nekding k’on piak uh? Dangtak a k’on muh ua, dawn ding k’on piak uh?
  </para>
  <para style="p">
    <verse number="38" style="v" />Chik in ahia mikhual a k’on muh ua, k’on zintun ua, vuaktang a k’on muh ua, puan k’on silhsak uh?
  </para>
  <para style="p">
    <verse number="39" style="v" />Chik in ahia china in hiam suangkulh ah hiam k’on muh ua, na kiang a ka hong uh? chi in, a dong ding uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kumpipa’n amaute kiang ah, chihtaktak in k’on hilh ahi, ‘hiai ka unau neupente lak a mi khat tung a na hih uh ka tung a hih na hi uh’ chi in, a dawng ding hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />“Huaikhit in, a veilam a mite kiang ah leng, ‘Hamsia thuakte aw, tangtawn mei Diabol leh a sawltakte dia mun bawl ah hon paimang san un;
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka gil a kial in, nekding n’on pekei ua; ka dang a tak in, dawn ding n’on pekei ua;
  </para>
  <para style="p">
    <verse number="43" style="v" />Mikhual ka hih in, n’on zintun kei uh; vuaktang ka hih in, puan n’on silhsak kei ua; china leh suangkulh a ka om in, n’on veh louh ziak un’ a chi ding hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />“Huai hun chiang in amau leng, Toupa, chik in ahia gilkial hiam, vuaktang hiam, china hiam, suangkulh ah hiam k’on muh ua, na nna k’on sepsaklouh uh? chi in a dong ding uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Aman a kiang uah, Chihtaktak in k’on hilh ahi, ‘hiai mi neupente lak a mi khat tung a na hihlouh uh ka tung a hihlou na hi uh’ chi in, a dawng ding hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan huaite tangtawn gawtna ah a pai ding ua; mi diktatte bel tangtawn hinna ah a pai ding uhi” a chi hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, Jesu’n huai thu tengteng a genkhit in, a nungzuite kiang ah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ni nih nungchiang in Paikan Ankuangluina a hongom ding chih na thei ua, Mihing Tapa kilhden ding in a mansak ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huailai in siampu lianpen Kaiapha a chih uh huangsung ah siampu liante leh vantang upate a kikhawm uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu zekhem a mat a, a hihlup theihna ding un a kikum uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh, “Ankuanglui sung in hikeileh huchilou in zaw vantang lak ah buaina a hongpiang khading” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bethani khua a, phak Simon inn a Jesu a omlai in,
  </para>
  <para style="p">
    <verse number="7" style="v" />Numei khat alabaster bawm a thau gimlim mantam tawi in, a kiang ah a hongpai a, an a umlai in a lu ah a sungbua hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh nungzuite’n huai a muh un a heh ua, “Bangdia hichibang a hih mangthang mawkmawk ahia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiai thau mantam tampi a zuak a, mizawngte kiang a piak theih ahi ngal a” a chi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu’n huai a theih in, a kiang uah, “Numei bangdia hihbuai na hi ua? Ka tung ah thil hoihtak a hih ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mizawngte tangtawn in na kiang uah a om uh a kei hiam, kei bel tangtawn a na kiang ua om ka hi kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiai thau gimlim ka sa a a sun, vui ding a honbawl ding in a hih ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chihtaktak in k’on hilh ahi, khovel tengteng ah koi ah leng hiai Tanchinhoih a genna peuh uah hiai numei thilhih leng amah theihgigena ding in a genzel ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai nung in sawmlehnihte lak a mi khat, Judas Iskariot a chih uh, siampu liante kiang ah a hoh a:
  </para>
  <para style="p">
    <verse number="15" style="v" />Amah, “Hon mansak le’ng, bang n’on peding ua?” a chi hi. Huchi in dangka sawmthum a buksakta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai nung matsakna ding hunlem a zongta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan tanghou silngou sohlouh ni, ni masapen in nungzuite Jesu kiang ah a hong ua, “Paikan Ankuanglui nekna ding koilai ah hon bawlsak le ung na ut a?” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman “Khopi ah kuahiam kiang ah hoh unla, a kiang ah, ‘Sinsakpa’n, ka hun a naita a; nungzuite toh Paikan Ankuang na inn ah ka um ding uh e’ a chi, vachi un” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu’n a kiang ua a chih bang in nungzuite’n a hih ua; Paikan Ankuang a bawlta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai ni nitaklam in, nungzui sawmlehnihte toh an a um uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />An a neklai un, aman, “Chihtaktak in k’on hilh ahi, na lak ua mi khat in kei a hon mansak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in a lungkham mahmah ua, a kiang ah, “Toupa, kei ka hi maw?” a chi chiat uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman, “Ankuang hon sawkpihpa ngei in kei hon zuausan in hon mansak ding a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing Tapa tanchin a gelh bang un a pai ding hi. Himahleh, Mihing Tapa mansak dingpa tung a gik hi: huai mipa zaw piang keileh amah ading in a hoihzaw ding” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan a mansak dingpa Judas in a dong a, “Heutupa, keimah ka hi maw?” a chi hi. Aman a kiang ah “Hi e” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan an a neklai un Jesu’n tanghou a la a, a vualzawl a, a balkham a; nungzuite kiang ah a pia a, “La unla, ne un; hiai ka sapum ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huaizoh in nou leng a la a, kipahthu a gen a, a kiang uah a pia a, “Na vek un dawn un;
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai ka sisan a thukhun thak, khelhnate ngaihdamna dia mi tampi dia pawt ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Himahleh k’on hilh ahi, ka Pa gam a nou toh a thak ka dawn ni a tun masiah tuban grepgui gahtui ka dawn nawnta kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan la a sakzoh un a pawt ua, Olive tang ah a paita uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu’n amau kiang ah, “Tuzan chiang in na vek un ka tungthu a lungkia in n’on taisan vek ding uh; ‘Belamchingpa ka zep ding a, belamte a dalh ding uh’ chih gelh bang in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Himahleh ka thohnawn nung in Galili gam ah na ma uah ka pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Peter in a kiang ah, “Avek un na tungthu ah lungkia in om mahle uh kei zaw lungkia in ka omkei hial ding” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n a kiang ah, “Chihtaktak in k’on hilh ahi, tuzan in ak khuan ma in, nang thumvei n’on kitheihmohbawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Peter in a kiang ah, “Na sihna a leng si sam ding himah leng k’on kitheihmohbawl kei hial ding” a chi a. Huchi bangmah in nungzuite’n leng a chi chiat uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huaizoh in amau toh mun khat Gethsemani a chih uh a tung ua: a nungzuite kiang ah, “Pam a ka vathum kal in hiai ah na tu un” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Peter leh Zebedai tapate nih a pi a, a lungkham in a hong mangbang mahmahta hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan a kiang uah, “Ka kha a lungkham mahmah a, sihna khop hial ahi; hiai ah om unla, hon venpih un” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Neukha in malam ah a vapaizek a, khupboh in, “Ka Pa aw, a hih theihleh hiai nou in honpel mahmah hen; himahleh keimah thu hilou in, nangmah thuthu hizaw hen” chi in, a thum hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan nungzuite kiang ah a hongpai a, amau ihmu in a hong mu hi, Peter kiang ah, “Nou dakkal khat lel leng hon hahpih zoulou na hi umaw?
  </para>
  <para style="p">
    <verse number="41" style="v" />Khemna a na lut louhna ding un kiging gige in thum un; kha in zaw a ngap a, sa bel a hatkei” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nihveina ah a vapai a, a thumnawn a, “Ka Pa aw, ka dawnlouh a hiai nou in a honpelh theihkei leh, nangmah thuthu hi hen” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A hongpai nawn a, amau ihmu in a hongmu nawn hi, a ihmut uh a suak mahmah hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan, a paisan nawn a, a thumveina ah a gen ngei gen in a thum nawn hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huaikhit in nungzuite kiang ah a hongpai nawn a, a kiang uah, “Na ihmu lailai umaw, na tawlnga lailai umaw? Ngai dih uh, a hun a hongtungta, Mihing Tapa mikhialte khut ah khotkhit ahita.
  </para>
  <para style="p">
    <verse number="46" style="v" />Thou unla, pai ni, en dih uh, a hon mansak dingpa a hong naita hi” a chi hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan, a genlai mah in Judas, sawmlehnihte lak a mi khat, siampu liante leh laigelhmite leh upate kiang a kipan mipi thupitak leh namsau leh khetbukte toh a hongtungta hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />A mansak dingpa’n chiamtehna ding a hilhkhol sipsip a, “Ka tawp penpen amah na man ding uh” chi in.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huchi in Jesu a vanaih a, “Chibai, Heutupa, chi in, a tawp tonton hi.”
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu’n a kiang ah, “Lawm, na hong nasan hih in” a chi hi. Huaitak in, Jesu a len ua, a manta uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan ngai dih, Jesu ompihte lak a khat in a khut in a sawk a, a namsau a dok a, siampu lianpen sikha a ban a, a bil a ban khiaksak hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Himahleh Jesu’n a kiang ah, “Na namsau a koihna ah koih nawn in, namsau pan peuhmah namsau mah a a sih ding ziak in.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ka Pa ngen leng angel sang guk mun sawmlehnih hon sawlpah ding; ngen theilou in n’on ngaihtuah ua hia?
  </para>
  <para style="p">
    <verse number="54" style="v" />Himahleh, ngen leng, bangchi’n ahia Laisiangthou in hichibang a hongom ding a chihte a tangtun theih ding?” a chi hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Huailai tak in Jesu’n mipite kiang ah, “Namsaute, khetbukte tawi in suamhat man ding bang in kei man ding a hongpawt na hi umaw? Pathian biakin ah niteng in thuhilh in ka tu a, n’on man ngalkei uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Himahleh zawlnei Laisiangthou thute a tunkimna dia hiai tengteng hongtungta eive” a chi hi. Huchi in nungzui tengteng in amah a nusia ua, a taimangta uhi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Jesu mante’n siampu lianpen Kaiapha inn a, laigelhmite leh upate omkhawmna ah amah a pita uhi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Himahleh Peter in gamla tak ah siampu lianpen huangsung tan in amah a zui hi, huan a valut a, a tawpna tan thei ding in sikhate lak ah a vatu hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amah hihlup theihna ding un siampu liante leh vaihawmte tengteng in Jesu hekna ding a zong uhi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Theihpih zuau tampi hongpai mahle uh ngohna ding a mu theikei uhi. A denchiang in mi nih a hongpai uhi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Hiai mipa’n, “Pathian biakin hihsia a, ni thum sung a lamnawn thei ka hi” a chi, a chi uhi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Huchi in, siampu lianpen a dingtou a, a kiang ah, “Bangmah a dawnglou ding maw? Hiaite hon hekna bangchidan ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Jesu bel a daidide hi. Huan siampu lianpen in a kiang ah, “Pathian hing min in k’on ngen ahi, Khrist, Pathian Tapa na hi hia? Honhilh in” a chi hi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Jesu’n a kiang ah, “Hi e, himahleh, k’on hilh ahi, tunung chiang in Mihing Tapa thilhihtheihna taklam a tu a, van meitung a hongpai na mu ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Huan siampu lianpen in a puansilh a botkek a, “Pathian a genseta; theihpih dang bangdi’n i kiphamoh nawn dia? Ngai dih uh, Pathian a gensiat dan tuin na za uh. Bangchi nasa ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Amau “Sitak ahi” chi in, a dawng uhi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Huan a mai ah chil a sia ua, a tum ua; khenkhat in a khutpek ua beng in,
  </para>
  <para style="p">
    <verse number="68" style="v" />“Nang Khrist, kua ahia hontum honhilh in?” a chi uhi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Peter pawlam huangsung ah a tu a: nungak nou khat a kiang ah a hongpai a, “Nang leng Galili gam a mi, Jesu kiang a om na hi ve” a chi hi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Aman bel, “Na thugen ka theikei” chi in, avek ua ma ah a kitheihmohbawl hi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Huan inlim a a pawttak in nungak dang in amah a mu a, huai a omte kiang ah, “Hiai mi Nazaret Jesu kiang a ompa ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Peter kichiam in “Huai mihing zaw ka theikei” chi in, kitheihmohbawl nawn hi.
  </para>
  <para style="p">
    <verse number="73" style="v" />Huan sawtlou nung in, a kiang a dingte’n, Peter kiang ah, “Nang leng a lak ua mi na hi vaw oi, na pau ah a kithei hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="74" style="v" />Aman bel huai mihing zaw ka theikei, chi in, hamsia kiloh in a kichiamta hi. Huchi in ak a khuang pahta hi.
  </para>
  <para style="p">
    <verse number="75" style="v" />Huan Peter in, “Jesu’n ak a khuan ma in nang thumvei n’on kitheihmohbawl ding” chi a a kiang a a thugen a phawkkhia a, a pawtkhia a, a kap huphup hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan zingsang a hong hih in siampu liante leh vantang upate tengteng Jesu that ding in a tungthu ah a kihou uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amah a hen ua, a pi ua, gam ukpa Pilat kiang ah a pi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan Judas a mansakpa’n Jesu siamlouh a tangsak uh chih a theih tak in a kisik a, dangka sawmthum siampu liante leh upate kiang ah a hontawi nawn hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Midik sisan ka khot thil ka hihkhial hi” a chi hi. Amau, “Huai kou a ding in bang a khawk dia? Nang na lohloh loh in” a chihsan uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman huai dangka Mun Siangthou ah a pailut a, paimang in a awklumta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan siampu liante’n huai dangka a la ua, “Hiai thohlawm bawm a koih a siangkei, sisan man ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in a kihou ua, mikhualte vuina ding in belvelmi mun a leita uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huaiziak in huai mun tutan in ‘Sisan mun’ a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan zawlnei Jeremiah in a na gen, “Amah man ding a Israel tate lak a kuate hiam in a sak uh dangka sawmthum a lata uhi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa’n honhilh bang in belvelmi mun man ding in a pia ua” chih a hong tangtungta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan gamukpa ma ah Jesu a ding hi. Gamukpa’n, “Judate kumpipa na hi hia?” chi in, a dong hi. Jesu’n a kiang ah, “Hi e” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siampu liante leh upate’n a heklai un bangmah in a dawngkei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in, Pilat in a kiang ah, “A hon hekna zouzai uh na za ka hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman kamkhat lel in leng a dawng kei hi; huchi in gamukpa’n lamdang a sa mahmah hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan gamukpa’n ankuangluini’n henta khat, a deihdeih uh, mipite ading in a pawtsak zel hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huailai in henta minthang, Barabba a chih uh a om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in, a hong kikhop un, Pilat in a kiang uah, “Kua zaw hon pawtsak leng na ut ua? Barabba hia, Jesu Khrist kichi?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hazat ziak in amah a mansak uh chih a thei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Vaihawmna tutphah a a tutlai in, a zi in, “Hiai midik tung ah bangmah hih ken, tuni’n amah ziak in ka mang in thil tampi ka thuak hi” chi’n a thukhak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan siampu liante leh upate’n, Barabba nget a Jesu hih manthat ding in, mipite a thuzoh uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gamukpa’n amau a houpih a, “Amau nihte a kua zaw hon pawtsak leng chi na hi ua?” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amaute’n, “Barabba” a chi uhi. Pilat in a kiang uah, “Jesu Khrist kichi, bang ka chihta dia le?” a chi hi. Avek un, “Amah zaw Kros ah kilhden in om hen” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman, “Bang di’n maw? Bang a hihkhial a ahia?” a chi hi. Himahleh amau, “Kros ah kilhden in” chi in, a kikou vengvung uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in, Pilat in bangmah a hih theikei a, a hong buai deuhdeuh zaw ding chih a theih in, tui a la a, mipite ma ah a khut a sil a, “Hiai midik sisan ah ka siang e; noumau na lohloh un loh un” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan mipi tengteng in, “A sisan zaw koumau tung ah leh ka tate uh tung ah om hen” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huaikhit in Barabba a pawtsak a; Jesu a zep a, Kros a kilhden ding in a peta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huaikhit in, gamukpa’ sepaihte’n Jesu Inpi ah a pilut ua, a pawl ua mi tengteng a kiang ah a hong kikhawm uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A puante suahsak in, puan sandup a silhsak uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Linglukhu a phan ua, a khusak ua, a khut taklam in sialluang a tawisak ua; a ma ah a khukdin ua “Chibai, Judate kumpipa” chi in nuihza bawlna’n a nei uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan amah a chilsiat ua, sialluang laksak in, a lu a khen uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Nuihza bawlna dia a neihkhit un, puan a suahsak ua, amah puante a silhsak nawn ua, Kros a kilhden ding in a pita uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan, a paikhiak lai un, Kurini khua a mi, a min Simon a mu ua; huai mi a Kros paw ding in a man uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Golgotha mun a hongtun un, huai tuh Luguh mun chihna ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Uain thuk, thilkha toh hel, dawn ding in a pia ua, himahleh a cheptak in a dawn nuam kei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kros a a kilhden khit un, aisan in a puansilh a kihawm uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan huai ah a tu ua a vengta uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A hekna uh, “HIAI JUDATE KUMPIPA JESU AHI” chi a gelh, a lu tung ah a suang uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amah toh, suamhat nih, a taklam ah khat a veilam ah khat a kilhden uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan mi vialvak peuh in a enghou ua, a lu uh sinkhum uhi,
  </para>
  <para style="p">
    <verse number="40" style="v" />“Nang Pathian biakin hihsia a ni thum a lam nawnpa, kihihdam in; Pathian Tapa na hihleh Kros a kipan hong kumsuk tanla” chi in.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huchi mah bang in siampu liante’n, laigelhmite toh, enghou in,
  </para>
  <para style="p">
    <verse number="42" style="v" />“Mi dangte hondampa, amah leh amah kihondam theilou pi in. Israelte kumpipa a hihngal leh tuin Kros a kipan hongkum leh a kei dia, huchi in amah i gingta mai ding.
  </para>
  <para style="p">
    <verse number="43" style="v" />Pathian a muangna a ka, amah zaw a ut leh tuin hondam leh ake; Pathian Tapa ka hi, a chi ngal a” a chi uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Suamhat a kilhden un leng, huchi mah bang in a enghou hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan dak gukna a kipan dak kua na tan in khua a hong mialvekta hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dak kuan a ding in, Jesu aw ngaihtak in, “Eloi, Eloi, lam a sabakthani?” chi in, a ki koukhia a, huai, “Ka Pathian, ka Pathian bangdia hon paisan?” chihna ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />A kiang a ding khenkhatte’n huai a zak un, “Hiai mi’n Elijah sam ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="48" style="v" />A lak ua mi khat kintak in a taipah a, spanji a la a, uain thuk ah a diahdim a, chiang ah a suang a, a dawnsak tou hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Midangte’n, “Ngaihsak kei un, amah lakhe ding in Elijah a hong hiam i en ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu ngaihtak in a kikou nawn a, a kha a khahta hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan ngai dih, Pathian biakin puanzak a tunglam a kipan a nuailam tan in hong keksuakta a; zin a hongling a, suangpite khangkham in; hante a hong kihong hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Misiangthou ihmusate sapum tampi leng kaihthoh in a omta uhi;
  </para>
  <para style="p">
    <verse number="53" style="v" />Huaite a thohnawn nung in, han apat hongpawt in khaw siangthou ah a lut ua, mi tampi lak ah a kilakta uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huan sepaih zaheutu leh a kiang a Jesu veng a omsamte’n, zinling leh thil omdante a muh un a lau mahmah ua, “Hiai mi Pathian Tapa ahi ngeingei” a chi uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Huai ah, numei tampi, a nna sepsak kawm zel a Galili gam a kipan a honzuite a om ua, gamlapi ah a en uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Huaite lak ah Mari Magdalini, Mari Jakob leh Joseph nu, Zebedai tapate nute a om uhi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huan nitaklam a hong hih in, mihausa, a min Joseph Arimathai khua mi, a hongpai a, amah leng Jesu nungzui ahi sam hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Huai mi Pilat kiang ah a vahoh a, Jesu luang a ngen hi. Pilat in piak ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Huchi in Joseph in a luang a la a, puanmalngat siangtak in a tuam hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />A han thak, suang khuakkuak ah a sial hi; han kongkhak ah suang lianpi in a delh a, a paita hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Huan huai ah Mari Magdalini leh Mari dang a om ua, han ma zawn ah a tu uhi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Huan a zing in huai tuh Kiginni zing ahi, siampu liante leh Pharisaite Pilat kiang ah a omkhawm kheukhou uhi.
  </para>
  <para style="p">
    <verse number="63" style="v" />“Pu, huai mi khemhat in, a damlai in, ni thum nung in ka thounawn ding, a chih ka theigige uhi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Huchi in han ni thum ni tan a venghoih ding in thupia in; huchilou in zaw a nungzuite’n amah a va gukhe ding ua, vantang kiang ah, misi lak a kipan a thounawnta ahi, a chi kha ding uh; huchi in khemna nanung zaw amasa sang in a hoihkei zawsem ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Pilat in a kiang uah, “Vengmi sepaihte na nei ve ua oi; pai unla, na hihtheih bang un veng hoihsak ta unla” a chi hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Huchi in vengmi sepaihte toh a vahoh ua, han a veng hoihsak ua, hansuang a chiamteh uhi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan khawlni a bei in, ni sagihni masapen ding a phalvak in, Mari Magdalini leh Mari dang han ending in a kuan uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai dih, nakpitak in zin a hongling a; Toupa angel van a kipan a hongsuk a, suang a hong khukkhia a, a tung ah a tuta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A mel omdan khophia bang ahi a, a puansilhte tuh vuk bang in a ngou hi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah a kihtak ziak un vengmite a ling ua, misi bang in a hong omta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angel in numeite a houpih a, a kiang uah, “Nou zaw lau kei un: Jesu, a kilhden uh na zong uh chih ka thei:
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai ah a omta kei; a gen bang ngei in a thounawnta, a lupna mun en un, a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Paimeng unla, nungzuite kiang ah, ‘misi lak a kipan a thounawnta hi; ngai dih uh, Galili gam ah na ma uah a pai; huai ah amah na mu ding uh’ chi in, hilh un. Ngai dih uh, k’on hilhta ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan lau leh kipak mahmah kawm in, han a kipan a pai mengmeng ua, a nungzuite hilh ding in a taita uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan ngai dih, Jesu’n amau a tuak a, “Chibai aw,” a chi hi. Huchi in, amau a khepek a len ua, a bia uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu’n a kiang uah, “Lau kei unla, paita un, Galili gam a pai ding in ka unaute va hilh un; huai ah n’on mu ding uh” a chi chi in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan a pailai un vengmi sepaih khenkhat khopi ah a va lut ua, thil omdan tengteng siampu liante kiang ah a va hilh uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Upate toh a kikhawm ua, a kihou zoh un, sepaihte kiang ah dangka tampi a pia uhi,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Zan a, ka ihmut kal un, a nungzuite a hongpai ua, amah a guta uh, chi unla,
  </para>
  <para style="p">
    <verse number="14" style="v" />gamukpa’n huai a na zak leh amah leng i khem ding ua lunghimawh lou ding in i bawl na ke,” a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in dangka a la ua, a hilh bang un a hihta ua; huchi in, tutan in huai thu Judate lak ah a genthang lai uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh nungzui sawmlehkhatte Galili gam ah, Jesu’n tang a sehsak ah a hoh uhi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Amah a muh un a bia ua; khenkhat in a ginglah uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in, Jesu a kiang uah a hongpai a, amau a houpih a, “Lei leh van a thuneihna tengteng ka kiang a piak ahita.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaiziak in, kuan unla, namchih apan nungzuite bawl unla, Pa, Tapa, leh Kha Siangthou min in baptist unla,
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu k’on piak tengteng zui ding in thuhilh un. Ngai un, kei tangtawn in, khovel tawppha in leng, na kiang uah ka om ding hi” a chi hi.
  </para>
</usx>
