<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="GEN" style="id">Genesis</book>
  <para style="h">Genesis</para>
  <para style="toc1">Genesis</para>
  <para style="toc2">Genesis</para>
  <para style="mt">Genesis</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tung in Pathian in lei leh van a siam.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lei a sia a, a vuak kia ahi. Tui thukpi tung a mial in a mial hi. Pathian Kha in tui tungte a opkhum hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in, “Vak om hen” a chi a, huchi in vak a hong omta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in vak a en a, hoih a sa hi. Huchi in Pathian in vak leh mial a khenta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian in vak, “Sun” a chi a, mial, “Zan” a chi hi. Huchi in a ni khatna ah nitaklam a om a, zinglam leng a om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in, “Tuite kikal ah vansin om henla, huai in tuite leh tuite khen hen” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian in vansin a bawl a, vansin nuai a tui omte leh vansin tung a tui omte a khenta a; huchibang a hong hita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in vansin van, a chi hi. Huchi in a ni nihna ah nitaklam a om a, zinglam leng a om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in, “Van nuai a tuite mun khat ah omkhawm henla, gamkeu hong dawk hen” a chi a; huchibang a hong hita hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian in gamkeu lei a chi a; tui omkhawmte tuipite a chi hi. Pathian in huai a en a, hoih a sa hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in, “Lei in loupate, anteh chi neite, thei sing, lei a amau chi omdan ding bang a gah, a gah sung a chi omte omsak hen,” a chi a, huchibang a hong hita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in lei in loupate, anteh amau chi omdan ding bang a chi neite, sing amau chi omdan ding bang a gah, a gah sung a chi omte a omsakta hi. Pathian in huai a en a, hoih a sa hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in, a ni thumna ah nitaklam a om a, zinglam leng a om hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in, “Sun leh zan khenna ding in vansin ah tanvakte om uhenla, huaite chiamtehnate, hunbite, nite leh kumte theihna hi uhen.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lei tanvak ding in van a vansin ah vakte om uhen” a chi a, huchibang a hong hita.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in tanvak thupi nih a bawlta a; tanvak thupizaw pen sun a vaihawm ding in, tanvak thupi louzaw pen zan a vaihawm ding in a bawl hi. Aksite leng a bawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in huaite lei tanvak ding in van a vansin ah a koihta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sun tung leh zan tung a vaihawm ding leh vak leh mial khen ding in. Huchi in Pathian in huai a en a, hoih a sa hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in a ni lina ah nitaklam a om a, zinglam leng a om hi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathian in, “Tuite’n thilsiam tang thei hinna neite tampi pawtsak uhenla, vasate leng leitung a van vansin hawm heuhou ah leng uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathian in ngapi liante a siam a, ganhing tang thei chiteng tui in a pawtsak a, amaute chi omdan ding bang leh kha nei vasa chiteng amaute chi omdan ding bang in a siam hi. Pathian in huai a en a, hoih a sa hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian in, “Chi tampi suang in hong pung unla, tuipi tuite dim sak unla, vasate leng lei ah pung uhen” chi’n a vualzawl hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in, a ni ngana ah nitaklam a om a, zinglam leng a om hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian in, “Lei in ganhing amau chi omdan ding bang chiat in; gante, khupboh a pai ganhingte, gamsate, amau chi omdan ding bang chiat in pawtsak uhen,” a chi a; huchi in huchibang a hong hita hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathian in gamsa amau chi omdan ding bang chiat in, gante amau chi omdan ding bang chiat in, lei a thil khupboh a paite tengteng amau chi omdan ding bang chiat in a bawl hi. Pathian in huai a en a, hoih a sa hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pathian in, “I kibatpih in, eimah bang in, mi i bawl dia, tuipi a ngasate tung ah, tung a leng vasate tung ah, gante tung ah leh leitung tengteng tung ah thu i neisak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathian in amah kibatpih in mi a siam a, Pathian kibatpih mah in ahi a siam; pasal leh numei a siamta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathian in amau a vualzawl hi. Pathian mah in a kiang uah, “Chi tampi suang ding in hong pung unla, lei luahdim unla, na thuthu un omsak un. Tuipi a ngasate tung ah, tung a leng vasate tung ah, thil hing leitung a khupboh a pai tengteng tung ah thunei un,” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian mah in, “Ngai un, leitung tengteng a anteh chinei omteng leh sing chiteng, sing chinei gah omnate, k’on pia hi; na an ding uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lei a gamsa chiteng kiang ah, tung a leng vasa chiteng kiang ah, leitung a khupboh a pai chiteng kiang ah, hinna nei chiteng kiang ah a an ding un loupa hing chiteng ka pia hi” a chi a; huchibang a hong hita hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian in a thilsiam tengteng a en a, ngai in, hoih a sa mahmah hi. Huchi in, a ni gukna ah nitaklam a om a, zinglam leng a om hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, lei leh van leh asung a om tengteng siamzoh ahita hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian in a ni sagih ni’n a nasep a zou a; a ni sagih ni’n a nasep tengteng a khawlsanta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in a ni sagih ni a vualzawl a, a tangta hi. Huai ni a Pathian in a siam leh a bawl, a nasep tengteng a khawlsan tak ziak in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei leh vante siam a a omlai ua a suante uh hiaite ahi; Toupa Pathian in lei leh van a siam ni’n,
  </para>
  <para style="p">
    <verse number="5" style="v" />lei a loupa himhim a om naikei a, lei a anteh leng a pou naikei hi. Toupa Pathian in leitung ah vuah a zusak naikei a, leilet ding in mihing leng a om naikei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh lei apan mei a hong suaktou a, leitung tengteng a nomsak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa Pathian in lei a leivui in mi a bawl a, a nakvangte ah hinna hu a khalut a; huai mi, mihing a hong hita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toupa Pathian in suahlam a Eden ah huan a bawl a; a bawl pasal huai ah a omsakta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Lei a kipan Toupa Pathian in sing mit hiptak leh nektuak chiteng a pousak hi. Hinna sing leh sialehpha theihna sing leng huan laizang ah a pousak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eden apan huan nomsak ding in lui a luang paisuak a; huai a kipan a ka zak a, ka li a hong hita hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A khatna min Pison ahi, hiai Havilah gam tengteng kualkhum lui ahi. Huai ah dangkaeng a om hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai gam a dangkaeng hoihtak ahi a, huai ah bedeli leh onik suang leng a om hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lui nihna Gihon ahi a; huai lui in Kush gam tengteng a kualkhum ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lui thumna min Hiddekel ahi a; hiai Assuria gam suahlam a luang ahi. Lui lina bel Euphrates ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa Pathian in pasal a pi a, Eden huan ah a kem ding leh a veng ding in a koihta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa Pathian in pasal kiang ah, “Huan a sing gah chiteng na utut na ne thei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A hoih leh a sia theihna sing gah bel na ne ding ahi kei. Na nek leh na nek ni mah in na si ngeingei ding hi” chi in, thu a pia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa Pathian in, “Pasal amah kia a om a hoih kei. Amah panpihtu ding a kilawm ka bawlsak ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa Pathian in leitung a kipan gamsa chiteng leh tung a leng vasa chiteng a bawlta hi. A min ding ua bang sak ding ahia chih theihna ding in Adam kiang ah a hon pikhawm hi. Ganhing chiteng a min uh Adam in a na phuah, a min uh ahi den hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adam in gan tengteng, tung a leng vasa tengteng leh gamsa chiteng min a phuak chiat hi. Himahleh Adam panpihtu ding a omkei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toupa Pathian in nuamtak in Adam a ihmu sak a, huchi in a ihmuta a; a nakguh khat a la a, a tang ding in sa a pang dimsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa Pathian in Adam apan a lak nakguh apan in numei a bawl a, Adam kiang ah a honpita hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Adam in, “Hiai hial zaw ka guh a kipan guh, Ka sa a kipan sa ahi. Pasal a kipan lakkhiak a hih ziak in, Numei, chih ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaiziak in, pasal in a nu leh a pa a paisan dia, a zi ah a belh ding. Huchi in sa khat a hong hita ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adam leh a zi vuaktang ahi tuak ua, a zum tuankei uhi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa Pathian in gamsa a bawl tengteng lak ah gul a gitlouhpil pen hi. Aman numei kiang ah, “Pathian in, ‘huan a singgah himhim na ne ding uh ahi kei chi ahi maw?’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Numei in gul kiang ah, “Chilou e, huan a singgahte ne thei mah ung.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan laizang a sing gah Pathian in, ‘Na ne ding uh ahi kei, khoih leng na khoih ding uh ahi kei, huchilou in zaw na si ding uh chi a ka’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gul in numei kiang ah, “Si zenzen lou e.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na nek ni ua pat na mit uh a hongvak dia, a hoih leh a sia thei in pathiante na hong bang ding uh, chih Pathian in thei kilkel eive,” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Numei in singgah nektheih ahi chih leh mit hiptak ahi chih leh mi pilsak dia singgah etlah huai ahi, chih a theih in a gah a lou a, a neta hi. A kiang a om a pasal leng a pia a, aman leng a neta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A nih un a mit uh a hong vakta a, vuaktang a hih uh hong kithei ua; theipi nah a khui khawm ua, puan a kibawl tawm uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toupa Pathian, nitaklam ninem a huan a vak aw a za ua; Adam leh a zi in huan a singlak ah Toupa Pathian a na kibuksanta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa Pathian in Adam a sam a, a kiang ah, “Kaw om na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman, “Huan ah na aw ka za a, vuaktang ka hih ziak in ka lau a; ka na kibuta,” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman, “Vuaktang na hih kua’n honhilh ahia? Singgah neklouh ding ka chih ne na hita maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Adam in, “Hon ompih dia n’on piak numei in singgah a honpia a, ne kei ve” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa Pathian in, numei kiang ah, “Na thilhih bangchidan ahia?” a chi hi. Numei in, “Gul in a hon zekhem a, ne kei ve” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in, gul kiang ah, “Hichibang a na hih ziak in ganhing tengteng leh gamsa chiteng lak ah hamsiat na hi tuanse dia, khupboh in na pai gige dia, na damsung in leivui na ne ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang leh numei k’on kidou sak dia, na suante leh a suante leng ka kidou sak lai ding. Huai in na lutang a sidup sak dia, nang a khetul na sidup sak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei kiang ah, “Na haksatna leh na naupaina nakpi’n ka pungsak dia; haksatak in tate na nei ding. Himahleh na deihlam na pasal lam ahi dia, aman na tung ah thu a nei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Adam kiang ah, “Na zi thu na man a, singgah na ne ding ahi kei, chi a, k’on thupiak na nek ziak in leitung nang ziak in hamsiat in a omta hi. Na damsung teng in gimtak a sem in a gah na neta ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ling leh louling neite leng a hon omsak dia, lei a anteh na neta ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lei a na kiknawn masiah na mai a kho-ul luang puappuap in an na neta ding. Lei apan lakkhiak na hi. Leivui na hi a, leivui ah na kiknawn ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adam in a zi, mihing tengteng nu a hih ziak in, a min Evi a sa hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toupa Pathian in Adam ading leh a zi ading in savun puanaktual a bawlsak a, a silhsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa Pathian in, “Ngai un, mihing in a hoih leh a sia thei in eite bang a hong hita. Tuin a khut a sawk in hinna singgah lou a ne in, tangtawn in a hing kha ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huaiziak in, Toupa Pathian in amah a lakkhiakna leilet ding in Eden huan a kipan a sawlkheta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihingte a delhkheta a; hinna sing lampi veng ding leh Eden huan suahlam pang ah Cherubte leh mei namsau kilek zualzual a omsakta hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Adam in a zi Evi a luppih a; huchi in a gai a, Kain a nei hi; “ Toupa panpih in pasal ka neita,” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A nau Abel a hon neinawn hi. Abel belamchingmi ahi a, Kain bel leiletmi ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A nung in hichi a honghi a, Kain in Toupa kiang a lat ding in lou a piang leigahte a hontawi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abel in leng a belamhon lak a piang masapen leh a thau pen a hontawi a, Toupa’n Abel leh a thillat a kipahpih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh Kain leh a thillat bel a kipahpih kei. Kain a heh mahmah a, a mel a liap hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n , Kain kiang ah, “Bangdia heh na hia? Bangdia na mel liap ahia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Hih hoih lechin pahtak na loh kei dia hia? Na hih hoih keileh khelhna kongkhak bul ah a kual nilouh a, a deihlam nangmah ahi ding, a tung ah thu na nei ding ahi,” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kain in a nau Abel a houpih a, hichi ahi a, lou a a omlai un Kain in a nau Abel a sual a, a thatta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa’n Kain kiang ah, “Na nau Abel kaw om ahia?” a chi hi. Aman, “Ka theikei, ka nau donpa ka hi ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa’n , “Bang hih na tamai a? Na nau sisan aw in lei a kipan a honsam hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaiziak in, na khut a kipan na nau sisan sang dia kam a na ka lei apan hamsiat na hita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lei na leh in leng a hoihna a honpe nawn kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kain in, Toupa kiang ah, “N’on gawtna a na mahmah a, ka thuak zou kei ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai in, tuni in leitung a kipan n’on delhkheta a, Na mit muh phaklouh a sel a om ding ka hita. Lei ah taimang leh vakvai hi ding ka hita hi. Hichi ahi ding a, kuapeuh honmu in a honthat mai ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa’n a kiang ah, “Huchi ahihleh, kuapeuh Kain that a mun sagih in a tung ah phu a la ding uh” a chi hi. Mi amah mu in a thah louh na ding in Toupa’n Kain a chiamtehta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kain Toupa kiang a kipan a pawt a, Eden suahlam a Nod gam ah a tengta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kain in a zi a luppih a; Huchi in a gai a, Enok a nei hi. Khua a sat a, a khaw min a tapa tamsak in Enok a sa hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Enok in tapa Irad a nei a; Irad in tapa Mahujael a nei hi. Mahujael in tapa Methusael a nei a; Methusael in tapa Lamek a nei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lamek in zi nih a nei a; khat min Adah ahi a, khat pen min Zillah ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Adah in Jabal a nei a; amah puanin a om ganvulmite suangpa ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A nau min Jubal ahi a, amah kaihging leh tamngai tummi tengteng suangpa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zillah in leng Tubal Kain, dal leh sik, tuzat heizat chiteng sekmi, a nei hi. Tubal, Kain sanggamnu Naamah ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lamek in a zite kiang ah, Adah leh Zillahte aw, ka aw za unla; Lamek zite aw, ka thugen ngaikhia un. A hon liamsak ziak in mi khat ka that a, A hon sidup sak ziak in valnou khat ka that hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kain phu bawn a mun sagih a la ding a hih uleh Lamek phu a mun sawmsagih leh sagih in a la ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Adam in a zi a luppih nawn a; tapa a nei nawn a; a min Seth a sa hi. Pathian in Abel sik in chisuan ding a hon sehsakta; Kain in lah amah a thatta ngal a, a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Seth in leng tapa a nei a; a min Enosh a sa hi. Huai a kipan mite’n Toupa min a lou panta uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiai Adam suante tuanna laibu ahi. Pathian in mi a siam ni’n Pathian batpih in amah a bawl hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pasal leh numei in amau a siam a; amau a vualzawl a, amau siam a a om ni un a min uh Adam, a sa hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Adam in kum za leh sawmthum a hih in amah mah bang, a kibatpih ngei tapa a nei a; a min Seth a sa hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Seth a neih nung in Adam kum za giat a damlai a; tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Adam damsung tengteng kum za kua leh sawmthum ahi a; huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Seth in kum za leh nga a hih in, tapa Enos a nei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Enosh a neih nung in Seth kum za giat leh sagih a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Seth damsung tengteng kum za kua leh sawmlehnih ahi a; huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Enosh in kum sawmkua a hih in tapa Kenan a nei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kenan a neih nung in Enosh kum za giat leh sawmlehnga a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Enosh damsung tengteng kum za kua leh nga ahi a, huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kenan in kum sawmsagih a hih in, tapa Mahalaleel a nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mahalaleel a neih nung in Kenan kum za giat leh sawmli a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kenan damsung tengteng kum za kua leh sawm ahi a; huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mahalaleel kum sawmguk leh nga a hih in tapa Jared a nei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jared a neih nung in Mahalaleel kum za giat leh sawmthum a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mahalaleel damsung tengteng kum za giat leh sawmkua leh nga ahi a, huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jared in kum za leh sawmguk leh nih a hih in tapa Enok a nei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Enok a neih nung in Jared kum za giat a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jared damsung tengteng kum za kua leh sawmguk leh nih ahi a, huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Enok in kum sawmguk leh nga a hih in, tapa Methusel a nei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Methusel a neih nung in Enok kum za thum sung Pathian toh a tonkhawm ua, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Enok damsung tengteng kum za thum leh sawmguk leh nga ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian toh Enok a tonkhawm ua, amah a omta kei a; Pathian in a lata hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Methusel in kum za leh sawmgiat leh sagih a hih in tapa Lamek a nei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lamek a neih nung in Methusel kum za sagih leh sawmgiat leh nih a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Methusel damsung tengteng kum za kua leh sawmguk leh kua ahi a, huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lamek in kum za leh sawmgiat leh nih a hih in tapa a nei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiai ngeingei in Toupa hamsiat khum leitung ziak a i nasepna leh khut a i sepgimna ah a hon lungmuan ding, chi’n, a min Noah a sa hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Noah a neih nung in Lamek kum za nga leh sawmkua leh nga a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lamek damsung tengteng kum za sagih leh sawmsagih leh sagih ahi a; huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Noah kum za nga a upa ahi. Noah in Shem, Ham leh Japheth a nei hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hichi ahi a, leitung ah mite hong pung ua, tanute a honnei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian tapate’n mite tanute melhoih in a mu ua; a deihlam chiat uh zi in a nei uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa’n , “Ka Kha in mi tangtawn in a sual nilouh kei ding, amau lah sa ahi ngal ua. Himahleh kum za leh sawmnih a dam ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huailai in miliante lei ah a om ua; huai nung in leng Pathian tapate’n mite tanute a luppih ua, amau toh tate a neih zel lai un, huaite mah nidanglai a mihat, mi minthangte ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toupa’n lei ah mi gitlouh dan thupi ahi chih leh a lungtang lunggel dan gilou ngen ahi ngitnget chih a mu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leitung a mi a bawl ziak in Toupa a kisik a, lunggimna’n a neih loh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa’n , “Ka mi siam leitung a kipan ka hihmang mai ding. Mite, sate, ganhingte leh tung a leng vasate tan in; ka bawl ziak in ka kisik” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Noah in bel Toupa mitmuh in hehpihna a mu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Noah suan hiaite ahi uh. Noah midik ahi a, a dam tonpihte lak ah gensiatbei ahi. Noah Pathian toh a tonkhawm hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Noah in tapa thum Shem, Ham leh Japheth a nei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian mitmuh in lei a sekhinta a, lei hiamgamna in a dim khinta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian in lei a en a, ngai in, a sekhinta a; sa tengteng in leitung ah a omdan uh a hih sekhinta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in Noah kiang ah, “Sa tengteng beina ka ma ah a hongtungta. Amau tawn in lei hiamgamna in a dim khinta ngal a. Ngai in, lei toh amau ka hihmang ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang a ding in meilah sing in long bawl inla; long ah dantante na bawl ding ahi. A sunglam leh a pawlam meilah nai in na zut vek ding ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiai na bawl ding dan ahi. Long dunglam tong za thum hi henla, a vailam tong sawmnga hi henla, a sanlam tong sawmthum hi hen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Long ah tohlet na bawl dia, a tunglam tong khat chiang a na zoh ding ahi. Long kongkhak a pang ah na bawl dia; chial nuainung leh chial nihna leh chial thumna nei in na bawl ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ngai in, kei mahmah in, sa tengteng hinna hatna pai khempeuh, van nuai a kipan hih mangthang ding in leitung ah tuichim ka tungsak dia; lei a thilchih om a sivek ding uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh nang toh ka thukhun ka kipsak dia, long ah na lut ding ahi. Nang na lut dia, na tapate leh na zi leh na tapate zite leng na kiang ah a lut ding uh ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sa tengteng a thilhing chiteng lak a kipan, chichih nihnih in, na kiang ah hinsak ding in long ah na pilut ding ahi. A nu leh a pa zel ahi ding uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Vasate amau chi omdan bang chiat in, gante amau chi omdan bang chiat in, chichih nihnih in na hinsak ding in na kiang ah a hongpai ding uh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />An tengteng la inla, na kiang ah koihkhawm in. Nang leh amau ading in an ahi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchibang in Noah in a hih a; Pathian in a kiang a thu a piak tengteng bang in a hihta hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n , Noah kiang ah, nang leh na inkuanpih tengteng long ah lut un. Nang zaw hiai khang a ka ma ah mi diktat na hih k’on mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sa siang chiteng lak ah a pa leh a nu, kop sagih zel; sa sianglou lak ah a pa leh a nu chiat toh kop nih zel, na kiang ah na pi ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tung a leng vasa lak ah leng, a nu leh a pa chiat, kop sagih zel in, leitung a chi khah dia hinsak ding in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ni sagih in a samlai a, huaikhit chiang in leitung ah ni sawmli leh zan sawmli sung vuah ka zu sak ding. Ka bawl thil hing chiteng leitung a kipan ka hihmang ding, a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Noah in Toupa’n a kiang a thu a piak tengteng bang in a hihta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Leitung a tuichim a hongtun lai in, Noah kum za guk a upa ahita hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuichim a tun ding ziak in Noah long ah a lut a, a tapate leh a zi leh a tapate zite leng a kiang ah a lut uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sa siang lak ah leng, sa sianglou lak ah leng, vasa lak ah leng, leitung a khupboh a pai chiteng lak ah leng,
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in Noah kiang a thu a piak bang in, a nu leh a pa chiat, a kopkop in, Noah kiang ah long ah a lutta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni sagih nung in leitung ah tuichim a tungta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Noah kum za guk a hih in a kha nihna, ni sawmlehsagih ni’n, huai ni mah in tui thuk zapi nak tengteng a hong puakzak a, van tohlette leng a hong kihongta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni sawmli leh zan sawmli sung teng leitung ah vuahpi a zuta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai ni mah in Noah, Noah tapate Shem, Ham, Japheth leh Noah zi long ah a lutta ua, a tapate zi thumte leng a kiang ah a lut uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amaute a lut ua, sa chiteng amau chi omdan bang chiat in, ganhing leitung a khupboh a pai chiteng amau chi omdan bang chiat in, vasa chiteng, amau chi omdan bang chiat in, vasa chiteng, kha nei chiteng leng a lut uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sa tengteng hinna hatna pai him himte, a kopkop in Noah kiang ah long ah a lutta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A lutte Pathian in a kiang a thu a piak bang in, sa tengteng lak a a nu leh a pa zel in a lut uhi. Huchi in Toupa’n amah a khak khumta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuichim leitung ah ni sawmli sung teng a tung a; tui a hong khang a, long a lam a, leitung ah a domkangta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tui a hongom zuazua a, leitung ah a khan in a hong khangta hi, long tui tung ah a kilam hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leitung ah tui nakpi’n a hongom zuazuata a; van nuai a tang sang tengteng a tumkhin vekta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tong sawmlehnga hial a sang in tui a hongom a; tangte tupmang in a omta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sa lei a tangthei tengteng, vasate, gante, gamsate, ganhing lei a khupboh a pai chitengte, michih tengte toh a si khin vekta uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A nak ua hinna kha hatna omna tengteng, gam a om tengteng a sikhin vekta uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lei a thil hing chiteng omte, mite, gante, ganhingte, tung a leng vasate toh hihmang in a om ua; lei a kipan hihman in a omta uh. Long sung a om Noah leh a kiang a omte kia hawi in a om uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tui ni za leh sawmnga sung teng leitung ah a om hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Pathian in, Noah leh long sung a a kiang a thilhing chiteng leh gan om tengteng a theigige a; Pathian in leitung ah huih a nungsak a, tui a hong dai panta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tui thukpi nakte leh van tohlette hong kikhakta ua, van a kipan vuah leng theusak ahita hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Lei a kipan tui a kiam giaigiaita a; ni za leh sawmnga nung in tui a hong tawm deuhta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kha sagihna, ni sawmlehsagih ni’n Ararat tang ah long a hong kingata hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tui, a kha sawmna tan in a kiam giaigiai zel a; a kha sawmna ni khat ni’n mualvumte a kimuta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ni sawmli nung in hichi ahi a, Noah in a bawl long tohlet a hongta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Va-ak khat a khahkhia a, lei a kipan tui a kankhit masiah huai va-ak a vial lenlen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Leitung ah tui a tawmta hia, tawm nailou, chih theihna ding in vakhu khat a khah khe nawn hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh vakhu in tukna ding himhim a mu kei a, a kiang ah long ah a kiknawn a, tui lah leitung pumpi ah a omlai ngal a. Pawlam ah a khut a golh khia a, aman long sung ah a kiang ah a lalut nawn hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ni sagih dang a ngaklai a; vakhu long a kipan a khahkhe nawn hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vakhu nitaklam in a kiang ah a honglut nawn a; ngai in, a muk in olive nah khat a hontuah hi. Noah in lei ah tui a tawmta, chih a theita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni sagih dang a ngak nawn a; vakhu a khah khe nawn a; a kiang ah a hong kiknawn kei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichi ahi a, a kum za guk leh khatna, a kha khatna, a ni khat ni’n, tui lei a kipan a kangta hi. Noah in long khuhna a koihsuana, a en a; ngai in, leitung a hulta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kha nihna, ni sawmnih leh sagih ni’n lei a hulta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian in Noah kiang ah thu a gen a;
  </para>
  <para style="p">
    <verse number="16" style="v" />Long a kipan pawt in, nang pawt inla, na zi leh na tapate leh na tapate zite leng na kiang ah pawt uhen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sa tengteng lak a thilhing chiteng na ompihte, vasate, gante, ganhing leitung a khupboh a pai chitengte toh na kiang ah pikhia in, leitung a chipha tak a chi tampi suang a a hong punna ding un, a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Noah a pawt a, a tapate leh a zi leh a tapate zite leng a kiang ah a pawt uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sa chiteng, ganhing chiteng, vasa chiteng, leitung a tangthei peuhmahte amau chi omdan bang chiat in long a kipan a pawtta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah in Toupa ading in maitam a bawl a; sa siang chiteng lak leh vasa siang chiteng lak a kipan a la a, maitam ah haltum pumpiaknate a lanta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toupa’n huai namtui a za a; Toupa’n a lungsim in, “Mi ziak in leitung ka hamsiat nawn kei ding, mite lungsim ngaihtuahnate lah tuailai a hih a kipan gilou ahi ngal ua. Tua ka gawt bang in thil hing chiteng leng ka gawt nawn kei ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lei omlai teng buh leh buhlakte, khovot leh kholumte, nipi leh phalbite, sun leh zante a bei kei ding” a chi hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Pathian in Noah leh a tapate a vualzawl a, a kiang uah, “Chi tampi suang in hongpung unla, lei luahdim un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nou kihtakna leh lauhna lei a sa chiteng leh tung a leng vasa chiteng in a nei ding uh. Hiaite leh lei a khupboh a pai tengteng leh tuipi a ngasa tengteng na khut ua piak ahita uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thilhing tangthei chitengte nou ading in nekding ahi ding ua; anteh hing k’on piak bang in bangkim k’on pevek hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh sa, a hinna sisan toh na nekhawm ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na hinna sisan phu ka la ngeingei ding. Sa chiteng lak ah ka la dia, mi lak ah leng. Michih a unaute uh lak ah, mite hinna phu ka la chiat ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kuapeuh mi sisan suahmi, mi mah in amah sisan a suah ding ahi. Pathian batpih a mi bawl ahi ngal a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nou chi tampi suang in hong pung unla, ta leh nau tampi nei unla, leitung ah hongpung un” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in, Noah kiang leh a kiang a om, a tate kiang ah,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Ngai un, kei mahmah in na kiang uah leh nanung ua na suante uh kiang ah leng ka thukhun ka hihkip hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na kiang ua om thilhing chiteng, na ompih uh vasate, gante, na ompih uh lei a sa chitengte kiang ah leng; long a kipan hongpawt tengteng, lei a sa chiteng kiang na ngawn ah.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na kiang uah ka thukhun ka hihkip ding; sa tengteng leng tuichim a hihman in a om nawn kei ding uh. Lei hihse ding in tuichim a tung nawn kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian mah in, “Kei leh nou leh na kiang ua thil hing chiteng omte kal a , suan tawp neilou a omte ading in, hiai ka thukhun chiamtehna ahi ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Meipi ah ka sakhituihup ka zam sak a, huai kei leh lei kal a thukhun chiamtehna ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichi ahi ding a, leitung a meipi ka kaisak in sakhituihup meipi ah a kimu ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei leh nou leh sa tengteng lak a thilhing chitengte kal a , ka thukhun om ka theigige ding. Sa tengteng hihmang ding in tui a letnawn kei ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sakhituihup meipi ah a zam zel ding. Pathian leh leitung a sa om tengteng lak a thilhing chiteng kal a tangtawn thukhun om ka theihgige theihna ding in ka en zel ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian mah in, Noah kiang ah, “Hiai kei leh leitung a sa om tengteng kal a ka thukhun hihkip chiamtehna ahi” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Noah tapa long a kipan pawtte Shem, Ham leh Japheth ahi uh. Ham Kanaan Pa ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai mi thumte Noah tapate ahi ua, amau a kipan pawtte’n leitung pumpi a zelsuak uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Noah louneimi in a hongom pan a, grephuan a bawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uain a dawn a, a kham a; a puanin ah a lumkhialta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ham, Kanaan pa’n a pa lumkhial a mu a, inn pua a om a naute nih a hilh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Shem leh Japheth in puan a la ua, a liang ua kizawn in a nung pai ua, a pa uh lumkhial a khuhta uh. A mai uh lehlam nga in a pa uh lumkhial a mu kei uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Noah uain kham a honghalh a, a tapa naupangpen in a tung a a hih dan a hon theita hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Kanaan hamsiat in om hen. A unaute sikhate sikha ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Shem Toupa Pathian phat in om hen. Kanaan a sikha in om hen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathian in Japheth hihlian henla, Kanaan a sikha in om hen,” a chilai hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Noah tuichim tun nung in kum za thum leh sawmnga a dam hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Noah damsung tengteng kum za kua leh sawmnga ahi a; huchi in a sita hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hiaite Noah tapa Shem, Ham leh Japheth suante ahi uh. Tuichim tun nung in tapate a neichiat uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Japheth tapate: Gomer, Magog, Madai, Javan, Tubal, Meshek leh Tiras ahi uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gomer tapate: Askenaz, Riphath leh Togarmah ahi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Javan tapate: Elishah, Tarsis, Kittim leh Dodanim ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaite a kipan in Jentelte, amau pau leh amau nam bangzel in, amau chite omna tuikulh gam, amau gamte ah a kikhen zak uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ham tapate: Kush, Mizraim, Phut leh Kanan ahi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kush tapate: Seba, Havilah, Sabtah, Raamah leh Sabteka ahi uh. Raamah tapate: Sheba leh Dedan ahi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kush in tapa Nimrod a nei hi. Amah lei ah mi hattak a honghi panta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa ma ah sabengmi hattak ahi a; huaiziak in ahi, “ Toupa ma a sabeng hattak Nimrod bang ahi” a chih zel uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A lal patna Sinar gam a Babel khua, Erek khua, Akkad khua leh Shinar gam a Kalneh khua ahi uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai gam a kipan a pawt a, Assuria gam ah a lut a, Ninevi khua, Rehoboth Ir khua leh Kaineh khua a sat hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ninevi leh Kalah kikal ah Resen khua a sat a, huai Resen khua thupitak ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mizraim in Ludim, Ananim, Lehabim, Naphtuhim,
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathrusim leh Kasluhim, Philistiate leh Kaphtorimte pawtna, a suangta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kanan in tapa masa Zidon a nei a, Heth leng a neilai a,
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesbuste, Amorte, Girgaste;
  </para>
  <para style="p">
    <verse number="17" style="v" />Hivte, Arkate, Sinte;
  </para>
  <para style="p">
    <verse number="18" style="v" />Arvadte, Zemarte, Hamathte a suang a; huai nung in Kanaan namte a ki thehzakta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kanante gamgi Zidon khua a kipan Gerar, Gaza, Sodom leh Gomorrah, Admah, Zeboim leh Lasa khua tan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaite, a namte bangzel leh a paute, a gamte leh a namte lak ua bangzel in Ham suante ahi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Shem, Eber ta tengteng suangpa, Japheth u in leng tate a nei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Shem tate: Elam, Assur, Arpaksad, Lud leh Aram ahi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aram tapate: Uz, Hul, Gether leh Mas ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Arpaksad in tapa Shelah a nei a; Shelah in tapa Eber a nei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber in tapa nih a nei a: khat min Peleg ahi a, a damlai in lei khen in a omta ngal a; a nau min Joktan ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joktan in tapa Almodad, Seleph, Hazarmaveth, Jerah;
  </para>
  <para style="p">
    <verse number="27" style="v" />Hadoram, Uzal, Diklah;
  </para>
  <para style="p">
    <verse number="28" style="v" />Obal, Abimael, Sheba;
  </para>
  <para style="p">
    <verse number="29" style="v" />Ophir, Havilah leh Jobab a nei a; huai tengteng Joktan tapate ahi uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />A tenna uh Mesa a kipan suahlam tang Sephar tan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaite Shem suante ahi uh, a namte bangzel leh a paute bangzel in, a gamte ah leh a chite bangzel in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huaite Noah suan namte ahi ua, a suante uh bangzel in a chite uh lak ah; tuichim tun nung in huaite a kipan ahi a; lei a chichih khenkhiat ahi uhi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan lei a mi tengteng in pau khat leh paudan khat a nei uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichi ahi a, suahlam a kipan a kisuanzel laiun, Sinar gam ah phaizang a mu ua; huai ah a tengta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Kisa un; teklei i bawldia, hoihtak in i halding” a kichita uhi. Suang sik in teklei a nei ua, suanghukna sik in longnai a nei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Kisa un, khopi i bawl dia, insang a vum vansun ding in i bawl dia, i min i thang sak ding uh. Huchilou in zaw lei pumpi ah thehdalh in i omkha ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mite tate’n khopi leh insang a lam uh en ding in Toupa a hohsuk hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n “Ngai dih ua, mite pumkhat ahi ua, avek un lah pau khat a nei ngal ua; hiai thil a hih pan uhi. Tu’n zaw a thil hihtupte uh leng kham vual ahita kei ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kisa un, i va hohsuk ding ua, pau a kitheituah louhna ding un, a pau uh i va suklamdang sak ding” a kichi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Toupa’n amaute huai apan leitung tengteng ah a dalhsak hi. Huchi in a khopi bawl uh a tawpsanta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huaiziak in, a min Babel a chi uh; Toupa’n amaute leitung tengteng ah a dalhsakta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiai Shem suante ahi uh. Shem kum za a upa ahi a; tuichim tun nung kum nih nung in tapa Arpaksad a nei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Arpaksad a neih nung in Shem kum za nga a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Arpaksad in kum sawmthum leh nga a hih in, tapa Shelah a nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Shelah a neih nung in Arpaksad kum za li leh thum a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Shelah in kum sawmthum a hih in tapa Eber a nei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Eber a neih nung in Shelah kum za li leh thum a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Eber in kum sawmthum leh li a hih in, tapa Peleg a nei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Peleg a neih nung in Eber kum za li leh sawmthum a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Peleg in kum sawmthum a hih in tapa Reu a nei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Reu a neih nung in Peleg kum za nih leh kua a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Reu in kum sawmthum leh nih a hih in, tapa Serug a nei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Serug a neih nung in Reu kum za nih leh sagih a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Serug in kum sawmthum a hih in, tapa Nahor a nei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nahor a neih nung in Serug kum za nih a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nahor, kum sawmnih leh kua a hih in, tapa Terah a nei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Terah a neih nung in Nahor kum za leh sawmkua a damlai a, tanu leh tapate a neilai hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Terah in kum sawmsagih a hih in tapate Abram, Nahor leh Haran a nei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiaite Terah suante ahi uh: Terah in tapa Abram, Nahor leh Haran a nei a; Haran in tapa Lot a nei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Haran a pianna gam a, kaldaite khua Ur ah, a pa Terah ma in a si hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abram leh Nahor in zi a nei ua; Abram zi min Sarai ahi. Nahor zi min Haran tanu Milkah ahi. Haran, Milkah pa leh Iskah pa leng ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sarai a ching a; ta himhim a neikei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Terah in a tapa Abram, a tapa, Haran tapa, Lot, a mou, a tapa Abram zi Sarai a pi a; Kanan a hoh ding in Kaldaite khua Ur a kipan a pawtkhe khawmta uhi. Haran khua a hongtung ua, huai ah a tengta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Terah damsung kum za nih leh nga ahi a, Haran khua ah Terah a sita hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Abram kiang ah, “Na khua a kipan leh na tanaute a kipan leh na pa inn a kipan pawt inla, k’on etsak ding gam ah pai in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Chi thupi mahmah in k’on bawl dia, vual ka honzawl dia, na min ka hih thupi ding. Nang vualzawlna na hi ding.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nang hon vualzawlte ka vualzawl dia, hon hamsiat peuhmah ka hamsiat ding. Nang ah lei a namchih vualzawl in a om ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa’n a kiang a, a gen bang in Abram a kuankheta a; Lot in a zui hi. Abram, Haran khua a kipan a pawtlai in kum sawmsagih leh nga a upa ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abram in a zi Sarai leh a naupa tapa Lot leh, a thil kaihkhawm tengteng uh leh Haran khua a, a mi neih tengteng uh a pi a; Kanan gam a teng ding in a pawtta ua; Kanan gam a tungta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram huai gam a Sekem mun pha in, Moreh tosaw tan in, a pai zel hi. Huailai in, Kanante huai gam ah a teng uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa Abram kiang ah a kilak a, “Hiai gam na suante kiang ah ka pe ding” a chi hi. Huai ah a kiang a kilak Toupa ading in maitam a dohta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai a kipan Bethel suahlam a tang ah a kisuan a, huai ah a puanin a kaita hi. A tumlam ah Bethel a om a, a suahlam ah Ai khua a om hi. Huai ah Toupa ading in maitam a doh nawn a, Toupa min a lou hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abram sim gam lam zuan in a kisuan lai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai gam ah kial a keta a; huai gam a nak kial mahmah ziak in, Abram Aigupta gam a omtadih ding in a paisukta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichi ahi a, Aigupta gam lut dia a kisaklai un, a zi Sarai kiang ah, “Ngai in, numei melhoih tak na hi, chih ka thei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in hichi ahi ding a, Aiguptate’n nang a honmuh chiang un, hiai a zi ahi, a chiding ua; kei a honthat ding ua, nang a honhawi ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang ziak a hoihtak a ka om theihna ding in leh nang vanga ka hin theihna ding in, a sanggamnu ka hi, hehpih in chi zel in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichi ahi a, Aigupta a Abram a lut leh, Aiguptate’n numei a mu ua, a melhoih a sa mahmah uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharo miliante’n leng a mu ua, Pharo kiang ah a hoih dan a gen uh. Huchi in, numei Pharo inn ah a pi lutta uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman Sarai ziak in Abram hoihtak in a hih a; belamte, bawngte, sabengtungpate, sikhapate, sikhanute, sabengtungnute leh sangawngsaute a neih lohta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toupa’n Abram zi Sarai ziak in Pharo leh a inkuante tung ah hipi khawktak a tung sak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pharo in Abram a sam a, “Ka tung a na thilhih bangchidan a mai a? Na zi ahi chih bangdia honhilh lou na hia? Ka sanggamnu ahi, bangdia chi na hia?
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaiziak a kei maw, ka zi dia ka na neih hial, huaiziak in, tu’n en in, na zi, pi inla, paimang in,” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pharo in a tungthu ah mi kiang ah thu a pia a, amah a va khat a ua, a zi toh, a neih tengteng toh.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram Aigupta gam a kipan a pawt a, simlam ah a pai tou hi; a kiang ah a zi, a neih tengteng leh Lot leng a paitou hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abram gante, dangkate leh dangkaengte in a hausa mahmah hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Simlam a kipan Bethel tan a pai zel a, Bethel leh Ai khua kikal a tung hi, a tung a a puanin a omna mun ah.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tung a, maitam a dohna mah ah Abram in Toupa min a lou hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lot, Abram kiang a pai sam in, belamhonte, bawnghonte leh puaninte a nei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A omkhawmna ding un gam a kichingta kei a; a van neih uh a tam mahmah hi. A omkhawm thei nawn kei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abram ganpute leh Lot ganpute kikal ah kiselna a hong pawtta a; huailai in Kanante leh Perizte huai gam ah a teng uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abram in Lot kiang ah, “Hehpih in, nang leh kei kikal ah, na ganpute leh ka ganpute kikal ah leng kiselna omkei hen; unau i hi uhi,” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Gam pumpi na ma ah a om ka hia? Hehpih in ka kiang a kipan tuam om mai in. Nang veilam a na pai leh, kei taklam ah ka pai ding. Ahihkeileh, nang taklam a na pai leh, kei veilam ah ka pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lot a dak a, Zoar kholam zuan in, Jordan phaizang tengteng, Toupa huan bang ahihkeileh Aigupta gam bang in, gamchih a tui tampi omna ahi, chih a thei a, Toupa’n Sodom leh Gomorrah khua a hihsiat ma lah ahi ngal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Lot in Jordan phaizang tengteng a telta hi. Lot suahlam ah a kisuan a; a kikhenta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abram Kanan gam ah a teng a, Lot phaizang khuate ah a teng a, Sodom khua pha in a puanin a kai hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sodom mite Pathian mitmuh in nakpitak a hoihlou leh khial in a om uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kiang a kipan Lot a om tuam nung in, Toupa’n Abram kiang ah, “Dak inla, na omna a kipan mallam, simlam, suahlam leh tumlam en in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na gam muh tengteng na kiang ah leh na suante kiang ah tangtawn a ding in k’on pe ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na suante lei a leivui bang in ka bawl ding. Mi’n lei a leivui a sim seng uh leh, na suante leng sim seng ahi ding uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thou inla, gam dung leh vai palsuak in; na kiang a honpe ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abram in a puanin a suan a, Hebron a om Mamre tawsaw kiang ah a tengta a, huai ah Toupa ading in maitam a doh hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Sinar khaw kumpipa Amraphel, Ellasar khaw kumpipa Ariok, Elam khaw kumpipa Kedorla-omer, Goiim khaw kumpipa Tidal damlai in hichi ahi a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Amau Sodom khaw kumpipa Bera a sim uh. Gomorrah khaw kumpipa Birsa, Admah khaw kumpipa Sinab, Zeboiim khaw kumpipa Semeber, Bela khaw kumpipa leng a sim uhi, huai Zoar ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai tengteng Siddim guam ah a pang uh, huai guam Chi Tuipi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kum sawmlehnih sung Kedorla-omer nuai ah a na om ua, a kum sawm leh thumna in a helta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A kum sawmlehlina ah Kedorla-omer leh a kiang a kumpipa omte a hong ua, Asteroth-karnaim khua ah Rephaimte a that ua, Ham khua ah Zuzimte a that ua, Kariathaim phaizang ah Emimte a that uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A omna Seir tang ah Elparan pha in, Horte a that uhi, Elparan gamdai zul a om ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A kiknawn ua, Enmishpat a tung ua, huai Kadesh ahita, Amalekte gam a mi teng leh Amorte, Hazezon tamar khua a tengte leng a that nawn uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sodom khaw kumpipa, Gomorrah khaw kumpipa, Admah khaw kumpipa, Zeboiim khaw kumpipa leh Bela khaw kumpipa a pawt ua, Bela khua Zoar khua ahita, Siddim guam ah amau sual ding in a pangta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Elam khaw kumpipa Kedorla-omer, Goiim khaw kumpipa Tidal, Shinar khaw kumpipa Amraphel te, Ellasar khaw kumpipa Ariok sual ding in, Kumpipa li in kumpipa nga a sual uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siddim guam longnai khuk in a dim a; Sodom leh Gomorrah khaw kumpipate a taikek ua, huai ah a kia ua, a keloute tang ah a tai touta uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sodom leh Gomorrah mite sum tengteng leh a nekding tengteng uh a la ua, a paita uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lot, Abram unau tapa, Sodom khua a om, a neih teng toh a la ua, a paita uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi khat hong taikhia a hongpai a, Hebru mi Abram a hilh a; amah Amormi Mamre tawsaw kiang ah a teng hi. Mamre Eskol unau leh Aner unau ahi a; huai mite Abram toh pangkhawm ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abram in unaupa sal in a pi uh, chih a zaktak in, a inn a piang, aman a chilsiamsa mi za thum leh sawmlehgiat a pikhia a, Dan khua pha in a delhta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zan in amau sual ding in amah leh a sikhate a ki hawmzak ua, a that ua Hobah pha in a delh uhi. Hobah bel Damaska mallam ah a om hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil tengteng a honla kiknawn vek a, a unaupa Lot leh a neih tengteng a honla kiknawn vek a, numeite leng a hon pinawn a, midang tengteng toh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kedorla-omer leh a kiang a om kumpipate that khin, a paikik in Sodom kumpipa Shave guam ah, Abram dawn ding in a hohsuk hi. Shave guam kumpipa guam ahita.
  </para>
  <para style="p">
    <verse number="18" style="v" />Salem khaw kumpipa Melkizedek in tanghou leh uain a hontawi a; amah Pathian Tungnungpen siampu ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman Abram a vualzawl a; “Lei leh van neipa, Pathian Tungnungpen Abram vualzawl in om hen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na melmate na khut a hon pepa, Pathian Tungnungpen, phat in om hen” a chi hi. Abram in amah bangkim a sawm a khat a pia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sodom khaw kumpipa’n Abram kiang ah, “Mite honpia inla, thilte nang kineih in” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abram in Sodom kumpipa kiang ah, “Lei leh van neipa, Toupa , Pathian Tungnungpen lam ah ka khut ka zakta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Khauzang khat lel leng, khedap khau khat lel leng, na neih himhim ka lakei ding, huchilou in zaw, Abram, kei hauhsak sak ahi, na chikha ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Tangvalte nekmang leh ka mi paipihte tantuan kia louzaw ka lakei ding, Aner, Eskol leh Mamrete’n a tantuan uh la uhen” a chi hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thilte nung in, “Abram, lau ken, kei na phaw leh na kipahman thupitak ka hi” chi’n, Toupa thu Abram kiang ah mengmuhna in a hongtung hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abram in, “Aw, Toupa Pathian, bang n’on pedia, ta neilou a ka om na mu a, ka goukempa lah Damaska khua a Eliezer ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram mah in, “Ngai in, chi lah n’on suahsak kei a; en in, ka inn a piang ka gouluah ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngai in, huai mi na gouluah ding ahi kei. Nangmah gil a hong gah ding ngei, na gouluah ahizaw ding” chi’n, Toupa thu a kiang ah a hongtung hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah inn pua ah a pikhia a, “Vanlam en inla, aksite na sim theih leh sim him in” a chi hi. Amahmah in a kiang ah, “Na suante huchibang ahi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman Toupa a gingta a, huchi in, aman huai a diktatna in a seh sakta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A kiang ah, “Hiai gam na luah ding a honpe dia Kaldaite khua Ur a kipan hon pikhia Toupa ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman “ Toupa Pathian aw, ka luah ding, chih bangchi’n ka thei dia?” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman, a kiang ah, “Bawngla kum thum a upa, kelpi kum thum a upa, vakhu leh vapal nou honla in” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai teng a honla a, a laitak ah a phelkhap chiat a, a phel khat, a phel khatlam doh in a koih chiat a; vasate bel a phelkhap kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sasialne vasate saluangte tung a a tuk chiang un Abram in a hawlkhe zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nitum dia a kisak sialsial lai in, Abram a ihmu hithit hi. Ngai in, a mial a mial, thil mulkimhuai petmah in amah a honkhuh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai thilte nung in Pathian in Abram kiang ah, “Na suante amau gam hilou ah mikhual in a om ding ua, a na uh a sepsak ding uh, chih teltak in thei in. Kum za li sung hih gentheih in a om ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A nna uh a sepsak nam uh ka vaihawm khum ding. Huaikhit chiang in thil tampi nei in a hong paikhe ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang na pipute kiang ah lungmuangtakin na pai ding a; na lu a kelsam pouvek in a honvui ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh, suan lina ah hiai ah a hongpai nawn ding uh. Amorte khelhnate lah a kim nai ngalkei a” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichi ahi a, nitum a, khua a hong mial in, ngai in, halzulna meikhu lunglung leh meisel kuang luahluah huai sa kiphelkhapte kal a paipai a hongom hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai ni’n Toupa’n hiai gam, Aigupta lui a kipan lui lian, Euphrates lui, pha in, na suante kiang ah ka peta.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kente, Kenizte, Kadmonte,
  </para>
  <para style="p">
    <verse number="20" style="v" />Hitte, Perizte, Rephaimte,
  </para>
  <para style="p">
    <verse number="21" style="v" />Amorte, Kanante, Girgahte leh Jebuste toh leng ka pelai hi, chi in Abram toh thu a khungta hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Abram zi Sarai in ta himhim a neihsak kei hi. Sarai in Aigupta mi sikhanu khat a nei a, a min Hagar ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sarai in Abram kiang ah, “Ngai dih ve, Toupa’n lah ta ka neih hon phallou a; hehpih in ka sikhanu luppih in. Amah apan tate ka neih khak leh” a chi hi. Abram in Sarai thu a zuita hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram zi Sarai in Abram Kanan gam a kum sawm a om nung in, a sikhanu Aigupta mi a pi a, a pasal Abram kiang ah a zi ding in a pia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hagar a luppih a; a gaita hi. A gai chih a kitheihtak in, a pi a simmawh maimah hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sarai in Abram kiang ah, “Ka thil thuak mawh nang pua in. Ka sikhanu na kawi ding in k’on pia a; a gai chih a kitheihtak in, a hon simmawh maimah hi. Toupa’n nang leh kei kikal ngaihtuah hen” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abram in Sarai kiang ah, “Ngai in, na sikhanu na khut a om ahi, nang pha na saksak a tung ah hih in,” a chi hi. Sarai in a hih gentheih mahmah tak in a taimangsanta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa angel in gamdai a tuikhuk kiang a, Sur zotna lampi a tuikhuk kiang ah a na mu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A kiang ah, “Hagar, Sarai sikhanu aw, koi apan hongpai na hia, koi a hoh dia kisa na hia?” a chi hi. Aman, “Ka pi Sarai kiang a kipan taimang ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa angel in, a kiang ah, “Na pi kiang ah kiknawn inla, a thuthu in om in” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa angel in, a kiang ah, “Na suante simsenglouh khop hial a tam in ka pungsak ding” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa angel mah in, a kiang ah, “Ngai in, nau na paita, tapa na nei ding a; Toupa’n na gimthuakna a zak ziak in a min Ishmael na sak ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah gam sabiltung bang ahi ding a; michih a dou ding a, michih in leng amah a dou ding uh. A unaute a kipan a tuamten ding” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hagar in amah houpih Toupa min, “Nang muthei Pathian na hi” chih a sa hi. “Pathian mu a, hinglai ka hi maw?” a chi ngal a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaiziak in huai tuikhuk Beer-lahai-roi sak ahita. Ngai in, Kadesh leh Bered khaw kikal ah a om hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hagar in Abram tapa a neihsak a; Abram in a tapa, Hagar in a neihsak min Ishmael a sata hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hagar in Abram adia Ishmael a neihsak lai in Abram kum sawmgiat leh guk a upa ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abram kum sawmkua leh kua a upa a hih in, Toupa Abram kiang ah a hong kilak a, a kiang ah, “Kei Pathian bangkim hihthei ka hi; ka ma ah om inla, hoihkim in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nang toh kikal ah thu ka khung dia, nakpitak in k’on pungsak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abram a khupboh a; Pathian in amah a houpih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngai in, ken zaw, ka thukhun na kiang ah ahi, ka khun, chi tampite Pa na hita ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na min leng Abram ahi nawnta kei dia, na min Abraham ahi zawta ding; chi tampite Pa dia k’on bawltak ziak in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nakpitak in k’on chipha sak ding a, nang ah chichihte ka bawl ding a, nang a kipan kumpipate a hong omkhe ding uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kei leh nang leh na suante, suan sawnsawnte tan in leng ka thukhun nang ading leh nanung a na suante ading a, a Pathian uh hi ding in, tangtawn thukhun ding in ka hihkip ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na kiang ah leh nanung a na suante kiang ah mikhual na hihna gam, Kanan gam tengteng, tangtawn gou ding un k’on pe ding, Kei, a Pathian uh ka hi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian mah in Abraham kiang ah, “Nang ka thukhun na zui ding ahi. Na nung a na suante suan sawnsawnte tan in leng a zui ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiai kei leh nang leh na suante kal a ka thukhun na zuih ding uh ahi. Na lak ua pasal peuhmah zeksum ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na zekvun sa uh zeksum in na om ding uhi. Huai nang toh i kal a thukhun chiamtehna ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na lak ua kuapeuh ni giat a upa, na suan sawnsawn tan un leng, na suan hi chitchiat lou leng na inn a piang hiam, mikhual kuapeuh a kipan dangka sum a na lei hiam leng, pasal peuhmah zeksum ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na inn a piang leh na dangka sum a na leite leng zeksum ngeingei ding ahi. Ka thukhun tangtawn thukhun ding in na sa ah a omta ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pasal zeksumlouh leh a zekvun sa a zeksum a omlou, a chipihte lak a kipan satkhiat ahi ding; aman ka thukhun hihsia ahi” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pathian mah in, Abraham kiang ah, “Na zi Sarai, a min Sarai na chi nawnta kei dia, a min Sarah ahi zawta ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah ka vualzawl ding a, huai lou leng amah ah tapa k’on pe ding. Ahi, amah ka vualzawl ding a, Namte Nu ahita ding. Nam tuamtuam kumpipate amah a kipan a hongom ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham a khupboh a, a nuia, a lungsim in mi kum za a upa in ta a neiding maw? Sarah kum sawmkua a upain ta a neiding maw? a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham mah in, Pathian kiang ah, Ishmael na ma ah omthei leh aw, a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian in, “Hilou e, na zi Sarah in tapa a hon neihsak taktak ding; a min Isak na sak ding ahi. Ka thukhun, a nung a, a suante ading in tangtawn thukhun ding in a kiang ah ka hihkip ding.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ishmael tungthu leng k’on ngaihkhiak sak hi. Ngai in, amah ka vualzawlta a, chi tampi ka suangsak ding hi. Nakpitak in leng ka pungsak ding a, aman kumpipa sawmlehnih a suang ding a, amah chi thupitak in ka bawl ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh ka thukhun, Sarah in nikum hichi hun a a hon neihsak ding Isak kiang ah ahi ka hihkip ding” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A kiang a thugen a tawp a, Pathian in Abraham a paitouh santa hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abraham in a tapa Ishmael leh a inn a piang tengteng leh dangka sum a, a lei tengteng, Abraham inkuante lak a pasal peuhmah, a pi a, Pathian in a kiang a a gen bang in, huai ni mah in a zekvun uh a sumsakta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham zekvun a sumlai in kum sawmkua leh kua a upa ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A tapa Ishmael a zek vun a sum lai un kum sawmlehthum a upa ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai ni mah in Abraham leh a tapa Ishmael zeksum ahita uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A inkuanpihte lak a pasal tengteng, a inn a piangte leh mikhual a kipan dangka sum a a leite leng, amah toh zeksum ahi vekta uhi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Abraham sun nisat laitak a puanin kongkhak bul a, a tutlai in, Mamre tawsaw kiang ah Toupa a hong kilak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham a dak a, a en a, ngai in, a kiang ah mi thum a na ding uhi. A muh tak in puanin kongkhak a kipan amau mu ding in a vatai a, leilam ah a kunsuk hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ka Toupa , n’on deihsak theih leh hehpih in na sikha hon kheng mahmah ken.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tui tawmchik bek honla uhenla, na khete uh sil unla, sing nuai ah khawl tadih un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tanghou tawmchik bek ka vala dia, na lungtang uh halhsak un. Huaikhit chiang in pai zel nani uteh. Huai ding a na sikha kiang a hongpai na hi peuhmah ding uh” a chi hi. Amau, “Na chih bang in va hih in” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham Sarah kiang ah puanin sung ah a lutpah a, “Tangbuang nel mahmah tehna thum bawl inla, mek inla, tanghou pei in bawl in” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abraham bawnghon lam ah a tai a, bawngnou hoihtak a honla a, sikha kiang ah a pia a, aman a bawl mengmeng hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nawituidat, nawitui leh bawngnou sa kibawl a la a, a ma uah a va luita hi. Sing nuai ah a kiang uah ading nilouh a, amau a neta uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau a kiang ah, “Na zi Sarah koi a om ahia?” a chi ua, “Aman pam a puanin ah” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amau, “Hun a hong chin nawn peuhpeuh chiang in na kiang ah ka hong nawn ngeingei ding uh. Ngai in, na zi Sarah in tapa a nei ding” a chi hi. A nung a puanin kongkhak bul a kipan Sarah in a naza hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham leh Sarah upapi, tektak ahita ua; numei dan ngeina Sarah ah a kamkhin thamta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sarah in tektak ka hihnung in kipahna ka nei diam maw, ka toupa lah a upata ngal a? chi’n, a lungsim in a nui hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa’n Abraham kiang ah, “Bang a chia Sarah in, kei pitek in ta ka nei tel diam maw, chia nui ahia?
  </para>
  <para style="p">
    <verse number="14" style="v" />Toupa ading in thil himhim haksa lua a om ahia? Hun seh a hongtun chiang in, na kiang ah ka hong nawn dia, Sarah in tapa a nei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sarah in, “Ka nui kei” chi’n a nial a, a lauh ziak in. Aman, “Zuau ahi; na nuitawk ve” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mite huai a kipan ading ua, Sodom kholam a en ua, Abraham amau kha ding in a kiang uah a pai hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toupa’n , “Ka thilhih ding Abraham ka im diam aw;
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham lah chi thupi leh thilhihtheitak a hong hingei dia, amah ah khovel a chichih vualzawl a om ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa lampi a zuih theihna ding un, a nung a a tate leh a inkuanpihte dik hih ding leh vaihawm ding thu a piak theihna ding in amah ka septa hi; huchi a a tungthu genpa Toupa’n Abraham tung a a tunsak theihna ding in,” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toupa’n , “Sodom leh Gomorrah kalh a kikou ging a thupi a, a gitlouh mahmah ziak un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuin ka hohsuk dia, a kikou ging uh ka kiang a hongtung bangbang in a hih uhia, hihlou, ka en dia, ahihkei uleh ka thei mai ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mite huai a kipan a kihei ua, Sodom kholam a zuanta uhi. Abraham bel Toupa ma ah ading lai hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Abraham in a vanaih a, “Mi diktatte, mikhialte lak a hihmang khawm tel ding na hi maw?
  </para>
  <para style="p">
    <verse number="24" style="v" />Khosung ah mi diktat sawmnga bek a om kha ding uh. Asung a mi diktat sawmnga omte ziak in a khua hawilou in na hihmang ding maw?
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang tel in huchibang in, mi diktatte migiloute bang a, a om samna ding ua mi diktatte migiloute lak a hihlup zaw na hih tel kei ding hi. Lei tengteng Vaihawmpa in diktattakin ahihkei dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa’n , “Sodom khua a mi diktat sawmnga ka muh leh amau ziak in khaw pumpi ka hawi ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham in, “Ngai in, kei leivui leh meivu lel in Toupa k’on houpih thei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi diktat nga in sawmnga ching zoulou ahi kha ding a; nga a chinlouh ziak in khaw pumpi na hihmang ding maw? chi’n a dawng hi. Aman sawmli leh nga ka muh leh ka hihmang kei ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman Amah a houpih zel a, “Huai ah sawmli kia na mu ahi kha dia,” a chi hi. Aman, “Sawmli ziak in leng ka hihmang dahmai ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman, “ Toupa aw, heh ken, k’on gennawn ding. Huai ah sawmthum lel na mu ahi kha ding,” a chi hi. Aman, “Huai a sawmthum leng ka muh leh ka hihmang kei ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman, “Ngai in, Toupa k’on houpih theita a, huai ah sawmnih kia na mu ahi kha ding, a chi hi. Aman sawmnih ziak in leng ka hihmang kei ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman, “ Toupa aw, heh ken, khatvei kia k’on gen lai ding. Huai ah sawm kia na mu ahi kha ding,” a chi hi. Aman, “Sawm ziak in leng ka hihmang kei ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham toh a kihou khit un Toupa a paita a; Abraham a mun ah a kiknawnta hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, angel nih, nitaklam in Sodom khua a phasuk ua; Lot Sodom khaw kulh kongkhak ah a na tu hi. Lot in amau a na mu a, va mu ding in ading a, a mai lei ah a kunsak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ngai un, ka toupate aw, hehpih in na sikha inn ah honglut phot unla, giak unla, na khete uh sil un. Na thoubaih ding ua, na pai nawn na ding uh” a chi hi. Himahleh amau, “Hilou e, kholak ah ka giak zaw ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh aman nakpitak in a kun a; a kiang ah a pi a, a inn ah a lutta uh. Aman meh a bawl a, tanghou silngou sohlouh a kang a, a neta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A lup ma un khomite, Sodom khomite, veng teng a mi tengteng, a tek a khang in a inn a umkim velta uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lot kiang ah, “Tu zan a na in a honglut mite koi a om uh ahia? Amau ka luppih theihna ding un ka kiang uah hon pikhia in” a hong chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lot kongkhak bul ah a kiang uah a vapawt a, kongkhak a khak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ka unaute aw, hehpih in, hichitelin gilou dah un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai un, pasal luppih ngei nailou tanu nih ka nei hi. Hon hehpih unla, amau na kiang uah k’on pikhe dia, hoih na sak bang un, a tung uah na hih na ding uh. Hiai mite tung ah zaw bangmah hih mahmah kei un. Hiai ding a ka inn sung a honglut lah ahi ngal ua” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau, “Hon hon mai in” a chi uhi. Amau mah in, “Hiai mi soplai hiai a teng ding in a hong pem lut a, vaihawmpa a om a tup vial. Tu’n amau tung a hihsang in nang tung ah ka hihse zawsem ding uh” a chi uh. Lot a bohta ua, kongkhak hihse ding in a honnaih uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh mite’n a khut uh a golhkhia ua, Lot a kiang uah inn sung ah a kailut ua, kongkhak a khak bikbek uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kongkhak bul a mite, a lian a neu in a mit uh a tawsak ua, Huchi in kongkhak a muzou takei uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mite’n, Lot kiang ah, “Hiai mite lou hiai ah inkuanpih dang na nei hia? Na makpapate, na tapate, na tanute leh khaw sung a na neih peuhmahte khua a kipan pikhia in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa ma a, a kikou husa uh a thupi luattak ziak in hiai khua hihmang ding ka hi uh. Hihmang ding in Toupa’n a honsawl hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lot a paikhia a, a tanute kitenpih, a makpate kiang ah a vagen hi. “Thou unla, hiai khua a kipan pawtkhia un, Toupa’n khua hihmang ding ahi” a chi hi. Himahleh a makpate ngaih in chiamnuih thu gen banglel ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Phalvak in, angelte’n, “Thou inla, na zi leh hiai a na tanu nih omte pi in. Huchilou in zaw hiai khua gawtna ah na mang tel kha ding uh” chi’n, Lot a nohta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh a awltat mahmah lai a, Toupa’n amah a hehpih ziak in mite’n a khut leh a zi khut leh a tanu nihte khut a len ua, a pikhia ua, khaw pawlam ah a koihta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichi ahi a, pawlam a, a pikhiak khit un, “Na hinna ding in taikhia in; na nunglam nga kenla, Phaizang himhim ah leng khawl ken. Huai tangsang ah suahtak san in, huchilou in zaw na mangkhawm kha ding hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh Lot in a kiang uah, “Ka Toupa , huaizaw hi kei hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai in, na sikha in na hehpihna a mu a, nang na chitna na liansak a, huai chitna, ka hinna humbit in ka tung ah na langsak hi. Huai tangsang ah zaw ka tai theikei ding, thil hoihlou khat in honpha in ka si kha ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai in, huai khua taina ding in a naipen a, khaw neuchik leng ahi. Aw, huai ah, khaw neuchik ahi ka hia! hon taisak zaw in, Huchi in ka hing ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman, a kiang ah, “Ngai in, hiai thil tungtang ah leng k’on mang hi, na khaw gen ka hihmang dah ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kin inla, huai ah tai in. Huai mun na tun mateng lah bangmah ka hihthei ngalkei hi” a chi hi. Huaiziak in, huai khaw min Zoar chih in a omta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Lot Zoar khua a tun in leitung ah ni a hongsuak khinta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toupa’n Sodom leh Gomorrah khaw tung ah van a Toupa kiang a kipan mei leh kat a zusak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huai khuate, Phaizang tengteng, khua a mite tengteng leh leitung a thil poute tengteng a hihmang vekta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh Lot zi in nunglam a enkik a chikhuam a suakta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham beltak in Toupa ma a, a dinna mun ah a hohtou hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sodom leh Gomorrah kholam leh phaizang gam tengteng lam a en hi. Ngai in, huai gam a meikhu, halzulna meikhu bang mai in a khu tou ngoingoi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichi ahi a, Pathian in phaizang khuate a hihmanlai in Pathian in Abraham a theigige a, Lot manthatna lak a kipan a sawlkhia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zoar khua a kipan Lot a paitou a, tang ah a teng a, a tanu nihte leng a kiang ah a teng uhi; Zoar khua ah lah a teng ngam kei a, amah leh a tanu nihte kawhawm ah a tengta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in a tanu upa zaw in a nauzaw kiang ah, “I pa a upata a, khovel tengteng dan bang a hon luppih ding lei ah pasal khat leng a om nawn kei hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kisa in, i pa uain i dawnsak dia, Huchi in i pa chisuan beilou a i bawl theihna ding in a kiang ah i lum ding” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai zan in a pa uh uain a dawnsakta uh. A upa zaw a lut a, a pa kiang ah a va lum a; aman a luplam a na phawkkei a, a thohlam leng a phawk kei hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hichi ahi a, a zing in a upa zaw in a naupang zaw kiang ah, “Ngai in, zan in ka pa kiang ah ka lum a; tu zan in leng uain i dawnsak nawn dia; nang va lut inla, i pa chisuan beilou a, i bawl theihna ding in a kiang ah valum sam in” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai zan in leng a pa uh uain a dawnsak nawn ua; a naupang zaw a thou a, a kiang ah a valumta hi. Aman a luplam a phawk kei a, a thohlam leng a phawk kei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchibang in Lot tanu nihte’n a pa ua pan nau a paituak uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A upa zaw in tapa a nei a, a min Moab a sa a, huai mi tulai a Moabte suangpa ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A naupang zaw in leng tapa a nei a, a min Ben Ammi a sa a, huai mi tulai a Ammonte suangpa ahi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham huai a kipan simlam zuan in a kisuan a, Kadesh leh Shur khaw kikal ah a teng a, Gerar ah hun bang tan hiam a tam hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham in a zi Sarah, “Ka sanggamnu ahi” a chi hi. Gerar kumpipa Abimelek in mi a sawl a, Sarah a va pisakta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh, Pathian in zan a, a mang in Abimelek kiang ah a hongpai a, a kiang ah, “Ngai in, na numei pi ziak in misi leltak na hita, mi zi ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abimelek in a luppih nai tadih kei hi. Toupa , nam diktat leng na that dia hia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Amahmah in, ka kiang ah, “Ka sanggamnu ahi,” a chi hi? Amah ngei in leng, ka sanggampa ahi, a chi behlap ngal a. Lungtang hoih tak pu leh khut siangthou tak neikawm in hiai ka hih ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in a mang in, “Ahi, hiai lungtang hoih tak pukawm a na hih ahi, chih ka thei a, ken leng ka tung a na khelh ding k’on kham hi. Huaiziak in, amah na khoih ka phallouh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tuin huai mi zi pekik in; amah lah zawlnei ahi ngal a. A hon thumsak dia, na dam ding. Na piak kik keileh, na si ngeingei ding, chih thei in, nang leh na neih tengteng toh” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abimelek beltak in a thou a, a sikha tengteng a sam a, a bil uah huai thu tengteng a hilh a, mite’n a lau mahmah uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abimelek in Abraham a sam a, a kiang ah, “Ka tung ua na thilhih bangchidan ahia oi? Bang lam ah ahia na tung a ka khelh a, kei leh ka khua leh tuite tung a thil gilou thupitak n’on tut? Thilhih tuak louh tak ka tung ah na hihta” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abimelek mah in Abraham kiang ah, “Bang na mu a, hichibang a thilhih na maizen a?” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abraham in, “Hiai khua ah Pathian lauhna a om hetkei ngei ding a, ka zi ziak in a honthat mai ding uh, chih ka ngaihtuah ziak ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huailou in ka sanggamnu leng ahi him a, ka pa tanu ahi a, ka nu tanu bel ahi kei. Himahleh ka zi a hong hita hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichi ahi a, Pathian in ka pa inn a kipan a hon vakvaih sak lai in, a kiang ah, ‘Hiai na hehpihna ka tung a na latsak ding ahi. Ka tunna peuh uah, ka sanggampa ahi honchi zel in’ ka chi him ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abimelek in belamte, bawngtalte, sikhapate leh sikhanute a pi a, Abraham kiang ah a pia a, a zi Sarah leng a pekikta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Abimelek in, En in, ka gam a za akei hiam, na utna peuh ah tengin, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sarah kiang ah, “En in, na sanggampa dangka sang khat ka peta hi. Ngai in, na kiang a om tengteng leh nangmah ading in amah na mit khuhna ahi ding. Hiai bang in amah taihilh in a om hi.”
  </para>
  <para style="p">
    <verse number="17" style="v" />Abraham Pathian kiang ah a thum a, Pathian in Abimelek leh a zi leh a sikhanute a damsak nawn a, huchi in ta a neita hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Abraham zi Sarah ziak in Toupa’n Abimelek inkuante tengteng a chingsak vek hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n a gensa bang in Sarah a veh a, Toupa’n a gensa bang in Sarah ading in a semta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sarah a gai a, Pathian in a kiang a, a gen hunseh in a tek nung in Abraham tapa a neihsakta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham in Sarah in a neihsak a tapa min Isak a sa hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abraham in Pathian in a kiang a thu a piak bang in a tapa Isak ni giat a chin in a zek a sumsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A tapa Isak a pian lai in Abraham kum za khat a upa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sarah in, “Pathian in hon nuisakta; a za michih in a hon nuihpih ding uh,” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amahmah in, “Sarah in naungekte a pom ding, chih kuan ahia Abraham kiang a gen thei ding? A tek nung in tapa ka neihsakta” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Naungek a hong khangliana, nawinek a tawpsakta uh. Isak nawinek a tawpsak ni un, Abraham in Ankuang thupitak a luita hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aigupta mi Hagar tapa, Abraham adia a neihsak pen in Isak a nuihsan lai Sarah in a mu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huaiziak in, Abraham kiang ah, “Hiai sikhanu leh a tapa delhkhia in. Hiai sikhanu tapa in ka tapa Isak gou a luahpih ahi theikei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiai thu a tapa mah toh kisai a hih ziak in Abraham ngaih in thil hoihlou tak ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh Pathian in Abraham kiang ah, “Naupang tungtang thu leh na sikhanu tungtang thu na ngaih in thil hoihlou hi kei hen. Sarah in na kiang a thu a gen tengteng zui in, Isak ah na suante a chi ding uh, chih ahi ngal a,
  </para>
  <para style="p">
    <verse number="13" style="v" />Sikhanu tapa ah leng, na suan a hih ziak in, chichih tham ngial ka bawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abraham beltak in a thou a, tanghou leh tuithawl, tui a dim a la a, Hagar kiang a pia in, a liangkou ah a suan hi, huan naupang mah leng, a paisakta hi. A pai a, Beer–sheba gamdai ah a vak vakta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuithawl a tui a hong omta kei a, naupang singlim nuai khat ah a koihta mai hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Naupang si ding ka en ngamkei” a chih ziak in gamla kuam ah, thal kap phakna ding ah, a vapai a, a mazawn a tu in ngaihtak in a kapta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in naupang aw a za a; Pathian angel in van a kipan Hagar a sam a, a kiang ah, “Bangchi na hia Hagar? Lau ken, a omna a naupang aw Pathian in a za hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thou inla, naupang phong inla, na khut in len in, amah chi thupitak a bawl ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian in a mit a hih vaksak a, tuileh a muta hi. Huai ah a vapai a, tuithawl dim in tui a dim a, naupang a dawnsakta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Naupang kiang ah Pathian a om a, a hong khangliana; gamdai ah a teng zel a, thalkapmi a hong hita hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Paran gamdai ah a teng a; a nu’n Aigupta gam a kipan zi a guan hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichi ahi a, huailai in Abimelek leh a sepaih pawl heutu Phikol in Abraham kiang ah, “Na thilhih peuh ah Pathian na kiang ah a om.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tuin hiai ah Pathian min lou inla, kei leh ka tapa leh ka tapa’ tapa leng khemlou in, k’on hehpih khittaksa bang in kei leh na tenna gam hehpih thuksam ding in ka kiang ah kichiam in” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Abraham in, “Ka kichiam ding” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Abimelek sikhate’n tuileh a suhsak ziak in Abraham in Abimelek a sal hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Abimelek in, “Hiai thilhih pen kua ahia, ka thei himhim kei. Nang lah n’on hilh ngalkei a, tuni ngallou in ka za nai himhim kei” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Abraham in belamte leh bawngtalte a pi a, Abimelek kiang ah a pia a; a nih un thu a khungta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham in a belamhon lak a belamnou a nu sagih a koih tuam hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abimelek in Abraham kiang ah, “Belamnou a nu sagih a tuam a na koih bang a chia ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman, “Hiai tuileh kei leh ahi, chih n’on theihpihna ding in hiai belamnou a nu sagih ka khut a kipan na lak ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in huai mun Beer–sheba a sa a; huai a a nih ua a kichiam ziak un.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beer–sheba ah thu a khungta uhi. Abimelek a thou a, a sepaih pawl heutu Philok toh, Philistiate gam ah a pai nawnta uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham in, Beer–sheba ah meilah sing a suan a, huai ah Toupa tangtawn Pathian min a lou hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abraham Philistiate gam ah sawtpi a tam hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thilte nung in Pathian in Abraham a ze-et hi. A kiang ah, “Abraham” a chi a; aman, “Hiai ah ka om” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman, “Na tapa, na tapa neihsun, na ittak, Isak pi inla, Moriah gam ah pai inla, k’on hilh ding tang khat ah haltum thillat in lan in” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham beltak in a thou a, sabiltung a bawl a, a kiang ah a tapa Isak toh sikha tangval nih a pi hi. Haltum thillat ading in sing a eka, a thou a, Pathian in a hilhna mun lam ah a paita hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A ni thum ni’n Abraham a dak a, amun gamlapi hilai in a mu hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham in a sikha tangvalte kiang ah, “Hiai ah sabiltung toh a na om un. Kei leh naupang huai pam ah ka va hoh ding ua; Pathian ka va be ding ua; na kiang uah ka hong kiknawn ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham in haltum thillatna ding sing a la a, a tapa Isak a pawsak hi. Aman mei leh temta a tawi a; a nih un a paikhawmta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Isak in a pa Abraham a houpih a, “Pa” a chi a, aman, “Bawi, hiai ah ka om” a chi hi. Aman “En dih, mei leh sing a om a; hileleng haltum thillat ding belamnou lah koi ah?” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham in, “Bawi, Pathian in amah ading haltum thillat ding belamnou a ngaihtuah tawm ding hi” a chi a; a nih un a paikhawm zel uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in a hilhna mun a va tungta ua, Abraham in huai ah maitam a doh a, sing a chiangkhawm a, a tapa Isak a hen a, maitam a sing tung ah a lumsak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abraham in a khut a lik a, a tapa thahna ding temta a la hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa angel in van a kipan amah a sam a, “Abraham, Abraham” a chi a, aman, “Hiai ah ka om” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman, “Naupang tung ah na khut kha ken. Amah bangmah loh ken. Na tapa, na neihsun mahmah leng kei adia na it louh ziak in Pathian na lau, chih tuin ka theita” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham a dak a, a en a, ngai in, a nunglam ah belampa a ki a singbawka awk a na om hi. Abraham in huai belampa a va man a, a tapa sik in haltum thillat in a lan zawta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Abraham in huai mun min, “Jehovah Jire” a sa hi; tuni tan a “ Toupa tang ah ngaihtuah hina ve” a chih zel bang un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa angel in a nihveina ding in van a kipan Abraham a sam nawn hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Hiai thil na hih ziak leh na ta neihsun na it louh ziak in keimah in ka kichiam hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />K’on vualzawl ngeingei dia, van a aksite zah leh tuipi piau a piaunel zah in na suante ka pungsak ngeingei ding. Na suante’n a doute uh kulh kongkhak a nei ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka thu na man ziak in na suan ah khovel a chichih vualzawl in a om ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Abraham a sikha tangvalte kiang ah a kiknawn a, a thou ua, Beer–sheba lam manoh in a pai uh. Abraham Beer–sheba ah a teng hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichi in, huai thilte nung in, Abraham kiang ah, “Ngai in, Milkah in leng na nau Nahor tate a neih sakta ve,” chi in Abraham a hilh uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A ta masa Huz ahi a; a nau Buz ahi a, Aram pa Kemuel;
  </para>
  <para style="p">
    <verse number="22" style="v" />Chesed, Hazo, Pildash, Jidlaph leh Bethuel leng ahi uh”
  </para>
  <para style="p">
    <verse number="23" style="v" />Bethuel in tanu Rebekah a nei a; huai giatte Milkah in Abraham nau Nahor a neihsak ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A mei, a min Reumah in leng Tebah, Gaham, Thahash leh Makah a nei hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Sarah damsung kum za leh sawmnih leh sagih ahi. Hiaite Sarah damsung kumte ahi uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sarah Kanan gam a Kiriath Arba, Hebron kichi khua ah a si a Sarah tung a awm kitum ding leh kap ding in Abraham a hong hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Abraham a misi luang ma a kipan a dingtou a, Heth suante kiang ah,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Na lak uah mikhual leh khualtam lel ka hi a; ka misi luang mulou dia ka vui theihna ding in vuina mun honpia un” chi in a ngen hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Heth suante’n Abraham a dawng ua, a kiang ah,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Ka toupa, hon ngaikhia in, nang ka lak ua kumpi thupitak na hi a; ka hante uh lak a na deihna penpen ah na misi vui in. Na misi na vuina ding in ka lak uah kuamah in ka han uh honpiak ka itkei ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abraham huai gammite leh Heth suante ma ah a dingtou in a kun hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ka misi ka muhlouh dia ka vui pha nasak uleh, hon ngaikhia unla, Zohar tapa Ephron kiang ah hon ngetsak un.
  </para>
  <para style="p">
    <verse number="9" style="v" />A lou taw a om, a neih, Makpelah kawkhuk honpe ding in, na lak ua vuina mun ding aman hun a sak zahzah la henla, honpia hen” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Heth suante lak ah Ephron a teng a; Heth mi Ephron in Heth suante theih in, a khaw kulh kong a lut peuhmah nangawn theih in.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Hilou e, ka toupa, hon ngaikhia in. Lou leh asung a om kawkhuk leng k’on pia hi. Ka chipihte tate mitmuh in ka honpia hi. Na misi vui in” chi’n, Abraham a dawng hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham huai gammite ma ah a kun hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai gammite theih in Ephron kiang ah, “Pha nasak leh hehpih in hon ngaikhia in; lou man k’on pe ding, kei a kipan la in, huai mun kia ah ka misi ka vui ding” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ephron in Abraham a dawng a, a kiang ah,
  </para>
  <para style="p">
    <verse number="15" style="v" />“Ka toupa, hon ngaikhia in. Leimun dangka sekel za li ahi a, huai zaw, nang leh kei ading in gentham ahi ahia? Na misi vui mai in” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abraham in Ephron thu a zuita a; Heth suante theih in Ephron in a genzah, dangka sekel za li, sumsinte zat zel a buk a, Ephron kiang ah a peta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ephron lou, Mamre toh kizawn Makpel gam a om, a lou toh, asung a kawkhuk om toh, lou a sing om tengteng toh, a loukim a sing om tengteng toh,
  </para>
  <para style="p">
    <verse number="18" style="v" />Heth suante mitmuh in, a khaw kulhkong a om peuhmahte muh in, gou ding in Abraham kiang ah piak kip in a omta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai nung in Abraham in a zi Sarah Kanan gam a Mamre toh kizawn, Hebron kichihna, Makpelah lou a kawkhuk ah a vuita hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Lou leh asung a kawkhuk om vuina mun ding in Abraham kiang ah Heth suante’n a pekipta uhi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Abraham hong upata in a hongtek mahmahta hi. Toupa’n Abraham thil bangkim ah a vualzawlta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham in a sikha, a inn a upapen, a neih tengteng tung a thuneipa kiang ah, “Hehpih in na khut ka pheipi nuai ah golh in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa , van Pathian leh lei Pathian lou in, ka tenna Kanan mite nungak lak a mi ka tapa zi dia neihsak lou ding in, k’on kichiam sak ding.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka gam lam a ka tanaute kiang ah hoh inla, ka tapa Isak zi na neihsak ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sikha in a kiang ah, “Numei in hiai gam lam ah honzui nuam keileh, na tapa na hongpawtna gam a pi kiknawn ding ka diam?” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Abraham in a kiang ah, “Ka tapa huai a pikik nawnlou ding in pilvang in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa van Pathian, ka pa inn a kipan leh ka pianna gam a kipan hon pikhepa leh hon houpihpa leh, hiai gam na suante kiang ah ka pe ding, chi a, ka kiang a kichiampa’n, amah ngei in a angel na ma ah a paisak dia, huai a kipan ka tapa zi na neisak ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Numei in a honzuih nopkei leh, ka kiang a na kichiamna thu ah na siang ding. Abang abang hita leh, ka tapa huai ah na pikik nawn ding ahi kei” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sikha in a khut a pu Abraham pheipi nuai ah a golh a, huai thu ah a kiang ah a kichiamta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sikha in a pu sangawngsau lak ah sangawngsau sawm a kai a, a pu thil hoih chiteng tawi in, a pawtta hi. A thou a, Mesopotamia gam a Nahor khua ah a hohta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Nitaklam a numeite tuitawi dia a kuan hunlaitakin, dainawl a tuileh kiang ah a sangawngsaute a khukdin sak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Aw Toupa , ka pu Abraham Pathian, hehpih in tuni in hon lohchingsakin, ka pu Abraham tung ah hehpihna langsak in.
  </para>
  <para style="p">
    <verse number="13" style="v" />En in, tuikhuk kiang ah ka ding a, khua a mite tanute tuitawi ding in a hong kuan uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichi hi hen, nungak kuapeuh kiang a, hehpih in ka dawn ding in na tuibel niamsak dihve, ka chih a, aman, dawn in, na sangawngsaute leng dawn ding ka pe ding, chi peuhmah, huai mi ngei na sikha Isak zi dia na mi seh hi hen. Hiai ah ka pu tung ah hehpihna na lang sak, chih ka thei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichi ahi a, a genkhit ma in, ngai in, Abraham nau Nahor zi Milkah tapa Bethuel tanu Rebekah tuibel a liangzang a pua in a hong kuan hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai nungak a mel a hoih mahmah a, nungak siangthou ahi a, pasal in a luppih ngeikei hi. Tuikhuk ah a paisuk a, a tuibel a dimsak a, a paitou nawn hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sikha amah tuak ding in a tai a, “Hehpih in na tuibel a tui tawmchik hon dawnsak ve” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman, “Dawn ve, ka toupa” a chi a; kintak in a tuibel a khut in a dom khesuk a, a dawnsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A dawn nung in, “Na sangawngsaute ading leng a dawnkham masiah uh ka tawi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kintak in a tuibel gankuang ah a tei a, tuitawi ding in tuileh lam ah a tai nawn a, a sangawngsau tengteng ading leng a tawi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sikha in a lohchingsak leh saklouh theihna ding in a daidide hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichi ahi a, sangawngsaute’n a dawnkham tak un, sikha in dangkaeng bilbah sekel kimkhat a gik leh a khut ading dangkaeng tau nih sekel sawm a gik a suah khia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kiang ah, “Kua tanu na hia? Hehpih in honhilh in. Na pa inn ah ka giahna ding uh mun a om diam?” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman, a kiang ah, “Bethuel, Milkah tapa, Nahor adia a neihsaknu tanu ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amahmah in, a kiang ah, “Buhpawl leh gan an ka hau tuak uhi, giahna mun leng ka nei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sikha in a lu a kunsak a, Toupa a bia hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Ka pu tung a a hehpihna leh a thutakna tawp tuanlou, Toupa , ka pu Abraham Pathian, phat in om hen. Keileng, Toupa’n ka pu unaute inn lam a hon na pi eive” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nungak a tai a, huai thute a nu inkuanpihte a va hilh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Rebekah in sanggam pasal a nei a, a min Laban ahi. Laban a pawt a, tuikhuk lam ah huai mi kiang ah a va taita hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichi ahi a, bilbah leh a sanggamnu khut a taute a mu a, huai mi’n, “Huchi kha chi in honchi” chi a, a sanggamnu Rebekah thugente a zaktak in, huai mi kiang ah a hohta hi. Ngai in, amah tuikhuk ah sangawngsaute kiang ah a na ding gige hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Laban in, “Nang, Toupa vualzawlpa, hong inla, ka inn uah lut in. Bangdia inn pua ading nilouh? inn leh mun sangawngsaute ading in ka bawl khinta” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan inn ah a lut a, Laban in sangawngsau van a phela; sangawngsaute ading in buhpawl leh gan an a pia a, a khe leh a lawmte khesilna ding tui a pia hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abraham sikha ma ah nekding a lui a; himahleh, aman, “Ka hong nasan thu ka gen mateng ka ne kei ding,” a chi hi. Aman, “Gen ve,” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Aman, “Abraham sikha ka hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Toupa’n ka pu nakpitak in a vualzawl a, mi liantak a hong hita. Toupa’n a kiang ah belamhon, bawnghon, dangka, dangkaeng, sikhapate, sikhanute, sangawngsaute leh sabiltungte leng a pia hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ku pu zi Sarah in tek nung in ka pu ading in tapa a nei a; amah kiang ah a neih tengteng a pe vek hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka pu in, ka tenna gam a Kanante nungak lak a ka tapa zi ding a na neihsak ding ahi kei.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ka pa inn lam ah, ka tanaute kiang ah hoh inla, ka tapa zi na neisak zaw ding ahi, chi’n, a hon kichiam sak hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ken ka pu kiang ah, Numei in honzui nuam kei kha ding,” ka chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman, ka kiang ah, “ Toupa a ma a ka om zelna in a angel na kiang ah a honsawl dia; na hohna ding ah hon lohchingsak ding. Ka tapa ading in ka tanaute leh ka pa inn kawte lak a zi na neisak ding ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Ka tanaute kiang ngei na tun chiang in, ka kiang a na kichiamna a kipan na siang ding. Nungak a honpiak kei uleh ka kiang a na kichiamna a kipan na siang ding” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Tuni in tuikhuk ka hongtung a, ‘Aw, Toupa , ka pu Abraham Pathian, ka paina a n’on lohchinsak ding leh, en in, tuikhuk kiang ah ka ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Hichi hi hen, nungak tuitawi dia hong kuan, kuapeuh kiang a, hehpih in dawn ding na tuibel a tui tawmchik honpia in, ka chih a;
  </para>
  <para style="p">
    <verse number="44" style="v" />aman ka kiang a, dawn in, na sangawngsaute ading leng ka tawi ding, chi peuhmah, huai mi ngeingei ka pu tapa adia Toupa numei seh hi hen, ka chi hi.’
  </para>
  <para style="p">
    <verse number="45" style="v" />Ka lungsim a ka gen khitma in, ngai in, Rebekah, a tuibel pua in a hong kuan a; tuikhuk ah a paisuk a; tui a tawi a; a kiang ah, ‘hehpih in tui hon dawnsak ve’ ka chi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Aman kintak in a liangzang a kipan tuibel a domkhia a, ‘dawnin, na sangawngsaute leng dawn ding ka pe ding,’ a chi hi. Ka dawn a, sangawngsaute leng a dawnsak hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Ken, ‘kua tanu na hia?’ chi’n ka dong a; aman ‘Nahor tapa, Milkah in a neih sakpa Bethuel tanu ka hi’ a chi hi. Bilbah a bil ah ka batsak a, taute leng a khut ah ka bunsak hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ka lu ka kunsak a, Toupa ka bia a, Toupa , ka pu Abraham Pathian, ka pu unaupa tanu a tapa adia a zi dia neisak dia lampi diktak a hon pipa, ka phat hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Tuin ka pu na hehpih ua, a tung a chihtak pet a na hih ding uleh honhilh un. Na hih kei ding uleh leng honhilh un. Taklam hiam, veilam hiam, ka nga thei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Laban leh Bethuel in a dawng ua, “Hiai thil Toupa a kipan pawt ahi. A sia a pha leng na kiang ah ka gen theikei uh.
  </para>
  <para style="p">
    <verse number="51" style="v" />En in, ‘Rebekah na ma ah a om hi, pi inla, pai in’ Toupa’n a gensa bang in na pu tapa zi ding in om hen” a chi uh.
  </para>
  <para style="p">
    <verse number="52" style="v" />Hichi ahi a, Abraham sikha in a thu uh a zaktak in leisi in Toupa a bia hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham sikha in dangka suang kizepnate, dangkaeng kizepnate leh silhlehten a lakhia a, Rebekah a pia a; a sanggampa leh a nu kiang ah leng thil manpha pipi a pia hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Amah leh a lawmte’n ne in a dawn ua, a giakta uh. Zingsang in a thou ua, “Ka pu kiang ah hon paisakta un,” a chi hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />A sanggampa leh a nu’n, “Nungak ni sawtlou chik, ni sawm lel bek, ka kiang uah omtadih hen. Huaikhit in a hongpai na ding,” a chi uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Aman, a kiang uah, “Hon zekaisak kei dih ua, Toupa’n lah ka hohna ah a hon lohchingsakta ngal a. Ka pu kiang a ka pai theihna ding in, honsawl zaw maive ua” a chi hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Amau, “Nungak ka sam ding ua, amah kam mahmah kihoupih leh” a chi uh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Rebekah a sam ua a kiang ah, “Hiai mipa kiang ah na pai nuam maw?” a chi uh. Aman, “Pai nuam ve ning e” a chi hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />A sanggamnu uh Rebekah leh a donnu leh Abraham sikha leh a mite a paita uhi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Rebekah a vualzawl ua, a kiang ah, “Ka sanggamnu uh aw, nang, sing ngenta sang tampite nu honghi in! Na suante’n amau hawte kulh kongkhak neihsak uhen!” a chi uhi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Rebekah a thou a, a sikhanute toh sangawngsaute tung ah a tuang ua, huai mi a zuita uhi. Abraham sikha in Rebekah a pi a, a paita uhi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Huan Beer Lahai-roi dil lam a kipan Isak a hong a, sim gam a teng ahi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Isak nitaklam in pawn ah kingaihtuah ding in a pawtkhia hi. A dak a, a en a, ngai in, sangawngsau hongpaite a mu hi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Rebekah a dak a, Isak a muhtak in sangawngsau tung a kipan a kum hi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Abraham sikha kiang ah, “Pawn a hondawn dia hongpai kua ahia?” a chi a; sikha in, “Ka pu ahi” a chi hi. A kikhuhna puan a la a, a kikhuhta hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Sikha in a thilhih tengteng Isak a hilh hi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Isak in Rebekah a nu Sarah puanin ah a pilut a, Rebekah a la a, a zi a hong hita hi. Amah a it a, a nu sihnungin Isak a hong lungmuangta hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Abraham in zi dang a nei nawn a, a min Keturah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman Zimran, Jokshan, Medan, Midian, Ishbak leh Shuah a neihsak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jokshan in tapa Sheba leh Dedan a nei a, Dedan tapate Ashurim leh Letushim leh Leummim ahi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Midian tapate Ephah, Epher, Hanok, Abidah leh Eldah ahi uh. Huai tengteng Keturah tate ahi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham in a neih tengteng Isak a pia hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A mei tapate kiang ah Abraham in thilpiakte a pia a; amah damlai ngei in a tapa Isak a kipan amaute suahlam gam ah a sawlmang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Abraham damsung kum za leh sawmsagih leh nga ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Abraham in a kha a khahta hi. Lu a kelsam pouvek in tekpi tekkun a dam in a si a, a chipihte kiang a pi in a omta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A tapa Isak leh Ishmael in Hit mi Zohar tapa Ephron lou a, Mamre phak ma a Makpel kawkhuk ah a vuita uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai lou, Abraham in Hit suante apan a leisa ahi a, huai ah Abraham leh a zi Sarah a vui uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichi ahi a, Abraham sih nung in, Pathian in a tapa Isak a vualzawl a; Isak Beer-lahai-roi ah a teng hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiaite Abraham tapa Ishmael, Sarah sikhanu, Aigupta mi Hagar in Abraham a neihsak suante ahi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiaite a min chiat uleh a suante uh bangzel in Ishmael tapate min ahi. Ishmael tapa upapen Nebajoth ahi a, huai ban ah Kedar, Adbeel leh Mibsam,
  </para>
  <para style="p">
    <verse number="14" style="v" />Misma, Dumah leh Massa,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hadar, Tema, Jetur, Naphish leh Kedemah ahi uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huaite Ishmael tapate ahi ua, huaite a khua uh bang leh a giahphual uh bangzel a a min uh gelh ahi a, a chi uh bangzel in kumpipa sawmlehnih ahi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ishmael damsung kum za leh sawmthum leh sagih ahi a; a kha a khah a, a si a, a chipihte kiang ah pi in a omta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A tapate Havilah gam a kipan Assuria gam lamsang a Aigupta gam phakma a Shur tan in a teng ua, a unau dangteng a kipan a tuamten uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiaite Abraham tapa Isak suante ahi uh: Abraham in tapa Isak a nei a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isak in Padan-aram gam a Suria mi Bethuel tanu, Suria mi Laban sanggamnu Rebekah zi a, a neihlai in kum sawmli a upa ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A zi a chiin ziak in Isak in Toupa kiang ah a zi ading in nget petmah in a ngetsak hi. Toupa’n a ngetna a ngaihkhiak sak a, a zi Rebekah a hong gaita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Asung a a nau paite a kisual uhi; aman, “Hichibang a hih ngal leh, bangziak in ahia, ka hi chih?” a chi a; Toupa dong ding in a kuanta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n a kiang ah, “Na sul ah nam nih a om uh. Na gil sung a kipan nam nih a kikhen ding ua, Nam khat nam khat sang in a hat zaw ding. A upa zaw in a naupang zaw nna a sem ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nau neih a hun in, ngai in, a sul ah phik a om hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amasa zaw a san a san seksawk, puanmul bang a mul thiapthuap a hongpawt a, a min Esau a sa uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai nung in a nau a pawt nawn a, a khut in Esau khetul a lenkip a; amah min Jakob a sa uh. Rebekah in amaute a neihlai in Isak kum sawmguk a upa ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Naupangte a hong khanglian ua; Esau sabetsiam, gamvakmi ahi a; Jakob mi mawl, puanin a teng mi ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isak in a sakhi sa a nek zel ziak in Esau a it a; Rebekah in bel Jakob a it hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jakob in be a huan a; Esau gamkuan a hongtung a, a tawl mahmah hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Esau in Jakob kiang ah, “Hehpih in na be huan hon nesakin; ka bah mahmah hi” a chi hi. Huaiziak in ahi, a min Edom a chih uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jakob in, “Na tamasa hihna hon leisak phot lechin” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Esau in, “Ngai in, si dek ka hi ngal a; hiai tamasa hihna kei ading in bang a phatuam dia?” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jakob in, “Tuni in ka kiang ah kichiam phot in” a chi hi. A kiang ah a kichiam a, a tamasa hihna Jakob kiang ah a khong maimah hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jakob in Esau tanghou leh a be huan a pia a; aman ne in a dawn a, a thou a, a paita hi. Huchibang in Esau in a tamasa hihna a ngaineu hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, huai gam ah, Abraham damlai a kial ke masapen chih louh, kial a hong kenawn a, Isak Philistiate kumpipa Abimelek kiang ah Gerar khua ah a va hohsuk hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa a kiang ah a hong kilak a, “Aigupta gam ah hohsuk ken. K’on hilh ding gam ah teng in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai gam ah omtadih inla, na kiang ah ka om dia, k’on vualzawl ding hi. Hiai gam tengteng nang kiang leh na suante kiang a pia in, na pa Abraham kiang a ka kichiamna ka hihkip ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Van a aksi zah in na suante ka pungsak dia, hiai gam tengteng na suante kiang ah ka pelai ding hi. Na suan ah khovel a nam tengteng vualzawl in a om ding uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Abraham in ka thu a mang a, ka thuhilhte, Ka thupiakte, ka thusehte leh ka dante a zuih ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Isak Gerar khua ah a teng hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai khua a mite’n a zi tungtang a dong ua; aman, “Ka sanggamnu ahi, a chi hi. A mel a hoih ziak in hiai khua a mite’n Rebekah ziak in a honthat kha ding uh” chi’n, ‘ka zi ahi’ a chi ngamkei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichi a, huai a sawtpi a om nung in, Philistiate kumpipa Abimelek in tohlet a kipan a en a, ngai in, Isak in a zi Rebekah a thohlai a muta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Abimelek in Isak a sam a, “Ngai in, na zi a hina hi. Bangdia, ka sanggamnu ahi, chi maimah na hia?” a chi hi. Isak in a kiang ah, “Amah ziak in ka si kha ding, ka chih ziak ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Abimelek in, “Ka tung ua na thilhih bangchidan ahia? Mite lak a mi kuapeuh in na zi luppih kha thei uh a kei maw, ka tung uah siamlouhna n’on tungsak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Abimelek mah in, “Kuapeuh hiai mi hiam, a zi hiam, khoih, hihlup ngeingei ding ahi” chi’n mi tengteng thu a pia hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Isak in huai gam ah buh a ching a, huai kum in a leh za a nei hi. Toupa’n a vualzawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hong thupi mahmah a, nakpitak a mi thupi hongsuak hial in a honglian huaihuai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Belamhon leh bawnghon a nei a, inkuan leng tampi a nei hi. Philistiate’n amah a haza uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pa Abraham damlai a, a pa sikhate’n tuileh a toh tengteng uh Philistiate’n a hudim ua, lei in a hihdim vekta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Abimelek in Isak kiang ah, “Ka kiang ua kipan paimang in, kou sang in lah na hatzaw ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Isak huai a kipan a pawt a, Gerar guam ah a puanin a kai a, huai ah a tengta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Isak in a pa Abraham damlai a tuileh a tohte uh a tou nawn a; Abraham sih nung in Philistiate’n lah a na hudim vek ngal ua. A pa’n a min a na sak bangbang in a min a sa chiat hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Isak sikhate’n guam ah a tou ua, huai ah tuileh naknei a mu uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gerar khua a ganpute’n, “Kou tui ahi,” chi’n Isak ganpute toh a kisel uh. Amah toh a kisel ziak un tuileh min Esek a sata hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuileh dang a tou nawn ua; huai leng tuh tum in a kisel pih nawn ua; a min Sitnah a sa hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai a kipan a kisuan a, tuileh dang a tou nawn hi. Huai tuh tum in a subuai nawn kei uhi. Tuin, “ Toupa’n mun lianpi a hon bawlsakta a, hiai gam ah chi tampi i suang ding uhi” chi’n, a min Rehoboth a sa hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai a kipan Beer–sheba ah a hohtou hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai zan mah in Toupa a kiang ah a hong kilak a, “Kei, na pa Abraham Pathian ka hi. Lau ken, na kiang ah ka om hi. K’on vualzawl dia, ka sikha Abraham ziak in na suante pungsak ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huai mun ah maitam a doh a, Toupa min a lou a, huai ah a puanin leng a kai hi. Isak sikhate’n huai ah tuileh a tou nawn uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Gerar khua a kipan Abimelek, a lawm Ahuzaath toh, sepaih pawl heutu Phikol toh, a kiang ah a hoh uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Isak in a kiang ah, “N’on ngaikei ua, na kiang ua pan n’on paimangsak ngal ua, bangchidan in ahia ka kiang a na hong uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amau, “ Toupa na kiang ah a om chih chiantak in ka thei ua, i kikal uah, kou leh nangmah kikal ah kichiam in thu i khung ding uh:
  </para>
  <para style="p">
    <verse number="29" style="v" />Na zakdah ka hih ngeilouh bang ua, thil hoih kia loungal na tung himhim a ka hihlouh ua, hoihtak a k’on paimangsak bang un, nang leng ka siatna ding himhim uh na hihlouhna ding in. Tuin nang Toupa vualzawl na hita,” a chi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan amau ading in Ankuang a luisak a, ne in a dawn uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zingsang in beltak in a thou ua, a kichiam tuah uhi. Isak in amau a paisak a, a kiang a kipan hoihtak in a pawtta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichi ahi a, huai ni mah in Isak sikhate a hong ua, tuileh toh thu a honghilh ua, a kiang ah, “Tui ka muta uh” a chi uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman huai tuileh Sheba a sa hi. Huaiziak in huai khaw min tutan in Beer–sheba ahi lai hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau kum sawmli a upa a hih in, Hit mi Beeri tanu Judith leh Hit mi Elon tanu Basemath zi in a nei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huaite Isak leh Rebekah lungtang hih gentheite ahi uhi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hichi ahi a, Isak a hongtek a, khua mutheilou khop in a mit a hong mialta hi. A tapa upazaw Esau a sam a, a kiang ah, “Ka tapa” a chi hi. Aman a kiang ah, “Hiai ah ka om” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman, “Ngai in, ka tek mahmahta a, ka sih ni ding lah ka theikei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuin hehpih in na vanzat, na thaltang leh na thalpeu tawi inla, va gamvak inla, sakhi hon va matsak in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka sih ma a k’on vualzawl theihna ding in, ka deihlam tak in meh ding in limtakin hon bawlsak inla, ka nek ding in ka kiang ah hontawi in” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isak in a tapa Esau a houpih lai Rebekah in a naza hi. Esau sakhi benga honpaw ding in a gamvakta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rebekah in a tapa Jakob kiang ah, “Ngai in, na pa’n na u Esau kiang a a thugen ka za hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Sakhi honpuak in, ka nek a, ka sih ma a Toupa ma a k’on vualzawlna ding in, meh limtakin hon bawlsak in” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ka tapa, tuin k’on thupiak bang in ka thu zui in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ganhon lak ah va hoh inla, kelnou nih hoih tak, huai a kipan honla in. Huai a deihlam tak in na pa ading in meh limtakin ka na bawl ding.
  </para>
  <para style="p">
    <verse number="10" style="v" />A sih ma a hon vualzawlsak ding in, a nek ding in na pa kiang ah na va paipih ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jakob in a nu Rebekah kiang ah, “Ngai in, ka u Esau mi mulhau ahi a, kei mi nel ka hi
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka pa’n a hon na zawt vialvial kha ding a, amah ading in khempa ka honghi ding a, vualzawl gentak louh hamsiat kizon lel ka hi kei ding maw” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A nu’n, a kiang ah, “Ka tapa, na hamsiat muh ding ka tung ah om hen. Ka thu zui inla, hon valak in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kuan a, a va la a, a nu kiang ah a hon paipih hi. A nu’n a pa deihlam tak in meh limtakin a bawl hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rebekah in a tapa upapen Esau puansilh hoihtak, a kiang a inn a om a la a, a tapa naupang zaw Jakob a silhsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huaiban ah kelnou vun leng a khut leh a ngawng nelna mun ah a phah hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mehlim tak leh tanghou a bawlte a tapa Jakob khut ah a pia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah a pa kiang ah a hoh a, “Pa aw” a chi a; aman, “Hiai ah ka om, ka tapa, kua zaw pen na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob in, a pa kiang ah, “Na tapa upa zaw Esau ka hi; n’on sawl bang in ka hihkhinta. Hehpih in thou inla, hon vualzawl ding in tu inla, ka sakhi sa ne in” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Isak in, a tapa kiang ah, “Ka tapa, bangchidan ahia, hong man gang na tel chia?” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Isak in Jakob kiang ah, “Ka tapa, hehpih in hongnai dih, k’on zawt vialvial ding, ka tapa Esau na hina hiam” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jakob in a pa Isak a va naih a; aman a na zawt vialvial a, “A aw Jakob aw hiven, a khutte lah Esau khutte hiven” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A u Esau khut bang a, a khut a mul ziak in amah a theikei hi. Huchi in amah a vualzawlta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Ka tapa Esau ngei na hi maw?” a chi a; aman, “Hi e” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman, “Hontawi nai in, k’on vualzawlna ding in ka tapa sakhi sa ka ne ding” a chi hi. A hontawi nai a, a neta a, uain leng a honla a, huai leng a dawn hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A pa Isak in a kiang ah, “Ka tapa, hongnai in, hontawp in” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A vanaih a, a tawp a, aman a puansilh gim a za a, a vualzawl hi. “En in, ka tapa gim Toupa vualzawl gam gim bang ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathian in van daitui, lei hoihna, buh tampi leh uain tampi honpia hen.
  </para>
  <para style="p">
    <verse number="29" style="v" />Nam tuamtuamte’n na nna sem uhenla, chi tuamtuamte na ma ah kun uhen. Na unaute tung ah toupa in om inla; na nu tate na ma ah kun uhen. Hon hamsiatte hamsiat in om uhenla, hon vualzawl peuhmah vualzawl in om hen” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichi ahi a, Isak in Jakob a vualzawl zohtakin, Jakob a pa Isak kiang a kipan a pawtkhe manlel in a unaupa, Esau sabeng a hongtung hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman leng mehlimtakin a bawl a, a pa kiang ah, “Pa, thou inla, n’on vualzawlna ding in na tapa sakhisa ne in” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A pa Isak in, a kiang ah, “Kua na hia?” a chi a; aman, “Na tapa, na tapa upa zaw, Esau ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Isak nakpi’n a ling zungzung a, “Sakhi man a, ka kiang a, a sa hontawi, na hong tunma a, ka na nekkhit a, ka vualzawlpa kua ahia? Ahi, amah vualzawl in a om ding” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Esau in a pa thugen a zak in nakpitak leh khase mahmah in a kapta a, a pa kiang ah, “Pa aw, hon vualzawl in, keileng hon vualzawl mahmah ve aw” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman, “Na nau in a hong zekhem a, na vualzawlnate a hong laksakta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman, “A min Jakob a chih uh dik mahmah hilou hia? Nihvei a hon suanta; ka tamasa hihna a hon laksak a; ngai in, tuin ka vualzawlna a hon laksak nawnta” a chi hi. Amahmah in, “Vualzawlna kei adia honsit saklou maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Isak in a dawng a, Esau kiang ah, “Ngai in, amah na kumpipa in ka bawl a, a unau tengteng leng a sikha ding in ka pevek a, buh leh uain in leng ka vakta hi, nang ading in, ka tapa, bang hon hihsak ding ka hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Esau in, a pa kiang ah, “Pa, Vualzawlna khat kia lel leng neilou na maw? Pa aw, keileng hon vualzawl mahmah ve” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Esau ngaihtak in a kapta a, A pa Isak in a dawng a, a kiang ah, “Ngai in, na tenna ding lei hoihna tak, tunglam a kipan van daitui kiakna mun ahi ding.
  </para>
  <para style="p">
    <verse number="40" style="v" />Na namsau in ahi, na hin ding, na nau nna leng nasem ding. Hichi ahi ding a, na kitutkhiak hun chiang in a hakkol na ngawng a kipan na singkheta ding” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />A pa’n Jakob a vualzawl ziak in Esau in a mudah hi. Esau in a lungsim in, “Ka pa sun ni ding a naita a, huaikhit chiang in ka nau Jakob ka that mai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />A tapa upa zaw Esau thugen Rebekah a hilh ua; mi a sawl a, a tapa naupang zaw Jakob a sam a, a kiang ah, “Ngai in, na u Esau in na tungthu ah, nangmah honthah tum in a ki khamuan hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />huaiziak in, ka tapa, tuin ka thu mang in. Thou inla, Haran khua a ka sanggampa Laban kiang ah taimang in.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na u hehna a daih mateng a kiang ah ni bangzah hiam va om phot in.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na u hehna na tung a a daih a, a tung a na thilhih a mangngilh ma teng. A daih a, a mangngilh chiang in mi k’on sawl dia, huai a kipan ka hong pikhe sak ding. Bangdia ni khat a na nih ua hon tan ding ka hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Rebekah in Isak kiang ah, “Hit tanute ziak in hin ka chimtak mahmah hi. Jakob in hiai gam nungak, hiai Heth tanute lak a mi zi dia a neihnawn ngial in zaw, kei ading in hin bang a phatuam dia?” a chi hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Isak in Jakob a sam a, a vualzawl a, thu leng a pia a, a kiang ah, “Kanan gam nungakte lak a mi zi in na nei ding ahi kei.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thou inla, Padan-aram gam a na nu pa Bethuel inn ah hoh inla, huai a kipan na nu sanggam pa Laban tanute lak a mi zi in va nei in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian bangkim hihthei in hon vualzawl in, mipi tampite na hong hih theihna ding in chi tampi hon suangsak in, hon pungsak hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mikhual na hihna gam, Pathian in Abraham kiang a a piak na luah na ding in Abraham vualzawlna leng hon tangsak hen, nang leh na suante leng” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Isak in Jakob a paimangsak a; Padan-aram gam a, Jakob leh Esau nu Rebekah sanggampa Suria mi Bethuel tapa, Laban kiang ah a paita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Esau in, Isak in Jakob a vualzawl a, zi nei ding in Padan-aram gam ah a paimang sak, chih leh a vualzawl lai a, Kanan gam nungakte lak a mi zi in na nei ding ahi kei,
  </para>
  <para style="p">
    <verse number="7" style="v" />chi’n thu a pia chih leh Jakob in a nu leh a pa thumang in Padan-aram gam ah a paita chih a thei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau in Kanan gam nungakte’n a pa Isak lung a hihkim kei uh chih a thei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Esau Ishmael kiang ah a va hoh a, Abraham tapa Ishmael tanu Mahalath, Nebajoth sanggamnu, zi in a nei a, zi a neihsate ban ah a neih behlap ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob Beer–sheba a kipan a pawt a, Haran kholam a zuanta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Koilai mun hiam a tung a, ni a tumkhit ziak in huai ah a giakta hi. Huai a suang khat a la a; lukham in a nei a, huai ah ihmu ding in a lumta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mang a nei a, ngai in, leitung ah lei a hong kidoh a, a dawn in van a sun hi. Ngai in, a tung ah Pathian angelte kahtou in a kumsuk uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ngai in, a dawn ah Toupa ading a, “Kei Toupa , na pu Abraham Pathian leh Isak Pathian ka hi. Na lupna gam nang leh na suante kiang ah k’on pe ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na suante lei a leivui zah ahi ding ua, tumlam, suahlam, mallam leh simlam ah na dalhzak ding uh. Nang ah leh na suan ah khovel a namchih vualzawl in a om ding uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai in, na kiang ah ka om a, na paina peuh ah k’on veng dia, hiai gam ah k’on pi kiknawn ding. Na kiang a ka gen ka hih masak keileh k’on nuse kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jakob ihmu a hong khanglou a, “Hiai mun ah Toupa a om ngeingei hi. Ken lah ka na theikei a” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A lau a, “Hiai mun lauhuai na mah e! Hiai mun dang hilou in, Pathian inn na hi eive, hiai van kongpi na hi eive” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob zingkhang in a thou a, a suang lukham a la a, suangphuh in a phut a, a dawn ah sathau a buak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai mun min Bethel a sa a; a khaw min bel a tung in Luz ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jakob in, “Pathian ka kiang a om a, ka paina lampi a a hon ven a, nekding tanghou leh silh ding puansilh Toupa’n a honpiak a,
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka pa inn a lungmuangtak a ka hongpai nawn leh Toupa , ka Pathian ahi ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiai suang ka phuh leng Pathian inn ahi dia; ka kiang a na honpiak ding tengteng a sawm a khat k’on pe ngeingei ding,” chi in a kichiamta hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai nung in Jakob a pai zel a, suahlam tate gam a tungta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A et leh ngai in, pawn ah tuileh a na om a, a kiang ah belamhon thum a kual uh. Huai tuileh a kipan belamhonte tui a dawnsak uhi. Tuileh kong a suang om a lian mahmah hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai ah belamhon tengteng a paikhawm ua; tuileh kong a kipan suang a khuksuan ua, suang tuileh kong a, a omna ngei ah a koih uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jakob in a kiang uah, “Ka unaute aw, koilam mi na hi ua?” a chi hi. Amau, “Haran khaw mi ka hi uh,” a chi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman a kiang uah, “Nahor tapa Laban na thei uhia?” a chi a; amau, “Thei e” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman a kiang uah, “Damlai a hina maw?” a chi a; amau, “Damlai mah uh, En in, a tanu, Rakil leng belamte pii ding in a hong kuan” a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman, “Ngai un, ni a sanglai mahmah hi, gan pikhawm leng a hun naikei. Belamte tui dawnsak unla, va khah un” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amau, “Ka hih theikei ding uh, belamhon tengteng a pikhawm ua, tuileh kong a kipan suang a khuksuan mateng uh. Huaikhit chiang in belamte tui ka dawnsak zel uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau a houpih lai in Rakil a pa belamte toh a hongtung a; aman huai belamte a chin zel ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichi ahi a, Jakob in a nu sanggampa Laban tanu Rakil leh a nu sanggampa Laban belamhon a muh in a va naih a, tuileh kong a kipan suang a khuksuan a, a nu sanggampa belamte tui a dawnsak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jakob in Rakil a tawp a, ngaihtak in a kapta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jakob in, “A pa tanau leh Rebekah tapa ahi” chih Rakil a hilh hi. Rakil a tai a, a pa a va hilhta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichi ahi a, Laban in a sanggamnu tapa Jakob tanchin a zaktak in, amah dawn ding in a tai a, a pom a, a tawp a, a inn ah a pita hi. Jakob in huai thu tengteng Laban a hilh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Laban in a kiang ah, “ka guh mah leh ka sa mah na hi,” a chi hi. Huchi in kha khat a kiang ah a omta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Laban in Jakob kiang ah, “Ka tupa na hih ziak in a mawkin ka nna nasem dia hia? Bang na loh dia? Honhilh in” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Laban in tanu nih a nei a; a upa zaw min Leah ahi a, a naupang zaw min Rakil ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Leah mit a nou a, Rakil bel chinou hoihtak ahi a, a mel leng a hoih mahmah hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob in Rakil a it a, “Na tanu naupang zaw Rakil toh kiteng ding in kum sagih nang nna k’on sepsak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban in, “Amah ahihleh midang kiang a ka piak sang in nang kiang a ka piak mah a hoihzaw ve. Ka kiang ah om nilouh in,” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jakob in Rakil kitenpih ding in kum sagih a nna a sep sakta hi. Himahleh Rakil a it mahmah ziak in ni tamlou chik bang in a thei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jakob in Laban kiang ah, “Ka luppih theihna ding in ka zi honpia in, ka hun lah a kimta ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Laban in huai khua a mi tengteng a kaikhawm vek a, Ankuang a luita hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichi ahi a, khomial tung in a tanu Leah a pi a, Jakob kiang ah a pilut a; aman a na luppih hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Laban in a sikhanu Zilpah a tanu Leah kiang ah a sikhanu ding in a pia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichi ahi a, zingsang a hong hih in, ngai in, Leah a na hi maimah hi. Jakob in, Laban kiang ah, “Ka tung a na thilhih bangchidan ahia? Rakil toh kiteng ding in na nna ka sem ka hia? Bangziak a honkhem maimah na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban in, “Ka gam uah huchibang a ta upa zaw ma a a nau zaw piak dan ahi kei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiai minu nipikal zou phot inla, huchi in, kum sagih dang ka nna nasep zoh chiang in a nau zaw leng k’on pe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jakob in huchibang in a hih a, ni sagih a zouta a; a tanu Rakil a zi ding in a peta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Laban in a sikhanu Bilhah a tanu Rakil kiang ah a sikhanu ding in a pia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Rakil leng a luppih a, Leah sang in Rakil a it zaw a, Laban nna kum sagih dang a semta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toupa’n Leah pen huat in a om chih a thei a, a sul a honsaka; Rakil bel a ching hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Leah a gai a, tapa a nei a, a min Reuben a sa hi. “ Toupa’n ka gimdan a muta. Tu’n zaw ka pasal in a hon itta ding” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A gai nawn a, tapa a nei nawn a; “ Toupa’n huat a ka om a zak ziak in hiai leng a honpia hi” a chi hi. Huchi in a min Simeon a sa hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />A gai nawn a, tapa a nei nawn a; “Tuin tapa thum ka neihsak ziak in, ka pasal in a hon zuita ding” a chi hi. Huaiziak in a min Levi a sa hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />A gai nawn a, tapa a nei nawn a; “Tutung in zaw Toupa ka phat ding,” a chi hi. Huaiziak in a min Judah a sa a; ta a nei nawn tadih kei hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rakil in Jakob ta himhim a neihsak kei chih a kitheih in a sanggamnu a hazata hi. Jakob kiang ah, “Tate honpia in, huchilou in zaw ka si ding” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Rakil tung ah Jakob a heh a, “Gilgah hon pelou Pathian bang ka hi ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman, “En in, ka sikhanu Bilhah luppih in. Huchi in ken leng amah a kipan tate ka neihsam theihna ding in ka phei tung ah ta k’on nei ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A sikhanu Bilhah a zi ding in a pia a, Jakob in amah a na luppih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bilhah a gai a Jakob ta a neihsakta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Rakil in, “Pathian in a hon ngaihtuah a, ka aw leng a za a, tapa a honpia” a chi hi. Huaiziak in, a min Dan a sa hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Rakil sikhanu Bilhah a gai nawn a, Jakob tapa dang a neihsak nawn hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rakil in, “Nakpitak in ka sanggamnu ka buan a, ka zouta” a chi a; a min Naphtali a sa hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Leah in ta dang a nei nawn kei chih a kitheih in, a sikhanu Zilpah a pi a, a zi ding in Jakob kiang ah a pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Leah sikhanu Zilpah in Jakob tapa a neihsak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Leah in, “Vangphathuai mah ei” a chi a; a min Gad a sa hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Leah sikhanu Zilpah in Jakob tapa dang a neihsak nawn hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leah in, “Hampha natel ing e! Numeite’n hampha honchi ding uh eive” a chi a; a min Asher a sa hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Buhlak lai in Reuben in gamlak ah zawl-ai a va mu a; a nu Leah kiang ah a hontawi hi. Rakil in Leah kiang ah, “Hehpih in na tapa zawl-ai a khen hon pedih,” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman a kiang ah, “Ka pasal n’on suhsak thilduai ahi hia? Ka tapa zawl-ai leng hon suh sak na tum nawn lai maw?” a chi hi. Rakil in “Na tapa zawl-ai sik in tuzan in a hon luppih ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nitaklam in Jakob gamlak a kipan a hongtung a, a dawn ding in Leah a kuan a, “N’on luppih ding ahi. Ka tapa zawl-ai in k’on guaita ngal a” a chi hi. Huai zan in amah a luppihta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in Leah thumna a ngaikhia a, a gai a, Jakob tapa ngana a neihsak nawn hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Leah in, “Ka sikhanu ka pasal kiang a ka piak ziak in Pathian in ka loh honpia eive” a chi a; a min Issakar a sa hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Leah a gai nawn a, Jakob tapa gukna a neihsak nawn hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Leah in, “Pathian in thil hoihtak a hon neisak a; tuin zaw ka pasal tapa guk ka neihsak tak ziak in, ka kiang ah a tengta ding” a chi a; a min Zebulun a sa hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huai nung in tanu a nei nawn a, a min Dinah a sa hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian in Rakil a theigige a, Pathian in a thumna a ngaikhia a, a sul a hon sak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amah a gai a, tapa a nei a; “Pathian in ka minsia a la mangta” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“ Toupa’n tapa dang honpiak beh ding” chi’n, a min Joseph a sa hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichi ahi a, Rakil in Joseph a neih nung in, Jakob in Laban kiang ah, “Kei ka omna ngei ah, ka gam ah hon paisakta in aw.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na nna ka sepsan ka zite leh ka tate honpia inla, hon paisak in. Na nna k’on sepsak dan lah na thei ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Laban in a kiang ah, “N’on hehpihtheih leh omtadih lai ve. Toupa’n nang vang in a hon vualzawl, chih aisan in ka thei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amahmah in, “Na loh ding sep inla, honhilh dih, k’on pe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman, a kiang ah, “Bangchi’n na nna ka sem a, bangchi’n na gan ka kiang ah a om ua, na thei a kei hiam?
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka hong ma in tawmchik kia na nei a, tu’n zaw tampi a hong phata uhi. Ka kalsuanna peuh ah Toupa’n nang a hon vualzawl hi. Himahleh chikchiang in ahia ka inkuante adia ka sepkhiak sam ding?” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman, “Bang k’on pedia?” a chi a; Jakob in, “Bangmah na honpiak ding ahi kei. Hiai thil hihsak leh na ganhon ka khah dia ka chingnawn ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuni in na ganhon ka va enkhe vek dia, belam lak a, a vom gial petmah a gial leh a vom a gial zekzek leh a vom peuhmah, kel lak a, a kang a gial petmah a gial leh a kang a gial zekzekte huai a kipan ka pituam zel ding hi. Tuban huchibang a hong piang peuhmah ka loh ahita ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuban na mitmuh a khial a ka omna thu ah na hongpai hun chiang in, ka diktatna in a hon dawnsak mai ding. Kel lak a a kang a gial petmah a gial lou leh a kang a gial zekzek lou leh belam lak a a vomlou ka kiang a na muh peuhmah ka guk in na sepmai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Laban in, “Ngai in, na gen bang tak hile a ke” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai nitakin keltal a kang a gial leh a kang a gial zekzek teng leh kelnu a kang gial petmah a gial leh a kang a gial zekzek teng a kanna om peuhmah, belam lak a a vom tengteng toh a pituam a, a tapate khut ah a pia hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amah leh Jakob kikal ah ni thum lam a omsak a; Jakob in Laban ganhon dangte a ching nawn hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jakob in hiangzau sing leh makha sing leh sesing chiang hing a la a, a hawng a khokngou chiat a, chiangte ah angoute a kilangsak hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A chiang hawng khohte ganhonte’n tui a hong dawnzelna tuikuangte ah, tui luannate ah leh ganhonte mazawn zel ah a koihta hi; tuidawn dia a hongpai chiang ua a gaina ding un.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ganhonte chiangte ma ah a gai panta ua, a gialte, gial petmah a gialte, a gial zekzekte a hon neizel uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jakob in belamnoute a koihtuam a, ganhonte Laban ganhon lak a, a gial leh a vom tengteng lam a ngasak zel a; amah ganhonte a koihtuam zel a, Laban gan lak ah a koih kei hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hichi ahi a, gannu hatzawte a huk chiang un, a gai theihna ding un Jakob in tuiluanna ah, gan mitmuh in chiangte a koih zel hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Himahleh gannu a hatloute mai ah a koih kei hi. A nou hatloute Laban a ahi ua, a hatte Jakob a ahi zel uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jakob nakpi’n a hongpung a, ganhon thupitak, sikhanute, sikhapate, sangawngsaute leh sabiltungte a neita hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Laban tapate’n, “Jakob in i pa neihsate lamang in, i pa neihsa a kipan hiai thupina tengteng a mu hi,” a chih uh a na zata hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob in Laban mel a en a, ngai in, tuma lam bang in a tung ah a hoih nawn kei, chih a thei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa’n , Jakob kiang ah, “Na pipute gam ah leh na tanaute kiang ah pai nawnta in. Na kiang ah om ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jakob in mi a sawl a, gamlak a a ganhon omna ah Rakil leh Leah a samsaka, a kiang uah,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Na pa uh mel ka muh in, tuma lam bang in ka tung ah a hoih nawn kei, chih ka thei hi. Himahleh ka pa Pathian ka kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na pa uh nna ka theihtawp in ka sem chih na thei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh na pa un hon zekhem a, ka loh lah sawmvei tak a hihlamdang a; himahleh Pathian in ka siatna ding a khoih a phalkei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gial petmah a gialte na loh ahi ding, a chih leh, gan tengteng in gial petmah a gialte a nei uh. A gialte na loh ahi ding, a chih leh, gan tengteng in a gialte a nei zel uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchibang in Pathian in na pa gante a laksaka, kei a hon peta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichi ahi a, gante a gai pat lai un, ka mang in ka dak a, ngai in, a pa, ganhonte, a gialte, gial petmah a gialte, a gial a gial iik iakte ahi uh chih ka mu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka mang in Pathian angel in, ‘Jakob,’ hon na chi a; ken ‘hiai ah ka om’ ka chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman, ‘dak inla, en in, a pa ganhonte tengteng a gialte, gial petmah a gialte, a gial a gial iik iakte ahi uh. Laban in na tung a a thilhih tengteng ka mu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei, suangphuh a sathau na nilh a, ka kiang a thu na chiamna Bethel, huai Bethel Pathian ka hi. Tuin thou inla, hiai gam a kipan pawt inla, na pianna gam ah pai nawnta in’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Rakil leh Leah in a dawng ua, a kiang ah, “Ka pa uh inn ah kou ading in tantuan leh gouluah ding a om lailai ahia?
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman mikhual banglel a honsim hita lou hia? A hon khong khinta a, ka man ulah a ne khinta ngal a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in ka pa uh hauhna a laksak tengteng ei leh i tate a ahi. Pathian in na kiang a a gen peuhmah hih in” a chi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jakob a thou a, a tapate leh a zite sangawngsau tung ah a tuangsak hi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Kanan gam a a pa Isak kiang a paiding in a gan tengteng leh a sumkhol tengteng, a gan muhte, Padan-aram gam a a kholte a paipih vek hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Laban a belam mulmet ding in a paimang a; Rakil in a pa milim pathiante a guksak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Suria mi Laban theihlouh kal in Jakob in a guk paimangsan a, a paimangsan ding thu a hilh kei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in a neih tengteng toh a taimangta hi. A thou a, Luipi a kan a, Gilead tanglam zuan in a pai hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ni thum ni’n Jakob a taita chih Laban a hilh uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A unaute a pi a, ni sagih lam tan a delh a; Gilead tang ah a delh phata hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Suria mi Laban kiang ah zan in a mang in Pathian a hong a, a kiang ah, “Jakob kiang ah a sia, a pha a bangmah genlou ding in pilvang in,” a chi hi. Laban in Jakob a delh phata hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jakob in a puanin tang ah a kaikhin a; Laban in leng a unaute toh Gilead tang ah a kai uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Laban in Jakob kiang ah, “Na thilhih bangchidan ahia oi? Ka theihlouh kal a na guk paimang a, namsau a lak salte bang mai a ka tanute na pimang?
  </para>
  <para style="p">
    <verse number="27" style="v" />Bangdia hon taimangsan a, hon guk paisan a, nopsaknate toh, late toh, khuangtate toh, kaihgingte toh k’on khak theihna dia n’on hilhlouh?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka tute leh ka tanute ka tawp na phal kei. Haihuaitakin thil na hih hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hon hihsethei ka hi a; himahleh na pa Pathian in tu zan in, Jakob kiang ah a sia, a pha bangmah genlou ding in pilvang in, chi’n, a hon houpih hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na pa inn na ngaih mahmah tak ziak in, pai ut hi tawk lechin leng bangdia ka pathiante hon guksak na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jakob in a dawng a, Laban kiang ah, “Ka lauh ziak ahi. Na tanute n’on laksak teitei kha ding ka chi a, ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kuapeuh na pathiante na muhna a hing kei ding. I unaute mitmuh in nang a ka kiang a om enchian inla, la ve” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Rakil in a na gu chih lah Jakob in a thei ngalkei a. Jakob puaninte ah, Leah puaninte ah leh sikhanu nihte puaninte ah Jakob a lut a; himahleh a mu kei hi. Leah puanin a kipan a pawt a, Rakil puanin ah a lut hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Rakil in milimte a na la a, sangawngsau van lak ah a na koih a, a na tutkhum hi. Laban in a puanin sung tengteng a maisuak vek a, himahleh a mu kei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aman a pa kiang ah, “Na ma a ka din ngaplouh ziak in ka toupa, heh ken aw. Numei omdan ngeina ka tung a a om laitak ahi ngal a” a chi hi. A zongzong a, himahleh milimte a muzou takei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jakob a hehta a, Laban a salta hi. Jakob in Laban kiang ah, “Bang ah ka talek a, bang ah ka khial a hon delh na hia?
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka van tengteng na mai nung in leng, na inn sung van himhim bang a na muh? Eigel kal a thu a khen theihna ding un ka unaute leh na unaute ma ah na muh pen koihkhia in.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kum sawmnih vingveng na kiang ah ka omta; na belampite leh na kelpite’n nou a neikhial ngeikei uh. Na belamhon lak a a pate leng ka ne ngeikei hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Gamsa keih leng na kiang ah k’on tun ngei ngalkei a: a mang sik in ken ka thuak zawzela; sun a guk hiam, zan a guk hiam lah ka dit na phut gige hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hichibang in ka om zel a; sun nisa leh zan khovot in a hon hihgim thei mahmah a; ihmut leng ka mu ngeikei hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kum sawmnih sung teng na inn ah ka om a; na tanu nihte loh ding in kum sawmlehli na nna ka sem a, na gante loh ding in kum guk ka sem nawn a; ka loh sawmvei na hih lamdang hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka pa Pathian, Abraham Pathian leh Isak Pathian lauhna ka kiang a omlou hile houh, tun vuaktang lel a hon paisak ngeingei ding na hi. Pathian in ka haksat thuakdan leh ka sepgim dan a mu a, tu zan a nang honsal ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Laban in a dawng a, Jakob kiang ah, “Hiai tanute ka tanute ahi ua, hiai naupangte ka naupangte ahi uh. Hiai gante kei gante ahi ua, na muh tengteng kei avek ahi uh. Tuni in hiai ka tanute tung ah leh a ta neihte uh tung ah bang ka hihthei dia?
  </para>
  <para style="p">
    <verse number="44" style="v" />Kisa in, kei leh nang thu i khung ding; Kei leh nang kikal ah theihpihna hi hen” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Jakob in suang a la a, suangphuh in a phut hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jakob in a unaute kiang ah, “Suang lakhawm un” a chi hi. Suang a la ua, a chiang ua, a suang chiankhawm kiang ah an a ne uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Laban in huai suang chiankhawm, Jegarsahadutha, a sa a; Jakob in Galeed, a sa hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Laban in, “Hiai suang chiankhawm tuin kei leh nang kikal ah theihpihna ahi” a chi hi. Huaiziak in, a min Galeed chih ahita hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mizpah chih leng ahi, “Kikhen a i om hun chiang in Toupa’n honveng tuaktuak hen,” a chih ziak in.
  </para>
  <para style="p">
    <verse number="50" style="v" />“Ka tanute na suk gentheih a, ka tanute lou zi dang na neih leh, ka tanute chih louh kuamah i kiang ah a omkei na ua, en in, Pathian, kei leh nang kal hon theihpihpa ahi” a chi ngal hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Laban mah in, “Hiai suang chiankhawm en inla, keimah leh nangmah kikal a ka phuh sungphuh leng en in.
  </para>
  <para style="p">
    <verse number="52" style="v" />Poi kikhoihsak ding in, kei hiai suang kheng in na kiang ah ka hongpai kei ding, chih leh nang leng hiai suang chiankhawm leh hiai suangphuh kheng in ka kiang ah na hongpai kei ding, chih, hiai suang chiankhawm a theihpihna hi henla, hiai suangphuh leng a theihpihna mah hi hen.
  </para>
  <para style="p">
    <verse number="53" style="v" />Abraham Pathian, Nahor Pathian, a pa uh Pathian in i kal ah thukhen hen” a chi hi. Jakob in a pa Isak lauhpa minlou in, a kichiamta hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Jakob in tang ah kithoihna a lan a, a unaute tanghou ne ding in a sam a; tanghou a ne ua, tang ah a giak chiat uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Zingsang in beltak in Laban a thou a, a tute leh a tanute a tawp a, a vualzawl hi. Laban a pai a, amah omna ah a kiknawnta hi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob a pai zel a, Pathian angelte’n a na tuak uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob in amau a muh in, “Hiai Pathian giahphual ahi” a chi a; huai mun Mahanaim a sa hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jakob in, Edom gam, tua Seir gam ah a ma ah thangkoute Esau kiang ah a sawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kiang uah, ka toupa Esau kiang ah hichi’n na gen ding uh. “Na sikha Jakob in hichi’n a chi. Laban kiang ah mikhual ka hi a, tutan ka om nilouh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bawngtalte, sabiltungte leh belamte, sikhapa leh sikhanute ka nei hi. Na hehpihna ka muh theihna dia ka toupa hilh ding in mite k’on sawl hi.”
  </para>
  <para style="p">
    <verse number="6" style="v" />Thangkoute Jakob kiang ah a hong kiknawn ua, “Na u Esau kiang ka va tung ua, mi za li toh nang dawn ding in a hongpai hi” chi’n, a gen uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob in a lau mahmah a, a lungkhamta hi. A kiang a mi omte, belamhonte, bawnghonte leh sangawngsaute pawl nih in a khen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau hongpai a, pawl khat a thah leh leng pawl khat omlai taimang thei ding, a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jakob mah in, “Aw ka pa Abraham Pathian, ka pa Isak Pathian, Toupa , Na gam ah leh na tanaute kiang ah pai nawnta in. k’on hih hoih ding, hon chipa,
  </para>
  <para style="p">
    <verse number="10" style="v" />Na sikha tung a hehpihna na muhsak leh thutak tengteng na muhsak lak a, a neupen leng mutak ka hi kei. Hiai Jordan lui ka chiang kia toh ka kan a; tuin zaw pawl nih hial ka hong hita uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hehpih in ka u khut a kipan, Esau khut a kipan, hon humbit in. Huchilou in zaw kei leh numei naupang tan in a honthat kha ding, chih ka lau hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Nang k’on hihhoih ngeingei dia, na suante tuipi a piaunel simzohlouh tanhiala a tam bang in ka bawl ding n’on chi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai zan in huai ah a giakta a; a neihlak a kipan a u Esau ading thilpiak a lakhia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kelpi za nih, keltal sawmnih, belampi za nih leh belampa sawmnih,
  </para>
  <para style="p">
    <verse number="15" style="v" />Sangawngsau zatlai sawmthum a noute toh, bawngpi sawmli leh bawngtal sawm, sabengtungpi sawmnih leh sabiltung nou sawm.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiaite pawl chih a tuam chiat in a sikhate khut ah a kem sak a, a sikhate kiang ah, “Ka ma ah pai galkah unla, pawl chih kalnei sak zel un,” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A makaipa kiang ah, “Ka u Esau in a hontuah a, na kiang a, kua na hia? Kaw hoh dek na hia? Na ma a om kuate ahi ua? chi a a hondot leh,
  </para>
  <para style="p">
    <verse number="18" style="v" />Na sikha Jakob a ahi ua; Ka pu Esau, nang ka toupa adia a hon khak thilpiak ahi. Ngai in, amah ka nung uah a om, na chi ding” chi in thu a pia hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A nihna leh a thumna leh ganhon hawlte tengteng kiang ah leng, “Esau na muh chiang un huchibang mah in na gen ding uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai in, na sikha ka nung uah a om, chi chiat un” chi in thu a pe chiat hi. “Thilpiak ka ma ah pai leh a lung ka damsak dia, huai nung in a mel ka mu ding. Huchi in, a hon na kipahpih ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in, thilpiak a ma ah a pai galkah sak a; amah huai zan in a pawlte lak ah a giak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Zan in a thou a, a zi nihte leh a sikhanu nihte leh a tapa sawmlehkhatte a pi a, Jabbok lui ngahna ah a kanta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amau a pi a, lui a kan ua, a neih tengteng leng a kansak vek hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jakob amah kia in a omta a, mi khat toh phalvak tan a kibuan uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A zoukei, chih a kitheih in a pheipi guhtuah a khoihsak a, a kibuan lai un Jakob pheipi guhtuah a kilawita hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman, “Honkhah in, phalvak ding ahita,” a chi hi; aman, “N’on vualzawl keileh k’on khah kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman a kiang ah, “Na min bang ahia?” a chi a; aman, “Jakob” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman, “Na min Jakob ahi nawn kei ding, Israel a honchi zawta ding uh. Pathian leh mihingte na buan a, na zouta ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jakob in amah a dong a, “Hehpih in na min honhilh in” a chi hi. Aman, “Bangziak in ahia ka min n’on dot?” a chi hi. Huai ah a vualzawlta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jakob in huai mun min “Peniel” a sa hi. “Pathian a mai chin mahmah ah ka mu a, ka hinna a hawi ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Peniel a khenlai in, ni a hongsuak a, amah a honsun a, a pheipi ziak in a baita hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huaiziak in, Jakob pheipi guhtuah a sadual tak a khoih sak ziak in tutan in Israel suante’n pheipi guhtuah a sadual om a ne ngeikei uhi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Jakob a dak a, ngai in, Esau a kiang a mi za li toh a hongpai hi. Huchi in Leah, Rakil leh sikhanu nihte kiang ah a tate a omsak khipkhep hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sikhanute leh a tate a makai in a koih a, Leah leh a tate a zom in a koih a, Rakil leh Joseph bel a nanungpen in a koih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah a ma uah a pai a, a u kiang chin a tun masiah sagihvei leisi in a kun hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh Esau amah mu ding in a tai a, a pom a, a ngawng a kun in a tawp a, a kap uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Esau a dak a, numeite leh naupangte a mu a; “N’on pite kuate ahi ua?” a chi hi. Aman, “Pathian in hehpihtak a na sikha kiang a a piak naupangte ahi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sikhanute leh a tate uh a hongpai ua, a kun uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Leah leng a tate toh a hongpai nai ua, a kun ua, huaikhit in Joseph leh Rakil leng a hongpai nai ua, a kun uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau in, “Ka ganhon kituahpih tengpi bang na chihna ahia?” a chi hi. Aman, “Ka toupa, na hehpihna ka muh theihna ding in ka chi a ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Esau in, “Ken leng hau veng e, bawi aw, na neih tengteng nang a hi hen” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakob in, “Hilou e, n’on hehpih theih leh hehpih in k’on thilpiakte hon sansak in. Pathian mel mu bang in na mel ka mu a, ka tung ah lah na kipak ngal a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in hon hehpih ziak leh a kiching ka neih ziak in k’on thilpiakte sang in” a chi hi. Huchi in a kun a, aman a sangta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Esau in, “Kisa in, pai ni, na ma ah ka pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman a kiang ah, “Naupangte a neulai dan uleh belamhon ka kiang a omte a nou a hih dan uh, ka toupa, na thei hi. Ni khat lel leng hatlua a, a hawl uleh ganhon tengteng a sivek ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka toupa, hehpih in na sikha ma ah pai inla; Ken Seir tang ah, ka toupa, na kiang ka tun mateng, ka ma a gante a paitheih hun bangbang uleh naupangte a paitheih hun bangbang un, awlawl in k’on masuan zel ding” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Esau in, “Ka kiang a om mi khenkhat hon nutsiat leng a ke” a chi hi. Aman, “A poimawh khol ahia? Ka toupa mitmuh in hehpihna hon musak in” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai ni mah in Seir tanglam zuan in Esau a kiknawnta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jakob Sukkoth mun ah a pai a, amah ading inn a lam a, a gante adin leng buktate a lam hi. Huaiziak in, huai mun min Sukkoth a sa hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jakob Padan-aram gam a kipan a hong a, lungmuangtakin Sekem khua, Kanan gam a om, a tung a, khopi ma ah a puanin a zakta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A puanin zakna mun, Sekem pa Hamor tate a kipan, dangka za khat in a lei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai ah maitam a doh a, a min El-Elohe-Israel a sa hi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Leah tanu Dinah, Jakob a neihsak, huai gam nungakte mu ding in a pawtkhia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiv mi Hamor, huai gam kumpipa tapa Sekem in amah a na mu a; a man a, a luppih a, a hihnin hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A lungsim Jakob tanu Dinah tung ah a om bikbek a, huai nungak lah a it a, amah kamsiam tak in a houpih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sekem in a pa Hamor a houpih a, “Huai nungak zi ding in hon neisak in” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakob in a tanu Dinah a ninsak khin, chih a za a; a tate gamlak ah a gan lak uah a om uhi. Huchi in, a hongtun mateng uh Jakob a daidide hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sekem pa Hamor Jakob houpih ding in a kiang ah a hoh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jakob tapate’n a zaktak un gamlak a kipan a hong paita ua; Jakob tanu luppih in Israelte lak a thil gilou haihuai tak, thilhih hetlouh ding, a hih ziak in a lungkham ua, a heh mahmah uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hamor in amau a houpih a, “Ka tapa Sekem lungsim na tanu uh tung ah a om bikbek a, hehpih in zi ding in neisak ve ua,
  </para>
  <para style="p">
    <verse number="9" style="v" />Kila tuah ve ni e; na tanute uh hon lasak unla, ka tanute u leng la sam un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka kiang uah na teng ding ua; gam leng a kiching gige ding. Hiai ah teng unla, sumsin unla, hiai ah kihih inbul un” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sekem in nungak pa leh a sanggampate kiang ah, “Hon hehpih un, ka kiang a na gen peuh uh k’on pe ding.
  </para>
  <para style="p">
    <verse number="12" style="v" />Man leh thilpiak zaw bangzah gen le uchin, na chih bangbang uh k’on pe ding. A bang hileh, nungak pen zi ding in hon neisak phot un” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jakob tapate’n a sanggamnu uh Dinah a nitsak ziak in Sekem leh a pa Hamor zekhem in a dawng ua, a kiang uah,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Hiai thil zeksumlouh mi kiang a ka tanu uh piak pen ka hih theikei ding uh. Huai lah kou ading in minsiatna ahi ngal a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichibang a kichiam kia in na thu uh pha ka sa ding uh. Na lak ua pasal peuhpeuh kou bang a zeksum in om uhen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in ka tanute uh na nei ding ua, kou leng na tanute uh ka neisam ding uh. Na kiang uah ka teng ding ua, chi khat i hi ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh, zeksum thu a ka thu uh na zuihkei ding uleh, ka tanu uh ka pi ding ua, ka paimai ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A thugen un Hamor leh Hamor tapa Sekem a kipaksak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tangval in Jakob tanu a deih mahmah ziak in huai thil sawt hallou in a hihta hi. Amah a pa inkuan tengteng lak a mite zahtak pen ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hamor leh a tapa Sekem in a khaw kulh kongkhak uh a pha ua, a khote uh a houpih uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hiai mite kituahpih tak in a om uh. Huaiziak in hiai gam a teng in, hiai ah sumsin uhen. Ngai un, amau ading in gam lah a za ngal a. A tanute uh zi in nei lehang, i tanute uh leng neisak sam ni.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh nam khat i hong hihna ding a i kiang a ten theihna ding un hichibang a i chiam kia in huai mite’n pha a hon sak pih ding uhi. Zeksum a hih bang ua i lak ua pasal peuhpeuh zeksum hong hita lehang.
  </para>
  <para style="p">
    <verse number="23" style="v" />A gante uh, a sumte uh, a sa tengteng uh ei a ahi vekkei dia hia? A thu uh phasak pih maive ni, Huchi in i kiang uah a teng ding uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hamor leh a tapa Sekem thu a khaw kulh kongkhak a pawt khe tengteng in a zui ua; a khaw kulh kongkhak a pawtkhe tengteng, pasal peuhpeuh zek a sumsak uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichi ahi a, a ni thum ni a, na a thuaklai un, Jakob tapate lak a nih, Dinah sanggampa Simeon leh Levi in a namsau uh tawi tuak in a guk in khua a va sualta ua, pasal tengteng a thatgam uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hamor leh a tapa Sekem namsau hiam in a that ua, Sekem inn a kipan Dinah a pi ua, a pawtta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jakob tapate’n a mi thahte uh a va phanawn ua, a tanu uh a nitsak ziak un huai khua a lokta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A belamhonte uh, a bawnghonte uh, a sabiltungte uh, a khua ua thil omte leh a lou ua thil omte a laksak uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A sum tengteng uleh a ta a nau neu chikchik leh a zite uh tengteng sal in a man ua, inn tengteng a lok uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jakob in Simeon leh Levi kiang ah, “Nou hiai gam a tengte lak a, Kanante leh Perizte lak ah, huat n’on pawsak ua, n’on lungzingsak mahmah uh. Kei tawmchik ka hih ziak in hon sual ding in a kikhawm khawm ding ua, a honthat mai ding uhi. Huchi in, hihmang in ka om ding a, kei leh ka inkuanpihte toh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amau, “Ka sanggamnu uh kizuak bang a a bawl ding ahi ahia?” a chi uhi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Pathian in Jakob kiang ah, “Thou inla, Bethel ah hohtou in, huai ah teng in. Na u Esau a kipan na taimanglai a, na kiang a kilak Pathian ading in huai ah maitam doh in” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob in a inkuanpihte leh a kiang a om tengteng kiang ah, “Na lak ua om gamdang pathiante koihmang unla, kihihsiangthou unla, na puansilhte uh kheng un.
  </para>
  <para style="p">
    <verse number="3" style="v" />I thou ding ua, Bethel ah i paitou ding uh. Ka lungzin lai a hon dawng, ka paina a ka kiang a om zel Pathian ading in maitam ka doh ding” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in gamdang pathiante a khut ua om tengteng leh a bil ua bilbah a bah tengteng uh Jakob kiang ah a pia uhi. Jakob in Sekem khaw kiang a tosaw nuai ah a phum hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A pai ua, a kim ua khuate’n a lau mahmah ua, Jakob tapate a delhkei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jakob Kanan gam a Luz khua a tung a, amah leh a kiang a om tengteng toh, Luz Bethel ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai ah maitam a doh a, a u a kipan a taimanglai a, a kiang a Pathian a kilak ziak in huai mun min El Bethel a sa hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Rebekah donnu Deborah a si a, Bethel khang a tawsaw nuai ah a vui ua; a tawsaw min Allon bakuth a sa uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jakob Padan-aram gam a kipan a hongtun in Pathian a kiang ah a kilak nawn a, a vualzawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian in a kiang ah, “Na min Jakob ahi a; na min Jakob ahi nawn kei ding a, na min Israel ahi zawta ding” a chi hi. Huchi in, a min Israel a sata hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian mah in a kiang ah, “Kei Pathian bangkim hihthei ka hi. Chi tampi suang in hongpung in. Chichih tham ngial leh chi tuamtuam omkhawm leng nang ah a hongom ding ua, na khal a kipan kumpipate leng a hongpawt ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abraham leh Isak kiang a ka gam piak na kiang ah k’on pe ding. Na omlouh nung chiang in na suante kiang ah leng gam ka pe zel ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in a houpihna mun a kipan Jakob a paitouh santa hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A houpihna mun ah Jakob in suangkhuam a phut a; a tung ah dawn thillat a buak a, a tung ah sathau leng a buak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jakob in, Pathian in a houpihna mun min Bethel a sa hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bethel a kipan a pai ua; Ephrath khaw tunna ding gamlatak ahihlaiin Rakil in nau a veia, a nakvei mahmah hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichi ahi a, a gim laitak in naudommi’n, “Lau ken, hiai tapa leng na nei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichi ahi a, a kha a pawtlaiin, a sita a, a min Ben Oni a sa a; himahleh a pa’n Benjamin a sa hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rakil a sita, Ephrath lampi ah a vui uhi, Ephrath khua Bethlehem khua ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A han tung ah Jakob in suang a phut a; huai tunitan in Rakil han suangphuh ahilai hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel a pai zel a, Migdol Eder khenlam ah a puanin a kai hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichi ahi a, Israel huai gam a a omlai in Reuben in a pa mei Bilhah a va luppiha; Israel in huai a za hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jakob tapate sawmlehnih ahi uh. Leah tapate Reuben, Jakob ta upapen, Simeon, Levi, Judah, Issakar leh Zebulun ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Rakil tapate Joseph leh Benjamin ahi uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rakil sikhanu Bilhah tapate Dan leh Naphtali ahi uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Leah sikhanu Zilpah tapate Gad leh Asher ahi ua; huaite Jakob tapa, Padan-aram gam a a neihte ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jakob Kiriath Arba khua a Abraham leh Isak omna Mamre ah a pa Isak kiang a tungta hi. Kiriath Arba khua Hebron ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Isak damsung kum za leh sawmgiat ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Isak in a kha a khahta a, upapi tekkuna damin a si a, a chipihte kiang ah piin a omta hi. A tapate Esau leh Jakob in amah a vuita uhi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hiaite Esau suante ahi uh, Esau Edom ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Esau in a zite Kanan gam a nungakte lak a a neih ahi: Hit mi Elon tanu Adah leh Hiv mi Zibeon tanu Anah Tanu Aholibamah ahi ua;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ishmael tanu, Nebajoth sanggamnu Basemath toh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Adah in Eliphaz Esau a neihsak a; Basemath in Reuel a nei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aholibamah in Jeush, Jaalam leh Korah a nei a; hiaite Esau tapate, Kanan gam a a neihte ahi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Esau in a zite, a tapate, a tanute, a in a mi tengteng, a gante tengteng, a sa tengteng leh a thil neih tengteng, Kanan gam a a muhte a paipih a, a nau Jakob kiang a kipan gamdang ah a paimangta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A thilneihte uh a thupi lua a, a omkhawm theikei uh. A gante uh ziak in mikhual a a omna gam un a chinta kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Esau Seir tang ah a tengta hi. Esau Edom ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiaite Seir tang a Edomte suangpa Esau suante ahi uh:
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiai Esau tapate minte ahi: Eliphaz, Esau zi Adah tapa; Reuel, Esau zi Basemath tapa.
  </para>
  <para style="p">
    <verse number="11" style="v" />Eliphaz tapate: Teman, Omar, Zepho, Gatam leh Kenaz ahi uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Timna, Esau tapa Eliphaz mei ahi a; aman Amalek Eliphaz a neihsak hi. Hiaite Esau zi Adah suante ahi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiaite Reuel tapate ahi uh: Nahath leh Zerah, Sammah leh Mizzah. Hiaite Esau zi Basemath suante ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiaite Zibeon tanu Anah tanu Esau zi Aholibamah tapate ahi uh: Aman Esau Jeush leh Jalaam leh Korah a neihsak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiaite Esau tapate lak a heutute ahi uh: Esau ta masapen Eliphaz tapate; heutu Teman, heutu Omar, heutu Zepho, heutu Kenaz,
  </para>
  <para style="p">
    <verse number="16" style="v" />heutu Korah, heutu Gatam leh heutu Amalek. Hiaite Edom gam a Eliphaz a kipan pawt heutute ahi ua, hiaite Adah suante ahi uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiaite Esau tapa Reuel suante ahi uh: Heutu Nahath, heutu Zerah, heutu Sammah leh Heutu Mizzah. Hiaite Edom gam a Reuel a kipan a pawt heutute ahi ua; Esau zi Basemath suante ahi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiaite Esau zi Aholibamah suante ahi uh: Heutu Jeush, heutu Jalaam leh heutu Korah. Huaite heutu Anah tanu Esau zi Aholibamah suante ahi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaite Esau tapate ahi ua; a lak ua heutute ahi uh. Esau Edom ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hiaite Hor mi Seir tapa gam luahte ahi uh: Lotan, Sobal, Zibeon, Anah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Dishon, Ezer leh Dishan. Huaite Edom gam a Seir tapa Horte heutute ahi uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lotan tate Hor leh Hemam ahi ua; Lotan sanggamnu Timna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiaite Sobal tate ahi uh: Alvan, Manahath, Ebal, Shepho leh Onam.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiaite Zibeon tate ahi uh: Ajah leh Anah. Hiai Anah, a pa Zibeon sabiltungte a khah lai a gamdai a tuisa khukte mukhepa ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiaite Anah tate ahi uh: Dishon leh Anah tanu Aholibamah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiaite Dishon tate ahi uh: Hemdan, Esban, Ithran leh Cheran.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiaite Ezer tate ahi uh: Bilhan, Zaavan leh Akan.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiaite Dishan tate ahi uh: Uz leh Aran.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiaite Horte heutute ahi uh: heutu Lotan, hetu sobal, hetu Zibeon leh heutu Anah.
  </para>
  <para style="p">
    <verse number="30" style="v" />Heutu Dison, heutu Ezer leh heutu Dishan. Hiaite Seir gam a heutu a hih dan bang a Horte heutute ahi uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiaite kumpipa kuamah in Israel suante tung a vai a vaihawm ma ua, Edom gam a vaihawm kumpitate ahi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Beor tapa Bela in Edom gam ah vai a hawm a, a khopi min Dinhabah ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Bela a si a, Bozrah khua a mi Zerah tapa Jobab in a sik in vai a hawmta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jobab a si a, Timante gam a mi Husam in a sik in vai a hawmta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Husam a si a, Bedad tapa Hadad, Moab pawn a Midiante thatpa’n a sik in vai a hawm a, a khopi min Avith ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hadad a si a, Masrekah mi Samlah in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Samlah a si a, Luipi gei a Rehoboth khua a mi Saul in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Saul a si a, Akbor tapa Baal hanan in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Akbor tapa Bal hanan a si a, Hadar in a sik in vai a hawm a, a khopi min Pau ahi. A zi min Mehetabel ahi a, amah Mezahab tanu Matred tanu ahi
  </para>
  <para style="p">
    <verse number="40" style="v" />Hiaite a inkuan uh bangzel leh a mun bangzel uh leh a min bangzel ua Esau suan heutute min ahi. Heutu Timnah, heutu Alvah leh heutu Jetheth.
  </para>
  <para style="p">
    <verse number="41" style="v" />Heutu Aholibamah, heutu Elah, heutu Pinon.
  </para>
  <para style="p">
    <verse number="42" style="v" />Heutu Kenaz, heutu Teman, heutu Mibzar.
  </para>
  <para style="p">
    <verse number="43" style="v" />Heutu Magdiel leh heutu Iram. Hiaite a gam neih uah a omna uh bangzel in Edom suan heutute ahi uh. Edomte pa Esau ahi.
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jakob bel a pa mikhual a, a omna gam, Kanan ah a teng hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiaite Jakob suante ahi uh. Joseph, kum sawmlehsagih a upa a hih in, a ute toh ganhon a khah uhi. Amah naupang a hilai a, a pa zite Bilhah leh Zilpah tapate kiang ah a om a; Joseph in a gitlouhna thu uh a pa uh kiang ah a tun hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel in Joseph, a teklam ta a hih ziak in a tate tengteng sang in a itzaw a; puanaktual ze tuamtuam a gial a bawlsak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A pa un amah, a u tengteng sang in a itzaw chih a ute’n a thei uhi; amah a mudah ua, kampha himhim in a houpih thei takei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Joseph in mang a nei a, a ute a hilh a, amah a mudah semsem uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman, a kiang uah, “Hehpih in ka mang ngai dih uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai un, lou ah buhphalte i na gak ua, ngai dih uh, kei buhphal a thoutou a, ading nemnom hi. Ngai un, nou buhphalte’n a hongum ua, kei buhphal ma ah a kun chiat uh” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ute’n a kiang ah, “Nang soplai in ka tung uah vai na hawm mahmah ding maw? Nang soplai in ka tung uah thu na nei mahmah ding maw?” a chi uh. Huchi in, a mang ziak in amah a mudah semsem uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mang dang a neinawn a, a ute a hilhnawn hi, “Ngai un, mang ka neinawn hi. Ni, kha leh aksi sawmlehkhatte ka mai ah a kun uhi,” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A pa leh a ute a hilh hi. A pa’n a tai a, a kiang ah, “Mang na neih bangchi mang ahia? Kei leh na nu leh na ute leisi in na mai ah ka kun taktak ding u maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A ute’n amah a haza ua; a pa’n bel a thugen a lungsim in a pai nilouh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A ute Sekem ah a pa uh ganhon khah in a hoh uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israel in Joseph kiang ah, “Na ute’n Sekem ah ahi maw ganhon a khah uh? Hongpai dih, a kiang uah k’on sawl ding” a chi hi. Huan aman, “Hiai ah ka om” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman a kiang ah, “Na ute a damdam na uhiam, ganhon leng a damdam na hiam va en inla, a tanchin uh hong hilh nawn in” a chi hi. Hebron guam a kipan a sawlkhia a, Sekem a vapha hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi kuahiam in amah a mu a, ngai in, pawn ah a vakvak hi. Huai mi’n, “Bang zong na hia?” chi’n, a dong hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman, “Ka ute zong ka hi. Hehpih in ganhon a khah na uh honhilh ve” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai mi’n, “Hiai a kipan pawt hive un, Dothan ah i hoh ding uh, a chih uh ka za” a chi hi. Joseph in a ute a delh a, Dothan ah a va mu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amau gamlapi a kipan a na galmuh ua, a kiang nai uh a tunma in, amah thah a na sawmkhin uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau, “En un, mangneipa a hongpai.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hong un, i that dia, kawkhuk khat ah i khe ding uh. Gamsa gilou in a ne, china ni. A mangte bangchibang in a om a, chih i thei mai ding uh” a kichi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben in huai a naza a, a khut ua pan a honkheta hi. “Thah zaw i that hial kei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Reuben mah in a pa uh kiang a, a pitheihna dia, a khut ua pan a hotkhiak theihna ding in, a kiang uah, “Sisan zaw suahkei un, gamdai ah kawkhuk ah khia un, khut zaw a tung ah kha kei un” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichi ahi a, Joseph a ute kiang a tun in, Joseph puanaktual ze tuamtuam a gial a silh, a na suahsak uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amah a pi ua, kawkhuk ah a kheta uhi. Huai kawkhuk a vuak ahi a, tui om nawnlouhna ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />An ne ding in a tu chiat ua, a dak ua, a en ua, ngai in, Ishmael khualzin mite Gilead gam a kipan a sangawngsau ua thil gimnamtui, singnai damdawi leh murra pua in Aigupta gam a paisuk dingte a hongpai uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah in a unaute kiang ah, “I naupa uh i thah ua, a sisan suak i im un bang phattuamna om ding ahia?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hong un, a tung a khut khalou in, Ishmaelte kiang ah i zuak zaw ding uh. Amah lah i nau uh, i sa ngeingei uh lah ahi ngal a” a chi hi. A unaute’n a thu a zuita uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Midian sumsinmite a hongpai ua; Joseph kawkhuka kipan a kaikhia ua, Ishmaelte kiang ah Joseph dangka sawmnih in a khawngta uhi. Amau Joseph Aigupta gam ah a pi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Reuben kawkhuk ah a hongpai nawn a, Ngai in, Joseph kawkhuk ah a na omta kei hi. A puansilhte a botkekta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A naute kiang ah a hoh nawn a, “I nau uh a om nawn kei. Kei koi a paita ding ka hia oi?” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Joseph puanaktual a la ua, keltal a gou ua, a si ah a puanaktual a diah uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huai puanaktual ze tuamtuam a gial a khak ua, a pa uh kiang ah a honla ua; “Hiai lel ka mu ua, na tapa puanaktual ahi hia, hilou, en mah dih” a chi uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman a na theipah a, “Ka tapa puanaktual eive. Gamsa gilou in ne eive. Joseph bohnen vek a om hi mahmah ding eive’ a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jakob in a puansilhte a botkek a, saiip puan a teng a, ni tamtak a tapa a sun hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />A tapa tengteng leh a tanu tengteng amah lungmuan ding in a thou ua; himahleh amah lungmuan a utkei. “Sunkawm in han ah ka tapa kiang ah ka paisuk ding,” a chi hi. Amah ngai in a pa a kap hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Midiante’n Aigupta gam ah Joseph a lutpih ua, Pharo nuai a heutu khat, vengmi pawl heutu Potiphar kiang ah a zuak uhi.
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai in, hichi ahi a, Judah a unaute kiang a kipan a paisuka, Adullam mi khat a min Hirah a vabel hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Judah in huai ah Kanan mi khat tanu a min Shuah a mu a; a kitenpiha, a luppihta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in a gaia, tapa a nei a; Judah in a min Er a sa hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A gai nawn a, tapa a neinawn a; a nu’n a min Onan a sa hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tapa a neinawna, a min Shelah a sa a; amah a neihlai in Judah Kezib khua ah a om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah in a ta masa Er ading in zi a pisak a, a min Tamar ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Judah ta masa Er Toupa mitmuh in a gilou a; Toupa’n amah a that hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah in Onan kiang ah, “Na u zi luppih in kitenpih inla, na u ading in chi suahsak in” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Onan in chisuah ding pen amah suan ahi kei ding, chih a thei hi. Hichi ahi a, a u zi a luppih teng in a u adia chi a suahsak louhna ding in a chi lei ah a kesak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A thilhih in Toupa a lungkim sakkei a, huaiziak in amah leng Toupa’n a that hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Judah in a mounu Tamar kiang ah, “Ka tapa Shelah a pichin mateng na pa inn ah meithai in va omtadih in” a chi hi. Huchilou in zaw amah leng a ute bang in a si kha ding, a chi hi. Huchi in, Tamar a pai a, a pa inn ah a va omta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A nung in Shuah tanu Judah zi a si a; Judah a hong khamuan in Timnah khua ah a belam mulmette kiang ah a lawm Adullam mi Hirah toh a hohtou uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi’n Tamar, “Na pasal pa a belam mulmet ding in Timnah khua ah a hohtou” chi in, a hilh uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pasal sunna puansilhte a suah a, kikhuhnapuan in a kikhuh a, a kituam bikbek a, Timnah khaw lampi ah Enaim kulhkongpi ah a na tu hi. Shelah a pichingta ngal a, a pa’n a zi ding in amah a pisak kei, chih a thei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Judah in amah a muh in kizuak hi’n teh a chi a; a mai lah a kikhuh bikbek ngal a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lampi gei a huai numei a va zuan a, “Kisa in, hehpih in i lumkhawm ding” a chi hi. A mou mah ahi, chih a thei ngalkei a. Aman, “Hon luppih leng bang n’on pedia?” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman, “Ganhon lak a kipan kelnou k’on khak ding” a chi hi. Aman, “Huai n’on khak ma in kichiamna bang n’on pedia?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman, “Kichiamna bang k’on pedia?” a chi hi. Aman, “Na min sawnna leh na taute leh na chiang” a chi hi. Huchi in hiaite a pia a, a luppih a, amah a kipan nau a paita hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A thou a, a kikhuhnapuan a suah a, a meithai puansilhte a silh nawnta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judah in a kichiamna numei khut a kipan la ding in a lawmpa Adullam mi khut ah kelnou a khak a, himahleh aman huai numei a va muzouta kei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in, numei omna mun a mite kiang ah, “Lampi gei a Enaim a kizuaknu koi a om ahita a?” chi’n a dong hi. Amau, “Kizuak hiai ah a omkei” a chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in, Judah kiang ah a kiknawn a, “Amah ka muzou kei. A mun a mite’n leng kizuak mawngmawng hiai ah a omkei a na chi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Judah in, “Aman neiden mai hen, huchilou in zaw i zahlak kha ding. Ngai in, hiai kelnou khak ing a, amah lah mu zoulou chi in a” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kha thum vel nung in mi’n, “Judah, na mounu, Tamar kizuak ve aw; huai lou leng, ngai in, sawn a pai hi” chi’n, a hilh uh. Judah in, “Pikhia unla, hallup in om hen” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A pikhiak uleh, Tamar in, “Hiai thilte neipa a kipan ahi nau ka pai” chi’n, a pasal pa kiang ah mi a sawl hi. Amahmah in, “Hehpih in hiai min sawnna, taute leh chiang, kua a ahia, enchian ding in ka hong thum” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah in huai thilte amah a ahi, chih a na thei hi. “Kei sang a amah diktat zaw ahi. Ka tapa Shelah lah amah toh ka na kiteng sakta kei a” a chi hi. Huchi in Judah in amah a luppih nawn hetkei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nau a veilai in hichi ahi a, ngai in, a sul ah phik a na om uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichi ahi a, nau a veilai in khat in a khut a hon golhkhia a; naudommi in, “Hiai a pawt masa zaw ahi” chi’n a na len a, a khut ah khau san a bunsak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hichi ahi a, a khut a laklut nawn lai in, ngai in, a lamet louhpi in a unau a hong pawtkhia hi. Naudommi in, “Bangchidan a nang hon phusuak mawk na hia? Nang a mawh khu in” a chi hi. Huaiziak in a min Perez a sa uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai nung in a unau, a khut a khau san bun pen a hongpawt nawn a, a min Zerah a sa uhi.
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Joseph Aigupta gam ah a pisuk ua; Pharo nuai a heutu khat, vengtu pawl heutu, Aigupta mi, Potiphar in a hon pisuk Ishmaelte khut a kipan a leita hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa Joseph kiang ah a om a, amah mi lohching tak ahi a; a pu Aigupta mi inn ah a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pu in, Toupa a kiang ah a om a, a thilhih peuhmah Toupa’n a khut ah a lohchingsak, chih a thei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Joseph in a pu deihsakna a mu a, a inn ah nna a semzel hi. Aman a inkuante tung ah heutu in a bawl a, a neih tengteng a khut ah a koihvek hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichi ahi a, a inn leh a neih tengteng tung a heutu dia a bawl nungsiah Joseph ziak in Toupa’n Aigupta mi inn sung a vualzawlta hi. Inn lam leh gam lam a a neih tengteng ah Toupa’n a vualzawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in a neih tengteng Joseph khut ah a koih a, a neih teng, a annek kia lou ngal a theipih kei hi. Joseph pianhoih leh melhoih tak ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai nung in hichi ahi a, a pu zi in Joseph a ngaih et a; “Hon luppih in” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh a utkei a, a pu zi kiang ah, “Ka pu in hiai inn ah ka kiang ah bangbang a om a chih lah a thei ngalkei a, a neih tengteng ka khut ah a koihvek hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiai inn sung ah kei sang a lian zaw kuamah a omkei. A zi na hih ziak in nang kia loungal, kei a kipan bangmah it a neikei hi. Bangchi’n hiai khelhna liantak hih in Pathian tung ah thil ka hihkhial thei dia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hichi ahi a, niteng in Joseph houpih zel mah leh amah luppih lamthu hiam, amah kiang a om lamthu hiam a limsak nuam kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchih lai in hichi ahi a, a nna sem ding in inn sung ah a va lut a; inn sung ah mi himhim kuamah a omkei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in aman, “Hon luppih in” chi in a puansilh in a na man a, aman a puansilh a khut a nusia in a taikhia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichi ahi a, a puansilh a khut a nusia in a taikhia, chih a theihtakin,
  </para>
  <para style="p">
    <verse number="14" style="v" />A inn a mite a sam a, a kiang uah, “En un, hon zahlaksak ding in Hebru mi khat i kiang ua honpi eita ve. Hon luppih tum in ka kiang ah a honglut a, Huchi in ngaihtak in ka kikouta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichi ahi a, aw suah a ngaihtak a ka kikou a zaktak in hiai ka kiang ah a puansilh a nusia a, a taikheta” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph pu a hongtun masiah a puansilh a kiang ah a na koih gige hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kiang ah hiai thu a na gen a, “Hebru sikha i kiang a na honpi in hon zahlaksak tum in ka kiang ah a honglut hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichi ahi a, aw suah a ka kikou tak in hiai a puansilh ka kiang a nusia in a taikheta” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hichi ahi a, Joseph pu in a zi in a kiang a, “Na sikha in hichi’n a honbawl” chi a, a thugen a zak in, a hehna a kuang hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in, Joseph pu in amah a pi a, suangkulh, kumpi suangkulhtangte khumna mun ah a khum a; huchi in suangkulh ah a omta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh Toupa Joseph kiang ah a om a, a tung ah a zahngai a, suangkulh vengmi a hehpih sak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in, suangkulh vengmi in suangkulh a tang tengteng Joseph khut ah a kemsakta hi. Huchi in, huai a, a hih peuhmah uh Joseph hih ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa Joseph kiang ah a om a, a thilhih peuhmah Toupa’n a lohchin sak ziak in suangkulh vengmi in a khut a thil om himhim a enta kei hi.
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, huai thilkhit in hichi ahi a, Aigupta kumpipa uain pepa leh a tanghou bawlpa’n a pu uh Aigupta kumpipa a lungkim sakkei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pharo a sikha heutu nihte tung ah, a uain pia heutupen tung ah leh a tanghou bawl heutupen tung ah a hehta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in vengmi pawl heutu inn ah, suangkulh, Joseph hen a a omna ah, a tangsakta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Vengmi pawl heutu in amau Joseph a kemsak a, amau a na a sepsak ua, ni bangzah hiam tak a tang uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Suangkulh a hen a om, Aigupta kumpipa uain pepa leh tanghou bawlpa in zan khat mangkhiakna tuam tuak a nei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A zing in Joseph a kiang uah a valut a, amau a hong mu ua, ngai in, a na lungkham mahmah uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman, “Bangchi na hi ua, tuni in lungkham mel paw natel u chia?” chi’n Pharo sikha heutu suangkulh a tangte a dong hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amau a kiang ah, “Mang ka neituak ua, hon hilhchiansak thei kuamah lah a om ngalkei a ahi” a chi uh. Joseph in a kiang uah, “Mang hilhchetnate Pathian a ahi ka hia? Hehpih in na a mang uh honhilh un” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in, uain pia heutupen in a mang Joseph a hilh a, a kiang ah, “Ngai dih, ka mang in, ka ma ah grepgui a hongom hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Grepgui ah ka thum a om a, a hong selnou ua, a hongpak ua, a pakbomte’n grep minte a hon omsak uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharo nou ka khut ah a hongom a; grep gahte ka lou a, Pharo nousung ah ka suk a, huai nou Pharo khut ah ka na pia” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in a kiang ah, a hilhchetna hiai ahi. “Ka thumte ni thum ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tu a kipan ni thum in Pharo in na lutang a domkang ding a, nna nasep mah a hon semsak nawn ding. A uain pepa na hihlai a, na piak ngeina bang in Pharo nou a khut ah na pe nawn ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh na hong hamphat chiang in hon theigige inla, hehpih in hehpihna ka tung ah hon kilang sak inla, Pharo kiang ah ka tungtang hon gen inla, hiai in a kipan hon pikhia in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hebrute gam a kipan mi’n a guk a, a hon gukmang uh ka hi a; hiai gam ah leng khuksunga a hon khumna ding in bangmah ka hih khial kei” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tanghou bawlpa in hilhchetna a hoih chih a theih in, Joseph kiang ah, “Ken leng mang ka nei a, ngai in, lawhbeu thum ka lu in ka na pua hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lawhbeu tungnungpen ah Pharo an, tanghou bawlpa bawl, chichih a na om hi. Huaite vasate’n lawhbeu ka lu a ka puaka kipan a na ne souhsouh uh,” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph in a dawng a, “Hiai a hilhchetna ahi. Lawhbeu thum ni thum ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tu a kipan ni thum in Pharo in na pumpi a kipan na lutang a dom kang dia, singdawn ah a khai ding. Huchi in, vasate’n na sa a ne souhsouh ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichi ahi a, a ni thum ni, Pharo pian champha ni’n, aman a sikha tengteng ading in Ankuang a lui hi. A sikhate lak a uain pia heutupen lutang a domkangta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Uain pia heutu pen uain pemi mah in a pangsak nawn a; Pharo khut ah nou a peta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh Joseph in amau a hilhchet bangtak in, tanghou bawl heutupen a khailumta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh, uain pia heutu pen in Joseph a theigige kei a, a mangngilhta hi.
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan kum nih vingveng nung in hichi ahi a, Pharo in mang a nei a; ngai in, luigei ah a na ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai in, bawngpi sagih hoihtak tak, thautak tak tui a kipan a hong pawtkhe tou ua, loupa nou lak ah a hongta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai in, bawngpi dang sagih kil theuthou, gawng gemgom a hong pawtkhe nawn ua, bawngpi dangte kiang ah luigei ah ading uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawngpi kil theuthoute’n bawngpi hoihtak tak, thau taktakte a negai maimah uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in, Pharo a khanglou a, a ihmu nawn a, mang a nei nawn hi. Ngai in, buhkung khat ah a vui sagih lian pipi, hoih liahliah a hongom khia hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai in, huai nung in vui sagih ngat giuhgeuh suahlam huih in a nuai ek a hong omkhe nawn hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A vui ngat giuhgeuhte’n a vui sagih lian pipi, hoih liahliahte a valhkhin maimah uh. Huchi in Pharo a khanglou a; ngai in, mang a na hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zing in hichi ahi a, a lungsim a buai mahmah a; mi a sawl a, Aigupta gam a mitkhialdawi siam tengteng leh mi pil tengteng a samkhawm hi. Pharo in a mang amau a na hilh a; himahleh Pharo mangte hilhchian thei kuamah a omkei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchih lai in uain pia heutupen in Pharo kiang ah, “Tuni in ka khelhna ka thei khia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khatvei Pharo a sikhate tung ah a heh a, huchi in vengmipawl heutu inn ah kei leh tanghou bawl heutupen a hon tangsak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kei leh aman zan khat mang ka nei ua, mang khiakna tuam tuak ahi ka mat uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai ah ka kiang uah vengmi pawl heutu sikha, Hebru mi, tangval khat a om a; amah ka hilh ua, aman ka mangte uh a hilhchianta hi. Ka mang bang tuaktuak un a hon hilhchet sak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hichi ahi a, kei ka nasep mah a hon semsak nawn a, amah a khailumta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pharo in Joseph a samsak paha, kintak in suangkul a kipan a pikheta uh. Amah a kimet ngil a, a puansilh a khek a, Pharo kiang ah a va lutta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pharo in Joseph kiang ah, “Mang ka nei a, a hilhchian thei kuamah a omkei uh. Nang mang thu na theih leh na hilhchian thei chih na tungtang mi gen ka naza” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph in Pharo a dawng a, “Huai ahihleh kei a om ahi kei hi. Pathian in Pharo lungkimhuaitakin a dawng zaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pharo in Joseph kiang ah, “Ka mang in, ngai in, lui gei ah ka na ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai in, bawngpi sagih thau taktak, hoih pipi tui a kipan a hong pawtkhe tou ua, loupa nou lak ah a hongta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bawngpi dang sagih ginalou leh deihhuai lou leh gawng siatsuat, huchibang tel a hoihlou Aigupta gam tengteng a leng ka muh ngeilouh, a nung uah a hong pawtkhe tou nawn uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bawngpi gawng siatsuat deih huailou pipite’n bawngpi sagih thautak tak hongpawt masate a negai maimah uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />A nekgaih khitnung un leng, a ne uh chih a kithei tuankei hi. A tunglai mah bang in deihhuailou tak in a om lailai uhi. Huchi in ka khanglouta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka mang in, ngai in, buh kung khat ah vui sagih lian pipi, hoih pipi a hong vuikhia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngai in, huai nung in vui sagih vuai ningniang, neuchik chik, suahlam huih in a nuai a hong vuikhe nawn hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A vui ngat ngiungeute’n a vui sagih hoihtaktakte a valhkhit maimah uh ka mu hi. Mitkhialdawi siamte ka hilh a, himahleh a hon hilhchian thei kuamah a omkei uh” chi’n, a gen hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph in Pharo kiang ah, “Pharo mang khat ahi. Pathian in hihdia a kisak Pharo theisak ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Bawng sagih hoihtaktakte kum sagih ahi ua; vui sagih hoihtaktakte leng kum sagih mah ahi uh. Mang khat ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A nung ua bawng sagih tektaktak, deihhuailou taktak hongpawt khetoute kum sagih ahi ua, vui sagih a hawm ngen suahlam huih nuaite toh; huaite kial kum, kum sagih ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai ahi Pharo kiang a ka gen. Pathian in hihdia a kisak Pharo kiang a theisak ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai in, Aigupta gamsung tengteng ah niang leh tai a om kum, kum sagih a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai nung in kial kum, kum sagih a hongom nawn ding. Huchi in niang leh tai a omna Aigupta gam ah mangngilh vek ahita ding. Kial in gam a negawp vek ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Niang leh tai kum honzui kial a thupi mahmah ding ziak in mite’n hiai gam hauhsaklai hun a thei nawnta kei ding uh;.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pharo mang nihvei a neihtuan sakna ahihleh hiai ziak ahi. Thilhih ding Pathian in a hihkip a, Pathian in a tungsak pah ding.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tuin Pharo in mi khat, teitak leh piltak zongkhia henla, Aigupta gam tung ah heutu in omsak hen.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pharo in hiai hih hen. Gam tung ah heutute sep henla, niang leh tai a om kum, kum sagih sung Aigupta gam buh mun nga a khen, mun khat zel kaikhawm hen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amau huai kum hoih kum hongtung ding a buh tengteng kai khawm in Pharo nuai a om ding in khuate ah tunung a nek ding in buh sungkhawm henla, kholkhawm hen.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kial ziak a gam a manlouhna ding in, buh kial kum, kum sagih Aigupta gam a hongtun hun a ding in hiai gam adia kiginkholhna ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huai thu Pharo leh a sikha tengteng in hoih a saklam tak uh ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pharo in a sikhate kiang ah, “Hichibang Pathian kha omna mi i muzou ding ua hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Pharo mah in Joseph kiang ah, “Pathian in hiai tengteng hon theihsak ziak in, nang bang a tei leh pil himhim a omkei uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nang ka inn kawte tung ah heutu in na om ding a, ka khua leh tui tengteng na thu bangzel in a om ding uh. mangtutphah a tut thu ah kia nang sang in ka lianzaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Pharo mah in Joseph kiang ah, “En in, Aigupta gam tengteng tung ah heutu in k’on bawl hi” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Pharo in a khut a kipan a min sawnna zungbuh a tolkhia a, Joseph khut ah a bunsak a, puanmalngat a bawl puansilhte a silhsak a, a ngawng ah dangkaeng khainiang a oksak hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A kangtalai neih nihna ah a tuangsak a; a ma ah khukdin un, chi’n, mi a kikousak hi. Huchi in, Aigupta gam tengteng tung ah heutu in a bawlta hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Pharo in Joseph kiang ah, “Kei Pharo ka hi, na thu lou in Aigupta gamsung tengteng ah kuamah in a khut uh hiam, a khe uh hiam a likkei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Pharo in Joseph min Zaphnath paneah a sa a; On khaw siampu Potipher tanu Asenath a zi ding in a pia hi. Joseph a pawt a, Aigupta gam a siksuak hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Joseph Aigupta gam kumpipa Pharo ma a a dinlai in kum sawmthum a upa ahi. Joseph Pharo a kipan a pawt a, Aigupta gam tengteng a siksuak hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hauh kum, kum sagih sung, lei in buh tampi a tungsak hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Aigupta gam a hauh kum, kum sagih a hongtung a, buh tengteng a dongkhawm a, huai buhte khuate ah a sungkhawmta hi. A kim a om khochih lou a buhte a sungkhawm chiat hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Joseph in buh tampi tuipi piaunel zah bang in a sungkhawm venvon a, a sim leng a tawphial hi; simzoh vuallouh ahihtak ziak in.
  </para>
  <para style="p">
    <verse number="50" style="v" />Kial hongtun ma in Joseph in tapa nih a nei a, huaite On khaw siampu Potipher tanu Asenath in a neihsakte ahi uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Joseph in a tapa masa min Manasseh a sa a; “Pathian in ka sepgimna leh ka pa inn sung mite tengteng a hon mangngilh sakta” a chi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />A tapa nihna min Ephraim a sa a; “Pathian in ka gimthuakna gam ah chi a hon suangsakta” a chi hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Hauh kum, kum sagih Aigupta gam a hongtung a beita hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Kial kum, kum sagih ding, Joseph gen bang in a hongtung panta hi. Gamchih ah kial a hong keta a; Aigupta gamsung teng ah bel nekding a om hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Aigupta gam a mi tengteng a kial tak un, Pharo kiang ah nekding ngen in a kikou uhi. Pharo in Aigupta mite kiang ah, Joseph kiang ah hoh unla; na kiang ua a gen peuhmah hih un, a chi hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Leitung pumpi ah kial a keta hi. Joseph in sunkhawmna buhinte a hong a, Aigupta gam ah leng kial a nakkiak mahmah hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Leitung pumpi a kial a nakkiak ziak in gamchih a mite buh lei ding in Aigupta gam ah Joseph kiang ah a hongzel uhi.
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Jakob in Aigupta gam ah buh a om, chih a thei hi. Jakob in a tapate kiang ah, “Bangdia ki en maimah na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amahmah in, “Ngai un, Aigupta gam ah buh a om, chih ka za hi. Silou a i hinkhiak theihna ding in huai ah va hohsuk unla, huai a kipan ei ading in valei un” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Joseph unau sawmte Aigupta a buhlei ding in a hohsuk uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joseph nau Benjamin Jakob in a ute kiang ah a hohsak kei hi. Tuahsia a va tuak kha ding, a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel tapate mi hohte lak ah buh lei ding in a hoh ua; Kanan gam ah leng kial a ke ngal a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Joseph Aigupta gam tung ah heutu ahi a; amah huai gam mi tengteng kiang a buh zuakpa ahi. Joseph ute a hongpai ua, leisi in a mai ah a kun uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joseph in a ute a na mu a, amau a na theilai hi. Himahleh a kiang uah midang bang in a kibawla, khauhtak in amau a houpih hi. A kiang uah, “Koi a kipan a hong na hi ua?” a chi hi. Amau, “Buh lei dia Kanan gam a kipan hongpai ka hi uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph in a ute a theilai a, amau bel amah a theikei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joseph in amau tungtang thu, manga a matte a theikheta hi. A kiang uah, “Enkhemite na hi uh. Gam venlouhna munte en dia hong kuan na hi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amau a kiang ah, “toupa, hilou e, na sikhate buh lei dia hong kuan ka hi uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi khat ta vek ka hi ua, mi diktak ka hi uh. Na sikhate enkhemite ka hi zenzen kei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman a kiang uah, “Ka taksang kei, gam venlouhna munte en dia hongpai hi mah uteh” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amau, “Kou na sikhate unau sawmlehnih, Kanan gam a om, mi khat tate ka hi uh. Ngai in, ka nautumpen uh tuin ka pa uh kiang ah a om hi. Khat pen ahihleh a om nawnta kei hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph in a kiang uah, “Enkhemite na hi uh k’on chih na hi mahmah uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichibang a ettel in na om ding uh. Na nautumpen uh hiai a, a hongpai keileh Pharo hinna a kichiam in hiai a kipan na pawtkhe kei ding uh, k’on chi ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nou ah thutak a om hia, omlou chetna ding in na lak ua khat sawl unla, na nau uh honpi hen. Nou bel hen in na om phot ding uhi. Huchilou in zaw Pharo hinna a kichiam in, enkhemite na hi mahmah uh, k’on chi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in avek un ni thum a tangsak chiat hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ni thum ni’n Joseph in a kiang uah, “Hichi’n hih le uchin na hing ding uh; Pathian ka lau hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Midiktat na hih uleh na unau lak uah khat na suangkulh tanna in uah hen in om hen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na nautumpen uh ka kiang ah honpi un. Huchi in na thu uh a tel dia, na sikei ding uh” a chi hi. Huchibang in a hihta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau, “I nau tung a i thilhih uh mawh petmah i hi, hehpih dia a honnget ngutngut lai a, a lungtang mangbat dan mu napi a, i ngaihkhiak saknop louh uh. Huaiziak in hiai mangbatna in hon buak ahi” a kichi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Reuben in, “Naupang tung ah thil hihkhial kei un, chi’n, na kiang uah ka gen kei maw? Na ngaikhe nuam kei ua ahi. Huaiziak in, ngai un, a sisan phu i tung ua lak ahi tave” chi’n, amau a dawng hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kal ua pauletmi a om ziak in Joseph in a thugen uh a thei chih a theikei uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman amau a lehngatsan a, a kapta hi. A kiang uah a hong kiknawn a, amau a houpih a, a lak ua pan Simeon a pituam a, a mitmuh un a henta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph in a ipte uh buh a hihdim ding leh a dangkate uh a ip ua koih nawnchiat ding in leh lampi a nekding pe ding in thu a pia hi. Huchi in huchibang in a hihsakta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A buh uh a sabiltungte a pawsak ua, huai a kipan a pawtkheta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A lak ua mi khat in a giahbuk ua a sabiltung an pedia a ip a hon leh, a dangka a muta hi. Ngai in, a ip gongbul ah a na om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A unaute kiang ah, “Ka dangka na koihnawn uh hi ve e. Ngai un, ka ipsung ah a na om hi” a chi hi. A lunglel ua, “Pathian in hichibang a eite a honbawl bangchidan a diam aw?” chi’n, ling kawm in a ki entuah uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kanan gam a a pa uh kiang a hongtung ua, a tung ua thil tung tengteng a hilh uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Huai mi, a gam heutupa un, khauhtak in a hon houpih a, enkhemite ding in a honkoih hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kou a kiang ah, mi diktak ka hi uh. ‘Enkhemite ka hi zenzen kei uh.’
  </para>
  <para style="p">
    <verse number="32" style="v" />Unau sawmlehnih ka hi ua, ka pa uh tapate ka hi vek uh. Khat a om nawn kei a, ka nautumpen uh tuin Kanan gam ah ka pa uh kiang ah a om” ka chi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai mi, a gam heutupa un, ka kiang uah, “Hichi’n midiktak na hi uh chih k’on thei ding. Na unau khat uh ka kiang ah nusia unla, na inkuanpih kialte ading in buh pua unla, paita un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na nautumpen uh ka kiang ah honpi un. Huchi in enkhemite na hi kei ua, midiktak na hi zaw uh, chih ka thei ding. Huchi in na unaupa uh k’on penawn dia, hiai gam ah sum na sinta ding uh” a honchi, a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichi ahi a, a ipte uh a butkhiak lai un, ngai in, a dangka tunchiat uh a ip uah a na omchiat hi. Amau leh a pa un a dangka tunte uh a muh un a lau mahmah uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />A pa uh Jakob in a kiang uah, “Noute’n ka tate hon tansak na hi uh. Joseph a om nawn kei. Simeon lah a om nawn kei, Benjamin nasan lah pimang na tum nawn uh. Hiai thil tengteng in honkiak khum eita ve” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuben in a pa kiang ah, “Na kiang a k’on pi kiknawn kei leh ka tapa nihte that mai in. Amah ka khut ah hon kemsak inla, na kiang ah k’on pi kiknawn mai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman, “Ka tapa na kiang uah a hongsuk kei ding. A u a sita a, amah kia lah ahita ngal a. Na paina lam lak ah tuahsia tuak leh ka lu kang lungkhamna in han ah na tumsak ding uh” a chi hi.
  </para>
  <chapter number="43" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, huai gam ah kial a nakkiak mahmah hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hichi ahi a, Aigupta gam a kipan a buh puaktouh uh a nekgaih nung un, a pa un, a kiang uah, “Kuan nawn unla buh tawmchik bek ei ading in valei nawn un” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in, Judah in a kiang ah, “Huai mi’n, na nau uh n’on tonpih kei uleh, ka mel na mu kei ding uh, chi’n, honkalh ngiungeu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka nau uh n’on zuihsak ding leh, buh k’on va leisak ding uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />N’on zuihsak keileh zaw, ka hohkei ding uh. Huai mi’n ka kiang uah, Na nau uh n’on tonpih kei uleh, ka mel na mu kei ding uh, a chita ngal a” chi’n a gen hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel in, “Bangziak in ahia nau dang na neihlai tantan na hilh chitchiat uh? Kei adia hoihlou na hih uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amau, “Huai mi’n, na pa uh hinglai hia? Unau dang na neilai uhia? chi’n, i tanchin leh i tanaute tanchin a hon dong hi. A hon thudot bangzel in ka hilh uhi. Na nau uh hon pisukun, a chi ding chih kuan a thei chitchiat dia?” a chi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah in a pa Israel kiang ah, “Ka nau uh hon zuisakin. Huchi in ka kisa ding ua, ka kuan ding uh. Kou leh nang leh ka ta neu chikchikte u leng silou a i hin theihna ding un.
  </para>
  <para style="p">
    <verse number="9" style="v" />A tungtang thu keimah in bultum na ning. Ka khut a kipan mahmah ah amah honphut in. Amah na kiang a ka honpi kiknawn kei a, na ma a k’on dinsak nawn kei leh, a mawh tangtawn in ka paw ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Om sawtlou hile ung, a nihveina hongtung nawn khinta ding hi ung” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pa uh Israel in a kiang uah, “Huchibang a hih vanglak leh hichi’n hih un. Na seng un hiai gam a thil hoih khenkhat singnai damdawi, khuaizu, gimnamtui, Murra, theihawksek leh makha gah, neukha chiat huai mi ading thilpiak tawisuk un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dangka a mun nih in tawi unla, na ip gongbul ua a hon dangka piak nawn leng tawi nawn un; a muhkhelh ahi kha ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na nau u leng pi unla, thou unla, huai mi kiang ah va hoh nawn un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na unau khat pen uleh Benjamin a hon khahsakna ding in Pathian bangkim hihthei in huai mi hon hehpihsak hen. Ka tate tan ahihleh tan ka himai kei ding hia” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in, thilpiak a tawi ua, dangka leng a mun nih a tawi ua, Benjamin leng a pi uhi. A thou ua, Aigupta gam ah a hohsuk ua, Joseph ma ah ading nawn uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph in Benjamin a kiang ua om a muhtak in, a inn kemmi kiang ah, “Huai mite inn sung ah pilut inla, sa gou inla, bawl in, huai mite’n sun chiang in ka kiang ah an a ne ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in, aman Joseph thupiak bang in a hihta a; Joseph inn ah a pilutta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph inn a pilut a, a om ziak un a lau ua, “I hoh masak lai a, i ip ua dangka hong kiknawnte ziak in eive a hon pilut uh. I tung ua siatna zong a, honsual in, ei leh i sabiltungte toh sikha dia hon mattum eive,” a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Joseph inn kemmi kiang ah a va hoh ua, kongbul ah a houpih uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Pu aw, ka hong masak lai ua buh lei ding lel a hongsuk ka hi uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hichi ahi a, giahbuk ka tun un ka ipte uh ka hong ua, ngai in, ka dangka chiat uh ka ip gongbul uah a na om hi. Ka dangka uh a buk ngeingei in a na om a, huchi in ka hontawi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Buh leina ding in dangka dang k’on tawi ua, ka dangka u lah kuan ahia ka ip ua koih ka thei ngalkei uh” a chi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman, “Lungmuangtakin om unla, lau kei un. Na Pathian, na pa uh Pathian in na ipte uah gou a honpia ahi maive. Na dangka ulah ka mungal a” a chi hi. Huchi in Simeon a kiang uah a hon pikhia hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai mi in Joseph inn sung ah amau a pilut a, tui a pia hi. A khe uh a sil ua; a sabiltungte u leng an a pia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A thilpiak tawi uh Joseph sun an ne dia a hongpai ma in a na bawlkhol uh; huai ah an a ne ding uh, chihlah a za uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Joseph a inn a, a hong paitakin, a khut ua thilpiak om inn sung ah, a kiang ah a tawilut ua, leisi in a mai ah a kun chiat uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman a tanchin uh a dong a, “Na pa uh tanchin na gen uh, huai putek a damdam na hia? A hing lai hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amau, “Na sikha ka pu uh a damlai hi, a hinglai hi” a chi uh. Huchi in a lu uh a kun sak ua, zahtakna a pia uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amah a dak a, a nau Benjamin, a nu tapa a mu a, “Hiai na nautumpen uh, a tanchin na honhilh uh hia?” a chi hi. Amahmah in, “Ka tapa, Pathian in hon hehpih hen” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Joseph in a nau a muh in a khase mahmah a, kintak in kahna ding mun a zongpah a, a dantan sung ah a lut a, huai ah a kap kheta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A mai a phiat a, a vapawt nawn a, a kidek teitei a, annek bawl un, a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in amah ading atuam in, amau ading atuam in, Aigupta mi a nekpihte ading atuam in a bawlta uhi. Aiguptate’n lah Hebrute a nekpih thei ngalkei ua; huchibang hihlah Aiguptate ading in thil sianglou ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in, a upapen tamasa a hihna bang in, a naupangpen nautumpen a hihna bang in Joseph ma ah a tu ua; huchi in lamdang a sa chiat uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Joseph in a ma a mite a kipan tantuan an a ban piaksaka, Benjamin tantuan houh amaute tantuan tengteng sang in a mun nga in a tam tuam hi. Uain a dawn ua, nuam a sa chiat uhi.
  </para>
  <chapter number="44" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, aman a inn kemmi kiang ah, “Huai mite ip in a puakzoh zahzah uh buh in dimsak inla, a dangka chiat uh a ip gong bul chiat uah koih in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka nou, huai dangka nou, a naupang penpa ip gong bul ah koih in, a buh man dangka toh” chi’n, thu a pia hi. Huchi in, aman Joseph thugen bang in a hihta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khua a vaktakin amau a sabiltungte utoh a paisakta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khua a kipan a paikhiak ua gamla a tunma un, Joseph in a inkemmi kiang ah, “Thou inla, huai mite va delh in. Na va phak chiang in a kiang uah, Bangchidana thil hoih, thil hoihlou a thuk na hi ua?
  </para>
  <para style="p">
    <verse number="5" style="v" />Huai ka pu uain dawnna leh a aisanna mahmah hilou ahi maw? Hichibang na hih uh na gilou uhi” chi in, a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A delhpha a, huai thute a kiang uah a gen hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amau a kiang ah, “Pu, bangchidan ahia hichi thu na gen? Na sikhate’n huchibang thil ka hihlouh ding dan uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ngai in, ka ip gongbul ua dangka ka muhte uh leng Kanan gam a kipan na kiang ah k’on tawi ve ua oi. Bangchidan in na pu inn a dangka hiam dangkaeng hiam ka gu thei maizen ding ua?
  </para>
  <para style="p">
    <verse number="9" style="v" />Na sikhate lak ah kuapeuh na muhna penpen si hen, kou leng ka pu uh sikha in ka om mai ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman, “Hi hen, na thu bangzel un hi hen. Himahleh kuapeuh k’on muhna penpen ka sikha in om hen. Nou ahihleh dembei na hi ding uh,” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaitak in amau ipchiat uh kintak in lei ah a ngakhia ua, amau ipchiat a hong uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman a upapen ah apan a, a naupangpen pha in a zong a; Huchi in Benjamin ip ah nou a muta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huaitak in a puansilhte uh a botkek ua, amau sabiltung chiat a pawsak nawn ua, khua ah a kiknawnta uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Judah leh a unaute’n Joseph inn a vapha ua; amah huai ah a na omlai hi. Huchi in a mai ah a khupboh chiat uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph in a kiang uah, “Bang thil ahi mai a na hih uh? Kei bang mi, aisan a siam teitei uh, chih na theikei ua hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Judah in, “Pu, na kiang ah bang ka genta ding ua? Bang k’on hilhta ding ua? Bangchibang in ka kigen vengta ding ua? Pathian in na sikhate tatlekna a mu kheta hi. Ngai in, pu, na sikhate ka hita mai uh. Kou leh a khut a nou a muhna pen uh leng” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman, “Huchibang a ka hihlouh ding dan. A khut a nou a muhna pen kia ka sikha in a om ding a, nou zaw lungmuangtakin na pa uh kiang ah paitouta un” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huaitak in, Judah in Joseph a vanaiha, “Pu aw, hehpih in, pu, kei na sikha, na bil a na zak ding in thu kam khat hon gensak inla, na hehna na sikha tung ah kuangsak ken. Nang lah Pharo bang hial na hita hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pu, nang, ‘Pa hiam unau hiam na nei uhia?’ chi’n, na sikhate na hondong hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pu, kou na kiang ah, ‘Pa putek tak leh a teklam a neih naupangchik, ka nei uh. Huai mi upa a sita a, a nu neih lak ah amah kia a omlai a, a pa’n lah amah a it mahmah hi’ ka chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang na sikhate kiang ah, amah pen ka mit a ka muh theihna ding in ka kiang ah hon pisuk un, na chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pu, kou na kiang ah, ka nau un a pa a nuse theikei ding; a pa paisan leh a pa a simai ding, ka chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nang na sikhate kiang ah, ‘Na nautumpen uh n’on tonpih kei uleh, ka mel na mu nawn kei ding uh’ na chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichi ahi a, na sikha ka pa uh kiang ka vatun un, Pu, na thu ka hilh uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka pa un, ‘Kuan nawn unla, buh tawmchik bek ei ading in va lei nawn un’ a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kou, ‘ka hohsuk thei nawn kei ding uh. Ka nautumpen uh a hongding leh bel ka hohsuk ding ua, ka nautumpen uh a hong keileh huai mi mel mu theilou ding ka hi uh’ ka chi uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na sikha ka pa un ka kiang uah, ‘ka zi in tapa nih a hon neihsak, chih na thei uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A khat pen ka kiang a kipan a paikhia a, bohzan vek a om hingei ding ahi, ka chi hi. Huai nungsiah amah mulou vengveng ka hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in, hiai mi leng ka kiang a kipan na pimang ua, tuahsia va tuak leh ka lu kang lungkham a hana tumsak ding na hi uh,’ a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in, ka nau in kou honzui lou a, na sikha ka pa kiang vatung leng, a hinna, ka nau uh hinna toh a kizop ziak in,
  </para>
  <para style="p">
    <verse number="31" style="v" />hichi ahi ding a, naupang in a hon zuikei, chih a theih chiang in a si mai ding. Huchi in na sikhate’n na sikha ka pa uh lu kang lungkhamna a han a tumsak ding ka hi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na sikha in na kiang a ka honpi kiknawn kei leh, a mawh tangtawn in ka pa lak ah ka paw ding, chi’n, ka pa kiang ah ka nau uh tungtang thu ah a bultumpa in ka kibawlta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in, hehpih in na sikha ka nau uh sik in, Pu, na sikha in hon omsak inla, ka nau a ute zuitou sak in.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ka nau in hon zuilou in bangchi’n ka pa kiang ka paitou thei dia? A tung a siatna tung mu ding ka kei hiam” a chi hi.
  </para>
  <chapter number="45" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, a kiang a dingte ma ah Joseph a kidek zouta kei a, “Mi tengteng ka kiang a kipan pawtkhesak vek un” chi’n, a kikou hi. Joseph a unaute kiang a a kigen sungteng a kiang ah kuamah ading kei uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />A kap lawlawih a, Aiguptate’n a za ua, Pharo inkuanpihte’n leng a za uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Joseph in a unaute kiang ah, “Joseph ka hi. Ka pa a damlai na maw?” a chi hi. Himahleh a unaute’n a dawng theikei ua, a ma ah buaitak in a omta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joseph mah in a unaute kiang ah, “Hehpih in honnaih un” a chi hi. Huchi in a vanaih ua, aman, “Na unaupa uh Joseph, Aigupta gam a lutpih dia na khot uh ka hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh hiai a paiding a n’on khot ziak un lungkham kei unla, ki hehkhum tuankei un. Mite hinna hondam ding in Pathian in na ma ua honsawl masa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai kum nih sung hiai gam ah kial a keta a; kum nga in a samlai hi. Huai sung in leileh a omkei dia, buhlak leng a omkei ding.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tu nung khang om zel ding hawisak ding leh noute hotdamna thupitak a hingdam a k’on omsak theihna ding in Pathian in na ma uah a honsawl masa hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in, hiai a honsawl nou na hi kei ua, Pathian ahizaw hi. Aman Pharo pa inn leh a inkuanpih tengteng heutu in leh Aigupta gam tengteng vaihawmtu in a hon bawlta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Kintak in ka pa kiang ah vapai unla, a kiang ah, na tapa Joseph in hichi’n a chi. Pathian in Aigupta gam tengteng heutu in a hon bawlta a, ka kiang ah hong paisuk in, sawt hon halken.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in, Gosen gam ah na teng ding a, ka kiang ngei ah na om ding; nang, na tate, na tute, na belamhonte, na bawnghonte leh na neih tengteng toh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiai ah keimah in ka honvak ding. Kial lah kum nga omlai ding ahi ngal a. Huchilou in zaw na genthei kha ding, nang leh na inkuanpihte leh na neih tengteng toh” honchi un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai un, noumau mit ngei leh ka nau Benjamin mit ngei in keimah kam mahmah in a genlai na mu kilkel uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aigupta gam a ka thupina tengteng thu leh na thilmuh tengteng thu uh ka pa na hilh ding ua; ka pa kintak in hiai ah n’on pisuk pah ding uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A nau Benjamin ngawng a kun in a kapta a; Benjamin leng amah ngawng a kun in a kapta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A unau tengteng a tawp a, a kahkhum chiat a, huaikhit in a unaute’n thu vantang a genpih uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph unaute a hong uh chih thu thuthang Pharo inkawte’n a naza uhi. Huai in Pharo leh a sikhate a kipaksak mahmah hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pharo in Joseph kiang ah, “Na unaute kiang ah, huchi in hih in. Na gante uh buh pawsak unla, pawt unla, Kanan gam ah pai un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na pa uh leh na inkuanpihte uh honpi unla, ka kiang ah hongpai un. Aigupta gam a thilhoihte k’on pe ding a, hiai gam a thil om hoihpente na ne ding uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu k’on pia hi. Hichi’n hih un. Na ta neu chikchikte uh ading leh na zite uh ading Aigupta gam a kipan kangtalaite la unla, na pa uh pi ding in va kuan un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na van uh leng ngaihtuah nuam dah un, Aigupta gam tengteng thil hoih peuhmah nou a ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel tate’n huchibang in a hih ua, Joseph in Pharo thupiak bang in kangtalaite a kiang uah a pia a, lampi a nekding leng a pia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Avek ua kiang ah puansilh kikhenna ding a pe chiat a; Benjamin kiang ngial ah houh dangka za thum leh puansilh kikhenna ding nga a pia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pa kiang ah hiaite a khak hi: Aigupta gam a thil hoih pua sabiltung sawm leh lampi a, a pa ading buh leh tanghou leh nekding pua sabengtungnu sawm.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in a unaute a sawlkhia a, a paita uhi. Aman a kiang uah, “Lampi ah kina lou ding in pilvang un” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aigupta gam a kipan a paitou ua, Kanan gam a a pa Jakob kiang a va tungta uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A kiang ah, “Joseph a hinglai a, Aigupta gam tengteng heutu ahi” chi in, a hilh uhi. A thugen uh a gintak louh ziak in, a lungtang a bahta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A kiang ua Joseph thugente a hilh ua; a tuanna ding kangtalai Joseph in a khakte a muh in Jakob lungtang a halhnawn hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Israel in, “A hunta; ka tapa Joseph hingdam a na om ahi maw. Ka sih ma in amah ka va mu ding” a chi hi.
  </para>
  <chapter number="46" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Israel a neih tengteng toh a pawt a, Beer–sheba a tung a, a pa Isak Pathian kiang ah kithoihnate a lan hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian in zan a mengmuhna in Israel a houpih a, “Jakob, Jakob,” a chi hi. Aman, “Hiai ah ka om,” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman, “Kei Pathian, na pa Pathian ka hi. Aigupta gam a hohsuk lau ken. Huai ah chi thupitak in k’on bawl ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aigupta gam ah na kiang ah ka hong dia; k’on pitou nawn ngeingei ding, na sih chiang in Joseph in hon mitsi sak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in, Jakob Beer–sheba a kipan a pawt a; Israel tate’n a pa uh Jakob leh a ta neuchikchikte uh leh a zite uh tuanna dia Pharo in kangtalai a khakte ah a tuangsak uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in, Jakob leh a suan tengteng in Kanan gam a a lamkhiak uh, gante leh vante tawi in, Aigupta gam a tungta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A tapate, a tupate, a tanute, a tunute leh a suan tengteng, Aigupta gam ah a lutpihta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiaite Israel suan Aigupta gam a lut, Jakob leh a tapate min ahi. Reuben, Jakob ta masa.
  </para>
  <para style="p">
    <verse number="9" style="v" />Reuben tapate Hanok, Pallu, Hezron leh Karmi ahi uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Simeon tapate: Jemuel, Jamin, Ohad, Jakin, Johar leh Kanan numei tapa Shaul ahi uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi tapate: Gershon, Kohath leh Merari ahi uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Judah tapate: Er, Onan, Shelah, Perez leh Zerah ahi ua; (Er leh Onan Kanan gam ah a sita ua) Perez tapate Hezron leh Hamul ahi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Issakar tapate: Tola, Puva, Job leh Shimron ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Zebulun tapate: Sered, Elon leh Jhaleel ahi uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiaite tengteng Leah tapa, a tanu Dinah toh, Padan-aram gam a Jakob a neihsakte ahi ua; a tapate leh a tanu tengteng sawmthum leh thum ahi uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gad tapate: Ziphion, Haggi, Shuni, Ezbon, Eri, Arobdi leh Areli ahi uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Asher tapate: Jimnah, Ishuah, Isui leh Beriah leh a sanggamnu uh Serah ahi uh. Beriah tapate: Heber leh Malkiel ahi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiaite Zilpah Laban in a tanu Leah kiang a a piak tapate, Jakob a neihsak mi sawmlehguk ahi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob zi Rakil tapate: Joseph leh Benjamin ahi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joseph in Aigupta gam ah tapa Manasseh leh Ephraim a nei a, huai mite On khaw siampu Potipher tanu Asenath in amah a neihsakte ahi uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin tapate: Belah, Beker, Ashbel, Gera, Naaman, Ehi, Rosh, Muppim, Huppim leh Ard ahi uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiaite Rakil tapa Jakob a neihsakte ahi ua; avek un sawmlehli ahi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan tapa Husim ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Naphtali tapate: Jahzeel, Guni, Jezer leh Shillem ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiaite Bilhah tapate Laban in a tanu Rakil kiang a a piak ahi uh. Hiaite Jakob a neihsak a; avek un sagih ahi uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jakob tapate zite simlouh in Jakob kiang a Aigupta gam a lut, a khal a pawt tengteng avek un sawmguk leh guk ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Joseph in Aigupta gam a tapa a neihte nih ahi ua; Jakob inn kawte, Aigupta gam a lutte, sawmsagih ahi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jakob in Gosen gam lampi na kawkmuh ding in Joseph kiang ah Judah a hohmasa sak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in, Gosen gam ah a lutta uh. Joseph in a kangtalai a bawlkhol a, Gosen gam ah a pa dawn ding in a hohtou hi. A kiang ah a kigen a, a ngawng a kun in a kap nilouh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Israel in Joseph kiang ah, “Dam in na om a, na mel ka muh nawn ziak in tun zaw si ding in ka kimanta” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Joseph in a unaute leh a pa inkuanpihte kiang ah, “Ka va hohtou dia, Pharo ka hilh dia, a kiang ah, ka unaute leh ka pa inkuanpihte, Kanan gam a omte ka kiang a hongtungta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amaute ganvulmi, belamchingmite ahi uhi. A belamhonte uleh a bawnghonte uh leh a neih tengteng uh a honpaw vek uhi, chi’n, ka vagen ding.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hichi ahi ding a, Pharo in nou a honsap a, bang nasem na hi ua? a honchih chiang in,
  </para>
  <para style="p">
    <verse number="34" style="v" />Na sikhate, hon suangtute a kipan naupang chik ka hih lai ua pan in tutan ganvulmi ka hi uh, na chi ding uh. Huchi in, Gosen gam ah na tengthei ding uhi” a chi hi. Belamchingmite himhim lah Aigupta mite kihlam tak ahi uhi.
  </para>
  <chapter number="47" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaikhit in Joseph in Pharo a va hilh a, a kiang ah, “Ka pa, ka unaute, a belamhonte uh, a bawnghonte uh leh a neih tengteng u toh Kanan gam a kipan a hongtung suk ua; ngai in, Gosen gam ah a om uh” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A unaute lak a kipan mi nga a pi a, Pharo a valak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pharo in a unaute kiang ah, “Bang nasem na hi ua?” a chi hi. Amau Pharo kiang ah, “Na sikhate, kou hon suangtute a kipan, belamchingmite ka hi uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amau mah in Pharo kiang ah, “Hiai gam a om tadih dia hong ka hi ua; ka gam uah lah na sikhate belamhonte nekding a om nawnta kei a; kial lah Kanan gam ah a uang mahmah hi; hehpih in na sikhate Gosen gam ah hon tengsak in” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pharo in Joseph a houpih a, “Na pa leh na unaute na kiang ah a hongta ua;
  </para>
  <para style="p">
    <verse number="6" style="v" />Aigupta gam a kiching mahmah hi. Na pa leh na unaute gam hoihna mun ah tengsak in. A lak ua thilhihtheitak, theihna nei ngial a om leh ka gam tung a heutu ding in bawl in” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joseph in a pa Jakob a pilut a, Pharo ma ah a dingsak a; Jakob in Pharo a vualzawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pharo in Jakob kiang ah, “Kum bang zah na hita a?” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jakob in Pharo kiang ah, “Ka khualzin nung zaw kum za leh sawmthum ahi a, ka damsung kumte a tawm a, a haksa hi. A hon suangtute a khualzin lai ua a damsung kum u leng phazou kei ing” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in Jakob in Pharo a vualzawl a, Pharo a kipan a pawtta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Joseph in a pa leh a unaute tenna a bawlsaka, Pharo thupiak bang in Aigupta gam a mun hoihpen ah, Rameses gam a gou ding un a peta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in a pa leh a unaute leh a pa inkuanpih tengteng a inkuan uh bangzel in nekding a pia a, a vakta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai gam tengteng ah nekding himhim a omta kei a; kial lah a uang mahmah hi. Kial ziak in Aigupta leh Kanan gam a bahta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Joseph in a buh leina man uh, Aigupta gam leh Kanan gam a dangka om tengteng a khawmsak vek hi. Joseph in huai dangka Pharo inn ah a tawilut hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aigupta gam leh Kanan gam a dangka tengteng a zatbei khit un, Aigupta mi tengteng Joseph kiang ah a hong ua, “Nekding honpia in. Na ma a si maimah ding ka hi ding uam? Dangka lah a om nawnta ngal kei a” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph in, “Na gante uh hon pemai un. Dangka a om nawn kei leh na gan man un nekding k’on pe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A gante uh Joseph kiang ah a honpi ua; Joseph in sakol man ding leh, belamhon man ding leh, bawnghon man ding leh sabiltung man ding in nekding a pe zel hi. Huai kum in a gan tengteng uh man in nekding a pia a, a vak chiat hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai kum a bei a, kum a hongthak nawn in a kiang ah a hong nawn ua, “Ka dangka teng uh a beitak dan ka toupa k’on imkei ding uh. Ka ganhonte uh ka toupa’n na neita hi. Ka toupa mitmuh in ka sapum uh leh ka gam uh chih louh, bangmah ka nei nawn kei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Bangziak in na mitmuh in kou leh ka gam uh mangthang maimah ding hiam? Koumau mah ka gam u toh an in honlei mai in. Koumau leh ka gam uh Pharo sikhate ka hi ding uhi. Silou a dam a ka om theihna ding un leh gam a siatlouhna ding in buh chi honpia in” a chi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in Joseph in Pharo ading in Aigupta gam tengteng a leisakta hi. Kial a tung ua a awt mahmah ziak in Aigupta mite’n lah a lou uh a zuak chiat uhi. Huchi in gam Pharo a ahivekta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mite Aigupta gamgi tawp khatlam a kipan khatlam tawppha in khuate ah a kisuansakta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Siampute gam kia a leikei a, siampute’n Pharo a kipan tantuan a nei ua, Pharo in a piak a tantuan uh a ne zel uhi. Huaiziak in a gam uh a zuak kei uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai nung in, Joseph in, mite kiang ah, “Ngai un, tuni in na gam uh leh noute Pharo ading in k’on leita hi. Hiai ah nou ading in buhchi a om, lei ah na ching ding uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Buhlak hun chiang in hichi ahi ding. Pharo ading in seh nga suah, seh khat zel na pe ding ua, a seh li pen noumau a ahi ding. A chi ding, noumau, na inkuanpihte uh leh na tanu neu chikchikte uh nekding ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amau, Nang ka hinna uh na humbitta hi. Ka toupa’n pha a sakleh hon hehpih inla, Pharo sikhate ka hi ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in, Joseph in Pharo in seh nga suah, seh khat a muhzel ding thu, Aigupta gam ading in tunitan in dan in a bawlta hi. Siampute gam kia ahi, Pharo a hilou.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israel in Aigupta gam a Gosen gam ah tenna a bawlta a, huai ah a kihih inbul a, chi tampi a suang a, nakpitak in a pungta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jakob Aigupta gam ah kum sawmlehsagih a teng a, Huchi in, Jakob damsung kum za leh sawmli leh sagih ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israel sih hun a hong naita a; a tapa Joseph a sam a, a kiang ah, “N’on hehpih theih leh hehpih in na khut ka pheipi nuai ah golh inla, hon hehpih in, ka tung ah chihtaktak in hih in. Hehpih in Aigupta gam ah honvui mahmah ken.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hon suangtute kiang a ka ihmut hun chiang in, nang Aigupta gam a kipan n’on pawkhe ding a, amaute vuina mun ah n’on vuizaw ding ahi” a chi hi. Aman, “Na chih bang in ka hih ding” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman, “Ka kiang ah kichiam in” a chi a; a kiang ah a kichiamta hi. Huchi in lupna lukhung si in Israel a kunta hi.
  </para>
  <chapter number="48" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hiaite nung in hichi ahi a, Joseph kiang ah, “Ngai in, na pa a chi a na” a chi uhi. Huchi in, a tapa nihte Manasseh leh Ephraim a kiang ah a tonpih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jakob kiang ah, “Ngai in, na tapa Joseph na kiang ah a honghi” chi’n a hilh uh. Israel a kihalhsak a, lupna ah a tuta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jakob in Joseph kiang ah, “Pathian, bangkim hihthei, Kanan gam a Luz khua ah ka kiang ah a kilak a, a hon vualzawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka kiang ah, chi tampi k’on suangsak dia, k’on hih punglai ding. Chi tuamtuam omkhawm in k’on bawl ding. Hiai gam nanung a na suante kiang ah a tangtawn gou ding un ka pe ding” a honchi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Na tapa nihte, Aigupta gam a na neihte, kei a ahi uhi. Ephraim leh Manasseh, Reuben leh Simeon mah bang in kei a ahi ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai mite nung a ta na neihte nang a ahi ding uh, a goutan uah a ute uh min a kikoppih ding uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kei tungthu ahihleh, Padan gam a kipan ka hongpai lai in Rakil Kanan gam ah lamkal ah Ephrath khua gamla kuam ahihlai in, ka kiang ah a si hi. Huai ah Ephrath khaw lampi ah ka vuita, huai bel Bethlehem khua ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel in Joseph tapate a en a, “Hiaite kuate ahi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Joseph in a pa kiang ah, “Hiaite ka tapa, Pathian in a honpiakte ahi uh” a chi hi. Aman, “Hehpih in ka kiang ah honpi in, amau ka na vualzawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel mit a upat tak ziak in a chim nawnkei a, aman a na tawp a, a na pom hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel in Joseph kiang ah, “Na mel muh ka kilamen nawn kei a, himahleh, ngai in, Pathian in na suante mel nangawn a hon musakta” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph in amau a pa pheikala kipan a pikhia a, a mai a leisi in a kun hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Joseph in a nih un a kai a, Ephraim pen a khut taklam in Israel khut veilam pang ah, Manasseh pen a khut veilam in Israel khut taklam pang a kai in a pinai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israel in a sawkkalh teitei a, a khut taklam in a sawk a, Ephraim a naupangzaw sip ah a nga a; Manasseh bel a ta masa ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph a vualzawl a, Hon suangpa Abraham leh Isak om zelna Pathian, tuni tan a ka damsung tengteng hon vakpa Pathian,
  </para>
  <para style="p">
    <verse number="16" style="v" />Thil hoihlou tengteng a kipan hontanpa Angel in naupangte vualzawl hen. Ka min leh hon suangpa Abraham leh Isak min pu uhen. Khovel ah thupitak hi ding in hongpung uhen, a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Joseph in a pa’n a khut taklam Ephraim sip a a ngak a muh in a lungkim kei a; a pa khut Ephraim sip a kipan Manasseh sip a suan ding in a domkang hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Joseph in a pa kiang ah, “Pa, hichibang ding ahi kei. Hiai ahi ta masa, na khut taklam a sip ah ngazaw in” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh, a pa a utkei a, “Ka thei hi, ka tapa aw, ka thei hi. Amah leng nam gentham in a om dia, amah leng a thupi ding hi. Himahleh a naupa amah sang in a thupizaw dia, a suante leng chituam tuam tamtak a honghi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in Jakob in, “Nang ah Israel vualzawl ahi ding, Pathian in Ephraim leh Manasseh bang in honbawl hen,” chi in a vualzawl hi. Huchibang in Manasseh ma ah Ephraim a omsak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel mah in Joseph kiang ah, “Ngai in, si ding ka hita hi. Himahleh Pathian na kiang uah a om dia, nou hon suangtute gam ah a hon pilut nawn ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai lou leng, na unaute tantuan sang in tankhat in k’on petuan hi, ka namsau leh ka thalpeu a Amorte khut a kipan ka laksak pen” a chi hi.
  </para>
  <chapter number="49" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Jakob in a tapate a sam a, hichibang in a gen hi. “Ni nanungte a na tung ua thil hongtung dingte k’on hilh theihna ding in hong kikhawm un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nou Jakob tapate aw, hong kikhawm unla, Ngaikhia un; na pa uh Israel thu ngai un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Reuben, nang ka tapa masa, ka thilhihtheihna, ka hatna gah masapen na hi. Sanpen na leh thuneihpenna nang a ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh tui bang a kiplou na hi, tungnun penna na neikei ding; na pa lupnapi ah na kal ziak in. Huai ah ka lupna a kal in na hihbuah hi,
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon leh Levi unau ahi ua, a namsaute uh sisan suahna vanzat ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka kha aw, nang zaw a kikupna uah va kigolh ken. Ka thupina, nang zaw a kikhopna uah telken. A heh un mi a that ua, a genhak un bawngtal thagui a sattat uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hehna un hamsia dong hen, hangsantak ahi ngal ua. A thangpaihna un leng hamsia dong hen, hinsetak ahi ngal ua. Jakob ah amau ka kikhen sak dia, Israel ah ka hihdalh ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah, nang na unaute’n a honphat ding uh. Na khut na doute ngawng ah na nga dia; na tapate na ma ah a kun ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Judah humpinelkai nou ahi. Ka tapa, na sakeih na paitouh santa. Na kun a, humpinelkai bang in na bok a, humpinelkainu bang in na kualsuk hi. Kua’n ahia hon thou sak ngam ding?
  </para>
  <para style="p">
    <verse number="10" style="v" />Lalchiang Judah a kipan a mangkei ding, Vaihawmpa chiang a khekal a kipan a mangkei ding. Shiloh a hongpai mateng; namchih in amah thu a mang ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A sakolnou grepgui ah a khih dia, a sabiltung nou grepgui hoih chi ah a khih ding hi. A puansilhte uain in a sawp dia, a puan grep sisan in a sawplai ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mitte uain in a san ding ua, a hate nawitui in a ngou ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zebulun tuipi gei ah a teng dia, longkhawlna luipiau ahi dia; a gamgi Zidon ah ahi ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Issakar sabiltung hattak ahi a, vangik nih kal a kual hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Khawl hoih in a thei a, gam leng hoih in a thei; Huchi in van paw ding in a liangzang a niamsak a, kuli nna sem in sikha in a hong omta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan in Israel nam lak a khat bang in a mite vai a hawmsak ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dan lamlian gei a gul, lampi a gulgial, a tung a tuang mi thalkiak ek khop a sakol khe tu nakpa ahi ding.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Toupa , na hotdamna ka ngak gige hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gad, gal in a sual dia, himahleh aman a khetul lam uah amau a sual zaw ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Asher, a nek a hoih dia, Kumpi nekte a piangsak ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Naphtali zukpi khah ahi. Thu hoih pipi a gen zel hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph hiang gahnuamtak ahi, tuikhuk kiang a hiang gahnuamtak; a hiang nawnsawnte’n bang a tuam uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thalkapmite’n amah nakpitak in a hihgenthei ua, a kap ua, a simmawh uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh, amah thalpeu khauhtak in a om gige a, a ban thate Jakob Mihatpa in a hatsak leh belamchingmi, tua Israel suangpi hatsak ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na pa Pathian, nang hon panpih dingpa, Bangkim hihtheipa, tunglam van vualzawlnate, nuailam a om gige tui thuktak vualzawlnate, nawite leh sul vualzawlnate, nangmah hon vualzawl dingpa ngei hihhat in na om hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na pa vualzawlnate hon suangtute Vualzawlna sang in tangtawn tangte tawpkhawk pha in a thupizawta hi. Hiaite Joseph lu tung ah a om dia, a unaute a kipan hihtuam a ompa sip ah a om ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Benjamin nge duhgawl bang in, zingsang in a sa matte a ne dia, nitaklam in a gallak a hawm ding” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huaite tengteng Israel nam sawmlehnihte ahi uh. Huai thute leng amaute vualzawlna a kiang ua a pa uh thugen ahi. Vualzawlna a tanding gun bangzel un a vualzawl chiat hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman a tate thugou a siah a, a kiang uah, “Ka chipihte kiang a pi a om ding ka hita. Hit mi Ephron lou a kawkhuk ah kei hon suangtute kiang ah honvui un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kanan gam a Mamre ma a Makpelah lou a kawkhuk, Abraham in kivuina mun dia Hitmi Ephron a kipan lou toh a lei ah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huai ah Abraham leh a zi Sarah a vui ua; huai ah Isak leh a zi Rebekah a vui ua; huai mah ah Leah ka vui hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lou leh asung a kawkhuk om Hit suante a kipan a lei ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jakob in a tapate kiang a thugou a siah khit in a khete lupna ah a nga tou a, a kha a khahta a, a chipihte kiang ah pi in a om samta hi.
  </para>
  <chapter number="50" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Joseph in a pa mai a si a, a kah a, a tawp hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Joseph in a sikha damdawi siamte a pa luang muattheilou a bawl ding in thu a pia hi. Huchi in damdawisiamte’n Israel luang muattheilou in a bawlta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A luang bawlna in ni sawmli a zang ua, muattheilou a bawlna in ni hiai zah a lutnak hi. Ni sawmsagih sung teng Aiguptate’n amah a sun uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah a sunnite uh a beinung in, Joseph in Pharo inkuante a houpih a, “Na mitmuh ua deihsakna ka muh leh hehpih in Pharo bil a zak ding in, ‘Ka pa’n, ngai in, si ding ka hita.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kanan gam a ka han dia ka tohsa ngei ah na honvui ding ahi,’ chi’n, a hon kichiamsak hi. huaiziak in, tuin hehpih in ka pa hon pawtousak inla, hon va vuisak in, Huchi in ka hongpai nawn ding, a chi, chi’n, hon gensak un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pharo in, “A hon kichiamsak bang in na pa va pawtou ve” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joseph a pa vui ding in a va hohtou hi. Pharo sikha teng, a inkuan lak a upate leh Aigupta gam upa tengteng leh,
  </para>
  <para style="p">
    <verse number="8" style="v" />Joseph inkuanpih tengteng leh, a unaute leh, a pa inkuanpihte, a kiang ah a va hohtou uhi. A ta neu chikchikte uleh a belamhonte uleh a bawnghonte kia uh Gosen gam ah a nusia uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kiang uah kangtalaite leh Sakol tungtuang mite leng a hohtou ua, huchi in pawl lianpi ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jordan luigal a Atad phual a tung ua, huai ah nakpitak in a kah ua, ni sagih sung a pa sunna a nei uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiai gam mi Kanante’n, Atad phual a a misun uh a muh un, hiai Aiguptate misi sunna thupitak ahi, a chi uhi. Huaiziak in huai mun Abel mizraim a sa ua, huai Jordan luigal a om ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tapate’n a thupiak bang in a hihsak uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A tapate’n Kanan gam ah a zawnglut ua, Abraham in kivuina mun dia, Hitmi Ephron a kipan a lou toh a lei Mamre ma a Makpelah lou a kawkhuk ah a vuita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A pa a vui khit in Joseph leh a unaute leh a pa vui dia a kiang a hohtou tengteng Aigupta gam ah a pai kiknawnta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Joseph unaute’n a pa uh sih a ngaihtuah ua, “Joseph in hon mudah dia, a tung a i thil hihkhelh tengteng phu i tung uah kim sipsip in a honla kha ding e” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Joseph kiang a hilh ding in mi a sawl ua, “Na pa’n a sih ma in hichi’n thu a pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Joseph kiang ah, ‘hehpih in na unaute tatlekna leh a gitlouhna uh ngaidam in. Na tung ah thil hoihlou a hihta ngal ua. Tuin hehpih in na pa Pathian sikhate tatlekna ngaidam in,’ a chi, chi’n vagen un” a chi hi. A kiang a a gentak un Joseph a kap hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A unaute leng a va hoh ua, a ma ah a khupboh chiat uh. “Ngai in, na sikhate ka hi uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Joseph in a kiang uah, “Lau kei un. Pathian sik a om ka hi ahia?
  </para>
  <para style="p">
    <verse number="20" style="v" />Nou zaw ka tung ah thil gilou hih lungsim na pu ua; himahleh tuni in mi tampi hing leh dam a humbitna dia thil hoih suahsak Pathian lungsim ahizaw hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />huaiziak in, tuin lau kei un. Nou leh na ta neu chik chikte uh ka honvak ding” a chi hi. Huchi in, amau a lungmuan a, kamsiam tak in a houpih hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph, amah leh a pa inkuanpihte toh Aigupta gam ah a teng ua, Joseph kum za leh sawm a dam hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph in Ephraim ta, tusawn thum chiang a mu hi. Manasseh tapa Makir tate leng Joseph pheitung ah a khanglian uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Joseph in a unaute kiang ah, “Si ding ka hita hi. Himahleh Pathian in a hongveh ngeingei dia, hiai gam a kipan hon pikhia in, Abraham, Isak leh Jakob kiang a kichiam a, piak a chiam gam ah a hon pitou ding” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Joseph in Israel suante a kichiam sak a, “Pathian in a hongveh ngeingei dia, ka guhte hiai a kipan na zawngtou ding uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in Joseph kum za leh sawm a upa a hih in, a sita hi. A luang muattheilou in a bawl ua, Aigupta gam ah hankuang sung ah a koih uhi.
  </para>
</usx>
