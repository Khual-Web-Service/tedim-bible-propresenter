<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="NUM" style="id">Nambars</book>
  <para style="h">Nambars</para>
  <para style="toc1">Nambars</para>
  <para style="toc2">Nambars</para>
  <para style="mt">Nambars</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aigupta gam a kipan a hongpawt uh a kum nihna, a kha nihna, a ni khat ni’n Sinai gamdai ah Kihoupihna puanin ah Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suan omkhawm tengteng, a inkuan kuan in, a min uh kizomdan bangzel in pasal tengteng simvek in; a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kum sawmnih apan a tunglam Israel lak a galdou thei chiang peuhmah nang leh Aron in a pawlpawl in na simvek ding uh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na kiang ah namchih lak a khat, inkuan a lupen zel a om ding uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiaite na kiang a om dingte min ahi: Reuben nam a Shedeur tapa Elizur,
  </para>
  <para style="p">
    <verse number="6" style="v" />Simeon nam a Zurisadai tapa Shelumiel.
  </para>
  <para style="p">
    <verse number="7" style="v" />Judah nam a Amminadab tapa Nahson.
  </para>
  <para style="p">
    <verse number="8" style="v" />Issakar nam a Zuar tapa Nethaneel.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zebulun nam a Helon tapa Eliab.
  </para>
  <para style="p">
    <verse number="10" style="v" />Joseph tate, Ephraim nam a Ammihud tapa Elisama. Manasseh nam a Pedazur tapa Gamaliel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Benjamin nam a Gideoni tapa Abidan.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan nam a Ammisaddai tapa Ahiezer.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher nam a Okran tapa Pagiel.
  </para>
  <para style="p">
    <verse number="14" style="v" />Gad nam a Deuel tapa Eliasaph.
  </para>
  <para style="p">
    <verse number="15" style="v" />Naphtali nam a Enan tapa Ahira.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiaite mipite tel, a pi leh pute uh nam a lupen Israel inkuan a lupente ahi uh, chi in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mosi leh Aron in huai mi a min uh a lohte a pi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi tengteng a kha nihna, ni khat ni’n a samkhawm vek ua; a inkuan kuan in, a min uh kizomdan bangzel in kum sawmnih apan a tunglam teng a pipute uh min a taklang uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa’n Mosi thu a piak bang in Sinai gamdai ah a simta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel tapa upapen Reuben tate suante a chichi in, a inkuan kuan in, a min uh kizomdan bangzel in pasal kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Reuben nam, a simte uh sing li leh sang guk leh za nga ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simeon tate suante a chichi in, a inkuan kuan in, a min uh kizomdan bangzel in pasal kum sawmnih apan a tunglam galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Simeon nam, a simte uh sing nga leh sang kua leh za thum ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gad tate suante a chichi in, a inkuan kuan in, a min uh kizomdan bangzel in pasal kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gad nam a, a simte uh sing li leh sang nga leh za guk leh sawmnga ahi uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Judah tate suante a chichi in, a inkuan kuan in, a min uh kizomdan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Judah nam a, a simte uh sing sagih leh sang li leh za guk ahi uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Issakar tate suante a chichi in, a inkuan kuan in, a min uh kizomdan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Issakar nam a, a simte uh sing nga leh sang li leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun tate suante a chichi in, a inkuan kuan in, a min uh kizomdan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Zebulun nam a, a simte uh sing nga leh sang sagih leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Joseph tate lak a Ephraim tate suante a chichi in, a inkuan kuan in, a min uh tam dan bangzel in kum sawmnih apan a tunglam, galdou thei teng a sim uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ephraim nam a, a simte uh sing li leh za nga ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Manasseh tate suante a chichi in, a inkuan kuan in, a min uh tam dan bangzel in kum sawmnih apan a tunglam, galdou thei teng a sim uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Manasseh nam a, a simte uh, sing thum leh sang nih leh za nih ahi uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Benjamin tate suante a chichi in, a inkuan kuan in, a min uh tam dan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Benjamin nam a, a simte uh, sing thum leh sang nga leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dan tate suante a chichi in, a inkuan kuan in, a min uh tam dan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Dan nam a, a simte uh, sing guk leh sang nih leh za sagih ahi uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Asher tate suante a chichi in, a inkuan kuan in, a min uh tam dan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Asher nam a, a simte uh, sing li leh sang khat leh za nga ahi uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Naphtali tate suante a chichi in, a inkuan kuan in, a min uh tam dan bangzel in kum sawmnih apan a tunglam, galdou theiteng a sim uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Naphtali nam a, a simte uh, sing nga leh sang thum leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hiaite Mosi leh Aron in Israel lupen sawmlehnih, inkuan a lupente toh a simte uh ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huchi in Israel suan a inkuan kuan ua kum sawmnih apan a tunglam, galdou theiteng, Israel gam a te sim ahi uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />A sim teng uh nuai guk leh sang thum leh za nga leh sawmnga ahi uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Levite pipute a sim telkei uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="49" style="v" />Levi chi na sim tel ding ahi kei, Israel mite lak ah na sim tel ding ahi sam kei.
  </para>
  <para style="p">
    <verse number="50" style="v" />Levite theihpihna biakbuk kemmite leh van tengteng kemmite dia sehzawk ding ahi. Biakbuk a van tengteng a zawng ding ua, a kem ding ua, biakbuk a kimvel in a omkhum ding uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Biakbuk malam a a pai chiang in Levite’n a phel ding ua; biakbuk kaihding chiang in Levite mah in a kainawn ding uh. Namdang hong kigolh peuhmah hihlup ding ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Israel suante’n amau mun chiat ah, a pawlpawl in a tam dan uh dungzui zel in a puaninte uh a kai ding uh.
  </para>
  <para style="p">
    <verse number="53" style="v" />Himahleh Levite’n Israel suante khawmpi tung a hehna a om louhna ding in theihpihna biakbuk kimvel ah a kaiding uhi. Levite’n theihpihna biakbuk a kep ding uh ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huchibang in Israel suante’n Toupa’n Mosi kiang a thu a piak tengteng bang in a hihta uhi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi leh Aron a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante’n a inkuan chiamtehna uh takchiat in a pawl uh hih dan bang in a puanin uh a kai ding uhi. Kihoupihna puanin nga chiat in a kimvel in a kai ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ni suahna lam suahlam pang ah a pawl uh tam dan dungzui zel a puanin kai dingte Judah pawlte ahi ding ua; Judah tate lak a lupen ding Aminadab tapa Nashon ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sima ompawlte tam dan, sing sagih leh sang li leh za guk ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amah zom a puanin kai dingte Issakar chi ahi ding a; Issakar tate lak a lupen ding Zuar tapa Nethaneel ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sima om, pawlte tam dan sing nga leh sang li leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zebulun chite, Zebulun tate lak a lupen ding Helon tapa Eliab ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sima om, a pawlte tam dan, sing nga leh sang sagih leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A pawl uh tam dan bangzel in sim a om Judah inkuante nuai khat leh sing giat leh sang guk leh za li ahi uh. Amaute’n ma a kai zel ding uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />A pawl uh tam dan bangzel in a simlam pang ah Reubente pawl a om ding ua; Reuben tate lak a lupen Sedeur tapa Elizur ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sima om, a pawlte tam dan, sing li leh sang guk leh za nga ahi uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A zom a dingte Simeon chi ahi ding ua; Simeon tate lak a lupen ding Zurisadai tapa Selumiel ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sima om, a pawlte tam dan, sing nga leh sang kua leh za thum ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaikhit in Gad chite ahi ding ua, Gad tate lak a lupen ding Reuel tapa Eliasaph ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sima om, a pawlte tam dan, sing li leh sang nga leh za guk leh sawmnga ahi uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Reubente tam dan nuai khat leh sing nga leh sang khat leh za li leh sawmnga ahi uh, a pawl uh dungzui in. A zom in amau a pawtkhe ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kihoupihna puanin ah a kipan khe ding ua, Levite a lai ah a om ding ua, a omna thu zil bangzel in a pawlpawl in a paichiat ding uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A pawl tam danthu in a tumlam pang ah Ephraimte a om ding ua, Ephraim tate lak a lupen ding Amihud tapa Eliasam ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sima om, a pawlte tam dan, sing li leh za nga ahi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A zom in Manasseh chi ahi ding a; Manasseh tate lak a lupen ding Pedazur tapa Gamaliel ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sima om, a pawlte tam dan, sing thum leh sang nih leh za nih ahi uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A zom nawn in Benjamin chite, Benjamin tate lak a lupen ding Gideoni tapa Abidan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sima om, a pawlte tam dan, sing thum leh sang nga leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ephraimte tam dan nuai khat leh sang giat leh za khat ahi. A zom nawn in a paikhe ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A pawl uh tam dan bangzel in Dante a mallam pang ah a om ding ua; Dan tate lak a lupen ding Amisadai tapa Ahiezer ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sima om, a pawlte tam dan, sing guk leh sang nih leh za sagih ahi uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A zom a puanin kai dingte Asher chi ahi ding a; Asher tate lak a lupen ding Okran tapa Pagiel ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sima om, a pawlte tam dan, sing li leh sang khat leh za nga ahi uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />A zom nawn in Naphtali chite; Naphtali tate lak a lupen ding Enan tapa Ahira ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sima om, a pawlte tam dan, sing nga leh sang thum leh za li ahi uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Dante tam dan nuai khat leh sing nga leh sang sagih leh za guk ahi ua; amau a pawlpawl a pawtkhia in a nanung pen ahi ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiai Israel suante inkuan teng a mi a simte uh, tam dan ahi a, nuai guk leh sang thum leh za nga leh sawmnga a pha uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Levite Israel suante lak a sim tel ahi kei uhi, Toupa’n Mosi thu a piak bang in.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchibang in Israel suante’n a hih ua; Toupa’n Mosi thu a piak bangzel in a pawlpawl in puanin a kai uhi. Huchi mah bang in a chichi in, a inkuan kuan zel un a kipan khe zel uhi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Toupa’n Sinai tang a Mosi a houpih lai a Aron leh Mosi suan hiaite ahi uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aron tapate min a upapen Nadab, Abihu, Eleazar leh Ithamar ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiaite siampu dia thaunilh, siampu nasem ding a sehtuam, Aron tapate min ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nadab leh Abihu ahihleh Sinai gamdai a mei zatlouh ding a chih, Toupa ma a a latlai un Toupa ma ah a sita ua, ta a neikei uhi. Eleazar leh Ithamar in a pa uh Aron damlai in siampu na a sem uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi chite, siampu Aron kiang ah pi inla, a na a septheihna ding un a kiang ah omsak in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amau biakbuk a nasem in Kihoupihna puanin chin ah amah leh khawmpi tengteng ading in na a sem ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kihoupihna puanin van tengteng a kem ding ua, Israel suante ading in biakbuk ah a sem ding uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Levite Aron leh a tapate kiang ah na pe ding a; Israel suante lak a kipan amah kiang a piak ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aron leh a tapate na sep ding a, a siampu hihna na a sem nilouh ding uh. Midang hong kigolh a om leh hihlup ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai in, Levite Israel suante lak apan Israel suante tachil sul hong masapen sik leh tang a keimah ngei in ka lak ahi uh. Huaiziak in, Levite kei a ahi ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Piang masa ta tengteng kei a ahi. Aigupta gam a piang masa tengteng ka thah ni’n Israelte lak a piang masa tengteng, a mihing leh gan tan in kei a tuam ding in ka kham ahi. Kei a ahi ding uh. Kei, Toupa ka hi, a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sinai gamdai ah Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="15" style="v" />Levi tate a inkuan kuan un, akhang akhang un sim inla; pasal peuhmah kha khat apan a tunglam teng na sim ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosi in a hih ding a thupiak bang in Toupa thu bang in a sim chiatta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Levi tapate min: Gershon, Kohath leh Merari ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amau suangpa Gershon tapate min Libni leh Shimei ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau suangpa Kohath tapate min Amram, Izhar, Hebron leh Ujiel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amau suangpa Merari tapate min Mali leh Musi ahi. Hiaite a inkuan uh bangzel a Levi suante ahi uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gershon, Libnite leh Simeite suangpa ahi a, hiaite Gershonte suante ahi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pasal tengteng kha khat apan a tunglam a simte uh sang sagih leh za nga ahi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gershonte suante’n a puanin uh biakbuk tumlam pang ah a kai ding uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gershonte inkuan a lupen Lael tapa Eliasaph ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gershon tate’n Kihoupihna puanin a a sep ding uh ahihleh biakbuk leh puanin, a tung, Kihoupihna puanin leh a kongkhak puanzak kep ahi ding a;
  </para>
  <para style="p">
    <verse number="26" style="v" />a intual puanzakte, biakbuk chin a, a intual kongkhak puanzak leh maitam kim a zat ding khau tengteng toh leng ahilai ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kohath bel Amramte, Izharte, Hebronte leh Ujielte suangpa ahi a; hiai teng Kohath suante ahi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pasal tengteng kha khat apan a tunglam a simdan bang un sang giat leh za guk ahi ua, Mun Siangthou a kem ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kohath tapate suante’n biakbuk simlam pang ah a puanin a kai ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kohathte suante inkuan a lupen ding Ujiel tapa Eliazaphan ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A kep dingte: bawm, dohkan, sathau, khawnvak koihna, maitam, Mun Siangthou a nasepna tuium-belsuan tengteng, puanzak leh huai a nasepna thil tengteng ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Siampu Aron tapa Eleazar Levite lupen ahi ding a, Mun Siangthou kemmite a makaih ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Merari, Malite leh Musite suangpa ahi. Hiai Merari suante ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pasal tengteng kha khat apan a tunglam a simdan bang un sang guk leh za nih ahi uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Merari suante inkuan a lupen Abihail tapa Zuriel ahi a; biakbuk mallam pang ah a puanin a kai ding uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Merari tapate kep ding a sehte biakbuk khuam lepkhawm, bang kal, a khuamte, a kingakna khuak kuak, a vanzat tengteng leh nasepna vanzat tengteng ahi uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />A kongpi umna khuamte, a kingakna khuakkuakte, a kilhbelhna leh a khaute toh leng ahilai ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Biakbuk suahlam pang Kihoupihna puanin chin a, nisuahna lam a puanin kai ding ahihleh Mosi leh Aron leh a tapa ahi ding ua, Mun Siangthou ah Israel suante a tuam ding in a kul peuhpeuh a sem ding uh. Namdang hong kigolh peuhmah thah ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Toupa thupiak a Levite a inkuan kuan ua pasal tengteng kha khat apan a tunglam Mosi leh Aron in a sim teng uh sing nih leh sang nih ahi uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Toupa’n Mosi kiang ah: Israel suante lak a piang masa, pasal kha khat apan a tunglam teng sim inla, a zah uh thei in.
  </para>
  <para style="p">
    <verse number="41" style="v" />Israel suante lak a piang masa teng sik in kei ading in Levite n’on laksak dia, Israel suante gan tengteng a piang masapen sik in Levite gante, n’on laksak ding ahi, kei Toupa ka hi, a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mosi in Toupa’n thu a piak bang in Israel suante lak a piang masa teng a sim hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A min uh kizom bangzel in kha khat apan a tunglam piang masa pasal teng a sim a, sing nih leh sang nih leh za nih leh sawmsagih leh thum ahi uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="45" style="v" />Israel suante lak a piang masa teng sik in Levite la inla, a gan uh sik in Levite gan; Levite kei a ahi ding ua; kei Toupa ka hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Levite sang a tamzawte lak ah tatding in Israel suante piang masa za nih leh sawmsagih leh thum la in.
  </para>
  <para style="p">
    <verse number="47" style="v" />Sekel nga chiat na la ding ahi; Mun Siangthou a sekel bang in na la ding hi, Sekel bel gerah sawmnih ahi:
  </para>
  <para style="p">
    <verse number="48" style="v" />A tatna sum val Aron leh a tapate na piak ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Levite tatte ban ah a tatna sum uh Mosi in a la hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Israel suante piang masate lak apan sum a la a; sum siangthou sekel bang in sang khat leh za thum leh sawmguk leh nga a la hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Toupa’n Mosi thu a piak, Toupa thu bang in Mosi in tatna sum Aron leh a tapate a pia hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Levi tate lak a Kohath tate, a khang a khang un, a inkuan kuan un, simvek in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Kum sawmthum apan a tunglam, kum sawmnga tan in nasepna, Kihoupihna puanin a sem ding teng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kihoupihna puanin Mun Siangthou pen a Kohath tapate nasep ding hiaite ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Giahphual a suan ding teng un Aron, a tapate toh a lut ding ua, Mun Siangthou puanzak a hawkkhe ding ua, huai in thukhun bawm a khuh ding uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai pen ngalvang vun in a khuh ding ua, puandum buang in leng a khuh ding ua, a zawnna chiang a thuah ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Etsakna tanghou dohkan tung ah puandum buang a phah ding ua, huai ah kuangte, keute, belhbute leh noute butkhiakna ding a koih ding uhi. Tatlak lou in tanghou koih huai ah a om ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai pen puansan in a khuh ding ua; a khuhna ngalvang vun in a khuh ding uh, a zawnna chiang a thuah ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vaksak khawnvak koihna leh huai adia a zat ding ua khawnvakte, a taitehte, a vu koihnate, thau bing tengteng puandum buang in a khuh ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai leh a vanzat tengteng a khuhna ngalvang vun a khuh in a zawnna ah a koih ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dangkaeng maitam puandum buang in a khuh ding ua, a khuhna ngalvang vun in a khuh nawn ding uh, a zawnna chiang a thuah ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mun siangthou, a vanzat leh tuium-belsuan tengteng a la vek ding ua, puandum buang in a tun ding ua, a khuhna ngalvang vun in a khuh ding uh, a zawnna ah a koih ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Maitam a meivu a lamang ding ua, a tung ah puansandup a phah ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A tung ah a nasep vialvialna uh tuium-belsuan tengteng, mei laknate, sa thukna sikkhutte, vutluahnate, tuikuangte leh maitam tuium-belsuan tengteng a koih ding uhi. A khuhna ngalvang vun in a khuh ding ua, a zawnna a bulh ding uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aron leh a tapate’n Mun Siangthou leh Mun Siangthou van tengteng om mun suan dia a khuh khit chiang un; huaikhit chiang in a zawng ding in Kohath tapate a hongpai ding uhi. Himahleh thil siangthou himhim a khoih ding uh ahi kei, huchilou in zaw a si kha ding uhi. Hiaite Kihoupihna puanin a Kohath tapate nasep ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Siampu Aron tapa Eleazar sep ding, det ding thau, gim namtui, niteng a tangbuang thillat, nilhchi thau, biakbuk, huai a thil om tengteng, Mun Siangthou leh a vante ngaihtuah ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toupa’n Mosi leh Aron a houpih a:
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath suan inkuan zaw Levite lak apan satkhe kei un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh thil siangthoute khoihlou a, silou a a om theihna ding uh hichibang ahi. Aron leh a tapate lut uhenla, a sep ding uh leh a tantuam ding chiat uh sehsak uhen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh a kikhuh lai teng thil siangthoute en ding in lut kei uhen, a lut uleh a si ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="22" style="v" />Gershon tapate leng a inkuan kuan un, a khang a khangun simvek in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kum sawmthum apan a tunglam kum sawmnga a upa tan in nasepna Kihoupihna puanin a semthei ding teng zah simvek in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gershon suante tantuam naseplam leh puaklam hiai ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Biakbuk puanzakte, kihoupihna puanin, a khuhnate, a tung khuhna ngalvang vun, Kihoupihna puanin kongkhak puanzak;
  </para>
  <para style="p">
    <verse number="26" style="v" />intual puanzakte, intual kongkhak puanzakte, a biakbuk leh maitam bul a, a khaute leh a vanzat tengteng uh toh a pua ding ua, sep dia kiphamoh peuhmah a sem ding uh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gershon suante nasep, a seplam leh puaklam ah a tantuan tengteng uh Aron leh a tapate’n a sep ding ua; a hih ding uh banghiam nengneng tan a sehsakin huaite a sem ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huaite Kihoupihna puanin a Gershon suante nasep ahi. A hih ding uh siampu Aron tapa Ithamar seh ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari tapate, a khang a khangun, a inkuan kuan un na sim ding ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kum sawmthum apan a tunglam kum sawmnga a upa tan in Kihoupihna puanin a sem ding zah na simvek ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kihoupihna puanin a a nasep uh, a tantuam ding uh hiaite ahi. Biakbuk khuam lepkhawmte, a bangkalte, a khuamte, a kingakna khuakkuakte;
  </para>
  <para style="p">
    <verse number="32" style="v" />a intual umna khuamte, a kingakna khuakkuakte, a kilhbelhnate, a khaute, a vanzat tengteng leh a vanzat dang tengteng puak. A min uh lou chiat in a tantuam ding uh na sehsak ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huaite siampu Aron tapa Ithamar heu a Kihoupihna puanin a Merari tapate suante’n a hih ding uh banghiam nengneng tan a a nasep dan ding uh ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in Mosi leh Aron leh khawmpi lak a lupente’n Kohathte tapate a khang a khangun, a inkuan kuanun a simta uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kihoupihna puanin a nasepna ading in michih nasem dia kisate, kum sawmthum apan a tunglam kum sawmnga a upa chiang.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huaite a khang a khang a a sim uh sang nih leh za sagih leh sawmnga ahi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hiaite ahi uh, Kihoupihna puanin a na sem Kohathte suan a simte uh, Mosi zang a Toupa thupiak bang a Mosi leh Aron in a simte ahi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hiaite a inkuan kuan a, a khang a khang ua kisim, Gershon tate ahi uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kum sawmthum apan a tunglam kum sawmnga a upa tan Kihoupihna puanin nasepna adia michih nasem dia kisate.
  </para>
  <para style="p">
    <verse number="40" style="v" />A khang a khang a, a inkuan kuan ua a simte uh sang nih leh za guk leh sawmthum ahi uh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huaite ahi uh, Gershon tapate suante, Kihoupihna puanin a nasem teng, Toupa thupiak bang a Mosi leh Aron in a simte uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huaite a inkuan kuan ua, a khang a khang ua, Merari tapate a simte uh ahi,
  </para>
  <para style="p">
    <verse number="43" style="v" />Kihoupihna puanin a sem ding a nasem zah ding, kum sawmthum apan a tunglam kum sawmnga a upa chiang.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huai a khang a khang a, a inkuan kuan ua a simte uh sang thum leh za nih ahi uh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Hiaite Merari tapate suante a sim uh, Mosi zang a Toupa thupiak bang a Mosi leh Aron in a simte ahi uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosi leh Aron leh Israelte lupente’n a khang a khang a, a inkuan kuan a, a simte uh avek un huaiteng ahi uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Nasem ding leh Kihoupihna puanin a puakchi pawmi ding zah, kum sawmthum apan a tunglam kum sawmnga a upa chiang.
  </para>
  <para style="p">
    <verse number="48" style="v" />A simte uh sang giat leh za nga leh sawmgiat ahi uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mosi zang a Toupa thupiak bang a michih a sep ding leh a tantuam ding dungzui zel a sim ahi. Hichibang in Toupa’n Mosi thu a piak bang a sim ahi uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante a giahna mun ua kipan phak tengteng leh sipawt tengteng leh misi ziak a buah peuhmahte pawtkhe sakvek ding in thupia in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Numei leh pasal pawt khesak in giahphual pua ah na koih ding ahi. A laitak a ka omna giahna mun a buahsak louhna ding un, a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Israel suante’n huchibang in a hih uhi, dainawl ah a koihkhia ua; Toupa’n Mosi kiang a a gen bang in Israel suante’n a hih uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel suante kiang ah gen inla, pasal hiam, numei hiam in Toupa tung ah thil bang peuh na hihkhial in mawhta leh;
  </para>
  <para style="p">
    <verse number="7" style="v" />a hihkhelhna ah thupha a tawi ding ahi. A hihkhelh man pen kim tak in adin dia, a mun nga a khen, mun khat a hihkhelh napa a piak behlap ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh huai mi in khelh man piakna ding tanau nai a neihkei leh, khelhman pen Toupa a tuam ahi dia, a khelhman leh a khialpa adia kilemna bawlsakna belampa pen siampu kiang a piak ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel suante thil siangthou vei thillat tengteng, siampu kiang a lat peuhmah siampu a tuam ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Michih thil siangthou siampu a tuam ahi dia, mite’n siampu a piak peuhmah a ma a tuam ahi ding, chi in, a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel suante kiang ah gen inla, a kiang uah, Mi, a zi in a lampialsan a, mi’n amah luppih henla, a pasal in theikei leh,
  </para>
  <para style="p">
    <verse number="13" style="v" />huchibanga a om nilouh a, kihihthanghuai pipi a ki genkhe nai lou hi in, a thei kuamah omlou, mat louh hi leh;
  </para>
  <para style="p">
    <verse number="14" style="v" />a pasal thikthu hong sia a, a zi muangmoh a, siangthoulou mah a na hihleh, ahihkeileh a pasal thikthu hong sia a, a zi muangmoh a, a zi siangthou a na hihleh:
  </para>
  <para style="p">
    <verse number="15" style="v" />huai mi in a zi adia thillat barli buh tangbuang ephah mun sawm a khen, mun khat tawi in a zi siampu kiang ah a pi ding hi. A thillat ding sathau a buak ding ahi kei a, begaw leng a nuh ding ahi sam kei. Thikthusiatna tangbuang thillat, theihgigena thillat, thulimlouhna theihgigena ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Siampu in a zi a pi dia, Toupa ma ah a dingsak dia:
  </para>
  <para style="p">
    <verse number="17" style="v" />Siampu in leibel in tui siangthou a la dia, biakbuk pialkhang a leivui a la dia, tui ah a khe ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Siampu in huai numei Toupa ma ah a dingsak dia, a sam a khah khiak sak dia, theihgigena tangbuang thillat a tawisak dia; siampu in hamsia tungsak tui kha a khut in a tawi ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Siampu in huai numei a kichiam sak dia, numei kiang ah, Na pasal hilou midang kuamah in hon luppih kei a, nitna lam a na lampial kei leh hamsia tungsak hiai tui kha apan na hul ding.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh lampialsan a na kihihnit a, na pasal lou mi kuahiam in a hon luppih leh na hul kei ding, a chi ding.
  </para>
  <para style="p">
    <verse number="21" style="v" />Siampu in numei a vau dia, a kichiamsak ding. Numei kiang ah siampu in, Toupa’n na pheipi a zawtsak a, na gil a puaksak leh, Toupa’n na chipihte lak ah hamsethuak in nang honbawl hen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hamsia tungsak hiai tui na gil ah a lut dia, na gil a puaksak dia, na pheipi a zawsak ding. Numei in, Amen, Amen, a chi ding.
  </para>
  <para style="p">
    <verse number="23" style="v" />Siampu in huai hamsia thute laibu ah a gelh dia, tui kha ah a diah ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hamsia tungsak tui kha numei a dawnsak ding ahi. Huchi in hamsia tungsak tui kha a gil sung ah a lut dia, a hong kha ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Siampu in thikthusiatna thillat tangbuang numei khut apan a la dia; Toupa ma ah tangbuang thillat a vei dia, maitam ah a paipih ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Siampu in tangbuang thillat theihgigena pham khat a la dia, maitam ah a hal dia, huaikhit in tui numei a dawnsak ding ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tui a dawnsak leh hichi ahi dia; a hong nit a, a pasal tung a thil hihkhial a na hihleh hamsia tungsak huai tui a gil sung ah a lut dia, a hong kha dia, a gil a hong puak dia, a pheipi a hongzaw dia; huchi in numei a chipihte lak a hamsia thuaknu a honghi ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh numei a nit kei a, a sianthou leh a hul dia, nau a pai thei ding.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiai zi lampial a, a pasal hilou midang toh kihihnin hiam,
  </para>
  <para style="p">
    <verse number="30" style="v" />ahihkeileh a pasal thikthu hong siat a a zi a hazat chiang a vaihawm ding dan ahi. Huchi in Toupa ma ah a pi dia, siampu in hiai dan tengteng bang in a tung ah a hih ding.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in pasal pen thulimlouhna ah a hul dia, numei in a khelhna mawh a paw ding hi, chi in, a chi hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante kiang ah gen inla, a kiang uah, pasal hiam, numei hiam in leng banghiam thuchiam tuam, Toupa adia a kipiakna Nazarit thuchiam a chiam lai in uain leh zu a ngawl ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uain thuk, zu thuk leh grep tui a dawn ding ahi kei a, grep mindup hiam, minvuai hiam leng a ne ding ahi sam kei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A kihihtuam sungteng grepgui apan a tang leng, a hawng leng a ne ding ahi kei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kihihtuamna thu a chiam sungteng a lu leng a met louh hial ding ahi. Toupa adia a kihihtuam sung ni a kim mateng hihtuam ahi dia, a sam a hawi ding ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa adia a kihihtuam sungteng misi luang a naih ding ahi kei.
  </para>
  <para style="p">
    <verse number="7" style="v" />A pa, a nu, a unaupa, a unaunu hiam sih thu ah leng a kihihnin ding ahi kei hi; Pathian adia a kihihtuamna in amah a gak ziak in.
  </para>
  <para style="p">
    <verse number="8" style="v" />A kihihtuam sung teng Toupa a tuam ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kiang ah mi hong siguih in, a kihihtuamna lutang hon hihnin kha taleh, a kisiansak ni, a ni sagih ni’n a lu a met ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A ni giat ni’n Kihoupihna puanin kongkhak a siampu kiang ah vakhu kopkhat hiam, vapal nou kopkhat hiam a hontawi ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Siampu in khat khelh thoihna ding in a lan dia, a khat pen haltum thillat ding in, misi ziak a a hihkhelhna ah kilemna a bawlsak ding. Huai ni mah in a lu a hih siangthou ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A kihihtuamna nite Toupa kiang a pia in khelh thoihna ding in belamnoupa kum khat a upa a hontawi ding hi. Himahleh a kihihtuamna hihnit a hihtak ziak in a mangta ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai Nazaritmi dan ahi: A kihihtuamna ni a bukim chiang in Kihoupihna puanin kongkhak a pi ahi ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toupa adia thillat ding in belampa kum khat a upa gensiatbei haltum thillat ding in khat, khelh thoihna ding in belamnounu kum khat a upa gensiatbei khat, lemna thillat ding in belampa gensiatbei khat,
  </para>
  <para style="p">
    <verse number="15" style="v" />silngou sohlouh tanghou leh tangbuang nel mahmah thau a mek tanghou leh tangbuang nel mahmah thau a mek tanghou beu leh thau a zut tanghoupek bawm khat, a tangbuang thillat ding uleh dawn thillat dingte toh a lan ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Siampu in huaite Toupa ma ah a lan dia, a khelh kithoihna leh a haltum thillat a lan ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Belampa pen palbawm a tanghou silngou sohlouh toh lemna kithoih thillat Toupa kiang ah a lan dia; siampu in tangbuang thillat leh dawn thillat mah leng a lan tel ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nazaritmi in Kihoupihna puanin kongkhak ah a kihihtuamna lu a met dia, a kihihtuamna sam a ladia, lemna kithoihna thillat nuai a mei ah a haltum ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Siampu in belampa liang huan min leh bawm a silngou sohlouh tanghou khat leh silngou sohlouh tanghou pek khat a la dia, Nazaritmi in a kihihtuamna lu a met khit in a tawisak ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Siampu in vei thillat ding in Toupa ma ah a vei ding ahi. Hiai siampu a tuam ahi ding, awm vei leh liang vei toh. Huaikhit in Nazaritmi in uain a dawn theita ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiai ahi, Nazaritmi thuchiam dan leh Toupa ma a thillat dan. Amah ut thu a lat simlouh in a kihihtuamna thuchiam dungzui zel in a hih ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="23" style="v" />Aron leh a tapate kiang ah, hichibang in Israel suante na vualzawl ding ahi. A kiang uah,
  </para>
  <para style="p">
    <verse number="24" style="v" />Toupa’n nou hon vualzawl in honveng hen.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa’n a mel na tung uah vaksak henla, hon hehpih hen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa nou lam hong nga henla, lungmuanna nou honpia hen, chi in gen un, chi in a gen hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchibang a hih in Israel suante tung ah ka min tuansak ahi dia, amau ka vualzawl ding, a chi hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi in biakbuk a lamkhit a, thau a nilhkhit a, a hih siangthou khit a, van tengteng leh maitam leh tuium-belsuan tengteng thaunilh a, a hih siangthou ni’n hichi ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel intekpen, a inkuan ua intekpente’n thillat a lan ua, huaite a nam ua intekpente, a simte uh tung a omte ahi uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />A thillatte uh kangtalai tung nei guk leh bawngtal sawmlehnih, intekpen nih in kangtalai khat zel, khat in bawngtal khat zel Toupa ma ah a hon paipih ua, biakbuk ah a hong lan uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="5" style="v" />Biakbuk nasepna ding in a phatuam kha ding, na la chiat un; Levite, a nasep uh dungzui zel in na pe chiat ding hi, a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Mosi in kangtalaite leh bawngtalte a la a, Levite khut ah a pia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kangtalai nih leh bawngtal li Gershon tapate a nasep uh dungzui zel in a pia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kangtalai li leh bawngtal giat, siampu Aron tapa Ithamar, Merari tapate a nasep uh dungzui in a pia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kohath tapate bel Mun siangthou a nasep amau a tuam hi a, a nasep uh a zawnthoh a hih ziak in a pe kei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Intekpente’n thaunilh ni’n maitam latna dia a thillatte uh maitam bul ah a lan uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa’n Mosi kiang ah, Intekpen chih in maitam latna dia a thillat, a thillat uh amau tan hizel ding in a lan ding uhi, a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ni khat ni a thillat lan ding mi Judah chi Aminadab tapa Nashon ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik, dangkasik belhbu khat, tangbuang thillat ding in thau helsa tangbuang nel mahmah a dim tuaktuak;
  </para>
  <para style="p">
    <verse number="14" style="v" />Sekel sawm toh kikima gik gimlima dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="15" style="v" />Haltum thillat ding in bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="16" style="v" />Khelh thoihna ding in keltal khat;
  </para>
  <para style="p">
    <verse number="17" style="v" />Lemna kithoihna thillat ding in bawngtal nih, belamtal nih, belamtal nga, keltal nga leh belamnoupa kum khat a upa nga ahi a, hiaite Aminadab tapa Nashon thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni nih ni’n Issakar intekpente’n Zuar tapa Nethaneel in a lan hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A thillat ding in dangkasik kuang khat a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat ding thau toh hel tangbuang nel mahmah dim tuak;
  </para>
  <para style="p">
    <verse number="20" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="21" style="v" />Haltum thillat ding in bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="22" style="v" />Khelh thoihna ding in keltal khat;
  </para>
  <para style="p">
    <verse number="23" style="v" />Lemna kithoihna thillat ding in bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa nga a lan hi. Hiaite Zuar tapa Nethaneel thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ni thum ni’n Zebulun tate intekpen Helon tapa Eliab in a lan hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik, dangkasik belhbu khat; tangbuang thillat ding thau toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="26" style="v" />Sekel sawm toh kikima gik gimlima dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="27" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="28" style="v" />Khelh thoihna ding in keltal khat;
  </para>
  <para style="p">
    <verse number="29" style="v" />Lemna kithoih thillat ding in bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa nga ahi. Hiaite Helon tapa Eliab thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ni li ni’n Reuben tate intekpen Sedeur tapa Elizur in a lan hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A thillat dangkasik kuang khat a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat dia thau hel tangbuang nel mahmah a dimtuak;
  </para>
  <para style="p">
    <verse number="32" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="33" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="34" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="35" style="v" />Lemna kithoihna thillat ding in bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa nga ahi. Hiaite Sedeur tapa Elizur thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ni nga ni’n Simeon tate intekpen Zurisadai tapa Selumiel in a lan hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum; Mun Siangthou a sekel sawmsagih toh kikim a gik, dangkasik belhbu khat; tangbuang thillat ding in thau toh hel tangbuang nel mahmah a dimtuak;
  </para>
  <para style="p">
    <verse number="38" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="39" style="v" />Haltum thillat a lat ding in bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="40" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="41" style="v" />Lemna kithoih thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa nga. Hiaite Zurisadai tapa Selumiel thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ni guk ni’n Gad tate intekpen Deuel tapa Eliasaph in a lan hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat ding thau toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="44" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="45" style="v" />Halmang thillat ding bawngtal tuai khat, belamtal khat, belamnou a pa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="46" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="47" style="v" />Lemna kithoih thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa ngate Deuel tapa Eliasaph thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Ni sagih ni’n Ephraim tate intekpen Amihud tapa Eliasam in a lan hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat; haltum thillat ding thau toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="50" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="51" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnou a pa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="52" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="53" style="v" />Lemna kithoih thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa ngate Amihud tapa Eliasam thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="54" style="v" />Ni giat ni’n Manasseh tate intekpen Pedazur tapa Gamaliel in a lan hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat; tangbuang thillat ding thau toh hel, tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="56" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="57" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="58" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="59" style="v" />Lemna kithoihna thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa ngate Pedazur tapa Gamaliel thillatte ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Ni kua ni’n Benjamin tate intekpen Gideoni tapa Abidan in a lan hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat ding thau toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="62" style="v" />Sekel sawm toh kim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="63" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa;
  </para>
  <para style="p">
    <verse number="64" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="65" style="v" />Lemna kithoihna thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa nga ahi. Hiaite Gideoni tapa Abidan thillatte ahi uh
  </para>
  <para style="p">
    <verse number="66" style="v" />Ni sawm ni’n Dan tate intekpen Amisadai tapa Ahiezer in a lan hi.
  </para>
  <para style="p">
    <verse number="67" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat ding thau toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="68" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="69" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="70" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="71" style="v" />Lemna kithoih thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa nga ahi. Hiaite Amisadai tapa Ahiezer thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="72" style="v" />Ni sawmlehkhat ni’n Asher tate intekpen Okran tapa Pagiel in a lan hi.
  </para>
  <para style="p">
    <verse number="73" style="v" />A thillat dangkasik kuang khat, a gikdan sekel sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat ding thau toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="74" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangka keu khat;
  </para>
  <para style="p">
    <verse number="75" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="76" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="77" style="v" />Lemna kithoih thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat upa ngate Okran tapa Pagiel thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="78" style="v" />Ni sawmlehnih ni’n Naphtali tate intekpen Enan tapa Ahira in a lan hi.
  </para>
  <para style="p">
    <verse number="79" style="v" />A thillat dangkasik kuang khat, a gikdan sekel za leh sawmthum, Mun Siangthou a sekel sawmsagih toh kikim a gik dangkasik belhbu khat, tangbuang thillat ding thau toh hel tangbuang toh hel tangbuang nel mahmah a dim tuak;
  </para>
  <para style="p">
    <verse number="80" style="v" />Sekel sawm toh kikim a gik gimlim a dim dangkaeng keu khat;
  </para>
  <para style="p">
    <verse number="81" style="v" />Haltum thillat ding bawngtal tuai khat, belamtal khat, belamnoupa kum khat a upa khat;
  </para>
  <para style="p">
    <verse number="82" style="v" />Khelh thoihna ding keltal khat;
  </para>
  <para style="p">
    <verse number="83" style="v" />Lemna kithoih thillat ding bawngtal nih, belamtal nga, keltal nga, belamnoupa kum khat a upa ngate Enan tapa Ahira thillatte ahi uh.
  </para>
  <para style="p">
    <verse number="84" style="v" />Maitam thau nilh ni a Israel intekpente thillatte dangkasik kuang sawmlehnih, dangkasik belhbu sawmlehnih leh dangkaeng keu sawmlehnih ahi.
  </para>
  <para style="p">
    <verse number="85" style="v" />Dangkasik kuang sekel za leh sawmthum toh kikim a gik chiat ahi a, belhbu sawmsagih chiat ahi. Dangkasik tuium-belsuan tengteng Mun Siangthou a sekel sang nih leh za li toh kikim a gik ahi.
  </para>
  <para style="p">
    <verse number="86" style="v" />Gimlim a dim dangkaeng keu sawmlehnih Mun Siangthou a sekel sawm toh kikim a gik chiat ahi. Dangkaeng keu tengteng sekel za leh sawmnih toh kikim a gik ahi.
  </para>
  <para style="p">
    <verse number="87" style="v" />Haltum thillat ding bawngtal tengteng sawmlehnih ahi a, belamtal sawmlehnih, belamnoupa kum khat a upa sawmlehnih, a tangbuang thillatte uh toh. Khelhna thoihna ding keltal sawmlehnih.
  </para>
  <para style="p">
    <verse number="88" style="v" />Lemna kithoihna thillat ding bawngtal sawmnih leh li ahi a, belamtal bel sawmguk, keltal sawmguk, belamnoupa kum khat a upa sawmguk ahi. Hiai thau nilh khit a maitam latna dia thilpiakte ahi uh.
  </para>
  <para style="p">
    <verse number="89" style="v" />Huchi in biakbuk a amah be dia Mosi a lut in thukhun bawm tung a chitna tutphah tunglam a Cherub nihte kikal apan amah hon houpih aw a za hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Aron houpih inla, a kiang ah, Khawnvak na det chiang in khawnvak sagihte’n sathau khawnvak koihna malam a tatvak ding uh ahi, chi in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aron in huchibang in a hih a; Toupa’n Mosi thu a piak bang in khawnvak koihna malam ah khawnvakte a de hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiai khawnvak koihna ahihleh dangkaeng a sekthoh chi ahi a; a mung bul a kipan a paktan a sekthoh ahi. A lim Toupa’n Mosi a etsak banggeih a khawnvak koihna bawl ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="6" style="v" />Levite, Israel suante lak apan hihtuam inla, hihsiangthou in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amaute hihsiangthou ding in hichibang in na hih ding ahi. A tung uah sawpsiangna tui sung inla, a pumpi tengteng uh metsak inla, a puante uh sawpsak inla, kihih siangthousak in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bawngtal tuai khat tangbuang thillat thau toh hel tangbuang nel mahmah toh lasak inla, khelh thoihna ding in bawngtal tuai khat dang leng na kaisak ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Levite Kihoupihna puanin bul ah pi inla, Israel suan omkhawm tengteng ki gawmkhawm sakvek in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Levite Toupa kiang ah na lan dia; Israel suante’n Levite tung ah a khut uh a nga ding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Aron in Levite, Toupa na a sep theihna ding un Israel suante min in vei thillat Toupa kiang ah a lan ding.
  </para>
  <para style="p">
    <verse number="12" style="v" />Levite’n bawngtalte lutung ah a khut uh a nga ding ua; Levite adia kilemna bawlna ding in, khat, khelh thoihna ding in, a khat pen haltum thillat ding in Toupa kiang ah a lan ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Levite Aron leh a tapate ma ah na omsak dia, Toupa ading in vei thillat ding in na lan ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchibang in Israel suante lak apan Levite na hihtuam dia, huchi in Levite kei a ahi ding uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huaikhit in Levite Kihoupihna puanin nasem ding in a lut ding ua, nang amaute na hihsiangthou ding, vei thillat ding in na lan ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel suante lak apan kei a tuam dia seh ahi ngal ua. Sul hong tengteng, Israel suante ta masapen teng tang in kei ading in ka neita hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israel suante lak a ta masapente, mihing toh ganta toh kei a ahi him uhi. Aigupta gam a ta masapente ka sihsak lai in kei a tuam dia ka sehsa ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in Israel suante lak a ta masapente tang in Levite ka nei khinta ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in Israel suante tang a Kihoupihna puanin a nasem ding leh Israel suante’n Mun Siangthou a honnaih ua leng Israel suante lak a hi a len louhna dia lemna bawl ding in Israel suante lak apan Levite Aron leh a tapate ka pia ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchibang in Mosi, Aron leh Israel suan omkhawm tengteng in Levite tung ah a hihta uhi. Levite tungtang thu a Toupa’n Mosi thu a piak tengteng bang in a tung uah Israel suante’n a hih uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Levite siansak ahi ua, a puante uh a sawp ua; Aron in Toupa ma ah vei thillat ding in a lan hi. Amau hih siangthouna ding in Aron in kilemna a bawlsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huaizoh in Levite Aron leh a tapate nuai a, a nasep uh sem ding in Kihoupihna puanin sung ah a lut uhi. Levite tungtang thu a Toupa’n Mosi thu a piak bang in a tung uah a hihta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="24" style="v" />Levite tantuam hiaite ahi. Kum sawmnih leh nga chiang tunglam in Kihoupihna puanin a nasep a sem ding uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kum sawmnga a upate’n a nasep uh a khawlsan ding ua, na a sem nawn kei ding uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh khawmpite biakbuk kep thu ah a unaute uh a huh zel ding ua, nasep zaw a sem nawn kei ding uh. Hichibang in Levite nasep na gel sak ding ahi, a chi hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Aigupta gam apan a hongpawt nung uh kum nihna, kha khatna in Sinai gamdai ah Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante’n Paikan Ankuangluina a hunbi zel in nei uhen.
  </para>
  <para style="p">
    <verse number="3" style="v" />A hunbi in, hiai kha, ni sawmlehli nitaklam in na nei ding uhi. Huai a hih dia seh tengteng leh dan bang in na nei ding uhi, a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Mosi in Israel suante Paikan Ankuangluina nei ding in a hilh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Sinai gamdai ah kha khatna, a ni sawmlehli ni nitaklam in Paikan Ankuangluina a neita uhi. Toupa’n Mosi thu a piak bangzel in Israel suante’n a hih uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kuate hiam misiluang ziak a sianglou a na om ua, huai ni’n Paikan Ankuangluina ah a tel theikei ua, huchi in huai ni’n Mosi leh Aron ma ah a hoh uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaite’n a kiang ah, “Misi luang ziak in sianglou ka hi ua; huaiziak in hia, Israel suante lak a a hunbi a Toupa kiang a thillat ka lat sam uh kham ka hih uh?” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi in a kiang uah, “Na pau kei phot dih uh. Na tungtang thu uah Toupa’n bangchi’n ahia thu a honpiak k’on za masa phot ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel suante kiang ah, Na lak ua kuapeuh, na suante uh lak a kuapeuh, misi luang ziak a sianglou hiam, a na zinmang hiam a om zenzen uleh Toupa ading in Paikan Ankuangluina neih himhim ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kha nihna, ni sawmlehli ni nitaklam in a nei ding ua; tanghou silngou sohlouh loukha toh a nekding uh ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A zing ading in bangmah a koih ding uh ahi kei. A guh leng a hihtan ding uh ahi kei. Paikan Ankuangluina a hih dia seh bang zel a a hih ding uh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh, siang ngal a, zinmangna neilou, Paikan Ankuangluina a tellou mawkmawk ahihleh a chipihte lak apan huai mi satkhiak ding ahi. A hunbi a Toupa kiang a thillat a latlouh ziak in huai mi in a khelh mawh a kipuak ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Namdang mi na kiang ua om in Toupa adia Ankuangluina a telsam a ut leh Paikan Ankuangluina a hih dia seh leh a dan bang in a hih ding ahi. Hiai gam a mi mawng leh namdang mite adia dan kikhat na neih ding uh ahi, chi in gen in, a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in biakbuk lamkhit ni’n biakbuk, theihpihna puanin pen meipi in a tuam lii liai hi. Nitaklam in biakbuk tung ah meikuang bangbang a zingsang tan in a om hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchibang in a om nilouh a; meipi in a tuam nilouh a, zan chiang in mei bang in a kilang hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Meipi in puanin a kikhinsan teng in Israel suante’n pai ding vai a hawm zel ua; meipi a khawlna mun peuh ah Israel suante’n giahphual a satzel uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa thupiak in Israel suante a pai zel ua, Toupa thupiak mah in giahphual a sat uhi. Biakbuk tung a meipi a omsung teng giahphual ah a om nilouh uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Biakbuk tung a meipi sawtpi a om leh Israel suante’n Toupa thu a zui ua, a paikei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Meipi biakbuk tung a ni tamlou sung a om chiang in giahphual a sat ua, Toupa thupiak bang in, huchi in a pai zel uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kalkal in meipi nitaklam apan a zingsang pha in a om a; zingsang a meipi in a tung kahsan leh a pai zel uh. Ni khat lel hiam, zan khat lel hiam om a meipi in a tungkah san leh a pai zel uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Biakbuk tung a meipi ni nih hiam, kha khat hiam, kum khat hiam a om a, huai a a om nilouh leh Israel suante giahphual ah a om nilouh ua, a paikei uh. A tung kahsan leh bel a pai zel uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa thupiak in giahphual a satzel ua, Toupa thupiak in a pai zel uh. Mosi zang a Toupa thupiak in Toupa thu a zui uhi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Dangka pengkul nih bawl inla; sekthoh in bawl in. Mipite sapkhawmna ding leh pawtsakna dia na zat ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai a kimut chiang in mipi tengteng na kiang ah Kihoupihna puanin kongkhak bula a hong kikhop vek ding uh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khat lel a mut uleh Israel mipite heutu intekpente kia na kiang a a hong paikhawm ding uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gallau mut a na mut uleh suahlam pang a omte a pawt ding uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gallau mut a na mutnawn uleh simlam pang a omte a pawt ding uhi. A pawtna ding un gallau mut bang a a mut ding uh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh mipite hong paikhawmna ding in na mut peuhmah ding ua, gallau mut a bel mutlou in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aron tapa siampute’n pengkul a mut ding uh ahi. Huai nou ading in na suante uh tan a tangtawn dan ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na gam ua melma, nou hon nuaisiahte dou dia na kuan chiang un gallau mut in pengkulte na mut ding uhi. Huchi in Toupa na Pathian ma uah theihgigena ahi ding ua, na melmate ua pan humbit na hi ding uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nuam nasak nite un, a hunbi a na ankuangluinate uah, na kha thakte uah, na haltum thillat uahte leh na kilemna thillat kithoihnate uah pengkul na mut ding uh ahi. Huchi in na Pathian ma uah nou ading in theihgigena ahi ding. Kei Toupa na Pathian uh ka hi, chi in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kum nihna, kha nihna, huai kha ni sawmnih ni’n, hichi ahi a, meipi in theihsakna biakbuk tung a tungkah santa hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in Israel suante a paidan dungzui in Sinai gamdai apan a pawt ua; Paran gamdai ah meipi a khawlta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi zang a Toupa thupiak bang in a pawt uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A masapen in Judah pawlte, a pawl uh tamdan dungzui zel in a pawt ua; a heutu uh Aminadab tapa Nashon ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Issakarte heutu Zuar tapa Nethaneel;
  </para>
  <para style="p">
    <verse number="16" style="v" />Zebulunte heutu Helon tapa Eliab ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Biakbuk a phel ua, Gershon tapa leh Merari tapa biakbuk zawngmite a pawt uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Reubente a pawl uh tamdan dungzui in a pawt ua; a heutu uh Sedeur tapa Elizur ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Simeonte heutu Zurisadai tapa Selumiel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gadte heutu Deuel tapa Eliasaph ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kohathte’n Mun Siangthou a zawng ua, a pawt ua; a dangte’n a tun ma un biakbuk a na lam uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ephraimte a pawl uh tamdan dungzui in a pawt ua; a heutu uh Emihud tapa Elisama ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Manassehte heutu Pedazur tapa Gamaliel ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Benjaminte heutu Gideoni tapa Abidan ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A nanungpen in Dante a pawl uh tamdan dungzui in a pawt ua; a heutu uh Amisadai tapa Ahiezer ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Asherte heutu Okran tapa Pagiel ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Naphtalite heutu Enan tapa Ahira ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai bang ahi Israel suante pawl a tamdan dungzui ua a paidan uh, hiai bang in a paizom zel uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosi sungpa Midianmi Reuel tapa Hobab kiang ah, Mosi in, “K’on pe ding, Toupa’n a chihna mun ah ka pai ding ua, ka kiang uah hongsam inla, hoihtak in na tung ah ka hih ding uh. Toupa’n Israel suante tungtang thu lah hoih in a genta ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman a kiang ah, “Ka hong dahmai ding, ka gam uah ka tanaute kiang ah ka paizaw mai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman, “Hon paisan mahmah ken, gamdai ah lah giahphual satna ding na theizaw ngal a, kou ading in mit na honghi ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hichi ahi dia, ka kiang ua na hongsam leh, ahi, hichi ahi ding. Toupa’n thil hoih hon hihsak bang in k’on hihsak samzel ding uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in Toupa tang apan ni thum lam ah a pai ua; Toupa thukhun bawm amau adia kingakna mun zong in a ma uah ni thum lam ah a na pai masa hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />A buk ua pan a pawt un Toupa meipi sun in a tung uah a om hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichi ahi a, huai bawm a pawt ding peuhmah chiang in Mosi in, “ Toupa aw, hong kisa inla, na melmate hawlzak in, nang hon hawte na ma ah taikek uhen,” a chi zel hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />A kingakna peuh ah, Toupa aw, Israel mipi sang tampite kiang ah hong kiknawn in, a chi zel hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, mipite’n Toupa zak a phun in thil hoihlou pipi a gen ua; Toupa’n huai a zak in a hehta hi. Huchi in Toupa mei a lak uah a hong kuang a, giahphual pawnung pen a omte a kangta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in mipite’n Mosi a sam ua; Mosi Toupa kiang ah a thum a, huai mei a mitta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai mun min Taberah a sa hi, Toupa mei a lak ua a hong kat ziak in.
  </para>
  <para style="p">
    <verse number="4" style="v" />A lak ua mikihel pawl khat in sa lunggulhna a hon neita ua; Israel suante leng a kap nawn ua, “Kua’n ahia nekding sa honpe ding?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ut leh dah a Aigupta gam a ngasa i nekzelte i theigige ua, tangmaite, mazelte, phulun sialnek chite, vaiphulunte, phulun ngou leng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh tuin i guhngek uh a keu khinta, bangmah lamet ding a omkei, manna lel loungal” a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Manna bel koriander tang bang, a latdan in bedeli suang bang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mite’n a tomkhawm ua, gawinelna in a gawinel ua, sum in a su ua, belte ah a huan ua, tanghou in a bawl uhi. Nek in sathau a kan tanghou a bang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Giahphual a zan a dai a kiak in manna leng a hong kia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mipite a inkuan kuan un a puanin kongkhak chiat uah a kap uh, chih Mosi in a naza hi. Toupa a heh mahmah a; Mosi leng a lungkim kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Toupa kiang ah, “Bangziak in ahia na sikha n’on sukgim, bang ahia na mit ka tunlouhna, hiai mite tengteng puakgik ka tung a na ngak?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiai mipite tengteng ka suan ahi ua hia? A pi leh pute uh kiang a kichiam a piak na chiam gam a pilut di’n. Naupommi in nawitui nelai a pom bang in na angsung ah pom in, n’on chih dia ka pikhiak?
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai mipi tengteng piak ding sa koi apan ka nei dia? ‘Ka nek ding un sa honpia in,’ chi in a kap ngal ua.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiai mipi tengteng keimah kia in ka paw zoukei. Kei ading in a gik lua hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichibang a honhih ding na hihleh, hon hehpih inla, hon sisak vanglak in, honhih genthei nawn mahmah ken” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n Mosi kiang ah, “Israelte Upa, mipite Upa leh a heutute uh hi a na theih mi sawmsagih ka kiang ah hon pikhawm inla, Kihoupihna puanin ah nangmah toh ding khawm di’n honpi in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in ka hongpawt dia, huai ah k’on houpih ding. Na tung a om kha om pen a tung uah ka koih ding. Nang kia’n pawlou in mipite puakgik a hon puakpih ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang mipite kiang ah, Zingchiang a ding in kihih siangthou vek unla; huchi in sa na ne ding uh. Sa nekding kuan ahia honpe ding? Aigupta gam a nuam i saksak utoh, chi in Toupa zak in na kap ua; huaiziak in, Toupa sa nou a honpe dia, huchi in na ne ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ni khat kia, ni nih kia, ni sawm kia, ni sawmnih kia leng na ne kei ding ua;
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh kha khat pumlum, na nakvang ua a hongpawt khiak a nou adia kihhuai a hong hih masiah na ne ding uhi. Na lak ua om Toupa na deihlouh ua, Aigupta gam apan bangdia paikhia i hi ua? chi a, a ma a na kah ziak un” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosi in, “Ka ompih mipite khe a paithei kia leng nuai guk ahi ua; kha khat pumlum nek ding in sa ka pe ding, na chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Belamhon leh ganhon leng gohsak lehang leng, a kham ding ua hia? Tuipi a ngasa tengteng leng matsak vek lengle, a khamzou ding ua hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n , Mosi kiang ah,“ Toupa khut a tomsak ahita hia? Na tung ah ka thu bang a, a tun leh tunlouh na theimai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mosi a pawt a, Toupa thu mipite a hilh hi. Mipite Upa sawmsagihte a samkhawm a, puanin kim ah a dingsak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa meipi ah a hongsuk a, a hong houpih a, amah tung a om Kha pen Upa sawmsagihte tung ah a koih hi. Hichi ahi a, kha a tung ua a koihtakin thu a gen ua; a genzom sawtkei uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh giahphual ah mi nih a omlai ua, khat min Eldad ahi, a khatpen min Medad ahi. Kha a tung uah a om a, upate lak a minkhum ahi ua, himahleh Kihoupihna puanin ah bel a hohkei uhi. Giahphual ah thu a gen uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in tangval khat a va tai a, Mosi a va hilh a, “Eldad leh Medad in giahphual ah thu a gen uh” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nun tapa Joshua, a tuailai apan Mosi nasempa’n a dawng a, “Ka toupa Mosi, kham ve” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosi in a kiang ah, “Kei gum a na thikthu sia hia? Pathian mi tengteng zawlnei hivek le uh, Toupa’n a tung uah tua Kha koihchiat leh chih zawmah lai ka hi!” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in Mosi leh Israel Upa tengteng giahphual ah a lut nawn uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toupa apan huih a hongnung a, tuipi apan vengkeng a hon mut leng a, giahphual lehlam sang ni khatlam, a lehlam ni khat lamtuak dimsuak in giahphual kim ah tong nih ding a sang in a kesak hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mipite’n huai ni nitum leh zankhua leh a zing nitum in vengkeng a va tomkhawm ua; a tom tawmpen in leng homer sawm a tom hi. Giahphual kim ah amau a chiat a phou uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai sa a neklai un, a nek khit ma un, mipite tung ah Toupa a heh mahmah a, mipite hipi thupi mahmah in Toupa’n a gawtta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hiai mun min Kibroth-hattaavah a sa a; huai a saduhte a vui ziak un.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kibroth-hattaavah apan mipite Hazeroth ah a pai ua; Hazeroth ah a giahphual a sat uhi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Miriam leh Aron in Mosi in Kus numei zi a, a neih ziak in a gensia ua; Kus numei bel a neingei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amau, “Mosi kiang kia ah hia Toupa’n thu a gen tuam? Ei kiang ah leng a gensam ka hia?” a chi uh. Toupa’n huai a naza hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi bel leitung a mihing tengteng sang in a migi mahmah ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thakhat in Toupa’n Mosi, Aron leh Miriam kiang ah, “Na thum un hong paisuk unla, kihoupihna puanin ah hongpai un:” a chi hi. Huchi in a thum un a va hoh uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toupa meipi ding ah a hong paisuk a, puanin kongkhak ah a hong ding a, Aron leh Miriam a sam a; a nih un a hong paisuk uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman, “Ka thu ngaikhia un. Na lak ua zawlnei na om uleh amah kiang ah kei Toupa kilakna in ka kihil dia, manglam in ka houpih ding.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka sikha Mosi bel huchibang ahi kei. Ka inkaw tengteng ah a muanhuai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah toh paukam in thuguk omlou in teltak in ka kihou ding ua; Toupa mel leng a mu ding. Huaiziak in ka sikha Mosi bangchidan a gense ngam na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Toupa a tung uah a heh mahmah a, a pai nawnta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Puanin tung a meipi a kikhinta hi. Ngai in, Miriam vuk bang a ngou in a hong phakta a; Aron in Miriam a en a, ngai in, phak a na hita maimah hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Aron in Mosi kiang ah, “Ka toupa aw, ka tung uah khelhna nga mahmah ken. Haihuaitakin ka na hihta ua, ka na khialta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A nu sul apan sisa phial mahmah a a hongpawt bang in amah omsak ken” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in Mosi in, “Pathian aw, damsak nawn dihve:” chi in Toupa a ngen hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toupa’n Mosi kiang ah, “A pa’n a mai chilsiat hilhial leh leng ni sagih a zakta kei ding maw? Giahphual pua ah ni sagih kibu henla; huaikhit chiang in pilut nawn hi hen” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in giahphual pua ah ni sagih sung Miriam khumtuam in a om hi. Miriam a pilut nawn ma un mipite a kisuan kei uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huaikhit in mipite Hazeroth apan a pawt ua, Paran gamdai ah giahphual a sat uhi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel suante ka piak, Kanan gam va enkhe ding in mi sawl in. A nam inkaw chih ua mi, a intekpa pen lak a mi khatchiat na sawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi in Paran gamdai apan Toupa thupiak bang in a kuansakta a; avek un Israel suante lak a intekpa pen chiat ahi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiaite a min uh ahi: Reuben nam lak a mi Zakur tapa Shammua.
  </para>
  <para style="p">
    <verse number="5" style="v" />Simeon nam lak a mi Hori tapa Shaphat.
  </para>
  <para style="p">
    <verse number="6" style="v" />Judah nam lak a mi Jephunneh tapa Kaleb.
  </para>
  <para style="p">
    <verse number="7" style="v" />Issakar nam lak a mi Joseph tapa Igal.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ephraim nam lak a mi Nun tapa Oshea.
  </para>
  <para style="p">
    <verse number="9" style="v" />Benjamin nam lak a mi Raphu tapa Palti.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebulun nam lak a mi Sodi tapa Gaddiel.
  </para>
  <para style="p">
    <verse number="11" style="v" />Joseph nam, Manasseh nam a chih uh, lak a mi Susi tapa Gaddi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dan nam lak a mi Gemalli tapa Ammiel.
  </para>
  <para style="p">
    <verse number="13" style="v" />Asher nam lak a mi Mikael tapa Sethur.
  </para>
  <para style="p">
    <verse number="14" style="v" />Naphtali nam lak a mi Vophsi tapa Nahbi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gad nam lak a mi Maki tapa Geuel.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiaite gam enkhe dia Mosi in a sawlte min ahi. Nun tapa Oshea Mosi in Joshua a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Mosi in Kanan gam enkhe ding in amaute a sawl a, a kiang uah, “Simlam lampi ah paiphot unla, tangte ah kahtou un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai gam bangchibang ahia, huai a teng mipite a hat uh hia, hatlou, a tawm uh leh a tam uh;
  </para>
  <para style="p">
    <verse number="19" style="v" />A tenna gam uh a hoih hia hoihlou, a omna khuate uh bangchibang ahia, puanin maimah hia, kulh nei;
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai gam lei thau ahi hia, lei gawng, gammang om hia omlou chih va enkhia un. Hangsantak in om unla, huai gam theigahte honpua un” a chi hi. Tu grep gah masa gah hun laitak ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in a kuan touta ua, huai gam Jin gamdai apan Hamath lutna Rehob tan in a enkhe vek uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Simlam ah a hohtou phot ua, Hebron a va tung ua, huai ah Anak suan Ahiman, Sesai leh Talmai a om uhi. Hebron bel Aigupta gam a Zoan kilam ma kum sagih a kilam khinta ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Eskil guam a va tung ua, huai ah grep gahbom khat a hiang toh a sattan ua, chiang in mi nih in a zawng uhi. Theibuhfai leh theipite leng a pua uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai mun Eshkol phaizang a sa ua; Israel suante’n huai a grep bom a satkhiak ziak un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ni sawmli zoh in gam etkhiakna apan a hong kiknawnta uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in Paran gamdai a Kadesh ah Mosi leh Aron leh Israel suan mipi tengteng kiang a hongtung ua, a kiang uah leh mipi tengteng kiang ah thu a hontun ua, huai gam theite a ensak uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A kiang ah, “N’on sawlna gam ah ka va hoh ua, bawngnawi leh khuaizu luanna a na hingei ngut a; hiai a gam thei ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh a gam a mi tengte mi hat pipi ahi ua, khuate leng kulh nei, thupi taktak ahi. Anak suante leng ka va mu uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amalekte simlam gam ah a teng ua; Hitte, Jebuste, Amorte, tang gam ah a teng uh. Kanante tuipi gei leh Jordan lui dung ah a teng uh” chi in a hilh uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in Mosi ma ah Kaleb in mipite a daisak khipkhep a, “Kisa tou zok ni, va latou zok ni, i zou ngeingei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh a hohpihte’n, “I va zou thei vek kei ding e, ei sang in lah a hatzaw ngal ua” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in Israel suante kiang ah, “Ka va gam etkhiak uh gam, enkhe dia ka va vakna uh, asung a mi tengte nekkhit hatmi ahi ua; a mi om ka muhte uh mi awmkhauh pipi ahi uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai ah Anak suante, miliante, awmkhauh pipi ka va mu ua; khaupe banglel in ka va kimu ua, amau leng khaupe ek banglel in a honmu uh” chi’n a hoihlou lam in a gen uhi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan omkhawm tengteng aw suak in a kap ua; huai zan in mite a kap uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suan tengteng Mosi tung leh Aron tung ah a phun ua; omkhawm tengteng in a kiang uah, “Aigupta gam ah Pathian in honthat geih hileh aw! Ahihkeileh gamdai ah hon na that geih hileh aw!
  </para>
  <para style="p">
    <verse number="3" style="v" />Bang a chia namsau a si maimah dia Pathian in hiai gam a honpi ahi diam aw? I zi leh i tate lah mat maimah ding ahi ngal ua. Aigupta gam a kiknawn ei adia hoihzaw lou ding hia? a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in a kihou khawm ua, heutu bawl ni e, Aigupta gam ah kiknawn ni” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Mosi leh Aron Israel suan mipi omkhawm tengteng ma ah a khupboh uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nun tapa Joshua leh Jephunneh tapa Kaleb, gam va enkhete lak a telte’n a puan uh a botkek uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel suan omkhawm tengteng kiang ah, “Enkhe dia ka va vakna gam uh gam hoih tak ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />I tung ua Toupa a kipah leh huai gam ah a hon pilut ding. Huai nawitui leh khuaizu luanna gam a honpe ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa tung ah helkei phot le uchin. Huai gam a mite leng lau sam kei un. I an ding uh ahi ua, a kihumbitna uh bangmah ahi kei. Toupa i kiang uah a om hi, amau lau kei un” chi in a gen uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh omkhawm tengteng in suang a den a sawm ua; huchi in Toupa thupina Kihoupihna puanin, Israel suan tengteng ma ah a hong kilangta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Toupa’n Mosi kiang ah, “Hiai mipite’n bang tan hon thusim lou ding ahi ua; a lak ua chiamtehna ka hih zel nangawn a leng bang tan ahia hon taksan louh lai ding uh?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hipi in ka gawt dia, ka in-gamsak dia, nangmah ah amau sang a thupi leh thilhihthei zaw nam ka bawlkhe zawmai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi in Toupa kiang ah, “Aigupta mite’n a za kha ding uh. Hiai mite lah a lak ua pan na thilhihtheihna a na pikhiak ahi ngal ua.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiai gam a teng mite a hilh ding uh. Hiai mite lak ah nang Toupa na om chih a zata uh. Kimaituah hial a muh in na om a, na meipi a tung uah a om a; sun in meipi ding, zan in mei in a ma uh lah na pi zel hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiai mite na thahgam leh na minthanna za namte’n
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n hiai mite kichiam a, a chiam gam a a pi theihlouh ziak in gamdai ah a thatta hi, a chi ding uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuin k’on ngen ahi, ka Toupa thilhihtheihna hihthupi in om hen, thu a na gentak dungzui in;
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa lungneltak, migitna hau, thulimlouhnate, tatleknate ngaidam zel; mawh a a sehte khah ngeiloupa, pate thulimlouhna tate, tate tasawnte, suan thumna leh suan lina tan a gawtzel ahi, na chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na migitna a thupi bang ngei leh Aigupta gam apan tutan a na ngaihdam bang in mipite thulimlouhna ngaidam in” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toupa’n , “Na thu bang in ka ngaidam hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh kei ka hin bang in Toupa thupina in lei tengteng a dimsak ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aigupta gam leh gamdai a ka thupina leh ka thillamdang hihte mu a, huchi pipi a leng sawmvei tak hon ze-et lailai a, ka thu zuilou lai mi tengteng in;
  </para>
  <para style="p">
    <verse number="23" style="v" />a pipute uh kiang a kichiam a ka chiam huai gam a mu kei hial ding uh. A lak ua kei hon ngaineute mawngmawng in leng a mu sam kei ding uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka sikha Kaleb in bel lungsim dang a put a, a honzuih taktak ziak in, amah zaw a va hohna gam ah ka pilut dia, a suante’n huai a luah ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Phaizang a Amalekte leh Kanante teng uh ahihman in Zingchiang in kihei unla, Tuipi San lampi lam gamdai ah lut un” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa’n Mosi leh Aron a houpih a,
  </para>
  <para style="p">
    <verse number="27" style="v" />“Hiai mi thulimlou omkhawmte, ka tung a phunphunte bang tan ahia ka dohzoh ding? Israel suante phunna, ka tung a a phunnate uh ka za hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A kiang uah, Ka hinna lou in ka gen ahi, ka bilbuk ngei a na gen bang un na tung uah ka hih ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na luang uh gamdai ah a puk dia; na lak ua simsa mi tengteng, kum sawmnih apan a tunglam ka tung a phun teng,
  </para>
  <para style="p">
    <verse number="30" style="v" />Banzak hial a, k’on omsak ding, ka chih gam ah Jephunneh tapa Kaleb leh Nun tapa Joshua kia loungal na lut kei ding uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh mat ding lel ahi ding uh, na chih uh na tate uh ka pilut dia, na ngaihneu uh gam a thei ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Nou bel na luang uh hiai gamdai ah a puk ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na tate uh gamdai ah kum sawmli sung a vakvai ding ua, gamdai a na luangte uh a mawk man masiah na kizuakna uh amau a thuakloh ding uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gam na va etkhiak ni zah uh, ni sawmli, ni khat tang in kum khat zel, kum sawmli sung na tatlekna uh na thuak loh ding ua, huchi in ka thuchiam ka hihlamdan dan na thei ding uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kei Toupa’n migilou omkhawm, kei hon kalh a omkhawmte tung ah hiai ka hih ngei ding ka na chikhinta hi. Hiai gamdai ah a mangthang ding ua. Huai ah a si ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Gam enkhe dia Mosi mi sawl hong kiknawnte’n, gam omdan a hoihlou lam a gen un amah tung ah omkhawmte a phunsak hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huai gam omdan a hoihlou lam a gente ngei Toupa ma ah hipi in a sita uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Gam enkhe dia hohte lak a Nun tapa Joshua leh Jephunneh tapa Kaleb bel a si kei uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Mosi in huai thute Israel suan tengteng a hilh a; huchi in mipite’n nakpitak in a sun uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in zingsangpi in a thou ua, mualvum ah a hohtou ua, “Ngai in, hiai ah ka hongpai uh. Toupa’n a hon chiamna mun ah ka hoh ding uh, ka na khialta uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mosi in, “Tu a bangdia Toupa thupiak palsat na hi ua? Hiai a lohching kei ding.
  </para>
  <para style="p">
    <verse number="42" style="v" />Na kiang ua Toupa a omlouh ziak in hohtou kei un; melmate thah a na omlouhna ding un, a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Na ma uah Amalekte leh Kanante a om uhi. Namsau a thah na hi phet ding uh. Toupa na lehngatsan tak ziak un na kiang uah Toupa a omkei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Himahleh mualvum a hoh a tum ua; himahleh Toupa thukhun bawm leh Mosi giahphual apan a pawtkhe kei uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huchi in huai mual a om Amalekte leh Kanante a hong kuansuk ua, a hong dou ua, Hormah tanpha in a satpuk phengphung uhi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante houpih inla, a kiang uah, tenna ding a gam k’on piakna na tun chiang un,
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa kiang a mei a thillat ahihkeileh haltum thillat ahihkeileh thuchiam tangtun dia kithoihna ahihkeileh noumau ut thu a thillat ahihkeileh Ankuanglui hunbi ahihkeileh ganhon lak ahihkeileh belamhon lak ahihkeileh Toupa adia gimlim bawl ding a na lat chiang un,
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa kiang a thillat lan mi peuhmah in tangbuang thillat, tangbuang nelte ephah mun sawm a khen, mun khat, sathau hin mun li a khen, mun khat a mek a lat ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dawn thillat dia uain hin mun li a khen, mun khat haltum thillat ahihkeileh kithoihna belamnou khat adia na bawl ding uh ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Belamtal a tangbuang thillat, tangbuang nelte, ephah mun sawm a khen, mun nih, sathau hin mun thum a khen, mun khat mek na bawl ding uh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dawn thillat dia Toupa ading a gimlim ding uain hin mun thum a khen, mun khat na lat ding uh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Haltum thillat ding ahihkeileh thuchiam tangtun dia kithoihna ahihkeileh Toupa kiang a lemna thillat a bawngtal na lat chiang un;
  </para>
  <para style="p">
    <verse number="9" style="v" />Bawngtal lat toh kiton in tangbuang thillat tangbuang nelte ephah mun sawm a khen, mun thum sathau hin kimkhat a mek na lat ding uh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Dawn thillat dia uain hin kimkhat, Toupa adia gimlim mei a thillat na lat ding uh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchibang in bawngtal ahihkeileh belampa ahihkeileh belamnou, ahihkeileh kelnou ahi ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tamdan uh dungzui zel in na bawl ding ua, a tamdan uh dungzui zel in na lan ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai gam a piang tengteng in hichibangzelin Toupa adia gimlim mei a thillat a lat chiang un a hih ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Namdang mi na kiang ua tengsa him ahihkeileh kuapeuh na kiang ua teng zelzel ding hiamte’n leng Toupa adia gimlim mei a thillat lan nuam peuhmah in na hih bang ua a hih sam ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na suante uh leh mipite leh namdang na kiang ua omte adia leng dan khat kia a om ding ahi. Toupa ma ah namdangte noumau bang ahi ding uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nou ading leh na kiang ua namdang omte ading in dan khat leh hih dan kibang khat kia a om ding, a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel suante houpih inla, a kiang uah, hichi ahi dia, k’on pina ding gam na va tun ua,
  </para>
  <para style="p">
    <verse number="19" style="v" />huai gam tanghou na nek chiang un, Toupa kiang ah vei thillat na lan ding uh ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na tanghou mek masakpen lak ua beu khatvei thillat dia na lat ding uh ahi. Buhphual a vei thillat dia na vei bang un na vei ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na suante uh tan in na tanghou mek masakpen uh Toupa kiang a vei thillat dia na lat zel ding uh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiai thupiak tengteng, Toupa’n Mosi kiang a a gen, tup mawng hilou a zuih khaklouh na neih uleh,
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n thu a piak tung apan na suante uh tan adia Mosi zang a thu a piak tengteng chihna ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichi ahi dia, omkhawmte’n theilou a, a hihkhak uh ahihleh, omkhawm tengteng in haltum thillat Toupa adia gimlim ding in bawngtuai khat a lan ding ua, a dan ngeina bang in tangbuang thillat leh dawn thillat toh, khelhna kithoihna ding in keltal khat leng a lantel ding uh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Siampu in Israel suan omkhawm tengteng ading in kilemna a bawlsak dia, ngaihdam ahi ding uh. Theilou a hihkhak a hih ziak leh a thillat uh Toupa adia mei a thillat leh a hihkhelh uh sik a khelhna kithoihna a lattak ziak un.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel suante omkhawm tengteng ngaihdam ahi ding ua, a lak ua namdang omte leng; mipi tengteng in a hihkhak uh a hih ziak in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Min theilou a thil a hihkhelh leh khelhna kithoihna ding in kelnu khat kum khat a upa a lat ding ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Theilou a Toupa ma a hihkhialmi ading in siampu in kilemna a bawl ding hi; huchi in ngaihdam ahi ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Theilou a hihkhialmi ading in, Israel suante, huai gam a piangte ading leh namdangmi na lak ua omte ading in leng dan khat na neih ding uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh tup mawng a hihkhial ahihleh, huai gam a piang hiam, namdang hiam leng hitaleh Toupa gensia ahi a; huai mi a chipihte lak apan satkhiak ding ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toupa thu a musit a, a thupiak a bohsiat ziak in, huai mi satkhiak ding ahi, a thulimlouhna mawh aman a paw ding, chi in, a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Israel suante gamdai a omlai un mi khat Sabbath ni a sing tom a mu uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />A sing tom mumite’n amah Mosi leh Aron leh mipite kiang ah a honpi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bangchi a hih ding ahia chih genkhiak nailouh a hih ziak in tanna in ah a khum uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Toupa’n Mosi kiang ah, hiai mi hihlup ngeingei ding ahi, giahphual pua ah mipi tengteng in suang in a deng ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in Toupa’n Mosi thu a piak bang in mipi tengteng in giahphual pua ah a pi ua, suang in a denglumta uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="38" style="v" />Israel suante kiang ah, a suante uh tanpha a, a puanmong ua a gei bawl ding leh a mong teng gei a a dum khak ding in gen in.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huai a mong na et ua, Toupa thupiak tengteng na theihgige ua na zuihna ding un leh; kizuak a na om zel bang ua na lungtang uh deih leh na mit uh la lam peuh deih a na om louhna ding un.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ka thupiak tengteng na theihgige ua na zuih ua, na Pathian uh adia na sianthou theihna ding uh ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Na Pathian uh hidia Aigupta gam apan nou hon pikhepa Toupa , na Pathian uh ka hi. Kei Toupa na Pathian uh ka hi, a chi hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levi tapa Kohath, huai tapa Izhar, huai tapa Korah pen Eliab tapate, Dathan leh Abiram leh Peleth tapa On leh Reuben tate’n mite a pi ua;
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante, mi tallang deuhdeuh mipi lak a heutu vaihawmmi dia telte lak a mi za nih leh sawmnga toh Mosi ma ah a va kisa uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi leh Aron kalh in a kikhawm ua, a kiang uah, “Na uang lua uh, Na uang lua uh, mipite a siangthou chiat ua, Toupa a lak uah a om chih mu zenpi a, bangziak a Toupa mipi omkhawmte tung a kikoih na hi ua?” a chi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mosi in huai a zak in a mai a leisi in a khupboh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Korah leh a pawlte tengteng kiang ah, “Zingchiang in Toupa’n amah a te kuate ahi ua? Misiangthoute kuate ahi ua, chih a taklang ding. A kiang ah a hon painai sak ding. Aman a mi tel ngei tan in a kiang nai ah a paisak ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hichi in hih un, Korah leh a pawlte tengteng aw, zingchiang in meilaknate tawi unla;
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai ah mei koih unla, Toupa ma ah gimlim buak un. Toupa’n a tel peuhmah a siangthou ding. Levi tapate, na uang lua uh” chi in a gen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mosi in Korah kiang ah, “Nou Levi tapate aw, ngaikhia unla,
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa biakbuk nasep sem ding leh, khawmpi na sem dia khawmpite ma ading a, amah kiang a hon om naisak dia, Israel Pathian in Israel khawmpite apan nou a hon omsak, nou adia thil neuchik phet a kilang hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah kiang ah a hon om naisakta a, na kiang a na unau Levi tapa tengteng, siamputna leng na zong ua hia?
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaiziak in nang leh na pawl tengteng Toupa kalh in na kikhawm uh ahi. Aron in bang a hih a ahia, a tung a na phun uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mosi in Eliab tapa Dathan leh Abiram a samsaka; “Amau k’ong paitou kei ding uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gamdai a honthat dia nawitui leh khuaizu luanna gam apan n’on pikhiak thil neuchik ahi hia? Ka tung uah na kilalsak nawn ngal a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nawitui leh khuaizu luanna gam ah n’on pilut kei a, lou ding leh grephuan gou ding lah n’on pe kei a; hiai mite mitte na mialsak ding maw? Ka hong paitou kei hial ding uh” a chi uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in Mosi a heh mahmah a, “ Toupa kiang ah, a thillat uh sang ke’n. A sabiltung uh khat lel leng ka lakei, kuamah ka hihna kei” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosi in Korah kiang ah, “Zingchiang in nang, na mi kikhawmte leh Aron Toupa ma ah a na om un.
  </para>
  <para style="p">
    <verse number="17" style="v" />A meilakna uh tawi chiat uhenla, gimlim buak uhen. Toupa ma ah a meilakna uh hontawi uhenla, meilakna za nih leh sawmnga hontawi uhen. Nang leh Aron in leng na meilakna uh tawituak tuak un” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in michih in a meilakna uh a tawichiat ua, mei a koih ua, gimlim a buak ua, Mosi leh Aron toh Kihoupihna puanin kongkhak ah a va ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Korah in mipi tengteng a ma ah Kihoupihna puanin kongkhak ah a omkhawm sak a; mipi tengteng kiang ah Toupa thupina a honglangta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toupa’n Mosi leh Aron a houpih a,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Hiai mite apan kihui khia un, amau ka hihmang guih theihna ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amau a khupboh ua, “Pathian aw, sa tengteng kha Pathian, mi khat khelh ziak in mipi tengteng tung ah na heh dia hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Mipite kiang ah, Korah, Dathan leh Abiram puanbuk apan kihemkhia un” chi in gen in, a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi a thou tou a, Dathan leh Abiram kiang ah a vahoh a; Israelte upate’n a zui uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Omkhawmte kiang ah, “Hiai migiloute puanin apan pawtkhia un. A bangmah uh khoih kei un, huchilou in zaw a khelhna tengteng uah na pangkha ding uh” chi in a gen hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in Korah, Dathan leh Abiram puanbuk apan a pawtkhe duamduam ua; Dathan leh Abiram a puanin ua pan a hong pawtkhia ua, a puanin kongkhak uah a zite, a tapate leh a tanu neu chikchikte uh toh ading uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosi in, “Keimah lungsim a pawtkhia ahi kei a, hiai thilhih ding in Toupa’n a honsawl ahi, chih hiai ah na thei ding uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiai mi tengteng dan banglel a a sih ua, mi tengteng gawt banglel a gawt a hih uh leh Pathian in kei hon sawllou ahi ding.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh Toupa’n thil thak a bawl a, lei in a kam a kat a, amau leh amau a tengteng a valh a, Sheol a hing a a lut ule bel hiai mite’n Toupa a na hehsak uh, chih na thei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichi ahi a, huai thu tengteng a gen khit in a nuai ua lei a hong khangkham phok hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lei in a kam a ka a, a inkuan un Korah mi tengteng, a neih tengteng utoh a valhkhin vekta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in amau leh amau a tengteng Sheol ah hing in a tum vek ua, lei in a kam a chihkhum a, omkhawmte lak apan a mangthangta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in a kim ua Israel tengteng a kikou husa uah a taizak ua, lei in ei leng a honvalh kha ding, a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Toupa apan mei a hong pawtkhia a, gimlim lan mi za nih leh sawmnga a hong kanglumta hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="37" style="v" />Aron tapa siampu Eleazar kiang ah thu gen inla, aman mei apan meilaknate lakhe ding in hilh in, thil siangthou ahi ngal a.
  </para>
  <para style="p">
    <verse number="38" style="v" />A hinna tung mah a hiai mikhialte meilaknate maitam khuhna kuang ding in sek hi uhen, Toupa ma a lat ahi ngal a. Huaiziak in a siangthou hi, huai Israel suante ading in chiamtehna ahi ding, a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Siampu Eleazar in mi kangte dal meilaknate a la a; maitam khuhna ding in a sekta hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Israel suante adia theihgigena hi ding in huchi a Aron tate hilou namdang himhim, Toupa ma a gimlim hal dia a hongpai nailouhna ding un. Mosi zang a a kiang a Toupa’n a gen bang a, Korah leh a pawlte bang a hong hihlouhna ding in.
  </para>
  <para style="p">
    <verse number="41" style="v" />Himahleh a zingsang in, Toupa mite na that uh, chi in Israel suan tengteng Mosi leh Aron tung ah a phun uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hichi ahi a, Mosi leh Aron tung a mipi a phunkhawm lai un, Kihoupihna puanin lam a en ua; ngai in, meipi in a honkhuh a, Toupa thupina a hong kilang hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mosi leh Aron Kihoupihna puanin kongkhak ah a hoh uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="45" style="v" />“Hiai mipi lak apan kihemkhia un, amau ka hihmang guih theihna ding in” a chi hi. Amau a mai ua leisi in a khupboh uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosi in Aron kiang ah, “Na mei lakna tawi inla, maitam apan mei koih inla; gimlim buak inla, mipi kiang ah paipih meng inla, amau a di’n kilemna bawl in. Toupa hehna a hongsuak hi; hipi a leng panta” a chi hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Aron in Mosi gen bang in a tawi a, omkhawmte lak ah a tailut a, ngai in, huai hipi mipi lak ah a hongleng pan a; gimlim a buak a, mipi ading in kilemna a bawl hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Misi leh mihing kikal ah ading a, hipi a khawlta hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huchi in Korah tungtang thu a site simlouh, hipi a si tengteng sing khat leh sang li leh za sagih ahi uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Aron Kihoupihna puanin kongkhak a Mosi kiang ah a kiknawn a, huchi in hipi a khawlta hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante houpih inla, a inkuan chih a tuam ding in chiang khatchiat, a inkuan uh dungzui zel a a intek pen tengteng zah, chiang sawmlehnih la inla; a chiang uah a min uh gelh in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levi chiang ah Aron min gelh inla; a inkuan chih uh ading in chiang khat zel ahi ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kihoupihna puanin thutheihsakna ma ah na koih dia, huai ah i kimu ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichi ahi ding a, ka tel ding mi chiang a sel ding; huchi in Israel suante na tung a a phunna uh ka daisak ding, a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi in Israel suante a houpih a, a intekpen tengteng in amau inkuan chih a tuam ading, intek pen chih in chiang khatzel, chiang sawmlehnih a pia uhi. Huaite lak ah Aron chiang leng a tel sam hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mosi in theihoihna biakbuk ah Toupa ma ah huai chiangte a koih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zing in hichi ahi a, Mosi theihpihna puanin ah a va hoh a; ngai in, Levi inkuante adia Aron chiang a na sel a, pakmum a suah a, a pakpalh a, vaisuaklu min a suang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosi in Toupa ma apan chiang tengteng Israel tengteng kiang ah a la khia a; a na en ua, amau chiang chiat a la uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa’n Mosi kiang ah, “Helhat tate ahi uh chih theihsak zelna ding in Aron chiang theihpihna bul ah koih nawn in. Huchi in ka tung a a helna uh na daisak thei ding, a sihlouhna ding un” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchibang in Mosi in Toupa’n thu a piak bang in a hih hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel suante’n Mosi kiang ah, “Ngai in, ka si ua, ka mangthang uh, ka vek un ka mangthang uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa biakbuk kiang nai a hongpai peuhmah a si ding uh. Kou leng si in ka mangthang ding u maw?” a chi uhi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Aron kiang ah: Nang leh na tapate leh na inkuan un Mun Siangthou tung a khelhna toh kisai mohpuakna na la ding uh ahi. Nang leh na tapate kia in siampu hihna toh kisai thil hihkhelhte a mohpuakna na puak ding uh ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na unaute, Levi suante leh na pa inkawte hon tawnpih in, huchi a amau Mun Siangthou tung a khelhna toh kisai a mohpuakna a lak theihna ding un. Nang leh na tapate’n bel siampu hihna toh kisai thil hihkhelhte ah mohpuakna na lak ding uh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Nna nasep a honhuh ding ua, puanin nasep tengteng a tang ding ua, himahleh Mun Siangthou tuium-belsuan leh maitam pen honnaih kei uhen, a sihlouhna ding un, amau hiam, nang hiam in leng.
  </para>
  <para style="p">
    <verse number="4" style="v" />Puanin nasepna tengteng ah kihoupihna puanin na pen a tang ding uh. Nam dangte’n nou a honnaih ding uh ahi kei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nang Mun Siangthou nasep leh maitam nasep pen na tang ding, Israel suante tung a hehna a om nawnlouhna ding in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai in, ke’n na unau Levite, Israel suante lak apan ka telkhia a, Kihoupihna puanin ah a sem ding uh. Toupa’n nang a hon thilthawnpiak ahi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang leh na tapate’n maitam leh puanzak sunglam thu ah na siampu nasep uh na sem ding uh. Nang na sem dia; siampu nasep na sep ding in k’on pia hi. Namdang hong kigolh peuhmah thah ahi ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toupa’n Aron a houpih a: Ngai in, Israelte thilsiangthou teng lak a kei adia vei thillat teng leng k’on pia hi. Thaunilh na hih ziak leh na tapate tangtawn dan ding a hih ziak in huaite k’on pia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mei adia keptuam, thillat siangthoupente nang a ahi ding uh. A thillat teng uh, tangbuang thillat hiam khelhna thillat hiam mawhna thillat hiam tantuan thillat tengteng nang leh na tapate tantuan ahi uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mun siangthou pen ah na ne ding ua; pasal teng in a ne ding ua, nou ading in hiai thil siangthou ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiaite kei a tuam ahi. A thilpiak uh tangbuang thillat, Israel suante vei thillat tengteng tan in. Nang, na tapate leh tanute adia tangtawn a na tantuam ding ua ka honpiak ahi. Na inn a mi siang tengteng in a ne thei ding uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sathau hoih pen, grep hoih pen, buh hoih pen leh gah masa pen Toupa dia a piak teng uh k’on pia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A lou ua gah min masa pen Toupa adia a hontawi uh nang a ahi dia; na inn a mi siang teng in a ne thei ding uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Israelte thillat tengteng nang a ahi ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa adia a piak uh sul hong masapen peuhmah mihing leng gan leng nang a ahi ding. Himahleh tapa masapen zaw na tan ngeingei dia, gan sianglou nou suak khe masapen leng na tat ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kha khat a hih in tat dingte tatna man na seh dan bang in, Mun Siangthou a sekel hihdan bang a sekel nga a na tat ding ahi, sekel pen gerah sawmnih ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh bawng suakkhe masapen hiam, belam suakkhe masapen hiam, kel suakkhe masapen hiam, na tat ding ahi kei; a siangthou uhi. A sisan uh maitam ah na theh dia, Toupa adia gimlim ding in a thaute mei a thillat in na hal ding ahi
  </para>
  <para style="p">
    <verse number="18" style="v" />A sa uh nang a ahi dia, vei thillat leh a liang taklam pang nang a a hih bang in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thil siangthou vei thillat, Israel suante’n Toupa adia a latte uh tangtawn a na tantuam ding un k’on pia hi. Toupa ma a nang, na tapate leh na tanute adia tangtawn thukhun ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Toupa’n Aron kiang ah, A gam uah goutan na neikei dia, a lak uah leng tantuan na neisam kei ding. Israel suante lak a na tantuan leh na goutan, Keimah ka hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ngai in, a nasep, puanin a a sepman ding un, Israel gam a sawm a khat tengteng Levi suante kiang ah ka pia ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tu apan Israel suante’n Kihoupihna puanin a honnaih het louh ding uh ahi; khelhna pua in a si kha ding uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh Levite’n bel Kihoupihna puanin nasep a sem ding ua; Israelte khelhna toh kisai mohpuakna a la ding uh. Hiai a suante tan ading in dan ahi dia; Israel suante lak ah goutan a neikei ding uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Israel suante’n sawm a khat Toupa adia vei thillat a lat uh Levite goutan ding in ka pia hi. Huaiziak in a kiang uah, Israel suante lak ah goutan a neikei ding uh, ka na chita him ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="26" style="v" />Levite houpih inla, a kiang uah, Na goutan ding ua Israel suante sawm a khat k’on piak na lak chiang un, huai sawm a khat apan sawm a khat Toupa kiang ah vei thillat ding in na lan ding uh ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na vei thillat uh buhphual a buh leh uain tung masapen dia sim ahi ding.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchibang in Israel suante lak a sawm a khat na lak tengteng uah leng Toupa vei thillat ding in na lan zui zel ding uhi, huai Toupa vei thillat pen siampu Aron na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na thillat tengteng lak ua a hoih pen, a siangthou pen Toupa vei thillat ding in na lan ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huaiziak in, a kiang uah, a hoih pen na vei chiang un Levite buhphual a tung leh grep sukna apan tung bang a sim ahi ding.
  </para>
  <para style="p">
    <verse number="31" style="v" />Koilai peuh ah leng na ne thei ding uh, nou leh na inkuanpihte un leng; Kihoupihna puanin a nasep man uh ahi ngal a.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hoih pen na vei uh leh a khelh mawh na paw kei ding uh. Israel suante thil siangthou na hih thanghuai kei ding ua, na si kei ding uhi, chi in, a chi hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi leh Aron a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiai Toupa thupiak dan ahi. Israel suante bawngla san, dembei, gensiatbei, hakkol bulhsak ngei hetlouh na kiang a honkai ding in hilh un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Siampu Eleazar nape dia, aman giahphual pua ah a pikhe dia, a ma ah mi khat in a gou ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Siampu Eleazar in a khut in a sisan a la dia, Kihoupihna puanin ma ah a sisan sagihvei a theh ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi khat in huai bawngla a mitmuh in a hal dia; a vun, a sa, a sisan leh a ek a haltum ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siampu in sidar sing, hussop leh khausan a la dia, bawngla a hal uah a pailut ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Siampu in a puansilhte a sawp dia, a kisil dia, huaikhit in giahphual ah a hoh dia, nitaklam tan in siampu sianglou ahi ding.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hal mi in a puansilhte a sawp dia, a kisil dia, nitaklam tan in sianglou ahi ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi siang in bawngla vu a lakhawm dia, giahphual pua a mun siang a ngaih ah a koih dia, Israel suan mipite kisiansakna tui dia zat ding ahi. Hiai khelh siansakna ahi
  </para>
  <para style="p">
    <verse number="10" style="v" />Bawngla vu lakhawm min a puansilhte a sawp dia, nitaklam tan in sianglou ahi ding. Hiai Israel suante leh namdang a kiang ua omte ading in tangtawn dan ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kuapeuh siluang khoih peuhmah ni sagih sung sianglou ahi ding.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah ni thum ni’n a kisiangsak dia, ni sagih ni’n a siang ding. Himahleh, ni thum ni a a kisiansak kei leh ni sagih ni’n leng a siang kei ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuapeuh siluang khoihmi, a kisiansak kei leh Toupa biakbuk a hihnin ahi. Huai mi Israel mite apan satkhiak ding ahi. Kisiansakna tui a tung a a thehlouh ziak in a siangkei dia, a sianlouhna a tung ah a omlai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Puanin a mi a sih leh hiai a dan ding ahi. Puanin a lut peuhmah leh puanin sung a om peuhmahte ni sagih sung sianglou ahi ding uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tuium-belsuan kihong, sitlouh peuhmah a sianglou ahi uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Gamlak a namsau a thah hiam, misiluang hiam, mihing guh hiam, han hiam mi’n a khoih leh ni sagih sung sianglou ahi ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />A siangloute a tuam ding in khelh thoihna vu a la ding ua, bel ah tuikhuk tui toh asung ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi siang in, hussop a la dia, tui ah a diah dia, puanin tung, tuium-belsuan tengteng, huai a ommi tengteng, guh hiam, thah siluang hiam, misiluang hiam, han hiam khoih mite tung ah a theh ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi siang in ni thum ni leh ni sagih ni’n mi sianglou a theh dia, ni sagih ni’n a hihsiang dia; a puansilhte a sawp dia, a kisil dia, nitaklam in a hong siangta ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi sianglou kisiangsak lou in Toupa Mun Siangthou a hihnit ziak in huai mi omkhawmte apan satkhiak ding ahi. Kisiansakna tui a thehlouh ahi a, sianglou ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiai amau ading in tangtawn dan ding ahi. Kisiansakna tui a theh peuhmah in a puansilhte a sawp dia; a kisiansakna tui khoih peuhmah nitaklam tan in sianglou ahi ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi sianglou in a khoih peuhmah sianglou ahi zel dia; huai khoih mi kuapeuh nitaklam tan in sianglou ahi ding, a chi hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Israel suan omkhawm tengteng huai kha khatna in Jin gamdai a lut ua; mipite’n Kadesh ah giahphual a sat ua; huai ah Miriam a si a, huai ah a vui uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Omkhawmte ading in tui a omkei a; Mosi leh Aron kalh in a kikhawm uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mite’n “ Toupa ma a i unaute a sihlai un Pathian in honthat geih mai leh aw!
  </para>
  <para style="p">
    <verse number="4" style="v" />Bangdia Toupa mipite sidia gamdai a pilut na hia, kou leh ka gante utoh?
  </para>
  <para style="p">
    <verse number="5" style="v" />Bangziak in ahia hiai gam hoihloupi a hon pilut dia Aigupta gam apan n’on pawt khiak sak mahmah? Buh leh balte, theipite, grepkungte, theibuhfaite omlouhna mun ahi, tui dawn ding mahmah leng a omsam kei hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Mosi leh Aron mipi apan Kihoupihna puanin kongkhak ah a hoh ua, a khupboh ua; Toupa thupina a kiang uah a hong kilang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="8" style="v" />“Chiang la inla, mipite omkhawm sak inla, nang leh na unaupa Aron toh, huai suangpi in a mitmuh ua tui pawtsak ding in thupia in. Suangpi apan tui na lakkhiak sak dia, mite leh a gante uh na dawnsak ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mosi in Toupa ma apan chiang, a thupiak bang in a la hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosi leh Aron in mipite suangpi bul ah a omkhawm sak ua, Mosi in a kiang uah, “Nou mihelte aw, ngai un, hiai suangpi apan tui k’on lak khiaksak ding ua hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mosi in a ban a zak a, suangpi a chiang in nihvei a sat a; huchi in tui tamtak a hongpawt a, mipite leh a gante un a dawn uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toupa’n Mosi leh Aron kiang ah, “N’on gintak louh ua, Israel suante mitmuh a n’on pahtawi louh ziak un hiai omkhawmte ka piak gam ah na pilut kei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai Meribah tui ahi. Israel suante’n Toupa a kinakpih ua, huai ah amau a Amah pahtawi a a om ziak in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mosi in Kadesh apan Edom kumpipa kiang ah mi a sawl a, “Na unaupa Israel in hichi in a chi, Ka tung ua thuakna hongtung tengteng na thei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka pipute uh Aigupta gam ah a hohsuk ua, sawtpi Aigupta gam a ka om uh, Aigupta mite’n kou leh ka pipute hoihlou tak in honbawl uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in Toupa ka sam ua, ka aw uh a naza a, angel a honsawl a, Aigupta gam apan a hon pikhia a, ngai in, na gam naih pen khua Kadesh ah ka om uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hehpih in na gam ka tawn paisuak ding uh aw. Lou hiam, grephuan hiam ka tawn kei ding ua, tuileh tuite leng ka dawn kei ding uh. Kumpipa lamlian ah ka pai ding ua, na gam ka khen masiah uh taklam hiam, veilam hiam ah ka pial kei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Edom in a kiang ah, “N’on palsuak ding ahi kei. N’on pal leh hondou ding in namsau toh ka hong kuan ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israel suante’n a kiang ah, “Lamlian ah ka paitou ding ua; kou leh ka gan un na tui ka dawn uh leh aman k’on pe ding uh. Thil dang bangmah hihlou in a pai in ka paisuak mai ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman, “Paisuak lou ding” a chi hi. Huchi in Edom mipite tampi leh mihat taktakte toh amau dou ding in a hong kuanta uhi
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiai bang in Edom in Israel mite a gam a a paisuak uh a phal kei a, Israel mite’n a kiksan nawnta uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in Kadesh apan a pawt ua; Israel suan mipi tengteng Hor tang a hongtung uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n Mosi leh Aron, Edom gam naih Hor tang ah a houpih a,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Aron a chipihte kiang a pi ahi ding. Meribah tui a ka thu kalh a, a hel ziak in Israel suante ka piak gam ah a lut kei ding.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aron leh a tapa Eleazar Hor tang ah honpi tou in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aron puansilhte suah sak inla, a tapa Eleazar silhsak in. Aron a chipihte kiang a pi ahi ding, huai ah a si ding” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mosi in Toupa thupiak bang in a hih a; mipi tengteng mit muh in Hor tang ah a paitou uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Mosi in Aron puansilh a suahsak a, Eleazar a silh sak hi. Aron mual vum ah a sita a, Mosi leh Eleazar mual vum apan a hong paikhe suk uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mipi tengteng in Aron a si chih a theih un, Israel tengteng in ni sawmthum a sun uhi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Kananmi, Arad Kumpipa simlam a om in Israel mite Atharim lampi ah a hongpai uh chi a kigen ging a naza a; huchi in Israel mite a dou a, galmat khenkhat a nei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel mite’n Toupa kiang ah thu a chiam ua, “Hiai mite ka khut ua na honpiak leh a khuate uh ka hihmang ding uh” a chi uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa’n Israel mite thu a pom a, a kiang uah Kanan mite a pia a, amau leh a khuate a hihmang uhi. Huai mun min Hormah a sa uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hor tang apan Tuipi San lam ah Edom gam kualkhum in a pai ua; a lampi ziak in mipi a lunglel mahmah uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mipite’n Pathian leh Mosi kalh in, “Gamdai a si dia bang ding a Aigupta apan honpi khia na hia? Tanghou lah omlou, tui lah omlou. Hiai tanghou kihhuai lah ka hinna un a kih hi” a chi uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Toupa’n mipi lak ah gul gukhahte a sawl a, mite a tu ua, Israel mite tampi a si uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaiziak in, mite Mosi kiang ah a hongpai ua, “ Toupa leh nang kalh a ka na pau uh ka khialta uhi, i lak ua gulte lamang ding in Toupa kiang ah thum dihve” a chi uhi. Huchi in mite ading in Mosi a thum hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toupa’n Mosi kiang ah, “Gul gukhah lim bawl inla, khuam lek ah khai in. Hichi ahi ding a, gultuk mi peuhmah in huai a et uleh a dam ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Mosi in dalgul a bawl a, khuam lek ah a khai a; hichi ahi a, gul tuk mi peuhmah in huai dal gul a et uleh a dam uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel suante a pai zel ua, Oboth ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Oboth apan a pai nawn ua, ni suahna lam Moab gamdai bul Ije abarim ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai apan a pai nawn ua, Zered guam ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai apan a pai nawn ua, Amorte gamgi apan hong dawktuam gamdai a Arnon lehlam ah giahphual a sat uh. Arnon bel Moab gamgi, Moab leh Amorte kikal a om ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaiziak in, Toupa kidounate laibu ah, Tuipi San leh Arnon luitate a;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ar tenna a luangkhia luite leh Moab gamgi a omte ah a thilhihte, a chih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai apan Beer ah a pai nawn ua; huai bel Toupa’n Mosi kiang a mipite samkhawm inla, tui ka pe ding, a chihna tuileh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Israelte’n hiai la a sa uh. “Aw tuikhuk, hong kikhoh khia inla, a thu la in sa un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Dan petu in a kawkmuh bang a miliante uleh mipite heutute’n a khetbuk u toh a laih uh tuikhuk” chi in. Huchi in gamdai apan Mattanah tan;
  </para>
  <para style="p">
    <verse number="19" style="v" />Mattanah apan Nahaliel ah; Nahaliel apan Bamoth ah;
  </para>
  <para style="p">
    <verse number="20" style="v" />Bamoth apan Moab lou a guam leh gamdai sun suk Jeshimon lam nga Pisgah vum ah a pai uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Israel mite’n Amorte kumpipa Sihon kiang ah mi a sawl ua,
  </para>
  <para style="p">
    <verse number="22" style="v" />“Na gam ah hon paisuaksak ve; lou ah hiam, grephuan ah hiam ka pial kei ding ua; tuileh tuite ka dawn kei ding uh. Na gam ka khen masiah uh kumpipa lamlian ah ka pai zel ding uhi” chi in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh Sihon in Israel mite a gam a a paisuak uh a phalkei hi. Sihon in a mite tengteng a kaikhawm vek a, Israel mite dou ding in gamdai ah a kisa zawta hi. Jahaz a va tung ua; huai ah Israel mite a dou uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Israel mite’n namsau in amah a that ua, a gam Arnon apan Jabok tan in, Ammon suante tan in a lazou uhi. Ammon suante gamgi kulh nei a hih ziak in a gam chianglel a lazou uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Israel mite’n huai khua tengteng a la ua; Israel mite’n Amorte khua tengteng a luah uhi. Heshbon leh a khopel tengteng ah leng a teng uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Heshbon khua bel Amorte kumpipa Sihon khua ahi. Amah huai ma a Moab kumpipa a sual a a khut apan gam tengteng, Arnon tan a laksakpa ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huaiziak in, paunak gente’n, “Heshbon ah hongpai in, kilamthak hen, Sihon khopi kilamthak hen, a chi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Heshbon apan mei a hongpawt a, Sihon khopi apan meikuang. Moab a Ar a kangkhin a, Arnon a munsang a toupate toh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aw, Moab, Na tung a gik hi. Na mangthangta, Aw Kemosh mi! Aman Amorte kumpipa Sihon kiang ah tapate galtaite bang in leh a tanute saltangte bang in a pia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh amau ka kap ua, Dibon tan in Heshbon a mangthangta. Huchi in Nophah tan in ka hihmang uh, huai in Medeba tan a pha hi.”
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchibang in, Amorte gam ah Israel mite a teng uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mosi in Jazer enkhe ding in mi a sawl a, a khuate a la ua, huai a teng Amorte a hawlkhia uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A kiknawn ua, Bashan lampi ah a paitou uh. Bashan kumpipa Og, amau dou ding in, amah leh a mite tengteng, Edre-i ah a kisa khia uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Toupa’n Mosi kiang ah, “Amah lau ken. Amah, a mite tengteng leh a gam na khut ah k’on pekhinta hi. Heshbon a om Amorte kumpipa Sihon tung a na hih bang in na hih ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in amah leh tapate hawi himhim neilou in a mite tengteng toh a that ua; a gam a luahsakta uhi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Israel suante a pai zel ua, Jeriko zawn Jordan gal a Moab phaizang ah giahphual a sat uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jippor tapa Balak in Israel mite’n Amorte a bawldan tengteng uh a na thei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Moabte’n mite a lau mahmah ua, a tam ngal ua. Israel suante ziak in Moabte a lungkham uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Moabte’n Midian upate kiang ah, “Hiai mipite’n bawng in loupa a nekgaih bang in i kim ua mi tengteng a negai ding uh” a chi uhi. Huailai in Jippor tapa Balak Moab kumpipa ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaiziak in Beor tapa Balaam, Pethor a om kiang ah mi a sawl hi. Huai bel a mite suante gam a lui kiang a om ahi. Amah a va sam ua, “Ngai in, Aigupta gam apan hong paikhia mipi a om ua; ngai in, lei tengteng a tuamdim ua, ka kiang chin ah a om uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hehpih in hongpai inla, hiai mite hong hamsiat dihve. Kei ading in a hat lua ua, ka zoh theih ua ka gam apan ka delhkhiak theih zenzen khak uleh. Na vualzawl peuhmah vualzawl in a om a, na hamsiat peuhmah hamsiat in a om, chih ka thei” a va chisak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Moab upate leh Midian upate aisanna ding tawi in a pawtkhia ua; Balaam kiang a va tung ua, Balak thukhah a hilh uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman a kiang uah, “Tu zan hiai ah giak unla, Toupa’n honhilh bangbang thu na kiang ua ka hontun ding,” a chi hi. Huchi in Moab miliante Balaam kiang ah a giakta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Balaam kiang ah Pathian a hong a, Na kiang a mite kuate ahi ua? a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balaam in Pathian kiang ah, “Jippor tapa Moab kumpipa Balak in ka kiang ah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai in, Aigupta gam apan a hongpai mipite’n lei tengteng a luahdim uh. Hongpai inla, hong hamsiat in, ka zoh theih a, ka delh khiak theih khak leh’ ” chi in mi a honsawl hi, a chi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian in Balaam kiang ah, “A kiang ua na hoh ding ahi kei. Huai mite na hamsiat ding ahi kei; mi hampha ahi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Balaam zingsang in a thou a, Balak miliante kiang ah, “Na gam uah pai nawnta un. Toupa’n na kiang ua hoh dia ka pawt a phal kei” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Moab miliante a thou ua, Balak kiang ah a pai ua, “Balaam in a honzui utkei” a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Balak in milian tamsem, a sang ua zahtakhuai zaw a sawlnawn hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Balaam kiang a va tung ua, a kiang ah, “Jippor tapa Balak in hichi in a chi, ‘Ka kiang a na honghoh ding bangmah in dal kei hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi thupitak in k’on bawl dia, ka kiang a na gen peuhmah ka hih zel ding. Huaiziak in, hongpai teitei inla, hiai mite hong hamsiat sak mahmah mai in’ ” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Balaam in Balak mite a dawng a, a kiang uah, “Balak in a inn dim dangka leh dangkaeng honpe ding himahleh, a bangmah Toupa ka Pathian thu pel in ka hih theikei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaiziak in, Toupa’n ka kiang ah bangchi’n ahia a gen nawn ding, tu zan hiai lai ah giak peuhmah phot un” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Zan in Balaam kiang ah Pathian a hong a, a kiang ah, “Hiai mite nang hong sam a hong a hih uleh, thou inla, a kiang uah hoh in. Himahleh na kiang a ka gen kia na hih ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in zingsang in Balaam a thou a, a sabiltung tung ah tutphah a phah a, Moab miliante a zuita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hoh ziak in Pathian a heh mahmah a, amah a na lamdal ding in Toupa angel lampi ah a na ding hi. A sabiltung tung a tuang ahi a, a sikhate nih leng a kiang ah a om uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sabiltung in Toupa angel, namsau tawi a lampi ading a mu hi. Huchi in sabiltung lampi apan a pialkhia a, gamlak ah a pai a, Balaam in sabiltung lampi a kiksak tum in a sat hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toupa angel grephuan umna kikal kuak ah ading hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sabiltung in Toupa angel a mu a, grephuan umna a vangai a, Balaam khe dai umna toh a nehden hi. Balaam in a sabiltung a satnawn hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa angel a pam deuh ah a pai a, mun kawchik laitak, taklam hiam, veilam hiam a leng pialna om louhna laitak ah ading hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sabiltung in Toupa angel a mu a, Balaam a kualpihta hi. Balaam a heh mahmah a, a chiang in sabiltung a sat hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Toupa’n sabiltung a pausak a, Balaam kiang ah, “Bang k’on chih a ahia? Thumvei tak n’on huchi sat?” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balaam in sabiltung kiang ah, “N’on simmawh ziak in ahi. Namsau tawi hileng, k’on that khinta hial ding” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Sabiltung in Balaam kiang ah, “Tu tan a na tuanna gige na sabiltung ka hi ka hia? Hichibang in k’on hih ngei ahia?” a chi hi. Aman, “Hih ngeilou e” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Toupa’n Balaam mit a vaksak a, Toupa angel namsau tawi a lampi ading a muta a; a kuna, a mai a leisi in a khupboh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Toupa angel in a kiang ah, “Bang achia hichibang a na sabiltung thumvei sat na hia? Ngai in, na gamtatdan ka mitmuh a a siat ziak in hon na lamdal dia hong pawtkhia ka hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sabiltung in a honmu a, ka ma a thumvei pial ahi. Pial kei leh amah that lou a, nang hon thatkhin ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Balaam in Toupa angel kiang ah, “Ka na khialta hi. Hon na lamdal ding in lampi ah na ding chih ka theikei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Toupa angel in Balaam kiang ah, “Hiai mite kiang ah hoh inla; himahleh na kiang a ka thugen ding kia na gen ding ahi” a chi hi. Huchi in Balaam in Balak miliante a zuita hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Balak in Balaam a hong chih a zak in Arnon lam a gamgi chiang ah Moab khopi pha in a vadawna, huai bel gamgi tawpna ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Balak in Balaam kiang ah, “Phatuamngai tak a nang hong sam dia mi k’on sawl ahi kei maw? Bangdia ka kiang a hong nuam lou na hia? Mi thupitak in k’on bawl thei ka hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Balaam in Balak kiang ah, “Ngai in, ka honghi. Bangmah gen theihna mawngmawng ka nei ahia? Pathian in ka kam a thu a koih kia ka gen ding” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huchi in Balaam Balak kiang ah a hohta a, Kiriath huzot a vatung uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Balak in bawng leh belam a lan a, khenkhat Balaam leh a kiang a om miliante kiang ah a khak hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hichi ahi a, a zingsang in Balak in Balaam a pi a, Baal mun sangte ah a hohtouhpih a, huai apan mite omna chiang a mupha hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Balaam in Balak kiang ah, “Hiai ah maitam sagih hon bawlsak inla, bawngtal sagih leh belampa sagih hon suktuah sak in” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balak in Balaam gen bang in a hih a; Balak leh Balaam in maitam chin ah bawngtal khat leh belam khat a lan uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Balaam in Balak kiang ah, “Na haltum thillat bul ah a na ding gige inla, kei ka va paituam ding. Kei hon houpih ding in Toupa a hongpai kha thei hi. Aman a honhilh peuhmah k’on hilh ding” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in mual giau velvul ah a hohtou hi. Pathian in Balaam a na kituahpih hi. Balaam in a kiang ah, “Maitam sagih ka bawlkhin a; maitam chih ah bawngtal khat leh belampa khat ka lan chiat” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Toupa’n Balaam kam ah thu a koih a, “Balak kiang ah kiknawn inla, vagen sawn in” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in a kiang ah a kiknawnta a; ngai in, a haltum thillat bul ah amah leh Moab milian tengteng leng a na ding lai uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman thu a genta a, “Aram apan Balak in a honpi a, Suahlam tang a Moab kumpipa’n, ‘Hong inla, Jakobte hon hamsiat sak in, hong inla, Israelte hong dalsak in!’ a chi a.
  </para>
  <para style="p">
    <verse number="8" style="v" />Bangchi’n Pathian hamsiat louh ka hamsiat dia? Bangchi’n Pathian dal louh ka dal dia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau lah suangpi tung apan ka mu ngal a, tangte apan amau ka mu a, ngai in, mite a tuam in a teng ding ua, namte lak a sim tellouh ding ahi uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jakobte leivui kua’n a simthei dia, Israelte mun li a khen, mun khat kua’n ahia simthei ding? Mi diktat sih in si sam ning, ka tawpna amah a bang hi hen!” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Balaam kiang ah Balak in, “N’on bawldan bangchidan ahia? Ka melmate hamsiat ding in ka honpi a, na vualzawl zaw mawk ngal a!” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman a dawng a, “ Toupa’n ka kam a a koih ka gen ding mah hilou ding maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Balak in a kiang ah, “Mun dang ah hohnawn dih ni e, huai apan na thei vek ding. A omna chiang uh na mu ding, avek un zaw na mu vek khol kei ding. Huai apan hon hamsiat sak in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Zophimte tenna Pisgah vum ah a pitou a, maitam sagih a doh a, maitam chih ah bawngpa khat leh belampa khat a lan hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Balak kiang ah, “Pam a Toupa ka va houpih sung in na haltum thillat bul ah a na ding lai in” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n Balaam a na kituahpiha, a kam ah thu a koih a, “Balak kiang ah kiknawnta inla, a kiang ah, va gensawn in” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kiang ah a va hoh a, ngai in, a haltum thillat bul ah a na ding nilouh hi. Moab miliante leng a kiang ah a om uh. Balak in a kiang ah, “ Toupa’n bang a na gen a?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman thu a genta hi: “Thou inla, Balak, ngaikhia in. Jippor tapa, ka thu ngai in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian zaw Zuauhat mihing ahi kei. Kisik hat mihing tapa leng ahi sam kei. A gensa ahihkei dia hia? A na gensa a hih piching kei dia hia?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai in, vualzawl ding in thupiak ka mu a, aman a vualzawl khin a, ken ka hih lamdang theikei.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jakobte ah thulimlouhna a mu kei a, Israelte ah phengphitna a mu sam kei. Toupa a Pathian uh a kiang uah a om a, a lak uah kumpipa kikou husa a om hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Aigupta apan Pathian in a pikhia a, gam bawngtal tha bang a nei uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jakobte tung ah bumhaina a omkei a; Israelte tung ah leng khimhaina a omsam kei hi. Jakobte leh Israelte kiang ah Pathian thilhih hihlat ahi!
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai in, mipite humpinelkai lian bang in a thou ua, humpinelkai dawng bang in a ding tou ua; a sa mat uh a nek ma un a kual kei ding uh, a mat uh sisan a dawn ma un” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Balak in Balaam kiang ah, “Hamsiat kenla, vualzawl leng Vualzawl het ken” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh Balaam in a dawng a, Balak kiang ah, “ Toupa’n a gen tengteng ka hih ngeingei ding ahi chi in k’on hilhkhin ahi kei maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Balak in Balaam kiang ah, “Hong dih, mun dang ah konpi nawn dia, huai apan n’on hamsiat sak Pathian in a phal kha zenzen hiam” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Balak in Balaam Jeshimon lam nga, Peor vum ah a pitouta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Balaam in Balak kiang ah, “Hiai ah maitam sagih hon bawlsak inla, bawngpa sagih leh belampa sagih hon suktuah sak in” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Balak in Balaam gen bang in a hih a, maitam chih ah bawngpa khat leh belampa khat a lan hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israelte vualzawl ding Toupa deihlam ahi chih Balaam in a theih in nidang a a hihbang in bumna zat tumlou in gamdai lam a nga zawta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Balaam a vandak a, Israel mite a nam dungzui zel a om a mu a; Pathian Kha a tung ah a hongtung hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in hiai thu a gen a, “Beor tapa Balaam in a gen a, a mit a kichian tak a mupa’n a gen hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian thute za a, Bangkim hihtheipa kilakna mu a khup a puk a, a mitte hong vakpa in a gen hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jakob aw, na puaninte hoih hina e, Israel aw, na biakbukte uh!
  </para>
  <para style="p">
    <verse number="6" style="v" />Phaizang bang in a kiphah a, luidung a huante bang in, Toupa suan tawsaw bang in, luidung a sidar singte bang ahi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />A baltinte apan tui a sungkhe dia, a haichi tui tampite ah a om dia, a kumpipa Agag sang in a sangzaw dia, a lalgam tawisang in a om ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aigupta apan Pathian in a pikhia a, gam bawngtal hatna bang a nei a, A melma uh namdangte a negai dia, a guhte uh a tansak dia, a thaltangte in a kap pailet ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kun a, humpinelkai bang in a kual a, humpinelkai bang mai in; kua’n a tokthou dia? Hon vualzawl peuhmah vualzawl in om uhenla, hon hamsiat peuhmah hamsiat in om hen” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Balaam tung ah Balak a heh mahmah a; a khutte nuaituah in Balak in Balaam kiang ah, “Ka melmate hamsiat ding in k’on sam a, tuin, thumvei tak amau na vualzawlta.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaiziak in, na mun ah taimang in. Thupitak a hon tawisang ding k’on chih na hi a; himahleh, ngai in, Toupa’n nang k’on tawisang ding a dal” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Balaam in Balak kiang ah, “Na misawlte kiang ah ka genkei maw?
  </para>
  <para style="p">
    <verse number="13" style="v" />‘Balak in a inn dangka leh dangkaeng a dim honpe ding himahleh, a hoih lam hiam, a selam hiam Toupa thu khen lam ah keimah lungsim a suak in bangmah ka hih theikei. Toupa’n a gen peuhmah ka gen ding,’ chi in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai in, ka mite kiang ah ka paita ding. Huaiziak in, honghoh in, tunung a na mite tung a hiai mite’n a hih ding uh k’on hilh ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiai thu a gen a, Beor tapa Balaam mitvak tak a mu in a gen hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Pathian thute za a, Tungnung Pen theihna thei, Bangkim hihthei kilakna mu, a khup a puk a mit hongvakta in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Amah ka mu, himahleh tuin hilou in; Amah ka en a, naichik ah hilou in. Jakob apan aksi khat a hongsuak khe dia, Israel apan lalchiang a hong dingkhe dia, Moab gam nawlte a dou dia, Seth tate a hihse ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A melma Edom leh Seirte lakzoh in a om ding ua; Israel in hattak in a hih ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakob apan ukmi khat a hong paikhe dia, khopi a omsunte a hihmang ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amalek lam a nga a, thu a gen a, Amalek bel nambul pen ahi na a, a dawn lam tangtawn a manthatna ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kente lam a nga a, thu a gen a, Na tenna mun a kip a, suangpi ah na bu na sep hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Asshurte’n sal a a hon pimang masiah, hih manthat in na om ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thu a gennawn a, Pathian in hiai a hih, kua a hing zou dia?
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh Kittim gam apan longte a hongtung ding ua, Asshur a hihgim dia, Eber a hihgim ding ua, Amah leng a mangthang ding” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in Balaam ading khia a, a khua ah a paita. Huchi in Balak leng a paisamta hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Shittim a Israelte a tam sung un, pasalte’n Moab numeite a luppih uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A pathiante uh ma a kithoihnate ah a chial ua; huchi in a ne ua, a pathiante ma ah a kun uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israelte’n Peor Baal a besamta uhi. Huchi in Israelte tung ah Toupa hehna a kuangta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa’n Mosi kiang ah, “Mipite heutu tengteng pi inla, Toupa hehna lauhuai takmai Israelte tung apan a ki khinmang theihna ding in sun khovak ah amaute that in” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi in Israelte vaihawmmite kiang ah, “Peor Baal biakna a tel peuh mahte that vek un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai in, puanin kongkhak a mite kapa, a om laitak un, Mosi leh Israel omkhawmte mitmuh in Israel mi khat in Midian numei khat a unaute kiang ah a honpi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Siampu Aron tapa Eleazar tapa Phinehas in a muhtak in omkhawmte apan a thou a, teipi khat a lata hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel mi a puanin sung ah a delhluta, Israel mi toh a nih un a sun paileta, numei pen a gil ah a sun pailet hi. Huchi in Israel suante tung a hipi a daita hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh huai hipi a site sing nih leh sang li ahi uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Siampu Aron tapa Eleazar tapa Phinehas in a lak ua kei adia phatuam a ngaih ziak in Israel suante apan ka hehna a heimang a, huchi in ka thikthusiat ziak in Israel suante ka hih mangthang kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huaiziak in, Ngai in, ka lemna thukhun amah ka pe ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amah leh a nung a a suante ading in tangtawn siamputna thukhun ahi dia; a Pathian adia phatuam ngai a Israel suante adia kilemna a bawlsak ziak in, chi in gen in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Midian numei toh a thah uh Israel mi min Jimri ahi a, amah Simeonte lak a inkuan a intek pen Salu tapa ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A thah uh Midian numei min Kozbi ahi. Amah Zur tanu ahi a, Midiante inkuan lak a heutu ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="17" style="v" />“Midiante hih lungzing unla, that un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amau Peor tungtang thu leh a unaunu uh Midiante heutu tanu Kozbi toh kisai a noute a hon khemlai un, melma bang a honsai uh ahi. Peor ziak a hipi a hongtun in Kozbi thah a om ahi” a chi hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hipi a daih nung in hichi ahi a, Toupa’n Mosi leh siampu Aron tapa Eleazar a houpih a,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel suan omkhawm tengteng, kum sawmnih apan a tung lam, a inkuan dungzui un Israel gam a galdou thei chiang teng simvek un” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi leh siampu Eleazar in Jeriko zawn, Jordan gei, Moab phaizang ah amau a houpih a,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Mipite kum sawmnih apan a tunglam sim un,” Toupa’n Mosi leh Aigupta gam apan Israel suante kiang a thu a piak bang in, a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel ta upapen Reuben: Reuben tapate; Hanok suan Hanokte, Pallu suan Pallute.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hezron suan Hezronte, Karmi suan Karmite.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiaite Reubente inkuan ahi uh. Sima om tengteng sing li leh sang thum leh za sagih leh sawmthum ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pallu suan, Eliab.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eliab suante: Neumuel, Dathan leh Ahiram ahi uh. Hiai Dathan leh Abiram ahi ua, Toupa a hehsak lai ua Mosi leh Aron kalh a Korah pawl a tel omkhawmte.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai pawl a sih lai un lei in a kam a ka a, Korahte toh a valh khawm a; mei in mi za nih leh sawmnga a kattum lai in, huchi in chiamtehna a na hita uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh Korah tapate a si kei uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Simeon tapate inkuan uh kizomdan bang zel a a suante: Nemuel suan Nemuelte. Jamin suan Jaminte, Jakin suan Jakinte.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zerah suan Zerahte; Shaul suan Shaulte ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiaite Simeon suante ahi, sing nih, sang nih leh za nih ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A inkuan kizomdan bangzel a Gad tapate. Zephon suan Zephonte: Haggi suan Haggite leh Sunni suan Sunnite.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ozni suan Oznite.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eri suan Erite; Arod suan Arodte leh Areli suan Arelite.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hiaite a simdan bang ua Gad tapate suante ahi uh, sing li leh za nga ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Judah tapate: Er leh Onan; Er leh Onan Kanan gam ah a si uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Judah suante inkuan paidan hichi ahi: Shelah suan Shelahte;
  </para>
  <para style="p">
    <verse number="21" style="v" />Perez suan Perezte: Zer suan Zerte ahi uh. Hezron suan Hezronte; Hamul suan Hamulte ahi uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiaite a simdan bang un Judah tapate suante ahi uh, nuai guk leh sing khat leh sang guk leh za nga ahi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A inkuan uh kizomdan bangzel a Issakar suante: Tola suante Tolate; Pua suante Puate.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jasub suante Jasubte. Shimron suante Shimronte ahi uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiaite a simdan bang un Issakar tapate suante ahi ua, sing guk leh sang li leh za thum ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A inkuan uh kizomdan bangzel a Zebulun suante; Sered suante Seredte; Elon suante Elonte; Jaleel suante Jaleelte ahi uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiaite a simdan bang ua Zebulunte suante ah uh, sing guk leh za nga ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A inkuan uh kizomdan bangzel a Joseph suante: Manasseh leh Ephraim.
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh suante: Makir suante Makirte; Makir in Gilead a suang a; Gilead suante Gileadte ahi uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiaite Gilead suante ahi uh: Iezer suante Iezerte; Helek suante Helekte;
  </para>
  <para style="p">
    <verse number="31" style="v" />Asriel suante Asrielte; Sekem suante Sekemte;
  </para>
  <para style="p">
    <verse number="32" style="v" />Semidah suante Semidhte; Hepher suante Hepherte ahi uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hepher tapa Zelophehad in tapa neilou in tanute a nei a: Zelophehad tanute min Malah, Nova, Hoglah, Milkah leh Tirzah ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hiaite Manasseh suante ahi uh. A sim teng uh sing nga leh sang nih leh za sagih ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hiai a inkuan uh kizomdan bangzel a Ephraim suante ahi uh: Suthelah suante Suthelahte; Beker suante Bekerte; Tahan suante Tahante ahi uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Hiaite Suthelah suante ahi uh: Eran suante Erante ahi uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hiaite a simdan bang un Ephraim suante inkuan ahi ua, sing thum leh sang nih leh za nga ahi. Hiai a inkuan kizomdan bangzel ua Joseph suante ahi uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />A inkuan uh kizomdan bangzel a Benjamin suante: Bela suante Belate; Asbel suante Asbelte; Ahiram suante Ahiramte.
  </para>
  <para style="p">
    <verse number="39" style="v" />Supham suante Suphamte; Hupham suante Huphamte ahi uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Bela suante Ardi leh Naaman ahi uh: Ardi suante Ardite; Naaman suante Naamante ahi uh.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hiaite a inkuan uh kizomdan bangzel in Benjamin suante ahi uh. A sim teng uh sing li leh sang nga leh za guk ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hiaite a inkuan uh kizomdan bangzel a Dan suante ahi uh: Saham suante Sahamte ahi uh. Hiaite a inkuan uh kizomdan bangzel a Dan suante ahi uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Saham suante tengteng a simdan bang un sing guk leh sang li leh za li ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />A inkuan uh kizomdan bangzel a Asher suante ahi uh: Jimna suante Jimnate; Isvi suante Isvite.
  </para>
  <para style="p">
    <verse number="45" style="v" />Beriah suante Beriahte ahi uh: Heber suante Heberte; Malkiel suante Makielte ahi uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Asher tanu min Ser ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hiaite Asher tapate suan a sim teng uh ahi ua, sing nga leh sang thum leh za li ahi.
  </para>
  <para style="p">
    <verse number="48" style="v" />A inkuan uh kizomdan bangzel a Naphtali suante, Jazeel suante Jazeelte; Guni suante Gunite;
  </para>
  <para style="p">
    <verse number="49" style="v" />Jezer suante Jezerte; Silem suante Silemte ahi uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hiaite a inkuan uh kizomdan bangzel a Naphtali suante ahi uh: a sim teng uh sing li leh sang nga leh za li ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hiaite Israel tate a sim teng uh ahi ua, nuai guk leh sang khat leh za sagih leh sawmthum ahi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="53" style="v" />Hiaite a min zah zel un gam hawm sak ding ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />A tam deuhte gam na pe tam dia, a tawm deuhte gam na pe tawm ding ahi. A sim dan bang in gam piak chiat ding ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Himahleh aisan a gam hawm ding ahi: a pute nam min kizomdan bangzel in gam a tang ding uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Aisan bangzel in a tam leh a tawmte kiang ah gam hawm ahi ding hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Hiai Levite, a inkuan kizomdan bangzel a simte ahi uh. Gershon suante Gershonte: Kohath suante Kohathte: Merari suante Merarite ahi uh.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hiaite Levi suante ahi uh. Libni suante, Hebron suante, Mahli suante, Musi suante, Korah suante ahi uhi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Kohath in Amram a suang a, Amram zi min Jokebed, Levi tanu, Aigupta gam a Levi apan a piang ahi a, aman Amram lak ah Aron leh Mosi leh a sanggamnu Miriam a suang hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Aron in Nadab, Abihu, Eleazar leh Ithamar a suang hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Nadab leh Abihu in Toupa zatlouh chi mei a zat lai un a si uhi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Sim tengteng pasal kha khat chiang tunglam teng sing nih leh sang thum ahi. Israel mite lak ah gam hawm tang ding ahihlouh ziak un Israel mite lak ah sim ahi kei uh.
  </para>
  <para style="p">
    <verse number="63" style="v" />Jeriko zawn, Jordan gei, Moab phaizang a Israel suante Mosi leh siampu Eleazar in a sim uh hiaite ahi uh.
  </para>
  <para style="p">
    <verse number="64" style="v" />Sinai gamdai a Israel mite Mosi leh siampu Aron in a simte khat lel leng a omta kei hi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Toupa’n , “Gamdai ah a si ngeingei ding uh” a na chi khinta ngal a. Jephunneh tapa Kaleb leh Nun tapa Joshua loungal kuamah dam a omkei uhi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joseph tapa Manasseh suan a Manasseh tapa Makir, huai mi tapa Gilead, huai mi tapa Hepher tapa Jelophehad tanute a hongpai ua, a tanute min, Mahlah, Noah, Hoglah, Milkah leh Tirzah ahi uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kihoupihna puanin kongkhak ah Mosi, siampu Eleazar leh miliante leh omkhawmte tengteng ma a Kihoupihna puanin kongkhak ah a va ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Gamdai ah ka pu uh a si a, Toupa kalh a kikhawm, Korah pawl ah a telkei. Himahleh amah khelh ziak in a si a, tapa a neikei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tapa a neih louh ziak lel in bangdia ka pa uh min a suante apan mang ding ahia? Ka pa unaute lak ah tantuan honpia un,” a chi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi in a thu uh Toupa ma ah a tun hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n Mosi a houpih a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Jelophehad tanute’n a hihdik uhi. A pa uh unaute lak ah tantuan na bawlsak ding ahi. A pa uh tantuan na piak ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel suante kiang ah mi tapa neilou a a sih leh a gou a tanute na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tanu a neihkei leh a gou a unaute na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Unaute a neihkei leh a gou a pa unaute na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pa’n unaute a neihkei leh a gou a tanau na pe ding ua, aman a luah ding hi. Toupa’n Mosi thu a piak bang in Israel suante ading in danthupiak kip ahi ding, chi in gen in, a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toupa’n Mosi kiang ah, “Abarim tang ah hohtou inla, Israel suante ka piak ding gam va en in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na muh khit chiang in na unaupa Aron a chipihte kiang a pi ahihmah bang in nang leng pi na hita ding hi!
  </para>
  <para style="p">
    <verse number="14" style="v" />Jin gamdai a kikhawmte a phunlai ua a mitmuh ua tui a kei hon pahtawi dia k’on thupiak kalh a na hel ziak in” a chi hi. Huaite Jin gamdai a Kadesh a Meribah tuite ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi in Toupa a houpih a:
  </para>
  <para style="p">
    <verse number="16" style="v" />“Khawmpite tung a om ding mi khat, sa tengteng khate Pathian, Toupa’n sep hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toupa mi khawmpite chingtu neilou belam bang a a omlouhna ding un, a ma uh kai ding, amaute pikhia a, pilut ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa’n Mosi kiang ah, “Kha omnapa Nun tapa Joshua pi inla, a tung ah na khut nga in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Siampu Eleazar leh khawmpite ma ah dingsak inla, a mitmuh un amah na guan in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel suante omkhawm tengteng in a thu a man theihna ding un na zahtakhuaina a tung ah nga in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in amah siampu Eleazar ma ah ading dia, aman Toupa ma ah Urim thu a laksak dia; a thu in a pawt ding ua, a thu in a lut ding ua, amah leh Israel suan tengteng, omkhawmte toh” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosi in Toupa thupiak bang in a hih a; Joshua a pi a, Eleazar leh omkhawmte ma ah a dingsak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in a tung ah a khut a nga a, Mosi zang a Toupa’n a gen bang in na a guanta hi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante thupia inla, a kiang uah, kei adia gimlim mei a thillat, ka kiang a thillat pen a hungeih in na lan ding uh ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kiang uah, Hiai mei a thillat Toupa kiang a na lat ding uh ahi. Belamnoupa, kum khat a upa, gensiatbei, ni teng in nih, haltum thillat a lat gige ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Belamnou khat zingsang in na lan ding ua, khat nitaklam in na lan ding uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tangbuang thillat ding in tangbuang nelte ephah mun sawm a khen, mun khat sathau suk hin mun li a khen, mun khat a hel toh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa adia mei a thillat, gimlim dia Sinai tang a sehsa haltum thillat lat gige ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Belamnou khat latna a dawn thillat, hin mun li a khen, mun khat ahi ding ahi. Toupa adia uain, dawn thillat Mun Siangthou ah na sungkhe ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Belamnou khat nitaklam in na lan dia; zingsang lam a tangbuang thillat bang in leh dawn thillat bang in Toupa adia gimlim ding in mei a thillat na lan ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Sabbath ni’n belamnoupa kum khat a upa, gensiatbei nih leh tangbuang thillat ading in tangbuang nelte ephah mun sawm a khen, mun nih sathau a helkhawm leh dawn thillat toh na lat ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiai Sabbath teng a haltum thillat lat gige leh dawn thillat simlouh a haltum thillat lat ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na kha thak teng un Toupa adia haltum thil na lat ding uh ahi. Bawngtal nih leh belampa khat leh belamnoupa kum khat a upa gensiatbei sagih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Bawngtal chih ah tangbuang thillat ding in tangbuang nelte sathau a helkhawm ephah mun sawm a khen, mun thum; belam khat a tangbuang thillat ah tangbuang nelte, sathau a helkhawm mun sawm a khen, mun nih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Belamnou chih ah tangbuang thillat ah tangbuang nelte, sathau a helkhawm mun sawm a khen, mun khat. Hiai haltum thillat gimlim Toupa adia mei a thillat ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A dawn thillat uh bawngtal khat ah uain hin kimkhat ahi dia, belampa khat ah hin mun thum a khen, mun khat, belamnou khat ah hin mun li a khen, mun khat. Hiai kumtawn a kha teng a haltum thillat ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa kiang a khelh thoihna dia kelpa khat na lat ding uh ahi. Haltum thillat lat gige leh huai dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kha khatna, ni sawmlehli ni Toupa Paikan ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai kha ni sawmlehnga ni Ankuanglui ni ahi dia; ni sagih sung tanghou silngou sohlouh nekding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni khat ni’n khawmpi siangthou a om dia; nna himhim na sem ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mei a thillat bel Toupa kiang a na lat ding uh ahi. Bawngpa tung nih leh belampa khat leh belamnoupa kum khat a upa sagih; na ngaihtuah ua gensiatbei ahi ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangbuang nelte, sathau helkhawm, a tangbuang thillat utoh: bawngtal khat ah mun sawm a khen, mun thum belampa khat ah mun sawm a khen, mun nih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Belamnou sagih bel belamnou khat ah mun sawm a khen, mun khat ahi ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nou adia kilemna bawlna ding khelh thoihna ding in kelpa khat.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiaite zingsang a haltum thillat dawn thillat simlouh a lat gige ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hichibang in Toupa adia gimlim, mei a thillat nekding ni teng in, ni sagih sung na lan ding uh ahi; haltum thillat lat gige leh dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="25" style="v" />A ni sagih ni’n khawmpi siangthou na nei ding ua, nna himhim na sem ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na nipikal Ankuangluina, na buh thak tung Ankuangluina Toupa adia thil thak tangbuang thillat na lat ni un leng khawmpi siangthou na nei ding ua; nna himhim na sem ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toupa adia gimlim haltum thillat bel na lat ding uh ahi; bawngpa tuai nih, belampa khat, belamnoupa kum khat a upa sagih;
  </para>
  <para style="p">
    <verse number="28" style="v" />A tangbuang thillat uh, tangbuang nelte sathau a helkhawm, bawngtal khat ah mun sawm a khen a mun thum.
  </para>
  <para style="p">
    <verse number="29" style="v" />Belampa khat ah mun sawm a khen a mun nih, belamnou sagih, belamnou khat chiat ah mun sawm a khen, a mun khat.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nou adia kilemna bawlna ding kelpa khat toh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Haltum thillat gige leh huai a tangbuang thillat, huaite dawn thillat toh na lat ding uh ahi, na ngaihtuah ua gensiatbei ahi ding ahi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, a kha sagihna, a ni khat ni’n khawmpi siangthou na nei ding ua; nna himhim na sem ding uh ahi kei; nou ading in pengkul mut ni ahi ding ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa adia gimlim ding in haltum thillat na lan ding uh ahi: Bawngpa tung khat, belampa khat, belamnoupa kum khat a upa gensiatbei sagih.
  </para>
  <para style="p">
    <verse number="3" style="v" />A tangbuang thillat uh, tangbuang nelte sathau a helkhawm, Bawngpa khat ah mun sawm a khen, mun thum, belampa khat ah mun sawm a khen, mun nih,
  </para>
  <para style="p">
    <verse number="4" style="v" />belamnou sagih, khat chiat ah mun sawm a khen, mun khat.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nou adia kilemna bawlna ding in khelh thoihna kelpa khat toh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kha thak haltum thillat leh huai tangbuang thillatte, haltum thillat lat gige leh huai a tangbuang thillat, dawn thillat, a hih dan ngeina uh Toupa adia gimlim ding a mei a thillatte simlouh in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiai a kha sagihna, ni sawm ni’n khawmpi siangthou na nei ding uh. Na hinna uh zangsakin nna himhim nasem ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toupa adia gimlim ding in haltum thillat na lan ding uh ahi. Bawngpa khat, belampa khat, belamnoupa kum khat a upa sagih; na ngaihtuah ua gensiatbei ahi ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A tangbuang thillat uh, tangbuang nelte sathau a helkhawm, bawngtal khat ah mun sawm a khen, mun thum, belampa khat ah mun sawm a khen, mun nih.
  </para>
  <para style="p">
    <verse number="10" style="v" />Belamnou sagih, belamnou khat chiat ah mun sawm a khen, mun khat.
  </para>
  <para style="p">
    <verse number="11" style="v" />Khelh thoihna ding in kelpa khat toh; kilemna dia khelh thoihna, haltum thillat lat gige, huai a tangbuang thillat leh a dawn thillat uh simlouh in.
  </para>
  <para style="p">
    <verse number="12" style="v" />A kha sagihna, ni sawmlehnga ni’n khawmpi siangthou na nei ding ua; bang nna mahmah na sem ding uh ahi kei, Toupa ading in ni sagih sung Ankuang na lui ding uh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa adia gimlim ding in mei a thillat, haltum thillat na lat ding uh ahi. Bawngpa tuai sawmlehthum, belampa nih, belamnoupa kum khat a upa sawmlehli, huaite gensiatbei chiat a hih ding uh ahi:
  </para>
  <para style="p">
    <verse number="14" style="v" />A tangbuang thillat uh sathau toh helkhawm bawngpa sawmlehthum, bawngpa khat ah mun sawm a khen, mun thum, belampa nih, belampa khat ah mun sawm a khen, mun nih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Belamnou sawmlehli, belamnou khat ah mun sawm a khen, mun khat.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khelh thoihna ding kelpa khat toh; haltum thillat lat gige, huai a tangbuang thillat, dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="17" style="v" />A ni nih ni’n bawngpa tuai sawmlehnih, belampa nih, belamnoupa kum khat a upa gensiatbei sawmlehli na lat ding uh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A tangbuang thillat uh leh dawn thillat a dan bangtak in a tam dan bangzel un bawngpa ading, belampa ading leh belamnou ading.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khelh thoihna ding kelpa khat toh. Haltum thillat gige, huai a tangbuang thillat, dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="20" style="v" />A ni thum ni’n bawngpa sawmlehkhat, belampa nih, belamnou kum khat a upa gensiatbei sawmlehli.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tangbuang thillat uh leh dawn thillat a dan bangtak in a tam dan bangzel un bawngpa ading, belampa ading leh belamnou ading.
  </para>
  <para style="p">
    <verse number="22" style="v" />Khelh thoihna ding kelpa khat toh; haltum thillat lat gige leh huai a tangbuang thillat leh huai a dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="23" style="v" />A ni li ni’n bawngpa sawm, belampa nih, belamnoupa kum khat a upa gensiatbei sawmlehli.
  </para>
  <para style="p">
    <verse number="24" style="v" />A tangbuang thillat uh leh dawn thillat, a dan bangtak in a tamdan bangzel un bawngpa ading, belampa ading leh belamnou ading.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khelh thoihna ding kelpa khat toh. Haltum thillat gige, huai a tangbuang thillat leh dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="26" style="v" />A ni nga ni’n bawngpa kua, belampa nih, belamnoupa kum khat a upa gensiatbei sawmlehli.
  </para>
  <para style="p">
    <verse number="27" style="v" />A tangbuang thillat uh leh dawn thillat uh, a dan bangtak in a tam dan bangzel un a tangbuang thillat uh leh dawn thillat uh, a dan bangtak in a tamdan bangzel un, bawngpa ading, belampa ading leh belamnou ading.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khelh thoihna ding kelpa khat toh; haltum thillat lat gige, huai tangbuang thillat leh huai dawn ding thillat simlouh in.
  </para>
  <para style="p">
    <verse number="29" style="v" />A ni guk ni’n bawngpa giat, belampa nih, belamnoupa kum khat a upa gensiatbei sawmlehli.
  </para>
  <para style="p">
    <verse number="30" style="v" />A tangbuang thillat uh leh dawn thillat a dan bangtak in a tam dan bangzel un bawngtal ading;
  </para>
  <para style="p">
    <verse number="31" style="v" />Khelh thoihna ding kelpa khat toh; haltum thillat lat gige, huai a tangbuang thillat leh huai a dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="32" style="v" />A ni sagih ni’n bawngpa sagih, belampa nih, belamnoupa kum khat a upa gensiatbei sawmlehli.
  </para>
  <para style="p">
    <verse number="33" style="v" />A tangbuang thillat uh leh dawn thillat, a dan bangtak in a tam dan bangzel un, bawngpa ading, belampa ading leh belamnou ading.
  </para>
  <para style="p">
    <verse number="34" style="v" />Khelh thoihna ding kelpa khat toh; haltum thillat lat gige, huai a tangbuang thillat leh huai a dawn thillat simlouh in.
  </para>
  <para style="p">
    <verse number="35" style="v" />A ni giat ni’n khawmpi siangthou tak na nei ding ua; nna himhim na sem ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="36" style="v" />Toupa adia gimlim ding in haltum thillat bel na lat ding uh ahi. Bawngpa khat, belampa khat, belamnoupa kum khat a upa gensiatbei sagih.
  </para>
  <para style="p">
    <verse number="37" style="v" />A tangbuang thillat uh leh dawn thillat uh, bawngpa ading, belampa ading leh belamnou ading, a dan bangtak in a tamdan bangzel un.
  </para>
  <para style="p">
    <verse number="38" style="v" />Khelh thoihna ding kelpa khat toh; haltum thillat lat gige leh huai a tangbuang thillat leh huai a dawn ding thillat simlouh in.
  </para>
  <para style="p">
    <verse number="39" style="v" />Na thuchiamte uh, ut thu a thillatte, na haltum thillatte uh, na tangbuang thillatte uh, na dawn thillatte uh, na kilemna thillatte uh sim lou in hiaite Ankuangluina hunbi nei a na neihte uh ni’n Toupa kiang ah na lan ding uhi, chi in, a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Toupa’n Mosi thu a piak tengteng Mosi in Israel suante a hilh hi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Mosi in Israel suan intekpente a houpih a: Toupa’n thu a piak pentak hiai ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi’n Toupa kiang a thu a chiam a ahihkeileh a thuchiam a kihen leh a thuchiam a bohse ding ahi kei. A kam a pawt bangbang a hih ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Numei in leng a nungak lai a, a pa inn a a omlai a, Toupa kiang a thu a chiam a, a thuchiama a kihen a;
  </para>
  <para style="p">
    <verse number="4" style="v" />a thuchiam leh a thuchiam a a kihenna a pa’n a zak a, a pa’n a daihsan maimah leh a thuchiam tengteng a paisuak ding ahi. A thuchiama a kihenna a om gige ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh a pa’n a zak ni a a phalkei leh a thuchiama a kihenna thuchiamte a koi mahmah a paisuak kei ding. A pa’n a phallouh ziak in Toupa’n amah a ngaidam ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Thuchiam min thu khuallou a, a henna a omlai a pasal a neih a;
  </para>
  <para style="p">
    <verse number="7" style="v" />a pasal in a zak a, a zak ni a, a daih dide leh a thuchiam a om gige dia, thuchiama a henna leng a om gige ding.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh a pasal in a zak ni a a phalkei leh a tung a thuchiam leh khuallou a a kihenna a mang dia, Toupa’n amah a ngaidam ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh meithai hiam, mak a omnu hiam thuchiam zaw, a henna tengteng in a delh gige ding.
  </para>
  <para style="p">
    <verse number="10" style="v" />Inn a thu a chiam a, kichiam a a kihen leh,
  </para>
  <para style="p">
    <verse number="11" style="v" />A pasal in a zak a leng a daih dide a, a phallouh kei leh a thuchiam a om gige dia, kichiam a a kihenna leng a om gige ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh a pasal in a zak ni a bangmahlou a bawl a, a hihmang leh a thuchiam hiam, kichiam a a kihenna a kam a thupawt peuhmah a om nawn kei ding. A pasal in a hihmang khinta ahi. Toupa’n amah a ngaidam ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thuchiam tengteng leh hinna hihgim dia hen a kichiamna tengteng a pasal in a kipsak thei in a hihmang thei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh a pasal in a zak ni apan a deihdan leh a thuchiam tengteng leh a tung a henna om tengteng kipsak ahi a; a zak ni apan a daihsan ziak in a kipsak ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh a zak khitnung a bangmahlou a bawl a, a hihman leh a thulimlouhna mawh a puak ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiaite pasal leh a zi kal leh a pa inn a om gige lai a kikal ua dan dia Toupa’n Mosi thu a piakte ahi uh.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Midiante tung ah Israel suante phu la in. Huaikhit chiang in na chipihte kiang a pi na hita ding” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mosi in mipite a houpih a, “Midiante tung a Toupa phulakna tangtun dia Midiante dou ding in na lak ua mi kigalvan uhen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel nam tengteng lak a namchih a mi sang khat zel kidouna a na kuan ding uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Israelte sang tamtak lak apan, namchih apan sang khat chiat, kidouna a kuan ding in sepaih sing khat leh sang nih a pekhia uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Mosi in chichih lak a mi sang khat chiat leh siampu Eleazar tapa Phinehas Mun Siangthou a tuium belsuante, thupiakna dia pengkulte tawi in kidouna ah a kuansak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa’n Mosi thu a piak bang in Midiante a dou ua; pasal teng a that uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A mithahte lak ah Midiante kumpipate leng a tel uh. Huai Midiante kumpipa ngate min, Evi, Rekem, Zur, Hur leh Reba ahi a, Beor tapa Balaam leng namsau in a that uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel suante’n Midiante numei teng leh a tate uh sal in a pi ua; a gan tengteng uh, a belamhon tengteng uh leh a van tengteng uh gallak in a la uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A omna khuate leh a giahna tengteng uh a halvek uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gallak tengteng, mihing leh gan tan in a paipih vek uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Salte, matte leh gallakte, Mosi, siampu Eleazar leh Israel suan omkhawmte kiang ah, Jeriko zawn Jordan gei Moab phaizang a giahphual uh a hontun uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi, siampu Eleazar leh omkhawmte intek penpente’n giahphual pua ah a na dawn uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sepaih heutu, sangte tung a heutute leh zate tung a heutute, kidouna apan hongtungte tung ah Mosi a heh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi in a kiang uah, “Numei tengteng na hinghawi vek uh maw?
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai un, Balaam lemtheih a Peor tung tang thu ah Israelte Toupa tung a taleksak mite hiaite ahi uhi. Toupa mi kikhawmte lak ah hipi a hongleng hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huaiziak in, naupangte lak a pasal tengteng that unla, pasal luppihsa numei teng leng that un.
  </para>
  <para style="p">
    <verse number="18" style="v" />Numei naupang pasal luppih nailouh tengteng nou ading in hinghawi un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Giahphual pua ah ni sagih sung giak unla; kuapeuh mi that leh thah a om misi khoih peuhmah a ni thum ni leh a ni sagih ni’n kisiangsak un, noumau leh na salte uleng.
  </para>
  <para style="p">
    <verse number="20" style="v" />Van himhim leh savun a thilbawl tengteng, kelmul a thilbawl tengteng, sing a thilbawl tengteng thu ah na kisiangsak ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Siampu Eleazar in kidouna a hoh kidou mite kiang ah, “Hiai Toupa’n Mosi thu a piak danthuseh ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bangpeuh dangkaeng, dangkasik, dal, sik, langva leh ngen,
  </para>
  <para style="p">
    <verse number="23" style="v" />mei a hal a setheilou teng mei ah na tholh paisuak ding ua, huchi in a hong siangthou ding uh. Bang peuh, silsiang na tui a hih siangthou ding ahi. Mei a hal thuak theilou peuhmah tui a na tholh paisuak ding uh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A ni sagih ni’n na puan uh na sawp ding ua, na hong siang ding uh. Huaikhit in giahphual ah na honglut ding uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="26" style="v" />“Nang, siampu Eleazar leh omkhawmte inkuan intekpente’n gallak a, a lak uh mihing leh gante simvek un.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gallak mun nih ah khen un; kidouna a kuan kidoumite ading leh omkhawmte ading in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kidouna a kuan galdoumi apan Toupa adia siah piak ding in mihing za nga zel ah khat, mihing apan, bawng apan, sabiltung apan leh belamhon apan sepkhia un.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huaite a tan kimkhat ua pan la unla, Toupa adia vei thillat ding in siampu Eleazar pia un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Israel suante tan sawmnga apan khat, mihing apan, bawng apan, sabiltung apan, belamhon apan leh ganhon apan sepkhia inla, huaite Toupa biakbuk kemmi Levite pia in” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in Toupa’n Mosi thu a piak bang in Mosi leh siampu Eleazar in a hih uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sepaihte’n a mat uh gallak simlouh a lak uh belam nuai guk leh sing sagih leh sang nga,
  </para>
  <para style="p">
    <verse number="33" style="v" />Bawng sing sagih leh sang nga,
  </para>
  <para style="p">
    <verse number="34" style="v" />Sabiltung sing guk leh sang khat,
  </para>
  <para style="p">
    <verse number="35" style="v" />Pasal kithuahpih nailou numei sing thum leh sang nih ahi uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />A kimkhat, kidouna a kuante tantuan, belam nuai thum leh sing thum leh sang sagih leh za nga ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Toupa siah belam za guk leh sawmsagih leh nga ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Bawng sing thum leh sang guk ahi a; huai a Toupa siah sawmguk leh khat ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Sabiltung sing thum leh za nga ahi; huai a Toupa siah sawmguk leh khat ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mihing sing khat leh sang guk ahi ua; huai a Toupa siah mi sawmthum leh nih ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Toupa’n Mosi thu a piak bang in siah, Toupa vei thillat Mosi in siampu Eleazar a pia hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Mosi in galdou mite apan a hawm Israel mite tantuan kimkhat galdou a kuante lak ah a hawm hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mipi tantuan kimkhat belam nuai thum leh sing thum leh sang sagih leh za nga,
  </para>
  <para style="p">
    <verse number="44" style="v" />Bawng sing thum leh sang guk,
  </para>
  <para style="p">
    <verse number="45" style="v" />Sabiltung sing thum leh za nga,
  </para>
  <para style="p">
    <verse number="46" style="v" />Mihing sing khat leh sang guk ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Israel tantuan kimkhat apan Mosi in mihing leh gan sawmnga zel ah khat a la a, Toupa thupiak bang in Toupa biakbuk kemmi Levite a pia hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Sepaihte tung a heutu, sangte tung a heutute, zate tung a heutute’n Mosi a va naih uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mosi kiang ah, Na sikhate’n ka khut ua om kidou mite ka sim ua, kuamah kimlou ka omkei uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Ka hinna ua dia Toupa ma a kilemna bawlna dia Toupa adia thillat mi’n a neih lam uh, dangkaeng a bawl zephoih van, khengawng a bulhte, khutngawng a bulhte, min sawnna zungbuhte, bilbahte, khite, k’on tawi uhi, a chi uh.
  </para>
  <para style="p">
    <verse number="51" style="v" />Mosi leh siampu Eleazar in dangkaeng a bawl van tengteng a na sang uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Sangte tung a heutute leh zate tung a heutute’n dangkaeng Toupa kiang a vei thillat dia a lat tengteng uh sekel sing khat leh sang guk leh za sagih leh sawmnga ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Galdou mite’n a gallak uh amau a chiat ding in a la ngal ua.
  </para>
  <para style="p">
    <verse number="54" style="v" />Mosi leh siampu Eleazar in sangte tung a heutu leh zate tung a heutute dangkaeng a la ua, Israel suante theihgigena ding in Kihoupihna puanin ah Toupa ma ah a hontawi uhi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Reuben leh Gad tate’n gan a hau mahmah ua; Jazer gam leh Gilead gam a muh un, a mun gan adia hoihtak hi’n a thei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in Gad tate leh Reuben tate’n Mosi, siampu Eleazar leh omkhawm mipite a va houpih uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ataroth, Dibon, Jazer, Nimrah, Heshbon, Elealeh, Shebam, Nebo leh Beon,
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel omkhawmte ma a Toupa’n a zoh gam gante ading in a hoih a na sikhate’n ganhonte ka nei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hoih na sakleh hiai gam ka luah ding un honpia inla, Jordan lui honpi galkai dah maive” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mosi in Gad tate leh Reuben tate kiang ah, “Na unaute uh kidouna a kuan ding ua, nou bel hiai ah na om maimah ding uh maw?
  </para>
  <para style="p">
    <verse number="7" style="v" />Bangdia Toupa’n a piak gam a lutlou dia Israel suante lungtang lunglel sak na hi ua?
  </para>
  <para style="p">
    <verse number="8" style="v" />Kadesh-barnea apan gam va enkhe dia ka sawl in na pate un hichi mah bang in a hih uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Eskol guam a tun touh un gam a va mu ua, Toupa’n gam a piak a a lut noplouhna ding un Israel suante lungtang a lunglel sak uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai ni’n Toupa a heh mahmah a, a kichiam a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Aigupta gam apan hongpawt, kum sawmnih chiang tunglam mi himhim in Abraham, Isak leh Jakob, kiang a kichiam a, ka piak gam kuamah in a mu kei ding uh; a honzuih taktak louh ziak un.
  </para>
  <para style="p">
    <verse number="12" style="v" />‘Keniz mi Jephunneh tapa Kaleb leh Nun tapa Joshua kia loungal, amau bel Toupa a zuih taktak ziak un,’ a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Israelte tung ah Toupa a heh mahmah a, Toupa mitmuh a thil hoihlou hihmi suan tengteng a manthat vek masiah uh gamdai ah kum sawmli a vakvai sak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai un, Israelte tung a Toupa hehna lauhuai tak behlap in nou gilou in na pute uh sik in na dingta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa zuilou a, na om himhim uleh aman amaute gamdai ah a omsak nawn ding hi. Hiai mi tengteng na hihmang mai kei ding u maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A vanaih ua, a kiang ah, “Hiai ah ka gan ua ding in belamhuangte leh ka tate uh ading in khua ka sat ding uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kou bel a mun ding uh ka tut masiah uh Israel suante ma a pai ding in ka kigalvan ding uhi. Hiai gam a mite ziak in ka tate uh kulh nei khuate ah a teng ding uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel suante michih in a mun luah ding a luahchiat ma un ka inn uah ka paikik kei ding uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka luah ding uh bel hiai lam gal Jordan suahlam a hih ziak in Jordan galkhat lam leh a khen lam zaw ka luahpih sam kei ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosi in a kiang uah, “Huchibang na chih ua, galdou dia Toupa ma a kuan dia na kigalvat ua,
  </para>
  <para style="p">
    <verse number="21" style="v" />Toupa ma a gam zoh a hih masiah na lak ua kigalvan tengteng Toupa ma a Jordan na galkah vek ua, a ma a melmate a delhkhiak mateng leh
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa ma a gam lak a om a, huaikhit chiang a na kiknawn ding uleh Toupa leh Israelte ma ah na mohpuakna ua pan na siangta ding ua, Toupa ma ah hiai gam na luah ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh huchibang a na hihkei uleh, ngai un, Toupa tung ah na khial uh ahi dia, na khelhna un a hon mukhe ngeingei ding chih thei un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na tate uh ading in khuate sat unla, na belamte uh ading in leng huangte bawl unla, na gen bangbang un hih un” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Gad tate leh Reuben tate’n Mosi kiang ah, “Na sikhate’n ka toupa uh thupiak bang in ka hih ding uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka zi, ka tate uh, ka belamhonte uh leh ka ganhon tengteng uh Gilead gam khuate ah a na om ding uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Himahleh na sikha, kidou dia kigalvan tengteng in ka toupa uh gen bang in Toupa ma ah ka va galkah ding uh” chi in, a gen uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Mosi in, a tungtang thu uah siampu Eleazar, Nun tapa Joshua leh Israel nam inkuan intekpente thu a pia hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mosi in a kiang uah, “Gad tate, Reuben tate leh galdou dia kigalvan tengteng in Toupa ma a Jordan lui a hong galkah pih ua, huai gam na zoh uleh Gilead gam pen a luah ding ua na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh kigalvana a hong galkah pihkei uleh Kanan gam ah na lak uah a telmai ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Gad tate leh Reuben tate’n, “A sikha kiang a Toupa’n a gen bang in ka hih ding uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kigalvan a Toupa ma a galkah in Kanan gam ah ka lut ding ua, ka gamluah ding uh Jordan luikhen lam ah ahilai ding” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mosi in Gad tate, Reuben tate leh Joseph tapa Manasseh suan nam kimkhatte Amor kumpipa Sihon gam, Bashan Kumpipa Og gam, huai gamte a khua tengteng toh, a kim gam a khuate nangawn toh a pia hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gad tate’n Dibon, Ataroth, Aroer;
  </para>
  <para style="p">
    <verse number="35" style="v" />Atroth leh Shophan, Jazer, Jogbehah;
  </para>
  <para style="p">
    <verse number="36" style="v" />Beth Nimrah leh Beth Haran a lam ua, khopi kulhneite, belam huangte toh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuben tate’n Heshbon, Elealeh, Kirjathaim,
  </para>
  <para style="p">
    <verse number="38" style="v" />Nebo leh Baal meon, a minte khek khit ahi, leh Sibma a lam ua; a khosatte uh min dang a phuak uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Manasseh tapa Makir tate Gilead gam ah a hoh ua, a la ua, huai a teng Amorte a hawlkhia uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mosi in Gilead gam Manasseh tapa Makir a pia a; huai ah a teng hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Manasseh tapa Jair in huai a khuate a vala a, Havothjair a sa hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Nobah in Kenath a vala a, a khopelte toh, amah min tam in Nobah a sa hi.
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mosi leh Aron makaih a Aigupta gam apan a pawlpawl a pawt a, a pai zel dan uh hiai bang ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa thupiak in a paikhia ua, a pai zel nate uh Mosi in a gelh a; a paikhiak ua a painate uh hiaite ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kha khatna, ni sawmlehnga ni’n Rameses apan a pawt ua; Paikan Ankuanglui ni zing in Aigupta miteng muh in hangsantak in Israel suante a pawtkhia uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aigupta mite’n a ta masa pen teng uh Toupa’n a thahsakte a vui ua, a pathiante uh leng Toupa’n a thukhen khumta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Israel suante Rameses apan a pawt ua, Sukot ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sukot apan a pawt ua, gamdai phak tung Etham ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Etham apan a pawt ua, Baal-zephon bul a Pi-hahiroth lam ah a kinung khin ua, Migdol chin ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pi-Hahiroth chin apan a pawt ua, tuipi a paltan ua, gamdai ah a lut uh. Etham gamdai ah ni thum lam a pai ua, Marah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Marah apan a pawt ua, Elim a tung uh. Elim ah tuinak nei sawmlehnih leh tum sing sawmsagih a om a; huai ah giahphual a sat uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Elim apan a pawt ua, Tupi San ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuipi San apan a pawt ua, Sin gamdai ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sin gamdai apan a pawt ua, Dophkah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Dophkah apan a pawt ua, Alush ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Alush apan a pawt ua, Rephidim ah giahphual a sat ua, huai ah mipite dawn ding tui a omkei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rephidim apan a pawt ua, Sinai gamdai ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sinai gamdai apan a pawt ua, Kibroth-hattaavah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kibroth-hattaavah apan a pawt ua, Hazeroth ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hazeroth apan a pawt ua, Rithmah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Rithmah apan a pawt ua, Rimmon-parez ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Rimmon-parez apan a pawt ua, Libnah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Libnah apan a pawt ua, Rissah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Rissah apan a pawt ua, Kehelathah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kehelathah apan a pawt ua, Shepher tang ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shepher tang apan a pawt ua, Haradah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Haradah apan a pawt ua, Makheloth ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Makheloth apan a pawt ua, Tahath ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tahath apan a pawt ua, Terah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Terah apan a pawt ua, Mithkah ah giahphual a sat uh;
  </para>
  <para style="p">
    <verse number="29" style="v" />Mithkah apan a pawt ua, Hashmonah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hashmonah apan a pawt ua, Moseroth ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Moseroth apan in a pawt ua, Bene-jaakan ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Bene-jaakan apan a pawt ua, Hor-hagidgad ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hor-hagidgad apan a pawt ua, Jotbathah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jotbathah apan a pawt ua, Abronah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Abronah apan a pawt ua, Ezion-geber ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ezion-geber apan a pawt ua, Jin gamdai ah giahphual a sat uh huai bel Kadesh leng a chi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Kadesh apan a pawt ua, Edom gam chin a Hor tang ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Siampu Aron Toupa thupiak in Hor tang ah a hohtou a, Israel suante Aigupta gam apan a hongpawt uh kum sawmli, kha nga, ni khat ni’n huai ah a sita hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Aron Hor tang a a sih in kum za leh sawmnih leh thum ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kanan mi, Kanan gam simlam a om Arad kumpipa’n Israel suante a hongpai uh a naza hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hor tang apan a pawt ua, Zalmonah ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="42" style="v" />Zalmonah apan a pawt ua, Punon ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Punon apan a pawt ua, Oboth ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Oboth apan a pawt ua, Moab gam naih Ije abarim ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Ije abarim apan a pawt ua, Dibon gad ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="46" style="v" />Dibon gad apan a pawt ua, Almon diblathaim ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="47" style="v" />Almon diblathaim apan a pawt ua, Nebo chin a Abarim tang ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Abarim tang apan a pawt ua, Jeriko zawn, Jordan gei Moab phaizang ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Jordan gei Beth jeshimoth apan Abelshitim pha in Moab phaizang ah giahphual a sat uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jeriko zawn Jordan gei Moab phaizang ah Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="51" style="v" />Israel suante houpih inla, a kiang uah Jordan lui na kan ua, Kanan gam na lut chiang un,
  </para>
  <para style="p">
    <verse number="52" style="v" />Huai gam a om tengteng na delhkhe vek ding ua, a suang milim pathian tengteng uh na hihse vek ding ua, a milim sunte uh na hihse vek ding ua, a mun sangte uh na hihse vek ding uh ahi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Gam na luah ding ua, huai ah na teng ding uh. Na luah ding ua gam k’on piaksa na hi uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />A chi dungzui bangzel in aisan in gam na luah ding ua, a inbul deuhte gam za deuh na pe ding ua, a inbul lou deuhte gam neudeuh na pe ding uh. Aisan a pukna peuh mi chih a tuam ahi dia; na pi leh pute uh chi paidan bangzel in na luah ding uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Himahleh huai gam a omte na delhkhiak kei uleh na omsakte uh na mit ua ding in sutna zum leh na sa ua ding in ling bang ahi ding ua, na omna gam uah buaina a hontun ding uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Hichi ahi ding a, a tung ua hih ka tup bang na tung uah ka hih ding, chi in, a chi hi.
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante thu pia inla, a kiang uah, Kanan gam na tun chiang un, Kanan gam, a gamgi dan dungzui zel a na luah ding gam uh,
  </para>
  <para style="p">
    <verse number="3" style="v" />simlam na luah ding chiang uh Jin gamdai apan Edom gam zulzul ahi dia, simlam gamgi Chi Tuipi tawp apan suahlam pang ahi ding.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na gamgi uh Akrabbim tung kahna simlam pang ah a kawi dia, a hong pawtna Kadesh-barnea simlam ah ahi dia, Hazaraddar ah a pai dia, Azmon ah a pai zel ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gamgi Azmon apan Aigupta lui tan in a kawi dia, a tunna tuipi ah ahi ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tumlam pang ah tuipi thupi a gamgi ding in na tang ding ua, hiai tumlam a na gamgi uh ahi ding.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiai mallam a na gamgi uh ahi ding. Tuipi lian apan Hor tang huap in na bawl ding uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hor tang apan Hamath lutna tan in na bawl dia, gamgi tunna bel Zedad ah ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gamgi Jiphron ah a pai zel dia, a tunna Hazarenan ah ahi ding. Hiai mallam a na gamgi uh ahi ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Suahlam a na gamgi uh Hazarenan apan Shepham tan in na bawl ding uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gamgi Shepham apan Riblah tan in Ain suahlam pang ah a suk pai dia; huchi in gamgi a pai suksuk dia, Kinereth tuipi suahlam pang a sun ding.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gamgi Jordan ah a paisuk dia, a tunna Chi Tuipi ah ahi dia hiai a kimvel a gamgi paidan bang in na gam uh ahi ding, chi in, a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mosi in Israel suante thu a pia a, Hiai Toupa’n nam kua leh a kimkhatte piak dia thu a piak aisan a na luah ding gam uh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Reuben tate nam in a inkuan uh dungzui zel leh Gad tate nam in a inkuan uh dungzui zel leh Manasseh nam kimkhat in leng a gam luah ding uh a tangta ngal ua.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nam nih leh nam kimkhatte’n a gam luah ding uh ni suahna lam Jeriko zawn Jordan gal suahlam ah a tangta uh, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="17" style="v" />Luah dia gam hon khennen pihte min hiaite ahi. Siampu Eleazar leh Nun tapa Joshua.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gam luahdia khennen ding in namchih apan a intekpen khat chiat na tel ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai mite min bel hiaite ahi. Judah nam a mi Jephunneh tapa Kaleb.
  </para>
  <para style="p">
    <verse number="20" style="v" />Simeon tate nam a mi Amihud tapa Semuel.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin nam a mi Kislon tapa Elidad.
  </para>
  <para style="p">
    <verse number="22" style="v" />Dan tate nam lak a intek pen Jogli tapa Bukki.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph tate lak a mi, Manasseh tate nam intek pen Ephod tapa Haniel.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ephraim tate nam lak a intek pen Sitan tapa Kemuel.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zebulun tate nam lak a intek pen Parnak tapa Elizaphan.
  </para>
  <para style="p">
    <verse number="26" style="v" />Issakar tate nam lak a intek pen Azan tapa Paltiel.
  </para>
  <para style="p">
    <verse number="27" style="v" />Asher tate nam lak a intek pen Selomi tapa Ahihud.
  </para>
  <para style="p">
    <verse number="28" style="v" />Naphtali tate nam lak a intek pen Ammihud tapa Padahel.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiaite Kanan gam a Israel suante gam luah ding hawm dia Toupa’n thu a piakte ahi uhi.
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Jeriko zawn Jordan gei, Moab phaizang ah Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="2" style="v" />Israel suante thu pia inla, a gam uah Levite tenna ding khuate bawlsak uhen. A gante uh tatna ding in khaw dainawl kim Levite na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khuate a tenna ding uh ahi dia, a kimte bel bawng leh a gante leh a ganvulh tengteng ading ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Levite na piak ding dainawl khaw kulh apan tong sang khat a sau ahi ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kulh pawlam apan na teh dia, suahlam pang ah tong sang nih, mallam pang ah tong sang nih, khopi bel a laitak ah a om ding ahi. Hiai amau dainawl tuam ahi ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levite na piak ding khuate lak ah tualthatte taina ding kihumbitna khopi guk ahi dia; huaite lou khua sawmli leh nih na piaklai ding uh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Levite na piak ding khua tengteng khua sawmli leh giat ahi ding. Dainawl toh na piak ding uh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel suante luah khua na piak dan ding, mi tamte na pe tam dia, a tawmte na pe tawm ding ahi. Michih in a luah uh gam tamdan dungzui a khua Levite na piak ding uh ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa’n Mosi a houpih a:
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel suante houpih inla, a kiang uah,
  </para>
  <para style="p">
    <verse number="11" style="v" />Jordan lui na galkah ua Kanan gam na lut chiang un kihumbitna khua na sep ding uh ahi, tualthat kha mi taina ding in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai khuate, phulami apan na kihumbitna khua uh, omkhawmte ma a vaihawmsak dia adin ma a tualthatmi a sihlouhna ding ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nou adia kihumbitna ding na sehte uh khopi guk ahi ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jordan gal ah khopi thum na sep ding ua, Kanan gam ah khopi thum na sep ding ua, kihumbitna khopite ahi ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel suante leh namdang leh a kiang ua tengte ading in hiai khopi gukte kihumbitna ahi dia, huai ah kuapeuh mi that kha a tailut ding ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh mi kuahiam in sik a mi a sat a, a sih leh tualthat ahi a, tualthat bel hihlup ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Si khop a suang a mi a den a, a sih leh tualthat ahi a, tualthat bel hihlup ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahihkeileh mi khat in mi khat thei sing in deng henla, sita leh tualthat ahi a, tualthat bel hihlup ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sisan phulami’n tualthatmi a that dia, a muh peuh chiang in a that ding ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi khat peuh in huatna toh tupkholhna nei in midang khat sawn henla, ahihkeileh tupmawng in banghiam in deng henla, huai mi sita leh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Ahihkeileh kimelmakna nei in a khuttum in tum henla, huai mi sita leh a hihlumpa hihlup ngeingei ding ahi. Amah tualthat ahi a, sisan phulami in a thah ding ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh kimelmakna nei hilou a, kuahiam khat in midang a sawn khak ahihkeileh tup mawng hilou a amah a den khak a,
  </para>
  <para style="p">
    <verse number="23" style="v" />ahihkeileh amah mulou a, amah that thei suang a tung a a khiaka, amah a sih leh a melma leng hilou a, hihnat tum leng hilou a hih ziak in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Omkhawmte’n hiai vaihawmna dan bang in a hihlummi leh sisan phulami vai a hawmsak ding uh ahi:
  </para>
  <para style="p">
    <verse number="25" style="v" />Omkhawmte’n tualthatmi sisan phulami apan a humbit ding ua, omkhawmte’n a taina, a kihumbitna khua ah a tengsak ding ua, sathau siangthou nilh a om siampu lian a sih mateng huailai khua ah a teng ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh chiklaipeuh in tualthatmi a taina, a kihumbitna khaw gamgi pawlam a pai a;
  </para>
  <para style="p">
    <verse number="27" style="v" />sisan phulami in a kihumbitna khaw pawlam a a muh a, sisan phulami in a thah leh a sisan ah mawh a pawkei ding.
  </para>
  <para style="p">
    <verse number="28" style="v" />Siampu lian a sih mateng a kihumbitna khua ah a teng gige ding a, himahleh siampu a sih in bel tualthatmi a tenna gam ah a paikik ding ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiai thilte na suante uh tan a na tenna peuh ua na vaihawm dan ding uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kuapeuh in mi a thah leh tualthatmi pen theihpihte kam apan thupawt a hihlup ding ahi. Himahleh theihpih khat kia mi hihlupna ding in a hun kei.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tualthatmi na tan ding uh ahi kei. Sihna khop a mawh ahi a, hihlup ngeingei ding ahizaw.
  </para>
  <para style="p">
    <verse number="32" style="v" />Siampu sih ma in, kihumbitna khua a tailut kuapeuh a gam a sawl kiknawn dia tatna sum na lak ding uh ahi kei.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in na tenna gam uh na hih thanghuai kei ding ua, sisan in gam a hih thanghuai leh sisan suahna gam hih thanghuai silna ding in a suahmi sisan kia lou lah zattheih ahi ngal kei a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na tenna gam uh, ka omna na hih thanghuai ding uh ahi kei. Kei Toupa lah Israel suante lak ah ka om ngal a, chi in, a chi hi.
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Joseph inkuanpihte lak a mi, Manasseh tapa Makir tapa Gilead tate inkuan intekpente lak a mite’n a honnaih ua, Mosi leh heutu, Israel suante intekpente ma ah thu a gen uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“ Toupa’n ka toupa Israel suante aisan a, a luah ding uh gam pe ding in thu a pia hi. Toupa’n ka toupa, ka unaupa uh Jelophehad gam a tanute pe ding in nang thu a honpia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amau Israel suante lak a mi, namdang kuapeuh tate a va kitenpih uleh, ka pi leh pute uh gam a luah uh laksak a, a kitenpih uh namte gam toh gawm ding ahi dia; huchibang in ka gam tantuan ua kipan lakkhiak a ahi ding hi
  </para>
  <para style="p">
    <verse number="4" style="v" />Israel suante Jubili a hongtun chiang in a gam uh a va kitenpih uh namte gam toh gawm ding ahi dia; huchi in ka pi le pute uh gam apan amau gam lakhek a honghi ding hi” a chi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi in, Toupa thu bang in Israel suante thu a pia a; “Joseph tate nam in a gen dik uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jelophehad tanute tungtang thu a Toupa’n thu a piak pen hiai ahi. Hoih a saksak uh kitenpih uhen la, himahleh a pate uh nam pih lak a mi ngei a kitenpih ding uh ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Israel suante gam pen namdang kiang a suan ahi kei ding. Israel suante’n a pi leh pu uh nam gam a neih gige ding uh ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Israel suante lak a gouluah ding tanu peuhmah Israel suante’n a pi leh pute uh gam a luahchiat zel theihna ding un a pa nampih lak a mi zi a hih ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in gam bel namdang kiang a suan ahi kei ding hi. Israel suante’n amau gam chiat a tang gige ding uh ahi ngal a’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa’n Mosi thu a piak bang in Jelophehad tanute’n a hih uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jelophehad tanu Mahlah, Tirzah, Hoglah, Milkah leh Noah te’n a pa uh unau tapate a kitenpih uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Joseph tapa Manasseh tapate a kitenpih ua, a gam uh a pa uh nam ah a om gige hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiaite Toupa’n Mosi zang a Jeriko zawn Jordan gal a Moab phaizang a Israel suante a piak, thupiakte leh vaihawmdante ahi uhi.
  </para>
</usx>
