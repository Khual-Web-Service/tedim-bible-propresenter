<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="HEB" style="id">Hebrute</book>
  <para style="h">Hebrute</para>
  <para style="toc1">Hebrute</para>
  <para style="toc2">Hebrute</para>
  <para style="mt">Hebrute</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian, nidanglai a pi leh pute kiang a seh tampi leh lam chiteng a zawlneite zang a thu na gen pa’n,
  </para>
  <para style="p">
    <verse number="2" style="v" />Tu hun nanung ah eite kiang ah a Tapa in thu a hon genta hi. Huai mi bangkim gouluahpa ding in a siam a, huai mi mah in khovel a siam hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah ah a thupina vak leh a tak batpih leh, amah thilhihtheihna a bangkim tungdingpa hi in, i khelhnate sianna a bawlkhit nung in tunglam a thupipen taklam ah a va tuta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Angelte sang a min ngaihzaw a muh bang in amau sang a thupizaw a na hi him hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Angelte lak ah kua kiang ah hiai thute a gen ngei a? “Nang zaw ka Tapa na hi a, tuni in k’on neikhia” chih leh “Amah ding in Pa ka hidia, amah kei ding in Tapa ahi ding”
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan a ta neihsun khovel a a pilut lai in, “Pathian angelte tengteng in leng amah chibai buk uhen,” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan angelte tungtang thu ah, Aman zaw a angelte huih in a suaksak a, a nasemte leng meikuang in a suaksak chi in a gen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Tapa tungthu ah bel: “Pathian aw, na mangtutphah tangtawn in a om ding hi; dikna kumpi chiang leng na gam kumpi chiang ahi chi in a gen hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Diktatna na it a, tatlekna na hua a; huaiziak in Pathian, na Pathian in na lawmte sang in nang kipahna thau a hon nak nilh hi.”
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan nang, “Toupa, a tung in leilung kingakna na phumkhin a, Van leng na khutsuak ahi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaite a hong mangthang ding ua, nang bel om tawntung ding na hi; huaite tengteng puansilh bang in a honglui ding ua,
  </para>
  <para style="p">
    <verse number="12" style="v" />Puan bang in na zial ding a, puansilh banglel in a hong lamdang ta dia; nang bel a ngeingei na hiden a, na kumte leng a mang kei ding hi,” chi in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh Angelte tungthu ah hiai a a gen ngei hia? “Na melmate na khepek ngakna a ka bawl masiah ka taklam ah tu in chih”
  </para>
  <para style="p">
    <verse number="14" style="v" />Angelte tengteng nasepna khate, hotdamna gouluah dingte adia nasem ding a sawlkhiak ahi kei ua hia?
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaiziak in bil a i zakte phatuamngai tak in i khawksa nawn sem ding uhi, huchilou in zaw i tolhmangsak kha zenzen ding uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Angelte zang a thugen nangawn a kip a, tatlekna leh thumanlouhna chiteng in thukna diktathuaitak a muhzel ngal un,
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchitel a hotdamna thupi ngeingaih keileng bangchi’n ahia i suahtak theih mahmah ding? Huai hotdamna thu a tung a Toupa zang a genkhit ahi a, a zate’n hon na hih kipsak uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian in leng chiamtehnate leh thillamdangte leh thilhihtheihna chiteng toh, amah deih bangzel a Kha Siangthou thilhawmte toh, amaute a theihpih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khovel hongom ding a tanchin i gen uh, angelte nuai ah a koih kei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh mi kuahiam in koilai hiam ah hiai thu gen in a theisak hi; “Mihing bang a tel a, na theihgige? Mihing tapa leng bang ahia, na vehnak?”
  </para>
  <para style="p">
    <verse number="7" style="v" />“Amah angelte sang a nuai in na bawl a; thupina leh pahtawina na khusak a, na khutsuak tung ah heutu in na bawl hi;”
  </para>
  <para style="p">
    <verse number="8" style="v" />A khe nuai ah bangkim na koih a, chi in. Huchi in bangkim a nuai a a koih ziak in a nuai a koihlouh bangmah a neikei hi. Himahleh tun ah zaw bangkim a nuai a om in i mu nai tadih kei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh Jesu angelte sang a niamzaw deuh a a bawl takdih tuh, sihna thuak in thupina leh pahtawina khuksak a om in i mu zaw ahi, Pathian hehpihna ziak in sihna michih a chiamsak ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah a ding leh amah ziak a bangkim omsakpa’n tapa tampi thupina a pilut a, a thuakna ziak a amaute hotdamna makaipa bukim hih amah a dia kilawm him ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hihsiangthoupa leh hihsiangthoute avek un mi khat a pawt ahi uhi. Huaiziak in aman amaute unaute, chih a zum kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Ka unaute kiang ah na min ka gen dia; omkhawmte lak ah lasa in k’on phat ding” chi in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan, “Amah ah ka ginna ka nga dia, a chi nawn hi. Huan en dih ua kei leh Pathian honpiak tate” a chi nawn lai hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in naupangte sa leh sisan tangte a hihchiat ziak un, amah ngei in huai bangmah a tangsam hi; a sihna a sihna thuneipa, Diabol, a hih manthat theihna ding leh,
  </para>
  <para style="p">
    <verse number="15" style="v" />Sih kihtak ziak a damsung sikha a omte tengteng a suahtaksak theihna ding in.
  </para>
  <para style="p">
    <verse number="16" style="v" />A awlmoh a, a panpih zelte angelte ahi kei ua, Abraham suante ahizaw uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in mite ading a khelhna thuphatawina bawlsak ding in, Pathian lam ah siampu lianpen, mi lainatthei leh muanhuaitak a hihtheihna ding in, bangkim a unaute bang a hongom amah adin a kiphamoh him ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah ngei in khemna tuak a a na thuaktak ziak in khemna tuakte a panpih thei ahi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in unau siangthou, van sapna tangsamte aw, i thugin toh kisai a Sawltak leh siampu Lian, Jesu ngaihtuah un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian inkuante tengteng lak ah Mosi a muanhuai mah bang in, amah a seppa lak ah a muanhuai hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Inn sung a papen a inkuante sang a a pahtawi zawk bang un, amah Mosi sang a thupi zawk semna mu dia kilawm a seh ahita hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Inkuan chih in papen kuahiam a neichiat ngal uhi; bangkim papen bel Pathian ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan huai nung a thugenlai dingte theihsakna ding in, Mosi Pathian inkuante tengteng lak a nasempa in zaw a muanhuai ngei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Khrist bel Pathian inkuante tung a Tapa in a muanhuai hi. A tawptan a i hangsanna leh i lametna suanna kiptak a i vomhoih phot leh a inkuante eite i hi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Kha Siangthou gen bang in, “Tuni a a aw na zak chiang un,
  </para>
  <para style="p">
    <verse number="8" style="v" />Gamdai a ze-etna ni a a hel bang un, na lungtang uh khauhsak kei un;
  </para>
  <para style="p">
    <verse number="9" style="v" />Huailai ah na pi leh pute un hon ze-et in a honkhem ua, kum sawmli sung a ka thilhihte a mu uhi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in huai suante tung ah ka lung hita kei a, ‘a lungtang un a ngaihtuah khial gige ua, ka lampite leng a theikei uhi,’ ka chi hi,
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka thangpaihna a ka kichiam bang in ka khawlna ah a lut kei ding uh,” chi in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Unaute aw pilvang un, huchilou in zaw Pathian hing tawpsan ding in na lak uah kuapeuh sung ah ginlouhna lungtang gilou a hongom kha ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Tuni” a chih lai un niteng in ki hanthawn tuah zaw un, huchi a na lak ua mi kuamah khelhna khemhat ziak a hihkhauh a na omlouhna ding un,
  </para>
  <para style="p">
    <verse number="14" style="v" />I ginna kipatna pen a tawptan a kiptak a i vomhoih phot leh, Khrist a tanneite i hita uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Tuni in a aw na zak chiang un a hellai bang un, na lungtang uh khauhsak kei un,” a ki chih lai teng.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahihleh kuate ahi ua theinapi a helte? Aigupta a kipan a Mosi pipawt tengteng hilou uhia?
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuate tung ah ahia, kum sawmli sung a lunghihlouh? Hihkhialte a luang uh gamdai a pukmangte tung ah hilou hia?
  </para>
  <para style="p">
    <verse number="18" style="v" />Thumangloute kiang ah kia loungal kua kiang ah ahia a khawlna a lutlou ding a a kichiam?
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in ginlahna ziak in a lut theita kei uh chih i thei uhi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaiziak in i lau ding uh, huchilou in zaw a khawlna a lutna thuchiam omlai napi, na lak ua kuapeuh chinglou in na omkha zenzen ding uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amau kiang a gen a hihbang in Tanchinhoih i kiang ua gen ahi ngal a; himahleh a thuzak uh amaute’n a phattuampih kei uh, a zate toh ginna a a kizomlouh ziak un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ei gingta khinte huai khawlna ah i lut lellel uhi, Ka thangpaihna a ka kichiam bang in ka khawlna ah a lutkei hial ding uh, a chih bang in; leilung pian tung a kipan nate tuh sepzoh a hikhinta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Koilai mun hiam ah ni sagih ni thu hichibang in a gen hi: Huan “Ni sagih ni’n Pathian in a nasep tengteng a khawlsanta” chi in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan hiai mun ah, “Ka khawlna ah a lut kei ding uh,” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in ni dang a Tanchinhoih za masate thumanlouh ziak in lut kei mahle uh, khenkhatte huai khawlna a a lutna ding ua thuchiam a omlai ziak a lutlai ding a om uhi,
  </para>
  <para style="p">
    <verse number="7" style="v" />Hun sawttak nung in David ah a ma a kigensa bang in bang ni hiam a septuan nawn hi. “Tuni a aw na zak chiang un na lungtang uh khauhsak kei un chi in.”
  </para>
  <para style="p">
    <verse number="8" style="v" />Joshua in amaute na khawlsakta hilehzaw, huai nung in ni tuam dang thu gen a ngai kei ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Pathian mite ading in khawlni a khawlna a omlai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian in amah nasepte a khawlsan bang in, a khawlna a lut khinsa mi’n leng a nasepte a khawlsan samta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in kuamah huai thumanlouhna bang a om a i puk louhna ding un huai khawlna a lut ding in phatuam i ngai ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian thu a hinga, thil ahihthei a, namsau hiam tuah bangchibang sang in a hiam a, hinna leh kha, guhlawi leh guhngek tuamkhen hel khop in a sunthei a, lungtang a ngaihtuah leh tupte a theipah thei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />huaiziak in thilsiam amah mitmuh a langlou himhim a omkei; I tanchin tutna dingpa mitmuh ah bangkim vuaktang leh kihongsa ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichi in van mun a paisuak khinsa siampu lianpen thupitak, Jesu Pathian Tapa, i neih ziak in i thugin i pomkip ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Siampu Lianpen i hatlouh kitheihnate hon theihpih phalou nei i hi kei ua; eimah bang a lam tuamtuama khemna tuaksa, khelh bel khiallou, nei i hi zaw uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in zahngaihna i muh theihna ding leh huh i deih chiang a huhna hehpihna i ngah theihna ding in, hehpihna mangtutphah hangtak in i naih ding uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Siampu Lianpen peuhmah mihingte sik leh tang a khelhnate ziak a thilpiak leh kithoihnate Pathian kiang a lankhawm ding a mihing lak a kipan telkhiak leh mihingte adia Pathian seh ahi uhi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Huaite’n amau ngei leng hatlouhna a tuam a omsam a hih ziak un, bangmah theiloute leh lamhaihte tung ah zahngaihna a neithei uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak tak in mite ading a a latsak bang un, amau ading ngei leng khelhnate ziak in lanlou theilou ahi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan huai pahtawina Aron bang a Pathian sap a hih ngal kei uleh kuamah amau a kipe ngeikei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchibang in Khrist leng siampu Lianpen a bawl ding in amah a kihihthupi kei a, “Nang zaw ka Tapa na hi a, tuni’n, k’on neikhia hi” chi a a kiang a genpa’n a hih thupizawta hi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Mun dang a a gen bang in: “Nang zaw, Melkizedek omdan bang a Tangtawn siampu na hi” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman sa a put laini in, sihna lak a amah hondam theipa kiang ah nakpitak a kikou leh khitui kekawm in thumnate leh ngetnate a lan a, a kihtakdan a siamzel ziak in ngaihkhiak in a om hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ta hilhial himahleh a thilthuakte ah thuman a zil hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in hih bukim a hongom in, a thumangte peuhmah ading in tangtawn a hotdamna bulpi a hong hita hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Melkizedek omdan bang a siampu lianpen in Pathian in a bawlta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai mi tanchin ahihleh gen ding tampi i nei ua, genchet leng a haksa, na bil uh a ngontak ziak in.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hun ngaihtuah in zaw heutu hikhinta hial le uchin kilawm hiven, Pathian thubulte hilh kiphamoh nawn neive ua, an gum hilou nawitui kiphamoh n’ong hita uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Nawitui ne peuhmah in diktatna thu ah theihna a neikei ua, naungek a hih ziak un.
  </para>
  <para style="p">
    <verse number="14" style="v" />An gum piching ading ahi, huaite’n a zat gige ziak un sialehpha theichian ding in a theihtheihnate uh a sin zongsangta uhi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Khrist thubulte gen nawnlou in pichin lam i manoh ding uh; thilhih sisate kisikna, Pathian lam a ginna,
  </para>
  <para style="p">
    <verse number="2" style="v" />baptisma leh khutngak leh misi thohnawnna leh tangtawn vaihawmna lam thuhilhnate suangphum phum nawnlou in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in pha a sakleh huai bang i hih ngei ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khatvei hihvak a omkhin a, van thilpiak chiamta, Kha Siangthou dawngkhin a,
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian thu hoihna leh hun hongom ding a thilhihtheihnate chiamkhin hinapi,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ginna a kihei mangsan ua leh huchibang mite zaw a kisikna ding ua bawlthak theih ahi kei uhi; Pathian Tapa amau ading a kilhlum tuan nawn a selphou a hih ziak un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lou, a tung ua vuahtui ke gige na dawnkhin a, huai khohsak a ompa adia nektheih anteh louhing honsuah pen in Pathian vualzawlna a tang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh loulingnei leh khaulingnei a suahnak inbel a phatuam kei a; hamsiat in a om ding a, a tawpna haltum ahi ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh deihtakte aw, huchibang thu gen mahleng nouzaw huai thil sang a hoihzaw hotdamna toh kizui thilte nei na hih uh ka um uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A min ziak a itna a nna nasep uleh misiangthoute nna na sepsak uh na latsak uh leh tutan a leng nasep lai uh mangngilh ding in Pathian mitak lou ahi kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh a tawptan a lametna theihchetna kim mu ding in na thanop ngeingei bang un thanop suah gige chiat le uchin ka chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in na ki thadahsak kei ding ua, ginna leh kuhkalna ziak a thuchiamte gouluah khin khawngte entonte na hi zaw ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pathian in Abraham kiang a thu a chiam lai in, amah sang a thupizaw lou a a kichiam theihlouh ziak in, amah leh amah kilou in a kichiam hi,
  </para>
  <para style="p">
    <verse number="14" style="v" />Taktak in k’on vualzawl ngeingei ding a, hih leng k’on hihpung ding chi in a kichiamta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in kuhkaltak a a thuakkhiak nung in, thilchiam a muta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihingte zaw a sang ua thupilou zaw in a kichiam ua; a kiselna chiteng uah leng hihkipna ding in kichiam tuh thutawp ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Pathian in a thiltup hihlamdan tuan theihlouh dan nakpi mahmah a theihsak ut in thuchiam gouluah dingte kiang ah kichiamna a palai sak hi;
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian thugen zuauthei vual a hihlouhna ah thil kikhek lamdang theilou nihte ziak in, i ma a lametna koih lenkip ding a bitna ding a amah delhte’n hanthawnna thupitak i neih theihna ding in ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai lametna hinna sikkip in i nei ua, muanhuai leh kiptak ahi, huai lametna puanzak sung ah leng a lutta hi;
  </para>
  <para style="p">
    <verse number="20" style="v" />I ma a na paita Jesu, Mun Siangthou pen ah i makaipa a a luttak man in Melkizedek omdan bang a ei ding in tangtawn a siampu lianpen a na hita hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiai “Melkizedek, Salem kumpipa, Tungnungpen siampu, Abraham kumpipate that hongpai na dawn a vualzawlpa ahi.”
  </para>
  <para style="p">
    <verse number="2" style="v" />Abraham in “Bangkim ah Sawm a khat” a pia hi. A minkhiakna genchian in a masapen in “Diktatna Kumpipa,” a zom nawn in “Salem Kumpipa” a hinawn a; “Lemna Kumpipa” chihna ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah pa neilou in, nu neilou in, khangthu bei, ompatni neilou hintawpni leng nei samlou in, Pathian Tapa bang a siam tangtawn a siampu hi gige ahizaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in suangtu, Abraham in a gallak hoih peuhmah lak a Sawm a khat a piakna pa, huai mipa thupi dan ngaihtuah un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Levi suante lak a siampu nna tang peuhmah in dan bang in mite lak ah Sawm a khat lak ding thu a unaute uh lak ah a mu uhi, huaite Abraham khal a pawt hisam mahle u leng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh a lak ua a suante suikhawmsak samlouh pa’n Abraham lak ah Sawm a khat a la a, thuchiamte kempa a vualzawlta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh sel vuallouh in a neuzaw tuh a lianzaw vualzawl sak in a om hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan hiai ah mihing sizel te’n Sawm a khat a mu ua, huai ah bel, a hing gige pen chi a a thu a theisak in a mu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Levi, Sawm a khat lazelpa nangawn in Abraham khut ah Sawm a khat a peta, chih theih ahi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Melkizedek in a nadawn lai in a pa khal ah a omlai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Levi te’n siampu hihna ziak a bukimna muhtheih na hileh huai nuai ah mite’n danthu a na mu ngal ua, Aron omdan bang hilou a Melkizedek omdan bang a siampu dang hongom bang kiphamoh ding ahia?
  </para>
  <para style="p">
    <verse number="12" style="v" />Siampu hihna a hong kilamdan ziak in dan leng hihlamdan sam a hong kiphamoh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai a thugenpa nam tuammi ahi ngal a, huai nam lak a a kuamah maitam ah a gamtang ngeikei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />I Toupa, Juda nam lak a hongsuak ahi chih a kichian hi: Huai nam thu ah Mosi in siampute lam thu bangmah a genkei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Melkizedek bang a tangtawn siampu dang hongsuahna in nakpitak in i thugen a chiangsak nawnsem hi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah khangthu dan leh Dan thupiak ziak a siampu hilou in, hin tawpneilou leh thil hihtheihna bang zaw in siampu a honghi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Nang zaw, Melkizedek omdan bang a tangtawn siampu na hi” chih theihsak ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hatlouh leh a phattuamlouhna ziak in thupiak om masa paihkhiak ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dan in bangmah a hih bukimlouh ziak in Pathian in lametna hoihzaw hon lalut in huai pansan in amah i naih theita uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan kichiamna tellou a amah siampu a bawl a hi kei hi:
  </para>
  <para style="p">
    <verse number="21" style="v" />Siampu dangte zaw kichiamlou a siampu a bawl ahi ua; Jesu bel, nang zaw tangtawn siampu na hi chi in, Toupa a kichiam hi, ka khelkik kei ding chi a a kiang a genpa khut ah a kichiam hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchitak a thupi in Jesu thukhun hoihzaw hihkippa a hong hita hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan siampu tampi a na omtak ziak bel amaute a sizel ua, kuamah omden theilou a hih ziak uh ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiai mi bel tangtawn a omden a hih ziak in, a siampu hihna khentheih vuallouh a nei zaw hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in amah tawn a Pathian kiang a hongpaite a tawpdong in a hondam thei hi, amaute thumsak a tangtawn a a hin gige ziak in ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchibang siampu lianpen, misiangthou, zulhzau lou, ninbanglou, khialte lak a omtuam, vante sang a tungnung zaw a siam eite a a hong hita hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman siampu lianpen dangte lat bang in, niteng in amah khelh ziak a kithoihna lan masa phot a, huai nung a mite khelhna kithoihna a lat a kiphamoh kei hi; Amah a kilat laitak in setden ding in khatvei a na lankhinta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dan in mihing hatlouhna neite, siampu lianpen ding in a sep a; himahleh tua kichiam thu, dan nung a hongom in, Tapa mahmah tangtawn siampu ding a hihkim khitsa a sep zawta hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in i thugente lak a poimawh pen hiai ahi: Vanmun a Thupipen mangtutphah taklam a vatu Siampu lianpen neite i hi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amah Mun Siangthou leh biakbuk taktak, mihing lam hilou, Toupa lam zaw a nasempa i nei uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Siampu Lianpen peuhmahte thilpiak leh kithoihnate lan ding a seh ahi ua; huchi in hiai siampu lianpen in banghiam bek latding neih a kiphamoh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah leitung a omlai hile zaw, dan bangzel a thilpiakte lan ding omkhinta a hih ziak un, siampu hilou ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amaute’n vanlam thilte etsakna’n a lim nna a sem uhi. Mosi biakbuk lam dia a kisaklai in Pathian hilh a om in, “Mualtung a etton ding k’on etsak bang a biakbuk lam ding in pilvang in” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tun bel thuchiam hoihzaw tung a kinga thukhun hoihzaw adia nasem palai a hih bang in, nasepna hoihzaw a na tangta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thukhun masa dembei na hileh, a nihna hongom kullou ding ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amaute dem in hiai thute a gen hi, “Ngai in, nite a hongtung dek, Toupa’n a chi, huai ni chiang in Israel inkuante leh Judah inkuante kiang ah thukhun thak ka bawl ding:”
  </para>
  <para style="p">
    <verse number="9" style="v" />“A pi leh pute uh Aigupta gam a kipan a pikhe ding a a khut ka let ni a a kiang ua ka khun bang hilou in; ka thukhun ah a om gige kei uhi, huchi in amau ka limsakta kei,” Toupa’n a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Huai ni zoh chiang in Israel inkuante kiang a thu ka khun ding hiaite ahi, Toupa’n a chi: A lungsim uah ka thupiakte ka koih dia, a lungtang uah ka gelh nalai dia, huan amau ading in Pathian ka hidia, kei adin amaute ka mite ahi ding uhi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan michih in Toupa thei in, chi in amah inveng leh amah unau a thuhilhta kei ding uhi; a neupen a kipan in a lianpen tan in avek un a hon theichiat ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tatleknate uah ka zahngai dia, a khelhnate uleng ka theigige nawnta kei ding hi” chi in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thukhun thak chi a a gen ziak in amasa zat nawnlouh ding in a luisakta hi. Huchi in a luita zattaklou mangpah thei ahita hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in thukhun masa in leng Pathian nasepna a zuihding thukhun leh lei a bawl Mun Siangthou leng a nei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Biakbuk a lam ua, pindan tuah masak ah khawnvak koihna mung, dohkan leh tanghou koihna a om hi; huai tuh Mun Siangthou a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Puanzak nihna ban ah biakbuk, Mun Siangthou pen a chih uh a om hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huai sung ah dangkaeng gimlim halna bawm leh thukhun bawm dangkaeng a kiluan a om hi, huai thukhun bawm sung ah Manna omna dangkaeng bel, Aron chiang selthei leh thukhun gelhna suangpek a om hi;
  </para>
  <para style="p">
    <verse number="5" style="v" />A tunglam ah zahngaihna tutphah liah in, thupina Cherubte a om ua; huaite tuin zaw a kim sipsip in i gen theikei ding uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai thilte huchibanga bawl a na hi ua, siampute’n Pathian nasem in, biakbuk tuah masak ah a lutzel uhi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Pindan sungnungpen bel siampu lianpen kia in kumtenga khatvei sisan tawi in a lut hi; amah khelhna ading leh mite khelhna ading in a lanzel hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kha Siangthou in hon theihsak nop bel, ‘biakbuk masa a din laiteng Mun Siangthoua luttheihna lampi a kilang nai tadih kei’ a chihna ahi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Biakbuka thilpiak leh kithoihna kilan zelte’n a bemite sialehpha theihna a siangsak theikei chih tu hun a eite hon etsakna ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huaite nek leh dawn, kisilna dan tuamtuamte, a taktak bawlhoihna hongtun ma a kizang salam thilte ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh Khrist bel thil hoih hongom dingte siampu lianpen ding a hongpai in, khut a lamlouh biakbuk thupizaw leh bukim zaw sung ah a lut hi, huai thilsiamte lak a ahi kei chihna ahi,
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman ei ading a tangtawn tatkhiakna ngahkhin in, kel leh bawngpate sisan hilou, amah sisan mahmah tawi in khatvei a setden ding in Mun Siangthou pen sung ah a lutta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kel leh bawngpate sisan leh, bawngla vu, mi nin tung a theh in bawn sa siangkhopa a hih siangthou leh,
  </para>
  <para style="p">
    <verse number="14" style="v" />Khrist, tangtawn Kha ziak a gensiatbeia Pathian kiang a kilan sisan in, Pathian hing nasem ding in na sialehpha theihna uh thilhih sisa apan nak hihsiangthou natel inchia!
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiaiziakin amah thukhun thak palai a honghi a, sapte’n tangtawn a gouluah ding thuchiam a tan theihna ding un thukhun masa nuai a tatleknate lak a kipan hon tankhe ding in amah hong sita hi chihna ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thusiah omna peuh ah a siahmi sihna leng a om teitei ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi a sih nung un thusiah in thu a nei nak hi, a siahmi a damlai teng bel thu a neikei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in thukhun masa leng sisan lou in a hihkip kei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dan thupiak peuhmah Mosi in mipi tengteng kiang a a phuan nung in, bawngnoute leh kelte sisan tui, samulkhau sandup leh hussopin a la a, laibu leh mipi tengteng a theh hi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai Pathian in na kiang ua a namkip thukhun sisan ahi, chi in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huailou leng biakbuk leh nasepna van tengteng huchi mah bang in sisanin a thehsamta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan dan in sisan a bangkim hihsiangthou a ngiat bang in, sisan suaklou in ngaihdamna himhim a omkei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai thilte van a om batpih laksawnte huaite a hihsiangthou a om ding him uh ahi; van thiltaktakte bel huai sang a kithoihna hoihzawte a hih siangthou a om ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khrist khut a lam Mun Siangthou, a tak batpih ah a lut ngalkei a; tun ah Pathian ma ah i sikua ding ding in van ah a lut zawta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh siampu lianpen kumtenga amah sisan lou, sisan tawikawma Mun Siangthou a lutzel bang in, amah kilan ding a van a lut ahi kei hi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi hikeileh leilung piantung a kipan tam veipi a thuakta ding hi; himahleh tulai huntawp ah amah kithoihna pansan a khelhna hihmang ding in khatvei in setden din amah a honglangta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan mihing ading in khatvei sih seh ahi, huai nung in vaihawmna a om ding hi:
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi mah bang in Khrist leng mitampi khelhnate paipih ding a khatvei latkhit a om in, hotdamna mu ding a amah ngakte kiang ah khelhna panglou in nihveina ah a honglang nawn ding hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dan bel thil hoih hongom ding lim kia ahihziakin, a taktak lohkhiakna neilou in, kumtenga kithoihna ngeingei a latzelte un, a be ding a hongpaite bangchi mah in a bukimsak thei ngeikei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi kei leh lat tawp thamta lou ding uhia? A bemite khatveia hihsiangthou pah hileh khelhna kitheihna a nei nawn kei ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh huai kithoihna ah kumteng in khelhnate theihnawnna a hongom nak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawngpa leh kelte sisan in khelhnate lamang theivual ahi kei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in khovel a a honglut lai in: “Kithoihna leh thillat na deihkei a, kei ding in pumpi n’on bawlsak zaw hi:”
  </para>
  <para style="p">
    <verse number="6" style="v" />“Halmanga pumpiaknate leh khelhna ding a kithoihnate ah kipahna himhim na neikei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaitak in ken “Pathian aw, Ngai in, Laibuziala ka tungthu gelh ahihbangin na deihlam hih di’n ka hongpai” ka chi hi,
  </para>
  <para style="p">
    <verse number="8" style="v" />A tung ah “Kithoihnate, thillatte, haltum pumpiaknate, khelhna ding a kithoihnate danbanga lat ahihziakin na deihkei a, amaute ah kipahna na neisam kei” a chi hi,
  </para>
  <para style="p">
    <verse number="9" style="v" />Huaitak in aman “Ngai in, Pathian aw, na deihlam hih ding in ka hongpai” a chita hi. A nihna a tunding theihna ding in a masapen a lamangta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai deihlam in Jesu Khrist pumpi khatvei thu a latpah ziak in, hihsiangthou in i omta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan siampu tengteng in kawla nisuak sim a nasem in, khelhnate bangchik maha hihmang theilou kithoihna ngeingei lan gige in ading uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah bel tangtawn a ding a khelhnate adia kithoihna khat kia a lat nung in, “Pathian taklam ah a vatu zawta hi.”
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai nungsiah “A melmate a khepek ngakna a siam a hih masiah uh a ngak nilouh hi.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in khatvei thillat in hih siangthousate tangtawn a ding in hih bukimta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan Kha Siangthou in eite a hon theihpih sam a, amasa in hiai bang in a gen hi:
  </para>
  <para style="p">
    <verse number="16" style="v" />“Huai nite khit chiang in a kiang ua ka thukhun ding hiaite ahi, Toupa’n a chi: A lungtang uah ka thupiakte ka koih dia, a lungsim uah ka gelh nalai ding chi a a gen khit in,
  </para>
  <para style="p">
    <verse number="17" style="v" />A khelhnate uh leh a tatleknate uh ka theigige nawn takei ding,” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in khelhna ngaihdam a hihnung in khelhna ading in thillat a om nawnta kei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in unaute aw, Jesu sisan ziak a Mun Siangthou a lutngamna nei in,
  </para>
  <para style="p">
    <verse number="20" style="v" />Lam a hon bawlsak, lam thak leh hing tawn a puanzak sung a luttheihna amah pumpi tawnin i nei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pathian inkuante tung a siampu thupitak i neih ziak in,
  </para>
  <para style="p">
    <verse number="22" style="v" />I lungtang a sialehpha theihna sianglou thehsiansaka om a, i pumpi leng tuichima sil a om in, ginna a theihchetna kim nei in lungtang takmah pu in amah i naih ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />I lamet thugin linglou in i pomkip ding uh, thuchiampa a muanhuai hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan itna leh thil hoih hih a kitokthou ding in i kingaihtuah ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khenkhatte hihdan bang a i kikhopnate uh tawpsanlou in, kihanthawn chiatni; ni hongnai hulhul a na theih un kihanthawn tuah sem un.
  </para>
  <para style="p">
    <verse number="26" style="v" />Thutak theihna kim i tan nung a thil i hihkhelh teitei in zaw, khelhnate adia kithoihna a om taklouh ziak in,
  </para>
  <para style="p">
    <verse number="27" style="v" />Vaihawmna lauhuai mulkimhuaitak, doumite kangmang ding thangpaihna mei maban a nei in i om zawta ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mosi danthu khawksalou mi “Theihpihtu mi nih hiam thum hiam nuai ah” lainat bei in a si zel uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian Tapa sikdena, thukhun sisan amah hih siangthouna pen thil namai a bawl a, hehpihna Kha hihvuimi, huai mi sang a bangchipheta gawtna thupizaw thuaktakin nasep uhiam?
  </para>
  <para style="p">
    <verse number="30" style="v" />“Phulakna himhim keimah lak ding ahi, keiman ka thuk ding chih leh Toupa’n a mite a vaihawmsak ding” chi nawnpa lah i thei ngal uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian hing khut a puk thil mulkimhuaitak ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Himahleh tuma lam a hihvak a na om nung ua thuakna buaina thupitak na thuaklai nite uh thei nawn un;
  </para>
  <para style="p">
    <verse number="33" style="v" />Kongkhat ah zaw muhsit leh haksatna thuak in etnop a bawl in na om ua, kongkhat ah lah huchibanga bawl a omte thuakpihte na honghi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kolbunte na lainat ua, gou hoihzaw leh omden ding noumau in na neih uh kithei in na van hon laksakte uh leng kipaktak in nana thuakzou behlap uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in kipahman piak thupitak ngahna ding na ginna uh paimang kei un.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pathian deihlam na hihnung un thilchiam na muhtheihna ding un kuhkalna na kiphamoh uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Sawtlou nungchiang a hongpai dingpa, hongpai ding ahi, sawt a halta kei ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Tuin ka mi diktat tuh ginna in a hing ding; a nungtolh leh bel ka kha in amah ah kipahna a neikei ding” chih ahi ngal a.
  </para>
  <para style="p">
    <verse number="39" style="v" />Himahleh eite zaw mangthang ding a nungtolh pawl a pang i hi kei ua; hinna humbit ding a ginna nei pawl a pang i hi zaw uhi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ginna tuh thil lamette omngei a theihtelna leh thil muhlouhte theihchetna ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai ah nidanglai upate’n phat a loh uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ginna in khovelte Pathian thu a suktuah ahita chih i thei ua, huchi in thil muhtheihte leng thil langtheite a siam ahi kei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ginna in Abel in Kaina sang in kithoihna hoihzaw Pathian kiang ah a lan a, huaiziak in midik hihna a mu chih Pathian in a thilpiakte a pomna ah a theisak hi; huai ginna ziak mah in aman sih nung nangawn in thu a genlai hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ginna in Enok leng sihna chiamlou ding a lakmang in a om a; Pathian in a lakmang ziak in muhtheih ahita kei a; lakmang a a omma in Pathian pahtak lammi ahi chih theihsakna a mukhinta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh ginna lou in amah pahtak lammi hihvual ahi kei; Pathian kiang a hongpai in, amah a om chih leh a zongmite lohchingsakpa ahi chih gin ding ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ginna in Noah thil muh nailouhte lamthu ah Pathian hilh a om in, Pathian laudan siam in a inkuan hotdamna ding in long a bawl a; huai in khovel siamlouh a tangsakta hi, ginna ziak a diktatna gouluahpa ahita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ginna in Abraham sapa a omlai in a gouluah ding mun a lut ding in paikhiakna ding thu a muta hi; a paina ding lam theilou in a paikheta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ginna in gamchiam ah mi gam a tam bang in a na tam nilouh a, thuchiam kikhat gouluahpih ding Isak leh Jacobte toh puanin ah a om uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khopi suangphum nei, Pathian gel leh lam a ngak nilouh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ginna in Sarah ngei in leng a chiampa muanhuai a sak ziak in, a teknung in chi paitheihna a mu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in pasal khat amah lah misi bang mai, a kipan “Van a aksite bang a tam, tuipiau a piaunel bang a sim zohlouh suangtu” a hongsuakta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai mi tengtengte’n thilchiamte tangkhin hilou in, himahleh huaite gamlapi a galmuh a na kipahpih hizaw in, lei ah zaw khualzin leh mikhual lel ahi uh chih kithei gige in ginna nei in amaute a sita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchibang a thu na gente’n amau gam ding a zong uh chih a hihlang mahmah uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A pawtsan gam uh lunggulh hile uh bel kiknawnna hunlem mu mahmah ding ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh tu’n bel gam hoihzaw huai van a ompen deih ahi ua; huchi in Pathian a Pathian uh chih a om a zumkei a; amau ding in khopi khat a bawlsak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ginna in Abraham tuh ze-et a om in, Isak a lan a; huan thuchiamte kipaktak a sangpan a tapa neihsun a lan hi,
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai lah “Isak ah na suante a ki minloh ding” a chih pen ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian in misi lak a kipan nangawn kaithou thei in a sep a; huchi in gentehna dan a gen in amah misi lak a kipan mu nawn ahi ngei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ginna in Isak in thil hongtung dingte thu ah Jakob leh Esau a vualzawl hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ginna in Jakob in, a sih ding kuan in Joseph tate a vualzawl tuaktuaka, “A chiangkhun dawna kingai in Pathian a bia hi.”
  </para>
  <para style="p">
    <verse number="22" style="v" />Ginna in Joseph in, a sih ding kuan in, Israel suante pawt ding thu a gen a; a guhte vui ding tungtang thu a pia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ginna in Mosi a pianlai in, naungek melhoih tak ahi a chih ziak un kha thum sung a nu leh a pa sel in a om a; kumpipa thupiak leng a lau kei uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ginna in Mosi in a hong pichin nung in Pharo tanu tapa a kiloh a utkei a;
  </para>
  <para style="p">
    <verse number="25" style="v" />Sawtlou kal a dia khelhna nopna kipahpih sang in Pathian mite toh sukgentheih thuak a tel zawta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khrist a muhsitna uh Aigupta gam goute sang a hauhsakna thupizaw in a ngai a; kipahman piakding a et zel ziak in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ginna in kumpipa thangpaihna laulou in Aigupta gam a paisan a , muhtheihlouhpa a muh ziak in a thuak teitei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ginna in Paikan Ankuangluina leh sisan thehna a bawl a, ta masa hihmangthangpa’n amaute a khoihlouhna ding in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ginna in gamhul a pai bang in Tuipi San a kan ua; Aiguptate’n tua bang a hih a tumsam ua, valhzawh in a omta uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ginna in Jeriko khaw kulh ni sagih a um nung un a chimta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ginna in Rahab kizuaknu gingloute lak ah a mangthang khawm kei, enkhete im neilou a a pahtak ziak in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan bang ka gen nalai dia? Gideon thute, Barak thute, Samson, Jepthah, leh David thute, Samuel thute, zawlneite thute genni chile hang hun in hon daihlou ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai mite’n ginna in gam a la ua, thudik a vaihawm a zong ua, thuchiamte a tang ua, humpinelkai kamte a chihsak uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mei thilhihtheihna a hihmit ua, namsau hiam nangawn a pel ua, hatlouhna a kipan hattaka bawl in a om ua, kidouna ah mihat minthang a na hi ua, namdang kidou pawlte a taikeksak uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Numeite’n a misite uh thounawn a mu ua; khenkhatte gimthuak sak in a om ua, thohnawnna hoihzaw a tan theihna ding un khahkhiakna a deihkei uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Midangte’n leng nuihza bawlna leh vuak a thuak ua, ahi, huailou leng, kolbut leh hentakna a tuak uhi;
  </para>
  <para style="p">
    <verse number="37" style="v" />Suang a den in a om ua, singatna a attan in a om ua, khemna a tuak ua, namsau a satlup in a om ua; belam vun leh kel vun silh in a vakvai ua; gentheitak a gimthuak a sawi in a om uhi,
  </para>
  <para style="p">
    <verse number="38" style="v" />Khovel amau tenna tak hilou mite, gamdai mun, mualtung, guam leh kolhawm ah a vialvak vak uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ahi a, hiaite tengteng in ginna ziak in phat na lawhkhin mahle uh thilchiam pen a tang kei uhi:
  </para>
  <para style="p">
    <verse number="40" style="v" />A ziakbel Pathian in ei a ding a thil hoihzaw muhkholh a neih ziak a, ei tellou a amaute hihbukim a a omlouhna ding ziak uh ahi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaiziak in huchitel a theihpihte, meipi thupi umsuak a i om thei in, hon hihnok peuhmah leh khelhna eimah a belhte koihmang ni, huan i ma ua kitaitehna ding om ah kuhkaltak in tai ni.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu, i ginna siampa leh hihkippa, a ma a kipahna om ziak a zahlaknate ngaineu a Kros a thuakpa, Pathian mangtutphah taklam a tupa, Amah lam en in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na khalam ua na bah ua, na lungkiak louhna ding un, mikhialte apan a huchibang a selkalhna thuakpa ngaihtuah un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khelhna dou in sisan suak hial in na pang naikei uhi; hanthawnna thu, tate taihilh bang a nou hon taihilhna na mangngilhta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ka ta, Toupa sawina ngaineu kenla, a taihilh a na om in leng lungke sam ken;
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n a itte sawi nak a, ta a kipahpih a vaw nak hi,” chi in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na thuak uzaw noumau ading ahi; tate tung a hihbang in Pathian in na tung uah a hih a; pa sawilouh ta kua a om ngei a?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ta chihna teng lawh a sawina lawhlou a na om un bel, ta tak hilou in, sawn na hi ua kei dia.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huailou leng eite honsawi ding, sa ah pate uh i nei uhi, huaite lah zahtak ngal hang a; huai sang a thupizaw in, i hinna ding in, khate Pa thuthu in i omkei ding ua hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amau zaw ni sawtlou chik, hoih a sak bangzel un a honsawi ua, aman bel a siangthouna i tan theihna ding in, i hoihna ding in a honsawi zaw hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sawina himhim thuaklai in kipahhuai in a langkei a, khasiathuai in a lang hi, thuaknung in huchi a sawizawt a omte ding in gah khamuanhuaitak leh diktatnatak a suahsak zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in khut kaikhete leh khut zawte liktou un;
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan khebai kilawi saklou a, hihdam a a om zawkna ding in, na khete uh ding in lamtang bawl un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mitengteng toh kituahna leh siangthouna delh un, huai siangthouna lou in kuamah in Toupa a mu kei ding uhi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Pilvangtak in en un, huchilou in zaw Pathian hehpihna ngah zoulou kuahiam a om ding a, khatna zung banghiam hongsel a nou hon hihbuai in, huai in mi tampi hihnit in a om ding uhi;
  </para>
  <para style="p">
    <verse number="16" style="v" />kingaihhat hiam, Esau bang a Pathian zahlou mi hiam a hongom kha ding hi. Aman a tamasa hihna an khatvei nek in khawngta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai nung in vualzawlna gouluah a ut in, khitui kekawm in phatuamngaitak in zong mahleh, kisikna hun a muhlouh ziak in paih in a omta chih na thei uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nou zaw tang khoihtheih, mei a kangte, meivomte, mialte, huihpite,
  </para>
  <para style="p">
    <verse number="19" style="v" />pengkul ginnate, thugen ging omnate tung na hi kei ua; huai ging zate’n thudang a kiang ua gen nawnlou ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Gamsa nangawn in huai tang a khoih aleh suang a denlup in a om ding” ahi chih thupiakpen a thuak theikei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A thil muh peuhmah uh a kihtakhuai mahmah ziak in Mosi in, “Ka lau a, ka nak lin mahmah” a chi hial hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh Zion tang, Pathian hing khua, vanlam Jerusalem, sim zohlouh angel hon khawmpite,
  </para>
  <para style="p">
    <verse number="23" style="v" />Tamasa van a min tuang saptuam hon kiang, Pathian, mitengteng ngaihtuah pa kiang bang, midiktat hih hoihkim kha kiang leh,
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu thukhun thak palai kiang, sisan theh, Abel sisan sang a thu hoihzaw genpa kiang tung na hi zaw uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thugenpa na deihkei kha ding uh, pilvang un. Lei amaute taihilh khawlpa a deihlouh ua bawn, gimthuakna a pelhlouh ngal un, eite, van a kipan a hon taihilhpa kiheisante’n i pelkei ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai hun in aw in lei a hihling a; “Himahleh tunzaw, khatvei lei kia hilou in, van leng ka hih ling nawn ding chi in a kichiam zawta hi.”
  </para>
  <para style="p">
    <verse number="27" style="v" />Khatvei ka hihling nawn ding chih in, thil lingloute a omden theihna ding in, thil lingtheite thilsiamte bang phet in, suanmang in a om ding chih theisakna ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in hihlin vuallouh gam i tan ziak in, hehpihna i nei ding ua, huaiziak in zah leh laudansiam kawm in, Pathian pahtaklam na i sem thei ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian zaw mi katmang hat mei ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Unau ki-itna om zel hen.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mikhualte tung ah itna suah ding mangngilh kei un; huchibang hih in khenkhat in theiloupi’n angelte a zintun uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hen a omte hen hisam bang in theigige unla; gimthuakte sa a om samna hihziak un theigige un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi tengteng lak ah kitenna pahtawi in om henla, lupna leng hihbuah louh in om hen; kingaite leh angkawmte tung a Pathian in vaihawm ding ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na lungsim putdan uh dangka deihtakna panglou hi hen; na thil neihsun tung uah lungkim un; amahmah in, “Bangchik mah in k’on donlou kei ding a, paileng k’on paisan kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in hangsantak in, “Toupa hon panpihpa ahi, ka lau kei ding; mihing in bang a honchih thei dia?” i chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nou hon heu, Pathian thu honhilhte, theigige unla, a omdan ua thilsuakte ngaihtuah in a omdan uh ching un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu Khrist tuh zan, tuni, leh tangtawn in a ngeingei in a om gige hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kisinsakna tuamtuam leh thugin lamdangte mutleng in omkei un; lungtang hehpihna a hihkip a om a hoih ngal a, nekdingte bang a hihkip a omlou in; huchibang lam lungkhamte’n huaite ah phattuamna a mu tuankei uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Eite’n maitam khat, biakbuk nasemte’n a nek theihlouhna mun i nei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gan sisan, siampu lianpen in Mun Siangthou a khelhna adia lan a a lutpih zel luangte dainawl ah a hal uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in Jesu in leng amah sisan mahmah a mite a hih siangthouna ding in kulh kongkhak pawlam ah a na thuakta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in amah a muhsitna uh pu in dainawl ah a kiang lam ah i paikhe ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiailai ah zaw khomun kip i nei ngalkei ua, kho hongom ding i zong uh ahizaw hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in amah vang in phatna kithoihna Pathian kiang ah i lan gige ding uh, a min gupna mukte gah a hih ziak in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh thil hihhoih leh thilphal mangngilh kei un; huaibang kithoihna tung ah Pathian a lungkim mahmah hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Nou hon heutute thu mang unla, a thuthu un om un, a nasepte uh tanchin gennawn ding a, na khate uh ching a honveng ahi uhi, lungkham kawm hilou in, kipaktak in semsak un; huchilou in zaw nou ading a khawk ahizaw ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hon thumsak un; bangkim a diktattak a om a, sialehpha theihna siangtak nei ka hi uh chih diktak in ka kithei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan kintak a na kiang ua sawlnawn a ka om theihna ding in, huai ding in k’on ngen nawn sem hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuin, lemna Pathian, tangtawn thukhun sisan ziak a misi lak a kipan a, i Toupa Jesu, Belamchingpa thupitak, kaithou nawn pa’n,
  </para>
  <para style="p">
    <verse number="21" style="v" />A mitmuh a a kipahlam peuhmah Jesu Khrist ziak in eimah a sem in, a deihlam hih ding in thil hoih chiteng lam ah nou hon hihkim hen: Jesu Khrist kiang ah thupina tangtawn in om hen. Amen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh unaute aw, k’on ngen hi, hanthawn thuhilhna ngaithei teitei un; na kiang uah thu tomchik ka gelh uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />I unaupa Timothi a pawtsakta uh chih na thei un; a hong paima deuh in, amah toh nou k’on mu ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nou hon heute tengteng leh misiangthoute tengteng chibai hon buksak un. Italy gam a mite’n chibai a honbuk uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na vek ua kiang ah hehpihna om hen, Amen.
  </para>
</usx>
