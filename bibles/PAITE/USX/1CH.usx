<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="1CH" style="id">1 Kronikil</book>
  <para style="h">1 Kronikil</para>
  <para style="toc1">1 Kronikil</para>
  <para style="toc2">1 Kronikil</para>
  <para style="mt">1 Kronikil</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Adam, Seth, Enosh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Kenan, Mahalaleel, Jared;
  </para>
  <para style="p">
    <verse number="3" style="v" />Enok, Methusel, Lamek;
  </para>
  <para style="p">
    <verse number="4" style="v" />Noah, Shem, Ham, leh Japheth;
  </para>
  <para style="p">
    <verse number="5" style="v" />Japheth tapate: Gomer, Magog, Madai, Javan, Tubal, Meshek, leh Tiras.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gomer tapate: Asikenaz, Riphath, Togarmah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Javan tapate: Elisah, Tarsish, Kittim, Rodanim.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ham tapate: Kush, Mizraim, Put, Kanaan.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kus tapate: Sheba, Havilah, Sabta, Raamah leh Sabteka. Raamah tapate: Sheba, Dedan.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kush in Nimrod a suang; lei ah mi hat a honghi pan hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mizraim in Ludim, Anamim, Lahabim, Naphtuhim,
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathrusim, Kasluhim, Philistiate hong kipatna, leh Kaptorim a suang.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kanaan in Zidon a ta masapen leh Heth a suang a;
  </para>
  <para style="p">
    <verse number="14" style="v" />Jebus mi, Amor mi, Girgas mi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiv mi, Arki mi, Sin mi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Arvad mi, Zemar mi leh Hamath mi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Shem tapate; Elam, Assur, Arpaksad, Lud, Aram, Uz, Hul, Gether, Meshek.
  </para>
  <para style="p">
    <verse number="18" style="v" />Arpaksad in Selah a suang a, huan Selah in Eber a suang hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Eber lak ah tapa nih a piang ua: khatpen min Peleg ahi; a damlai in lah lei a kikhen ngal a. A unaupa min Joktan ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Joktan in Almodad, Seleph, Hazarmaveth, Jerah;
  </para>
  <para style="p">
    <verse number="21" style="v" />Hadoram, Uzal, Diklah;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ebal, Abimael, Sheba;
  </para>
  <para style="p">
    <verse number="23" style="v" />Ophir, Havilah, Jobab a suang hi. Hiaite tengteng Joktan tapate ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Shem, Arpaksad, Selah;
  </para>
  <para style="p">
    <verse number="25" style="v" />Eber, Peleg, Reu;
  </para>
  <para style="p">
    <verse number="26" style="v" />Serug, Nahor, Terah;
  </para>
  <para style="p">
    <verse number="27" style="v" />Abram, huai mah Abraham ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham tapate; Isak, Ishmael.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiaite a khang uh ahi: Ishmael tamasapen Nebajoth. Huchi in Kedar leh Adbeel, Mibsam,
  </para>
  <para style="p">
    <verse number="30" style="v" />Misma, Dumah, Massa; Hadad, Tema,
  </para>
  <para style="p">
    <verse number="31" style="v" />Jetur, Naphish, Kedemah. Hiaite Ishmael tapate ahi uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Keturah, Abraham mei, tapate: Zimran, Joksan, Medan, Midian, Ishbak, Suah a nei hi. Joksan tapate; Sheba, Dedan.
  </para>
  <para style="p">
    <verse number="33" style="v" />Midian tapate; Ephah, Epher, Honok, Abida, Eldah. Hiaite tengteng Keturah tapate ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Abraham in Isak a suang. Isak tapate; Esau, Israel.
  </para>
  <para style="p">
    <verse number="35" style="v" />Esau tapate; Eliphaz, Reuel, Jeush, Jaalam, Korah.
  </para>
  <para style="p">
    <verse number="36" style="v" />Eliphaz tapate; Teman, Omar, Zephi, Gatam, Kenaz, Timna, Amalek.
  </para>
  <para style="p">
    <verse number="37" style="v" />Reuel tapate; Nahath, Zerah, Sammah, Mizzah ahi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Seir tapate: Lotan, Sobal, Zibeon, Anah, Dison, Ezar leh Disan.
  </para>
  <para style="p">
    <verse number="39" style="v" />Lotan tapate; Hori leh Homam: Timna, Lotan sanggamnu ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Sobal tapate; Alian, Manahath leh Ebal, Sephi leh Onam. Huan Zibeon tapate; Aiah leh Anah.
  </para>
  <para style="p">
    <verse number="41" style="v" />Anah tapate; Dison. Dison tapate; Hamran, Esban, Ithran leh Keran.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ezer tapate; Bilhan, Zaavan leh Jaakan. Disan tapate; Uz leh Aran ahi uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huchi in hiaite Israel suante tung a vaihawm kumpipate himhim a om ma ua, Edom gam a vaihawm kumpipate ahi uhi: Beor tapa Bela; a khopi min Dinhabah ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Bela a si a, huchi in Bozrah a Zerah tapa Jobab in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Jobab a si a, Teman mite gam a Husam in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Husam a si a, Bedad, Moab gam a Midian mi that, Bedad tapa Hadad in a sik in vai a hawm a; a khopi min Avith ahi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Hadad a si a, huchi in Masrekah mi Samlah in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Samlah a si a, huchi in lui kiang a Rehoboth a Saul in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Saul a si a, huchi in Akbor tapa Baal hanan in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Baal hanan a si a, a sik in Hadad in vai a hawm a; a khopi min Pai ahi: huan a zi min Mehetabel, Matred tanu, Mezahab tanu ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hadad leng a si hi. Edom hausate; hausa Timnah, hausa Aliah, hausa Jetheth;
  </para>
  <para style="p">
    <verse number="52" style="v" />Hausa Aholibamah, hausa Elah, hausa Pinon;
  </para>
  <para style="p">
    <verse number="53" style="v" />Hausa Kenaz, hausa Teman, hausa Mibzar;
  </para>
  <para style="p">
    <verse number="54" style="v" />Hausa Magdiel, hausa Iram. Hiaite Edom hausate ahi uhi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiaite Israel tapate ahi uh: Reuben, Simeon, Levi, Judah, Issakar leh Zebulun;
  </para>
  <para style="p">
    <verse number="2" style="v" />Dan, Joseph, Benjamin, Naphtali, Gad leh Asher.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah tapate; Er, Onan, leh Selah: huaite Shuah tanu Kanaan nu a kipan a amah lak a piang thumte ahi uh. Huan Er, Judah ta masapen, Toupa mitmuh in a gilou a; amah a that hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Tamar a tapa zi in Perez leh Zerah a suansak a. Judah tapate tengteng nga ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Perez tapate; Hezron leh Hamul.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Zerah tapate; Zimri, Ethan, Heman, Kalkol leh Dara: avek un nga.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan Karmi tapate: Akar, thil siangthou a talekpa, Israel hihbuaipa.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Ethan tapate; Azariah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hezron, amah lak a piangte leng; Jerahmeel, Ram, leh Kelubai.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Ram in Amminadab a suang; Amminadab in Nahson, Judah suante lal, a suang hi,
  </para>
  <para style="p">
    <verse number="11" style="v" />Nahson in Salma a suang a, Salma in Boaz a suang;
  </para>
  <para style="p">
    <verse number="12" style="v" />Boaz in Obed a suang a, Obed in Jesse
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesse in a ta masapen Eliab, a nihna Abinadab leh a thumna Sima a suang a;
  </para>
  <para style="p">
    <verse number="14" style="v" />A lina Nethaneel, a ngana Raddai;
  </para>
  <para style="p">
    <verse number="15" style="v" />A gukna Ozem, a sagihna David:
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan a sanggamnute uh Zeruiah leh Abigail ahi uh. Huchi in Zeruiah tapate; Abisai, Joab leh Asahel, thum.
  </para>
  <para style="p">
    <verse number="17" style="v" />Abigail in Amasa a suang a: huchi in Amasa pa Ishmael mi Jether ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Jezron tapa Kaleb in Azubah a zi, leh Jerioth lak ah tate a suang a: hiaite a tapate ahi; Jeser leh, Sobab leh Ardon.
  </para>
  <para style="p">
    <verse number="19" style="v" />Azubah a si a, Kaleb in amah ading in Ephrath a pi a, huai in Hur a neihsak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hur in Uri a suang a, Uri in Bezaleel a suang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huai nung in Jezron Gilead pa Makir tanu kiang ah a lut a; huai zi dia a pi lai in kum sawmguk a upa ahi; aman Segub a suansak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Segub in, Gilead gam a khopi sawmnih leh thum nei Jair, a suansak hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman amau a kipan Geshur, Aramin leh Jair khuate a la a, Kenath leh, huai a khoneite, khopi sawmguk toh. Hiaite tengteng Gilead pa Makir tapate a ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai nung in Kaleb ephrathah ah Hezron a sia, huchi in Abi’a Hezron zi in Tekoa pa Asur a suansak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan Hezron ta masapen Jerahmeel tapate a ta masapen Ram, Bunah, Oren, Ozem leh Ahijah ahi uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jerahmeel in zi dang a nei a, a min Atarah ahi; amah Onam nu ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerahmeel ta masapen Ram tapate Maaz, Jamin leh Eker ahi uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Onam tapate Sammai leh Jada ahi uh: Sammai tapate; Nadab leh Abisur ahi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abisur zi min Abihail ahi; aman Ahban leh Molid a suansak hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nadab tapate; Seled leh Appaim ahi ua, Seled bel tate neilou in a si hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Appaim tapate; Ishi. Ishi tapate; Sesan. Sesan tapate; Ahlai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Jada Sammai unaupa tapate; Jether leh Jonathan: Jether ta neilou in a si hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan Jonathan tapate: Peleth, Zaza. Hiaite Jerahmeel tapate ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in Sesan in, tanute chihlouh, tapate a neikei hi. Huan Sesan in Aigupta mi khat sikha a nei a, a min Jarha ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Sesan in a tanu a sikha Jerha kiang ah zi din a pia a; huchi in Attai a neihsak hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan Attai in Nathan a suang a, Nathan in Zabad a suang hi;
  </para>
  <para style="p">
    <verse number="37" style="v" />Zabad in Ephlal a suang a; Ephlal in Obed a suang;
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed in Jehu a suang a, Jehu in Azariah a suang;
  </para>
  <para style="p">
    <verse number="39" style="v" />Azariah in Helez a suang a, Helez in Eleasah a suang hi;
  </para>
  <para style="p">
    <verse number="40" style="v" />Eleasah in Sisamai a suang a, Sisamai in Sallum a suang;
  </para>
  <para style="p">
    <verse number="41" style="v" />Sallum in Jekamiah a suang a, Jekamiah in Elisama a suang hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huchi in Jerahmeel unaupa Kaleb tapate Mesa a ta masapen, Ziph pa ahi a; huan Hebron pa Maresah tapate.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan Hebron tapate; Korah, Tappuah, Rekem, Shema ahi uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Shema in Raham, Jorkoam pa a suang a; Rekem in Sammai a suang hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan Sammai tapa Maon ahi; Maon Bethzur pa ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Ephah, Kaleb mei in, Haran, Moza leh Gazez a suang a: Haran in Gazez a suang hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jahdai tapate; Regem, Jotham, Gesan, Pelet, Ephah, Saap.
  </para>
  <para style="p">
    <verse number="48" style="v" />Maakah, Kaleb mei in, Seber leh Tirhanah a nei a.
  </para>
  <para style="p">
    <verse number="49" style="v" />Madmannah pa Saap, Makbenah pa leh Gibea pa Sheva a nei a; Kaleb tanu Aksah ahi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hiaite Kaleb tapate ahi uh; Ephrathah ta masapen Hur tapa, Kiriath-jearim pa Sobal;
  </para>
  <para style="p">
    <verse number="51" style="v" />Salma Bethlehem pa, Harep Bethgader pa.
  </para>
  <para style="p">
    <verse number="52" style="v" />Kiriath-jearim pa Sobal in tapate a nei a; Haroeh leh Menaheth kimkhatte ahi ua,
  </para>
  <para style="p">
    <verse number="53" style="v" />Kiriath-jearim inkawte; Ithrites mite, Puthit mite, Sumathit mite, Misrai mite; Zareathit mite leh Estaolit mite hong kipatna ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Salma tapate; Bethlehem, Netophath mite, Ataroth Joab inkuante, Zorit mite, Manahathit mite kimkhatte ahi uh.
  </para>
  <para style="p">
    <verse number="55" style="v" />Huan Jabez a teng laigelhmite inkawte; Tirathit mite, Simeathit mite, Sukathit mite. Hiaite Ken mi Rekab inkawte pa, Hemath a kipan hongpaite ahi uhi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiaite Hebron a piang David tapate ahi uh: Ta masa, Amnon, Jezreel numei Ahinoam lak a; nihna, Daniel, Karmel numei Abigail lak a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Thumna, Absalom Geshur kumpipa Talmai tanu Maakah tapa; Lina, Adonijah Haggith tapa;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngana, Abital a Sephatiah; Gukna, A zi Eklah lak a Ithream.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hebron ah a tapa gukte a piang ua; huai ah kum sagih leh kha guk vai a hawm hi: Jerusalem ah kum sawmthum leh kum thum vai a hawm hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiaite Jerusalem a piang lite ahi: Simeah, Sobab, Nathan, Solomon, Ammiel tanu Bathshua lak ah kua:
  </para>
  <para style="p">
    <verse number="6" style="v" />Ibhar, Elisama, Eliphelet;
  </para>
  <para style="p">
    <verse number="7" style="v" />Nogah, Nepheg, Japhia;
  </para>
  <para style="p">
    <verse number="8" style="v" />Elisama, Eliada, Eliphelet.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiaite tengteng, meite tapate chihlouh in, David tapate ahi uh; huan Tamar bel a sanggamnu uh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Solomon tapa Rehoboam ahi. Abi’a a tapa, Asa a tapa, Jehosaphat a tapa;
  </para>
  <para style="p">
    <verse number="11" style="v" />Joram a tapa, Ahaziah a tapa, Joash a tapa;
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaziah a tapa, Azariah a tapa, Jotham a tapa;
  </para>
  <para style="p">
    <verse number="13" style="v" />Ahaz a tapa, Hezekiah a tapa, Manasseh a tapa;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ammon a tapa, Josiah a tapa.
  </para>
  <para style="p">
    <verse number="15" style="v" />Josiah tapate; tamasa Johanan, nihna Jehoiakim, thumna Zedekiah, lina Sallum.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jehoiakim tapate: Jekoniah a tapa, Zedekiah a tapa.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan salmatpa Jehoiachin suante: Salathiel a tapa,
  </para>
  <para style="p">
    <verse number="18" style="v" />Malkiram, Pedaiah, Senazzar, Jekamiah, Hoshama, Nedabiah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pedaiah tapate; Zerubbabel leh Shimei: Zerubbabel tapate; Mesullam, Hananiah; Selomith a sanggamnu uh ahi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Hasubah, Ohel, Berekiah, Hasadiah, Jusa hesed, nga.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Hananiah tapate; Pelatiah, Jesaiah: Rephaiah tapate, Arnan tapate, Obadiah tapate, Sekaniah tapate.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sekaniah tapate, Semaiah: huan Semaiah tapate; Hattus, Igeal, Bariah, Neariah, Saphat, guk.
  </para>
  <para style="p">
    <verse number="23" style="v" />Neariah tapate; Elioenai, Hizkiah, Azrikam, thum.
  </para>
  <para style="p">
    <verse number="24" style="v" />Elioenai tapate; Hodaiah, Eliasib, Pelaiah, Akkub, Johanan, Dalaiah, Anani, sagih.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah tapate: Perez, Hezron, Karmi, Hur leh Sobal.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sobal tapa Reaiah in Jahath a suang a; Jahath in Ahumai leh Lahad a suang. Hiaite mite Zorathit inkawte ahi uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan hiaite Etam pa tapate ahi uh: Jezreel, Ishma, Idbash: huan a sanggamnu uh min Hazelelponi ahi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Gedor pa Penuel, Husah pa Ezer. Hiaite, Ephrathah ta masa, Bethlehem pa, Hur tapate ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tekoa pa Asur in zi nih, Helah leh Naarah a nei.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naarah in Ahuzzam, Hepher, Temeni, Haahashtari a neihsak a. Hiaite Naarah tapate ahi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Helah tapate Zereth, Izhar, Ethnan ahi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Koz in Anub, Zobebah, Harum tapa Aharhel inkawte a suang hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Jabez bel a unaute sang in a zahtakhuai zaw a: a nun a min Jabez a sa a, lungkhamna toh amah ka neih ziak in, chi in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jabez in Israel Pathian a sam a, Aw hon vualzawl mahmah in, ka gam liansak in, na khut ka kiang ah om in, hoihlou a kipan in kei honkem in, hon lungkham saklouhna ding in chi in. Huchi in Pathian in a nget a phalta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Kelub, Suah sanggampa’n, Eston pa, Mehir a suang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Eston in Bethrapha, Paseah, Irnahas pa Tehinnah a suang hi. Hiaite Rekah mite ahi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Kenaz tapate: Othniel, Seraiah; huan Othniel tapate: Hathat.
  </para>
  <para style="p">
    <verse number="14" style="v" />Meonothai in Ophrah a suang: Seraiah in Geharasim pa Joab a suang; khutsiammite chih in a om uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jephunneh tapa Kaleb tapate; Iru, Elah, leh Naam: Elah tapa: Kenaz.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jahallel tapate; Ziph leh Ziphah, Tiria leh Asarel.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ezra tapate; Jether, Mered, Epher, Jalon: huan Miriam leh Sammai, Estemoa pa Ishbah a nei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A zi Jehudijah a numei in Jered Gedor pa, Heber Soko pa, Jekuthiel Zanoah pa a suang hi. Huchi in hiaite Mered in a pi, Pharo tanu Bithia tapate ahi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan Naham sanggamnu, Hodiah zi tapate, Gar mi Keilah pa, Maakah mi Estemoa pa ahi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Simon tapate; Amnon, Rinnah, Benhanan, Tilon. Ishi tapate; Zoheth, Ben Zoheth ahi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Judah tapa Selah tapate; Lekah pa Er, leh Meresah pa Laadah leh puanmalngat hoih bawlte inkuante, Asbea inkawte;
  </para>
  <para style="p">
    <verse number="22" style="v" />Jokim, Kozeba mite, Joash, Saraph, Moab a vaihawmna nei, Jasubilehem. Huchi in chiamtehna laite a lui mahmah hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiaite belvelmite leh, Netaim leh Gedera a tengte ahi uh: huai ah a nasepna ziak in kumpipa kiang ah a teng uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simeon tapate: Nemuel, Jamin, Jarib, Zerah, Saul,
  </para>
  <para style="p">
    <verse number="25" style="v" />A tapa Sallum, a tapa Mibsam, a tapa Misma.
  </para>
  <para style="p">
    <verse number="26" style="v" />Misma tapate; a tapa Hammuel, a tapa, Zakkur, a tapa Shimei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Shimei in tapa sawmlehguk leh tanu guk a nei a, himahleh a unaute’n tate tampi a neikei ua, Judah tate bang in, a inkawte tengteng uh leng a pungkei uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Beer–sheba ah, Moladah ah, leh Hazar-shual ah a teng ua;
  </para>
  <para style="p">
    <verse number="29" style="v" />Bilhah ah, Ezem ah, Tolad ah;
  </para>
  <para style="p">
    <verse number="30" style="v" />Bethuel ah, Hormah ah, Ziklag ah;
  </para>
  <para style="p">
    <verse number="31" style="v" />Beth-markaboth ah, Hazarsusim ah leh Bethbirei ah, Saaraim ah. Hiai David vaihawm tanpha in a khopite uh ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Etam leh Ain, Rimmon, Token, Ashan, a khotate uh ahi, khopi ngate:
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai kim a khotate tengteng Baal pha in ahi. Hiaite a tenna uh ahi a, khangthusuina a nei uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mesobab, Jamel leh Amaziah tapa Josah;
  </para>
  <para style="p">
    <verse number="35" style="v" />Joel leh Josibiah tapa Jehu, Seraiah tapa, Asiel tapa;
  </para>
  <para style="p">
    <verse number="36" style="v" />Elioenai, Jaakobah; Jesohaiah, Asaiah, Adiel, Jesimiel leh Benaiah;
  </para>
  <para style="p">
    <verse number="37" style="v" />Siphi tapa Ziza, Allon tapa, Jedaiah tapa, Simri tapa, Semaiah tapa;
  </para>
  <para style="p">
    <verse number="38" style="v" />Hiai minlohte a inkaw sung ua vaihawmte ahi uh: huan a pipute uh inkawte a khang mahmah uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A ganhon uh adia loupanek zong ding in, guam suahlam pang tanpha in, Gedor lutna chiang pha in a pai uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Loupa nek hoihna leh tamna a mu ua, gam za leh dai lah galmuang; tuma a huai a omte lah Ham a kipan ahi uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hiai mingelhte Judah kumpipa Hezekiah damlai in a hongpai ua, a puaninte uh leh huai a om Meun in a sual ua, tunitan in, amaute a hihse vek ua, a mun uah a teng uhi; huailai a a gante uh adia louhing a om ziak in.
  </para>
  <para style="p">
    <verse number="42" style="v" />A lak ua khenkhatte, Simeon tapate, mi za nga, a heutute uh Ishi tapate Pelatiah, Neariah, Rephaiah, leh Uzziel makaih in Seir mual ah a hoh uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A suakta Amalek mite lak a omlaite a sual ua, tunitan in, huai ah a tengta uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Israel ta masapen Reuben tapate, amah piang masapen ahi; himahleh a pa lupna a hihbuah ziak in, a upa hihna Israel tapa Joseph tapate kiang a piak ahi; huchi in upatna dungzui in khangthu a kisim kei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A unaute tung ah Judah a vualzou a, amah a kipan in vaihawmtu a hongom a; himahleh upatna Joseph a ahi:
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel ta masapen Reuben tapate; Hanok, Pallu, Hezron, Karmi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Joel tapate: Semaiah a tapa, Gog a tapa, Shimei a tapa,
  </para>
  <para style="p">
    <verse number="5" style="v" />Mikah a tapa, Reaiah a tapa, Baal a tapa;
  </para>
  <para style="p">
    <verse number="6" style="v" />Beer a tapa, Assuria kumpipa Tilgath pilneser in a pimang; Reuben mite vaihawmtu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a khangthute uh khangthusutna a kisim lai a a inkuan kuan ua a unaute; hausapa, Jeiel, Zekariah,
  </para>
  <para style="p">
    <verse number="8" style="v" />Bela Azaz tapa, Shema Joel tapa, Aroer teng, Nebo leh Baal meon pha a teng:
  </para>
  <para style="p">
    <verse number="9" style="v" />Suahlam ah luipi Euphrates a kipan gamdai lutna pha in a tengta hi: Gilead gam a a gante uh a pun ziak in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Saul damlai in Hagri mite toh a kidou ua, huaite a zou a: Gilead suahlam gam tengteng ah a puaninte uah a teng uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Gad tapate amau zawntak ah, Salkah tan in Bashan gam ah a teng uh:
  </para>
  <para style="p">
    <verse number="12" style="v" />Joel hausapa leh, a zom Sapham, leh Janai, leh Saphat Bashan ah:
  </para>
  <para style="p">
    <verse number="13" style="v" />A pipute uh inkawte a unaute uh: Mikael leh, Mesullam leh, Sheba leh, Jorai leh, Jakan, leh Zia, leh Eber, sagih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiaite Huri tapa Abihail tapate ahi uh, Jaro tapa, Gilead tapa, Mikael tapa, Jesisai tapa, Jahdo tapa, Buz tapa;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahi Abdiel tapa, Guni tapa, a pipute uh inkawte hausapa.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bashan a Gilead ah, a khopite, Saron huapkhakte tengteng, a gamgi tanpha un, a teng uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiaite tengteng Judah Kumpipa Jotham damlai leh Israel kumpipa Jeroboam damlai in a khangthute in sim in a omvek uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Reuben tapate leh, Gad mite leh Manasseh nam kimkhat mihangsante, namsau leh lum thuahthei mite, leh thalpeu a kap ding, kidou siam, galkap dia kuanthei, singli, sangli, za sagih leh sawmguk ahi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hagarit mite, Jetur toh, Naphish toh, Nodab toh a kidou uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amaute dou ding in panpih in a om ua, huchi in Hagarit mite a khut ua piak in a om ua, a kiang ua om tengteng toh; amau lah Pathian kiang ah kidouna ah a kap ngal ua, Pathian in a ngetna uh a za a; amah a muanna uh a koih ziak un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in a gante uh a lamang ua; a sangawngsau uh sing nga, belam nuai nih leh sing nga, sabiltung za nih, mite nuai khat.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kidouna Pathian a a hih ziak in, mi tampi petmah a puk uhi. Huchi in saltanna tanpha in a mun uah a tengta uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan Manasseh nam kimkhatte tate gamsung ah a teng ua: Bashan a kipan Baal hermon leh Senir leh Hermon mual tan in a pung uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiaite Epher, Ishi, Eliel, Azriel, Jeremiah, Hodaviah, Jahdiel, mi hat hangsante, mi minthangte, a pipute uh inkawte lupente ahi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in a pipute uh Pathian dou in a talek ua, a ma ua Pathian in a hihsiat, gam a mite pathiante lak ah ang a kawm uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Israel Pathian in Assuria kumpipa Pul kha leh, Assuria kumpipa Tilgath pilneser kha a tokthou a, huchi in amaute a pimang a, Reuben mite leh, Gad mite leh, Manasseh nam kimkhatte mahmah, tunitan in Halah, leh Habor, leh Hara, ah amaute a pia, Gozan lui pha in.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Levi Tapate: Gershom, Kohath, Merari.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Kohath tapate: Amaram, Izhar, Hebron, Uzziel.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amram tate: Aron, Mosi, Miriam. Aron tapate: Nadab leh Abihu, Eleazar leh Ithamar.
  </para>
  <para style="p">
    <verse number="4" style="v" />Eleazar in Phinehas a suang a, Phinehas in Abisua a suang a;
  </para>
  <para style="p">
    <verse number="5" style="v" />Abisua in Bukki a suang a, Bukki in Uzzi a suang a;
  </para>
  <para style="p">
    <verse number="6" style="v" />Uzzi in Zerahiah a suang a, Zerahiaih in Meraioth a suang a;
  </para>
  <para style="p">
    <verse number="7" style="v" />Meraioth in Amariah a suang a, Amariah in Ahitub a suang a;
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahitub in Zadok a suang a, Zadok in Ahimaaz a suang a;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahimaaz in Azariah a suang a, Azariah in Johanan a suang a;
  </para>
  <para style="p">
    <verse number="10" style="v" />Johanan in Azariah a suang a, amah Jerusalem a Solomon inn lamlai siampu nasep sempa ahi:
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Azariah in Amariah a suang a, Amariah in Ahitub a suang a;
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahitub in Zadok a suang a, Zadok in Sallum a suang a;
  </para>
  <para style="p">
    <verse number="13" style="v" />Sallum in Hilkiah a suang a, Hilkiah in Azariah a suang a;
  </para>
  <para style="p">
    <verse number="14" style="v" />Azariah in Seraiah a suang a, Seraiah in Jahozadak a suang a;
  </para>
  <para style="p">
    <verse number="15" style="v" />Jahozadak saltanna lam ah a pai hi, Toupa’n Nebukadnezzar khut a Judah leh Jerusalem a pimang lai in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Levi tapate: Gershom, Kahath, leh Merari.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiaite Gershomtapate minte ahi uh: Libni leh Shimei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kohath tapate Amram, Ezhar, Hebron, Uzziel ahi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Merari tapate: Mahli leh Musi. Hiaite a pipute uh inkawte dungzui in Levite inkuante ahi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gershom a kipan: Libni a tapa, Jahath a tapa, Zimmah a tapa;
  </para>
  <para style="p">
    <verse number="21" style="v" />Joah a tapa, Iddo a tapa, Zerah a tapa, Jeatherai a tapa.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kohath tapate: Amminadab a tapa, Korah a tapa, Assir a tapa;
  </para>
  <para style="p">
    <verse number="23" style="v" />Elkanah a tapa, Ebiasaph a tapa, Assir a tapa;
  </para>
  <para style="p">
    <verse number="24" style="v" />Tahath a tapa, Uriel a tapa, Uzziah a tapa, Shaul a tapa.
  </para>
  <para style="p">
    <verse number="25" style="v" />Elkanah tapate: Amasai leh Ahimoth,
  </para>
  <para style="p">
    <verse number="26" style="v" />Elkanah ahihleh: Elkanah tapate; Zophai a tapa, Nahath a tapa;
  </para>
  <para style="p">
    <verse number="27" style="v" />Eliab a tapa, Jeroham a tapa, Elkanah a tapa.
  </para>
  <para style="p">
    <verse number="28" style="v" />Samuel tapate: ta masapen Joel, a zom Abiah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Merari tapate: Mahli, Libni a tapa, Shimei a tapa, Uzza a tapa;
  </para>
  <para style="p">
    <verse number="30" style="v" />Simeah a tapa, Haggiah a tapa, Asaiah a tapa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan hiaite David in thukhun bawm a khawl nung a, Toupa inn sung a la a nasepna tung a heutu a a koihte ahi uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jerusalem a Solomon in Toupa inn a lam khit masiah, kihoupihna puanin biakbuk ma ah lasa in na a sem uhi: A thupiak bangzel un a nasepna uh a hih uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiaite a tapate toh nasemte ahi uhi. Kohath mite tapate ahihleh: Heman lasami, Joel tapa, Samuel tapa;
  </para>
  <para style="p">
    <verse number="34" style="v" />Elkanah tapa, Jeroham tapa, Eliel tapa, Toah tapa;
  </para>
  <para style="p">
    <verse number="35" style="v" />Zuph tapa, Elkanah tapa, Mahath tapa, Amasai tapa;
  </para>
  <para style="p">
    <verse number="36" style="v" />Elkanah tapa, Joel tapa, Azariah tapa, Zephaniah tapa;
  </para>
  <para style="p">
    <verse number="37" style="v" />Tahath tapa, Assir tapa, Eliasaph tapa, Korah tapa;
  </para>
  <para style="p">
    <verse number="38" style="v" />Ezhar tapa, Kohath tapa, Levi tapa, Israel tapa.
  </para>
  <para style="p">
    <verse number="39" style="v" />A unaupa Asaph, a taklam pang a dingpa, Asaph Berekiah tapa mahmah, Simeah tapa;
  </para>
  <para style="p">
    <verse number="40" style="v" />Mikael tapa, Baaseih tapa, Malkiah tapa;
  </para>
  <para style="p">
    <verse number="41" style="v" />Ethni tapa, Zerah tapa, Adaiah tapa;
  </para>
  <para style="p">
    <verse number="42" style="v" />Ethan tapa, Zimmah tapa, Shimei tapa,
  </para>
  <para style="p">
    <verse number="43" style="v" />Jahath tapa, Gershomtapa, Levi tapa,
  </para>
  <para style="p">
    <verse number="44" style="v" />A khut veilam ah a unaute uh Merari tapate: Etham Kisi tapa, Abdi Malluk tapa;
  </para>
  <para style="p">
    <verse number="45" style="v" />Hasabiah tapa, Amaziah tapa, Hilkiah tapa;
  </para>
  <para style="p">
    <verse number="46" style="v" />Amzi tapa, Bani tapa, Samer tapa;
  </para>
  <para style="p">
    <verse number="47" style="v" />Mahli tapa, Musi tapa, Merari tapa, Levi tapa.
  </para>
  <para style="p">
    <verse number="48" style="v" />A unaute uh Levi mite Pathian inn biakbuka nasepna tengteng a ding a a seh ahi uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Himahleh Aron leh a tapate’n haltum maitam tung ah, gimlim maitam tung ah, Mun Siangthou pen a nasepna tengteng ading in a lan ua, Pathian sikha Mosi thupiak tengteng bang in, Israel ading a tatna bawl ding in.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan hiaite Aron tapate ahi uh; Eleazar tapa, Phinehas a tapa, Abisua a tapa;
  </para>
  <para style="p">
    <verse number="51" style="v" />Bukki a tapa, Uzzi a tapa, Zerahiah a tapa;
  </para>
  <para style="p">
    <verse number="52" style="v" />Meraioth a tapa, Amariah a tapa, Ahitub a tapa:
  </para>
  <para style="p">
    <verse number="53" style="v" />Zadok a tapa, Ahimaaz a tapa ahi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huchi in hiaite a gamgite ua a puanin kaihnate uh dungzui a a tenna uh ahi: Aron tapate kiang ah, Kohath mite inkawte a, amau mun dia aisan a piak masakpen ahi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Amau kiang ah Judah gam ah Hebron leh, a kim a vela a huapkhakte a pia uhi;
  </para>
  <para style="p">
    <verse number="56" style="v" />Himahleh huai a khopi munte leh khotate, Jephunne tapa Kaleb kiang ah a pia uhi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Aron tapate kiang ah kihumbitna khopite a pia uh, Hebron; Libna leng a huapkhakte toh, Jattir, Estemoa a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="58" style="v" />Hilen a huapkhakte toh, Debir a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="59" style="v" />Ashan a huapkhakte toh, Beth-shemesh a huapkhakte toh:
  </para>
  <para style="p">
    <verse number="60" style="v" />Huan Benjamin nam a kipan; Geba a huapkhakte toh, Allemeth a huapkhakte toh, Anathoth a huapkhakte toh. A inkuante tengteng a a khopite tengteng uh khopi sawmlehthum ahi hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Kohath tapa omlaite kiang ah, huai nam inkuan a kipan, nam kim khat, Manasseh nam kimkhat a kipan khopi sawm aisan a piak ahi uhi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Huan Gershomtapate ahihleh, a inkuante uh dungzui in, Issakar nam a kipan, Asher nam a kipan, Naphtali nam a kipan, Bashan a Manasseh nam a kipan, khopi sawmlehthum.
  </para>
  <para style="p">
    <verse number="63" style="v" />Merari tapate kiang ah aisan a piak ahi, a inkawte uh dungzui in, Reuben nam a kipan, Gad nam a kipan, Zebulun nam a kipan, khopi sawmlehnihte.
  </para>
  <para style="p">
    <verse number="64" style="v" />Israel tate’n Levi mite kiang ah khopite a huapkhakte uh toh a pia uhi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Judah tate nam a kipan, Simeon tapa nam a kipan, Benjamin tate nam a kipan, hiai khopi minlohte, aisan in a pia uhi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Kohath tapa inkawte lak a khenkhatte’n Ephraim nam a kipan amau gamgi khopite a nei uhi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Amau kiang ah bitna khopite a pia uh, Ephraim singtang gam a Sekem a huapkhakte toh; Gezer leng a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="68" style="v" />Jokmeam a huapkhakte toh, Bethhoron a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="69" style="v" />Aijalon a huapkhakte toh, Gath-rimmon a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="70" style="v" />Manasseh nam kimkhat a kipan; Aner a huapkhakte toh; Bileam a huapkhakte toh, Kohath tapate inkaw lak a omlaite din.
  </para>
  <para style="p">
    <verse number="71" style="v" />Gershom tapa kiang ah, Manasseh nam kimkhat inkuan a kipan a piak ahi, Bashan a Golan a huapkhakte toh, Astaroth a huapkhakte toh:
  </para>
  <para style="p">
    <verse number="72" style="v" />Issakar nam a kipan in: Kedesh a huapkhakte toh, Daberath a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="73" style="v" />Ramoth, a huapkhakte toh, Anem a huapkhakte toh:
  </para>
  <para style="p">
    <verse number="74" style="v" />Asher nam a kipan in: Masal a huapkhakte toh, Abdon a huapkhakte toh;
  </para>
  <para style="p">
    <verse number="75" style="v" />Hukok a huapkhakte toh, Rehob a huapkhakte toh:
  </para>
  <para style="p">
    <verse number="76" style="v" />Naphtali nam a kipan in: Galili a Kedesh a huapkhakte toh, Hammon a huapkhakte toh, Kiriathaim a huapkhakte toh.
  </para>
  <para style="p">
    <verse number="77" style="v" />Levi mite omlaite kiang ah, Merari tapate, Zebulun nam a kipan a piak ahi, Rimmon a huapkhakte toh, Tabor a huapkhakte toh:
  </para>
  <para style="p">
    <verse number="78" style="v" />Jeriko a Jordan khen, suahlam pang, Reuben nam a kipan, amaute piak ahi, gamdai a Bezer a huapkhakte toh, Jahzah a huapkhakte toh,
  </para>
  <para style="p">
    <verse number="79" style="v" />Kedemoth a huapkhakte toh, Mephaath a huapkhakte toh:
  </para>
  <para style="p">
    <verse number="80" style="v" />Gad nam a kipan in: Gilead a Ramoth a huapkhakte toh, Mahanaim a huapkhakte toh,
  </para>
  <para style="p">
    <verse number="81" style="v" />Heshbon a huapkhakte toh, Jazer a huapkhakte toh.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Issakar tapate: Tola, Puah, Jasub, Simron, li.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tola tapate: Uzzi, Rephaiah, Jeriel, Jahmai, Ibsam, Semuel, a pipute uh inkawte lupente, huaibel, Tola a kipante; a khangte ua mi hat hangsante: David damlai a zah uh sing nih leh sang nih leh za guk ahi uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan Uzzi tapate: Izrahiah: huan Izrahiah tapate; Mikael, Obadiah, Joel, Ishiah, nga: avek un mipipente ahi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amau toh, a pipute uh inkawte dan in, a khangte un, kidouna ding a sepaih pawlte ahi uh, sing thum leh sang guk; zi leh tapa tampi a nei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan Issakar inkawte tengteng lak a, mi hat hangsante, a unaute uh avek ua khangthusutna a sut in, sing giat leh sang sagih ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Benjamin tapate: Bela, Beker, Jediael, thum.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bela tapate: Ezbon, Uzzi, Uzziel, Jerimoth, Iri, nga; pipute inkawte lupente, mi hat hangsante; huan khangthusutna a sim in sing nih leh sang nih leh sawmthum leh li ahi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Beker, tapate: Zemira, Joas, Elizer, Elioenai, Omri, Jeremoth, Abijah, Anathoth, Alameth. Hiaite tengteng Beker tapate ahi uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in khangthu sutna a sim ahi ua, a khangte uh dungzui in, a pipute uh inkawte lupente, mi hat hangsante, sing nih leh za nih ahi uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Jediael tapate: Bilhan: Bilhan tapate; Jeush, Benjamin, Ehud, Kenaan, Zethan, Tarsis, Ahisahar.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiaite tengteng Jediael tapate ahi uh, a pipute uh inkawte lupente dungzui in, mi hat hangsan, kidouna adia sepaih pawl a kuankhe thei dingte, sing khat leh sang sagih leh za nih ahi uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Suppim leng Huppim, Ir tapate, Husim, Aher tapate.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naphtali tapate: Jahziel, Guni, Jezer, Sallum, Bilhah tapate.
  </para>
  <para style="p">
    <verse number="14" style="v" />Manasseh tapate: Asriel, a zi in a suan: a mei Aram numei in Gilead pa Makir a suang hi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Makir in Huppim leh Shuppim sanggamnu a min Maakah zi in pi a; a nihna min Zelophehad ahi: Zelophehad in tanute a nei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Maakah, Makir zi in tapa a nei a, a min in Peres a sa a; a unaupa min Seres ahi; a tapate Ulam leh Rakem ahi uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ulam tapate; Bedan. Hiaite Gilead tapate ahi uh Makir tapa, Manasseh tapa.
  </para>
  <para style="p">
    <verse number="18" style="v" />A sanggamnu Hammoleket in Ishod, Abiezer, Mahalah a nei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Semidah tapate Ahian, Sekem, Likhi, Aniam ahi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan Ephraim tapate: Suthelah, Bered a tapa, Tahath a tapa, Elead a tapa, Tahath a tapa,
  </para>
  <para style="p">
    <verse number="21" style="v" />Zabad a tapa, Suthelah a tapa, Ezer, leh Elead, a gante uh lamang ding a a hongpai suk gamsung a om Gath mite’n a thatta uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />A pa uh Ephraim in ni tampi a sun a, huchi in a unaute amah lungmuan ding in a hong uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in a zi kiang ah a hoh a, nau a pai a, tapa a nei a, a inn sung a tuahsiat ziak in a min ding in Beriah a sata hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A tanu Serah ahi a, Bethhoron nuainung leh tungnung leh Uzzen serah lam nu ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Rephah a tapa ahi, Reseph leng; Reseph tapa Telah, Tahan a tapa;
  </para>
  <para style="p">
    <verse number="26" style="v" />Ladan a tapa, Ammihud a tapa, Elisama a tapa;
  </para>
  <para style="p">
    <verse number="27" style="v" />Nun a tapa, Joshua a tapa.
  </para>
  <para style="p">
    <verse number="28" style="v" />A neihte uleh a tennate uh Bethel leh huai a khuate ahi, suahlam ah Naaran, tumlam ah Gezer, huai khopite toh, huai Azzah leh khopite tan in:
  </para>
  <para style="p">
    <verse number="29" style="v" />Manasseh tate gamgi chin ah, Beth shean leh, a khopite, Taanak leh a khopite, Meggiddo leh a khopite, Dor leh a khopite, hiaite ah Israel tapa Joseph tate a teng uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Asher tapate: Imnah, Isuah, Ishuai, Beriah, Serah a sanggamnu uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Beriah tapate: Heber, Malkiel, Birzaith pa.
  </para>
  <para style="p">
    <verse number="32" style="v" />Heber in Japhlet, Somer, Hotham, Sua a sanggamnu a suang.
  </para>
  <para style="p">
    <verse number="33" style="v" />Japhlet tapate: Pasak, Bimhal, Asavath. Hiaite Japhlet tate ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Samer tapate: Ahi, Rohgah, Jehubbah leh Aram.
  </para>
  <para style="p">
    <verse number="35" style="v" />Helem a unaupa tapate; Zophah, Imna, Seles, Amal.
  </para>
  <para style="p">
    <verse number="36" style="v" />Zophah tapate: Suah, Hernephar, Sual, Beri, Imrah;
  </para>
  <para style="p">
    <verse number="37" style="v" />Bezer, Hod, Samma, Silsah, Ithran, Beera.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jether tapate: Jephunneh, Pispa, Ara.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ulla tapate; Ara, Hanniel, Rezia.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hiaite tengteng Asher tate ahi uh, pipute inkawte lupente, mihat, tel, hangsan, kumpi tapate lak a vaihawmte. Kidouna nasepna ding a Khangthusutna a sim in amau zah singnih sangguk ahi uhi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Benjamin in a ta masa Bela, a zom Asbel, a thumna Aharah a suang a;
  </para>
  <para style="p">
    <verse number="2" style="v" />Nohah a lina, Rapha a ngana.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bela in tapate a nei a, Addar, Gera leh Abihud;
  </para>
  <para style="p">
    <verse number="4" style="v" />Abisua, Naaman, Ahoah;
  </para>
  <para style="p">
    <verse number="5" style="v" />Gera, Sephuphan, Huram.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiaite Ehud tapate ahi uh: hiaite Geba a tengte pipute inkawte lupente ahi uh, huchi in amaute Manahath ah sal in a pi uhi:
  </para>
  <para style="p">
    <verse number="7" style="v" />Naaman, Ahiah, Gera, amaute salin a pi a; Uzza leh Ahihud a suang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Saharaim in amaute a sawlmang nung in, Moab mun ah tate a suang a; Husim leh Baar a zite ahi uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A zi Hodes apan, Jobab, Zibia, Messa, Malkam a suang hi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Jeuz, Sakia, Mirma. Hiaite pipute inkawte lupente, a tapate ahi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Husim lak ah Abitub leh Elpaal a suang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Elpaal tapate: Eber, Misam, Samed, Ono lamkhetu leh Lod, huai khopite toh lampa:
  </para>
  <para style="p">
    <verse number="13" style="v" />Beriah, Shema, Aijalon, Gath a tengteng delhzakte tengtengte pipute inkawte lupente ahi uh;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ahio, Saksak, Jeremoth;
  </para>
  <para style="p">
    <verse number="15" style="v" />Zebadiah, Arad, Edar,
  </para>
  <para style="p">
    <verse number="16" style="v" />Mikael, Ispah, Joha Beriah tapate;
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebadiah, Mesullam, Hezeki, Heber;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ismerai, Jezliah, Jobab, Elpaal tapate,
  </para>
  <para style="p">
    <verse number="19" style="v" />Jakim, Zikri, Zabdi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Elienai, Zilthai, Eliel;
  </para>
  <para style="p">
    <verse number="21" style="v" />Adaiah, Beraiah, Simrath, Simhi tapate;
  </para>
  <para style="p">
    <verse number="22" style="v" />Ispan, Heber, Eliel;
  </para>
  <para style="p">
    <verse number="23" style="v" />Abdon, Zikri, Hanan;
  </para>
  <para style="p">
    <verse number="24" style="v" />Hananiah, Elam, Anthothijah;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ipdeiah, Penuel, Sasak tapate;
  </para>
  <para style="p">
    <verse number="26" style="v" />Samserai, Sehariah, Athaliah;
  </para>
  <para style="p">
    <verse number="27" style="v" />Jaaresiah, Eliah, Zikri, Jeroham tapate.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiaite a khangte ua pipute inkawte lupente ahi uh, mi pipente: hiaite Jerusalem ah a teng uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Gibeon ah Gibeon pa a teng a, a zi min Maakah ahi:
  </para>
  <para style="p">
    <verse number="30" style="v" />A tapa masapen Abdon, Zur, Kis, Baal, Nadab;
  </para>
  <para style="p">
    <verse number="31" style="v" />Gedor, Ahio, Zaker.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mikloth in Simeah a suang hi. A naute uh toh Jerusalem ah, a unaute uh zawn ah a tenglai uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ner in Kis a suang a; Kis in Saul a suang; Saul in Jonathan, Malkisua, Abinadab leh Eshbaal a suang.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jonathan tapa Merib baal ahi a; Merib baal in Mikah a suang hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mikah tapate; Pithon, Melek, Tarea, Ahaz.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ahaz in Jehoaddah a suang a; Jehoaddah in Alemeth, Azmaveth leh Zimri a suang a; Zimri in Moza a suang;
  </para>
  <para style="p">
    <verse number="37" style="v" />Moza in Binea a suang a; Rapha a tapa, Eleasa a tapa, Azel a tapa:
  </para>
  <para style="p">
    <verse number="38" style="v" />Azel in tapa guk a nei a, a min uh hiaite ahi; Azrikam, Bokeru, Ishmael, Seariah, Obadiah leh Hanan. Hiaite tengteng Azel tapate ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Unaupa Esek tapate; Ulam a ta masa, Jehush a zom, Eliphelet a thumna.
  </para>
  <para style="p">
    <verse number="40" style="v" />Ulam tapate mi hat hangsan, thalkapmite ahi uh, tapate, tapate, tapate tampi, za khat leh sawmnga a nei uhi. Hiaite tengteng Benjamin tapate ahi uh.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Israel tengteng khangthu a sim in a om ua; huan, ngai in, Israel leh Judah kumpipate laibu ah gelh in a om uhi: a tatlekna ziak un Babulon lam ah sal a pimang in a om uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amau tante a khopite ua teng masapente bel, Israel, siampute, Levi mite leh Nethinim mite ahi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem ah Judah tate, Benjamin tate, Ephraim leh Manasseh tate a teng uhi;
  </para>
  <para style="p">
    <verse number="4" style="v" />Uthai Ammihud tapa, Omri tapa, Imri tapa, Bani tapa, Perez tate ah Judah tapa.
  </para>
  <para style="p">
    <verse number="5" style="v" />Silon mite; Asaiah piang masapen leh a tapate.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zerah tapate ah; Jeuel, a unaute, za guk leh sawmkua.
  </para>
  <para style="p">
    <verse number="7" style="v" />Benjamin tapate ah; Sallu Mesullam tapa, Hodaviah tapa, Hasenuah tapa;
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Ibneiah Jeroham tapa, Elah Uzzi tapa, Mikri tapa, Sallum Sephatiah tapa, Reuel tapa, Ibnijah tapa;
  </para>
  <para style="p">
    <verse number="9" style="v" />A unaute uh, a khangte uh dungzui in, za kua leh sawmnga leh guk. Hiai mite tengteng a pipute uh inkawte a pipute inkawte lupente ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan siampute ah: Jedaiah, Jehoiarib; Jachin;
  </para>
  <para style="p">
    <verse number="11" style="v" />Azariah Hilkiah tapa, Mesullam tapa, Ahitub tapa, Pathian inn a vaihawmpa;
  </para>
  <para style="p">
    <verse number="12" style="v" />Adaiah Jeroham tapa, Pashur tapa, Malkijah tapa, Maasiai Adiel tapa, Jahzerah tapa, Mesullam tapa, Mesillemit tapa, Immer tapa;
  </para>
  <para style="p">
    <verse number="13" style="v" />A unaute uh, a pipute uh lupente, sang khat leh za sagih leh sawmguk; Pathian inn a nasepna thilhihna ding a mi hithei mahmahte.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Levi mite ah: Hashub tapa Semaiah, Azrikam tapa, Hasabiah tapa, Merari tapate ah;
  </para>
  <para style="p">
    <verse number="15" style="v" />Bakbakkar, Heres, Galal, Mattaniah Mikah tapa, Zikri tapa, Asaph tapa;
  </para>
  <para style="p">
    <verse number="16" style="v" />Obadiah Semaiah tapa, Galal tapa, Jeduthun tapa, Berekiah Asa tapa, Elkanah tapa, Netophath mite khuate a tengte.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan kongkhak ngakmite; Sallum, Akkub, Talmon, Ahiman, a unaute uh: Sallum bel a pipen ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kumpipa kongpi suahlam pang ngak sek: Levi tate puanin adia kongkhak ngakmite ahi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sallum Kore tapa, Ebiasaph tapa, Korah tapa, a unaute, a pa inkawte a, Korah mite, nasepna thilhihna a heutu ahi ua, biakbuk kongpite ngakmite: a pipute uh Toupa puanin tung a heutu, biakbuk lutna ngakmite ahi uhi;
  </para>
  <para style="p">
    <verse number="20" style="v" />Phinehas Eleazar tapa hun paisa ah amaute tung a vaihawmpa ahi a, a kiang ah Toupa a om hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Zekariah Meselemiah tapa kihoupihna puanin kongkhak ngakpa ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiaite tengteng kongpite kongkhak ngakmite hidia telte za nih leh sawmlehnih ahi uh. Hiaite a khuate ua khangthu a sim ahi ua, a sepding uh bawlsa a David leh zawlnei Samuel in a hihkipsa ahi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in amau leh a tate un Toupa inn kongpite, a dandan in, biakbuk inn nasan in a kem uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A pang lite ah, suahlam, tumlam, mallam, simlam ah kongkhak ngakmite a om uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A unaute uh, a kallak lak in ni sagihnite teng in amau kiang a om ding in a hongpai zel ding uh ahi:
  </para>
  <para style="p">
    <verse number="26" style="v" />Kongkhak ngakpipen lite lah, Levi mite, sepding sehsa a om ahi ua, Pathian insung a dantante leh sumkoihnate tung ah heutu ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huailai a thupiak amau tung a a om ziak in, Pathian inn kimvel ah a giak ua, zingsang teng in huai hon ding amau nasep ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan a lak ua kuate hiam in nasepna tuiumbel suante a kem ua; kikou a laklut in a om ua, kikou a lakkhiak in a om uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A lak ua khenkhatte vante, mun siangthoupen tuium-belsuan, tangbuang nelte, uainte, sathaute begaw leh gimnamtuite kem ding a seh ahi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Siampute tapate lak a a khente gimnamtuite toh hel a bawl uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mattithiah, Levi mite, Korah mi Sallum ta masapen, lak a khat in belliangneite kan thilte tung a nasepna sehsa a nei hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A unaute uh lak a a khen, Kohath mite tapate’n tanghou a kem ua, khawlnite a bawl ding in.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiaite lasamite ahi ua, Levi mite inkawte pipute inkawte lupente, dantante sung ah a teng ua, sun leh zan in a nasepna ua zat in a om ua, nasepna dangte a kipan awl uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />A khang pumpite uah, hiaite Levi mite pipute inkawte lupente ahi uhi, mi pipente: hiaite Jerusalem ah a teng uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Gibeon ah Gibeon pa a teng a, Jehiel, a zi min Maakah:
  </para>
  <para style="p">
    <verse number="36" style="v" />A tapa masapen Abdon, Zur, Kish, Baal, Ner, Nadab;
  </para>
  <para style="p">
    <verse number="37" style="v" />Gedor, Ahio, Zekariah, Mikloth.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan Mikloth in Simeam a suang a, huchi in amau leng a unaute utoh Jerusalem ah, a unaute uh zawn ah a teng uh.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ner in Kish a suang a; Kish in Saul a suang; Saul in Jonathan, Malkisua, Abinadab leh Esbaal.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jonathan tapa bel Merib baal ahi; Merib baal in Mikah a suang hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan Mikah tapate; Pithon, Melek, Tahrea leh Ahaz.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ahaz in Jara a suang a; Jara in Alameth, Azmaveth leh Zimri a suang hi; Zimri in Moza a suang.
  </para>
  <para style="p">
    <verse number="43" style="v" />Moza in Binea a suang; Rephaiah a tapa, Eleasah a tapa, Azel a tapa:
  </para>
  <para style="p">
    <verse number="44" style="v" />Azel in tapa guk a nei a, a min uh hiaite ahi: Azrikam, Bokeru, Ishmael, Seariah, Obadiah leh Hanan: hiaite Azel tapate ahi uh.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Philistia mite’n Israel a dou ua; huchi in Israel mite Philistia mite ma ah a taikek ua, Gilboa mual ah thahgam in a om uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Philistia mite’n Saul leh a tapate a delh vengveng ua; Philistia mite’n Jonathan, Abinadab leh Malkisua, Saul tapate a that uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in kidouna Saul ading in a haksa mahmahta a, thalkapmite’n amah a phata uhi; huan thalkapmite ziak in a lungkham mahmah hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchih lai in Saul in a galvan pawpa kiang ah, “Na namsau dok khia inla, huai in hondawt pailet in; huchilou in zaw hiai zeksumlouhte hongpai in bawllouh louh in a honbawl kha ding uh,” a chi a. Himahleh a galvan pawpa a utkei; a lau mahmah ngal a. Huaiziak in Saul in a namsau a la a, kisiatnan a neita hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A galvan pawpan Saul a sita chih a theih in, huai bangmah in aman leng a namsau kisiatna in a zang a, a sita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Saul a sita a, a tapa thumte; huan a inkawte tengteng leng a sikhawmvek uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Guam a om Israel mite tengteng in Sepaihte taikek leh Saul leh a tapate a si uh chih a muh un a khopite uh a nusia ua, a taikekta uhi; Philistia mite a hong ua huaite ah a tengta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zingsang in hichi ahi, thahsate puante suah ding a Philistia mite a hong pailai un, Gilboa mual ah Saul leh a tapate a puk uh chih a mu uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan amah vante a suah ua, a lutang a la ua, a galvan leng, a milimte uh kiang leh mite kiang ah tanchin puak ding in Philistia mite gamsung ah a khak kimvel vek uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in a galvan a pathiante uh inn ah a koih ua, Dagon biakin ah a lutang a tak uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jabesh-gilead tengteng in Saul tung a Philistia mite thilhih tengteng a zak un,
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi hangsante tengteng a thou ua, Saul luang leh, a tapate luang a vala mang ua, Jabesh ah a honpua ua, Jabesh a tosaw sing nuai ah a guhte uh a vui ua, ni sagih an a ngawl uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in Toupa tung a tatlekna hih a, Toupa thu a zuihlouh a, dawizawl aisansiam thu a dot ziak in Saul a sita hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai a thukan a, Toupa a kipan thu a kanlouh ziak in: huaiziak in amah a that a, lalgam Jesse tapa David kiang ah a peta hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Israel tengteng Hebron ah David kiang ah a hong kikhawm ua, “Ngai in, na guh leh na sa ka hi uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuma lam in, Saul mahmah kumpipa a hihlai in, Israel pikhia a pilut nang na hi a; Toupa na Pathian in na kiang ah, Israel ka mite na vak ding a, ka mite Israel tung ah lal na hi ding hi, honchi” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in Israel Upa tengteng Hebron ah kumpipa kiang ah a hongpai ua; huan David in Hebron ah Toupa ma ah amau toh thukhun a bawlpih a; Samuel khut a Toupa thu bang in, Israel tung a kumpipa ding in David thau a nilh uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />David leh Israel tengteng Jerusalem, huai mah Jebus ahi, ah a hoh ua; huchi in Jebus mite, huai gam a tengte, huai ah a om uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Jebus a tengte’n David kiang ah, “Hiai lam a na honglouh ding ahi” a chi ua. himahleh David in Zion kulh muanhuai a la a; huai mah David khopi ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />David in, “Kuapeuh Jebus mite that masapen pen a lianpen leh heutu ahi ding” a chi a. Huan Zeruiah tapa Joab a kuantou masapen a, huchi in amah a lianpen a bawl in a omta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />David bel kulh muanhuai ah a teng a; huaiziak in David khopi a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in khopi a bawlsuak vek a, Millo kimvel a kipan nasan in: huchi in Joab in khopi dang a bawlpha vek hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />David bel a hongthupi semsem a; sepaihte Toupa a kiang ah a om uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiaite David neih mi hatte lak a a pipente ahi uh, Israel tungtang a Toupa thu bangzel a, amah kumpipa dia bawl ding a, Israel tengteng toh, a gamsung a amah lak a a hatna uh taklangte.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiai David in a neih mi hatte zah ahi: Jasobeam, Hakmon mi tapa, sawmthumte lak a pipen; za thumte dou ding in a teipi a lek a khatvei thu in amaute a that hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah nung in Dodo tapa Eleazar, Ahoh mi, mi hat thumte lak a khat ahi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pasdammim ah David kiang ah a om a, huai ah kidou tum in Philistia mite a kikhawm ua, barli buh a dimna mun ah; Philistia mite ma a kipan in mite a taikekta uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in huai mun laitak ah ading ua, a hum ua, Philistia mite a that uhi; Toupa’n zohna thupitak in amau a hondamta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Heutu lian sawmthumte lak a thum suangpi a David kiang ah, Adullam kawkhuk ah a hohsuk uhi; Philistia mite tampite’n Rephaim phaizang ah puanin a kai uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huailai in David bel kawhawm sung ah a om a, Philistia mite kulhpi bel Bethlehem ah a om hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in David in tui a lunggulh a, “Aw kongpi kiang a om, Bethlehem tuileh tui dawn ding a hongpia mi khat om leh chi nang e!” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai thumte’n Philistia mite tampi lak a phu paisuak ua, kongpi kiang a om, Bethlehem tuileh a kipan tui a vatawi ua, a honla ua, David kiang a hontun uhi: himahleh David in a dawn nuam kei a, Toupa adin a bungkhe zaw hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Hiai ka hih, ka Pathian in honphal kei hen: a hinna uh lauhuaina a koih hiai mite sisan ka dawn ding hia? Amau lah a hinna uh lauthawnna toh in a hontawi uh ahi ngal ua” a chi hi. Huaiziak in a dawn nuamta kei hi. Hiai thilte huai mi hat thumte’n a hih uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Abisai, Joab unaupa, huai thumte lak a khat ahi: aman za thumte dou ding in a teipi a lik a amau a that a, mi thumte lak ah min a neita hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thumte lak ah, nihte sang in, amah a zahtakhuai zaw hi huchi in a heutupa ding ua bawl in a om hi: hitamahleh thum masate zaw a pha kei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Benaiah Jehoiada tapa, Kabzeel a mi hangsan, thilhih thupite hihpa tapa, Moab a Ariel tapate nihte a that a: a paisuk lai a, vuk kiak lai in kawkhuk lak ah humpinelkai a that hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aigupta mi a that a, mi lian mahmah, tong nga a sang; huan Aigupta mi khut a a teipi siamganmi chiam bang ahi; huchi in a kiang ah chiang toh a hohsuk a, Aigupta mi khut a kipan teipi a la a, amah mah teipi in a hihlumta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiai thilte Benaiah Jehoiada tapa in a hih a, huchi in huai mihat thumte lak ah min a nei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ngai in, sawmthumte sang in zahtakhuai zaw in a om a, himahleh thum masate zaw a pha kei hi: huchi in David in a galvil heutu in amah a koih hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sepaih pawlte a mi hatte: Asahel, Joab unaupa, Elhanan Bethlehem a Dodo tapa;
  </para>
  <para style="p">
    <verse number="27" style="v" />Sammoth Haror mi, Helez Pelon mi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Ira Tekoa mi Ikkes tapa, Abiezer Antoth mi;
  </para>
  <para style="p">
    <verse number="29" style="v" />Sibbekai Husat mi, Ilai Ahoh mi;
  </para>
  <para style="p">
    <verse number="30" style="v" />Maharai Netophath mi, Heled Netophath mi Baanah tapa;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ithai Benjamin tate Gibeah a Ribai tapa, Benaiah Pirathon mi;
  </para>
  <para style="p">
    <verse number="32" style="v" />Hurai Gaash luitate a, Abiel Arbath mi;
  </para>
  <para style="p">
    <verse number="33" style="v" />Azmaveth Baharum mi, Eliahba Saalbon mi;
  </para>
  <para style="p">
    <verse number="34" style="v" />Gizon mi Hasem tapate, Jonathan Sage Harar mi tapa;
  </para>
  <para style="p">
    <verse number="35" style="v" />Harar mi Sakar tapa Ahiam, Ur tapa Eliphal;
  </para>
  <para style="p">
    <verse number="36" style="v" />Hepher Mekerath mi, Ahijah Pelon mi;
  </para>
  <para style="p">
    <verse number="37" style="v" />Hezro Karmel mi, Naarai Ezbai tapa;
  </para>
  <para style="p">
    <verse number="38" style="v" />Joel Nahtan unaupa, Mibhar Hageri tapa;
  </para>
  <para style="p">
    <verse number="39" style="v" />Ammon mi Zelek, Beroth mi Naharai, Joab galvan pawmi Zeruiah tapa;
  </para>
  <para style="p">
    <verse number="40" style="v" />Ira Ithri mi, Gareb Ithri mi;
  </para>
  <para style="p">
    <verse number="41" style="v" />Uriah Hit mi, Zabad Ahlai tapa;
  </para>
  <para style="p">
    <verse number="42" style="v" />Adina Reuben mi Siza tapa, Reuben mite lak a pipen leh a kiang a sawmthumte;
  </para>
  <para style="p">
    <verse number="43" style="v" />Hanan Maakah tapa, Josaphat Mithni mi;
  </para>
  <para style="p">
    <verse number="44" style="v" />Uzzia Asterath mi, Shama leh Jehiel Aroer mi Hotham tapate;
  </para>
  <para style="p">
    <verse number="45" style="v" />Jediael Simri tapa, Joha a unaupa, Tiz mi;
  </para>
  <para style="p">
    <verse number="46" style="v" />Eliel Mahavi mi, Jeribai, Josaviah, Elnaam tapate, Ithmah Moab mi;
  </para>
  <para style="p">
    <verse number="47" style="v" />Eliel, Obed, leh Jasiel Mezob mi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in hiaite Kish tapa Saul ziak a a ki hepmang lai a Ziklag a David kiang a hongpaite ahi uh: huchi in kidouna a amah panpihmite mi hatte lak ah a om uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thalte in a kigalvan ua, suangkap leh thalpeu a thalkap ah khut taklam leh veilam a zangthei ua; amaute Saul unau, Benjamin a kipan ahi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pipen Ahiezer ahi, huan Joash, Gibeah mi Semah tapate; Azmaveth tate Jeziel leh Pelet; Berkah, Antoth mi Jehu;
  </para>
  <para style="p">
    <verse number="4" style="v" />Gibeon mi Esmaiah, sawmthumte lak a mi hat, sawmthumte tung ah; Jeremiah, Jahaziel, Johanan leh Geerath mi Jozabad;
  </para>
  <para style="p">
    <verse number="5" style="v" />Eluzai, Jerimoth, Bealiah, Semariah, Sephatiah Haruph mi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Elkanah, Jesiah, Azarel, Joezer, Jasobeam, Korahith mi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Joelah, Zebadiah, Gedor a Jeroham tapate. Gad nam a kipan
  </para>
  <para style="p">
    <verse number="8" style="v" />Gad mite ahihleh gamdai a kulh ah David lam ah a kituamseh ua, mi hangsan, kidouna adia chilsa, lum leh teipi khoih theite; a maitang uh humpinelkaite maitang bang a, mual a sazate bang a kin;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ezer a pipen, Obadiah a zom, Eliab a thumna;
  </para>
  <para style="p">
    <verse number="10" style="v" />Mismannah a lina, Jeremiah a ngana;
  </para>
  <para style="p">
    <verse number="11" style="v" />Attai a gukna, Eliel a sagihna;
  </para>
  <para style="p">
    <verse number="12" style="v" />Johanan a giatna, Elzabad a kuan a;
  </para>
  <para style="p">
    <verse number="13" style="v" />Jeremiah a sawmna, Makbannai a sawmlehkhatna.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hiai Gad tapate lak a te sepaihte heutute ahi uh: a neupen za khat toh a kikim a, a lianpen pen sang khat toh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiaite Jordan lui piaute tui in a tuplai a, kha khatna a kan a paite ahi ua; huchi in phaizang a om tengteng, suahlam leh tumlam tuaktuak, delhzakte ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Benjamin leh Judah tate lak a mi, kulh ah David kiang ah a hong ua.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in amaute tuak ding in David a paikhia a, amaute kiang ah, “Hon panpih dia lemna deih a ka kiang a hong na hih ua leh, nou adin ka lungtang phankhawm ahi ding; himahleh ka khut ah bangmah hiamgamna a omkei chih thei a, ka galte adia kei honman ding a hongpai na hih uleh, ka pipute uh Pathian in huai en henla, sal hen” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huailai in sawmthumte lak a pipenpa, Amasai tung ah kha a hongtung a, “Nang David, Jesse tapa, nang a, nang lam a pang ka hi uh: muanna, na kiang ah om henla, nang hon panpihmite kiang ah muanna: na Pathian in lah nang a hon panpih ngal a,” a chi hi. Huailai in David in amaute a na kipahpih a, pawl heutute ding in a bawlta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Manasseh a kipan in leng khenkhatte, kidouna a Saul dou ding a Philistia mite toh a hongpai in David lam ah a pukmang uhi; himahleh amau amaute a panpih kei uh: Philistia mite toupate’n thuhilh in amah a sawlmang ngal ua, i lupente uh lauthawnghuaina ding in Saul, heutupa lam ah a pukmang ding, chi in.
  </para>
  <para style="p">
    <verse number="20" style="v" />David Ziklag a a hoh in, Manasseh a kipan amah lam ah hong puklut a om ua, Adnah, Jozabad, Jediael, Mikael, Jozabad, Elihu, Zilthai, Manasseh a kipan sangte heutute ahi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan galguk bawlte dou ding in David a panpih uh: amau lah mihat hangsante leh sepaih lak a heutute ahi ngal ua.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sepaih pawl thupi, Pathian sepaih pawl bang a hong hih masiah uh niteng in David kiang ah amah panpih ding in a hong paikhawm uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiaite Toupa thu bang a Saul gam amah adia bawl dia kidou ding a kigalvante huaite lupente Hebron a David kiang a hongpaite ahi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Judah tate lum leh teipi tawi theite sang guk leh za giat, kidou ding a kigalvan.
  </para>
  <para style="p">
    <verse number="25" style="v" />Simeon tate ah kidouna ding a, mihat hangsante, sang sagih leh za khat.
  </para>
  <para style="p">
    <verse number="26" style="v" />Levi tate ah sang li leh za guk.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jehoiada bel Aron inkawte pipa ahi a, amah toh sang thum leh za sagih a om uhi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Tangval hat hangsan, Zadok, leh a pa inkawte heutu sawmnih leh nih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Benjamin tate, Saul unaute, sang thum: amaute lak a thupipen pente’n Saul inkawte lam ah a ginom lailai uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ephraim tate ah sing nih leh za giat, mihat hangsan, a pipute uh inkawte a mi minthangte.
  </para>
  <para style="p">
    <verse number="31" style="v" />Manasseh nam kimkhatte sing khat leh sang giat, hong a, David kumpipa a bawl dia, min a genkhiakte,
  </para>
  <para style="p">
    <verse number="32" style="v" />Issakar tate, hunte theihsiamna nei mite, Israel in bang a hihdia chih thei ding; amaute lupente za nih ahi uh; huan a unaute tengteng uh amau thupiak in a om uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Zebulun a kipan, sepaih pawl kuankhe theite bang, kidouna van chichih toh a, kidouna bawl a thupethei sing nga; kidouna bawl a thupe thei, lungsim thuah nih neilou mite.
  </para>
  <para style="p">
    <verse number="34" style="v" />Naphtali a kipan heutu sang khat, amaute kiang ah lum leh teipi tawi sing thum leh sang sagih.
  </para>
  <para style="p">
    <verse number="35" style="v" />Dan mite kidouna a thupethei, sing nih leh sang giat leh za guk.
  </para>
  <para style="p">
    <verse number="36" style="v" />Asher a kipan, sepaih pawl a kuankhe thei, kidouna a thupe thei, sing li.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jordan lehlam gal ah, Reuben mite leh, Gad mite, leh Manasseh nam kimkhatte a kipan, kidouna ading a kidouna vanzat chichih toh nuai khat leh sing nih.
  </para>
  <para style="p">
    <verse number="38" style="v" />Hiaite tengteng, kidou mi ngen hi in, kidouna thupe thei, lungtang hoihkim toh Hebron ah David Israel tengteng tung a kumpipa dia bawl ding in a hongpai ua: David kumpipa a bawl ding in Israel dang tengteng in lungkhat a pu chiat uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huchi in huai ah David kiang a, ne leh dawn in, ni thum a om uh: a unaute un lah amau ading in kisakna a bawl ngal ua.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huai ban ah Issakar, Zebulun leh Naphtali tanpha a teng amau kiang nai a omte’n, sabiltungte leh sangawngsaute leh sakol neute leh bawngtalte in tanghou a honpua ua, annek ding, theipi gah beute, grep min bomte, uain leh sathau, a tam a tam bawngtalte leh belamte: Israel nopsakna thupi ahi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in David in heutu leh makai chiteng, sangte leh zate heutute toh thu a kikum uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />David in Israel kikhawmte tengteng kiang ah, “Hoih na sak ua, Toupa i Pathian ua kipan ahihleh, mun chiteng a Israel gam tengteng nutsiata om i unaute kiang ah thu i khak ding ua, loupa munte nei a khopite ua a kiang ua siampute leh Levimite om, huchi a i kiang a a hong kikhop khawm theihna ding un:
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in i Pathian uh bawm i lakik nawn ding uhi: Saul hun lai in i na zong kei uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kikhawmpi tengteng in huchibang in i hih ding uh a chi ua: mi tengteng mit ah huai thildik ahi ngal a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in David in Israel tengteng Aigupta gam luita Sihor a kipan Hamath lutna chiangpha in, Kiriath-jearim a kipan a Pathian bawm vala ding in a mite a kaikhawm hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in David, Israel tengteng toh, Baalah huaibel, Kiriath-jearim ah ahi, huaibel Judah gam ahi a, huai a kipan a Pathian, Toupa Cherubte tung a tupa, A minlohna om vala ding in a kuantou hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian bawm kangtalai thak in a pua ua, Abinadab inn a kipan a lakhia ua: huchi in Uzza leh Ahio in a hawl uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in David leh Israel tengteng Pathian ma ah a hatna tengteng un late, kaihgingte, pekging guisawm neite, khuangtate, dakkhutbette leh pengkulte toh lopna bawl in a om uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Chidon buhchilna phual a hongtun un, bawngtalte a kisuih man un, Uzza in bawm len ding in a khut in a sawk hi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Uzza tung ah Toupa hehna a souta a, bawm a a khut a khoih ziak in, amah a hihlumta hi: huchi in Pathian ma ah a sita hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa Uzza tung a a puahkhap ziak in, David a lungkimkei hi: huchi in huailai tunitan in, Perez-uzzah a chita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai ni’n David in Pathian a kihta a, bangchi’n Pathian bawm in ka kitun thei dia? chi in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in aman a kiang a, David khopi sung ah bawm a pawlut kei a, Git mi Obed-edom inn sung ah a pawlut zawta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian bawm bel kha thum Obed-edom inkawte kiang ah inn sung ah a om a: huchi in Toupa’n Obed-edom leh, a neih tengteng a vualzawlta hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Tura kumpipa Hiram in David kiang ah sawltak mite a sawl a, sidar singte, suangsekmite, khutsiammite, inn lamsak ding in.
  </para>
  <para style="p">
    <verse number="2" style="v" />David in Israel tung ah Toupa’n amah kumpipa in a koihkipta chih a thei a, a gam lah, a mi Israelte, sangpi a tawisang in a omta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />David in Jerusalem ah zite tamsem a pi a: huchi in David in tapate leh tanute tamsem a suangta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiaite Jerusalem a a neih tate minte ahi; Sammua, Sobab, Nathan, Solomon;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ibhar, Elisua, Elpalet;
  </para>
  <para style="p">
    <verse number="6" style="v" />Nogah, Nepheg, Japhia;
  </para>
  <para style="p">
    <verse number="7" style="v" />Elisama, Beeliada, Eliphalet.
  </para>
  <para style="p">
    <verse number="8" style="v" />Philistia mite’n David Israel tengteng tung ah kumpipa a thaunilh ahi chih a zak un, David zong ding in Philistia mite tengteng a kuantou ua: David in huai a zak in, amaute dou ding in a kuankheta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Philistia mite a hong ua, Rephaim phaizang a tuam uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in David in Pathian a dong a, “Philistia mite dou ding in ka kuantou diam? Amau ka khut ah na honpe diam?” chi in. Toupa’n a kiang ah, “Kuantou in; na khut a amau honpe ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Baal-perazim ah a hongtou ua, David in amau a that a; huchi in David in, “Pathian in tuikhah bang in ka khut in ka melmate a hihsia” a chi a. Huaiziak in huai mun min ding in Baal-perazim a sa hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai ah a pathiante uh a nusia ua; David in thupiak a pia a, mei in a hal uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchih nung in Philistiate’n phaizang a tuam nawnlai uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />David in Pathian thu a dong nawn a; Pathian in a kiang ah, “Amau delh ding in na kuantou kei ding: amau kihei mangsan inla, singtheimi singte zawntak ah amau sual in” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Singtheimi singte dawn a taiging na zak chiang in; huaichiang in kidou ding in na kuankhe ding hi: Philistia mihonte that ding in na ma ah Pathian a kuankheta chihna ahi ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in Pathian in amah thu a piak bang in David in a hih a: Gibeon a kipan Gezer pha in Philistia mihonpi a thatta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan David min, gam tengteng ah a thangkheta a; huchi in Toupa’n amah launa nam tengteng tung ah a tungsakta hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in David khopi sung ah David in innte a kibawl a; Pathian bawm ading in mun a bawl a, puanin a kaihsakta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huailai in David in, Levi mite chihlouh kuamah in Pathian bawm a paw ding ahi kei: Toupa’n lah amau Pathian bawm paw ding leh tangtawn a amah na sepsak ding in amaute a natelta ngal a, a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A mun a bawlsaksa a Toupa bawm hon latou ding in, David in Jerusalem ah Israel tengteng a kaikhawmta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in David in Aron tapate leh Levi mite a khawm a:
  </para>
  <para style="p">
    <verse number="5" style="v" />Kohath tapate lak ah; Uriel a pipen leh a unaute za leh sawmnih:
  </para>
  <para style="p">
    <verse number="6" style="v" />Merrari tapate lak ah; Asaiah a pipen leh a unaute za nih leh sawmnih:
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershom tapate lak ah: Joel a pipen leh a unaute za leh sawmthum:
  </para>
  <para style="p">
    <verse number="8" style="v" />Elizaphan tapate lak ah; Semaiah a pipen leh a unaute za nih:
  </para>
  <para style="p">
    <verse number="9" style="v" />Hebron tapate lak ah; Eliel a pipen leh a unaute sawmgiat:
  </para>
  <para style="p">
    <verse number="10" style="v" />Uzziel tapate lak ah; Amminadab a pipen leh a unaute za leh sawmlehnih.
  </para>
  <para style="p">
    <verse number="11" style="v" />David in Zadok leh Abiathar siampute, Levi mite, Uriel, Asaiah, Joel, Semaiah, Eliel, leh Amminadab a samsaka,
  </para>
  <para style="p">
    <verse number="12" style="v" />A kiang uah, “Noute Levi mite pipute inkawte lupente na hi ua: kihihsiang unla, nou leh na unaute uh, mun ka bawlsak sa a Israel Pathian, Toupa bawm na lak theihna ding un.
  </para>
  <para style="p">
    <verse number="13" style="v" />A masapen a na puaklouh ziak un, Toupa i Pathian un i tung uah thuchiam a bawl a, hih ding dan dungzui in amah i zong kei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in siampute leh Levi mite, Israel Pathian, Toupa bawm latou ding in a kisiangsak uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in Toupa thu bangbang a Mosi in thu a piak bang in Levi tate’n a liangzang uah huai a chiangtawnte in Pathian bawm a zawngta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />David in Levi mi pipente kiang ah a unaute uh lasamite tumging theihte toh, pekging guisawm neite leh kaihgingte leh dakkhutbette, ngaihtak a ging leh nuamsa a aw suah ding sepding in a hilh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Levi mite’n Joel tapa Heman a sep ua; a unaute lak ah, Asaph Berekiah tapa; huan Merari tapate a unaute uh lak ah, Kusaiah tapa Ethan;
  </para>
  <para style="p">
    <verse number="18" style="v" />Amau toh a unaute uh pawl nihnate, Zekariah, Ben, Jaaziel, Semiramoth, Jehiel, Unni, Eliab, Benaiah, Maaseiah, Mattithiah, Eliphelehu, Mikneiah, Obed-edom, Jeiel, kongkhak ngakmite.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in lasamite, Heman, Asaph, Ethen te seh in a omta ua, ngaihtak a tum ding, dal dakkhutbette toh;
  </para>
  <para style="p">
    <verse number="20" style="v" />Zekariah, Aziel, Semiramoth, Jehiel, Unni, Eliab, Maaseiah, Benaiah, pekging guisawm neite Alamoth toh kituak a bawl toh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Mattithiah, Eliphelehu, Mineiah, Obed-edom, Jeiel, Azaziah, kaihgingte Seminith toh bawl, makai ding in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Kenaniah, Levi mite lak a a pipen, lapu in a pang a: a siam ziak in, la hilh in a pang hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Berekiah leh Elkanah bawm adia kongkhak ngakmite in a om uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sebaniah, Josaphat, Nethaneel, Amasai, Zekariah, Benaiah, Eliezer, siampute’n, Pathian bawm ma ah pengkulte a mut ua: Obed-edom leh Jehiah bawm a ding a kongkhak ngakmi in a om uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan David leh Israel Upa, sangte tung a heutute, Obed-edom inn a kipan Toupa’n thukhun bawm latou ding in nuamsatak in a kuanta uhi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Hichi ahi a, Pathian in Toupa bawm zawng Levi mite a panpih ziak in, amau bawngtal sagih leh belamtal sagih in a kithoih uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />David puanmalngat hoih puanaktual in a kizem a, bawm zawng Levimi tengteng leh, lasamite leh, la heutupa Kenaniah lasamite toh: huchi in David in puanmalngat siampulian puanak a silh hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchibang in Israel tengteng in Toupa thukhun bawm kikou kawm leh, pengkul ging binei toh, pengkulte toh, dakkhutbette toh pekging guisawm neite leh kaihgingte ngaihtak a ging toh, a hon latouta uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan hichi ahi a, Toupa thukhun bawm David khopi a hongtun in, Saul tanu Mikal tohlet ah a dak khia a, David lam leh mawl a muta a; a lungtang in a musit hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Pathian bawm a hon lalut ua, David in a bawlsak, puanin laizang ah a koihta uhi: Pathian ma ah haltum thillatte leh lemna thillatte a lan uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />David in haltum thillat leh lemna thillatte a latkhit in Toupa min in mite a vualzawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel michih kiang ah, pasal leh numei michih kiang ah tanghou beu khat, sa bak khat, leh grepmin gaw beu khat a hawm hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Toupa bawm mai a nasem ding leh Toupa , Israel Pathian kipahpih ding, kipahthugen ding leh phat ding in Levi mite lak a kuate hiam a septa hi:
  </para>
  <para style="p">
    <verse number="5" style="v" />Asaph a pipen, amah zawm in Zekariah, Semiramoth, Jeiel, Mattithiah, Eliab, Benaiah, Obed-edom, Jeiel, Pekging guisawm neite leh kaihgingte toh; Asaph dakkhutbette, ngaihtak a ging toh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Benaiah leh Jahaziel siampute Pathian thukhun bawm ma a, om nilouh louhte toh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in huai ni’n David in, Asaph leh a unaute khut ah, Toupa kiang a kipahthute gen ding a hihkip masa penpen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aw Toupa kiang ah kipahthute gen unla, a min lou un; mite lak ah a thilhihte theisak un.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amah mai ah la sa unla, phatnalate sa un; a nasep lamdangte tengteng thu in houlim un.
  </para>
  <para style="p">
    <verse number="10" style="v" />A min siangthou suang unla: Toupa zongte lungtang kipak hen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa leh a hatna zong unla; a mel zong nilouhlouh un.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hihkhitsa a thillamdangte theigige unla; a lamdannate leh, a kam a vaihawmte;
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw nou a sikha Israel chi, nou a mitel, Jakob tate.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amah Toupa i Pathian ahi: aman lei tengteng vai a hawm hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Tangtawn in a thukhun theigige unla, suan sang khatte kiang a a piak a thu;
  </para>
  <para style="p">
    <verse number="16" style="v" />Thukhun Abraham toh a bawl, Isak kiang a a thuchiam;
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai mah thuseh ding in Jakob kiang ah a hihkip a, Israel kiang ah tangtawn thukhun ding in:
  </para>
  <para style="p">
    <verse number="18" style="v" />Na kiang ah Kanaan gam, na goutan tuan, k’on pe ding, chi in:
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi tawmchik phet na hihlai un; ahi, tawmchik mahmah, asung a mikhual in;
  </para>
  <para style="p">
    <verse number="20" style="v" />Nam dangdang kiang ah a banhoh ua, gam dangdang a kipan in mi tuamtuamte kiang ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kuamah nuaisiah a phal kei a; ahi, amaute ziak in kumpipate leng a sal hi;
  </para>
  <para style="p">
    <verse number="22" style="v" />“Ka thaunilhte khoih kei unla, ka zawlneite leng hihna kei un,” chi in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leitung luahte tengteng aw, Toupa pahtawi in lasa unla, ni teng in a hotdamna thu theisak un.
  </para>
  <para style="p">
    <verse number="24" style="v" />Namchih lak ah a thupidan gen unla, michihte lak ah a thilhih lamdangte genzak un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa lah a thupi a, nakpi mahmah a phat ding a hih ziak in pathian tengteng sang a kihtak ding ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Michih pathiante milim ahi ua; Toupa’n bel vante a bawl hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pahtawina leh thupina a ma ah a om a; hatna leh kilawmna a Mun Siangthou ah a om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi chih a chichihte aw, Toupa kiang ah pia unla, Toupa thupina leh hatna pia un.
  </para>
  <para style="p">
    <verse number="29" style="v" />Toupa a min thupina pia unla, thillat ding tawi unla, a ma ah hongpai un; siangthou kilawmna in Toupa bia un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lei tengteng aw, a ma ah ling un; khovel a lin theihlouhna ding in hihkip in a om hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Vante kipaktak in om uhenla, lei leng nuamsatak in om hen; namchih lak ah Toupa’n vai a hawm, chi uhen.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuipi leh asung a thil om tengteng ging honhon henla; gam leh asung a om tengteng kipaktak in om hen;
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai hun chiang in gamnuai a sing tengteng in Toupa ma ah nuamsa in la a sa ding ua, lei vaihawm ding in a hong paisin ngal a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aw Toupa kiang ah kipahthu gen un, amah lah a hoih ngal a; a chitna tangtawn a om ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="35" style="v" />Aw, ka hotdamna uh Pathian, hon hondam inla, na min siangthou phat ding leh, na phatna suang ding in, namchih lak a kipan hon pikhawm inla, hon humbit in, chi un.
  </para>
  <para style="p">
    <verse number="36" style="v" />Israelte Pathian Toupa phat in om hen, tangtawn a kipan tangtawn dong in. Mipi tengteng in, Amen, chi in, Toupa a phatta uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huchi in huai a Toupa thukhun bawm ma a ni teng a a kuldan bangzel a nasem ding in Asaph leh a unaute a koihta a;
  </para>
  <para style="p">
    <verse number="38" style="v" />Obed-edom leh a unau uh sawmguk leh giat te toh; Jeduthun tapa Obed-edom leh Hosah bel kongkhakngakmi ahi uhi;
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan Zadok siampu leh, a unaute siampute, Gibeon a om mun sang a Toupa biakbuk ma a,
  </para>
  <para style="p">
    <verse number="40" style="v" />Zingsang leh nitak a haltum thillat maitam tung a Toupa adia haltum thillatte lan gige ding in, Israel kiang ah thupiak a piak Toupa , dansung a kigelh dungzui in;
  </para>
  <para style="p">
    <verse number="41" style="v" />A chitna tangtawn a a om ziak in Toupa kiang a kipahthu gen ding Heman leh Jeduthun leh midang minloh a telkhiakte toh;
  </para>
  <para style="p">
    <verse number="42" style="v" />Heman leh Jeduthun in Pathian lasakna dia vanzatte, pengkulte leh dakkhutbette, ngaihtak a ginsak dingte a nei ua; kongkhakngakmi ding Jeduthun tapate toh.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huchi in mipi tengteng amau inlam chiat ah a paita ua; huan David leng a inkawte vualzawl ding in a pai sam hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, David a inn a a omlai in zawlnei Nathan kiang ah David in, “Ngai in, kei sidar sing inn ah ka om a, himahleh Toupa thukhun bawm puanzak nuai maimah ah a om a” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nathan in David kiang ah, “Na lungsim a na vei bangtak in hih in; Pathian na kiang ah lah a om ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai zan mah in hichi ahi a, Nathan kiang ah Pathian thu a hongtung hi:
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ka sikha David vahilh in: Toupa’n hichi in a chi: Ka omna ding in nang inn n’on lamsak ding ahi kei;
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel suante Aigupta gam a kipan ka pikhiak a kipan tutan in inn lam ah ka omkei a; puanin leh biakbuk ah ka om zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel tengteng toh ka paina himhim uah leng ka mite vak ding a thu ka piak Israelte vaihawmmite kiang ah, bangdia sidar sing inn hon lamsak lou, ka chi ngei ahia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaiziak in ka sikha David kiang ah huchi in gen in: Sepaihte Toupa’n hichi in a chi: Belam tatna mun a kipan na belam ching lai ka mi Israelte tung a kumpipa ding in ka honla a;
  </para>
  <para style="p">
    <verse number="8" style="v" />Na paina peuhmah ah na kiang ah ka om zel a, na melmate k’on hih mansak zel hi; lei a mi thupi mahmahte bang in min thupitak k’on bawlsak sin hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka mi Israelte ading in mun ka sep ding a, kisuan nawn lou a amau tuam mun a a om gige theihna ding un amau ka phut ding hi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuma a ka mi Israelte tung a vaihawmmite ka sehlai a thulimlouhna tate’n a hihsek bang un a hihgenthei n’on sam kei ding uh; na melma tengteng leng ka zahlaksak lai ding hi. Huailou leng Toupa inn kuan khat a hon dinsak ding chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in na ni a bei a, na pi leh pute kiang a na pai hun chiang in, hichi ahi ding a, nanung a na suan, na tate lak a mi ka tungding ding a; a gam ka hihkip ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman inn a hon lamsak ding a; a mangtutphah tangtawn in ka hihkip ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in a pa ka hi ding a, amah ka tapa ahi ding; ka chitna na ma a ompa a kipan a ka lakmang bang in, amah zaw ka lamang kei ding hi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka inn ah leh ka gam ah amah tangtawn in ka ding kip sak ding a, a mangtutphah tangtawn a hihkip ahi ding hi, chi in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai thute tengteng leh huai kilakna bang geih in Nathan in David kiang ah a gen hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in kumpipa David a lut a, Toupa ma ah a tu a, “Aw Toupa Pathian, kua ahia ka hih a, ka inkawte leng kua ahia a hih ua, hichi tantan n’on pi?
  </para>
  <para style="p">
    <verse number="17" style="v" />Aw Pathian, huaite leng nang mitmuh in thil neuchik phet zaw ahi a; himahleh aw Toupa Pathian, na sikha inkuan hong omdan ding thu kum tampi sung ading na nagenta a, mi lian bang in n’on seplai a, aw Toupa Pathian.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na sikha pahtawi a a om tungtang thu ah David in na kiang ah bang a gen tuan nawn dia? Na sikha lah na theitel mahmah hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aw Toupa na sikha ziak in nangmah lungsim a pawt bangzel in hiai thil thupi mahmah theisak ding in thil thupi mahmahte na hihta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aw Toupa ka theih un nang bang mahmah a omkei ua, nang loungal Pathian himhim leng a omsam kei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aigupta gam a kipan na tatkhiak a na mite ma a namdangte zahlaksak a, thil thupitak leh lauhuaitak hih a min thupitak bawlsak ding a Pathian in amah mite adia a hon tatkhiak na mi Israelte bang mahmah khovel ah namdang kua a om ua?
  </para>
  <para style="p">
    <verse number="22" style="v" />Na mi Israelte tangtawn a na mite ding in lah na bawlta ngal a; nang Toupa a Pathian uh na hita.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Huchi in aw Toupa , na sikha tungtang thu leh a inkawte tungtang thu na gen tangtawn adin hihkip inla, na gensa bang in hih in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tangtawn in na min hihkip leh hihlet in om hen, ‘Sepaihte Toupa Israel Pathian, Israelte adia Pathian mahmah ahi,’ na sikha David inkawte na ma ah hihkip in om uhen, chi in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aw nang ka Pathian, na sikha kiang ah inkuan na dingsak ding chihna na phuangta ngal a; huaiziak in na sikha in na kiang ah ka thum ngam lai ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aw Toupa , nang zaw Pathian na hi a, hiai thil hoih na sikha na chiamta hi,
  </para>
  <para style="p">
    <verse number="27" style="v" />Na sikha inkawte na ma a tangtawn a om gige theihna ding un na vualzawl a; aw Toupa , na vualzawl zaw tangtawn a vualzawlna ahi” a chi hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai nung in hichi ahi a, David in Philistia mite a sual a, a zou a, Gath khua leh a khopelte Philistia mite a suhsak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Moabte a sual nawn a, Moab mite David sikhate a hong hita ua, siah a pe zel uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Euphrates lui a a gam kipsak ding a David a paikawm in Zobah kumpipa Hadadezer leng Hamath chin ah a sual nawn hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in David in kangtalai sang khat leh sakol tungtuangmi sang sagih leh sepaih sing nih a matsak a; David in kangtalai kaimi sakol tengteng a thagui a sattansak a, kangtalai za kai ding bel a hawi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan Damaska a Suria mite Zobah kumpipa Hadadezer huh ding in a hong kuan ua, David in Suria mi sing nih leh sang nih a that hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in David in Damaska a Suria mite lak ah a sepaih a koih a; huchi in Suria mite David sikhate a hong hita ua, siah a pe zel uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />David in Hadadezer pawlte dangkaeng lumte a laksak a, Jerusalem ah a paipih hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hadadezer khua Tibhath leh Chun a kipan David in dal tampi a pua a, huaite in Solomon in dal lohte, tunnate, dal tuium-belsuante a bawl hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Hamath kumpipa Tou in Zobah kumpipa Hadadezer sepaih tengteng David in a zou chih a zak in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hadadezer a sim a, a thah ziak a chibai buk ding leh kipahpih ding in a tapa Hadoram David kiang ah a sawl a; Hadadezer leh Tou te lah kidou sek ahi ngal ua; dangkaeng leh dangka sik leh dal tuium-belsuan chichih leng a tawisak lai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaite leng gamdang a zoh tengteng a dangka sik leh dangkaeng a lakte toh David in Toupa kiang ah a lan a; Edomte lak a te, Moabte lak a te, Ammon suante lak a te, Philistiate lak a te, Amalekte lak a te.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huailou leng, Zeruiah tapa Abisai in Edomte sing khat leh sang giat Chi guam ah a that hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Edom gam ah sepaihte a koih a; huchi in Edom mi tengteng David sikhate a hong hita uh. Toupa’n David a paina peuh ah a zousak zel hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in David in Israel mi tengteng tung ah vai a hawm a; a mi tengteng tung ah diktattak in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zeruiah tapa Joab bel sepaih heutu pen ahi a; Ahilud tapa Jehosaphat bel tanchin gelhpa ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahitub tapa Zadok leh Abiathar tapa Abimelek bel siampu ahi ua, huan Savsa bel Laigelhmi ahi a;
  </para>
  <para style="p">
    <verse number="17" style="v" />Jehoiada tapa Benaiah bel Kereth mi leh Pelet mite heutu ahi a, David tapate bel kumpipa kim a heutulian ahi uhi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, huai nung in hichi ahi a, Ammon suante kumpipa Nahash a si a, a tapa in a sik in vai a hawm hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />David in, “A pa’n hon na hehpih zel ziak in ken leng Nahash tapa Hanun ka hehpih sam ding” a chi a. Huchi in David in a pa tungtang thu a lungmuan ding in mite a sawl hi. Huan David mite Ammon suante gam ah Hanun kiang ah amah lungmuan ding in a vatung uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh Ammon suan heutute’n Hanun kiang ah, “David in na pa a zahtak ziak a lungmuan ding mi na kiang a honsawl hi in na um ahia? A mite gam hihse ding a enchian leh enkhe ding a na kiang a hongpai ahi kha kei ding uam maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Hanun in David mite a man a, a khamul uh a metmai sak a, huan a puansilhte uh a laitak ah a tobou uh khuh pha minmen in a tansak a, a paisak ta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in kuate hiam in a mite a na hih dan David a vahilh ua. Huan a dawn ding mi a sawl a; amau lah a zum mahmah ngal uhi. Kumpipa’n, “Na khamul uh sau nawn ma Jeriko ah om unla, huai zoh chiang in hongkik un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Ammon suante’n David zakdah lam a na hihta uh chih a kitheih un, Hanun leh Ammon suante’n Mesopotamia gam a mite, Suria maakah a mite, Zobah a mite, kangtalai leh sakol tungtuang mite goihna ding in dangkasik talent sang khat a khak uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in kangtalai sing thum leh sang nih, Maakah kumpipa leh a mite toh a pi ua, Medeba kiang ah panmun a bawlta uhi. Ammon suante a khua ua kipan a pawtkhia ua, a ki kaikhawm ua, kidou ding in a kuanta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />David in huai a zak in, Joab leh sepaih hangsante tengteng a sawlkhia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ammon suante a hong kuan ua, khopi kongpi chin ah a kiphalh ua, kumpipa amau thu a hong kuante a tuam in pawn ah a om uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in a malam leh nunglam ah a honsual dek uh chih Joab in a theih in Israel mite lak a mi a hoihte a telkhia a, Suria mite sual ding in a ki zalh uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Midang tengteng bel a unaupa Abisai khut ah a koihvek a. Ammon suante sual ding in amau leng a kizalh uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in aman, “Suria mite ka zoh kei dek leh, hon panpih in; Ammon suante na zoh kei dek leh k’on panpih ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hangsantak in om unla, i mite leh i Pathian khuate hum in i kipasal sak ding uh; Toupa’n hoih a sak bangzel in hih hen” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Joab leh a kiang a mite’n kidouna mun a Suria mite a vanaih ua; huchi in a ma ah a taikekta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ammon suante’n Suria mite a taikek uh chih a theih un amau leng a unaupa Abisai ma ah a taikek ta ua, khua ah a lut uhi. Huchi in Joab Jerusalem ah a paita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Suria mite’n Israelte ma ah a pang theikei uh chih a na theih un, mi a sawl ua, Lui khenlam a Suria pawlte a sam khia ua, Hadadezer sepaih heutu Sophak bel a heutu pen uh ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai thu David a hilh ua; aman Israel mi tengteng a samkhawm a, Jordan lui a kan ua, a vamu ua, sual ding in a kiphalh uhi. Huchi in Suriate kidoupih dia David a kisakkhit in amah a kidoupihta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Suria mite bel Israelte ma ah a taikek ua; David in Suria mi, kangtalai sang sagih tung a tuang leh sepaih sing li a that a, sepaih heutu Sophak leng a that hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in Hadadezer mite’n Israelte ma ah a pangthei takei uh chih a theih un, David toh kilemna a bawl ua, a sikhate ding in a omta uh; Suria mite’n leng Ammon suante a panpih nuamta kei uhi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, kum a hong bei a kumpipate kidou ding a a kuankhiak lai un, Joab in a sepaih hatte a pikhia hi. Ammon suante gam a suhsak a, Rabah khua a um uh. David bel Jerusalem ah a om. Huan Joab in Rabah khua a sual a, a lata hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in David in a kumpipa uh lallukhu khuklai a laksak a, a gikdan dangkaeng talent khat ahi, suangmantamte leng a tel a; David a khusak ua; khopi a om gallak sum tampi a la hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in huailai a mipite bel a pikhia a, singatnate, leilehna sik zumte, heipite in na a semsak a. Huchibang in Ammon tate khopi tengteng David in a hih hi. David leh mi tengteng Jerusalem ah a pai nawnta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan hichi ahi a, huai nung in, Philistia mite toh Gezer ah kidouna a om a; huchi in Husat mi Sibbekai in milian suante lak a mi Sippai a that a; huchi in a vuallelta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Philistia mite toh kidouna a om nawn a; Jair tapa Elhan in Git mi Goliath unaupa Lahmi a that a, a teikung chiampek bang ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gath khua ah kidouna a om nawn a, huai ah mi sang mahmah, a khut langtuak a khutzung guk, a khe langtuak a khezung guk, avek a sawmnih leh li nei a om a; amah leng miliante lak a khat ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman Israel mite a simmawh a, David unau Simeah tapa Jonathan in a that hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huaite Gath khua a milian lak a piang ahi uh; huaite David leh a mite khut ah a si uhi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Setan in Israelte a sual a, David bel Israelte sim utna a neisak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan David in Joab leh a miliante uh kiang ah, “Kuan unla, Beer–sheba a kipan Dan tan in Israel mite sim unla, a zah uh ka theihtheihna ding in honghilh nawn un” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Joab in kumpipa kiang ah, “ Toupa’n a mite a mun za in zong hihpung leh, kumpipa ka toupa, ka toupa mite mah hilou uh ahi maw? Bangdia ka toupa’n huai theih kilawp ahia? Bangdia Israelte siamlouh tanlohna hi ding ahia oi?” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Joab a pawtkhia a, Israel gam tengteng ah a pai a, Jerusalem ah a pai nawn hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Joab in mihing om zah David a hilh hi. Israel gam a namsau tawi mi tengteng maktaduai khat leh nuai khat ahi uh; huan Judah gam a namsau tawi mi bel nuai li leh sing sagih ahi uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levite leh Benjaminte bel a sim tel kei a; kumpipa thu Joab zakdah lamtak ahi ngal a.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai thil ah Pathian a kipak kei a; huchi in Israelte a gawtta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in David in Pathian kiang ah, “Hiai thil ka na hihna ah nakpitak in ka na hihkhialta ahi; himahleh na sikha thulimlouhna hehpih in ngaidam in, haihuai tak in ka na hihta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Toupa’n zawlnei Gad kiang ah,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Kuan inla, David kiang ah, Toupa’n hichi in a chi: ‘Thil thum k’on tah: na tung a ka hih ding in a lak ua khat tel in a chi’ ” va chi in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in David kiang ah Gad a vahoh a, a kiang ah, “ Toupa’n hichi in a chi:
  </para>
  <para style="p">
    <verse number="12" style="v" />‘A koi ahia na deih tel in; kum thum kialpi tun, na melmate namsau a delhphak a om a kha thum na melmate vuallelhsak hia, ni thum hipi len ding, Toupa namsau a Toupa angel in Israel gam tengteng a mi hih manthat zel?’ chi in. Huchi in kei hon sawlpa bang ka chi dawn dia, kingaihtuah inla, honhilh in” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />David in Gad kiang ah, “Ka lungzing mahmah; Toupa khut ah puklut peuhmah maileng; a chitna lah a thupi mahmah ngal a; mihing khut ah zaw hon puklut sak mahmah ken” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Toupa’n Israelte lak ah hipi a lengsakta.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan Jerusalem khua hihse ding in Pathian in angel a sawl a; a hihsiat dek laitak in, Toupa’n a en a, thil hoihlou hih a tup a khiama, mite hih mangthang angel kiang ah, “A hunta; na khutlik nawn ken” a chi hi. Huchi in Toupa angel Jebus mi Ornan phual chin ah ading hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />David a daktou a, Toupa angel, namsau phawisa a Jerusalem lam ngima, lei leh van kikal ading a mu hi. Huchi in David leh a upate’n saiip puansilh in lei ah a khupboh uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />David in Pathian kiang ah, “Keimah ka hi ka hia mipite sim ding chih thu pepa? Keimah ka hi ginat huailou tak a thil na hihkhial, hiai belamte’n bang thil ahia a hihtei uh? Aw Toupa ka Pathian, keimah leh ka inkawte tung ah na khutkha inla, na mite’n hipi thuak nawn kei uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in Toupa angel in Gad David kiang a va hohtou a, Jebus mi Ornan phual a Toupa dia maitam doh ding a David hilh ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gad in Toupa min a a thugen ziak in David a hoh touta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ornan a kilehhei a, angel a mu a; a tapa li a kiang a omte a buta uhi. Ornan in buh a na chil ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />David Ornan kiang a tun in, Ornan a kihei a, David a muta a, huan phual a kipan a pawtkhia a, a mai a leisi in David ma ah a khupboh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in David in Ornan kiang ah, “Hiai phual Toupa dia maitam ka bawlna din hon pedih ve; a man kimgeih la in honpia in, mipite lak a hi a kikhin theihna ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ornan in David kiang ah, “Tang in, Toupa ka kumpipa’n pha a sak bang in hih hen; haltum a lat ding in bawngtalte, sing ding in phual vanzatte, tangbuang thillat ding in buhte ka honpia hi; k’on sutuah vek ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan kumpipa David in Ornan kiang ah, “Hilou e; a man kimgeih in ka leizaw ding, manbei in nang a Toupa din ka lakei ding, haltum thillat leng ka lan kei ding” a chi a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in David in huai mun leina in Ornan dangkaeng sekel za guk a pia hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />David in huai ah Toupa ding in maitam a bawl a, haltum thillatte, leh lemna thillatte a lan a, Toupa a sam hi; amah maitam tung ah mei in van a kipan in a dawngta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan Toupa’n Angel thu a pia a, a namsau a pai ah a thun nawnta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in David in Jebus mi Ornan phual ah Toupa’n a hondawng chih a theih in huai ah a kithoihta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huailaiin Mosi in gamdaia Toupa biakbuk leh haltum thillatna maitam a bawl Gibeon khua munsang ah a om ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh David bel Toupa angel namsau a kihtak ziak in Pathian dong ding in huai ah a hoh theikei hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in David in, “Hiai zaw Toupa Pathian inn ahi hi; hiai zaw Israelte haltum thillatna maitam ahi hi” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in David in Israel gam a namdang omte sapkhawm thu a pia a; huan, Pathian inn lamna ding in suangsekmite suang a seksak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />David in intual kongkhak leh a bulhna ding kilhna ding sik tampi a bawlkhol a; dal tamtak buk senglouh toh; sidar sing simsenglouh toh;
  </para>
  <para style="p">
    <verse number="4" style="v" />Zidon mi leh Tura mite’n David kiang ah sidar sing tampi a honla uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />David in, “Ka tapa Solomon lah a naupanglai in, bangmah a thei naikei a, Toupa inn lam ding thupitak, a min leh a thupina gamchih a thangkhe ding ahi a; huaiziak in ka kisakhol hi, a chi hi. Huchi in David a sih ma’n a kisakhol thupi mahmah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in a tapa Solomon a sam a, Toupa Israelte Pathian inn lam ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan David in a tapa Solomon kiang ah, Toupa ka Pathian min ding in inn lam lungsim in ka nei gige hi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh, Toupa thu ka kiang ah a hongtung a, Nang zaw sisan na naksuah tel a, kidoute na uangtel a; leitung ah ka mitmuh a sisan na naksuah ziak in, ka min ading in inn na lam kei ding;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai in, tapa chingkam n’on nei ding a, amah kei lungtuak mi ahi ding a, a kim gam a a melma tengteng lak ah galmuanna ka pe ding; a min Solomon ahi ding a, amah ziak in Israelte galmuang leh lungmuangtakin ka omsak ding;
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman ka min adin inn a lam ding a, amah ka tapa ahi ding a, kei a pa ka hi ding; huan, Israelte tung a a gam mangtutphah tangtawn adin ka hihkip ding.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in ka tapa, Toupa na kiang ah om henla, lamzang zel inla, na tungtang thu a genkholhsa bang in, Toupa na Pathian inn lam in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toupa’n pilna leh theihnate hon neisak peuhmah phot henla, Israelte tung a thuneihna honpia hen, huchi in Toupa na Pathian dan na zui thei ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in Israelte tungtang thu a thusehte leh vaihawmnate Toupa’n Mosi a piak na zuih leh, na lamzang zel ding; hattak in om inla, hangsantak in om in; lau kenla, lunglel sam ken.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai in, ka lungzin lai in Toupa inn adin dangkaeng talent nuai khat leh, dangkasik talent maktaduai khat ka na kisakhol khin a; dal leh sikte leng buk senglouh, tampi ahi; sing leh suang leng ka kisakhol khin ahi, huaite na sunzom theita ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nasemmi, singatmi leh suangsekmi leh khutsiamna chiteng semthei leng na hau hi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Simseng vuallouh dangkaengte, dangkate, dalte, sikte leng; thou inla, nasep pan in, Toupa na kiang ah om hen, a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />David in Israelte makai tengteng a tapa Solomon panpih ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa na Pathian uh na kiang uah a om ka hia? Mun chih mual chih ah galmuanna a honpe ka hia? Hiai gam a mite ka khut ah a hon peta a, Toupa ma leh a mite ma ah gam lak ahita.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuin na lungtang uleh na lungsim uh Toupa na Pathian uh zong ding in koih kip unla; huaiziak in thou unla, Toupa min a inn lam ding suang, Toupa thukhun bawm leh Pathian tuium-belsuan siangthoute laklutna ding in, Mun Siangthou lam un, a chi hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />David a dam sawt in a upa mahmah a; huchi in a tapa Solomon Israelte kumpipa in a bawlta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Israelte makai tengteng siampute leh Levite toh a samkhawm hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Levite kum sawmthum a kipan a tunglam sim ahi ua; a tamlam uh piching sing thum leh sang giat ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huaite lak a “Sing nih leh sang li Toupa inn lam heutute heutu ding ahi ua; sang gukte heutute leh vaihawmmi dingte ahi uh;
  </para>
  <para style="p">
    <verse number="5" style="v" />Sang lite kongkhak ngakmite ding ahi ua, huan sang li te, Phatna ding a thil tumging chi ka bawl, David in a chihte zang a Toupa phat ding mite ahi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Levi ta Gershon, Kahath, Merari zah in David in pawl a bawl a,
  </para>
  <para style="p">
    <verse number="7" style="v" />Gershon mite Ladan leh Shimei ahi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ladan tate pipente Jehiel, Setham, Joel, thum ahi uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Shimei tate Selomith, Haziel, Haran, thum ahi uh. Hiaite Ladan suan inkawte pipente ahi uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Shimei tate bel Jahath, Zina, Jeush, Beriah ahi uh. Hiai lite Shimei tate ahi uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jahath a upapen ahi a, Zizah a sang ahi; Jeush leh Beriahte’n bel ta a hau kei ua; huaiziak in inkuan khat bang a sim ahi uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kohath tate Amram, Izhar, Hebron, Uziel, li ahi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amram tate Aron leh Mosi ahi uh; Aron bel amah leh a suante tangtawn a ding a thil siangthoutakte hihsiangthoua, tangtawn a Toupa ma a gimlim hal a, a nasem a, a min a vualzawlpa ding a hihtuam ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian mi Mosi bel, a tate Levi nam lak a sim ahi uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mosi tate Gershom leh Eliezer ahi uh,
  </para>
  <para style="p">
    <verse number="16" style="v" />Gershomtate lak a upapen Sebuel ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Eliezer tate lak a upapen Rehabiah ahi. Eliezer in tapa dang a neikei; Rehabiah in bel tapa tampi a nei.
  </para>
  <para style="p">
    <verse number="18" style="v" />Izhar tapate; Selmoth a pipen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hebron tate lak a pipen Jeriah ahi a, a sang Amariah, a sang nawn Jahaziel, a sang nawn Jekameam ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uziel tate lak a upa zaw Mikah ahi a, a sang Jesiah ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Merari tate: Merari tate bel Mahli leh Musi ahi uh, Mahli tate, Eleazar leh Kish ahi uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Eleazar tapate neilou in a si a, tanute kia a nei a; Kish tapa a unaute un zi in a nei uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Musi tate Mahli, Eder, Jeremoth, thum ahi uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaite Levi suan, a inkuan uh bangzel a min gelha a sim uh inkuan pipen, Toupa inn lam a kuan, kum sawmnih a kipan tunglam a simte uh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />David in, “ Toupa , Israelte Pathian in a mite galmuangtak in a omsakta a, Jerusalem ah a om nilouh hi.”
  </para>
  <para style="p">
    <verse number="26" style="v" />Levite’n leng biakbuk leh a nasepna ding tuium-belsuan tengteng a zon uh a kiphamohta kei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />David thupiak nanung ziak in Levite kum sawmnih a kipan a tunglam tan in sim ngal ahi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A nasep uh Pathian inn a nasep a Aron tapate panpih a intual sung leh dantan sung a thil siangthoute hihsiangthoua, Toupa inn a nasep lah ahi;
  </para>
  <para style="p">
    <verse number="29" style="v" />Tanghou koih dingte, tangbuang thillat ding a tangbuang nel mahmah, silngou hellouh tanghoupek hiam, bel a uk hiam, kan hiam, a teh leh a letdan bangteng ding bawlte toh;
  </para>
  <para style="p">
    <verse number="30" style="v" />Zingsang teng a Toupa kiang a kipahthu gen leh amah phatte toh, nitak a leng huchi mah;
  </para>
  <para style="p">
    <verse number="31" style="v" />Khawlnite, kha thakte a Ankuanglui neihte a hih ding seh bangzel a Toupa kiang a haltum thillat tengteng Toupa ma a lat gigete toh;
  </para>
  <para style="p">
    <verse number="32" style="v" />Kihoupihna puanin kepte, Mun Siangthou kepte, Toupa inn a nasem a a unau Aron tapate’n hih ding a seh peuhmah uh hihte toh” a chi hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Aron tapate pawl khen dan hichibang ahi, Aron tapate Nadab, Abihu, Eleazar leh Ithamar ahi uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Nadab leh Abihu bel a pa uh sang in a si masa ua; ta a neikei uh; huaiziak in Eleazar leh Ithamarte’n siampu na a sem uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />David in Eleazar tapa Zadok leh Ithamar tapa Ahimelekte toh a nasep dan ding uh a hawmsak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ithamar suante sang in Eleazar suan pipen a pang a tamzaw uh; hichibang in a khen uh; Eleazar suan ah, inkuan pipen sawmlehguk ahi ua; Ithamar suan ah, inkuan pipen giat ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Eleazar suan a mi leh Ithamar suan a mite lak ah, Mun Siangthou a miliante leh Pathian miliante a om tuaktuak uh ahihman in aisan in, amaute a khen uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Levi mi, Laigelhmi Nethaneel tapa Semaiah in kumpipa, milian, siampu Zadok, Abiathar tapa Ahimelek, siampute leh Levite inkaw pipente mitmuh in a gelh a; inkuan pipa khat tan Eleazar tung ah a puk a, khat bel Ithamar tung ah a puk hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in aisan khatveina bel Jehoarib tung ah a puk a, nihveina Jedaiah tung ah;
  </para>
  <para style="p">
    <verse number="8" style="v" />Thumveina Harim tung ah, liveina Seorim tung ah;
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngaveina Makijah tung ah, gukveina Mijamin tung ah;
  </para>
  <para style="p">
    <verse number="10" style="v" />Sagihveina Hakoz tung ah, giatveina Abijah tung ah;
  </para>
  <para style="p">
    <verse number="11" style="v" />Kuaveina Jeshua tung ah, sawmveina Sekaniah tung ah;
  </para>
  <para style="p">
    <verse number="12" style="v" />Sawmlehkhatveina Eliasib tung ah, sawmlehnihveina Jakim tung ah;
  </para>
  <para style="p">
    <verse number="13" style="v" />Sawmlehthumveina Hupah tung ah, sawmlehli veina Jesebeab tung ah;
  </para>
  <para style="p">
    <verse number="14" style="v" />Sawmlehngaveina Bilgah tung ah, sawmlehgukveina Immer tung ah;
  </para>
  <para style="p">
    <verse number="15" style="v" />Sawmlehsagih veina Hezir tung ah, sawmlehgiatveina Apzes tung ah;
  </para>
  <para style="p">
    <verse number="16" style="v" />Sawmlehkuaveina Pethahiah tung ah, sawmnih veina Jehezekel tung ah;
  </para>
  <para style="p">
    <verse number="17" style="v" />Sawmnih leh khatveina Jakin tung ah, sawmnih leh nihveina Gamul tung ah;
  </para>
  <para style="p">
    <verse number="18" style="v" />Sawmnih leh thumveina Delaiah tung ah, sawmnih leh liveina Maaziah tung ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai bel Toupa , Israelte Pathian in a pu uh Aron thu a na piak, Toupa insung a na a sep dan ding a na sehdan ahi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Levi suan dangte lak ah; Amram tate lak ah Subael ahi; Subael tate lak ah Jedeiah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Rehabiah lam ah; Rehabaihte lak ah pipen Isshiah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Izharte lak ah Selomoth; Selomoth tapate lak ah Jahath,
  </para>
  <para style="p">
    <verse number="23" style="v" />Hebron tapate, a upapen Jeriah ahi a, a sang Amariah, a sang nawn Jahaziel, a sang nawn Jokameam ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Uziel tapate lak a mi Mikah; Mikah tapate lak a mi Samir ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mikah unaupa Isshiah ahi a; Isshiah tapate lak ah, Zekariah.
  </para>
  <para style="p">
    <verse number="26" style="v" />Merari tapate bel Mahli leh Musi ahi ua; Jaaziah tapate lak a mi Beno ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Merari suante, Jaaziah lak ah Beno, Soham, Zakur leh Ibrite ahi uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mahli lak ah, Eleazar ahi a, aman tapa a neikei.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kish lak ah, Kish tapa Jerameel ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Musi suante bel, Mahli, Ede leh Jerimothte ahi uh. Hiaite bel Levite suante lak a a inkuan ua pipente ahi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiai inkuan chih a lianpen leh naupangpen te’n leng Aron ta a unaute uh bang in, a gam tanding uh, kumpipa David, Zadok, Ahimelek, siampu leh Levite inkaw pipente mitmuh in ai a san sam uhi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Asaph, Heman, Jeduthun tapa khenkhat kaihgingte, pekgingte, dakkhutbette toh a lavek a nasemmi ding in David leh sepaih heutute’n a hihtuam ua; nasep ding omdan bangzel in nasemmite tamdan ding a sep uhi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Asaph tapate lak a mi Zakur, Joseph, Nethaniah leh Asarelah ahi ua, amau bel Asaph tapate, kumpipa thupiak bang a lavek zel. Asaph thuthu a om ahi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jeduthun lak ah; Jeduthun ta Gedaliah, Zeri, Jesaiah, Simei; Hasabiah leh Matithiahte, guk ahi uh; kaihging toh Toupa kiang a kipahthu gen a lavek a a pa uh Jeduthun thuthu a om ahi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Heman lak ah; Heman ta Bukiah, Mataniah, Uziel, Sebuel, Jerimoth, Hananiah, Hanni, Eliathah, Giddalti, Romamtiezer, Josbekasah, Malothi, Hothir leh Mahziothte ahi uhi;
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaite tengteng Pathian lam thu a kumpipa zawlnei Heman ta pengkulkawi mutmi dingte ahi uhi. Pathian in Heman tapa sawmlehli leh tanu thum a pia.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huaite tengteng Toupa inn a dakkhutbet toh, kaihging toh, pekging toh, Pathian inn a nasepna ding a la toh lemmite, a pa uh thuthu a om ahi uh; Asaph, Jeduthun leh Hemante bel kumpipa thupiaka om ahi leuleu uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A tamlam uh, a unau, Toupa ding a lasak kisin siam khinsa tengtengte toh za nih leh sawmgiat leh giat ahi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a neu a lian, sinsakmi leh sinmi in a tan ding uh kibangsap in ai a san uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in aisan khatveina Asaph tapa Joseph tung ah a puk a; nihveina Gedaliah tung ah; amah leh a unaute leh a tapate sawmlehnih ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thumveina bel Zakur tung ah, a tapate leh a unaute sawmlehnih ahi uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Liveina Izri tung ah, a tapate leh a unaute sawmlehnih ahi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngaveina Nethaniah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gukveina Bukiah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sagihveina Jesarelah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Giatveina bel Jesaiah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuaveina bel Mataniah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sawmveina Shimei tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sawmlehkhatveina Azarel tung ah, a tapa leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sawmlehnihveina Hasabiah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sawmlehthumveina Subael tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sawmlehliveina Matithiah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sawmlehngaveina Jeremoth tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sawmlehgukveina Hananiah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sawmlehsagihveina Josbekasah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sawmlehgiatveina Hananiah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sawmlehkuaveina Malothi tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sawmnihveina Eliathah tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="28" style="v" />Sawmnih leh khatveina Hothir tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sawmnih leh nihveina Giddalti tung ah, a tapate leh a unaute sawmlehnih
  </para>
  <para style="p">
    <verse number="30" style="v" />Sawmnih leh thumveina Mahazioth tung ah, a tapate leh a unaute sawmlehnih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sawmnih leh liveina Romamtiezer tung ah, a tapate leh a unaute sawmlehnih ahi uhi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kongkhak ngak pawl khen dan: Kora mi bel Asaph tapate lak a Kora tapa Meselemiah ahi a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Meselemiah in tapate a nei a; a ta masa Zekariah ahi a, a zom Jediael, a thumna Zebadiah, a lina Jathniel;
  </para>
  <para style="p">
    <verse number="3" style="v" />A ngana Elam, a gukna Jehohanan, a sagihna Elioenai ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Obed-edom in tapate a nei a; a ta chil Semaiah ahi a, a zom Jehozabad, a thumna Joah, a lina Sakar, a ngana Nethaneel.
  </para>
  <para style="p">
    <verse number="5" style="v" />A gukna Amiel, a sagihna Issakar, a giatna Peulethai ahi, amah bel Pathian in a vualzawl hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tapa Semaiah a kipan tapa, a inkawte uh pipente leng a piang ua; mi hat hangsan ahi chiat uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Semaiah tapate Othni, Rephael, Obed leh Elzabadte ahi ua, a unau uh Elihu leh Semakiah bel mi hat mahmah ahi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huaite tengteng Obed-edom suante ahi uh: amau leh a tapate uh leh a unaute uh nasepna lamsang ah mi piching ahi uh; Obed-edom a kipan mite sawmguk leh nih ahi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meselemiah in tapa leh unau mi hat mahmah sawmlehgiat a nei.
  </para>
  <para style="p">
    <verse number="10" style="v" />Merari suante lak a Hosah in leng tapate a nei a; Simri bel a pipen ahi a, ta chil ahi kei na a, a pa’n pipen in a bawl hi;
  </para>
  <para style="p">
    <verse number="11" style="v" />A zom in Hilkiah ahi a, a thumna Tebaliah, a lina Zekariah ahi. Hosah tapate leh a unaute avek un sawmlehthum ahi uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai pipente lak a mi a unaute uh bang a Toupa inn a nasem thilbawl a tantuan nei a kongkhak ngakmi pawl a a khente uh ahi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A neu a lian in, a inkaw dungzui zelun kongpi chih a om ding zonna ding in ai a san uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in suahlam adia aisan pen Selemiah tung ah a puk hi. Vaihawmmi piltak, a tapa Zekariah adin ai a san ua, mallam pen amah a tuamin apuk hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Simlam bel Obed-edom tuam in; a tapate tuamin Asuppim.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tumlama toupaina lampi a Saleketh kongkhak venna toh, Suppim leh Hosah tuamin.
  </para>
  <para style="p">
    <verse number="17" style="v" />Suahlam ah Levite guk a om ua, niteng in mallam ah li, simlam ah li, thil koihkhawmna in ah nih tuaktuak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tumlam in umsung ading in a lutna ah li; in umsung ah nih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaite ahi uh, Kora tapate leh Merari mi tapate kongkhak ngakmi pawl a khente uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan a unaute uh Levite lak ah Ahijah Pathian sum koih khawmna inn leh thil siangthou koihkhawmna inn heutu ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ladan tapate; Gershon mite tapate Ladante a te, pipute inkawte a pipen Gershon mi Ladan a te; Jehieli.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jehieli tapate; Zetham, Joel a unaupa, Toupa inn a sum koihkhawmna heutu ahi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amram mite a kipan, Izhar mite a kipan, Hebron mite a kipan, Uzziel mite a kipan:
  </para>
  <para style="p">
    <verse number="24" style="v" />Sebuel Gershomtapa, Mosi tapa, sum koihkhawmna heutu ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A unaute bel Eliezer tapa Rahabiah, Jesaiah, Joram, Zikri leh Selomithte ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Selomith leh a unaute bel kumpipa David leh a inkawte uh pipen sepaih sang heutute leh za heutute leh sepaih pawl heutute’n a hih siangthousa uh, thil siangthou koihkhawmna in tengteng kemte ahi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kidouna gallak thilte Toupa inn bawlphatna din a koih uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zawlnei Samuel, Kish tapa Saul, Ner tapa Abner leh Zeruiah tapa Joabte’n a hih siangthou tengteng uh, kuapeuh in thil a hih siangthousa peuhmah uh Selomith leh a unaute kep vek ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Izhar mi Kenaniah leh a tapate Israel gam pawlam tungtang thu a heutute leh vaihawmmi ahi uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hebron mi Hasabiah leh a unau mi hangsan sang khat leh za sagih Jordan gal tumlam a Israelte ukpa ahi uhi; Toupa na tengteng leh kumpipa nasepna lam na ah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hebron mi Jerijah bel a suan uh tungtang thu a inkaw pipen lam ah Hebronte pipa pen ahi. David kum sawmli a vaihawm kum a a zon un Gilead gam a Jazer khua ah mi hat hangsan a mukhia uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A unau mi hangsante sang nih leh za sagih ahi uhi. Huaite inkuan pipen, kumpipa David in Pathian lam thil chiteng leh kumpipa na lam thu a Reuben, Gad leh Manassehte nam kimkhatte heutu dia bawlte ahi uh.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israelte a tamdan uh inkuan pipente, sepaih sang heutute, za heutute leh kumpipa nasemmite tengteng kum khat sung a kha chih a kikheng zelzel, pawl chih a mi sing nih leh sang li ahi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pawl khatna kha khatna a heutu Jebdiel tapa Jasobeam ahi a, pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah Perez suan a mi, kha khatna a sepaih heutu tengteng heutu pen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kha nihna pawl heutu Ahoh mi Dodai ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kha thumna a sepaihte heutu pen siampu Jehoiada tapa Benaiah ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai Benaiah ahi a, sawmthum lak a mi hangsan, sawmthum tung a mi pen; a pawl ah a tapa Amizabad a tel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kha lina a sepaih heutu Joab unaupa Asahel ahi a, a tapa Zebadiah a sik a pang ahi, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kha ngana sepaih heutu Izrah mi Samhut ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kha gukna a sepaih heutu Tekoa mi, Ikkes tapa Ira ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kha sagihna a sepaih heutu Ephraim suan Pelon mi Helez ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kha giatna a sepaih heutu Zerah suan, Husat mi Sibbekai ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kha kua na a sepaih heutu Benjamin suan Anathoth mi Abiezer ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kha sawmna a sepaih heutu Zerah suan Netophath mi Maharai ahi a, a pawl ah sing nih sang li a om uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kha sawmlehkhatna a sepaih heutu Ephraim suan Pirathon mi Benaiah ahi a, a pawl ah sing nih leh sang li a om uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kha sawmlehnihna a sepaih heutu Othniel suan Netophath mi Heldai ahi a, a pawl ah sing nih sang li a om uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huailou leng, Israel namte tung a: Reubente lak a Zikri tapa Eliezer vaihawmpa ahi a, Simeonte lak ah Maakah tapa Sephatiah ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Levite lak ah Kumuel tapa, Hasabiah; Aron te lak ah Zadok;
  </para>
  <para style="p">
    <verse number="18" style="v" />Judate lak ah David unaute lak ah Elihu, Issakarte lak ah Mikael tapa Omri;
  </para>
  <para style="p">
    <verse number="19" style="v" />Zebulunte lak ah Obadiah tapa Ishmaiah; Naphtalite lak ah Azriel tapa Jeremoth;
  </para>
  <para style="p">
    <verse number="20" style="v" />Ephraim suante lak ah Azaziah tapa Hosea; Manasseh nam kimkhatte lak ah Pedaiah tapa Joel.
  </para>
  <para style="p">
    <verse number="21" style="v" />Gilead gam a Manasseh nam kimkhatte lak ah, Zekariah tapa Ido; Benjaminte lak ah Abner tapa Jaasiel;
  </para>
  <para style="p">
    <verse number="22" style="v" />Dante lak ah Jeroham tapa Azariel. Huai te Israel nam heutute ahi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />David in kum sawmnih a kipan a nuailam a sim kei hi, Israelte bel van a aksi zah in a pungsak ding chih Toupa’n a na gen khit tak ziak in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Zeruiah tapa Joab in a sim pana, himahleh a simzou kei a, Israelte tung ah leng hehna a hongtungta a; kumpipa David vaihawm lai tanchin gelhna bu ah a zah gelh leng ahi sam kei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kumpipa sum kempa Adiel tapa Azmaveth ahi a; huan loulam ah, khopite ah, khopel khong ah, insangte a sum kempa bel Uzziah tapa Jehonathan ahi a.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lou a leileh nasep sem kempa Kelub tapa Ezri ahi a;
  </para>
  <para style="p">
    <verse number="27" style="v" />Grep huan kempa Ramath mi, Shimei ahi a, grephuan a uain suksa koihkhawm kempa siphmite mi Zabdi ahi a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Phaiguam olive sing leh theipi kungte kempa Geder mi Baal hanan ahi a, sathau koihkhawmna kempa Joash ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Saron a ta ganhon kempa Saron mi Sitrai ahi a, guam a ganhon kempa Adlai tapa Saphat ahi;
  </para>
  <para style="p">
    <verse number="30" style="v" />Sangawngsau kempa Ishmael mite Obil ahi a, sabiltung kempa Meronoth mi Jehdeiah ahi a;
  </para>
  <para style="p">
    <verse number="31" style="v" />Belamhon kempa Hagar mi Jaziz ahi. Huaite tengteng kumpipa David sumkem mite ahi uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan David pangak, mi pil, laisiam mahmah Jonathan bel thuthei pen ahi a, Hakmoni tapa Jehiel bel kumpipa tapate sinsakpa ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ahitophel kumpipa thutheihpihpa ahi a; Ariki mi Husai kumpipa lawm ahi a.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahitophel zom in Benaiah tapa Jehoiada leh Abiathar ahi uhi, kumpipa sepaih heutu bel Joab ahi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan David in Israel heutu tengteng nam pipente, kumpipa nasem a kikheng zelzel pawl heutute, sepaih sang heutute, za heutute, kumpipa leh a tapate sum leh thil neih tengteng tung a heutute, milian mi hat, mihat hangsan tengtengte toh Jerusalem ah a samkhawm hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in kumpipa David ading a, ka unaute leh ka mite aw, ka thu na ngaikhia dih ua; “Ken Toupa thukhun bawm koihna leh i Pathian khengakna ding inn lam lungsim in ka nei gige a; lamna ding leng ka ngahkhin sipsip hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh, Pathian in ka kiang ah, ‘Nang zaw kidoumi sisan suahmi na hih ziak in ka min adin inn na lam kei ding’ a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh Toupa Israelte Pathian in, ka pa inkawte tengteng lak a kipan Israelte kumpipa dia tangtawn a om ding in a hon na telta a; Judah nampipen ding in a na telta a; Judah namte lak ah ka Pa inkawte; ka pa tapate lak a kipan Israel tengteng kumpipa din a hon na tel khe tuamta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka tapa tengteng lak ah, Toupa’n tapa tampi a honpia a, Israelte kumpipa ding in Toupa gam mangtutphah a tu ding in ka tapa Solomon a na telta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in ka kiang ah, Na tapa Solomon in ka inn leh ka intualte a dingsak ding; ka tapa ding in ka telta a, huchi in a pa ka hi ding.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka thupiakte leh ka vaihawmte a pom gige leh tua na hih gige bang un a gam tangtawn adin ka kipsak ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Toupa mipi, Israelte tengteng mitmuh in leh i Pathian zak in Toupa na Pathian uh thupiak tengteng pom ding leh limsak ding in k’on hanthawn ahi; huchi in hiai gam hoih mahmah na luah ding ua, nanung uah na suante uh tangtawn adin na luahtou sawnsak zel ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan nang ka tapa Solomon, na pa Pathian thei inla, lungtang hoih bukim leh lungsim kilawptak in a nasep sem in; Toupa’n lah lungtang a en sek a, lungsim a lunggel tengteng a thei vek hi; amah na zon leh na mu ding a, na lehngatsan leh bel tangtawn in a hon khahkhe ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pilvang in; munsiangthou adia inn lam ding in Toupa’n nang a hon septa hi, hattak in om inla, pang in” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in David in a tapa Solomon kiang ah biakin inlim, a inlim, sum koihkhawmna inlim, a dantan tungnung lim, asung dantan lim, chitna tutphah lim.
  </para>
  <para style="p">
    <verse number="12" style="v" />A lungsim a a lunggel bang tengteng, Toupa inn umsung intual lim, a kim dantan tengteng lim, Pathian in a sum koihkhawmna in lim, thil tan koihkhawmna inlim a pia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Siampute leh Levite a pawlpawl a a omna ding uh lim, Toupa inn a nasepna lam ding tengteng lim, Toupa inn a nasepna ding tuiumbel suan tengteng lim leng.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nasepna lam adia tuium-belsuan chichih, dangkaeng tuium-belsuan ding, dangkaeng zatzel zah ding,
  </para>
  <para style="p">
    <verse number="15" style="v" />Dangkaeng khawnvak koihna leh a khawnvak ding dangkaeng zatzel zah ding, khawnvak koihna leh a khawnvak tui ding a zatzel zah ding, khawnvak koihna a mun kiphamoh chiat bangzel a dangkasik khawnvak koihna ding adia zatzel zah ding toh;
  </para>
  <para style="p">
    <verse number="16" style="v" />Tanghou at koihna ding dangkaeng dohkan leh, dangkasik dohkan bawlna ding a, dangkaeng zatzah ding leh dangkasik zatzel zah ding a tehna in a pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Maiphiatna kuang, noute toh; dangkaeng belhbu ding, belhbu khat zel adia zatzel zah ding.
  </para>
  <para style="p">
    <verse number="18" style="v" />Cherubte a kha uh zak a, Toupa thukhun bawm tuam tuanna lim bang bawlna ding dangkaengte toh.
  </para>
  <para style="p">
    <verse number="19" style="v" />David in, “Hiaite tengteng Toupa’n amah mah khut a hon gelh, hiai a lim tengteng hon theisak hi in ka thei” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in David in a tapa Solomon kiang ah, “Hattak leh hangsantak in om inla, pang in; laukenla, lunglel sam ken; Toupa Pathian ka Pathian na kiang ah a om hi; Toupa inn lam nasep tengteng zoh ahihvek mateng a hon paisan in, a hon limsaklou kei ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan ngai dih, Pathian in na chih teng semmi pawl siampute leh Levite a om ua, bang na peuh a, banglam peuh a nasep siam, hattak chiat a nang hon panpih ding na kiang ah a om zel ding uhi; heutute leh mipi teng in leng na thupiak peuhmah a zui ding uhi” a chi hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan kumpipa David in mipi tengteng kiang ah, “Pathian telkhiak ka tapa Solomon a naupanglai in bangmah a thei naikei a, a sep ding lah a thupi ngal a, biakin mihing ading ahi kei a, Toupa Pathian ading ahizaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in ka Pathian inn ading in a dangkaeng lam thil adin dangkaengte, dangkasik lam thil adin, dangkasik, dal lam thil adin dal, sik lam thil adin sik, singlam thil adin sing theihtawk in ka na kisa khinta a, a zepna ding onik suang, suang kilawm, a silhding suang kilawm chi tuamtuam leh suang mantam chichih leh suangpak suang tampite ka pekhinta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaikia louleng ka Pathian inn ka deihsak mahmah a, keimah sum dangkaeng leh dangkate leng, inn siangthou adia ka na kisaksa tengteng chih louh in, ka Pathian inn ading in ka pia hi, huai bel bang zutna ding in Ophir dangkaeng,
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangkaeng talent sang thum leh dangkasik siang thou talent sang sagih, zatna lam tuamtuam a misiamte zat ding in, dangkaeng zatna ding a dangkaengte.
  </para>
  <para style="p">
    <verse number="5" style="v" />Dangka sik zatna ding a dangkasikte ahi. Tuni in Toupa ding a kipaktak a pephal kuakua na om ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in inkuan pipente, Israel nam heutute, sang heutute leh za heutute, kumpipa nasemte heutute toh kipaktak in a pia uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian inlamna ding dangkaeng talent sang nga leh darik sing khat, dangkasik talent sing khat leh dal talent sing khat leh sang giat, sik talent nuai khat a pia uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Suangmantam neite’n Toupa sum koihkhawmna a Gershon mi Jehiel kep ding in a koih uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in mipite a kipak mahmah ua, lungsim munkhat pu a kipaktak a Toupa a piak ziak un, kumpipa David in leng nuamsak petmah in nuam a sa hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in David in mipi tengteng ma ah Toupa kiang ah kipahthu a gen hi,
  </para>
  <para style="p">
    <verse number="11" style="v" />“Aw Toupa , ka pu uh Israel Pathian, tangtawn a phat in om hen. Aw Toupa , thupina, thilhihtheihna, pahtawina, zohna, lalna nang a ahi a, lei leh van a om tengteng nang a ahi. Aw Toupa , gam nang a ahi a, mitengteng a tungnungpen na hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hauhsakna leh pahtawina na kiang a kipan ahi, bangkim tung ah thu na nei a, thilhihtheihna na khut ah a om a, mi tengteng hihthupina leh hatna piaktheihna na khut ah a om hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />‘Huchi in ka Pathian uh kipahthu k’on hilh ua, na min thupi ka phat uhi,’
  </para>
  <para style="p">
    <verse number="14" style="v" />“Himahleh kua ahia ka hih a, ka mite leng kua ahia a hih ua, hiaite kipaktak a k’on lat theih mahmah uh? Thil tengteng na kiang a kipan a pawt ahi ua, nang a hon penawn lel ka hi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka pi leh pute uh bang in kou zaw na ma ah mikhual, mi kiang a omsam bang ka hi ua; leitung a damsung nite zaw limliap banglel ahi a, lamet ding himhim a omkei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa ka Pathian uh, na min siangthou ding a inn k’on lamsak ding a hiai thil ka na kisakna tengteng uh nangmah khutsuak ahi a, nang avek ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka Pathian, nang lungtangte na enchian sek a, diktatnate na kipahpih nak chih leng ka thei hi. Ken zaw lungsim taktak in hiai thil tengteng kipak mahmah in k’on lan ahi, hiai lai a na mite leng kipak mahmah a na kiang a honlan mite ka muh in ka kipak mahmah hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aw Toupa , ka pu uh Abraham, Isak, Israelte Pathian, na mite’n hichibang lungsim a put gige theihna ding un a lungsimte uh nang ading in hihkip inla;
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan ka tapa Solomon na thupiakte, na thu theihsakte, na dante zui a, huaite tengteng hih ding leh ka kisakkholhna inlam ding in lungsim hoihkim pusak in” David in a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />David in mipi tengteng kiang ah, “Khaile, Toupa na Pathian uh phat un” a chi a, huchi in mipi tengteng in Toupa , a pi leh pute uh Pathian a phat ua, a kun ua, Toupa leh kumpipa a bia uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A zing in Toupa kiang ah kithoihna ding leh Toupa kiang a haltum thillat ding in bawngtal sang khat leh belam sang khat leh belamnou sang khat, a dawn ding uh thillat toh Israelte tengteng adin kithoihna tampi a lan uhi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in huai ni’n Toupa ma ah nuamsatak in a ne ua, a om chiat uhi. David tapa Solomon bel kumpipa ding in a bawltuan nawn ua, Toupa milian ding in sathau a nilh ua, huan, Zadok bel siampu ding in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in Solomon Toupa mangtutphah ah a pa David sik in kumpipa in a tuta a, lamzangtak in a om a; huan Israelte tengteng in a thu a zui uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan heutute tengteng leh mi hat hangsante leh kumpipa David tapa dang tengtengte kumpipa Solomon lak ah a kipia uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa’n Solomon Israelte tengteng mitmuh in nakpitak in a hihthupi a, Israel gam a a ma a kumpipate lak ah kuamah in a tan ngeilouh uh, kumpipa hihna thupi mahmah a tangta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesse tapa David in Israelte tengteng tung ah vai a hawm hi,
  </para>
  <para style="p">
    <verse number="27" style="v" />Israelte tung a a vaihawm sung kum sawmli ahi; Hebron khua ah kum sagih vai a hawm a, Jerusalem ah kum sawmthum leh thum vai a hawm hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Upa tak, tekkun a dam in, hausatak leh pahtawi loh in a si a; a sik in a tapa Solomon in vai a hawmta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai in, kumpipa David tanchin a tung a kipan a tawptan in, zawlnei Samuel laibu, zawlnei Nathan laibu, leh zawlnei Gad laibute ah a tuang hi,
  </para>
  <para style="p">
    <verse number="30" style="v" />A vaihawm thute, a thilhihtheihdan tengtengte, amah leh Israelte tung leh gam tengteng tung a thil hong omdante toh.
  </para>
</usx>
