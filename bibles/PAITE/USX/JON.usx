<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JON" style="id">Jonah</book>
  <para style="h">Jonah</para>
  <para style="toc1">Jonah</para>
  <para style="toc2">Jonah</para>
  <para style="mt">Jonah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amittai tapa Jonah kiang ah Toupa thu a hongtung hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Thou inla, Ninevi khua, khopi thupitak ah hoh inla, a tungthu ki koupih in; a gitlouhna uh ka ma ah a hong tungtouta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh Jonah bel Toupa ma a kipan Tarsis ah taimang ding in a thou a; Joppa khua ah a hohsuk hi, Tarsis zuan ding long a mu a; huchi in, a tuanman pia in, Toupa ma a kipan Tarsis zuan dingte toh ton ding in long ah a lutsuk hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh Toupa’n huih hat mahmah tuipi ah a nungsak a, tuipi ah huihpi hat mahmah a nung hi, huchi in, long tamzak ding bang in a omta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Long mite a lau ua, amau pathian chiat a sam ua; long zanna ding in long sung a vante tuipi ah a paikhia uhi. Jonah bel long sunggil pen ah na lutsuk pah a, huai ah lum in, a na ihmu hithit hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in longheutu a kiang ah a hongpai a, “Aw nang ihmu, bangchidan ahia? Thou inla, na Pathian sam in, Pathian in, i manlouhna ding in a hon ngaihtuah khamawh dia hiam” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan khai, “Hiai thil hoihlou i tung ua hongom kua ziak ahia chih i theihna ding in, ai i san ding uh” chi in a kihou uhi. Huchi in, ai a san ua, aisan Jonah tung ah a tuta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in a kiang ah, “Hiai thil hoihlou i tung ua om kua ziak ahia, honhilh in, k’on ngen uh; na nasep bang ahia? Koi a kipan a hong na hia? Koi gammi na hia? Bang nam mi na hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman a kiang uah, “Hebru mi ka hi; tuipi leh gam bawlpa Toupa , van Pathian ka lau ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in mite’n a kihta mahmah ua, a kiang ah, “Bangdia hiai bang hih na hia?” a chi ua a hilhkhitsa a hih ziak in mite’n lah Toupa ma a kipan a taimang ahi chih a thei uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in a kiang ah, “Kou dia tuipi a kihoh louhna ding in na tung ah bang ka hih ding ua?” a chi ua, tuipi lah a kihot sang hulhul hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman a kiang uah, “Hon domkang unla, tuipi ah hon lawnkhia un; huchi in tuipi nou ading in a kihot nawn kei ding; kei ziak in na tung uah hiai huihpi thupitak a nung ahi chih ka thei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh mite’n gam a kik ding in nakpi’n long a kal ua; himahleh a hithei kei: tuipi lah a tung uah a nak kihoh semsem hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaiziak in Toupa a sam ua, “ Aw Toupa , hiai mipa hinna ziak in hon hihmang kenla, mi hoih sisan mawh ka tung uah nga mahmah lou ding in nakpitak in k’on ngen uhi: Toupa , hiai lah nang na deih bang a na hih ahi ngal a” chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in Jonah a domkang ua, tuipi ah a lawnkheta uhi: huchi in tuipi kihot phul vonvon a daita hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in, mite’n Toupa nakpitak in a lau ua; Toupa kiang ah kithoihna a lan ua, thu a chiam uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Toupa’n Jonah valh ding in nga liantak a nasep khin a; huai nga gilsung ah Jonah ni thum leh zan thum a om hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Jonah ngapi gilsung a kipan in, Toupa a Pathian kiang ah a thum a, Hichi in a chi a:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ka haksatna ziak in Toupa ka sam a, aman a hon dawng a; Sheol gilsung a kipan in ka kikou a, nang ka aw na zata hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thukpi ah, tuipi sunggil ah n’on pailut a, tui tampi ka kimvel ah a om a; na tuikihawt leh na tui kisep tengteng in a hontum zel hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan na mitmuh a kipan paihkhiak ka hi a; himahleh na biakin siangthou lam ka nga nawn ding, ka chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tuite’n ka hinna tan in a hon umkim ua; tui thuk ka kim ka vel ah a om hi; louhingte’n ka lu a tuamsuak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tangte taw ah ka paisuk a; lei in tangtawn a ding in a kalhnate’n a hon khakkhum a; himahleh nang Aw Toupa ka Pathian, kawhawm a kipan ka hinna na lakhia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka hinna ka sung ah a bahlai in, Toupa ka theigige ding a: Ka thumna na biakin siangthou ah na kiang a hongtung hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thilginalou leh zuaulel limsakmite’n amau chitna a lehngatsan uh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ken zaw kipahthu genna aw toh na kiang ah kithoihna ka lan ding; ka chiamsa thu ka tangtun ding. Hotdamna Toupa a ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Toupa’n nga a houpih a, Jonah gam ah a lawkheta hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Toupa thu Jonah kiang ah a hongtung nawn leuleu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Thou inla, Ninevi khua, khopi thupitak ah hoh inla, thugen ding k’on chihpen va tangkoupih in” chi in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in Jonah a thou a, Toupa thu bang in Ninevi khua ah a hohta hi. Ninevi bel khopi thupi petmah, ni thum pai a ching hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jonah ni khat pai zoh chiang khopi sung ah a vapai phot a, “Tua pat ni sawmli in, Ninevi hihman ahi ding hi” chi in, a kikou hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ninevi mite’n Pathian a gingta ua; anngawl a phuang ua, a lak ua a lianpen a kipan a neupen tan in saiip puan a silh uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai thu Ninevi khaw kumpipa bil a hongtungta a, a mangtutphah a kipan a thou a, a kumpipuan a suah a, saiip puan silh in, vut ah a tuta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kumpipa leh a miliante thupiak in kumpipa’n Ninevi khosung ah thu a phuang in a pulakta hi. “Mihing hiam, gan hiam, bawnghon hiam, belamhon hiamte in bangmah chiam kei uhen: banghiam ne in tui leng dawn kei uhen:
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing leh ganhingte’n saiip puan silh uhenla, nakpitak in Pathian sam uhen: ahi, michih in amau lampi hoihlou leh a khut ua hiamgamna lehngatsan uhen.
  </para>
  <para style="p">
    <verse number="9" style="v" />I manlouhna ding in, Pathian lunghei in lungsim kilehhei in, a heh mahmahna a kipan a kilehhei kei ding chih kuan ahia theithei?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in Pathian in a thilhihte uh en in, a lampi hoihlou uh a lehngatsan uh chih a mu a; a kiang ua a chihsa, hih a tup thil hoihlou Pathian in a lehngatsan a; a hihta kei hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Himahleh huai in Jonah a lungkim hetkei a, a heh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa kiang ah a thum a, “ Aw Toupa , k’on ngen hi, hiai ka gam ua ka omlai a ka gen hilou hia? Hiai ziak in Tarsis lam ah ka taimang pah a: hehpih thei Pathian, lainatna a dim, heh mengmeng lou, chitna hau, thil hoihlou lehngatsan sek na hi chih ka thei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in Aw Toupa , tuin ka hinna hon laksak ding in k’on ngen hi; kei ading in hin sang in sih a hoihzaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Toupa’n , na heh mawk na hih dik hia? a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Jonah bel khopi a kipan a paikhia a, khopi suahlam pang ah a tu a, huai ah sawlbuk a lam a, khopi tung a thil hongtung ding muh tum in a nuailim ah a tu nilouh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa Pathian in umgui Jonah tung ah a zamsak a, a haksatna a kipan honkhe ding a a lu liah ding in a nasep khawl hi. Huchi in Jonah umgui ziak in a kipak mahmah hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh Pathian in, a zingsang phalvak in, leikha a nasep khawl a, huai in umgui a keitan a ahong vuaita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hichi ahi a, ni a hongsuah in Pathian in suahlam huih a na sepkhawl a; ni in Jonah lu a hai a, a sibup a, amah adin sih a ngen hi, “Kei ding in hin sang in sih a hoihzaw” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in Jonah kiang ah, “Umgui tungtang thu ah na heh mawk na hih dik hia?” a chi hi. Aman, “Sih ut hial a ka heh, ka hih dik hi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa’n , “Na gim pihlouh, na khansak leng hi samlou, zan khat thu a hongom a, zan khat thu a mang nawn umgui na hehpih leh;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ninevi khua, khopi thupitak, asung a mi nuai khat leh sing nih sang a tam, a taklam uleh a veilam uleng khen theiloute leh ganhon tampi omna, ka hehpih kei dia hia?” a chi hi.
  </para>
</usx>
