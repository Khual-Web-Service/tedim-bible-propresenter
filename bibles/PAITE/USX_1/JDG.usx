<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JDG" style="id">Vaihawmmite</book>
  <para style="h">Vaihawmmite</para>
  <para style="toc1">Vaihawmmite</para>
  <para style="toc2">Vaihawmmite</para>
  <para style="mt">Vaihawmmite</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Joshua sih nung in hichi ahi a, Israel suante’n, “Kanante dou a ei adia hon sualsak din kua a hohtou masa dia?” chi’n Toupa a dong uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa’n , “Judah vahoh hen. Ngai un, a khut ah gam ka peta,” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judah in a unau Simeon kiang ah, Kanante dou din ka gam tantuam ah hong paitou in. Keileng na gam tantuam ah ka hongpai sam ding, a chi hi. Huchi in Simeon a kiang ah a hohta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Judah a va hoh a; Kanante leh Perizte Toupa’n a khut uah a peta hi. Bezek khua ah mi sing khat a that uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Bezek khua ah Adonibezek a mu ua, a dou ua, Kanante leh Perizte a that uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh Adonibezek a tai a; a nungdelh ua, a man ua, a khutpi leh a khepi a tansak uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Adonibezek in, “Kumpipa sawmsagihte khutpi leh khepi ka tan khiaksakte’n ka dohkan nuai ah anneng a tawm uh. Ka hih banggeih a Pathian in honthuk eita ve” a chi hi. Jerusalem khua ah a pi ua, huai ah a sita hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Judah suante’n Jerusalem khua a dou ua, a la ua, namsau in a sual ua, a khopi a hal uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai nung in Judah suante tanggam simlam leh phaizang a teng Kanante dou din a kuansuk uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Judah in Kanante Hebron khua a tengte a vadou a, A ma in Hebron min Kiriath Arba ahi; Sesai, Ahiman leh Talmai a that uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai apan Debir khomite a dou uh, A ma in Debir khaw min Kiriath Sepher ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kaleb in, Kuapeuh Kiriath Sepher khua dou a, la peuhmah ka tanu Aksah a zi din ka pe ding, a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kaleb nau Kenaji tapa Othniel in a lazou a, a tanu Aksah a zi din a peta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Hichi ahi a, a kiang a vatun in gam ngen thei din a pa a kunzou hi. Sabiltung apan a kum khia a; Kaleb in a kiang ah, “Bang na deih a?” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman a kiang ah, “Hon vualzawl in. Simlam gam lah n’on peta ngal a, tuinak neite leng hon pelai in” a chi hi. Kaleb in tuinak nei tungnungte leh khangnungte a peta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mosi puzon Ken suante Arad simlam a om Judah gamdai ah Judah suante toh tum khopi apan a hohtou ua; mipite lak ah a va teng uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Judah bel a unau Simeon toh a kisa ua, Zephath khua a om Kanante a vathat ua, a hih chimit vek uhi. Huai khopi min Hormah chih ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Judah in Gaza khua leh a tuipiau, Askelon khua leh a tuipiau leh Ekron khua leh a tuipiau tan in a la hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa Judah kiang ah a om a; tanggam a tengte a delhkhia a; guam a tengte bel sik kangtalaite a neih ziak un a delhkhe zou kei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mosi in a na gensa bang in Hebron khua Kaleb a pia ua, aman huai apan Anak tapa thumte a delhkhia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin suante’n Jebuste, Jerusalem khua a tengte a delh khe kei ua, Jebuste Benjamin suante toh tunitan in Jerusalem ah a teng khawm uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Joseph inkuante leng Bethel khua dou din a kisa tou ua, a kiang uah Toupa a om hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Joseph inkuante’n Bethel khua ah enkhemite a sawl uhi. A ma in huai khaw min Luz ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Enkhemite’n mi khat khaw sung apan hong pawtkhia a mu ua, a kiang ah, Hehpih in khopi sung lutna hon ensak dihve, huchi in k’on hehpih ding uh, a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Khopi sung lutna a ensak a, namsau in huai khua a dou ua; huai mipa leh a inkuanpihte teng bel a hinghawi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai mipa Hitte gam ah a lut a, khua a sat a, huai khaw min Luz a sa a; tunitan in hiai min a pulai hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Manasseh in Beth shean khua leh a khopel a tengte, Taanak khua leh a khopel a tengte, Dor khua leh a khopel a tengte, Ibleam khua leh a khopel a tengte, Meggiddo khua leh a khopel a tengte a delhkhe kei hi. Kanante huai gam ah a teng uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hichi ahi a, Israel suante a honghat un Kanante a na sem ding un a omsak ua, a delhkhe siang vekkei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ephraim in Gezer khua a teng Kanante a delhkhe kei a; Kanante Gezer khua ah a lak uah a teng zawta uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Zebulun in Kitron khua a tengte leh Nahalol khua a tengte a delhkhe kei a; Kanante a lak uah a tengsam ua, a nasem ding un a om zawta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Asher in Akko khua a tengte, Zidon khua a tengte, Ahlab khua a tengte, Akjib khua a tengte, Helbah khua a tengte, Aphik khua a tengte leh Rehob khua a tengte a delhkhe kei hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Asher suante huai gam a teng Kanante lak ah a teng samta uhi; amau lah a delhkhe ngalkei ua.
  </para>
  <para style="p">
    <verse number="33" style="v" />Naphtali in Beth-shemesh khua a tengte, Beth-anath khua a tengte a delhkhe kei. Huai gam a teng Kanante lak ah a teng samta uhi. Beth-shemesh khua a tengte leh Beth-anath khua a tengte nasem din a omta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amorte’n Dan suante tang gam ah a hawltou ua; phaizang a a paisuk uh a phal ngalkei ua.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amorte Aijalon a Heres tang leh Shaalbim khua ah a teng ua, Joseph inkuante’n amau a zou ua, a nasem ding un a lak uah a teng uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amorte gam chiang Akrabbim tungkahna apan, suangpi apan leh Sela apan ahi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Toupa Angel khat Gilgal khua apan Bokim khua ah a hohtou hi. Aman, “Aigupta gam apan k’on pawtsak a, ‘na pipute uh kiang a kichiam a ka na chiamsa gam ah k’on pilut a, nou toh ka thukhun ka bohse kei hial ding.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiai gam a tengte toh thukhung kei unla; a maitamte uh hih chip sak un’ ka chi hi. Himahleh ka thupiak na zuikei ua, bangziak in ahia hiai na hih uh?
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in, Amaute k’on delhkhiak sak nawn kei dia, na pang uah lingte ahi zawta ding ua, a pathiante uh nou adin thang ahi ding uh” ka chi ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichi ahi a, Toupa angel in Israel suan tengteng kiang a hiai thu a gen leh mipite aw suah hial in a kap uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huai mun min Bokim a sa ua; huai ah Toupa kiang ah a kithoihnate a lan uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Joshua in mipite a kikhenzak sak nung in Israel suante michih amau tantuam gam chiat luah din a paita uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Joshua damsung leh upate Joshua kheng a dam teng, Toupa’n Israelte adia thil thupi a hih tengteng mu mite damsung in mipite’n Toupa na a sem uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nun tapa Joshua, Toupa sikha kum za leh sawm a upa a hih in a sita hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gaash tang mallam pang Ephraim tang gam a amah tantuam gamgi sung Timnath Heres khua ah a vui uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah khang a mi teng leng a pipute uh kiang ah a paikhawmta uhi. Amaute nung in Toupa leh Israelte adia a thilhihte theilou suan dang a hong omta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Israel suante’n Toupa mitmuh in thil gilou a hih ua, Baal na a sem uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toupa , a pipute uh Pathian, Aigupta gam apan pikhepa a lehngatsan ua, pathian dangte, a kim ua tengte pathiante a zui ua, a bia ua, Toupa a heh sakta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa a lehngatsan ua, Baal leh Astoreth na a sem uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toupa Israelte tung ah a hehta a, amau doumite khut ah a pia a, a melma uh, a kim ua tengte kiang ah a khong a, a melmate uh a zouta kei uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Koipeuh ah hoh mahle uh Toupa khut a tung uah a selam in a ke zel a, Toupa’n a kiang ua kichiam a a gensa bang in. Huchi in buai namai in a buaita kei uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh Toupa’n vaihawmmite a bawlsak a, huaite’n amau doumite khut apan a honkheta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchipi in leng a vaihawmmite uh thu a ngaikhe kei ua, pathian dangte kiang a angkawm in amaute a be zawta ua, a pipute un Toupa thupiakte pom a a zuih uh lampi pen a pialsan pah maimah uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa’n vaihawmmite a bawlsak chiang in, vaihawmmi kiang ah Toupa a om a, vaihawmmite damsung in a melmate uh khut apan a honkhe zel hi. Amau nuaisiahmite leh hih lungkhammite ziak a a mauna un, Toupa a kisik sak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh hichi ahi a, vaihawmmi a sih khit chiang in, a nungtolh ua, pathian dangte zui a, a na uh a sep uah a pipute uh sang mah in a gamta se zawsem ua; a thilhihte uh leh a paupengna uh leng a tawpsan tuankei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israelte tung ah Toupa a hehta a; “Hiai namte’n a pipute uh thu ka piak, ka thukhun a bohsia ua, ka thu lah a ngaikhe kei ua;
  </para>
  <para style="p">
    <verse number="21" style="v" />Huaiziak in tuban Joshua sih ma a delhkhiak louh namte ka delhkhiak sak nawn kei ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />A pipute uh zuih bang a Toupa dan zuih ding leh ding louh uh Israelte ze-etna din amau ka zang ding” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in Toupa’n huai namte delhkhe pahlou in a om sakta a; Joshua khut ah leng a pekhe kei hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kanan gam a galdou kha nai hetlou Israelte ze-etna din Toupa’n hiai namte a nusia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A tup bel Israel suante, tuma a galdou dan thei nai het loute galdou dan sinsak a hihna ding lel ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaite bel Philistiate kumpipa ngate, Kananmi tengte, Sidonte leh Lebanon tang a teng Hivte ahi ua, Baal Hermon tang apan Hamath khaw lutna pha in ahi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa’n Mosi zang a a pipute uh thu a na piakte a zuih ding uh leh zuih louh ding uh theihna din, huaite Israelte ze-etna ding ahi uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel suante Kanante, Hitte, Amorte, Perizte, Hivte leh Jebuste lak ah a teng uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A tanute uh zi in a nei ua, a tanute uh a tapate uh zi in a pia ua, a pathiante uh na a sem uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel suante’n Toupa mitmuh in thil gilou a hih ua, Toupa a Pathian uh a mangngilh ua, Baal leh Astoreth na a sem uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Toupa Israelte tung ah a hehta a, Mesopotamia gam kumpipa Kushan Risathaim kiang ah a zuakta hi. Huchi in Israel suante’n Kushan Risathaim na kum giat a sem uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Israel suante’n Toupa a sap tak un, Toupa’n Israel suante hunkhepa a bawlsak a, huai mi in amau a hunkheta hi. Huai mi bel Kaleb naupa Kenaz tapa Othniel ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa kha amah tung ah a hongtung a, Israel tung ah vai a hawm hi. Aman Mesopotamia gam kumpipa Kushan Risathaim a va dou a, Toupa’n Kushan Risathaim a khut ah a pia a, a zouta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in kum sawmli gam galmuang in a omta a, huchi in Kenaz tapa Othniel a sita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel suante’n Toupa mitmuh in thil gilou a hih nawn uh. Toupa mitmuh a thil a hihkhelh ziak un Toupa’n Moab kumpipa Eglon Israelte tung ah a hatsak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman Ammon leh Amalek suante a kaikhawm a; Israelte a va dou a, tum khopi a luahta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Israelte Moab kumpipa Eglon thunuai ah kum sawmlehgiat a om uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh Israel suante’n Toupa a sap tak un, Toupa’n Gera tapa Ehud, Benjamin mi, mi veilong, hunkhepa a bawlsak hi. Israel suante’n Moab kumpipa piak ding kipahman Ehud a tawisak uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ehud in namsau hiam tuah tongtan a sau in a sek a; puan nuai ah a taklam pheipi ah a henbelh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Moab kumpipa Eglon kipahman a va pia a; Eglon bel mi thau tak ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kipahman a vapiak khit in, kipahman tawite a paisak nawn hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah bel Gilgal khaw kiang a suangsekna mun apan a nungkik nawn a, “I aw, kumpipa, honhilh ding thuguk ka nei hi” a chi hi. Aman, “Dai un,” a chi hi. Huchi in a kiang a ding teng in a pawt khiaksan vek uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ehud in a kiang a va naih a; amah bel a nipi dantan ah amah kia in a na tu hi. Ehud in, “Pathian in na kiang a gen ding thu a hon thukhak hi” a chi hi. A tutphaha kipan amah a hong ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ehud in a khut veilam in a pheipi taklam a namsau a doka, a gil ah a dawt hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A namsau bul tan in a tuma, a thau in namsau a hubita, a gilpi apan namsau a dokkhe kei a, a ek a tolhkhia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in Ehud inlim ah a pawt a, dantan kongkhakte a khakkhum a, a kalh bikbek hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A pawt khitnung in, a sikhate a hongpai ua, a va et tak un ngai in, dantan kongkhakte a na kikalh hi. “A nipi dantan ah a tuam omtadih a hi’n teh” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zumhuai tan khop in a ngak nilouh ua, ngai in, dantan kongkhakte a hong himhim kei a; huchi in tahbi a la ua, a hong ua; ngai in, a kumpipa uh pialkhang ah sisa in a na puk hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ehud lah huchi a a ngak nilouh sung un a na taimang khina, huai suangsekna mun a khenga, Seirah ah a tailut hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hichi ahi a, huai mun a tun in Ephraim tanggam ah pengkul a muta, Israel suante tanggam apan a kiang ah a paisuk ua, aman a ma uh a kaita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman a kiang uah, Honzui dih ua. Toupa’n na melma uh Moabte hon pekhinta ahi, a chi hi. Huchi in a zuisuk ua, Moab gam chin Jordan lui kannate a la ua; kuamah a galkah uh a phalkei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huai hun in Moabte sing khat mi hat ngenta leh mi hat hangsan hoih ngenta a that ua; khatlel leng taikhia a omkei uh.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in huai ni’n Moabte Israelte lak ah a zahlak uhi. Huchi in, gam kum sawmgiat sung galmuang in a om hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A nung in Anath tapa Shamgar a hong kilanga, huai mi’n Philistiate za guk bawng sutna chiang in a sunluma; Israelte a hunkhia hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ehud sih nung in Israel suante’n Toupa mitmuh in thil gilou a hih nawn uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in Hazor a vaihawmpa, huai Kanan gam kumpipa Jabin kiang ah Toupa’n a khawngta hi. Huai mi sepaih heutupen bel Sisera ahi a, Jentelte gam Haroseth khua ah a teng hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Israel suante’n Toupa a sam uh. Huai min kangtalai za kua tak a nei a, kum sawmnih sung Israel suante nakpitak in a nuaisiah hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huailai in zawlnei Deborah, Lapidoth zi in Israelte tung ah vai a hawm hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ephraim tanggam a Ramah leh Bethel khaw kikal a tumsing nuai ah Deborah a teng hi. Israel suante a kiang ah a vai uh hawmsak din a honghoh zel uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kedesh Naphtali gam apan Abinoam tapa Barak a thukhak a, a kiang ah, “Toupa, Israelte Pathian in, Tabor kiang ah hohtou inla, Naphtali suante leh Zebulun suante mi sing khat pi in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Kison lui ah Jabin sepaih heutu Sisera, a kangtalaite leh a mipite toh k’on sawl ding; amah nang k’on pe ding, chi in thu a honpia ahi kei maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Barak in a kiang ah, “Hon tonpih lechin ka hoh ding. N’on tonpih kei ding leh ka hohkei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman, “K’on tonpih tham ding. Himahleh na hohna a minhoih lohlou ding na hi. Toupa’n Sisera numei kiang ah a khong ding hi” a chi hi. Huchi in Deborah a thou a, Barak toh Kedesh khua ah a hohta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Barak in Zebulunte leh Naphtalite Kedesh ah a thukhak khawm a; mi sing khat amah toh a hohtou ua; Deborah leng a kiang uah a hohtou sam hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ken mi Heber bel Mosi puzon Hobab suante lak apan a na om tuam a, Kadesh kiang a Zaanaim gam a tawsaw sing mun ah a puanin a vakai hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Abinoam tapa Barak bel Tabor tang ah a hohtou chih Sisera a hilh uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in Sisera in a kangtalai tengteng, sik kangtalai za kua leh a heute Jentelte gam Haroseth khua apan, Kison lui ah a kaikhawm hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Deborah in Barak kiang ah, “Khai le, tuni Toupa’n Sisera a honpiak ni ahi. Na makaipa Toupa ahi ka hia?” a chi hi. Huchi in Barak Tabor tang apan a paisuk a, mi sing khat in a zuisuk uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa’n Sisera leh a kangtalai tengteng leh a sepaih tengteng namsau in Barak ma ah a hihbuai gawpta a; Sisera a kangtalai apan a kumkhia a, a khe in a taimang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Barak in bel kangtalaite leh sepaihte Jentel gam Haroseth pha in a delh hi. Huchi in Sisera sepaih tengteng namsau in a that vek a; khat lel leng a hinghawi kei uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sisera bel Ken mi Heber zi Jael puanin ah khe in a tailut hi. Hozor Kumpipa Jabin leh Ken mi Heber inkuante kikal ah lemna a om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jael bel Sisera dawn din a hongpawt a, a kiang ah, “Pu, honglut in, ka kiang ah honglut in; lau ken” a chi hi. Huchi in puanin sung ah a kiang ah a lutta a, aman puan in a khuh hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kiang ah, “Hehpih in tui tawmchik honpe dihve, ka dang a tak mahmah hi” a chi hi. Aman bawngnawi khuainulhai a hong a, a dawnsak a, a khuhkhum nawn hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A kiang ah, “Puanin kongpi ah ding inla, huchi in, ‘Hiai ah mi a om hia?’ chi a hondot uleh, ‘omlou’ na chizel in” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Heber zi Jael in puanin khetkilhna a la a, sek a tawi a, awlchikin a khe a suanpheia, khetkilhna in a haizek ah a khen paisuak a, lei toh a kilhbelh hi. Bah in a ihmut a lim mahmah ngal a; huchi in a sita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai in, Barak in Sisera a hondelh a, amah tuak din Jael a vapawt a, a kiang ah, “Hongpai in, na mi zon k’on ensak ding,” a chi hi. Huchi in a kiang ah a vahoh a; ngai in, Sisera a na sita mai a, puanin khetkilhna a haizek ah a na tal hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in Pathian in huai ni’n Israel suante ma ah Kanan gam kumpipa Jabin a nuaisiah hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kanan kumpipa Jabin a nuaisiah masiah uh Israel suante a hat semsem uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai ni’n Deborah leh Abinoam tapa Barak in hiai la a sa uhi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Israel a makaite’n a makaih lai un, amau utthu a mite’n a zuihlai un, Toupa phat un!
  </para>
  <para style="p">
    <verse number="3" style="v" />“Aw, nou kumpipate aw, ngaikhia un. Aw, nou heutute aw, bil na doh un. Kei mahmah in Toupa pahtawi in la ka sa dia, Toupa , Israelte Pathian phat in la ka sa ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“ Toupa , Seir gam apan na hong paikhiak a, Edom pawn a na hongpawt in, lei a ling a, van a hong kia a, meipi’n vuah a zusak uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tangte Toupa ma ah a chim ua, Toupa , Israelte Pathian ma ah Sinai tang mah leng.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Anath tapa Samgar damlai nite leh Jael damlai nite in lamliante totlouh in a om ua, zin leh lengte lah lam neute ah a pai uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Israel gamte a tulkhin a, a khuate luahlouh in a tul khin hi, kei Deborah ka gamtang a, Israel gam nu ka gamtat masiah.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amau pathian thakte a tel ua; huchi in kulh kongkhak bul ah kidouna a om a; Israel gam a mi sing li lak ah lum leh tei muh in a om hia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka lungsim Israelte vaihawmpa, mipite lak a lungluttak a kipiate lam ah a om hi. Toupa phat un.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Pau un, nou sabiltung kang tung a tuangte, nou vaihawmna a tute leh lampi a paite.
  </para>
  <para style="p">
    <verse number="11" style="v" />Thal kapmite husa zak phaklouh, tui tawina mun ah Toupa thildik hihte a gengen ua, Israel gam tung a thildik a hihte ngei. “Huchi in Toupa mipite kulh kongkhakte lam ah a paisuk ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Thou in, thou in, Deborah; thou in, thou in, lasa in. Thou in, Barak, thou inla, Abinoam tapa, na salmatte pi in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in mi omlaite mipite lak a miliante tung ah thu a neisak a, Toupa’n mihat tung ah thu hon neisak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ephraim apan a zungzam khat Amalek dou a om a, Benjamin, na mite lak a mite’n nang a honzui uh, Makir apan gam vaihawmmite a hong paisuk ua, Zebulun apan Laigelhmi chiang tawimite a hong paisuk uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Issakar miliante Deborah kiang ah a om ua; Issakar leh Barak mah leng. Amah guam lam a sawlsuk ahi a, Reuben pawlte ahihleh Nakpitak in a kingaihtuah lai uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Bangdia belam huang lak a tu nilouh, Belamhon ham ngai ding lel a? Reuben pawlte adin lungtang a Kingaihtuahna thupitak a om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gileadte Jordan gal ah a om nilouh ua; bangdia Dante longte a om nilouh uh ahia? Asherte tuipi piau ah a tu kinken ua, a tuipiaute ah a om nilouh uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Zebulun leh Naphtali pawn munsang a sihngap gigete ahi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Kumpipate’n a hong dou ua, Kanan kumpipate’n Meggiddo tui kiang, Taanak khua ah a dou ua: sum himhim a lakei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Van apan a hondou ua; Aksite’n a mun ua kipan Sisera a hondou uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kison lui in amaute a taimang a, nidanglai lui, Kison lui in, Aw ka kha, hattak in pai zel in.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Huchi in sakolte a kipek thotthot ua, sakol hatte a tawmtawm ziak un.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Meroji hamsiat un,” Toupa Angel in a chi, huai a tengte nakpitak in hamsiat un. Toupa panpih ding, Toupa’n mi hattak a douna panpih dia a honglouh ziak un.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Numei lak ah Jael, Ken mi Heber zi nuamsapen ahi, numei puanin a tengte lak ah amah mi nuamsapen ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tui a hong ngen a, aman nawitui a pia hi: nou hoih in nawitui dat a na pia hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kilhna a tawi a, a taklam in nasemmi sek; sek in Sisera a khen a, a lu ah a khen pailet a, ahi, a haizek ah a khen a, a khen tal vengvong hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A khe bul ah a kuna, a puk a, a luma; a khe bul ah a kuna, a pukta a; a pukna mun ah a sita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Sisera nu bel tawlet ah a dak a, vathangkalh awng ah a sam a, Bang achia kangtalai hong tunghak ahia? Bang achia a kangtalai khe zekai ahia? a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A numei pilte’n a na dawng ua, ahi, amah dawng din hong nawn ua:
  </para>
  <para style="p">
    <verse number="30" style="v" />“A mu zouta kei ua hia? Gallak kihawmta lou uhia? Michih in nungak khat hiam nih chiat; Sisera tan ding gallak puan ze tuamtuam, gallak puan ze kilawm, ze tuamtuam, gallak ngawng a velh ding puan, a langnih a ze kilawm, ze tuamtuam,” chi in.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Huchibang in aw, Toupa , na melmate tengteng mangthang vek uhen. Amah itte bel hattak a pai, nisa bang hi uhen” a chi uhi. Huchi in gam kum sawmli sung galmuang in a om hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Israel suante’n Toupa mitmuh in thil a hih khialta uh. Huchi in Toupa’n Midiante khut ah kum sagih sung a pekhia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Midiante’n Israelte a zouta ua; huchi in Midiante ziak in tang ah kawkhukte, kawhawm leh kulhte a bawl uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hichi ahi a, Israelte’n haichi a chinkhit un Midiante, Amalekte leh suahlam tate a hong kuan ua; a va dou ua,
  </para>
  <para style="p">
    <verse number="4" style="v" />Panmun a va khoh ua, Gaza tan in lei a thilpoute a hihsiat sak ua, Israel gam ah nekding himhim a hawi kei ua, belam, bawng leh sabiltung tan in a hihse vek uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A ganhonte uh leh a puaninte utoh a hong kuan ua, khaupe bang in tampi a hong kuan ua; amaute leh a sangawngsaute uh simseng ahi kei a, gam hihse dia hong kuan ahi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Israelte Midiante ziak in a genthei mahmahta ua; Israel suante’n Toupa a samta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hichi ahi a, Midiante ziak a Israel suante’n Toupa a sap tak un, Toupa’n Israel suante kiang ah zawlnei khat a sawl a; aman a kiang uah, “ Toupa , Israelte Pathian in, hichi in a chi.
  </para>
  <para style="p">
    <verse number="8" style="v" />‘Aigupta gam apan k’on pitou a, saltanna inn apan k’on pikhia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aiguptate khut apan leh nou hon nuaisiah mi teng khut apan k’on hunkhia a, na ma uah amaute ka delhkhia a, a gam uh nou k’on pia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei Toupa na Pathian uh ka hi, A gam ua na tenna uh Amorte pathiante na lau ding uh ahi kei, ka chi hi’. Himahleh ka thugen na zuikei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa angel khat a hong a, Ophrah khua a Abiezerte mi Joash tawsaw sing nuai ah a tu hi. A tapa Gideon in Midiante muhlouh din grep sukna khuk ah buh a na vua hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toupa angel a kiang ah a hong kilak a, a kiang ah, “Nang mihat hangsan, Toupa na kiang ah a om hi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gideon in a kiang ah, “Aw ka toupa, Toupa ka kiang ua om ahihleh bangchidan a hichibang a ka tung ua hiai thilte hongtung ahia? Ka pipute un, Toupa’n Aigupta gam apan hon pitou hilou hia? chi a, a thilhih lamdang a hon hilhte uh koilam a bang chikhinta ahia? Tun zaw, Toupa’n hon pampaih ahita a, Midiante khut a hon peta eive” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Toupa’n , amah a en a, a kiang ah, “Hiai na hatna in kuan in, Midiante apan Israelte hunkhia in. K’on sawl ahi kei maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman a kiang ah, “Aw Toupa , bangchi’n ahia Israelte ka va hutkhiat mahmah ding? Ngai in, Manasseh suan lak a inkuan hatlou pen ka hi ua, kei lah ka pa inkawte lak a neupen ka hi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n , a kiang ah, “Na kiang ah ka om ngeingei ding hi, huchi in Midiante mi khat lel bang in na zou vek ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman a kiang ah, “Na mittung ka hihleh, nang mahmah in n’on pi chih chiamtehna banghiam hon musak in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na ma a lat ding thilpiak ka va lak a, na kiang a ka hong nawn masiah hiai apan hehpih in nana paimang ken” a chi hi. Aman, “Na hong nawn masiah ka na om gige ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gideon inn sung ah a lut a, kel nou leh tangbuang ephah khat silngou sohlouh a bawl a; a sa seng ah a koih a, huai gel tui bel ah a koih a, tawsaw sing nuai ah a kiang a hontawi in a honglan hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathian angel in a kiang ah, “Sa leh tanghou silngou sohlouh la inla, hiai suang tung ah koih inla, a tui pen sungkhia in” a chi hi. Huchibang in aman a hihta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Toupa angel in a chiangtawi muk in sa leh tanghou silngou sohlouh a khoih a; suang apan mei a hongpawta, sa leh tanghou silngou sohlouh a kangtum vek hi. Toupa angel muhtheihlouh in a paita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in Gideon in “ Toupa angel ahi chih a theita hi. Gideon in, Maizen, Aw Toupa Pathian, Toupa angel kimaituah a mu ka kei maw” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n a kiang ah, “Lungmuangtakin om inla, lau ken. Na si kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in Gideon in huai ah Toupa adin maitam a doh a, Jehovah Shalom a sa hi. Tunitan in Abi ezerte Ophrah ah a omlai hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichi ahi a, huai zan mah in Toupa’n a kiang ah, “Na pa bawngtal tuai, bawngtal nihna kum sagih a upa la inla, na pa neih Baal maitam hihchim inla, a bul a sing a bawl Aserah phuk in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiai suangpi tung ah zeneitakin Toupa na Pathian adin maitam bawl inla, bawngtal nihna la inla, na phuk ding Aserah sing zang in haltum thillat lan in” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in Gideon in a sikhate lak a mi sawm a pi a, Toupa’n a kiang a a gen bang in a hihta hi. Hichi ahi a, a pa inkawte leh khopi a mite a lauh ziak in, sunlai in a hih ngam kei a, zanlai in a hihta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Khopi a mite zingkhanga, a thoh uleh ngai in, Baal maitam hihchip in a na om a, a bul a Ashera phukpaih in a na om a, maitam tung ah bawngtal nihna lat in a na om hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Hiai kua hih ahia?” chi in a kihou ua, a kidong tuahua, a zon khit un, “Joash tapa Gideon in hiai thil a hih a na hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in khopi a mite’n Joash kiang ah, Na tapa vapikhia in, a sih ngeingei ding ahi. Baal maitam a hihchip ziak leh a bul a Aserah a phuk ziak in, a chi uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Joash in amah hong kalh teng kiang ah, Baal gum ding na hi u maw? Aman hon hondam ding hia? Kuapeuh amah gum zingsang mahmah a thah ding ahi. Pathian khat ahihleh a maitam a hihchip ziak in, kigum leh a kei dia, a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huaiziak in, huai ni’n amah Jerubbaal a sa uhi, a maitam hihchip a hih ziak in “Baal in amah kalh heh,” a chi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in Midian tengteng leh Amalekte leh suahlam tate a kikhawm ua; lui a kan ua, Jezreel guam ah a kikulh uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Himahleh, Toupa Kha Gideon tung ah a hongtung a; pengkul a muta; huchi in Abi ezerte’n amah a gum uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Manasseh tengteng kiang ah mi a taisak a; huaite’n leng a naih khawm uh. Asherte, Zebulunte leh Naphtali teng kiang ah leng mite a taisak a; amau leng a behlap touta uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Gideon in Pathian kiang ah, “Na gen bang a ka khut a Israelte na hutkhiat ding leh,
  </para>
  <para style="p">
    <verse number="37" style="v" />Ngai in, buhphual ah belam mul ka koih dia, belam mul tung kia a daitui a na om a, lei tengteng a na hulvek leh, na gen bang in ka khut in Israelte na hunkhe ding, chih ka thei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchibang a honghi a, a zing zingsangpi a thou a, belam mul a suk leh belkuang dim tui a takkhia hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Gideon in Pathian kiang ah, “Ka tung ah heh ken, khatvei kia k’on gen nawn ding. Hehpih in, khatvei kia belam mul in hon ze-et sak nawn in. Tutung in ahihleh belam mul kia hul henla, leitung tengteng ah daitui om nawn leuleu hen, a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchibang in Pathian in huai zan in a hih a; belam mul kia a na hul a, leitung tengteng ah daitui a na om leuleu hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Jerubbaal, huai bel Gideon ahi a, leh a kiang a om mi tengteng zingkhang in a thou ua, Harod tuikhuk chin ah a kikulh uh. Midiante bel mallam pang Moreh tangbul guam ah a kikulh uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa’n Gideon kiang ah, “Na kiang a om mite, Midiante a khut ua ka piakna din a tam lua uhi. Huchilou in zaw Israelte’n, ‘ei khut ngei a kihunkhia i hi uh,’ chi in a hon otkhum kha ding uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in, ngai in, mite zak in, ‘Kuapeuh lau leh ling a om leh kiknawn henla,’ Gilead tang apan pai kiknawn hen, chi in, genkhia in” a chi hi. Huchi in mite sing nih leh sang nih a kiknawn ua; sing khat a omlai uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa’n Gideon kiang ah, “Mite a tam law lai uh. Lui ah pisuk inla, huai ah ken k’on khensak ding. Hichi ahi ding a, Hiai mi zaw na kiang ah paiheh, ka chih peuhmah na kiang ah pai hen. Hiai mi zaw na kiang ah pai kei heh, ka chih peuhmah pai kei hen” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in mite lui ah a pisuk a, Toupa’n Gideon kiang ah, “Ui bang a, a lei a tui liah thoh peuhmah a tuam in koih inla, huchi mah bang in kun a khukdin a tuihip thoh peuhmah leng” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A khut pek a liahthohte mi za thum ahi ua, midang tengteng kun a khukdin a tuihip vek ahi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Toupa’n Gideon kiang ah, “Mi za thum, a liah a liah thohte zang in k’on hunkhe ding. Midiante na khut ah ka honpe ding hi. Mipi teng amau mun chiat ah pai nawn uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in mite’n nekding leh a pengkulte uh a tawi ua; Israel mi tengteng a puanin lam uah a paisak vek a, mi za thumte bel a omsak a, Midiante kulh bel a nuai phaizang ah a om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hichi ahi a, huai zan in Toupa’n a kiang ah, “Thou inla, kulh ah va hohsuk dihve; na khut ah k’on peta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh hohsuk na lauh leh na sikha Purah toh kulh ah va hohsuk phot un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in a thugen uh na za dia; huaikhit chiang in na khut hihhat in a om dia, kulh ah na hoh ngamta ding” a chi hi. Huchi in a sikha Purah toh kulh a galvengte tuah masak napen omna ah a hohsuk uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Midiante, Amalekte leh suahlam tapate tengteng huai phaizang ah khaupehon bang in tampi a na om ua; a sangawngsaute uh simseng vuallouh, a tamlam uh lah tuipi piau a piaunel zah mahmah ahi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Gideon a tunsuk in, ngai in, mi khat in a lawmpa a mang a na hilh a, a kiang ah, “Ngai in, mang ka nei a, barli buh tanghou phel Midiante kulh ah a na om a, puanin ah a na tuklut a, a hon hihchim a, a hih lumlet a, puanin a kiphah maimah” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A lawmpa’n a dawng a, “Huai ahihleh Israelmi, Joash tapa Gideon namsau lou bang dang hi kei e. Pathian in Midiante leh sepaih tengteng a khut a pia ahi ve” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hichi ahi a, Gideon in huai mang leh a lehkhiakna a ki hilhchian uh a zak in Pathian a beta hi. Huchi in Israelte kulh lam ah a kiknawn a, “Thou dih uh; Toupa’n Midian sepaihte na khut uah a hon peta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in mi za thumte pawl thum in a khen a, avek un pengkul leh leibel vuak, asung a meisel koihsa a pe chiat hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman a kiang uah, “Hon en unla, ka hih bang in hih sam un. Ngai un, kulh tuah masakpen ka tun chiang a ka hih bang a na hih sam ding uh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kei leh ka kiang a om tengteng in pengkul k’on mut chiang un, kulh kimvel a om tengteng in pengkul na mutsam ding uhi, ’ Toupa ading leh Gideon ading in’ na chi chiat ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in Gideon leh a kiang a om mi zate’n zanven laizang, galven a kikhen kuan laitak in kulh tuah masak a tungsuk ua, pengkul a mut ua, a leibel tawi uh a tatkham uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pawl thumte’n pengkul a mut ua, leibelte a tatkham ua, a khut veilam un meisel a tawi ua, a taklam un pengkul mut ding a tawi uhi. “ Toupa leh Gideon namsau” chi in a kikou uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kulh kim ah michih amau panmun chiat ah ading vek ua; huchi in sepaih tengteng a tai ua; a kikou ua, a taikek uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi za thumte’n pengkulte a mut ua, Toupa’n sepaih tengteng amau leh amau namsau in a kisualsak a, huchi in sepaihte Zazerah a Bethshittah, Tabath kiang a Abel meholah gamgi pha in a taikek uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israelte Naphtali, Asher leh Manasseh tengteng apan kigawm khawm in Midiante a nungdelhta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gideon in Ephraim tanggam tengteng ah, Midiante hongsual un, Bethbarah tan in luite na lakkhalh un, Jordan lui toh, chi’n mite a vial taisak a, huchi in Ephraim tengteng a kikhawm ua, Bethbarah tan in luite Jordan lui toh a na lak khalh vek uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Midian kumpipa Oreb leh Zeeb a man ua; Oreb suangpi ah a that ua, Zeeb pen Zeeb grep sukna khuk ah a that uhi. Midiante a delhta ua, huchi in Oreb leh Zeeb lutang Jordan luigal a Gideon kiang ah a hontun uhi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Ephraimte’n a kiang ah, “Bangziak a hichibang a honbawl e, Midiante na douna ua na honchial samlouh?” a chi uhi. Huchi in nakpitak in amah a tai uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman a kiang uah, “Nou toh genkak di ken bang ka hih zou a eita? Abi-ezerte grep loh sang a Ephraimte grep loh hoihzaw hilou maw?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in Midiante kumpipa Oreb leh Zeeb na khut uah a hon peta hi. Huchi in nou toh genkak din ken bang ka hih zou a eita?” a chi hi. Huchi in huai thu a gen tak in a tung a a hehna uh a daita hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Gideon leh a kiang a om mi za thumte’n Jordan lui a phasuk ua, a kan ua, bah mahle uh a delh teitei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sukoth khua a mite kiang ah, “Hehpih in kei honzuite sangpek pedih ua; a bah mahmahta uh. Midiante kumpipa Zebah leh Zalmunna delh ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sukoth khua a miliante’n, “Zebah leh Zalmunna na khut a omkhinta uhia, huchi a na sepaihte tanghou ka piak pahmai ding uh? a chi uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gideon in hiai ziak in, ” Toupa’n Zebah leh Zalmunna ka khut a a honpiak chiang in gamdai a ling leh loulingneite in na sa uh ka kuikek ding” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai apan Penuel ah a hohtou ua, a kiang uah huchi mah bang in a gen nawn hi. Penuel khua a mite’n Sukoth khua a mite dawn mah bang in a dawng uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Penuel khomite kiang ah, “Vualzou a ka hong kiknawn chiang in, hiai kulh ka hihchim ding” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Zebah leh Zalmunna bel Karkor ah a om ua, a sepaihte leh suahlam tate sepaihte a sibang teng, sing khat leh sang nga toh. Namsau dokmi nuai khat leh sing nih lah a sikhinta ngal ua.
  </para>
  <para style="p">
    <verse number="11" style="v" />Gideon bel Nob leh Jogbeh suahlam a puanin a tengte lampi ah a hohtou a, sepaihte a vadou a; sepaihte galmuangtak in a na om ngal uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zebah leh Zalmunna a taikekta ua; amau a delh ua; huchi in Midiante kumpipa nih Zebah leh Zalmunna a man ua, sepaihte tengteng a hihbuai gawpta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Joash tapa Gideon bel kidouna apan nisuah ma in a hong kiknawnta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sukoth khua ah tangval khat a man ua, thu a dong uh. Huchi in Sukoth khua a milante leh upate min a gelhsak vek a, sawmsagih leh sagih ahi uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sukoth khua a mite kiang ah a hohtou a, “Zebah leh Zalmunna en dih ve ua, hiaite a kei ua, Zebah leh Zalmunna na khut ua omsa bang a, mi bahte tanghou ka piak ding uh?” chi a n’on enghou uh, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in huai khua upate a man a, gamdai ling leh loulingneite in Sukoth mite a thuhilh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Penuel khaw kulh a hihchim a, khua a mite leng a that hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in Zebah leh Zalmunna kiang ah, “Tabor tang a na mi thahte uh mi bangchibang ahi ua? a chi hi. Amau, Nangmah bang ahi uh; Kumpipa tapate a bang chiat uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman, ka unaute ahi uh, ka nu tapate mahmah eive ua. Toupa a hin bang in, amaute na hinghawi le uchin zaw, nou hon thatlou mah ding hiveng in, a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A tapa upapen Jether kiang ah, “Khaile, nang amaute that in” a chi hi. Himahleh tangval in a namsau a phawikei; tangval lel ahihlai ziak in a lau hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Zebah leh Zalmunna in, “Nangmah hong kisa inla, hong satlum tanla. Piching leh piching kisual ding ahi” a chi uhi. Huchi in Gideon a thou a, Zebah leh Zalmunna that in, sangawngsaute ngawng zepnate a la hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in Israel mite’n Gideon kiang ah, “Nang ka tung uah vaihawm in, nang leh na tapa leh na tapa tapate tan in leng. Nang Midiante apan lah n’on hunkheta hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gideon in a kiang uah, “Ken zaw na tung uah vai ka hawm kei ding. Ka tapa in leng na tung uah vai a hawmsam kei ding. Toupa’n na tung uah vai a hawm zaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gideon in a kiang uah, “Thil khat ahihleh honnget ka ut, michih in na gallak bilbah uh, honpe chiat un, a chi hi, Ishmaelte a hih ziak un dangkaeng bilbah a nei uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amau, “Phaltakin k’on pe ding uh” a chi uh. Huchi in puan a phah ua, michih in a gallak bilbah uh a hon paikhe chiat uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai dangkaeng bilbah a ngette gikdan dangkaeng sekel sang khat leh za sagih ahi; hakkolte, bilbahte, Midian kumpipate puan sandup simlouh in, a sangawngsaute uh khainiang omte leng tellou in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Gideon in huaite in Ephod a bawl a, a omna Ophrah khua ah a koih hi. Israel tengteng in hiai thil ah ang a kawm uh. Huchi in Gideon leh a inkawte adin thang a hong hita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Midiante bel Israel suante nuaisiah in a om uh; a tangkhe zou nawn kei uh. Huchi in Gideon damsung kum sawmli sung in gam galmuang in a omta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Joash tapa Jerubbaal a pai a, a inn ah a tengta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Gideon in zi tampi a neih ziak in amah suan mahmah tapa sawmsagih a nei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sekem khua a a mei in tapa a suansak lai a, a min Abimelek a sa hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Joash tapa Gideon kha leh khuk tuah a dam in a sita a, Abiezer mi Ophrah khua a a pa Joash han ah a vui uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hichi ahi a, Gideon a sihphet in Israel suante a kinung hei ua, Baalte toh ang a kawm ua, Baal Berith pathian in a neita uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Israel suante’n a kim ua melmate tengteng lak apan amau hunkhepa Toupa a Pathian uh a theigige kei uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jerubbaal, Gideon mah, Israelte tung a theihtawp a hoih suahpa inkawte leng a hehpih kei uhi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Jerubbaal tapa Abimelek Sekem khua ah a nu sanggampate kiang ah a hoh a, a nu pa inkawte tengteng a houpih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Sekem khua a mi tengteng zak in thu gen unla, ‘Jerubbaal tapa tengteng mi sawm sagihte’n na tung ua vai a hawm uhia hoih na sak uh, mi khat in na tung ua vai a hawm uh?’ Gendih ua, keileng na guh uh leh na sa uh hi sam ka hi, chih theigige un” chi in a gen hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A nu sanggampate’n Sekem khua a mi tengteng zak in huai thu tengteng a gen uh. Huchi in Abimelek zuih utna lungsim a hon puta ua; “Amah i unau ahi” a chi ngal ua.
  </para>
  <para style="p">
    <verse number="4" style="v" />Baal Berith inn apan dangka sawmsagih a pia ua, huai in Abimelek in mingongtat leh mi ginalou pipi a guai a, amau amah a zui uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ophrah khua a a pa inn ah a va hoh a, Jerubbaal tapate, a unau sawmsagihte suang khat tung ah a that hi. Jerubbaal tapa naupangpen Jotham bel a na kibuk ziak in a that khakei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sekem khua a mi tengteng leh Bethmillo a mi tengteng a kikaikhawm ua, Sekem khua a suangphuh bul tawsaw kiang ah Abimelek kumpipa in a bawlta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiai Jotham a hilh uleh Gerizim tang ah a hohtou a, a vum ah a va ding a, aw ngaih tak in a kikou a, a kiang uah, “Nou Sekem khua a mite aw, ka thugen ngaikhia dih ua, huchi in Pathian mah in leng nou thu a hon ngaikhe sam ding hi:
  </para>
  <para style="p">
    <verse number="8" style="v" />Khatvei a tung ua kumpipa ding thaunilh din singte a kuan khia ua; Olive sing kiang ah, ‘Nang ka kumpipa hi in,’ a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh olive sing in a kiang uah, ‘Pathian leh mihing pahtawina dia a zat pen uh ka thau nusia in singte tung ah dopsang in ka om ding maw?’ a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Singte’n theipi kung kiang ah, ‘Kisa dih, nang ka kumpipa ding un hongom in,’ a va chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh theipi kung in a kiang uah, ‘Ka khumna leh ka gah hoih tak nusia in singte tung a dopsang in ka om ding maw?’ a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Singte’n grepgui kiang ah, ‘Kisa dih, nang ka kumpipa ding un om in aw?’ a chi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Grepgui in a kiang uah, ‘Pathian leh mihing kipaksak ka uain nusia in singte tung a dopsang in ka om ding maw?’ a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in sing tengteng in lingvom kiang ah, ‘Kisa in, nang ka kumpipa ding un om in,’ a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lingvom in singte kiang ah, ‘Na kumpipa ding ua thau honnilh taktak na hih uleh ka lim ah hong bu in hon muang un; huchi ahihkei leh ling apan mei hongpawt henla Lebanon tang a sidar singte kangkhin hen,’ a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Huaiziak in tuin, chihtak tak a Abimelek na kumpipa ua bawl na hih ua, Jerubbaal leh a inkawte hoihtak a bawl a, a kituahpih bang a, a tung a na hih ua;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka pa’n gal a hon dousak a, a na sihloh hialta a, Midiante khut apan in nou a hon hunkheta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tuni in ka pa inkawte tung ah na hel ua, a tapate sawmsagih tak suang khat tung ah na that ua, na unaupa uh a hih ziak in a sikhanu tapa Abimelek Sekem khomite kumpipa din lah na bawlta ngal ua.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuni a Jerubbaal leh a inkawte tung a chihtak tak a gamta na hih uleh, Abimelek tung ah kipak unla, amah leng na tung uah kipak hen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh huchibang ahihkeileh Abimelek apan mei hong kuang khia henla, Sekem khua a mite leh Bethmillo mite kangtum hen. Sekem khua a mite leh Bethmillo apan mei kuang hongpawt henla, Abimelek kangtum vek hen” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Jotham a tai a, a taimang a, Beer ah a tai a, a unaupa Abimelek a lauh ziak in huai ah a tengta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abimelek in Israelte tung ah kum thum vai a hawm hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian in Abimelek leh Sekem khua a mite kikal ah kha gilou a sawl hi. Huchi in Sekem khomite Abimelek tung ah lepchiahtak in a gamta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai ahihleh Jerubbaal tapa sawmsagihte tung a mulkimhuai tak a, a gamtat ziak a a tung a phulakna a hongtun theihna ding leh amaute thatpa a unaupa uh Abimelek tung a leh, a unaute that ding a amah a na panpih Sekemte tung a, a sisan uh a om theihna ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Sekem khua a mite’n mualvumte ah amah guktan mite a koih ua, huai mun a vapai peuhmah a na suam ua; huai thu Abimelek a hilh uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ebed tapa Gaal, a unaute toh a hong kuan ua, Sekem khua ah a lut ua; Sekemte’n a na muangmoh kei uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Lou lam ah a hoh ua, a grephuan ua grepte a lou ua, a chil ua, vualnuam a bawl ua, a pathian in uah a lut ua, ne a dawn in Abimelek a hamsiat uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ebed tapa Gaal in, “Eite’n a na uh i sep sak ding, Abimelek kua ahia? Sekem mah leng kua ahia? Jerubbaal tapa ahi kei maw? Zebul, a sepaih Makai hilou a maw? Sekem pa Hamor mite na sem ding maw? Bangziak in eita amah na i sep ding uh?
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiai mite ka khut nuai ah om le uh aw! Abimelek ka lakhe ding. Abimelek kiang ah, Na sepaihte pungsak inla, hong paikhia in” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai khaw vaihawmpa Zebul in Ebed tapa Gaal thugen a zak in, a heh tohthoh in a om hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in gitlouhpil in, Abimelek kiang ah, “Ngai in, Ebed tapa Gaal leh a unaute Sekem ah a hong uh. Ngai in, na tung a heltum in na khua a mite a hanthawn uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in na mite toh kisa unla, zan in pawn ah na tang un.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in hichi ahi ding a, zingsang a nisuahtakin, beltak in thou inla, khua hong dou mai in. Ngai in, amah leh a lawite’n nang hondou dek chiang un, hoih na sak dandan in a tung uah na hihmai ding hi” chi a hilh din mite a taisak hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in Abimelek leh a mi tengteng zan in a thou ua, pawl li a kikhen in Sekem khua a va umta uh.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ebed tapa Gaal a vapawt a, khopi lutna kongpi ah a va ding a, Abimelek leh a mite a guktanna ua kipan a hong kuanta uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Gaal in mipite a muh in Zebul kiang ah, “Ngai in, mualvum apan mipite a hong paisuk uh” a chi hi. Zebul in a kiang ah, “Mual lim mihing bang a mu lel hiteh” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Gaal in, “En tanla, gamlai tak ah mipi a hong paisuk uhi. Pawl khatte houh aisan siampa tawsaw sing lampi ah a hongpai uh” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchi in Zebul in a kiang ah, “Abimelek kua ahia, a na i sep ding pen uh? chi a na genna kam koi a omta ahia? Hiaite na mi muhsitte mah hilou umaw? Va pawtkhia inla, va dou in” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huchi in Gaal in Sekemte makai in Abimelek a va douta hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Abimelek in a na delh a, a taisia a, khopi tan in mi tampi liam in a puk uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Abimelek bel Arumah khua ah a teng hi. Zebul in Gaal leh a unaute Sekem khua a teng theilou din a delhkhe vek hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Hichi ahi a, a zing in mipite pawn ah a pawtkhia uh chih Abimelek a hilh uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Mipite a pi a, pawl thum in a khen a, pawn ah a guktan ua; a dak a, ngai in, mipite khopi apan a hong pawtkhia ua, huchi in amau a na sual ua, a thatta uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Abimelek leh a pawlte malam ah a tai ua, khopi lutna kongpi ah ading ua, pawl nihte’n pawn a omte tengteng a pumboh ua, a thatta uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Abimelek in khopi huai ni’n nitum in a sual a; huchi in khopi a la a, asung a mite a that a, khopi a hih sevek a; chitui in a theh hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Sekem kulh a omte tengteng in huai thu a naza ua, Berith pathian biakin sung bitna mun ah a tailut uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Sekem kulh a mi tengteng a omkhawm vek uh chih Abimelek a hilh uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />Abimelek leh a kiang a om tengteng Zalmon tang ah a hohtou uh. Abimelek in heipi a tawi a, sing hiang a satkhia a, a pua a, a kiang a om a mite kiang ah, “Ka hih dan na mu uh, ka hih bang in nou leng hih mengmeng un” a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Mi tengteng in sing hiang a satkhe chiat ua, Abimelek hih bang in a pua ua, in kulhpi kim ah a sekhawm ua, kulhpi sung a omte a hal khum uhi. Huchi in Sekem kulhpi sung a om tengteng a sivek ua, pasal leh numei teng sang khat vel ahi uh.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huchi in Abimelek bel Thebez khua ah a hoh a, Thebez khua a um a, a lata hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Himahleh huai khopi sung ah kulhpi kiptak a om a, huai ah pasal leh numei tengteng leh khopi sung a mi tengteng a tailut ua, a kikhak khum bikbek ua, kulh tung ah a omkhawm uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Abimelek bel kulhlam ah a hoh a, a vadou a, hal din kulh kongpi ah a hoh hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Numei kuahiam in buhgawizanna suang khat Abimelek lu tung ah a khesuk a, a luguh a kitam hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huchi in a galvan tawipa tangval a sampah a, a kiang ah, “Na namsau phawi inla, honthat mai in. Huchi a mite’n, ‘Numei thah ahi,’ ” a hon chihlouhna ding un” a chi hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Israelte’n Abimelek a si chih a theihtak un, a inlam chiat uah a paita uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Abimelek in a unau sawmsagih a thah leh a pa tung a giloutak a a tatsiatna Pathian in hiai bang in a thukta hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Sekem khomite gitlouhna tengteng Pathian in a thuk samta hi. Jerubbaal tapa Jotham hamsiat amau tung ah a hongtungta hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Abimelek sih nung in Israelte hunkhe din Issakar mi Tola a hong dingkhia hi. Amah Puah tapa ahi. Puah bel Dodo Tapa ahi. Amah Ephraim tang gam Shamir khua ah a teng hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kum sawmnih leh thum sung Israelte tung ah vai a hawm a, huchi in a sita a, Shamir khua ah a vui uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai nung in Gilead mi Jair a hong dingkhia a, kum sawmnih leh nih sung Israelte tung ah vai a hawm hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman sabiltung nou tung a tuang tapa sawmthum a neia, amau Gilead gam ah khua sawmthum a nei ua, huaite tunitan in Havothjair a chilai uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jair a si a, Kamon khua ah a vui uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel suante’n Toupa mitmuh in thil gilou hih nawn in Baal leh Ashtaroth, Suriate pathian, Zidonte pathian, Moabte pathian, Ammon suante pathian leh Philistiate pathian na a sem uhi. Huchi in Toupa a lehngatsan ua, Amah na a semta kei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Toupa Israelte tung ah a hehta mahmah a, Philistiate leh Ammon suante kiang ah amaute a khawngta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai kum in amau Israel suante hihbuai in a nuaisiah uhi. Jordan gal Gilead gam a Amorte gam a Israel suan om tengteng kum sawmlehgiat sung a nuaisiah uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ammon suante bel Judahte, Benjaminte, Ephraim inkawte dou din Jordan a galkah ua; huchi in Israelte a lungzing mahmah uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Israel suante’n, “I Pathian in Baalte na i nasep ziak un hon lehngat santa hi, a tung ah thil i hihkhialta uhi” chi’n Toupa a sam uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa’n Israel suante kiang ah, “Aiguptate apan, Amorte apan, Ammon suante apan leh Philistiate apan noute k’on hunkhe kei maw?”
  </para>
  <para style="p">
    <verse number="12" style="v" />Jidonte, Amalekte leh Ammonte’n leng noute a hon nuaisiah ua; n’on sam ua, huchi in a khut ua kipan k’on hunkhia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh noute’n n’on lehngatsan ua, pathian dangte nna nasem zawta uh. Huaiziak in, k’on hunkhe nawn kei ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na pathian telte uh samta unla, amau na gimthuak hun un hon hunkhia uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel suante’n Toupa kiang ah, “Thil ka na hihkhialta uh. Nang pha nasak bangbang in ka tung uah hih in. Himahleh ka hong thum uhi, tuni in hon hunkhe lai in.”
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in a lak ua namdang pathiante a koihmang ua, Toupa na a semta uh. Aman Israelte lungzinna a thuakzou nawnta kei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ammon suante a kikhawm ua, Gilead gam ah a va kikulh ua, Israel suante leng a kikhawm ua, Mizpah ah a kikulh uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mipite leh Gilead gam a miliante a kihou ua, Ammon suante doupa’n ding kua a om a? Huai mi Gilead gam tengteng tung ah heutu ahi ding, a kichi uhi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Gilead mi Jephthah mi hat hangsan ahi a, kizuaknu tapa ahi. Gilead in Jephthah a suang hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gilead zi in tapate a suansak a; a zi tapate a hong pichin un Jephthah a delhkhia ua, a kiang ah, “Nang zaw ka pa uh inn ah gou na luah theikei ding. Numei tuam khat tapa na hih ziak in” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in Jephthah a unaute apan a taimang a, Tob gam ah a teng hi. Jephthah kiang ah mi thulimlou pipi a tengkhawm ua, amah a zuizel uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huai nung deuh in Ammon suante’n Israelte a douta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichi ahi a, Ammon suante’n Israelte a dou uleh, Gilead upate Tob gam a Jephthah pi din a paikheta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jephthah kiang ah, “Ammon suante ka dou theihna ding un ka heutupen ding un hongom in” a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jephthah in Gilead upate kiang ah, “N’on hua ua, ka pa inn apan n’on delhkhia uh, ahi kei maw? Bang a chia na buaitak ua ka kiang a hong na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gilead upate’n Jephthah kiang ah, “Huaiziak tak ahi, tua nang lam ka hong ngat nawn uh. Ammon suante dou dia ka kiang ua na pai theihna din; Gilead gam a teng tengtengte tung ah ka heutu ding un na om ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jephthah in Gilead upate kiang ah, “Ammon suante dou dia n’on pikik nawn ua, Toupa’n amau a honpiak leh na heutu ding un maw, ka om ding?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gilead upate’n Jephthah kiang ah, na thu bangbang a ka hihkei uh leh “ Toupa i kikal uah hon theihpihpa ahi ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Jephthah bel Gilead upate kiang ah a hohta a, mite’n heutu ding leh a pipen pen din a na bawlta uhi. Jephthah in Mizpah ah Toupa ma ah a thu teng a genta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jephthah in Ammon suante Kumpipa kiang ah, “Bangchidan a hichibang a ka gam hong dou dia ka kiang a hongpai mawk na hia?” chi in palai a sawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ammon suante kumpipa’n, “Israelte Aigupta gam apan a hong pawtlai ua, ka gam a hon laksak ziak uh ahi. Arnon apan Jabok leh Jordan tan in. Huaiziak in huai gamte lungdam in hon penawn mai in” chi in Jephthah palaite a na dawng hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Jephthah in Ammon suante kumpipa kiang ah palai a sawl nawn hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A kiang ah, Jephthah in hichi in a chi, “Israelte’n Moab gam a laksak kei ua, Ammon suante gam leng a laksak sam kei uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh, Aigupta gam apan Israelte a hongpawt un gamdai tawn in Tuipi San a hongtung ua, tua apan Kadesh ah a hongpai uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israelte’n Edom kumpipa kiang ah, ‘Hehpih in na gam ah ka paisuak ding uh,’ chi in palai a sawl uh. Himahleh Edom kumpipa in a na ngaikhe nuam kei. Huchi mah bang in Moab kumpipa kiang ah a sawlnawn a, himahleh pha a na sa kei hi. Huchi in Israelte Kadesh ah a omta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in gamdai ah a paisuak ua, Edom gam leh Moab gam kimvel in a pai ua, Moab gam suahlam pang ah a pai ua, Arnon lehlam pang ah giahphual a sat uh. Moab gam sung ah a lut kei hial uh, Arnon bel Moab gamgi chiang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Israelte’n Amorte Kumpipa Sihon leh Heshbon kumpipa kiang ah palai a sawl uh. Israelte’n a kiang ah, ka hong thum uhi, ‘Ka mun ua ka paina ding un hehpih in na gam tawn in hon paisuaksak in,’ a chi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh Sihon in Israelte a gam a paisuak din a muangzou kei. Sihon in a mi tengteng a kaikhawm a, Jahaz ah a kikulh a, Israelte a douta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Toupa , Israelte Pathian in Sihon leh a mi tengteng Israelte khut ah a pia a, amau a that uhi. Huchi in Israelte’n huai gam a om Amorte gam tengteng a tangta uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in Amorte gamgi chiang tengteng Arnon apan Jabok pha in, gamdai apan Jordan pha in a tangvekta uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in Toupa , Israelte Pathian in a mi Israelte ma ah Amorte a hawlkhia a, bangziak a nang hiai gam luahthei di na hia?
  </para>
  <para style="p">
    <verse number="24" style="v" />Na pathian Kemos in nang a tuam dia a hon sehsaksa tang ding hilou na hi maw? Huchi in Toupa ka Pathian un ka ma ua a hawlkhiatte uh ka tang ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />‘Moab kumpipa Jippor tapa Balak sang in na hatzaw ahia? Aman Israelte kinakpih in ahihkeileh a dou ngei himhim ahia?
  </para>
  <para style="p">
    <verse number="26" style="v" />Heshbon leh a khopelte, Aroer leh a khopelte, Arnon gamgi naih khopi tengteng a kum za thum tak a tenlai ua, bangdia nang a na lakik lou nilouh na hia?
  </para>
  <para style="p">
    <verse number="27" style="v" />Huaiziak in, na tung ah thil bangmah ka hihkhial kei hi. Nangman hondou na tup ziak in ka tung ah thil na hihkhial ahi. Toupa , Vaihawmpa in tuni in Israel suante leh Ammon suante kal a thu ngaihtuah hen” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh Ammon suante kumpipa’n Jephthah thukhah a na ngaikhe nuam kei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in Toupa kha Jephthah tung ah a hongtung a, Gilead leh Manasseh gam ah a paisuak a, Gilead a Mizpah ah a paisuak a, Gilead gam Mizpah apan Ammon suante kiang ah a pai zel hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jephthah Toupa kiang ah a kichiam a, “Ammon suante ka khut a na honpiak leh,
  </para>
  <para style="p">
    <verse number="31" style="v" />Hichi ahi ding a, Ammon suante apan galmuanga ka pai kiknawn chiang in bang peuh ka inn kongpi apan a hon dawn masa penpen Toupa a ahi dia, haltum thillat din ka zang ngeingei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in Jephthah bel Ammon suante dou din a kuanta hi. Toupa’n a khut ah amaute a peta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aroer apan Minnith pha leh Abel Keramim kal a khopi sawmnih a zou vek a, mi tampi a that hi. Huchi in Israel suante’n Ammon suante a nuaisiahta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jephthah a tenna khua Mizpah a a inn ah a pai a, ngai in, a tanu in khuangtate toh lam in a na dawn hi. A ta neihsun ahi a; amah lou tapa leh tanu dang himhim a neikei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Hichi ahi a, amah a muhtak in a puante a botkek a, “Ehe, ka tanu! N’on niamkiak sak mahmah ve. Hon mangbangsak mite lak a khat na hita. Toupa ma ah lah ka kam ka na kata ngal a, huai lah zukkik thei ka hita kei” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman a kiang ah, “Pa, Toupa hih ding ahi. Toupa’n na melma Ammon suante tung ah lah na phu a hon laksakta ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman a pa kiang ah, “Hichibang in kei adin kihih hen. Kha nih sung ka tang om dia, tangte ah a suk a tou in ka pai dia, ka nungak siangthou hihna ka sun ding, kei leh ka lawmte’n,” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman, “Pai ve” a chi hi. Huchi in kha nih tam din a sawlkhia a; a pawt a, amah leh a lawmte’n tangte ah a nungak siangthou hihna a va sun uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hichi ahi a, kha nih nung in a pa kiang ah a hong kiknawn a, aman a na kichiamsa bang in a tung ah a hih hi. A tanu nungak siangthou in a omdenta a, pasal toh a lumkhawm ngeikei hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Israel tanute’n Gilead mi Jephthah tanu kum teng in ni li sung a sun zel uhi. Hiai Israelte lak ah ngeina in a neita uhi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Ephraimte a kikaikhawm ua, mallam zuan in a pai ua; Jephthah kiang ah, “Bangdia Ammon suante dou dia hongpai phei a, na kiang a hoh dia hon chial sam lou? Na inn toh k’on buhal khawm ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jephthah in a kiang uah, “Ammon suante ka mite toh theihtawp suah in ka dou ua; k’on saplai in a khut ua kipan in lah n’on hunkhe utkei ua.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in n’on hunkhe nuam kei uh chih ka theih tak in, sih khawk salou hial in ka pang a, Ammon suante dou din ka kuan a, huchi in Toupa’n maute ka khut ah a honpia hi. Huaiziak in bangdia hondou dia tuni a hong kuan na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Jephthah in Gilead mi tengteng a kaikhawm a, Ephraimte a douta hi. Gileadte’n Ephraimte a that uh. “Nou Gileadte, Ephraimte leh Manassehte lak a galtai vakvai maimaite na hi uh” a chih ziak un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gileadte’n Ephraimte ma in Jordan lui kainate a na la ua; hichi ahi a, Ephraimmi suaktate’n, “Ka hong galkah ding uh” a chih chiang un Gileadte’n a kiang ah, “Ephraim mi na hi hia?” a na chi zel uh. Aman, “Hilou e,” a chih leh,
  </para>
  <para style="p">
    <verse number="6" style="v" />A kiang ah, “Shiboleth, chimah dih” a na chi ua, aman, “Siboleth” a chi zawzela; a loutel theikei hi. Huchi in a man ua, Jordan lui kainate ah a na that zel uh. Huchi in huai tung in Ephraimte sing li leh sang nih a that uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jephthah in Israelte tung ah kum guk vai a hawm a, huchi in a sita a, Gilead gam a khua khat ah a vui uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A nung in Bethlehem khua a mi Ibzan in Israelte tung ah vai a hawm hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman tapa sawmthum leh tanu sawmthum a nei hi. A tanute gamdang ah a sawl a, a tapate adin gamdang apan tanu sawmthum a pisak hi. Aman Israelte tung ah kum sagih vai a hawm hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ibzan a sita a, Bethlehem khua ah a vui uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A nung in Zebulun mi Elon in Israelte tung ah vai a hawm a; Israelte tung ah kum sawm vai a hawm hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zebulun mi Elon a sita a, Zebulun gam a Aijalon khua ah a vui uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai nung in Pirathon mi, Hilel tapa Abdon in Israelte tung ah vai a hawm hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman tapa sawmli leh tupa sawmthum leh sabiltung nou sawmsagih tung a tuangzel tupa sawmthum a nei hi. Aman Israelte tung ah kum giat vai a hawm hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pirathon mi, Hilel tapa Abdon a sita a, Ephraim gam, Amalek mite tanggam ah Pirathon khua ah a vuita uh.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Israel suante’n Toupa mitmuh in thil gilou a hih nawn ua; huchi in Toupa’n Philistiate khut ah amaute kum sawmli sung a pia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zoreah khua ah Dan nam mi khat a om a, a min Mano ahi a, a zi bel a ching a, nau a neikei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa angel numei kiang ah a hong kilak a, a kiang ah, “Ngai in, ching a, nau nei theilou himah lechin na gai dia, tapa na nei ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in pilvang in, uain leh zu hat leh sianglou thil himhim ne het ken.
  </para>
  <para style="p">
    <verse number="5" style="v" />‘Ngai in, na gai dia, tapa nei ding na hi ngal a. A lu ah mulmet tem himhim zat ahi kei dia, naupang bel sul a a omlai apan Pathian adia Nazarit hi ding ahi ngal a’. Aman Israelte Philistia mite khut apan hutkhiak apan ding” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Numei in a pasal kiang ah, “Pathian mi khat ka kiang ah a hong a, a mel Pathian angel mel bang ahi a, kihtakhuai tak ahi. Koilam mi ahia chih bel ka dong chit chiat kei a, aman lah a min a honhilh sam kei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh ka kiang ah, Ngai in, na gai dia, tapa na nei ding. Huchi in uain leh zu hat himhim dawn kenla, sianglou thil himhim leng ne het ken. Naupang sul a a omlai apan a sih tan in Pathian adia Nazarit mi hi ding ahi, a chi” chi’n a gen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Mano in Toupa kiang ah nget chihtak in a ngen a, a kiang ah, “Aw Toupa hehpih in huai Pathian mi na honsawl ka kiang uah hong nawn henla, naupang hong piang ding bang ka chih ding ua hong sinsak hen” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian in Mano thugen a na ngaikhia hi. Numei pawna a tutlai in a kiang ah Pathian angel a hong nawn hi. A pasal Mano bel a kiang ah a omkei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Numei kintak in a tai paha, a pasal a va hilh a, a kiang ah, “Ngai in, zanlam a ka kiang a hong hohpa ka kiang ah a hong kilak nawn hi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Mano a thou a, a zi a zui a, huai mi kiang a va tung uhi. A kiang ah, “Numei kiang a thu gen nang na hi maw?” a chi hi. Aman, “Hi e,” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mano in, “Na thu bangzel in hongtung hen. Naupang om ding dan bangchibang ahi dia, a sep ding bang ahi dia leh?” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa angel in Mano kiang ah, “Numei kiang a ka gen tengteng ah amah pilvang hen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Grepgui apan mawngmawng a ne ding ahi kei a, uain leh zu hat a dawn ding ahi kei. Sianglou thil mawngmawng leng a ne ding ahi kei. Ka thupiak tengteng zui hen, a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mano in Toupa angel kiang ah, ka hong thum uh. Hehpih in hon ompih lai in, kelnou k’on bawlsak khit matan uh, a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa angel in Mano kiang ah, “Honkhou lechin leng na an zaw ka ne kei ding. Haltum thil lan ding na hihleh Toupa kiang a na lat ngeingei ding ahi” a chi hi. Mano in lah Toupa angel ahi chih a thei ngal kei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mano in Toupa angel kiang ah, “Na min bang ahia, na thugen bang a hongtun chiang a k’on pahtawi theihna ding un?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa angel in a kiang ah, “Bangdia ka min hon dong na hia, thuguk ahi chih theizen napi a?” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in, Mano in kelnou khat leh nekding thillat a la a; suangpi tung ah Toupa kiang ah a lan hi. Angel in thillamdang tak a hih a, Mano leh a zi in a en nilouh uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Hichi ahi a, maitam apan meikuang vanlam a a kahtouh lai in, Toupa angel maitam a meikuang ah a paitouta hi. Mano leh a zi in a en nilouh ua, a maitang un lei a si uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh Toupa angel Mano leh a zi kiang ah a hong kilak nawn kei hi. Huchi in Mano in Toupa angel ahi chih a theita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mano in a zi kiang ah, “Pathian i muh ziak in i si ngeingei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh a zi in a kiang ah, “ Toupa’n hon hihlup tum hileh haltum thillat leh nekding thillat i latte a sang kei ding. Hiai thil tengteng leng a hon ensak kei ding. Tu hun in hiai thilte leng honhilh kei ding, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Numei in Tapa a neita a, a min Samson a sa uh. Naungek a hong khang lian a, Toupa’n a vualzawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Zoreah leh Eshtaol kikal ah Mahaneh Dan mun ah Toupa kha in a tokthouta hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Samson bel Timnah khua ah a hohsuk a, Timnah khua ah Philistiate tanute lak ah numei khat a va mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A hong paitouh nawn in a nu leh a pa a hilh hi. “Timnah khua ah, Philistiate tanute lak ah numei khat ka mu a; ka zi din hon pisak un” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in a nu leh apan a kiang ah, “Na unaute tanute lak ah hiam, ka mipite lak a hiam numei om hetlou hia? Zeksumlouh Philistiate lak a zi ding na va zon maimah?” a chi uhi. Samson in a pa kiang ah; “Hon pisak mai in; aman a hon lungkim sak mahmah ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh a nu leh apan, hiai Toupa apan ahi chih a theikei uhi. Toupa’n Philistiate tung a phulakna ding hun lemtang zong lah ahi ngal a. Huailai in Philistiate’n Israelte tung ah vai a hawm uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Samson bel a nu leh a pa toh Timnah khua ah a hohsuk ua, Timnah khua a grephuan a va tung uh. Ngai in, humpinelkai lunlai a na humham hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa kha a tung ah nakpitak in a hongtung hi. Huchi in kel nou balnen bang mai in a balnen maimah hi; bangmah lah a tawi kei a. Himahleh a thilhih a nu leh a pa a hilh kei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hohsuk a, huai numei a houpih hi. Aman Samson a kipaksak mahmah hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A nung in vapi din a hoh nawn a, humpinelkai luang en ding in a vapial hi. Ngai in, humpinelkai luang ah khuai hon leh a zu a na om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai a la a, a pai nawn a, a paikawm in a ne kawmkawm hi. A nu leh pa kiang a tungtou a, amau leng a pia a, amau leng a ne sam uhi. Himahleh huai khuaizu humpinelkai luang apan a lak ahi chih a hilhkei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in a pa numei kiang ah a va hohsuk a, huai ah Samson in Ankuang a lui hi. Huai ahihleh tangvalte hihdan ahi him hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Hichi ahi a, amah a muhtak un, a kiang a om din mi sawmthum a pi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Samson in a kiang uah, “Tuin thuhaksa hondong ning e. Ankuanglui ni, ni sagih sung a n’on hilhchet theih ua, na theihkhiak theih uleh puanmalngat silh sawmthum k’on pe ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh n’on hilhchet theihkei uleh, puanmalngat silh sawmthum leh kikhenna puan sawmthum n’on piak ding uh ahi” a chi hi. Amau a kiang ah, “Na thuhaksa gen dihve leh, ka na ngaikhe ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman a kiang uah, “Netu apan nekding hongpawt, hattak apan thil khumtak hongpawt” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ni thum sung in huai thuhaksa a hilhchian theikei uh. Huchi in hichi ahi a, a ni sagih ni’n Samson zi kiang ah, “Ka kiang ua hiai thuhaksa hilhchetna puangkhe din na pasal kun in. Huchilou in zaw nang leh na pa inkawte k’on hal ding uh. Ka neihsa uh la dia honsam na hi kei maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in Samson zi a ma ah a kapa, “N’on it kei a, n’on hawzaw ve. Ka chite lah thuhaksa na dong ngal a, kei bel n’on hilhchian kei” a chi hi. Aman a kiang ah, “Ngai in, ka nu leh pa leng ka hilh kei a; nang k’on hilh dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A Ankuanglui uh, ni sagih sungteng a ma ah kapkap hi. Hichi ahi a, a ni sagih ni’n a nget ngutngut ziak in a hilh khongkhong hi. Aman thuhaksa hilhchetna a chite a va hilhta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A ni sagih ni, nitum ma in huai khua a mite’n a kiang ah: “Khuaizu sang a khum zaw bang ahia? Humpinelkai sang a hatzaw bang ahia?” a chi uhi. Aman a kiang uah, “ka bawngla in leilet kei le uchin zaw, ka thuhaksa thei khe lou ding hive uchin,” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa kha a tung ah nakpitak in a hongtung a, Ashkelon khua ah a hohsuk hi. Mi sawmthum a va that a, a puansilhte uh a hawksak a, kikhenna puante thuhaksa hilhchiante a pia hi. Huchi in a heh mahmah a, a pa inn ah a paitou hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh Samson zi pen apan a kitenna ua theihpih a pang Samson lawmpa kiang ah zi ding in a pia hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Himahleh hichi ahi a, a nung sawtlou in, buhlak hun in, Samson in kelnou tawi in a zi a va veh hi. Dantan sung ah ka zi kiang ah ka valut ding, a chi hi. Himahleh apan a lut a phalta kei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Apan, “Amah na haw mahmah ka sa hi. Huaiziak in na lawmpa kiang ah ka peta hi. A nau amah sang in a melhoih zaw hilou hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Samson in, “Tutung in Philistiate khoih leng amau sang in dem ka kai kei zaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Samson in sihal za thum a va man a, meisel a la a, a mei uleh mei a peh khawm a, a mei uh kikal chiat ah meisel a koih chiat hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Meiselte a det tak in Philistiate buhlak ah a tailut sak a, buhphal leh buh ding laite, olive munte toh nangawn in a kangvek hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Philistiate’n, “Kua hih ahia?” a chi uh. Amau, “Timnah khua a mi makpapa Samson hih ahi. Huai Timnah khua a mi in Samson zi a lawmpa zi dia a piak man ahi” a kichi uhi. Huchi in Philistiate a hong kuan ua a pata un a hallumta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Samson in a kiang uah, “Hichibang na hih uh leh na tung uah phu ka la sam ding, huaikhit in ka tawp ding” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in nakpitak in a sual a, tampi a that a, a paisuk a, Etam suangpi tung ah a omta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Philistiate a hohtou ua, Judah gam ah a va kikulh ua, Lehi mun ah a kiphalh uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Judah gam a mite’n, “Bangchidan ahia kou sualdia na hong kuan mawk uh?” a chi uhi. Amau, “Samson khaukhih a ka tung ua a hih mah bang a amah tung a leng hih din ka hong uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Judah gam a mi sang thum Etam suangpi tung ah a hoh ua, Samson kiang ah, “Philistiate i tung ua vaihawmmite a hih uh theilou na maw? Bangchidan a hichibang a ka tung ua thil hon hihta mai na hia oi?” a chi uh. Aman a kiang uah, “Ka tung a, a hih bang ua ken leng amau tung a hihsam ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amau a kiang ah, “Nang hon khaukhih a, Philistiate khut a honpe dia hong kuan ka hi uh” a chi uh. Samson in a kiang uah, “Noute’n honthat lou din ka kiang ah kichiam un” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amau a kiang ah, “That lou e. Himahleh k’on khaukhih chinten ding ua, a khut ua honpe ding ka hi uh. Thah zaw k’on that kei hial ding uh” a chi uhi. Huchi in khauzen thak nih in a khih ua, suangpi apan a pita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lehi mun a hongtun in, Philistiate’n a na dawn ua, a na kikou zuazua uhi. Toupa kha a tung ah nakpitak in a hongtung a, huchi in a ban a gakna khauzen jija zang mei in kangtat bang mai a hong hita a, a gaknate a khut apan a kekhe niang maimah uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sabiltung khaguh thak a mu a, a sawk a, a la a, huai in mi sang khat a satlum hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Samson in, Sabiltung khaguh in ka chiang vum venvon a, sabiltung khaguh in mi sang khat ka satlum, a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hichi ahi a, a thugen khit in a khaguh tawi a pai a; huai mun Ramath Lehi a sa hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A dang a tak mahmah a, Toupa a sam a, “Nang na sikha khut zang in thupitak in n’on hunkheta hi. Tuin dangtak in ka si ding maw? Zeksum louhte khut ah ka puklut dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh Pathian in Lehi mun a leikuak a khisak a, tui a hong kikhoh kheta hi. Huai a dawntakin a lungsim a honghalh a, a honghat nawnta hi. Huai mun min En hakkore a sa a; tunitan in Lehi mun ah a omlai hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in Philistiate hun in Israelte tung ah kum sawmnih vai a hawm hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Samson bel Gaza khua ah a hoh a, huai ah numei kizuak khat a va mu a, a va luppih hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Samson hiai ah a honghoh,” chi in, Gaza mite a hilh uhi. Huchi in a va umta ua, khopi kulh kongpi chin ah zankhua in a tang uh. Zankhua in a daisipsip ua, “Khua hongvak peuhmah leh, huchi in that na ni” a kichi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Samson bel zankim tan in a luma, zankimin a thou a, khopi kulh kongkhakte leh a khuam nih a len a, a kalhnate toh a phawi kheveka, a liangzang ah a pua a, Hebron ma a mualvum ah a pawtou hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichi ahi a, a nung in Sorek guam a numei khat a it a, a min Delailah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Philistia miliante a kiang ah a hohtou ua, a kiang ah, “Amah ka zoh theihna ding un, a hatna san theihtum in kankhia in. Huchi in ka vek un dangka sang khat leh za khat k’on pe chiat ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Delailah in Samson kiang ah, “Na hat mahmahna san honhilh dihve. Bangchi’n ahia hihnat dia khau khihtheih na hih ding?” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Samson in a kiang ah, “Khauhual thak, keu nailou sagih in hon hen le uchin, ka hat kei dia, midang banglel mah ka hi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Philistiate miliante’n khauhual thak sagih, keu nailou a pia ua, aman huaite in a henta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Dantan sunggil ah guktanmite a koih a, a kiang ah, “Samson, Philistiate’n hon sualdek uh e” a chi hi. Aman Khauhual mei in jija khaulom a kangtat bangphet in a hihtatta hi. Huchi in a hatna san a theikhe zoukei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Delailah in Samson kiang ah, “Ngai in, n’on khem a, zuau honhilh na hi. Bangchi a hen theih ding na hia? Hon hilhta in” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a kiang ah, “Khauzen thak, zat nailouh in hon hen le uh, huchi in ka hatkei mai ding, midang banglel mah ka hi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Delailah in khauzen thak a la a, a hen a, a kiang ah, “Samson, Philistiate’n a hon sualdek uh” a chi hi. Dantan sunggil ah guktanmite a om uhi. A khut a henna patzang suktat bang mai in a hihtatta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Delailah in Samson kiang ah, “N’on khemlai a, zuau n’on hilh lai hi. Bangchi a hen theih ding na hia? honhilh dihve” a chi hi. Aman a kiang ah, “Ka sam phek sagih puan in gatkhum leteh ahimai” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman kilhna in a kilhkip giugeu a, a kiang ah, “Samson Philistiate’n hon sualdek uh e,” a chi hi. Huchi in ihmu lai a honghalh a, puanbu kilhdenna leh puanbu nangawn toh kikhong sak in a paikhia hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A kiang ah, “Na lungtang honpe hetlou pi in, bangchidan a k’on it, chi thei na hia oi? Tun thumvei hilhial n’on khemta hi, na hat mahmahna san n’on hilh nai kei lailai” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hichi ahi a, niteng in a ngen ngutngut a, a dotdot ziak in, sih ding khop hial in a lunggimta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in a lungsim tengteng a hilhvekta hi. A kiang ah, “Ka lu ah mulmettem himhim zat ahi ngei naikei hi. Ka nu sul a ka omlai apan Pathian adia Nazarit mi dia na om ka hi. Tuin metta leng, ka hatna a mang vek ding, huchi in ka hat kei dia, midang banglel ka hi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A lungsim tengteng a hilhvekta chih Delailah in a theih phet in, “Tu kia honghoh un, a lungsim tengteng a honhilh vekta” chi’n Philistia miliante thukhak in a samsak hi. Huchi in Philistia miliante a kiang ah a va hohtou ua, dangka a tawi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A pheipi tung ah a ihmu sak hi. Mi a sam a, a samphek sagihte a metkhe sakvek hi. Huchi in amah a hih genthei panta a, a hatna in a nusiata hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Samson, Philistiate’n a hong sualdek uh e” a chi hi. Ihmu lai a honghalh a, “Nidang mah bang in ka pawt nawn ding, ka kitungkhe nawn ding” a chi hi. Himahleh Toupa’n a paisan khinta chih himhim a theikei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Philistiate’n a man ua, a mitte a khelkhiak sak uh. Gaza khua ah a paipih suk ua, Sikkol a bunsak ua; suangkulh ah buh gawizantu in a pang hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh a sammet ahihnungin hongpou in a hongkhang nawn hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Philistia miliante Dagon pathian kiang a kithoihna thupitak lan ding leh kihih nuamsa din a kikhawm uh. “I pathian un i melmapa uh Samson a honpeta” a chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mipite’n a muh un a pathian uh a phat ua, “I pathian un i melmapa, i gam hihsia a mi tampite thatpa i khut uah a honpeta” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hichi ahi a, a lungtang un nuam a saklaitakin, Samson pen muhnop din vasam dih ua, a chi uhi. Huchi in Samson suangkulh apan a va sam khia uhi. A ma uah muhnop din a omta a; khuam leh khuam kikal ah a dingsak uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Samson in amah kaitu naupang kiang ah, “Hiai inn doupen khuam hon khoihsak dihve, k’on ngaideh” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huai inn ah pasal leh numei in a dim miuhmeuh uhi. Philistiate milian tengteng huai ah a omvek ua, Samson muhnop dia enmite intung ah pasal leh numei sang thum a om uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Samson in Toupa a sam a, “Aw Toupa Pathian, hehpih in hon theigige inla, hehpih in tutung in hon hihhat in, aw Pathian, ka mit lang nih phu Philistiate tung ah tu kia hon lasak in” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Samson in, huai inn doupen sut nihte a len a, a khut taklam in khat, a khut veilam in khat mah a pansan hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Samson in, “Philistiate toh sikhawm ning” a chi hi. Huchi in theihtawp in a kunsuk a; miliante leh mipi asung a om tengtengte huai inn chim in a delhkhumta hi. Huchi in a damlai a a thahte sang in a sihkhumte a tamzaw uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in a unaute leh a pa inkawte tengteng a hong paisuk ua, a la ua a zawngtou ua, Zoreah leh Eshtaol kikal a; a pa Manoa kivuina mun ah a vuita uhi. Huchi in aman kum sawmnih sung Israelte tung ah vai a hawm hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Ephraim tanggam ah mi khat a om a, a min Mikah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman a nu kiang ah, “Dangka sang khat leh za khat nang apan lakmang a omte, nang leng na hamsiat leh ka zak mahmah a na genpen, ngai in, huai dangka ka kiang ah a om hi, kei lak ahi,” a chi hi. A nun, “Ka tapa Toupa vualzawl in om hen,” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dangka sang khat leh za khat a nu a pekik a, a nun, “Hiai dangka kei khut mahmah in ka tapa in milim a bawlna ding leh milim a sunna din Toupa kiang ah ka lan hi. Huaiziak in tuin k’on pekik ding” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in huai dangka a nu a pekik a, a nun dangka za nih a la a, dangka sekmi a pia a, aman milim khuakthoh leh sunthohte a na bawl a, huaite Mikah inn ah a om uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mikah in pathiante in a nei a, ephod leh milimte a bawl a, a tapa khat a siampu in a septuamta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huailai in Israel gam ah kumpipa a omkei a; michih in a ma mit a dik a sakte a hihchiat mai uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Judah gam Bethlehem mi Judah nam, Levi chi tangval khat, huai ah a va om hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai mi Bethlehem Judah khopi apan a pawt a, omna zong in a vak ahi. A vakna lam ah Ephraim tanggam a Mikah inn a va tung hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mikah in a kiang ah, “Koi apan hongpai na hia oi?” a chi hi. Aman a kiang ah, “Bethlehem Judah mi Levi chi ka hi a, omna mun zong a vak ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mikah in a kiang ah, “Ka pa leh siampu din ka kiang ah teng in, kum teng in, dangka sik tang sawm ka honpe dia, puansilh khat leh nek dingte leng” a chi hi. Huchi in Levi chi a lutta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Levi chi, huai mi kiang a ten a lungkim hi. Huchi in huai tangvalpa a tapa khat bang in a omta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mikah in Levi chi a septuamta a, huchi in tangvalpa a siampu in a pangta a, Mikah inn ah a tengta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in Mikah in, tuin zaw Levi chi ka siampu din ka neita hi. Toupa’n a hon lamzang sakngei ding, chih ka thei, a chi hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai in Israel gam ah kumpipa a omkei. Dan chite’n gamluah ding a zong uh. Israel chite lak ah gamluah ding a tang naikei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Dan suante’n a nam pumpi lak ua mi, pasalpha nga, Zoreah leh Eshtaol khua apan gam enkhe ding leh va entel din mi a sawl uh. A kiang uah, “Vakuan unla, gam va entel dih ua” a chi uh. Huchi in Ephraim tanggam a Mikah inn a va tung ua, huai ah a giak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mikah inn kiang a, a omlai un Levi chi tangval aw a thei ua, huailam a va zuan ua, a kiang ah, “Hiai a honpi kua ahia? Hiai mun ah bang ahia na hih? Bangchi’n ahia hiai a na ten?” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman a kiang uah, “Mikah in huchi in a hon na bawlta a, a hon guai a, a siampu in ka om hi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amau a kiang ah, “Ka hohna ding uah ka lamzang ding uh hia ding lou, chih theihtheihna din Pathian hon dotsak dihve” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Siampu in a kiang uah, “Lungmuangtakin pai un. Na hohna ding ma uah Toupa a om hi” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in mi ngate a pawtkhia ua, Laish khua ah a lut ua, huai mite Zidon mite mah bang a galmuangtak leh lungmuangtaka om hithiat a om a va mu ua; amaute zahlaksak ding thuneimi kuamah a omkei a, Zidonte toh a kigamla ua, kuamah toh leng a kisaikha kei uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zoreah leh Eshtaol khua ah a unaute uh kiang ah a hongpai ua; a unaute un a kiang uah, “Bangchi ahia oi?” a chi uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau, “Thou dih ua, i sual ding uh. Gam ahihleh ka va mungei ua, ngai un, a hoih mahmah hi. Dai maimah ding na hi uhia? Huai gam valut a, valuah din zekai kei dih uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vahoh le uchin galmuanga om mite ahi chih nava muh ding uh, a gam lah a za mahmah ngal a. Pathian in nou a hon pekhinta hi. Lei a thil om ah zaw bangmah taksap ding a om hetlouhna mun ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Zoreah leh Eshtaol khua apan Dan namte kidouna galthuam silh in mi za guk a pawtta uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A va hohtou ua, Judah gam Kiriath-jearim khua ah om mun a bawl uh. Huaiziak in huai mun tunitan in Mananeh Dan a chilai ua, Kiriath-jearim tanglam ah a om hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai apan Ephraim tanggam lam a zuan ua, Mikah inn a va tung uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Laish gam enkhe dia mi nga pawtte’n a dawng ua, a unaute uh kiang ah, “Hiai innte ah ephod, milimte, milim bawltawmte, milim suntawmte a om chih na thei uhia? Huchi in bangchi’n ahia na hih ding uh ngaihtuah un” a chi uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai apan a pai ua, Levi chi tangval omna Mikah inn ngei a va tung ua, a tungtang thu a dong uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dan suan, mi za guk kidouna galthuam silhte kulh kongpi bul ah ading uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi nga gam enkhete a va hohtou ua, a lut ua, milim bawltawm, ephod, milimte leh suntawm milimte a la ua, siampu mi za guk kidouna galthuam silhte lak ah kulh kongpi bul ah ading hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huaite Mikah inn ah a valut ua, bawltawm milimte, ephod, milimte leh suntawm milimte a valak uleh, siampu in a kiang uah, “Hiai a bang hih na mai ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau, “Dai in, na khut in na muk hum inla, ka kiang uah hongpai inla, ka pa uh leh siampu ding un hongom in. Nang adin inn khat kia siampu a om hia hoih zaw, Israel lak a chi khat leh nam khat siampu dia om?” a chi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Siampu lungtang a kipak mahmah a, huchi in ephod, milim, leh bawltawm milimte a la a, mipite lak ah a omta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in a paikhia ua, a nau neute uh, gante uh leh a vante uh a masuan touzel uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mikah inn apan gamla kuam a paikhiak nung un Mikah invengte a ki kaikhawm ua, Dan suante a delhphata uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Dan suante a sam uh. Amau a nunglam a nga ua, Mikah kiang ah, “Bang a chia ahia, mi huai zahzah n’on tonpih?” a chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Aman, “Ka bawl pathiante leh siampu na paipih ua, na pai vengveng ua, bang ka neilai a? Bangziaka bangchi na hia, na honchih uh?’ a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Dan suante’n a kiang ah, “Ka lak uah pau mawkmawk kei dih aw, huchilou in zaw mi thangpai khut na thuak kha dia, na inkawte toh na hinna na tan ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in Dan suante a pai ua, Mikah in lah sualngam vual hi un a theikei a, a in lam ah a pai nawnta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mikah thilbawlte leh a siampu neih a paipih ua, Laish khua, galmuanga om hithiatte kiang a tungtou ua, namsau in a that ua; khua mei in a halta uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Zidon apan a gamlat mahmah ziak in a va hunkhe ding mi kuamah a omkei uh. A kuakua toh kizatna mahmah a neikei uhi. Beth rehob kiang as om phaizang ahi a, Khopi khat a lam ua, huai ah a tengta uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A khaw min Israel tapa, a pu uh Dan tam in, Dan a sa uhi. Himahleh a tung in huai khaw min Laish ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dan suante’n huai milim bawltawm a dingkhe sakta uh. Mosi tapa Gershon tapa Jonathan leh a tapate, gamsal a pi a hih masiah uh Dan chite siampu ahita uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in Mikah bawltawm milim ahihleh Shiloh khua a Pathian inn a om laiteng a dingsak uhi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, hichi ahi a, huailai a Israel gam a kumpipa a omlouh lai in, Levi chi a mi khat Ephraim tanggam tawplam ah a om a, Judah gam a Bethlehem mi mei in a nei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A mei in a angkawm san a, huchi in Judah gam a Bethlehem a a pa inn ah a taisan hi. Huai ah kha li tak a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pasal a thoua, a sikha leh a sabiltung nih pi in kamdam in a vakhem a, lungkim a pikik nawn tum in a va delhzui hi. Aman a pa inn ah a na pilut a, apan a na muh in a na kipahpih hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A sungpa, numei pa’n a kiang a om din a na khou a; a kiang ah ni thum a om a, a ne un a dawn khawm ua, huai ah a tung hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hichi ahi a, a ni li ni’n zingkhang in a thoua, amah bel pawttumin a thou hi. Numei pa’n a makpa kiang ah, “Tanghou tawmchik ne in. Na lungtang hihhalh tadih inla, huaikhit chiang in na pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in a tu ua, a nih un a ne un a dawn khawm uh. Numei pa’n huai mi kiang ah, “Lungkimtakin tuzan giak in, na lungtang nuamsak in” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai mi bel pawt tum in a thou a, himahleh a sungpa’n a zolzol a, a giak nawnta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A ni nga zingkhangpi in pawt tum in a thou hi. Numei pa’n, “Na lungtang hihhalh tadih lechin a kei dia, nitak ni nem hun tanbek omtadih in” a chi hi. Huchi in a nihun an a nekhawm nawn uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai mi bel a mei leh a sikha toh pawt tuma a kisak leh a sungpa, numei pa’n a kiang ah, “Ngai in, ni leng a kaita, tu zan giak nawn mai inla, ni leng tum ding ahita. Hiai ah giak in; na lungtang a kipahna ding in. Huchi in zing chiang in zingkhang in na thou dia, in lam ah na pai mai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh huai mi huai zan giah a utkei a, a thou a, a pawtta hi. Jebus khozawn a tung a, huai bel Jerusalem khua ahi, sabiltung nih bawlsa a pi a; a mei leng a tel hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jebus khaw kiang a tun un ni a kai mahmahta hi. Sikha in a pu kiang ah, “Hongpai dih, hiai Jebuste khopi ah i lutmai ding, i giakmai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pun a kiang ah, “Israel suan hilou namdang khua ah lut lou e. Gibeah kholam i zuan zaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A sikha kiang ah, “Kisa aw, hiai munte a koi zaw hiam i zuan ding. Gibeah khua ah hiam, Ramah khua ah hiam i giak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in a pai nawnzel ua; Benjaminte Gibeah khaw kiang a tun un ni a tumta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gibeah khua a giak din a lut ua, a lut un huai khopi khaw lak ah a tu uh, kuamah a zintun ding a omkei uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai in, nitaklam in putek khat loukuan a hongpai hi. Huai mi bel Ephraim tang gam a mi ahi a, Gibeah khua a om zual ahi. Amah Benjamin chite lak a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A kihei leh kholak a mikhualpa a mu hi. Putek in, “Koi a hoh ding? Koi apan a hongpai na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman a kiang ah, “Judah gam a Bethlehem apan Ephraim tangtawp gam lam a hoh ka tum uhi. Huai a om ka hi, Bethlehem, Judah gam ah ka va hoh a; tuin Toupa inn ah hoh ka tum hi. Kuamah hon zintun a omkei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka sabiltung ua ding buhpawl leh gan an ka nei uh. Kei leh na sikhanu leh na sikhate kiang a omtangval ading leng tanghou leh uain a omlai a, bangmah taksap ka neikei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Putek in, “Lungmuangtakin om in. Na kulna tengteng ken ka tumvek ding. Kholak ah zaw giak mahmah ken” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in a inn ah a pilut a, sabiltungte an a pia a; a khete uh a sil ua, ne in a dawn uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi a nuamsa leh kipaktak a a omlai un, ngai in, huai khua a mi, Belial tapate khenkhat in huai inn a hon umta uh. Kongkhak a hongkhen ua; inn neipa putek kiang ah, “Na inn a hong tungpa hon pikhia in, ka luppih ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Inneipa a kiang uah a va pawt a, a kiang uah, “Hilou e, ka unaute aw, hichitel a gilou zaw hih mahmah kei un. Hiai mi ka mikhual ahi. Hiai thil haihuai hihkei un, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ngai un, hiai ah ka tanu nungak leh a mei a om uh. Amau k’on pikhe dia, amaute zahlaksakin na utut uh a tung uah hih un. Himahleh hiai mi tung ah zaw hiai thil gilou hih kei un” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh huai mite’n a thu a zui nuam kei ua, huchi in hiai mi’n a mei a man a, a kiang uah a va pikhia hi. Amau a na luppih ua, khovak masiah zankhua in a pawngsual uhi. Huchi in khua a hong vaktakin, a khah uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khua a hong vaktakin numei a pai a, a pu tunna pa inn kongpi bul ah a puk a, khovak nung tan in a om nilouh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A pu zingsang in a hong thou a, inn kongpite a hong a, pai tum in a va pawt hi. Ngai in, a meinu kongpi bul ah a khutte inn sung lam nga in a na lum hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman a kiang ah, “Thou in, i pai ding” a chi hi. Himahleh a dawng kei hi. Huchi in a sabiltung tung ah a koihtou a; a thou a, a mun lam ah a paita hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A inn a tun in temta a la a, a mei a sem a, a guhte toh seh sawmlehnih in a semnen a, Israel gam teng ah a khak vek hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichi ahi a, a mu peuhmahte’n, “Israel suante Aigupta gam apan a hongpawt nung uh hichibang thilhih leh muh tutan in a om ngei nai kei. ‘Ngaihtuah unla, kihou unla, na lungsim uh gen un’ ” a chi uhi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Israel suante tengteng a kisata ua, pheikhai lual in Dan khua apan Beer–sheba khaw pha in Gilead gam a mite toh Mizpah khua ah Toupa kiang ah a kikhawmta uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi tengteng heutu, Israel chite tengteng nangawn Pathian mite kikhopkhawmna ah a tel ua, sepaih namsau tawi mi nuai li ahi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Benjamin suante’n Israel suante Mizpah khua ah a hohtou uh chih a za uh, Israel suante’n, “Bangchidan a hichibang a gitlouhna hongom ahia, honhilh un?” a chi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Levi chi, a thah uh numei pasal in, “Benjamin chite omna Gibeah khua ah ka mei toh giak din ka valut uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gibeah mite’n a hong sualta ua, zan in inn a hongum ua; honthah a tum ua, ka mei a pawngsual ua a sita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in ka mei luang ka sem a, Israelte gamluah tengteng ah ka khak a, Israel gam ah thil kihhuai leh haihuaitak a na hihta ngal ua.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nou Israel suante aw, na vek un ngai un, na ngaihdan uleh na phasak dan uh gen dih ua” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in mi tengteng pheikhai lual in a thou ua, “Kuamah i puanin lam ah i pai hetkei ding, kuamah i inn ah i lut kei ding uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Gibeahte i bawl ding dan hichibang ahi. Ai i san ding ua, amaute i dou ding uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gibeah mun a Benjaminte i vasualna ua mipite nekding pe din Israel nam tengteng lak a mi za khat ah sawm zel, sang khat ah za zel, sing khat ah sang zel i telkhe ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Israel mi tengteng pheikhai lual in huai khopi sual din a kikhawm uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Israel namte’n Benjamin nam tengteng kiang ah mi a sawl ua, “Na lak ua na hih uh bang gitlouhna ahia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Gibeah khua a mi Belial tate honpi unla, Israel gam a gitlouhna a daih theihna din ka na that ding uh” chi in mi a sawl uh. Himahleh Benjamin chite’n a unau Israel suante thugen a zui nuam kei uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Benjamin suante bel Israel suante dou din khopite apan a hong pawtkhawm ua, Gibeah khua ah a lutta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai ni a Benjamin suante khopi apan namsau tawi a pawtte, Gibeah khua a mi za sagih telkhiak simlouh in sing nih leh sang guk ahi uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai tengteng lak ah veilong za sagih, telkhiat a om ua; amaute’n vaisuangseh in samzang chia leng a khial kei uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Israel mite, Benjamin mite simlouh in namsau tawi ngen mi ngen nuai li ahi uh. Amau tengteng galdou thei vek ahi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Israel suante a thou ua, Bethel ah a hohtou ua, Pathian a va dong ua, Benjamin suante kuan ahia va sual masa ding? a chi uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa’n , Judah nam va hoh masa u hen, a chi hi. Huchi in Israel suante lak ah a thou ua, Gibeah khua a va umta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Israel mite Benjamin pawl sual din a kisa ua, Israel mite’n Gibeah khua ah amaute sual din panmun a khoh uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Benjamin suante Gibeah khua apan a hongpawt ua, huai ni’n Israel suante lak a mi sing nih leh sang nih a hongthat uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mipite, Israel mite a kihasuan nawn ua, a sual tung ni ua a sualna mun mah uah sual din panmun a khoh nawn uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Israel suante a hohtou ua, Pathian ma ah nitak tan in a va kap ua, “Ka unau uh Benjamin suante ka va sual nawn ding uam?” chi’n Toupa a dong uhi. Toupa’n , “Va sual nawn un” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A ni nihni in Israel suante’n Benjamin suante a va naih uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />Benjamin suante leng huai a ni nih ni’n sual din Gibeah khua apan a pawtsam ua, Israel suante lak a mi sing khat leh sang giat a hongthat nawn uh. Huaite tengteng namsau tawi mi ahi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in Israel suan tengteng leh, mi tengteng a va paitou ua, Bethel ah a hohtou ua, a kap ua, Toupa ma ah a tu uh. Huai ni’n nitak tan in an a ngawl uhi. Toupa kiang ah haltum thillat leh lemna thillatte a lan uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Israel suante’n Toupa a dong uh. Huailai in huai ah Pathian thukhun bawm a om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huailai in Aron tapa Eleazar tapa Phinehas in a na a semzel ahi. “Ka unau uh Benjamin suante ka va sual nawn ding uam, ka tawpsanta mai ding uam?” chi’n Toupa a dong uhi. Toupa’n , “Vahoh un; zingchiang in zaw na khut uah k’on peta ding” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Israel suante’n Gibeah khaw kim ah tangpangmi a gukkoih uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Israel suante Benjamin suante sual din a ni thum ni’n a kisa nawn uh. Nidang mah bang in Gibeah khua sual din panmun a khoh nawn uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Benjamin suante bel huai mite sual din a pawt ua, khua a pawtsan uh. Huchi in nidang mah bang in mite sual in a thatpan nawnta ua, pawn ngial ah Bethel kholam lamliante ah Israel suante sawmthum a that uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />Benjamin suante’n “A ma mah bang in i ma uah a zahlak nawnta uh e” a chi uhi. Israel suante’n bel, “I tai ding uh, khopi apan lamlian lam ah i tolhkhe sak ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in Israel suan tengteng in a panmun uh a pawtsan ua, Baal Tamar mun ah panmun a khoh uhi. Israel suan a guk a na tangpangte a mun ua pan, Gibeah phaizang a panmun tan in a hong pawtkhia uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Israel suan tengteng lak a telkhiat mi sing khat in a va sual ua, kidouna a thupi mahmah hi. Himahleh amau thil hoihlou a kiang naichik ah a om chih a theikei uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Toupa’n Israelte ma ah Benjamin suante a that hi. Israel suante’n huai ni’n Benjamin suante mi sing nih leh sang nga leh za khat a that uhi. Huai tengteng namsau tawimi ahivek uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in Benjamin suante’n a vuallelta uh chih a hong kitheita uhi. Israel suante’n Gibeah khua sual dia a guk a tang pang mite a koih uh a muan ziak un Benjamin suante a nungtolh san uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A guk a tangpang mite’n Gibeah khua a sualguih uh. Huchi in a guk a tangpangte a kiphalh ua, khua a mi tengteng namsau in a sualta uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Israel suante leh a guk a tangpang mite’n a kichiam uh bel khopi sung a mei khuttouh sak ding, chih ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huai a muh chiang ua, Israel taikekte kileh hei a, dou ding a chih uh ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in khopi sung a meikhu a hong kitun nguingui tak in, Benjamin suante a kihei uleh, ngai in, khopi a pum in vanlam ah a khutou ngoingoi maimah hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huchi in Israel suante a hong kilehhei ua, Benjamin suante’n lamdang a sa mahmah uh. A tan uh a hoihkei ding chih lah a theita ngal ua.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huaiziak in, Israel suante ma ah gamdai ah a taikekta uhi. Himahleh a delhzui pek ua, khopi apan hong pawtte’n huai ah na that uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Benjamin suante bel a umsip ua, a delh ua, ni suahna lam Gibeah kiang a a khawlna uah a phata uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Benjamin suante mi sing khat leh sang giat a si ua; avek un mi hat hangsan chiat ahi uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />A kihei ua, gamdai lam Rimmon suangpi ah a tai uh. Mi sang nga lamliante ah a tom ua; Gidom tan in a delhzui ua, mi sang nih a that uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huchi in huai ni a Benjamin suan si, namsau tawimi ngen sing nih leh sang nga ahi ua, avek un mi hat hangsan ahi uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Mi za gukte gamdai lam Rimmon suangpi ah a taikek ua, huai Rimmon suangpi ah kha li sung a om uhi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Israel suante Benjamin suante tung ah a kisa nawn ua, khopi sung a om peuhmah gante, a muhmuh uh namsau in a satlum zel ua, huailou leng a khaw muh peuhmah uh a halzel uhi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan, Israel suante’n Mizpah khua ah, i lak ua mi kuamah in i tanute uh Benjamin suante zi din i pe kei ding uh, chi in a kichiam uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mipite Bethel ah a hoh ua, Pathian ma ah nitak tan in a tu ua, a awte uh suah in a kap vongvong uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amau bel, “Aw Toupa Israelte Pathian, bangchidan ahia Israelte lak a hichibang thil a hongom?” a chi uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichi ahi a, a zing in zing khang in a thou ua, huai ah maitam a bawl ua, haltum thillatte leh lemna thillatte a lan uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Israel suante’n, Israel nam tengteng lak a Toupa kiang a paikhawm pawl lak a vatel teilou kuate ahi ua? a chi uh. Mizpah khua a Toupa kiang a vahoh lou peuhmahte bel, thah ngeingei ding ahi, chi in a na kichiamta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Israel suante a unaupa uh Benjamin suante tungthu ah a kisik ua, “Tuni in Israel suante lak ah nam khat satkhiak ahita, a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A omsunte adin a zi ding uh bangchi’n i hihta ding ua? I tanute uh lah a zi ding ua neisak lou din Toupa minlou in i na kichiamta ngal ua” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amau a chi ua, Mizpah a Toupa kiang a hong paitou lou Israel namte lak ah a om hia? Ngai in, kikhawm pawl omna mun ah Jabesh-gilead mite lak ah khat lel leng a hong hohkei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mite a kisim uleh, ngai in, Jabesh-gilead gam a omte khat lel leng a na omta kei uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kikhawm khawmte’n mi hangsan hoih ngen sing khat leh sang nih a sawl uh. “Kuan unla, Jabesh-gilead gam a omte numei leh a tanu neute u toh namsau in va satlum vek un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na hih ding dan uh hichibang ahi. Mi tengteng leh numei, pasal luppih khinsa peuhmah hihmang thang vek un” chi in thu a pia uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jabesh-gilead gam a omte lak ah nungak za li, pasal kithuahpih ngei hetlouh a mu uh. Huchi in a omna uh Shiloh khua ah a pi ua, huai bel Kanan gam a om ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kikhawm khawm tengteng in mi a sawl ua, Rimmon suangpi a om Benjamin suante a va houpih ua, kilemna bawl din a sam uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaitak in Benjamin pawl a hong nawn ua; Jabesh-gilead gam a numei a hawite uh a zi ding un a pia uh. Huchi in leng a kiching kei lai uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Israel nam lak a Toupa’n kihihtuamna a na bawl ziak in mite, Benjamin suante tungthu ah a kisik uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in kikhawmte upate’n, “A damlaite zi ding bang i chih ding ua? Benjamin suante lak a numeite lah hihmang ahita ngal ua?” a chi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Amau Israel nam hihman louhna din Benjamin suan omsunte bangchi’n suan i neisak ding ua?
  </para>
  <para style="p">
    <verse number="18" style="v" />I tanute uh lah a zi un i neisak thei ngalkei ua” a chi uh. Israel suante’n, “Kuapeuh Benjamin suante zi dia nei sak peuhmah hamsiat in om uhen” chi’n a kichiam uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau, “Ngai un, Bethel mallam, Bethel apan Sekem zotna lamlian suahlam pang a Lebonah simlam a om Shiloh khua ah kumchih in Toupa adin Ankuangluina a om” a chi uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amau Benjamin suante kiang ah, “Va hoh unla, grep mun ah va guktan un;
  </para>
  <para style="p">
    <verse number="21" style="v" />Na en unla, ngai un, Shiloh khua a nungakte lamna a lam dia a hongpawt uleh, grep mun apan hongpawt unla, Shiloh nungakte na zi ding un man chiat unla, Benjaminte gam ah paipih un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hichi ahi ding a, a pate uh hiam, a sanggampate uh hiam kalh dia i kiang ua a hong uleh, a kiang uah, Hon hehpih un. Kidouna sung in lah zi ka guan theikei uh. Nou lah na tanute uh na piak thoh un hilou a, kichiamna a mawh tanglou ding na hi uh” ka chi ding uh, a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Benjamin suante’n huchibang in a hih uh. Lampawlte lak a mi amau zah chiat zi din a man ua, a paimangpihta uhi. Huchi in a gam uah a pai ua, khopite a puahnawn ua, huai ah a tengta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaitak in huai apan Israel suante bel amau chichi leh amau namnam in a kihuituam nawn ua, huai nungsiah amau gam chiat ah a pai nawn uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huailai in Israelte lak ah kumpipa a omkei a; michih in amah mit a dikte a hih chiat uhi.
  </para>
</usx>
