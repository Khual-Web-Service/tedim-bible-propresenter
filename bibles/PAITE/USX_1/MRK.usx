<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="MRK" style="id">Mark</book>
  <para style="h">Mark</para>
  <para style="toc1">Mark</para>
  <para style="toc2">Mark</para>
  <para style="mt">Mark</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pathian Tapa, Jesu Khrist Tanchinhoih kipat tungna.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zawlneite a gelh a hih bang in, “Ngai dih, ka thangkou na ma ah ka sawl a, aman na lampi a bawlkhol ding;
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamdai a kikoupa aw in, Toupa lamlian sial unla, a lampite hihtang un” chi a a gelh bang in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Johan in gamdai ah a baptist a, khelhnate ngaihdamna ding a kisikna baptisma thugen in, a hongpawt hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judia gam a mi tengteng leh Jerusalem khua a mi tengteng a pawt ua, a kiang ah a pai ua, a khelhnate uh thupha tawi in Jordan lui ah, amaute a baptist zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Johan sangawngsau mulpuan in a kivan a, a kawng savun kawnggak a gak a, a an khaukhup leh khuaizu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ka nung ah kei sang a thupizaw a hong pailel ahi; kuna a khedap khau pheltak leng ka hi kei,” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ken tui in nou k’on baptist a; aman zaw Kha Siangthou in a hon baptist ding” chi in a gen hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai nite in hichi a honghi a, Jesu Galili gam a Nazaret khua a kipan a hongpai a, Jordan lui ah Johan in a na baptist hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tui apan a hong pawttak in, van kihong leh kha vakhu bang a a tung a hongkum a mu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan van a kipan aw a hongpawt in, “Nang ka Tapa deihtak na hi a, na tung ah ka kipak mahmah” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kha in amah gamdai ah a sawlpah hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in, Setan khem in gamdai ah ni sawmli a om a, gamsa lak ah a om a; angelte’n a nna a sepsak uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Johan mat a a om nung in, Jesu, Pathian lalgam Tanchinhoih gen in, Galili gam ah a hong paita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“A hun a hongtungta a, Pathian gam a hong naita; kisik unla Tanchinhoih gingta un” chi in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Galili dilgei a nawklai in Simon leh Simon unaupa Andru dil ah lenpai in a mu a; ngamanmi ahi him uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu’n a kiang uah, “Honzui un, huchi in mihing man din k’on bawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A len uh paisan in amah a zuipah uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Saulou a pai leh Zebedai tapa Jakob leh a unaupa Johan a mu a, huaite len bawlpha in long ah a om uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan aman amau a sampah a; a pa uh Zebedai leh kilohmi a goihte utoh long nusia in a zuita uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Kapernaum khua ah a valut ua; khawlni’n kikhopnain ah a lut a, thu a hilh hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />laigelhmite banglou a, thuneitak a amau thu a hilh ziak in a thuhilh lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kikhopnain uah dawininpai mi khat a na om a; aman:
  </para>
  <para style="p">
    <verse number="24" style="v" />“Nazaret Jesu, kou leh nang bang ahia i kizolhna om? Kou hon hihmang dia hongpai na hi maw? Nang k’on thei a, Pathian Misiangthou na hi” chi in, a kikou khia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n a tai a, “Dai inla, asung a kipan hongpawt in” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dawinin in amah a engbawl a ngaihtak a kikou in asung a kipan a hongpawtta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan avek un lamdang a sa mahmah ua, huchi in, hiai bang ahia le! Sinsakna thak ahi ve! Dawininte nangawn thuneitak in thu a pia a, a thu a mang zel uh, chi in, a kihou uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan Galili leh a kim gam tengteng ah a tanchin a thangta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan kikhopnain a kipan a pawt un, Jakob leh Johan toh Simon leh Andru inn ah a lutpah uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan Simon sungnu, khosik in a chi a na a, a na lum a; huchi in, a omdan Jesu a hilh pah uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan Jesu’n a khut a len in, a phong a; huchi in khosik in a nuseta a, a na uh a sepsak hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan nitaklam a nitum nung in, damlou tengteng leh dawimatte a kiang ah a honpi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A khomi tengteng kongkhak bul ah a hong omkhawm khiukheu uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan mi tampi natna chiteng a nate a hihdam a, dawi tampi a delhkhia a; dawite’n amah a theih ziak un a pau uh a phalkei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan zingsang khovak ma tham in a thou a, a pawt a, gamdai mun ah a hoh a, huai ah a thum hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Simon leh a lawmte’n a nung ah a zui uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amah a vamuh un a kiang ah, “Mi tengteng in a hong zong uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman a kiang uah, “Maban khuate ah paini huai a leng thu ka gen theihna ding in; huai mah ka hong pawtsan ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huchi in thuhilh a dawite delhkhe kawm in Galili gam tengteng a a kikhopnainte uah a lut hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan a kiang ah phak a hongpai a, “Na utleh n’on hihsiangthou thei” chi in a ma ah khukdin in a ngen ngutngut hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Aman a hehpih mahmah a, a sawka, a khoih a, “Ka ut hi, na siangthouta in” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huchi in, phakna in amah a nuse paha, a hong siangthouta hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jesu’n amah a kham bikbek kawm in a sawlkhe pah hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />“Kuamah kiang a bangmah genlou ding in pilvang in; himahleh siampu kiang ah vakilak inla, na kisiansakna ding in Mosi thilsehte lan in, mite’n a hon theihchetna ding un” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Himahleh amah a pawt a, huai thu nakpitak a kikoupih in a thangzakta hi; huchi in Jesu a langtang in khua ah a lutthei nawnta kei a, gamdai mun ah a om zawta hi; huan munteng a kipan a mite a kiang ah a hongpai uhi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan ni bangzah hiam nung in Kapernaum khua a a honglut nawn leh, inn ah a om chih thu a hongthang hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in kongkhak kim a omna ding omlou khop in mi tampi a hong kikhawm ua, a kiang uah thu a gen hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mizaw khat, mi li zawn, a kiang ah a honpi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mipi ziak a a kiang nai a a hongpai theihlouh ziak un a omna intung a laihong ua; huaikhit in a lupna leh atunga mizaw lumkawm in a khai khesuk uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Jesu’n a ginna uh a muh in, mizaw kiang ah, “Ka tapa, na khelhnate ngaihdam ahita” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Laigelhmi khenkhat huai mun ah a tu uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Hiai min bangdia hichibang thugen ahia? Pathian a gensia hi; mi khat, Pathian kia loungal, kuan ahia khelhnate ngaidam thei?” chi in, a lungtang un a ngaihtuah uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Jesu’n, a lungtang un huchibang a ngaihtuah uh chih a lungsim in a theipaha, a kiang uah, “Huai thu bangdia na lungtang ua ngaihtuah na hi ua?
  </para>
  <para style="p">
    <verse number="9" style="v" />Mizaw kiang a, ‘Na khelhnate ngaihdam ahita,’ chih leh ‘na lupna la inla, khe in paita in,’ chih a koi ahia a gen nuamzaw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh leitung ah Mihing Tapa in khelhnate ngaihdam theihna a nei chih na theihna ding un” ahi, mizaw kiang ah:
  </para>
  <para style="p">
    <verse number="11" style="v" />“Thou inla, na lupna la inla, na inn ah pai in, k’on chi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in amah a thou a, a lupna a lapah in, avek ua mitmuh in a paita hi; huchi in avek un lamdang a sa mahmah uh, hichibang himhim i mu ngeikei, chi in, Pathian a phat uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a pawt nawn a dilgei ah a paita hi, mipi tengteng a kiang ah a vapai ua, aman thu a na hilh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A paikawm in, Levi, Alphai tapa, siahpiakna mun a tu a mu a, a kiang ah, “Honzuiin” a chi hi. A thou a a zuita hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan hichi ahi a, Jesu’n Levi inn ah an a um a, siahkhawnmite leh mikhialte tampi in Jesu leh a nungzuite a umpih uhi, amah zuite tampi ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pharisaite leh laigelhmite’n Jesu’n mikhialte leh siahkhawnmite kiang a a nek a muh un, a nungzuite kiang ah, “Bangchidan ahia siahkhawnmite leh mikhialte kiang a a nek a a dawn?” a chi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu’n huai a za a, a kiang uah, “Mi chidamte’n daktor a kiphamoh kei ua, midamloute’n a kiphamoh zaw uhi; mi diktatte sam ding a hongpai ka hi kei a, mikhialte sam ding a hongpai ka hi zaw” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Johan nungzuite leh Pharisaite’n an a ngawl zel uhi. Amau a hongpai ua, Jesu kiang ah, “Bangdia Johan nungzuite leh Pharisaite nungzuite’n anngawl ua, nang nungzuite’n a ngolh samlouh uh?” a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu’n a kiang uah, “Moupite kiang a a pasal a omlai teng mou pite’n an a ngawl thei ua hia? A pasal ding a kiang ua a omlai teng a ngawl theikei ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh a pasal a kiang ua kipan pimang nite a hongtung ding a, huai ni chiang in zaw a ngawl ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kuamah in puan lui puan tuikhai nailouh them in a thuap ngeikei uh; thuap le uh, thuap bit a sawmna lam uah a kai kek ding a, a thak in a lui a kai kek ding a, a hong kek semsem ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan kuamah in uain thak, savun uain thawl lui ah a thun ngeikei, uain in savun thawl a phukham ding a, uain a bawbei ding hi, savun thawl mah leng; uain thak savun uain thawl thak ah a thun zaw uh” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan hichi ahi a, Jesu khawlni’n buhlei ah a paisuak hi, a nungzuite’n a paikawm un buhvuite a khiak uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pharisaite’n a kiang ah, “En dih, bangdia khawlni a hihsianglou hih ahi ua?” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman a kiang uah, “David leh a lawmte a taksap ua a gilkial lai ua a thilhih uh na sim kei ua hia?
  </para>
  <para style="p">
    <verse number="26" style="v" />Abiathar siampu lianpen a hihlai a, Pathian inn a a lut a, siampute kia loungal in a nek sianglouh tanghou koihtuam a nek a, a lawmte kiang a a piaksam thu” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan amahmah in, a kiang uah, “Khawlni zaw mihing adia bawl ahi, mihing bel khawlni adia bawl ahi kei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Mihing Tapa zaw khawlni tung nangawn a Toupa ahi” a chi hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan kikhopnain ah a lut nawn a; huai ah khutzaw khat a na om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Amah a hek theihna ding un khawlni a a hihdam nop leh noplouh a enkhia uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman khutzaw kiang ah, “Ding khia in” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a kiang uah, “Khawlni’n hihhoih hia siang, hihsiat? Hotdam hia siang, hihlup?” chi’n a dong hi. Himahleh a daidide uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a lungtang uh tak ziak a lungkham mahmah leh hehkawm a amaute a et velvel nung in, huai mi kiang ah, “Na khutzan in” a chi a, huchi in, a zankheta a a khut a damta hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pharisaite a pawtkhia ua, amah hihlup theihna ding lampi ngaihtuah in Herod pawl a mite toh a kihoukhawm pah uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu a nungzuite toh dil lam ah a paimang ua; Galili gam a kipan mipi tampitak in a zui uhi;
  </para>
  <para style="p">
    <verse number="8" style="v" />A thilhih thupidan a zak un Judia gam a kipan, Jerusalem khua a kipan, Idumai gam a kipan, Jordan gal a kipan, Tura leh Sidon khokim a kipan in mipi tampitak a kiang ah a hongpai uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mipi ziak in amah adia long neu mansa a om ding in a nungzuite a hilh hi, huchilou in zaw honum lutlut ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mipi tampi a hihdamtak ziak in natna nei peuhmah in amah a khoih theihna ding un a boh huthut uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Dawininte’n leng amah a muh un a ma ah khupboh in, “Nang Pathian Tapa na hi” chi in, a kikou uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan a tanchin genthang lou ding in a kiang uah a chi bikbek hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan tang ah a hohtou a, aman a ngaihngaih a sam a; amau a kiang ah a hohtou uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kiang a om ding leh thugen dia a sawlkhiak ding in sawmlehnihte a namkip hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Natnate hihdam ding leh dawite delhkhe ding in thuneihna a pia hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai mite, Simon, Peter, a chih pa;
  </para>
  <para style="p">
    <verse number="17" style="v" />Zebedai tapa, Jakob leh Jakob unau Johan, huai mite Boanerges a chihte; huai omdan tuh vanpiging tapate chihna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Andru, Philip, Bartholomai, Matthai, Thomas, Alphai tapa Jakob, Thaddai, Kanan mi Simon leh,
  </para>
  <para style="p">
    <verse number="19" style="v" />a mansakpa, Judas Iskariot ahi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaizoh in, in khat ah a lut uhi. Huai ah mipi tampi a hong ki khawm nawn ua, huchi in an nangawn leng a ne theikei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a lawmte’n a zak un, “Lungsim buai” chi in amah mat a tum uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Laigelhmi, Jerusalem khua a kipan a hongsukte’n, “Beelzibul a zawl hi, dawite kumpipa ziak in ahi, dawite a delhkhiak” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n laigelhmite a sam a, gentehna in a kiang uah, “Setan in Setan mah bangchi in a delhkhe thei dia?
  </para>
  <para style="p">
    <verse number="24" style="v" />Gam leng amah a kidou leh, huai gam ading khe theikei ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Inkuan khat leng amah a kidou uleh, huaite inkuan ading khe theikei ding uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Setan leng amah kidou a, a kilan leh, ading khe theikei ding a, a mangthang zaw ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuamah in mi hatpa a hen masak phot kei leh inn a lut in a sum a laksak theikei uhi, huai nung in bel a inn a lok mai ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Chihtaktak in k’on hilh ahi, mihing tate, a khelhna tengteng uah leh Pathian a gensiatna bang peuh uah leng a gensiatnate uh ngaihdam ahi ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kuapeuh Kha Siangthou hilhial gensia zaw chikmah chiang in ngaihdam a hi kei ding a, tangtawn khelhna a siamlouh in a omzaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Dawinin a zawl ahi, a chih ziak un huai a gen ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan a nu leh a unaute a hong ua, inn pua ah ading ua; amah sam di’n mi a sawl uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A kim ah mipi tu diamduam te’n a kiang ah, “Ngai dih, inn pua ah na nu leh na sanggampate’n a hon ngak uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman a kiang uah, “Ka nu leh ka samgampate kuate ahi ua?” chi’n a dong hi,
  </para>
  <para style="p">
    <verse number="34" style="v" />A kiang a tute a en vialvial a, “En un, ka nu leh ka sanggampate;
  </para>
  <para style="p">
    <verse number="35" style="v" />kuapeuh Pathian deihlam hih photphot ka sanggampa, ka sanggamnu leh ka nu ahi uh” a chi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan tuipiau ah thu a hilh nawn hi. Mipi tampitak a kiang ah a hong kikhawm ua, huchi in, dil ah long ah a tuang a, a tu a, mipi tengteng tuipiau a leitung ah a om uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan gentehna zang in thil tampi a sinsak a, amah sinsakna dan in a kiang uah,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ngaikhia unla, en dih ua; buhchithehpa buhchi theh ding in a kuan hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan hichi a honghi a, a thehlai in a khen lampi sik ah a kia a, vasate’n a nezou uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A khen suangsilei ah a kia a; lei a sah louh ziak in a pou pah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh ni a hongsuah in haivuai in a hongom a, zung a neih louh ziak in a vuaimang uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A khen loulingnei lak ah a kia a, loupa a hong khang a, buhkungte a depmang a, a gahta kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A khen lei hoih ah a kia a, a pou a, a khanglian a, a gah a; a leh sawmthum a leh sawmguk leh a leh za in a pung chiat uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan a kiang uah, “Kuapeuh zakna ding bil nei in za hen!” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan amah kia a omlai in a kim a omte leh sawmlehnihte’n gentehna thu a dongchian thak uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a kiang uah, “Pathian gam thuguk zaw noute kiang a piak ahi a, pawlam mite ading in bel bangkim gentehna a gen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Muh zaw a mu na ua, theih zaw a theisiam kei ding uh, huchilou in zaw a kihei nawn ding ua, ngaihdam a hong hikha ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan aman a kiang uah, “Hiai gentehna thu na theisiam kei umaw? Huchi a hih in bangchi’n gentehna thudangte na theisiam tuan ding ua?
  </para>
  <para style="p">
    <verse number="14" style="v" />Buhchithehpa’n thu a theh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lamsik a thu theh hiai bang ahi uh; thu a zaktak un Setan kintak a hongpai in a lungtang ua thutheh a lakmangsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi bangmah in suangsilei a theh hiaite ahi uh; thu a zak phet ua kipaktak a pom pahte.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh amau ah zung a neikei ua, sawtlou chik kia a om uh; huai nung in thu ziak a gimthuakna hiam sawina hiam a hongom phet in a kipukpah pah uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan midangte loulingnei lak a theh bang ahi uh; huaite’n thu a zata ua,
  </para>
  <para style="p">
    <verse number="19" style="v" />himahleh khovel lunggulhnate, thildang duhgawlnate a honglut chiang in, thu a dep a, gahlou in a om hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in lei hoih a kia hiaite ahi uh; thu za a, pom, a leh sawmthum, a leh sawmguk, leh a leh za a gahte ahi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a kiang uah, “Mi’n khawnvak de in a koihna a koihlou in, lawh nuai hiam, lupna nuai hiam ah a koih ngei ua hia?
  </para>
  <para style="p">
    <verse number="22" style="v" />Thanglou ding a im bangmah a om ngeikei a, langlou ding a sel bangmah a omsam kei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuapeuh zakna ding a bil nei peuh in za hen” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a kiang uah, “Na zak uh bang ahia, pilvang un; na tehna ngei mah ua tehsak in na om ding ua, a tamzaw bawn piak in na om ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuapeuh a nei piak behlap in om ding ua, kuapeuh a neilou a neihsun nangawn laksak in om ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Pathian gam tuh min lei a chi a tuh bang ahi a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zan chiang in a ihmu a, sun chiang in a thou zel a; chi pou in a na khang a, himahleh bangchi a pou a, khang ahia chih a theikei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lei in amah in gah a honsuah a; a masapen in akung, huan avui leh avui ah atang hongom hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Himahleh a gah a min chiang in, buhlak a huntak ziak in, kawite in a atpah uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan “Pathian gam bang toh i tehpih dia? Ahihkeileh, bang gentehna in ahia i genteh ding? a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ankam chi tangkhat lei a a tuh un, lei a chi tengteng sang in neupen mahleh,
  </para>
  <para style="p">
    <verse number="32" style="v" />A tuh nung un a hongpou a, loupa tengteng sang in a honglian zawta a, hiang liantak a honnei a, huchi in tungleng vasate a lim ah a giak uhi, huchi mah bang ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan huchibang gentehna thu tampi in, a theihsiam theih khomkhom uh, a kiang uah a gen zel hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Himahleh gentehna lou in zaw a kiang uah thu a gen ngeikei; amah nungzuite kiang ah a sim in bangkim a hilhchian zel hi
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai ni mah nitaklam a hong hih in, a kiang uah “Galkhat lam i kai ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in mipite paisan in, a om ngeingei bang in, long ah a paipih pah ua, long dangte leng a kiang ah a om uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huchi in huihpi thupitak a hongnung a, tuikihotte long ah a hong kihot lut zuazua hi, huchi in long a hong dimta hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amah lukham kham a ihmu in, longmei lam ah a om hi. Huan a phawng ua a kiang ah, “Heutupa, ka manthat uh khawksalou na hi maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Amah a hongthou a, huih a tai a, dil kiang ah leng “Dai inla, om kinken in” a chi hi. Huan huih a tawp a, a hong daidide hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman a kiang uah, “Bangchi a hichitel a lau na hi ua oi? Ginna neilou na hi umaw?” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huchi in lau petmah in a lau ua, “Hiai mi kua ahia le, huih leh dil nangawn in a thu a man uh?” a kichi uhi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan dilgal, Gerasin mite gam a hongtung uhi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Long a kipan a pawtnung in dawininpai khat, han a kipan a hongpawt in amah a natuak pah hi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai mi han ah a om zel; kuamah in sik khainiang nangawn a hen theilouh uh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sikkol leh sik khainiang in a hen ua; himahleh sik khainiang a bottat a, sikkol leng a hihtan zel a; kuamah in a khoizual zou kei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Sun leh zan in han leh tang ah a kikou kou a, suang in a ki-at hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan gamla tak a kipan Jesu a muhtak in a tai a, amah a bia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan aw ngaihtak a kikou in, “Jesu, Pathian Tungnungpen Tapa, kei leh nang bang ahia i kizolhna om? Hon gimsak lou ding in Pathian min in nget chihtak in k’on ngen hi” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu’n a kiang ah, “Nang, dawininpai, hiai mi sung a kipan pawt in” a na chita hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan aman “Na min bang ahia?” chi’n a dong hi. Aman, a kiang ah “Ka min nuai ahi, tampi ka hih ziak un” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai gam apat amau sawlkhe lou ding in Jesu kiang ah nakpi’n a ngen hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan huailai a tangpang ah vokhon tampi a ta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Dawininte’n, “Vok sung ah honsawl in, asung ua ka lut theihna ding un” chi in, a kiang ah a ngen uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman thu a pia a, huchi in, dawininte a pawt ua, vok sung ah a lut ua; vokhon, sang nih phial ahi ua, ken ah a taisuk ua, dil ah a tailutta ua; dil ah tuihak in a sita uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan vok anpete a tai ua, khua leh lou ah a gen ua, huai thil hongom bang ahia chih en ding in mite a hong taikhawm uhi,
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu kiang a hongtung ua, dawimatpa, a lungsim ngei pu leh puansilh a huai a tu a mu ua, huchi in a a lauta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A ma ua mute’n, dawimat tung a thiltun dan leh vok tanchin amaute a na hilh uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan amau a gam ua kipan a pawt ding in a ngenta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan long a a lut in dawininpaipa’n amah kiang a omsak din a ngen hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh Jesu’n a phalkei a, a kiang ah, “Na inn a na lawmte kiang ah pai inla, Toupa’n nang dia thil hon hihsak a thupidan leh nang a hon lainat dan vahilh in” a chi zaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan a pai a, Dekapolis khua ah Jesu’n amah dia thil a hihsak thupidan a tangkoupihta hi. Huan mi tengteng in lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu long a galkhat lam a a hong kainawn in mipi tampitak a kiang ah a hong paikhawm ua, amah dilgei ah a om hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in kikhopnain a vaihawmte lak a mi khat, a min Jaira, a hong a, Jesu a muhtak in a khebul ah a khupboh hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Ka tanu naupang chik a si dekdek a; hongdam a, a hin theihna ding in hongpai a a tung a na khut koih ding in k’on ngen hi” chi in, nakpi’n a thum hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in Jesu a kiang ah a vahoh a, mipi thupitak in zui in, amah a boh lutlut uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan numei khat kum sawmlehnih sipawt a damlou a om hi,
  </para>
  <para style="p">
    <verse number="26" style="v" />Daktor tampi lak ah nakpitak a thuak in, a neih tengteng a zangbei khinta a, phattuam naksang in a se zawsop hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huai min Jesu tanchin a naza a, a nung ah mipi lak ah a hongpai a, a puanmong a khoih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“A puanmong kia khoih leng hihdam in ka om mai ding” a lungsim in a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan thakhat in a sipawt a kam ngal a, a natna hihdam ahi chih a sa ah a kitheita hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu’n, asung a kipan thilhihtheihna a pawt chih a thei a, milak ah a kihei vialvial a, “Kua ahia ka puanmong khoih?” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A nungzuite’n a kiang ah, “Mipi’n a honboh lutlut uh mu chin a, kua ahia hon khoih? Bangchidan a chi na hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman huai thilhihnu muh tum in a en vialvial hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in numei in a tung a thil a hihsak thei in, lau leh ling kawm in a hongpai a, a ma ah khupboh in, a kiang ah thudik a hilhvek hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman a kiang ah, “Tanu na ginna dampih na hi, khamuangtak in pai inla, na natna a kipan na damta in” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />A pau laitak in kikhopnain a vaihawmpa inn a kipan mi a hongpai ua, “Na tanu sita hi, sinsakpa hihbuai lailai ding na hiam?” a chi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jesu’n a thugen uh ngeingaih lou in, kikhopnain a vaihawmpa kiang ah, “Lau ken, gingta mai in” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Peter, Jakob, leh Jakob unau Johan chih louhngal midang kuamah in amah a zuih uh a phal kei hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan kikhopnain vaihawmpa inn a tung a, Jesu’n a na buai vengvung, kap vengvung leh a mau vengvung a za hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A valut a, a kiang uah, “Bangdia bil am zen a kap na hi ua? Naupang silou hi, a ihmu ahizaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan amah a nuihsan maimah uhi. Himahleh aman avek un a delkhia a, naupang omna ah a valut hi,
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan naupang khut a len a, a kiang ah, “Talitha kumi” a chi a, “Nungaknou, thou in, k’on chi” chihna ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan numei naupang a thou a, a paipah ngal a; amah kum sawmlehnih mi ahi hi. Huan amau lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aman a kiang uah, “Hiai kuamah in theikei hen” a chi bilbel hi, nekding piak ding thu a pia hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan huai a kipan a pawt a, a omna kholam a tungta a; a nungzuite’n a zui uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Khawlni a honghi a, kikhopnain ah thu a hilh a; mi tampi a thu zate’n, “Hiai min hiai thu koi a kipan a muh ahia? Hiai mi kiang a pilna piak bang pilna ahia? A khut in hichi tel a thillamdang a hih bangchidan ahia?” a na chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai mi Mari tapa, Jakob, Joses, Juda leh Simon sanggampa, singlem bawlpa ahi ka hia? A sanggamnute leng hiai a i kiang ua om ahi kei ua hia?” a chi ua, lamdang a sa mahmah uhi. Huchi in, a tung ah a lungkim kei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n a kiang uah, “Zawlnei zaw amah kholam ah, amah inkawte lak ah, amah inn kia loungal ah pahtawi louh in a om ngeikei” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan, midamlou tawmchikte tung a khut koih a a hihdam kia loungal huai ah thil thupi ahihkei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A gintak louh uh lamdang a sa mahmah hi. Huan, thuhilh kawm in khuate a tawn vialvial hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan sawmlehnihte a sam a, nihnih in a sawlkhia a; dawininte tung a thuneihna leng a pia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zinna ua ding in chiangkhun kia loungal bangmah tanghou leh kawlzal leng, a kawnggak ua dangka tawilouh ding a chi bikbek hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khedap bel but ding a chi a; puanak nih silh kei un, a chilai hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan a kiang uah, “Koipeuh ah leng na tunna inn uah, huai kipan na pawt mateng uh tung kinken un
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan koi khua peuh in a hon kipahpih kei ua, na thu uh a ngaihkhiak kei ua leh huai a kipan na pawt chiang un, amau mawhpaih ding in, na khepek nuai ua leivui kai na tatkhe ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in a paikhia ua, mite a kisik ding uh ahi chih a gen uhi
  </para>
  <para style="p">
    <verse number="13" style="v" />Dawi tampi leng a delhkhia ua, damlou tampi leng thau a nilh ua, a hihdam uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan kumpipa Herod in a naza a, a min a than ziak in, “Baptispa Johan, misi lak apan thounawn a, huaiziak in huai thilhihtheihnate’n amah a sem ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Midangte’n bel, “Elijah ahi, a chi ua; midangte’n, malai zawlneite bang zawlnei khat ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Herod in bel a na zak in, “A lutang ka tanpa ngei, hong thounawnta ahi,” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Herod in a unau Philip zi Herodia ziak in mi a sawlkhia a, Johan a mansak a, suangkulh ah hen in a na khumkhinta hi. Herodia zi in a na neita ngal a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Johan in, Herod kiang ah, “Na unaupa zi na neihsak sianglou ahi” a na chih khit ziak in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaiziak in Herodia in amah a mudah a, hihlup a ut a, himahleh a hih theikei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Herod in, Johan midiktat leh siangthou ahi chih a theih ziak in amah a kihta hi, amah a en a, a thu a zak in, thil tampi a hih a, kipaktak in a ngaikhia hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Herod in a pian ni’n a mi thupite, sepaihheutu liante, Galili gam a miliante ading a zana Ankuang a luilai in hunlemtang a hong omta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Herodia tanu a honglut a, a lam a, Herod leh a Ankuang umpihte a kipaksakta hi. Kumpipa’n numei naupangnu kiang ah, “Na deihdeih hon ngen in, k’on pe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Bangpeuh n’on nget phot, ka honpe ding, ka gam kimkhat nangawn leng” chi in a kiang ah a kichiam hial hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amah a pawt a, a nu kiang ah, “Bang ka ngen dia?” a vachi hi. A nun, “Baptispa Johan lutang” a na chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan amah kintak in kumpipa kiang ah a valut paha, “Kuang in Baptispa Johan lutang n’on piak pah ka ut” chi in, a ngen hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan kumpipa a lungkham mahmahta a; himahleh a kichiamna leh a Ankuang umpihte ziak in a sel nuam kei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan kumpipa’n amah vengte lak a sepaih khat a lutang vala ding a thupia in a sawlpah hi. Amah suangkulh ah pai in a lutang a vatan kheta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huai lutang kuang in a hontawi a, numei naupang kiang ah a pia a, huan numei naupang in a nu kiang ah a peta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan a nungzuite’n a zak un, a luangla in, han ah a vuita uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan sawltakte Jesu kiang ah a hong kikhawm ua, thil bangkim, a thil hihpeuh uleh a thuhilh peuh uh, a honghilh uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman a kiang uah, “Noumau kia in gamdai mun ah a tuam in hong unla, khawl tadih un” a chi hi. Mipi a tam a, a kuan leh a pai a kiphamat ua, an nangawn leng a ne mankei uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in gamdai mun ah long in a paimangta uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mite’n a pailai uh a mu ua, mi tampi in amau a thei ua, khochih apat huai ah khe in a taikhawm ua, a na makhelhta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in amah hong paikhiak in mipi tampitak a muta a, ching ding neilou belamte bang a hih ziak un a lainat mahmah a, thu tampi a hilhta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan ni a kai mahmahta a, a nungzuite a kiang ah a hong ua, “Hiai gamdai mun ahi a, ni a kaita mahmah hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />I kim a loute leh khuate ah hoh a, a nekding uh banghiam bek a lei theihna ding un amaute paisak ta in” a chi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman bel a kiang uah, “Noumau nekding pia un” chi in, a dawng hi. Amau a kiang ah, tanghou makhai za nih man valei in nekding peding ka ding uam?” a chi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman a kiang uah, “Tanghou phel bangzah na nei ua? Hon en dih ua” a chi a. Huan a neihzah uh a theihtak un, “Nga leh ngasa nih toh” a chi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan aman, avek un, loupa hing tung ah a pawlpawl a tusak ding in a kiang uah thu a pia hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Vual za khat, sawmnga, zel in a tu uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan aman tanghou phel nga leh ngasa nih a la a, vanlam en in a vualzawl a, tanghou phelte a balkhama, a ma ua lui ding in a nungzuite kiang ah a pia a; ngasa nih leng huaite tengteng lak ah a hawmzak hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Avek un a ne ua, a kham chiat uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan tanghou leh ngasa nente bawm sawmlehnih a dim hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Tanghou phel nete pasal piching ngen sang nga ahi uh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan mipi a kikhensak nung in galkhat lam a Bethsaida khua a na pai masa ding in a nungzuite long ah a tuangsak teitei hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Amau a kikhensak nung in thum ding in tang ah a hohta hi,
  </para>
  <para style="p">
    <verse number="47" style="v" />Nitaklam a hong hih in, long dil laitak ah a omta a, amah kia in gam ah a om hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Long kalh a mangbang in amaute a mu a, huih in a hilou lam ah a sep hi. Huchi in zanven lina ding kuan in dil tung a khe a pai in amau lam a honzuan a, amau paisuak san a tum hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Himahleh amah dil tung a khe a pai a muh un sikha sa in, a kikou khia uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Avek un amah a mu ua, a lau mahmah uhi. Himahleh aman amau a houpih paha, a kiang uah, “Khamuangtak in om un, keimah ka hi, lau kei un” a chi hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan long ah a kiang uah a tuangtou sam a, huih a dai maimah hi. Huan lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />A lungtang uh a khauh ziak in tanghou beu thillamdang thu a ngaihtuah ban kei uhi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huan galkhat lam a kai un Gennesaret gam a tung ua, luipiau ah long a khih uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Long a kipan a pawt nung un mite’n amah a na theipah uhi,
  </para>
  <para style="p">
    <verse number="55" style="v" />Huai gamkim tengteng ah a tai ua, a om chih a zakna peuh uah damloute a lupna un a honzawng hial uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Huan khoneu leh kholian ah khopi leh khota leh koipeuh ah leng a lutna ah damloute, dawlmun ah a lumsak ua, a puanmong bek khoihsak din a ngen ngutngut uhi. Huan amah khoih peuhmah a dam uhi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Pharisaite leh laigelhmite lak a mi kuate hiam, Jerusalem khua a kipan a kiang ah a hong kikhawm uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huaite’n nungzui khenkhatte’n khut ninpi a tanghou a nek uh a mu ua, nin, chih tuh, sillou, chihna ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pharisaite leh Juda tengteng in Upate thugousiah a pom chinten ziak un a khut uh hoihtak a a silkei uleh a ne ngeikei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dawlmun a kipan a a pai un leng a kisil phot kei uleh a ne ngeikei uhi. Huan thugousiah dang tampi a chin uh a om, nou, bel, taubelte sil thute ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Pharisaite leh laigelhmite’n, “Bang achia na nungzuite’n upate thugousiah bang a omlou a, khut ninpi a tanghou ne uhiam” chi in, a dong uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman a kiang uah, “Isai in nou milepchiahte thu a na genkhol dik hilhial ve, ‘Hiai mite’n a muk un a hon zahtak ua, a lungtang un hon gamlat uh’ a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘Mihing thupiakte a sinsak lel ziak un a hon biak uh a thawn ahi,’ chih gelh bang in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian thupiakte nelhsiah in mihing thugousiah na len chinten ua eive” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kiang uah, “Na thugousiah uh na zuih theihna ding ua Pathian thupiakte na deihlouh uzaw, lem na thei hial ve ua.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mosi in, Na nu leh na pa zahtak in, Kuapeuh a nu hiam a pa hiam gensia si mahmah hen, a chi a;
  </para>
  <para style="p">
    <verse number="11" style="v" />Nou hichibang in na chi ua, min, a nu hiam, a pa hiam kiang ah, n’on phatuampihna ding Korban ahita, a chih leh, huai tuh Pathian kiang a piak, chihna ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A nu ading hiam, a pa ading hiam a bangmah hihsak na phal nawn kei nak uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Na thugousiah uh na piak sawnsawnna un Pathian thu bangmahlou na suah uhi; huai bang thil tampi na hih uh” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan mipite a sam nawn a, a kiang uah, “Na vek un ka thu ngaikhia unla, theisiam un:”
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihing pawlam a kipan asung a lut amah hihnin thei bangmah a omkei; mihing sung a kipan a hongpawt, huaite mihing hihnin ahizaw hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuapeuh zakna ding bil nei in, za hen!” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mipite inn a a lutsan nung in a nungzuite’n gentehna thu amah a dong chian uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman a kiang uah, “Nou leng huchitel a theihsiamna neilou na hi u maw? Bangpeuh pawlam a kipan a mihing sung a lut in amah a hihnin theikei chih na theikei ua hia?
  </para>
  <para style="p">
    <verse number="19" style="v" />A lungtang sung a lutlou a, a gilpi sung a a lut zawk ziak in leh dailenna a pawt khemai a hih ziak in” a chi a. Huai tuh an chiteng a siang, a chihna ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing sung apan hongpawt, huai ngeingei in mihing a hihnin nak ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihingte sunglam lungtang a kipan in, ngaihtuahna giloute a hongpawt nak hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />Kingaihna, guktakna, tualthahna, angkawmna leh enna, gitlouhna, khemhatna, bevenna, hazatna gensiatna, kisaktheihna leh, haihuainate ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiai thilgiloute tengteng sunglam a kipan a hongpawt a, mihing a hihnin nak hi” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a thou a, huai a kipan in Tura leh Sidon uk ah a paita hi. Inn ah a lut a, kuamah theih a deihkei a; himahleh a kisel theikei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in numei khat, a tanu naupang chik dawininpai in, a tanchin a naza a, a khebul ah a khupboh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Numei Grik mi ahia, Siriaphoinisia gam a piang ahi. Aman a tanu sung a kipan a dawi delhkhe ding in a ngen hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman a kiang ah, “Tate hongvah masa uhen aw; tate tanghou laksak a uite kiang a paih kilawmlou hi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Numei in a kiang ah, “Toupa, hihzaw ahi a, himahleh dohkan nuai a uite’n leng tate tanghou nen a ne zel sam vaw oi” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman, a kiang ah, “Na thugen ziak in paita in: dawi na tanu sung a kipan a pawtta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan a inn ah a paita, a tanu, dawi in a pawt khiaksan, lupna a lum a va muta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan Tura gam a kipan a pawtnawn a, Sidon khua tawn in Dekapolis gam Paikan in Galili dil a tungta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi khat bengngong, pau leng pau kichian theilou a kiang ah hon tonpih ua, a tung a khut koih ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Aman mipi lak a kipan in amah kia in a pituam a, a khut zungte in a bilsung a khoih a, chilsia in a lei a khoihsak hi;
  </para>
  <para style="p">
    <verse number="34" style="v" />Vanlam en in a khoisa huthut hi. Huan a kiang ah “Ephatha” a chi a; huai bel, “Kihongta in” chihna ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in a bilte uh a hong kihong a, a leigakna leng a hong kiphel a, chiantak in a pautheita hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />A kiang uah, kuamah hilhlou ding a chi bikbeka; himahleh a nak kham phet in, a nak tangkoupih zawsem uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Aman bangkim hoihtak in a hih a; bengngongte nangawn a pausak zel,” a chi ua, lamdang a sa mahmah uhi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai nite in, mipi tampitak a hongom nawn ua, nekding bangmah a neikei ua, aman a nungzuite a sam a, a kiang uah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mipite tuin ka kiang ah ni thum a omta ua, nekding bangmah a neih louh ziak un ka lainat mahmah hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Anngawl in a inn uah paisak leng lamkal ah a bah kha ding uh; khenkhatte houh a hongpaina uh a gamla mahmah hi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A nungzuite’n, “Mi’n hiai gamdai ah koi a tanghou in ahia hiai mite a hihtai theih ding uh?” chi in amah a dawng uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan aman, “Tanghou phel bangzah na nei ua?” chi in, amau a dong a. Amau, “Phel sagih” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan mipite lei a tu ding in thu a pia a; tanghou phel sagih a la a, kipahthu a genkhit in a balkham a, a ma ua lui ding in a nungzuite kiang ah a pia a; huchi in mipite ma ah a luita uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngasa tawmchik leng a nei ua; aman a vualzawl a, huaite leng a ma ua lui ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in a ne ua, a kham chiat ua; a khamval nen uh bawm sagih dim in a luak uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau sang li vel ahi ua; aman amaute a paisakta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah bel a nungzuite kiang ah long ah a tuangpah a, Dalmanutha gam a tungta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharisaite a hongpai ua, amah ze-etna ding in, amah apan van a kipan a chiamtehna zong in amah a hong sel uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan amah a lungsim in nakpi’n a nak kuaikuai hi, “Bang a chia hiai khangte’n chiamtehna zong uh ahia? Chihtaktak in k’on hilh ahi, hiai khangte kiang ah chiamtehna himhim piak ahi kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in amaute paisan in long ah a tuang nawn a, galkhat lam ah a paita hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a nungzuite’n tanghou a tawi mangngilh ua, tanghou phel khat kia lou ngal long ah tanghou dang himhim lah a neikei uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan, aman a kiang uah, “Pharisaite silngou leh Herod silngou lak ah kiveng unla, pilvang un,” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amau, “tanghou i neih louh ziak eive” chi in a a kingaihtuah uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Jesu’n huai a theih in, a kiang uah, “Bangdia tanghou na neih louh ziak ua kingaihtuah na hi ua? Tu nangawn in na theisam kei u maw? Theisiam lou lai maw? Na lungtang uh na khauhsak ua hia?
  </para>
  <para style="p">
    <verse number="18" style="v" />Mit nei napi in na mu kei ua hia? bil nei napi in na za kei ua hia? theigige lou maw?
  </para>
  <para style="p">
    <verse number="19" style="v" />Sang nga lak a tanghou phel nga ka balkhap lai in a nen bawm bangzah ahia na luahdim uh?” a chi hi. Amau, “Sawmlehnih,” a chi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan sang li lak sagih ka balkhap lai in, a nen bawm bangzah ahia na luahdim uh? a chi a. Amau a kiang ah, “Sagih” a chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman a kiang uah, bangchidan a tu nangawn a theisiam lou lailai na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai nung in Bethsaida a hongtung uhi; Huan a kiang ah mittaw a honpi ua, amah khoih ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman mittaw khut a len a, khua a kipan a pikhia hi; a mit ah chilsia in a tung a khut a koihkhit in, “Khua na mu thei hia?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amah hong dak khia a, “Mite ka mu; singkung pai bang in ka mu” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A mit ah a khut a koihnawn a, aman a en gegu a, a hong dam maimah a, bangkim chiantak in a mu theita hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan Jesu’n, khua ah leng lut ken chi in, a in ah a paisakta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan Jesu leh a nungzuite a hongpai zel ua, Kaisaria Philippi khua te a hongtung ua; huan paikawm in a nungzuite kiang ah, “Mite’n kei kua ahi a honchi ua?“ chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amau “Baptispa Johan ahi, a honchi ua; midang in Elijah ahi, a honchi ua; khenkhat in bel, zawlnei kuahiam ahi, a honchi uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan aman a kiang uah, “Ahihleh nou kei kua ahi n’on chi ua?” chi in, a dong hi. Peter in a kiang ah “Khrist na hi” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan aman a tanchin kuamah hilhlouh ding in a chi bikbek hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan Mihing Tapa in thil tampi a thuak dingte, upate, siampu liante, laigelhmite deihlouh a a om ding, hihlup a a om ding leh ni thum nung a a thohnawn ding thute amau a hilh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huai thute chiantak in a gen hi. Huan, Peter in amah a pituam a, a tai hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amah bel a hong kihei a, a nungzuite muh in, Peter a tai a, “Setan, ka nung ah pai in, Pathian thilte ngaihtuahlou in, mihing thilte na ngaihtuah zaw” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan mipite, a nungzuite toh a sam a, a kiang uah, “Kuapeuh in honzuih a ut leh amah kimangngilh in, a Kros pua in honzui hen.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kuapeuh a hinna humbit ut in a tan ding a; kuapeuh keimah ziak leh Tanchinhoih ziak a a hinna tan in a humbit ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Min khovel a pum in a nei henla, a hinna tan leh, amah ading in bang a phatuam dia?
  </para>
  <para style="p">
    <verse number="37" style="v" />Min a hinna tang in bang a pe thei dia?
  </para>
  <para style="p">
    <verse number="38" style="v" />Kuapeuh tulai khang angkawm leh gilou chingte lak a keimah leh ka thu zumpih, Mihing Tapa in, angel siangthoute toh a Pa thupina a kivan a a hong hun chiang in, huai mite a hon zumpih thuk sam ding” a chi hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan a kiang uah, “Chihtaktak in k’on hilh ahi, hiai ading a khen, Pathian gam thilhihtheihna toh hongtung a muh ma ua, sihna chiamlou ding a om uh” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan ni guk nung in Peter, Jakob, leh Johan a pituam a, tangsangtak ah Jesu’n a paitouhpih a; a ma uah a mel omdan a hong lamdangta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in a puansilhte lei a puansawpmi’n in a sawp ngou theihlouh khop hial a ngou velvol in a hong lamdangta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Elijah leh Mosi a kiang uah a hong kilak ua, Jesu toh a kihou uhi,
  </para>
  <para style="p">
    <verse number="5" style="v" />Peter in Jesu a houpih a “Heutupa, ei din hiai a om a hoih; aidakbuk thum i lam ding a, nang adin khat, Mosi adin khat, Elijah adin khat” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lau mahmah ziak un a genpen leng a theikei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan amau liah in meipi a hong kai a; meipi apan aw a hongsuak a, “Hiai ka Tapa deihtak ahi, amah thu ngai un” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kintak in a kimvel a en ua, a kiang ua Jesu kia lou kuamah a muta kei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan tang a kipan a paisuk lai un, “Mihing Tapa misi lak a kipan a thohnawn khit mateng a thilmuhte uh kuamah hilh louh ding” a chi bikbek hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in huai thu a vom kinken uhi, Misi lak apat thohnawn pen bang chihna hi ding ahia chih a kidong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan amau a kiang ah, Bangchidan a laigelhmite’n, “Elijah a hongpai masa ding ahi” chi ahi ua? chi in, a dong uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman a kiang uah, “Bangkim bawlhoih thak ding in Elijah a hongpai masa him ahi; ahihleh thil tampi a thuak ding a, muhdah a mawkbawl in a om ding chi a mihing Tapa tungthu bangchidan a gelh a na om ahia leh? a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh k’on hilh ahi, Elijah zaw a hongpai khinta hi, a tanchin a gelh bang ngei un a tung ah a utut un a hihkhinta uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan nungzuite kiang a tunsuk in, a kim ua mipi tampite leh laigelhmite a na kisellai uh a mu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mipi tengteng in amah a muhtak un lamdang a sa mahmah ua, a kiang ah a taipah ua, chibai a vabuk kheukhou uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Aman a kiang uah, “Amaute toh bang thu ahia na kisel uh?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mipi lak a mi khat in a kiang ah, “Sinsakpa, ka tapa, dawi pautheilou nei, na kiang ah ka honpi a;
  </para>
  <para style="p">
    <verse number="18" style="v" />A matna peuh ah a puksak ekek a; huchi in a chilphuan kia in, a ha a gawi a, a gawng hulhul hi; na nungzuite’n delhkhe le uh ka chih leh a delhkhe theikei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman a kiang uah, “Ginna neilou khangte aw, Bang tan na kiang ua om ding a bangtan hon thuakthei ding ka hia? Amah ka kiang ah honpi un” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan amah Jesu kiang ah a honpi ua; dawi in amah a muhtak in naupang nakpi’n a sawisa paha; huchi in lei ah a puk a, a chilphuan ke zezu in a kikhuk volvol hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan aman a pa kiang ah, “Hichibang a a hong kipatna bang tan ahita a?” chi in, a dong hi. Aman, “A naupanlai a kipan ahita”
  </para>
  <para style="p">
    <verse number="22" style="v" />“Huchi in amah hih mangthang ding in tamveipi mei ah leh, tui ah a sawnpuk a; himahleh nang bangchi chi hiam bek a na hihtheih leh hon hehpih inla, hon huh in” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a kiang ah, “Na hihtheih leh e, a gingtami ading in bangkim hihtheih ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in naupang’ pa’n khitui toh, “Toupa, ka gingta hi, ka ginlahna hon huh in” chi in a kikou khia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n mipi hong taikhawm a muh in, dawinin a tai a, a kiang ah, “Nang dawi pautheilou leh bengngong, thu ka honpia hi, asung apat pawt inla, lut nawn ken” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in a kikou kheta a, nakpitak a a sawikhit in a pawtta a, naupang misi bang in a om a; huchi in mi tamzawte’n, a si ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesu’n a khut a len a, a kaithou a; huan a hong thou maimahta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan Jesu inn a a valut leh a nungzuite’n “Bangchi a kou delhkhe theilou ka hi ua? chi in a sim in a dong uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman a kiang uah, “Hichibang zaw thumna leh anngawlna kia loungal in bangchi mah in a pawt theikei” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan huai a kipan a paikhia ua; Galili gam a paikan ua, kuamah theih a deihkei uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A nungzuite a sinsak lai a hih ziak in a kiang uah “Mihing Tapa mihingte khut a matsak in a om dia, a that ding ua; a hihlup nung uh ni thum nung in a thounawn ding” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Himahleh a thugen a theisiam kei ua, amah lah a dong ngam kei uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan Kapernaum khua a hongtung ua; insung a a omlai in, amau kiang ah, “Lampi a bangthu ahia na kisel uh?” chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Lampi ah, i lak uah kua i thupipen dia? chi a a na kisel khit ziak un a daidide uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan amah a tu a, sawmlehnihte a sam a, a kiang uah, “Kuapeuh in masapen hih a ut leh mi tengteng sang in nanungpen in a om ding ahi, mi tengteng nasem in a om ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan naupang chik khat a kai a, a lak uah a dingsak a: a pom a a kiang uah,
  </para>
  <para style="p">
    <verse number="37" style="v" />“Kuapeuh ka min ziak a hiai bang naupang chik khat sang keimah hon sang ahi a, kuapeuh kei hon sang kei hon sang ahi kei ding, hon sawlpa sang ahizaw uh” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Johan in a kiang ah, “Sinsakpa, kuahiam na min a dawite delhkhia ka mu ua; a hon zuih louh ziak in ka kham uh” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesu’n “Kham nawn kei un; kuamah ka min a thil thupi hih kei hon gense pah thei a omkei hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Kuapeuh ei hon dou lou i lam a pang ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Kuapeuh Khrist mi na hih ziak ua tui nou khat dawn ding honpia, chihtaktak in k’on hilh ahi, a kipahman a tan kei hial ding hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Huan kuapeuh hon gingta neu chikte lak a khat leng hihpuk, a ngawng ah buhgawizanna suang lianpi oksak in tuipi ah khele uh, amah ading in a hoihzaw ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan na khut in a hon hihpuk leh, tankhia in; melhem a hinna a lut nang ding in a hoihzaw, khut nih nei a gawtmun mei mittheilou a pai sang in,
  </para>
  <para style="p">
    <verse number="44" style="v" />A than uh a sih louh a, meikuang mihlouhna ah.
  </para>
  <para style="p">
    <verse number="45" style="v" />Na khe in a hon hihpuk leh, tankhia in, khe nih nei a gawtmun a paih a om sang in, khebai a hinna a lut nang ading in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />A than uh a sih louh a, meikuang a mihlouhna ah
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan na mit in a hon hihpuk leh, khelkhia in; mit lang nih nei a gawtmun a paih a om sang in mit langkhat nei a Pathian gam a lut nang ading in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />A than uh sih ngeilouhna leh mei mih ngeilouhna ah.
  </para>
  <para style="p">
    <verse number="49" style="v" />“Michih mei a soh al in a om ding uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Chi a hoih hi; himahleh, chi a pen khit leh bang in na hih al nawn ding ua? Noumau ngei ah chi nei unla, khat leh khat kilem in om un” a chi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan ading a, huai a kipan Judia gam ah leh Jordan gal ah a paita hi. Mipite a kiang ah a hong kikhawm ua; huchi in, a hih ngei dan in amau thu a hih nawn hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pharisai khenkhat a kiang ah a hong ua, amah ze-etna ding in, “Min zi a mak a siang hia?” chi in, a dong uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman a kiang uah, “Mosi in bangchi’n thu a honpia a?“ chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amau, “Mosi in kimakna laigelh a mak a phal hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh Jesu’n a kiang uah, “Na lungtang khauh ziak un ahi huai thupiak nou adia a hon gelhsak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh leitung piantung a kipan, Pathian in amau numei leh pasal a siam hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai thu ziak in pasal in a nu leh a pa a paisan ding a, a zi a len chinten ding;
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in, a nih un sa khat a hong hita ding ua; nih ahi nawn ta kei ua, sa khat a honghi zawta ding uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huaiziak in Pathian in a gawmsa mihing in khen kei hen” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan inn ah a nungzuite’n huai thu amah a dong nawn uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a kiang uah, “Kuapeuh a zi ma a, midang nei in a zi ang a kawm san hi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman leng a pasal khen a, midang a neih leh, angkawm ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mite’n a khoih ding in naupang neute a honpi ua; himahleh nungzuite’n huai mite a na tai uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh Jesu’n huai a muh in a lunghi kei mahmah a, nungzuite kiang ah, “Naupang neute ka kiang ah hon paisak unla, kham kei un; Pathian gam hichibang mite a ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chihtaktak in k’on hilh ahi, “Kuapeuh Pathian gam naupang neute’n a kipahpih bang a kipahpihlou asung ah a lut kei hial ding” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan amau pom in, a tung uah a khut koih in a vualzawlta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan pai ding a a pawtlai in mi khat amah lam ah a hongtai a, a ma ah a khukdin a, a kiang ah, “Sinsakpa hoih, tangtawn hinna ka tan theihna ding in bang ka hihdia?” chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Jesu’n a kiang ah, “Bangdia hoih honchi? Mi khat kia loungal kuamah hoih a omkei uh, huai Pathian ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thupiakte na thei vaw oi; tualthat ken, angkawm ken, gu ken, hek ken, khem ken, na nu leh na pa zahtak in, chihte” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman a kiang ah, “Sinsakpa, huai tengteng ka naupan lai a kipan ka zuita” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu’n amah a en a, a it ta a, a kiang ah, “Hih ding khat neilai chia; pai inla, na neih peuhmah zuak inla, tagahte kiang ah pia in, huchi in van ah gou na nei ding; huan hongpai inla, honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh, huai thu ah a mel a hong mual a, lungkhamtak in a paimangta; mi hausa a hih ziak in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a en vialvial a, a nungzuite kiang ah, “Mi hausate ding in Pathian gam lut haksat tuak na mai e” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nungzuite’n a thugen lamdang a sa mahmah uhi. Jesu’n a kiang uah, “Naute aw, hauhna muangte adin Pathian gam a lut a haksa ngei e.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihausa Pathian gam a lut sang in sangawngsau phim bilvanga lut paisuak a baihlam zaw” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amau lamdang a naksak mahmah ua, a kiang ah, “Ahihleh, kua hotdam ahi thei dia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jesu’n amau a en a, “Huai zaw mihing adin hihvual ahikeia, Pathian adin bel hih vuallouh ahi kei: Pathian adin bangkim hih theih ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peter in a kiang ah, “Ngai dih, kou bangkim paisan in k’on zui ua” chi’n a genpan hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n “Chihtaktak in k’onhilh ahi, kuapeuh keimah ziak leh Tanchinhoih ziak a inn, unaupate, unaunute, nu, pa, tate leh gamte paisan,
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu damsung mahmah in, innte, unaupate, sanggamnute, nute, tate, gamte a leh za in, sawinate toh, hun hongtung ding a tangtawn hinna toh mulou ding mahmah omkei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh mi tampi masapena omte nanungpen a honghi ding ua, nanungpente leng masapen a honghi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Jerusalem khua a hohtou ding in lampi ah a om ua; Jesu’n a ma uh a kai hi; amau lamdang a sa mahmah ua; a honzuite’n a kihta uhi. Aman sawmlehnihte a pituam nawn a, a tung a tung dingte a hilh hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Ngai dih ua, Jerusalem khua a hohtou ding i hi ua; Mihing Tapa siampu liante leh laigelhmite khut a matsak in a om ding; amau si ding in a tung ah thu a hihpuk ding ua, Jentelte kiang ah a pe ding uhi;
  </para>
  <para style="p">
    <verse number="34" style="v" />Amau nuihzabawlna’n a nei ding ua, chil a siatkhum ding ua, a vaw ding ua, a that ding uh; himahleh ni thum nung in a thounawn ding” chi in, a tung a thiltung dingte amaute a hilh hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Zebedai tapa Jakob leh Johan in amah a hongnaih ua, a kiang ah, “Sinsakpa na kiang a k’on nget peuh uh n’on hihsak ka ut uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman a kiang uah, “Nou adin bang hon hihsak leng na ut ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amau a kiang ah, “Na thupina ah na taklam ah khat, na veilam ah khat hon tusak in” a chi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesu’n a kiang uah, “Na nget uh na theikei ua ahi. Ka nou dawn ding na dawn thei ding ua hia? Ka baptisma tan ding leng na tang thei ding ua hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Amau a kiang ah, “Thei e” a chi uhi. Jesu’n a kiang uah, “Ka nou dawn ding na dawn ding ua, ka baptisma tan ding leng na tang ding uh:
  </para>
  <para style="p">
    <verse number="40" style="v" />Himahleh ka taklam leh ka veilam a tut ding thu zaw kei piak ding a hi kei a, a bawlsakte uh ading ahizaw” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan sawmte’n huai a zak un, Jakob leh Johan tung ah a lungkimkei uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu’n amau a sam a, a kiang uah, “Jentelte tung a vaihawm dia a sehte uh a tung uah a lian mahmah ua, a miliante un a tung uah thu a nei mahmah uh chih na thei uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Himahleh nou lak ah zaw huchibang ahi kei ding; kuapeuh na lak ua milian hih ut nasemtu in a pang zaw ding ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Kuapeuh na lak ua masapen hih ut mi tengteng sikha in a pang ding ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Mihing Tapa hial leng na sepsak a om ding in a hongpai kei a, na sem ding leh mi tampi tatna dia a hinna pe di’n a hongpai ahizaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jeriko khua a hongtung uhi; huchi in Jesu Jeriko a kipan a nungzuite leh mipi tampitak toh a pawtlai un khutdoh mittaw, Timai tapa Bartimai lamgei ah a na tu hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan Nazaret Jesu ahi chih a zaktak in, “Jesu, David Tapa, ka tung ah zahngai in” chi in, a kikou hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Mi tampi in dai ding in a khou ua; himahleh aman, “David Tapa, ka tung ah zahngai in” chi in, a kinak kou semsem hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Jesu ading a, “Amah honsam dih ua” a chi hi. Huan mittaw a sam ua a kiang ah, “Khamuangtak in om in, thou in; a honsam” a chi uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan a puan paikhia in, ading a, Jesu kiang ah a hohta hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Jesu’n amah a houpih a, “Na tung ah bangchi a ka hih na ut a?” a chi hi. Mittaw in a kiang ah, “Heutupa, muh theih ka ut” a chi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jesu’n, a kiang ah, “Paita in, na ginna dampih hiteh” a chi a, huchi in, a mu thei pahta a, lampi ah Jesu a zuita hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Jerusalem khua tung ding a a kisak ua, Olive tang a Bethphage leh Bethani khaw kiang a tun un, a nungzuite lak a mi nih a sawl a, a kiang uah,
  </para>
  <para style="p">
    <verse number="2" style="v" />“Na mazawn ua, khua ah vahoh unla; na luttung un sabiltung nou kikhih, kuamah tuan ngeilouhna, na mu ding ua; phel unla, honkai un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan kuapeuh in, huai bangdia hih a honchih uleh, Toupa’n a deih ahi; hiai ah a hon koihsak nawnpah ding, na chi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a hohta ua, kongzing ah kongkhak pawlam a sabiltung nou kikhih a vamu ua; huai a phelta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huai ading kuate hiam in, a kiang uah, “Sabiltung nou bangdia phel?” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amau Jesu gen bangtak in a kiang uah a gen ua; huchi in a phalta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan sabiltung nou Jesu kiang ah a honkai ua, a tung ah a puante uh a phah ua; a tung ah a tuangta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi tampi in lampi ah a puan uh a phah ua; midang in leng gam a sawlnah sat in a phah uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A malam a paite leh a nunglam a honzuite’n, “Hosanna! Toupa min a hongpai a hampha!
  </para>
  <para style="p">
    <verse number="10" style="v" />Gam hongtung ding, i Pa David gam a hampha! Tungnungpen ah Hosanna!” chi in a kikou uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Jerusalem khua a Pathian biakin ah a valut a; bangkim a et velvel khit in nitaklam leng a hong hita a, a pawt a, sawmlehnihte toh Bethani ah a hohta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A zing in Bethani a kipan a pawtnungin a gil a hong kialta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Theipi kung nahnei gamlapi ah a mu a, a gah ka muh khak leh, chi in a vazuan hi; a vatun in a nah kia loungal bangmah a mu kei a; theipi gah hun ahi kei him hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Jesu’n sing a houpih a, “Tuban tangtawn in nang apat kuamah in gah ne nawnta kei hen” a chi hi. A nungzuite’n huai a za uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan Jerusalem khua a tung ua, Pathian biakin ah a valut a, biakin a zuakmite leh leimite a delhkhia a, dangka khengmite dohkante leh vakhu zuakmite tutphah a sawnpuk sak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian biakin a mite’n van a lut paisuak pih uh a phalta kei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan a kiang uah, “Ka inn namchih ading in thumna inn a chi ding uh, chih gelh ahi ka hia? Nou suamhatte khuk in nabawl ua” chi in, a hilhta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Siampu liante leh laigelhmite’n huai a za ua, amah hih manthat theihna ding a zongta uhi; mipi tengteng in a thuhilh lamdang a sak ziak un amah a lau uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan nitaklam a hong hih in khopi a kipan a pawtkhia uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan zingsang a a paikawm un huai theipi kung a zung tan pha a vuaikhin in a muta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Peter in theikhia in a kiang ah, “Heutupa, en dih: theipi kung hamsiat na loh a na vuaikhin vekta” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu’n a kiang uah, “Pathian gingta un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Chihtaktak in k’on hilh ahi, kuapeuh in, hiai tang kiang ah, na kisuan inla, tuipi ah na kipailut in chi a, a lungtang a ginglel lou a a gen a tung ngeingei ding chih gingta peuhmah in a gen bangbang a mu ding uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaiziak in k’on hilh ahi, bangkim thum a na nget peuhmah uh musa in kiging unla huchi in na mu ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thum a na din peuhmah chiang un kua tung ah leng thubuai banghiam na neih uleh ngaidam un; na Pa uh van a om in leng na tatlekna uh a hon ngaihdam theihna ding in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh na ngaihdam kei uleh, na Pa uh van a om in na tatleknate uh a hon ngaidam sam kei ding” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan Jerusalem khua a tungnawn ua; Pathian biakin a a vaklai in siampu liante, laigelhmite leh upate a kiang ah a hongpai uhi,
  </para>
  <para style="p">
    <verse number="28" style="v" />A kiang ah, “Kua thu in ahia hiai thilte na hih? Hiai thilte hih ding in kuan ahia nang thu honpia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n a kiang uah, “Ken leng thu kam khat k’on dong sam ding, hon dawng le uchin, huchi in kua thu in ahia hiai thil ka hih chih k’on hilh ding” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Johan Baptisma van a kipan hia; mihing a kipan? Hon dawng un” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan a kingaihtuah ua, “Van a kipan chi lehang, Bang a chia a thu gingtalou na hi ua, a honchi dia;
  </para>
  <para style="p">
    <verse number="32" style="v" />Himahleh mihing a kipan chi leng mipi a kihta ua; mi tengteng in Johan zawlnei taktak in a bawl chiat uhi.”
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in, Jesu a dawng ua, “Theikei ung” a chi uhi. Jesu’n a kiang uah, “Ken leng kua thu in ahia hiai thilte ka hih, k’on hilh sam kei ding” a chi hi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan gentehna thu in a kiang uah a gen a, “Mi kuahiam in grephuan a bawl a, a kim huang in a um a, grep sukna ding khuk a tou a, insang a lam a, loukhoumite kiang ah khohloh ding in a pia a, gamdang ah a paisanta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A gah loh hun in a tansik amau kiang a kipan la ding in lou khohloh mite kiang ah sikha khat a sawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai mi a na man ua, a vua ua, khutvuak in a paisak nawnta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan sikha dang a kiang uah a sawl nawn a; huai mi leng a lu a na hihliam ua, zumhuaipi in a na bawl uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan sikha dang a sawl nawn zel a; huai mi a na that ua, sikha dang tampi leng, khenkhat a na vua ua, khenkhat a na that uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan sawl ding khat, a tapa deihtak kia a neilai hi; ‘Ka tapa zaw a na zahtak ding uh’ chi in amah a nanungpen in a kiang uah a sawl hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh huai lou khohloh mite’n, ‘hiai mi gouluah dingpa ahi; i that ding uh aw; huchi in a gouluah ding ei a ahimai ding’ a kichi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in amah a man ua, that in, grephuan apat a lawnkhia uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huaiziak in, grephuan neipa’n bangchi’n a honhih dia? Lou khohloh mite a honhih mangthang dia; lou midangte a pe ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Hiai Laisiangthou na sim kei ua hia? “Inlammite suang deihlouhpen, huai mahmah a ning a suang phatuampen a hong hita hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai Toupa hih ahi, i mitmuh un a lamdang hi” chih, a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan amah mat a tumta ua; huai gentehna thu lah amau dem a a gen ahi chih a thei ngal ua. Huchi in amah a nusia ua, a paimangta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a thugen a a mattheihna ding in Pharisaite leh Herod pawl a mi kuate hiam a kiang ah a sawl uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in amau a hongtun un a kiang ah, “Sinsakpa, midiktat na hi a, deihsak tuam kuamah na neikei chih ka thei uh, kuamah khentuam neilou in, chihtak ngial in Pathian lam thu na hilh zel hi: Kaisar kiang a leiman liau a siang hia siang lou?
  </para>
  <para style="p">
    <verse number="15" style="v" />Pe ding ka hi ua, pe lou ding?” a chi uhi. Aman a lepchiahdan uh thei in, a kiang uah, “Bangdia hon ze-et na hi ua? Makhai hontawi un, ka en ding” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A hontawi ua, aman a kiang uah, “Hiai kua lim leh kua min ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amau “Kaisar a” a chi uhi. Jesu’n a kiang uah, “Kaisar thilte Kaisar kiang ah pia unla, Pathian thilte Pathian kiang ah peta unla” a chi hi. Huchi in lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Saddukaite, thohnawnna a omkei chite, a kiang ah a hong uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kiang ah, “Sinsakpa, Mosi in, kuapeuh a unaupa’n ta neilou in a zi sihsan leh, a unaupa’n a zi luah in a unaupa ading in chi a suahsak ding chi’n a hon gelh sak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahi, sal sagih a om ua; a upapen in zi a nei a, chi suahlou in a si hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a nihna in a luaha, chi suahlou in a si nawn zel a; a thumna in huchi mah bang in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in sal sagihte chi suahlou in a sita ua, a tawpna ah numei leng a sita hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thohnawn hun in a kuapen zi ahi dia le? Sagih te’n zi in a neichiat ngal ua” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Jesu’n a kiang uah, “Hiai ziak hilou hia, na theihkhelh nak uh, Laisiangthou leh Pathian thilhihtheihna na theihlouh ziak un?
  </para>
  <para style="p">
    <verse number="25" style="v" />Misi lak apat a thohnawn hun un zi leh pasal a kinei lou ding ua, van angelte bang hizawta ding uh ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan misite kaihthoh a a om ding thu lah Mosi laibu a, Loubuk ah, Pathian in, ‘Kei Abraham Pathian, Isak Pathian, leh Jakob Pathian ka hi, chi a, amah a houpih dan na simkei ua hia?’
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah misi Pathian ahi kei a, mihing Pathian ahizaw; na theikhial tel uh” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan laigelhmite lak a mi khat a hong a, a kisel uh a na ngaikhia a, Jesu’n amaute thutak in a dawng chih a thei a, a kiang ah, “Thupiak tengteng ah koi ahia thupipen?” chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n, “A thupipen hiai ahi: Israel aw, ngai dih uh, Toupa i Pathian uh Toupa khat kia ahi;
  </para>
  <para style="p">
    <verse number="30" style="v" />‘Toupa na Pathian na lungtang tengteng in, na kha tengteng in, na lungsim tengteng in leh na hatna tengteng in na it ding ahi,’ chih.
  </para>
  <para style="p">
    <verse number="31" style="v" />A zom hiai ahi, ‘nangmah na ki-it bang in na vengte na it ding,’ chih. Hiaite sang a thupiak thupizaw a omkei” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Laigelhmi’n a kiang ah, “Hina ngei e, Sinsakpa amah zaw khat kia ahi a, amah louzaw kuamah dang a omkei uh,
  </para>
  <para style="p">
    <verse number="33" style="v" />Amah lungtang tengteng, theihsiamna tengteng, hatna tengteng a it a, eimah i ki-it bang a vengte it haltum thilpiak leh kithoihna tengteng sang in a hoihzaw petmah chih, na gendik ngei” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Piltak in a dawng chih Jesu’n a theih in, a kiang ah, “Pathian gam na gamlat kei hi” a chi a, huai nungsiah kuamah in thu a dong ngamta kei uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Pathian biakin a Jesu’n thu a hilhlai in, amau a houpih a, “Khrist David tapa ahi chih laigelhmite’n bangchidan a gen uh ahia?
  </para>
  <para style="p">
    <verse number="36" style="v" />David ngei in, Kha Siangthou in, Toupa’n, ka Toupa kiang ah, “Na melmate na khepek ngakna a ka bawl masiah ka taklam ah tuin” a chi, a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />David ngei in amah Toupa, a chi ngal a, koi a kipan in ahia amah a tapa a hih?” a chi hi. Huan mivantang in kipaktak in a thu a ngaikhia uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan a thuhilhna ah, “Laigelhmite lak ah pilvang un; amau puanaktual silh a vak a ut ua, dawlmunte ah mite chibai a buk ua,
  </para>
  <para style="p">
    <verse number="39" style="v" />Kikhopnain a tutphah hoihpen leh Ankuangluina a mun hoihpen a deihtuam nak uhi;
  </para>
  <para style="p">
    <verse number="40" style="v" />Meithai in a negai ua, kilim bawl in sawtpipi a thum uh; huaite’n siamlouhtanna lianzaw a tang ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan sumkholna zawn ah a tu a; sumkholna a mipi sumkhiakdan a en a; mi hau tampitak in tampipi a khia uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Meithai zawngtak a hongpai a, dal dangka muza nih a khia a, huai tuh paihsa khat hu ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jesu’n a nungzuite a sam a, a kiang uah, “Chihtaktak in k’on hilh ahi, sumkholna a khe tengteng lak ah hiai meithai zawngtakin a khe tam pen hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Hiaite tengteng in a neihlet uh a khia ua; aman zaw a deihthoh laitak, a neih sun, a hinna ding tengteng a khe vek ahi” a chi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Pathian biakin a kipan a paikhiak lai in, a nungzuite lak a mi khat in a kiang ah, “Sinsakpa, en dih, suang leh inn a thupi mahmah hi” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu’n, a kiang ah, “Hiai inn thupitak na mu maw? Hihchip louh a, suang kichiang hiai ah a omkei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan Olive tang a Pathian biakin zawn a a tutlai in, Peter, Jakob, Johan leh Andru te’n a kiang ah,
  </para>
  <para style="p">
    <verse number="4" style="v" />“Huaite chikchiang in a hongom dia? Huai tengteng a tun ding chiang in chiamtehna bang a om dia, honhilh in” chi in a simdot uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu’n a kiang uah, “Kuamah in honkhem louhna ding in, pilvang un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tampi, Khrist ka hi, chi in, keimah min lou in a hongpai ding uh, mi tampi a khempuk ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan kidou thu leh kidou thuthang na zak hun chiang un mangbang kei un; huaite hongtung ding him ahi uh. Himahleh tawpna zaw ahi nai tadih kei ding.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nam tuam leh nam tuam a kidou ding ua, gam tuam leh gam tuam a kidou ding ua; mun tuamtuam ah zin a ling dia; kial a ke ding hi. Hiaite nauvei kipatna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Himahleh pilvang un; vaihawmmite a hon mansak ding ua; kikhopnain ah a hon vaw ding ua; keimah ziak in gamukte leh kumpipate ma ah theihpihna pe ding in na ding ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Tanchinhoih nam tengteng kiang a hilh masak ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan a honpi ua, a hon matsak hun chiang un, bang ka gen dia chi in, ngaihtuah khawl kei un; a huntak a theihsaka na om peuh uh, huai ngeingei genzaw un; a genpen zaw noumau hilou in Kha Siangthou ahizaw ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan hihlup ding in unaupa leh unaupa a kimansak ding ua, pa in a tapa a mansak ding; tate’n leng a nu leh pate uh a dou ding uh, a thatsak ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Keimah min ziak in mi tengteng huat na hi ding uh; himahleh a tawppha a thuakpa, huai mi hotdam in a om ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Himahleh zawlnei Daniel in a gen bang a hihmangbangpa kihhuai a dinlouhna ding ading na muh chiang un, a sim peuh in a omdan thei hen, huai hun chiang in Judia gam a omte tang sang ah taimang uhen;
  </para>
  <para style="p">
    <verse number="15" style="v" />inn tung a om kum kei hen; a insung a thil lakhe ding in lutsam kei hen.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan lou a om a puansilh la ding in kiknawn kei hen.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huaini in gaite leh naunou pomte tung a gik ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huaite phalbi a a hong tunlouhna ding in thum un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai nite bang a gimthuakna thupi Pathian bawl leilung piantung a kipan tutan in a om ngei naikei a, chikmah chiang in a om ngei nawn kei ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan Toupa’n huai nite hihtom kei leh mihing damin a suakta kei ding; himahleh, teltuamte ziak in nite a hih tom hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Huai hun chiang in, kuapeuh in na kiang ua, En dih uh; Khrist hiai ah a om, ahihkeileh En dih uh: huai ah hiam a chih chiang un gingta kei un;
  </para>
  <para style="p">
    <verse number="22" style="v" />Khrist takloute leh zawlnei takloute hongpawt ding ahi ngal ua, huaite’n chiamtehna leh thillamdang a hih ding uh, hithei ngial leh teltuamte nangawn a khem theihna ding un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nou zaw pilvang un, ngai dih uh, bangkim k’on hilh khol khinta ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Himahleh huai nite zoh in, huai gimthuakna khit in, ni hihmial in a om ding a, kha a vak nawn kei ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Van a kipan aksite a hong ke ding ua, van a thilhihtheihna omte hihlin in a om ding uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai hun chiang in Mihing Tapa, thilhihtheihna leh thupina lianpi toh mei lak a hongpai a mu ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huai hun chiang in angelte a sawlkhe dia, a telte lei ningli apat leitawp a kipan a vantawp pha in a pikhawm ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Huchi in theipi kung ah gentehna zil un: a hiang a hong nou a, a nah a hongsel in nipi a nai chih na thei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi mah bang in, nou leng huaite hongtung na muh chiang un, amah a hongnaita a, kongkhak bul mahmah ah a om chih, thei un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Chihtaktak in k’on hilh ahi, huai tengteng a tunkim masiah tulai khang a mang kei ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Lei leh van a mang dia, ka thu ahihleh a mang kei ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Himahleh huai ni leh dak Pa kia lou ngal kuamah in, van a angelte’n leng Tapa in leng a theikei uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pilvang unla, kiging gige in thum un; a hun theilou na hi ngal ua.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mi a in paisan a, a sikhate thu neisak a, a nasep ding uh pe chiat a, kongkhak veng leng kigin ding thu pe phot a, gamdang a vatam bang ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huaiziak in kiging gige in om un, inn neipa hongpai ding hun, nitaklam in hia, zan in hia, ak khuan in hia, zing in hia chih na thei ngal kei ua;
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchilou in zaw, hongpai guih kha leh ihmu in a honmu kha ding.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan na kiang ua ka gen mi tengteng kiang a ka gen ahi, Kiging gige in om un” a chi hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan ni nih nung in Paikan Ankuangluina leh Tanghou silngou sohlouh Ankuangluina om ding ahi a; siampu liante leh laigelhmite’n, amah zekhem a, man a, a hihlup theihna ding dan a zongzong uhi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Himahleh “Ankuanglui sung in hi kei hen, huchilou in zaw vantang lak ah buaina a hongom kha ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan, Bethani khua a phak Simon inn a a omlai a, Ankuang a um lai in numei khat, alabaster bawm a spiknardi thau gimlim man tampi tawi in a hong a, a bawm a hihkham a, a lu ah a sungta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh khenkhatte a lunghita kei ua, “Bang ding a thau gimlim hihmang mawkmawk ahia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiai thau makhai za thum sang a tamzaw a zuak a, migentheite kiang a piak theih ahi ngal a” a chi uhi. Huchi in, a tung ah a phun uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu’n, “Hih hen aw; bangdia va hihbuai na hi ua? Ka tung ah thil hoihtak a hih ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi gentheite na kiang ua om gige ahi ua, na ut hun peuh un na hehpih thei uhi; kei bel na kiang ua om gige lou ding ka hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A hihtheih khamkham a hih ahi; ka sapum vui ding a sathau nuhkhol ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in chihtaktak in k’on hilh ahi, khovel tengteng koipeuh ah leng Tanchinhoih a kigenna ah hiai numei thilhih amah theihgigena ding in a kigen zel ding” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Judas Iskariot, sawmlehnihte lak a khat in, Jesu a kiang ua zuausan a a matsak theihna ding in siampu liante kiang ah a vahoh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amau huai thu a zaktak un a kipak mahmah ua, a kiang ah dangka piak a chiamta uhi. Huchi in zuausan a matsak ding dan lemtang a zongta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Tanghou silngou sohlouh ni, ni masapen, Paikan Ankuangluina belamnou a gohzelna ni uah, a nungzuite’n a kiang ah, “Paikan Ankuanglui na nek theihna ding in koi ah vabawl le ung na ut?” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in a nungzuite lak a mi nih a sawl a, a kiang uah, “Khopi ah valut unla, huai ah pasal bel a tui pua in hontuak dia; amah zui un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a lutna peuh ah huai inn kempa kiang ah, ‘Sinsakpa’n ka nungzuite toh Paikan Ankuang ka nekna ding uh, mikhual inn pindan koilai ahia?’ a chi, na chi ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in aman inn pindan tungnung za tak, van omsa, mansa dimdiam a hon ensak dia; huai ah ei ading in bawl un” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan nungzuite a pawtta ua, khopi ah a valut ua, a kiang ua a gen bangtak in a vamu ua; Paikan Ankuang a bawlta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan nitaklam a hong hih in, amah sawmlehnihte toh a vahohta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan an a um ua a neklai un Jesu’n, “Chihtaktak in k’on hilh ahi, na lak ua mi khat, ka kiang a nesam in, hon zuausan in hon mansak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan a lungkham panta ua, khatkhat in a kiang ah, “Keimah ka hi hia?” a chi chiat uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan aman a kiang uah, “Sawmlehnihte lak a mi khat, ka kuang a tanghou hon diahpihpa ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing Tapa a tanchin a gelh bang tak un a pai ding: himahleh Mihing Tapa mansak ding mipa tung a gik hi: Huai mihing zaw piang kei leh amah adin a hoihzaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan an a neklai un Jesu’n tanghou a la a, a vualzawl zoh in a balkham a, a kiang uah a pia a, “La un; hiai ka sapum ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan nou a la a, kipahthu a gen zoh in a kiang uah a pia a; huchi in, avek un a dawn chiat uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan aman a kiang uah, “Hiai ka sisan a thukhun thak ahi, mi tampi dia pawt ding ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chihtaktak in k’on hilh ahi, Pathian gam a a thak ka dawn ni a tun masiah grep guigah tui ka dawn nawnta kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan la a sak zoh un, a pawt ua, Olive tang ah a paita uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan Jesu’n a kiang uah, “Na vek un lungkia in n’on taisan ding uh. ‘Belamchingpa ka khen dia, belamte a dalh ding uh’ chih gelh ahi ngal a.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh ka thohnawn nung in Galili gam ah na ma uah ka pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Peter in a kiang ah, “Avek un lungkia in hon taisan mahle uh, ken zaw k’on taisan kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan Jesu’n a kiang ah, “Chihtaktak in k’on hilh ahi, Tu zan ngeingei in, ak nihvei a khuan ma in, nang thumvei n’on kitheihmohbawl ding” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman bel khauhtak in, “Na sihna ah si sam ding himah leng k’on kitheihmohbawl kei hial ding” a chi hi. Huchibang in a chi chiat uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Gethsemani a chih mun uh a tung ua; aman a nungzuite kiang ah, “Ka thum sung teng hiai ah na tu un” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Peter, Jakob leh Johan a pi a, nakpitak a lungkham in a mangbang mahmah hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchi in a kiang uah, “Ka kha a lungkham mahmah a, sihna khophial ahi; hiai ah om unla, kiging gige un” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan neukha in malam ah a vapai zeka, lei ah a khupboh a, a hihtheih leh, huai hun in amah pel ding in a thum hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Abba, Pa, bangkim na hihthei a; hiai nou kei a kipan in lamang in; himahleh kei thu hilou in nangmah thuthu hizaw hen” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan a hongpai a, amau ihmu in a hong mu a, huchi in, Peter kiang ah, “Simon, ihmu na hi maw? Dakkal khat leng kiging gige in na om theikei maw?
  </para>
  <para style="p">
    <verse number="38" style="v" />Khemna a na lutlouhna ding un kiging gige in thum un. Kha in tuh a ngap a, sa zaw a hatkei” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan a vahoh nawn a, a thugen ngei gen in a thum nawn hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan a hongpai nawn a amau ihmu in a hongmu nawn hi, a ihmut uh a suak mahmah ngal a; a thugen dawn dan ding leng a theikei uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan a hongpai thumveina ah a kiang uah, “Na ihmu lailai umaw, na tawlnga lailai umaw? A hunta ve; a hun hongtungta; mihing Tapa mikhialte khut a zuausan a piak ahita hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Thou un, i pai ding uh; en un, zuausanpa a hongnai hi” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan a genlai tak in, Judas, sawmlehnihte lak a mi khat, a hong tungpah a, siampu liante leh laigelhmite leh upate a kipan mipi, namsau leh khetbuk tawite toh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan zuausanpa’n, “ka tawp peuhmah amah ahi ding; man unla, kizentak in na pimang ding uh,” chi in chiamtehna a na hilhkhawl dimdiam hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huchi in a tuntakin a vanaih a, “Rabbi!” chi in, a tawp tonton hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan amah a lenta ua, a manta uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan a kiang a dingte lak a mi kuahiam in a namsau a dok a, siampu lianpen sikha a sat a, a bil a sat khiaksak hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huan Jesu’n amau a houpih a, a kiang uah, “Temsaute, khetbukte tawi in suamhat man ding bang in, honman ding in n’ong kuan uh maw?
  </para>
  <para style="p">
    <verse number="49" style="v" />Pathian biakin ah niteng a thuhilh in na kiang uah ka om a; n’on man ngal kei ua, himahleh Laisiangthou thugelh a tun theihna ding eive,” a chi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan avek un amah a nusia ua, a taimang vekta uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Tangval kuahiam, puanmalngat kia bat in, amah a zui a; amah a na man uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Himahleh a puanmalngat a taisan a, vuaktang in a taimangta hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesu siampu lianpen kiang ah a pi ua; siampu liante, laigelhmite tengteng toh a hong ton uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Peter in gamlapi a pai in amah a zui a, siampu lianpen inn huangsung konglai pha in; sikhate lak ah meilum awi in a tu sam hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Jesu a hihlup theihna ding un siampu liante leh vaihawmmite tengteng in amah hekna a zong ua, a mu kei uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Mi tampi in zuau in a hek ua, himahleh, a hekna thu uh a kituak kei hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huan kuate hiam ading ua, zuau in a hek uhi,
  </para>
  <para style="p">
    <verse number="58" style="v" />Hiai mi’n, “Pathian biakin khut a lam ka hihse dia, ni thum sung in biakin dang, khut a lamlouh, ka lam ding, a chih, ka za uh,” a chi uhi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Huchi in leng a hekna thu uh a kituak thei sam kei uhi.
  </para>
  <para style="p">
    <verse number="60" style="v" />siampu lianpen a lai ah ading khia a, Jesu kiang ah, “bangmah a dawnglou maw? Hiaite hon hekna bangchidan ahia?” chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Amah lah a daidide a, bangmah in a dawngkei hi. siampu lianpen in a kiang ah, “Khrist, Hampha Tapa, na hi hia?” chi in, a dong nawn hi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Jesu’n, “Hi e; Mihing Tapa thilhihtheihna taklam a tu a, van meilak a hongpai na mu ding uh,” a chi hi.
  </para>
  <para style="p">
    <verse number="63" style="v" />siampu lianpen in a puansilh a botkek a, “Theihpih dang bang din i deih dia?
  </para>
  <para style="p">
    <verse number="64" style="v" />Pathian a gensiat dan na zata uh; bangchi na sa ua?” a chi hi. Avek un amah sitakin a sep chiat uhi;
  </para>
  <para style="p">
    <verse number="65" style="v" />Huan a khen in amah a chilsiat pah ua, a maituam in khuttum in a tum ua, a kiang ah, zawlnei bang in gen in, a chi uhi: sikhate’n a paipih kawm un a khutpek un a beng ekek uhi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Huan Peter nuailam a inn huangsung konglai a a omlai in siampu lianpen sikha nungakte lak a khat a hongpai a,
  </para>
  <para style="p">
    <verse number="67" style="v" />Peter meilum awi a mu a, a en a, “Nang leng Jesu Nazaret mi kiang a om na hi ve,” a chi hi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Aman, “Na thugen ka theikei, a ngaihna leng ka theikei,” chi in, a kitheihmohbawl hi. Inlim ah a pawtkhia a; huchi in ak a khuangta hi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Huan nungak in a mu a, a kiang a dingte kiang ah, “Hiai mi a lak ua mi ahi,” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Himahleh a kitheihmohbawl nawn hi. Sawtlou nung in a kiang a dingte’n, Peter kiang ah, “A lak ua mi hi tawk teh, Galili gam a mi na hi ngal a,” a chi uhi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Aman, “Huai na mihing gen uh ka theikei,” chiin, hamsia kiloh in a kichiamta hi.
  </para>
  <para style="p">
    <verse number="72" style="v" />Huan ak khuan nihveina a khuang pah hi. Peter in, Jesu’n a kiang a, Ak nihvei a khuan ma in nang thumvei n’on kitheihmohbawl ding, a chih a theikhethak nawn a, huai a ngaihtuah a a kapta hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan zingsang a hong hih in, siampu liante, upate leh laigelhmite leh vaihawmte tengteng toh a kihou ua, Jesu a hen ua, a pi ua, Pilat kiang ah a peta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilat in a kiang ah, “Judate Kumpipa na hi hia, chi in a dong a, aman a kiang ah, “Na gen bang in himah ing” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Siampu liante’n thu tampi in a hek uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Pilat in a dong nawn a, a kiang ah, “Bangmah a dawnglou maw? Ngai in, a hon hekna uh tamdan!” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu’n bangmah in a dawngkei a; huchi in Pilat in lamdang a sa mahmah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Pilat in ankuangluini in mi henta khat a nget peuhmah uh a pawtsak zel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi khat, Barabba a chih uh, a helte lak ah hensa in a om a, amah bel helna a pang leh tualthat ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mipite a hohtou ua, amau adia a hihsak zel bang a hihsak ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pilat in a dawng a a kiang uah, “Judate Kumpipa hon khahsak leng na ut uhia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siampu liante’n hazat ziak a paipih ahi uh chih a thei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh siampu liante’n mipite Barabba pawtsak zawk ngen ding in a hanthawn uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Pilat in a kiang uah, “Judate Kumpipa a chih uh bang ka loh tadia le?” chi in a dong nawn hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan amau “Kros ah kilhden in” chi in a kikou nawn uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pilat in a kiang uah, “Bang din maw? Bang a hihkhial a ahia?” a chi hi. Himahleh amau, “Kros ah kilhden in” chi in, a kikou semsem uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in Pilat in mipite hih lungkim ut in, Barabba a pawt sakta a; Jesu a vuak zoh in Kros a kilhden ding in a peta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan sepaihte’n inn huangsung konglai, Praitoriam a chih uah, amah a pilut ua, a pawl ua mi tengteng a samkhawm uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in puansandup a silhsak ua, linglukhu phan in a khusak uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Chibai, Judate Kumpipa!“ chi in, chibai a buk uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A lu sialluang in a khen ua, chil a siat ua, khukdin in chibai a buk uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan nuihzabawlna a a zatzoh un, puansandup a hawk ua, amah puan a silhsak nawn ua, Kros a kilhden ding in a pikhia uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan mi khualzin khat, Kurini khomi, Alexander leh Rufas pa, Simon, a gam lam a kipan hongpai, a Kros paw ding in a man uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu Golgotha mun ah a pi ua, huai Luguh mun, chihna ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan uain murra toh hel a pia ua, himahleh a dawn nuam kei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kros ah a kilhden ua, a tan ding chiat uh theihna ding in aisan in a puansilhte a kihawm uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A kilhden uh dak thumna vel ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A hekna lai a tunglam ah a gelh ua, “JUDATE KUMPIPA” chi in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan suamhat nih, a taklam ah khat, a veilam ah khat amah toh a kilhden sam uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Laisiangthou in, “Amah talekte toh simkhawm ahita,” chih genna hih tangtun in a omta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan mi kivialleh peuh in a lu uh sing in, “Ehe! Nang Pathian biakin susia a ni thum a lamnawnpa,
  </para>
  <para style="p">
    <verse number="30" style="v" />Ki hondam inla, Kros a kipan hongkum in” chi in a enghou uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi mah bang in siampu liante’n, laigelhmite toh, amau lak a enghou in, midang bawn hondam a, amah kihondam theilou pi in, a chi uh.
  </para>
  <para style="p">
    <verse number="32" style="v" />I muh a, i gintak theihna ding in, Khrist, Israel Kumpipa, tuin Kros a kipan hongkum leh a kei dia” a chi uhi. Huan amah toh a kilhden samte’n leng a enghou uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan dak gukna a honghih in, dak kua na dong in gam pumpi a hong mialta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Dak kua na ding in Jesu aw ngaihtak in, “Eloi, Eloi, lam a sabakthani?” chi in a kikou khia a, huai tuh “Ka Pathian, Ka Pathian, bangdia hon paisan?” chihna ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan a kiang a ding khenkhatte’n huai a zak un, “Ngai un, Elijah a sam” a chi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mi khat a tai a, spanji uain thuk a diah dim in, chiang dawn ah a tak a, a dawnsak hi. Khawldih ua, amah lakhe ding in Elijah a hong hiam i en ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jesu aw ngaihtak in a kikou a, a kha a khahta hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pathian biakin puanzak a tunglam a kipan a nuailam pha in a hong keksuakta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A mazawn a sepaih zaheutupa ding in huchibang a a kha a khah a muh in, “Hiai mi Pathian Tapa ahi ngeingei” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Numeite’n leng gamla tak ading in a en ua; huaite lak ah Mari Magdalini, Mari Jakob naupangzaw leh Joses nu, Salomi leng a pang uhi;
  </para>
  <para style="p">
    <verse number="41" style="v" />Huaite Galili gam a a omlai a, amah zui a, a na sepsak zelte ahi uhi; numei dang tampi Jerusalem khua a amah toh hohtoute leng a om uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan nitaklam a hih in Kisakkholhna a hih ziak in, huai khawlni ma ni ahi,
  </para>
  <para style="p">
    <verse number="43" style="v" />Arimathai khua a om, Joseph, vaihawmpa zahtakhuai, Pathian gam lamen mi, a hongpai a, hangsantak in Pilat kiang ah a lut a, Jesu luang a ngenta hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huchi in Pilat in huchibang a a sih pah lamdang a sa mahmah a, huchi in sepaih zaheutupa sam in, a sihna a sawtta hiam chih a dong hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Sepaih zaheutupa kam a a sita chih a theih in, a luang Joseph kiang ah a pia hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan aman puanmalngat a lei a, amah a lakhia a, puanmalngat in a tuam a, han khuakkuak ah a sial a, hankong suang in a delhta hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan Mari Magdalini leh Joses nu Mari in a sialna a mu uhi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan khawlni a bei in Mari Magdalini, Mari Jakob nu leh Salomite han ah a vahoh ua, amah nuh ding in gimlim a lei uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ni sagih ni masapen in, zingsang pi in, ni suahlai in han a va tung uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Han kong a suang kuan hon khukkhiak sak ding a diam aw?” a kichih laitak un,
  </para>
  <para style="p">
    <verse number="4" style="v" />A dak uh leh suang khukkhiaksa in a muta uhi, a lian mahmah hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hansung ah a lut ua, pasal khat puanngou silh, a taklam pang a tu a mu ua; lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in aman a kiang uah, “Lamdang sa kei un; Jesu Nazaretmi, a kilhden uh, na zong ua; a thou nawnta hi; hiai ah a omta kei; en un, a sialna uh!
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh pai unla, a nungzuite leh Peter kiang ah, Galili gam ah na ma uah a pai ding hi; na kiang ua a chih bang ngei in huai ah na mu ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in linna leh lamdang sakluatna in amau a phaktak ziak in a pawt ua, han a kipan a tai vengveng ua; a lauh ziak un kuamah kiang ah bangmah a genkei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan ni sagih ni masapen zingsang a a thohnawn in, Mari Magdalini, asung apat dawi sagih a delhkhiakna nu kiang ah a kilak masapen hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah Jesu ompih zelte kiang ah a vahoh a, misi sun a a kahlai un a vahilhta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh amah a hing a, muh leng a mu chih a za na ua, a gingta tuankei uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai nung in a lak ua mi nih gam lam zuan a a pailai un mel dang pu in a kiang uah a kilak nawn hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amau nungzui dangte kiang ah a vahilh ua, amau thu leng a gingta tuankei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai nung in, an a umlai un sawmlehkhatte kiang ah a kilak a, a thohnawn nung a a mute thu a gintak louh uh leh a lungtang khauh thu uah a taihilh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A kiang uah, “Khovel tengteng ah pai unla, thilsiam tengteng kiang ah Tanchinhoih hilh un.
  </para>
  <para style="p">
    <verse number="16" style="v" />A gingta a baptisma tang hotdam in a om ding a; gingtalou tuh siamlouh tang in a om ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiai chiamtehnate’n a gingtate a zui zel ding: Ka min in dawite a delhkhe ding ua, pau thak in a pau ding uhi;
  </para>
  <para style="p">
    <verse number="18" style="v" />gulte khut in a la ding ua; sihna gu bangchibang dawn mahle uh bangmah a chi kei ding uh; damloute tung ah a khut uh a koih ding ua, a damzel ding uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in Toupa Jesu a kiang ua thu a genkhit in van a pitouh in a om a, Pathian taklam ah a tu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in amau a paikhia ua, gam teng ah thu a genta uhi. Toupa’n amau a seppih a, chiamtehnate’n zui in thu a hihkip zel hi. Amen.
  </para>
</usx>
