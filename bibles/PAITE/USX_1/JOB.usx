<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JOB" style="id">Job</book>
  <para style="h">Job</para>
  <para style="toc1">Job</para>
  <para style="toc2">Job</para>
  <para style="mt">Job</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uz gam ah mi khat a om a, a min Job ahi; amah mi hoihkim leh tang ahi a, Pathian kihta a, hoihlou mudah ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman tapa sagih leh tanu thum a nei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A neih leh lam leng belam sang sagih, sangawngsau sang thum, bawngtal za nga leh sabiltungnu za nga leh inkuan thupi mahmah ahi: huchi in hiai mipa suahlam tate tengteng lak ah a thupipen ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a tapate a kuan ua khat chiat inn ah a ni ni’n Ankuangluina a nei ua; huchi in mi a sawl ua a sanggamnumei thumte uh amau kiang a ne ding leh dawn ding in a samsak uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan hichi ahi a, a Ankuanglui sanlaitak un, Job in mi a sawl a amaute a hih siangthou a, zingsang in beltak in a thou a, avek ua zah dungzui in haltum thillatte a lan: Job in, “Ka tapate’n thil a hihkhial un, a lungtang un Pathian a hamsiat kha ding uh” a chi hi. Hichibang in Job in a hih gige hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Toupa ma a Pathian tapate a hong kilak ni uh a om a, a lak uah Setan leng a hongpai sam hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Toupa’n Setan kiang ah, “Koi a hong kipan na hia?” a chi hi. Setan in Toupa a dawng a, “Lei pumpi siksuak a vialvak a, asung a touvak a sukvak vak ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Toupa’n Setan kiang ah, “Ka sikha Job na ngaihtuah ngei hia? Amah bang a hoihkim leh mitang, Pathian kihta a hoihlou mudah lei ah lah kuamah a om ngalkei a” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Setan in Toupa a dawng a, “Bangmahlou dia Job in Pathian kihta ahi maw?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah kimvel in, a inn kimvel in leh a neih tengteng kimvel in, ning chiteng ah umna na bawl kei maw? A khut nasep na vualzawl a, gamsung ah a neih leh lam a pung hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh tuin na khut suahkhia inla, a neih tengteng khoih in, huchi in na maitang ah nang a hon gense ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Toupa’n Setan kiang ah, “Ngai in, a neih tengteng nang thu ahi; amah mah tung ah kia na khut kha ken” a chi hi. Huchi in Toupa ma a kipan in Setan a kuan khia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a tapate leh a tanute’n a unaupa uh upapen inn a a nek ua uain a dawn lai un ni khat thu in a hongtung hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Job kiang ah sawltak khat a hong a, “Bawngtalte’n lei a let ua, sabiltungte a kiang ah a gamta ua:
  </para>
  <para style="p">
    <verse number="15" style="v" />Sheba mite’n amau a delh ua, a pimang uh; ahi, namsau hiam in sikhate a that ua; huan nang hilh ding in kei ke leu ka suakta hi” a chi a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi a thu a genlai in midang khat leng a hong a, “Van a kipan in Pathian mei a kia a, belamte leh, sikhate a kangmang a, amau a kangtum hi: huan nang hilh ding in kei ke leu ka suakta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi a thu a genlai in, midangkhat a honglai a, Kaldai mite’n pawl thum a bawl ua, sangawngsaute a delh ua, a pimangta uhi, huan namsau hiam in sikhate a that ua; huan nang hilh ding in kei ke leu ka suakta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi a thu a genlai in, midang khat mah a hong a, “Na tapate leh na tanute’n a unaupa upapen inn a a nek ua uain a dawnlai un:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai in gamdai a kipan in huih thupi a hongnung a, huai inn ning lite a hon nuai a, tangvalte tung ah a chim a, a si uh: huan nang hilh ding in kei ke leu ka suakta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in Job a thou a, a puanaktual a botkek a, a lu a metsiang a, leitung denna in a kinei a, Pathian a beta hi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman, “Ka nu sul a kipan vuaktang in ka hong a, huailam ah vuaktang in ka kik ding: Toupa’n a pia a, huan Toupa’n a lamangta hi; Toupa min phat in om hen” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hiai tengteng ah Job in a hihkhial kei a, haihuaitak in Pathian leng a mawhsa kei hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Toupa Pathian tapate a hong kilak ni uh a om nawn a, huan Toupa ma a kilak ding in a lak uah Setan leng a hongpai sam hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Toupa’n Setan kiang ah, “Koi a hong kipan na hia?” a chi hi. Setan in Toupa a dawng a, “Lei langkhat langkhat ton a, asung a touvak a sukvak ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan Toupa’n Setan kiang ah, “Ka sikha Job na ngaihtuah ngei hia? Amah bang a hoihkim leh mitang, Pathian kihta a hoihlou mudah lei ah lah kuamah a om ngalkei a: amah siatna ding in hon tangsak mahle chin, a ginomna a len chinten hi” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Setan in Toupa a dawng a, “Vun sik in vun, ahi, mihing in a neih tengteng hinna sik in a pe ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh tuin na khut kha inla, a guh leh a sa khoih lechin, na maitang ah nang hon gense ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n Setan kiang ah, “Ngai in, Amah na khut ah a om hi; a hinna leltak hawi in” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Toupa ma a kipan in Setan a pawtkhia a, meima tum in a khepek nuai a kipan a luzang tan in Job a gawt hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in aman kikhuatna din belpei a la a; meivu lak ah a tu hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huailai in a zi in a kiang ah, “Na ginomna len chinten lailai na hi hia? Pathian gensia inla, si in” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh a kiang ah, “Numei hai thugente lak a khat bang in thu na gen. Bang ahia? Pathian khut ah hoih i mu dia, hoihlou leng i mu kei dia hia?” a chi a. Hiai tengteng ah Job in a muk in thil a hihkhial kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi a Job lawm thumte’n a tung a hiai hoihlou hongtung tengteng a zak un, michih amah mun a kipan in a hong ua: Eliphaz, Teman mi, Bildad Suah mi leh Zophar Naaman mi: amah kah ding leh amah lungmuan ding in hoh khawm ding in thuseh a bawl uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in gamlapi apan a daktouh uleh, amah a theikei ua, nakpi’n a kikou khia ua, a kapta uhi; a puanaktual uh michih in a botkek ua, a lutang uah vanlam ah leivui a kibuak uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in a kiang ah leitung ah ni sagih leh zan sagih a tu ua, a kiang ah kuamah in thu khat leng a gen kei uh: a lungkhamna a thupi mahmah chih a thei uhi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hiai khit in Job in a kam a ka a, a ni a hamsiat hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Job in a dawng a hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Ka pian ni leh zan, pasal naupang pai in a om, a kichihna mangthang hen.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huai ni mialna hi hen; tunglam a kipan Pathian in ngaihsak kei hen, a tung ah leng khovak tang kei hen.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khomial leh sihna lim in amau ading in huai ngen uhen; a tung ah meipi kai hen; khua nimsak tengteng in huai tuh lausak uhen.
  </para>
  <para style="p">
    <verse number="6" style="v" />Zan ahihleh, mial sah bikbek a tung ah tu hen; kum nite lak ah kipak kei hen; khate simna ah tel kei heh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai in, huai zan hut hen; huai ah kipah aw ging kei hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huai ni hamsiatte amau hamsiat uhen, Leviathan tokthou ding a mansa a omte.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai a khomui aksite mial uhen: khovak zong henla, himahleh bangmah neikei hen; zingsang mitvunte leng musam kei hen:
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka nu sul kongkhakte a khaklouh ziak in, ka mit a kipan a buaina a sel louh ziak in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sul a kipan bangdia silou ka hia? Gila kipan ka hong paikhiak lai a bangdia kha khahlou ka hia?
  </para>
  <para style="p">
    <verse number="12" style="v" />Bangdia khukte’n kei hondom ahia? Ahihkeileh bangdia ka tep ding nawi na om ahia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Tuchiang in na lumkhin a, na daimai ding lah ka hi ngal a; ka na ihmuta dia; huchi in ka na khawlta ding hi:
  </para>
  <para style="p">
    <verse number="14" style="v" />Lei kumpipate leh thudotmite, amau ading a mun siate bawlte toh;
  </para>
  <para style="p">
    <verse number="15" style="v" />Ahihkeileh dangkaeng nei kumpite, a innte uh dangka a dimsakte toh;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahihkeileh muhlouh a a hunlou a piang bang na hilou ka hia, naungek khovak mu ngeiloute bang?
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai ah migiloute’n sukbuai a tawpsan ua; huai ah mitawlte a khawl uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai ah salmatte nuam in a omkhawm uh; nasem heutute aw a za kei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai ah a lian leh a neu a om ua; a pu a kipan in sikha a nuamlen.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bangdia dah a omte kiang a khovak piak ahia, kha a haksa sa kiang ah hinna;
  </para>
  <para style="p">
    <verse number="21" style="v" />Sihna deih a, a tunlouhnate kiang ah; gou selguk zon sang a thupi a zongmite kiang ah;
  </para>
  <para style="p">
    <verse number="22" style="v" />Han a tunlai ua, nakpitak a kipakte kiang ah?
  </para>
  <para style="p">
    <verse number="23" style="v" />Bangdia mi a lampi sel a om kiang leh Pathian in a umsuak kiang a khovak piak a om ahia?
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka thumna an ka nek ma in a hongtung a, ka maunate tui bang a leihbuak in a om hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka kihtak thil lah ka tung ah a hongtung ngal a, ka laulau ka tung ah a hongtung hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nuam ka sa kei a, ka lung a muang kei, khawlna leng ka neikei hi; himahleh buaina a hongpai hi.”
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai in Eliphaz, Teman mi in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Min nang hon houlimpih tum leh na zadah diam? Hizongleh paulou in kua a omthei dia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Ngai in, mi tampi na hilhta a, khut hatloute na hihhatta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A puklai in na thute’n a dingsak a, khuk hatloute na kipsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh tun na tung ah a hongtung a, na bah a; nang a honkhoih a, na buaita hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian na kihtakna, na muanna hilou hia, na lametna na lampite muanhuaina?
  </para>
  <para style="p">
    <verse number="7" style="v" />“Theigige in, k’on ngen hi, hoih hinapi a, mangthang ngei kua ahia? Ahihkeileh koilai ah ahia midik satkhiak a a om?
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei muh in, thulimlouhna leilette ahi ua, buaina tuh a huai mah atte.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pathian hu in a mangthang ua, hehna a mut a hihman in a om uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Humpinelkai huham leh, humpinelkai hangsan aw leh, humpinelkai tuailai hate, a kitanta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Samat taksap ziak in humpinelkai tek a mangthang a, huan humpinelkaipi noute a dalhzak uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Tuin a guk in thil ka kiang a hongtung ka bil in huai a huauna a sangta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Zan mengmuhna a kipan a ngaihtuahnate ah, mite nakpitak a a ihmut san lai un,
  </para>
  <para style="p">
    <verse number="14" style="v" />Launa ka tung ah a hontung a, linna in ka guhte tengteng a sing hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huailai in ka mai ah kha a pai a; ka chimul a dingta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka ding kinken a, himahleh huai a kilatdan ka theikak theita kei a; a lim tuh ka mit ma ah a om a; daihna a om a, aw ka za hi,
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian sang in sithei mihing a dikzaw ding hia? A Bawlpa sang in mihing siangthou zaw ding hia? chi in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai in, a sikhate ah muanna a koihkei a; angelte hai in a ngoh hi:
  </para>
  <para style="p">
    <verse number="19" style="v" />Tungman inn a teng amaute hi sem na un chia, a suangphum leivui a om a, leikha ma a chimsia:
  </para>
  <para style="p">
    <verse number="20" style="v" />Zingsang leh nitak kikal in hihsiat in a om ua: theihlouh hial in tangtawn in a mangthang uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau sung a puanin khau uh a bohkhiak touh hilou hia? Pilna tellou in a si uhi.”
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Tun sam in; nang hon dawng kua a om a? Misiangthoute lak ah a kua lam na nga dia?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lungzinna in lah mihai a that a, huan thikna in mi mawl a that sek hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihai zungkai ka muta a; himahleh thakhat in a tenna ka hamsiat hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tate bitna a kipan gamlapi ah a om ua, kongpi ah hihgawp in a om uh, kuamah amaute hunkhe ding a omkei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A gilkial in linglak a kipan nasan a an kaihkhawm a gaihsak a, suamhat in a neih leh lam a nawmvalh sak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gimthuakna leivui a kipan in a hongpawt kei a, lei a kipan in buaina leng a hong dawnkhe sam kei hi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh mihing buai ding mah a piang ahi, mei ekte a tou len bang in.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Himahleh ken ahihleh, Pathian lam ah ka zong ding a, Pathian kiang ah ka thu ka koih ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thil thupite hihpa leh zonkhiak theihlouh; simzohlouh thillamdangte:
  </para>
  <para style="p">
    <verse number="10" style="v" />Leitung a vuah pepa leh, loute tung a tui sawlpa:
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in aman a niamsate tungsang ah a koihtou a; misi sunte muanna ah a tawisang hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zekhemhatte lunggelte bangmahlou a suaksak a, huchi in a khutte un a thiltup uh a hih theikei uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mipilte a zekhemhatna un a man a: mi hoihloute thilgel a thal paihsak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sunlai in khomialna a thuak ua, Zanlai bang in suntang lai in a mai maimah uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh aman gentheite mi hatte kam leh khut a kipan leh tasamte mahmah namsau a kipan a hondam hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in genthei in lametna a nei a, thulimlouhna in a kam a humsak hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Ngai in, Pathian in a bawlhoih min nuam a sa hi; huaiziak in bangkim hihthei sawina musit ken.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman lah meima a bawl a, a tuam a: a liamsak a, a khut in a damsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Buaina guk ah a hon suaktasak ding a; Ahi, sagih ah gilou in nang a hon khoih kei ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kial chiang in nang sihna a kipan a hontan ding; namsau thilhihtheihna a kipan, kidou chiang in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kamsung a leizepna a kipan honsel ding a; siatna a hongtun chiang in na lau sam kei ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Siatna leh kialna ah na nui ding a, lei gamsate na kihta kei ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Gam a suangte toh na kithuahtheih ding ziak un; huan gam a gamsate nang toh na kituak ding uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na puanin muang in a om chih na thei ding a; na ganhuang na veh ding a, bangmah kimlou a omkei ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na chite leng a thupi ding a, na suante lei a loupa bang in a om ding uh chih na thei ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kum ching in na han na zuan ding a, a hun a buhlak a om bang in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ngai in, hiai thu i zongta ua, a dikmah ahi, za in na hoihna ding in thei in.”
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aw ka lungzinna kibuk thei hi henla, ka tuahsiatna selbukna ah ki koihkhawm thei hileh:
  </para>
  <para style="p">
    <verse number="3" style="v" />Tun tuipite a piaunel sang in a gikzaw ding: huaiziak in ka thugente leng a khauh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thilbangkim hihthei thalte lah ka sung ah a om ngal a, gu huai a kipan a ka kha in a dawnvek: Pathian mulkimhuainate kei dou din a kivual uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Loupa a nekding mu gam sabiltung a ham ahia? Ahihkeileh gan an mu bawngtal a ham ahia?
  </para>
  <para style="p">
    <verse number="6" style="v" />Gim neilou chi tellou in a kine thei dia hia? Ahihkeileh aktuida ah limna mawngmawng a om hia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka kha in amaute a khoih nuam kei; kei ding in an kihhuai bang ahi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Aw ka nget tang theileng zaw; ka thil deih Pathian in hon phal lezaw:
  </para>
  <para style="p">
    <verse number="9" style="v" />Kei hon hihgawp ding in Pathian deihlam hilai henla; a khutzan in, kei hon satkhe mai leh:
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in lungmuanna ka neilai dia; ahi, damlou natna ah ka kipak ding: Misiangthoute thu ka kitheihmohbawl ngal kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka hatna bang ahia, ka ngak ding? Huan ka beina bang ahia, ka kuhkal ding?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka hatna suangte hatna hi hia? Ahihkeileh ka sa dalsik hia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Kei ah panpihna a om hetkei a, kei a kipan theihsiamna hawlmang in.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Bah dia mansa a om kiang ah a lawm in siamna a etsak ding ahi kei maw; huchilou in Bangkim hihthei kihtakna tawpsan ahi kei ding maw.
  </para>
  <para style="p">
    <verse number="15" style="v" />Luita bang in ka unaute a lepchiah uh; luita mangthang luanna bang in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai tuikhal in a vom a; huai ah vuk a kisel.
  </para>
  <para style="p">
    <verse number="17" style="v" />A lum hun chiang in a tuimang ua, a sat chiang in a mun ua kipan a mangthang uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai lampi a khualzinte a pial ua, bangmah omlouhna mun ah a paitou ua, a mangthang uh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tema khualzinte’n a zong ua, Sheba pawlte’n a lamen uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />A kilamet hang un a zahlak uh; huai lam ah a vapai ua a zahlak uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Tuin bangmah na hi ngal kei ua; mulkimhuaina na mu ua, na lau uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kei honpia un? Ahihkeileh na neih leh lam ua kipan in kei ading in thilpiak lan un, ka chi hia?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ahihkeileh, melma khut apan hontan un, mi hat khut apan hon hukhia un ka chi hia?
  </para>
  <para style="p">
    <verse number="24" style="v" />“Hon sinsak in, huan ka dai ding: ka diklouhna hon theisiam sak un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thudikna thute hat hinah e: himahleh miselna in bang a selphou a?
  </para>
  <para style="p">
    <verse number="26" style="v" />Thute selphou ding a um na hi uhia? Chimawhmi thugente huih bang ahi chih thei in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ahi, paneiloute tung ah ai na san ua, na lawm uh sumsinna van in na bawl uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Tuin hehpih in hon en un; na ma uah thuzuau ka gen kei a.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kiknawn un ka hon ngen ahi, diklouhna omkei hen; ahi, kiknawn un, ka thu a dik ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka lei ah diklouhna a om hia? Thil hoihlou ka lei in a theikak theikei dia hia?
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Leitung ah mihing adin kidouna a omkei maw? A nite kilohmi nite bang ahi ka hia?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lim deih mahmah sikha bang in, a loh lamen kilohmi bang in:
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai bang in bangmahlou khate nei ding a bawl ka hi, huan kei ading in zan chimhuaite seh ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka lup chiang in, chikchiang in ka thou dia? ka chi a; himahleh zan a sawt hi; lehlam lehlam ah nisuah matan kilumlet in ka om hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka sa than leh leivui khal in a tuam a; ka vun kimat in a puakkham hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka nite siamganmi khohthei sang in a kin zaw a, lametna bei a zatbei ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Aw ka hinna huih ahi chih theigige in: ka mit in hoih a mu nawn kei ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kei honmu mit in hon en thei nawn takei ding a; na mitte ka tung ah a om ding ua himahleh ka omta kei ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Meipi mangthang a omtak louh bang in, huchi in kuapeuh Sheol a paisuk a hong paitou nawnta kei uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A inn ah a kiknawn kei ding a, a mun in amah a thei nawn kei ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huaiziak in ka kam ka khou kei ding a; ka lungsim gimna ah thu ka gen ding; ka kha haksatna ah ka phun ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Tuipi ka hi hia, ahihkeileh tua Tuipi ngapilian ka hi ahia, huchi a kei n’on chinnak?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka lupna in hon lungmuan ding a, ka tutna nem in ka phunna a zangkhai sak ding, ka chih chiang in;
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaichiang in mang in n’on lausak a, mengmuhna in n’on mulkimsak hi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in ka kha in heklup leh sihna a tel a, hiai ka guhte sang in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka hinna ka chimtak a; ka hing gige kei ding: hon omsak maimai un; ka nite lah bangmahlou ahi ngal a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mihing bang ahia, hichitel a na pahtawi ding a, amah tung a na lungtang na koih ding?
  </para>
  <para style="p">
    <verse number="18" style="v" />Zingsang teng a amah na veh a, mitphiatkal chih a amah na ettel ding?
  </para>
  <para style="p">
    <verse number="19" style="v" />Bang tan vei kei hon lehngatsan louding na hia, bang tanvei ka chil ka nawmvalh matan hon omsak maimai louding na hia?
  </para>
  <para style="p">
    <verse number="20" style="v" />Na khial hita leng, na tung ah bang ka hih a, Aw mite chingpa nang? Bangdia nang adia chiamtehna bang a hon koih na hia, huchi a keimah adia puakgik ka hih maimah?
  </para>
  <para style="p">
    <verse number="21" style="v" />Bangdia ka tatlekna ngaidam lou a, ka thulimlouhna lamang lou oi? Kei tuin leivui a lum ding ka hi a; kuhkaltak in na honzong dia, himahleh ka omta kei ding hi.”
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Bildad Sua min a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Bang tan hiai thilte gen ding na hia? Bang tan na kam a thute huih hat bang ding ahi ua?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pathian in vaihawmna a hekkawi ahia? Ahihkeileh Thilbangkim hihthei in dikna a hekkawi ahia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Na tate a tung ah a khial ua, huai tatlekna ziak a a khut a amaute a pikhiak leh:
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian lam kuhkaltak a na zon a, huai Thilbangkim hihthei kiang a na thilnget na bawl leh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Na siangthou a na dik leh; nang ziak in tuin ka khanglou dia, na diktatna omna a lohching sak ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na kipatna neu mahleh, na tawpna nanung lam nakpi’n a thupi ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Huaiziak in k’on ngen hi, hun masa thu kan inla, a pipute un a na zonkhiak uh lam ah kisuk in:
  </para>
  <para style="p">
    <verse number="9" style="v" />Ei lah zan a lel i hi ua, bangmah i theikei uh, leitung ah i nite uh lah limliap ahi a:
  </para>
  <para style="p">
    <verse number="10" style="v" />Amaute’n nang a hon sinsak un, a honhilh un, a lungtang ua kipan in thute a gen kei ding ua hia?
  </para>
  <para style="p">
    <verse number="11" style="v" />“Buannawi lou in phaiphek a khangkhe thei ahia? Tui lou in loupa a khangthei ahia?
  </para>
  <para style="p">
    <verse number="12" style="v" />Hing a om a, satpuk louh a hihlai in, loupa dangte ma in a vuainak hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai bangmah in Pathian mangngilhte tengteng lampi ahi; pathian limsaklou mi lametna a mangthang ding:
  </para>
  <para style="p">
    <verse number="14" style="v" />A muanna a kitam ding a, a kingakna maimomlen ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A inn tung ah a kingai dia, himahleh ading kei ding: huai ah a len chinten dia, himahleh a pangsawt kei ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nisuah ma in a hing a, a huan ah a selte a mengkhia uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A zungte leivum kim ah a zam ua, suangte omna mun ah a hing hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A mun a kipan lakmang hileh, huchi in amah a kitheihmohbawl ding a, Ka honmu ngeikei, chi in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai in, hiai a lampi kipahna ahi a, lei a kipan a dangte a hongsuak ding uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ngai in, Pathian in mi hoihkim a paikhe kei ding, gilou hihmite leng a tungding sam kei ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na kam nuih in a hon dimsak lai dia, na mukte kikouna in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hon mudahte zumna in a khuh ding a; gilou puanin a omta kei ding hi.”
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Chihtaktak in huchi ahi chih ka thei hi: himahleh Pathian lak ah mihing bangchi in a dik thei dia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah kiselpih a utlam ahihleh, sang khat lak a khatvei zong amah a dawng theikei ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah lungtang in a pil a, hatna in thil a hihthei ahi: amah dou in kua a kikhauhsak in, a lohchingta a oi?
  </para>
  <para style="p">
    <verse number="5" style="v" />Mualte a suan a, a theikei ua, heh a amaute a lumleh lai in.
  </para>
  <para style="p">
    <verse number="6" style="v" />A mun a kipan in lei a sing a, huan huai a khuamte a ling uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ni thu a pia a, a suakkei; aksite a bilhkhum ngiungeu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah kia’n vante a phalhkhia a, tuipi kihot tung ah a pai hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman Jangkhua, Zuheisuktun, Siguk leh simlam aksi munte a bawl hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman suitheih vuallouh thil thupite sim zohlouh thillamdangte a hih hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai in, ka kiang ah a pai a, amah ka mu kei: a pai lailai a, himahleh amah ka mu kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai in, samat a man a, amah kuan a khamthei dia? Bang hih na hia? Kuan a kiang ah a chi dia?
  </para>
  <para style="p">
    <verse number="13" style="v" />“Pathian in a hehna a lakik kei ding; Rahab panpihmite amah nuai ah a kun petmah uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bangchiphet a tawmzaw in amah ka dawng in, amah toh ngaihtuah ding in ka thute ka telkhe dia hia?
  </para>
  <para style="p">
    <verse number="15" style="v" />Diktatta zong leng amah ka dawngkei ding hi; ka gal kiang ah thilngetna ka bawl theilel ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah sam in hon dawng mahleh; ka aw a ngaikhia chih ka um kei ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huihpi in a hon kitamsak a, a san omlou in ka liamnate a pungsak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka nak a hon phalkei a, himahleh thangpaihna in hon dimsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hatna thu genleng, ngai in, Amah a hat hi: vaihawmna thu, kuan hun a honpe dia?
  </para>
  <para style="p">
    <verse number="20" style="v" />Ki diktatsak leng, ka kam mah in a hon mawhpaih hi: hoihkim ta zongleng, hoihlou in a hon telsak ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hoihkim mah leng, ka kilimsak kei; ka hinna ka musit hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A kibang ahivek a; huaiziak in ken, hoihkim leh gilou a hihse tuak, ka chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jepna in thakhat in that leh, mi hoih thuakna a nuihsan ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lei migilou khut a piak a a om chiang in huai a vaihawmmite maituam a; amah ahihkeileh, kua ahita dia?
  </para>
  <para style="p">
    <verse number="25" style="v" />“Tuin ka nite laihawmmi sang in a kin zaw a a taimang ua, hoih a mu kei uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Long kinte bang in a paimang ua, muvanlai samat tung a ngumkiak bang in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka phunna ka mangngilh dia, ka mel lungkham ka pai dia, ka kipak ding, chi leng.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka lungkhamna tengteng ka lau a, hoih n’on sa kei ding chih ka thei hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mawhpaih in ka om dia; bangdia a thawn a semgim ka hia?
  </para>
  <para style="p">
    <verse number="30" style="v" />Vuk tui in kisil in, ka khutte siangsak kei leng;
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinapi in guam ah n’on pailut dia, keimah puante’n a hon kih ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kei bang mihing ahi kei a, amah ka dawn theihn a, vaihawmna a ka hoh khawm theihna ding un.
  </para>
  <para style="p">
    <verse number="33" style="v" />Ka kikal uah kougel hon mattheihna ding in, thulaigenmi a omkei hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Kei apan in a chiang lamang henla a kihtakhuaina in kei hon lausak kei hen:
  </para>
  <para style="p">
    <verse number="35" style="v" />Huaichiang in thu ka gen dia, amah ka lau kei ding: keimah ah huchibang ka hi ngalkei hi.”
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Ka kha in ka hinna a chimtak a; ka utdan dan in ka phun ding hi: ka kha thangpaihna in thu ka gen ding.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pathian kiang ah, Hon mawhpaih ken; bangdia hon kinakpih na hia hon theisak in, ka chi ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na nuaisiah nang adia hoih ahi maw, na khutte thilhih na muhsit a, giloute thugen tung a na maitai?
  </para>
  <para style="p">
    <verse number="4" style="v" />Sa mitte nei na hi hia, ahihkeileh mihing muh bang a mu na hi hia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Na nite mihing nite bang hia, ahihkeileh na kumte mihing kumte bang,
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka thulimlouhna na kan a, ka khelhna na nungdelh hi,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka gilou kei chih thei napi a, na khut a kipan hon suaktasak ding a omlouh?
  </para>
  <para style="p">
    <verse number="8" style="v" />Na khutte’n a honsek un a hon bawl kimvel sipsip a; tun kihei in n’on hihse dia hia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Theigige in, ka hon ngen ahi, tungman bang a na hon mek dan; leivui hontun nawn ding na hi hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nawitui bang in n’on sungkhia in, nawituidat bang in na hontok kei maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Vun leh sa in na hontuam a, guhte leh thagui in n’on phankhawm hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hinna leh deihsakna na honphal a, huan n’on venna in ka lungsim a hawi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh hiai thilte na lungtang sung ah na sel a; hiai bel na tup ahi chih ka thei hi:
  </para>
  <para style="p">
    <verse number="14" style="v" />Thil ka hihkhelh leh n’on chiamteh a, ka thulimlouhna a kipan n’on khahkei ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka gitlouh leh, ka tung a gik hi; midiktat hileng zong, ka lutang ka sangsak kei ding hi. Lungbuaina in ka dim a, huaiziak in ka gimthuakna en in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka lutang a kiletsak leh, humpinelkai bang in nang n’on beng a: ka tung a na lamdan dan n’on ensak nawn hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei kalh a na palainate na ’, ka tung a na hehna na khangsak a; hondou ding sepaih hon thak n’on sawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Bangdia sul apan hon lakhia na hia? Na si in kuamah muhlouh na hi leng.
  </para>
  <para style="p">
    <verse number="19" style="v" />Omlou mahbang ta ding hing a; sul apan a han a puak a om ding hing a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka nite a tom kei maw? Huchi ahihleh, tawp in, hon om sak maimai in, huchi a neukha a ka lungmuan theihna ding in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka kiknawn louhna a ka pai ma in khomialna gam leh sihna limliap gam mahmah ah:
  </para>
  <para style="p">
    <verse number="22" style="v" />Mialna mahbang a, mialna sahna gam a: sihna limliap gam, dan himhim omlouhna, khovak khomial bang a a omna mun ah.”
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Zophar Naamathmi in a dawng a, hichi in a chi a:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Thu tampite dawnlouh ding ahi a hia? Mi houlimna a dim siamtansak ding hia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na kisaktheihnate’n mite daisak ding hia? na simmawh chiang in, kuamah in nang hon zahlaksak lou ding uhia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka thuhilh a siangthou a, na mit uah ka siang hi, na chi ngal a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh Pathian in thugen maizen le zaw, nang dem in a mukte hongleh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in pilna thugukte nang a hon ensak ding a, a theihna ah thuah tampi ahi chih: huaiziak in na thulimlouhna sang a tawmzaw na lak ah Pathian in nang a honphut chih thei in.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Zon in Pathian na mu thei diam; hoihkimna ah Thilbangkim hihthei na mu thei diam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Van bang in a sang a; bang na hihthei dia? Sheol sang in a thuk a; bang na theithei dia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai a tehna lei sang in a sauzaw a, tuipi sang in a zazaw hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Paisuak henla, man henla, vaihawmna ah sam leh, huchi’n kuan amah a dal thei dia?
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman lah mi bangmah loute a thei ngal a: ngaihtuah kei mahleh, thu limlouhna leng a mu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing theihsiamna bei in theihsiamna a nei ding, sabiltung nou mihing a a pian chiang in.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Na lungtang na koih dik a, amah lam a na khutte na zak leh;
  </para>
  <para style="p">
    <verse number="14" style="v" />Na khut a thulimlouhna a om a, gamlapi a na koihkhiak a, gitlouhna na puanin a na tensak kei leh;
  </para>
  <para style="p">
    <verse number="15" style="v" />Gensiatna ding omlou in na mai na daksak ding a; ahi, na kip ding a, na lau kei ding:
  </para>
  <para style="p">
    <verse number="16" style="v" />Na haksatna na mangngilh ding ziak in; tui luangmang bang in na theigige ding hi:
  </para>
  <para style="p">
    <verse number="17" style="v" />Sunlai sang in na hinna a telzaw ding a; khomial om mahleh, zingsang bang ahi ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lametna a om ziak in, na kipta ding hi; ahi, amah tanchin na zong ding a, muang in na khawlta ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Lup leng na lum ding a, kuamah in nang hon lausak kei ding uhi; ahi, mi tampi’n nang honzong ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh gilou mitte a zuausuak ding a, a suakta kei ding ua, a lametna uh kha khah ahi ding hi.”
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ginlelh vuallouh in mite zaw na hi peuhmah ua, nou toh pilna a si ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh noute bang in theihsiamna ka nei hi; nou sang in ka niam zaw kei hi: ahi, hiaite bang thilte kuan a theikei a?
  </para>
  <para style="p">
    <verse number="4" style="v" />Kei zaw mi invengte adia nuihzabuk ka hi a, kei, huai Pathian sam a, huai aman amah a dawnpa, mi dik, mi hoihkim, nuihzabuk ka na hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Omnuam a om ngaihtuahna ah vangsiatna muhsitna a om a; himahleh a khe uh teute ading in mansa in a om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Suamhatmite puaninte a lohching a, Pathian hehsakte a bit ua; a khut a pathian tawite Pathian in tampi a pia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Himahleh gamsate dong in, huchi in amau nang a hon sinsak ding uh; huan huihkhua a vasate’n, nang a honhilh ding uhi:
  </para>
  <para style="p">
    <verse number="8" style="v" />Ahihkeileh lei kiang ah thu gen in nang a hon sinsak ding ua; tuipi a ngasate’n na kiang ah a phuang ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hiai tengteng ah, Toupa khut in a hihkhin chih kua ahia theilou?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah khut ah thil hing chiteng kha leh, mihing tengteng hatna a om hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bil in thute enchian in, Kam in an a chiam kei maw?
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi upate kiang ah pilna a om a nite sauna ah theihsiamna a om hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Amah kiang ah pilna leh hatna a om; aman thupha leh theihsiamna a nei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai in, a kaipuk a, a kilam nawn theikei ding; mihing a khakbing a, kuama’n a hong theikei ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai in, tui a ching a a kang hi; a khahkhia a, lei a tumvek hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kiang ah hatna leh pilna a om a; khem a omte leh khempa amah a ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thuhilhmite lohsam in a pimang a, huan vaihawmmite mihai in a bawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kumpipate kolte a sut a, kawnggak in a kawng uh a gak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Siampute lohsam in a pimang a, mi hatte a zou hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Muan mite thugen a suan a, upate theihsiamna a lamang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lalte tung ah muhsitna a buak a mihatte kawnggak a phel hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mial a kipan in thil thukte a mukhia a, sihna limliap khovak ah a hon lakhia hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Namte a pungsak a, amau a hihsia: namte a thehzak a, a lakhawm nawn hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lei a mite hausate lungtang a lamang a, gamdai a lampi omlouhna ah amau a vakvai sak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Vakna bei in khomial ah a mai ua, huchi in zukhammi bang in amau a hoisak hi.”
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Ngai in, ka mit in hiai tengteng a mu hi, ka bil in huai za in a theisiamta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Na thei uh, huai mah ken leng ka thei hi: nou sang in ka niam zaw kei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thilbangkim hihthei kiang ah thu ka gen mahmah ding, Pathian toh houlim ka ut hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh nou zuau phuakte na hi ua, a phattuambei damdawisiam na hivek uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw na vek un dai sipsip le uchin maw; na pilna uh hi ding hiven.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tuin ka thusut za un, ka mukte ngetna ngaikhia un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian ading in diloutak in thu na gen ding uam, amah ading in khemhattak in na houlim ding uam?
  </para>
  <para style="p">
    <verse number="8" style="v" />Ami na zahtak ding uam? Pathian adin na sual ding uam?
  </para>
  <para style="p">
    <verse number="9" style="v" />Nou a hon zonkhiak a hoih hia? Ahihkeileh min mi a khem bang in, amah na khem ding uam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Nou a honsal mahmah ding, a guk a mite na zahtak uleh.
  </para>
  <para style="p">
    <verse number="11" style="v" />A hoih tungtuanna in nou a hon lausak kei dia hia, nou tung ah a kihtakhuaina a ke kei diam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Na thupilte uh vut banglel ahi, Manna bei paunak ahi a, na kidalnate uh tungman kidalnate ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Dai unla, thu ka gen theihna ding in, hon omsak maimai un, ka tung ah a hongtung ding hongtung hen.
  </para>
  <para style="p">
    <verse number="14" style="v" />Bangding in ka ha in ka sa kei ding a, ka khut ah ka hinna koih ding ahia?
  </para>
  <para style="p">
    <verse number="15" style="v" />Aman honthat mahleh, amah ka ngaklai ding: a ma ah ka lampite ka kem hoih lailai ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiai leng ka hotdamna ahi ding; Pathian limsaklou mi a ma a hongpai lou ding a hih ziak in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka thugen thanuamtak in za un, ka thuphuan na na bil sung uah om hen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngai un, tuin ka thu ka bawlhoihta a; ka diktat ahi chih ka thei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kei hon kiselpih ding amah kua ahia? Kei tuin ka dai dia kha ka khah ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tung ah thil nih hih kei phot le uchin, huchi in na mai a kipan ka bu kei ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kei apan gamla ah na khut kaikik in; na lauhuaina in hon lausak ken.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huaichiang in honsam lechin, k’on dawng ding; ahihkeileh hon pausak inla, hon dawng in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka thulimlouhnate leh khelhnate bang ahia? Ka tatlekna leh ka khelhna hon theisak in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Bangdia na maisel a na melma dia honbawl na hia?
  </para>
  <para style="p">
    <verse number="25" style="v" />Singnah mutleng na hihbuai dia hia? Buhpawl keu na delh dia hia?
  </para>
  <para style="p">
    <verse number="26" style="v" />Nang lah kei dem in khatak in na gelh a, ka tuailai thulimlouhnate n’on luahsak hi:
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka khete leng kol na bunsak a, ka lampite tengteng na chiamteh hi; ka khenuai kim ah gi na khung hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihing zaw thilmuat leh nget nekgawp puansilh bang in a mangthang hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Mihing, numei apan piang nite tomchik ahi a, buaina ngen in a dim hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pak bang in hong dawnkhia a, a vuai nawn pah, limliap bang in a tai a, a om gige kei.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi huchibang tung ah na mit hak in, vaihawmna ah kei n’on pi dia hia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Thil nin a kipan in kuan ahia thil siang lakhe thei? Kuamah in.
  </para>
  <para style="p">
    <verse number="5" style="v" />A nite sehsa ahi chih thei in, na kiang ah a khate simna a om a, a kan theilouh ding in a gamgite na septa hi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Amah enken, a khawl theihna ding in, kiloh bang a, a ni a hihkim matan.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Phukpaih in om mahleh, a hong selnawn ding a, a hiang nou a tawp kei ding, chih sing adin lametna lah a om ngal hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A zung lei ah upa mahleh, A kungpi lei ah sita mahleh;
  </para>
  <para style="p">
    <verse number="9" style="v" />Tuigim ziak in a hongnou thak dia, singsuan bang in bawkte a hon neikhe nawn ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihing a si a, a mang zel hi: ahi, mihing in kha a khah a, huan koi ah a om a?
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuipi a kipan tuite a pai bang in, luipi bel a tul a, a kang hi;
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai mah bang in mihing a lum a a thoukei hi: vante a om nawnlouh matan, a khanglou kei ding uh, a ihmu uh leng a halh khe sam kei ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aw Sheol ah honsel lechin aw, na thangpaihna a man masiah hon na guk kep lechin, hun sehsa hon na pia in, kei hon theigige lechin aw;
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi sileh a hingnawn diam? Ka galdouna leh nasepna ni tengteng ka ngak ding a, ka suahtakna a hongtun ma tan in.
  </para>
  <para style="p">
    <verse number="15" style="v" />N’on na sam dia, k’on dawng ding hi: na khut nasep n’on lunggulh ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tuin ka kalsuante na sim a: ka khelhnate na chiamteh hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ip sung ah ka tatlekna bilh in a om a, ka thulimlouhna na gonggak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Mual kipuk bangmahlou a honghi taktak a, a mun a kipan in suangpi suan in a om hi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuite’n suang a kiamsak ua; leivui a kibawl munsangte na taimang a; huan mihing lametna na hihsia hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tangtawn in amah na zou a, a pai a; a mel na lamdangsak a, na sawlmang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tapate zah in a om ua, aman a theikei; hihniam in a om ua, himahleh aman amau ahi chih a theikei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh a tung a sa in natna a nei a, asung ah a kha in a sun hi.”
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Eliphaz Teman mi in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mi pil in theihna bangmahlou toh dawnna a bawl in, suahlam huih in a gilpi a dimsak sak diam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Houlimna phatuamlou thu a ngaihtuah in, ahihkeileh hoih a hih theihna louh ding a thugente a ngaihtuah diam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ahi, launa na hihmang a, Pathian ma a kipiakzohna na dal lai hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na kam in na thulimlouhna a sinsak a, zekhemhat mi lei na tel ngal a.
  </para>
  <para style="p">
    <verse number="6" style="v" />Nang mahmah kam in siamlouh a hon tangsak a, kei hilou in; ahi, nang dem in nangmah mukte mah in hon theihpih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Mihing piang masapen hi hia? Ahihke’h tangte om ma a lakkhiak na hi maw?
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian thuhilh guk na za ta hia? Huan pilna na kikoih hoih hia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka theihlouh uh bang na thei a? kou a omlou bang na theisiam a?
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka lak uah samkang leh upa mahmah a om tuaktuak, na pa sang a nakpi a upazaw.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian nepnate leh siamtak a honhilhte nang adia neu lua uhia?
  </para>
  <para style="p">
    <verse number="12" style="v" />Bangdia na lungtang in nang hon pimang ahia? Bangdia na mitte phia ahia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi a Pathian dem a na lungsim na hei a, na kam apan a huai thute na pawtkhiak sak.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing bang ahia, a sian ding? Numei apan piang amah kua ahia a diktat ding?
  </para>
  <para style="p">
    <verse number="15" style="v" />Ngai in, a misiangthoute ah muanna a nga kei a: a mitmuh in vante a siang kei uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi kihhuai leh sia, mi thulimlouhna tui bang a dawn, siang keina sem in chia:
  </para>
  <para style="p">
    <verse number="17" style="v" />“K’on ensak ding, honza in; huan ka muhsa ka phuang ding:
  </para>
  <para style="p">
    <verse number="18" style="v" />Mipil kuate in ahia a pipute ua kipan na thu gen a, a im louh uh;
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau kiang kia ah gam piak in a om a, mikhual kuamah a lak uah a pai kei uh:
  </para>
  <para style="p">
    <verse number="20" style="v" />Migilou in a damsung ni teng in natna a thuak a, nuaisiah hatmi adia khawlkhawm kumte zah mah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Launa ging a bil ah a om a; hauh lai in lokmi a tung ah a hongpai ding hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />Khomial a kipan a hongkik ding chih a um kei a, namsau a ngak in a om hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tanghou zong in a vakvai a, Koi a om ahia? chi in. Khomial ni a kiang chin ah mansa in a om chih a theikei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Dahna leh haksatna in amah a lausak a; kumpipa galdou dia mansa bang in, amah a zou uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pathian dou ding a khut a likkhiak ziak in, Thilbangkim hihthei dou ding a kisathei tak a om a,
  </para>
  <para style="p">
    <verse number="26" style="v" />A lum, a tuamna sahtaknei toh amah dou a a tai teitei ziak in;
  </para>
  <para style="p">
    <verse number="27" style="v" />A thau a a maitang a khuh a, a gil a thau a kholkhawm a,
  </para>
  <para style="p">
    <verse number="28" style="v" />Khopi tulsa a teng a, kuamah ten tuak louhna innte, segawp ngiingei dingte a luah ziak in;
  </para>
  <para style="p">
    <verse number="29" style="v" />A hau kei ding a, a neih leh lam a om gige kei ding a; amah lei ah zung a kai kei ding;
  </para>
  <para style="p">
    <verse number="30" style="v" />Khomial a kipan a suakta kei ding a, meikuang in a selnoute a kangkeu ding a, a paklunlaite a mut mang ding.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah kikhem in, banglou ah muang kei hen: bangmahlou lah a thukna hi ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="32" style="v" />A hun ma in hihzoh in a om dia, huan a hiang nou kei ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Grepgui bang in a gah min lou a singpulh dia, olive bang in a pak a paikhe ding.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pathian limsaklou kithuahpihna hut ding ahi a, golhna puaninte lah mei in a kangmang ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Siatna a pai ua, thulimlouhna a suakkhe sak uh, a lungtang un khemna a opkeuh uhi.”
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Huchibang thil tampi ka zata hi: lungmuanmi chimtakhuai ngen na hi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Thu bangmah loute’n tawp a nei ding uam? Ahihkeileh dawng ding a nang hon hihheh bang ahia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nou bang in keileng ka pai theisam hi; na kha uh ka kha mun a om hileh, noute dem a thute kaikhawm a, ka lu hon sinkhum thei ding hi vengin.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh ka kam in nou k’on hatsak ding a, ka muk a muanna in na lungkhamna uh k’on nem ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Thu gen mah leng, ka dahna nep in a omkei a: doh mah leng, hihnop in ka om ahia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh a hon chimtak sakta a: ka lawmte tengteng na hihgamta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan kiptak in na honlen a, huai kei demna theihpihna ahi: huchi in ka gawnna kei dem in a thou a, ka mai tang ah a theisak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A hehna in kei a hon botkek a, a honsawi hi; a ha a hon gawi khum a: ka tung ah ka gal in a mit a tat hiam hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kam uh lianpi in a honkat khum ua; simmohtak in ka biang ah a hon beng uh: kei dou ding in a kikai khawm ua.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in Pathian limsakloute kiang ah a honpe khia a, migiloute khut ah a hon paikhia hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Om nuam in ka om, a hon kitamsak a; ahi, ka ngawng in a honman a, honpai nen hi: a muitum ding in a hon tungtou hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A thalkapmite’n ka kimvel ah a hon um ua, ka sisan guite a bottat a, a hawi kei; lei ah ka sinkha a sungkhia hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Siatna tung ah siatna in a hon sesak a; galhat bang in ka tung ah a tai.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka vun tung ah saiip ka khui a, leivui ah ka kingata hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kahna in ka mai a hoihta kei a, ka mitvunte ah sihna limliap a om hi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka khut ah hiamgamna omkei mahleh, ka thumna siangthou mahleh.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Aw lei, ka sisan khuh ken, huan ka kahna in khawlmun neikei hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tu mahmah in, Ngai in, a hon theihpih van ah a om a, kei hon theihpihpa tungsang ah a om hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka lawmte’n hon nuihsan ua, himahleh ka mit in Pathian ah khituite a sungkhia hi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi a Pathian lak a mihing dikna a letkip theih a, invengte lak a mihing tapa dikna a letkip theihna ding in:
  </para>
  <para style="p">
    <verse number="22" style="v" />Kum tawmkha a hongtun chiang in, ka kiknawn louhna ding lampi ah ka paita ding ahi.”
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka lungsim hihgawp in a om a, ka nite a bei, kei ding in han mansa in a om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka kiang ah musitmite a omtaktak ua, a hehna uah ka mit a om gige hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />“Tuin thuchiam honpia in, nangmah toh kei ading in mawhkhu honghi in; kei toh khutte beng ding kua a om a?
  </para>
  <para style="p">
    <verse number="4" style="v" />Theihsiamna a kipan a lungtang uh na sel ngal a: huaiziak in amau na hihlian kei ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kuapeuh matding a a lawmte hek a, a neih leh lam tan tummi, a tate nangawn mit a zuausuak ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Mite houlimna ding in a honbawl lai a; huchi in tangpi kih ka hong hita hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Lungkhamna ziak in ka mit leng a mial a, ka hiangte tengteng limliap bang ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Midikte’n hiai ah lamdang a sa ding ua, mi hoih Pathian limsakloute dou ding in a kitokthou ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh mi diktat a lampi ah a pang zouzou dia, kuapeuh khut siangneite a hat semsem ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh hongkik un, na vek un, tuin hong un: huchi in na lak uah mi pil ka mu kei ding.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka nite a beita, ka thiltupte a segawpta hi, ka lungtang ngaihtuahte tan in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zan sun in a kheng ua: khovak in khomial a naih, a chi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sheol ka inn bang in en leng; khomial ah ka lupna phahta leng;
  </para>
  <para style="p">
    <verse number="14" style="v" />Siatna kiang ah, Ka pa na hi, chi leng; Tangtel kiang ah, ka nu leh ka sanggamnu na hi, chi leng;
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi hileh ka lametna koi a om ahia? Lamet nei hileng kuan hon musak dia?
  </para>
  <para style="p">
    <verse number="16" style="v" />Sheol mundaite ah paisuk in leivui ah ka kik khawm ding ua a diam?”
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bildad Suah mi in a dawng a, hichi in a chi a:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Thute zong a bang tan thangkam ding na hi ua? Ngaihtuah in, huaizoh chiang in ka pau ding uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bangdia gamsa bang a sim a om a, na mitmuh ua sianglou ka hi ua?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang na hehna kipumpei ziak in lei mangngilh in a om diam? Ahihkeileh a mun a kipan in suangpi suankhiak in a om diam?
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ahi, migilou vakna mih sak in a om ding a, a mei ek a tang kei ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />A puanin ah vakna a mial dia, a tung a khawnvak mihsak ahi ding.
  </para>
  <para style="p">
    <verse number="7" style="v" />A hatna kalsuante a hih tuailuai ahi dia, amah thupha gen in a paikhe ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah khe mahmah in len sung ah amah a pailut ua, len ah a awksak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thang in a khetul ah a man dia, thang in amah a len ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lei ah amah ading in thangkual sel in a om a, lampi ah amah adin thang.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kihtakhuaite’n ning chiteng ah amah a lausak dia, a khetul ah a delhzui ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A hatna gilkial nek in a om dia, tuahsiatna a khawlna ding in mansa in a om ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />A pumpi hiangte a negai ding a, ahi, a hiangte sihna ta masapen in a negai ding hi..
  </para>
  <para style="p">
    <verse number="14" style="v" />A suan a puanin a kipan zungkalh khiak in a om dia lauhuainate kumpipa kiang a pi in a om ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amah a hilou a puanin ah teng a om ding: a tenna ah kat thehzak in a om ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nuailam ah a zungte a keu dia, tunglam ah a hiang sat khiak ahi ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Lei a kipan in a theihgige a mangthang ding; kongzing ah min a neikei ding.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khovak a kipan in khomial ah hawllut ahi ding a, khovel a kipan a delh khiak.
  </para>
  <para style="p">
    <verse number="19" style="v" />A mite lak ah tapa a neikei dia, tute leng: a tenna ah kuamah omlai a omkei ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A malam a omte’n a ni lamdang a sa ding ua, nunglam a omte hihlau a a om bang un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchibang midiktatloute tennate ahi petmah a, Pathian theilou mi mun ahi hi.”
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Bang tan ka kha hihbuai a, thute a hon hihzan gawp ding na hi ua?
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai Sawmvei n’on kouta ua: ka tung a gilou tak a na hih uh na zum kei ua.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nana paikhialta leng maw, keimah kiang a ka diklouhna om gige hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kei dem in nou kiliansak petmah ve nuchin, ka minsiatna ka tung ah na gen ding uh a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in ka thu ah hon zouta chih tuin thei un, huchi in a len in a hon umsuak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai un, Hiamgamna, chi in ka kikou khia a, himahleh zak in ka omkei: panpih deih in ka kikou a, himahleh vaihawmna a omkei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka pai theihlouhna ding in ka lampi a um a, ka paina ding te ah khomial a koih hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka thupina hon suahsak a, ka lu a kipan lallukhu a lakhia hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ning chiteng ah a hon hihniam a, ka mangta hi: huchi in sing bang in ka lametna a bot khia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tung ah a hehna leng a sou a, amah ading in a galte lak a khat bang in a honsim hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A sepaihpawlte a hong kuan khawm ua, ka siatna ding in a lampi uh a bawl uh ka puanin kimvel in puanin a kai uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Kei apan in ka unaute gamlapi ah a koih a, ka meltheihte kei apan in a tuam vekta uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka tanaute’n a hon zuausan ua, ka lawm theihngeite’n a hon mang ngilhta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka inn tengte leh, ka sikhanute’n, mikhual a honsa ua: a mitmuh un namdangmi ka hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka sikha ka sam a, a hon dawng kei, ka kam in amah khem mah leng.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka hu ka zi ading in kihhuai a hi a, sanggamte ziak in pumpi hasiang mah le'ng ka namsia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Naupang neute nangawn in hon simmawh ua; ka thoh leh, ka siatna ding in thu a gen uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka lawm thudotte’n kei a honhua ua: amau ka itte ka tung ah a hel uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka guh ka vun ah leh ka sa ah a belh bikbek a, ka ha vun toh ka suakta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hon hehpih un, hon hehpih un, Aw nou ka lawmte; Pathian khut in kei a hon khoihta ngal a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bangdia Pathian bang a nou hon sawi na hi ua, ka sa a bangdia lungkim lou na hi ua?
  </para>
  <para style="p">
    <verse number="23" style="v" />“Aw ka thute tuin gelh in om le uh aw; Aw laibu ah kigelh lut le aw;
  </para>
  <para style="p">
    <verse number="24" style="v" />Sik leh ngen gelhna zum in tangtawn ading in suangpi a gelh hile uh aw;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka Tanpa a hing chih leh, a tawp chiang in leitung ah a ding nawn ding chih ka theih ziak in:
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka vun huchibang a hihsiat a a om khitnung in, himahleh ka sa a kipan Pathian ka mu ding hi:
  </para>
  <para style="p">
    <verse number="27" style="v" />Keimah ading in amah keimah mah in ka mu dia, ka mitte’n a en dia, midang hilou in. Ka sung ah ka lungtang a sidangta hi!
  </para>
  <para style="p">
    <verse number="28" style="v" />Amah bangchibang in i sawita phet di uam, na chih uleh, kei ah thu bul muh in a om chih thei in;
  </para>
  <para style="p">
    <verse number="29" style="v" />Namsau kihta un: hehna in lah namsau gawtnate a hontun ngal a, huchi a vaihawmna a om chih na theihtheihna ding un.”
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Zophar Naamathmi in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Huaiziak in ka ngaihtuahnate’n kei dawnna a honpia a, ka sung a om ka kinohna thu ziak mahmah in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kei hon zahlaksak salhna ka zata a, ka theihsiamna kha in a hon dawng hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei tung a mihing a om nungsiah, hun lui thu hiai na theikei maw;
  </para>
  <para style="p">
    <verse number="5" style="v" />Giloute vualzohna a tom a, Pathian limsakloute nuamsakna mitphiat kal sunglel ahi chih?
  </para>
  <para style="p">
    <verse number="6" style="v" />A hoihkimna in vante suntou in, a lu in meipite phatou mahleh;
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh amah ek bang in tangtawn in a mangthang ding a, Koi a om ahia? Amah mute’n a chi ding uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mang bang in a lengmang dia, muh in a omkei ding hi: ahi, zan mengmuh bang a hawlmang in a om ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amah mu mit in amah a muta kei ding hi; a mun in leng amah a muta kei ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A tate’n gentheite huhna a zong ding ua, a khutte’n a thil hoih a pe nawn ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A guhte a tuailai khelhna in a dim a, ah amah toh a lum ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gitlouhna a kam ah khum in a lei nuai ah sel mahleh;
  </para>
  <para style="p">
    <verse number="13" style="v" />Sit in, paisak kei in, a kam ah kem gige zou mahleh;
  </para>
  <para style="p">
    <verse number="14" style="v" />A gil a an kha in a a kitok a, asung a gulgu bang in a kha hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hauhsaknate a nawmvalh a, a lawkhe nawn ding hi: Pathian in a gilpi a kipan in a paikhe ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khuai gu a tep dia: gul lei in amah a that ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Luipite, khuaizu leh nawitui dat lui luangte a en kei ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sepgim gah a pe nawn dia a nawmvalh suk kei ding hi; a muhsa ah kipahna a neikei ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman lah gentheite a nuaisiah a, a mangngilh hi; a lam louhpi inn hiamgam tak in a lata uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“A deihgawlna in huntawk a neikei a a kipahpih thil himhim a khol kei ding.
  </para>
  <para style="p">
    <verse number="21" style="v" />A nekgaih louh bangmah omlai a omkei hi; huaiziak in a hauhna in a daih sawt kei ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />A hauh san lai in haksa sakna a nei dia: Thulimlou mi khut a hongtung ding a,
  </para>
  <para style="p">
    <verse number="23" style="v" />A gilpi hihdim ding a a kisaklai in, Pathian in a tung ah a thangpaihna kihtakhuaina a khe ding a, a nek lai in a tung ah a zusak ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Sik galvan a kipan a tai dia, dal thal in amah a kap pailet ding.
  </para>
  <para style="p">
    <verse number="25" style="v" />A dokkhia a, a pumpi a kipan in a hong paikhia: ahi a sinkha apat a mukzum tevelvel hong paikhia a launate a tung ah a hongtung hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A gou ding in mialna tengteng kholkhawm in a om: mei mutlouh in amah a negai ding; a puanin a nutsiat a om a negai ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vante’n a bohsiatna a taklang ding ua, lei amah dou ding in a thou ding.
  </para>
  <para style="p">
    <verse number="28" style="v" />A inn a punna a paimang dia, a hehni in a vante a luang mang ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiai Pathian apan a migilou tantuan ahi, a gouluah dia Pathian in a sehsak.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ka thugen hoihtak in ngaikhia unla, hiai na khamuanna thu uh hi hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Honthuak teitei unla, ka hon gen ding a, ka gen khit chiang in nuihsan na nu teh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kei phunna mihing tung ah hia? Bangdia kuhkallou a omlou ding ka hia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hon en unla, lamdang sa unla, khut in na kam uh hum un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka ngaihtuah in ka lung a dong a, linna in ka sa a man nak.
  </para>
  <para style="p">
    <verse number="7" style="v" />Bangziak in ahia migilou a hin a, tekkun a a dam a, a hong thupikhiak?
  </para>
  <para style="p">
    <verse number="8" style="v" />A suante uh a kiang uah a mitmuh uah a hihkip a, a gil ua gahte a mai ma uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />A inn leh loute uh lauhuai lak ah a bit a, Pathian chiang a tung uah a ke kei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A bawngtal un chi a khah a, a hut ngeikei, a bawngpi un nou a nei a, a nou a se ngeikei.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ganhon bang in a taneute uh a pawtsak ua, a tate uh a lam uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A pekging uleh kaihging toh kituak in la a sa ua, a tamngai ging uah a kipak uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />A nite uh lamzangtak in a zang ua, lungmuang in Sheol ah a paisuk uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian kiang ah, Hon paisan in, na lampite theih ka kilawp kei uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Bangkim hihthei bang a a hih, a na ka sep ding uh, A kiang a ka thum un punna bang a ka muh ding uh? a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ngai in; a lamzanna uh a khut ua om ahi kei ahia? Migilou lemtheihna kei a kipan a gamlapi a om ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Migilou meisel bangzah vei a mit a, vangtahna a tung ua a tun a, Pathian in a thangpaihna in lungkhamna a piak chiat?
  </para>
  <para style="p">
    <verse number="18" style="v" />Bangzah vei ahia buhpawl huih mut bang a hih ua, buhsi huihpi mutmang bang a hih uh?
  </para>
  <para style="p">
    <verse number="19" style="v" />Pathian in gitlouhnate a tate uh ading in a kholkhawm, na chi ua, amau tung ah tungsak le ake, a theihsiam nading un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Amau mit ngei in a siatna uh mu uhenla, Bangkim hihthei thangpaihna dawn uhen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman nung in a inn uh amau adin bang a a hih, a kha zah uh hihtawp a hih nung in?
  </para>
  <para style="p">
    <verse number="22" style="v" />Kuan ahia Pathian theihna sinsak ding? aman sangpi a omte vai a hawmsak ngal a.
  </para>
  <para style="p">
    <verse number="23" style="v" />A lutlai in mi a si a, nuam leh bit lai in.
  </para>
  <para style="p">
    <verse number="24" style="v" />A nawite nawizu in a dim a, a guhngekte thau in a dim hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Midang lungkhamtak in a si a, Nuamsa a a an chiam ngeilou in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Vutlak ah kibang in a lum ua, than in a pumtuam hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Ngai in, na ngaihtuah uh ka thei, dikloupi a ka tung a na sawmte uh.
  </para>
  <para style="p">
    <verse number="28" style="v" />Koi ah ahia kumpi in a om, migilou tenna puanin koi ah a om a? na chi uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />Zinzin mite na dong ngeikei ua hia? A gente uh na pom kei ua hia?
  </para>
  <para style="p">
    <verse number="30" style="v" />Migilou vangtah ni’n hawi in a om a, thangpaih ni’n hotkhiak in a om, chih.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kua ahia a maitang a a lampi pulak ding, kua ahia a thilhih bang a amah din ding?
  </para>
  <para style="p">
    <verse number="32" style="v" />Han lam a puak a hih in, a han ven ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Luiguam a leitang amah din a nuam a; mi tengteng in amah nung a zui ua, amah ma a na paite simsenglouh ahi uh.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bangchi in thu mulmal omloupi in hon khamuan ding na hia? Na dawnnate uah zuauthu loungal bangmah a omkei hi.”
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Eliphaz, Teman mi in hichi in a chi hi;
  </para>
  <para style="p">
    <verse number="2" style="v" />“Mihing Pathian ading in a phatuam thei diam? Kuapeuh a pil amah mah ading in a phatuam ngei a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na diktat, Thilbangkim hihthei ading a kipahna ahi ahia? Ahihkeileh na lampite na hoihkim sak, amah dia punna hia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang a honsalh a, vaihawmna a nang toh a lut, amah na kihtak ziak hia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Na gitlouhna a lian kei maw? Na thulimlouhna ah leng tawpna a omsam kei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Bangmahlou ding in na unau thuchiamte na la a, vuaktangte a puansilh uh na suahsak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Gim a in dawn ding in tui na pe kei a, gilkial adin tanghou na it hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh mi hat in gam a nei a; mi deihthoh a ung ah a teng hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khutvuak in meithaite na sawl mang a, pabeite khutte hihtan in a om hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huaiziak in thangte na kim ah a om ua, lau guihna in nang hon hihbuai hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahihkeileh khomial, na muhtheih louh, leh tui tampi in nang a honkhuh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Van sang ah Pathian a om ka hia? Aksite sandan en in, sang hina tel uh e;
  </para>
  <para style="p">
    <verse number="13" style="v" />Nang, Pathian in bang a thei a? Khomial bikbek ah vai a hawm thei dia hia?
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman hon muhlouhna dinga, meipi sah in liah a, van dum khen a a vak ahi, na chi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Migiloute totsa lampi lui na kem ding hia?
  </para>
  <para style="p">
    <verse number="16" style="v" />A hun ma ua lakmang a om a, a kingakna ua tuiluang bang a butkhiak a omte:
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian kiang a, Hon pai mangsan in; huan ei ading in Thilbangkim hihthei in bang a hih thei a? chite.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh a innte uh thil hoih in a dimsak ua: himahleh migiloute thugen kei a kipan a gamla hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi diktatte’n a mu ua, a kipak ua; mi hoihte’n amau a nuihsan ua,
  </para>
  <para style="p">
    <verse number="20" style="v" />Chihtaktak in ei dou ding a thoute satkhiak in a om ua, amaute lak a omlaite mei in a hulta, chi in.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Tuin amah kimeltheihpih inla, muangtakin om in: Huai ah hoih na kiang ah a hongpai ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A kam a kipan in dan sang in, k’on ngen hi, na lungtang ah a thute khol khawm in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thilbangkim hihthei kiang a na kiknawn leh, lamkip na hi ding; Na puaninte a kipan a gamlapi a diktatlouhna na koihmang ding ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan na gou leivui ah koih inla, luite suangte lak ah Ophir dangkaeng;
  </para>
  <para style="p">
    <verse number="25" style="v" />Thilbangkim hihthei na gou ahi dia, a manpha dangka nang a ding in
  </para>
  <para style="p">
    <verse number="26" style="v" />Thilbangkim hihthei ah kipak in, Pathian kiang ah daktou ding na hih ziak in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah kiang ah na thum ding a, aman a honza ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thil khat tung ah thupukna bawl in thu na pedia, nang adia hihkip in a om ding hi; huchi in na lampite ah khovak a tang ding.
  </para>
  <para style="p">
    <verse number="29" style="v" />A hon sawnpuk chiang un, Thoh touhna a om, na chi ding; Hihniam a omte aman a hondam ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Aman a hoihlou nasan a suaktasak ding a: ahi, na khutte sianna ziak in amah suahtaksak in a om ding.”
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuni mahmah in ka phunna helhuai ahi: ka thuakna ka mauna sang in a gikzaw hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aw amah ka muhna mun thei lengla, a tutna mahmah ah hoh thei leng aw!
  </para>
  <para style="p">
    <verse number="4" style="v" />A ma ah ka thu ka bawlhoih dia, thugente in ka kam dimsak ding hi veng.
  </para>
  <para style="p">
    <verse number="5" style="v" />A hon na dawnna ding thute ka thei dia, huchi in bang ahia ka kiang a a gen ding ka theisiam ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thilhihtheihna letna in kei a honsel diam? Ii; himahleh kei a hon limsak ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai ah midik in amah thu a sutpih thei dia; huchi in ka vaihawmmi apan suahtaksak in ka omtawntungta ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ngai in, mailam zuan in ka pai a, himahleh huai ah a omkei; nunglam zuan in, himahleh amah ka mu kei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Veilam pang ah, na sep lai in, himahleh amah ka mu theikei a: taklam pang ah a bu, amah ka muh theihlouhna ding in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh ka zuih lampi a thei a; a hon ze-et lai in, dangkaeng bang in k’on suakkhe ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka khe in a kalsuante a len kip a; a lampite ka zuita a, ka pial kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A mukte thupiak a kipan ka pai kik kei a, a kam a thute a kiphamoh ka an sang in ka kholkhawm zaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh amah lungsim kheklou ahi a, amah kuan a hei thei dia? A kha in a deih, huai mah ahihzel hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kei adia sehsa a hih ngal a: thil huchibang tampi a kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huaiziak in a omna ah ka buai a; ka ngaihtuah chiang in amah ka lau hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in ka lungtang a bahsakta a, Thilbangkim hihthei in a hon hihbuaita hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khomial ma in satkhiak in ka om ngal kei a, ka mai a kipan khomial sah leng a khuh sam kei hi.”
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bangdia Thilbang kimhihthei in vaihawmna hunte bawl lou ahia? Amah theite’n bangdia a nite mulou uh ahia?
  </para>
  <para style="p">
    <verse number="2" style="v" />Gamgi suan a om ua; ganhon hiamgam tak in a lamang ua, a vak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pabeite sabiltung a hawl mang ua: thuchiamna din meithai bawngtal a la uh.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lampi a kipan tasamte a hei khia ua: lei a gentheite a kisel khawm uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai in gamkeu a sabiltungte bang in a thilhihna lam uah, an thanuamtak a zong in a paikhia ua, a tate uh ding in gamdai in amau an a suaksak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gam lam ah a gan an a at ua; migiloute grep gah a la uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Zankhua in puan bei in vuaktang in a lum ua, khovot ah khuhna neilou in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mualte vuahphin in a kawt ua, belhding deihman in suangpi a kawi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Pa neiloute nawi a kipan kai khia a om ua, huan gentheite thuchiam la:
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in tasamte puanbei in vuaktang in a vialvak ua, buhphalte gilkial in a pua uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Olive apan sathau a bawl ua; a uain sukna uh a chil ua, himahleh a dangtak uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khopi a kipan mite a mau ua, liamte kha a kikou khia ua; Pathian in a limsak kei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Hiaite khovak tung a helte lak a ahi ua; huai lampite a theikei ua, a lampite ah a om gige sam kei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tualthatmi zan mial in a thou a, gentheite leh tasamte a that a; ahi, zan in gutami ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Angkawm mi mit in leng khomui a ngak a, kuamah in honmu kei ding, chi in, a mai a bawl lamdang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khomial in innte a vut pailet ua: sun chiang in a kikhum bilh ua; khovak a theikei uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amaute tengteng ading in zingsang sihna limliap bang ahi a; zan mial lauhuaite lawm in a nei uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Tuite tung ah kintak a taihmang in a om ua; a tantuan uh lei ah hamsiat in a om: a grephuante sukmi in a naih kei.
  </para>
  <para style="p">
    <verse number="19" style="v" />Khokhal leh nisa in vuk tuite a tawpkang a: huai mah bang in thil hihkhialte Sheol in a hih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sul in amah a mangngilh dia; than in limsatakin amah kivakna in a nei ding uh; theihgige in a omta kei dia, diktatlouhna sing bang a hihtan in a om ding.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Ta neilou numei ching a negai a; meithai ading in hoih a hih kei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahi a lah Pathian in a thilhihtheihna in mihatte a dawmkang a, hinna a lamet phaklouh lai un a dingtou uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bitna Pathian in amau a pia a, huchi in huai ah a khawl uh; a mitte a lampite uah a om hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hihlet in a om ua; himahleh sawtlou kal in, a bei uhi; ahi, sukniam in a om ua, midang tengteng bang in lampi a kipan lak khiak in a om ua, buhvui bang a at khiak in a om uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchibang na hi kei ta leh kua ahia zuauthei a hon chian ding a, ka thugen ah bangmah omlou a lak ding?”
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bildad Suah mi in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Lalna leh launa Pathian kiang ah a om; Aman a mun sangte ah muanna a bawl hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A sepaihte honte kuan a simseng dia? Kua tung ah ahia A vakna tanlouhna a om?
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi a hih chiang in Pathian ma ah bangchi in mihing a dik thei dia? Ahihkeileh amah numei suan bangchi in a siang thei dia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Ngai in, khapi nangawn in vakna a neikei a, a mitmuh in aksite a siangthou kei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihing, tangtel sang a bangzah a neuzaw? Pathian mitmuh ah mihing bangchi phet ahi diam, mihingta, lungnou!”
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Job in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Thilhihtheihna neilou amah bangchi’n na panpih in; hatna neilou ban bangchidan a hondam thei na hia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilna neilou amah bangchi’n na thuhilh a, nakpitak a theihna hoih na phuangkheta a;
  </para>
  <para style="p">
    <verse number="4" style="v" />Kua kiang ah ahia thute na genkhiak? Kua kha ahia nang a kipan hong paikhia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Sisate tuite nuai leh huai a tengte nuai ah a ling uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A ma ah Sheol vuaktang in a om a, Abaddon in kikhuhna a neikei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman mal mun awng ah a phalhkhia a, bangmahlou tung ah lei a khai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A meipi sah in tuite a tun a; a nuai ah meipi a kikek kei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Khapi mai a khuh a, a tung ah a meipi a phalh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tuite tung ah, khovak leh khomial kigitna ah, kawlmong a kaikual hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A salhna ah van khuamte a ling ua, lamdang a sa uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />A thilhihtheihna in tuipi a khawlsak a, huan a theihsiamna in Rahab a sat.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hu in vante bawlhoih in a om a; a khut in gulpi man gang tailai a sun hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ngai in, hiaite a thilhih a mong lel ahi uh. Ngatchik a a huau siausiau lel! A thilhihtheihna Van ging kua ahia theisiam ding?”
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Job in a gentehna thu apan nawn a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Pathian a hing bang in, aman ka dikna a lamang a; Thilbangkim hihthei in, aman ka kha a hihbuai a;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka hinna ka sung a a om laiteng, Pathian hu ka nakvang a a om laiteng?
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka mukte’n thutaklou a gen kei ding, ka lei in leng khemna thu a gen kei ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Siam k’on tangsak kei ding hi: ka sihma ka dikna kei a pan ka koihmang kei ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka diktatna ka len chinten a, ka khah kei ding hi: ka damlai teng ka lungtang in kei honkou kei ding.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Ka melma gilou bang hi henla, kei dou dia thou mi diktatlou bang hi hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Punna muta mahleh, Pathian limsakloumi lametna, Pathian in a kha a lakmang ngal in, bang ahia?
  </para>
  <para style="p">
    <verse number="9" style="v" />A tung a buaina a tun in, a kikou Pathian in a za diam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Thilbangkim hihthei ah nuam a sa in, Chiklaipeuh in Pathian sap nuam a sa diam?
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian khut tungtang ah nang k’on sinsak ding; Thilbangkim hihthei kiang a om ken ka im kei ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai un, noute tengteng in huai na muta ua; A hih ngal leh, bangdia bangmahlou honghi na hi ua?
  </para>
  <para style="p">
    <verse number="13" style="v" />“Hiai Pathian lak a migilou tantuan leh, nuaisiahhat mite goutan, Thilbangkim hihthei apan a muh uh ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A tate a pun uleh, namsau ading ahi; huan a suan tanghou in a tai kei ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A nung a omlaite hi leng in a vui dia, a meithaite un kahna a bawl kei ding uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Dangka leivui bang in vum in, puansilh tungman bang in bawl mahleh;
  </para>
  <para style="p">
    <verse number="17" style="v" />A bawl thei, himahleh midikte’n a silh ding ua, mi hoihte’n dangka pen a hawm ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Inn a lam maimom len bang ahi a, vengmi in a bawl aidakbuk bang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hausa in a lum a, himahleh khop in a omkei ding; a mit a hak a, huan a omkei.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tuite bang in launate’n amah a pha a; zan in huihpi in amah a gu mang hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Suahlam huih in amah a pawmang a, a pai mang hi; huchi in a mun a kipan in amah a mut mang hi
  </para>
  <para style="p">
    <verse number="22" style="v" />Pathian in amah nakpi’n a lawn dia, a dawm kei ding: a khut a pan a taimang ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mite’n amah a khut uh a betkhum ding ua, a mun a kipan in amah a nuihsan khe ding uhi.”
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chihtaktak in dangka ading in khuk a om a, a hihsiang uh dangkaeng ading in mun.
  </para>
  <para style="p">
    <verse number="2" style="v" />Lei a pan in sik a kilakhia a, suang a kipan in dal a ki sungkhia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing in khomial phaktawp a neisak a, khomial sah leh thuk ah phaktawp gamlapen tan in sikbu a zongkhia.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mite om louhna ah kawkhuk lutna hawm a tou vang ua, mite apat gamla ah a kikhai ua, Lehlam lehlam ah a ki vei uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lei ahihleh, huai a kipan in tanghou a hongsuak a: a nuai ah mei a hihbang in a kilumlet hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai suangte sapphir suang mun ahi a dangkaeng nen a nei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Huai lampi sasial ne vasa in a theikei a, mu akla mit in leng a mu ngei sam kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Gamsa kisatheite’n a sikkha ngeikei ua, humpinelkai lunlai leng huai ah a paikha naikei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Meisah suangpi tung ah a khut a koih a; a zung in mualte a lumlet a lumlet hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Suangpite lak ah tuilam a hong a; a mit in thil manpha chiteng a mu hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A takkhiak louhna ding un lui luangte a tuam a; thil kisel khovak ah a hon lakhia hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Himahleh koilai ah a pilna a kimu dia? Theihsiamna koilai a om ahia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing in a lampi a theikei hi; mihing gam ah leng muh in a omkei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thukna in kei ah a omkei a chi a, Tuipi in, ka kiang ah a omkei, a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dangkaeng a muhtheih ahi kei a, huai man ding in dangka buk theih ahi kei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ophir dangkaeng toh a manphatna teh theih ahi kei ding, Onik mantam hiam Sapphir toh hiam.
  </para>
  <para style="p">
    <verse number="17" style="v" />Dangkaeng leh limlang in a kimpih theikei ua: huai khenna din dangkaeng hoih leh suangmantam leng ahi theikei ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Suang dum hiam suang muh paisuak theih a kigen kei ding: Ahi, pilna man rubi suang sang in a sangzaw hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ethiopia topaz suang in a pha kei dia, dangkaeng tak toh leng a manphatna teh ding ahi kei.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Ahihleh pilna koi a kipan a hongpai ahia? Theihsiamna koi a om hia?
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing tengteng mit a kipan a sel ahi chih leh, huihkhua a vasate a kipan sitsa a om ahi chih thei in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Abaddon leh Sihna in, huai a thuthang ka bil un ka za uh, a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Huai a lampi Pathian in a theisiam, huai a mun a thei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lei mong tan in a en ngal a, van nuai thil tengteng a mu hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huih ading a gikna a piaklai in, leh tuite tehna a a teh lai in;
  </para>
  <para style="p">
    <verse number="26" style="v" />Vuah ading a thupiak a bawl a, vanpiging khophia adia lampi a bawl lai in;
  </para>
  <para style="p">
    <verse number="27" style="v" />Huailai in aman a mu a, a phuang a; a hihkip a, ahi, a zongkhia hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihing kiang ah, Ngai in, Toupa kihtak, pilna ahi: hoihlou a kipan paimang theihsiamna ahi, a chi hi.”
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job in a gentehna thu a gen nawn a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Aw nidanglai khate bang a om hileng, Pathian in a honveh lai nite bang in;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka lu tung a a khawnvak a tan a, amah vakna a khomial a ka vak lai;
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hoihlai nite a ka om bang a, ka puanin tung a Pathian thuguk a omlai in;
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka kiang a Thilbangkim hihthei a om a, ka tate ka kim a omlai un;
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka kalsuante bawngnawi a sawp a hih a, suangpin sathau luite a butkhiaklai in:
  </para>
  <para style="p">
    <verse number="7" style="v" />Khopi a kongpi zuan a ka pailai in, kongzing a ka tutna ka bawl lai in,
  </para>
  <para style="p">
    <verse number="8" style="v" />Tangvalte’n a honmu ua, a bu ua: upate a thou ua ading uh:
  </para>
  <para style="p">
    <verse number="9" style="v" />Lalte houlim a kidek ua, a kam uah a khut uh a koih uh:
  </para>
  <para style="p">
    <verse number="10" style="v" />Miliante aw a dai a, a lei uh a kam dangtawng uah a belh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bil in a honzak lai in, hampha a honchi a; mit in a honmuh lai in, pom a honchi a;
  </para>
  <para style="p">
    <verse number="12" style="v" />A kap mi genthei, amah panpih a, Pa neilou, panpih bei ka hutkhiak ziak in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mangthang ding a mansa a kipan vualzawlna ka tung ah a hongtung a: meithai lungtang kipah ziak a lasa ding in ka omsak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Diktatna ka silh a, a hontuam hi: ka dikna puanak thupi leh lukhum bang leh suangmantam bang ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mittaw ading in mitte ka hi a, khebai ading in khete ka hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tasam ading in pa ka hi a: ka theihlouh thubul ka zongkhia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Diktatlou mi haizek ka hihtan a, a ha a kipan a samat ka khahsak.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in ken, ka bu ah ka si ding a, piaunel bang in ka nite ka pungsak ding, ka chi a:
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka zungte tuite pha in a dalh zak a, ka hiang ah zankhua in daitui a kai:
  </para>
  <para style="p">
    <verse number="20" style="v" />Kei ah ka thupina a thak gige a, ka khut ah ka thalpeu a thak gige.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Mite’n a honngai ua, a ngak ua, ka thuhilh ading in a daidide uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka thute zoh in a pau nawn kei uh; ka thugen a tung uah a takkhia.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vuah ngak bang in a hon ngak ua; vuah nanungte ading bang in lianpi in a kam ka uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kimuanna a neih louh chiang un a tung uah ka nuihmai a; huchi in ka mel tang a paikhe kei uh.
  </para>
  <para style="p">
    <verse number="25" style="v" />A lampi ding uh ka telsak a, hausa bang in ka tu a; sepaihpawl lak a kumpipa bang in ka leng a, sunmite lungmuanmi bang in.”
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Huan kei sang a naupang, a pate uh, ka ganching uite toh koih dia ka sitte’n, kei nuihzabawlna in a hon zang uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahi, a khutte uh hat a, kei bang a hon lohtak dia, huai a hatna uh beisate’n?
  </para>
  <para style="p">
    <verse number="3" style="v" />Taksapna leh kialna in a tuikang ua; lei keu leh sia a kheuh uh,
  </para>
  <para style="p">
    <verse number="4" style="v" />Pawn a anteh a lou ua; huan loukha zungte a an uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mite lak a kipan hawlkhiak in a om ua; guta bang in amau nung ah a kikou ua.
  </para>
  <para style="p">
    <verse number="6" style="v" />Guam a hengte ah a teng ding ua, lei leh suangpi hawmte ah.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pawn lak ah a ham ua; lahou nuaite ah a kisekhawm uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihaite tate ahi ua, ahi, mi thulimlou tate; gam a pan in delhkhiak ahi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Huan tuin kei a la uh ka honghi ahi, amau ading in houlimna ka hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A honkih ua, kei a kipan a tuam din uh, ka mai a chil siat a kidek kei uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in ka khau a khah a, a hon hihgim a, huan ka ma ah kamkaihna a khahkhia uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka khut taklam ah tualaite a thou ua; ka khe a nawlkhin ua, siatna lampi ka ma ah a koih uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka lampi hihsia in, ka tuahsiatna a zong ua, kuama’n a kham kei uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Awng zapi a paisuak bang in a hong ua: siatna lak ah ka tung ah a kikhuk uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Launate ka tung ah a hei ua, huih bang in ka minphatna a delhmang uh; meipi bang in ka hauhna a paimang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Huchi in tuin ka sung ah ka kha buakkhiak in a om; gimthuakna nite’n kei a honman uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zan in ka guhte a sawi a, kei honsun natnate’n khawl chih a neikei uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka natna hi hat mahmahna ziak in ka puansilh a nin a: ka puanak ngawng bang in kei a hon gak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Buannawi ah a honpai lut a, leivui leh meivu bang ka hi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Na kiang ah ka kikou a, n’on dawng kei hi: Ka ding a, kei n’on en maimah a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tung a gilou ding in na kilumlet a, na ban hatna in kei n’on sawi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huih ah n’on domkang tou a, huai tung ah n’on tuangsak; huchi in huih ah n’on lumlet let hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sihna na hontun ding chih ka thei hi, mihing tengteng adia sehsa inn ah.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Himahleh siatna a pukgawp mi’n a banzak lou ding hia? A tuahsiatna ah panpihna ngen in kikou lou ding hia?
  </para>
  <para style="p">
    <verse number="25" style="v" />Buaina a din ka kap kei diam? tasam a ding in ka kha a dah kei ding a hiam?
  </para>
  <para style="p">
    <verse number="26" style="v" />Hoih ka ngak chiang in, hoihlou a hongpai a; khovak ka ngak chiang in, khomial a hongpai.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka lungtang a buai, khawl a mu ngeikei; gimthuakna nite ka tung ah a hongtung.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hihvom a om in ka vialvak, himahleh ni hihvom hilou in; khawmpi ah ka ding a panpih deih in ka kikou hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Sehalte unaupa ka hi a, vakengsangte lawm ka hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka vun a vom a, kei a kipan a pilh uh, kholum in ka guhte a kang hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in ka kaihging sunna a suak a, ka mutging mikapte aw.”
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Ka mit toh thukhun ka na bawlkhinta; Bangchi’n nungak ka en theita dia?
  </para>
  <para style="p">
    <verse number="2" style="v" />Ahihleh tunglam Pathian a kipan in ka tantuan bang ahia, tungsang a Thilbangkim hihthei a kipan in ka goutan?
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi dikloute tung ah siatna, gitlouh nasemte tung ah gawtna a tung kei maw?
  </para>
  <para style="p">
    <verse number="4" style="v" />Aman ka lampite a mu kei ahia? ka kalsuante a sim vek kei ahia?
  </para>
  <para style="p">
    <verse number="5" style="v" />“Thuzuau toh na om a, huai a ka khe khem ding a kinoh ahihleh;
  </para>
  <para style="p">
    <verse number="6" style="v" />Bukna diktak ah honbuk dih ua, Pathian in ka thutakna thei hen!
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka kalsuan lampi a kipan a na pial hiam, ka lungtang in ka mitte na zui hiam, ka khutte ah nin himhim na belh hiam:
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi ka hihleh, chi tuh ning, midang in ne hen; ahi, ka lou a piang bulkalh khiak hi hen.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka lungtang numei lam a khem a om a, ka inveng kongkhak ka na ngaktak leh:
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi a hihtak leh ka zi in midang ading in an su henla, midangte amah tung ah kun uhen.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchibang gitlouhna hoih hetlou ahi; ahi, vaihawmmite gawt ding khelhna ngei,
  </para>
  <para style="p">
    <verse number="12" style="v" />Siatna ding a Abaddon tan a kangbei leh, ka punna tengteng zungkalh ding mei hi ding lah ahi ngal a.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Ka tung a phunna a neihlai ua, ka sikhapa hiam ka sikhanu hiam makhua na musit a, na khualsak lou ka hihleh;
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian a thohkhiak chiang in bang ka hihta dia? Thu a kan hun chiang in bang in ka dawngta dia?
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei sul a hon bawlpan amah a bawl kei maw? Khat in a hon bawltuak ahi kei maw?
  </para>
  <para style="p">
    <verse number="16" style="v" />“Migentheite a lunggulh uh ka piak louh a, ahihkeileh a vuaksuak ding a meithai mitte ka na omsak leh;
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahihkeileh kei kia in ka an ka nek a, huai a pabei in an a nek kei leh;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ii, ka tuailai a kipan in pa bang ka hi, ka kiang ah a na khanglianta; ka nu sul a kipan amah pipa ka hita hi:
  </para>
  <para style="p">
    <verse number="19" style="v" />Kuapeuh taksap ziak a mangthang hiam, ahihkeileh tasam khuhna neilou hiam ka na muh leh;
  </para>
  <para style="p">
    <verse number="20" style="v" />A kongte’n kei hon vualzawl lou a, ka belam mul a lumsak a a na omkei leh;
  </para>
  <para style="p">
    <verse number="21" style="v" />Kongpi a panpihna ka muh ziak a pabeite siatna ding a ka khut ka nalik leh;
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi ka hihleh, ka liang ka liangzang a kipan kia henla, a guh a kipan ka ban kitan hen.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian a kipan tuahsia kei a ding in launa ahi ngal a, A thupina ka tuak ngam kei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Dangkaeng lametpen a ka na bawl a, dangkaeng hoih kiang ah, ka muanna na hi, ka na chihtak a;
  </para>
  <para style="p">
    <verse number="25" style="v" />Ka hauhna thupi ziak a hiam, ka khut in tam a lam ziak a ka kipah a;
  </para>
  <para style="p">
    <verse number="26" style="v" />A vak lai a ni ka na et a, kha thupitak paikhia ka na et a,
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka lungtang guk a khem a a om a, ka kam in ka khut a na tawptak leh:
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai leng thulimlouhna vaihawmmite gawt ding ahi: tung a Pathian kiang a na zuauta hi ding ka hih ziak in.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Kei hon mudah siatna a ka na kipah a, ahihkeileh hoihlou a tung a a tun chiang a ka na kipah luat leh;
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka melma hamsiat ding leh a henna thum ding in ka kam ka na khialsak kei;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ka puanin a te a, A an a kihihvah lou kua a om a, hon na chih kei ua leh;
  </para>
  <para style="p">
    <verse number="32" style="v" />Kongzing ah mikhual a giak ngeikei a; khualzin adin ka kongte ka na hongta
  </para>
  <para style="p">
    <verse number="33" style="v" />Adam bang a ka angsung a thulimlouhna na sel a, ka tatlekna na khuh ka hih a,
  </para>
  <para style="p">
    <verse number="34" style="v" />A ziak, mi tampi launa thupitak ka neih ziak a hih a, sungte honmuh daina launa ziak a huchi a daidide a, popawt lou ka hihleh,
  </para>
  <para style="p">
    <verse number="35" style="v" />Aw, kei honza mi nei leng maw: Ngai in, hiai ah ka min gelh a om hi. Thilbangkim hihthei in hon dawng hen; ka gal in a gelhkhiak matna nei leng maw:
  </para>
  <para style="p">
    <verse number="36" style="v" />Chihtaktak in ka liangzang ah ka paw dia; lallukhu bang in kei ah ka kan den ding hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A kiang ah ka kal suan zah ka phuang ding a; lal bang in ka kiang nai ah ka hoh ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />“Ka gam kei dem a a kikou a, lei lehsate a kah khawm uleh;
  </para>
  <para style="p">
    <verse number="39" style="v" />Sum lou a huai gahte ka na nektak a, ahihkeileh huai a a neite a hinna uh ka na tansak leh:
  </para>
  <para style="p">
    <verse number="40" style="v" />Buh hilou in loulingneite, barli buh hilou in loubualte pou zaw hen.” Job thute a beita hi.
  </para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchibang in hiai mi thumte Job dawn a tawpta ua, amah mit a diktat a hih ziak in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huailai in Buz mi Barakel tapa Elihu hehna a kuangkhia a, Ram inkuan a mi: Job tung ah a hehna a kuangkhia a, Pathian hizaw lou a amah siam a kitansak ziak in.
  </para>
  <para style="p">
    <verse number="3" style="v" />A lawm thumte tung ah leng a hehna a kuangkhia a, dawnna ding neilou a, hinapia lah Job a mawhpaih ziak un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah sang a a upat zawk ziak uh, Job kiang a thugen ding in Elihu in a ngak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiai mi thumte kam a dawnna a omkei chih a theih in, a hehna a kuangkhia hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Huchi in Buz mi Barakel tapa Ka naupang a, nou na upa mahmah uh; huaiziak in ka dai a, ka lungsim k’on ensak ngam kei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in ka chi, Nite’n thu a gen ding uh, kum tampi in pilna a sinsak ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh mihing lungsim a om a, Thilbangkimthei in theihsiamna a pia hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A pilte mi thupite ahi kei ua, vaihawmna theisiamte upate ahi sam kei uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huaiziak in, hong ngaikhia un; ken leng ka lungsim ka ensak ding, ka chi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ngai un, na thute uh ka ngak a, gen ding na zonkhiak lai un, na thusutte uh ka ngaikhia.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahi, k’on limsak a, ngai un, kuamah Job thuzoh zou na omkei uh, ahihkeileh na lak uah, a thute dawng.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilna i muta, chilou din pilvang un; mihing hilou in Pathian in amah a zou thei hi:
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman kei siatna ding in a thute ahihkei a; ken leng nou thugente in amah ka dawng sam kei ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Lamdangsa in, a dawng nawn kei ua, gen ding thu khat leng a neikei uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thu ging neih louh ziak in ading kinken ua, a dawn nawnlouh ziak un ken ka ngak diam?
  </para>
  <para style="p">
    <verse number="17" style="v" />Ken leng ka dawnna ding ka nei hi, ka lungsim ka ensak sam ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thu in ka dim a; ka sung a ka kha in honsawl teitei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai un, ka gilpi pawtkhiakna neilou uain bang ahi; khuainulhaite bang in puakzak ding in mansa in a om hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka halh theihna ding in, ka pau ding; ka mukte ka hong dia, ka dawng ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing mihinna zahtaksak kei un, k’on ngen hi; kuamah kiang ah leng maitang phatna min ka pe kei ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Maitang phatna minte piak ding ka thei ngal kei a; huchilou in zaw kei hon bawlpan a hon lazok ding hi.”
  </para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Akoi abang hileh, Job, k’on ngen hi, thugen za inla ka thugen tengteng ngaikhia in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai in, tuni, ka kam ka ka a, ka kam in ka pau hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka thute’n ka lungtang dikna a genkhe ding uh; Ka mukte’n a theih ngei uh chihtaktak in a gen ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pathian Kha in a honbawl a, Thilbangkim hihthei hu in hinna honpia hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na theih leh, hon dawng in; ka ma ah na thute a kizom in koih inla na panna ah ding in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngai in, nang bang in Pathian lam ah ka om hi: keileng tungman a bawl ka hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai in, ka lauhuaina in nang a hon lausak kei ding, ka hahkatna leng na tung ah a gik kei ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Chihtaktak in ka zak in na pauta a, huchi in na thute ging ka zata hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka siang hi, tatlekna bei; ka hoih a, kei ah thulimlouhna leng a omkei, chi in:
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai in, kei demna ding ziak a mu a melma in a hon simta hi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka khete kol a bunsak a, ka lampite tengteng a chiamteh hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Ngai in, k’on dawng ding, hiai na diklouhna ah; mihing sang in Pathian a lianzaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Bangdia amah dou na hia, Ka thute a bangmah mah lah a dawng kei ding, chi in?
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian in lah khatvei a gen a, ahi, nihvei, mihing in limsak kei mahleh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zan a mang ah, mengmuhna ah, mite tung a ihmut kip a kiak lai in, lupna tung a ihmut laite in;
  </para>
  <para style="p">
    <verse number="16" style="v" />Huailai in mite bilte a hong a, vaunate in amau a hihlau a,
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi a a thiltup a kipan a mihing a lakkik a, mihing a kipan a kisaktheihna a satkhiak theihna ding in;
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman kawkhuk a kipan a kha a kep kik sak a, namsau a kipan a hinna.
  </para>
  <para style="p">
    <verse number="19" style="v" />A lupna tung ah natna a sawi in leng a om, a guhte a kinakna om gige toh in:
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in a hinna in tanghou, a kha in an lim a kih hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Asa a tum mang a, huchi in muhtheih in a omkei; A kimulou a guhte hong dawkkhia uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahi, a kha han kiang ah a hongnai a, a hinna hihsemite kiang ah.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kiang a angel, kamlet, sang khat lak a khat, mihing kiang a amah adia dik bang ahia chih etsakding a om leh;
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi a amah ading a chingthei, Kawkhuk a paisukna a kipan amah suaktasak un, tatna ka muta,
  </para>
  <para style="p">
    <verse number="25" style="v" />A sa naupang a sang in nou zaw hen; a tuailai nite lam ah kik nawnta hen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pathian kiang ah a thum a, amah ding in deihsak theih in a om hi; huchi in nuamna toh a mai a mu a: a diktatna a kiang ah a pe nawn hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mite ma ah la asa a, Ka khialta a, a dik ka na hekkawi a, thuk in ka omkei!
  </para>
  <para style="p">
    <verse number="28" style="v" />Kawkhuk sung a paisukna a kipan a kha a tanta hi, a hinna in vakna a muta ding hi, a chi a.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ngai in, hiai thilte tengteng Pathian in, mihing lak ah hih a, nihvei, ahi thumvei.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kawkhuk a kipan a kha pikik ding in, huchi a mihing vakna ahihvak a a om theihna ding in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Chiamteh in, Aw Job, ngaikhia in: dai inla, thu ka gen ding.
  </para>
  <para style="p">
    <verse number="32" style="v" />Gen ding na neih leh, hon dawng in: Pau in, siam hon tansak ka ut ngal a.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na neih kei leh, kei hon ngaikhia in: dai inla pilna k’on sinsak ding hi.”
  </para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailou in Elihu in a dawng a, hichi in a chi a:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Ka thute za un, nou mipilte; nou theihna neite, bil hondoh un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Dangtawng in an a chiam bang in, bil in thute a enchian hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A dik ei ading in i tel ding uh; i lak ua hoih bang ahia i thei ding uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Job in, Ka dik a, Pathian in ka dikna a lamang, a chi ngal a:
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka dikna huchi hitamahleh zuauthei a sim ka hi a; tatlekna bei himah leng, ka liamna hihdam theihlouh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Muhsitna tui bang a dawn bei, Job bang mihing kua ahia?
  </para>
  <para style="p">
    <verse number="8" style="v" />Thulimlou nasemmite toh a hon a pai, migiloute toh omkhawm mi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Aman lah, Pathian lak a ka kipahna ding bangmah ka lohtak kei, a chi ngal a.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Huaiziak in, nou theisiammite, hon ngaikhia un: Pathian in, gilou bangchi in a hih ngei dia; Thilbangkim hihthei in thulimlou bangchi in a hih mahmah dia.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman lah mihing thilhih amah kiang a pekik ding a, mi chiteng a lampite kiang a pekik ding ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahi, mawh khuksakna thu ah, Pathian in gilou tak in a hih kei dia, Thilbangkim hihthei in leng vaihawmna a hihse sam kei ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuan ahia amah leitung a heutu hihna pia? Ahihkeileh khovel pumpi kuan ahia a thu a koih?
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing tung a a lungtang nga a, amah lam a a kha leh a hu lakhawm;
  </para>
  <para style="p">
    <verse number="15" style="v" />Sa tengteng a mangthang vek ding ua, mihing leivui a suak nawn ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Theihsiamna na neih leh, hiai za in: ka thu aw ngaikhia in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi thudik hua in vai a hawm ding hia? Dik leh hat amah na mawhpaih ding hia?
  </para>
  <para style="p">
    <verse number="18" style="v" />Kumpipa kiang a, ‘Na hoih kei’ chih a kilawm hia? Ahihkeileh miliante kiang a, Na gilou uh? chih.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mi lalte mi hinna zahtak lou a, Genthei sang a mi hausate limsak zawte kiang a chih kilawm semlou ding hia? Amaute lah a khut nasep ahi ngal ua.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mitphiat kallou in a si ua zankim lai mahmah in; mite a ling ua a pai mang ua, mihing khut hilou in mihatte lakmang in a om uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A mitte mihing lampite tung ah a om a, a painate a mu hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thulimlou nasemmite bukna ding khomial hiam limliap hiam a omkei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Vaihawmna a Pathian ma a pai ding in, mihing a ngaihtuah lailai a kiphamoh kei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Lamte theihphak vuallouh in aman mi hatte a hihzan vek a, a mun uah midang a tungkhia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huaiziak in a nasepte uh a thei hi; zan in amau a lumlet a, hihsiat in a om uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Midang mitmuh mahmah in migiloute bang in amau a gawt hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah zuihna a kipan a pialkhiak ua, a lampite a koimah a limsaklouh ziak un:
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in genthei kahna a kiang tung ding in a bawl ua, gimthuak kahna a za hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amah na pau kei leh, kuan siamlouh a tangsak dia? Aman a mai a sel leh, Amah kuan a mu thei dia? Namte kiang a hih hiam, ahihkeileh mihing kiang a hih hiam a kibang hi:
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi a Pathian theilou min vai a hawm louh a, a mite thang a awksak ding a omlouhna ding in.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Kuapeuh in Pathian kiang ah, Gawtna ka thuakta, ka gilou nawn kei ding,
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka muhlouh nang hon sinsak in, gilou ka hihleh ka hih nawn kei ding, a chi uhia?
  </para>
  <para style="p">
    <verse number="33" style="v" />A thukna huchi a na nial na deih bang in a om diam? Kei hilou in, nang na tel ngeingei ding ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Theisiammite’n ka kiang ah, Ahi, a chi ding uh, a za mipilteng in.
  </para>
  <para style="p">
    <verse number="35" style="v" />Job in theihna bei in thu a gen a, a thute pilna bei ahi uh.
  </para>
  <para style="p">
    <verse number="36" style="v" />Mihaite bang a a dawnna ah, a tawp chiang in Job tungtang ngaihtuah le uh.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman a khelhna ah helna a behlap a, i lak uah a khut a beng a, Pathian kalh in a thu a pungsakta hi.”
  </para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />Elihu in a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hiai na dikna hi in na ngaihtuah hia, ahihkeileh, kei a mawng ahi, Pathian mai ah, na chi hia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Kei a ding in bang phattuamna a om dia? Khial lou a ka om in bang phattuamna ka nei a? na chih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang leh na kiang a na lawmte k’on dawng ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vante lam en inla, mu in; vante, nang sang a sangzaw, en in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Na hihkhelh leh, amah dem a bang hih na hia? Na tatleknate punsak hileh, amah tung a bang hih na hia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Diktat hile chin, amah bang na pia a? Ahihkeileh na khut a kipan bang a mu a?
  </para>
  <para style="p">
    <verse number="8" style="v" />Na gitlouhna in nang bang in mi a hihna thei a; na diktatna in mihing tapa a hih hampha thei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nuaisiahna tam mahmah ziak in a kikou khia ua; mi hat ban ziak in panpih deih in a kikou uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kuamah in, Zan chia late honpia, Pathian kei hon Bawlpa koi a om ahia;
  </para>
  <para style="p">
    <verse number="11" style="v" />Lei a gamsate sang a hon sinsak tamzaw leh, van a vasate sang a hon pilsakzaw? a chi kei uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai ah a kikou ua, himahleh, migilou kisaktheihna ziak in, kuamah in dawnna a pe kei uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Chihtaktak in Pathian in bangmahlou a za kei dia, Thilbangkim hihthei in leng a limsak sak kei ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nang ngial houh: Amah ka mu kei, a thu ma ah a om, Amah ka ngak hi, na chih vial.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh tuin, heh a a veh louh a, kiotsakna leng a limsaklouh ziak in;
  </para>
  <para style="p">
    <verse number="16" style="v" />Huaiziak in Job in bangmahlou in a kam a ka ahi; theihna bei in thu a tamsak ahi.”
  </para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />Elihu mah in a gen zel a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hon na thuakzou zek inla, huan k’on ensak ding; Pathian sik in lah banghiam khat gen ding ka nei ngal a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gamla a kipan ka theihna k’on la ding a, kei hon Bawlpa tung ah diktatna ka nga ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Diktakin ka thute zuau ahi kei a: hoihkim khat ka kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Ngai in, Pathian in thil a hihthei a, kuamah a musit kei: theihsiamna hatna ah thil a hihthei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Gilou hinna a hawi kei a: himahleh gimthuakte kiang ah a dikna uh a pia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi diktat a kipan a mit a la kik kei a: himahleh mangtutphah tung a kumpipa toh amau tangtawn in a koih a, huchi in hihlet in a om uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan sikkhaute a gak a a om ua, gimthuakna guite a lak a a om uleh;
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in a thilhih uh amau a ensak a, a tatlekna uh, huchi a kisatheitak a a na omna uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thuhilhna lam ah a bil uh a honsaka, thulimlouhna a kipan kik din thu a pia hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah thu a ngaihkhiak ua, a na a sep uh leh, a nite uh hauhsakna in a hihbei ding ua, a kumte uh kipahna in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh a ngaihkhiak kei ua leh, namsau in a mangthang ding ua, huchi in theihna bei in a si ding uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Himahleh amau lungtang a Pathian limsaklouhnate’n hehna a khol khawm hi: amau a henlai in panpih deih in a kikou kei uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Tuailai in a si ua, siangloute lak ah a hinna uh a mangthang hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A gimthuakna in gimthuakte a suaktasak a, nuaisiah na ah a bil uh a honsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahi, gakchihna omlouhna, mun lian lam ah dahna a kipan nang a hon pimang ding a; na dohkan tung a kilui thauna in a dimta ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Himahleh giloute vaihawmna in na dim a: vaihawmna leh diktatna in nang honlen hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thangpaihna a om ziak in, pilvang in huchilou in zaw na hauhna in nang a hon pimang kha ding hi; golhgukna tampi in leng nang hon pialsak kei hen.
  </para>
  <para style="p">
    <verse number="19" style="v" />Dahna a na om louhna ding in, na hauhsaknate a hun diam, ahihkeileh na hatna thilhihtheihna tengteng?
  </para>
  <para style="p">
    <verse number="20" style="v" />Mite tengteng a mun ua satkhiak a a om zan uah lunggulh ken.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pilvang in, gilou limsak ken: gimthuakna sang in hiai lah na telta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai in, Pathian in a thilhihtheihna in sangtak in a hih: amah bang sinsakmi kua ahia?
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuan amah a lampi thu a pia a? Ahihkeileh, Diklouhna na bawlta, kua’n a chi thei dia?
  </para>
  <para style="p">
    <verse number="24" style="v" />“Mite’n la a sak uh, a thilhih hihlian ding in theigige in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huai ah mite tengteng a en ua; huai mihing in gamlapi ah a mu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ngai in, Pathian a lian a, amah i theikei: a kumte zah zontheih ahi kei.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tui takte aman a tawikhin a, huai a tuihu a kipan vuah a zu:
  </para>
  <para style="p">
    <verse number="28" style="v" />Huai vante’n a sungkhia ua, mihing tung ah tampi in a tak.
  </para>
  <para style="p">
    <verse number="29" style="v" />Meipi kiphahte leh a inn vanpi gingte kua’n a theisiam dia?
  </para>
  <para style="p">
    <verse number="30" style="v" />Ngai in, a kim ah a khovak a zak a: tuipi nuai a tuam hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiaite in mite a vaihawmsak a; an tampi a pia hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A khutte in khophia a tawi a; chiamtehna khoh din thu a pia hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai husa in a tungtang thu a gen a, ganhonte’n leng hong kuantou huihpi tungtang thu a thei uh.”
  </para>
  <chapter number="37" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Hiai ah leng ka lungtang a ling a, a mun a kipan suan in a om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A aw ging leh a kam a kipan a vanging paikhia noute’n ngaikhia un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Van pumpi nuai ah a sawlkhia a, a khophia lei tawpnate tan in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huaizoh in aw a kikou a; a lalna aw in vanpi a gingsak a: a aw zak a a om chiang in amau a len kei hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian in a aw in lamdangtak in vanpi a gingsak a; i theihtheih louh, thil thupite a hih zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman lah vuk kiang ah, Lei ah kia in, a chi ngal a; huchi mah bang in vuahmal phin kiang ah leng.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi chiteng khut a tuambit a; a bawlsa mite tengteng in huai a theihtheihna ding un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huailai in gamsate a mun uah a lut ua, a kuate uah a om uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Simlam dantan a kipan huihpi a hong a: mallam a kipan khovot.
  </para>
  <para style="p">
    <verse number="10" style="v" />Pathian hu in tuikhal piak ahi: tuite nakna hihhaksat in a om.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ahi, meipi nawnna a pawsak a; a khophia meipi a phalhsak hi:
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah pi in a kivial heihei ua, ten theihna khovel maikaih a amaute thu a piak peuhmah a hihna ding un:
  </para>
  <para style="p">
    <verse number="13" style="v" />Bawlhoihna ding hiam, a gam ading hiam, ahihkeileh chitna ding hiam a, a hon paisakna ah.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Hiai ngaikhia in, Aw Job: Ding kinken inla, Pathian thilhih lamdangte ngaihtuah in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amaute tung a Pathian thupiak a koih a, a meipi khophia a tansak dan na thei hia?
  </para>
  <para style="p">
    <verse number="16" style="v" />Meipite kibuk diknate, amah theihna hoihkim thilhih lamdangte na thei hia?
  </para>
  <para style="p">
    <verse number="17" style="v" />Sim huih ziak a lei a daih sipsip lai a, na puansilhte a lum dan?
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah toh van, suntawm limlang bang a khauh na phalh thei hia?
  </para>
  <para style="p">
    <verse number="19" style="v" />A kiang a ka gen ding uh hon sinsak in; mialna ziak in ka thugen ding uh ka gelkhol theikei ua.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thu ka gen ding chih amah hilh ding a diam? Ahihkeileh mihing in valh khit a om ut ding a diam?
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in mite’n meipi a om khovak a mu kei ua: himahleh huih a nung a, amaute a hihsiang hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mal a kipan in dangkaeng bang a thupi a hongpai a: Pathian a lalna ah a thupi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thilbangkim hihthei thu ahihleh, mu theikei hang: thilhihtheihna ah a thupi pet mah hi: Huan vaihawmna leh dikna hauhna ah gim a thuaksak kei ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaiziak in mite’n amah a lau ua: lungtang a pil kuamah a limsak kei hi.”
  </para>
  <chapter number="38" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in pingpei a kipan in “ Job a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Theihna bei thute a thuhilh hihmial hiai kua ahia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Kipasal sak in tuin na kawng gak in; hon dong ding ka hi, ka kiang a na gen ding ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Lei kingaknate ka koih lai in nang koi ah na om a? Phuang in, theihsiamna nei na hihleh.
  </para>
  <para style="p">
    <verse number="5" style="v" />A tehnate kua bawl ahia? Thei na hihleh! A tung a tehna khau kua zan ahia?
  </para>
  <para style="p">
    <verse number="6" style="v" />A nuai suangphumte kua phum ahia? Huai a ning a suang kua koih ahia?
  </para>
  <para style="p">
    <verse number="7" style="v" />Zingsang aksite’n la a sak khawm ua, Pathian tapate tengteng kipak a a kikou lai un?
  </para>
  <para style="p">
    <verse number="8" style="v" />“Ahihkeileh kuan kongkhakte in tuipite a khak bing a? Gil a kipan hong pawtkhia bang a, a hong puahkhiak lai in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai a puansilh meipi leh, khomial bikbek, huai ading a tuamna puan ka bawl a,
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai ading a ka thupiak bawl a, kalhnate leh kongkhakte koih a,
  </para>
  <para style="p">
    <verse number="11" style="v" />Hiai tan na hongpai ding, himahleh a ban hilou in, ka chih a; hiai lai ah a kiuangsak na tuikihotte kholsak in a om ding uh, ka chih lai in?
  </para>
  <para style="p">
    <verse number="12" style="v" />“Na nite a kipat nungsiah zingsang thu na pia in, phalvak a mun thei din na bawlta hia;
  </para>
  <para style="p">
    <verse number="13" style="v" />Lei tawpnate a mat theih a, huai a kipan a gilou sinkhiak a hihtheihna ding in?
  </para>
  <para style="p">
    <verse number="14" style="v" />Chiamtehna nuai a tungman leibang in mel a kikheng a; puansilh bang in thil tengteng zenei in ading khia hi:
  </para>
  <para style="p">
    <verse number="15" style="v" />Gilou a kipan a a khovak uh lettang sak ahi a, a ban liksang uh a kitan hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Tuipi nak sung ah na lutta hia? Ahihkeileh tuithuk tawp ah na paita hia?
  </para>
  <para style="p">
    <verse number="17" style="v" />Sihna kongpite na kiang ah taklat in a omta hia? Ahihkeileh sihna limliap kongpite na muta hia?
  </para>
  <para style="p">
    <verse number="18" style="v" />Lei zatdan na thei siamta hia? Phuang in, huai na theih leh.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Khovak tenna zotna lampi koi ah a om a, huan khomial omna mun koisan ahia?
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi a gamgi tan a na tonpih theih a, huai a inn tan a lampite na theihna ding in?
  </para>
  <para style="p">
    <verse number="21" style="v" />Thei mah niteh maw, huailai a piangta hi ding chin a? Na nite tamdan a thupi mahmah hi!
  </para>
  <para style="p">
    <verse number="22" style="v" />“Vuk koihkhawmna ah na lut ngei hiam, ahihkeileh gial koihkawm na muta hia?
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai buaina hun a ding leh kidou leh kisat ni adia ka koihkholhte?
  </para>
  <para style="p">
    <verse number="24" style="v" />Bang lampi ah ahia khovak a kikhen hiam leitung a suahlam huih a dalhzak?
  </para>
  <para style="p">
    <verse number="25" style="v" />“Kuan ahia tui tampi luanna ding a tuilam khuak a, kekkia adia lampi sial?
  </para>
  <para style="p">
    <verse number="26" style="v" />Mihing om louhna mun gam tung a vuah zusak ding in; mihing om louhna, gamdai tung ah;
  </para>
  <para style="p">
    <verse number="27" style="v" />Lei kisia leh segawpsa lungkimsak ding; loupa hing nou khang khesak ding?
  </para>
  <para style="p">
    <verse number="28" style="v" />“Vuah in pa a nei hia? Ahihkeileh daitui takte kua suan ahia?
  </para>
  <para style="p">
    <verse number="29" style="v" />Kua gil a kipan a tuikhal hongpai ahia? Van daituikhal ngou, kua suahsak ahia?
  </para>
  <para style="p">
    <verse number="30" style="v" />Suang bang in tuite a tak a, tuithuk maite a khal hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Siguk khaute na khihkhawm thei hia? zuheisuktun khaute na phel thei hia?
  </para>
  <para style="p">
    <verse number="32" style="v" />Amah hunbi ah Aksi lamvak a chiamtehnate na pikhe thei hia? Ahihleh Jangkhua leh tate na pi thei hia?
  </para>
  <para style="p">
    <verse number="33" style="v" />Van thusehte na thei hia? Huai lalna lei ah na ding khesak thei diam?
  </para>
  <para style="p">
    <verse number="34" style="v" />“Nang tui tampi in a khuh theihna ding in meipi kiang ah aw na suah thei diam?
  </para>
  <para style="p">
    <verse number="35" style="v" />A pai theihna ding un khophiate na sawl khe thei hia?
  </para>
  <para style="p">
    <verse number="36" style="v" />Sunggil lam ah pilna kuan a koih a? Ahihkeileh lungsim kiang ah kuan theihsiamna a pia a?
  </para>
  <para style="p">
    <verse number="37" style="v" />Pilna in kua’n meipite a sim thei dia? Van tuithawlte kuan a bawkhe thei dia?
  </para>
  <para style="p">
    <verse number="38" style="v" />A lompi a leivui a luan a, a sakte a kimat khawm ngiungeu lai un?
  </para>
  <para style="p">
    <verse number="39" style="v" />“Humpinelkai ading in samat na betsak ding hia? Ahihkeileh humpinelkai noute gilkial na hihdam ding hia?
  </para>
  <para style="p">
    <verse number="40" style="v" />A kua ua a boh ua, buk ding a a bukna mun ua a om nilouh lai un?
  </para>
  <para style="p">
    <verse number="41" style="v" />Va-ak ading a an kuan a pia a? A noute Pathian kiang a kikou a An duh man a a vakvak lai un?”
  </para>
  <chapter number="39" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Suangpi a gam sathakte’n nou a suahsak hun uh na thei hia? Ahihkeileh nou a neih lai uh na chiamteh thei hia?
  </para>
  <para style="p">
    <verse number="2" style="v" />A kha chinsak zah uh na thei hia? Ahihkeileh a pian hun na thei hia?
  </para>
  <para style="p">
    <verse number="3" style="v" />A kun ua, a tate uh a suang uh, a lungkhamnate uh a paikhia uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tate uh deihhuai tak in a om ua, gamlak ah a khang lian ua; a kuan khia ua, a hong kiknawn kei uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Kua’n gam sabiltung a khah khia a? Ahihkeileh kuan gam sabiltunghonte a phel a?
  </para>
  <para style="p">
    <verse number="6" style="v" />Loupa gam a inn ka bawl a, huan chi gam a tenna mun in;
  </para>
  <para style="p">
    <verse number="7" style="v" />Khopi buai nuanua a musit a, Hawltute kikounate a za kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mual dungte a gantatna mun ahi a, huan thilhing chiteng a zong hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Na nna sem ding in gam bawngtal a lungkim diam? Ahihkeileh na anpiakna kiang ah a om gige diam?
  </para>
  <para style="p">
    <verse number="10" style="v" />Leilehna ah khau in gam bawngtal na khih thei diam? Ahihkeileh nanung ah guamte a toktam diam?
  </para>
  <para style="p">
    <verse number="11" style="v" />A hatna a thupi ziak in, amah na muang diam? Ahihkeileh a kiang ah na sepgimna na khiak diam?
  </para>
  <para style="p">
    <verse number="12" style="v" />Na buhchi inn a hontut a, na buhphual a buh a kaihkhawm theihna ding in amah na muang diam?
  </para>
  <para style="p">
    <verse number="13" style="v" />“Ostrik kha kisathei tak in a kizap a; a khavengte leh a multe a migi hia?
  </para>
  <para style="p">
    <verse number="14" style="v" />A tuite lah leitung ah a nusia a, leivui ah a lumsak a,
  </para>
  <para style="p">
    <verse number="15" style="v" />Khe in a sikkham thei chih a mangngilh a, ahihkeileh gamsa in a sikgawp thei chih.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah a hilou bang in, a noute siatna ding in a khauh a: a sep gimna bangmahlou himahleh, a lau kei hi:
  </para>
  <para style="p">
    <verse number="17" style="v" />Pathian in pilna a ngawlhsak ziak in, theihsiamna leng a pe sam kei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Tungsang lam a a ki tawisang chiang in, sakol leh a tungtuangmi a nuihsan.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Sakol a hatna na piak hia? Mul nem in a ngawng na tuam hia?
  </para>
  <para style="p">
    <verse number="20" style="v" />Khaukhup bang in na tawmsak hia? A hamna thupi a lauhuai ve.
  </para>
  <para style="p">
    <verse number="21" style="v" />Guam ah lei a tuan a, a hatna ah a kipak a, mi kigalvante tuak ding in a paikhia.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lauhuai a nuihsana, a lungdong kei a, namsau leng a nungngat sam kei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amah ah thalbawm a ging lengleng a, teipi te zelzel leh chiangzum.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kihtakhuaina leh hehna in lei a nawmvalh a; Pengkul aw ahi chih leng a um sam kei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pengkul a gin teng in, Hah; a chi a, kidouna, heutute vanpiging leh kikou, gamlapi apan a thei.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Na pilna in mu sangpi a lengsak in, a khate simlam ah a phalh hia?
  </para>
  <para style="p">
    <verse number="27" style="v" />Nang thupiak in muvanlai a tunglen in tungsang ah a bu a sep hia?
  </para>
  <para style="p">
    <verse number="28" style="v" />Suangpi tung ah a teng a, huai ah giahna a nei a, suanghengte leh kulh muanhuaite ah.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huai a kipan in matding a mu a; a mitte’n gamla a mu hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A noute’n leng sisan a tawpbei ua: thah a omna mun, huai ah a om hi.”
  </para>
  <chapter number="40" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailou in Toupa’n Job a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Kuapeuh awlmoh neilou in thil bangkim hihthei a kiselpih diam? Kuapeuh Pathian kiselpih, huai tuh amah dawngsak un.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Job in Toupa a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ngai in, Bangmah ka hi kei a; bangchi’n k’on dawng dia? Ka kam ah ka khut ka koih.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khatvei ka pauta a, ka dawng kei ding; ahi, nihvei himahleh ka pau nawn kei ding.”
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n pingpei a kipan in Job a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="7" style="v" />“Kipasal sak in tuin na kawng gak in: nang a kipan ka honphut dia, kei kiang ah na honphuang ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka vaihawmna bangmahlou a koih ding na hiam? Siam na tan theihna dia, kei hon mawhpaih ding na hi hia?
  </para>
  <para style="p">
    <verse number="9" style="v" />Ahihkeileh Pathian bang in ban na nei hia? Amah bang in aw in vanpi na gingsak thei hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />“Tuin nang hoihkim leh zahna in kizem in; zahna leh lalna in kivan in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Na hehna dimlette sungkhia in; michih kisatheite en inla, hihniam in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Michih kisathei en inla, kainiam in; a dinna uah migiloute tuanchil in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Leivui ah amaute selkhawm in; mun dai ah a mai uh kan in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in na khut taklam in nang a hondam thei chih ka honthei ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Nang k’on siam bang a ka siam, tuin en in chingpi; bawngtal bang in loupa a ne.
  </para>
  <para style="p">
    <verse number="16" style="v" />En in tuin, a hatna a kawng ah a om a, a gilpi thate ah a hatna a om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sidar sing bang in a mei a tangsak a: a pheite thaguite phankhawm in a om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A guhte dal lawng ahi a, a guh leh tangte sik tawn bang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Pathian lampite a pipen ahi: amah bawlpa kia in a namsau amah kiang lam naih ding in a bawl thei ding.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chihtaktak in mualte’n amah an a puak ua; gamsate tengteng mawlna mun ah.
  </para>
  <para style="p">
    <verse number="21" style="v" />Singlimte nuai ah a lum a, pumpeng mun dai leh gam nawng ah.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tui lili singte’n a lim un a khuh ua; luigei singnah kaite’n a tuam kimvel uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ngai in, lui a dimlet leh, a ling kei: a kam chiang pha hial in Jordan khang mahleh, a muang hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A kiven lai in kuapeuh in amah sikkawi in a man diam, thang in a nak a vut pailet diam?”
  </para>
  <chapter number="41" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Ngakuai in Ole na kai khe thei diam? Ahihkeileh a khau in a lei na sawntum thei diam?
  </para>
  <para style="p">
    <verse number="2" style="v" />A nak sung ah khauhual na thun thei diam? Ahihkeileh sikkawi in a haizek na vut pailet thei diam?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na kiang ah thil nget tampi a bawl diam? Ahihkeileh na kiang ah thu nemte a gen diam?
  </para>
  <para style="p">
    <verse number="4" style="v" />Tangtawn a ding in amah sikha dia na lak theihna ding in, nang toh thukhun a bawl diam?
  </para>
  <para style="p">
    <verse number="5" style="v" />Vasa toh bang in amah toh na mawl diam? Ahihkeileh na sikhanute ading in amah na hen diam?
  </para>
  <para style="p">
    <verse number="6" style="v" />Ngamanmite’n amah sumsinna ding in a bawl ding uam? Sumsinmite lak ah amah a zuak ding uam?
  </para>
  <para style="p">
    <verse number="7" style="v" />Siklen in a vun na dimsak thei diam, ahihkeileh a lu ngalingte in?
  </para>
  <para style="p">
    <verse number="8" style="v" />A tung ah na khut koih in; kidouna theigige in, huchi in na hih nawn kei ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ngai in, amah lametna bangmahlou ahi: amah muh mahmah in mi paihkhiak in a omkei dia hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah hihhalh ngam khop ding in kuamah a hang kei: ka ma ading kua ahia leh?
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah ka dit ding, ka kiang ah kuan a pe masa a leh? Van nuai a om peuhmah kei a ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“A guhlehtang thu ah ka dai kei ding, a hatna mahmah leh, a pum kilawmna ah leng.
  </para>
  <para style="p">
    <verse number="13" style="v" />A puansilh tungnung kuan a suahsak thei dia? A kamkaih thuah nih sung ah kua hongpai dia?
  </para>
  <para style="p">
    <verse number="14" style="v" />A mai kongkhakte kuan a hong thei dia? A ha kimvel ah lauhuaina a om.
  </para>
  <para style="p">
    <verse number="15" style="v" />A lip hattakte a kisaktheihna ahi, Namkipsa bang in khakkhum ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A kal ua huihzam a lut theihlouhna ding in, khat in a dang a naih mahmah.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khat leh a dang a kizom ua, a kisoumat ua, khentheihlouh in a om uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hahchhiaute’n a vaksak a, a mitte zingsang mitvunte bang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kam apan meikuangte a pawtkhia, meiekte a tawm khia hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A nakvangte a kipan in meikhu a pawt a, halsiangna bel leh chiklak loupa kang a kipan bang in.
  </para>
  <para style="p">
    <verse number="21" style="v" />A hu in suang a kuangsak a, a kam apan meikuang a pawtkhia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A ngawng ah hatna a om gige a, a ma ah lauhuaina a lam hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Asa thate a kizom khawm ua: a tung ah a kip ua; hihtat theih in a omkei uh.
  </para>
  <para style="p">
    <verse number="24" style="v" />A lungtang suang bang in a kip a; ahi, buhgawina suang nuainung bang ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amah a thoh chiang in, mihatte a lau uh: lauluatna ziak in omdan ding a theikei uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Min amah namsau in sat leh, a phatuam kei hi; teipi leng, thal leng, sikmuk zum leng.
  </para>
  <para style="p">
    <verse number="27" style="v" />Buhpawl bang in sik a sim a, sing muatsa bang in dal.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thal in amah a taisak theikei ding: amah lak ah vaisuanglot suangte buhpawl a suak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Khetbukte buhpawl bang a sim ahi: Teipi ging a nuihsan hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A nuai lampangte belpei ahi: buannawi tung ah buh khetna chiang bang in a kiphah.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tuithuk belsou di’n a bawl a: tuipi nuhtheih bawm in a bawl hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A nung ah lampi a vaksak a; tuithuk samkang nei a sa uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Leitung ah amah bang a lau neilou omkei a,
  </para>
  <para style="p">
    <verse number="34" style="v" />Thil sang chiteng a en a: kisathei tapate tengteng tung ah kumpipa ahi.”
  </para>
  <chapter number="42" style="c" />
  <para style="p">
    <verse number="1" style="v" />Job in Toupa a dawng a, hichi in a chi hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />“Thil bangkim na hihthei chih leh nang thiltup kham theih ahi kei chih ka thei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai thuhilhna theihna tellou a sel kua ahia? Huaiziak in ka theihsiamlouh, ka theihlouh, kei adia thillamdang luate ka genkhia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Za in, k’on ngen hi, ka pau ding; nang k’on phut ding, kei lam ah nang phuang in, n’on chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ka bil zakna in nang k’on za a; himahleh tuin ka mit in k’on mu a,
  </para>
  <para style="p">
    <verse number="6" style="v" />Huaiziak in ka kikih a, leivui leh meivu ah ka kisik hi.”
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan hichi ahi a, huchi a Toupa’n Job kiang a hiai thute a gen khit in, Toupa’n Eliphaz, Teman mi kiang ah, Ka hehna nang tung leh, na lawm nihte tung ah a kuang, ka sikha Job bang a noute’n ka tanchin thildik na gen louh ziak un, a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huaiziak in tuin, bawngtal sagih leh belamtal sagih la unla ka sikha Job kiang ah hoh unla, nou ading in haltum thillat lan un; huchi in ka sikha Job nou ading in a thum ding a; amah vang in ka sang dia, huchi in na haina uh dungzui in na tung uah ka hih kei ding; ka sikha Job bang in lah ka tanchin thildik na gen kei uhi, chi in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Eliphaz, Teman mi leh Bildad, Suah mi leh Zophar, Naamathmi a kuanta ua, Toupa’n thu a piak bang in a hihta uhi: Toupa’n Job a sangta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Job a lawmte adia a thumzoh in Toupa’n Job saltanna a kiheisak a: Toupa’n Job a ma a neih zahnih a peta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huailai in a kiang ah, a unaute tengteng leh, a sanggamnute tengteng leh, tuma lam in a meltheih hisa tengteng leh, a insung a tanghou amah toh nete a hongpai ua: amah a nem ua, a tung a Toupa’n hoihlou a tunsak tengteng tungtang thu ah amah a lungmuan uhi: michih in leng amah sum nengneng leh, michih in dangkaeng zungbuh a pia uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in Toupa’n Job tawpna lam a kipatna lam sang in a nak vualzawl zaw a: belam sang sawmlehli, leh sangawngsau sang guk leh bawngtal sang khat leh, sabengtungnu sang khat a nei hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tapa sagih leh tanu thum leng a nei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A masapen, Jemima a chi a; a nihna min, Kezia; a thumna min, Keren happuk.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in gamsung pumpi ah Job tanute bang a melhoih a omkei uhi: a pa un a unaute lak ah goutan amau a pia hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai nung in Job bel kum za leh sawmli a dam a, a tapate, leh a tapate’ tapate, khang lina tan a mu hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in, Job a tek mahmah a, a Upat tak ziak in a sita hi.
  </para>
</usx>
