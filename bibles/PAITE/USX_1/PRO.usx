<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="PRO" style="id">Paunakte</book>
  <para style="h">Paunakte</para>
  <para style="toc1">Paunakte</para>
  <para style="toc2">Paunakte</para>
  <para style="mt">Paunakte</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel kumpipa, David tapa Solomon paunakte:
  </para>
  <para style="p">
    <verse number="2" style="v" />Pilna leh hilhna theihna ding; theihsiamna thute theikakna ding;
  </para>
  <para style="p">
    <verse number="3" style="v" />Thilhih pilhuai a hilhna mu ding, diktatna, vaihawm leh hawmsiamna ah;
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi mawlte kiang a kivensiamna peding, tangval kiang a theihna leh ngentelna;
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi pil in a zak theih a, sinsiamna a a pun theihna ding in; theisiam mi in thuphate a phak theihna ding;
  </para>
  <para style="p">
    <verse number="6" style="v" />Paunak leh lim a thugen theisiam ding; mipilte thute, gentehna thugen theihhakte theisiam ding in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Toupa kihtak theihna kipatna ahi: himahleh mihai in pilna leh hilhna a musit.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka tapa, na pa hilhna za in, na nu dan mangngilh ken:
  </para>
  <para style="p">
    <verse number="9" style="v" />Na lu ading in deihhuai lutang zem leh na ngawng vial ding khainiangte hi ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka tapa, mikhialte’n a honzol ua leh, pha sakpih ken.
  </para>
  <para style="p">
    <verse number="11" style="v" />Honzui in, sisan I buk ding ua, a ziak bei in mi hoihte a guk in i tang ding uh, a chih uleh:
  </para>
  <para style="p">
    <verse number="12" style="v" />Sheol bang in amaute a hing in i nawmvalh ding ua, huan, kawkhuk sung a paisukte bang in, a pum in:
  </para>
  <para style="p">
    <verse number="13" style="v" />Van manpha tengteng i mu ding ua, gallakte in i innte uh i dimsak ding uh;
  </para>
  <para style="p">
    <verse number="14" style="v" />Na tan kou lak ah na seplut ding a; sumbawm khat i neikhawm ding ua:
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tapa, lampi ah amau toh ton ken; a lampi ua kipan na khe kaikik in:
  </para>
  <para style="p">
    <verse number="16" style="v" />Gilou hih ding in a khe uh a tai ngal a, huan sisan suah ding in a kinoh uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Vasa himhim mitmuh in, len a kiphah thawn ngal a:
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan hiaite’n amau sisan ngei a tang ua, amau hinna ngei a guk in a buk uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchibang tuh michih punna a duhgawlte lampi ahi a; huai in a neitute hinna a lakmang sak sek hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kongzing ah ngaihtak in pilna a kikou a; mun liante ah a aw a suah a;
  </para>
  <para style="p">
    <verse number="21" style="v" />Mipi omkhawmte mun pipen ah a kikou a; kongpite lutna ah, khopi ah, a thute a gen:
  </para>
  <para style="p">
    <verse number="22" style="v" />Bang tan ahia, nou mi mawlte’n, mawlna na it ding uh? Nuihsanmite’n nuihsana amaute a kipah ding ua, mihaite’n theihna a huat ding uh?
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka salhna ah kihei unla: ngai in na tung uah ka kha ka sung baw ding, na kiang uah ka thute ka theisak ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka sap a, na nial ziak un: ka bante ka zak a, kuamah in a limsak kei uh;
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh ka thupha tengteng bangmahlou in na koih ua, ka salhnate bangmah na deihkei uhi:
  </para>
  <para style="p">
    <verse number="26" style="v" />Ken leng na tuahsiat ni un k’on nuihsan dia; na launa uh a hongtun chiang in k’on chiamnuih ding;
  </para>
  <para style="p">
    <verse number="27" style="v" />Huihpi bang a na launa uh a hongtun chiang in; pingpei bang a na tuahsiatna uh a hongtun chiang in; lungkhamna leh dahna na tung ua a hongtun chiang in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huai hun chiang in kei a honsam ding ua, himahleh ka dawng kei ding; thanuamtak in a honzong ding ua, himahleh a honmu kei ding uh:
  </para>
  <para style="p">
    <verse number="29" style="v" />Theihna a huat ua, Toupa kihtakna a zon louh ziak un:
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka thupha lak ah bangmah a deihkei ua; ka salhna tengteng a musit uhi:
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in a lampi uh gah a ne ding ua, amau thusawmte ngei in a vah ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi mawlte nungtolhna in amaute a that dia, mihaite hauhsakna in amau hihmang ding a hih ziak in.
  </para>
  <para style="p">
    <verse number="33" style="v" />Himahleh kuapeuh kei hon ngaikhia bittak in a teng ding ua, gilou launa panglou in a muang ding uhi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa, ka thute na san a, ka thupiakte nang a na khol khawm leh;
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi a pilna lam a na bil na doh a, theihsiamna lam a na lung na suk leh;
  </para>
  <para style="p">
    <verse number="3" style="v" />Ahi, theihkakna na sapa, theihsiamna ding a na aw na suah leh;
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangka bang a huai na zona, gou sel bang a huai na zon leh;
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Toupa kihtakna na theisiam ding a, Pathian theihna na mu ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n lah pilna a pe ngal a; a kam a kipan in theihna leh theihsiamna a hongpai hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Midik ading in pilna hoih a khol khawm a, muanhuaina a omte amaute ading in lum ahi;
  </para>
  <para style="p">
    <verse number="8" style="v" />Vaihawmna lampite a ven theihna ding in, a misiangthoute lampi a hawi theihna ding in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in diktatna leh vaihawmna na theisiam dia, huan, hawmsiamna, ahi, lampi hoih chiteng.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na lungtang sung ah pilna a honglut ding a, huan na kha ading in theihna a nuam ding hi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngentelna in nang a honveng dia, theihsiamna in nang a honkem ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Gilou lampi a kipan hon hunkhe ding, mi thil hoihlou gente a kipan;
  </para>
  <para style="p">
    <verse number="13" style="v" />Lampi tangte mangngilh, khomial lampite a pai ding;
  </para>
  <para style="p">
    <verse number="14" style="v" />Gilou hih ding a kipak a, gilou hoihlouhna a nuamsa;
  </para>
  <para style="p">
    <verse number="15" style="v" />A lampite ua kawi a, a lampite ua dikloute;
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei lamdang a kipan nang honhun ding, mikhualnu a thute toh a maitangphatnu a kipan mahmah in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman a tuailai lawm a nusia a, a Pathian thukhun a mangngilh hi:
  </para>
  <para style="p">
    <verse number="18" style="v" />A inn in sihna lampi a doh a, a lampite’n misite lampi:
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah kiang hoh kuamah a kiknawn kei ua, kuamah in hinna lampite a phazou sam kei uhi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi hoihte lampi a na pai theih a, mi diktatte lampi na zuih theihna ding in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi tangte gamsung a teng ding ahi ua, huan asung ah mi hoihkimte a om tawntung ding uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh giloute gam a kipan satkhiak in a om ding ua, huan lepchiahtak a hihte huai a kipan zung kalhkhiak in a om ding uh.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa, ka dan mangngilh ken; himahleh ka thupiakte na lungtang in kem hen:
  </para>
  <para style="p">
    <verse number="2" style="v" />Nite sawtna leh, damsung kumte leh muanna, nang a hong kibehlap ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="3" style="v" />Chitna leh thutak in nang hon nuse kei hen: Na ngawng kimvel in vial inla; na lungtang dohkan tung ah amaute gelh in:
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Pathian leh mihing mitmuh in deihsakna leh theihsiamna hoih na mu ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Na lungtang tengteng toh Toupa ah muang inla, nangmah theihsiamna ah kinga ken:
  </para>
  <para style="p">
    <verse number="6" style="v" />Na lampi tengteng ah amah thei inla, huchi in aman na lampite a pitang ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nangmah mit ah pil kenla; Toupa kihta inla, gilou taisan in:
  </para>
  <para style="p">
    <verse number="8" style="v" />Na lai ading in damna ahi ding a, na guhte ading in guhngek.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na van in Toupa zahtak in, na punna tengteng a gahmasate toh in:
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in hauhna in na pangte a dimlet dia, na belte uain thak in a dimlet ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tapa, Toupa sawina musit kenla; a salhna leng chimtak sam ken:
  </para>
  <para style="p">
    <verse number="12" style="v" />Pa’n a kipahna tapa a salh bang in. Toupa’n a itte a sal ngal a;
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilna mu mi leh theihsiamna mu mi’n nuam a sa hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai a vante lah dangka vante sang in a hoihzaw ngal a, huan huai a punna dangkaeng hoih sang in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Rubi suang sang in a manpha zaw: huan amah toh na thil deihte na tehpih theikei ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />A khut taklam ah nite sawtna a om a; a khut veilam ah hauhsaknate leh zahtakhuaina.
  </para>
  <para style="p">
    <verse number="17" style="v" />A lampite nuamna lampite ahi a, a lampite tengteng muanna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amah lenchintente ading in hinna sing ahi: amah neiden michih in nuam a sa uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa’n pilna in lei a mukhia a; theihsiamna in vante a hihkipta hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A theihna in thuknate a kitam a, huan vante’n a daitui a taksak uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tapa, na mitte a kipan amaute paimang sakken; pilna hoih leh ngentelna kem gige in;
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in na kha ading in hinna ahi ding ua, na ngawng ading in kilawmna.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in bittak in na lampi ah na pai ding a, na khe a kisui kei ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Na lup chiang in, na lau kei dia: ahi, na lum ding a, na ihmut a lim ding.
  </para>
  <para style="p">
    <verse number="25" style="v" />Lauguihna kihta ken, a hongpai chiang in, giloute hihgawpna leng lau sam ken:
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa na muanpi ahi sin ngal a, na khe thang a awklou ding in a veng ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A mudingte a kipan thil hoih it ken, hih ding a na khut thilhihtheihna a omlai in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na invengte kiang ah, na kiang a na neih lai in, pai inla, hong nawn in, huchi in zingsang chiang in k’on pe ding, chi ken.
  </para>
  <para style="p">
    <verse number="29" style="v" />Na invengte siatna ding gilou ngaihtuah ken, na kiang ah bittak in a teng chih thei in.
  </para>
  <para style="p">
    <verse number="30" style="v" />A ziak bei in mi toh kina ken, gilou bangmah na tung a ahihkei leh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiamgamna mi eng ken, a lampite lak a bangmah tel ken.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kilawmlou lah Toupa ading in kihhuai ahi ngal a: himahleh a thuguk mi tangte kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toupa hamsia migiloute inn ah a om; himahleh mi diktatte tenna a vualzawl hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman nuihsanhatte a nuihsana, himahleh kingainiamte kiang ah hehpihna a pia hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Mi pil in thupina gou a luah ding; himahleh zumna mihaite kaisanna ahi ding hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tate aw, pa hilhna za un, theihsiam na thei ding in limsak un:
  </para>
  <para style="p">
    <verse number="2" style="v" />Thuginpi hoih k’on pe ngal a; ka dan taisan kei un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Ka pa ding in tapa ka hi a, ka nu mitmuh a nunnem leh ithuai pen ka hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a hon sinsak a, ka kiang ah, na lungtang in ka thute lenden hen; ka thupiakte zui inla, huchi in hing in:
  </para>
  <para style="p">
    <verse number="5" style="v" />Pilna nei in, theihsiamna nei in: mangngilh ken, ka kam a thute a kipan lunglel ken:
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai mangngilh kenla, nang a honhawi ding a; amah it inla, aman a honkem ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pilna thil pipen ahi; huaiziak in pilna la in: ahi, na muhsa tengteng toh theihsiamna la in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah pahtawi inla, a man nang hon kaisangsak ding: pahtawina a hontun dia, amah na kawi lai in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na lu ading in kilawmna kizepna a honpe dia: kilawmna lallukhu nang a honpe ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aw ka tapa, ka gente za inla, sang in; huchi in na damsung kumte a tam ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pilna lampi ah k’on kisinsakta a; lampi tangte ah k’on pita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pai chiang in, na kalsuante haksa in a omkei dia; na tai leh, na kisui puk kei ding.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hilhna kiptak in len in; paisak ken: amah vom in; amah lah na hinna ahi ngal a.
  </para>
  <para style="p">
    <verse number="14" style="v" />Migiloute lampi ah lut ken, gilou mite lampi ah pai ken.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pel khia inla, a kiang ah paiken; kiheisan inla, pai vengveng in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Poi a khoih kei ngal uleh, a ihmu ngal kei ua; kuahiam a puksak kei uleh, a ihmutna uh lakmang in a om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Gitlouhna tanghou lah a ne ngal ua, hiamgamna uain a dawn uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh mi diktatte lampi khovak tung bang ahi, sunlaitak a ni bang a tangpha semsem.
  </para>
  <para style="p">
    <verse number="19" style="v" />Migiloute lampi khomial bang ahi: a kisuihna uh a theikei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa, ka thute limsak in; ka gente ah na bildoh in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na mitte a kipan amaute lamang ken; na lungtang lak ah vom in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amau mute ading in hinna ahi ngal ua, a sa uh ading in damna.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thanopna tengteng toh na lungtang kem in; huai a kipan lah hinna tuinakte a luang ngal a.
  </para>
  <para style="p">
    <verse number="24" style="v" />Nang a kipan kam hoihlou koihmang inla, nang a kipan in muk kilawmloute gamlapi ah koih in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na mitte’n tangtak in en uhenla, na etna na ma ah tang hen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Na khe lampi pheisak inla, huan na lampi tengteng hihkip in omsak in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Na khut taklam hiam veilam hiam ah pial ken: gilou lampi ah paiken.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa, ka pilna limsak in; ka theihsiamna na bildoh in:
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngentelna na vom theih a, na mukte’n theihna a kep theihna ding un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Numei lamdang mukte’n lah khuaizu a tak khesak ngal a, a kam sathau sang in a nal zaw:
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh a tawpna nanung gamsai bang in a kha a, namsau hiamtuah bang in a hiam hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A khete sihna lam ah a paisuk a; a kalsuante’n Sheol zuan in a len chinten;
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in hinna lampi phei a mu kei hi: a lampite a kipkei a, aman a theikei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaiziak in tuin, ka tapate, hon ngaikhia unla, ka kam a thute a kipan pai mang kei un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah a kipan in na lampi gamlapi ah suanmang in, a inn kongkhak nai ah hongpai ken:
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchilou in zaw midangte kiang ah na zahtakhuaina na pe kha ding a, na kumte gilou kiang ah:
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchilou in zaw na hatna in mikhualte a vah kha ding ua, gamdang mi inn ah na sepgimnate a om kha ding;
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan, na sa leh na pumpi hihgawp a a omlai in na tawpna nanung ah na sun kha ding:
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in, hilhna za nuamlou hina tel ing e, ka lungtang in salhna na musit natel e, na chi kha ding;
  </para>
  <para style="p">
    <verse number="13" style="v" />Hon sinsakmite aw ka mangkei a, kei honhilhte lam leng ka bil in ka na dohkei:
  </para>
  <para style="p">
    <verse number="14" style="v" />Omkhawmte leh kikhawmpite lak ah gilou tengteng ah siatna ka na hita mahmah hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nangmah tuibem a kipan tuite dawn in, nangmah tuileh a kipan tuiluang laite.
  </para>
  <para style="p">
    <verse number="16" style="v" />Na tuinakneite sukthanghuai gawp a om ding hia, kongzingte ah na luite?
  </para>
  <para style="p">
    <verse number="17" style="v" />Nangmah ading kia hi uhenla, nang kiang a mikhualte ding hilou in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na tuikhuk vualzawl in om hen; huan na tuailai zi ah kipak in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Deihhuai sazukpi leh heksiam sakhipi bang. A itna leh ngaihnatna in chiklaipeuh in leng nang hon lungkimsak gige hen; huan a itna a vak in om gige in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Bangziak in ahia, ka tapa, numei lamdang vak a om a, mikhual ang va kawi ding na hia?
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing lampite lah Toupa mit ma ah a om ngal a, aman a lampite tengteng a pheisak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Giloute amah thulimlouhnate’n aman ding a, a khelhna guite a kan in a om ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hilhna taksap ziak in a si ding a; a haina thupina ah a paimang ding hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa, na inveng adia mawh khu dia na din leh, mikhual ading a na khut na kichiam leh,
  </para>
  <para style="p">
    <verse number="2" style="v" />Na kam a thute a awk na hih a, na kam a thute a mat na hihleh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Tuin hiai hih in, ka tapa, nang leh nang ki honkhia in, na inveng khut sung ah na om chih thei in; kuan in, nang leh nang kiniamkhiak inla, na inveng va ngen ngutngut in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na mitte ihmusak kenla, na mitvunte leng lususak sam ken.
  </para>
  <para style="p">
    <verse number="5" style="v" />Gamvakpa khut a sakhipi bang leh thangkampa khut a vasa bang in ki honkhia in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Miksi kiang ah hoh in, nang thadah; a lampite ngaihtuah inla, pil in:
  </para>
  <para style="p">
    <verse number="7" style="v" />Hausa, heutu, hiam vaihawmmi, neilou in,
  </para>
  <para style="p">
    <verse number="8" style="v" />Nipi chiang in a an a sutuah ua, pawltak chiang in a an a kaikhawm hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Bang tan ihmu ding na hia, aw thadah? Na ihmutna a kipan chikchiang a thou ding na hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Neukha ihmut lai, neukha lusuk, ihmu ding a neukha khutte khep:
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in na gentheihna guta bang in a hongpai dia, huan na taksapna mi kigalvan bang in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi phatuamlou, migilou; kam kiuangsak toh a vak a;
  </para>
  <para style="p">
    <verse number="13" style="v" />A mitte in chiamtehna a bawl a, a khete in thu a gen a, a khutzungte in chiamtehna a bawl;
  </para>
  <para style="p">
    <verse number="14" style="v" />A lungtang sung ah hoihlouhna a om a, gilou a gel gige; kilemlouhna a tuh naknak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huaiziak in a tuahsiatna thakhat in a hongtung dia; thakhat a kekgawp in, hihdamna bei in a om ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa’n a muhdah thil guk a om a; ahi, amah adia kihhuai sagih a om hi:
  </para>
  <para style="p">
    <verse number="17" style="v" />Mit ki uangsakte, lei zuauthei, mi hoih sisan suah khutte;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ngaihtuahna gilou ngaihtuah lungtang, siatna hih ding a kintaite;
  </para>
  <para style="p">
    <verse number="19" style="v" />Zuau thugen palai taklou, leh unaute lak a kilemlouhna tuh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ka tapa, na pa thupiak zui in, huan na nu dan mangngilh ken:
  </para>
  <para style="p">
    <verse number="21" style="v" />Na lungtang tung ah vial gige inla, na ngawng kim ah gak in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Na vak chiang in, nang a honpi ding: na ihmut chiang in, nang a honveng ding hi; huan na khanloh chiang in, nang a hon houpih ding.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thupiak lah khawnvak ahi ngal a: huan dan vakna ahi; huchi in hilhna taihilhna hinna lampi ahi:
  </para>
  <para style="p">
    <verse number="24" style="v" />Numei gilou a kipan leh mikhual lei maitang phatna a kipan in nang honkem ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na lungtang in a kilawmna lunggulh ken; a mitvunte in nang hon man kei hen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Numei kizuaknu ziak in pasal tanghou them a mat in a om hi: huchi in angkawmnu’n hinna manpha a zongsek hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi’n a angsung ah mei a la thei diam, a puante a kangkei diam?
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahihkeileh mi suangkuangthei sa tung ah a vak thei diam, a khete a kang kei diam?
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchibang in kuapeuh invengte zi zuan; kuapeuh amah khoih gawtlouh a omkei ding.
  </para>
  <para style="p">
    <verse number="30" style="v" />Guta in a gilkial ziak a a lunggulhna taisak ding kia a a guk leh mite’n guta a musit kei uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh muh a a om leh, a zah sagih in adin ding; a inn a van tengteng a pe ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kuapeuh angkawm theihsiamna bei ahi: amah kha hihse ding a a hih ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Liamnate leh zumhuaite a mu ding; huan a zahpihhuaina nulmang ahi kei ding.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mullitna lah mi thangpaihna ahi ngal a; huchi in phulak ni chiang in a hawikei ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tatna a limsak kei ding a; thilpiak tampi pe lechin leng, lungdam in a omkei ding hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ka tapa, ka thute kem in, na kiang ah ka thupiakte kholkhawm in;
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka thupiakte kem inla hing in; huan ka dan na mittang bang in
  </para>
  <para style="p">
    <verse number="3" style="v" />Na khutzungte tung ah vial inla; na lungtang suangpek tung ah gelh in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilna kiang ah, ka sanggamnu na hi, chi inla, theihsiamna na tanaunu chi in:
  </para>
  <para style="p">
    <verse number="5" style="v" />Numei lamdang a kipan nang a honkep theihna ding un, a thute a maitangphatnu mikhual a kipan.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka inn tohlet apan ka dak khia a, tohlet vang kal ah ka en paisuak a;
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan mi mawlte lak ah ka en a, tuailaite lak ah ka theikak a, tangval theihsiamna beipa,
  </para>
  <para style="p">
    <verse number="8" style="v" />A omna ning chin a kongzing a paisuak a, a inn lam zuan a pai zel pa;
  </para>
  <para style="p">
    <verse number="9" style="v" />Khomui in, nitaklam in, zan mial bikbek leh khomial ah.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ngai in, numei khat, kizuak puansilh silh, lungtang kiva in a kituahpih a.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah ahi lawlaw a, a tum tuntun a; a khe a inn ah a om ngeikei:
  </para>
  <para style="p">
    <verse number="12" style="v" />Kongzing a omton a om a, mun liante a a omton a om a, ning chiteng a bukzel hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in amah a manta a, amah a tawpta a, zummoh maitang toh in a kiang ah:
  </para>
  <para style="p">
    <verse number="14" style="v" />Lemna kithoihnate ka kiang ah a om; tuni in ka thuchiamte ka peta hi,
  </para>
  <para style="p">
    <verse number="15" style="v" />Huaiziak in nang tuak ding in ka hong paikhia a, na mel thanuamtak a zong ding in, k’on muta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka tutna nuam pialkhang phah zehoihte a zep, ka phah khinta, Aigupta khau puangialte toh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ka lupna murra, aloe, leh sinamon in ka namtui sakta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hongpai in, zingsang matan i itna dimset i la ding; itna in i kilungmuan tuah ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka pasal lah inn ah a om ngalkeia, khual gamla ah a zin hi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Sum ip a kitawia; kha a lik chian inn ah a hongpai ding, a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A thugen siamna in amah a kipesakta a, a muk a maitang phatnate in amah a sawlmangta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amah a zuipaha, gohdinga bawngtal a pai bang in, leh mihai bawlhoihna dia sikkhau khihmi bang in;
  </para>
  <para style="p">
    <verse number="23" style="v" />Thal in a sin a kap pailet tan; thanglam a vasa a kintat bang in, huai tuh a hinna gun a hih a theikei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tuin, ka tapate, huaiziak in hon ngaikhia un, ka kam a thute limsak un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na lungtang amah lampi lam ah awn kei henla, lampite lam ah paimang kei hen.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amah lah tampi liamsa in a pai lumletta a: ahi, a thahsate mi hat tampi ahi uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />A inn Sheol zotna lampi ahi, sihna dantante zuan a suk pai.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pilna a kikou in, theihsiamna in a aw a suah kei maw?
  </para>
  <para style="p">
    <verse number="2" style="v" />Lampi a mun sangte tung ah, lampite kisutna ah, ading a;
  </para>
  <para style="p">
    <verse number="3" style="v" />Kongpite biang ah, khopi lutna ah, kongkhakte a pailutna ah, nakpi’n a kikou hi:
  </para>
  <para style="p">
    <verse number="4" style="v" />Noute, aw mite, ka sam: huan ka aw mite tapa kiang ah ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aw nou mi mawlt, kivensiamna theisiam un; nou mihaite, lungtang theisiam nei un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Za un, thil hoihpente gen ding ka hi ngal a; huan ka mukte honna thildikte ahi ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka kam in thutak gen ding ahi ngal a; gitlouhna ka muk a ding in kihhuai hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka kam a thute teng diktatna ah a om; huaite ah bangmah a diklou a omkei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A theisiam kuapeuh ading in a kichian a, theihna mu amaute ading in a dik hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ka hilhna sang unla, dangka hilou in; dangkaeng hoihpen sang in theihna.
  </para>
  <para style="p">
    <verse number="11" style="v" />Rubi suang sang in pilna a hoihzaw hi; huan deihhuai thilte tengteng huai toh tehpih theih ahi kei uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kei pilna in kivensiamna ka tenna ding in ka bawl a, theihna leh theihkakna ka mu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa kihtak a gilou huat ding ahi; kisaktheihna leh, kiotsakna, gilou lampi leh kam hoihlou, ka hua hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thupha kei a ahi, theihna hoih: theihsiamna leh hatna ka nei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kei ziak in kumpipate’n vai a hawm ua, lalte’n dikna thu a pia uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kei ziak in lalte’n vai a hawm ua, miliante leh lei a vaihawmte tengteng in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kei hon itte amau ka it a; kuapeuh honzong in honmu hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hauhna leh zahna ka kiang ah a om; ahi, sawtdaih hauhna leh diktatna toh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ka gah dangkaeng sang in a hoihzaw, ahi, dangkaeng hoih sang in; ka sum muhna dangka hoihpen sang in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Diktatna lampi ka zui a, vaihawmna lampite lak ah:
  </para>
  <para style="p">
    <verse number="21" style="v" />Kei hon itte van ka luahsak theih a, a goubawm uh ka dimsak theihna ding in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa’n a lampi kipattung in a honnei a, nidang a a thilhihte ma in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Tangtawn a kipan, a tung a kipan leh lei omma apan koih kip ka hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thuknate a omlouh lai in, lakkhiak in ka om a; luikhuk tui a dimte a omlouh lai un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mualte a omkip ma in, tangte omma in lakkhiak in ka om:
  </para>
  <para style="p">
    <verse number="26" style="v" />lei leh gam bawlkhiak ahihma in, khovel leivui a bawl nailouh lai in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Vante a hihkip lai in, huai ah ka om: tui thuk maikaih a tehna a koih lai in:
  </para>
  <para style="p">
    <verse number="28" style="v" />Tung a vante a bawlkip lai in: tui thukte tuikhukte a honghat lai un:
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuipi kiang a a gi a piaklai in, huchi a tuite’n a thupiak tung a a tatlek louhna ding un: lei suangphumte a chiamteh lai in:
  </para>
  <para style="p">
    <verse number="30" style="v" />Huailai in a kiang ah ka om, nasemmi heutu bang in: huan niteng in a kipahna ka hi a, a ma a kipak gige in;
  </para>
  <para style="p">
    <verse number="31" style="v" />A ten theihna lei ah; ka kipahna mite tapate kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huaiziak in tuin, ka tapate, hon ngaikhia unla: ka lampite zui mite’n nuam a sa ngal ua.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hilhna za in pil unla, nial kei un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mi kei honza in nuam a sa hi, niteng a ka kongpi leh ka kongkhak khuamte a ngak in.
  </para>
  <para style="p">
    <verse number="35" style="v" />Kuapeuh honmu in hinna a mu ua, Toupa deihsakna tang ding ahi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Himahleh kuapeuh ka tung a thil hihkhial in amah kha a hihdik kei hi: kei hon hawte’n sihna a it uhi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pilna in a inn a lamkhin a, a khuam sagihte a phut hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />A gante a gouta a: a uain leng a helta hi; a dohkan leng a bawlkhinta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A nungakte a sawlkhe ta a, khopi munsang penpente tung ah a kikou a,
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi mawl peuhmah, hiai lam ah hong kihei hen: theihsiamna neilou amah tungtang ahihleh, aman a kiang ah,
  </para>
  <para style="p">
    <verse number="5" style="v" />Hong in, ka tanghou ne unla, ka helsa ka uain dawn un, a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Paikhia unla, nou mi mawlte, hing un; theihsiamna lampi ah pai un.
  </para>
  <para style="p">
    <verse number="7" style="v" />Musitmi bawlhoih in amah ading in zumhuaina a mu: huan kuapeuh migilou sal in amah ading in minsiatna a mu.
  </para>
  <para style="p">
    <verse number="8" style="v" />Musitmi sal dah in, nang a hon hawkha ding: mi pil sal in, huchi in nang a hon it ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi pil kiang ah hilhna pe lechin, a pilzaw lai ding a: mi diktat sinsak in,
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa kihtak pilna bul ahi: Mi Siangthou theihna theihsiamna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kei ziak in na nite lah hihtam ahi ding a, na damsung kumte lah hihpun ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na pil leh, nangmah adia pil na hi. Huan mi na muhsit leh, nang kia’n na paw ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Numei hai a aphuai; mimawl ahi a, bangmah a theikei.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a inn kongkhak ah a tu a, khopi munsangte a tutphah tung ah,
  </para>
  <para style="p">
    <verse number="15" style="v" />A vialpaite sam ding, a lampite ua paizelte,
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi mawlte, hiailai ah hong kihei hen: huan amah theihsiamna neilou tungtang ahihleh, aman a kiang ah,
  </para>
  <para style="p">
    <verse number="17" style="v" />Tuigukte a khum a, a guk a tanghou nek a nuam hi, a chi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh aman huai ah misite a om uh chih leh a mi sapte Sheol thuk ah a om uh chih a theikei hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Solomon paunakte. Tapa pil in pa kipak a bawl a: Himahleh tapa hai a nu gikna ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gitlouhna sumte’n bangmah a lohtak kei: Himahleh diktatna in sihna a kipan a tankhia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa’n mi diktat kialsih a phal kei ding; Himahleh migilou a kipan a tankhia hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khut ze awlmi a hong genthei a: Himahleh mi thanuam khut in hauhsakna a bawl hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Nipi lai a lakhawmpa tapa pil ahi: himahleh pawltak hun a ihmu zumhuai omsak tapa ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Midiktat lu tung ah vualzawlnate a om a: Himahleh gilou kam hiamgamna in a tuam hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Midik theihgigena a nuam a: himahleh Migilou min a muat mang ding.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungtang pilin thupiakte a sang ding a: himahleh mihai haiham a puk ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tangtaka pai hoihtak in a pai a: himahleh a lampite kilawmlousak theih in a om ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A mit a chiamtehna bawl in lungkham na a omsak a; himahleh mihai haiham a puk ding.
  </para>
  <para style="p">
    <verse number="11" style="v" />Midiktat kam hinna tuikhuk ahi: himahleh hiamgamna in gilou kam a tuam hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huatna in kidouna a tokthou a, himahleh itna in tatlekna tengteng a khuh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Theihkak theihna neimi muk ah pilna muh in a om: himahleh chiang theihsiamna neilou mi nungzang ading ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mipilte’n theihna a khol khawm ua: himahleh mihai kamin siatna a naih.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihausa hauhsakna a khopi muanhuai ahi: mi genthei siatna a gentheih uh ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Midiktat sepgimna in hinna a zuan a; gilou punna in khelhna lam.
  </para>
  <para style="p">
    <verse number="17" style="v" />Bawlhoihna limsak hinna lampi ah a om a: himahleh salhna donlou a paikhial hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huatna sel zuautheimukte a kipan ahi a; huan mi gensiatna gen mihai ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thu tampite ah tatlekna a omlou kei a: himahleh a mukte thuzoh in piltak in a hih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Midiktat lei dangka hoihpen bang ahi: migilou lungtang a thamatna neuchik ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Midiktat mukte’n mi tampi a vak a: himahleh mihaite theihsiamna taksap ziak in a si uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Toupa vualzawl na in hauhsakna a bawl a, huan huai ah lungkhamna a behlap kei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihai ading in gitlouhna hih kisuk halhna bang ahi: huchibang in theisiam mi ading in pilna ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Migilou launa, amah tung ah a hongtung ding: midiktat deihna phal in a om ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pingpei a lenmang bang in, migilou a om nawn kei: himahleh mi diktat tangtawn suangphum ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Zuthuk in ha a suksiat bang in meikhu in mit a susia a, huchibang mah in amah sawlte ading in mi zongzaw a om hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toupa kihtakin nite a sausak a, himahleh migilou kumte hihtom ahi ding.
  </para>
  <para style="p">
    <verse number="28" style="v" />Midiktat lametna kipahna ahi ding, himahleh migilou lametna a mangthang ding.
  </para>
  <para style="p">
    <verse number="29" style="v" />Toupa lampi a mitangte ading in kulh muanhuai ahi; himahleh migilou nasemmite ading in siatna ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Midiktat suan mang ahi ngeikei ding: himahleh migilou gamsung ah a teng kei ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Midiktat kamin pilna a hontun a: himahleh lei ginalou satkhiak in a om ding.
  </para>
  <para style="p">
    <verse number="32" style="v" />Midiktat mukte’n laktuak bang ahia a thei a, himahleh migilou kam in ginatlouhna a gen hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Bukna diklou Toupa ading in kihhuai ahi, himahleh gikdan dik a kipahpih lam ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kisaktheihna a hongpai chiang in, zumna a hongpai; himahleh mi kiniamkhiakte kiang ah pilna a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mitangte dikna in amau a pi ding, himahleh mi lepchiahte hoihlouhna in amau ahihse ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thangpaih ni’n hauhsak a phatuam kei, himahleh diktatna in sihna a kipan a hunkhia hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi hoihkim diktatna in a lampi a seksak dia; himahleh migilou a gitlouhna ah a puk ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mitangte diktatna in amau a suaktasak; himahleh lepchiahtak a hihte amau poikhoihna a lak in a om ding uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilou a sih chiang in, a lametna a mangthang ding: huan thulimlouhna lametna a mangthang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Midiktat buaina lak a kipan suahtaksak in a om a, a mun ah migilou a hongpai hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A kam a Pathian limsaklou mi’n a inveng a hihsia a: himahleh theihna ziak in mi diktat suahtaksak in a om hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Midiktat a lamzan chiang in, khopi a kipak a; gilou a manthat chiang in, kikouna a om hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mitang vualzawlna ziak in khopi tawisang in a om: himahleh migilou kam a hihsiat in a om hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kuapeuh a inveng musit pilna bei ahi: himahleh theisiam mi a daidide hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tangthu genmi bang a vialvak in thuguk a taklang: himahleh lungsim muanhuai in thu a im hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kipina pil omlouhna mun ah mite a puk ua: himahleh thupha gen tampi omna ah bitna om hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kuapeuh mikhual adia a mawhkhu dia ding in na a sa ding, himahleh mawhkhu dia dinna hua a muang hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Numei deihhuai in zahtakhuaina a nei gige: huan pasal hatte’n hauhsakna a nei gige hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi chingthei in amah kha ading in a hih hoih a: himahleh migilou in amah sa a hihbuai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Migilou in loh gina sanglou a: himahleh diktatna tuh in kipahman muan a nei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kuapeuh diktatna ading kip in hinna a tung ding: huan kuapeuh gilou delh in amah sihna ding in a hih ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A lungtang ua hoihloute Toupa ading in kihhuai ahi ua: himahleh a lampi ua hoihkimte a kipahna ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Khut kilen mahle uh, migilou gawtlouh in a omkei ding: himahleh diktat chi suahtaksak in a om ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Vok nak sung a dangkaeng suang bang in, huchibang in numei melhoih ngentel na neilou ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Midiktat deihlam hoih kia ahi a: himahleh migilou lametna thangpaihna ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A thehzak a om a, a pung semsem hi; a kilawm khenga it a om a, himahleh taksap lam a manoh lel hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Misiam thausak in a om ding, huan kuapeuh tuibuak amah leng tui buah in a om ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kuapeuh buh leh bal it, mite’n amah a hamsiat ding uh: himahleh kuapeuh a zuak luzang ah vualzawlna a om ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuapeuh hoih thanuamtak a zong in deihsak na a zong: himahleh kuapeuh siatna zong, amah tung ah a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kuapeuh a hauhsak na muang a puk ding: himahleh mi diktat nah hing bang in a lun ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kuapeuh amah in hihbuai in huih a luah ding: huan mihai lungtang pil sikha in a om ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mi diktat gah hinna sing ahi; kuapeuh a pil in khate a man hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngai in, mi diktatte lei ah thuk in a om ding. Migilou leh mikhial kinak thuksem nan chia!
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kuapeuh bawlhoihna it in theih na a it hi: himahleh kuapeuh salhna hua a hai ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi hoih in Toupa deihsakna a mu ding: himahleh gitlouhna ngaihtuah mipa mawh a tangsak ding.
  </para>
  <para style="p">
    <verse number="3" style="v" />Gitlouhna in mi a phutkip kei ding: himahleh diktatna zung a kisuan ngeikei ding.
  </para>
  <para style="p">
    <verse number="4" style="v" />Numei hoih a pasal ading in lallukhu ahi: himahleh zumhuai bawl nu a guhte ah muat na bang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi diktat ngaihtuahna a dik a: himahleh migilou thute khemna ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Migilou thute sisan suah dia bukna ahi a: himahleh mitang kam in amau a suaktasak ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migiloute zoh in a om ua, a omkei uh: himahleh mi diktatte inn ading ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing a pilna bangbang a phat in a om ding: himahleh kuapeuh lungtang hoihlou muhsit in a om ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kuapeuh amah kingai thupi a, tanghou neilou mi sang in kuapeuh zahtak zeka om a sikha neimi a hoih zaw.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi diktat in a gan hinna a limsak hi: himahleh migilou chitna nemte a khel mahmah hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kuapeuh a gam leilet in tanghou tampi a nei ding: himahleh mi bangmahlou nungdelh mi theihsiam na bei ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Migilou in migiloute len a deih a: himahleh mi diktatte zung in gah a suang hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mukte taklekna ah migilou ading in thang a om a: himahleh mi diktat buaina a kipan a hong paikhe ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />A muk gah in mi hoih tai in a om ding a: huan mihing khut a hihte a kiang a piak ahi ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mihai lampi amah mit ah a dik a; himahleh kuapeuh a pil in thupha a ngaikhia hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihai buaina tu mahmah a theih ahi: himahleh mi pilvang in zahlak na a sel hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh thutak gen in diktat na a ensak a, himahleh palai zuau in khemna.
  </para>
  <para style="p">
    <verse number="18" style="v" />Namsau sut bang a pilvanglou tak a pau a om a: himahleh mi pil lei damna ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thutak lei tangtawn in hihkip in a om ding: himahleh lei zuauthei zaw mitphiat kal khat ading lel ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gilou thilgelte lungtang ah khemna a om: himahleh lemna thupha gente kiang ah nuam na a om hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi diktatte tung ah siatna a hongtung kei dia: himahleh migilou gilou in a dim ding.
  </para>
  <para style="p">
    <verse number="22" style="v" />Muk zuautheite Toupa ading in kihhuai ahi: himahleh diktak a hihte a kipahna ahi uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi pilvang in theihna a sel a: himahleh mihai lungtang in haina a phuang khia.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thanuam khut in vaihawm na a paw dia: himahleh mi thadah sep ding nuai a koih in a om ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi lungtang gikna in a kunsak a; himahleh thu hoih in a kipaksak hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi diktat a inveng ading in pitu ahi a: himahleh migilou lampi in a maute a paikhial sak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi thadah in a gamvakna a a matsa nangawn a em ngapkei a: himahleh mi thanuam vanneihte a manpha hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Diktatna lampi ah hinna a om; huai a lampi ah sih na a omkei hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tapa pil in a pa hilhna a za a: himahleh musittu in a salhna a zakei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Min a kam gah in hoih a ne ding hi: himahleh lepchiahmi kha in hiamgamna a ne ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kuapeuh a kam veng in a hinna a vom a: himahleh kuapeuh a mukte hongza in siatna a nei ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thadah kha in a deih a, bangmah a neikei: himahleh thanuam kha thausak in a om ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Midiktat in zuau a hua: himahleh migilou huathuai ahia, zumna a tung sek hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lampi a mitang amah diktatna in a veng: himahleh mikhial zaw gitlouhna in a man hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amah leh amah hausa a kibawl a om, himahleh bangmah a neikei: amah leh amah genthei a kibawl a om, himahleh hauhsakna thupi a nei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihing hinna tatman a hauhsakna ahi: himahleh genthei in vaulauna a za kei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi diktat vakna a kipak a: himahleh migilou khawnvak a kithat ding.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kisaktheih ziak in kiselna kia a hong a: himahleh hoihtak a thuhilh pilna ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bangmahlou a hauhsakna muh a kiam ding: himahleh sepgimna ziak a lakkhawm a pung ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lametna halsawt in lungtang a china sak a: himahleh deih a hongtun chiang in, hinna sing ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuapeuh thu musit in a tung ah siatna a tun hi: himahleh kuapeuh thupiak kihta kipahman piak in a om ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi pil dan hinna tuikhuk ahi, sihna thangte a kipan a paimangna ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Theihsiamna hoih in deihsakna a pia a: himahleh lepchiah mi lampi a phok hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi pilvang peuhmah in theihna toh in na a sem a: himahleh mihai in diklouhna a theh zak.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sawltak gilou hoihlou ah a puk a: himahleh palai muanhuai damna ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Gentheihna leh zumna bawlhoihna nial kiang ah a om dia: himahleh salhna limsak zahtak in a om ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Deih hih pichin kha ading in a nuam a: himahleh gilou a kipan paimang mihaite ading in kihhuai ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mipilte toh ton in, huchi in na pil ding: himahleh mihaite kithuahpih in huaiziak in a thuak ding.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hoihlou in mikhialte a delh a: himahleh midiktat hoih a thuk in a om ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi hoih in gouluah a ta leh tute kiang ah a nutsiat; mikhial hauhsakna mi diktat adia kholkhawm in a om hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Genthei loukhohna ah an tampi a om: himahleh diklouhna ziak a suksiat a om hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh chiang zanglou in a tapa a mudah a: himahleh amah it in amah thanuamtak in a sawi zel hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi diktat in a kha lungkimna tan in a ne a: himahleh migilou gilpi a tasam ding.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Numei pil in innte a lam a: himahleh mihai in amah khut in a phel sia.
  </para>
  <para style="p">
    <verse number="2" style="v" />A tang a gamta mi’n Toupa a kihta a: himahleh a lampite a hoihlou in amah a musit hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihai kamsung ah kisaktheihna chiang a om: himahleh mi pil mukte’n huaite a hawi ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bawngtalte omlouhna ah, anpiakna kuang a siang a: himahleh bawngtal hatna ziak in nakpi a punna a om hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Theihpih ginom in zuau a genkei ding: himahleh theihpih zuauthei in zuau a gen hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Musittu in pilna a zong a, a mu kei hi: himahleh theihsiamna nei ading in theihna a baih hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihai a omna ah lut in, amah ah theihna mukte na mu kei ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi pilvang pilna a lampi theihsiam ahi a: himahleh mihaite haina khemna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihai in khelhna a chiamnuihbawl a: himahleh mi tangte lak ah hoih deihna a om hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lungtang in amah khatna a thei a; huan mikhual in a nuamsakna a tokbuai kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Migiloute inn suksiat in a om ding: himahleh mitang biakbuk a pha ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mihing adia lampi dik a kilawm a om a, himahleh huai tawpna sihna lampite ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungtang nuihna nangawn lungkhamna ahi a; huan vualnopna tawpna gikna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lungtang a nungtolhmi amah lampite a dimsak in a om ding: huan mi hoih amah mah a kipan a hih lungkim in a om ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi mawl in thuchih a um a: himahleh mi pilvang in a paina hoihtak in a en hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi pil in a kihta a, gilou a kipan a paimang: himahleh mihai in musittakin a kipua a, a kimuang hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh hehbaih haitak in a gamta ding: huan ngaihtuah giloumi huat in a om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mimawl in haina a luah ding: himahleh mipilvang theihna khuksak in a om ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hoih mai ah hoihlou a kun a; huan diktat kongpite ah gilou a kun hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Genthei amah inveng mahmah muhdah in a om: himahleh hausa in lawm tampi a nei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A inveng musit in thil a hihkhial a: himahleh mi genthei hehpih, aman nuam a sa hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Hoihlou ngaihtuahte a paikhial kei umaw? Himahleh chitna leh thutak hoih ngaihtuah kiang ah a om ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sepgimna tengteng ah phattuamna a om: himahleh mukte houlimna taksapna lam kia ah a pai hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mipilte a hauhsakna ua theih in a om uhi: himahleh mihaite a haina ua theih in a om uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Theihpih dik in khate a suaktasaka: himahleh zuaugen in khemna a omsak hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa kiktakna ah muanna hat a om a: huan a tate’n bukna mun a nei ding uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Toupa kihtak hinna tuikhuk ahi, sihna thangte a kipan paimangna ding in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mipi tamna ah kumpipa thupina a om: himahleh mipite omlouhna lal siatna ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kuapeuh a hehhak theihsiamna thupi a kipan ahi: himahleh kuapeuh lungtom in haina a tawisang hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Lungtang hoih sa adia hinna ahi: himahleh hazatna guhte muatna ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kuapeuh genthei nuaisiah in a Bawlpa simmawh ahi: himahleh kuapeuh tasam tung a chitna nei in amah a zahtak hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Migilou a gitlouh hihna a paihlut in a om a: himahleh mi diktat in a sihna ah lametna a nei hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Theihsiamna nei lungtang ah pilna a khawl a: himahleh mihaite sunglam pang a om kitheihsak in a om hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Diktatna in nam a tawisang a: himahleh khelhna mi kuapeuh ading in zahlakna ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sikha piltak a gamta lam ah kumpipa deihsakna a om a: himahleh zumna omsak tung ah a thangpaihna a om hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Dawnna nem in thangpaihna a hei mang a: himahleh thu sia in hehna a tokthou hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi pil lei in theihna a gen dik a: himahleh mihaite kam in haina a sungkhia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa mitte mun chiteng ah a om a, hoihlou leh hoih veng gige in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Lei damthei hinna sing ahi: himahleh huai a kilawmlouhna kha sukkhapna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihai in a pa bawlhoihna a musit a: himahleh kuapeuh salhna limsak in pilvanna a mu hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Midiktat inn ah gou tampi a om: himahleh migilou summuhna buaina ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi pil mukte’n theihna a phalh a: himahleh mihai lungtang in huchibang in a hih kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Migilou kithoihna Toupa ading in kihhuai ahi: himahleh mitang thumna a kipahna ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Migilou lampi Toupa ading in kihhuai ahi: himahleh kuapeuh diktatna zui a it hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Lampi mangngilhmi ading in bawlhoihna haksatak a om a: huan kuapeuh taihilhna mudah a si ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sheol leh Abaddon Toupa ma ah a om uh: mite tate lungtangte bangzah phet in a tamzaw diam aw?
  </para>
  <para style="p">
    <verse number="12" style="v" />Musitmi’n salh a om nuam a sa kei: mi pil kiang a zuan kei ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Lungtang nuam in mel kipak a bawl a: himahleh lungtang dahna ziak in lungsim a puakkham hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Theihsiamna nei lungtang in theihna a zong: himahleh mihaite kam haina in a kivak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gimthuak nite tengteng hoihlou ahi: himahleh kuapeuh lungtang kipak in Ankuangluina a nei gige hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Tawmchik a hoihzaw Toupa launa toh, huai a gou thupi leh buaina sang in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Itna omna a anteh louhing nekding a hoihzaw, bawngtal thau leh huai a muhdahna sang in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi thangpai in kinialna a tokthou a: himahleh kuapeuh hehhak in kinakna a damsak hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thadah lampi ling daikalh bang ahi: himahleh mitang lampi lamlian a bawl ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Tapa pil in pa kipak a bawl a: himahleh mihai in a nu a musit hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pilna bei ading in haina nuamsakna ahi: himahleh theisiam mi’n a paina a tangsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thupha omlouhna ah, thiltupte a vuaksuak: himahleh thupha gen tamna ah hihkip in a om uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kam a dawnna ah mi’n nuamsakna a nei: huan a huntak a thugen hoih hina mah e:
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi pil ading in hinna lampi a paitou a, nuailama Sheol a kipan a pai mang theihna ding in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Toupa’n kisathei inn a zungkalh khiak ding: himahleh meithai gamgi a hihkip ding.
  </para>
  <para style="p">
    <verse number="26" style="v" />Lunggel giloute Toupa ading in a kihhuai a: himahleh lungsim siangthoute thugen amah kipah lam ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Punna a duhgawl in amah inn a hihbuai a: himahleh kuapeuh thilpiak hua a hing ding.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi diktat lungtang in dawng ding in a kisin a: himahleh migilou kam in thil hoihlou a sungkhia hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Toupa migilou a kipan gamla ah a om a: himahleh mi diktat thumna a za hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Mitte vakna in lungtang a kipaksak a: huan tanchinhoih in guhte a thausak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hinna taihilhnate ngaikhia bil mipilte lak ah a om gige ding.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kuapeuh bawlhoihna nial in amah kha a musit ahi: Himahleh kuapeuh taihilhna ngaikhia in theihsiamna a mu hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Toupa kihtak pilna thuhilhna ahi; huan zahtakna ma ah kiniamkhiakna a pai hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lungtang kisakkholna mihing a ahi: himahleh lei dawnna Toupa a kipan ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing lampi tengteng amah mit ah a siang a: himahleh Toupa’n khate a buk zel hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Toupa kiang ah na nasepte kemsak inla, huan na ngaihtuahnate hihkip in a om ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Toupa’n thil chiteng tawpna ding in a bawlta: ahi, gilou nangawn gilou ni ading in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Michih lungtang kisathei Toupa ading in kihhuai ahi; thei in, gawtlouh in a omkei ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Chitna leh thutak in thulimlouhna suksiang ahi: huan Toupa kihtakna in mite hoihlou a kipan a paimang uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing lampite’n Toupa a suk lungkim chiang in, a melmate nangawn amah toh kilem in a bawl hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Diktatna toh tawmchik a hoihzaw, diklouhna toh summuhna thupi sang in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihing lungtang in a lampi a ngaihtuah a: himahleh Toupa’n a kalsuante a bawlsak hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kumpipa muk ah Pathian thu a om: a kam in vaihawmnate ah a talek kei ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Bukna dik leh tehna dik Toupa a ahi uh: ip gikna tengteng a nasep ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kumpipate ading in gilou hih kihhuai ahi: mangtutphah lah diktatna a hihkip ahi ngal a.
  </para>
  <para style="p">
    <verse number="13" style="v" />Muk diktatte kumpipate kipahna ahi; huan thudik gente a it uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kumpipa thangpaihna sihna sawltakte bang ahi: himahleh mi pil in a hih lungdam ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kumpipa melvakna ah hinna a om; huan a deihsakna vuah nanung meipi bang ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pilna muh dangkaeng sang in nak hoihzawk hina e: ahi, theihsiamna muh dangka sang a telzawk ding ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mitang lamlian hoihlou a kipan a paimang ahi: kuapeuh a lampi kem in a kha a hawi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kisaktheihna siatna ma ah a pai a, huan lungsim kiuangsak pukna ma ah.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gentheite toh lungsim niamkhiak a om a hoihzaw, kisathei toh gallak hawm sang in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kuapeuh thu limsak in hoih a mu ding: huan kuapeuh Toupa muang, aman nuam a sa hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Lungtang pil pilvang a chi ding uh; huan muk khumna in sinsiamna a pungsak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Theihsiamna neimi ading in hinna luikhuk ahi: himahleh mihaite bawlhoihna a haina uh ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi pil lungtang in a kam a hilh a, huan a muk ah sinsiamna a behlap hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Thu kipahhuai khuaizu bang ahi, kha adia khum, guhte adia damna.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihing adia dik a kilawm lampi a om, himahleh huai tawpna sihna lampite ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nasem gim mi ankam limna in amah a di’n a semgim a: a gilkialna in huai a kipan a lunggulh ngal a.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi thulimlou in siatna a ngaihtuah: huan a muk ah meisa bang a om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mi kiuangsak in kinakna a thehzak a: huan huauhatmi in lawm bulte a khenzak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hiamgam mi’n a invengte a khem a, a hoihlou lam lampi ah a pi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kuapeuh a mitsi, thil hoihlou a ngaih ding ahi; kuapeuh a muk chih in hoihlou a hon tunsak nak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Samkang zaw thupina lallukhu ahi, diktatna lampi ah muh ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Kuapeuh hehhak mihat sang in a hoihzaw; huan kuapeuh a lungsim thuzoh khopi laksang in.
  </para>
  <para style="p">
    <verse number="33" style="v" />Angsung ah ai a kisan a; himahleh huai a hihpaisuakna zaw Toupa a kipan ahi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tanghou gaw a muanna toh a hoihzaw, inn kinakna a dim sang in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Sikha piltak a hih in tapa zumhuaina omsak tung ah vai a hawm ding, huan unaute lak a goutanna ah tan a nei ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huansiangna bel dangka ading ahi, huan meipi dangkaeng ading: himahleh Toupa’n lungtangte a endik hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hoihlou hihmi’n gilou mukte a limsaka; huan Zuauhatin siatna lei a bil a doh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Kuapeuh genthei musit in amah bawlpa a simmawh hi; huan kuapeuh tuahsiatni a kipak gawtlouh in a omkei ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Naupangte’ naupangte mi upate lallukhu ahi uh; huan naupang thupina a pate uh ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thugen hoih mihai toh a kilawm kei: muk zuauthei lal toh a kilawm kei sem.
  </para>
  <para style="p">
    <verse number="8" style="v" />A nei mit ah thilpiak suangmantam bang ahi: koilam peuh a a kiheina ah, a lohching hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kuapeuh tatlekna khuh in itna a zong hi: himahleh kuapeuh thubuai a nuamsa in lawmte a khendalh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Theihsiamna neimi sung ah taina a lut thukzaw mihai sung a vuakna za khat sang in.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hoihlou in helna kia a zong a; huaiziak in sawltak khel amah dou ding a sawl in a om ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vompi a noute laksak a om in mi tuak hen, a haina a mihai sang in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuapeuh hoih sik a gilou kipahman pia, a inn a kipan gilou a paimang kei ding.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kinakna kipatna mi’n tui a khahkhiak bang ahi: buaiziak in kinakna a omma in, kiselna paisan in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kuapeuh gilou siamtangsak, kuapeuh mi diktat mawhpaih, amau gel Toupa ading in kihhuai ahi tuaktuak uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huaiziak in pilna lei ding in mihai khut ah a man a om ahia, theihsiamna a neikei chih thei in?
  </para>
  <para style="p">
    <verse number="17" style="v" />Lawm in chiklaipeuh in a it gige a, huan vangtah ni ading in unau khat a piang hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mi theihsiamna bei in khut a beng a, invengte ma ah mawhkhu ding in a hongom hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kinakna deih in tatlekna a deih hi: kuapeuh a kongpi dom sang in siatna a zong hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kuapeuh lungtang sia nei in hoih a mu kei: huan lei hoihlou nei siatna ah a puk hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kuapeuh mihai suang in a lungkhamna ding in a suang a; huan mihaipa’n nuamsakna a neikei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Lungtang nuamsa damdawi hoih ahi: himahleh lungsim puakkham in guhte a keusak.
  </para>
  <para style="p">
    <verse number="23" style="v" />Migilou in a angsung a kipan in thilpiak a lakhia a, vaihawmna lampi hei koisak ding in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Theihsiamna neimi ma ah pilna a om: himahleh mihai mitte lei tawp ah a om hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Tapa hai a pa ading in lungkhamna ahi a, amah piangsaknu ading in khatna ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi diktat gawt hiam milian thutak ziak a zep leng a hoihkei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuapeuh theihna a neimi a kamsim thei hi: kuapeuh a theihsiamna nei lungsim tawldam in a om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Mihai nangawn, a daih dide lai in, pil a ngaih ahi: a mukte a chih lai in, pilvang bang a theih ahi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kuapeuh kituamseh in amah deihlam a zong hi, huan pilna hoih tengteng tung ah a thangpai hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Theihsiamna ah mihai in kipahna a neikei, himahleh a lungtang a kitaklat theihna ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Migilou a hong chiang in, muhsitna leng a hongpai a, Zahtaklouhna toh zumna a hongpai hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihing kam thute tuithukte bang ahi; pilna tuikhuk luangte bang ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Migilou guptuam a hoih kei, vaihawmna a midiktat nawlkhin leng.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mihai mukte kiselna ah a lut a, huan a kam in zepna a sam hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihai kam a siatna ahi, huan a mukte a kha ding a thang ahi uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huauhatmi thute tanghou limtak bang a hi a, gil sungnungpen pen ah a tumsuk uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A nasepna ze awl leng susemi ading in unau ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Toupa min insang muanhuai ahi; mi diktat huai ah a tailut a, a bit hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hau hauhsakna a khopi muan ahi, amah ngaihdan a kulhbang sang tak bang.
  </para>
  <para style="p">
    <verse number="12" style="v" />Siatna ma ah mihing lungtang a kiuangsak a, zahna ma ah kiniamkhiakna a pai hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuapeuh a zak ma a dawnna pia, amah ading in haina leh zumna ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mihing lungsim in a thuakgimna a pawzou a; himahleh lungsim puakkham kuan a thuakzou ding?
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi pilvang lungtang in theihna a mu a; huan mi pil bil in theihna a zong hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mihing thilpiak in amah ading in omna a bawl a, huan mi thupite ma ah amah a pi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh a gen masa dik in a kilang phot a; himahleh invengte a hongpai a amah a zongkhia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aisan in kiselna a tawpsak a, huan mihatte kikal ah a khen hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Unau hih khasiat khopi muan sang in lak a haksa zaw: huan huchibang kiselna kulhpi sikchiangte ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mihing gilpi a kam a gah in a dim ding: a mukte punna a hih lungkim in a om ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Sihna leh hinna lei thilhihtheihna ah a om; huan huai itte’n huai gah a ne ding uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kuapeuh zi mu in thil hoih a mu a, Toupa a kipan deihsakna a mu hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Genthei in kamdam in a khemsek a: himahleh hausa in khauhtak in a dawng hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh lawm tampite bawl in amah siatna a hih a: himahleh unau sang a ginom zaw lawm khat a om hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ginom a mi genthei, mihau a mukte kilawmlou gen leh mihai sang in a hoihzaw hi
  </para>
  <para style="p">
    <verse number="2" style="v" />Huailou in, kha theihna bei a a om ding a hoihkei; Huan kuapeuh a khe a mangang a khialnak hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing haina in a lampi a hihsia a; huan a lungtang in Toupa a hek.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausakna in lawmte tampi a behlapa; himahleh mi genthei a lawma kipan khen in a om.
  </para>
  <para style="p">
    <verse number="5" style="v" />Theihpih taklou gawtlouh in a omkei ding; huan kuapeuh zuaugen a suakta kei ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tampi in misiam deihsakna a ngen ding ua; huan michih thilpiakte pia ading in lawm ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi genthei unaute tengteng in amah a hua ua; amah a kipan bangchi a gamla in ahia a lawmte a pai uh! Thute in amau a delh a, himahleh a paikhin uh.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kuapeuh pilna mu in a kha a it a; kuapeuh theihsiamna kem in hoih a mu ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Theihpih taklou gawtlouh in a omkei ding a; kuapeuh zuaugen a mangthang ding.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nuamtat, mihai ading in a kilawm kei a; sikha, lalte tung a vaihawm a kilawm kei sem hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihing ngentelna in amah a heh haksak a; huan a tatlekna paikan a thupina ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kumpipa thangpaihna humpinelkai humham bang ahi; himahleh a deihsakna loupa tung a daitui bang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tapa hai a pa tuahsiatna ahi; huan zi hanhat a intung keh gige ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Inn leh hauhsaknate nu leh pate a kipan gouluah ahi: himahleh zi pil Toupa a kipan ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thadahna nakpi a ihmutna ah a pai a; huan mi thadahin gilkial a thuak ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuapeuh thupiak zui in a kha a kem; himahleh kuapeuh a lampite a pilvang lou a si ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh genthei hehpihna nei in Toupa ading in a leitawi sak a, huan a thil hoih hih amah adin nawn ding.
  </para>
  <para style="p">
    <verse number="18" style="v" />Lametna a omlai in na tapa sawi in; huan a kah ziak in na kha in khawlsan mawk ken.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nakpitak a thangpai min gawtna a thuak ding: amah na hutkhiak leh, huai tuh na hih kiknawn kul ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thupha za inla, hilhna sang in, na hinkhua nanung a na pil theihna ding in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mihing lungtang ah thugel tampi a om a; himahleh Toupa thuhilhna, huai mah ading ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihing deihthusam a migitna tehna ahi; huan mi genthei mizuauthei sang in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa kihtak hinna lam zotna ahi; huan kuapeuh huai nei lungkim in a om gige ding; gilou a veh in a omkei ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi thadah in kuangsung ah a khut a phum a, huchi in a kam ah huai a hontun nawn ngap kei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Simmawhhat sat in, mi mawl in pilvang dan a sin ding; theihsiamna nei sal in, huchi in theihna a theisiam ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kuapeuh a pa tung a hiamgam a, a nu delhmang, zumna omsak leh simmohna tun tapa ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Theihna thute a kipan a lampial lel din, ka tapa, hilhna zak tawp in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Theihpihmi phattuamna neilou in vaihawmna a simmawh: Huan migilou kam in thulimlouhna a nawmvalh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Muhsit hatmi ading in vaihawmnate bawlkholhsa ahi, mihai nungzang ading in vuaknate.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Uain muhsit hat ahi a, zu khauh kilai hat ahi; kuapeuh huai a paikhial a pilkei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kumpipa kihtakhuaina humpinelkai humham bang ahi: kuapeuh amah hihheh in amah hinna siatna ding in thil a hihkhial hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mihing ading in kinakna a kipan kidang koih zahtakhuaina ahi: himahleh mihai in kinakna a bawl ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mi thadah in phavang in lei a letkei ding; huaiziak in pawltak chiang in a zong dia, bangmah a neikei ding hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihing lungtang ah thupha gel tui thuk bang ahi; himahleh theihsiamna nei min huai a suahkhe ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi tampi’n amah tung a siam mi a tuak ding: himahleh mi ginom kuan a mu ding?
  </para>
  <para style="p">
    <verse number="7" style="v" />Midik amah muanhuaina a om amah nung in a tate a hampha uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kumpipa vaihawmna mangtutphah tung a tuin a mit in gilou tengteng a thehzak hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kua’n, ka lungtang ka hihsiang a, ka khelhna a kipan ka siangthou, a chi thei dia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Bukna chi tuamtuam leh, tehna chi tuamtuam, a nih tuaktuak un Toupa ading in kihhuai ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Naupang nangawn in a thilhih in amah leh amah a kitheisak a, a nasep a siangthou hia, a dik hia chih.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zathei bil leh, muthei mit, Toupa’n a nih tuaktuak un a bawl hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ihmut it ken, na genthei kha ding hi; na mit hak in, huchi in tanghou in na tai ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A leimi in, bangmah ahi kei, bangmah ahi kei, a chi: himahleh a pai khitnung in, huaichiangin a kiuangsak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dangkaeng a om, rubi suang tampi: himahleh theihsiamna mukte jewel suangmantam ahi uh.
  </para>
  <para style="p">
    <verse number="16" style="v" />Mikhual adia mawhkhu ding a kichiammi puansilh la in; mikhual numei adia kichiam ahihleh mawhkhuhna ding in len in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zuautheihna tanghou mihing ading in a khum a; himahleh a nung in a kam suanghum in a dim ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thiltup chiteng thuhoih gel a hihkip ahi; huan pina pil in nang kidouna na bawl.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kuapeuh tangthu gen a pai vialvial in thugukte a kitheisak hi: huaiziak in kuapeuh a mukte zapi a hong kithuahpih dah in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kuapeuh a pa hiam a nu hiam hamsiat, zan khomial penpen ah a khawnvak hekmial ahi ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tung a kinohtak a gou muhtheih ahi, a tawpna vualzawl ahi kei ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gilou thuk ding, chi ken: Toupa ngak in, aman a hon hondam ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Bukna chi tuamtuam Toupa ading in kihhuai ahi: huan khaina diklou a hoih kei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mihing painate Toupa a kipan ahi; huchi a hihchiang in bangchi’n mihing in a lampi a theisiam dia?
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihing ading in, a siangthou, chih mawkmawk thang ahi, huan a nung a thukan ding a thuchiam.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kumpipa pil in migiloute a haih a, a tung uah chilna kangtalai khe a paisak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihing lungsim Toupa khawnvak ahi, gilpi sunglam sungnung penpen avek a zong in.
  </para>
  <para style="p">
    <verse number="28" style="v" />Chitna leh thutak in kumpipa a hawi a; huan a mangtutphah chitna a letkip ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tangvalte thupina a hatna uh ahi: putekte kilawmna a samkang uh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Keh zou a satna in thil hoihlou a singsiang a: satna in gilpi sunggil lamte a zel hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kumpipa lungtang Toupa khut a om ahi, tui lampite bang in; a utna lamlam ah a hei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mihing lampi chiteng amah mit ah a dik a; himahleh Toupa’n lungtangte a buk hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Diktatna leh vaihawmna hih kithoihna sang in Toupa ading in a laktak zaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mit hah sang leh, lungtang kisathei, migilou khawnvak nasan, khelhna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi pil ngaihtuahnate’n hauhsakna lam kia a nawt a; himahleh michih kinohhat taksapna lam kia ah a kinoh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lei zuauthei a gou muh tuimei lehlam lehlam a mutleng bang ahi; huaite zong min sihna a zong uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Migilou hiamgamna in amaute a taimang ding, vaihawmna hih a nial ziak un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah mawhna a dimpa lampi a kawi mahmah; himahleh misiangthou ahihleh, a thilhih a dik ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Inn zapi sung a numei selhat toh ten sang in, inn tung vum ning a ten a hoihzaw, in
  </para>
  <para style="p">
    <verse number="10" style="v" />Migilou kha in hoihlou a deih; a invengte in a mit ah deihsakna a mu kei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Muhsit hatmi gawt a a om chiang in, mi mawl bawlpil in a om hi; huan mi pil hilh a a om chiang in, theihna a mu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi diktat in migilou inkuan a ngaihtuah; migiloute amau siatna ding in vuallel a a omdan uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuapeuh genthei kahna a bil hum, amah leng a kap ding, himahleh zak in a omkei ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A guk a thilpiak in hehna a nemzou, huan angsung a vantawi in heh mahmahna.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi diktat ading in vaihawmna hih kipahna ahi, himahleh thulimlou hihte ading in siatna ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Theihsiamna lampi a kipan vakmangmi misite kikhopna ah a khawl ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh nopbawlna it mi genthei ahi ding; kuapeuh uain leh sathau hai a hau kei ding uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Migilou midiktat ading in tatnasum ahia, huan mi lepchiah mitang mun ah a hongpai hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gamkeu a ten a hoihzaw, numei kiselhat leh kinak hat kiang sang in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi pil tenna ah gou leh sathau manpha a om; himahleh mihai inn huai a nawmvalh vek hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kuapeuh diktatna leh chitna delh in hinna, diktatna leh zahtakhuaina a mu ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi pil mihatte khopi ah a kah a, huailai a muanna hatna a phel hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuapeuh kamsima, paulou in buainate a kipan a kha a kem hoih hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi kisathei leh uang, a min muhsit hat ahi, kisaktheihna leh kiotsakna in thil a hih zel hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thadahmi deih in amah a that a; a khutte’n sepgim a nial ngal uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nitum a duhgawl tak a huaiham a om a; himahleh midiktat in a pia a, a itkei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Migilou kithoihna kihhuai ahi, lungsim gilou toh huai a hontawi chiang in, bangchi phet a kihhuai sem ahi diam aw!
  </para>
  <para style="p">
    <verse number="28" style="v" />Theihpih zuauthei a mangthang ding; himahleh a za min kalh vuallouh in thu a gen ding.
  </para>
  <para style="p">
    <verse number="29" style="v" />Migilou in a maitang a taksak a himahleh mitang ahihleh bel, a lampite a bawlhoih hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Toupa kalh in pilna hiam theihsiamna hiam thupha hiam a omkei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Kidou ni ading in sakol bawlsa ahi; himahleh Vualzohna Toupa a ahi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hauhsakna thupite sang in min hoih telzawk ding ahi, dangka leh dangkaeng sang in deihsakna a ithuai zaw hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hausa leh genthei a kituak khawm ua, amaute bawl Toupa ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mi pilvang in hoihlou a mu a, a kibu hi. Himahleh mi mawl in a phuzel a, a thuakloh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kiniamkhiakna leh Toupa kihtakna lohtak hauhsaknate, zahtakhuaina leh hinna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Lingte leh thangte mi hoihlou lampi ah a om: kuapeuh a kha kem in huaite a gamlat ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A paina ding lampi ah naupang chil in, huan a upat hun nangawn in leng huai a kipan a paimang kei ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihau in genthei tung ah vai a hawm a, huan leitawimi leitawisakmi ading in sikha ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kuapeuh thulimlouhna tuh in tuahsia a la ding: huan a hehna chiang a lohching kei ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kuapeuh khuttawi lian mitnei vualzawl in a om ding: mi genthei kiang a a tanghou a kipan a piak ziak in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Muhsit hatmi delhkhia in, huan kinakna a paikhe ding hi: ahi, kisualna leh zumhuaina a tawp ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kuapeuh lungtang siangthouna it, a mukte deihhuaina ziak in kumpipa a lawm ahi ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Theihna nei amah Toupa mit in a vom hoih ding, himahleh lepchiah mi thute a pai ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thadah in, pawlam ah humpinelkai a om: kongzing ah thah in a om ding, a chi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Numei lamdangte kam kawkhuk thuk ahi: kuapeuh Toupa deihloumi huai ah a kelut ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Haina naupang lungtang sung ah henlop in a om a: himahleh bawldikna chiang in amah a kipan gamlapi ah a delhkhe ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuapeuh a punna khansakna dia mi genthei nuaisiah a, kuapeuh mi hau kiang a pia, taksapna a tung lel hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na bildoh inla, mi pil thute za in, huan ka theihna lam ah na lungtang suk in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na sung a na kep leh thil nuam ahi ngal a, na muk a hihkip khawm a a om leh.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na muanna Toupa ah a hih theihna ding in, tuni in na kiang ah, nang mahmah kiang ah ka theisak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thuphate leh theihna tungtang a thil hoih penpente na kiang ah ka gelhkhinta kei maw.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na kiang a thu hondongte thutak a na dawn theihna ding a, thutak leh muanhuaite nang hon theisak hilou ka hiam?
  </para>
  <para style="p">
    <verse number="22" style="v" />A gentheih ziak in, genthei lok ken, kongpi ah gimthuak leng nuaisiah sam ken.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa’n lah a thu uh a gen sin ngal a, amau lokte hinna a lok ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi heh mi toh kizawl kenla, huan thangpaihhatmi toh kithuah ken.
  </para>
  <para style="p">
    <verse number="25" style="v" />A lampite na sin kha dia, na kha ading in thang na mu kha ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khutbengte lak a khat hikenla, ahihkeileh leibate ziak a mawhkhu a pangte lak a leng hi sam ken.
  </para>
  <para style="p">
    <verse number="27" style="v" />Piak ding na neih kei leh, bangding a na nuai a kipan na lupna lamang ding ahia?
  </para>
  <para style="p">
    <verse number="28" style="v" />Na pipute koihkipsa, tang a gamgi suan ken.
  </para>
  <para style="p">
    <verse number="29" style="v" />A nasep a kizen mi na mu hia? Kumpipate ma ah ading ding a: mi thulimloute ma ah ading kei ding hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Vaihawmmi toh ne ding a na tut chiang in, na ma a om amah hoihtak in ngaihtuah in.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan anhaimi na hihleh, na gawl ah temta koih ding na hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A anlimte duh lawken; an khemna a dim ahi chih thei in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hausa ding in kigimsak ken; nangmah pilna a kipan tawp in.
  </para>
  <para style="p">
    <verse number="5" style="v" />A omloupi tung ah na mit na koih ding maw? Hauhsaknate’n lah amau ading in kha a kibawl ngal ua, vanlam zuan a leng muvanlai bang in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi sumchit neih tanghou ne ken, a anlimte leng duh sam ken.
  </para>
  <para style="p">
    <verse number="7" style="v" />Amah a kisim bang in, huchibang ahi: Ne inla dawn in, na kiang ah a chi a; himahleh a lungtang nang kiang ah a omkei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Na an nek na lawkhe ding a, na thu hoihte na mansuah ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihai bil ah thugen ken, na thute pilna lah musit ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Tang a gamgi suan ken; pa neilou lou ah lut ken:
  </para>
  <para style="p">
    <verse number="11" style="v" />Amaute tanpa lah a hat ngal a; na siatna ding in amau thu a gensak ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Na lungtang hilhna lam ah suk inla, na bilte theihna thute lam ah.
  </para>
  <para style="p">
    <verse number="13" style="v" />Naupang lak a bawlhoihna it ken. Chiang in sat lechin leng a si kei ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Chiang in amah na sat ding a, huan Sheol a kipan a kha na suakta sak ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ka tapa, na lungtang a pil leh, kei mahmah, ka lungtang a kipak ding:
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahi, ka lungtang in nuam a sa ding a, na mukte’n thil dik a gen chiang un.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na lungtang in mikhialte eng kei hen; himahleh nitum in Toupa kihtakna ah om in:
  </para>
  <para style="p">
    <verse number="18" style="v" />Kipahman lah a omtaktak ngal a; huchi in na lametna satkhiak ahi kei ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Za in, ka tapa pil in, huchi in lampi ah na lungtang pi in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Uain haite la kah om ken; sa haite lak ah:
  </para>
  <para style="p">
    <verse number="21" style="v" />Zukhamhat leh anhai genthei ding uh ahi ngal a: huan ihmut haina in puansia in mi tuam ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nang honsuang na pa thu ngaikhia inla, a upat chiang in na nu musit ken.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thutak lei inla, zuak ken; ahi, pilna, hilhna leh theihsiamna.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi diktat pa nakpitak in a kipak ding: huan kuapeuh tapa pil suang in amah a kipan nuamsakna a nei ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Na nu leh na pa kipaksak inla, nang hon suangnu nuamsa sak in.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ka tapa, na lungtang honpia inla, na mitte ka lampite ah kipak uhen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kizuak lah guam thukpi ahi ngal a; huan numei lamdang kawkhuk kawchik ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ahi, suamhatmi bang in a buk a, huan mite lak ah lepchiahna a pungsak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tunggikna kuan a nei a? Lungkhamna kuan a nei a? Kinaknate kuan a nei a? Phunna kuan a nei a? A kullou liamnate kuan a nei a? Mit sanna kuan a nei a?
  </para>
  <para style="p">
    <verse number="30" style="v" />Uain a peng opte’n; uain lehbulh zong dia kuante in.
  </para>
  <para style="p">
    <verse number="31" style="v" />A san lai in uain en ken, nou sung a a zia a suahlai in, nemtak a a paisuklai in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Atawp chiang in gulpi bang in a kei a, guldekpak bang in gu in a zen hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na mitte’n thil lamdangte a mu ding a, na lungtang in thilhoihloute a genkhe ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Ahi, tuipilai a lum ahihkeileh longkhuam dawn a lum bang na hi ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />A honsat ua, na ka sa kei; a honvua ua, bangmah in ka veikei; chikchiang in ka halh dia? Zong thaknawn naveng, na chi ding.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migiloute siatna ding in enlah ken, a kiang ua om utsam ken:
  </para>
  <para style="p">
    <verse number="2" style="v" />A lungtang un nuaisiahna a sin ua, a mukte un siatna thu a gen uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilna ziak in inn lam in a om a; theihsiamna in hihkip in a om:
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan theihna in dantante hihdim in a om, hauhna manpha leh nuamte tengteng in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi pil a hat: ahi, theihna neimi’n hatna a pungsak.
  </para>
  <para style="p">
    <verse number="6" style="v" />Piina pil in na galdouna bawl ding na hi ngal a: huan thuhilhmi tampite ah bitna a om hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihai ading in pilna a sang lua: kongpi ah a kam ka kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kuapeuh hoihlou hih ngaihtuah, mite’n siatna deihmi a chi ding uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mihai ngaihtuahna khelhna ahi: huan musitmi mite ading in kihhuai ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Vangsiat ni a na bah leh, na hatna a neu.
  </para>
  <para style="p">
    <verse number="11" style="v" />Sihna lam a puakmanga omte suaktasak in, huan thah a om dia mansate nangman suaktasak in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Ngai in, hiai ka theikei uh, na chih leh: lungtangte bukpa’n huai a ngaihtuah kei maw? Huan na kha kempa’n, huai a theikei maw? Huan michih kiang ah a thilhih bang in a pe kei ding maw?
  </para>
  <para style="p">
    <verse number="13" style="v" />Ka tapa, khuaizu ne in, a hoih ngal a; huan chep a khum khuaikhak:
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in pilna na khalam ading ahi chih na thei ding: na muh leh, huchi in kipahman a om ding, huan na lametna satkhiak ahi kei ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw giloupa, mi diktat omna dou ding in tang ken; a khawlna mun hihsiatsak ken:
  </para>
  <para style="p">
    <verse number="16" style="v" />Mi diktat lah sagihvei a puk a, huan a thou nawn ngal a; himahleh migilou tuahsia zoh in a om ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na melma a puklai in nuamsa ken, zoh a a omlai in na lungtang kipak kei hen:
  </para>
  <para style="p">
    <verse number="18" style="v" />Toupa’n huai a mu kha in, amah a kipahpih kei in, huan amah a kipan a thangpaihna a heimang kha ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Gilou hihte ziak in ki lungkhamsak dah in: giloute leng eng sam ken:
  </para>
  <para style="p">
    <verse number="20" style="v" />Migilou ading a kipahman omlou ding ahi ngal a: migilou khawnvak heklup in a om ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Ka tapa, Toupa leh kumpipa kihta in: huan a koimah mah leng thumanlou ken.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amau apan a siatna lah thakhat a om guih ding ahi ngal a: huan amaute apan tuahsiatna kua ahia thei?
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiaite leng mi pil thugente ahi. Vaihawmna a mite deihsaktuam neih a hoih kei.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh migilou kiang a, Na diktat hi, chi peuhmah; mite’n amah a hamsiat ding ua, namte’n amah a kih ding.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh amah salte ading in kipahna ahi ding, huan a tung uah vualzawlna hoih a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Dawnna dik pia mukte mite’n a tawp ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pawlam ah na thilhih bawlkhol inla, lou sung ah nang ading in huai tuh mansa in bawl in; huan huai nung in na inn lam in.
  </para>
  <para style="p">
    <verse number="28" style="v" />A bul bei in na inveng siatna ding in theihpihmi hi ken; huan na mukte in khem ken.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka tung a a hih bang in amah tung ah leng ka hih ding, chi ken; mi a nasep bang in ka thuk ding.
  </para>
  <para style="p">
    <verse number="30" style="v" />Thadahmi lou kiang ah ka pai a, huan theihsiamna bei mi grephuan kiang ah;
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngai in, ling in a khannelh khin vek a, huai a a louma loulingnei in a khuhta a, huan huai a a suang bangte a chimkhinta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchihlai in ka en a, hoihtak in ka ngaihtuah a: ka mu a, hilhna ka sangta hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Tomkha ihmut zeklai, neuchik lusuk, khut khep a neuchik ihmut zek.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huchibang in suamhatmi bang in na gentheihna a hongpai ding a; huan mi kigalvan bang in na taksapna hongtung ding hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah kumpipa Hezekiah mite’n a teikhiak uh, hiaite leng Solomon paunakte ahi uh.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thil im Pathian thupina ahi: himahleh thu zonkhiak kumpite thupina ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Van sandan, huan lei thukdan, huan kumpipate lungtang zonkhiak theih ahi kei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangka a kipan tuiek lamang in, huan siangsakmi ading in tuium-belsuan a hong omkhe ding:
  </para>
  <para style="p">
    <verse number="5" style="v" />Kumpipa ma a kipan gilou lamang in, huan a mangtutphah diktatna a hihkip ahi ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kumpipa ma ah malam sang ah om ken, huan mi thupite omna mun ah ding ken:
  </para>
  <para style="p">
    <verse number="7" style="v" />Hiailam ah hong paitou in, na kiang a a honchih uh a hoihzaw; na mitte’n a muhsa uh, lal ma a koih niam a na om sang in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Sual ding in man gang in kuan khepah ken, a tawp in bang hih ding ahia chih na theikei kha ding.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na inveng toh kal thu amau toh genkhawm un, huan midang thugukte pholhsuah ken!
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai za in nang a honkou kha dia, na zahlakna a kiheimang kei kha ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kituak tak a thu khat gen dangka sengsunga dangkaeng apple theite bang ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Thumangmi bilah taihilh mi pil dangkaeng bilbah leh dangkaeng hoih chi khi bang ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pawltak huan vukvot bang in, huchi in sawltak ginom amah sawlte ading in ahi; a pute kha a hihhalh ngal hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Vuah pailou meipite leh huih bang in, huchi in kuapeuh dikloutak a a thilpiakte a kiuangsak ahi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dohtheih mahmahna in vaihawmpa thuzoh ahi, huan lei nem in guh a hihtan ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Khuaizu na muta hia? Nang adia hun lel ne in: huchilou in zaw na vah ding a, na law kha ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na inveng inn ah hoh vang in; huchilou in zaw a hon chimtakin a hon mudah kha ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A inveng siatna dia zuaugen khetbuk, namsau leh thal hiam bang ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Buai hun a mi ginomlou muanzaw ha kisia, leh khepek guh kilawi bang ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi lunggim kiang a lasa tuh khovot lai a puansilh suah bang leh zu leh tangal hel bang ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Na melma a gil a kial leh nekding tanghou pia inla; huan a dang a tak leh, dawn ding tui pia in:
  </para>
  <para style="p">
    <verse number="22" style="v" />A lu tung a mei am sekkhawm lah na hi ngal a, huan Toupa’n kipahman nang a honpe ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mal huih in vuah a hon zusak paha; huchibang in migensiatna lei in hehmel a bawl hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />inn tung ning a ten, inn sung za a kiselhat numei toh tenkhawm sang in a hoihzaw hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kha dangtak adia tui votte bang in, gam gamla apan tanchinhoih ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi diktat migilou in a lam pialsak tuh tuikhuk suknit leh tuinak hihsiat bang ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Khuaizu tampi nek a hoih kei: huchi mah bang in mite ding in amau thupina zonkhiak thupina ahi kei.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amah a lungsim thuzohna bei khopi chimsa leh bang neilou bang ahi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipi lai a vuk bang leh, pawltaklai a vuah bang in, zahtakhuaina mihai ading in a kilawm kei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kawlgit a vakvai bang in, phialphiah a lenlai bang in, huchi mah bang in hamsia bulbal neilou a tangtung kei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Zepna sakol ading, kamkaihna sabiltung ading, huan chiang mihaite nungzang ading ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Mihai a haina dungzui in dawng ken, huchilou in zaw nang leng amah na bang kha ding.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mihai a haina bang in dawng in, amah kideihna ah a pilsak kha ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kuapeuh mihai khut a thukhak in amah khete a tankhia a, siatna ding a dawn hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khebai khete a kikhai nelnel: huai bangmah in mihaite kam sung a gentehna ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mihai kiang a zahna piak zaw suanglotna khau a suang gakkhawm bang ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zukhamhat khut a loulingnei bang in, huai bangmah in mihaite kam sung a gentehna ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihai leh mi vialvak guaimi, thalkapsiam midang liamsak zelmi bang ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ui amah luak lam a kiknawn bang in, huai bangmah in a haina sunzom mihai ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amah kideihna a pil mi na mu hia? Amah apan sang in mihai a kipan lametna a omzaw hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Thadah in, Lampi ah humpinelkai a om; humpinelkai kongzing ah a om, a chi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kongkhak a kopza ah a kiheizel bang in, thadaha lupna tung ah a om hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Thadah in kuangsung ah a khut a thuna; a kam a tun nawn ngapkei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thadah amah kideihna ah a san pethei ding mi sagih sang in pil a kisa zaw hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh paisuak a, amah a hilou kinakna a kihihbuai, ui a bil a man bang ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mihai in mei ekte, thal leh sihna viallot bang in;
  </para>
  <para style="p">
    <verse number="19" style="v" />mi invengte khem a, chiamnui ka hi ka hia? chi toh a kibang hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sing taksap ziak in mei a mit a: huan huauhatmi omlouhna ah, kinakna a bei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Suangkuangtheite meisumsa ading bang in leh sing mei ading bang in: kinak hat mi kilanna uangsak ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huauhatmi thute an limtak bang ahi, huan gilpi sungnungpen ah a tumsuk hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Leibel limlang tui a luan bang in lungtang gilou muk a zol in a nal!
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi huauhat in a muk in a thehdalh a, a lungtang in khemna a pai.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kilawmna thu a gen chiang in, amah um ken; a lungtang ah lah kihhuai sagih a om ngal:
  </para>
  <para style="p">
    <verse number="26" style="v" />A huatna zekhemna in kituam mahleh, khawmpite ma ah tangpi muh in a gitlouhna etsak ahi ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuapeuh khuk tou huai ah a ke ding: huan kuapeuh suang khuk, amah tung ah hong kileh ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Lei zuauthei in a hihliamsate a mudah a, maitangphat hat kam in siatna a bawl hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Zingchiang thu ah kiuangsak ken; ni’n bang a hon suahpih ding chih lah na thei ngalkei a.
  </para>
  <para style="p">
    <verse number="2" style="v" />Midang in nang honphat uhen, nangmah mah kam hilou in; mikhual in nangmah mah mukte hilou in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Suang a gik a, piaunel a gik hi; himahleh mihai lungzinna huaite gel sang in a gikzaw hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Thangpaihna a gilou, hehna a khel; himahleh thikna ma ah kua ading thei dia?
  </para>
  <para style="p">
    <verse number="5" style="v" />A langtang a salhna a guk a itna sang in a hoihzaw.
  </para>
  <para style="p">
    <verse number="6" style="v" />Lawm hon liamsaknate a ginom ahi a: himahleh melma hon tawpna zekhemna ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kha gilvah in khuaikhak a chimtak a: himahleh kha gilkial ading in thil kha chiteng a khum hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Vasa a buk a kipan a vakvai bang in, huai bang in a mun a kipan mi a vakvai hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nuhtheih leh gimnamtui in lungtang a kipaksak a: huai bangmah in mihing lawm khumna lungsimtak a thupha a hongpai ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Na lawm mahmah, na pa lawm mangngilh ken; na tuahsiatna ni’n na unau inn ah hoh ken: inveng nai om gamlapi a unau sang in a hoih zaw hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka tapa, pil in, ka lungtang kipaksak in, kei hontaite ka dawn theihna ding in.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi pilvang in hoihlou a mu a, a bu hi: himahleh mi mawl in a awlmoh kei a, a thuak loh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mikhual ading mawhkhu dia om puansilh la in; huan numei lamdang adia mawhkhu dia om chiamkhamna ding in len in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kuapeuh aw ngaihtak a, zingsang a beltak a thou a, vualzawl, amah ading in hamsia a sim ahi ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vuahchin ni a vuah zu leh numei kinak hat a kibang:
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuapeuh amah khou huih khou bang ahia, khut taklam a sathau ham bang ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Sik in sik a hiamsak bang in mihing in a lawm mel a hiamsak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuapeuh theipi kung kem in huai a a gah a ne ding; huan kuapeuh a pu ngak zahtak in a om ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tui a maitang in maitang a muh bang in, huai mah bang in mihing lungsim ah mihinna a kimu hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sheol leh Abaddon a lungkim ngeikei ua, huan mihing mitte a lungkim ngeikei uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huansiangna bel dangka ading ahi, huan meipi dangkaeng ading, huchi bangmah in mihing phatna a ze-et in a om hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihai sum sung ah buh taisate lak ah suk in su mahle chin, huchipiin leng amah a kipan in a haina a paimang kei lai ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na belamhonte omdan thei ding in thanuam in, na ganhonte hoihtak in en in:
  </para>
  <para style="p">
    <verse number="24" style="v" />Hauhsaknate tangtawn a ding ah kei a; lallukhu in suan tengteng a daihzou hia?
  </para>
  <para style="p">
    <verse number="25" style="v" />Buhpawl puak in a om a, huan loupa nou a kilang, mualte a loupate a ki lakhawm ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Belamnoute’n na puansilh ding honpe ding, huan kelte’n na lou man ding:
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan na an ding in, na inkawte an ding in kel nawitui kiching a om ding hi; huan na nungakte vakna ding in.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Migilou kuamah delhlouh in a tai: himahleh mi diktat humpinelkai bang in a hangsan hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Gam tatlekna ziak in thunei mi tampi om a: himahleh theisiam leh theihna nei mite ziak in huai gam bel suk vaiveng theih ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Taksap hau mi genthei nuaisiahte zaw lou susia vuahpi zu bang ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amau dan mangngilhte’n migilou a phat ua: himahleh huchibang dan zuite amau tung ah a thangpai uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi hoihlou in vaihawmna a theisiam kei: himahleh amau Toupa zongte’n thil tengteng a theisiam uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lampite a hoihlou mihau sang in a thutakna a om mi genthei a hoih zaw hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kuapeuh dan zui tapa pil ahi: himahleh kuapeuh anhai mite toh kithuah in a pa a zumsak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Kuapeuh a neih a nou leh a pung a tamsak in mi genthei hehpihmi amah ding in a lakhawm hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kuapeuh dan zalou ding a a bil kaihei a thumna nasan kihhuai ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kuapeuh lampi gilou a midik lamhaihsak, amah kawkhuk mahmah ah a kelut ding hi: himahleh mi hoihkim in gou hoih a luah ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mi hausa amah ngaih in a pil a; himahleh mi genthei theihsiamna nei in amah a zongkhia hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Mi diktat a vualzoh chiang in, thupina lian a om: himahleh migilou a thoh chiang in, mite a bu uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kuapeuh a tatlekna khuh a lohching kei ding: himahleh kuapeuh huaite thupha tawi a mangngilh in chitna a mu ding uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Lauthei gige mi a hampha hi: himahleh a lungtang saksak gige siatna ah a ke ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Humpinelkai humham leh vompi hawk bang in; huai mah bang in mi gentheite tung a vaihawmmi gilou ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vaihawmmi theihsiamna tasam nuaisiah hatmi thupi ahi: himahleh kuapeuh huaihamna hua in a nite a sausak ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mi kuapeuh mi himhim sisan a dim kawkhuk sung ah a tailut ding; kuapeuh in len kei hen.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuapeuh tangtak a om suahtaksak in a om ding: himahleh kuapeuh a lampite a hoihlou a pukzaw ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kuapeuh a gam leilet in tanghou tampi a nei ding: himahleh kuapeuh mi bangmahlou nungzui in gentheihna kiching a nei ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mi ginom in vualzawlna a hau ding: himahleh kuapeuh hau ding a kintat gawtlouh in a omkei ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mite deihsaktuam neih a hoih kei: tanghou them ziak in mi a talek ding leng ahi sam kei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kuapeuh deihgawl sumchit hauhsakna delh in a kinoh a, huan a tung ah taksapna a hongtung sin chih a theikei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuapeuh mi deihsakna a sal in a lei a maitangphathatmi sang in deihsakna tamsem a nung in a mu ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh a nu hiam a pa hiam lok a, tatlekna ahi kei, chi mi zaw; amah mah hihsemi kithuahpih ahi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuapeuh lungsim duhgawl in kinakna a tokthou hi: himahleh kuapeuh Toupa a muanna koih thausak in a om ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kuapeuh amah lungtang muang mihai ahi: himahleh kuapeuh piltak a om, suahtaksak in a om ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuapeuh genthei kiang a pia a tasam kei ding a: himahleh kuapeuh a mitsel in hamsia tampi a nei ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Migiloute a lal chiang un, mite a kibu ua: himahleh a manthat chiang un, mi diktat a pung hi.
  </para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kuapeuh salh a om nak a, genhak teitei hih damna omlou in thakhat in a kise ding hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mi diktatte a pun chiang un, mite a kipak uh: himahleh migilou in vaihawmna a puak chiang in, mite a mau uh.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kuapeuh pilna it in a pa a kipaksak a; himahleh kuapeuh kizuakte kithuahpih in a sum a mawk zatbei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kumpipa’n vaihawmna in gam a hihkip a: himahleh kuapeuh thilpiak phut teitei in a hihsia hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mi invengte maitangphat in kalsuante ading in len a zaksak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi hoihlou tatlekna ah thang a om: himahleh mi diktat in la a sa a, a kipak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mi diktat in mi genthei thu a theihpih a: migilou in huai thei ding in theihsiamna a neikei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi simmawh hatte’n khopi a hal ua: himahleh mipilte’n thangpaihna a heimang uh.
  </para>
  <para style="p">
    <verse number="9" style="v" />Mi pil in mihai a kiselpih leh, a heh hiam a nui hiam, khawlna a omkei ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sisan duh a dangtak in amah mi hoihkim a mudah: huan mitang ahihleh, a hinna a zong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mihai in a hehna tengteng a gen a: himahleh mi pil in a genkhe kei a, a khemdai hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Vaihawmmi’n zuauthu a ngaihkhiak leh, a sikha tengteng gilou ahi uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mi genthei leh nuaisiahhat a kituak khawm ua: Toupa’n a nih tuak uh mitte a sukvaksak hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kumpipa ginomtak gentheite ngaihtuah, tangtawn in a mangtutphah a kip ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Chiang leh salhna in pilna a pia: himahleh naupang amah thuthu a omsak in a nu ading in zumna a omsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Giloute a pun chiang un, tatlekna a pung hi: himahleh mi diktat in a pukna uh a en ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Na tapa bawlhoih in, awlna a honpe ding hi; ahi, na kha ading in nuamna a honpe ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mengmuhna omlouhna ah, mite a zautat uh: himahleh kuapeuh dan zui, aman nuam a sa hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sikha thute a bawlhoih in a omkei ding: thei mahleh a limsak kei ding.
  </para>
  <para style="p">
    <verse number="20" style="v" />A thute a man gang mi na mu hia? Amah sang in mihai a kipan in lametna a omzaw hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kuapeuh a naupan a kipan a a sikha nuamtattak a kem in a tawptawp in amah tapa honghi in a nei ding hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi heh in kinakna a tok thou a, huan mi thangpai in tatlekna a hau hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mihing kisaktheihna in amah a lainiam ding: himahleh kuapeuh lungsim kiniamkhiak in pahtawina a mu ding.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh gutami toh kithuah in amah kha a mudah hi: nakpitak a ngetna a za a huan bangmah a gen kei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihing kihtakna in thang a hontawi a: himahleh kuapeuh Toupa a muanna koih a bit ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Mi tampi’n vaihawmmi deihsakna a zong ua: himahleh mihing vaihawmna Toupa’n a kipan a hongpai ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mi diklou mi diktat ading in kihhuai ahi: huan kuapeuh lampi a tang migilou ading in kihhuai ahi.
  </para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />Massa mi Jakeh tapa Agur thute: Huai mi in Ithiel kiang ah, Ithiel leh Ukal kiang ah:
  </para>
  <para style="p">
    <verse number="2" style="v" />Chihtaktak in kuamah sang in ka haizaw a, mihing theihsiamna ka neikei:
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilna ka sin naikei a, Mi Siangthou theihna leng ka neikei, a chi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Van ah kua a kahtouta in a hong kumsuk a? A khuttum sung ah kua’n huih a lakhawmta a? A puansilh in kuan tuite a tun a? Lei tawpnate kuan a hihkipta a? A min bang ahia? Huan a tapa min bang ahia, na theih leh?
  </para>
  <para style="p">
    <verse number="5" style="v" />Pathian thu chiteng ettel ahi: amah a muangte ading in lum ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A thute ah behlap ken, a honsal dia, zuauthei a muh in na omkha ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Thil nih k’on ngen: ka sih ma in huaite hon kitheihmohbawl ken:
  </para>
  <para style="p">
    <verse number="8" style="v" />Bangmahlou leh zuau kei a kipan gamlapi ah suan in: Gentheihna hiam hauhsaknate hiam hon peken: kei adia kiphamoh an in honvak in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchilou in zaw ka kham in, nang k’on kitheihmohbawl in, Toupa kua ahia? Ka chi kha ding hi. Ahihkeileh, ka genthei in, ka gu in, ka Pathian min thanghuaitakin ka bawl kha ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A pu kiang ah sikha gense ken, huchilou in zaw nang a hon hamsiat dia, mawhtansak in na om ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pa uh hamsiat suan khat a om a, a nu uh vualzawl lou.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amau mitte a siangthou suan khat a om a, ahi a lah a nitna ua kipan silsiang louh ahi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Suan khat a om a, Aw a mitte uh sanghah hina e: huan a mitkhu vunte sansak in a om hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A hate uh namsau bang, leh a hate uh temta bang suan khat a om uh, lei a kipan a mi genthei leh, tasamte mite lak a kipan a nekbeina ding in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Vot in tanu nih a nei a, honpia in, honpia in, chi in kikou ua. Thil thum lungkimsak theih ngeilouh a om uh, ahi, li, Hun e, chi lou:
  </para>
  <para style="p">
    <verse number="16" style="v" />Han leh sul hut; lei tui a hih lungkima omlou; huan mei, hun e chi lou.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mit a pa nuihsan leh, a nu thuman musit, guam va-akte’n a tawm ding ua, muvanlai noute’n a ne ding uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Thil thum kei ading a lamdang lua a om ua, ahi, ka theihlouh li:
  </para>
  <para style="p">
    <verse number="19" style="v" />Huihkhua a muvanlai lampi; suangpi tung a gulpi lampi; tuipi lak a long lampi leh pasal nungak toh a lampi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai mah bang in angkawmhat numei lampi ahi; a ne a, zapi in a kam ka a, gitlouhna ka hihkei, a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Thil thum ziak in lei a ling a, huan thil li a puak zohlouh ziak in;
  </para>
  <para style="p">
    <verse number="22" style="v" />Sikha kumpipa hong hihlai leh mihai ankham lai;
  </para>
  <para style="p">
    <verse number="23" style="v" />Numei huathuai tak in pasal a neih a, sikha nungak in a pi a luah in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Leitung ah a neu thil li a om ua himahleh a pil mahmah uh:
  </para>
  <para style="p">
    <verse number="25" style="v" />Miksite hatlou ganhing hon ahi ua, himahleh nipi lai in a nekding uh a sutuah ua;
  </para>
  <para style="p">
    <verse number="26" style="v" />Kawlsazawte hatlou pawl tak ahi ua, himahleh suangpi heng ah a inn a bawl uhi:
  </para>
  <para style="p">
    <verse number="27" style="v" />Khaukhupte’n kumpipa a neikei ua, himahleh a honhon in avek un kilem in a pai uh;
  </para>
  <para style="p">
    <verse number="28" style="v" />Inhikte na khut a na tawi theih ahi ua; himahleh kumpipate inpite ah a teng uh.
  </para>
  <para style="p">
    <verse number="29" style="v" />A paichiang ua thupi thil thum a om ua, ahi, a pai chiang ua thupi, li:
  </para>
  <para style="p">
    <verse number="30" style="v" />Humpinelkai, gamsa laklak a hatpen pen, bangmah ma ah a kiheimang kei hi;
  </para>
  <para style="p">
    <verse number="31" style="v" />Kidouna sakol; keltal leng; huan kumpipa, a mite ma a pai.
  </para>
  <para style="p">
    <verse number="32" style="v" />Na kiletsak a haitak a na gamtat leh, ahihkeileh ngaihtuahna gilou na neih leh, na kam tung ah na khut koih in,
  </para>
  <para style="p">
    <verse number="33" style="v" />Nawitui pei in nawitui dat a omsak a, nak hekin sisan a suahkhe sak: huchi mah bang in thangpaihna paisuak in kilaina a omsak hi.
  </para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kumpipa Lemuel thute; a nu’n amah a thuhilh thu:
  </para>
  <para style="p">
    <verse number="2" style="v" />Bang ahia, ka tapa? Bang ahia, Aw ka sul tapa? Huan bang ahia, Aw ka thuchiam tapa?
  </para>
  <para style="p">
    <verse number="3" style="v" />Na hatna numeite kiang ah pe kenla, kumpipate hihsete kiang ah leng na lampite pe sam ken.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kumpipate ading ahi kei, Aw Lemuel, uain dawn kumpipate ading ahi kei; Zu khauh koi a om ahia, chih leng lalte ading ahi sam kei.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchilouin zaw a dawn un, dan a mangngilh un, gimthuak kuapeuh vaihawmna a kaikawi kha ding uh.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mangthang dia mansa kiang ah zu khauh pia un, kha a haksa sa kiang ah uain:
  </para>
  <para style="p">
    <verse number="7" style="v" />Dawnsak unla, a gentheihna mangngilh sak un, a haksatna theigige nawn kei hen.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pautheilou ading in na kam ka in, sukgawpa om mi huchibangte tengteng thu ah.
  </para>
  <para style="p">
    <verse number="9" style="v" />Na kam ka inla, diktak in vaihawm in, gentheite leh tasamte kiang ah vaihawmsak in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Numei hoih kua’n a mu dia? A man rubi suang tungpek ah a om hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A pasal lungtang in amah a muanga, punna taksapna a neikei ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A damsung niteng in amah a hihhoih a, a hihse kei.
  </para>
  <para style="p">
    <verse number="13" style="v" />Samul leh jija a zong a, a khut in kilawptakin na a sem hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sumsinmi longte bang ahia: gamla a kipan in a an a hontawi a.
  </para>
  <para style="p">
    <verse number="15" style="v" />Zan ahihlai in leng a thou a, a sikhanute kiang ah a sep ding uh, a inkawte an a pia hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Lou a ngaihtuah a, a lei a; a khut a gahte in grephuan a bawl hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hatna in a kawng a gak a, a khutte a hatsak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A sumsinna vante a phatuam chih a mu a; zan in a khawnvak a mit kei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A khutte muikhut ah a nga a, a khutte mui ah a nga hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gentheite lam ah a khut a zak a; ahi, tasamte lam a sawk hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A inkawte ziak in vuk a kihta kei a; a inkawte tengteng puan sanau in a kithuam uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Puanphah zehoih mantam a kibawla; a puansilh puanmalngat leh san-dup ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kongpite a gam a upate lak a a pasal a tut chiang in mite’n a theituam in a om hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Puan hoih puansilh a bawl a, a zuak a; sumsinmi kiang ah kawnggakte a pekhia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hatna leh zahtakna a puansilh ahi; huan hun hongtung ding a nuihsan hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pilna in a kam a ka a; siamna dan a lei ah a om hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />A inkawte lampi hoihtak in a en a, huan thadahna tanghou a nekei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A tate a thou ua, amah nuamsa a chi uhi; a pasal in leng, amah a phat hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tanu tampite’n hoihtak in a hih ua, himahleh nang zaw amaute tengteng na khup vek hi, chi in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Deihsakna khemna in a dim a, huan kilawmna bangmahlou ahi: himahleh numei Toupa laudan siam, phat in a om ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A khut a gahte amah pia un; huan kongpite ah a thilhihte’n amah phat hen.
  </para>
</usx>
