<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="ACT" style="id">Nasepte</book>
  <para style="h">Nasepte</para>
  <para style="toc1">Nasepte</para>
  <para style="toc2">Nasepte</para>
  <para style="mt">Nasepte</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Theophilus aw, tuma a ka laigelh ah, Jesu thilhih leh a thuhilh pattung tengteng thu ka gelh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kha Siangthou tawn a a sawltak telte kiang a thupiak tampi a piakkhit a van a pitouh a a omni tan a thute ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai sawltakte kiang ah gimna a thuaknung in theihna zuaulou tampi in hing in a kimusak a, ni sawmli hial a kiang uah a kilak a, Pathian gam thu a gen hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a omkhawm uh a kithuahpih a, “Jerusalem khua paisan kei un, Pa thilchiam ka gen na zak uh ngak un, a chi chiltel hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Johan in tui in a baptist zel a, himahleh, ni sawtlou nung in Kha Siangthou a baptist in na om ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan amau a hong kikhop un a kiang ah, “Toupa, tuin hia Israelte kiang a lalgam na piaknawn ding?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman a kiang uah, “Pa in a hun leh a ni amah thuthu a om dia a seh, nou theih ding ahi kei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh, Kha Siangthou na tung ua a hongtun chiang in thilhihtheihna na nei ding uh; huchi in, Jerusalem ah, Judia leh Samaria gam teng leh kawlmong pha in ka theihpihte na hi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai thu a genkhit in a muh laipi un, van a pitouh in a omta a, meipi in a muh phaklouh uah a pitouta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan a paitouh lai a vanlam a et nilouh lai un, ngai in, mi nih, puanngou silh in, a kiang uah a hongding uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai mite’n, “Galili gam a mite aw, bangdia vanlam en a ding? Hiai Jesu na kiang ua kipan a van a pitouha om, van a a paitou na muh bang un amahmah a hong kiknawn ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Olive tang a chih ua kipat Jerusalem khua ah a kiknawnta uhi. Huai tang Jerusalem khaw kiang ahi a, khawlni a hohna hunlel ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a lut un, a omna dantan tungnung uah a paitou ua, Peter leh Johan, Jakob leh Andru, Philip leh Thomas, Bartholomai leh Matthai, Alphai tapa Jakob, Simon Zelot Pawl a leh Jakob tapa Judas toh ahi uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai tengteng numei kuate hiam leh Jesu nu Mari toh, Jesu unaute toh, lungsim munkhat a, phatuamngaitak a thum in a om nilouh uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan huai ni’n unaute lak ah Peter ading a, avek un za leh sawmnih ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Unaute aw, Kha Siangthou in, David kam a, Jesu mante makai Judas thu a genkholh Laisiangthou thu a hongtung ding him ahi.”
  </para>
  <para style="p">
    <verse number="17" style="v" />Amah zaw i lak ua sim tel ahi a, hiai nasepna ah tan leng a neisam hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh huai min a khelhna man in mun khat a lei a, a khup in a kia a, a lai in a puakkham a, a gil tengteng a lawtvek hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai thu Jerusalem khua a omte tengteng in a naza uhi; huchi in huai mun amau pau in, Akeldama, a chi ua, huai Sisan Mun, chihna ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Sam Laibu ah hiai thu gelh ahi. ‘A omna mun hihgam in om hen, asung ah kuamah omkei hen,’ ‘huan a heutu hihna midang in tang hen’ chih ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Toupa Jesu i lak ua lutzel pawt zel a a omsung teng a,
  </para>
  <para style="p">
    <verse number="22" style="v" />Johan baptisma nungsiah, i lak ua kipan van a pitouh a a om ni tan hiai hon kithuahpihpihte lak a mi khat a thohnawnna theihpih ding in a om ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan mi nih a sepkhia ua, khat Joseph Barnaba ahi a, a min khem Justa leh midang khat Mathia ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a thum ua, “Toupa, Nang, mihing tengteng lungtang thei, hiai nihte a kua zaw ahia na tel honhilh in,
  </para>
  <para style="p">
    <verse number="25" style="v" />Judas in amah omna a pai ding in hiai nasepna leh sawltakna a kiaksan sik ading in” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan ai a sansak ua, a aisan uh Mathia tung ah a tu a; huchi in amah sawltak sawmlehkhatte lak a sim tel ahita hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pentikost ni a hongtun in, avek un mun khat ah a omkhawm uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thakhat in van a kipan ging huihpi nung bang in a hongom guih a, huchi in huai in a tutna inn uh a hihdim vekta hi,
  </para>
  <para style="p">
    <verse number="3" style="v" />leite amah leh amah mei bang a kihawm in, a lutung uah a hong tuang chiat hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in avek un Kha Siangthou in a luahdimta a, Kha in hihtheihna a piak a a pausak bangzel in pau dang in a pauta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan van nuai namchih lak a kipan Pathian limsak Juda kulmutte Jerusalem khua ah a om uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan ging husa a zaktak un mipi a hong kikhawm ua, michih in a pau uh amau pau chiat a a zak ziak un a lungsim uh a hong buai hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan avek un a mangbang ua, lamdang a sa mahmah uhi, En dih uh, hiai a pau tengteng Galili gam a mi ahi kei ua hia?
  </para>
  <para style="p">
    <verse number="8" style="v" />Bangchi’n ahia i vek ua pianpih pau chiat a i zak uh?
  </para>
  <para style="p">
    <verse number="9" style="v" />Eite Parthai nam, Medai nam, Elamitai nam; khenkhat Mesopotamia gam a om, Judia gam a om, Kapadosia gam a om, Pento gam a om, Asia gam a om,
  </para>
  <para style="p">
    <verse number="10" style="v" />Phrigia gam a om, Pamphilia gam a om, Aigupta gam a om, Kurini khaw kiang a Libia gam a om i hi ua; khenkhat Rome apan mikhualte, Judate leh a phungkaite utoh i hi ngal ua;
  </para>
  <para style="p">
    <verse number="11" style="v" />Khenkhat Krit tuikulh leh Arab gam a i hi ngal ua; himahleh, Pathian thilhih thupite a gen uh eimau pau chiat in i za ngal ua! a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan avek un lamdang a sa mahmah ua, a khiakna dan theilou in, “Hiai bangchidan ahia?” a kichi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khenkhat in “Uain thak a kham ua hi” chi in a nuihsan uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh Peter in sawmlehkhatte toh ding khawm in, aw ngaihtak in a kiang uah a gen a, nou Judia gam a mite aw, nou Jerusalem khua a om tengteng aw, hiai thei unla, ka thu leng ngaikhia un,
  </para>
  <para style="p">
    <verse number="15" style="v" />Hiaite na gin bang un a khamkei uh, dak thumna hun ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiaite zawlnei Joel in a gen ahizaw:
  </para>
  <para style="p">
    <verse number="17" style="v" />‘Pathian in, ni nanungte ah hichi ahi ding, mi tengteng tung ah ka kha ka sungbaw ding a; na tapa leh na tanute’n ka thu a hilh ding uh; na tangvalte un kilaknate a mu ding ua, na putekte un mang a nei ding uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ahi, huai ni’n ka sikhapate, ka sikhanute tung ah leng ka Kha ka sungbaw ding a, ka thu a gen ding uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan tunglam van ah thillamdang nuailam lei ah chiamtehna ka musak ding a; sisan, mei, meikhu hu toh:
  </para>
  <para style="p">
    <verse number="20" style="v" />Ni mial a suak ding a, kha sisan a suak ding, Toupa ni thupitak leh lauhuaitak a hongtun ma in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan hichi ahi dia, Toupa min lou peuhmah hotdam in a om ding hi.’
  </para>
  <para style="p">
    <verse number="22" style="v" />“Nou Israel mite aw, hiai thu za un: Nazaret Jesu, Pathian in amah zang in na lak uah thil thupite, thillamdangte, chiamtehnate a hih in a hon theichiansak hi; nou ngei in tuate na theichian uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai mi Pathian vaihawm tel leh theihkholh bang in na mansak ua, nou migiloute khut in Kros ah kilhden in na hihlumta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amah, Pathian in sihna thuaknatna phelsak in, a kaithouta a; amah sihna letden vual a hihlouh ziak in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan David in a thu a gen a, ‘Ka ma ah chiklaipeuh in Toupa ka mu gige hi. Ka mangbat louhna ding in ka taklam ah a om hi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Huaiziak in ka lungtang a nuam a, ka lei leng a kipak a, ka sa lamentak in a om behlap lai hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Misi khua ah ka kha na nuse kei ding a, muatna na Mi Siangthou na musak sam kei ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nangman hinna lampite n’on theisak a; nangman na mel in kipak in n’on hihdim ding,’ chi in.
  </para>
  <para style="p">
    <verse number="29" style="v" />“Unaute aw, chikhahpa David thu laulou in na kiang uah ka gen thei hi; amah zaw a si a, vui leng a vuikhin ua, a han leng tutan in i kiang ah a omlai hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amah tuh zawlnei ahi a, Pathian in a khal a mi kuahiam sadan a a chite lak a mi khat Khrist mangtutphah a tu ding in a kaithou ding chih kichiam in a gen chih a thei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in huai tuh a theihkholh him ziak in Khrist thohnawn ding thu a gen hi, ‘Misi khua a nutsiat in a omkei a, a luang leng a muat sam kei hi,’ chi in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Pathian in Jesu a kaithouta chih theihpihte i vek un i hi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathian khut taklam ah pahtawi in a om a, Kha Siangthou chiam Pa kiang a kipan in a mu a, na muh uh leh na zakte uh a hon sunbuak ahi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />David zaw van ah a kahtou kei, amah ngei in, ‘Jehovah in ka Toupa kiang ah,
  </para>
  <para style="p">
    <verse number="35" style="v" />“Na melmate na khepek ngakna dia ka bawl masiah, Ka taklam ah tu kinken in” a chi a na chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in Jesu, na kilhden uh, Pathian in Toupa leh Khrist hi khawm in a bawlta chih Israel inkuan chih in kichiantak in thei uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan huaithu a zak un a lungtang ua sutbang a honghi ua, Peter leh sawltakdangte kiang ah, “Unaute aw, bangchi’n ka hihta ding ua?” a chi ua.
  </para>
  <para style="p">
    <verse number="38" style="v" />Peter in a kiang uah, “Na khelhnate uh ngaihdamna ding in lungsim khek unla, Jesu Khrist min in baptisma tangchiat un; huchi in Kha Siangthou thawnpiak na tang ding uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A chiam nou ading, na tate uh ading, gamlapi a mi tengteng ading leh Toupa i Pathian in a kiang a a sap peuhmahte ading ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan thudang tampi in a hilhchian a; tulai khang thulimloute lak ah kihumbit un, chi in a hanthawn hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan a thu zuipeuh in baptisma a tang ua, huai ni’n mi sang thum vel behlap in a om uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan sawltakte thusinsakte sin in, kithuah in, tanghou balkham in, thum in, phatuamngaitak in a omkhawm uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan michih in a lauta ua: sawltakte’n thillamdang leh chiamtehna tampi a hih uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />A gingta peuhmah in bangkim a kikop khawm uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />A goute uh, a thilneihte uh a zuak ua, a deihdong chinglel chiat in avek ua kiang ah a hawmzel uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan niteng in, lungsim munkhat in, Pathian biakin ah phatuamngaitak in a om zelzel ua, a innte uah leng tanghou balkham in, nuam leh lungkim in, a an uh a ne zel uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Pathian a phat ua, mi tengteng deihsak in a om uhi. Huan a hotdam lel peuhmah Toupa’n niteng in a kiang uah a behlap sakzel hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Peter leh Johan, dak kua na ah thum hun lai in Pathian biakin a lut ding in a hohtou uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Piching kuahiam a piantung apat khebai a hon zawng ua, biakin a lutte kiang a khutdoh ding in, biakin kongkhak, Kilawm, bul ah niteng in a lumsak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Peter leh Johan Pathian biakin a lutding mu in khut a doh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Peter in amah a en gegu a, Johan in leng; huan Peter in, “Hon en in” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Aman amau apan banghiam muh a lamen a, a enpah hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh Peter in, “Dangka leh dangkaeng bangmah ka neikei; himahleh ka neihsun ka honpe ding, ‘Nazaret Jesu Khrist min in khe in paita in’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a khut taklam a len a, a kaithouta a; huchi in thakhat in a khete leh a siakmit guhte a hong hatpah hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah a tawmtou a, ading a, khe in a paipah hi. Khe a paipai, diangdiang leh, Pathian phat kawm in biakin ah a lut hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan khe a pai leh Pathian a phat mi tengteng in a muh un;
  </para>
  <para style="p">
    <verse number="10" style="v" />Biakin Kongkhak Kilawm bul a khutdoh a tupa ahi chih a thei ua; a tung a thiltung lamdang a sa mahmah ua, a buaipih uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan aman Peter leh Johan a letlai in, mi tengteng in lamdang a sa mahmah ua, inlim Solomon a a chih uah a kiang uah a hong taikhawm uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Peter in huai a muh in, mite a houpih a, “Nou Israel mite aw, hiaite bangdia lamdang sa? Koumau thilhihtheihna leh Pathian ka limsak ziak ua amah ka paisak bang zen ua bang a chia hon en gige?
  </para>
  <para style="p">
    <verse number="13" style="v" />Abraham, Isak, leh Jakob Pathian, i pipute Pathian in, a sikha Jesu a pahtawita ahi; amah na mansak ua, Pilat in khah a tup in leng a ma ah na ut kei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mi Siangthou leh Dik na deihkei ua, tualthatpa na kiang ua piak na ngen zawta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Hinna Siampa tuh na that ua; himahleh Pathian in amah misi lak apat a kaithou nawn a; huai theihpihte ka hi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amah min gintak ziak in a min in hiai mi na muh uh leh na theih un a hihhatta hi; Amah ziak a ginna a hongom in na vekua mitmuh in a hihdam vilvelta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Himahleh unaute aw, na heutute un a theihlouh ziak ua a hih bang un, na theihlouh ziak un hiaite na hih uh ahi chih ka thei uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh Pathian in zawlnei tengteng kam in, Khrist in gim a thuak ding thu a theikholsak hi, huchibang in a tungsak zawta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaiziak in na khelhna te uh thaimangna ding in kisik unla, kihei nawn un, huchi in Toupa apat halh hun hongtung ding hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Khrist Jesu nou adia a seh mah leng, a honsawl ding hi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh Pathian in thil bangkim a bawlhoih hun a hongtun masiah amah van a a om ding him ahi; huai bawlhoih ding thu Pathian in leilung piantung a kipan a zawlnei siangthoute kam a a gen khit ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosi ngei in Toupa Pathian in keimah a honbawl bang in na unaute lak ah zawlnei khat a hon bawlsak ding; aman thu tengteng na kiang ua a gen peuh na ngaihkhiak sak ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan mi kuapeuh huai zawlnei thu ngaihkhiak saklou tuh, milak a kipan a hih mangthang ahi ding, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ahi, Samuel om a kipan zawlnei tengteng, a nung ua mite toh, thugen peuhte’n, tulai tanchin a genkhol uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Noute zawlneite leh thukhun tate neive ua; Pathian in Abraham kiang ah, Na suante ziak in khovel a namchih a vualzawl ding uh, chi in, na pipute uh kiang ah a chiam hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pathian in a Tapa Jesu, misi lak a kipan kaithou in, na khelhnate uh kiheisanna ding leh kisikmite vualzawl ding in noumau kiang ah a honsawl masapen hi” a chi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Peter leh Johan in mite kiang a thu a genlai un, siampute, biakin heutute leh Saddukaite a kiang uh a hongtung guih ua;
  </para>
  <para style="p">
    <verse number="2" style="v" />mite a sinsak uh leh Jesu ziak a misi lak a kipan thohnawnna thu a hilh ziak un a lungkimkei uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan a man ua nitaklam a hih ziak in a zingsang pha in suangkulh ah a khumta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh thungaikhete a khen tampite’n a gingta ua; a tamlam uh piching ngen leng sang nga vel a ching uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A zing in a heutute uh, upate, laigelhmite,
  </para>
  <para style="p">
    <verse number="6" style="v" />Siampu lianpen Ana leh Kaiapha, Johan, Alexander, siampu lianpen tanau tengtengte leng Jerusalem khua ah a omkhawm uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Peter leh Johan a lai ah a dingsak ua, “Bang thilhihtheihna in ahia, kua min in ahia hiai na hih uh?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Peter Kha Siangthou in a dim a, a kiang uah, “Nou mipite vaihawmte leh Israel upate aw,
  </para>
  <para style="p">
    <verse number="9" style="v" />hiai mi damlou tung a na hoih ka sep thu uah, hiai mi bangziak in ahia a hong damtak chi in tuin salh leh dot a om ka hi umaw;
  </para>
  <para style="p">
    <verse number="10" style="v" />Nou tengteng leh Israel mi teng in leng thei hen, Kros a Nazaret Jesu Khrist na kilhden uh, Pathian in misi lak a kipan in a kaithou nawn a, amah min ngei in hiai mi hiai ah na ma uah dam in a dingta ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Nou inlammite aw, na suangpaih uh, a ning a, suang phatuampen a hong hita, huai amah ahi a chi uhi.’
  </para>
  <para style="p">
    <verse number="12" style="v" />Midang kuamah kiang ah hotdamna a omkei, van nuai a mihing sak lak ah, hon hondam ding min dang a omkei” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Peter leh Johan hansan dan a muh un, laisiamlou mi leh namtom maimai ahi uh chih a theih un lamdang a sa mahmah uhi; huchi in Jesu kiang ah a omkhinta uh chih a thei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan mi a hihdam uh a kiang ua ding a muh un, bangmah a gense thei tuankei uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in a vaihawmna ua pat a a paituamsak nung un, a kihou ua,
  </para>
  <para style="p">
    <verse number="16" style="v" />“Hiai mite bangchi’n i hihdia? Thillamdang minthang a hih uh Jerusalem khua a om tengteng in teltak in a theita uh; en leng i sel thei tuankei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh midang kiang a a than semsem louhna ding un tunung siah kuamah kiang ah hiai min a thu a genlouhna ding un i vau ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in amau a sam ua, Jesu min a thugen hetlou ding leh hilh hetlou ding in a chi chiltel uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh Peter leh Johan in a kiang uah, “Pathian mitmuh in Pathian thuman sang in noumau thuman a dikzaw hia ngaihtuah un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kou zaw ka thilmuh uh leh ka zakte uh genlou in ka om theikei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan amau tuh a vau semsem ua, a khahta uh, mipi ziak in gawtna lemtang a mu kei uhi; a thilhih ziak un mi tengteng in Pathian a pahtawi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Thillamdang a a hihdam uh kum sawmli sang a tamzaw ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan Peter leh Johan a pawt un amau lawmte kiang ah a vahoh ua, siampu liante leh upate’n a kiang ua a gen peuh uh a hilh vek uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in a ngaikhete’n a kituak in aw ngaihtak in Pathian kiang ah “Toupa, nang tuh van leh lei, tuipi leh asung a omte tengteng Bawlpa na hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Nang Kha Siangthou in, ka pu uh na sikha David kam in, hiai thu na gen ahi: ‘Jentelte bangchi’n eita a heh uh? Namchih in bangchi’n ahia thil phatuamlou a ngaihtuah uh?
  </para>
  <para style="p">
    <verse number="26" style="v" />Khovel kumpipate ading ua, heutute leng a kikhawm ua, Toupa leh a Khrist kalh in,’ chi in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiai khua ah na sikha siangthou, na thaunilh Jesu tung ah, Herod leh Pontia Pilat toh, Jentelte leh Israel mite toh a kikhawmta uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Na khut leh na lungsim a hongtung ding a na sehkholh peuh hih ding in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in tun ah, Toupa, a honvau dan uh ngai in; na sikhate kiang ah na thu hangsantak a gen theihna pia in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Damsak ding a na khut na zak a, na sikha Jesu min a chiamtehnate leh thillamdangte hih ahihlai in” a chi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan a thum khit un a omkhawmna uh a hongling a, avek un Kha Siangthou in a dim ua, hangsantak in Pathian thu a hilhta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan a gingta mipite lungsim munkhat leh ngaihtuah munkhat in a om ua: a lak ua khat in leng a thil thilneihte, kei a tuam ahi, a chi kei ua, thil tengteng a kikop uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sawltakte’n thilhihtheihna thupitak in Toupa Jesu thohnawn thu a hilhhilh ua; avek ua tung ah hehpihna thupitak a om hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan a lak uah leng tasam kuamah a omkei uh; gam leh inn nei peuh in a zuak ua, a thilkhotte uh a man a hontawi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan sawltakte khe bul ah a koih zel ua, amau deihdong ching hun chiat in a hawmchiat zel uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan Levi chi a mi khat, Kupra tuikulh a kipan, Joses, sawltakte’n Barnaba a chih uh, huai min omdan, “Khamuanna Tapa” chihna ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hiai mi in a gam neih a zuak a, a man a hontawi a, sawltakte khebul ah a koih hi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Himahleh mi khat a min Ananias, a zi Sapphira toh a om ua; Ananias in a neih uh a zuak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan a zi theih in a man a khen a im a, a khen tawi in sawltakte khebul ah a koih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Himahleh Peter in, “Kha Siangthou khem ding leh gam man a khen im ding in bangdia Setan in na lungtang hihkhauh ahia?
  </para>
  <para style="p">
    <verse number="4" style="v" />A omlai teng nang a ahi gige ka hia? Na zuak nung in leng na thuthu in a om ka hia? Bang a chia hiai thute na lungtang a ngaihtuah? Mihing khem na hi kei a, Pathian khem na hi zaw” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Ananias in huai thu a zaktak in a puk a, a sita hi; a zakha peuh in a lau mahmah uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Tangvalte a thou ua, tuam in a zawngkhia ua, a vuita uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dakkal thum ding hiam nung in, thil omdan theilou in a zi a honglut hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Peter in a kiang ah, “Honhilh in, gam hiai zahphet in maw na zuak uh?” a chi hi. Aman “He, hiai zah phet in ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Peter in a kiang ah, “Bang a chia Toupa Kha ze-et ding a kithutuak na hi ua? Ngai in, kongkhak bul ah na pasal vuite khepek a hong omta, nang leng a hon zawngkhe ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in thakhat in a khebul ah a pukpah a, a si hi; tangvalte a honglut ua, amah si in a hong mu ua, a zawngkhia ua, a pasal kiang ah a vuita uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan saptuamte leh huai thu za peuhte’n a lau mahmah uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan milak ah Pathian in sawltakte khut in chiamtehna leh thillamdang tampi a hihzel hi. Huan amaute avek un lungsim munkhat in Solomon inlim ah a kikhawm zel uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Midang bel kuamah a lak uah a pang ngamta kei uhi; himahleh min amaute a phat uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Toupa lam ah numei leh pasal gingthak tampi behlap semsem in a om uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in mi damloute kongzing ah a lumsak ua, Peter paikawm a a lim bek in a lak ua khat bek a liah theihna ding in, a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jerusalem khokim a kipan mipite leng huai damloute dawinin hihgimte honpi in a hong khawm ua; huaite leng a hong dam chiat uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan siampu lianpen a kisa a, a kiang a omte tengteng toh, a lawmte tuh Saddukai pawl ahi uhi; amau hazatna in a dim uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Sawltakte a man ua, vantang khumna ah a khumta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Zankim in Toupa angel khat in kongkhakte hawng in, a pikhia hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pathian biakin ah vading unla, mite kiang ah hiai hinna thu vagen un, a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan huai thu a zak un khovak hunlai in, Pathian biakin ah a valut ua, thu a vagen uhi. Himahleh, siampu Lian leh a lawmte a hong ua, vaihawmte leh Israel suante upate tengteng a samkhawm ua, sawltakte honpi ding in suangkulh ah mi a sawl uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh heutute suangkul ah a vahoh ua, amau a mu kei uhi; huchi in a kiknawn uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Suangkulh bittak a kikhak in, a vengte leng kongkhak bul ading a mu uhi, himahleh ka hong ua, asung ah kuamah ka mu kei ua” chi in a gen uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan Pathian biakin Upa leh siampu liante’n, huai thute a zak un, hiai bangchiphet in a thang diam aw? chi in, a thu ah a mangbang petpet uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan mi khat a hong a a kiang uah, “Ngai un, suang kulh a na mi khumte un Pathian biakin ading in thu a gen uh” chi in a hong gen hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in Tempul vengte heutupa leh sepaihte a vapai ua, vantang a kihtak ziak un hiamgamna omlou in sawltakte a honpi ua, huchi hi kei leh suang a den ahi kha ding uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan a pitung un, vaihawmmite ma ah a dingsak uhi. siampu lianpen in a kiang uah,
  </para>
  <para style="p">
    <verse number="28" style="v" />“Huai min in thu hilhlouh ding k’on chita ua; thei un na thuhilh un Jerusalem khua a hihdim vekta hi, hiai mipa sisan hon khuksak tum neive ua” chi in a sal hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Himahleh Peter leh sawltakte’n, “Mihing thu sang in Pathian thuman a kiphamoh zaw hi a chi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nou sing ah Jesu khaikang in na that ua, i pipute Pathian in a kaithou nawnta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah mah Pathian in Kumpipa leh Hondampa a om ding in a taklam ah a hihlianta hi. Israelte khelhna apan kiheisak ding leh ngaidam ding in.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huai thute kou a theihpihte ka hi ua; Kha Siangthou, Pathian in a thuzui peuhte kiang a a piaktak, a theipa ahi nawnlai” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amau huai thu a zak un a sin uh a thak mahmah a, hihlup a tumta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Himahleh vaihawmte lak ah, a min Gamaliel, Pharisai, Dansiammi, mi tengteng lak a minthangpi mi khat a dingtou a, huai mite inn pawlam a omsak takdih ding thu a pia hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan vaihawmte kiang ah, “Nou Israel mite aw, hiai mite tung a na thilhih tup uah pilvang un.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tuma lam in Theuda kichi, mi khat a hongom a, huai mipa kiang ah mi tampi, za li phial, a awn uhi, amah tuh hihlup in a omta a; a thuzui peuhmah avek un a dalhzakta ua bangmah ahita kei uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huai mi om nung in kisimpi lai in, Galili gam ah mi khat Judas kichi a hongom nawn hi; a lam ah mi khenkhat a hip nawn hi; himahleh amah leng a sita a, a thuzui peuhmah avek un a dalhzakta uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huaiziak in tuin k’on hilh ahi, hiai mite khoih kei unla, amau omom in omsak un; hiai a thiltup uh leh a thilhih uh mihing a kipan ahihleh a mang ding hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Himahleh Pathian a kipan ahihleh amau na hihmang theikei ding uh; huchilou in zaw Pathian dou na hi zaw kha ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan a gen lem a sata ua; huchi in, sawltakte tuh a sam ua, a vua ua; a vuakkhit un, Jesu min a thu genlou ding chi bikbek in a khahta uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huchi in vaihawmte lak a kipan a pawtkhia ua, Khrist min ziak a daina thuaktak a seh a hih ziak un a kipak mahmah uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan niteng in Pathian biakin leh amaute inn ah, Jesu Khrist ahi, chi in, thuhilh leh sinsak a tawp kei uhi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai a, nungzuite a punpun lai un, a niteng thilhawm uah Grik pauzang Juda meithaite limsaklou chi in Hebru pauzang Judate tung ah Grik Judate a phun uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan sawmlehnihte’n nungzui mipite a samkhawm ua, “Pathian thugen tawpsan a dohkan a nektak ka bawl uh a hoih kei hi.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in unaute aw, na lak uah Kha leh pilna a dim mi minhoih ngen sagih tel un, amau hiai thilgel ding in ka bawl ding uh;
  </para>
  <para style="p">
    <verse number="4" style="v" />kou tuh thum leh thu nasem in ka om gige ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huai thu in mi tengteng a kipaksak a; huchi in ginna leh Kha Siangthou a dim ngen, Stephen, Philip, Prokora leh Nikanor, Timon, Parmena leh Judate phungkai Antiok khua a mi Nikola a tel uhi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Tua mite sawltakte ma ah a dingsak ua: amau a thum ua, a tung uah a khut uh a nga uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Pathian thu a hong dalh a; Jerusalem khua ah nungzuite a pungta mahmah uhi; siampute lak ah leng mi tampi ginna lam a hong ngata uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Stephen hehpihna leh thilhihtheihna in a dim a, mi lak ah thillamdang leh chiamtehna thupite a hihzom zel hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh Kurini, Aleksandria leh Silisia gam leh Asia gam a kipan Juda pawlkhat Salsuakte kikhopna kichite leh mi khenkhat a hong kisa ua, Stephen a hong kiselpih uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh a pilna leh a genpihpa Kha a selkhe theikei uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan mi khenkhat a guai ua; huai mite’n, “Mosi leh Pathian a gensiat ka za uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan mite, upate leh laigelhmite a hanthawn ua, Stephen a sual ua, a man ua, vaihawmte kiang ah a pi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Theihpih zuauthei bawlkhia in, amaute’n, “Hiai min hiai in Siangthou leh Dan a gense gige.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Nazaret Jesu’n hiai in a hihse dia, Mosi in honpiak dante a hihlamdang ding chih, a gen ka za uh, a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan vaihawmte tengteng in Stephen a ensal chiat ua, a mel angel mel bang in a mu uhi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan siampu lianpen in, “Hiai thute a dik ahi na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Stephen in, “Unaute aw, pate aw, ngai un. I pu Abraham, Haran khua a a omma a, Mesopotamia gam a a omlai in, thupina Pathian a kiang ah a hong kilak in, a kiang ah,
  </para>
  <para style="p">
    <verse number="3" style="v" />Na kholam leh na chite lak a kipan pawt inla, gam k’on etsak ding lam ah pai in, a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan amah tuh Kaldaite gam a kipan a paikhia a, Haran khua ah a va omta hi; huan a pa sihnungin huai a kipan in tua na omna kholam uah Pathian in a pemlut sak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan hiai ah zaw bangmah munluah ding, khengakna tham leng, a pekei hi. Himahleh tapa a neihma nangawn in amah gou ding leh a nung a a suante gouluah ding in gam piak a chiam hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in hichibang in a gen; A suante mi kholam ah kum za li a tam ding ua min sikha in a bawl ding ua, a sawi behlap ding uh.
  </para>
  <para style="p">
    <verse number="7" style="v" />Pathian in, sikha a nei dingte nam keiman ka ngaihtuah ding a, huaikhit chiang in a hongpawt ding ua, hiai mun ah ka na a sem ding uh, a chi behlap hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in a kiang ah tua zeksum thu a khung hi; huchi in, Abraham in Isak a suang a, a ni giat ni’n a zek a sum a, huan Isak in Jakob a suang a; Jakob in chisuang ding sawmlehnihte a hon nei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Tua chisuang dingte’n Joseph a haza ua, Aigupta gam ah a zuak ua; himahleh Pathian a kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A gimthuak tengteng ah a honkhe zel a, Aigupta gam kumpipa Pharo leng a hehpihsak a, mipiltak ahi chih a theisak behlap hi; huchi in aman Aigupta gam leh a in a mi tengteng tung ah gamukpa in a bawlta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aigupta leh Kanan gam tengteng ah kial a hongtung a, gimthuakna thupitak a hongtungta hi; i pipute’n nekding himhim a muta kei uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh Jakob in Aigupta gam ah buh a om chih a zaktakin i pipute a sawlkhia a; tua bel a hoh pattungna pen uh ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a nihvei hohna uah, Joseph a unaute kiang ah kitheisakta a, huchi in Joseph chite tuh Pharo kiang ah a kitheisakta uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Joseph in a pa Jakob leh a unau tengteng mi sawmsagih leh nga a samsak hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in Jakob Aigupta gam ah a hohsuk a; amah leh i pipute a sita uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Sekem khua ah a pawtung ua, Abraham in Sekem khua a Emmor tapate lak a dangka sum a a lei han ah a vuita uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Pathian in Abraham kiang a a thuchiam a hongtun ding in mite Aigupta gam ah a hongpung ua, a hongtam deuhdeuh uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Aigupta gam ah Joseph theilou kumpi dang khat hong lal hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai mi in i chipihte a zekhem a, i pipute a sawi a, a naungekte uh hinglou ding in a paikhe saksak hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huailai in Mosi a hongpiang a, Pathian muh in melhoih mahmah ahi; a pa inn ah kha thum a kem uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A koihkhiak un Pharo tanu in amah tapa ding a la in a kem hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Mosi Aigupta gam a pilna tengteng a hilh ua, thu ah leh a thilhih ah a thupi mahmah hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Huan amah kum sawmli a chin kuan in, a unau, Israel suante a veh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a lak ua mi khat gimthuaklai a mu a, a panpih a, a hihgimpa Aigupta mi a that a, phu a laksakta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mosi in amah khut in Pathian in amaute a hondam chih a unaute’n theina uhiam a sa a, himahleh a theikei uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan a zing in a lak ua mi nih a kilai un a kiang uh a vanaih a, Pute aw, unau neive ua; bangdia diklou tak a kibawl na hi ua? chi in, lep a tum hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Himahleh a invengpa tung a thugilou bawl zaw pen in Mosi tuh a sawnhang a, koute tung a heutu leh vaihawm ding in kuan a honbawl a?
  </para>
  <para style="p">
    <verse number="28" style="v" />Zan a Aigupta mi na thah bang a, honthah tum na hi maw? a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huai thu ziak in Mosi a taimangta hi, Midian gam ah a tam nilouhta hi, huai ah tapa nih a vanei hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Huan kum sawmli nung in Sinai tang gamdai ah; loubuk ah meikuang lak ah angel khat a kiang ah a hong kilak hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mosi in a muh in, a thilmuh tuh lamdang a sa mahmah a; huan en ding a a pailai in, Toupa aw in:
  </para>
  <para style="p">
    <verse number="32" style="v" />Kei na pipute Pathian, Abraham Pathian, Isak Pathian, Jakob Pathian, ka hi a na chi hi. Huchi in Mosi a ling a a en ngamta kei hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan Toupa’n a kiang ah, Na khepek a kipan na khetuam suah in; na dinna Mun Siangthou ahi a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aigupta gam a om ka mite gimdan ka mu gige hi, a thum uh leng ka za gige, amau honkhe ding in ka hongsuk ding hi. Hong in, Aigupta gam ah k’on sawl ding, a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Kou tung a heutu leh vaihawm ding a kuan honbawl ahia, chi a a deihlouh uh, Mosi, loubuk a angel kilak tungtawn in, Pathian in amah mah heutu leh honkhepa hikhawm ding in a sawlta hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman Aigupta gam ah Tuipi San leh gamdai mun ah, kum sawmli sung in thillamdang leh chiamtehnate a musak phot a, amaute a pikheta ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Israel suante kiang ah, Pathian in keimah bang in, na unaute lak ah mi zawlnei khat, a thu na ngaihkhiak ding uh a hon bawlsak ding chipa Mosi ahi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huai mi gamdai a saptuamte lak a ompa, Sinai tang a angel in a houpihpa leh, i pipute kiang a ompa ahi; huai mi eite hon piaksawn ding a thuhingte lasawnpa mah ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />“I pipute’n amah thu a mangkei ua, a hua ua, Aron kiang ah,
  </para>
  <para style="p">
    <verse number="40" style="v" />I makai ding in pathiante hon bawlsak in; Aigupta gam a kipan a hon pikhepa Mosi lah a tanchin ka thei nawnta kei uhi, chi in, a lungtang uh Aigupta gam lam ah a nga nawnta uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huailai in bawngnou lim a bawl ua, a mai a kithoihna a lan ua amau khutsuak milim tung ah a kipak uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huchi in Pathian in a lehngatsan a, van a aksi chibai a buk theihna ding un amaute a tawpsanta hi; Zawlnei laibu a, ‘Aw nou Israel inkawte aw, gamdai ah kum sawmli sung in gan sisan a kithoih in thillat toh in kei n’on bia ua eita?
  </para>
  <para style="p">
    <verse number="43" style="v" />Molok biakna maitam leh na pathian uh, Remphan aksi leh, na milim bawltawmte uh, vialpuak in chibai buk ding in na zong ua huaiziak in Babulon khaw khenlam ah sal in k’on pawmang ding,’ chih gelh bang in.
  </para>
  <para style="p">
    <verse number="44" style="v" />“I pi leh pute’n gamdai ah theihpihna biakbuk, Mosi kiang a a theihsaka om bang leh a lim a muhsak a om bang in a na bawl uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huai biakbuk mah i pipute suansawnte’n leng a neisawn zel uhi, Pathian in i pipute ma a Jentel a delhkhiakte gam a luahlai un, Joshua makaih in biakbuk a lutpih ua; David hongom tan in huai ah a om gige hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />David Pathian mitmuh in deihsaktakin a om a, Jakob Pathian ading in inn bawlsak a ngen hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Himahleh Solomon in huai inn tuh a lamsak zawta hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Himahleh zawlnei gen bang in Tungnungpen tuh khut a bawl innte ah a omkei hi;
  </para>
  <para style="p">
    <verse number="49" style="v" />‘Toupa’n van ka tutphah ahi, lei ka khepek ngakna ahi: inn bangchibang n’on lamsak ding ua? Ka khawlna mun ding koi mun ahia?
  </para>
  <para style="p">
    <verse number="50" style="v" />Hiai thilte keimah khut in ka bawl kei ahia?’ chi a, a gen bang in.
  </para>
  <para style="p">
    <verse number="51" style="v" />“Mi genhakte, lungtang leh bil a zeksumlouhte aw, chiklaipeuh in Kha Siangthou na dal gige uh; na pipute uh hihbang in na hih nilouhlouh uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Na pipute un zawlneite lak ah kua ahia a sawilouh uh? Mi Diktak hongding thugen khawlte a that ua; huai midiktak mansakte leh thatte noumau na hi uhi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Dan angelte piaksawn mu masa a zuiloute aw” a chi hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huan huai thu a zak un a sin uh a thakta a, Stephen tung ah a ha uh a gawita uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Himahleh amah Kha Siangthou in a dim a, vanlam a en a, Pathian thupina leh Pathian taklam a Jesu ding a mu hi;
  </para>
  <para style="p">
    <verse number="56" style="v" />“Ngai un, van kihong ka mu a, Pathian taklam a Mihing Tapa ding leng ka mu” a chi hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huchi in amau aw ngaihtak in a kikou ua, a bil uh a hum ua,
  </para>
  <para style="p">
    <verse number="58" style="v" />Kituaktakin a pang ua, khua a kipan a delhkhia ua, suang in a deng ua, a theihpihte’n tangval khat a min Saul khebul ah a puante uh a koihkhawm chiat uhi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Amaute’n Stephen suang in a dengta uhi; aman Pathian sam in, “Toupa Jesu, ka kha la in” a chi hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Huan khukdin in aw ngaihtak in a kikou a, “Toupa, hiai a khelhna tung uah mawh pawsak ken” a chi hi. Huchi in, huai a gen zoh in, a ihmuta hi. Saul in leng a sih hoih a sa hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai ni’n Jerusalem khua a saptuam omte, min nakpitak in a sawi panta ua; sawltakte kia loungal Judia leh Samaria gam khoteng ah a dalhzak vekta uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Pathian limsak kuate hiam in Stephen a vui ua, nakpitak in a sun uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Saul in bel saptuam pawlte a sawi a, inn teng a lut in, numei pasal a kaikhia a, suangkulh ah a khum hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a dalhzakte khoteng ah a paita ua, thu a gen zel uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Samaria khua ah Philip a hohsuk a, a kiang uah Khrist thu a tangkoupih hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan a thillamdang hihte a zak ua, a muh un, mipite’n lungsim mun khat in, Philip thugente a limsakta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Dawininte mi tampi a matte sung ua kipan in aw ngaihtak a kikou a pawt leh, zaw leh khebai tampi hihdam a a om ziak un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in tua khopi ah nakpitak a kipahna a om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan mi khat a min Simon a om a; aman mi thupi ka hi, chi in tuma lam in huai khua ah mitkhialdawi in Samari khomite lamdang satakin a bawl nilouh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mi tengteng, a neupen apan a lianpen tan in “Hiai mi Pathian thilhihtheihna thupi a chih uh ahi” chi in, a thu a limsak chiat uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A mitkhialdawi in sawtpi lamdang satak a a bawlnak ziak in a thu a limsak uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh amau Pathian gam Tanchinhoih leh Jesu Khrist min Philip gen a gintak un, numei leh pasalte’n baptisma a tangta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Simon nangawn in leng a gingta a, baptisma a tanzoh in Philip kiang ah a om gige a, chiamtehna leh thillamdang thupite a mu a, lamdang a sa thei mahmah hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan sawltak Jerusalem khua a omte’n Samari khua a mite’n Pathian thu a gingtata uh chih a zak un, a kiang uah Peter leh Johan a sawl uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai mite a vatun suk uleh Kha Siangthou a tan theihna ding un a thumsak uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai ma in a lak uah kuamah tung ah a tung naikei hi; Toupa Jesu min in baptisma a tang phet uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan sawltakte’n a tung uah a khut uh a koih ua, Kha Siangthou a muta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan sawltakte khutngakna ziak a Kha Siangthou piak ahi chih Simon in a muh in; dangka piak a sawm hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Hichibang thuneihna hon pesam un, kua peuh tung a leng khut ka koihna in Kha Siangthou a tansamna ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh Peter in a kiang ah, “Na dangka nang toh mang hen, Pathian thilpiak dangka sum a lei na tup ziak in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiai thu ah nang zaw na pang kei, tan leng na neikei hi; na lungtang Pathian ngaih in a dikkei hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huaiziak in, hiai na gitlouhna tawpsan inla, Toupa kiang ah thum in, huchi in na lungtang a na ngaihtuah a hon ngaidam kha mawh ding hiam.
  </para>
  <para style="p">
    <verse number="23" style="v" />Thil khakna sinkha ah leh gitlouh gaklopna ah na om chih ka thei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan Simon in, “Na thilgen uh bangmah ka tung a hong tunlouhna ding in noumau in Toupa kiang ah hon thumsak un” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in amau Toupa thu a theihsak ua, a gen zohnung un, Jerusalem a kiknawn in, Samari mite tenna khua tampi ah Tanchinhoih a gen zel uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan Toupa angel khat in Philip a houpih a, “Thou inla, simlam a Jerusalem a kipan a Gaza khaw sunsuk lampi huai gamdai ah hoh in,” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in a thou a, a paita hi: huan ngai in, Ethiopia gam a mi khat, Ethiopia kumpinu Kanda gou tengteng kempa, michilgeh thuneitak, Jerusalem khua ah Pathian be ding in a hohtou hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A paikik lam kangtalai a tuin zawlnei Isai laibu a sim hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in Kha in Philip kiang ah, “Huai kangtalai vanaih inla, ki thuahpih in” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Philip michilgeh kiang ah a vatai a, zawlnei Isai laibu a sim a za a, “Na sim a omdan na thei hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Aman “Kuamah hon hilhchet louh in bangchi’n ka thei dia?” chi in a kiang a kaltou a tutpih ding in Philip tuh a chialta hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Laisiangthou a simlai tuh hiai ahi: ‘Goh ding belam bang in amah a pi ua; Belamnou a mulmetpa ma a a dai dinden bang in aman leng a kam a ka kei;
  </para>
  <para style="p">
    <verse number="33" style="v" />A vuallelh lai in a tung ah thugen a phal kei ua; a suante tanchin kua’n a hon gen ding ua? Khovel a kipan in a hinna a laksak ngal ua,’ chi in.
  </para>
  <para style="p">
    <verse number="34" style="v" />Michilgeh in Philip a houpih a a kiang ah, “Zawlnei in hiai thu kua thu a genna ahia, amah thu hia, midang thu? k’on dong hi” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Philip in a dawng a, Laisiangthou thu a bul apan in, a kiang ah Jesu thu a hilhta hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan lampi a a paikawm un koimun hiam tui omna a tung ua; huan michilgeh in, “En dih, hiai ah tui a om, baptisma tanna ding bang in a hondal a ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Philip in, “Na lungtang tengteng a na gintak leh na hi thei” a chi hi. Aman “Jesu Khrist Pathian Tapa ahi chih ka gingta” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchi in kangtalai a khawlsak ua, a nih un, Philip leh mi chilgeh, tui ah a hoh khawm suk ua; Philip in amah a baptista hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan tui apat a paitouh un Toupa Kha in Philip a lamangta hi; huan michilgeh in amah a mu nawn takei hi, nuamsatak in a pai zel hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Himahleh Azota khua ah Philip muh in a om nawnta hi; a paisuak a, Kaisaria khua a tun masiah khoteng ah Tanchinhoih a gen zel hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Saul in Toupa nungzuite vau leh thah a tupthu a gen lailai man in siampu lianpen kiang ah a vahoh hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Damaska khua a kikhopnain tengteng a mite kiang a piak ding in lai a ngen a, hiai Lampi zuimi kuapeuh a muh leh, numei leh pasal leng, hen a Jerusalem a honpi theihna ding in.
  </para>
  <para style="p">
    <verse number="3" style="v" />A pailai in, Damaska khua a tunkuan in, thakhat in van a kipan vak a kim ah a hongvak puap hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan lei ah a puk a, a kiang ah, “Saul, Saul, Bang a chia nang honsawi na hia?” chi in, aw a za hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan aman “Toupa, kua na hia?” a chi hi. Toupa’n a kiang ah, na sawi Jesu ka hi; kilhna sikzum tot nang din a haksa hi” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan ling leh lamdangsa kawm in, “Toupa bang sem ding a hondeih na hiam?” a chi hi. Toupa’n a kiang ah “Thou inla, khopi ah lut in, huchi in na hih ding hilh in na om ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A tonpihte gen ding theilou in ading ua, aw zaw a za ua, himahleh kuamah a mu kei uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan lei a kipan in Saul a thou a; a honghaka kuamah a mu theita kei hi; huchi in a khut in a kai ua, Damaska khua ah a pilut uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan ni thum khomulou in a om a, bangmah ne in a dawn kei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Damaska khua ah a min Ananias nungzui khat a om hi. Toupa’n mengmu bang in a kiang ah, “Ananias” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan aman, “En in, Toupa, hiai ah ka om” a chi hi. Toupa’n a kiang ah, “Thou inla, kongzing Tang a chih uah hoh inla, Judas inn ah, Tarsa khua a mi, a min Saul kichi kankhia in. Ngai in, a thum laitak ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Aman mengmuhna in mi khat a min Ananias a kiang a valut a, a mit hihvakna ding a a tung a khutnga in a muta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ananias in, “Toupa huai mi Jerusalem khua a na misiangthoute tung a a tatsiat thu mi tampi kam ah ka za hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan hiai ah na minlou peuhmah hen ding in siampu liante a kipan thuneihna toh hongpai ahi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh Toupa’n a kiang ah, “Hohmai in; Jentelte, kumpipate, leh Israel suante kiang a ka min puaklutna dia ka belseh ahi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Ka min ziak in gimna bangchi a thupi ahia a thuak ding a kiang ah ka theisak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Ananias a vahoh a, inn ah a lut a, huan a tung ah a khut a nga a, “Unau Saul, na mitvakna ding leh Kha Siangthou dim a na om theihna ding in, Toupa, na hongpaina lampi a na kiang a kilak Jesu’n honsawl ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan thakhat in a mit a kipan lip bang a keta a, a mit a vak nawnta a; a thou a, baptisma a tangta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan an a ne a, a halhta hi. Huan Damaska khua a nungzui omte kiang ah ni bangzah hiam a tam hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kikhopnain ah Jesu, Pathian Tapa a hihdanthu a tangkoupih zui ngal hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a thuzate tengteng in lamdang a sa uhi, hiai mi Jerusalem khua a hiai minloute sawi zelpa ahi ka hia? Huai mite siampu liante kiang a hensa a piak a hongna pen ahi, a chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Saul bel a hong hattuam a, huai mi Khrist ahi taktak chih a hilhchiana, Damaska khua a Juda omte gen ding bei in a koih hilhial hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan ni sawttak nung in Saul that ding in Judate a kihou uhi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh aman a thiltup uh a na thei hi. Huan that ding in kulh kong teng ah sun leh zan in a tang uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh a nungzuite’n amah zan in a pi ua, kulh tohlet ah bawm in a khaikheta uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan Saul Jerusalem khua a tuntakin nungzuite kithuahpih a tuma; amau bel avek un amah a kihta uhi, nungzui a hihsam a gingta kei uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Barnaba in amah a pi a, sawltakte kiang ah a hon paipih a, lampi a Toupa a muh a, a houpih dan bang, Damaska khua a Jesu min a hangtak a thu a hilh dan bang leng a kiang uah a genta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Jerusalem khua ah Saul tuh a kiang uah lutzel pawt zel in a omta hi, Toupa min in hangsantak in thu a gen zel hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan Grik pauzang Judate kiang ah thu a gen a, a sel a; amau bel amah hihlup a tum uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan unaute’n huai a theihtak un, Kaisaria khua ah a pisuk ua, Tarsa khua ah a sawlmangta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in saptuamte Judia, Galili, leh Samari gam kimvel ah a kip deuhdeuh ua, muangtakin a omta uhi; huan Toupa laudansiam in, Kha Siangthou khamuan in a om ua, a hong pung deuhdeuh uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Peter in khokim a totvial vial kawm in, Lidda khua a Mi Siangthou omte kiang ah leng a hohsuk hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai ah mi khat a min Ainisi a zawt ziak a kum giat lupna a lum nilouh a mu hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan Peter in a kiang ah, “Ainisi aw, Jesu Khrist in a hon hihdam, thou inla, na awngphah zial in,” a chi hi. Huchi in a thou pahta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Lidda khua leh Saron phai a omte tengteng in Ainisi a mu ua, Toupa lam a nga duam uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan Joppa khua ah a min Tabitha nungzui khat a om a, Tabitha minkhiakna tuh Dorka ahi, huai numei in thilhih hoih leh thilpiak a hau mahmah hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huailai in, a chi a na a, a sita hi; huchi in a silsiang ua, indan tungnung ah a sial uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan Lidda khua tuh Joppa khaw kiang a hih ziak in, nungzuite’n Peter huai ah a om chih a za ua, “Sawt hallou in ka kiang uah hongpai in” chi a vathum ding in a kiang ah mi nih a sawl uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan Peter a thou a a kiang uah a paita hi. Huan a tuntakin indan tungnung ah a pi ua; meithai tengteng ding in Dorka a kiang ua a omlai a a puanak bawlte a puan bawlte lak kawm in a kap chiat uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Himahleh Peter in avek un a pawtsak a, a khukdin a, a thumta hi; huan luanglam a nga a, “Tabitha, thou in” a chi hi. Huchi in a mit a honghaka, Peter a muhtak in a tutou hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan Peter in a khut a pia a, a kaithou hi, misiangthoute leh meithaite a sam a, dam in a peta hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan huai Joppa khua tengteng in a thei vek ua; mi tampi in Toupa a gingta uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan Joppa khua ah savun bawlpa Simon inn ah ni tampi tak Peter a tam nilouh hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kaisaria khua ah mi khat a min Kornelia a om a; Italy pawl a chih uh, huai pawl a sepaih zaheutupa ahi,
  </para>
  <para style="p">
    <verse number="2" style="v" />Amah Pathian limsakmi ahi a, a inkuanpihte tengteng toh Pathian laudan a siam uhi, mite kiang ah thil thawnpiak tampi a pe zel a, Pathian kiang ah leng a thum gige hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai mi’n sun dak kua na ding in mengmuhna in chiantak in Pathian angel khat a kiang a lut a, ‘Kornelia’ chi in, a mu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Kornelia in lau in amah a na en kilkel a, “Toupa, bang ahia?” a chi hi. Aman a kiang ah, Na thumnate leh na thilpiakte theih gige na ding in Pathian ma ah a tungtouta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Tun ah Joppa khua ah mi sawl inla, mi khat Simon Peter a chih uh vapi sak in:
  </para>
  <para style="p">
    <verse number="6" style="v" />Savunbawlpa Simon inn ah a tung a, a in tuipigei a om ahi, aman na hih ding hon na hilh ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A houpihpa angel a paitakin, Kornelia in a sikhate lak a mi nih leh a nekbawl gigete lak a Pathian limsak sepaih khat a sam hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Thu tengteng a kiang ua a hilhkhit in Joppa khua ah a sawlta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan a zingnawn in, khopi zuan a pai, khua a tun kuan un, Peter thum ding in dak gukna vel in intung ah a kaltou hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan a gil a hong kial mahmahta a, annek a utta hi; himahleh nekding a bawllai un ihmu bang in a hongom hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Van kihong in, banghiam bawm, puan liantak bang, ningli a khih, lei a luai a khaikhiak a om a mu hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai sung ah leitung a khelinei ganhing chichih leh gamsa leh, ganhing bokvak, tungleng vasa chichihte a om uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a kiang ah aw in “Peter, thou in gou inla, ne in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh Peter in, “Toupa hilou e; sianglou leh nin bangmah himhim ka ne ngeikei” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Aw in, a nihveina in, “Pathian in a hih siangthousa nang sianglou chi ken” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchibang ngen in thumvei a hongom a; huan bawm van a khaitouh in a om nawnta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Peter in mengmu bang a a muh theisiamlou a, a buailai in, Kornelia mi sawlte’n Simon inn a na kankhia uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kongkhak bul ah a na ding ua a sam ua, “Simon, Peter a chih uh, huai a a tun leh tun louh” a na dong uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Peter in mengmu bang a a muh a ngaihtuahlai in, Kha in a kiang ah, “Ngai in, mi thum in a hongzong uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in thou inla, kum inla, bangmah ginglel lou in amau zui in; amau ka sawl ahi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Peter huai mite kiang ah a hohsukta a, a kiang uah, “Ngai un na zon uh ka hi; bang ahia na hongna uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amau, Angel siangthou khat in, Kornelia sepaih zaheutupa, midiktak, Pathian laudansiam, Juda nam tengteng lak a mi hoih kiang ah, na thugen a zakna din, a inn ah nangmah sam ding in, a hilh hi, a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in mite a samlut a, a giaksakta hi. Huan a zing in Peter a thou a, a kiang uah a pai a, Joppa khomi unau kuate hiam leng a kiang uah a pai sam uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a zingnawn in Kaisaria khua ah a lutta uhi. Kornelia in, a sanggamte leh a lawm deihpente samkhawm in, amau a na ngak nilouh hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Peter a honglut dek laitak in Kornelia in a na dawn a, a khebul a khupboh in, a bia hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh Peter in amah a kaithou a, ding in, “Keileng mihing ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah toh kihou kawm in a lut a, mi tampi omkhawm a mu hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A kiang uah, “Juda mi namdang toh kithuah leh pai a sianlouh dan noumau na thei uhi; himahleh kuamah sianglou leh nin ka chih ding ahi kei chih Pathian in a hon theisak hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huaiziak in na hong saptakin sellou in ka hongpai ahi. Huchi in ka hondong ahi, bangdia honsam na hi ua le?” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan Kornelia in, “Ni li ahita, tu hun bang tan in, ka inn ah, dak kua na hun thumna ah ka thum a; ngai in, puan vaktak silh mi khat ka ma ah a hongding hi,
  </para>
  <para style="p">
    <verse number="31" style="v" />‘Kornelia, na thumna zak in a omta, mi kiang a na thil thawnpiakte leng Pathian in a theigige hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huaiziak in Joppa khua ah Simon, Peter a chih uh, sam ding in mi sawl inla, na kiang ah sam in; amah tuipi gei ah savun bawlpa Simon in a tung ahi, amah a hongtun chiang in na kiang ah thu a gen ding hi’ a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huaiziak in na kiang ah mi k’on sawl pah ahi; na hong a hoih ahi. Huchi in Toupa’n thu a honpiak peuhmah thei ding in tun ah Pathian mitmuh in i vek un hiai ah i om hi, a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan Peter in a gen a, “Pathian in mi deihsaktuam a neikei chih, diktak in ka thei hi;
  </para>
  <para style="p">
    <verse number="35" style="v" />Himahleh namchih lak ah kuapeuh amah kihtakdan siam a, diktak a gamta peuhmah, a pahtakmi ahi naknak uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman khamuanna Tanchinhoih Jesu Khrist tungtawn in Israel suante kiang ah a gen a, Jesu mi tengteng Toupa ahi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Johan in a tangkou pihpih baptisma nung in, hiai Tanchinhoih, Galili gam a kipan a hongthang pan a, Judia gam tengteng ah a thangsuak a, noumau leng na thei uhi;
  </para>
  <para style="p">
    <verse number="38" style="v" />Nazaret Jesu tungtang thu, huchi a Pathian in amah Kha Siangthou leh thilhihtheihna a a thaunilh dan, Pathian a kiang a a om ziak in amah mi tung a thil hoih hihleh Diabol gawt tengteng hihdam in a vialvak vak hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Judate gam ah leh Jerusalem khua a a thilhih tengteng theihpih te ka hi uhi, amah sing dawn ah khai in a that uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amah Pathian in ni thum ni’n a kaithou nawn a, chiantak in a kitheisak hi,
  </para>
  <para style="p">
    <verse number="41" style="v" />Himahleh mi tengteng kiang ah ahi kei a, Pathian in theihpih dia a sehkholhte kiang kia ah ahi koute, misi lak a kipan a thohnawn nung a a kiang a ne a dawnte kiang ah.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amah misi leh mihingte tung a Vaihawmpa dia Pathian seh ahi chih, mi kiang a tangkoupih leh theisak ding in Pathian in thu a honpia hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Kuapeuh amah gingta a min ziak in khelhnate ngaihdam in a om ding uh chih hiai a tanchin zawlnei tengteng in a na theihsak sak uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Peter in huai thu a genlai tak in thu zate tengteng tung ah Kha Siangthou a hongtung hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Zeksumte lak a a gingtate Peter honzui peuhmah in Kha Siangthou thawnpiak Jentelte tung ah leng sunbuak a hih ziak in lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Pau theihlouh a thugen in Pathian phat in a za uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan Peter in a phuang a, “Hiai mite, eimah bang a Kha Siangthou tang sam, baptisma ding in tuizat kuama’n a kham thei dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huchi in Toupa min a baptisma tan ding thu a pia hi. Huaikhit in ni bangzah hiam tam ding in a khou uhi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Judia gam a sawltak leh unau omte’n Jentelte’n leng Pathian thu a gingta uh chih a zata uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in Peter Jerusalem khua a tuntouh tak in, zeksumte’n a kiang ah,
  </para>
  <para style="p">
    <verse number="3" style="v" />“Zeksumloute inn ah lut in, a kiang uah na ne” chi in a kalhta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh Peter in a bul a kipan in kizom zel in a kiang uah a hilhchian hi:
  </para>
  <para style="p">
    <verse number="5" style="v" />“Joppa khua ah thum in ka om a, huan ihmu bang in ka om a, banghiam bawm puan liantak bang a ningli a khih, van a kipan a khiaksuk bang in ka mu a; ka kiang ngeingei a hongtung hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai tuh ka en kilkel a, ka ngaihtuah a, ‘lei a ganhing kheli nei leh gamsate chichih, awm a kitholh ganhingte leh tungleng vasate ka mu hi.’
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan aw in ‘Peter, thou in; gou inla, ne in, honchi in,’ ka za hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh ken, Toupa, hilou e, sianglou leh nin bangmah ka kam ah a lut ngeikei, ka chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh van a kipan in aw in, a nihveina in, Pathian in a hih siangthousa nang sianglou chi ken, chi in a hon dawng hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchibang ngen in thumvei a hongom a: huan bangkim van ah khaitouh in a om nawnta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan ngai in, mi thum Kaisaria khua a kipan ka kiang ah a honsawl ua, ka omna inn mai ah a na ding nilouh uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Kha in kuamah khentuam neilou a amau zui ding in a honsawl hi. Hiai unau guk in leng a honzui sam ua, huai mi inn ah ka lutta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan aman ka kiang uah, a inn a angel kilak a muhdan leh angel in a kiang a, Joppa khua ah mi sawl a, Simon Peter a chih uh, pisak ding leh;
  </para>
  <para style="p">
    <verse number="14" style="v" />‘Aman thu a honhilh ding a, huai mi thu in nang leh na inkuanpihte hotdam in na om ding uh’ a chih dan leng a honhilh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan thu ka gentung in, Kha Siangthou ka tung uah a hongtungta.
  </para>
  <para style="p">
    <verse number="16" style="v" />Toupa thu, Johan in tui in a baptist zel; himahleh nou zaw Kha Siangthou a baptist in na om ding uh a chih k’on theikhenawn uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Toupa Jesu Khrist i gintak ua, Pathian in thilthawnpiak a honpiak amau kiang a a piaksam, kei Pathian sel vual ka hi ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai thu a zak un a daita ua, huchi ahihleh “Pathian in Jentelte leng hing ding a kisik phalta ahi ngei maw” chi in, Pathian a phat uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan Stephen ziak a sawina thuak dalhzakte, Phoinisia gam, Kupra tuikulh, leh Antiok khua pha in a pai ua, Judate kiang kia ah loungal kuamah kiang ah thu a gen kei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh a lak ua a khen tuh Kupra tuikulh leh Kurini khua a mite ahi ua, huai mite’n Antiok khua a tun un Grikte leng a houpih ua, Toupa Jesu Tanchinhoih a hilh samta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Toupa khut in amaute a panpih a; mi tampi in a gingta ua, Toupa lam a hong nga chiatta uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan a tanchin thu uh Jerusalem khua a saptuam omte bil ah a lutta a: huchi in Antiok khaw pha in Barnaba a sawlkhia uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amah a vatung a, Pathian hehpihdan a muh in a kipak hi, phatuamngaitak in Toupa len gige ding in avek un a hanthawn hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Barnaba mi hoihtak ahi a, Kha Siangthou leh ginna a dim ahi. Huan mi tampi Toupa kiang ah a behlap in a omta uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan Saul zong ding in Barnaba Tarsa khua ah a hoh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A muh in Antiok khua ah a honpi hi. Huan kum khat hilhial saptuamte kikhopna ah a pang zel ua, mi tampi leng thu a hilh uhi. Antiok khua ah ahi nungzuite “Khristian” a chih masak pen uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huailai in zawlnei kuahiam Jerusalem khua a kipan in Antiok khua ah a hohsuk hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A lak ua mi khat a min Agaba, ading a, khovel tengteng ah kial thupitak a tung dek chih Kha hilh in a theisak a; huai kial tuh Klaudia vaihawm lai in a hongtungta hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in nungzuite’n a theihdan chiat un Judia gam a unau omte kiang ah panpihna khak a tum uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai tuh a hihta ngei uhi, Barnaba leh Saul khut ah upate kiang ah a khak uhi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai in Kumpipa Herod in saptuamte lak a kuate hiam hihgim tum in a khut a likta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Jakob, Johan unau, namsau in a satlum hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai in Judate a kipaksak chih a theih in, Peter leng mat a tum zel hi. Huai ni tuh tanghou silngou sohlouh ni ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a mat nung in suangkulh ah a khum a, sepaih pawl li, li chiat zel in, a venkhel sak hi; Paikan Ankuanglui nung in mi tengteng kiang ah pikhiak a tum hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaiziak in Peter suangkulh ah a omsak tadih hi; himahleh, saptuamte’n amah ading in phatuamngaitak in Pathian kiang ah a thumsak uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Herod in a pikhiak ding zan in Peter sepaih nih kikal ah khainiang nih bun in a ihmu a; a vengte kongkhak bul a om in suangkulh a veng uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ngai in, Toupa angel khat a kiang ah a hong ding a, suangkulh sung ah vak a hongtang hi; huan Peter nak ah a beng halh a, “Thou meng in” a chi hi. A khut a kipan khainiangte a tolh khesuk hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan angel in a kiang ah, “Na puan silh inla, na khetuam bun in” a chi hi. Huan aman huchibang in a hih hi. Angel in a kiang ah, “Na puan silhhoih inla honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Peter a pawt a a zuita hi, angel tatdan a tak a hih a theikei a, mengmu bang a a muh hiam a kisa hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan chingmi masa leh a zawm a khennung un, khopi lutna sik kongpi a vatung ua, huai tuh amau ading in a kihong tawmta hi; huan a pawt ua, kongzing khat a kheng ua; huai a kipan angel in a amah paisanta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Peter a halhtakin, “Herod khut leh Judamite lametna tengteng a kipan a honkhe ding a Toupa’n a angel hon sawlkhia ahi chih tuin diktak in ka theita” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan a kingaihtuah khit in, Johan, Mark a chih uh, huai nu Mari inn ah a vahoh a; huai ah thum in mi tampi a na omkhawm uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kongpi kongkhak a kiuh tak in, nungak khat a min Roda, a dawng ding in a va hoh hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Peter aw a zaktak in a kipah ziak in kong honglou in a tailut nawn a, kongkhak bul ah Peter ading chih a vagen hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh amau a kiang ah, “Hai neita ve” a na chi uhi. Aman bel, “Hi petmah ahi” chi in a pang teitei hi. Amau “Angel hi in teh” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh Peter in kongkhak a kiukiu a; a hon ua leh amah a mu ua, lamdang a sa uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in aman amaute dai ding in a khutvan a, Pathian in suangkulh a kipan amah a pikhiakdan a hilhta hi. “Hiai thute Jakob leh unaute kiang ah vahilh un” a chi hi. Huan a pawt a mun dang ah a vapai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Ni a hong suahtakin, sepaihte Peter tung a bang thil tung hiam, chi in buai chihtak in a buai uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan Herod in amah a zong a a mu kei hi, a vengtute a enchian a, thah ding in thu a peta hi. Huan Judia gam a kipan Kaisaria khua ah a hohsuk a, huai ah a om nilouh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan Tura leh Sidon khua a mite tung ah Herod a lunghikei mahmah hi: amau thukhatsat in Blasta, kumpipa lupna ngakpa, a lawm in a bawl ua, kumpipa kiang ah hongpai ua, amah a kipan nek leh dawn ngah zel ahihman un a kholamte uh toh kilemna a ngen uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a nichiam ni’n kumpipa Herod in kumpi puan a silh a, a mangtutphah a tuin amaute kiang uah thu a gen hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mi tengteng in, “Hiai pathian aw ahi, mihing aw ahi kei” a chi ua, a kikou uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman Pathian kiang a thupina a piaklouh ziak in Toupa Angel in amah a manpah a, hut in a ne a, a sita hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian thu bel a dalh a, a pung zel hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Barnaba leh Saul in na a sepkhit un, Jerusalem khua a kipan a kiknawnta ua, Johan, Mark a chih uh, a tonpih uhi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Antiok khua a saptuam omte lak ah zawlnei leh thuhilhmi kuate hiam a om ua; huaite Barnaba, Niger a chih uh Simeon, Kurini khomi Lusia, kumpipa Herod toh khangkhawm Manaen leh Saul ahi uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Toupa nasem a an a ngawllai un, Kha Siangthou in, “Barnaba leh Saul ka sapna nna sem ding in kei ding in hon koihtuam sak un” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in an a ngawl ua, a thumkhit un a tung uah a khut uh a koih ua, a paisakta uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Kha Siangthou sawlkhiak in a pai ua, Seliusia khua ah a hohsuk ua, huai a kipan in Kupra tuikulh ah long in a pai uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Salami khua a a omlai un Judate kikhopnain ah Pathian thu a gen ua; Johan leng amau panpih ding in a tonpih uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan tuikulhgam Papho khua pha in a nawksuak ua, bumsiam, zawlnei taklou, Judami khat a mu ua, a min tuh Bar Jesu ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai mi gamukpa Serjia Paulus, mi piltak kiang a om ahi. Huai gamukpa’n Barnaba leh Saul a sam a, Pathian thu zak a tum hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh bumsiam Elima, kichi bel Bar Jesu a min khiakna ahi, amau nasep dal in gamukpa ginna a kipan heimang a tum hi,
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Saul, Paul a chih uh; Kha Siangthou in a dim a, amah a ensal hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />“Nang, mi khem leh huathuai chiteng a dim Diabol tapa, diktatna tengteng melmapa aw, Toupa lam diktatte hihsiat na tawp kei ding maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Thei in, tuin Toupa khut na tung ah a tu hi, na mit a hongtaw ding a, bang tan hiam khovak na mu kei ding” a chi hi. Huchi in khomui leh mial in amah a khuhpah a, khut a kai ding mi zong in a mai puampuam hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan gamukpa’n huai thilhih a mu a, Toupa sinsakna lamdang a sa mahmah a, a gingtata hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Paul a tonpihte toh Papho khua a kipan in long in a pai ua, Pamphilia gam a Perga khua a tung uhi; huai ah Johan in amaute paisan in, Jerusalem khua ah a kiksan hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh amau Perga khua a kipan a pai zel ua, Pisidia gam a Antiok khua a tung uhi; Khawlni’n kikhopnain ah a lut ua, a tu uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Dan leh zawlneite laibu a simkhit un, kikhopnain upate’n a kiang uah mi a sawl ua, “Unaute aw, mite hanthawnna thu banghiam na neih uh leh gen un” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Paul ading a, a khut a zap in a gen hi; “Israel mite leh Pathian laudansiamte aw, ngai un:
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiai Israel chite Pathian in i pipute a tel a, Aigupta gam a a tamlai un a hihthupi a, ban thahat in amaute huai a kipan in a pikheta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan kum sawmli gamdai ah a thilhihte uh a thuak teitei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Kanan gam a nam sagihte a hihsiat khit in, a gam uh aisan a hawm a a luah ding un a pia hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaite nung kum za li leh sawmnga sung teng vaihawmmite a pe zel a, zawlnei Samuel huntan in.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan huai nung in kumpipa a ngen ua; Pathian in, Saul kichi, Benjamin nam a Kish tapa, kum sawmli sung amau a pia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amah a suanmang nung in a kumpipa ding un David a bawlta hi; Pathian in huai thu theihsak in, David, Jesse tapa, ka lungtang bang pu mi ka mukheta, aman ka deihlam a hih ding, a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hiai mi suan a kipan in Pathian in a thuchiam bang in Israelte kiang ah Hondampa, Jesu kichi a hon dinkhia hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amah a hong paima in Johan in kisikna baptisma thu Israel mi tengteng kiang ah a na hilh masa hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan Johan in a sepding a zoh kuan in, ‘Noute’n kei kua na honsa ua? Amah zaw ka hi kei hi. Himahleh ngai un, ka nung ah mi khat hongpai dek ahi, kei zaw a khepek a khetuam pheltak leng ka hi kei’ a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Mite leh unaute, Abraham suante leh Pathian laudansiam Jentelte tengteng aw, noute kiang ah hiai hotdamna thu piak in a omta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Jerusalem khua a omte leh a makaite un, amah a theihlouh ziak ua siamlouh a tansak lai un, zawlneite thute khawlni teng a a simte uh tangtung sak a na hi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A sihna ding khop a tung ah bangmah a muhlouh un leng, Pilat kiang ah hihlup ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan a thu zawlneite’n a gelhkholh tengteng uh a hih tangtun khit un, sing a kipan in a lakhia ua, han ah a sialta uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh Pathian in misi lak a kipan a kaithou nawnta hi:
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in Galili gam a kipan Jerusalem khua a amah toh hohtoute kiang ah ni sawtpi a kilak gige a; huai mite mah mi kiang a a thu theihpihte ahi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Kou leng pipute kiang ah huai thuchiam a Tanchin kipahhuai k’on phuangzak uhi;
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi a Pathian in Jesu a kaihthoh, ei a tate kiang ah huai thuchiam tuh a hih tangtung hi; Sam nihna ah, ‘Nang zaw ka tapa na hi a, tuni in k’on neikhia hi,’ chih gelh bang in.
  </para>
  <para style="p">
    <verse number="34" style="v" />Muatna mun a painawnlou ding in Pathian in amah misi lak a kipan a kaihthoh ding danthusehsa bang in a gen hi, David kiang a hehpihna ka chiamte nangmah ka honpe ding, chi in.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huaiziak in Sam dang ah, Na Mi Siangthou muatmang na phalkei ding, a chi behlap hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />David zaw, Pathian vaihawmsak bang in amah khang hun a na a sepkhit in, a ihmu a, a pipute kiang ah a sial ua, a muatmangta hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Himahleh Pathian kaihthoh pen in zaw muatna a mu kei hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchi in unaute aw thei un; amah ziak in khelhna ngaihdamna thu na kiang ua gen ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Kuapeuh a gingta tuh bangkim ah amah siamtansak in a om, huai lah Mosi dan in siamtansak in na om theikei uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huaiziak in pilvang un, huchilou in zaw zawlneite a a gen uh na tung uah a hongtung ding hi;
  </para>
  <para style="p">
    <verse number="41" style="v" />Musitte aw, en un, lamdang sa unla, mangthang un; na damsung un nna khat ka sem hi, huai nna mi’n honhilh mahle uh, na gingta kei hial ding uhi chih” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan a pawt un, khawlni nawn chiang a huai thute gennawn ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan kikhawmte a kikhen tak un, Judate leh phungkaite Pathian limsak lak a mi tampi in Paul leh Barnaba a zuizel ua; amau a na houpih uhi, Pathian hehpihna ah om gige ding in a hanthawn hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan khawlni nawn in a khozang phial un Pathian thu ngaikhe ding in a hong kikhawm uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Himahleh Judate’n mipite a muhtak un a haza mahmah ua; Paul thugente kalh in a gensia uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huchi in Paul leh Barnaba in hangsantak in a dawng ua, “Pathian thu noumau kiang ah gen masak ding him ahi; himahleh na nial ua, tangtawn a hingtaklou a na kiseh nung un, thei un, Jentelte lam ka ngata uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huchibang in Toupa’n thu a honpia hi, “Jentelte hihvakpa din ka honsep a, kawlmong pha a Hondampa dia na om theihna ding in ” chih gelh bang in, a chi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Jentelte’n huai thu a zak un, a kipak ua, Toupa thu a pahtawi ua, tangtawn a hing ding a sehkholh peuhmah in a gingta uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Toupa thu huai gam kimvel ah a dalhta hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Himahleh Judate’n numei zahtakhuai Pathian limsakte leh khua upate hanthawn in, Paul leh Barnaba sawisak in, a gam ua kipan a delhkhia uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Amau leng a tung uah a khepek ua leivui a singkhia ua, Ikoniam khua ah a paita uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huan nungzuite kipahna leh Kha Siangthou in a dim chiat uhi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ikoniam khua ah Judate kikhopnain ah a luttuak ua, thu a genzel uhi, huchi in Judate leh Grik mipi tampi in leng a gingtata uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Himahleh gingta nuamlou Judate’n Jentelte lungsim a tokthou ua, unaute a hawsak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in Toupa ah hangtak a thugen in huai ah sawtsim a om uhi. Aman chiamtehna leh thillamdangte a khut ua hihsak in, a hehpihna thu a theisak zel hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh khua a mipite a kilangta ua, a khen in Judate a gum ua, a khen in sawltakte a gum uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jentelte leh Judate a heutute utoh pangkhawm in sawltakte simmohhuaitak a bawl a suang a den a tuplai un,
  </para>
  <para style="p">
    <verse number="6" style="v" />Amau a na thei ua, Lykonia gam mah ah Listra leh Darbi khua ah leh a kim gam ah a taimang uhi;
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai ah Tanchinhoih a gen zel uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Listra khua ah khe zaw kuahiam a tu a, a piantung apat khebai him ahi a, khe in a pai ngeikei hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai min Paul thugen a ngaikhia a; huan Paul in a en gegu hi, “Damna ding in ginna a nei chih a thei a, aw ngaihtak in, na khe in dingtang in” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan amah a tawm a, khe in a paita hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Mipite’n Paul thilhih a muh un, Lykonia pau in aw ngaihtak in, “pathiante mihing bang in i kiang uah hongsukta uh e!” a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amaute’n Barnaba pen, ‘Jupiter’ a chi ua, Paul bel thugen pen a hih ziak in ‘Hermes’ a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Jupiter siampu khopi pawlam a om leh mipite’n bawngpate leh pakkhigui limte kongkhak kiang a hontawi in, amau biakna ding in lat a tum uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh sawltak Barnaba leh Paul in huai a zak un, a puan uh a botkek ua, mipi lak ah a dianglut ua, a kikou uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Pute aw, hiai thilte bangdia hih na hi ua? Kou leng noumau hindan kibang pu mihing ka hive ua le: hiai thil ginaloute na kiheisan ua, van, lei, tuipi, leh asung ua om tengteng bawlpa Pathian hing kiang a n’ong kiheina ding un Tanchinhoih k’on tun uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in nidanglai in namchih amau lampi chiat zuih a phal hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh amah theihsakna omlou in a kibawl kei hi, huchi in thil a hihhoih zel a, van a kipan in vuahtui a honpia a, na lungtang uh nekding leh kipahna in a hihdim gige a kei hiam” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in huai thu in mipite’n amaute biakna dia gan a goh ding uh a kham zou teitei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh Antiok leh Ikoniam khua ah Judami kuate hiam a hong ua, mipite a khempukta uhi; huchi in suang in Paul a deng ua, si a a gintak ziak un khua a kipan a kaikheta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh nungzuite a kim a a dinlai un, a hong thou a, khua ah a lut nawnta hi. Huan a zing in Barnaba toh Darbi khua ah a paita uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan huai khuate kiang ah Tanchinhoih a hilh ua, nungzui tampi a bawlnung un Listra, Ikoniam leh Antiok khua ah, a kiknawn uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Gim tampi thuak in Pathian gam i lut ding ahi him ahi, chi in, nungzuite lungsim a hihkip ua, ginna a om gige ding in a hanthawn uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan saptuam pawl teng ah upate a sehsak ua, anngawl kawm a a thumkhit un, a gin uh Toupa kiang ah a kemsak zelzel uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pisidia gam a tawnsuak ua, Pamphilia gam a tung uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Perga khua a thu a genkhit un Attalia khua ah a hohsuk uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai a kipan in long in a pawt ua, Antiok khua a hongtung nawnta uhi. Huai mun ahi tua a thilhih khitsa uh hih ding a unaute’n Pathian hehpihna a kemsak a a sawlkhiakna uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan a tunnung un a saptuamte a samkhawm ua, Pathian in, amaute zang a a thilhihte leh Jentelte adia ginna kongkhak a honsak dan a hilh uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan nungzuite kiang ah sawtsim a omta uhi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Mi kuate hiam Judia gam a kipan in a hongsuk ua unaute kiang ah, “Mosi dan bang a zek na sumkei uleh hotdam na hi theikei ding uh” chi in, a hong gen uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in Paul leh Barnaba in amaute kalh in nakpitak a kisel in a kilan ziak un, Paul leh Barnaba, a lak ua kuate hiam toh, huai thubuai dongchian ding in Jerusalem ah sawltakliante leh upate kiang ah hohtou ding in a sep uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in Saptuamte’n a vakha ua amau Jentelte kiheikik nawndanthu genzel in, Phoinisia gam leh Samari gam a tawnsuakta uh; huchi in unaute tengteng a kipaksak mahmah uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jerusalem khua a tun touh un Saptuam pawlte, sawltakte, upate’n a na kipahpih ua; Pathian in amau zang a a thilhihte a gengen uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh Pharisai pawl a mi gingta kuate hiam a kisa ua, “Jentelte zeksum ding leh Mosi dan a zuihchiat ding uh ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan sawltakliante leh upate, huai thu ngaihtuah ding in a kikhawm uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nakpi a a kisel nung un Peter a dingtou a, a kiang uah, “Mite leh unaute aw, Jentelte’n keimah kam a Tanchinhoih thu za a gingta ding a, Pathian in nidanglai a na lak ua kipan a a hon sehdan na thei uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Lungsim theipa Pathian in eite honpiak bangmah in Kha Siangthou a kiang ua pesam in a tung uah a kipak chih a theisak hi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan eite leh amau khentuam neilou in ginna in a lungsim uh a hih siangthou hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in i pipute leh eite’n i zuih zohlouhsa hakkol tun ah nungzuite tung a ngaktum a bangdia Pathian kalh na hi ua?
  </para>
  <para style="p">
    <verse number="11" style="v" />Amau gintak bangmah in eite’n leng Toupa Jesu hehpihna ziak a hotdam ding hi in i kigingta ngal ua” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Barnaba leh Paul in, amaute zang a Pathian in Jentelte lak a chiamtehna leh thillamdang a hih thu a genlai un mipite’n ngaikhia in a dai sipsip uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi a mipite a daih sipsip lai un Jakob in a dawng a, “Unaute aw, ka thu ngaikhia un, chi in a gen sam hi,
  </para>
  <para style="p">
    <verse number="14" style="v" />Simeon in Pathian in amah min pu ding leh a lak ua kipan mite lakhe ding in Jentelte a veh tungthu a genta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai thu leh zawlneite thu, gelh a omsa toh a kituak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai khitchiang in ka kiknawn ding a, David biakbuk chimsia ka bawlnawn ding a, a siatna lai ka puah ding a, ka tungding nawn ding;
  </para>
  <para style="p">
    <verse number="17" style="v" />Midang a omsunte leh ka minpu Jentelte ka min kikoppih te’n, Toupa a zonna ding un huai thilte tengteng ahihta hi, chi in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Khovel siamchil a kipan hiai thu theisakpa Toupa’n a chi, chih gelh ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huaiziak in Jentelte lak a Pathian lamngate hihgim keini chih ka thusawm ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Milim biakna sanek, kingaihna nin, sa heklup leh sisan nek a tawpsanna ding un a kiang uah laigelh zaw lehang, ka chi pen hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mosi dan lah nidanglai a kipan khaw teng ah a thu tangkoupih a hih ban ah kikhopnain peuh ah khawlni teng in a thu sim ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan sawltakte, upate, saptuam tengteng toh, a pawl ua mi tel, Paul leh Barnaba kiang ah Antiok khua a hohsak hoih a sa ua; a telte uh min Judas, Barnaba a chih uh leh Sila ahi ua, huai mite unaute lak a heutu deuh ahi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Hichibang in a gelh ua, a khut uah a khak uh: “Sawltakte leh unaute lak a upate’n Antiok khua, Suria gam leh Silisia gam a Jentel unaute chibai a buk uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka pawl lak ua mi kuate hiam in noute kiang a thugen in, Zeksum ding leh Mosi dan zuiding in a hon hihbuai ua, na lungsim uh a hon mangbangsak uh chih ka za ua, amaute hiai thu gen ding in ka sawl kei uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huaiziak in thukhatsat a ka kikhop un, ka deihtak uh Barnaba leh Paul,
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa Jesu Khrist min ziak a sih khawk saloute toh, mi telte na kiang ua honsawl hoih ka sa uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in Judas leh Sila k’on sawl uhi, amau leng hiai thu mah kam in a honhilh ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai thu poimawhte ka gelhte uh chih louhngal Kha Siangthou leh koute’n puakgik tuan na tung uah bangmah nga kei le ung hoih ka sa uhi:
  </para>
  <para style="p">
    <verse number="29" style="v" />Milim biakna sa nek, sa sisan nek leh kingaih tawpsan le uchin ka chi uh; hiaite na tawp uleh nou ading in a hoih ding hi. Damtakin om un” chi in.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in a sawl un a kuan ua, Antiok khua a tungsuk ua; mipi a samkhawm ua, lai a pia uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan a simkhit un lungmuanna thu ziak in a kipak mahmahta uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Judas leh Sila in, zawlnei leng ahi ua, thu tampi in unaute a khamuan ua, a hihkip uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan huai ah sawtkhop a om nung un amau sawltakte kiang a pai nawn ding in, unaute’n khamuangtak in a pawtsak nawnta uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Bangteng hileh Sila in bel a kiang ua omtakdih hoih a sa hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Paul leh Barnaba bel midang tampite toh Antiok khua ah Toupa thuhilh leh gen in a om nilouh uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan ni bangzah hiam nung in Paul in Barnaba kiang ah, “Khoteng a Toupa thu i genna peuh a unau omte vaveh nawn in, a omdan uh va en lehang,” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Barnaba in Johan, Mark a chih uh, a kiang ua tonpih a tuma;
  </para>
  <para style="p">
    <verse number="38" style="v" />Himahleh Paul in bel aman Pamphilia gam a amau a kiksan a, nasepna a a kiang ua a hohlouh ziak in tonpih hoih a sa kei hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huchi in nakpi’n a kiselta ua, huan a kikhen ua Barnaba in Mark a tonpih a, Kupra tuikulh lam ah long in a paita hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Paul in Sila a tel a, unaute’n Toupa hehpihna a kepsak nung un a paikheta uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan saptuam pawlte hihkip zel in Suria leh Silisia gam a tawnsuak uhi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Darbi khua leh Listra khua ah leng a hoh a; huai ah nungzui khat a min Timothi a om hi. Amah gingta Juda numei tapa, a pa bel Grik ahi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Listra leh Ikoniam khua a unau omte’n amah a phat mahmah uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Paul in a kiang a hohsam ding in a deih a; huchi in huai a Juda omte ziak in zek a sumsak a, a pa Grik ahi chih a thei vek uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khoteng a a paikawm un Jerusalem khua a sawltak leh Upa omte vaihawm zui ding in unaute kiang ah thupiak zuih ding a pe zel uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in ginna ah saptuam pawlte a kipta ua, niteng in a khang deuhdeuh uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Kha Siangthou in Asia gam a thugen a kham ziak in Phrigia leh Galatia gam a tawnsuakta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Mysia gam a hong tunnung un, Bithinia gam a lut a tum ua; himahleh Jesu Kha in a phalkei hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Mysia gam a tawn in Troas khua ah a hohsukta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zan in Paul in mengmu bang in Masidonia gam a mi khat ding a, “Masidonia gam ah hong kai inla, hong huh in” chi a thumthum in a mu hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan huai mengmuhna a neihkhit in a kiang ua Tanchinhoih gen ding in Pathian in a honsam ahi chih kichiantak a thei in, Masidonia gam ah hoh ka tumpah uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Troas khua a kipan long in ka pawt ua, tangtak in Samothrasi khua ah ka pai ua, a zing in Neapoli khua ah ka pai nawn uhi;
  </para>
  <para style="p">
    <verse number="12" style="v" />huai a kipan in Phillippi khua ah ka pai ua, huai khua tuh Masidonia gam a khua khat Rome khua a mipemte khua ahia, huai uk a khaw poimawh pen ahi. Huai khua ah ni tamsim ka tamta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan khawlni’n kulh kongkhak pawlam ah luigei ah, thumna mun hi a ka gintakna uah ka hoh ua; huan ka tu ua, numei hong paikhawmte kiang ah thu ka gen uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a min Lidia, puan sandup zuak, Thaitira khomi, Pathian bia numei khat in ka thu uh a za a; huan Paul thugen zui ding in Toupa’n a lungtang a hih vaksakta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Amah leh a inkuanpihte’n baptisma a tankhit un, “Toupa a ginom a n’on seh uleh ka inn ah hongtung un” chi in, a hon ngen a, a hon khou hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan thumna mun a ka hohlai un, nungak kuahiam dawi aisansiam zawl in a hon kituahpih a, aman a aisan ziak in a pute sum tampi a muhsak zel hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai mi in Paul leh kou a honzui a, “Hiai mite, hotdamna lampi nou honhilhte, tungnungpen Pathian sikha ahi uh” chi in, a kikou hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchibang in ni tampi a hih hi. Huchi in Paul a lungkimta kei a, a kihei a dawi kiang ah, “Jesu Khrist min in asung a kipan pawt thu ka honpia” a chi hi. Huchi in a hongpawt khepah hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan a pute’n a summuhna uh a mang chih a theihtak un, Paul leh Sila a man ua, heutute ma ah dawlmun ah a kailut uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in vaihawmte kiang ah a pi ua, “Hiai mite Judate ahi uh, ka khua uh a hihbuai mahmah uhi;
  </para>
  <para style="p">
    <verse number="21" style="v" />Rome mite adia kipahpih huailou leh zuih siangloute chindan a gengen uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in mipite sawltakte sual ding in a hong dingkhia ua, vaihawmte’n a puanuh a sahkeksak ua, chiang a satding in thu a pia uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan tamvei pi a satkhitun suangkulh ah a khum ua, a vengpa kiang ah bittaka ven ding a chi bikbek uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchitel a thu a piak ziak un aman tanna sungnung ah a khum a, a khe uh singkol a bunsak hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh zanlai in, Pathian kiang ah Paul leh Sila a thum ua, la a sa ua, hentate’n a ngaikhia uhi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Thakhat in zin nakpitak in a hongling a, huchi in suangkulh suangphumte tan in a lingsak a, kongkhak tengteng a kihong paha, saltang chih kolbutte a kiphel vekta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan a sungkul vengpa ihmu a honghalh a, suangkulh kongkhakte kihong in a mu a, hentate taimang uh a sa a, a namsau a dok a, a kithat dek hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Himahleh Paul, aw ngaihtak in a kikou a, “Bangmah kichih ken, ka vek un hiai ah ka omlai uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan suangkul vengpan khawnvakte a zong a, asung a tawmlut in, ling kawm in Paul leh Sila ma ah a khupboh hi;
  </para>
  <para style="p">
    <verse number="30" style="v" />amaute a pikhia a, “Pute aw, hotdama om ding in bang ahia ka hih ding?” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan amau, “Toupa Jesu ging inla, huchi in hotdam in na om ding, nang leh na inkuanpihte toh” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amah leh a inn a omteng kiang ah Toupa thu a gen uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai zanlai mah in a pikhia a, a satna golhte uh a silsiang a; amah leh a inkuanpihte tengteng in baptisma a tang uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />A inn ah a pitou a nekding a lui a, Pathian a gintak ziak un, amah leh a inkuanpihte, a kipak mahmah uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nisuahin vaihawmte’n, mimante sawl in, “Huai mite khahin” a chi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Suangkulh vengpan, Paul kiang ah a thu uh a hilh a, “Vaihawmte’n nou khah ding in mi a honsawl uhi; huaiziak in tu’n hongpawt unla, khamuangtak in paita un” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Himahleh Paul in, a kiang uah, “Rome khomi ka hi ngal ua, ka siamna uleh siamlouhna uh theilou in vantang mitmuh in n’on sat ua, suangkulh ah na honkhum ua; tun ah a guk a hon delhkhe dek na hi u maw? A hi kei ding; amau mahmah hong uhenla hong pikhia uhen” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchi in mimante’n huai thute vaihawmte kiang ah a hilh uhi. Rome mite ahi uh chih a zakun a lauta uhi;
  </para>
  <para style="p">
    <verse number="39" style="v" />A vahohin a vakun ua, a pikhia uhi, khua a kipan paimang ding in a deih uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan suangkulha kipan a pawt ua, Lidia inn ah a lut uhi: Unaute a muh un, a khamuan ua, a pawtta uhi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Amphikoli khua leh Appo lonia khua tawn in, Thessalonika khua a tungta uh, huai ah Judate kikhopnain a om hi;
  </para>
  <para style="p">
    <verse number="2" style="v" />Paul, a dan ngeina bang in, a kiang uah a lut a, khawlni thumvei Laisiangthou a kipan in teltak in a sutpih hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Khrist in gimthuak ding him a hihdan leh misi lak a kipan a thounawn ding a hihdan hilhchianin, a hihlang zel hi. “Hiai Jesu, a thu k’on hilh, amah Khrist ahi” chi in a gen behlap hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in a lak ua khenkhat in a gingta ua, Pathian limsak Grik mipi thupitak leh numei makai tampi toh Paul leh Sila a kithuahpihta uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh gingtalou Judate’n a mullit ua; dawlmun a migilou thadah kuate hiam a kiang uah a tonpih ua, mipi samkhawm in khua pumpi a tokbuai ua, Jason inn a luh ua, vantang kiang a pikhiak a tum uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amau a muhlouh tak un Jason leh unau dang kuate hiam khaw heutute kiang ah a kailut ua, a kikou ua, “Khovel tokbuai a lumlette hiai ah a hong uhi”
  </para>
  <para style="p">
    <verse number="7" style="v" />Jason in a na zintun a; hiai mite’n Kaisar vaihawmna kalh in kumpipa dang khat, a min Jesu a om a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan mipi leh khaw heutute’n huai thu a zak un a buaita uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jason leh midangte tatkhiakna ding banghiam a la ua, amau tuh a khahta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan unaute’n a zanzan in Beriah khua ah Paul leh Sila a paisak pah ua; huailai a vatun un Judate kikhopnain ah a lut uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai mite Thessalonika khuate sang in a na hoihzaw ua, huchi in lungsim kipaktak in thu a pom ua, a thugen uh a dik leh diklouh theihna ding in niteng in Laisiangthou a zong zel uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in huaite mi tampi in a gingtata uhi; Grik numei zahtakhuai leh pasalte leng tampi mahmah in a gingtata uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh Thessalonika khua a Judate’n, Paul in Beriah khua ah Pathian thu a gen chih a zaktak un, huai ah leng a vahoh ua, mipite hanthawn in, a hihbuai nawn uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in unaute’n tuipi tan a pai ding in Paul a sawlkhia ua, Sila leh Timothi bel huai ah a omtadih uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Paul pitute’n Athen khua tan in a pi ua; Sila leh Timothi kintak a a kiang a hongpai ding a thukhah pua in a paikikta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Paul in Athen khua a amau a nangak lai in, huai khua milim pathian a dim in a mu a, a lungtang in na a sa mahmah hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in kikhopnain ah Judate leh Pathian limsakte a houlimpih zel a, dawlmun ah leng huai a na om peuhmahte toh niteng in a kihoulim zel uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Epikuria mi leh Stok mi lak a mi pil kuate hiam in leng amah a hong kiselpih uhi. “Hiai mi kamtam in bang ahia gen a tup?” a chi ua, a khen in “Jesu thu leh thohnawnna thu a genziak in gamdang pathiante thugenpa a hihtuak e” a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah a len ua, Areopaga ah a honpi ua, a kiang ah, “Hiai sinsakna thak na gengen n’on theisak thei diam?
  </para>
  <para style="p">
    <verse number="20" style="v" />Thil lamdang banghiam ka bil uah na hontun ahi; huchi in, hiai thil omdan theih ka ut uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Athen khomi tengteng, huai a mikhualte toh, a man peuh ua leh thu thak photphot gen hiam, a ngaikhia ding in a hunte uh a zang zel uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in Areopaga laitak ah Paul ading a, “Nou Athen khua a mite aw, bangkim ah sabiak limsaktak mi na hi uh chih ka thei hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Ka vakkawm a, na biaknate uh ka etlai in, maitam khat, a tung a, ‘Theihlouh Pathian’ ading, chi a kigelh, ka mu ahi. Huchi in theilou a na biak uh, huai thu k’on hilh ahizaw hi, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian khovel leh asung a thil tengteng siampa, lei leh van Toupa a hih ziak in khut a lam inn peuh ah a omkei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Thil tasam bang in mihing khut a nasepsak in leng omkei, amah mah bangkim kiang a hinna, hatna leh thil tengteng pepa ahizaw hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan leitung maikaih teng a om ding in bul munkhat vek in namchih a siam a, amau ading in hunbi a sehsak a, tenna ding gamgi a khunsak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman hon gamlat keimah leh mitengteng in Pathian a zon ua a mai a mai ua, a muh teiteina ding ua a lemgel ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Noumau laphuahsiam kuate hiam in leng, ‘ei leng a suante i hi uh, chi a a genbang un. Amah vang in i hing in i tang in, i om uhi.’
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in ‘Pathian suante i hihnung, Pathian dangkaeng peuh, dangka peuh, suang peuh, mihing khutsiam leh suktuah sekte bang ahi chih i gingta ding uh ahi kei hi.’
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in Pathian in i theihlouh laikhawng a kitheihmohbawl a; himahleh, tun ah zaw gamchih a mi tengteng kisik ding thu a peta hi, ni a chiam ziak in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huai ni chiang in Pathian in a miseh zang in dikna in khovel vai a hawm ding; a miseh tungthu amah misi lak a kipan a kaithou in, mitengteng kiang ah a theisakta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan misi thohnawnna thu a zaktak un, a khen in a nuihsan ua; a khen in, “Hiai thu na kiang ah ka ngaikhe nawn ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in Paul tuh a lak ua kipan a pawtta hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Himahleh mi kuate hiam amah lam ah a pang chinten ua, a gingtata ua, huailak a khenkhat Areopaga mi Dionisia leh numei khat a min Damari leh a kiang ua midangte toh ahi uhi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thilte zoh in Athen khua a kipan Paul a pawt a, Korinth khua ah a hohta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan a min Akuila, Juda khat a mu a, huai mi Pontus gam a piang ahi a, Klaudia in Judate tengteng Rome khua a kipan pawtthu a piak ziak in a zi Priscilla toh Italy gam a kipan hong tungphet ahi uhi. Paul huai mite kiang ah a tungta hi,
  </para>
  <para style="p">
    <verse number="3" style="v" />A nasep uh kibang a hih ziak in amau a kikoppih in na a semkhawm ua; a nasep uh puanin bawl ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Khawlni teng in kikhopnain ah chitaktakin thu a genzel a, Judate leh Grikte thuzoh a tum hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Masidonia gam a kipan Sila leh Timothi a hongsuk un, Paul thugen kia in a omta hi, tua Jesu hi Khrist ahi chih Judamite kiang ah a hilhchian zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Himahleh a kalh un a gensia ua, Paul in a puan a sing a, a kiang uah, “Na sisan mawh uh noumau lutung ah om hen; kei zaw ka hul ahi; tuban Jentelte kiang ah ka pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan huai a kipan a pai a, a min Titas Justa mi khat inn ah a lut a, huai min Pathian a be zel hi, a inn leng kikhopnain toh a kizom ahi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Krispus pa kikhopnain heutu in a inkuanpihte tengteng toh Toupa a gingta a, Korinth khua a mi tampi’n leng za in a gingta ua, baptisma a tang uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Zan in Toupa’n Paul kiang ah mengmu bang in, “Lau kenla, dai lou in thu genzel in;
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei na kiang ah ka om a kei hiam, sihna ding in kuamah in na tung ah khut a khakei ding uhi; hiai khua ah mi tampi ka nei ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Paul huai ah a lak uah Pathian thuhilh in kum khat leh kha guk a omta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Gallio tuh Akaia gamukpa a hihlai in Judate’n kituakin Paul kalh in buaina a bawl ua, vaihawmna tutphah ma ah a pi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Huai mi’n danlou bang in a Pathian be ding in mi a khempuk hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Paul in a dawn dek leh Gallio in, Judate kiang ah, “Judate aw, hiai thildiklou thu hiam, thil hihkhelh thu hiam bek hileh, pellou in k’on awlmoh ding hi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh thumalte leh minte, noumau danthu lel zaw noumau kingaihtuah zaw un; ken zaw huchibang thu ngaihtuah ka ut kei” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan vaihawmna tutphah a kipan in amau a delhkheta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Grik mi tengteng in kikhopnain heutu Sostheni a man ua, vaihawmna tutphah ma ah a vua uhi. Gallio in a thilhih uh khawk a sa kei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huaizoh in Paul ni sawttak a tam nilouh a; huai zoh in unaute kampha in a kha a, huai a kipan Suria gam lam ah long in a paita, a kiang ah Priscilla leh Akuila leng a pai sam uhi. Paul in thuchiam a neih ziak in Kenkriai khua ah sam a metphot hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan Ephesa a tung ua, huai ah amau a nuseta; amah bel kikhopnain ah a lut a, Judate kiang ah chitaktakin thu a sutpih hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan sawt deuh tam ding in a khou ua, himahleh a ki awi kei hi,
  </para>
  <para style="p">
    <verse number="21" style="v" />“Pathian in a phal leh na kiang uah ka hong nawn ding” chi in, kampha in a khen a, Ephesa khua a kipan long in a paita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Kaisaria khua ah a hong kai a, Jerusalem khua ah a hohtou a, saptuamte chibai a buk hi; huaikhit in Antiok khua ah a hohsukta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan huai a sawtkuam a om nung in a pai nawn a, nungzuite tengteng hihkip in Galatia gam leh Phrigia gam a tawnsuak vek hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan Judami khat, a min Apollos, Aleksandria khua a piang, mi piltak, Ephesa khua ah a hohsuk a; aman Laisiangthou a nak theih mahmah hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiai mi’n Toupa Lampi thu zilsa ahi a, lungsim a phatuamngaitak a hih ziak in Toupa thu a hilh zel hi, Johan baptisma thu kia a thei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kikhopnain ah hangsantak in thu a gen hi. Huchi in Priscilla leh Akuila in a thugen a zak un, a in uah leh a kiang ah Pathian Lampi thu kichian sem in a hilhchianta uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman Akhaia gam a paikai a tuptakin unaute’n a hanthawn ua, amah a kipahpihna ding un nungzuite kiang ah lai a gelhsak uhi. Huan a tun in, Pathian hehpihna ziak a gingtate nakpitak in a panpih hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Vantang theih in Judate nakpitak in a seldong a, Laisiangthou zang in tua Jesu Khrist ahi chih a theisak hi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Korinth khua a Apollos a om kal in Paul in saklam gamte tawnsuak masa kawm in, Ephesa khua a tung a, nungzui kuate hiam a mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Aman a kiang uah, “Na gintak chil ua pan Kha Siangthou na tang uhia?” a chi hi. Amau a kiang ah, “Tanglou, Kha Siangthou a om chih zak leng ka za kei uh,” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman, “Bang baptisma ahia na tan uh?” a chi hi. Amau Johan baptisma, a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Paul in, “Johan in zaw a nung a hong paipa Jesu gingta ding a mite hilh in kisikna baptisma in a baptist zel ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan huai thu a zaktak un Toupa Jesu min in baptisma a tang uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Paul in a tung uah a khut a koih a, Kha Siangthou a tung uah a hongtungta hi. Huchi in paute in thu a gen ua; Pathian thu leng a hilhta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Avek un piching sawmlehnih vel ahi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Paul kikhopnain ah a lutzel a, kha thum phial hangsantak in thu a gen hi, Pathian lalgam thu gum in a sel a, mi a thuzoh zel hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh a khen a chihmawh ua, a gingta nuam kei ua, mipi ma a Lam a gensiat tak un, aman amaute a paisan a, nungzuite a pituam a, niteng in kisinsakna mun Tairanas ah thu hilh in a sutpih zel hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchibang ngen in kum nih phial a hih a; huchi in Asia gam a om tengteng, Judate leh Grikte’n leng Toupa thu a zata uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pathian in Paul khut in thillamdang taktak a hihsak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in a taksa sukha kinulna puan neu, puan tungsilh damloute kiang ah a hontawi ua, a natnate uh a damzel hi, asung ua kipan dawite leng a pawt uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Judami dawi hawlkhia chi a vakvai dawithu thei kuate hiam in, “Paul in a thu a tangkoupih Jesu Khrist min in k’on vau hi, chi in, dawimatte tung ah Toupa Jesu min a lou uhi.”
  </para>
  <para style="p">
    <verse number="14" style="v" />Judami siampu lian khat Skeva in huchibang hih tapa sagih a nei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh dawi in a kiang uah, “Jesu ka gingta hi, Paul leng ka thei hi, nou kuate na hi ua?” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan dawipai in a boh a, avek un a zou a, a nuaisiahta hi, huchi in huai mipa inn a kipan vuaktang leh liam in a taikheta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Ephesa khua a om tengteng, Judate leh Grikte kiang ah huai mi thu a thangta hi. Huan avek un a lau ua, Toupa Jesu min a lianta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan a gingtate leng a khen tampi a hong ua, a thilhih khelhte uh thupha a tawi ua, a kipulak uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mitkhialdawi hihmi a khen tampi in leng a laibute uh a hontawi khawm ua, mi tengteng mitmuh in a halta uhi; huan a man a sut ua dangka sing nga hi in a thei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi lawmlawm a thupi in Toupa thu a dalh a, a zouzel hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan huaikhit in, Paul in Masidonia gam leh Akhaia gam tawtsuak takdih a, Jerusalem khua a hoh a tum hi. “Huai a ka hohkhit chiang in Rome khua ka sik sam ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in amah nasepsakte nih Timothi leh Erasta Masidonia gam ah a paisak phot a, amah bel Asia gam ah a tam tadih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huailai in Lam ziak in mi buai petmah in a buaita uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Mi khat a min Demetrias, dangka siksek a Diana milim bawlpa a om a, khutsiamte ading in kilohna tampi a pia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Hiai mi in amaute a samkhawm a, a nasep bang uh semte toh; huan a kiang uah, “Pute aw, hiai nasepna i hauhna uh ahi chih na thei uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiai Ephesa khua kia hilou in, Asia gam khokim teng phial ah leng, Paul in khut a bawl pathiante Pathian ahi kei uh chi in mi tampi thuzoh in, a kiheisak khinta chih noumau ngei in na mu un na za uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in i nekzonna un a thuak ding chih a lauhuai kia hilou in, pathiannu thupitak Diana biakin leng a hon ngaineu ding uh. Asia gam a mi tengteng leh khovel a min a biak zel uh, a thupipi toh, a neu ding chih a lauhuai hi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huai thu a zaktak un, a heh mahmah ua, “Ephesa khua a Diana thupitak ahi” chi in a kikou uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in a khua in a pumbuai vekta ua, Gaias leh Aristarkhas, Masidonia gam a mi, Paul nungzuite, a man ua, kituaktakin etnop inn ah a taipih kheukhou uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Paul in mipi lak a lut a tup leh nungzuite’n a phalkei uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Asia gam a heutupente lak a khenkhat kuate hiam Paul lawmte ahi ua, a kiang ah mi a sawl ua, etnop inn ah lut teitei lou ding in a kun uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Omkhawmte a buai ua, mi tamzaw in a kikhop san uh leng a theikei uh, khenkhat thukhat in a kikou ua, khenkhat thudang in a kikou uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Mipi lak a mi khenkhat in Alexander a siamna thu gendan ding a hilhta ua, Judate’n amah mailam ah a sawnphei uhi. Huan Alexander in a khut in a zapa, mi tengteng kiang ah a siamna thu gen a tum hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Himahleh amah Judami ahi chih a theihtakun, dakkal nih sung aw kituak tak in, “Ephesa khua a Diana thupitak ahi” chi ngen in a kikou uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan khosung laigelhpa’n mipi a sukdaih khit in, “Ephesa khua a mite aw, Diana thupitak biakin leh van a kipan a milim kia, Ephesa khuate a kem na hi uh chih, kua ahia theilou om?
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in hiai thu selvual ahihlouh nung in, na daidide ding uh ahi, thunung venglou in bangmah na hih ding uh ahi kei hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Hiai mi hiai n’on pite uh, biakin lokmi ahi kei ua, i pathiannu gensete leng ahi kei uh.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchi in Demetrias leh a lawm khutsiamte’n leng kua lak ah leng thubuai a neih uleh, thubuai genna innte honsa in a om vele, gam ukpate leng a om uhi; kihek uhen.
  </para>
  <para style="p">
    <verse number="39" style="v" />Thil dang buaina nei him na hih uleh, kikhopna ngeina ah a lem ding uh.
  </para>
  <para style="p">
    <verse number="40" style="v" />Tuni a thu vengvung ziak in salh lauhuai in i omta uhi, a thu om ngellou buaina bawl a ngohtheih i hi ngal ua, hiai kikhopna san bangmah gen ding theilou ding i kei uhiam” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan huchibang thu a genkhit in omkhawm heutute a kikhenzak sakta hi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Buaina a vennungin, Paul in nungzuite a samsaka, a hanthawn a, kampha in a kha a, Masidonia gam a pai ding in a pawtta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Thu tampi a nungzuite hanthawn in huai gam a tawnsuaka, Grikte gam a tungta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan huai ah kha thum a tam hi. Suria gam a long a zindek kuan in, Judate’n amah thah a sawm ziak un, Masidonia gam tawn a kilehkik a tum zawta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Asia gam tana amah zuite, Pirha tapa Sopater Beriah khomi, Thessalonika khua apan Aristarkhas leh Sekunda te, Darba khomi, Gaias, Timothi leh Asia gam a Tikika leh Trophimas te ahi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaite’n ka ma uh a kai ua, Troas khua ah a hon na ngak uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kou bel tanghou silngou sohlouh ni a bei in Philippi khua a kipan long in ka pawt ua, ni nga nung in Troas khua ah a kiang uh ka tung uhi; huai ah ni sagih ka tam uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan ni sagihni masapen in, tanghou balkham ding a ka kikhoplai un, Paul in a kiang uah thu a gen hi; aman a zingchiang a pai a tup ziak in zankim tanhial thu a gen hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan indan tungnung ka omkhawmna uah khawnvak tampi a om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan a min Eutikas tangval khat tohlet ah a tu a, a na lusu hi. Huan Paul in thu a gen sawttak ziak in aman a ihmut suak a thuakzouta kei a, insawng thumna a kipan in a keta a, a sisa in a phong uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh Paul a kumsuk a a bohkhum in a angpom a, “Lunglau kei un, a laitat kei lai hi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan Paul a kahtou nawn a, tanghou balkham in an a ne a, sawtpi khovak pha hial in a kiang uah thu khotang a gen a, huai nung in a paita hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan valnoupa dam in a pi ua, a khamuang petmah uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan koute Assos khua zuan in long in ka na pai masa ua, Long ah Paul tuansak ka tum uhi; aman khe a paina lam tot a tup ziak in huchibang tuh amah geldan ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Assos khua a a hontuah chiang in, long ah ka tuangsakta ua, Mitilini khua ka tung uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan huai a kipan in long in ka pai nawn ua, a zing in Khios tuikulh zawn ka tung ua; huan a zingnawn in Samo tuikulh ka tung ua, Troguliam ah ka giak uhi. A zingnawn in Mileta khua ka tung nawn uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Paul in Asia gam a omsawt a utlouh ziak in, Ephesa khua long in khen a tupsa him ahi a, a hih theih leh Jerusalem khua ah Pentikost ni huam tum in a kin pai hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Mileta khua a kipan in Ephesa khua ah mi a sawl a, saptuam upate a kiang ah a samsak hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan a kiang a hongtun un, aman a kiang uah, Asia gam ka tot chil ni a kipan na kiang ua ka omsung teng in ka omdan na thei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Thunuailut pen kawm leh Judate’n hon sawm ziak ua khitui kai leh thilhaksa ka tung a tungte thuakkawm in Toupa na ka sem hi,
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchibang in a phatuam ding thu na kiang uah bangmah im ka neikei a, vantang lak leh inn teng ah thu k’on hilh zel hi,
  </para>
  <para style="p">
    <verse number="21" style="v" />Judate leh Grikte kiang ah leng Pathian lam a lungsim ngat thu leh, i Toupa Jesu Khrist lam a ginna thu ka theisak zel hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ngai un, tuin Kha in honsawl teitei a ka theih ziak in, Jerusalem khua a hoh dia kisa ka hi, huai ah ka tung a thil hongtung ding bangmah ka theikei hi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Kha Siangthou in, henna leh haksatna in nang hon dawn hi, chi in, khaw teng ah a honhilh zel hi, tuate kia ka theih ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh ka kitaitehna lam ka maban tun ding leh Toupa Jesu kiang a huai nasepna ka muh pen semkhin phot leng, ka hinna leng khiaklah tham in ka sep kei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Huan thei un, noute tengteng, Pathian lalgam thu tangkoupih a ka vakvaknate’n ka mel na mu nawnta kei ding uh chih ka thei hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huaiziak in mi tengteng sisan ah ka hul ahi chih tuni in k’on theisak hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pathian vaihawm tengteng avek in na kiang uah im ka neikei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pathian saptuamte, amah sisan a a leite, vak ding in noumau leh na heute uh tengteng tung ah pilvang un, Kha Siangthou in a tung uah nou heutu in a honbawl hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ka pai nung in ngehangte na lak uah a honglut ding ua, pawlte a hawikei ding uh chih ka thei hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Noumau lak a mi nangawn, nungzui pawlte amau lam a kaimang ding in thu tuam gen na hongom ding uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in limsak unla; kum thum hilhial khitui kekawm a, sun leh zan a michih taihilh ka tawplouh dan, theigige un.
  </para>
  <para style="p">
    <verse number="32" style="v" />Tuin noute Pathian leh a hehpihna ah k’on kemsak hi, tua in noute hon bawllian thei a, mi lungsim siangthoute kiang ah goutan a hon neisak theilai hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kuamah dangka, dangkaeng leh puansilh ka eng ngeikei hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Hiai khutte’n keimah leh ka lawmte taksap a sepkhiak zel dan, noumau ngei in na thei uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Bangkim ka hih peuhmah na chin ding ua ka hih ahi, huchibang a semgim leh, Toupa Jesu thu theigige kawm in mihatloute na panpih ding uh ahi; amahmah in, ‘laksang in piak in lukhong a neizaw’ a chih” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huai thu a genkhit in a khukdin a, avek un a thum uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan avek un a kap huphup ua, Paul ngawng ah kawi in a tawp uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A mel a muhnawn taklouh ding thu a gen a lungkhamna pen uh ahi. Huan long pha in amah a va kha uhi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi a honghi a, amaute toh ka kikhen ua, long in ka pawt ua, huaikhit in tangtak in Kos tuikulh ka tung ua, a zing in Rodi tuikulh ka tung nawn ua, huai a kipan in ka pai zel ua, Patara khua ka tung uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Phoinisia gam paiding long khat ka mu ua, ka tuang ua, ka pai zel uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan Kupra tuikulh ka mu ua, veilam pang ah ka kheng ua, Suria gam ah ka pai zel ua, Tair khua ah longvan nawnkhiak ding a om manin ka kumphot uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nungzuite ka zongkhia ua, huai ah ni sagih ka tam uhi; huan Kha theihsak in Paul kiang ah, Jerusalem khua a hohtou lou ding in a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh huai nite khitin ka pawt ua ka paita ua, unaute’n avek un, a zi a tate utoh khopi pua dong a hongkha ua; tuipi piau ah ka khukdin ua, ka thum uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Mangpha ka kikhak zohun, long ah ka tuang ua, amau bel a inn uah a pai nawnta uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Tair khua a kipan long a ka paikhit un Ptolema khua ka tung ua, unaute chibai ka buk uhi, a kiang uah ni khat ka nituang uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a zing in ka pawt ua Kaisaria khua ka tung ua huai ah Tanchinhoih genpa, Philip inn ah ka lut ua, amah tuh sagihte lak a khat ahi a, a kiang ah ka tam uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai mi’n tanu li, nungak siangthou ngen a nei a, amau zawlnei bang in thu a genkhol zel uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai ah ni tampi ka tam ua, huailai in Judia gam a kipan a min Agaba zawlnei khat a hongsuk hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ka kiang uah a hong a, Paul kawnggak a la a, a khete, a khutte amah in a kigak a, “Jerusalem khua a Judate’n hichibang in hiai kawnggak neipa a gak ding ua, Jentelte khut ah a pelai ding uhi, Kha Siangthou in a chi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan huai thu ka zaktak un, kou leh huai khua a mite’n Paul Jerusalem khua a hohlou ding in ka khou chiat uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh Paul in a dawng a, “Bangchi na hi ua, na kahkah uh, n’on khasiatsak uh? Toupa Jesu min ziak in Jerusalem khua a hen kia hilou in, sih leng ngap ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan khouhzoh vual ahihlouh tak in, ka tawpta ua, “Toupa thuthu hi hen aw” ka chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai nung in ka van uh ka bawl ua, Jerusalem khua ah ka hohtou uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kaisaria khua a mi nungzuite kuate hiam, ka kiang uah a pai ua, amau, a min Mnason inn, nungzui masa pawl Kupra tuikulh a mi khat ka tunna dingpa uh a pi sam uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Jerusalem khua ka tun un unaute’n nuamtak in a hon na kipahpih uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A zing in Paul toh Jakob kiang ah ka lut ua; huai ah saptuam upate tengteng leng a om uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Paul in amau chibai a buk khit in, a nasepna zang a Pathian in Jentelte lak a thil a hihsak peuhmah avek in a gen hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Unaute’n huai thu a zak un Pathian a pahtawi uh; huan Paul kiang ah, “Unaupa, Judate lak a gingtami tamdan na mu a; avek un dan lam ah phatuam a ngailai uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nang Jentelte lak a Juda omte tengteng kiang ah a tate uh zeksum louh ding leh dan bang a omlouh ding chi in, Mosi dan paihkhiakna ding na thuhilh zel chih mi kam ah na thu a thei vek uhi,” a chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Bangchi hita ding ahia le? Na hongtung chih a za ngal ding uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huaiziak in na kiang a ka gen bang un hih in; thuchiam nei pasal li ka kiang uah a om uhi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai mite pi in la, a kiang uah kisiangsak sam inla, a sam uh a met theihna ding un amau din sum seng in; huchi in mi tengteng in mi kam a na thu a zak teng uh gentham ahi kei chih a thei ding ua, nangmah mah Dan zui in kichiantak in na omzaw chih a thei ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jentelte lak a gingtate thu zaw, milim biakna thil neklam ah, sa sisan nek thu ah, sa heklup neklam ah, kingaihlam a kipan in a kihulsak ding uh ahi, chi in, ka gen ua, ka gelhta uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan a zing in Paul in pasalte a pia, a kiang uah a kisiangsak a, Pathian biakin ah a lut a, amau dia sagoh ding a piaksak chiat masiah kisiansakna ni a neiphot ding uh chih, siampu kiang ah a hilh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kisiansuahna ni sagih a chin dektak in Asia gam a Judate’n Pathian biakin ah Paul a mu ua, mipi tengteng a hanthawn ua, amah a man ua, a kikou uhi;
  </para>
  <para style="p">
    <verse number="28" style="v" />“Israel mite aw, hong huh un! Hiai mi, gam teng a mi tengteng kiang a Judamite dante, hiai innte gensepa ahi; huailou leng, Pathian biakin ah Grik mite a lutpih a, hiai in siangthou a hihbuah khin” a chi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huai ma in khua ah Ephesa khua a mi Trophimas a kiang ah a mu ua, Paul in huai mi Pathian biakin ah a lutpih a gingta uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan a khua in a kising kheukhou ua, mite a taikhawm ua; Paul a man ua, Pathian biakin a kipan a kaikhia ua; kongkhakte a khakpah ngal uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah hihlup a tup laitak un Jerusalem khua a mi tengteng a buai uh chih sepaih pawl heutu lianpen kiang a tungtou hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Aman sepaihte leh sepaih za heutute a pipah a, a kiang uah a taisuk uhi; heutu lianpen leh sepaihte a muhtak un Paul vuak a tawpta uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sepaih heutu lianpen in a honnaih a, Paul a len a, khainiang nih butsak ding thu a pia a; kua ahia a hih a bang ahia a hih a dong hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mipite a khen thukhat in a kikou ua, a khen thu dang in a kikou ziak un, buaina ziak diktak a theikei a, kulh a pilut thu a pia hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Paul kalbi a tunlai in mipi a hiamgam ziak un sepaihte’n amah a pumzawn uhi;
  </para>
  <para style="p">
    <verse number="36" style="v" />Mitengteng in, “Hih mangthang un” chi a kikou in, a zui uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Sepaihte’n kulhsung a a pilut deklai un Paul in, sepaih heutu lianpen kiang ah, “Na kiang ah thu kamkhat ka gen thei diam?” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan aman, “Grik pau na thei maw? Tuma a mite hanthawn a, gamdai mun a mihing sang li suam a thatte heutupa Aigupta mi na hi kei maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Paul in, “Silisia gam a Tarsa khua a om Judami ka hi, khopi neu liailou khat khua leh tui ka hi; hon hehpih inla, mi tengteng kiang ah thu hon gensak in” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan a lemsaktakin kalbi ah Paul ading a, mi tengteng daihna ding in a khutvan a; huan a daih duam tak un Hebru pau in a kiang uah thu a gen hi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Unaute aw, pate aw, tun ah na kiang uah ka siamna thu k’on hilh ding hi, ngaikhia un, a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Hebru pau in a kiang uah thu a gen chih a zaktak un, a dai nawnsem ua; huan aman:
  </para>
  <para style="p">
    <verse number="3" style="v" />“Judami ka hi a, Silisia gam a Tarsa khua a piang ka hi. Himahleh hiai khua ah Gamaliel khebul a zila khanglian ka hi, i pipute Dan omdan kimtak zilzel a om ka hia, tuni a noumau tengteng bang in Pathian ading a phatuam ka ngaisam hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiai Lam a mite that hial khop in ka sawizela, numei pasal ka hen a, suangkulh ah ka khumsak hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Siampu Lianpen leh upate tengteng in leng huai thu hon theihpih ua, amau a kipan in leng unaute piak ding in lai ka mu hi, huan Damaska khua a omte sawi ding leh hensa a Jerusalem khua a pi ding in ka hoh hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Huan hichi a honghi a, ka pai a Damaska khaw kiang ka tun in, sunlai in, thakhat in van a kipan vak thupitak ka kim ah a hongvak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan lei ah ka puk a, ka kiang ah, Saul, Saul, nang bang a chia honsawi? chi in aw ka za hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan ken Toupa kua na hia? chi in, ka dong hi. Aman ka kiang ah, Nazaret Jesu na sawi ka hi, a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Ka lawmte’n vak a mu ua, hon houpihpa aw a za kei uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Ken, Toupa, bang ka hihdia? ka chi a. Toupa’n ka kiang ah, thou inla, Damaska khua ah lut in, thil tengteng na hihding a chih peuhmah a honhilh ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan huai vak thupi ziak in khua ka mu theita kei a, ka lawmte’n khut in a honkai ua, Damaska khua ah ka lutta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Huan mi khat, Ananias Dan lam a Pathian limsak leh huai a Judate tengteng lak a min hoih,
  </para>
  <para style="p">
    <verse number="13" style="v" />amah a hong a ka kiang ah ading a, ‘Unau Saul, mitvakna nei in,’ a honchi hi. Huaitak in amah ka mu theita hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman i pipute Pathian in a deihlam thei ding in hondeih a, Diktatpa hon musak a, a kamsuak za ding a honsep ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na muh leh na zak thu ah mitengteng kiang ah amah thu theihpihpa na hi ding.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan bangdia om maimai na hia? Thou inla, amah min in baptisma tang inla, na khelhna hihsiang tanla, a honchi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“Jerusalem khua a ka pai nawn nung in, Pathian biakin a ka thum lai in, mengmu bang in ka om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan kin inla, Jerusalem khua a kipan pawt in; ka tanchin na gen ding a pomtuak kei uh a hon chihlai ka mu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan ken, Toupa kikhopnain teng a nang gingta peuhmah ka hentasak a, ka vuak zel dan a thei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan na thu theihpihpa Stephen sisan a suahlai un kei leng a kiang uah ka ding a, a sihding lem ka nasa a, a hihlumte puante leng ka nakem hi, ka chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan aman, pai in, hiai a kipan in gamla tak a Jentelte kiang ah k’on sawl ding ahi, a hon chita hi, a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan huai thutan in a ngaikhia ua; aw ngaihtak in a kikou ua, “Mi hichibang hingtak ahi kei, khovel a kipan hih mangthang un” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A kikou ua a puan uh a lem ua, a pai ua, leivui a vik uhi,
  </para>
  <para style="p">
    <verse number="24" style="v" />huchi in sepaih heutu lianpen in Paul kulhsung a pilut thu a pia a, a tung ah huchitel a a kikouna uh a theihna ding in vuak kawm a dottel ding, a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Savun khau a a leh hensawm khit un, Paul in a kiang a ding sepaih zaheutu kiang ah, “Siamlouh tansak louh Rome mi vuak ding dan toh kituak hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Sepaih zaheutu in huai a zaktak in, sepaih heutu lianpen kiang ah a hoh a, “Na thilhih ding pilvang dih aw; hiai mi Rome mi a na hi” a chi a, a hilh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Sepaih heutu lianpen a hong a, a kiang ah, “Rome mi na hi maw? honhilh in” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman “Hi e” a chi hi. Sepaih heutu lianpen in, “Hiai khomi hihna ken sum tampi a ka lei ahi” chi in, a dawng hi. Paul in, “Kei zaw Rome mi a piang him ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in, dottel tumte’n amah a paisan pah ngal ua; sepaih heutu lianpen in Rome mi ahi chih a theih in a kihta a, a hen ziak in a lau hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A zing in Judate’n bangziak a Paul a hek uhiam chih theihtel tum in, sepaih heutu lianpen in amah a phel a, siampu liante leh vaihawm tengteng kikhop ding thu a pia a, Paul pisuk in, a ma uah a dingsak hi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paul in vaihawmte a en kilkel a: “Unaute aw, tunitan in Pathian mitmuh a hoihlam a ka theih peuhmah hih in ka om hi” a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan siampu lianpen Ananias in, Paul kiang a dingte kiang ah, a kam betsak ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Paul in a kiang ah, “Nang bang nuhngou bang lelpa, Pathian in a honbeng zaw ding hi, nang Dan bang a vaihawm ding a tu a, Dan lou bang a mibet ding na chi vial maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a kiang a dingte’n, “Pathian siampu lianpen bangdia tai?” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Paul in, “Unaute aw, siampu lianpen ahi chih ka theikei a ahi; na chipihte tung vaihawmte tung ah thu hoihlou gen ken, chih gelh ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Paul in a khen Saddukaite, a khen Pharisaite ahi uh chih a theih in vaihawmte lak ah a kikou a, “Unaute aw, Pharisai ka hi, Pharisai tapa leng ka hi; misi lametna leh thohnawnna thu ah vaihawmte mai a dinsak a om ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai a gentakin, Pharisaite leh Saddukaite a nakisel ua, vaihawmte a kilangta uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Saddukaite, misi thohnawnna a omkei, angelte, khate leng a om tuankei, a chi uhi; Pharisaite’n huai tegel a om chih a gen uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai thu in nakpitak in a buaita uhi; Pharisaite lam a mi laigelhmite khenkhat ading ua; a sel ua, “Hiai mi bangmah a gitlouhna i mu kei uhi; Kha hiam Angel hiam in a kiang a thugen hileh eite Pathian dou suak ding ihi uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan kituahlouhna lianpi a hongom tak in, sepaih heutu lianpen in Paul a bohzan uh a lau a, sepaihte kiang ah, a va hohsuk a, a lak ua kipan kulh a va pitou teitei ding a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan a zanin “Toupa Paul kiang ah ading a, “Khamuangtak in om in, Jerusalem khua a ka thu na theihsak bang in Rome khua ah leng na theisak ding hi,” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan ni a suah in Judate a panghuan ua, Paul a thah masiah uh bangmah ne a dawnlou ding in a kichiamta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai thubawlte sawmli sang a tamzaw ahi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Amau siampu liante leh upate kiang ah a hoh ua, “Paul ka thah masiah uh bangmah chiamlou ding in ka kichiam uh a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huaiziak in, nou vaihawmte toh a thu kichian nawnsem a ngaihtuah tum bang in, na kiang ua pekhe ding in sepaih heutu lianpen kiang ah a hem deuh in va gentou un; na kiang nai uh a tunma in kou amah that ding in ka mankhin uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh Paul sanggam nu tapa in a thusawm uh a naza a, kulh ah a valut a, Paul a vahilhta hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Paul in sepaih zaheutu khat a sam a, “Hiai tangval sepaih heutu lianpen kiang ah pi in, a kiang ah thu banghiam gending nei a hihtuak” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in sepaih heutu lianpen kiang ah a pi a, “Paul, hentapa’n, honsama, hiai tangval na kiang a honpi ding in a honsawla, na kiang ah thu banghiam gen ding a nei a hihtuak” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sepaih heutu lianpen in a khut in a len a, a simin a tuam paipiha, “Bang ahia honhilh ding na neih?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman, “Paul thu kichian nawnsema na ngaihtuah ding mah bang in, zingchiah vaihawmte kiang ah pisuk ding in Judate’n honnget hoih a sa chiat uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh a thu uh na gingta ken; a lak ua mi sawmli sang a tamzaw in thah a sawm ua, huai mite’n amah a thah masiah uh bangmah ne a dawn lou ding in a kichiam uh; tuin na thu ngakin mansa in a om uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Sepaih lianpen in tangval a paisaka, “Hiai thute n’on theisak chih kuamah hilh ken” a chi bikbek hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan sepaih zaheutu nih a sam a, “Zan ihsip hun in Kaisaria khaw pha a pai ding in sepaih za nih toh, sakol tungtuangmi sawmsagih toh, teitawimi za nih toh bawl un, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Gamukpa Felik kiang bita a tunsak theihna ding in Paul a tuanna ding un sakol na bawl ding in leng” a chi hi;
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan hichibang in lai a gelhta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Klaudia Lisia in Felik Gamukpa hoihpa chibai a buk hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiai mi Judate’n a mu ua, a thah deklai un a kiang uah sepaihte pi in ka hoh a, Rome mi ahi chih ka theih in ka honkheta hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan a hekna uh theih ut in, vaihawmte kiang ah ka pisuk hi,
  </para>
  <para style="p">
    <verse number="29" style="v" />huchi in a danthu uh banghiam a hek ahi chih ka thei a, himahleh a hekna thu uah sihna leh henna ding bangmah ka theikei hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan Judate’n amah a tang uh chih min a hon theihsaktak un, na kiang ah amah k’on sawl ngal ahi, a hekte leng a tung a thubuai a neih peuh uh na ma a gen ding in thu leng ka pia hi” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in sepaihte’n a thupiak bang in Paul a zanzan in a pi ua, Antipatri a tunpih uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan a zing in sakol tungtuangmite a kiang a pai zel ding in a kiksan ua, kulh ah a hoh nawnta uhi;
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan amau Kaisaria khua a tung ua, Gamukpa kiang ah lai a pia ua, Paul leng a ma ah a dingsak uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Gamukpa’n a simkhit in, Paul omna gam a dong hi. Huan Silisia gam a ahi chih a theih in,
  </para>
  <para style="p">
    <verse number="35" style="v" />“Nang hon hekte a hongtun chiang un na thubuai ka ngaihtuah ding” a chi hi. Herod thukhenna inn a vending thu a pia hi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan ni nga nung in siampu lianpen Ananias a hong tungsuk a, Upa kuate hiam toh, a min Tertulla thugensiam khat toh; Paul tung a thubuai Gamukpa kiang ah a gen uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Paul a sapkhiak nung un Tertulla in amah a hek pan a: “Felik hoihpen, nangmah vanga khamuang petpet a ka om ziak un leh n’on kepna ziak a hiai chite ading a giloute kham hoih a om zel ziak in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Chiklaipeuh in koipeuh ah leng lungkimtakin ka pom gige uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Abang abang hitaleh, nang adia chimtakhuai hih ka ut kei hi, na migitna in thu kamkhat ahihleh hon ngaihkhiak sak ding in k’on ngen hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiai mi huathuai pi, khovel a Judate tengteng tokbuaipa leh, Nazarit mite pawl a a makaipen khat uh a hih ka thei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian biakin hihbuah leng a tuma; huaiziak in ka man uhi,
  </para>
  <para style="p">
    <verse number="7" style="v" />Ka dan bang ua a tung a vaihawm tum hi ung a, himahleh sepaih heutu lianpen Lisia hong kuan a, ngongtat kawm in amah ka khut ua kipan a lamang a, a tung a thubuai neite na kiang a hongpai ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nangmah ngei in amah dongtel in ka hekna tengteng uh na theithei ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Judate’n leng huai thu huchibang ahi, chi in, a panpih uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Gamukpa’n thugen ding a Paul khut a a zaptakin: “Aman nang kum tampi hiai chite vaihawmsakpa na hih ka theih ziak in kipaktak in ka siamna thu ka gen ding ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jerusalem khua a Pathian be ding a ka hohtouh nung ni sawmlehnih a val naikei ding chih nana thei ding hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Pathian biakin ah leh kikhopnain ah leng khua ah leng kuamah ka sel leh mipi ka hanthawn amau zong a hon mu kei uh.
  </para>
  <para style="p">
    <verse number="13" style="v" />Tun ah leng a honhekna thu uh na theih in a bul a suikhe theikei ding uh.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh hiai thu na kiang ah ka genkhe ding, Dan leh zawlneite thugelh tengteng gingta in, Lam dan, pawl tuam a chihte uh bang in ka pipute uh Pathian ka be zel hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Mi diktatte leh diktatloute thohnawnna a om ding chih Pathian ah ka lamen a, hiai khawngte’n leng huai tuh a gingta sam uhi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Tua ziak in Pathian leh mihing tung a hihkhiallou ding in sialehpha siangtak nei ding in ka kibawl gige hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan kum tampi nung in ka chipihte kiang ah thilpiak ding leh thillat ding hontawi in ka honghi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai thil ka piaklai in, Asia gam a kipan Judami khenkhatte’n Tempul ah mipi panglou leh buaina omlou a, Pathian biakin ah kisiangsak in a honmu uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiai mite’n ka tung a thubuai nei hile uh na ma ah hongpai in a hong hekkhinta ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ahihkeileh hiai mite ngei in vaihawmte ma a ka din lai in, ka hihkhelh bang ahia a muh uh, gen uhen.
  </para>
  <para style="p">
    <verse number="21" style="v" />Hiai thu kam khat ziak houh a hih kei ngal leh, a lak ua ding in, Misi thohnawnna thu ah tuni’n na ma uah salhin ka om ahi, ka chih a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Felikin Lam thu a theihchet ziak in, “Sepaih heutu lianpen Lisia a hong tunsuk hun chiah na thu uh ka lem ding” chi in, a koih tadih hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Sepaih zaheutu kiang ah, Paul zalentak leh a lawmte a hongveh leh nektak a bawlsak utte khamlou a, vensak ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan ni bangzah hiam nung in Felik a hong nawn a, a zi Drusilla Judanumei toh, Paul a samsaka, Khrist Jesu ginna thu a ngaikhia hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Paul in diktatna thu, kidek thu, thukhen vaihawmna hongtung dingte a suipih detdet lai in, Felik in lauhuai a sa mahmah a, “Pai nawn phot inla, hunlem ka neih hun chiang in k’on sam ding” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Paul in dangka a piak peuh a lamen a, huaiziak in a sam mun sim a, a houpih zihzeh hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Himahleh kum nih a kivei sung in Porsia Festa in Felik a hon khengta hi; Felik in Judate lak a minhoih deih in, Paul hensa in a nuseta hi.
  </para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Festa in gamukna a lak in; ni thum nung in Kaisaria khua a kipan Jerusalem khua ah a hohtou hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Siampu liante leh Juda makaite’n a kiang ah Paul tungtang thu a selam in a na theisak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jerusalem khua a pitouh sak ding in hehpihna leng a na ngen ua; lampi a na buka thah a tum uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh Festa in, “Paul Kaisaria khua a kep ding leh amah leng huailam a ka hohpah ding.” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huaiziak in “Huai mi’n gitlouhna nei ahihleh na lak ua thunei peuhmah in hon zuisuk in honghek uhen” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A lak ua ni sawmval a tam nung in, Kaisaria khua ah a paisuka; a zing in thukhenna tutphah a tuin, Paul honpi ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Paul a hongtun phet in, Jerusalem khua kipan Juda hongsukte a kim ah ading ua, suikhiak vuallouh ding thubuai tampi giktak tak a gen uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Paul in a siamna thu a gen a, “Judate Dan hi in Pathian Biakin thu hi in, Kaisar tung ah leng bangmah hihkhelh ka neikei” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh Festa in Judate lak a min hoih a deihman in Paul kiang ah, “Jerusalem khua a hohtouha, huailai a ka ma a hiai thute lepsak na deih hia?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Paul in, “Kaisar thukhenna tutphah ma a, vaihawmsak a om ding in ka ding hi. Judate tung ah thil bangmah ka hihkhial kei chih nangmah in leng na theichian mahmah hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Migilou ka hih a, sihna khophial khelhna ka hihleh, sih leng ka nial kei; himahleh hiaite honhekna a bul bangmah a omkei leh, kuamah in a kiang uah hon pekhe theikei ding. Kaisar kiang ah ka tun ding” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Festa in a vaihawmpihte a houlimpih kimvel nung in, “Kaisar kiang ah thu natuna: Kaisar kiang ah na pai mahmah ding” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ni bangzah hiam nung in kumpipa Agrippa leh Barnisi Kaisaria khua a hongtung ua, Festa chibai a buk uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaia ni tampi a tam ziak un Festa in Paul thubuai kumpipa kiang ah a gen a, “Felik in mitang kuahiam a nusia hi
  </para>
  <para style="p">
    <verse number="15" style="v" />Jerusalem khua a ka omlai in siampu liante leh Juda upate’n a tungtang thu a honhilh ua, siamlouh tansak a hon ngen uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ken amaute kiang ah, a hekpa uleh a hekte a kimaituah ua, a hekna thu ua a siamna thu genna hunlem a neih ma in, mi kuahiam thah ding a piakkhiak Rome mite dan ahi kei hi, chi in, ka dawng hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in hiai lai ka hongtun un, sawt hallou in a zing in thukhenna tutphah ah ka tu a, huai mi tuh honpi ding in thu ka pia hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A hekte a dinlai un, ka muanmoh dan ngohna a tung ah gitlouhna thubuai a genkei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A sabiak thu ua, Jesu, mi khat sisa, Paul in a hingnawn ahi, chi a a gup ziak in a tung ah thubuai a nei uh a na hi zaw hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ken huai thute ngaihtuah ding dan ka theikei a, Jerusalem khua a hoh a, huailai a huai thu lepsak a ut leh utlouh ka dong hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh Paul in Kumpipa lepdia sit a ngen zawta hi. Huaiziak in Kaisar kiang a ka hohsak theih masiah veng ding in thu ka pia hi” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Agrippa in Festa kiang ah, hiai mi thu keimahmah in zak ka ut gige ahi, a chi hi. Aman, zingchiah a thugen na ngaikhe ding, a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in a zing in Agrippa leh Barnisi thupitak in a hong ua, thugenna in ah a lut ua, sepaih heutuliante toh, khua a milian deuhte toh; huan Festa thu in Paul a pilut sak uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan Festa in, “Kumpipa Agrippa leh hiai lai a om tengtengte aw, hiai mi na muh uh ahi, a tungtang thu a Judate tengteng in, hingtak nawnlou ding chi a kikou a, Jerusalem khua leh hiai lai a ka kiang a a hek uh ahi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh sihna ding khop bangmah ahihkei chih ka thei hi. Huan aman Kumpipa kiang a tut a tup ziak in sawl ka tum ahi;
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh a thu ginatakin bangmah gelh ding ka theikei hi. Huaiziak in na ma uah k’on pikhia hi, Kumpipa Agrippa nangmah ma a honpi tuanse ka hi a, etchet nung in banghiam bek gelh ding ka muh theihna ding in.
  </para>
  <para style="p">
    <verse number="27" style="v" />Hekna kiteltak omloupi a henta kuahiam Kumpipa kiang a sawl thil haihuai hi in ka thei hi” a chi hi.
  </para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaizoh in Agrippa in Paul kiang ah, “Na siamna thu na genthei hi, a chi hi. Huan Paul in a khutvan a, a siamna thu a gen hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Kumpipa Agrippa, Judate’n a hon hekna tengteng uah ka siamna thu gen ding a tuni a na ma a ka din theih hampha ka kisa hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Judate tawndan leh pupa ngeinate theisiam leh pil mahmah na hih ziak in ka kipak tuanse hi. Huaiziak in thuakzou tak in ka thugen hon ngaihkhiak sak ding in k’on ngen hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Ka tuailai hun a kipan ka chipihte lak leh Jerusalem khua a ka omdan Judate tengteng in a thei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A tung a kipan ka tanchin theite ahi ua, huchi a ka sabiak dan ua ngentel pen a khosa Pharisai ka hih dan a ut ua leh a hon genpih thei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian in ka pipute uh kiang a thu a chiam lametna ziak in hiai ah tuin vaihawmsak in ka ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai thuchiam lametna ziak in ka nam uh sawmlehnih in, sun leh zan in Pathian na phatuamngai tak a sem in muh a lamen uhi. Kumpipa aw, huai lametna tungthu ah Judate’n a hon hek uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pathian in misite a kaithou ding chih bangchidan a thil hitheilou a ngaihtuah na hi ua?
  </para>
  <para style="p">
    <verse number="9" style="v" />“Kei mahmah in Nazaret Jesu min kalh a hihtheih teng hih thil hoih in ka na ngaihtuah hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai bang Jerusalem khua ah leng ka hih zel hi; siampu liante kiang a thu mu in, misiangthoute lak a mi tampi suangkulh ah ka khum zel hi; a hihlup lai un lemsa lam ah leng ka na pang zel hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan kikhopnain teng ah ka sawi gige a, Jesu thu gensiatsak ka tum teitei hi. Huan a tung uah ka gilou mahmah a, gamdang khua tanpha in leng ka sawi zel hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Huchibang a hih ding in siampu liante thu mu in leh a sawlna lai uh tawi in Damaska khua ah ka hoh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kumpipa aw, huchi a ka pailai in sunlaitakin, nivak sang a vakphazaw van a kipan in keimah leh ka paipihte kim ah hongvak ka mu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ka vek un lei ah ka puk ua, Hebru pau in, Saul, Saul, nang bang a chia honsawi? Sutna chiangzum tot nang dia na ahi, chi in ka za hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Ken Toupa, kua na hia? ka chi hi. Toupa’n, na sawi, Jesu ka hi a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh thou inla ding in; hiai na thilmuhte leh na kiang a k’on lahlai dingte semding leh theihpih dia sikha a nang honbawl ding in na kiang ah ka hong kilak ahi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Mitengteng leh ka honsawlna mite, Jentelte khut a kipan k’on humhing ding hi;
  </para>
  <para style="p">
    <verse number="18" style="v" />A mit uh hihvak ding in a kiang uah k’on sawl ahi, huchi in mial apan vaklam a nga ding ua, Setan thuneihna Pathian lam a ngatsan ding uhi, khelhna ngaihdamna a muhna ding uleh a hon gintak ziak ua sehtuam siangthoute lak a goutan a neihna ding un, a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Huaiziak in kumpipa Agrippa aw, van a kilakna ka selkei hi,
  </para>
  <para style="p">
    <verse number="20" style="v" />A tung in Damaska khua a mite kiang ah, huan Jerusalem khua a te kiang ah, Judia leh gamchih a mite kiang leh Jentelte kiang ah leng kisik minpu a thilhih a kisik a, Pathian lam a ngatna ding un ka hilhzaw hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huaite ziak in Judate’n Pathian biakin ah a hon man ua, hon hihlup a tum uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh Pathian kiang a kipan a panpihna ka muh ziak in tunitan in mi neute leh mi liante kiang a thu theisak in ka omlai hi, zawlneite leh Mosi in hongtung ding a chih thu kia uh loungal thu dang genlou in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi a, Khrist in gim a thuak ding a, misi lak a kipan a thohnawn ziak a mi tengteng kiang leh Jentelte kiang a vak musakpa masapen ahi ding a chih thu uh, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchibang a a siamna thu a genlai in, Festa in, aw ngaihtak in, “Paul, hai na hi; na theih tamna in nang hon haisak hi” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh Paul in, Festa hoihpen, “Hai kei veng e; thu diktak leh thu piltak ka genzaw ahi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiai thute kumpipa’n a thei vaw oi, a kiang ah leng laulou in ka gen hi; hiai thil bangmah a kiang ah im ahi kei chih diktak in ka thei hi. Hiai thu inkil kawm peuh a a guk a hih ahi kei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kumpipa Agrippa, zawlneite na gingta hia? Na gingta chih ka thei” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Agrippa in Paul kiang ah, “Sawtlou chik sung in Khristian n’on suaksak zoudek” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Paul in, “Sawt in sawt kei leh, nang kia ka chi kei, tuni a ka thu za tengteng leng keimah bang a om ding in Pathian kiang ah ka ngen ahi, kolbun tuanse lou in” a chita hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan kumpipa toh, gamukpa toh, Barnisi toh, a kiang ua tute toh ading chiat uhi;
  </para>
  <para style="p">
    <verse number="31" style="v" />A paituam ua a kihou ua, “Hiai mi’n sihna leh kolbutna khop hial thil bangmah a hih kei” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Agrippa in Festa kiang ah, “Hiai mi’n Kaisar kiang a tut ding na chikei leh pawt mai ding hiven” a chi hi.
  </para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Italy gam a long a pai ding thu a hihpuk tak un, Paul leh henta dang kuate hiam Augusta pawl a sepaih zaheutu a min Julia a kemsak uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan Adramittium khaw long, Asia gam tuipi piau a khaw omte tawn ding ah ka tuang ua, tuipi ah ka paita uhi; Masidonia gam a mi Aristarkhas, Thessalonika khaw mi ka kiang uah a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A zing in Sidon khua ka tawn uhi. Julia in Paul a limbawl ngial a, kihihhalh ding in a lawmte kiang ah a pawtsak hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huai a kipan in tuipi ah ka pai nawn ua, huih in a hilou lam a honmut ziak in Kupra tuikulh zul huih hatlouhna lam ah ka tai uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Silisia gam leh Pamphilia gamzul tuipi ka khennung un, Lidia gam a Mira khua ka tung uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai ah sepaih zaheutupa’n Aleksandria khaw long Italy gam tawn ding a mu a; huai ah ahon tuangsak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Ni tampi, awlawl in ka pai ua, Knidas khaw zawn haksapi in ka tung teitei ua, huih in hon sawnkik ziak in Salmoni zuan in Krit tuikulh zul huih hatlouhna lam ah ka tai uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Haksatak in tui geigei ah ka pai ua, Long khawlna Kilawm a chih mun uh ka tungta uhi; huai kiang ah Lasia khua a om hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan ni tampi a beitak ziak in leh long a pai a lauhuai ziak in, Anngawlni a khengta ngal a, Paul in amau a thuhilh a, a kiang uah,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Pute aw, tua long a tuangte siatna leh manthatna thupitak i tung ua tung ding ahi chih ka thei a, a sum leh long tung ah kia ka chi kei a, eimah tung ah leng ka chi ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh sepaih zaheutu in Paul thugen sang in longpu leh long neipa thu a gingta zaw hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Phalbi douna ding in longkhawlna a ginat louh ziak in a tamzaw in huai a kipan a tuipi a paikhiak a, Phinisi khua tun teitei a, huailai a phalbi dou a sawmpih ua; Phinisi tuh Krit tuikulh a longkhawlna khat ahi, malsak leh simsak lam ahi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Sim huih awlawl a a hong nuntakin a deihlam uh mu a kisa ua, sikkip a khai khia ua, Krit tuikulh zulzul ah ka pai uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh sawtlou nung in gam lam a kipan in huih hattak a hong nungsukta a, huai huih tuh Euroklidon a chi zel uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Long a hon mutkhata a, huihlam a ngat theihlouhtakin ka khahta ua, hon mutleng hon mutlengta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kauda tuikulh neuchik petmah pansan in huih hatlouhna lam ah ka tai ua, haksatak in long neu ka bitsak thei uhi;
  </para>
  <para style="p">
    <verse number="17" style="v" />A kaihkhiak nung un panpihna khaute khong a zang ua, long nuailam ah vialkawm in a khih uhi. Puanzakna bangkim a puksak ua, huchilou in zaw Sirti a lenlut a lau ua, huchi in a hon mutleng lengta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A zing in, tuikihawt in honsep ek ziak in, long a vante tui lak ah a paikheta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan a ni thumni in, amau khut in long vante a paikhe nawnta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan ni tampi ni leh aksi leng a kimu kei a, huihpi hat petmah in honnuai a, hin himhim ka lamen nawn kei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan an nelou a sawttak a om nung un, Paul a lak uah ading a, “Pute aw, Krit tuikulh a kiphellou dia, ka thuman a, hiai siat leh manthatna tuahlouh ding hizen a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh tun ah leng khamuangtak a om ding in k’on hanthawn hi. Na lak uah kuamah in hinna na mangsak kei ding uh, long zaw a mangthang ding.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amah Pathian a ka hih a a nna leng ka sep, amah angel tuzan in ka kiang ah a hongdinga, ka kiang ah,
  </para>
  <para style="p">
    <verse number="24" style="v" />“Paul, lau ken, Kaisar ma ah na ding ding. Ngai in, long a na kiang a zin tengteng leng Pathian in a honpia hi, a honchi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huaiziak in Pute aw, khamuangtak in om un, Pathian ka gingta hi, honhilh bang in a om ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh bang tuikulh hiam ah hon lenkhe ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Zan sawmlehli a chin zan in Adria tuipi ah huih in a langlang ah a hon mutleng leng lai hi. Zankim lai in, long mite’n koi gam hiam tungdek in a kithei uhi;
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in tui thukdan a teh ua, lam sawmnih in a thei ua, huan sawtlouchik in a tehnawn ua, lam sawmlehnga in a thei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan longmei lam ah sikkip li a khia ua, huchilou in zaw suang se mun ah hon lenkhe zenzen kha ding chih a lau ua; huan khovak kal a ngaklahta uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan longmite’n long malam a sikkipte khiak ding bawl a kineih in longneu tuh tuipi ah a khia ua long taisan a tum uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Hiai lai in Paul in, sepaih zaheutu leh sepaihte kiang ah, “Hiaite long a om gige kei uleh a bit kei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi in sepaihte’n longneu khaute a at tat ua, a khahta uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Khovak kuan in, Paul in an ne ding in mi tengteng a sawl a: Tuni ni sawmlehli ahita, bangmah nelou in na om ua, an na ngawl nilouh uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huaiziak in, an ne ding in k’on sawl chiat ahi; na damna ding uhi; na lak uah kuamah a samzang khat leng a mangthang kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai thu a genkhit in tanghou a la a, Pathian kiang ah kipahthu a genkhit in, mi tengteng ma ah a balkham a, a ne panta hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Amau leng khamuangtak in a om ua, an a ne samta uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Long a mite kavek un za nih leh sawmsagih leh guk ka hi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />An a nekkham khit un, buh tuipi ah a pai ua, long a hihzang deuh uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan ni a suah in, koilai gam ahia chih a theikei ua; himahleh, koilai longkhawlna hiam piautak nei khat a mu ua, huai tung ah a hih theih uleh long taikhiak sak a tum uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan sikkip khihnate a attat ua, tuipi ah a nusia ua; tua lai mah in kaihheina khihnate a phel ua, malam puanzak huih mut ding dan in a kaitou ua; piautak a zuanta uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Himahleh tuikihawt khauh nih kituahna mun ah ka lutkha zenzen ua, long in lei het in, huchi in, long mailam a tang bikbekta a, hihtat zoh louh in a om hi, long meilam bel tuikihawt a hat ziak in a kekgawpta hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan hentate tuiliau galkai khattou a om kha ding ua, a taimang kha ding uh chih a lauh manun sepaihte’n amaute hihlup mai a sawm uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Himahleh sepaih zaheutu in Paul humhing a ut a, a thiltup uh a khama; tuiliau siam peuhmah tuipi ah tawmkhiaka gam na kaimasa ding leh,
  </para>
  <para style="p">
    <verse number="44" style="v" />Midang a khen singpek tung leh a khen long van tung a kitholh galkai ding in thu a pia hi. Huchi in, avek un gam ah bittak in a galkai vek uhi.
  </para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan gam a ka suahtak un, tuikulh min tuh Malta ahi chih ka theita uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Tuikulh gammite’n hehpih in hon na hehpih ua; vuah a hongzuk ziak leh khovot ziak in mei a toh ua, ka vek un a hon na kipahpih uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Paul in singlom khat a toma mei ah a chih a, a sat ziak in gul a hong vakkhia a, a khut a tuin a tangden hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuikulh gammite’n ganhing a khut a kikhai den a muh un, “Hiai mi tualthat ahi ding, tuipi a kipan in taikhe mahleh diktatnain a hin a phalta lou ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh aman gul mei ah a singkhia a, bangmah a chi kei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Amau bel a bawk hiam, thakhat a puk paha si ding in a gingta uhi; hunsawtpi a ngak nilouh ua, bangmah a chi kei chih a theih un a lungsim uh a kheng ua, Pathian ahi a chi zaw uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai mun kiang ah huai tuikulh a hausapa a min Publia a om a, huai mi in a hon na kipahpih a, ni thum siamtakin a hon tungsak hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Publia pa khosik leh santen vei in a na lum a; Paul a kiang ah a lut a, a thum a a tung ah a khut a koih in a hihdamta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai a hihdam khit in tuikulh a midang natna nei peuhmah a hong ua; a dam chiatta uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai mite’n nakpitak in a hon na pahtawi ua; ka pai ding un ka vante uh long ah a hong koih uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan kha thum nung in, Aleksandria khaw long, phalbi a tuikulh a omsa, pathian phik, Kastor leh Pollux lutang kisuanna long ah ka pai uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Sirakasi khua ka tawn ua huai ah ni thum ka tam uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai a kipan ka paikawi ua, Rejiam khua ka tung ua; ni khat nung in sim huih a hongnung a, a zingnawn in Puteoli khua ka tung nawn uhi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai ah unaute ka mu ua, a kiang uah ni sagih tam ding in a hon khou ua; huchibang in Rome kholam ah ka pai zelta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan unaute’n ka Tanchin uh a zaktak un huai a kipan in Appii dawl leh Khualbuk thumte omna chiang ah hong dawn ding in a hong kuan ua; Paul in huai mite a muh in Pathian kiang ah kipahthu a gen a, a lungmuang mahmahta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Rome khua a ka lut un Paul bel a vengpa sepaih kiang a amah kia a om a phal uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ni thum nung in, Paul in Juda heutu deuh peuhmah a samkhawm a; a kihoukhawm ua, a kiang uah: “Unaute aw, mi tengteng leh i pipute dan tung ah bangmah ka hihlouh in leng Jerusalem khua a kipan in Rome khua a mite kiang ah a hon hentasak uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amau a hon etchet khit un sihna khop hial ka tung ah bangmah a muhlouh ziak un khah a hontum uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh Judate’n huai a sel ziak un Kaisar kiang tunlou thei ka hita kei a; himahleh ka chipihte hekna nei a hihbel ka hi kei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huailam thu a noumau honmu a hon houpih ding in ka honsam ahi; Israelte lamet thilte toh kisai a khainiang bun ka hi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau a kiang ah, na tanchin Judia gam a kipan lai in ka mu kei ua, unaute hiai a hong omte kuamah in na tungtang thubuai bangmah a pulak kei ua, gen leng a gen ngeikei uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh hiai pawl zaw gam teng ah gensiat ahi ngal ua, nang bangchi’n ahia na ngaih chih theih ka ut uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan ni a chiam ua, huai a tunna ah a kiang ah mi tampi a hong ua; zing a kipan nitaklam pha in a kiang uah huai thu a hilhchian a, Pathian gam thu a theisak a, Mosi dan laibu thu leh zawlneite laibu thu in Jesu lam ah amau a thuzoh zel hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Khenkhat in a thugen a gingta ua, a khen in a gingta kei uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan a kituakta kei ua, Paul in thu a genkhit in a paikheta uhi. A thugen tuh hiai ahi, “Kha Siangthou in zawlnei Isai kam a na pipute uh kiang a a thugen a dik mahmah hi chi in:
  </para>
  <para style="p">
    <verse number="26" style="v" />‘Hiai chite kiang ah vagen in, Bil in zaw na za na ding ua, a ngaihna zaw na theikei hial ding ua; muh zaw na mu ding ua, theih zaw na theikei hial ding uh:
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiai chite lungtang a takta a, a bilte uh a na ngong deuh a, a mit uh leng a si ua, huchilou in zaw a mit un a mu ding ua, a bil un a za ding ua, a lungtang un leng a thei ding uh, a kiheikik ding ua, ken ka hihdam kha ding hi’ a chi, a chihpen ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huaiziak in Pathian hotdamna thu Jentelte kiang a khakkhiak ahi chih thei un, amau zaw ngaih leng a ngaikhe ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi a hiai thute a genkhit nung in, Judate tuh a pawtkheta ua, amau lak ah nakpitak a kiselna a nei uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in Paul kum nih vengveng amah inluah ah a om a, a kiang a hoh peuhmah a na kipahpih hi,
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian gam thu a hilh a, Toupa Jesu Khrist thu hangsantak in a gen zel a, kuamah in amah lah a kham kei uhi.
  </para>
</usx>
