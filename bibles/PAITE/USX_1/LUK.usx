<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="LUK" style="id">Luke</book>
  <para style="h">Luke</para>
  <para style="toc1">Luke</para>
  <para style="toc2">Luke</para>
  <para style="mt">Luke</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thilte i lak ua takpetpet a gintak a om, mi tampi in a thu gelh a na tup uh,
  </para>
  <para style="p">
    <verse number="2" style="v" />A tung apat a mute leh thu nasemte’n a honhilh bang un,
  </para>
  <para style="p">
    <verse number="3" style="v" />Theophilus aw, a bul apat bangkim chiantak in ka sui a, kizom zel in nang ading in kigelh leh a hoih ding, ka chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Tuma a nang a honhilh uh thu dik ahi chih na theihsemna ding in.
  </para>
  <para style="p">
    <verse number="5" style="v" />Judia gam kumpipa Herod a damlai in, Abijah pawl a mi a min Zakariah a om a; huai mi in Aron tanute lak a khat zi in a nei a, a min Elizabeth ahi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A nih un Pathian mitmuh in diktat in a om ua, gensiatbei in Toupa thupiak leh a dan tengteng zui in a om zel uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh Elizabeth a chin ziak in ta a neikei ua, a nih un upa pitak ahi tuak uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan hichibang ahi a, a pawlte hihdan ngeina bang a Pathian ma a siampu nasem a a omlai in,
  </para>
  <para style="p">
    <verse number="9" style="v" />Siampu dan bang in Toupa biakin a lut leh gimlim hal a tan ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Gimlim hal hunlai in mipite avek un inn pua ah a na thum uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Toupa angel khat gimlim halna maitam taklam a ding in a kiang ah a kilak hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Zakariah in a muhtak in a lungzing a, lau leng a lau hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh angel in a kiang ah, “Zakariah, lau ken, na ngetna zak a a om ziak in, na zi Elizabeth in tapa hon neihsak dia, a min Johan na sak ding ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan nang nuam in na kipak ding a; amah a pian in mi tampi a kipak ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa ngaih in mi lian ahi dia, uain leh zu himhim a dawn kei ding; a nu sung apat in Kha Siangthou in a dim ding hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Israel suante tampi Toupa a Pathian lam uh a ngasak nawn ding hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Pate lungtang tate lam a ngasak ding, mi chihmawhte mi diktat pilna lam ngasak ding, Toupa adia mipite mansa a omsak ding a bawlkhol ding in Elijah lungsim leh thilhihtheihna pu in Toupa ma ah a pai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Zakariah in angel kiang ah, “Huai bangchi’n ka thei dia? Kei putek hi ing a, ka zi leng pitek ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Angel in a dawng a, a kiang ah, “Gabriel, Pathian ma ading zel ka hi; nang houpih ding leh hiai thu hoih honhilh ding a sawl ka hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Ngai in ka thugente a huntak a hongtung ding, na gintak louh ziak in huai thilte a hongtun masiah na daidide dia, pau leng na pau theikei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan mipite’n Zakariah a na ngak ua, Pathian biakin sung a a om sawt ziak in lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan a hongpawt in a kiang uah thu a gen theita kei hi; huchi in, biakin ah kha kilak a mu ahi chih a theita ua; a kiang uah chiamtehna te a bawl a, pautheilou in a om hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan hichi ahi a, a nasepna ni a kimtak in a inn ah a paita hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tua nite nung in, a zi Elizabeth a gaita a, kha nga a kisel zoh in,
  </para>
  <para style="p">
    <verse number="25" style="v" />“Mi lak a ka minse khuhna ding in, Toupa’n a honmuh in, hichibang in ka tung ah a hihta” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan a kha gukna ah Pathian in Galili gam a khua khat Nazaret a chih uah, angel Gabriel,
  </para>
  <para style="p">
    <verse number="27" style="v" />Nungak siangthou khat kiang ah a sawl a, huai nungak tuh David suan mi khat a min Joseph toh kikham ahi ua; nungak min Mari ahi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan angel a kiang ah a lut a, “Chibai, nang nakpitak a deihtuam: Toupa na kiang ah a om” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huai thu ziak in a lunghimawh mahmah a, bangchidan a chibai honbuk a diam aw? chi in, a kingaihtuah hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Angel in a kiang ah, “Mari, lau ken; Pathian apan deihsakna na tang hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Ngai in, na gai dia, tapa na nei dia, a min Jesu na sa ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amah mi lian a honghi ding a, Tungnungpen Tapa a chi ding uh. Toupa Pathian in a pu David mangtutphah a pedia,
  </para>
  <para style="p">
    <verse number="33" style="v" />Jakob suante tung ah tangtawn in a vai a hawm dia, a gam in bei ni a neikei ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan Mari in angel kiang ah, “Hiai bangchi’n a hithei dia? Pasal lah neilou ing a” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan angel in a dawng a, a kiang ah, “Kha Siangthou na tung ah a hongtung ding a, Tungnungpen thilhihtheihna in a hon liahkhum ding, huaiziak in misiangthou hong piangding leng, siangthou Pathian Tapa, chih in a om ding a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Ngai in, na sanggamnu Elizabeth in leng a teknung in tapa a paita; a ching a chih uh, tu kha a kha gukna ahita hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pathian thupawt himhim thil hitheilou a omkei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Mari in, “Ngai in, Toupa sikhanu ka hi, na thu bangzel in ka tung ah tung hen” a chi hi. Huan angel in a paisanta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huailai in Mari a thou a, singtang ah, Judia gam a khua khat ah a hoh pah hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Zakariah inn ah a lut a, Elizabeth chibai a buk hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan hichi ahia, Mari in Elizabeth chibai a buktak in, asung a naungek a kitawm a; Elizabeth Kha Siangthou in a hong dimta hi; aw ngaihtak in a kikou hi:
  </para>
  <para style="p">
    <verse number="42" style="v" />“Nang numei sapsap din na hampha hi, na gilgah leng a hampha hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ka Toupa nu ka kiang a na hong bangchidan ahia awi?
  </para>
  <para style="p">
    <verse number="44" style="v" />Ngai in, n’on chibai buk husa ka bil a a luttak in, a kipah ziak in ka sung a naungek a kitawm hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />A gingtanu leng a hampha hi, a kiang a Toupa thugen tangtung ding a hih ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan Mari in: “Ka nuntakna in Toupa a pahtawi e,
  </para>
  <para style="p">
    <verse number="47" style="v" />Ka kha leng ka Hondampa Pathian tung ah a kipak mahmah a.
  </para>
  <para style="p">
    <verse number="48" style="v" />A sikhanu namtom dan a mu a, a hehpih a; ngai in, tu nungsiah khang tengteng in hampha a honchi ding uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Amah Mi hat in ka tung ah thil thupitak hon hihsak a, a min leng a siangthou hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />A laudansiamte khang nawn tan in a hehpih zel hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />A ban in a thahatdan a ensak a, mi kisatheite a lunggelna uh a hihdalhta hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />A mangtutphah ua tu kumpipate a kaikhia a, namtomte a pahtawita hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Gilkial te thil hoih in a hihvah a, mihaute khutvuak in a paimang sakta hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />A sikha Israel taksap awng a huta a, a zahngaihna theihgigena ding in.
  </para>
  <para style="p">
    <verse number="55" style="v" />I pipute Abraham leh a suante kiang a tangtawn thuchiam a gen bang ahi.”
  </para>
  <para style="p">
    <verse number="56" style="v" />Mari kha thum vel a kiang uah a om a, a inn ah a kiknawnta hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huan Elizabeth nauneih a hong hunta a; huchi in tapa a hon neita hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />A vengte leh a sanggamte’n Toupa’n a hehpih mahmah chih a naza ua, a kipahpih uhi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Huan hichi ahi a, a ni giat ni’n naungek zeksum ding in a hongpai ua; a min ding in a pa min mah Zakariah sak a tum uhi.
  </para>
  <para style="p">
    <verse number="60" style="v" />A nun, “Hilou e, Johan sak ding ahi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />A nu kiang ah, “Na sanggamte lak ah hiai min pu kuamah a omkei uhi, a chi uhi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Huan a pa kiang ah chiamtehna bawl in, a min ding in bang sa le hang na deih a? a chi uhi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Huan laigelhna pek a ngen a, a min Johan ahi” chi in a gelh hi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Avek un lamdang a sa mahmah uhi. Thakhat in a kam hong kihong in a lei a hong kiphel a, Pathian phat in a hong paukheta hi.
  </para>
  <para style="p">
    <verse number="65" style="v" />A kim ua omte tengteng in a lauta ua; huchi in huai thute Judia gam singtang tengteng ah a thangta hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />A za peuhmah in, a lungtang un a vei chiat ua, “Huai naungek bangchi phet a honghi diam aw?” a chi uhi. Huan Toupa khut in amah a panpih hi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Huan a pa Zakariah, Kha Siangthou in a dim a, a genkhol a,
  </para>
  <para style="p">
    <verse number="68" style="v" />“Toupa Israel Pathian phat in om hen, a mite a hong veh a, tatna a bawlsak hi.
  </para>
  <para style="p">
    <verse number="69" style="v" />A sikha David inkuante lak ah hotdamna ki a hon bawlsak takziak in;
  </para>
  <para style="p">
    <verse number="70" style="v" />Tanglai a pan a zawlnei siangthoute kam a a gen bang in.
  </para>
  <para style="p">
    <verse number="71" style="v" />I doute lak leh hon haw tengteng lak a hotdam a i om ding thu,
  </para>
  <para style="p">
    <verse number="72" style="v" />I pipute kiang a a chiam zahngaihna tangtung sak ding leh a thukhun siangthou theigige ding in.
  </para>
  <para style="p">
    <verse number="73" style="v" />I pu Abraham kiang a kichiam a,
  </para>
  <para style="p">
    <verse number="74" style="v" />I doute lak a a hon humbit a, lau lou a a na i sepna ding in.
  </para>
  <para style="p">
    <verse number="75" style="v" />I damsung teng a a mitmuh a siangthou leh diktattak a omna ding in.
  </para>
  <para style="p">
    <verse number="76" style="v" />Ahi, Bawi, nang zaw Tungnungpen Zawlnei a honchi ding ua; a lampite bawlkhol ding in Toupa ma ah na pai ding hi.
  </para>
  <para style="p">
    <verse number="77" style="v" />A khelhnate uh ngaihdamna dia a mite kiang a hotdamna theihna pe din.
  </para>
  <para style="p">
    <verse number="78" style="v" />I Pathian lungtang a hehpihna ziak in, huchi a tunglam a kipan i tung a ni a tan chiang a,
  </para>
  <para style="p">
    <verse number="79" style="v" />Miallak leh sihna lim a tute tanvak ding leh khamuanna lampi a i khete kalsuan sak ding in,” a chi hi.
  </para>
  <para style="p">
    <verse number="80" style="v" />Huan naungek a hong khanglian deuhdeuh a, a khalam a honghat hiaihiai a, Israelte kiang a a hong kilak masiah gamdai ah a om gige hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai lai in hichi ahi a, Kaisar Augusta in khovel tengteng min khum ding thu a pia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai tuh Suria gam a Kurini gamukpa a hihlai a min khumna masapen ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in mi tengteng a min uh khum ding in amau khua chiat uah a hoh uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Joseph leng, David inkuante leh a suan a hihman in Galili gam a Nazaret khua a kipan in, Judia gam a David khua Bethlehem ah a hoh hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mari a zikham gaisanlai toh, min khum ding in.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan hichi ahi a, huai a a omlai un, a nauneih a hong hun hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a tamasa in pasal a nei khia a; puan in a tuam a, khualbuk a a taklouh ziak un gan anpiakna ah a sial hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan huai gam mah ah belamchingte a om ua, gamlak ah zan in a belam uh a ching uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Toupa angel khat a kiang uah a hong ding a, Toupa thupina in a kim uh a tanvak a; huchi in a lauta mahmah uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Angel in a kiang uah, “Lau kei unla, ngai un, mi chih ading in Tanchinhoih kipahhuai mahmah k’on tut ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Tuni in nou ading in David khua ah Hondampa a piangta, amah Khrist Toupa ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiai nou ading in chiamtehna ding ahi; naungek puan a tuam, gan anpiakna kuang a lum na mu ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan angel kiang ah van mipi hon a hong omkhawm guih ua, Pathian a phat ua:
  </para>
  <para style="p">
    <verse number="14" style="v" />“Tungnungpen ah Pathian thupi henla, leitung a a kipahpih mahmah mihingte lak ah lemthu leng hen,” a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan hichi ahi a, angelte’n van a a paisan tak un, belamchingte’n, “Tun ah Bethlehem khopha in pai lehang, Toupa’n thu a honhilh hongtung i en ding uh” a kichi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in a pai mengmeng ua, Mari toh, Joseph toh, gan anpiakna kuang a naungek lum a vamu uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />A vamuh un a naungek tanchin angel in a hilh a genthangta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A za peuhmah in belamchingte thugen lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mari in thugen tengteng a lungtang in a ngaihtuah a, a vom gige hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Belamchingte’n angel hilh bang ngei a bangkim a muh ua a zak ziak un, Pathian pahtawi leh phatkawm zel in a kiknawnta uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan a zeksumni ding ni giat a hong chin in, a min din, sul a a om ma a angel in a gensa, Jesu a sa uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mosi dan bang a a kisiansakna ni uh a hongtun in, Jerusalem khua ah amah a va tonpihtou ua, Toupa kiang a amah lan ding in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Toupa thu a, “Ta pasal sul hong peuhmah Toupa ading a sehtuam a chi ding uh” chi a gelh bang in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Toupa Dan gen bang a vakhu kop khat hiam vapal nou nih hiam kithoihna lan ding in.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan ngai in, Jerusalem khua ah mi khat a min Simeon a om a; huai mi midiktat leh Pathian limsak ahi a, Israelte khamuanpa ding a ngak gige a, a tung ah Kha Siangthou a om hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Toupa Khrist a muh masiah zaw a si kei ding chih Kha Siangthou in a na theisak him ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kha theihsak in Pathian biakin ah a valut a; naungek Jesu a nu leh apan Dan ngeina bang a a tung a hihsak ding a a hon pilut lai un,
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman a na angpom a, Pathian a phat hi,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Toupa, tun ah zaw na thu bangzel in, na sikha khamuangtak in na paisak ding a:
  </para>
  <para style="p">
    <verse number="30" style="v" />Na hotdamna ka mit in a muhtak ziak in,
  </para>
  <para style="p">
    <verse number="31" style="v" />Huai michih muh a na bawltak;
  </para>
  <para style="p">
    <verse number="32" style="v" />Jentelte kiang a kilakna vak leh na mi Israelte thupina ding” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan naungek thu a gen a nu leh apan lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Simeon in amau a vualzawl a, a nu Mari kiang ah, “Ngai in, hiai naupang Israel lak a mi tampi pukna ding leh dinkhiakna ding a seh ahi, gensiat a om chiamtehna hi ding in leng.
  </para>
  <para style="p">
    <verse number="35" style="v" />Ahi, nang lungtang leng namsau in a dawt pailet ding a; huchi a mi tampi in a lungtang ua a ngaihtuahte uh a latna ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan mi khat, a min, Anna, zawlnei, Phanuel Tanu, Asher nam a mi a om a; amah tektak ahi a, a nungak tawp nung siah a pasal kiang ah kum sagih a om hi,
  </para>
  <para style="p">
    <verse number="37" style="v" />Kum sawmgiat leh kum li hial a meithai a, aman Pathian biakin paisanlou in a sun a zan in anngawl a thum in Pathian a be zel hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchih laitak in amah a hongpai a, Pathian kiang ah kipahthu a gen a, Jerusalem tatna lamen peuhmahte kiang ah Jesu tanchin a gen hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan Toupa dan bangzel a thil tengteng a hihzoh un, Galili gam a, amau khua Nazaret ah a kik nawnta uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Naungek a hong khanglian deuhdeuh a, a honghat hiaihiai a, pilna in a dimta a, Pathian deihsakna a tung ah a om hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan kumteng in, Paikan Ankuanglui hun in, a nu leh a pa Jerusalem khua ah a hohzel uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amah kum sawmlehnih a hih in dan ngeina in a hohtou uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ankuanglui zoh a a kiknawn lai un, Jerusalem khua ah naupang Jesu’n a omsan a, a nu leh pa’n a theikei uhi,
  </para>
  <para style="p">
    <verse number="44" style="v" />Huchi in a pawllak ua om hi nanteh a chi ua, ni khatlam a paikhin ua, a sanggamte uh leh a meltheihte uh lak ah a zong uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />A muhlouh ziak un zong kawmkawm in Jerusalem khua ah a kik nawnta uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan hichi ahi a, ni thum nung in, Pathian biakin ah, sinsakmite lak a tu a, a thu uh na ngaikhia a, amau thudong in, a vamu uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />A thu zate’n a theihdan leh a dawn dan lamdang a sa mahmah uh.
  </para>
  <para style="p">
    <verse number="48" style="v" />A nu leh apan amah a muh un, lamdang a sa mahmah ua: a nun, a kiang ah, “Tapa aw, bangdia hichibang a honhih na hia? Ngai in, na pa leh ken lungkhamtak in k’on zong uh” a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Aman a kiang uah, “Bangdia honzong na hi ua? Ka Pa inn a ka om ding na theikei ua hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan a kiang ua a thugen a theisiam kei uhi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan amau a zuisuk a, Nazaret khua a hongtung ua, a thu uh mang in a om hi. A nun huai thil tengteng a lungtang ah a vom gige hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jesu a pil deuhdeuh a, a honglian hiaihiai a, Pathian leh mihing deihsak in a om deuhdeuhta hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tiberias Kaisar vaihawm kum sawmlehnga kum in, Judia gamukpa Pontia Pilat ahi a, Galili gam kumpipa Herod ahi a, a unau Philip, Ituria leh Trakoniti gam kumpipa ahi a, Abilin gam kumpipa Lusania ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Annas leh Kaiapha siampu lianpen ahi ua, huailai in Gamdai ah Zakariah tapa Johan kiang ah Pathian thu a hongtung hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Amah bel Jordan luigei kim gam tengteng ah a hoh a, thil hihkhial ngaihdamna ding in kisikna baptisma thu a gen zel hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Zawlnei Isai laibu a, “Gamdai a kikou aw in, Toupa lamlian sial unla, a lampite tangsak un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Guam chih sundim ahi ding a, tang leh mual chih, hihniam ahi ding; lampi kawite tansak ahi ding a, lampi phokte mamsak ahi ding.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan mi tengteng in Pathian hotdamna a mu ding uh” a chi, chih gelh bang in.
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman baptisma tangding a kiang a mipi hongsukte kiang ah, “Gul suante aw, thangpaihna hong tungding taisan ding a kuan hon vauhilh ahia?
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in kisik minpu tak in gah un, Abraham ei hon suangpa ahi na lungsim un chi kei un; Pathian in hiai suangte Abraham suante in a dingsak thei chih k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Tu mahmah in heipi singbul teng ah koih ahita; huchi in, sing chih gah hoih a gahlou peuhmah phuk in a om a, mei ah paih in a om” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan mipite’n a kiang ah, “Bang ka hih ding ua?” a chi ua, a dong uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman, a kiang uah, “Kuapeuh puanak nih nei in a neilou kiang ah hawm hen; kuapeuh an nei in huchibang mah in hih hen” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan siahkhawnmite leng baptisma tang ding in a hong ua, a kiang ah, “Sinsakpa, bang ka hih ding ua?” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman a kiang uah, “Hon sehsak val uh khon kei un” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Sepaihte’n leng a kiang ah, “Kou leng bang ka hih ding ua?” a chi ua, a dong uhi. Aman a kiang uah, “Kuamah hiamgam in hih kei unla, diklou pi in kuamah hek kei unla, na loh uah lungkim un,” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan mite’n a lamet ua, mi tengteng in Johan tungthu a lungtang ua, Khrist ahi kha zenzen diam aw? chi a a ngaihtuah lai un,
  </para>
  <para style="p">
    <verse number="16" style="v" />Johan in a dawng a, avek ua kiang ah, “Ken tui in k’on baptist a, himahleh keimah sang a mi thupizaw a hongpai ding, a khedap khau pheltak leng ka hi kei; aman Kha Siangthou leh mei in nou a hon baptist ding.
  </para>
  <para style="p">
    <verse number="17" style="v" />A khut in a phazah a tawi a, a phual zapsiangna ding leh buhpang a buhte sunlutna ding in; a site mei mit ngeilou ah a haltum ding” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan hanthawnna tampi in mite kiang ah Tanchinhoih a hilh zel hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh kumpipa Herod in a naupa zi, Herodia tungthu ah leh a thilhihkhelh tung a Johan in a taihilh ziak in,
  </para>
  <para style="p">
    <verse number="20" style="v" />A thilhihkhelh tengteng behlap in amah suangkulh ah a khum hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan mi tengteng a baptist zoh in, hichi ahi a, Jesu leng baptist zoh a a om in, a thum a, van a hong kihong hi,
  </para>
  <para style="p">
    <verse number="22" style="v" />Kha Siangthou sa pu in vakhu bang in a hongsuk a, a tung ah a tuta a; van a kipan in aw a hongpawta, “Nang ka Tapa deihtak na hi; na tung ah ka kipak mahmah” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan Jesu’n thu a hilh pattunglai in amah kum sawmthum vel ahita, mi ngaih in zaw Joseph tapa ahi a, huai Heli tapa ahi a,
  </para>
  <para style="p">
    <verse number="24" style="v" />huai Matthat tapa ahi a, huai Levi tapa ahi a, huai Melki tapa ahi a, huai Janna tapa ahi a, huai Joseph tapa ahi a,
  </para>
  <para style="p">
    <verse number="25" style="v" />huai Matthathi tapa ahia, huai Amos tapa ahi a, huai Nahum tapa ahia, huai Esli tapa ahi a, huai Naggai tapa ahi a,
  </para>
  <para style="p">
    <verse number="26" style="v" />huai Maathi tapa ahi a, huai Matthathi tapa ahi a, huai Semmei tapa ahi a, huai Josek tapa ahi a, huai Joda tapa ahi a,
  </para>
  <para style="p">
    <verse number="27" style="v" />huai Joanan tapa ahi a, huai Rhesa tapa ahi a, huai Zerubbabel tapa ahi a, huai Salathiel tapa ahi a, huai Neri tapa ahi,
  </para>
  <para style="p">
    <verse number="28" style="v" />huai Melki tapa ahi, huai Addi tapa ahi, huai Kosam tapa ahi, huai Elmadam tapa ahi, huai Er tapa ahi,
  </para>
  <para style="p">
    <verse number="29" style="v" />huai Joses tapa ahi a, huai Eliezer tapa ahi a, huai Jorim tapa ahi a, huai Matthat tapa ahi,
  </para>
  <para style="p">
    <verse number="30" style="v" />huai Levi tapa ahi a; huai Simeon tapa ahi, huai Juda tapa ahi, huai Joseph tapa ahi, huai Jonam tapa ahi, huai Eliakim tapa ahi a,
  </para>
  <para style="p">
    <verse number="31" style="v" />huai Melia tapa ahi, huai Menna tapa hi, huai Mattatha tapa ahi a, huai Nathan tapa ahi, huai David tapa ahi,
  </para>
  <para style="p">
    <verse number="32" style="v" />huai Jesse tapa ahi, huai Obed tapa ahi a, huai Boaz tapa ahi a, huai Salmon tapa ahi a, huai Nahson tapa ahi,
  </para>
  <para style="p">
    <verse number="33" style="v" />huai Aminadab tapa ahi, huai Aram tapa ahi, huai Esrom tapa ahi a, huai Parez tapa ahi, huai Juda tapa ahi,
  </para>
  <para style="p">
    <verse number="34" style="v" />huai Jakob tapa ahi, huai Isak tapa ahi, huai Abraham tapa ahi a, huai Tera tapa ahi a, huai Nahor tapa ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai Serug tapa ahi, huai Reu tapa ahi, huai Peleg tapa ahi, huai Eber tapa ahi, huai Selah tapa ahi,
  </para>
  <para style="p">
    <verse number="36" style="v" />huai Kainan tapa ahi, huai Arpaksad tapa ahi, huai Sem tapa ahi, huai Noah tapa ahi, huai Lamek tapa ahi,
  </para>
  <para style="p">
    <verse number="37" style="v" />huai Methusel tapa ahi, huai Enok tapa ahi, huai Jared tapa ahi, huai Mahalalil tapa ahi, huai Kainan tapa ahi,
  </para>
  <para style="p">
    <verse number="38" style="v" />huai Enos tapa ahi, huai Seth tapa ahi, huai Adam tapa ahi, huai Pathian tapa ahi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu, Kha Siangthou in a dim a, Jordan lui a kipan a kiknawn a, Diabol khemkawm in gamdai ah ni sawmli Kha pi in a om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai nite in bangmah a ne kei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A tawp in a gil a hong kialta hi. Diabol in a kiang ah, “Pathian Tapa na hihleh hiai suang tanghou suak ding in thupia in” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n a kiang ah, “Mihing tanghou kia in a hing kei ding, Pathian kam a thupawt in a hingzaw ding” chih gelh ahi, chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a pitou a, mitphiat kallou in khovel gam tengteng a ensak hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A kiang ah, “Hiai tengteng tung a thuneihna leh a thupina k’on pe ding; ka kiang a piak ahita hi, ka ut peuh kiang ah leng ka pe zel hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in hon bia inla, avek in nang a ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu’n a kiang ah, “Toupa na Pathian na biak ding a, amah na kia na sep ding ahi” chih gelh ahi, chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan Diabol in Jerusalem khua ah a pi a, Pathian biakin tungzum ah a koih a, a kiang ah, “Pathian Tapa na hihleh hiai a kipan ke khesuk in;
  </para>
  <para style="p">
    <verse number="10" style="v" />Nangmah humbit ding in na tungthu ah zaw a angelte thu a pe ding a,
  </para>
  <para style="p">
    <verse number="11" style="v" />amau a khut un hondom ding uhi, huchilou in zaw na khe in suang na sui kha ding” chih gelh ahi ngal a, a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesu’n a kiang ah, “Toupa na Pathian ze-et ken” chih gelh ahi, chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Diabol in a khemna ding teng a a khem khit in a lemtan hun chiang ding in a paisanta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu, Kha thilhihtheihna in Galili gam ah a pai nawnta a; a tanchin huai kim gam teng ah a thangta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan kikhopnainte ah thu a hilhzel a, mi tengteng phat in a om hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan a khanletna khua Nazaret a hongtung a; khawlni a a hihdan ngeina bang in kikhopnain ah a lut a, sim ding in ading hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Zawlnei Isai laibu a kiang ah a pia ua, aman laibuzial a phel a, hiai thu kigelhna laitak a sim hi:
  </para>
  <para style="p">
    <verse number="18" style="v" />Liangvaite kiang a Tanchinhoih gen ding a n’on seh ziak in Toupa Kha tuh ka tung ah a om; Aman a honsawl, salte kiang ah pawtna thu leh, mittawte kiang a mitvak neih nawnna thu gen ding, simmawh thuakte pawtsakna ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Toupa lungkim kum thu gen ding in” chih.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan laibu a zial a, nasepsakpa a penawn a, a tuta hi. Huan kikhopnain a mi tengteng mit a tung ah a tuta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A kiang uah, “Hiai Laisiangthou thu tuni in na zak un a tangtungta” chi in a gen pan hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Avek un amah a phat ua, a kamsuak hehpihna thute lamdang a sa mahmah uh. “Hiai mi Joseph tapa ahi ka hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman a kiang uah, “Nou hiai thupil thu, Daktor, nang leh nang kihihdam in, Kapernaum khua a na thilhih ka na zak peuh uh, hiai ah nangmah kholam ah leng hih in chi in, honchi khong ding zaw neive ua” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Amahmah in, “Chihtaktak in, k’on hilh ahi, zawlnei kuamah amah kholam ah min a kipahpih ngeikei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in diktak in k’on chi ahi, Elijah damlai a, kum thum leh kha guk van a bin a, khovel a kial nakpitak a a hongtun in, Israel gam ah meithai tampi a om uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh a lak ua kuamah kiang ah Elijah sawl ahi kei, Sidon gamlama Sareptha khua a numei, meithai kiang kia a sawl ahizaw hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan zawlnei Elishah damlai in leng Israel gam ah phak tampi a om ua; himahleh a lak uah kuamah hihsiangthou in a omkei, Naaman, Suria mi kia hihsiangthou in a om zawta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan kikhopnain a mi tengteng in huai thute a zaktak un, a heh mahmah uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A ding suausuau ua, khua a kipan in a sawnkhia ua, paihkhiak ding in a khaw omna kawlkhou ah a pi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh amah a kikal uah a paisuak a, a paimangta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan Galili gam a khua khat, Kapernaum ah a va hohsuk hi. Khawlni’n mite thu a hilh hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thuneitaka a gen ziak in a thuhilh lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan kikhopnain ah dawinin paimi khat a na om hi;
  </para>
  <para style="p">
    <verse number="34" style="v" />Amah aw ngaihtak in a kikou a, “Eh! Nazaret Jesu, kou leh nang bang ahia i kizolhna om? Honhih mangthang ding in na hong maw? Nang k’on thei, Pathian Misiangthou na hi” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesu’n a tai a, “Dai inla, asung a kipan pawt in” a chi hi. Huan dawi in a lai ah a hihpuk a, hihnalou in asung a kipan a pawtta hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan avek un lamdang a sa mahmah ua, “Bang thu ahia le? Thu neitak leh thilhihtheitakin dawininte thu a pia a, a pawt uh” chi in, a kihou uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan huai kim gam khua teng ah a tanchin a thangta hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan a thou a, kikhopnain a kipan a pawt a, Simon inn ah a lut hi. Simon zi nu nakpitak in a khosik a, huchi in amah ading in a na ngetsak uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A kiang ah ading a, khosik a tai a, a daita hi; a thou paha, a na uh a sep sakta hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan ni tumkuan in natna tuamtuam a na, damlou nei peuhmah in a kiang ah a honpi ua; avek un a tung uah a khut a koihchiat a, a na hihdam zel hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan dawite’n leng, “Pathian Tapa na hi” chi a kikou in, mi tampi sung a kipan in hongpawt uhi. Huan amau a tai a, Khrist ahi chih a theih ziak un a pau uh a phal kei hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan khovak tak in a pawt a, kuamah omlouhna mun ah a hoh a; mipite’n a zong ua, a kiang ah a hong ua, amau a paisanlouhna ding in let a tum uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Himahleh a kiang uah, “Khaw dang ah leng Pathian gam Tanchinhoih ka hilh ding ahi, huai ding a sawl ka hi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />huchi in Galili gam a kikhopnainte ah thu a hilhta hi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, mipi’n Pathian thu a ngaihkhiak ua, amah a boh huthut lai un, amah Gennesaret dilgei ah ading hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan dilgei a long nih om a mu a, himahleh ngamanmite a pawtkhia ua, a lente uh a sawp uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in long khat Simon a pen ah a tuang a, a kiang ah luigei a kipan neukha tolhlut sak deuh a ngen hi. Huan a tu a, long a kipan mipite thu a hilh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan a thugen zoh in, Simon kiang ah, “Lithuk lam naih unla, ngaman ding in, na lente uh pai un” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan Simon in a kiang ah, “Heutupa, gimtakin zankhua in ka pang ua, bangmah ka mankei ua, himahleh na thu in lente ka pai nawn ding,” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan a paih ua leh nga tampi tak a khuh ua, a lente uh a kek iakkiak hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan long dang a om a lawmte uh amau huh ding in a khutvan uhi. A hongpai ua, long nih tum phialphial in asung dim tuaktuak uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Simon Peter in huai a muh in, Jesu khebul a khupboh in, “Toupa, hon paisan in, mikhial ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />A nga mat uh amah leh a lawmte’n lamdang a sa mahmah uhi;
  </para>
  <para style="p">
    <verse number="10" style="v" />Simon pawlte mah Zebedai Tapa Jakob leh Johan in leng lamdang a sa mahmah sam uhi. Simon kiang ah Jesu’n, “Lau ken, tuban siah mihing na manta ding” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan a longte uh luigei ah a tolh galkai ua, bangkim paisan in amah a zuita uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan hichi ahi a, khua khat a a omlai in ngai dih, mi khat phak a pumdim a om a, aman Jesu a muh in, a ma a khupboh in, “Toupa, na ut leh n’on hihsiang thei” a chi a, a ngen ngutngut hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman a sawk a, a khoih a, “Ka ut, na siangta in” a chi hi. Huan thakhat in a phak a hong beipah hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A kiang ah, “Kuamah hilh ken, himahleh siampu kiang ah va ki ensak inla, na sianhonna ding Mosi sehbang lan in, mite theihchetna ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh a tanchin thu a thang sansan a; mipi thupitak a thu za nuam leh a natnate uh hihdam ut in a hong kikhawm kheukhou uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh amah gamdai ah a paituam a, a thum hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan hichi ahi a, huailai in ni khat thu a hilh hi. A kiang ah Pharisaite leh dansiamte a tu uhi, huaite Galili leh Judia gam khaw teng a kipan a hongpai ahi uhi. Mite hihdamna ding in Toupa thilhihtheihna a kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan ngai dih, lupna toh mizaw khat a honzawng ua; a ma a koih ding in zawnlut a tum uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Himahleh mipi ziak in zawnlut ding dan a mu theikei ua, intung a kipan a laitak ah, Jesu ma ah a lupna toh a khai khesuk uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan a ginna uh a muh in, a kiang ah, “Mihing, na khelhnate ngaihdam ahita” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />laigelhmite leh Pharisaite’n, “Pathian gensia hiai mi kua ahia? Pathian kia lou in kuan ahia khelhnate ngaidam thei?” chi in a ngaihtuah uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huchi in Jesu’n a ngaihtuah uh a thei a, a kiang uah, “Na lungtang uah bang na ngaihtuah ua?
  </para>
  <para style="p">
    <verse number="23" style="v" />Na khelhnate ngaihdam ahita, chih leh thou inla, khe in paita in, chih, a koipen gen a nuam zaw?
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh, khovel ah Mihing Tapa in khelhnate ngaihdam theihna a nei chih na theihna ding un” a chi a, “Damlou mizaw kiang ah; Thou inla, na lupna la inla, na inn ah pai in, k’on chi” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in a mitmuh un a thou paha, a lupna a la a, Pathian phat kawmkawm in a inn ah a paita hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan avek un lamdang a sa mahmah ua, Pathian a phat uhi. “Tuni in thillamdang pitak i mu hi” a chi ua, a lau mahmah uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huaite khit in a pawt a, siahpiakna mun a tu, siahkhonmi khat a min Levi a mu a; a kiang ah, “Honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in bangkim a paisan a, ading a, a zuita hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan Levi in a inn ah Jesu ading in Ankuang thupitak a lui hi; siahkhonmi leh midangte toh mi tampi in amau a umpih chiat uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pharisaite leh laigelhmite a nungzuite tung ah a phun uhi, “Bangdia siahkhawnmite leh mikhialte kiang a ne a dawn na hi ua?” a chi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu’n a kiang uah, “Mi damtheite’n daktor a kiphamoh kei ua, mi damtheiloute’n a kiphamoh uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Mi diktatte sam ding a hongpai ka hi kei a, mikhialte kisik ding a sam dia hongpai ka hizaw” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan amau a kiang ah, “Johan nungzuite’n an a ngawl zel ua, a thum zel uh: Pharisaite nungzuite’n leng huchibang mah in a hihzel uh: himahleh na nungzuite’n a ne un a dawn gige uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n a kiang uah, “Moupi mite kiang a a pasal ding a omlai siah moupi mite an a ngawlsak thei ua hia?
  </para>
  <para style="p">
    <verse number="35" style="v" />Himahleh a pasal ding amau a kipan pimangnite a hongtung ding a, huai ni chiang in zaw a ngawl ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan a kiang uah gentehna thu leng a gen a: “Kuamah in puan lui puan thak them in a thuap ngeikei, thuap mahle uh, a thak in a kaikek dia, a thak them leh a lui a kituak kei ding uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan kuamah in uain thak savun uain thawl lui ah a thun ngeikei, thun le uh uain thak in savun thawlte a puakzak dia, a baw dia, savun thawlte leng a segawp ding uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Uain thak savun uain thawl thak ah a thun zaw ding uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan kuapeuh uain lui na dawn khin in leng, a thak a duh pah kei hi; a lui hoihzaw a chi ngal a” a chi hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, khawlni khat buhlei ah a paisuak a, a nungzuite’n buhvuite a khiak ua, a khutpek ua nuai siang in a ne uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pharisai kuate hiam in, “Bangdia khawlni a hihsianglou hih na hi ua?” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu’n a dawng a, “David a gilkial lai a a lawmte toh a thilhih uh huai bangte leng na sim kei ua hia?
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi a Pathian inn a lut a, siampute loungal in a nek sianglouh tanghou koihtuam a lak a, a lawmte kiang a a piak sam thu” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a kiang uah, “Mihing Tapa zaw khawlni Toupa ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan hichi ahi a, khawlni dang khat kikhopnain ah a lut a, thu a hilh a; huai ah mi khat khut taklam zaw a na om hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Laigelhmite leh Pharisaite’n a hekna ding a muhtheihna ding un, khawlni’n hihdam ding in a kisa hia kisa lou a sim et uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh aman a lungsim uh a thei a, khutzaw kiang ah, “Thou inla, a lai ah ding khia in” a chi hi. Huan a thou a, ading kheta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu’n a kiang uah, “Khawlni’n hihhoih a siang hia, hih siat? Hotdam a siang hia, hihlup? K’on dong ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan avek un a en velvel a, a kiang ah, “Na khut zankhia in” a chi hi. Huan a zankhia a, a khut a damta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in a heh law mahmah ua, Jesu tung a hih ding dan a kihouta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan hichi ahi a, huai a kipan in a pawt a, thum ding in tang ah a kuan a, Pathian kiang ah zankhua in a thum hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Khovak in a nungzuite a sam a; a lak uah sawmlehnih a tel a, a min ding un leng Sawltak a sa hi:
  </para>
  <para style="p">
    <verse number="14" style="v" />Huaite Simon Peter a chih leh a unaupa Andru, Jakob leh Johan, Philip leh Bartholomai,
  </para>
  <para style="p">
    <verse number="15" style="v" />Matthai leh Thomas, Alphai tapa Jakob,
  </para>
  <para style="p">
    <verse number="16" style="v" />Simon, Zelot kichi leh Jakob tapa Judas leh a mansakpa Judas Iskariot ahi uh.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan amau toh a paikhia a, mun zang ah ading a, a nungzui mipite toh, Judia gam tengteng a kipan leh, Jerusalem khua a kipan leh, Tura leh Sidon kholam a tuipi gei a kipan mipi tampitak a thu ngainuam leh a damlouhnate uh hihdam ut in a hongpai uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in dawinin bolgawpte leng damsak in omta uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan a kiang a kipan thilhihtheihna a pawtkhia a, michih a hihdam zel ziak in mipi tengteng in amah khoih a tum uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan a dak khia a, A nungzuite enkawm in a gen a: “Nou gentheite aw, na hampha uhi; Pathian gam nou a ahi ngal a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Nou tua gilkialte aw, na hampha uhi, tai ding na hi ngal ua. Nou tua kapte aw, na hampha uhi, nui ding na hi ngal ua.”
  </para>
  <para style="p">
    <verse number="22" style="v" />“Mihing Tapa ziak a mite’n a honhuat ua, hon pampaih ua, hontai ua, na min uh a hoih kei chi a a hon paihmang chiang un, na hampha ding uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai ni’n kipak unla, nuam in tawm un, ngai un, van ah na kipahman uh a om kihkeih hi; huchi bangmah in a pipute un zawlneite tung ah a hih uhi.”
  </para>
  <para style="p">
    <verse number="24" style="v" />“Himahleh, nou mihaute aw, na tung uh a gik e; na khamuanna uh na mukhinta ngal ua:
  </para>
  <para style="p">
    <verse number="25" style="v" />Nou tua vahte aw, na tung uh a gik e; na gil hong uh kial ding ahi . Nou tua nuite aw; na tung uh a gik e; lungkham a kap ding na hi uhi”
  </para>
  <para style="p">
    <verse number="26" style="v" />“Mi tengteng in a honphat chiang un na tung uh a gik ding hi; huchi mah bang in a pipute un zawlnei takloute tung ah a hih uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Ka thu ngaikhete aw, k’on hilh ahi, na melmate uh it unla, a hon hawte hoihna ding hih un,
  </para>
  <para style="p">
    <verse number="28" style="v" />Hamsia hon hamsiatte vualzawl unla, a hon simmohte thumsak un.
  </para>
  <para style="p">
    <verse number="29" style="v" />Biang langkhat a hon bengpa a lehlam leng doh in; na puan hon laksakpa kiang ah na puanak leng it ken.
  </para>
  <para style="p">
    <verse number="30" style="v" />A hon ngen peuh kiang ah pia in; huan na van hon laksakpa kiang ah ngen nawn ken.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan min na tung ua a hih uh na deih ding bangzel un mi tung ah leng hih sam un.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Huan a hon itte kia na it un, pahtak bang na loh ding ua? Mikhialte’n leng amau itte a it sam ve ua oi!
  </para>
  <para style="p">
    <verse number="33" style="v" />Na tung ua hoihte tung kia a na hoih un, pahtak bang na loh ding ua? Mikhialte’n leng huchi bangmah in a hih zel ve ua oi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Muhnawn lametnate kiang kia a thil na leitawi sak un, pahtak bang na loh ding ua? Mikhialte’n leng a ngeingei mu nawn ding in mikhialte kiang ah a leitawi sak sam uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Himahleh na melmate uh it unla, a hoihna ding un hih unla, lunglel hetlou in leitawi sak un; huchi in na kipahman uh a tam dia, Tungnungpen tate na hi ding uh; aman mi kipahna dan theiloute leh migiloute a hehpih hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Na Pa un mi a hehpih bang in mi hehpih sam un.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Hawmsak kei un, huchi in hawmsak in na omkei ding uh; kuamah siamlou in sepkei un, huchi in siamlouh in na omkei ding uh; ngaidam un, huchi in ngaihdam in na om ding uh;
  </para>
  <para style="p">
    <verse number="38" style="v" />Pia un, huchi in piak in na om ding uh, hoihtak a teh a, hen gak a, sin gak a, let nawinawi in na angsung uah piak in na om ding uh. Noumau tehna ngei mah a tehsak a piak in na om ding uh a hingal a, a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan a kiang uah, gentehna a gen a, Mittaw in mittaw mah a pi thei diam? A nih un kawkhuk ah a kekhawm kei ding ua hia?
  </para>
  <para style="p">
    <verse number="40" style="v" />Nungzui a heutupa tung ah a omkei; himahleh michih a siamkim chiang un a heutupa bang in a om ding uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />“Huan bangdia, na mit a singtum om limsaklou a, na unau mit a ninneng neuchik om mu na hia?
  </para>
  <para style="p">
    <verse number="42" style="v" />Nangmah mit a singtum om mulou in, na unau kiang a, Unau, na mit a ninneng neuchik om hon lakhe sak ve, bangchi a chi thei na hia? Mi lepchiah na mit apat singtum lakhe masa in, huchi in na unau mit a ninneng neuchik lak khiak ding chiantak in na mu thei ding hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />“Sing hoih gahsia a gah a om ngeikei; sing sia lah gah hoih a gah a om ngei sam kei hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Sing chih amau gah chiat ah a kithei hi. Min khaulingnei kung ah theipi a lou ngeikei uh, lingnok lak ah grep gah a lou ngei sam kei uh.
  </para>
  <para style="p">
    <verse number="45" style="v" />Mi hoih in a lungtang goubawm hoih a kipan thilhoihte a lakhia a; migilou in a lungtang goubawm sia a kipan thilhoihloute a lakhe zel hi; a lungtang a dim val kam in a genzel hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />“Huan nou bang ding a, ka gente hihloupi a, Toupa, Toupa, honchi na hi ua?
  </para>
  <para style="p">
    <verse number="47" style="v" />Michih ka kiang a hong a, ka thu za a zui peuhmah kua bang ahi ua, k’on ensak ding:
  </para>
  <para style="p">
    <verse number="48" style="v" />inn lammi lei thukpi tou a, suangpi tung a suangphum lemmi bang ahi uh; huan tui a hong khan in, tuikhauh in huai inn a khoha, a hihling theikei, hoihtak a lam a hih ziak in.
  </para>
  <para style="p">
    <verse number="49" style="v" />Himahleh thu za a manglou suangphum louh a leitung maimaha inn lammi ahi; tui khauh in huai inn a khoha, a chim paha; huai inn siatna thupitak ahi” a chi hi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan mipite zak a a thugen teng a khit in Kapernaum khua ah a lut lai in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Sepaih zaheutu kuahiam sikha deihtak china in, a si dekdek hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in, Jesu tanchin a zaktak in a sikha hong hihdam ding a ngen ding in a kiang ah Juda upate a sawl hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amau Jesu kiang a va tung ua, limtakin a ngen uhi,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Amah zaw na hihsak tak ahi; ka nam uh a it a, ka kikhopnain uh leng amah hon lamsak ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Jesu amau toh a hongpai hi. A inn a tundek kuan in sepaih zaheutu’n a lawmte a sawl a, “Ka inn sung na lutna tak ahi kei,
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaiziak in na kiang a hongtakin leng ka kisim kei, thu leltak gen lechin, ka naupang a dam mai ding;
  </para>
  <para style="p">
    <verse number="8" style="v" />Keileng mi thunuai a om ka hi a, ka nuai ah sepaihte a om ua; huai mipa, hiai mipa, Pai in, ka chih leh a pai a, midang kiang ah leng, hongpai in, ka chih leh, a hongpai a; ka sikha kiang ah leng, hiai hih in, ka chih leh a hih zel” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu’n huai thu a zak in lamdang a sa mahmah a, a kihei a, mipi amah zuite kiang ah, “K’on hilh ahi, Israelte lak ah leng hichi tel a ginna thupi ka mu kha kei,” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan a misawlte inn ah a pai nawn ua, sikha dam in a muta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan sawtlouchik in khua khat Nain kichi ah a hoh a; a nungzuite leh mipi tampitak a kiang ah a hoh sam uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khopi kongkhak kiang a tun in, ngai in, misi a hon zawngkhia ua, a nu tapa neihsun ahi a, amah lah meithai ahi ngal a; a khuamite tampi a kiang ah a om uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Toupa’n meithainu a muh in, a lainat mahmah a, “Kap ken” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a vanaih a, lang a va len hi; huchi in lang zawngte a khawlta uhi. “Tangval thou in, k’on chi,” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan misi a tukhia a, a hong pauta hi. Huchi in Jesu’n a nu kiang ah a peta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan mi tengteng in a lau ua, Pathian a phat ua, “I lak ah zawlnei thupi a hong suakta, a chi ua, Pathian in a mite hong vehta” a chi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan huai mi tungtang thu Judia gam tengteng leh a kiang vel gam teng ah a thangkheta hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan Johan nungzuite’n huai thu tengteng Johan a hilh uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in Johan in a nungzuite nih a sam a, Toupa kiang ah a sawl a, “Hongpai dingpa na hi hia, midang hungaih lailai ding ka hi uhia?” chi in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan a misawlte a kiang a hongtun un, “Baptispa Johan in, Hongpai dingpa na hi hia, midang hungaih lai ding ka hi uhia? chi in, na kiang ah kou a honsawl” a chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huaitak in Jesu’n, damloute, hipi veite, dawimatte tampi a hihdam a, mittaw tampite leng a mit uh ahihvak hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A kiang uah, “Pai nawnta unla, thil na muh uleh na zak uh Johan vahilh un; mittawte mit a hong vakta, khebaite khe in a paita ua, phakte hihsiang in om ua, bengngongte bil a hongvakta, misite kaihthohin a omta uh, a zawngte’n Tanchinhoih hilh a tangta uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan kuapeuh ka tung a lunghihlouhna mulou a hampha hi” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Johan sawltakte a painung un Jesu’n mipite kiang ah Johan thu a gen a, “Bang en ding a gamdai a paikhia neita ua? Sialluang huih mut ling maw?
  </para>
  <para style="p">
    <verse number="25" style="v" />Ahihkeileh, bang en ding pen a paikhia neita ua? Puannem silhmi maw? Ngai un, puan thupi silh leh mi nuamsate kumpipate in ah eive a om uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Ahihkeileh, bang en ding pen in ahia na paikhiak uh? Zawlnei maw? Ahi tawk vaw oi, k’on chi ahi, amah zaw zawlnei sang a leng thupizaw ahi.
  </para>
  <para style="p">
    <verse number="27" style="v" />‘En dih, ka thangkou na ma ah ka sawl ahi, aman na ma ah na lampi a bawlkhol ding, chi a, a tanchin kigelh, hiai mipa ahi.’
  </para>
  <para style="p">
    <verse number="28" style="v" />Numei suan lak ah Johan sang a thupizaw a omkei; himahleh Pathian lalgam a mi neupen leng amah sang in a thupizaw, k’on chi ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan mi tengteng leh siahkhon mite’n huai a zak un, Johan khut a baptisma tangsa ahihman un, Pathian siam a tangsak uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Pharisaite leh dan theimite’n bel a kiang a baptisma a na tangkei ua, amau ading a Pathian in a hoih dia a sehsak a deihkei uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in Jesu mah in, “Hiai khang bang toh ka teh diam aw? Bang toh bang ahi ua?
  </para>
  <para style="p">
    <verse number="32" style="v" />Naupang dawlmun a tu a, ‘tamngai hon tumsak ung a, lam lou uchin a’; ‘sun ung a, nou kaptuan lou,’ chi a, kichi tuah bang ahi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Baptispa Johan a hongpai a, tanghou a nekei a, uain leng a dawnkei a nou, Dawizawl eive, na chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Mihing Tapa a hongpai a, a ne in a dawn a, En dih uh, anhaipa, uain haipa, siahkhawnmite leh mikhialte lawm: na chi zel uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Himahleh pilna a ta tengteng in siam a tan uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pharisaite lak a mi khat in a kiang a an ne din a deih hi. Huai Pharisai inn ah a lut a, an a um hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Ngai dih, huai khua a numei khat om in Pharisai inn ah an umin a tu chih a theihtakin alabaster bawmin thau namtui a hontawi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A nung ah a khepek bul ah kapkawmin adinga, a khitui in a khepek a sukawta, a sam in a nul a, a khepek a tawp a, thau namtui a nuh hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan a sampa Pharisai in huai a muh in, a lungsim in, “Hiai mi zawlnei ahihleh a khoihnu numei kua ahia, mi bangchi ahia, theihtuaktak hi a, mikhial ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jesu’n a kiang ah, “Simon, na kiang ah thu kam khat gen ding ka nei” a chi a, a dawng hi. Aman “Bang ahia, Sinsakpa?” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Jesu’n “Dangka leitawi sak kuahiam in leibami nih a nei a: khat in makhai za nga, khat in sawmnga a ba uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan a ditna ding a neikei ua, a ngaidam tuaktuak hi. Huai mite a kua in amah a it zaw ding a?” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Simon in, “A ngaihdam tampen in hi in ka gingta” chi in a dawng hi. Aman a kiang ah, “Na chi dik” a chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan numei lam a nga a, Simon kiang ah, “Hiai numei na mu hia? Na inn ah ka honglut a, nang ka khepek silna ding tui n’on pekei a, aman a khitui in ka khepek a sukawt a, a sam in a nul hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Nang tawp himhim n’on tawp kei; aman ka honglut nungsiah ka khepek a tawp a tawlnga kei hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nang ka lutang ah thau n’on nilh kei a; aman ka khepek thau namtui a nilh hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huaiziak in k’on chi ahi, a khelhna tampi ngaihdam in a omta; aman nakpi’n a it hi; Himahleh, ngaihdam tawm in, neuchik in a it” a chi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huaizoh in numei kiang ah, “Na khelhnate ngaihdam ahi ta” a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huchi in a an umpihte’n, “Mikhialte nangawn ngaidam kua ahia eita?” a kichi uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Numei kiang ah, “Na ginna in a hon hondam hi” khamuangtak in paita in, a chi hi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />A nung in Jesu thuhilh leh Pathian gam Tanchinhoih genkawm in kholian leh khoneute tawn vialvial in a pai a; a kiang ah sawmlehnihte a om uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Numei kuate hiam dawimat leh china damnawnte, Mari Magdalini asung a dawi sagih pawtna a chih uh,
  </para>
  <para style="p">
    <verse number="3" style="v" />Joanna, Chuza, Herod sumkempa zi, Sussana leh midang tampite toh ahi uh; huaite’n amau neihsa in amah na a sepsak zel uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan mipi tampitak a hong kikhawm ua, khochih apan a kiang a hong paikhawm mite kiang ah gentehna in thu a gen a:
  </para>
  <para style="p">
    <verse number="5" style="v" />“Buhchithehpa buhchitheh in a kuan a; a thehlai in a khen lamsik ah a kia a, min a sikden ua, tungleng vasate’n a nezou uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan a khen suang tung ah a kia a; a poutakin a kawtlouh ziak in a vuai pah hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a khen loulingnei lak ah a kia a, lou in a pou tonpih a, a depmang hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a khen lei hoih ah a kia a, a hongpou a, a leh za in a gahta, a chi hi. Huai thu a genlai in a kikou a, kuapeuh zakna ding bilnei in za uhen!” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan a nungzuite’n a kiang ah, “Hiai gentehna bang chihna ahia?” chi in, a dong uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Aman “Pathian gam thugukte nou theih dia piak ahi a, midang kiang ah bel gentehna kia a gen ahi; mu napi a a muh theihlouhna ding uleh za napi a a theihsiam louhna ding un” chi’n a dawng hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai gentehna thu omdan hiai ahi: Buhchi Pathian thu ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Lampi sik a te thu zasate ahi uh; himahleh Diabol a hongpai a, a ginlouh ua, hotdam a hih theihlouhna ding un a lungtang ua kipan thu a lak mangsak zel hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan suang tung a te a zaktak ua thu kipaktak a pompahte ahi ua; himahleh zung himhim a neikei ua, sawtlou chik kia a gingta ua, khemna hun in a tawpsan nak uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan loulingnei lak a kiate thuzate ahi ua; himahleh a khosak zelna uah damsung khosak ngaihtuahnate, hauhsaknate, nuamsaknate’n a dep a, a gah piching kei nak uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lei hoih a kiate bel thuza a lungtang kizen leh hoih a kem kinken a, kuhkaltak a gahsuahte ahi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Kuamah in khawnvak de in bel in a khuh kei uh, lupna nuai ah leng a koih kei uh; a lut peuhmah in a vak a muh theihna ding un a koihna ah a koih zaw uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Thanglou ding a im bangmah a omkei a, theihlouh ding leh langlou ding a selguk bangmah a omsam kei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in bangchi bang in ahia na zak uh pilvang un; kuapeuh a nei piak behlap ahi ding a, kuapeuh a neilou nei a kichih sun leng laksak ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan a nu leh a unaute’n Jesu kiang a hongnaih ua, himahleh mipi ziak in a kiang a hongtung theikei uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Na nu leh na unaute nangmah muhtum in inn pua ah ading nilouh uh” chi in, a hilh uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman a kiang uah, “Pathian thu za a gingtate ka nu leh ka unaute ahi uh” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan hichi ahi a, huailai in ni khat a nungzuite toh long ah a tuang a, a kiang uah, “dil galkhat lam ah i kai ding uh,” a chi a, huchi in long a phel ua, a paita uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Long a a tuanlai un Jesu a ihmuta a; dil ah huihpi a hong nungsuk a, a long uh tui in a dim dekdek a, lauhuai pi in a omta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a kiang ah a va hoh ua, a phawng ua, “Heutupa, Heutupa, mangthang ding ka kei umaw” a chi uhi. Amah a khanglou a huih leh tui kihot a taita a; a tawp ua a daita mai uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan a kiang uah, “Na ginna uh kaw om ahia?” a chi hi. Huan a lau ua, lamdang a sa mahmah uhi. “Hiai mi kua ahia leh huih leh tui nangawn thu a piak a, a thu a man uh?” a kichi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Galili gam zawn Gerasinte gam a tung uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan gam a a paikhiak lai in, khua a mi dawimat kuahiam in a na mu a; huai mi sawtpi puan silhlou in a om hi, inn ah leng a omkei a, han ngenah a omzaw hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu a muhtak in a kikou a, a ma ah a khupboh a, aw ngaihtak in, “Jesu, Pathian Tungnungpen Tapa, kei leh nang bang i kizawlhna a om a? Hon hihgim lou ding in k’on ngen ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n dawinin huai mi sung a kipan a pawt ding in thu a pekhinta hi. Huai mi dawi in a man gige ahi; khainiang leh kol a bunsak ua, a vengzel ua; himahleh a gakna uh a hihtat a, dawi in gamkeu ah a delhkhia hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu’n, “Na min bang ahia?” chi in, a dong a, aman, “Nuai ka hi” a chi a, asung a dawi tampi a lut ziak in.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan kawkhuk tawneilou a paithu pelou ding in Jesu kiang ah a ngen uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huai tang ah vokhon tampi a ta ua; voksung a lut theihna thu a kiang ah a ngen uhi. Aman phalna a pia hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Dawite huai mi sung a kipan a pawt ua, voksung ah a lut uhi; huan vokhon dilgei ken ah a taisuk ua, dil ah a tailut ua, tuihak in a sita uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan vok vulte’n huai thil omdan a mu ua, a tai ua, khua ah leh gam ah a gen uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan bang ahita a? chi a, en ding in a pawt chiat uhi. Jesu kiang a hongtun un, dawi pawtsan nung puansilh a, lungsim ngeina pu in, Jesu khebul a tu a hong mu ua, huchi in a lauta uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan a theite’n dawimat a hihdam danthu a maute a na hilh uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan a kim Gerasinte gam a mi tengteng in, a lau mahmah ziak un, amah a kiang ua kipan paimang ding in a ngen ua; huan, long ah a tuang a, a paikik nawnta hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Dawi pawtsan mi in Jesu kiang a omden a ngen hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Himahleh Jesu’n, “Na inn ah pai inla, Pathian in nang dia thil a hon hihsak a thupidan vahilh in” chi in a sawlkhia hi. Huchi in a pai a, khopi sung tengteng ah Jesu’n amah adia thil a hihsak thupidan a tangkoupihta hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huan Jesu a hong kiknawn in mipi in amah a kipahpih ua; amah a nangak nilouh uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan ngai dih, mi khat a min Jaira kikhopnain vaihawmpa a hongpai a, Jesu khebul ah a khupboh a, a inn a hoh ding in a ngen ngutngut hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Tanu tangkhat, kum sawmlehnih hiam ding a nei a, amah laitat din a lum hi. Huan Jesu a pailai in mipi hon in a bawh lutlut uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Numei khat kum sawmlehnih sipawt a china a sum neih tengteng daktorte lak ah a zangkhinta a, kuamah in a hihdam theih tuanlouh uh;
  </para>
  <para style="p">
    <verse number="44" style="v" />A nung ah a hongpai a, a puanmong a khoih a; thakhat in a sipawt a kam guih hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Jesu’n, “Kua ahia hon khoih?” a chi hi. “Kei zaw ka hi kei” a na chi chiat uhi. Peter leh a lawmte’n, “Heutupa, mipi’n honbawh lutlut ua, honvel vengvung ve ua” a chi uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Himahleh Jesu’n “Kuahiam in hon khoih ahi, thilhihtheihna ka sung a kipan a pawt chih ka theih ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan numei in a kisel theihlouh a theih in, ling kawm in a hongpai a, a ma ah khupboh in a khoihsan leh thakhat a a damtak dan mi tengteng ma ah a genkhe ta hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huan a kiang ah, “Tanu, na ginna na dampih hi, khamuangtak in pai in” a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />A pau laitak in kikhopnain vaihawmpa inn a kipan mi khat a hongpai a, “Na tanu a sita, Heutupa hihgim nuamdah in” a chi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu’n huaithu a zak in, “Lau ken, gingta mai in, huchi in a dam nawn ding” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan inn a vatun in, Peter, Johan, Jakob leh naupang nu leh pate kia chih louhngal kuamah lut a phal kei hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Avek un a na kap kheukhou ua, a kap vengvung ua, himahleh, aman, “Kap kei un, a si kei, a ihmu ahizaw” a chi hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huan sikhin a a theih ziak un a nuihsan maimah uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Jesu’n a khut a len a, “Nungak, thou in” a chi a, a sam hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Huan a kha a hong kiknawn a, a thou pah hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Banghiam nekding piak ding thu a pia hi. A nu leh apan lamdang a sa mahmah uhi. Himahleh aman a thilhih kuamah hilhlou ding in a chi bikbek hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Jesu’n sawmlehnihte a samkhawm a, dawinin tengteng tung a thilhihtheihna leh natnate hihdam theihna thuneihna a pia hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in Pathian gam thugen ding leh damloute hihdam ding in a sawlkheta hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kiang uah, “Zinna ading in chiangkhun hiam, kawlzal hiam, tanghou hiam, dangka hiam, bangmah keng kei un; puanak nih leng keng kei un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Na tunna inn uah tung kinken un, huai inn a kipan paikhia un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a hon kipahpihlou peuhmah huai khua a kipan na paikhiak chiang un amau mawhpaihna ding in na khepek ua leivui tatkhia un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in a kuanta ua, khua a tawn vialvial uhi. Gamchih ah Tanchinhoih a hilh ua, mi a hihdam zel uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan kumpipa Herod in a thilhih tengteng uh a naza hi; khenkhat in, “Johan hingnawnta ahi, a chi ua, khenkhat in,
  </para>
  <para style="p">
    <verse number="8" style="v" />Elijah hong kilak ahi, a chi ua, khenkhat in, nidanglai zawlnei kuahiam thounawnta ahi,” a chih ziak un, a lungzingta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Herod in, “Johan a lu ka tanta a; himahleh hichi lawmlawm a a thu ka zakzak kua ahia?” chi in amah muh a tum hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan sawltakte a hong kiknawn un, a kiang ah a thilhihte uh a hilh ua. Aman amau pi in khopi Bethsaida kichi ah a paituamta hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh mipi’n a thei ua, a zui zel uh; aman amau a na kipahpih a, Pathian gam thu a hilh a, hihdam kiphamoh peuhmah a hihdam hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan nitaklam a hong hidekta a; sawmlehnihte a hongpai ua, a kiang ah, “Khuate leh a kim gam ah giahna leh annek tuidawn zong ding in mipite paisak tanla; gamkeu mun a om hi ngal hang a” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Aman bel a kiang uah, “Nou nekding pia un” a chi hi. Amau, “Mi hiai zahzah nekding i va leisak kei leh, tanghou phel nga leh nga nih kia loungal bangmah i neikei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Piching ngen leng sang nga phial ahi uhi. Huan a nungzuite kiang ah, “Mite a pawlpawl in tusak un, sawmnga zel in” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in a hih ua, a tusak vekta uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan tanghou phel nga leh ngasa nih la a, vanlam en in vual a zawl a a balkham a, mipi ma a lui ding in a nungzuite kiang ah a pia hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan a ne ua, a vah chiatta ua, a khamval nengte uh bawm sawmlehnih a luak dimta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan hichi ahi a, Jesu amah kia a a thumlai in a nungzuite a kiang ah a om ua; a kiang uah, “Mipite’n kua ka hi a honchi ua?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau “Baptispa Johan a honchi ua; himahleh khenkhat in, Elijah hiam nidanglai zawlnei kuahiam thounawn a honchi uh” chi in, a dawng uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan aman a kiang uah, “Ahihleh nou kua ka hi n’on chi ua?” a chi hi. Peter in, “Pathian Khrist mah” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan huai thu kuamah hilhlouh ding chi bikbek in, thu a pia hi:
  </para>
  <para style="p">
    <verse number="22" style="v" />“Mihing Tapa in thil tampi a thuak dia, upate, siampu liante leh laigelhmite deihlouh in a om dia, thah in a om dia, ni thum ni’n kaihthoh in a om ding” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan mi tengteng kiang ah, “Kuapeuh in hon zuih a ut leh, amah kingaihsaklou in, niteng a Kros pua in honzui hen.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh a hinna humbit ut in a tan ding; kuapeuh keimah ziak a a hinna tan in a humbit ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Min khovel a pum in nei henla, amah kimangsak hiam, ahihkeileh kimanloh leh amah ading in bang a phatuam dia?
  </para>
  <para style="p">
    <verse number="26" style="v" />Kuapeuh keimah leh ka thu zahpih mi zaw Mihing Tapa in amah thupina toh, a Pa thupina leh a angel siangthoute thupina toh a hongpai chiang in a zahpih ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Diktakin k’on hilh ahi, hiai a dingte a khen, Pathian gam a muh masiah uh sihna chiamlou hial ding a om uh” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan hichi ahi a, Jesu’n a thugen nung ni giat hiam in, Peter, Johan leh Jakob a pi a, thum ding in tang ah a hohtou uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A thumlai in a mel omdan a hong lamdang a, a puansilhte mi lengthei in a hong ngouta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan ngai in, mi nih amah toh a kihou ua, huai mite Mosi leh Elijah ahi uh.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thupina a kithuam in a kilak ua, Jerusalem khua a sihna a hih bukim ding thu a gen uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Peter leh a lawmte bel a ihmut uh a suak a, himahleh a hak teitei ua a thupina leh a kiang a mi nih ding a mu uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan huai mite’n Jesu a paisan deklai un, Peter in Jesu kiang ah, “Heutupa, ei din hiai a om a hoih, aidakbuk thum i khoh dia, nang adin khat, Mosi adin khat, Elijah adin khat, a chi a, a thugen leng a theikei hi.”
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan huai thute a genlai in mei a hong kai a, amau a liahta; mei lak a a lutlai un a lau uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Meipi a kipan aw a hongsuak a, “Hiai ka Tapa, ka tel ahi, amah thu ngai un” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan aw a daihtakin Jesu kia a muta uhi. Huan a daidide ua, huailai in a thilmuh uh kuamah bangmah a hilh kei uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan hichi ahi a, a zing in tang a kipan a paisuk nung un, mipi thupitak in amah a nadawn uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ngai in, mipi lak ah mi khat a kikou a, “Sinsakpa, ka tapa en ding in k’on ngen ahi, amah ka tapa neihsun ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Ngai in, dawi in a man a, a kikou kheguih zel a; huchi in, a chilphuan ke hial in a gimbawl a, nakpitak a hih sidup in a paisan zel hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Na nungzuite kiang ah delhkhe ding in ka ngen a, a hih theikei uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan Jesu’n, “Ginna neilou khang leh lampialte aw, bang tan ahia ka honthuak theih ding? Na tapa hiai ah honpi in” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan a hong pailai in dawi in a hihpuk ek a, nakpitak in a gimbawlta hi, himahleh Jesu’n dawinin a tai a, naupang a hihdam a, a pa kiang ah a paisak nawn ta hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan mi tengteng in Pathian thupidan lamdang a sa mahmah uhi. Huchi in mi tengteng in a thilhih tengteng lamdang a saklai un, Jesu’n a nungzuite kiang ah,
  </para>
  <para style="p">
    <verse number="44" style="v" />“Hiai thute na bil uah lut hen. Mihing Tapa mihingte khut a matsak a om ding ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Himahleh a thugen a theisiam kei uh, a theih theihlouhna ding un a kisel ahi, huai thugen tanchin amah a dong ngam kei uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan a lak uah kua a thupipen dia? chih thu in a na kisel uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jesu’n a lungtang ua a ngaihtuah uh a thei a, naupang neu khat a kai a, a sik ah a omsak a, a kiang uah,
  </para>
  <para style="p">
    <verse number="48" style="v" />“Kuapeuh ka min ziak a hiai naupang neu kipahpih keimah hon kipahpih ahi ding uh; keimah hon kipahpih hon sawlpa kipahpih ahi: na vek ua lak a neupen a thupipen ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Johan in “Heutupa, kuahiam na min a dawite delkhia ka mu ua, k’on zuihna ua a panlouh ziak in ka khamta uhi” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu’n a kiang ah, kham nawn kei un, kuapeuh nou hon dallou nou lam a pang ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan hichi ahi a, amah pitouh a hun ding in, Jerusalem khua a hoh a tum chiltela, a ma ah mi a ma taisak hi;
  </para>
  <para style="p">
    <verse number="52" style="v" />Huan a pai ua, amah adia na kimansak ding in Samari mite khua khat ah a lut uhi.
  </para>
  <para style="p">
    <verse number="53" style="v" />A mai Jerusalem kholam naih a a lat ziak in amah a na kipahpih kei uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huchi in a nungzui Jakob leh Johan in huai a theih un, “Toupa, amaute kangmang ding in, Elijah hih bang in van a kipan mei hong ke ding a thu ka piak uh hoih na sa hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Amah a kihei a, amau tai in, “Bang kha apan na hi ua chih theilou na hi uhiam?
  </para>
  <para style="p">
    <verse number="56" style="v" />Mihing Tapa mite hih mangthang ding hilou in, hondam ding a hongpai ahizaw hi” a chi hi. Huan khaw dang ah a paita uhi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huan lampi a a pailai un, kuahiam in a kiang ah, “Na paina peuh ah k’on zui ding” a chi hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Jesu’n a kiang ah, “Sehalte’n kua a nei ua, tungleng vasate’n leng bu a nei uh, himahleh Mihing Tapa in zaw a lu ngakna ding mun a neikei” a chi hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Jesu’n midang kiang ah, “Honzui in” a chi hi. Himahleh aman, “Toupa, ka pa hon vuisak phot in” a chi hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Jesu’n a kiang ah, “Misi in a misi uh vui uhen; nang Pathian gam thu va genzaw in” a chi hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Huan midang in leng “Toupa, k’on zui ding, himahleh ka inn a mite kampha in hon khasak phot in” a chi hi.
  </para>
  <para style="p">
    <verse number="62" style="v" />Huan Jesu’n a kiang ah, “Kuapeuh leilehna len a, nunglam nga Pathian gammi hitak ahi kei” a chi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaikhit in Toupa’n midang sawmsagih a sep a, a paina ding khoteng leh mun teng ah, a ma ah nihnih in a sawl hi,
  </para>
  <para style="p">
    <verse number="2" style="v" />A kiang uah, “Buh lak ding a tam mahmah a, himahleh a semte a tawm uh, huchi in a buhla ding a semdingte sawl ding in buh neipa kiang ah ngen un.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pai un; ngai un, nge lak a belamnou bang in k’on sawl ahi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Dangka ip, kawlzal leh khedap tawi kei unla, lampi ah kuamah chibai buk kei un.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan inn na lutna peuh uah a masapen in, hiai inn ah khamuanna tung hen, chi un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai inn a khamuanna ta a om leh na khamuanna thu uh a tung ah a om ding a; a omkei leh na kiang uah a hongkik nawn ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai inn ah tung in om nilouh unla, a honpiak peuh uh ne in dawn un; nasemmi loh mutak ahi. Inn teng ah banhoh kei un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan khua na lutna peuh uah hon kipahpih uleh, honlui peuh uh na ne ding ua; huai a damlou omte leng na hihdam ding ua;
  </para>
  <para style="p">
    <verse number="9" style="v" />A kiang uah, Pathian gam na kiang uah hongtungta, na chi ding uh.
  </para>
  <para style="p">
    <verse number="10" style="v" />Khua na lutna peuh uah hon kipahpih kei uleh a kongzing uah paikhia unla,
  </para>
  <para style="p">
    <verse number="11" style="v" />Na khaw leivui uh ka khepek ua bang teng na tung uah tatsiang ung e; himahleh Pathian gam hong naita chih thei un, na chi ding uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />K’on hilh ahi, huai ni chiang in huai khuate thuak sang in Sodom khaw thuak ding a dan a omzaw ding hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Korazin, na tung a gik e; Bethsaida, na tung a gik e; Noumau a thillamdang kihihte Tura leh Sidon khua a hih hileh, saiip puansilh in, vut lak a tuin a kisik khinthamta ding uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh thukhenni chiang in nou thuak sang in Tura leh Sidon khaw thuak ding a dan a omzaw ding.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan nang Kapernaum, van tan a tawisang in na om a, misi khua a sawnkhiak a om ding na hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Kuapeuh na thu uh ngaikhia keimah thu ngaikhia ahi a; kuapeuh nou hon deihlou kei hondeih lou ahi a; kuapeuh nou hon ngailou kei hon ngailou ahi a, kuapeuh kei hon ngailou tuh hon sawlpa ngailou ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan sawmsagihte kipaktak in a hongkik nawn ua, “Toupa, dawite nangawn na min ziak in ka thuthu un a om uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman a kiang uah, “Khophia bang in Setan van a kipan a hong kia ka mu hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ngai un, gulte, aikamte sikdenna thu leh, melma thilhihtheihna tengteng tung a thuneihna k’on pia ahi; bangmah in a hon hihna kei hial ding,
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh dawite na thuthu ua a om ziak un kipak kei un; van a na min uh gelh a hih ziak in kipak zaw un” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huailai tak in Jesu Kha Siangthou in a kipak mahmah a, “Pa aw, lei leh van Toupa, nang mi pil leh mi bengvakte kiang ah hiai thu na im a, naungekte kiang a na thanziak in k’on phat hi; ahi, Pa, huchibang hih nang ngaih in a hoih ahi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ka Pa’n bangkim hon kemsak a, Tapa kua ahia, Pa loungal kuamah in a theikei, Pa leng kua ahia, Tapa leh a kiang ua Tapa in a theihsak nopnate kia loungal kuamah in a theikei” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan nungzuite lam a nga a, a sim in, “Na thilmuhte uh a mu mitte a hampha e!
  </para>
  <para style="p">
    <verse number="24" style="v" />K’on chi ahi, zawlnei tampi leh kumpipa tampite’n leng na thilmuhte uh muh a kilawp gige ua, himahleh a mu kei uh, bil a na zakte uh leng zak a kilawp thei mahmah ua, himahleh a za kei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan ngai un dantheimi kuahiam ading a, amah ze-etna din, “Sinsakpa, tangtawn hinna neihna ding in bang ka hihdia? a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Aman a kiang ah, “Dan laibu ah bang gelh ahia? Bangchi’n na sim a?” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan aman “Toupa, na Pathian na lungtang tengteng, na kha tengteng, na hatna tengteng, na lungsim tengteng in na it ding ahi; nangmah na ki-it bang in na vengte na it ding ahi chih” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan aman a kiang ah, “Na dawng dik hi; huchi in hih lechin na hing ding” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman bel kisiamtansak ut in, Jesu kiang ah, “Ahihleh, ka inveng kua ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu’n a dawng a, “Kuahiam Jerusalem khua a kipan Jeriko khua ah a hohsuk a, suamhatte a tuak hi. Amau a puansilh a suahsak vek ua, a vua ua, si dektak in a pai santa uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan siampu kuahiam huai lampi ah a vapai suk a, a muhtak in lampi sik lehlam ah a pel maimah hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan huchibang mah in Levi chi mi khat leng huai mun a hongtung a, a muh tak in lampi sik lehlam ah a pel maimah hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Himahleh, Samaria gam a mi kuahiam zin pailai a omna a hongtung hi, a muhtak in a lainat mahmah hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />A kiang ah a vahoh a, a liamnate thau leh uain a buak a, a tuam a, amah gan tung ah a tuangsak a, khualbuk ah a paipih a, a kemta hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan a zing in makhai nih a suahkhia a, khualbuk kempa kiang ah a pia a, amah na kem inla, hiai ban a na zat teng, ka hong kiknawn chiang in k’on din ding” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huai mi thumte lak ah, suamhatte tuakpa adin, invengte hipen kua hi in na gingta a? a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Aman, “A hehpihpa” a chi hi. Jesu’n a kiang ah, “Nang leng huai mah bang in va hih in” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan a zinkawm un khua khat ah a lut a; numei khat a min Martha in a na zintun hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huai nun sanggamnumei khat a nei a, a min Mari ahi, huai minu Toupa khebul ah a tu a, a thu a ngaikhia hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Martha in bel nasem in a buai mahmah a; huchi in a kiang a hongpai in “Toupa, ka sanggamnu’n kei kia nasem ding a honkhiat khawksalou na hi maw? Honhuh ding in sawl in, a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Toupa’n, “Martha, Martha, thil tampi na ngaihtuah a, buai neive; thil khat kia a kul ahi;
  </para>
  <para style="p">
    <verse number="42" style="v" />Mari in tanhoih a tel a, huai laksak ding ahi kei” chi in, a dawng hi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hichi ahi a, Jesu koilai mun hiam ah a thum a, a thum khit in a nungzui mi khat in a kiang ah, Toupa, Johan in a nungzuite thum dan a hilh bang in hon hilhsam in, a chi hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan aman a kiang uah, “Na thum chiang un hichibang in na chi ding uh, a chi hi: “Ka Pa uh, van a om, na min kizahtak hen, Na gam hongtung hen.
  </para>
  <para style="p">
    <verse number="3" style="v" />Niteng in ka nekkhop uh an honpia in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka khelhnate uh hon ngaidam in, Kou leng kuapeuh bat hon neite ka ngaidam uhi; Khemna ah hon pilut ken. Gilou lak ah hon huzaw in”
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a kiang uah, “Na lak ua kuahiam in lawm nei henla, zanlai in a kiang a hoh in, ‘Lawm, tanghou phel thum hon leitawi sak ve.
  </para>
  <para style="p">
    <verse number="6" style="v" />Ka lawm zin in a hon tawn a, a ma a lui ding bangmah ka neikei,’ chi henla;
  </para>
  <para style="p">
    <verse number="7" style="v" />Aman inn sung apan in, ‘hon hihbuai ken; tun zaw kong khak ahi, ka tate leng ka kiang ah lupna ah a ihmuta uh; thou in ka hong pe theikei chi in, dawng leh k’on hilh ahi,’
  </para>
  <para style="p">
    <verse number="8" style="v" />A lawm a hih ziak in thou in a va pekei na a, a nget ngutngut ziak in thou in a deih zahzah a vape ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Huchi in k’on hilh ahi, ‘Ngen un, piak na hi ding uh; zong un, na mu ding uh; kiu un, honsak in na om ding uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Kuapeuh a ngen in a mu a, kuapeuh a zong in a mu a, kuapeuh a kiu honsak in a om ding hi.’
  </para>
  <para style="p">
    <verse number="11" style="v" />Nou lak a pa pen, a ta in tanghou ngen leh kua ahia suang pe ding? Ahihleh ngasa ngen leh kuan ahia gul pe ding?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ahihkeileh, aktui ngen leh aikam a pedia hia?
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in nou migilou in bawn na tate thil hoih piak dan na theih uleh, na Pa uh van a om in a ngente Kha Siangthou pe natel in chia!” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Jesu’n dawi pautheilou khat a delhkhia hi. Hichi ahi a, dawi a pawttak in pautheilou a hong pauta; huchi in mipi’n lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Himahleh a khen in, “Dawimang Beelzibul ziak in eive dawite a delhkhiak zel” a chi uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A khen in, amah ze-etna ding in, van a kipan chiamtehna a ngen uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman a ngaihtuah uh a thei a, a kiang uah, “Koi gam leng amah kidou peuh a mangthang a; inkuan khat leng amah kidou a mangthang hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Setan leng amah a kidou leh a gam bangchi’n a dingkhe dia? Beelzibul ziak in dawite a delhkhia, n’on chi ua;
  </para>
  <para style="p">
    <verse number="19" style="v" />Ken Beelzibul ziak a dawite delhkhia ka hihleh, na tate un kua ziak in ahia a delhkhiak uh? Huaiziak in amau noute hon vaihawmsak dingte ahi ding uh.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh ken Pathian khutzung ziak a dawite delhkhia ka hihleh Pathian gam na kiang uah a hong tungkhinta hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi hat in hiamzat kim tawi a a inn a ven sungteng, a sum bittak in a om gige hi;
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh amah sang a hatzaw in a hongsual a, a zoh chiang in, a muan a galvan kim a sut a, sum a laksak a hawmzak zel hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuapeuh ka lam a panglou tuh hondou ahi a, kuapeuh honlak khawm pihlou in a hihzak hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Dawinin mi sung a kipan a pawt in, khawlna zong in tui omlouhna mun peuh ah a vakvak hi. Huan, khawlna himhim a mu kei a, ka pawtna inn ah ka kiknawn mai ding, a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A va tun in phiatsiang leh zephoih in a mu hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huaitak in a vapai a, amah sang a gilou zaw dawi dang sagih a honpi a, huai mi sung ah a lut ua, a teng uhi; huai mihing omdan nanung amasa sang in a hoih keizaw tham hi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan hichi ahi a, huai thute a genlai in, mipi lak ah numei khat a kikoukhia a, a kiang ah, “Nang honpai gil a hampha e, na nawitep toh” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Aman bel, “Pathian thu za a zuite mi hampha ahizaw uh” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan mipite a kiang a a hong kikhop lai un, Jesu’n, “Hiai khang giloute ahi uh; chiamtehna a zong ua; himahleh Jonah chiamtehna chih louh a kiang uah chiamtehna piak ahi kei ding.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jonah Ninevi khua a mite adia chiamtehna a hih bang in, Mihing Tapa leng tulai khangte chiamtehna a honghi ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Thukhenni chiang in, Simlam kumpinu tulai khangte kiang ah ading dia, siamlouh a tangsak ding; Solomon pilna ngaikhe ding in kawlmong a kipan a hong ngal a; ngai un, Solomon sang a thupizaw hiai ah a om hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Thukhenni chiang in, Ninevi khua mite tulai khangte kiang ah ading ding ua, siamlouh a tangsak ding uh, Jonah thuhilh ziak in a kisik ngal ua; ngai un, Jonah sang a thupizaw hiai ah a om hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />“Kuamah in khawnvak a det un inn nuaitawng ah a koih ngeikei uh, lawh nuai ah leng a koih ngei sam kei uh, a lut mite’n vak a muh theihna ding un a koihna ah a koih zel uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na sapum khawnvak na mit ahi; na mit a chim leh na sapum leng avek in a vaksuak nak hi; a chim kei leh bel na sapum a mial vek nak hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in na sung a vak om mial a na hi kha ding e, pilvang in.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huchi in na sapum koilai peuh miallou a avek a a vakkhiak leh, khawnvak vak petpet in a tatvak bang in a vakkhe vek ding” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan a genlai in Pharisai khat in amah kiang a an ne ding in a chial a; huchi in, a lut a an a ne hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pharisai in a an um a muh in, annek ma a khut a sillouh lamdang a sa mahmah hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Toupa’n a kiang ah, “Nou Pharisaite’n nou leh kuang pawlam na silsiang ngeitak ua; na sung lam ulah lepgukna leh gilou in a dim hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Mihaite aw, pawlam bawlpa’n sunglam leng a bawl ka hia?
  </para>
  <para style="p">
    <verse number="41" style="v" />Himahleh na neihte uh mi genthei kiang a thil thawnpiak ding in zangun; huchi in ngai un, nou adin bangkim a siangvek hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Nou Pharisaite aw, na tung uh a gik e: pudina, pardi leh anteh louhing teng sawm a khat na pia ua, diktatna leh Pathian itna na limsak kei uhi; himahleh huaite eive na hih ding uh, a dangte hihlou tuanlou in.
  </para>
  <para style="p">
    <verse number="43" style="v" />Nou Pharisaite aw, na tung uh a gik e: kikhopnain ah tutphah hoihpente leh dawlmun a chibai bukte na ngaisang uh.
  </para>
  <para style="p">
    <verse number="44" style="v" />Laigelhmite leh Pharisai lepchiahte, na tung uh a gik hi: han chiamteh louh, a tung a theilou a mi a paizelna bang, na hi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan dantheimi khat in, a kiang ah, “Sinsakpa, hiai thu na gen kou leng hontai na hi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan aman “Dantheimite aw, nou leng na tung uh a gik: Puakgik, puak haksa pipi mite na suan ua, nou lah huai puakgikte na khutzung khat un leng na khoih ngeikei uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Na tung uh a gik: na pipute uh thahsa zawlneite han inn na lam ngal ua.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huchi in na pipute uh thilhihte na theihpih un na hoihsakpih uh ahi; amau a that ua, nou a han innte na lam uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huaiziak in ‘Pathian pilna in leng, a kiang uah zawlneite leh sawltakte ka sawl dia, a khen a that ding ua, a khen a sawi ding uh a chi hi;’
  </para>
  <para style="p">
    <verse number="50" style="v" />Zawlnei tengteng sisan, leitung piantung a kipan a kisuah, tulai khangte tung ah phu a laktheih ding in a chi hi;
  </para>
  <para style="p">
    <verse number="51" style="v" />Abel sisan suah a kipan, Zakariah, maitam leh biakin kikal a sisan suah tan in; ahi, k’on hilh ahi, tulai khangte tung ah phu a kila ding.
  </para>
  <para style="p">
    <verse number="52" style="v" />Nou dantheite aw, na tung uh a gik e: theihna tabi na paimangpih ua; nou lah na lut ngalkei ua, mi a lut dingte na dal uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huai a kipan a pawtin, laigelhmite leh Pharisaite’n amah a tawng ua, thu chiteng gensak teitei tum in leh,
  </para>
  <para style="p">
    <verse number="54" style="v" />A pau khelh zenzen leh mat tum in a tang gige uhi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchihlai a mipi sang tampi kiphu muimui zou hial a hong kikhop un, Jesu’n a masapen in a nungzuite kiang ah, “Pharisaite silngou, lepchiahna lak ah pilvang un,
  </para>
  <para style="p">
    <verse number="2" style="v" />Langlou ding a selguk bangmah a omkei a; theihlouh ding a im leng bangmah a omsam kei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huaiziak in mial a na gen peuh uh vak a zak in a om ding; dantan sunggil a bilbul a na thugen uh intung vum a tangkoupih in a om ding hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Huan ka lawmte aw, k’on hilh ahi, sapum that a, huai nung a bangmah dang hih nawn theiloute zaw, kihta kei un,
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh kua ahia na lauh ding uh k’on hilhkhol ahi; a hihlup nung a leng Gehenna a paihtheihna thuneipa lau un.
  </para>
  <para style="p">
    <verse number="6" style="v" />Kawlgit nga dal dangka nih in a zuaksek kei ua hia? Himahleh a lak ua khat leng Pathian in a mangngilh ngeikei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na luzang ua samzangte nangawn leng simvek ahi uh. Lau kei un; kawlgit tampi sang in na manpha zaw uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />“Huan k’on hilh ahi, mite ma a hon gum peuhmah Pathian angelte ma ah Mihing Tapa in a gum sam ding hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Himahleh mite ma a hon kitheihmohbawl peuhmah Pathian angelte ma ah ka kitheihmohbawl sam ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mihing Tapa kalh a thugen peuhmah a genkalhna ngaihdam sak ahi ding a; himahleh Kha Siangthou hilhial gensia zaw a gensiatna ngaihdam sak ahi kei ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kikhopnain a mite, vaihawmte, heutute ma a a honpi hun chiang un, bangchi in, bang thu in ka dawng dia, bang thu ka gen dia chi in lungkham kei un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai huntak in, bang ahia na gen ding uh, Kha Siangthou in a honhilh ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mipi lak a khat in Jesu kiang ah, “Sinsakpa, ka u kiang ah gou hon hawmsam ding in hilh in” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh aman a kiang ah, “Mihing, noumau tung ah kuan ahia kei thukhenpa hiam tanseppa hiam a honbawl? a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />A kiang uah, “Pilvang unla, enna lak ah kiveng un; hauhna mihing damsan ahi kei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan a kiang uah gentehna thu a gen a, “Mi hau kuahiam a hong pung mahmah hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in a kingaihtuah a, bangchibang in ka hih diam aw? Ka buh leh bal koihkhawmna ding ka neikei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Hichibang in ka hih ding e; ‘ka buhinte ka phel ding a, a sang a lianzaw in ka lam dia, huai ah buh leh ka van tengteng ka koih khawm ding.’
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan ka kha kiang ah, ‘Kha aw, kum tampi sung daih ding tampi na kholta; khawl inla, ne in dawn inla, nuamtak in om in, ka chi ding,’ a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh, Pathian in a kiang ah, ‘Nang mihai, tu zan chiah na kha a hon laksak ding uh, huai na lamkhiakte, kua a ahi ta dia?’
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau ading a gou khola, Pathian lam a haulou huchi ahi uh” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan a nungzuite kiang ah, “Huaiziak in k’on hilh ahi, bang ka ne diam aw? chi in, na hinna thu uh leh, bang silh in ka teng diam aw? chi in, na sapum thu uh lunghimawh kei un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Nekding sang in hinna a thupizaw hi, puansilh sang in leng sapum a thupizaw hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Va-akte ngaihtuah dih uh, buh a tuh kei ua, a at sam kei uh; buhpang leh buhin leng a neikei uh; himahleh Pathian in amau a vak hi; noute vasate sang a manpha zaw na hi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan nou lak ah lunghimawh ziak a kua in ahia amah dunglam tong khat a hihsang thei tuan?
  </para>
  <para style="p">
    <verse number="26" style="v" />Hiai lel leng hih theiloute’n bangdia thil dang lunghimawh nak na hi ua?
  </para>
  <para style="p">
    <verse number="27" style="v" />Lilite khandan ngaihtuah dih uh; na a semkei ua, khau leng a khek kei uh; himahleh k’on hilh ahi, Solomon hilhial leng a thupina tengteng a a kizep in, hiai lilite lak a khat bang a zep in a omkei hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in gamlak loupa tuni a hing a, a zing a thuk a khul nawn mai ding bawn Pathian in hichitel a a zep leh, aw, nou mi gintawmte, huaite sang in puansilh honpe zaw natel in chia!
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan na nekding uh, na dawn ding uh, zong kei un; ginglel in leng omsam kei un.
  </para>
  <para style="p">
    <verse number="30" style="v" />Khovel a namte’n huai thil tengteng a zong uh; huai bang na kiphamoh uh chih na Pa un a theigige hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh Pathian kumpi gam zong zaw un, huchi in huai thilte leng a honpiak behlap ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />“Pawltawmte aw, lau kei un; nou kiang a gam piak ding na Pa uh kipahlam tak ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Na neih peuh uh zuak unla, mi gentheite kiang ah pia un; van ah guta naih phaklouhna ah, leikha neksiat louhna ah, dangka ip lui theiloute, gou bei theiloute kibawl un.
  </para>
  <para style="p">
    <verse number="34" style="v" />Na gou omna peuh ua na lungtang uh leng a om ding ziak in.
  </para>
  <para style="p">
    <verse number="35" style="v" />“Na kawng uh gak unla, na khawnvak uh leng diam sa in om un.
  </para>
  <para style="p">
    <verse number="36" style="v" />Min a pu uh kitenna Ankuangluina a kipan a a hongpai chiang a, kongkhak a hon kiuhtaka, hon theipah ding a a ngak nilouh bang in, om un.
  </para>
  <para style="p">
    <verse number="37" style="v" />A pu uh a hongpai chiang in sikha na ngak nilouh a a muhte a hampha uhi; chihtaktak in k’on hilh ahi, aman a kawng a gak dia, amau an um ding in a tusak ding a, a na uh a sepsak ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Zanlai in hiam, thoh hun in hiam a hong a, huchibang a a honmuh, huai sikhate a hampha uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Himahleh, hiai thei un, guta a hongpai ding inn neipa’n thei leh, a veng dia, a inn a phenvang sakkei ding hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Nou leng mansa in om un, na gintak louh dak un Mihing Tapa a hongpai ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan Peter in “Toupa, hiai gentehna koumau kia hia n’on hilh, mi tengteng?” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Toupa’n “Sumkempa ginom, piltak, a pu in a hunteng a a tan ding uh hawmsak ding a a inkuanpihte tung a heutu a a bawl ding kuapen ahi dia le?”
  </para>
  <para style="p">
    <verse number="43" style="v" />A pu a hongpai chiang in sikha huchibanga hih a hon muhding pa a hampha hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Diktakin k’on hilh ahi, a neih tengteng tung a heutu ding in a bawl ding hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Himahleh huai sikha in a lungtang in, ‘ka pu a hongzok kei ding e, chi in, a sikhanu, a sikhapa, na vaw ta leh, ne in dawn in na kham leh;
  </para>
  <para style="p">
    <verse number="46" style="v" />Huai sikha pu, a ginlouh ni’n, a theihlouh lai in, a hong ding a, tum nih a honsuah ding a, mi ginomloute tan bang a tangsak ding hi.’
  </para>
  <para style="p">
    <verse number="47" style="v" />Sikha a pu deihlam theigige na pi a na kiging tuanlou a, a pu deihlama gamta loupa’n nakpitak a vuak a tuak ding hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Himahleh theiloupia vuakna tham a gamtapa’n awlchika vuak a tuak ding. Tampi piak a ommi kiang ah tampi phutin a om ding a; tampi kepsakpa kiang ah a tamsem a phut ding uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />“Khovel a mei khesuk ding a hongpai ka hi; tuin leng kangpah leh china tel ing e!
  </para>
  <para style="p">
    <verse number="50" style="v" />Himahleh baptisma tan ding ka nei, huai hih tangtun mateng ka om nuamlou hina mahmah e:
  </para>
  <para style="p">
    <verse number="51" style="v" />Khovel a lem lengsak ding a hongpai hiam honsa na hi umaw? Hidek lou, k’on hilh ahi, kidou lengsak ding a hongpai ka hi zaw.
  </para>
  <para style="p">
    <verse number="52" style="v" />Tunung chiang in inkuan khat ah mi nga a kidou ding uh, thum in nih, nih in thum.
  </para>
  <para style="p">
    <verse number="53" style="v" />A kidou ding ua, pa in a tapa, a tapa in a pa; a nu in a tanu, a tanu in a nu; a pi in a mou, a mou in a pi, a chi hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huan mipi kiang ah leng, “Tumlam a meikai na muh uleh, ‘vuah a zu ding na chi pah ua; huan a hongzu ngei zel hi.’
  </para>
  <para style="p">
    <verse number="55" style="v" />Sim huihnung na muh chiang un, ‘khua a lum ding, na chi ua, a hong lum hi.’
  </para>
  <para style="p">
    <verse number="56" style="v" />Nou lepchiahte aw, khovel leh van omdan leng na genchian thei ngal ua, bang a chia tu hun theichian siamlou na hi ua?
  </para>
  <para style="p">
    <verse number="57" style="v" />“Bang a chia noumau in thudik kikhen lou na hi ua?
  </para>
  <para style="p">
    <verse number="58" style="v" />Honhekpa toh thukhenpa kiang na zotlai un, lampi ah kilep theihna khat zawng teitei in; huchilou in zaw thukhenpa mai ah hon kailut ding a, thukhenpa’n miman heutu a hon mansak ding a. Miman heutupa’n suangkulh ah a honkhum kha ding hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />K’on hilh ahi, paihsa san khat nangawn na piakkim masiah, huai a kipan na pawtkei hial ding” a chi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huailai in, kuate hiam a om ua, huaite’n Galili mite Pilat in a sisan uh Pathian biakna sagohte lak a a helsakte tungtang Jesu a hilh uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan aman a kiang uah, “Huai Galili mite huchibang thil a thuak ziak un Galili mi tengteng sang in migilou tuan hi un na gingta ua hia?
  </para>
  <para style="p">
    <verse number="3" style="v" />Hilou e, k’on hilh ahi, nou leng na kisik kei uleh huchi mah bang in na mangthang vek ding uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Siloam insang in mi sawmlehgiat a delhlupte leng Jerusalem khua a om tengteng sang in migilou zaw hi un na gingta ua hia?
  </para>
  <para style="p">
    <verse number="5" style="v" />Hilou e, k’on hilh ahi, nou leng na kisik kei uleh huchibang mah in na mangthang vek ding uh” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan hiai gentehna a gen a: “Kuahiam in a grephuan ah theipi kung khat a suan hi. Huan a kung ah gah a hong zong a khat leng a mu kei hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in grepgui kemmi kiang ah, ‘Ngai in, kum thum sung hiai thei kung ah a gah ka va zong zel a, khat leng ka mu kei; phuk in; bangdia mun dal a om nilouh ahia?’ a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Aman a kiang ah ’Toupa, tukum bek om henla, a kimvel in ka tou ding a, ek in ka phungvuh lai dia;
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi a a gah leh a hoih ding, a gah keileh phuk mai in,’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan khawlni’n aman kikhopnain khat ah thu a hilh hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Ngai in, kum sawmlehgiat hatlouhna nei dawimat numei khat a om hi; huai mi a kun kheukheu a, amah thu in ading tang theikei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesu’n amah a muhtak in a sam a, a kiang ah, “Numei, na hatlouhna in a honkhahta” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a tung ah a khut a koih a; thakhat in a tang paha, Pathian a phatta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu’n khawlni a mi a hihdam ziak in kikhopnain heutu a heh a, mipi a houpih a, a kiang uah, “Mihing nasepna ding ni guk a om vo oi; huai sung in kihihdam un, khawlni’n hilou in” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Toupa’n a kiang ah “Nou lepchiahte aw, khawlni’n na bawng uh hiam na sabiltung uh hiam a annekna a kipan phel in, tui dawn ding in na pikhe chiat zel uh hilou hia?
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiai numei, Abraham tanu ahi ngal a, ngai un, Setan in kum sawmlehgiat a man a, Khawlni’n leng hiai gak phelsaklouh dan ahi ahia?” a chi a, a dong hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai thute a genlai in a melma tengteng a zum ua; mipi bel a thil thupi hih tengteng ziak in a kipak uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in aman “Pathian gam bang ahia? Bang toh ka teh dia?
  </para>
  <para style="p">
    <verse number="19" style="v" />Ankam chi tangkhat min a lak a, huan a a theh bang ahi, huai a hongpou a, sing a honghi a, tungleng vasate a hiangte ah a giak uh,” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan “Pathian gam bang toh ka teh dia? a chi nawn a.
  </para>
  <para style="p">
    <verse number="21" style="v" />Silngou numei in a lak a, anbuang tehna thum lak a avek a a thoh mateng a phum bang ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan aman thuhilh kawm zel in, Jerusalem kholam naih in kholian leh khoneute a tawn zel hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuahiam in a kiang ah, “Hotdamte tawmchik ahi ding u maw? a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan aman a kiang uah, kong kawchik ah lut tum teitei un; k’on hilh ahi, mi tampi in lut a tum ding ua, a lut theikei ding uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />inn neipa a thoh a, kong a khaknungin, nou a pua ading in, Toupa, kong hon hon in, chi in kongkhak n’on kiuh chiang un, aman koilam mi na hi ua, hon theilou ka hi’ chi in, nou a hon dawng ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai hun chiang in, nou, na muh in ka ne ua, ka dawn ve ua oi, ka kongzing uah leng thu na hilh zel vaw oi, na chi ding uh.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman, k’on hilh ahi, koilam mi na hi ua, k’on thei ngeikei; nou thil gilou hihte aw, ka kiang apan paimang vek un, a honchi ding hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Abraham, Isak, Jakob leh zawlnei tengteng Pathian gamsung a om na muh ua, nou pawlam a delhkhiak na hih uh na kitheih chiang un, na kap ding ua, ha na gawi ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan suahlam, tumlam, simlam leh mallam a kipan mite hongpai ding ua, Pathian gam ah ne in a dawn ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan ngai un, nanungpente leng masapen a om ding ua, masapente leng nanungpen a om ding a om uh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaitak in Pharisai kuate hiam a hongpai ua, a kiang ah, “Pawt inla, hiai a kipan paimang in: Herod in a honthat ding” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan aman a kiang uah, “Huai sehal kiang ah hiai thu vagen un: ‘Ngai in, tuni toh, zingchiang toh dawite ka delhkhe dia, natnate leng ka hihdam dia a ni thum ni’n ka zou ding.
  </para>
  <para style="p">
    <verse number="33" style="v" />Abang abang hitaleh tuni toh, zingchiang toh, a ni thumni toh ka pai zel ding hi; Jerusalem khaw pawlam ah zawlnei sih theih hilou ahi’.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aw Jerusalem, Jerusalem: zawlneite that, na kiang a honsawlte uh suang a na denglum: akpi in a noute a khanuai a a opkhum bang in na tate bangzah vei opkhum ka tuma? Himahleh na ut kei uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />En in, na inn a vuak a taisan in a omta hi. Ka hon hilh ahi, ’Toupa min a hongpai a hampha, na chih masiah n’on mu kei ding’ ” a chi hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan hichi ahi a, khawlni’n Pharisai vaihawmmi khat inn a an ne ding a a hoh in a na enkhia uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan ngai in a ma ah damlou chibawk kuahiam a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in Jesu’n dantheimi leh Pharisaite a houpih a, a kiang uah, “Khawlni’n hihdam a siang hia, siang lou?” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amau a daidide uhi. Aman damlou a long a, hihdam in a paisakta hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a kiang uah, “Na lak uah sabiltung hiam bawngtal hiam nei unla, khawlni’n tuikul sung ah ke leh kua ahia kaikhe pah lou ding?” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai thu a dawng theikei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a mi sapte un tutna mun hoihpen a telzel uh a mu a, a kiang uah gentehna a genta hi:
  </para>
  <para style="p">
    <verse number="8" style="v" />“Kitenna an ne ding a kuapeuh in a honsap chiang in tutnamun hoihpen ah tu kei un; huchilou in zaw noute sang a mi zahtakhuai zaw a na sam kha dia, huchi in a hon sampan,
  </para>
  <para style="p">
    <verse number="9" style="v" />‘Hiai mi tutna ding awn in,’ a honchi dia; huan nang zumpi in tutnamun niampen ah na tu nawn phing ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A honsap chiang in tutnamun niampen ah na vatu zaw ding a; huchi in a hon sampa a hong chiang in, na kiang ah, ‘Lawm, tutnamun hoihdeuh ah tuin, a hon chithei ding.’ Huchi in na an umpihte mitmuh in pahtawi in na om ding hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kingaisang peuhmah a neu ding a: kingaineu pahtawi a om ding a hih ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan a sampa kiang ah leng, “Sun an hiam nitakan hiam a Ankuang na lui chiang in, na lawmte, na unaute, na sanggamte, na inveng mihaute na sam kei ding hi; huchilou in zaw a hon samthuk ding ua, a hon thuk chitchiat kha ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ankuang na luichiang in, tagahte, piangsualte, khebaite, mittawte, na sam zaw ding hi;
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in huai ten thukna ding a neih louh ziak un, na hampha ding; midikte thohnawn chiang in thuknawn na hih ding ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan a an umpih kuahiam in huai thu a za a, a kiang ah, “Pathian gam a an ne ding a hampha hi” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan aman a kiang ah, “Mi kuahiam in nitakin Ankuang thupi a lui a, mi tampi a sam hi;
  </para>
  <para style="p">
    <verse number="17" style="v" />Annek hun in, a misapte kiang ah, ‘hong paita un, bangkim a manta,’ chi ding in a sikha khat a sawl hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan avek un thukhatsat in paulam a neichiat uhi. A masapen in, a kiang ah, lou ka leita a, a en dia ka hoh kiphamoh hi; hon hehpih inla, hon ngaisiam hen, a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Midang in bawngtal tuaknga ka leita a, a siat a phat chian ding in ka kuan ding a, hon hehpih inla hon na ngaisiam hen, a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan midang in, zi ka neita a, huaiziak in ka hoh theikei, a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan sikha in a pu kiang ah, huai thute a vahilh hi. Huan inn neipa a heh a, a sikha kiang ah, ‘kintak in pawt inla, kongzing leh kawmkal ah pai mengmeng inla, tagahte, piangsualte, mittawte, khebaite hiai lai ah hon pilut in,’ a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan a sikha in, Pu, n’on thupiak bang in ka hihkhin a, himahleh mun awnglai lai ve aw, a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A pu in, sikha kiang ah, ‘Pawt inla, lamlian leh daikil kal ah pai inla, ka inn dimna ding in mi hon sawllut teitei in a chi hi.’
  </para>
  <para style="p">
    <verse number="24" style="v" />K’on hilh ahi, ka misapte khat in leng ka Ankuang lui a chiam kei hial ding” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan mipi thupitakte a kiang ah a hohsam ua; huchi in amah a kihei a, a kiang uah,
  </para>
  <para style="p">
    <verse number="26" style="v" />“Kuapeuh ka kiang a hongpai in, a pa, a nu, a zi, a tate, a unau a sanggamnu, leh amah hinna nangawn huat kei leh ka nungzui ahi theikei ding.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kuapeuh a Kros pua a hon zuilou ka nungzui ahi theikei ding.
  </para>
  <para style="p">
    <verse number="28" style="v" />Nou lak a kuapeuh in insang lam tum le uchin, amasa in tuin, lam zohna khop sum na neih uleh neih louh thei ding in, aman ding dan kua ahia sut lou ding?
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchilou in zaw, suangphum khin phot a, a lamzoh theihkei leh, a en peuh in,
  </para>
  <para style="p">
    <verse number="30" style="v" />‘Hiai min gel napi in a zou thei ngalkei chi in, a nuihsan ding uh.’
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan kumpipa kuan ahia kumpipa dang dou ding a a kuan ding in, amasa a tu a, mi sing nih toh amah dou ding a hong, mi sing khat toh a tuah ngam ding leh ding louh, mi dong lou ding?
  </para>
  <para style="p">
    <verse number="32" style="v" />Huchi ahihkei vanglak leh, kumpipa dang gamlapi a a omlai in, kituahna lam thuchiam ngen ding in palai a sawl ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchibang in, nou lak ah kuapeuh a neih tengteng paisanlou ka nungzui ahi theikei ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Chi a hoih a, himahleh chi a pen khit in, bang in a hih al nawn ding a?
  </para>
  <para style="p">
    <verse number="35" style="v" />Lei ading in a hoihkei; ekvum ding in leng a hoih sam kei; min a paikhia uhi. Kuapeuh zakna ding a bilnei in za hen” a chi hi.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan siahkhawnmite leh mikhialte tengteng in a thu za ding in a kiang a honzuan uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Pharisaite leh laigelhmite’n, “Hiai mi’n mikhialte a khawl a, a kiang uah an a ne chi in, a phun tuaktuak uhi.”
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in aman a kiang uah hiai gentehna a gen hi:
  </para>
  <para style="p">
    <verse number="4" style="v" />“Nou lak ah kuapeuh in belam za khat nei henla, a lak ua khat mangsak leh gamdai ah sawmkua leh kuate nusia in, a mang pen a muhnawn masiah kua ahia zong lou ding?
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan a muhnawn un kipaktak in a liangzang ah a pua hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Inn a tuntak un, a lawmte leh a vengte uh a samkhawm ua, a kiang uah, ‘hon kipahpih un, ka belam mang ka munawnta,’ a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />K’on hilh ahi, huchi mah bang in, midik sawmkua leh kua kisik tuan ding neiloute sang in mikhial khat kisik tung ah van a mi a kipak zaw ding uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan numei kuapeuh in makhai sawm nei in khat mangsak leh, khawnvak de in, inn phiat in a muhnawn masiah kua ahia hoihtak a zong lou ding?
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan a muhnawn in, a lawmte leh a vengte a samkhawm a, hon kipahpih un, ka makhai mansak ka mu nawnta, a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />K’on hilh ahi, huchi mah bang in, Pathian angelte ma ah, mikhial khat kisik tung ah, kipahna a om nak hi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Mi kuahiam in tapa nih a nei hi:
  </para>
  <para style="p">
    <verse number="12" style="v" />A naupangzaw pen in, a pa kiang ah, Pa, gou ka tansik honpia in, a chi hi. Huchi in, a sum a kiang uah a hawmta hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan ni sawtlou nung in a tapa naupangzaw pen in a tansik tengteng a lakhawm vek a, gam gamlapi ah a zinta hi, huai ah nuamtat lua in a sum a mawkzat mangta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a zatbei zohvek tak in, huai gam ah kial thupitak a hongtung a; nekding a hong tasamta hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in huai gam mi khat a vabel a; aman vokan pe ding in a lou ah a sawl hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan thil hawng vok in a nekte ua kihihvah a ut mahmah a; kuamah in bangmah a pe ngalkei uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan amah leh amah hong kiphawkkhiak tak in, ka pa kiang a kilohte annek senglouh a tamtam toh, kei lah hiai ah gilkial a si ding himai veng in;
  </para>
  <para style="p">
    <verse number="18" style="v" />Ka thou ding a, ka pa kiang ah ka pai ding a, a kiang ah, “Pa, van a tung ah leh nangmah mitmuh in thil ka hihkhial; na tapa a sehtak ka hita kei hi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Na kiang a kiloh khat bang in honbawl in ka chi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchi in a thou a, a pa kiang ah a paita hi. Huan gamlapi a a omlai in, apan a mu a, a lainat mahmah a, a tai a, a vapoma a tawp tonton hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A tapa in a kiang ah, ‘Pa, van a tung ah leh nangmah mitmuh in thil ka hihkhial; na tapa a sehtak ka hita kei’ a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Himahleh apan a sikhate kiang ah, ‘puan hoihpen hon lakhe pah unla, silhsakun; a khut ah zungbuh a khepek ah khedap bunsakun;
  </para>
  <para style="p">
    <verse number="23" style="v" />Bawngnou thautak honla unla; gou un, i ne ding ua, nopbawl in i om ding uh;
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiai ka tapa a si a, a hong hing nawnta hi; a mang a, i mu nawnta uhi,’ a chi hi. Huchi in kipaktak in a om panta uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Huan a tapa upazaw lou ah a om hi; inn a hong tunkuan in bangpeuh tum ging leh lam husa a zata hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in a sikha khat a sam a, tua bang ahia? chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan aman a kiang ah, ‘na nau a hongtung a, damtak a a muhnawn ziak in na pa’n bawngnou thautak a gou,’ a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amah a heh a, a lut nuam kei hi; huchi in, a pa hong pawtkhia a, amah a hongsam hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Himahleh aman a pa kiang ah, ‘ngai in, kum hiai zah na nna sem ing a, na thu a talek ngeilou ing a; ka lawmte toh kipahna ka bawlna ding in kelnou leng n’on pe ngeikei hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Himahleh hiai na tapa kizuakte kiang a na sum nemang vekpa a hong tuntakin amah ading in bawngnou thautak na goh a,’ chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan aman a kiang ah, ‘Ka tapa, ka kiang a om gige hi chin a, ka neih tengteng nang a ahi.’
  </para>
  <para style="p">
    <verse number="32" style="v" />Kipak leh nuamtak a om ding ahi; hiai na nau a si a; a hong hing nawn a; a mang a, i mu nawnta ahi” a chi hi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Jesu’n a nungzuite kiang ah hiai thu leng a gen a: “Mi sumhau kuahiam in sumkemmi a nei a; huai min a sum a zatbeisak thu ah a kiang ah a hek uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in aman amah a sam a, a kiang ah, ‘na tungtang thu ka zak bangchidan ahia? Na sumkepthu hon pelut in; tuban siah sumkem in na pang thei nawn kei ding,’ a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sumkempan, a lungsim in, ‘ka toupa’n ka sumkep hon tawpsak ding hi a, bangchi’n ka hihdia leh? Lei toh ka ngapkei a, khutdoh lah ka zum ngal hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sumkep a hon tawpsak hun chiang in a innte ua hon omsak theihna ding un ka hih ding dan ka theita,’ a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in a toupa sumbate a sam chiat hi, a masapen kiang ah, ‘Ka toupa lak ah bangzah na ba a?’ a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman, ‘thau tehna dan za khat, a chi a, aman a kiang ah, na lai la inla tumeng inla, sawmnga gelh in,’ a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Midang kiang ah, Nang bangzah na ba a? a chi hi. Aman buh tehna dan za khat, a chi a, aman a kiang ah, ‘Na lai la inla, sawmgiat gelh in,’ a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a toupa’n sumkempa diklou a lemtheih ziak in a phat a; vak tate sang in hiai khovel tate a tulai thu ua a pilzawk ziak un.
  </para>
  <para style="p">
    <verse number="9" style="v" />“K’on hilh ahi, diktatlouhna sum in nou adin lawm bawl un, sum a bei hun chiang a tangtawn a omna a a hon omsak na ding un.
  </para>
  <para style="p">
    <verse number="10" style="v" />‘Kuapeuh tawmchik tung a ginomlou tampi tung ah leng a ginom kei uhi.’
  </para>
  <para style="p">
    <verse number="11" style="v" />Sumlem tung a bawn na ginom kei uleh kuan ahia hauhna dik noute hon kemsak ding?
  </para>
  <para style="p">
    <verse number="12" style="v" />Midang a tung a bawn na ginom kei un, noumau a kua’n honpe ding a?
  </para>
  <para style="p">
    <verse number="13" style="v" />Sikha kuamah in heutu nih na a semkop theikei, khat hua in khat a deih ding, ahihkeileh khat gum in khat a musit ding, Pathian leh sumna na semkop theikei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Pharisai sum deihte’n huai thu tengteng a za ua, a nuihsan uh.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in aman a kiang uah, “Mi mitmuh a ki siamtangsak na hi uh, himahleh Pathian in na lungtang uh a thei a; mihing lak a a pahtawi uh Pathian mitmuh in kihhuaipi ahi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Dan leh Zawlneite, Johan hongom tan in a om a; huai nung siah Pathian gam Tanchinhoih a gen ua, michih in pawnglut a sawm uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh danthu sutvom neuchik a man sang in lei leh van a manthat a baihlam zaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kuapeuh zi ma a, a dang nei, angkawm ahi; kuapeuh mi zi maksa nei angkawm ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Huan mi hausa kuahiam a om a, puan sandup leh puanmalngat a silh a, niteng in nuamsatak in a om hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A min Lazar khutdoh, meima a pumdim, a kongkhak bul ah a lum hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi hausa dohkan a khatehnen kiate nek a lunggulh a; uite’n a meimate a liahsak uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan hichi ahi a, khutdohpa a si a, angelte’n a paipih ua, Abraham angsung ah a koih uhi. Mi hausa leng a si a, vui in a omta hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan misi khua ah gimthuak in a om a, a daktou a, gamlapi a Abraham leh a angsung a Lazar om a muta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A kikou a, ‘Pa Abraham, ka tung ah zahngai inla, Lazar honsawl in, a khutzung muk tui ah diah henla, ka lei hihvotna din; hiai mei kuang ah ka gim mahmah hi,’ a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh Abraham in, ‘Ka tapa, nang na damlai in, thil hoih na mu a, huchi mah bang in Lazar in thil hoihlou a muh thei tanla; himahleh tun ah amah zaw hiai ah khamuangtak in a om a, nang zaw gim neive.
  </para>
  <para style="p">
    <verse number="26" style="v" />Tua lou leng hiai a kipan a nou kiang a paitumte a pai theihlouhna ding un leh kuamah huai a kipan a kou kiang a a hong kai theihlouhna ding in, kou leh nou kikal ah guam thupitak koih denin a om hi,’ a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan aman, ahihleh, pa, amah ka pa inn ah paisak ding bek in, k’on ngen hi;
  </para>
  <para style="p">
    <verse number="28" style="v" />‘Sanggam pasal nga ka nei a; hiai gimna mun ah a hongpai kha ding uh chih a kiang uah vahilh leh’ a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Abraham in bel, Mosi leh zawlneite a neive ua oi; huai mite thu ngai le uh a ke, a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan aman Pa Abraham, ‘hilou e; misi lak a mi hilhial a kiang uah hoh leh a kisik ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A man a kiang ah, Mosi leh zawlneite thu a ngaih kei un zaw, misi lak a mi thounawn hoh mah leh leng a taksang tuankei ding uh’ ” a chi hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Jesu’n a nungzuite kiang ah, “Puknate omlou thei a hi kei; himahleh puknate omsakpa tung a gik hi:
  </para>
  <para style="p">
    <verse number="2" style="v" />Hiai mi neute lak a khat leng hihpuk sang in, a hihpuk ding ngawng ah buhgawina suang oksak in, tuipi ah kipai leh, amah ading in a hoihzaw ding hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilvang un, na unau in thil a hihkhelh leh taihilh in; a kisik leh, ngaidam in.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ni khat in na tung ah sagihvei thil hihkhial in sagihvei, ka kisik, chi a nang lam a a hong kiheinawn leh na ngaidam ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan sawltakte’n Toupa kiang ah, “Ka ginna uh khangsak in” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Toupa’n, “Ankam tangkhat bang ginna na neih uleh, hiai singtheimi kung kiang ah, na kibotkhia inla, tuipi ah na kisuan in, na chi ding ua, na thu uh a mangmai ding hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />“Himahleh nou lak ah kuapeuh in leilet hiam, belam ching hiam sikha nei unla, a hong vaipaitakin, an hon umpah aw, kua ahia nou lak a na chi ding?
  </para>
  <para style="p">
    <verse number="8" style="v" />‘Ka nekding hon bawlsak inla, puanteng inla, ka nek a ka dawn zoh masiah ka nek bawl in; huaikhit chiang in nang ne in dawn in, na lak ua kua ahia na chi zaw lou ding?’
  </para>
  <para style="p">
    <verse number="9" style="v" />Na thu bang ua a hih ziak in na sikha kiang ah kipah thu na gen ngei ua hia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchibang in ‘nou leng na kiang ua thupiak tengteng bang a na hih nung un, sikha phatuamlou, ka hih ding him uh ahi ka hih uh,’ chi un,” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan hichi ahi a, Jerusalem kholam a a pailai in, Samaria leh Galili gam a tawn hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan koi khua hiam a a lut ding in, mi phak ngenta, sawm in a na dawn uhi, huaite’n gamla tak ading in aw ngaihtak in,
  </para>
  <para style="p">
    <verse number="13" style="v" />“Jesu Heutupa, ka tung uah zahngai in” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman amau a muh in, a kiang uah, “siampute kiang ah va kilak un” a chi hi. Hichi ahi a, a pailai un a hong siang chiat uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan a lak ua khat in dam chih a kitheih in, aw ngaihtak a Pathian phatkawm in a kiknawnta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan a khebul ah a khupboh a, a kipahthu a gen hi; huai mi Samari mi ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Jesu’n, “Mi sawm hong siangta hilou na hi umaw? Kuate koi ah?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Pathian phat ding a kiknawn, hiai theihlouhmi kia loungal kuamah muh a omlou uhia?” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A kiang ah, “Thou inla, paita in; na ginna na dampih hi” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pharisaite’n Pathian gam hongtun hun ding a dot ziak un, a kiang uah, “Pathian gam muhtheih in a hongtung kei;
  </para>
  <para style="p">
    <verse number="21" style="v" />‘En un, hiai ah, hiam, huai ah, hiam, a chi kei ding uh;’ ngai un, Pathian gam na lak uah a om” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan nungzuite kiang ah, “Mihing Tapa damlaini ni khat bek na muh nop ni uh a hongom ding a himahleh na mu kei ding uh.
  </para>
  <para style="p">
    <verse number="23" style="v" />Na kiang uah, ‘hiai ah en un, hiam pam ah en un, a honchi ding ua; paikhe kei unla, amau leng zuikei un;’
  </para>
  <para style="p">
    <verse number="24" style="v" />van nuai lehlam a khua a phiat a, van nuai lehlam tanpha a a vak zel bang in Mihing Tapa a hongpai ni in a om ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="25" style="v" />Himahleh huai ma in thil tamtak a thuak ding a, tulai khangte deihlouh in a om ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Noah damlai a thil omdan bang in, Mihing Tapa a hongpai nawn hun chiang in a omsam ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Noah long a a lut a, tui a honglet a, avek ua a hihlup khit ni a tun masiah, a ne un a dawn ua, zi leh pasal in a kinei uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchibang in Lot damlai in a hongom a; a ne un a dawn ua, a lei un a zuak ua, a suan un a lam uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Himahleh Sodom khua a kipan Lot a pawt ni’n van a kipan mei leh kat a zu a, avek un a hihlumta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchibang in Mihing Tapa a hong kilak ni in a om ding hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huai ni’n kuamah a van insung a om, amah inn tung a om, vala ding in kum kei heh; lou a om leng paikei hen.
  </para>
  <para style="p">
    <verse number="32" style="v" />Lot zi theigige un.
  </para>
  <para style="p">
    <verse number="33" style="v" />Kuapeuh a hinna humbit sawm in a mansuah ding a kuapeuh a hinna tan in a humbit ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />K’on hilh ahi, huai zan in lupna khat ah mi nih a lum ding ua, khat lak in a om ding a, khat nutsiat in a om ding hi;
  </para>
  <para style="p">
    <verse number="35" style="v" />Numei nih buhgawizan in a om ding ua, khat lak in a om dia, khat nutsiat in a om ding hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pasal nih lou ah a om ding ua; khat lak in a om dia; khat nutsiat in a om ding, a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amau a kiang ah, “Toupa, koi ah eita?” a chi ua, a dong uhi. Aman a kiang uah, “Saluang omna peuh ah musane leng a kikhawm ding uh” a chi hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan lunglellou a thum gige ding ahi chih theihna ding in a kiang uah gentehna a gen hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Koilai khua hiam ah thukhenmi khat a om a, huai min Pathian a lau kei a, mihing leng khawk a sa kei hi;
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai khua ah meithai khat a om a; aman, ka melma tung ah phu hon laksak in, chi in, a kiang ah a hoh zihzeh hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan amah sawtkhop a utkei a; himahleh a nung in a lungsim in ‘Pathian laulou in mihing khawksa keimah leng;
  </para>
  <para style="p">
    <verse number="5" style="v" />Hiai meithainu’n hon hihbuai ziak in a phu ka laksak mai ding, huchilou in zaw, a hong zihzeh leh a hon hihgim kha ding,’ a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Toupa mah in, thukhen midiktatlou thugen za un.
  </para>
  <para style="p">
    <verse number="7" style="v" />‘A tung uah dohzou tadih mah leh leng a mitel, a sun a zan a amah samte phu Pathian in a laksak kei dia hia?’
  </para>
  <para style="p">
    <verse number="8" style="v" />K’on hilh ahi, a phu uh a laksak pah ding. Himahleh Mihing Tapa a hongpai chiang in leitung ah huaibang ginna a honmu diam?” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan midiktat hih kigingta a, midang tengteng musit kuate hiam kiang ah hiai gentehna leng a gen hi:
  </para>
  <para style="p">
    <verse number="10" style="v" />“Mi nih Pathian biakin ah thum ding in a hohtou ua; khat Pharisai ahi a, khat siahkhonmi ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Pharisai ading a, amah kia in hichibang in a thum hi: ‘Pathian, midang, negute, dikloute, angkawmte bang ka hihlouh ziak leh, hiai siahkhonmi bang leng ka hihlouh ziak in na tung ah ka kipak hi.’
  </para>
  <para style="p">
    <verse number="12" style="v" />Nipikal teng in nihvei an ka ngawl zel; ka neih teng sawm a khat ka pe zel, a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Siahkhonmi’n bel gamla tak ading in, vanlam leng a dak ngamkei a, ‘Pathian, kei mikhial, ka tung ah zahngai in,’ chi in, a awm a kitum hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />K’on hilh ahi, amasa sang in huai mipen siamtang in a inn ah a paikikta hi. Kingaithupi peuh a niam ding ua, kingainiam pahtawi in a om ding” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan a khoih ding in a kiang ah a naungekte uh a honpi ua; nungzuite’n huai a muhtak un a na tai uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh Jesu’n amau a sam a, “Naupang neute ka kiang ah hon paisak unla, kham kei un, Pathian gam huchibang mite a ahi ngal a.
  </para>
  <para style="p">
    <verse number="17" style="v" />Chihtaktak in k’on hilh ahi, kuapeuh Pathian gam naupang neu in a kipahpih bang a kipahpihlou asung ah a lut kei hial ding” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Vaihawmmi kuahiam in, a kiang ah, “Sinsakpa hoih, tangtawn hinna tanna ding in bang ka hihdia?” chi in, a dong hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu’n a kiang ah, “Bangdia hoih honchi? Mi khat kia ngallou kuamah hoih a omkei, huai tuh Pathian ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Thupiakte, Angkawm ken, Tualthat ken, Gu ken, Hek ken, Na nu leh pa zahtak in, chihte, na thei vele” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Aman, “Huai tengteng ka tuailai chila kipan ka zui zel” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Jesu’n huai a zaktak in a kiang ah, “Tuin thil khat na sam hi; na neih tengteng zuak inla, gentheite kiang ah hawm in, huchi in van ah gou na nei ding; huan hongpai inla, honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amah bel, huai thute a zak in a lungkham mahmah a, a hauh mahmah ziak in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in Jesu’n amah a en a, “Mihaute Pathian gam lut haksa na e!
  </para>
  <para style="p">
    <verse number="25" style="v" />Mi hausa Pathian gam a lut sang in sangawngsau phimbil a lutsuak a baihlam zaw hi” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai thu zate’n, “Huchi a hih in kua hotdam in a omthei dia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman, “Mihing hih vuallouh Pathian hihtheih ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Peter in, “Ngai in, kou bangkim nusia in k’on zui uh” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman a kiang uah, “Chihtaktak in k’on hilh ahi, Kuapeuh Pathian gam ziak a, inn hiam, zi hiam, unaute hiam, nu le pa hiam, tate hiam paisan photphot,
  </para>
  <para style="p">
    <verse number="30" style="v" />Tu damsung mahmah in a sang a tamzaw mulou ding kuamah a omkei, hunhong tunglai ding a tangtawn hinna toh” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan sawmlehnihte a kiang ah a pituam a, a kiang uah, “Ngai un, Jerusalem khua a hohtou ding i hi ua; zawlneite thugelh tengteng Mihing Tapa tung ah a tung ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jentelte kiang ah piak in a om ding a, nuihzabawlna in a zang ding uh, zumhuaitakin a bawl ding ua, a chilphih ding uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan a vaw ding ua, a that ding uh; ni thum ni’n a thou nawn ding” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huai thute a theisiam kei ua, a thugen a lak uah sel in a om a, bang gen ahia chih leng a theikei uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan hichi ahi a, Jeriko khua a tunkuan in, mittaw kuahiam lamgei ah khutdoh in a na tu hi;
  </para>
  <para style="p">
    <verse number="36" style="v" />Huai min mipi paiging a za a, bangchi thu ahia chih a dong hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Amau, “Nazaret Jesu a pai ahi” chih a hilh uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huchi in, “Jesu, David Tapa, hon hehpih in” chi in, a kikou hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />A masate’n dai ding in a tai ua, himahleh, “David Tapa, hon hehpih in” chi in, a kinak kou semsem hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in Jesu ading a, a kiang a honpi ding in thu a pia hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />A kiang a hongtun in, “Na tung ah bangchi a ka hih ahia na deih?” a chi a, a na dong hi. Aman “Toupa, muhtheih ka ut” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu’n a kiang ah, “Mutheita in, na ginna dampih na hi” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan thakhat in a muthei pahta a, Pathian phatkawm zel in amah a zuita hi; huan mi tengteng in huai a muh un, Pathian a phat uhi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jeriko khua ah Jesu a lut a, paisuak din a kisa hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ngai in, mi khat a min Zakai a om a; huai mi tuh siahkhon heutu ahi a, amah leng a hau ngial hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu mi bangchi banghiam muh a tuma; amah lah a niam ngal a, mipi ziak in a mu theikei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in a matai a, a en ding in theipi kung ah a kal a ; huai lampi a hontot ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu huai mun a tun in a dak a, a kiang ah, “Zakai, hongkum meng in; tuni’n na inn a tung ding ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan kintak in a kuma, kipaktak in amah a zintunta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai a muhtak un avek un, “Mikhialte kiang a tung ding in a lutta ve” chi in, a phun uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Zakai ading a, Toupa kiang ah, “Ngai in, Toupa, ka sum kimkhat tagahte kiang ah kape ding a; kua lak ah leng thil bangpeuh na negu taleng, a lehli in ka din ding” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu’n a kiang ah, “Tuni’n hiai inn ah hotdamna a hongtungta, amah leng Abraham tapa ahi ngal a.
  </para>
  <para style="p">
    <verse number="10" style="v" />Mangthangte zong a hondam ding in Mihing Tapa a hongpai ahi him hi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan huai thute a ngaihkhiaklai un, Jerusalem khua a naihtak ziak leh Pathian gam hong langpah ding hi a a gin ziak un gentehna a gen hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in hiai thu a gen hi. “Mi hoih kuahiam gamukna thu la a hong kiknawn ding in khaw gamla tak ah a hoh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />A hoh ding in a sikhate sawm a sam a, a kiang uah dangka sawm a pia a, ka hongtun nawn masiah hiai in sum na sin un, a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh a khuate’n a hua ua, hiai mi katung ua vaihawm ding in ka deihkei uh, chi in a nung ah thu a khak uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan hichi ahi a, gamukna thu a lak a, a hong kiknawn in a sikha sum a piakte, a hekpung dan uh theihna din a samsak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />A masapen a hongpai a, ‘Toupa, na dangka sawm in a pung,’ a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman a kiang ah, ‘Sikha hoih, na hih hoih e; tawmchik tung a na ginom ziak in khaw sawm tung ah heutu in om in’ a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />A nihna a hongpai a, ‘Toupa, na dangka nga in a pung e’ a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amah kiang ah leng, ‘nang leng khaw nga tung ah heutu in om in,’ a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan midang a hongpai a, Toupa en in, hiai na dangka, kho-ul nulna puan in ka kem kinken hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Mi mawktat na hihziak in k’on lau hi; na koihlouh leng na la a, na tuh louh leng na at ngal a, a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan aman a kiang ah, sikha gilou, na paukam suakngei in k’on siam louh ding. Mi mawktat ka hih a, ka koih louh leng ka lak a, ka tuh louh leng ka at na thei maw?
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi ahihleh bangdia ka dangka sum in a na koihlou? Huchi in ka hongpai in a pung toh ka lak ding ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a kiang a dingte kiang ah, ‘a sum laksak unla, dangka sawm neipa kiang ah pia un,’ a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amau a kiang ah, Toupa, aman sum sawm a nei a ka, a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />K’on chi ahi, ‘a nei peuh piak behlap ahi ding a, a neilou a neihsun leng laksak ahi ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Himahleh hiai ka galte a tung ua vaihawm dia hon deihlou, honpi unla, ka ma ah that un’ ” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai thu a gen khit in Jerusalem kholam naihtou in ma a kai hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan hichi ahi a, Bethphage leh Bethani khaw kiang, Olive tang kichi a tun in, nungzuite lak a mi nih a sawl hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Na mazawn khua uah va hoh unla; huai ah na luttung un sabiltung nou kikhih, kuamah tuanna ngei nailouhna, na vamu ding ua, huai hon phel unla, honkai un.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan kuapeuh in ‘bangdia phel?’ chi a a hondot uleh ‘Toupa’n a deih ahi,’ ” chi un, a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan a misawlte a paita ua, a kiang ua a gen bang in a vamu uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Sabiltung nou a phellai un, a neite’n a kiang uah, “Sabiltung nou bangdia phel?” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amau, “Toupa’n a deih ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huchi in Jesu kiang ah a honkai ua; huan sabiltung nou tung ah a puante uh a phah ua, a tung ah Jesu a tuangsak uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huan a paina ding lampi ah a puante uh a phah uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan a tunkuan in, Olive tang kumsukna ding tak ah, nungzui mipi tengteng in a thil thupi hih tengteng a muh ziak un a kipak ua, aw ngaihtak in Pathian a phat uhi;
  </para>
  <para style="p">
    <verse number="38" style="v" />“Toupa min a kumpipa hongpai a hampha e; van ah lem thu leng henla, tungnungpen ah thupina om hen” chi in.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan mipi lak a Pharisai khenkhat in a kiang ah, “Sinsakpa, na nungzuite tai in” a chi uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman bel k’on hilh ahi, “Hiaite a daih uleh suangte bek a kikou ding uh” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan a tunkuan in, khua a mu a, a kahkhum a;
  </para>
  <para style="p">
    <verse number="42" style="v" />“Aw, nang tel in tusung in khamuanna thei leteh aw: himahleh tun zaw na muhlouhna ding in a kiselta ngal a.
  </para>
  <para style="p">
    <verse number="43" style="v" />Na galte’n na kim in leikulh a khoh ding ua, a hon um ding ua, na kim in pawt theihlouh in a hon opkhum ding ua, huchibang nite na tung ah a hongtung ding hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Na sung a na ta, na naute, nangmah toh lei ah a hon pai ek ding ua; na sung ah suang kichiang himhim a hawikei ding uh; veh a na om ni na theihlouh ziak in” chi in.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan Pathian biakin ah a valut a, bangpeuh zuakte a delhkhia a, a kiang uah,
  </para>
  <para style="p">
    <verse number="46" style="v" />“Ka inn thumna inn ahi ding, chih gelh ahi; nou bel suamhatte khuk in na bawlzaw uh” a chi hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan niteng in Pathian biakin ah thu a hilhzel hi. siampu liante, laigelhmite leh, vantang lak a heutu deuhte’n amah hihmang a tum uhi;
  </para>
  <para style="p">
    <verse number="48" style="v" />Himahleh mipi’n phatuamngaitak a a thugen a ngaihkhiak ziak un, a hih ding dan a thei tuankei uhi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />1 Huan ni khat Pathian biakin a mite thuhilh a, Tanchinhoih a genlai in, siampu liante, laigelhmite, upate toh a kiang ah a hongpai guih uhi;
  </para>
  <para style="p">
    <verse number="2" style="v" />A kiang ah, “Kua thu in ahia hiai thilte na hih? Kuan ahia thu honpia? honhilh in” a chi uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Aman a kiang uah, “Ken leng thu kamkhat k’on dongsam ding; hon dawng un” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />“Johan baptisma van a kipan hia, mihing a kipan?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A kingaihtuah ua, “Van a kipan chi le hang, bangdia amah ginglou? honchi thepthup ding hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Mihing a kipan chi lehang lah, mi tengteng in suang in a hon deng ding uh; Johan zawlnei a hih a thei ngal ua” a chi uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in a dawng ua, “Koi a kipan ahia ka theikei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Jesu’n a kiang uah, “Ken leng kua thu in ahia hiai thil ka hih chih k’on hilh sam kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan mipite kiang ah hiai gentehna a gen a; “ Mi kuahiam in grephuan a bawl a, a loukemte kiang ah khohloh ding in a pia a, sawtpi tam ding in gamdang ah a hohta hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan a gahloh hun in a tan ding gah a piak ding un loukemte kiang ah sikha khat a sawl hi; ‘himahleh loukemte’n a na vua uhi.’
  </para>
  <para style="p">
    <verse number="11" style="v" />Sikha dang a sawlnawn a; ‘huai leng a na vaw nawn in, zumhuaipi in a na bawl ua, khutvuak in a paisak nawnta uhi.’
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan a thumna a sawlnawn a; huai leng hihliam in a paikhia uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huaizoh in grephuan neipa’n, bangchi’n ka hihdia? ‘Ka tapa deihtak ka sawlmai ding; amah a na zah khamawh kei ding uh,’ a chi hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Himahleh loukemte’n amah a na muhtak un, ‘hiai gouluah dingpa ahi, that ni, huchi in, a gou ei a ahi ding,’ chi in, a kihou uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in grephuan apat a paikhia ua, a hihlumta uhi. Huan grephuan neipa’n amau bang a lohta dia le?
  </para>
  <para style="p">
    <verse number="16" style="v" />Loukemte a hong hihmang dia, huan grephuan midangte a pe ding” a chi hi. Huan huai a zak un, “Huai telzaw tungkei leh” a chi uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh amaute a en a, ahihleh hiai thu a gelh uh bang ahia? “Inlammite suang deihlouh pen, huai mahmah a ning a suang phatuampen a hong hita” chih.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuapeuh huai suang tung a puk a kitat gawp ding; a delhkhakte houh a delhzan ding, a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huailai tak in laigelhmite leh siampu liante’n mat a tum ua; himahleh mipi a lau ua; huai gentehna amau dem in a gen chih a theih ziak un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Gamukpa vaihawmna leh thuneihna nuai a a piaktheih na ding un, a thu genkhelh tang in a enkhia ua, mi hoih a kibawl enkhetu a guk sawl uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau a kiang ah, “Sinsakpa, diktak in thugen in na sinsak zel a, kuamah khentuam neilou in chihtaktak in Pathian thu na hilhzel chih ka thei uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kaisar kiang a siah ka piak uh siang hia, sianglou?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh aman a zekhem uh a thei a, a kiang uah, “Bang a chia hon ze-et na hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Na sumtang uh honlak un, kua lim leh kua min ahia tuang?” a chi a, amau “Kaisar lim” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman a kiang uah, “Tua ahihnung, Kaisar thilte Kaisar kiang ah pia unla, Pathian thilte Pathian kiang ah pia un” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huchi in mipi ma a paukhelh lakding a mukei ua; a dawnna lamdang a sa mahmah ua, a daidide uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan Saddukai, thohnawnna a omkei chite lak a mi kuate hiam a kiang ah a hong ua; thu a dong uhi:
  </para>
  <para style="p">
    <verse number="28" style="v" />“Sinsakpa, Mosi in, min zi nei in, ta neilou in sihsan leh, a unaupa’n a zi luah in, a unaupa ading in chi a suahsak ding chih, a gelh hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ahi a, unau pasal sagih a om ua; upapen in zi a nei a, ta neilou in a si hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />A nihna in a luah a; ta neilou in a si nawn hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />A thumna in a luahnawn a, huchibang in unau sagihte’n a neichiat ua, ta neilou in a si uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A tawpna ah numei leng a sita hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi ahihleh thohnawn hun ah a kuapen zi ahi dia? Amau sagihte’n zi in a neichiat uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan Jesu’n a kiang uah, “Tulai mite zi leh ta in a kinei zel ua;
  </para>
  <para style="p">
    <verse number="35" style="v" />himahleh huai hun chiang a teltak ding leh, misi lak apat thohnawnna tangtak a seh peuhmahte, zi leh ta in a kinei nawn kei ding uh;
  </para>
  <para style="p">
    <verse number="36" style="v" />Sih leng a si nawn theikei ding uh, angelte bang a om ding ahi ngal ua; thohnawnna tate a hih ziak un, Pathian tate ahi ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Misi kaihthoh in a om ding uh chih Mosi in leng Loubuk ah, Toupa, Abraham Pathian, Isak Pathian, Jakob Pathian, a chih lai in, a theisak hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Amah misi Pathian a hi kei a, mihing Pathian ahizaw; amah ngaih in mi tengteng a hing vek ngal ua” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Laigelhmi kuahiam in, “Sinsakpa, na gendik e” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in thudang a dong ngam nawn kei uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan aman a kiang uah, Khrist David tapa ahi chih bangchidan a chi thei uh ahia?
  </para>
  <para style="p">
    <verse number="42" style="v" />Sa. laibu ah David mahmah in, Toupa’n, ka Toupa kiang ah, ka taklam a tuin,
  </para>
  <para style="p">
    <verse number="43" style="v" />“Na melmate na khepek ngakna dia ka bawl masiah, a na chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huchi in David in amah “Toupa a chi ngal a, bangchi’n ahia a tapa a hih theih?” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan mi tengteng theih in a nungzuite kiang ah, laigelhmite lak ah pilvang un.
  </para>
  <para style="p">
    <verse number="46" style="v" />“Amau puanaktual silh a vak a ut ua, dawlmun ah chibaibuk leh, kikhopnain a tutphah hoihpen a tut, Ankuangluina ah mun hoihpen a deihtuam nak uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Meithaite innte a negai ua, mi khemna ding in sawt pipi a thum uhi. Huaite’n siamlouh a nak tansem ding uhi” a chi hi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan a dak khia a, mi haute’n sumkholna a sum a khiaklai uh a mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Meithai zawngtak kuahiam in dal dangka muza nih hong khia leng a mu hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in, “Chihtaktak in k’on hilh ahi, hiai tengteng sang in tua meithai zawngtakin a khe tamzaw;
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiai tengteng in a neihlet uh a khia ua; aman bel a kitunhingna ding a a neih sunsun a khevek” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan kuate hiam in Pathian biakin thu, suang hoihtak leh thil piakkhawm a a zep kilawm dan uh, a genlai un, aman,
  </para>
  <para style="p">
    <verse number="6" style="v" />“Hiai na thilmuh uh, hih chiplouh a suang kichiang himhim hiai ah a omkei ding; huaibang ni a hongtung ding” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan amau a kiang ah, “Sinsakpa, huaite chikchiang in a hongom ding ua? Huaite a hongtun ding chiamtehna bang a om dia?” chi in, a dong uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan aman, “Pimang a na omlouhna ding un pilvang un. Mi tampi in, ‘Khrist ka hi’ a hun tungding ahita, chi in, keimah minsial in a hongpai ding uh, huaite zuikei un.’
  </para>
  <para style="p">
    <verse number="9" style="v" />Kidou thu leh buai thu na zak hun chiang un lau kei un; huaite a tung masa ding a, tawpna bel hipahlou ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />A kiang uah, “Nam tuam leh nam tuam a kidou ding ua, gam tuam leh gam tuam a kidou ding uh.
  </para>
  <para style="p">
    <verse number="11" style="v" />‘Zin nakpitak in a ling ding a, mun tuamtuam ah kial a ke ding a, hipi a leng lai ding; van a kipan thil lauhuai leh chiamtehna thupitak a hongom ding hi.’
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh huai thil tengteng a tunma in, nou a honman ding ua, kikhopnain leh suangkulh ah pi in a hon hihgim ding uh, keimah min ziak in kumpipate leh gamukte ma ah a honpi ding uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Hiai noute ading a theihpihna hun lemtang ahi ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in dawnna ding ngaihtuah khawllou ding in na lungtang uah kihih kip un.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na melma tengteng un hondou ua honsel theihlouhna ding un kam leh pilna ka honpe ding a.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan na nu leh na pate, na unaute, na sanggamte, na lawmte un leng hon mansak ding ua; a khen a honthat ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Keimah min ziak in mi tengteng huat na hi ding uh.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh, na samzang uh khat leng a mangthang kei ding.
  </para>
  <para style="p">
    <verse number="19" style="v" />Na kuhkalna uah na hinna uh na humbit ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Himahleh sepaihte’n Jerusalem khua a um uh na muh chiang un, a mangthang dek chih thei un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huai hun chiang in Judia gam a omte’n tang ah taimang san u hen; asung a omte’n pawtsan u hen, gam a omte asung ah lut kei uhen.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai nite phulakna ahi, thu a gelh tengteng uh a hongtun theihna ding in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai nite in gaite leh naunou pawmte tung a gik ding, khovel ah haksatna thupitak a tun ding ziak in leh hiai chite tung a thangpaihna a tun ding ziak in.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan namsau in a si ding ua, namchih kiang ah sal a pi in a om ding uh; huan Jentelte ni a tawp mateng Jerusalem Jentelte sikden in a om ding hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Huan ni leh kha leh aksite ah, chiamtehna a om ding a; tuipi mau leh a kihoh ziak in lei ah leng namchih haksatna leh mangbatna a tung ding;
  </para>
  <para style="p">
    <verse number="26" style="v" />mite launa ziak leh khovel a thil hongtung ding ngaihtuah ziak in, a sibup ding uhi; van thilhihtheihnate a ling ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huai hun chiang in Mihing Tapa thilhihtheihna leh thupina thupi toh meilak a hongpai a mu ding uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan huai thilte a hong tunpat chiang in entou unla, dak khia un; na tatna uh hong naita ahihman in” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan a kiang uah gentehna thu a gen a: “Theipi kung leh sing tengteng en un;
  </para>
  <para style="p">
    <verse number="30" style="v" />A hong selnoutakin huai na mu ua, nipi hongtung ding ahi chih noumau in na thei uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi mah bang in nou leng huaite hongtung na muh chiang un, Pathian lalgam a hongnaita chih thei un.
  </para>
  <para style="p">
    <verse number="32" style="v" />Chihtaktak in k’on hilh ahi, thil tengteng a tunkim masiah tulai khangte a mangkei ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Lei leh van a mang dia, ka thu zaw a mang kei ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />“Himahleh pilvang un, huchilou in zaw nek vahluat toh, zukham toh damsung khosak ngaihtuah in, na lungtang uh a dimlaw kha ding a, huai ni’n thangawk bang in thakhat in na tung uah a hongtung guih kha ding hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Tuabang tak in leitung tengteng a omte tung a tung chiat ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huai thil hongtung ding tengteng pel ding leh Mihing Tapa ma a dingtak ding a seh na hihtheihna ding uleh thahatna na neihna ding un chiklaipeuh in thumkawm in limsak gige un” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan niteng in Pathian biakin ah thu a hilhzel a; zan teng in a pawt a, Olive tang a chih uah a giak zel hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan zing in a thu ngaikhe ding in mi tengteng Pathian biakin ah a kiang ah a hongzel uhi.
  </para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />1 Huan Tanghou Silngou Sohlouh Ankuangluini, Paikan Ankuangluina kichi a naita hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Siampu liante leh laigelhmite’n hihlupna dan a zong ua, vantang lah a kihta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Sawmlehnihte lak a pang, Judas, Iskariot kichi sung ah Setan a lut hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in amah a vapai a siampu liante leh heutute kiang ah zuausan a matsak theihna ding dan a va kihoupih hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amau a kipak mahmah ua, a kiang ah dangka piak a chiamta uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Aman lem a sa a, mipi omlouh kal a zuausan a matsakna lemtang a zawngta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan Tanghou Silngou Sohlouh ni, Paikan Ankuangluina belamnou gohna ding ni, a hongtungta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in Jesu’n, “Peter leh Johan a sawl a, Paikan Ankuang i nek ding in hon va bawlsak un” chi in.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan amau a kiang ah, “Koi ah vabawl le ung na ut a?” a chi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan aman a kiang uah, “Ngai un, khopi a na lut un, pasal, bel a tui pua in hontuak ding a, a lutna inn ah zuilut un” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Inn neipa kiang ah, “Sinsakpa’n, ka nungzuite toh Paikan Ankuang ka nekna ding uh, mikhual inn pindan koilai ahia, a honchi, na chi ding uh.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in aman indan tungnung zapi, van omsa, a hon ensak ding; huai ah hih un,” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan a hohta ua, a kiang ua a gen bangtak in a muta ua; huan Paikan Ankuang a vabawl uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan a nek hun in, aman an a um a, a sawltakte’n a umpih sam uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan a kiang uah, “Ka thuak ding ka thuak ma in hiai Paikan Ankuang hon nekpih ka ut mahmah hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />K’on hilh ahi, hiai Pathian gam a a taktak a hih masiah, ka ne nawn kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan nou a la a, kipahthu a genkhit in, “Hiai la unla, kihawm un;
  </para>
  <para style="p">
    <verse number="18" style="v" />K’on hilh ahi, tuban Pathian gam a hongtun masiah grepgui gahtui ka dawn nawn kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan tanghou a la a, kipahthu a genkhit in a balkham a, a kiang uah a pia a, “Hiai ka sapum ahi, na sikua piak ding ahi; keimah theihgigena in hihzel un” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huchibang in nitak annek zoh in nou a la a, “Hiai nou ka sisan a thukhun thak, na sikua pawt ding ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh ngai un, zuausan a hon mansak dingpa khut ka kiang ah dohkan tung ah a omta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Mihing Tapa a seh bangtak in a pai ding hi, himahleh zuausan a mansak dingpa mihing tung a gik hi!” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan amau lak ah “Huchibang thilhih ding kua ahi dia le?” chi in, a kidong uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan a lak uah kuapen ahia thupipen a seh chih thu ah, kiselna a hongpawt hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman a kiang uah, “Jentel kumpipate a tung uah a thunei gige uh a, a tung ua thuneite Nu leh Pa, a chi gige uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh nou zaw huchibang na hi kei ding uh; na lak ua thupipen nauzaw bang in om henla, makai pen leng na sempen bang in omzaw hen.
  </para>
  <para style="p">
    <verse number="27" style="v" />Kua ahia thupizaw, an um hia, an pepa? An um hilou hia? Himahleh kei zaw na lak uah nasempa bang in ka om hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />“Ze-etna ka tuah sung noute kei hon ompihte na hi uh;
  </para>
  <para style="p">
    <verse number="29" style="v" />Huchi in kei ka Pa’n gam a hon sehsak bang in gam k’on sehsak ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Ka gam a ka dohkan a na nek ua na dawn theihna ding un; huchi in, Israel nam sawmlehnih vaihawm sak in mangtutphah ah na hongtu ding uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Simon, Simon, ngai in, Setan in buhsep bang a a honsep theihna ding in, noute hon ngen eive.
  </para>
  <para style="p">
    <verse number="32" style="v" />Himahleh na ginna a manlouhna ding in k’on thumsak hi; na kihei nawn chiang in nang na unaute hihkip in, a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan aman a kiang ah, Toupa, na kiang ah suangkulh ah leh sihna ah leng pai sam ngap ka hi, a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Aman Peter, k’on hilh ahi, n’on theihna ah thumvei n’on kitheihmohbawl masiah tuni in ak a khuang kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan a kiang uah, “Dangka iplou, kawlzal lou leh khedap lou a k’on sawlkhiak in bang na tasam ua?” a chi hi. Amau, “Bangmah” a chi uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman a kiang uah, “Tun zaw dangka ipnei in keng henla, kawlzal toh, kuapeuh namsau neilou in a puan zuak henla, lei hen.
  </para>
  <para style="p">
    <verse number="37" style="v" />K’on hilh ahi, Amah talekte lak ah sim tel ahi, chih gelh ka tung ah a hongtung ahi; ka tungtang thu tungkim ngei ding ahi ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan amau, “Toupa, en dih, hiai ah namsau nih a om” a chi ua. Aman a kiang uah, “A hun” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan amah a pawt a, a ngeina dan in Olive tang ah a hohta a; nungzuite’n leng a zui uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />A mun a vatun un, a kiang uah, “Khemna a na lutlouhna ding un, thum un” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan suang a denphak tan vel ah a vapai tuamta hi;
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan a khukdin a, a thum a, “Pa, hoih na sakleh hiai nou ka kiang apan lasuan in; himahleh kei thu hilou in, nangmah thu hi zaw hen” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan van a kipan angel khat a hihhat ding in a kiang ah a hong kilak hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan a gim mahmah a, phatuamngai nawnsem in a thum a; a kho-ul, sisan bang in mal liantak in lei ah a takkheta hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan a thum khit a a thoh in, nungzuite kiang ah a hongpai a, a lungkham ziak un a na ihmu uh a mu hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan a kiang uah, “Bangdia ihmu na hi ua? Khemna a na lutlouhna ding un thou unla, thum un” a chi hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huan huai a genlai tak in, ngai dih, mipi a hongpai ua, sawmlehnihte lak a tel Judas in a ma uh a kai a; tawp tum in Jesu a honzuan hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Himahleh Jesu’n, a kiang ah, “Judas, Mihing Tapa tawp a mansak ding na hi maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huan a kim a mite’n thil hongtung ding a theihun, “Toupa, namsau in ka sat ding uam?” a chi uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan a lak ua kuahiam in siampu lianpen sikha a sat a, a bil taklam a satkhiak sak hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan Jesu’n, “Hih nawn ken” a chi a, a bil a khoih a, a hihdamta hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Jesu’n a kiang a hong siampu liante Pathian biakin heutute leh upate kiang ah, Namsau leh khetbuk tawi in, suamhat man ding bang hial in na hong kuan uh maw?
  </para>
  <para style="p">
    <verse number="53" style="v" />Pathian biakin a na kiang ua niteng a ka omlai in hon mat tum in n’on sawk kei ua; himahleh tu mial thuneihna toh na tat hun uh ahi, a chi hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huan a man ua, a pi ua, siampu lianpen inn ah a pilut uhi. Peter in gamlapi ah a zui hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Huan inn huangsung intual ah mei a chih ua, a tu khawm ua, Peter a lak uah a vatu sam hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Huan meivak a a tutlai in nungak kuahiam in a mu a, a en nilouh a, “Hiai mi leng a kiang a om ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Aman bel, “Numei, amah ka theikei” chi in a kitheihmohbawl hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />A denchiang deuh in midang in a hong munawn a, nang leng a lak ua mi na hi ve, a chi hi. Peter in bel, “Mihing aw, ka hi kei” a chi hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Huan dakkal khat phial nung in, midang in, “Hiai mi leng a kiang a om ahi tham hi; Galili gammi ahi” a chi chiltel hi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Huan Peter in, “Mihing aw, na thugen ka theikei” a chi hi. Huan thakhat in, a paulaitakin ak a khuangta hi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Huan, Toupa a kihei a, Peter a en hi. Peter in, “Ak khuanma in thumvei n’on kitheihmohbawl ding, chi a Toupa’n a kiang a a thugen a hon theikhe nawnta hi.”
  </para>
  <para style="p">
    <verse number="62" style="v" />Huan a pawt a, a kap huphup hi.
  </para>
  <para style="p">
    <verse number="63" style="v" />Jesu lente’n nuihza bawlna’n a zang ua, a sat uhi,
  </para>
  <para style="p">
    <verse number="64" style="v" />A mit a tuam ua, “Kua ahia honsat, gen in?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="65" style="v" />Thu dang tampi in leng a gensia un a kou uhi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Huan khovak tak in Upa hon, siampu liante leh laigelhmite, a hong kikhawm ua, a vaihawmna uah a pi uhi.
  </para>
  <para style="p">
    <verse number="67" style="v" />“Khrist na hihleh honhilh in” a chi uhi. Huan aman a kiang uah: “Honhilh mah leng na gingta kei ding uh;
  </para>
  <para style="p">
    <verse number="68" style="v" />Ken noute thu hon dong lengleng, n’on dawng kei ding ua, na honkhah sam kei ding uh.
  </para>
  <para style="p">
    <verse number="69" style="v" />Himahleh tuban siah Mihing Tapa, Pathian thilhihtheihna taklam ah a tu ta ding” a chi hi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Huan avek un, “Nang Pathian Tapa na hi maw leh?” a chi ua. Aman a kiang uah, hi e, n’on chih bang un, a chi hi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Huan amau bang theihpihna dang i deih lai dia? Eimah mah in amah kamsuak i zata ve le” a chi uhi.
  </para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan mipi tengteng ading ua, Jesu Pilat kiang ah a pita uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />“Hiai mi’n ka chite uh a pimang a, Kaisar kiang ah siahliau a kham, Khrist, kumpipa, a kichih ka za uh” chi in a hekta uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Pilat in, a kiang ah, “Judate kumpipa na hi hia?” chi in, a dong a. Aman “Hi e,” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Pilat in siampu liante leh mipite kiang ah, “hiai mi tung ah bangmah khelhna ka mu kei,” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Himahleh amau, “Galili gam a kipan Judia gam khuateng leh hiai mun tan ah thuhilh in, mi tengteng a fuihse gige” chi in, a khauh semsem uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pilat in huai a zak in, hiai mi Galili gam a mi ahi hiam chih a dong hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Herod uk sungmi ahi chih a theihtakin Herod kiang ah a sawlta a; huailai in amah leng Jerusalem khua ah a om hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Herod in Jesu a muh in a kipak mahmah a; a tanchin a zak ziak in, tuma siah apat muh a ut him ahi a, a thillamdang hih banghiam bek muh a lamen hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan thu tampi a dong a; himahleh bangmah in a dawng tuankei hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Siampu Liante leh laigelhmite’n ding in nakpitak in a hek uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Herod leh a sepaihte’n Jesu a simmawh ua, nuihzabawlna’n a zang uh, puan thupitak silhsak in Pilat kiang ah a sawlnawnta hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai ni nitakin Herod leh Pilat a kihouthei ta uhi; huai masiah zaw kihouthei lou ahi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilat in siampu liante, heutute, mi tengteng a samkhawm a, a kiang uah,
  </para>
  <para style="p">
    <verse number="14" style="v" />“Mite a pimang chi in, hiai mi ka kiang ah n’on pi uhi, ngai un, na ma ua ka etchet nung in na hekna thu uah hiai mi tung ah bangmah khelhna ka mu kei hi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Herod in leng a mu sam kei. I kiang uah a hon sawlnawnta hi. Ngai un, sihna khop hial bangmah a hih kei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in ka vaw ding a, ka pawtsak mai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ankuangluini a lak ua mi khat a pawtsak teitei ding ahi ngal a.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh kituaktakin a kikou ua, “Hiai mi hih mangthang inla, Barabba pen hon pawtsak zaw in” a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai mi khopi a helna leh, tualthah ziak a suangkulh tang ahi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pilat in bel Jesu khah a ut a, a kiang uah thu a gen nawn hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh “Kros ah kilhden in, Kros ah kilhden in” chi in a kikou uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan aman, a thumveina ah a kiang uah, “Bang ding in maw? Hiai min bang ahia ahihkhelh? Sihna khop hial a tung ah bangmah ka mu kei; ka vaw ding a, ka khah mai ding” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Amau bel aw ngaihtak in Kros a kilhden ding in a ngen teitei uhi. Huan a aw un a vau daita uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pilat in a nget bang ua hih ding in thu a hihpukta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Helna leh tualthah ziak a suangkulh tang a nget uh a khah a; Jesu bel a utut a loh ding un a peta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />A pimanglai un, Simon Kurini khaw mi, gam lam a kipan hongpai a man ua, Jesu nunglam paw ding in a tung ah Kros a ngata uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan mi nazong leh numei amah kah a mau zelzul, mipi tampitak in a zui uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Jesu bel amaute lam nga in, “Jerusalem tanute aw, honkah kei un, noumau leh na tate uh ading in kap zaw un” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ngai un, a ni a hongtung ding a, ‘huai ni’n, numei chingte, naupai ngeilouhna gilte, naungek tep ngeilouh nawite a hampha uh,’ a chi ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai hun chiang in mite’n, ‘tangte kiang ah hondelh un’ a chi ding uh, mualte kiang ah, honkhuh un, a chi ding uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Sing a hinlai a bawn hichibang a a hih uh leh; a keu chiang in bang a lohta phet ding ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan a kiang ah midang nih, migilou, hihlup ding in a pisam uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Luguhmun, a chih uh a tun un, migiloute, a taklam ah khat, a veilam ah khat toh Kros ah a kilhden uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n, “Pa, amau ngaidam in; a thilhih uh a theikei ua ahi, a chi hi. Huchi in a puansilhte kihawm in, ai a san uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan mi vantang in ding kawm in a en uhi. Huchi in vaihawmmite’n, “Midang bawn a hondam a ka; Pathian tel Khrist a hihtaktak leh amah leng ki hondam hen aw,” chi in a enghou uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Sepaihte’n leng amah nuihzabawlna’n a nei ua, a kiang ah a hong ua, zuthuk a pia uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Judate kumpipa na hih taktak leh ki hondam in” a chi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan a lutung zawn Kros ah, Grik, Latin leh Hebru laimal in, “HIAI JUDATE KUMPIPA AHI” chi in, laigelh a tak uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan a migilou kilh khat un Jesu a tai a, “Khrist na hi ka hia? Ki hondam inla, kou leng hon hondam tanla” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Himahleh khatpa’n dawng kawm in, a taihilh a, “Pathian nangawn na kihta ka hia kibang sap a hon gawt uh?
  </para>
  <para style="p">
    <verse number="41" style="v" />Eizaw gawt tuak him i hi; i thilhih manlel mu i hi a; hiai min bangmah a hihkhial ngalkei a” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Aman, “Jesu Toupa na Kumpi gam a n’ong pai chiang in hon theigige in” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Aman a kiang ah, “Chihtaktak in k’on hilh ahi, tuni in ka kiang ah Paradise ah na omsam ding” a chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan dakgukna ding ahi a, huai nungsiah dak kua na huntan in gam pumpi a hong mialvekta a, nivak a beita hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Pathian biakin puanzak a lai ah a hong keksuak hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Jesu aw ngaihtak in a kikou a, “Pa, na khut ah ka kha k’on kemsak hi” a chi hi. Huai a chihzoh in a kha a khahta hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Sepaih zaheutupa’n thil omdan a muh in, “Hiai mi pellou in midik ahi ngeingei” chi in Pathian a phat hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huai etnop en ding a mipi hong kikhawm tengteng te’n thil omdante a muh un a awm uh kitum in a kiknawnta uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huan a meltheihte tengteng leh numei Galili gam a kipan a honzuite, huai thilte en in gamla tak ah ading uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan ngai un, mi khat a min Joseph, vaihawmmi, mi hoihtak, diktak, Judate khua khat Arimathai a kipan a om hi,
  </para>
  <para style="p">
    <verse number="51" style="v" />A vaihawm uah leh a thilhih uah leng a ki awikei him hi. Pathian gam a lamen gige hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huai mi Pilat kiang ah a hoh a, Jesu luang a ngen hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huan a lakhia a, puanmalngat in a tuam a, han, suang khuakkuak, kuamah sial nailouhna ah, a sial hi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huan huai ni kisakkholhna ni ahi, khawlni a hong tundek ziak in.
  </para>
  <para style="p">
    <verse number="55" style="v" />Galili gam a kipan a kiang a numei hongte’n a zuizel ua, han leh a luang sialdan a mu uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Huan a pai nawn ua, gimnamtui leh thaunamtui a bawl uhi.
  </para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan khawlni’n thupiak bang in a khawlta uhi; ni sagih ni masapen in; phalvakin, gimnamtui a bawlte uh tawi in, han ah a vahoh uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Hana kipan suangtum khuksuan a om a mu uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan a lut ua, Toupa Jesu luang a mukei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hichi ahi a, huai ziak a a mangbat laiun, ngai in, mi nih puan milengthei silh a kiang uah a hongding uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A lau ua a khupboh lai un, a kiang uah, “Bangdia misi lak a mihing zong?
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai ah a omta kei hi, a thounawnta; Galili gam a a omlai a na kiang ua a thugen theigige un,
  </para>
  <para style="p">
    <verse number="7" style="v" />Mihing Tapa mikhialte khut a matsakin a om ding a, a kilhden ding uh, ni thum ni’n a thounawn ding ahi” a chih a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a thugente a hon theinawn uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Hanmuna kipan a pai nawn un, sawmlehkhatte leh midang tengtengte kiang ah huai thil tengteng a hilh uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Sawltakte kiang ah huai thuhilhte bel Mari Magdalini, Mari, Joanna, Jakob nu Mari leh a kiang ua numei dangte ahi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh huaite thugen thu maimai in a ngai ua, amau a taksang kei uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh Peter a thou a, han ah a taita a; huan a kuna, a en a, puanmalngat omte kia a mu a, huchi in thil omdan lamdangsa tak in inlam ah a paita hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan ngai in, huai ni mah in a lak ua mi nih khua khat Emmau a chih uah a hoh dek ua, huai khua Jerusalem apat ching sawmguk ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan thil hongtung tengteng a gen khawm zel uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Gen a a kisel lai un, Jesu ngei in a honzuan a, a kiang uah a paisamta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh amah a theihlouhna ding un, a mit uh hihvaih in a om hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan a kiang uah, “Paikawm a na genkhawm uh bang thu ahia?” a chi hi. Huan dahmel tak in ading dinden uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huan a min Kleopa pen in a kiang ah, “Jerusalem khua ah nangmah kia in hia na ten, tulai a thil omdan na theihlouh?” chi in a dong hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Aman a kiang uah, “Bang thil eita?“ a chi hi. Amau a kiang ah, “Nazaret Jesu, Pathian leh mi tengteng mitmuh a a thu leh a thilhih a zawlnei minthangtak tanchin thu:
  </para>
  <para style="p">
    <verse number="20" style="v" />Siampu liante leh ka heutute un thah ding in thu a pia ua, Kros ah a kilhden thute uh.
  </para>
  <para style="p">
    <verse number="21" style="v" />Kou amah zaw Israelte tanpa ding a lamen hi ung a, himahleh, huai thiltun nungsiah tuni a ni thumni ahita hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huailou leng ka pawlte uh numei kuate hiam zingsang in, han ah a vahoh ua, hong hih mangbang uhi;
  </para>
  <para style="p">
    <verse number="23" style="v" />A luang mulou pi in, Pathian angelte kilak ka mu uh, huai mite’n a thounawnta chih a gen uh, a hong chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Ka ompihte lak ua kuate hiam han ah a hoh ua, numeite genbang ngei in a mu ua; himahleh amah a mu kei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman a kiang uah, “Mihaite aw, zawlneite thugen tengteng gintak thu a ze awlte aw:
  </para>
  <para style="p">
    <verse number="26" style="v" />Khrist in huai thilte thuak a thupina a lut ding him ahi ka hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mosi leh zawlneite tengteng apan in, Laisiangthou tengteng amah tanchin gelh peuhmah amau a hilhchian zel hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan a hohna ding khua uh a tung dekta ua; amah gamla deuh a hohtum bang in a om hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Kam in a khou ua: “Ka kiang uah tam in; nitaklam leng hi ding hita a, ni leng tumdekta ahi” chi in. Huchi in a kiang ua tam ding in a lutta hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Hichi ahi a, a kiang ua an um a a tut in tanghou a la a, a vualzawl a, a balkham a, a kiang uah a pia hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan a mit uh a hongvakta a, a mel a theita uhi. Himahleh amah a mangta mai hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amau, “Lampi a hon houpihlai a Laisiangthou thute hon hilhchet lai in i lungtang a vakhuai him hilou hia?” a kichi uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huailai tak in, a thou ua, Jerusalem khua ah a kiknawn ua, sawmlehkhatte leh a lawmte omkhawmte a mu uhi,
  </para>
  <para style="p">
    <verse number="34" style="v" />“Toupa a na thounawn taktak ahi, Simon kiang ah leng a kilakta” a na chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Amau lampi a bang thil om hiam chih leh, tanghou a balkhap a, a mel a theihdante uh a hilh sam uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Huai thu a genlai un Jesu mahmah a lakuah a hongdinga, a kiang uah, “Na tung uah khamuanna om hen” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Himahleh mulkimhuai a sa mahmah ua, a lau ua, sikha mu hi in a kingaihtuah uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman a kiang uah, “Bang a chia mangbang na hi ua? Bangdia na lungsim ua ginlahna hongom ahia?
  </para>
  <para style="p">
    <verse number="39" style="v" />Ka khutte ka khepekte en un, kei mahmah ka kei hiam! Hon khoih unla, thei un; sa leh guh nei a n’on muh bang un kha in zaw sa leh guh a nei ngal kei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huai a genkhit in a khutte a khepekte amau a lak hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />A kipahluat ziak ua a gin ngamlouh lamdang a saklai un, a kiang uah, “Hiai ah banghiam nekding na nei uhia?” a chi hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ngahou, bak khat leh khuaizu khak a pia uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />A la a, a ma uah a neta hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan a kiang uah, “Na kiang ua ka omlai a ka tanchin gelh peuhmah thute a hongtung ding chi a k’on hilhhilhte Mosi Dan, zawlneite leh phatnalate a thu kigente hiaite ka thu ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huchi in Laisiangthou thu theihna din a lungtang uh a vaksakta hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Huan a kiang uah, “Hichibang a gelh ahi, Khrist in gim a thuak ding a, ni thum ni’n misi lak a kipan a thounawn ding a chi hi:
  </para>
  <para style="p">
    <verse number="47" style="v" />Amah min in kisikna leh khelh ngaihdamna thu Jerusalem khua apat in namchih kiang ah hilh ahi ding, chi in.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huai thil tengteng a theihpihte na hi uh.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huan ngai un, ka Pa thilchiam na tung uah k’on sawl ding a; himahleh, tunglam a kipan thilhihtheihna silhsak a na om masiah uh khopi ah om kinken un” a chi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Huan Bethani pha in amau a pikhia a; huan a ban a zak a, a vualzawl hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Hichi ahi a, a vualzawl laitak in amau a paisanta a, van ah pitouh in a omta hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huan amah a bia ua, kipak kawm in Jerusalem ah a kik nawnta uhi:
  </para>
  <para style="p">
    <verse number="53" style="v" />Pathian biakin ah Pathian phat in a om nilouh uhi. Amen.
  </para>
</usx>
