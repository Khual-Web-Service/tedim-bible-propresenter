<?xml version="1.0" encoding="utf-8"?>
<usx version="2.0">
  <book code="JHN" style="id">Johan</book>
  <para style="h">Johan</para>
  <para style="toc1">Johan</para>
  <para style="toc2">Johan</para>
  <para style="mt">Johan</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />A tung in Thu a om, Thu tuh Pathian kiang ah a om, Thu tuh Pathian ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai Thu a tung in Pathian kiang ah a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Bangkim avek in amah siam ahi; thilsiam tengteng amah siamlouh bangmah a omkei hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah ah hinna a om, huai hinna mihingte vakna ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Vak mial lak ah a hong vak a; mial in huai a zoukei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Pathian sawl mi khat a hongom, a min Johan ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huai mi theisak ding in a hong, huai vak theisak ding in, amah ziak a mi tengteng in a gintak theihna ding un.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah bel vak ahi kei a, vak thu theisak ding a hong ahizaw hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Vak dik michih hihvak nak a om a, khovel ah a honglel ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Amah khovel ah a om, khovel amah siam ahi, himahleh khovel in amah a theikei hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah a mite kiang ah a hong a, amah a mite’n a na pom kei uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Himahleh amah kipahpih a pom, a min gingtate tengteng Pathian tate suahtheihna a pia hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huai mite bel sisan suan a hi kei ua, sa deihna a suan leng a hi kei ua, mihing deihna a suan leng ahi sam kei ua, Pathian suahsak ahizaw uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai Thu sa a hongsuak a, i lak uah a hongteng hi, hehpihna leh thutak a dim in; a thupina Pa Tapa tang neihsun thupina bangbang i muta uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Johan in amah theihpihna a pia a, “Ka nung a hong paipa’n honkheng, amah ka ma a omsa him ahihman in, chi a a thu ka genpa hiai ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan eite’n a tangchinna a kipan hehpihna tung a hehpih nawnsawnna i tang chiat uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mosi zang a Dan piak ahi a, himahleh; hehpihna leh thutak Jesu Khrist ziak in a hongom hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuamah in chiklai mah in Pathian a mu ngeikei; Tapa tang neihsun, Pa angsung a om in amah a phuangkheta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan Judate’n, “Kua na hia?” chi a, dong ding a, Jerusalem khua a kipan a a kiang a siampute leh Levi chi a mite a sawllai un hiai te Johan thu na theihsak ahi uhi:
  </para>
  <para style="p">
    <verse number="20" style="v" />Aman chiangtakin a gen a, “Khrist ka hi kei hi” chi in, a pulak hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Amau a kiang ah, “Kua na hia leh? Elijah na hi hia?” a chi ua, a dong uhi. Huan aman, “Ka hi kei” a chi hi. “Huai zawlnei na hi hia?” a chi ua. Aman, “Hilou e” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Amau a kiang ah ahihleh, “Kua na hia? Honsawlte ka dawn theihna ding un honhilh in; na tanchin himhim bang ahia na gen ding?” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman, zawlnei Isai gen bang in “Toupa lampi hihtang un” chi a, gamdai a kikoupa aw ka hi, a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />A misawlte uh Pharisaite kiang a kipan kuate hiam ahi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Amau a kiang ah, “Khrist bek, Elijah bek, zawlnei bek na hih kei ngal leh, bang a chia baptist nak na hia leh?” a chi ua, a dong nawn uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Johan in a kiang uah, “Ken tui in k’on baptist a, na lak uah mi khat na theihlouh uh ading ahi,
  </para>
  <para style="p">
    <verse number="27" style="v" />Amah ahi ka nung a hongpai dingpa, ka ma a omsa pen, a khedap khau pheltak leng ka hi kei” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huai Jordan gal a Bethabara a Johan in a baptisna mun a thiltung ahi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan a zing in Johan in Jesu a kiang a hongpai a mu a, a gen a; “En un, Pathian Belamnou khovel khelhna lamangpa!
  </para>
  <para style="p">
    <verse number="30" style="v" />Hiai ahi Amah, mi khat ka nung a hong paipa, ka ma a omsa him ahi, ka chih pa.
  </para>
  <para style="p">
    <verse number="31" style="v" />Amah lah ka na thei ngal kei a; himahleh Israelte kiang a amah latsak a hihna ding in tui a baptist in ka hongpai ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Johan in a thu a theisak a: “Kha vakhu bang in van a kipan a hongsuk ka mu a, a tung ah a tu nilouh, chi in a gen hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Amah lah ka thei ngal kei a; himahleh ‘tui a baptist ding a hon sawlpa’n ka kiang ah, Kua tung ah leng Kha hongsuk a a tung a om na muh peuh, hiai tuh Kha Siangthou a baptispa ahi,’ a honchi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huai ka muta a, hiai mipa Pathian Tapa ahi chih ka theisakta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan a zing nawn in Johan ading a, a nungzui nihte toh; Jesu vial vakvak lai a en a:
  </para>
  <para style="p">
    <verse number="36" style="v" />“En un, Pathian Belamnou” a chi hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A nungzui nihte’n a thugen a za ua, Jesu a zuita uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesu a kihei a, a honzui uh a mu a, a kiang uah, “Bang na zong ua?” a chi hi. Amau “Rabbi, huai sinsakpa chihna ahi, Koi a teng na hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Aman a kiang uah, “Hongle uchin na mu ding uh” a chi hi. Huchi in a hong ua a omna a mu ua; huai ni’n a kiang ah a tam ua, nitak anhuan hun phial ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Johan thugen za a Jesu zuite nih a khat zaw pen Andru, Simon Peter unaupa ahi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Aman a masapen in amah unau Simon a mu a, a kiang ah, “Messia ka muta uh” a chi a, huai bel Khrist chihna ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huchi in Jesu’n amah a na en a, “Johan tapa Simon na hi, Kifa a honchi ding uh” a chi a, huai suang chihna hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan a zing in Jesu’n Galili gam a hoh a tuma, Philip a mu a, a kiang ah, “Honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Philip bel Bethsaida khua mi ahi a, Andru leh Peter omna khopi mah ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Philip in Nathanael a mu a, a kiang ah, a tanchin Mosi in dan laibu a a gelh leh zawlneite’n a gelh uh, “Amah ka muta uhi, Nazaret Jesu, Joseph tapa” a chi hi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Nathanael in a kiang ah, “Nazaret khua ah thil hoih a pawt thei ahia?” a chi hi. Philip in a kiang ah, “Hongpai inla, en in” a chi hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Jesu’n Nathanael a kiang a hong dek in a mu a a tanchin a na gen a, “En un, Israel mitak, zekhemna himhim neilou” a chi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Nathanael in a kiang ah, “Nang bangchidan a honthei na hia?” a chi hi. Jesu’n a kiang ah, “Philip in nang honsap ma a, theipi bul a na omlai in, k’on mu hi,” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Nathanael in a kiang ah, “Rabbi, Pathian Tapa na hi, Israelte kumpipa na hi” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu’n a kiang ah, “Theipi bul ah nang k’on mu hi, na kiang a ka chih ziak in na gingta ahi maw? Hiai te sang a thil thupizaw na mulai ding” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huan Jesu mah in a kiang ah, “Chihtaktak in, chihtaktak in k’on hilh ahi, van kihong a, Pathian angelte Mihing Tapa tung a kahtou leh kumsuk na mu ding uh” a chi hi.
  </para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan ni thum ni in, Galili gam a Kana khua ah kitenna a om a, huai ah Jesu nu a om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu leh a nungzuite leng kitenna ah a chial uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Uain a beitakin Jesu nun a kiang ah, “Uain a tasamta uh e,” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n a kiang ah, “Numei, nang n’on theihsak ding bang ahia om? Ka hun a tung naikei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A nu’n sikhate kiang ah, “Na kiang ua a gen peuhmah hihzel un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Judate silsiang dan bang in suang tuibel guk, buk sawmli mun nih hiam, mun thum hiam ta chiat, huai ah a tung uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu’n a kiang uah, “Tuibelte tui in dimsak un” a chi hi. A gong toh kikim in a dimsak chiat uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A kiang uah “Tuin dim unla, nekbawl thusa kiang ah paipih un” a chi hi. Huchi in a paipihta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nekbawl thusa in, tui uain a hongsuak a chiama, a hong kipatna a theikei a, tuidim sikhate’n a thei uhi, mouneipa a samta a, a kiang ah,
  </para>
  <para style="p">
    <verse number="10" style="v" />“Michih in a tung in uain hoih a hawm ua, a tam deuh a dawn nung un, a hoihlou a hawm uh; nang bel tutan in uain hoih na kem lailai a” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu’n hiai a thillamdang hihpatna Galili gam Kana khua a a hih ahi; a thupina a langsakta a; a nungzuite’n amah a gingta uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan huaikhit in Kapernaum khua ah a hohsuk a, amah leh a nu toh, a unaute toh a nungzuite toh; huai ah ni tamlou chik a om uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Judate Paikan Ankuangluina a naita a, Jesu Jerusalem khua ah a hohtou hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Pathian biakin a bawng, belam leh vakhu zuak leh dangka kheng a tute a mu hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan khauhual in zepna ding a bawl a, belam leh bawng avek un Pathian biakin a kipan a delhkhia a, dangka khengte dangka a sungbua a, a dohkante uh leng a sawnpuk sak hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Vakhu zuakte kiang ah, “Hiai thilte hiai a kipan paipih un, ka Pa inn sumsinna mun in bawlkei un” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan “Na inn a ka phatuamngaihna in a hon gai ding” chih gelh ahi chih a nungzuite’n a theinawnta uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in Judate’n a kiang ah, “Hiai na thilhih chiamtehna bang ahia n’on lah theih?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu’n a kiang uah, “Hiai in hihse le uchin, ni thum sung in ka tung ding nawn ding” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan Judate’n, “Hiai in kum sawmli leh guk lam ahi, nang ni thum sung in na tungding ding maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh amah sapum inn thu gen ahizaw hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huaiziak in, misi lak a kipan a thohnawn in, a nungzuite’n huai thugen a theinawnta uhi. Laisiangthou thu leh Jesu thugen a gingta uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan Paikan Ankuangluina Jerusalem khua a omlai in, a thillamdang hihte a mu ua, mi tampi in a min a gingta uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Himahleh Jesu bel a lak uah a kikangkoih a, mi tengteng a thei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Mihing thu kuamah hilhchet a kiphatmawh louh ziak in; Amahmah in mihing sung a om peuhmah a thei ngal hi.
  </para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pharisaite lak a mi, Judate vaihawmpa, a min Nikodem a om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai mi zan in Jesu kiang ah a hong a, a kiang ah, “Rabbi, Pathian a kipan hongpai sinsakpa na hi chih ka thei uhi. Pathian na kiang a omlou hileh hiai thillamdang na hihte kuamah in a hih theikei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu’n a dawng a a kiang ah, “Chihtaktak in, chihtaktak in k’on hilh ahi, Mi kuapeuh a pianthak kei leh Pathian gam a mu theikei” a chi hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nikodem in a kiang ah, “Mi a teknung in bangchi’n a piangthak thei dia? A nu sung a nihvei lut in a piang thei dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu’n a dawng a, “Chihtaktak in, chihtaktak in k’on hilh ahi, Kuapeuh tui a leh Kha a a pianthak kei leh Pathian gam a lut theikei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Sa suan peuhmah sa ahi a, Kha suan peuhmah kha ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Na pianthak ngeingei ding ahi k’on chih lamdang sa ken.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huih a utna na ah a nung a, a ging na za hi, himahleh koi a kipan hongpai ahia, koi ah ahia a hoh ding chih na thei ngalkei a; kuapeuh Kha a piang huchibang mah in a om hi” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Nikodem in a dawng a, “Hiai bangchi’n a omthei dia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu’n a dawng a a kiang ah, “Israelte sinsakpa na hi ngal a, huaite na theikei maw?
  </para>
  <para style="p">
    <verse number="11" style="v" />Chihtaktak in chihtaktak in k’on hilh ahi, kou ka theih uh ka gen ua, ka muh uh ka theisak uh; himahleh ka thu theihsak uh na sangkei uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Khovel thil k’on hilh bawn gingtaloute’n, vanlam thil honhilh leng bangchi’n na gingta ding ua?
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing Tapa van a ompa leh van a kipan hongsukpa kia loungal kuamah van ah a kahtou ngeikei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Mosi in gamdai a gul a khaikang bang in, Mihing Tapa khaikang in a om ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Kuapeuh a gingta in amah ziak a tangtawn hinna a neihna ding in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Pathian in khovel a it mahmah ziak in a Tapa tang neihsun a pia hi. Kuapeuh amah gingtate a manthat louh ua, tangtawn hinna a neih zawkna ding un.
  </para>
  <para style="p">
    <verse number="17" style="v" />Khovel siamlouh tangsak ding in Pathian in a Tapa khovel ah a sawl kei, khovel amah vanga a hin theihna ding in a sawl ahizaw hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Kuapeuh amah gingta siamlouh in a omkei ding a, kuapeuh a gingtalou, tu a kipan siamlouh in a ompah ngal hi, Pathian Tapa tang neihsun min a gintak louh ziak in.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiai siamlouhna ahi, vak khovel ah a hong a, himahleh min vak sang in mial a itzaw uh, a thilhihte uh a gitlouh ziak in.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kuapeuh thil gilou hih in vak a hawnak, vak ah leng a hongpai kei hi; huchilou in zaw a thilhihte a lang kha ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh kuapeuh a dik hihte a thilhih uh Pathian ziak a hih chih a latna ding in vak ah a hongpai uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huaikhit in Jesu a nungzuite toh Judia gam ah a hoh ua, huai ah Jesu a kiang uah a om nilouh a, a baptist zel uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Johan in leng Ainon ah, Salim khaw kiang ah a baptist sam a, huai a tui a tam ziak in mi a hong ua, baptisma a tang uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Hiai hun in Johan suangkulh a khum ahi naikei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan Johan nungzuite leh Juda khenkhat silsiang thu ah a kisel uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Johan kiang ah a hongpai ua, a kiang ah, “Rabbi, Jordan gal a na kiang a om, a thu mi na theihsakpan, ngai dih, mi a baptist a, mi tengteng a kiang ah a hongpai uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Johan in a dawng a, “Van apan a piak ahihkeileh mihing in bangmah a nei theikei uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kei Khrist ka hi kei hi, a ma a misawl ka hi, ka chih, noumau mahmah hon theihpihte na hi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mouneipa mounu pasal ahi; himahleh mouneipa lawm ding a a thu za mouneipa aw ziak in a kipak mahmah a; En un ka kipahna a tungta ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amah a lian semsem ding a, kei bel ka neu hiaihiai ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tunglam a kipan hongpai zaw mi tengteng sang a tungnungpen ahi; lei a kipan bel lei a ahi a, leithu a gen a, van a kipan a hong paipa zaw mi tengteng sang a tungnungpen ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />A muh leh a zak peuh a theisak hi; kuamah in a thu theihsak a taksang kei uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />A thu theihsak taksang in, Pathian midiktat ahi, chih a kipsak hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Pathian sawl in Pathian thu a gen hi; aman zaw teh chitchiat in Kha a pe ngalkei hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pa in Tapa a it a, a khut ah bangkim avek in a peta hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Kuapeuh Tapa gingta in tangtawn hinna a nei; himahleh Tapa gingtalou in hinna a neikei ding a, Pathian thangpaihna a tung ah a omzaw” a chi hi.
  </para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Johan sang in Jesu’n nungzui tamzaw a bawl a, tam a baptist zaw chih Pharisaite’n a za uh chih Toupa’n a theih in,
  </para>
  <para style="p">
    <verse number="2" style="v" />Jesu hial in zaw a baptist kei, a nungzuite’n a baptist zawzel uhi,
  </para>
  <para style="p">
    <verse number="3" style="v" />Judia gam paisan in, Galili gam ah a kik nawnta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huchi in Samaria gam tawnsuak a a pai teitei a kul hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huchi in Samaria gam khua khat, Saikar a chih uah a hongtung a, Jakob in a tapa Joseph kiang a mun a piakna kiang ahi;
  </para>
  <para style="p">
    <verse number="6" style="v" />Jakob tuileh huai ah a om hi. Huchi in Jesu a paigim ziak in tuileh gei ah a tu a; sun annek hun ahi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Samari numei khat tuitawi in a hong kuan a, Jesu’n a kiang ah, “Dawn ding honpia in” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A nungzuite lah nekding lei in khua ah a hohta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huchi in Samari numei in a kiang ah, “Nang Judami hi chin a, kei Samari numei hi’ng a, bangchidan a ka kiang a dawn ding hon ngen na hia? a chi hi. Judate’n Samari mite bangmah in a ngai ngal kei ua” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu’n a dawng a a kiang ah, “Pathian thil thawnpiak leh dawn ding honpia in, na kiang a chipa thei leteh zaw nang a kiang a ngen zaw ding chin a, aman tuihing honpe ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan numei in a kiang ah, “Pu, suahna ding bangmah lah na neikei a, tuileh a thukthuk toh, koi a kipan in ahia huai tuihing na muh ding?
  </para>
  <para style="p">
    <verse number="12" style="v" />Ka pu uh Jakob sang in na thupizaw ahia? Aman hiai tuileh honpia a, amah leh a tate leh a gante’n leng a dawn uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Jesu’n a kiang ah, “Kuapeuh hiai tui dawn a dangtak nawn ding uh;” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />“Kuapeuh a kiang a ka piak ding tuidawn bel, dangtak nawn ngeilou ding a; a kiang a tui ka piak ding pen amah ah tuinak a hong phulkhe ding a, tangtawn hinpha in a kikhohtou ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan numei in a kiang ah, “Pu, huai tui honpe ve, ka dangtak nawn louhna ding leh hiai tantan a tuitawi ding a ka hong kuanlouhna din” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu’n a kiang ah “Pai inla, na pasal va sam inla, hiai ah hongkik nawn in” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Numei in a kiang ah, “Pasal ka neisam a” chi in a dawng hi. Jesu’n a kiang ah, “Pasal ka neisam a, na chih zaw, na chi dik ve;
  </para>
  <para style="p">
    <verse number="18" style="v" />Pasal nga na neita a, tua na neihpa na pasal ahi kei him ahi, hiai thu na chidik ve” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Numei in a kiang ah, “Pu, zawlnei na hi chih ka thei hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Kou pipute’n hiai tang ah Pathian a bezel ua; nou bel mihing in Pathian a biakna mun ding Jerusalem khua ahi na chi sese ua” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan Jesu’n a kiang ah, “Numei, kei hon gingta in, hiai tang chitchiat lou leh Jerusalem khua chitchiat lou ah leng Pa na biak hun uh a tungta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Nou na theihlouhpi uh na benak ua; kou zaw ka theih uh ka bia uhi. Hotdamna Judate a kipan ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh a hun a tungta, tuin leng a tungkhin lel hi, huai hun chiang in Pathian be taktakte’n kha leh thutak a Pa be ding uh ahi, Pa’n huchibang mi a bemi ding in a zong hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Pathian zaw Kha ahi; a bemite’n kha leh thutak a a biak ngeingei ding uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Numei in a kiang ah, “Messia, Khrist a kichi, a hongpai ding chih ka thei, amah a hongpai chiang in bangkim a honhilh ding” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu’n, “Keimah nang hon houpihpa, huai amah ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan huailai in a nungzuite a hongpai ua, numei a houpih lamdang a sa mahmah uhi; himahleh kuamah in “Bang zong na hia? Bangdia numei houpih?” a chi kei uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Numei in a tuibel a paisan a, khua ah a vapai a, mite kiang ah,
  </para>
  <para style="p">
    <verse number="29" style="v" />“Ka thilhih peuh honhilh zel mi khat a om, hong unla, en dih uh; Khrist a hih theihtuak hiam?” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amaute khua a kipan a hongpawt ua, a kianglam a zuanta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huai kal in nungzuite’n a kiang ah, “Sinsakpa, ne in” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Himahleh aman a kiang uah, “An na theihlouh uh nekding ka nei” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan nungzuite a kihou ua, “A nekding min a hontawi ding ua eita maw? a kichi uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n a kiang uah a gen a, “Hon sawlpa deihlam hihleh, a nna sepzoh ding ka an ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Nou, Buhlakna ding kha li a omlai, na chi uh hilou hia? Ngai un k’on hilh ahi, dak unla loute en un, tu mahmah in lak ding in a min ahi.
  </para>
  <para style="p">
    <verse number="36" style="v" />A lapa’n loh a mu a, tangtawn hinna ding in gah a la hi, huchi a a tuhpa leh a lapa a kipah tuak theihna ding un.
  </para>
  <para style="p">
    <verse number="37" style="v" />Khat in a tuha, midang in a la chih thu hiai ah a dik hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Na sepgimlouh uh at dia honsawl ka hi; midang in a sem ua, nou a sepsa uh na sunzom uh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan numei in, “ka thilhih peuh honhilh zel,” chi a a theihsak thu ziak in huai khua a om Samari mi tampi in Jesu a gingta uhi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in Samari mite Jesu kiang ah a hongpai ua, a kiang ua om ding in a khou ngutngut ua; huchi in huai ah ni nih a tam hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan midang tampi in amah thu ziak in a gingta samta uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Amau numei kiang ah, “Tun zaw na thugen ziak a gingta ka hi kei uh; koumau ngei in a thu ka za ua, hiai mipa khovel Khrist, Hondampa ahi ngeina chih ka theita uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan ni nih nung in huai apan pawt in, Galili gam ah a paita hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Jesu ngei in, zawlnei zaw amah kholam ah pahtawi in a om ngeikei chih a theisak hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huchi in Galili gam a hongtun in Galili gam mite’n a na kipahpih ua, Jerusalem khua a Ankuanglui lai a a thilhih tengteng a muhtak ziak un; amau mah leng Ankuangluina ah a hohsam uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Galili gam a Kana khua, tui uain a suahsakna mun a hongtung nawnta hi. Kumpi Milian kuahiam a om a, a tapa Kapernaum khua ah a china hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Judia gam a kipan Galili gam ah Jesua hong chih a zak in a kiang ah a hohtou a, “Va hohsuk a a tapa sidekdek hihdam ding in” a chial hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Jesu’n a kiang ah, “Chiamtehnate leh thillamdangte na muhkei uh leh na gingta kei hial ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huan Kumpi Milian in a kiang ah, “Pu, ka ta sihman hongsuk mai in” a chi hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Jesu’n a kiang ah, “Pai nawnta in, na tapa a damta” a chi hi. Huai mipa’n Jesu’n a kiang a thu a gen a gingta a, a paita hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />A paisuk lai in a sikhate’n a na dawn ua, “Na tapa a damta” a na chi uhi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Aman a kiang uah a dam tunglai a dong hi. Amau a kiang ah, “Zan in ni kihek lai in a khosik a daita hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Naupang pa’n Jesu’n a kiang a, “Na tapa a damta hi” a chihlai ahi chih a theita a; amah leh a inkuanpihte’n avek un, a gingta ta uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Hiai Judia gam a kipan Galili gam a a hong a Jesu thillamdang hih a nihveina ahi.
  </para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thil nung in Judate Ankuangluina a om a; Jerusalem khua ah Jesu a hohtou hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Jerusalem ah belam kongkhak kiang ah dil a om a, huai mun Hebru pau in Bethes’da a chi ua, inlim nga a nei hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai ah tui hongtat ngak in damloute, mittawte, khebaite, zawte tampi a lum uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Bang hun hiam in huai dil ah angel a hohsuk a, tui a vatok a; kuapeuh huai tui a kitoh khit a valut masa penpen in, bangchibang natna nei hileh leng hihdam in a om zel hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huai ah kum sawmthum leh giat damlou mi kuahiam a om hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu’n a lum a mu a, huchibang in sawtpi a omta chih a thei a, a kiang ah, “Hihdam na ut hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Damloupa’n, “Pu, tui kitoh in dil a honkoih ding mi ka neikei hi, ka hohsung in midang in hon makhelh nak uh” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Jesu’n a kiang ah, “Thou inla, na awngphah la inla, khe in paita in” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Thakhat in huai mipa a dampah a, a awngphah la in, a paita hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huai ni khawlni ahi, huchi in Judate’n a dampa kiang ah, “Khawlni eive, na awngphah na lak a siangkei” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman a kiang uah, “Hon hihdampa ngeingei in ka kiang ah, na awngphah la inla, khe in paita in” honchi ahi, a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Amau a kiang ah, “Na awngphah la inla, khe in paita in, na kiang a chipa kua ahia?” a chi ua, a dong uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh a dampa’n kua ahia a hih a theikei hi, huai a mipi a om ziak un Jesu a paimangta hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />A denchiang in Jesu’n amah Pathian biakin ah a mu a, a kiang ah, “Ngai in, na damta hi, khialnawn ken, huchilou in zaw thil hoihlou sem na tung ah a hongtung kha ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan huai mi a va paikhia a, Judate kiang ah “A hihdampa Jesu ahi” chih a hilh hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in khawlni a a thilhih ziak in Judate’n Jesu a engbawl uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Himahleh Jesu’n amau a houpih a, a kiang uah, “Ka Pa’n tutan pha’n nna a semzel a, ken leng ka semzel” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huchi in Judate’n hihlup a tum semsem ua, khawlni a tanlouh ziak kia ahi kei a, Pathian amah Pa a a bawl leh Pathian toh kikim a a kibawl ziak in leng ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Jesu’n a kiang uah, “Chihtaktak in, chihtaktak in, k’on hilh ahi, Tapa in amah in bangmah a hih theikei, Pa thilhih a muh kia loungal; thil a hih peuhmah, Tapa in leng a hih samzel hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Pa in Tapa a it a, a thilhih peuhmah a kiang ah a musak a; hiaite sang a thilhih thupizaw a kiang ah a musak lai ding, lamdang na sak ding un.
  </para>
  <para style="p">
    <verse number="21" style="v" />Pa in misite a kaithou a, hinna a piak bang in, Tapa in leng a utna na kiang ah hinna a pia hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pa in kuamah vai a hawmsak ngeikei, vai tengteng Tapa in a hawm sak zawta hi;
  </para>
  <para style="p">
    <verse number="23" style="v" />Mi tengteng in Pa zahna a piak bang un, Tapa leng zahna a piakna ding un. Kuapeuh Tapa zahloute’n, Pa a sawlpa leng a zahkei uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Chihtaktak in, chihtaktak in, k’on hilh ahi, Kuapeuh ka thu za a, hon sawlpa gingta in, tangtawn hinna a nei; siamlouh in a omkei a, sihna a kipan a pawt a, hinna ah a lut zawta hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Chihtaktak in chihtaktak in k’on hilh ahi, A hun a tung dekta, tuin leng a tung lellelta, huai hun chiang in misite’n Pathian Tapa aw a za ding ua, a za peuhmah a hing ding uh.
  </para>
  <para style="p">
    <verse number="26" style="v" />Pa in amah a hinna a neih bang in, Tapa in leng amah a hinna nei ding in a peta hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Mihing Tapa a hih ziak in, a kiang ah thukhenna leh thuneihna a pia hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Hiai lamdangsa kei un, a hun a tungta, huai hun chiang in han a om tengteng in a aw a za ding ua,
  </para>
  <para style="p">
    <verse number="29" style="v" />A hong pawtvek ding uhi; thil hoih hihte hinna tang in a thounawn ding ua, thil gilou hihte siamlouh tang in a thounawn ding uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />“Keimah in bangmah ka hih theikei; bil a ka zak bangbang in vai ka hawmzel; ka vaihawm a dik ahi, keimah deihlam in om ka tum kei a, hon sawlpa deihlama om ka tup zel ziak in.
  </para>
  <para style="p">
    <verse number="31" style="v" />“Keimah tanchin theisak hileng, ka thu theihsak a dik kei ding hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Ka tanchin theisak midang ahi, aman ka tanchin a theihsak a dik chih ka thei hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Nou Johan kiang ah mi nasawl ua, aman thutak thu hon theisak hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thu theihsak ka san mihing a kipan ahi kei a; himahleh na hinna ding un hiai thu ka gen ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huai Johan khawnvak kuangtak leh vaktak ahi, a vak ah nuamsak tak dih na ut uhi.
  </para>
  <para style="p">
    <verse number="36" style="v" />“Himahleh theihsakna ka neihzaw Johan theihsakna sang in a thupizaw hi: Pa’n thilhih zohding a a honpiak, ka thilhih ngei in Pa’n honsawl chih ka tanchin a theisak hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />“Pa hon sawlpa’n leng ka tanchin a theisakta hi. Nou chiklai mah in a aw na za ngeikei ua, a mel leng na mu ngeikei uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />A thu leng noumau ah na paikei uh, a sawlpa na gintak louh ziak uh ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />“Laisiangthou na simsim ua, asung a tangtawn hinna om a na gintak ziak un: huai Laisiangthou ka tanchin theihpihna ahi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Himahleh hinna nei ding in ka kiang ah na hong nuam kei uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Mihing pahtawina ka sangkei.
  </para>
  <para style="p">
    <verse number="42" style="v" />Himahleh nou k’on thei hi, Pathian itna noumau ah na neikei uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Ka Pa min in ka hong a, noute’n n’on kipahpih kei uh: midang amah min in hong leh amah na kipahpih ding uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nou kipahtawi tuahna paktate’n Pathian tak kia a pawt pahtawina zong lou in bangchi’n kei n’on gingta thei ding ua?
  </para>
  <para style="p">
    <verse number="45" style="v" />Ken Pa kiang a nou k’on hek ding gingta kei un: nou honhek khat a om na muan uh Mosi ngei ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Mosi gingta hile uchin aman kei tanchin gelh a, keileng n’on gingta tading uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Himahleh amah thugelh gingtalou in, bangchi’n ka thute na gingta ding ua?” a chi hi.
  </para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thilte khit in, Galili dil, Tiberias dil kichi gallam ah Jesu a paita hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Damloute tung a thillamdang a hihte a muh ziak un mipi tampi in amah a zui uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu tang ah a hohtou a, huai ah a nungzuite kiang ah a tu hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Paikan Ankuangluina, Judate Ankuangluina a naita hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu a dak a, mipi tampi in a kiang lam honzuan in a mu a, Philip kiang ah, “Hiaite nekding tanghou koi a lei ding i hi ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai thu amah ze-et nadia a gen ahi, a hih ding lah aman a theigige hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Philip in a kiang ah, “Michih in tawmchik a a tan chiat ding u leng, makhai za nih man tanghou in a daihkei ding” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan a nungzuite lak a khat, Simon Peter unau Andru in a kiang ah,
  </para>
  <para style="p">
    <verse number="9" style="v" />“Barli buh tanghou phel nga leh ngasa nih nei pasal naupang khat hiai ah a om hi; himahleh mi hiai zah lawmlawm lak ah bang tham hizou ding ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu’n, “Mite tusak un” a chi hi. Huai ah loupa tampi a om hi. Huchi in pichingte a tuta ua, a tamlam uh sang nga vel ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu’n tanghou phelte a la a, kipahthu a genkhit in a tute kiang ah a hawm a, huchi mah bang in ngasate leng a deihhun un a hawm sam hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan a kham nung un, a nungzuite kiang ah, “Bangmah manglou ding in a nente luak un” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in a luak ua, barli buh tanghou phel nga nete nekbang nente bawm sawmlehnih a hihdim uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Mite’n a thillamdang hih a muhtak un, “Hiai mi, zawlnei, khovel a hong dingpa a na hingei e” a chi uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in amah kumpipa dia bawl ding a mat teitei tum in a hong kuan ding uh chih Jesu’n a thei a, tang ah amah kia in a paituam nawnta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan nitaklam in a nungzuite dil ah a paisuk uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Long ah a tuang ua, dil ah Kapernaum khua a zuan uhi. Khua a mialta a, Jesu lah a kiang uah a hongtung naikei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huihpi hattak a nun ziak in tui a kihot sang hulhul hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Ching sawmnih leh ching nga hiam, ching sawmthum hiam a kalh nung un, Jesu dil tung ah khe a pai a, long honnaih in a mu ua, a lauta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Himahleh aman a kiang uah, “Keimah ka hi, lau kei un” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in kilawptakin long ah Jesu a tuangsakta ua, huchi in long a zot gam uh a tungpah hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />A zing in dilgal lehlam a mipi dingte’n, long khat loungal long dang a omkei a, Jesu a nungzuite toh long ah a tuang tonkei a, a nungzuite amau kia in a pai uh chih a thei uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Himahleh Toupa’n kipahthu a gen nung a, tanghou a nekna kiang uh, Tiberias khua a kipan long neuchikchik a hongtung uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in mipi’n Jesu leh a nungzuite a omta kei uh chih a theih un, amau leng longneute a tuang in, Jesu zong in Kapernaum khua a hongtung uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan dilgala a hong muh un a kiang ah, “Rabbi, chik in ahia hiai lam n’ong tun? a chi uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu’n a kiang uah, “Chihtaktak in, chihtaktak in, k’on hilh ahi, thillamdangte na muh ziak ua hon zawng na hi kei ua, tanghou phel na nekvah ziak uh ahizaw.
  </para>
  <para style="p">
    <verse number="27" style="v" />An mang theiphet zawng in phiaphia kei un, himahleh an, tangtawn hinpha a om gige ding, Mihing Tapa honpiak ding zong in phezaw un; Pa Pathian in amah a chiamtehta hi,” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Amau a kiang ah, “Pathian nna ka sep theihna ding un bang ahia ka hih ding uh?” a chi uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n a kiang uah, “Pathian nasep hiai ahi, a misawl gingta le uchin” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amau a kiang ah, “Chiamtehna bang ahia na hih ding, ka muh ua nang k’on gintak theihna ding un? Thil bang ahia na hih ding?
  </para>
  <para style="p">
    <verse number="31" style="v" />Van a kipan a kiang uah amau tanghou nekding a pia chih gelh bang in, Ka pipute un gamdai ah manna a ne uhi” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu’n a kiang uah, “Chihtaktak in, chihtaktak in, k’on hilh ahi, Van a kipan a tanghou na muh pen uh Mosi honpiak ahi kei, ka Pa’n van a kipan tanghou tak nou a honpia hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Pathian tanghou van a kipan in a hong paisuk a, khovel kiang a hinna pepa ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amau “Toupa, huai tanghou honpe gige in” a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesu’n a kiang uah, “Keimah hinna tanghou ka hi; kuapeuh ka kiang a hongpai a gilkial kei ding, kuapeuh kei hon gingta chikmah chiang in a dangtak kei ding.
  </para>
  <para style="p">
    <verse number="36" style="v" />Himahleh nou n’on muh un leng n’on gingta kei uh chih k’on hilhta ve.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pa’n honpiak peuhmah ka kiang ah a hong paivek ding uh; kuapeuh ka kiang a hongpai ka delhkhe kei hial ding hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kei deihlam hih ding in van a kipan a hong paisuk ka hi kei a, hon sawlpa deihlam hih ding a hong paisuk ka hi zaw hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hiai pen hon sawlpa deihlam ahi, aman honpiak tengteng bangmah mangsak lou in, nitawpni chiang in kaithou zaw leng.
  </para>
  <para style="p">
    <verse number="40" style="v" />Hiai pen ka Pa deihlam ahi, kuapeuh Tapa mu a gingta in tangtawn hinna a neih a, nitawpni chiang in amah ka kaithou ding” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Van a kipan a tanghou hong paisuk ka hi a chih ziak in, Judate a tung ah a phun uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />“Hiai mi Joseph tapa Jesu ahi ka hia, a nu leh a pa leng i theih? Van a kipan a hong paisuk ka hi bangchi chih a chi ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Jesu’n a kiang uah, “Phunphun dah un.
  </para>
  <para style="p">
    <verse number="44" style="v" />Pa honsawlpan a hip kei leh kuamah ka kiang ah a hongpai theikei. Ken a hongpai mi nitawpni chiah ka kaithou ding.
  </para>
  <para style="p">
    <verse number="45" style="v" />Zawlneite laibu ah Pathian hilh in a omvek ding uh, chih gelh ahi. Michih Pa thu za a thei peuhmah ka kiang ah a hongpai uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Pathian a kipan pen loungal in kuamah in Pa a mu ngeikei, aman zaw Pa a mu hi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Chihtaktak in, chihtaktak in k’on hilh ahi, kuapeuh a gingta in tangtawn hinna a nei hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Keimah hinna tanghou ka hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Na pipute un gamdai ah manna a ne ua a si uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Hiai tanghou i chih pen van a kipan a hong paisuk ahi, min a nek ua a sihlouhna ding un.
  </para>
  <para style="p">
    <verse number="51" style="v" />Keimah van a kipan a tanghou hing hong paisuk ka hi, kuapeuh in hiai tanghou a nek leh tangtawn in a hing gige ding; ahi, khovel hinna dia ka piak ding tanghou ka sa ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huchi in Judate a kisel ua, “Hiai min bangchi’n a sa nek ding in honpe thei ding ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Jesu’n a kiang uah, “Chihtaktak in, chihtaktak in, k’on hilh ahi, Mihing Tapa sa na nek ua, a sisan na dawnkei uleh noumau in hinna neilou hive uchin.
  </para>
  <para style="p">
    <verse number="54" style="v" />Kuapeuh ka sa ne a, ka sisan dawn in tangtawn hinna a nei; huan, nitawp ni chiang in amah ka kai thou ding hi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ka sa zaw an taktak ahi a, ka sisan leng dawntak taktak ahi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Kuapeuh ka sa ne a, ka sisan dawn mi keimah ah a om gige a, keileng amah ah ka om gige hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Pa hing in honsawl a, Pa ziak a hing ka hih mah bang in, kuapeuh kei hon nete keimah ziak in amah leng a hing ding hi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Hiai van a kipan a tanghou hong paisuk ahi; na pipute un tanghou a ne ua, a sih bang uh zaw ahi kei; kuapeuh hiai tanghou ne tangtawn in a hing gige ding” a chi hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Huai thute Kapernaum khua a kikhopnain a thuhilh lai a a gen ahi.
  </para>
  <para style="p">
    <verse number="60" style="v" />Huchi in a nungzuite a khen tampi in huai a zak un, “Hiai thuhaksa ahi, kuan a ngaikhe thei dia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="61" style="v" />Huchi in huai thu ah a nungzuite a phun uh chih Jesu’n a lungsim in a thei a, a kiang uah, “Hiai thu in honhih lunghilou hia?
  </para>
  <para style="p">
    <verse number="62" style="v" />Mihing Tapa tuma lam a a omna ngei a kahtou mu le uchin, bang na chi ding ua?
  </para>
  <para style="p">
    <verse number="63" style="v" />Hinna pia zaw kha ahi a, sa zaw bangmah din a phatuam kei; na kiang ua thu ka gente kha ahi a, hinna leng ahi.
  </para>
  <para style="p">
    <verse number="64" style="v" />Himahleh na lak uah a khen gingtalou om na hi uh” a chi hi. Jesu’n a gingtaloute leh a mansak dingpa a tung a kipan in a theigige ngal a.
  </para>
  <para style="p">
    <verse number="65" style="v" />Huan aman, huaiziak in ahi na kiang ua, “Pa in a piak kei leh kuamah ka kiang ah a hongpai theikei” ka chih, a chi hi.
  </para>
  <para style="p">
    <verse number="66" style="v" />Hiai nung in a nungzuite a khen tampi a paikik ua, amah a kithuahpih nawnta kei uhi.
  </para>
  <para style="p">
    <verse number="67" style="v" />Jesu’n sawmlehnihte kiang ah, “Nou leng paimang sam na ut uhia?” a chi hi.
  </para>
  <para style="p">
    <verse number="68" style="v" />Simon Peter in, “Toupa, kua kiang ah ahia ka pai ding uh? Nangman tangtawn hinna thute na nei hi, chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="69" style="v" />Nangmah Pathian Mi Siangthou na hi chih ka taksangta ua, theih leng ka thei uhi” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="70" style="v" />Huan Jesu’n a kiang uah, “Nou sawmlehnihte keimah hon tel hilou na hi umaw? Na lak ua mi khat Diabol a hih laitei toh” a chi hi.
  </para>
  <para style="p">
    <verse number="71" style="v" />Iskariot Simon tapa Judas, sawmlehnihte lak a telsam, huai thu a gen ahi, amah zuausan a mansakpa ding ahi.
  </para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huaikhit in Galili gam ah Jesu a vak a; Judate’n amah hihlup a tup ziak un Judia gam a pha nuam kei hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Judate Biakbukte Ankuangluina a naita hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in a unaute’n a kiang ah, “Hiai a kipan in Judia gam ah vahoh in, na nungzuite’n na thilhih a muh theihna ding un” a chi uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Kuamah in a guk in thil bangmah ahihkei ua, Amahmah in a langtang in mite theih din a hih hi. Hiai thilte na hih ngal leh khovel kiang ah kimusak in” a chi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />A unaute nangawn in leng amah a gingta kei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan Jesu’n a kiang uah, “Ka hun a tung naikei; nou hun zaw chikpeuh in a tung gige hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Khovel in nou hon haw theikei hi, kei zaw hon hawnak uhi, a thilhihte uh a gilou chih ka theihsak ziak in.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nou Ankuangluina ah va hohtou unla, kei zaw tu Ankuangluina ah ka hohtou tadih kei ding, ka hun a tun nailouh ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huai thu a kiang uah gen in Galili gam ah a om nilouh hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh a unaute Ankuangluina a a hohtouh nung un, amah leng vantang theihlouh in, a guk bang in a hohtou sam hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Judate’n Ankuangluina ah amah a zawng ua, “Koi a om ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="12" style="v" />A tung ah mipite lak a mi a phunsim supsup ua, “Khenkhat in, mi hoih ahi, a chi ua; khenkhat in, hi dekkei e, mipi a pimang ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh Judate a kihtak ziak un kuamah in a langtang in a tungtang thu a genlang ngamkei uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Ankuanglui sanlaitakin, Pathian biakin ah Jesu a hohtou a, thu a hilh hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan Judate’n, “Hiai mi’n zil ngeiloupi a bang a chia thei ahia?” a chi ua, lamdang a sa mahmah uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Jesu’n amau a dawng a, “Ka thuhilh kei a hilou in, hon sawlpa thu ahizaw hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kuapeuh amah deihlam hih ut in ka thuhilh Pathian a kipan hia, keimah phuahtawm a ka gen chih a thei ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuapeuh amah phuahtawm thugen zaw, amah hoihna zawng ahi; a sawlpa hoihna zawngmi mitak ahi, amah ah diklouhna himhim a omkei hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Mosi in dan na kiang uah honpe ka hia? Himahleh na lak uah kuamah in Dan na zuikei uhi. Nou bang a chia hon hihlup tum?” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Mipi’n, “Dawizawl neive; kuan ahia hon hihlup tum?” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu’n a dawng a a kiang uah, “Thil khat ka hih nou tengteng in lamdang na sa uh.
  </para>
  <para style="p">
    <verse number="22" style="v" />Ahi a, Mosi in zeksum thu nou a honpiak ziak in khawlni’n leng mi zek na sum zel uhi. Huai pen Mosi a kipan hilou in pipute a kipan ahizaw hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Mosi dan a tatlek louhna ding a khawlni a pasal in a zek a sum ngal a leh, ken khawlni a mi ka hihdam ziak in ka tung ah na heh tuam umaw?
  </para>
  <para style="p">
    <verse number="24" style="v" />A kilat dan in ngaihtuah kei unla, diktattakin ngaihtuah zaw un” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan Jerusalem khua a mi khenkhat in, “Hiai mi thah a tuppa uh hilou hia?
  </para>
  <para style="p">
    <verse number="26" style="v" />En dih uh, a langtang in hiai ah thu a gen a, a kiang ah bangmah a genkei uhi. Amah Khrist ahi chih vaihawmte’n a thei taktakta ua eita maw?
  </para>
  <para style="p">
    <verse number="27" style="v" />Hiai mi a hong kipatna lam nangawn i thei ngal a. Khrist zaw a hongtun chiang in a hong kipatna lam kuamah in a theikei ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huaiziak in Pathian biakin a Jesu’n thu a hilhkawm in a kikou a, “Nou n’on thei ua, ka hong kipatna lam leng na thei uh. Himahleh keimah thu a hongpai ka hi kei, amah kei hon sawlpa midik ahi, amah lah na thei ngalkei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Ken amah ka thei hi; amah a kipan a hongpawt ka hi a, aman lah a honsawl ngal a” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huchi in amah mat a tumta ua, himahleh a hun a tun nailouh ziak in kuamah in a khoih theikei uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Mipi a khen tampite’n bel amah a gingta ua, “Khrist a hongtun chiang in, hiai mi hih sang a tam zaw thillamdang a hih dia hia? a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Pharisaite’n a tung a mipi phunna thute a za ua; huchi in siampu liante leh Pharisaite’n amah man ding in heutute a sawlta uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Jesu’n, “Sawtloukal na kiang uah ka omphot dia, hon sawlpa kiang ah ka pai ding hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Nou n’on zong ding ua, n’on mu kei ding uh; ka omna ah leng na hong theikei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Judate a kihou ua, “I muhlouh ding in hiai mi koi a hohdek ading? Grik pemdalhte kiang a hoh in Grikte thu vahilh ding a diam aw?
  </para>
  <para style="p">
    <verse number="36" style="v" />Nou n’on zong ding ua, n’on mu kei ding uh, ka omna ah leng na hong theikei ding uh a chih, bang a chihna a diam maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan ankuangluini nanungpen, ni thupi ni’n, Jesu ading a, a kikou a, “Kuapeuh a dangtak leh ka kiang ah hong henla, dawn hen.
  </para>
  <para style="p">
    <verse number="38" style="v" />Kuapeuh kei hon gingta Laisiangthou gen bang in tuihing luite asung apan a hong luangkhe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hiai thu a gingtate’n Kha a tan ding thu uh a genna ahi; Kha lah piak ahi nai tadih kei ua, Jesu lah pahtawi a a om nailouh ziak in.
  </para>
  <para style="p">
    <verse number="40" style="v" />Huchi in mipi lak a khenkhat in huai thu a zak un, “Hiai zaw zawlnei hi petmah e” a chi uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Khenkhat in, hiai zaw “Khrist ahi” a chi ua, khenkhat in bel, “Bangdi’n Galili gam ah Khrist a hongpawt tel dia?
  </para>
  <para style="p">
    <verse number="42" style="v" />Khrist zaw David suante lak ah, David omna khua Bethlehem ah a pawt ding ahi chih Laisiangthou in a gen ka hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huchi in amah ziak in mipi a kikhen ua, a kilangta uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Khenkhat in mat a ut ua, himahleh kuamah in a khoih tuankei uhi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huan heutute, siampu liante leh Pharisaite kiang ah a hongpai nawn ua a kiang uah, “Bang a chia hon pilou? a chi uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Heutute’n, “Hiai mi bang in kuamah in thu a gen ngeikei” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Pharisaite’n a kiang uah, “Nou leng pimang a omsamta umaw?
  </para>
  <para style="p">
    <verse number="48" style="v" />Vaihawmte leh Pharisaite lak a mi amah gingta a omta ahia?
  </para>
  <para style="p">
    <verse number="49" style="v" />Huai dan theilou mipite soplai, hamsethuak eive ua” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Nikodem, tuma a Jesu kiang a hong, a lak ua pangsam ahi a, aman a kiang uah,
  </para>
  <para style="p">
    <verse number="51" style="v" />“Amah kam ngei a thu zak leh a thilhih theih ma in i dan un mi siamlouh a tangsak ngei ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Amau a kiang ah, “Nang leng huai Galili mi na hi sam maw? Zong lechin, Galili gam ah zawlnei kuamah pawt ding a omkei uh chih thei tanla” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huan michih amau in chiat ah a paita uhi.
  </para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />Olive tang ah Jesu a hohtou hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Zingsang phalvak in Pathian biakin ah a lutnawn a, mi tengteng a kiang ah a hongpai ua, amah a tu a, amau thu a hilh hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Laigelhmite leh Pharisaite’n numei khat a angkawm lai a mat uh a honpi ua; a lai ah a dingsak uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu kiang ah, “Sinsakpa, hiai numei angkawm, a angkawm laitak a a mat uh ahi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Mosi Dan laibu in hichibang mi suang a denlup thu a honpia hi; nang bangchi na sa a?” a chi uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huai thu amah ze-etna dia a chih uh ahi, hekna ding a muh theihna ding un. Huchi in Jesu a kun a, a thugen uh zalou bang in a khutzung in lei a gelh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan a dot lailai ziak un amah a daktou a a kiang uah, “Na lak ua khelhna neilou in amah suang in deng masa heh” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />A kun nawn a, a khutzung in lei ah a gelh nawn hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau a thugen a zak un, upapen apan in a tawppha in, khatkhat in a gelkhia ua; huchi in numei a lai a a omna ngei a om toh Jesu kia a om uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu a daktou a, “Numei, koi a om ahi ua? Kuamah in siamlouh hon tangsaklou uhia?” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan aman “Toupa, kuamah in hon tangsakkei” a chi hi. Jesu’n, “Ken leng siamlouh k’on tangsak kei; pai inla, tuban hihkhial nawn ken” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Jesu’n a kiang uah thu a gennawn a, “Kei khovel vak ka hi; kuapeuh honzui mial ah a khosa kei hial ding, hinna vak a nei zaw ding” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huchi in Pharisaite’n a kiang ah, “Nangmah thu theisak na hi; na thu theihsak a dikkei” a chi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu’n a kiang uah, “Keimah thu theisak na hita leng zong ka thu theisak a dik ahi. Ken ka hong kipatna leh ka manohna ding leng ka thei hi; noute’n bel ka hong kipatna leh ka manohna ding na theikei uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nou sa dan in vai na hawmsak uh; ken kuamah vai ka hawmsak kei hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Ahi, vaihawmsak na hi taleng zong, ka vaihawmsak a dik ding; keimah kia ka hi kei a, kei leh Pa hon sawlpa ka hi zaw uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Ahi, na dan laibu uah leng mi nih thu a dik, chih gelh ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kei ka hihleh keimah thu theisakpa ka hi a, Pa hon sawlpan ka thu a theisak hi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau a kiang ah, “Na pa koi ah?” a chi uhi. Jesu’n, “Nou kei n’on theikei uh, ka Pa leng na theikei uh; kei honthei hile uchin, ka Pa leng na thei ding uh” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai thu Pathian biakin a thu a hilhkawm in, sumkoihna mun a a gen ahi; a hun a tun nailouh ziak in kuamah in amah a man sam kei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huan aman a kiang uah, “Ka paimang ding a, nou n’on zong ding ua, na khelhna uah na si ding uh; ka hohna ding ah na hong theikei ding uh” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Judate’n, “Ka hohna ding ah na hong theikei ding uh, a chih, a kihihlum dia a diam?” a chi uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Aman a kiang uah, “Nou nuailam a kipan na hi ua; kei tunglam a kipan ka hi; nou khovel a na hi ua, kei zaw hiai khovel a ka hi kei hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaiziak in na kiang uah, na khelhna uah na si ding uh, ka chih huai amah ka hi chih na gintak kei ua leh, na khelhna uah na si ngeingei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan amau a kiang ah, “Kua na hia?” a chi uhi. Jesu’n a kiang uah, “A tung a kipan in na kiang uah ka genta hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Nou tungtang thu ah thil tampi gen ding leh ngaihtuah ding ka nei; himahleh, hon sawlpa zaw mi dik ahi; amah kiang a ka thuzakte khovel kiang ah ka hilh hi” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pa thu a kiang uah a gen chih a theisiam kei uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huchi in Jesu mah in, “Nou mihing Tapa na khaikang nung un, amah ka hi chih leh, ken keimah thu in thil bangmah ka hihkei a, Pa in honhilh bangzel in hiai thu ka genzaw ahi chih na thei ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Hon sawlpa ka kiang ah a om a, Pa in kei kia in hon nusia ngeikei hi; a thil kipahlam peuhmah ka hihzel ziak in” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan huai thute a genlai in mi tampi’n amah a gingta uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huchi in Jesu’n a gingta Judate kiang ah, “Ka thu a na om gige uleh, ka nungzuite na hi taktak ding uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan thutak na thei ding ua, thutak in a hon suaktasak ding” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan amau a kiang ah, “Abraham suante keive ua, tutan in kuamah sal ah ka om ngeikei uh, suahtaksak in na om ding uh bangchi chih a chi na hia?” a chi ua, a dong uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan Jesu’n a kiang uah, “Chihtaktak in, chihtaktak in, k’on hilh ahi, kuapeuh thil hihkhial khelhna sal ahi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Sal chiklaipeuh in inn ah a om gige kei a; Tapa chiklaipeuh in a om gige hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Tapa in sal apat a hon suahtaksak leh, na suakta taktak ding uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Abraham suante na hi uh chih ka thei hi, himahleh honthah na tum ngal ua, ka thu in nou ah mun a neih louh ziak in.
  </para>
  <para style="p">
    <verse number="38" style="v" />Ken ka Pa kiang a thil ka muh ka gen a; nou leng na pa u kiang a thil na muh uh na hih uh” a chi hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan amau a kiang ah, “Kou pa Abraham ahi” a chi ua, a dawng uhi. Jesu’n a kiang uah, “Abraham tate hile uchin, Abraham thilhih na hihta ding uhi a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Himahleh Pathian kiang a thutak ka zak, nou hon hilhpa kei tun ah hon thah na tum ngal ua; Abraham in zaw hichibang in ahihkei. Nou zaw na pa uh thil na hihnak uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Amau a kiang ah, “Angkikawm a piang ka hi kei uh, Pa khat kia ka nei uh, Pathian” a chi uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Jesu’n a kiang uah, “Pathian na Pa uh hita leh nou kei n’on it ding uh; Pathian apan hongpawt leh a kiang a kipan hongpai ka hi; keimah thu a hongleng ka hi sam kei, aman a honsawl zaw ahi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Bangziak a ka thugen theisiamlou? Ka thu na zak theihlouh ziak uh ahi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Nou zaw na pa uh Diabol a pawt na hi ua, na pa uh utna na hih ding uh. Amah zaw a tung a kipan tualthat ahi, thutak ah a omkei, asung a thutak himhim a omlouh ziak in. Zuauthu a gen in amah a ngei a gen ahi; zuauthei ahi ngal a, zuaupa leng ahi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Thutak ka gen ziak in nou hon gingtalou na hi uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Na lak uah kuan ahia gilou lam a siamlouh hontan thei om? Thutak ka gen in leng nou bang a chia hon gingtalou?
  </para>
  <para style="p">
    <verse number="47" style="v" />Pathian apan pawt in, Pathian thu a pakta a; Pathian apan pawt na hihlouh ziak un na pakta kei uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Huan Judate’n a kiang ah, “Samari mi dawizawl na hi ka chih uh, ka chi dikngel kei umaw?” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Jesu’n, “Dawizawl ka hi kei. Ka Pa ka zahtak ahizaw, nou kei n’on zahtak kei uhi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Himahleh keimah kilawmna zawng ka hi kei; a zawngmi leh a ngaihtuahmi khat a om ahi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Chihtaktak in, chihtaktak in, k’on hilh ahi, min ka thu a zuih leh tangtawn in sihna a mu kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huan Judate’n a kiang ah, “Dawizawl na hi chih tuin ka theita uhi. Abraham a sita, zawlneite toh, nang min ka thu a zuih leh, tangtawn in sihna a chiam kei ding, na chi hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Ka pu uh Abraham sang in na thupizaw ahia? Amah leng a sita a, zawlneite leng a sita uh; kua a kibawl na hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Jesu’n “Keimah kipahtawi leng ka kipahtawina bangmah ahi kei; na Pathian uh, na chih uh ka Pa, hon pahtawipa ahi; nou amah na theikei uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Ken zaw amah ka thei; Amah ka theikei chi leng noumau bang a zuau thei ka hi ding: huchi in amah ka thei a, a thu leng ka zuizel hi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Na pu uh Abraham, ka ni mu ding a hih ziak in a kipak a, huan a mu petmah a, a kipak hi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Huan Judate’n a kiang ah, “Nang kum sawmnga leng hi nailou pi in, Abraham na mu ahia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="58" style="v" />Jesu’n a kiang uah, “Chihtaktak in, Chihtaktak in, k’on hilh ahi, Abraham om ma in leng ka om” a chi hi.
  </para>
  <para style="p">
    <verse number="59" style="v" />Huchi in a denna ding un suangte a tawm ua; himahleh Jesu a kibu a, Pathian biakin a kipan a pawtta hi.
  </para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Jesu’n a paikawm in piantung a kipan mittaw khat a mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />A nungzuite’n a kiang ah, “Rabbi, mittaw sa a a pian kuan ahia thil hihkhial, hiai mi hia, a nu leh a pa?” chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Jesu’n, “Hiai mi’n a hihkhial kei, a nu leh pa’n leng a hihkhial kei uh; Pathian nasepte a tung a a latna ding ahizaw” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Sun a hihlai in hon sawlpa nna i sep ngeingei ding uh ahi; zan hi dekdekta ahi, huai hun chiang in kuamah in nna a sem theikei ding uh.
  </para>
  <para style="p">
    <verse number="5" style="v" />Khovel a ka om sung in khovel vak ka hi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchibanga a genkhit in, lei ah chil a sia a, tungman a bawl a, huan tungman a mit ah a nuh hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />A kiang ah, “Siloam dil ah vasil in” a chi a. “Siloam tuh sawl” chihna ahi. Vapai in a sil a, mitvak in a hong kiknawn hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in a vengte leh tuma a khutdoh a mute’n, “Hiai mi tukawm a khutdohpa ahi ka hia?” a chi uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Midang in “Amah ahi vaw oi, a chi ua, midang in, hi kei a kibatpih ahizaw, a chi uhi. Aman bel huai mi mah ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan amau a kiang ah, “Na mit bangchi’n ahia a hongvak?” a chi uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Aman, “Mi khat, Jesu a chih un tungman a bawl a, ka mit a nuh a, ‘Siloam dil ah vahoh inla va sil in’ a honchi a, huchi in, ka vahoh a, ka sil a, mitvakna ka muta” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan amau a kiang ah, “Amah kaw om ahia?” a chi uhi. Aman, “Ka theikei” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Amaute’n huai mittawpa Pharisaite kiang ah a honpi uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Jesu’n tungman bawl a, a mit ahihvak ni khawlni ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huchi in Pharisaite’n a mit a hongvak takdan a dong nawn uhi. Aman a kiang uah, “Ka mit ah tungman a koih a, ka sil a, ka mu theita hi” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Pharisai khenkhat in, “Huai mi’n khawlni a tanlouh ziak in, Pathian a kipan ahi kei” a chi uhi. Khenkhat in bel, “Mikhial in bangchi’n hichibang thillamdang a hih thei dia?” a chi uhi. Huchi in a kikhen ua, a kilangta uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Mittawpa kiang ah, “Na mit ahihvak nang bangchi bang in amah na ngaihtuah?” a chi nawn ua. Aman, “Zawlnei ahi: a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Himahleh Judate’n a mit hongvakta nu leh pa a sap masiah uh, mittaw a na hi hima a mit a hongvakta chih a tungtang thu a taksang kei uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />A nu leh a pa kiang ah, “Hiai mi na tapa uh mittaw sa a piang ahi na chih uh ahi hia? Bangchi’n ahia tua a muhtheih tak?: chi in a dong uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A nu leh apan, “Hiai ka tapa uh ahi chih ka thei uh, mittaw sa in a piang chih leng ka thei uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh bangchi’n ahia tua hon muhtheih chih ka theikei uh, a mit hihvakpa leng ka thei sam kei uh; amah dong un; piching ahi a; amah thu kigen thei ahita ” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Judate a kihtak ziak un a nu leh apan huai thute a gen uhi; Judate’n, huai ma him in leng, Amah Khrist ahi chi a gum a om leh kikhopnain apan nawhsuah ding chih a lemsa chiat ngal uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huaiziak in a nu leh pa’n “Piching ahi, amah dong un” a chi uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huchi in mittawpa a samnawn ua a kiang ah, “Pathian phat in hiai mi zaw mikhial ahi chih ka thei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Aman bel, “Mikhial ahi hia hilou ka theikei, thil khat ka thei, tuma in ka mit a taw a, tuin ka mu theita hi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Amau a kiang ah, “Na tung ah bangchi’n ahia a hih? Na mit bangchi’n ahia ahihvak?” a chi uhi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman a kiang uah, “Den in k’on hilhta vele, na theinuam ngalkei ua; bang a chia theinuam nawn na hi ua? Nou leng a nungzui hihsam ut u maw?” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan amau amah a tai ua, “Nang amah nungzui na hi, kou zaw Mosi nungzuite ka hi uh chi in.
  </para>
  <para style="p">
    <verse number="29" style="v" />Pathian in Mosi a houpih chih ka thei uh, hiai mi phiangsan koi a hong kipan ahia ka theihsak kei uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huai min a kiang uah, “Huai pen tak ahi a lamdanna, koi a hong kipan ahia na theihlouh uh, ka mit lah ahihvak ngei ngal a a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Pathian in mikhial thu a ngaikhe kei chih i thei uhi. Himahleh kuapeuh in Pathian a limsak a, a deihlam ahihleh, Pathian in amah a ngaikhia hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Khovel omtung a kipan kuamah mittaw sa a piang mit ahihvak nawn chih a kithei ngeikei hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiai mi Pathian a kipan a pawt ahihkei leh bangmah a hih theikei ding” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Amau a kiang ah, “Nang khial lumlet a piang in hiai bang n’on hilh vial maw?” chi in a dawng uhi. Huchi in amah a nawhkhia uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan a nawhkhia uh chih Jesu’n a za a; amah a muh in, “Pathian Tapa na gingta hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Aman “Pu, amah kua ahia ka gintak theihna din?” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Jesu’n, “Amah na mukhinta a, tua nang hon houpihpa ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Aman “Toupa, ka gingta hi” chi in amah a bia hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesu’n, “Thukhen ding in hiai khovel ah hong ka hi, mittawte mit a hongvakna ding leh, mitvakte mit a hongtawtna ding in” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />A kiang a Pharisai omte’n huai thu a zak un, a kiang ah, “Kou leng mittaw ka hi sam u maw?” a chi uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Jesu’n a kiang uah, “Mittaw hile uchin khelhna neilou ding hi u chin a, himahleh ka muthei uh na chih ziak un khelhna ah na om gige uhi” a chi hi.
  </para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Chihtaktak in, chihtaktak in, k’on hilh ahi, kuapeuh belam huang a kongkhak a lutlou a, lampi dang a kahlut mi guta leh suamhat ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kuapeuh kongkhak a lut belamchingpa ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Kongkhak ngakpa’n amah a na honsak a; belamte’n a aw a za uh; aman belamte a min un a sam chiat a, a pikhe zel hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Amah a tengteng a pawtsaktakin, a ma uh a kai a, belamte’n amah a zuizel uh, a aw a thei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Midang zaw a zuikei ding uh, a taimangsan zaw ding uh; midangte aw a theihlouh ziak un” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai gentehna Jesu’n a kiang uah a gen hi; himahleh bang thu ahia a kiang ua a gen chih a theikei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in Jesu’n a kiang uah a gen nawn a, “Chihtaktak in, chihtaktak in, k’on hilh ahi, Kei belam kongkhak ka hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Ka ma a hongpai tengteng gutate leh suamhatte ahivek uh; himahleh belamte’n a thu uh a ngaihsak kei uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Kei kongkhak ka hi; keimah a mi a lutleh, humbit in a om ding a, a lut in a pawt ding a, nekding leng a mu ding hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Guta zaw, gu ding leh that ding leh hihse ding lou in a hongpai kei; kei zaw hinna a neihna ding ua, tampitak a neihna ding ua, hongpai ka hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Kei belamchingpa hoih ka hi; belamchingpa hoih in a belamte adin a hinna a pia hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Kiloh, belamchingpa tak hilou, belamte amah a hilou in, ngia hongpai a muh in belamte a taisan a; huan ngia in amau a kei a, huchi in belamte a hihdalh hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Kiloh ahi a, belamte ading a deihsakna himhim a neih louh ziak in a taimang hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kei zaw belamchingpa hoih ka hi;
  </para>
  <para style="p">
    <verse number="15" style="v" />Pa in a hon theih leh ken Pa ka theih bang in kei a ka thei hi, kei a in leng a hon thei hi; huan belamte din ka hinna ka pia hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Hiai belam huang a lou belam dangte ka nei hi; amau leng ka honpi ding a, ka aw a za ding ua, honkhat in chingpa khat toh a omkhawm ding uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiaiziakin Pa’n kei hon it ahi; laknawn ding a ka hinna ka piak ding ziak in.
  </para>
  <para style="p">
    <verse number="18" style="v" />Kuamah in hon laksak kei ding, keimah thuthu in ka pe zaw ding hi. Pe thei ka hi a lanawn thei leng ka hi. Hiai thupiak ka Pa apat ka muh ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Hiai thu ziak in Judate a kikhen ua, a kilang nawnta uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />A khen tampi in “Dawizawl a hai eive; bangdia a thu ngaikhia na hi uh?” a chi uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />A khen in hiai dawizawl thute hi kei e. Dawi in mittaw mit ahihvak thei ahia? a chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan Jerusalem khua a Tempul latna Ankuanglui lai ahi a; huai hun phalbi lai ahi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Pathian biakin, Solomon inlim ah Jesu a kivialleh leh hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Judate’n hongum pelpul ua, a kiang ah, “Bang tan ahia vanglak a n’on bawl ding? Khrist na hihleh chiantak in honhilh in” a chi uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n a kiang uah, “K’on hilhta hi, na gingta tuankei uh; ka Pa min a thil ka hih hiaite’n ka tanchin a theisak uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Himahleh na gingta kei uhi, ka belam lak a mi na hihlouh ziak un.
  </para>
  <para style="p">
    <verse number="27" style="v" />Ka belamte’n ka aw a za uh, ken leng amau ka thei a, amau a honzui uhi.
  </para>
  <para style="p">
    <verse number="28" style="v" />A kiang uah tangtawn hinna ka pia; tangtawn in a mangthang kei ding ua, kuamah in ka khut a kipan honsut sam kei ding hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amau hon pepa ka Pa, mi tengteng sang a thupizaw ahi; kuamah in Pa khut a kipan a sut theikei ding hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Kei leh Pa lah pumkhat ka hi uh” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan Judate’n a denna ding in suang a tawm nawn uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Jesu’n amau a houpih a, “Pa a kipan nasep hoih tampi k’on ensak a, huai nasepte lak ah bang nasep ziak in ahia suang a na honden dek uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Judate’n a kiang ah, “nasep hoih ziak in suang in k’on dengdek kei uh; Pathian na gensiat ziak leh nang mihing hi ngal a, Pathian a na kibawl ziak ahizaw” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n a kiang uah, “Na dan uah, ‘noute pathiante na hi uh k’on chi’ chih gelh ahi ka hia?
  </para>
  <para style="p">
    <verse number="35" style="v" />Pathian thu tunnate bawn pathiante a chih leh, Laisiangthou bohsiat theih ahi kei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Pathian Tapa ka hi, ka chih ziak in Pa’n a seh a, khovel a a sawlpa Pathian na gensia honchi na hi umaw?
  </para>
  <para style="p">
    <verse number="37" style="v" />Ka Pa nasem ka hihkeileh hon gingta kei un.
  </para>
  <para style="p">
    <verse number="38" style="v" />Himahleh sem ka hihleh kei hon gingta kei mahle uchin ka nasepte bek gingta un; huchi a Pa keimah ah a om chih leh kei Pa ah ka om chih na theihna ua, na theihsiamna ding un” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huaitak in mat a tum nawn ua, himahleh a khut ua kipan a suakta hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jordan luigal ah Johan in a tung a mi a baptisna lam ah a paimang nawn a, huai ah a om nilouh hi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan mi tampi a kiang ah a hongpai ua, “Johan in thillamdang bangmah ahihkei a; himahleh Johan in hiai mi tungtang thu a gen peuhmah a na dik mahmah hi” a chi uhi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Huan huai ah mi tampi in amah a gingta uhi.
  </para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan mi khat, Mari leh a sanggam Martha omna khua Bethani mi, Lazar, damlou in om hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Mari, thaunamtui Toupa nilh a a sam a a khe nulnu sanggampa Lazar damlou in a om hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A sanggamnute’n Jesu kiang ah, “Ngai dih Toupa, na it a china hi” chi in, mi a sawl uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n huai a zak in, “Hiai natna sihna ding zen ahi kei, Pathian thupina ding ahizaw hi. Pathian Tapa hiai ziak a hihthupi a hih theihna ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Martha, a sanggamnu, Mari leh Lazar te Jesu’n a it hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huaiziak in a china chih a zak in, a omna ngei ah ni nih a tamlai hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huaikhit in a nungzuite kiang ah, “Judia gam ah i hohnawn ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan nungzuite’n a kiang ah, “Rabbi, tuma zek in Judate’n suang a honden a tum ua; huchipi in huai ah na hohnawn dia hia?” a chi ua.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu’n, “Sun in dakkal sawmlehnih a om ka hia? Mi sun a a vak leh a kisui ngeikei a, hiai khovel vak a muh ziak in.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh mi zan a a vak leh a kisui hi; amah a vak a omlouh ziak in” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huai thute a genkhit in a kiang uah, “I lawmpa Lazar a ihmuta; a ihmu phawnghalh ding in ka hawh ding ahi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in a nungzuite’n a kiang ah, “Toupa, a ihmut takleh a khanglou nawn na ke” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Jesu’n a sih thu gen ahi a; himahleh amau ihmu a khawl thugen hiam a sa uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huchi in Jesu’n chiantak in a kiang uah “Lazar si ahi a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huai a ka omlouh nou ziak in ka kipak hi, na gintak theihna ding un; himahleh a kiang ah i hawh ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Thomas, Didum a chih un, a nungzuihpihte kiang ah, “A sihna a i sihsamna ding in i hawh ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huchi in Jesu a tun in ni li han ah a omta chih a thei hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Bethani khua Jerusalem kiang a om ahi a, ching sawmlehnga phial a gamla ahi;
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in a sanggampa uh sihna tung a khamuan ding in Judate tampi Martha leh Mari kiang ah a hoh uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu a hong dek chih Martha in a zakphet in a vadawn a; Mari bel inn sung ah a tu lailai hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Martha in Jesu kiang ah, “Toupa, hiai a om hile chin, ka sanggampa si lou ding hi a.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tun ah leng Pathian kiang a na nget peuhmah Pathian in nang honpe ding chih ka thei” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a kiang ah, “Na sanggampa a thounawn ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Martha in a kiang ah, “Nitawpni chiah, thohnawnna ah, a thounawn ding chih ka thei” a chi hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu’n a kiang ah, “Kei thohnawnna leh hinna ka hi; kuapeuh hon gingta si mahleh a hing gige ding;
  </para>
  <para style="p">
    <verse number="26" style="v" />A hing peuhmah a, a hon gingta peuhmah tangtawn in a sikei ding; huai thu na gingta hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Aman a kiang ah, Gingta e, Toupa, Khrist, Pathian Tapa, khovel a hongpai dingpa na hi chih ka gingta hi” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huan huai thu a genkhit in a kuan a, a sanggamnu Mari a sim sap a, “Sinsakpa hiai ah a om a, nang a hon samsak” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Aman huai a zaktak in, a dingkhe paha, a kiang ah a vahoh hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu khua ah a lut naikei a, Martha in a vadawn lai a a omna ngei ah a omlai hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan insung a amah khamuana ompih Judate’n Mari dingkhe paha pawt a muhtak un, han ah kap ding a hohdek hi’n teh chi in, a zui uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan Mari Jesu omna a vatunga amah a muhtak in a khebul ah a khupboh in, a kiang ah, “Toupa, hiai a om hile chin ka sanggampa silou ding hi a” a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huan Jesu’n Mari kap leh a honzui Judate kap a mu a, a lung a khoih mahmah a, kha in amau hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan aman “Amah kaw sial na hi ua?” a chi hi. Amau a kiang ah, “Toupa hongpai inla, en in” a chi uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Jesu a kapta.
  </para>
  <para style="p">
    <verse number="36" style="v" />Judate’n, “En dih uh, Lazar it na tel e” a chi uhi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Himahleh khenkhat in, “Hiai mi, mittaw mit hihvakpa’n, hiai mi leng a silou sakthei kei a eita?” a chi uhi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan Jesu nakpi’n a mau nawn a, han a tung hi. Huai han kawkhuk, suang a sit ahi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Jesu’n, “Suang hemkhia un” a chi hi. A sipa sanggamnu Martha in a kiang ah, “Toupa, tun zaw a namta ding, a sihna ni li ahita” a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jesu’n a kiang ah, na gintak leh Pathian thupina na mu ding, k’on chi ka hia? a chi hi. Huchi in, suang a hemkhia uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huchi in Jesu a vandak a, “Pa ka thu na ngaihkhiak ziak in na tung ah ka kipak hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Ka thu na ngaikhe zel chih ka thei a; himahleh, mipi dingte ziak in hiai ka chi ahi, nang n’on sawl chih a gintak theihna ding un” a chi hi.
  </para>
  <para style="p">
    <verse number="43" style="v" />Huan huchi a a paukhit in aw ngaihtak in, “Lazar, hongpawt in” chi in a kikou hi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan, misi a khut a khe, han puan a tuamsa in a hong pawtta a, a mai leng kinulna puan a tuam ahi. Jesu’n a kiang uah, “Phel unla, paisak un” a chi hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Huchi in Mari kiang a hongpai Jesu thilhih mu, Judate a khen tampi in Jesu a gingta uhi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Himahleh, a khen Pharisaite kiang ah a vahoh ua, a kiang uah Jesu thilhihte a vahilh uhi.
  </para>
  <para style="p">
    <verse number="47" style="v" />Huchi in siampu liante leh Pharisaite’n vaihawmte a samkhawm ua, “Bangchi’n i hih ding ua? Hiai min thillamdang tampi a hih ngal a, a chi uhi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Hichibang a i khahzan unzaw mi tengteng in amah a gingta ding ua; Rome mite a hongpai ding ua, i mun leh i namte a hon laksak ding uh” a chi uhi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Huan a lak ua mi khat Kaiapha, huai kum a siampu lianpen in a kiang uah, “Nou bangmah theikei uteh,
  </para>
  <para style="p">
    <verse number="50" style="v" />I nam pumpi manthat louhna ding in mi tengteng sik a mi khat sih, nou adin a hoih chih leng na ngaihtuah kei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="51" style="v" />Huai thu amah phuahtawm in a genkei, huai kum in siampu lianpen ahi a, a namte sik a Jesu a sih ding a genkhol ahizaw hi.
  </para>
  <para style="p">
    <verse number="52" style="v" />Huai namte sik kia ahi kei a, Pathian ta khovel a dalhte tengteng a pikhawmna ding in leng ahi sam hi.
  </para>
  <para style="p">
    <verse number="53" style="v" />Huchi in huai ni a kipan amah that ding in a kihou zel uhi.
  </para>
  <para style="p">
    <verse number="54" style="v" />Huaiziak in Jesu Judate lak ah a langtang in a vaknawnta kei a, huai a kipan gamdai zullam a khaw khat Ephraim a chih uah a vahohta hi; huai ah nungzuite toh a om nilouh ta uhi.
  </para>
  <para style="p">
    <verse number="55" style="v" />Huan Judate Paikan Ankuangluina a naita a, mi tampi kisiangsak ding in, gam apat, Paikan Ankuanglui ma in, Jerusalem khua ah a hohtou uhi.
  </para>
  <para style="p">
    <verse number="56" style="v" />Huchi in Jesu a zong ua Pathian biakin ah ding kawm in a kihou ua, Bang ahia na ngaihtuah uh? Ankuangluina ah a hong kei ding maw? a kichi uhi.
  </para>
  <para style="p">
    <verse number="57" style="v" />Siampu liante leh Pharisaite’n amah a mat theihna ding un kuapeuh in a omna a theih uleh amaute theihsak ding thu a peta uhi.
  </para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huan Paikan Ankuangluina ding ni guk a omlai a, Jesu’n misi lak a kipan a a kaihthoh Lazar omna khua Bethani a hongtung hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huai ah amah adin nitakan a bawl ua, Martha in nek a bawl hi, Lazar bel a Ankuang umpih khat ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Mari in spiknardi buk kimkhat thaunamtui manphatak a hontawi a, Jesu khete a nuh a, a sam in a nul a, huai thaugim in insung a dimta hi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Himahleh Judas Iskariot, a nungzuite lak a khat, a mansak dingpa’n,
  </para>
  <para style="p">
    <verse number="5" style="v" />“Hiai thaunamtui bangdia makhai za thum a zuak a migentheite kiang a pe zawlou uh ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi gentheite a awlmoh ziak a hiai thugen ahi kei; guta ahi a, dangka ip a kem a, asung a koih a lak zel ziak ahizaw hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu’n, “Hih hen aw, ka kivui ni adia a sit ahi, sen hen aw.
  </para>
  <para style="p">
    <verse number="8" style="v" />Mi gentheite na kiang ua om gige ahi ua, kei bel na kiang ua om gige ding ka hi kei” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan huai mun ah Jesu a om chih Juda mipi’n a theih un; a hong ua, Jesu ziak kia hilou in, misi lak a kipan a kaihthoh, Lazar mah leng a muhnop ziak uh ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan siampu liante Lazar leng that ding in a kihou uhi;
  </para>
  <para style="p">
    <verse number="11" style="v" />Amah ziak a Judate tampi in lang kaisana, Jesu a gintak ziak un.
  </para>
  <para style="p">
    <verse number="12" style="v" />A zing in, Ankuangluina a hong mipi tampi’n Jesu Jerusalem khua ah a hongpai ding chih a zak un,
  </para>
  <para style="p">
    <verse number="13" style="v" />Tumnahte a tawi ua, dawn ding in a pawtkhia ua, Hosanna, Toupa min a Israelte Kumpipa hongpai a hampha e, chi in, a kikou uhi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan Jesu’n sabiltung nou a mu a, a tung ah a tuang hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Lau ken, Zion tanu; en in, na Kumpipa, sabiltung nou tung a tuang in, a hongpai ding, chih gelh a hih bang in.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huai thute a tung in a nungzuite’n a theisiam kei ua; himahleh, Jesu pahtawi a hih nung in, a tanchin ah huai thugelh ahi chih leh, a tung ah huai thilte a na hihngei uh chih a theita uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Lazar hana kipan a sapkhiakpa, misi lak a kipan a kaihthoh lai a a kiang a mipi omte’n, a thu a theihpih uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huaiziak in ahi, mipite’n leng amah a vadawn uh, huai thillamdang a hih chih a theih ziak un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huchi in, Pharisaite’n, thei un, bangmah na hih theihlouh uh, en un, khovel in amah a zuita hi, a kichi uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huan Ankuangluina a Pathian be ding a hohtoute lak ah Grik kuate hiam a om uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huaite Galili gam a Bethsaida khua a mi Philip kiang ah a hong ua, a kiang ah, “Pu, Jesu ka mu nuam uh” a chi ua, a thum uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Philip in Andru a honghilha; Andru leh Philip in Jesu a honghilh uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a dawng a, a kiang uah, “Mihing Tapa pahtawi a a omna ding hun a tungta hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Chihtaktak in, chihtaktak in, k’on hilh ahi, Buhtang lei a a kiaka, a sihphot keileh, amah kia in a om tawntung hi; a sih inbel, tampi in a gah hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Kuapeuh a hinna it in a mangsak ding a; kuapeuh hiai khovel a a hinna ngaineu in tangtawn hinna ah a kem ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Kuapeuh in ka nna a sepleh honzui hen; ka omna ah ka sikha leng a om ding hi; kuapeuh in ka nna a sep leh Pa’n amah a pahtawi ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Tun ah ka kha a mangbang hi; bang ka gen dia? Pa, hiai hun apan hon hondam in, ka chi dia hia? chilou e, hiai ding a hiai hun a hongpai ka hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Pa na min pahtawi in, a chi hi. Huchi in van a kipan in aw hongsuak a, ka pahtawita, ka pahtawi nawnlai ding a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Mipi a kiang a dingte’n huai a za ua, Vanpiging ahi, a chi ua; midangte’n, Angel in amah a houpih ahi, a chi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Jesu’n a dawng a, huai aw kei adia hongsuak ahi kei, noumau ading ahizaw, a chi hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Tu hiai khovel thukhensakna hun ahi; tu hiai khovel lal paihkhiak hun ahi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Huan lei a kipan a khaikang a ka om leh, mi tengteng keimah kiang ah ka hip ding, a chi hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huai thu a sih ding dan theihsakna dia a gen ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Huan mipi’n a kiang ah, Khrist tangtawn in a om chih danbu ah ka thei uh, nang Mihing Tapa khaikang a om ding ka hi bangchi chih a chi na hia? Huai Mihing Tapa kua ahia? a chi ua, a dong uhi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Huan Jesu’n a kiang uah, Vak na lak uah sawtlou a omtadih hi. Vak na neih lai un vak ah khosa un, huchilou in zaw mial in honlap ding hi. Kuapeuh mial a khosa in a paina a theikei hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Vak na neihlai un vak gingta un, vak tate na hong hih theihna ding un” a chi hi. Huai thute Jesu’n a gen a; huan a pai a, a muhlouh ding un a kiselta hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />A ma uah huchitel a tam thillamdang hihmahleh, amah a gingta tuankei uhi:
  </para>
  <para style="p">
    <verse number="38" style="v" />Toupa, ka thugen uh kuan ahia gingta? Toupa khut leng kua kiang ah ahia latsak a a om? chi a zawlnei Isai thugen a tun na ding in.
  </para>
  <para style="p">
    <verse number="39" style="v" />Hiai ziak in ahi a gintak theihlouh uh, Isai in,
  </para>
  <para style="p">
    <verse number="40" style="v" />Aman a mit uh a hihtaw a, a lung tang uh a hihkhauh a; huchilou in zaw a mit un a mu khading ua, a lungtang un a thei kha ding uh, huan hong kihei nawn ding ua, ken amau ka hihdam khading chih, a gen nawn ziak in.
  </para>
  <para style="p">
    <verse number="41" style="v" />Hiai thilte Isai in a thupina a muh a a tanchin a gen ahi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Himahleh, heutute lak nangawn ah tampi in Jesu a gingta uhi; himahleh Pharisaite ziak in a kipulak nuam kei uh, huchilou in zaw kikhopnain a kipan a hawlkhe kha ding uhi:
  </para>
  <para style="p">
    <verse number="43" style="v" />Pathian pahtakna sang in mihing pahtakna a deih zaw uhi.
  </para>
  <para style="p">
    <verse number="44" style="v" />Huan Jesu a kikou a, “Kuapeuh hon gingta kei gingta ahi kei a, hon sawlpa gingta ahizaw hi.
  </para>
  <para style="p">
    <verse number="45" style="v" />Kuapeuh kei honmu hon sawlpa mu ahi.
  </para>
  <para style="p">
    <verse number="46" style="v" />Vak khovel a hongpai pen ka hi, kuapeuh kei hon gingta mial a a omlouhna ding in.
  </para>
  <para style="p">
    <verse number="47" style="v" />Kuapeuh ka thugen za in, gingta kei mahleh, ken siamlouh ka tangsak kei: khovel siamlouh tangsak ding a hongpai ka hi kei a, khovel humbit ding a hongpai ka hi zaw hi.
  </para>
  <para style="p">
    <verse number="48" style="v" />Kuapeuh kei hon deihlou a, ka thugente pomlou in, siamlouh tangsak khat a nei hi, ka thugen huai thu mahmah in, nitawpni chiang in amah siamlouh a tang sak ding hi.
  </para>
  <para style="p">
    <verse number="49" style="v" />Keimah phuahtawm in thu ka genkei a; Pa hon sawlpan ka thugen ding leh ka hih ding thu a hon pezaw hi.
  </para>
  <para style="p">
    <verse number="50" style="v" />Amah thupiak tangtawn hinna ahi chih ka thei; huaiziak in ka thugen, Pa honhilh bangzel in ka gen ahi” a chi hi.
  </para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />Paikan Ankuanglui kipat ma in, Jesu’n hiai khovel nusia a Pa kiang a a pai hun hongtungta chih a thei a; khovel a a itte, a tawppha in a it hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan nitak annek lai in, Diabol in Simon tapa, Judas Iskariot, lungtang a Jesu zuausan a matsak lungsim a koihsak khitnung in,
  </para>
  <para style="p">
    <verse number="3" style="v" />Pa’n a khut ah thilbangkim a peta chih leh Pathian a kipan hongpai ahi a, Pathian kiang a pai ding ahi chih Jesu’n theigige in,
  </para>
  <para style="p">
    <verse number="4" style="v" />Nitakan umlai ading a, a puante a suahkhia a, kinulna puan a la a, a teng hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan kisilna kuang ah tui asung a, nungzuite khe a silta a, kinulna puan a ten in a nul zel hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huchi in Simon Peter kiang ah a honghi; “Aman Toupa, nang tel in ka khe na sil dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu’n a kiang ah, “Ka thilhih tun ah na theikei; himahleh tunung chiang in na thei ding” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Peter in a kiang ah, “Ka khe na silkei hial ding” a chi hi. Jesu’n a kiang ah, “Na khe ka sil kei leh ka kiang ah tan na neikei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Simon Peter in a kiang ah, “Toupa, ka khe kia hilou in, ka khutte leh ka lutang leng aw” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Jesu’n a kiang ah, “Kisil khinsa a khe loungal sil a kiphamoh kei, a pumpi in a siang; nou na siang uh, na vek un zaw ahi kei” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />A mansakpa dingpa a thei ngal a; huaiziak in, na vek un zaw na siangkei uh, a chi ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in a khete uh a silkhit a, a puante a lak a, a tutnawn in a kiang uah, “Na tung ua ka thilhih na thei uhia?” a chi hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />“Nou Toupa leh heutupa n’on chi ua; na chidik uhi, ka hihna mah ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kei Toupa leh na heutupa un na khe uh ka sil leh nou leng na khe uh na kisilsak ding uh ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Na tung ua ka hihbang in, nou leng na hihsam ding un, hih ding dan honhilh ka hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Chihtaktak in, chihtaktak in, k’on hilh ahi, sikha a toupa sang in a thupizaw kei a; sawl a om leng a sawlpa sang in a thupizaw sam kei hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai thilte na theih ua, na hih uleh mi nuamsa na hi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Na vek ua thu ka genkei a; ka telte ka thei; himahleh Ka tanghou nepa’n ka tung ah a khetul a likta chih, Laisiangthou a hongtun theihna ding ahi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Tuin a hong tunma in k’on hilh ahi, a hongtun hun chiang a kei amah ka hi chih na gintakna ding un.
  </para>
  <para style="p">
    <verse number="20" style="v" />Chihtaktak in, chihtaktak in, k’on hilh ahi, kuapeuh ka sawl kipahpih, kei hon kipahpih ahi; kuapeuh kei hon kipahpih, hon sawlpa kipahpih ahi,” a chi hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu’n huai thu a genkhit in, a lungsim a mangbang a, “Chihtaktak in, chihtaktak in, k’on hilh ahi, Na lak ua mi khat in kei hon mansak ding” chi in a theisakta hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan nungzuite’n a chihpen a theikei ua, a ki en tuah chiat uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />A nungzuite lak a khat, Jesu’n a itpa, dohkan sik ah Jesu angsung ah kingai in a om hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Simon Peter in huai mi kiang ah, kua pen thu ahia a gen dong ding in a khutvan hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Jesu awm ngai mah in a awnphei a, a kiang ah, “Toupa, kuapen ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Jesu’n, “Tanghou them ka diah a, ka piakpa ahi ding” chi in a dawng hi. Huchi in tanghou them a diah nung in, Iskariot, Simon tapa Judas kiang ah a pia hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Tanghou them a piak nung in Setan asung ah a lutta hi. Huchi in Jesu’n a kiang ah, “Na hih ding hihmeng in” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Dohkan a omte’n bang tuma hiai thu gen hiam chih a theikei uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />A khen in Judas in dangka ip a vom ziak in, Jesu’n Ankuangluina ading thil kiphamoh peuh lei in, chi hiam, mi gentheite kiang ah banghiam piak ding, chi hiam a sa uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan tanghou them la in, a pawtkhe paha; huai zanlai ahi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huaiziak in a pawtnungin, Jesu’n a gen a, “Tuin Mihing Tapa pahtawi in a omta a, Pathian leng amah ziak in pahtawi in a om hi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Amah a Pathian pahtawi a a om leh amah leng Pathian mahmah in a pahtawi ding, a pahtawi pah ding hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Naute aw, hun tomchik na kiang uah ka omlai tadih hi. Nou n’on zawng ding uh; Judate kiang a, ka paina ding ah nou na hongpai theikei ding uh chih ka gen bang in, tuin huchi mah bang in na kiang uah ka gen ahi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Thupiak thak konpia ahi, ki-ittuah un; ken nou k’on it bang in, nou leng ki-ittuah un.
  </para>
  <para style="p">
    <verse number="35" style="v" />Na ki-ittuah uleh mi tengteng in ka nungzuite na hi uh chih hiai ah a thei ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Simon Peter in a kiang ah, “Toupa, koi a hoh ding na hia? a chi hi. Jesu’n, ka hohna ding ah nang tuin n’on zui theikei ding; tunung chiah zaw n’on zui ding” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Peter in a kiang ah, “Toupa, bangding in ahia tua leng k’on zuih theihlouh ding? Nangmah ziak in ka hinna ka koihkhe ding” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Jesu’n “Keimah ziak in na hinna na koihkhe ding maw? Chihtaktak in, Chihtaktak in, k’on hilh ahi, nang thumvei n’on kitheihmohbawl ma in ak a khuangkei ding” chi in a dawng hi.
  </para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Na lungtang uh hihmangbat in omkei hen; Pathian na gingta ua, keileng hon gingta sam un.
  </para>
  <para style="p">
    <verse number="2" style="v" />Ka Pa inn ah tenna mun tampi a om; a omlou hileh, k’on hilhta ding hi; nou ading a mun khat bawl dia kuandek ka hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huan nou adia munbawl ding a ka kuan leh ka hong kiknawn ding a, ka kiang ah nou ka honla ding, ka omna a nou leng na om theihsamna ding un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Ka hohna ding a lampi na thei uh” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Thomas in a kiang ah, “Toupa, koi a hoh ding na hia ka theikei uh, a lampi bangchi’n ka thei ding ua?” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Jesu’n a kiang ah, “Keimah lampi, thutak leh hinna ka hi; keimaha pailou kuamah Pa kiang a tungkei a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Kei n’on theihkhit uleh ka Pa leng na theikhinta ding uh; tu a kipan amah na thei ua muh leng na muta uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Philip in a kiang ah, “Toupa, huai Pa kou hon ensak in, huchi in kou adin a hun ding” a chi hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Jesu’n a kiang ah, “Philip, hiai tanpi na kiang ah ka om a, huchi in leng hon theilou maw? Kuapeuh kei honmu Pa mu ahi. Huai Pa kou hon musak in bangchi chih a na chih ahia?
  </para>
  <para style="p">
    <verse number="10" style="v" />Kei Pa ah ka om a Pa keimah ah a om chih na gingta kei ahia? Na kiang ua thu ka gen, keimah phuahtawm in ka gen kei; Pa keimah ah a om gige a, thil a hihzaw nak hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Kei Pa a ka om leh Pa keimah a a om gingta un; ahihkeileh thilhih ziak bek in hon gingta un.
  </para>
  <para style="p">
    <verse number="12" style="v" />Chihtaktak in, chihtaktak in, k’on hilh ahi, kuapeuh hon gingta in ka thilhihte a hih sam ding; hiai sang a thupizaw leng a hih ding, Pa kiang a ka pai ding ziak in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan ka min a na nget peuhmah uh ka hihzel ding, Pa, Tapa a pahtawi a a om theihna ding in.
  </para>
  <para style="p">
    <verse number="14" style="v" />Nou ka min a bangpeuh n’on nget uleh, ka hihzel ding hi” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />“Nou n’on it uleh, ka thupiakte na zui ding uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan Pa ka ngen dia, aman Khamuanpa dang a honpe ding, tangtawn a na kiang ua om ding in;
  </para>
  <para style="p">
    <verse number="17" style="v" />Huai thutak Kha; khovel in a neih theihlouh ahi, amah a muhlouh a, a theihlouh behlap ziak in; nou amah na thei ua, na kiang uah a om gige ngal a, noumau sung ah a om ding hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Tagah din k’on paisan kei ding; na kiang uah ka hongpai nawn ding hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Sawtlou chik sung khovel in a hon munawn kei ding; himahleh nou zaw n’on mu ding uh; keimah ka hin ziak in nou leng na hing sam ding uhi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai ni chiang in kei ka Pa a ka om leh nou keimah a na om bang un, kei noumau a ka omdan na thei ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />“Kuapeuh ka thupiakte nei a, zui, kei hon it ahi; kuapeuh kei hon it ka Pa’n a it ding, ken leng amah ka it ding a, a kiang ah ka hihna ka kilak ding, a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />“Huan Judas, Iskariot loupen in a kiang ah, Toupa, kou kiang a na kilak dia, khovel kiang a, na kilaklouh se ding bangziak ahia? a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />“Jesu’n a dawng a a kiang ah, min hon it leh ka thute a zui ding a; ka Pa’n amah a it dia, a kiang ah ka hongpai ding ua, amah toh ka tengkhawm gige ding uhi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Kuapeuh hon itlou in ka thu a zuikei; na thuzakte uh kei a ahi kei a, Pa hon sawlpa a ahizaw hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Na kiang ua ka omtak dih sung in, hiai thute k’on hilh hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Khamuanpa, Kha Siangthou, Pa in ka min a honsawl ding in bangkim nou a hon sinsak ding a, na kiang ua ka gen tengteng nou a hon thei khesak nawn ding hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />“Khamuanna k’on nutsiat a; keimah khamuanna k’on pia hi; khovel in a piak bang in k’on pe kei hi. Na lungtang uh hihmangbat in omkei hen, lau leng lau kei hen.
  </para>
  <para style="p">
    <verse number="28" style="v" />Ka paimang ding a, na kiang uah ka hongpai nawn ding, k’on chih omdan na theita uhi. Nou n’on it uh leh Pa kiang a ka paiding ziak in na kipak ding uh ahi; keimah sang in Pa a thupizaw hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Tuin hiai thil a hongtun chiang a na gintak theihna ding un hongtun ma in k’on hilh ahi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Na kiang uah thu ka gen tam nawn kei ding, khovel vaihawmpa a hongpai dek ziak in; aman keimah ah bangmah a neikei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh ken Pa ka it chih leh Pa in hon thupiak bangzel in thil ka hih chih, khovel in a theihna ding uh eive. Ding dih ua, hiai a kipan i paikhe ding uh.
  </para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Kei grepgui dik ka hi, ka Pa a kempa ahi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kei a hiang gahlou peuhmah a lamang a; a gah peuhmah a gah tamsemna ding in a hahsiang hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Na kiang ua ka thugen tawn in tun ah na siangthou pah uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Keimah ah om gige un, keileng noumau ah ka om gige ding. Hiang, grepgui a a om gige kei leh amah in a gah theikei bang in, nou leng keimah a na om gige kei uleh, na gah theikei ding uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Kei a grepgui ka hi a, nou a hiangte na hi uh. Kuapeuh keimah a om gige a, keileng amah a ka om gige na, huai mah tampi in a gah hi; keimah lou in bangmah na hih theikei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Mi kei a a om gige kei leh, hiang bang a paihkhiak in a om a, a vuai hi; huan a tawm ua mei ah a pai ua, a kang hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nou keimah a na om gige ua, ka thu leng noumau a a om gige leh na ut peuh uh ngen un, nou adia hih in a om ding hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Hiaiziakin tampi a na gah chiang un ka Pa pahtawi in a om hi, huchi in ka nungzuite na hi ding uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Pa’n kei hon it bangmah in k’on it hi; ka itna ah om gige un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Nou ka thupiakte na zuih uleh ka itna ah na om gige ding uhi, ken ka Pa thupiakte ka zui a, a itna a ka om gige mah bang in.
  </para>
  <para style="p">
    <verse number="11" style="v" />“Ka kipah noumau a a om gige theihna din leh na kipah uh a kimna ding in hiai thu na kiang uah ka gen ahi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Hiai ka thupiak ahi, ken nou k’on it bang in, noumau leng ki-ittuah un.
  </para>
  <para style="p">
    <verse number="13" style="v" />Mihing in a lawm adia a hinna a piak sang a itna thupizaw kuama’n a neikei hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Thu k’on piak peuhmah na hih uleh ka lawmte na hi ding uhi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Sikha k’on chi nawn kei dia; a toupa thilhih sikha in a theihlouh ziak in; lawmte k’on chi zawta ding; Pa kiang a ka thilzak tengteng na kiang uah k’on theisakta hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Nou n’on tel kei ua, ken k’on tel zaw hi, vagah ding leh na gah uh om gige ding in k’on sep hi; ka min a Pa kiang a na nget peuhmah uh a hon piakna ding in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Hiaite k’on thupiak ahi, ki-ittuah chiat un.
  </para>
  <para style="p">
    <verse number="18" style="v" />“Khovel in nou a honhuat leh nou a honhuat ma in keimah a hon haw khinta chih thei un.
  </para>
  <para style="p">
    <verse number="19" style="v" />Nou khovel a hi le uchin, khovel in amah a a it ding; khovel a kipan k’on telkhiak zawk ziak in, khovel in nou a hon hua hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Sikha a toupa sang in a thupizaw kei, chih thu k’on hilhta hi, theigige un. Amau kei a honsawi uleh, nou leng a honsawi ding uh; ka thu zui hita le uh, noumau thu leng a zui ding uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Himahleh hiai thil tengteng ka min ziak in na tung uah a hih ding uh, hon sawlpa a theihlouh ziak un.
  </para>
  <para style="p">
    <verse number="22" style="v" />Kei hong pailou in a kiang uah thu gen keileng khelhna neilou ding hi ua, himahleh tuin a khelhna uah paulap ding a neita kei uhi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kuapeuh kei honhua in, ka Pa leng a hua ahi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Midang kuamah hih ngeilouhte a lak ua hihlou hita leng, khelhna neilou ding hi ua, himahleh tuin amau kei leh ka Pa ka nih un hon muta uh, huat leng hon hawta uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />A dan uah, amau a ziak omlou in hon hua uh chih, thu gelhpen, a hongtunna ding ua hih uh eive.
  </para>
  <para style="p">
    <verse number="26" style="v" />“Huan Pa a kipan Khamuanpa na kiang ua k’on sawl ding, Pa a kipan thutak Kha a hongtun chiang in, keimah hon theihpih ding hi;
  </para>
  <para style="p">
    <verse number="27" style="v" />A tung a kipan a kei toh omkhawm na hih ziak un nou leng na theihpih ding uhi.
  </para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />“Lungkia a na paimang louhna ding un na kiang uah hiai thute ka genta hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Kikhopnainte ah a hon nongsak ding ua; kuapeuh nou honthat Pathian tung a thil hoih hih in a kithei ding ua huai bang hun hongtung ding ahi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huai thilte a hih ding ua, Pa leh kei hon theihlouh ziak un.
  </para>
  <para style="p">
    <verse number="4" style="v" />Hiai thute na kiang uah ka genta hi, a hun a hongtun chiang a, k’on hilhkhinta chih na theihnawnna ding un. Hiai thilte na kiang ua ka om takdih ziak in a tung a k’on hilhlouh him na hi uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />“Tuin hon sawlpa kiang ah ka pai ding a noute kuamah in, koi a hoh ding? chi in, n’on dong kei uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Hiai thute na kiang ua ka gen ziak in na lungtang uh lungkhamna in a dimzou hialta hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Himahleh thutak k’on hilh ahi; ka pai nou ding in a hoihzaw hi; ka paikei leh Khamuanpa na kiang uah a hong tungkei ding a; ka pai leh bel na kiang ua honsawl ding ka hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Amah a hongtun chiang in, khelhna, diktatna, leh vaihawmna thu ah khovel a siamlouh dan a theisak ding hi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Khelhna thu ah siamlouh ahi ding uh, kei hon gintak louh ziak un.
  </para>
  <para style="p">
    <verse number="10" style="v" />Diktatna thu ah siamlouh a tang ding uh; Pa kiang a ka pai ding a, nou kei n’on muhnawn taklouh ding ziak un.
  </para>
  <para style="p">
    <verse number="11" style="v" />Vaihawmna thu ah siamlouh ahi ding uh, hiai khovel lal siamlouh a a puktak ziak in.
  </para>
  <para style="p">
    <verse number="12" style="v" />“Na kiang ua thugen ding tampi ka neilai a, himahleh tuin zaw na chin tadih kei uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh amah Thutak Kha a hongtun chiang in, thutak tengteng ah nou a honpi ding; amah phuahtawm in thu a genkei dia; a zak peuhmah a genzaw ding, thil hongtung dingte leng nou a hon theisak ding hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Aman kei a hon pahtawi ding a; kei a a la ding a, nou kiang ah a hon theisak ding hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Pa’n thil a neih tengteng kei a ahi; huaiziak in kei a a la ding a, na kiang uah a hon theisak ding, ka chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />“Sawtlouchik in nou kei n’on mu kei ding ua; sawtlouchik mah in nou kei n’on munawn ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />“A nungzuite khenkhat in, i kiang ua a thugen bang ahi, sawtlouchik in nou kei n’on mu kei ding uh, sawtlouchik mah in n’on munawn ding uh a chih leh, Pa kiang a ka hohdek ziak in, a chih? a kichi uhi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Amau mah in, sawtlouchik, a chih bang chihna ahia? A thugen i theisiam kei uh, a chi uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />“Huan amah dot ut a nei uh chih Jesu’n a thei a, a kiang uah, sawtlou chik in nou kei n’on mu kei ding uh, sawtlou chik mah in nou kei n’on mu nawn ding uh chi a ka thugen na kidong umaw?
  </para>
  <para style="p">
    <verse number="20" style="v" />Chihtaktak in, chihtaktak in, k’on hilh ahi, na khitui uh a ke ding a, na kap huphup ding uh, khovel bel a kipak ding; na lungkham ding ua, himahleh na lungkham uh kipahna a suak ding hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Numei nau nei ding in a veilai in a lungkham nak hi, a hun a tuntak ziak in; himahleh nau a suahtakin a lunggimna a thei nawnta kei hi, khovel a naungek mel hongpian a a kipah ziak in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Tuin nou na lungkham uh; himahleh k’on munawn ding a, na lungtang uh a kipak ding, na kipahna uh kuamah in hon laksak kei ding hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huai ni chiang in nou kei bangmah n’on ngen kei ding uh. Chihtaktak in, chihtaktak in, k’on hilh ahi, Pa kiang a bangpeuh ka min a na nget uleh a honpe ding hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Tu tan in ka min in bangmah na ngen nai kei uh. Ngen un, huchi in na mu ding uh, na kipah uh a kimna ding in.
  </para>
  <para style="p">
    <verse number="25" style="v" />“Huai thute a hem in na kiang uah ka genta hi; a hun a tung dekta, huai hun chiang in na kiang uah a hem in thu ka gen nawn kei ding a, chiantak in Pa tanchin k’on hilh ding hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huai ni chiang in keimah min in thil na ngen ding uhi; Pa kiang ah ken k’on ngetsak ding ka chikei hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Pa in amah ngei in nou a hon it ngal a, nou kei n’on it ua, Pa a kipan ka hi chih n’on gintak ziak un.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kei Pa kiang a kipan hongpawt a, khovel a hongpai ka hi a; khovel paisan a, Pa kiang a pai nawn ding ka hi, a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huan a nungzuite’n a kiang ah, “Ngai dih tuin teltak in a genta, a hem in na gen ta kei hi a chi uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Nang bangkim na thei a, kuamah hondot na kiphamoh kei chih tuin ka theita uhi; hiai ziak in Pathian kiang a kipan hongpai na hi chih ka gingta uhi, a chi uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Jesu’n a dawng a a kiang uah, tuin na gingta u maw?
  </para>
  <para style="p">
    <verse number="32" style="v" />“Ngai un, a hun hong tungding ahi, tuin leng a tungta hi, huai hun chiang in noumau in chiat ah na dalh vek ding ua, keimah kia n’on nuse ding uh. Himahleh Pa ka kiang a om ziak in keimah kia in ka omkei hi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Hiai thute na kiang uah ka genta hi, keimah a na khamuanna ding un. Khovel ah gimthuakna na neiding uh, himahleh khamuangtak in om un, ken khovel ka zouta, a chi hi.
  </para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thute Jesu’n a genkhit in vanlam nga in, “Pa a hun a tungta; na Tapa pahtawi in, Tapa in nang hon pahtawi theihna ding in;
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi a mi tengteng tung a thunei a na bawl in, a kiang a na piak peuhmahte tangtawn hinna a piak theihna ding in.
  </para>
  <para style="p">
    <verse number="3" style="v" />Hiai tangtawn hinna ahi, Nang Pathian tak kia leh na sawl Jesu Khrist theih.
  </para>
  <para style="p">
    <verse number="4" style="v" />Nang thilhih ding n’on piakte ka hihkhinta a, khovel ah k’on pahtawita hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Pa aw, khovel omma a na kiang a thupina ka neih in, tuin nangmah kiang ngei ah hon pahtawi in.
  </para>
  <para style="p">
    <verse number="6" style="v" />“Nang khovel a kipan a mi kei n’on piakte kiang ah na min ka hihlangta; amau nang a ahi ua, nang amau kei n’on piak ahi uh; amau lah na thu a zuita uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Nang kei n’on piak tengteng nang a kipan ahi chih a theita uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Nang thu n’on piakte a kiang uah ka peta a; huaite a kem ua, nang a kipan ka hi chih diktak in a theita uh, nang n’on sawl chih leng a gingta uhi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Amau dia ka ngetsak zaw; khovel a dia ngetsak ka hi kei, nang n’on piakte ading ahizaw, nang a ahi uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Thil tengteng kei a peuhmah nang a ahi a, nang a lah kei a ahi a; amau ziak in pahtawi in ka om hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huan kei zaw khovel ah ka omta kei ding, hiaite bel khovel ah a om ding uh; kei na kiang ah ka hong paidekta hi. Pa Siangthou aw, nang kei n’on piakte na min in hum in pumkhat a hihtheihna ding un, eimah pumkhat i hih bang in.
  </para>
  <para style="p">
    <verse number="12" style="v" />A kiang ua ka om sung in, nang kei n’on piakte na min in ka hum a; amau ka don a, a lak ua khat leng a mangthang kei hi, mangthang tapa loungal, Laisiangthou a tun theihna ding in.
  </para>
  <para style="p">
    <verse number="13" style="v" />Himahleh tuin na kiang ah ka hong paidekta; khovel ah hiai thute ka gen ahi, ka kipah amau ua a neih kimna ding un.
  </para>
  <para style="p">
    <verse number="14" style="v" />Na thu a kiang uah ka peta hi; khovel in amau a hua a, khovel a a hihlouh ziak un, kei khovel a ka hihlouh mah bang in.
  </para>
  <para style="p">
    <verse number="15" style="v" />Nang amau khovel a kipan na lakkhiak ding ngen ka hi kei a, migilou lak ah na hum ding ka chi ahizaw hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Amau khovel a a hi kei ua, kei khovel a ka hihlouh mah bang in.
  </para>
  <para style="p">
    <verse number="17" style="v" />Amau thutak in hihsiangthou in, na thu thutak ahi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Nang khovel a kei n’on sawl bang in, amau khovel ah ka sawl hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Amau ziak in ka ki hihsiangthou a, amau leng thutak a a sianthouna ding un.
  </para>
  <para style="p">
    <verse number="20" style="v" />“Hiaite ading kia a ngetsak ka hi kei, a thugen ziak ua kei hon gingta lai dingte ading in ngetsak ka hi; avek ua pumkhat a hihna ding un;
  </para>
  <para style="p">
    <verse number="21" style="v" />Pa, nang keimah a na om leh, kei nangmah a ka om bang in, amau leng eimah a a omna ding un; nang kei n’on sawl chih khovel in a taksan theihna ding in.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan nang thupina n’on piak ken amau ka peta; amau pumkhat a hihna ding un, ei pumkhat i hihmah bang in.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kei amau ah, nang kei ah, amau pumkhat a a om ua a bukim theihna ding un; nang kei n’on sawl chih leh, n’on it bang in amaute na it chih khovel in a theihtheihna ding in.
  </para>
  <para style="p">
    <verse number="24" style="v" />“Pa, nang kei n’on piakte, ka omna a ka kiang a om ding in ka deih; leilung pian ma a itna a nang n’on piak ka thupina a muhtheihna ding un.
  </para>
  <para style="p">
    <verse number="25" style="v" />Pa diktat aw, khovel in zaw nang hon theikei a, ken zaw k’on thei hi; hiaite’n leng nang kei n’on sawl chih a thei uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan a kiang uah na min ka theisakta a, ka theisak lai ding, nang kei n’on itna bangbang na itna amau a a om a, keileng amau a ka om theihna ding in” a chi hi.
  </para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />Jesu’n huai thute a genkhit in a nungzuite toh a pawt ua, Kidron lui a kan ua, huai ah huan a om hi. Huai ah amah leh a nungzuite a lut uhi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan a mansak dingpa Judas in leng huai mun a thei a; Jesu a nungzuite toh huai ah a pawt zelzel uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in Judas in sepaih pawl, siampu liante leh Pharisaite kiang a om heutute a pi a, khawnvakte, meiselte, galvante tawi in huai ah a hongpai uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Jesu’n a tung a thil tungding tengteng a theigige a, a vapawt a, a kiang uah, “Kua ahia na zon uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Amau a kiang ah, “Nazaret Jesu a chi ua” a dawng uhi. Jesu’n a kiang uah, “Keimah ka hi” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />A mansakpa Judas leng a lak uah ading a. “Keimah ka hi” a chihtak in, a nungtolh ua, lei ah a puk duam uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huan aman a kiang uah, “Kua ahia na zon uh?” chi in a dong nawn hi. Amau, “Nazaret Jesu” a chi uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huan Jesu’n, “Keimah ka hi chih k’on hilhta a; nou kei hon zong na hih uleh hiaite hoihtak in khah un” a chi a a dawng hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />“Nang kei n’on piakte khat leng ka mangsak kei” chi a a thugen a tunna ding ahi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Simon Peter in a namsau vom a dok a siampu lianpen sikha a sat a, a bil taklam a satkhiaksak hi. Huai sikha min Malka ahi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Peter kiang ah Jesu’n, “Na namsau a pai ah siat in; Pa in nou a honpiak ka dawn kei dia hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huchi in sepaih pawl leh Judate heutute’n Jesu a man ua, a henta uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Ana kiang ah a pi masa ua, Kaiapha sungpa a hih ziak in. Kaiapha, huai kum a siampu lianpen ahi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Kaiapha bel, mitengteng sang a mi khat sih a hoih chi a, Judate hanthawn pa ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan Simon Peter in nungzui dang khat toh Jesu a zui hi. Huai nungzuipa siampu lianpen meltheih ahi a, siampu lianpen in huangsung intual ah, Jesu kiang ah a lutsam hi;
  </para>
  <para style="p">
    <verse number="16" style="v" />Himahleh Peter pawlam ah kongkhak bul ah ading hi. Huchi in nungzui dang siampu lianpen meltheih, a vapawt a, kongkhak ngaknu a houpih a, Peter a pilut hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Kongkhak ngak, nungak in Peter kiang ah, “Nang leng hiai mi nungzuite lak a pangsam na hi hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Aman “Ka hi kei” a chi hi. Sikhate leh heutute huai ah ading uhi. A vot ziak in meihol in mei a toh ua, meilum a awi uhi. Peter leng a kiang uah a om a, ding kawm in meilum a awisam hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Siampu lianpen in Jesu a nungzuite tanchin leh a thuhilh a dong hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Jesu’n a dawng a a kiang ah, “Khovel kiang ah vantang theih in, thu ka gen gige hi; kikhopnain, Pathian biakin leh Judate omkhawmnate ah thu ka hilh zel a, a sim in bangmah ka genkei hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Bang a chia kei hon dong? A kiang ua ka thugen ka thuzate dong in, ngai in, amaute’n ka thugen a thei uh a kei hiam” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huan a gentakin a kiang a ding heutu khat in Jesu a beng a, “siampu lianpen hichibang in na dawng maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Jesu’n a kiang ah, “Thudiklou gen ka hihleh, a gitlouhna hon theisak in. Himahleh, thupha ka gen in bang a chia hon beng?” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan Annas in hensa in siampu lianpen Kaiapha kiang ah a sawl hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Simon Peter in ding kawm in meilum a awi hi. “Nang leng a nungzuite lak a pangsam na hi hia?” a chi uhi. Aman, “ka hi kei” chi in, a kitheihmohbawl hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan siampu lianpen sikha khat Peter in a bil satkhiak sakpa sanggampa’n, a kiang ah, “Huan ah k’on mu kei maw?” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huchi in Peter in a kitheihmohbawl nawn a; huan ak a khuangpah hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Kaiapha inn a apan in Vaihawmna inn ah Jesu a pinawn ua; zingsang ahi a; amau zaw Vaihawmna inn ah a lut kei uh, a lut un zaw buah in, Paikan Ankuanglui a ne theikei ding uhi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Amaute kiang ah Pilat a vapawt a, “Hiai mi tung ah hekna bang ahia na neih uh?” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Amau a kiang ah, “Hiai migilou hikeileh na kiang ah k’on pi kei ding uh” chi in a dawng uhi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan Pilat in a kiang uah, “Nou pi unla, na dan bang un vaihawmsak un” a chi hi. Judate’n a kiang ah, “Kou thu in kuamah hihlup dan ahi kei” a chi uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Hiai thu a sih ding dan, Jesu’n a gen bang a a tunna ding ahi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Huchi in Pilat inn sung ah a lutnawn a, Jesu a sam a, a kiang ah, “Judate kumpipa na hi hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Jesu’n “Hiai ka tungtang thu nangmah lungsim puak khiak a na gen hia, midang in honhilh?” chi in dawng hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />Pilat in, “Kei Judami ka hi ahia? Nangmah chipihte leh siampu liante’n ka kiang ah a honpi ua ahi; thil bang ahia na hih?” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="36" style="v" />Jesu’n, “Ka kumpi hihna hiai khovel ahi kei; ka kumpi hihna hiai khovel hileh Judate kiang a piak a ka omlouhna ding in, ka sikhate’n a dou ding uh. Himahleh ka kumpi hihna hiai khovel a kipan ahi kei hi” chi in, a dawng hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Pilat in a kiang ah, “E, kumpipa na hi maw?” a chi hi. Jesu’n, “Kumpipa ka hi n’on chi ve. Thutak theihsak ka piansan leh khovel a ka hong paisan ahi. Kuapeuh thutak a om peuhmah in ka thu a sang uh” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Pilat in a kiang ah, “Thutak bang ahia?” a chi hi. Huan huai thu a genkhit in, Judate kiang ah a va pawtnawn a, a kiang uah, “Bangmah a gitlouhna ka mu kei a chi hi.”
  </para>
  <para style="p">
    <verse number="39" style="v" />Himahleh Paikan Ankuangluina ah mi khat k’on pawtsakna ding dan na nei uh; huchi in Judate kumpipa hon pawtsak leng na ut uhia? a chi hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Amau a kikou nawn ua, “Hiai mi zaw hi kei henla, Barabba pen hi hen” a chi uhi. Barabba suamhat ahi.
  </para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huchi in Pilat in Jesu a pi a, a zep hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huan sepaihte’n linglukhu a phan ua, a khusak ua, puan sandup leng a silh sak uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />A kiang ah a hongpai ua, “Chibai, Judate Kumpipa”; a chi ua, a beng uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Huan Pilat a pawt nawn a, a kiang uah, “En un, bangmah a gitlouhna ka mu kei chih na theihna ding un, na kiang uah k’on pikhia hi,” a chi hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu linglukhu khu in leh puan sandup silh in a hongpawt hi. Pilat in a kiang uah, “En un, Mihing!” a chi hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan siampu liante leh heutute’n amah a muhtak un a kikou ua, “Kros ah kilhlum in, Kros ah kilhlum in” a chi uhi. Pilat in a kiang uah, “Noumau paipih unla, Kros ah kilhlum un; ken zaw bangmah a gitlouhna ka mu ngalkei hi” a chi hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Judate’n a kiang ah, “Ka dan uh khat a om, huai dan bangzel in Pathian Tapa a a kibawl ziak in a si ding ahi” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Pilat in huai thu a zak in a launawn semsem hi;
  </para>
  <para style="p">
    <verse number="9" style="v" />Amah Inpi sung ah valut nawn in Jesu kiang ah, “Koi a hong kipan na hia?” a chi hi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Himahleh Jesu’n a dawngkei hi. Pilat in a kiang ah, “Nang kei hon houpih lou ding maw? Honkhah thei leh Kros a hon kilhlum thei ka hi chih na theikei ahia?” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Jesu’n, “Tunglam a kipan piak hi kei lechin, ka tung ah hihtheih na neikei ding. Huaiziak in na kiang a hon pekhepa’n khelhna lianzaw a pua hi” a chi hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huai nungsiah Pilat in khah a tuma; himahleh Judate a kikou ua, “Hiai mi na khah leh Kaisar lawm na hi kei; kuapeuh kumpipa a kibawl Kaisar dou ahi” a chi uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Pilat in huai thu a zak in Jesu a pikhia a, a min Suanglep, Hebru pau a Gabbatha a chih uh, huai mun ah thukhenna tutphah ah a tu hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan huai ni Paikan Ankuangluina kiginni ahi a, dak gukna ding ahi. Huan aman Judate kiang ah, “En un, na Kumpipa uh” a chi hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan amau a kikou ua, “Hih mangthang in, hih mangthang in, Kros ah kilhlum in” a chi uhi. Pilat in a kiang uah, Na kumpipa uh Kros ah ka kilhlum ding maw? a chi hi. siampu liante’n, “Kaisar loungal kumpipa dang ka neikei uh” a chi ua, a dawng uhi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huchi in Pilat in Kros a kilhlup ding in amah a kiang uah a peta hi. Huchi in Jesu a pi ua, a paikhiak pih uhi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Aman Kros kipuak in Luguh Mun, a chih uh, Hebru pau a Golgotha a chih mun tan a pai hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Huai ah Kros ah a lai ah Jesu midang nih a sik ah khat tuaktuak toh a kilhden uhi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Pilat in lai a gelh a, Kros ah a tak a, “NAZARET JESU JUDATE KUMPIPA” chi in a gelh hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai laigelh Judate tampi in a sim ua; Jesu Kros a kilhlupna mun uh khopi kiang ahi a; Hebru pau, Grik pau leh Latin pau a gelh ahi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Huchi in Judate siampu liante’n Pilat kiang ah, “Judate Kumpipa, chi in gelh ken; Judate Kumpipa ka hi” a chi, chi in, gelh zaw in, a chi uhi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Pilat in “Ka gelhkhit, gelhkhit ahita ” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huan sepaihte’n Kros a Jesu a kilhlup khit un a puansilh phel li a suah ua, phel khatchiat in a tang uhi; a puanak leng a la uh. Puanak khui louh puanak ahi a a ngawng a kipan a pum a gatthoh ahi;
  </para>
  <para style="p">
    <verse number="24" style="v" />Huaiziak in amau, “I botkek kei dia, kua tanding ahi hiam ai i san ding uh” a kichi uhi. Laisiangthou a, “Ka puansilhte a kihawm ua, ka puanak ding in ai a san uh” chih a tunna ding in hiai thil sepaihte’n a hih uhi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan Jesu Kros kiang ah a nu leh a nu sanggam, Mari Kleopa zi leh Mari Magdalin ading uhi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan Jesu’n a nu leh nungzui a itpa a kiang a ding a mu a, a nu kiang ah, “Numei, en in, na tapa” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Nungzuipa kiang ah, “En in, na nu” a chi hi. Huai dak apan huai nungzui in a in ah amah pita hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Huai nung in, Jesu’n thil bangkim hihzoh ahita chih a thei a, Laisiangthou a tunna ding in, “Ka dang a tak” a chi hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Huai ah bel khat uain thuk a dim a tung ua, huchi in spanji khat uain thuk a diahdim in, hussop chiang dawn a tak in, a muk ah a tulhtou uhi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan Jesu’n uain thuk a dawn khitin, “Zoh ahita” a chi hi. A lu a kun a, a kha a khahta hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Huan kiginni a hih ziak in, luangte khawlni a Kros a a omlouhna ding in, huai khawlni ni thupi ahi ngal a. Judate’n Pilat kiang ah a khete uh hihtan a a luang uh paipih ding in a ngen uhi.
  </para>
  <para style="p">
    <verse number="32" style="v" />Sepaihte a hongpai ua, a kiang a Kros a kilhlup tuah masakpen leh mi khat a khe uh a hihtan uhi.
  </para>
  <para style="p">
    <verse number="33" style="v" />Himahleh Jesu kiang a hongtun un, a na sita chih a thei ua, a khete a hihtan tuankei uhi.
  </para>
  <para style="p">
    <verse number="34" style="v" />Himahleh sepaihte lak a mi khat in a nak ah tei in a dawt a, huchi in sisan leh tui a hong luangkhia hi.
  </para>
  <para style="p">
    <verse number="35" style="v" />A mupa’n a theisakta, a thu theihsak a dik ahi; a gendik chih a kithei a, nou leng na gintakna ding un.
  </para>
  <para style="p">
    <verse number="36" style="v" />Laisiangthou in, “A guh khat lel leng hihtan ahi kei ding” a chih tunna ding in huai thil a hong omta hi.
  </para>
  <para style="p">
    <verse number="37" style="v" />Huan Laisiangthou dang in, “A sutpa uh lam a en ding uh” a chi hi.
  </para>
  <para style="p">
    <verse number="38" style="v" />Huan huai thilte khit in, Joseph, Arimathai mi, Jesu nungzui, Judate kihtak ziak a sim om in Jesu luang paipih ding in Pilat kiang ah a ngen hi. Pilat in a phal a, huchi in a hongpai a, a luang a paipihta hi.
  </para>
  <para style="p">
    <verse number="39" style="v" />Huan Nikodem, a tung a zan a a kiang a hong in, murra leh aloe kihelsa buk sawmnga vel tawi in a hongsam hi.
  </para>
  <para style="p">
    <verse number="40" style="v" />Jesu luang a la ua, Judate kivui dan bang in gimlimte toh puanmalngat hoih in a tuam uhi.
  </para>
  <para style="p">
    <verse number="41" style="v" />Huan Kros a a kilh lupna mun uah huan khat a om a; huan ah kuamah sialna ngei nailouhna han thak khat a om hi.
  </para>
  <para style="p">
    <verse number="42" style="v" />Judate kiginni a hih ziak in, han a kiang chin uh a hih toh, huai ah Jesu a sialta uhi.
  </para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Nipikal a ni masapen a hongtun in, zingsangpi khuamial lai in, Mari Magdalini han ah a va hoh a, hansuang lakkhiaksa in a mu hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Huchi in a tai a, Simon Peter leh nungzui dang Jesu’n a itpa kiang ah a hongpai a, “Han a kipan Toupa a paimangpih uh, a koihna uh ka theikei uh” chi in a gen hi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Huchi in, Peter a pawt a, nungzui dang toh han lam a zuan uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />A tai tuak ua; nungzui dang in Peter a makhelh a, han a tung masa hi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Huan kunsuk in a en a, puanmalngat hoih a mu a; himahleh asung ah a lut kei hi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Simon Peter amah nung in a hong tungsam a, hansung ah a lutsuak a; puanmalngat hoih omte a mu hi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Jesu lukhung ah kinulna puan pen, puanmalngat hoih lak a omlou a, a tuam a khepsa a om a mu hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Huchi in nungzui dang, han tungmasa leng a lutsam a, a mu a, a gingta hi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Misi lak a kipan a thounawn ding ahi chih Laisiangthou gen a theigige nawn kei uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huchi in nungzuite amau inn ah a pai nawnta uhi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Himahleh Mari han pua ah kapkawm in ading a; kapkawm in a kun a, hansung a en hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan angel nih puanngou silh, Jesu luang sialna mun ah khat a lu lam ah khat a khe lam ah tu a mu hi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan amau “Numei, bang a chia kap na hia?” a chi uhi. Aman “Ka Toupa a paimangpih ua, a koihna uh ka theihlouh ziak in” chi in a dawng hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huan huchi a a gentakin a nunglam a nga a, Jesu ding a mu a, himahleh Jesu ahi chih a theikei hi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Jesu’n a kiang ah, “Numei, bangdia kap na hia? Kua ahia na zon?” a chi hi. Aman huanpu hiam a sa a, a kiang ah, “Pu, amah hiai a kipan na paimang pih ahihleh na koihna honhilh tanla, huchi in ka la ding” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Jesu’n a kiang ah, ‘Mari’ a chi hi. Amah a kihei a, a kiang ah Hebru pau in, ‘Rabboni’ a chi a, huai “Sinsakpa” chihna ahi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan Jesu’n a kiang ah, “Hon lawng ken, tu tan in leng Pa kiang ah ka kahtou naikei hi. Himahleh ka unaute kiang ah vahoh inla, a kiang uah, Ka pa, na Pa uh, ka Pathian, na Pathian uh kiang ah ka kahtou dek” a chi hi, chi in, a chi hi.
  </para>
  <para style="p">
    <verse number="18" style="v" />Mari Magdalini a va hoh a, nungzuite kiang ah, “Toupa ka muta,” a chi a, a kiang ah hiai thute a gen chih a hilhta hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huan huai ni, Nipikal a ni masapen, nitaklam a hong hih in, Judate kihtak ziak a nungzuite omna inn kongkhakte a khaknung un, Jesu hongpai a, a lak uah a hong ding a, a kiang uah, “Na tung uah khamuanna om hen” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huai a genkhit in a khut leh a nak a kiang uah a lak a. Toupa a muhtak un nungzuite a kipak uhi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Jesu’n a kiang uah, “Na tung uah khamuanna om hen, Pa’n kei honsawl bangmah in nou k’on sawl hi” a chi nawn hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Huai thu a genkhit in amau a hatkhum a, a kiang uah, “Kha Siangthou tang un.
  </para>
  <para style="p">
    <verse number="23" style="v" />Kua khelhna leng na ngaihdam uh ngaihdam ahi ding; kua khelhna leng na ngaihdam louh uh, ngaihdam louh ahi ding” a chi hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huan Jesu a honglai in sawmlehnihte lak a pang sam Thomas Didum a chih uh, a kiang uah a omkei hi.
  </para>
  <para style="p">
    <verse number="25" style="v" />Huchi in nungzui dangte’n a kiang ah, “Toupa ka muta uh” a chi uhi. Himahleh aman a kiang uah, “A khut sikkhetna pawn ka muh a, ka khutzung a ka khoih a, a nak a ka khut ka golhlut hial kei leh, ka gingta kei ding” a chi hi.
  </para>
  <para style="p">
    <verse number="26" style="v" />Huan ni giat nung in, a nungzuite inn sung ah a om nawn uhi, Thomas leng a kiang uah a omsam hi. Huan kongkhakte khak hinapi in Jesu hongpai a a lak uah a hong dingta a, a kiang uah, “Na tung uah khamuanna om hen,” a chi hi.
  </para>
  <para style="p">
    <verse number="27" style="v" />Huan Thomas kiang ah, “Na khutzung in sawk in, ka khutte en in; na khut in khoih inla, ka nak ah sawk in; ginglou kenla, gingta in” a chi hi.
  </para>
  <para style="p">
    <verse number="28" style="v" />Thomas in, “Ka Toupa leh ka Pathian na hi” a chi a, a dawng hi.
  </para>
  <para style="p">
    <verse number="29" style="v" />Jesu’n a kiang ah, “Nang zaw n’on muh ziak in na gingta ahi; mulou a gingta peuhmahte a hampha uhi” a chi hi.
  </para>
  <para style="p">
    <verse number="30" style="v" />Huan Jesu’n nungzuite ma ah chiamtehna dang tamtak a hih a, huaite hiai laibu ah gelhvek ahi kei hi.
  </para>
  <para style="p">
    <verse number="31" style="v" />Himahleh hiaite Jesu Khrist, Pathian Tapa ahi chih na gintakna ding uleh, na gintak ua a min a hinna na neihna ding ua gelh ahi.
  </para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />Huai thilte nung in, Tiberias dil ah Jesu a nungzuite kiang ah a kilak nawn a; hichibang in amah mah a kilak hi.
  </para>
  <para style="p">
    <verse number="2" style="v" />Simon Peter, Thomas Didum a chih uh, Galili gam a Kana khua a Nathanael, Zebedai tapa nihte, a nungzui dang nihte toh a omkhawm uhi.
  </para>
  <para style="p">
    <verse number="3" style="v" />Simon Peter in a kiang uah, “Ngasa beng ding in ka kuan dek” a chi a, amau a kiang ah, “Kou leng na kiang ah ka hong sam ding uh” a chi uhi. A pawtkhia ua, long ah a tuang ua, huai zan in bangmah a man kei uhi.
  </para>
  <para style="p">
    <verse number="4" style="v" />Phalvak in Jesu piautak ah ading a; himahleh a nungzuite’n Jesu ahi chih a theikei uhi.
  </para>
  <para style="p">
    <verse number="5" style="v" />Jesu’n a kiang uah, “Naute aw, nekding banghiam na nei uhia?” a chi hi. Amau a kiang ah, “Neilou” chi in, a dawng uhi.
  </para>
  <para style="p">
    <verse number="6" style="v" />Huan a kiang uah, “Long sik taklam ah len pai le uchin na man ding uh” a chi hi. A pai ua, ngasa tam ziak in a kaikhe zoukei uhi.
  </para>
  <para style="p">
    <verse number="7" style="v" />Huchi in nungzui Jesu itpa’n Peter kiang ah, “Toupa eive” a chi hi. Huchi in, Toupa ahi chih Simon Peter in a theih in, a puanak tungsilh a teng a, vuaktang a om ahi a, dil ah a tawmkheta hi.
  </para>
  <para style="p">
    <verse number="8" style="v" />Himahleh nungzuite’n long neuchik in, len ngasa a dim toh kaikawm in a honzuan ua, gam a kipan in a gamla ngalkei ua, tong za nih hiam phet ahi.
  </para>
  <para style="p">
    <verse number="9" style="v" />Huan gam a a hongsuah tak un, meihol a mei tohsa a tung a ngasa leh tanghou emsa a mu uhi.
  </para>
  <para style="p">
    <verse number="10" style="v" />Huan Jesu’n a kiang uah, “Tuin na ngasa mat uh a khen hon latou un” a chi hi.
  </para>
  <para style="p">
    <verse number="11" style="v" />Huchi in Simon Peter a vatuang a, len ngasa lianpi pi a dim tuigei ah hon kaikhia a, za leh sawmnga leh thum a pha hi: huchi lawmlawm in tam mahleh len a kek kei hi.
  </para>
  <para style="p">
    <verse number="12" style="v" />Huan Jesu’n a kiang uah, “Zingan na ne un” a chi hi. Nungzuite lak ah kuamah in a kiang ah, “Kua na hia?” chi in a dong ngamkei uhi, Toupa ahi chih a thei uhi.
  </para>
  <para style="p">
    <verse number="13" style="v" />Huan Jesu a hongpai a, tanghou a la a, a kiang uah a pia a, ngasate leng huchi bangmah in a pe sam hi.
  </para>
  <para style="p">
    <verse number="14" style="v" />Huai tuh Jesu misi lak a kipan a thohnawn nung a, a nungzuite kiang a a kilak thumveina ahi.
  </para>
  <para style="p">
    <verse number="15" style="v" />Huan zingan a nekkhit un, Simon Peter kiang ah Jesu’n, “Simon, Johan tapa, nang hiaite sang in kei n’on itzaw hia?” a chi hi. Aman a kiang ah, “He, Toupa, k’on it chih na thei hi” a chi hi. Aman a kiang ah, “Ka belamnoute vak in” a chi hi.
  </para>
  <para style="p">
    <verse number="16" style="v" />Huan a nihveina ding in a kiang ah, “Simon, Johan tapa, nang kei n’on it hia?” a chi nawn hi. Aman a kiang ah, “He, Toupa, k’on it chih na thei hi” a chi nawn hi. Aman a kiang ah, “Ka belamte ching in,” a chi hi.
  </para>
  <para style="p">
    <verse number="17" style="v" />Huan a thumveina din a kiang ah, “Simon, Johan tapa, nang kei n’on it hia?” a chi hi. Huan thumveina a nang kei n’on it hia? A kiang a a chih ziak in Peter a lungkham a, a kiang ah, “Toupa, bangkim na thei a, k’on it chih na thei hi,” a chi hi. Jesu’n a kiang ah, “Ka belamte vak in.”
  </para>
  <para style="p">
    <verse number="18" style="v" />“Chihtaktak in, chihtaktak in, k’on hilh ahi, na naupan lai in na tai ah na kigak a, na utna peuh ah na hoh a; himahleh na upat hun chiang in na khut na zak ding a, midang in a hon gaksak ding uh, na utlouhna lam ah a honkai ding uh, a chi hi.
  </para>
  <para style="p">
    <verse number="19" style="v" />Huai thu bangchidan a si in ahia Pathian a pahtawi ding chih theihsakna ding a a gen ahi. Huai a genkhit in, a kiang ah, Honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="20" style="v" />Huaikhit in Peter a kihei a, Jesu nungzui itpa, nitak anneklai a a awm ngai a hong awnphei a, “A mansakpa ding kua pen ahia?” chi pa’n, honzui a mu hi.
  </para>
  <para style="p">
    <verse number="21" style="v" />Peter in amah a muhtak in, Jesu kiang ah, “Toupa, hiai min bang a hih dia?” a chi hi.
  </para>
  <para style="p">
    <verse number="22" style="v" />Jesu’n a kiang ah, “Ka hongpai nawn tan a om nilouh din deih leng, huai nang bang lunghimawh zenzen? Nang honzui in” a chi hi.
  </para>
  <para style="p">
    <verse number="23" style="v" />Huchi in huai nungzuipa silou ding in a thu unaute lak ah a thangta a; himahleh Jesu’n a sikei ding chih a kiang ah a gen kei a, “K’ong pai nawn tan a om nilouh din deih leng huai nang bang lunghimawh zenzen?” chi lel ahizaw hi.
  </para>
  <para style="p">
    <verse number="24" style="v" />Huai nungzuipa “Hiai thu theisakpa leh gelhpa ahi; huan a thu theihsak a dik chih i thei uhi.”
  </para>
  <para style="p">
    <verse number="25" style="v" />Huan hiaite lou Jesu thilhih a dang tampi a omlai; huaite gelhvek ding hileh, laibu gelh ding tengteng khovel ah leng tazou in ka gingta kei hi. Amen.
  </para>
</usx>
